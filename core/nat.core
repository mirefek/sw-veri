// Natural numbers (the integers >= 0, omega): induction, and examples of
// `arith`, `rec` and `induct`. (Arithmetic is that of the integers.)
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core

// ----------------------------------------------------------------------
//  Induction (from omega_ind: core/sets.core, from omega's definition)

theorem nat_ind(x. p): p(0) -> (all n. n in omega -> p(n) -> p(int_add(n, 1))) -> all n. n in omega -> p(n)
proof
  assume h0 hs
  // the naturals with p form an inductive set
  have e0: empty in set_select(omega, n. p(n)) by sel(taut(omega_zero, rewrite(lit_zero, h0)))
  fix m
  assume hm: m in set_select(omega, n. p(n))
  have um := unsel(hm)
  have mo: m in omega by taut(um)
  have pm: p(m) by taut(um)
  have pn := mp(mp(all_elim(hs, {m}), mo), pm)
  have eq: int_add(m, 1) = succ(m) by arith(mo)
  have sm: succ(m) in set_select(omega, n. p(n)) by sel(taut(mp(omega_succ[n := m], mo), rewrite(eq, pn)))
  have st := gen(discharge(sm, hm), m)
  have sub := mp(mp(omega_ind[s := set_select(omega, n. p(n))], e0), st)
  // so every natural has p
  fix k
  assume hk: k in omega
  show p(k) by taut(unsel(mp(all_elim(expand(sub, subset), {k}), hk)))
qed

// ----------------------------------------------------------------------
//  Examples

theorem nat_zero_le(n): n in omega -> int_le(0, n)
proof
  assume h
  show by arith(h)
qed

theorem nat_add_comm(a, b): a in omega -> b in omega -> int_add(a, b) = int_add(b, a)
proof
  assume ha hb
  show by arith(ha, hb)
qed

theorem nat_lt_succ(a, b): a in omega -> b in omega -> int_lt(a, int_add(b, 1)) -> int_le(a, b)
proof
  assume ha hb h
  show by arith(ha, hb, h)
qed

// A function by recursion, and a property by induction: dbl(n) = 2 n.
def dbl(n) := nat_rec(0, k v. int_add(v, 2), n)

theorem dbl_twice: all n. n in omega -> dbl(n) = int_mul(2, n)
proof
  have base: dbl(0) = int_mul(2, 0) by defs(arith(rec({nat_rec(0, k v. int_add(v, 2), 0)})), dbl)
  have step: all n. n in omega -> dbl(n) = int_mul(2, n) -> dbl(int_add(n, 1)) = int_mul(2, int_add(n, 1)) proof
    fix n
    assume hn ih
    have r := rec({nat_rec(0, k v. int_add(v, 2), int_add(n, 1))}, hn)
    show by defs(arith(hn, r, expand(ih, dbl)), dbl)
  qed
  show by induct(base, step)
qed

// ----------------------------------------------------------------------
//  Least elements (`int_min`)

// a property of some natural has a least instance (by induction on a
// bound: either an instance is below n, or n + 1 is the least)
theorem nat_least(x. p): (ex a. a in omega && p(a)) -> ex m. m in omega && p(m) && (all y. y in omega -> p(y) -> int_le(m, y))
proof
  have q: all n. n in omega -> (ex x. x in omega && int_le(x, n) && p(x)) -> ex m. m in omega && p(m) && (all y. y in omega -> p(y) -> int_le(m, y)) proof
    have base: (ex x. x in omega && int_le(x, 0) && p(x)) -> ex m. m in omega && p(m) && (all y. y in omega -> p(y) -> int_le(m, y)) proof
      assume h
      obtain x, hx from h
      have xo: x in omega by taut(hx)
      have xl: int_le(x, 0) by taut(hx)
      have z: x = 0 by arith(xo, xl)
      have p0: p(0) by taut(rewrite(z, hx))
      have o0: 0 in omega by arith()
      have all0: all y. y in omega -> p(y) -> int_le(0, y) proof
        fix y
        assume hy py
        show by arith(hy)
      qed
      show by ex_intro({0}, taut(o0, p0, all0))
    qed
    have step: all n. n in omega -> ((ex x. x in omega && int_le(x, n) && p(x)) -> ex m. m in omega && p(m) && (all y. y in omega -> p(y) -> int_le(m, y))) ->
        (ex x. x in omega && int_le(x, int_add(n, 1)) && p(x)) -> ex m. m in omega && p(m) && (all y. y in omega -> p(y) -> int_le(m, y)) proof
      fix n
      assume hn ih h
      obtain x, hx from h
      have xo: x in omega by taut(hx)
      have xl: int_le(x, int_add(n, 1)) by taut(hx)
      have px: p(x) by taut(hx)
      have cb: !(ex z. z in omega && int_le(z, n) && p(z)) -> ex m. m in omega && p(m) && (all y. y in omega -> p(y) -> int_le(m, y)) proof
        assume nb
        have nle0: int_le(x, n) -> false proof
          assume l
          have c: x in omega && int_le(x, n) && p(x) by taut(xo, l, px)
          have e := ex_intro({x}, {z. z in omega && int_le(z, n) && p(z)}, c)
          show by taut(e, nb)
        qed
        have nle: !int_le(x, n) by taut(nle0)
        have least: all y. y in omega -> p(y) -> int_le(x, y) proof
          fix y
          assume hy py
          have ny0: int_le(y, n) -> false proof
            assume l
            have c: y in omega && int_le(y, n) && p(y) by taut(hy, l, py)
            have e := ex_intro({y}, {z. z in omega && int_le(z, n) && p(z)}, c)
            show by taut(e, nb)
          qed
          have ny: !int_le(y, n) by taut(ny0)
          show by arith(hy, hn, xo, xl, ny)
        qed
        show by ex_intro({x}, taut(xo, px, least))
      qed
      show by taut(ih, cb)
    qed
    show by induct(base, step)
  qed
  assume h
  obtain a, ha from h
  have ao: a in omega by taut(ha)
  have ale: int_le(a, a) by arith(ao)
  have c: a in omega && int_le(a, a) && p(a) by taut(ha, ale)
  have e := ex_intro({a}, {x. x in omega && int_le(x, a) && p(x)}, c)
  show by taut(mp(mp(all_elim(q, {a}), ao), e))
qed

// the least natural with p (when there is one) has p and is below the others
theorem int_min_spec(x. p, a): a in omega -> p(a) ->
  int_min(set_select(omega, x. p(x))) in omega && p(int_min(set_select(omega, x. p(x)))) &&
  (all y. y in omega -> p(y) -> int_le(int_min(set_select(omega, x. p(x))), y))
proof
  assume ha pa
  have c0: a in omega && p(a) by taut(ha, pa)
  have ea := ex_intro({a}, {x. x in omega && p(x)}, c0)
  have l := mp(nat_least[p := x. p(x)], ea)
  obtain m, hm from l
  have mo: m in omega by taut(hm)
  have pm: p(m) by taut(hm)
  have hl: all y. y in omega -> p(y) -> int_le(m, y) by taut(hm)
  have ms: m in set_select(omega, x. p(x)) by sel(taut(mo, pm))
  have ml: all y. y in set_select(omega, x. p(x)) -> int_le(m, y) proof
    fix y
    assume hy
    have u := unsel(hy)
    have yo: y in omega by taut(u)
    have py: p(y) by taut(u)
    show by taut(mp(mp(all_elim(hl, {y}), yo), py))
  qed
  have c1: m in set_select(omega, x. p(x)) && (all y. y in set_select(omega, x. p(x)) -> int_le(m, y)) by taut(ms, ml)
  have em := ex_intro({m}, {k. k in set_select(omega, x. p(x)) && (all y. y in set_select(omega, x. p(x)) -> int_le(k, y))}, c1)
  have cs := mp(choose_spec[p := k. k in set_select(omega, x. p(x)) && (all y. y in set_select(omega, x. p(x)) -> int_le(k, y))], em)
  have mn: int_min(set_select(omega, x. p(x))) = choose(k. k in set_select(omega, x. p(x)) && (all y. y in set_select(omega, x. p(x)) -> int_le(k, y))) := unfold(int_min)[s := set_select(omega, x. p(x))]
  have cm := rewrite(sym(mn), cs)
  have mm: int_min(set_select(omega, x. p(x))) in set_select(omega, x. p(x)) by taut(cm)
  have cl: all y. y in set_select(omega, x. p(x)) -> int_le(int_min(set_select(omega, x. p(x))), y) by taut(cm)
  have um := unsel(mm)
  have low: all y. y in omega -> p(y) -> int_le(int_min(set_select(omega, x. p(x))), y) proof
    fix y
    assume hy py
    have ys: y in set_select(omega, x. p(x)) by sel(taut(hy, py))
    show by taut(mp(all_elim(cl, {y}), ys))
  qed
  show by taut(um, low)
qed

// ---------------------------------------------------------------------
//  Words and integers: an n-bit operation without wrap-around is the
//  integer one (rewrite rules of the proof language's simp, left to right:
//  the word form to the integer form)

theorem bits_add_nowrap(n, a, b): a in omega -> b in omega -> int_lt(int_add(a, b), pow2(n)) -> bits_add(n, a, b) = int_add(a, b)
proof
  assume ha hb hl
  show by arith(ha, hb, hl)
qed

theorem bits_sub_nowrap(n, a, b): a in omega -> b in omega -> int_le(b, a) -> int_lt(a, pow2(n)) -> bits_sub(n, a, b) = int_sub(a, b)
proof
  assume ha hb hl hm
  show by arith(ha, hb, hl, hm)
qed

theorem bits_of_int_small(n, a): a in omega -> int_lt(a, pow2(n)) -> bits_of_int(n, a) = a
proof
  assume ha hl
  show by arith(ha, hl)
qed

theorem add_in_bits(n, a, b): a in omega -> b in omega -> int_lt(int_add(a, b), pow2(n)) -> int_add(a, b) in bits(n)
proof
  assume ha hb hl
  show by arith(ha, hb, hl)
qed

simp bits_add_nowrap
simp bits_sub_nowrap
simp bits_of_int_small
simp add_in_bits

// ----------------------------------------------------------------------
//  Bits: a word is determined by its bits

// (a word with no bit set: 0)
theorem bits_zero: all n. n in omega -> all y. y in omega -> int_lt(y, pow2(n)) -> (all i. i in omega -> int_lt(i, n) -> !bit(y, i)) -> y = 0
proof
  have base: all y. y in omega -> int_lt(y, pow2(0)) -> (all i. i in omega -> int_lt(i, 0) -> !bit(y, i)) -> y = 0 proof
    fix y
    assume hy hl _
    have p0: pow2(0) = 1 by simp()
    show by arith(hy, rewrite(p0, hl))
  qed
  have step: all n. n in omega -> (all y. y in omega -> int_lt(y, pow2(n)) -> (all i. i in omega -> int_lt(i, n) -> !bit(y, i)) -> y = 0) ->
      (all y. y in omega -> int_lt(y, pow2(int_add(n, 1))) -> (all i. i in omega -> int_lt(i, int_add(n, 1)) -> !bit(y, i)) -> y = 0) proof
    fix n
    assume hn ih
    fix y
    assume hy hl hb
    // the top bit clear: below pow2(n)
    have bn: !(int_mod(int_div(y, pow2(n)), 2) = 1) by defs(mp(all_elim(hb, {n}), hn, arith(hn)), bit)
    have lo: int_lt(y, pow2(n)) by arith(hn, hy, hl, bn)
    have hb2: all i. i in omega -> int_lt(i, n) -> !bit(y, i) proof
      fix i
      assume i1 i2
      show := mp(all_elim(hb, {i}), i1, arith(i2))
    qed
    show := mp(all_elim(ih, {y}), hy, lo, hb2)
  qed
  show := mp(nat_ind[p := k. all y. y in omega -> int_lt(y, pow2(k)) -> (all i. i in omega -> int_lt(i, k) -> !bit(y, i)) -> y = 0], base, step)
qed

// x xor x: 0
theorem bits_xor_self: all n x. n in omega -> bits_xor(n, x, x) = 0
proof
  fix n x
  assume hn
  have pq: all y. (y in bits(n) && (all i. i in omega -> int_lt(i, n) -> (bit(y, i) <-> !(bit(x, i) <-> bit(x, i))))) <-> y = 0 proof
    fix y
    have d1: (y in bits(n) && (all i. i in omega -> int_lt(i, n) -> (bit(y, i) <-> !(bit(x, i) <-> bit(x, i))))) -> y = 0 proof
      assume h
      have hy hall := h
      have nb: all i. i in omega -> int_lt(i, n) -> !bit(y, i) proof
        fix i
        assume i1 i2
        have c := mp(all_elim(hall, {i}), i1, i2)
        show by taut(c)
      qed
      have yo: y in omega && int_lt(y, pow2(n)) by arith(hn, hy)
      show := mp(all_elim(mp(all_elim(bits_zero, {n}), hn), {y}), taut(yo), taut(yo), nb)
    qed
    have d2: y = 0 -> (y in bits(n) && (all i. i in omega -> int_lt(i, n) -> (bit(y, i) <-> !(bit(x, i) <-> bit(x, i))))) proof
      assume e
      have pp: int_lt(0, pow2(n)) by arith(hn)
      have zb: 0 in bits(n) by arith(hn, pp)
      have zbit: all i. i in omega -> int_lt(i, n) -> (bit(0, i) <-> !(bit(x, i) <-> bit(x, i))) proof
        fix i
        assume i1 i2
        have nz: !(int_mod(int_div(0, pow2(i)), 2) = 1) by arith(i1)
        show by defs(taut(nz), bit)
      qed
      have z: 0 in bits(n) && (all i. i in omega -> int_lt(i, n) -> (bit(0, i) <-> !(bit(x, i) <-> bit(x, i)))) by taut(zb, zbit)
      show := rewrite(sym(e), z)
    qed
    show by taut(d1, d2)
  qed
  have e := mp(choose_ext[p := y. y in bits(n) && (all i. i in omega -> int_lt(i, n) -> (bit(y, i) <-> !(bit(x, i) <-> bit(x, i)))), q := y. y = 0], pq)
  have c0 := mp(choose_eq[a := 0], ex_intro({0}, refl({0})))
  show by defs(trans(e, c0), bits_xor, bits_build)
qed

theorem pow256_pos: all i. i in omega -> int_lt(0, int_pow(256, i))
proof
  have base: int_lt(0, int_pow(256, 0)) by simp()
  have step: all n. n in omega -> int_lt(0, int_pow(256, n)) -> int_lt(0, int_pow(256, int_add(n, 1))) proof
    fix n
    assume hn ih
    have r := rec({nat_rec(1, k v. int_mul(v, 256), int_add(n, 1))}, hn)
    have v1: int_val(int_add(n, 1)) = int_add(n, 1) by simp(hn)
    have v0: int_val(n) = n by simp(hn)
    have e: int_pow(256, int_add(n, 1)) = int_mul(int_pow(256, n), 256) by defs(simp(r, v1, v0, hn), int_pow)
    show by arith(e, ih)
  qed
  show := mp(nat_ind[p := k. int_lt(0, int_pow(256, k))], base, step)
qed

theorem pow256_add: all n. n in omega -> (all i. i in omega -> int_pow(256, int_add(n, i)) = int_mul(int_pow(256, n), int_pow(256, i)))
proof
  fix n
  assume hn
  have base: int_pow(256, int_add(n, 0)) = int_mul(int_pow(256, n), int_pow(256, 0)) by simp(hn)
  have step: all i. i in omega -> int_pow(256, int_add(n, i)) = int_mul(int_pow(256, n), int_pow(256, i)) ->
      int_pow(256, int_add(n, int_add(i, 1))) = int_mul(int_pow(256, n), int_pow(256, int_add(i, 1))) proof
    fix i
    assume hi ih
    have ni: int_add(n, i) in omega by simp(hn, hi)
    have e1: int_add(n, int_add(i, 1)) = int_add(int_add(n, i), 1) by arith(hn, hi)
    have r1 := rec({nat_rec(1, k v. int_mul(v, 256), int_add(int_add(n, i), 1))}, ni)
    have r2 := rec({nat_rec(1, k v. int_mul(v, 256), int_add(i, 1))}, hi)
    have p1: int_pow(256, int_add(int_add(n, i), 1)) = int_mul(int_pow(256, int_add(n, i)), 256) by defs(simp(r1, ni), int_pow)
    have p2: int_pow(256, int_add(i, 1)) = int_mul(int_pow(256, i), 256) by defs(simp(r2, hi), int_pow)
    show by simp(e1, p1, p2, ih)
  qed
  show by induct(base, step)
qed

// (an element of a natural number is one)
theorem nat_elem(k, i): k in omega -> i in k -> i in omega
proof
  have all_k: all n. n in omega -> (all j. j in n -> j in omega) proof
    have base: all j. j in 0 -> j in omega proof
      fix j
      assume hj
      have he := rewrite(lit_zero, hj)
      show by taut(he, empty_mem[x := j])
    qed
    have step: all n. n in omega -> (all j. j in n -> j in omega) -> (all j. j in int_add(n, 1) -> j in omega) proof
      fix n
      assume hn ih
      fix j
      assume hj
      have e: succ(n) = int_add(n, 1) by arith(hn)
      have h2 := expand(expand(rewrite(sym(e), hj), succ), union2)
      have u: ex y. j in y && y in upair(n, single(n)) by taut(h2, union_def[s := upair(n, single(n)), a := j])
      obtain y, hy from u
      have jy: j in y by taut(hy)
      have yu := mp(upair_elim[a := n, b := single(n), z := y], taut(hy))
      have c1: y = n -> j in omega proof
        assume e1
        show := mp(all_elim(ih, {j}), rewrite(e1, jy))
      qed
      have c2: y = single(n) -> j in omega proof
        assume e2
        have jn := mp(single_elim[a := n, z := j], rewrite(e2, jy))
        show := rewrite(sym(jn), hn)
      qed
      show by taut(yu, c1, c2)
    qed
    show := mp(mp(nat_ind[p := x. all j. j in x -> j in omega], base), step)
  qed
  assume hk hi
  show := mp(all_elim(mp(all_elim(all_k, {k}), hk), {i}), hi)
qed

// (a natural below n is an element of n)
theorem nat_lt_mem(k, n): k in omega -> n in omega -> int_lt(k, n) -> k in n
proof
  have all_n: all n. n in omega -> (all j. j in omega -> int_lt(j, n) -> j in n) proof
    have base: all j. j in omega -> int_lt(j, 0) -> j in 0 proof
      fix j
      assume hj hl
      have f: false by arith(hj, hl)
      show by taut(f)
    qed
    have step: all n. n in omega -> (all j. j in omega -> int_lt(j, n) -> j in n) -> (all j. j in omega -> int_lt(j, int_add(n, 1)) -> j in int_add(n, 1)) proof
      fix n
      assume hn ih
      fix j
      assume hj hl
      have e: succ(n) = int_add(n, 1) by arith(hn)
      // succ(n) = union(upair(n, single(n))): j in n, or j = n
      have c1: j in n -> j in succ(n) proof
        assume jn
        have ex1: ex y. j in y && y in upair(n, single(n)) by ex_intro({n}, taut(jn, upair_l[a := n, b := single(n)]))
        show by defs(taut(union_def[s := upair(n, single(n)), a := j], ex1), succ, union2)
      qed
      have c2: j = n -> j in succ(n) proof
        assume jeq
        have js := subst({y. y in single(n)}, sym(jeq), single_intro[a := n])
        have ex1: ex y. j in y && y in upair(n, single(n)) by ex_intro({single(n)}, taut(js, upair_r[a := n, b := single(n)]))
        show by defs(taut(union_def[s := upair(n, single(n)), a := j], ex1), succ, union2)
      qed
      have c: int_lt(j, n) || j = n by arith(hj, hn, hl)
      have c3 := mp(all_elim(ih, {j}), hj)
      have js: j in succ(n) by taut(c, c1, c2, c3)
      show := rewrite(e, js)
    qed
    show := mp(mp(nat_ind[p := x. all j. j in omega -> int_lt(j, x) -> j in x], base), step)
  qed
  assume hk hn hl
  show := mp(all_elim(mp(all_elim(all_n, {n}), hn), {k}), hk, hl)
qed

// a sum of naturals is one
theorem int_sum_nat(a, b, i. f): a in omega -> b in omega -> (all i. i in omega -> f(i) in omega) -> int_sum(a, b, i. f(i)) in omega
proof
  assume ha hb hf
  have base: nat_rec(empty, k v. int_add(v, f(int_add(a, k))), 0) in omega by simp(rec({nat_rec(empty, k v. int_add(v, f(int_add(a, k))), 0)}), lit_zero)
  have step: all n. n in omega -> nat_rec(empty, k v. int_add(v, f(int_add(a, k))), n) in omega ->
      nat_rec(empty, k v. int_add(v, f(int_add(a, k))), int_add(n, 1)) in omega proof
    fix n
    assume hn ih
    have r := rec({nat_rec(empty, k v. int_add(v, f(int_add(a, k))), int_add(n, 1))}, hn)
    have fa := mp(all_elim(hf, {int_add(a, n)}), (int_add(a, n) in omega by arith(ha, hn)))
    show by arith(r, ih, fa)
  qed
  have all_n: all n. n in omega -> nat_rec(empty, k v. int_add(v, f(int_add(a, k))), n) in omega by induct(base, step)
  have d: ite(int_le(a, b), int_sub(b, a), empty) in omega by simp(ha, hb, lit_zero)
  show by defs(mp(all_elim(all_n, {ite(int_le(a, b), int_sub(b, a), empty)}), d), int_sum)
qed

// sums of the same terms are equal
theorem int_sum_ext(a, b, i. f, i. g): a in omega -> b in omega ->
  (all i. i in omega -> int_le(a, i) -> int_lt(i, b) -> f(i) = g(i)) -> int_sum(a, b, i. f(i)) = int_sum(a, b, i. g(i))
proof
  assume ha hb he
  have base: int_le(int_add(a, 0), b) -> nat_rec(empty, k v. int_add(v, f(int_add(a, k))), 0) = nat_rec(empty, k v. int_add(v, g(int_add(a, k))), 0) proof
    assume _
    have r1 := rec({nat_rec(empty, k v. int_add(v, f(int_add(a, k))), 0)})
    have r2 := rec({nat_rec(empty, k v. int_add(v, g(int_add(a, k))), 0)})
    show := trans(r1, sym(r2))
  qed
  have step: all n. n in omega -> (int_le(int_add(a, n), b) -> nat_rec(empty, k v. int_add(v, f(int_add(a, k))), n) = nat_rec(empty, k v. int_add(v, g(int_add(a, k))), n)) ->
      (int_le(int_add(a, int_add(n, 1)), b) -> nat_rec(empty, k v. int_add(v, f(int_add(a, k))), int_add(n, 1)) = nat_rec(empty, k v. int_add(v, g(int_add(a, k))), int_add(n, 1))) proof
    fix n
    assume hn ih hl
    have r1 := rec({nat_rec(empty, k v. int_add(v, f(int_add(a, k))), int_add(n, 1))}, hn)
    have r2 := rec({nat_rec(empty, k v. int_add(v, g(int_add(a, k))), int_add(n, 1))}, hn)
    have l0: int_le(int_add(a, n), b) by arith(hl)
    have e0 := mp(ih, l0)
    have ef := mp(all_elim(he, {int_add(a, n)}), (int_add(a, n) in omega by arith(ha, hn)), (int_le(a, int_add(a, n)) by arith(hn)), (int_lt(int_add(a, n), b) by arith(hl)))
    show by simp(r1, r2, e0, ef)
  qed
  have all_n: all n. n in omega -> (int_le(int_add(a, n), b) -> nat_rec(empty, k v. int_add(v, f(int_add(a, k))), n) = nat_rec(empty, k v. int_add(v, g(int_add(a, k))), n)) by induct(base, step)
  have c1: int_le(a, b) -> int_sum(a, b, i. f(i)) = int_sum(a, b, i. g(i)) proof
    assume l
    have d: int_sub(b, a) in omega by arith(ha, hb, l)
    have e := mp(all_elim(all_n, {int_sub(b, a)}), d, (int_le(int_add(a, int_sub(b, a)), b) by arith(ha, hb)))
    have it := mp(ite_t[c := int_le(a, b), a := int_sub(b, a), b := empty], l)
    show by defs(simp(e, it), int_sum)
  qed
  have c2: !int_le(a, b) -> int_sum(a, b, i. f(i)) = int_sum(a, b, i. g(i)) proof
    assume l
    have it := mp(ite_f[c := int_le(a, b), a := int_sub(b, a), b := empty], l)
    have r1 := rec({nat_rec(empty, k v. int_add(v, f(int_add(a, k))), 0)})
    have r2 := rec({nat_rec(empty, k v. int_add(v, g(int_add(a, k))), 0)})
    show by defs(simp(it, rewrite(lit_zero, r1), rewrite(lit_zero, r2)), int_sum)
  qed
  show by taut(c1, c2)
qed
