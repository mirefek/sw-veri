// Natural numbers: induction, and examples of `arith`, `rec` and `induct`.
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core

// ----------------------------------------------------------------------
//  Induction (from the axiom omega_ind)

theorem nat_ind(x. p): p(0) -> (all n. n in omega -> p(n) -> p(nat_add(n, 1))) -> all n. n in omega -> p(n)
proof
  assume h0: p(0)
  assume hs: all n. n in omega -> p(n) -> p(nat_add(n, 1))
  // the naturals with p form an inductive set
  have e0: empty in set_select(omega, n. p(n)) by sel(taut(omega_zero, rewrite(lit_zero, h0)))
  fix m
  assume hm: m in set_select(omega, n. p(n))
  have um := unsel(hm)
  have mo: m in omega by taut(um)
  have pm: p(m) by taut(um)
  have pn := mp(mp(all_elim(hs, {m}), mo), pm)
  have eq: nat_add(m, 1) = succ(m) by arith(mo)
  have sm: succ(m) in set_select(omega, n. p(n)) by sel(taut(mp(omega_succ[n := m], mo), rewrite(eq, pn)))
  have st := gen(discharge(sm, hm), m)
  have sub := mp(mp(omega_ind[s := set_select(omega, n. p(n))], e0), st)
  // so every natural has p
  fix k
  assume hk: k in omega
  show p(k) by taut(unsel(mp(all_elim(expand(sub, subset), {k}), hk)))
qed

// ----------------------------------------------------------------------
//  Examples

theorem nat_zero_le(n): n in omega -> nat_le(0, n)
proof
  assume h: n in omega
  show by arith(h)
qed

theorem nat_add_comm(a, b): a in omega -> b in omega -> nat_add(a, b) = nat_add(b, a)
proof
  assume ha: a in omega
  assume hb: b in omega
  show by arith(ha, hb)
qed

theorem nat_lt_succ(a, b): a in omega -> b in omega -> nat_lt(a, nat_add(b, 1)) -> nat_le(a, b)
proof
  assume ha: a in omega
  assume hb: b in omega
  assume h: nat_lt(a, nat_add(b, 1))
  show by arith(ha, hb, h)
qed

// A function by recursion, and a property by induction: dbl(n) = 2 n.
def dbl(n) := nat_rec(0, k v. nat_add(v, 2), n)

theorem dbl_twice: all n. n in omega -> dbl(n) = nat_mul(2, n)
proof
  have base: dbl(0) = nat_mul(2, 0) by defs(arith(rec({nat_rec(0, k v. nat_add(v, 2), 0)})), dbl)
  have step: all n. n in omega -> dbl(n) = nat_mul(2, n) -> dbl(nat_add(n, 1)) = nat_mul(2, nat_add(n, 1)) proof
    fix n
    assume hn: n in omega
    assume ih: dbl(n) = nat_mul(2, n)
    have r := rec({nat_rec(0, k v. nat_add(v, 2), nat_add(n, 1))}, hn)
    show by defs(arith(hn, r, expand(ih, dbl)), dbl)
  qed
  show by induct(base, step)
qed

// ----------------------------------------------------------------------
//  Least elements (`nat_min`)

// a property of some natural has a least instance (by induction on a
// bound: either an instance is below n, or n + 1 is the least)
theorem nat_least(x. p): (ex a. a in omega && p(a)) -> ex m. m in omega && p(m) && (all y. y in omega -> p(y) -> nat_le(m, y))
proof
  have q: all n. n in omega -> (ex x. x in omega && nat_le(x, n) && p(x)) -> ex m. m in omega && p(m) && (all y. y in omega -> p(y) -> nat_le(m, y)) proof
    have base: (ex x. x in omega && nat_le(x, 0) && p(x)) -> ex m. m in omega && p(m) && (all y. y in omega -> p(y) -> nat_le(m, y)) proof
      assume h: ex x. x in omega && nat_le(x, 0) && p(x)
      obtain x, hx from h
      have xo: x in omega by taut(hx)
      have xl: nat_le(x, 0) by taut(hx)
      have z: x = 0 by arith(xo, xl)
      have p0: p(0) by taut(rewrite(z, hx))
      have o0: 0 in omega by arith()
      have all0: all y. y in omega -> p(y) -> nat_le(0, y) proof
        fix y
        assume hy: y in omega
        assume py: p(y)
        show by arith(hy)
      qed
      show by ex_intro({0}, taut(o0, p0, all0))
    qed
    have step: all n. n in omega -> ((ex x. x in omega && nat_le(x, n) && p(x)) -> ex m. m in omega && p(m) && (all y. y in omega -> p(y) -> nat_le(m, y))) ->
        (ex x. x in omega && nat_le(x, nat_add(n, 1)) && p(x)) -> ex m. m in omega && p(m) && (all y. y in omega -> p(y) -> nat_le(m, y)) proof
      fix n
      assume hn: n in omega
      assume ih: (ex x. x in omega && nat_le(x, n) && p(x)) -> ex m. m in omega && p(m) && (all y. y in omega -> p(y) -> nat_le(m, y))
      assume h: ex x. x in omega && nat_le(x, nat_add(n, 1)) && p(x)
      obtain x, hx from h
      have xo: x in omega by taut(hx)
      have xl: nat_le(x, nat_add(n, 1)) by taut(hx)
      have px: p(x) by taut(hx)
      have cb: !(ex z. z in omega && nat_le(z, n) && p(z)) -> ex m. m in omega && p(m) && (all y. y in omega -> p(y) -> nat_le(m, y)) proof
        assume nb: !(ex z. z in omega && nat_le(z, n) && p(z))
        have nle0: nat_le(x, n) -> false proof
          assume l: nat_le(x, n)
          have c: x in omega && nat_le(x, n) && p(x) by taut(xo, l, px)
          have e := ex_intro({x}, {z. z in omega && nat_le(z, n) && p(z)}, c)
          show by taut(e, nb)
        qed
        have nle: !nat_le(x, n) by taut(nle0)
        have least: all y. y in omega -> p(y) -> nat_le(x, y) proof
          fix y
          assume hy: y in omega
          assume py: p(y)
          have ny0: nat_le(y, n) -> false proof
            assume l: nat_le(y, n)
            have c: y in omega && nat_le(y, n) && p(y) by taut(hy, l, py)
            have e := ex_intro({y}, {z. z in omega && nat_le(z, n) && p(z)}, c)
            show by taut(e, nb)
          qed
          have ny: !nat_le(y, n) by taut(ny0)
          show by arith(hy, hn, xo, xl, ny)
        qed
        show by ex_intro({x}, taut(xo, px, least))
      qed
      show by taut(ih, cb)
    qed
    show by induct(base, step)
  qed
  assume h: ex a. a in omega && p(a)
  obtain a, ha from h
  have ao: a in omega by taut(ha)
  have ale: nat_le(a, a) by arith(ao)
  have c: a in omega && nat_le(a, a) && p(a) by taut(ha, ale)
  have e := ex_intro({a}, {x. x in omega && nat_le(x, a) && p(x)}, c)
  show by taut(mp(mp(all_elim(q, {a}), ao), e))
qed

// the least natural with p (when there is one) has p and is below the others
theorem nat_min_spec(x. p, a): a in omega -> p(a) ->
  nat_min(set_select(omega, x. p(x))) in omega && p(nat_min(set_select(omega, x. p(x)))) &&
  (all y. y in omega -> p(y) -> nat_le(nat_min(set_select(omega, x. p(x))), y))
proof
  assume ha: a in omega
  assume pa: p(a)
  have c0: a in omega && p(a) by taut(ha, pa)
  have ea := ex_intro({a}, {x. x in omega && p(x)}, c0)
  have l := mp(nat_least[p := x. p(x)], ea)
  obtain m, hm from l
  have mo: m in omega by taut(hm)
  have pm: p(m) by taut(hm)
  have hl: all y. y in omega -> p(y) -> nat_le(m, y) by taut(hm)
  have ms: m in set_select(omega, x. p(x)) by sel(taut(mo, pm))
  have ml: all y. y in set_select(omega, x. p(x)) -> nat_le(m, y) proof
    fix y
    assume hy: y in set_select(omega, x. p(x))
    have u := unsel(hy)
    have yo: y in omega by taut(u)
    have py: p(y) by taut(u)
    show by taut(mp(mp(all_elim(hl, {y}), yo), py))
  qed
  have c1: m in set_select(omega, x. p(x)) && (all y. y in set_select(omega, x. p(x)) -> nat_le(m, y)) by taut(ms, ml)
  have em := ex_intro({m}, {k. k in set_select(omega, x. p(x)) && (all y. y in set_select(omega, x. p(x)) -> nat_le(k, y))}, c1)
  have cs := mp(choose_spec[p := k. k in set_select(omega, x. p(x)) && (all y. y in set_select(omega, x. p(x)) -> nat_le(k, y))], em)
  have mn: nat_min(set_select(omega, x. p(x))) = choose(k. k in set_select(omega, x. p(x)) && (all y. y in set_select(omega, x. p(x)) -> nat_le(k, y))) := unfold(nat_min)[s := set_select(omega, x. p(x))]
  have cm := rewrite(sym(mn), cs)
  have mm: nat_min(set_select(omega, x. p(x))) in set_select(omega, x. p(x)) by taut(cm)
  have cl: all y. y in set_select(omega, x. p(x)) -> nat_le(nat_min(set_select(omega, x. p(x))), y) by taut(cm)
  have um := unsel(mm)
  have low: all y. y in omega -> p(y) -> nat_le(nat_min(set_select(omega, x. p(x))), y) proof
    fix y
    assume hy: y in omega
    assume py: p(y)
    have ys: y in set_select(omega, x. p(x)) by sel(taut(hy, py))
    show by taut(mp(all_elim(cl, {y}), ys))
  qed
  show by taut(um, low)
qed
