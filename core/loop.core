// Loops: `while_rel` (prelude) with an invariant, and termination with a
// variant. These justify the loop step of `simp` (`inv{...}` hints); one
// iteration (`while_unroll`) and runs built an iteration at a time
// (`while_stop`, `while_leave`, `while_step`) justify its `unroll`. All
// proven from `while_rel`'s definition.
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core core/loop.core

// ----------------------------------------------------------------------
//  The two ways a loop runs, each on its own

// finitely many iterations: the loop stops in a state with the invariant,
// by its condition or by an outcome of the body that is not `ok` (the
// spec's loops exit that way: `break` and `return` are exceptions of the body)
theorem while_fin(l0, l. c, l o. b, r, l. p):
  p(l0) -> (all l l2. p(l) -> c(l) -> b(l, ok(l2, empty)) -> p(l2)) ->
  (ex n f. n in omega && is_fun(f) && dom(f) = succ(n) && app(f, empty) = l0 &&
     (all i. i in n -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) &&
     ((!c(app(f, n)) && r = ok(app(f, n), empty)) ||
      (c(app(f, n)) && b(app(f, n), r) && !is_ok(r)))) ->
  ex l. p(l) && ((!c(l) && r = ok(l, empty)) || (c(l) && b(l, r) && !is_ok(r)))
proof
  assume h0: p(l0)
  assume hs: all l l2. p(l) -> c(l) -> b(l, ok(l2, empty)) -> p(l2)
  assume h: ex n f. n in omega && is_fun(f) && dom(f) = succ(n) && app(f, empty) = l0 &&
     (all i. i in n -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) &&
     ((!c(app(f, n)) && r = ok(app(f, n), empty)) ||
      (c(app(f, n)) && b(app(f, n), r) && !is_ok(r)))
  obtain n, h1 from h
  obtain f, hf from h1
  have hn: n in omega by taut(hf)
  have hst: all i. i in n -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty)) by taut(hf)
  have hf0: app(f, empty) = l0 by taut(hf)
  // every state up to n has the invariant
  have all_p: all i. i in omega -> int_le(i, n) -> p(app(f, i)) proof
    have base: int_le(0, n) -> p(app(f, 0)) proof
      assume z: int_le(0, n)
      show by taut(rewrite(sym(lit_zero), rewrite(sym(hf0), h0)))
    qed
    have step: all i. i in omega -> (int_le(i, n) -> p(app(f, i))) ->
        int_le(int_add(i, 1), n) -> p(app(f, int_add(i, 1))) proof
      fix i
      assume hi: i in omega
      assume ih: int_le(i, n) -> p(app(f, i))
      assume hle: int_le(int_add(i, 1), n)
      have le: int_le(i, n) by arith(hi, hn, hle)
      have lt: i in n by arith(hi, hn, hle)
      have cb := mp(all_elim(hst, {i}), lt)
      have ci: c(app(f, i)) by taut(cb)
      have bi: b(app(f, i), ok(app(f, succ(i)), empty)) by taut(cb)
      have ps := mp(mp(mp(all_elim(all_elim(hs, {app(f, i)}), {app(f, succ(i))}), mp(ih, le)), ci), bi)
      have eq: succ(i) = int_add(i, 1) by arith(hi)
      show by taut(rewrite(eq, ps))
    qed
    show by induct(base, step)
  qed
  have nn: int_le(n, n) by arith(hn)
  have pn := mp(mp(all_elim(all_p, {n}), hn), nn)
  show by ex_intro({app(f, n)}, taut(pn, hf))
qed

// infinitely many iterations: the loop diverges
theorem while_inf(l0, l. c, l o. b, l. tr, r):
  (ex f. is_fun(f) && dom(f) = omega && app(f, empty) = l0 &&
     (all i. i in omega -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) &&
     r = diverge(trace_limit(i. tr(app(f, i))))) ->
  ex t. r = diverge(t)
proof
  assume h: ex f. is_fun(f) && dom(f) = omega && app(f, empty) = l0 &&
     (all i. i in omega -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) &&
     r = diverge(trace_limit(i. tr(app(f, i))))
  obtain f, hf from h
  show by ex_intro({trace_limit(i. tr(app(f, i)))}, taut(hf))
qed

// ... which a variant rules out: a natural number that each iteration
// decreases
theorem while_no_inf(l0, l. c, l o. b, l. tr, r, l. p, l. m):
  p(l0) -> (all l l2. p(l) -> c(l) -> b(l, ok(l2, empty)) -> p(l2)) ->
  (all l. p(l) -> m(l) in omega) ->
  (all l l2. p(l) -> c(l) -> b(l, ok(l2, empty)) -> int_lt(m(l2), m(l))) ->
  (ex f. is_fun(f) && dom(f) = omega && app(f, empty) = l0 &&
     (all i. i in omega -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) &&
     r = diverge(trace_limit(i. tr(app(f, i))))) ->
  false
proof
  assume h0: p(l0)
  assume hs: all l l2. p(l) -> c(l) -> b(l, ok(l2, empty)) -> p(l2)
  assume hm: all l. p(l) -> m(l) in omega
  assume hd: all l l2. p(l) -> c(l) -> b(l, ok(l2, empty)) -> int_lt(m(l2), m(l))
  assume h: ex f. is_fun(f) && dom(f) = omega && app(f, empty) = l0 &&
     (all i. i in omega -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) &&
     r = diverge(trace_limit(i. tr(app(f, i))))
  obtain f, hf from h
  have hst: all i. i in omega -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty)) by taut(hf)
  have hf0: app(f, empty) = l0 by taut(hf)
  have p0: p(app(f, 0)) by taut(rewrite(sym(lit_zero), rewrite(sym(hf0), h0)))
  have m0 := mp(all_elim(hm, {app(f, 0)}), p0)
  // every state has the invariant, and the variant has dropped by i after i steps
  have all_p: all i. i in omega -> p(app(f, i)) && int_le(int_add(m(app(f, i)), i), m(app(f, 0))) proof
    have b0: int_le(int_add(m(app(f, 0)), 0), m(app(f, 0))) by arith(m0)
    have base: p(app(f, 0)) && int_le(int_add(m(app(f, 0)), 0), m(app(f, 0))) by taut(p0, b0)
    have step: all i. i in omega -> (p(app(f, i)) && int_le(int_add(m(app(f, i)), i), m(app(f, 0)))) ->
        p(app(f, int_add(i, 1))) && int_le(int_add(m(app(f, int_add(i, 1))), int_add(i, 1)), m(app(f, 0))) proof
      fix i
      assume hi: i in omega
      assume ih: p(app(f, i)) && int_le(int_add(m(app(f, i)), i), m(app(f, 0)))
      have pi: p(app(f, i)) by taut(ih)
      have le: int_le(int_add(m(app(f, i)), i), m(app(f, 0))) by taut(ih)
      have cb := mp(all_elim(hst, {i}), hi)
      have ci: c(app(f, i)) by taut(cb)
      have bi: b(app(f, i), ok(app(f, succ(i)), empty)) by taut(cb)
      have eq: succ(i) = int_add(i, 1) by arith(hi)
      have ps := rewrite(eq, mp(mp(mp(all_elim(all_elim(hs, {app(f, i)}), {app(f, succ(i))}), pi), ci), bi))
      have lt := rewrite(eq, mp(mp(mp(all_elim(all_elim(hd, {app(f, i)}), {app(f, succ(i))}), pi), ci), bi))
      have mi := mp(all_elim(hm, {app(f, i)}), pi)
      have ms := mp(all_elim(hm, {app(f, int_add(i, 1))}), ps)
      have ls: int_le(int_add(m(app(f, int_add(i, 1))), int_add(i, 1)), m(app(f, 0))) by arith(hi, le, lt, mi, ms, m0)
      show by taut(ps, ls)
    qed
    show by induct(base, step)
  qed
  // after m(f(0)) + 1 steps, the variant would be negative
  have ko: int_add(m(app(f, 0)), 1) in omega by arith(m0)
  have pk := mp(all_elim(all_p, {int_add(m(app(f, 0)), 1)}), ko)
  have pkp: p(app(f, int_add(m(app(f, 0)), 1))) by taut(pk)
  have mk := mp(all_elim(hm, {app(f, int_add(m(app(f, 0)), 1))}), pkp)
  have lek: int_le(int_add(m(app(f, int_add(m(app(f, 0)), 1))), int_add(m(app(f, 0)), 1)), m(app(f, 0))) by taut(pk)
  show by arith(m0, mk, lek)
qed

// ----------------------------------------------------------------------
//  One iteration (`simp(.., unroll)`): the loop stops at l0, its body
//  leaves, or the body continues to l1 and the loop runs on from there --
//  with an outcome r1 of the same kind: r itself, or, if the loop diverges,
//  a divergence too (the trace of an infinite run from l1 need not be the
//  one from l0): the runs from l0 are those from l1, shifted.

// (an element of a natural number is one)
theorem nat_elem(k, i): k in omega -> i in k -> i in omega
proof
  have all_k: all n. n in omega -> (all j. j in n -> j in omega) proof
    have base: all j. j in 0 -> j in omega proof
      fix j
      assume hj: j in 0
      have he := rewrite(lit_zero, hj)
      show by taut(he, empty_mem[x := j])
    qed
    have step: all n. n in omega -> (all j. j in n -> j in omega) -> (all j. j in int_add(n, 1) -> j in omega) proof
      fix n
      assume hn: n in omega
      assume ih: all j. j in n -> j in omega
      fix j
      assume hj: j in int_add(n, 1)
      have e: succ(n) = int_add(n, 1) by arith(hn)
      have h2 := expand(expand(rewrite(sym(e), hj), succ), union2)
      have u: ex y. j in y && y in upair(n, single(n)) by taut(h2, union_def[s := upair(n, single(n)), a := j])
      obtain y, hy from u
      have jy: j in y by taut(hy)
      have yu := mp(upair_elim[a := n, b := single(n), z := y], taut(hy))
      have c1: y = n -> j in omega proof
        assume e1: y = n
        show := mp(all_elim(ih, {j}), rewrite(e1, jy))
      qed
      have c2: y = single(n) -> j in omega proof
        assume e2: y = single(n)
        have jn := mp(single_elim[a := n, z := j], rewrite(e2, jy))
        show := rewrite(sym(jn), hn)
      qed
      show by taut(yu, c1, c2)
    qed
    show := mp(mp(nat_ind[p := x. all j. j in x -> j in omega], base), step)
  qed
  assume hk: k in omega
  assume hi: i in k
  show := mp(all_elim(mp(all_elim(all_k, {k}), hk), {i}), hi)
qed

// (succ(0) as a numeral: 0 + 1)
theorem succ_zero: succ(empty) = int_add(0, 1)
proof
  have a: succ(0) = int_add(0, 1) by arith()
  show := subst({y. succ(y) = int_add(0, 1)}, lit_zero, a)
qed

theorem while_unroll(l0, l. c, l o. b, l. tr, r):
  while_rel(l0, l. c(l), l o. b(l, o), l. tr(l), r) ->
  (!c(l0) && r = ok(l0, empty)) || (c(l0) && b(l0, r) && !is_ok(r)) ||
  (c(l0) && (ex l1. b(l0, ok(l1, empty)) && (ex r1. while_rel(l1, l. c(l), l o. b(l, o), l. tr(l), r1) &&
     fst(r1) = fst(r) && (!(fst(r) = 2) -> r1 = r))))
proof
  assume hw: while_rel(l0, l. c(l), l o. b(l, o), l. tr(l), r)
  have s0 := succ_zero
  have zo: 0 in omega := rewrite(sym(lit_zero), omega_zero)
  // finitely many iterations
  have fcase: (ex n f. n in omega && is_fun(f) && dom(f) = succ(n) && app(f, empty) = l0 &&
      (all i. i in n -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) &&
      ((!c(app(f, n)) && r = ok(app(f, n), empty)) || (c(app(f, n)) && b(app(f, n), r) && !is_ok(r)))) ->
      (!c(l0) && r = ok(l0, empty)) || (c(l0) && b(l0, r) && !is_ok(r)) ||
      (c(l0) && (ex l1. b(l0, ok(l1, empty)) && (ex r1. while_rel(l1, l. c(l), l o. b(l, o), l. tr(l), r1) &&
        fst(r1) = fst(r) && (!(fst(r) = 2) -> r1 = r)))) proof
    assume e: ex n f. n in omega && is_fun(f) && dom(f) = succ(n) && app(f, empty) = l0 &&
      (all i. i in n -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) &&
      ((!c(app(f, n)) && r = ok(app(f, n), empty)) || (c(app(f, n)) && b(app(f, n), r) && !is_ok(r)))
    obtain n, h1 from e
    obtain f, hf from h1
    have hn: n in omega by taut(hf)
    have hf0: app(f, empty) = l0 by taut(hf)
    have hst: all i. i in n -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty)) by taut(hf)
    have hend: (!c(app(f, n)) && r = ok(app(f, n), empty)) || (c(app(f, n)) && b(app(f, n), r) && !is_ok(r)) by taut(hf)
    // no iteration: the loop stops at l0, or its body leaves
    have z: n = 0 -> (!c(l0) && r = ok(l0, empty)) || (c(l0) && b(l0, r) && !is_ok(r)) proof
      assume e0: n = 0
      have ee: n = empty := rewrite(lit_zero, e0)
      have fn: app(f, n) = l0 := subst({y. app(f, y) = l0}, sym(ee), hf0)
      show := rewrite(fn, hend)
    qed
    // an iteration to l1 = f(1), then the run from there: f shifted
    have s: !(n = 0) -> c(l0) && (ex l1. b(l0, ok(l1, empty)) && (ex r1. while_rel(l1, l. c(l), l o. b(l, o), l. tr(l), r1) &&
        fst(r1) = fst(r) && (!(fst(r) = 2) -> r1 = r))) proof
      assume nz: !(n = 0)
      have m0: 0 in n by arith(hn, nz)
      have st0 := mp(all_elim(hst, {empty}), rewrite(lit_zero, m0))
      have st0l: c(l0) && b(l0, ok(app(f, succ(empty)), empty)) := rewrite(hf0, st0)
      let M := int_sub(n, 1)
      let F := fn_build(succ(M), i. app(f, int_add(i, 1)))
      have hM: M in omega by arith(hn, nz)
      have hM1: int_add(M, 1) in omega by arith(hM)
      have eM: succ(M) = int_add(M, 1) by arith(hM)
      have ff := fn_build_fun[d := succ(M), v := i. app(f, int_add(i, 1))]
      have fd := fn_build_dom[d := succ(M), v := i. app(f, int_add(i, 1))]
      have fs: all j. j in omega -> int_le(j, M) -> app(F, j) = app(f, int_add(j, 1)) proof
        fix j
        assume j1: j in omega
        assume j2: int_le(j, M)
        have m: j in int_add(M, 1) by arith(hM1, j1, j2, hM)
        show := mp(app_fn_build[d := succ(M), v := i. app(f, int_add(i, 1)), a := j], rewrite(sym(eM), m))
      qed
      // F(0) = f(1)
      have z0: int_le(0, M) by arith(hM)
      have fz := mp(mp(all_elim(fs, {0}), zo), z0)
      have fz2 := subst({y. app(F, y) = app(f, int_add(0, 1))}, lit_zero, fz)
      have f0: app(F, empty) = app(f, succ(empty)) := subst({y. app(F, empty) = app(f, y)}, sym(s0), fz2)
      // F's iterations: f's from the second
      have fst1: all i. i in M -> c(app(F, i)) && b(app(F, i), ok(app(F, succ(i)), empty)) proof
        fix i
        assume hi: i in M
        have io := mp(mp(nat_elem[k := M, i := i], hM), hi)
        have i1o: int_add(i, 1) in omega by arith(io)
        have il: int_le(i, M) by arith(io, hM, hi)
        have i1l: int_le(int_add(i, 1), M) by arith(io, hM, hi)
        have i1n: int_add(i, 1) in n by arith(i1o, hn, io, hi, hM, nz)
        have st := mp(all_elim(hst, {int_add(i, 1)}), i1n)
        have e2: succ(int_add(i, 1)) = int_add(int_add(i, 1), 1) by arith(i1o)
        have st2 := rewrite(e2, st)
        have fi := mp(mp(all_elim(fs, {i}), io), il)
        have fi1 := mp(mp(all_elim(fs, {int_add(i, 1)}), i1o), i1l)
        have es: succ(i) = int_add(i, 1) by arith(io)
        have fsi: app(F, succ(i)) = app(f, int_add(int_add(i, 1), 1)) := subst({y. app(F, y) = app(f, int_add(int_add(i, 1), 1))}, sym(es), fi1)
        have st3 := rewrite(sym(fi), st2)
        show := rewrite(sym(fsi), st3)
      qed
      // its end: F(M) = f(n)
      have mm: int_le(M, M) by arith(hM)
      have fM := mp(mp(all_elim(fs, {M}), hM), mm)
      have eMn: int_add(M, 1) = n by arith(hn, nz)
      have fMn: app(F, M) = app(f, n) := rewrite(eMn, fM)
      have hend2: (!c(app(F, M)) && r = ok(app(F, M), empty)) || (c(app(F, M)) && b(app(F, M), r) && !is_ok(r)) := rewrite(sym(fMn), hend)
      have e1: ex g. M in omega && is_fun(g) && dom(g) = succ(M) && app(g, empty) = app(f, succ(empty)) &&
          (all i. i in M -> c(app(g, i)) && b(app(g, i), ok(app(g, succ(i)), empty))) &&
          ((!c(app(g, M)) && r = ok(app(g, M), empty)) || (c(app(g, M)) && b(app(g, M), r) && !is_ok(r)))
        by ex_intro({F}, taut(hM, ff, fd, f0, fst1, hend2))
      have e2: ex m g. m in omega && is_fun(g) && dom(g) = succ(m) && app(g, empty) = app(f, succ(empty)) &&
          (all i. i in m -> c(app(g, i)) && b(app(g, i), ok(app(g, succ(i)), empty))) &&
          ((!c(app(g, m)) && r = ok(app(g, m), empty)) || (c(app(g, m)) && b(app(g, m), r) && !is_ok(r)))
        by ex_intro({M}, e1)
      have w1: while_rel(app(f, succ(empty)), l. c(l), l o. b(l, o), l. tr(l), r) by defs(taut(e2), while_rel)
      have er: ex r1. while_rel(app(f, succ(empty)), l. c(l), l o. b(l, o), l. tr(l), r1) && fst(r1) = fst(r) && (!(fst(r) = 2) -> r1 = r)
        by ex_intro({r}, taut(w1, refl({fst(r)}), refl({r})))
      have el: ex l1. b(l0, ok(l1, empty)) && (ex r1. while_rel(l1, l. c(l), l o. b(l, o), l. tr(l), r1) && fst(r1) = fst(r) && (!(fst(r) = 2) -> r1 = r))
        by ex_intro({app(f, succ(empty))}, taut(st0l, er))
      show by taut(st0l, el)
    qed
    show by taut(z, s)
  qed
  // infinitely many: an iteration to f(1), then the run from there, f
  // shifted, also infinite (its trace another limit)
  have icase: (ex f. is_fun(f) && dom(f) = omega && app(f, empty) = l0 &&
      (all i. i in omega -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) &&
      r = diverge(trace_limit(i. tr(app(f, i))))) ->
      c(l0) && (ex l1. b(l0, ok(l1, empty)) && (ex r1. while_rel(l1, l. c(l), l o. b(l, o), l. tr(l), r1) &&
        fst(r1) = fst(r) && (!(fst(r) = 2) -> r1 = r))) proof
    assume e: ex f. is_fun(f) && dom(f) = omega && app(f, empty) = l0 &&
      (all i. i in omega -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) &&
      r = diverge(trace_limit(i. tr(app(f, i))))
    obtain f, hf from e
    have hf0: app(f, empty) = l0 by taut(hf)
    have hst: all i. i in omega -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty)) by taut(hf)
    have rd: r = diverge(trace_limit(i. tr(app(f, i)))) by taut(hf)
    have st0 := mp(all_elim(hst, {empty}), omega_zero)
    have st0l: c(l0) && b(l0, ok(app(f, succ(empty)), empty)) := rewrite(hf0, st0)
    let F := fn_build(omega, i. app(f, int_add(i, 1)))
    have ff := fn_build_fun[d := omega, v := i. app(f, int_add(i, 1))]
    have fd := fn_build_dom[d := omega, v := i. app(f, int_add(i, 1))]
    have fz := mp(app_fn_build[d := omega, v := i. app(f, int_add(i, 1)), a := 0], zo)
    have fz2 := subst({y. app(F, y) = app(f, int_add(0, 1))}, lit_zero, fz)
    have f0: app(F, empty) = app(f, succ(empty)) := subst({y. app(F, empty) = app(f, y)}, sym(s0), fz2)
    have fst1: all i. i in omega -> c(app(F, i)) && b(app(F, i), ok(app(F, succ(i)), empty)) proof
      fix i
      assume io: i in omega
      have i1o: int_add(i, 1) in omega by arith(io)
      have st := mp(all_elim(hst, {int_add(i, 1)}), i1o)
      have e2: succ(int_add(i, 1)) = int_add(int_add(i, 1), 1) by arith(i1o)
      have st2 := rewrite(e2, st)
      have fi := mp(app_fn_build[d := omega, v := i. app(f, int_add(i, 1)), a := i], io)
      have fi1 := mp(app_fn_build[d := omega, v := i. app(f, int_add(i, 1)), a := int_add(i, 1)], i1o)
      have es: succ(i) = int_add(i, 1) by arith(io)
      have fsi: app(F, succ(i)) = app(f, int_add(int_add(i, 1), 1)) := subst({y. app(F, y) = app(f, int_add(int_add(i, 1), 1))}, sym(es), fi1)
      have st3 := rewrite(sym(fi), st2)
      show := rewrite(sym(fsi), st3)
    qed
    have e1: ex g. is_fun(g) && dom(g) = omega && app(g, empty) = app(f, succ(empty)) &&
        (all i. i in omega -> c(app(g, i)) && b(app(g, i), ok(app(g, succ(i)), empty))) &&
        diverge(trace_limit(i. tr(app(F, i)))) = diverge(trace_limit(i. tr(app(g, i))))
      by ex_intro({F}, taut(ff, fd, f0, fst1, refl({diverge(trace_limit(i. tr(app(F, i))))})))
    have w1: while_rel(app(f, succ(empty)), l. c(l), l o. b(l, o), l. tr(l), diverge(trace_limit(i. tr(app(F, i))))) by defs(taut(e1), while_rel)
    have f2: fst(r) = 2 by simp(rd)
    have f1: fst(diverge(trace_limit(i. tr(app(F, i))))) = fst(r) by simp(f2)
    have er: ex r1. while_rel(app(f, succ(empty)), l. c(l), l o. b(l, o), l. tr(l), r1) && fst(r1) = fst(r) && (!(fst(r) = 2) -> r1 = r)
      by ex_intro({diverge(trace_limit(i. tr(app(F, i))))}, taut(w1, f1, f2))
    have el: ex l1. b(l0, ok(l1, empty)) && (ex r1. while_rel(l1, l. c(l), l o. b(l, o), l. tr(l), r1) && fst(r1) = fst(r) && (!(fst(r) = 2) -> r1 = r))
      by ex_intro({app(f, succ(empty))}, taut(st0l, er))
    show by taut(st0l, el)
  qed
  show by taut(expand(hw, while_rel), fcase, icase)
qed

// ----------------------------------------------------------------------
//  Runs of a loop, built an iteration at a time (for a loop on the spec side
//  of a refinement, whose run is to be shown): a run of 0 iterations;
//  prepending an iteration to a run (finite: the outcome is not a
//  divergence).

// (the run of no iteration: l0 alone, where the loop stops or its body
// leaves)
theorem while_one(l0, l. c, l o. b, l. tr, r):
  ((!c(l0) && r = ok(l0, empty)) || (c(l0) && b(l0, r) && !is_ok(r))) -> while_rel(l0, l. c(l), l o. b(l, o), l. tr(l), r)
proof
  assume h: (!c(l0) && r = ok(l0, empty)) || (c(l0) && b(l0, r) && !is_ok(r))
  let F := fn_build(succ(empty), i. l0)
  have ff := fn_build_fun[d := succ(empty), v := i. l0]
  have fd := fn_build_dom[d := succ(empty), v := i. l0]
  have z1: empty in succ(empty) by simp(omega_zero)
  have f0 := mp(app_fn_build[d := succ(empty), v := i. l0, a := empty], z1)
  have vac: all i. i in empty -> c(app(F, i)) && b(app(F, i), ok(app(F, succ(i)), empty)) proof
    fix i
    assume hi: i in empty
    show by taut(hi, empty_mem[x := i])
  qed
  have hl: (!c(app(F, empty)) && r = ok(app(F, empty), empty)) || (c(app(F, empty)) && b(app(F, empty), r) && !is_ok(r)) := rewrite(sym(f0), h)
  have e1: ex f. empty in omega && is_fun(f) && dom(f) = succ(empty) && app(f, empty) = l0 &&
     (all i. i in empty -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) &&
     ((!c(app(f, empty)) && r = ok(app(f, empty), empty)) || (c(app(f, empty)) && b(app(f, empty), r) && !is_ok(r)))
    by ex_intro({F}, taut(omega_zero, ff, fd, f0, vac, hl))
  have e2: ex n f. n in omega && is_fun(f) && dom(f) = succ(n) && app(f, empty) = l0 &&
     (all i. i in n -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) &&
     ((!c(app(f, n)) && r = ok(app(f, n), empty)) || (c(app(f, n)) && b(app(f, n), r) && !is_ok(r)))
    by ex_intro({empty}, e1)
  show by defs(taut(e2), while_rel)
qed

theorem while_stop(l0, l. c, l o. b, l. tr):
  !c(l0) -> while_rel(l0, l. c(l), l o. b(l, o), l. tr(l), ok(l0, empty))
proof
  assume hc: !c(l0)
  show := mp(while_one[l0 := l0, c := l. c(l), b := l o. b(l, o), tr := l. tr(l), r := ok(l0, empty)], taut(hc, refl({ok(l0, empty)})))
qed

theorem while_leave(l0, l. c, l o. b, l. tr, r):
  c(l0) -> b(l0, r) -> !is_ok(r) -> while_rel(l0, l. c(l), l o. b(l, o), l. tr(l), r)
proof
  assume hc: c(l0)
  assume hb: b(l0, r)
  assume hn: !is_ok(r)
  show := mp(while_one[l0 := l0, c := l. c(l), b := l o. b(l, o), tr := l. tr(l), r := r], taut(hc, hb, hn))
qed

// (the run from l1 is finite -- its outcome not a divergence -- so l0
// prepended: l0, then its states)
theorem while_step(l0, l1, l. c, l o. b, l. tr, r):
  c(l0) -> b(l0, ok(l1, empty)) -> while_rel(l1, l. c(l), l o. b(l, o), l. tr(l), r) -> !(fst(r) = 2) ->
  while_rel(l0, l. c(l), l o. b(l, o), l. tr(l), r)
proof
  assume hc: c(l0)
  assume hb: b(l0, ok(l1, empty))
  assume hw: while_rel(l1, l. c(l), l o. b(l, o), l. tr(l), r)
  assume hnd: !(fst(r) = 2)
  // not infinitely many iterations from l1: r would be a divergence
  have ninf: (ex f. is_fun(f) && dom(f) = omega && app(f, empty) = l1 &&
      (all i. i in omega -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) &&
      r = diverge(trace_limit(i. tr(app(f, i))))) -> false proof
    assume e: ex f. is_fun(f) && dom(f) = omega && app(f, empty) = l1 &&
      (all i. i in omega -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) &&
      r = diverge(trace_limit(i. tr(app(f, i))))
    obtain f, hf from e
    have rd: r = diverge(trace_limit(i. tr(app(f, i)))) by taut(hf)
    have f2: fst(r) = 2 by simp(rd)
    show by taut(f2, hnd)
  qed
  have fin: ex n f. n in omega && is_fun(f) && dom(f) = succ(n) && app(f, empty) = l1 &&
      (all i. i in n -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) &&
      ((!c(app(f, n)) && r = ok(app(f, n), empty)) || (c(app(f, n)) && b(app(f, n), r) && !is_ok(r))) by taut(expand(hw, while_rel), ninf)
  obtain n, h1 from fin
  obtain f, hf from h1
  have hn: n in omega by taut(hf)
  have hf0: app(f, empty) = l1 by taut(hf)
  have hst: all i. i in n -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty)) by taut(hf)
  have hend: (!c(app(f, n)) && r = ok(app(f, n), empty)) || (c(app(f, n)) && b(app(f, n), r) && !is_ok(r)) by taut(hf)
  // the run from l0: l0, then f's states (n + 1 iterations)
  let N := int_add(n, 1)
  let G := fn_build(succ(N), i. ite(i = empty, l0, app(f, int_sub(i, 1))))
  have hN: N in omega by arith(hn)
  have hN1: int_add(N, 1) in omega by arith(hn)
  have eN: succ(N) = int_add(N, 1) by arith(hN)
  have gf := fn_build_fun[d := succ(N), v := i. ite(i = empty, l0, app(f, int_sub(i, 1)))]
  have gd := fn_build_dom[d := succ(N), v := i. ite(i = empty, l0, app(f, int_sub(i, 1)))]
  // G(0) = l0
  have m0: 0 in int_add(N, 1) by arith(hn, hN1)
  have m0e := rewrite(lit_zero, rewrite(sym(eN), m0))
  have a0 := mp(app_fn_build[d := succ(N), v := i. ite(i = empty, l0, app(f, int_sub(i, 1))), a := empty], m0e)
  have g0: app(G, empty) = l0 := trans(a0, mp(ite_t[c := empty = empty, a := l0, b := app(f, int_sub(empty, 1))], refl({empty})))
  // G(j + 1) = f(j), j <= n
  have gs: all j. j in omega -> int_le(j, n) -> app(G, int_add(j, 1)) = app(f, j) proof
    fix j
    assume j1: j in omega
    assume j2: int_le(j, n)
    have jo: int_add(j, 1) in omega by arith(j1)
    have m: int_add(j, 1) in int_add(N, 1) by arith(hN1, jo, j1, j2, hn)
    have a := mp(app_fn_build[d := succ(N), v := i. ite(i = empty, l0, app(f, int_sub(i, 1))), a := int_add(j, 1)], rewrite(sym(eN), m))
    have z: !(int_add(j, 1) = 0) by arith(j1)
    have ne := rewrite(lit_zero, z)
    have it := mp(ite_f[c := int_add(j, 1) = empty, a := l0, b := app(f, int_sub(int_add(j, 1), 1))], ne)
    have sub: int_sub(int_add(j, 1), 1) = j by arith(j1)
    show := rewrite(sub, trans(a, it))
  qed
  // G's iterations: i < N
  have gst: all i. i in N -> c(app(G, i)) && b(app(G, i), ok(app(G, succ(i)), empty)) proof
    fix i
    assume hi: i in N
    have io := mp(mp(nat_elem[k := N, i := i], hN), hi)
    have es: succ(i) = int_add(i, 1) by arith(io)
    have ile: int_le(i, n) by arith(io, hN, hi, hn)
    have gsi := mp(mp(all_elim(gs, {i}), io), ile)
    have gsucc: app(G, succ(i)) = app(f, i) := rewrite(sym(es), gsi)
    // the first: l0 to l1
    have k0: i = 0 -> c(app(G, i)) && b(app(G, i), ok(app(G, succ(i)), empty)) proof
      assume e0: i = 0
      have ee: i = empty := rewrite(lit_zero, e0)
      have gi: app(G, i) = l0 := subst({y. app(G, y) = l0}, sym(ee), g0)
      have fi: app(f, i) = l1 := subst({y. app(f, y) = l1}, sym(ee), hf0)
      have g1 := trans(gsucc, fi)
      have c0: c(app(G, i)) := subst({y. c(y)}, sym(gi), hc)
      have b1 := subst({z. b(l0, ok(z, empty))}, sym(g1), hb)
      have b0: b(app(G, i), ok(app(G, succ(i)), empty)) := subst({y. b(y, ok(app(G, succ(i)), empty))}, sym(gi), b1)
      show by taut(c0, b0)
    qed
    // a later one: f's
    have k1: !(i = 0) -> c(app(G, i)) && b(app(G, i), ok(app(G, succ(i)), empty)) proof
      assume nz: !(i = 0)
      have jo: int_sub(i, 1) in omega by arith(io, nz)
      have ej: int_add(int_sub(i, 1), 1) = i by arith(io)
      have jn: int_sub(i, 1) in n by arith(jo, hn, io, hi, hN, nz)
      have jle: int_le(int_sub(i, 1), n) by arith(io, ile)
      have gj := mp(mp(all_elim(gs, {int_sub(i, 1)}), jo), jle)
      have gi: app(G, i) = app(f, int_sub(i, 1)) := rewrite(ej, gj)
      have es2: succ(int_sub(i, 1)) = int_add(int_sub(i, 1), 1) by arith(jo)
      have sj := trans(es2, ej)
      have st := mp(all_elim(hst, {int_sub(i, 1)}), jn)
      have st2 := rewrite(sj, st)
      have st3 := rewrite(sym(gi), st2)
      show := rewrite(sym(gsucc), st3)
    qed
    show by taut(k0, k1)
  qed
  // the end: G(N) = f(n)
  have nn: int_le(n, n) by arith(hn)
  have gN: app(G, N) = app(f, n) := mp(mp(all_elim(gs, {n}), hn), nn)
  have hend2: (!c(app(G, N)) && r = ok(app(G, N), empty)) || (c(app(G, N)) && b(app(G, N), r) && !is_ok(r)) := rewrite(sym(gN), hend)
  have e1: ex g. N in omega && is_fun(g) && dom(g) = succ(N) && app(g, empty) = l0 &&
      (all i. i in N -> c(app(g, i)) && b(app(g, i), ok(app(g, succ(i)), empty))) &&
      ((!c(app(g, N)) && r = ok(app(g, N), empty)) || (c(app(g, N)) && b(app(g, N), r) && !is_ok(r)))
    by ex_intro({G}, taut(hN, gf, gd, g0, gst, hend2))
  have e2: ex m g. m in omega && is_fun(g) && dom(g) = succ(m) && app(g, empty) = l0 &&
      (all i. i in m -> c(app(g, i)) && b(app(g, i), ok(app(g, succ(i)), empty))) &&
      ((!c(app(g, m)) && r = ok(app(g, m), empty)) || (c(app(g, m)) && b(app(g, m), r) && !is_ok(r)))
    by ex_intro({N}, e1)
  show by defs(taut(e2), while_rel)
qed

// ----------------------------------------------------------------------
//  The loop rules

theorem while_inv(l0, l. c, l o. b, l. tr, r, l. p):
  p(l0) -> (all l l2. p(l) -> c(l) -> b(l, ok(l2, empty)) -> p(l2)) ->
  while_rel(l0, l. c(l), l o. b(l, o), l. tr(l), r) ->
  (ex l. p(l) && ((!c(l) && r = ok(l, empty)) || (c(l) && b(l, r) && !is_ok(r)))) || (ex t. r = diverge(t))
proof
  assume h0: p(l0)
  assume hs: all l l2. p(l) -> c(l) -> b(l, ok(l2, empty)) -> p(l2)
  assume hw: while_rel(l0, l. c(l), l o. b(l, o), l. tr(l), r)
  have fin := mp(mp(while_fin[l0 := l0, c := l. c(l), b := l o. b(l, o), r := r, p := l. p(l)], h0), hs)
  have inf := while_inf[l0 := l0, c := l. c(l), b := l o. b(l, o), tr := l. tr(l), r := r]
  show by taut(fin, inf, expand(hw, while_rel))
qed

theorem while_var(l0, l. c, l o. b, l. tr, r, l. p, l. m):
  p(l0) -> (all l l2. p(l) -> c(l) -> b(l, ok(l2, empty)) -> p(l2)) ->
  (all l. p(l) -> m(l) in omega) ->
  (all l l2. p(l) -> c(l) -> b(l, ok(l2, empty)) -> int_lt(m(l2), m(l))) ->
  while_rel(l0, l. c(l), l o. b(l, o), l. tr(l), r) ->
  ex l. p(l) && ((!c(l) && r = ok(l, empty)) || (c(l) && b(l, r) && !is_ok(r)))
proof
  assume h0: p(l0)
  assume hs: all l l2. p(l) -> c(l) -> b(l, ok(l2, empty)) -> p(l2)
  assume hm: all l. p(l) -> m(l) in omega
  assume hd: all l l2. p(l) -> c(l) -> b(l, ok(l2, empty)) -> int_lt(m(l2), m(l))
  assume hw: while_rel(l0, l. c(l), l o. b(l, o), l. tr(l), r)
  have fin := mp(mp(while_fin[l0 := l0, c := l. c(l), b := l o. b(l, o), r := r, p := l. p(l)], h0), hs)
  have inf := mp(mp(mp(mp(while_no_inf[l0 := l0, c := l. c(l), b := l o. b(l, o), tr := l. tr(l), r := r, p := l. p(l), m := l. m(l)], h0), hs), hm), hd)
  show by taut(fin, inf, expand(hw, while_rel))
qed

// every run of a loop: it stops (the condition fails), its body leaves
// (an outcome that is not ok: an exception -- a break, a return, undefined
// behaviour), or it runs forever (`diverge(t)`, t its trace)
theorem while_cases(l0, l. c, l o. b, l. tr, r):
  while_rel(l0, l. c(l), l o. b(l, o), l. tr(l), r) ->
  (ex l. (!c(l) && r = ok(l, empty)) || (c(l) && b(l, r) && !is_ok(r))) || (ex t. r = diverge(t))
proof
  assume hw: while_rel(l0, l. c(l), l o. b(l, o), l. tr(l), r)
  have t0: true by taut()
  have ts: all l l2. true -> c(l) -> b(l, ok(l2, empty)) -> true proof
    fix l
    fix l2
    show by taut()
  qed
  have i := mp(mp(mp(while_inv[l0 := l0, c := l. c(l), b := l o. b(l, o), tr := l. tr(l), r := r, p := l. true], t0), ts), hw)
  show by simp(i)
qed

// ----------------------------------------------------------------------
//  A run that exists (for a loop on the spec side, whose run is to be
//  constructed): with an invariant p and a variant m, if from every state
//  with p where the loop goes on the body either continues to a state with
//  p and a smaller m, or leaves (an outcome that is neither ok nor a
//  divergence) with g, then the loop has a run, ending where it stops or
//  where its body leaves with g (g: the body's outcomes the prover chose).
//  By `while_stop`, `while_leave`, `while_step`.
theorem while_exists(l0, l. c, l o. b, l. tr, l. p, l. m, l o. g):
  p(l0) -> (all l. p(l) -> m(l) in omega) ->
  (all l. p(l) -> c(l) -> (ex l2. b(l, ok(l2, empty)) && p(l2) && int_lt(m(l2), m(l))) || (ex r. b(l, r) && g(l, r) && !is_ok(r) && !(fst(r) = 2))) ->
  ex r. while_rel(l0, l. c(l), l o. b(l, o), l. tr(l), r) && !(fst(r) = 2) &&
    ((ex l. p(l) && !c(l) && r = ok(l, empty)) || (ex l. p(l) && c(l) && b(l, r) && g(l, r) && !is_ok(r)))
proof
  assume h0: p(l0)
  assume hm: all l. p(l) -> m(l) in omega
  assume hb: all l. p(l) -> c(l) -> (ex l2. b(l, ok(l2, empty)) && p(l2) && int_lt(m(l2), m(l))) || (ex r. b(l, r) && g(l, r) && !is_ok(r) && !(fst(r) = 2))
  // one state: a run from it, given runs from the states of smaller m
  have hstep: all x. p(x) ->
      (all y. p(y) -> int_lt(m(y), m(x)) -> (ex r. while_rel(y, l. c(l), l o. b(l, o), l. tr(l), r) && !(fst(r) = 2) &&
        ((ex l. p(l) && !c(l) && r = ok(l, empty)) || (ex l. p(l) && c(l) && b(l, r) && g(l, r) && !is_ok(r))))) ->
      (ex r. while_rel(x, l. c(l), l o. b(l, o), l. tr(l), r) && !(fst(r) = 2) &&
        ((ex l. p(l) && !c(l) && r = ok(l, empty)) || (ex l. p(l) && c(l) && b(l, r) && g(l, r) && !is_ok(r)))) proof
    fix x
    assume hx: p(x)
    assume ih: all y. p(y) -> int_lt(m(y), m(x)) -> (ex r. while_rel(y, l. c(l), l o. b(l, o), l. tr(l), r) && !(fst(r) = 2) &&
        ((ex l. p(l) && !c(l) && r = ok(l, empty)) || (ex l. p(l) && c(l) && b(l, r) && g(l, r) && !is_ok(r))))
    // the loop stops at x
    have k0: !c(x) -> (ex r. while_rel(x, l. c(l), l o. b(l, o), l. tr(l), r) && !(fst(r) = 2) &&
        ((ex l. p(l) && !c(l) && r = ok(l, empty)) || (ex l. p(l) && c(l) && b(l, r) && g(l, r) && !is_ok(r)))) proof
      assume nc: !c(x)
      have st := mp(while_stop[l0 := x, c := l. c(l), b := l o. b(l, o), tr := l. tr(l)], nc)
      have ex1: ex l. p(l) && !c(l) && ok(x, empty) = ok(l, empty) by ex_intro({x}, taut(hx, nc, refl({ok(x, empty)})))
      have nd: !(fst(ok(x, empty)) = 2) by simp()
      show by ex_intro({ok(x, empty)}, taut(st, nd, ex1))
    qed
    // the body continues to some l2
    have k1: c(x) -> (ex l2. b(x, ok(l2, empty)) && p(l2) && int_lt(m(l2), m(x))) -> (ex r. while_rel(x, l. c(l), l o. b(l, o), l. tr(l), r) && !(fst(r) = 2) &&
        ((ex l. p(l) && !c(l) && r = ok(l, empty)) || (ex l. p(l) && c(l) && b(l, r) && g(l, r) && !is_ok(r)))) proof
      assume hc: c(x)
      assume e: ex l2. b(x, ok(l2, empty)) && p(l2) && int_lt(m(l2), m(x))
      obtain l2, h2 from e
      have p2: p(l2) by taut(h2)
      have lt: int_lt(m(l2), m(x)) by taut(h2)
      have b2: b(x, ok(l2, empty)) by taut(h2)
      have e2 := mp(mp(all_elim(ih, {l2}), p2), lt)
      obtain r, hr from e2
      have w2: while_rel(l2, l. c(l), l o. b(l, o), l. tr(l), r) by taut(hr)
      have nd: !(fst(r) = 2) by taut(hr)
      have ws := mp(mp(mp(mp(while_step[l0 := x, l1 := l2, c := l. c(l), b := l o. b(l, o), tr := l. tr(l), r := r], hc), b2), w2), nd)
      show by ex_intro({r}, taut(ws, hr))
    qed
    // the body leaves
    have k2: c(x) -> (ex r. b(x, r) && g(x, r) && !is_ok(r) && !(fst(r) = 2)) -> (ex r. while_rel(x, l. c(l), l o. b(l, o), l. tr(l), r) && !(fst(r) = 2) &&
        ((ex l. p(l) && !c(l) && r = ok(l, empty)) || (ex l. p(l) && c(l) && b(l, r) && g(l, r) && !is_ok(r)))) proof
      assume hc: c(x)
      assume e: ex r. b(x, r) && g(x, r) && !is_ok(r) && !(fst(r) = 2)
      obtain r, hr from e
      have br: b(x, r) by taut(hr)
      have no: !is_ok(r) by taut(hr)
      have wl := mp(mp(mp(while_leave[l0 := x, c := l. c(l), b := l o. b(l, o), tr := l. tr(l), r := r], hc), br), no)
      have gr: g(x, r) by taut(hr)
      have ex1: ex l. p(l) && c(l) && b(l, r) && g(l, r) && !is_ok(r) by ex_intro({x}, taut(hx, hc, br, gr, no))
      show by ex_intro({r}, taut(wl, hr, ex1))
    qed
    have bx := all_elim(hb, {x})
    show by taut(k0, k1, k2, bx, hx)
  qed
  // by induction on the bound of m
  have all_n: all n. n in omega -> (all x. p(x) -> int_le(m(x), n) -> (ex r. while_rel(x, l. c(l), l o. b(l, o), l. tr(l), r) && !(fst(r) = 2) &&
        ((ex l. p(l) && !c(l) && r = ok(l, empty)) || (ex l. p(l) && c(l) && b(l, r) && g(l, r) && !is_ok(r))))) proof
    have base: all x. p(x) -> int_le(m(x), 0) -> (ex r. while_rel(x, l. c(l), l o. b(l, o), l. tr(l), r) && !(fst(r) = 2) &&
        ((ex l. p(l) && !c(l) && r = ok(l, empty)) || (ex l. p(l) && c(l) && b(l, r) && g(l, r) && !is_ok(r)))) proof
      fix x
      assume hx: p(x)
      assume hz: int_le(m(x), 0)
      have v: all y. p(y) -> int_lt(m(y), m(x)) -> (ex r. while_rel(y, l. c(l), l o. b(l, o), l. tr(l), r) && !(fst(r) = 2) &&
          ((ex l. p(l) && !c(l) && r = ok(l, empty)) || (ex l. p(l) && c(l) && b(l, r) && g(l, r) && !is_ok(r)))) proof
        fix y
        assume hy: p(y)
        assume lt: int_lt(m(y), m(x))
        have my := mp(all_elim(hm, {y}), hy)
        have f: false by arith(my, hz, lt)
        show by taut(f)
      qed
      show := mp(mp(all_elim(hstep, {x}), hx), v)
    qed
    have step: all i. i in omega -> (all x. p(x) -> int_le(m(x), i) -> (ex r. while_rel(x, l. c(l), l o. b(l, o), l. tr(l), r) && !(fst(r) = 2) &&
          ((ex l. p(l) && !c(l) && r = ok(l, empty)) || (ex l. p(l) && c(l) && b(l, r) && g(l, r) && !is_ok(r))))) ->
        (all x. p(x) -> int_le(m(x), int_add(i, 1)) -> (ex r. while_rel(x, l. c(l), l o. b(l, o), l. tr(l), r) && !(fst(r) = 2) &&
          ((ex l. p(l) && !c(l) && r = ok(l, empty)) || (ex l. p(l) && c(l) && b(l, r) && g(l, r) && !is_ok(r))))) proof
      fix i
      assume hi: i in omega
      assume ih: all x. p(x) -> int_le(m(x), i) -> (ex r. while_rel(x, l. c(l), l o. b(l, o), l. tr(l), r) && !(fst(r) = 2) &&
          ((ex l. p(l) && !c(l) && r = ok(l, empty)) || (ex l. p(l) && c(l) && b(l, r) && g(l, r) && !is_ok(r))))
      fix x
      assume hx: p(x)
      assume hle: int_le(m(x), int_add(i, 1))
      have v: all y. p(y) -> int_lt(m(y), m(x)) -> (ex r. while_rel(y, l. c(l), l o. b(l, o), l. tr(l), r) && !(fst(r) = 2) &&
          ((ex l. p(l) && !c(l) && r = ok(l, empty)) || (ex l. p(l) && c(l) && b(l, r) && g(l, r) && !is_ok(r)))) proof
        fix y
        assume hy: p(y)
        assume lt: int_lt(m(y), m(x))
        have my := mp(all_elim(hm, {y}), hy)
        have le: int_le(m(y), i) by arith(my, hi, hle, lt)
        show := mp(mp(all_elim(ih, {y}), hy), le)
      qed
      show := mp(mp(all_elim(hstep, {x}), hx), v)
    qed
    show by induct(base, step)
  qed
  have m0 := mp(all_elim(hm, {l0}), h0)
  have q := mp(all_elim(all_n, {m(l0)}), m0)
  have le: int_le(m(l0), m(l0)) by arith(m0)
  show := mp(mp(all_elim(q, {l0}), h0), le)
qed

// ----------------------------------------------------------------------
//  A run cut short, and a loop with a guard on its iterations

// (a run cut after k iterations: the states f(0..k), the body leaving at
// f(k) with r)
theorem while_prefix(l0, l. c, l o. b, l. tr, r, f, k):
  k in omega -> app(f, empty) = l0 ->
  (all i. i in k -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) ->
  c(app(f, k)) -> b(app(f, k), r) -> !is_ok(r) ->
  while_rel(l0, l. c(l), l o. b(l, o), l. tr(l), r)
proof
  assume hk: k in omega
  assume hf0: app(f, empty) = l0
  assume hst: all i. i in k -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))
  assume hck: c(app(f, k))
  assume hbk: b(app(f, k), r)
  assume hnr: !is_ok(r)
  let G := fn_build(succ(k), i. app(f, i))
  have gf := fn_build_fun[d := succ(k), v := i. app(f, i)]
  have gd := fn_build_dom[d := succ(k), v := i. app(f, i)]
  have k1: int_add(k, 1) in omega by arith(hk)
  have ek: succ(k) = int_add(k, 1) by arith(hk)
  // G is f on 0..k
  have gi: all i. i in omega -> int_le(i, k) -> app(G, i) = app(f, i) proof
    fix i
    assume io: i in omega
    assume il: int_le(i, k)
    have m: i in int_add(k, 1) by arith(io, il, hk, k1)
    show := mp(app_fn_build[d := succ(k), v := i. app(f, i), a := i], rewrite(sym(ek), m))
  qed
  have zo: 0 in omega := rewrite(sym(lit_zero), omega_zero)
  have z0: int_le(0, k) by arith(hk)
  have g0a := mp(mp(all_elim(gi, {0}), zo), z0)
  have g0: app(G, empty) = l0 := trans(subst({y. app(G, y) = app(f, y)}, lit_zero, g0a), hf0)
  have kk: int_le(k, k) by arith(hk)
  have gk := mp(mp(all_elim(gi, {k}), hk), kk)
  have st: all i. i in k -> c(app(G, i)) && b(app(G, i), ok(app(G, succ(i)), empty)) proof
    fix i
    assume hi: i in k
    have io := mp(mp(nat_elem[k := k, i := i], hk), hi)
    have il: int_le(i, k) by arith(io, hk, hi)
    have es: succ(i) = int_add(i, 1) by arith(io)
    have i1o: int_add(i, 1) in omega by arith(io)
    have i1l: int_le(int_add(i, 1), k) by arith(io, hk, hi)
    have ga := mp(mp(all_elim(gi, {i}), io), il)
    have gb := mp(mp(all_elim(gi, {int_add(i, 1)}), i1o), i1l)
    have gs: app(G, succ(i)) = app(f, succ(i)) := subst({y. app(G, y) = app(f, y)}, sym(es), gb)
    have s0 := mp(all_elim(hst, {i}), hi)
    have s1 := rewrite(sym(ga), s0)
    show := rewrite(sym(gs), s1)
  qed
  have ck: c(app(G, k)) := rewrite(sym(gk), hck)
  have bk: b(app(G, k), r) := rewrite(sym(gk), hbk)
  have e1: ex g. k in omega && is_fun(g) && dom(g) = succ(k) && app(g, empty) = l0 &&
      (all i. i in k -> c(app(g, i)) && b(app(g, i), ok(app(g, succ(i)), empty))) &&
      ((!c(app(g, k)) && r = ok(app(g, k), empty)) || (c(app(g, k)) && b(app(g, k), r) && !is_ok(r)))
    by ex_intro({G}, taut(hk, gf, gd, g0, st, ck, bk, hnr))
  have e2: ex n g. n in omega && is_fun(g) && dom(g) = succ(n) && app(g, empty) = l0 &&
      (all i. i in n -> c(app(g, i)) && b(app(g, i), ok(app(g, succ(i)), empty))) &&
      ((!c(app(g, n)) && r = ok(app(g, n), empty)) || (c(app(g, n)) && b(app(g, n), r) && !is_ok(r)))
    by ex_intro({k}, e1)
  show by defs(taut(e2), while_rel)
qed

// A loop whose every iteration is guarded by p (where p fails, the body
// leaves with e(l), not ok): every run of the unguarded loop is one of the
// guarded, or the guarded one leaves at some state l with e(l) -- at the
// first iteration where p fails.
theorem while_guard(l0, l o. b, l. tr, l. p, l. e, r):
  (all l. !is_ok(e(l))) ->
  while_rel(l0, l. true, l o. b(l, o), l. tr(l), r) ->
  while_rel(l0, l. true, l o. (p(l) && b(l, o)) || (!p(l) && o = e(l)), l. tr(l), r) ||
  (ex l. while_rel(l0, l. true, l o. (p(l) && b(l, o)) || (!p(l) && o = e(l)), l. tr(l), e(l)))
proof
  assume he: all l. !is_ok(e(l))
  assume hw: while_rel(l0, l. true, l o. b(l, o), l. tr(l), r)
  // finitely many iterations
  have fcase: (ex n f. n in omega && is_fun(f) && dom(f) = succ(n) && app(f, empty) = l0 &&
      (all i. i in n -> true && b(app(f, i), ok(app(f, succ(i)), empty))) &&
      ((!true && r = ok(app(f, n), empty)) || (true && b(app(f, n), r) && !is_ok(r)))) ->
      while_rel(l0, l. true, l o. (p(l) && b(l, o)) || (!p(l) && o = e(l)), l. tr(l), r) ||
      (ex l. while_rel(l0, l. true, l o. (p(l) && b(l, o)) || (!p(l) && o = e(l)), l. tr(l), e(l))) proof
    assume h: ex n f. n in omega && is_fun(f) && dom(f) = succ(n) && app(f, empty) = l0 &&
      (all i. i in n -> true && b(app(f, i), ok(app(f, succ(i)), empty))) &&
      ((!true && r = ok(app(f, n), empty)) || (true && b(app(f, n), r) && !is_ok(r)))
    obtain n, h1 from h
    obtain f, hf from h1
    have hn: n in omega by taut(hf)
    have hf0: app(f, empty) = l0 by taut(hf)
    have hst: all i. i in n -> true && b(app(f, i), ok(app(f, succ(i)), empty)) by taut(hf)
    have hbn: b(app(f, n), r) by taut(hf)
    have hnr: !is_ok(r) by taut(hf)
    // p fails at some iteration: the guarded loop leaves at the first
    have viol: (ex k. k in omega && (int_le(k, n) && !p(app(f, k)))) ->
        (ex l. while_rel(l0, l. true, l o. (p(l) && b(l, o)) || (!p(l) && o = e(l)), l. tr(l), e(l))) proof
      assume v: ex k. k in omega && (int_le(k, n) && !p(app(f, k)))
      obtain k, hk from mp(nat_least[p := x. int_le(x, n) && !p(app(f, x))], v)
      have ko: k in omega by taut(hk)
      have kn: int_le(k, n) by taut(hk)
      have nk: !p(app(f, k)) by taut(hk)
      have least: all y. y in omega -> int_le(y, n) && !p(app(f, y)) -> int_le(k, y) by taut(hk)
      have st: all i. i in k -> true && ((p(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) || (!p(app(f, i)) && ok(app(f, succ(i)), empty) = e(app(f, i)))) proof
        fix i
        assume hi: i in k
        have io := mp(mp(nat_elem[k := k, i := i], ko), hi)
        have ilt: int_lt(i, k) by arith(io, ko, hi)
        have inn: i in n by arith(io, ko, hi, kn, hn)
        have pi: p(app(f, i)) proof
          have c: !p(app(f, i)) -> false proof
            assume np: !p(app(f, i))
            have ile: int_le(i, n) by arith(io, ilt, kn)
            have kl := mp(mp(all_elim(least, {i}), io), taut(ile, np))
            show by arith(kl, ilt)
          qed
          show by taut(c)
        qed
        have bi: b(app(f, i), ok(app(f, succ(i)), empty)) by taut(mp(all_elim(hst, {i}), inn))
        show by taut(pi, bi)
      qed
      have bk: (p(app(f, k)) && b(app(f, k), e(app(f, k)))) || (!p(app(f, k)) && e(app(f, k)) = e(app(f, k))) by taut(nk, refl({e(app(f, k))}))
      have w := mp(while_prefix[l0 := l0, c := l. true, b := l o. (p(l) && b(l, o)) || (!p(l) && o = e(l)), tr := l. tr(l), r := e(app(f, k)), f := f, k := k],
        ko, hf0, st, taut(), bk, all_elim(he, {app(f, k)}))
      show by ex_intro({app(f, k)}, w)
    qed
    // p holds throughout: the same run, guarded
    have keep: !(ex k. k in omega && (int_le(k, n) && !p(app(f, k)))) ->
        while_rel(l0, l. true, l o. (p(l) && b(l, o)) || (!p(l) && o = e(l)), l. tr(l), r) proof
      assume nv: !(ex k. k in omega && (int_le(k, n) && !p(app(f, k))))
      have pk: all k. k in omega -> int_le(k, n) -> p(app(f, k)) proof
        fix k
        assume ko: k in omega
        assume kn: int_le(k, n)
        have c: !p(app(f, k)) -> false proof
          assume np: !p(app(f, k))
          have ex1: ex k. k in omega && (int_le(k, n) && !p(app(f, k))) by ex_intro({k}, taut(ko, kn, np))
          show by taut(ex1, nv)
        qed
        show by taut(c)
      qed
      have st: all i. i in n -> true && ((p(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) || (!p(app(f, i)) && ok(app(f, succ(i)), empty) = e(app(f, i)))) proof
        fix i
        assume hi: i in n
        have io := mp(mp(nat_elem[k := n, i := i], hn), hi)
        have il: int_le(i, n) by arith(io, hn, hi)
        have pi := mp(mp(all_elim(pk, {i}), io), il)
        have bi: b(app(f, i), ok(app(f, succ(i)), empty)) by taut(mp(all_elim(hst, {i}), hi))
        show by taut(pi, bi)
      qed
      have nn: int_le(n, n) by arith(hn)
      have pn := mp(mp(all_elim(pk, {n}), hn), nn)
      have bn: (p(app(f, n)) && b(app(f, n), r)) || (!p(app(f, n)) && r = e(app(f, n))) by taut(pn, hbn)
      show := mp(while_prefix[l0 := l0, c := l. true, b := l o. (p(l) && b(l, o)) || (!p(l) && o = e(l)), tr := l. tr(l), r := r, f := f, k := n],
        hn, hf0, st, taut(), bn, hnr)
    qed
    show by taut(viol, keep)
  qed
  // infinitely many
  have icase: (ex f. is_fun(f) && dom(f) = omega && app(f, empty) = l0 &&
      (all i. i in omega -> true && b(app(f, i), ok(app(f, succ(i)), empty))) &&
      r = diverge(trace_limit(i. tr(app(f, i))))) ->
      while_rel(l0, l. true, l o. (p(l) && b(l, o)) || (!p(l) && o = e(l)), l. tr(l), r) ||
      (ex l. while_rel(l0, l. true, l o. (p(l) && b(l, o)) || (!p(l) && o = e(l)), l. tr(l), e(l))) proof
    assume h: ex f. is_fun(f) && dom(f) = omega && app(f, empty) = l0 &&
      (all i. i in omega -> true && b(app(f, i), ok(app(f, succ(i)), empty))) &&
      r = diverge(trace_limit(i. tr(app(f, i))))
    obtain f, hf from h
    have hf0: app(f, empty) = l0 by taut(hf)
    have hst: all i. i in omega -> true && b(app(f, i), ok(app(f, succ(i)), empty)) by taut(hf)
    have viol: (ex k. k in omega && !p(app(f, k))) ->
        (ex l. while_rel(l0, l. true, l o. (p(l) && b(l, o)) || (!p(l) && o = e(l)), l. tr(l), e(l))) proof
      assume v: ex k. k in omega && !p(app(f, k))
      obtain k, hk from mp(nat_least[p := x. !p(app(f, x))], v)
      have ko: k in omega by taut(hk)
      have nk: !p(app(f, k)) by taut(hk)
      have least: all y. y in omega -> !p(app(f, y)) -> int_le(k, y) by taut(hk)
      have st: all i. i in k -> true && ((p(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) || (!p(app(f, i)) && ok(app(f, succ(i)), empty) = e(app(f, i)))) proof
        fix i
        assume hi: i in k
        have io := mp(mp(nat_elem[k := k, i := i], ko), hi)
        have ilt: int_lt(i, k) by arith(io, ko, hi)
        have pi: p(app(f, i)) proof
          have c: !p(app(f, i)) -> false proof
            assume np: !p(app(f, i))
            have kl := mp(mp(all_elim(least, {i}), io), np)
            show by arith(kl, ilt)
          qed
          show by taut(c)
        qed
        have bi: b(app(f, i), ok(app(f, succ(i)), empty)) by taut(mp(all_elim(hst, {i}), io))
        show by taut(pi, bi)
      qed
      have bk: (p(app(f, k)) && b(app(f, k), e(app(f, k)))) || (!p(app(f, k)) && e(app(f, k)) = e(app(f, k))) by taut(nk, refl({e(app(f, k))}))
      have w := mp(while_prefix[l0 := l0, c := l. true, b := l o. (p(l) && b(l, o)) || (!p(l) && o = e(l)), tr := l. tr(l), r := e(app(f, k)), f := f, k := k],
        ko, hf0, st, taut(), bk, all_elim(he, {app(f, k)}))
      show by ex_intro({app(f, k)}, w)
    qed
    have keep: !(ex k. k in omega && !p(app(f, k))) ->
        while_rel(l0, l. true, l o. (p(l) && b(l, o)) || (!p(l) && o = e(l)), l. tr(l), r) proof
      assume nv: !(ex k. k in omega && !p(app(f, k)))
      have st: all i. i in omega -> true && ((p(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) || (!p(app(f, i)) && ok(app(f, succ(i)), empty) = e(app(f, i)))) proof
        fix i
        assume io: i in omega
        have c: !p(app(f, i)) -> false proof
          assume np: !p(app(f, i))
          have ex1: ex k. k in omega && !p(app(f, k)) by ex_intro({i}, taut(io, np))
          show by taut(ex1, nv)
        qed
        have bi: b(app(f, i), ok(app(f, succ(i)), empty)) by taut(mp(all_elim(hst, {i}), io))
        show by taut(c, bi)
      qed
      have e1: ex g. is_fun(g) && dom(g) = omega && app(g, empty) = l0 &&
          (all i. i in omega -> true && ((p(app(g, i)) && b(app(g, i), ok(app(g, succ(i)), empty))) || (!p(app(g, i)) && ok(app(g, succ(i)), empty) = e(app(g, i))))) &&
          r = diverge(trace_limit(i. tr(app(g, i))))
        by ex_intro({f}, taut(hf, st))
      show by defs(taut(e1), while_rel)
    qed
    show by taut(viol, keep)
  qed
  show by taut(expand(hw, while_rel), fcase, icase)
qed

// ----------------------------------------------------------------------
//  A run from one of its states: the rest of the run

// (finitely many iterations: from the state f(k), k <= n, the same outcome)
theorem while_suffix(l. c, l o. b, l. tr, r, f, n, k):
  n in omega -> (all i. i in n -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) ->
  ((!c(app(f, n)) && r = ok(app(f, n), empty)) || (c(app(f, n)) && b(app(f, n), r) && !is_ok(r))) ->
  k in omega -> int_le(k, n) ->
  while_rel(app(f, k), l. c(l), l o. b(l, o), l. tr(l), r)
proof
  assume hn: n in omega
  assume hst: all i. i in n -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))
  assume hend: (!c(app(f, n)) && r = ok(app(f, n), empty)) || (c(app(f, n)) && b(app(f, n), r) && !is_ok(r))
  assume hk: k in omega
  assume hkn: int_le(k, n)
  let m := int_sub(n, k)
  let G := fn_build(succ(m), i. app(f, int_add(i, k)))
  have mo: m in omega by arith(hn, hk, hkn)
  have gf := fn_build_fun[d := succ(m), v := i. app(f, int_add(i, k))]
  have gd := fn_build_dom[d := succ(m), v := i. app(f, int_add(i, k))]
  have em: succ(m) = int_add(m, 1) by arith(mo)
  have m1: int_add(m, 1) in omega by arith(mo)
  have gi: all i. i in omega -> int_le(i, m) -> app(G, i) = app(f, int_add(i, k)) proof
    fix i
    assume io: i in omega
    assume il: int_le(i, m)
    have mm: i in int_add(m, 1) by arith(io, il, mo, m1)
    show := mp(app_fn_build[d := succ(m), v := i. app(f, int_add(i, k)), a := i], rewrite(sym(em), mm))
  qed
  have zo: 0 in omega := rewrite(sym(lit_zero), omega_zero)
  have z0: int_le(0, m) by arith(mo)
  have g0a := mp(mp(all_elim(gi, {0}), zo), z0)
  have ek: int_add(0, k) = k by arith(hk)
  have g0b := rewrite(ek, g0a)
  have g0: app(G, empty) = app(f, k) := subst({y. app(G, y) = app(f, k)}, lit_zero, g0b)
  have st: all i. i in m -> c(app(G, i)) && b(app(G, i), ok(app(G, succ(i)), empty)) proof
    fix i
    assume hi: i in m
    have io := mp(mp(nat_elem[k := m, i := i], mo), hi)
    have il: int_le(i, m) by arith(io, mo, hi)
    have i1o: int_add(i, 1) in omega by arith(io)
    have i1l: int_le(int_add(i, 1), m) by arith(io, mo, hi)
    have ga := mp(mp(all_elim(gi, {i}), io), il)
    have gb := mp(mp(all_elim(gi, {int_add(i, 1)}), i1o), i1l)
    have es: succ(i) = int_add(i, 1) by arith(io)
    have jo: int_add(i, k) in omega by arith(io, hk)
    have ej1: succ(int_add(i, k)) = int_add(int_add(i, k), 1) by arith(jo)
    have ej2: int_add(int_add(i, k), 1) = int_add(int_add(i, 1), k) by arith(io, hk)
    have ej := trans(ej1, ej2)
    have gs0: app(G, succ(i)) = app(f, int_add(int_add(i, 1), k)) := subst({y. app(G, y) = app(f, int_add(int_add(i, 1), k))}, sym(es), gb)
    have gs: app(G, succ(i)) = app(f, succ(int_add(i, k))) := rewrite(sym(ej), gs0)
    have jn: int_add(i, k) in n by arith(io, hk, hi, mo, hn, jo)
    have s0 := mp(all_elim(hst, {int_add(i, k)}), jn)
    have s1 := rewrite(sym(ga), s0)
    show := rewrite(sym(gs), s1)
  qed
  have en: int_add(m, k) = n by arith(hn, hk)
  have mm: int_le(m, m) by arith(mo)
  have gma := mp(mp(all_elim(gi, {m}), mo), mm)
  have gm: app(G, m) = app(f, n) := rewrite(en, gma)
  have hend2 := rewrite(sym(gm), hend)
  have e1: ex g. m in omega && is_fun(g) && dom(g) = succ(m) && app(g, empty) = app(f, k) &&
      (all i. i in m -> c(app(g, i)) && b(app(g, i), ok(app(g, succ(i)), empty))) &&
      ((!c(app(g, m)) && r = ok(app(g, m), empty)) || (c(app(g, m)) && b(app(g, m), r) && !is_ok(r)))
    by ex_intro({G}, taut(mo, gf, gd, g0, st, hend2))
  have e2: ex n2 g. n2 in omega && is_fun(g) && dom(g) = succ(n2) && app(g, empty) = app(f, k) &&
      (all i. i in n2 -> c(app(g, i)) && b(app(g, i), ok(app(g, succ(i)), empty))) &&
      ((!c(app(g, n2)) && r = ok(app(g, n2), empty)) || (c(app(g, n2)) && b(app(g, n2), r) && !is_ok(r)))
    by ex_intro({m}, e1)
  show by defs(taut(e2), while_rel)
qed

// (infinitely many: from every state f(k), a divergence)
theorem while_suffix_inf(l. c, l o. b, l. tr, f, k):
  (all i. i in omega -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) -> k in omega ->
  ex t. while_rel(app(f, k), l. c(l), l o. b(l, o), l. tr(l), diverge(t))
proof
  assume hst: all i. i in omega -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))
  assume hk: k in omega
  let G := fn_build(omega, i. app(f, int_add(i, k)))
  have gf := fn_build_fun[d := omega, v := i. app(f, int_add(i, k))]
  have gd := fn_build_dom[d := omega, v := i. app(f, int_add(i, k))]
  have gi: all i. i in omega -> app(G, i) = app(f, int_add(i, k)) proof
    fix i
    assume io: i in omega
    show := mp(app_fn_build[d := omega, v := i. app(f, int_add(i, k)), a := i], io)
  qed
  have zo: 0 in omega := rewrite(sym(lit_zero), omega_zero)
  have g0a := mp(all_elim(gi, {0}), zo)
  have ek: int_add(0, k) = k by arith(hk)
  have g0b := rewrite(ek, g0a)
  have g0: app(G, empty) = app(f, k) := subst({y. app(G, y) = app(f, k)}, lit_zero, g0b)
  have st: all i. i in omega -> c(app(G, i)) && b(app(G, i), ok(app(G, succ(i)), empty)) proof
    fix i
    assume io: i in omega
    have i1o: int_add(i, 1) in omega by arith(io)
    have ga := mp(all_elim(gi, {i}), io)
    have gb := mp(all_elim(gi, {int_add(i, 1)}), i1o)
    have es: succ(i) = int_add(i, 1) by arith(io)
    have jo: int_add(i, k) in omega by arith(io, hk)
    have ej1: succ(int_add(i, k)) = int_add(int_add(i, k), 1) by arith(jo)
    have ej2: int_add(int_add(i, k), 1) = int_add(int_add(i, 1), k) by arith(io, hk)
    have ej := trans(ej1, ej2)
    have gs0: app(G, succ(i)) = app(f, int_add(int_add(i, 1), k)) := subst({y. app(G, y) = app(f, int_add(int_add(i, 1), k))}, sym(es), gb)
    have gs: app(G, succ(i)) = app(f, succ(int_add(i, k))) := rewrite(sym(ej), gs0)
    have s0 := mp(all_elim(hst, {int_add(i, k)}), jo)
    have s1 := rewrite(sym(ga), s0)
    show := rewrite(sym(gs), s1)
  qed
  have e1: ex g. is_fun(g) && dom(g) = omega && app(g, empty) = app(f, k) &&
      (all i. i in omega -> c(app(g, i)) && b(app(g, i), ok(app(g, succ(i)), empty))) &&
      diverge(trace_limit(i. tr(app(G, i)))) = diverge(trace_limit(i. tr(app(g, i))))
    by ex_intro({G}, taut(gf, gd, g0, st, refl({diverge(trace_limit(i. tr(app(G, i))))})))
  have w: while_rel(app(f, k), l. c(l), l o. b(l, o), l. tr(l), diverge(trace_limit(i. tr(app(G, i))))) by defs(taut(e1), while_rel)
  show by ex_intro({trace_limit(i. tr(app(G, i)))}, w)
qed

// (an invariant along a run's first n + 1 states)
theorem while_path_inv(l. c, l o. b, l. q, f, n, k):
  n in omega -> (all i. i in n -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) ->
  q(app(f, empty)) -> (all l l2. q(l) -> b(l, ok(l2, empty)) -> q(l2)) ->
  k in omega -> int_le(k, n) -> q(app(f, k))
proof
  assume hn: n in omega
  assume hst: all i. i in n -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))
  assume hq0: q(app(f, empty))
  assume hs: all l l2. q(l) -> b(l, ok(l2, empty)) -> q(l2)
  assume hk: k in omega
  assume hkn: int_le(k, n)
  have base: int_le(0, n) -> q(app(f, 0)) proof
    assume h0: int_le(0, n)
    show := subst({y. q(app(f, y))}, sym(lit_zero), hq0)
  qed
  have step: all x. x in omega -> (int_le(x, n) -> q(app(f, x))) -> (int_le(int_add(x, 1), n) -> q(app(f, int_add(x, 1)))) proof
    fix x
    assume xo: x in omega
    assume ih: int_le(x, n) -> q(app(f, x))
    assume hl: int_le(int_add(x, 1), n)
    have xl: int_le(x, n) by arith(xo, hl)
    have qx := mp(ih, xl)
    have xn: x in n by arith(xo, hl, hn)
    have bx: b(app(f, x), ok(app(f, succ(x)), empty)) by taut(mp(all_elim(hst, {x}), xn))
    have q1 := mp(mp(all_elim(hs, {app(f, x)}, {app(f, succ(x))}), qx), bx)
    have es: succ(x) = int_add(x, 1) by arith(xo)
    show := rewrite(es, q1)
  qed
  have all := mp(mp(nat_ind[p := x. int_le(x, n) -> q(app(f, x))], base), step)
  show := mp(mp(all_elim(all, {k}), hk), hkn)
qed

// (... along an infinite run)
theorem while_path_inv_inf(l. c, l o. b, l. q, f, k):
  (all i. i in omega -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) ->
  q(app(f, empty)) -> (all l l2. q(l) -> b(l, ok(l2, empty)) -> q(l2)) ->
  k in omega -> q(app(f, k))
proof
  assume hst: all i. i in omega -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))
  assume hq0: q(app(f, empty))
  assume hs: all l l2. q(l) -> b(l, ok(l2, empty)) -> q(l2)
  assume hk: k in omega
  have base: q(app(f, 0)) := subst({y. q(app(f, y))}, sym(lit_zero), hq0)
  have step: all x. x in omega -> q(app(f, x)) -> q(app(f, int_add(x, 1))) proof
    fix x
    assume xo: x in omega
    assume qx: q(app(f, x))
    have bx: b(app(f, x), ok(app(f, succ(x)), empty)) by taut(mp(all_elim(hst, {x}), xo))
    have q1 := mp(mp(all_elim(hs, {app(f, x)}, {app(f, succ(x))}), qx), bx)
    have es: succ(x) = int_add(x, 1) by arith(xo)
    show := rewrite(es, q1)
  qed
  have all := mp(mp(nat_ind[p := x. q(app(f, x))], base), step)
  show := mp(all_elim(all, {k}), hk)
qed

// A run split where the guard p first fails: every run of the unguarded
// loop is one of the guarded (p throughout), or the guarded one leaves at
// some state l with e(l) and the unguarded run goes on from l -- to the
// same outcome, or (a divergence) to some divergence. (An invariant q of
// the run holds at l.)
theorem while_split(l0, l o. b, l. tr, l. p, l. e, r, l. q):
  (all l. !is_ok(e(l))) -> q(l0) -> (all l l2. q(l) -> b(l, ok(l2, empty)) -> q(l2)) ->
  while_rel(l0, l. true, l o. b(l, o), l. tr(l), r) ->
  while_rel(l0, l. true, l o. (p(l) && b(l, o)) || (!p(l) && o = e(l)), l. tr(l), r) ||
  (ex l. q(l) && while_rel(l0, l. true, l o. (p(l) && b(l, o)) || (!p(l) && o = e(l)), l. tr(l), e(l)) &&
    (ex r1. while_rel(l, l. true, l o. b(l, o), l. tr(l), r1) && fst(r1) = fst(r) && (!(fst(r) = 2) -> r1 = r)))
proof
  assume he: all l. !is_ok(e(l))
  assume hq0: q(l0)
  assume hqs: all l l2. q(l) -> b(l, ok(l2, empty)) -> q(l2)
  assume hw: while_rel(l0, l. true, l o. b(l, o), l. tr(l), r)
  // finitely many iterations
  have fcase: (ex n f. n in omega && is_fun(f) && dom(f) = succ(n) && app(f, empty) = l0 &&
      (all i. i in n -> true && b(app(f, i), ok(app(f, succ(i)), empty))) &&
      ((!true && r = ok(app(f, n), empty)) || (true && b(app(f, n), r) && !is_ok(r)))) ->
      while_rel(l0, l. true, l o. (p(l) && b(l, o)) || (!p(l) && o = e(l)), l. tr(l), r) ||
      (ex l. q(l) && while_rel(l0, l. true, l o. (p(l) && b(l, o)) || (!p(l) && o = e(l)), l. tr(l), e(l)) &&
        (ex r1. while_rel(l, l. true, l o. b(l, o), l. tr(l), r1) && fst(r1) = fst(r) && (!(fst(r) = 2) -> r1 = r))) proof
    assume h: ex n f. n in omega && is_fun(f) && dom(f) = succ(n) && app(f, empty) = l0 &&
      (all i. i in n -> true && b(app(f, i), ok(app(f, succ(i)), empty))) &&
      ((!true && r = ok(app(f, n), empty)) || (true && b(app(f, n), r) && !is_ok(r)))
    obtain n, h1 from h
    obtain f, hf from h1
    have hn: n in omega by taut(hf)
    have hf0: app(f, empty) = l0 by taut(hf)
    have hst: all i. i in n -> true && b(app(f, i), ok(app(f, succ(i)), empty)) by taut(hf)
    have hend: (!true && r = ok(app(f, n), empty)) || (true && b(app(f, n), r) && !is_ok(r)) by taut(hf)
    have hbn: b(app(f, n), r) by taut(hf)
    have hnr: !is_ok(r) by taut(hf)
    // p fails at some iteration: the guarded loop leaves at the first, the
    // run goes on from there
    have viol: (ex k. k in omega && (int_le(k, n) && !p(app(f, k)))) ->
        (ex l. q(l) && while_rel(l0, l. true, l o. (p(l) && b(l, o)) || (!p(l) && o = e(l)), l. tr(l), e(l)) &&
          (ex r1. while_rel(l, l. true, l o. b(l, o), l. tr(l), r1) && fst(r1) = fst(r) && (!(fst(r) = 2) -> r1 = r))) proof
      assume v: ex k. k in omega && (int_le(k, n) && !p(app(f, k)))
      obtain k, hk from mp(nat_least[p := x. int_le(x, n) && !p(app(f, x))], v)
      have ko: k in omega by taut(hk)
      have kn: int_le(k, n) by taut(hk)
      have nk: !p(app(f, k)) by taut(hk)
      have least: all y. y in omega -> int_le(y, n) && !p(app(f, y)) -> int_le(k, y) by taut(hk)
      have st: all i. i in k -> true && ((p(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) || (!p(app(f, i)) && ok(app(f, succ(i)), empty) = e(app(f, i)))) proof
        fix i
        assume hi: i in k
        have io := mp(mp(nat_elem[k := k, i := i], ko), hi)
        have ilt: int_lt(i, k) by arith(io, ko, hi)
        have inn: i in n by arith(io, ko, hi, kn, hn)
        have pi: p(app(f, i)) proof
          have c: !p(app(f, i)) -> false proof
            assume np: !p(app(f, i))
            have ile: int_le(i, n) by arith(io, ilt, kn)
            have kl := mp(mp(all_elim(least, {i}), io), taut(ile, np))
            show by arith(kl, ilt)
          qed
          show by taut(c)
        qed
        have bi: b(app(f, i), ok(app(f, succ(i)), empty)) by taut(mp(all_elim(hst, {i}), inn))
        show by taut(pi, bi)
      qed
      have bk: (p(app(f, k)) && b(app(f, k), e(app(f, k)))) || (!p(app(f, k)) && e(app(f, k)) = e(app(f, k))) by taut(nk, refl({e(app(f, k))}))
      have w := mp(while_prefix[l0 := l0, c := l. true, b := l o. (p(l) && b(l, o)) || (!p(l) && o = e(l)), tr := l. tr(l), r := e(app(f, k)), f := f, k := k],
        ko, hf0, st, taut(), bk, all_elim(he, {app(f, k)}))
      have cont := mp(while_suffix[c := l. true, b := l o. b(l, o), tr := l. tr(l), r := r, f := f, n := n, k := k], hn, hst, hend, ko, kn)
      have c1: ex r1. while_rel(app(f, k), l. true, l o. b(l, o), l. tr(l), r1) && fst(r1) = fst(r) && (!(fst(r) = 2) -> r1 = r)
        by ex_intro({r}, taut(cont, refl({fst(r)}), refl({r})))
      have qk := mp(while_path_inv[c := l. true, b := l o. b(l, o), q := l. q(l), f := f, n := n, k := k], hn, hst, rewrite(sym(hf0), hq0), hqs, ko, kn)
      show by ex_intro({app(f, k)}, taut(qk, w, c1))
    qed
    // p holds throughout: the same run, guarded
    have keep: !(ex k. k in omega && (int_le(k, n) && !p(app(f, k)))) ->
        while_rel(l0, l. true, l o. (p(l) && b(l, o)) || (!p(l) && o = e(l)), l. tr(l), r) proof
      assume nv: !(ex k. k in omega && (int_le(k, n) && !p(app(f, k))))
      have pk: all k. k in omega -> int_le(k, n) -> p(app(f, k)) proof
        fix k
        assume ko: k in omega
        assume kn: int_le(k, n)
        have c: !p(app(f, k)) -> false proof
          assume np: !p(app(f, k))
          have ex1: ex k. k in omega && (int_le(k, n) && !p(app(f, k))) by ex_intro({k}, taut(ko, kn, np))
          show by taut(ex1, nv)
        qed
        show by taut(c)
      qed
      have st: all i. i in n -> true && ((p(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) || (!p(app(f, i)) && ok(app(f, succ(i)), empty) = e(app(f, i)))) proof
        fix i
        assume hi: i in n
        have io := mp(mp(nat_elem[k := n, i := i], hn), hi)
        have il: int_le(i, n) by arith(io, hn, hi)
        have pi := mp(mp(all_elim(pk, {i}), io), il)
        have bi: b(app(f, i), ok(app(f, succ(i)), empty)) by taut(mp(all_elim(hst, {i}), hi))
        show by taut(pi, bi)
      qed
      have nn: int_le(n, n) by arith(hn)
      have pn := mp(mp(all_elim(pk, {n}), hn), nn)
      have bn: (p(app(f, n)) && b(app(f, n), r)) || (!p(app(f, n)) && r = e(app(f, n))) by taut(pn, hbn)
      show := mp(while_prefix[l0 := l0, c := l. true, b := l o. (p(l) && b(l, o)) || (!p(l) && o = e(l)), tr := l. tr(l), r := r, f := f, k := n],
        hn, hf0, st, taut(), bn, hnr)
    qed
    show by taut(viol, keep)
  qed
  // infinitely many
  have icase: (ex f. is_fun(f) && dom(f) = omega && app(f, empty) = l0 &&
      (all i. i in omega -> true && b(app(f, i), ok(app(f, succ(i)), empty))) &&
      r = diverge(trace_limit(i. tr(app(f, i))))) ->
      while_rel(l0, l. true, l o. (p(l) && b(l, o)) || (!p(l) && o = e(l)), l. tr(l), r) ||
      (ex l. q(l) && while_rel(l0, l. true, l o. (p(l) && b(l, o)) || (!p(l) && o = e(l)), l. tr(l), e(l)) &&
        (ex r1. while_rel(l, l. true, l o. b(l, o), l. tr(l), r1) && fst(r1) = fst(r) && (!(fst(r) = 2) -> r1 = r))) proof
    assume h: ex f. is_fun(f) && dom(f) = omega && app(f, empty) = l0 &&
      (all i. i in omega -> true && b(app(f, i), ok(app(f, succ(i)), empty))) &&
      r = diverge(trace_limit(i. tr(app(f, i))))
    obtain f, hf from h
    have hf0: app(f, empty) = l0 by taut(hf)
    have hst: all i. i in omega -> true && b(app(f, i), ok(app(f, succ(i)), empty)) by taut(hf)
    have hr: r = diverge(trace_limit(i. tr(app(f, i)))) by taut(hf)
    have viol: (ex k. k in omega && !p(app(f, k))) ->
        (ex l. q(l) && while_rel(l0, l. true, l o. (p(l) && b(l, o)) || (!p(l) && o = e(l)), l. tr(l), e(l)) &&
          (ex r1. while_rel(l, l. true, l o. b(l, o), l. tr(l), r1) && fst(r1) = fst(r) && (!(fst(r) = 2) -> r1 = r))) proof
      assume v: ex k. k in omega && !p(app(f, k))
      obtain k, hk from mp(nat_least[p := x. !p(app(f, x))], v)
      have ko: k in omega by taut(hk)
      have nk: !p(app(f, k)) by taut(hk)
      have least: all y. y in omega -> !p(app(f, y)) -> int_le(k, y) by taut(hk)
      have st: all i. i in k -> true && ((p(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) || (!p(app(f, i)) && ok(app(f, succ(i)), empty) = e(app(f, i)))) proof
        fix i
        assume hi: i in k
        have io := mp(mp(nat_elem[k := k, i := i], ko), hi)
        have ilt: int_lt(i, k) by arith(io, ko, hi)
        have pi: p(app(f, i)) proof
          have c: !p(app(f, i)) -> false proof
            assume np: !p(app(f, i))
            have kl := mp(mp(all_elim(least, {i}), io), np)
            show by arith(kl, ilt)
          qed
          show by taut(c)
        qed
        have bi: b(app(f, i), ok(app(f, succ(i)), empty)) by taut(mp(all_elim(hst, {i}), io))
        show by taut(pi, bi)
      qed
      have bk: (p(app(f, k)) && b(app(f, k), e(app(f, k)))) || (!p(app(f, k)) && e(app(f, k)) = e(app(f, k))) by taut(nk, refl({e(app(f, k))}))
      have w := mp(while_prefix[l0 := l0, c := l. true, b := l o. (p(l) && b(l, o)) || (!p(l) && o = e(l)), tr := l. tr(l), r := e(app(f, k)), f := f, k := k],
        ko, hf0, st, taut(), bk, all_elim(he, {app(f, k)}))
      obtain t, cont from mp(while_suffix_inf[c := l. true, b := l o. b(l, o), tr := l. tr(l), f := f, k := k], hst, ko)
      have f2: fst(diverge(t)) = fst(r) by simp(hr)
      have nd: !(fst(r) = 2) -> diverge(t) = r proof
        assume n2: !(fst(r) = 2)
        have d2: fst(r) = 2 by simp(hr)
        show by taut(n2, d2)
      qed
      have c1: ex r1. while_rel(app(f, k), l. true, l o. b(l, o), l. tr(l), r1) && fst(r1) = fst(r) && (!(fst(r) = 2) -> r1 = r)
        by ex_intro({diverge(t)}, taut(cont, f2, nd))
      have qk := mp(while_path_inv_inf[c := l. true, b := l o. b(l, o), q := l. q(l), f := f, k := k], hst, rewrite(sym(hf0), hq0), hqs, ko)
      show by ex_intro({app(f, k)}, taut(qk, w, c1))
    qed
    have keep: !(ex k. k in omega && !p(app(f, k))) ->
        while_rel(l0, l. true, l o. (p(l) && b(l, o)) || (!p(l) && o = e(l)), l. tr(l), r) proof
      assume nv: !(ex k. k in omega && !p(app(f, k)))
      have st: all i. i in omega -> true && ((p(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) || (!p(app(f, i)) && ok(app(f, succ(i)), empty) = e(app(f, i)))) proof
        fix i
        assume io: i in omega
        have c: !p(app(f, i)) -> false proof
          assume np: !p(app(f, i))
          have ex1: ex k. k in omega && !p(app(f, k)) by ex_intro({i}, taut(io, np))
          show by taut(ex1, nv)
        qed
        have bi: b(app(f, i), ok(app(f, succ(i)), empty)) by taut(mp(all_elim(hst, {i}), io))
        show by taut(c, bi)
      qed
      have e1: ex g. is_fun(g) && dom(g) = omega && app(g, empty) = l0 &&
          (all i. i in omega -> true && ((p(app(g, i)) && b(app(g, i), ok(app(g, succ(i)), empty))) || (!p(app(g, i)) && ok(app(g, succ(i)), empty) = e(app(g, i))))) &&
          r = diverge(trace_limit(i. tr(app(g, i))))
        by ex_intro({f}, taut(hf, st))
      show by defs(taut(e1), while_rel)
    qed
    show by taut(viol, keep)
  qed
  show by taut(expand(hw, while_rel), fcase, icase)
qed

// a run with a body b1 is one with any body b2 it implies
theorem while_mono(l0, l. c, l o. b1, l o. b2, l. tr, r):
  (all l o. b1(l, o) -> b2(l, o)) ->
  while_rel(l0, l. c(l), l o. b1(l, o), l. tr(l), r) -> while_rel(l0, l. c(l), l o. b2(l, o), l. tr(l), r)
proof
  assume hb: all l o. b1(l, o) -> b2(l, o)
  assume hw: while_rel(l0, l. c(l), l o. b1(l, o), l. tr(l), r)
  have fcase: (ex n f. n in omega && is_fun(f) && dom(f) = succ(n) && app(f, empty) = l0 &&
      (all i. i in n -> c(app(f, i)) && b1(app(f, i), ok(app(f, succ(i)), empty))) &&
      ((!c(app(f, n)) && r = ok(app(f, n), empty)) || (c(app(f, n)) && b1(app(f, n), r) && !is_ok(r)))) ->
      while_rel(l0, l. c(l), l o. b2(l, o), l. tr(l), r) proof
    assume h: ex n f. n in omega && is_fun(f) && dom(f) = succ(n) && app(f, empty) = l0 &&
      (all i. i in n -> c(app(f, i)) && b1(app(f, i), ok(app(f, succ(i)), empty))) &&
      ((!c(app(f, n)) && r = ok(app(f, n), empty)) || (c(app(f, n)) && b1(app(f, n), r) && !is_ok(r)))
    obtain n, h1 from h
    obtain f, hf from h1
    have hst: all i. i in n -> c(app(f, i)) && b1(app(f, i), ok(app(f, succ(i)), empty)) by taut(hf)
    have st: all i. i in n -> c(app(f, i)) && b2(app(f, i), ok(app(f, succ(i)), empty)) proof
      fix i
      assume hi: i in n
      have s := mp(all_elim(hst, {i}), hi)
      have b := mp(all_elim(hb, {app(f, i)}, {ok(app(f, succ(i)), empty)}), taut(s))
      show by taut(s, b)
    qed
    have bn := all_elim(hb, {app(f, n)}, {r})
    have e1: ex n2 g. n2 in omega && is_fun(g) && dom(g) = succ(n2) && app(g, empty) = l0 &&
        (all i. i in n2 -> c(app(g, i)) && b2(app(g, i), ok(app(g, succ(i)), empty))) &&
        ((!c(app(g, n2)) && r = ok(app(g, n2), empty)) || (c(app(g, n2)) && b2(app(g, n2), r) && !is_ok(r)))
      by ex_intro({n}, {f}, taut(hf, st, bn))
    show by defs(taut(e1), while_rel)
  qed
  have icase: (ex f. is_fun(f) && dom(f) = omega && app(f, empty) = l0 &&
      (all i. i in omega -> c(app(f, i)) && b1(app(f, i), ok(app(f, succ(i)), empty))) &&
      r = diverge(trace_limit(i. tr(app(f, i))))) ->
      while_rel(l0, l. c(l), l o. b2(l, o), l. tr(l), r) proof
    assume h: ex f. is_fun(f) && dom(f) = omega && app(f, empty) = l0 &&
      (all i. i in omega -> c(app(f, i)) && b1(app(f, i), ok(app(f, succ(i)), empty))) &&
      r = diverge(trace_limit(i. tr(app(f, i))))
    obtain f, hf from h
    have hst: all i. i in omega -> c(app(f, i)) && b1(app(f, i), ok(app(f, succ(i)), empty)) by taut(hf)
    have st: all i. i in omega -> c(app(f, i)) && b2(app(f, i), ok(app(f, succ(i)), empty)) proof
      fix i
      assume hi: i in omega
      have s := mp(all_elim(hst, {i}), hi)
      have b := mp(all_elim(hb, {app(f, i)}, {ok(app(f, succ(i)), empty)}), taut(s))
      show by taut(s, b)
    qed
    have e1: ex g. is_fun(g) && dom(g) = omega && app(g, empty) = l0 &&
        (all i. i in omega -> c(app(g, i)) && b2(app(g, i), ok(app(g, succ(i)), empty))) &&
        r = diverge(trace_limit(i. tr(app(g, i))))
      by ex_intro({f}, taut(hf, st))
    show by defs(taut(e1), while_rel)
  qed
  show by taut(expand(hw, while_rel), fcase, icase)
qed
