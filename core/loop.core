// Loops: `while_rel` (prelude) with an invariant, and termination with a
// variant. These justify the loop step of `simp` (`inv{...}` hints).
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core core/loop.core

// ----------------------------------------------------------------------
//  The two ways a loop runs, each on its own

// finitely many iterations: the loop stops in a state with the invariant,
// by its condition or by an outcome of the body that is not `ok` (the
// spec's loops exit that way: `break` and `return` are exceptions of the body)
theorem while_fin(l0, l. c, l o. b, r, l. p):
  p(l0) -> (all l l2. p(l) -> c(l) -> b(l, ok(l2, empty)) -> p(l2)) ->
  (ex n f. n in omega && is_fun(f) && dom(f) = succ(n) && app(f, empty) = l0 &&
     (all i. i in n -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) &&
     ((!c(app(f, n)) && r = ok(app(f, n), empty)) ||
      (c(app(f, n)) && b(app(f, n), r) && !is_ok(r)))) ->
  ex l. p(l) && ((!c(l) && r = ok(l, empty)) || (c(l) && b(l, r) && !is_ok(r)))
proof
  assume h0: p(l0)
  assume hs: all l l2. p(l) -> c(l) -> b(l, ok(l2, empty)) -> p(l2)
  assume h: ex n f. n in omega && is_fun(f) && dom(f) = succ(n) && app(f, empty) = l0 &&
     (all i. i in n -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) &&
     ((!c(app(f, n)) && r = ok(app(f, n), empty)) ||
      (c(app(f, n)) && b(app(f, n), r) && !is_ok(r)))
  obtain n, h1 from h
  obtain f, hf from h1
  have hn: n in omega by taut(hf)
  have hst: all i. i in n -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty)) by taut(hf)
  have hf0: app(f, empty) = l0 by taut(hf)
  // every state up to n has the invariant
  have all_p: all i. i in omega -> int_le(i, n) -> p(app(f, i)) proof
    have base: int_le(0, n) -> p(app(f, 0)) proof
      assume z: int_le(0, n)
      show by taut(rewrite(sym(lit_zero), rewrite(sym(hf0), h0)))
    qed
    have step: all i. i in omega -> (int_le(i, n) -> p(app(f, i))) ->
        int_le(int_add(i, 1), n) -> p(app(f, int_add(i, 1))) proof
      fix i
      assume hi: i in omega
      assume ih: int_le(i, n) -> p(app(f, i))
      assume hle: int_le(int_add(i, 1), n)
      have le: int_le(i, n) by arith(hi, hn, hle)
      have lt: i in n by arith(hi, hn, hle)
      have cb := mp(all_elim(hst, {i}), lt)
      have ci: c(app(f, i)) by taut(cb)
      have bi: b(app(f, i), ok(app(f, succ(i)), empty)) by taut(cb)
      have ps := mp(mp(mp(all_elim(all_elim(hs, {app(f, i)}), {app(f, succ(i))}), mp(ih, le)), ci), bi)
      have eq: succ(i) = int_add(i, 1) by arith(hi)
      show by taut(rewrite(eq, ps))
    qed
    show by induct(base, step)
  qed
  have nn: int_le(n, n) by arith(hn)
  have pn := mp(mp(all_elim(all_p, {n}), hn), nn)
  show by ex_intro({app(f, n)}, taut(pn, hf))
qed

// infinitely many iterations: the loop diverges
theorem while_inf(l0, l. c, l o. b, l. tr, r):
  (ex f. is_fun(f) && dom(f) = omega && app(f, empty) = l0 &&
     (all i. i in omega -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) &&
     r = diverge(trace_limit(i. tr(app(f, i))))) ->
  ex t. r = diverge(t)
proof
  assume h: ex f. is_fun(f) && dom(f) = omega && app(f, empty) = l0 &&
     (all i. i in omega -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) &&
     r = diverge(trace_limit(i. tr(app(f, i))))
  obtain f, hf from h
  show by ex_intro({trace_limit(i. tr(app(f, i)))}, taut(hf))
qed

// ... which a variant rules out: a natural number that each iteration
// decreases
theorem while_no_inf(l0, l. c, l o. b, l. tr, r, l. p, l. m):
  p(l0) -> (all l l2. p(l) -> c(l) -> b(l, ok(l2, empty)) -> p(l2)) ->
  (all l. p(l) -> m(l) in omega) ->
  (all l l2. p(l) -> c(l) -> b(l, ok(l2, empty)) -> int_lt(m(l2), m(l))) ->
  (ex f. is_fun(f) && dom(f) = omega && app(f, empty) = l0 &&
     (all i. i in omega -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) &&
     r = diverge(trace_limit(i. tr(app(f, i))))) ->
  false
proof
  assume h0: p(l0)
  assume hs: all l l2. p(l) -> c(l) -> b(l, ok(l2, empty)) -> p(l2)
  assume hm: all l. p(l) -> m(l) in omega
  assume hd: all l l2. p(l) -> c(l) -> b(l, ok(l2, empty)) -> int_lt(m(l2), m(l))
  assume h: ex f. is_fun(f) && dom(f) = omega && app(f, empty) = l0 &&
     (all i. i in omega -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) &&
     r = diverge(trace_limit(i. tr(app(f, i))))
  obtain f, hf from h
  have hst: all i. i in omega -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty)) by taut(hf)
  have hf0: app(f, empty) = l0 by taut(hf)
  have p0: p(app(f, 0)) by taut(rewrite(sym(lit_zero), rewrite(sym(hf0), h0)))
  have m0 := mp(all_elim(hm, {app(f, 0)}), p0)
  // every state has the invariant, and the variant has dropped by i after i steps
  have all_p: all i. i in omega -> p(app(f, i)) && int_le(int_add(m(app(f, i)), i), m(app(f, 0))) proof
    have b0: int_le(int_add(m(app(f, 0)), 0), m(app(f, 0))) by arith(m0)
    have base: p(app(f, 0)) && int_le(int_add(m(app(f, 0)), 0), m(app(f, 0))) by taut(p0, b0)
    have step: all i. i in omega -> (p(app(f, i)) && int_le(int_add(m(app(f, i)), i), m(app(f, 0)))) ->
        p(app(f, int_add(i, 1))) && int_le(int_add(m(app(f, int_add(i, 1))), int_add(i, 1)), m(app(f, 0))) proof
      fix i
      assume hi: i in omega
      assume ih: p(app(f, i)) && int_le(int_add(m(app(f, i)), i), m(app(f, 0)))
      have pi: p(app(f, i)) by taut(ih)
      have le: int_le(int_add(m(app(f, i)), i), m(app(f, 0))) by taut(ih)
      have cb := mp(all_elim(hst, {i}), hi)
      have ci: c(app(f, i)) by taut(cb)
      have bi: b(app(f, i), ok(app(f, succ(i)), empty)) by taut(cb)
      have eq: succ(i) = int_add(i, 1) by arith(hi)
      have ps := rewrite(eq, mp(mp(mp(all_elim(all_elim(hs, {app(f, i)}), {app(f, succ(i))}), pi), ci), bi))
      have lt := rewrite(eq, mp(mp(mp(all_elim(all_elim(hd, {app(f, i)}), {app(f, succ(i))}), pi), ci), bi))
      have mi := mp(all_elim(hm, {app(f, i)}), pi)
      have ms := mp(all_elim(hm, {app(f, int_add(i, 1))}), ps)
      have ls: int_le(int_add(m(app(f, int_add(i, 1))), int_add(i, 1)), m(app(f, 0))) by arith(hi, le, lt, mi, ms, m0)
      show by taut(ps, ls)
    qed
    show by induct(base, step)
  qed
  // after m(f(0)) + 1 steps, the variant would be negative
  have ko: int_add(m(app(f, 0)), 1) in omega by arith(m0)
  have pk := mp(all_elim(all_p, {int_add(m(app(f, 0)), 1)}), ko)
  have pkp: p(app(f, int_add(m(app(f, 0)), 1))) by taut(pk)
  have mk := mp(all_elim(hm, {app(f, int_add(m(app(f, 0)), 1))}), pkp)
  have lek: int_le(int_add(m(app(f, int_add(m(app(f, 0)), 1))), int_add(m(app(f, 0)), 1)), m(app(f, 0))) by taut(pk)
  show by arith(m0, mk, lek)
qed

// ----------------------------------------------------------------------
//  One iteration (`simp(.., unroll)`): the loop stops at l0, its body
//  leaves, or the body continues to l1 and the loop runs on from there --
//  with an outcome r1 of the same kind: r itself, or, if the loop diverges,
//  a divergence too (the trace of an infinite run from l1 need not be the
//  one from l0). To prove: the runs from l0 are those from l1, shifted.
lemma while_unroll(l0, l. c, l o. b, l. tr, r):
  while_rel(l0, l. c(l), l o. b(l, o), l. tr(l), r) ->
  (!c(l0) && r = ok(l0, empty)) || (c(l0) && b(l0, r) && !is_ok(r)) ||
  (c(l0) && (ex l1. b(l0, ok(l1, empty)) && (ex r1. while_rel(l1, l. c(l), l o. b(l, o), l. tr(l), r1) &&
     fst(r1) = fst(r) && (!(fst(r) = 2) -> r1 = r))))

// ----------------------------------------------------------------------
//  Runs of a loop, built an iteration at a time (for a loop on the spec side
//  of a refinement, whose run is to be shown). To prove: a run of 0
//  iterations; prepending an iteration to a run (finite: the outcome is not
//  a divergence).

lemma while_stop(l0, l. c, l o. b, l. tr):
  !c(l0) -> while_rel(l0, l. c(l), l o. b(l, o), l. tr(l), ok(l0, empty))

lemma while_leave(l0, l. c, l o. b, l. tr, r):
  c(l0) -> b(l0, r) -> !is_ok(r) -> while_rel(l0, l. c(l), l o. b(l, o), l. tr(l), r)

lemma while_step(l0, l1, l. c, l o. b, l. tr, r):
  c(l0) -> b(l0, ok(l1, empty)) -> while_rel(l1, l. c(l), l o. b(l, o), l. tr(l), r) -> !(fst(r) = 2) ->
  while_rel(l0, l. c(l), l o. b(l, o), l. tr(l), r)

// ----------------------------------------------------------------------
//  The loop rules

theorem while_inv(l0, l. c, l o. b, l. tr, r, l. p):
  p(l0) -> (all l l2. p(l) -> c(l) -> b(l, ok(l2, empty)) -> p(l2)) ->
  while_rel(l0, l. c(l), l o. b(l, o), l. tr(l), r) ->
  (ex l. p(l) && ((!c(l) && r = ok(l, empty)) || (c(l) && b(l, r) && !is_ok(r)))) || (ex t. r = diverge(t))
proof
  assume h0: p(l0)
  assume hs: all l l2. p(l) -> c(l) -> b(l, ok(l2, empty)) -> p(l2)
  assume hw: while_rel(l0, l. c(l), l o. b(l, o), l. tr(l), r)
  have fin := mp(mp(while_fin[l0 := l0, c := l. c(l), b := l o. b(l, o), r := r, p := l. p(l)], h0), hs)
  have inf := while_inf[l0 := l0, c := l. c(l), b := l o. b(l, o), tr := l. tr(l), r := r]
  show by taut(fin, inf, expand(hw, while_rel))
qed

theorem while_var(l0, l. c, l o. b, l. tr, r, l. p, l. m):
  p(l0) -> (all l l2. p(l) -> c(l) -> b(l, ok(l2, empty)) -> p(l2)) ->
  (all l. p(l) -> m(l) in omega) ->
  (all l l2. p(l) -> c(l) -> b(l, ok(l2, empty)) -> int_lt(m(l2), m(l))) ->
  while_rel(l0, l. c(l), l o. b(l, o), l. tr(l), r) ->
  ex l. p(l) && ((!c(l) && r = ok(l, empty)) || (c(l) && b(l, r) && !is_ok(r)))
proof
  assume h0: p(l0)
  assume hs: all l l2. p(l) -> c(l) -> b(l, ok(l2, empty)) -> p(l2)
  assume hm: all l. p(l) -> m(l) in omega
  assume hd: all l l2. p(l) -> c(l) -> b(l, ok(l2, empty)) -> int_lt(m(l2), m(l))
  assume hw: while_rel(l0, l. c(l), l o. b(l, o), l. tr(l), r)
  have fin := mp(mp(while_fin[l0 := l0, c := l. c(l), b := l o. b(l, o), r := r, p := l. p(l)], h0), hs)
  have inf := mp(mp(mp(mp(while_no_inf[l0 := l0, c := l. c(l), b := l o. b(l, o), tr := l. tr(l), r := r, p := l. p(l), m := l. m(l)], h0), hs), hm), hd)
  show by taut(fin, inf, expand(hw, while_rel))
qed

// every run of a loop: it stops (the condition fails), its body leaves
// (an outcome that is not ok: an exception -- a break, a return, undefined
// behaviour), or it runs forever (`diverge(t)`, t its trace)
theorem while_cases(l0, l. c, l o. b, l. tr, r):
  while_rel(l0, l. c(l), l o. b(l, o), l. tr(l), r) ->
  (ex l. (!c(l) && r = ok(l, empty)) || (c(l) && b(l, r) && !is_ok(r))) || (ex t. r = diverge(t))
proof
  assume hw: while_rel(l0, l. c(l), l o. b(l, o), l. tr(l), r)
  have t0: true by taut()
  have ts: all l l2. true -> c(l) -> b(l, ok(l2, empty)) -> true proof
    fix l
    fix l2
    show by taut()
  qed
  have i := mp(mp(mp(while_inv[l0 := l0, c := l. c(l), b := l o. b(l, o), tr := l. tr(l), r := r, p := l. true], t0), ts), hw)
  show by simp(i)
qed

// ----------------------------------------------------------------------
//  A run that exists (for a loop on the spec side, whose run is to be
//  constructed): with an invariant p and a variant m, if from every state
//  with p where the loop goes on the body either continues to a state with
//  p and a smaller m, or leaves (an outcome that is neither ok nor a
//  divergence) with g, then the loop has a run, ending where it stops or
//  where its body leaves with g (g: the body's outcomes the prover chose).
//  Rests on `while_stop`, `while_leave`, `while_step`.
theorem while_exists(l0, l. c, l o. b, l. tr, l. p, l. m, l o. g):
  p(l0) -> (all l. p(l) -> m(l) in omega) ->
  (all l. p(l) -> c(l) -> (ex l2. b(l, ok(l2, empty)) && p(l2) && int_lt(m(l2), m(l))) || (ex r. b(l, r) && g(l, r) && !is_ok(r) && !(fst(r) = 2))) ->
  ex r. while_rel(l0, l. c(l), l o. b(l, o), l. tr(l), r) && !(fst(r) = 2) &&
    ((ex l. p(l) && !c(l) && r = ok(l, empty)) || (ex l. p(l) && c(l) && b(l, r) && g(l, r) && !is_ok(r)))
proof
  assume h0: p(l0)
  assume hm: all l. p(l) -> m(l) in omega
  assume hb: all l. p(l) -> c(l) -> (ex l2. b(l, ok(l2, empty)) && p(l2) && int_lt(m(l2), m(l))) || (ex r. b(l, r) && g(l, r) && !is_ok(r) && !(fst(r) = 2))
  // one state: a run from it, given runs from the states of smaller m
  have hstep: all x. p(x) ->
      (all y. p(y) -> int_lt(m(y), m(x)) -> (ex r. while_rel(y, l. c(l), l o. b(l, o), l. tr(l), r) && !(fst(r) = 2) &&
        ((ex l. p(l) && !c(l) && r = ok(l, empty)) || (ex l. p(l) && c(l) && b(l, r) && g(l, r) && !is_ok(r))))) ->
      (ex r. while_rel(x, l. c(l), l o. b(l, o), l. tr(l), r) && !(fst(r) = 2) &&
        ((ex l. p(l) && !c(l) && r = ok(l, empty)) || (ex l. p(l) && c(l) && b(l, r) && g(l, r) && !is_ok(r)))) proof
    fix x
    assume hx: p(x)
    assume ih: all y. p(y) -> int_lt(m(y), m(x)) -> (ex r. while_rel(y, l. c(l), l o. b(l, o), l. tr(l), r) && !(fst(r) = 2) &&
        ((ex l. p(l) && !c(l) && r = ok(l, empty)) || (ex l. p(l) && c(l) && b(l, r) && g(l, r) && !is_ok(r))))
    // the loop stops at x
    have k0: !c(x) -> (ex r. while_rel(x, l. c(l), l o. b(l, o), l. tr(l), r) && !(fst(r) = 2) &&
        ((ex l. p(l) && !c(l) && r = ok(l, empty)) || (ex l. p(l) && c(l) && b(l, r) && g(l, r) && !is_ok(r)))) proof
      assume nc: !c(x)
      have st := mp(while_stop[l0 := x, c := l. c(l), b := l o. b(l, o), tr := l. tr(l)], nc)
      have ex1: ex l. p(l) && !c(l) && ok(x, empty) = ok(l, empty) by ex_intro({x}, taut(hx, nc, refl({ok(x, empty)})))
      have nd: !(fst(ok(x, empty)) = 2) by simp()
      show by ex_intro({ok(x, empty)}, taut(st, nd, ex1))
    qed
    // the body continues to some l2
    have k1: c(x) -> (ex l2. b(x, ok(l2, empty)) && p(l2) && int_lt(m(l2), m(x))) -> (ex r. while_rel(x, l. c(l), l o. b(l, o), l. tr(l), r) && !(fst(r) = 2) &&
        ((ex l. p(l) && !c(l) && r = ok(l, empty)) || (ex l. p(l) && c(l) && b(l, r) && g(l, r) && !is_ok(r)))) proof
      assume hc: c(x)
      assume e: ex l2. b(x, ok(l2, empty)) && p(l2) && int_lt(m(l2), m(x))
      obtain l2, h2 from e
      have p2: p(l2) by taut(h2)
      have lt: int_lt(m(l2), m(x)) by taut(h2)
      have b2: b(x, ok(l2, empty)) by taut(h2)
      have e2 := mp(mp(all_elim(ih, {l2}), p2), lt)
      obtain r, hr from e2
      have w2: while_rel(l2, l. c(l), l o. b(l, o), l. tr(l), r) by taut(hr)
      have nd: !(fst(r) = 2) by taut(hr)
      have ws := mp(mp(mp(mp(while_step[l0 := x, l1 := l2, c := l. c(l), b := l o. b(l, o), tr := l. tr(l), r := r], hc), b2), w2), nd)
      show by ex_intro({r}, taut(ws, hr))
    qed
    // the body leaves
    have k2: c(x) -> (ex r. b(x, r) && g(x, r) && !is_ok(r) && !(fst(r) = 2)) -> (ex r. while_rel(x, l. c(l), l o. b(l, o), l. tr(l), r) && !(fst(r) = 2) &&
        ((ex l. p(l) && !c(l) && r = ok(l, empty)) || (ex l. p(l) && c(l) && b(l, r) && g(l, r) && !is_ok(r)))) proof
      assume hc: c(x)
      assume e: ex r. b(x, r) && g(x, r) && !is_ok(r) && !(fst(r) = 2)
      obtain r, hr from e
      have br: b(x, r) by taut(hr)
      have no: !is_ok(r) by taut(hr)
      have wl := mp(mp(mp(while_leave[l0 := x, c := l. c(l), b := l o. b(l, o), tr := l. tr(l), r := r], hc), br), no)
      have gr: g(x, r) by taut(hr)
      have ex1: ex l. p(l) && c(l) && b(l, r) && g(l, r) && !is_ok(r) by ex_intro({x}, taut(hx, hc, br, gr, no))
      show by ex_intro({r}, taut(wl, hr, ex1))
    qed
    have bx := all_elim(hb, {x})
    show by taut(k0, k1, k2, bx, hx)
  qed
  // by induction on the bound of m
  have all_n: all n. n in omega -> (all x. p(x) -> int_le(m(x), n) -> (ex r. while_rel(x, l. c(l), l o. b(l, o), l. tr(l), r) && !(fst(r) = 2) &&
        ((ex l. p(l) && !c(l) && r = ok(l, empty)) || (ex l. p(l) && c(l) && b(l, r) && g(l, r) && !is_ok(r))))) proof
    have base: all x. p(x) -> int_le(m(x), 0) -> (ex r. while_rel(x, l. c(l), l o. b(l, o), l. tr(l), r) && !(fst(r) = 2) &&
        ((ex l. p(l) && !c(l) && r = ok(l, empty)) || (ex l. p(l) && c(l) && b(l, r) && g(l, r) && !is_ok(r)))) proof
      fix x
      assume hx: p(x)
      assume hz: int_le(m(x), 0)
      have v: all y. p(y) -> int_lt(m(y), m(x)) -> (ex r. while_rel(y, l. c(l), l o. b(l, o), l. tr(l), r) && !(fst(r) = 2) &&
          ((ex l. p(l) && !c(l) && r = ok(l, empty)) || (ex l. p(l) && c(l) && b(l, r) && g(l, r) && !is_ok(r)))) proof
        fix y
        assume hy: p(y)
        assume lt: int_lt(m(y), m(x))
        have my := mp(all_elim(hm, {y}), hy)
        have f: false by arith(my, hz, lt)
        show by taut(f)
      qed
      show := mp(mp(all_elim(hstep, {x}), hx), v)
    qed
    have step: all i. i in omega -> (all x. p(x) -> int_le(m(x), i) -> (ex r. while_rel(x, l. c(l), l o. b(l, o), l. tr(l), r) && !(fst(r) = 2) &&
          ((ex l. p(l) && !c(l) && r = ok(l, empty)) || (ex l. p(l) && c(l) && b(l, r) && g(l, r) && !is_ok(r))))) ->
        (all x. p(x) -> int_le(m(x), int_add(i, 1)) -> (ex r. while_rel(x, l. c(l), l o. b(l, o), l. tr(l), r) && !(fst(r) = 2) &&
          ((ex l. p(l) && !c(l) && r = ok(l, empty)) || (ex l. p(l) && c(l) && b(l, r) && g(l, r) && !is_ok(r))))) proof
      fix i
      assume hi: i in omega
      assume ih: all x. p(x) -> int_le(m(x), i) -> (ex r. while_rel(x, l. c(l), l o. b(l, o), l. tr(l), r) && !(fst(r) = 2) &&
          ((ex l. p(l) && !c(l) && r = ok(l, empty)) || (ex l. p(l) && c(l) && b(l, r) && g(l, r) && !is_ok(r))))
      fix x
      assume hx: p(x)
      assume hle: int_le(m(x), int_add(i, 1))
      have v: all y. p(y) -> int_lt(m(y), m(x)) -> (ex r. while_rel(y, l. c(l), l o. b(l, o), l. tr(l), r) && !(fst(r) = 2) &&
          ((ex l. p(l) && !c(l) && r = ok(l, empty)) || (ex l. p(l) && c(l) && b(l, r) && g(l, r) && !is_ok(r)))) proof
        fix y
        assume hy: p(y)
        assume lt: int_lt(m(y), m(x))
        have my := mp(all_elim(hm, {y}), hy)
        have le: int_le(m(y), i) by arith(my, hi, hle, lt)
        show := mp(mp(all_elim(ih, {y}), hy), le)
      qed
      show := mp(mp(all_elim(hstep, {x}), hx), v)
    qed
    show by induct(base, step)
  qed
  have m0 := mp(all_elim(hm, {l0}), h0)
  have q := mp(all_elim(all_n, {m(l0)}), m0)
  have le: int_le(m(l0), m(l0)) by arith(m0)
  show := mp(mp(all_elim(q, {l0}), h0), le)
qed
