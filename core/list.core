// Lists: examples of `lists`, `arith` on lengths, `at` and `list_ext`.
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core core/list.core
//
// A list literal [a, b, c] is seq_one(a) ++ seq_one(b) ++ seq_one(c)
// (`seq_concat`); `len` is `seq_len`, `l[i]` is `app(l, i)`.

// associativity, and the unit []
theorem concat_assoc(a, b, c, t):
  a in list_type(t) -> b in list_type(t) -> c in list_type(t) ->
    seq_concat(seq_concat(a, b), c) = seq_concat(a, seq_concat(b, c))
proof
  assume ha: a in list_type(t)
  assume hb: b in list_type(t)
  assume hc: c in list_type(t)
  show by lists(ha, hb, hc)
qed

theorem append_is_concat(l, x, t): l in list_type(t) -> seq_append(seq_concat(empty, l), x) = seq_concat(l, seq_one(x))
proof
  assume h: l in list_type(t)
  show by lists(h)
qed

// lengths are linear arithmetic
theorem len_literal(x, y, z): seq_len(seq_concat(seq_concat(seq_one(x), seq_one(y)), seq_one(z))) = 3
proof
  show by arith()
qed

theorem len_concat(a, b, t):
  a in list_type(t) -> b in list_type(t) ->
    nat_le(seq_len(a), seq_len(seq_concat(a, seq_concat(seq_one(t), b))))
proof
  assume ha: a in list_type(t)
  assume hb: b in list_type(t)
  show by arith(ha, hb)
qed

// indexing: the element is found in its piece
theorem at_literal(x, y, z): app(seq_concat(seq_concat(seq_one(x), seq_one(y)), seq_one(z)), 1) = y
proof
  show at({app(seq_concat(seq_concat(seq_one(x), seq_one(y)), seq_one(z)), 1)})
qed

// ... also inside a list that is only known by name
theorem at_shifted(l, x, i, t):
  l in list_type(t) -> i in omega -> nat_lt(i, seq_len(l)) ->
    app(seq_concat(seq_one(x), l), nat_add(i, 1)) = app(l, i)
proof
  assume hl: l in list_type(t)
  assume hi: i in omega
  assume hlt: nat_lt(i, seq_len(l))
  have e := at({app(seq_concat(seq_one(x), l), nat_add(i, 1))}, hl, hi, hlt)
  have k: nat_sub(nat_add(i, 1), 1) = i by arith(hi)
  show rewrite(k, e)
qed

// extensionality: a list is determined by its length and elements
theorem ext_example(a, b, t):
  a in list_type(t) -> b in list_type(t) -> seq_len(a) = seq_len(b) ->
    (all i. i in omega -> nat_lt(i, seq_len(a)) -> app(a, i) = app(b, i)) -> a = b
proof
  assume ha: a in list_type(t)
  assume hb: b in list_type(t)
  assume hl: seq_len(a) = seq_len(b)
  assume he: all i. i in omega -> nat_lt(i, seq_len(a)) -> app(a, i) = app(b, i)
  show list_ext(ha, hb, hl, he)
qed
