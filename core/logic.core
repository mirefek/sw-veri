// Basic logic, proven with the proof language (slc/proof); loaded after
// core/prelude.core:  slc kernel-check core/prelude.core core/logic.core
//
// The first theorems use only kernel steps (modus ponens, instantiation of
// axioms); the others use the trusted extensions' rules (hypotheses,
// quantifiers, equality, tautologies; see slc/kernel/src/ext).

// ---------------------------------------------------------------------
//  From the axioms alone

// a -> a  (the S K K combinator)
theorem imp_refl(a): a -> a
proof
  have s := imp_chain[a := a, b := a -> a, c := a]
  have k1 := imp_weaken[a := a, b := a -> a]
  have k2 := imp_weaken[a := a, b := a]
  show mp(mp(s, k1), k2)
qed

// a = b -> b = a  (substitute into x. x = a)
theorem eq_sym(a, b): a = b -> b = a
proof
  assume h
  have s := eq_subst[a := a, b := b, p := x. x = a]
  show mp(mp(s, h), eq_refl[a := a])
qed

// a = b -> b = c -> a = c  (substitute into x. a = x)
theorem eq_trans(a, b, c): a = b -> b = c -> a = c
proof
  assume h1 h2
  have s := eq_subst[a := b, b := c, p := x. a = x]
  show mp(mp(s, h2), h1)
qed

// ---------------------------------------------------------------------
//  Propositions

theorem true_i: true
proof
  have r := imp_refl[a := false]
  have n := rewrite(sym(unfold(not)[a := false]), r)
  show rewrite(sym(unfold(true)), n)
qed

// Classical logic for any term, not only propositions: `true -> a` is a
// proposition (imp_prop), either false or true, and interderivable with a.
// Follows ji-trust's `not_not_impl` (basic.pf).
theorem dne_any(a): !!a -> a
proof
  assume nna
  have p0 := imp_prop[a := true, b := a]
  have p1 := rewrite(unfold(is_prop)[a := true -> a], p0)
  have p2 := rewrite(unfold(or)[a := (true -> a) = false, b := (true -> a) = true], p1)
  have p3 := rewrite(unfold(not)[a := (true -> a) = false], p2)
  assume e: (true -> a) = false
  assume ha: a
  have t := mp(imp_weaken[a := a, b := true], ha)
  have f := subst({x. x}, e, t)
  have naa := discharge(f, ha)
  have nna1 := rewrite(unfold(not)[a := not(a)], nna)
  have nna2 := rewrite(unfold(not)[a := a], nna1)
  have ff := mp(nna2, naa)
  have ne := discharge(ff, e)
  have et := mp(p3, ne)
  have ta := subst({x. x}, sym(et), true_i)
  show mp(ta, true_i)
qed

// a conjunction's parts, for any terms (the proof language's `h.k` and
// `obtain`'s parts: modus ponens with these, no tautology search)
theorem and_left(a, b): a && b -> a
proof
  assume h
  show a by taut(h)
qed

theorem and_right(a, b): a && b -> b
proof
  assume h
  show b by taut(h)
qed

// ... and built (the proof language's `conj(p1, .., pn)`)
theorem and_intro(a, b): a -> b -> a && b
proof
  assume ha hb
  show a && b by taut(ha, hb)
qed

theorem false_is_prop: is_prop(false)
proof
  show prop({false})
qed

// classical reasoning, for propositions
theorem dne(a): is_prop(a) -> !!a -> a
proof
  assume p h
  show a by taut(h, p)
qed

theorem and_swap(a, b): is_prop(a) -> is_prop(b) -> a && b -> b && a
proof
  assume pa pb h
  show b && a by taut(h, pa, pb)
qed

// ---------------------------------------------------------------------
//  Quantifiers and definitions

theorem all_refl: all x. x = x
proof
  fix x
  show refl({x})
qed

theorem ex_refl: ex x. x = x
proof
  show ex x. x = x by ex_intro({false}, refl({false}))
qed

// the witness of an existential statement
theorem choose_eq(a): (ex x. x = a) -> choose(x. x = a) = a
proof
  assume h
  show witness(h)
qed

// unfolding a definition: every set is a subset of itself
theorem subset_refl(s): subset(s, s)
proof
  fix x
  have h: x in s -> x in s by taut()
  have g := gen(h, x)
  have d := unfold(subset)[a := s, b := s]
  show rewrite(sym(d), g)
qed

// instantiating a universal statement
theorem subset_elim(a, b, z): subset(a, b) -> z in a -> z in b
proof
  assume h
  have d := unfold(subset)[a := a, b := b]
  have u := rewrite(d, h)
  show all_elim(u, {z})
qed

// ---------------------------------------------------------------------
//  Propositional extensionality; the basic simp set (`simp NAME`: a
//  rewrite rule of the proof language's simp, left to right)

// propositions that imply each other are equal (both false, or both true)
theorem prop_ext(a, b): is_prop(a) -> is_prop(b) -> (a -> b) -> (b -> a) -> a = b
proof
  assume pa pb ab ba
  have ca := expand(pa, is_prop)
  have cb := expand(pb, is_prop)
  have tt: a = true -> b = true -> a = b proof
    assume e1 e2
    show trans(e1, sym(e2))
  qed
  have ff: a = false -> b = false -> a = b proof
    assume e1 e2
    show trans(e1, sym(e2))
  qed
  have tf: a = true -> b = false -> false proof
    assume e1 e2
    show rewrite(e2, mp(ab, rewrite(sym(e1), true_i)))
  qed
  have ft: a = false -> b = true -> false proof
    assume e1 e2
    show rewrite(e1, mp(ba, rewrite(sym(e2), true_i)))
  qed
  show by taut(ca, cb, tt, ff, tf, ft)
qed

theorem iff_eq(a, b): is_prop(a) -> is_prop(b) -> (a <-> b) -> a = b
proof
  assume pa pb h
  have ab: a -> b by taut(h)
  have ba: b -> a by taut(h)
  show apply(prop_ext, pa, pb, ab, ba)
qed

// a fact is `true`, a refuted proposition `false`
theorem eq_true(a): is_prop(a) -> a -> a = true
proof
  assume pa h
  have ab: a -> true by taut(true_i)
  have ba: true -> a by taut(h)
  show apply(prop_ext, pa, prop({true}), ab, ba)
qed

theorem eq_false(a): is_prop(a) -> !a -> a = false
proof
  assume pa h
  have ab: a -> false by taut(h)
  have ba: false -> a by taut()
  show apply(prop_ext, pa, prop({false}), ab, ba)
qed

theorem of_eq_true(a): a = true -> a
proof
  assume e
  show rewrite(sym(e), true_i)
qed

theorem eq_self(a): (a = a) = true
proof
  show apply(eq_true, prop({a = a}), refl({a}))
qed

theorem not_true: (!true) = false
proof
  show apply(eq_false, prop({!true}), (!!true by taut(true_i)))
qed

theorem not_false: (!false) = true
proof
  show apply(eq_true, prop({!false}), (!false by taut()))
qed

theorem not_not(a): is_prop(a) -> (!!a) = a
proof
  assume pa
  show apply(prop_ext, prop({!!a}), pa, (!!a -> a by taut()), (a -> !!a by taut()))
qed

theorem true_and(a): is_prop(a) -> (true && a) = a
proof
  assume pa
  show apply(prop_ext, prop({true && a}), pa, (true && a -> a by taut()), (a -> true && a by taut(true_i)))
qed

theorem and_true(a): is_prop(a) -> (a && true) = a
proof
  assume pa
  show apply(prop_ext, prop({a && true}), pa, (a && true -> a by taut()), (a -> a && true by taut(true_i)))
qed

theorem false_and(a): (false && a) = false
proof
  show apply(eq_false, prop({false && a}), (!(false && a) by taut()))
qed

theorem and_false(a): (a && false) = false
proof
  show apply(eq_false, prop({a && false}), (!(a && false) by taut()))
qed

theorem true_or(a): (true || a) = true
proof
  show apply(eq_true, prop({true || a}), (true || a by taut(true_i)))
qed

theorem or_true(a): (a || true) = true
proof
  show apply(eq_true, prop({a || true}), (a || true by taut(true_i)))
qed

theorem false_or(a): is_prop(a) -> (false || a) = a
proof
  assume pa
  show apply(prop_ext, prop({false || a}), pa, (false || a -> a by taut()), (a -> false || a by taut()))
qed

theorem or_false(a): is_prop(a) -> (a || false) = a
proof
  assume pa
  show apply(prop_ext, prop({a || false}), pa, (a || false -> a by taut()), (a -> a || false by taut()))
qed

theorem true_imp(a): is_prop(a) -> (true -> a) = a
proof
  assume pa
  show apply(prop_ext, prop({true -> a}), pa, ((true -> a) -> a by taut(true_i)), (a -> true -> a by taut()))
qed

theorem false_imp(a): (false -> a) = true
proof
  show apply(eq_true, prop({false -> a}), (false -> a by taut()))
qed

theorem imp_true(a): (a -> true) = true
proof
  show apply(eq_true, prop({a -> true}), (a -> true by taut(true_i)))
qed

theorem imp_self(a): (a -> a) = true
proof
  show apply(eq_true, prop({a -> a}), (a -> a by taut()))
qed

theorem iff_self(a): (a <-> a) = true
proof
  show apply(eq_true, prop({a <-> a}), (a <-> a by taut()))
qed

theorem all_true: (all x. true) = true
proof
  fix x
  have t := gen(true_i, x)
  show apply(eq_true, prop({all x. true}), t)
qed

simp eq_self
simp imp_self
simp iff_self
simp all_true
simp not_true
simp not_false
simp not_not
simp true_and
simp and_true
simp false_and
simp and_false
simp true_or
simp or_true
simp false_or
simp or_false
simp true_imp
simp false_imp
simp imp_true
