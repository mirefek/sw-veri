// Bits: a word's bits (`bit(x, i)`: (x / 2^i) mod 2 = 1) under division,
// remainders and multiples by powers of 2, the bitwise operations bit by
// bit, the complement and negation. With them a word equation is shown
// bit by bit (`bits_ext`).
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core core/bits.core
//
// Built on `arith`'s products (monomials), Euclidean division by a
// symbolic divisor and nonnegative products: a product of a hint term
// (`refl({int_mul(m, ..)})`) brings its sign fact in.

// ----------------------------------------------------------------------
//  Division and powers of 2

// Euclidean division is unique
theorem div_unique(x, m, q, r): x in omega -> q in omega -> r in omega -> int_lt(0, m) -> int_lt(r, m) -> x = int_add(int_mul(m, q), r) ->
  quot: int_div(x, m) = q && rem: int_mod(x, m) = r
proof
  assume hx hq hr hm hrm he
  have u1: int_mul(m, int_sub(int_sub(q, int_div(x, m)), 1)) = int_mul(m, int_sub(int_sub(q, int_div(x, m)), 1)) := refl({int_mul(m, int_sub(int_sub(q, int_div(x, m)), 1))})
  have u2: int_mul(m, int_sub(int_sub(int_div(x, m), q), 1)) = int_mul(m, int_sub(int_sub(int_div(x, m), q), 1)) := refl({int_mul(m, int_sub(int_sub(int_div(x, m), q), 1))})
  have d: int_div(x, m) = q by arith(hx, hq, hr, hm, hrm, he, u1, u2)
  have e: int_mod(x, m) = r by arith(hx, hq, hr, hm, hrm, he, d)
  show conj(d, e)
qed

// a quotient and a remainder of a natural: naturals
theorem div_nat(x, m): x in omega -> int_lt(0, m) -> int_div(x, m) in omega && int_mod(x, m) in omega
proof
  assume hx hm
  have u: int_mul(m, int_sub(int_sub(0, int_div(x, m)), 1)) = int_mul(m, int_sub(int_sub(0, int_div(x, m)), 1)) := refl({int_mul(m, int_sub(int_sub(0, int_div(x, m)), 1))})
  have q: int_div(x, m) in omega by arith(hx, hm, u)
  have r: int_mod(x, m) in omega by arith(hx, hm)
  show conj(q, r)
qed

// powers of 2: a sum of exponents
theorem pow2_add: all a. a in omega -> all b. b in omega -> pow2(int_add(a, b)) = int_mul(pow2(a), pow2(b))
proof
  fix a
  assume ha
  have base: pow2(int_add(a, 0)) = int_mul(pow2(a), pow2(0)) by arith(ha)
  have step: all n. n in omega -> pow2(int_add(a, n)) = int_mul(pow2(a), pow2(n)) -> pow2(int_add(a, int_add(n, 1))) = int_mul(pow2(a), pow2(int_add(n, 1))) proof
    fix n
    assume hn ih
    have e: int_add(a, int_add(n, 1)) = int_add(int_add(a, n), 1) by arith(ha, hn)
    have an: int_add(a, n) in omega by arith(ha, hn)
    have r: pow2(int_add(int_add(a, n), 1)) = int_mul(pow2(a), pow2(int_add(n, 1))) by arith(ha, hn, an, ih)
    show rewrite(sym(e), r)
  qed
  show by induct(base, step)
qed

// division twice: by the product
theorem div_div(x, a, b): x in omega -> int_lt(0, a) -> int_lt(0, b) ->
  int_div(int_div(x, a), b) = int_div(x, int_mul(a, b)) && int_mod(x, int_mul(a, b)) = int_add(int_mul(a, int_mod(int_div(x, a), b)), int_mod(x, a))
proof
  assume hx ha hb
  let Q1 := int_div(x, a)
  let R1 := int_mod(x, a)
  let Q2 := int_div(Q1, b)
  let R2 := int_mod(Q1, b)
  have q1 r1 := mp(div_nat[x := x, m := a], hx, ha)
  have q2 r2 := mp(div_nat[x := Q1, m := b], q1, hb)
  have e2: Q1 = int_add(int_mul(b, Q2), R2) by arith(q1, hb)
  have c: int_mul(a, Q1) = int_mul(a, int_add(int_mul(b, Q2), R2)) := rewrite(e2, refl({int_mul(a, Q1)}), {2})
  have u1 := refl({int_mul(a, int_sub(b, 1))})
  have u2 := refl({int_mul(a, int_sub(int_sub(b, 1), R2))})
  have ab: int_lt(0, int_mul(a, b)) by arith(ha, hb, u1)
  let r := int_add(int_mul(a, R2), R1)
  have rn: r in omega by arith(ha, r1, r2)
  have rl: int_lt(r, int_mul(a, b)) by arith(ha, hb, r1, r2, u2)
  have ee: x = int_add(int_mul(int_mul(a, b), Q2), r) by arith(hx, ha, c)
  have d m := mp(div_unique[x := x, m := int_mul(a, b), q := Q2, r := r], hx, q2, rn, ab, rl, ee)
  show conj(sym(d), m)
qed

// a multiple of m added: the quotient by m up by its factor, the remainder the same
theorem div_add_mul(x, m, y): x in omega -> y in omega -> int_lt(0, m) ->
  int_div(int_add(x, int_mul(m, y)), m) = int_add(int_div(x, m), y) && int_mod(int_add(x, int_mul(m, y)), m) = int_mod(x, m)
proof
  assume hx hy hm
  have q r := mp(div_nat[x := x, m := m], hx, hm)
  have u := refl({int_mul(m, y)})
  have xn: int_add(x, int_mul(m, y)) in omega by arith(hx, hy, hm, u)
  have qn: int_add(int_div(x, m), y) in omega by arith(q, hy)
  have ee: int_add(x, int_mul(m, y)) = int_add(int_mul(m, int_add(int_div(x, m), y)), int_mod(x, m)) by arith(hx, hm)
  show mp(div_unique[x := int_add(x, int_mul(m, y)), m := m, q := int_add(int_div(x, m), y), r := int_mod(x, m)], xn, qn, r, hm, arith(hx, hm), ee)
qed

// Euclidean division of an integer is unique: its remainder
theorem mod_unique_int(x, m, q, r): q in int -> r in omega -> int_lt(0, m) -> int_lt(r, m) -> x = int_add(int_mul(m, q), r) ->
  int_div(x, m) = q && int_mod(x, m) = r
proof
  assume hq hr hm hrm he
  have u1 := refl({int_mul(m, int_sub(int_sub(q, int_div(x, m)), 1))})
  have u2 := refl({int_mul(m, int_sub(int_sub(int_div(x, m), q), 1))})
  have d: int_div(x, m) = q by arith(hq, hr, hm, hrm, he, u1, u2)
  have e: int_mod(x, m) = r by arith(hq, hr, hm, hrm, he, d)
  show conj(d, e)
qed

// a multiple of m added to an integer: the remainder by m the same
theorem mod_add_mul_int(x, m, y): y in int -> int_lt(0, m) -> int_mod(int_add(x, int_mul(m, y)), m) = int_mod(x, m)
proof
  assume hy hm
  have qi: int_add(int_div(x, m), y) in int by arith(hy, hm)
  have ri: int_mod(x, m) in omega by arith(hm)
  have rl: int_lt(int_mod(x, m), m) by arith(hm)
  have ee: int_add(x, int_mul(m, y)) = int_add(int_mul(m, int_add(int_div(x, m), y)), int_mod(x, m)) by arith(hm)
  have both := mp(mod_unique_int[x := int_add(x, int_mul(m, y)), m := m, q := int_add(int_div(x, m), y), r := int_mod(x, m)], qi, ri, hm, rl, ee)
  show by taut(both)
qed

// a remainder by m in a sum: the sum's remainder the same
theorem mod_add_mod(x, y, m): int_lt(0, m) -> int_mod(int_add(int_mod(x, m), y), m) = int_mod(int_add(x, y), m)
proof
  assume hm
  have yi: int_neg(int_div(x, m)) in int by arith(hm)
  have e: int_add(int_add(x, y), int_mul(m, int_neg(int_div(x, m)))) = int_add(int_mod(x, m), y) by arith(hm)
  have c := mp(mod_add_mul_int[x := int_add(x, y), m := m, y := int_neg(int_div(x, m))], yi, hm)
  show := rewrite(e, c)
qed

// a remainder by m in a product: the product's remainder the same
theorem mod_mul_mod(x, c, m): x in int -> int_lt(0, m) -> int_mod(int_mul(int_mod(x, m), c), m) = int_mod(int_mul(x, c), m)
proof
  assume hx hm
  have h: x = int_add(int_mul(m, int_div(x, m)), int_mod(x, m)) by arith(hx, hm)
  have e2 := rewrite(h, refl({int_mul(x, c)}), {2})
  have yi: int_mul(int_neg(int_div(x, m)), c) in int by arith(hm)
  have e: int_add(int_mul(x, c), int_mul(m, int_mul(int_neg(int_div(x, m)), c))) = int_mul(int_mod(x, m), c) by arith(hm, e2)
  have k := mp(mod_add_mul_int[x := int_mul(x, c), m := m, y := int_mul(int_neg(int_div(x, m)), c)], yi, hm)
  show := rewrite(e, k)
qed

// powers of 2 grow
theorem pow2_le(a, b): a in omega -> b in omega -> int_le(a, b) -> int_le(pow2(a), pow2(b))
proof
  assume ha hb hab
  have d: int_sub(b, a) in omega by arith(ha, hb, hab)
  have e: int_add(a, int_sub(b, a)) = b by arith(ha, hb)
  have p := rewrite(e, mp(all_elim(mp(all_elim(pow2_add, {a}), ha), {int_sub(b, a)}), d))
  have u := refl({int_mul(pow2(a), int_sub(pow2(int_sub(b, a)), 1))})
  show by arith(ha, d, p, u)
qed

// ----------------------------------------------------------------------
//  Bits of quotients, remainders and multiples of powers of 2

// (a power of 2: positive)
theorem pow2_pos(k): k in omega -> int_lt(0, pow2(k))
proof
  assume hk
  show by arith(hk)
qed

// x / 2^k: its bit i is x's bit k + i
theorem bit_div(x, k, i): x in omega -> k in omega -> i in omega -> (bit(int_div(x, pow2(k)), i) <-> bit(x, int_add(k, i)))
proof
  assume hx hk hi
  have dd _ := mp(div_div[x := x, a := pow2(k), b := pow2(i)], hx, mp(pow2_pos[k := k], hk), mp(pow2_pos[k := i], hi))
  have pa := mp(all_elim(mp(all_elim(pow2_add, {k}), hk), {i}), hi)
  have e: int_div(int_div(x, pow2(k)), pow2(i)) = int_div(x, pow2(int_add(k, i))) := rewrite(sym(pa), dd)
  show by defs(rsimp(e), bit)
qed

// 2^b split at a <= b
theorem pow2_split(a, b): a in omega -> b in omega -> int_le(a, b) -> pow2(b) = int_mul(pow2(a), pow2(int_sub(b, a)))
proof
  assume ha hb hab
  have d: int_sub(b, a) in omega by arith(ha, hb, hab)
  have e: int_add(a, int_sub(b, a)) = b by arith(ha, hb)
  show rewrite(e, mp(all_elim(mp(all_elim(pow2_add, {a}), ha), {int_sub(b, a)}), d))
qed

// (below 2^j, j >= 1: the same parity)
theorem mod_pow2_2(z, j): z in omega -> j in omega -> int_le(1, j) -> int_mod(int_mod(z, pow2(j)), 2) = int_mod(z, 2)
proof
  assume hz hj h1
  have j1: int_sub(j, 1) in omega by arith(hj, h1)
  have ej: int_add(int_sub(j, 1), 1) = j by arith(hj)
  have r: int_mod(int_mod(z, pow2(int_add(int_sub(j, 1), 1))), 2) = int_mod(z, 2) by arith(hz, j1)
  show rewrite(ej, r)
qed

// (a multiple of 2^j, j >= 1: even)
theorem mul_pow2_even(y, j): y in omega -> j in omega -> int_le(1, j) -> int_mod(int_mul(y, pow2(j)), 2) = 0
proof
  assume hy hj h1
  have j1: int_sub(j, 1) in omega by arith(hj, h1)
  have ej: int_add(int_sub(j, 1), 1) = j by arith(hj)
  have r: int_mod(int_mul(y, pow2(int_add(int_sub(j, 1), 1))), 2) = 0 by arith(hy, j1)
  show rewrite(ej, r)
qed

// no bit at or above n of x < 2^n
theorem bit_high(x, n, i): x in omega -> n in omega -> i in omega -> int_lt(x, pow2(n)) -> int_le(n, i) -> !bit(x, i)
proof
  assume hx hn hi hl hni
  have pl := mp(pow2_le[a := n, b := i], hn, hi, hni)
  show by defs(arith(hx, hn, hi, hl, pl), bit)
qed

// x mod 2^k: x's bits below k
theorem bit_mod(x, k, i): x in omega -> k in omega -> i in omega -> (bit(int_mod(x, pow2(k)), i) <-> int_lt(i, k) && bit(x, i))
proof
  assume hx hk hi
  have lo: int_lt(i, k) -> (bit(int_mod(x, pow2(k)), i) <-> int_lt(i, k) && bit(x, i)) proof
    assume ik
    let a := pow2(i)
    let b := pow2(int_sub(k, i))
    have ki: int_sub(k, i) in omega by arith(hk, hi, ik)
    have ap := mp(pow2_pos[k := i], hi)
    have bp := mp(pow2_pos[k := int_sub(k, i)], ki)
    have pk := mp(pow2_split[a := i, b := k], hi, hk, arith(ik))
    have _ md := mp(div_div[x := x, a := a, b := b], hx, ap, bp)
    have mn _ := mp(div_nat[x := x, m := a], hx, ap)
    have _ dn := mp(div_nat[x := int_div(x, a), m := b], mp(div_nat[x := x, m := a], hx, ap).1, bp)
    have q1 _ := mp(div_add_mul[x := int_mod(x, a), m := a, y := int_mod(int_div(x, a), b)], mp(div_nat[x := x, m := a], hx, ap).2, dn, ap)
    have z0: int_div(int_mod(x, a), a) = 0 by arith(hx, ap)
    have eo: int_add(int_mod(x, a), int_mul(a, int_mod(int_div(x, a), b))) = int_mod(x, int_mul(a, b)) by arith(md)
    have e1 := rewrite(eo, q1)
    have e2 := rewrite(sym(pk), e1)
    have m2 := mp(mod_pow2_2[z := int_div(x, a), j := int_sub(k, i)], mp(div_nat[x := x, m := a], hx, ap).1, ki, arith(ik))
    have e3: int_mod(int_div(int_mod(x, pow2(k)), a), 2) = int_mod(int_div(x, a), 2) by arith(e2, z0, m2)
    show by defs(rsimp(e3, ik), bit)
  qed
  have hi2: !int_lt(i, k) -> (bit(int_mod(x, pow2(k)), i) <-> int_lt(i, k) && bit(x, i)) proof
    assume ik
    have kp := mp(pow2_pos[k := k], hk)
    have mn := mp(div_nat[x := x, m := pow2(k)], hx, kp).2
    have nb := mp(bit_high[x := int_mod(x, pow2(k)), n := k, i := i], mn, hk, hi, arith(hx, kp), arith(ik, hk, hi))
    show by taut(nb, ik)
  qed
  show by taut(lo, hi2)
qed

// x * 2^k: x's bits moved up by k
theorem bit_mul(x, k, i): x in omega -> k in omega -> i in omega -> (bit(int_mul(x, pow2(k)), i) <-> int_le(k, i) && bit(x, int_sub(i, k)))
proof
  assume hx hk hi
  let X := int_mul(x, pow2(k))
  have kp := mp(pow2_pos[k := k], hk)
  have up: int_le(k, i) -> (bit(X, i) <-> int_le(k, i) && bit(x, int_sub(i, k))) proof
    assume ki
    let j := int_sub(i, k)
    have hj: j in omega by arith(hk, hi, ki)
    have jp := mp(pow2_pos[k := j], hj)
    have xn: X in omega by arith(hx, hk)
    have ps := mp(pow2_split[a := k, b := i], hk, hi, ki)
    have dd _ := mp(div_div[x := X, a := pow2(k), b := pow2(j)], xn, kp, jp)
    have dm _ := mp(div_add_mul[x := 0, m := pow2(k), y := x], arith(), hx, kp)
    have e0: int_add(0, int_mul(pow2(k), x)) = X by arith()
    have e: int_div(X, pow2(k)) = x by arith(rewrite(e0, dm), kp, hx)
    have f: int_div(x, pow2(j)) = int_div(X, pow2(i)) := rewrite(e, rewrite(sym(ps), dd))
    show by defs(rsimp(sym(f), ki), bit)
  qed
  have down: !int_le(k, i) -> (bit(X, i) <-> int_le(k, i) && bit(x, int_sub(i, k))) proof
    assume ki
    let Y := int_mul(x, pow2(int_sub(k, i)))
    have hj: int_sub(k, i) in omega by arith(hk, hi, ki)
    have ip := mp(pow2_pos[k := i], hi)
    have ps := mp(pow2_split[a := i, b := k], hi, hk, arith(ki))
    have xr := rewrite(ps, refl({X}), {2})
    have yn: Y in omega by arith(hx, hj)
    have dm _ := mp(div_add_mul[x := 0, m := pow2(i), y := Y], arith(), yn, ip)
    have e0: int_add(0, int_mul(pow2(i), Y)) = X by arith(xr)
    have ev := mp(mul_pow2_even[y := x, j := int_sub(k, i)], hx, hj, arith(ki, hk, hi))
    have nb: !bit(X, i) by defs(arith(rewrite(e0, dm), ip, ev), bit)
    show by taut(nb, ki)
  qed
  show by taut(up, down)
qed

// 1: only bit 0
theorem bit_one(i): i in omega -> (bit(1, i) <-> i = 0)
proof
  assume hi
  have z: i = 0 -> (bit(1, i) <-> i = 0) proof
    assume h
    show by rsimp(h, bit)
  qed
  have nz: !(i = 0) -> (bit(1, i) <-> i = 0) proof
    assume h
    have pl := mp(pow2_le[a := 1, b := i], arith(), hi, arith(hi, h))
    have nb: !bit(1, i) by defs(arith(hi, pl), bit)
    show by taut(nb, h)
  qed
  show by taut(z, nz)
qed

// 2^k: only bit k
theorem bit_pow2(k, i): k in omega -> i in omega -> (bit(pow2(k), i) <-> i = k)
proof
  assume hk hi
  have m := mp(bit_mul[x := 1, k := k, i := i], arith(), hk, hi)
  have e: int_mul(1, pow2(k)) = pow2(k) by arith()
  have up: int_le(k, i) -> (bit(1, int_sub(i, k)) <-> i = k) proof
    assume ki
    have b := mp(bit_one[i := int_sub(i, k)], arith(hi, hk, ki))
    have c: int_sub(i, k) = 0 <-> i = k by arith(hi, hk)
    show by taut(b, c)
  qed
  have ik: i = k -> int_le(k, i) by arith(hi, hk)
  show by taut(rewrite(e, m), up, ik)
qed

// x / 2: x's bits moved down by 1
theorem bit_half(x, i): x in omega -> i in omega -> (bit(int_div(x, 2), i) <-> bit(x, int_add(i, 1)))
proof
  assume hx hi
  have d := mp(bit_div[x := x, k := 1, i := i], hx, arith(), hi)
  have e1: pow2(1) = 2 by arith()
  have e2: int_add(1, i) = int_add(i, 1) by arith(hi)
  show rewrite(e2, rewrite(e1, d))
qed

// ----------------------------------------------------------------------
//  A word is its bits

theorem bits_ext: all n. n in omega -> all x y. x in bits(n) -> y in bits(n) -> (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(y, i))) -> x = y
proof
  have base: all x y. x in bits(0) -> y in bits(0) -> (all i. i in omega -> int_lt(i, 0) -> (bit(x, i) <-> bit(y, i))) -> x = y proof
    fix x y
    assume hx hy _
    show by arith(hx, hy)
  qed
  have step: all n. n in omega -> (all x y. x in bits(n) -> y in bits(n) -> (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(y, i))) -> x = y) ->
      (all x y. x in bits(int_add(n, 1)) -> y in bits(int_add(n, 1)) -> (all i. i in omega -> int_lt(i, int_add(n, 1)) -> (bit(x, i) <-> bit(y, i))) -> x = y) proof
    fix n
    assume hn ih
    fix x y
    assume hx hy hb
    have xo: x in omega by arith(hx, hn)
    have yo: y in omega by arith(hy, hn)
    have hx2: int_div(x, 2) in bits(n) by arith(hx, hn)
    have hy2: int_div(y, 2) in bits(n) by arith(hy, hn)
    have hb2: all i. i in omega -> int_lt(i, n) -> (bit(int_div(x, 2), i) <-> bit(int_div(y, 2), i)) proof
      fix i
      assume hi hin
      have bx := mp(bit_half[x := x, i := i], xo, hi)
      have by := mp(bit_half[x := y, i := i], yo, hi)
      have b := mp(all_elim(hb, {int_add(i, 1)}), arith(hi), arith(hin, hi, hn))
      show by taut(bx, by, b)
    qed
    have e2 := mp(all_elim(ih, {int_div(x, 2)}, {int_div(y, 2)}), hx2, hy2, hb2)
    have b0 := mp(all_elim(hb, {0}), arith(), arith(hn))
    show by arith(xo, yo, e2, b0)
  qed
  show by induct(base, step)
qed

// a word with given bits exists (bit n added on top of one for n bits)
theorem bits_build_ex(j. p): all n. n in omega -> ex y. y in bits(n) && (all i. i in omega -> int_lt(i, n) -> (bit(y, i) <-> p(i)))
proof
  have none: all i. i in omega -> int_lt(i, 0) -> (bit(0, i) <-> p(i)) proof
    fix i
    assume hi hl
    have f: false by arith(hi, hl)
    show by taut(f)
  qed
  have z0: 0 in bits(0) by arith()
  have base: ex y. y in bits(0) && (all i. i in omega -> int_lt(i, 0) -> (bit(y, i) <-> p(i))) by ex_intro({0}, conj(z0, none))
  have step: all n. n in omega -> (ex y. y in bits(n) && (all i. i in omega -> int_lt(i, n) -> (bit(y, i) <-> p(i)))) ->
      (ex y. y in bits(int_add(n, 1)) && (all i. i in omega -> int_lt(i, int_add(n, 1)) -> (bit(y, i) <-> p(i)))) proof
    fix n
    assume hn ih
    obtain y, hy hb from ih
    have yo: y in omega by arith(hy, hn)
    have np := mp(pow2_pos[k := n], hn)
    have set: p(n) -> (ex z. z in bits(int_add(n, 1)) && (all i. i in omega -> int_lt(i, int_add(n, 1)) -> (bit(z, i) <-> p(i)))) proof
      assume pn
      let z := int_add(y, int_mul(pow2(n), 1))
      have zo: z in omega by arith(yo, hn)
      have hz: z in bits(int_add(n, 1)) by arith(hy, hn)
      have dq dr := mp(div_add_mul[x := y, m := pow2(n), y := 1], yo, arith(), np)
      have zb: all i. i in omega -> int_lt(i, int_add(n, 1)) -> (bit(z, i) <-> p(i)) proof
        fix i
        assume hi hin
        have below: int_lt(i, n) -> (bit(z, i) <-> p(i)) proof
          assume il
          have bm := mp(bit_mod[x := z, k := n, i := i], zo, hn, hi)
          have ym: int_mod(z, pow2(n)) = y by arith(dr, hy, hn, yo)
          have b := mp(all_elim(hb, {i}), hi, il)
          show by taut(rewrite(ym, bm), b, il)
        qed
        have top: i = n -> (bit(z, i) <-> p(i)) proof
          assume e
          have d1: int_div(z, pow2(n)) = 1 by arith(dq, hy, hn, yo)
          have bn: bit(z, n) by defs(arith(d1), bit)
          have t: bit(z, n) <-> p(n) by taut(bn, pn)
          show subst({w. bit(z, w) <-> p(w)}, sym(e), t)
        qed
        have c: int_lt(i, n) || i = n by arith(hi, hin, hn)
        show by taut(c, below, top)
      qed
      show by ex_intro({z}, conj(hz, zb))
    qed
    have clear: !p(n) -> (ex z. z in bits(int_add(n, 1)) && (all i. i in omega -> int_lt(i, int_add(n, 1)) -> (bit(z, i) <-> p(i)))) proof
      assume pn
      have hz: y in bits(int_add(n, 1)) by arith(hy, hn)
      have zb: all i. i in omega -> int_lt(i, int_add(n, 1)) -> (bit(y, i) <-> p(i)) proof
        fix i
        assume hi hin
        have below: int_lt(i, n) -> (bit(y, i) <-> p(i)) := mp(all_elim(hb, {i}), hi)
        have top: i = n -> (bit(y, i) <-> p(i)) proof
          assume e
          have nb := mp(bit_high[x := y, n := n, i := n], yo, hn, hn, arith(hy, hn), arith(hn))
          have t: bit(y, n) <-> p(n) by taut(nb, pn)
          show subst({w. bit(y, w) <-> p(w)}, sym(e), t)
        qed
        have c: int_lt(i, n) || i = n by arith(hi, hin, hn)
        show by taut(c, below, top)
      qed
      show by ex_intro({y}, conj(hz, zb))
    qed
    show by taut(set, clear)
  qed
  show by induct(base, step)
qed

// bits_build(n, p): the n-bit word with bits p
theorem bits_build_spec(n, j. p): n in omega -> bits_build(n, j. p(j)) in bits(n) && (all i. i in omega -> int_lt(i, n) -> (bit(bits_build(n, j. p(j)), i) <-> p(i)))
proof
  assume hn
  have e := mp(all_elim(bits_build_ex[p := j. p(j)], {n}), hn)
  have c := mp(choose_spec[p := y. y in bits(n) && (all i. i in omega -> int_lt(i, n) -> (bit(y, i) <-> p(i)))], e)
  show by defs(c, bits_build)
qed

// ----------------------------------------------------------------------
//  The operations bit by bit

theorem bit_and(n, x, y, i): n in omega -> i in omega -> int_lt(i, n) -> (bit(bits_and(n, x, y), i) <-> bit(x, i) && bit(y, i))
proof
  assume hn hi hl
  have _ b := mp(bits_build_spec[n := n, p := j. bit(x, j) && bit(y, j)], hn)
  show by defs(mp(all_elim(b, {i}), hi, hl), bits_and)
qed

theorem bit_or(n, x, y, i): n in omega -> i in omega -> int_lt(i, n) -> (bit(bits_or(n, x, y), i) <-> bit(x, i) || bit(y, i))
proof
  assume hn hi hl
  have _ b := mp(bits_build_spec[n := n, p := j. bit(x, j) || bit(y, j)], hn)
  show by defs(mp(all_elim(b, {i}), hi, hl), bits_or)
qed

theorem bit_xor(n, x, y, i): n in omega -> i in omega -> int_lt(i, n) -> (bit(bits_xor(n, x, y), i) <-> !(bit(x, i) <-> bit(y, i)))
proof
  assume hn hi hl
  have _ b := mp(bits_build_spec[n := n, p := j. !(bit(x, j) <-> bit(y, j))], hn)
  show by defs(mp(all_elim(b, {i}), hi, hl), bits_xor)
qed

theorem bit_not(n, x, i): n in omega -> i in omega -> int_lt(i, n) -> (bit(bits_not(n, x), i) <-> !bit(x, i))
proof
  assume hn hi hl
  have _ b := mp(bits_build_spec[n := n, p := j. !bit(x, j)], hn)
  show by defs(mp(all_elim(b, {i}), hi, hl), bits_not)
qed

// (each an n-bit word)
theorem bits_build_in(n, j. p): n in omega -> bits_build(n, j. p(j)) in bits(n)
proof
  assume hn
  have b _ := mp(bits_build_spec[n := n, p := j. p(j)], hn)
  show b
qed

// a slice set: bits lo..hi v's, the others x's
theorem bit_set_slice(n, x, hi, lo, v, i): n in omega -> i in omega -> int_lt(i, n) ->
  (bit(bits_set_slice(n, x, hi, lo, v), i) <-> (int_le(lo, i) && int_le(i, hi)) && bit(v, int_sub(i, lo)) || !(int_le(lo, i) && int_le(i, hi)) && bit(x, i))
proof
  assume hn hi hl
  have _ b := mp(bits_build_spec[n := n, p := j. ite(int_le(lo, j) && int_le(j, hi), bit(v, int_sub(j, lo)), bit(x, j))], hn)
  have e: bit(bits_set_slice(n, x, hi, lo, v), i) <-> ite(int_le(lo, i) && int_le(i, hi), bit(v, int_sub(i, lo)), bit(x, i)) by defs(mp(all_elim(b, {i}), hi, hl), bits_set_slice)
  have c1: (int_le(lo, i) && int_le(i, hi)) -> ite(int_le(lo, i) && int_le(i, hi), bit(v, int_sub(i, lo)), bit(x, i)) = bit(v, int_sub(i, lo)) proof
    assume c
    show mp(ite_t[c := int_le(lo, i) && int_le(i, hi), a := bit(v, int_sub(i, lo)), b := bit(x, i)], c)
  qed
  have c2: !(int_le(lo, i) && int_le(i, hi)) -> ite(int_le(lo, i) && int_le(i, hi), bit(v, int_sub(i, lo)), bit(x, i)) = bit(x, i) proof
    assume c
    show mp(ite_f[c := int_le(lo, i) && int_le(i, hi), a := bit(v, int_sub(i, lo)), b := bit(x, i)], c)
  qed
  have t1: (int_le(lo, i) && int_le(i, hi)) -> (bit(bits_set_slice(n, x, hi, lo, v), i) <-> bit(v, int_sub(i, lo))) proof
    assume c
    show rewrite(mp(c1, c), e)
  qed
  have t2: !(int_le(lo, i) && int_le(i, hi)) -> (bit(bits_set_slice(n, x, hi, lo, v), i) <-> bit(x, i)) proof
    assume c
    show rewrite(mp(c2, c), e)
  qed
  show by taut(t1, t2)
qed

// a word's product by 2^k: x's bits moved up by k, below n
theorem bit_bits_mul(n, x, k, i): n in omega -> x in omega -> k in omega -> i in omega ->
  (bit(bits_mul(n, x, pow2(k)), i) <-> int_lt(i, n) && int_le(k, i) && bit(x, int_sub(i, k)))
proof
  assume hn hx hk hi
  have kp := mp(pow2_pos[k := k], hk)
  have xn: int_mul(x, pow2(k)) in omega by arith(hx, kp)
  have m := mp(bit_mod[x := int_mul(x, pow2(k)), k := n, i := i], xn, hn, hi)
  have u := mp(bit_mul[x := x, k := k, i := i], hx, hk, hi)
  show by defs(taut(m, u), bits_mul)
qed

// a slice: x's bits from lo, hi - lo + 1 of them
theorem bit_slice(x, hi, lo, i): x in omega -> lo in omega -> int_sub(int_succ(hi), lo) in omega -> i in omega ->
  (bit(bits_slice(x, hi, lo), i) <-> int_lt(i, int_sub(int_succ(hi), lo)) && bit(x, int_add(lo, i)))
proof
  assume hx hl hm hi
  have pl := mp(pow2_pos[k := lo], hl)
  have dn _ := mp(div_nat[x := x, m := pow2(lo)], hx, pl)
  have m := mp(bit_mod[x := int_div(x, pow2(lo)), k := int_sub(int_succ(hi), lo), i := i], dn, hm, hi)
  have d := mp(bit_div[x := x, k := lo, i := i], hx, hl, hi)
  show by defs(taut(m, d), bits_slice)
qed

theorem bits_set_slice_in(n, x, hi, lo, v): n in omega -> bits_set_slice(n, x, hi, lo, v) in bits(n)
proof
  assume hn
  show by defs(mp(bits_build_in[n := n, p := j. ite(int_le(lo, j) && int_le(j, hi), bit(v, int_sub(j, lo)), bit(x, j))], hn), bits_set_slice)
qed

// ----------------------------------------------------------------------
//  Complement and negation

// 2^n - 1 - x: x's bits flipped
theorem bit_compl: all n. n in omega -> all x. x in bits(n) -> all i. i in omega -> int_lt(i, n) -> (bit(int_sub(int_sub(pow2(n), 1), x), i) <-> !bit(x, i))
proof
  have base: all x. x in bits(0) -> all i. i in omega -> int_lt(i, 0) -> (bit(int_sub(int_sub(pow2(0), 1), x), i) <-> !bit(x, i)) proof
    fix x
    assume hx
    fix i
    assume hi hl
    have f: false by arith(hi, hl)
    show by taut(f)
  qed
  have step: all n. n in omega -> (all x. x in bits(n) -> all i. i in omega -> int_lt(i, n) -> (bit(int_sub(int_sub(pow2(n), 1), x), i) <-> !bit(x, i))) ->
      (all x. x in bits(int_add(n, 1)) -> all i. i in omega -> int_lt(i, int_add(n, 1)) -> (bit(int_sub(int_sub(pow2(int_add(n, 1)), 1), x), i) <-> !bit(x, i))) proof
    fix n
    assume hn ih
    fix x
    assume hx
    fix i
    assume hi hin
    let C := int_sub(int_sub(pow2(int_add(n, 1)), 1), x)
    have xo: x in omega by arith(hx, hn)
    have co: C in omega by arith(hx, hn)
    have zero: i = 0 -> (bit(C, i) <-> !bit(x, i)) proof
      assume e
      have t: bit(C, 0) <-> !bit(x, 0) by arith(hx, hn)
      show subst({w. bit(C, w) <-> !bit(x, w)}, sym(e), t)
    qed
    have up: !(i = 0) -> (bit(C, i) <-> !bit(x, i)) proof
      assume ne
      let j := int_sub(i, 1)
      have hj: j in omega by arith(hi, ne)
      have hc: int_div(C, 2) = int_sub(int_sub(pow2(n), 1), int_div(x, 2)) by arith(hx, hn)
      have x2: int_div(x, 2) in bits(n) by arith(hx, hn)
      have ic := mp(all_elim(mp(all_elim(ih, {int_div(x, 2)}), x2), {j}), hj, arith(hin, hi, hn, ne))
      have bc := mp(bit_half[x := C, i := j], co, hj)
      have bx := mp(bit_half[x := x, i := j], xo, hj)
      have t: bit(C, int_add(j, 1)) <-> !bit(x, int_add(j, 1)) by taut(rewrite(hc, bc), bx, ic)
      have ej: int_add(j, 1) = i by arith(hi)
      show subst({w. bit(C, w) <-> !bit(x, w)}, ej, t)
    qed
    show by taut(zero, up)
  qed
  show by induct(base, step)
qed

// bits_not: the complement
theorem bits_not_compl(n, x): n in omega -> x in bits(n) -> bits_not(n, x) = int_sub(int_sub(pow2(n), 1), x)
proof
  assume hn hx
  have a := mp(bits_build_in[n := n, p := j. !bit(x, j)], hn)
  have a2: bits_not(n, x) in bits(n) by defs(a, bits_not)
  have b: int_sub(int_sub(pow2(n), 1), x) in bits(n) by arith(hx, hn)
  have same: all i. i in omega -> int_lt(i, n) -> (bit(bits_not(n, x), i) <-> bit(int_sub(int_sub(pow2(n), 1), x), i)) proof
    fix i
    assume hi hl
    have p := mp(bit_not[n := n, x := x, i := i], hn, hi, hl)
    have q := mp(all_elim(mp(all_elim(mp(all_elim(bit_compl, {n}), hn), {x}), hx), {i}), hi, hl)
    show by taut(p, q)
  qed
  show mp(all_elim(mp(all_elim(bits_ext, {n}), hn), {bits_not(n, x)}, {int_sub(int_sub(pow2(n), 1), x)}), a2, b, same)
qed

// -x mod m, 0 < x <= m: m - x
theorem neg_mod(x, m): x in omega -> int_lt(0, x) -> int_le(x, m) -> int_mod(int_neg(x), m) = int_sub(m, x)
proof
  assume hx hp hm
  let q := int_div(int_neg(x), m)
  have u2 := refl({int_mul(m, int_sub(int_sub(0, q), 2))})
  have u3 := refl({int_mul(m, int_add(q, 1))})
  have u4 := refl({int_mul(m, int_sub(int_sub(0, q), 1))})
  have u5 := refl({int_mul(m, q)})
  show by arith(hx, hp, hm, u2, u3, u4, u5)
qed

// (0 has no bits)
theorem bit_zero_none(j): j in omega -> !bit(0, j)
proof
  assume hj
  show by defs(arith(hj), bit)
qed

// x - 1, t x's lowest set bit: the bits below t set, bit t clear, the rest x's
theorem bit_pred(x, t, i): x in omega -> t in omega -> bit(x, t) -> (all j. j in omega -> int_lt(j, t) -> !bit(x, j)) -> i in omega ->
  (bit(int_sub(x, 1), i) <-> int_lt(i, t) || (int_lt(t, i) && bit(x, i)))
proof
  assume hx ht hb hz hi
  let P := pow2(t)
  let K := int_add(t, 1)
  let H := int_div(x, pow2(K))
  let D := int_sub(x, 1)
  have pt := mp(pow2_pos[k := t], ht)
  have hk: K in omega by arith(ht)
  have pk := mp(pow2_pos[k := K], hk)
  // x mod 2^t: no bits, so 0
  have mo: int_mod(x, P) in bits(t) by arith(hx, ht)
  have zo: 0 in bits(t) by arith(ht)
  have same: all j. j in omega -> int_lt(j, t) -> (bit(int_mod(x, P), j) <-> bit(0, j)) proof
    fix j
    assume hj hl
    have a := mp(bit_mod[x := x, k := t, i := j], hx, ht, hj)
    have b := mp(all_elim(hz, {j}), hj, hl)
    have c := mp(bit_zero_none[j := j], hj)
    show by taut(a, b, c)
  qed
  have lowz := mp(all_elim(mp(all_elim(bits_ext, {t}), ht), {int_mod(x, P)}, {0}), mo, zo, same)
  // x / 2^t odd: x = 2^(t+1) H + 2^t
  have odd: int_mod(int_div(x, P), 2) = 1 by defs(hb, bit)
  have dd _ := mp(div_div[x := x, a := P, b := 2], hx, pt, arith())
  have e2: int_mul(P, 2) = pow2(K) by arith(ht)
  have hh: int_div(int_div(x, P), 2) = H := rewrite(e2, dd)
  have ed: int_div(x, P) = int_add(int_mul(2, H), 1) by arith(hh, odd, hx, pt)
  have eu: x = int_add(int_mul(P, int_div(x, P)), int_mod(x, P)) by arith(hx, pt)
  have ex := rewrite(ed, eu)
  have hn _ := mp(div_nat[x := x, m := pow2(K)], hx, pk)
  have do: D in omega by arith(ex, lowz, hx, ht, hn, pt)
  have pm: int_sub(P, 1) in omega by arith(pt)
  have dq dr := mp(div_add_mul[x := int_sub(P, 1), m := pow2(K), y := H], pm, hn, pk)
  have eD: int_add(int_sub(P, 1), int_mul(pow2(K), H)) = D by arith(ex, lowz, ht)
  have DD: int_div(D, pow2(K)) = H by arith(rewrite(eD, dq), ht, pt)
  have DM: int_mod(D, pow2(K)) = int_sub(P, 1) by arith(rewrite(eD, dr), ht, pt)
  // below t + 1: the bits of 2^t - 1
  have low: int_lt(i, K) -> (bit(D, i) <-> int_lt(i, t) || (int_lt(t, i) && bit(x, i))) proof
    assume il
    have bm := rewrite(DM, mp(bit_mod[x := D, k := K, i := i], do, hk, hi))
    have e0: int_sub(int_sub(P, 1), 0) = int_sub(P, 1) by arith()
    have lt: int_lt(i, t) -> bit(int_sub(P, 1), i) proof
      assume it
      have c := mp(all_elim(mp(all_elim(mp(all_elim(bit_compl, {t}), ht), {0}), zo), {i}), hi, it)
      show by taut(rewrite(e0, c), mp(bit_zero_none[j := i], hi))
    qed
    have eq: i = t -> !bit(int_sub(P, 1), i) proof
      assume e
      have nb := mp(bit_high[x := int_sub(P, 1), n := t, i := t], pm, ht, ht, arith(pt), arith(ht))
      show subst({w. !bit(int_sub(P, 1), w)}, sym(e), nb)
    qed
    have c: int_lt(i, t) || i = t by arith(il, hi, ht)
    have nt: !int_lt(t, i) by arith(il, hi, ht)
    show by taut(bm, il, lt, eq, c, nt)
  qed
  // above t: x's bits
  have high: !int_lt(i, K) -> (bit(D, i) <-> int_lt(i, t) || (int_lt(t, i) && bit(x, i))) proof
    assume il
    let j := int_sub(i, K)
    have hj: j in omega by arith(il, hi, ht)
    have a := mp(bit_div[x := D, k := K, i := j], do, hk, hj)
    have b := mp(bit_div[x := x, k := K, i := j], hx, hk, hj)
    have ej: int_add(K, j) = i by arith(hi, ht)
    have t1: bit(D, int_add(K, j)) <-> bit(x, int_add(K, j)) by taut(rewrite(DD, a), b)
    have t2 := subst({w. bit(D, w) <-> bit(x, w)}, ej, t1)
    have c1: !int_lt(i, t) by arith(il, hi, ht)
    have c2: int_lt(t, i) by arith(il, hi, ht)
    show by taut(t2, c1, c2)
  qed
  show by taut(low, high)
qed

// -x mod 2^n, t x's lowest set bit: bit t set, the bits below clear, the rest x's flipped
theorem bit_neg(n, x, t, i): n in omega -> x in bits(n) -> t in omega -> bit(x, t) -> (all j. j in omega -> int_lt(j, t) -> !bit(x, j)) -> i in omega -> int_lt(i, n) ->
  (bit(bits_neg(n, x), i) <-> i = t || (int_lt(t, i) && !bit(x, i)))
proof
  assume hn hx ht hb hz hi hl
  have xo: x in omega by arith(hx, hn)
  have np := mp(pow2_pos[k := n], hn)
  // x > 0 (bit t set)
  have xp: int_lt(0, x) by arith(expand(hb, bit), xo, ht)
  have nm := mp(neg_mod[x := x, m := pow2(n)], xo, xp, arith(hx, hn))
  have en: bits_neg(n, x) = int_sub(int_sub(pow2(n), 1), int_sub(x, 1)) by defs(arith(nm), bits_neg)
  have d1: int_sub(x, 1) in bits(n) by arith(hx, hn, xp)
  have c := mp(all_elim(mp(all_elim(mp(all_elim(bit_compl, {n}), hn), {int_sub(x, 1)}), d1), {i}), hi, hl)
  have p := mp(bit_pred[x := x, t := t, i := i], xo, ht, hb, hz, hi)
  have o: int_lt(i, t) || i = t || int_lt(t, i) by arith(hi, ht)
  have o1: int_lt(i, t) -> !(i = t) && !int_lt(t, i) by arith(hi, ht)
  have o2: i = t -> !int_lt(t, i) by arith(hi, ht)
  show by taut(rewrite(sym(en), c), p, o, o1, o2)
qed

// ----------------------------------------------------------------------
//  Shifts

// x >> k (an n-bit x): x's bits from k
theorem bit_shr(n, x, k, i): n in omega -> x in bits(n) -> k in omega -> i in omega -> (bit(bits_shr(n, x, k), i) <-> bit(x, int_add(k, i)))
proof
  assume hn hx hk hi
  have xo: x in omega by arith(hx, hn)
  have m: int_mod(x, pow2(n)) = x by arith(hx, hn)
  have e: bits_shr(n, x, k) = int_div(x, pow2(k)) by defs(arith(m), bits_shr, bits_of_int)
  show rewrite(sym(e), mp(bit_div[x := x, k := k, i := i], xo, hk, hi))
qed

// x << k (n bits): x's bits moved up by k, those from n dropped
theorem bit_shl(n, x, k, i): n in omega -> x in omega -> k in omega -> i in omega ->
  (bit(bits_shl(n, x, k), i) <-> int_lt(i, n) && int_le(k, i) && bit(x, int_sub(i, k)))
proof
  assume hn hx hk hi
  have e: bits_shl(n, x, k) = int_mod(int_mul(x, pow2(k)), pow2(n)) by defs(refl({int_mod(int_mul(x, pow2(k)), pow2(n))}), bits_shl)
  have mo: int_mul(x, pow2(k)) in omega by arith(hx, hk)
  have a := mp(bit_mod[x := int_mul(x, pow2(k)), k := n, i := i], mo, hn, hi)
  have b := mp(bit_mul[x := x, k := k, i := i], hx, hk, hi)
  show by taut(rewrite(sym(e), a), b)
qed

// ----------------------------------------------------------------------
//  More bits: masks, words of an integer; equal indices

// (equal indices: the same bit)
theorem bit_cong(x, a, b): a = b -> (bit(x, a) <-> bit(x, b))
proof
  assume e
  show subst({w. bit(x, a) <-> bit(x, w)}, e, (bit(x, a) <-> bit(x, a) by taut()))
qed

// x * 2^k + r, r below 2^k: r's bits below k, x's from k on (a bitfield
// stored into a word whose bits there are clear)
theorem bit_addmul(x, k, r, i): x in omega -> k in omega -> r in omega -> int_lt(r, pow2(k)) -> i in omega ->
  (bit(int_add(int_mul(x, pow2(k)), r), i) <-> (int_lt(i, k) && bit(r, i)) || (int_le(k, i) && bit(x, int_sub(i, k))))
proof
  assume hx hk hr hrk hi
  let Y := int_add(int_mul(x, pow2(k)), r)
  have kp := mp(pow2_pos[k := k], hk)
  have yn: Y in omega by arith(hx, hk, hr)
  have dm dr := mp(div_add_mul[x := r, m := pow2(k), y := x], hr, hx, kp)
  have e0: int_add(r, int_mul(pow2(k), x)) = Y by arith()
  have rd: int_div(r, pow2(k)) = 0 && int_mod(r, pow2(k)) = r by arith(hr, hrk)
  have q: int_div(Y, pow2(k)) = x by arith(rewrite(e0, dm), rd, hx)
  have m: int_mod(Y, pow2(k)) = r by arith(rewrite(e0, dr), rd)
  have lo: int_lt(i, k) -> (bit(Y, i) <-> bit(r, i)) proof
    assume ik
    have b1 := mp(bit_mod[x := Y, k := k, i := i], yn, hk, hi)
    have b2 := rewrite(m, b1)
    show by taut(b2, ik)
  qed
  have up: int_le(k, i) -> (bit(Y, i) <-> bit(x, int_sub(i, k))) proof
    assume ki
    have hj: int_sub(i, k) in omega by arith(hk, hi, ki)
    have b1 := mp(bit_div[x := Y, k := k, i := int_sub(i, k)], yn, hk, hj)
    have b2 := rewrite(q, b1)
    have c := mp(bit_cong[x := Y, a := int_add(k, int_sub(i, k)), b := i], arith(hk, hi))
    show by taut(b2, c)
  qed
  have tr: int_lt(i, k) || int_le(k, i) by arith(hk, hi)
  have ex: !(int_lt(i, k) && int_le(k, i)) by arith()
  show by taut(lo, up, tr, ex)
qed

// a bit cleared: x - 2^k, bit k of x set
theorem bit_clear(x, k, i): x in omega -> k in omega -> i in omega -> bit(x, k) -> (bit(int_sub(x, pow2(k)), i) <-> !(i = k) && bit(x, i))
proof
  assume hx hk hi hb
  let P := pow2(k)
  let D := int_div(x, P)
  let r := int_mod(x, P)
  let E := int_div(D, 2)
  have pp := mp(pow2_pos[k := k], hk)
  have dn rn := apply(div_nat[x := x, m := P], hx, pp)
  have en _ := apply(div_nat[x := D, m := 2], dn, simp())
  have od: int_mod(D, 2) = 1 := expand(hb, bit)
  have p1: pow2(1) = 2 by defs(simp(), pow2)
  have xe: x = int_add(int_mul(D, P), r) by arith(hx, pp)
  have rl: int_lt(r, P) by arith(hx, pp)
  have de: D = int_add(int_mul(E, pow2(1)), 1) by arith(od, dn, p1)
  have d1n: int_sub(D, 1) in omega by arith(od, dn)
  have d1e: int_sub(D, 1) = int_add(int_mul(E, pow2(1)), 0) by arith(de)
  have xs: int_sub(x, P) = int_add(int_mul(int_sub(D, 1), P), r) by arith(xe)
  have b1 := apply(bit_addmul[x := int_sub(D, 1), k := k, r := r, i := i], d1n, hk, rn, rl, hi)
  have b2 := apply(bit_addmul[x := D, k := k, r := r, i := i], dn, hk, rn, rl, hi)
  // D odd: D - 1 the same but bit 0
  have odd: all j. j in omega -> (bit(int_sub(D, 1), j) <-> !(j = 0) && bit(D, j)) proof
    fix j
    assume hj
    have c1 := apply(bit_addmul[x := E, k := 1, r := 1, i := j], en, simp(), simp(), (int_lt(1, pow2(1)) by arith(p1)), hj)
    have c0 := apply(bit_addmul[x := E, k := 1, r := 0, i := j], en, simp(), simp(), (int_lt(0, pow2(1)) by arith(p1)), hj)
    have g1 := rewrite(sym(de), c1)
    have g0 := rewrite(sym(d1e), c0)
    have o1 := apply(bit_one, hj)
    have z := apply(bit_zero_none, hj)
    show by taut(g1, g0, o1, z, (int_lt(j, 1) <-> j = 0 by arith(hj)), (int_le(1, j) <-> !(j = 0) by arith(hj)))
  qed
  have ik: int_le(k, i) -> (bit(int_sub(D, 1), int_sub(i, k)) <-> !(i = k) && bit(D, int_sub(i, k))) proof
    assume l
    have o := mp(all_elim(odd, {int_sub(i, k)}), arith(l, hi, hk))
    show by taut(o, (int_sub(i, k) = 0 <-> i = k by arith(hi, hk)))
  qed
  show by taut(rewrite(sym(xs), b1), rewrite(sym(xe), b2), ik, (int_lt(i, k) -> !(i = k) by arith(hi, hk)), (int_lt(i, k) <-> !int_le(k, i) by arith(hi, hk)))
qed

// a word of an integer: its bits below n
theorem bit_of_int(n, x, i): n in omega -> x in omega -> i in omega -> (bit(bits_of_int(n, x), i) <-> int_lt(i, n) && bit(x, i))
proof
  assume hn hx hi
  have e: bits_of_int(n, x) = int_mod(x, pow2(n)) by defs(refl({int_mod(x, pow2(n))}), bits_of_int)
  show rewrite(sym(e), mp(bit_mod[x := x, k := n, i := i], hx, hn, hi))
qed

// 2^k - 1: the bits below k
theorem bit_mask(k, i): k in omega -> i in omega -> (bit(int_sub(pow2(k), 1), i) <-> int_lt(i, k))
proof
  assume hk hi
  have zo: 0 in bits(k) by arith(hk)
  have e0: int_sub(int_sub(pow2(k), 1), 0) = int_sub(pow2(k), 1) by arith()
  have lo: int_lt(i, k) -> bit(int_sub(pow2(k), 1), i) proof
    assume il
    have c := mp(all_elim(mp(all_elim(mp(all_elim(bit_compl, {k}), hk), {0}), zo), {i}), hi, il)
    show by taut(rewrite(e0, c), mp(bit_zero_none[j := i], hi))
  qed
  have hi2: !int_lt(i, k) -> !bit(int_sub(pow2(k), 1), i) proof
    assume il
    have pk := mp(pow2_pos[k := k], hk)
    show mp(bit_high[x := int_sub(pow2(k), 1), n := k, i := i], arith(pk), hk, hi, arith(pk), arith(il, hi, hk))
  qed
  show by taut(lo, hi2)
qed

// 0: no bits
theorem bit_zero(i): i in omega -> (bit(0, i) <-> false)
proof
  assume hi
  show by taut(mp(bit_zero_none[j := i], hi))
qed

// (the bitwise operations: n-bit words)
theorem bits_and_in(n, x, y): n in omega -> bits_and(n, x, y) in bits(n)
proof
  assume hn
  show by defs(mp(bits_build_in[n := n, p := j. bit(x, j) && bit(y, j)], hn), bits_and)
qed

theorem bits_or_in(n, x, y): n in omega -> bits_or(n, x, y) in bits(n)
proof
  assume hn
  show by defs(mp(bits_build_in[n := n, p := j. bit(x, j) || bit(y, j)], hn), bits_or)
qed

theorem bits_xor_in(n, x, y): n in omega -> bits_xor(n, x, y) in bits(n)
proof
  assume hn
  show by defs(mp(bits_build_in[n := n, p := j. !(bit(x, j) <-> bit(y, j))], hn), bits_xor)
qed

theorem bits_not_in(n, x): n in omega -> bits_not(n, x) in bits(n)
proof
  assume hn
  show by defs(mp(bits_build_in[n := n, p := j. !bit(x, j)], hn), bits_not)
qed

// ----------------------------------------------------------------------
//  The rules of `bitwise`: a word's bit i by its operation's

bit_rule bit_and
bit_rule bit_or
bit_rule bit_xor
bit_rule bit_not
bit_rule bit_shr
bit_rule bit_shl
bit_rule bit_of_int
bit_rule bit_div
bit_rule bit_mod
bit_rule bit_mul
bit_rule bit_addmul
bit_rule bit_mask
bit_rule bit_pow2
bit_rule bit_one
bit_rule bit_zero
bit_rule bit_set_slice
bit_rule bit_slice
bit_rule bit_bits_mul

// (an `and` with a word of fewer bits: the `and` of those bits -- a byte
// operation the machine does in 32 bits)
theorem bits_and_narrow(m, n, x, y): m in omega -> n in omega -> int_le(m, n) -> x in bits(m) -> bits_and(n, x, y) = bits_and(m, x, y)
proof
  assume hm hn hle hx
  have pl := mp(pow2_le[a := m, b := n], hm, hn, hle)
  have i1 := mp(bits_and_in[n := m, x := x, y := y], hm)
  have i2: bits_and(m, x, y) in bits(n) by arith(i1, pl, hn, hm)
  show by bitwise(hm, hn, hle, hx, i2)
qed

// ----------------------------------------------------------------------
//  The allocator's idioms

// x & -x: x's lowest set bit t
theorem lowest_bit(n, x, t): n in omega -> x in bits(n) -> t in omega -> int_lt(t, n) -> bit(x, t) -> (all j. j in omega -> int_lt(j, t) -> !bit(x, j)) ->
  bits_and(n, x, bits_neg(n, x)) = pow2(t)
proof
  assume hn hx ht hl hb hz
  have bn: all i. i in omega -> int_lt(i, n) -> (bit(bits_neg(n, x), i) <-> i = t || (int_lt(t, i) && !bit(x, i))) proof
    fix i
    assume hi hin
    show mp(bit_neg[n := n, x := x, t := t, i := i], hn, hx, ht, hb, hz, hi, hin)
  qed
  have pl := mp(pow2_le[a := int_add(t, 1), b := n], arith(ht), hn, arith(hl))
  have pb: pow2(t) in bits(n) by arith(ht, hn, pl)
  show by bitwise({n}, hn, hx, ht, hl, hb, hz, bn, pb)
qed

// smearing, one step: y's bits k - m + 1 .. k set and none above k (below
// n): those of y | y >> m from k - m2 + 1, m2 = 2m
theorem smear_step(n, y, k, m, m2): n in omega -> y in bits(n) -> k in omega -> int_lt(k, n) -> m in omega -> m2 = int_add(m, m) ->
  (all j. j in omega -> int_le(j, k) -> int_lt(k, int_add(j, m)) -> bit(y, j)) -> (all j. j in omega -> int_lt(k, j) -> int_lt(j, n) -> !bit(y, j)) ->
  (all j. j in omega -> int_le(j, k) -> int_lt(k, int_add(j, m2)) -> bit(bits_or(n, y, bits_shr(n, y, m)), j)) &&
  (all j. j in omega -> int_lt(k, j) -> int_lt(j, n) -> !bit(bits_or(n, y, bits_shr(n, y, m)), j))
proof
  assume hn hy hk hkn hm h2 hs hc
  have set: all j. j in omega -> int_le(j, k) -> int_lt(k, int_add(j, m2)) -> bit(bits_or(n, y, bits_shr(n, y, m)), j) proof
    fix j
    assume hj h1 h3
    show by bitwise(hn, hy, hk, hkn, hm, h2, hs, hc, hj, h1, h3)
  qed
  have clear: all j. j in omega -> int_lt(k, j) -> int_lt(j, n) -> !bit(bits_or(n, y, bits_shr(n, y, m)), j) proof
    fix j
    assume hj h1 h3
    show by bitwise(hn, hy, hk, hkn, hm, hs, hc, hj, h1, h3)
  qed
  show conj(set, clear)
qed

// all bits up to k set, none above (below n): 2^(k+1) - 1
theorem smear_done(n, y, k): n in omega -> y in bits(n) -> k in omega -> int_lt(k, n) ->
  (all j. j in omega -> int_le(j, k) -> bit(y, j)) -> (all j. j in omega -> int_lt(k, j) -> int_lt(j, n) -> !bit(y, j)) ->
  y = int_sub(pow2(int_add(k, 1)), 1)
proof
  assume hn hy hk hkn hs hc
  have pl := mp(pow2_le[a := int_add(k, 1), b := n], arith(hk), hn, arith(hkn))
  have mb: int_sub(pow2(int_add(k, 1)), 1) in bits(n) by arith(hk, hn, pl)
  show by bitwise({n}, hn, hy, hk, hkn, hs, hc, mb)
qed

// 2 << k (n bits, k + 1 < n): 2^(k+1)
theorem shl_two(n, k): n in omega -> k in omega -> int_lt(int_add(k, 1), n) -> bits_shl(n, 2, k) = pow2(int_add(k, 1))
proof
  assume hn hk hl
  have pl := mp(pow2_le[a := int_add(int_add(k, 1), 1), b := n], arith(hk), hn, arith(hl))
  have pb: pow2(int_add(k, 1)) in bits(n) by arith(hk, hn, pl)
  have sb: bits_shl(n, 2, k) in bits(n) by defs(arith(hn, hk), bits_shl)
  show by bitwise({n}, hn, hk, hl, pb, sb)
qed

// z of n bits, none at or above k: below 2^k
theorem bits_below(n, z, k): n in omega -> k in omega -> int_le(k, n) -> z in bits(n) ->
  (all i. i in omega -> int_le(k, i) -> int_lt(i, n) -> !bit(z, i)) -> int_lt(z, pow2(k))
proof
  assume hn hk kn hz hb
  have kp := mp(pow2_pos[k := k], hk)
  have pkn := mp(pow2_le[a := k, b := n], hk, hn, kn)
  have zo: z in omega by arith(hz)
  have mo _ := mp(div_nat[x := z, m := pow2(k)], zo, kp)
  have mb: int_mod(z, pow2(k)) in bits(n) by arith(mo, kp, pkn, zo)
  have same: all i. i in omega -> int_lt(i, n) -> (bit(z, i) <-> bit(int_mod(z, pow2(k)), i)) proof
    fix i
    assume hi hil
    have bm := mp(bit_mod[x := z, k := k, i := i], zo, hk, hi)
    have lo: int_lt(i, k) -> (bit(z, i) <-> bit(int_mod(z, pow2(k)), i)) by taut(bm)
    have up: !int_lt(i, k) -> (bit(z, i) <-> bit(int_mod(z, pow2(k)), i)) proof
      assume ik
      have nz := mp(all_elim(hb, {i}), hi, arith(ik, hi, hk), hil)
      show by taut(bm, nz, ik)
    qed
    show by taut(lo, up)
  qed
  have e := mp(all_elim(mp(all_elim(bits_ext, {n}), hn), {z}, {int_mod(z, pow2(k))}), hz, mb, same)
  show by arith(e, kp, zo)
qed

// x and y of n bits the same at and above k: their xor below 2^k, and
// conversely
theorem xor_block(n, x, y, k): n in omega -> k in omega -> int_le(k, n) -> x in bits(n) -> y in bits(n) ->
  (int_lt(bits_xor(n, x, y), pow2(k)) <-> int_div(x, pow2(k)) = int_div(y, pow2(k)))
proof
  assume hn hk kn hx hy
  have zb := mp(bits_xor_in[n := n, x := x, y := y], hn)
  have kp := mp(pow2_pos[k := k], hk)
  have pkn := mp(pow2_le[a := k, b := n], hk, hn, kn)
  have xo: x in omega by arith(hx)
  have yo: y in omega by arith(hy)
  have zo: bits_xor(n, x, y) in omega by arith(zb)
  have dxo _ := mp(div_nat[x := x, m := pow2(k)], xo, kp)
  have dyo _ := mp(div_nat[x := y, m := pow2(k)], yo, kp)
  // (x / 2^k <= x: (2^k - 1) * (x / 2^k) not negative)
  have k1: int_sub(pow2(k), 1) in omega by arith(kp)
  have qx: int_mul(int_sub(pow2(k), 1), int_div(x, pow2(k))) in omega by simp(k1, dxo)
  have qy: int_mul(int_sub(pow2(k), 1), int_div(y, pow2(k))) in omega by simp(k1, dyo)
  have dxb: int_div(x, pow2(k)) in bits(n) by arith(hx, kp, dxo, xo, qx)
  have dyb: int_div(y, pow2(k)) in bits(n) by arith(hy, kp, dyo, yo, qy)
  // (bit i of x / 2^k: x's bit k + i, none past n)
  have dbit: all i. i in omega -> int_lt(i, n) -> ((bit(int_div(x, pow2(k)), i) <-> bit(int_div(y, pow2(k)), i)) <->
      (int_lt(int_add(k, i), n) -> (bit(x, int_add(k, i)) <-> bit(y, int_add(k, i))))) proof
    fix i
    assume hi hil
    have bx := mp(bit_div[x := x, k := k, i := i], xo, hk, hi)
    have by_ := mp(bit_div[x := y, k := k, i := i], yo, hk, hi)
    have hx2 := mp(bit_high[x := x, n := n, i := int_add(k, i)], xo, hn, arith(hk, hi), arith(hx))
    have hy2 := mp(bit_high[x := y, n := n, i := int_add(k, i)], yo, hn, arith(hk, hi), arith(hy))
    have lo: int_lt(int_add(k, i), n) -> ((bit(int_div(x, pow2(k)), i) <-> bit(int_div(y, pow2(k)), i)) <->
        (int_lt(int_add(k, i), n) -> (bit(x, int_add(k, i)) <-> bit(y, int_add(k, i))))) by taut(bx, by_)
    have up: !int_lt(int_add(k, i), n) -> ((bit(int_div(x, pow2(k)), i) <-> bit(int_div(y, pow2(k)), i)) <->
        (int_lt(int_add(k, i), n) -> (bit(x, int_add(k, i)) <-> bit(y, int_add(k, i))))) proof
      assume h
      have nx := mp(hx2, arith(h, hk, hi, hn))
      have ny := mp(hy2, arith(h, hk, hi, hn))
      show by taut(bx, by_, nx, ny, h)
    qed
    show by taut(lo, up)
  qed
  have fwd: int_lt(bits_xor(n, x, y), pow2(k)) -> int_div(x, pow2(k)) = int_div(y, pow2(k)) proof
    assume zl
    have eq: all i. i in omega -> int_lt(i, n) -> (bit(int_div(x, pow2(k)), i) <-> bit(int_div(y, pow2(k)), i)) proof
      fix i
      assume hi hil
      have r: int_lt(int_add(k, i), n) -> (bit(x, int_add(k, i)) <-> bit(y, int_add(k, i))) proof
        assume l
        have zx := mp(bit_xor[n := n, x := x, y := y, i := int_add(k, i)], hn, arith(hk, hi), l)
        have nz := mp(bit_high[x := bits_xor(n, x, y), n := k, i := int_add(k, i)], zo, hk, arith(hk, hi), zl, arith(hi))
        show by taut(zx, nz)
      qed
      show by taut(mp(all_elim(dbit, {i}), hi, hil), r)
    qed
    show := mp(all_elim(mp(all_elim(bits_ext, {n}), hn), {int_div(x, pow2(k))}, {int_div(y, pow2(k))}), dxb, dyb, eq)
  qed
  have bwd: int_div(x, pow2(k)) = int_div(y, pow2(k)) -> int_lt(bits_xor(n, x, y), pow2(k)) proof
    assume e
    have hb: all i. i in omega -> int_le(k, i) -> int_lt(i, n) -> !bit(bits_xor(n, x, y), i) proof
      fix i
      assume hi ki hil
      let j := int_sub(i, k)
      have jo: j in omega by arith(hi, hk, ki)
      have ej: int_add(k, j) = i by arith(hk, hi)
      have d := mp(all_elim(dbit, {j}), jo, arith(jo, hil, hk))
      have s: bit(int_div(x, pow2(k)), j) <-> bit(int_div(y, pow2(k)), j) by simp(e)
      have dk: int_lt(int_add(k, j), n) -> (bit(x, int_add(k, j)) <-> bit(y, int_add(k, j))) by taut(d, s)
      have q := rewrite(ej, mp(dk, (int_lt(int_add(k, j), n) by arith(hil, ej))))
      have zx := mp(bit_xor[n := n, x := x, y := y, i := i], hn, hi, hil)
      show by taut(zx, q)
    qed
    show := mp(bits_below[n := n, z := bits_xor(n, x, y), k := k], hn, hk, kn, zb, hb)
  qed
  show by taut(fwd, bwd)
qed
