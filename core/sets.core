// Basic facts about the prelude's sets, pairs and functions.
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core

// ----------------------------------------------------------------------
//  if-then-else

theorem ite_t(c, a, b): c -> ite(c, a, b) = a
proof
  assume h
  have e: ex x. (c && x = a) || (!c && x = b) by ex_intro({a}, taut(h, refl({a})))
  show by defs(taut(h, witness(e)), ite)
qed

theorem ite_f(c, a, b): !c -> ite(c, a, b) = b
proof
  assume h
  have e: ex x. (c && x = a) || (!c && x = b) by ex_intro({b}, taut(h, refl({b})))
  show by defs(taut(h, witness(e)), ite)
qed

theorem ite_cong(c, a, b, e): (c -> a = b) -> ite(c, a, e) = ite(c, b, e)
proof
  assume h
  assume hc: c
  have x1 := trans(trans(mp(ite_t[c := c, a := a, b := e], hc), mp(h, hc)), sym(mp(ite_t[c := c, a := b, b := e], hc)))
  have g1 := discharge(x1, hc)
  assume hn: !c
  have x2 := trans(mp(ite_f[c := c, a := a, b := e], hn), sym(mp(ite_f[c := c, a := b, b := e], hn)))
  have g2 := discharge(x2, hn)
  show ite(c, a, e) = ite(c, b, e) by taut(g1, g2)
qed

// ----------------------------------------------------------------------
//  Images and functions

theorem image_sub(d, x. f, x. g, y): (all x. x in d -> f(x) = g(x)) -> y in set_image(d, x. f(x)) -> y in set_image(d, x. g(x))
proof
  assume h hy
  have e: ex x. x in d && f(x) = y by taut(set_image_def[s := d, f := x. f(x), y := y], hy)
  obtain x, hx from e
  have xd: x in d by taut(hx)
  have fy: f(x) = y by taut(hx)
  have gy := trans(sym(mp(all_elim(h, {x}), xd)), fy)
  have e2: ex z. z in d && g(z) = y by ex_intro({x}, taut(xd, gy))
  show y in set_image(d, x. g(x)) by taut(set_image_def[s := d, f := x. g(x), y := y], e2)
qed

theorem fn_build_ext(d, x. f, x. g): (all x. x in d -> f(x) = g(x)) -> fn_build(d, x. f(x)) = fn_build(d, x. g(x))
proof
  assume h
  fix x
  assume hx: x in d
  have fg := mp(all_elim(h, {x}), hx)
  have p1 := gen(discharge(subst({z. pair(x, f(x)) = pair(x, z)}, fg, refl({pair(x, f(x))})), hx), x)
  have p2 := gen(discharge(subst({z. pair(x, g(x)) = pair(x, z)}, sym(fg), refl({pair(x, g(x))})), hx), x)
  fix y
  have a1 := mp(image_sub[d := d, f := x. pair(x, f(x)), g := x. pair(x, g(x)), y := y], p1)
  have a2 := mp(image_sub[d := d, f := x. pair(x, g(x)), g := x. pair(x, f(x)), y := y], p2)
  have ie: y in set_image(d, x. pair(x, f(x))) <-> y in set_image(d, x. pair(x, g(x))) by taut(a1, a2)
  have eq := mp(set_ext[a := set_image(d, x. pair(x, f(x))), b := set_image(d, x. pair(x, g(x)))], gen(ie, y))
  show fn_build(d, x. f(x)) = fn_build(d, x. g(x)) by defs(eq, fn_build)
qed

// ----------------------------------------------------------------------
//  The empty set, unordered pairs

theorem empty_mem(x): !(x in empty)
proof
  show by defs(taut(set_select_def[s := false, p := y. false, z := x]), empty)
qed

theorem empty_ext(y): (all z. !(z in y)) -> y = empty
proof
  assume h
  fix z
  have ie: z in y <-> z in empty by taut(all_elim(h, {z}), empty_mem[x := z])
  show y = empty by mp(set_ext[a := y, b := empty], gen(ie, z))
qed

theorem empty_sub(a): subset(empty, a)
proof
  fix x
  have i: x in empty -> x in a by taut(empty_mem[x := x])
  show subset(empty, a) by defs(gen(i, x), subset)
qed

theorem p_empty(z): z in powerset(empty) -> z = empty
proof
  assume h
  have s: subset(z, empty) by taut(powerset_def[s := empty, a := z], h)
  have s2 := expand(s, subset)
  fix w
  have nw: !(w in z) by taut(all_elim(s2, {w}), empty_mem[x := w])
  show z = empty by mp(empty_ext[y := z], gen(nw, w))
qed

theorem e_in_pe: empty in powerset(empty)
proof
  show by taut(powerset_def[s := empty, a := empty], empty_sub[a := empty])
qed

theorem e_in_ppe: empty in powerset(powerset(empty))
proof
  show by taut(powerset_def[s := powerset(empty), a := empty], empty_sub[a := powerset(empty)])
qed

theorem pe_in_ppe: powerset(empty) in powerset(powerset(empty))
proof
  show by taut(powerset_def[s := powerset(empty), a := powerset(empty)], subset_refl[s := powerset(empty)])
qed

theorem pe_ne: !(powerset(empty) = empty)
proof
  assume h: powerset(empty) = empty
  have ff: false by taut(rewrite(h, e_in_pe), empty_mem[x := empty])
  show !(powerset(empty) = empty) by taut(discharge(ff, h))
qed

theorem pp_nonempty(x, y): x in powerset(powerset(empty)) -> y in x -> x = powerset(empty)
proof
  assume h hy
  have s: subset(x, powerset(empty)) by taut(powerset_def[s := powerset(empty), a := x], h)
  have s2 := expand(s, subset)
  have ye := mp(p_empty[z := y], mp(all_elim(s2, {y}), hy))
  have e0 := rewrite(ye, hy)
  fix w
  assume hw: w in powerset(empty)
  have w3 := discharge(rewrite(sym(mp(p_empty[z := w], hw)), e0), hw)
  have ie: w in x <-> w in powerset(empty) by taut(all_elim(s2, {w}), w3)
  show x = powerset(empty) by mp(set_ext[a := x, b := powerset(empty)], gen(ie, w))
qed

theorem pp_elems(x): x in powerset(powerset(empty)) -> x = empty || x = powerset(empty)
proof
  assume h
  fix y
  have c1 := mp(pp_nonempty[x := x, y := y], h)
  assume n: !(x = powerset(empty))
  have ny: !(y in x) by taut(c1, n)
  have ee := mp(empty_ext[y := x], gen(ny, y))
  show x = empty || x = powerset(empty) by taut(discharge(ee, n))
qed

theorem upair_elim(a, b, z): z in upair(a, b) -> z = a || z = b
proof
  assume hz
  have e: ex x. x in powerset(powerset(empty)) && ite(x = empty, a, b) = z
    by taut(set_image_def[s := powerset(powerset(empty)), f := x. ite(x = empty, a, b), y := z], expand(hz, upair))
  obtain x, hx from e
  have xin: x in powerset(powerset(empty)) by taut(hx)
  have iz: ite(x = empty, a, b) = z by taut(hx)
  have cases := mp(pp_elems[x := x], xin)
  assume c1: x = empty
  have g1 := discharge(trans(sym(iz), mp(ite_t[c := x = empty, a := a, b := b], c1)), c1)
  assume c2: x = powerset(empty)
  have nx := rewrite(sym(c2), pe_ne)
  have g2 := discharge(trans(sym(iz), mp(ite_f[c := x = empty, a := a, b := b], nx)), c2)
  show z = a || z = b by taut(cases, g1, g2)
qed

theorem upair_intro(a, b, z): z = a || z = b -> z in upair(a, b)
proof
  assume h
  assume c1: z = a
  have i1 := trans(mp(ite_t[c := empty = empty, a := a, b := b], refl({empty})), sym(c1))
  have e1: ex x. x in powerset(powerset(empty)) && ite(x = empty, a, b) = z by ex_intro({empty}, taut(e_in_ppe, i1))
  have g1 := discharge(e1, c1)
  assume c2: z = b
  have i2 := trans(mp(ite_f[c := powerset(empty) = empty, a := a, b := b], pe_ne), sym(c2))
  have e2: ex x. x in powerset(powerset(empty)) && ite(x = empty, a, b) = z by ex_intro({powerset(empty)}, taut(pe_in_ppe, i2))
  have g2 := discharge(e2, c2)
  have e: ex x. x in powerset(powerset(empty)) && ite(x = empty, a, b) = z by taut(h, g1, g2)
  show z in upair(a, b)
    by defs(taut(set_image_def[s := powerset(powerset(empty)), f := x. ite(x = empty, a, b), y := z], e), upair)
qed

theorem upair_l(a, b): a in upair(a, b)
proof
  have p: a = a || a = b by taut(refl({a}))
  show mp(upair_intro[a := a, b := b, z := a], p)
qed

theorem upair_r(a, b): b in upair(a, b)
proof
  have p: b = a || b = b by taut(refl({b}))
  show mp(upair_intro[a := a, b := b, z := b], p)
qed

theorem single_elim(a, z): z in single(a) -> z = a
proof
  assume h
  show z = a by taut(mp(upair_elim[a := a, b := a, z := z], expand(h, single)))
qed

theorem single_intro(a): a in single(a)
proof
  show a in single(a) by defs(upair_l[a := a, b := a], single)
qed

// ----------------------------------------------------------------------
//  Ordered pairs

theorem pair_fst(a, b, c, d): pair(a, b) = pair(c, d) -> a = c
proof
  assume h
  have s1: single(a) in pair(a, b) by defs(upair_l[a := single(a), b := upair(a, b)], pair)
  have s3 := mp(upair_elim[a := single(c), b := upair(c, d), z := single(a)], expand(rewrite(h, s1), pair))
  assume k1: single(a) = single(c)
  have g1 := discharge(mp(single_elim[a := c, z := a], rewrite(k1, single_intro[a := a])), k1)
  assume k2: single(a) = upair(c, d)
  have g2 := discharge(sym(mp(single_elim[a := a, z := c], rewrite(sym(k2), upair_l[a := c, b := d]))), k2)
  show a = c by taut(s3, g1, g2)
qed

// with equal first components
theorem pair_snd1(a, b, d): pair(a, b) = pair(a, d) -> b = d
proof
  assume h
  have t1: upair(a, b) in pair(a, b) by defs(upair_r[a := single(a), b := upair(a, b)], pair)
  have t3 := mp(upair_elim[a := single(a), b := upair(a, d), z := upair(a, b)], expand(rewrite(h, t1), pair))
  have u1: upair(a, d) in pair(a, d) by defs(upair_r[a := single(a), b := upair(a, d)], pair)
  have u3 := mp(upair_elim[a := single(a), b := upair(a, b), z := upair(a, d)], expand(rewrite(sym(h), u1), pair))
  // F1: upair(a, b) = upair(a, d) -> b = a || b = d
  assume f1: upair(a, b) = upair(a, d)
  have F1 := discharge(mp(upair_elim[a := a, b := d, z := b], rewrite(f1, upair_r[a := a, b := b])), f1)
  // F2: upair(a, b) = single(a) -> b = a
  assume f2: upair(a, b) = single(a)
  have F2 := discharge(mp(single_elim[a := a, z := b], rewrite(f2, upair_r[a := a, b := b])), f2)
  // F3: upair(a, d) = single(a) -> d = a
  assume f3: upair(a, d) = single(a)
  have F3 := discharge(mp(single_elim[a := a, z := d], rewrite(f3, upair_r[a := a, b := d])), f3)
  // F4: upair(a, d) = upair(a, b) -> d = a || d = b
  assume f4: upair(a, d) = upair(a, b)
  have F4 := discharge(mp(upair_elim[a := a, b := b, z := d], rewrite(f4, upair_r[a := a, b := d])), f4)
  // equalities
  assume ba: b = a
  assume da: d = a
  have T1 := discharge(discharge(trans(ba, sym(da)), da), ba)
  assume db: d = b
  have T2 := discharge(sym(db), db)
  show b = d by taut(t3, u3, F1, F2, F3, F4, T1, T2)
qed

theorem pair_inj(a, b, c, d): pair(a, b) = pair(c, d) -> a = c && b = d
proof
  assume h
  have ac := mp(pair_fst[a := a, b := b, c := c, d := d], h)
  have h2 := rewrite(sym(ac), h)
  have bd := mp(pair_snd1[a := a, b := b, d := d], h2)
  show a = c && b = d by taut(ac, bd)
qed

// ----------------------------------------------------------------------
//  Functions

theorem app_fn_build(d, x. v, a): a in d -> app(fn_build(d, x. v(x)), a) = v(a)
proof
  assume h
  have m0: ex x. x in d && pair(x, v(x)) = pair(a, v(a)) by ex_intro({a}, taut(h, refl({pair(a, v(a))})))
  have m: pair(a, v(a)) in set_image(d, x. pair(x, v(x)))
    by taut(set_image_def[s := d, f := x. pair(x, v(x)), y := pair(a, v(a))], m0)
  have e: ex y. pair(a, y) in set_image(d, x. pair(x, v(x))) by ex_intro({v(a)}, m)
  have w := witness(e)
  have e2: ex x. x in d && pair(x, v(x)) = pair(a, choose(y. pair(a, y) in set_image(d, x. pair(x, v(x)))))
    by taut(set_image_def[s := d, f := x. pair(x, v(x)), y := pair(a, choose(y. pair(a, y) in set_image(d, x. pair(x, v(x)))))], w)
  obtain x, hx from e2
  have pe: pair(x, v(x)) = pair(a, choose(y. pair(a, y) in set_image(d, x. pair(x, v(x))))) by taut(hx)
  have pi := mp(pair_inj[a := x, b := v(x), c := a, d := choose(y. pair(a, y) in set_image(d, x. pair(x, v(x))))], pe)
  have xa: x = a by taut(pi)
  have vc: v(x) = choose(y. pair(a, y) in set_image(d, x. pair(x, v(x)))) by taut(pi)
  have it := mp(ite_t[c := ex y. pair(a, y) in set_image(d, x. pair(x, v(x))), a := choose(y. pair(a, y) in set_image(d, x. pair(x, v(x)))), b := empty], e)
  show app(fn_build(d, x. v(x)), a) = v(a) by defs(trans(it, sym(rewrite(xa, vc))), app, fn_build)
qed

theorem fn_build_fun(d, x. v): is_fun(fn_build(d, x. v(x)))
proof
  have h1: all z. z in fn_build(d, x. v(x)) -> (ex a b. z = pair(a, b)) proof
    fix z
    assume hz
    have e: ex x. x in d && pair(x, v(x)) = z by taut(set_image_def[s := d, f := x. pair(x, v(x)), y := z], expand(hz, fn_build))
    obtain x, hx from e
    show by ex_intro({x}, ex_intro({v(x)}, simp(hx)))
  qed
  have h2: all a b c. pair(a, b) in fn_build(d, x. v(x)) -> pair(a, c) in fn_build(d, x. v(x)) -> b = c proof
    fix a b c
    assume hb hc
    have eb: ex x. x in d && pair(x, v(x)) = pair(a, b) by taut(set_image_def[s := d, f := x. pair(x, v(x)), y := pair(a, b)], expand(hb, fn_build))
    have ec: ex x. x in d && pair(x, v(x)) = pair(a, c) by taut(set_image_def[s := d, f := x. pair(x, v(x)), y := pair(a, c)], expand(hc, fn_build))
    obtain x, hx from eb
    obtain y, hy from ec
    have e1: x = y by simp(hx, hy)
    have e2: v(x) = v(y) by simp(e1)
    have eb2: v(x) = b by simp(hx)
    have ec2: v(y) = c by simp(hy)
    show := trans(sym(eb2), trans(e2, ec2))
  qed
  show by defs(taut(h1, h2), is_fun)
qed

theorem fn_build_dom(d, x. v): dom(fn_build(d, x. v(x))) = d
proof
  have iff: all z. z in dom(fn_build(d, x. v(x))) <-> z in d proof
    fix z
    have l: z in dom(fn_build(d, x. v(x))) -> z in d proof
      assume hz
      have e: ex w. w in fn_build(d, x. v(x)) && fst(w) = z by taut(set_image_def[s := fn_build(d, x. v(x)), f := w. fst(w), y := z], expand(hz, dom))
      obtain w, hw from e
      have e2: ex x. x in d && pair(x, v(x)) = w by taut(set_image_def[s := d, f := x. pair(x, v(x)), y := w], expand(hw, fn_build))
      obtain x, hx from e2
      have fw: fst(w) = z by taut(hw)
      have wp: w = pair(x, v(x)) by simp(hx)
      have xz: x = z by simp(rewrite(wp, fw))
      have xd: x in d by taut(hx)
      show := rewrite(xz, xd)
    qed
    have r: z in d -> z in dom(fn_build(d, x. v(x))) proof
      assume hz
      have e2: ex x. x in d && pair(x, v(x)) = pair(z, v(z)) by ex_intro({z}, simp(hz))
      have m: pair(z, v(z)) in fn_build(d, x. v(x)) by defs(taut(set_image_def[s := d, f := x. pair(x, v(x)), y := pair(z, v(z))], e2), fn_build)
      have e: ex w. w in fn_build(d, x. v(x)) && fst(w) = z by ex_intro({pair(z, v(z))}, simp(m))
      show by defs(taut(set_image_def[s := fn_build(d, x. v(x)), f := w. fst(w), y := z], e), dom)
    qed
    show by taut(l, r)
  qed
  show := mp(set_ext[a := dom(fn_build(d, x. v(x))), b := d], iff)
qed

// ----------------------------------------------------------------------
//  The naturals (omega, defined in the prelude as the members of univ(0)
//  in every inductive set): empty, succ, induction, in univ(1)

theorem omega_zero: empty in omega
proof
  have p: all s. empty in s -> (all k. k in s -> succ(k) in s) -> empty in s proof
    fix s
    assume h0 hs
    show := h0
  qed
  have m: empty in set_select(univ(0), n. all s. empty in s -> (all k. k in s -> succ(k) in s) -> n in s) by sel(taut(univ_empty[u := 0], p))
  show by defs(m, omega)
qed

theorem omega_succ(n): n in omega -> succ(n) in omega
proof
  assume h
  have un := unsel(expand(h, omega))
  have nu: n in univ(0) by taut(un)
  have ni: all s. empty in s -> (all k. k in s -> succ(k) in s) -> n in s by taut(un)
  have su: succ(n) in univ(0) by defs(simp(nu), succ)
  have p: all s. empty in s -> (all k. k in s -> succ(k) in s) -> succ(n) in s proof
    fix s
    assume h0 hs
    have ns: n in s := mp(all_elim(ni, {s}), h0, hs)
    show := mp(all_elim(hs, {n}), ns)
  qed
  have m: succ(n) in set_select(univ(0), x. all s. empty in s -> (all k. k in s -> succ(k) in s) -> x in s) by sel(taut(su, p))
  show by defs(m, omega)
qed

theorem omega_ind(s): empty in s -> (all n. n in s -> succ(n) in s) -> subset(omega, s)
proof
  assume h0 hs
  have p: all x. x in omega -> x in s proof
    fix x
    assume hx
    have ux: all t. empty in t -> (all k. k in t -> succ(k) in t) -> x in t by taut(unsel(expand(hx, omega)))
    show := mp(all_elim(ux, {s}), h0, hs)
  qed
  show by defs(p, subset)
qed

theorem omega_univ: omega in univ(1)
proof
  have ch: univ(0) in univ(1) by simp(mp(univ_chain[u := 0], lit({is_nat(0)})))
  have sub: all x. x in omega -> x in univ(0) proof
    fix x
    assume hx
    show by taut(unsel(expand(hx, omega)))
  qed
  have ss: subset(omega, univ(0)) by defs(sub, subset)
  show := mp(univ_subset[u := 1, a := omega, b := univ(0)], ch, ss)
qed
