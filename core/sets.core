// Basic facts about the prelude's sets, pairs and functions.
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core

// ----------------------------------------------------------------------
//  if-then-else

theorem ite_t(c, a, b): c -> ite(c, a, b) = a
proof
  assume h
  have e: ex x. (c && x = a) || (!c && x = b) by ex_intro({a}, taut(h, refl({a})))
  show by defs(taut(h, witness(e)), ite)
qed

theorem ite_f(c, a, b): !c -> ite(c, a, b) = b
proof
  assume h
  have e: ex x. (c && x = a) || (!c && x = b) by ex_intro({b}, taut(h, refl({b})))
  show by defs(taut(h, witness(e)), ite)
qed

// (rewrite rules of the proof language's simp)
simp ite_t
simp ite_f

// (a conditional of two members: a member)
theorem ite_in(c, a, b, t): a in t -> b in t -> ite(c, a, b) in t
proof
  assume ha hb
  have yes: c -> ite(c, a, b) in t proof
    assume hc
    show rewrite(sym(apply(ite_t[a := a, b := b], hc)), ha)
  qed
  have no: !c -> ite(c, a, b) in t proof
    assume hc
    show rewrite(sym(apply(ite_f[a := a, b := b], hc)), hb)
  qed
  show by taut(yes, no)
qed

theorem ite_cong(c, a, b, e): (c -> a = b) -> ite(c, a, e) = ite(c, b, e)
proof
  assume h
  assume hc: c
  have x1 := trans(trans(apply(ite_t[a := a, b := e], hc), mp(h, hc)), sym(mp(ite_t[c := c, a := b, b := e], hc)))
  have g1 := discharge(x1, hc)
  assume hn: !c
  have x2 := trans(apply(ite_f[a := a, b := e], hn), sym(mp(ite_f[c := c, a := b, b := e], hn)))
  have g2 := discharge(x2, hn)
  show ite(c, a, e) = ite(c, b, e) by taut(g1, g2)
qed

// ----------------------------------------------------------------------
//  Images and functions

theorem image_sub(d, x. f, x. g, y): (all x. x in d -> f(x) = g(x)) -> y in set_image(d, x. f(x)) -> y in set_image(d, x. g(x))
proof
  assume h hy
  have e: ex x. x in d && f(x) = y by taut(set_image_def[s := d, f := x. f(x), y := y], hy)
  obtain x, hx from e
  have xd: x in d by taut(hx)
  have fy: f(x) = y by taut(hx)
  have gy := trans(sym(apply(h, xd)), fy)
  have e2: ex z. z in d && g(z) = y by ex_intro({x}, taut(xd, gy))
  show y in set_image(d, x. g(x)) by taut(set_image_def[s := d, f := x. g(x), y := y], e2)
qed

theorem fn_build_ext(d, x. f, x. g): (all x. x in d -> f(x) = g(x)) -> fn_build(d, x. f(x)) = fn_build(d, x. g(x))
proof
  assume h
  fix x
  assume hx: x in d
  have fg := apply(h, hx)
  have p1 := gen(discharge(subst({z. pair(x, f(x)) = pair(x, z)}, fg, refl({pair(x, f(x))})), hx), x)
  have p2 := gen(discharge(subst({z. pair(x, g(x)) = pair(x, z)}, sym(fg), refl({pair(x, g(x))})), hx), x)
  fix y
  have a1 := apply(image_sub[y := y], p1)
  have a2 := apply(image_sub[y := y], p2)
  have ie: y in set_image(d, x. pair(x, f(x))) <-> y in set_image(d, x. pair(x, g(x))) by taut(a1, a2)
  have eq := apply(set_ext, gen(ie, y))
  show fn_build(d, x. f(x)) = fn_build(d, x. g(x)) by defs(eq, fn_build)
qed

// ----------------------------------------------------------------------
//  The empty set, unordered pairs

theorem empty_mem(x): !(x in empty)
proof
  show by defs(taut(set_select_def[s := false, p := y. false, z := x]), empty)
qed

theorem empty_ext(y): (all z. !(z in y)) -> y = empty
proof
  assume h
  fix z
  have ie: z in y <-> z in empty by taut(all_elim(h, {z}), empty_mem[x := z])
  show y = empty by apply(set_ext, gen(ie, z))
qed

theorem empty_sub(a): subset(empty, a)
proof
  fix x
  have i: x in empty -> x in a by taut(empty_mem[x := x])
  show subset(empty, a) by defs(gen(i, x), subset)
qed

theorem p_empty(z): z in powerset(empty) -> z = empty
proof
  assume h
  have s: subset(z, empty) by taut(powerset_def[s := empty, a := z], h)
  have s2 := expand(s, subset)
  fix w
  have nw: !(w in z) by taut(all_elim(s2, {w}), empty_mem[x := w])
  show z = empty by apply(empty_ext, gen(nw, w))
qed

theorem e_in_pe: empty in powerset(empty)
proof
  show by taut(powerset_def[s := empty, a := empty], empty_sub[a := empty])
qed

theorem e_in_ppe: empty in powerset(powerset(empty))
proof
  show by taut(powerset_def[s := powerset(empty), a := empty], empty_sub[a := powerset(empty)])
qed

theorem pe_in_ppe: powerset(empty) in powerset(powerset(empty))
proof
  show by taut(powerset_def[s := powerset(empty), a := powerset(empty)], subset_refl[s := powerset(empty)])
qed

theorem pe_ne: !(powerset(empty) = empty)
proof
  assume h: powerset(empty) = empty
  have ff: false by taut(rewrite(h, e_in_pe), empty_mem[x := empty])
  show !(powerset(empty) = empty) by taut(discharge(ff, h))
qed

theorem pp_nonempty(x, y): x in powerset(powerset(empty)) -> y in x -> x = powerset(empty)
proof
  assume h hy
  have s: subset(x, powerset(empty)) by taut(powerset_def[s := powerset(empty), a := x], h)
  have s2 := expand(s, subset)
  have ye := apply(p_empty, apply(s2, hy))
  have e0 := rewrite(ye, hy)
  fix w
  assume hw: w in powerset(empty)
  have w3 := discharge(rewrite(sym(apply(p_empty, hw)), e0), hw)
  have ie: w in x <-> w in powerset(empty) by taut(all_elim(s2, {w}), w3)
  show x = powerset(empty) by apply(set_ext, gen(ie, w))
qed

theorem pp_elems(x): x in powerset(powerset(empty)) -> x = empty || x = powerset(empty)
proof
  assume h
  fix y
  have c1 := apply(pp_nonempty[y := y], h)
  assume n: !(x = powerset(empty))
  have ny: !(y in x) by taut(c1, n)
  have ee := apply(empty_ext, gen(ny, y))
  show x = empty || x = powerset(empty) by taut(discharge(ee, n))
qed

theorem upair_elim(a, b, z): z in upair(a, b) -> z = a || z = b
proof
  assume hz
  have e: ex x. x in powerset(powerset(empty)) && ite(x = empty, a, b) = z
    by taut(set_image_def[s := powerset(powerset(empty)), f := x. ite(x = empty, a, b), y := z], expand(hz, upair))
  obtain x, hx from e
  have xin: x in powerset(powerset(empty)) by taut(hx)
  have iz: ite(x = empty, a, b) = z by taut(hx)
  have cases := apply(pp_elems, xin)
  assume c1: x = empty
  have g1 := discharge(trans(sym(iz), apply(ite_t[a := a, b := b], c1)), c1)
  assume c2: x = powerset(empty)
  have nx := rewrite(sym(c2), pe_ne)
  have g2 := discharge(trans(sym(iz), apply(ite_f[a := a, b := b], nx)), c2)
  show z = a || z = b by taut(cases, g1, g2)
qed

theorem upair_intro(a, b, z): z = a || z = b -> z in upair(a, b)
proof
  assume h
  assume c1: z = a
  have i1 := trans(apply(ite_t[a := a, b := b], refl({empty})), sym(c1))
  have e1: ex x. x in powerset(powerset(empty)) && ite(x = empty, a, b) = z by ex_intro({empty}, taut(e_in_ppe, i1))
  have g1 := discharge(e1, c1)
  assume c2: z = b
  have i2 := trans(apply(ite_f[a := a, b := b], pe_ne), sym(c2))
  have e2: ex x. x in powerset(powerset(empty)) && ite(x = empty, a, b) = z by ex_intro({powerset(empty)}, taut(pe_in_ppe, i2))
  have g2 := discharge(e2, c2)
  have e: ex x. x in powerset(powerset(empty)) && ite(x = empty, a, b) = z by taut(h, g1, g2)
  show z in upair(a, b)
    by defs(taut(set_image_def[s := powerset(powerset(empty)), f := x. ite(x = empty, a, b), y := z], e), upair)
qed

theorem upair_l(a, b): a in upair(a, b)
proof
  have p: a = a || a = b by taut(refl({a}))
  show apply(upair_intro, p)
qed

theorem upair_r(a, b): b in upair(a, b)
proof
  have p: b = a || b = b by taut(refl({b}))
  show apply(upair_intro, p)
qed

theorem single_elim(a, z): z in single(a) -> z = a
proof
  assume h
  show z = a by taut(apply(upair_elim, expand(h, single)))
qed

theorem single_intro(a): a in single(a)
proof
  show a in single(a) by defs(upair_l[a := a, b := a], single)
qed

// ----------------------------------------------------------------------
//  Ordered pairs

theorem pair_fst(a, b, c, d): pair(a, b) = pair(c, d) -> a = c
proof
  assume h
  have s1: single(a) in pair(a, b) by defs(upair_l[a := single(a), b := upair(a, b)], pair)
  have s3 := apply(upair_elim, expand(rewrite(h, s1), pair))
  assume k1: single(a) = single(c)
  have g1 := discharge(apply(single_elim, rewrite(k1, single_intro[a := a])), k1)
  assume k2: single(a) = upair(c, d)
  have g2 := discharge(sym(apply(single_elim, rewrite(sym(k2), upair_l[a := c, b := d]))), k2)
  show a = c by taut(s3, g1, g2)
qed

// with equal first components
theorem pair_snd1(a, b, d): pair(a, b) = pair(a, d) -> b = d
proof
  assume h
  have t1: upair(a, b) in pair(a, b) by defs(upair_r[a := single(a), b := upair(a, b)], pair)
  have t3 := apply(upair_elim, expand(rewrite(h, t1), pair))
  have u1: upair(a, d) in pair(a, d) by defs(upair_r[a := single(a), b := upair(a, d)], pair)
  have u3 := apply(upair_elim, expand(rewrite(sym(h), u1), pair))
  // F1: upair(a, b) = upair(a, d) -> b = a || b = d
  assume f1: upair(a, b) = upair(a, d)
  have F1 := discharge(apply(upair_elim, rewrite(f1, upair_r[a := a, b := b])), f1)
  // F2: upair(a, b) = single(a) -> b = a
  assume f2: upair(a, b) = single(a)
  have F2 := discharge(apply(single_elim, rewrite(f2, upair_r[a := a, b := b])), f2)
  // F3: upair(a, d) = single(a) -> d = a
  assume f3: upair(a, d) = single(a)
  have F3 := discharge(apply(single_elim, rewrite(f3, upair_r[a := a, b := d])), f3)
  // F4: upair(a, d) = upair(a, b) -> d = a || d = b
  assume f4: upair(a, d) = upair(a, b)
  have F4 := discharge(apply(upair_elim, rewrite(f4, upair_r[a := a, b := d])), f4)
  // equalities
  assume ba: b = a
  assume da: d = a
  have T1 := discharge(discharge(trans(ba, sym(da)), da), ba)
  assume db: d = b
  have T2 := discharge(sym(db), db)
  show b = d by taut(t3, u3, F1, F2, F3, F4, T1)
qed

theorem pair_inj(a, b, c, d): pair(a, b) = pair(c, d) -> a = c && b = d
proof
  assume h
  have ac := apply(pair_fst, h)
  have h2 := rewrite(sym(ac), h)
  have bd := apply(pair_snd1, h2)
  show a = c && b = d by taut(ac, bd)
qed

// ----------------------------------------------------------------------
//  Functions

theorem app_fn_build(d, x. v, a): a in d -> fn_build(d, x. v(x))[a] = v(a)
proof
  assume h
  have m0: ex x. x in d && pair(x, v(x)) = pair(a, v(a)) by ex_intro({a}, taut(h, refl({pair(a, v(a))})))
  have m: pair(a, v(a)) in set_image(d, x. pair(x, v(x)))
    by taut(set_image_def[s := d, f := x. pair(x, v(x)), y := pair(a, v(a))], m0)
  have e: ex y. pair(a, y) in set_image(d, x. pair(x, v(x))) by ex_intro({v(a)}, m)
  have w := witness(e)
  have e2: ex x. x in d && pair(x, v(x)) = pair(a, choose(y. pair(a, y) in set_image(d, x. pair(x, v(x)))))
    by taut(set_image_def[s := d, f := x. pair(x, v(x)), y := pair(a, choose(y. pair(a, y) in set_image(d, x. pair(x, v(x)))))], w)
  obtain x, hx from e2
  have pe: pair(x, v(x)) = pair(a, choose(y. pair(a, y) in set_image(d, x. pair(x, v(x))))) by taut(hx)
  have pi := apply(pair_inj, pe)
  have xa: x = a by taut(pi)
  have vc: v(x) = choose(y. pair(a, y) in set_image(d, x. pair(x, v(x)))) by taut(pi)
  have it := apply(ite_t[a := choose(y. pair(a, y) in set_image(d, x. pair(x, v(x)))), b := empty], e)
  show fn_build(d, x. v(x))[a] = v(a) by defs(trans(it, sym(rewrite(xa, vc))), app, fn_build)
qed

// a member of a built function's value: at an argument in its domain
// (outside it, the value is empty)
theorem in_app_fn_build(d, x. v, a, z): z in fn_build(d, x. v(x))[a] -> a in d && z in v(a)
proof
  assume hz
  have ne: !(ex y. pair(a, y) in set_image(d, x. pair(x, v(x)))) -> !(z in fn_build(d, x. v(x))[a]) proof
    assume hn
    have it := apply(ite_f[a := choose(y. pair(a, y) in set_image(d, x. pair(x, v(x)))), b := empty], hn)
    have e: fn_build(d, x. v(x))[a] = empty by defs(it, app, fn_build)
    show := rewrite(sym(e), empty_mem[x := z])
  qed
  have ey: ex y. pair(a, y) in set_image(d, x. pair(x, v(x))) by taut(ne, hz)
  obtain y, hy from ey
  have e2: ex x. x in d && pair(x, v(x)) = pair(a, y) by taut(set_image_def[s := d, f := x. pair(x, v(x)), y := pair(a, y)], hy)
  obtain x, hx from e2
  have pi := apply(pair_inj, hx.2)
  have ad: a in d := rewrite(pi.1, hx.1)
  have av := apply(app_fn_build[v := x. v(x)], ad)
  show by taut(ad, rewrite(av, hz))
qed

// a built function outside its domain: empty
theorem app_fn_build_out(d, x. v, a): !(a in d) -> fn_build(d, x. v(x))[a] = empty
proof
  assume hn
  have ne: !(ex y. pair(a, y) in set_image(d, x. pair(x, v(x)))) proof
    assume ey
    obtain y, hy from ey
    have e2: ex x. x in d && pair(x, v(x)) = pair(a, y) by taut(set_image_def[s := d, f := x. pair(x, v(x)), y := pair(a, y)], hy)
    obtain x, hx from e2
    have pi := apply(pair_inj, hx.2)
    have ad: a in d := rewrite(pi.1, hx.1)
    show by taut(ad, hn)
  qed
  have it := apply(ite_f[a := choose(y. pair(a, y) in set_image(d, x. pair(x, v(x)))), b := empty], ne)
  show by defs(it, app, fn_build)
qed

// ... a run of a function of programs (a spec): of its program at the
// arguments, which are in its domain
theorem runs_fn_build(d, x. v, a, s, o): runs(fn_build(d, x. v(x))[a], s, o) -> a in d && runs(v(a), s, o)
proof
  assume h
  have m := apply(in_app_fn_build, expand(h, runs))
  show by defs(m, runs)
qed

theorem fn_build_fun(d, x. v): is_fun(fn_build(d, x. v(x)))
proof
  have h1: all z. z in fn_build(d, x. v(x)) -> (ex a b. z = pair(a, b)) proof
    fix z
    assume hz
    have e: ex x. x in d && pair(x, v(x)) = z by taut(set_image_def[s := d, f := x. pair(x, v(x)), y := z], expand(hz, fn_build))
    obtain x, hx from e
    show by ex_intro({x}, ex_intro({v(x)}, symex(hx)))
  qed
  have h2: all a b c. pair(a, b) in fn_build(d, x. v(x)) -> pair(a, c) in fn_build(d, x. v(x)) -> b = c proof
    fix a b c
    assume hb hc
    have eb: ex x. x in d && pair(x, v(x)) = pair(a, b) by taut(set_image_def[s := d, f := x. pair(x, v(x)), y := pair(a, b)], expand(hb, fn_build))
    have ec: ex x. x in d && pair(x, v(x)) = pair(a, c) by taut(set_image_def[s := d, f := x. pair(x, v(x)), y := pair(a, c)], expand(hc, fn_build))
    obtain x, hx from eb
    obtain y, hy from ec
    have e1: x = y by symex(hx, hy)
    have e2: v(x) = v(y) by simp(e1)
    have eb2: v(x) = b by symex(hx)
    have ec2: v(y) = c by symex(hy)
    show := trans(sym(eb2), trans(e2, ec2))
  qed
  show by defs(taut(h1, h2), is_fun)
qed

theorem fn_build_dom(d, x. v): dom(fn_build(d, x. v(x))) = d
proof
  have iff: all z. z in dom(fn_build(d, x. v(x))) <-> z in d proof
    fix z
    have l: z in dom(fn_build(d, x. v(x))) -> z in d proof
      assume hz
      have e: ex w. w in fn_build(d, x. v(x)) && fst(w) = z by taut(set_image_def[s := fn_build(d, x. v(x)), f := w. fst(w), y := z], expand(hz, dom))
      obtain w, hw from e
      have e2: ex x. x in d && pair(x, v(x)) = w by taut(set_image_def[s := d, f := x. pair(x, v(x)), y := w], expand(hw, fn_build))
      obtain x, hx from e2
      have fw: fst(w) = z by taut(hw)
      have wp: w = pair(x, v(x)) by symex(hx)
      have xz: x = z by symex(rewrite(wp, fw))
      have xd: x in d by taut(hx)
      show := rewrite(xz, xd)
    qed
    have r: z in d -> z in dom(fn_build(d, x. v(x))) proof
      assume hz
      have e2: ex x. x in d && pair(x, v(x)) = pair(z, v(z)) by ex_intro({z}, simp())
      have m: pair(z, v(z)) in fn_build(d, x. v(x)) by defs(taut(set_image_def[s := d, f := x. pair(x, v(x)), y := pair(z, v(z))], e2), fn_build)
      have e: ex w. w in fn_build(d, x. v(x)) && fst(w) = z by ex_intro({pair(z, v(z))}, symex(m))
      show by defs(taut(set_image_def[s := fn_build(d, x. v(x)), f := w. fst(w), y := z], e), dom)
    qed
    show by taut(l, r)
  qed
  show := apply(set_ext, iff)
qed

// ----------------------------------------------------------------------
//  The naturals (omega, defined in the prelude as the members of univ(0)
//  in every inductive set): empty, succ, induction, in univ(1)

theorem omega_zero: empty in omega
proof
  have p: all s. empty in s -> (all k. k in s -> succ(k) in s) -> empty in s proof
    fix s
    assume h0 hs
    show := h0
  qed
  have m: empty in set_select(univ(0), n. all s. empty in s -> (all k. k in s -> succ(k) in s) -> n in s) by sel(taut(univ_empty[u := 0], p))
  show by defs(m, omega)
qed

theorem omega_succ(n): n in omega -> succ(n) in omega
proof
  assume h
  have un := unsel(expand(h, omega))
  have nu: n in univ(0) by taut(un)
  have ni: all s. empty in s -> (all k. k in s -> succ(k) in s) -> n in s by taut(un)
  have su: succ(n) in univ(0) by defs(symex(nu), succ)
  have p: all s. empty in s -> (all k. k in s -> succ(k) in s) -> succ(n) in s proof
    fix s
    assume h0 hs
    have ns: n in s := apply(ni, hs)
    show := apply(hs, ns)
  qed
  have m: succ(n) in set_select(univ(0), x. all s. empty in s -> (all k. k in s -> succ(k) in s) -> x in s) by sel(taut(su, p))
  show by defs(m, omega)
qed

theorem omega_ind(s): empty in s -> (all n. n in s -> succ(n) in s) -> subset(omega, s)
proof
  assume h0 hs
  have p: all x. x in omega -> x in s proof
    fix x
    assume hx
    have ux: all t. empty in t -> (all k. k in t -> succ(k) in t) -> x in t by taut(unsel(expand(hx, omega)))
    show := apply(ux, hs)
  qed
  show by defs(p, subset)
qed

// (a successor's elements: the number's and the number)
theorem succ_elim(n, j): j in succ(n) -> j in n || j = n
proof
  assume hj
  have h2 := expand(expand(hj, succ), union2)
  have u: ex y. j in y && y in upair(n, single(n)) by taut(h2, union_def[s := upair(n, single(n)), a := j])
  obtain y, hy from u
  have jy: j in y by taut(hy)
  have yu := mp(upair_elim[a := n, b := single(n), z := y], taut(hy))
  have c1: y = n -> j in n proof
    assume e1
    show := rewrite(e1, jy)
  qed
  have c2: y = single(n) -> j = n proof
    assume e2
    show := apply(single_elim, rewrite(e2, jy))
  qed
  show by taut(yu, c1, c2)
qed

theorem succ_self(n): n in succ(n)
proof
  have ex1: ex y. n in y && y in upair(n, single(n)) by ex_intro({single(n)}, taut(single_intro[a := n], upair_r[a := n, b := single(n)]))
  show by defs(taut(union_def[s := upair(n, single(n)), a := n], ex1), succ, union2)
qed

// induction by membership (the ordinals' induction, on omega): p(n) from p
// on n's elements. From omega's definition: the naturals all of whose
// elements have p form an inductive set.
theorem omega_mem_ind(x. p): (all n. n in omega -> (all m. m in n -> p(m)) -> p(n)) -> all n. n in omega -> p(n)
proof
  assume h
  have z: all m. m in empty -> p(m) proof
    fix m
    assume hm
    show by taut(hm, empty_mem[x := m])
  qed
  have e0: empty in set_select(omega, n. all m. m in n -> p(m)) by sel(taut(omega_zero, z))
  have st: all n. n in set_select(omega, n. all m. m in n -> p(m)) -> succ(n) in set_select(omega, n. all m. m in n -> p(m)) proof
    fix n
    assume hn
    have un := unsel(hn)
    have no: n in omega by taut(un)
    have bn: all m. m in n -> p(m) by taut(un)
    have pn := apply(h, bn)
    have bs: all m. m in succ(n) -> p(m) proof
      fix m
      assume hm
      have c1: m in n -> p(m) := all_elim(bn, {m})
      have c2: m = n -> p(m) proof
        assume e
        show := subst({y. p(y)}, sym(e), pn)
      qed
      show by taut(apply(succ_elim, hm), c1, c2)
    qed
    show by sel(taut(apply(omega_succ, no), bs))
  qed
  have sub := mp(apply(omega_ind, e0), st)
  fix n
  assume hn
  have bn: all m. m in n -> p(m) by taut(unsel(apply(expand(sub, subset), hn)))
  show := apply(h, bn)
qed

theorem omega_univ: omega in univ(1)
proof
  have ch: univ(0) in univ(1) by simp()
  have sub: all x. x in omega -> x in univ(0) proof
    fix x
    assume hx
    show by taut(unsel(expand(hx, omega)))
  qed
  have ss: subset(omega, univ(0)) by defs(sub, subset)
  show := apply(univ_subset, ch, ss)
qed

// ---------------------------------------------------------------------
//  Universe membership by a term's form (the rules of the proof
//  language's typing, docs/language.md): each a lemma, no search

// a natural, a bytes literal: in the least universe
theorem nat_univ0(n): n in omega -> n in univ(0)
proof
  assume hn
  show by taut(unsel(expand(hn, omega)))
qed

// a member of a universe is a member of the next
theorem univ_next(u, x): is_nat(u) -> x in univ(u) -> x in univ(lit_add(u, 1))
proof
  assume hu hx
  show := apply(univ_trans, apply(univ_chain, hu), hx)
qed

theorem pp_empty_univ(u): powerset(powerset(empty)) in univ(u)
proof
  show := apply(univ_powerset, mp(univ_powerset[u := u, s := empty], univ_empty[u := u]))
qed

theorem upair_univ(u, a, b): a in univ(u) -> b in univ(u) -> upair(a, b) in univ(u)
proof
  assume ha hb
  have each: all x. x in powerset(powerset(empty)) -> ite(x = empty, a, b) in univ(u) proof
    fix x
    assume hx
    show := apply(ite_in[c := x = empty], ha, hb)
  qed
  have im := apply(univ_image, each)
  show by defs(im, upair)
qed

theorem single_univ(u, a): a in univ(u) -> single(a) in univ(u)
proof
  assume ha
  show by defs(apply(upair_univ, ha, ha), single)
qed

theorem pair_univ(u, a, b): a in univ(u) -> b in univ(u) -> pair(a, b) in univ(u)
proof
  assume ha hb
  have s := apply(single_univ, ha)
  have p := apply(upair_univ, ha, hb)
  show by defs(apply(upair_univ, s, p), pair)
qed

// (a pair's first component: in its universe, by transitivity)
theorem pair_univ_fst(u, a, b): pair(a, b) in univ(u) -> a in univ(u)
proof
  assume hp
  have s: single(a) in pair(a, b) by defs(upair_l[a := single(a), b := upair(a, b)], pair)
  have su := apply(univ_trans, hp, s)
  show := apply(univ_trans, su, single_intro[a := a])
qed

// a program's run starts in univ(1) (a program a set_select of univ(1))
theorem runs_univ(s o. r, x, y): runs(mkprog(s o. r(s, o)), x, y) -> x in univ(1)
proof
  assume h
  have m := expand(expand(h, runs), mkprog)
  have p: pair(x, y) in univ(1) by taut(m, set_select_def[s := univ(1), p := z. ex s o. z = pair(s, o) && r(s, o), z := pair(x, y)])
  show := apply(pair_univ_fst, p)
qed

// a run of a program: its relation, the state and outcome values
theorem runs_intro(s o. r, x, y): pair(x, y) in univ(1) -> r(x, y) -> runs(mkprog(s o. r(s, o)), x, y)
proof
  assume hu hr
  have e: ex s o. pair(x, y) = pair(s, o) && r(s, o) by ex_intro({x}, {y}, taut(refl({pair(x, y)}), hr))
  show by defs(taut(hu, e, set_select_def[s := univ(1), p := z. ex s o. z = pair(s, o) && r(s, o), z := pair(x, y)]), runs, mkprog)
qed

theorem select_univ(u, s, x. p): s in univ(u) -> set_select(s, x. p(x)) in univ(u)
proof
  assume hs
  have sub: all z. z in set_select(s, x. p(x)) -> z in s proof
    fix z
    assume hz
    show by taut(unsel(hz))
  qed
  have ss: subset(set_select(s, x. p(x)), s) by defs(sub, subset)
  show := apply(univ_subset, hs, ss)
qed
