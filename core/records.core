// Functions and records: `app`, `fn_update`, and records extended by
// ghost fields (`rec_and`). Program states are such records.
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/records.core

// ----------------------------------------------------------------------
//  Unions and products

theorem union2_iff(a, b, z): z in union2(a, b) <-> z in a || z in b
proof
  have u := union_def[s := upair(a, b), a := z]
  have to: z in union2(a, b) -> z in a || z in b proof
    assume h: z in union2(a, b)
    have e: ex y. z in y && y in upair(a, b) by taut(u, expand(h, union2))
    obtain y, hy from e
    have zy: z in y by taut(hy)
    have yu: y in upair(a, b) by taut(hy)
    have c := mp(upair_elim[a := a, b := b, z := y], yu)
    have ca: y = a -> z in a proof
      assume e: y = a
      show by taut(rewrite(e, zy))
    qed
    have cb: y = b -> z in b proof
      assume e: y = b
      show by taut(rewrite(e, zy))
    qed
    show by taut(c, ca, cb)
  qed
  have from: z in a || z in b -> z in union2(a, b) proof
    assume h: z in a || z in b
    have ina: z in a -> z in union2(a, b) proof
      assume ha: z in a
      have e: ex y. z in y && y in upair(a, b) by ex_intro({a}, taut(ha, upair_l[a := a, b := b]))
      show by defs(taut(u, e), union2)
    qed
    have inb: z in b -> z in union2(a, b) proof
      assume hb: z in b
      have e: ex y. z in y && y in upair(a, b) by ex_intro({b}, taut(hb, upair_r[a := a, b := b]))
      show by defs(taut(u, e), union2)
    qed
    show by taut(h, ina, inb)
  qed
  show by taut(to, from)
qed

theorem insert_l(a, s): a in insert(a, s)
proof
  show by defs(taut(union2_iff[a := single(a), b := s, z := a], single_intro[a := a]), insert)
qed

theorem insert_elim(a, s, z): z in insert(a, s) -> z = a || z in s
proof
  assume h: z in insert(a, s)
  show by taut(union2_iff[a := single(a), b := s, z := z], single_elim[a := a, z := z], expand(h, insert))
qed

theorem cart_elim(a, b, z): z in cart(a, b) -> ex x y. x in a && y in b && z = pair(x, y)
proof
  assume h: z in cart(a, b)
  have e1: ex Y. z in Y && Y in set_image(a, x. set_image(b, y. pair(x, y)))
    by taut(union_def[s := set_image(a, x. set_image(b, y. pair(x, y))), a := z], expand(h, cart))
  obtain Y, hY from e1
  have e2: ex x. x in a && set_image(b, y. pair(x, y)) = Y
    by taut(set_image_def[s := a, f := x. set_image(b, y. pair(x, y)), y := Y], hY)
  obtain x, hx from e2
  have zY: z in Y by taut(hY)
  have xY: set_image(b, y. pair(x, y)) = Y by taut(hx)
  have zi := rewrite(sym(xY), zY)
  have e3: ex y. y in b && pair(x, y) = z by taut(set_image_def[s := b, f := y. pair(x, y), y := z], zi)
  obtain y, hy from e3
  have pz: pair(x, y) = z by taut(hy)
  show by ex_intro({x}, {y}, taut(hx, hy, sym(pz)))
qed

theorem cart_intro(a, b, x, y): x in a -> y in b -> pair(x, y) in cart(a, b)
proof
  assume hx: x in a
  assume hy: y in b
  have e1: ex y0. y0 in b && pair(x, y0) = pair(x, y) by ex_intro({y}, taut(hy, refl({pair(x, y)})))
  have m1: pair(x, y) in set_image(b, y. pair(x, y)) by taut(set_image_def[s := b, f := y. pair(x, y), y := pair(x, y)], e1)
  have e2: ex x0. x0 in a && set_image(b, y. pair(x0, y)) = set_image(b, y. pair(x, y))
    by ex_intro({x}, taut(hx, refl({set_image(b, y. pair(x, y))})))
  have m2: set_image(b, y. pair(x, y)) in set_image(a, x. set_image(b, y. pair(x, y)))
    by taut(set_image_def[s := a, f := x. set_image(b, y. pair(x, y)), y := set_image(b, y. pair(x, y))], e2)
  have e3: ex Y. pair(x, y) in Y && Y in set_image(a, x. set_image(b, y. pair(x, y)))
    by ex_intro({set_image(b, y. pair(x, y))}, taut(m1, m2))
  show by defs(taut(union_def[s := set_image(a, x. set_image(b, y. pair(x, y))), a := pair(x, y)], e3), cart)
qed

// an exceptional outcome from a state of type s
theorem exc_outcome_type(s, v, x, e): x in s -> e in univ(1) -> exc(x, e) in outcome_type(s, v)
proof
  assume hx: x in s
  assume he: e in univ(1)
  have c := mp(mp(cart_intro[a := s, b := univ(1), x := x, y := e], hx), he)
  have w: ex z. z in cart(s, univ(1)) && exc(fst(z), snd(z)) = exc(x, e) by ex_intro({pair(x, e)}, simp(c))
  show by defs(taut(set_image_def[s := cart(s, univ(1)), f := z. exc(fst(z), snd(z)), y := exc(x, e)], w, union2_iff[a := set_image(cart(s, v), z. ok(fst(z), snd(z))), b := union2(set_image(cart(s, univ(1)), z. exc(fst(z), snd(z))), set_image(univ(1), t. diverge(t))), z := exc(x, e)], union2_iff[a := set_image(cart(s, univ(1)), z. exc(fst(z), snd(z))), b := set_image(univ(1), t. diverge(t)), z := exc(x, e)]), outcome_type)
qed

// a state with ghost fields: a record and its ghost part
theorem rec_and_elim(a, b, s): s in rec_and(a, b) -> ex x y. x in a && y in b && s = union2(x, y)
proof
  assume h: s in rec_and(a, b)
  have e1: ex z. z in cart(a, b) && union2(fst(z), snd(z)) = s
    by taut(set_image_def[s := cart(a, b), f := z. union2(fst(z), snd(z)), y := s], expand(h, rec_and))
  obtain z, hz from e1
  have zc: z in cart(a, b) by taut(hz)
  have us: union2(fst(z), snd(z)) = s by taut(hz)
  obtain x, hx from mp(cart_elim[a := a, b := b, z := z], zc)
  obtain y, hy from hx
  have zp: z = pair(x, y) by taut(hy)
  have fx: fst(pair(x, y)) = x by simp()
  have sy: snd(pair(x, y)) = y by simp()
  have us2 := rewrite(sy, rewrite(fx, rewrite(zp, us)))
  show by ex_intro({x}, {y}, taut(hy, sym(us2)))
qed

// ----------------------------------------------------------------------
//  Functions

theorem fun_app(f, k, v): is_fun(f) -> pair(k, v) in f -> app(f, k) = v
proof
  assume hf: is_fun(f)
  assume h: pair(k, v) in f
  have e: ex y. pair(k, y) in f by ex_intro({v}, h)
  have hc := mp(choose_spec[p := y. pair(k, y) in f], e)
  have uniq: all a b c. pair(a, b) in f -> pair(a, c) in f -> b = c by taut(expand(hf, is_fun))
  have eq := mp(mp(all_elim(all_elim(all_elim(uniq, {k}), {choose(y. pair(k, y) in f)}), {v}), hc), h)
  have it := mp(ite_t[c := ex y. pair(k, y) in f, a := choose(y. pair(k, y) in f), b := empty], e)
  show by defs(trans(it, eq), app)
qed

theorem dom_intro(f, k, v): pair(k, v) in f -> k in dom(f)
proof
  assume h: pair(k, v) in f
  have fk: fst(pair(k, v)) = k by simp()
  have e: ex z. z in f && fst(z) = k by ex_intro({pair(k, v)}, taut(h, fk))
  show by defs(taut(set_image_def[s := f, f := z. fst(z), y := k], e), dom)
qed

theorem dom_elim(f, k): is_fun(f) -> k in dom(f) -> pair(k, app(f, k)) in f
proof
  assume hf: is_fun(f)
  assume h: k in dom(f)
  have e: ex z. z in f && fst(z) = k by taut(set_image_def[s := f, f := z. fst(z), y := k], expand(h, dom))
  obtain z, hz from e
  have zf: z in f by taut(hz)
  have pairs: all z. z in f -> (ex a b. z = pair(a, b)) by taut(expand(hf, is_fun))
  obtain a, ha from mp(all_elim(pairs, {z}), zf)
  obtain b, hb from ha
  have fz: fst(z) = k by taut(hz)
  have fa: fst(pair(a, b)) = a by simp()
  have ak: a = k by taut(trans(sym(fa), rewrite(hb, fz)))
  have kb := rewrite(ak, rewrite(hb, zf))
  have ap := mp(mp(fun_app[f := f, k := k, v := b], hf), kb)
  show by taut(rewrite(sym(ap), kb))
qed

// the elements of `fn_update(f, k, v)`
theorem fn_update_iff(f, k, v, z): z in fn_update(f, k, v) <-> (z in f && fst(z) != k) || z = pair(k, v)
proof
  have u := union2_iff[a := set_select(f, z. fst(z) != k), b := single(pair(k, v)), z := z]
  have sd := set_select_def[s := f, p := z. fst(z) != k, z := z]
  have s1 := single_elim[a := pair(k, v), z := z]
  have s2: z = pair(k, v) -> z in single(pair(k, v))
    by defs(taut(upair_intro[a := pair(k, v), b := pair(k, v), z := z]), single)
  show by defs(taut(u, sd, s1, s2), fn_update)
qed

// functions with the same pairs at x have the same value there
theorem app_ext(f, g, x): (all y. pair(x, y) in f <-> pair(x, y) in g) -> app(f, x) = app(g, x)
proof
  assume iff: all y. pair(x, y) in f <-> pair(x, y) in g
  have ce := mp(choose_ext[p := y. pair(x, y) in f, q := y. pair(x, y) in g], iff)
  have e12: (ex y. pair(x, y) in f) -> (ex y. pair(x, y) in g) proof
    assume e: ex y. pair(x, y) in f
    obtain y, hy from e
    show by ex_intro({y}, taut(all_elim(iff, {y}), hy))
  qed
  have e21: (ex y. pair(x, y) in g) -> (ex y. pair(x, y) in f) proof
    assume e: ex y. pair(x, y) in g
    obtain y, hy from e
    show by ex_intro({y}, taut(all_elim(iff, {y}), hy))
  qed
  have h1: (ex y. pair(x, y) in g) -> app(f, x) = app(g, x) proof
    assume e2: ex y. pair(x, y) in g
    have a1 := mp(ite_t[c := ex y. pair(x, y) in f, a := choose(y. pair(x, y) in f), b := empty], mp(e21, e2))
    have a2 := mp(ite_t[c := ex y. pair(x, y) in g, a := choose(y. pair(x, y) in g), b := empty], e2)
    show by defs(trans(trans(a1, ce), sym(a2)), app)
  qed
  have h2: !(ex y. pair(x, y) in g) -> app(f, x) = app(g, x) proof
    assume n2: !(ex y. pair(x, y) in g)
    have n1: !(ex y. pair(x, y) in f) by taut(e12, n2)
    have b1 := mp(ite_f[c := ex y. pair(x, y) in f, a := choose(y. pair(x, y) in f), b := empty], n1)
    have b2 := mp(ite_f[c := ex y. pair(x, y) in g, a := choose(y. pair(x, y) in g), b := empty], n2)
    show by defs(trans(b1, sym(b2)), app)
  qed
  show by taut(h1, h2)
qed

// an update at k leaves the value at another key
theorem app_update_other(f, k, v, x): !(x = k) -> app(fn_update(f, k, v), x) = app(f, x)
proof
  assume h: !(x = k)
  have iff: all y. pair(x, y) in fn_update(f, k, v) <-> pair(x, y) in f proof
    fix y
    have u := fn_update_iff[f := f, k := k, v := v, z := pair(x, y)]
    have pf: pair(x, y) = pair(k, v) -> false proof
      assume e: pair(x, y) = pair(k, v)
      show by taut(mp(pair_fst[a := x, b := y, c := k, d := v], e), h)
    qed
    have u2 := expand(simp(u), ne)
    show by taut(u2, h, pf)
  qed
  show by mp(app_ext[f := fn_update(f, k, v), g := f, x := x], iff)
qed

// in `f`, a pair with first element `k` is `pair(k, app(f, k))`
theorem fun_pair(f, k, z): is_fun(f) -> z in f -> fst(z) = k -> z = pair(k, app(f, k))
proof
  assume hf: is_fun(f)
  assume zf: z in f
  assume fz: fst(z) = k
  have pairs: all z. z in f -> (ex a b. z = pair(a, b)) by taut(expand(hf, is_fun))
  obtain a, ha from mp(all_elim(pairs, {z}), zf)
  obtain b, hb from ha
  have fa: fst(pair(a, b)) = a by simp()
  have ak: a = k by taut(trans(sym(fa), rewrite(hb, fz)))
  have zk := rewrite(ak, hb)
  have ap := mp(mp(fun_app[f := f, k := k, v := b], hf), rewrite(zk, zf))
  show by taut(rewrite(sym(ap), zk))
qed

// updating a field with its own value changes nothing
theorem fn_update_same(f, k): is_fun(f) -> k in dom(f) -> fn_update(f, k, app(f, k)) = f
proof
  assume hf: is_fun(f)
  assume hk: k in dom(f)
  have pk := mp(mp(dom_elim[f := f, k := k], hf), hk)
  have all_z: all z. z in fn_update(f, k, app(f, k)) <-> z in f proof
    fix z
    have m := fn_update_iff[f := f, k := k, v := app(f, k), z := z]
    have back: z = pair(k, app(f, k)) -> z in f proof
      assume e: z = pair(k, app(f, k))
      show by taut(rewrite(sym(e), pk))
    qed
    have fwd: z in f -> fst(z) = k -> z = pair(k, app(f, k)) proof
      assume zf: z in f
      assume fz: fst(z) = k
      show by taut(mp(mp(mp(fun_pair[f := f, k := k, z := z], hf), zf), fz))
    qed
    show by taut(m, back, fwd, expand(m, ne))
  qed
  show by taut(mp(set_ext[a := fn_update(f, k, app(f, k)), b := f], all_z))
qed

// ----------------------------------------------------------------------
//  Records with ghost fields: `union2(w, g)`, a field k of w (not of g)

theorem app_union2_l(w, g, k): is_fun(w) -> k in dom(w) -> !(k in dom(g)) -> app(union2(w, g), k) = app(w, k)
proof
  assume hw: is_fun(w)
  assume hk: k in dom(w)
  assume hg: !(k in dom(g))
  have same: all y. pair(k, y) in union2(w, g) <-> pair(k, y) in w proof
    fix y
    have u := union2_iff[a := w, b := g, z := pair(k, y)]
    have ng := dom_intro[f := g, k := k, v := y]
    show by taut(u, ng, hg)
  qed
  show by mp(app_ext[f := union2(w, g), g := w, x := k], same)
qed

theorem fn_update_union(w, g, k):
  is_fun(w) -> k in dom(w) -> !(k in dom(g)) -> fn_update(union2(w, g), k, app(w, k)) = union2(w, g)
proof
  assume hw: is_fun(w)
  assume hk: k in dom(w)
  assume hg: !(k in dom(g))
  have ws := mp(mp(fn_update_same[f := w, k := k], hw), hk)
  have all_z: all z. z in fn_update(union2(w, g), k, app(w, k)) <-> z in union2(w, g) proof
    fix z
    have m := fn_update_iff[f := union2(w, g), k := k, v := app(w, k), z := z]
    // the elements of w, as those of its update (which is w)
    have mw := rewrite(ws, fn_update_iff[f := w, k := k, v := app(w, k), z := z])
    have u := union2_iff[a := w, b := g, z := z]
    // a pair of g does not have k first
    have gk: z in g -> fst(z) != k proof
      assume zg: z in g
      have ne: fst(z) = k -> false proof
        assume fz: fst(z) = k
        have e: ex x. x in g && fst(x) = k by ex_intro({z}, taut(zg, fz))
        have kg: k in dom(g) by defs(taut(set_image_def[s := g, f := x. fst(x), y := k], e), dom)
        show by taut(hg, kg)
      qed
      show by defs(taut(ne), ne)
    qed
    show by taut(m, mw, u, gk)
  qed
  show by taut(mp(set_ext[a := fn_update(union2(w, g), k, app(w, k)), b := union2(w, g)], all_z))
qed

// ----------------------------------------------------------------------
//  Built functions

// a function is the function built from its values on its domain
theorem fn_eta(f, d): is_fun(f) -> dom(f) = d -> fn_build(d, x. app(f, x)) = f
proof
  assume hf: is_fun(f)
  assume hd: dom(f) = d
  have all_z: all z. z in fn_build(d, x. app(f, x)) <-> z in f proof
    fix z
    have zb := set_image_def[s := d, f := x. pair(x, app(f, x)), y := z]
    have to: z in fn_build(d, x. app(f, x)) -> z in f proof
      assume h: z in fn_build(d, x. app(f, x))
      have e: ex x. x in d && pair(x, app(f, x)) = z by taut(zb, expand(h, fn_build))
      obtain x, hx from e
      have xd: x in d by taut(hx)
      have pz: pair(x, app(f, x)) = z by taut(hx)
      have xf := mp(mp(dom_elim[f := f, k := x], hf), rewrite(sym(hd), xd))
      show by taut(rewrite(pz, xf))
    qed
    have from: z in f -> z in fn_build(d, x. app(f, x)) proof
      assume h: z in f
      have pairs: all z. z in f -> (ex a b. z = pair(a, b)) by taut(expand(hf, is_fun))
      obtain p, hp from mp(all_elim(pairs, {z}), h)
      obtain q, hq from hp
      have fp: fst(pair(p, q)) = p by simp()
      have fz: fst(z) = p by taut(rewrite(sym(hq), fp))
      have zp := mp(mp(mp(fun_pair[f := f, k := p, z := z], hf), h), fz)
      have pd := dom_intro[f := f, k := p, v := app(f, p)]
      have pin: pair(p, app(f, p)) in f by taut(rewrite(zp, h))
      have pdd: p in d by taut(rewrite(hd, mp(pd, pin)))
      have e: ex x. x in d && pair(x, app(f, x)) = z by ex_intro({p}, taut(pdd, sym(zp)))
      show by defs(taut(zb, e), fn_build)
    qed
    show by taut(to, from)
  qed
  show by taut(mp(set_ext[a := fn_build(d, x. app(f, x)), b := f], all_z))
qed

// updating a built function at k (in its domain) builds the function that
// has the new value at k and agrees elsewhere
theorem fn_update_build(d, x. f, x. g, k, w):
  k in d -> g(k) = w -> (all x. x in d -> !(x = k) -> g(x) = f(x)) ->
  fn_update(fn_build(d, x. f(x)), k, w) = fn_build(d, x. g(x))
proof
  assume hk: k in d
  assume hw: g(k) = w
  assume hg: all x. x in d -> !(x = k) -> g(x) = f(x)
  have all_z: all z. z in fn_update(fn_build(d, x. f(x)), k, w) <-> z in fn_build(d, x. g(x)) proof
    fix z
    have m := fn_update_iff[f := fn_build(d, x. f(x)), k := k, v := w, z := z]
    have zf := set_image_def[s := d, f := x. pair(x, f(x)), y := z]
    have zg := set_image_def[s := d, f := x. pair(x, g(x)), y := z]
    // left to right
    have to: z in fn_update(fn_build(d, x. f(x)), k, w) -> z in fn_build(d, x. g(x)) proof
      assume h: z in fn_update(fn_build(d, x. f(x)), k, w)
      have c1: (z in fn_build(d, x. f(x)) && fst(z) != k) -> z in fn_build(d, x. g(x)) proof
        assume hc: z in fn_build(d, x. f(x)) && fst(z) != k
        have zi: z in fn_build(d, x. f(x)) by taut(hc)
        have e: ex x. x in d && pair(x, f(x)) = z by taut(zf, expand(zi, fn_build))
        obtain x, hx from e
        have xd: x in d by taut(hx)
        have pz: pair(x, f(x)) = z by taut(hx)
        have fx: fst(pair(x, f(x))) = x by simp()
        have nk0: x = k -> false proof
          assume xk: x = k
          show by taut(expand(hc, ne), rewrite(xk, rewrite(pz, fx)))
        qed
        have nk: !(x = k) by taut(nk0)
        have gx := mp(mp(all_elim(hg, {x}), xd), nk)
        have pg: pair(x, g(x)) = z by taut(rewrite(sym(gx), pz))
        have eg: ex y. y in d && pair(y, g(y)) = z by ex_intro({x}, taut(xd, pg))
        show by defs(taut(zg, eg), fn_build)
      qed
      have c2: z = pair(k, w) -> z in fn_build(d, x. g(x)) proof
        assume e: z = pair(k, w)
        have pk: pair(k, g(k)) = z by taut(rewrite(sym(hw), sym(e)))
        have eg: ex y. y in d && pair(y, g(y)) = z by ex_intro({k}, taut(hk, pk))
        show by defs(taut(zg, eg), fn_build)
      qed
      show by taut(m, h, c1, c2)
    qed
    // right to left
    have from: z in fn_build(d, x. g(x)) -> z in fn_update(fn_build(d, x. f(x)), k, w) proof
      assume h: z in fn_build(d, x. g(x))
      have e: ex y. y in d && pair(y, g(y)) = z by taut(zg, expand(h, fn_build))
      obtain x, hx from e
      have xd: x in d by taut(hx)
      have pz: pair(x, g(x)) = z by taut(hx)
      have fx: fst(pair(x, g(x))) = x by simp()
      have isk: x = k -> z = pair(k, w) proof
        assume xk: x = k
        show by taut(sym(rewrite(hw, rewrite(xk, pz))))
      qed
      have notk: !(x = k) -> z in fn_build(d, x. f(x)) && fst(z) != k proof
        assume nk: !(x = k)
        have gx := mp(mp(all_elim(hg, {x}), xd), nk)
        have pf: pair(x, f(x)) = z by taut(rewrite(gx, pz))
        have ef: ex y. y in d && pair(y, f(y)) = z by ex_intro({x}, taut(xd, pf))
        have zin: z in fn_build(d, x. f(x)) by defs(taut(zf, ef), fn_build)
        have fz: fst(z) = x by taut(rewrite(pz, fx))
        have ne0: fst(z) != k by defs(taut(rewrite(sym(fz), nk)), ne)
        show by taut(zin, ne0)
      qed
      show by taut(m, isk, notk)
    qed
    show by taut(to, from)
  qed
  show by taut(mp(set_ext[a := fn_update(fn_build(d, x. f(x)), k, w), b := fn_build(d, x. g(x))], all_z))
qed
