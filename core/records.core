// Functions and records: `app`, `fn_update`, and records extended by
// ghost fields (`rec_and`). Program states are such records.
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/records.core

// ----------------------------------------------------------------------
//  Unions and products

theorem union2_iff(a, b, z): z in union2(a, b) <-> z in a || z in b
proof
  have u := union_def[s := upair(a, b), a := z]
  have to: z in union2(a, b) -> z in a || z in b proof
    assume h
    have e: ex y. z in y && y in upair(a, b) by taut(u, expand(h, union2))
    obtain y, hy from e
    have zy: z in y by taut(hy)
    have yu: y in upair(a, b) by taut(hy)
    have c := mp(upair_elim[a := a, b := b, z := y], yu)
    have ca: y = a -> z in a proof
      assume e
      show by taut(rewrite(e, zy))
    qed
    have cb: y = b -> z in b proof
      assume e
      show by taut(rewrite(e, zy))
    qed
    show by taut(c, ca, cb)
  qed
  have from: z in a || z in b -> z in union2(a, b) proof
    assume h
    have ina: z in a -> z in union2(a, b) proof
      assume ha
      have e: ex y. z in y && y in upair(a, b) by ex_intro({a}, taut(ha, upair_l[a := a, b := b]))
      show by defs(taut(u, e), union2)
    qed
    have inb: z in b -> z in union2(a, b) proof
      assume hb
      have e: ex y. z in y && y in upair(a, b) by ex_intro({b}, taut(hb, upair_r[a := a, b := b]))
      show by defs(taut(u, e), union2)
    qed
    show by taut(h, ina, inb)
  qed
  show by taut(to, from)
qed

theorem insert_l(a, s): a in insert(a, s)
proof
  show by defs(taut(union2_iff[a := single(a), b := s, z := a], single_intro[a := a]), insert)
qed

theorem insert_elim(a, s, z): z in insert(a, s) -> z = a || z in s
proof
  assume h
  show by taut(union2_iff[a := single(a), b := s, z := z], single_elim[a := a, z := z], expand(h, insert))
qed

theorem cart_elim(a, b, z): z in cart(a, b) -> ex x y. x in a && y in b && z = pair(x, y)
proof
  assume h
  have e1: ex Y. z in Y && Y in set_image(a, x. set_image(b, y. pair(x, y)))
    by taut(union_def[s := set_image(a, x. set_image(b, y. pair(x, y))), a := z], expand(h, cart))
  obtain Y, hY from e1
  have e2: ex x. x in a && set_image(b, y. pair(x, y)) = Y
    by taut(set_image_def[s := a, f := x. set_image(b, y. pair(x, y)), y := Y], hY)
  obtain x, hx from e2
  have zY: z in Y by taut(hY)
  have xY: set_image(b, y. pair(x, y)) = Y by taut(hx)
  have zi := rewrite(sym(xY), zY)
  have e3: ex y. y in b && pair(x, y) = z by taut(set_image_def[s := b, f := y. pair(x, y), y := z], zi)
  obtain y, hy from e3
  have pz: pair(x, y) = z by taut(hy)
  show by ex_intro({x}, {y}, taut(hx, hy, sym(pz)))
qed

theorem cart_intro(a, b, x, y): x in a -> y in b -> pair(x, y) in cart(a, b)
proof
  assume hx hy
  have e1: ex y0. y0 in b && pair(x, y0) = pair(x, y) by ex_intro({y}, taut(hy, refl({pair(x, y)})))
  have m1: pair(x, y) in set_image(b, y. pair(x, y)) by taut(set_image_def[s := b, f := y. pair(x, y), y := pair(x, y)], e1)
  have e2: ex x0. x0 in a && set_image(b, y. pair(x0, y)) = set_image(b, y. pair(x, y))
    by ex_intro({x}, taut(hx, refl({set_image(b, y. pair(x, y))})))
  have m2: set_image(b, y. pair(x, y)) in set_image(a, x. set_image(b, y. pair(x, y)))
    by taut(set_image_def[s := a, f := x. set_image(b, y. pair(x, y)), y := set_image(b, y. pair(x, y))], e2)
  have e3: ex Y. pair(x, y) in Y && Y in set_image(a, x. set_image(b, y. pair(x, y)))
    by ex_intro({set_image(b, y. pair(x, y))}, taut(m1, m2))
  show by defs(taut(union_def[s := set_image(a, x. set_image(b, y. pair(x, y))), a := pair(x, y)], e3), cart)
qed

// an exceptional outcome from a state of type s
theorem exc_outcome_type(s, v, x, e): x in s -> e in univ(1) -> exc(x, e) in outcome_type(s, v)
proof
  assume hx he
  have c := mp(mp(cart_intro[a := s, b := univ(1), x := x, y := e], hx), he)
  have w: ex z. z in cart(s, univ(1)) && exc(fst(z), snd(z)) = exc(x, e) by ex_intro({pair(x, e)}, simp(c))
  show by defs(taut(set_image_def[s := cart(s, univ(1)), f := z. exc(fst(z), snd(z)), y := exc(x, e)], w, union2_iff[a := set_image(cart(s, v), z. ok(fst(z), snd(z))), b := union2(set_image(cart(s, univ(1)), z. exc(fst(z), snd(z))), set_image(univ(1), t. diverge(t))), z := exc(x, e)], union2_iff[a := set_image(cart(s, univ(1)), z. exc(fst(z), snd(z))), b := set_image(univ(1), t. diverge(t)), z := exc(x, e)]), outcome_type)
qed

// a state with ghost fields: a record and its ghost part
theorem rec_and_elim(a, b, s): s in rec_and(a, b) -> ex x y. x in a && y in b && s = union2(x, y)
proof
  assume h
  have e1: ex z. z in cart(a, b) && union2(fst(z), snd(z)) = s
    by taut(set_image_def[s := cart(a, b), f := z. union2(fst(z), snd(z)), y := s], expand(h, rec_and))
  obtain z, hz from e1
  have zc: z in cart(a, b) by taut(hz)
  have us: union2(fst(z), snd(z)) = s by taut(hz)
  obtain x, hx from mp(cart_elim[a := a, b := b, z := z], zc)
  obtain y, hy from hx
  have zp: z = pair(x, y) by taut(hy)
  have fx: fst(pair(x, y)) = x by simp()
  have sy: snd(pair(x, y)) = y by simp()
  have us2 := rewrite(sy, rewrite(fx, rewrite(zp, us)))
  show by ex_intro({x}, {y}, taut(hy, sym(us2)))
qed

// ----------------------------------------------------------------------
//  Functions

theorem fun_app(f, k, v): is_fun(f) -> pair(k, v) in f -> app(f, k) = v
proof
  assume hf h
  have e: ex y. pair(k, y) in f by ex_intro({v}, h)
  have hc := mp(choose_spec[p := y. pair(k, y) in f], e)
  have uniq: all a b c. pair(a, b) in f -> pair(a, c) in f -> b = c by taut(expand(hf, is_fun))
  have eq := mp(mp(all_elim(all_elim(all_elim(uniq, {k}), {choose(y. pair(k, y) in f)}), {v}), hc), h)
  have it := mp(ite_t[c := ex y. pair(k, y) in f, a := choose(y. pair(k, y) in f), b := empty], e)
  show by defs(trans(it, eq), app)
qed

theorem dom_intro(f, k, v): pair(k, v) in f -> k in dom(f)
proof
  assume h
  have fk: fst(pair(k, v)) = k by simp()
  have e: ex z. z in f && fst(z) = k by ex_intro({pair(k, v)}, taut(h, fk))
  show by defs(taut(set_image_def[s := f, f := z. fst(z), y := k], e), dom)
qed

theorem dom_elim(f, k): is_fun(f) -> k in dom(f) -> pair(k, app(f, k)) in f
proof
  assume hf h
  have e: ex z. z in f && fst(z) = k by taut(set_image_def[s := f, f := z. fst(z), y := k], expand(h, dom))
  obtain z, hz from e
  have zf: z in f by taut(hz)
  have pairs: all z. z in f -> (ex a b. z = pair(a, b)) by taut(expand(hf, is_fun))
  obtain a, ha from mp(all_elim(pairs, {z}), zf)
  obtain b, hb from ha
  have fz: fst(z) = k by taut(hz)
  have fa: fst(pair(a, b)) = a by simp()
  have ak: a = k by taut(trans(sym(fa), rewrite(hb, fz)))
  have kb := rewrite(ak, rewrite(hb, zf))
  have ap := mp(mp(fun_app[f := f, k := k, v := b], hf), kb)
  show by taut(rewrite(sym(ap), kb))
qed

// the elements of `fn_update(f, k, v)`
theorem fn_update_iff(f, k, v, z): z in fn_update(f, k, v) <-> (z in f && fst(z) != k) || z = pair(k, v)
proof
  have u := union2_iff[a := set_select(f, z. fst(z) != k), b := single(pair(k, v)), z := z]
  have sd := set_select_def[s := f, p := z. fst(z) != k, z := z]
  have s1 := single_elim[a := pair(k, v), z := z]
  have s2: z = pair(k, v) -> z in single(pair(k, v))
    by defs(taut(upair_intro[a := pair(k, v), b := pair(k, v), z := z]), single)
  show by defs(taut(u, sd, s1, s2), fn_update)
qed

// an update overwritten by another of the same key
theorem fn_update_twice(f, k, a, b): fn_update(fn_update(f, k, a), k, b) = fn_update(f, k, b)
proof
  have g: all z. z in fn_update(fn_update(f, k, a), k, b) <-> z in fn_update(f, k, b) proof
    fix z
    have u1 := fn_update_iff[f := fn_update(f, k, a), k := k, v := b, z := z]
    have u2 := fn_update_iff[f := f, k := k, v := a, z := z]
    have u3 := fn_update_iff[f := f, k := k, v := b, z := z]
    have pk: z = pair(k, a) -> !(fst(z) != k) by simp()
    show by taut(u1, u2, u3, pk)
  qed
  show := mp(set_ext[a := fn_update(fn_update(f, k, a), k, b), b := fn_update(f, k, b)], g)
qed

// updates of two keys: in either order
theorem fn_update_swap(f, k, a, j, b): !(k = j) -> fn_update(fn_update(f, k, a), j, b) = fn_update(fn_update(f, j, b), k, a)
proof
  assume hk
  have g: all z. z in fn_update(fn_update(f, k, a), j, b) <-> z in fn_update(fn_update(f, j, b), k, a) proof
    fix z
    have u1 := fn_update_iff[f := fn_update(f, k, a), k := j, v := b, z := z]
    have u2 := fn_update_iff[f := f, k := k, v := a, z := z]
    have u3 := fn_update_iff[f := fn_update(f, j, b), k := k, v := a, z := z]
    have u4 := fn_update_iff[f := f, k := j, v := b, z := z]
    have pa: z = pair(k, a) -> fst(z) != j proof
      assume e
      have f: fst(z) = k by simp(e)
      show by taut(rewrite(sym(f), hk))
    qed
    have pb: z = pair(j, b) -> fst(z) != k proof
      assume e
      have f: fst(z) = j by simp(e)
      have hk2: !(j = k) by taut(hk, eq_sym[a := j, b := k])
      show by taut(rewrite(sym(f), hk2))
    qed
    show by taut(u1, u2, u3, u4, pa, pb)
  qed
  show := mp(set_ext[a := fn_update(fn_update(f, k, a), j, b), b := fn_update(fn_update(f, j, b), k, a)], g)
qed

// functions with the same pairs at x have the same value there
theorem app_ext(f, g, x): (all y. pair(x, y) in f <-> pair(x, y) in g) -> app(f, x) = app(g, x)
proof
  assume iff
  have ce := mp(choose_ext[p := y. pair(x, y) in f, q := y. pair(x, y) in g], iff)
  have e12: (ex y. pair(x, y) in f) -> (ex y. pair(x, y) in g) proof
    assume e
    obtain y, hy from e
    show by ex_intro({y}, taut(all_elim(iff, {y}), hy))
  qed
  have e21: (ex y. pair(x, y) in g) -> (ex y. pair(x, y) in f) proof
    assume e
    obtain y, hy from e
    show by ex_intro({y}, taut(all_elim(iff, {y}), hy))
  qed
  have h1: (ex y. pair(x, y) in g) -> app(f, x) = app(g, x) proof
    assume e2
    have a1 := mp(ite_t[c := ex y. pair(x, y) in f, a := choose(y. pair(x, y) in f), b := empty], mp(e21, e2))
    have a2 := mp(ite_t[c := ex y. pair(x, y) in g, a := choose(y. pair(x, y) in g), b := empty], e2)
    show by defs(trans(trans(a1, ce), sym(a2)), app)
  qed
  have h2: !(ex y. pair(x, y) in g) -> app(f, x) = app(g, x) proof
    assume n2
    have n1: !(ex y. pair(x, y) in f) by taut(e12, n2)
    have b1 := mp(ite_f[c := ex y. pair(x, y) in f, a := choose(y. pair(x, y) in f), b := empty], n1)
    have b2 := mp(ite_f[c := ex y. pair(x, y) in g, a := choose(y. pair(x, y) in g), b := empty], n2)
    show by defs(trans(b1, sym(b2)), app)
  qed
  show by taut(h1, h2)
qed

// an update at k leaves the value at another key
theorem app_update_other(f, k, v, x): !(x = k) -> app(fn_update(f, k, v), x) = app(f, x)
proof
  assume h
  have iff: all y. pair(x, y) in fn_update(f, k, v) <-> pair(x, y) in f proof
    fix y
    have u := fn_update_iff[f := f, k := k, v := v, z := pair(x, y)]
    have pf: pair(x, y) = pair(k, v) -> false proof
      assume e
      show by taut(mp(pair_fst[a := x, b := y, c := k, d := v], e), h)
    qed
    have u2 := expand(simp(u), ne)
    show by taut(u2, h, pf)
  qed
  show by mp(app_ext[f := fn_update(f, k, v), g := f, x := x], iff)
qed

// in `f`, a pair with first element `k` is `pair(k, app(f, k))`
theorem fun_pair(f, k, z): is_fun(f) -> z in f -> fst(z) = k -> z = pair(k, app(f, k))
proof
  assume hf zf fz
  have pairs: all z. z in f -> (ex a b. z = pair(a, b)) by taut(expand(hf, is_fun))
  obtain a, ha from mp(all_elim(pairs, {z}), zf)
  obtain b, hb from ha
  have fa: fst(pair(a, b)) = a by simp()
  have ak: a = k by taut(trans(sym(fa), rewrite(hb, fz)))
  have zk := rewrite(ak, hb)
  have ap := mp(mp(fun_app[f := f, k := k, v := b], hf), rewrite(zk, zf))
  show by taut(rewrite(sym(ap), zk))
qed

// updating a field with its own value changes nothing
theorem fn_update_same(f, k): is_fun(f) -> k in dom(f) -> fn_update(f, k, app(f, k)) = f
proof
  assume hf hk
  have pk := mp(mp(dom_elim[f := f, k := k], hf), hk)
  have all_z: all z. z in fn_update(f, k, app(f, k)) <-> z in f proof
    fix z
    have m := fn_update_iff[f := f, k := k, v := app(f, k), z := z]
    have back: z = pair(k, app(f, k)) -> z in f proof
      assume e
      show by taut(rewrite(sym(e), pk))
    qed
    have fwd: z in f -> fst(z) = k -> z = pair(k, app(f, k)) proof
      assume zf fz
      show by taut(mp(mp(mp(fun_pair[f := f, k := k, z := z], hf), zf), fz))
    qed
    show by taut(m, back, fwd, expand(m, ne))
  qed
  show by taut(mp(set_ext[a := fn_update(f, k, app(f, k)), b := f], all_z))
qed

// ----------------------------------------------------------------------
//  Records with ghost fields: `union2(w, g)`, a field k of w (not of g)

theorem app_union2_l(w, g, k): is_fun(w) -> k in dom(w) -> !(k in dom(g)) -> app(union2(w, g), k) = app(w, k)
proof
  assume hw hk hg
  have same: all y. pair(k, y) in union2(w, g) <-> pair(k, y) in w proof
    fix y
    have u := union2_iff[a := w, b := g, z := pair(k, y)]
    have ng := dom_intro[f := g, k := k, v := y]
    show by taut(u, ng, hg)
  qed
  show by mp(app_ext[f := union2(w, g), g := w, x := k], same)
qed

theorem fn_update_union(w, g, k):
  is_fun(w) -> k in dom(w) -> !(k in dom(g)) -> fn_update(union2(w, g), k, app(w, k)) = union2(w, g)
proof
  assume hw hk hg
  have ws := mp(mp(fn_update_same[f := w, k := k], hw), hk)
  have all_z: all z. z in fn_update(union2(w, g), k, app(w, k)) <-> z in union2(w, g) proof
    fix z
    have m := fn_update_iff[f := union2(w, g), k := k, v := app(w, k), z := z]
    // the elements of w, as those of its update (which is w)
    have mw := rewrite(ws, fn_update_iff[f := w, k := k, v := app(w, k), z := z])
    have u := union2_iff[a := w, b := g, z := z]
    // a pair of g does not have k first
    have gk: z in g -> fst(z) != k proof
      assume zg
      have ne: fst(z) = k -> false proof
        assume fz
        have e: ex x. x in g && fst(x) = k by ex_intro({z}, taut(zg, fz))
        have kg: k in dom(g) by defs(taut(set_image_def[s := g, f := x. fst(x), y := k], e), dom)
        show by taut(hg, kg)
      qed
      show by defs(taut(ne), ne)
    qed
    show by taut(m, mw, u, gk)
  qed
  show by taut(mp(set_ext[a := fn_update(union2(w, g), k, app(w, k)), b := union2(w, g)], all_z))
qed

// ----------------------------------------------------------------------
//  Built functions

// a function is the function built from its values on its domain
theorem fn_eta(f, d): is_fun(f) -> dom(f) = d -> fn_build(d, x. app(f, x)) = f
proof
  assume hf hd
  have all_z: all z. z in fn_build(d, x. app(f, x)) <-> z in f proof
    fix z
    have zb := set_image_def[s := d, f := x. pair(x, app(f, x)), y := z]
    have to: z in fn_build(d, x. app(f, x)) -> z in f proof
      assume h
      have e: ex x. x in d && pair(x, app(f, x)) = z by taut(zb, expand(h, fn_build))
      obtain x, hx from e
      have xd: x in d by taut(hx)
      have pz: pair(x, app(f, x)) = z by taut(hx)
      have xf := mp(mp(dom_elim[f := f, k := x], hf), rewrite(sym(hd), xd))
      show by taut(rewrite(pz, xf))
    qed
    have from: z in f -> z in fn_build(d, x. app(f, x)) proof
      assume h
      have pairs: all z. z in f -> (ex a b. z = pair(a, b)) by taut(expand(hf, is_fun))
      obtain p, hp from mp(all_elim(pairs, {z}), h)
      obtain q, hq from hp
      have fp: fst(pair(p, q)) = p by simp()
      have fz: fst(z) = p by taut(rewrite(sym(hq), fp))
      have zp := mp(mp(mp(fun_pair[f := f, k := p, z := z], hf), h), fz)
      have pd := dom_intro[f := f, k := p, v := app(f, p)]
      have pin: pair(p, app(f, p)) in f by taut(rewrite(zp, h))
      have pdd: p in d by taut(rewrite(hd, mp(pd, pin)))
      have e: ex x. x in d && pair(x, app(f, x)) = z by ex_intro({p}, taut(pdd, sym(zp)))
      show by defs(taut(zb, e), fn_build)
    qed
    show by taut(to, from)
  qed
  show by taut(mp(set_ext[a := fn_build(d, x. app(f, x)), b := f], all_z))
qed

// updating a built function at k (in its domain) builds the function that
// has the new value at k and agrees elsewhere
theorem fn_update_build(d, x. f, x. g, k, w):
  k in d -> g(k) = w -> (all x. x in d -> !(x = k) -> g(x) = f(x)) ->
  fn_update(fn_build(d, x. f(x)), k, w) = fn_build(d, x. g(x))
proof
  assume hk hw hg
  have all_z: all z. z in fn_update(fn_build(d, x. f(x)), k, w) <-> z in fn_build(d, x. g(x)) proof
    fix z
    have m := fn_update_iff[f := fn_build(d, x. f(x)), k := k, v := w, z := z]
    have zf := set_image_def[s := d, f := x. pair(x, f(x)), y := z]
    have zg := set_image_def[s := d, f := x. pair(x, g(x)), y := z]
    // left to right
    have to: z in fn_update(fn_build(d, x. f(x)), k, w) -> z in fn_build(d, x. g(x)) proof
      assume h
      have c1: (z in fn_build(d, x. f(x)) && fst(z) != k) -> z in fn_build(d, x. g(x)) proof
        assume hc
        have zi: z in fn_build(d, x. f(x)) by taut(hc)
        have e: ex x. x in d && pair(x, f(x)) = z by taut(zf, expand(zi, fn_build))
        obtain x, hx from e
        have xd: x in d by taut(hx)
        have pz: pair(x, f(x)) = z by taut(hx)
        have fx: fst(pair(x, f(x))) = x by simp()
        have nk0: x = k -> false proof
          assume xk
          show by taut(expand(hc, ne), rewrite(xk, rewrite(pz, fx)))
        qed
        have nk: !(x = k) by taut(nk0)
        have gx := mp(mp(all_elim(hg, {x}), xd), nk)
        have pg: pair(x, g(x)) = z by taut(rewrite(sym(gx), pz))
        have eg: ex y. y in d && pair(y, g(y)) = z by ex_intro({x}, taut(xd, pg))
        show by defs(taut(zg, eg), fn_build)
      qed
      have c2: z = pair(k, w) -> z in fn_build(d, x. g(x)) proof
        assume e
        have pk: pair(k, g(k)) = z by taut(rewrite(sym(hw), sym(e)))
        have eg: ex y. y in d && pair(y, g(y)) = z by ex_intro({k}, taut(hk, pk))
        show by defs(taut(zg, eg), fn_build)
      qed
      show by taut(m, h, c1, c2)
    qed
    // right to left
    have from: z in fn_build(d, x. g(x)) -> z in fn_update(fn_build(d, x. f(x)), k, w) proof
      assume h
      have e: ex y. y in d && pair(y, g(y)) = z by taut(zg, expand(h, fn_build))
      obtain x, hx from e
      have xd: x in d by taut(hx)
      have pz: pair(x, g(x)) = z by taut(hx)
      have fx: fst(pair(x, g(x))) = x by simp()
      have isk: x = k -> z = pair(k, w) proof
        assume xk
        show by taut(sym(rewrite(hw, rewrite(xk, pz))))
      qed
      have notk: !(x = k) -> z in fn_build(d, x. f(x)) && fst(z) != k proof
        assume nk
        have gx := mp(mp(all_elim(hg, {x}), xd), nk)
        have pf: pair(x, f(x)) = z by taut(rewrite(gx, pz))
        have ef: ex y. y in d && pair(y, f(y)) = z by ex_intro({x}, taut(xd, pf))
        have zin: z in fn_build(d, x. f(x)) by defs(taut(zf, ef), fn_build)
        have fz: fst(z) = x by taut(rewrite(pz, fx))
        have ne0: fst(z) != k by defs(taut(rewrite(sym(fz), nk)), ne)
        show by taut(zin, ne0)
      qed
      show by taut(m, isk, notk)
    qed
    show by taut(to, from)
  qed
  show by taut(mp(set_ext[a := fn_update(fn_build(d, x. f(x)), k, w), b := fn_build(d, x. g(x))], all_z))
qed

// ----------------------------------------------------------------------
//  Extensionality: functions with the same domain and values are equal

// the pairs of a are pairs of b when b has a's keys with a's values
theorem rec_sub(a, b): is_fun(a) -> is_fun(b) -> (all k. k in dom(a) -> k in dom(b) && app(a, k) = app(b, k)) -> (all z. z in a -> z in b)
proof
  assume ha hb h
  fix z
  assume zi
  have pairs: all z. z in a -> (ex x y. z = pair(x, y)) by taut(expand(ha, is_fun))
  obtain x, hx from mp(all_elim(pairs, {z}), zi)
  obtain y, hy from hx
  have zp: z = pair(x, y) by taut(hy)
  have pa := rewrite(zp, zi)
  have xa := mp(dom_intro[f := a, k := x, v := y], pa)
  have kk := mp(all_elim(h, {x}), xa)
  have xb: x in dom(b) by taut(kk)
  have abx: app(a, x) = app(b, x) by taut(kk)
  have av := mp(mp(fun_app[f := a, k := x, v := y], ha), pa)
  have pb := mp(mp(dom_elim[f := b, k := x], hb), xb)
  have eb := trans(sym(abx), av)
  have pb2 := rewrite(eb, pb)
  show by rewrite(sym(zp), pb2)
qed

theorem rec_ext(a, b): is_fun(a) -> is_fun(b) -> dom(a) = dom(b) -> (all k. k in dom(a) -> app(a, k) = app(b, k)) -> a = b
proof
  assume ha hb dab h
  have h1: all k. k in dom(a) -> k in dom(b) && app(a, k) = app(b, k) proof
    fix k
    assume hk
    have kb := rewrite(dab, hk)
    have e := mp(all_elim(h, {k}), hk)
    show by taut(kb, e)
  qed
  have h2: all k. k in dom(b) -> k in dom(a) && app(b, k) = app(a, k) proof
    fix k
    assume hk
    have ka := rewrite(sym(dab), hk)
    have e := mp(all_elim(h, {k}), ka)
    show by taut(ka, sym(e))
  qed
  have s1 := mp(mp(mp(rec_sub[a := a, b := b], ha), hb), h1)
  have s2 := mp(mp(mp(rec_sub[a := b, b := a], hb), ha), h2)
  have all_z: all z. z in a <-> z in b proof
    fix z
    show by taut(all_elim(s1, {z}), all_elim(s2, {z}))
  qed
  show by mp(set_ext[a := a, b := b], all_z)
qed

// an update keeps a function a function
theorem fn_update_fun(f, k, v): is_fun(f) -> is_fun(fn_update(f, k, v))
proof
  assume hf
  have pairs: all z. z in f -> (ex x y. z = pair(x, y)) by taut(expand(hf, is_fun))
  have uniq: all x y w. pair(x, y) in f -> pair(x, w) in f -> y = w by taut(expand(hf, is_fun))
  have p1: all z. z in fn_update(f, k, v) -> (ex x y. z = pair(x, y)) proof
    fix z
    assume h
    have m := fn_update_iff[f := f, k := k, v := v, z := z]
    have c1: z in f -> (ex x y. z = pair(x, y)) by taut(all_elim(pairs, {z}))
    have c2: z = pair(k, v) -> (ex x y. z = pair(x, y)) proof
      assume e
      show by ex_intro({k}, {v}, e)
    qed
    show by taut(m, h, c1, c2)
  qed
  have p2: all x y w. pair(x, y) in fn_update(f, k, v) -> pair(x, w) in fn_update(f, k, v) -> y = w proof
    fix x y w
    assume hy hw
    have my := fn_update_iff[f := f, k := k, v := v, z := pair(x, y)]
    have mw := fn_update_iff[f := f, k := k, v := v, z := pair(x, w)]
    have fy: fst(pair(x, y)) = x by simp()
    have fw: fst(pair(x, w)) = x by simp()
    have u := all_elim(all_elim(all_elim(uniq, {x}), {y}), {w})
    have iy: pair(x, y) = pair(k, v) -> x = k && y = v by simp()
    have iw: pair(x, w) = pair(k, v) -> x = k && w = v by simp()
    have neq: !(x = k) -> pair(x, y) = pair(k, v) -> false proof
      assume n e
      show by taut(n, mp(iy, e))
    qed
    have neq2: !(x = k) -> pair(x, w) = pair(k, v) -> false proof
      assume n e
      show by taut(n, mp(iw, e))
    qed
    have both: x = k && y = v -> x = k && w = v -> y = w proof
      assume a1 a2
      have e1: y = v by taut(a1)
      have e2: w = v by taut(a2)
      show by trans(e1, sym(e2))
    qed
    show by taut(expand(my, ne), expand(mw, ne), hy, hw, rewrite(fy, expand(my, ne)), rewrite(fw, expand(mw, ne)), u, iy, iw, neq, neq2, both)
  qed
  show by defs(taut(p1, p2), is_fun)
qed

// an update at a key of the domain keeps the domain
theorem fn_update_dom(f, k, v): is_fun(f) -> k in dom(f) -> dom(fn_update(f, k, v)) = dom(f)
proof
  assume hf hk
  have all_x: all x. x in dom(fn_update(f, k, v)) <-> x in dom(f) proof
    fix x
    have du := set_image_def[s := fn_update(f, k, v), f := z. fst(z), y := x]
    have df := set_image_def[s := f, f := z. fst(z), y := x]
    have fwd: (ex z. z in fn_update(f, k, v) && fst(z) = x) -> x in dom(f) proof
      assume e
      obtain z, hz from e
      have m := fn_update_iff[f := f, k := k, v := v, z := z]
      have zu: z in fn_update(f, k, v) by taut(hz)
      have fz: fst(z) = x by taut(hz)
      have c1: z in f -> x in dom(f) proof
        assume zf
        have ez: ex z. z in f && fst(z) = x by ex_intro({z}, taut(zf, fz))
        show by defs(taut(df, ez), dom)
      qed
      have c2: z = pair(k, v) -> x = k proof
        assume e2
        have fk: fst(pair(k, v)) = k by simp()
        show by trans(sym(fz), rewrite(sym(e2), fk))
      qed
      have c3: x = k -> x in dom(f) proof
        assume xk
        show by rewrite(sym(xk), hk)
      qed
      show by taut(m, zu, c1, c2, c3)
    qed
    have bwd: x in dom(f) -> (ex z. z in fn_update(f, k, v) && fst(z) = x) proof
      assume xd
      have c1: x = k -> (ex z. z in fn_update(f, k, v) && fst(z) = x) proof
        assume xk
        have m := fn_update_iff[f := f, k := k, v := v, z := pair(k, v)]
        have pin: pair(k, v) in fn_update(f, k, v) by simp(expand(m, iff))
        have fk: fst(pair(k, v)) = x by simp(xk)
        show by ex_intro({pair(k, v)}, taut(pin, fk))
      qed
      have c2: !(x = k) -> (ex z. z in fn_update(f, k, v) && fst(z) = x) proof
        assume nk
        have px := mp(mp(dom_elim[f := f, k := x], hf), xd)
        have m := fn_update_iff[f := f, k := k, v := v, z := pair(x, app(f, x))]
        have fx: fst(pair(x, app(f, x))) = x by simp()
        have nfx: !(fst(pair(x, app(f, x))) = k) by simp(nk)
        have pin: pair(x, app(f, x)) in fn_update(f, k, v) by taut(expand(m, ne), px, nfx)
        show by ex_intro({pair(x, app(f, x))}, taut(pin, fx))
      qed
      show by taut(c1, c2)
    qed
    show by defs(taut(du, df, expand(fwd, dom), expand(bwd, dom)), dom)
  qed
  show by mp(set_ext[a := dom(fn_update(f, k, v)), b := dom(f)], all_x)
qed

// ----------------------------------------------------------------------
//  Restricting a record to (a superset of) its fields, and the ghost part
//  of a record whose fields are all among d

theorem restrict_all(f, d): (all z. z in f -> fst(z) in d) -> restrict(f, d) = f
proof
  assume h
  have all_z: all z. z in restrict(f, d) <-> z in f proof
    fix z
    have sd := set_select_def[s := f, p := z. fst(z) in d, z := z]
    show by defs(taut(sd, all_elim(h, {z})), restrict)
  qed
  show by mp(set_ext[a := restrict(f, d), b := f], all_z)
qed

theorem ghost_part_none(f, d): (all z. z in f -> fst(z) in d) -> ghost_part(f, d) = empty
proof
  assume h
  have none: all z. !(z in ghost_part(f, d)) proof
    fix z
    have sd := set_select_def[s := f, p := z. !(fst(z) in d), z := z]
    show by defs(taut(sd, all_elim(h, {z})), ghost_part)
  qed
  show by mp(empty_ext[y := ghost_part(f, d)], none)
qed

theorem union2_empty(a): union2(a, empty) = a
proof
  have all_z: all z. z in union2(a, empty) <-> z in a proof
    fix z
    show by taut(union2_iff[a := a, b := empty, z := z], empty_mem[x := z])
  qed
  show by mp(set_ext[a := union2(a, empty), b := a], all_z)
qed

// ----------------------------------------------------------------------
//  Parts of a record stay in its universe (they are subsets)

theorem restrict_univ(u, f, d): f in univ(u) -> restrict(f, d) in univ(u)
proof
  assume hf
  have sub: all z. z in restrict(f, d) -> z in f proof
    fix z
    assume h
    show by taut(set_select_def[s := f, p := z. fst(z) in d, z := z], expand(h, restrict))
  qed
  have ss: subset(restrict(f, d), f) by defs(sub, subset)
  show by mp(mp(univ_subset[u := u, a := restrict(f, d), b := f], hf), ss)
qed

theorem ghost_part_univ(u, f, d): f in univ(u) -> ghost_part(f, d) in univ(u)
proof
  assume hf
  have sub: all z. z in ghost_part(f, d) -> z in f proof
    fix z
    assume h
    show by taut(set_select_def[s := f, p := z. !(fst(z) in d), z := z], expand(h, ghost_part))
  qed
  have ss: subset(ghost_part(f, d), f) by defs(sub, subset)
  show by mp(mp(univ_subset[u := u, a := ghost_part(f, d), b := f], hf), ss)
qed

// ... and so do its fields (simp's goal-side rule, as a fact)
theorem app_univ(u, f, k): f in univ(u) -> app(f, k) in univ(u)
proof
  assume hf
  show by simp(hf)
qed

// ----------------------------------------------------------------------
//  Record types: a record (in the universe) whose fields are typed is in
//  its type; built functions are in their function space

theorem rec_type_intro(u, k, x. p, r): r in univ(u) -> is_fun(r) -> dom(r) = k -> p(r) -> r in set_select(powerset(cart(k, univ(u))), x. p(x))
proof
  assume hu hf hd hp
  have sub: all z. z in r -> z in cart(k, univ(u)) proof
    fix z
    assume hz
    have zu := mp(mp(univ_trans[u := u, a := z, b := r], hu), hz)
    have pz: ex a b. z = pair(a, b) by simp(expand(hf, is_fun), hz)
    obtain a, ha from pz
    obtain b, hb from ha
    have ak: a in dom(r) by simp(mp(dom_intro[f := r, k := a, v := b], rewrite(hb, hz)))
    have bu: b in univ(u) by simp(rewrite(hb, zu))
    have ck := mp(mp(cart_intro[a := k, b := univ(u), x := a, y := b], rewrite(hd, ak)), bu)
    show by simp(ck, hb)
  qed
  have ss: subset(r, cart(k, univ(u))) by defs(sub, subset)
  have pw: r in powerset(cart(k, univ(u))) by taut(powerset_def[s := cart(k, univ(u)), a := r], ss)
  show by simp(pw, hp)
qed

theorem fn_build_space(d, x. v, b): (all x. x in d -> v(x) in b) -> fn_build(d, x. v(x)) in fn_space(d, b)
proof
  assume hv
  have sub: all z. z in fn_build(d, x. v(x)) -> z in cart(d, b) proof
    fix z
    assume hz
    have e: ex x. x in d && pair(x, v(x)) = z by taut(set_image_def[s := d, f := x. pair(x, v(x)), y := z], expand(hz, fn_build))
    obtain x, hx from e
    have xd: x in d by taut(hx)
    have ck := mp(mp(cart_intro[a := d, b := b, x := x, y := v(x)], xd), mp(all_elim(hv, {x}), xd))
    show by simp(ck, hx)
  qed
  have ss: subset(fn_build(d, x. v(x)), cart(d, b)) by defs(sub, subset)
  have pw: fn_build(d, x. v(x)) in powerset(cart(d, b)) by taut(powerset_def[s := cart(d, b), a := fn_build(d, x. v(x))], ss)
  show by defs(simp(pw, fn_build_fun[d := d, v := x. v(x)], fn_build_dom[d := d, v := x. v(x)]), fn_space)
qed

theorem fn_space_app(a, b, f, x): f in fn_space(a, b) -> x in a -> app(f, x) in b
proof
  assume hf hx
  have ft: f in powerset(cart(a, b)) && is_fun(f) && dom(f) = a by simp(expand(hf, fn_space))
  have fun: is_fun(f) by taut(ft)
  have xd: x in dom(f) by simp(ft, hx)
  have pin := mp(mp(dom_elim[f := f, k := x], fun), xd)
  have ss: subset(f, cart(a, b)) by taut(powerset_def[s := cart(a, b), a := f], ft)
  have pc := mp(all_elim(expand(ss, subset), {pair(x, app(f, x))}), pin)
  have ce := mp(cart_elim[a := a, b := b, z := pair(x, app(f, x))], pc)
  show by simp(ce)
qed

// a record of a record type has only its keys
theorem pow_cart_fst(a, b, f): f in powerset(cart(a, b)) -> (all z. z in f -> fst(z) in a)
proof
  assume hf
  have ss: subset(f, cart(a, b)) by taut(powerset_def[s := cart(a, b), a := f], hf)
  show all z. z in f -> fst(z) in a proof
    fix z
    assume hz
    have zc := mp(all_elim(expand(ss, subset), {z}), hz)
    have ce := mp(cart_elim[a := a, b := b, z := z], zc)
    show by simp(ce)
  qed
qed

// functions between members of a universe are members
theorem fn_space_univ(u, a, b, f): a in univ(u) -> b in univ(u) -> f in fn_space(a, b) -> f in univ(u)
proof
  assume ha hb hf
  have inner: all x. x in a -> set_image(b, y. pair(x, y)) in univ(u) proof
    fix x
    assume hx
    have xu := mp(mp(univ_trans[u := u, a := x, b := a], ha), hx)
    have py: all y. y in b -> pair(x, y) in univ(u) proof
      fix y
      assume hy
      have yu := mp(mp(univ_trans[u := u, a := y, b := b], hb), hy)
      show by simp(xu, yu)
    qed
    show := mp(mp(univ_image[u := u, s := b, f := y. pair(x, y)], hb), py)
  qed
  have im := mp(mp(univ_image[u := u, s := a, f := x. set_image(b, y. pair(x, y))], ha), inner)
  have cu: cart(a, b) in univ(u) by defs(mp(univ_union[u := u, s := set_image(a, x. set_image(b, y. pair(x, y)))], im), cart)
  have ft: f in powerset(cart(a, b)) by simp(expand(hf, fn_space))
  have ss: subset(f, cart(a, b)) by taut(powerset_def[s := cart(a, b), a := f], ft)
  show := mp(mp(univ_subset[u := u, a := f, b := cart(a, b)], cu), ss)
qed

// (two members' union, a cart of members: members)
theorem union2_univ(u, a, b): a in univ(u) -> b in univ(u) -> union2(a, b) in univ(u)
proof
  assume ha hb
  have pu: upair(a, b) in univ(u) by simp(ha, hb)
  show by defs(mp(univ_union[u := u, s := upair(a, b)], pu), union2)
qed

theorem cart_univ(u, a, b): a in univ(u) -> b in univ(u) -> cart(a, b) in univ(u)
proof
  assume ha hb
  have inner: all x. x in a -> set_image(b, y. pair(x, y)) in univ(u) proof
    fix x
    assume hx
    have xu := mp(mp(univ_trans[u := u, a := x, b := a], ha), hx)
    have py: all y. y in b -> pair(x, y) in univ(u) proof
      fix y
      assume hy
      have yu := mp(mp(univ_trans[u := u, a := y, b := b], hb), hy)
      show by simp(xu, yu)
    qed
    show := mp(mp(univ_image[u := u, s := b, f := y. pair(x, y)], hb), py)
  qed
  have im := mp(mp(univ_image[u := u, s := a, f := x. set_image(b, y. pair(x, y))], ha), inner)
  show by defs(mp(univ_union[u := u, s := set_image(a, x. set_image(b, y. pair(x, y)))], im), cart)
qed

// a record type over the keys k whose fields take values in b (members of
// the universe): a member
theorem rec_type_univ(u, k, b, x. p): k in univ(u) -> b in univ(u) ->
  (all r. r in set_select(powerset(cart(k, univ(u))), x. p(x)) -> is_fun(r) && (all y. y in k -> app(r, y) in b)) ->
  set_select(powerset(cart(k, univ(u))), x. p(x)) in univ(u)
proof
  assume hk hb hr
  have cu := mp(mp(cart_univ[u := u, a := k, b := b], hk), hb)
  have pu := mp(univ_powerset[u := u, s := cart(k, b)], cu)
  have sub: all r. r in set_select(powerset(cart(k, univ(u))), x. p(x)) -> r in powerset(cart(k, b)) proof
    fix r
    assume h
    have hf hv := mp(all_elim(hr, {r}), h)
    have rp: r in powerset(cart(k, univ(u))) by taut(set_select_def[s := powerset(cart(k, univ(u))), p := x. p(x), z := r], h)
    have rs: subset(r, cart(k, univ(u))) by taut(powerset_def[s := cart(k, univ(u)), a := r], rp)
    have g: all z. z in r -> z in cart(k, b) proof
      fix z
      assume hz
      have zc := mp(all_elim(expand(rs, subset), {z}), hz)
      obtain x0 y0, hx0 _ ez from mp(cart_elim[a := k, b := univ(u), z := z], zc)
      have pz := rewrite(ez, hz)
      have ap := mp(mp(fun_app[f := r, k := x0, v := y0], hf), pz)
      have yb := rewrite(ap, mp(all_elim(hv, {x0}), hx0))
      have c := mp(mp(cart_intro[a := k, b := b, x := x0, y := y0], hx0), yb)
      show := rewrite(sym(ez), c)
    qed
    have s2: subset(r, cart(k, b)) by defs(g, subset)
    show by taut(powerset_def[s := cart(k, b), a := r], s2)
  qed
  have ss: subset(set_select(powerset(cart(k, univ(u))), x. p(x)), powerset(cart(k, b))) by defs(sub, subset)
  show := mp(mp(univ_subset[u := u, a := set_select(powerset(cart(k, univ(u))), x. p(x)), b := powerset(cart(k, b))], pu), ss)
qed

theorem bits_univ(n): bits(n) in univ(1)
proof
  have sub: all x. x in bits(n) -> x in omega proof
    fix x
    assume hx
    show by taut(set_select_def[s := omega, p := x. int_lt(x, pow2(n)), z := x], expand(hx, bits))
  qed
  have ss: subset(bits(n), omega) by defs(sub, subset)
  show := mp(mp(univ_subset[u := 1, a := bits(n), b := omega], omega_univ), ss)
qed

// a state with ghost fields: its parts in their types
theorem rec_and_intro(a, b, x, y): x in a -> y in b -> union2(x, y) in rec_and(a, b)
proof
  assume hx hy
  have c := mp(mp(cart_intro[a := a, b := b, x := x, y := y], hx), hy)
  have e: ex z. z in cart(a, b) && union2(fst(z), snd(z)) = union2(x, y) by ex_intro({pair(x, y)}, simp(c))
  show by defs(taut(set_image_def[s := cart(a, b), f := z. union2(fst(z), snd(z)), y := union2(x, y)], e), rec_and)
qed

// the empty record
theorem dom_empty: is_fun(empty) && dom(empty) = empty
proof
  have fe: is_fun(empty) by defs(simp(empty_mem), is_fun)
  have all_x: all x. x in dom(empty) <-> x in empty proof
    fix x
    have d := set_image_def[s := empty, f := z. fst(z), y := x]
    have ne: (ex z. z in empty && fst(z) = x) -> false proof
      assume e
      obtain z, hz from e
      show by taut(hz, empty_mem[x := z])
    qed
    show by defs(taut(d, ne, empty_mem[x := x]), dom)
  qed
  have de := mp(set_ext[a := dom(empty), b := empty], all_x)
  show by taut(fe, de)
qed

// an update adds its key to the domain
theorem dom_update(f, k, v): is_fun(f) -> dom(fn_update(f, k, v)) = insert(k, dom(f))
proof
  assume hf
  have all_x: all x. x in dom(fn_update(f, k, v)) <-> x in insert(k, dom(f)) proof
    fix x
    have du := set_image_def[s := fn_update(f, k, v), f := z. fst(z), y := x]
    have df := set_image_def[s := f, f := z. fst(z), y := x]
    have fwd: (ex z. z in fn_update(f, k, v) && fst(z) = x) -> x in insert(k, dom(f)) proof
      assume e
      obtain z, hz from e
      have m := fn_update_iff[f := f, k := k, v := v, z := z]
      have zu: z in fn_update(f, k, v) by taut(hz)
      have fz: fst(z) = x by taut(hz)
      have c1: z in f -> x in insert(k, dom(f)) proof
        assume zf
        have ez: ex z. z in f && fst(z) = x by ex_intro({z}, taut(zf, fz))
        have xd: x in dom(f) by defs(taut(df, ez), dom)
        show by simp(xd)
      qed
      have c2: z = pair(k, v) -> x in insert(k, dom(f)) proof
        assume e2
        have fk: fst(pair(k, v)) = k by simp()
        have xk := trans(sym(fz), rewrite(sym(e2), fk))
        show by simp(xk)
      qed
      show by taut(m, zu, c1, c2)
    qed
    have bwd: x in insert(k, dom(f)) -> (ex z. z in fn_update(f, k, v) && fst(z) = x) proof
      assume xi
      have c1: x = k -> (ex z. z in fn_update(f, k, v) && fst(z) = x) proof
        assume xk
        have m := fn_update_iff[f := f, k := k, v := v, z := pair(k, v)]
        have pin: pair(k, v) in fn_update(f, k, v) by simp(expand(m, iff))
        have fk: fst(pair(k, v)) = x by simp(xk)
        show by ex_intro({pair(k, v)}, taut(pin, fk))
      qed
      have c2: !(x = k) -> (ex z. z in fn_update(f, k, v) && fst(z) = x) proof
        assume nk
        have xd: x in dom(f) by simp(xi, nk)
        have px := mp(mp(dom_elim[f := f, k := x], hf), xd)
        have m := fn_update_iff[f := f, k := k, v := v, z := pair(x, app(f, x))]
        have fx: fst(pair(x, app(f, x))) = x by simp()
        have nfx: !(fst(pair(x, app(f, x))) = k) by simp(nk)
        have pin: pair(x, app(f, x)) in fn_update(f, k, v) by taut(expand(m, ne), px, nfx)
        show by ex_intro({pair(x, app(f, x))}, taut(pin, fx))
      qed
      show by taut(c1, c2)
    qed
    show by defs(taut(du, expand(fwd, dom), expand(bwd, dom)), dom)
  qed
  show by mp(set_ext[a := dom(fn_update(f, k, v)), b := insert(k, dom(f))], all_x)
qed

// an update at a key of the domain: still a function on it
theorem fn_update_fd(f, k, v, d): is_fun(f) -> dom(f) = d -> k in d -> is_fun(fn_update(f, k, v)) && dom(fn_update(f, k, v)) = d
proof
  assume hf hd hk
  have kd := rewrite(sym(hd), hk)
  have fu := mp(fn_update_fun[f := f, k := k, v := v], hf)
  have fd := mp(mp(fn_update_dom[f := f, k := k, v := v], hf), kd)
  have e := trans(fd, hd)
  show by taut(fu, e)
qed

// an equation is a bool value
theorem eq_bool(a, b): (a = b) in bool
proof
  show by defs(simp(expand(eq_prop[a := a, b := b], is_prop)), bool)
qed

// a bool value that does not hold is false
theorem not_eq_false(a): a in bool -> !a -> a = false
proof
  assume hb hn
  have c: a = true -> false proof
    assume e
    have t := rewrite(sym(e), true_i)
    show by taut(hn, t)
  qed
  have d: a = false || a = true by simp(expand(hb, bool))
  show by taut(d, c)
qed

// ---------------------------------------------------------------------
//  Rewrite rules of the proof language's simp (`simp NAME`)

theorem fst_pair(a, b): fst(pair(a, b)) = a
proof
  show by simp()
qed

theorem snd_pair(a, b): snd(pair(a, b)) = b
proof
  show by simp()
qed

theorem app_update_same(f, k, v): app(fn_update(f, k, v), k) = v
proof
  show by simp()
qed

// ----------------------------------------------------------------------
//  fn_modify: a function's value at a key changed by g of the old one (the
//  function written once, not also in the new value)

theorem fn_modify_eq(f, k, y. g): fn_modify(f, k, y. g(y)) = fn_update(f, k, g(app(f, k)))
proof
  show by defs(refl({fn_update(f, k, g(app(f, k)))}), fn_modify)
qed

theorem app_modify_same(f, k, y. g): app(fn_modify(f, k, y. g(y)), k) = g(app(f, k))
proof
  have e := fn_modify_eq[f := f, k := k, g := y. g(y)]
  show := rewrite(sym(e), app_update_same[f := f, k := k, v := g(app(f, k))])
qed

theorem app_modify_other(f, k, y. g, x): !(x = k) -> app(fn_modify(f, k, y. g(y)), x) = app(f, x)
proof
  assume h
  have e := fn_modify_eq[f := f, k := k, g := y. g(y)]
  show := rewrite(sym(e), mp(app_update_other[f := f, k := k, v := g(app(f, k)), x := x], h))
qed

theorem fn_modify_fun(f, k, y. g): is_fun(f) -> is_fun(fn_modify(f, k, y. g(y)))
proof
  assume hf
  have e := fn_modify_eq[f := f, k := k, g := y. g(y)]
  show := rewrite(sym(e), mp(fn_update_fun[f := f, k := k, v := g(app(f, k))], hf))
qed

theorem fn_modify_dom(f, k, y. g): is_fun(f) -> k in dom(f) -> dom(fn_modify(f, k, y. g(y))) = dom(f)
proof
  assume hf hk
  have e := fn_modify_eq[f := f, k := k, g := y. g(y)]
  show := rewrite(sym(e), mp(fn_update_dom[f := f, k := k, v := g(app(f, k))], hf, hk))
qed

theorem fn_modify_fd(f, k, y. g, d): is_fun(f) -> dom(f) = d -> k in d -> is_fun(fn_modify(f, k, y. g(y))) && dom(fn_modify(f, k, y. g(y))) = d
proof
  assume hf hd hk
  have e := fn_modify_eq[f := f, k := k, g := y. g(y)]
  show := rewrite(sym(e), mp(fn_update_fd[f := f, k := k, v := g(app(f, k)), d := d], hf, hd, hk))
qed

theorem letin_eq(a, x. f): letin(a, x. f(x)) = f(a)
proof
  show by defs(refl({f(a)}), letin)
qed

simp fst_pair
simp snd_pair
simp app_update_same
simp app_update_other
simp letin_eq

// ----------------------------------------------------------------------
//  A program's outcomes: their parts

theorem out_state_ok(s, v): out_state(ok(s, v)) = s
proof
  show by defs(simp(), out_state, ok, tag)
qed

theorem out_value_ok(s, v): out_value(ok(s, v)) = v
proof
  show by defs(simp(), out_value, ok, tag)
qed

theorem out_state_exc(s, e): out_state(exc(s, e)) = s
proof
  show by defs(simp(), out_state, exc, tag)
qed

theorem out_value_exc(s, e): out_value(exc(s, e)) = e
proof
  show by defs(simp(), out_value, exc, tag)
qed

theorem fst_ok(s, v): fst(ok(s, v)) = 0
proof
  show by defs(simp(), ok, tag)
qed

theorem fst_exc(s, e): fst(exc(s, e)) = 1
proof
  show by defs(simp(), exc, tag)
qed

theorem fst_diverge(t): fst(diverge(t)) = 2
proof
  show by defs(simp(), diverge, tag)
qed

simp out_state_ok
simp out_value_ok
simp out_state_exc
simp out_value_exc
simp fst_ok
simp fst_exc
simp fst_diverge
