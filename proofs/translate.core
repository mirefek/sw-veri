// The translation of a function's machine code from its readable GIMPLE,
// statement by statement (docs/overview.md, C1): the claim at a
// point of the function, and the rules a function's proof chains from its
// return back to its entry.
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core core/records.core \
//     core/list.core core/loop.core build/c_mallocng_malloc.core proofs/x86.core proofs/x86_code.core \
//     proofs/abi.core proofs/abi_restore.core proofs/abi_glue.core proofs/gimple.core proofs/abi_stack.core \
//     proofs/abi_loop.core proofs/abi_bridge.core proofs/translate.core

// ----------------------------------------------------------------------
//  The claim at a point: from the machine state m, the rest of the run to
//  the caller of the entry s matches the rest of the spec, the program P
//  from the world w -- P raises (undefined behaviour: anything), or the
//  machine returns as P returns (abi.matches_at's return case). (No
//  divergence: a function without loops returns or faults; the loop rule
//  adds it.)

def tr.ub(s, v, p, w) := ex e x. e in univ(1) && !(e = exc_val("stack_overflow", empty)) && abi.raise_state(x) && runs(p, w, exc(x, e))

// (a pair is not empty: the raise the rules use is no stack overflow)
theorem tr.pair_ne: all a b. !(empty = pair(a, b))
proof
  fix a b
  have m: single(a) in pair(a, b) by defs(upair_l[a := single(a), b := upair(a, b)], pair)
  have n: empty = pair(a, b) -> false proof
    assume e
    have m2 := rewrite(sym(e), m)
    show by taut(m2, empty_mem[x := single(a)])
  qed
  show by taut(n)
qed

def tr.ok(s, v, p, w, o) :=
  ex m1 w2. o = ok(m1, empty) && m1 in x86_64_linux.Machine && m1 in univ(1) &&
    runs(p, w, ok(w2, pair(app(app(m1, "gpr"), 0), app(app(m1, "gpr"), 2)))) && w2 in abi.World && w2 in univ(1) &&
    abi.world_matches(app(s, "vm"), app(m1, "vm"), app(w2, "vm"), v, abi.sp(s)) && app(m1, "os") = app(w2, "os") && app(m1, "fs_base") = app(w2, "fs_base") &&
    app(m1, "cpu") = app(s, "cpu") && app(m1, "gs_base") = app(s, "gs_base") && app(m1, "rip") = abi.ret(s) && app(app(m1, "gpr"), 4) = abi.sp(s) &&
    abi.callee_saved(m1, s) && !app(app(m1, "flags"), "df")

// abi.run_from's parts: one pass of its loop from the state l (a step,
// unless at the return), the loop, its outcome as the run's
// (definitions, not abbreviations: a case analysis sees each as one atom)
abbrev tr.at_ret(s, x) := app(x, "rip") = x86_64_linux.le(app(app(s, "vm"), "bytes"), app(app(s, "gpr"), 4), 8) && app(app(x, "gpr"), 4) = bits_add(64, app(app(s, "gpr"), 4), 8)
def tr.rb(s, l, o) := (!tr.at_ret(s, fst(l)) &&
    bind_rel(x86_64_linux.step, fst(l), x7 x8. o = ok(pair(x7, empty), empty), x7 x8. o = exc(pair(x7, empty), pair("raise", x8)), x7. o = diverge(x7))) ||
  (!!tr.at_ret(s, fst(l)) && o = exc(pair(fst(l), empty), pair("brk", empty)))
def tr.rw(s, l, r) := while_rel(l, x5. true, x5 x6. tr.rb(s, x5, x6), x5. fn_update(empty, "os.events", app(app(fst(x5), "os"), "events")), r)
def tr.rmap(r, o) := (((fst(r) = 0 || (fst(r) = 1 && fst(out_value(r)) = "brk")) && o = ok(fst(out_state(r)), empty)) ||
  ((((fst(r) = 1 && fst(out_value(r)) = "ret") && o = ok(fst(out_state(r)), snd(out_value(r)))) ||
    ((fst(r) = 1 && fst(out_value(r)) = "raise") && o = exc(fst(out_state(r)), snd(out_value(r))))) ||
   (fst(r) = 2 && o = diverge(snd(r)))))

theorem tr.run_from_parts: all s m o. abi.run_from(s, m, o) <-> (ex r. tr.rw(s, pair(m, empty), r) && tr.rmap(r, o))
proof
  fix s m o
  show by defs(taut(), abi.run_from, tr.rw, tr.rb, tr.rmap)
qed

// The run with the stack discipline: a pass from a state l that is not at
// the return and whose rsp is not below the entry's sp leaves with
// the exception disc -- a function keeps its rsp below its sp until it
// returns (what a caller needs at a call: its own return is not reached
// inside the callee). The claim at a point is about this run.
abbrev tr.disc_ok(s, x) := tr.at_ret(s, x) || int_lt(app(app(x, "gpr"), 4), abi.sp(s))
def tr.rbd(s, l, o) := (tr.disc_ok(s, fst(l)) && tr.rb(s, l, o)) || (!tr.disc_ok(s, fst(l)) && o = exc(l, pair("raise", exc_val("disc", empty))))
def tr.rwd(s, l, r) := while_rel(l, x5. true, x5 x6. tr.rbd(s, x5, x6), x5. fn_update(empty, "os.events", app(app(fst(x5), "os"), "events")), r)
def tr.run_d(s, m, o) := ex r. tr.rwd(s, pair(m, empty), r) && tr.rmap(r, o)

// (the run from the entry: a disciplined run, or the disciplined run
// leaves with disc at the first state that breaks the discipline)
theorem tr.run_disc: all s o. runs(abi.run_to_return(), s, o) -> tr.run_d(s, s, o) || (ex x. tr.run_d(s, s, exc(x, exc_val("disc", empty))))
proof
  fix s o
  assume hr
  have rf := apply(abi.run_from_entry, hr)
  have hx0: ex x0. tr.rw(s, pair(s, empty), x0) && tr.rmap(x0, o) by taut(all_elim(tr.run_from_parts, {s}, {s}, {o}), rf)
  obtain x4, hw hm from hx0
  have ne: all l. !is_ok(exc(l, pair("raise", exc_val("disc", empty)))) proof
    fix l
    have n: is_ok(exc(l, pair("raise", exc_val("disc", empty)))) -> false proof
      assume h
      obtain a b, h2 from expand(h, is_ok)
      show by simp(h2)
    qed
    show by taut(n)
  qed
  have g := mp(mp(while_guard[l0 := pair(s, empty), b := l o. tr.rb(s, l, o), tr := l. fn_update(empty, "os.events", app(app(fst(l), "os"), "events")),
    p := l. tr.disc_ok(s, fst(l)), e := l. exc(l, pair("raise", exc_val("disc", empty))), r := x4], ne), expand(hw, tr.rw))
  have kept: while_rel(pair(s, empty), l. true, l o. (tr.disc_ok(s, fst(l)) && tr.rb(s, l, o)) || (!tr.disc_ok(s, fst(l)) && o = exc(l, pair("raise", exc_val("disc", empty)))),
      l. fn_update(empty, "os.events", app(app(fst(l), "os"), "events")), x4) -> tr.run_d(s, s, o) proof
    assume w
    have wd: tr.rwd(s, pair(s, empty), x4) by defs(w, tr.rwd, tr.rbd)
    show by defs(ex_intro({x4}, taut(wd, hm)), tr.run_d)
  qed
  have left: (ex l. while_rel(pair(s, empty), l. true, l o. (tr.disc_ok(s, fst(l)) && tr.rb(s, l, o)) || (!tr.disc_ok(s, fst(l)) && o = exc(l, pair("raise", exc_val("disc", empty)))),
      l. fn_update(empty, "os.events", app(app(fst(l), "os"), "events")), exc(l, pair("raise", exc_val("disc", empty))))) -> (ex x. tr.run_d(s, s, exc(x, exc_val("disc", empty)))) proof
    assume e
    obtain l, w from e
    have wd: tr.rwd(s, pair(s, empty), exc(l, pair("raise", exc_val("disc", empty)))) by defs(w, tr.rwd, tr.rbd)
    have rm: tr.rmap(exc(l, pair("raise", exc_val("disc", empty))), exc(fst(l), exc_val("disc", empty))) by defs(simp(), tr.rmap)
    have rd: tr.run_d(s, s, exc(fst(l), exc_val("disc", empty))) by defs(ex_intro({exc(l, pair("raise", exc_val("disc", empty)))}, taut(wd, rm)), tr.run_d)
    show by ex_intro({fst(l)}, rd)
  qed
  show by taut(g, kept, left)
qed

// (at the return, as one atom)
def tr.at_ret_d(s, x) := tr.at_ret(s, x)

// (a conditional's branches)
theorem tr.ite_t: all c a b. c -> ite(c, a, b) = a
proof
  fix c a b
  assume hc
  have ex1: ex x. (c && x = a) || (!c && x = b) by ex_intro({a}, taut(hc, refl({a})))
  have cs := mp(choose_spec[p := x. (c && x = a) || (!c && x = b)], ex1)
  have e: choose(x. (c && x = a) || (!c && x = b)) = a by taut(cs, hc)
  show by defs(e, ite)
qed

theorem tr.ite_f: all c a b. !c -> ite(c, a, b) = b
proof
  fix c a b
  assume hc
  have ex1: ex x. (c && x = a) || (!c && x = b) by ex_intro({b}, taut(hc, refl({b})))
  have cs := mp(choose_spec[p := x. (c && x = a) || (!c && x = b)], ex1)
  have e: choose(x. (c && x = a) || (!c && x = b)) = b by taut(cs, hc)
  show by defs(e, ite)
qed

// A crash (the stack overflowing): the machine faults where its stack could
// not grow (abi.overflow_at, at the fault), its I/O so far (input kept, events grown since s) that of
// an outcome of the spec from w where the I/O stops -- a stack overflow, or
// a divergence (abi.overflow_ok's, from the spec's point w; a divergence's
// trace not compared, as tr.div's; no return: the rules' crashes come
// from overflows)
def tr.ovf(p, w, os) :=
  (ex x. x in rec_and(abi.World, single(empty)) && runs(p, w, exc(x, exc_val("stack_overflow", empty))) && app(app(x, "os"), "events") = app(os, "events")) ||
  (ex t. runs(p, w, diverge(t)))
def tr.crash(s, p, w, o) :=
  ex m1 a k. oe: (o = exc(m1, exc_val("segv", pair(a, k))) && (k = 0 || k = 1 || k = 3) && abi.overflow_at(app(m1, "vm"), app(app(m1, "gpr"), 4), abi.sp(s), a) ||
      o = exc(m1, exc_val("stack_fault", empty))) && m1M: m1 in x86_64_linux.Machine && ab: a in bits(64) &&
    sev: subset(app(app(s, "os"), "events"), app(app(m1, "os"), "events")) && inp: app(app(s, "os"), "input") = app(app(m1, "os"), "input") &&
    io: (tr.ovf(p, w, app(m1, "os")) || app(app(s, "os"), "events") = app(app(m1, "os"), "events"))

// a divergence matched by one of the spec's (its trace not compared yet:
// docs/todo.md)
def tr.div(p, w, o) := (ex t. o = diverge(t)) && (ex t2. runs(p, w, diverge(t2)))


// a crash as the ABI's (abi.crashes_at), its I/O by tr.ovf (a divergence's
// trace not compared)
def tr.overflow_t(w, spec, args, os) := input: app(app(w, "os"), "input") = app(os, "input") &&
  events: (app(app(w, "os"), "events") = app(os, "events") || tr.ovf(app(spec, args), w, os))
def tr.crashes_t(spec, args, objs, mem, s, o) :=
  ex m1 a k. oe: (o = exc(m1, exc_val("segv", pair(a, k))) && (k = 0 || k = 1 || k = 3) && abi.overflow_at(app(m1, "vm"), app(app(m1, "gpr"), 4), abi.sp(s), a) ||
      o = exc(m1, exc_val("stack_fault", empty))) && m1M: m1 in x86_64_linux.Machine && ab: a in bits(64) &&
    sev: subset(app(app(s, "os"), "events"), app(app(m1, "os"), "events")) &&
    ovk: tr.overflow_t(abi.view(s, objs, mem), spec, args, app(m1, "os"))

// (at the entry: the claim's crash)
theorem tr.crash_at: all spec args s v mem o. tr.crash(s, app(spec, args), abi.view(s, v, mem), o) -> tr.crashes_t(spec, args, v, mem, s, o)
proof
  fix spec args s v mem o
  assume h
  obtain m1 a k, h3 from expand(h, tr.crash)
  have ein: app(app(abi.view(s, v, mem), "os"), "input") = app(app(s, "os"), "input") by simp()
  have hin := rewrite(sym(ein), h3.inp)
  have ho := h3.io
  // (the crash's events the entry's: the call overflowed)
  have c2: app(app(s, "os"), "events") = app(app(m1, "os"), "events") -> app(app(abi.view(s, v, mem), "os"), "events") = app(app(m1, "os"), "events") proof
    assume e
    have eev: app(app(abi.view(s, v, mem), "os"), "events") = app(app(s, "os"), "events") by simp()
    show := trans(eev, e)
  qed
  have ov: tr.overflow_t(abi.view(s, v, mem), spec, args, app(m1, "os")) by defs(taut(hin, ho, c2), tr.overflow_t)
  show by defs(ex_intro({m1}, {a}, {k}, taut(h3, ov)), tr.crashes_t)
qed

// (at the entry: the claim's raise is the ABI's)
theorem tr.ub_at: all spec args s v mem. tr.ub(s, v, app(spec, args), abi.view(s, v, mem)) -> abi.raises_at(spec, args, v, mem, s)
proof
  fix spec args s v mem
  assume h
  show by defs(expand(h, tr.ub), abi.raises_at)
qed

// (a crash is no divergence, no return)
theorem tr.crash_not_div: all s p w t. !tr.crash(s, p, w, diverge(t))
proof
  fix s p w t
  have n: tr.crash(s, p, w, diverge(t)) -> false proof
    assume k
    obtain m1 a c, {oe} from expand(k, tr.crash)
    show by simp(oe)
  qed
  show by taut(n)
qed

// ----------------------------------------------------------------------
//  The claim with breakpoints. The claim at a point is about the run from
//  there -- a step, then on -- to the first state that is a breakpoint:
//  one where the function has returned (rsp at or above the entry's sp,
//  tr.out: the stopping point set by rsp alone, so a deeper activation of
//  the function never stops it) or one of bp (a loop's head: a (rip, rsp)
//  of this activation). There the arrival condition holds: returned, the
//  spec returns as the machine did, at the ABI's return (tr.retok); at a
//  point of bp, ar of the state and of the spec reached (up to a
//  reduction). tr.sim is the claim leaving a state; tr.cl the claim at a
//  state reached (its arrival condition if it is a breakpoint, else the
//  claim leaving it).

def tr.red(p, w, p2, w2) := all o. runs(p2, w2, o) -> runs(p, w, o)
abbrev tr.out(s, x) := !int_lt(app(app(x, "gpr"), 4), abi.sp(s))
def tr.stopk(s, zb. bkp, m) := tr.out(s, m) || bkp(m)
def tr.rst(l, o) := bind_rel(x86_64_linux.step, fst(l), x7 x8. o = ok(pair(x7, empty), empty), x7 x8. o = exc(pair(x7, empty), pair("raise", x8)), x7. o = diverge(x7))
def tr.rbk(s, zb. bkp, l, o) := (tr.stopk(s, zb. bkp(zb), fst(l)) && o = exc(pair(fst(l), empty), pair("brk", empty))) ||
  (!tr.stopk(s, zb. bkp(zb), fst(l)) && tr.rst(l, o))
def tr.rwk(s, zb. bkp, l, r) := while_rel(l, x5. true, x5 x6. tr.rbk(s, zb. bkp(zb), x5, x6), x5. fn_update(empty, "os.events", app(app(fst(x5), "os"), "events")), r)
def tr.rk(s, zb. bkp, m, r) := (ex l1. tr.rst(pair(m, empty), ok(l1, empty)) && tr.rwk(s, zb. bkp(zb), l1, r)) || (tr.rst(pair(m, empty), r) && !is_ok(r))
def tr.run_k(s, zb. bkp, m, o) := ex r. tr.rk(s, zb. bkp(zb), m, r) && tr.rmap(r, o)

def tr.retok(s, v, p, w, m1) := m1 in x86_64_linux.Machine && m1 in univ(1) &&
  (ex w2. runs(p, w, ok(w2, pair(app(app(m1, "gpr"), 0), app(app(m1, "gpr"), 2)))) && w2 in abi.World && w2 in univ(1) &&
    abi.world_matches(app(s, "vm"), app(m1, "vm"), app(w2, "vm"), v, abi.sp(s)) && app(m1, "os") = app(w2, "os") && app(m1, "fs_base") = app(w2, "fs_base")) &&
  app(m1, "cpu") = app(s, "cpu") && app(m1, "gs_base") = app(s, "gs_base") && app(m1, "rip") = abi.ret(s) && app(app(m1, "gpr"), 4) = abi.sp(s) &&
  abi.callee_saved(m1, s) && !app(app(m1, "flags"), "df")
def tr.arr(s, zb. bkp, zb pb wb. bka, v, m, p, w) := (tr.out(s, m) -> tr.retok(s, v, p, w, m)) &&
  (!tr.out(s, m) -> bkp(m) -> (ex p2 w2. tr.red(p, w, p2, w2) && bka(m, p2, w2)))
def tr.gk(s, zb. bkp, zb pb wb. bka, v, p, w, o) := tr.ub(s, v, p, w) || tr.crash(s, p, w, o) || tr.div(p, w, o) ||
  (ex m1. o = ok(m1, empty) && tr.arr(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, m1, p, w))
def tr.sim(s, zb. bkp, zb pb wb. bka, v, p, w, m) := all o. tr.run_k(s, zb. bkp(zb), m, o) -> tr.gk(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, o)
def tr.cl(s, zb. bkp, zb pb wb. bka, v, p, w, m) := (tr.stopk(s, zb. bkp(zb), m) -> tr.arr(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, m, p, w)) &&
  (!tr.stopk(s, zb. bkp(zb), m) -> tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m))

// (a step that does not go on: a raise or a divergence)
theorem tr.rst_out: all l r. tr.rst(l, r) -> !is_ok(r) -> (fst(r) = 1 && fst(out_value(r)) = "raise") || fst(r) = 2
proof
  fix l r
  assume h hn
  show by simp(hn, expand(h, tr.rst, bind_rel), keep(x86_64_linux.step))
qed

// (a pass that goes on: from no stop, a step to a loop state)
theorem tr.rbk_ok(zb. bkp): all s l l2 e. tr.rbk(s, zb. bkp(zb), l, ok(l2, e)) -> !tr.stopk(s, zb. bkp(zb), fst(l)) && tr.rst(l, ok(l2, e)) && l2 = pair(fst(l2), empty)
proof
  fix s l l2 e
  assume h
  have c: !tr.stopk(s, zb. bkp(zb), fst(l)) && tr.rst(l, ok(l2, e)) by simp(expand(h, tr.rbk))
  have q: l2 = pair(fst(l2), empty) by simp(expand(c.2, tr.rst), keep(x86_64_linux.step))
  show by taut(c, q)
qed

// (the run's returns: at stops)
theorem tr.run_k_stop(zb. bkp): all s m m1 e. tr.run_k(s, zb. bkp(zb), m, ok(m1, e)) -> tr.stopk(s, zb. bkp(zb), m1)
proof
  fix s m m1 e
  assume h
  obtain r, rk rm from expand(h, tr.run_k)
  have o1: (fst(r) = 1 && fst(out_value(r)) = "raise") -> false proof
    assume e1
    have rm2 := rewrite(e1.2, expand(rm, tr.rmap))
    show by simp(rm2, e1.1)
  qed
  have o2: fst(r) = 2 -> false proof
    assume e1
    show by simp(expand(rm, tr.rmap), e1)
  qed
  have lv: all l. tr.stopk(s, zb. bkp(zb), fst(l)) && r = exc(pair(fst(l), empty), pair("brk", empty)) -> tr.stopk(s, zb. bkp(zb), m1) proof
    fix l
    assume hb
    have rm2 := rewrite(hb.2, expand(rm, tr.rmap))
    have me: m1 = fst(l) by simp(rm2)
    show := rewrite(sym(me), hb.1)
  qed
  have f1: tr.rst(pair(m, empty), r) && !is_ok(r) -> tr.stopk(s, zb. bkp(zb), m1) proof
    assume hb
    have ro := apply(tr.rst_out, {pair(m, empty)}, {r}, hb.1, hb.2)
    show by taut(ro, o1, o2)
  qed
  have f2: (ex l1. tr.rst(pair(m, empty), ok(l1, empty)) && tr.rwk(s, zb. bkp(zb), l1, r)) -> tr.stopk(s, zb. bkp(zb), m1) proof
    assume e
    obtain l1, _ hw from e
    have cs := mp(while_cases[l0 := l1, c := x5. true, b := x5 x6. tr.rbk(s, zb. bkp(zb), x5, x6), tr := x5. fn_update(empty, "os.events", app(app(fst(x5), "os"), "events")), r := r],
      expand(hw, tr.rwk))
    have d: (ex t. r = diverge(t)) -> tr.stopk(s, zb. bkp(zb), m1) proof
      assume ed
      obtain t, rt from ed
      have f: fst(r) = 2 by simp(rt)
      show by taut(mp(o2, f))
    qed
    have b: (ex l. (!true && r = ok(l, empty)) || (true && tr.rbk(s, zb. bkp(zb), l, r) && !is_ok(r))) -> tr.stopk(s, zb. bkp(zb), m1) proof
      assume el
      obtain l, hl from el
      have hb: tr.rbk(s, zb. bkp(zb), l, r) && !is_ok(r) by taut(hl)
      have c1: tr.stopk(s, zb. bkp(zb), fst(l)) && r = exc(pair(fst(l), empty), pair("brk", empty)) -> tr.stopk(s, zb. bkp(zb), m1) := all_elim(lv, {l})
      have c2: tr.rst(l, r) && !is_ok(r) -> tr.stopk(s, zb. bkp(zb), m1) proof
        assume hc
        have ro := apply(tr.rst_out, {l}, {r}, hc.1, hc.2)
        show by taut(ro, o1, o2)
      qed
      show by taut(expand(hb.1, tr.rbk), hb.2, c1, c2)
    qed
    show by taut(cs, d, b)
  qed
  show by taut(expand(rk, tr.rk), f1, f2)
qed

// (the outcome condition, its divergence: of any trace)
theorem tr.gk_div(zb. bkp, zb pb wb. bka): all s v p w t t2. tr.gk(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, diverge(t)) ->
  tr.gk(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, diverge(t2))
proof
  fix s v p w t t2
  assume h
  have nc := all_elim(tr.crash_not_div, {s}, {p}, {w}, {t})
  have d: tr.div(p, w, diverge(t)) -> tr.div(p, w, diverge(t2)) proof
    assume hd
    have e1: ex t3. diverge(t2) = diverge(t3) by ex_intro({t2}, refl({diverge(t2)}))
    show by defs(taut(expand(hd, tr.div).2, e1), tr.div)
  qed
  have k: (ex m1. diverge(t) = ok(m1, empty) && tr.arr(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, m1, p, w)) -> false proof
    assume e
    obtain m1, oe _ from e
    show by simp(oe)
  qed
  show by defs(taut(expand(h, tr.gk), nc, d, k), tr.gk)
qed

// the spec reduced: the arrival condition, the outcome condition, the claims
theorem tr.arr_red(zb. bkp, zb pb wb. bka): all s v p w p2 w2 m. tr.red(p, w, p2, w2) -> tr.arr(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, m, p2, w2) ->
  tr.arr(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, m, p, w)
proof
  fix s v p w p2 w2 m
  assume hr h
  have r := expand(hr, tr.red)
  have a1 a2 := expand(h, tr.arr)
  have b1: tr.out(s, m) -> tr.retok(s, v, p, w, m) proof
    assume o
    have rx := expand(mp(a1, o), tr.retok)
    have ew: ex w3. runs(p2, w2, ok(w3, pair(app(app(m, "gpr"), 0), app(app(m, "gpr"), 2)))) && w3 in abi.World && w3 in univ(1) &&
        abi.world_matches(app(s, "vm"), app(m, "vm"), app(w3, "vm"), v, abi.sp(s)) && app(m, "os") = app(w3, "os") && app(m, "fs_base") = app(w3, "fs_base") by taut(rx)
    obtain w3, h3 from ew
    have r1 := mp(all_elim(r, {ok(w3, pair(app(app(m, "gpr"), 0), app(app(m, "gpr"), 2)))}), h3.1)
    have ew2: ex w4. runs(p, w, ok(w4, pair(app(app(m, "gpr"), 0), app(app(m, "gpr"), 2)))) && w4 in abi.World && w4 in univ(1) &&
        abi.world_matches(app(s, "vm"), app(m, "vm"), app(w4, "vm"), v, abi.sp(s)) && app(m, "os") = app(w4, "os") && app(m, "fs_base") = app(w4, "fs_base")
      by ex_intro({w3}, taut(r1, h3))
    show by defs(taut(rx, ew2), tr.retok)
  qed
  have b2: !tr.out(s, m) -> bkp(m) -> (ex p3 w3. tr.red(p, w, p3, w3) && bka(m, p3, w3)) proof
    assume no hb
    obtain p3 w3, rd ha from mp(a2, no, hb)
    have rd2: tr.red(p, w, p3, w3) proof
      have g: all o. runs(p3, w3, o) -> runs(p, w, o) proof
        fix o
        assume ho
        show := mp(all_elim(r, {o}), mp(all_elim(expand(rd, tr.red), {o}), ho))
      qed
      show by defs(g, tr.red)
    qed
    show by ex_intro({p3}, {w3}, taut(rd2, ha))
  qed
  show by defs(taut(b1, b2), tr.arr)
qed

theorem tr.gk_red(zb. bkp, zb pb wb. bka): all s v p w p2 w2 o. tr.red(p, w, p2, w2) -> tr.gk(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p2, w2, o) ->
  tr.gk(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, o)
proof
  fix s v p w p2 w2 o
  assume hr h
  have r := expand(hr, tr.red)
  have u: tr.ub(s, v, p2, w2) -> tr.ub(s, v, p, w) proof
    assume hu
    obtain e x, he from expand(hu, tr.ub)
    have r1 := mp(all_elim(r, {exc(x, e)}), he.4)
    show by defs(ex_intro({e}, {x}, taut(he, r1)), tr.ub)
  qed
  have cr: tr.crash(s, p2, w2, o) -> tr.crash(s, p, w, o) proof
    assume hc
    obtain m1 a k0, c3 from expand(hc, tr.crash)
    have o2: tr.ovf(p2, w2, app(m1, "os")) -> tr.ovf(p, w, app(m1, "os")) proof
      assume hv
      show by defs(simp(r, expand(hv, tr.ovf)), tr.ovf)
    qed
    show by defs(ex_intro({m1}, {a}, {k0}, taut(c3, o2)), tr.crash)
  qed
  have dv: tr.div(p2, w2, o) -> tr.div(p, w, o) proof
    assume hd
    have hd1 hd2 := expand(hd, tr.div)
    obtain t2, rd from hd2
    have r1 := mp(all_elim(r, {diverge(t2)}), rd)
    have e2: ex t3. runs(p, w, diverge(t3)) by ex_intro({t2}, r1)
    show by defs(taut(hd1, e2), tr.div)
  qed
  have k: (ex m1. o = ok(m1, empty) && tr.arr(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, m1, p2, w2)) ->
      (ex m1. o = ok(m1, empty) && tr.arr(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, m1, p, w)) proof
    assume e
    obtain m1, oe ha from e
    have a := apply(tr.arr_red[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {p}, {w}, {p2}, {w2}, {m1}, hr, ha)
    show by ex_intro({m1}, taut(oe, a))
  qed
  show by defs(taut(expand(h, tr.gk), u, cr, dv, k), tr.gk)
qed

theorem tr.sim_red(zb. bkp, zb pb wb. bka): all s v p w p2 w2 m. tr.red(p, w, p2, w2) -> tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p2, w2, m) ->
  tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m)
proof
  fix s v p w p2 w2 m
  assume hr h
  have g: all o. tr.run_k(s, zb. bkp(zb), m, o) -> tr.gk(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, o) proof
    fix o
    assume ho
    have c := mp(all_elim(expand(h, tr.sim), {o}), ho)
    show := apply(tr.gk_red[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {p}, {w}, {p2}, {w2}, {o}, hr, c)
  qed
  show by defs(g, tr.sim)
qed

theorem tr.cl_red(zb. bkp, zb pb wb. bka): all s v p w p2 w2 m. tr.red(p, w, p2, w2) -> tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p2, w2, m) ->
  tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m)
proof
  fix s v p w p2 w2 m
  assume hr h
  have c1 c2 := expand(h, tr.cl)
  have d1: tr.stopk(s, zb. bkp(zb), m) -> tr.arr(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, m, p, w) proof
    assume st
    show := apply(tr.arr_red[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {p}, {w}, {p2}, {w2}, {m}, hr, mp(c1, st))
  qed
  have d2: !tr.stopk(s, zb. bkp(zb), m) -> tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m) proof
    assume st
    show := apply(tr.sim_red[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {p}, {w}, {p2}, {w2}, {m}, hr, mp(c2, st))
  qed
  show by defs(taut(d1, d2), tr.cl)
qed

// the claim at a state reached, for the run of passes from it: its
// outcome condition
theorem tr.cl_rwk(zb. bkp, zb pb wb. bka): all s v p w m2 r o. tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m2) ->
  tr.rwk(s, zb. bkp(zb), pair(m2, empty), r) -> tr.rmap(r, o) -> tr.gk(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, o)
proof
  fix s v p w m2 r o
  assume hc hw hm
  let G(o2) := tr.gk(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, o2)
  have c1 c2 := expand(hc, tr.cl)
  have fe: fst(pair(m2, empty)) = m2 by simp()
  have un := mp(while_unroll[l0 := pair(m2, empty), c := x5. true, b := x5 x6. tr.rbk(s, zb. bkp(zb), x5, x6),
    tr := x5. fn_update(empty, "os.events", app(app(fst(x5), "os"), "events")), r := r], expand(hw, tr.rwk))
  // a stop: the run ends at m2, its arrival
  have u1: tr.rbk(s, zb. bkp(zb), pair(m2, empty), r) && !is_ok(r) -> G(o) proof
    assume hb
    have rb := rewrite(fe, expand(hb.1, tr.rbk))
    have a: tr.stopk(s, zb. bkp(zb), m2) && r = exc(pair(m2, empty), pair("brk", empty)) -> G(o) proof
      assume e
      have rm2 := rewrite(e.2, expand(hm, tr.rmap))
      have oe: o = ok(m2, empty) by simp(rm2)
      have ar0 := mp(c1, e.1)
      have ex1: ex m1. o = ok(m1, empty) && tr.arr(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, m1, p, w) by ex_intro({m2}, taut(oe, ar0))
      show by defs(taut(ex1), tr.gk)
    qed
    have b: !tr.stopk(s, zb. bkp(zb), m2) && tr.rst(pair(m2, empty), r) -> G(o) proof
      assume e
      have rk: tr.rk(s, zb. bkp(zb), m2, r) by defs(taut(e.2, hb.2), tr.rk)
      have rn: tr.run_k(s, zb. bkp(zb), m2, o) by defs(ex_intro({r}, taut(rk, hm)), tr.run_k)
      show := mp(all_elim(expand(mp(c2, e.1), tr.sim), {o}), rn)
    qed
    show by taut(rb, a, b)
  qed
  // a step from m2 (no stop), the run going on
  have u2: (ex l1. tr.rbk(s, zb. bkp(zb), pair(m2, empty), ok(l1, empty)) && (ex r1. while_rel(l1, x5. true, x5 x6. tr.rbk(s, zb. bkp(zb), x5, x6),
      x5. fn_update(empty, "os.events", app(app(fst(x5), "os"), "events")), r1) && fst(r1) = fst(r) && (!(fst(r) = 2) -> r1 = r))) -> G(o) proof
    assume e
    obtain l1, hb er from e
    obtain r1, w1 f1 e1 from er
    have nst rs _ := apply(tr.rbk_ok[bkp := zb. bkp(zb)], {s}, {pair(m2, empty)}, {l1}, {empty}, hb)
    have nst2 := rewrite(fe, nst)
    have rw1: tr.rwk(s, zb. bkp(zb), l1, r1) by defs(w1, tr.rwk)
    have ex1: ex l2. tr.rst(pair(m2, empty), ok(l2, empty)) && tr.rwk(s, zb. bkp(zb), l2, r1) by ex_intro({l1}, taut(rs, rw1))
    have rk: tr.rk(s, zb. bkp(zb), m2, r1) by defs(taut(ex1), tr.rk)
    have sm := expand(mp(c2, nst2), tr.sim)
    have nd: !(fst(r) = 2) -> G(o) proof
      assume n
      have re := mp(e1, n)
      have rn: tr.run_k(s, zb. bkp(zb), m2, o) by defs(ex_intro({r1}, taut(rk, rewrite(sym(re), hm))), tr.run_k)
      show := mp(all_elim(sm, {o}), rn)
    qed
    have dd: fst(r) = 2 -> G(o) proof
      assume d
      have d1: fst(r1) = 2 by simp(f1, d)
      have rm1: tr.rmap(r1, diverge(snd(r1))) by defs(simp(d1), tr.rmap)
      have rn: tr.run_k(s, zb. bkp(zb), m2, diverge(snd(r1))) by defs(ex_intro({r1}, taut(rk, rm1)), tr.run_k)
      have g1 := mp(all_elim(sm, {diverge(snd(r1))}), rn)
      have od: o = diverge(snd(r)) by simp(expand(hm, tr.rmap), d)
      have g2 := apply(tr.gk_div[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {p}, {w}, {snd(r1)}, {snd(r)}, g1)
      show := rewrite(sym(od), g2)
    qed
    show by taut(nd, dd)
  qed
  have u0: (!true && r = ok(pair(m2, empty), empty)) -> G(o) proof
    assume e
    show by taut(e)
  qed
  show by taut(un, u0, u1, u2)
qed

// a step that may fault: its successors' claims, and every fault a crash
// or undefined
theorem tr.step_x(s, zb. bkp, zb pb wb. bka, v, p, w, m, x. q, x y. qx): (all o. runs(x86_64_linux.step(), m, o) -> (ex m2. o = ok(m2, empty) && q(m2)) || (ex x e. o = exc(x, e) && qx(x, e))) ->
  int_lt(app(app(m, "gpr"), 4), abi.sp(s)) -> (all m2. q(m2) -> tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m2)) ->
  (all x e. qx(x, e) -> tr.ub(s, v, p, w) || tr.crash(s, p, w, exc(x, e))) -> tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m)
proof
  assume hs hlt h hx
  let G(o2) := tr.gk(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, o2)
  have g: all o. tr.run_k(s, zb. bkp(zb), m, o) -> G(o) proof
    fix o
    assume ho
    obtain r, rk rm from expand(ho, tr.run_k)
    // the step to m2 with q, the run on from there
    have ca: (ex l1. tr.rst(pair(m, empty), ok(l1, empty)) && tr.rwk(s, zb. bkp(zb), l1, r)) -> G(o) proof
      assume e
      obtain l1, rs rw from e
      have b1: ex x1. runs(x86_64_linux.step(), m, x1) && (ex x2 x3. x1 = ok(x2, x3) && l1 = pair(x2, empty)) by simp(expand(rs, tr.rst), keep(x86_64_linux.step))
      obtain x1, c1 from b1
      have e0 := mp(all_elim(hs, {x1}), taut(c1))
      have c2: (ex x e. x1 = exc(x, e) && qx(x, e)) -> false proof
        assume ex
        obtain x e3, ex3 from ex
        show by simp(c1, ex3, keep(x86_64_linux.step))
      qed
      have e1: ex m2. x1 = ok(m2, empty) && q(m2) by taut(e0, c2)
      obtain m2, e2 from e1
      have l1e: l1 = pair(m2, empty) by simp(c1, e2, keep(x86_64_linux.step))
      have cl2 := mp(all_elim(h, {m2}), e2.2)
      have rw2 := rewrite(l1e, rw)
      show := apply(tr.cl_rwk[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {p}, {w}, {m2}, {r}, {o}, cl2, rw2, rm)
    qed
    // the step faults: the fault's condition
    have cb: tr.rst(pair(m, empty), r) && !is_ok(r) -> G(o) proof
      assume hb
      have b1: ex x1. runs(x86_64_linux.step(), m, x1) && ((ex x2 x3. x1 = ok(x2, x3) && r = ok(pair(x2, empty), empty)) ||
        (ex x2 x3. x1 = exc(x2, x3) && r = exc(pair(x2, empty), pair("raise", x3))) || (ex x2. x1 = diverge(x2) && r = diverge(x2))) by simp(expand(hb.1, tr.rst), keep(x86_64_linux.step))
      obtain x1, c1 from b1
      have e0 := mp(all_elim(hs, {x1}), taut(c1))
      have k1: (ex m2. x1 = ok(m2, empty) && q(m2)) -> G(o) proof
        assume ek
        obtain m2, e2 from ek
        have f: false by simp(c1, e2, hb.2, keep(x86_64_linux.step))
        show by taut(f)
      qed
      have k2: (ex x e. x1 = exc(x, e) && qx(x, e)) -> G(o) proof
        assume ek
        obtain x e3, ek3 from ek
        have re: r = exc(pair(x, empty), pair("raise", e3)) by simp(c1, ek3, keep(x86_64_linux.step))
        have rm2 := rewrite(re, expand(rm, tr.rmap))
        have oe: o = exc(x, e3) by simp(rm2)
        have c := mp(all_elim(hx, {x}, {e3}), ek3.2)
        have g2: G(exc(x, e3)) by defs(taut(c), tr.gk)
        show := rewrite(sym(oe), g2)
      qed
      show by taut(e0, k1, k2)
    qed
    show by taut(expand(rk, tr.rk), ca, cb)
  qed
  show by defs(g, tr.sim)
qed

// (the steps from m end in states with q: an instruction's effect, its
// flags left open where the model havocs them)
theorem tr.step(s, zb. bkp, zb pb wb. bka, v, p, w, m, x. q): (all o. runs(x86_64_linux.step(), m, o) -> (ex m2. o = ok(m2, empty) && q(m2))) ->
  int_lt(app(app(m, "gpr"), 4), abi.sp(s)) -> (all m2. q(m2) -> tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m2)) ->
  tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m)
proof
  assume hs hlt h
  have hs2: all o. runs(x86_64_linux.step(), m, o) -> (ex m2. o = ok(m2, empty) && q(m2)) || (ex x e. o = exc(x, e) && false) proof
    fix o
    assume ho
    have c := mp(all_elim(hs, {o}), ho)
    show by taut(c)
  qed
  have hx: all x e. false -> tr.ub(s, v, p, w) || tr.crash(s, p, w, exc(x, e)) proof
    fix x e
    assume f
    show by taut(f)
  qed
  show := mp(tr.step_x[s := s, bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb), v := v, p := p, w := w, m := m, q := x. q(x), qx := x y. false], hs2, hlt, h, hx)
qed

// (the return reached: the claim there, the spec's return as the machine's)
theorem tr.cl_ret(zb. bkp, zb pb wb. bka): all s v p w m. tr.out(s, m) -> tr.retok(s, v, p, w, m) -> tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m)
proof
  fix s v p w m
  assume ho hr
  have st: tr.stopk(s, zb. bkp(zb), m) by defs(taut(ho), tr.stopk)
  have a: tr.arr(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, m, p, w) by defs(taut(ho, hr), tr.arr)
  show by defs(taut(st, a), tr.cl)
qed

// (a state that is no stop: the claim leaving it, the claim reaching it)
theorem tr.sim_cl(zb. bkp, zb pb wb. bka): all s v p w m. int_lt(app(app(m, "gpr"), 4), abi.sp(s)) -> !bkp(m) ->
  tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m) -> tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m)
proof
  fix s v p w m
  assume hl hb h
  have ns: !tr.stopk(s, zb. bkp(zb), m) by defs(taut(hl, hb), tr.stopk)
  show by defs(taut(ns, h), tr.cl)
qed

// (an outcome tagged 2: the pass loop's divergence)
theorem tr.rmap_div: all r o. tr.rmap(r, o) -> fst(o) = 2 -> o = diverge(snd(r))
proof
  fix r o
  assume hm d
  show by simp(expand(hm, tr.rmap), d)
qed

// (a disciplined run's outcome tagged 2: a divergence)
theorem tr.rwd_div: all c l r. while_rel(l, x5. true, x5 x6. tr.rbd(c, x5, x6), x5. fn_update(empty, "os.events", app(app(fst(x5), "os"), "events")), r) -> fst(r) = 2 ->
  ex t. r = diverge(t)
proof
  fix c l r
  assume hw d
  have cs := mp(while_cases[l0 := l, c := x5. true, b := x5 x6. tr.rbd(c, x5, x6), tr := x5. fn_update(empty, "os.events", app(app(fst(x5), "os"), "events")), r := r], hw)
  have b: (ex l2. (!true && r = ok(l2, empty)) || (true && tr.rbd(c, l2, r) && !is_ok(r))) -> ex t. r = diverge(t) proof
    assume e
    obtain l2, hl from e
    have hb: tr.rbd(c, l2, r) by taut(hl)
    show by simp(expand(hb, tr.rbd, tr.rb, bind_rel), d, keep(x86_64_linux.step))
  qed
  show by taut(cs, b)
qed

// The caller's run from a callee's entry c (the callee's sp at most the
// caller's, no breakpoint of the caller below the callee's sp): the
// callee's disciplined run (to some outcome of the same kind), or the
// callee returns to x and the caller's passes go on from x, or the callee
// leaves its discipline
theorem tr.run_split_k(zb. bkp): all s c o. s in x86_64_linux.Machine -> int_le(abi.sp(c), abi.sp(s)) -> int_lt(app(app(c, "gpr"), 4), abi.sp(c)) ->
  (all z. int_lt(app(app(z, "gpr"), 4), abi.sp(c)) -> !bkp(z)) -> tr.run_k(s, zb. bkp(zb), c, o) ->
  (ex o1. tr.run_d(c, c, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2))) ||
  (ex x r1 o1. tr.run_d(c, c, ok(x, empty)) && tr.rwk(s, zb. bkp(zb), pair(x, empty), r1) && tr.rmap(r1, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2))) ||
  (ex x. tr.run_d(c, c, exc(x, exc_val("disc", empty))))
proof
  fix s c o
  assume hM hsp hcl hbx hr
  let G := (ex o1. tr.run_d(c, c, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2))) ||
    (ex x r1 o1. tr.run_d(c, c, ok(x, empty)) && tr.rwk(s, zb. bkp(zb), pair(x, empty), r1) && tr.rmap(r1, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2))) ||
    (ex x. tr.run_d(c, c, exc(x, exc_val("disc", empty))))
  let P(l) := !tr.at_ret(c, fst(l)) && int_lt(app(app(fst(l), "gpr"), 4), abi.sp(c))
  let E(l) := ite(tr.at_ret_d(c, fst(l)), exc(pair(fst(l), empty), pair("brk", empty)), exc(l, pair("raise", exc_val("disc", empty))))
  let TR(l) := fn_update(empty, "os.events", app(app(fst(l), "os"), "events"))
  have r4 := apply(x86i.rsp_typed, hM)
  have spb: abi.sp(s) in bits(64) by simp(r4)
  obtain r, rk hm from expand(hr, tr.run_k)
  // (inside the callee: the caller's pass, the callee's disciplined one)
  have pb: all l o2. P(l) -> tr.rbk(s, zb. bkp(zb), l, o2) -> tr.rbd(c, l, o2) proof
    fix l o2
    assume hp hb
    have nar lt := hp
    have lt2: int_lt(app(app(fst(l), "gpr"), 4), abi.sp(s)) by arith(lt, hsp)
    have nb := mp(all_elim(hbx, {fst(l)}), lt)
    have ns: !tr.stopk(s, zb. bkp(zb), fst(l)) by defs(taut(lt2, nb), tr.stopk)
    have rs: tr.rst(l, o2) by taut(expand(hb, tr.rbk), ns)
    have dok: tr.disc_ok(c, fst(l)) by taut(lt)
    have rb: tr.rb(c, l, o2) by defs(taut(nar, expand(rs, tr.rst)), tr.rb)
    show by defs(taut(dok, rb), tr.rbd)
  qed
  // (the first pass, from c: the callee's)
  have pc: P(pair(c, empty)) proof
    have ne: app(app(c, "gpr"), 4) = abi.sp(c) -> false proof
      assume e
      show by arith(e, hcl)
    qed
    have nar: !tr.at_ret(c, c) by taut(ne)
    show by simp(nar, hcl)
  qed
  have p0: all o2. tr.rst(pair(c, empty), o2) -> tr.rbd(c, pair(c, empty), o2) proof
    fix o2
    assume hs
    have nar lt := pc
    have dok: tr.disc_ok(c, fst(pair(c, empty))) by taut(lt)
    have rb: tr.rb(c, pair(c, empty), o2) by defs(taut(nar, expand(hs, tr.rst)), tr.rb)
    show by defs(taut(dok, rb), tr.rbd)
  qed
  have he: all l. !is_ok(E(l)) proof
    fix l
    have n: is_ok(E(l)) -> false proof
      assume h
      obtain a b, h2 from expand(h, is_ok)
      have c1: tr.at_ret_d(c, fst(l)) -> false proof
        assume ar
        have et := apply(tr.ite_t, {tr.at_ret_d(c, fst(l))}, {exc(pair(fst(l), empty), pair("brk", empty))}, {exc(l, pair("raise", exc_val("disc", empty)))}, ar)
        show by simp(rewrite(et, h2))
      qed
      have c2: !tr.at_ret_d(c, fst(l)) -> false proof
        assume nar
        have ef := apply(tr.ite_f, {tr.at_ret_d(c, fst(l))}, {exc(pair(fst(l), empty), pair("brk", empty))}, {exc(l, pair("raise", exc_val("disc", empty)))}, nar)
        show by simp(rewrite(ef, h2))
      qed
      show by taut(c1, c2)
    qed
    show by taut(n)
  qed
  // the first pass leaves: the callee's run
  have k2: tr.rst(pair(c, empty), r) && !is_ok(r) -> G proof
    assume e
    have rb := mp(all_elim(p0, {r}), e.1)
    have tt: true by taut()
    have w := mp(while_leave[l0 := pair(c, empty), c := x5. true, b := x5 x6. tr.rbd(c, x5, x6), tr := x5. TR(x5), r := r], tt, rb, e.2)
    have wd: tr.rwd(c, pair(c, empty), r) by defs(w, tr.rwd)
    have rd: tr.run_d(c, c, o) by defs(ex_intro({r}, taut(wd, hm)), tr.run_d)
    have e1: ex o1. tr.run_d(c, c, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2)) by ex_intro({o}, taut(rd, refl({o})))
    show by taut(e1)
  qed
  // the first pass goes on to l1: the passes from l1, cut where the callee
  // returns or leaves its discipline
  have k1: (ex l1. tr.rst(pair(c, empty), ok(l1, empty)) && tr.rwk(s, zb. bkp(zb), l1, r)) -> G proof
    assume e
    obtain l1, rs0 rw from e
    have rb0 := mp(all_elim(p0, {ok(l1, empty)}), rs0)
    have tt: true by taut()
    have q1: l1 = pair(fst(l1), empty) by simp(expand(rs0, tr.rst), keep(x86_64_linux.step))
    have hq: all l l2. l = pair(fst(l), empty) -> tr.rbk(s, zb. bkp(zb), l, ok(l2, empty)) -> l2 = pair(fst(l2), empty) proof
      fix l l2
      assume _ hb
      have c3 := apply(tr.rbk_ok[bkp := zb. bkp(zb)], {s}, {l}, {l2}, {empty}, hb)
      show by taut(c3)
    qed
    have sp := mp(while_split[l0 := l1, b := l o2. tr.rbk(s, zb. bkp(zb), l, o2), tr := l. TR(l), p := l. P(l), e := l. E(l), r := r, q := l. l = pair(fst(l), empty)],
      he, q1, hq, expand(rw, tr.rwk))
    // the guarded passes: the callee's
    have gb: all l o2. (P(l) && tr.rbk(s, zb. bkp(zb), l, o2)) || (!P(l) && o2 = E(l)) -> tr.rbd(c, l, o2) proof
      fix l o2
      assume h
      have in: P(l) -> tr.rbd(c, l, o2) proof
        assume hp
        have b1: tr.rbk(s, zb. bkp(zb), l, o2) by taut(h, hp)
        show := mp(all_elim(pb, {l}, {o2}), hp, b1)
      qed
      have out: !P(l) -> tr.rbd(c, l, o2) proof
        assume np
        have eo: o2 = E(l) by taut(h, np)
        have c1: tr.at_ret_d(c, fst(l)) -> tr.rbd(c, l, o2) proof
          assume ar
          have et := apply(tr.ite_t, {tr.at_ret_d(c, fst(l))}, {exc(pair(fst(l), empty), pair("brk", empty))}, {exc(l, pair("raise", exc_val("disc", empty)))}, ar)
          have eo2 := rewrite(et, eo)
          have ar2: tr.at_ret(c, fst(l)) by defs(ar, tr.at_ret_d)
          show by defs(simp(eo2, ar2, keep(x86_64_linux.step)), tr.rbd, tr.rb)
        qed
        have c2: !tr.at_ret_d(c, fst(l)) -> tr.rbd(c, l, o2) proof
          assume nar
          have ef := apply(tr.ite_f, {tr.at_ret_d(c, fst(l))}, {exc(pair(fst(l), empty), pair("brk", empty))}, {exc(l, pair("raise", exc_val("disc", empty)))}, nar)
          have eo2 := rewrite(ef, eo)
          have nar2: !tr.at_ret(c, fst(l)) by defs(nar, tr.at_ret_d)
          have nlt: !int_lt(app(app(fst(l), "gpr"), 4), abi.sp(c)) by taut(np, nar2)
          show by defs(simp(eo2, nar2, nlt, keep(x86_64_linux.step)), tr.rbd, tr.rb)
        qed
        show by taut(c1, c2)
      qed
      show by taut(in, out)
    qed
    // throughout: the callee's run (the first pass prepended)
    have ca: while_rel(l1, l. true, l o2. (P(l) && tr.rbk(s, zb. bkp(zb), l, o2)) || (!P(l) && o2 = E(l)), l. TR(l), r) -> G proof
      assume w
      have w2 := mp(while_mono[l0 := l1, c := l. true, b1 := l o2. (P(l) && tr.rbk(s, zb. bkp(zb), l, o2)) || (!P(l) && o2 = E(l)), b2 := l o2. tr.rbd(c, l, o2),
        tr := l. TR(l), r := r], gb, w)
      have nd: !(fst(r) = 2) -> G proof
        assume n
        have w3 := mp(while_step[l0 := pair(c, empty), l1 := l1, c := l. true, b := l o2. tr.rbd(c, l, o2), tr := l. TR(l), r := r], tt, rb0, w2, n)
        have wd: tr.rwd(c, pair(c, empty), r) by defs(w3, tr.rwd)
        have rd: tr.run_d(c, c, o) by defs(ex_intro({r}, taut(wd, hm)), tr.run_d)
        have e1: ex o1. tr.run_d(c, c, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2)) by ex_intro({o}, taut(rd, refl({o})))
        show by taut(e1)
      qed
      have dd: fst(r) = 2 -> G proof
        assume d
        obtain t0, rd0 from apply(tr.rwd_div, {c}, {l1}, {r}, w2, d)
        have w2d := rewrite(rd0, w2)
        obtain t2, w3 from mp(while_step_div[l0 := pair(c, empty), l1 := l1, c := l. true, b := l o2. tr.rbd(c, l, o2), tr := l. TR(l), t := t0], tt, rb0, w2d)
        have wd: tr.rwd(c, pair(c, empty), diverge(t2)) by defs(w3, tr.rwd)
        have rm2: tr.rmap(diverge(t2), diverge(t2)) by defs(simp(), tr.rmap)
        have rd: tr.run_d(c, c, diverge(t2)) by defs(ex_intro({diverge(t2)}, taut(wd, rm2)), tr.run_d)
        have od: fst(o) = 2 by simp(expand(hm, tr.rmap), d)
        have f2: fst(diverge(t2)) = 2 by simp()
        have e1: ex o1. tr.run_d(c, c, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2)) by ex_intro({diverge(t2)}, taut(rd, f2, od))
        show by taut(e1)
      qed
      show by taut(nd, dd)
    qed
    // left at l: the callee's return (the caller's passes on from it) or
    // its leaving the discipline
    have cb: (ex l. l = pair(fst(l), empty) && while_rel(l1, l. true, l o2. (P(l) && tr.rbk(s, zb. bkp(zb), l, o2)) || (!P(l) && o2 = E(l)), l. TR(l), E(l)) &&
        (ex r1. while_rel(l, l. true, l o2. tr.rbk(s, zb. bkp(zb), l, o2), l. TR(l), r1) && fst(r1) = fst(r) && (!(fst(r) = 2) -> r1 = r))) -> G proof
      assume h
      obtain l, ql wg er1 from h
      have w2 := mp(while_mono[l0 := l1, c := l. true, b1 := l o2. (P(l) && tr.rbk(s, zb. bkp(zb), l, o2)) || (!P(l) && o2 = E(l)), b2 := l o2. tr.rbd(c, l, o2),
        tr := l. TR(l), r := E(l)], gb, wg)
      have nd0: fst(E(l)) = 2 -> false proof
        assume d
        have c1: tr.at_ret_d(c, fst(l)) -> false proof
          assume ar
          have et := apply(tr.ite_t, {tr.at_ret_d(c, fst(l))}, {exc(pair(fst(l), empty), pair("brk", empty))}, {exc(l, pair("raise", exc_val("disc", empty)))}, ar)
          show by simp(rewrite(et, d))
        qed
        have c2: !tr.at_ret_d(c, fst(l)) -> false proof
          assume nar
          have ef := apply(tr.ite_f, {tr.at_ret_d(c, fst(l))}, {exc(pair(fst(l), empty), pair("brk", empty))}, {exc(l, pair("raise", exc_val("disc", empty)))}, nar)
          show by simp(rewrite(ef, d))
        qed
        show by taut(c1, c2)
      qed
      have w3 := mp(while_step[l0 := pair(c, empty), l1 := l1, c := l. true, b := l o2. tr.rbd(c, l, o2), tr := l. TR(l), r := E(l)], tt, rb0, w2, taut(nd0))
      have wd: tr.rwd(c, pair(c, empty), E(l)) by defs(w3, tr.rwd)
      have c1: tr.at_ret_d(c, fst(l)) -> G proof
        assume ar
        have ee := apply(tr.ite_t, {tr.at_ret_d(c, fst(l))}, {exc(pair(fst(l), empty), pair("brk", empty))}, {exc(l, pair("raise", exc_val("disc", empty)))}, ar)
        have wd2 := rewrite(ee, wd)
        have rm: tr.rmap(exc(pair(fst(l), empty), pair("brk", empty)), ok(fst(l), empty)) by defs(simp(), tr.rmap)
        have rc: tr.run_d(c, c, ok(fst(l), empty)) by defs(ex_intro({exc(pair(fst(l), empty), pair("brk", empty))}, taut(wd2, rm)), tr.run_d)
        obtain r1, wr1 f4 re4 from er1
        have wr2 := rewrite(ql, wr1)
        have wk: tr.rwk(s, zb. bkp(zb), pair(fst(l), empty), r1) by defs(wr2, tr.rwk)
        have same: !(fst(r) = 2) -> G proof
          assume n
          have re := mp(re4, n)
          have rm1 := rewrite(sym(re), hm)
          have e1: ex x r2 o1. tr.run_d(c, c, ok(x, empty)) && tr.rwk(s, zb. bkp(zb), pair(x, empty), r2) && tr.rmap(r2, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2))
            by ex_intro({fst(l)}, {r1}, {o}, taut(rc, wk, rm1, refl({o})))
          show by taut(e1)
        qed
        have div: fst(r) = 2 -> G proof
          assume d
          have d1: fst(r1) = 2 by simp(f4, d)
          have rm1: tr.rmap(r1, diverge(snd(r1))) by defs(simp(d1), tr.rmap)
          have od: fst(o) = 2 by simp(expand(hm, tr.rmap), d)
          have f2: fst(diverge(snd(r1))) = 2 by simp()
          have e1: ex x r2 o1. tr.run_d(c, c, ok(x, empty)) && tr.rwk(s, zb. bkp(zb), pair(x, empty), r2) && tr.rmap(r2, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2))
            by ex_intro({fst(l)}, {r1}, {diverge(snd(r1))}, taut(rc, wk, rm1, f2, od))
          show by taut(e1)
        qed
        show by taut(same, div)
      qed
      have c2: !tr.at_ret_d(c, fst(l)) -> G proof
        assume nar
        have ee := apply(tr.ite_f, {tr.at_ret_d(c, fst(l))}, {exc(pair(fst(l), empty), pair("brk", empty))}, {exc(l, pair("raise", exc_val("disc", empty)))}, nar)
        have wd2 := rewrite(ee, wd)
        have rm: tr.rmap(exc(l, pair("raise", exc_val("disc", empty))), exc(fst(l), exc_val("disc", empty))) by defs(simp(), tr.rmap)
        have rc: tr.run_d(c, c, exc(fst(l), exc_val("disc", empty))) by defs(ex_intro({exc(l, pair("raise", exc_val("disc", empty)))}, taut(wd2, rm)), tr.run_d)
        have e1: ex x. tr.run_d(c, c, exc(x, exc_val("disc", empty))) by ex_intro({fst(l)}, rc)
        show by taut(e1)
      qed
      show by taut(c1, c2)
    qed
    show by taut(sp, ca, cb)
  qed
  show by taut(expand(rk, tr.rk), k1, k2)
qed

// (rsp as at the entry, below 2^47: below the entry's sp)
theorem tr.sp_lt: all x. x in bits(64) -> int_lt(x, 140737488355328) -> int_lt(x, bits_add(64, x, 8))
proof
  fix x
  assume hx hl
  have p64: pow2(64) = 18446744073709551616 by simp()
  have e0: int_mod(int_add(x, 8), 18446744073709551616) = int_add(x, 8) by arith(hx, hl)
  have e: bits_add(64, x, 8) = int_add(x, 8) by defs(rewrite(sym(p64), e0), bits_add)
  have l0: int_lt(x, int_add(x, 8)) by arith(hx)
  show := rewrite(sym(e), l0)
qed

// at the entry: abi.matches_at -- a run breaking the discipline is one only
// where the spec raises (its disciplined run then leaves with disc, which
// is no normal return, no crash)
// (a return: the ABI's return case, which does not ask m1 in univ(1))
theorem tr.ok_abi: all s v p w o. tr.ok(s, v, p, w, o) ->
  (ex m1 w2. o = ok(m1, empty) && m1 in x86_64_linux.Machine &&
    runs(p, w, ok(w2, pair(app(app(m1, "gpr"), 0), app(app(m1, "gpr"), 2)))) && w2 in abi.World && w2 in univ(1) &&
    abi.world_matches(app(s, "vm"), app(m1, "vm"), app(w2, "vm"), v, abi.sp(s)) && app(m1, "os") = app(w2, "os") && app(m1, "fs_base") = app(w2, "fs_base") &&
    app(m1, "cpu") = app(s, "cpu") && app(m1, "gs_base") = app(s, "gs_base") && app(m1, "rip") = abi.ret(s) && app(app(m1, "gpr"), 4) = abi.sp(s) &&
    abi.callee_saved(m1, s) && !app(app(m1, "flags"), "df"))
proof
  fix s v p w o
  assume h
  obtain m1 w2, h2 from expand(h, tr.ok)
  show by ex_intro({m1}, {w2}, taut(h2))
qed

// abi.matches, its divergence case without the trace: the machine diverges
// where the spec may (tr.div)
def tr.matches_t(spec, args, objs, mem, s, o) :=
  abi.raises_at(spec, args, objs, mem, s) ||
  (ex m1 w2. o = ok(m1, empty) && m1 in x86_64_linux.Machine && m1 in univ(1) &&
    runs(app(spec, args), abi.view(s, objs, mem), ok(w2, pair(app(app(m1, "gpr"), 0), app(app(m1, "gpr"), 2)))) && w2 in abi.World && w2 in univ(1) &&
    abi.world_matches(app(s, "vm"), app(m1, "vm"), app(w2, "vm"), objs, abi.sp(s)) && app(m1, "os") = app(w2, "os") && app(m1, "fs_base") = app(w2, "fs_base") &&
    app(m1, "cpu") = app(s, "cpu") && app(m1, "gs_base") = app(s, "gs_base") && app(m1, "rip") = abi.ret(s) && app(app(m1, "gpr"), 4) = abi.sp(s) &&
    abi.callee_saved(m1, s) && !app(app(m1, "flags"), "df")) ||
  tr.crashes_t(spec, args, objs, mem, s, o) || tr.div(app(spec, args), abi.view(s, objs, mem), o)

// a spec diverges only where it raises (undefined): so for a contract,
// whose effect has no loop -- the ABI's claim then has no divergence to
// match
def tr.div_raises(spec) := all args w t. args in abi.ARGS -> w in abi.World -> w in univ(1) -> runs(app(spec, args), w, diverge(t)) ->
  (ex e x. e in univ(1) && !(e = exc_val("stack_overflow", empty)) && abi.raise_state(x) && runs(app(spec, args), w, exc(x, e)))

// (the claim's crash is the ABI's, or the spec diverges where the I/O
// stops -- so it raises, for a spec that diverges only so)
theorem tr.crashes_abi: all spec args objs mem s o. tr.div_raises(spec) -> args in abi.ARGS -> abi.view(s, objs, mem) in abi.World -> abi.view(s, objs, mem) in univ(1) ->
  tr.crashes_t(spec, args, objs, mem, s, o) -> abi.crashes_at(spec, args, objs, mem, s, o) || abi.raises_at(spec, args, objs, mem, s)
proof
  fix spec args objs mem s o
  assume hd hA hvW hvu h
  obtain m1 a k, {oe, m1M, ab, sev, ovk} from expand(h, tr.crashes_t)
  have inp ev := expand(ovk, tr.overflow_t)
  let W := abi.view(s, objs, mem)
  have cr: abi.overflow_ok(rec_and(abi.World, single(empty)), W, spec, args, app(m1, "os")) -> abi.crashes_at(spec, args, objs, mem, s, o) proof
    assume ov
    show by defs(ex_intro({m1}, {a}, {k}, taut(oe, m1M, ab, sev, ov)), abi.crashes_at)
  qed
  have e1: app(app(W, "os"), "events") = app(app(m1, "os"), "events") -> abi.overflow_ok(rec_and(abi.World, single(empty)), W, spec, args, app(m1, "os")) proof
    assume e
    show by defs(taut(inp, e), abi.overflow_ok)
  qed
  // (an overflow: the ABI's witness)
  have e2: (ex x. x in rec_and(abi.World, single(empty)) && runs(app(spec, args), W, exc(x, exc_val("stack_overflow", empty))) && app(app(x, "os"), "events") = app(app(m1, "os"), "events")) ->
      abi.crashes_at(spec, args, objs, mem, s, o) proof
    assume e
    obtain x, hx hr hev from e
    have ou: exc_val("stack_overflow", empty) in univ(1) by defs(simp(), exc_val)
    have ot := mp(mp(exc_outcome_type[s := rec_and(abi.World, single(empty)), v := cart(bits(64), bits(64)), x := x, e := exc_val("stack_overflow", empty)], hx), ou)
    have it1 := apply(tr.ite_f, {fst(exc(x, exc_val("stack_overflow", empty))) = 0}, {app(app(fst(snd(exc(x, exc_val("stack_overflow", empty)))), "os"), "events") = app(app(m1, "os"), "events")},
      {ite(fst(exc(x, exc_val("stack_overflow", empty))) = 1, snd(snd(exc(x, exc_val("stack_overflow", empty)))) = exc_val("stack_overflow", empty) && app(app(fst(snd(exc(x, exc_val("stack_overflow", empty)))), "os"), "events") = app(app(m1, "os"), "events"),
        app(snd(exc(x, exc_val("stack_overflow", empty))), "os.events") = app(app(m1, "os"), "events"))}, simp())
    have it2 := apply(tr.ite_t, {fst(exc(x, exc_val("stack_overflow", empty))) = 1}, {snd(snd(exc(x, exc_val("stack_overflow", empty)))) = exc_val("stack_overflow", empty) && app(app(fst(snd(exc(x, exc_val("stack_overflow", empty)))), "os"), "events") = app(app(m1, "os"), "events")},
      {app(snd(exc(x, exc_val("stack_overflow", empty))), "os.events") = app(app(m1, "os"), "events")}, simp())
    have cc: snd(snd(exc(x, exc_val("stack_overflow", empty)))) = exc_val("stack_overflow", empty) && app(app(fst(snd(exc(x, exc_val("stack_overflow", empty)))), "os"), "events") = app(app(m1, "os"), "events") by simp(hev)
    have iv := rewrite(sym(trans(it1, it2)), cc)
    have ex1: ex x1. x1 in outcome_type(rec_and(abi.World, single(empty)), cart(bits(64), bits(64))) && (runs(app(spec, args), W, x1) &&
        ite(fst(x1) = 0, app(app(fst(snd(x1)), "os"), "events") = app(app(m1, "os"), "events"),
          ite(fst(x1) = 1, snd(snd(x1)) = exc_val("stack_overflow", empty) && app(app(fst(snd(x1)), "os"), "events") = app(app(m1, "os"), "events"),
            app(snd(x1), "os.events") = app(app(m1, "os"), "events"))))
      by ex_intro({exc(x, exc_val("stack_overflow", empty))}, taut(ot, hr, iv))
    have ov: abi.overflow_ok(rec_and(abi.World, single(empty)), W, spec, args, app(m1, "os")) by defs(taut(inp, ex1), abi.overflow_ok)
    show := mp(cr, ov)
  qed
  // (a divergence: the spec raises there)
  have e3: (ex t. runs(app(spec, args), W, diverge(t))) -> abi.raises_at(spec, args, objs, mem, s) proof
    assume e
    obtain t, hr from e
    have r := mp(all_elim(expand(hd, tr.div_raises), {args}, {W}, {t}), hA, hvW, hvu, hr)
    show by defs(r, abi.raises_at)
  qed
  have e4: tr.ovf(app(spec, args), W, app(m1, "os")) -> (ex x. x in rec_and(abi.World, single(empty)) && runs(app(spec, args), W, exc(x, exc_val("stack_overflow", empty))) &&
      app(app(x, "os"), "events") = app(app(m1, "os"), "events")) || (ex t. runs(app(spec, args), W, diverge(t))) proof
    assume hv
    show by taut(expand(hv, tr.ovf))
  qed
  show by taut(ev, e1, cr, e2, e3, e4)
qed

theorem tr.matches_t_abi: all spec args objs mem s o. tr.div_raises(spec) -> args in abi.ARGS -> abi.view(s, objs, mem) in abi.World -> abi.view(s, objs, mem) in univ(1) ->
  tr.matches_t(spec, args, objs, mem, s, o) -> abi.matches(spec, args, objs, mem, s, o)
proof
  fix spec args objs mem s o
  assume hd hA hvW hvu mt
  have ca := apply(tr.crashes_abi, {spec}, {args}, {objs}, {mem}, {s}, {o}, hd, hA, hvW, hvu)
  // (a divergence: the spec raises there too)
  have dr: tr.div(app(spec, args), abi.view(s, objs, mem), o) -> abi.raises_at(spec, args, objs, mem, s) proof
    assume d
    obtain t2, rd from expand(d, tr.div).2
    have r := mp(all_elim(expand(hd, tr.div_raises), {args}, {abi.view(s, objs, mem)}, {t2}), hA, hvW, hvu, rd)
    show by defs(r, abi.raises_at)
  qed
  have mt2: abi.raises_at(spec, args, objs, mem, s) || tr.ok(s, objs, app(spec, args), abi.view(s, objs, mem), o) || tr.crashes_t(spec, args, objs, mem, s, o) ||
      tr.div(app(spec, args), abi.view(s, objs, mem), o)
    by defs(taut(expand(mt, tr.matches_t)), tr.ok)
  have oa := all_elim(tr.ok_abi, {s}, {objs}, {app(spec, args)}, {abi.view(s, objs, mem)}, {o})
  show by defs(taut(mt2, oa, dr, ca), abi.matches)
qed

theorem tr.ok_not_div: all s v p w t. !tr.ok(s, v, p, w, diverge(t))
proof
  fix s v p w t
  have n: tr.ok(s, v, p, w, diverge(t)) -> false proof
    assume k
    obtain m1 w2, k2 from expand(k, tr.ok)
    show by simp(k2.1)
  qed
  show by taut(n)
qed


// (a raise, a return: no divergence)
theorem tr.div_exc: all p w x e. !tr.div(p, w, exc(x, e))
proof
  fix p w x e
  have n: tr.div(p, w, exc(x, e)) -> false proof
    assume d
    obtain t, q from expand(d, tr.div).1
    show by simp(q)
  qed
  show by taut(n)
qed


theorem tr.div_ok: all p w x e. !tr.div(p, w, ok(x, e))
proof
  fix p w x e
  have n: tr.div(p, w, ok(x, e)) -> false proof
    assume d
    obtain t, q from expand(d, tr.div).1
    show by simp(q)
  qed
  show by taut(n)
qed


// (a disciplined run's outcome tagged 2: a divergence)
theorem tr.run_d_div: all s m o. tr.run_d(s, m, o) -> fst(o) = 2 -> (ex t. o = diverge(t))
proof
  fix s m o
  assume h hf
  obtain r, _ hm from expand(h, tr.run_d)
  have c: fst(r) = 2 && o = diverge(snd(r)) by simp(expand(hm, tr.rmap), hf)
  show by ex_intro({snd(r)}, taut(c))
qed

// (the contract's run, from a state below the entry's sp: the claim's run
// with no breakpoint, to the same outcome (a divergence: some divergence);
// or the claim's run stops where rsp has risen to the entry's sp without
// the return, which the contract's run leaves with disc)
theorem tr.run_d_k: all s m o. tr.run_d(s, m, o) -> int_lt(app(app(m, "gpr"), 4), abi.sp(s)) ->
  (ex o1. tr.run_k(s, zb. false, m, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2))) ||
  (ex x. o = exc(x, exc_val("disc", empty)) && tr.run_k(s, zb. false, m, ok(x, empty)) && !tr.at_ret(s, x))
proof
  fix s m o
  assume h hlt
  let G := (ex o1. tr.run_k(s, zb. false, m, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2))) ||
    (ex x. o = exc(x, exc_val("disc", empty)) && tr.run_k(s, zb. false, m, ok(x, empty)) && !tr.at_ret(s, x))
  let TR(x5) := fn_update(empty, "os.events", app(app(fst(x5), "os"), "events"))
  let P(l) := int_lt(app(app(fst(l), "gpr"), 4), abi.sp(s))
  let E(l) := exc(pair(fst(l), empty), pair("brk", empty))
  obtain r, hw hm from expand(h, tr.run_d)
  // (below the sp: the disciplined pass is the plain step)
  have pb: all l o2. P(l) -> tr.rbd(s, l, o2) -> tr.rst(l, o2) proof
    fix l o2
    assume hp hb
    have ne: app(app(fst(l), "gpr"), 4) = abi.sp(s) -> false proof
      assume e
      have l2 := rewrite(e, hp)
      show by arith(l2)
    qed
    have nar: !tr.at_ret(s, fst(l)) by taut(ne)
    have dok: tr.disc_ok(s, fst(l)) by taut(hp)
    have rb: tr.rb(s, l, o2) by taut(expand(hb, tr.rbd), dok)
    show by defs(taut(expand(rb, tr.rb), nar), tr.rst)
  qed
  // (the guarded passes: the claim's)
  have gb: all l o2. (P(l) && tr.rbd(s, l, o2)) || (!P(l) && o2 = E(l)) -> tr.rbk(s, zb. false, l, o2) proof
    fix l o2
    assume g
    have g1: P(l) && tr.rbd(s, l, o2) -> tr.rbk(s, zb. false, l, o2) proof
      assume e
      have rs := mp(all_elim(pb, {l}, {o2}), e.1, e.2)
      have ns: !tr.stopk(s, zb. false, fst(l)) by defs(taut(e.1), tr.stopk)
      show by defs(taut(ns, rs), tr.rbk)
    qed
    have g2: !P(l) && o2 = E(l) -> tr.rbk(s, zb. false, l, o2) proof
      assume e
      have st: tr.stopk(s, zb. false, fst(l)) by defs(taut(e.1), tr.stopk)
      show by defs(taut(st, e.2), tr.rbk)
    qed
    show by taut(g, g1, g2)
  qed
  have pm: P(pair(m, empty)) by simp(hlt)
  have un := mp(while_unroll[l0 := pair(m, empty), c := x5. true, b := x5 x6. tr.rbd(s, x5, x6), tr := x5. TR(x5), r := r], expand(hw, tr.rwd))
  // the first pass leaves
  have u1: tr.rbd(s, pair(m, empty), r) && !is_ok(r) -> G proof
    assume e
    have rs := mp(all_elim(pb, {pair(m, empty)}, {r}), pm, e.1)
    have rk: tr.rk(s, zb. false, m, r) by defs(taut(rs, e.2), tr.rk)
    have rn: tr.run_k(s, zb. false, m, o) by defs(ex_intro({r}, taut(rk, hm)), tr.run_k)
    have e1: ex o1. tr.run_k(s, zb. false, m, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2)) by ex_intro({o}, taut(rn, refl({o})))
    show by taut(e1)
  qed
  // the first pass goes on to l1: the passes from l1 cut where rsp first
  // reaches the entry's sp
  have u2: (ex l1. tr.rbd(s, pair(m, empty), ok(l1, empty)) && (ex r1. while_rel(l1, x5. true, x5 x6. tr.rbd(s, x5, x6), x5. TR(x5), r1) &&
      fst(r1) = fst(r) && (!(fst(r) = 2) -> r1 = r))) -> G proof
    assume e
    obtain l1, rb0 er from e
    obtain r1, w1 f1 e1 from er
    have rs0 := mp(all_elim(pb, {pair(m, empty)}, {ok(l1, empty)}), pm, rb0)
    have q1: l1 = pair(fst(l1), empty) by simp(expand(rs0, tr.rst), keep(x86_64_linux.step))
    have he: all l. !is_ok(E(l)) proof
      fix l
      show by defs(simp(), is_ok)
    qed
    have hqs: all l l2. l = pair(fst(l), empty) -> tr.rbd(s, l, ok(l2, empty)) -> l2 = pair(fst(l2), empty) proof
      fix l l2
      assume _ hb
      show by simp(expand(hb, tr.rbd, tr.rb), keep(x86_64_linux.step))
    qed
    have sp := mp(while_split[l0 := l1, b := l o2. tr.rbd(s, l, o2), tr := l. TR(l), p := l. P(l), e := l. E(l), r := r1, q := l. l = pair(fst(l), empty)],
      he, q1, hqs, w1)
    let GB(l, o2) := (P(l) && tr.rbd(s, l, o2)) || (!P(l) && o2 = E(l))
    // never reaching it: the claim's run, the same outcome
    have ca: while_rel(l1, l. true, l o2. GB(l, o2), l. TR(l), r1) -> G proof
      assume wg
      have w2 := mp(while_mono[l0 := l1, c := l. true, b1 := l o2. GB(l, o2), b2 := l o2. tr.rbk(s, zb. false, l, o2), tr := l. TR(l), r := r1], gb, wg)
      have rw: tr.rwk(s, zb. false, l1, r1) by defs(w2, tr.rwk)
      have ex2: ex l2. tr.rst(pair(m, empty), ok(l2, empty)) && tr.rwk(s, zb. false, l2, r1) by ex_intro({l1}, taut(rs0, rw))
      have rk: tr.rk(s, zb. false, m, r1) by defs(taut(ex2), tr.rk)
      have nd: !(fst(r) = 2) -> G proof
        assume n
        have re := mp(e1, n)
        have rn: tr.run_k(s, zb. false, m, o) by defs(ex_intro({r1}, taut(rk, rewrite(sym(re), hm))), tr.run_k)
        have e3: ex o1. tr.run_k(s, zb. false, m, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2)) by ex_intro({o}, taut(rn, refl({o})))
        show by taut(e3)
      qed
      have dd: fst(r) = 2 -> G proof
        assume d
        have d1: fst(r1) = 2 by simp(f1, d)
        have rm1: tr.rmap(r1, diverge(snd(r1))) by defs(simp(d1), tr.rmap)
        have rn: tr.run_k(s, zb. false, m, diverge(snd(r1))) by defs(ex_intro({r1}, taut(rk, rm1)), tr.run_k)
        have od: fst(o) = 2 by simp(expand(hm, tr.rmap), d)
        have dd2: fst(diverge(snd(r1))) = 2 by simp()
        have e3: ex o1. tr.run_k(s, zb. false, m, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2)) by ex_intro({diverge(snd(r1))}, taut(rn, dd2, od))
        show by taut(e3)
      qed
      show by taut(nd, dd)
    qed
    // reaching it at l: the claim's run stops there; the contract's run
    // returns there (at the return) or leaves with disc
    have cb: (ex l. l = pair(fst(l), empty) && while_rel(l1, l. true, l o2. GB(l, o2), l. TR(l), E(l)) &&
        (ex r2. while_rel(l, l. true, l o2. tr.rbd(s, l, o2), l. TR(l), r2) && fst(r2) = fst(r1) && (!(fst(r1) = 2) -> r2 = r1))) -> G proof
      assume e2
      obtain l, ql wg er2 from e2
      obtain r2, w3 f3 e3 from er2
      have w2 := mp(while_mono[l0 := l1, c := l. true, b1 := l o2. GB(l, o2), b2 := l o2. tr.rbk(s, zb. false, l, o2), tr := l. TR(l), r := E(l)], gb, wg)
      have rw: tr.rwk(s, zb. false, l1, E(l)) by defs(w2, tr.rwk)
      have ex2: ex l2. tr.rst(pair(m, empty), ok(l2, empty)) && tr.rwk(s, zb. false, l2, E(l)) by ex_intro({l1}, taut(rs0, rw))
      have rk: tr.rk(s, zb. false, m, E(l)) by defs(taut(ex2), tr.rk)
      have rmb: tr.rmap(E(l), ok(fst(l), empty)) by defs(simp(), tr.rmap)
      have rn: tr.run_k(s, zb. false, m, ok(fst(l), empty)) by defs(ex_intro({E(l)}, taut(rk, rmb)), tr.run_k)
      // (at l, rsp has reached the sp: the guarded run's last pass is a cut)
      have cs := mp(while_cases[l0 := l1, c := l. true, b := l o2. GB(l, o2), tr := l. TR(l), r := E(l)], wg)
      have np: !P(l) proof
        have c1: (ex l3. (!true && E(l) = ok(l3, empty)) || (true && GB(l3, E(l)) && !is_ok(E(l)))) -> !P(l) proof
          assume el
          obtain l3, hl3 from el
          have gb3: GB(l3, E(l)) by taut(hl3)
          have k1: P(l3) && tr.rbd(s, l3, E(l)) -> !P(l) proof
            assume k
            have rs3 := mp(all_elim(pb, {l3}, {E(l)}), k.1, k.2)
            have ro := apply(tr.rst_out, {l3}, {E(l)}, rs3, all_elim(he, {l}))
            have f: false by simp(ro)
            show by taut(f)
          qed
          have k2: !P(l3) && E(l) = E(l3) -> !P(l) proof
            assume k
            have fe: fst(l) = fst(l3) by simp(k.2)
            show := rewrite(sym(fe), k.1)
          qed
          show by taut(gb3, k1, k2)
        qed
        have c2: (ex t. E(l) = diverge(t)) -> !P(l) proof
          assume ed
          obtain t, te from ed
          have f: false by simp(te)
          show by taut(f)
        qed
        show by taut(cs, c1, c2)
      qed
      // the contract's run from l
      have un2 := mp(while_unroll[l0 := l, c := x5. true, b := x5 x6. tr.rbd(s, x5, x6), tr := x5. TR(x5), r := r2], w3)
      have fe: fst(pair(fst(l), empty)) = fst(l) by simp()
      have rr: !(fst(r2) = 2) -> r2 = r proof
        assume n2
        have n1: !(fst(r1) = 2) by simp(n2, f3)
        have n0: !(fst(r) = 2) by simp(n1, f1)
        show := trans(mp(e3, n1), mp(e1, n0))
      qed
      // (at the return: it returns; elsewhere: disc)
      have at1: tr.at_ret(s, fst(l)) -> G proof
        assume at
        have dok: tr.disc_ok(s, fst(l)) by taut(at)
        have bb: all o2. tr.rbd(s, l, o2) -> o2 = exc(pair(fst(l), empty), pair("brk", empty)) proof
          fix o2
          assume hb
          have rb: tr.rb(s, l, o2) by taut(expand(hb, tr.rbd), dok)
          show by taut(expand(rb, tr.rb), at)
        qed
        have v1: tr.rbd(s, l, r2) && !is_ok(r2) -> G proof
          assume k
          have r2e := mp(all_elim(bb, {r2}), k.1)
          have n2: !(fst(r2) = 2) by simp(r2e)
          have re := mp(rr, n2)
          have oe: o = ok(fst(l), empty) by simp(expand(rewrite(r2e, rewrite(sym(re), hm)), tr.rmap))
          have e4: ex o1. tr.run_k(s, zb. false, m, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2)) by ex_intro({ok(fst(l), empty)}, taut(rn, sym(oe)))
          show by taut(e4)
        qed
        have v2: (ex l4. tr.rbd(s, l, ok(l4, empty)) && (ex r4. while_rel(l4, x5. true, x5 x6. tr.rbd(s, x5, x6), x5. TR(x5), r4) && fst(r4) = fst(r2) &&
            (!(fst(r2) = 2) -> r4 = r2))) -> G proof
          assume k
          obtain l4, hb4 _ from k
          have r4e := mp(all_elim(bb, {ok(l4, empty)}), hb4)
          have f: false by simp(r4e)
          show by taut(f)
        qed
        have v0: (!true && r2 = ok(l, empty)) -> G proof
          assume k
          show by taut(k)
        qed
        show by taut(un2, v0, v1, v2)
      qed
      have at2: !tr.at_ret(s, fst(l)) -> G proof
        assume nat
        have ndok: !tr.disc_ok(s, fst(l)) by taut(nat, np)
        have bb: all o2. tr.rbd(s, l, o2) -> o2 = exc(l, pair("raise", exc_val("disc", empty))) proof
          fix o2
          assume hb
          show by taut(expand(hb, tr.rbd), ndok)
        qed
        have v1: tr.rbd(s, l, r2) && !is_ok(r2) -> G proof
          assume k
          have r2e := mp(all_elim(bb, {r2}), k.1)
          have n2: !(fst(r2) = 2) by simp(r2e)
          have re := mp(rr, n2)
          have oe: o = exc(fst(l), exc_val("disc", empty)) by simp(expand(rewrite(r2e, rewrite(sym(re), hm)), tr.rmap))
          have e4: ex x. o = exc(x, exc_val("disc", empty)) && tr.run_k(s, zb. false, m, ok(x, empty)) && !tr.at_ret(s, x) by ex_intro({fst(l)}, taut(oe, rn, nat))
          show by taut(e4)
        qed
        have v2: (ex l4. tr.rbd(s, l, ok(l4, empty)) && (ex r4. while_rel(l4, x5. true, x5 x6. tr.rbd(s, x5, x6), x5. TR(x5), r4) && fst(r4) = fst(r2) &&
            (!(fst(r2) = 2) -> r4 = r2))) -> G proof
          assume k
          obtain l4, hb4 _ from k
          have r4e := mp(all_elim(bb, {ok(l4, empty)}), hb4)
          have f: false by simp(r4e)
          show by taut(f)
        qed
        have v0: (!true && r2 = ok(l, empty)) -> G proof
          assume k
          show by taut(k)
        qed
        show by taut(un2, v0, v1, v2)
      qed
      show by taut(at1, at2)
    qed
    show by taut(sp, ca, cb)
  qed
  have u0: (!true && r = ok(pair(m, empty), empty)) -> G proof
    assume e
    show by taut(e)
  qed
  show by taut(un, u0, u1, u2)
qed

// ... for the disciplined run itself: the claim at the entry, no
// breakpoint (the contract's run from the entry)
theorem tr.entry_d: all spec args s v mem o. s in x86_64_linux.Machine -> int_lt(app(app(s, "gpr"), 4), 140737488355328) ->
  tr.sim(s, zb. false, zb pb wb. false, v, app(spec, args), abi.view(s, v, mem), s) -> tr.run_d(s, s, o) ->
  tr.matches_t(spec, args, v, mem, s, o)
proof
  fix spec args s v mem o
  assume hM hsl h rd
  let P := app(spec, args)
  let W := abi.view(s, v, mem)
  have r4 := apply(x86i.rsp_typed, hM)
  have lt := apply(tr.sp_lt, {app(app(s, "gpr"), 4)}, r4, hsl)
  have cr := all_elim(tr.crash_at, {spec}, {args}, {s}, {v}, {mem}, {o})
  have ua := all_elim(tr.ub_at, {spec}, {args}, {s}, {v}, {mem})
  have sm := expand(h, tr.sim)
  // (a return reached: the spec's return, as the contract has it)
  have rt: all m1. o = ok(m1, empty) -> tr.retok(s, v, P, W, m1) -> tr.matches_t(spec, args, v, mem, s, o) proof
    fix m1
    assume oe hr
    have rx := expand(hr, tr.retok)
    have e1: ex m2 w2. o = ok(m2, empty) && m2 in x86_64_linux.Machine && m2 in univ(1) &&
        runs(app(spec, args), abi.view(s, v, mem), ok(w2, pair(app(app(m2, "gpr"), 0), app(app(m2, "gpr"), 2)))) && w2 in abi.World && w2 in univ(1) &&
        abi.world_matches(app(s, "vm"), app(m2, "vm"), app(w2, "vm"), v, abi.sp(s)) && app(m2, "os") = app(w2, "os") && app(m2, "fs_base") = app(w2, "fs_base") &&
        app(m2, "cpu") = app(s, "cpu") && app(m2, "gs_base") = app(s, "gs_base") && app(m2, "rip") = abi.ret(s) && app(app(m2, "gpr"), 4) = abi.sp(s) &&
        abi.callee_saved(m2, s) && !app(app(m2, "flags"), "df") proof
      have ew: ex w3. runs(P, W, ok(w3, pair(app(app(m1, "gpr"), 0), app(app(m1, "gpr"), 2)))) && w3 in abi.World && w3 in univ(1) &&
          abi.world_matches(app(s, "vm"), app(m1, "vm"), app(w3, "vm"), v, abi.sp(s)) && app(m1, "os") = app(w3, "os") && app(m1, "fs_base") = app(w3, "fs_base") by taut(rx)
      obtain w3, h3 from ew
      show by ex_intro({m1}, {w3}, taut(oe, rx, h3))
    qed
    show by defs(taut(e1), tr.matches_t)
  qed
  have rdk := apply(tr.run_d_k, {s}, {s}, {o}, rd, lt)
  // the claim's run to the same outcome
  have c1: (ex o1. tr.run_k(s, zb. false, s, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2))) -> tr.matches_t(spec, args, v, mem, s, o) proof
    assume e
    obtain o1, rk eo from e
    have g := expand(mp(all_elim(sm, {o1}), rk), tr.gk)
    have k1: tr.ub(s, v, P, W) -> tr.matches_t(spec, args, v, mem, s, o) proof
      assume u
      show by defs(taut(mp(ua, u)), tr.matches_t)
    qed
    have k2: tr.crash(s, P, W, o1) -> tr.matches_t(spec, args, v, mem, s, o) proof
      assume c
      obtain m1 a k0, {oe} from expand(c, tr.crash)
      have nd: !(fst(o1) = 2) by simp(oe)
      have oe: o1 = o by taut(eo, nd)
      have c2 := rewrite(oe, c)
      show by defs(taut(mp(cr, c2)), tr.matches_t)
    qed
    have k3: tr.div(P, W, o1) -> tr.matches_t(spec, args, v, mem, s, o) proof
      assume d
      obtain t, te from expand(d, tr.div).1
      have f1: fst(o1) = 2 by simp(te)
      have f0a: o1 = o -> fst(o) = 2 proof
        assume e5
        show := rewrite(e5, f1)
      qed
      have f0: fst(o) = 2 by taut(eo, f0a)
      have ed := apply(tr.run_d_div, rd, f0)
      have d2: tr.div(P, W, o) by defs(taut(ed, expand(d, tr.div).2), tr.div)
      show by defs(taut(d2), tr.matches_t)
    qed
    have k4: (ex m1. o1 = ok(m1, empty) && tr.arr(s, zb. false, zb pb wb. false, v, m1, P, W)) -> tr.matches_t(spec, args, v, mem, s, o) proof
      assume e2
      obtain m1, oe1 ha from e2
      have st := apply(tr.run_k_stop[bkp := zb. false], {s}, {s}, {m1}, {empty}, rewrite(oe1, rk))
      have ou: tr.out(s, m1) by taut(expand(st, tr.stopk))
      have hr := mp(expand(ha, tr.arr).1, ou)
      have nd: !(fst(o1) = 2) by simp(oe1)
      have oe0: o1 = o by taut(eo, nd)
      have oe: o = ok(m1, empty) := trans(sym(oe0), oe1)
      show := mp(all_elim(rt, {m1}), oe, hr)
    qed
    show by taut(g, k1, k2, k3, k4)
  qed
  // the claim's run stopping where the contract's leaves with disc: undefined
  have c2: (ex x. o = exc(x, exc_val("disc", empty)) && tr.run_k(s, zb. false, s, ok(x, empty)) && !tr.at_ret(s, x)) -> tr.matches_t(spec, args, v, mem, s, o) proof
    assume e
    obtain x, oe rk nat from e
    have g := expand(mp(all_elim(sm, {ok(x, empty)}), rk), tr.gk)
    have k1: tr.ub(s, v, P, W) -> tr.matches_t(spec, args, v, mem, s, o) proof
      assume u
      show by defs(taut(mp(ua, u)), tr.matches_t)
    qed
    have k2: tr.crash(s, P, W, ok(x, empty)) -> false proof
      assume c
      obtain m1 a k0, {oe} from expand(c, tr.crash)
      show by simp(oe)
    qed
    have k3 := all_elim(tr.div_ok, {P}, {W}, {x}, {empty})
    have k4: (ex m1. ok(x, empty) = ok(m1, empty) && tr.arr(s, zb. false, zb pb wb. false, v, m1, P, W)) -> false proof
      assume e2
      obtain m1, oe1 ha from e2
      have me: m1 = x by simp(oe1)
      have st := apply(tr.run_k_stop[bkp := zb. false], {s}, {s}, {x}, {empty}, rk)
      have ou: tr.out(s, x) by taut(expand(st, tr.stopk))
      have ha2 := rewrite(me, ha)
      have rx := expand(mp(expand(ha2, tr.arr).1, ou), tr.retok)
      have at: tr.at_ret(s, x) by taut(rx)
      show by taut(at, nat)
    qed
    show by taut(g, k1, k2, k3, k4)
  qed
  show by taut(rdk, c1, c2)
qed

// the stack objects of the callers a function entered at s may reach: at or
// above its sp, writable (as abi.abi_function requires)
def tr.objs_ok(s, v) := all x. x in omega -> x in v -> (int_le(abi.sp(s), x) && abi.stack_page(app(s, "vm"), int_div(x, x86_64_linux.PAGE))) && x86_64_linux.can_access(app(s, "vm"), bits_of_int(64, x), 1)

// The bridge's contract of a function at f: every disciplined run from an
// entry (with the stack objects objs of its callers, for every view mem
// of the memory) matches the spec --
// abi.implements2_at, and a caller's run through a call to f splits at
// f's return (f keeps its rsp below its sp until then, where its spec does
// not raise).
def tr.implements_at(f, spec, base, code, statics) :=
  all args objs mem s o. args in abi.ARGS -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(app(s, "vm"), base, code, statics) ->
    app(s, "rip") = f -> abi.entry_ok(s, args) -> tr.objs_ok(s, objs) -> abi.view_ok(s, objs, mem) -> tr.run_d(s, s, o) -> tr.matches_t(spec, args, objs, mem, s, o)

// The same for an entry whose stack need not be 16-byte aligned: GCC calls
// a local function that needs no alignment (IPA stack alignment, e.g. a
// trap) with rsp as its caller's frame leaves it. The ABI's entry
// conditions but the alignment:
def tr.entry_ok_u(m, args) := ((((abi.stack_page(app(m, "vm"), int_div(app(app(m, "gpr"), 4), x86_64_linux.PAGE)) && x86_64_linux.can_access(app(m, "vm"), app(app(m, "gpr"), 4), 1)) &&
  abi.stack_reserve(app(m, "vm"))) && !app(app(m, "flags"), "df")) && (all x0. x0 in omega -> int_lt(x0, seq_len(args)) -> app(app(m, "gpr"), app(abi.ARG_REGS, x0)) = app(args, x0))) &&
  abi.thread_ok(app(m, "vm"), app(m, "fs_base"))

def tr.implements_at_u(f, spec, base, code, statics) :=
  all args objs mem s o. args in abi.ARGS -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(app(s, "vm"), base, code, statics) ->
    app(s, "rip") = f -> tr.entry_ok_u(s, args) -> tr.objs_ok(s, objs) -> abi.view_ok(s, objs, mem) -> tr.run_d(s, s, o) -> tr.matches_t(spec, args, objs, mem, s, o)

// (the ABI's entry: the alignment-free one)
theorem tr.entry_ok_u_of: all m args. abi.entry_ok(m, args) -> tr.entry_ok_u(m, args)
proof
  fix m args
  assume h
  show by defs(taut(expand(h, abi.entry_ok)), tr.entry_ok_u)
qed

// (the contract for any entry: the contract)
theorem tr.implements_u: all f spec base code statics. tr.implements_at_u(f, spec, base, code, statics) -> tr.implements_at(f, spec, base, code, statics)
proof
  fix f spec base code statics
  assume h
  have g: all args objs mem s o. args in abi.ARGS -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(app(s, "vm"), base, code, statics) ->
      app(s, "rip") = f -> abi.entry_ok(s, args) -> tr.objs_ok(s, objs) -> abi.view_ok(s, objs, mem) -> tr.run_d(s, s, o) -> tr.matches_t(spec, args, objs, mem, s, o) proof
    fix args objs mem s o
    assume h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 h11
    show := mp(all_elim(expand(h, tr.implements_at_u), {args}, {objs}, {mem}, {s}, {o}), h1, h2, h3, h4, h5, h6, h7, apply(tr.entry_ok_u_of, h8), h9, h10, h11)
  qed
  show by defs(g, tr.implements_at)
qed

// (an outcome the spec matches only by raising: so is every outcome)
theorem tr.matches_raise: all spec args objs mem s x o. abi.matches(spec, args, objs, mem, s, exc(x, exc_val("disc", empty))) -> abi.matches(spec, args, objs, mem, s, o)
proof
  fix spec args objs mem s x o
  assume ma
  have n2: (ex m1 w2. exc(x, exc_val("disc", empty)) = ok(m1, empty) && m1 in x86_64_linux.Machine &&
      runs(app(spec, args), abi.view(s, objs, mem), ok(w2, pair(app(app(m1, "gpr"), 0), app(app(m1, "gpr"), 2)))) && w2 in abi.World && w2 in univ(1) &&
      abi.world_matches(app(s, "vm"), app(m1, "vm"), app(w2, "vm"), objs, abi.sp(s)) && app(m1, "os") = app(w2, "os") && app(m1, "fs_base") = app(w2, "fs_base") &&
      app(m1, "cpu") = app(s, "cpu") && app(m1, "gs_base") = app(s, "gs_base") && app(m1, "rip") = abi.ret(s) && app(app(m1, "gpr"), 4) = abi.sp(s) &&
      abi.callee_saved(m1, s) && !app(app(m1, "flags"), "df")) -> false proof
    assume e
    obtain m1 w2, e2 from e
    show by simp(e2.1)
  qed
  have n3: (ex t. exc(x, exc_val("disc", empty)) = diverge(t) && runs(app(spec, args), abi.view(s, objs, mem), diverge(t))) -> false proof
    assume e
    obtain t, q _ from e
    show by simp(q)
  qed
  have n4: abi.crashes_at(spec, args, objs, mem, s, exc(x, exc_val("disc", empty))) -> false proof
    assume e
    obtain m1 a c0, {oe} from expand(e, abi.crashes_at)
    show by simp(expand(oe, exc_val))
  qed
  have r: abi.raises_at(spec, args, objs, mem, s) by taut(expand(ma, abi.matches), n2, n3, n4)
  show by defs(taut(r), abi.matches)
qed

// the bridge's contract gives the ABI's
theorem tr.implements_abi: all f spec base code statics. tr.div_raises(spec) -> tr.implements_at(f, spec, base, code, statics) -> abi.implements2_at(single(empty), f, spec, base, code, statics)
proof
  fix f spec base code statics
  assume hdr hi
  have m: all args objs mem s o. args in abi.ARGS -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> abi.loaded(app(s, "vm"), base, code, statics) -> app(s, "rip") = f ->
      abi.entry_ok(s, args) -> (all x. x in omega -> x in objs -> (int_le(abi.sp(s), x) && abi.stack_page(app(s, "vm"), int_div(x, x86_64_linux.PAGE))) && x86_64_linux.can_access(app(s, "vm"), bits_of_int(64, x), 1)) -> abi.view_ok(s, objs, mem) ->
      runs(abi.run_to_return(), s, o) -> abi.matches(spec, args, objs, mem, s, o) proof
    fix args objs mem s o
    assume hA hot hmv hM hl hrip he hob hwm hr
    have su: s in univ(1) by simp(apply(abi.run_univ, hr))
    have ok: tr.objs_ok(s, objs) by defs(hob, tr.objs_ok)
    have ou := apply(abi.objs_univ, hot)
    have mu := apply(x86.vm_univ, hmv)
    have hvu: abi.view(s, objs, mem) in univ(1) by simp(su, ou, mu)
    have hvW := apply(abi.world_typed, hM, hot, hmv, hvu)
    have c := expand(hi, tr.implements_at)
    have d := apply(tr.run_disc, {s}, {o}, hr)
    have c1: tr.run_d(s, s, o) -> abi.matches(spec, args, objs, mem, s, o) proof
      assume rd
      have mt := mp(all_elim(c, {args}, {objs}, {mem}, {s}, {o}), hA, hot, hmv, hM, su, hl, hrip, he, ok, hwm, rd)
      show := apply(tr.matches_t_abi, hdr, hA, hvW, hvu, mt)
    qed
    have c2: (ex x. tr.run_d(s, s, exc(x, exc_val("disc", empty)))) -> abi.matches(spec, args, objs, mem, s, o) proof
      assume e
      obtain x, rd from e
      have mt := mp(all_elim(c, {args}, {objs}, {mem}, {s}, {exc(x, exc_val("disc", empty))}), hA, hot, hmv, hM, su, hl, hrip, he, ok, hwm, rd)
      have mx := apply(tr.matches_t_abi, hdr, hA, hvW, hvu, mt)
      show := apply(tr.matches_raise, {spec}, {args}, {objs}, {mem}, {s}, {x}, {o}, mx)
    qed
    show by taut(d, c1, c2)
  qed
  show := apply(abi.bridge_implements, m)
qed

// ----------------------------------------------------------------------
//  The coupling at a point of a function (rsp fr below the entry s's; the
//  homes keyed by their offset c from s's rsp, below it -- an
//  instruction's [rsp + d] is the home d - fr, tr.frame_ea)
//
//  - the ABI's part (tr.inv): the machine typed, its code loaded at base,
//    rsp s's less the frame's size fr (0 but between a prologue's
//    `sub rsp` and the epilogue's `add rsp`; the return at fr 0), the
//    return address as at s, the callee-saved registers, cpu,
//    gs_base as at s, os and fs_base the world's, df clear; only the
//    machine's bytes changed since s; the world's cpu and sp s's (a call's
//    callee world takes them); s's entry facts;
//  - the homes (hs: offset c from s's rsp -> pair(n, x)): the n bytes there
//    hold x, within tr.FMAX below s's rsp, writable, on stack pages (a home
//    is written before it is read: the write made it so);
//  - the registers (rs: register -> pair(n, x)): the register holds x, an
//    n-byte value;
//  - the memory (tr.mem, v): the machine's the spec world's on the world's
//    domain (the stack objects v: the callers');
//  - the frame (tr.frame, fd: the function's frame reaches fd bytes below
//    s's rsp): until the first call, the I/O s's and the pages s's or grown
//    stack pages -- a fault in the frame is then a stack overflow at the
//    call that entered the function --; after it, the frame accessible (the
//    call's push mapped it).

// the frame's bound: frames, homes within 64 KiB below the entry's rsp
// (well within Linux's stack guard gap)
abbrev tr.FMAX := 65536

// (a home's address: s's rsp + c)
abbrev tr.ha(s, c) := bits_add(64, int_add(app(app(s, "gpr"), 4), c), 0)

// (the n bytes at s's rsp + c: writable, on stack pages)
def tr.hacc(s, vm, c, n) := all i. i in omega -> int_lt(i, n) ->
  x86_64_linux.can_access(vm, bits_add(64, tr.ha(s, c), bits_of_int(64, i)), 1) && abi.stack_page(vm, int_div(bits_add(64, tr.ha(s, c), bits_of_int(64, i)), 4096))

// (n bytes at offset c: below s's rsp, within tr.FMAX)
def tr.hrange(c, n) := c in bits(64) && int_le(int_sub(18446744073709551616, tr.FMAX), c) && n in omega && int_le(n, int_sub(18446744073709551616, c))

// (the pages of the 8 bytes below the entry's rsp r -- the homes -- and of
// the 8 from it -- the return address -- as at the entry; the rest of the
// memory is the world's, tr.mem: a callee may change the page map, but not
// the pages of its caller's frame, GIMPLE's call_at)
def tr.kept(sv, vm, r) := all a. a in omega -> int_le(int_sub(r, 8), a) -> int_lt(a, int_add(r, 8)) ->
  app(app(vm, "pages"), x86_64_linux.page_of(a)) = app(app(sv, "pages"), x86_64_linux.page_of(a))

// (the code loaded at the entry, loaded still: the function's own, a
// callee's)
def tr.keeps_code(sv, vm) := all gb gc st. gb in omega -> abi.loaded(sv, gb, gc, st) -> abi.loaded(vm, gb, gc, st)

def tr.inv(s, base, code, fr, m, w) :=
  mM: m in x86_64_linux.Machine && mu: m in univ(1) && cd: abi.code_at(app(m, "vm"), base, code) && kc: tr.keeps_code(app(s, "vm"), app(m, "vm")) &&
  rspm: app(app(m, "gpr"), 4) = int_sub(app(app(s, "gpr"), 4), fr) && fro: fr in omega && kp: tr.kept(app(s, "vm"), app(m, "vm"), app(app(s, "gpr"), 4)) &&
  ra8: x86_64_linux.le(app(app(m, "vm"), "bytes"), app(app(s, "gpr"), 4), 8) = abi.ret(s) &&
  mcs: abi.callee_saved(m, s) && mcpu: app(m, "cpu") = app(s, "cpu") && mgs: app(m, "gs_base") = app(s, "gs_base") &&
  mos: app(m, "os") = app(w, "os") && mfs: app(m, "fs_base") = app(w, "fs_base") && mdf: !app(app(m, "flags"), "df") &&
  winp: app(app(w, "os"), "input") = app(app(s, "os"), "input") && sws: subset(app(app(s, "os"), "events"), app(app(w, "os"), "events")) &&
  wW: w in abi.World && wu: w in univ(1) && wcpu: app(w, "cpu") = app(s, "cpu") &&
  sM: s in x86_64_linux.Machine &&
  sacc: x86_64_linux.can_access(app(s, "vm"), app(app(s, "gpr"), 4), 1) && sal: int_mod(bits_add(64, app(app(s, "gpr"), 4), 8), 16) = 0 &&
  hsps: abi.stack_page(app(s, "vm"), int_div(app(app(s, "gpr"), 4), 4096)) && slt: int_lt(app(app(s, "gpr"), 4), 140737488355328) &&
  sgf: abi.stack_gap_free(app(s, "vm")) && srsv: abi.stack_reserve(app(s, "vm"))

def tr.homes(s, m, hs) := all c. c in dom(hs) ->
  x86_64_linux.le(app(app(m, "vm"), "bytes"), bits_add(64, int_add(app(app(s, "gpr"), 4), c), 0), fst(app(hs, c))) = snd(app(hs, c)) &&
  tr.hrange(c, fst(app(hs, c))) && tr.hacc(s, app(m, "vm"), c, fst(app(hs, c)))

def tr.regs(m, rs) := is_fun(rs) && (all r. r in dom(rs) -> app(app(m, "gpr"), r) = snd(app(rs, r)) && snd(app(rs, r)) in bits(int_mul(8, fst(app(rs, r)))))

// The memory's coupling at a point of the function entered at s, where
// the world's stack objects are ob: the machine's memory is the world's as
// the ABI matches them at a return (abi.world_matches) -- on the world's
// domain the world's bytes, the callers' frames (the entry's stack pages
// at and above its sp, outside the domain) as at the entry, the page map
// the world's or grown stack pages, the other fields the world's
// (and the stack objects -- the callers' -- at or above sp, on the entry's
// stack pages, accessible: a pointer access to one is the machine's)
def tr.mem(s, m, w, ob) := wob: app(w, "objs") = ob && wm: abi.world_matches(app(s, "vm"), app(m, "vm"), app(w, "vm"), ob, abi.sp(s)) &&
  oacc: (all x. x in omega -> x in ob -> (int_le(abi.sp(s), x) && abi.stack_page(app(s, "vm"), int_div(x, x86_64_linux.PAGE))) && x86_64_linux.can_access(app(m, "vm"), bits_of_int(64, x), 1))

// the frame: the I/O and pages as at the entry but for grown stack pages,
// or its fd bytes accessible
def tr.frame(s, m, fd) := (app(m, "os") = app(s, "os") && x86.stk_ext(app(s, "vm"), app(m, "vm"))) ||
  tr.hacc(s, app(m, "vm"), int_sub(18446744073709551616, fd), fd)

// the claims at the address a, for every machine state there, coupled:
// reached (tr.pt: a breakpoint's arrival condition, else the claim leaving
// it) and leaving (tr.lv: the run on from there)
def tr.pt(s, zb. bkp, zb pb wb. bka, v, base, code, fr, a, hs, fd, rs, p, w) :=
  all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, fd) ->
    tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m)
def tr.lv(s, zb. bkp, zb pb wb. bka, v, base, code, fr, a, hs, fd, rs, p, w) :=
  all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, fd) ->
    tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m)

// (the homes, the frame: of the memory alone; the frame also of the I/O)
theorem tr.homes_vm: all s m m2 hs. app(m2, "vm") = app(m, "vm") -> tr.homes(s, m, hs) -> tr.homes(s, m2, hs)
proof
  fix s m m2 hs
  assume e h
  show by defs(rewrite(sym(e), expand(h, tr.homes)), tr.homes)
qed

theorem tr.frame_vm: all s m m2 fd. app(m2, "vm") = app(m, "vm") -> app(m2, "os") = app(m, "os") -> tr.frame(s, m, fd) -> tr.frame(s, m2, fd)
proof
  fix s m m2 fd
  assume e eo h
  show by defs(rewrite(sym(eo), rewrite(sym(e), expand(h, tr.frame))), tr.frame)
qed

// (at the entry: no homes; the frame as at the entry)
theorem tr.homes_empty: all s m. tr.homes(s, m, empty)
proof
  fix s m
  have g: all c. c in dom(empty) ->
      x86_64_linux.le(app(app(m, "vm"), "bytes"), bits_add(64, int_add(app(app(s, "gpr"), 4), c), 0), fst(app(empty, c))) = snd(app(empty, c)) &&
      tr.hrange(c, fst(app(empty, c))) && tr.hacc(s, app(m, "vm"), c, fst(app(empty, c))) by simp(dom_empty)
  show by defs(g, tr.homes)
qed

theorem tr.frame_entry: all s fd. tr.frame(s, s, fd)
proof
  fix s fd
  have r := all_elim(x86.stk_ext_refl, {app(s, "vm")})
  show by defs(taut(r, refl({app(s, "os")})), tr.frame)
qed


// (the entry's memory: kept)
theorem tr.kept_refl: all sv r. tr.kept(sv, sv, r)
proof
  fix sv r
  have g: all a. a in omega -> int_le(int_sub(r, 8), a) -> int_lt(a, int_add(r, 8)) ->
      app(app(sv, "pages"), x86_64_linux.page_of(a)) = app(app(sv, "pages"), x86_64_linux.page_of(a)) proof
    fix a
    assume h1 h2 h3
    show := refl({app(app(sv, "pages"), x86_64_linux.page_of(a))})
  qed
  show by defs(g, tr.kept)
qed

// (an accessible byte there: accessible still)
theorem tr.kept_acc: all sv vm r a k. tr.kept(sv, vm, r) -> a in omega -> int_le(int_sub(r, 8), a) -> int_lt(a, int_add(r, 8)) ->
  x86_64_linux.can_access(sv, a, k) -> x86_64_linux.can_access(vm, a, k)
proof
  fix sv vm r a k
  assume hg h1 h2 h3 hc
  have e := mp(mp(mp(all_elim(expand(hg, tr.kept), {a}), h1), h2), h3)
  have c := expand(expand(hc, x86_64_linux.can_access), x86_64_linux.mapped)
  have c2 := rewrite(sym(e), c)
  show by defs(defs(c2, x86_64_linux.mapped), x86_64_linux.can_access)
qed

// (bytes written: kept still)
theorem tr.kept_bytes: all sv vm r x. tr.kept(sv, vm, r) -> tr.kept(sv, fn_update(vm, "bytes", x), r)
proof
  fix sv vm r x
  assume hg
  have e: app(fn_update(vm, "bytes", x), "pages") = app(vm, "pages") by simp()
  show by defs(rewrite(sym(e), expand(hg, tr.kept)), tr.kept)
qed

// (the return address's byte: rsp + j, j < 8)
theorem tr.ret_range: all r j. r in bits(64) -> int_lt(r, 140737488355328) -> j in omega -> int_lt(j, 8) ->
  bits_add(64, r, bits_of_int(64, j)) in omega && int_le(int_sub(r, 8), bits_add(64, r, bits_of_int(64, j))) &&
    int_lt(bits_add(64, r, bits_of_int(64, j)), int_add(r, 8))
proof
  fix r j
  assume hr hl hj hj2
  have p64: pow2(64) = 18446744073709551616 by simp()
  have jb: int_mod(j, 18446744073709551616) = j by arith(hj, hj2)
  have e0: int_mod(int_add(r, int_mod(j, 18446744073709551616)), 18446744073709551616) = int_add(r, j) by arith(hr, hl, hj, hj2, jb)
  have e: bits_add(64, r, bits_of_int(64, j)) = int_add(r, j) by defs(rewrite(sym(p64), e0), bits_add, bits_of_int)
  have g: int_add(r, j) in omega && int_le(int_sub(r, 8), int_add(r, j)) && int_lt(int_add(r, j), int_add(r, 8)) by arith(hr, hj, hj2)
  show := rewrite(sym(e), g)
qed

// (no frame: rsp the entry's)
theorem tr.inv0_rsp: all s base code m w. tr.inv(s, base, code, 0, m, w) -> app(app(m, "gpr"), 4) = app(app(s, "gpr"), 4)
proof
  fix s base code m w
  assume hi
  have {sM, rspm} := hi
  have r4 := apply(x86i.rsp_typed, sM)
  have z: int_sub(app(app(s, "gpr"), 4), 0) = app(app(s, "gpr"), 4) by arith(r4)
  show := rewrite(z, rspm)
qed

// (rsp in the frame, at or below the entry's: below the entry's sp, so
// not at the return)
theorem tr.inv_nr: all s base code fr m w. tr.inv(s, base, code, fr, m, w) -> int_lt(app(app(m, "gpr"), 4), abi.sp(s))
proof
  fix s base code fr m w
  assume hi
  have {rspm, fro, sM, slt} := hi
  have r4 := apply(x86i.rsp_typed, sM)
  have l0 := apply(tr.sp_lt, {app(app(s, "gpr"), 4)}, r4, slt)
  have l1: int_lt(int_sub(app(app(s, "gpr"), 4), fr), abi.sp(s)) by arith(l0, fro)
  show := subst({y. int_lt(y, abi.sp(s))}, sym(rspm), l1)
qed

// (an access at rsp + d in a frame of fr bytes: at the entry's rsp + c,
// for c the offset d - fr)
theorem tr.frame_ea: all s base code fr m w d c x0. tr.inv(s, base, code, fr, m, w) -> d in bits(64) -> c = int_mod(int_sub(d, fr), 18446744073709551616) -> x0 in omega ->
  bits_add(64, int_add(app(app(m, "gpr"), 4), d), x0) = bits_add(64, int_add(app(app(s, "gpr"), 4), c), x0)
proof
  fix s base code fr m w d c x0
  assume hi hd hc hx
  have {rspm, fro, sM} := hi
  have r4 := apply(x86i.rsp_typed, sM)
  have p64: pow2(64) = 18446744073709551616 by simp()
  have e2: int_mod(int_add(int_add(int_sub(app(app(s, "gpr"), 4), fr), d), x0), 18446744073709551616) =
    int_mod(int_add(int_add(app(app(s, "gpr"), 4), int_mod(int_sub(d, fr), 18446744073709551616)), x0), 18446744073709551616) by arith(r4, hd, hx, fro)
  have e3 := subst({y. int_mod(int_add(int_add(int_sub(app(app(s, "gpr"), 4), fr), d), x0), 18446744073709551616) =
    int_mod(int_add(int_add(app(app(s, "gpr"), 4), y), x0), 18446744073709551616)}, sym(hc), e2)
  have e4 := subst({y. int_mod(int_add(int_add(y, d), x0), 18446744073709551616) =
    int_mod(int_add(int_add(app(app(s, "gpr"), 4), c), x0), 18446744073709551616)}, sym(rspm), e3)
  show by defs(rewrite(sym(p64), e4), bits_add)
qed

// the memory's coupling, after a step leaving the memory
theorem tr.mem_vm: all s m m2 w ob. app(m2, "vm") = app(m, "vm") -> tr.mem(s, m, w, ob) -> tr.mem(s, m2, w, ob)
proof
  fix s m m2 w ob
  assume e h
  show by defs(rewrite(sym(e), expand(h, tr.mem)), tr.mem)
qed

// (a step of the registers alone -- the memory and the I/O kept: the claim
// after it, its homes, memory and frame the step's start's)
theorem tr.pt_regs(zb. bkp, zb pb wb. bka): all s v base code fr a hs fd rs p w m m2.
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, fd, rs, p, w) -> tr.inv(s, base, code, fr, m2, w) -> app(m2, "rip") = a -> tr.regs(m2, rs) ->
  tr.homes(s, m, hs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, fd) -> app(m2, "vm") = app(m, "vm") -> app(m2, "os") = app(m, "os") ->
  tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m2)
proof
  fix s v base code fr a hs fd rs p w m m2
  assume hpt hi hr hrs hh hmm hfr ev eo
  have h2 := apply(tr.homes_vm, {s}, {m}, {m2}, {hs}, ev, hh)
  have mm2 := apply(tr.mem_vm, {s}, {m}, {m2}, {w}, {v}, ev, hmm)
  have f2 := apply(tr.frame_vm, {s}, {m}, {m2}, {fd}, ev, eo, hfr)
  show := mp(all_elim(expand(hpt, tr.pt), {m2}), hi, hr, h2, hrs, mm2, f2)
qed

// (at a point no breakpoint: the claim reached it the claim leaving it --
// in the function, rsp below the entry's sp)
theorem tr.lv_pt(zb. bkp, zb pb wb. bka): all s v base code fr a hs fd rs p w.
  (all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> !bkp(m)) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, fd, rs, p, w) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, fd, rs, p, w)
proof
  fix s v base code fr a hs fd rs p w
  assume hb hl
  have g: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, fd) ->
      tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m) proof
    fix m
    assume hi hr hh hrs hmm hfr
    have nr := apply(tr.inv_nr, hi)
    have nb := mp(all_elim(hb, {m}), hi, hr)
    have ns: !tr.stopk(s, zb. bkp(zb), m) by defs(taut(nr, nb), tr.stopk)
    have sm := mp(all_elim(expand(hl, tr.lv), {m}), hi, hr, hh, hrs, hmm, hfr)
    show by defs(taut(ns, sm), tr.cl)
  qed
  show by defs(g, tr.pt)
qed

// (... and the claim reaching a point no breakpoint, the claim leaving it)
theorem tr.pt_lv(zb. bkp, zb pb wb. bka): all s v base code fr a hs fd rs p w.
  (all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> !bkp(m)) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, fd, rs, p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, fd, rs, p, w)
proof
  fix s v base code fr a hs fd rs p w
  assume hb hp
  have g: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, fd) ->
      tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m) proof
    fix m
    assume hi hr hh hrs hmm hfr
    have nr := apply(tr.inv_nr, hi)
    have nb := mp(all_elim(hb, {m}), hi, hr)
    have ns: !tr.stopk(s, zb. bkp(zb), m) by defs(taut(nr, nb), tr.stopk)
    have c := mp(all_elim(expand(hp, tr.pt), {m}), hi, hr, hh, hrs, hmm, hfr)
    show := mp(expand(c, tr.cl).2, ns)
  qed
  show by defs(g, tr.lv)
qed

// ... at the return: the world's memory matches the machine's
theorem tr.mem_wm: all s m w ob. tr.mem(s, m, w, ob) -> abi.world_matches(app(s, "vm"), app(m, "vm"), app(w, "vm"), ob, abi.sp(s))
proof
  fix s m w ob
  assume h
  have {wm} := h
  show := wm
qed

// (writable: readable)
theorem tr.acc_wr: all vm x. x86_64_linux.can_access(vm, x, 1) -> x86_64_linux.can_access(vm, x, 0)
proof
  fix vm x
  assume h
  show by defs(simp(expand(h, x86_64_linux.can_access, x86_64_linux.hw_allows, x86_64_linux.accessible)), x86_64_linux.can_access, x86_64_linux.hw_allows, x86_64_linux.accessible)
qed

// A GIMPLE access's byte (usable in the world: in its domain) is the
// machine's: within the address space, accessible there (writable for a
// write), the same byte
theorem tr.mem_read: all s m w ob a n wr i. tr.mem(s, m, w, ob) -> gimple.usable(app(w, "vm"), app(w, "objs"), a, n, wr) -> int_le(0, a) -> i in omega -> int_lt(i, n) ->
  int_lt(int_add(a, i), 18446744073709551616) &&
  x86_64_linux.can_access(app(m, "vm"), int_add(a, i), 0) && (wr -> x86_64_linux.can_access(app(m, "vm"), int_add(a, i), 1)) &&
    app(app(app(m, "vm"), "bytes"), int_add(a, i)) = app(app(app(w, "vm"), "bytes"), int_add(a, i))
proof
  fix s m w ob a n wr i
  assume hmm hus ha hi hn
  have {wob, wm, oacc} := hmm
  have {bytes, pages} := wm
  let X := int_add(a, i)
  let P := int_div(X, x86_64_linux.PAGE)
  let C := x86_64_linux.mapped(app(w, "vm"), P) && !(app(snd(app(app(app(w, "vm"), "pages"), P)), "kind") = 2)
  let PW := app(app(snd(app(app(app(w, "vm"), "pages"), P)), "prot"), "w")
  let PR := app(app(snd(app(app(app(w, "vm"), "pages"), P)), "prot"), "r")
  have ui := mp(all_elim(expand(hus, gimple.usable), {i}), hi, hn)
  // a page's (not the stack's): the machine's page the world's
  have c1: C -> int_lt(X, 18446744073709551616) && x86_64_linux.can_access(app(m, "vm"), X, 0) && (wr -> x86_64_linux.can_access(app(m, "vm"), X, 1)) &&
      app(app(app(m, "vm"), "bytes"), X) = app(app(app(w, "vm"), "bytes"), X) proof
    assume hc
    have ip := rewrite(mp(ite_t[c := C, a := ite(wr, PW, PR), b := int_lt(X, int_pow(2, 64)) && X in app(w, "objs")], hc), ui)
    have mc := expand(hc, x86_64_linux.mapped)
    have hlt: int_lt(X, 18446744073709551616) by simp(expand(mc, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE), ha, hi)
    have xb: X in bits(64) by simp(ha, hi, hlt)
    have dm: abi.in_domain(app(w, "vm"), ob, X) by defs(taut(hc), abi.in_domain)
    have be := mp(all_elim(bytes, {X}), xb, dm)
    have pr: P in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) by simp(mc, ha, hi)
    have pc := mp(all_elim(pages, {P}), pr)
    have nn: !(app(app(app(w, "vm"), "pages"), P) = none) by taut(mc)
    have pe: app(app(app(m, "vm"), "pages"), P) = app(app(app(w, "vm"), "pages"), P) by taut(pc, nn)
    have r1: wr -> x86_64_linux.can_access(app(m, "vm"), X, 0) && x86_64_linux.can_access(app(m, "vm"), X, 1) proof
      assume hw
      have pw := rewrite(mp(ite_t[c := wr, a := PW, b := PR], hw), ip)
      show by defs(simp(pe, mc, pw), x86_64_linux.can_access, x86_64_linux.mapped, x86_64_linux.page_of, x86_64_linux.hw_allows, x86_64_linux.accessible)
    qed
    have r0: !wr -> x86_64_linux.can_access(app(m, "vm"), X, 0) proof
      assume hw
      have pr0 := rewrite(mp(ite_f[c := wr, a := PW, b := PR], hw), ip)
      show by defs(simp(pe, mc, pr0), x86_64_linux.can_access, x86_64_linux.mapped, x86_64_linux.page_of, x86_64_linux.hw_allows, x86_64_linux.accessible)
    qed
    show by taut(hlt, r1, r0, be)
  qed
  // else a stack object's: in the domain, accessible
  have c2: !C -> int_lt(X, 18446744073709551616) && x86_64_linux.can_access(app(m, "vm"), X, 0) && (wr -> x86_64_linux.can_access(app(m, "vm"), X, 1)) &&
      app(app(app(m, "vm"), "bytes"), X) = app(app(app(w, "vm"), "bytes"), X) proof
    assume hc
    have ho0 := rewrite(mp(ite_f[c := C, a := ite(wr, PW, PR), b := int_lt(X, int_pow(2, 64)) && X in app(w, "objs")], hc), ui)
    have hlt: int_lt(X, 18446744073709551616) by simp(ho0)
    have ho1: X in app(w, "objs") by taut(ho0)
    have ho := rewrite(wob, ho1)
    have xb: X in bits(64) by simp(ha, hi, hlt)
    have bx: bits_of_int(64, X) = X by simp(ha, hi, hlt)
    have dm: abi.in_domain(app(w, "vm"), ob, X) by defs(taut(ho), abi.in_domain)
    have be := mp(all_elim(bytes, {X}), xb, dm)
    have xo: X in omega by simp(ha, hi)
    have oa := mp(all_elim(oacc, {X}), xo, ho)
    have oa1: x86_64_linux.can_access(app(m, "vm"), bits_of_int(64, X), 1) by taut(oa)
    have ca1: x86_64_linux.can_access(app(m, "vm"), X, 1) := rewrite(bx, oa1)
    have ca0 := apply(tr.acc_wr, ca1)
    show by taut(hlt, ca0, ca1, be)
  qed
  show by taut(c1, c2)
qed

// (a read of n bytes: the same from two memories agreeing on them)
theorem tr.le_same: all b1 b2 r n. n in omega ->
  (all k. k in omega -> int_lt(k, n) -> app(b1, bits_add(64, r, bits_of_int(64, k))) = app(b2, bits_add(64, r, bits_of_int(64, k)))) ->
  x86_64_linux.le(b1, r, n) = x86_64_linux.le(b2, r, n)
proof
  fix b1 b2 r n
  assume hn hk
  let F1(j) := int_mul(app(b1, bits_add(64, r, bits_of_int(64, j))), int_pow(256, j))
  let F2(j) := int_mul(app(b2, bits_add(64, r, bits_of_int(64, j))), int_pow(256, j))
  have s: all i. i in omega -> int_le(i, n) -> int_sum(0, i, j. F1(j)) = int_sum(0, i, j. F2(j)) proof
    have base: int_le(0, n) -> int_sum(0, 0, j. F1(j)) = int_sum(0, 0, j. F2(j)) proof
      assume z
      have r1 := rec({nat_rec(empty, k v. int_add(v, F1(int_add(0, k))), 0)})
      have r2 := rec({nat_rec(empty, k v. int_add(v, F2(int_add(0, k))), 0)})
      show by defs(simp(r1, r2), int_sum)
    qed
    have step: all i. i in omega -> (int_le(i, n) -> int_sum(0, i, j. F1(j)) = int_sum(0, i, j. F2(j))) ->
        int_le(int_add(i, 1), n) -> int_sum(0, int_add(i, 1), j. F1(j)) = int_sum(0, int_add(i, 1), j. F2(j)) proof
      fix i
      assume hi ih hle
      have le: int_le(i, n) by arith(hi, hn, hle)
      have lt: int_lt(i, n) by arith(hi, hn, hle)
      have e0 := mp(ih, le)
      have ek := mp(all_elim(hk, {i}), hi, lt)
      have u1: int_sum(0, int_add(i, 1), j. F1(j)) = int_add(int_sum(0, i, j. F1(j)), F1(i)) by defs(simp(hi, rec({nat_rec(empty, k v. int_add(v, F1(int_add(0, k))), int_add(i, 1))}, hi)), int_sum)
      have u2: int_sum(0, int_add(i, 1), j. F2(j)) = int_add(int_sum(0, i, j. F2(j)), F2(i)) by defs(simp(hi, rec({nat_rec(empty, k v. int_add(v, F2(int_add(0, k))), int_add(i, 1))}, hi)), int_sum)
      show by simp(u1, u2, e0, ek)
    qed
    show by induct(base, step)
  qed
  have nn: int_le(n, n) by arith(hn)
  have sn := mp(all_elim(s, {n}), hn, nn)
  show by defs(simp(sn), x86_64_linux.le)
qed


// A GIMPLE load's n bytes at a (usable in the world): accessible in the
// machine, its little-endian value the world's
theorem tr.mem_load: all s m w ob a n wr. tr.mem(s, m, w, ob) -> gimple.usable(app(w, "vm"), app(w, "objs"), a, n, wr) -> a in bits(64) -> n in omega ->
  (all j. j in omega -> int_lt(j, n) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, a, bits_of_int(64, j)), 0)) &&
  x86_64_linux.le(app(app(m, "vm"), "bytes"), a, n) = x86_64_linux.le(app(app(w, "vm"), "bytes"), a, n)
proof
  fix s m w ob a n wr
  assume hmm hus ha hn
  have a0: int_le(0, a) by simp(ha)
  have p64: pow2(64) = 18446744073709551616 by simp()
  have rd: all j. j in omega -> int_lt(j, n) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, a, bits_of_int(64, j)), 0) &&
      app(app(app(m, "vm"), "bytes"), bits_add(64, a, bits_of_int(64, j))) = app(app(app(w, "vm"), "bytes"), bits_add(64, a, bits_of_int(64, j))) proof
    fix j
    assume j1 j2
    have r := apply(tr.mem_read, {s}, {m}, {w}, {ob}, {a}, {n}, {wr}, {j}, hmm, hus, a0, j1, j2)
    // (the j-th byte's address: a + j)
    have l: int_lt(int_add(a, j), 18446744073709551616) by taut(r)
    have e0: int_mod(int_add(a, int_mod(j, 18446744073709551616)), 18446744073709551616) = int_add(a, j) by arith(a0, j1, j2, l)
    have e: bits_add(64, a, bits_of_int(64, j)) = int_add(a, j) by defs(rewrite(sym(p64), e0), bits_add, bits_of_int)
    show by simp(r, e)
  qed
  have ac: all j. j in omega -> int_lt(j, n) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, a, bits_of_int(64, j)), 0) proof
    fix j
    assume j1 j2
    show by taut(mp(all_elim(rd, {j}), j1, j2))
  qed
  have by: all j. j in omega -> int_lt(j, n) -> app(app(app(m, "vm"), "bytes"), bits_add(64, a, bits_of_int(64, j))) = app(app(app(w, "vm"), "bytes"), bits_add(64, a, bits_of_int(64, j))) proof
    fix j
    assume j1 j2
    show by taut(mp(all_elim(rd, {j}), j1, j2))
  qed
  have ls := apply(tr.le_same, {app(app(m, "vm"), "bytes")}, {app(app(w, "vm"), "bytes")}, {a}, {n}, hn, by)
  show by taut(ac, ls)
qed

// the world's bytes: typed
theorem tr.world_bytes: all s base code fr m w. tr.inv(s, base, code, fr, m, w) -> app(app(w, "vm"), "bytes") in fn_space(bits(64), bits(8))
proof
  fix s base code fr m w
  assume hi
  show by simp(expand(expand(hi.wW, abi.World), x86_64_linux.Vm))
qed

// a register an instruction may write: not rsp, not callee-saved
def tr.scratch_reg(g) := g in x86_64_linux.Reg && !(g = 3) && !(g = 4) && !(g = 5) && !(g = 12) && !(g = 13) && !(g = 14) && !(g = 15)

// the invariant after a register write (and rip, the flags)
theorem tr.inv_reg: all s base code fr m w r f g x. tr.inv(s, base, code, fr, m, w) -> r in bits(64) -> x86i.flags_ok(m, f) -> tr.scratch_reg(g) -> x in bits(64) ->
  tr.inv(s, base, code, fr, fn_update(fn_update(fn_update(m, "rip", r), "flags", f), "gpr", fn_update(app(m, "gpr"), g, x)), w)
proof
  fix s base code fr m w r f g x
  assume hi hr hf hg hx
  have i := expand(hi, tr.inv)
  have {mM, mu} := i
  have pt := apply(x86i.parts, mM)
  have f1 := expand(hf, x86i.flags_ok)
  have g1 := expand(hg, tr.scratch_reg)
  have m2: fn_update(fn_update(fn_update(m, "rip", r), "flags", f), "gpr", fn_update(app(m, "gpr"), g, x)) in x86_64_linux.Machine by defs(simp(expand(mM, x86_64_linux.Machine), mu, hr, f1, g1, hx, pt), x86_64_linux.Machine)
  have gn: !(g = 3) && !(g = 4) && !(g = 5) && !(g = 12) && !(g = 13) && !(g = 14) && !(g = 15) by taut(g1)
  have gu: g in univ(1) by simp(g1)
  // (rsp and the callee-saved registers untouched)
  have e3 := mp(app_update_other[f := app(m, "gpr"), k := g, v := x, x := 3], simp(gn))
  have e4 := mp(app_update_other[f := app(m, "gpr"), k := g, v := x, x := 4], simp(gn))
  have e5 := mp(app_update_other[f := app(m, "gpr"), k := g, v := x, x := 5], simp(gn))
  have e12 := mp(app_update_other[f := app(m, "gpr"), k := g, v := x, x := 12], simp(gn))
  have e13 := mp(app_update_other[f := app(m, "gpr"), k := g, v := x, x := 13], simp(gn))
  have e14 := mp(app_update_other[f := app(m, "gpr"), k := g, v := x, x := 14], simp(gn))
  have e15 := mp(app_update_other[f := app(m, "gpr"), k := g, v := x, x := 15], simp(gn))
  show by defs(simp(i, m2, hr, f1, gn, gu, hx, e3, e4, e5, e12, e13, e14, e15, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access)), tr.inv)
qed

// the registers after the write of x to g: g holds x
theorem tr.regs_set: all m rs g n x. tr.regs(m, rs) -> x in bits(int_mul(8, n)) ->
  tr.regs(fn_update(m, "gpr", fn_update(app(m, "gpr"), g, x)), fn_update(rs, g, pair(n, x)))
proof
  fix m rs g n x
  assume h hx
  have fr r := expand(h, tr.regs)
  have du := mp(dom_update[f := rs, k := g, v := pair(n, x)], fr)
  have fu := mp(fn_update_fun[f := rs, k := g, v := pair(n, x)], fr)
  have k: all r0. r0 in dom(fn_update(rs, g, pair(n, x))) -> app(app(fn_update(m, "gpr", fn_update(app(m, "gpr"), g, x)), "gpr"), r0) = snd(app(fn_update(rs, g, pair(n, x)), r0)) &&
      snd(app(fn_update(rs, g, pair(n, x)), r0)) in bits(int_mul(8, fst(app(fn_update(rs, g, pair(n, x)), r0)))) proof
    fix r0
    assume hd
    have same: r0 = g -> app(app(fn_update(m, "gpr", fn_update(app(m, "gpr"), g, x)), "gpr"), r0) = snd(app(fn_update(rs, g, pair(n, x)), r0)) &&
        snd(app(fn_update(rs, g, pair(n, x)), r0)) in bits(int_mul(8, fst(app(fn_update(rs, g, pair(n, x)), r0)))) by simp(hx)
    have other: !(r0 = g) -> app(app(fn_update(m, "gpr", fn_update(app(m, "gpr"), g, x)), "gpr"), r0) = snd(app(fn_update(rs, g, pair(n, x)), r0)) &&
        snd(app(fn_update(rs, g, pair(n, x)), r0)) in bits(int_mul(8, fst(app(fn_update(rs, g, pair(n, x)), r0)))) proof
      assume ne
      have e1 := mp(app_update_other[f := app(m, "gpr"), k := g, v := x, x := r0], ne)
      have e2 := mp(app_update_other[f := rs, k := g, v := pair(n, x), x := r0], ne)
      have hd2 := rewrite(du, hd)
      have d0: r0 in dom(rs) by simp(hd2, ne)
      have c := mp(all_elim(r, {r0}), d0)
      show by simp(e1, e2, c)
    qed
    show by taut(same, other)
  qed
  show by defs(taut(fu, k), tr.regs)
qed

// (the entry's rsp: at least 8, as rsp + 8 is 16-aligned)
theorem tr.inv_sp8: all s base code fr m w. tr.inv(s, base, code, fr, m, w) -> int_le(8, app(app(s, "gpr"), 4))
proof
  fix s base code fr m w
  assume hi
  have {sM, sal, slt} := hi
  have r4 := apply(x86i.rsp_typed, sM)
  have p64: pow2(64) = 18446744073709551616 by simp()
  have e0: int_mod(int_add(app(app(s, "gpr"), 4), 8), 18446744073709551616) = int_add(app(app(s, "gpr"), 4), 8) by arith(r4, slt)
  have e: bits_add(64, app(app(s, "gpr"), 4), 8) = int_add(app(app(s, "gpr"), 4), 8) by defs(rewrite(sym(p64), e0), bits_add)
  have al2 := rewrite(e, sal)
  show by arith(al2, r4)
qed

// (the entry's rsp: above the guard gap -- a frame's push does not wrap)
theorem tr.inv_gap: all s base code fr m w. tr.inv(s, base, code, fr, m, w) -> int_le(1048576, app(app(s, "gpr"), 4))
proof
  fix s base code fr m w
  assume hi
  have {sM, hsps, sgf} := hi
  have r4 := apply(x86i.rsp_typed, sM)
  have po: int_div(app(app(s, "gpr"), 4), 4096) in omega by simp(r4)
  have c := mp(all_elim(expand(sgf, abi.stack_gap_free).2, {int_div(app(app(s, "gpr"), 4), 4096)}), po, hsps)
  have c2: int_le(1048576, int_mul(int_div(app(app(s, "gpr"), 4), 4096), 4096)) by simp(expand(c, x86_64_linux.STACK_GUARD_GAP, x86_64_linux.PAGE))
  show by arith(c2, r4)
qed

// the invariant after rsp := s's less fr2, a frame of at most tr.FMAX bytes (and
// rip, the flags)
theorem tr.inv_rsp: all s base code fr fr2 m w r f. tr.inv(s, base, code, fr, m, w) -> r in bits(64) -> x86i.flags_ok(m, f) -> fr2 in omega -> int_le(fr2, tr.FMAX) ->
  tr.inv(s, base, code, fr2, fn_update(fn_update(fn_update(m, "rip", r), "flags", f), "gpr", fn_update(app(m, "gpr"), 4, int_sub(app(app(s, "gpr"), 4), fr2))), w)
proof
  fix s base code fr fr2 m w r f
  assume hi hr hf hfo hfl
  have i := expand(hi, tr.inv)
  have {mM, mu, sM} := i
  have r4 := apply(x86i.rsp_typed, sM)
  have s8 := apply(tr.inv_gap, hi)
  have x64: int_sub(app(app(s, "gpr"), 4), fr2) in bits(64) by arith(r4, s8, hfo, hfl)
  have pt := apply(x86i.parts, mM)
  have f1 := expand(hf, x86i.flags_ok)
  have m2: fn_update(fn_update(fn_update(m, "rip", r), "flags", f), "gpr", fn_update(app(m, "gpr"), 4, int_sub(app(app(s, "gpr"), 4), fr2))) in x86_64_linux.Machine
    by defs(simp(expand(mM, x86_64_linux.Machine), mu, hr, f1, x64, pt), x86_64_linux.Machine)
  have xu: int_sub(app(app(s, "gpr"), 4), fr2) in univ(1) by simp(x64)
  // (the callee-saved registers untouched)
  have e3 := mp(app_update_other[f := app(m, "gpr"), k := 4, v := int_sub(app(app(s, "gpr"), 4), fr2), x := 3], simp())
  have e5 := mp(app_update_other[f := app(m, "gpr"), k := 4, v := int_sub(app(app(s, "gpr"), 4), fr2), x := 5], simp())
  have e12 := mp(app_update_other[f := app(m, "gpr"), k := 4, v := int_sub(app(app(s, "gpr"), 4), fr2), x := 12], simp())
  have e13 := mp(app_update_other[f := app(m, "gpr"), k := 4, v := int_sub(app(app(s, "gpr"), 4), fr2), x := 13], simp())
  have e14 := mp(app_update_other[f := app(m, "gpr"), k := 4, v := int_sub(app(app(s, "gpr"), 4), fr2), x := 14], simp())
  have e15 := mp(app_update_other[f := app(m, "gpr"), k := 4, v := int_sub(app(app(s, "gpr"), 4), fr2), x := 15], simp())
  show by defs(simp(i, m2, hr, f1, xu, hfo, e3, e5, e12, e13, e14, e15, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access)), tr.inv)
qed

// the registers after a write of rsp (not among them)
theorem tr.regs_keep4: all m rs r f x. tr.regs(m, rs) -> !(4 in dom(rs)) ->
  tr.regs(fn_update(fn_update(fn_update(m, "rip", r), "flags", f), "gpr", fn_update(app(m, "gpr"), 4, x)), rs)
proof
  fix m rs r f x
  assume h hn
  have fu rr := expand(h, tr.regs)
  have k: all r1. r1 in dom(rs) -> app(app(fn_update(fn_update(fn_update(m, "rip", r), "flags", f), "gpr", fn_update(app(m, "gpr"), 4, x)), "gpr"), r1) = snd(app(rs, r1)) &&
      snd(app(rs, r1)) in bits(int_mul(8, fst(app(rs, r1)))) proof
    fix r1
    assume hd
    have ne0: r1 = 4 -> false proof
      assume e
      have h4 := rewrite(e, hd)
      show by taut(h4, hn)
    qed
    have ne: !(r1 = 4) by taut(ne0)
    have e1 := mp(app_update_other[f := app(m, "gpr"), k := 4, v := x, x := r1], ne)
    have c := mp(all_elim(rr, {r1}), hd)
    show by simp(e1, c)
  qed
  show by defs(taut(fu, k), tr.regs)
qed

// a step setting rsp to s's less fr2 (a frame of at most 8 bytes): the
// claim with the frame fr2 after it gives the claim before
theorem tr.rsp_step(zb. bkp, zb pb wb. bka): all s v base code fr fr2 a a2 hs ds rs p w.
  (all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
     (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), 4, int_sub(app(app(s, "gpr"), 4), fr2))), empty))) ->
  a2 in bits(64) -> fr2 in omega -> int_le(fr2, tr.FMAX) -> !(4 in dom(rs)) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr2, a2, hs, ds, rs, p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr fr2 a a2 hs ds rs p w
  assume he ha2 hfo hfl hn4 hpt
  let X := int_sub(app(app(s, "gpr"), 4), fr2)
  have g: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, ds) -> tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m) proof
    fix m
    assume hi hr hh hrs hmm hfr
    let Q(m2) := ex f. x86i.flags_ok(m, f) && m2 = fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), 4, X))
    have st: all o. runs(x86_64_linux.step(), m, o) -> (ex m2. o = ok(m2, empty) && Q(m2)) proof
      fix o
      assume ho
      obtain f, hf from mp(mp(mp(mp(mp(all_elim(he, {m}, {o}), hi), hr), hh), hrs), ho)
      have q2: Q(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), 4, X))) by ex_intro({f}, simp(hf, keep(x86i.flags_ok)))
      show by ex_intro({fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), 4, X))}, taut(q2, hf))
    qed
    have nr := apply(tr.inv_nr, hi)
    // (after the step: coupled at a2, in the frame fr2)
    have post: all m2. Q(m2) -> tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m2) proof
      fix m2
      assume hq
      obtain f, fo e from hq
      have i2 := apply(tr.inv_rsp, {s}, {base}, {code}, {fr}, {fr2}, {m}, {w}, {a2}, {f}, hi, ha2, fo, hfo, hfl)
      have rs2 := apply(tr.regs_keep4, {m}, {rs}, {a2}, {f}, {X}, hrs, hn4)
      have rip2: app(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), 4, X)), "rip") = a2 by simp()
      have c := apply(tr.pt_regs[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr2}, {a2}, {hs}, {ds}, {rs}, {p}, {w}, {m}, {fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), 4, X))},
        hpt, i2, rip2, rs2, hh, hmm, hfr, simp(), simp())
      show := rewrite(sym(e), c)
    qed
    show := mp(mp(mp(tr.step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb), s := s, v := v, p := p, w := w, m := m, q := x. Q(x)], st), nr), post)
  qed
  show by defs(g, tr.lv)
qed

// sub rsp, imm8 (the prologue): the frame grows by k, to at most 8 bytes
theorem tr.sub_rsp(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len z k fr2 hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(60, pair(8, pair(5, pair(tag(0, 4), pair(z, k)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> k in bits(8) -> int_lt(k, 128) -> fr2 = int_add(fr, k) -> fr2 in omega -> int_le(fr2, tr.FMAX) -> !(4 in dom(rs)) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr2, a2, hs, ds, rs, p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len z k fr2 hs ds rs p w
  assume hat ha2 hk hkl hf2 hfo hfl hn4 hpt
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), 4, int_sub(app(app(s, "gpr"), 4), fr2))), empty)) proof
    fix m o
    assume hi hr hhs hrs ho
    have {mM, mu, cd, rspm, fro, sM} := hi
    have r4R: 4 in x86_64_linux.Reg by simp()
    have hx := mp(mp(mp(all_elim(hat, {m}, {o}), ho), cd), hr)
    obtain f, hf from apply(x86i.sub64_imm, {m}, {o}, {4}, {z}, {k}, {len}, mM, mu, r4R, hk, hx)
    // (rsp - k: s's less fr + k, no wrap)
    have r4 := apply(x86i.rsp_typed, sM)
    have s8 := apply(tr.inv_gap, hi)
    have sx: bits_sext(8, 64, k) = k by defs(simp(hk, hkl), bits_sext, sint)
    have p64: pow2(64) = 18446744073709551616 by simp()
    have e0: int_mod(int_sub(int_sub(app(app(s, "gpr"), 4), fr), k), 18446744073709551616) = int_sub(app(app(s, "gpr"), 4), fr2) by arith(r4, s8, fro, hk, hf2, hfl)
    have e2: int_mod(int_sub(app(app(m, "gpr"), 4), bits_sext(8, 64, k)), 18446744073709551616) = int_sub(app(app(s, "gpr"), 4), fr2) by simp(e0, rspm, sx)
    have e1: bits_sub(64, app(app(m, "gpr"), 4), bits_sext(8, 64, k)) = int_sub(app(app(s, "gpr"), 4), fr2) by defs(rewrite(sym(p64), e2), bits_sub)
    show by ex_intro({f}, simp(hf, e1, hr, ha2, keep(x86i.flags_ok)))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.rsp_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {fr2}, {a}, {a2}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hfo, hfl, hn4, hpt)
qed

// add rsp, imm8 (the epilogue): the frame shrinks by k
theorem tr.add_rsp(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len z k fr2 hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(60, pair(8, pair(0, pair(tag(0, 4), pair(z, k)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> k in bits(8) -> int_lt(k, 128) -> fr2 = int_sub(fr, k) -> fr2 in omega -> int_le(fr2, tr.FMAX) -> !(4 in dom(rs)) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr2, a2, hs, ds, rs, p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len z k fr2 hs ds rs p w
  assume hat ha2 hk hkl hf2 hfo hfl hn4 hpt
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), 4, int_sub(app(app(s, "gpr"), 4), fr2))), empty)) proof
    fix m o
    assume hi hr hhs hrs ho
    have {mM, mu, cd, rspm, fro, sM, slt} := hi
    have r4R: 4 in x86_64_linux.Reg by simp()
    have hx := mp(mp(mp(all_elim(hat, {m}, {o}), ho), cd), hr)
    obtain f, hf from apply(x86i.add64_imm, {m}, {o}, {4}, {z}, {k}, {len}, mM, mu, r4R, hk, hx)
    // (rsp + k: s's less fr - k, below 2^64)
    have r4 := apply(x86i.rsp_typed, sM)
    have m4 := apply(x86i.rsp_typed, mM)
    have m4b := rewrite(rspm, m4)
    have sx: bits_sext(8, 64, k) = k by defs(simp(hk, hkl), bits_sext, sint)
    have p64: pow2(64) = 18446744073709551616 by simp()
    have e0: int_mod(int_add(int_sub(app(app(s, "gpr"), 4), fr), k), 18446744073709551616) = int_sub(app(app(s, "gpr"), 4), fr2) by arith(r4, slt, m4b, fro, hk, hf2, hfo)
    have e2: int_mod(int_add(app(app(m, "gpr"), 4), bits_sext(8, 64, k)), 18446744073709551616) = int_sub(app(app(s, "gpr"), 4), fr2) by simp(e0, rspm, sx)
    have e1: bits_add(64, app(app(m, "gpr"), 4), bits_sext(8, 64, k)) = int_sub(app(app(s, "gpr"), 4), fr2) by defs(rewrite(sym(p64), e2), bits_add)
    show by ex_intro({f}, simp(hf, e1, hr, ha2, keep(x86i.flags_ok)))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.rsp_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {fr2}, {a}, {a2}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hfo, hfl, hn4, hpt)
qed

// a register write's step: from a coupled state at a, the instruction ends
// with g := V (the value the coupling gives) and rip a2, the flags open;
// the claim after it, with g holding V, gives the claim at a
theorem tr.reg_step(zb. bkp, zb pb wb. bka): all s v base code fr a a2 g n bigv hs ds rs p w.
  (all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
     (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bigv)), empty))) ->
  a2 in bits(64) -> tr.scratch_reg(g) ->
  (all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> bigv in bits(int_mul(8, n)) && bigv in bits(64)) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(n, bigv)), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 g n bigv hs ds rs p w
  assume he ha2 hg ht hpt
  have g: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, ds) -> tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m) proof
    fix m
    assume hi hr hh hrs hmm hfr
    have hv v64 := mp(mp(mp(mp(all_elim(ht, {m}), hi), hr), hh), hrs)
    let Q(m2) := ex f. x86i.flags_ok(m, f) && m2 = fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bigv))
    have st: all o. runs(x86_64_linux.step(), m, o) -> (ex m2. o = ok(m2, empty) && Q(m2)) proof
      fix o
      assume ho
      obtain f, hf from mp(mp(mp(mp(mp(all_elim(he, {m}, {o}), hi), hr), hh), hrs), ho)
      have q2: Q(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bigv))) by ex_intro({f}, simp(hf, keep(x86i.flags_ok)))
      show by ex_intro({fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bigv))}, taut(q2, hf))
    qed
    // (not at the return: rsp is s's, not past the return address)
    have nr := apply(tr.inv_nr, hi)
    // (after the step: coupled at a2)
    have post: all m2. Q(m2) -> tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m2) proof
      fix m2
      assume hq
      obtain f, fo e from hq
      have i2 := apply(tr.inv_reg, {s}, {base}, {code}, {fr}, {m}, {w}, {a2}, {f}, {g}, {bigv}, hi, ha2, fo, hg, v64)
      have rs1 := apply(tr.regs_set, {m}, {rs}, {g}, {n}, {bigv}, hrs, hv)
      have rs2: tr.regs(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bigv)), fn_update(rs, g, pair(n, bigv))) by defs(simp(expand(rs1, tr.regs)), tr.regs)
      have rip2: app(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bigv)), "rip") = a2 by simp()
      have c := apply(tr.pt_regs[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], hpt, i2, rip2, rs2, hh, hmm, hfr, simp(), simp())
      show := rewrite(sym(e), c)
    qed
    show := mp(mp(mp(tr.step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb), s := s, v := v, p := p, w := w, m := m, q := x. Q(x)], st), nr), post)
  qed
  show by defs(g, tr.lv)
qed

// the invariant's facts the instruction rules use
theorem tr.inv_parts: all s base code fr m w. tr.inv(s, base, code, fr, m, w) ->
  m in x86_64_linux.Machine && m in univ(1) && abi.code_at(app(m, "vm"), base, code) && app(app(m, "gpr"), 4) = int_sub(app(app(s, "gpr"), 4), fr)
proof
  fix s base code fr m w
  assume hi
  show := conj(hi.mM, hi.mu, hi.cd, hi.rspm)
qed

// (an instruction leaving the flags: as setting them to themselves)
theorem tr.flags_same: all m a2 x. m in x86_64_linux.Machine ->
  fn_update(fn_update(fn_update(m, "rip", a2), "flags", app(m, "flags")), "gpr", x) = fn_update(fn_update(m, "rip", a2), "gpr", x)
proof
  fix m a2 x
  assume hM
  have mf: is_fun(m) && "flags" in dom(m) by simp(expand(hM, x86_64_linux.Machine))
  have mfun := mf.1
  have f1 := mp(fn_update_fun[f := m, k := "rip", v := a2], mfun)
  have d1 := mp(dom_update[f := m, k := "rip", v := a2], mfun)
  have r1: is_fun(fn_update(m, "rip", a2)) && "flags" in dom(fn_update(m, "rip", a2)) by simp(mf, f1, d1)
  have e := mp(mp(fn_update_same[f := fn_update(m, "rip", a2), k := "flags"], simp(r1)), simp(r1))
  have e2: app(fn_update(m, "rip", a2), "flags") = app(m, "flags") by simp()
  have e3 := rewrite(e2, e)
  show := subst({y. fn_update(fn_update(fn_update(m, "rip", a2), "flags", app(m, "flags")), "gpr", x) = fn_update(y, "gpr", x)}, e3,
    refl({fn_update(fn_update(fn_update(m, "rip", a2), "flags", app(m, "flags")), "gpr", x)}))
qed

theorem tr.flags_ok_same: all m. m in x86_64_linux.Machine -> m in univ(1) -> x86i.flags_ok(m, app(m, "flags"))
proof
  fix m
  assume hM hu
  have pt := apply(x86i.parts, hM)
  show by defs(simp(pt, hu), x86i.flags_ok)
qed

// a register write leaving the flags
theorem tr.reg_step0(zb. bkp, zb pb wb. bka): all s v base code fr a a2 g n bigv hs ds rs p w.
  (all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
     o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(app(m, "gpr"), g, bigv)), empty)) ->
  a2 in bits(64) -> tr.scratch_reg(g) ->
  (all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> bigv in bits(int_mul(8, n)) && bigv in bits(64)) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(n, bigv)), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 g n bigv hs ds rs p w
  assume he0 ha2 hg ht hpt
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bigv)), empty)) proof
    fix m o
    assume hi hr hh hrs ho
    have mM mu .. := apply(tr.inv_parts, hi)
    have eo := mp(mp(mp(mp(mp(all_elim(he0, {m}, {o}), hi), hr), hh), hrs), ho)
    have fs := mp(all_elim(tr.flags_same, {m}, {a2}, {fn_update(app(m, "gpr"), g, bigv)}), mM)
    have fo := mp(mp(all_elim(tr.flags_ok_same, {m}), mM), mu)
    show by ex_intro({app(m, "flags")}, taut(fo, rewrite(sym(fs), eo)))
  qed
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {n}, {bigv}, {hs}, {ds}, {rs}, {p}, {w}, he, ha2, hg, ht, hpt)
qed

// the same for an instruction reading memory: the step given the memory's
// coupling
theorem tr.reg_stepv(zb. bkp, zb pb wb. bka): all s v base code fr a a2 g n bigv hs ds rs p w.
  (all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
     (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bigv)), empty))) ->
  a2 in bits(64) -> tr.scratch_reg(g) ->
  (all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> bigv in bits(int_mul(8, n)) && bigv in bits(64)) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs, g, pair(n, bigv)), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 g n bigv hs ds rs p w
  assume he ha2 hg ht hpt
  have g: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, ds) -> tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m) proof
    fix m
    assume hi hr hh hrs hmm hfr
    have hv v64 := mp(all_elim(ht, {m}), hi, hr, hh, hrs, hmm)
    let Q(m2) := ex f. x86i.flags_ok(m, f) && m2 = fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bigv))
    have st: all o. runs(x86_64_linux.step(), m, o) -> (ex m2. o = ok(m2, empty) && Q(m2)) proof
      fix o
      assume ho
      obtain f, hf from mp(all_elim(he, {m}, {o}), hi, hr, hh, hrs, hmm, ho)
      have q2: Q(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bigv))) by ex_intro({f}, simp(hf, keep(x86i.flags_ok)))
      show by ex_intro({fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bigv))}, taut(q2, hf))
    qed
    have nr := apply(tr.inv_nr, hi)
    have post: all m2. Q(m2) -> tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m2) proof
      fix m2
      assume hq
      obtain f, fo e from hq
      have i2 := apply(tr.inv_reg, {s}, {base}, {code}, {fr}, {m}, {w}, {a2}, {f}, {g}, {bigv}, hi, ha2, fo, hg, v64)
      have rs1 := apply(tr.regs_set, {m}, {rs}, {g}, {n}, {bigv}, hrs, hv)
      have rs2: tr.regs(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bigv)), fn_update(rs, g, pair(n, bigv))) by defs(simp(expand(rs1, tr.regs)), tr.regs)
      have rip2: app(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bigv)), "rip") = a2 by simp()
      have c := apply(tr.pt_regs[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], hpt, i2, rip2, rs2, hh, hmm, hfr, simp(), simp())
      show := rewrite(sym(e), c)
    qed
    show := mp(mp(mp(tr.step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb), s := s, v := v, p := p, w := w, m := m, q := x. Q(x)], st), nr), post)
  qed
  show by defs(g, tr.lv)
qed

theorem tr.reg_step0v(zb. bkp, zb pb wb. bka): all s v base code fr a a2 g n bigv hs ds rs p w.
  (all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
     o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(app(m, "gpr"), g, bigv)), empty)) ->
  a2 in bits(64) -> tr.scratch_reg(g) ->
  (all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> bigv in bits(int_mul(8, n)) && bigv in bits(64)) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs, g, pair(n, bigv)), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 g n bigv hs ds rs p w
  assume he0 ha2 hg ht hpt
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bigv)), empty)) proof
    fix m o
    assume hi hr hh hrs hmm ho
    have mM mu .. := apply(tr.inv_parts, hi)
    have eo := mp(all_elim(he0, {m}, {o}), hi, hr, hh, hrs, hmm, ho)
    have fs := mp(all_elim(tr.flags_same, {m}, {a2}, {fn_update(app(m, "gpr"), g, bigv)}), mM)
    have fo := mp(mp(all_elim(tr.flags_ok_same, {m}), mM), mu)
    show by ex_intro({app(m, "flags")}, taut(fo, rewrite(sym(fs), eo)))
  qed
  show := apply(tr.reg_stepv[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {n}, {bigv}, {hs}, {ds}, {rs}, {p}, {w}, he, ha2, hg, ht, hpt)
qed

// a register the coupling gives
// a home the coupling gives
theorem tr.homes_get: all s m hs c n x. tr.homes(s, m, hs) -> c in dom(hs) -> app(hs, c) = pair(n, x) ->
  x86_64_linux.le(app(app(m, "vm"), "bytes"), bits_add(64, int_add(app(app(s, "gpr"), 4), c), 0), n) = x
proof
  fix s m hs c n x
  assume h hd he
  have k := mp(all_elim(expand(h, tr.homes), {c}), hd)
  have k2 := rewrite(he, k)
  show by simp(k2)
qed

// ... read at rsp + d in the frame (the instructions' address)
theorem tr.home_read: all s base code fr m w hs d c n x. tr.inv(s, base, code, fr, m, w) -> tr.homes(s, m, hs) -> d in bits(64) ->
  c = int_mod(int_sub(d, fr), 18446744073709551616) -> c in dom(hs) -> app(hs, c) = pair(n, x) ->
  x86_64_linux.le(app(app(m, "vm"), "bytes"), x86i.rsp_ea(m, d), n) = x
proof
  fix s base code fr m w hs d c n x
  assume hi hh hd hcd hc he
  have fe := apply(tr.frame_ea, {s}, {base}, {code}, {fr}, {m}, {w}, {d}, {c}, {0}, hi, hd, hcd, simp())
  have g := apply(tr.homes_get, {s}, {m}, {hs}, {c}, {n}, {x}, hh, hc, he)
  show := rewrite(sym(fe), g)
qed

// ... at rsp + d in the frame (the instructions' address)
theorem tr.home_acc: all s base code fr m w hs d c n x. tr.inv(s, base, code, fr, m, w) -> tr.homes(s, m, hs) -> d in bits(64) -> c = int_mod(int_sub(d, fr), 18446744073709551616) ->
  c in dom(hs) -> app(hs, c) = pair(n, x) ->
  x86i.acc(m, bits_add(64, int_add(app(app(m, "gpr"), 4), d), 0), n, 1) && x86i.acc(m, bits_add(64, int_add(app(app(m, "gpr"), 4), d), 0), n, 0)
proof
  fix s base code fr m w hs d c n x
  assume hi hh hd hcd hc he
  have fe := apply(tr.frame_ea, {s}, {base}, {code}, {fr}, {m}, {w}, {d}, {c}, {0}, hi, hd, hcd, simp())
  have k := rewrite(he, mp(all_elim(expand(hh, tr.homes), {c}), hc))
  have ha: tr.hacc(s, app(m, "vm"), c, n) by simp(k)
  have g1: all i. i in omega -> int_lt(i, n) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, bits_add(64, int_add(app(app(s, "gpr"), 4), c), 0), bits_of_int(64, i)), 1) proof
    fix i
    assume i1 i2
    show by taut(mp(all_elim(expand(ha, tr.hacc), {i}), i1, i2))
  qed
  have g0: all i. i in omega -> int_lt(i, n) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, bits_add(64, int_add(app(app(s, "gpr"), 4), c), 0), bits_of_int(64, i)), 0) proof
    fix i
    assume i1 i2
    show := apply(tr.acc_wr, mp(all_elim(g1, {i}), i1, i2))
  qed
  have a: x86i.acc(m, bits_add(64, int_add(app(app(s, "gpr"), 4), c), 0), n, 1) && x86i.acc(m, bits_add(64, int_add(app(app(s, "gpr"), 4), c), 0), n, 0) by taut(g1, g0)
  show := rewrite(sym(fe), a)
qed

// a map's keys (no functionality needed): the key updated, the others kept
theorem tr.dom_upd: all f k v. k in dom(fn_update(f, k, v))
proof
  fix f k v
  have i := fn_update_iff[f := f, k := k, v := v, z := pair(k, v)]
  have m: pair(k, v) in fn_update(f, k, v) by taut(i, refl({pair(k, v)}))
  show := mp(dom_intro[f := fn_update(f, k, v), k := k, v := v], m)
qed

theorem tr.dom_keep: all f k j v. k in dom(f) -> !(k = j) -> k in dom(fn_update(f, j, v))
proof
  fix f k j v
  assume hk hne
  have si := set_image_def[s := f, f := x. fst(x), y := k]
  have e: ex z. z in f && fst(z) = k by taut(si, expand(hk, dom))
  obtain z, hz from e
  have i := fn_update_iff[f := f, k := j, v := v, z := z]
  have ne2: j = k -> false by taut(hne)
  have zf: fst(z) != j by simp(hz, hne, ne2)
  have zin: z in fn_update(f, j, v) by taut(i, hz, zf)
  have si2 := set_image_def[s := fn_update(f, j, v), f := x. fst(x), y := k]
  have e2: ex z. z in fn_update(f, j, v) && fst(z) = k by ex_intro({z}, taut(zin, hz))
  show by defs(taut(si2, e2), dom)
qed

// a key not in a map: not in it after updates of other keys
theorem tr.dom_none: all k. !(k in dom(empty))
proof
  fix k
  show by simp(dom_empty)
qed

theorem tr.dom_out: all f k j v. !(k in dom(f)) -> !(k = j) -> !(k in dom(fn_update(f, j, v)))
proof
  fix f k j v
  assume hk hne
  have no: k in dom(fn_update(f, j, v)) -> false proof
    assume hin
    have si := set_image_def[s := fn_update(f, j, v), f := x. fst(x), y := k]
    have e: ex z. z in fn_update(f, j, v) && fst(z) = k by taut(si, expand(hin, dom))
    obtain z, hz from e
    have i := fn_update_iff[f := f, k := j, v := v, z := z]
    have c1: z in f && fst(z) != j -> false proof
      assume h1
      have si2 := set_image_def[s := f, f := x. fst(x), y := k]
      have e2: ex y. y in f && fst(y) = k by ex_intro({z}, taut(h1, hz))
      have kin: k in dom(f) by defs(taut(si2, e2), dom)
      show by taut(hk, kin)
    qed
    have c2: z = pair(j, v) -> false proof
      assume h2
      have zk: fst(z) = k by taut(hz)
      have f2: fst(z) = j by simp(h2)
      show by taut(hne, trans(sym(zk), f2))
    qed
    show by taut(i, hz, c1, c2)
  qed
  show by taut(no)
qed

theorem tr.regs_get: all m rs g n u. tr.regs(m, rs) -> g in dom(rs) -> app(rs, g) = pair(n, u) -> app(app(m, "gpr"), g) = u && u in bits(int_mul(8, n))
proof
  fix m rs g n u
  assume h hd he
  have r: all r. r in dom(rs) -> app(app(m, "gpr"), r) = snd(app(rs, r)) && snd(app(rs, r)) in bits(int_mul(8, fst(app(rs, r)))) by taut(expand(h, tr.regs))
  have c := mp(all_elim(r, {g}), hd)
  have c2 := rewrite(he, c)
  show by simp(c2)
qed

// ----------------------------------------------------------------------
//  The instructions, at a point (the at_ADDR fact: the bytes at a decode
//  to the instruction): from the claim after, the claim before

// not r32: g := ~u, the flags kept
theorem tr.not32(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g z u hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(64, pair(4, pair(2, pair(tag(0, g), z))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> g in dom(rs) -> app(rs, g) = pair(4, u) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs, g, pair(4, bits_not(32, u))), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g z u hs ds rs p w
  assume hat ha2 hg hd hu hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(app(m, "gpr"), g, bits_not(32, u))), empty) proof
    fix m o
    assume hi hr hh hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {4}, {u}, hrs, hd, hu)
    have hx := mp(mp(mp(all_elim(hat, {m}, {o}), ho), ipC), hr)
    have e := apply(x86i.not32, {m}, {o}, {g}, {z}, {len}, ipM, ipU, gR, hx)
    show by simp(e, rg, hr, ha2)
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_not(32, u) in bits(int_mul(8, 4)) && bits_not(32, u) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {bits_not(32, u)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// neg r32: g := 0 - u
theorem tr.neg32(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g z u hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(64, pair(4, pair(3, pair(tag(0, g), z))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> g in dom(rs) -> app(rs, g) = pair(4, u) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(4, bits_sub(32, 0, u))), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g z u hs ds rs p w
  assume hat ha2 hg hd hu hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bits_sub(32, 0, u))), empty)) proof
    fix m o
    assume hi hr hh hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {4}, {u}, hrs, hd, hu)
    have hx := mp(mp(mp(all_elim(hat, {m}, {o}), ho), ipC), hr)
    obtain f, hf from apply(x86i.neg32, {m}, {o}, {g}, {z}, {len}, ipM, ipU, gR, hx)
    show by ex_intro({f}, simp(hf, rg, hr, ha2, keep(x86i.flags_ok)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_sub(32, 0, u) in bits(int_mul(8, 4)) && bits_sub(32, 0, u) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {bits_sub(32, 0, u)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// shr r32, c: g := u >> c
theorem tr.shr32(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g z c u hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(72, pair(4, pair(5, pair(tag(0, g), pair(z, c)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> c in omega -> int_lt(0, c) -> int_lt(c, 32) -> g in dom(rs) -> app(rs, g) = pair(4, u) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(4, bits_shr(32, u, c))), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g z c u hs ds rs p w
  assume hat ha2 hg hc hc1 hc2 hd hu hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bits_shr(32, u, c))), empty)) proof
    fix m o
    assume hi hr hh hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {4}, {u}, hrs, hd, hu)
    have hx := mp(mp(mp(all_elim(hat, {m}, {o}), ho), ipC), hr)
    obtain f, hf from apply(x86i.shr32_imm, {m}, {o}, {g}, {z}, {c}, {len}, ipM, ipU, gR, hc, hc1, hc2, hx)
    show by ex_intro({f}, simp(hf, rg, hr, ha2, keep(x86i.flags_ok)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_shr(32, u, c) in bits(int_mul(8, 4)) && bits_shr(32, u, c) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {bits_shr(32, u, c)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// imul r32 g, r32 h, k: g := u * k. (The signed product's low 32 bits
// are the unsigned product's, for the immediate k: `tr.imul_by(k)`, linear
// for a literal k. TODO: from the ring laws of int_mul, once, for any k.)
def tr.imul_by(k) := all y. y in bits(32) -> bits_add(32, int_mul(sint(32, y), sint(32, k)), 0) = bits_mul(32, y, k)

theorem tr.imul32(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g h z1 z2 k u hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(89, pair(4, pair(g, pair(tag(0, h), pair(z1, pair(z2, k))))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> h in x86_64_linux.Reg -> k in bits(32) -> tr.imul_by(k) -> h in dom(rs) -> app(rs, h) = pair(4, u) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(4, bits_mul(32, u, k))), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g h z1 z2 k u hs ds rs p w
  assume hat ha2 hg hh hk hkb hd hu hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bits_mul(32, u, k))), empty)) proof
    fix m o
    assume hi hr hhs hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {h}, {4}, {u}, hrs, hd, hu)
    have u32: u in bits(32) by simp(rg)
    have mu := mp(all_elim(expand(hkb, tr.imul_by), {u}), u32)
    have hx := mp(mp(mp(all_elim(hat, {m}, {o}), ho), ipC), hr)
    obtain f, hf from apply(x86i.imul32_imm, {m}, {o}, {g}, {h}, {z1}, {z2}, {k}, {len}, ipM, ipU, gR, hh, hk, hx)
    show by ex_intro({f}, simp(hf, rg, mu, hr, ha2, keep(x86i.flags_ok)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_mul(32, u, k) in bits(int_mul(8, 4)) && bits_mul(32, u, k) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {bits_mul(32, u, k)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// mov r32 h, r32 g: h := u (zero-extended: the same value)
theorem tr.mov32_rr(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g h z1 z2 u hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(75, pair(4, pair(g, pair(tag(0, h), pair(z1, z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(h) -> g in x86_64_linux.Reg -> g in dom(rs) -> app(rs, g) = pair(4, u) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs,h, pair(4, u)), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g h z1 z2 u hs ds rs p w
  assume hat ha2 hh hg hd hu hpt
  have hR: h in x86_64_linux.Reg by taut(expand(hh, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(app(m, "gpr"), h, u)), empty) proof
    fix m o
    assume hi hr hhs hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {4}, {u}, hrs, hd, hu)
    have hx := mp(mp(mp(all_elim(hat, {m}, {o}), ho), ipC), hr)
    have e := apply(x86i.mov32_rr, {m}, {o}, {g}, {h}, {z1}, {z2}, {len}, ipM, ipU, hg, hR, hx)
    show by simp(e, rg, hr, ha2)
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      u in bits(int_mul(8, 4)) && u in bits(64) proof
    fix m
    assume hi hr hhs hrs
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {4}, {u}, hrs, hd, hu)
    show by simp(rg)
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {h}, {4}, {u}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hh, ty, hpt)
qed

// mov r64 h, r64 g: h := u
theorem tr.mov64_rr(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g h z1 z2 u hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(75, pair(8, pair(g, pair(tag(0, h), pair(z1, z2)))))), m, o)) ->
