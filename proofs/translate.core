// The translation of a function's machine code from its readable GIMPLE,
// statement by statement (docs/bridge-pattern-design.md): the claim at a
// point of the function, and the rules a function's proof chains from its
// return back to its entry.
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core core/records.core \
//     core/list.core core/loop.core build/c_mallocng_malloc.core proofs/x86.core proofs/x86_code.core \
//     proofs/abi.core proofs/abi_restore.core proofs/abi_glue.core proofs/gimple.core proofs/abi_stack.core \
//     proofs/abi_loop.core proofs/abi_bridge.core proofs/translate.core

// ----------------------------------------------------------------------
//  The claim at a point: from the machine state m, the rest of the run to
//  the caller of the entry s matches the rest of the spec, the program P
//  from the world w -- P raises (undefined behaviour: anything), or the
//  machine returns as P returns (abi.matches_at's return case). (No
//  divergence: a function without loops returns or faults; the loop rule
//  adds it.)

def tr.ub(s, v, p, w) := ex e x. e in univ(1) && !(e = exc_val("stack_overflow", empty)) && abi.raise_state(x) && runs(p, w, exc(x, e))

// (a pair is not empty: the raise the rules use is no stack overflow)
theorem tr.pair_ne: all a b. !(empty = pair(a, b))
proof
  fix a b
  have m: single(a) in pair(a, b) by defs(upair_l[a := single(a), b := upair(a, b)], pair)
  have n: empty = pair(a, b) -> false proof
    assume e
    have m2 := rewrite(sym(e), m)
    show by taut(m2, empty_mem[x := single(a)])
  qed
  show by taut(n)
qed

def tr.ok(s, v, p, w, o) :=
  ex m1 w2. o = ok(m1, empty) && m1 in x86_64_linux.Machine && m1 in univ(1) &&
    runs(p, w, ok(w2, pair(app(app(m1, "gpr"), 0), app(app(m1, "gpr"), 2)))) && w2 in abi.World && w2 in univ(1) &&
    abi.world_matches(app(s, "vm"), app(m1, "vm"), app(w2, "vm"), v, abi.sp(s)) && app(m1, "os") = app(w2, "os") && app(m1, "fs_base") = app(w2, "fs_base") &&
    app(m1, "cpu") = app(s, "cpu") && app(m1, "gs_base") = app(s, "gs_base") && app(m1, "rip") = abi.ret(s) && app(app(m1, "gpr"), 4) = abi.sp(s) &&
    abi.callee_saved(m1, s) && !app(app(m1, "flags"), "df")

// abi.run_from's parts: one pass of its loop from the state l (a step,
// unless at the return), the loop, its outcome as the run's
// (definitions, not abbreviations: a case analysis sees each as one atom)
abbrev tr.at_ret(s, x) := app(x, "rip") = x86_64_linux.le(app(app(s, "vm"), "bytes"), app(app(s, "gpr"), 4), 8) && app(app(x, "gpr"), 4) = bits_add(64, app(app(s, "gpr"), 4), 8)
def tr.rb(s, l, o) := (!tr.at_ret(s, fst(l)) &&
    bind_rel(x86_64_linux.step, fst(l), x7 x8. o = ok(pair(x7, empty), empty), x7 x8. o = exc(pair(x7, empty), pair("raise", x8)), x7. o = diverge(x7))) ||
  (!!tr.at_ret(s, fst(l)) && o = exc(pair(fst(l), empty), pair("brk", empty)))
def tr.rw(s, l, r) := while_rel(l, x5. true, x5 x6. tr.rb(s, x5, x6), x5. fn_update(empty, "os.events", app(app(fst(x5), "os"), "events")), r)
def tr.rmap(r, o) := (((fst(r) = 0 || (fst(r) = 1 && fst(out_value(r)) = "brk")) && o = ok(fst(out_state(r)), empty)) ||
  ((((fst(r) = 1 && fst(out_value(r)) = "ret") && o = ok(fst(out_state(r)), snd(out_value(r)))) ||
    ((fst(r) = 1 && fst(out_value(r)) = "raise") && o = exc(fst(out_state(r)), snd(out_value(r))))) ||
   (fst(r) = 2 && o = diverge(snd(r)))))

theorem tr.run_from_parts: all s m o. abi.run_from(s, m, o) <-> (ex r. tr.rw(s, pair(m, empty), r) && tr.rmap(r, o))
proof
  fix s m o
  show by defs(taut(), abi.run_from, tr.rw, tr.rb, tr.rmap)
qed

// The run with the stack discipline: a pass from a state l that is not at
// the return and whose rsp is not below the entry's sp leaves with
// the exception disc -- a function keeps its rsp below its sp until it
// returns (what a caller needs at a call: its own return is not reached
// inside the callee). The claim at a point is about this run.
abbrev tr.disc_ok(s, x) := tr.at_ret(s, x) || int_lt(app(app(x, "gpr"), 4), abi.sp(s))
def tr.rbd(s, l, o) := (tr.disc_ok(s, fst(l)) && tr.rb(s, l, o)) || (!tr.disc_ok(s, fst(l)) && o = exc(l, pair("raise", exc_val("disc", empty))))
def tr.rwd(s, l, r) := while_rel(l, x5. true, x5 x6. tr.rbd(s, x5, x6), x5. fn_update(empty, "os.events", app(app(fst(x5), "os"), "events")), r)
def tr.run_d(s, m, o) := ex r. tr.rwd(s, pair(m, empty), r) && tr.rmap(r, o)

// (the run from the entry: a disciplined run, or the disciplined run
// leaves with disc at the first state that breaks the discipline)
theorem tr.run_disc: all s o. runs(abi.run_to_return(), s, o) -> tr.run_d(s, s, o) || (ex x. tr.run_d(s, s, exc(x, exc_val("disc", empty))))
proof
  fix s o
  assume hr
  have rf := apply(abi.run_from_entry, hr)
  have hx0: ex x0. tr.rw(s, pair(s, empty), x0) && tr.rmap(x0, o) by taut(all_elim(tr.run_from_parts, {s}, {s}, {o}), rf)
  obtain x4, hw hm from hx0
  have ne: all l. !is_ok(exc(l, pair("raise", exc_val("disc", empty)))) proof
    fix l
    have n: is_ok(exc(l, pair("raise", exc_val("disc", empty)))) -> false proof
      assume h
      obtain a b, h2 from expand(h, is_ok)
      show by simp(h2)
    qed
    show by taut(n)
  qed
  have g := mp(mp(while_guard[l0 := pair(s, empty), b := l o. tr.rb(s, l, o), tr := l. fn_update(empty, "os.events", app(app(fst(l), "os"), "events")),
    p := l. tr.disc_ok(s, fst(l)), e := l. exc(l, pair("raise", exc_val("disc", empty))), r := x4], ne), expand(hw, tr.rw))
  have kept: while_rel(pair(s, empty), l. true, l o. (tr.disc_ok(s, fst(l)) && tr.rb(s, l, o)) || (!tr.disc_ok(s, fst(l)) && o = exc(l, pair("raise", exc_val("disc", empty)))),
      l. fn_update(empty, "os.events", app(app(fst(l), "os"), "events")), x4) -> tr.run_d(s, s, o) proof
    assume w
    have wd: tr.rwd(s, pair(s, empty), x4) by defs(w, tr.rwd, tr.rbd)
    show by defs(ex_intro({x4}, taut(wd, hm)), tr.run_d)
  qed
  have left: (ex l. while_rel(pair(s, empty), l. true, l o. (tr.disc_ok(s, fst(l)) && tr.rb(s, l, o)) || (!tr.disc_ok(s, fst(l)) && o = exc(l, pair("raise", exc_val("disc", empty)))),
      l. fn_update(empty, "os.events", app(app(fst(l), "os"), "events")), exc(l, pair("raise", exc_val("disc", empty))))) -> (ex x. tr.run_d(s, s, exc(x, exc_val("disc", empty)))) proof
    assume e
    obtain l, w from e
    have wd: tr.rwd(s, pair(s, empty), exc(l, pair("raise", exc_val("disc", empty)))) by defs(w, tr.rwd, tr.rbd)
    have rm: tr.rmap(exc(l, pair("raise", exc_val("disc", empty))), exc(fst(l), exc_val("disc", empty))) by defs(simp(), tr.rmap)
    have rd: tr.run_d(s, s, exc(fst(l), exc_val("disc", empty))) by defs(ex_intro({exc(l, pair("raise", exc_val("disc", empty)))}, taut(wd, rm)), tr.run_d)
    show by ex_intro({fst(l)}, rd)
  qed
  show by taut(g, kept, left)
qed

// (at the return, as one atom)
def tr.at_ret_d(s, x) := tr.at_ret(s, x)

// (a conditional's branches)
theorem tr.ite_t: all c a b. c -> ite(c, a, b) = a
proof
  fix c a b
  assume hc
  have ex1: ex x. (c && x = a) || (!c && x = b) by ex_intro({a}, taut(hc, refl({a})))
  have cs := mp(choose_spec[p := x. (c && x = a) || (!c && x = b)], ex1)
  have e: choose(x. (c && x = a) || (!c && x = b)) = a by taut(cs, hc)
  show by defs(e, ite)
qed

theorem tr.ite_f: all c a b. !c -> ite(c, a, b) = b
proof
  fix c a b
  assume hc
  have ex1: ex x. (c && x = a) || (!c && x = b) by ex_intro({b}, taut(hc, refl({b})))
  have cs := mp(choose_spec[p := x. (c && x = a) || (!c && x = b)], ex1)
  have e: choose(x. (c && x = a) || (!c && x = b)) = b by taut(cs, hc)
  show by defs(e, ite)
qed

// A caller's disciplined run from a callee's entry c (the callee's sp at
// most the caller's): the callee's disciplined run (it neither returns nor
// leaves its discipline), or the callee returns to x and the caller's run
// goes on from x (to the same outcome; a divergence to some divergence),
// or the callee leaves its discipline.
theorem tr.run_split: all s c o. s in x86_64_linux.Machine -> int_le(abi.sp(c), abi.sp(s)) -> tr.run_d(s, c, o) ->
  tr.run_d(c, c, o) ||
  (ex x o1. tr.run_d(c, c, ok(x, empty)) && tr.run_d(s, x, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2))) ||
  (ex x. tr.run_d(c, c, exc(x, exc_val("disc", empty))))
proof
  fix s c o
  assume hM hsp hr
  have r4 := apply(x86i.rsp_typed, hM)
  have spb: abi.sp(s) in bits(64) by simp(r4)
  obtain x4, hw hm from expand(hr, tr.run_d)
  // the guard: inside the callee (not at its return, rsp below its sp);
  // where it fails, the callee's exits
  let P(l) := !tr.at_ret(c, fst(l)) && int_lt(app(app(fst(l), "gpr"), 4), abi.sp(c))
  let E(l) := ite(tr.at_ret_d(c, fst(l)), exc(pair(fst(l), empty), pair("brk", empty)), exc(l, pair("raise", exc_val("disc", empty))))
  let TR(l) := fn_update(empty, "os.events", app(app(fst(l), "os"), "events"))
  have he: all l. !is_ok(E(l)) proof
    fix l
    have n: is_ok(E(l)) -> false proof
      assume h
      obtain a b, h2 from expand(h, is_ok)
      have c1: tr.at_ret_d(c, fst(l)) -> false proof
        assume ar
        have et := apply(tr.ite_t, {tr.at_ret_d(c, fst(l))}, {exc(pair(fst(l), empty), pair("brk", empty))}, {exc(l, pair("raise", exc_val("disc", empty)))}, ar)
        show by simp(rewrite(et, h2))
      qed
      have c2: !tr.at_ret_d(c, fst(l)) -> false proof
        assume nar
        have ef := apply(tr.ite_f, {tr.at_ret_d(c, fst(l))}, {exc(pair(fst(l), empty), pair("brk", empty))}, {exc(l, pair("raise", exc_val("disc", empty)))}, nar)
        show by simp(rewrite(ef, h2))
      qed
      show by taut(c1, c2)
    qed
    show by taut(n)
  qed
  // (the loop states: pairs with an empty second part)
  have hq: all l l2. l = pair(fst(l), empty) -> tr.rbd(s, l, ok(l2, empty)) -> l2 = pair(fst(l2), empty) proof
    fix l l2
    assume ql hb
    show by simp(expand(hb, tr.rbd, tr.rb), keep(x86_64_linux.step))
  qed
  have sp0 := all_elim(tr.pair_ne, {c}, {empty})
  have sp := mp(while_split[l0 := pair(c, empty), b := l o. tr.rbd(s, l, o), tr := l. TR(l), p := l. P(l), e := l. E(l), r := x4, q := l. l = pair(fst(l), empty)],
    he, simp(), hq, expand(hw, tr.rwd))
  // the guarded body: the callee's
  have gb: all l o. (P(l) && tr.rbd(s, l, o)) || (!P(l) && o = E(l)) -> tr.rbd(c, l, o) proof
    fix l o2
    assume h
    have in: P(l) -> tr.rbd(c, l, o2) proof
      assume hp
      have _ lt := hp
      have lt2: int_lt(app(app(fst(l), "gpr"), 4), abi.sp(s)) by arith(lt, hsp)
      have ne0: app(app(fst(l), "gpr"), 4) = abi.sp(s) -> false proof
        assume e
        have l3 := rewrite(e, lt2)
        show by arith(l3, spb)
      qed
      have ne: !(app(app(fst(l), "gpr"), 4) = abi.sp(s)) by taut(ne0)
      have nar: !tr.at_ret(s, fst(l)) by taut(ne)
      have b1: tr.rbd(s, l, o2) by taut(h, hp)
      show by defs(simp(expand(b1, tr.rbd, tr.rb), hp, lt, lt2, nar, keep(x86_64_linux.step)), tr.rbd, tr.rb)
    qed
    have out: !P(l) -> tr.rbd(c, l, o2) proof
      assume np
      have eo: o2 = E(l) by taut(h, np)
      have c1: tr.at_ret_d(c, fst(l)) -> tr.rbd(c, l, o2) proof
        assume ar
        have et := apply(tr.ite_t, {tr.at_ret_d(c, fst(l))}, {exc(pair(fst(l), empty), pair("brk", empty))}, {exc(l, pair("raise", exc_val("disc", empty)))}, ar)
        have eo2 := rewrite(et, eo)
        have ar2: tr.at_ret(c, fst(l)) by defs(ar, tr.at_ret_d)
        show by defs(simp(eo2, ar2, keep(x86_64_linux.step)), tr.rbd, tr.rb)
      qed
      have c2: !tr.at_ret_d(c, fst(l)) -> tr.rbd(c, l, o2) proof
        assume nar
        have ef := apply(tr.ite_f, {tr.at_ret_d(c, fst(l))}, {exc(pair(fst(l), empty), pair("brk", empty))}, {exc(l, pair("raise", exc_val("disc", empty)))}, nar)
        have eo2 := rewrite(ef, eo)
        have nar2: !tr.at_ret(c, fst(l)) by defs(nar, tr.at_ret_d)
        have nlt: !int_lt(app(app(fst(l), "gpr"), 4), abi.sp(c)) by taut(np, nar2)
        show by defs(simp(eo2, nar2, nlt, keep(x86_64_linux.step)), tr.rbd, tr.rb)
      qed
      show by taut(c1, c2)
    qed
    show by taut(in, out)
  qed
  // the guarded run throughout: the callee's run
  have ca: while_rel(pair(c, empty), l. true, l o. (P(l) && tr.rbd(s, l, o)) || (!P(l) && o = E(l)), l. TR(l), x4) -> tr.run_d(c, c, o) proof
    assume w
    have w2 := mp(while_mono[l0 := pair(c, empty), c := l. true, b1 := l o. (P(l) && tr.rbd(s, l, o)) || (!P(l) && o = E(l)), b2 := l o. tr.rbd(c, l, o),
      tr := l. TR(l), r := x4], gb, w)
    have wd: tr.rwd(c, pair(c, empty), x4) by defs(w2, tr.rwd)
    show by defs(ex_intro({x4}, taut(wd, hm)), tr.run_d)
  qed
  // the guarded run leaves at l: the callee's return or its leaving the
  // discipline
  have cb: (ex l. l = pair(fst(l), empty) && while_rel(pair(c, empty), l. true, l o. (P(l) && tr.rbd(s, l, o)) || (!P(l) && o = E(l)), l. TR(l), E(l)) &&
      (ex r1. while_rel(l, l. true, l o. tr.rbd(s, l, o), l. TR(l), r1) && fst(r1) = fst(x4) && (!(fst(x4) = 2) -> r1 = x4))) ->
      (ex x o1. tr.run_d(c, c, ok(x, empty)) && tr.run_d(s, x, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2))) ||
      (ex x. tr.run_d(c, c, exc(x, exc_val("disc", empty)))) proof
    assume h
    obtain l, ql wg er1 from h
    have w2 := mp(while_mono[l0 := pair(c, empty), c := l. true, b1 := l o. (P(l) && tr.rbd(s, l, o)) || (!P(l) && o = E(l)), b2 := l o. tr.rbd(c, l, o),
      tr := l. TR(l), r := E(l)], gb, wg)
    have wd: tr.rwd(c, pair(c, empty), E(l)) by defs(w2, tr.rwd)
    have c1: tr.at_ret_d(c, fst(l)) -> (ex x o1. tr.run_d(c, c, ok(x, empty)) && tr.run_d(s, x, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2))) proof
      assume ar
      have ee := apply(tr.ite_t, {tr.at_ret_d(c, fst(l))}, {exc(pair(fst(l), empty), pair("brk", empty))}, {exc(l, pair("raise", exc_val("disc", empty)))}, ar)
      have wd2 := rewrite(ee, wd)
      have rm: tr.rmap(exc(pair(fst(l), empty), pair("brk", empty)), ok(fst(l), empty)) by defs(simp(), tr.rmap)
      have rc: tr.run_d(c, c, ok(fst(l), empty)) by defs(ex_intro({exc(pair(fst(l), empty), pair("brk", empty))}, taut(wd2, rm)), tr.run_d)
      obtain r1, wr1 f4 re4 from er1
      have wr2 := rewrite(ql, wr1)
      have wd3: tr.rwd(s, pair(fst(l), empty), r1) by defs(wr2, tr.rwd)
      // (the caller's outcome from x: o, or both divergences)
      have same: !(fst(x4) = 2) -> (ex o1. tr.run_d(s, fst(l), o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2))) proof
        assume nd
        have re := mp(re4, nd)
        have rd: tr.run_d(s, fst(l), o) by defs(ex_intro({r1}, taut(wd3, rewrite(sym(re), hm))), tr.run_d)
        show by ex_intro({o}, taut(rd, refl({o})))
      qed
      have div: fst(x4) = 2 -> (ex o1. tr.run_d(s, fst(l), o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2))) proof
        assume d
        have d1: fst(r1) = 2 by simp(f4, d)
        have rm1: tr.rmap(r1, diverge(snd(r1))) by defs(simp(d1), tr.rmap)
        have rd: tr.run_d(s, fst(l), diverge(snd(r1))) by defs(ex_intro({r1}, taut(wd3, rm1)), tr.run_d)
        have od: fst(o) = 2 by simp(expand(hm, tr.rmap), d)
        have dd: fst(diverge(snd(r1))) = 2 by simp()
        show by ex_intro({diverge(snd(r1))}, taut(rd, od, dd))
      qed
      have eo1: ex o1. tr.run_d(s, fst(l), o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2)) by taut(same, div)
      obtain o1, ho1 from eo1
      show by ex_intro({fst(l)}, {o1}, taut(rc, ho1))
    qed
    have c2: !tr.at_ret_d(c, fst(l)) -> (ex x. tr.run_d(c, c, exc(x, exc_val("disc", empty)))) proof
      assume nar
      have ee := apply(tr.ite_f, {tr.at_ret_d(c, fst(l))}, {exc(pair(fst(l), empty), pair("brk", empty))}, {exc(l, pair("raise", exc_val("disc", empty)))}, nar)
      have wd2 := rewrite(ee, wd)
      have rm: tr.rmap(exc(l, pair("raise", exc_val("disc", empty))), exc(fst(l), exc_val("disc", empty))) by defs(simp(), tr.rmap)
      have rc: tr.run_d(c, c, exc(fst(l), exc_val("disc", empty))) by defs(ex_intro({exc(l, pair("raise", exc_val("disc", empty)))}, taut(wd2, rm)), tr.run_d)
      show by ex_intro({fst(l)}, rc)
    qed
    show by taut(c1, c2)
  qed
  show by taut(sp, ca, cb)
qed

// A crash (the stack overflowing): the machine faults where its stack could
// not grow (abi.overflow_at, at the fault), its I/O so far (input kept, events grown since s) that of
// an outcome of the spec from w where the I/O stops -- a stack overflow, a
// return, a divergence (abi.overflow_ok, from the spec's point w)
def tr.ovf(p, w, os) := ex x0. x0 in outcome_type(rec_and(abi.World, single(empty)), cart(bits(64), bits(64))) && (runs(p, w, x0) &&
  ite(fst(x0) = 0, app(app(fst(snd(x0)), "os"), "events") = app(os, "events"),
    ite(fst(x0) = 1, snd(snd(x0)) = exc_val("stack_overflow", empty) && app(app(fst(snd(x0)), "os"), "events") = app(os, "events"),
      app(snd(x0), "os.events") = app(os, "events"))))
def tr.crash(s, p, w, o) :=
  ex m1 a k. oe: (o = exc(m1, exc_val("segv", pair(a, k))) && (k = 0 || k = 1) && abi.overflow_at(app(m1, "vm"), app(app(m1, "gpr"), 4), abi.sp(s), a) ||
      o = exc(m1, exc_val("stack_fault", empty))) && m1M: m1 in x86_64_linux.Machine && ab: a in bits(64) &&
    sev: subset(app(app(s, "os"), "events"), app(app(m1, "os"), "events")) && inp: app(app(s, "os"), "input") = app(app(m1, "os"), "input") &&
    io: (tr.ovf(p, w, app(m1, "os")) || app(app(s, "os"), "events") = app(app(m1, "os"), "events"))

def tr.sim(s, v, p, w, m) := all o. tr.run_d(s, m, o) -> tr.ub(s, v, p, w) || tr.ok(s, v, p, w, o) || tr.crash(s, p, w, o)

// (at the entry: the claim's crash is the ABI's)
theorem tr.crash_at: all spec args s v mem o. tr.crash(s, app(spec, args), abi.view(s, v, mem), o) -> abi.crashes_at(spec, args, v, mem, s, o)
proof
  fix spec args s v mem o
  assume h
  obtain m1 a k, h3 from expand(h, tr.crash)
  have ein: app(app(abi.view(s, v, mem), "os"), "input") = app(app(s, "os"), "input") by simp()
  have hin := rewrite(sym(ein), h3.inp)
  have ho := h3.io
  // (the crash's events the entry's: the call overflowed)
  have c2: app(app(s, "os"), "events") = app(app(m1, "os"), "events") -> app(app(abi.view(s, v, mem), "os"), "events") = app(app(m1, "os"), "events") proof
    assume e
    have eev: app(app(abi.view(s, v, mem), "os"), "events") = app(app(s, "os"), "events") by simp()
    show := trans(eev, e)
  qed
  have ov: abi.overflow_ok(rec_and(abi.World, single(empty)), abi.view(s, v, mem), spec, args, app(m1, "os")) by defs(taut(hin, expand(ho, tr.ovf), c2), abi.overflow_ok)
  show by defs(ex_intro({m1}, {a}, {k}, taut(h3, ov)), abi.crashes_at)
qed

// (at the entry: the claim's raise is the ABI's)
theorem tr.ub_at: all spec args s v mem. tr.ub(s, v, app(spec, args), abi.view(s, v, mem)) -> abi.raises_at(spec, args, v, mem, s)
proof
  fix spec args s v mem
  assume h
  show by defs(expand(h, tr.ub), abi.raises_at)
qed

// (a crash is no divergence, no return)
theorem tr.crash_not_div: all s p w t. !tr.crash(s, p, w, diverge(t))
proof
  fix s p w t
  have n: tr.crash(s, p, w, diverge(t)) -> false proof
    assume k
    obtain m1 a c, {oe} from expand(k, tr.crash)
    show by simp(oe)
  qed
  show by taut(n)
qed

// (rsp as at the entry, below 2^47: below the entry's sp)
theorem tr.sp_lt: all x. x in bits(64) -> int_lt(x, 140737488355328) -> int_lt(x, bits_add(64, x, 8))
proof
  fix x
  assume hx hl
  have p64: pow2(64) = 18446744073709551616 by simp()
  have e0: int_mod(int_add(x, 8), 18446744073709551616) = int_add(x, 8) by arith(hx, hl)
  have e: bits_add(64, x, 8) = int_add(x, 8) by defs(rewrite(sym(p64), e0), bits_add)
  have l0: int_lt(x, int_add(x, 8)) by arith(hx)
  show := rewrite(sym(e), l0)
qed

// at the entry: abi.matches_at -- a run breaking the discipline is one only
// where the spec raises (its disciplined run then leaves with disc, which
// is no normal return, no crash)
// (a return: the ABI's return case, which does not ask m1 in univ(1))
theorem tr.ok_abi: all s v p w o. tr.ok(s, v, p, w, o) ->
  (ex m1 w2. o = ok(m1, empty) && m1 in x86_64_linux.Machine &&
    runs(p, w, ok(w2, pair(app(app(m1, "gpr"), 0), app(app(m1, "gpr"), 2)))) && w2 in abi.World && w2 in univ(1) &&
    abi.world_matches(app(s, "vm"), app(m1, "vm"), app(w2, "vm"), v, abi.sp(s)) && app(m1, "os") = app(w2, "os") && app(m1, "fs_base") = app(w2, "fs_base") &&
    app(m1, "cpu") = app(s, "cpu") && app(m1, "gs_base") = app(s, "gs_base") && app(m1, "rip") = abi.ret(s) && app(app(m1, "gpr"), 4) = abi.sp(s) &&
    abi.callee_saved(m1, s) && !app(app(m1, "flags"), "df"))
proof
  fix s v p w o
  assume h
  obtain m1 w2, h2 from expand(h, tr.ok)
  show by ex_intro({m1}, {w2}, taut(h2))
qed

// abi.matches without its divergence case: the machine diverges only
// where the spec raises (the claim has no divergence; every loop has a
// variant), so a caller's run through a call ends or raises
def tr.matches_t(spec, args, objs, mem, s, o) :=
  abi.raises_at(spec, args, objs, mem, s) ||
  (ex m1 w2. o = ok(m1, empty) && m1 in x86_64_linux.Machine && m1 in univ(1) &&
    runs(app(spec, args), abi.view(s, objs, mem), ok(w2, pair(app(app(m1, "gpr"), 0), app(app(m1, "gpr"), 2)))) && w2 in abi.World && w2 in univ(1) &&
    abi.world_matches(app(s, "vm"), app(m1, "vm"), app(w2, "vm"), objs, abi.sp(s)) && app(m1, "os") = app(w2, "os") && app(m1, "fs_base") = app(w2, "fs_base") &&
    app(m1, "cpu") = app(s, "cpu") && app(m1, "gs_base") = app(s, "gs_base") && app(m1, "rip") = abi.ret(s) && app(app(m1, "gpr"), 4) = abi.sp(s) &&
    abi.callee_saved(m1, s) && !app(app(m1, "flags"), "df")) ||
  abi.crashes_at(spec, args, objs, mem, s, o)

theorem tr.matches_t_abi: all spec args objs mem s o. tr.matches_t(spec, args, objs, mem, s, o) -> abi.matches(spec, args, objs, mem, s, o)
proof
  fix spec args objs mem s o
  assume mt
  have mt2: abi.raises_at(spec, args, objs, mem, s) || tr.ok(s, objs, app(spec, args), abi.view(s, objs, mem), o) || abi.crashes_at(spec, args, objs, mem, s, o)
    by defs(taut(expand(mt, tr.matches_t)), tr.ok)
  have oa := all_elim(tr.ok_abi, {s}, {objs}, {app(spec, args)}, {abi.view(s, objs, mem)}, {o})
  show by defs(taut(mt2, oa), abi.matches)
qed

// ... for the disciplined run itself
theorem tr.entry_d: all spec args s v mem o. tr.sim(s, v, app(spec, args), abi.view(s, v, mem), s) -> tr.run_d(s, s, o) ->
  tr.matches_t(spec, args, v, mem, s, o)
proof
  fix spec args s v mem o
  assume h rd
  have c := mp(all_elim(expand(h, tr.sim), {o}), rd)
  have cr := all_elim(tr.crash_at, {spec}, {args}, {s}, {v}, {mem}, {o})
  have ua := all_elim(tr.ub_at, {spec}, {args}, {s}, {v}, {mem})
  show by defs(taut(expand(c, tr.ok), cr, ua), tr.matches_t)
qed

// the stack objects of the callers a function entered at s may reach: at or
// above its sp, writable (as abi.abi_function requires)
def tr.objs_ok(s, v) := all x. x in omega -> x in v -> (int_le(abi.sp(s), x) && abi.stack_page(app(s, "vm"), int_div(x, x86_64_linux.PAGE))) && x86_64_linux.can_access(app(s, "vm"), bits_of_int(64, x), 1)

// The bridge's contract of a function at f: every disciplined run from an
// entry (with the stack objects objs of its callers, for every view mem
// of the memory) matches the spec --
// abi.implements2_at, and a caller's run through a call to f splits at
// f's return (f keeps its rsp below its sp until then, where its spec does
// not raise).
def tr.implements_at(f, spec, base, code, statics) :=
  all args objs mem s o. args in abi.ARGS -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(app(s, "vm"), base, code, statics) ->
    app(s, "rip") = f -> abi.entry_ok(s, args) -> tr.objs_ok(s, objs) -> abi.view_ok(s, objs, mem) -> tr.run_d(s, s, o) -> tr.matches_t(spec, args, objs, mem, s, o)

// (an outcome the spec matches only by raising: so is every outcome)
theorem tr.matches_raise: all spec args objs mem s x o. abi.matches(spec, args, objs, mem, s, exc(x, exc_val("disc", empty))) -> abi.matches(spec, args, objs, mem, s, o)
proof
  fix spec args objs mem s x o
  assume ma
  have n2: (ex m1 w2. exc(x, exc_val("disc", empty)) = ok(m1, empty) && m1 in x86_64_linux.Machine &&
      runs(app(spec, args), abi.view(s, objs, mem), ok(w2, pair(app(app(m1, "gpr"), 0), app(app(m1, "gpr"), 2)))) && w2 in abi.World && w2 in univ(1) &&
      abi.world_matches(app(s, "vm"), app(m1, "vm"), app(w2, "vm"), objs, abi.sp(s)) && app(m1, "os") = app(w2, "os") && app(m1, "fs_base") = app(w2, "fs_base") &&
      app(m1, "cpu") = app(s, "cpu") && app(m1, "gs_base") = app(s, "gs_base") && app(m1, "rip") = abi.ret(s) && app(app(m1, "gpr"), 4) = abi.sp(s) &&
      abi.callee_saved(m1, s) && !app(app(m1, "flags"), "df")) -> false proof
    assume e
    obtain m1 w2, e2 from e
    show by simp(e2.1)
  qed
  have n3: (ex t. exc(x, exc_val("disc", empty)) = diverge(t) && runs(app(spec, args), abi.view(s, objs, mem), diverge(t))) -> false proof
    assume e
    obtain t, q _ from e
    show by simp(q)
  qed
  have n4: abi.crashes_at(spec, args, objs, mem, s, exc(x, exc_val("disc", empty))) -> false proof
    assume e
    obtain m1 a c0, {oe} from expand(e, abi.crashes_at)
    show by simp(expand(oe, exc_val))
  qed
  have r: abi.raises_at(spec, args, objs, mem, s) by taut(expand(ma, abi.matches), n2, n3, n4)
  show by defs(taut(r), abi.matches)
qed

// the bridge's contract gives the ABI's
theorem tr.implements_abi: all f spec base code statics. tr.implements_at(f, spec, base, code, statics) -> abi.implements2_at(single(empty), f, spec, base, code, statics)
proof
  fix f spec base code statics
  assume hi
  have m: all args objs mem s o. args in abi.ARGS -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> abi.loaded(app(s, "vm"), base, code, statics) -> app(s, "rip") = f ->
      abi.entry_ok(s, args) -> (all x. x in omega -> x in objs -> (int_le(abi.sp(s), x) && abi.stack_page(app(s, "vm"), int_div(x, x86_64_linux.PAGE))) && x86_64_linux.can_access(app(s, "vm"), bits_of_int(64, x), 1)) -> abi.view_ok(s, objs, mem) ->
      runs(abi.run_to_return(), s, o) -> abi.matches(spec, args, objs, mem, s, o) proof
    fix args objs mem s o
    assume hA hot hmv hM hl hrip he hob hwm hr
    have su: s in univ(1) by simp(apply(abi.run_univ, hr))
    have ok: tr.objs_ok(s, objs) by defs(hob, tr.objs_ok)
    have c := expand(hi, tr.implements_at)
    have d := apply(tr.run_disc, {s}, {o}, hr)
    have c1: tr.run_d(s, s, o) -> abi.matches(spec, args, objs, mem, s, o) proof
      assume rd
      have mt := mp(all_elim(c, {args}, {objs}, {mem}, {s}, {o}), hA, hot, hmv, hM, su, hl, hrip, he, ok, hwm, rd)
      show := apply(tr.matches_t_abi, mt)
    qed
    have c2: (ex x. tr.run_d(s, s, exc(x, exc_val("disc", empty)))) -> abi.matches(spec, args, objs, mem, s, o) proof
      assume e
      obtain x, rd from e
      have mt := mp(all_elim(c, {args}, {objs}, {mem}, {s}, {exc(x, exc_val("disc", empty))}), hA, hot, hmv, hM, su, hl, hrip, he, ok, hwm, rd)
      have mx := apply(tr.matches_t_abi, mt)
      show := apply(tr.matches_raise, {spec}, {args}, {objs}, {mem}, {s}, {x}, {o}, mx)
    qed
    show by taut(d, c1, c2)
  qed
  show := apply(abi.bridge_implements, m)
qed

// ----------------------------------------------------------------------
//  The spec's side: P from w reduced to P2 from w2 (every outcome of P2
//  from w2 one of P from w) -- a statement run, a definition unfolded

def tr.red(p, w, p2, w2) := all o. runs(p2, w2, o) -> runs(p, w, o)

theorem tr.sim_red: all s v p w p2 w2 m. tr.red(p, w, p2, w2) -> tr.sim(s, v, p2, w2, m) -> tr.sim(s, v, p, w, m)
proof
  fix s v p w p2 w2 m
  assume hr h
  have r := expand(hr, tr.red)
  have u: tr.ub(s, v, p2, w2) -> tr.ub(s, v, p, w) proof
    assume hu
    obtain e x, he from expand(hu, tr.ub)
    have r1 := mp(all_elim(r, {exc(x, e)}), he.4)
    show by defs(ex_intro({e}, {x}, taut(he, r1)), tr.ub)
  qed
  have k: all o. tr.ok(s, v, p2, w2, o) -> tr.ok(s, v, p, w, o) proof
    fix o
    assume hk
    obtain m1 w3, k2 from expand(hk, tr.ok)
    have r1 := mp(all_elim(r, {ok(w3, pair(app(app(m1, "gpr"), 0), app(app(m1, "gpr"), 2)))}), k2.4)
    show by defs(ex_intro({m1}, {w3}, taut(k2, r1)), tr.ok)
  qed
  have cr: all o. tr.crash(s, p2, w2, o) -> tr.crash(s, p, w, o) proof
    fix o
    assume hc
    obtain m1 a k0, c3 from expand(hc, tr.crash)
    have o2: tr.ovf(p2, w2, app(m1, "os")) -> tr.ovf(p, w, app(m1, "os")) proof
      assume hv
      obtain x0, c4 from expand(hv, tr.ovf)
      have r1 := mp(all_elim(r, {x0}), c4.2.1)
      show by defs(ex_intro({x0}, taut(c4, r1)), tr.ovf)
    qed
    show by defs(ex_intro({m1}, {a}, {k0}, taut(c3, o2)), tr.crash)
  qed
  have g: all o. tr.run_d(s, m, o) -> tr.ub(s, v, p, w) || tr.ok(s, v, p, w, o) || tr.crash(s, p, w, o) proof
    fix o
    assume ho
    have c := mp(all_elim(expand(h, tr.sim), {o}), ho)
    show by taut(c, u, all_elim(k, {o}), all_elim(cr, {o}))
  qed
  show by defs(g, tr.sim)
qed

// ----------------------------------------------------------------------
//  The machine's side: a step from m that can only end at m2 (not at the
//  return: the run goes on)

theorem tr.ok_not_div: all s v p w t. !tr.ok(s, v, p, w, diverge(t))
proof
  fix s v p w t
  have n: tr.ok(s, v, p, w, diverge(t)) -> false proof
    assume k
    obtain m1 w2, k2 from expand(k, tr.ok)
    show by simp(k2.1)
  qed
  show by taut(n)
qed

// (the steps from m end in states with q: an instruction's effect, its
// flags left open where the model havocs them; rsp below the entry's sp,
// so the run goes on with a step)
theorem tr.step(s, v, p, w, m, x. q): (all o. runs(x86_64_linux.step(), m, o) -> (ex m2. o = ok(m2, empty) && q(m2))) ->
  int_lt(app(app(m, "gpr"), 4), abi.sp(s)) -> (all m2. q(m2) -> tr.sim(s, v, p, w, m2)) -> tr.sim(s, v, p, w, m)
proof
  assume hs hlt h
  have hn0: app(app(m, "gpr"), 4) = abi.sp(s) -> false proof
    assume e
    have l2 := rewrite(e, hlt)
    show by arith(l2)
  qed
  have hn: !(app(m, "rip") = abi.ret(s) && app(app(m, "gpr"), 4) = abi.sp(s)) by taut(hn0)
  // (the discipline holds at m: the guarded pass is the plain one)
  have dok: tr.disc_ok(s, fst(pair(m, empty))) by simp(hlt)
  have hbd: all r. tr.rbd(s, pair(m, empty), r) -> tr.rb(s, pair(m, empty), r) proof
    fix r
    assume hb
    show by taut(expand(hb, tr.rbd), dok)
  qed
  // the pass from m: a step to some m2 with q
  have hb_ok: all l1. tr.rb(s, pair(m, empty), ok(l1, empty)) -> (ex m2. l1 = pair(m2, empty) && q(m2)) proof
    fix l1
    assume hb
    have b1: ex x1. runs(x86_64_linux.step(), m, x1) && (ex x2 x3. x1 = ok(x2, x3) && l1 = pair(x2, empty)) by simp(expand(hb, tr.rb), hn, keep(x86_64_linux.step))
    obtain x1, c1 from b1
    have e := mp(all_elim(hs, {x1}), c1.1)
    obtain m2, e2 from e
    have l1e: l1 = pair(m2, empty) by simp(c1, e2, keep(x86_64_linux.step))
    show by ex_intro({m2}, taut(l1e, e2))
  qed
  have hb_nok: all r. tr.rb(s, pair(m, empty), r) -> !is_ok(r) -> false proof
    fix r
    assume hb hn2
    have b1: ex x1. runs(x86_64_linux.step(), m, x1) && ((ex x2 x3. x1 = ok(x2, x3) && r = ok(pair(x2, empty), empty)) ||
      (ex x2 x3. x1 = exc(x2, x3) && r = exc(pair(x2, empty), pair("raise", x3))) || (ex x2. x1 = diverge(x2) && r = diverge(x2))) by simp(expand(hb, tr.rb), hn, keep(x86_64_linux.step))
    obtain x1, c1 from b1
    have e := mp(all_elim(hs, {x1}), c1.1)
    obtain m2, e2 from e
    show by simp(c1, e2, hn2, keep(x86_64_linux.step))
  qed
  have hbd_nok: all r. tr.rbd(s, pair(m, empty), r) -> !is_ok(r) -> false proof
    fix r
    assume hb hn2
    show := mp(mp(all_elim(hb_nok, {r}), mp(all_elim(hbd, {r}), hb)), hn2)
  qed
  // the claim at an m2 with q, for the loop's runs from it
  have hk: all m2 r o2. q(m2) -> tr.rwd(s, pair(m2, empty), r) -> tr.rmap(r, o2) -> tr.ub(s, v, p, w) || tr.ok(s, v, p, w, o2) || tr.crash(s, p, w, o2) proof
    fix m2 r o2
    assume hq hw hm
    have rf: tr.run_d(s, m2, o2) by defs(ex_intro({r}, taut(hw, hm)), tr.run_d)
    show := mp(all_elim(expand(mp(all_elim(h, {m2}), hq), tr.sim), {o2}), rf)
  qed
  have g: all o. tr.run_d(s, m, o) -> tr.ub(s, v, p, w) || tr.ok(s, v, p, w, o) || tr.crash(s, p, w, o) proof
    fix o
    assume ho
    obtain x4, hw hm from expand(ho, tr.run_d)
    let W(l, r) := while_rel(l, x5. true, x5 x6. tr.rbd(s, x5, x6), x5. fn_update(empty, "os.events", app(app(fst(x5), "os"), "events")), r)
    have u := mp(while_unroll[l0 := pair(m, empty), c := l. true, b := l o. tr.rbd(s, l, o),
      tr := l. fn_update(empty, "os.events", app(app(fst(l), "os"), "events")), r := x4], expand(hw, tr.rwd))
    // (the loop goes on from m2)
    have on: (ex l1. tr.rbd(s, pair(m, empty), ok(l1, empty)) && (ex r1. W(l1, r1) && fst(r1) = fst(x4) && (!(fst(x4) = 2) -> r1 = x4))) ->
        tr.ub(s, v, p, w) || tr.ok(s, v, p, w, o) || tr.crash(s, p, w, o) proof
      assume e
      obtain l1, rbd1 e1b from e
      have rb1 := mp(all_elim(hbd, {ok(l1, empty)}), rbd1)
      obtain m2, l1e hq from mp(all_elim(hb_ok, {l1}), rb1)
      obtain r1, w0 f4 re4 from e1b
      have w1: tr.rwd(s, pair(m2, empty), r1) by defs(rewrite(l1e, w0), tr.rwd)
      have same: !(fst(x4) = 2) -> tr.ub(s, v, p, w) || tr.ok(s, v, p, w, o) || tr.crash(s, p, w, o) proof
        assume nd
        have re := mp(re4, nd)
        show := mp(mp(mp(all_elim(hk, {m2}, {r1}, {o}), hq), w1), rewrite(sym(re), hm))
      qed
      have div: fst(x4) = 2 -> tr.ub(s, v, p, w) || tr.ok(s, v, p, w, o) || tr.crash(s, p, w, o) proof
        assume d
        have d1: fst(r1) = 2 by simp(f4, d)
        have c := mp(mp(mp(all_elim(hk, {m2}, {r1}, {diverge(snd(r1))}), hq), w1), defs(simp(d1), tr.rmap))
        have nk := all_elim(tr.ok_not_div, {s}, {v}, {p}, {w}, {snd(r1)})
        have nc := all_elim(tr.crash_not_div, {s}, {p}, {w}, {snd(r1)})
        show by taut(c, nk, nc)
      qed
      show by taut(same, div)
    qed
    show by taut(u, on, all_elim(hbd_nok, {x4}))
  qed
  show by defs(g, tr.sim)
qed

// at the return (rip the caller's return address, rsp past it): the run
// ends there, ok(m) -- the spec returning the machine's rax:rdx, the world
// and the ABI's registers as at the return case of abi.matches_at
theorem tr.ret: all s v p w m w2. tr.at_ret(s, m) -> m in x86_64_linux.Machine -> m in univ(1) ->
  runs(p, w, ok(w2, pair(app(app(m, "gpr"), 0), app(app(m, "gpr"), 2)))) -> w2 in abi.World -> w2 in univ(1) ->
  abi.world_matches(app(s, "vm"), app(m, "vm"), app(w2, "vm"), v, abi.sp(s)) -> app(m, "os") = app(w2, "os") -> app(m, "fs_base") = app(w2, "fs_base") ->
  app(m, "cpu") = app(s, "cpu") -> app(m, "gs_base") = app(s, "gs_base") -> abi.callee_saved(m, s) -> !app(app(m, "flags"), "df") ->
  tr.sim(s, v, p, w, m)
proof
  fix s v p w m w2
  assume ha hM hmu hr h1 h2 h3 h4 h5 h6 h7 h8 h9
  // the run from m: ok(m)
  have g: all o. tr.run_d(s, m, o) -> o = ok(m, empty) proof
    fix o
    assume ho
    obtain x4, hw hm from expand(ho, tr.run_d)
    have u := mp(while_unroll[l0 := pair(m, empty), c := l. true, b := l o. tr.rbd(s, l, o),
      tr := l. fn_update(empty, "os.events", app(app(fst(l), "os"), "events")), r := x4], expand(hw, tr.rwd))
    // (at the return the discipline holds: the guarded pass is the plain one)
    have dok: tr.disc_ok(s, fst(pair(m, empty))) by simp(ha)
    have b_at: all r. tr.rbd(s, pair(m, empty), r) -> r = exc(pair(m, empty), pair("brk", empty)) proof
      fix r
      assume hbd
      have hb: tr.rb(s, pair(m, empty), r) by taut(expand(hbd, tr.rbd), dok)
      show by simp(expand(hb, tr.rb), ha, keep(x86_64_linux.step))
    qed
    have x4e: x4 = exc(pair(m, empty), pair("brk", empty)) proof
      have c3: !(ex l1. tr.rbd(s, pair(m, empty), ok(l1, empty)) && (ex r1. while_rel(l1, x5. true, x5 x6. tr.rbd(s, x5, x6), x5. fn_update(empty, "os.events", app(app(fst(x5), "os"), "events")), r1) &&
          fst(r1) = fst(x4) && (!(fst(x4) = 2) -> r1 = x4))) proof
        have n: all l1. tr.rbd(s, pair(m, empty), ok(l1, empty)) -> false proof
          fix l1
          assume hb
          have e := mp(all_elim(b_at, {ok(l1, empty)}), hb)
          show by simp(e)
        qed
        have n2: (ex l1. tr.rbd(s, pair(m, empty), ok(l1, empty)) && (ex r1. while_rel(l1, x5. true, x5 x6. tr.rbd(s, x5, x6), x5. fn_update(empty, "os.events", app(app(fst(x5), "os"), "events")), r1) &&
            fst(r1) = fst(x4) && (!(fst(x4) = 2) -> r1 = x4))) -> false proof
          assume e
          obtain l1, rb1 _ from e
          show := mp(all_elim(n, {l1}), rb1)
        qed
        show by taut(n2)
      qed
      show by taut(u, c3, all_elim(b_at, {x4}))
    qed
    have hm2 := rewrite(x4e, hm)
    show by simp(expand(hm2, tr.rmap))
  qed
  have k: all o. o = ok(m, empty) -> tr.ok(s, v, p, w, o) proof
    fix o
    assume e
    show by defs(ex_intro({m}, {w2}, simp(e, hM, hmu, hr, h1, h2, h3, h4, h5, h6, h7, h8, h9, ha, keep(abi.world_matches, abi.World, x86_64_linux.Machine))), tr.ok)
  qed
  have all_o: all o. tr.run_d(s, m, o) -> tr.ub(s, v, p, w) || tr.ok(s, v, p, w, o) || tr.crash(s, p, w, o) proof
    fix o
    assume ho
    have e := mp(all_elim(g, {o}), ho)
    have kk := mp(all_elim(k, {o}), e)
    show by taut(kk)
  qed
  show by defs(all_o, tr.sim)
qed

// ----------------------------------------------------------------------
//  The coupling at a point of a function (rsp fr below the entry s's; the
//  homes keyed by their offset from s's rsp, in the 8 bytes below it --
//  an instruction's [rsp + d] is the home d - fr, tr.frame_ea)
//
//  - the ABI's part (tr.inv): the machine typed, its code loaded at base,
//    rsp s's less the frame's size fr (0 but between a prologue's
//    `sub rsp` and the epilogue's `add rsp`; the return at fr 0), the
//    return address as at s, the callee-saved registers, cpu,
//    gs_base as at s, os and fs_base the world's, df clear; only the
//    machine's bytes changed since s; the world's cpu and sp s's (a call's
//    callee world takes them); s's entry facts;
//  - the homes (hs: offset c from s's rsp -> pair(n, x)): the n bytes there
//    hold x;
//  - the registers (rs: register -> pair(n, x)): the register holds x, an
//    n-byte value;
//  - the memory (tr.mem, ds): the machine's the spec world's (the spec's
//    view chose the prologue's stores: vm(m) = vm(w)), or, once the machine
//    has written its frame (ds true), the same but for scratch bytes (the
//    spec's locals are not in its memory) -- the homes, below the entry's
//    rsp (at a call: in the caller's private frame, GIMPLE's call_at).

// (the pages of the 8 bytes below the entry's rsp r -- the homes -- and of
// the 8 from it -- the return address -- as at the entry; the rest of the
// memory is the world's, tr.mem: a callee may change the page map, but not
// the pages of its caller's frame, GIMPLE's call_at)
def tr.kept(sv, vm, r) := all a. a in omega -> int_le(int_sub(r, 8), a) -> int_lt(a, int_add(r, 8)) ->
  app(app(vm, "pages"), x86_64_linux.page_of(a)) = app(app(sv, "pages"), x86_64_linux.page_of(a))

// (the code loaded at the entry, loaded still: the function's own, a
// callee's)
def tr.keeps_code(sv, vm) := all gb gc st. gb in omega -> abi.loaded(sv, gb, gc, st) -> abi.loaded(vm, gb, gc, st)

def tr.inv(s, base, code, fr, m, w) :=
  mM: m in x86_64_linux.Machine && mu: m in univ(1) && cd: abi.code_at(app(m, "vm"), base, code) && kc: tr.keeps_code(app(s, "vm"), app(m, "vm")) &&
  rspm: app(app(m, "gpr"), 4) = int_sub(app(app(s, "gpr"), 4), fr) && fro: fr in omega && kp: tr.kept(app(s, "vm"), app(m, "vm"), app(app(s, "gpr"), 4)) &&
  ra8: x86_64_linux.le(app(app(m, "vm"), "bytes"), app(app(s, "gpr"), 4), 8) = abi.ret(s) &&
  mcs: abi.callee_saved(m, s) && mcpu: app(m, "cpu") = app(s, "cpu") && mgs: app(m, "gs_base") = app(s, "gs_base") &&
  mos: app(m, "os") = app(w, "os") && mfs: app(m, "fs_base") = app(w, "fs_base") && mdf: !app(app(m, "flags"), "df") &&
  winp: app(app(w, "os"), "input") = app(app(s, "os"), "input") && sws: subset(app(app(s, "os"), "events"), app(app(w, "os"), "events")) &&
  wW: w in abi.World && wu: w in univ(1) && wcpu: app(w, "cpu") = app(s, "cpu") && wst: (all p. abi.stack_page(app(s, "vm"), p) -> app(app(app(w, "vm"), "pages"), p) = app(app(app(s, "vm"), "pages"), p)) &&
  sM: s in x86_64_linux.Machine &&
  sacc: x86_64_linux.can_access(app(s, "vm"), app(app(s, "gpr"), 4), 1) && sal: int_mod(bits_add(64, app(app(s, "gpr"), 4), 8), 16) = 0 &&
  hsps: abi.stack_page(app(s, "vm"), int_div(app(app(s, "gpr"), 4), 4096)) && slt: int_lt(app(app(s, "gpr"), 4), 140737488355328) &&
  sgf: abi.stack_gap_free(app(s, "vm"))

def tr.homes(s, m, hs) := all c. c in dom(hs) ->
  x86_64_linux.le(app(app(m, "vm"), "bytes"), bits_add(64, int_add(app(app(s, "gpr"), 4), c), 0), fst(app(hs, c))) = snd(app(hs, c))

def tr.regs(m, rs) := is_fun(rs) && (all r. r in dom(rs) -> app(app(m, "gpr"), r) = snd(app(rs, r)) && snd(app(rs, r)) in bits(int_mul(8, fst(app(rs, r)))))

// The memory's coupling at a point of the function entered at s, where
// the world's stack objects are ob: the machine's memory is the world's as
// the ABI matches them at a return (abi.world_matches) -- on the world's
// domain the world's bytes, the callers' frames (the entry's stack pages
// at and above its sp, outside the domain) as at the entry, the page map
// the world's or grown stack pages, the other fields the world's
// (and the stack objects -- the callers' -- at or above sp, on the entry's
// stack pages, accessible: a pointer access to one is the machine's)
def tr.mem(s, m, w, ob) := wob: app(w, "objs") = ob && wm: abi.world_matches(app(s, "vm"), app(m, "vm"), app(w, "vm"), ob, abi.sp(s)) &&
  oacc: (all x. x in omega -> x in ob -> (int_le(abi.sp(s), x) && abi.stack_page(app(s, "vm"), int_div(x, x86_64_linux.PAGE))) && x86_64_linux.can_access(app(m, "vm"), bits_of_int(64, x), 1))

// the claim at the address a: from every machine state there, coupled
def tr.pt(s, v, base, code, fr, a, hs, ds, rs, p, w) :=
  all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, ds) -> tr.sim(s, v, p, w, m)

// (the entry's memory: kept)
theorem tr.kept_refl: all sv r. tr.kept(sv, sv, r)
proof
  fix sv r
  have g: all a. a in omega -> int_le(int_sub(r, 8), a) -> int_lt(a, int_add(r, 8)) ->
      app(app(sv, "pages"), x86_64_linux.page_of(a)) = app(app(sv, "pages"), x86_64_linux.page_of(a)) proof
    fix a
    assume h1 h2 h3
    show := refl({app(app(sv, "pages"), x86_64_linux.page_of(a))})
  qed
  show by defs(g, tr.kept)
qed

// (an accessible byte there: accessible still)
theorem tr.kept_acc: all sv vm r a k. tr.kept(sv, vm, r) -> a in omega -> int_le(int_sub(r, 8), a) -> int_lt(a, int_add(r, 8)) ->
  x86_64_linux.can_access(sv, a, k) -> x86_64_linux.can_access(vm, a, k)
proof
  fix sv vm r a k
  assume hg h1 h2 h3 hc
  have e := mp(mp(mp(all_elim(expand(hg, tr.kept), {a}), h1), h2), h3)
  have c := expand(expand(hc, x86_64_linux.can_access), x86_64_linux.mapped)
  have c2 := rewrite(sym(e), c)
  show by defs(defs(c2, x86_64_linux.mapped), x86_64_linux.can_access)
qed

// (bytes written: kept still)
theorem tr.kept_bytes: all sv vm r x. tr.kept(sv, vm, r) -> tr.kept(sv, fn_update(vm, "bytes", x), r)
proof
  fix sv vm r x
  assume hg
  have e: app(fn_update(vm, "bytes", x), "pages") = app(vm, "pages") by simp()
  show by defs(rewrite(sym(e), expand(hg, tr.kept)), tr.kept)
qed

// (a home's byte: rsp + c + i, c in [-8, 0), i below -c: below rsp, in
// the 8 bytes)
theorem tr.home_range: all r c i. r in bits(64) -> int_le(8, r) -> int_lt(r, 140737488355328) -> c in bits(64) -> int_le(18446744073709551608, c) ->
  i in omega -> int_lt(i, int_sub(18446744073709551616, c)) ->
  bits_add(64, int_add(r, c), bits_of_int(64, i)) in omega && int_le(int_sub(r, 8), bits_add(64, int_add(r, c), bits_of_int(64, i))) &&
    int_lt(bits_add(64, int_add(r, c), bits_of_int(64, i)), int_add(r, 8))
proof
  fix r c i
  assume hr h8 hl hc hc1 hi hi2
  have p64: pow2(64) = 18446744073709551616 by simp()
  have ib: int_mod(i, 18446744073709551616) = i by arith(hi, hi2, hc)
  have e0: int_mod(int_add(int_add(r, c), int_mod(i, 18446744073709551616)), 18446744073709551616) = int_sub(int_add(int_add(r, c), i), 18446744073709551616)
    by arith(hr, h8, hc, hc1, hi, hi2, ib)
  have e1 := subst({y. int_mod(int_add(int_add(r, c), int_mod(i, y)), y) = int_sub(int_add(int_add(r, c), i), 18446744073709551616)}, sym(p64), e0)
  have e: bits_add(64, int_add(r, c), bits_of_int(64, i)) = int_sub(int_add(int_add(r, c), i), 18446744073709551616) by defs(e1, bits_add, bits_of_int)
  have g: int_sub(int_add(int_add(r, c), i), 18446744073709551616) in omega && int_le(int_sub(r, 8), int_sub(int_add(int_add(r, c), i), 18446744073709551616)) &&
    int_lt(int_sub(int_add(int_add(r, c), i), 18446744073709551616), int_add(r, 8)) by arith(hr, h8, hc, hc1, hi, hi2)
  show := rewrite(sym(e), g)
qed

// (the return address's byte: rsp + j, j < 8)
theorem tr.ret_range: all r j. r in bits(64) -> int_lt(r, 140737488355328) -> j in omega -> int_lt(j, 8) ->
  bits_add(64, r, bits_of_int(64, j)) in omega && int_le(int_sub(r, 8), bits_add(64, r, bits_of_int(64, j))) &&
    int_lt(bits_add(64, r, bits_of_int(64, j)), int_add(r, 8))
proof
  fix r j
  assume hr hl hj hj2
  have p64: pow2(64) = 18446744073709551616 by simp()
  have jb: int_mod(j, 18446744073709551616) = j by arith(hj, hj2)
  have e0: int_mod(int_add(r, int_mod(j, 18446744073709551616)), 18446744073709551616) = int_add(r, j) by arith(hr, hl, hj, hj2, jb)
  have e: bits_add(64, r, bits_of_int(64, j)) = int_add(r, j) by defs(rewrite(sym(p64), e0), bits_add, bits_of_int)
  have g: int_add(r, j) in omega && int_le(int_sub(r, 8), int_add(r, j)) && int_lt(int_add(r, j), int_add(r, 8)) by arith(hr, hj, hj2)
  show := rewrite(sym(e), g)
qed

// (no frame: rsp the entry's)
theorem tr.inv0_rsp: all s base code m w. tr.inv(s, base, code, 0, m, w) -> app(app(m, "gpr"), 4) = app(app(s, "gpr"), 4)
proof
  fix s base code m w
  assume hi
  have {sM, rspm} := hi
  have r4 := apply(x86i.rsp_typed, sM)
  have z: int_sub(app(app(s, "gpr"), 4), 0) = app(app(s, "gpr"), 4) by arith(r4)
  show := rewrite(z, rspm)
qed

// (rsp in the frame, at or below the entry's: below the entry's sp, so
// not at the return)
theorem tr.inv_nr: all s base code fr m w. tr.inv(s, base, code, fr, m, w) -> int_lt(app(app(m, "gpr"), 4), abi.sp(s))
proof
  fix s base code fr m w
  assume hi
  have {rspm, fro, sM, slt} := hi
  have r4 := apply(x86i.rsp_typed, sM)
  have l0 := apply(tr.sp_lt, {app(app(s, "gpr"), 4)}, r4, slt)
  have l1: int_lt(int_sub(app(app(s, "gpr"), 4), fr), abi.sp(s)) by arith(l0, fro)
  show := subst({y. int_lt(y, abi.sp(s))}, sym(rspm), l1)
qed

// (an access at rsp + d in a frame of fr bytes: at the entry's rsp + c,
// for c the offset d - fr)
theorem tr.frame_ea: all s base code fr m w d c x0. tr.inv(s, base, code, fr, m, w) -> d in bits(64) -> c = int_mod(int_sub(d, fr), 18446744073709551616) -> x0 in omega ->
  bits_add(64, int_add(app(app(m, "gpr"), 4), d), x0) = bits_add(64, int_add(app(app(s, "gpr"), 4), c), x0)
proof
  fix s base code fr m w d c x0
  assume hi hd hc hx
  have {rspm, fro, sM} := hi
  have r4 := apply(x86i.rsp_typed, sM)
  have p64: pow2(64) = 18446744073709551616 by simp()
  have e2: int_mod(int_add(int_add(int_sub(app(app(s, "gpr"), 4), fr), d), x0), 18446744073709551616) =
    int_mod(int_add(int_add(app(app(s, "gpr"), 4), int_mod(int_sub(d, fr), 18446744073709551616)), x0), 18446744073709551616) by arith(r4, hd, hx, fro)
  have e3 := subst({y. int_mod(int_add(int_add(int_sub(app(app(s, "gpr"), 4), fr), d), x0), 18446744073709551616) =
    int_mod(int_add(int_add(app(app(s, "gpr"), 4), y), x0), 18446744073709551616)}, sym(hc), e2)
  have e4 := subst({y. int_mod(int_add(int_add(y, d), x0), 18446744073709551616) =
    int_mod(int_add(int_add(app(app(s, "gpr"), 4), c), x0), 18446744073709551616)}, sym(rspm), e3)
  show by defs(rewrite(sym(p64), e4), bits_add)
qed

// the memory's coupling, after a step leaving the memory
theorem tr.mem_vm: all s m m2 w ob. app(m2, "vm") = app(m, "vm") -> tr.mem(s, m, w, ob) -> tr.mem(s, m2, w, ob)
proof
  fix s m m2 w ob
  assume e h
  show by defs(rewrite(sym(e), expand(h, tr.mem)), tr.mem)
qed

// ... at the return: the world's memory matches the machine's
theorem tr.mem_wm: all s m w ob. tr.mem(s, m, w, ob) -> abi.world_matches(app(s, "vm"), app(m, "vm"), app(w, "vm"), ob, abi.sp(s))
proof
  fix s m w ob
  assume h
  have {wm} := h
  show := wm
qed

// (writable: readable)
theorem tr.acc_wr: all vm x. x86_64_linux.can_access(vm, x, 1) -> x86_64_linux.can_access(vm, x, 0)
proof
  fix vm x
  assume h
  show by defs(simp(expand(h, x86_64_linux.can_access, x86_64_linux.hw_allows, x86_64_linux.accessible)), x86_64_linux.can_access, x86_64_linux.hw_allows, x86_64_linux.accessible)
qed

// A GIMPLE access's byte (usable in the world: in its domain) is the
// machine's: within the address space, accessible there (writable for a
// write), the same byte
theorem tr.mem_read: all s m w ob a n wr i. tr.mem(s, m, w, ob) -> gimple.usable(app(w, "vm"), app(w, "objs"), a, n, wr) -> int_le(0, a) -> i in omega -> int_lt(i, n) ->
  int_lt(int_add(a, i), 18446744073709551616) &&
  x86_64_linux.can_access(app(m, "vm"), int_add(a, i), 0) && (wr -> x86_64_linux.can_access(app(m, "vm"), int_add(a, i), 1)) &&
    app(app(app(m, "vm"), "bytes"), int_add(a, i)) = app(app(app(w, "vm"), "bytes"), int_add(a, i))
proof
  fix s m w ob a n wr i
  assume hmm hus ha hi hn
  have {wob, wm, oacc} := hmm
  have {bytes, pages} := wm
  let X := int_add(a, i)
  let P := int_div(X, x86_64_linux.PAGE)
  let C := x86_64_linux.mapped(app(w, "vm"), P) && !(app(snd(app(app(app(w, "vm"), "pages"), P)), "kind") = 2)
  let PW := app(app(snd(app(app(app(w, "vm"), "pages"), P)), "prot"), "w")
  let PR := app(app(snd(app(app(app(w, "vm"), "pages"), P)), "prot"), "r")
  have ui := mp(all_elim(expand(hus, gimple.usable), {i}), hi, hn)
  // a page's (not the stack's): the machine's page the world's
  have c1: C -> int_lt(X, 18446744073709551616) && x86_64_linux.can_access(app(m, "vm"), X, 0) && (wr -> x86_64_linux.can_access(app(m, "vm"), X, 1)) &&
      app(app(app(m, "vm"), "bytes"), X) = app(app(app(w, "vm"), "bytes"), X) proof
    assume hc
    have ip := rewrite(mp(ite_t[c := C, a := ite(wr, PW, PR), b := int_lt(X, int_pow(2, 64)) && X in app(w, "objs")], hc), ui)
    have mc := expand(hc, x86_64_linux.mapped)
    have hlt: int_lt(X, 18446744073709551616) by simp(expand(mc, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE), ha, hi)
    have xb: X in bits(64) by simp(ha, hi, hlt)
    have dm: abi.in_domain(app(w, "vm"), ob, X) by defs(taut(hc), abi.in_domain)
    have be := mp(all_elim(bytes, {X}), xb, dm)
    have pr: P in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) by simp(mc, ha, hi)
    have pc := mp(all_elim(pages, {P}), pr)
    have nn: !(app(app(app(w, "vm"), "pages"), P) = none) by taut(mc)
    have pe: app(app(app(m, "vm"), "pages"), P) = app(app(app(w, "vm"), "pages"), P) by taut(pc, nn)
    have r1: wr -> x86_64_linux.can_access(app(m, "vm"), X, 0) && x86_64_linux.can_access(app(m, "vm"), X, 1) proof
      assume hw
      have pw := rewrite(mp(ite_t[c := wr, a := PW, b := PR], hw), ip)
      show by defs(simp(pe, mc, pw), x86_64_linux.can_access, x86_64_linux.mapped, x86_64_linux.page_of, x86_64_linux.hw_allows, x86_64_linux.accessible)
    qed
    have r0: !wr -> x86_64_linux.can_access(app(m, "vm"), X, 0) proof
      assume hw
      have pr0 := rewrite(mp(ite_f[c := wr, a := PW, b := PR], hw), ip)
      show by defs(simp(pe, mc, pr0), x86_64_linux.can_access, x86_64_linux.mapped, x86_64_linux.page_of, x86_64_linux.hw_allows, x86_64_linux.accessible)
    qed
    show by taut(hlt, r1, r0, be)
  qed
  // else a stack object's: in the domain, accessible
  have c2: !C -> int_lt(X, 18446744073709551616) && x86_64_linux.can_access(app(m, "vm"), X, 0) && (wr -> x86_64_linux.can_access(app(m, "vm"), X, 1)) &&
      app(app(app(m, "vm"), "bytes"), X) = app(app(app(w, "vm"), "bytes"), X) proof
    assume hc
    have ho0 := rewrite(mp(ite_f[c := C, a := ite(wr, PW, PR), b := int_lt(X, int_pow(2, 64)) && X in app(w, "objs")], hc), ui)
    have hlt: int_lt(X, 18446744073709551616) by simp(ho0)
    have ho1: X in app(w, "objs") by taut(ho0)
    have ho := rewrite(wob, ho1)
    have xb: X in bits(64) by simp(ha, hi, hlt)
    have bx: bits_of_int(64, X) = X by simp(ha, hi, hlt)
    have dm: abi.in_domain(app(w, "vm"), ob, X) by defs(taut(ho), abi.in_domain)
    have be := mp(all_elim(bytes, {X}), xb, dm)
    have xo: X in omega by simp(ha, hi)
    have oa := mp(all_elim(oacc, {X}), xo, ho)
    have oa1: x86_64_linux.can_access(app(m, "vm"), bits_of_int(64, X), 1) by taut(oa)
    have ca1: x86_64_linux.can_access(app(m, "vm"), X, 1) := rewrite(bx, oa1)
    have ca0 := apply(tr.acc_wr, ca1)
    show by taut(hlt, ca0, ca1, be)
  qed
  show by taut(c1, c2)
qed

// (a read of n bytes: the same from two memories agreeing on them)
theorem tr.le_same: all b1 b2 r n. n in omega ->
  (all k. k in omega -> int_lt(k, n) -> app(b1, bits_add(64, r, bits_of_int(64, k))) = app(b2, bits_add(64, r, bits_of_int(64, k)))) ->
  x86_64_linux.le(b1, r, n) = x86_64_linux.le(b2, r, n)
proof
  fix b1 b2 r n
  assume hn hk
  let F1(j) := int_mul(app(b1, bits_add(64, r, bits_of_int(64, j))), int_pow(256, j))
  let F2(j) := int_mul(app(b2, bits_add(64, r, bits_of_int(64, j))), int_pow(256, j))
  have s: all i. i in omega -> int_le(i, n) -> int_sum(0, i, j. F1(j)) = int_sum(0, i, j. F2(j)) proof
    have base: int_le(0, n) -> int_sum(0, 0, j. F1(j)) = int_sum(0, 0, j. F2(j)) proof
      assume z
      have r1 := rec({nat_rec(empty, k v. int_add(v, F1(int_add(0, k))), 0)})
      have r2 := rec({nat_rec(empty, k v. int_add(v, F2(int_add(0, k))), 0)})
      show by defs(simp(r1, r2), int_sum)
    qed
    have step: all i. i in omega -> (int_le(i, n) -> int_sum(0, i, j. F1(j)) = int_sum(0, i, j. F2(j))) ->
        int_le(int_add(i, 1), n) -> int_sum(0, int_add(i, 1), j. F1(j)) = int_sum(0, int_add(i, 1), j. F2(j)) proof
      fix i
      assume hi ih hle
      have le: int_le(i, n) by arith(hi, hn, hle)
      have lt: int_lt(i, n) by arith(hi, hn, hle)
      have e0 := mp(ih, le)
      have ek := mp(all_elim(hk, {i}), hi, lt)
      have u1: int_sum(0, int_add(i, 1), j. F1(j)) = int_add(int_sum(0, i, j. F1(j)), F1(i)) by defs(simp(hi, rec({nat_rec(empty, k v. int_add(v, F1(int_add(0, k))), int_add(i, 1))}, hi)), int_sum)
      have u2: int_sum(0, int_add(i, 1), j. F2(j)) = int_add(int_sum(0, i, j. F2(j)), F2(i)) by defs(simp(hi, rec({nat_rec(empty, k v. int_add(v, F2(int_add(0, k))), int_add(i, 1))}, hi)), int_sum)
      show by simp(u1, u2, e0, ek)
    qed
    show by induct(base, step)
  qed
  have nn: int_le(n, n) by arith(hn)
  have sn := mp(all_elim(s, {n}), hn, nn)
  show by defs(simp(sn), x86_64_linux.le)
qed


// A GIMPLE load's n bytes at a (usable in the world): accessible in the
// machine, its little-endian value the world's
theorem tr.mem_load: all s m w ob a n wr. tr.mem(s, m, w, ob) -> gimple.usable(app(w, "vm"), app(w, "objs"), a, n, wr) -> a in bits(64) -> n in omega ->
  (all j. j in omega -> int_lt(j, n) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, a, bits_of_int(64, j)), 0)) &&
  x86_64_linux.le(app(app(m, "vm"), "bytes"), a, n) = x86_64_linux.le(app(app(w, "vm"), "bytes"), a, n)
proof
  fix s m w ob a n wr
  assume hmm hus ha hn
  have a0: int_le(0, a) by simp(ha)
  have p64: pow2(64) = 18446744073709551616 by simp()
  have rd: all j. j in omega -> int_lt(j, n) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, a, bits_of_int(64, j)), 0) &&
      app(app(app(m, "vm"), "bytes"), bits_add(64, a, bits_of_int(64, j))) = app(app(app(w, "vm"), "bytes"), bits_add(64, a, bits_of_int(64, j))) proof
    fix j
    assume j1 j2
    have r := apply(tr.mem_read, {s}, {m}, {w}, {ob}, {a}, {n}, {wr}, {j}, hmm, hus, a0, j1, j2)
    // (the j-th byte's address: a + j)
    have l: int_lt(int_add(a, j), 18446744073709551616) by taut(r)
    have e0: int_mod(int_add(a, int_mod(j, 18446744073709551616)), 18446744073709551616) = int_add(a, j) by arith(a0, j1, j2, l)
    have e: bits_add(64, a, bits_of_int(64, j)) = int_add(a, j) by defs(rewrite(sym(p64), e0), bits_add, bits_of_int)
    show by simp(r, e)
  qed
  have ac: all j. j in omega -> int_lt(j, n) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, a, bits_of_int(64, j)), 0) proof
    fix j
    assume j1 j2
    show by taut(mp(all_elim(rd, {j}), j1, j2))
  qed
  have by: all j. j in omega -> int_lt(j, n) -> app(app(app(m, "vm"), "bytes"), bits_add(64, a, bits_of_int(64, j))) = app(app(app(w, "vm"), "bytes"), bits_add(64, a, bits_of_int(64, j))) proof
    fix j
    assume j1 j2
    show by taut(mp(all_elim(rd, {j}), j1, j2))
  qed
  have ls := apply(tr.le_same, {app(app(m, "vm"), "bytes")}, {app(app(w, "vm"), "bytes")}, {a}, {n}, hn, by)
  show by taut(ac, ls)
qed

// the world's bytes: typed
theorem tr.world_bytes: all s base code fr m w. tr.inv(s, base, code, fr, m, w) -> app(app(w, "vm"), "bytes") in fn_space(bits(64), bits(8))
proof
  fix s base code fr m w
  assume hi
  show by simp(expand(expand(hi.wW, abi.World), x86_64_linux.Vm))
qed

// a register an instruction may write: not rsp, not callee-saved
def tr.scratch_reg(g) := g in x86_64_linux.Reg && !(g = 3) && !(g = 4) && !(g = 5) && !(g = 12) && !(g = 13) && !(g = 14) && !(g = 15)

// the invariant after a register write (and rip, the flags)
theorem tr.inv_reg: all s base code fr m w r f g x. tr.inv(s, base, code, fr, m, w) -> r in bits(64) -> x86i.flags_ok(m, f) -> tr.scratch_reg(g) -> x in bits(64) ->
  tr.inv(s, base, code, fr, fn_update(fn_update(fn_update(m, "rip", r), "flags", f), "gpr", fn_update(app(m, "gpr"), g, x)), w)
proof
  fix s base code fr m w r f g x
  assume hi hr hf hg hx
  have i := expand(hi, tr.inv)
  have {mM, mu} := i
  have pt := apply(x86i.parts, mM)
  have f1 := expand(hf, x86i.flags_ok)
  have g1 := expand(hg, tr.scratch_reg)
  have m2: fn_update(fn_update(fn_update(m, "rip", r), "flags", f), "gpr", fn_update(app(m, "gpr"), g, x)) in x86_64_linux.Machine by defs(simp(expand(mM, x86_64_linux.Machine), mu, hr, f1, g1, hx, pt), x86_64_linux.Machine)
  have gn: !(g = 3) && !(g = 4) && !(g = 5) && !(g = 12) && !(g = 13) && !(g = 14) && !(g = 15) by taut(g1)
  have gu: g in univ(1) by simp(g1)
  // (rsp and the callee-saved registers untouched)
  have e3 := mp(app_update_other[f := app(m, "gpr"), k := g, v := x, x := 3], simp(gn))
  have e4 := mp(app_update_other[f := app(m, "gpr"), k := g, v := x, x := 4], simp(gn))
  have e5 := mp(app_update_other[f := app(m, "gpr"), k := g, v := x, x := 5], simp(gn))
  have e12 := mp(app_update_other[f := app(m, "gpr"), k := g, v := x, x := 12], simp(gn))
  have e13 := mp(app_update_other[f := app(m, "gpr"), k := g, v := x, x := 13], simp(gn))
  have e14 := mp(app_update_other[f := app(m, "gpr"), k := g, v := x, x := 14], simp(gn))
  have e15 := mp(app_update_other[f := app(m, "gpr"), k := g, v := x, x := 15], simp(gn))
  show by defs(simp(i, m2, hr, f1, gn, gu, hx, e3, e4, e5, e12, e13, e14, e15, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access)), tr.inv)
qed

// the registers after the write of x to g: g holds x
theorem tr.regs_set: all m rs g n x. tr.regs(m, rs) -> x in bits(int_mul(8, n)) ->
  tr.regs(fn_update(m, "gpr", fn_update(app(m, "gpr"), g, x)), fn_update(rs, g, pair(n, x)))
proof
  fix m rs g n x
  assume h hx
  have fr r := expand(h, tr.regs)
  have du := mp(dom_update[f := rs, k := g, v := pair(n, x)], fr)
  have fu := mp(fn_update_fun[f := rs, k := g, v := pair(n, x)], fr)
  have k: all r0. r0 in dom(fn_update(rs, g, pair(n, x))) -> app(app(fn_update(m, "gpr", fn_update(app(m, "gpr"), g, x)), "gpr"), r0) = snd(app(fn_update(rs, g, pair(n, x)), r0)) &&
      snd(app(fn_update(rs, g, pair(n, x)), r0)) in bits(int_mul(8, fst(app(fn_update(rs, g, pair(n, x)), r0)))) proof
    fix r0
    assume hd
    have same: r0 = g -> app(app(fn_update(m, "gpr", fn_update(app(m, "gpr"), g, x)), "gpr"), r0) = snd(app(fn_update(rs, g, pair(n, x)), r0)) &&
        snd(app(fn_update(rs, g, pair(n, x)), r0)) in bits(int_mul(8, fst(app(fn_update(rs, g, pair(n, x)), r0)))) by simp(hx)
    have other: !(r0 = g) -> app(app(fn_update(m, "gpr", fn_update(app(m, "gpr"), g, x)), "gpr"), r0) = snd(app(fn_update(rs, g, pair(n, x)), r0)) &&
        snd(app(fn_update(rs, g, pair(n, x)), r0)) in bits(int_mul(8, fst(app(fn_update(rs, g, pair(n, x)), r0)))) proof
      assume ne
      have e1 := mp(app_update_other[f := app(m, "gpr"), k := g, v := x, x := r0], ne)
      have e2 := mp(app_update_other[f := rs, k := g, v := pair(n, x), x := r0], ne)
      have hd2 := rewrite(du, hd)
      have d0: r0 in dom(rs) by simp(hd2, ne)
      have c := mp(all_elim(r, {r0}), d0)
      show by simp(e1, e2, c)
    qed
    show by taut(same, other)
  qed
  show by defs(taut(fu, k), tr.regs)
qed

// (the entry's rsp: at least 8, as rsp + 8 is 16-aligned)
theorem tr.inv_sp8: all s base code fr m w. tr.inv(s, base, code, fr, m, w) -> int_le(8, app(app(s, "gpr"), 4))
proof
  fix s base code fr m w
  assume hi
  have {sM, sal, slt} := hi
  have r4 := apply(x86i.rsp_typed, sM)
  have p64: pow2(64) = 18446744073709551616 by simp()
  have e0: int_mod(int_add(app(app(s, "gpr"), 4), 8), 18446744073709551616) = int_add(app(app(s, "gpr"), 4), 8) by arith(r4, slt)
  have e: bits_add(64, app(app(s, "gpr"), 4), 8) = int_add(app(app(s, "gpr"), 4), 8) by defs(rewrite(sym(p64), e0), bits_add)
  have al2 := rewrite(e, sal)
  show by arith(al2, r4)
qed

// the invariant after rsp := s's less fr2, a frame of at most 8 bytes (and
// rip, the flags)
theorem tr.inv_rsp: all s base code fr fr2 m w r f. tr.inv(s, base, code, fr, m, w) -> r in bits(64) -> x86i.flags_ok(m, f) -> fr2 in omega -> int_le(fr2, 8) ->
  tr.inv(s, base, code, fr2, fn_update(fn_update(fn_update(m, "rip", r), "flags", f), "gpr", fn_update(app(m, "gpr"), 4, int_sub(app(app(s, "gpr"), 4), fr2))), w)
proof
  fix s base code fr fr2 m w r f
  assume hi hr hf hfo hfl
  have i := expand(hi, tr.inv)
  have {mM, mu, sM} := i
  have r4 := apply(x86i.rsp_typed, sM)
  have s8 := apply(tr.inv_sp8, hi)
  have x64: int_sub(app(app(s, "gpr"), 4), fr2) in bits(64) by arith(r4, s8, hfo, hfl)
  have pt := apply(x86i.parts, mM)
  have f1 := expand(hf, x86i.flags_ok)
  have m2: fn_update(fn_update(fn_update(m, "rip", r), "flags", f), "gpr", fn_update(app(m, "gpr"), 4, int_sub(app(app(s, "gpr"), 4), fr2))) in x86_64_linux.Machine
    by defs(simp(expand(mM, x86_64_linux.Machine), mu, hr, f1, x64, pt), x86_64_linux.Machine)
  have xu: int_sub(app(app(s, "gpr"), 4), fr2) in univ(1) by simp(x64)
  // (the callee-saved registers untouched)
  have e3 := mp(app_update_other[f := app(m, "gpr"), k := 4, v := int_sub(app(app(s, "gpr"), 4), fr2), x := 3], simp())
  have e5 := mp(app_update_other[f := app(m, "gpr"), k := 4, v := int_sub(app(app(s, "gpr"), 4), fr2), x := 5], simp())
  have e12 := mp(app_update_other[f := app(m, "gpr"), k := 4, v := int_sub(app(app(s, "gpr"), 4), fr2), x := 12], simp())
  have e13 := mp(app_update_other[f := app(m, "gpr"), k := 4, v := int_sub(app(app(s, "gpr"), 4), fr2), x := 13], simp())
  have e14 := mp(app_update_other[f := app(m, "gpr"), k := 4, v := int_sub(app(app(s, "gpr"), 4), fr2), x := 14], simp())
  have e15 := mp(app_update_other[f := app(m, "gpr"), k := 4, v := int_sub(app(app(s, "gpr"), 4), fr2), x := 15], simp())
  show by defs(simp(i, m2, hr, f1, xu, hfo, e3, e5, e12, e13, e14, e15, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access)), tr.inv)
qed

// the registers after a write of rsp (not among them)
theorem tr.regs_keep4: all m rs r f x. tr.regs(m, rs) -> !(4 in dom(rs)) ->
  tr.regs(fn_update(fn_update(fn_update(m, "rip", r), "flags", f), "gpr", fn_update(app(m, "gpr"), 4, x)), rs)
proof
  fix m rs r f x
  assume h hn
  have fu rr := expand(h, tr.regs)
  have k: all r1. r1 in dom(rs) -> app(app(fn_update(fn_update(fn_update(m, "rip", r), "flags", f), "gpr", fn_update(app(m, "gpr"), 4, x)), "gpr"), r1) = snd(app(rs, r1)) &&
      snd(app(rs, r1)) in bits(int_mul(8, fst(app(rs, r1)))) proof
    fix r1
    assume hd
    have ne0: r1 = 4 -> false proof
      assume e
      have h4 := rewrite(e, hd)
      show by taut(h4, hn)
    qed
    have ne: !(r1 = 4) by taut(ne0)
    have e1 := mp(app_update_other[f := app(m, "gpr"), k := 4, v := x, x := r1], ne)
    have c := mp(all_elim(rr, {r1}), hd)
    show by simp(e1, c)
  qed
  show by defs(taut(fu, k), tr.regs)
qed

// a step setting rsp to s's less fr2 (a frame of at most 8 bytes): the
// claim with the frame fr2 after it gives the claim before
theorem tr.rsp_step: all s v base code fr fr2 a a2 hs ds rs p w.
  (all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
     (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), 4, int_sub(app(app(s, "gpr"), 4), fr2))), empty))) ->
  a2 in bits(64) -> fr2 in omega -> int_le(fr2, 8) -> !(4 in dom(rs)) ->
  tr.pt(s, v, base, code, fr2, a2, hs, ds, rs, p, w) -> tr.pt(s, v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr fr2 a a2 hs ds rs p w
  assume he ha2 hfo hfl hn4 hpt
  let X := int_sub(app(app(s, "gpr"), 4), fr2)
  have g: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, ds) -> tr.sim(s, v, p, w, m) proof
    fix m
    assume hi hr hh hrs hmm
    let Q(m2) := ex f. x86i.flags_ok(m, f) && m2 = fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), 4, X))
    have st: all o. runs(x86_64_linux.step(), m, o) -> (ex m2. o = ok(m2, empty) && Q(m2)) proof
      fix o
      assume ho
      obtain f, hf from mp(mp(mp(mp(mp(all_elim(he, {m}, {o}), hi), hr), hh), hrs), ho)
      have q2: Q(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), 4, X))) by ex_intro({f}, simp(hf, keep(x86i.flags_ok)))
      show by ex_intro({fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), 4, X))}, taut(q2, hf))
    qed
    have nr := apply(tr.inv_nr, hi)
    // (after the step: coupled at a2, in the frame fr2)
    have post: all m2. Q(m2) -> tr.sim(s, v, p, w, m2) proof
      fix m2
      assume hq
      obtain f, fo e from hq
      have i2 := apply(tr.inv_rsp, {s}, {base}, {code}, {fr}, {fr2}, {m}, {w}, {a2}, {f}, hi, ha2, fo, hfo, hfl)
      have h2: tr.homes(s, fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), 4, X)), hs) by defs(simp(expand(hh, tr.homes)), tr.homes)
      have rs2 := apply(tr.regs_keep4, {m}, {rs}, {a2}, {f}, {X}, hrs, hn4)
      have rip2: app(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), 4, X)), "rip") = a2 by simp()
      have mm2 := apply(tr.mem_vm, {s}, {m}, {fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), 4, X))}, {w}, {ds}, simp(), hmm)
      have c := mp(mp(mp(mp(mp(all_elim(expand(hpt, tr.pt), {fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), 4, X))}), i2), rip2), h2), rs2), mm2)
      show := rewrite(sym(e), c)
    qed
    show := mp(mp(mp(tr.step[s := s, v := v, p := p, w := w, m := m, q := x. Q(x)], st), nr), post)
  qed
  show by defs(g, tr.pt)
qed

// sub rsp, imm8 (the prologue): the frame grows by k, to at most 8 bytes
theorem tr.sub_rsp: all s v base code fr a a2 len z k fr2 hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(60, pair(8, pair(5, pair(tag(0, 4), pair(z, k)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> k in bits(8) -> int_lt(k, 128) -> fr2 = int_add(fr, k) -> fr2 in omega -> int_le(fr2, 8) -> !(4 in dom(rs)) ->
  tr.pt(s, v, base, code, fr2, a2, hs, ds, rs, p, w) -> tr.pt(s, v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len z k fr2 hs ds rs p w
  assume hat ha2 hk hkl hf2 hfo hfl hn4 hpt
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), 4, int_sub(app(app(s, "gpr"), 4), fr2))), empty)) proof
    fix m o
    assume hi hr hhs hrs ho
    have {mM, mu, cd, rspm, fro, sM} := hi
    have r4R: 4 in x86_64_linux.Reg by simp()
    have hx := mp(mp(mp(all_elim(hat, {m}, {o}), ho), cd), hr)
    obtain f, hf from apply(x86i.sub64_imm, {m}, {o}, {4}, {z}, {k}, {len}, mM, mu, r4R, hk, hx)
    // (rsp - k: s's less fr + k, no wrap)
    have r4 := apply(x86i.rsp_typed, sM)
    have s8 := apply(tr.inv_sp8, hi)
    have sx: bits_sext(8, 64, k) = k by defs(simp(hk, hkl), bits_sext, sint)
    have p64: pow2(64) = 18446744073709551616 by simp()
    have e0: int_mod(int_sub(int_sub(app(app(s, "gpr"), 4), fr), k), 18446744073709551616) = int_sub(app(app(s, "gpr"), 4), fr2) by arith(r4, s8, fro, hk, hf2, hfl)
    have e2: int_mod(int_sub(app(app(m, "gpr"), 4), bits_sext(8, 64, k)), 18446744073709551616) = int_sub(app(app(s, "gpr"), 4), fr2) by simp(e0, rspm, sx)
    have e1: bits_sub(64, app(app(m, "gpr"), 4), bits_sext(8, 64, k)) = int_sub(app(app(s, "gpr"), 4), fr2) by defs(rewrite(sym(p64), e2), bits_sub)
    show by ex_intro({f}, simp(hf, e1, hr, ha2, keep(x86i.flags_ok)))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.rsp_step, {s}, {v}, {base}, {code}, {fr}, {fr2}, {a}, {a2}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hfo, hfl, hn4, hpt)
qed

// add rsp, imm8 (the epilogue): the frame shrinks by k
theorem tr.add_rsp: all s v base code fr a a2 len z k fr2 hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(60, pair(8, pair(0, pair(tag(0, 4), pair(z, k)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> k in bits(8) -> int_lt(k, 128) -> fr2 = int_sub(fr, k) -> fr2 in omega -> int_le(fr2, 8) -> !(4 in dom(rs)) ->
  tr.pt(s, v, base, code, fr2, a2, hs, ds, rs, p, w) -> tr.pt(s, v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len z k fr2 hs ds rs p w
  assume hat ha2 hk hkl hf2 hfo hfl hn4 hpt
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), 4, int_sub(app(app(s, "gpr"), 4), fr2))), empty)) proof
    fix m o
    assume hi hr hhs hrs ho
    have {mM, mu, cd, rspm, fro, sM, slt} := hi
    have r4R: 4 in x86_64_linux.Reg by simp()
    have hx := mp(mp(mp(all_elim(hat, {m}, {o}), ho), cd), hr)
    obtain f, hf from apply(x86i.add64_imm, {m}, {o}, {4}, {z}, {k}, {len}, mM, mu, r4R, hk, hx)
    // (rsp + k: s's less fr - k, below 2^64)
    have r4 := apply(x86i.rsp_typed, sM)
    have m4 := apply(x86i.rsp_typed, mM)
    have m4b := rewrite(rspm, m4)
    have sx: bits_sext(8, 64, k) = k by defs(simp(hk, hkl), bits_sext, sint)
    have p64: pow2(64) = 18446744073709551616 by simp()
    have e0: int_mod(int_add(int_sub(app(app(s, "gpr"), 4), fr), k), 18446744073709551616) = int_sub(app(app(s, "gpr"), 4), fr2) by arith(r4, slt, m4b, fro, hk, hf2, hfo)
    have e2: int_mod(int_add(app(app(m, "gpr"), 4), bits_sext(8, 64, k)), 18446744073709551616) = int_sub(app(app(s, "gpr"), 4), fr2) by simp(e0, rspm, sx)
    have e1: bits_add(64, app(app(m, "gpr"), 4), bits_sext(8, 64, k)) = int_sub(app(app(s, "gpr"), 4), fr2) by defs(rewrite(sym(p64), e2), bits_add)
    show by ex_intro({f}, simp(hf, e1, hr, ha2, keep(x86i.flags_ok)))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.rsp_step, {s}, {v}, {base}, {code}, {fr}, {fr2}, {a}, {a2}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hfo, hfl, hn4, hpt)
qed

// a register write's step: from a coupled state at a, the instruction ends
// with g := V (the value the coupling gives) and rip a2, the flags open;
// the claim after it, with g holding V, gives the claim at a
theorem tr.reg_step: all s v base code fr a a2 g n bigv hs ds rs p w.
  (all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
     (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bigv)), empty))) ->
  a2 in bits(64) -> tr.scratch_reg(g) ->
  (all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> bigv in bits(int_mul(8, n)) && bigv in bits(64)) ->
  tr.pt(s, v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(n, bigv)), p, w) -> tr.pt(s, v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 g n bigv hs ds rs p w
  assume he ha2 hg ht hpt
  have g: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, ds) -> tr.sim(s, v, p, w, m) proof
    fix m
    assume hi hr hh hrs hmm
    have hv v64 := mp(mp(mp(mp(all_elim(ht, {m}), hi), hr), hh), hrs)
    let Q(m2) := ex f. x86i.flags_ok(m, f) && m2 = fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bigv))
    have st: all o. runs(x86_64_linux.step(), m, o) -> (ex m2. o = ok(m2, empty) && Q(m2)) proof
      fix o
      assume ho
      obtain f, hf from mp(mp(mp(mp(mp(all_elim(he, {m}, {o}), hi), hr), hh), hrs), ho)
      have q2: Q(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bigv))) by ex_intro({f}, simp(hf, keep(x86i.flags_ok)))
      show by ex_intro({fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bigv))}, taut(q2, hf))
    qed
    // (not at the return: rsp is s's, not past the return address)
    have nr := apply(tr.inv_nr, hi)
    // (after the step: coupled at a2)
    have post: all m2. Q(m2) -> tr.sim(s, v, p, w, m2) proof
      fix m2
      assume hq
      obtain f, fo e from hq
      have i2 := apply(tr.inv_reg, {s}, {base}, {code}, {fr}, {m}, {w}, {a2}, {f}, {g}, {bigv}, hi, ha2, fo, hg, v64)
      have h2: tr.homes(s, fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bigv)), hs) by defs(simp(expand(hh, tr.homes)), tr.homes)
      have rs1 := apply(tr.regs_set, {m}, {rs}, {g}, {n}, {bigv}, hrs, hv)
      have rs2: tr.regs(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bigv)), fn_update(rs, g, pair(n, bigv))) by defs(simp(expand(rs1, tr.regs)), tr.regs)
      have rip2: app(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bigv)), "rip") = a2 by simp()
      have mm2 := apply(tr.mem_vm, {s}, {m}, {fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bigv))}, {w}, {ds}, simp(), hmm)
      have c := mp(mp(mp(mp(mp(all_elim(expand(hpt, tr.pt), {fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bigv))}), i2), rip2), h2), rs2), mm2)
      show := rewrite(sym(e), c)
    qed
    show := mp(mp(mp(tr.step[s := s, v := v, p := p, w := w, m := m, q := x. Q(x)], st), nr), post)
  qed
  show by defs(g, tr.pt)
qed

// the invariant's facts the instruction rules use
theorem tr.inv_parts: all s base code fr m w. tr.inv(s, base, code, fr, m, w) ->
  m in x86_64_linux.Machine && m in univ(1) && abi.code_at(app(m, "vm"), base, code) && app(app(m, "gpr"), 4) = int_sub(app(app(s, "gpr"), 4), fr)
proof
  fix s base code fr m w
  assume hi
  show := conj(hi.mM, hi.mu, hi.cd, hi.rspm)
qed

// (an instruction leaving the flags: as setting them to themselves)
theorem tr.flags_same: all m a2 x. m in x86_64_linux.Machine ->
  fn_update(fn_update(fn_update(m, "rip", a2), "flags", app(m, "flags")), "gpr", x) = fn_update(fn_update(m, "rip", a2), "gpr", x)
proof
  fix m a2 x
  assume hM
  have mf: is_fun(m) && "flags" in dom(m) by simp(expand(hM, x86_64_linux.Machine))
  have mfun := mf.1
  have f1 := mp(fn_update_fun[f := m, k := "rip", v := a2], mfun)
  have d1 := mp(dom_update[f := m, k := "rip", v := a2], mfun)
  have r1: is_fun(fn_update(m, "rip", a2)) && "flags" in dom(fn_update(m, "rip", a2)) by simp(mf, f1, d1)
  have e := mp(mp(fn_update_same[f := fn_update(m, "rip", a2), k := "flags"], simp(r1)), simp(r1))
  have e2: app(fn_update(m, "rip", a2), "flags") = app(m, "flags") by simp()
  have e3 := rewrite(e2, e)
  show := subst({y. fn_update(fn_update(fn_update(m, "rip", a2), "flags", app(m, "flags")), "gpr", x) = fn_update(y, "gpr", x)}, e3,
    refl({fn_update(fn_update(fn_update(m, "rip", a2), "flags", app(m, "flags")), "gpr", x)}))
qed

theorem tr.flags_ok_same: all m. m in x86_64_linux.Machine -> m in univ(1) -> x86i.flags_ok(m, app(m, "flags"))
proof
  fix m
  assume hM hu
  have pt := apply(x86i.parts, hM)
  show by defs(simp(pt, hu), x86i.flags_ok)
qed

// a register write leaving the flags
theorem tr.reg_step0: all s v base code fr a a2 g n bigv hs ds rs p w.
  (all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
     o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(app(m, "gpr"), g, bigv)), empty)) ->
  a2 in bits(64) -> tr.scratch_reg(g) ->
  (all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> bigv in bits(int_mul(8, n)) && bigv in bits(64)) ->
  tr.pt(s, v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(n, bigv)), p, w) -> tr.pt(s, v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 g n bigv hs ds rs p w
  assume he0 ha2 hg ht hpt
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bigv)), empty)) proof
    fix m o
    assume hi hr hh hrs ho
    have mM mu _ _ := apply(tr.inv_parts, hi)
    have eo := mp(mp(mp(mp(mp(all_elim(he0, {m}, {o}), hi), hr), hh), hrs), ho)
    have fs := mp(all_elim(tr.flags_same, {m}, {a2}, {fn_update(app(m, "gpr"), g, bigv)}), mM)
    have fo := mp(mp(all_elim(tr.flags_ok_same, {m}), mM), mu)
    show by ex_intro({app(m, "flags")}, taut(fo, rewrite(sym(fs), eo)))
  qed
  show := apply(tr.reg_step, {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {n}, {bigv}, {hs}, {ds}, {rs}, {p}, {w}, he, ha2, hg, ht, hpt)
qed

// the same for an instruction reading memory: the step given the memory's
// coupling
theorem tr.reg_stepv: all s v base code fr a a2 g n bigv hs ds rs p w.
  (all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, ds) -> runs(x86_64_linux.step(), m, o) ->
     (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bigv)), empty))) ->
  a2 in bits(64) -> tr.scratch_reg(g) ->
  (all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, ds) -> bigv in bits(int_mul(8, n)) && bigv in bits(64)) ->
  tr.pt(s, v, base, code, fr, a2, hs, ds, fn_update(rs, g, pair(n, bigv)), p, w) -> tr.pt(s, v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 g n bigv hs ds rs p w
  assume he ha2 hg ht hpt
  have g: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, ds) -> tr.sim(s, v, p, w, m) proof
    fix m
    assume hi hr hh hrs hmm
    have hv v64 := mp(all_elim(ht, {m}), hi, hr, hh, hrs, hmm)
    let Q(m2) := ex f. x86i.flags_ok(m, f) && m2 = fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bigv))
    have st: all o. runs(x86_64_linux.step(), m, o) -> (ex m2. o = ok(m2, empty) && Q(m2)) proof
      fix o
      assume ho
      obtain f, hf from mp(all_elim(he, {m}, {o}), hi, hr, hh, hrs, hmm, ho)
      have q2: Q(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bigv))) by ex_intro({f}, simp(hf, keep(x86i.flags_ok)))
      show by ex_intro({fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bigv))}, taut(q2, hf))
    qed
    have nr := apply(tr.inv_nr, hi)
    have post: all m2. Q(m2) -> tr.sim(s, v, p, w, m2) proof
      fix m2
      assume hq
      obtain f, fo e from hq
      have i2 := apply(tr.inv_reg, {s}, {base}, {code}, {fr}, {m}, {w}, {a2}, {f}, {g}, {bigv}, hi, ha2, fo, hg, v64)
      have h2: tr.homes(s, fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bigv)), hs) by defs(simp(expand(hh, tr.homes)), tr.homes)
      have rs1 := apply(tr.regs_set, {m}, {rs}, {g}, {n}, {bigv}, hrs, hv)
      have rs2: tr.regs(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bigv)), fn_update(rs, g, pair(n, bigv))) by defs(simp(expand(rs1, tr.regs)), tr.regs)
      have rip2: app(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bigv)), "rip") = a2 by simp()
      have mm2 := apply(tr.mem_vm, {s}, {m}, {fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bigv))}, {w}, {ds}, simp(), hmm)
      have c := mp(all_elim(expand(hpt, tr.pt), {fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bigv))}), i2, rip2, h2, rs2, mm2)
      show := rewrite(sym(e), c)
    qed
    show := mp(mp(mp(tr.step[s := s, v := v, p := p, w := w, m := m, q := x. Q(x)], st), nr), post)
  qed
  show by defs(g, tr.pt)
qed

theorem tr.reg_step0v: all s v base code fr a a2 g n bigv hs ds rs p w.
  (all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, ds) -> runs(x86_64_linux.step(), m, o) ->
     o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(app(m, "gpr"), g, bigv)), empty)) ->
  a2 in bits(64) -> tr.scratch_reg(g) ->
  (all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, ds) -> bigv in bits(int_mul(8, n)) && bigv in bits(64)) ->
  tr.pt(s, v, base, code, fr, a2, hs, ds, fn_update(rs, g, pair(n, bigv)), p, w) -> tr.pt(s, v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 g n bigv hs ds rs p w
  assume he0 ha2 hg ht hpt
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, ds) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bigv)), empty)) proof
    fix m o
    assume hi hr hh hrs hmm ho
    have mM mu _ _ := apply(tr.inv_parts, hi)
    have eo := mp(all_elim(he0, {m}, {o}), hi, hr, hh, hrs, hmm, ho)
    have fs := mp(all_elim(tr.flags_same, {m}, {a2}, {fn_update(app(m, "gpr"), g, bigv)}), mM)
    have fo := mp(mp(all_elim(tr.flags_ok_same, {m}), mM), mu)
    show by ex_intro({app(m, "flags")}, taut(fo, rewrite(sym(fs), eo)))
  qed
  show := apply(tr.reg_stepv, {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {n}, {bigv}, {hs}, {ds}, {rs}, {p}, {w}, he, ha2, hg, ht, hpt)
qed

// a register the coupling gives
// a home the coupling gives
theorem tr.homes_get: all s m hs c n x. tr.homes(s, m, hs) -> c in dom(hs) -> app(hs, c) = pair(n, x) ->
  x86_64_linux.le(app(app(m, "vm"), "bytes"), bits_add(64, int_add(app(app(s, "gpr"), 4), c), 0), n) = x
proof
  fix s m hs c n x
  assume h hd he
  have k := mp(all_elim(expand(h, tr.homes), {c}), hd)
  have k2 := rewrite(he, k)
  show by simp(k2)
qed

// ... read at rsp + d in the frame (the instructions' address)
theorem tr.home_read: all s base code fr m w hs d c n x. tr.inv(s, base, code, fr, m, w) -> tr.homes(s, m, hs) -> d in bits(64) ->
  c = int_mod(int_sub(d, fr), 18446744073709551616) -> c in dom(hs) -> app(hs, c) = pair(n, x) ->
  x86_64_linux.le(app(app(m, "vm"), "bytes"), x86i.rsp_ea(m, d), n) = x
proof
  fix s base code fr m w hs d c n x
  assume hi hh hd hcd hc he
  have fe := apply(tr.frame_ea, {s}, {base}, {code}, {fr}, {m}, {w}, {d}, {c}, {0}, hi, hd, hcd, simp())
  have g := apply(tr.homes_get, {s}, {m}, {hs}, {c}, {n}, {x}, hh, hc, he)
  show := rewrite(sym(fe), g)
qed

// a home's n bytes (at c, within 8 below the entry's rsp), accessible for
// reading and writing
theorem tr.home_acc_s: all s base code fr m w c n. tr.inv(s, base, code, fr, m, w) ->
  c in bits(64) -> int_le(18446744073709551608, c) -> int_le(n, int_sub(18446744073709551616, c)) ->
  x86i.acc(m, bits_add(64, int_add(app(app(s, "gpr"), 4), c), 0), n, 1) && x86i.acc(m, bits_add(64, int_add(app(app(s, "gpr"), 4), c), 0), n, 0)
proof
  fix s base code fr m w c n
  assume hi hc hc1 hn
  have {kp, sM, sacc, sal, slt} := hi
  have r4 := apply(x86i.rsp_typed, sM)
  have s8 := apply(tr.inv_sp8, hi)
  have sa := apply(abi.slot_access, {app(s, "vm")}, {app(app(s, "gpr"), 4)}, {c}, {n}, r4, sacc, sal, hc, hc1, hn)
  // (the address as the slot lemma forms it, and as the model)
  have ea: all x0. x0 in omega -> bits_add(64, bits_add(64, app(app(s, "gpr"), 4), c), x0) = bits_add(64, int_add(app(app(s, "gpr"), 4), c), x0) proof
    fix x0
    assume hx
    have p64: pow2(64) = 18446744073709551616 by simp()
    have e2: int_mod(int_add(int_mod(int_add(app(app(s, "gpr"), 4), c), 18446744073709551616), x0), 18446744073709551616) =
      int_mod(int_add(int_add(app(app(s, "gpr"), 4), c), x0), 18446744073709551616) by arith(r4, hc, hx)
    show by defs(rewrite(sym(p64), e2), bits_add)
  qed
  have sa1 sa0 := sa
  have g1: all i. i in omega -> int_lt(i, n) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, bits_add(64, int_add(app(app(s, "gpr"), 4), c), 0), bits_of_int(64, i)), 1) proof
    fix i
    assume i1 i2
    have c1 := mp(mp(all_elim(sa1, {i}), i1), i2)
    have e := mp(all_elim(ea, {bits_of_int(64, i)}), simp(i1))
    have c2 := rewrite(e, c1)
    have h1 h2 h3 := apply(tr.home_range, {app(app(s, "gpr"), 4)}, {c}, {i}, r4, s8, slt, hc, hc1, i1, arith(i2, hn))
    have c3 := apply(tr.kept_acc, {app(s, "vm")}, {app(m, "vm")}, {app(app(s, "gpr"), 4)}, {bits_add(64, int_add(app(app(s, "gpr"), 4), c), bits_of_int(64, i))}, {1}, kp,
      h1, h2, h3, c2)
    show by simp(c3, r4, hc, i1)
  qed
  have g0: all i. i in omega -> int_lt(i, n) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, bits_add(64, int_add(app(app(s, "gpr"), 4), c), 0), bits_of_int(64, i)), 0) proof
    fix i
    assume i1 i2
    have c1 := mp(mp(all_elim(sa0, {i}), i1), i2)
    have e := mp(all_elim(ea, {bits_of_int(64, i)}), simp(i1))
    have c2 := rewrite(e, c1)
    have h1 h2 h3 := apply(tr.home_range, {app(app(s, "gpr"), 4)}, {c}, {i}, r4, s8, slt, hc, hc1, i1, arith(i2, hn))
    have c3 := apply(tr.kept_acc, {app(s, "vm")}, {app(m, "vm")}, {app(app(s, "gpr"), 4)}, {bits_add(64, int_add(app(app(s, "gpr"), 4), c), bits_of_int(64, i))}, {0}, kp,
      h1, h2, h3, c2)
    show by simp(c3, r4, hc, i1)
  qed
  show by taut(g1, g0)
qed

// ... at rsp + d in the frame (the instructions' address)
theorem tr.home_acc: all s base code fr m w d c n. tr.inv(s, base, code, fr, m, w) -> d in bits(64) -> c = int_mod(int_sub(d, fr), 18446744073709551616) ->
  c in bits(64) -> int_le(18446744073709551608, c) -> int_le(n, int_sub(18446744073709551616, c)) ->
  x86i.acc(m, bits_add(64, int_add(app(app(m, "gpr"), 4), d), 0), n, 1) && x86i.acc(m, bits_add(64, int_add(app(app(m, "gpr"), 4), d), 0), n, 0)
proof
  fix s base code fr m w d c n
  assume hi hd hcd hc hc1 hn
  have fe := apply(tr.frame_ea, {s}, {base}, {code}, {fr}, {m}, {w}, {d}, {c}, {0}, hi, hd, hcd, simp())
  have a := apply(tr.home_acc_s, {s}, {base}, {code}, {fr}, {m}, {w}, {c}, {n}, hi, hc, hc1, hn)
  show := rewrite(sym(fe), a)
qed

// a map's keys (no functionality needed): the key updated, the others kept
theorem tr.dom_upd: all f k v. k in dom(fn_update(f, k, v))
proof
  fix f k v
  have i := fn_update_iff[f := f, k := k, v := v, z := pair(k, v)]
  have m: pair(k, v) in fn_update(f, k, v) by taut(i, refl({pair(k, v)}))
  show := mp(dom_intro[f := fn_update(f, k, v), k := k, v := v], m)
qed

theorem tr.dom_keep: all f k j v. k in dom(f) -> !(k = j) -> k in dom(fn_update(f, j, v))
proof
  fix f k j v
  assume hk hne
  have si := set_image_def[s := f, f := x. fst(x), y := k]
  have e: ex z. z in f && fst(z) = k by taut(si, expand(hk, dom))
  obtain z, hz from e
  have i := fn_update_iff[f := f, k := j, v := v, z := z]
  have ne2: j = k -> false proof
    assume e
    show by taut(hne, sym(e))
  qed
  have zf: fst(z) != j by simp(hz, hne, ne2)
  have zin: z in fn_update(f, j, v) by taut(i, hz, zf)
  have si2 := set_image_def[s := fn_update(f, j, v), f := x. fst(x), y := k]
  have e2: ex z. z in fn_update(f, j, v) && fst(z) = k by ex_intro({z}, taut(zin, hz))
  show by defs(taut(si2, e2), dom)
qed

// a key not in a map: not in it after updates of other keys
theorem tr.dom_none: all k. !(k in dom(empty))
proof
  fix k
  show by simp(dom_empty)
qed

theorem tr.dom_out: all f k j v. !(k in dom(f)) -> !(k = j) -> !(k in dom(fn_update(f, j, v)))
proof
  fix f k j v
  assume hk hne
  have no: k in dom(fn_update(f, j, v)) -> false proof
    assume hin
    have si := set_image_def[s := fn_update(f, j, v), f := x. fst(x), y := k]
    have e: ex z. z in fn_update(f, j, v) && fst(z) = k by taut(si, expand(hin, dom))
    obtain z, hz from e
    have i := fn_update_iff[f := f, k := j, v := v, z := z]
    have c1: z in f && fst(z) != j -> false proof
      assume h1
      have si2 := set_image_def[s := f, f := x. fst(x), y := k]
      have e2: ex y. y in f && fst(y) = k by ex_intro({z}, taut(h1, hz))
      have kin: k in dom(f) by defs(taut(si2, e2), dom)
      show by taut(hk, kin)
    qed
    have c2: z = pair(j, v) -> false proof
      assume h2
      have zk: fst(z) = k by taut(hz)
      have f2: fst(z) = j by simp(h2)
      show by taut(hne, trans(sym(zk), f2))
    qed
    show by taut(i, hz, c1, c2)
  qed
  show by taut(no)
qed

theorem tr.regs_get: all m rs g n u. tr.regs(m, rs) -> g in dom(rs) -> app(rs, g) = pair(n, u) -> app(app(m, "gpr"), g) = u && u in bits(int_mul(8, n))
proof
  fix m rs g n u
  assume h hd he
  have r: all r. r in dom(rs) -> app(app(m, "gpr"), r) = snd(app(rs, r)) && snd(app(rs, r)) in bits(int_mul(8, fst(app(rs, r)))) by taut(expand(h, tr.regs))
  have c := mp(all_elim(r, {g}), hd)
  have c2 := rewrite(he, c)
  show by simp(c2)
qed

// ----------------------------------------------------------------------
//  The instructions, at a point (the at_ADDR fact: the bytes at a decode
//  to the instruction): from the claim after, the claim before

// neg r32: g := 0 - u
theorem tr.neg32: all s v base code fr a a2 len g z u hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(64, pair(4, pair(3, pair(tag(0, g), z))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> g in dom(rs) -> app(rs, g) = pair(4, u) ->
  tr.pt(s, v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(4, bits_sub(32, 0, u))), p, w) -> tr.pt(s, v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g z u hs ds rs p w
  assume hat ha2 hg hd hu hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bits_sub(32, 0, u))), empty)) proof
    fix m o
    assume hi hr hh hrs ho
    have ipM ipU ipC _ := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {4}, {u}, hrs, hd, hu)
    have hx := mp(mp(mp(all_elim(hat, {m}, {o}), ho), ipC), hr)
    obtain f, hf from apply(x86i.neg32, {m}, {o}, {g}, {z}, {len}, ipM, ipU, gR, hx)
    show by ex_intro({f}, simp(hf, rg, hr, ha2, keep(x86i.flags_ok)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_sub(32, 0, u) in bits(int_mul(8, 4)) && bits_sub(32, 0, u) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step, {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {bits_sub(32, 0, u)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// shr r32, c: g := u >> c
theorem tr.shr32: all s v base code fr a a2 len g z c u hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(72, pair(4, pair(5, pair(tag(0, g), pair(z, c)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> c in omega -> int_lt(0, c) -> int_lt(c, 32) -> g in dom(rs) -> app(rs, g) = pair(4, u) ->
  tr.pt(s, v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(4, bits_shr(32, u, c))), p, w) -> tr.pt(s, v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g z c u hs ds rs p w
  assume hat ha2 hg hc hc1 hc2 hd hu hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bits_shr(32, u, c))), empty)) proof
    fix m o
    assume hi hr hh hrs ho
    have ipM ipU ipC _ := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {4}, {u}, hrs, hd, hu)
    have hx := mp(mp(mp(all_elim(hat, {m}, {o}), ho), ipC), hr)
    obtain f, hf from apply(x86i.shr32_imm, {m}, {o}, {g}, {z}, {c}, {len}, ipM, ipU, gR, hc, hc1, hc2, hx)
    show by ex_intro({f}, simp(hf, rg, hr, ha2, keep(x86i.flags_ok)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_shr(32, u, c) in bits(int_mul(8, 4)) && bits_shr(32, u, c) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step, {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {bits_shr(32, u, c)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// imul r32 g, r32 h, k: g := u * k. (The signed product's low 32 bits
// are the unsigned product's, for the immediate k: `tr.imul_by(k)`, linear
// for a literal k. TODO: from the ring laws of int_mul, once, for any k.)
def tr.imul_by(k) := all y. y in bits(32) -> bits_add(32, int_mul(sint(32, y), sint(32, k)), 0) = bits_mul(32, y, k)

theorem tr.imul32: all s v base code fr a a2 len g h z1 z2 k u hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(89, pair(4, pair(g, pair(tag(0, h), pair(z1, pair(z2, k))))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> h in x86_64_linux.Reg -> k in bits(32) -> tr.imul_by(k) -> h in dom(rs) -> app(rs, h) = pair(4, u) ->
  tr.pt(s, v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(4, bits_mul(32, u, k))), p, w) -> tr.pt(s, v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g h z1 z2 k u hs ds rs p w
  assume hat ha2 hg hh hk hkb hd hu hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bits_mul(32, u, k))), empty)) proof
    fix m o
    assume hi hr hhs hrs ho
    have ipM ipU ipC _ := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {h}, {4}, {u}, hrs, hd, hu)
    have u32: u in bits(32) by simp(rg)
    have mu := mp(all_elim(expand(hkb, tr.imul_by), {u}), u32)
    have hx := mp(mp(mp(all_elim(hat, {m}, {o}), ho), ipC), hr)
    obtain f, hf from apply(x86i.imul32_imm, {m}, {o}, {g}, {h}, {z1}, {z2}, {k}, {len}, ipM, ipU, gR, hh, hk, hx)
    show by ex_intro({f}, simp(hf, rg, mu, hr, ha2, keep(x86i.flags_ok)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_mul(32, u, k) in bits(int_mul(8, 4)) && bits_mul(32, u, k) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step, {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {bits_mul(32, u, k)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// mov r32 h, r32 g: h := u (zero-extended: the same value)
theorem tr.mov32_rr: all s v base code fr a a2 len g h z1 z2 u hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(75, pair(4, pair(g, pair(tag(0, h), pair(z1, z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(h) -> g in x86_64_linux.Reg -> g in dom(rs) -> app(rs, g) = pair(4, u) ->
  tr.pt(s, v, base, code, fr, a2, hs, ds, fn_update(rs,h, pair(4, u)), p, w) -> tr.pt(s, v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g h z1 z2 u hs ds rs p w
  assume hat ha2 hh hg hd hu hpt
  have hR: h in x86_64_linux.Reg by taut(expand(hh, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(app(m, "gpr"), h, u)), empty) proof
    fix m o
    assume hi hr hhs hrs ho
    have ipM ipU ipC _ := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {4}, {u}, hrs, hd, hu)
    have hx := mp(mp(mp(all_elim(hat, {m}, {o}), ho), ipC), hr)
    have e := apply(x86i.mov32_rr, {m}, {o}, {g}, {h}, {z1}, {z2}, {len}, ipM, ipU, hg, hR, hx)
    show by simp(e, rg, hr, ha2)
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      u in bits(int_mul(8, 4)) && u in bits(64) proof
    fix m
    assume hi hr hhs hrs
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {4}, {u}, hrs, hd, hu)
    show by simp(rg)
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0, {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {h}, {4}, {u}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hh, ty, hpt)
qed

// lea r64 g, [rip + d]: g := the address bigA (rip past the instruction, plus d)
theorem tr.lea_rip: all s v base code fr a a2 len g d z1 z2 z3 biga hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(78, pair(8, pair(g, pair(z1, pair(z2, pair(z3, fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(1, empty)), "index", none), "scale", 1), "disp", d)))))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> d in bits(64) -> biga = bits_add(64, int_add(a2, d), 0) ->
  tr.pt(s, v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(8, biga)), p, w) -> tr.pt(s, v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g d c z1 z2 z3 biga hs ds rs p w
  assume hat: all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(78, pair(8, pair(g, pair(z1, pair(z2, pair(z3, fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(1, empty)), "index", none), "scale", 1), "disp", d)))))))), m, o)
  assume ha2: a2 = bits_add(64, a, len)
  assume hg: tr.scratch_reg(g)
  assume hd: d in bits(64)
  assume hA: biga = bits_add(64, int_add(a2, d), 0)
  assume hpt: tr.pt(s, v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(8, biga)), p, w)
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(app(m, "gpr"), g, biga)), empty) proof
    fix m o
    assume hi hr hhs hrs ho
    have ipM ipU ipC _ := apply(tr.inv_parts, hi)
    have hx := mp(mp(mp(all_elim(hat, {m}, {o}), ho), ipC), hr)
    have e := apply(x86i.lea_rip, {m}, {o}, {g}, {d}, {z1}, {z2}, {z3}, {len}, ipM, ipU, gR, hd, hx)
    show by simp(e, hr, ha2, hA)
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      biga in bits(int_mul(8, 8)) && biga in bits(64) proof
    fix m
    show by simp(hA, keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0, {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {8}, {biga}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// movsx r32 g, r8 h: g := the byte b sign-extended
theorem tr.movsx8: all s v base code fr a a2 len g h z2 b hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(81, pair(4, pair(g, pair(tag(0, h), pair(tag(0, h), z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> h in x86_64_linux.Reg -> int_lt(h, 4) -> h in dom(rs) -> app(rs, h) = pair(1, b) ->
  tr.pt(s, v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(4, bits_sext(8, 32, b))), p, w) -> tr.pt(s, v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g h z2 b hs ds rs p w
  assume hat ha2 hg hh hh4 hd hb hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(app(m, "gpr"), g, bits_sext(8, 32, b))), empty) proof
    fix m o
    assume hi hr hhs hrs ho
    have ipM ipU ipC _ := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {h}, {1}, {b}, hrs, hd, hb)
    have hx := mp(mp(mp(all_elim(hat, {m}, {o}), ho), ipC), hr)
    have e := apply(x86i.movsx8_rr, {m}, {o}, {g}, {h}, {z2}, {len}, ipM, ipU, gR, hh, hh4, hx)
    show by simp(e, rg, hr, ha2)
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_sext(8, 32, b) in bits(int_mul(8, 4)) && bits_sext(8, 32, b) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0, {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {bits_sext(8, 32, b)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// movsxd r64 g, r32 h (h holding u): g := u sign-extended
theorem tr.movsxd: all s v base code fr a a2 len g h z1 z2 u hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(113, pair(g, pair(tag(0, h), pair(z1, z2))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> h in x86_64_linux.Reg -> h in dom(rs) -> app(rs, h) = pair(4, u) ->
  tr.pt(s, v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(8, bits_sext(32, 64, u))), p, w) -> tr.pt(s, v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g h z1 z2 u hs ds rs p w
  assume hat ha2 hg hh hd hb hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(app(m, "gpr"), g, bits_sext(32, 64, u))), empty) proof
    fix m o
    assume hi hr hhs hrs ho
    have ipM ipU ipC _ := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {h}, {4}, {u}, hrs, hd, hb)
    have hx := mp(mp(mp(all_elim(hat, {m}, {o}), ho), ipC), hr)
    have e := apply(x86i.movsxd_rr, {m}, {o}, {g}, {h}, {z1}, {z2}, {len}, ipM, ipU, gR, hh, hx)
    show by simp(e, rg, hr, ha2)
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_sext(32, 64, u) in bits(int_mul(8, 8)) && bits_sext(32, 64, u) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0, {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {8}, {bits_sext(32, 64, u)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// mov r32 g, [rsp + d] (a home holding x): g := x
theorem tr.load32_home: all s v base code fr a a2 len g d c z1 z2 x hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(76, pair(4, pair(g, pair(x86i.rsp_mem(d), pair(z1, z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> d in bits(64) -> c = int_mod(int_sub(d, fr), 18446744073709551616) -> c in bits(64) ->
  int_le(18446744073709551608, c) -> int_le(4, int_sub(18446744073709551616, c)) -> c in dom(hs) -> app(hs, c) = pair(4, x) ->
  tr.pt(s, v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(4, x)), p, w) -> tr.pt(s, v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g d c z1 z2 x hs ds rs p w
  assume hat ha2 hg hd hcd hc hd1 hd2 hdh hx hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(app(m, "gpr"), g, x)), empty) proof
    fix m o
    assume hi hr hhs hrs ho
    have ipM ipU ipC _ := apply(tr.inv_parts, hi)
    have ac := apply(tr.home_acc, {s}, {base}, {code}, {fr}, {m}, {w}, {d}, {c}, {4}, hi, hd, hcd, hc, hd1, hd2)
    have hv := apply(tr.home_read, {s}, {base}, {code}, {fr}, {m}, {w}, {hs}, {d}, {c}, {4}, {x}, hi, hhs, hd, hcd, hdh, hx)
    have hx2 := mp(mp(mp(all_elim(hat, {m}, {o}), ho), ipC), hr)
    have e := apply(x86i.load32_rsp, {m}, {o}, {g}, {d}, {z1}, {z2}, {len}, ipM, ipU, gR, hd, taut(ac), hx2)
    show by simp(e, hv, ipM, ipU, ipC, hr, ha2, keep(abi.code_at, x86_64_linux.Machine))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> x in bits(int_mul(8, 4)) && x in bits(64) proof
    fix m
    assume hi hr hhs hrs
    have hv := apply(tr.homes_get, {s}, {m}, {hs}, {c}, {4}, {x}, hhs, hdh, hx)
    show by simp(sym(hv))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0, {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {x}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// and r32 g, [rsp + d] (g holding u, the home x): g := x & u (the home's
// operand first, as the source's `x & u`)
theorem tr.and32_home: all s v base code fr a a2 len g d c z1 z2 x u hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(48, pair(4, pair(g, pair(x86i.rsp_mem(d), pair(z1, z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> d in bits(64) -> c = int_mod(int_sub(d, fr), 18446744073709551616) -> c in bits(64) ->
  int_le(18446744073709551608, c) -> int_le(4, int_sub(18446744073709551616, c)) -> c in dom(hs) -> app(hs, c) = pair(4, x) -> g in dom(rs) -> app(rs, g) = pair(4, u) ->
  tr.pt(s, v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(4, bits_and(32, x, u))), p, w) -> tr.pt(s, v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g d c z1 z2 x u hs ds rs p w
  assume hat ha2 hg hd hcd hc hd1 hd2 hdh hx hgr hu hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bits_and(32, x, u))), empty)) proof
    fix m o
    assume hi hr hhs hrs ho
    have ipM ipU ipC _ := apply(tr.inv_parts, hi)
    have ac := apply(tr.home_acc, {s}, {base}, {code}, {fr}, {m}, {w}, {d}, {c}, {4}, hi, hd, hcd, hc, hd1, hd2)
    have hv := apply(tr.home_read, {s}, {base}, {code}, {fr}, {m}, {w}, {hs}, {d}, {c}, {4}, {x}, hi, hhs, hd, hcd, hdh, hx)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {4}, {u}, hrs, hgr, hu)
    have hx2 := mp(mp(mp(all_elim(hat, {m}, {o}), ho), ipC), hr)
    obtain f, hf from apply(x86i.and32_rsp, {m}, {o}, {g}, {d}, {z1}, {z2}, {len}, ipM, ipU, gR, hd, taut(ac), hx2)
    have cm := all_elim(x86.and_comm, {32}, {u}, {x})
    show by ex_intro({f}, simp(hf, hv, rg, ipM, ipU, ipC, hr, ha2, cm, keep(x86i.flags_ok, abi.code_at, x86_64_linux.Machine)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_and(32, x, u) in bits(int_mul(8, 4)) && bits_and(32, x, u) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step, {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {bits_and(32, x, u)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// ----------------------------------------------------------------------
//  The spec's side. A point's program is the function's wrapper around the
//  procedure's rest q: `mkprog(x1 x2. bind_rel(q, x1, kw, exc, div))`, kw
//  the wrapper's continuation (the return of the procedure's result); the
//  statements reduce q.

// (a program's relation weakened: its runs; bind_rel's program weakened)
theorem tr.mkprog_mono(s, x y. r1, x y. r2): (all o. r2(s, o) -> r1(s, o)) -> (all o. runs(mkprog(x y. r2(x, y)), s, o) -> runs(mkprog(x y. r1(x, y)), s, o))
proof
  assume h
  fix o
  assume hr
  have hu: pair(s, o) in univ(1) && r2(s, o) by simp(expand(expand(hr, runs), mkprog))
  have r: r1(s, o) := mp(all_elim(h, {o}), taut(hu))
  show by defs(simp(hu, r), runs, mkprog)
qed

theorem tr.bind_mono(p, p2, s, s1 v. k, s1 e. x, t. d): (all o. runs(p2, s, o) -> runs(p, s, o)) ->
  bind_rel(p2, s, s1 v. k(s1, v), s1 e. x(s1, e), t. d(t)) -> bind_rel(p, s, s1 v. k(s1, v), s1 e. x(s1, e), t. d(t))
proof
  assume hp hb
  obtain o, ho from expand(hb, bind_rel)
  have r := mp(all_elim(hp, {o}), taut(ho))
  show by defs(ex_intro({o}, taut(r, ho)), bind_rel)
qed

// q reduced to q2 (every outcome of q2 one of q): the point's claim for q2
// gives it for q
theorem tr.wred(s, v, base, code, fr, a, hs, ds, rs, w,q, q2, x3 x4 x2. kw):
  (all o. runs(q2, w, o) -> runs(q, w, o)) ->
  tr.pt(s, v, base, code, fr, a, hs, ds, rs, mkprog(x1 x2. bind_rel(q2, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w) ->
  tr.pt(s, v, base, code, fr, a, hs, ds, rs, mkprog(x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w)
proof
  assume hq hpt
  have r0: all o. runs(mkprog(x1 x2. bind_rel(q2, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, o) ->
      runs(mkprog(x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, o) proof
    fix o
    have bm: all o0. bind_rel(q2, w, x3 x4. kw(x3, x4, o0), x3 x4. o0 = exc(x3, x4), x3. o0 = diverge(x3)) ->
        bind_rel(q, w, x3 x4. kw(x3, x4, o0), x3 x4. o0 = exc(x3, x4), x3. o0 = diverge(x3)) proof
      fix o0
      assume hb
      show := apply(tr.bind_mono[p := q, p2 := q2, s := w, k := s1 v. kw(s1, v, o0), x := s1 e. o0 = exc(s1, e), d := t. o0 = diverge(t)], hq, hb)
    qed
    show := all_elim(mp(tr.mkprog_mono[s := w, r1 := x y. bind_rel(q, x, x3 x4. kw(x3, x4, y), x3 x4. y = exc(x3, x4), x3. y = diverge(x3)),
      r2 := x y. bind_rel(q2, x, x3 x4. kw(x3, x4, y), x3 x4. y = exc(x3, x4), x3. y = diverge(x3))], bm), {o})
  qed
  have r: tr.red(mkprog(x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w,
      mkprog(x1 x2. bind_rel(q2, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w) by defs(r0, tr.red)
  have g: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, ds) ->
      tr.sim(s, v, mkprog(x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, m) proof
    fix m
    assume hi hr hh hrs hmm
    have c := mp(mp(mp(mp(mp(all_elim(expand(hpt, tr.pt), {m}), hi), hr), hh), hrs), hmm)
    show := apply(tr.sim_red, r, c)
  qed
  show by defs(g, tr.pt)
qed

// the procedure's return: the wrapper goes on with its result
theorem tr.wret(s, v, base, code, fr, a, hs, ds, rs, w,val, x3 x4 x2. kw): val in univ(1) ->
  tr.pt(s, v, base, code, fr, a, hs, ds, rs, mkprog(x1 x2. kw(x1, val, x2)), w) ->
  tr.pt(s, v, base, code, fr, a, hs, ds, rs, mkprog(x1 x2. bind_rel(mkprog(y0 y1. y1 = ok(y0, val)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w)
proof
  assume hv hpt
  have g: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, ds) ->
      tr.sim(s, v, mkprog(x1 x2. bind_rel(mkprog(y0 y1. y1 = ok(y0, val)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, m) proof
    fix m
    assume hi hr hh hrs hmm
    have wu := hi.wu
    // (the procedure's run: ok(w, val))
    have pr: runs(mkprog(y0 y1. y1 = ok(y0, val)), w, ok(w, val)) by defs(simp(wu, hv), runs, mkprog)
    have k: all o. kw(w, val, o) -> bind_rel(mkprog(y0 y1. y1 = ok(y0, val)), w, x3 x4. kw(x3, x4, o), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) proof
      fix o
      assume h
      have e: ex o2. runs(mkprog(y0 y1. y1 = ok(y0, val)), w, o2) && ((ex s1 v1. o2 = ok(s1, v1) && kw(s1, v1, o)) || (ex s1 e. o2 = exc(s1, e) && o = exc(s1, e)) || (ex t. o2 = diverge(t) && o = diverge(t)))
        by ex_intro({ok(w, val)}, simp(pr, h, wu, hv))
      show by defs(e, bind_rel)
    qed
    have r0 := mp(tr.mkprog_mono[s := w, r1 := x1 x2. bind_rel(mkprog(y0 y1. y1 = ok(y0, val)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)),
      r2 := x1 x2. kw(x1, val, x2)], k)
    have r: tr.red(mkprog(x1 x2. bind_rel(mkprog(y0 y1. y1 = ok(y0, val)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w,
      mkprog(x1 x2. kw(x1, val, x2)), w) by defs(r0, tr.red)
    have c := mp(mp(mp(mp(mp(all_elim(expand(hpt, tr.pt), {m}), hi), hr), hh), hrs), hmm)
    show := apply(tr.sim_red, r, c)
  qed
  show by defs(g, tr.pt)
qed

// a run of a program given by its relation
theorem tr.runs_intro(x y. r): all s o. pair(s, o) in univ(1) -> r(s, o) -> runs(mkprog(x y. r(x, y)), s, o)
proof
  fix s o
  assume hu hr
  show by defs(simp(hu, hr), runs, mkprog)
qed

// (a world, with no ghost state)
theorem tr.world_and: all w. w in abi.World -> w in rec_and(abi.World, single(empty))
proof
  fix w
  assume hw
  have r := mp(mp(rec_and_intro[a := abi.World, b := single(empty), x := w, y := empty], hw), simp())
  show by simp(r)
qed

// the spec raising (undefined behaviour) from the world w: the claim, at
// any point
theorem tr.wub(s, v, base, code, fr, a, hs, ds, rs, w,q, x3 x4 x2. kw): runs(q, w, exc(w, empty)) ->
  tr.pt(s, v, base, code, fr, a, hs, ds, rs, mkprog(x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w)
proof
  assume hq
  have g: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, ds) ->
      tr.sim(s, v, mkprog(x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, m) proof
    fix m
    assume hi hr hh hrs hmm
    have wu := hi.wu
    have wa := apply(tr.world_and, hi.wW)
    have pu: pair(w, exc(w, empty)) in univ(1) by simp(wu)
    have b: bind_rel(q, w, x3 x4. kw(x3, x4, exc(w, empty)), x3 x4. exc(w, empty) = exc(x3, x4), x3. exc(w, empty) = diverge(x3))
      by defs(ex_intro({exc(w, empty)}, simp(hq, keep(runs))), bind_rel)
    have rp := mp(mp(all_elim(tr.runs_intro[r := x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))], {w}, {exc(w, empty)}), pu), b)
    have eu: empty in univ(1) by simp()
    have eno: !(empty = exc_val("stack_overflow", empty)) by defs(all_elim(tr.pair_ne, {"stack_overflow"}, {empty}), exc_val)
    have ub: tr.ub(s, v, mkprog(x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w) proof
      have rs: abi.raise_state(w) by defs(wa, abi.raise_state)
      show by defs(ex_intro({empty}, {w}, taut(eu, eno, rs, rp)), tr.ub)
    qed
    show by defs(simp(ub, keep(tr.ub, tr.ok, tr.crash, tr.run_d)), tr.sim)
  qed
  show by defs(g, tr.pt)
qed

// the machine's byte read, GIMPLE's
theorem tr.le_bytes1: all vm a. x86_64_linux.le(app(vm, "bytes"), a, 1) = bits_of_int(8, gimple.bytes_at(vm, a, 1))
proof
  fix vm a
  show by defs(simp(), x86_64_linux.le, gimple.bytes_at)
qed

// ----------------------------------------------------------------------
//  The return: `ret` with rax holding the spec's result (the spec returning
//  it, rdx anything)

theorem tr.ret_insn: all s v base code a len hs rs p w n bigv.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a -> runs(x86_64_linux.exec_body(len, tag(122, empty)), m, o)) ->
  0 in dom(rs) -> app(rs, 0) = pair(n, bigv) ->
  (w in univ(1) -> bigv in bits(int_mul(8, n)) -> (all y. y in bits(64) -> runs(p, w, ok(w, pair(bigv, y))))) ->
  tr.pt(s, v, base, code, 0, a, hs, v, rs, p, w)
proof
  fix s v base code a len hs rs p w n bigv
  assume hat h0d h0 hsp
  have g: all m. tr.inv(s, base, code, 0, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.sim(s, v, p, w, m) proof
    fix m
    assume hi hr hhs hrs hmm
    have {mM, mu, cd, kp, ra8, mcs, mcpu, mgs, mos, mfs, mdf, wW, wu, sM, sacc, sal, slt} := hi
    have rspm := apply(tr.inv0_rsp, hi)
    have rest: x86_64_linux.le(app(app(m, "vm"), "bytes"), app(app(s, "gpr"), 4), 8) = abi.ret(s) && abi.callee_saved(m, s) && app(m, "cpu") = app(s, "cpu") && app(m, "gs_base") = app(s, "gs_base") &&
      app(m, "os") = app(w, "os") && app(m, "fs_base") = app(w, "fs_base") && !app(app(m, "flags"), "df") && w in abi.World && w in univ(1)
      := conj(ra8, mcs, mcpu, mgs, mos, mfs, mdf, wW, wu)
    have r4 := apply(x86i.rsp_typed, sM)
    // (the return address's 8 bytes: readable)
    have ra := apply(abi.ret_access, {app(s, "vm")}, {app(app(s, "gpr"), 4)}, r4, sacc, sal)
    have acc: all j. j in omega -> int_lt(j, 8) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, app(app(m, "gpr"), 4), bits_of_int(64, j)), 0) proof
      fix j
      assume j1 j2
      have c1 := mp(mp(all_elim(ra, {j}), j1), j2)
      have jr1 jr2 jr3 := apply(tr.ret_range, {app(app(s, "gpr"), 4)}, {j}, r4, slt, j1, j2)
      have c3 := apply(tr.kept_acc, {app(s, "vm")}, {app(m, "vm")}, {app(app(s, "gpr"), 4)}, {bits_add(64, app(app(s, "gpr"), 4), bits_of_int(64, j))}, {0}, kp,
        jr1, jr2, jr3, c1)
      show by simp(c3, rspm)
    qed
    let M2 := fn_update(fn_update(m, "gpr", fn_update(app(m, "gpr"), 4, bits_add(64, app(app(m, "gpr"), 4), 8))), "rip", x86_64_linux.le(app(app(m, "vm"), "bytes"), app(app(m, "gpr"), 4), 8))
    have st: all o. runs(x86_64_linux.step(), m, o) -> (ex m2. o = ok(m2, empty) && m2 = M2) proof
      fix o
      assume ho
      have hx := mp(mp(mp(all_elim(hat, {m}, {o}), ho), cd), hr)
      have e := apply(x86i.ret, {m}, {o}, {len}, mM, mu, acc, hx)
      show by ex_intro({M2}, simp(e))
    qed
    have nr := apply(tr.inv_nr, hi)
    // (at M2: the return point, the spec's result)
    have post: all m2. m2 = M2 -> tr.sim(s, v, p, w, m2) proof
      fix m2
      assume e2
      have pt := apply(x86i.parts, mM)
      have r0 := apply(tr.regs_get, {m}, {rs}, {0}, {n}, {bigv}, hrs, h0d, h0)
      have r2R: 2 in x86_64_linux.Reg by simp()
      have r2t := mp(mp(all_elim(x86i.reg_typed, {m}, {2}), mM), r2R)
      have atr: tr.at_ret(s, M2) by simp(rest, rspm, r4)
      have lt: x86_64_linux.le(app(app(m, "vm"), "bytes"), app(app(m, "gpr"), 4), 8) in bits(64) by simp()
      have m2M: M2 in x86_64_linux.Machine by defs(simp(expand(mM, x86_64_linux.Machine), mu, pt, lt, r4, rspm), x86_64_linux.Machine)
      have sp := mp(mp(hsp, wu), r0.2)
      have rr: runs(p, w, ok(w, pair(app(app(M2, "gpr"), 0), app(app(M2, "gpr"), 2)))) by simp(sp, r0, r2t)
      have wm := apply(tr.mem_wm, {s}, {m}, {w}, {v}, hmm)
      have wm2: abi.world_matches(app(s, "vm"), app(M2, "vm"), app(w, "vm"), v, abi.sp(s)) by simp(wm, keep(abi.world_matches))
      have e3 := mp(app_update_other[f := app(m, "gpr"), k := 4, v := bits_add(64, app(app(m, "gpr"), 4), 8), x := 3], simp())
      have e5 := mp(app_update_other[f := app(m, "gpr"), k := 4, v := bits_add(64, app(app(m, "gpr"), 4), 8), x := 5], simp())
      have e12 := mp(app_update_other[f := app(m, "gpr"), k := 4, v := bits_add(64, app(app(m, "gpr"), 4), 8), x := 12], simp())
      have e13 := mp(app_update_other[f := app(m, "gpr"), k := 4, v := bits_add(64, app(app(m, "gpr"), 4), 8), x := 13], simp())
      have e14 := mp(app_update_other[f := app(m, "gpr"), k := 4, v := bits_add(64, app(app(m, "gpr"), 4), 8), x := 14], simp())
      have e15 := mp(app_update_other[f := app(m, "gpr"), k := 4, v := bits_add(64, app(app(m, "gpr"), 4), 8), x := 15], simp())
      have cs: abi.callee_saved(M2, s) by simp(rest, e3, e5, e12, e13, e14, e15)
      have oth: app(M2, "os") = app(w, "os") && app(M2, "fs_base") = app(w, "fs_base") && app(M2, "cpu") = app(s, "cpu") && app(M2, "gs_base") = app(s, "gs_base") &&
        !app(app(M2, "flags"), "df") && w in abi.World by simp(rest, keep(abi.World))
      have gu := mp(app_univ[u := 1, f := m, k := "gpr"], mu)
      have m2u: M2 in univ(1) by simp(mu, gu, lt, r4)
      have c := apply(tr.ret, {s}, {v}, {p}, {w}, {M2}, {w}, atr, m2M, m2u, rr, taut(rest), wu, wm2, taut(oth), taut(oth), taut(oth), taut(oth), cs, taut(oth))
      show := rewrite(sym(e2), c)
    qed
    show := mp(mp(mp(tr.step[s := s, v := v, p := p, w := w, m := m, q := x. x = M2], st), nr), post)
  qed
  show by defs(g, tr.pt)
qed

// the wrapper's return of a 32-bit result: (result, any 64-bit rdx)
theorem tr.result32: all w bigv. w in univ(1) -> bigv in bits(int_mul(8, 4)) -> (all y. y in bits(64) ->
  runs(mkprog(x1 x2. letin(bigv, x5. bind_rel(gimple.result(32, x5), x1, x6 x7. any_rel(x8. x8 in bits(64), x8. x2 = ok(x6, pair(x7, x8))), x6 x7. x2 = exc(x6, x7), x6. x2 = diverge(x6)))), w, ok(w, pair(bigv, y))))
proof
  fix w bigv
  assume hw hb
  fix y
  assume hy
  have b32: bigv in bits(32) by simp(hb)
  have ro := apply(g.result_ok, {w}, {bigv}, hw, b32)
  have k: bind_rel(gimple.result(32, bigv), w, x6 x7. any_rel(x8. x8 in bits(64), x8. ok(w, pair(bigv, y)) = ok(x6, pair(x7, x8))), x6 x7. ok(w, pair(bigv, y)) = exc(x6, x7), x6. ok(w, pair(bigv, y)) = diverge(x6))
    by defs(ex_intro({ok(w, bigv)}, simp(ro, hy, keep(runs, gimple.result))), bind_rel)
  have pu: pair(w, ok(w, pair(bigv, y))) in univ(1) by simp(hw, b32, hy)
  have r := mp(mp(all_elim(tr.runs_intro[r := x1 x2. letin(bigv, x5. bind_rel(gimple.result(32, x5), x1, x6 x7. any_rel(x8. x8 in bits(64), x8. x2 = ok(x6, pair(x7, x8))), x6 x7. x2 = exc(x6, x7), x6. x2 = diverge(x6)))],
    {w}, {ok(w, pair(bigv, y))}), pu), defs(k, letin))
  show := r
qed

// the 4 bytes just stored, read back
theorem tr.le_store4: all b a x. b in fn_space(bits(64), bits(8)) -> a in bits(64) -> x in omega ->
  x86_64_linux.le(x86_64_linux.store_le(b, a, 4, x), a, 4) = bits_of_int(32, x)
proof
  fix b a x
  assume hb ha hx
  show by simp(hb, ha, hx)
qed

// ----------------------------------------------------------------------
//  The entry: the world s's (abi.view(s, v, mem), v the callers' stack
//  objects); the prologue's store of the parameter to its home (n bytes of
//  x at rsp + d) is the machine's (tr.view1: its memory after it), outside
//  the world's domain

abbrev tr.view1(s, d, n, x) := fn_update(app(s, "vm"), "bytes", x86_64_linux.store_le(app(app(s, "vm"), "bytes"), bits_add(64, app(app(s, "gpr"), 4), d), n, x))

theorem tr.view1_ok: all s d n x. s in x86_64_linux.Machine -> s in univ(1) -> n in omega -> x in omega ->
  tr.view1(s, d, n, x) in x86_64_linux.Vm && tr.view1(s, d, n, x) in univ(1)
proof
  fix s d n x
  assume hM hu hn0 hx
  have pt := apply(x86i.parts, hM)
  have vm: app(s, "vm") in x86_64_linux.Vm by taut(pt)
  have vu: tr.view1(s, d, n, x) in univ(1) by simp(hu, hx, hn0, x86.store_typed, pt)
  have vV := apply(x86.store_vm, {app(s, "vm")}, {bits_add(64, app(app(s, "gpr"), 4), d)}, {n}, {x}, vm, vu)
  show := conj(vV, vu)
qed

// the coupling at the entry: the world the machine's, with the callers'
// stack objects v
theorem tr.mem_entry: all s v mem. tr.objs_ok(s, v) -> abi.view_ok(s, v, mem) -> tr.mem(s, s, abi.view(s, v, mem), v)
proof
  fix s v mem
  assume ho hv
  have wm2: abi.world_matches(app(s, "vm"), app(s, "vm"), app(abi.view(s, v, mem), "vm"), v, abi.sp(s)) by simp(hv.2, keep(abi.world_matches))
  have e: app(abi.view(s, v, mem), "objs") = v by simp()
  have oa: all x. x in omega -> x in v -> (int_le(abi.sp(s), x) && abi.stack_page(app(s, "vm"), int_div(x, x86_64_linux.PAGE))) && x86_64_linux.can_access(app(s, "vm"), bits_of_int(64, x), 1) proof
    fix x
    assume h1 h2
    have c := mp(all_elim(expand(ho, tr.objs_ok), {x}), h1, h2)
    show by taut(c)
  qed
  show by defs(taut(e, wm2, oa), tr.mem)
qed

// (the slot's address, in the slot lemmas' form)
theorem tr.slot_ea: all sp d. sp in bits(64) -> d in bits(64) -> bits_add(64, int_add(sp, d), 0) = bits_add(64, sp, d)
proof
  fix sp d
  assume hs hd
  have p64: pow2(64) = 18446744073709551616 by simp()
  have sb: int_le(0, sp) && int_lt(sp, 18446744073709551616) by simp(hs)
  have db: int_le(0, d) && int_lt(d, 18446744073709551616) by simp(hd)
  have e0: int_mod(int_add(int_add(sp, d), 0), 18446744073709551616) = int_mod(int_add(sp, d), 18446744073709551616) by arith(sb, db)
  show by defs(rewrite(sym(p64), e0), bits_add)
qed

// (the 8 bytes below rsp and the 8 above: rsp's page -- rsp + 8 16-aligned)
theorem tr.page_near: all sp a. sp in bits(64) -> int_mod(bits_add(64, sp, 8), 16) = 0 -> int_lt(sp, 140737488355328) ->
  int_le(int_sub(sp, 8), a) -> int_lt(a, int_add(sp, 8)) -> int_div(a, 4096) = int_div(sp, 4096)
proof
  fix sp a
  assume hs hm hl h1 h2
  have p64: pow2(64) = 18446744073709551616 by simp()
  have sb: int_le(0, sp) by simp(hs)
  have e0: int_mod(int_add(sp, 8), 18446744073709551616) = int_add(sp, 8) by arith(sb, hl)
  have e: bits_add(64, sp, 8) = int_add(sp, 8) by defs(rewrite(sym(p64), e0), bits_add)
  have m8: int_mod(int_add(sp, 8), 16) = 0 := rewrite(e, hm)
  show by arith(hs, m8, h1, h2)
qed

// a store to the n bytes at sp + c (c from -8): only the 8 bytes below sp
theorem tr.slot_out8: all b sp c n x a. sp in bits(64) -> int_le(8, sp) -> int_lt(sp, 140737488355328) ->
  c in bits(64) -> int_le(18446744073709551608, c) -> int_le(n, int_sub(18446744073709551616, c)) ->
  a in bits(64) -> !(int_le(int_sub(sp, 8), a) && int_lt(a, sp)) -> app(x86_64_linux.store_le(b, bits_add(64, sp, c), n, x), a) = app(b, a)
proof
  fix b sp c n x a
  assume h1 h8 h4 hc hk hn ha hs
  have p64: pow2(64) = 18446744073709551616 by simp()
  have sb: int_le(0, sp) && int_lt(sp, 18446744073709551616) by simp(h1)
  have cb: int_le(0, c) && int_lt(c, 18446744073709551616) by simp(hc)
  have ab: int_le(0, a) && int_lt(a, 18446744073709551616) by simp(ha)
  have e0: int_mod(int_sub(a, int_mod(int_add(sp, c), 18446744073709551616)), 18446744073709551616) = int_mod(int_add(int_sub(a, sp), int_sub(18446744073709551616, c)), 18446744073709551616) by arith(sb, cb, ab)
  have nl0: !int_lt(int_mod(int_add(int_sub(a, sp), int_sub(18446744073709551616, c)), 18446744073709551616), n) by arith(sb, cb, ab, h8, h4, hk, hn, hs)
  have nl1 := rewrite(sym(e0), nl0)
  have nl: !int_lt(bits_sub(64, a, bits_add(64, sp, c)), n) by defs(rewrite(sym(p64), nl1), bits_sub, bits_add)
  have ab2 := mp(app_fn_build[d := bits(64), v := y. ite(int_lt(bits_sub(64, y, bits_add(64, sp, c)), n), bits_of_int(8, int_div(x, int_pow(256, bits_sub(64, y, bits_add(64, sp, c))))), app(b, y)), a := a], ha)
  have itf := mp(ite_f[c := int_lt(bits_sub(64, a, bits_add(64, sp, c)), n), a := bits_of_int(8, int_div(x, int_pow(256, bits_sub(64, a, bits_add(64, sp, c))))), b := app(b, a)], nl)
  show by defs(trans(ab2, itf), x86_64_linux.store_le)
qed

// (a memory's page-only facts: the same with the same pages)
theorem tr.acc_pages: all v1 v2 a k. app(v2, "pages") = app(v1, "pages") -> x86_64_linux.can_access(v1, a, k) -> x86_64_linux.can_access(v2, a, k)
proof
  fix v1 v2 a k
  assume e hc
  have c := expand(expand(hc, x86_64_linux.can_access), x86_64_linux.mapped)
  have c2 := rewrite(sym(e), c)
  show by defs(defs(c2, x86_64_linux.mapped), x86_64_linux.can_access)
qed

theorem tr.sp_pages: all v1 v2 p. app(v2, "pages") = app(v1, "pages") -> abi.stack_page(v2, p) = abi.stack_page(v1, p)
proof
  fix v1 v2 p
  assume e
  show by defs(simp(e), abi.stack_page, x86_64_linux.mapped)
qed

// the coupling after the machine's bytes changed only outside the world's
// domain, below the entry's sp
theorem tr.mem_bytes: all s m m2 w ob b. tr.mem(s, m, w, ob) -> app(m2, "vm") = fn_update(app(m, "vm"), "bytes", b) ->
  (all a. a in bits(64) -> abi.in_domain(app(w, "vm"), ob, a) || int_le(abi.sp(s), a) -> app(b, a) = app(app(app(m, "vm"), "bytes"), a)) ->
  tr.mem(s, m2, w, ob)
proof
  fix s m m2 w ob b
  assume h em hk
  have {wob, wm, oacc} := h
  have {top, limit, brk0, brk, bytes, frames, pages} := wm
  have by2: all x0. x0 in bits(64) -> abi.in_domain(app(w, "vm"), ob, x0) -> app(app(app(m2, "vm"), "bytes"), x0) = app(app(app(w, "vm"), "bytes"), x0) proof
    fix x0
    assume hx hd
    have k := mp(all_elim(hk, {x0}), hx, (abi.in_domain(app(w, "vm"), ob, x0) || int_le(abi.sp(s), x0) by taut(hd)))
    have e := mp(all_elim(bytes, {x0}), hx, hd)
    show by simp(em, k, e)
  qed
  have fr2: all x0. x0 in bits(64) -> (int_le(abi.sp(s), x0) && !abi.in_domain(app(w, "vm"), ob, x0)) && abi.stack_page(app(s, "vm"), x86_64_linux.page_of(x0)) ->
      app(app(app(m2, "vm"), "bytes"), x0) = app(app(app(s, "vm"), "bytes"), x0) proof
    fix x0
    assume hx hf
    have k := mp(all_elim(hk, {x0}), hx, (abi.in_domain(app(w, "vm"), ob, x0) || int_le(abi.sp(s), x0) by taut(hf)))
    have e := mp(all_elim(frames, {x0}), hx, hf)
    show by simp(em, k, e)
  qed
  have pe: app(app(m2, "vm"), "pages") = app(app(m, "vm"), "pages") by simp(em)
  have pg2: all x0. x0 in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) ->
      app(app(app(m2, "vm"), "pages"), x0) = app(app(app(w, "vm"), "pages"), x0) || (app(app(app(w, "vm"), "pages"), x0) = none && abi.stack_page(app(m2, "vm"), x0)) proof
    fix x0
    assume hx
    have c := mp(all_elim(pages, {x0}), hx)
    have sq := all_elim(tr.sp_pages, {app(m, "vm")}, {app(m2, "vm")}, {x0})
    have sq2 := mp(sq, pe)
    show := rewrite(sym(sq2), rewrite(sym(pe), c))
  qed
  have wm2: abi.world_matches(app(s, "vm"), app(m2, "vm"), app(w, "vm"), ob, abi.sp(s)) by defs(simp(em, top, limit, brk0, brk, rewrite(em, by2), rewrite(em, fr2), rewrite(em, pg2), keep(abi.in_domain, abi.stack_page)), abi.world_matches)
  have oa2: all x. x in omega -> x in ob -> (int_le(abi.sp(s), x) && abi.stack_page(app(s, "vm"), int_div(x, x86_64_linux.PAGE))) && x86_64_linux.can_access(app(m2, "vm"), bits_of_int(64, x), 1) proof
    fix x
    assume h1 h2
    have c := mp(all_elim(oacc, {x}), h1, h2)
    have ca := apply(tr.acc_pages, {app(m, "vm")}, {app(m2, "vm")}, {bits_of_int(64, x)}, {1}, pe, taut(c))
    show by taut(c, ca)
  qed
  show by defs(taut(wob, wm2, oa2), tr.mem)
qed

// a store to the homes (the 8 bytes below the entry's rsp: on its page, a
// stack page, below its sp -- outside the world's domain): the coupling
// kept
theorem tr.mem_home: all s base code fr mi m m2 w ob d n x. tr.inv(s, base, code, fr, mi, w) -> d in bits(64) -> int_le(18446744073709551608, d) -> int_le(n, int_sub(18446744073709551616, d)) ->
  tr.mem(s, m, w, ob) ->
  app(m2, "vm") = fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), bits_add(64, int_add(app(app(s, "gpr"), 4), d), 0), n, x)) ->
  tr.mem(s, m2, w, ob)
proof
  fix s base code fr mi m m2 w ob d n x
  assume hi hd hd1 hd2 hmm em
  have {sM, sal, hsps, slt, wst} := hi
  have {oacc} := hmm
  have r4 := apply(x86i.rsp_typed, sM)
  have s8 := apply(tr.inv_sp8, hi)
  have nr := apply(tr.sp_lt, {app(app(s, "gpr"), 4)}, r4, slt)
  have se := apply(tr.slot_ea, {app(app(s, "gpr"), 4)}, {d}, r4, hd)
  let B := app(app(m, "vm"), "bytes")
  have k: all a. a in bits(64) -> abi.in_domain(app(w, "vm"), ob, a) || int_le(abi.sp(s), a) ->
      app(x86_64_linux.store_le(B, bits_add(64, int_add(app(app(s, "gpr"), 4), d), 0), n, x), a) = app(B, a) proof
    fix a
    assume ha hda
    // (a home byte: on rsp's page, a stack page of the world; below sp, no object)
    have nh: int_le(int_sub(app(app(s, "gpr"), 4), 8), a) && int_lt(a, app(app(s, "gpr"), 4)) -> false proof
      assume hh
      have pn := apply(tr.page_near, {app(app(s, "gpr"), 4)}, {a}, r4, sal, slt, taut(hh), (int_lt(a, int_add(app(app(s, "gpr"), 4), 8)) by arith(hh)))
      have wp := mp(all_elim(wst, {int_div(app(app(s, "gpr"), 4), 4096)}), hsps)
      have sp1 := expand(hsps, abi.stack_page, x86_64_linux.mapped)
      have nd: !(x86_64_linux.mapped(app(w, "vm"), int_div(a, x86_64_linux.PAGE)) && !(app(snd(app(app(app(w, "vm"), "pages"), int_div(a, x86_64_linux.PAGE))), "kind") = 2))
        by defs(simp(pn, wp, sp1), x86_64_linux.mapped, x86_64_linux.PAGE)
      have no: !(a in ob) proof
        have c: a in ob -> false proof
          assume ho
          have c1 := mp(all_elim(oacc, {a}), simp(ha), ho)
          show by arith(c1, hh, nr)
        qed
        show by taut(c)
      qed
      have nd2: !abi.in_domain(app(w, "vm"), ob, a) by defs(taut(nd, no), abi.in_domain)
      have lo: !int_le(abi.sp(s), a) by arith(hh, nr)
      show by taut(hda, nd2, lo)
    qed
    have o := apply(tr.slot_out8, {B}, {app(app(s, "gpr"), 4)}, {d}, {n}, {x}, {a}, r4, s8, slt, hd, hd1, hd2, ha, taut(nh))
    show := rewrite(sym(se), o)
  qed
  show := apply(tr.mem_bytes, {s}, {m}, {m2}, {w}, {ob}, {x86_64_linux.store_le(B, bits_add(64, int_add(app(app(s, "gpr"), 4), d), 0), n, x)}, hmm, em, k)
qed

// a store to writable bytes leaves the code (not writable)
theorem tr.store_code_acc: all f code vm a n. n in omega -> f in omega -> abi.code_at(vm, f, code) ->
  (all j. j in omega -> int_lt(j, n) -> x86_64_linux.can_access(vm, bits_add(64, a, bits_of_int(64, j)), 1)) ->
  (all v. abi.code_at(fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, n, v)), f, code))
proof
  fix f code vm a n
  assume hn hf hc tw
  have cc := expand(hc, abi.code_at)
  fix v
  have r: all i. i in omega -> int_lt(i, seq_len(code)) ->
      (x86_64_linux.fetchable(fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, n, v)), bits_of_int(64, int_add(f, i))) &&
       !x86_64_linux.can_access(fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, n, v)), bits_of_int(64, int_add(f, i)), 1) &&
       !abi.stack_page(fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, n, v)), x86_64_linux.page_of(bits_of_int(64, int_add(f, i))))) &&
      app(app(fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, n, v)), "bytes"), bits_of_int(64, int_add(f, i))) = app(code, i) proof
    fix i
    assume hi hl
    have ci := mp(mp(all_elim(cc, {i}), hi), hl)
    have co: bits_of_int(64, int_add(f, i)) in bits(64) by defs(simp(hf, hi), bits_of_int, pow2)
    have fe: x86_64_linux.fetchable(vm, bits_of_int(64, int_add(f, i))) by taut(ci)
    have mp0: x86_64_linux.mapped(vm, x86_64_linux.page_of(bits_of_int(64, int_add(f, i)))) by taut(expand(fe, x86_64_linux.fetchable))
    have nw: !x86_64_linux.can_access(vm, bits_of_int(64, int_add(f, i)), 1) by taut(ci)
    have out: all j. j in omega -> int_lt(j, n) -> !(bits_add(64, a, bits_of_int(64, j)) = bits_of_int(64, int_add(f, i))) proof
      fix j
      assume hj hjl
      have tj := mp(mp(all_elim(tw, {j}), hj), hjl)
      have ne0: bits_add(64, a, bits_of_int(64, j)) = bits_of_int(64, int_add(f, i)) -> false proof
        assume eq
        show by taut(rewrite(eq, tj), nw)
      qed
      show by taut(ne0)
    qed
    have so := mp(mp(all_elim(all_elim(all_elim(all_elim(all_elim(x86.store_outside, {app(vm, "bytes")}), {a}), {n}), {v}), {bits_of_int(64, int_add(f, i))}), co), out)
    show by defs(simp(expand(ci, x86_64_linux.fetchable, x86_64_linux.can_access, x86_64_linux.mapped, abi.stack_page), so), x86_64_linux.fetchable, x86_64_linux.can_access, x86_64_linux.mapped, abi.stack_page)
  qed
  show by defs(taut(r), abi.code_at)
qed

theorem tr.keeps_refl: all vm. tr.keeps_code(vm, vm)
proof
  fix vm
  have g: all gb gc st. gb in omega -> abi.loaded(vm, gb, gc, st) -> abi.loaded(vm, gb, gc, st) proof
    fix gb gc st
    assume hb hc
    show := hc
  qed
  show by defs(g, tr.keeps_code)
qed

// (a store to writable bytes keeps the loaded code)
theorem tr.keeps_store: all sv vm a n v. n in omega -> tr.keeps_code(sv, vm) ->
  (all j. j in omega -> int_lt(j, n) -> x86_64_linux.can_access(vm, bits_add(64, a, bits_of_int(64, j)), 1)) ->
  tr.keeps_code(sv, fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, n, v)))
proof
  fix sv vm a n v
  assume hn hk hw
  have g: all gb gc st. gb in omega -> abi.loaded(sv, gb, gc, st) -> abi.loaded(fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, n, v)), gb, gc, st) proof
    fix gb gc st
    assume hb hc
    have c1 := mp(mp(all_elim(expand(hk, tr.keeps_code), {gb}, {gc}, {st}), hb), hc)
    have l1 := expand(c1, abi.loaded)
    have cd: abi.code_at(vm, gb, gc) by taut(l1)
    have sc := apply(tr.store_code_acc, {gb}, {gc}, {vm}, {a}, {n}, hn, hb, cd, hw)
    have cd2 := all_elim(sc, {v})
    have stt: all a0. a0 in omega -> a0 in st -> x86_64_linux.mapped(vm, int_div(a0, x86_64_linux.PAGE)) && !abi.stack_page(vm, int_div(a0, x86_64_linux.PAGE)) by taut(l1)
    have sq: all p. abi.stack_page(fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, n, v)), p) = abi.stack_page(vm, p) proof
      fix p
      show by defs(simp(), abi.stack_page, x86_64_linux.mapped)
    qed
    have mq: all p. x86_64_linux.mapped(fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, n, v)), p) = x86_64_linux.mapped(vm, p) proof
      fix p
      show by defs(simp(), x86_64_linux.mapped)
    qed
    have st2: all a0. a0 in omega -> a0 in st -> x86_64_linux.mapped(fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, n, v)), int_div(a0, x86_64_linux.PAGE)) &&
        !abi.stack_page(fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, n, v)), int_div(a0, x86_64_linux.PAGE)) by simp(stt, sq, mq, keep(abi.stack_page, x86_64_linux.mapped))
    show by defs(taut(cd2, st2), abi.loaded)
  qed
  show by defs(g, tr.keeps_code)
qed

// the prologue `mov [rsp + d], edi`: from the entry s to the state after it,
// coupled with the spec's view (its memory, the home holding x)
theorem tr.prologue1_32: all s v mem base code f len d z1 z2 a2 x p.
  s in x86_64_linux.Machine -> s in univ(1) -> v in set_type(omega) -> tr.objs_ok(s, v) -> mem in x86_64_linux.Vm -> abi.view_ok(s, v, mem) -> base in omega -> abi.code_at(app(s, "vm"), base, code) -> app(s, "rip") = f -> !app(app(s, "flags"), "df") ->
  x86_64_linux.can_access(app(s, "vm"), app(app(s, "gpr"), 4), 1) -> int_mod(bits_add(64, app(app(s, "gpr"), 4), 8), 16) = 0 ->
  abi.stack_page(app(s, "vm"), int_div(app(app(s, "gpr"), 4), 4096)) -> int_lt(app(app(s, "gpr"), 4), 140737488355328) -> abi.stack_gap_free(app(s, "vm")) ->
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = f ->
    runs(x86_64_linux.exec_body(len, tag(75, pair(4, pair(7, pair(x86i.rsp_mem(d), pair(z1, z2)))))), m, o)) ->
  a2 = bits_add(64, f, len) -> d in bits(64) -> int_le(18446744073709551608, d) -> int_le(4, int_sub(18446744073709551616, d)) ->
  bits_of_int(32, app(app(s, "gpr"), 7)) = x ->
  abi.view(s, v, mem) in univ(1) ->
  tr.pt(s, v, base, code, 0, a2, fn_update(empty, d, pair(4, x)), v, empty, p,
    abi.view(s, v, mem)) ->
  tr.sim(s, v, p, abi.view(s, v, mem), s)
proof
  fix s v mem base code f len d z1 z2 a2 x p
  assume hM hu hvo hob hmv hvw hbase hc hrip hdf ca al hsp hlt hgf hat ha2 hd hd1 hd2 hx hvu hpt
  let X := bits_slice(app(app(s, "gpr"), 7), 31, 0)
  let V1 := tr.view1(s, d, 4, X)
  let W := abi.view(s, v, mem)
  let M1 := fn_update(fn_update(s, "rip", a2), "vm", V1)
  have pt := apply(x86i.parts, hM)
  have r4 := apply(x86i.rsp_typed, hM)
  have r7R: 7 in x86_64_linux.Reg by simp()
  have r7 := mp(mp(all_elim(x86i.reg_typed, {s}, {7}), hM), r7R)
  have xo: X in omega by simp(r7)
  have vf := apply(tr.view1_ok, {s}, {d}, {4}, {X}, hM, hu, simp(), xo)
  // (the store's address: the slot lemma's form and the model's)
  have p64: pow2(64) = 18446744073709551616 by simp()
  have ea: all x0. x0 in omega -> bits_add(64, bits_add(64, app(app(s, "gpr"), 4), d), x0) = bits_add(64, int_add(app(app(s, "gpr"), 4), d), x0) proof
    fix x0
    assume h0
    have e2: int_mod(int_add(int_mod(int_add(app(app(s, "gpr"), 4), d), 18446744073709551616), x0), 18446744073709551616) =
      int_mod(int_add(int_add(app(app(s, "gpr"), 4), d), x0), 18446744073709551616) by arith(r4, hd, h0)
    show by defs(rewrite(sym(p64), e2), bits_add)
  qed
  have ea0 := mp(all_elim(ea, {0}), simp())
  have ea1: bits_add(64, int_add(app(app(s, "gpr"), 4), d), 0) = bits_add(64, app(app(s, "gpr"), 4), d) by simp(ea0, r4, hd)
  // (the home's 4 bytes: writable)
  have sa := apply(abi.slot_access, {app(s, "vm")}, {app(app(s, "gpr"), 4)}, {d}, {4}, r4, ca, al, hd, hd1, hd2)
  have sa1: all i. i in omega -> int_lt(i, 4) -> x86_64_linux.can_access(app(s, "vm"), bits_add(64, bits_add(64, app(app(s, "gpr"), 4), d), bits_of_int(64, i)), 1) by taut(sa)
  have acc: all i. i in omega -> int_lt(i, 4) -> x86_64_linux.can_access(app(s, "vm"), bits_add(64, x86i.rsp_ea(s, d), bits_of_int(64, i)), 1) proof
    fix i
    assume i1 i2
    have c1 := mp(mp(all_elim(sa1, {i}), i1), i2)
    have e := mp(all_elim(ea, {bits_of_int(64, i)}), simp(i1))
    have c2 := rewrite(e, c1)
    show by simp(c2, r4, hd)
  qed
  // the step: the store
  have st: all o. runs(x86_64_linux.step(), s, o) -> (ex m2. o = ok(m2, empty) && m2 = M1) proof
    fix o
    assume ho
    have hx2 := mp(mp(mp(all_elim(hat, {s}, {o}), ho), hc), hrip)
    have e := apply(x86i.store32_rsp, {s}, {o}, {7}, {d}, {z1}, {z2}, {len}, hM, hu, r7R, hd, acc, hx2)
    show by ex_intro({M1}, simp(e, ea1, hrip, ha2))
  qed
  have nr := apply(tr.sp_lt, {app(app(s, "gpr"), 4)}, r4, hlt)
  // after it: coupled at a2
  have post: all m2. m2 = M1 -> tr.sim(s, v, p, W, m2) proof
    fix m2
    assume e2
    have vV: V1 in x86_64_linux.Vm by taut(vf)
    have vU: V1 in univ(1) by taut(vf)
    have a2b: a2 in bits(64) by simp(ha2)
    have m1M: M1 in x86_64_linux.Machine by defs(simp(expand(hM, x86_64_linux.Machine), hu, pt, vV, vU, a2b), x86_64_linux.Machine)
    have m1u: M1 in univ(1) by simp(hu, vU, a2b)
    // (the code: the store's bytes are writable, the code's not)
    have sc := apply(tr.store_code_acc, {base}, {code}, {app(s, "vm")}, {bits_add(64, app(app(s, "gpr"), 4), d)}, {4}, simp(), hbase, hc, sa1)
    have cd: abi.code_at(V1, base, code) := all_elim(sc, {X})
    have kc := apply(tr.keeps_store, {app(s, "vm")}, {app(s, "vm")}, {bits_add(64, app(app(s, "gpr"), 4), d)}, {4}, {X}, simp(), all_elim(tr.keeps_refl, {app(s, "vm")}), sa1)
    have svm: app(s, "vm") in x86_64_linux.Vm by simp(pt)
    have gv := apply(tr.kept_bytes, {app(s, "vm")}, {app(s, "vm")}, {app(app(s, "gpr"), 4)}, {x86_64_linux.store_le(app(app(s, "vm"), "bytes"), bits_add(64, app(app(s, "gpr"), 4), d), 4, X)},
      all_elim(tr.kept_refl, {app(s, "vm")}, {app(app(s, "gpr"), 4)}))
    // (the return address: the store is below it)
    have below: all k. k in omega -> int_lt(k, 8) -> !int_lt(bits_sub(64, bits_add(64, app(app(s, "gpr"), 4), bits_of_int(64, k)), bits_add(64, app(app(s, "gpr"), 4), d)), 4) proof
      fix k
      assume k1 k2
      have e2: !int_lt(int_mod(int_sub(int_mod(int_add(app(app(s, "gpr"), 4), int_mod(k, 18446744073709551616)), 18446744073709551616),
          int_mod(int_add(app(app(s, "gpr"), 4), d), 18446744073709551616)), 18446744073709551616), 4) by arith(r4, hd, hd1, hd2, k1, k2)
      show by defs(rewrite(sym(p64), e2), bits_sub, bits_add, bits_of_int)
    qed
    have far := apply(x86.le_store_far, {app(app(s, "vm"), "bytes")}, {app(app(s, "gpr"), 4)}, {bits_add(64, app(app(s, "gpr"), 4), d)}, {4}, {X}, r4, simp(r4, hd), below)
    have wt := apply(abi.world_typed, hM, hvo, hmv, hvu)
    have z0: int_sub(app(app(s, "gpr"), 4), 0) = app(app(s, "gpr"), 4) by arith(r4)
    have hpg: app(mem, "pages") = app(app(s, "vm"), "pages") := hvw.1
      have inv: tr.inv(s, base, code, 0, M1, W) by defs(simp(subset_refl[s := app(app(s, "os"), "events")], hpg, hgf, z0, kc, gv, m1M, m1u, cd, far, hdf, wt, hvu, hM, ca, al, hsp, hlt, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access)), tr.inv)
    have rp: app(M1, "rip") = a2 by simp()
    have ld := apply(tr.le_store4, {app(app(s, "vm"), "bytes")}, {bits_add(64, app(app(s, "gpr"), 4), d)}, {X}, simp(pt), simp(r4, hd), xo)
    have du := mp(dom_update[f := empty, k := d, v := pair(4, x)], taut(dom_empty))
    have hh0: all c. c in dom(fn_update(empty, d, pair(4, x))) -> x86_64_linux.le(app(app(M1, "vm"), "bytes"), bits_add(64, int_add(app(app(s, "gpr"), 4), c), 0), fst(app(fn_update(empty, d, pair(4, x)), c))) =
        snd(app(fn_update(empty, d, pair(4, x)), c)) proof
      fix c
      assume hcd
      have hcd2 := rewrite(du, hcd)
      have de: dom(empty) = empty by taut(dom_empty)
      have ce: c = d by simp(rewrite(de, hcd2))
      have g0: x86_64_linux.le(app(app(M1, "vm"), "bytes"), bits_add(64, int_add(app(app(s, "gpr"), 4), d), 0), fst(app(fn_update(empty, d, pair(4, x)), d))) =
          snd(app(fn_update(empty, d, pair(4, x)), d)) by simp(ld, ea1, hx, r7)
      show := subst({y. x86_64_linux.le(app(app(M1, "vm"), "bytes"), bits_add(64, int_add(app(app(s, "gpr"), 4), y), 0), fst(app(fn_update(empty, d, pair(4, x)), y))) =
        snd(app(fn_update(empty, d, pair(4, x)), y))}, sym(ce), g0)
    qed
    have hh: tr.homes(s, M1, fn_update(empty, d, pair(4, x))) by defs(hh0, tr.homes)
    have rr: tr.regs(M1, empty) by defs(simp(dom_empty), tr.regs)
    have mm := apply(tr.mem_home, {s}, {base}, {code}, {0}, {M1}, {s}, {M1}, {W}, {v}, {d}, {4}, {X}, inv, hd, hd1, hd2, apply(tr.mem_entry, hob, hvw), simp(ea1))
    have c := mp(mp(mp(mp(mp(all_elim(expand(hpt, tr.pt), {M1}), inv), rp), hh), rr), mm)
    show := rewrite(sym(e2), c)
  qed
  show := mp(mp(mp(tr.step[s := s, v := v, p := p, w := W, m := s, q := y. y = M1], st), nr), post)
qed

// the prologue `sub rsp, k; mov [rsp + d], edi` (a frame of k <= 8 bytes,
// the argument's home c = d - k): from the entry s to the state after it,
// coupled with the spec's view
theorem tr.prologue_sub1_32: all s v mem base code f k len0 z0 a1 len d c z1 z2 a2 x p.
  s in x86_64_linux.Machine -> s in univ(1) -> v in set_type(omega) -> tr.objs_ok(s, v) -> mem in x86_64_linux.Vm -> abi.view_ok(s, v, mem) -> base in omega -> abi.code_at(app(s, "vm"), base, code) -> app(s, "rip") = f -> !app(app(s, "flags"), "df") ->
  x86_64_linux.can_access(app(s, "vm"), app(app(s, "gpr"), 4), 1) -> int_mod(bits_add(64, app(app(s, "gpr"), 4), 8), 16) = 0 ->
  abi.stack_page(app(s, "vm"), int_div(app(app(s, "gpr"), 4), 4096)) -> int_lt(app(app(s, "gpr"), 4), 140737488355328) -> abi.stack_gap_free(app(s, "vm")) ->
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = f ->
    runs(x86_64_linux.exec_body(len0, tag(60, pair(8, pair(5, pair(tag(0, 4), pair(z0, k)))))), m, o)) ->
  a1 = bits_add(64, f, len0) -> k in bits(8) -> int_lt(k, 128) -> int_le(k, 8) ->
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a1 ->
    runs(x86_64_linux.exec_body(len, tag(75, pair(4, pair(7, pair(x86i.rsp_mem(d), pair(z1, z2)))))), m, o)) ->
  a2 = bits_add(64, a1, len) -> d in bits(64) -> c = int_mod(int_sub(d, k), 18446744073709551616) -> c in bits(64) ->
  int_le(18446744073709551608, c) -> int_le(4, int_sub(18446744073709551616, c)) ->
  bits_of_int(32, app(app(s, "gpr"), 7)) = x ->
  abi.view(s, v, mem) in univ(1) ->
  tr.pt(s, v, base, code, k, a2, fn_update(empty, c, pair(4, x)), v, empty, p,
    abi.view(s, v, mem)) ->
  tr.sim(s, v, p, abi.view(s, v, mem), s)
proof
  fix s v mem base code f k len0 z0 a1 len d c z1 z2 a2 x p
  assume hM hu hvo hob hmv hvw hbase hc hrip hdf ca al hsp hlt hgf hat0 ha1 hk hkl hk8 hat ha2 hd hcd hcb hd1 hd2 hx hvu hpt
  let X := bits_slice(app(app(s, "gpr"), 7), 31, 0)
  let V1 := tr.view1(s, c, 4, X)
  let W := abi.view(s, v, mem)
  let R := int_sub(app(app(s, "gpr"), 4), k)
  let M0(fl) := fn_update(fn_update(fn_update(s, "rip", a1), "flags", fl), "gpr", fn_update(app(s, "gpr"), 4, R))
  have pt := apply(x86i.parts, hM)
  have r4 := apply(x86i.rsp_typed, hM)
  have r7R: 7 in x86_64_linux.Reg by simp()
  have r7 := mp(mp(all_elim(x86i.reg_typed, {s}, {7}), hM), r7R)
  have xo: X in omega by simp(r7)
  have ko: k in omega by simp(hk)
  have vf := apply(tr.view1_ok, {s}, {c}, {4}, {X}, hM, hu, simp(), xo)
  have p64: pow2(64) = 18446744073709551616 by simp()
  // (the entry's rsp: at least 8; the frame's rsp, R)
  have e8: int_mod(int_add(app(app(s, "gpr"), 4), 8), 18446744073709551616) = int_add(app(app(s, "gpr"), 4), 8) by arith(r4, hlt)
  have e8b: bits_add(64, app(app(s, "gpr"), 4), 8) = int_add(app(app(s, "gpr"), 4), 8) by defs(rewrite(sym(p64), e8), bits_add)
  have al2 := rewrite(e8b, al)
  have s8: int_le(8, app(app(s, "gpr"), 4)) by arith(al2, r4)
  have rb: R in bits(64) by arith(r4, s8, ko, hk8)
  have sx: bits_sext(8, 64, k) = k by defs(simp(hk, hkl), bits_sext, sint)
  have es0: int_mod(int_sub(app(app(s, "gpr"), 4), k), 18446744073709551616) = R by arith(r4, s8, ko, hk8)
  have es1: int_mod(int_sub(app(app(s, "gpr"), 4), bits_sext(8, 64, k)), 18446744073709551616) = R by simp(es0, sx)
  have es: bits_sub(64, app(app(s, "gpr"), 4), bits_sext(8, 64, k)) = R by defs(rewrite(sym(p64), es1), bits_sub)
  // (the store's address: rsp + d in the frame, s's rsp + c)
  have ea: all x0. x0 in omega -> bits_add(64, bits_add(64, app(app(s, "gpr"), 4), c), x0) = bits_add(64, int_add(app(app(s, "gpr"), 4), c), x0) proof
    fix x0
    assume h0
    have e2: int_mod(int_add(int_mod(int_add(app(app(s, "gpr"), 4), c), 18446744073709551616), x0), 18446744073709551616) =
      int_mod(int_add(int_add(app(app(s, "gpr"), 4), c), x0), 18446744073709551616) by arith(r4, hcb, h0)
    show by defs(rewrite(sym(p64), e2), bits_add)
  qed
  have ef: all x0. x0 in omega -> bits_add(64, int_add(R, d), x0) = bits_add(64, int_add(app(app(s, "gpr"), 4), c), x0) proof
    fix x0
    assume h0
    have e2: int_mod(int_add(int_add(int_sub(app(app(s, "gpr"), 4), k), d), x0), 18446744073709551616) =
      int_mod(int_add(int_add(app(app(s, "gpr"), 4), int_mod(int_sub(d, k), 18446744073709551616)), x0), 18446744073709551616) by arith(r4, hd, h0, ko)
    have e3 := subst({y. int_mod(int_add(int_add(int_sub(app(app(s, "gpr"), 4), k), d), x0), 18446744073709551616) =
      int_mod(int_add(int_add(app(app(s, "gpr"), 4), y), x0), 18446744073709551616)}, sym(hcd), e2)
    show by defs(rewrite(sym(p64), e3), bits_add)
  qed
  have ea0 := mp(all_elim(ea, {0}), simp())
  have ea1: bits_add(64, int_add(app(app(s, "gpr"), 4), c), 0) = bits_add(64, app(app(s, "gpr"), 4), c) by simp(ea0, r4, hcb)
  have ef0 := mp(all_elim(ef, {0}), simp())
  have ef1: bits_add(64, int_add(R, d), 0) = bits_add(64, app(app(s, "gpr"), 4), c) := rewrite(ea1, ef0)
  // (the home's 4 bytes: writable)
  have sa := apply(abi.slot_access, {app(s, "vm")}, {app(app(s, "gpr"), 4)}, {c}, {4}, r4, ca, al, hcb, hd1, hd2)
  have sa1: all i. i in omega -> int_lt(i, 4) -> x86_64_linux.can_access(app(s, "vm"), bits_add(64, bits_add(64, app(app(s, "gpr"), 4), c), bits_of_int(64, i)), 1) by taut(sa)
  // the first step: the frame
  let Q0(m) := ex fl. x86i.flags_ok(s, fl) && m = M0(fl)
  have st0: all o. runs(x86_64_linux.step(), s, o) -> (ex m2. o = ok(m2, empty) && Q0(m2)) proof
    fix o
    assume ho
    have hx0 := mp(mp(mp(all_elim(hat0, {s}, {o}), ho), hc), hrip)
    have r4R: 4 in x86_64_linux.Reg by simp()
    obtain fl, hf from apply(x86i.sub64_imm, {s}, {o}, {4}, {z0}, {k}, {len0}, hM, hu, r4R, hk, hx0)
    have q: Q0(M0(fl)) by ex_intro({fl}, simp(hf, keep(x86i.flags_ok)))
    show by ex_intro({M0(fl)}, simp(q, hf, es, hrip, ha1, keep(x86i.flags_ok)))
  qed
  have nr0 := apply(tr.sp_lt, {app(app(s, "gpr"), 4)}, r4, hlt)
  have post0: all m1. Q0(m1) -> tr.sim(s, v, p, W, m1) proof
    fix m1
    assume hq
    obtain fl, hfl from hq
    have fo: x86i.flags_ok(s, fl) by taut(hfl)
    have em: m1 = M0(fl) by taut(hfl)
    have f1 := expand(fo, x86i.flags_ok)
    have a1b: a1 in bits(64) by simp(ha1)
    have m0M: M0(fl) in x86_64_linux.Machine by defs(simp(expand(hM, x86_64_linux.Machine), hu, pt, f1, rb, a1b), x86_64_linux.Machine)
    have m0u: M0(fl) in univ(1) by simp(hu, f1, rb, a1b)
    let M1 := fn_update(fn_update(M0(fl), "rip", a2), "vm", V1)
    // the second step: the store
    have acc: all i. i in omega -> int_lt(i, 4) -> x86_64_linux.can_access(app(M0(fl), "vm"), bits_add(64, x86i.rsp_ea(M0(fl), d), bits_of_int(64, i)), 1) proof
      fix i
      assume i1 i2
      have c1 := mp(mp(all_elim(sa1, {i}), i1), i2)
      have e := mp(all_elim(ea, {bits_of_int(64, i)}), simp(i1))
      have c2 := rewrite(e, c1)
      have e2 := mp(all_elim(ef, {bits_of_int(64, i)}), simp(i1))
      have c3 := rewrite(sym(e2), c2)
      show by simp(c3, rb, hd)
    qed
    have st: all o. runs(x86_64_linux.step(), M0(fl), o) -> (ex m2. o = ok(m2, empty) && m2 = M1) proof
      fix o
      assume ho
      have cd0: abi.code_at(app(M0(fl), "vm"), base, code) by simp(hc)
      have rp0: app(M0(fl), "rip") = a1 by simp()
      have hx2 := mp(mp(mp(all_elim(hat, {M0(fl)}, {o}), ho), cd0), rp0)
      have e := apply(x86i.store32_rsp, {M0(fl)}, {o}, {7}, {d}, {z1}, {z2}, {len}, m0M, m0u, r7R, hd, acc, hx2)
      show by ex_intro({M1}, simp(e, ef1, ha2))
    qed
    have nrR: int_lt(int_sub(app(app(s, "gpr"), 4), k), abi.sp(s)) by arith(nr0, ko)
    have nr: int_lt(app(app(M0(fl), "gpr"), 4), abi.sp(s)) by simp(nrR)
    // after it: coupled at a2, in the frame k
    have post: all m2. m2 = M1 -> tr.sim(s, v, p, W, m2) proof
      fix m2
      assume e2
      have vV: V1 in x86_64_linux.Vm by taut(vf)
      have vU: V1 in univ(1) by taut(vf)
      have a2b: a2 in bits(64) by simp(ha2)
      have pt0 := apply(x86i.parts, m0M)
      have m1M: M1 in x86_64_linux.Machine by defs(simp(expand(hM, x86_64_linux.Machine), hu, pt, f1, rb, m0u, pt0, vV, vU, a2b), x86_64_linux.Machine)
      have m1u: M1 in univ(1) by simp(m0u, hu, f1, vU, a2b)
      have sc := apply(tr.store_code_acc, {base}, {code}, {app(s, "vm")}, {bits_add(64, app(app(s, "gpr"), 4), c)}, {4}, simp(), hbase, hc, sa1)
      have cd: abi.code_at(V1, base, code) := all_elim(sc, {X})
      have kc := apply(tr.keeps_store, {app(s, "vm")}, {app(s, "vm")}, {bits_add(64, app(app(s, "gpr"), 4), c)}, {4}, {X}, simp(), all_elim(tr.keeps_refl, {app(s, "vm")}), sa1)
      have svm: app(s, "vm") in x86_64_linux.Vm by simp(pt)
      have gv := apply(tr.kept_bytes, {app(s, "vm")}, {app(s, "vm")}, {app(app(s, "gpr"), 4)}, {x86_64_linux.store_le(app(app(s, "vm"), "bytes"), bits_add(64, app(app(s, "gpr"), 4), c), 4, X)},
        all_elim(tr.kept_refl, {app(s, "vm")}, {app(app(s, "gpr"), 4)}))
      have below: all k0. k0 in omega -> int_lt(k0, 8) -> !int_lt(bits_sub(64, bits_add(64, app(app(s, "gpr"), 4), bits_of_int(64, k0)), bits_add(64, app(app(s, "gpr"), 4), c)), 4) proof
        fix k0
        assume k1 k2
        have e3: !int_lt(int_mod(int_sub(int_mod(int_add(app(app(s, "gpr"), 4), int_mod(k0, 18446744073709551616)), 18446744073709551616),
            int_mod(int_add(app(app(s, "gpr"), 4), c), 18446744073709551616)), 18446744073709551616), 4) by arith(r4, hcb, hd1, hd2, k1, k2)
        show by defs(rewrite(sym(p64), e3), bits_sub, bits_add, bits_of_int)
      qed
      have far := apply(x86.le_store_far, {app(app(s, "vm"), "bytes")}, {app(app(s, "gpr"), 4)}, {bits_add(64, app(app(s, "gpr"), 4), c)}, {4}, {X}, r4, simp(r4, hcb), below)
      have wt := apply(abi.world_typed, hM, hvo, hmv, hvu)
      // (the callee-saved registers: s's, rsp the only one written)
      have e3 := mp(app_update_other[f := app(s, "gpr"), k := 4, v := R, x := 3], simp())
      have e5 := mp(app_update_other[f := app(s, "gpr"), k := 4, v := R, x := 5], simp())
      have e12 := mp(app_update_other[f := app(s, "gpr"), k := 4, v := R, x := 12], simp())
      have e13 := mp(app_update_other[f := app(s, "gpr"), k := 4, v := R, x := 13], simp())
      have e14 := mp(app_update_other[f := app(s, "gpr"), k := 4, v := R, x := 14], simp())
      have e15 := mp(app_update_other[f := app(s, "gpr"), k := 4, v := R, x := 15], simp())
      have e7 := mp(app_update_other[f := app(s, "gpr"), k := 4, v := R, x := 7], simp())
      have hpg: app(mem, "pages") = app(app(s, "vm"), "pages") := hvw.1
      have inv: tr.inv(s, base, code, k, M1, W) by defs(simp(subset_refl[s := app(app(s, "os"), "events")], hpg, hgf, kc, gv, m1M, m1u, cd, far, hdf, f1, wt, hvu, hM, ca, al, hsp, hlt, ko, e3, e5, e12, e13, e14, e15,
        keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access)), tr.inv)
      have rp: app(M1, "rip") = a2 by simp()
      have ld := apply(tr.le_store4, {app(app(s, "vm"), "bytes")}, {bits_add(64, app(app(s, "gpr"), 4), c)}, {X}, simp(pt), simp(r4, hcb), xo)
      have du := mp(dom_update[f := empty, k := c, v := pair(4, x)], taut(dom_empty))
      have hh0: all c0. c0 in dom(fn_update(empty, c, pair(4, x))) -> x86_64_linux.le(app(app(M1, "vm"), "bytes"), bits_add(64, int_add(app(app(s, "gpr"), 4), c0), 0), fst(app(fn_update(empty, c, pair(4, x)), c0))) =
          snd(app(fn_update(empty, c, pair(4, x)), c0)) proof
        fix c0
        assume hc0
        have hcd2 := rewrite(du, hc0)
        have de: dom(empty) = empty by taut(dom_empty)
        have ce: c0 = c by simp(rewrite(de, hcd2))
        have g0: x86_64_linux.le(app(app(M1, "vm"), "bytes"), bits_add(64, int_add(app(app(s, "gpr"), 4), c), 0), fst(app(fn_update(empty, c, pair(4, x)), c))) =
            snd(app(fn_update(empty, c, pair(4, x)), c)) by simp(ld, ea1, hx, r7)
        show := subst({y. x86_64_linux.le(app(app(M1, "vm"), "bytes"), bits_add(64, int_add(app(app(s, "gpr"), 4), y), 0), fst(app(fn_update(empty, c, pair(4, x)), y))) =
          snd(app(fn_update(empty, c, pair(4, x)), y))}, sym(ce), g0)
      qed
      have hh: tr.homes(s, M1, fn_update(empty, c, pair(4, x))) by defs(hh0, tr.homes)
      have rr: tr.regs(M1, empty) by defs(simp(dom_empty), tr.regs)
      have mm := apply(tr.mem_home, {s}, {base}, {code}, {k}, {M1}, {s}, {M1}, {W}, {v}, {c}, {4}, {X}, inv, hcb, hd1, hd2, apply(tr.mem_entry, hob, hvw), simp(ea1))
      have cc := mp(mp(mp(mp(mp(all_elim(expand(hpt, tr.pt), {M1}), inv), rp), hh), rr), mm)
      show := rewrite(sym(e2), cc)
    qed
    have sm := mp(mp(mp(tr.step[s := s, v := v, p := p, w := W, m := M0(fl), q := y. y = M1], st), nr), post)
    show := rewrite(sym(em), sm)
  qed
  show := mp(mp(mp(tr.step[s := s, v := v, p := p, w := W, m := s, q := y. Q0(y)], st0), nr0), post0)
qed

// the entry of a function of one argument (`require len(args) >= 1`, the
// procedure called with it, its result returned by kw): the claim at the
// entry, for every entry with an argument, gives abi.matches. (Too few
// arguments: the spec allows anything.)
theorem tr.entry1g(base, code, statics, f, x0. q, x3 x4 x2. kw):
  (all args v mem s. args in abi.ARGS -> v in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(app(s, "vm"), base, code, statics) -> app(s, "rip") = f ->
    abi.entry_ok(s, args) -> tr.objs_ok(s, v) -> abi.view_ok(s, v, mem) -> ord_le(1, seq_len(args)) ->
    tr.sim(s, v, mkprog(x1 x2. bind_rel(q(args), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), abi.view(s, v, mem), s)) ->
  (all args v mem s o. args in abi.ARGS -> v in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(app(s, "vm"), base, code, statics) -> app(s, "rip") = f ->
    abi.entry_ok(s, args) -> tr.objs_ok(s, v) -> abi.view_ok(s, v, mem) -> tr.run_d(s, s, o) ->
    tr.matches_t(fn_build(abi.ARGS, x0. mkprog(x1 x2. !ord_le(1, seq_len(x0)) || bind_rel(q(x0), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))), args, v, mem, s, o))
proof
  assume hpro
  fix args v mem s o
  assume hA hvo hmv hM hsu hl hrip he hob hvw hr
  let W := abi.view(s, v, mem)
  let SPEC := fn_build(abi.ARGS, x0. mkprog(x1 x2. !ord_le(1, seq_len(x0)) || bind_rel(q(x0), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))))
  let BIND := mkprog(x1 x2. bind_rel(q(args), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))
  have su := hsu
  have ou := apply(abi.objs_univ, hvo)
  have mu := apply(x86.vm_univ, hmv)
  have hvu: W in univ(1) by simp(su, ou, mu)
  // the spec applied: its body at args
  have ae: app(SPEC, args) = mkprog(x1 x2. !ord_le(1, seq_len(args)) || bind_rel(q(args), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))) by simp(hA)
  have enough: ord_le(1, seq_len(args)) -> tr.matches_t(SPEC, args, v, mem, s, o) proof
    assume hg
    have sim0 := mp(all_elim(hpro, {args}, {v}, {mem}, {s}), hA, hvo, hmv, hM, su, hl, hrip, he, hob, hvw, hg)
    // (the spec's runs: the call's, the guard holding)
    have k: all o2. bind_rel(q(args), W, x3 x4. kw(x3, x4, o2), x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3)) ->
        (!ord_le(1, seq_len(args)) || bind_rel(q(args), W, x3 x4. kw(x3, x4, o2), x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3))) proof
      fix o2
      assume b
      show by taut(b)
    qed
    have r0 := mp(tr.mkprog_mono[s := W, r1 := x1 x2. !ord_le(1, seq_len(args)) || bind_rel(q(args), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)),
      r2 := x1 x2. bind_rel(q(args), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))], k)
    have red: tr.red(app(SPEC, args), W, BIND, W) by defs(rewrite(sym(ae), r0), tr.red)
    have sim := apply(tr.sim_red, red, sim0)
    show := apply(tr.entry_d, {SPEC}, {args}, {s}, {v}, {mem}, {o}, sim, hr)
  qed
  have few: !ord_le(1, seq_len(args)) -> tr.matches_t(SPEC, args, v, mem, s, o) proof
    assume hng
    have eu: empty in univ(1) by simp()
    have pu: pair(W, exc(W, empty)) in univ(1) by simp(hvu)
    have rr := mp(mp(all_elim(tr.runs_intro[r := x1 x2. !ord_le(1, seq_len(args)) || bind_rel(q(args), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))],
      {W}, {exc(W, empty)}), pu), taut(hng))
    have rs := rewrite(sym(ae), rr)
    have eno: !(empty = exc_val("stack_overflow", empty)) by defs(all_elim(tr.pair_ne, {"stack_overflow"}, {empty}), exc_val)
    have wW := apply(abi.world_typed, hM, hvo, hmv, hvu)
    have rst: abi.raise_state(W) by defs(apply(tr.world_and, wW), abi.raise_state)
    have ub: abi.raises_at(SPEC, args, v, mem, s) by defs(ex_intro({empty}, {W}, taut(eu, eno, rst, rs)), abi.raises_at)
    show by defs(taut(ub), tr.matches_t)
  qed
  show by taut(enough, few)
qed

// ... its prologue `mov [rsp + d], edi`: the claim after it, for every
// entry, gives abi.matches
theorem tr.entry1_32(base, code, statics, f, len, d, z1, z2, a2, x0. q, x3 x4 x2. kw): base in omega ->
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = f ->
    runs(x86_64_linux.exec_body(len, tag(75, pair(4, pair(7, pair(x86i.rsp_mem(d), pair(z1, z2)))))), m, o)) ->
  a2 = bits_add(64, f, len) -> d in bits(64) -> int_le(18446744073709551608, d) -> int_le(4, int_sub(18446744073709551616, d)) ->
  (all args v mem s. args in abi.ARGS -> v in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> ord_le(1, seq_len(args)) -> abi.view(s, v, mem) in univ(1) ->
    abi.loaded(app(s, "vm"), base, code, statics) -> abi.view(s, v, mem) in abi.World ->
    tr.pt(s, v, base, code, 0, a2, fn_update(empty, d, pair(4, bits_of_int(32, app(args, 0)))), v, empty,
      mkprog(x1 x2. bind_rel(q(args), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), abi.view(s, v, mem))) ->
  (all args v mem s o. args in abi.ARGS -> v in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(app(s, "vm"), base, code, statics) -> app(s, "rip") = f ->
    abi.entry_ok(s, args) -> tr.objs_ok(s, v) -> abi.view_ok(s, v, mem) -> tr.run_d(s, s, o) ->
    tr.matches_t(fn_build(abi.ARGS, x0. mkprog(x1 x2. !ord_le(1, seq_len(x0)) || bind_rel(q(x0), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))), args, v, mem, s, o))
proof
  assume hbase hat ha2 hd hd1 hd2 hbody
  have hpro: all args v mem s. args in abi.ARGS -> v in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(app(s, "vm"), base, code, statics) -> app(s, "rip") = f ->
      abi.entry_ok(s, args) -> tr.objs_ok(s, v) -> abi.view_ok(s, v, mem) -> ord_le(1, seq_len(args)) ->
      tr.sim(s, v, mkprog(x1 x2. bind_rel(q(args), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), abi.view(s, v, mem), s) proof
    fix args v mem s
    assume hA hvo hmv hM su hl hrip he hob hvw hg
    let BIND := mkprog(x1 x2. bind_rel(q(args), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))
    have hc: abi.code_at(app(s, "vm"), base, code) by taut(expand(hl, abi.loaded))
    have ent := apply(abi.entry_stack, hM, he)
    have hdf: !app(app(s, "flags"), "df") by taut(expand(he, abi.entry_ok))
    have ou := apply(abi.objs_univ, hvo)
    have mu := apply(x86.vm_univ, hmv)
    have hvu: abi.view(s, v, mem) in univ(1) by simp(su, ou, mu)
    have ap := apply(abi.arg_passed, {s}, {args}, hA, he, hg)
    have hx: bits_of_int(32, app(app(s, "gpr"), 7)) = bits_of_int(32, app(args, 0)) by simp(ap)
    have hWw := apply(abi.world_typed, hM, hvo, hmv, hvu)
    have body := mp(all_elim(hbody, {args}, {v}, {mem}, {s}), hA, hvo, hmv, hM, hg, hvu, hl, hWw)
    show := apply(tr.prologue1_32, {s}, {v}, {mem}, {base}, {code}, {f}, {len}, {d}, {z1}, {z2}, {a2}, {bits_of_int(32, app(args, 0))}, {BIND},
      hM, su, hvo, hob, hmv, hvw, hbase, hc, hrip, hdf, taut(ent), taut(ent), taut(ent), taut(ent), apply(abi.entry_gap, he), hat, ha2, hd, hd1, hd2, hx, hvu, body)
  qed
  show := mp(tr.entry1g[base := base, code := code, statics := statics, f := f, q := x0. q(x0), kw := x3 x4 x2. kw(x3, x4, x2)], hpro)
qed

// ... its prologue `sub rsp, k; mov [rsp + d], edi` (a frame of k <= 8
// bytes, the argument's home c = d - k): the claim after it, for every
// entry, gives abi.matches
theorem tr.entry1_32s(base, code, statics, f, k, len0, z0, a1, len, d, c, z1, z2, a2, x0. q, x3 x4 x2. kw): base in omega ->
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = f ->
    runs(x86_64_linux.exec_body(len0, tag(60, pair(8, pair(5, pair(tag(0, 4), pair(z0, k)))))), m, o)) ->
  a1 = bits_add(64, f, len0) -> k in bits(8) -> int_lt(k, 128) -> int_le(k, 8) ->
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a1 ->
    runs(x86_64_linux.exec_body(len, tag(75, pair(4, pair(7, pair(x86i.rsp_mem(d), pair(z1, z2)))))), m, o)) ->
  a2 = bits_add(64, a1, len) -> d in bits(64) -> c = int_mod(int_sub(d, k), 18446744073709551616) -> c in bits(64) ->
  int_le(18446744073709551608, c) -> int_le(4, int_sub(18446744073709551616, c)) ->
  (all args v mem s. args in abi.ARGS -> v in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> ord_le(1, seq_len(args)) -> abi.view(s, v, mem) in univ(1) ->
    abi.loaded(app(s, "vm"), base, code, statics) -> abi.view(s, v, mem) in abi.World ->
    tr.pt(s, v, base, code, k, a2, fn_update(empty, c, pair(4, bits_of_int(32, app(args, 0)))), v, empty,
      mkprog(x1 x2. bind_rel(q(args), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), abi.view(s, v, mem))) ->
  (all args v mem s o. args in abi.ARGS -> v in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(app(s, "vm"), base, code, statics) -> app(s, "rip") = f ->
    abi.entry_ok(s, args) -> tr.objs_ok(s, v) -> abi.view_ok(s, v, mem) -> tr.run_d(s, s, o) ->
    tr.matches_t(fn_build(abi.ARGS, x0. mkprog(x1 x2. !ord_le(1, seq_len(x0)) || bind_rel(q(x0), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))), args, v, mem, s, o))
proof
  assume hbase hat0 ha1 hk hkl hk8 hat ha2 hd hcd hcb hd1 hd2 hbody
  have hpro: all args v mem s. args in abi.ARGS -> v in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(app(s, "vm"), base, code, statics) -> app(s, "rip") = f ->
      abi.entry_ok(s, args) -> tr.objs_ok(s, v) -> abi.view_ok(s, v, mem) -> ord_le(1, seq_len(args)) ->
      tr.sim(s, v, mkprog(x1 x2. bind_rel(q(args), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), abi.view(s, v, mem), s) proof
    fix args v mem s
    assume hA hvo hmv hM su hl hrip he hob hvw hg
    let BIND := mkprog(x1 x2. bind_rel(q(args), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))
    have hc: abi.code_at(app(s, "vm"), base, code) by taut(expand(hl, abi.loaded))
    have ent := apply(abi.entry_stack, hM, he)
    have hdf: !app(app(s, "flags"), "df") by taut(expand(he, abi.entry_ok))
    have ou := apply(abi.objs_univ, hvo)
    have mu := apply(x86.vm_univ, hmv)
    have hvu: abi.view(s, v, mem) in univ(1) by simp(su, ou, mu)
    have ap := apply(abi.arg_passed, {s}, {args}, hA, he, hg)
    have hx: bits_of_int(32, app(app(s, "gpr"), 7)) = bits_of_int(32, app(args, 0)) by simp(ap)
    have hWw := apply(abi.world_typed, hM, hvo, hmv, hvu)
    have body := mp(all_elim(hbody, {args}, {v}, {mem}, {s}), hA, hvo, hmv, hM, hg, hvu, hl, hWw)
    show := apply(tr.prologue_sub1_32, {s}, {v}, {mem}, {base}, {code}, {f}, {k}, {len0}, {z0}, {a1}, {len}, {d}, {c}, {z1}, {z2}, {a2}, {bits_of_int(32, app(args, 0))}, {BIND},
      hM, su, hvo, hob, hmv, hvw, hbase, hc, hrip, hdf, taut(ent), taut(ent), taut(ent), taut(ent), apply(abi.entry_gap, he), hat0, ha1, hk, hkl, hk8, hat, ha2, hd, hcd, hcb, hd1, hd2, hx, hvu, body)
  qed
  show := mp(tr.entry1g[base := base, code := code, statics := statics, f := f, q := x0. q(x0), kw := x3 x4 x2. kw(x3, x4, x2)], hpro)
qed

// ----------------------------------------------------------------------
//  More instructions: sub, mov imm, cdqe, the branches (cmp; jcc), a byte
//  load the spec has loaded

// x - k as GIMPLE writes it: x + -k
theorem tr.sub_add: all u k. u in bits(32) -> k in bits(32) -> bits_sub(32, u, k) = bits_add(32, u, bits_neg(32, k))
proof
  fix u k
  assume hu hk
  have e: int_mod(int_sub(u, k), 4294967296) = int_mod(int_add(u, int_mod(int_neg(k), 4294967296)), 4294967296) by arith(hu, hk)
  show by defs(simp(e), bits_sub, bits_add, bits_neg)
qed

// sub r32, imm8: g := u + -kk (kk the immediate, sign-extended)
theorem tr.sub32_imm: all s v base code fr a a2 len g z k kk u hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(60, pair(4, pair(5, pair(tag(0, g), pair(z, k)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> k in bits(8) -> kk = bits_sext(8, 32, k) -> g in dom(rs) -> app(rs, g) = pair(4, u) ->
  tr.pt(s, v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(4, bits_add(32, u, bits_neg(32, kk)))), p, w) -> tr.pt(s, v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g z k kk u hs ds rs p w
  assume hat ha2 hg hk hkk hd hu hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bits_add(32, u, bits_neg(32, kk)))), empty)) proof
    fix m o
    assume hi hr hh hrs ho
    have ipM ipU ipC _ := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {4}, {u}, hrs, hd, hu)
    have hx := mp(mp(mp(all_elim(hat, {m}, {o}), ho), ipC), hr)
    have u32: u in bits(32) by simp(rg)
    have k32: kk in bits(32) by simp(hkk, hk)
    have sa := mp(tr.sub_add, {u}, {kk}, u32, k32)
    obtain f, hf from apply(x86i.sub32_imm, {m}, {o}, {g}, {z}, {k}, {len}, ipM, ipU, gR, hk, hx)
    show by ex_intro({f}, simp(hf, rg, hr, ha2, hkk, sa, keep(x86i.flags_ok)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_add(32, u, bits_neg(32, kk)) in bits(int_mul(8, 4)) && bits_add(32, u, bits_neg(32, kk)) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step, {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {bits_add(32, u, bits_neg(32, kk))}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// mov r32, imm32: g := k
theorem tr.mov32_imm: all s v base code fr a a2 len g k hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(111, pair(g, k))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> k in bits(32) ->
  tr.pt(s, v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(4, k)), p, w) -> tr.pt(s, v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g k hs ds rs p w
  assume hat ha2 hg hk hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(app(m, "gpr"), g, k)), empty) proof
    fix m o
    assume hi hr hhs hrs ho
    have ipM ipU ipC _ := apply(tr.inv_parts, hi)
    have hx := mp(mp(mp(all_elim(hat, {m}, {o}), ho), ipC), hr)
    have e := apply(x86i.mov32_imm, {m}, {o}, {g}, {k}, {len}, ipM, ipU, gR, hk, hx)
    show by simp(e, hr, ha2)
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      k in bits(int_mul(8, 4)) && k in bits(64) proof
    fix m
    show by simp(hk, keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0, {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {k}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// cdqe: rax := eax's value u, sign-extended to 64 bits
theorem tr.cdqe: all s v base code fr a a2 len u hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(91, 8)), m, o)) ->
  a2 = bits_add(64, a, len) -> 0 in dom(rs) -> app(rs, 0) = pair(4, u) ->
  tr.pt(s, v, base, code, fr, a2, hs, ds, fn_update(rs,0, pair(8, bits_sext(32, 64, u))), p, w) -> tr.pt(s, v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len u hs ds rs p w
  assume hat ha2 hd hu hpt
  have sc0: tr.scratch_reg(0) by defs(simp(), tr.scratch_reg)
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(app(m, "gpr"), 0, bits_sext(32, 64, u))), empty) proof
    fix m o
    assume hi hr hhs hrs ho
    have ipM ipU ipC _ := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {0}, {4}, {u}, hrs, hd, hu)
    have hx := mp(mp(mp(all_elim(hat, {m}, {o}), ho), ipC), hr)
    have e := apply(x86i.cdqe, {m}, {o}, {len}, ipM, ipU, hx)
    show by simp(e, rg, hr, ha2)
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_sext(32, 64, u) in bits(int_mul(8, 8)) && bits_sext(32, 64, u) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0, {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {0}, {8}, {bits_sext(32, 64, u)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, sc0, ty, hpt)
qed

// the invariant after a flags write (and rip), after a rip write
theorem tr.inv_flags: all s base code fr m w r f. tr.inv(s, base, code, fr, m, w) -> r in bits(64) -> x86i.flags_ok(m, f) ->
  tr.inv(s, base, code, fr, fn_update(fn_update(m, "rip", r), "flags", f), w)
proof
  fix s base code fr m w r f
  assume hi hr hf
  have i := expand(hi, tr.inv)
  have {mM, mu} := i
  have pt := apply(x86i.parts, mM)
  have f1 := expand(hf, x86i.flags_ok)
  have m2: fn_update(fn_update(m, "rip", r), "flags", f) in x86_64_linux.Machine by defs(simp(expand(mM, x86_64_linux.Machine), mu, hr, f1, pt), x86_64_linux.Machine)
  show by defs(simp(i, m2, hr, f1, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access)), tr.inv)
qed

theorem tr.inv_rip: all s base code fr m w r. tr.inv(s, base, code, fr, m, w) -> r in bits(64) -> tr.inv(s, base, code, fr, fn_update(m, "rip", r), w)
proof
  fix s base code fr m w r
  assume hi hr
  have i := expand(hi, tr.inv)
  have {mM, mu} := i
  have pt := apply(x86i.parts, mM)
  have m2: fn_update(m, "rip", r) in x86_64_linux.Machine by defs(simp(expand(mM, x86_64_linux.Machine), mu, hr, pt), x86_64_linux.Machine)
  show by defs(simp(i, m2, hr, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access)), tr.inv)
qed

// a proposition is true when it equals true, false when it equals false
theorem tr.prop_true: all a. (a = false || a = true) -> (a = true <-> a)
proof
  fix a
  assume h
  have c1: a = false -> (a = true <-> a) proof
    assume e
    have d1: false = true -> false proof
      assume e1
      have t1: true by simp()
      show := subst({y. y}, sym(e1), t1)
    qed
    have f0: false = true <-> false by taut(d1)
    show := subst({y. y = true <-> y}, sym(e), f0)
  qed
  have c2: a = true -> (a = true <-> a) proof
    assume e
    have r1: true = true := refl({true})
    have t1: true by simp()
    have f0: true = true <-> true by taut(r1, t1)
    show := subst({y. y = true <-> y}, sym(e), f0)
  qed
  show by taut(h, c1, c2)
qed

theorem tr.prop_false: all a. (a = false || a = true) -> (a = false <-> !a)
proof
  fix a
  assume h
  have c1: a = false -> (a = false <-> !a) proof
    assume e
    have r1: false = false := refl({false})
    have n1: !false by simp()
    have f0: false = false <-> !false by taut(r1, n1)
    show := subst({y. y = false <-> !y}, sym(e), f0)
  qed
  have c2: a = true -> (a = false <-> !a) proof
    assume e
    have d1: true = false -> false proof
      assume e1
      have t1: true by simp()
      show := subst({y. y}, e1, t1)
    qed
    have t1: true by simp()
    have f0: true = false <-> !true by taut(d1, t1)
    show := subst({y. y = false <-> !y}, sym(e), f0)
  qed
  show by taut(h, c1, c2)
qed

// a branch: an instruction setting the flags (to f with ff(f)), then a
// conditional jump on them (cc) to t, else on to a3; ff decides the jump
// by the value condition c (c: on to a3)
theorem tr.branch(s, v, base, code, fr, a, a2, a3, t, cc, hs, ds, rs, p, w, f. ff, c):
  (all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
    (ex f. x86i.flags_ok(m, f) && ff(f) && o = ok(fn_update(fn_update(m, "rip", a2), "flags", f), empty))) ->
  (all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a2 -> runs(x86_64_linux.step(), m, o) ->
    o = ok(fn_update(m, "rip", ite(x86_64_linux.cond(app(m, "flags"), cc), t, a3)), empty)) ->
  (all m f. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> ff(f) -> (x86_64_linux.cond(f, cc) <-> !c)) ->
  a2 in bits(64) -> a3 in bits(64) -> t in bits(64) ->
  (c -> tr.pt(s, v, base, code, fr, a3, hs, ds, rs, p, w)) -> (!c -> tr.pt(s, v, base, code, fr, t, hs, ds, rs, p, w)) ->
  tr.pt(s, v, base, code, fr, a, hs, ds, rs, p, w)
proof
  assume h1 h2 h3 ha2 ha3 ht pa pb
  have g: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, ds) -> tr.sim(s, v, p, w, m) proof
    fix m
    assume hi hr hh hrs hmm
    have r4 := apply(x86i.rsp_typed, hi.sM)
    have nr := apply(tr.inv_nr, hi)
    let Q1(m2) := ex f. x86i.flags_ok(m, f) && ff(f) && m2 = fn_update(fn_update(m, "rip", a2), "flags", f)
    have st1: all o. runs(x86_64_linux.step(), m, o) -> (ex m2. o = ok(m2, empty) && Q1(m2)) proof
      fix o
      assume ho
      obtain f, hf from mp(all_elim(h1, {m}, {o}), hi, hr, hh, hrs, ho)
      have q1: Q1(fn_update(fn_update(m, "rip", a2), "flags", f)) by ex_intro({f}, simp(hf, keep(x86i.flags_ok)))
      show by ex_intro({fn_update(fn_update(m, "rip", a2), "flags", f)}, taut(q1, hf))
    qed
    have post1: all m2. Q1(m2) -> tr.sim(s, v, p, w, m2) proof
      fix m2
      assume hq
      obtain f, hf from hq
      have fo: x86i.flags_ok(m, f) by taut(hf)
      have fff: ff(f) by taut(hf)
      have e: m2 = fn_update(fn_update(m, "rip", a2), "flags", f) by taut(hf)
      let M2 := fn_update(fn_update(m, "rip", a2), "flags", f)
      have i2 := mp(tr.inv_flags, {s}, {base}, {code}, {fr}, {m}, {w}, {a2}, {f}, hi, ha2, fo)
      have hh2: tr.homes(s, M2, hs) by defs(simp(expand(hh, tr.homes)), tr.homes)
      have rs2: tr.regs(M2, rs) by defs(simp(expand(hrs, tr.regs)), tr.regs)
      have ip2 := apply(tr.inv_parts, i2)
      have nr2: int_lt(app(app(M2, "gpr"), 4), abi.sp(s)) by simp(nr)
      have k := mp(all_elim(h3, {m}, {f}), hi, hr, hh, hrs, fff)
      let Q2(m3) := m3 = fn_update(M2, "rip", ite(x86_64_linux.cond(f, cc), t, a3))
      have st2: all o. runs(x86_64_linux.step(), M2, o) -> (ex m3. o = ok(m3, empty) && Q2(m3)) proof
        fix o
        assume ho
        have r2: app(M2, "rip") = a2 by simp()
        have eo := mp(all_elim(h2, {M2}, {o}), i2, r2, ho)
        have fl: app(M2, "flags") = f by simp()
        have eo2 := rewrite(fl, eo)
        show by ex_intro({fn_update(M2, "rip", ite(x86_64_linux.cond(f, cc), t, a3))}, simp(eo2))
      qed
      have post2: all m3. Q2(m3) -> tr.sim(s, v, p, w, m3) proof
        fix m3
        assume e3
        have ca: c -> tr.sim(s, v, p, w, m3) proof
          assume hc
          have ec: m3 = fn_update(M2, "rip", a3) by simp(e3, k, hc)
          have i3 := mp(tr.inv_rip, {s}, {base}, {code}, {fr}, {M2}, {w}, {a3}, i2, ha3)
          have hh3: tr.homes(s, fn_update(M2, "rip", a3), hs) by defs(simp(expand(hh2, tr.homes)), tr.homes)
          have rs3: tr.regs(fn_update(M2, "rip", a3), rs) by defs(simp(expand(rs2, tr.regs)), tr.regs)
          have r3: app(fn_update(M2, "rip", a3), "rip") = a3 by simp()
          have mm3 := apply(tr.mem_vm, {s}, {m}, {fn_update(M2, "rip", a3)}, {w}, {ds}, simp(), hmm)
          have c3 := mp(all_elim(expand(mp(pa, hc), tr.pt), {fn_update(M2, "rip", a3)}), i3, r3, hh3, rs3, mm3)
          show := rewrite(sym(ec), c3)
        qed
        have cb: !c -> tr.sim(s, v, p, w, m3) proof
          assume hc
          have ec: m3 = fn_update(M2, "rip", t) by simp(e3, k, hc)
          have i3 := mp(tr.inv_rip, {s}, {base}, {code}, {fr}, {M2}, {w}, {t}, i2, ht)
          have hh3: tr.homes(s, fn_update(M2, "rip", t), hs) by defs(simp(expand(hh2, tr.homes)), tr.homes)
          have rs3: tr.regs(fn_update(M2, "rip", t), rs) by defs(simp(expand(rs2, tr.regs)), tr.regs)
          have r3: app(fn_update(M2, "rip", t), "rip") = t by simp()
          have mm3 := apply(tr.mem_vm, {s}, {m}, {fn_update(M2, "rip", t)}, {w}, {ds}, simp(), hmm)
          have c3 := mp(all_elim(expand(mp(pb, hc), tr.pt), {fn_update(M2, "rip", t)}), i3, r3, hh3, rs3, mm3)
          show := rewrite(sym(ec), c3)
        qed
        show by taut(ca, cb)
      qed
      have sm := mp(tr.step[s := s, v := v, p := p, w := w, m := M2, q := x. Q2(x)], st2, nr2, post2)
      show := rewrite(sym(e), sm)
    qed
    show := mp(tr.step[s := s, v := v, p := p, w := w, m := m, q := x. Q1(x)], st1, nr, post1)
  qed
  show by defs(g, tr.pt)
qed

// cmp r32 (holding u), imm8 (kk sign-extended); ja t: on when u <= kk
theorem tr.cmp32_ja: all s v base code fr a a2 a3 t len1 len2 g z k kk r u hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len1, tag(60, pair(4, pair(7, pair(tag(0, g), pair(z, k)))))), m, o)) ->
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a2 ->
    runs(x86_64_linux.exec_body(len2, tag(127, pair(7, r))), m, o)) ->
  a2 = bits_add(64, a, len1) -> a3 = bits_add(64, a2, len2) -> t = bits_add(64, a3, bits_sext(8, 64, r)) ->
  g in x86_64_linux.Reg -> k in bits(8) -> kk = bits_sext(8, 32, k) -> r in bits(32) -> g in dom(rs) -> app(rs, g) = pair(4, u) ->
  (int_le(u, kk) -> tr.pt(s, v, base, code, fr, a3, hs, ds, rs, p, w)) -> (!int_le(u, kk) -> tr.pt(s, v, base, code, fr, t, hs, ds, rs, p, w)) ->
  tr.pt(s, v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 a3 t len1 len2 g z k kk r u hs ds rs p w
  assume hat1 hat2 ha2 ha3 hta hg hk hkk hr8 hd hu pa pb
  let FF(f) := app(f, "cf") = int_lt(u, kk) && app(f, "zf") = (bits_sub(32, u, kk) = 0)
  have h1: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && FF(f) && o = ok(fn_update(fn_update(m, "rip", a2), "flags", f), empty)) proof
    fix m o
    assume hi hr hh hrs ho
    have ipM ipU ipC _ := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {4}, {u}, hrs, hd, hu)
    have hx := mp(all_elim(hat1, {m}, {o}), ho, ipC, hr)
    obtain f, hf from apply(x86i.cmp32_imm, {m}, {o}, {g}, {z}, {k}, {len1}, ipM, ipU, hg, hk, hx)
    show by ex_intro({f}, simp(hf, rg, hr, ha2, hkk, keep(x86i.flags_ok)))
  qed
  have h2: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a2 -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(m, "rip", ite(x86_64_linux.cond(app(m, "flags"), 7), t, a3)), empty) proof
    fix m o
    assume hi hr ho
    have ipM ipU ipC _ := apply(tr.inv_parts, hi)
    have hx := mp(all_elim(hat2, {m}, {o}), ho, ipC, hr)
    have e := apply(x86i.jcc8, {m}, {o}, {7}, {r}, {len2}, ipM, ipU, simp(), hr8, hx)
    show by simp(e, hr, ha3, hta)
  qed
  have h3: all m f. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> FF(f) ->
      (x86_64_linux.cond(f, 7) <-> !int_le(u, kk)) proof
    fix m f
    assume hi hr hh hrs hf
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {4}, {u}, hrs, hd, hu)
    have k32: kk in bits(32) by simp(hkk, hk)
    have u32: u in bits(32) by simp(rg)
    have e1a: (int_mod(int_sub(u, kk), 4294967296) = 0) <-> u = kk by arith(u32, k32)
    have e1: (bits_sub(32, u, kk) = 0) <-> u = kk by defs(simp(e1a), bits_sub)
    have hp: (int_lt(u, kk) || bits_sub(32, u, kk) = 0) = false || (int_lt(u, kk) || bits_sub(32, u, kk) = 0) = true
      by defs(imp_prop[a := !int_lt(u, kk), b := bits_sub(32, u, kk) = 0], is_prop, or)
    have e3 := mp(tr.prop_true, {int_lt(u, kk) || bits_sub(32, u, kk) = 0}, hp)
    have e2: (int_lt(u, kk) || u = kk) <-> int_le(u, kk) by arith(u32, k32)
    show by simp(hf, e1, e2, e3, all_elim(x86.cond_eval, {f}, {7}))
  qed
  show := mp(tr.branch[s := s, v := v, base := base, code := code, fr := fr, a := a, a2 := a2, a3 := a3, t := t, cc := 7, hs := hs, ds := ds, rs := rs, p := p, w := w,
    ff := f. FF(f), c := int_le(u, kk)], h1, h2, h3, simp(ha2), simp(ha3), simp(hta), pa, pb)
qed

// cmp al (holding the byte b), imm8 k; jbe t: on when k < b
theorem tr.cmp8_jbe: all s v base code fr a a2 a3 t len1 len2 k r b hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len1, tag(23, k)), m, o)) ->
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a2 ->
    runs(x86_64_linux.exec_body(len2, tag(127, pair(6, r))), m, o)) ->
  a2 = bits_add(64, a, len1) -> a3 = bits_add(64, a2, len2) -> t = bits_add(64, a3, bits_sext(8, 64, r)) ->
  k in bits(8) -> r in bits(32) -> 0 in dom(rs) -> app(rs, 0) = pair(1, b) ->
  (int_lt(k, b) -> tr.pt(s, v, base, code, fr, a3, hs, ds, rs, p, w)) -> (!int_lt(k, b) -> tr.pt(s, v, base, code, fr, t, hs, ds, rs, p, w)) ->
  tr.pt(s, v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 a3 t len1 len2 k r b hs ds rs p w
  assume hat1 hat2 ha2 ha3 hta hk hr8 hd hb pa pb
  let FF(f) := app(f, "cf") = int_lt(b, k) && app(f, "zf") = (bits_sub(8, b, k) = 0)
  have h1: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && FF(f) && o = ok(fn_update(fn_update(m, "rip", a2), "flags", f), empty)) proof
    fix m o
    assume hi hr hh hrs ho
    have ipM ipU ipC _ := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {0}, {1}, {b}, hrs, hd, hb)
    have hx := mp(all_elim(hat1, {m}, {o}), ho, ipC, hr)
    obtain f, hf from apply(x86i.cmp8_al, {m}, {o}, {k}, {len1}, ipM, ipU, hk, hx)
    show by ex_intro({f}, simp(hf, rg, hr, ha2, keep(x86i.flags_ok)))
  qed
  have h2: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a2 -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(m, "rip", ite(x86_64_linux.cond(app(m, "flags"), 6), t, a3)), empty) proof
    fix m o
    assume hi hr ho
    have ipM ipU ipC _ := apply(tr.inv_parts, hi)
    have hx := mp(all_elim(hat2, {m}, {o}), ho, ipC, hr)
    have e := apply(x86i.jcc8, {m}, {o}, {6}, {r}, {len2}, ipM, ipU, simp(), hr8, hx)
    show by simp(e, hr, ha3, hta)
  qed
  have h3: all m f. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> FF(f) ->
      (x86_64_linux.cond(f, 6) <-> !int_lt(k, b)) proof
    fix m f
    assume hi hr hh hrs hf
    have rg := apply(tr.regs_get, {m}, {rs}, {0}, {1}, {b}, hrs, hd, hb)
    have b8: b in bits(8) by simp(rg)
    have e1a: (int_mod(int_sub(b, k), 256) = 0) <-> b = k by arith(b8, hk)
    have e1: (bits_sub(8, b, k) = 0) <-> b = k by defs(simp(e1a), bits_sub)
    have hp: (int_lt(b, k) || bits_sub(8, b, k) = 0) = false || (int_lt(b, k) || bits_sub(8, b, k) = 0) = true
      by defs(imp_prop[a := !int_lt(b, k), b := bits_sub(8, b, k) = 0], is_prop, or)
    have e3 := mp(tr.prop_false, {int_lt(b, k) || bits_sub(8, b, k) = 0}, hp)
    have e2: (int_lt(b, k) || b = k) <-> !int_lt(k, b) by arith(b8, hk)
    show by simp(hf, e1, e2, e3, all_elim(x86.cond_eval, {f}, {6}))
  qed
  show := mp(tr.branch[s := s, v := v, base := base, code := code, fr := fr, a := a, a2 := a2, a3 := a3, t := t, cc := 6, hs := hs, ds := ds, rs := rs, p := p, w := w,
    ff := f. FF(f), c := int_lt(k, b)], h1, h2, h3, simp(ha2), simp(ha3), simp(hta), pa, pb)
qed

// movzx r32, byte [b + i] (b holding bv, i the pointer iv): g := the byte
// at iv + bv in the world's memory (usable there: the spec's load ok)
theorem tr.movzx8_ld: all s v base code fr a a2 len g b i z2 nb bv iv hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(79, pair(4, pair(g, pair(tag(2, fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(2, b)), "index", some(i)), "scale", 1), "disp", 0)),
      pair(tag(2, fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(2, b)), "index", some(i)), "scale", 1), "disp", 0)), z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> b in x86_64_linux.Reg -> i in x86_64_linux.Reg ->
  b in dom(rs) -> app(rs, b) = pair(nb, bv) -> i in dom(rs) -> app(rs, i) = pair(8, iv) ->
  gimple.usable(app(w, "vm"), app(w, "objs"), bits_add(64, iv, bv), 1, false) ->
  tr.pt(s, v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(1, bits_of_int(8, gimple.bytes_at(app(w, "vm"), bits_add(64, iv, bv), 1)))), p, w) ->
  tr.pt(s, v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g b i z2 nb bv iv hs ds rs p w
  assume hat ha2 hg hb hi0 hbd hbu hid hig hus hpt
  let A := bits_add(64, iv, bv)
  let BY := bits_of_int(8, gimple.bytes_at(app(w, "vm"), A, 1))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, ds) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(app(m, "gpr"), g, BY)), empty) proof
    fix m o
    assume hi hr hhs hrs hmm ho
    have ipM ipU ipC _ := apply(tr.inv_parts, hi)
    have mM := ipM
    have rb := apply(tr.regs_get, {m}, {rs}, {b}, {nb}, {bv}, hrs, hbd, hbu)
    have ri := apply(tr.regs_get, {m}, {rs}, {i}, {8}, {iv}, hrs, hid, hig)
    have tb := apply(x86i.reg_typed, mM, hb)
    have ti := apply(x86i.reg_typed, mM, hi0)
    have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
    have ea: bits_add(64, int_add(app(app(m, "gpr"), b), bits_mul(64, app(app(m, "gpr"), i), 1)), 0) = A by simp(rb, ri, tb, ti)
    have ab: A in bits(64) by simp()
    // the byte: the world's
    have ml := apply(tr.mem_load, {s}, {m}, {w}, {ds}, {A}, {1}, {false}, hmm, hus, ab, simp())
    have ac0: all j. j in omega -> int_lt(j, 1) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, A, bits_of_int(64, j)), 0) by taut(ml)
    have ac := rewrite(sym(ea), ac0)
    have le: x86_64_linux.le(app(app(m, "vm"), "bytes"), A, 1) = x86_64_linux.le(app(app(w, "vm"), "bytes"), A, 1) by taut(ml)
    have lw := all_elim(tr.le_bytes1, {app(w, "vm")}, {A})
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    have e := apply(x86i.movzx8_idx, {m}, {o}, {g}, {b}, {i}, {z2}, {len}, ipM, ipU, gR, hb, hi0, ac, hx)
    show by simp(e, ea, le, lw, hr, ha2, keep(gimple.bytes_at, x86_64_linux.le))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, ds) -> BY in bits(int_mul(8, 1)) && BY in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs, gimple.bytes_at))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0v, {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {1}, {BY}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// ----------------------------------------------------------------------
//  The spec's rest as a block: seq(a, k) = mkprog(x0 x1. ex x8. a(x0, x8)
//  && k(x8, x1)) -- the head a (from the world x0 to the outcome x8), the
//  rest k (from x8 to the final outcome x1). Each reduction: a run of the
//  reduced rest is a run of the rest (all o. runs(q2, w, o) -> runs(q, w, o)),
//  at the head only. The machine decides nothing here: a choice's witness,
//  a disjunct, are the reductions' instances; their guards are facts.

// (into the block form, the rest the identity)
theorem tr.qs_intro(x0 x1. a): all w o. runs(mkprog(x0 x1. ex x8. a(x0, x8) && x1 = x8), w, o) -> runs(mkprog(x0 x1. a(x0, x1)), w, o)
proof
  fix w
  have k: all o. (ex x8. a(w, x8) && o = x8) -> a(w, o) proof
    fix o
    assume h
    obtain y, hy from h
    have e: o = y by taut(hy)
    have ay: a(w, y) by taut(hy)
    show := rewrite(sym(e), ay)
  qed
  show := mp(tr.mkprog_mono[s := w, r1 := x0 x1. a(x0, x1), r2 := x0 x1. ex x8. a(x0, x8) && x1 = x8], k)
qed

// (the head done with the outcome v: the rest from v)
theorem tr.qs_ret(x0. v, x8 x1. k): all w o. runs(mkprog(x0 x1. k(v(x0), x1)), w, o) -> runs(mkprog(x0 x1. ex x8. x8 = v(x0) && k(x8, x1)), w, o)
proof
  fix w
  have g: all o. k(v(w), o) -> (ex x8. x8 = v(w) && k(x8, o)) proof
    fix o
    assume h
    show by ex_intro({v(w)}, taut(h, refl({v(w)})))
  qed
  show := mp(tr.mkprog_mono[s := w, r1 := x0 x1. ex x8. x8 = v(x0) && k(x8, x1), r2 := x0 x1. k(v(x0), x1)], g)
qed

theorem tr.qs_let(e, x0 x8 x. a, x8 x1. k): all w o. runs(mkprog(x0 x1. ex x8. a(x0, x8, e) && k(x8, x1)), w, o) ->
  runs(mkprog(x0 x1. ex x8. letin(e, x. a(x0, x8, x)) && k(x8, x1)), w, o)
proof
  fix w
  have g: all o. (ex x8. a(w, x8, e) && k(x8, o)) -> (ex x8. letin(e, x. a(w, x8, x)) && k(x8, o)) proof
    fix o
    assume h
    obtain y, hy from h
    have l: letin(e, x. a(w, y, x)) by defs(taut(hy), letin)
    show by ex_intro({y}, taut(l, hy))
  qed
  show := mp(tr.mkprog_mono[s := w, r1 := x0 x1. ex x8. letin(e, x. a(x0, x8, x)) && k(x8, x1), r2 := x0 x1. ex x8. a(x0, x8, e) && k(x8, x1)], g)
qed

theorem tr.qs_any(c, x. d, x0 x8 x. a, x8 x1. k): d(c) -> (all w o. runs(mkprog(x0 x1. ex x8. a(x0, x8, c) && k(x8, x1)), w, o) ->
  runs(mkprog(x0 x1. ex x8. any_rel(x. d(x), x. a(x0, x8, x)) && k(x8, x1)), w, o))
proof
  assume hc
  fix w
  have g: all o. (ex x8. a(w, x8, c) && k(x8, o)) -> (ex x8. any_rel(x. d(x), x. a(w, x8, x)) && k(x8, o)) proof
    fix o
    assume h
    obtain y, hy from h
    have dd: ex x. d(x) && a(w, y, x) by ex_intro({c}, taut(hc, hy))
    have ar: any_rel(x. d(x), x. a(w, y, x)) by defs(taut(dd), any_rel)
    show by ex_intro({y}, taut(ar, hy))
  qed
  show := mp(tr.mkprog_mono[s := w, r1 := x0 x1. ex x8. any_rel(x. d(x), x. a(x0, x8, x)) && k(x8, x1), r2 := x0 x1. ex x8. a(x0, x8, c) && k(x8, x1)], g)
qed

// an operation at the head, ok with the value r (the world unchanged)
theorem tr.qs_op(op, r, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k): all w. runs(op, w, ok(w, r)) ->
  (all o. runs(mkprog(x0 x1. ex x8. a(x0, r, x8) && k(x8, x1)), w, o) ->
    runs(mkprog(x0 x1. ex x8. bind_rel(op, x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), w, o))
proof
  fix w
  assume hq
  have g: all o. (ex x8. a(w, r, x8) && k(x8, o)) -> (ex x8. bind_rel(op, w, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, o)) proof
    fix o
    assume h
    obtain y, hy from h
    have ay: a(w, r, y) by taut(hy)
    have e: ex o2. runs(op, w, o2) && ((ex s1 v. o2 = ok(s1, v) && a(s1, v, y)) || (ex s1 e. o2 = exc(s1, e) && xx(s1, e, y)) || (ex t. o2 = diverge(t) && dd(t, y)))
      by ex_intro({ok(w, r)}, simp(hq, ay))
    have b: bind_rel(op, w, x9 x10. a(x9, x10, y), x9 x10. xx(x9, x10, y), x9. dd(x9, y)) by defs(e, bind_rel)
    show by ex_intro({y}, taut(b, hy))
  qed
  show := mp(tr.mkprog_mono[s := w, r1 := x0 x1. ex x8. bind_rel(op, x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1),
    r2 := x0 x1. ex x8. a(x0, r, x8) && k(x8, x1)], g)
qed

// an operation at the head, raising (s2, e): its handler
theorem tr.qs_raise(op, s2, e, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k): all w. runs(op, w, exc(s2, e)) ->
  (all o. runs(mkprog(x0 x1. ex x8. xx(s2, e, x8) && k(x8, x1)), w, o) ->
    runs(mkprog(x0 x1. ex x8. bind_rel(op, x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), w, o))
proof
  fix w
  assume hq
  have g: all o. (ex x8. xx(s2, e, x8) && k(x8, o)) -> (ex x8. bind_rel(op, w, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, o)) proof
    fix o
    assume h
    obtain y, hy from h
    have xy: xx(s2, e, y) by taut(hy)
    have e1: ex o2. runs(op, w, o2) && ((ex s1 v. o2 = ok(s1, v) && a(s1, v, y)) || (ex s1 e2. o2 = exc(s1, e2) && xx(s1, e2, y)) || (ex t. o2 = diverge(t) && dd(t, y)))
      by ex_intro({exc(s2, e)}, simp(hq, xy))
    have b: bind_rel(op, w, x9 x10. a(x9, x10, y), x9 x10. xx(x9, x10, y), x9. dd(x9, y)) by defs(e1, bind_rel)
    show by ex_intro({y}, taut(b, hy))
  qed
  show := mp(tr.mkprog_mono[s := w, r1 := x0 x1. ex x8. bind_rel(op, x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1),
    r2 := x0 x1. ex x8. xx(s2, e, x8) && k(x8, x1)], g)
qed

// a disjunct of the head; a guard of the head (a fact)
theorem tr.qs_orl(x0 x8. a, x0 x8. b, x8 x1. k): all w o. runs(mkprog(x0 x1. ex x8. a(x0, x8) && k(x8, x1)), w, o) ->
  runs(mkprog(x0 x1. ex x8. (a(x0, x8) || b(x0, x8)) && k(x8, x1)), w, o)
proof
  fix w
  have g: all o. (ex x8. a(w, x8) && k(x8, o)) -> (ex x8. (a(w, x8) || b(w, x8)) && k(x8, o)) proof
    fix o
    assume h
    obtain y, hy from h
    show by ex_intro({y}, taut(hy))
  qed
  show := mp(tr.mkprog_mono[s := w, r1 := x0 x1. ex x8. (a(x0, x8) || b(x0, x8)) && k(x8, x1), r2 := x0 x1. ex x8. a(x0, x8) && k(x8, x1)], g)
qed

theorem tr.qs_orr(x0 x8. a, x0 x8. b, x8 x1. k): all w o. runs(mkprog(x0 x1. ex x8. b(x0, x8) && k(x8, x1)), w, o) ->
  runs(mkprog(x0 x1. ex x8. (a(x0, x8) || b(x0, x8)) && k(x8, x1)), w, o)
proof
  fix w
  have g: all o. (ex x8. b(w, x8) && k(x8, o)) -> (ex x8. (a(w, x8) || b(w, x8)) && k(x8, o)) proof
    fix o
    assume h
    obtain y, hy from h
    show by ex_intro({y}, taut(hy))
  qed
  show := mp(tr.mkprog_mono[s := w, r1 := x0 x1. ex x8. (a(x0, x8) || b(x0, x8)) && k(x8, x1), r2 := x0 x1. ex x8. b(x0, x8) && k(x8, x1)], g)
qed

theorem tr.qs_and(c, x0 x8. a, x8 x1. k): c -> (all w o. runs(mkprog(x0 x1. ex x8. a(x0, x8) && k(x8, x1)), w, o) ->
  runs(mkprog(x0 x1. ex x8. (c && a(x0, x8)) && k(x8, x1)), w, o))
proof
  assume hc
  fix w
  have g: all o. (ex x8. a(w, x8) && k(x8, o)) -> (ex x8. (c && a(w, x8)) && k(x8, o)) proof
    fix o
    assume h
    obtain y, hy from h
    show by ex_intro({y}, taut(hc, hy))
  qed
  show := mp(tr.mkprog_mono[s := w, r1 := x0 x1. ex x8. (c && a(x0, x8)) && k(x8, x1), r2 := x0 x1. ex x8. a(x0, x8) && k(x8, x1)], g)
qed

// (a block at the head of a block: its rest before the outer rest)
theorem tr.qs_assoc(x0 x9. a, x9 x8. k1, x8 x1. k2): all w o. runs(mkprog(x0 x1. ex x9. a(x0, x9) && (ex x8. k1(x9, x8) && k2(x8, x1))), w, o) ->
  runs(mkprog(x0 x1. ex x8. (ex x9. a(x0, x9) && k1(x9, x8)) && k2(x8, x1)), w, o)
proof
  fix w
  have g: all o. (ex x9. a(w, x9) && (ex x8. k1(x9, x8) && k2(x8, o))) -> (ex x8. (ex x9. a(w, x9) && k1(x9, x8)) && k2(x8, o)) proof
    fix o
    assume h
    obtain y, hy from h
    have hy2: ex x8. k1(y, x8) && k2(x8, o) by taut(hy)
    obtain z, hz from hy2
    have i: ex x9. a(w, x9) && k1(x9, z) by ex_intro({y}, taut(hy, hz))
    show by ex_intro({z}, taut(i, hz))
  qed
  show := mp(tr.mkprog_mono[s := w, r1 := x0 x1. ex x8. (ex x9. a(x0, x9) && k1(x9, x8)) && k2(x8, x1),
    r2 := x0 x1. ex x9. a(x0, x9) && (ex x8. k1(x9, x8) && k2(x8, x1))], g)
qed

// a raising run of the rest x1 = exc(w2, e)
theorem tr.q_exc_runs: all w w2 e. w in univ(1) -> w2 in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. x1 = exc(w2, e)), w, exc(w2, e))
proof
  fix w w2 e
  assume hw hw2 he
  show by defs(simp(hw, hw2, he), runs, mkprog)
qed

// an operation's definedness c: undefined, the spec raises (the claim
// holds); defined, the claim from c
theorem tr.wsplit(s, v, base, code, fr, a, hs, ds, rs, w,q, x3 x4 x2. kw, c): (!c -> runs(q, w, exc(w, empty))) ->
  (c -> tr.pt(s, v, base, code, fr, a, hs, ds, rs, mkprog(x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w)) ->
  tr.pt(s, v, base, code, fr, a, hs, ds, rs, mkprog(x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w)
proof
  assume hu hd
  have nu: !c -> tr.pt(s, v, base, code, fr, a, hs, ds, rs, mkprog(x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w) proof
    assume hn
    show := mp(tr.wub[s := s, v := v, base := base, code := code, fr := fr, a := a, hs := hs, ds := ds, rs := rs, w := w, q := q, kw := x3 x4 x2. kw(x3, x4, x2)], mp(hu, hn))
  qed
  show by taut(hd, nu)
qed

// ----------------------------------------------------------------------
//  Evaluation in the rest: a projection of a constructed outcome (or
//  pair), anywhere in it (b's last argument), by its value

theorem tr.qe_fst_ok(x0 x1 y. b, x0. st, x0. vv): all w o. runs(mkprog(x0 x1. b(x0, x1, 0)), w, o) -> runs(mkprog(x0 x1. b(x0, x1, fst(ok(st(x0), vv(x0))))), w, o)
proof
  fix w
  have e: fst(ok(st(w), vv(w))) = 0 by defs(simp(), ok, exc, tag, out_state, out_value)
  have g: all o. b(w, o, 0) -> b(w, o, fst(ok(st(w), vv(w)))) proof
    fix o
    assume h
    show := subst({y. b(w, o, y)}, sym(e), h)
  qed
  show := mp(tr.mkprog_mono[s := w, r1 := x0 x1. b(x0, x1, fst(ok(st(x0), vv(x0)))), r2 := x0 x1. b(x0, x1, 0)], g)
qed

theorem tr.qe_fst_exc(x0 x1 y. b, x0. st, x0. vv): all w o. runs(mkprog(x0 x1. b(x0, x1, 1)), w, o) -> runs(mkprog(x0 x1. b(x0, x1, fst(exc(st(x0), vv(x0))))), w, o)
proof
  fix w
  have e: fst(exc(st(w), vv(w))) = 1 by defs(simp(), ok, exc, tag, out_state, out_value)
  have g: all o. b(w, o, 1) -> b(w, o, fst(exc(st(w), vv(w)))) proof
    fix o
    assume h
    show := subst({y. b(w, o, y)}, sym(e), h)
  qed
  show := mp(tr.mkprog_mono[s := w, r1 := x0 x1. b(x0, x1, fst(exc(st(x0), vv(x0)))), r2 := x0 x1. b(x0, x1, 1)], g)
qed

theorem tr.qe_os_ok(x0 x1 y. b, x0. st, x0. vv): all w o. runs(mkprog(x0 x1. b(x0, x1, st(x0))), w, o) -> runs(mkprog(x0 x1. b(x0, x1, out_state(ok(st(x0), vv(x0))))), w, o)
proof
  fix w
  have e: out_state(ok(st(w), vv(w))) = st(w) by defs(simp(), ok, exc, tag, out_state, out_value)
  have g: all o. b(w, o, st(w)) -> b(w, o, out_state(ok(st(w), vv(w)))) proof
    fix o
    assume h
    show := subst({y. b(w, o, y)}, sym(e), h)
  qed
  show := mp(tr.mkprog_mono[s := w, r1 := x0 x1. b(x0, x1, out_state(ok(st(x0), vv(x0)))), r2 := x0 x1. b(x0, x1, st(x0))], g)
qed

theorem tr.qe_ov_ok(x0 x1 y. b, x0. st, x0. vv): all w o. runs(mkprog(x0 x1. b(x0, x1, vv(x0))), w, o) -> runs(mkprog(x0 x1. b(x0, x1, out_value(ok(st(x0), vv(x0))))), w, o)
proof
  fix w
  have e: out_value(ok(st(w), vv(w))) = vv(w) by defs(simp(), ok, exc, tag, out_state, out_value)
  have g: all o. b(w, o, vv(w)) -> b(w, o, out_value(ok(st(w), vv(w)))) proof
    fix o
    assume h
    show := subst({y. b(w, o, y)}, sym(e), h)
  qed
  show := mp(tr.mkprog_mono[s := w, r1 := x0 x1. b(x0, x1, out_value(ok(st(x0), vv(x0)))), r2 := x0 x1. b(x0, x1, vv(x0))], g)
qed

theorem tr.qe_os_exc(x0 x1 y. b, x0. st, x0. vv): all w o. runs(mkprog(x0 x1. b(x0, x1, st(x0))), w, o) -> runs(mkprog(x0 x1. b(x0, x1, out_state(exc(st(x0), vv(x0))))), w, o)
proof
  fix w
  have e: out_state(exc(st(w), vv(w))) = st(w) by defs(simp(), ok, exc, tag, out_state, out_value)
  have g: all o. b(w, o, st(w)) -> b(w, o, out_state(exc(st(w), vv(w)))) proof
    fix o
    assume h
    show := subst({y. b(w, o, y)}, sym(e), h)
  qed
  show := mp(tr.mkprog_mono[s := w, r1 := x0 x1. b(x0, x1, out_state(exc(st(x0), vv(x0)))), r2 := x0 x1. b(x0, x1, st(x0))], g)
qed

theorem tr.qe_ov_exc(x0 x1 y. b, x0. st, x0. vv): all w o. runs(mkprog(x0 x1. b(x0, x1, vv(x0))), w, o) -> runs(mkprog(x0 x1. b(x0, x1, out_value(exc(st(x0), vv(x0))))), w, o)
proof
  fix w
  have e: out_value(exc(st(w), vv(w))) = vv(w) by defs(simp(), ok, exc, tag, out_state, out_value)
  have g: all o. b(w, o, vv(w)) -> b(w, o, out_value(exc(st(w), vv(w)))) proof
    fix o
    assume h
    show := subst({y. b(w, o, y)}, sym(e), h)
  qed
  show := mp(tr.mkprog_mono[s := w, r1 := x0 x1. b(x0, x1, out_value(exc(st(x0), vv(x0)))), r2 := x0 x1. b(x0, x1, vv(x0))], g)
qed

theorem tr.qe_fst_pair(x0 x1 y. b, x0. st, x0. vv): all w o. runs(mkprog(x0 x1. b(x0, x1, st(x0))), w, o) -> runs(mkprog(x0 x1. b(x0, x1, fst(pair(st(x0), vv(x0))))), w, o)
proof
  fix w
  have e: fst(pair(st(w), vv(w))) = st(w) by defs(simp(), ok, exc, tag, out_state, out_value)
  have g: all o. b(w, o, st(w)) -> b(w, o, fst(pair(st(w), vv(w)))) proof
    fix o
    assume h
    show := subst({y. b(w, o, y)}, sym(e), h)
  qed
  show := mp(tr.mkprog_mono[s := w, r1 := x0 x1. b(x0, x1, fst(pair(st(x0), vv(x0)))), r2 := x0 x1. b(x0, x1, st(x0))], g)
qed

theorem tr.qe_snd_pair(x0 x1 y. b, x0. st, x0. vv): all w o. runs(mkprog(x0 x1. b(x0, x1, vv(x0))), w, o) -> runs(mkprog(x0 x1. b(x0, x1, snd(pair(st(x0), vv(x0))))), w, o)
proof
  fix w
  have e: snd(pair(st(w), vv(w))) = vv(w) by defs(simp(), ok, exc, tag, out_state, out_value)
  have g: all o. b(w, o, vv(w)) -> b(w, o, snd(pair(st(w), vv(w)))) proof
    fix o
    assume h
    show := subst({y. b(w, o, y)}, sym(e), h)
  qed
  show := mp(tr.mkprog_mono[s := w, r1 := x0 x1. b(x0, x1, snd(pair(st(x0), vv(x0)))), r2 := x0 x1. b(x0, x1, vv(x0))], g)
qed

// ----------------------------------------------------------------------
//  GIMPLE's operations, with the values in the machine's forms: ok when
//  defined, raising (anything) when not

abbrev tr.s32_fits(x) := gimple.fits(fn_update(fn_update(empty, "prec", 32), "signed", true), x)

// (a signed sum's low 32 bits: the unsigned sum's)
theorem tr.sint_add32: all a b. a in bits(32) -> b in bits(32) ->
  int_mod(int_add(sint(32, a), sint(32, b)), 4294967296) = int_mod(int_add(a, b), 4294967296)
proof
  fix a b
  assume ha hb
  have sa: sint(32, a) = a || sint(32, a) = int_sub(a, 4294967296) by defs(simp(ha), sint)
  have sb: sint(32, b) = b || sint(32, b) = int_sub(b, 4294967296) by defs(simp(hb), sint)
  show by arith(ha, hb, sa, sb)
qed

theorem tr.sadd32_ok: all s a b. s in univ(1) -> a in bits(32) -> b in bits(32) -> tr.s32_fits(int_add(sint(32, a), sint(32, b))) ->
  runs(gimple.sadd(32, a, b), s, ok(s, bits_add(32, a, b)))
proof
  fix s a b
  assume hs ha hb hf
  have e := mp(tr.sint_add32, {a}, {b}, ha, hb)
  have v: bits_of_int(32, int_add(sint(32, a), sint(32, b))) = bits_add(32, a, b) by defs(simp(e), bits_of_int, bits_add)
  show by defs(simp(hs, ha, hb, hf, v), gimple.sadd, gimple.arith, gimple.wrap)
qed

theorem tr.sadd32_ub: all s a b s2 e. s in univ(1) -> s2 in univ(1) -> e in univ(1) -> !tr.s32_fits(int_add(sint(32, a), sint(32, b))) ->
  runs(gimple.sadd(32, a, b), s, exc(s2, e))
proof
  fix s a b s2 e
  assume hs h2 he hf
  show by defs(simp(hs, h2, he, hf), gimple.sadd, gimple.arith)
qed

// ... and a signed subtraction
theorem tr.sint_sub32: all a b. a in bits(32) -> b in bits(32) ->
  int_mod(int_sub(sint(32, a), sint(32, b)), 4294967296) = int_mod(int_sub(a, b), 4294967296)
proof
  fix a b
  assume ha hb
  have sa: sint(32, a) = a || sint(32, a) = int_sub(a, 4294967296) by defs(simp(ha), sint)
  have sb: sint(32, b) = b || sint(32, b) = int_sub(b, 4294967296) by defs(simp(hb), sint)
  show by arith(ha, hb, sa, sb)
qed

theorem tr.ssub32_ok: all s a b. s in univ(1) -> a in bits(32) -> b in bits(32) -> tr.s32_fits(int_sub(sint(32, a), sint(32, b))) ->
  runs(gimple.ssub(32, a, b), s, ok(s, bits_sub(32, a, b)))
proof
  fix s a b
  assume hs ha hb hf
  have e := mp(tr.sint_sub32, {a}, {b}, ha, hb)
  have v: bits_of_int(32, int_sub(sint(32, a), sint(32, b))) = bits_sub(32, a, b) by defs(simp(e), bits_of_int, bits_sub)
  show by defs(simp(hs, ha, hb, hf, v), gimple.ssub, gimple.arith, gimple.wrap)
qed

// (a literal first operand: the value with the literal, as the machine has it)
theorem tr.ssub32_ok_lit: all s k b. s in univ(1) -> k in bits(32) -> b in bits(32) -> tr.s32_fits(int_sub(sint(32, bits_of_int(32, k)), sint(32, b))) ->
  runs(gimple.ssub(32, bits_of_int(32, k), b), s, ok(s, bits_sub(32, k, b)))
proof
  fix s k b
  assume hs hk hb hf
  have p32: pow2(32) = 4294967296 by simp()
  have m32: int_mod(k, 4294967296) = k by arith(hk)
  have q: bits_of_int(32, k) = k by defs(rewrite(sym(p32), m32), bits_of_int)
  have hk2: bits_of_int(32, k) in bits(32) by rewrite(sym(q), hk)
  have o := mp(tr.ssub32_ok, {s}, {bits_of_int(32, k)}, {b}, hs, hk2, hb, hf)
  // (the value's literal, not the program's)
  show := rewrite(q, o, {2})
qed

theorem tr.ssub32_ub: all s a b s2 e. s in univ(1) -> s2 in univ(1) -> e in univ(1) -> !tr.s32_fits(int_sub(sint(32, a), sint(32, b))) ->
  runs(gimple.ssub(32, a, b), s, exc(s2, e))
proof
  fix s a b s2 e
  assume hs h2 he hf
  show by defs(simp(hs, h2, he, hf), gimple.ssub, gimple.arith)
qed

// p + d, d a non-negative 64-bit offset (a field's)
theorem tr.padd_ok: all s p d. s in univ(1) -> p in bits(64) -> d in bits(64) -> int_lt(d, 9223372036854775808) -> int_lt(int_add(p, d), 18446744073709551616) ->
  runs(gimple.padd(p, d), s, ok(s, int_add(p, d)))
proof
  fix s p d
  assume hs hp hd hd2 hl
  have sv: gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), d) = d by defs(simp(hd2), gimple.sval)
  have p64: pow2(64) = 18446744073709551616 by simp()
  have hl2 := rewrite(sym(p64), hl)
  have o := mp(g.padd_ok, {s}, {p}, {d}, hs, hp, hd, simp(sv, hp, hd), simp(sv, hl2))
  show := rewrite(sv, o)
qed

// an array's byte element at a sign-extended 32-bit index: p + i
abbrev tr.elem_sx_def(p, i) := int_le(0, int_add(p, sint(32, i))) && int_lt(int_add(p, sint(32, i)), 18446744073709551616)

// (the sign-extended index: its 64-bit value, its signed value)
theorem tr.sext_vals: all i. i in bits(32) ->
  bits_sext(32, 64, i) in bits(64) && sint(64, bits_sext(32, 64, i)) = sint(32, i) &&
  gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), bits_sext(32, 64, i)) = sint(32, i) &&
  int_le(int_neg(2147483648), sint(32, i)) && int_lt(sint(32, i), 2147483648)
proof
  fix i
  assume hi
  have c1: int_lt(i, 2147483648) -> bits_sext(32, 64, i) in bits(64) && sint(64, bits_sext(32, 64, i)) = sint(32, i) &&
      gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), bits_sext(32, 64, i)) = sint(32, i) &&
      int_le(int_neg(2147483648), sint(32, i)) && int_lt(sint(32, i), 2147483648) proof
    assume hl
    have s1: sint(32, i) = i by defs(simp(hi, hl), sint)
    have x1: bits_sext(32, 64, i) = i by defs(simp(hi, hl), bits_sext, sint)
    have s2: sint(64, i) = i by defs(simp(hi, hl), sint)
    have v2: gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), i) = i by defs(simp(hi, hl), gimple.sval)
    show by simp(s1, x1, s2, v2, hi, hl)
  qed
  have c2: !int_lt(i, 2147483648) -> bits_sext(32, 64, i) in bits(64) && sint(64, bits_sext(32, 64, i)) = sint(32, i) &&
      gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), bits_sext(32, 64, i)) = sint(32, i) &&
      int_le(int_neg(2147483648), sint(32, i)) && int_lt(sint(32, i), 2147483648) proof
    assume hl
    have s1: sint(32, i) = int_sub(i, 4294967296) by defs(simp(hi, hl), sint)
    have m1: int_mod(int_sub(i, 4294967296), 18446744073709551616) = int_add(i, 18446744069414584320) by arith(hi, hl)
    have x1: bits_sext(32, 64, i) = int_add(i, 18446744069414584320) by defs(simp(hi, hl, m1), bits_sext, sint, bits_of_int)
    have b1: int_add(i, 18446744069414584320) in bits(64) by simp(hi, hl)
    have s2: sint(64, int_add(i, 18446744069414584320)) = int_sub(i, 4294967296) by defs(simp(hi, hl, b1), sint)
    have v2: gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), int_add(i, 18446744069414584320)) = int_sub(i, 4294967296) by defs(simp(hi, hl), gimple.sval)
    show by simp(s1, x1, b1, s2, v2, hi, hl)
  qed
  show by taut(c1, c2)
qed

// (the index times 1)
theorem tr.smul_sx1: all s i. s in univ(1) -> i in bits(32) -> runs(gimple.smul(64, bits_sext(32, 64, i), bits_of_int(64, 1)), s, ok(s, bits_sext(32, 64, i)))
proof
  fix s i
  assume hs hi
  have sv := mp(tr.sext_vals, {i}, hi)
  have xb: bits_sext(32, 64, i) in bits(64) by taut(sv)
  have f: gimple.fits(fn_update(fn_update(empty, "prec", 64), "signed", true), sint(32, i)) by defs(simp(sv), gimple.fits)
  have w: bits_of_int(64, gimple.wrap(fn_update(fn_update(empty, "prec", 64), "signed", true), sint(32, i))) = bits_sext(32, 64, i) by defs(simp(), gimple.wrap, bits_sext, bits_of_int)
  show by defs(simp(hs, sv, xb, f, w), gimple.smul, gimple.arith)
qed

theorem tr.elem1_sx_ok: all s p i. s in univ(1) -> p in bits(64) -> i in bits(32) -> tr.elem_sx_def(p, i) ->
  runs(gimple.elem(p, bits_sext(32, 64, i), 1), s, ok(s, bits_add(64, p, bits_sext(32, 64, i))))
proof
  fix s p i
  assume hs hp hi hd
  let X := bits_sext(32, 64, i)
  have sv := mp(tr.sext_vals, {i}, hi)
  have xb: X in bits(64) by taut(sv)
  have sm := mp(tr.smul_sx1, {s}, {i}, hs, hi)
  have h0: int_le(0, int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), X))) by simp(sv, hd)
  have p64: pow2(64) = 18446744073709551616 by simp()
  have h1: int_lt(int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), X)), pow2(64)) by simp(sv, hd, p64)
  have pa0 := mp(g.padd_ok, {s}, {p}, {X}, hs, hp, xb, h0, h1)
  have svx: gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), X) = sint(32, i) by taut(sv)
  have bdef: bits_add(64, p, X) = int_mod(int_add(p, X), 18446744073709551616) by defs(simp(), bits_add)
  have ev: int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), X)) = bits_add(64, p, X) proof
    have c1: int_lt(i, 2147483648) -> int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), X)) = bits_add(64, p, X) proof
      assume hl
      have s1: sint(32, i) = i by defs(simp(hi, hl), sint)
      have x1: X = i by defs(simp(hi, hl), bits_sext, sint)
      show by arith(svx, bdef, x1, s1, hd, hp, hi, hl)
    qed
    have c2: !int_lt(i, 2147483648) -> int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), X)) = bits_add(64, p, X) proof
      assume hl
      have s1: sint(32, i) = int_sub(i, 4294967296) by defs(simp(hi, hl), sint)
      have m1: int_mod(int_sub(i, 4294967296), 18446744073709551616) = int_add(i, 18446744069414584320) by arith(hi, hl)
      have x1: X = int_add(i, 18446744069414584320) by defs(simp(hi, hl, m1), bits_sext, sint, bits_of_int)
      show by arith(svx, bdef, x1, s1, hd, hp, hi, hl)
    qed
    show by taut(c1, c2)
  qed
  have pa := rewrite(ev, pa0)
  show by defs(simp(hs, hp, xb, sm, pa, keep(gimple.padd, gimple.smul)), gimple.elem)
qed

// p + d outside the address range: anything (a raise from any state)
abbrev tr.padd_def(p, d) := int_le(0, int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), d))) &&
  int_lt(int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), d)), 18446744073709551616)

theorem tr.padd_ub: all s p d s2 e. s in univ(1) -> s2 in univ(1) -> e in univ(1) -> p in bits(64) -> d in bits(64) -> !tr.padd_def(p, d) ->
  runs(gimple.padd(p, d), s, exc(s2, e))
proof
  fix s p d s2 e
  assume hs h2 he hp hd hn
  show by defs(simp(hs, h2, he, hp, hd, hn), gimple.padd, gimple.binop, gimple.fits, gimple.wrap, gimple.arith)
qed

theorem tr.elem1_sx_ub: all s p i s2 e. s in univ(1) -> s2 in univ(1) -> e in univ(1) -> p in bits(64) -> i in bits(32) -> !tr.elem_sx_def(p, i) ->
  runs(gimple.elem(p, bits_sext(32, 64, i), 1), s, exc(s2, e))
proof
  fix s p i s2 e
  assume hs h2 he hp hi hn
  let X := bits_sext(32, 64, i)
  have sv := mp(tr.sext_vals, {i}, hi)
  have xb: X in bits(64) by taut(sv)
  have sm := mp(tr.smul_sx1, {s}, {i}, hs, hi)
  have svx: gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), X) = sint(32, i) by taut(sv)
  have nd: !tr.padd_def(p, X) by simp(hn, svx)
  have pu := mp(tr.padd_ub, {s}, {p}, {X}, {s2}, {e}, hs, h2, he, hp, xb, nd)
  have sm1: runs(gimple.smul(64, X, 1), s, ok(s, X)) by simp(sm, keep(gimple.smul))
  have wi: ex x0. ex x1. runs(gimple.smul(64, X, 1), s, ok(x0, x1)) && runs(gimple.padd(p, x1), x0, exc(s2, e)) by ex_intro({s}, ex_intro({X}, taut(sm1, pu)))
  show by defs(simp(hs, hp, xb, wi, h2, he, keep(gimple.padd, gimple.smul)), gimple.elem)
qed

// an array's byte element at a 32-bit (unsigned) index: p + i
abbrev tr.elem_u_def(p, i) := int_lt(int_add(p, i), 18446744073709551616)

theorem tr.elem1_u_ok: all s p i. s in univ(1) -> p in bits(64) -> i in bits(32) -> tr.elem_u_def(p, i) ->
  runs(gimple.elem(p, i, 1), s, ok(s, bits_add(64, p, i)))
proof
  fix s p i
  assume hs hp hi hd
  have p64: pow2(64) = 18446744073709551616 by simp()
  have hl := rewrite(sym(p64), hd)
  have eo := mp(g.elem1_ok, {s}, {p}, {i}, hs, hp, hi, hl)
  have bdef: bits_add(64, p, i) = int_mod(int_add(p, i), 18446744073709551616) by defs(simp(), bits_add)
  have ev: int_add(p, i) = bits_add(64, p, i) by arith(bdef, hp, hi, hd)
  show := rewrite(ev, eo)
qed

theorem tr.elem1_u_ub: all s p i s2 e. s in univ(1) -> s2 in univ(1) -> e in univ(1) -> p in bits(64) -> i in bits(32) -> !tr.elem_u_def(p, i) ->
  runs(gimple.elem(p, i, 1), s, exc(s2, e))
proof
  fix s p i s2 e
  assume hs h2 he hp hi hn
  have ib: i in bits(64) by simp(hi)
  have sm: runs(gimple.smul(64, i, bits_of_int(64, 1)), s, ok(s, i))
    by defs(simp(hs, hi, ib), gimple.smul, gimple.arith, gimple.fits, gimple.wrap, sint, bits_of_int)
  have svi: gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), i) = i by defs(simp(hi), gimple.sval)
  have nd: !tr.padd_def(p, i) by simp(hn, svi)
  have pu := mp(tr.padd_ub, {s}, {p}, {i}, {s2}, {e}, hs, h2, he, hp, ib, nd)
  have sm1: runs(gimple.smul(64, i, 1), s, ok(s, i)) by simp(sm, keep(gimple.smul))
  have wi: ex x0. ex x1. runs(gimple.smul(64, i, 1), s, ok(x0, x1)) && runs(gimple.padd(p, x1), x0, exc(s2, e)) by ex_intro({s}, ex_intro({i}, taut(sm1, pu)))
  show by defs(simp(hs, hp, ib, wi, h2, he, keep(gimple.padd, gimple.smul)), gimple.elem)
qed

// p + d (any d, a pointer p): defined, p + d in 64 bits
theorem tr.padd_okb: all s p d. s in univ(1) -> p in bits(64) -> d in bits(64) -> tr.padd_def(p, d) ->
  runs(gimple.padd(p, d), s, ok(s, bits_add(64, p, d)))
proof
  fix s p d
  assume hs hp hd hdf
  let SV := gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), d)
  have p64: pow2(64) = 18446744073709551616 by simp()
  have h0: int_le(0, int_add(p, SV)) by taut(hdf)
  have h1a: int_lt(int_add(p, SV), 18446744073709551616) by taut(hdf)
  have h1 := rewrite(sym(p64), h1a)
  have o := mp(g.padd_ok, {s}, {p}, {d}, hs, hp, hd, h0, h1)
  have sv: SV = d || SV = int_sub(d, 18446744073709551616) by defs(simp(hd), gimple.sval)
  have bdef: bits_add(64, p, d) = int_mod(int_add(p, d), 18446744073709551616) by defs(simp(), bits_add)
  have c1: SV = d -> int_add(p, SV) = bits_add(64, p, d) proof
    assume e
    have l0 := rewrite(e, h0)
    have l1 := rewrite(e, h1a)
    have m: int_mod(int_add(p, d), 18446744073709551616) = int_add(p, d) by arith(l0, l1)
    show by simp(e, m, bdef)
  qed
  have c2: SV = int_sub(d, 18446744073709551616) -> int_add(p, SV) = bits_add(64, p, d) proof
    assume e
    have l0 := rewrite(e, h0)
    have l1 := rewrite(e, h1a)
    have m: int_mod(int_add(p, d), 18446744073709551616) = int_add(p, int_sub(d, 18446744073709551616)) by arith(l0, l1, hp, hd)
    show by simp(e, m, bdef)
  qed
  have ev: int_add(p, SV) = bits_add(64, p, d) by taut(sv, c1, c2)
  show := rewrite(ev, o)
qed

// ----------------------------------------------------------------------
//  Calls of one-operation helpers (a field's accessor): the call's run from
//  its operation's

theorem tr.call1_ok(op, r, x. f): all w. w in univ(1) -> f(r) in univ(1) -> runs(op, w, ok(w, r)) ->
  runs(mkprog(x0 x1. bind_rel(op, x0, x2 x3. x1 = ok(x2, f(x3)), x2 x3. x1 = exc(x2, x3), x2. x1 = diverge(x2))), w, ok(w, f(r)))
proof
  fix w
  assume hw hf hq
  have b: bind_rel(op, w, x2 x3. ok(w, f(r)) = ok(x2, f(x3)), x2 x3. ok(w, f(r)) = exc(x2, x3), x2. ok(w, f(r)) = diverge(x2))
    by defs(ex_intro({ok(w, r)}, simp(hq, keep(runs))), bind_rel)
  have pu: pair(w, ok(w, f(r))) in univ(1) by simp(hw, hf)
  show := mp(all_elim(tr.runs_intro[r := x0 x1. bind_rel(op, x0, x2 x3. x1 = ok(x2, f(x3)), x2 x3. x1 = exc(x2, x3), x2. x1 = diverge(x2))], {w}, {ok(w, f(r))}), pu, b)
qed

theorem tr.call1_ub(op, s2, e, x. f): all w. w in univ(1) -> s2 in univ(1) -> e in univ(1) -> runs(op, w, exc(s2, e)) ->
  runs(mkprog(x0 x1. bind_rel(op, x0, x2 x3. x1 = ok(x2, f(x3)), x2 x3. x1 = exc(x2, x3), x2. x1 = diverge(x2))), w, exc(s2, e))
proof
  fix w
  assume hw h2 he hq
  have b: bind_rel(op, w, x2 x3. exc(s2, e) = ok(x2, f(x3)), x2 x3. exc(s2, e) = exc(x2, x3), x2. exc(s2, e) = diverge(x2))
    by defs(ex_intro({exc(s2, e)}, simp(hq, keep(runs))), bind_rel)
  have pu: pair(w, exc(s2, e)) in univ(1) by simp(hw, h2, he)
  show := mp(all_elim(tr.runs_intro[r := x0 x1. bind_rel(op, x0, x2 x3. x1 = ok(x2, f(x3)), x2 x3. x1 = exc(x2, x3), x2. x1 = diverge(x2))], {w}, {exc(s2, e)}), pu, b)
qed

// ----------------------------------------------------------------------
//  Bitfield loads: n bytes at p + off (the machine's address form), bits
//  pos.. of them, k of them

theorem tr.ldbf_ok: all s p off n pos k. s in univ(1) -> p in bits(64) -> off in bits(32) -> g.mem_defined(s, p, off, n, false) ->
  runs(gimple.ldbf(p, off, n, pos, k), s, ok(s, int_mod(int_div(gimple.bytes_at(app(s, "vm"), bits_add(64, p, off), n), int_pow(2, pos)), int_pow(2, k))))
proof
  fix s p off n pos k
  assume hs hp ho hd
  have o := mp(g.ldbf_ok, {s}, {p}, {off}, {n}, {pos}, {k}, hs, hp, ho, hd)
  have p64: pow2(64) = 18446744073709551616 by simp()
  have lt0: int_lt(int_add(p, off), pow2(64)) by taut(hd)
  have lt := rewrite(p64, lt0)
  have bdef: bits_add(64, p, off) = int_mod(int_add(p, off), 18446744073709551616) by defs(simp(), bits_add)
  have ev: int_add(p, off) = bits_add(64, p, off) by arith(bdef, hp, ho, lt)
  show := rewrite(ev, o)
qed

// (a whole field of n bits: the bytes themselves; n 8, 16, 32 or 64)
theorem tr.bits_field0_8: all x. bits_of_int(8, int_mod(int_div(x, int_pow(2, 0)), int_pow(2, 8))) = bits_of_int(8, x)
proof
  fix x
  have e: int_mod(int_mod(x, 256), 256) = int_mod(x, 256) by arith()
  show by defs(simp(e), bits_of_int, pow2)
qed

theorem tr.bits_field0_16: all x. bits_of_int(16, int_mod(int_div(x, int_pow(2, 0)), int_pow(2, 16))) = bits_of_int(16, x)
proof
  fix x
  have e: int_mod(int_mod(x, 65536), 65536) = int_mod(x, 65536) by arith()
  show by defs(simp(e), bits_of_int, pow2)
qed

theorem tr.bits_field0_32: all x. bits_of_int(32, int_mod(int_div(x, int_pow(2, 0)), int_pow(2, 32))) = bits_of_int(32, x)
proof
  fix x
  have e: int_mod(int_mod(x, 4294967296), 4294967296) = int_mod(x, 4294967296) by arith()
  show by defs(simp(e), bits_of_int, pow2)
qed

theorem tr.bits_field0_64: all x. bits_of_int(64, int_mod(int_div(x, int_pow(2, 0)), int_pow(2, 64))) = bits_of_int(64, x)
proof
  fix x
  have e: int_mod(int_mod(x, 18446744073709551616), 18446744073709551616) = int_mod(x, 18446744073709551616) by arith()
  show by defs(simp(e), bits_of_int, pow2)
qed

// (the spec's rest with a closed term replaced by an equal one)
theorem tr.qe_eq(x0 x1 y. b, e, e2): e = e2 -> (all w o. runs(mkprog(x0 x1. b(x0, x1, e2)), w, o) -> runs(mkprog(x0 x1. b(x0, x1, e)), w, o))
proof
  assume he
  fix w
  have g: all o. b(w, o, e2) -> b(w, o, e) proof
    fix o
    assume h
    show := subst({y. b(w, o, y)}, sym(he), h)
  qed
  show := mp(tr.mkprog_mono[s := w, r1 := x0 x1. b(x0, x1, e), r2 := x0 x1. b(x0, x1, e2)], g)
qed

// ----------------------------------------------------------------------
//  An array's 2-byte element at a sign-extended 32-bit index: p + 2i

abbrev tr.elem2_sx_def(p, i) := int_le(0, int_add(p, int_mul(2, sint(32, i)))) && int_lt(int_add(p, int_mul(2, sint(32, i))), 18446744073709551616)

// (the index times 2)
theorem tr.smul_sx2: all s i. s in univ(1) -> i in bits(32) ->
  runs(gimple.smul(64, bits_sext(32, 64, i), bits_of_int(64, 2)), s, ok(s, bits_add(64, bits_sext(32, 64, i), bits_sext(32, 64, i))))
proof
  fix s i
  assume hs hi
  have sv := mp(tr.sext_vals, {i}, hi)
  have xb: bits_sext(32, 64, i) in bits(64) by taut(sv)
  have s64: sint(64, bits_sext(32, 64, i)) = sint(32, i) by taut(sv)
  have lo: int_le(int_neg(2147483648), sint(32, i)) by taut(sv)
  have hi2: int_lt(sint(32, i), 2147483648) by taut(sv)
  have f: gimple.fits(fn_update(fn_update(empty, "prec", 64), "signed", true), int_mul(sint(32, i), 2)) by defs(simp(lo, hi2), gimple.fits)
  have xd: bits_sext(32, 64, i) = int_mod(sint(32, i), 18446744073709551616) by defs(simp(), bits_sext, bits_of_int, pow2)
  have w0: int_mod(int_mul(sint(32, i), 2), 18446744073709551616) = int_mod(int_add(int_mod(sint(32, i), 18446744073709551616), int_mod(sint(32, i), 18446744073709551616)), 18446744073709551616) by arith(lo, hi2)
  have w: bits_of_int(64, gimple.wrap(fn_update(fn_update(empty, "prec", 64), "signed", true), int_mul(sint(32, i), 2))) = bits_add(64, bits_sext(32, 64, i), bits_sext(32, 64, i))
    by defs(simp(w0, xd), gimple.wrap, bits_of_int, bits_add, pow2)
  show by defs(simp(hs, s64, xb, f, w), gimple.smul, gimple.arith)
qed

theorem tr.elem2_sx_ok: all s p i. s in univ(1) -> p in bits(64) -> i in bits(32) -> tr.elem2_sx_def(p, i) ->
  runs(gimple.elem(p, bits_sext(32, 64, i), 2), s, ok(s, bits_add(64, p, bits_add(64, bits_sext(32, 64, i), bits_sext(32, 64, i)))))
proof
  fix s p i
  assume hs hp hi hd
  let X := bits_add(64, bits_sext(32, 64, i), bits_sext(32, 64, i))
  have sv := mp(tr.sext_vals, {i}, hi)
  have lo: int_le(int_neg(2147483648), sint(32, i)) by taut(sv)
  have hi2: int_lt(sint(32, i), 2147483648) by taut(sv)
  have sm := mp(tr.smul_sx2, {s}, {i}, hs, hi)
  have xd: bits_sext(32, 64, i) = int_mod(sint(32, i), 18446744073709551616) by defs(simp(), bits_sext, bits_of_int, pow2)
  have xa: X = int_mod(int_add(bits_sext(32, 64, i), bits_sext(32, 64, i)), 18446744073709551616) by defs(simp(), bits_add, pow2)
  have xv: X = int_mod(int_mul(2, sint(32, i)), 18446744073709551616) by arith(xa, xd, lo, hi2)
  have xb: X in bits(64) by simp()
  have svx: gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), X) = int_mul(2, sint(32, i)) proof
    have c1: int_le(0, sint(32, i)) -> gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), X) = int_mul(2, sint(32, i)) proof
      assume h0
      have m: int_mod(int_mul(2, sint(32, i)), 18446744073709551616) = int_mul(2, sint(32, i)) by arith(h0, hi2)
      show by defs(simp(xv, m, h0, hi2), gimple.sval)
    qed
    have c2: !int_le(0, sint(32, i)) -> gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), X) = int_mul(2, sint(32, i)) proof
      assume h0
      have m: int_mod(int_mul(2, sint(32, i)), 18446744073709551616) = int_add(int_mul(2, sint(32, i)), 18446744073709551616) by arith(h0, lo)
      show by defs(simp(xv, m, h0, lo), gimple.sval)
    qed
    show by taut(c1, c2)
  qed
  have h0: int_le(0, int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), X))) by simp(svx, hd)
  have p64: pow2(64) = 18446744073709551616 by simp()
  have h1: int_lt(int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), X)), pow2(64)) by simp(svx, hd, p64)
  have pa0 := mp(g.padd_ok, {s}, {p}, {X}, hs, hp, xb, h0, h1)
  have bdef: bits_add(64, p, X) = int_mod(int_add(p, X), 18446744073709551616) by defs(simp(), bits_add)
  have ev: int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), X)) = bits_add(64, p, X) by arith(svx, bdef, xv, hd, hp, lo, hi2)
  have pa := rewrite(ev, pa0)
  show by defs(simp(hs, hp, xb, sm, pa, keep(gimple.padd, gimple.smul)), gimple.elem)
qed

theorem tr.elem2_sx_ub: all s p i s2 e. s in univ(1) -> s2 in univ(1) -> e in univ(1) -> p in bits(64) -> i in bits(32) -> !tr.elem2_sx_def(p, i) ->
  runs(gimple.elem(p, bits_sext(32, 64, i), 2), s, exc(s2, e))
proof
  fix s p i s2 e
  assume hs h2 he hp hi hn
  let X := bits_add(64, bits_sext(32, 64, i), bits_sext(32, 64, i))
  have sv := mp(tr.sext_vals, {i}, hi)
  have lo: int_le(int_neg(2147483648), sint(32, i)) by taut(sv)
  have hi2: int_lt(sint(32, i), 2147483648) by taut(sv)
  have sm := mp(tr.smul_sx2, {s}, {i}, hs, hi)
  have xd: bits_sext(32, 64, i) = int_mod(sint(32, i), 18446744073709551616) by defs(simp(), bits_sext, bits_of_int, pow2)
  have xa: X = int_mod(int_add(bits_sext(32, 64, i), bits_sext(32, 64, i)), 18446744073709551616) by defs(simp(), bits_add, pow2)
  have xv: X = int_mod(int_mul(2, sint(32, i)), 18446744073709551616) by arith(xa, xd, lo, hi2)
  have xb: X in bits(64) by simp()
  have svx: gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), X) = int_mul(2, sint(32, i)) proof
    have c1: int_le(0, sint(32, i)) -> gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), X) = int_mul(2, sint(32, i)) proof
      assume h0
      have m: int_mod(int_mul(2, sint(32, i)), 18446744073709551616) = int_mul(2, sint(32, i)) by arith(h0, hi2)
      show by defs(simp(xv, m, h0, hi2), gimple.sval)
    qed
    have c2: !int_le(0, sint(32, i)) -> gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), X) = int_mul(2, sint(32, i)) proof
      assume h0
      have m: int_mod(int_mul(2, sint(32, i)), 18446744073709551616) = int_add(int_mul(2, sint(32, i)), 18446744073709551616) by arith(h0, lo)
      show by defs(simp(xv, m, h0, lo), gimple.sval)
    qed
    show by taut(c1, c2)
  qed
  have nd: !tr.padd_def(p, X) by simp(hn, svx)
  have pu := mp(tr.padd_ub, {s}, {p}, {X}, {s2}, {e}, hs, h2, he, hp, xb, nd)
  have sm1: runs(gimple.smul(64, bits_sext(32, 64, i), 2), s, ok(s, X)) by simp(sm, keep(gimple.smul))
  have wi: ex x0. ex x1. runs(gimple.smul(64, bits_sext(32, 64, i), 2), s, ok(x0, x1)) && runs(gimple.padd(p, x1), x0, exc(s2, e)) by ex_intro({s}, ex_intro({X}, taut(sm1, pu)))
  show by defs(simp(hs, hp, xb, wi, h2, he, keep(gimple.padd, gimple.smul)), gimple.elem)
qed

// ----------------------------------------------------------------------
//  A signed 32-bit product by an immediate k (tr.imul_by(k): its low 32
//  bits the unsigned product's)

theorem tr.smul32_ok: all s a k. s in univ(1) -> a in bits(32) -> k in bits(32) -> tr.imul_by(k) -> tr.s32_fits(int_mul(sint(32, a), sint(32, k))) ->
  runs(gimple.smul(32, a, k), s, ok(s, bits_mul(32, a, k)))
proof
  fix s a k
  assume hs ha hk hb hf
  have e := mp(all_elim(expand(hb, tr.imul_by), {a}), ha)
  have v: bits_of_int(32, int_mul(sint(32, a), sint(32, k))) = bits_mul(32, a, k) by defs(simp(e), bits_of_int, bits_add)
  show by defs(simp(hs, ha, hk, hf, v), gimple.smul, gimple.arith, gimple.wrap)
qed

theorem tr.smul32_ub: all s a k s2 e. s in univ(1) -> s2 in univ(1) -> e in univ(1) -> !tr.s32_fits(int_mul(sint(32, a), sint(32, k))) ->
  runs(gimple.smul(32, a, k), s, exc(s2, e))
proof
  fix s a k s2 e
  assume hs h2 he hf
  show by defs(simp(hs, h2, he, hf), gimple.smul, gimple.arith)
qed

// ----------------------------------------------------------------------
//  A 64-bit result

theorem tr.result64: all w bigv. w in univ(1) -> bigv in bits(int_mul(8, 8)) -> (all y. y in bits(64) ->
  runs(mkprog(x1 x2. letin(bigv, x5. bind_rel(gimple.result(64, x5), x1, x6 x7. any_rel(x8. x8 in bits(64), x8. x2 = ok(x6, pair(x7, x8))), x6 x7. x2 = exc(x6, x7), x6. x2 = diverge(x6)))), w, ok(w, pair(bigv, y))))
proof
  fix w bigv
  assume hw hb
  fix y
  assume hy
  have b64: bigv in bits(64) by simp(hb)
  have ro := apply(g.result64_ok, {w}, {bigv}, hw, b64)
  have k: bind_rel(gimple.result(64, bigv), w, x6 x7. any_rel(x8. x8 in bits(64), x8. ok(w, pair(bigv, y)) = ok(x6, pair(x7, x8))), x6 x7. ok(w, pair(bigv, y)) = exc(x6, x7), x6. ok(w, pair(bigv, y)) = diverge(x6))
    by defs(ex_intro({ok(w, bigv)}, simp(ro, hy, keep(runs, gimple.result))), bind_rel)
  have pu: pair(w, ok(w, pair(bigv, y))) in univ(1) by simp(hw, b64, hy)
  have r := mp(mp(all_elim(tr.runs_intro[r := x1 x2. letin(bigv, x5. bind_rel(gimple.result(64, x5), x1, x6 x7. any_rel(x8. x8 in bits(64), x8. x2 = ok(x6, pair(x7, x8))), x6 x7. x2 = exc(x6, x7), x6. x2 = diverge(x6)))],
    {w}, {ok(w, pair(bigv, y))}), pu), defs(k, letin))
  show := r
qed

// ----------------------------------------------------------------------
//  Loads at [b + d] (b holding the pointer bp; the spec's field load of n
//  bytes at bp + d defined), byte and word loads at [b + i]

// (a load the spec makes on w's memory: the machine can make it)
theorem tr.reads: all s m w ds g off n. g in bits(64) -> off in bits(32) -> g.mem_defined(w, g, off, n, false) -> tr.mem(s, m, w, ds) -> n in omega ->
  (all i. i in omega -> int_lt(i, n) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, bits_add(64, g, off), bits_of_int(64, i)), 0)) &&
  x86_64_linux.le(app(app(m, "vm"), "bytes"), bits_add(64, g, off), n) = x86_64_linux.le(app(app(w, "vm"), "bytes"), bits_add(64, g, off), n)
proof
  fix s m w ds g off n
  assume hg ho hd hmm hn
  have ea: bits_add(64, g, off) = int_add(g, off) by simp(hg, ho, hd)
  have hus: gimple.usable(app(w, "vm"), app(w, "objs"), bits_add(64, g, off), n, false) by simp(hd, ea)
  show := apply(tr.mem_load, {s}, {m}, {w}, {ds}, {bits_add(64, g, off)}, {n}, {false}, hmm, hus, simp(), hn)
qed

// (n bytes read little-endian: GIMPLE's bytes)
theorem tr.le_bytes: all vm a n. x86_64_linux.le(app(vm, "bytes"), a, n) = bits_of_int(int_mul(8, n), gimple.bytes_at(vm, a, n))
proof
  fix vm a n
  show by defs(simp(), x86_64_linux.le, gimple.bytes_at)
qed

// movzx r32, byte [b + d]: g := the byte
theorem tr.movzx8_bd: all s v base code fr a a2 len g b d z2 bp hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(79, pair(4, pair(g, pair(tag(2, fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(2, b)), "index", none), "scale", 1), "disp", d)), pair(tag(2, fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(2, b)), "index", none), "scale", 1), "disp", d)), z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> b in x86_64_linux.Reg -> d in bits(32) -> b in dom(rs) -> app(rs, b) = pair(8, bp) ->
  g.mem_defined(w, bp, d, 1, false) ->
  tr.pt(s, v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(1, bits_of_int(8, gimple.bytes_at(app(w, "vm"), bits_add(64, bp, d), 1)))), p, w) -> tr.pt(s, v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g b d z2 bp hs ds rs p w
  assume hat ha2 hg hb hd hbd hbu hdef hpt
  let BY := bits_of_int(8, gimple.bytes_at(app(w, "vm"), bits_add(64, bp, d), 1))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, ds) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(app(m, "gpr"), g, BY)), empty) proof
    fix m o
    assume hi hr hhs hrs hmm ho
    have ipM ipU ipC _ := apply(tr.inv_parts, hi)
    have mM := ipM
    have rb := apply(tr.regs_get, {m}, {rs}, {b}, {8}, {bp}, hrs, hbd, hbu)
    have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
    have b64: bp in bits(64) by simp(rb)
    have d64: d in bits(64) by simp(hd)
    have ea: bits_add(64, int_add(app(app(m, "gpr"), b), d), 0) = bits_add(64, bp, d) by simp(rb, b64, d64)
    have rd := apply(tr.reads, {s}, {m}, {w}, {ds}, {bp}, {d}, {1}, b64, hd, hdef, hmm, simp())
    have ac := rewrite(sym(ea), rd.1)
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    have e := apply(x86i.movzx8_bd, {m}, {o}, {g}, {b}, {d}, {z2}, {len}, ipM, ipU, gR, hb, d64, ac, hx)
    have lw := all_elim(tr.le_bytes, {app(w, "vm")}, {bits_add(64, bp, d)}, {1})
    show by simp(e, ea, rd.2, lw, hr, ha2, keep(gimple.bytes_at, x86_64_linux.le))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, ds) -> BY in bits(int_mul(8, 1)) && BY in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs, gimple.bytes_at))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0v, {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {1}, {BY}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// mov r64, [b + d]: g := the 8 bytes
theorem tr.load64_bd: all s v base code fr a a2 len g b d z2 bp hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(76, pair(8, pair(g, pair(tag(2, fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(2, b)), "index", none), "scale", 1), "disp", d)), pair(tag(2, fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(2, b)), "index", none), "scale", 1), "disp", d)), z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> b in x86_64_linux.Reg -> d in bits(32) -> b in dom(rs) -> app(rs, b) = pair(8, bp) ->
  g.mem_defined(w, bp, d, 8, false) ->
  tr.pt(s, v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(8, bits_of_int(64, gimple.bytes_at(app(w, "vm"), bits_add(64, bp, d), 8)))), p, w) -> tr.pt(s, v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g b d z2 bp hs ds rs p w
  assume hat ha2 hg hb hd hbd hbu hdef hpt
  let BY := bits_of_int(64, gimple.bytes_at(app(w, "vm"), bits_add(64, bp, d), 8))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, ds) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(app(m, "gpr"), g, BY)), empty) proof
    fix m o
    assume hi hr hhs hrs hmm ho
    have ipM ipU ipC _ := apply(tr.inv_parts, hi)
    have mM := ipM
    have rb := apply(tr.regs_get, {m}, {rs}, {b}, {8}, {bp}, hrs, hbd, hbu)
    have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
    have b64: bp in bits(64) by simp(rb)
    have d64: d in bits(64) by simp(hd)
    have ea: bits_add(64, int_add(app(app(m, "gpr"), b), d), 0) = bits_add(64, bp, d) by simp(rb, b64, d64)
    have rd := apply(tr.reads, {s}, {m}, {w}, {ds}, {bp}, {d}, {8}, b64, hd, hdef, hmm, simp())
    have ac := rewrite(sym(ea), rd.1)
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    have e := apply(x86i.load64_bd, {m}, {o}, {g}, {b}, {d}, {z2}, {len}, ipM, ipU, gR, hb, d64, ac, hx)
    have lw := all_elim(tr.le_bytes, {app(w, "vm")}, {bits_add(64, bp, d)}, {8})
    show by simp(e, ea, rd.2, lw, hr, ha2, keep(gimple.bytes_at, x86_64_linux.le))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, ds) -> BY in bits(int_mul(8, 8)) && BY in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs, gimple.bytes_at))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0v, {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {8}, {BY}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// movzx r32, word [b + d]: g := the 2 bytes
theorem tr.movzx16_bd: all s v base code fr a a2 len g b d z2 bp hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(80, pair(4, pair(g, pair(tag(2, fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(2, b)), "index", none), "scale", 1), "disp", d)), pair(tag(2, fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(2, b)), "index", none), "scale", 1), "disp", d)), z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> b in x86_64_linux.Reg -> d in bits(32) -> b in dom(rs) -> app(rs, b) = pair(8, bp) ->
  g.mem_defined(w, bp, d, 2, false) ->
  tr.pt(s, v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(2, bits_of_int(16, gimple.bytes_at(app(w, "vm"), bits_add(64, bp, d), 2)))), p, w) -> tr.pt(s, v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g b d z2 bp hs ds rs p w
  assume hat ha2 hg hb hd hbd hbu hdef hpt
  let BY := bits_of_int(16, gimple.bytes_at(app(w, "vm"), bits_add(64, bp, d), 2))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, ds) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(app(m, "gpr"), g, BY)), empty) proof
    fix m o
    assume hi hr hhs hrs hmm ho
    have ipM ipU ipC _ := apply(tr.inv_parts, hi)
    have mM := ipM
    have rb := apply(tr.regs_get, {m}, {rs}, {b}, {8}, {bp}, hrs, hbd, hbu)
    have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
    have b64: bp in bits(64) by simp(rb)
    have d64: d in bits(64) by simp(hd)
    have ea: bits_add(64, int_add(app(app(m, "gpr"), b), d), 0) = bits_add(64, bp, d) by simp(rb, b64, d64)
    have rd := apply(tr.reads, {s}, {m}, {w}, {ds}, {bp}, {d}, {2}, b64, hd, hdef, hmm, simp())
    have ac := rewrite(sym(ea), rd.1)
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    have e := apply(x86i.movzx16_bd, {m}, {o}, {g}, {b}, {d}, {z2}, {len}, ipM, ipU, gR, hb, d64, ac, hx)
    have lw := all_elim(tr.le_bytes, {app(w, "vm")}, {bits_add(64, bp, d)}, {2})
    show by simp(e, ea, rd.2, lw, hr, ha2, keep(gimple.bytes_at, x86_64_linux.le))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, ds) -> BY in bits(int_mul(8, 2)) && BY in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs, gimple.bytes_at))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0v, {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {2}, {BY}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// ----------------------------------------------------------------------
//  More register forms (get_stride's): and with an immediate (8 and 64
//  bits), movzx from r8/r16 of a narrow value, shl as a product, lea of a
//  sum, a word load at [b + i]

// (an and with kk in 32 bits, of a byte: in 8 bits -- per immediate, by simp)
def tr.narrow8(kk) := all u. u in bits(8) -> bits_and(32, u, kk) = bits_and(8, u, kk)

// and r32, imm8 of a byte u: g := u & kk, in 8 bits
theorem tr.and8_imm: all s v base code fr a a2 len g z k kk u hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(60, pair(4, pair(4, pair(tag(0, g), pair(z, k)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> k in bits(8) -> kk = bits_sext(8, 32, k) -> tr.narrow8(kk) -> g in dom(rs) -> app(rs, g) = pair(1, u) ->
  tr.pt(s, v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(1, bits_and(8, u, kk))), p, w) -> tr.pt(s, v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g z k kk u hs ds rs p w
  assume hat ha2 hg hk hkk hn8 hd hu hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bits_and(8, u, kk))), empty)) proof
    fix m o
    assume hi hr hhs hrs ho
    have ipM ipU ipC _ := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {1}, {u}, hrs, hd, hu)
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    have u8: u in bits(8) by simp(rg)
    have nw := mp(all_elim(expand(hn8, tr.narrow8), {u}), u8)
    obtain f, hf from apply(x86i.and32_imm, {m}, {o}, {g}, {z}, {k}, {len}, ipM, ipU, gR, hk, hx)
    show by ex_intro({f}, simp(hf, rg, hr, ha2, hkk, nw, keep(x86i.flags_ok)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_and(8, u, kk) in bits(int_mul(8, 1)) && bits_and(8, u, kk) in bits(64) proof
    fix m
    assume hi hr hhs hrs
    show by simp(keep(tr.inv, tr.homes, tr.regs, gimple.bytes_at))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step, {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {1}, {bits_and(8, u, kk)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// and rax, imm32: rax := u & kk (kk the immediate, sign-extended)
theorem tr.and64_imm: all s v base code fr a a2 len k kk u hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(49, pair(8, k))), m, o)) ->
  a2 = bits_add(64, a, len) -> k in bits(32) -> kk = bits_sext(32, 64, k) -> 0 in dom(rs) -> app(rs, 0) = pair(8, u) ->
  tr.pt(s, v, base, code, fr, a2, hs, ds, fn_update(rs,0, pair(8, bits_and(64, u, kk))), p, w) -> tr.pt(s, v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len k kk u hs ds rs p w
  assume hat ha2 hk hkk hd hu hpt
  have hg: tr.scratch_reg(0) by defs(simp(), tr.scratch_reg)
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), 0, bits_and(64, u, kk))), empty)) proof
    fix m o
    assume hi hr hhs hrs ho
    have ipM ipU ipC _ := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {0}, {8}, {u}, hrs, hd, hu)
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    obtain f, hf from apply(x86i.and64_imm, {m}, {o}, {k}, {len}, ipM, ipU, hk, hx)
    show by ex_intro({f}, simp(hf, rg, hr, ha2, hkk, keep(x86i.flags_ok)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_and(64, u, kk) in bits(int_mul(8, 8)) && bits_and(64, u, kk) in bits(64) proof
    fix m
    assume hi hr hhs hrs
    show by simp(keep(tr.inv, tr.homes, tr.regs, gimple.bytes_at))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step, {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {0}, {8}, {bits_and(64, u, kk)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// movzx r32, r8 (h holding b, of 8 bits): g := b
theorem tr.movzx8_rrw: all s v base code fr a a2 len g h z2 n b hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(79, pair(4, pair(g, pair(tag(0, h), pair(tag(0, h), z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> h in x86_64_linux.Reg -> int_lt(h, 4) -> h in dom(rs) -> app(rs, h) = pair(n, b) -> b in bits(8) ->
  tr.pt(s, v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(4, b)), p, w) -> tr.pt(s, v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g h z2 n b hs ds rs p w
  assume hat ha2 hg hh hh4 hd hb hb8 hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(app(m, "gpr"), g, b)), empty) proof
    fix m o
    assume hi hr hhs hrs ho
    have ipM ipU ipC _ := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {h}, {n}, {b}, hrs, hd, hb)
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    have e := apply(x86i.movzx8_rr, {m}, {o}, {g}, {h}, {z2}, {len}, ipM, ipU, gR, hh, hh4, hx)
    show by simp(e, rg, hb8, hr, ha2)
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      b in bits(int_mul(8, 4)) && b in bits(64) proof
    fix m
    assume hi hr hhs hrs
    have ty0 := hb8
    show by simp(ty0, keep(tr.inv, tr.homes, tr.regs, gimple.bytes_at))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0, {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {b}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

