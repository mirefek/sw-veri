  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(4, b)), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g h z2 n b hs ds rs p w
  assume hat ha2 hg hh hd hb hb16 hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(app(m, "gpr"), g, b)), empty) proof
    fix m o
    assume hi hr hhs hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {h}, {n}, {b}, hrs, hd, hb)
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    have e := apply(x86i.movzx16_rr, {m}, {o}, {g}, {h}, {z2}, {len}, ipM, ipU, gR, hh, hx)
    show by simp(e, rg, hb16, hr, ha2)
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      b in bits(int_mul(8, 4)) && b in bits(64) proof
    fix m
    assume hi hr hhs hrs
    have ty0 := hb16
    show by simp(ty0, keep(tr.inv, tr.homes, tr.regs, gimple.bytes_at))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {b}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// shl r32, c (g holding u, of 32 bits): g := u * 2^c, in 32 bits
theorem tr.shl32_imm(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g z c mk n u hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(72, pair(4, pair(4, pair(tag(0, g), pair(z, c)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> c in omega -> int_lt(0, c) -> int_lt(c, 32) -> mk = pow2(c) -> g in dom(rs) -> app(rs, g) = pair(n, u) -> u in bits(32) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(4, bits_mul(32, u, mk))), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g z c mk n u hs ds rs p w
  assume hat ha2 hg hc hc1 hc2 hmk hd hu hu32 hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bits_mul(32, u, mk))), empty)) proof
    fix m o
    assume hi hr hhs hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {n}, {u}, hrs, hd, hu)
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    have sm: bits_shl(32, u, c) = bits_mul(32, u, mk) by defs(simp(hmk), bits_shl, bits_mul)
    obtain f, hf from apply(x86i.shl32_imm, {m}, {o}, {g}, {z}, {c}, {len}, ipM, ipU, gR, hc, hc1, hc2, hx)
    show by ex_intro({f}, simp(hf, rg, hu32, hr, ha2, sm, keep(x86i.flags_ok)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_mul(32, u, mk) in bits(int_mul(8, 4)) && bits_mul(32, u, mk) in bits(64) proof
    fix m
    assume hi hr hhs hrs
    show by simp(keep(tr.inv, tr.homes, tr.regs, gimple.bytes_at))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {bits_mul(32, u, mk)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// lea r64, [b + i] (b holding bv, i holding iv): g := iv + bv
theorem tr.lea_bi(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g b i z1 z2 z3 nb bv iv hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(78, pair(8, pair(g, pair(z1, pair(z2, pair(z3, fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(2, b)), "index", some(i)), "scale", 1), "disp", 0)))))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> b in x86_64_linux.Reg -> i in x86_64_linux.Reg -> b in dom(rs) -> app(rs, b) = pair(nb, bv) -> i in dom(rs) -> app(rs, i) = pair(8, iv) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(8, bits_add(64, iv, bv))), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g b i z1 z2 z3 nb bv iv hs ds rs p w
  assume hat ha2 hg hb hi0 hbd hbu hid hiu hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(app(m, "gpr"), g, bits_add(64, iv, bv))), empty) proof
    fix m o
    assume hi hr hhs hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have mM := ipM
    have rb := apply(tr.regs_get, {m}, {rs}, {b}, {nb}, {bv}, hrs, hbd, hbu)
    have ri := apply(tr.regs_get, {m}, {rs}, {i}, {8}, {iv}, hrs, hid, hiu)
    have tb := apply(x86i.reg_typed, mM, hb)
    have ti := apply(x86i.reg_typed, mM, hi0)
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    have e := apply(x86i.lea_bi, {m}, {o}, {g}, {b}, {i}, {z1}, {z2}, {z3}, {len}, ipM, ipU, gR, hb, hi0, hx)
    show by simp(e, rb, ri, tb, ti, hr, ha2)
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_add(64, iv, bv) in bits(int_mul(8, 8)) && bits_add(64, iv, bv) in bits(64) proof
    fix m
    assume hi hr hhs hrs
    show by simp(keep(tr.inv, tr.homes, tr.regs, gimple.bytes_at))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {8}, {bits_add(64, iv, bv)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// lea r64, [b + d] (b holding u): u + dd, dd the displacement as the spec
// writes it (a negative one bits_neg(64, k))
theorem tr.lea64_bd(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g b d dd z1 z2 z3 u hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(78, pair(8, pair(g, pair(z1, pair(z2, pair(z3, fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(2, b)), "index", none), "scale", 1), "disp", d)))))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> b in x86_64_linux.Reg -> d in bits(64) -> dd = d -> b in dom(rs) -> app(rs, b) = pair(8, u) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(8, bits_add(64, u, dd))), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g b d dd z1 z2 z3 u hs ds rs p w
  assume hat ha2 hg hb hd hdd hbd hbu hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(app(m, "gpr"), g, bits_add(64, u, dd))), empty) proof
    fix m o
    assume hi hr hhs hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rb := apply(tr.regs_get, {m}, {rs}, {b}, {8}, {u}, hrs, hbd, hbu)
    have tb := apply(x86i.reg_typed, ipM, hb)
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    have e := apply(x86i.lea64_bd, {m}, {o}, {g}, {b}, {d}, {z1}, {z2}, {z3}, {len}, ipM, ipU, gR, hb, hd, hx)
    show by simp(e, rb, tb, hdd, hd, hr, ha2)
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_add(64, u, dd) in bits(int_mul(8, 8)) && bits_add(64, u, dd) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {8}, {bits_add(64, u, dd)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// (the 32-bit lea's value: the sum's low 32 bits)
theorem tr.lea32_val: all u d. u in int -> d in bits(64) -> bits_of_int(32, bits_add(64, int_add(u, d), 0)) = bits_add(32, u, int_mod(d, 4294967296))
proof
  fix u d
  assume hu hd
  have p64: pow2(64) = 18446744073709551616 by simp()
  have p32: pow2(32) = 4294967296 by simp()
  have e0: int_mod(int_mod(int_add(int_add(u, d), 0), 18446744073709551616), 4294967296) = int_mod(int_add(u, int_mod(d, 4294967296)), 4294967296) by arith(hu, hd)
  have e1 := rewrite(sym(p64), e0)
  have e2 := subst({y. int_mod(int_mod(int_add(int_add(u, d), 0), pow2(64)), y) = int_mod(int_add(u, int_mod(d, 4294967296)), y)}, sym(p32), e1)
  show by defs(e2, bits_add, bits_of_int)
qed

// lea r32 g, [b + d] (b holding u): g := u + d, 32 bits (GIMPLE's x + k,
// k = d mod 2^32)
theorem tr.lea32_bd(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g b d z1 z2 z3 n u kk hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(78, pair(4, pair(g, pair(z1, pair(z2, pair(z3, fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(2, b)), "index", none), "scale", 1), "disp", d)))))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> b in x86_64_linux.Reg -> d in bits(64) -> b in dom(rs) -> app(rs, b) = pair(n, u) ->
  kk = int_mod(d, 4294967296) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs, g, pair(4, bits_add(32, u, kk))), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g b d z1 z2 z3 n u kk hs ds rs p w
  assume hat ha2 hg hb hd hbd hbu hk hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(app(m, "gpr"), g, bits_add(32, u, kk))), empty) proof
    fix m o
    assume hi hr hhs hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have mM := ipM
    have rb := apply(tr.regs_get, {m}, {rs}, {b}, {n}, {u}, hrs, hbd, hbu)
    have tb := apply(x86i.reg_typed, mM, hb)
    have eu: app(app(m, "gpr"), b) = u by taut(rb)
    have ui: u in int by simp(rewrite(eu, tb))
    have lv := apply(tr.lea32_val, {u}, {d}, ui, hd)
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    have e := apply(x86i.lea32_bd, {m}, {o}, {g}, {b}, {d}, {z1}, {z2}, {z3}, {len}, ipM, ipU, gR, hb, hd, hx)
    show by simp(e, eu, lv, hk, hr, ha2)
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_add(32, u, kk) in bits(int_mul(8, 4)) && bits_add(32, u, kk) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {bits_add(32, u, kk)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// movzx r32, word [b + i] (b holding bv, i the pointer iv): g := the 2 bytes
// at iv + bv in the world's memory (the spec's 2-byte load there defined)
theorem tr.movzx16_ld(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g b i z2 nb bv iv hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(80, pair(4, pair(g, pair(tag(2, fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(2, b)), "index", some(i)), "scale", 1), "disp", 0)), pair(tag(2, fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(2, b)), "index", some(i)), "scale", 1), "disp", 0)), z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> b in x86_64_linux.Reg -> i in x86_64_linux.Reg ->
  b in dom(rs) -> app(rs, b) = pair(nb, bv) -> i in dom(rs) -> app(rs, i) = pair(8, iv) ->
  g.mem_defined(w, bits_add(64, iv, bv), 0, 2, false) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(2, bits_of_int(16, gimple.bytes_at(app(w, "vm"), bits_add(64, iv, bv), 2)))), p, w) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g b i z2 nb bv iv hs ds rs p w
  assume hat ha2 hg hb hi0 hbd hbu hid hig hdef hpt
  let A := bits_add(64, iv, bv)
  let BY := bits_of_int(16, gimple.bytes_at(app(w, "vm"), A, 2))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(app(m, "gpr"), g, BY)), empty) proof
    fix m o
    assume hi hr hhs hrs hmm ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have mM := ipM
    have rb := apply(tr.regs_get, {m}, {rs}, {b}, {nb}, {bv}, hrs, hbd, hbu)
    have ri := apply(tr.regs_get, {m}, {rs}, {i}, {8}, {iv}, hrs, hid, hig)
    have tb := apply(x86i.reg_typed, mM, hb)
    have ti := apply(x86i.reg_typed, mM, hi0)
    have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
    have ab: A in bits(64) by simp()
    have ea: bits_add(64, int_add(app(app(m, "gpr"), b), bits_mul(64, app(app(m, "gpr"), i), 1)), 0) = bits_add(64, A, 0) by simp(rb, ri, tb, ti)
    have rd := apply(tr.reads, {s}, {m}, {w}, {v}, {A}, {0}, {2}, ab, simp(), hdef, hmm, simp())
    have ac := rewrite(sym(ea), rd.1)
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    have e := apply(x86i.movzx16_idx, {m}, {o}, {g}, {b}, {i}, {z2}, {len}, ipM, ipU, gR, hb, hi0, ac, hx)
    have lw := all_elim(tr.le_bytes, {app(w, "vm")}, {bits_add(64, A, 0)}, {2})
    show by simp(e, ea, ab, rd.2, lw, hr, ha2, keep(gimple.bytes_at, x86_64_linux.le))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> BY in bits(int_mul(8, 2)) && BY in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs, gimple.bytes_at))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0v[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {2}, {BY}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// ----------------------------------------------------------------------
//  Bitfields: a 64-bit word shifted down then up by 12 (a 52-bit field
//  from byte 1, bit 4), a 16-bit word shifted and masked

// (8 bytes at a: the byte at a, then the 7 at a + 1)
theorem tr.bytes8_split: all vm a. a in bits(64) -> app(vm, "bytes") in fn_space(bits(64), bits(8)) ->
  gimple.bytes_at(vm, a, 8) = int_add(app(app(vm, "bytes"), a), int_mul(gimple.bytes_at(vm, bits_add(64, a, 1), 7), 256))
proof
  fix vm a
  assume ha hb
  show by defs(simp(ha, hb), gimple.bytes_at)
qed

// shr r64, c: g := u >> c
theorem tr.shr64_imm(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g z c u hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(72, pair(8, pair(5, pair(tag(0, g), pair(z, c)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> c in omega -> int_lt(0, c) -> int_lt(c, 64) -> g in dom(rs) -> app(rs, g) = pair(8, u) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(8, bits_shr(64, u, c))), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g z c u hs ds rs p w
  assume hat ha2 hg hc hc1 hc2 hd hu hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bits_shr(64, u, c))), empty)) proof
    fix m o
    assume hi hr hh hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {8}, {u}, hrs, hd, hu)
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    obtain f, hf from apply(x86i.shr64_imm, {m}, {o}, {g}, {z}, {c}, {len}, ipM, ipU, gR, hc, hc1, hc2, hx)
    show by ex_intro({f}, simp(hf, rg, hr, ha2, keep(x86i.flags_ok)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_shr(64, u, c) in bits(int_mul(8, 8)) && bits_shr(64, u, c) in bits(64) proof
    fix m
    show by simp(hc, keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {8}, {bits_shr(64, u, c)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// shl r64, 12 of the word at bp + off shifted down by 12: the field of its
// bytes from bp + off1 (= bp + off + 1), bits 4.. (52 of them), times 4096
// (`bits[52](ldbf(p, off + 1, 7, 4, 52)) * 4096`)
theorem tr.shl12_field(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g z bp off off1 hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(72, pair(8, pair(4, pair(tag(0, g), pair(z, 12)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> bits_add(64, bp, off1) = bits_add(64, bits_add(64, bp, off), 1) ->
  g in dom(rs) -> app(rs, g) = pair(8, bits_shr(64, bits_of_int(64, gimple.bytes_at(app(w, "vm"), bits_add(64, bp, off), 8)), 12)) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(8, bits_mul(64, bits_of_int(52, int_mod(int_div(gimple.bytes_at(app(w, "vm"), bits_add(64, bp, off1), 7), int_pow(2, 4)), int_pow(2, 52))), 4096))), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g z bp off off1 hs ds rs p w
  assume hat ha2 hg ha1 hd hu hpt
  let A := bits_add(64, bp, off)
  let RES := bits_mul(64, bits_of_int(52, int_mod(int_div(gimple.bytes_at(app(w, "vm"), bits_add(64, bp, off1), 7), int_pow(2, 4)), int_pow(2, 52))), 4096)
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have val: all m. tr.inv(s, base, code, fr, m, w) -> bits_shl(64, bits_shr(64, bits_of_int(64, gimple.bytes_at(app(w, "vm"), bits_add(64, bp, off), 8)), 12), 12) = RES proof
    fix m
    assume hi
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have mM := ipM
    have pt := apply(x86i.parts, mM)
    have hb := apply(tr.world_bytes, hi)
    have ab: A in bits(64) by simp()
    have e1 := mp(tr.bytes8_split, {app(w, "vm")}, {A}, ab, hb)
    let s8 := gimple.bytes_at(app(w, "vm"), A, 8)
    let s7 := gimple.bytes_at(app(w, "vm"), bits_add(64, A, 1), 7)
    have b0: app(app(app(w, "vm"), "bytes"), A) in bits(8) by simp(hb, ab)
    have b1: app(app(app(w, "vm"), "bytes"), bits_add(64, A, 1)) in bits(8) by simp(hb)
    have b2: app(app(app(w, "vm"), "bytes"), bits_add(64, A, 2)) in bits(8) by simp(hb)
    have b3: app(app(app(w, "vm"), "bytes"), bits_add(64, A, 3)) in bits(8) by simp(hb)
    have b4: app(app(app(w, "vm"), "bytes"), bits_add(64, A, 4)) in bits(8) by simp(hb)
    have b5: app(app(app(w, "vm"), "bytes"), bits_add(64, A, 5)) in bits(8) by simp(hb)
    have b6: app(app(app(w, "vm"), "bytes"), bits_add(64, A, 6)) in bits(8) by simp(hb)
    have b7: app(app(app(w, "vm"), "bytes"), bits_add(64, A, 7)) in bits(8) by simp(hb)
    have r8: s8 in bits(64) by defs(simp(b0, b1, b2, b3, b4, b5, b6, b7), gimple.bytes_at)
    have r7: s7 in bits(56) by defs(simp(b1, b2, b3, b4, b5, b6, b7), gimple.bytes_at)
    have q: int_div(s8, 4096) = int_div(s7, 16) by arith(e1, b0, r7, r8)
    have d52: int_div(s7, 16) in bits(52) by arith(r7)
    show by defs(simp(ha1, r8, q, d52), bits_shl, bits_shr, bits_mul)
  qed
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, RES)), empty)) proof
    fix m o
    assume hi hr hh hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {8}, {bits_shr(64, bits_of_int(64, gimple.bytes_at(app(w, "vm"), bits_add(64, bp, off), 8)), 12)}, hrs, hd, hu)
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    have vl := mp(all_elim(val, {m}), hi)
    obtain f, hf from apply(x86i.shl64_imm, {m}, {o}, {g}, {z}, {12}, {len}, ipM, ipU, gR, simp(), simp(), simp(), hx)
    show by ex_intro({f}, simp(hf, rg, vl, hr, ha2, keep(x86i.flags_ok, gimple.bytes_at)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      RES in bits(int_mul(8, 8)) && RES in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs, gimple.bytes_at))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {8}, {RES}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// shr r16, c (g holding u): the low 16 bits shifted, the rest kept (as the
// machine has it: a field rule reads it)
theorem tr.shr16_imm(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g z c u hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(72, pair(2, pair(5, pair(tag(0, g), pair(z, c)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> c in omega -> int_lt(0, c) -> int_lt(c, 16) -> g in dom(rs) -> app(rs, g) = pair(2, u) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(8, bits_set_slice(64, u, 15, 0, bits_shr(16, bits_slice(u, 15, 0), c)))), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g z c u hs ds rs p w
  assume hat ha2 hg hc hc1 hc2 hd hu hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bits_set_slice(64, u, 15, 0, bits_shr(16, bits_slice(u, 15, 0), c)))), empty)) proof
    fix m o
    assume hi hr hh hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {2}, {u}, hrs, hd, hu)
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    obtain f, hf from apply(x86i.shr16_imm, {m}, {o}, {g}, {z}, {c}, {len}, ipM, ipU, gR, hc, hc1, hc2, hx)
    show by ex_intro({f}, simp(hf, rg, hr, ha2, keep(x86i.flags_ok, bits_set_slice)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_set_slice(64, u, 15, 0, bits_shr(16, bits_slice(u, 15, 0), c)) in bits(int_mul(8, 8)) && bits_set_slice(64, u, 15, 0, bits_shr(16, bits_slice(u, 15, 0), c)) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs, bits_set_slice))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {8}, {bits_set_slice(64, u, 15, 0, bits_shr(16, bits_slice(u, 15, 0), c))}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// (a field of a 16-bit word: its bits pos.., kb of them, by a shift and a
// mask kk -- per field, by simp)
def tr.field16(pos, kb, kk) := all x. x in bits(16) -> bits_and(32, bits_slice(bits_set_slice(64, bits_of_int(16, x), 15, 0, bits_shr(16, bits_slice(bits_of_int(16, x), 15, 0), pos)), 31, 0), kk) = bits_of_int(kb, int_mod(int_div(x, int_pow(2, pos)), int_pow(2, kb)))

// and r32, imm8 of the word at q shifted down by pos (by a mask: the
// field), `bits[kb](ldbf(.., 2, pos, kb))`
theorem tr.and_field16(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g z k kk q pos kb hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(60, pair(4, pair(4, pair(tag(0, g), pair(z, k)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> k in bits(8) -> kk = bits_sext(8, 32, k) -> tr.field16(pos, kb, kk) -> q in bits(64) ->
  g in dom(rs) -> app(rs, g) = pair(8, bits_set_slice(64, bits_of_int(16, gimple.bytes_at(app(w, "vm"), q, 2)), 15, 0, bits_shr(16, bits_slice(bits_of_int(16, gimple.bytes_at(app(w, "vm"), q, 2)), 15, 0), pos))) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(4, bits_of_int(kb, int_mod(int_div(gimple.bytes_at(app(w, "vm"), q, 2), int_pow(2, pos)), int_pow(2, kb))))), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g z k kk q pos kb hs ds rs p w
  assume hat ha2 hg hk hkk hf16 hq hd hu hpt
  let FIELD := bits_of_int(kb, int_mod(int_div(gimple.bytes_at(app(w, "vm"), q, 2), int_pow(2, pos)), int_pow(2, kb)))
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, FIELD)), empty)) proof
    fix m o
    assume hi hr hh hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have mM := ipM
    have pt := apply(x86i.parts, mM)
    have hb := apply(tr.world_bytes, hi)
    have b0: app(app(app(w, "vm"), "bytes"), q) in bits(8) by simp(hb, hq)
    have b1: app(app(app(w, "vm"), "bytes"), bits_add(64, q, 1)) in bits(8) by simp(hb)
    have x16: gimple.bytes_at(app(w, "vm"), q, 2) in bits(16) by defs(simp(b0, b1, hq), gimple.bytes_at)
    have fe := mp(all_elim(expand(hf16, tr.field16), {gimple.bytes_at(app(w, "vm"), q, 2)}), x16)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {8}, {bits_set_slice(64, bits_of_int(16, gimple.bytes_at(app(w, "vm"), q, 2)), 15, 0, bits_shr(16, bits_slice(bits_of_int(16, gimple.bytes_at(app(w, "vm"), q, 2)), 15, 0), pos))}, hrs, hd, hu)
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    obtain f, hf from apply(x86i.and32_imm, {m}, {o}, {g}, {z}, {k}, {len}, ipM, ipU, gR, hk, hx)
    show by ex_intro({f}, simp(hf, rg, hkk, fe, hr, ha2, keep(x86i.flags_ok, gimple.bytes_at)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      FIELD in bits(int_mul(8, 4)) && FIELD in bits(64) proof
    fix m
    assume hi hr hhs hrs
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {8}, {bits_set_slice(64, bits_of_int(16, gimple.bytes_at(app(w, "vm"), q, 2)), 15, 0, bits_shr(16, bits_slice(bits_of_int(16, gimple.bytes_at(app(w, "vm"), q, 2)), 15, 0), pos))}, hrs, hd, hu)
    have fv: FIELD = bits_and(32, bits_slice(bits_set_slice(64, bits_of_int(16, gimple.bytes_at(app(w, "vm"), q, 2)), 15, 0, bits_shr(16, bits_slice(bits_of_int(16, gimple.bytes_at(app(w, "vm"), q, 2)), 15, 0), pos)), 31, 0), kk) proof
      have mM .. := apply(tr.inv_parts, hi)
      have pt := apply(x86i.parts, mM)
      have hb := apply(tr.world_bytes, hi)
      have b0: app(app(app(w, "vm"), "bytes"), q) in bits(8) by simp(hb, hq)
      have b1: app(app(app(w, "vm"), "bytes"), bits_add(64, q, 1)) in bits(8) by simp(hb)
      have x16: gimple.bytes_at(app(w, "vm"), q, 2) in bits(16) by defs(simp(b0, b1, hq), gimple.bytes_at)
      have fe := mp(all_elim(expand(hf16, tr.field16), {gimple.bytes_at(app(w, "vm"), q, 2)}), x16)
      show := sym(fe)
    qed
    show by simp(fv, keep(tr.inv, tr.homes, tr.regs, gimple.bytes_at))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {FIELD}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// ----------------------------------------------------------------------
//  64-bit values: a home's load, sub r64, and r32 imm, the byte loads
//  movzx r32, r8 and movzx r32, byte [b]

theorem tr.load64_home(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g d c z1 z2 x hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(76, pair(8, pair(g, pair(x86i.rsp_mem(d), pair(z1, z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> d in bits(64) -> c = int_mod(int_sub(d, fr), 18446744073709551616) ->
  c in dom(hs) -> app(hs, c) = pair(8, x) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(8, x)), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g d c z1 z2 x hs ds rs p w
  assume hat ha2 hg hd hcd hdh hx hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(app(m, "gpr"), g, x)), empty) proof
    fix m o
    assume hi hr hhs hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have ac := apply(tr.home_acc, {s}, {base}, {code}, {fr}, {m}, {w}, {hs}, {d}, {c}, {8}, {x}, hi, hhs, hd, hcd, hdh, hx)
    have hv := apply(tr.home_read, {s}, {base}, {code}, {fr}, {m}, {w}, {hs}, {d}, {c}, {8}, {x}, hi, hhs, hd, hcd, hdh, hx)
    have hx2 := mp(mp(mp(all_elim(hat, {m}, {o}), ho), ipC), hr)
    have e := apply(x86i.load64_rsp, {m}, {o}, {g}, {d}, {z1}, {z2}, {len}, ipM, ipU, gR, hd, taut(ac), hx2)
    show by simp(e, hv, ipM, ipU, ipC, hr, ha2, keep(abi.code_at, x86_64_linux.Machine))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> x in bits(int_mul(8, 8)) && x in bits(64) proof
    fix m
    assume hi hr hhs hrs
    have hv := apply(tr.homes_get, {s}, {m}, {hs}, {c}, {8}, {x}, hhs, hdh, hx)
    show by simp(sym(hv))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {8}, {x}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// (a signed product's low 64 bits: the unsigned one's)
theorem tr.imul_sint64: all a b. a in bits(64) -> b in bits(64) -> bits_of_int(64, int_mul(sint(64, a), sint(64, b))) = bits_mul(64, a, b)
proof
  fix a b
  assume ha hb
  have sa: sint(64, a) = a || sint(64, a) = int_sub(a, 18446744073709551616) by defs(simp(ha), sint)
  have sb: sint(64, b) = b || sint(64, b) = int_sub(b, 18446744073709551616) by defs(simp(hb), sint)
  let K := 18446744073709551616
  have c1: int_mod(int_mul(int_sub(a, K), b), K) = int_mod(int_mul(a, b), K) by arith(ha, hb)
  have c2: int_mod(int_mul(a, int_sub(b, K)), K) = int_mod(int_mul(a, b), K) by arith(ha, hb)
  have cx: all x. x in int -> int_mod(int_mul(x, int_sub(b, K)), K) = int_mod(int_mul(x, b), K) proof
    fix x
    assume hx
    show by arith(hx, hb)
  qed
  have c3 := trans(mp(all_elim(cx, {int_sub(a, K)}), (int_sub(a, K) in int by arith(ha))), c1)
  have e: int_mod(int_mul(sint(64, a), sint(64, b)), K) = int_mod(int_mul(a, b), K) by simp(sa, sb, c1, c2, c3)
  show by defs(simp(e), bits_of_int, bits_mul)
qed

// imul r64 g, [rsp + d] (g holding u, the home x): g := r, the product
// (r as the spec has it: u * x, or x * u)
theorem tr.imul64_home(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g d c z1 z2 x u r hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(70, pair(8, pair(g, pair(x86i.rsp_mem(d), pair(z1, z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> d in bits(64) -> c = int_mod(int_sub(d, fr), 18446744073709551616) ->
  c in dom(hs) -> app(hs, c) = pair(8, x) -> g in dom(rs) -> app(rs, g) = pair(8, u) -> r = bits_mul(64, u, x) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(8, r)), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g d c z1 z2 x u r hs ds rs p w
  assume hat ha2 hg hd hcd hdh hx hgr hu hr hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, r)), empty)) proof
    fix m o
    assume hi hr0 hh hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have ac := apply(tr.home_acc, {s}, {base}, {code}, {fr}, {m}, {w}, {hs}, {d}, {c}, {8}, {x}, hi, hh, hd, hcd, hdh, hx)
    have hv := apply(tr.home_read, {s}, {base}, {code}, {fr}, {m}, {w}, {hs}, {d}, {c}, {8}, {x}, hi, hh, hd, hcd, hdh, hx)
    have rg u64 := apply(tr.regs_get, {m}, {rs}, {g}, {8}, {u}, hrs, hgr, hu)
    have hg2 := apply(tr.homes_get, {s}, {m}, {hs}, {c}, {8}, {x}, hh, hdh, hx)
    have x64: x in bits(64) by simp(hg2)
    have im := apply(tr.imul_sint64, {u}, {x}, simp(u64), x64)
    have hx2 := mp(all_elim(hat, {m}, {o}), ho, ipC, hr0)
    obtain f, hf from apply(x86i.imul64_rsp, {m}, {o}, {g}, {d}, {z1}, {z2}, {len}, ipM, ipU, gR, hd, taut(ac), hx2)
    show by ex_intro({f}, simp(hf, hv, rg, im, hr, hr0, ha2, keep(x86i.flags_ok, abi.code_at, x86_64_linux.Machine)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      r in bits(int_mul(8, 8)) && r in bits(64) proof
    fix m
    show by simp(hr, keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {8}, {r}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// sub r64 g, [rsp + d] (g holding u, the home x): g := u - x
theorem tr.sub64_home(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g d c z1 z2 x u hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(51, pair(8, pair(g, pair(x86i.rsp_mem(d), pair(z1, z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> d in bits(64) -> c = int_mod(int_sub(d, fr), 18446744073709551616) ->
  c in dom(hs) -> app(hs, c) = pair(8, x) -> g in dom(rs) -> app(rs, g) = pair(8, u) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(8, bits_sub(64, u, x))), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g d c z1 z2 x u hs ds rs p w
  assume hat ha2 hg hd hcd hdh hx hgr hu hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bits_sub(64, u, x))), empty)) proof
    fix m o
    assume hi hr hhs hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have ac := apply(tr.home_acc, {s}, {base}, {code}, {fr}, {m}, {w}, {hs}, {d}, {c}, {8}, {x}, hi, hhs, hd, hcd, hdh, hx)
    have hv := apply(tr.home_read, {s}, {base}, {code}, {fr}, {m}, {w}, {hs}, {d}, {c}, {8}, {x}, hi, hhs, hd, hcd, hdh, hx)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {8}, {u}, hrs, hgr, hu)
    have hx2 := mp(mp(mp(all_elim(hat, {m}, {o}), ho), ipC), hr)
    obtain f, hf from apply(x86i.sub64_rsp, {m}, {o}, {g}, {d}, {z1}, {z2}, {len}, ipM, ipU, gR, hd, taut(ac), hx2)
    show by ex_intro({f}, simp(hf, hv, rg, ipM, ipU, ipC, hr, ha2, keep(x86i.flags_ok, abi.code_at, x86_64_linux.Machine)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_sub(64, u, x) in bits(int_mul(8, 8)) && bits_sub(64, u, x) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {8}, {bits_sub(64, u, x)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// x - k in 64 bits as GIMPLE writes it: x + -k
theorem tr.sub_add64: all u k. u in bits(64) -> k in bits(64) -> bits_sub(64, u, k) = bits_add(64, u, bits_neg(64, k))
proof
  fix u k
  assume hu hk
  have e: int_mod(int_sub(u, k), 18446744073709551616) = int_mod(int_add(u, int_mod(int_neg(k), 18446744073709551616)), 18446744073709551616) by arith(hu, hk)
  show by defs(simp(e), bits_sub, bits_add, bits_neg)
qed

// sub r64, imm8: g := u + -kk (kk the immediate, sign-extended)
theorem tr.sub64_imm(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g z k kk u hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(60, pair(8, pair(5, pair(tag(0, g), pair(z, k)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> k in bits(8) -> kk = bits_sext(8, 64, k) -> g in dom(rs) -> app(rs, g) = pair(8, u) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(8, bits_add(64, u, bits_neg(64, kk)))), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g z k kk u hs ds rs p w
  assume hat ha2 hg hk hkk hd hu hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bits_add(64, u, bits_neg(64, kk)))), empty)) proof
    fix m o
    assume hi hr hh hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {8}, {u}, hrs, hd, hu)
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    have u64: u in bits(64) by simp(rg)
    have k64: kk in bits(64) by simp(hkk, hk)
    have sa := mp(tr.sub_add64, {u}, {kk}, u64, k64)
    obtain f, hf from apply(x86i.sub64_imm, {m}, {o}, {g}, {z}, {k}, {len}, ipM, ipU, gR, hk, hx)
    show by ex_intro({f}, simp(hf, rg, hr, ha2, hkk, sa, keep(x86i.flags_ok)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_add(64, u, bits_neg(64, kk)) in bits(int_mul(8, 8)) && bits_add(64, u, bits_neg(64, kk)) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {8}, {bits_add(64, u, bits_neg(64, kk))}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// and r32, imm8: g := u & kk (kk the immediate, sign-extended)
theorem tr.and32_imm(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g z k kk u hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(60, pair(4, pair(4, pair(tag(0, g), pair(z, k)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> k in bits(8) -> kk = bits_sext(8, 32, k) -> g in dom(rs) -> app(rs, g) = pair(4, u) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(4, bits_and(32, u, kk))), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g z k kk u hs ds rs p w
  assume hat ha2 hg hk hkk hd hu hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bits_and(32, u, kk))), empty)) proof
    fix m o
    assume hi hr hh hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {4}, {u}, hrs, hd, hu)
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    obtain f, hf from apply(x86i.and32_imm, {m}, {o}, {g}, {z}, {k}, {len}, ipM, ipU, gR, hk, hx)
    show by ex_intro({f}, simp(hf, rg, hr, ha2, hkk, keep(x86i.flags_ok)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_and(32, u, kk) in bits(int_mul(8, 4)) && bits_and(32, u, kk) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {bits_and(32, u, kk)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// movzx r32, r8 (h holding the byte b): g := b
theorem tr.movzx8_rr(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g h z2 b hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(79, pair(4, pair(g, pair(tag(0, h), pair(tag(0, h), z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> h in x86_64_linux.Reg -> int_lt(h, 4) -> h in dom(rs) -> app(rs, h) = pair(1, b) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(4, b)), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g h z2 b hs ds rs p w
  assume hat ha2 hg hh hh4 hd hb hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(app(m, "gpr"), g, b)), empty) proof
    fix m o
    assume hi hr hhs hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {h}, {1}, {b}, hrs, hd, hb)
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    have e := apply(x86i.movzx8_rr, {m}, {o}, {g}, {h}, {z2}, {len}, ipM, ipU, gR, hh, hh4, hx)
    show by simp(e, rg, hr, ha2)
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> b in bits(int_mul(8, 4)) && b in bits(64) proof
    fix m
    assume hi hr hhs hrs
    have rg := apply(tr.regs_get, {m}, {rs}, {h}, {1}, {b}, hrs, hd, hb)
    show by simp(rg)
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {b}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// movzx r32, byte [b] (b holding the pointer bv): g := the byte at bv in
// the world's memory (usable there: the spec's load ok)
theorem tr.movzx8_b(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g b z2 bv hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(79, pair(4, pair(g, pair(tag(2, fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(2, b)), "index", none), "scale", 1), "disp", 0)),
      pair(tag(2, fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(2, b)), "index", none), "scale", 1), "disp", 0)), z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> b in x86_64_linux.Reg -> b in dom(rs) -> app(rs, b) = pair(8, bv) ->
  gimple.usable(app(w, "vm"), app(w, "objs"), bv, 1, false) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(1, bits_of_int(8, gimple.bytes_at(app(w, "vm"), bv, 1)))), p, w) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g b z2 bv hs ds rs p w
  assume hat ha2 hg hb hbd hbu hus hpt
  let BY := bits_of_int(8, gimple.bytes_at(app(w, "vm"), bv, 1))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(app(m, "gpr"), g, BY)), empty) proof
    fix m o
    assume hi hr hhs hrs hmm ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have mM := ipM
    have rb := apply(tr.regs_get, {m}, {rs}, {b}, {8}, {bv}, hrs, hbd, hbu)
    have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
    have b64: bv in bits(64) by simp(rb)
    have ea: bits_add(64, app(app(m, "gpr"), b), 0) = bv by simp(rb, b64)
    // the byte: the world's
    have ml := apply(tr.mem_load, {s}, {m}, {w}, {v}, {bv}, {1}, {false}, hmm, hus, b64, simp())
    have ac := rewrite(sym(ea), ml.1)
    have lw := all_elim(tr.le_bytes1, {app(w, "vm")}, {bv})
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    have e := apply(x86i.movzx8_base, {m}, {o}, {g}, {b}, {z2}, {len}, ipM, ipU, gR, hb, ac, hx)
    show by simp(e, ea, ml.2, lw, hr, ha2, keep(gimple.bytes_at, x86_64_linux.le))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> BY in bits(int_mul(8, 1)) && BY in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs, gimple.bytes_at))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0v[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {1}, {BY}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// ----------------------------------------------------------------------
//  The entry of a function of one 64-bit argument (as the 32-bit one,
//  tr.entry1_32: the prologue stores rdi's 8 bytes)

// the 8 bytes just stored, read back
theorem tr.le_store8: all b a x. b in fn_space(bits(64), bits(8)) -> a in bits(64) -> x in omega ->
  x86_64_linux.le(x86_64_linux.store_le(b, a, 8, x), a, 8) = bits_of_int(64, x)
proof
  fix b a x
  assume hb ha hx
  show by simp(hb, ha, hx)
qed

// sub r32, [rsp + d]
theorem tr.sub32_home(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g d c z1 z2 x u hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(51, pair(4, pair(g, pair(x86i.rsp_mem(d), pair(z1, z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> d in bits(64) -> c = int_mod(int_sub(d, fr), 18446744073709551616) ->
  c in dom(hs) -> app(hs, c) = pair(4, x) -> g in dom(rs) -> app(rs, g) = pair(4, u) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(4, bits_sub(32, u, x))), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g d c z1 z2 x u hs ds rs p w
  assume hat ha2 hg hd hcd hdh hx hgr hu hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bits_sub(32, u, x))), empty)) proof
    fix m o
    assume hi hr hhs hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have ac := apply(tr.home_acc, {s}, {base}, {code}, {fr}, {m}, {w}, {hs}, {d}, {c}, {4}, {x}, hi, hhs, hd, hcd, hdh, hx)
    have hv := apply(tr.home_read, {s}, {base}, {code}, {fr}, {m}, {w}, {hs}, {d}, {c}, {4}, {x}, hi, hhs, hd, hcd, hdh, hx)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {4}, {u}, hrs, hgr, hu)
    have hx2 := mp(mp(mp(all_elim(hat, {m}, {o}), ho), ipC), hr)
    obtain f, hf from apply(x86i.sub32_rsp, {m}, {o}, {g}, {d}, {z1}, {z2}, {len}, ipM, ipU, gR, hd, taut(ac), hx2)
    show by ex_intro({f}, simp(hf, hv, rg, ipM, ipU, ipC, hr, ha2, keep(x86i.flags_ok, abi.code_at, x86_64_linux.Machine)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_sub(32, u, x) in bits(int_mul(8, 4)) && bits_sub(32, u, x) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {bits_sub(32, u, x)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// and r32, imm8 (k below 128) of a register holding a 64-bit word u: the
// register u & k (the 32-bit result zero-extended)
theorem tr.and32_imm_w(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g z k u hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(60, pair(4, pair(4, pair(tag(0, g), pair(z, k)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> k in bits(8) -> int_lt(k, 128) -> g in dom(rs) -> app(rs, g) = pair(8, u) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(8, bits_and(64, u, k))), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g z k u hs ds rs p w
  assume hat ha2 hg hk hk7 hd hu hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bits_and(64, u, k))), empty)) proof
    fix m o
    assume hi hr hh hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {8}, {u}, hrs, hd, hu)
    have u64: u in bits(64) by simp(rg)
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    have ks: bits_sext(8, 32, k) = k by defs(simp(hk, hk7), bits_sext, sint)
    have kb: k in bits(32) by arith(hk)
    have sl: bits_slice(u, 31, 0) = int_mod(u, pow2(32)) by defs(simp(u64), bits_slice)
    have mb: int_mod(u, pow2(32)) in bits(32) by arith(u64)
    have ab0: bits_and(32, int_mod(u, pow2(32)), k) = bits_and(64, u, k) by bitwise({64}, u64, kb, hk, hk7, mb)
    have ab := rewrite(sym(sl), ab0, {1})
    obtain f, hf from apply(x86i.and32_imm, {m}, {o}, {g}, {z}, {k}, {len}, ipM, ipU, gR, hk, hx)
    show by ex_intro({f}, simp(hf, rg, hr, ha2, ks, ab, keep(x86i.flags_ok)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_and(64, u, k) in bits(int_mul(8, 8)) && bits_and(64, u, k) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {8}, {bits_and(64, u, k)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

theorem tr.load32_bd(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g b d z2 bp ea hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(76, pair(4, pair(g, pair(tag(2, fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(2, b)), "index", none), "scale", 1), "disp", d)), pair(tag(2, fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(2, b)), "index", none), "scale", 1), "disp", d)), z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> b in x86_64_linux.Reg -> d in bits(32) -> b in dom(rs) -> app(rs, b) = pair(8, bp) -> ea = bits_add(64, bp, d) || (d = 0 && ea = bp) ->
  g.mem_defined(w, bp, d, 4, false) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(4, bits_of_int(32, gimple.bytes_at(app(w, "vm"), ea, 4)))), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g b d z2 bp ea hs ds rs p w
  assume hat ha2 hg hb hd hbd hbu hea hdef hpt
  let BY := bits_of_int(32, gimple.bytes_at(app(w, "vm"), ea, 4))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(app(m, "gpr"), g, BY)), empty) proof
    fix m o
    assume hi hr hhs hrs hmm ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have mM := ipM
    have rb := apply(tr.regs_get, {m}, {rs}, {b}, {8}, {bp}, hrs, hbd, hbu)
    have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
    have b64: bp in bits(64) by simp(rb)
    have d64: d in bits(64) by simp(hd)
    have eae: ea = bits_add(64, bp, d) by simp(hea, b64)
    have ea: bits_add(64, int_add(app(app(m, "gpr"), b), d), 0) = bits_add(64, bp, d) by simp(rb, b64, d64)
    have rd := apply(tr.reads, {s}, {m}, {w}, {v}, {bp}, {d}, {4}, b64, hd, hdef, hmm, simp())
    have ac := rewrite(sym(ea), rd.1)
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    have e := apply(x86i.load32_bd, {m}, {o}, {g}, {b}, {d}, {z2}, {len}, ipM, ipU, gR, hb, d64, ac, hx)
    have lw := all_elim(tr.le_bytes, {app(w, "vm")}, {bits_add(64, bp, d)}, {4})
    show by simp(e, ea, eae, rd.2, lw, hr, ha2, keep(gimple.bytes_at, x86_64_linux.le))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> BY in bits(int_mul(8, 4)) && BY in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs, gimple.bytes_at))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0v[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {BY}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// mov r64, simm32: g := kk, k sign-extended (kk: the spec's form)
theorem tr.mov64_simm(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g z k kk hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(77, pair(8, pair(tag(0, g), pair(z, k))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> k in bits(32) -> kk = bits_sext(32, 64, k) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(8, kk)), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g z k kk hs ds rs p w
  assume hat ha2 hg hk hkk hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(app(m, "gpr"), g, kk)), empty) proof
    fix m o
    assume hi hr hhs hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have hx := mp(mp(mp(all_elim(hat, {m}, {o}), ho), ipC), hr)
    have e := apply(x86i.mov64_simm, {m}, {o}, {g}, {z}, {k}, {len}, ipM, ipU, gR, hk, hx)
    show by simp(e, hr, ha2, hkk)
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      kk in bits(int_mul(8, 8)) && kk in bits(64) proof
    fix m
    show by simp(hk, hkk, keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {8}, {kk}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// a 4-byte field load at p + off
theorem tr.ld32_ok: all s p off. s in univ(1) -> p in bits(64) -> off in bits(32) -> g.mem_defined(s, p, off, 4, false) ->
  runs(gimple.ld32(p, off), s, ok(s, bits_of_int(32, gimple.bytes_at(app(s, "vm"), bits_add(64, p, off), 4))))
proof
  fix s p off
  assume hs hp ho hd
  have m := apply(g.mem_at_ok, {s}, {p}, {off}, {4}, {false}, hs, hp, ho, hd)
  have p64: pow2(64) = 18446744073709551616 by simp()
  have lt0: int_lt(int_add(p, off), pow2(64)) by taut(hd)
  have lt := rewrite(p64, lt0)
  have bdef: bits_add(64, p, off) = int_mod(int_add(p, off), 18446744073709551616) by defs(simp(), bits_add)
  have ev: int_add(p, off) = bits_add(64, p, off) by arith(bdef, hp, ho, lt)
  have m2 := rewrite(ev, m)
  have hb: bits_add(64, p, off) in bits(64) by simp()
  show by defs(simp(hs, hb, m2, keep(gimple.mem, gimple.bytes_at)), gimple.ld32)
qed

theorem tr.ld32_ub: all s p off s2 e. s in univ(1) -> s2 in univ(1) -> e in univ(1) -> p in bits(64) -> off in bits(32) -> !g.mem_defined(s, p, off, 4, false) ->
  runs(gimple.ld32(p, off), s, exc(s2, e))
proof
  fix s p off s2 e
  assume hs h2 he hp ho hn
  have m := apply(g.mem_at_ub, {s}, {p}, {off}, {4}, {false}, {s2}, {e}, hs, h2, he, hp, ho, hn)
  show by defs(simp(hs, h2, he, m, keep(gimple.mem)), gimple.ld32)
qed

// a shift right by k below the width n
theorem tr.shr_ok: all s n a k. s in univ(1) -> n in omega -> a in bits(n) -> k in omega -> int_lt(k, n) ->
  runs(gimple.shr(n, a, k), s, ok(s, bits_shr(n, a, k)))
proof
  fix s n a k
  assume hs hn ha hk hl
  show by defs(simp(hs, hn, ha, hk, hl), gimple.shr)
qed

theorem tr.shr_ub: all s n a k s2 e. s in univ(1) -> s2 in univ(1) -> e in univ(1) -> !int_lt(k, n) ->
  runs(gimple.shr(n, a, k), s, exc(s2, e))
proof
  fix s n a k s2 e
  assume hs h2 he hl
  show by defs(simp(hs, h2, he, hl), gimple.shr)
qed

// shr r32, cl (D3 /5), the count c below 32 (a count of 0 keeps the flags)
theorem x86i.shr32_cl: all m o g z c len. m in x86_64_linux.Machine -> m in univ(1) -> g in x86_64_linux.Reg ->
  bits_slice(app(app(m, "gpr"), 1), 7, 0) = c -> c in omega -> int_lt(c, 32) ->
  runs(x86_64_linux.exec_body(len, tag(74, pair(4, pair(5, pair(tag(0, g), z))))), m, o) ->
  ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", bits_add(64, app(m, "rip"), len)), "flags", f), "gpr",
    fn_update(app(m, "gpr"), g, bits_shr(32, bits_slice(app(app(m, "gpr"), g), 31, 0), c))), empty)
proof
  fix m o g z c len
  assume hM hu hg hc hc0 hc2 hr
  let G := ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", bits_add(64, app(m, "rip"), len)), "flags", f), "gpr",
    fn_update(app(m, "gpr"), g, bits_shr(32, bits_slice(app(app(m, "gpr"), g), 31, 0), c))), empty)
  have pt := apply(x86i.parts, hM)
  have cm: bits_add(5, c, 0) = c by arith(hc0, hc2)
  have z0: c = 0 -> G proof
    assume e
    have fs := apply(tr.flags_same, {m}, {bits_add(64, app(m, "rip"), len)}, {fn_update(app(m, "gpr"), g, bits_shr(32, bits_slice(app(app(m, "gpr"), g), 31, 0), c))}, hM)
    have r0 := rewrite(e, hc)
    have s0: bits_shr(32, bits_slice(app(app(m, "gpr"), g), 31, 0), 0) = bits_slice(app(app(m, "gpr"), g), 31, 0) by defs(simp(), bits_shr)
    have q: o = ok(fn_update(fn_update(m, "rip", bits_add(64, app(m, "rip"), len)), "gpr", fn_update(app(m, "gpr"), g, bits_shr(32, bits_slice(app(app(m, "gpr"), g), 31, 0), c))), empty)
      by simp(hr, hu, pt, apply(x86i.reg_typed, hM, hg), r0, e, s0, x86i.bool_univ)
    have fo := apply(tr.flags_ok_same, hM, hu)
    have q2 := rewrite(sym(fs), q)
    show by ex_intro({app(m, "flags")}, taut(fo, q2))
  qed
  have z1: int_lt(0, c) -> G proof
    assume e
    have r1: app(app(m, "gpr"), 1) in bits(64) by simp(pt)
    have c8: bits_add(8, app(app(m, "gpr"), 1), 0) = c by simp(hc, r1)
    have c5: bits_add(5, app(app(m, "gpr"), 1), 0) = c by arith(c8, hc0, hc2, r1)
    show by defs(simp(hr, hu, pt, apply(x86i.reg_typed, hM, hg), c5, hc0, e, hc2, x86i.bool_univ), x86i.flags_ok)
  qed
  have cc: c = 0 || int_lt(0, c) by arith(hc0)
  show by taut(z0, z1, cc)
qed

// shr r32, cl (cl's register holding c below 32)
theorem tr.shr32_cl(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g z c u r hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(74, pair(4, pair(5, pair(tag(0, g), z))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> 1 in dom(rs) -> app(rs, 1) = pair(4, c) -> g in dom(rs) -> app(rs, g) = pair(4, u) -> int_lt(c, 32) -> r = bits_shr(32, u, c) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(4, r)), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g z c u r hs ds rs p w
  assume hat ha2 hg hcd hc hd hu hc2 hr0 hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, r)), empty)) proof
    fix m o
    assume hi hr hh hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {4}, {u}, hrs, hd, hu)
    have rc := apply(tr.regs_get, {m}, {rs}, {1}, {4}, {c}, hrs, hcd, hc)
    have c0: c in omega by simp(rc)
    have cs: bits_slice(app(app(m, "gpr"), 1), 7, 0) = c by simp(rc, hc2)
    have hx := mp(mp(mp(all_elim(hat, {m}, {o}), ho), ipC), hr)
    obtain f, hf from apply(x86i.shr32_cl, {m}, {o}, {g}, {z}, {c}, {len}, ipM, ipU, gR, cs, c0, hc2, hx)
    show by ex_intro({f}, simp(hf, rg, hr, ha2, hr0, keep(x86i.flags_ok)))
  qed
  have t0: bits_shr(32, u, c) in bits(int_mul(8, 4)) && bits_shr(32, u, c) in bits(64) by simp()
  have t1: r in bits(int_mul(8, 4)) && r in bits(64) := rewrite(sym(hr0), t0)
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      r in bits(int_mul(8, 4)) && r in bits(64) proof
    fix m
    show by taut(t1)
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {r}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// mov r64, [rip + d]: the spec's load of a static's word at P + off (the
// same address)
theorem tr.load64_rip(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g d z2 pp off hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(76, pair(8, pair(g, pair(x86i.rip_mem(d), pair(x86i.rip_mem(d), z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> d in bits(64) -> pp in bits(64) -> off in bits(32) ->
  bits_add(64, int_add(a2, d), 0) = bits_add(64, pp, off) -> g.mem_defined(w, pp, off, 8, false) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs, g, pair(8, bits_of_int(64, gimple.bytes_at(app(w, "vm"), bits_add(64, pp, off), 8)))), p, w) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g d z2 pp off hs ds rs p w
  assume hat ha2 hg hd hp ho hA hdef hpt
  let BY := bits_of_int(64, gimple.bytes_at(app(w, "vm"), bits_add(64, pp, off), 8))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(app(m, "gpr"), g, BY)), empty) proof
    fix m o
    assume hi hr hhs hrs hmm ho2
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
    have ea: x86i.rip_ea(m, len, d) = bits_add(64, pp, off) by simp(hr, ha2, hA)
    have rd := apply(tr.reads, {s}, {m}, {w}, {v}, {pp}, {off}, {8}, hp, ho, hdef, hmm, simp())
    have ac := rewrite(sym(ea), rd.1)
    have hx := mp(all_elim(hat, {m}, {o}), ho2, ipC, hr)
    have e := apply(x86i.load64_rip, {m}, {o}, {g}, {d}, {z2}, {len}, ipM, ipU, gR, hd, ac, hx)
    have lw := all_elim(tr.le_bytes, {app(w, "vm")}, {bits_add(64, pp, off)}, {8})
    show by simp(e, ea, rd.2, lw, hr, ha2, keep(gimple.bytes_at, x86_64_linux.le))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> BY in bits(int_mul(8, 8)) && BY in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs, gimple.bytes_at))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0v[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {8}, {BY}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

theorem tr.imul_sint32: all a b. a in bits(32) -> b in bits(32) -> bits_of_int(32, int_mul(sint(32, a), sint(32, b))) = bits_mul(32, a, b)
proof
  fix a b
  assume ha hb
  have sa: sint(32, a) = a || sint(32, a) = int_sub(a, 4294967296) by defs(simp(ha), sint)
  have sb: sint(32, b) = b || sint(32, b) = int_sub(b, 4294967296) by defs(simp(hb), sint)
  let K := 4294967296
  have c1: int_mod(int_mul(int_sub(a, K), b), K) = int_mod(int_mul(a, b), K) by arith(ha, hb)
  have c2: int_mod(int_mul(a, int_sub(b, K)), K) = int_mod(int_mul(a, b), K) by arith(ha, hb)
  have cx: all x. x in int -> int_mod(int_mul(x, int_sub(b, K)), K) = int_mod(int_mul(x, b), K) proof
    fix x
    assume hx
    show by arith(hx, hb)
  qed
  have c3 := trans(mp(all_elim(cx, {int_sub(a, K)}), (int_sub(a, K) in int by arith(ha))), c1)
  have e: int_mod(int_mul(sint(32, a), sint(32, b)), K) = int_mod(int_mul(a, b), K) by simp(sa, sb, c1, c2, c3)
  show by defs(simp(e), bits_of_int, bits_mul)
qed

// a signed 32-bit product of two values
theorem tr.smul32v_ok: all s a b. s in univ(1) -> a in bits(32) -> b in bits(32) -> tr.s32_fits(int_mul(sint(32, a), sint(32, b))) ->
  runs(gimple.smul(32, a, b), s, ok(s, bits_mul(32, a, b)))
proof
  fix s a b
  assume hs ha hb hf
  have v := apply(tr.imul_sint32, {a}, {b}, ha, hb)
  show by defs(simp(hs, ha, hb, hf, v), gimple.smul, gimple.arith, gimple.wrap)
qed

// imul r32 (g holding u), [rsp + d] (the slot c holding x): r, their product
theorem tr.imul32_home(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g d c z1 z2 x u r hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(70, pair(4, pair(g, pair(x86i.rsp_mem(d), pair(z1, z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> d in bits(64) -> c = int_mod(int_sub(d, fr), 18446744073709551616) ->
  c in dom(hs) -> app(hs, c) = pair(4, x) -> g in dom(rs) -> app(rs, g) = pair(4, u) -> r = bits_mul(32, u, x) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(4, r)), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g d c z1 z2 x u r hs ds rs p w
  assume hat ha2 hg hd hcd hdh hx hgr hu hr hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, r)), empty)) proof
    fix m o
    assume hi hr0 hh hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have ac := apply(tr.home_acc, {s}, {base}, {code}, {fr}, {m}, {w}, {hs}, {d}, {c}, {4}, {x}, hi, hh, hd, hcd, hdh, hx)
    have hv := apply(tr.home_read, {s}, {base}, {code}, {fr}, {m}, {w}, {hs}, {d}, {c}, {4}, {x}, hi, hh, hd, hcd, hdh, hx)
    have rg u32 := apply(tr.regs_get, {m}, {rs}, {g}, {4}, {u}, hrs, hgr, hu)
    have hg2 := apply(tr.homes_get, {s}, {m}, {hs}, {c}, {4}, {x}, hh, hdh, hx)
    have x32: x in bits(32) by simp(hg2)
    have u32b: u in bits(32) by simp(u32)
    have sl: bits_slice(app(app(m, "gpr"), g), 31, 0) = u by simp(rg, u32b)
    have im := apply(tr.imul_sint32, {u}, {x}, u32b, x32)
    have hx2 := mp(all_elim(hat, {m}, {o}), ho, ipC, hr0)
    obtain f, hf from apply(x86i.imul32_rsp, {m}, {o}, {g}, {d}, {z1}, {z2}, {len}, ipM, ipU, gR, hd, taut(ac), hx2)
    have hf2 := rewrite(sl, hf)
    show by ex_intro({f}, simp(hf2, hv, im, hr, hr0, ha2, keep(x86i.flags_ok, abi.code_at, x86_64_linux.Machine)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      r in bits(int_mul(8, 4)) && r in bits(64) proof
    fix m
    show by simp(hr, keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {r}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// imul r32 (g holding u), r32 (h holding x): r, their product
theorem tr.imul32_rr(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g h z1 z2 x u r hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(70, pair(4, pair(g, pair(tag(0, h), pair(z1, z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> h in x86_64_linux.Reg ->
  h in dom(rs) -> app(rs, h) = pair(4, x) -> g in dom(rs) -> app(rs, g) = pair(4, u) -> r = bits_mul(32, u, x) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(4, r)), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g h z1 z2 x u r hs ds rs p w
  assume hat ha2 hg hh hhd hx hgr hu hr hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, r)), empty)) proof
    fix m o
    assume hi hr0 hhs hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rg u32 := apply(tr.regs_get, {m}, {rs}, {g}, {4}, {u}, hrs, hgr, hu)
    have rh x32 := apply(tr.regs_get, {m}, {rs}, {h}, {4}, {x}, hrs, hhd, hx)
    have u32b: u in bits(32) by simp(u32)
    have x32b: x in bits(32) by simp(x32)
    have sl: bits_slice(app(app(m, "gpr"), g), 31, 0) = u by simp(rg, u32b)
    have sh: bits_slice(app(app(m, "gpr"), h), 31, 0) = x by simp(rh, x32b)
    have im := apply(tr.imul_sint32, {u}, {x}, u32b, x32b)
    have hx2 := mp(all_elim(hat, {m}, {o}), ho, ipC, hr0)
    obtain f, hf from apply(x86i.imul32_rr, {m}, {o}, {g}, {h}, {z1}, {z2}, {len}, ipM, ipU, gR, hh, hx2)
    have hf2 := rewrite(sh, rewrite(sl, hf))
    show by ex_intro({f}, simp(hf2, im, hr, hr0, ha2, keep(x86i.flags_ok, abi.code_at, x86_64_linux.Machine)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      r in bits(int_mul(8, 4)) && r in bits(64) proof
    fix m
    show by simp(hr, keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {r}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// and ax, imm16 (rax holding a 16-bit u, of n bytes): u & k
theorem tr.and16_ax(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len k n u hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(49, pair(2, k))), m, o)) ->
  a2 = bits_add(64, a, len) -> k in bits(16) -> 0 in dom(rs) -> app(rs, 0) = pair(n, u) -> u in bits(16) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs,0, pair(2, bits_and(16, u, k))), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len k n u hs ds rs p w
  assume hat ha2 hk hd hu u16 hpt
  have hg: tr.scratch_reg(0) by defs(simp(), tr.scratch_reg)
  have i16 := mp(bits_and_in[n := 16, x := u, y := k], simp())
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), 0, bits_and(16, u, k))), empty)) proof
    fix m o
    assume hi hr hhs hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {0}, {n}, {u}, hrs, hd, hu)
    have sl: bits_slice(u, 15, 0) = u by defs(simp(u16), bits_slice, bits_of_int)
    have i64: bits_and(16, u, k) in bits(64) by arith(i16)
    have s64 := mp(bits_set_slice_in[n := 64, x := u, hi := 15, lo := 0, v := bits_and(16, u, k)], simp())
    have ss: bits_set_slice(64, u, 15, 0, bits_and(16, u, k)) = bits_and(16, u, k) by bitwise(u16, i16, i64, s64)
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    obtain f, hf from apply(x86i.and16_ax, {m}, {o}, {k}, {len}, ipM, ipU, hk, hx)
    show by ex_intro({f}, simp(hf, rg, sl, ss, hr, ha2, keep(x86i.flags_ok)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_and(16, u, k) in bits(int_mul(8, 2)) && bits_and(16, u, k) in bits(64) proof
    fix m
    show by simp(i16, keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {0}, {2}, {bits_and(16, u, k)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// a shift left by k below the width n
theorem tr.shl_ok: all s n a k. s in univ(1) -> n in omega -> a in bits(n) -> k in omega -> int_lt(k, n) ->
  runs(gimple.shl(n, a, k), s, ok(s, bits_shl(n, a, k)))
proof
  fix s n a k
  assume hs hn ha hk hl
  show by defs(simp(hs, hn, ha, hk, hl), gimple.shl)
qed

theorem tr.shl_ub: all s n a k s2 e. s in univ(1) -> s2 in univ(1) -> e in univ(1) -> !int_lt(k, n) ->
  runs(gimple.shl(n, a, k), s, exc(s2, e))
proof
  fix s n a k s2 e
  assume hs h2 he hl
  show by defs(simp(hs, h2, he, hl), gimple.shl)
qed

// shl r32, cl (D3 /4), the count c below 32 (a count of 0 keeps the flags)
theorem x86i.shl32_cl: all m o g z c len. m in x86_64_linux.Machine -> m in univ(1) -> g in x86_64_linux.Reg ->
  bits_slice(app(app(m, "gpr"), 1), 7, 0) = c -> c in omega -> int_lt(c, 32) ->
  runs(x86_64_linux.exec_body(len, tag(74, pair(4, pair(4, pair(tag(0, g), z))))), m, o) ->
  ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", bits_add(64, app(m, "rip"), len)), "flags", f), "gpr",
    fn_update(app(m, "gpr"), g, bits_shl(32, bits_slice(app(app(m, "gpr"), g), 31, 0), c))), empty)
proof
  fix m o g z c len
  assume hM hu hg hc hc0 hc2 hr
  let G := ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", bits_add(64, app(m, "rip"), len)), "flags", f), "gpr",
    fn_update(app(m, "gpr"), g, bits_shl(32, bits_slice(app(app(m, "gpr"), g), 31, 0), c))), empty)
  have pt := apply(x86i.parts, hM)
  have cm: bits_add(5, c, 0) = c by arith(hc0, hc2)
  have z0: c = 0 -> G proof
    assume e
    have fs := apply(tr.flags_same, {m}, {bits_add(64, app(m, "rip"), len)}, {fn_update(app(m, "gpr"), g, bits_shl(32, bits_slice(app(app(m, "gpr"), g), 31, 0), c))}, hM)
    have r0 := rewrite(e, hc)
    have s0: bits_shl(32, bits_slice(app(app(m, "gpr"), g), 31, 0), 0) = bits_slice(app(app(m, "gpr"), g), 31, 0) by defs(simp(), bits_shl)
    have q: o = ok(fn_update(fn_update(m, "rip", bits_add(64, app(m, "rip"), len)), "gpr", fn_update(app(m, "gpr"), g, bits_shl(32, bits_slice(app(app(m, "gpr"), g), 31, 0), c))), empty)
      by simp(hr, hu, pt, apply(x86i.reg_typed, hM, hg), r0, e, s0, x86i.bool_univ)
    have fo := apply(tr.flags_ok_same, hM, hu)
    have q2 := rewrite(sym(fs), q)
    show by ex_intro({app(m, "flags")}, taut(fo, q2))
  qed
  have z1: int_lt(0, c) -> G proof
    assume e
    have r1: app(app(m, "gpr"), 1) in bits(64) by simp(pt)
    have c8: bits_add(8, app(app(m, "gpr"), 1), 0) = c by simp(hc, r1)
    have c5: bits_add(5, app(app(m, "gpr"), 1), 0) = c by arith(c8, hc0, hc2, r1)
    show by defs(simp(hr, hu, pt, apply(x86i.reg_typed, hM, hg), c5, hc0, e, hc2, x86i.bool_univ), x86i.flags_ok)
  qed
  have cc: c = 0 || int_lt(0, c) by arith(hc0)
  show by taut(z0, z1, cc)
qed

// shl r32, cl (cl's register holding c below 32)
theorem tr.shl32_cl(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g z c u r hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(74, pair(4, pair(4, pair(tag(0, g), z))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> 1 in dom(rs) -> app(rs, 1) = pair(4, c) -> g in dom(rs) -> app(rs, g) = pair(4, u) -> int_lt(c, 32) -> r = bits_shl(32, u, c) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs,g, pair(4, r)), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g z c u r hs ds rs p w
  assume hat ha2 hg hcd hc hd hu hc2 hr0 hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, r)), empty)) proof
    fix m o
    assume hi hr hh hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {4}, {u}, hrs, hd, hu)
    have rc := apply(tr.regs_get, {m}, {rs}, {1}, {4}, {c}, hrs, hcd, hc)
    have c0: c in omega by simp(rc)
    have cs: bits_slice(app(app(m, "gpr"), 1), 7, 0) = c by simp(rc, hc2)
    have hx := mp(mp(mp(all_elim(hat, {m}, {o}), ho), ipC), hr)
    obtain f, hf from apply(x86i.shl32_cl, {m}, {o}, {g}, {z}, {c}, {len}, ipM, ipU, gR, cs, c0, hc2, hx)
    show by ex_intro({f}, simp(hf, rg, hr, ha2, hr0, keep(x86i.flags_ok)))
  qed
  have t0: bits_shl(32, u, c) in bits(int_mul(8, 4)) && bits_shl(32, u, c) in bits(64) by simp()
  have t1: r in bits(int_mul(8, 4)) && r in bits(64) := rewrite(sym(hr0), t0)
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      r in bits(int_mul(8, 4)) && r in bits(64) proof
    fix m
    show by taut(t1)
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {r}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed
