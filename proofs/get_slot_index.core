// get_slot_index (musl mallocng, readable GIMPLE at -O0): its outcomes.
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/records.core \
//     build/c_mallocng_malloc.core proofs/gimple.core proofs/get_slot_index.core
//
// p[-3] & 31, read as a byte: defined when p >= 3 (the pointer arithmetic
// does not leave the address space), p - 3 is not null, and the byte is
// readable; otherwise undefined (the spec may raise).

theorem gsi.proc_ok: all w p. w in univ(1) -> p in bits(64) -> int_le(3, p) -> !(int_sub(p, 3) = 0) -> gimple.usable(app(w, "vm"), int_sub(p, 3), 1, false) -> runs(c_src_malloc_mallocng_malloc.get_slot_index(p), w, ok(w, bits_and(32, bits_of_int(8, gimple.bytes_at(app(w, "vm"), int_sub(p, 3), 1)), 31)))
proof
  fix w
  fix p
  assume hw: w in univ(1)
  assume hp: p in bits(64)
  assume h3: int_le(3, p)
  assume hz: !(int_sub(p, 3) = 0)
  assume hu: gimple.usable(app(w, "vm"), int_sub(p, 3), 1, false)
  have pa: runs(gimple.padd(p, bits_neg(64, 3)), w, ok(w, int_sub(p, 3))) by simp(hw, hp, h3, expand(all_elim(all_elim(all_elim(g.padd_ok, {w}), {p}), {bits_neg(64, 3)}), gimple.sval), keep(gimple.padd))
  have la: runs(gimple.ld8(int_sub(p, 3), 0), w, ok(w, bits_of_int(8, gimple.bytes_at(app(w, "vm"), int_sub(p, 3), 1)))) by simp(hw, hp, h3, hz, hu, all_elim(all_elim(g.ld8_ok, {w}), {int_sub(p, 3)}), keep(gimple.ld8))
  show by defs(simp(hw, hp, h3, pa, la, keep(gimple.padd, gimple.ld8)), c_src_malloc_mallocng_malloc.get_slot_index)
qed

theorem gsi.fun_ok: all w args x. w in univ(1) -> args in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) -> x in bits(64) -> ord_le(1, seq_len(args)) -> int_le(3, bits_of_int(64, app(args, 0))) -> !(int_sub(bits_of_int(64, app(args, 0)), 3) = 0) -> gimple.usable(app(w, "vm"), int_sub(bits_of_int(64, app(args, 0)), 3), 1, false) -> runs(app(c_src_malloc_mallocng_malloc.get_slot_index_fun(), args), w, ok(w, pair(bits_and(32, bits_of_int(8, gimple.bytes_at(app(w, "vm"), int_sub(bits_of_int(64, app(args, 0)), 3), 1)), 31), x)))
proof
  fix w
  fix args
  fix x
  assume hw: w in univ(1)
  assume ha: args in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6))
  assume hx: x in bits(64)
  assume hl: ord_le(1, seq_len(args))
  assume h3: int_le(3, bits_of_int(64, app(args, 0)))
  assume hz: !(int_sub(bits_of_int(64, app(args, 0)), 3) = 0)
  assume hu: gimple.usable(app(w, "vm"), int_sub(bits_of_int(64, app(args, 0)), 3), 1, false)
  have pr := apply(gsi.proc_ok, {w}, {bits_of_int(64, app(args, 0))}, hw, simp(), h3, hz, hu)
  have rs := apply(g.result_ok, {w}, {bits_and(32, bits_of_int(8, gimple.bytes_at(app(w, "vm"), int_sub(bits_of_int(64, app(args, 0)), 3), 1)), 31)}, hw, simp())
  show by defs(simp(hw, ha, hx, hl, pr, rs, keep(c_src_malloc_mallocng_malloc.get_slot_index, gimple.result)), c_src_malloc_mallocng_malloc.get_slot_index_fun)
qed

theorem gsi.proc_raises: all w p e. w in univ(1) -> e in univ(1) -> p in bits(64) -> !(int_le(3, p) && !(int_sub(p, 3) = 0) && gimple.usable(app(w, "vm"), int_sub(p, 3), 1, false)) -> runs(c_src_malloc_mallocng_malloc.get_slot_index(p), w, exc(w, e))
proof
  fix w
  fix p
  fix e
  assume hw: w in univ(1)
  assume he: e in univ(1)
  assume hp: p in bits(64)
  assume hn: !(int_le(3, p) && !(int_sub(p, 3) = 0) && gimple.usable(app(w, "vm"), int_sub(p, 3), 1, false))
  have c1: int_lt(p, 3) -> runs(c_src_malloc_mallocng_malloc.get_slot_index(p), w, exc(w, e)) proof
    assume h3: int_lt(p, 3)
    have pu: runs(gimple.padd(p, bits_neg(64, 3)), w, exc(w, e)) by simp(hw, he, hp, h3, expand(all_elim(all_elim(all_elim(all_elim(all_elim(g.padd_ub, {w}), {p}), {bits_neg(64, 3)}), {w}), {e}), gimple.sval), keep(gimple.padd))
    show by defs(simp(hw, he, hp, pu, keep(gimple.padd, gimple.ld8)), c_src_malloc_mallocng_malloc.get_slot_index)
  qed
  have c2: int_le(3, p) -> runs(c_src_malloc_mallocng_malloc.get_slot_index(p), w, exc(w, e)) proof
    assume h3: int_le(3, p)
    have pa: runs(gimple.padd(p, bits_neg(64, 3)), w, ok(w, int_sub(p, 3))) by simp(hw, hp, h3, expand(all_elim(all_elim(all_elim(g.padd_ok, {w}), {p}), {bits_neg(64, 3)}), gimple.sval), keep(gimple.padd))
    have lu: runs(gimple.ld8(int_sub(p, 3), 0), w, exc(w, e)) by simp(hw, he, hp, h3, hn, all_elim(all_elim(all_elim(all_elim(g.ld8_ub, {w}), {int_sub(p, 3)}), {w}), {e}), keep(gimple.ld8))
    show by defs(simp(hw, he, hp, h3, pa, lu, keep(gimple.padd, gimple.ld8)), c_src_malloc_mallocng_malloc.get_slot_index)
  qed
  show by arith(c1, c2)
qed

theorem gsi.fun_raises: all w args e. w in univ(1) -> e in univ(1) -> args in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) -> !(ord_le(1, seq_len(args)) && int_le(3, bits_of_int(64, app(args, 0))) && !(int_sub(bits_of_int(64, app(args, 0)), 3) = 0) && gimple.usable(app(w, "vm"), int_sub(bits_of_int(64, app(args, 0)), 3), 1, false)) -> runs(app(c_src_malloc_mallocng_malloc.get_slot_index_fun(), args), w, exc(w, e))
proof
  fix w
  fix args
  fix e
  assume hw: w in univ(1)
  assume he: e in univ(1)
  assume ha: args in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6))
  assume hn: !(ord_le(1, seq_len(args)) && int_le(3, bits_of_int(64, app(args, 0))) && !(int_sub(bits_of_int(64, app(args, 0)), 3) = 0) && gimple.usable(app(w, "vm"), int_sub(bits_of_int(64, app(args, 0)), 3), 1, false))
  // no argument: undefined
  have c1: !ord_le(1, seq_len(args)) -> runs(app(c_src_malloc_mallocng_malloc.get_slot_index_fun(), args), w, exc(w, e)) proof
    assume hl: !ord_le(1, seq_len(args))
    show by defs(simp(hw, he, ha, hl, keep(c_src_malloc_mallocng_malloc.get_slot_index, gimple.result)), c_src_malloc_mallocng_malloc.get_slot_index_fun)
  qed
  // p[-3] undefined: the proc raises
  have c2: !(int_le(3, bits_of_int(64, app(args, 0))) && !(int_sub(bits_of_int(64, app(args, 0)), 3) = 0) && gimple.usable(app(w, "vm"), int_sub(bits_of_int(64, app(args, 0)), 3), 1, false)) -> runs(app(c_src_malloc_mallocng_malloc.get_slot_index_fun(), args), w, exc(w, e)) proof
    assume hd: !(int_le(3, bits_of_int(64, app(args, 0))) && !(int_sub(bits_of_int(64, app(args, 0)), 3) = 0) && gimple.usable(app(w, "vm"), int_sub(bits_of_int(64, app(args, 0)), 3), 1, false))
    have pr := apply(gsi.proc_raises, {w}, {bits_of_int(64, app(args, 0))}, {e}, hw, he, simp(), hd)
    show by defs(simp(hw, he, ha, pr, keep(c_src_malloc_mallocng_malloc.get_slot_index, gimple.result)), c_src_malloc_mallocng_malloc.get_slot_index_fun)
  qed
  show by taut(hn, c1, c2)
qed
