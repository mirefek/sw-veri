// get_slot_index (musl mallocng, readable GIMPLE at -O0): its outcomes.
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/records.core \
//     build/c_mallocng_malloc.core proofs/gimple.core proofs/get_slot_index.core
//
// p[-3] & 31, read as a byte: defined when p >= 3 (the pointer arithmetic
// does not leave the address space), p - 3 is not null, and the byte is
// readable; otherwise undefined (the spec may raise).

theorem gsi.proc_ok: all w p. w in univ(1) -> p in bits(64) -> int_le(3, p) -> !(int_sub(p, 3) = 0) -> gimple.usable(app(w, "vm"), int_sub(p, 3), 1, false) -> runs(c_src_malloc_mallocng_malloc.get_slot_index(p), w, ok(w, bits_and(32, bits_of_int(8, gimple.bytes_at(app(w, "vm"), int_sub(p, 3), 1)), 31)))
proof
  fix w
  fix p
  assume hw: w in univ(1)
  assume hp: p in bits(64)
  assume h3: int_le(3, p)
  assume hz: !(int_sub(p, 3) = 0)
  assume hu: gimple.usable(app(w, "vm"), int_sub(p, 3), 1, false)
  have pa: runs(gimple.padd(p, bits_neg(64, 3)), w, ok(w, int_sub(p, 3))) by simp(hw, hp, h3, expand(all_elim(all_elim(all_elim(g.padd_ok, {w}), {p}), {bits_neg(64, 3)}), gimple.sval), keep(gimple.padd))
  have la: runs(gimple.ld8(int_sub(p, 3), 0), w, ok(w, bits_of_int(8, gimple.bytes_at(app(w, "vm"), int_sub(p, 3), 1)))) by simp(hw, hp, h3, hz, hu, all_elim(all_elim(g.ld8_ok, {w}), {int_sub(p, 3)}), keep(gimple.ld8))
  show by defs(simp(hw, hp, h3, pa, la, keep(gimple.padd, gimple.ld8)), c_src_malloc_mallocng_malloc.get_slot_index)
qed

theorem gsi.fun_ok: all w args x. w in univ(1) -> args in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) -> x in bits(64) -> int_le(3, bits_of_int(64, app(args, 0))) -> !(int_sub(bits_of_int(64, app(args, 0)), 3) = 0) -> gimple.usable(app(w, "vm"), int_sub(bits_of_int(64, app(args, 0)), 3), 1, false) -> runs(app(c_src_malloc_mallocng_malloc.get_slot_index_fun(), args), w, ok(w, pair(bits_and(32, bits_of_int(8, gimple.bytes_at(app(w, "vm"), int_sub(bits_of_int(64, app(args, 0)), 3), 1)), 31), x)))
proof
  fix w
  fix args
  fix x
  assume hw: w in univ(1)
  assume ha: args in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6))
  assume hx: x in bits(64)
  assume h3: int_le(3, bits_of_int(64, app(args, 0)))
  assume hz: !(int_sub(bits_of_int(64, app(args, 0)), 3) = 0)
  assume hu: gimple.usable(app(w, "vm"), int_sub(bits_of_int(64, app(args, 0)), 3), 1, false)
  have pr := all_elim(all_elim(gsi.proc_ok, {w}), {bits_of_int(64, app(args, 0))})
  have fb := mp(app_fn_build[d := set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)), v := x0. mkprog(x1 x2. bind_rel(c_src_malloc_mallocng_malloc.get_slot_index(bits_of_int(64, app(x0, 0))), x1, x3 x4. letin(x4, x5. bind_rel(gimple.result(32, x5), x3, x6 x7. any_rel(x8. x8 in bits(64), x8. x2 = ok(x6, pair(x7, x8))), x6 x7. x2 = exc(x6, x7), x6. x2 = diverge(x6))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), a := args], ha)
  have g2: runs(mkprog(x0 x1. bind_rel(c_src_malloc_mallocng_malloc.get_slot_index(bits_of_int(64, app(args, 0))), x0, x2 x3. letin(x3, x4. bind_rel(gimple.result(32, x4), x2, x5 x6. any_rel(x7. x7 in bits(64), x7. x1 = ok(x5, pair(x6, x7))), x5 x6. x1 = exc(x5, x6), x5. x1 = diverge(x5))), x2 x3. x1 = exc(x2, x3), x2. x1 = diverge(x2))), w, ok(w, pair(bits_and(32, bits_of_int(8, gimple.bytes_at(app(w, "vm"), int_sub(bits_of_int(64, app(args, 0)), 3), 1)), 31), x)))
    by simp(hw, hx, h3, hz, hu, pr, all_elim(all_elim(g.result_ok, {w}), {bits_and(32, bits_of_int(8, gimple.bytes_at(app(w, "vm"), int_sub(bits_of_int(64, app(args, 0)), 3), 1)), 31)}), keep(c_src_malloc_mallocng_malloc.get_slot_index, gimple.result))
  show by defs(rewrite(sym(fb), g2), c_src_malloc_mallocng_malloc.get_slot_index_fun)
qed

theorem gsi.proc_raises: all w p e. w in univ(1) -> e in univ(1) -> p in bits(64) -> !(int_le(3, p) && !(int_sub(p, 3) = 0) && gimple.usable(app(w, "vm"), int_sub(p, 3), 1, false)) -> runs(c_src_malloc_mallocng_malloc.get_slot_index(p), w, exc(w, e))
proof
  fix w
  fix p
  fix e
  assume hw: w in univ(1)
  assume he: e in univ(1)
  assume hp: p in bits(64)
  assume hn: !(int_le(3, p) && !(int_sub(p, 3) = 0) && gimple.usable(app(w, "vm"), int_sub(p, 3), 1, false))
  have c1: int_lt(p, 3) -> runs(c_src_malloc_mallocng_malloc.get_slot_index(p), w, exc(w, e)) proof
    assume h3: int_lt(p, 3)
    have pu: runs(gimple.padd(p, bits_neg(64, 3)), w, exc(w, e)) by simp(hw, he, hp, h3, expand(all_elim(all_elim(all_elim(all_elim(g.padd_ub, {w}), {p}), {bits_neg(64, 3)}), {e}), gimple.sval), keep(gimple.padd))
    show by defs(simp(hw, he, hp, pu, keep(gimple.padd, gimple.ld8)), c_src_malloc_mallocng_malloc.get_slot_index)
  qed
  have c2: int_le(3, p) -> runs(c_src_malloc_mallocng_malloc.get_slot_index(p), w, exc(w, e)) proof
    assume h3: int_le(3, p)
    have pa: runs(gimple.padd(p, bits_neg(64, 3)), w, ok(w, int_sub(p, 3))) by simp(hw, hp, h3, expand(all_elim(all_elim(all_elim(g.padd_ok, {w}), {p}), {bits_neg(64, 3)}), gimple.sval), keep(gimple.padd))
    have lu: runs(gimple.ld8(int_sub(p, 3), 0), w, exc(w, e)) by simp(hw, he, hp, h3, hn, all_elim(all_elim(all_elim(g.ld8_ub, {w}), {int_sub(p, 3)}), {e}), keep(gimple.ld8))
    show by defs(simp(hw, he, hp, h3, pa, lu, keep(gimple.padd, gimple.ld8)), c_src_malloc_mallocng_malloc.get_slot_index)
  qed
  show by arith(c1, c2)
qed

theorem gsi.fun_raises: all w args e. w in univ(1) -> e in univ(1) -> args in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) -> !(int_le(3, bits_of_int(64, app(args, 0))) && !(int_sub(bits_of_int(64, app(args, 0)), 3) = 0) && gimple.usable(app(w, "vm"), int_sub(bits_of_int(64, app(args, 0)), 3), 1, false)) -> runs(app(c_src_malloc_mallocng_malloc.get_slot_index_fun(), args), w, exc(w, e))
proof
  fix w
  fix args
  fix e
  assume hw: w in univ(1)
  assume he: e in univ(1)
  assume ha: args in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6))
  assume hn: !(int_le(3, bits_of_int(64, app(args, 0))) && !(int_sub(bits_of_int(64, app(args, 0)), 3) = 0) && gimple.usable(app(w, "vm"), int_sub(bits_of_int(64, app(args, 0)), 3), 1, false))
  have pr := all_elim(all_elim(all_elim(gsi.proc_raises, {w}), {bits_of_int(64, app(args, 0))}), {e})
  have fb := mp(app_fn_build[d := set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)), v := x0. mkprog(x1 x2. bind_rel(c_src_malloc_mallocng_malloc.get_slot_index(bits_of_int(64, app(x0, 0))), x1, x3 x4. letin(x4, x5. bind_rel(gimple.result(32, x5), x3, x6 x7. any_rel(x8. x8 in bits(64), x8. x2 = ok(x6, pair(x7, x8))), x6 x7. x2 = exc(x6, x7), x6. x2 = diverge(x6))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), a := args], ha)
  have g2: runs(mkprog(x0 x1. bind_rel(c_src_malloc_mallocng_malloc.get_slot_index(bits_of_int(64, app(args, 0))), x0, x2 x3. letin(x3, x4. bind_rel(gimple.result(32, x4), x2, x5 x6. any_rel(x7. x7 in bits(64), x7. x1 = ok(x5, pair(x6, x7))), x5 x6. x1 = exc(x5, x6), x5. x1 = diverge(x5))), x2 x3. x1 = exc(x2, x3), x2. x1 = diverge(x2))), w, exc(w, e))
    by simp(hw, he, hn, pr, keep(c_src_malloc_mallocng_malloc.get_slot_index, gimple.result))
  show by defs(rewrite(sym(fb), g2), c_src_malloc_mallocng_malloc.get_slot_index_fun)
qed
