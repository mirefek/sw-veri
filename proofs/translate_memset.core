theorem g.st8_s_ub: all s p off v s2 e. s in univ(1) -> s2 in univ(1) -> e in univ(1) -> p in bits(64) -> off in bits(64) -> !g.mem_defined_s(s, p, off, 1, true) ->
  runs(gimple.st8(p, off, v), s, exc(s2, e))
proof
  fix s p off v s2 e
  assume hs h2 he hp ho hn
  have mu := apply(g.mem_s_ub, {s}, {p}, {off}, {1}, {true}, {s2}, {e}, hs, h2, he, hp, ho, hn)
  show by defs(simp(hs, h2, he, mu, keep(gimple.mem, gimple.write_bytes)), gimple.st8)
qed

