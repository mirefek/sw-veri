  have w := apply(g.write_ok, {s}, {A}, {2}, {v}, hs, ab, simp(), simp(), simp(hv), hvm, hf, hd)
  have stu := apply(fn_space_univ, bits_univ[n := 64], bits_univ[n := 8], apply(x86.store_typed, {s.vm.bytes}, {A}, {2}, {v}, simp(hvm)))
  show by defs(simp(hs, m, w, stu, keep(gimple.mem, gimple.write_bytes)), gimple.st16)
qed

theorem g.st32_s_ok: all s p off v. s in univ(1) -> p in bits(64) -> off in bits(64) -> v in bits(32) -> g.mem_defined_s(s, p, off, 4, true) ->
  s.vm in x86_64_linux.Vm -> is_fun(s) -> "vm" in dom(s) ->
