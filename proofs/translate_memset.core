// C1's rules for the instructions of musl's memset (src/string/x86_64/
// memset.s; its readable form layers/musl_asm_cfg.sl) not in the code
// so far: registers of 64 bits, the stores with an index register, rep
// stosq.

// ----------------------------------------------------------------------
//  movzx r64, r8 (REX.W 0F B6 /r): the byte register's value zero-extended

theorem x86i.movzx8_rq: all m o g h z2 len. m in x86_64_linux.Machine -> m in univ(1) -> g in x86_64_linux.Reg -> h in x86_64_linux.Reg ->
  runs(x86_64_linux.exec_body(len, tag(79, pair(8, pair(g, pair(tag(0, h), pair(tag(0, h), z2)))))), m, o) ->
  o = ok(fn_update(fn_update(m, "rip", bits_add(64, m.rip, len)), "gpr", fn_update(m.gpr, g, bits_slice(m.gpr[h], 7, 0))), empty)
proof
  fix m o g h z2 len
  assume hM hu hg hh hr
  have pt := apply(x86i.parts, hM)
  show by simp(hr, hu, pt, apply(x86i.reg_typed, hM, hg), hh, apply(x86i.reg_typed, hM, hh))
qed

// (a word's low byte: as GIMPLE's cast writes it)
theorem tr.low8_of: all u. u in omega -> bits_slice(u, 7, 0) = bits_of_int(8, u)
proof
  fix u
  assume hu
  have e0: int_mod(int_div(u, 1), 256) = int_mod(u, 256) by arith(hu)
  have p0: pow2(0) = 1 by simp()
  have p8: pow2(int_sub(int_succ(7), 0)) = 256 by simp()
  have p8b: pow2(8) = 256 by simp()
  show by defs(simp(e0, p0, p8, p8b), bits_slice, bits_of_int)
qed

theorem tr.low16_of: all u. u in omega -> bits_slice(u, 15, 0) = bits_of_int(16, u)
proof
  fix u
  assume hu
  have e0: int_mod(int_div(u, 1), 65536) = int_mod(u, 65536) by arith(hu)
  have p0: pow2(0) = 1 by simp()
  have p1: pow2(int_sub(int_succ(15), 0)) = 65536 by simp()
  have p1b: pow2(16) = 65536 by simp()
  show by defs(simp(e0, p0, p1, p1b), bits_slice, bits_of_int)
qed

theorem tr.low32_of: all u. u in omega -> bits_slice(u, 31, 0) = bits_of_int(32, u)
proof
  fix u
  assume hu
  have e0: int_mod(int_div(u, 1), 4294967296) = int_mod(u, 4294967296) by arith(hu)
  have p0: pow2(0) = 1 by simp()
  have p1: pow2(int_sub(int_succ(31), 0)) = 4294967296 by simp()
  have p1b: pow2(32) = 4294967296 by simp()
  show by defs(simp(e0, p0, p1, p1b), bits_slice, bits_of_int)
qed

// the step: g := h's low byte (h holding x, a word -- its low byte as
// GIMPLE's cast, bits_of_int(8, x))
theorem tr.movzx8_rq(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g h z2 k x hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a ->
    runs(x86_64_linux.exec_body(len, tag(79, pair(8, pair(g, pair(tag(0, h), pair(tag(0, h), z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> h in x86_64_linux.Reg -> h in dom(rs) -> rs[h] = pair(k, x) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs, g, pair(8, bits_of_int(8, x))), p, w) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g h z2 k x hs ds rs p w
  assume hat ha2 hg hh hd hx hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(m.gpr, g, bits_of_int(8, x))), empty) proof
    fix m o
    assume hi hr hhs hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {h}, {k}, {x}, hrs, hd, hx)
    have hx2 := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    have e := apply(x86i.movzx8_rq, {m}, {o}, {g}, {h}, {z2}, {len}, ipM, ipU, gR, hh, hx2)
    have x64: x in bits(64) := rewrite(rg.1, apply(x86i.reg_typed, ipM, hh))
    have sl := apply(tr.low8_of, (x in omega by simp(x64)))
    show by simp(e, rg.1, sl, hr, ha2)
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> bits_of_int(8, x) in bits(int_mul(8, 8)) && bits_of_int(8, x) in bits(64) proof
    fix m
    assume hi hr hhs hrs
    show by simp()
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {8}, {bits_of_int(8, x)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// ----------------------------------------------------------------------
//  GIMPLE's accesses at p + off, off any 64-bit offset (memset's k - 8:
//  computed from n) -- signed, as padd reads it

abbrev g.sv64(d) := gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), d)

// (defined: p not null, p + off within the address space, the bytes
// usable -- at the address, the word p + off)
abbrev g.mem_defined_s(s, p, off, n, w) := !(p = 0) && int_le(0, int_add(p, g.sv64(off))) && int_lt(int_add(p, g.sv64(off)), pow2(64)) &&
  gimple.usable(s.vm, s.objs, bits_add(64, p, off), n, w)

// (p + off, the signed offset within the address space: the word p + off)
theorem g.padd_s_eq: all p off. p in bits(64) -> off in bits(64) -> int_le(0, int_add(p, g.sv64(off))) -> int_lt(int_add(p, g.sv64(off)), pow2(64)) ->
  int_add(p, g.sv64(off)) = bits_add(64, p, off)
proof
  fix p off
  assume hp ho h0 h1
  have p64: pow2(64) = 18446744073709551616 by simp()
  have bdef: bits_add(64, p, off) = int_mod(int_add(p, off), 18446744073709551616) by defs(simp(), bits_add)
  have lt := rewrite(p64, h1)
  have cn: int_le(9223372036854775808, off) -> int_add(p, g.sv64(off)) = bits_add(64, p, off) proof
    assume hn
    have sv: g.sv64(off) = int_sub(off, 18446744073709551616) by defs(simp(hn), gimple.sval)
    have l0 := rewrite(sv, h0)
    have l1 := rewrite(sv, lt)
    have r: int_add(p, int_sub(off, 18446744073709551616)) = int_mod(int_add(p, off), 18446744073709551616) by arith(hp, ho, l0, l1)
    show by simp(sv, bdef, r)
  qed
  have cp: int_lt(off, 9223372036854775808) -> int_add(p, g.sv64(off)) = bits_add(64, p, off) proof
    assume hn
    have sv: g.sv64(off) = off by defs(simp(hn), gimple.sval)
    have l1 := rewrite(sv, lt)
    have r: int_add(p, off) = int_mod(int_add(p, off), 18446744073709551616) by arith(hp, ho, l1)
    show by simp(sv, bdef, r)
  qed
  have em: int_le(9223372036854775808, off) || int_lt(off, 9223372036854775808) by arith()
  show by taut(em, cn, cp)
qed

theorem g.mem_s_ok: all s p off n w. s in univ(1) -> p in bits(64) -> off in bits(64) -> g.mem_defined_s(s, p, off, n, w) ->
  runs(gimple.mem(p, off, n, w), s, ok(s, bits_add(64, p, off)))
proof
  fix s p off n w
  assume hs hp ho hd
  have dnz d0 dlt dus := hd
  have pa0 := apply(g.padd_ok, {s}, {p}, {off}, hs, hp, ho, d0, dlt)
  have pa := rewrite(apply(g.padd_s_eq, {p}, {off}, hp, ho, d0, dlt), pa0)
  show by defs(simp(hs, hp, ho, dnz, dus, pa, keep(gimple.padd)), gimple.mem)
qed

theorem g.mem_s_ub: all s p off n w s2 e. s in univ(1) -> s2 in univ(1) -> e in univ(1) -> p in bits(64) -> off in bits(64) -> !g.mem_defined_s(s, p, off, n, w) ->
  runs(gimple.mem(p, off, n, w), s, exc(s2, e))
proof
  fix s p off n w s2 e
  assume hs h2 he hp ho hn
  have c0: p = 0 -> runs(gimple.mem(p, off, n, w), s, exc(s2, e)) proof
    assume hz
    show by defs(simp(hs, h2, he, hz, keep(gimple.padd)), gimple.mem)
  qed
  have c1: !(p = 0) -> !(int_le(0, int_add(p, g.sv64(off))) && int_lt(int_add(p, g.sv64(off)), pow2(64))) -> runs(gimple.mem(p, off, n, w), s, exc(s2, e)) proof
    assume hz hl
    have pu: runs(gimple.padd(p, off), s, exc(s2, e)) by defs(simp(hs, h2, he, hp, ho, hl), gimple.padd, gimple.binop, gimple.fits, gimple.wrap, gimple.arith)
    show by defs(simp(hs, h2, he, hz, pu, keep(gimple.padd)), gimple.mem)
  qed
  have c2: !(p = 0) -> int_le(0, int_add(p, g.sv64(off))) -> int_lt(int_add(p, g.sv64(off)), pow2(64)) -> runs(gimple.mem(p, off, n, w), s, exc(s2, e)) proof
    assume hz h0 hl
    have hu: !gimple.usable(s.vm, s.objs, bits_add(64, p, off), n, w) by taut(hn, hz, h0, hl)
    have pa0 := apply(g.padd_ok, {s}, {p}, {off}, hs, hp, ho, h0, hl)
    have pa := rewrite(apply(g.padd_s_eq, {p}, {off}, hp, ho, h0, hl), pa0)
    show by defs(simp(hs, h2, he, hz, hu, pa, keep(gimple.padd)), gimple.mem)
  qed
  show by taut(c0, c1, c2)
qed

// (the stores: n bytes written at the word p + off)
theorem g.st8_s_ok: all s p off v. s in univ(1) -> p in bits(64) -> off in bits(64) -> v in bits(8) -> g.mem_defined_s(s, p, off, 1, true) ->
  s.vm in x86_64_linux.Vm -> is_fun(s) -> "vm" in dom(s) ->
  runs(gimple.st8(p, off, v), s, ok(fn_update(s, "vm", fn_update(s.vm, "bytes", x86_64_linux.store_le(s.vm.bytes, bits_add(64, p, off), 1, v))), empty))
proof
  fix s p off v
  assume hs hp ho hv hdf hvm hf hd
  let A := bits_add(64, p, off)
  have m := apply(g.mem_s_ok, {s}, {p}, {off}, {1}, {true}, hs, hp, ho, hdf)
  have ab: A in bits(64) by simp()
  have w := apply(g.write_ok, {s}, {A}, {1}, {v}, hs, ab, simp(), simp(), simp(hv), hvm, hf, hd)
  have stu := apply(fn_space_univ, bits_univ[n := 64], bits_univ[n := 8], apply(x86.store_typed, {s.vm.bytes}, {A}, {1}, {v}, simp(hvm)))
  show by defs(simp(hs, m, w, stu, keep(gimple.mem, gimple.write_bytes)), gimple.st8)
qed

theorem g.st16_s_ok: all s p off v. s in univ(1) -> p in bits(64) -> off in bits(64) -> v in bits(16) -> g.mem_defined_s(s, p, off, 2, true) ->
  s.vm in x86_64_linux.Vm -> is_fun(s) -> "vm" in dom(s) ->
  runs(gimple.st16(p, off, v), s, ok(fn_update(s, "vm", fn_update(s.vm, "bytes", x86_64_linux.store_le(s.vm.bytes, bits_add(64, p, off), 2, v))), empty))
proof
