theorem tr.st64_s_ok: all w p off v a. w in abi.World -> w in univ(1) -> p in bits(64) -> off in bits(64) -> v in bits(64) -> a = bits_add(64, p, off) ->
  g.mem_defined_s(w, p, off, 8, true) ->
