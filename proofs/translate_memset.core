// (in the bridge's world: the stores at a, the word p + off -- the
// arguments as tr.st64_at_ok's)
theorem tr.st8_s_ok: all w p off v a. w in abi.World -> w in univ(1) -> p in bits(64) -> off in bits(64) -> v in bits(8) -> a = bits_add(64, p, off) ->
  g.mem_defined_s(w, p, off, 1, true) ->
  runs(gimple.st8(p, off, v), w, ok(fn_update(w, "vm", fn_update(w.vm, "bytes", x86_64_linux.store_le(w.vm.bytes, a, 1, v))), empty))
proof
  fix w p off v a
  assume hW hw hp ho hv ha hd
  have wf := expand(hW, abi.World)
  have r := apply(g.st8_s_ok, {w}, {p}, {off}, {v}, hw, hp, ho, hv, hd, simp(wf), simp(wf), simp(wf))
  show := rewrite(sym(ha), r)
qed

theorem tr.st16_s_ok: all w p off v a. w in abi.World -> w in univ(1) -> p in bits(64) -> off in bits(64) -> v in bits(16) -> a = bits_add(64, p, off) ->
  g.mem_defined_s(w, p, off, 2, true) ->
  runs(gimple.st16(p, off, v), w, ok(fn_update(w, "vm", fn_update(w.vm, "bytes", x86_64_linux.store_le(w.vm.bytes, a, 2, v))), empty))
