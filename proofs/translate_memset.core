// ----------------------------------------------------------------------
//  mov [b + i + d], r (88 /r, 89 /r): the stores with an index register

abbrev x86i.bid_mem(b, i, d) := tag(2, fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(2, b)), "index", some(i)), "scale", 1), "disp", d))
abbrev x86i.bid_ea(m, b, i, d) := bits_add(64, int_add(int_add(m.gpr[b], bits_mul(64, m.gpr[i], 1)), d), 0)

// (the address: (b + i) + d, words)
theorem tr.bid_ea: all bv iv d. bv in bits(64) -> iv in bits(64) -> bits_add(64, int_add(int_add(bv, bits_mul(64, iv, 1)), d), 0) = bits_add(64, bits_add(64, bv, iv), d)
proof
  fix bv iv d
  assume hb hi
  have m1: bits_mul(64, iv, 1) = iv by defs(arith(hi), bits_mul)
  have l := mp(mod_add_mod[x := int_add(bv, iv), y := d, m := pow2(64)], simp())
  show by defs(simp(m1, l), bits_add)
qed

// mov byte [b + i + d], r8 (88 /r)
theorem x86i.store8_bid: all m o g b i d z0 z1 len. m in x86_64_linux.Machine -> m in univ(1) -> g in x86_64_linux.Reg ->
  b in x86_64_linux.Reg -> i in x86_64_linux.Reg -> d in bits(64) ->
  x86i.acc(m, x86i.bid_ea(m, b, i, d), 1, 1) ->
  runs(x86_64_linux.exec_body(len, tag(28, pair(z0, pair(z1, pair(x86i.bid_mem(b, i, d), tag(0, g)))))), m, o) ->
  o = ok(fn_update(fn_update(m, "rip", bits_add(64, m.rip, len)), "vm",
    fn_update(m.vm, "bytes", x86_64_linux.store_le(m.vm.bytes, x86i.bid_ea(m, b, i, d), 1, bits_slice(m.gpr[g], 7, 0)))), empty)
proof
  fix m o g b i d z0 z1 len
  assume hM hu hg hb hi hd a0 h
  have pt := apply(x86i.parts, hM)
  have k0: all j. j in omega -> int_lt(j, 1) -> x86_64_linux.canonical(bits_add(64, x86i.bid_ea(m, b, i, d), bits_of_int(64, j))) proof
    fix j
    assume j1 j2
    show by mp(all_elim(all_elim(all_elim(x86.access_canonical, {m.vm}), {bits_add(64, x86i.bid_ea(m, b, i, d), bits_of_int(64, j))}), {1}), mp(mp(all_elim(a0, {j}), j1), j2))
  qed
  show by simp(h, hu, pt, apply(x86i.reg_typed, hM, hg), apply(x86i.reg_typed, hM, hb), apply(x86i.reg_typed, hM, hi), hd, a0, k0, x86.touch_range_access,
    keep(x86_64_linux.touch_range, x86_64_linux.can_access))
qed

// mov [b + i + d], r16 / r32 / r64 (66 89 /r, 89 /r, REX.W 89 /r)
