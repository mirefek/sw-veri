// the steps: the spec's n-byte store x at pp + off (signed, the word),
// the machine's at (bv + iv) + d -- the same address by their normal
// forms; x the register's low n bytes
theorem tr.store8_bid(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g b i d z0 z1 bv iv k u x pp off hs ds rs p p2 w w2. tr.hap(s, hs, v) ->
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a ->
    runs(x86_64_linux.exec_body(len, tag(28, pair(z0, pair(z1, pair(x86i.bid_mem(b, i, d), tag(0, g)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> base in omega -> g in x86_64_linux.Reg -> b in x86_64_linux.Reg -> i in x86_64_linux.Reg -> d in bits(64) ->
  b in dom(rs) -> rs[b] = pair(8, bv) -> i in dom(rs) -> rs[i] = pair(8, iv) -> g in dom(rs) -> rs[g] = pair(k, u) ->
  bits_of_int(8, u) = x -> pp in bits(64) -> off in bits(64) -> bits_add(64, bits_add(64, bv, iv), d) = bits_add(64, pp, off) ->
  g.mem_defined_s(w, pp, off, 1, true) ->
  w2 = fn_update(w, "vm", fn_update(w.vm, "bytes", x86_64_linux.store_le(w.vm.bytes, bits_add(64, pp, off), 1, x))) ->
  tr.red(p, w, p2, w2) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, rs, p2, w2) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g b i d z0 z1 bv iv k u x pp off hs ds rs p p2 w w2
  assume hap hat ha2 hbase hg hb hi0 hd hbd hbu hid hiu hgd hgu hx hp ho hA hdef hw2 hred hpt
  have dnz d0 dlt dus := hdef
  let A := bits_add(64, pp, off)
  have ab: A in bits(64) by simp()
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "vm", fn_update(m.vm, "bytes", x86_64_linux.store_le(m.vm.bytes, A, 1, x))), empty) proof
    fix m o
    assume hi hr hh hrs hmm ho2
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rb b64 := apply(tr.regs_get, {m}, {rs}, {b}, {8}, {bv}, hrs, hbd, hbu)
    have ri i64 := apply(tr.regs_get, {m}, {rs}, {i}, {8}, {iv}, hrs, hid, hiu)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {k}, {u}, hrs, hgd, hgu)
    have ea: x86i.bid_ea(m, b, i, d) = A by simp(rb, ri, trans(apply(tr.bid_ea, {bv}, {iv}, {d}, simp(b64), simp(i64)), hA))
    have wa := apply(tr.store_acc, {s}, {m}, {w}, {v}, {A}, {1}, hmm, ab, simp(), simp(), dus)
    have wa2 := rewrite(sym(ea), wa)
    have hx2 := mp(all_elim(hat, {m}, {o}), ho2, ipC, hr)
    have e := apply(x86i.store8_bid, {m}, {o}, {g}, {b}, {i}, {d}, {z0}, {z1}, {len}, ipM, ipU, hg, hb, hi0, hd, wa2, hx2)
    have sl := apply(tr.low8_of, (u in omega by simp(rewrite(rg.1, apply(x86i.reg_typed, ipM, hg)))))
    show by simp(e, ea, rg, sl, hx, hr, ha2)
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.store_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {A}, {1}, {x}, {hs}, {ds}, {rs}, {p}, {p2}, {w}, {w2}, hap, he, hbase, a2b, ab, simp(), simp(), dus, hw2, hred, hpt)
qed

theorem tr.store16_bid(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g b i d z1 z2 bv iv k u x pp off hs ds rs p p2 w w2. tr.hap(s, hs, v) ->
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a ->
    runs(x86_64_linux.exec_body(len, tag(75, pair(2, pair(g, pair(x86i.bid_mem(b, i, d), pair(z1, z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> base in omega -> g in x86_64_linux.Reg -> b in x86_64_linux.Reg -> i in x86_64_linux.Reg -> d in bits(64) ->
  b in dom(rs) -> rs[b] = pair(8, bv) -> i in dom(rs) -> rs[i] = pair(8, iv) -> g in dom(rs) -> rs[g] = pair(k, u) ->
  bits_of_int(16, u) = x -> pp in bits(64) -> off in bits(64) -> bits_add(64, bits_add(64, bv, iv), d) = bits_add(64, pp, off) ->
  g.mem_defined_s(w, pp, off, 2, true) ->
  w2 = fn_update(w, "vm", fn_update(w.vm, "bytes", x86_64_linux.store_le(w.vm.bytes, bits_add(64, pp, off), 2, x))) ->
  tr.red(p, w, p2, w2) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, rs, p2, w2) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g b i d z1 z2 bv iv k u x pp off hs ds rs p p2 w w2
  assume hap hat ha2 hbase hg hb hi0 hd hbd hbu hid hiu hgd hgu hx hp ho hA hdef hw2 hred hpt
  have dnz d0 dlt dus := hdef
  let A := bits_add(64, pp, off)
  have ab: A in bits(64) by simp()
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "vm", fn_update(m.vm, "bytes", x86_64_linux.store_le(m.vm.bytes, A, 2, x))), empty) proof
    fix m o
    assume hi hr hh hrs hmm ho2
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rb b64 := apply(tr.regs_get, {m}, {rs}, {b}, {8}, {bv}, hrs, hbd, hbu)
    have ri i64 := apply(tr.regs_get, {m}, {rs}, {i}, {8}, {iv}, hrs, hid, hiu)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {k}, {u}, hrs, hgd, hgu)
    have ea: x86i.bid_ea(m, b, i, d) = A by simp(rb, ri, trans(apply(tr.bid_ea, {bv}, {iv}, {d}, simp(b64), simp(i64)), hA))
    have wa := apply(tr.store_acc, {s}, {m}, {w}, {v}, {A}, {2}, hmm, ab, simp(), simp(), dus)
    have wa2 := rewrite(sym(ea), wa)
    have hx2 := mp(all_elim(hat, {m}, {o}), ho2, ipC, hr)
    have e := apply(x86i.store16_bid, {m}, {o}, {g}, {b}, {i}, {d}, {z1}, {z2}, {len}, ipM, ipU, hg, hb, hi0, hd, wa2, hx2)
    have sl := apply(tr.low16_of, (u in omega by simp(rewrite(rg.1, apply(x86i.reg_typed, ipM, hg)))))
    show by simp(e, ea, rg, sl, hx, hr, ha2)
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.store_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {A}, {2}, {x}, {hs}, {ds}, {rs}, {p}, {p2}, {w}, {w2}, hap, he, hbase, a2b, ab, simp(), simp(), dus, hw2, hred, hpt)
qed

theorem tr.store32_bid(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g b i d z1 z2 bv iv k u x pp off hs ds rs p p2 w w2. tr.hap(s, hs, v) ->
