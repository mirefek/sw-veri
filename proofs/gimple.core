// Readable GIMPLE (layers/gimple.sl): what its operations do, as the spec
// side of a refinement -- `runs(op, s, o)` goals, by `simp`.
//
//   slc elab spec layers build/gimple-O0/sl/c_mallocng_malloc.sl -o build/c_mallocng_malloc.core
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/records.core \
//     build/c_mallocng_malloc.core proofs/gimple.core
//
// Each operation from a state s (in univ(1): states are sets of the first
// universe) either returns its value in s, or -- where GIMPLE has undefined
// behavior -- may raise anything (`exc(s, e)`), which is what makes a spec
// raise (`abi.spec_raises`).

theorem g.padd_ok: all s p d. s in univ(1) -> p in bits(64) -> d in bits(64) -> int_le(0, int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), d))) -> int_lt(int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), d)), pow2(64)) -> runs(gimple.padd(p, d), s, ok(s, int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), d))))
proof
  fix s
  fix p
  fix d
  assume hs: s in univ(1)
  assume hp: p in bits(64)
  assume hd: d in bits(64)
  assume h0: int_le(0, int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), d)))
  assume h1: int_lt(int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), d)), pow2(64))
  show by defs(simp(hs, hp, hd, h0, h1), gimple.padd, gimple.binop, gimple.fits, gimple.wrap, gimple.arith)
qed

theorem g.ld8_ok: all s a. s in univ(1) -> a in bits(64) -> !(a = 0) -> gimple.usable(app(s, "vm"), a, 1, false) -> runs(gimple.ld8(a, 0), s, ok(s, bits_of_int(8, gimple.bytes_at(app(s, "vm"), a, 1))))
proof
  fix s
  fix a
  assume hs: s in univ(1)
  assume ha: a in bits(64)
  assume hz: !(a = 0)
  assume hu: gimple.usable(app(s, "vm"), a, 1, false)
  have pa: runs(gimple.padd(a, 0), s, ok(s, a)) by simp(hs, ha, expand(all_elim(all_elim(all_elim(g.padd_ok, {s}), {a}), {0}), gimple.sval), keep(gimple.padd))
  show by defs(simp(hs, ha, hz, hu, pa, keep(gimple.padd)), gimple.ld8, gimple.mem)
qed

theorem g.padd_ub: all s p d e. s in univ(1) -> e in univ(1) -> p in bits(64) -> d in bits(64) -> int_lt(int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), d)), 0) -> runs(gimple.padd(p, d), s, exc(s, e))
proof
  fix s
  fix p
  fix d
  fix e
  assume hs: s in univ(1)
  assume he: e in univ(1)
  assume hp: p in bits(64)
  assume hd: d in bits(64)
  assume h0: int_lt(int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), d)), 0)
  show by defs(simp(hs, he, hp, hd, h0), gimple.padd, gimple.binop, gimple.fits, gimple.wrap, gimple.arith)
qed

theorem g.ld8_ub: all s a e. s in univ(1) -> e in univ(1) -> !(!(a = 0) && gimple.usable(app(s, "vm"), a, 1, false)) -> a in bits(64) -> runs(gimple.ld8(a, 0), s, exc(s, e))
proof
  fix s
  fix a
  fix e
  assume hs: s in univ(1)
  assume he: e in univ(1)
  assume hn: !(!(a = 0) && gimple.usable(app(s, "vm"), a, 1, false))
  assume ha: a in bits(64)
  have pa: runs(gimple.padd(a, 0), s, ok(s, a)) by simp(hs, ha, expand(all_elim(all_elim(all_elim(g.padd_ok, {s}), {a}), {0}), gimple.sval), keep(gimple.padd))
  have c1: !(a = 0) -> runs(gimple.ld8(a, 0), s, exc(s, e)) proof
    assume hz: !(a = 0)
    have hu: !gimple.usable(app(s, "vm"), a, 1, false) by taut(hn, hz)
    show by defs(simp(hs, he, ha, hu, hz, pa, keep(gimple.padd)), gimple.ld8, gimple.mem)
  qed
  have c2: a = 0 -> runs(gimple.ld8(a, 0), s, exc(s, e)) proof
    assume hz: a = 0
    show by defs(simp(hs, he, ha, hz, keep(gimple.padd)), gimple.ld8, gimple.mem)
  qed
  show by taut(c1, c2)
qed

theorem g.result_ok: all w v. w in univ(1) -> v in bits(32) -> runs(gimple.result(32, v), w, ok(w, v))
proof
  fix w
  fix v
  assume hw: w in univ(1)
  assume hv: v in bits(32)
  show by defs(simp(hw, hv), gimple.result, gimple.in_reg)
qed

// memory usable for reading can be read by the machine (whose memory has
// the same pages)
theorem g.usable_read: all v vm a n i. gimple.usable(v, a, n, false) -> app(v, "pages") = app(vm, "pages") -> int_le(0, a) -> i in omega -> int_lt(i, n) ->
  x86_64_linux.can_access(vm, bits_of_int(64, int_add(a, i)), 0)
proof
  fix v
  fix vm
  fix a
  fix n
  fix i
  assume hu: gimple.usable(v, a, n, false)
  assume hpg: app(v, "pages") = app(vm, "pages")
  assume h0: int_le(0, a)
  assume hi: i in omega
  assume hn: int_lt(i, n)
  have u := rewrite(hpg, expand(mp(all_elim(expand(hu, gimple.usable), {i}), hi, hn), x86_64_linux.mapped))
  have mpd: int_lt(int_div(int_add(a, i), 4096), 34359738367) by simp(expand(u, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))
  have eb: bits_of_int(64, int_add(a, i)) = int_add(a, i) by simp(mpd, h0, hi)
  show by defs(simp(u, eb), x86_64_linux.can_access, x86_64_linux.page_of, x86_64_linux.mapped, x86_64_linux.hw_allows, x86_64_linux.accessible)
qed
