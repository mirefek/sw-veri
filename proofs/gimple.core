// Readable GIMPLE (layers/gimple.sl): what its operations do, as the spec
// side of a refinement -- `runs(op, s, o)` goals, by `simp`.
//
//   slc elab spec layers build/gimple-O0/sl/c_mallocng_malloc.sl -o build/c_mallocng_malloc.core
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core core/records.core \
//     core/loop.core build/c_mallocng_malloc.core proofs/x86.core proofs/gimple.core
//
// Each operation from a state s (in univ(1): states are sets of the first
// universe) either returns its value in s, or -- where GIMPLE has undefined
// behavior -- may raise anything (`exc(s, e)`), which is what makes a spec
// raise (`abi.spec_raises`).

theorem g.padd_ok: all s p d. s in univ(1) -> p in bits(64) -> d in bits(64) -> int_le(0, int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), d))) -> int_lt(int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), d)), pow2(64)) -> runs(gimple.padd(p, d), s, ok(s, int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), d))))
proof
  fix s p d
  assume hs hp hd h0 h1
  show by defs(simp(hs, hp, hd, h0, h1), gimple.padd, gimple.binop, gimple.fits, gimple.wrap, gimple.arith)
qed

theorem g.ld8_ok: all s a. s in univ(1) -> a in bits(64) -> !(a = 0) -> gimple.usable(app(s, "vm"), a, 1, false) -> runs(gimple.ld8(a, 0), s, ok(s, bits_of_int(8, gimple.bytes_at(app(s, "vm"), a, 1))))
proof
  fix s a
  assume hs ha hz hu
  have pa: runs(gimple.padd(a, 0), s, ok(s, a)) by simp(hs, ha, expand(all_elim(all_elim(all_elim(g.padd_ok, {s}), {a}), {0}), gimple.sval), keep(gimple.padd))
  show by defs(simp(hs, ha, hz, hu, pa, keep(gimple.padd)), gimple.ld8, gimple.mem)
qed

theorem g.padd_ub: all s p d s2 e. s in univ(1) -> s2 in univ(1) -> e in univ(1) -> p in bits(64) -> d in bits(64) -> int_lt(int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), d)), 0) -> runs(gimple.padd(p, d), s, exc(s2, e))
proof
  fix s p d s2 e
  assume hs h2 he hp hd h0
  show by defs(simp(hs, h2, he, hp, hd, h0), gimple.padd, gimple.binop, gimple.fits, gimple.wrap, gimple.arith)
qed

theorem g.ld8_ub: all s a s2 e. s in univ(1) -> s2 in univ(1) -> e in univ(1) -> !(!(a = 0) && gimple.usable(app(s, "vm"), a, 1, false)) -> a in bits(64) -> runs(gimple.ld8(a, 0), s, exc(s2, e))
proof
  fix s a s2 e
  assume hs h2 he hn ha
  have pa: runs(gimple.padd(a, 0), s, ok(s, a)) by simp(hs, ha, expand(all_elim(all_elim(all_elim(g.padd_ok, {s}), {a}), {0}), gimple.sval), keep(gimple.padd))
  have c1: !(a = 0) -> runs(gimple.ld8(a, 0), s, exc(s2, e)) proof
    assume hz
    have hu: !gimple.usable(app(s, "vm"), a, 1, false) by taut(hn, hz)
    show by defs(simp(hs, h2, he, ha, hu, hz, pa, keep(gimple.padd)), gimple.ld8, gimple.mem)
  qed
  have c2: a = 0 -> runs(gimple.ld8(a, 0), s, exc(s2, e)) proof
    assume hz
    show by defs(simp(hs, h2, he, ha, hz, keep(gimple.padd)), gimple.ld8, gimple.mem)
  qed
  show by taut(c1, c2)
qed

theorem g.result_ok: all w v. w in univ(1) -> v in bits(32) -> runs(gimple.result(32, v), w, ok(w, v))
proof
  fix w v
  assume hw hv
  show by defs(simp(hw, hv), gimple.result, gimple.in_reg)
qed

theorem g.result64_ok: all w v. w in univ(1) -> v in bits(64) -> runs(gimple.result(64, v), w, ok(w, v))
proof
  fix w v
  assume hw hv
  show by defs(simp(hw, hv), gimple.result, gimple.in_reg)
qed

// memory usable for reading can be read by the machine (whose memory has
// the same pages)
theorem g.usable_read: all v vm a n i. gimple.usable(v, a, n, false) -> app(v, "pages") = app(vm, "pages") -> int_le(0, a) -> i in omega -> int_lt(i, n) ->
  x86_64_linux.can_access(vm, bits_of_int(64, int_add(a, i)), 0)
proof
  fix v vm a n i
  assume hu hpg h0 hi hn
  have u := rewrite(hpg, expand(mp(all_elim(expand(hu, gimple.usable), {i}), hi, hn), x86_64_linux.mapped))
  have mpd: int_lt(int_div(int_add(a, i), 4096), 34359738367) by simp(expand(u, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))
  have eb: bits_of_int(64, int_add(a, i)) = int_add(a, i) by simp(mpd, h0, hi)
  show by defs(simp(u, eb), x86_64_linux.can_access, x86_64_linux.page_of, x86_64_linux.mapped, x86_64_linux.hw_allows, x86_64_linux.accessible)
qed

// ... and memory usable for writing can be written
theorem g.usable_write: all v vm a n i. gimple.usable(v, a, n, true) -> app(v, "pages") = app(vm, "pages") -> int_le(0, a) -> i in omega -> int_lt(i, n) ->
  x86_64_linux.can_access(vm, bits_of_int(64, int_add(a, i)), 1)
proof
  fix v vm a n i
  assume hu hpg h0 hi hn
  have u := rewrite(hpg, expand(mp(all_elim(expand(hu, gimple.usable), {i}), hi, hn), x86_64_linux.mapped))
  have mpd: int_lt(int_div(int_add(a, i), 4096), 34359738367) by simp(expand(u, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))
  have eb: bits_of_int(64, int_add(a, i)) = int_add(a, i) by simp(mpd, h0, hi)
  show by defs(simp(u, eb), x86_64_linux.can_access, x86_64_linux.page_of, x86_64_linux.mapped, x86_64_linux.hw_allows, x86_64_linux.accessible)
qed

// the bytes after a store are a member of the universe
theorem g.store_univ: all vm a n v. vm in x86_64_linux.Vm -> x86_64_linux.store_le(app(vm, "bytes"), a, n, v) in univ(1)
proof
  fix vm a n v
  assume hv
  show := apply(fn_space_univ, bits_univ[n := 64], bits_univ[n := 8], apply(x86.store_typed, {app(vm, "bytes")}, {a}, {n}, {v}, simp(hv)))
qed

// stores: the address (`mem`), the bytes written (`write_bytes`, a loop
// run in the goal: `unroll`), a 32-bit store, and its undefined behavior
theorem g.mem_ok: all s a n w. s in univ(1) -> a in bits(64) -> !(a = 0) -> gimple.usable(app(s, "vm"), a, n, w) -> runs(gimple.mem(a, 0, n, w), s, ok(s, a))
proof
  fix s a n w
  assume hs ha hz hu
  have pa: runs(gimple.padd(a, 0), s, ok(s, a)) by simp(hs, ha, expand(all_elim(g.padd_ok, {s}, {a}, {0}), gimple.sval), keep(gimple.padd))
  show by defs(simp(hs, ha, hz, hu, pa, keep(gimple.padd)), gimple.mem)
qed

theorem g.write4_ok: all s a v. s in univ(1) -> a in bits(64) -> v in omega -> app(s, "vm") in x86_64_linux.Vm -> is_fun(s) -> "vm" in dom(s) ->
  runs(gimple.write_bytes(a, 4, v), s, ok(fn_update(s, "vm", fn_update(app(s, "vm"), "bytes", x86_64_linux.store_le(app(app(s, "vm"), "bytes"), a, 4, v))), empty))
proof
  fix s a v
  assume hs ha hv hvm hf hd
  have s4 := apply(x86.store4, {app(app(s, "vm"), "bytes")}, {a}, {v}, simp(hvm), simp(hvm), ha, hv)
  show by defs(simp(hs, ha, hv, hvm, hf, hd, s4, unroll), gimple.write_bytes)
qed

theorem g.st32_ok: all s a v. s in univ(1) -> a in bits(64) -> v in bits(32) -> !(a = 0) -> gimple.usable(app(s, "vm"), a, 4, true) ->
  app(s, "vm") in x86_64_linux.Vm -> is_fun(s) -> "vm" in dom(s) ->
  runs(gimple.st32(a, 0, v), s, ok(fn_update(s, "vm", fn_update(app(s, "vm"), "bytes", x86_64_linux.store_le(app(app(s, "vm"), "bytes"), a, 4, v))), empty))
proof
  fix s a v
  assume hs ha hv hz hu hvm hf hd
  have m := apply(g.mem_ok, {s}, {a}, {4}, {true}, hs, ha, hz, hu)
  have w := apply(g.write4_ok, {s}, {a}, {v}, hs, ha, simp(hv), hvm, hf, hd)
  have stu := apply(fn_space_univ, bits_univ[n := 64], bits_univ[n := 8], apply(x86.store_typed, {app(app(s, "vm"), "bytes")}, {a}, {4}, {v}, simp(hvm)))
  show by defs(simp(hs, m, w, stu, keep(gimple.mem, gimple.write_bytes)), gimple.st32)
qed

theorem g.st32_ub: all s a v s2 e. s in univ(1) -> s2 in univ(1) -> e in univ(1) -> a in bits(64) -> !(!(a = 0) && gimple.usable(app(s, "vm"), a, 4, true)) ->
  runs(gimple.st32(a, 0, v), s, exc(s2, e))
proof
  fix s a v s2 e
  assume hs h2 he ha hn
  have pa: runs(gimple.padd(a, 0), s, ok(s, a)) by simp(hs, ha, expand(all_elim(g.padd_ok, {s}, {a}, {0}), gimple.sval), keep(gimple.padd))
  have c1: !(a = 0) -> runs(gimple.mem(a, 0, 4, true), s, exc(s2, e)) proof
    assume hz
    have hu: !gimple.usable(app(s, "vm"), a, 4, true) by taut(hn, hz)
    show by defs(simp(hs, h2, he, ha, hz, hu, pa, keep(gimple.padd)), gimple.mem)
  qed
  have c2: a = 0 -> runs(gimple.mem(a, 0, 4, true), s, exc(s2, e)) proof
    assume hz
    show by defs(simp(hs, h2, he, ha, hz, keep(gimple.padd)), gimple.mem)
  qed
  have mu: runs(gimple.mem(a, 0, 4, true), s, exc(s2, e)) by taut(c1, c2)
  show by defs(simp(hs, h2, he, mu, keep(gimple.mem, gimple.write_bytes)), gimple.st32)
qed

// a byte array's element: p + i (an index of 32 bits, the size 1)
theorem g.elem1_ok: all s p i. s in univ(1) -> p in bits(64) -> i in bits(32) -> int_lt(int_add(p, i), pow2(64)) -> runs(gimple.elem(p, i, 1), s, ok(s, int_add(p, i)))
proof
  fix s p i
  assume hs hp hi hl
  have sv: gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), i) = i by defs(simp(hi), gimple.sval)
  have si: sint(64, i) = i by defs(simp(hi), sint)
  have pa: runs(gimple.padd(p, i), s, ok(s, int_add(p, i))) by simp(hs, hp, hi, hl, rewrite(sv, all_elim(g.padd_ok, {s}, {p}, {i})), keep(gimple.padd))
  show by defs(simp(hs, hp, hi, si, pa, keep(gimple.padd)), gimple.elem, gimple.smul, gimple.arith, gimple.fits, gimple.wrap)
qed

// an array's element of size k: p + i * k (an index of 32 bits; i * k
// below 2^40, which a literal k shows linearly)
theorem g.elem_ok: all s p i k. s in univ(1) -> p in bits(64) -> i in bits(32) -> k in bits(8) -> int_mul(i, k) in bits(40) -> int_lt(int_add(p, int_mul(i, k)), pow2(64)) ->
  runs(gimple.elem(p, i, k), s, ok(s, int_add(p, int_mul(i, k))))
proof
  fix s p i k
  assume hs hp hi hk ik hl
  have il: int_lt(int_mul(i, k), 1099511627776) by simp(ik)
  have sv: gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), int_mul(i, k)) = int_mul(i, k) by defs(simp(ik, il), gimple.sval)
  have si: sint(64, i) = i by defs(simp(hi), sint)
  have sk: sint(64, k) = k by defs(simp(hk), sint)
  have pa: runs(gimple.padd(p, int_mul(i, k)), s, ok(s, int_add(p, int_mul(i, k)))) by simp(hs, hp, ik, hl, rewrite(sv, all_elim(g.padd_ok, {s}, {p}, {int_mul(i, k)})), keep(gimple.padd))
  show by defs(simp(hs, hp, hi, hk, ik, il, si, sk, pa, keep(gimple.padd)), gimple.elem, gimple.smul, gimple.arith, gimple.fits, gimple.wrap)
qed

// an access of n bytes at p + off (off a small constant): its address,
// or undefined (p null, p + off past the address space, not usable)
abbrev g.mem_defined(v, p, off, n, w) := !(p = 0) && int_lt(int_add(p, off), pow2(64)) && gimple.usable(v, int_add(p, off), n, w)

theorem g.mem_at_ok: all s p off n w. s in univ(1) -> p in bits(64) -> off in bits(32) -> g.mem_defined(app(s, "vm"), p, off, n, w) ->
  runs(gimple.mem(p, off, n, w), s, ok(s, int_add(p, off)))
proof
  fix s p off n w
  assume hs hp ho hd
  have ol: int_lt(off, 4294967296) by simp(ho)
  have sv: gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), off) = off by defs(simp(ho, ol), gimple.sval)
  have pa: runs(gimple.padd(p, off), s, ok(s, int_add(p, off))) by simp(hs, hp, ho, hd, rewrite(sv, all_elim(g.padd_ok, {s}, {p}, {off})), keep(gimple.padd))
  show by defs(simp(hs, hp, ho, hd, pa, keep(gimple.padd)), gimple.mem)
qed

theorem g.mem_at_ub: all s p off n w s2 e. s in univ(1) -> s2 in univ(1) -> e in univ(1) -> p in bits(64) -> off in bits(32) -> !g.mem_defined(app(s, "vm"), p, off, n, w) ->
  runs(gimple.mem(p, off, n, w), s, exc(s2, e))
proof
  fix s p off n w s2 e
  assume hs h2 he hp ho hn
  have ol: int_lt(off, 4294967296) by simp(ho)
  have sv: gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), off) = off by defs(simp(ho, ol), gimple.sval)
  have c0: p = 0 -> runs(gimple.mem(p, off, n, w), s, exc(s2, e)) proof
    assume hz
    show by defs(simp(hs, h2, he, hz, keep(gimple.padd)), gimple.mem)
  qed
  have c1: !(p = 0) -> !int_lt(int_add(p, off), pow2(64)) -> runs(gimple.mem(p, off, n, w), s, exc(s2, e)) proof
    assume hz hl
    have pu: runs(gimple.padd(p, off), s, exc(s2, e)) by defs(simp(hs, h2, he, hp, ho, hl, sv), gimple.padd, gimple.binop, gimple.fits, gimple.wrap, gimple.arith)
    show by defs(simp(hs, h2, he, hz, pu, keep(gimple.padd)), gimple.mem)
  qed
  have c2: !(p = 0) -> int_lt(int_add(p, off), pow2(64)) -> runs(gimple.mem(p, off, n, w), s, exc(s2, e)) proof
    assume hz hl
    have hu: !gimple.usable(app(s, "vm"), int_add(p, off), n, w) by taut(hn, hz, hl)
    have pa: runs(gimple.padd(p, off), s, ok(s, int_add(p, off))) by simp(hs, hp, ho, hl, rewrite(sv, all_elim(g.padd_ok, {s}, {p}, {off})), keep(gimple.padd))
    show by defs(simp(hs, h2, he, hz, hu, pa, keep(gimple.padd)), gimple.mem)
  qed
  show by taut(c0, c1, c2)
qed

// a bit field of k bits at bit pos of the n bytes at p + off
theorem g.ldbf_ok: all s p off n pos k. s in univ(1) -> p in bits(64) -> off in bits(32) -> g.mem_defined(app(s, "vm"), p, off, n, false) ->
  runs(gimple.ldbf(p, off, n, pos, k), s, ok(s, int_mod(int_div(gimple.bytes_at(app(s, "vm"), int_add(p, off), n), int_pow(2, pos)), int_pow(2, k))))
proof
  fix s p off n pos k
  assume hs hp ho hd
  have m := apply(g.mem_at_ok, {s}, {p}, {off}, {n}, {false}, hs, hp, ho, hd)
  have hb: int_add(p, off) in bits(64) by simp(hp, ho, hd)
  show by defs(simp(hs, hb, m, keep(gimple.mem)), gimple.ldbf)
qed

theorem g.ldbf_ub: all s p off n pos k s2 e. s in univ(1) -> s2 in univ(1) -> e in univ(1) -> p in bits(64) -> off in bits(32) -> !g.mem_defined(app(s, "vm"), p, off, n, false) ->
  runs(gimple.ldbf(p, off, n, pos, k), s, exc(s2, e))
proof
  fix s p off n pos k s2 e
  assume hs h2 he hp ho hn
  have m := apply(g.mem_at_ub, {s}, {p}, {off}, {n}, {false}, {s2}, {e}, hs, h2, he, hp, ho, hn)
  show by defs(simp(hs, h2, he, m, keep(gimple.mem)), gimple.ldbf)
qed

theorem g.ld16_ok: all s a. s in univ(1) -> a in bits(64) -> g.mem_defined(app(s, "vm"), a, 0, 2, false) ->
  runs(gimple.ld16(a, 0), s, ok(s, bits_of_int(16, gimple.bytes_at(app(s, "vm"), a, 2))))
proof
  fix s a
  assume hs ha hd
  have m := apply(g.mem_at_ok, {s}, {a}, {0}, {2}, {false}, hs, ha, simp(), hd)
  show by defs(simp(hs, ha, m, keep(gimple.mem)), gimple.ld16)
qed

theorem g.ld16_ub: all s a s2 e. s in univ(1) -> s2 in univ(1) -> e in univ(1) -> a in bits(64) -> !g.mem_defined(app(s, "vm"), a, 0, 2, false) ->
  runs(gimple.ld16(a, 0), s, exc(s2, e))
proof
  fix s a s2 e
  assume hs h2 he ha hn
  have m := apply(g.mem_at_ub, {s}, {a}, {0}, {2}, {false}, {s2}, {e}, hs, h2, he, ha, simp(), hn)
  show by defs(simp(hs, h2, he, m, keep(gimple.mem)), gimple.ld16)
qed
