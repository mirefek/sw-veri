// Linking the C1 theorems of mallocng's functions: a caller's C1 takes
// its callee's contract as premises (tr.call, tr.call1); here they are
// discharged with the callees' own C1 theorems. Every
// contract assumes the same loaded program (the program text, text.code),
// so a callee's contract is its caller's premise as it is. Checked after
// proofs/translate_effects.core, the program text, proofs/a_crash.core and
// their C1 (proofs/mallocng_c1.core).
//
// For a callee, beside its contract (FN.implements): its spec typed as the
// ABI has specs (FN.typed) and its returns keeping the world valid for
// GIMPLE, or the spec undefined (FN.io), both generated in the callee's
// certificate (for a caller, from its callees').

// ---------------------------------------------------------------------
//  a_clz_32 with a_ctz_32

theorem aclz.linked: all statics. tr.implements_at(4205721, c_src_malloc_mallocng_malloc.a_clz_32_fun(c_src_malloc_mallocng_malloc.a_ctz_32_fun()), 4202755, text.code, statics)
proof
  fix statics
  show := mp(all_elim(aclz.implements, {statics}, {c_src_malloc_mallocng_malloc.a_ctz_32_fun()}), all_elim(act.implements, {statics}), act.typed, act.io)
qed

theorem aclz.linked_abi: all statics. abi.implements2_at(single(empty), 4205721, c_src_malloc_mallocng_malloc.a_clz_32_fun(c_src_malloc_mallocng_malloc.a_ctz_32_fun()), 4202755, text.code, statics)
proof
  fix statics
  show := apply(tr.implements_abi, all_elim(aclz.linked, {statics}))
qed

theorem aclz.io_linked: tr.callee_io(c_src_malloc_mallocng_malloc.a_clz_32_fun(c_src_malloc_mallocng_malloc.a_ctz_32_fun()), 1)
proof
  show := mp(all_elim(aclz.io, {c_src_malloc_mallocng_malloc.a_ctz_32_fun()}), act.io)
qed

theorem aclz.typed_linked: c_src_malloc_mallocng_malloc.a_clz_32_fun(c_src_malloc_mallocng_malloc.a_ctz_32_fun()) in fn_space(abi.ARGS, powerset(univ(1)))
proof
  show := all_elim(aclz.typed, {c_src_malloc_mallocng_malloc.a_ctz_32_fun()})
qed

