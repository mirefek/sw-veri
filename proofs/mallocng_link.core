// Linking the C1 certificates of mallocng's functions: a caller's
// certificate takes its callee's contract as premises (tr.call1); here they
// are discharged with the callees' own certificates. Checked after
// proofs/translate_effects.core and the certificates (proofs/FN_tr.core).
//
// For a callee, beside its contract (FN.implements):
// - its contract for the code of the program it is linked into (the
//   callee's code first: tr.implements_widen, tr.loaded_before);
// - its spec typed as the ABI has specs (tr.fun_typed);
// - its spec's returns keeping the world valid for GIMPLE, or the spec
//   undefined (tr.callee_io, from the spec's structure by
//   proofs/translate_effects.core's lemmas).

// ---------------------------------------------------------------------
//  a_ctz_32 as a callee

// its spec's returns: the world kept, or undefined
theorem act.eff: all w x. tr.eff(w, o. runs(c_src_malloc_mallocng_malloc.a_ctz_32(x), w, o))
proof
  fix w x
  let X7 := bits_shr(32, bits_mul(32, bits_and(32, x, bits_sub(32, 0, x)), 124511785), 27)
  // the table's element, then its byte
  have kl: all s1 v. runs(gimple.elem(c_src_malloc_mallocng_malloc.debruijn32, X7, 1), w, ok(s1, v)) ->
      tr.eff(s1, o. bind_rel(gimple.ld8(v, 0), s1, x10 x11. o = ok(x10, bits_sext(8, 32, x11)), x10 x11. o = exc(x10, x11), x10. o = diverge(x10))) proof
    fix s1 v
    assume _
    show by apply(tr.eff_bind_ret, {s1}, all_elim(tr.eff_ld8, {s1}, {v}, {0}))
  qed
  have be := apply(tr.eff_bind, {w}, all_elim(tr.eff_elem, {w}, {c_src_malloc_mallocng_malloc.debruijn32}, {X7}, {1}), kl)
  // the uninitialised local: any value
  have ka: all x2. x2 in bits(32) -> tr.eff(w, o. bind_rel(gimple.elem(c_src_malloc_mallocng_malloc.debruijn32, X7, 1), w, x8 x9.
      bind_rel(gimple.ld8(x9, 0), x8, x10 x11. o = ok(x10, bits_sext(8, 32, x11)), x10 x11. o = exc(x10, x11), x10. o = diverge(x10)), x8 x9. o = exc(x8, x9), x8. o = diverge(x8))) proof
    fix x2
    assume _
    show := be
  qed
  show by defs(apply(tr.eff_prog, {w}, apply(tr.eff_any, {w}, ka)), c_src_malloc_mallocng_malloc.a_ctz_32, letin)
qed

theorem act.io: tr.callee_io(c_src_malloc_mallocng_malloc.a_ctz_32_fun(), 1)
proof
  have g: all args w. args in abi.ARGS -> ord_le(1, seq_len(args)) -> tr.eff(w, o. runs(mkprog(x1 x2. !ord_le(1, seq_len(args)) ||
      bind_rel(c_src_malloc_mallocng_malloc.a_ctz_32(bits_of_int(32, app(args, 0))), x1, x3 x4. letin(x4, x5. bind_rel(gimple.result(32, x5), x3,
        x6 x7. any_rel(x8. x8 in bits(64), x8. x2 = ok(x6, pair(x7, x8))), x6 x7. x2 = exc(x6, x7), x6. x2 = diverge(x6))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, o)) proof
    fix args w
    assume _ hn
    // the result: any upper half
    have kr: all s1 v. runs(c_src_malloc_mallocng_malloc.a_ctz_32(bits_of_int(32, app(args, 0))), w, ok(s1, v)) ->
        tr.eff(s1, o. bind_rel(gimple.result(32, v), s1, x6 x7. any_rel(x8. x8 in bits(64), x8. o = ok(x6, pair(x7, x8))), x6 x7. o = exc(x6, x7), x6. o = diverge(x6))) proof
      fix s1 v
      assume _
      have kk: all s2 v2. runs(gimple.result(32, v), s1, ok(s2, v2)) -> tr.eff(s2, o. any_rel(x8. x8 in bits(64), x8. o = ok(s2, pair(v2, x8)))) proof
        fix s2 v2
        assume _
        have kx: all x8. x8 in bits(64) -> tr.eff(s2, o. o = ok(s2, pair(v2, x8))) proof
          fix x8
          assume _
          show := all_elim(tr.eff_ret, {s2}, {pair(v2, x8)})
        qed
        show by apply(tr.eff_any, {s2}, kx)
      qed
      show by apply(tr.eff_bind, {s1}, all_elim(tr.eff_result, {s1}, {32}, {v}), kk)
    qed
    have b := apply(tr.eff_bind, {w}, all_elim(act.eff, {w}, {bits_of_int(32, app(args, 0))}), kr)
    show by defs(apply(tr.eff_prog, {w}, apply(tr.eff_guard, {w}, hn, b)), letin)
  qed
  show by defs(apply(tr.callee_io_fun, {1}, g), c_src_malloc_mallocng_malloc.a_ctz_32_fun)
qed

theorem act.typed: c_src_malloc_mallocng_malloc.a_ctz_32_fun() in fn_space(abi.ARGS, powerset(univ(1)))
proof
  show by defs(tr.fun_typed, c_src_malloc_mallocng_malloc.a_ctz_32_fun)
qed

// its contract with a_clz_32's code loaded after it
theorem act.implements_clz: all statics. tr.implements_at(4205681, c_src_malloc_mallocng_malloc.a_ctz_32_fun(), 4205681, seq_concat(a_ctz_32.code, a_clz_32.code), statics)
proof
  fix statics
  have w: all vm. abi.loaded(vm, 4205681, seq_concat(a_ctz_32.code, a_clz_32.code), statics) -> abi.loaded(vm, 4205681, a_ctz_32.code, statics) proof
    fix vm
    assume h
    have l := apply(tr.loaded_before, simp(), simp(), simp(), expand(h, a_ctz_32.code, a_clz_32.code))
    show by defs(l, a_ctz_32.code)
  qed
  show := apply(tr.implements_widen, all_elim(act.implements, {statics}), w)
qed

// ---------------------------------------------------------------------
//  a_clz_32 with its callee

theorem aclz.linked: all statics. tr.implements_at(4205721, c_src_malloc_mallocng_malloc.a_clz_32_fun(c_src_malloc_mallocng_malloc.a_ctz_32_fun()), 4205681,
  seq_concat(a_ctz_32.code, a_clz_32.code), statics)
proof
  fix statics
  show := mp(all_elim(aclz.implements, {statics}, {c_src_malloc_mallocng_malloc.a_ctz_32_fun()}), all_elim(act.implements_clz, {statics}), act.typed, act.io)
qed

theorem aclz.linked_abi: all statics. abi.implements2_at(single(empty), 4205721, c_src_malloc_mallocng_malloc.a_clz_32_fun(c_src_malloc_mallocng_malloc.a_ctz_32_fun()), 4205681,
  seq_concat(a_ctz_32.code, a_clz_32.code), statics)
proof
  fix statics
  show := apply(tr.implements_abi, all_elim(aclz.linked, {statics}))
qed
