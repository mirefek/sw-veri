// Linking the C1 certificates of mallocng's functions: a caller's
// certificate takes its callee's contract as premises (tr.call, tr.call1); here they
// are discharged with the callees' own certificates. Checked after
// proofs/translate_effects.core and the certificates (proofs/FN_tr.core).
//
// For a callee, beside its contract (FN.implements):
// - its contract for the code of the program it is linked into (the
//   callee's code first: tr.implements_widen, tr.loaded_before);
// - its spec typed as the ABI has specs (FN.typed) and its returns keeping
//   the world valid for GIMPLE, or the spec undefined (FN.io), both
//   generated in the callee's certificate.

// ---------------------------------------------------------------------
//  a_ctz_32 as a callee

// (its spec typed and its tr.callee_io: act.typed, act.io, generated in
// proofs/a_ctz_32_tr.core)

// its contract with a_clz_32's code loaded after it
theorem act.implements_clz: all statics. tr.implements_at(4205681, c_src_malloc_mallocng_malloc.a_ctz_32_fun(), 4205681, seq_concat(a_ctz_32.code, a_clz_32.code), statics)
proof
  fix statics
  have w: all vm. abi.loaded(vm, 4205681, seq_concat(a_ctz_32.code, a_clz_32.code), statics) -> abi.loaded(vm, 4205681, a_ctz_32.code, statics) proof
    fix vm
    assume h
    have l := apply(tr.loaded_before, simp(), simp(), simp(), expand(h, a_ctz_32.code, a_clz_32.code))
    show by defs(l, a_ctz_32.code)
  qed
  show := apply(tr.implements_widen, all_elim(act.implements, {statics}), w)
qed

// ---------------------------------------------------------------------
//  a_clz_32 with its callee

theorem aclz.linked: all statics. tr.implements_at(4205721, c_src_malloc_mallocng_malloc.a_clz_32_fun(c_src_malloc_mallocng_malloc.a_ctz_32_fun()), 4205681,
  seq_concat(a_ctz_32.code, a_clz_32.code), statics)
proof
  fix statics
  show := mp(all_elim(aclz.implements, {statics}, {c_src_malloc_mallocng_malloc.a_ctz_32_fun()}), all_elim(act.implements_clz, {statics}), act.typed, act.io)
qed

theorem aclz.linked_abi: all statics. abi.implements2_at(single(empty), 4205721, c_src_malloc_mallocng_malloc.a_clz_32_fun(c_src_malloc_mallocng_malloc.a_ctz_32_fun()), 4205681,
  seq_concat(a_ctz_32.code, a_clz_32.code), statics)
proof
  fix statics
  show := apply(tr.implements_abi, all_elim(aclz.linked, {statics}))
qed

// ---------------------------------------------------------------------
//  dequeue as a callee (malloc.c's copy; dqt.typed, dqt.io in
//  proofs/dequeue_tr.core)

// its contract with dequeue_head's code loaded after it
theorem dqt.implements_head: all statics. tr.implements_at(4206409, c_src_malloc_mallocng_malloc.dequeue_fun(), 4206409, seq_concat(dequeue.code, dequeue_head.code), statics)
proof
  fix statics
  have w: all vm. abi.loaded(vm, 4206409, seq_concat(dequeue.code, dequeue_head.code), statics) -> abi.loaded(vm, 4206409, dequeue.code, statics) proof
    fix vm
    assume h
    have l := apply(tr.loaded_before, simp(), simp(), simp(), expand(h, dequeue.code, dequeue_head.code))
    show by defs(l, dequeue.code)
  qed
  show := apply(tr.implements_widen, all_elim(dqt.implements, {statics}), w)
qed

// ---------------------------------------------------------------------
//  dequeue_head with its callee

theorem dqht.linked: all statics. tr.implements_at(4206554, c_src_malloc_mallocng_malloc.dequeue_head_fun(c_src_malloc_mallocng_malloc.dequeue_fun()), 4206409,
  seq_concat(dequeue.code, dequeue_head.code), statics)
proof
  fix statics
  show := mp(all_elim(dqht.implements, {statics}, {c_src_malloc_mallocng_malloc.dequeue_fun()}), all_elim(dqt.implements_head, {statics}), dqt.typed, dqt.io)
qed

theorem dqht.linked_abi: all statics. abi.implements2_at(single(empty), 4206554, c_src_malloc_mallocng_malloc.dequeue_head_fun(c_src_malloc_mallocng_malloc.dequeue_fun()), 4206409,
  seq_concat(dequeue.code, dequeue_head.code), statics)
proof
  fix statics
  show := apply(tr.implements_abi, all_elim(dqht.linked, {statics}))
qed
