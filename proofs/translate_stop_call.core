// A call in the stop form (as tr.callee_sim, translate_call.core): the
// caller's claim with t a breakpoint, its relation there tr.at_t; the
// callee's contract with the stop at t -- its stop the caller's breakpoint,
// the call there raising at main.

// the contract with the stop for an entry of any alignment (as
// tr.implements_at_u)
def tr.implements_stop_u(f, spec, t, base, code, statics) :=
  all args objs mem s o. args in abi.ARGS -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(s.vm, base, code, statics) ->
    s.rip = f -> tr.entry_ok_u(s, args) -> tr.objs_ok(s, objs) -> abi.view_ok(s, objs, mem) -> tr.run_s(s, t, s, o) -> tr.matches_ts(spec, args, objs, mem, s, o)

// a callee's contract in the stop form (as tr.callee_contract)
def tr.callee_contract_s(fr, f, g, t, cb, cc, st) := (int_mod(fr, 16) = 8 && tr.implements_stop(f, g, t, cb, cc, st)) || tr.implements_stop_u(f, g, t, cb, cc, st)

// (the claim's run returning a value: an empty one -- its breakpoints and
// the return's)
theorem tr.run_k_okv(zb. bkp): all s m x e. tr.run_k(s, zb. bkp(zb), m, ok(x, e)) -> e = empty
proof
  fix s m x e
  assume h
  obtain r, hk hm from expand(h, tr.run_k)
  // (no pass leaves with the kind ret: a step's raise, a breakpoint's brk)
  have pr: all l r2. tr.rbk(s, zb. bkp(zb), l, r2) -> !is_ok(r2) -> !(fst(r2) = 1 && fst(out_value(r2)) = "ret") proof
    fix l r2
    assume hb nk
    show by simp(expand(hb, tr.rbk, tr.rst, bind_rel), nk, keep(x86_64_linux.step))
  qed
  have p1: tr.rst(pair(m, empty), r) -> !is_ok(r) -> !(fst(r) = 1 && fst(out_value(r)) = "ret") proof
    assume hs nk
    show by simp(expand(hs, tr.rst, bind_rel), nk, keep(x86_64_linux.step))
  qed
  have c1: (ex l1. tr.rst(pair(m, empty), ok(l1, empty)) && tr.rwk(s, zb. bkp(zb), l1, r)) -> !(fst(r) = 1 && fst(out_value(r)) = "ret") proof
    assume e1
    obtain l1, _ rw from e1
    have cs := mp(while_cases[l0 := l1, c := x5. true, b := x5 x6. tr.rbk(s, zb. bkp(zb), x5, x6), tr := x5. fn_update(empty, "os.events", fst(x5).os.events), r := r],
      expand(rw, tr.rwk))
    have k1: (ex l2. (!true && r = ok(l2, empty)) || (true && tr.rbk(s, zb. bkp(zb), l2, r) && !is_ok(r))) -> !(fst(r) = 1 && fst(out_value(r)) = "ret") proof
      assume el
      obtain l2, hl from el
      show := mp(all_elim(pr, {l2}, {r}), (tr.rbk(s, zb. bkp(zb), l2, r) by taut(hl)), (!is_ok(r) by taut(hl)))
    qed
    have k2: (ex t2. r = diverge(t2)) -> !(fst(r) = 1 && fst(out_value(r)) = "ret") proof
      assume ed
      obtain t2, te from ed
      show by simp(te)
    qed
    show by taut(cs, k1, k2)
  qed
  have nr: !(fst(r) = 1 && fst(out_value(r)) = "ret") by taut(expand(hk, tr.rk), c1, p1)
  show by simp(expand(hm, tr.rmap), nr)
qed

theorem tr.callee_sim_s(g, args, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw, zb. bkp, zb pb wb. bka): all s v base code fr m w n hs fd RA T m1 e1 C cb cc st rs rc t.
  tr.hap(s, hs, v) -> tr.ofr(s, fr, v) ->
  tr.inv(s, base, code, fr, m, w) -> tr.cfr(fr) -> tr.mem(s, m, w, v) -> base in omega -> tr.regs(m, rs) -> tr.cs_sub(rc, rs) ->
  tr.args_in(m, args) -> seq_len(args) = n -> n in omega -> int_le(n, 6) -> RA in bits(64) -> T in bits(64) ->
  runs(x86_64_linux.touch_range(bits_sub(64, m.gpr[4], 8), 8, 1), fn_update(m, "rip", RA), ok(m1, e1)) ->
  C = fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, bits_sub(64, m.gpr[4], 8), 8, RA))),
    "gpr", fn_update(m1.gpr, 4, bits_sub(64, m.gpr[4], 8))), "rip", T) ->
  tr.callee_contract_s(fr, T, g, t, cb, cc, st) -> !(T = t) -> (int_mod(fr, 16) = 8 -> tr.sal16(s)) -> abi.loaded(s.vm, cb, cc, st) -> cb in omega ->
  tr.homes(s, m, hs) -> tr.hin(hs, fr) -> fd in omega -> int_le(fd, int_add(fr, 8)) ->
  g in fn_space(abi.ARGS, powerset(univ(1))) -> tr.callee_io(g, n) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) -> (all t0. t0 in univ(1) -> runs(mkprog(x0 x1. ex x8. dd(t0, x8) && k(x8, x1)), w, diverge(t0))) ->
  (all w4 r0 r1. w4 in abi.World && w4 in univ(1) -> r0 in bits(64) -> r1 in bits(64) -> tr.pt(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb) || tr.at_t(zb, pb, wb),
    v, base, code, fr, RA, hs, fd, fn_update(fn_update(rc, 0, pair(8, r0)), 2, pair(8, r1)),
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. a(x0, pair(r0, r1), x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w4)) ->
  (all z. int_lt(z.gpr[4], m.gpr[4]) -> !bkp(z)) ->
  tr.cl(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb) || tr.at_t(zb, pb, wb), v,
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, C)
proof
  fix s v base code fr m w n hs fd RA T m1 e1 C cb cc st rs rc t
  assume hap hofr hi hcf hmm hb hrs hsub hargs hln hno hn6 hra ht htr hC himp htt hal hld hcb hhs hhin hfo hfd hgt hio hk hd hpost hbx
  let S := s.gpr[4]
  let W1 := w
  let P := mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))
  let R := m.gpr[4]
  let regs := tr.aregs(m, n)
  have {sM, mM, wW, wu} := apply(tr.inv_call, hi)
  have {kc} := hi
  have {rb, r16, rlt, rss = rs, sb, slt} := apply(tr.call_rsp, hi, hcf)
  have cM cu co cf cc0 cgs cfl cgpr crip ckc cvf cle cpi cby cstk cacc := apply(tr.push_ok, {s}, {base}, {code}, {fr}, {m}, {w}, {RA}, {T}, {m1}, {e1}, {C}, hi, hcf, hra, ht, htr, hC)
  have cv: C.vm in x86_64_linux.Vm := apply(x86i.parts, cM).4
  have c4: C.gpr[4] = int_sub(R, 8) by simp(cgpr)
  have spc: abi.sp(C) = R by simp(c4, rb, r16, rlt)
  have sp8: abi.sp(s) = int_add(S, 8) by simp(sb, slt)
  have rg1 rg2 rg3 hA _ rlen _ := apply(tr.aregs_ok, {m}, {args}, {n}, mM, hln, hno, hn6, hargs)
  have rg: gc.regs_ok(regs, args) := conj(rg1, rg2, rg3)
  // (C: no stop of the caller's -- below its rsp, not at t)
  have nrC: int_lt(C.gpr[4], abi.sp(s)) by arith(c4, sp8, rss, rb, r16)
  have ltC: int_lt(C.gpr[4], m.gpr[4]) by arith(c4, r16)
  have nbC0 := mp(all_elim(hbx, {C}), ltC)
  have ct: !(C.rip = t) := rewrite(sym(crip), htt)
  have nbC: !(bkp(C) || C.rip = t) by taut(nbC0, ct)
  // GIMPLE's checks failing at the world grown: undefined
  have bad: !gc.sound(W1) -> tr.cl(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb) || tr.at_t(zb, pb, wb), v, P, w, C) proof
    assume hn
    have all: all x e. x in univ(1) -> e in univ(1) -> runs(gimple.call(g, args), w, exc(x, e)) proof
      fix x e
      assume hx he
      show := apply(gc.call_ub, {g}, {args}, {w}, {regs}, {x}, {e}, wu, hx, he, rg, hn)
    qed
    have ub := apply(tr.gcall_ub[g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {s}, {v}, {w}, wW, wu, all, hk)
    have su := apply(tr.sim_ub[bkp := zb. bkp(zb) || zb.rip = t, bka := zb pb wb. bka(zb, pb, wb) || tr.at_t(zb, pb, wb)], {s}, {v}, {P}, {w}, {C}, ub)
    show := apply(tr.sim_cl[bkp := zb. bkp(zb) || zb.rip = t, bka := zb pb wb. bka(zb, pb, wb) || tr.at_t(zb, pb, wb)], {s}, {v}, {P}, {w}, {C}, nrC, nbC, su)
  qed
  // ... holding: the callee's entry, its contract
  have good: gc.sound(W1) -> tr.cl(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb) || tr.at_t(zb, pb, wb), v, P, w, C) proof
    assume hs
    have eoku eok vok ook veq wvv dso := apply(tr.callee_ready, {s}, {base}, {code}, {fr}, {m}, {w}, {v}, {RA}, {T}, {m1}, {e1}, {C}, {n}, hofr, hi, hcf, hmm, hra, ht, hno, hn6, htr, hC, hs)
    have l1 := mp(all_elim(expand(kc, tr.keeps_code), {cb}, {cc}, {st}), hcb, hld)
    have lC := mp(all_elim(expand(ckc, tr.keeps_code), {cb}, {cc}, {st}), hcb, l1)
    let WV := W1.vm
    have ctr: all oc. tr.run_s(C, t, C, oc) -> tr.matches_ts(g, regs, v, WV, C, oc) proof
      fix oc
      assume hrd
      have a8: (int_mod(fr, 16) = 8 && tr.implements_stop(T, g, t, cb, cc, st)) -> tr.matches_ts(g, regs, v, WV, C, oc) proof
        assume h8
        show := mp(all_elim(expand(h8.2, tr.implements_stop), {regs}, {v}, {WV}, {C}, {oc}), hA, dso, wvv, cM, cu, lC, crip, mp(eok, h8.1, mp(hal, h8.1)), ook, vok, hrd)
      qed
      have au: tr.implements_stop_u(T, g, t, cb, cc, st) -> tr.matches_ts(g, regs, v, WV, C, oc) proof
        assume hu0
        show := mp(all_elim(expand(hu0, tr.implements_stop_u), {regs}, {v}, {WV}, {C}, {oc}), hA, dso, wvv, cM, cu, lC, crip, eoku, ook, vok, hrd)
      qed
      show by taut(expand(himp, tr.callee_contract_s), a8, au)
    qed
    // (W1: a world)
    have ou := apply(abi.objs_univ, dso)
    have wvu := apply(x86.vm_univ, wvv)
    have ocu := mp(all_elim(abi.objs_at_univ, {v}, {C.fs_base}), ou)
    have vu: abi.view(C, v, WV) in univ(1) by simp(cu, ou, wvu, ocu)
    have vW := apply(abi.world_typed, cM, dso, wvv, vu)
    have w1W: W1 in abi.World := rewrite(veq, vW)
    have w1u: W1 in univ(1) := wu
    // the callee raising: the caller raises so (undefined, or at main)
    have rex: all x e. e in univ(1) -> runs(g[regs], abi.view(C, v, WV), exc(x, e)) -> runs(P, w, exc(x, e)) proof
      fix x e
      assume eu rr
      have rr2 := rewrite(veq, rr)
      have pu := apply(tr.spec_univ, {g}, {regs}, {W1}, {exc(x, e)}, hgt, hA, rr2)
      have xu: x in univ(1) by simp(pu)
      show := apply(tr.gcall_exc[g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {regs}, {x}, {e}, wu, xu, eu, rg, hs, rr2, hk)
    qed
    have rub: abi.raises_at(g, regs, v, WV, C) -> tr.ub(s, v, P, w) proof
      assume hr
      obtain e x, eu eno ena rst rr from expand(hr, abi.raises_at)
      have pe := mp(all_elim(rex, {x}, {e}), eu, rr)
      show by defs(ex_intro({e}, {x}, taut(eu, eno, ena, rst, pe)), tr.ub)
    qed
    // the callee returned to x: the caller's claim reaching x (or the call
    // undefined)
    have rcl: all x. tr.run_s(C, t, C, ok(x, empty)) -> tr.ub(s, v, P, w) ||
        tr.cl(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb) || tr.at_t(zb, pb, wb), v, P, w, x) proof
      fix x
      assume hrx
      have mt2 := expand(mp(all_elim(ctr, {ok(x, empty)}), hrx), tr.matches_ts)
      have n2: tr.crashes_t(g, regs, v, WV, C, ok(x, empty)) -> false proof
        assume ca
        obtain m2 a0 k0, {oe} from expand(ca, tr.crashes_t)
        show by simp(oe)
      qed
      have n5: tr.stop_t(g, regs, v, WV, C, ok(x, empty)) -> false proof
        assume sa
        obtain m2 w3 v3 mem3, oe _ _ _ _ from expand(sa, tr.stop_t)
        show by simp(oe, tr.stop_ne)
      qed
      have u1: abi.raises_at(g, regs, v, WV, C) -> tr.ub(s, v, P, w) ||
          tr.cl(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb) || tr.at_t(zb, pb, wb), v, P, w, x) proof
        assume ra
        have ub := mp(rub, ra)
        show by taut(ub)
      qed
      have u2: (ex m1 w2. ok(x, empty) = ok(m1, empty) && m1 in x86_64_linux.Machine && m1 in univ(1) &&
          runs(g[regs], abi.view(C, v, WV), ok(w2, pair(m1.gpr[0], m1.gpr[2]))) && w2 in abi.World && w2 in univ(1) &&
          abi.world_matches(C.vm, m1.vm, w2.vm, abi.wob(v, w2.objs.c_bytes), C.fs_base, abi.sp(C)) && m1.os = w2.os && m1.fs_base = C.fs_base &&
          m1.cpu = C.cpu && m1.gs_base = C.gs_base && m1.rip = abi.ret(C) && m1.gpr[4] = abi.sp(C) &&
          abi.callee_saved(m1, C) && !m1.flags.df) -> tr.ub(s, v, P, w) ||
          tr.cl(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb) || tr.at_t(zb, pb, wb), v, P, w, x) proof
        assume eo
        obtain m2 w2, eo2 from eo
        have xm: x = m2 by simp(eo2.1)
        let r0 := x.gpr[0]
        let r1 := x.gpr[2]
        have _ xM xu hg0 w2W w2u wm0 xos xfs xcpu xgs xrip0 xr4 xcs xdf := rewrite(sym(xm), eo2)
        have hg8 := rewrite(veq, hg0)
        have r0R: 0 in x86_64_linux.Reg by simp()
        have r2R: 2 in x86_64_linux.Reg by simp()
        have r0b := mp(mp(all_elim(x86i.reg_typed, {x}, {0}), xM), r0R)
        have r1b := mp(mp(all_elim(x86i.reg_typed, {x}, {2}), xM), r2R)
        have r0u: r0 in univ(1) by simp(r0b)
        have r1u: r1 in univ(1) by simp(r1b)
        // the callee's spec: a valid world on its return, or undefined there (so is this call)
        have ci := mp(all_elim(expand(hio, tr.callee_io), {regs}, {W1}, {w2}, {pair(r0, r1)}),
          (ord_le(n, seq_len(regs)) by defs(simp(rlen), ord_le)), hg8)
        have mr: tr.may_raise(g, regs, W1) -> tr.ub(s, v, P, w) ||
            tr.cl(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb) || tr.at_t(zb, pb, wb), v, P, w, x) proof
          assume hm
          have eu: empty in univ(1) by simp()
          have hx: all x e. x in univ(1) -> e in univ(1) -> runs(g[regs], W1, exc(x, e)) by taut(expand(expand(hm, tr.may_raise), tr.undef))
          have pe := mp(all_elim(hx, {W1}, {empty}), w1u, eu)
          have eno := tr.undef_empty
          have rst: abi.raise_state(W1) by defs(apply(tr.world_and, w1W), abi.raise_state)
          have pe2 := subst({y. runs(g[regs], y, exc(W1, empty))}, sym(veq), pe)
          have ra: abi.raises_at(g, regs, v, WV, C) by defs(ex_intro({empty}, {W1}, taut(eu, eno, rst, pe2)), abi.raises_at)
          show := mp(u1, ra)
        qed
        // the caller goes on at the return address with the result
        have fk: tr.returns_valid(W1, w2) -> tr.ub(s, v, P, w) ||
            tr.cl(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb) || tr.at_t(zb, pb, wb), v, P, w, x) proof
          assume rv
          have xv: x.vm in x86_64_linux.Vm := apply(x86i.parts, xM).4
          have pinv pmem phom pfr preg prip := apply(tr.post_call, {s}, {base}, {code}, {fr}, {m}, {w}, {v}, {RA}, {T}, {m1}, {e1}, {C}, {x}, {w2}, {hs}, {fd}, {rs}, {rc},
            hi, hcf, hmm, hb, hra, ht, htr, hC, rv, xM, xu, w2W, w2u, wm0, xos, xfs, xcpu, xgs, xrip0, xr4, xcs, xdf, hhs, hap, hofr, hhin, hfo, hfd, hrs, hsub)
          let W4 := gc.back(w2, W1)
          have _ pk := apply(tr.gcall_ret[g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {regs}, {w2}, {r0}, {r1}, wu, w2u, r0u, r1u, rg, hs, hg8, hk)
          have red: tr.red(P, w, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. a(x0, pair(r0, r1), x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), W4) by defs(pk, tr.red)
          have {w4W = wW, w4u = wu} := pinv
          have ptk := mp(all_elim(hpost, {W4}, {r0}, {r1}), taut(w4W, w4u), r0b, r1b)
          have sm := mp(all_elim(expand(ptk, tr.pt), {x}), pinv, prip, phom, preg, pmem, pfr)
          have sm2 := apply(tr.cl_red[bkp := zb. bkp(zb) || zb.rip = t, bka := zb pb wb. bka(zb, pb, wb) || tr.at_t(zb, pb, wb)], {s}, {v}, {P}, {w},
            {mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. a(x0, pair(r0, r1), x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))}, {W4}, {x}, red, sm)
          show by taut(sm2)
        qed
        show by taut(fk, ci, mr)
      qed
      have n3 := all_elim(tr.div_ok, {g[regs]}, {abi.view(C, v, WV)}, {x}, {empty})
      show by taut(mt2, n2, n3, n5, u1, u2)
    qed
    // the caller's run from C
    have spl: int_le(abi.sp(C), abi.sp(s)) by arith(spc, sp8, rss)
    have cl0: int_lt(C.gpr[4], abi.sp(C)) by arith(c4, spc, r16)
    have hbc: all z. int_lt(z.gpr[4], abi.sp(C)) -> !bkp(z) proof
      fix z
      assume lt
      show := mp(all_elim(hbx, {z}), rewrite(spc, lt))
    qed
    have g0: all o. tr.run_k(s, zb. bkp(zb) || zb.rip = t, C, o) ->
        tr.gk(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb) || tr.at_t(zb, pb, wb), v, P, w, o) proof
      fix o
      assume hr
      let GK(o2) := tr.gk(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb) || tr.at_t(zb, pb, wb), v, P, w, o2)
      have rs := apply(tr.run_split_ks[bkp := zb. bkp(zb)], {s}, {C}, {t}, {o}, sM, spl, cl0, ct, hbc, hr)
      have ub2: tr.ub(s, v, P, w) -> GK(o) proof
        assume u
        show by defs(taut(u), tr.gk)
      qed
      // (a return reached at x: the caller's run stops there, or goes on)
      have atx: all x. tr.run_s(C, t, C, ok(x, empty)) -> o = ok(x, empty) -> GK(o) proof
        fix x
        assume hrx oe
        have c := mp(all_elim(rcl, {x}), hrx)
        have k2: tr.cl(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb) || tr.at_t(zb, pb, wb), v, P, w, x) -> GK(o) proof
          assume hc
          have st := apply(tr.run_k_stop[bkp := zb. bkp(zb) || zb.rip = t], {s}, {C}, {x}, {empty}, rewrite(oe, hr))
          have ar := mp(expand(hc, tr.cl).1, st)
          have e2: ex m3. o = ok(m3, empty) && tr.arr(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb) || tr.at_t(zb, pb, wb), v, m3, P, w)
            by ex_intro({x}, taut(oe, ar))
          show by defs(taut(e2), tr.gk)
        qed
        show by taut(c, ub2, k2)
      qed
      // (1) the caller's run is the callee's
      have b1: (ex o1. tr.run_s(C, t, C, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2))) -> GK(o) proof
        assume e
        obtain o1, hrc eo from e
        have mt2 := expand(mp(all_elim(ctr, {o1}), hrc), tr.matches_ts)
        have u1: abi.raises_at(g, regs, v, WV, C) -> GK(o) proof
          assume ra
          show := mp(ub2, mp(rub, ra))
        qed
        have u2: tr.crashes_t(g, regs, v, WV, C, o1) -> GK(o) proof
          assume ca
          have cr := apply(tr.callee_crash[g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {s}, {base}, {code}, {fr}, {m}, {w}, {v}, {regs}, {C}, {o1}, hi, hcf, hmm, co, c4, rg, hs, hgt, hA, veq, hk, hd, ca)
          obtain m2 a0 k0, {oe} from expand(cr, tr.crash)
          have nd: !(fst(o1) = 2) by simp(oe)
          have oe1: o1 = o by taut(eo, nd)
          have cr2 := rewrite(oe1, cr)
          show by defs(taut(cr2), tr.gk)
        qed
        have u3: (ex m1 w2. o1 = ok(m1, empty) && m1 in x86_64_linux.Machine && m1 in univ(1) &&
            runs(g[regs], abi.view(C, v, WV), ok(w2, pair(m1.gpr[0], m1.gpr[2]))) && w2 in abi.World && w2 in univ(1) &&
            abi.world_matches(C.vm, m1.vm, w2.vm, abi.wob(v, w2.objs.c_bytes), C.fs_base, abi.sp(C)) && m1.os = w2.os && m1.fs_base = C.fs_base &&
            m1.cpu = C.cpu && m1.gs_base = C.gs_base && m1.rip = abi.ret(C) && m1.gpr[4] = abi.sp(C) &&
            abi.callee_saved(m1, C) && !m1.flags.df) -> GK(o) proof
          assume eo2
          obtain m2 w2, eo3 from eo2
          have nd: !(fst(o1) = 2) by simp(eo3.1)
          have oe1: o1 = o by taut(eo, nd)
          have oe: o = ok(m2, empty) := trans(sym(oe1), eo3.1)
          have hrx := rewrite(eo3.1, hrc)
          show := mp(all_elim(atx, {m2}), hrx, oe)
        qed
        // (the callee diverging: so does the caller's spec)
        have u4: tr.div(g[regs], abi.view(C, v, WV), o1) -> GK(o) proof
          assume dv
          have dv1 dv2 := expand(dv, tr.div)
          obtain t2, rd from dv2
          obtain t3, te from dv1
          have f1: fst(o1) = 2 by simp(te)
          have f0a: o1 = o -> fst(o) = 2 proof
            assume e5
            show := rewrite(e5, f1)
          qed
          have f0: fst(o) = 2 by taut(eo, f0a)
          obtain r0, _ rm0 from expand(hr, tr.run_k)
          have od := apply(tr.rmap_div, {r0}, {o}, rm0, f0)
          have rd2 := rewrite(veq, rd)
          have pu := apply(tr.spec_univ, {g}, {regs}, {W1}, {diverge(t2)}, hgt, hA, rd2)
          have t2u: t2 in univ(1) by simp(pu)
          have pd := apply(tr.gcall_div[g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {regs}, {t2}, wu, t2u, rg, hs, rd2, hd)
          have e2: ex t4. runs(P, w, diverge(t4)) by ex_intro({t2}, pd)
          have e3: ex t5. o = diverge(t5) by ex_intro({snd(r0)}, od)
          have d: tr.div(P, w, o) by defs(taut(e3, e2), tr.div)
          show by defs(taut(d), tr.gk)
        qed
        // (the callee stopping: not the caller's run -- its outcomes' values
        // empty)
        have u5: tr.stop_t(g, regs, v, WV, C, o1) -> GK(o) proof
          assume sa
          obtain m2 w3 v3 mem3, oe _ _ _ _ from expand(sa, tr.stop_t)
          have nd: !(fst(o1) = 2) by simp(oe)
          have oe1: o1 = o by taut(eo, nd)
          have ev := apply(tr.run_k_okv[bkp := zb. bkp(zb) || zb.rip = t], {s}, {C}, {m2}, {exc_val("stop", empty)}, rewrite(trans(sym(oe1), oe), hr))
          have f: false by taut(ev, tr.stop_ne)
          show by taut(f)
        qed
        show by taut(mt2, u1, u2, u3, u4, u5)
      qed
      // (2) the callee returned to x, the caller's run on from x
      have b2: (ex x r1 o1. tr.run_s(C, t, C, ok(x, empty)) && tr.rwk(s, zb. bkp(zb) || zb.rip = t, pair(x, empty), r1) && tr.rmap(r1, o1) &&
          (o1 = o || (fst(o1) = 2 && fst(o) = 2))) -> GK(o) proof
        assume e
        obtain x r1 o1, hrx hw1 hm1 eo from e
        have c := mp(all_elim(rcl, {x}), hrx)
        have k2: tr.cl(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb) || tr.at_t(zb, pb, wb), v, P, w, x) -> GK(o) proof
          assume hc
          have g1 := apply(tr.cl_rwk[bkp := zb. bkp(zb) || zb.rip = t, bka := zb pb wb. bka(zb, pb, wb) || tr.at_t(zb, pb, wb)], {s}, {v}, {P}, {w}, {x}, {r1}, {o1}, hc, hw1, hm1)
          have same: o1 = o -> GK(o) proof
            assume e5
            show := rewrite(e5, g1)
          qed
          have divs: (fst(o1) = 2 && fst(o) = 2) -> GK(o) proof
            assume dd2
            have od1 := apply(tr.rmap_div, {r1}, {o1}, hm1, dd2.1)
            obtain r0, _ rm0 from expand(hr, tr.run_k)
            have od := apply(tr.rmap_div, {r0}, {o}, rm0, dd2.2)
            have g2 := apply(tr.gk_div[bkp := zb. bkp(zb) || zb.rip = t, bka := zb pb wb. bka(zb, pb, wb) || tr.at_t(zb, pb, wb)], {s}, {v}, {P}, {w}, {snd(r1)}, {snd(r0)}, rewrite(od1, g1))
            show := rewrite(sym(od), g2)
          qed
          show by taut(eo, same, divs)
        qed
        show by taut(c, ub2, k2)
      qed
      // (3) the callee leaving its discipline: its contract has it raise
      have b3: (ex x. tr.run_s(C, t, C, exc(x, exc_val("disc", empty)))) -> GK(o) proof
        assume ed
        obtain x, hx from ed
        have mt2 := expand(mp(all_elim(ctr, {exc(x, exc_val("disc", empty))}), hx), tr.matches_ts)
        have n1: (ex m1 w2. exc(x, exc_val("disc", empty)) = ok(m1, empty) && m1 in x86_64_linux.Machine && m1 in univ(1) &&
            runs(g[regs], abi.view(C, v, WV), ok(w2, pair(m1.gpr[0], m1.gpr[2]))) && w2 in abi.World && w2 in univ(1) &&
            abi.world_matches(C.vm, m1.vm, w2.vm, abi.wob(v, w2.objs.c_bytes), C.fs_base, abi.sp(C)) && m1.os = w2.os && m1.fs_base = C.fs_base &&
            m1.cpu = C.cpu && m1.gs_base = C.gs_base && m1.rip = abi.ret(C) && m1.gpr[4] = abi.sp(C) &&
            abi.callee_saved(m1, C) && !m1.flags.df) -> false proof
          assume eo
          obtain m2 w2, eo2 from eo
          show by simp(eo2.1)
        qed
        have n2: tr.crashes_t(g, regs, v, WV, C, exc(x, exc_val("disc", empty))) -> false proof
          assume ca
          obtain m2 a0 k0, {oe} from expand(ca, tr.crashes_t)
          show by simp(expand(oe, exc_val))
        qed
        have n3 := all_elim(tr.div_exc, {g[regs]}, {abi.view(C, v, WV)}, {x}, {exc_val("disc", empty)})
        have n4: tr.stop_t(g, regs, v, WV, C, exc(x, exc_val("disc", empty))) -> false proof
          assume sa
          obtain m2 w3 v3 mem3, oe _ _ _ _ from expand(sa, tr.stop_t)
          show by simp(oe)
        qed
        have r3: abi.raises_at(g, regs, v, WV, C) by taut(mt2, n1, n2, n3, n4)
        show := mp(ub2, mp(rub, r3))
      qed
      // (4) the callee stopping at x (at t): the caller's run stops there,
      // the call raising at main in a view of x (its contract's stop)
      have b4: (ex x. tr.run_s(C, t, C, ok(x, exc_val("stop", empty))) && o = ok(x, empty) && tr.at_stop(C, t, x)) -> GK(o) proof
        assume e
        obtain x, hx oe xs from e
        have mt2 := expand(mp(all_elim(ctr, {ok(x, exc_val("stop", empty))}), hx), tr.matches_ts)
        have xt _ xlt := xs
        have u1: abi.raises_at(g, regs, v, WV, C) -> GK(o) proof
          assume ra
          show := mp(ub2, mp(rub, ra))
        qed
        have n1: (ex m1 w2. ok(x, exc_val("stop", empty)) = ok(m1, empty) && m1 in x86_64_linux.Machine && m1 in univ(1) &&
            runs(g[regs], abi.view(C, v, WV), ok(w2, pair(m1.gpr[0], m1.gpr[2]))) && w2 in abi.World && w2 in univ(1) &&
            abi.world_matches(C.vm, m1.vm, w2.vm, abi.wob(v, w2.objs.c_bytes), C.fs_base, abi.sp(C)) && m1.os = w2.os && m1.fs_base = C.fs_base &&
            m1.cpu = C.cpu && m1.gs_base = C.gs_base && m1.rip = abi.ret(C) && m1.gpr[4] = abi.sp(C) &&
            abi.callee_saved(m1, C) && !m1.flags.df) -> false proof
          assume eo
          obtain m2 w2, eo2 from eo
          show by simp(eo2.1, tr.stop_ne)
        qed
        have n2: tr.crashes_t(g, regs, v, WV, C, ok(x, exc_val("stop", empty))) -> false proof
          assume ca
          obtain m2 a0 k0, {oe2 = oe} from expand(ca, tr.crashes_t)
          show by simp(oe2)
        qed
        have n3 := all_elim(tr.div_ok, {g[regs]}, {abi.view(C, v, WV)}, {x}, {exc_val("stop", empty)})
        have u5: tr.stop_t(g, regs, v, WV, C, ok(x, exc_val("stop", empty))) -> GK(o) proof
          assume sa
          obtain m2 w3 v3 mem3, oe2 rs3 ru3 we3 vo3 from expand(sa, tr.stop_t)
          have mx: m2 = x by simp(oe2)
          // (the call raising at main, in the world the callee raised in)
          have eu: exc_val("at_main", empty) in univ(1) by defs(simp(), exc_val)
          have pe := mp(all_elim(rex, {w3}, {exc_val("at_main", empty)}), eu, ru3)
          have at1: ex w2 v2 mem2. abi.raise_state(w2) && runs(P, w, exc(w2, exc_val("at_main", empty))) && w2 = abi.view(x, v2, mem2) && abi.view_ok(x, v2, mem2)
            by ex_intro({w3}, {v3}, {mem3}, taut(rs3, pe, rewrite(mx, we3), rewrite(mx, vo3)))
          have at: tr.at_t(x, P, w) by defs(taut(at1), tr.at_t)
          have rd: tr.red(P, w, P, w) proof
            have g: all o3. runs(P, w, o3) -> runs(P, w, o3) proof
              fix o3
              assume r3
              show := r3
            qed
            show by defs(g, tr.red)
          qed
          // (x below C's sp, so below s's: no return of the caller's)
          have no: !tr.out(s, x) by arith(xlt, spl)
          have ea: ex p2 w2. tr.red(P, w, p2, w2) && (bka(x, p2, w2) || tr.at_t(x, p2, w2)) by ex_intro({P}, {w}, taut(rd, at))
          have ar: tr.arr(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb) || tr.at_t(zb, pb, wb), v, x, P, w)
            by defs(taut(no, ea), tr.arr)
          have e2: ex m3. o = ok(m3, empty) && tr.arr(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb) || tr.at_t(zb, pb, wb), v, m3, P, w)
            by ex_intro({x}, taut(oe, ar))
          show by defs(taut(e2), tr.gk)
        qed
        show by taut(mt2, u1, n1, n2, n3, u5)
      qed
      show by taut(rs, b1, b2, b3, b4)
    qed
    have sm: tr.sim(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb) || tr.at_t(zb, pb, wb), v, P, w, C) by defs(g0, tr.sim)
    show := apply(tr.sim_cl[bkp := zb. bkp(zb) || zb.rip = t, bka := zb pb wb. bka(zb, pb, wb) || tr.at_t(zb, pb, wb)], {s}, {v}, {P}, {w}, {C}, nrC, nbC, sm)
  qed
  show by taut(bad, good)
qed

// A spec main's call has (no contract for main): raising at main in the
// world it is called in, or undefined there (main's precondition failing)
def tr.raises_main(g) := all args w. w in abi.World -> w in univ(1) ->
  runs(g[args], w, exc(w, exc_val("at_main", empty))) || tr.may_raise(g, args, w)

// The call of main itself (T = t): the caller's run stops at the callee's
// entry, the call there raising at main (tr.at_t at C)
theorem tr.call_main(g, args, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw, zb. bkp, zb pb wb. bka): all s v base code fr m w n RA T m1 e1 C t.
  tr.ofr(s, fr, v) -> tr.inv(s, base, code, fr, m, w) -> tr.cfr(fr) -> tr.mem(s, m, w, v) ->
  tr.args_in(m, args) -> seq_len(args) = n -> n in omega -> int_le(n, 6) -> RA in bits(64) -> T in bits(64) ->
  runs(x86_64_linux.touch_range(bits_sub(64, m.gpr[4], 8), 8, 1), fn_update(m, "rip", RA), ok(m1, e1)) ->
  C = fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, bits_sub(64, m.gpr[4], 8), 8, RA))),
    "gpr", fn_update(m1.gpr, 4, bits_sub(64, m.gpr[4], 8))), "rip", T) ->
  T = t -> tr.raises_main(g) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) ->
  tr.cl(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb) || tr.at_t(zb, pb, wb), v,
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, C)
proof
  fix s v base code fr m w n RA T m1 e1 C t
  assume hofr hi hcf hmm hargs hln hno hn6 hra ht htr hC htt hrm hk
  let P := mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))
  let R := m.gpr[4]
  let S := s.gpr[4]
  let regs := tr.aregs(m, n)
  have {sM, mM, wW, wu} := apply(tr.inv_call, hi)
  have {rb, r16, rlt, rss = rs, sb, slt} := apply(tr.call_rsp, hi, hcf)
  have cM cu co cf cc0 cgs cfl cgpr crip ckc cvf cle cpi cby cstk cacc := apply(tr.push_ok, {s}, {base}, {code}, {fr}, {m}, {w}, {RA}, {T}, {m1}, {e1}, {C}, hi, hcf, hra, ht, htr, hC)
  have c4: C.gpr[4] = int_sub(R, 8) by simp(cgpr)
  have sp8: abi.sp(s) = int_add(S, 8) by simp(sb, slt)
  have rg1 rg2 rg3 _ _ _ _ := apply(tr.aregs_ok, {m}, {args}, {n}, mM, hln, hno, hn6, hargs)
  have rg: gc.regs_ok(regs, args) := conj(rg1, rg2, rg3)
  have no: !tr.out(s, C) by arith(c4, sp8, rss, rb, r16)
  have ct: C.rip = t := trans(crip, htt)
  have rst: abi.raise_state(w) by defs(apply(tr.world_and, wW), abi.raise_state)
  have eu: empty in univ(1) by simp()
  // (the call undefined: so is the stop)
  have ubt: tr.ub(s, v, P, w) -> tr.at_t(C, P, w) proof
    assume u
    have u2 := expand(u, tr.ub)
    show by defs(taut(u2), tr.at_t)
  qed
  have ue: runs(P, w, exc(w, empty)) -> tr.at_t(C, P, w) proof
    assume pe
    have u: tr.ub(s, v, P, w) by defs(ex_intro({empty}, {w}, taut(eu, tr.undef_empty, rst, pe)), tr.ub)
    show := mp(ubt, u)
  qed
  have bad: !gc.sound(w) -> tr.at_t(C, P, w) proof
    assume hn
    have all: all x e. x in univ(1) -> e in univ(1) -> runs(gimple.call(g, args), w, exc(x, e)) proof
      fix x e
      assume hx he
      show := apply(gc.call_ub, {g}, {args}, {w}, {regs}, {x}, {e}, wu, hx, he, rg, hn)
    qed
    have ub := apply(tr.gcall_ub[g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {s}, {v}, {w}, wW, wu, all, hk)
    show := mp(ubt, ub)
  qed
  // (the call raising at main in w, a view of C)
  have good: gc.sound(w) -> tr.at_t(C, P, w) proof
    assume hs
    have _ _ vok _ veq _ _ := apply(tr.callee_ready, {s}, {base}, {code}, {fr}, {m}, {w}, {v}, {RA}, {T}, {m1}, {e1}, {C}, {n}, hofr, hi, hcf, hmm, hra, ht, hno, hn6, htr, hC, hs)
    have hg := mp(all_elim(expand(hrm, tr.raises_main), {regs}, {w}), wW, wu)
    have am: runs(g[regs], w, exc(w, exc_val("at_main", empty))) -> tr.at_t(C, P, w) proof
      assume rr
      have au: exc_val("at_main", empty) in univ(1) by defs(simp(), exc_val)
      have pe := apply(tr.gcall_exc[g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {regs}, {w}, {exc_val("at_main", empty)}, wu, wu, au, rg, hs, rr, hk)
      have e1: ex w2 v2 mem2. abi.raise_state(w2) && runs(P, w, exc(w2, exc_val("at_main", empty))) && w2 = abi.view(C, v2, mem2) && abi.view_ok(C, v2, mem2)
        by ex_intro({w}, {v}, {w.vm}, taut(rst, pe, sym(veq), vok))
      show by defs(taut(e1), tr.at_t)
    qed
    have mr: tr.may_raise(g, regs, w) -> tr.at_t(C, P, w) proof
      assume hm
      have hx: all x e. x in univ(1) -> e in univ(1) -> runs(g[regs], w, exc(x, e)) by taut(expand(expand(hm, tr.may_raise), tr.undef))
      have rr := mp(all_elim(hx, {w}, {empty}), wu, eu)
      have pe := apply(tr.gcall_exc[g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {regs}, {w}, {empty}, wu, wu, eu, rg, hs, rr, hk)
      show := mp(ue, pe)
    qed
    show by taut(hg, am, mr)
  qed
  have rd: tr.red(P, w, P, w) proof
    have g0: all o3. runs(P, w, o3) -> runs(P, w, o3) proof
      fix o3
      assume r3
      show := r3
    qed
    show by defs(g0, tr.red)
  qed
  have ea: ex p2 w2. tr.red(P, w, p2, w2) && (bka(C, p2, w2) || tr.at_t(C, p2, w2)) by ex_intro({P}, {w}, taut(rd, bad, good))
  have ar: tr.arr(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb) || tr.at_t(zb, pb, wb), v, C, P, w) by defs(taut(no, ea), tr.arr)
  have sk: tr.stopk(s, zb. bkp(zb) || zb.rip = t, C) by defs(taut(ct), tr.stopk)
  show by defs(taut(sk, ar), tr.cl)
qed
