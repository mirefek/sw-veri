  assume hmn hap hofr hat ha2 hoff hb hf himp hft hal hld hcb hcf hln hno hn6 hgt hio hreg hsub hhin hfo hfd hk hd hpost hbt hbf hat2
  have hcv := hmn
  have r := mp(tr.call1_stm[b := false, s := s, v := v, base := base, code := code, fr := fr, a := a, a2 := a2, len := len, off := off, f := f, g := g, args := args, n := n, cb := cb, cc := cc, st := st,
    hs := hs, ds := ds, fd2 := fd2, rs := rs, rc := rc, w := w, t := t, ks := ks, ka := x9 x10 x8. ka(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2),
    bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], hcv, hap, hofr, hat, ha2, hoff, hb, hf, himp, hft, hal, hld, hcb, hcf, hln, hno, hn6, hgt, hio, hreg, hsub, hhin, hfo, hfd, hk, hd, hpost, hbt, hbf, hat2)
  show := rewrite(mp(ite_f[c := false, a := gimple.call1(g, args), b := gimple.call1_0(g, args)], (!false by taut())), r)
qed

theorem tr.calli1_0_st(s, v, base, code, fr, a, a2, len, gr, z, nb, T, fptr, args, n, cb, cc, st, hs, ds, fd2, rs, rc, w, t, x9 x10 x8. ka, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw, zb. bkp, zb pb wb. bka):
  v.c_bytes = tr.cbm(false, s.fs_base) -> tr.hap(s, hs, v) -> tr.ofr(s, fr, v) ->
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a -> runs(x86_64_linux.exec_body(len, tag(121, pair(tag(0, gr), z))), m, o)) ->
  a2 = bits_add(64, a, bits_of_int(64, len)) -> gr in x86_64_linux.Reg -> gr in dom(rs) -> rs[gr] = pair(nb, T) -> T in bits(64) -> base in omega ->
  tr.code_okm(false, fptr, n, fr, t, cb, cc, st) -> (int_mod(fr, 16) = 8 -> tr.sal16(s)) -> abi.loaded(s.vm, cb, cc, st) -> cb in omega ->
  tr.cfr(fr) -> seq_len(args) = n -> n in omega -> int_le(n, 6) ->
  fptr in fn_space(bits(64), fn_space(abi.ARGS, powerset(univ(1)))) ->
  (all m. tr.regs(m, rs) -> tr.args_in(m, args)) -> tr.cs_sub(rc, rs) -> tr.hin(hs, fr) -> fd2 in omega -> int_le(fd2, int_add(fr, 8)) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) ->
  (all t0. t0 in univ(1) -> runs(mkprog(x0 x1. ex x8. dd(t0, x8) && k(x8, x1)), w, diverge(t0))) ->
  (all w4 r0. w4 in abi.World && w4 in univ(1) -> r0 in bits(64) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, fd2, fn_update(rc, 0, pair(8, r0)),
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. ka(x0, r0, x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w4)) ->
  (all z. z.rip = t -> bkp(z)) -> (all z. int_lt(z.gpr[4], int_sub(s.gpr[4], fr)) -> bkp(z) -> z.rip = t) -> (all z p2 w2. z.rip = t -> tr.at_tm(false, z, p2, w2) -> bka(z, p2, w2)) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1_0(fptr[T], args), x0, x9 x10. ka(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w)
proof
  assume hmn hap hofr hat ha2 hg hgd hgu htb hb hcode hal hld hcb hcf hln hno hn6 hft hreg hsub hhin hfo hfd hk hd hpost hbt hbf hat2
  have hcv := hmn
  have r := mp(tr.calli1_stm[b := false, s := s, v := v, base := base, code := code, fr := fr, a := a, a2 := a2, len := len, gr := gr, z := z, nb := nb, T := T, fptr := fptr, args := args, n := n, cb := cb, cc := cc, st := st,
    hs := hs, ds := ds, fd2 := fd2, rs := rs, rc := rc, w := w, t := t, ka := x9 x10 x8. ka(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2),
    bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], hcv, hap, hofr, hat, ha2, hg, hgd, hgu, htb, hb, hcode, hal, hld, hcb, hcf, hln, hno, hn6, hft, hreg, hsub, hhin, hfo, hfd, hk, hd, hpost, hbt, hbf, hat2)
  show := rewrite(mp(ite_f[c := false, a := gimple.call1(fptr[T], args), b := gimple.call1_0(fptr[T], args)], (!false by taut())), r)
qed

// (the relation at a stop: the stop mode's own, k && tr.at_t; a callee never
// stopping, none needed)
theorem tr.hat_top(t): true -> (all z p2 w2. z.rip = t -> tr.at_t(z, p2, w2) -> true && tr.at_t(z, p2, w2))
proof
  assume _
  fix z p2 w2
  assume _ h
  show by taut(h)
qed

theorem tr.hat_none(zb pb wb. bka, t): false -> (all z p2 w2. z.rip = t -> tr.at_t(z, p2, w2) -> bka(z, p2, w2))
proof
  assume f
  show by taut(f)
qed

// (in a loop's walk: its relation's stop case, the outer one -- t's
// states the outer breakpoints)
theorem tr.hat_cut(z p w. l, z. bkp, z p w. bka, t): (true -> (all z p2 w2. z.rip = t -> tr.at_t(z, p2, w2) -> bka(z, p2, w2))) ->
  (all z. z.rip = t -> bkp(z)) ->
  true -> (all z p2 w2. z.rip = t -> tr.at_t(z, p2, w2) -> l(z, p2, w2) || (bkp(z) && bka(z, p2, w2)))
proof
  assume h hb _
  fix z p2 w2
  assume e a
  show by taut(mp(all_elim(mp(h, taut()), {z}, {p2}, {w2}), e, a), mp(all_elim(hb, {z}), e))
qed

// (... in the mode b)
theorem tr.hat_topm(b, t): true -> (all z p2 w2. z.rip = t -> tr.at_tm(b, z, p2, w2) -> true && tr.at_tm(b, z, p2, w2))
proof
  assume _
  fix z p2 w2
  assume _ h
  show by taut(h)
qed

theorem tr.hat_nonem(zb pb wb. bka, b, t): false -> (all z p2 w2. z.rip = t -> tr.at_tm(b, z, p2, w2) -> bka(z, p2, w2))
proof
  assume f
  show by taut(f)
qed

theorem tr.hat_cutm(z p w. l, z. bkp, z p w. bka, b, t): (true -> (all z p2 w2. z.rip = t -> tr.at_tm(b, z, p2, w2) -> bka(z, p2, w2))) ->
  (all z. z.rip = t -> bkp(z)) ->
  true -> (all z p2 w2. z.rip = t -> tr.at_tm(b, z, p2, w2) -> l(z, p2, w2) || (bkp(z) && bka(z, p2, w2)))
proof
  assume h hb _
  fix z p2 w2
  assume e a
  show by taut(mp(all_elim(mp(h, taut()), {z}, {p2}, {w2}), e, a), mp(all_elim(hb, {z}), e))
qed

// ----------------------------------------------------------------------
//  A claim for another program: P's for Q, every run of P one of Q's but
//  a stack overflow with the I/O as at the entry (a crash there matched
//  by the events unchanged: tr.crash's io) -- a GIMPLE statement the code
//  implements by a call (`st_bytes` by `call memset`), the call's overflow
//  none of the statement's. The breakpoints' relation kept by such runs
//  in its world (as tr.at_tm, the stop's, and a CFG's cut points'): a
//  breakpoint's reduct, Q's runs among its own.

// (an overflow with the entry's I/O)
abbrev tr.ovs(s, o) := ex x. o = exc(x, exc_val("stack_overflow", empty)) && x.os.events = s.os.events
// (a relation of programs kept, in a world, by the runs other than
// overflows)
def tr.bka_ovs(zb pb wb. bka) := all z p1 p2 w. (all o. (all x. !(o = exc(x, exc_val("stack_overflow", empty)))) -> runs(p1, w, o) -> runs(p2, w, o)) ->
  bka(z, p1, w) -> bka(z, p2, w)

theorem tr.gk_ovs(zb. bkp, zb pb wb. bka): all s v P Q w o. (all o. runs(P, w, o) -> runs(Q, w, o) || tr.ovs(s, o)) -> tr.bka_ovs(zb pb wb. bka(zb, pb, wb)) ->
  tr.gk(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, P, w, o) -> tr.gk(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, Q, w, o)
proof
  fix s v P Q w o
  assume hr hb hg
  // (P's runs but the overflows: Q's)
  have nov: all o2. (all x. !(o2 = exc(x, exc_val("stack_overflow", empty)))) -> runs(P, w, o2) -> runs(Q, w, o2) proof
    fix o2
    assume hn hp
    have c := mp(all_elim(hr, {o2}), hp)
    have c2: tr.ovs(s, o2) -> runs(Q, w, o2) proof
      assume e
      obtain x, xe _ from e
      have f := all_elim(hn, {x})
      show by taut(xe, f)
    qed
    show by taut(c, c2)
  qed
  have k1: tr.ub(s, v, P, w) -> tr.ub(s, v, Q, w) proof
    assume u
    obtain e x, eu eno ena rst rr from expand(u, tr.ub)
    have hn: all y. !(exc(x, e) = exc(y, exc_val("stack_overflow", empty))) proof
      fix y
      show by simp(eno)
    qed
    have rq := mp(all_elim(nov, {exc(x, e)}), hn, rr)
    show by defs(ex_intro({e}, {x}, taut(eu, eno, ena, rst, rq)), tr.ub)
  qed
  have k2: tr.crash(s, P, w, o) -> tr.crash(s, Q, w, o) proof
    assume c
    obtain m1 a k0, h3 from expand(c, tr.crash)
    // (an overflow of P's: Q's, or the entry's I/O)
    have d1: (ex x. x in rec_and(abi.World, single(empty)) && runs(P, w, exc(x, exc_val("stack_overflow", empty))) && x.os.events = m1.os.events) ->
        tr.ovf(Q, w, m1.os) || s.os.events = m1.os.events proof
      assume e
      obtain x, xw xr xe from e
      have rc := mp(all_elim(hr, {exc(x, exc_val("stack_overflow", empty))}), xr)
      have a1: runs(Q, w, exc(x, exc_val("stack_overflow", empty))) -> tr.ovf(Q, w, m1.os) proof
        assume rq
        have ov: ex x2. x2 in rec_and(abi.World, single(empty)) && runs(Q, w, exc(x2, exc_val("stack_overflow", empty))) && x2.os.events = m1.os.events by ex_intro({x}, taut(xw, rq, xe))
        show by defs(taut(ov), tr.ovf)
      qed
      have a2: tr.ovs(s, exc(x, exc_val("stack_overflow", empty))) -> s.os.events = m1.os.events proof
        assume e2
        obtain y, ye yv from e2
        have xy: x = y by simp(ye)
        have t1: x.os.events = s.os.events := rewrite(sym(xy), yv)
        show := trans(sym(t1), xe)
      qed
      show by taut(rc, a1, a2)
    qed
    // (a divergence of P's: Q's)
    have d2: (ex t. runs(P, w, diverge(t))) -> tr.ovf(Q, w, m1.os) proof
      assume e
      obtain t, rt from e
      have hn: all y. !(diverge(t) = exc(y, exc_val("stack_overflow", empty))) proof
        fix y
        show by simp()
      qed
      have rq := mp(all_elim(nov, {diverge(t)}), hn, rt)
      have dv: ex t2. runs(Q, w, diverge(t2)) by ex_intro({t}, rq)
      show by defs(taut(dv), tr.ovf)
    qed
    have c1: tr.ovf(P, w, m1.os) -> tr.ovf(Q, w, m1.os) || s.os.events = m1.os.events proof
      assume ho
      show by taut(expand(ho, tr.ovf), d1, d2)
    qed
    have io: tr.ovf(Q, w, m1.os) || s.os.events = m1.os.events by taut(h3.io, c1)
    show by defs(ex_intro({m1}, {a}, {k0}, taut(h3.oe, h3.m1M, h3.ab, h3.sev, h3.inp, io)), tr.crash)
  qed
  have k3: tr.div(P, w, o) -> tr.div(Q, w, o) proof
    assume d
    have d0 d1 := expand(d, tr.div)
    obtain t, rt from d1
    have hn: all y. !(diverge(t) = exc(y, exc_val("stack_overflow", empty))) proof
      fix y
      show by simp()
    qed
    have rq := mp(all_elim(nov, {diverge(t)}), hn, rt)
    have dv: ex t2. runs(Q, w, diverge(t2)) by ex_intro({t}, rq)
    show by defs(taut(d0, dv), tr.div)
  qed
  have k4: (ex m1. o = ok(m1, empty) && tr.arr(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, m1, P, w)) ->
      (ex m1. o = ok(m1, empty) && tr.arr(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, m1, Q, w)) proof
    assume e
    obtain m1, oe ar from e
    have ar1 ar2 := expand(ar, tr.arr)
    // (a return: of Q's)
    have r1: tr.out(s, m1) -> tr.retok(s, v, Q, w, m1) proof
      assume ho
      have rt := expand(mp(ar1, ho), tr.retok)
      have rt1 rt2 rt3 _ _ _ _ _ _ := rt
      obtain w2, rw q2 q3 q4 q5 q6 from rt3
      have hn: all y. !(ok(w2, pair(m1.gpr[0], m1.gpr[2])) = exc(y, exc_val("stack_overflow", empty))) proof
        fix y
        show by simp()
      qed
      have rq := mp(all_elim(nov, {ok(w2, pair(m1.gpr[0], m1.gpr[2]))}), hn, rw)
      have ew: ex w3. runs(Q, w, ok(w3, pair(m1.gpr[0], m1.gpr[2]))) && w3 in abi.World && w3 in univ(1) &&
          tr.wmc(s.vm, m1.vm, w3.vm, abi.wob(v.live, w3.objs.c_bytes), s.fs_base, abi.sp(s)) && m1.os = w3.os && tr.rfs(s, v, m1, w3) by ex_intro({w2}, taut(rq, q2, q3, q4, q5, q6))
      show by defs(taut(rt, ew), tr.retok)
    qed
    // (a breakpoint: its reduct's runs those of Q's among them, the
    // relation kept in its world)
    have r2: !tr.out(s, m1) -> bkp(m1) -> (ex p2 w2. tr.red(Q, w, p2, w2) && bka(m1, p2, w2)) proof
      assume no hk
      obtain p2 w2, rd ba from mp(ar2, no, hk)
      let QW := set_select(p2, z. runs(Q, w, snd(z)))
      have inc: all o2. (all x. !(o2 = exc(x, exc_val("stack_overflow", empty)))) -> runs(p2, w2, o2) -> runs(QW, w2, o2) proof
        fix o2
        assume hn hp
        have rq := mp(all_elim(nov, {o2}), hn, mp(all_elim(expand(rd, tr.red), {o2}), hp))
        show by defs(simp(expand(hp, runs), expand(rq, runs)), runs)
      qed
      have bq := mp(all_elim(expand(hb, tr.bka_ovs), {m1}, {p2}, {QW}, {w2}), inc, ba)
      have rg: all o2. runs(QW, w2, o2) -> runs(Q, w, o2) proof
        fix o2
        assume h
        show by defs(simp(unsel(expand(h, runs))), runs)
      qed
      have rq: tr.red(Q, w, QW, w2) by defs(taut(rg), tr.red)
      show by ex_intro({QW}, {w2}, taut(rq, bq))
    qed
    have aq: tr.arr(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, m1, Q, w) by defs(taut(r1, r2), tr.arr)
    show by ex_intro({m1}, taut(oe, aq))
  qed
  show by defs(taut(expand(hg, tr.gk), k1, k2, k3, k4), tr.gk)
qed

theorem tr.lv_ovs(zb. bkp, zb pb wb. bka): all s v base code fr a hs fd rs P Q w. (all o. runs(P, w, o) -> runs(Q, w, o) || tr.ovs(s, o)) -> tr.bka_ovs(zb pb wb. bka(zb, pb, wb)) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, fd, rs, P, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, fd, rs, Q, w)
proof
  fix s v base code fr a hs fd rs P Q w
  assume hr hb hl
  have g: all m. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, fd) ->
      tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, Q, w, m) proof
    fix m
    assume h1 h2 h3 h4 h5 h6
    have sm := expand(mp(all_elim(expand(hl, tr.lv), {m}), h1, h2, h3, h4, h5, h6), tr.sim)
    have r: all o. tr.run_k(s, zb. bkp(zb), m, o) -> tr.gk(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, Q, w, o) proof
      fix o
      assume hk
      show := apply(tr.gk_ovs[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {P}, {Q}, {w}, {o}, hr, hb, mp(all_elim(sm, {o}), hk))
    qed
    show by defs(r, tr.sim)
  qed
  show by defs(g, tr.lv)
qed

// (the stop's relation, or none: kept)
theorem tr.bka_ovs_at(b, k): tr.bka_ovs(zb pb wb. k && tr.at_tm(b, zb, pb, wb))
proof
  have g: all z p1 w1 p2 w2. (all o. (all x. !(o = exc(x, exc_val("stack_overflow", empty)))) -> runs(p1, w1, o) -> runs(p2, w2, o)) ->
      k && tr.at_tm(b, z, p1, w1) -> k && tr.at_tm(b, z, p2, w2) proof
    fix z p1 w1 p2 w2
    assume hi ha
    have hk ht := ha
    // (at main: its raise)
    have c1: (ex w3 v2 mem2. abi.raise_state(w3) && runs(p1, w1, exc(w3, exc_val("at_main", empty))) && w3 = tr.vw(b, z, v2, mem2) && tr.vok(b, z, v2, mem2)) ->
        tr.at_tm(b, z, p2, w2) proof
      assume e
      obtain w3 v2 mem2, rs rr we vk from e
      have hn: all y. !(exc(w3, exc_val("at_main", empty)) = exc(y, exc_val("stack_overflow", empty))) proof
        fix y
        show by defs(simp(), exc_val)
      qed
      have rq := mp(all_elim(hi, {exc(w3, exc_val("at_main", empty))}), hn, rr)
      have ea: ex w4 v3 mem3. abi.raise_state(w4) && runs(p2, w2, exc(w4, exc_val("at_main", empty))) && w4 = tr.vw(b, z, v3, mem3) && tr.vok(b, z, v3, mem3) by ex_intro({w3}, {v2}, {mem2}, taut(rs, rq, we, vk))
      show by defs(taut(ea), tr.at_tm)
    qed
    // (undefined: its raise)
    have c2: (ex e x. e in univ(1) && !(e = exc_val("stack_overflow", empty)) && !(e = exc_val("at_main", empty)) && abi.raise_state(x) && runs(p1, w1, exc(x, e))) ->
        tr.at_tm(b, z, p2, w2) proof
      assume e0
      obtain e x, eu eno ena rs rr from e0
      have hn: all y. !(exc(x, e) = exc(y, exc_val("stack_overflow", empty))) proof
        fix y
        show by simp(eno)
      qed
      have rq := mp(all_elim(hi, {exc(x, e)}), hn, rr)
      have eb: ex e2 x2. e2 in univ(1) && !(e2 = exc_val("stack_overflow", empty)) && !(e2 = exc_val("at_main", empty)) && abi.raise_state(x2) && runs(p2, w2, exc(x2, e2)) by ex_intro({e}, {x}, taut(eu, eno, ena, rs, rq))
      show by defs(taut(eb), tr.at_tm)
    qed
    have at2: tr.at_tm(b, z, p2, w2) by taut(expand(ht, tr.at_tm), c1, c2)
    show by taut(hk, at2)
  qed
  have g1: all z p1 p2 w. (all o. (all x. !(o = exc(x, exc_val("stack_overflow", empty)))) -> runs(p1, w, o) -> runs(p2, w, o)) ->
      k && tr.at_tm(b, z, p1, w) -> k && tr.at_tm(b, z, p2, w) proof
    fix z p1 p2 w
    show := all_elim(g, {z}, {p1}, {w}, {p2}, {w})
  qed
  show by defs(g1, tr.bka_ovs)
qed

// (a CFG's cut points', ahead of a relation kept: kept -- a cut point's
// runs an ok one)
theorem tr.bka_ovs_cut(z. C, z w y. D, z. B, zb pb wb. bka): tr.bka_ovs(zb pb wb. bka(zb, pb, wb)) ->
  tr.bka_ovs(z p w. (C(z) && (ex y. D(z, w, y) && runs(p, w, ok(w, pair(18446744073709551616, y))))) || (B(z) && bka(z, p, w)))
proof
  assume hb
  have g: all z p1 p2 w. (all o. (all x. !(o = exc(x, exc_val("stack_overflow", empty)))) -> runs(p1, w, o) -> runs(p2, w, o)) ->
      (C(z) && (ex y. D(z, w, y) && runs(p1, w, ok(w, pair(18446744073709551616, y))))) || (B(z) && bka(z, p1, w)) ->
      (C(z) && (ex y. D(z, w, y) && runs(p2, w, ok(w, pair(18446744073709551616, y))))) || (B(z) && bka(z, p2, w)) proof
    fix z p1 p2 w
    assume hi ha
    have c1: (ex y. D(z, w, y) && runs(p1, w, ok(w, pair(18446744073709551616, y)))) -> (ex y. D(z, w, y) && runs(p2, w, ok(w, pair(18446744073709551616, y)))) proof
      assume e
      obtain y, hd hr from e
      have hn: all x. !(ok(w, pair(18446744073709551616, y)) = exc(x, exc_val("stack_overflow", empty))) proof
        fix x
        show by simp()
      qed
      have r2 := mp(all_elim(hi, {ok(w, pair(18446744073709551616, y))}), hn, hr)
      show by ex_intro({y}, taut(hd, r2))
    qed
    have c2: bka(z, p1, w) -> bka(z, p2, w) := mp(all_elim(expand(hb, tr.bka_ovs), {z}, {p1}, {p2}, {w}), hi)
    show by taut(ha, c1, c2)
  qed
  show by defs(g, tr.bka_ovs)
qed

// The startup mode's call for a statement S the code implements by a call
// to g (its result unused): tr.call0_st's claim, for the call, is S's --
// the call's runs S's but the overflows with the entry's I/O
theorem tr.call0_stb(s, v, base, code, fr, a, a2, len, off, f, g, args, n, cb, cc, st, hs, ds, fd2, rs, rc, w, t, ks, S, x9 x10 x8. ka, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw, zb. bkp, zb pb wb. bka):
  v.c_bytes = tr.cbm(false, s.fs_base) -> tr.ofr(s, fr, v) -> tr.hap(s, hs, v) ->
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a -> runs(x86_64_linux.exec_body(len, tag(120, off)), m, o)) ->
  a2 = bits_add(64, a, bits_of_int(64, len)) -> off in bits(32) -> base in omega ->
  f = bits_add(64, a2, bits_sext(32, 64, off)) -> tr.ccs_m(false, fr, f, g, t, ks, cb, cc, st) -> !(f = t) -> (int_mod(fr, 16) = 8 -> tr.sal16(s)) -> abi.loaded(s.vm, cb, cc, st) -> cb in omega ->
  tr.cfr(fr) -> seq_len(args) = n -> n in omega -> int_le(n, 6) ->
  g in fn_space(abi.ARGS, powerset(univ(1))) -> tr.callee_io(g, n) ->
  (all m. tr.regs(m, rs) -> tr.args_in(m, args)) -> tr.cs_sub(rc, rs) -> tr.hin(hs, fr) -> fd2 in omega -> int_le(fd2, int_add(fr, 8)) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) ->
  (all t0. t0 in univ(1) -> runs(mkprog(x0 x1. ex x8. dd(t0, x8) && k(x8, x1)), w, diverge(t0))) ->
  (all w4 r0 r1. w4 in abi.World && w4 in univ(1) -> r0 in bits(64) -> r1 in bits(64) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, fd2, fn_update(fn_update(rc, 0, pair(8, r0)), 2, pair(8, r1)),
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. ka(x0, empty, x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w4)) ->
  (all z. z.rip = t -> bkp(z)) -> (all z. int_lt(z.gpr[4], int_sub(s.gpr[4], fr)) -> bkp(z) -> z.rip = t) -> (ks -> (all z p2 w2. z.rip = t -> tr.at_tm(false, z, p2, w2) -> bka(z, p2, w2))) ->
  (all o. runs(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call0(g, args), x0, x9 x10. ka(x9, empty, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
      x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, o) ->
    runs(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(S, x0, x9 x10. ka(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
      x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, o) || tr.ovs(s, o)) ->
  tr.bka_ovs(zb pb wb. bka(zb, pb, wb)) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(S, x0, x9 x10. ka(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w)
proof
  assume hmn hofr hap hat ha2 hoff hb hf himp hft hal hld hcb hcf hln hno hn6 hgt hio hreg hsub hhin hfo hfd hk hd hpost hbt hbf hat2 hinc hbs
  have r := mp(tr.call0_st[s := s, v := v, base := base, code := code, fr := fr, a := a, a2 := a2, len := len, off := off, f := f, g := g, args := args, n := n, cb := cb, cc := cc, st := st,
    hs := hs, ds := ds, fd2 := fd2, rs := rs, rc := rc, w := w, t := t, ks := ks, ka := x9 x10 x8. ka(x9, empty, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2),
    bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], hmn, hofr, hap, hat, ha2, hoff, hb, hf, himp, hft, hal, hld, hcb, hcf, hln, hno, hn6, hgt, hio, hreg, hsub, hhin, hfo, hfd, hk, hd, hpost, hbt, hbf, hat2)
  show := apply(tr.lv_ovs[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], hinc, hbs, r)
qed
