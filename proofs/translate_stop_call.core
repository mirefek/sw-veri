// A call in the stop form (as tr.callee_sim, translate_call.core): the
// caller's claim with t a breakpoint; the callee's contract with the stop
// at t (k) or without (never stopping) -- its stop the caller's breakpoint,
// the call there raising at main (the caller's relation there holding at
// tr.at_t).

// the contract with the stop for an entry of any alignment (as
// tr.implements_at_u)
def tr.implements_stop_u(f, spec, t, k, base, code, statics) :=
  all args objs mem s o. args in abi.ARGS -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(s.vm, base, code, statics) ->
    s.rip = f -> tr.entry_ok_u(s, args) -> tr.objs_ok(s, objs) -> abi.view_ok(s, objs, mem) -> tr.run_s(s, t, s, o) -> tr.matches_tk(spec, args, objs, mem, s, o, k)

// (never stopping: the contract for any alignment)
theorem tr.implements_ns_at_u: all f spec t base code statics. tr.implements_stop_u(f, spec, t, false, base, code, statics) -> tr.implements_at_u(f, spec, base, code, statics)
proof
  fix f spec t base code statics
  assume h
  have c := expand(h, tr.implements_stop_u)
  have g: all args objs mem s o. args in abi.ARGS -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(s.vm, base, code, statics) ->
      s.rip = f -> tr.entry_ok_u(s, args) -> tr.objs_ok(s, objs) -> abi.view_ok(s, objs, mem) -> tr.run_d(s, s, o) -> tr.matches_t(spec, args, objs, mem, s, o) proof
    fix args objs mem s o
    assume hA hot hmv hM su hl hrip he ok hwm hr
    have c2: all o2. tr.run_s(s, t, s, o2) -> tr.matches_tk(spec, args, objs, mem, s, o2, false) proof
      fix o2
      assume rs
      show := mp(all_elim(c, {args}, {objs}, {mem}, {s}, {o2}), hA, hot, hmv, hM, su, hl, hrip, he, ok, hwm, rs)
    qed
    show := apply(tr.ns_run, {spec}, {args}, {objs}, {mem}, {s}, {t}, {o}, c2, hr)
  qed
  show by defs(g, tr.implements_at_u)
qed

// a callee's contract in the stop form (as tr.callee_contract)
def tr.callee_contract_s(fr, f, g, t, k, cb, cc, st) := (int_mod(fr, 16) = 8 && tr.implements_stop(f, g, t, k, cb, cc, st)) || tr.implements_stop_u(f, g, t, k, cb, cc, st)
// ... in the mode b
def tr.ccs_m(b, fr, f, g, t, k, cb, cc, st) := (int_mod(fr, 16) = 8 && tr.impl_m(b, false, f, g, t, k, cb, cc, st)) || tr.impl_m(b, true, f, g, t, k, cb, cc, st)

// (the main mode's contract for any alignment: the generic one's)
theorem tr.impl_of_u: all f spec t k base code statics. tr.implements_stop_u(f, spec, t, k, base, code, statics) -> tr.impl_m(true, true, f, spec, t, k, base, code, statics)
proof
  fix f spec t k base code statics
  assume h
  have g: all args objs mem s o. args in abi.ARGS -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(s.vm, base, code, statics) ->
      s.rip = f -> tr.eok(true, true, s, args) -> tr.objs_ok(s, objs) -> tr.vok(true, s, objs, mem) -> tr.run_s(s, t, s, o) ->
      tr.mtv(true, s, abi.wob(objs, tr.cbm(true, s.fs_base)), spec[args], tr.vw(true, s, objs, mem), o, k) proof
    fix args objs mem s o
    assume h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 h11
    have eo: tr.entry_ok_u(s, args) by taut(all_elim(tr.eok_ut, {s}, {args}), h8)
    have vo: abi.view_ok(s, objs, mem) by taut(all_elim(tr.vok_t, {s}, {objs}, {mem}), h10)
    have mt := mp(all_elim(expand(h, tr.implements_stop_u), {args}, {objs}, {mem}, {s}, {o}), h1, h2, h3, h4, h5, h6, h7, eo, h9, vo, h11)
    show := apply(tr.mt_of, mt)
  qed
  show by defs(g, tr.impl_m)
qed

// (the main mode's callee contract: the generic one's)
theorem tr.ccs_of: all fr f g t k cb cc st. tr.callee_contract_s(fr, f, g, t, k, cb, cc, st) -> tr.ccs_m(true, fr, f, g, t, k, cb, cc, st)
proof
  fix fr f g t k cb cc st
  assume h
  have a: int_mod(fr, 16) = 8 && tr.implements_stop(f, g, t, k, cb, cc, st) -> int_mod(fr, 16) = 8 && tr.impl_m(true, false, f, g, t, k, cb, cc, st) proof
    assume h8
    show conj(h8.1, apply(tr.impl_of, h8.2))
  qed
  have u: tr.implements_stop_u(f, g, t, k, cb, cc, st) -> tr.impl_m(true, true, f, g, t, k, cb, cc, st) proof
    assume hu
    show := apply(tr.impl_of_u, hu)
  qed
  show by defs(taut(expand(h, tr.callee_contract_s), a, u), tr.ccs_m)
qed

// (the claim's run returning a value: an empty one -- its breakpoints and
// the return's)
theorem tr.run_k_okv(zb. bkp): all s m x e. tr.run_k(s, zb. bkp(zb), m, ok(x, e)) -> e = empty
proof
  fix s m x e
  assume h
  obtain r, hk hm from expand(h, tr.run_k)
  // (no pass leaves with the kind ret: a step's raise, a breakpoint's brk)
  have pr: all l r2. tr.rbk(s, zb. bkp(zb), l, r2) -> !is_ok(r2) -> !(fst(r2) = 1 && fst(out_value(r2)) = "ret") proof
    fix l r2
    assume hb nk
    show by simp(expand(hb, tr.rbk, tr.rst, bind_rel), nk, keep(x86_64_linux.step))
  qed
  have p1: tr.rst(pair(m, empty), r) -> !is_ok(r) -> !(fst(r) = 1 && fst(out_value(r)) = "ret") proof
    assume hs nk
    show by simp(expand(hs, tr.rst, bind_rel), nk, keep(x86_64_linux.step))
  qed
  have c1: (ex l1. tr.rst(pair(m, empty), ok(l1, empty)) && tr.rwk(s, zb. bkp(zb), l1, r)) -> !(fst(r) = 1 && fst(out_value(r)) = "ret") proof
    assume e1
    obtain l1, _ rw from e1
    have cs := mp(while_cases[l0 := l1, c := x5. true, b := x5 x6. tr.rbk(s, zb. bkp(zb), x5, x6), tr := x5. fn_update(empty, "os.events", fst(x5).os.events), r := r],
      expand(rw, tr.rwk))
    have k1: (ex l2. (!true && r = ok(l2, empty)) || (true && tr.rbk(s, zb. bkp(zb), l2, r) && !is_ok(r))) -> !(fst(r) = 1 && fst(out_value(r)) = "ret") proof
      assume el
      obtain l2, hl from el
      show := mp(all_elim(pr, {l2}, {r}), (tr.rbk(s, zb. bkp(zb), l2, r) by taut(hl)), (!is_ok(r) by taut(hl)))
    qed
    have k2: (ex t2. r = diverge(t2)) -> !(fst(r) = 1 && fst(out_value(r)) = "ret") proof
      assume ed
      obtain t2, te from ed
      show by simp(te)
    qed
    show by taut(cs, k1, k2)
  qed
  have nr: !(fst(r) = 1 && fst(out_value(r)) = "ret") by taut(expand(hk, tr.rk), c1, p1)
  show by simp(expand(hm, tr.rmap), nr)
qed

// The callee's claim at its entry C (a call's: its registers' n arguments,
// the callers' objects L): what its contract gives there
abbrev tr.chc(b, fr, C, T, g, n, L, t, ks, cb, cc, st) := all regs mem oc. regs in abi.ARGS -> seq_len(regs) = n -> L in set_type(omega) -> mem in x86_64_linux.Vm -> C in x86_64_linux.Machine -> C in univ(1) -> abi.loaded(C.vm, cb, cc, st) -> C.rip = T -> tr.eok(b, true, C, regs) -> (int_mod(fr, 16) = 8 -> tr.eok(b, false, C, regs)) -> tr.objs_ok(C, L) -> tr.vok(b, C, L, mem) -> tr.run_s(C, t, C, oc) -> tr.mtv(b, C, abi.wob(L, tr.cbm(b, C.fs_base)), g[regs], tr.vw(b, C, L, mem), oc, ks)

// (a contract for either alignment, tr.ccs_m: its claim at any entry)
theorem tr.ccs_chc: all b fr C T g n L t ks cb cc st. tr.ccs_m(b, fr, T, g, t, ks, cb, cc, st) -> tr.chc(b, fr, C, T, g, n, L, t, ks, cb, cc, st)
proof
  fix b fr C T g n L t ks cb cc st
  assume himp
  fix regs mem oc
  assume hA hl hvo hmv cM cu lC crip eu e8 ook vok hrd
  have a8: (int_mod(fr, 16) = 8 && tr.impl_m(b, false, T, g, t, ks, cb, cc, st)) -> tr.mtv(b, C, abi.wob(L, tr.cbm(b, C.fs_base)), g[regs], tr.vw(b, C, L, mem), oc, ks) proof
    assume h8
    show := mp(all_elim(expand(h8.2, tr.impl_m), {regs}, {L}, {mem}, {C}, {oc}), hA, hvo, hmv, cM, cu, lC, crip, mp(e8, h8.1), ook, vok, hrd)
  qed
  have au: tr.impl_m(b, true, T, g, t, ks, cb, cc, st) -> tr.mtv(b, C, abi.wob(L, tr.cbm(b, C.fs_base)), g[regs], tr.vw(b, C, L, mem), oc, ks) proof
    assume hu0
    show := mp(all_elim(expand(hu0, tr.impl_m), {regs}, {L}, {mem}, {C}, {oc}), hA, hvo, hmv, cM, cu, lC, crip, eu, ook, vok, hrd)
  qed
  show by taut(expand(himp, tr.ccs_m), a8, au)
qed

// (the same, the callee's contract only at its entry C: its claim there,
// as tr.ccs_m's instance gives it, or a stack-argument contract's)
theorem tr.callee_sim_smc(b, g, args, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw, zb. bkp, zb pb wb. bka): all s v base code fr m w n hs fd RA T m1 e1 C cb cc st rs rc t ks.
  tr.hap(s, hs, v) -> tr.ofr(s, fr, v) ->
  tr.inv(s, base, code, fr, m, w) -> tr.cfr(fr) -> tr.mem(s, m, w, v) -> v.c_bytes = tr.cbm(b, s.fs_base) -> base in omega -> tr.regs(m, rs) -> tr.cs_sub(rc, rs) ->
  tr.args_in(m, args) -> seq_len(args) = n -> n in omega -> int_le(n, 6) -> RA in bits(64) -> T in bits(64) ->
  runs(x86_64_linux.touch_range(bits_sub(64, m.gpr[4], 8), 8, 1), fn_update(m, "rip", RA), ok(m1, e1)) ->
  C = fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, bits_sub(64, m.gpr[4], 8), 8, RA))),
    "gpr", fn_update(m1.gpr, 4, bits_sub(64, m.gpr[4], 8))), "rip", T) ->
  tr.chc(b, fr, C, T, g, n, v.live, t, ks, cb, cc, st) -> !(T = t) -> (ks -> (all z p2 w2. z.rip = t -> tr.at_tm(b, z, p2, w2) -> bka(z, p2, w2))) ->
  (int_mod(fr, 16) = 8 -> tr.sal16(s)) -> abi.loaded(s.vm, cb, cc, st) -> cb in omega ->
  tr.homes(s, m, hs) -> tr.hin(hs, fr) -> fd in omega -> int_le(fd, int_add(fr, 8)) ->
  g in fn_space(abi.ARGS, powerset(univ(1))) -> tr.callee_io(g, n) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) -> (all t0. t0 in univ(1) -> runs(mkprog(x0 x1. ex x8. dd(t0, x8) && k(x8, x1)), w, diverge(t0))) ->
  (all w4 r0 r1. w4 in abi.World && w4 in univ(1) -> r0 in bits(64) -> r1 in bits(64) -> tr.pt(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb),
    v, base, code, fr, RA, hs, fd, fn_update(fn_update(rc, 0, pair(8, r0)), 2, pair(8, r1)),
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. a(x0, pair(r0, r1), x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w4)) ->
  (all z. int_lt(z.gpr[4], m.gpr[4]) -> !bkp(z)) ->
  tr.cl(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb), v,
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gc.cm(b, g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, C)
proof
  fix s v base code fr m w n hs fd RA T m1 e1 C cb cc st rs rc t ks
  assume hap hofr hi hcf hmm hmn hb hrs hsub hargs hln hno hn6 hra ht htr hC himp htt hS hal hld hcb hhs hhin hfo hfd hgt hio hk hd hpost hbx
  let S := s.gpr[4]
  let W1 := w
  let P := mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gc.cm(b, g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))
  let R := m.gpr[4]
  let regs := tr.aregs(m, n)
  have {sM, mM, wW, wu} := apply(tr.inv_call, hi)
  have {kc} := hi
  have {rb, r16, rlt, rss = rs, sb, slt} := apply(tr.call_rsp, hi, hcf)
  have cM cu co cf cc0 cgs cfl cgpr crip ckc cvf cle cpi cby cstk cacc := apply(tr.push_ok, {s}, {base}, {code}, {fr}, {m}, {w}, {RA}, {T}, {m1}, {e1}, {C}, hi, hcf, hra, ht, htr, hC)
  have cv: C.vm in x86_64_linux.Vm := apply(x86i.parts, cM).4
  have c4: C.gpr[4] = int_sub(R, 8) by simp(cgpr)
  have spc: abi.sp(C) = R by simp(c4, rb, r16, rlt)
  have sp8: abi.sp(s) = int_add(S, 8) by simp(sb, slt)
  have rg1 rg2 rg3 hA _ rlen _ := apply(tr.aregs_ok, {m}, {args}, {n}, mM, hln, hno, hn6, hargs)
  have rg: gc.regs_ok(regs, args) := conj(rg1, rg2, rg3)
  // (C: no stop of the caller's -- below its rsp, not at t)
  have nrC: int_lt(C.gpr[4], abi.sp(s)) by arith(c4, sp8, rss, rb, r16)
  have ltC: int_lt(C.gpr[4], m.gpr[4]) by arith(c4, r16)
  have nbC0 := mp(all_elim(hbx, {C}), ltC)
  have ct: !(C.rip = t) := rewrite(sym(crip), htt)
  have nbC: !(bkp(C) || C.rip = t) by taut(nbC0, ct)
  // GIMPLE's checks failing at the world grown (the main mode's): undefined
  have bad: (b && !gc.sound(W1)) -> tr.cl(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb), v, P, w, C) proof
    assume hn
    have ub := apply(tr.gcall_ub_m[b := b, g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {s}, {v}, {w}, {regs}, wW, wu, rg, hn.1, hn.2, hk)
    have su := apply(tr.sim_ub[bkp := zb. bkp(zb) || zb.rip = t, bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {P}, {w}, {C}, ub)
    show := apply(tr.sim_cl[bkp := zb. bkp(zb) || zb.rip = t, bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {P}, {w}, {C}, nrC, nbC, su)
  qed
  // ... holding: the callee's entry, its contract
  have good: (b -> gc.sound(W1)) -> tr.cl(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb), v, P, w, C) proof
    assume hs
    have eoku eok vok ook veq wvv dso := apply(tr.callee_ready_m, {b}, {s}, {base}, {code}, {fr}, {m}, {w}, {v}, {RA}, {T}, {m1}, {e1}, {C}, {n}, hofr, hi, hcf, hmm, hmn, hra, ht, hno, hn6, htr, hC, hs)
    have l1 := mp(all_elim(expand(kc, tr.keeps_code), {cb}, {cc}, {st}), hcb, hld)
    have lC := mp(all_elim(expand(ckc, tr.keeps_code), {cb}, {cc}, {st}), hcb, l1)
    let WV := W1.vm
    let VC := abi.wob(v.live, tr.cbm(b, C.fs_base))
    let WC := tr.vw(b, C, v.live, WV)
    let G := g[regs]
    have ctr: all oc. tr.run_s(C, t, C, oc) -> tr.mtv(b, C, VC, G, WC, oc, ks) proof
      fix oc
      assume hrd
      have e8: int_mod(fr, 16) = 8 -> tr.eok(b, false, C, regs) proof
        assume h8
        show := mp(eok, h8, mp(hal, h8))
      qed
      show := mp(all_elim(himp, {regs}, {WV}, {oc}), hA, rlen, dso, wvv, cM, cu, lC, crip, eoku, e8, ook, vok, hrd)
    qed
    have w1W: W1 in abi.World := wW
    have w1u: W1 in univ(1) := wu
    // the callee raising: the caller raises so (undefined, or at main)
    have rex: all x e. e in univ(1) -> runs(G, WC, exc(x, e)) -> runs(P, w, exc(x, e)) proof
      fix x e
      assume eu rr
      have rr2 := rewrite(veq, rr)
      have pu := apply(tr.spec_univ, {g}, {regs}, {W1}, {exc(x, e)}, hgt, hA, rr2)
      have xu: x in univ(1) by simp(pu)
      show := apply(tr.gcall_exc_m[b := b, g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {regs}, {x}, {e}, wu, xu, eu, rg, hs, rr2, hk)
    qed
    have rub: tr.ub(C, VC, G, WC) -> tr.ub(s, v, P, w) proof
      assume hr
      obtain e x, eu eno ena rst rr from expand(hr, tr.ub)
      have pe := mp(all_elim(rex, {x}, {e}), eu, rr)
      show by defs(ex_intro({e}, {x}, taut(eu, eno, ena, rst, pe)), tr.ub)
    qed
    // the callee returned to x: the caller's claim reaching x (or the call
    // undefined)
    have rcl: all x. tr.run_s(C, t, C, ok(x, empty)) -> tr.ub(s, v, P, w) ||
        tr.cl(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb), v, P, w, x) proof
      fix x
      assume hrx
      have mt2 := expand(mp(all_elim(ctr, {ok(x, empty)}), hrx), tr.mtv)
      have n2: tr.crash(C, G, WC, ok(x, empty)) -> false proof
        assume ca
        obtain m2 a0 k0, {oe} from expand(ca, tr.crash)
        show by simp(oe)
      qed
      have n5: tr.stv(b, G, WC, ok(x, empty)) -> false proof
        assume sa
        obtain m2 w3 v3 mem3, oe _ _ _ _ from expand(sa, tr.stv)
        show by simp(oe, tr.stop_ne)
      qed
      have u1: tr.ub(C, VC, G, WC) -> tr.ub(s, v, P, w) ||
          tr.cl(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb), v, P, w, x) proof
        assume ra
        have ub := mp(rub, ra)
        show by taut(ub)
      qed
      have u2: (ex m1. ok(x, empty) = ok(m1, empty) && tr.rtv(b, C, VC, G, WC, m1)) -> tr.ub(s, v, P, w) ||
          tr.cl(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb), v, P, w, x) proof
        assume eo
        obtain m2, eo1 rv from eo
        have xm: x = m2 by simp(eo1)
        let r0 := x.gpr[0]
        let r1 := x.gpr[2]
        have xM xu ew xcpu xgs xrip0 xr4 xcs xdf := expand(rewrite(sym(xm), rv), tr.rtv)
        obtain w2, hg0 w2W w2u wm1 xos cb1 xfs1 xfs0 from ew
        have wm0: tr.wmc(C.vm, x.vm, w2.vm, abi.wob(v.live, w2.objs.c_bytes), C.fs_base, abi.sp(C)) by simp(wm1, keep(tr.wmc))
        have w2cb: w2.objs.c_bytes = tr.cbm(b, C.fs_base) by simp(cb1)
        have hg8 := rewrite(veq, hg0)
        have r0R: 0 in x86_64_linux.Reg by simp()
        have r2R: 2 in x86_64_linux.Reg by simp()
        have r0b := mp(mp(all_elim(x86i.reg_typed, {x}, {0}), xM), r0R)
        have r1b := mp(mp(all_elim(x86i.reg_typed, {x}, {2}), xM), r2R)
        have r0u: r0 in univ(1) by simp(r0b)
        have r1u: r1 in univ(1) by simp(r1b)
        // the callee's spec: a valid world on its return, or undefined there (so is this call)
        have ci := mp(all_elim(expand(hio, tr.callee_io), {regs}, {W1}, {w2}, {pair(r0, r1)}),
          (ord_le(n, seq_len(regs)) by defs(simp(rlen), ord_le)), hg8)
        have mr: tr.may_raise(g, regs, W1) -> tr.ub(s, v, P, w) ||
            tr.cl(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb), v, P, w, x) proof
          assume hm
          have eu: empty in univ(1) by simp()
          have hx: all x e. x in univ(1) -> e in univ(1) -> runs(g[regs], W1, exc(x, e)) by taut(expand(expand(hm, tr.may_raise), tr.undef))
          have pe := mp(all_elim(hx, {W1}, {empty}), w1u, eu)
          have eno := tr.undef_empty
          have rst: abi.raise_state(W1) by defs(apply(tr.world_and, w1W), abi.raise_state)
          have pe2 := subst({y. runs(g[regs], y, exc(W1, empty))}, sym(veq), pe)
          have ra: tr.ub(C, VC, G, WC) by defs(ex_intro({empty}, {W1}, taut(eu, eno, rst, pe2)), tr.ub)
          show := mp(u1, ra)
        qed
        // the caller goes on at the return address with the result
        have fk: tr.returns_valid(W1, w2) -> tr.ub(s, v, P, w) ||
            tr.cl(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb), v, P, w, x) proof
          assume rv
          have xv: x.vm in x86_64_linux.Vm := apply(x86i.parts, xM).4
          have pinv pmem phom pfr preg prip := apply(tr.post_call_m, {b}, {s}, {base}, {code}, {fr}, {m}, {w}, {v}, {RA}, {T}, {m1}, {e1}, {C}, {x}, {w2}, {hs}, {fd}, {rs}, {rc},
            hi, hcf, hmm, hmn, hb, hra, ht, htr, hC, rv, xM, xu, w2W, w2u, wm0, xos, w2cb, xfs1, xfs0, xcpu, xgs, xrip0, xr4, xcs, xdf, hhs, hap, hofr, hhin, hfo, hfd, hrs, hsub)
          let W4 := gc.bm(b, w2, W1)
          have _ pk := apply(tr.gcall_ret_m[b := b, g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {regs}, {w2}, {r0}, {r1}, wu, w2u, r0u, r1u, rg, hs, hg8, hk)
          have red: tr.red(P, w, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. a(x0, pair(r0, r1), x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), W4) by defs(pk, tr.red)
          have {w4W = wW, w4u = wu} := pinv
          have ptk := mp(all_elim(hpost, {W4}, {r0}, {r1}), taut(w4W, w4u), r0b, r1b)
          have sm := mp(all_elim(expand(ptk, tr.pt), {x}), pinv, prip, phom, preg, pmem, pfr)
          have sm2 := apply(tr.cl_red[bkp := zb. bkp(zb) || zb.rip = t, bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {P}, {w},
            {mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. a(x0, pair(r0, r1), x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))}, {W4}, {x}, red, sm)
          show by taut(sm2)
        qed
        show by taut(fk, ci, mr)
      qed
      have n3 := all_elim(tr.div_ok, {G}, {WC}, {x}, {empty})
      show by taut(mt2, n2, n3, n5, u1, u2)
    qed
    // the caller's run from C
    have spl: int_le(abi.sp(C), abi.sp(s)) by arith(spc, sp8, rss)
    have cl0: int_lt(C.gpr[4], abi.sp(C)) by arith(c4, spc, r16)
    have hbc: all z. int_lt(z.gpr[4], abi.sp(C)) -> !bkp(z) proof
      fix z
      assume lt
      show := mp(all_elim(hbx, {z}), rewrite(spc, lt))
    qed
    have g0: all o. tr.run_k(s, zb. bkp(zb) || zb.rip = t, C, o) ->
        tr.gk(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb), v, P, w, o) proof
      fix o
      assume hr
      let GK(o2) := tr.gk(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb), v, P, w, o2)
      have rs := apply(tr.run_split_ks[bkp := zb. bkp(zb)], {s}, {C}, {t}, {o}, sM, spl, cl0, ct, hbc, hr)
      have ub2: tr.ub(s, v, P, w) -> GK(o) proof
        assume u
        show by defs(taut(u), tr.gk)
      qed
      // (a return reached at x: the caller's run stops there, or goes on)
      have atx: all x. tr.run_s(C, t, C, ok(x, empty)) -> o = ok(x, empty) -> GK(o) proof
        fix x
        assume hrx oe
        have c := mp(all_elim(rcl, {x}), hrx)
        have k2: tr.cl(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb), v, P, w, x) -> GK(o) proof
          assume hc
          have st := apply(tr.run_k_stop[bkp := zb. bkp(zb) || zb.rip = t], {s}, {C}, {x}, {empty}, rewrite(oe, hr))
          have ar := mp(expand(hc, tr.cl).1, st)
          have e2: ex m3. o = ok(m3, empty) && tr.arr(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb), v, m3, P, w)
            by ex_intro({x}, taut(oe, ar))
          show by defs(taut(e2), tr.gk)
        qed
        show by taut(c, ub2, k2)
      qed
      // (1) the caller's run is the callee's
      have b1: (ex o1. tr.run_s(C, t, C, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2))) -> GK(o) proof
        assume e
        obtain o1, hrc eo from e
        have mt2 := expand(mp(all_elim(ctr, {o1}), hrc), tr.mtv)
        have u1: tr.ub(C, VC, G, WC) -> GK(o) proof
          assume ra
          show := mp(ub2, mp(rub, ra))
        qed
        have u2: tr.crash(C, G, WC, o1) -> GK(o) proof
          assume ca
          have cr := apply(tr.callee_crash_m[b := b, g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {s}, {base}, {code}, {fr}, {m}, {w}, {v}, {regs}, {C}, {o1}, hi, hcf, hmm, co, c4, rg, hs, hgt, hA, veq, hk, hd, ca)
          obtain m2 a0 k0, {oe} from expand(cr, tr.crash)
          have nd: !(fst(o1) = 2) by simp(oe)
          have oe1: o1 = o by taut(eo, nd)
          have cr2 := rewrite(oe1, cr)
          show by defs(taut(cr2), tr.gk)
        qed
        have u3: (ex m1. o1 = ok(m1, empty) && tr.rtv(b, C, VC, G, WC, m1)) -> GK(o) proof
          assume eo2
          obtain m2, eo3 _ from eo2
          have nd: !(fst(o1) = 2) by simp(eo3)
          have oe1: o1 = o by taut(eo, nd)
          have oe: o = ok(m2, empty) := trans(sym(oe1), eo3)
          have hrx := rewrite(eo3, hrc)
          show := mp(all_elim(atx, {m2}), hrx, oe)
        qed
        // (the callee diverging: so does the caller's spec)
        have u4: tr.div(G, WC, o1) -> GK(o) proof
          assume dv
          have dv1 dv2 := expand(dv, tr.div)
          obtain t2, rd from dv2
          obtain t3, te from dv1
          have f1: fst(o1) = 2 by simp(te)
          have f0a: o1 = o -> fst(o) = 2 proof
            assume e5
            show := rewrite(e5, f1)
          qed
          have f0: fst(o) = 2 by taut(eo, f0a)
          obtain r0, _ rm0 from expand(hr, tr.run_k)
          have od := apply(tr.rmap_div, {r0}, {o}, rm0, f0)
          have rd2 := rewrite(veq, rd)
          have pu := apply(tr.spec_univ, {g}, {regs}, {W1}, {diverge(t2)}, hgt, hA, rd2)
          have t2u: t2 in univ(1) by simp(pu)
          have pd := apply(tr.gcall_div_m[b := b, g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {regs}, {t2}, wu, t2u, rg, hs, rd2, hd)
          have e2: ex t4. runs(P, w, diverge(t4)) by ex_intro({t2}, pd)
          have e3: ex t5. o = diverge(t5) by ex_intro({snd(r0)}, od)
          have d: tr.div(P, w, o) by defs(taut(e3, e2), tr.div)
          show by defs(taut(d), tr.gk)
        qed
        // (the callee stopping: not the caller's run -- its outcomes' values
        // empty)
        have u5: ks && tr.stv(b, G, WC, o1) -> GK(o) proof
          assume sa0
          have _ sa := sa0
          obtain m2 w3 v3 mem3, oe _ _ _ _ from expand(sa, tr.stv)
          have nd: !(fst(o1) = 2) by simp(oe)
          have oe1: o1 = o by taut(eo, nd)
          have ev := apply(tr.run_k_okv[bkp := zb. bkp(zb) || zb.rip = t], {s}, {C}, {m2}, {exc_val("stop", empty)}, rewrite(trans(sym(oe1), oe), hr))
          have f: false by taut(ev, tr.stop_ne)
          show by taut(f)
        qed
        show by taut(mt2, u1, u2, u3, u4, u5)
      qed
      // (2) the callee returned to x, the caller's run on from x
      have b2: (ex x r1 o1. tr.run_s(C, t, C, ok(x, empty)) && tr.rwk(s, zb. bkp(zb) || zb.rip = t, pair(x, empty), r1) && tr.rmap(r1, o1) &&
          (o1 = o || (fst(o1) = 2 && fst(o) = 2))) -> GK(o) proof
        assume e
        obtain x r1 o1, hrx hw1 hm1 eo from e
        have c := mp(all_elim(rcl, {x}), hrx)
        have k2: tr.cl(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb), v, P, w, x) -> GK(o) proof
          assume hc
          have g1 := apply(tr.cl_rwk[bkp := zb. bkp(zb) || zb.rip = t, bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {P}, {w}, {x}, {r1}, {o1}, hc, hw1, hm1)
          have same: o1 = o -> GK(o) proof
            assume e5
            show := rewrite(e5, g1)
          qed
          have divs: (fst(o1) = 2 && fst(o) = 2) -> GK(o) proof
            assume dd2
            have od1 := apply(tr.rmap_div, {r1}, {o1}, hm1, dd2.1)
            obtain r0, _ rm0 from expand(hr, tr.run_k)
            have od := apply(tr.rmap_div, {r0}, {o}, rm0, dd2.2)
            have g2 := apply(tr.gk_div[bkp := zb. bkp(zb) || zb.rip = t, bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {P}, {w}, {snd(r1)}, {snd(r0)}, rewrite(od1, g1))
            show := rewrite(sym(od), g2)
          qed
          show by taut(eo, same, divs)
        qed
        show by taut(c, ub2, k2)
      qed
      // (3) the callee leaving its discipline: its contract has it raise
      have b3: (ex x. tr.run_s(C, t, C, exc(x, exc_val("disc", empty)))) -> GK(o) proof
        assume ed
        obtain x, hx from ed
        have mt2 := expand(mp(all_elim(ctr, {exc(x, exc_val("disc", empty))}), hx), tr.mtv)
        have n1: (ex m1. exc(x, exc_val("disc", empty)) = ok(m1, empty) && tr.rtv(b, C, VC, G, WC, m1)) -> false proof
          assume eo
          obtain m2, eo2 _ from eo
          show by simp(eo2)
        qed
        have n2: tr.crash(C, G, WC, exc(x, exc_val("disc", empty))) -> false proof
          assume ca
          obtain m2 a0 k0, {oe} from expand(ca, tr.crash)
          show by simp(expand(oe, exc_val))
        qed
        have n3 := all_elim(tr.div_exc, {G}, {WC}, {x}, {exc_val("disc", empty)})
        have n4: tr.stv(b, G, WC, exc(x, exc_val("disc", empty))) -> false proof
          assume sa
          obtain m2 w3 v3 mem3, oe _ _ _ _ from expand(sa, tr.stv)
          show by simp(oe)
        qed
        have r3: tr.ub(C, VC, G, WC) by taut(mt2, n1, n2, n3, n4)
        show := mp(ub2, mp(rub, r3))
      qed
      // (4) the callee stopping at x (at t): the caller's run stops there,
      // the call raising at main in a view of x (its contract's stop)
      have b4: (ex x. tr.run_s(C, t, C, ok(x, exc_val("stop", empty))) && o = ok(x, empty) && tr.at_stop(C, t, x)) -> GK(o) proof
        assume e
        obtain x, hx oe xs from e
        have mt2 := expand(mp(all_elim(ctr, {ok(x, exc_val("stop", empty))}), hx), tr.mtv)
        have xt _ xlt := xs
        have u1: tr.ub(C, VC, G, WC) -> GK(o) proof
          assume ra
          show := mp(ub2, mp(rub, ra))
        qed
        have n1: (ex m1. ok(x, exc_val("stop", empty)) = ok(m1, empty) && tr.rtv(b, C, VC, G, WC, m1)) -> false proof
          assume eo
          obtain m2, eo2 _ from eo
          show by simp(eo2, tr.stop_ne)
        qed
        have n2: tr.crash(C, G, WC, ok(x, exc_val("stop", empty))) -> false proof
          assume ca
          obtain m2 a0 k0, {oe2 = oe} from expand(ca, tr.crash)
          show by simp(oe2)
        qed
        have n3 := all_elim(tr.div_ok, {G}, {WC}, {x}, {exc_val("stop", empty)})
        have u5: ks && tr.stv(b, G, WC, ok(x, exc_val("stop", empty))) -> GK(o) proof
          assume sa0
          have kk sa := sa0
          obtain m2 w3 v3 mem3, oe2 rs3 ru3 we3 vo3 from expand(sa, tr.stv)
          have mx: m2 = x by simp(oe2)
          // (the call raising at main, in the world the callee raised in)
          have eu: exc_val("at_main", empty) in univ(1) by defs(simp(), exc_val)
          have pe := mp(all_elim(rex, {w3}, {exc_val("at_main", empty)}), eu, ru3)
          have at1: ex w2 v2 mem2. abi.raise_state(w2) && runs(P, w, exc(w2, exc_val("at_main", empty))) && w2 = tr.vw(b, x, v2, mem2) && tr.vok(b, x, v2, mem2)
            by ex_intro({w3}, {v3}, {mem3}, taut(rs3, pe, rewrite(mx, we3), rewrite(mx, vo3)))
          have at: tr.at_tm(b, x, P, w) by defs(taut(at1), tr.at_tm)
          have rd: tr.red(P, w, P, w) proof
            have g: all o3. runs(P, w, o3) -> runs(P, w, o3) proof
              fix o3
              assume r3
              show := r3
            qed
            show by defs(g, tr.red)
          qed
          // (x below C's sp, so below s's: no return of the caller's)
          have no: !tr.out(s, x) by arith(xlt, spl)
          have ba := mp(all_elim(mp(hS, kk), {x}, {P}, {w}), xt, at)
          have ea: ex p2 w2. tr.red(P, w, p2, w2) && bka(x, p2, w2) by ex_intro({P}, {w}, taut(rd, ba))
          have ar: tr.arr(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb), v, x, P, w)
            by defs(taut(no, ea), tr.arr)
          have e2: ex m3. o = ok(m3, empty) && tr.arr(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb), v, m3, P, w)
            by ex_intro({x}, taut(oe, ar))
          show by defs(taut(e2), tr.gk)
        qed
        show by taut(mt2, u1, n1, n2, n3, u5)
      qed
      show by taut(rs, b1, b2, b3, b4)
    qed
    have sm: tr.sim(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb), v, P, w, C) by defs(g0, tr.sim)
    show := apply(tr.sim_cl[bkp := zb. bkp(zb) || zb.rip = t, bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {P}, {w}, {C}, nrC, nbC, sm)
  qed
  show by taut(bad, good)
qed

theorem tr.callee_sim_sm(b, g, args, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw, zb. bkp, zb pb wb. bka): all s v base code fr m w n hs fd RA T m1 e1 C cb cc st rs rc t ks.
  tr.hap(s, hs, v) -> tr.ofr(s, fr, v) ->
  tr.inv(s, base, code, fr, m, w) -> tr.cfr(fr) -> tr.mem(s, m, w, v) -> v.c_bytes = tr.cbm(b, s.fs_base) -> base in omega -> tr.regs(m, rs) -> tr.cs_sub(rc, rs) ->
  tr.args_in(m, args) -> seq_len(args) = n -> n in omega -> int_le(n, 6) -> RA in bits(64) -> T in bits(64) ->
  runs(x86_64_linux.touch_range(bits_sub(64, m.gpr[4], 8), 8, 1), fn_update(m, "rip", RA), ok(m1, e1)) ->
  C = fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, bits_sub(64, m.gpr[4], 8), 8, RA))),
    "gpr", fn_update(m1.gpr, 4, bits_sub(64, m.gpr[4], 8))), "rip", T) ->
  tr.ccs_m(b, fr, T, g, t, ks, cb, cc, st) -> !(T = t) -> (ks -> (all z p2 w2. z.rip = t -> tr.at_tm(b, z, p2, w2) -> bka(z, p2, w2))) ->
  (int_mod(fr, 16) = 8 -> tr.sal16(s)) -> abi.loaded(s.vm, cb, cc, st) -> cb in omega ->
  tr.homes(s, m, hs) -> tr.hin(hs, fr) -> fd in omega -> int_le(fd, int_add(fr, 8)) ->
  g in fn_space(abi.ARGS, powerset(univ(1))) -> tr.callee_io(g, n) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) -> (all t0. t0 in univ(1) -> runs(mkprog(x0 x1. ex x8. dd(t0, x8) && k(x8, x1)), w, diverge(t0))) ->
  (all w4 r0 r1. w4 in abi.World && w4 in univ(1) -> r0 in bits(64) -> r1 in bits(64) -> tr.pt(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb),
    v, base, code, fr, RA, hs, fd, fn_update(fn_update(rc, 0, pair(8, r0)), 2, pair(8, r1)),
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. a(x0, pair(r0, r1), x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w4)) ->
  (all z. int_lt(z.gpr[4], m.gpr[4]) -> !bkp(z)) ->
  tr.cl(s, zb. bkp(zb) || zb.rip = t, zb pb wb. bka(zb, pb, wb), v,
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gc.cm(b, g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, C)
proof
  fix s v base code fr m w n hs fd RA T m1 e1 C cb cc st rs rc t ks
  assume hap hofr hi hcf hmm hmn hb hrs hsub hargs hln hno hn6 hra ht htr hC himp htt hS hal hld hcb hhs hhin hfo hfd hgt hio hk hd hpost hbx
  have hc := mp(all_elim(tr.ccs_chc, {b}, {fr}, {C}, {T}, {g}, {n}, {v.live}, {t}, {ks}, {cb}, {cc}, {st}), himp)
  show := apply(tr.callee_sim_smc[b := b, g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2),
    bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {m}, {w}, {n}, {hs}, {fd}, {RA}, {T}, {m1}, {e1}, {C}, {cb}, {cc}, {st}, {rs}, {rc}, {t}, {ks},
    hap, hofr, hi, hcf, hmm, hmn, hb, hrs, hsub, hargs, hln, hno, hn6, hra, ht, htr, hC, hc, htt, hS, hal, hld, hcb, hhs, hhin, hfo, hfd, hgt, hio, hk, hd, hpost, hbx)
qed

// The claim by its breakpoints as a set (the same states) and its relation
// there (weakened)
theorem tr.cl_ext(zb. b1, zb. b2, zb pb wb. a1, zb pb wb. a2): all s v p w m. (all z. b1(z) -> b2(z)) -> (all z. b2(z) -> b1(z)) ->
  (all z p2 w2. a1(z, p2, w2) -> a2(z, p2, w2)) ->
  tr.cl(s, zb. b1(zb), zb pb wb. a1(zb, pb, wb), v, p, w, m) -> tr.cl(s, zb. b2(zb), zb pb wb. a2(zb, pb, wb), v, p, w, m)
proof
  fix s v p w m
  assume h12 h21 ha hc
  have sk: all z. tr.stopk(s, zb. b2(zb), z) -> tr.stopk(s, zb. b1(zb), z) proof
    fix z
    assume h
    show by defs(taut(expand(h, tr.stopk), all_elim(h21, {z})), tr.stopk)
  qed
  have ks: all z. tr.stopk(s, zb. b1(zb), z) -> tr.stopk(s, zb. b2(zb), z) proof
    fix z
    assume h
    show by defs(taut(expand(h, tr.stopk), all_elim(h12, {z})), tr.stopk)
  qed
  // (the runs: the same)
  have bm: all l o. tr.rbk(s, zb. b2(zb), l, o) -> tr.rbk(s, zb. b1(zb), l, o) proof
    fix l o
    assume h
    show by defs(taut(expand(h, tr.rbk), all_elim(sk, {fst(l)}), all_elim(ks, {fst(l)})), tr.rbk)
  qed
  have rk: all o. tr.run_k(s, zb. b2(zb), m, o) -> tr.run_k(s, zb. b1(zb), m, o) proof
    fix o
    assume h
    obtain r, hk hm from expand(h, tr.run_k)
    have c1: (ex l1. tr.rst(pair(m, empty), ok(l1, empty)) && tr.rwk(s, zb. b2(zb), l1, r)) -> tr.rk(s, zb. b1(zb), m, r) proof
      assume e
      obtain l1, h1 rw from e
      have w2 := mp(while_mono[l0 := l1, c := x5. true, b1 := x5 x6. tr.rbk(s, zb. b2(zb), x5, x6), b2 := x5 x6. tr.rbk(s, zb. b1(zb), x5, x6),
        tr := x5. fn_update(empty, "os.events", fst(x5).os.events), r := r], bm, expand(rw, tr.rwk))
      have rw2: tr.rwk(s, zb. b1(zb), l1, r) by defs(w2, tr.rwk)
      have e2: ex l2. tr.rst(pair(m, empty), ok(l2, empty)) && tr.rwk(s, zb. b1(zb), l2, r) by ex_intro({l1}, taut(h1, rw2))
      show by defs(taut(e2), tr.rk)
    qed
    have c2: tr.rst(pair(m, empty), r) && !is_ok(r) -> tr.rk(s, zb. b1(zb), m, r) proof
      assume h2
      show by defs(taut(h2), tr.rk)
    qed
    have k1: tr.rk(s, zb. b1(zb), m, r) by taut(expand(hk, tr.rk), c1, c2)
    show by defs(ex_intro({r}, taut(k1, hm)), tr.run_k)
  qed
  // (the outcomes: the arrivals' relation weakened)
  have ar: all x. tr.arr(s, zb. b1(zb), zb pb wb. a1(zb, pb, wb), v, x, p, w) -> tr.arr(s, zb. b2(zb), zb pb wb. a2(zb, pb, wb), v, x, p, w) proof
    fix x
    assume h
    have ho hb := expand(h, tr.arr)
    have nb: !tr.out(s, x) -> b2(x) -> (ex p2 w2. tr.red(p, w, p2, w2) && a2(x, p2, w2)) proof
      assume no bx
      obtain p2 w2, rd a from mp(hb, no, mp(all_elim(h21, {x}), bx))
      show by ex_intro({p2}, {w2}, taut(rd, mp(all_elim(ha, {x}, {p2}, {w2}), a)))
    qed
    show by defs(taut(ho, nb), tr.arr)
  qed
  have gk: all o. tr.gk(s, zb. b1(zb), zb pb wb. a1(zb, pb, wb), v, p, w, o) -> tr.gk(s, zb. b2(zb), zb pb wb. a2(zb, pb, wb), v, p, w, o) proof
    fix o
    assume h
    have c4: (ex m1. o = ok(m1, empty) && tr.arr(s, zb. b1(zb), zb pb wb. a1(zb, pb, wb), v, m1, p, w)) ->
        (ex m1. o = ok(m1, empty) && tr.arr(s, zb. b2(zb), zb pb wb. a2(zb, pb, wb), v, m1, p, w)) proof
      assume e
      obtain m1, oe a from e
      show by ex_intro({m1}, taut(oe, mp(all_elim(ar, {m1}), a)))
    qed
    show by defs(taut(expand(h, tr.gk), c4), tr.gk)
  qed
  have c1 c2 := expand(hc, tr.cl)
  have d1: tr.stopk(s, zb. b2(zb), m) -> tr.arr(s, zb. b2(zb), zb pb wb. a2(zb, pb, wb), v, m, p, w) proof
    assume h
    show := mp(all_elim(ar, {m}), mp(c1, mp(all_elim(sk, {m}), h)))
  qed
  have d2: !tr.stopk(s, zb. b2(zb), m) -> tr.sim(s, zb. b2(zb), zb pb wb. a2(zb, pb, wb), v, p, w, m) proof
    assume h
    have n1: !tr.stopk(s, zb. b1(zb), m) by taut(h, all_elim(ks, {m}))
    have sm := expand(mp(c2, n1), tr.sim)
    have g0: all o. tr.run_k(s, zb. b2(zb), m, o) -> tr.gk(s, zb. b2(zb), zb pb wb. a2(zb, pb, wb), v, p, w, o) proof
      fix o
      assume r
      show := mp(all_elim(gk, {o}), mp(all_elim(sm, {o}), mp(all_elim(rk, {o}), r)))
    qed
    show by defs(g0, tr.sim)
  qed
  show by defs(taut(d1, d2), tr.cl)
qed

// A spec main's call has (no contract for main): raising at main in the
// world it is called in, or undefined there (main's precondition failing)
def tr.raises_main(g) := all args w. w in abi.World -> w in univ(1) ->
  runs(g[args], w, exc(w, exc_val("at_main", empty))) || tr.may_raise(g, args, w)

// The call of main itself (T = t): the caller's run stops at the callee's
// entry, the call there raising at main (tr.at_t at C) -- for any
// breakpoints with t's, a relation holding at tr.at_t
theorem tr.call_mainm(b, g, args, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw, zb. B, zb pb wb. A): all s v base code fr m w n RA T m1 e1 C t.
  tr.ofr(s, fr, v) -> tr.inv(s, base, code, fr, m, w) -> tr.cfr(fr) -> tr.mem(s, m, w, v) -> v.c_bytes = tr.cbm(b, s.fs_base) ->
  tr.args_in(m, args) -> seq_len(args) = n -> n in omega -> int_le(n, 6) -> RA in bits(64) -> T in bits(64) ->
  runs(x86_64_linux.touch_range(bits_sub(64, m.gpr[4], 8), 8, 1), fn_update(m, "rip", RA), ok(m1, e1)) ->
  C = fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, bits_sub(64, m.gpr[4], 8), 8, RA))),
    "gpr", fn_update(m1.gpr, 4, bits_sub(64, m.gpr[4], 8))), "rip", T) ->
  T = t -> tr.raises_main(g) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) ->
  (all z. z.rip = t -> B(z)) -> (all z p2 w2. z.rip = t -> tr.at_tm(b, z, p2, w2) -> A(z, p2, w2)) ->
  tr.cl(s, zb. B(zb), zb pb wb. A(zb, pb, wb), v,
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gc.cm(b, g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, C)
proof
  fix s v base code fr m w n RA T m1 e1 C t
  assume hofr hi hcf hmm hmn hargs hln hno hn6 hra ht htr hC htt hrm hk hbt hat
  let P := mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gc.cm(b, g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))
  let R := m.gpr[4]
  let S := s.gpr[4]
  let regs := tr.aregs(m, n)
  have {sM, mM, wW, wu} := apply(tr.inv_call, hi)
  have {rb, r16, rlt, rss = rs, sb, slt} := apply(tr.call_rsp, hi, hcf)
  have cM cu co cf cc0 cgs cfl cgpr crip ckc cvf cle cpi cby cstk cacc := apply(tr.push_ok, {s}, {base}, {code}, {fr}, {m}, {w}, {RA}, {T}, {m1}, {e1}, {C}, hi, hcf, hra, ht, htr, hC)
  have c4: C.gpr[4] = int_sub(R, 8) by simp(cgpr)
  have sp8: abi.sp(s) = int_add(S, 8) by simp(sb, slt)
  have rg1 rg2 rg3 _ _ _ _ := apply(tr.aregs_ok, {m}, {args}, {n}, mM, hln, hno, hn6, hargs)
  have rg: gc.regs_ok(regs, args) := conj(rg1, rg2, rg3)
  have no: !tr.out(s, C) by arith(c4, sp8, rss, rb, r16)
  have ct: C.rip = t := trans(crip, htt)
  have rst: abi.raise_state(w) by defs(apply(tr.world_and, wW), abi.raise_state)
  have eu: empty in univ(1) by simp()
  // (the call undefined: so is the stop)
  have ubt: tr.ub(s, v, P, w) -> tr.at_tm(b, C, P, w) proof
    assume u
    have u2 := expand(u, tr.ub)
    show by defs(taut(u2), tr.at_tm)
  qed
  have ue: runs(P, w, exc(w, empty)) -> tr.at_tm(b, C, P, w) proof
    assume pe
    have u: tr.ub(s, v, P, w) by defs(ex_intro({empty}, {w}, taut(eu, tr.undef_empty, rst, pe)), tr.ub)
    show := mp(ubt, u)
  qed
  have bad: (b && !gc.sound(w)) -> tr.at_tm(b, C, P, w) proof
    assume hn
    have ub := apply(tr.gcall_ub_m[b := b, g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {s}, {v}, {w}, {regs}, wW, wu, rg, hn.1, hn.2, hk)
    show := mp(ubt, ub)
  qed
  // (the call raising at main in w, a view of C)
  have good: (b -> gc.sound(w)) -> tr.at_tm(b, C, P, w) proof
    assume hs
    have _ _ vok _ veq _ _ := apply(tr.callee_ready_m, {b}, {s}, {base}, {code}, {fr}, {m}, {w}, {v}, {RA}, {T}, {m1}, {e1}, {C}, {n}, hofr, hi, hcf, hmm, hmn, hra, ht, hno, hn6, htr, hC, hs)
    have hg := mp(all_elim(expand(hrm, tr.raises_main), {regs}, {w}), wW, wu)
    have am: runs(g[regs], w, exc(w, exc_val("at_main", empty))) -> tr.at_tm(b, C, P, w) proof
      assume rr
      have au: exc_val("at_main", empty) in univ(1) by defs(simp(), exc_val)
      have pe := apply(tr.gcall_exc_m[b := b, g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {regs}, {w}, {exc_val("at_main", empty)}, wu, wu, au, rg, hs, rr, hk)
      have e1: ex w2 v2 mem2. abi.raise_state(w2) && runs(P, w, exc(w2, exc_val("at_main", empty))) && w2 = tr.vw(b, C, v2, mem2) && tr.vok(b, C, v2, mem2)
        by ex_intro({w}, {v.live}, {w.vm}, taut(rst, pe, sym(veq), vok))
      show by defs(taut(e1), tr.at_tm)
    qed
    have mr: tr.may_raise(g, regs, w) -> tr.at_tm(b, C, P, w) proof
      assume hm
      have hx: all x e. x in univ(1) -> e in univ(1) -> runs(g[regs], w, exc(x, e)) by taut(expand(expand(hm, tr.may_raise), tr.undef))
      have rr := mp(all_elim(hx, {w}, {empty}), wu, eu)
      have pe := apply(tr.gcall_exc_m[b := b, g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {regs}, {w}, {empty}, wu, wu, eu, rg, hs, rr, hk)
      show := mp(ue, pe)
    qed
    show by taut(hg, am, mr)
  qed
  have rd: tr.red(P, w, P, w) proof
    have g0: all o3. runs(P, w, o3) -> runs(P, w, o3) proof
      fix o3
      assume r3
      show := r3
    qed
    show by defs(g0, tr.red)
  qed
  have at: tr.at_tm(b, C, P, w) by taut(bad, good)
  have ea: ex p2 w2. tr.red(P, w, p2, w2) && A(C, p2, w2) by ex_intro({P}, {w}, taut(rd, mp(all_elim(hat, {C}, {P}, {w}), ct, at)))
  have bc := mp(all_elim(hbt, {C}), ct)
  have ar: tr.arr(s, zb. B(zb), zb pb wb. A(zb, pb, wb), v, C, P, w) by defs(taut(no, ea), tr.arr)
  have sk: tr.stopk(s, zb. B(zb), C) by defs(taut(bc), tr.stopk)
  show by defs(taut(sk, ar), tr.cl)
qed

// The code map a call through a pointer uses (GIMPLE's `fptr`), at a call
// with n arguments from a frame of size fr: main at t raising at main, the
// other entries with their contracts in the stop form (an address not a
// function's: a spec undefined there, holding any contract)
def tr.code_ok(fptr, n, fr, t, cb, cc, st) := all T. T in bits(64) ->
  (T = t && tr.raises_main(fptr[T])) || (!(T = t) && tr.callee_contract_s(fr, T, fptr[T], t, true, cb, cc, st) && tr.callee_io(fptr[T], n))
// ... in the mode b
def tr.code_okm(b, fptr, n, fr, t, cb, cc, st) := all T. T in bits(64) ->
  (T = t && tr.raises_main(fptr[T])) || (!(T = t) && tr.ccs_m(b, fr, T, fptr[T], t, true, cb, cc, st) && tr.callee_io(fptr[T], n))

// (the main mode's: the generic one's)
theorem tr.code_ok_of: all fptr n fr t cb cc st. tr.code_ok(fptr, n, fr, t, cb, cc, st) -> tr.code_okm(true, fptr, n, fr, t, cb, cc, st)
proof
  fix fptr n fr t cb cc st
  assume h
  have g: all T. T in bits(64) ->
      (T = t && tr.raises_main(fptr[T])) || (!(T = t) && tr.ccs_m(true, fr, T, fptr[T], t, true, cb, cc, st) && tr.callee_io(fptr[T], n)) proof
    fix T
    assume hT
    have c := mp(all_elim(expand(h, tr.code_ok), {T}), hT)
    have k: !(T = t) && tr.callee_contract_s(fr, T, fptr[T], t, true, cb, cc, st) && tr.callee_io(fptr[T], n) ->
        !(T = t) && tr.ccs_m(true, fr, T, fptr[T], t, true, cb, cc, st) && tr.callee_io(fptr[T], n) proof
      assume h3
      show conj(h3.1, apply(tr.ccs_of, h3.2), h3.3)
    qed
    show by taut(c, k)
  qed
  show by defs(g, tr.code_okm)
qed

// (a spec undefined at a view: raising there)
theorem tr.undef_raises_at: all g args objs mem s. s in x86_64_linux.Machine -> s in univ(1) -> objs in set_type(omega) -> mem in x86_64_linux.Vm ->
  tr.may_raise(g, args, abi.view(s, objs, mem)) -> abi.raises_at(g, args, objs, mem, s)
proof
  fix g args objs mem s
  assume sM su ot mv hm
  have ou := apply(abi.objs_univ, ot)
  have mu := apply(x86.vm_univ, mv)
  have ocu := mp(all_elim(abi.objs_at_univ, {objs}, {s.fs_base}), ou)
  have vu: abi.view(s, objs, mem) in univ(1) by simp(su, ou, mu, ocu)
  have vW := apply(abi.world_typed, sM, ot, mv, vu)
  have rst: abi.raise_state(abi.view(s, objs, mem)) by defs(apply(tr.world_and, vW), abi.raise_state)
  have eu: empty in univ(1) by simp()
  have hx: all x e. x in univ(1) -> e in univ(1) -> runs(g[args], abi.view(s, objs, mem), exc(x, e)) by taut(expand(expand(hm, tr.may_raise), tr.undef))
  have pe := mp(all_elim(hx, {abi.view(s, objs, mem)}, {empty}), vu, eu)
  show by defs(ex_intro({empty}, {abi.view(s, objs, mem)}, taut(eu, tr.undef_empty, rst, pe)), abi.raises_at)
qed

// (an address no function's: its spec undefined, holding any contract)
theorem tr.undef_contract_s: all fr f g t k cb cc st n. (all args w. tr.may_raise(g, args, w)) ->
  tr.callee_contract_s(fr, f, g, t, k, cb, cc, st) && tr.callee_io(g, n)
proof
  fix fr f g t k cb cc st n
  assume hu
  have iu: tr.implements_stop_u(f, g, t, k, cb, cc, st) proof
    have g0: all args objs mem s o. args in abi.ARGS -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(s.vm, cb, cc, st) ->
        s.rip = f -> tr.entry_ok_u(s, args) -> tr.objs_ok(s, objs) -> abi.view_ok(s, objs, mem) -> tr.run_s(s, t, s, o) -> tr.matches_tk(g, args, objs, mem, s, o, k) proof
      fix args objs mem s o
      assume _ ot mv sM su _ _ _ _ _ _
      have ra := apply(tr.undef_raises_at, {g}, {args}, {objs}, {mem}, {s}, sM, su, ot, mv, all_elim(hu, {args}, {abi.view(s, objs, mem)}))
      show by defs(taut(ra), tr.matches_tk, tr.matches_t)
    qed
    show by defs(g0, tr.implements_stop_u)
  qed
  have io: tr.callee_io(g, n) proof
    have g1: all args w w2 r. ord_le(n, seq_len(args)) -> runs(g[args], w, ok(w2, r)) -> tr.returns_valid(w, w2) || tr.may_raise(g, args, w) proof
      fix args w w2 r
      assume _ _
      show by taut(all_elim(hu, {args}, {w}))
    qed
    show by defs(g1, tr.callee_io)
  qed
  show by defs(taut(iu, io), tr.callee_contract_s)
qed


// (a point's claim likewise)
theorem tr.pt_ext(zb. b1, zb. b2, zb pb wb. a1, zb pb wb. a2): all s v base code fr a hs fd rs p w. (all z. b1(z) -> b2(z)) -> (all z. b2(z) -> b1(z)) ->
  (all z p2 w2. a1(z, p2, w2) -> a2(z, p2, w2)) ->
  tr.pt(s, zb. b1(zb), zb pb wb. a1(zb, pb, wb), v, base, code, fr, a, hs, fd, rs, p, w) -> tr.pt(s, zb. b2(zb), zb pb wb. a2(zb, pb, wb), v, base, code, fr, a, hs, fd, rs, p, w)
proof
  fix s v base code fr a hs fd rs p w
  assume h12 h21 ha hp
  have g0: all m. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, fd) ->
      tr.cl(s, zb. b2(zb), zb pb wb. a2(zb, pb, wb), v, p, w, m) proof
    fix m
    assume i r h g e f
    have c := mp(all_elim(expand(hp, tr.pt), {m}), i, r, h, g, e, f)
    show := apply(tr.cl_ext[b1 := zb. b1(zb), b2 := zb. b2(zb), a1 := zb pb wb. a1(zb, pb, wb), a2 := zb pb wb. a2(zb, pb, wb)], {s}, {v}, {p}, {w}, {m}, h12, h21, ha, c)
  qed
  show by defs(g0, tr.pt)
qed

// The call rules for any breakpoints B with the stop at t among them (the
// callee's states below the frame no others) and a relation A there
// holding at a stop (tr.at_t): a direct call under the callee's contract
// in the stop form, a call through the code map
theorem tr.callee_sim_gmc(b, g, args, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw, zb. B, zb pb wb. A): all s v base code fr m w n hs fd RA T m1 e1 C cb cc st rs rc t ks.
  tr.hap(s, hs, v) -> tr.ofr(s, fr, v) ->
  tr.inv(s, base, code, fr, m, w) -> tr.cfr(fr) -> tr.mem(s, m, w, v) -> v.c_bytes = tr.cbm(b, s.fs_base) -> base in omega -> tr.regs(m, rs) -> tr.cs_sub(rc, rs) ->
  tr.args_in(m, args) -> seq_len(args) = n -> n in omega -> int_le(n, 6) -> RA in bits(64) -> T in bits(64) ->
  runs(x86_64_linux.touch_range(bits_sub(64, m.gpr[4], 8), 8, 1), fn_update(m, "rip", RA), ok(m1, e1)) ->
  C = fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, bits_sub(64, m.gpr[4], 8), 8, RA))),
    "gpr", fn_update(m1.gpr, 4, bits_sub(64, m.gpr[4], 8))), "rip", T) ->
  tr.chc(b, fr, C, T, g, n, v.live, t, ks, cb, cc, st) -> !(T = t) -> (int_mod(fr, 16) = 8 -> tr.sal16(s)) -> abi.loaded(s.vm, cb, cc, st) -> cb in omega ->
  tr.homes(s, m, hs) -> tr.hin(hs, fr) -> fd in omega -> int_le(fd, int_add(fr, 8)) ->
  g in fn_space(abi.ARGS, powerset(univ(1))) -> tr.callee_io(g, n) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) -> (all t0. t0 in univ(1) -> runs(mkprog(x0 x1. ex x8. dd(t0, x8) && k(x8, x1)), w, diverge(t0))) ->
  (all w4 r0 r1. w4 in abi.World && w4 in univ(1) -> r0 in bits(64) -> r1 in bits(64) -> tr.pt(s, zb. B(zb), zb pb wb. A(zb, pb, wb),
    v, base, code, fr, RA, hs, fd, fn_update(fn_update(rc, 0, pair(8, r0)), 2, pair(8, r1)),
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. a(x0, pair(r0, r1), x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w4)) ->
  (all z. z.rip = t -> B(z)) -> (all z. int_lt(z.gpr[4], m.gpr[4]) -> B(z) -> z.rip = t) -> (ks -> (all z p2 w2. z.rip = t -> tr.at_tm(b, z, p2, w2) -> A(z, p2, w2))) ->
  tr.cl(s, zb. B(zb), zb pb wb. A(zb, pb, wb), v,
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gc.cm(b, g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, C)
proof
  fix s v base code fr m w n hs fd RA T m1 e1 C cb cc st rs rc t ks
  assume hap hofr hi hcf hmm hmn hb hrs hsub hargs hln hno hn6 hra ht htr hC himp htt hal hld hcb hhs hhin hfo hfd hgt hio hk hd hpost hbt hbx hat
  // (B as the breakpoints apart from t's, and t's)
  have i1: all z. B(z) -> (B(z) && !(z.rip = t)) || z.rip = t proof
    fix z
    assume h
    show by taut(h)
  qed
  have i2: all z. (B(z) && !(z.rip = t)) || z.rip = t -> B(z) proof
    fix z
    assume h
    show by taut(h, all_elim(hbt, {z}))
  qed
  have jj: all z p2 w2. A(z, p2, w2) -> A(z, p2, w2) proof
    fix z p2 w2
    assume h
    show := h
  qed
  have hp2: all w4 r0 r1. w4 in abi.World && w4 in univ(1) -> r0 in bits(64) -> r1 in bits(64) ->
      tr.pt(s, zb. (B(zb) && !(zb.rip = t)) || zb.rip = t, zb pb wb. A(zb, pb, wb),
      v, base, code, fr, RA, hs, fd, fn_update(fn_update(rc, 0, pair(8, r0)), 2, pair(8, r1)),
      mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. a(x0, pair(r0, r1), x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w4) proof
    fix w4 r0 r1
    assume h1 h2 h3
    have pt := mp(all_elim(hpost, {w4}, {r0}, {r1}), h1, h2, h3)
    show := apply(tr.pt_ext[b1 := zb. B(zb), b2 := zb. (B(zb) && !(zb.rip = t)) || zb.rip = t, a1 := zb pb wb. A(zb, pb, wb), a2 := zb pb wb. A(zb, pb, wb)],
      {s}, {v}, {base}, {code}, {fr}, {RA}, {hs}, {fd}, {fn_update(fn_update(rc, 0, pair(8, r0)), 2, pair(8, r1))},
      {mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. a(x0, pair(r0, r1), x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))}, {w4}, i1, i2, jj, pt)
  qed
  have hb0: all z. int_lt(z.gpr[4], m.gpr[4]) -> !(B(z) && !(z.rip = t)) proof
    fix z
    assume lt
    show by taut(mp(all_elim(hbx, {z}), lt))
  qed
  have c := apply(tr.callee_sim_smc[b := b, g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2),
    bkp := zb. B(zb) && !(zb.rip = t), bka := zb pb wb. A(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {m}, {w}, {n}, {hs}, {fd}, {RA}, {T}, {m1}, {e1}, {C}, {cb}, {cc}, {st}, {rs}, {rc}, {t}, {ks},
    hap, hofr, hi, hcf, hmm, hmn, hb, hrs, hsub, hargs, hln, hno, hn6, hra, ht, htr, hC, himp, htt, hat, hal, hld, hcb, hhs, hhin, hfo, hfd, hgt, hio, hk, hd, hp2, hb0)
  show := apply(tr.cl_ext[b1 := zb. (B(zb) && !(zb.rip = t)) || zb.rip = t, b2 := zb. B(zb), a1 := zb pb wb. A(zb, pb, wb), a2 := zb pb wb. A(zb, pb, wb)],
    {s}, {v}, {mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gc.cm(b, g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))}, {w}, {C}, i2, i1, jj, c)
qed

theorem tr.callee_sim_gm(b, g, args, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw, zb. B, zb pb wb. A): all s v base code fr m w n hs fd RA T m1 e1 C cb cc st rs rc t ks.
  tr.hap(s, hs, v) -> tr.ofr(s, fr, v) ->
  tr.inv(s, base, code, fr, m, w) -> tr.cfr(fr) -> tr.mem(s, m, w, v) -> v.c_bytes = tr.cbm(b, s.fs_base) -> base in omega -> tr.regs(m, rs) -> tr.cs_sub(rc, rs) ->
  tr.args_in(m, args) -> seq_len(args) = n -> n in omega -> int_le(n, 6) -> RA in bits(64) -> T in bits(64) ->
  runs(x86_64_linux.touch_range(bits_sub(64, m.gpr[4], 8), 8, 1), fn_update(m, "rip", RA), ok(m1, e1)) ->
  C = fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, bits_sub(64, m.gpr[4], 8), 8, RA))),
    "gpr", fn_update(m1.gpr, 4, bits_sub(64, m.gpr[4], 8))), "rip", T) ->
  tr.ccs_m(b, fr, T, g, t, ks, cb, cc, st) -> !(T = t) -> (int_mod(fr, 16) = 8 -> tr.sal16(s)) -> abi.loaded(s.vm, cb, cc, st) -> cb in omega ->
  tr.homes(s, m, hs) -> tr.hin(hs, fr) -> fd in omega -> int_le(fd, int_add(fr, 8)) ->
  g in fn_space(abi.ARGS, powerset(univ(1))) -> tr.callee_io(g, n) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) -> (all t0. t0 in univ(1) -> runs(mkprog(x0 x1. ex x8. dd(t0, x8) && k(x8, x1)), w, diverge(t0))) ->
  (all w4 r0 r1. w4 in abi.World && w4 in univ(1) -> r0 in bits(64) -> r1 in bits(64) -> tr.pt(s, zb. B(zb), zb pb wb. A(zb, pb, wb),
    v, base, code, fr, RA, hs, fd, fn_update(fn_update(rc, 0, pair(8, r0)), 2, pair(8, r1)),
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. a(x0, pair(r0, r1), x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w4)) ->
  (all z. z.rip = t -> B(z)) -> (all z. int_lt(z.gpr[4], m.gpr[4]) -> B(z) -> z.rip = t) -> (ks -> (all z p2 w2. z.rip = t -> tr.at_tm(b, z, p2, w2) -> A(z, p2, w2))) ->
  tr.cl(s, zb. B(zb), zb pb wb. A(zb, pb, wb), v,
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gc.cm(b, g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, C)
proof
  fix s v base code fr m w n hs fd RA T m1 e1 C cb cc st rs rc t ks
  assume hap hofr hi hcf hmm hmn hb hrs hsub hargs hln hno hn6 hra ht htr hC himp htt hal hld hcb hhs hhin hfo hfd hgt hio hk hd hpost hbt hbx hat
  have hc := mp(all_elim(tr.ccs_chc, {b}, {fr}, {C}, {T}, {g}, {n}, {v.live}, {t}, {ks}, {cb}, {cc}, {st}), himp)
  show := apply(tr.callee_sim_gmc[b := b, g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2),
    B := zb. B(zb), A := zb pb wb. A(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {m}, {w}, {n}, {hs}, {fd}, {RA}, {T}, {m1}, {e1}, {C}, {cb}, {cc}, {st}, {rs}, {rc}, {t}, {ks},
    hap, hofr, hi, hcf, hmm, hmn, hb, hrs, hsub, hargs, hln, hno, hn6, hra, ht, htr, hC, hc, htt, hal, hld, hcb, hhs, hhin, hfo, hfd, hgt, hio, hk, hd, hpost, hbt, hbx, hat)
qed

theorem tr.callee_ind_gm(b, fptr, args, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw, zb. B, zb pb wb. A): all s v base code fr m w n hs fd RA T m1 e1 C cb cc st rs rc t.
  tr.hap(s, hs, v) -> tr.ofr(s, fr, v) ->
  tr.inv(s, base, code, fr, m, w) -> tr.cfr(fr) -> tr.mem(s, m, w, v) -> v.c_bytes = tr.cbm(b, s.fs_base) -> base in omega -> tr.regs(m, rs) -> tr.cs_sub(rc, rs) ->
  tr.args_in(m, args) -> seq_len(args) = n -> n in omega -> int_le(n, 6) -> RA in bits(64) -> T in bits(64) ->
  runs(x86_64_linux.touch_range(bits_sub(64, m.gpr[4], 8), 8, 1), fn_update(m, "rip", RA), ok(m1, e1)) ->
  C = fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, bits_sub(64, m.gpr[4], 8), 8, RA))),
    "gpr", fn_update(m1.gpr, 4, bits_sub(64, m.gpr[4], 8))), "rip", T) ->
  tr.code_okm(b, fptr, n, fr, t, cb, cc, st) -> (int_mod(fr, 16) = 8 -> tr.sal16(s)) -> abi.loaded(s.vm, cb, cc, st) -> cb in omega ->
  tr.homes(s, m, hs) -> tr.hin(hs, fr) -> fd in omega -> int_le(fd, int_add(fr, 8)) ->
  fptr in fn_space(bits(64), fn_space(abi.ARGS, powerset(univ(1)))) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) -> (all t0. t0 in univ(1) -> runs(mkprog(x0 x1. ex x8. dd(t0, x8) && k(x8, x1)), w, diverge(t0))) ->
  (all w4 r0 r1. w4 in abi.World && w4 in univ(1) -> r0 in bits(64) -> r1 in bits(64) -> tr.pt(s, zb. B(zb), zb pb wb. A(zb, pb, wb),
    v, base, code, fr, RA, hs, fd, fn_update(fn_update(rc, 0, pair(8, r0)), 2, pair(8, r1)),
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. a(x0, pair(r0, r1), x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w4)) ->
  (all z. z.rip = t -> B(z)) -> (all z. int_lt(z.gpr[4], m.gpr[4]) -> B(z) -> z.rip = t) -> (all z p2 w2. z.rip = t -> tr.at_tm(b, z, p2, w2) -> A(z, p2, w2)) ->
  tr.cl(s, zb. B(zb), zb pb wb. A(zb, pb, wb), v,
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gc.cm(b, fptr[T], args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, C)
proof
  fix s v base code fr m w n hs fd RA T m1 e1 C cb cc st rs rc t
  assume hap hofr hi hcf hmm hmn hb hrs hsub hargs hln hno hn6 hra ht htr hC hcode hal hld hcb hhs hhin hfo hfd hft hk hd hpost hbt hbx hat
  let G := fptr[T]
  have hc := mp(all_elim(expand(hcode, tr.code_okm), {T}), ht)
  let GL := tr.cl(s, zb. B(zb), zb pb wb. A(zb, pb, wb), v,
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gc.cm(b, G, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, C)
  // (main: the run stops at its entry)
  have c1: (T = t && tr.raises_main(G)) -> GL proof
    assume h
    show := apply(tr.call_mainm[b := b, g := G, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2),
      B := zb. B(zb), A := zb pb wb. A(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {m}, {w}, {n}, {RA}, {T}, {m1}, {e1}, {C}, {t},
      hofr, hi, hcf, hmm, hmn, hargs, hln, hno, hn6, hra, ht, htr, hC, (T = t by taut(h)), (tr.raises_main(G) by taut(h)), hk, hbt, hat)
  qed
  // (another entry: its contract, with the stop)
  have c2: (!(T = t) && tr.ccs_m(b, fr, T, G, t, true, cb, cc, st) && tr.callee_io(G, n)) -> GL proof
    assume h
    have gt: G in fn_space(abi.ARGS, powerset(univ(1))) := mp(fn_space_app[a := bits(64), b := fn_space(abi.ARGS, powerset(univ(1))), f := fptr, x := T], hft, ht)
    have hat1: true -> (all z p2 w2. z.rip = t -> tr.at_tm(b, z, p2, w2) -> A(z, p2, w2)) proof
      assume _
      show := hat
    qed
    show := apply(tr.callee_sim_gm[b := b, g := G, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2),
      B := zb. B(zb), A := zb pb wb. A(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {m}, {w}, {n}, {hs}, {fd}, {RA}, {T}, {m1}, {e1}, {C}, {cb}, {cc}, {st}, {rs}, {rc}, {t}, {true},
      hap, hofr, hi, hcf, hmm, hmn, hb, hrs, hsub, hargs, hln, hno, hn6, hra, ht, htr, hC, (tr.ccs_m(b, fr, T, G, t, true, cb, cc, st) by taut(h)), (!(T = t) by taut(h)),
      hal, hld, hcb, hhs, hhin, hfo, hfd, gt, (tr.callee_io(G, n) by taut(h)), hk, hd, hpost, hbt, hbx, hat1)
  qed
  show by taut(hc, c1, c2)
qed

// ----------------------------------------------------------------------
//  The contract from the claim at the entry, the stop allowed (k: the
//  relation at t tr.at_t) or not (never stopping: the relation false)

theorem tr.entry_sk: all spec args s v mem o t k. s in x86_64_linux.Machine -> int_lt(s.gpr[4], 140737488355328) -> !(s.rip = t) ->
  tr.sim(s, zb. zb.rip = t, zb pb wb. k && tr.at_t(zb, pb, wb), abi.wob(v, abi.cbytes0(s.fs_base)), spec[args], abi.view(s, v, mem), s) -> tr.run_s(s, t, s, o) ->
  tr.matches_tk(spec, args, v, mem, s, o, k)
proof
  fix spec args s v mem o t k
  assume hM hsl hnt h rd
  let P := spec[args]
  let W := abi.view(s, v, mem)
  let V := abi.wob(v, abi.cbytes0(s.fs_base))
  have r4 := apply(x86i.rsp_typed, hM)
  have lt := apply(tr.sp_lt, {s.gpr[4]}, r4, hsl)
  // (the claim with the stop's relation the generic one's: tr.at_tm(true, ..))
  have c := apply(tr.sim_cl[bkp := zb. zb.rip = t, bka := zb pb wb. k && tr.at_t(zb, pb, wb)], {s}, {V}, {P}, {W}, {s}, lt, hnt, h)
  have i: all z. z.rip = t -> z.rip = t proof
    fix z
    assume e
    show := e
  qed
  have j: all z p2 w2. k && tr.at_t(z, p2, w2) -> k && tr.at_tm(true, z, p2, w2) proof
    fix z p2 w2
    assume e
    show by taut(e, all_elim(tr.at_tm_t, {z}, {p2}, {w2}))
  qed
  have c2 := apply(tr.cl_ext[b1 := zb. zb.rip = t, b2 := zb. zb.rip = t, a1 := zb pb wb. k && tr.at_t(zb, pb, wb), a2 := zb pb wb. k && tr.at_tm(true, zb, pb, wb)], {s}, {V}, {P}, {W}, {s}, i, i, j, c)
  have ns: !tr.stopk(s, zb. zb.rip = t, s) by defs(taut(lt, hnt), tr.stopk)
  have h2 := mp(expand(c2, tr.cl).2, ns)
  have bm: true -> tr.mainv(s, V) by simp()
  have m := apply(tr.entry_skm, {true}, {P}, {W}, {s}, {V}, {o}, {t}, {k}, hM, hsl, hnt, bm, h2, rd)
  show := apply(tr.mt_to, m)
qed

// (tr.entry_gk's premises for these: the claim at the entry f, not t; the
// undefined spec matching)
theorem tr.fin_k: all t f k. !(f = t) -> (all spec args s v mem o. s in x86_64_linux.Machine -> int_lt(s.gpr[4], 140737488355328) -> s.rip = f ->
  tr.sim(s, zb. zb.rip = t, zb pb wb. k && tr.at_t(zb, pb, wb), abi.wob(v, abi.cbytes0(s.fs_base)), spec[args], abi.view(s, v, mem), s) -> tr.run_s(s, t, s, o) -> tr.matches_tk(spec, args, v, mem, s, o, k))
proof
  fix t f k
  assume hft
  fix spec args s v mem o
  assume hM hsl hrip h rd
  have nt: !(s.rip = t) := rewrite(sym(hrip), hft)
  show := apply(tr.entry_sk, {spec}, {args}, {s}, {v}, {mem}, {o}, {t}, {k}, hM, hsl, nt, h, rd)
qed

// (... in the mode b: tr.entry_gkm's premises)
theorem tr.fin_km: all b t f k. !(f = t) -> (all spec args s v mem o. s in x86_64_linux.Machine -> int_lt(s.gpr[4], 140737488355328) -> s.rip = f ->
  tr.sim(s, zb. zb.rip = t, zb pb wb. k && tr.at_tm(b, zb, pb, wb), abi.wob(v, tr.cbm(b, s.fs_base)), spec[args], tr.vw(b, s, v, mem), s) -> tr.run_s(s, t, s, o) ->
  tr.mtv(b, s, abi.wob(v, tr.cbm(b, s.fs_base)), spec[args], tr.vw(b, s, v, mem), o, k))
proof
  fix b t f k
  assume hft
  fix spec args s v mem o
  assume hM hsl hrip h rd
  have nt: !(s.rip = t) := rewrite(sym(hrip), hft)
  have bm: b -> tr.mainv(s, abi.wob(v, tr.cbm(b, s.fs_base))) proof
    assume hb
    have e := mp(ite_t[c := b, a := abi.cbytes0(s.fs_base), b := abi.cball], hb)
    show by simp(e)
  qed
  show := apply(tr.entry_skm, {b}, {spec[args]}, {tr.vw(b, s, v, mem)}, {s}, {abi.wob(v, tr.cbm(b, s.fs_base))}, {o}, {t}, {k}, hM, hsl, nt, bm, h, rd)
qed

theorem tr.ub_km(b, k): all spec args s v mem o. tr.ub(s, abi.wob(v, tr.cbm(b, s.fs_base)), spec[args], tr.vw(b, s, v, mem)) ->
  tr.mtv(b, s, abi.wob(v, tr.cbm(b, s.fs_base)), spec[args], tr.vw(b, s, v, mem), o, k)
proof
  fix spec args s v mem o
  assume h
  show by defs(taut(h), tr.mtv)
qed

theorem tr.ub_k(k): all spec args s v mem o. abi.raises_at(spec, args, v, mem, s) -> tr.matches_tk(spec, args, v, mem, s, o, k)
proof
  fix spec args s v mem o
  assume h
  show by defs(taut(h), tr.matches_tk, tr.matches_t)
qed

// ----------------------------------------------------------------------
//  The call instructions with t among the breakpoints (as tr.call;
//  tr.call_st, tr.calli_st): `call
//  rel32` under the callee's contract with the stop at t (ks) or never
//  stopping; `call *%gr` through the code map

// (the same, the callee's claim at every entry the call makes)
theorem tr.call_stmc(b, s, v, base, code, fr, a, a2, len, off, f, g, args, n, cb, cc, st, hs, ds, fd2, rs, rc, w, t, ks, x9 x10 x8. ka, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw, zb. bkp, zb pb wb. bka):
  v.c_bytes = tr.cbm(b, s.fs_base) -> tr.ofr(s, fr, v) -> tr.hap(s, hs, v) ->
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a -> runs(x86_64_linux.exec_body(len, tag(120, off)), m, o)) ->
  a2 = bits_add(64, a, bits_of_int(64, len)) -> off in bits(32) -> base in omega ->
  f = bits_add(64, a2, bits_sext(32, 64, off)) -> (all m m1 e1 C. tr.inv(s, base, code, fr, m, w) -> tr.homes(s, m, hs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.touch_range(bits_sub(64, m.gpr[4], 8), 8, 1), fn_update(m, "rip", a2), ok(m1, e1)) -> C = fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, bits_sub(64, m.gpr[4], 8), 8, a2))), "gpr", fn_update(m1.gpr, 4, bits_sub(64, m.gpr[4], 8))), "rip", f) -> tr.chc(b, fr, C, f, g, n, v.live, t, ks, cb, cc, st)) -> !(f = t) -> (int_mod(fr, 16) = 8 -> tr.sal16(s)) -> abi.loaded(s.vm, cb, cc, st) -> cb in omega ->
  tr.cfr(fr) -> seq_len(args) = n -> n in omega -> int_le(n, 6) ->
  g in fn_space(abi.ARGS, powerset(univ(1))) -> tr.callee_io(g, n) ->
  (all m. tr.regs(m, rs) -> tr.args_in(m, args)) -> tr.cs_sub(rc, rs) -> tr.hin(hs, fr) -> fd2 in omega -> int_le(fd2, int_add(fr, 8)) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) ->
  (all t0. t0 in univ(1) -> runs(mkprog(x0 x1. ex x8. dd(t0, x8) && k(x8, x1)), w, diverge(t0))) ->
  (all w4 r0 r1. w4 in abi.World && w4 in univ(1) -> r0 in bits(64) -> r1 in bits(64) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, fd2, fn_update(fn_update(rc, 0, pair(8, r0)), 2, pair(8, r1)),
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. ka(x0, pair(r0, r1), x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w4)) ->
  (all z. z.rip = t -> bkp(z)) -> (all z. int_lt(z.gpr[4], int_sub(s.gpr[4], fr)) -> bkp(z) -> z.rip = t) -> (ks -> (all z p2 w2. z.rip = t -> tr.at_tm(b, z, p2, w2) -> bka(z, p2, w2))) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gc.cm(b, g, args), x0, x9 x10. ka(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w)
proof
  assume hmn hofr hap hat ha2 hoff hb hf himp hft hal hld hcb hcf hln hno hn6 hgt hio hreg hsub hhin hfo hfd hk hd hpost hbt hbf hat2
  have a2b: a2 in bits(64) by simp(ha2)
  have hst := apply(tr.push_rel[s := s, base := base, code := code, fr := fr, a := a, a2 := a2, len := len, off := off, f := f, rs := rs, w := w], hat, ha2, hoff, hf, hcf)
  have hcl: all m m1 e1 C. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, ds) ->
      runs(x86_64_linux.touch_range(bits_sub(64, m.gpr[4], 8), 8, 1), fn_update(m, "rip", a2), ok(m1, e1)) ->
      C = fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, bits_sub(64, m.gpr[4], 8), 8, a2))),
        "gpr", fn_update(m1.gpr, 4, bits_sub(64, m.gpr[4], 8))), "rip", f) ->
      tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gc.cm(b, g, args), x0, x9 x10. ka(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
        x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, C) proof
    fix m m1 e1 C
    assume hi hr hh hrs hmm hfr tr2 hC2
    have hin := mp(all_elim(hreg, {m}), hrs)
    have tb: f in bits(64) by simp(hf)
    have hbm: all z. int_lt(z.gpr[4], m.gpr[4]) -> bkp(z) -> z.rip = t proof
      fix z
      assume lt
      have rspm := apply(tr.inv_parts, hi).4
      show := mp(all_elim(hbf, {z}), rewrite(rspm, lt))
    qed
    show := apply(tr.callee_sim_gmc[b := b, g := g, args := args, a := x9 x10 x8. ka(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2),
      B := zb. bkp(zb), A := zb pb wb. bka(zb, pb, wb)],
      {s}, {v}, {base}, {code}, {fr}, {m}, {w}, {n}, {hs}, {fd2}, {a2}, {f}, {m1}, {e1}, {C}, {cb}, {cc}, {st}, {rs}, {rc}, {t}, {ks}, hap, hofr,
      hi, hcf, hmm, hmn, hb, hrs, hsub, hin, hln, hno, hn6, a2b, tb, tr2, hC2, mp(all_elim(himp, {m}, {m1}, {e1}, {C}), hi, hh, hmm, tr2, hC2), hft, hal, hld, hcb, hh, hhin, hfo, hfd, hgt, hio, hk, hd, hpost, hbt, hbm, hat2)
  qed
  show := apply(tr.call_gm[b := b, s := s, v := v, base := base, code := code, fr := fr, a := a, a2 := a2, T := f, g := g, args := args, hs := hs, ds := ds, rs := rs, w := w,
    ka := x9 x10 x8. ka(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2),
    bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], hst, a2b, hcf, hk, hcl)
qed

theorem tr.call_stm(b, s, v, base, code, fr, a, a2, len, off, f, g, args, n, cb, cc, st, hs, ds, fd2, rs, rc, w, t, ks, x9 x10 x8. ka, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw, zb. bkp, zb pb wb. bka):
  v.c_bytes = tr.cbm(b, s.fs_base) -> tr.ofr(s, fr, v) -> tr.hap(s, hs, v) ->
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a -> runs(x86_64_linux.exec_body(len, tag(120, off)), m, o)) ->
  a2 = bits_add(64, a, bits_of_int(64, len)) -> off in bits(32) -> base in omega ->
  f = bits_add(64, a2, bits_sext(32, 64, off)) -> tr.ccs_m(b, fr, f, g, t, ks, cb, cc, st) -> !(f = t) -> (int_mod(fr, 16) = 8 -> tr.sal16(s)) -> abi.loaded(s.vm, cb, cc, st) -> cb in omega ->
  tr.cfr(fr) -> seq_len(args) = n -> n in omega -> int_le(n, 6) ->
  g in fn_space(abi.ARGS, powerset(univ(1))) -> tr.callee_io(g, n) ->
  (all m. tr.regs(m, rs) -> tr.args_in(m, args)) -> tr.cs_sub(rc, rs) -> tr.hin(hs, fr) -> fd2 in omega -> int_le(fd2, int_add(fr, 8)) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) ->
  (all t0. t0 in univ(1) -> runs(mkprog(x0 x1. ex x8. dd(t0, x8) && k(x8, x1)), w, diverge(t0))) ->
  (all w4 r0 r1. w4 in abi.World && w4 in univ(1) -> r0 in bits(64) -> r1 in bits(64) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, fd2, fn_update(fn_update(rc, 0, pair(8, r0)), 2, pair(8, r1)),
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. ka(x0, pair(r0, r1), x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w4)) ->
  (all z. z.rip = t -> bkp(z)) -> (all z. int_lt(z.gpr[4], int_sub(s.gpr[4], fr)) -> bkp(z) -> z.rip = t) -> (ks -> (all z p2 w2. z.rip = t -> tr.at_tm(b, z, p2, w2) -> bka(z, p2, w2))) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gc.cm(b, g, args), x0, x9 x10. ka(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w)
proof
  assume hmn hofr hap hat ha2 hoff hb hf himp hft hal hld hcb hcf hln hno hn6 hgt hio hreg hsub hhin hfo hfd hk hd hpost hbt hbf hat2
  have hc: all m m1 e1 C. tr.inv(s, base, code, fr, m, w) -> tr.homes(s, m, hs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.touch_range(bits_sub(64, m.gpr[4], 8), 8, 1), fn_update(m, "rip", a2), ok(m1, e1)) -> C = fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, bits_sub(64, m.gpr[4], 8), 8, a2))), "gpr", fn_update(m1.gpr, 4, bits_sub(64, m.gpr[4], 8))), "rip", f) -> tr.chc(b, fr, C, f, g, n, v.live, t, ks, cb, cc, st) proof
    fix m m1 e1 C
    assume _ _ _ _ _
    show := mp(all_elim(tr.ccs_chc, {b}, {fr}, {C}, {f}, {g}, {n}, {v.live}, {t}, {ks}, {cb}, {cc}, {st}), himp)
  qed
  show := mp(tr.call_stmc[b := b, s := s, v := v, base := base, code := code, fr := fr, a := a, a2 := a2, len := len, off := off, f := f, g := g, args := args, n := n, cb := cb, cc := cc, st := st,
    hs := hs, ds := ds, fd2 := fd2, rs := rs, rc := rc, w := w, t := t, ks := ks, ka := x9 x10 x8. ka(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2),
    bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], hmn, hofr, hap, hat, ha2, hoff, hb, hf, hc, hft, hal, hld, hcb, hcf, hln, hno, hn6, hgt, hio, hreg, hsub, hhin, hfo, hfd, hk, hd, hpost, hbt, hbf, hat2)
qed

theorem tr.calli_stm(b, s, v, base, code, fr, a, a2, len, gr, z, nb, T, fptr, args, n, cb, cc, st, hs, ds, fd2, rs, rc, w, t, x9 x10 x8. ka, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw, zb. bkp, zb pb wb. bka):
  v.c_bytes = tr.cbm(b, s.fs_base) -> tr.ofr(s, fr, v) -> tr.hap(s, hs, v) ->
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a -> runs(x86_64_linux.exec_body(len, tag(121, pair(tag(0, gr), z))), m, o)) ->
  a2 = bits_add(64, a, bits_of_int(64, len)) -> gr in x86_64_linux.Reg -> gr in dom(rs) -> rs[gr] = pair(nb, T) -> T in bits(64) -> base in omega ->
  tr.code_okm(b, fptr, n, fr, t, cb, cc, st) -> (int_mod(fr, 16) = 8 -> tr.sal16(s)) -> abi.loaded(s.vm, cb, cc, st) -> cb in omega ->
  tr.cfr(fr) -> seq_len(args) = n -> n in omega -> int_le(n, 6) ->
  fptr in fn_space(bits(64), fn_space(abi.ARGS, powerset(univ(1)))) ->
  (all m. tr.regs(m, rs) -> tr.args_in(m, args)) -> tr.cs_sub(rc, rs) -> tr.hin(hs, fr) -> fd2 in omega -> int_le(fd2, int_add(fr, 8)) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) ->
  (all t0. t0 in univ(1) -> runs(mkprog(x0 x1. ex x8. dd(t0, x8) && k(x8, x1)), w, diverge(t0))) ->
  (all w4 r0 r1. w4 in abi.World && w4 in univ(1) -> r0 in bits(64) -> r1 in bits(64) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, fd2, fn_update(fn_update(rc, 0, pair(8, r0)), 2, pair(8, r1)),
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. ka(x0, pair(r0, r1), x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w4)) ->
  (all z. z.rip = t -> bkp(z)) -> (all z. int_lt(z.gpr[4], int_sub(s.gpr[4], fr)) -> bkp(z) -> z.rip = t) -> (all z p2 w2. z.rip = t -> tr.at_tm(b, z, p2, w2) -> bka(z, p2, w2)) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gc.cm(b, fptr[T], args), x0, x9 x10. ka(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w)
proof
  assume hmn hofr hap hat ha2 hg hgd hgu htb hb hcode hal hld hcb hcf hln hno hn6 hft hreg hsub hhin hfo hfd hk hd hpost hbt hbf hat2
  have a2b: a2 in bits(64) by simp(ha2)
  have hst := apply(tr.push_reg[s := s, base := base, code := code, fr := fr, a := a, a2 := a2, len := len, g := gr, z := z, nb := nb, T := T, rs := rs, w := w], hat, ha2, hg, hgd, hgu, hcf)
  have hcl: all m m1 e1 C. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, ds) ->
      runs(x86_64_linux.touch_range(bits_sub(64, m.gpr[4], 8), 8, 1), fn_update(m, "rip", a2), ok(m1, e1)) ->
      C = fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, bits_sub(64, m.gpr[4], 8), 8, a2))),
        "gpr", fn_update(m1.gpr, 4, bits_sub(64, m.gpr[4], 8))), "rip", T) ->
      tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gc.cm(b, fptr[T], args), x0, x9 x10. ka(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
        x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, C) proof
    fix m m1 e1 C
    assume hi hr hh hrs hmm hfr tr2 hC2
    have hin := mp(all_elim(hreg, {m}), hrs)
    have hbm: all z. int_lt(z.gpr[4], m.gpr[4]) -> bkp(z) -> z.rip = t proof
      fix z
      assume lt
      have rspm := apply(tr.inv_parts, hi).4
      show := mp(all_elim(hbf, {z}), rewrite(rspm, lt))
    qed
    show := apply(tr.callee_ind_gm[b := b, fptr := fptr, args := args, a := x9 x10 x8. ka(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2),
      B := zb. bkp(zb), A := zb pb wb. bka(zb, pb, wb)],
      {s}, {v}, {base}, {code}, {fr}, {m}, {w}, {n}, {hs}, {fd2}, {a2}, {T}, {m1}, {e1}, {C}, {cb}, {cc}, {st}, {rs}, {rc}, {t}, hap, hofr,
      hi, hcf, hmm, hmn, hb, hrs, hsub, hin, hln, hno, hn6, a2b, htb, tr2, hC2, hcode, hal, hld, hcb, hh, hhin, hfo, hfd, hft, hk, hd, hpost, hbt, hbm, hat2)
  qed
  show := apply(tr.call_gm[b := b, s := s, v := v, base := base, code := code, fr := fr, a := a, a2 := a2, T := T, g := fptr[T], args := args, hs := hs, ds := ds, rs := rs, w := w,
    ka := x9 x10 x8. ka(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2),
    bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], hst, a2b, hcf, hk, hcl)
qed

// (one result: as tr.call1)
theorem tr.call1_stm(b, s, v, base, code, fr, a, a2, len, off, f, g, args, n, cb, cc, st, hs, ds, fd2, rs, rc, w, t, ks, x9 x10 x8. ka, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw, zb. bkp, zb pb wb. bka):
  v.c_bytes = tr.cbm(b, s.fs_base) -> tr.hap(s, hs, v) -> tr.ofr(s, fr, v) ->
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a -> runs(x86_64_linux.exec_body(len, tag(120, off)), m, o)) ->
  a2 = bits_add(64, a, bits_of_int(64, len)) -> off in bits(32) -> base in omega ->
  f = bits_add(64, a2, bits_sext(32, 64, off)) -> tr.ccs_m(b, fr, f, g, t, ks, cb, cc, st) -> !(f = t) -> (int_mod(fr, 16) = 8 -> tr.sal16(s)) -> abi.loaded(s.vm, cb, cc, st) -> cb in omega ->
  tr.cfr(fr) -> seq_len(args) = n -> n in omega -> int_le(n, 6) ->
  g in fn_space(abi.ARGS, powerset(univ(1))) -> tr.callee_io(g, n) ->
  (all m. tr.regs(m, rs) -> tr.args_in(m, args)) -> tr.cs_sub(rc, rs) -> tr.hin(hs, fr) -> fd2 in omega -> int_le(fd2, int_add(fr, 8)) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) ->
  (all t0. t0 in univ(1) -> runs(mkprog(x0 x1. ex x8. dd(t0, x8) && k(x8, x1)), w, diverge(t0))) ->
  (all w4 r0. w4 in abi.World && w4 in univ(1) -> r0 in bits(64) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, fd2, fn_update(rc, 0, pair(8, r0)),
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. ka(x0, r0, x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w4)) ->
  (all z. z.rip = t -> bkp(z)) -> (all z. int_lt(z.gpr[4], int_sub(s.gpr[4], fr)) -> bkp(z) -> z.rip = t) -> (ks -> (all z p2 w2. z.rip = t -> tr.at_tm(b, z, p2, w2) -> bka(z, p2, w2))) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gc.c1m(b, g, args), x0, x9 x10. ka(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w)
proof
  assume hmn hap hofr hat ha2 hoff hb hf himp hft hal hld hcb hcf hln hno hn6 hgt hio hreg hsub hhin hfo hfd hk hd hpost hbt hbf hat2
  have hcl: (all w4 r0 r1. w4 in abi.World && w4 in univ(1) -> r0 in bits(64) -> r1 in bits(64) ->
      tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, fd2, fn_update(fn_update(rc, 0, pair(8, r0)), 2, pair(8, r1)), mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. ka(x0, fst(pair(r0, r1)), x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w4)) ->
      tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gc.cm(b, g, args), x0, x9 x10. ka(x9, fst(x10), x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
        x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w) proof
    assume post
    show := mp(tr.call_stm[b := b, bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb), s := s, v := v, base := base, code := code, fr := fr, a := a, a2 := a2, len := len, off := off, f := f, g := g, args := args, n := n, cb := cb, cc := cc, st := st,
      hs := hs, ds := ds, fd2 := fd2, rs := rs, rc := rc, w := w, t := t, ks := ks, ka := x9 x10 x8. ka(x9, fst(x10), x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], hmn, hofr, hap,
      hat, ha2, hoff, hb, hf, himp, hft, hal, hld, hcb, hcf, hln, hno, hn6, hgt, hio, hreg, hsub, hhin, hfo, hfd, hk, hd, post, hbt, hbf, hat2)
  qed
  show := apply(tr.call1_of_m[b := b, s := s, v := v, base := base, code := code, fr := fr, a := a, a2 := a2, g := g, args := args, hs := hs, ds := ds, fd2 := fd2, rs := rs, rc := rc, w := w,
    ka := x9 x10 x8. ka(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2), bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], hsub, hpost, hcl)
qed

theorem tr.calli1_stm(b, s, v, base, code, fr, a, a2, len, gr, z, nb, T, fptr, args, n, cb, cc, st, hs, ds, fd2, rs, rc, w, t, x9 x10 x8. ka, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw, zb. bkp, zb pb wb. bka):
  v.c_bytes = tr.cbm(b, s.fs_base) -> tr.hap(s, hs, v) -> tr.ofr(s, fr, v) ->
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a -> runs(x86_64_linux.exec_body(len, tag(121, pair(tag(0, gr), z))), m, o)) ->
  a2 = bits_add(64, a, bits_of_int(64, len)) -> gr in x86_64_linux.Reg -> gr in dom(rs) -> rs[gr] = pair(nb, T) -> T in bits(64) -> base in omega ->
  tr.code_okm(b, fptr, n, fr, t, cb, cc, st) -> (int_mod(fr, 16) = 8 -> tr.sal16(s)) -> abi.loaded(s.vm, cb, cc, st) -> cb in omega ->
  tr.cfr(fr) -> seq_len(args) = n -> n in omega -> int_le(n, 6) ->
  fptr in fn_space(bits(64), fn_space(abi.ARGS, powerset(univ(1)))) ->
  (all m. tr.regs(m, rs) -> tr.args_in(m, args)) -> tr.cs_sub(rc, rs) -> tr.hin(hs, fr) -> fd2 in omega -> int_le(fd2, int_add(fr, 8)) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) ->
  (all t0. t0 in univ(1) -> runs(mkprog(x0 x1. ex x8. dd(t0, x8) && k(x8, x1)), w, diverge(t0))) ->
  (all w4 r0. w4 in abi.World && w4 in univ(1) -> r0 in bits(64) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, fd2, fn_update(rc, 0, pair(8, r0)),
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. ka(x0, r0, x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w4)) ->
  (all z. z.rip = t -> bkp(z)) -> (all z. int_lt(z.gpr[4], int_sub(s.gpr[4], fr)) -> bkp(z) -> z.rip = t) -> (all z p2 w2. z.rip = t -> tr.at_tm(b, z, p2, w2) -> bka(z, p2, w2)) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gc.c1m(b, fptr[T], args), x0, x9 x10. ka(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w)
proof
  assume hmn hap hofr hat ha2 hg hgd hgu htb hb hcode hal hld hcb hcf hln hno hn6 hft hreg hsub hhin hfo hfd hk hd hpost hbt hbf hat2
  have hcl: (all w4 r0 r1. w4 in abi.World && w4 in univ(1) -> r0 in bits(64) -> r1 in bits(64) ->
      tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, fd2, fn_update(fn_update(rc, 0, pair(8, r0)), 2, pair(8, r1)), mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. ka(x0, fst(pair(r0, r1)), x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w4)) ->
      tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gc.cm(b, fptr[T], args), x0, x9 x10. ka(x9, fst(x10), x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
        x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w) proof
    assume post
    show := mp(tr.calli_stm[b := b, bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb), s := s, v := v, base := base, code := code, fr := fr, a := a, a2 := a2, len := len, gr := gr, z := z, nb := nb, T := T, fptr := fptr, args := args, n := n, cb := cb, cc := cc, st := st,
      hs := hs, ds := ds, fd2 := fd2, rs := rs, rc := rc, w := w, t := t, ka := x9 x10 x8. ka(x9, fst(x10), x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], hmn, hofr, hap,
      hat, ha2, hg, hgd, hgu, htb, hb, hcode, hal, hld, hcb, hcf, hln, hno, hn6, hft, hreg, hsub, hhin, hfo, hfd, hk, hd, post, hbt, hbf, hat2)
  qed
  show := apply(tr.call1_of_m[b := b, s := s, v := v, base := base, code := code, fr := fr, a := a, a2 := a2, g := fptr[T], args := args, hs := hs, ds := ds, fd2 := fd2, rs := rs, rc := rc, w := w,
    ka := x9 x10 x8. ka(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2), bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], hsub, hpost, hcl)
qed

// (the main mode's relation at t: the generic one's)
theorem tr.hat_conv(zb pb wb. A, t, ks): (ks -> (all z p2 w2. z.rip = t -> tr.at_t(z, p2, w2) -> A(z, p2, w2))) ->
  (ks -> (all z p2 w2. z.rip = t -> tr.at_tm(true, z, p2, w2) -> A(z, p2, w2)))
proof
  assume h kk
  fix z p2 w2
  assume zt ha
  have a0: tr.at_t(z, p2, w2) by taut(all_elim(tr.at_tm_t, {z}, {p2}, {w2}), ha)
  show := mp(all_elim(mp(h, kk), {z}, {p2}, {w2}), zt, a0)
qed

// The rules in the main mode (gimple.call; the engine's) and in the
// startup's (gimple.call0, v's bytes all, the callee's contract the
// startup's)
theorem tr.call_st(s, v, base, code, fr, a, a2, len, off, f, g, args, n, cb, cc, st, hs, ds, fd2, rs, rc, w, t, ks, x9 x10 x8. ka, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw, zb. bkp, zb pb wb. bka):
  tr.mainv(s, v) -> tr.ofr(s, fr, v) -> tr.hap(s, hs, v) ->
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a -> runs(x86_64_linux.exec_body(len, tag(120, off)), m, o)) ->
  a2 = bits_add(64, a, bits_of_int(64, len)) -> off in bits(32) -> base in omega ->
  f = bits_add(64, a2, bits_sext(32, 64, off)) -> tr.callee_contract_s(fr, f, g, t, ks, cb, cc, st) -> !(f = t) -> (int_mod(fr, 16) = 8 -> tr.sal16(s)) -> abi.loaded(s.vm, cb, cc, st) -> cb in omega ->
  tr.cfr(fr) -> seq_len(args) = n -> n in omega -> int_le(n, 6) ->
  g in fn_space(abi.ARGS, powerset(univ(1))) -> tr.callee_io(g, n) ->
  (all m. tr.regs(m, rs) -> tr.args_in(m, args)) -> tr.cs_sub(rc, rs) -> tr.hin(hs, fr) -> fd2 in omega -> int_le(fd2, int_add(fr, 8)) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) ->
  (all t0. t0 in univ(1) -> runs(mkprog(x0 x1. ex x8. dd(t0, x8) && k(x8, x1)), w, diverge(t0))) ->
  (all w4 r0 r1. w4 in abi.World && w4 in univ(1) -> r0 in bits(64) -> r1 in bits(64) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, fd2, fn_update(fn_update(rc, 0, pair(8, r0)), 2, pair(8, r1)),
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. ka(x0, pair(r0, r1), x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w4)) ->
  (all z. z.rip = t -> bkp(z)) -> (all z. int_lt(z.gpr[4], int_sub(s.gpr[4], fr)) -> bkp(z) -> z.rip = t) -> (ks -> (all z p2 w2. z.rip = t -> tr.at_t(z, p2, w2) -> bka(z, p2, w2))) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call(g, args), x0, x9 x10. ka(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w)
proof
  assume hmn hofr hap hat ha2 hoff hb hf himp hft hal hld hcb hcf hln hno hn6 hgt hio hreg hsub hhin hfo hfd hk hd hpost hbt hbf hat2
  have hcv: v.c_bytes = tr.cbm(true, s.fs_base) := trans(hmn, sym(all_elim(tr.cbm_t, {s.fs_base})))
  have r := mp(tr.call_stm[b := true, s := s, v := v, base := base, code := code, fr := fr, a := a, a2 := a2, len := len, off := off, f := f, g := g, args := args, n := n, cb := cb, cc := cc, st := st,
    hs := hs, ds := ds, fd2 := fd2, rs := rs, rc := rc, w := w, t := t, ks := ks, ka := x9 x10 x8. ka(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2),
    bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], hcv, hofr, hap, hat, ha2, hoff, hb, hf, apply(tr.ccs_of, himp), hft, hal, hld, hcb, hcf, hln, hno, hn6, hgt, hio, hreg, hsub, hhin, hfo, hfd, hk, hd, hpost, hbt, hbf,
    mp(tr.hat_conv[A := zb pb wb. bka(zb, pb, wb), t := t, ks := ks], hat2))
  show := rewrite(mp(ite_t[c := true, a := gimple.call(g, args), b := gimple.call0(g, args)], (true by taut())), r)
qed

theorem tr.calli_st(s, v, base, code, fr, a, a2, len, gr, z, nb, T, fptr, args, n, cb, cc, st, hs, ds, fd2, rs, rc, w, t, x9 x10 x8. ka, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw, zb. bkp, zb pb wb. bka):
  tr.mainv(s, v) -> tr.ofr(s, fr, v) -> tr.hap(s, hs, v) ->
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a -> runs(x86_64_linux.exec_body(len, tag(121, pair(tag(0, gr), z))), m, o)) ->
  a2 = bits_add(64, a, bits_of_int(64, len)) -> gr in x86_64_linux.Reg -> gr in dom(rs) -> rs[gr] = pair(nb, T) -> T in bits(64) -> base in omega ->
  tr.code_ok(fptr, n, fr, t, cb, cc, st) -> (int_mod(fr, 16) = 8 -> tr.sal16(s)) -> abi.loaded(s.vm, cb, cc, st) -> cb in omega ->
  tr.cfr(fr) -> seq_len(args) = n -> n in omega -> int_le(n, 6) ->
  fptr in fn_space(bits(64), fn_space(abi.ARGS, powerset(univ(1)))) ->
  (all m. tr.regs(m, rs) -> tr.args_in(m, args)) -> tr.cs_sub(rc, rs) -> tr.hin(hs, fr) -> fd2 in omega -> int_le(fd2, int_add(fr, 8)) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) ->
  (all t0. t0 in univ(1) -> runs(mkprog(x0 x1. ex x8. dd(t0, x8) && k(x8, x1)), w, diverge(t0))) ->
  (all w4 r0 r1. w4 in abi.World && w4 in univ(1) -> r0 in bits(64) -> r1 in bits(64) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, fd2, fn_update(fn_update(rc, 0, pair(8, r0)), 2, pair(8, r1)),
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. ka(x0, pair(r0, r1), x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w4)) ->
  (all z. z.rip = t -> bkp(z)) -> (all z. int_lt(z.gpr[4], int_sub(s.gpr[4], fr)) -> bkp(z) -> z.rip = t) -> (all z p2 w2. z.rip = t -> tr.at_t(z, p2, w2) -> bka(z, p2, w2)) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call(fptr[T], args), x0, x9 x10. ka(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w)
proof
  assume hmn hofr hap hat ha2 hg hgd hgu htb hb hcode hal hld hcb hcf hln hno hn6 hft hreg hsub hhin hfo hfd hk hd hpost hbt hbf hat2
  have hcv: v.c_bytes = tr.cbm(true, s.fs_base) := trans(hmn, sym(all_elim(tr.cbm_t, {s.fs_base})))
  have ha1 := mp(tr.hat_conv[A := zb pb wb. bka(zb, pb, wb), t := t, ks := true], (true -> (all z p2 w2. z.rip = t -> tr.at_t(z, p2, w2) -> bka(z, p2, w2)) by taut(hat2)))
  have r := mp(tr.calli_stm[b := true, s := s, v := v, base := base, code := code, fr := fr, a := a, a2 := a2, len := len, gr := gr, z := z, nb := nb, T := T, fptr := fptr, args := args, n := n, cb := cb, cc := cc, st := st,
    hs := hs, ds := ds, fd2 := fd2, rs := rs, rc := rc, w := w, t := t, ka := x9 x10 x8. ka(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2),
    bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], hcv, hofr, hap, hat, ha2, hg, hgd, hgu, htb, hb, apply(tr.code_ok_of, hcode), hal, hld, hcb, hcf, hln, hno, hn6, hft, hreg, hsub, hhin, hfo, hfd, hk, hd, hpost, hbt, hbf,
    mp(ha1, (true by taut())))
