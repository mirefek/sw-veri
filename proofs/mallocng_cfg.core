// The CFG form refines the structured form (docs/overview.md; the
// checker's `refines NAME LOW HIGH`, slc/cli/src/c1/gref.rs, on the rules
// of proofs/gimple_cfg.core), and a function's machine code implements its
// spec through the CFG: its C1 on the CFG form (proofs/mallocng_c1_cfg.core),
// the CFG form refining the structured one, the structured one's C2
// (proofs/mallocng_slots.core), composed by tr.implements_refine.
//
// Check after proofs/mallocng_c1_cfg.core and the C2 proofs.

refines gst_ref c_src_malloc_mallocng_malloc_cfg.get_stride_fun c_src_malloc_mallocng_malloc.get_stride_fun

theorem gstc.composed: all statics.
  tr.implements_at(4207440, mallocng_specs.get_stride_spec_fun(c_src_malloc_mallocng_malloc.__malloc_size_classes), 4198400, text.code, statics)
proof
  fix statics
  have st := mp(all_elim(tr.implements_refine, {4207440}, {c_src_malloc_mallocng_malloc_cfg.get_stride_fun()}, {c_src_malloc_mallocng_malloc.get_stride_fun()},
    {4198400}, {text.code}, {statics}), all_elim(gstc.implements, {statics}), gst_ref)
  show := mp(all_elim(tr.implements_refine, {4207440}, {c_src_malloc_mallocng_malloc.get_stride_fun()},
    {mallocng_specs.get_stride_spec_fun(c_src_malloc_mallocng_malloc.__malloc_size_classes)}, {4198400}, {text.code}, {statics}), st, ms.get_stride_fun_c2)
qed
