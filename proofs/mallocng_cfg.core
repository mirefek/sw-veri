// (dequeue_head's and free_meta's C2 at any callee: their procedures' C2
// as functions, as ms.dequeue_head_fun_c2 and ms.free_meta_fun_c2 for the
// structured callees)
theorem cc.dequeue_head_fun_c2: all g. (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(app(g, regs), s, o) -> runs(app(mallocng_specs.dequeue_spec_fun, regs), s, o)) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
    runs(app(c_src_malloc_mallocng_malloc.dequeue_head_fun(g), regs), s, o) -> runs(app(mallocng_specs.dequeue_head_spec_fun, regs), s, o))
proof
  fix g
  assume hg
  have hm: all regs. refines(c_src_malloc_mallocng_malloc.dequeue_head(bits_of_int(64, app(regs, 0)), g), mallocng_specs.dequeue_head_spec(bits_of_int(64, app(regs, 0))), abi.World) proof
    fix regs
    show := mp(all_elim(ms.dequeue_head_c2, {bits_of_int(64, app(regs, 0))}, {g}), simp(), hg)
  qed
  show by defs(apply(g.fun_res[n := 1, w := 64], hm), c_src_malloc_mallocng_malloc.dequeue_head_fun, mallocng_specs.dequeue_head_spec_fun, letin)
qed

theorem cc.free_meta_fun_c2: all g. (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(app(g, regs), s, o) -> runs(app(mallocng_specs.queue_spec_fun, regs), s, o)) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
    runs(app(c_src_malloc_mallocng_malloc.free_meta_fun(g), regs), s, o) -> runs(app(mallocng_specs.free_meta_spec_fun(c_src_malloc_mallocng_malloc.__malloc_context), regs), s, o))
