  fix g
  assume hg
  have hm: all regs. refines(c_src_malloc_mallocng_malloc.free_meta(bits_of_int(64, app(regs, 0)), g), mallocng_specs.free_meta_spec(c_src_malloc_mallocng_malloc.__malloc_context, bits_of_int(64, app(regs, 0))), abi.World) proof
    fix regs
    show := mp(all_elim(ms.free_meta_c2, {bits_of_int(64, app(regs, 0))}, {g}), simp(), hg)
