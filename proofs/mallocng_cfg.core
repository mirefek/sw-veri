// ---------------------------------------------------------------------
//  The callers: a caller's CFG C1 linked with its callees' CFG functions
//  (their contracts, typed and io from their CFG C1, as
//  proofs/mallocng_link.core); its CFG function's runs its spec's -- its
//  refinement at those callees, then its C2 (generic in the callee) with
//  each callee's chain (`cc.F`: F's CFG function's runs its spec's).

// (the callees' chains: the refinement, then the C2)
theorem cc.a_ctz_32: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
  runs(app(c_src_malloc_mallocng_malloc_cfg.a_ctz_32_fun(), regs), s, o) -> runs(app(mallocng_specs.a_ctz_32_spec_fun(c_src_malloc_mallocng_malloc.debruijn32), regs), s, o)
proof
  fix regs s o
  assume h1 h2 h3 hr
  show := mp(all_elim(ms.a_ctz_32_fun_c2, {regs}, {s}, {o}), h1, h2, h3, mp(all_elim(a_ctz_32_ref, {regs}, {s}, {o}), h1, h2, h3, hr))
qed

