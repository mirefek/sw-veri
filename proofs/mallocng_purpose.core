// (the specs diverge nowhere they do not also raise: the counters' body
// ends, or nothing; is_bouncing's returns)
theorem mp.co_div(c, w, h, t): w in abi.World -> w in univ(1) -> h in mp.G ->
  runs(mallocng_purpose.counters_purpose(c), union2(w, h), diverge(t)) -> runs(mallocng_purpose.counters_purpose(c), union2(w, h), exc(union2(w, h), empty))
proof
  assume hw hwu hh hr
  let S := union2(w, h)
  have {su = univ, sv = vm} := apply(mp.gS, hw, hwu, hh)
  have bp: all x x2. letin(app(S, "vm"), x3. any_rel(x4. x4 in x86_64_linux.Vm && mallocng_purpose.ctx_only(c, x3, app(fn_update(S, "vm", x4), "vm")),
        x4. letin(fn_update(S, "vm", x4), x5. x = ok(pair(x5, empty), empty)))) -> fst(x) = 2 ->
      letin(app(S, "vm"), x3. any_rel(x4. x4 in x86_64_linux.Vm && mallocng_purpose.ctx_only(c, x3, app(fn_update(S, "vm", x4), "vm")),
        x4. letin(fn_update(S, "vm", x4), x5. x2 = ok(pair(x5, empty), empty)))) proof
    fix x x2
    assume h1 h2
    have k: all y. y in x86_64_linux.Vm && mallocng_purpose.ctx_only(c, app(S, "vm"), app(fn_update(S, "vm", y), "vm")) ->
        x = ok(pair(fn_update(S, "vm", y), empty), empty) -> fst(x) = 2 -> x2 = ok(pair(fn_update(S, "vm", y), empty), empty) proof
      fix y
      assume _ he hf
      have f0: fst(x) = 0 by defs(simp(he), ok, tag)
      have no: false by arith(f0, hf)
      show by taut(no)
    qed
    show by defs(apply(ct.dv_any[d := y. y in x86_64_linux.Vm && mallocng_purpose.ctx_only(c, app(S, "vm"), app(fn_update(S, "vm", y), "vm")),
      k := y x. x = ok(pair(fn_update(S, "vm", y), empty), empty), x := x, x2 := x2], k, expand(h1, letin), h2), letin)
  qed
  have r2 := apply(ct.contract_div, su, sv, expand(hr, mallocng_purpose.counters_purpose), bp)
  show by defs(r2, mallocng_purpose.counters_purpose)
qed

theorem mp.co_divg0: all c. tr.div_raises_g(mp.G, mallocng_purpose.counters_purpose_fun0(c))
proof
  fix c
  have qd: all w h t. w in abi.World -> w in univ(1) -> h in mp.G -> runs(mallocng_purpose.counters_purpose(c), union2(w, h), diverge(t)) ->
      runs(mallocng_purpose.counters_purpose(c), union2(w, h), exc(union2(w, h), empty)) proof
    fix w h t
    assume hw hwu hh hr
    show := apply(mp.co_div[c := c, w := w, h := h, t := t], hw, hwu, hh, hr)
  qed
  show by defs(apply(ct.fun_divg_v0[G := mp.G, q := mallocng_purpose.counters_purpose(c)], mp.g_univ, qd), mallocng_purpose.counters_purpose_fun0)
qed

theorem mp.co_divg1: all c. tr.div_raises_g(mp.G, mallocng_purpose.counters_purpose_fun1(c))
proof
  fix c
  have qd: all regs w h t. regs in abi.ARGS -> w in abi.World -> w in univ(1) -> h in mp.G -> runs(mallocng_purpose.counters_purpose(c), union2(w, h), diverge(t)) ->
      runs(mallocng_purpose.counters_purpose(c), union2(w, h), exc(union2(w, h), empty)) proof
    fix regs w h t
    assume _ hw hwu hh hr
    show := apply(mp.co_div[c := c, w := w, h := h, t := t], hw, hwu, hh, hr)
  qed
  show by defs(apply(ct.fun_divg_v[G := mp.G, q := x0. mallocng_purpose.counters_purpose(c), n := 1], mp.g_univ, qd), mallocng_purpose.counters_purpose_fun1)
qed

theorem mp.ib_divg: all c. tr.div_raises_g(mp.G, mallocng_purpose.is_bouncing_purpose_fun(c))
proof
  fix c
  have qu: all regs s o. runs(mallocng_purpose.is_bouncing_purpose(c, bits_of_int(32, app(regs, 0))), s, o) -> pair(s, o) in univ(1) proof
    fix regs s o
    assume hr
    show := apply(g.runs_univ, expand(hr, mallocng_purpose.is_bouncing_purpose))
  qed
  have qd: all regs w h t. regs in abi.ARGS -> w in abi.World -> w in univ(1) -> h in mp.G ->
      runs(mallocng_purpose.is_bouncing_purpose(c, bits_of_int(32, app(regs, 0))), union2(w, h), diverge(t)) ->
      runs(mallocng_purpose.is_bouncing_purpose(c, bits_of_int(32, app(regs, 0))), union2(w, h), exc(union2(w, h), empty)) proof
    fix regs w h t
    assume _ hw hwu hh hr
    let S := union2(w, h)
    have {su = univ, sv = vm} := apply(mp.gS, hw, hwu, hh)
    have bp: all x x2. any_rel(x3. x3 in bits(32), x3. x = exc(pair(S, empty), pair("ret", x3))) -> fst(x) = 2 ->
        any_rel(x3. x3 in bits(32), x3. x2 = exc(pair(S, empty), pair("ret", x3))) proof
      fix x x2
      assume h1 h2
      show by apply(ct.dv_ret, h1, h2)
    qed
    have r2 := apply(ct.contract_div, su, sv, expand(hr, mallocng_purpose.is_bouncing_purpose), bp)
    show by defs(r2, mallocng_purpose.is_bouncing_purpose)
  qed
  show by defs(apply(ct.fun_divg, mp.g_univ, qu, qd), mallocng_purpose.is_bouncing_purpose_fun)
qed

