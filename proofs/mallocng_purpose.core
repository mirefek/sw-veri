    fix s o
    assume hr
    show := apply(g.runs_univ, expand(hr, c_src_malloc_mallocng_malloc.account_bounce))
  qed
  have eff: all s h o. s in abi.World -> h in mp.G -> mallocng.holds_in(c, app(h, "A"), app(s, "vm"), app(h, "blocks")) -> runs(c_src_malloc_mallocng_malloc.account_bounce(sc), s, o) ->
      ex V2. V2 in x86_64_linux.Vm && mallocng_purpose.ctx_only(c, app(s, "vm"), V2) && o = ok(fn_update(s, "vm", V2), empty) proof
