           int_lt(int_sub(int_sub(mallocng.slot_end(app(app(app(union2(s, h), "A"), "metas"), g), idx), n), mallocng.storage(app(app(app(union2(s, h), "A"), "metas"), g))),
             int_mul(int_mul(mallocng.UNIT, app(mallocng.size_classes, app(app(app(app(union2(s, h), "A"), "metas"), g), "sizeclass"))), int_add(idx, 1))))) &&
        (int_le(int_add(app(union2(s, h), "fs_base"), 8), int_sub(mallocng.slot_start(app(app(app(union2(s, h), "A"), "metas"), g), idx), mallocng.IB)) ||
           int_le(mallocng.slot_end(app(app(app(union2(s, h), "A"), "metas"), g), idx), app(union2(s, h), "fs_base")))) ->
      (ex v. v in x86_64_linux.Vm && o = exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty))) ||
      (ex s1 v. o = ok(s1, v) &&
        letin(app(union2(s, h), "vm"), x3. any_rel(x4. x4 in bits(64) &&
          (((int_le(mallocng.slot_start(app(app(app(union2(s, h), "A"), "metas"), g), idx), x4) &&
             int_mod(int_sub(x4, mallocng.slot_start(app(app(app(union2(s, h), "A"), "metas"), g), idx)), mallocng.UNIT) = 0) &&
             int_lt(x4, int_add(mallocng.slot_start(app(app(app(union2(s, h), "A"), "metas"), g), idx), int_mul(256, mallocng.UNIT)))) &&
             int_le(int_add(x4, n), mallocng.slot_end(app(app(app(union2(s, h), "A"), "metas"), g), idx))),
          x4. letin(x4, x5. any_rel(x6. x6 in x86_64_linux.Vm &&
            mallocng_purpose.framed(x3, app(fn_update(union2(s, h), "vm", x6), "vm"), app(app(app(fn_update(union2(s, h), "vm", x6), "A"), "metas"), g), idx, x5, n),
          x6. letin(fn_update(union2(s, h), "vm", x6), x7. exc(pair(union2(s1, h), empty), pair("ret", v)) = exc(pair(x7, empty), pair("ret", x5)))))))) proof
