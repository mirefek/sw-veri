// mallocng's functions by their purpose (proving GIMPLE spec): specs in
// the abstract state (layers/mallocng_purpose.sl), refined by the
// functions' readable GIMPLE directly -- no memory-level spec between, the
// code's run (`step`) the memory effect. Each function: its contract with
// the ghost part read (`mp.gsi_run`: what the code returns under the
// precondition), the idea from the invariant (proofs/mallocng_abs.core);
// the refinement from it by the contract rule (`ct.refines_contract`,
// proofs/gimple_ghost.core); the machine code implementing the spec by the
// bridge (proofs/abi_ghost.core: `mp.gsi_implements`).
//
// Loaded after proofs/abi_ghost.core, proofs/gimple_ghost.core and
// proofs/mallocng_abs.core in the CFG chain (slc/cli/tests/steps.rs,
// c1_cfg_engine_checks).

// ----------------------------------------------------------------------
//  The ghost part of MallocAbs over the world: malloc's blocks and the
//  abstract state
abbrev mp.G := rec_and(malloc.Heap.ghost, mallocng_purpose.MallocAbs.ghost)

// its parts: blocks and A, the record h of them
theorem mp.g_parts: all h. h in mp.G -> ex hb ha. h = union2(hb, ha) &&
  is_fun(hb) && dom(hb) = insert("blocks", empty) && app(hb, "blocks") in fn_space(bits(64), option(omega)) && hb in univ(1) &&
  is_fun(ha) && dom(ha) = insert("A", empty) && app(ha, "A") in mallocng.Abs && ha in univ(1)
proof
  fix h
  assume hh
  obtain x y, hx hy he from mp(rec_and_elim[a := malloc.Heap.ghost, b := mallocng_purpose.MallocAbs.ghost, s := h], hh)
  have kb: insert("blocks", empty) in univ(1) by simp(x86.insert_univ)
  have ka: insert("A", empty) in univ(1) by simp(x86.insert_univ)
  have xp: x in powerset(cart(insert("blocks", empty), univ(1))) && is_fun(x) && dom(x) = insert("blocks", empty) && app(x, "blocks") in fn_space(bits(64), option(omega))
    by simp(expand(hx, malloc.Heap.ghost))
  have yp: y in powerset(cart(insert("A", empty), univ(1))) && is_fun(y) && dom(y) = insert("A", empty) && app(y, "A") in mallocng.Abs
    by simp(expand(hy, mallocng_purpose.MallocAbs.ghost))
  have xu := mp(rec_univ[u := 1, k := insert("blocks", empty), r := x], kb, taut(xp), taut(xp), taut(xp))
  have yu := mp(rec_univ[u := 1, k := insert("A", empty), r := y], ka, taut(yp), taut(yp), taut(yp))
  show by ex_intro({x}, {y}, taut(he, xp, yp, xu, yu))
qed

theorem mp.g_univ: all h. h in mp.G -> h in univ(1)
proof
  fix h
  assume hh
  obtain hb ha, he _ _ _ hbu _ _ _ hau from mp(all_elim(mp.g_parts, {h}), hh)
  show := rewrite(sym(he), mp(mp(union2_univ[u := 1, a := hb, b := ha], hbu), hau))
qed

// (a record of one field k: each pair's first component k)
theorem mp.one_key(r, k): is_fun(r) -> dom(r) = insert(k, empty) -> (all z. z in r -> fst(z) = k)
proof
  assume hf hd
  have pr: all z. z in r -> (ex a b. z = pair(a, b)) by taut(expand(hf, is_fun))
  fix z
  assume hz
  obtain x y, e from mp(all_elim(pr, {z}), hz)
  have xd := mp(dom_intro[f := r, k := x, v := y], rewrite(e, hz))
  have xk: x in insert(k, empty) := rewrite(hd, xd)
  show by simp(e, xk)
qed

// the ghost part's records: apart from the machine's and the world's fields
theorem mp.g_ok: abi.ghost_ok(mp.G)
proof
  fix h
  assume hh
  obtain hb ha, he hbf hbd _ hbu haf had _ hau from mp(all_elim(mp.g_parts, {h}), hh)
  have kb := apply(mp.one_key, hbf, hbd)
  have ka := apply(mp.one_key, haf, had)
  have dj: all z w. z in hb -> w in ha -> fst(z) != fst(w) proof
    fix z w
    assume hz hw
    show by simp(mp(all_elim(kb, {z}), hz), mp(all_elim(ka, {w}), hw))
  qed
  have uf := apply(union2_fun, hbf, haf, dj)
  have keys: all z. z in union2(hb, ha) -> !(fst(z) in abi.KEYS) && !(fst(z) in abi.WKEYS) proof
    fix z
    assume hz
    have c := union2_iff[a := hb, b := ha, z := z]
    have c1: z in hb -> !(fst(z) in abi.KEYS) && !(fst(z) in abi.WKEYS) proof
      assume h1
      show by simp(mp(all_elim(kb, {z}), h1))
    qed
    have c2: z in ha -> !(fst(z) in abi.KEYS) && !(fst(z) in abi.WKEYS) proof
      assume h2
      show by simp(mp(all_elim(ka, {z}), h2))
    qed
    show by taut(c, hz, c1, c2)
  qed
  have hu := mp(all_elim(mp.g_univ, {h}), hh)
  show := rewrite(sym(he), conj(rewrite(he, hu), uf, keys))
qed

// the ghost record's fields: blocks and A
theorem mp.g_rec: all h. h in mp.G -> h in univ(1) && dom(h) = union2(insert("blocks", empty), insert("A", empty)) &&
  app(h, "blocks") in fn_space(bits(64), option(omega)) && app(h, "A") in mallocng.Abs
proof
  fix h
  assume hh
  obtain hb ha, he _ hbd hbt _ _ had hat _ from mp(all_elim(mp.g_parts, {h}), hh)
  have hu := mp(all_elim(mp.g_univ, {h}), hh)
  have d: dom(union2(hb, ha)) = union2(insert("blocks", empty), insert("A", empty)) by simp(dom_union2[a := hb, b := ha], hbd, had)
  have ab: app(union2(hb, ha), "blocks") = app(hb, "blocks") by simp(hbd, had)
  have aa: app(union2(hb, ha), "A") = app(ha, "A") by simp(hbd, had)
  have r: dom(union2(hb, ha)) = union2(insert("blocks", empty), insert("A", empty)) && app(union2(hb, ha), "blocks") in fn_space(bits(64), option(omega)) && app(union2(hb, ha), "A") in mallocng.Abs
    by taut(d, rewrite(sym(ab), hbt), rewrite(sym(aa), hat))
  show by taut(hu, rewrite(sym(he), r))
qed

// (the ghost part's records: apart from the world's fields)
theorem mp.g_world: all h. h in mp.G -> h in univ(1) && (all z. z in h -> !(fst(z) in abi.WKEYS))
proof
  fix h
  assume hh
  have u _ ks := mp(all_elim(mp.g_ok, {h}), hh)
  have w: all z. z in h -> !(fst(z) in abi.WKEYS) proof
    fix z
    assume hz
    have k := mp(all_elim(ks, {z}), hz)
    show by taut(k)
  qed
  show by taut(u, w)
qed

// ----------------------------------------------------------------------
//  get_slot_index: its code refines its purpose

// get_slot_index's contract, the ghost part h read: where what starts at
// p lies in slot i of a group, the code returns i, the world unchanged.
// The byte it reads is the slot's header (`mp.slot_hdr`), its low 5 bits
// the index.
theorem mp.gsi_run(c, p, s, h, o, g, i): c in mallocng.Cfg -> p in bits(64) -> s in abi.World -> h in mp.G ->
  mallocng.holds_in(c, app(h, "A"), app(s, "vm"), app(h, "blocks")) -> i in omega -> mallocng.starts_at(app(h, "A"), g, i, p) ->
  runs(c_src_malloc_mallocng_malloc.get_slot_index(p), s, o) -> o = ok(s, i) && i in bits(32)
proof
  assume hc hp hs hh hin hi hst hr
  have hu hd hbt hat := mp(all_elim(mp.g_rec, {h}), hh)
  let V0 := app(s, "vm")
  let A := app(h, "A")
  let B := app(h, "blocks")
  have hpo: p in omega by simp(hp)
  have h16 hfp hidx hrw hks := apply(mp.slot_hdr, hc, simp(hu), hat, hbt, hi, hpo, hin, hst)
    // p - 3: the allocator's, readable
    let M3 := mallocng.mview(V0, mallocng.footprint(c, A, B))
    have p3o: int_sub(p, 3) in omega by arith(h16, hpo)
    have pgx: mallocng.pg(M3, int_sub(p, 3)) = app(app(V0, "pages"), int_div(int_sub(p, 3), x86_64_linux.PAGE))
      by defs(simp(hfp, p3o, keep(mallocng.footprint)), mallocng.pg, mallocng.mview)
    have rw2 := expand(expand(hrw, mallocng.m_rw), mallocng.m_mapped)
    have us: gimple.usable(V0, app(s, "objs"), int_sub(p, 3), 1, false) proof
      fix x0
      assume h0 h1
      have z: x0 = 0 by arith(h0, h1)
      show by defs(simp(z, pgx, rw2, hks, keep(mallocng.pg)), x86_64_linux.mapped)
    qed
    // the code's run: the low 5 bits of that byte
    have su: s in univ(1) by simp(apply(g.runs_univ, expand(hr, c_src_malloc_mallocng_malloc.get_slot_index)))
    let T64 := fn_update(fn_update(empty, "prec", 64), "signed", true)
    have sv: gimple.sval(T64, bits_neg(64, 3)) = int_neg(3) by defs(simp(), gimple.sval)
    let P3 := int_add(p, gimple.sval(T64, bits_neg(64, 3)))
    have e3: P3 = int_sub(p, 3) by arith(sv)
    have p3: int_lt(3, p) by arith(h16)
    have ur3: gimple.usable(V0, app(s, "objs"), int_add(P3, 0), 1, false) by simp(us, e3)
    have p64: pow2(64) = 18446744073709551616 by simp()
    step x1, oe from hr with g.padd_det, g.ld8_det using conj(su, hp, sv, e3, p3, ur3, p64)
    let X := gimple.bytes_at(V0, int_add(P3, 0), 1)
    have _ _ _ pb := apply(ms.world_parts, hs)
    have xo _ := mp(all_elim(g.bytes_bound, {V0}, {int_add(P3, 0)}, {1}), pb, arith())
    have lv := apply(ms.low5, xo)
    // the header byte: the slot's index
    have hb3: int_add(P3, 0) = int_sub(p, 3) by arith(e3)
    have p3b: int_sub(p, 3) in bits(64) by arith(hp, h16)
    have bt := mp(fn_space_app[a := bits(64), b := bits(8), f := app(V0, "bytes"), x := int_sub(p, 3)], pb, p3b)
    have hb0: bits_add(64, int_sub(p, 3), 0) = int_sub(p, 3) by defs(arith(hp, h16, p64), bits_add, pow2)
    have xb: X = mallocng.b8(M3, int_sub(p, 3))
      by defs(simp(hb3, hfp, p3o, hb0, bt, keep(mallocng.footprint)), gimple.bytes_at, mallocng.b8, mallocng.mview)
    have vi: int_mod(X, 32) = i by simp(xb, hidx)
    have ib: i in bits(32) by simp(rewrite(vi, (int_mod(X, 32) in bits(32) by arith(xo))))
    have oi: o = ok(s, i) by simp(oe, lv, vi)
    show by taut(oi, ib)
qed

// get_slot_index's code by its purpose: its contract (`mp.gsi_run`), the
// ghost part kept
theorem mp.gsi: all c p. c in mallocng.Cfg -> p in bits(64) ->
  refines_ghost(c_src_malloc_mallocng_malloc.get_slot_index(p), mallocng_purpose.get_slot_index_purpose(c, p), abi.World, mp.G)
proof
  fix c p
  assume hc hp
  have rp: all s o. runs(c_src_malloc_mallocng_malloc.get_slot_index(p), s, o) -> pair(s, o) in univ(1) proof
    fix s o
    assume hr
    show := apply(g.runs_univ, expand(hr, c_src_malloc_mallocng_malloc.get_slot_index))
  qed
  have body: all s h o. s in abi.World -> h in mp.G -> runs(c_src_malloc_mallocng_malloc.get_slot_index(p), s, o) ->
      (mallocng.holds_in(c, app(union2(s, h), "A"), app(union2(s, h), "vm"), app(union2(s, h), "blocks")) && (ex g i. (g in omega && i in omega) && mallocng.starts_at(app(union2(s, h), "A"), g, i, p))) ->
      (ex v. v in x86_64_linux.Vm && o = exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty))) ||
      (ex s1 v. o = ok(s1, v) && any_rel(x3. x3 in bits(32) && (ex x4. x4 in omega && mallocng.starts_at(app(union2(s, h), "A"), x4, x3, p)),
        x3. exc(pair(union2(s1, h), empty), pair("ret", v)) = exc(pair(union2(s, h), empty), pair("ret", x3)))) proof
    fix s h o
    assume hs hh hr hpre
    have _ hd _ _ := mp(all_elim(mp.g_rec, {h}), hh)
    have sd: dom(s) = insert("vm", insert("os", insert("fs_base", insert("cpu", insert("objs", empty))))) by simp(expand(hs, abi.World))
    have hin: mallocng.holds_in(c, app(h, "A"), app(s, "vm"), app(h, "blocks")) by simp(hpre, sd, hd)
    have ex1: ex g i. (g in omega && i in omega) && mallocng.starts_at(app(h, "A"), g, i, p) by simp(hpre, sd, hd)
    obtain g i, hg hi hst from ex1
    have oi ib := apply(mp.gsi_run, hc, hp, hs, hh, hin, hi, hst, hr)
    have sa: mallocng.starts_at(app(union2(s, h), "A"), g, i, p) by simp(hst, sd, hd)
    have e4: ex x4. x4 in omega && mallocng.starts_at(app(union2(s, h), "A"), x4, i, p) by ex_intro({g}, taut(hg, sa))
    have e3b: ex x3. (x3 in bits(32) && (ex x4. x4 in omega && mallocng.starts_at(app(union2(s, h), "A"), x4, x3, p))) && exc(pair(union2(s, h), empty), pair("ret", i)) = exc(pair(union2(s, h), empty), pair("ret", x3))
      by ex_intro({i}, taut(ib, e4, refl({exc(pair(union2(s, h), empty), pair("ret", i))})))
    have bS: any_rel(x3. x3 in bits(32) && (ex x4. x4 in omega && mallocng.starts_at(app(union2(s, h), "A"), x4, x3, p)), x3. exc(pair(union2(s, h), empty), pair("ret", i)) = exc(pair(union2(s, h), empty), pair("ret", x3)))
      by defs(taut(e3b), any_rel)
    have fin: ex s1 v. o = ok(s1, v) && any_rel(x3. x3 in bits(32) && (ex x4. x4 in omega && mallocng.starts_at(app(union2(s, h), "A"), x4, x3, p)),
        x3. exc(pair(union2(s1, h), empty), pair("ret", v)) = exc(pair(union2(s, h), empty), pair("ret", x3))) by ex_intro({s}, {i}, taut(oi, bS))
    show by taut(fin)
  qed
  show by defs(apply(ct.refines_contract, mp.g_world, rp, body), mallocng_purpose.get_slot_index_purpose)
qed

// get_slot_index's contract at a call (its C function value): the index
// of the slot returned, the world unchanged
theorem mp.gsi_q: all c regs s h p o2 g i. c in mallocng.Cfg -> p in bits(64) -> s in abi.World -> h in mp.G ->
  mallocng.holds_in(c, app(h, "A"), app(s, "vm"), app(h, "blocks")) -> i in omega -> mallocng.starts_at(app(h, "A"), g, i, p) ->
  gc.regs_ok(regs, seq_one(gimple.arg(64, p))) ->
  runs(app(c_src_malloc_mallocng_malloc.get_slot_index_fun(), regs), s, o2) ->
  (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex r. o2 = ok(fn_update(s, "vm", app(s, "vm")), r) && bits_of_int(32, fst(r)) = i)
proof
  fix c regs s h p o2 g i
  assume hc hp hw hh hin hi hst hr h
  have rl rn r0 := apply(gc.regs1, hp, hr)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, c_src_malloc_mallocng_malloc.get_slot_index_fun, app_fn_build, ra in h
  have pv pf pd pb := apply(ms.world_parts, hw)
  have ss: fn_update(s, "vm", app(s, "vm")) = s := mp(fn_update_same[f := s, k := "vm"], pf, pd)
  have o1: ord_le(1, seq_len(regs)) by defs(simp(rn), ord_le)
  have bp: bits_of_int(64, p) = p by defs(arith(hp), bits_of_int, pow2)
  have b := rewrite(bp, rewrite(r0, apply(g.runs_elim, h)))
  have b2: bind_rel(c_src_malloc_mallocng_malloc.get_slot_index(p), s, x3 x4. letin(x4, x5. bind_rel(gimple.result(32, x5), x3, x6 x7. any_rel(x8. x8 in bits(64), x8. o2 = ok(x6, pair(x7, x8))),
      x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))), x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3)) by taut(b, o1)
  obtain o3, hs3 hk3 from expand(b2, bind_rel)
  have he ib := apply(mp.gsi_run, hc, hp, hw, hh, hin, hi, hst, hs3)
  have k1: bind_rel(gimple.result(32, i), s, x6 x7. any_rel(x8. x8 in bits(64), x8. o2 = ok(x6, pair(x7, x8))), x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))
    by simp(expand(rewrite(he, hk3), letin), keep(bind_rel, gimple.result))
  obtain o4, hr4 hk4 from expand(k1, bind_rel)
  obtain u, hu64 hlow ho4 from apply(g.result32_inv, ib, hr4)
  have k2: any_rel(x8. x8 in bits(64), x8. o2 = ok(s, pair(u, x8))) by simp(rewrite(ho4, hk4), keep(any_rel))
  have ne: ex y. y in bits(64) by ex_intro({0}, simp())
  obtain y, hy hoy from apply(g.any_e, ne, k2)
  have cl: bits_of_int(32, fst(pair(u, y))) = i by simp(hlow)
  have l: ex r. o2 = ok(fn_update(s, "vm", app(s, "vm")), r) && bits_of_int(32, fst(r)) = i by ex_intro({pair(u, y)}, taut(rewrite(sym(ss), hoy), cl))
  show by taut(l)
qed

// (the code diverges nowhere it does not also raise: only where it allows
// anything)
theorem mp.gsi_div_raises: tr.div_raises(c_src_malloc_mallocng_malloc.get_slot_index_fun())
proof
  have g: all args w t. args in abi.ARGS -> w in abi.World -> w in univ(1) -> runs(app(c_src_malloc_mallocng_malloc.get_slot_index_fun(), args), w, diverge(t)) ->
      (ex e x. e in univ(1) && !(e = exc_val("stack_overflow", empty)) && abi.raise_state(x) && runs(app(c_src_malloc_mallocng_malloc.get_slot_index_fun(), args), w, exc(x, e))) proof
    fix args w t
    assume hA hW hu hd
    have rst: abi.raise_state(w) by defs(apply(tr.world_and, hW), abi.raise_state)
    have eu: empty in univ(1) by simp()
    have eno: !(empty = exc_val("stack_overflow", empty)) by defs(all_elim(tr.pair_ne, {"stack_overflow"}, {empty}), exc_val)
    have pu: pair(w, exc(w, empty)) in univ(1) by simp(hu)
    have vv: ex x. x in x86_64_linux.Vm by ex_intro({app(w, "vm")}, simp(hW))
    rsimp only, c_src_malloc_mallocng_malloc.get_slot_index_fun, app_fn_build, hA in hd
    have rf: runs(app(c_src_malloc_mallocng_malloc.get_slot_index_fun(), args), w, exc(w, empty)) proof
      rsimp only, c_src_malloc_mallocng_malloc.get_slot_index_fun, app_fn_build, hA
      show by simp(hd, pu, vv)
    qed
    show by ex_intro({empty}, {w}, taut(eu, eno, rst, rf))
  qed
  show by defs(g, tr.div_raises)
qed

// ... as C function values: the code's wrapper refines the purpose's
theorem mp.gsi_fun: all c regs. c in mallocng.Cfg -> regs in abi.ARGS ->
  refines_ghost(app(c_src_malloc_mallocng_malloc.get_slot_index_fun(), regs), app(mallocng_purpose.get_slot_index_purpose_fun(c), regs), abi.World, mp.G)
proof
  fix c regs
  assume hc hr
  have hm: all regs. refines_ghost(c_src_malloc_mallocng_malloc.get_slot_index(bits_of_int(64, app(regs, 0))), mallocng_purpose.get_slot_index_purpose(c, bits_of_int(64, app(regs, 0))), abi.World, mp.G) proof
    fix regs
    show := mp(all_elim(mp.gsi, {c}, {bits_of_int(64, app(regs, 0))}), hc, simp())
  qed
  have w := mp(g.fun_res_ghost[p := x0. c_src_malloc_mallocng_malloc.get_slot_index(bits_of_int(64, app(x0, 0))), q := x0. mallocng_purpose.get_slot_index_purpose(c, bits_of_int(64, app(x0, 0))), w := 32, n := 1, G := mp.G], mp.g_univ, hm)
  show by defs(mp(all_elim(w, {regs}), hr), c_src_malloc_mallocng_malloc.get_slot_index_fun, mallocng_purpose.get_slot_index_purpose_fun, letin)
qed

// ----------------------------------------------------------------------
//  The machine code implements the purpose spec

theorem mp.gsi_implements: all c statics. c in mallocng.Cfg ->
  abi.implements2_at(mp.G, 4206813, mallocng_purpose.get_slot_index_purpose_fun(c), 4198400, text.code, statics)
proof
  fix c statics
  assume hc
  have r: all args. args in abi.ARGS -> refines_ghost(app(c_src_malloc_mallocng_malloc.get_slot_index_fun(), args), app(mallocng_purpose.get_slot_index_purpose_fun(c), args), abi.World, mp.G) proof
    fix args
    assume ha
    show := mp(all_elim(mp.gsi_fun, {c}, {args}), hc, ha)
  qed
  // (the CFG form's C1, the structured form refined)
  have st := mp(all_elim(tr.implements_refine, {4206813}, {c_src_malloc_mallocng_malloc_cfg.get_slot_index_fun()}, {c_src_malloc_mallocng_malloc.get_slot_index_fun()},
    {4198400}, {text.code}, {statics}), all_elim(gsitc.implements, {statics}), get_slot_index_ref)
  show := mp(all_elim(tr.implements_abi_g, {mp.G}, {4206813}, {c_src_malloc_mallocng_malloc.get_slot_index_fun()}, {mallocng_purpose.get_slot_index_purpose_fun(c)}, {4198400}, {text.code}, {statics}),
    mp.g_ok, mp.gsi_div_raises, st, r)
qed

// ----------------------------------------------------------------------
//  get_meta: its code refines its purpose

// get_meta's contract, the ghost part h read: where what starts at p lies
// in slot i of the group g, the code returns g, the world unchanged -- all
// its checks pass (`mp.gm_pre`), its callee returning i (get_slot_index's
// contract, `mp.gsi_q`), its run then its effect (`ms.gm_run`)
theorem mp.gm_run(c, p, s, h, o, g, i, g0, g1): c in mallocng.Cfg ->
  app(c, "ctx") = c_src_malloc_mallocng_malloc.__malloc_context -> app(c, "sct") = c_src_malloc_mallocng_malloc.__malloc_size_classes ->
  p in bits(64) -> s in abi.World -> h in mp.G ->
  mallocng.holds_in(c, app(h, "A"), app(s, "vm"), app(h, "blocks")) -> abi.thread_ok(app(s, "vm"), app(s, "fs_base")) ->
  i in omega -> mallocng.starts_at(app(h, "A"), g, i, p) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(app(g1, regs), s, o) -> runs(app(c_src_malloc_mallocng_malloc.get_slot_index_fun(), regs), s, o)) ->
  runs(c_src_malloc_mallocng_malloc.get_meta(p, g0, g1), s, o) ->
  ((ex v. v in x86_64_linux.Vm && o = exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty))) || o = ok(s, g)) && g in bits(64)
proof
  assume hc hctx hsct hp hs hh hin hth hi hst hg1 hr
  have hu hd hbt hat := mp(all_elim(mp.g_rec, {h}), hh)
  have au: app(h, "A") in univ(1) by simp(hu)
  have pv pf pd pb := apply(ms.world_parts, hs)
  have pre egm eidx := apply(mp.gm_pre[c := c, A := app(h, "A"), vm := app(s, "vm"), b := app(h, "blocks"), objs := app(s, "objs"), fs := app(s, "fs_base"), g := g, i := i, p := p],
    hc, hctx, hsct, au, hat, hbt, pb, hp, hi, hin, hth, hst)
  have iu _ _ := expand(hst, mallocng.starts_at)
  have gtop _ := apply(mp.meta_word, hc, au, hat, hin, iu)
  have go _ _ := apply(mp.meta_mem, hc, au, hat, hin, iu)
  have gb: g in bits(64) by arith(gtop, go)
  // the callee: get_slot_index's contract, the index i
  have il: int_lt(i, 32) proof
    have _ _ _ := expand(hst, mallocng.starts_at)
    have bi: mallocng_specs.gm_idx(app(s, "vm"), p) in omega && int_lt(mallocng_specs.gm_idx(app(s, "vm"), p), 32) by defs(arith(), mallocng_specs.gm_idx)
    show by arith(rewrite(eidx, bi))
  qed
  have bi32: bits_of_int(32, i) = i by defs(arith(hi, il), bits_of_int, pow2)
  have ix0 := expand(eidx, mallocng_specs.gm_idx)
  have ix := trans(subst({y. bits_of_int(32, int_mod(gimple.bytes_at(app(s, "vm"), bits_sub(64, p, 3), 1), 32)) = bits_of_int(32, y)}, ix0,
    refl({bits_of_int(32, int_mod(gimple.bytes_at(app(s, "vm"), bits_sub(64, p, 3), 1), 32))})), bi32)
  have qa: all regs o2. gc.regs_ok(regs, seq_one(gimple.arg(64, p))) -> runs(app(g1, regs), s, o2) ->
      (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty))) ||
      (ex r. o2 = ok(fn_update(s, "vm", app(s, "vm")), r) && bits_of_int(32, fst(r)) = bits_of_int(32, int_mod(gimple.bytes_at(app(s, "vm"), bits_sub(64, p, 3), 1), 32))) proof
    fix regs o2
    assume hro h2
    have rl rn _ := hro
    have h3 := mp(all_elim(hg1, {regs}, {s}, {o2}), rl, (int_le(seq_len(regs), 6) by simp(rn)), hs, h2)
    have q := apply(mp.gsi_q, {c}, {regs}, {s}, {h}, {p}, {o2}, {g}, {i}, hc, hp, hs, hh, hin, hi, hst, hro, h3)
    show := rewrite(sym(ix), q)
  qed
  have ef := apply(ms.gm_run, {p}, {g0}, {g1}, {s}, {o}, hp, hs, pre, qa, hr)
  have e2 := apply(g.runs_elim, expand(ef, ms.gm_eff))
  show by taut(rewrite(egm, e2), gb)
qed

// get_meta's contract at a call (its C function value)
theorem mp.gm_q(c, regs, s, h, p, o2, g, i, g0, g1): c in mallocng.Cfg ->
  app(c, "ctx") = c_src_malloc_mallocng_malloc.__malloc_context -> app(c, "sct") = c_src_malloc_mallocng_malloc.__malloc_size_classes ->
  p in bits(64) -> s in abi.World -> h in mp.G ->
  mallocng.holds_in(c, app(h, "A"), app(s, "vm"), app(h, "blocks")) -> abi.thread_ok(app(s, "vm"), app(s, "fs_base")) ->
  i in omega -> mallocng.starts_at(app(h, "A"), g, i, p) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(app(g1, regs), s, o) -> runs(app(c_src_malloc_mallocng_malloc.get_slot_index_fun(), regs), s, o)) ->
  gc.regs_ok(regs, seq_one(gimple.arg(64, p))) -> runs(app(c_src_malloc_mallocng_malloc.get_meta_fun(g0, g1), regs), s, o2) ->
  (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex r. o2 = ok(fn_update(s, "vm", app(s, "vm")), r) && bits_of_int(64, fst(r)) = g)
proof
  assume hc hctx hsct hp hs hh hin hth hi hst hg1 hro h2
  have rl rn r0 := apply(gc.regs1, hp, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  have o1: ord_le(1, seq_len(regs)) by defs(simp(rn), ord_le)
  have bp: bits_of_int(64, app(regs, 0)) = p by defs(simp(r0, hp), bits_of_int, pow2)
  have gb: g in bits(64) proof
    have iu _ _ := expand(hst, mallocng.starts_at)
    have hu _ _ hat := mp(all_elim(mp.g_rec, {h}), hh)
    have gtop _ := apply(mp.meta_word, hc, (app(h, "A") in univ(1) by simp(hu)), hat, hin, iu)
    have go _ _ := apply(mp.meta_mem, hc, (app(h, "A") in univ(1) by simp(hu)), hat, hin, iu)
    show by arith(gtop, go)
  qed
  have pc: all o. runs(c_src_malloc_mallocng_malloc.get_meta(bits_of_int(64, app(regs, 0)), g0, g1), s, o) ->
      (ex vm. vm in x86_64_linux.Vm && o = exc(fn_update(s, "vm", vm), exc_val("stack_overflow", empty))) || o = ok(s, g) proof
    fix o
    assume hr
    have e _ := apply(mp.gm_run[c := c, p := p, s := s, h := h, o := o, g := g, i := i, g0 := g0, g1 := g1], hc, hctx, hsct, hp, hs, hh, hin, hth, hi, hst, hg1, rewrite(bp, hr))
    show := e
  qed
  have res: all o. runs(gimple.result(64, g), s, o) -> ex u. u in bits(64) && bits_of_int(64, u) = g && o = ok(s, u) proof
    fix o
    assume hr
    have e := mp(all_elim(g.result64_inv, {s}, {g}, {o}), gb, hr)
    show by ex_intro({g}, taut(gb, (bits_of_int(64, g) = g by simp(gb)), e))
  qed
  have hf: runs(app(fn_build(set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)), x0. mkprog(x1 x2. !ord_le(1, seq_len(x0)) || bind_rel(c_src_malloc_mallocng_malloc.get_meta(bits_of_int(64, app(x0, 0)), g0, g1), x1, x3 x4. letin(x4, x5. bind_rel(gimple.result(64, x5), x3, x6 x7. any_rel(x8. x8 in bits(64), x8. x2 = ok(x6, pair(x7, x8))),
    x6 x7. x2 = exc(x6, x7), x6. x2 = diverge(x6))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))), regs), s, o2) := expand(h2, c_src_malloc_mallocng_malloc.get_meta_fun)
  show := apply(g.fun_q[p := x0. c_src_malloc_mallocng_malloc.get_meta(bits_of_int(64, app(x0, 0)), g0, g1), w := 64, n := 1, regs := regs, s := s, o2 := o2, v := g], ra, o1, hs, pc, res, hf)
qed

// get_meta's code by its purpose: its contract, the ghost part kept
theorem mp.gm: all c p g0 g1. c in mallocng.Cfg ->
  app(c, "ctx") = c_src_malloc_mallocng_malloc.__malloc_context -> app(c, "sct") = c_src_malloc_mallocng_malloc.__malloc_size_classes -> p in bits(64) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(app(g1, regs), s, o) -> runs(app(c_src_malloc_mallocng_malloc.get_slot_index_fun(), regs), s, o)) ->
  refines_ghost(c_src_malloc_mallocng_malloc.get_meta(p, g0, g1), mallocng_purpose.get_meta_purpose(c, p), abi.World, mp.G)
proof
  fix c p g0 g1
  assume hc hctx hsct hp hg1
  have rp: all s o. runs(c_src_malloc_mallocng_malloc.get_meta(p, g0, g1), s, o) -> pair(s, o) in univ(1) proof
    fix s o
    assume hr
    show := apply(g.runs_univ, expand(hr, c_src_malloc_mallocng_malloc.get_meta))
  qed
  have body: all s h o. s in abi.World -> h in mp.G -> runs(c_src_malloc_mallocng_malloc.get_meta(p, g0, g1), s, o) ->
      ((mallocng.holds_in(c, app(union2(s, h), "A"), app(union2(s, h), "vm"), app(union2(s, h), "blocks")) && abi.thread_ok(app(union2(s, h), "vm"), app(union2(s, h), "fs_base"))) &&
        (ex g i. (g in omega && i in omega) && mallocng.starts_at(app(union2(s, h), "A"), g, i, p))) ->
      (ex v. v in x86_64_linux.Vm && o = exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty))) ||
      (ex s1 v. o = ok(s1, v) && any_rel(x3. x3 in bits(64) && (ex x4. x4 in omega && mallocng.starts_at(app(union2(s, h), "A"), x3, x4, p)),
        x3. exc(pair(union2(s1, h), empty), pair("ret", v)) = exc(pair(union2(s, h), empty), pair("ret", x3)))) proof
    fix s h o
    assume hs hh hr hpre
    have _ hd _ _ := mp(all_elim(mp.g_rec, {h}), hh)
    have sd: dom(s) = insert("vm", insert("os", insert("fs_base", insert("cpu", insert("objs", empty))))) by simp(expand(hs, abi.World))
    have hin: mallocng.holds_in(c, app(h, "A"), app(s, "vm"), app(h, "blocks")) by simp(hpre, sd, hd)
    have hth: abi.thread_ok(app(s, "vm"), app(s, "fs_base")) by simp(hpre, sd, hd)
    have ex1: ex g i. (g in omega && i in omega) && mallocng.starts_at(app(h, "A"), g, i, p) by simp(hpre, sd, hd)
    obtain g i, hg hi hst from ex1
    have oc gb := apply(mp.gm_run[c := c, p := p, s := s, h := h, o := o, g := g, i := i, g0 := g0, g1 := g1], hc, hctx, hsct, hp, hs, hh, hin, hth, hi, hst, hg1, hr)
    have sa: mallocng.starts_at(app(union2(s, h), "A"), g, i, p) by simp(hst, sd, hd)
    have e4: ex x4. x4 in omega && mallocng.starts_at(app(union2(s, h), "A"), g, x4, p) by ex_intro({i}, taut(hi, sa))
    have e3: ex x3. (x3 in bits(64) && (ex x4. x4 in omega && mallocng.starts_at(app(union2(s, h), "A"), x3, x4, p))) && exc(pair(union2(s, h), empty), pair("ret", g)) = exc(pair(union2(s, h), empty), pair("ret", x3))
      by ex_intro({g}, taut(gb, e4, refl({exc(pair(union2(s, h), empty), pair("ret", g))})))
    have bS: any_rel(x3. x3 in bits(64) && (ex x4. x4 in omega && mallocng.starts_at(app(union2(s, h), "A"), x3, x4, p)), x3. exc(pair(union2(s, h), empty), pair("ret", g)) = exc(pair(union2(s, h), empty), pair("ret", x3)))
      by defs(taut(e3), any_rel)
    have k: o = ok(s, g) -> (ex s1 v. o = ok(s1, v) && any_rel(x3. x3 in bits(64) && (ex x4. x4 in omega && mallocng.starts_at(app(union2(s, h), "A"), x3, x4, p)),
        x3. exc(pair(union2(s1, h), empty), pair("ret", v)) = exc(pair(union2(s, h), empty), pair("ret", x3)))) proof
      assume ho
      show by ex_intro({s}, {g}, taut(ho, bS))
    qed
    show by taut(oc, k)
  qed
  show by defs(apply(ct.refines_contract, mp.g_world, rp, body), mallocng_purpose.get_meta_purpose)
qed

theorem mp.gm_fun: all c regs g0 g1. c in mallocng.Cfg ->
  app(c, "ctx") = c_src_malloc_mallocng_malloc.__malloc_context -> app(c, "sct") = c_src_malloc_mallocng_malloc.__malloc_size_classes ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(app(g1, regs), s, o) -> runs(app(c_src_malloc_mallocng_malloc.get_slot_index_fun(), regs), s, o)) ->
  regs in abi.ARGS ->
  refines_ghost(app(c_src_malloc_mallocng_malloc.get_meta_fun(g0, g1), regs), app(mallocng_purpose.get_meta_purpose_fun(c), regs), abi.World, mp.G)
proof
  fix c regs g0 g1
  assume hc hctx hsct hg1 hr
  have hm: all regs. refines_ghost(c_src_malloc_mallocng_malloc.get_meta(bits_of_int(64, app(regs, 0)), g0, g1), mallocng_purpose.get_meta_purpose(c, bits_of_int(64, app(regs, 0))), abi.World, mp.G) proof
    fix regs
    show := mp(all_elim(mp.gm, {c}, {bits_of_int(64, app(regs, 0))}, {g0}, {g1}), hc, hctx, hsct, simp(), hg1)
  qed
  have w := mp(g.fun_res_ghost[p := x0. c_src_malloc_mallocng_malloc.get_meta(bits_of_int(64, app(x0, 0)), g0, g1), q := x0. mallocng_purpose.get_meta_purpose(c, bits_of_int(64, app(x0, 0))), w := 64, n := 1, G := mp.G], mp.g_univ, hm)
  show by defs(mp(all_elim(w, {regs}), hr), c_src_malloc_mallocng_malloc.get_meta_fun, mallocng_purpose.get_meta_purpose_fun, letin)
qed

// get_meta's machine code (linked with a_crash's spec and get_slot_index's
// code) implements its purpose (the code's divergence a raise: a premise)
theorem mp.gm_implements: all c statics. c in mallocng.Cfg ->
  app(c, "ctx") = c_src_malloc_mallocng_malloc.__malloc_context -> app(c, "sct") = c_src_malloc_mallocng_malloc.__malloc_size_classes ->
  tr.div_raises(c_src_malloc_mallocng_malloc.get_meta_fun(mallocng_specs.a_crash_spec_fun(), c_src_malloc_mallocng_malloc_cfg.get_slot_index_fun())) ->
  abi.implements2_at(mp.G, 4206837, mallocng_purpose.get_meta_purpose_fun(c), 4198400, text.code, statics)
proof
  fix c statics
  assume hc hctx hsct hdr
  let LOW := c_src_malloc_mallocng_malloc.get_meta_fun(mallocng_specs.a_crash_spec_fun(), c_src_malloc_mallocng_malloc_cfg.get_slot_index_fun())
  have r: all args. args in abi.ARGS -> refines_ghost(app(LOW, args), app(mallocng_purpose.get_meta_purpose_fun(c), args), abi.World, mp.G) proof
    fix args
    assume ha
    show := mp(all_elim(mp.gm_fun, {c}, {args}, {mallocng_specs.a_crash_spec_fun()}, {c_src_malloc_mallocng_malloc_cfg.get_slot_index_fun()}), hc, hctx, hsct, get_slot_index_ref, ha)
  qed
  have st := mp(all_elim(tr.implements_refine, {4206837}, {c_src_malloc_mallocng_malloc_cfg.get_meta_fun(mallocng_specs.a_crash_spec_fun(), c_src_malloc_mallocng_malloc_cfg.get_slot_index_fun())}, {LOW},
    {4198400}, {text.code}, {statics}), all_elim(gmtc.linked, {statics}), all_elim(get_meta_ref, {mallocng_specs.a_crash_spec_fun()}, {c_src_malloc_mallocng_malloc_cfg.get_slot_index_fun()}))
  show := mp(all_elim(tr.implements_abi_g, {mp.G}, {4206837}, {LOW}, {mallocng_purpose.get_meta_purpose_fun(c)}, {4198400}, {text.code}, {statics}),
    mp.g_ok, hdr, st, r)
qed

// ----------------------------------------------------------------------
//  get_stride: its code refines its purpose

// get_stride's code by its purpose: the meta word it reads packs the
// group's fields (`mp.meta_word`), so its stride is the group's
// get_stride's contract, the ghost part h read: for g a group in use, the
// code returns its stride, the world unchanged
theorem mp.gst_run(c, g, s, h, o): c in mallocng.Cfg -> app(c, "sct") = c_src_malloc_mallocng_malloc.__malloc_size_classes -> g in bits(64) ->
  s in abi.World -> h in mp.G -> mallocng.holds_in(c, app(h, "A"), app(s, "vm"), app(h, "blocks")) -> mallocng.is_used(app(h, "A"), g) ->
  runs(c_src_malloc_mallocng_malloc.get_stride(g), s, o) -> o = ok(s, bits_of_int(64, mallocng.stride(app(app(app(h, "A"), "metas"), g))))
proof
  assume hc hsct hg hs hh hin hus hr
  have rp: all s o. runs(c_src_malloc_mallocng_malloc.get_stride(g), s, o) -> pair(s, o) in univ(1) proof
    fix s o
    assume hr
    show := apply(g.runs_univ, expand(hr, c_src_malloc_mallocng_malloc.get_stride))
  qed
    have hu hd hbt hat := mp(all_elim(mp.g_rec, {h}), hh)
    let V0 := app(s, "vm")
    let A := app(h, "A")
    let B := app(h, "blocks")
    let V := app(app(A, "metas"), g)
    have au: A in univ(1) by simp(hu)
    have go: g in omega by simp(hg)
    // the meta's word: its fields packed
    have top mw := apply(mp.meta_word, hc, au, hat, hin, hus)
    have H := expand(hin, mallocng.holds_in)
    have _ _ _ _ _ uo _ _ _ _ _ _ _ _ _ := expand(H, mallocng.holds)
    have gok := apply(mp.used_group, uo, hus)
    have mim sc _ _ _ _ _ _ _ _ big _ _ _ := expand(gok, mallocng.group_ok)
    have _ _ _ _ _ _ bl bf bs := expand(mim, mallocng.meta_in_memory)
    have vt: V in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := app(A, "metas"), x := g], simp(hat), go)
    have vl: app(V, "last_idx") in omega by simp(vt)
    have vf: app(V, "freeable") in omega by simp(vt)
    have vs: app(V, "sizeclass") in omega by simp(vt)
    have vm: app(V, "maplen") in omega by simp(vt)
    let W := mallocng_specs.mword(V0, g)
    have w32: int_mod(W, 32) = app(V, "last_idx") by arith(mw, bl, bf, bs, vl, vf, vs, vm)
    have w4k: int_div(W, 4096) = app(V, "maplen") by arith(mw, bl, bf, bs, vl, vf, vs, vm)
    have w64: int_mod(int_div(W, 64), 64) = app(V, "sizeclass") by arith(mw, bl, bf, bs, vl, vf, vs, vm)
    have msi: mallocng_specs.mapped_single(V0, g) <-> app(V, "last_idx") = 0 && int_lt(0, app(V, "maplen"))
      by defs(simp(w32, w4k, vm), mallocng_specs.mapped_single)
    have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
    have sw: mallocng_specs.stride_w(V0, g) = mallocng.stride(V) by defs(simp(msi, w4k, w64, cu), mallocng_specs.stride_w, mallocng.stride)
    // the memory-level conditions: the word readable, the class table
    have _ g24 inr := apply(mp.meta_mem, hc, au, hat, hin, hus)
    let FP := mallocng.footprint(c, A, B)
    have bj: all j. j in omega -> int_lt(j, 8) -> int_add(int_add(g, 32), j) in FP && mallocng.m_mapped(mallocng.mview(V0, FP), int_add(int_add(g, 32), j)) &&
        app(app(snd(mallocng.pg(mallocng.mview(V0, FP), int_add(int_add(g, 32), j))), "prot"), "r") && !(app(snd(mallocng.pg(mallocng.mview(V0, FP), int_add(int_add(g, 32), j))), "kind") = 2) proof
      fix j
      assume hj hjl
      have r1 r2 r3 := mp(all_elim(inr, {int_add(int_add(g, 32), j)}), (int_add(int_add(g, 32), j) in omega by arith(go, hj)),
        (int_le(g, int_add(int_add(g, 32), j)) by arith(go, hj)), (int_lt(int_add(int_add(g, 32), j), int_add(g, 40)) by arith(go, hj, hjl)))
      show by taut(r1, expand(r2, mallocng.m_rw), r3)
    qed
    have us := apply(mp.view_usable[vm := V0, fp := FP, objs := app(s, "objs"), a := int_add(g, 32), n := 8], (int_add(g, 32) in omega by arith(go)), bj)
    have tb := apply(mp.classes_table[c := c, A := A, vm := V0, b := B, objs := app(s, "objs")], hc, au, hat, hin)
    have gpre: mallocng_specs.get_stride_pre(V0, app(s, "objs"), c_src_malloc_mallocng_malloc.__malloc_size_classes, g)
      by defs(simp(top, us, rewrite(hsct, tb), msi, w64, sc, big, g24, go), mallocng_specs.get_stride_pre)
    // the code's run: the stride returned
    have su: s in univ(1) by simp(mp(all_elim(rp, {s}, {o}), hr))
    have oe := apply(ms.gs_run, {g}, {s}, {o}, hg, hs, su, gpre, hr)
    show by simp(oe, sw)
qed

// get_stride's contract at a call (its C function value)
theorem mp.gst_q(c, regs, s, h, g, o2): c in mallocng.Cfg -> app(c, "sct") = c_src_malloc_mallocng_malloc.__malloc_size_classes -> g in bits(64) ->
  s in abi.World -> h in mp.G -> mallocng.holds_in(c, app(h, "A"), app(s, "vm"), app(h, "blocks")) -> mallocng.is_used(app(h, "A"), g) ->
  gc.regs_ok(regs, seq_one(gimple.arg(64, g))) -> runs(app(c_src_malloc_mallocng_malloc.get_stride_fun(), regs), s, o2) ->
  (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex r. o2 = ok(fn_update(s, "vm", app(s, "vm")), r) && bits_of_int(64, fst(r)) = bits_of_int(64, mallocng.stride(app(app(app(h, "A"), "metas"), g))))
proof
  assume hc hsct hg hs hh hin hus hro h2
  let SV := bits_of_int(64, mallocng.stride(app(app(app(h, "A"), "metas"), g)))
  have rl rn r0 := apply(gc.regs1, hg, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  have o1: ord_le(1, seq_len(regs)) by defs(simp(rn), ord_le)
  have bp: bits_of_int(64, app(regs, 0)) = g by defs(simp(r0, hg), bits_of_int, pow2)
  have pc: all o. runs(c_src_malloc_mallocng_malloc.get_stride(bits_of_int(64, app(regs, 0))), s, o) ->
      (ex vm. vm in x86_64_linux.Vm && o = exc(fn_update(s, "vm", vm), exc_val("stack_overflow", empty))) || o = ok(s, SV) proof
    fix o
    assume hr
    have e := apply(mp.gst_run[c := c, g := g, s := s, h := h, o := o], hc, hsct, hg, hs, hh, hin, hus, rewrite(bp, hr))
    show by taut(e)
  qed
  have sb: SV in bits(64) by defs(simp(), bits_of_int, pow2)
  have res: all o. runs(gimple.result(64, SV), s, o) -> ex u. u in bits(64) && bits_of_int(64, u) = SV && o = ok(s, u) proof
    fix o
    assume hr
    have e := mp(all_elim(g.result64_inv, {s}, {SV}, {o}), sb, hr)
    show by ex_intro({SV}, taut(sb, (bits_of_int(64, SV) = SV by simp(sb)), e))
  qed
  have hf: runs(app(fn_build(set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)), x0. mkprog(x1 x2. !ord_le(1, seq_len(x0)) || bind_rel(c_src_malloc_mallocng_malloc.get_stride(bits_of_int(64, app(x0, 0))), x1, x3 x4. letin(x4, x5. bind_rel(gimple.result(64, x5), x3, x6 x7. any_rel(x8. x8 in bits(64), x8. x2 = ok(x6, pair(x7, x8))),
    x6 x7. x2 = exc(x6, x7), x6. x2 = diverge(x6))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))), regs), s, o2) := expand(h2, c_src_malloc_mallocng_malloc.get_stride_fun)
  show := apply(g.fun_q[p := x0. c_src_malloc_mallocng_malloc.get_stride(bits_of_int(64, app(x0, 0))), w := 64, n := 1, regs := regs, s := s, o2 := o2, v := SV], ra, o1, hs, pc, res, hf)
qed

// get_stride's code by its purpose: its contract, the ghost part kept
theorem mp.gst: all c g. c in mallocng.Cfg -> app(c, "sct") = c_src_malloc_mallocng_malloc.__malloc_size_classes -> g in bits(64) ->
  refines_ghost(c_src_malloc_mallocng_malloc.get_stride(g), mallocng_purpose.get_stride_purpose(c, g), abi.World, mp.G)
proof
  fix c g
  assume hc hsct hg
  have rp: all s o. runs(c_src_malloc_mallocng_malloc.get_stride(g), s, o) -> pair(s, o) in univ(1) proof
    fix s o
    assume hr
    show := apply(g.runs_univ, expand(hr, c_src_malloc_mallocng_malloc.get_stride))
  qed
  have body: all s h o. s in abi.World -> h in mp.G -> runs(c_src_malloc_mallocng_malloc.get_stride(g), s, o) ->
      (mallocng.holds_in(c, app(union2(s, h), "A"), app(union2(s, h), "vm"), app(union2(s, h), "blocks")) && mallocng.is_used(app(union2(s, h), "A"), g)) ->
      (ex v. v in x86_64_linux.Vm && o = exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty))) ||
      (ex s1 v. o = ok(s1, v) && exc(pair(union2(s1, h), empty), pair("ret", v)) = exc(pair(union2(s, h), empty), pair("ret", bits_of_int(64, mallocng.stride(app(app(app(union2(s, h), "A"), "metas"), g)))))) proof
    fix s h o
    assume hs hh hr hpre
    have _ hd _ _ := mp(all_elim(mp.g_rec, {h}), hh)
    have sd: dom(s) = insert("vm", insert("os", insert("fs_base", insert("cpu", insert("objs", empty))))) by simp(expand(hs, abi.World))
    have hin: mallocng.holds_in(c, app(h, "A"), app(s, "vm"), app(h, "blocks")) by simp(hpre, sd, hd)
    have hus: mallocng.is_used(app(h, "A"), g) by simp(hpre, sd, hd)
    have oe := apply(mp.gst_run[c := c, g := g, s := s, h := h, o := o], hc, hsct, hg, hs, hh, hin, hus, hr)
    have ra: app(app(app(union2(s, h), "A"), "metas"), g) = app(app(app(h, "A"), "metas"), g) by simp(sd, hd)
    have fin: ex s1 v. o = ok(s1, v) && exc(pair(union2(s1, h), empty), pair("ret", v)) = exc(pair(union2(s, h), empty), pair("ret", bits_of_int(64, mallocng.stride(app(app(app(union2(s, h), "A"), "metas"), g)))))
      by ex_intro({s}, {bits_of_int(64, mallocng.stride(app(app(app(h, "A"), "metas"), g)))}, simp(oe, ra))
    show by taut(fin)
  qed
  show by defs(apply(ct.refines_contract, mp.g_world, rp, body), mallocng_purpose.get_stride_purpose)
qed

theorem mp.gst_fun: all c regs. c in mallocng.Cfg -> app(c, "sct") = c_src_malloc_mallocng_malloc.__malloc_size_classes -> regs in abi.ARGS ->
  refines_ghost(app(c_src_malloc_mallocng_malloc.get_stride_fun(), regs), app(mallocng_purpose.get_stride_purpose_fun(c), regs), abi.World, mp.G)
proof
  fix c regs
  assume hc hsct hr
  have hm: all regs. refines_ghost(c_src_malloc_mallocng_malloc.get_stride(bits_of_int(64, app(regs, 0))), mallocng_purpose.get_stride_purpose(c, bits_of_int(64, app(regs, 0))), abi.World, mp.G) proof
    fix regs
    show := mp(all_elim(mp.gst, {c}, {bits_of_int(64, app(regs, 0))}), hc, hsct, simp())
  qed
  have w := mp(g.fun_res_ghost[p := x0. c_src_malloc_mallocng_malloc.get_stride(bits_of_int(64, app(x0, 0))), q := x0. mallocng_purpose.get_stride_purpose(c, bits_of_int(64, app(x0, 0))), w := 64, n := 1, G := mp.G], mp.g_univ, hm)
  show by defs(mp(all_elim(w, {regs}), hr), c_src_malloc_mallocng_malloc.get_stride_fun, mallocng_purpose.get_stride_purpose_fun, letin)
qed

// (the code's divergence a raise: a premise, as for the functions linked
// in proofs/mallocng_link.core)
theorem mp.gst_implements: all c statics. c in mallocng.Cfg -> app(c, "sct") = c_src_malloc_mallocng_malloc.__malloc_size_classes ->
  tr.div_raises(c_src_malloc_mallocng_malloc.get_stride_fun()) ->
  abi.implements2_at(mp.G, 4207440, mallocng_purpose.get_stride_purpose_fun(c), 4198400, text.code, statics)
proof
  fix c statics
  assume hc hsct hdr
  have r: all args. args in abi.ARGS -> refines_ghost(app(c_src_malloc_mallocng_malloc.get_stride_fun(), args), app(mallocng_purpose.get_stride_purpose_fun(c), args), abi.World, mp.G) proof
    fix args
    assume ha
    show := mp(all_elim(mp.gst_fun, {c}, {args}), hc, hsct, ha)
  qed
  have st := mp(all_elim(tr.implements_refine, {4207440}, {c_src_malloc_mallocng_malloc_cfg.get_stride_fun()}, {c_src_malloc_mallocng_malloc.get_stride_fun()},
    {4198400}, {text.code}, {statics}), all_elim(gstc.implements, {statics}), gst_ref)
  show := mp(all_elim(tr.implements_abi_g, {mp.G}, {4207440}, {c_src_malloc_mallocng_malloc.get_stride_fun()}, {mallocng_purpose.get_stride_purpose_fun(c)}, {4198400}, {text.code}, {statics}),
    mp.g_ok, hdr, st, r)
qed
