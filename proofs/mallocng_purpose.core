               int_mod(int_sub(x4, mallocng.slot_start(app(app(app(U, "A"), "metas"), g), idx)), mallocng.UNIT) = 0) &&
               int_lt(x4, int_add(mallocng.slot_start(app(app(app(U, "A"), "metas"), g), idx), int_mul(256, mallocng.UNIT)))) &&
               int_le(int_add(x4, n), mallocng.slot_end(app(app(app(U, "A"), "metas"), g), idx))),
