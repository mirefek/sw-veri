      hsp, hal, hpl, h4k, se63, o16, hcls, chk0, end0, hss)
    show by ex_intro({P}, {W}, taut(hpb, hsp, halu, (int_lt(P, int_add(SS, int_mul(256, mallocng.UNIT))) by arith(h4k, cu)), hpl, hWv, fr, ho))
  qed
  show by taut(eff, k)
