      ((((((((mallocng.holds_in(c, app(union2(s, h), "A"), app(union2(s, h), "vm"), app(union2(s, h), "blocks")) && abi.thread_ok(app(union2(s, h), "vm"), app(union2(s, h), "fs_base"))) &&
        mallocng.is_used(app(union2(s, h), "A"), g)) && mallocng.reserved_only(app(union2(s, h), "A"), g, idx)) &&
        mallocng.slot_rw(app(union2(s, h), "vm"), app(app(app(union2(s, h), "A"), "metas"), g), idx)) &&
