    assume hs hh hin hr
    have hu _ _ hat := mp(all_elim(mp.g_rec, {h}), hh)
    have pre := apply(mp.ab_pre[c := c, A := app(h, "A"), vm := app(s, "vm"), b := app(h, "blocks"), objs := app(s, "objs"), sc := sc], hc, (app(h, "A") in univ(1) by simp(hu)), hat, hx, hsc, hin)
    have oe := mp(all_elim(ms.ab_run, {sc}, {s}, {o}), hsc, hs, pre, hr)
    have pv _ _ _ := apply(ms.world_parts, hs)
    have co cv := apply(mp.ab_only[c := c, vm := app(s, "vm"), sc := sc], pv, hx, hsc)
    show by ex_intro({mallocng_specs.account_vm(app(s, "vm"), c_src_malloc_mallocng_malloc.__malloc_context, sc)}, taut(cv, co, oe))
