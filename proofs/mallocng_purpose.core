               int_mod(int_sub(x4, mallocng.slot_start(app(app(app(U, "A"), "metas"), g), idx)), mallocng.UNIT) = 0) &&
               int_lt(x4, int_add(mallocng.slot_start(app(app(app(U, "A"), "metas"), g), idx), int_mul(256, mallocng.UNIT)))) &&
               int_le(int_add(x4, n), mallocng.slot_end(app(app(app(U, "A"), "metas"), g), idx))),
            x4. letin(x4, x5. any_rel(x6. x6 in x86_64_linux.Vm &&
              mallocng_purpose.framed(x3, app(fn_update(U, "vm", x6), "vm"), app(app(app(fn_update(U, "vm", x6), "A"), "metas"), g), idx, x5, n),
            x6. letin(fn_update(U, "vm", x6), x7. exc(pair(union2(s1, h), empty), pair("ret", v)) = exc(pair(x7, empty), pair("ret", x5)))))))) proof
      assume e
      obtain P W, hpb hsp hal h4k hpl hWv hfr ho from e
