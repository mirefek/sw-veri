    show by defs(r2, mallocng_purpose.get_stride_purpose)
  qed
  show by defs(apply(ct.fun_divg, mp.g_univ, qu, qd), mallocng_purpose.get_stride_purpose_fun)
qed

theorem mp.gst_implements: all c statics. c in mallocng.Cfg -> app(c, "sct") = c_src_malloc_mallocng_malloc.__malloc_size_classes ->
