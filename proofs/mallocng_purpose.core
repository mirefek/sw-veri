    have hro: mallocng.reserved_only(app(h, "A"), g, idx) by simp(hpre, sd, hd)
    have hrw: mallocng.slot_rw(app(s, "vm"), V, idx) by simp(hpre, sd, hd)
    have hns: int_le(int_add(n, mallocng.IB), mallocng.stride(V)) by simp(hpre, sd, hd)
    have hs31: int_lt(mallocng.stride(V), int_pow(2, 31)) by simp(hpre, sd, hd)
    have hcls: int_lt(app(V, "sizeclass"), 48) -> int_lt(int_sub(int_sub(mallocng.slot_end(V, idx), n), mallocng.storage(V)), int_mul(int_mul(mallocng.UNIT, app(mallocng.size_classes, app(V, "sizeclass"))), int_add(idx, 1)))
      by simp(hpre, sd, hd)
    have hfs: int_le(int_add(app(s, "fs_base"), 8), int_sub(mallocng.slot_start(V, idx), mallocng.IB)) || int_le(mallocng.slot_end(V, idx), app(s, "fs_base")) by simp(hpre, sd, hd)
    have oc := apply(mp.ef_run[c := c, g := g, idx := idx, n := n, ctr := ctr, s := s, h := h, o := o, g0 := g0, g1 := g1, g2 := g2],
      hc, hsct, hg, hi, hn, hctr, hs, hh, hin, hth, hus, hro, hrw, hns, hs31, hcls, hfs, hg0, hg2, hr)
    have lv: all z. z in h -> fst(z) != "vm" proof
      fix z
      assume hz
      show by simp(mp(all_elim(hk, {z}), hz))
    qed
    have k: (ex P W. (((P in bits(64) && ((int_le(mallocng.slot_start(V, idx), P) && int_mod(int_sub(P, mallocng.slot_start(V, idx)), mallocng.UNIT) = 0) &&
          int_lt(P, int_add(mallocng.slot_start(V, idx), int_mul(256, mallocng.UNIT))))) && int_le(int_add(P, n), mallocng.slot_end(V, idx))) &&
          (W in x86_64_linux.Vm && mallocng_purpose.framed(app(s, "vm"), W, V, idx, P, n))) && o = ok(fn_update(s, "vm", W), P)) ->
        (ex s1 v. o = ok(s1, v) &&
          letin(app(U, "vm"), x3. any_rel(x4. x4 in bits(64) &&
            (((int_le(mallocng.slot_start(app(app(app(U, "A"), "metas"), g), idx), x4) &&
               int_mod(int_sub(x4, mallocng.slot_start(app(app(app(U, "A"), "metas"), g), idx)), mallocng.UNIT) = 0) &&
               int_lt(x4, int_add(mallocng.slot_start(app(app(app(U, "A"), "metas"), g), idx), int_mul(256, mallocng.UNIT)))) &&
               int_le(int_add(x4, n), mallocng.slot_end(app(app(app(U, "A"), "metas"), g), idx))),
            x4. letin(x4, x5. any_rel(x6. x6 in x86_64_linux.Vm &&
              mallocng_purpose.framed(x3, app(fn_update(U, "vm", x6), "vm"), app(app(app(fn_update(U, "vm", x6), "A"), "metas"), g), idx, x5, n),
            x6. letin(fn_update(U, "vm", x6), x7. exc(pair(union2(s1, h), empty), pair("ret", v)) = exc(pair(x7, empty), pair("ret", x5)))))))) proof
      assume e
      obtain P W, hpb hsp hal h4k hpl hWv hfr ho from e
      let S1 := fn_update(s, "vm", W)
      have eu := mp(fn_update_union_l[a := s, b := h, k := "vm", v := W], lv)
      have fr2: mallocng_purpose.framed(app(U, "vm"), app(fn_update(U, "vm", W), "vm"), app(app(app(fn_update(U, "vm", W), "A"), "metas"), g), idx, P, n) by simp(hfr, sd, hd)
      have xq: exc(pair(union2(S1, h), empty), pair("ret", P)) = exc(pair(fn_update(U, "vm", W), empty), pair("ret", P)) by simp(eu)
      have e6: ex x6. (x6 in x86_64_linux.Vm &&
          mallocng_purpose.framed(app(U, "vm"), app(fn_update(U, "vm", x6), "vm"), app(app(app(fn_update(U, "vm", x6), "A"), "metas"), g), idx, P, n)) &&
          exc(pair(union2(S1, h), empty), pair("ret", P)) = exc(pair(fn_update(U, "vm", x6), empty), pair("ret", P))
        by ex_intro({W}, taut(hWv, fr2, xq))
      have g4: (((int_le(mallocng.slot_start(app(app(app(U, "A"), "metas"), g), idx), P) &&
          int_mod(int_sub(P, mallocng.slot_start(app(app(app(U, "A"), "metas"), g), idx)), mallocng.UNIT) = 0) &&
          int_lt(P, int_add(mallocng.slot_start(app(app(app(U, "A"), "metas"), g), idx), int_mul(256, mallocng.UNIT)))) &&
          int_le(int_add(P, n), mallocng.slot_end(app(app(app(U, "A"), "metas"), g), idx))) by simp(hsp, hal, h4k, hpl, sd, hd)
      have e4: ex x4. (x4 in bits(64) && (((int_le(mallocng.slot_start(app(app(app(U, "A"), "metas"), g), idx), x4) &&
          int_mod(int_sub(x4, mallocng.slot_start(app(app(app(U, "A"), "metas"), g), idx)), mallocng.UNIT) = 0) &&
          int_lt(x4, int_add(mallocng.slot_start(app(app(app(U, "A"), "metas"), g), idx), int_mul(256, mallocng.UNIT)))) &&
          int_le(int_add(x4, n), mallocng.slot_end(app(app(app(U, "A"), "metas"), g), idx)))) &&
          (!(ex x6. x6 in x86_64_linux.Vm &&
              mallocng_purpose.framed(app(U, "vm"), app(fn_update(U, "vm", x6), "vm"), app(app(app(fn_update(U, "vm", x6), "A"), "metas"), g), idx, x4, n)) ||
           (ex x6. (x6 in x86_64_linux.Vm &&
              mallocng_purpose.framed(app(U, "vm"), app(fn_update(U, "vm", x6), "vm"), app(app(app(fn_update(U, "vm", x6), "A"), "metas"), g), idx, x4, n)) &&
              exc(pair(union2(S1, h), empty), pair("ret", P)) = exc(pair(fn_update(U, "vm", x6), empty), pair("ret", x4))))
        by ex_intro({P}, taut(hpb, g4, e6))
      have bB: letin(app(U, "vm"), x3. any_rel(x4. x4 in bits(64) &&
            (((int_le(mallocng.slot_start(app(app(app(U, "A"), "metas"), g), idx), x4) &&
               int_mod(int_sub(x4, mallocng.slot_start(app(app(app(U, "A"), "metas"), g), idx)), mallocng.UNIT) = 0) &&
               int_lt(x4, int_add(mallocng.slot_start(app(app(app(U, "A"), "metas"), g), idx), int_mul(256, mallocng.UNIT)))) &&
               int_le(int_add(x4, n), mallocng.slot_end(app(app(app(U, "A"), "metas"), g), idx))),
            x4. letin(x4, x5. any_rel(x6. x6 in x86_64_linux.Vm &&
              mallocng_purpose.framed(x3, app(fn_update(U, "vm", x6), "vm"), app(app(app(fn_update(U, "vm", x6), "A"), "metas"), g), idx, x5, n),
            x6. letin(fn_update(U, "vm", x6), x7. exc(pair(union2(S1, h), empty), pair("ret", P)) = exc(pair(x7, empty), pair("ret", x5)))))))
        by defs(taut(e4), letin, any_rel)
      show by ex_intro({S1}, {P}, taut(ho, bB))
    qed
    show by taut(oc, k)
  qed
  show by defs(apply(ct.refines_contract, mp.g_world, rp, body), mallocng_purpose.enframe_purpose)
qed

theorem mp.ef_fun: all c regs g0 g1 g2. c in mallocng.Cfg -> app(c, "sct") = c_src_malloc_mallocng_malloc.__malloc_size_classes ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(app(g0, regs), s, o) -> runs(app(c_src_malloc_mallocng_malloc.get_stride_fun(), regs), s, o)) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(app(g2, regs), s, o) -> runs(app(mallocng_purpose.set_size_purpose_fun(), regs), s, o)) ->
  regs in abi.ARGS ->
  refines_ghost(app(c_src_malloc_mallocng_malloc.enframe_fun(g0, g1, g2), regs), app(mallocng_purpose.enframe_purpose_fun(c), regs), abi.World, mp.G)
proof
  fix c regs g0 g1 g2
  assume hc hsct hg0 hg2 hr
  have hm: all regs. refines_ghost(c_src_malloc_mallocng_malloc.enframe(bits_of_int(64, app(regs, 0)), bits_of_int(32, app(regs, 1)), bits_of_int(64, app(regs, 2)), bits_of_int(32, app(regs, 3)), g0, g1, g2),
      mallocng_purpose.enframe_purpose(c, bits_of_int(64, app(regs, 0)), bits_of_int(32, app(regs, 1)), bits_of_int(64, app(regs, 2))), abi.World, mp.G) proof
    fix regs
    show := mp(all_elim(mp.ef, {c}, {bits_of_int(64, app(regs, 0))}, {bits_of_int(32, app(regs, 1))}, {bits_of_int(64, app(regs, 2))}, {bits_of_int(32, app(regs, 3))}, {g0}, {g1}, {g2}),
      hc, hsct, simp(), simp(), simp(), simp(), hg0, hg2)
  qed
  have w := mp(g.fun_res_ghost[p := x0. c_src_malloc_mallocng_malloc.enframe(bits_of_int(64, app(x0, 0)), bits_of_int(32, app(x0, 1)), bits_of_int(64, app(x0, 2)), bits_of_int(32, app(x0, 3)), g0, g1, g2),
    q := x0. mallocng_purpose.enframe_purpose(c, bits_of_int(64, app(x0, 0)), bits_of_int(32, app(x0, 1)), bits_of_int(64, app(x0, 2))), w := 64, n := 4, G := mp.G], mp.g_univ, hm)
  show by defs(mp(all_elim(w, {regs}), hr), c_src_malloc_mallocng_malloc.enframe_fun, mallocng_purpose.enframe_purpose_fun, letin)
qed

// (the purpose spec diverges nowhere it does not also raise: only where
// it allows anything)
theorem mp.ef_divg: all c. tr.div_raises_g(mp.G, mallocng_purpose.enframe_purpose_fun(c))
proof
  fix c
  have qu: all regs s o. runs(mallocng_purpose.enframe_purpose(c, bits_of_int(64, app(regs, 0)), bits_of_int(32, app(regs, 1)), bits_of_int(64, app(regs, 2))), s, o) -> pair(s, o) in univ(1) proof
    fix regs s o
    assume hr
    show := apply(g.runs_univ, expand(hr, mallocng_purpose.enframe_purpose))
  qed
  have qd: all regs w h t. regs in abi.ARGS -> w in abi.World -> w in univ(1) -> h in mp.G ->
      runs(mallocng_purpose.enframe_purpose(c, bits_of_int(64, app(regs, 0)), bits_of_int(32, app(regs, 1)), bits_of_int(64, app(regs, 2))), union2(w, h), diverge(t)) ->
      runs(mallocng_purpose.enframe_purpose(c, bits_of_int(64, app(regs, 0)), bits_of_int(32, app(regs, 1)), bits_of_int(64, app(regs, 2))), union2(w, h), exc(union2(w, h), empty)) proof
    fix regs w h t
    assume _ hw hwu hh hr
    let S := union2(w, h)
    let g := bits_of_int(64, app(regs, 0))
    let idx := bits_of_int(32, app(regs, 1))
    let n := bits_of_int(64, app(regs, 2))
    have {su = univ, sv = vm} := apply(mp.gS, hw, hwu, hh)
    have bp: all x x2. letin(app(S, "vm"), x3. any_rel(x4. x4 in bits(64) && (((int_le(mallocng.slot_start(app(app(app(S, "A"), "metas"), g), idx), x4) &&
          int_mod(int_sub(x4, mallocng.slot_start(app(app(app(S, "A"), "metas"), g), idx)), mallocng.UNIT) = 0) &&
          int_lt(x4, int_add(mallocng.slot_start(app(app(app(S, "A"), "metas"), g), idx), int_mul(256, mallocng.UNIT)))) && int_le(int_add(x4, n), mallocng.slot_end(app(app(app(S, "A"), "metas"), g), idx))),
          x4. letin(x4, x5. any_rel(x6. x6 in x86_64_linux.Vm && mallocng_purpose.framed(x3, app(fn_update(S, "vm", x6), "vm"), app(app(app(fn_update(S, "vm", x6), "A"), "metas"), g), idx, x5, n),
            x6. letin(fn_update(S, "vm", x6), x7. x = exc(pair(x7, empty), pair("ret", x5))))))) -> fst(x) = 2 ->
        letin(app(S, "vm"), x3. any_rel(x4. x4 in bits(64) && (((int_le(mallocng.slot_start(app(app(app(S, "A"), "metas"), g), idx), x4) && int_mod(int_sub(x4, mallocng.slot_start(app(app(app(S, "A"), "metas"), g), idx)), mallocng.UNIT) = 0) &&
          int_lt(x4, int_add(mallocng.slot_start(app(app(app(S, "A"), "metas"), g), idx), int_mul(256, mallocng.UNIT)))) && int_le(int_add(x4, n), mallocng.slot_end(app(app(app(S, "A"), "metas"), g), idx))),
          x4. letin(x4, x5. any_rel(x6. x6 in x86_64_linux.Vm && mallocng_purpose.framed(x3, app(fn_update(S, "vm", x6), "vm"), app(app(app(fn_update(S, "vm", x6), "A"), "metas"), g), idx, x5, n),
            x6. letin(fn_update(S, "vm", x6), x7. x2 = exc(pair(x7, empty), pair("ret", x5))))))) proof
      fix x x2
      assume h1 h2
      show by defs(apply(ct.dv_ret2, expand(h1, letin), h2), letin)
    qed
    have r2 := apply(ct.contract_div, su, sv, expand(hr, mallocng_purpose.enframe_purpose), bp)
    show by defs(r2, mallocng_purpose.enframe_purpose)
  qed
  show by defs(apply(ct.fun_divg, mp.g_univ, qu, qd), mallocng_purpose.enframe_purpose_fun)
qed

// enframe's machine code (linked with get_stride's and set_size's)
// implements its purpose
theorem mp.ef_implements: all c statics. c in mallocng.Cfg -> app(c, "sct") = c_src_malloc_mallocng_malloc.__malloc_size_classes ->
  abi.implements2_at(mp.G, 4207700, mallocng_purpose.enframe_purpose_fun(c), 4198400, text.code, statics)
proof
  fix c statics
  assume hc hsct
  have hdr := all_elim(mp.ef_divg, {c})
  let G0 := c_src_malloc_mallocng_malloc_cfg.get_stride_fun()
  let G1 := mallocng_specs.a_crash_spec_fun()
  let G2 := c_src_malloc_mallocng_malloc_cfg.set_size_fun()
  let LOW := c_src_malloc_mallocng_malloc.enframe_fun(G0, G1, G2)
  // set_size's machine-level callee: its CFG form refines its code, its code its purpose
  have h2: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(app(G2, regs), s, o) ->
      runs(app(mallocng_purpose.set_size_purpose_fun(), regs), s, o) proof
    fix regs s o
    assume h1 hl hs hr
    show := mp(all_elim(mp.ss_fun, {regs}, {s}, {o}), h1, hl, hs, mp(all_elim(set_size_ref, {regs}, {s}, {o}), h1, hl, hs, hr))
  qed
  have r: all args. args in abi.ARGS -> refines_ghost(app(LOW, args), app(mallocng_purpose.enframe_purpose_fun(c), args), abi.World, mp.G) proof
    fix args
    assume ha
    show := mp(all_elim(mp.ef_fun, {c}, {args}, {G0}, {G1}, {G2}), hc, hsct, gst_ref, h2, ha)
  qed
  have st := mp(all_elim(tr.implements_refine, {4207700}, {c_src_malloc_mallocng_malloc_cfg.enframe_fun(G0, G1, G2)}, {LOW},
    {4198400}, {text.code}, {statics}), all_elim(eftc.linked, {statics}), all_elim(enframe_ref, {G0}, {G1}, {G2}))
  show := mp(all_elim(tr.implements_abi_g, {mp.G}, {4207700}, {LOW}, {mallocng_purpose.enframe_purpose_fun(c)}, {4198400}, {text.code}, {statics}),
    mp.g_ok, hdr, st, r)
qed

// ----------------------------------------------------------------------
//  dequeue, dequeue_head: their code refines their purpose

// dequeue's code by its purpose: m out of the list at *phead holding it,
// the others' order kept, m's links cleared, nothing else written -- its
// effect (`ms.dq_run`) is that (`mp.dq_done`); the list gives its
// precondition (`mp.dq_pre`)
theorem mp.dq: all phead m. phead in bits(64) -> m in bits(64) ->
  refines(c_src_malloc_mallocng_malloc.dequeue(phead, m), mallocng_purpose.dequeue_purpose(phead, m), abi.World)
proof
  fix phead m
  assume hp hm
  have g: all s o. s in abi.World -> runs(c_src_malloc_mallocng_malloc.dequeue(phead, m), s, o) -> runs(mallocng_purpose.dequeue_purpose(phead, m), s, o) proof
    fix s o
    assume hw hr
    let V0 := app(s, "vm")
    let OB := app(s, "objs")
    have pu := apply(g.runs_univ, hr)
    have hu: s in univ(1) by simp(pu)
    let PRE := ex x2. ex x3. (x2 in list_type(omega) && x3 in omega) && ((mallocng_purpose.list_at(V0, OB, phead, x2) && int_lt(x3, seq_len(x2))) && app(x2, x3) = m)
    have np: !PRE -> runs(mallocng_purpose.dequeue_purpose(phead, m), s, o) proof
      assume hn0
      show by simp(pu, hn0, keep(abi.overflow, mallocng_purpose.list_at, mallocng_purpose.dequeued))
    qed
    have yp: PRE -> runs(mallocng_purpose.dequeue_purpose(phead, m), s, o) proof
      assume hpre
      obtain l, hl0 from hpre
      obtain k, hl hk hq from hl0
      have H: mallocng_purpose.list_at(V0, OB, phead, l) by taut(hq)
      have hkl: int_lt(k, seq_len(l)) by taut(hq)
      have hlk: app(l, k) = m by taut(hq)
      have {pv = mem, pb = bytes} := apply(ms.world_parts, hw)
      have {dp = pre} := apply(mp.dq_pre[vm := V0, objs := OB, phead := phead, m := m, l := l, k := k], pb, hp, hm, hl, hk, hkl, hlk, H)
      have oe := apply(ms.dq_run, {phead}, {m}, {s}, {o}, hp, hm, hw, hu, dp, hr)
      let V1 := mallocng_specs.dequeue_vm(V0, phead, m)
      let S1 := fn_update(s, "vm", V1)
      have {vt = mem} := apply(ms.dqvm_vm, {V0}, {phead}, {m}, pv, simp(hu), hp, hm)
      have q := apply(mp.dq_done[vm := V0, objs := OB, phead := phead, m := m], pv, pb, hp, hm)
      let X2 := ok(pair(S1, empty), empty)
      have ex: ex x4. (x4 in x86_64_linux.Vm && mallocng_purpose.dequeued(V0, app(fn_update(s, "vm", x4), "vm"), app(fn_update(s, "vm", x4), "objs"), phead, m)) &&
          X2 = ok(pair(fn_update(s, "vm", x4), empty), empty)
        by ex_intro({V1}, taut(vt, (mallocng_purpose.dequeued(V0, app(S1, "vm"), app(S1, "objs"), phead, m) by simp(q)), refl({X2})))
      have b: letin(app(s, "vm"), x3. any_rel(x4. x4 in x86_64_linux.Vm && mallocng_purpose.dequeued(x3, app(fn_update(s, "vm", x4), "vm"), app(fn_update(s, "vm", x4), "objs"), phead, m),
          x4. letin(fn_update(s, "vm", x4), x5. X2 = ok(pair(x5, empty), empty))))
        by defs(taut(ex), letin, any_rel)
      have pu1: pair(s, ok(S1, empty)) in univ(1) by simp(rewrite(oe, pu))
      have c := apply(ct.contract_done[P := x0. ex x2. ex x3. (x2 in list_type(omega) && x3 in omega) &&
          ((mallocng_purpose.list_at(app(x0, "vm"), app(x0, "objs"), phead, x2) && int_lt(x3, seq_len(x2))) && app(x2, x3) = m),
        B := x0 x2. letin(app(x0, "vm"), x3. any_rel(x4. x4 in x86_64_linux.Vm && mallocng_purpose.dequeued(x3, app(fn_update(x0, "vm", x4), "vm"), app(fn_update(x0, "vm", x4), "objs"), phead, m),
          x4. letin(fn_update(x0, "vm", x4), x5. x2 = ok(pair(x5, empty), empty)))),
        s := s, s1 := S1], hpre, b, pu1)
      show by defs(rewrite(sym(oe), c), mallocng_purpose.dequeue_purpose)
    qed
    show by taut(np, yp)
  qed
  show g
qed

// dequeue as a C function value
theorem mp.dq_fun: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
  runs(app(c_src_malloc_mallocng_malloc.dequeue_fun, regs), s, o) -> runs(app(mallocng_purpose.dequeue_purpose_fun(), regs), s, o)
proof
  have hm: all regs. refines(c_src_malloc_mallocng_malloc.dequeue(bits_of_int(64, app(regs, 0)), bits_of_int(64, app(regs, 1))), mallocng_purpose.dequeue_purpose(bits_of_int(64, app(regs, 0)), bits_of_int(64, app(regs, 1))), abi.World) proof
    fix regs
    show := mp(all_elim(mp.dq, {bits_of_int(64, app(regs, 0))}, {bits_of_int(64, app(regs, 1))}), simp(), simp())
  qed
  show by defs(apply(g.fun_void[n := 2], hm), c_src_malloc_mallocng_malloc.dequeue_fun, mallocng_purpose.dequeue_purpose_fun)
qed

// dequeue's contract at a call (its C function value), m in the list l at
// *phead: an overflow, or the memory some V it is for (`dequeued`)
theorem mp.dq_q: all t phead m l k regs o2. t in abi.World -> t in univ(1) -> phead in bits(64) -> m in bits(64) ->
  l in list_type(omega) -> k in omega -> int_lt(k, seq_len(l)) -> app(l, k) = m -> mallocng_purpose.list_at(app(t, "vm"), app(t, "objs"), phead, l) ->
  gc.regs_ok(regs, seq_concat(seq_one(gimple.arg(64, phead)), seq_one(gimple.arg(64, m)))) ->
  runs(app(mallocng_purpose.dequeue_purpose_fun(), regs), t, o2) ->
  (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex V r. (V in x86_64_linux.Vm && mallocng_purpose.dequeued(app(t, "vm"), V, app(t, "objs"), phead, m)) && o2 = ok(fn_update(t, "vm", V), r))
proof
  fix t phead m l k regs o2
  assume hw htu hp hm hl hk hkl hlk H hro h
  let OVF := exc_val("stack_overflow", empty)
  let T0 := app(t, "vm")
  have hpre: ex x2. ex x3. (x2 in list_type(omega) && x3 in omega) && ((mallocng_purpose.list_at(app(t, "vm"), app(t, "objs"), phead, x2) && int_lt(x3, seq_len(x2))) && app(x2, x3) = m)
    by ex_intro({l}, {k}, taut(hl, hk, H, hkl, hlk))
  have rl rn r0 r1 := apply(gc.regs2, hp, hm, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, mallocng_purpose.dequeue_purpose_fun, app_fn_build, ra in h
  have o2l: ord_le(2, seq_len(regs)) by defs(simp(rn), ord_le)
  have bp: bits_of_int(64, app(regs, 0)) = phead && bits_of_int(64, app(regs, 1)) = m by defs(simp(r0, r1, hp, hm), bits_of_int, pow2)
  have b := apply(g.runs_elim, h)
  have b2: bind_rel(mallocng_purpose.dequeue_purpose(phead, m), t, x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o2 = ok(x3, pair(x5, x6)))),
      x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3)) by simp(b, o2l, bp, keep(bind_rel, mallocng_purpose.dequeue_purpose))
  obtain o3, hs3 hk3 from expand(b2, bind_rel)
  have {pv = mem, pb = bytes} := apply(ms.world_parts, hw)
  have ci := apply(ct.contract_inv[P := x0. ex x2. ex x3. (x2 in list_type(omega) && x3 in omega) &&
      ((mallocng_purpose.list_at(app(x0, "vm"), app(x0, "objs"), phead, x2) && int_lt(x3, seq_len(x2))) && app(x2, x3) = m),
    B := x0 x2. letin(app(x0, "vm"), x3. any_rel(x4. x4 in x86_64_linux.Vm && mallocng_purpose.dequeued(x3, app(fn_update(x0, "vm", x4), "vm"), app(fn_update(x0, "vm", x4), "objs"), phead, m),
      x4. letin(fn_update(x0, "vm", x4), x5. x2 = ok(pair(x5, empty), empty)))), s := t, o := o3],
    hpre, pv, expand(hs3, mallocng_purpose.dequeue_purpose))
  // an overflow: the call's
  have c1: (ex v. v in x86_64_linux.Vm && o3 = exc(fn_update(t, "vm", v), OVF)) ->
      (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), OVF)) proof
    assume hx
    obtain v, hv ho from hx
    have e2: o2 = exc(fn_update(t, "vm", v), OVF) by simp(rewrite(ho, hk3))
    show by ex_intro({v}, taut(hv, e2))
  qed
  // dequeue's memory: one it is for (one exists: its code's, `mp.dq_done`)
  have c2: (ex x2. letin(T0, x3. any_rel(x4. x4 in x86_64_linux.Vm && mallocng_purpose.dequeued(x3, app(fn_update(t, "vm", x4), "vm"), app(fn_update(t, "vm", x4), "objs"), phead, m),
        x4. letin(fn_update(t, "vm", x4), x5. x2 = ok(pair(x5, empty), empty)))) &&
      ((fst(x2) = 0 && o3 = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && o3 = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
        ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && o3 = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && o3 = diverge(snd(x2)))))) ->
      (ex V r. (V in x86_64_linux.Vm && mallocng_purpose.dequeued(T0, V, app(t, "objs"), phead, m)) && o2 = ok(fn_update(t, "vm", V), r)) proof
    assume hx
    obtain x2, hB hout from hx
    have q := apply(mp.dq_done[vm := T0, objs := app(t, "objs"), phead := phead, m := m], pv, pb, hp, hm)
    have {vt = mem} := apply(ms.dqvm_vm, {T0}, {phead}, {m}, pv, simp(htu), hp, hm)
    have ne: ex x4. x4 in x86_64_linux.Vm && mallocng_purpose.dequeued(T0, app(fn_update(t, "vm", x4), "vm"), app(fn_update(t, "vm", x4), "objs"), phead, m)
      by ex_intro({mallocng_specs.dequeue_vm(T0, phead, m)}, taut(vt,
        (mallocng_purpose.dequeued(T0, app(fn_update(t, "vm", mallocng_specs.dequeue_vm(T0, phead, m)), "vm"), app(fn_update(t, "vm", mallocng_specs.dequeue_vm(T0, phead, m)), "objs"), phead, m) by simp(q))))
    obtain V, hV hS hk from apply(g.any_e, ne, expand(hB, letin))
    have x2e: x2 = ok(pair(fn_update(t, "vm", V), empty), empty) by simp(expand(hk, letin))
    have o3e: o3 = ok(fn_update(t, "vm", V), empty) by simp(rewrite(x2e, hout))
    have k4 := rewrite(o3e, hk3)
    have k5: any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o2 = ok(fn_update(t, "vm", V), pair(x5, x6)))) by simp(k4, keep(any_rel))
    have nb: ex y. y in bits(64) by ex_intro({0}, simp())
    obtain y1, hy1 k6 from apply(g.any_e, nb, k5)
    obtain y2, hy2 k7 from apply(g.any_e, nb, k6)
    have hS2: mallocng_purpose.dequeued(T0, V, app(t, "objs"), phead, m) by simp(hS)
    show by ex_intro({V}, {pair(y1, y2)}, taut(hV, hS2, k7))
  qed
  show by taut(ci, c1, c2)
qed


// dequeue_head's code by its purpose: the list's first element (0 if
// empty) out of it and returned -- the head word read (`mp.head_is`), then
// dequeue's contract (`mp.dq_q`), for every callee refining it
theorem mp.dqh: all phead g. phead in bits(64) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(app(g, regs), s, o) -> runs(app(mallocng_purpose.dequeue_purpose_fun(), regs), s, o)) ->
  refines(c_src_malloc_mallocng_malloc.dequeue_head(phead, g), mallocng_purpose.dequeue_head_purpose(phead), abi.World)
proof
  fix phead g
  assume hph hg
  show proof
    fix s o
    assume hw hr
    let V0 := app(s, "vm")
    let OB := app(s, "objs")
    let SPEC := mallocng_purpose.dequeue_head_purpose(phead)
    let M := mallocng_specs.rd64(V0, phead)
    let OVF := exc_val("stack_overflow", empty)
    have pu := apply(g.runs_univ, hr)
    have hu: s in univ(1) by simp(pu)
    have vV vfun vdom vb := apply(ms.world_parts, hw)
    have ss: fn_update(s, "vm", V0) = s := mp(fn_update_same[f := s, k := "vm"], vfun, vdom)
    have np: !((ex x2. x2 in list_type(omega) && mallocng_purpose.list_at(V0, OB, phead, x2)) && abi.thread_ok(V0, app(s, "fs_base"))) -> runs(SPEC, s, o) proof
      assume hn
      show by simp(pu, hn, keep(abi.overflow, mallocng_purpose.list_at, mallocng_purpose.is_head, mallocng_purpose.head_taken, abi.thread_ok))
    qed
    have yp: (ex x2. x2 in list_type(omega) && mallocng_purpose.list_at(V0, OB, phead, x2)) && abi.thread_ok(V0, app(s, "fs_base")) -> runs(SPEC, s, o) proof
      assume hp
      have hex ths := hp
      obtain l, hl H from hex
      have kh .. := expand(H, mallocng_purpose.list_at)
      have mh mi := apply(mp.head_is[vm := V0, objs := OB, phead := phead, l := l], vb, hph, hl, H)
      have mb: M in bits(64) by defs(simp(), mallocng_specs.rd64)
      // (the spec's outcomes: an overflow, any memory; the head returned, taken)
      have sov: all v. v in x86_64_linux.Vm -> runs(SPEC, s, exc(fn_update(s, "vm", v), OVF)) proof
        fix v
        assume hv
        have vu := apply(x86.vm_univ, hv)
        have eu: OVF in univ(1) by defs(simp(), exc_val)
        have pu2: pair(s, exc(fn_update(s, "vm", v), OVF)) in univ(1) by simp(hu, vu, eu)
        have c := apply(ct.contract_ovf[P := x0. (ex x2. x2 in list_type(omega) && mallocng_purpose.list_at(app(x0, "vm"), app(x0, "objs"), phead, x2)) && abi.thread_ok(app(x0, "vm"), app(x0, "fs_base")),
          B := x0 x2. letin(app(x0, "vm"), x3. any_rel(x4. x4 in bits(64) && mallocng_purpose.is_head(x3, app(x0, "objs"), phead, x4), x4. letin(x4, x5.
            any_rel(x6. x6 in x86_64_linux.Vm && mallocng_purpose.head_taken(x3, app(fn_update(x0, "vm", x6), "vm"), app(fn_update(x0, "vm", x6), "objs"), phead, x5),
              x6. letin(fn_update(x0, "vm", x6), x7. x2 = exc(pair(x7, empty), pair("ret", x5))))))),
          s := s, v := v], hp, hv, pu2)
        show by defs(c, mallocng_purpose.dequeue_head_purpose)
      qed
      have sret: all V. V in x86_64_linux.Vm -> mallocng_purpose.head_taken(V0, V, OB, phead, M) -> runs(SPEC, s, ok(fn_update(s, "vm", V), M)) proof
        fix V
        assume hV ht
        let X := exc(pair(fn_update(s, "vm", V), empty), pair("ret", M))
        have i6: ex x6. (x6 in x86_64_linux.Vm && mallocng_purpose.head_taken(V0, app(fn_update(s, "vm", x6), "vm"), app(fn_update(s, "vm", x6), "objs"), phead, M)) &&
            X = exc(pair(fn_update(s, "vm", x6), empty), pair("ret", M))
          by ex_intro({V}, taut(hV, (mallocng_purpose.head_taken(V0, app(fn_update(s, "vm", V), "vm"), app(fn_update(s, "vm", V), "objs"), phead, M) by simp(ht)), refl({X})))
        have i4: ex x4. (x4 in bits(64) && mallocng_purpose.is_head(V0, OB, phead, x4)) &&
            (!(ex x6. x6 in x86_64_linux.Vm && mallocng_purpose.head_taken(V0, app(fn_update(s, "vm", x6), "vm"), app(fn_update(s, "vm", x6), "objs"), phead, x4)) ||
             (ex x6. (x6 in x86_64_linux.Vm && mallocng_purpose.head_taken(V0, app(fn_update(s, "vm", x6), "vm"), app(fn_update(s, "vm", x6), "objs"), phead, x4)) &&
               X = exc(pair(fn_update(s, "vm", x6), empty), pair("ret", x4))))
          by ex_intro({M}, taut(mb, mi, i6))
        have b: letin(app(s, "vm"), x3. any_rel(x4. x4 in bits(64) && mallocng_purpose.is_head(x3, app(s, "objs"), phead, x4), x4. letin(x4, x5.
            any_rel(x6. x6 in x86_64_linux.Vm && mallocng_purpose.head_taken(x3, app(fn_update(s, "vm", x6), "vm"), app(fn_update(s, "vm", x6), "objs"), phead, x5),
              x6. letin(fn_update(s, "vm", x6), x7. X = exc(pair(x7, empty), pair("ret", x5)))))))
          by defs(taut(i4), letin, any_rel)
        have vu := apply(x86.vm_univ, hV)
        have pu2: pair(s, ok(fn_update(s, "vm", V), M)) in univ(1) by simp(hu, vu, mb)
        have c := apply(ct.contract_ret[P := x0. (ex x2. x2 in list_type(omega) && mallocng_purpose.list_at(app(x0, "vm"), app(x0, "objs"), phead, x2)) && abi.thread_ok(app(x0, "vm"), app(x0, "fs_base")),
          B := x0 x2. letin(app(x0, "vm"), x3. any_rel(x4. x4 in bits(64) && mallocng_purpose.is_head(x3, app(x0, "objs"), phead, x4), x4. letin(x4, x5.
            any_rel(x6. x6 in x86_64_linux.Vm && mallocng_purpose.head_taken(x3, app(fn_update(x0, "vm", x6), "vm"), app(fn_update(x0, "vm", x6), "objs"), phead, x5),
              x6. letin(fn_update(x0, "vm", x6), x7. x2 = exc(pair(x7, empty), pair("ret", x5))))))),
          s := s, s1 := fn_update(s, "vm", V), v := M], hp, b, pu2)
        show by defs(c, mallocng_purpose.dequeue_head_purpose)
      qed
      // the run: the locals' choices, then *phead loaded
      have ne64: ex x. x in bits(64) by ex_intro({0}, simp())
      obtain x2, h2b h2l from apply(g.any_e, ne64, apply(g.runs_elim, hr))
      have l2 := apply(g.letin_e, h2l)
      obtain x4, h4b h4l from apply(g.any_e, ne64, l2)
      have l4 := apply(g.letin_e, h4l)
      have zp: bits_add(64, phead, 0) = phead by simp(hph)
      have ld := rewrite(zp, apply(ms.ld_det, {s}, {phead}, {0}, hu, hph, simp(), kh))
      have l6 := apply(g.bind_inv, l4, ld)
      obtain x9, hd he from apply(g.letin_e, l6)
      // an empty list: nothing done, 0 returned
      have z: M = 0 -> runs(SPEC, s, o) proof
        assume e0
        have x9e: x9 = ok(pair(s, pair(M, x4)), empty) by simp(hd, e0)
        have oe: o = ok(s, M) by simp(rewrite(x9e, he))
        have ht: mallocng_purpose.head_taken(V0, V0, OB, phead, M) by defs(taut(e0, refl({V0})), mallocng_purpose.head_taken)
        have r := mp(all_elim(sret, {V0}), vV, ht)
        show := rewrite(sym(oe), rewrite(ss, r))
      qed
      // a first element: dequeued by the call (its contract: dequeue's), returned
      have nz: !(M = 0) -> runs(SPEC, s, o) proof
        assume hn
        have b := apply(g.pick, hd, hn, (!!!(M = 0) by taut(hn)))
        have lo: seq_len(l) in omega by arith(hl)
        have l0z: seq_len(l) = 0 -> M = 0 proof
          assume h0
          show by simp(mh, h0)
        qed
        have ln: !(seq_len(l) = 0) by taut(l0z, hn)
        have l0: app(l, 0) = M by simp(mh, ln)
        have qa: all regs o2. gc.regs_ok(regs, seq_concat(seq_one(gimple.arg(64, phead)), seq_one(gimple.arg(64, M)))) -> runs(app(mallocng_purpose.dequeue_purpose_fun(), regs), s, o2) ->
            (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(s, "vm", v), OVF)) ||
            (ex V r. (V in x86_64_linux.Vm && mallocng_purpose.dequeued(V0, V, OB, phead, M)) && o2 = ok(fn_update(s, "vm", V), r)) proof
          fix regs o2
          assume hro h2
          show := apply(mp.dq_q, {s}, {phead}, {M}, {l}, {0}, {regs}, {o2}, hw, hu, hph, mb, hl, simp(), arith(lo, ln), l0, H, hro, h2)
        qed
        have cc := apply(gc.contract_callV[P := v. mallocng_purpose.dequeued(V0, v, OB, phead, M)], ths, hw, apply(gc.regs2_ex, hph, mb), arith(), hg, qa, b)
        have c1: (ex v. v in x86_64_linux.Vm && x9 = exc(pair(fn_update(s, "vm", v), pair(M, x4)), pair("raise", OVF))) -> runs(SPEC, s, o) proof
          assume h
          obtain v, hv hx from h
          have oe: o = exc(fn_update(s, "vm", v), OVF) by simp(rewrite(hx, he))
          show := rewrite(sym(oe), mp(all_elim(sov, {v}), hv))
        qed
        have c2: (ex V r. (V in x86_64_linux.Vm && mallocng_purpose.dequeued(V0, V, OB, phead, M)) && x9 = ok(pair(fn_update(s, "vm", V), pair(M, x4)), empty)) -> runs(SPEC, s, o) proof
          assume h
          obtain V, h1 from h
          obtain r, hV hq hx from h1
          have oe: o = ok(fn_update(s, "vm", V), M) by simp(rewrite(hx, he))
          have ht: mallocng_purpose.head_taken(V0, V, OB, phead, M) by defs(taut(hn, hq), mallocng_purpose.head_taken)
          show := rewrite(sym(oe), mp(all_elim(sret, {V}), hV, ht))
        qed
        show by taut(cc, c1, c2)
      qed
      show by taut(z, nz)
    qed
    show by taut(np, yp)
  qed
qed

// dequeue's machine code implements its purpose
theorem mp.dq_implements: all statics. tr.implements_at(4206409, mallocng_purpose.dequeue_purpose_fun(), 4198400, text.code, statics)
proof
  fix statics
  have st := mp(all_elim(tr.implements_refine, {4206409}, {c_src_malloc_mallocng_malloc_cfg.dequeue_fun}, {c_src_malloc_mallocng_malloc.dequeue_fun},
    {4198400}, {text.code}, {statics}), all_elim(dqtc.implements, {statics}), dequeue_ref)
  show := mp(all_elim(tr.implements_refine, {4206409}, {c_src_malloc_mallocng_malloc.dequeue_fun}, {mallocng_purpose.dequeue_purpose_fun()},
    {4198400}, {text.code}, {statics}), st, mp.dq_fun)
qed

// dequeue_head as a C function value, for every callee refining dequeue's
// purpose
theorem mp.dqh_fun: all g. (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(app(g, regs), s, o) -> runs(app(mallocng_purpose.dequeue_purpose_fun(), regs), s, o)) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
    runs(app(c_src_malloc_mallocng_malloc.dequeue_head_fun(g), regs), s, o) -> runs(app(mallocng_purpose.dequeue_head_purpose_fun(), regs), s, o))
proof
  fix g
  assume hg
  have hm: all regs. refines(c_src_malloc_mallocng_malloc.dequeue_head(bits_of_int(64, app(regs, 0)), g), mallocng_purpose.dequeue_head_purpose(bits_of_int(64, app(regs, 0))), abi.World) proof
    fix regs
    show := mp(all_elim(mp.dqh, {bits_of_int(64, app(regs, 0))}, {g}), simp(), hg)
  qed
  show by defs(apply(g.fun_res[n := 1, w := 64], hm), c_src_malloc_mallocng_malloc.dequeue_head_fun, mallocng_purpose.dequeue_head_purpose_fun, letin)
qed

// dequeue_head's machine code (linked with dequeue's) implements its purpose
theorem mp.dqh_implements: all statics. tr.implements_at(4206554, mallocng_purpose.dequeue_head_purpose_fun(), 4198400, text.code, statics)
proof
  fix statics
  let G := c_src_malloc_mallocng_malloc_cfg.dequeue_fun
  // dequeue's machine-level callee: its CFG form refines its code, its code its purpose
  have h: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(app(G, regs), s, o) ->
      runs(app(mallocng_purpose.dequeue_purpose_fun(), regs), s, o) proof
    fix regs s o
    assume h1 hl hs hr
    show := mp(all_elim(mp.dq_fun, {regs}, {s}, {o}), h1, hl, hs, mp(all_elim(dequeue_ref, {regs}, {s}, {o}), h1, hl, hs, hr))
  qed
  have c2 := mp(all_elim(mp.dqh_fun, {G}), h)
  have r: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
      runs(app(c_src_malloc_mallocng_malloc_cfg.dequeue_head_fun(G), regs), s, o) -> runs(app(mallocng_purpose.dequeue_head_purpose_fun(), regs), s, o) proof
    fix regs s o
    assume h1 hl hs hr
    show := mp(all_elim(c2, {regs}, {s}, {o}), h1, hl, hs, mp(all_elim(dequeue_head_ref, {G}, {regs}, {s}, {o}), h1, hl, hs, hr))
  qed
  show := mp(all_elim(tr.implements_refine, {4206554}, {c_src_malloc_mallocng_malloc_cfg.dequeue_head_fun(G)}, {mallocng_purpose.dequeue_head_purpose_fun()},
    {4198400}, {text.code}, {statics}), all_elim(dqhtc.linked, {statics}), r)
qed

// ----------------------------------------------------------------------
//  queue, free_meta: their code refines their purpose

// queue's code by its purpose: m joins the list at *phead at its end,
// nothing but the links and the head word written -- its effect
// (`ms.qu_run`) is that (`mp.qu_done`); the list and m's joinability give
// its precondition (`mp.qu_pre`). Its a_crash calls unreached: any callee.
theorem mp.qu: all phead m g. phead in bits(64) -> m in bits(64) ->
  refines(c_src_malloc_mallocng_malloc.queue(phead, m, g), mallocng_purpose.queue_purpose(phead, m), abi.World)
proof
  fix phead m g
  assume hp hm
  have gg: all s o. s in abi.World -> runs(c_src_malloc_mallocng_malloc.queue(phead, m, g), s, o) -> runs(mallocng_purpose.queue_purpose(phead, m), s, o) proof
    fix s o
    assume hw hr
    let V0 := app(s, "vm")
    let OB := app(s, "objs")
    have pu := apply(g.runs_univ, hr)
    have hu: s in univ(1) by simp(pu)
    let PRE := ex x2. x2 in list_type(omega) && (mallocng_purpose.list_at(V0, OB, phead, x2) && mallocng_purpose.joinable(V0, OB, phead, x2, m))
    have np: !PRE -> runs(mallocng_purpose.queue_purpose(phead, m), s, o) proof
      assume hn0
      show by simp(pu, hn0, keep(abi.overflow, mallocng_purpose.list_at, mallocng_purpose.joinable, mallocng_purpose.queued))
    qed
    have yp: PRE -> runs(mallocng_purpose.queue_purpose(phead, m), s, o) proof
      assume hpre
      obtain l, hl hq from hpre
      have H: mallocng_purpose.list_at(V0, OB, phead, l) by taut(hq)
      have J: mallocng_purpose.joinable(V0, OB, phead, l, m) by taut(hq)
      have {pv = mem, pb = bytes} := apply(ms.world_parts, hw)
      have qp := apply(mp.qu_pre[vm := V0, objs := OB, phead := phead, m := m, l := l], pb, hp, hm, hl, H, J)
      have oe := apply(ms.qu_run, {phead}, {m}, {g}, {s}, {o}, hp, hm, hw, hu, qp, hr)
      let V1 := mallocng_specs.queue_vm(V0, phead, m)
      let S1 := fn_update(s, "vm", V1)
      have {vt = mem} := apply(ms.quvm_vm, {V0}, {phead}, {m}, pv, simp(hu), hp, hm)
      have q := apply(mp.qu_done[vm := V0, objs := OB, phead := phead, m := m], pv, pb, hp, hm)
      let X2 := ok(pair(S1, empty), empty)
      have ex: ex x4. (x4 in x86_64_linux.Vm && mallocng_purpose.queued(V0, app(fn_update(s, "vm", x4), "vm"), app(fn_update(s, "vm", x4), "objs"), phead, m)) &&
          X2 = ok(pair(fn_update(s, "vm", x4), empty), empty)
        by ex_intro({V1}, taut(vt, (mallocng_purpose.queued(V0, app(S1, "vm"), app(S1, "objs"), phead, m) by simp(q)), refl({X2})))
      have b: letin(app(s, "vm"), x3. any_rel(x4. x4 in x86_64_linux.Vm && mallocng_purpose.queued(x3, app(fn_update(s, "vm", x4), "vm"), app(fn_update(s, "vm", x4), "objs"), phead, m),
          x4. letin(fn_update(s, "vm", x4), x5. X2 = ok(pair(x5, empty), empty))))
        by defs(taut(ex), letin, any_rel)
      have pu1: pair(s, ok(S1, empty)) in univ(1) by simp(rewrite(oe, pu))
      have c := apply(ct.contract_done[P := x0. ex x2. x2 in list_type(omega) &&
          (mallocng_purpose.list_at(app(x0, "vm"), app(x0, "objs"), phead, x2) && mallocng_purpose.joinable(app(x0, "vm"), app(x0, "objs"), phead, x2, m)),
        B := x0 x2. letin(app(x0, "vm"), x3. any_rel(x4. x4 in x86_64_linux.Vm && mallocng_purpose.queued(x3, app(fn_update(x0, "vm", x4), "vm"), app(fn_update(x0, "vm", x4), "objs"), phead, m),
          x4. letin(fn_update(x0, "vm", x4), x5. x2 = ok(pair(x5, empty), empty)))),
        s := s, s1 := S1], hpre, b, pu1)
      show by defs(rewrite(sym(oe), c), mallocng_purpose.queue_purpose)
    qed
    show by taut(np, yp)
  qed
  show gg
qed

// queue as a C function value (any a_crash)
theorem mp.qu_fun: all g regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
  runs(app(c_src_malloc_mallocng_malloc.queue_fun(g), regs), s, o) -> runs(app(mallocng_purpose.queue_purpose_fun(), regs), s, o)
proof
  fix g
  have hm: all regs. refines(c_src_malloc_mallocng_malloc.queue(bits_of_int(64, app(regs, 0)), bits_of_int(64, app(regs, 1)), g), mallocng_purpose.queue_purpose(bits_of_int(64, app(regs, 0)), bits_of_int(64, app(regs, 1))), abi.World) proof
    fix regs
    show := mp(all_elim(mp.qu, {bits_of_int(64, app(regs, 0))}, {bits_of_int(64, app(regs, 1))}, {g}), simp(), simp())
  qed
  show by defs(apply(g.fun_void[n := 2], hm), c_src_malloc_mallocng_malloc.queue_fun, mallocng_purpose.queue_purpose_fun)
qed

// queue's contract at a call (its C function value), m joinable to the
// list l at *phead: an overflow, or the memory some V it is for (`queued`)
theorem mp.qu_q: all t phead m l regs o2. t in abi.World -> t in univ(1) -> phead in bits(64) -> m in bits(64) ->
  l in list_type(omega) -> mallocng_purpose.list_at(app(t, "vm"), app(t, "objs"), phead, l) -> mallocng_purpose.joinable(app(t, "vm"), app(t, "objs"), phead, l, m) ->
  gc.regs_ok(regs, seq_concat(seq_one(gimple.arg(64, phead)), seq_one(gimple.arg(64, m)))) ->
  runs(app(mallocng_purpose.queue_purpose_fun(), regs), t, o2) ->
  (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex V r. (V in x86_64_linux.Vm && mallocng_purpose.queued(app(t, "vm"), V, app(t, "objs"), phead, m)) && o2 = ok(fn_update(t, "vm", V), r))
proof
  fix t phead m l regs o2
  assume hw htu hp hm hl H J hro h
  let OVF := exc_val("stack_overflow", empty)
  let T0 := app(t, "vm")
  have hpre: ex x2. x2 in list_type(omega) && (mallocng_purpose.list_at(app(t, "vm"), app(t, "objs"), phead, x2) && mallocng_purpose.joinable(app(t, "vm"), app(t, "objs"), phead, x2, m))
    by ex_intro({l}, taut(hl, H, J))
  have rl rn r0 r1 := apply(gc.regs2, hp, hm, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, mallocng_purpose.queue_purpose_fun, app_fn_build, ra in h
  have o2l: ord_le(2, seq_len(regs)) by defs(simp(rn), ord_le)
  have bp: bits_of_int(64, app(regs, 0)) = phead && bits_of_int(64, app(regs, 1)) = m by defs(simp(r0, r1, hp, hm), bits_of_int, pow2)
  have b := apply(g.runs_elim, h)
  have b2: bind_rel(mallocng_purpose.queue_purpose(phead, m), t, x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o2 = ok(x3, pair(x5, x6)))),
      x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3)) by simp(b, o2l, bp, keep(bind_rel, mallocng_purpose.queue_purpose))
  obtain o3, hs3 hk3 from expand(b2, bind_rel)
  have {pv = mem, pb = bytes} := apply(ms.world_parts, hw)
  have ci := apply(ct.contract_inv[P := x0. ex x2. x2 in list_type(omega) &&
      (mallocng_purpose.list_at(app(x0, "vm"), app(x0, "objs"), phead, x2) && mallocng_purpose.joinable(app(x0, "vm"), app(x0, "objs"), phead, x2, m)),
    B := x0 x2. letin(app(x0, "vm"), x3. any_rel(x4. x4 in x86_64_linux.Vm && mallocng_purpose.queued(x3, app(fn_update(x0, "vm", x4), "vm"), app(fn_update(x0, "vm", x4), "objs"), phead, m),
      x4. letin(fn_update(x0, "vm", x4), x5. x2 = ok(pair(x5, empty), empty)))), s := t, o := o3],
    hpre, pv, expand(hs3, mallocng_purpose.queue_purpose))
  // an overflow: the call's
  have c1: (ex v. v in x86_64_linux.Vm && o3 = exc(fn_update(t, "vm", v), OVF)) ->
      (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), OVF)) proof
    assume hx
    obtain v, hv ho from hx
    have e2: o2 = exc(fn_update(t, "vm", v), OVF) by simp(rewrite(ho, hk3))
    show by ex_intro({v}, taut(hv, e2))
  qed
  // queue's memory: one it is for (one exists: its code's, `mp.qu_done`)
  have c2: (ex x2. letin(T0, x3. any_rel(x4. x4 in x86_64_linux.Vm && mallocng_purpose.queued(x3, app(fn_update(t, "vm", x4), "vm"), app(fn_update(t, "vm", x4), "objs"), phead, m),
        x4. letin(fn_update(t, "vm", x4), x5. x2 = ok(pair(x5, empty), empty)))) &&
      ((fst(x2) = 0 && o3 = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && o3 = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
        ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && o3 = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && o3 = diverge(snd(x2)))))) ->
      (ex V r. (V in x86_64_linux.Vm && mallocng_purpose.queued(T0, V, app(t, "objs"), phead, m)) && o2 = ok(fn_update(t, "vm", V), r)) proof
    assume hx
    obtain x2, hB hout from hx
    have q := apply(mp.qu_done[vm := T0, objs := app(t, "objs"), phead := phead, m := m], pv, pb, hp, hm)
    have {vt = mem} := apply(ms.quvm_vm, {T0}, {phead}, {m}, pv, simp(htu), hp, hm)
    have ne: ex x4. x4 in x86_64_linux.Vm && mallocng_purpose.queued(T0, app(fn_update(t, "vm", x4), "vm"), app(fn_update(t, "vm", x4), "objs"), phead, m)
      by ex_intro({mallocng_specs.queue_vm(T0, phead, m)}, taut(vt,
        (mallocng_purpose.queued(T0, app(fn_update(t, "vm", mallocng_specs.queue_vm(T0, phead, m)), "vm"), app(fn_update(t, "vm", mallocng_specs.queue_vm(T0, phead, m)), "objs"), phead, m) by simp(q))))
    obtain V, hV hS hk from apply(g.any_e, ne, expand(hB, letin))
    have x2e: x2 = ok(pair(fn_update(t, "vm", V), empty), empty) by simp(expand(hk, letin))
    have o3e: o3 = ok(fn_update(t, "vm", V), empty) by simp(rewrite(x2e, hout))
    have k4 := rewrite(o3e, hk3)
    have k5: any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o2 = ok(fn_update(t, "vm", V), pair(x5, x6)))) by simp(k4, keep(any_rel))
    have nb: ex y. y in bits(64) by ex_intro({0}, simp())
    obtain y1, hy1 k6 from apply(g.any_e, nb, k5)
    obtain y2, hy2 k7 from apply(g.any_e, nb, k6)
    have hS2: mallocng_purpose.queued(T0, V, app(t, "objs"), phead, m) by simp(hS)
    show by ex_intro({V}, {pair(y1, y2)}, taut(hV, hS2, k7))
  qed
  show by taut(ci, c1, c2)
qed

// free_meta's code by its purpose: m's meta cleared and m appended to the
// free metas' list -- its zero store keeps the list and makes m joinable
// (`mp.fm_pre`), then queue's contract (`mp.qu_q`) appends it
// (`mp.fm_done`); for every callee refining queue's purpose
theorem mp.fm: all m g. m in bits(64) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(app(g, regs), s, o) -> runs(app(mallocng_purpose.queue_purpose_fun(), regs), s, o)) ->
  refines(c_src_malloc_mallocng_malloc.free_meta(m, g), mallocng_purpose.free_meta_purpose(c_src_malloc_mallocng_malloc.__malloc_context, m), abi.World)
proof
  fix m g
  assume hm hg
  show proof
    fix s o
    assume hw hr
    let V0 := app(s, "vm")
    let OB := app(s, "objs")
    let FS := app(s, "fs_base")
    let CTX := c_src_malloc_mallocng_malloc.__malloc_context
    let PH := bits_add(64, CTX, 16)
    let ZV := mallocng_specs.zero_meta(V0, m)
    let W1 := fn_update(s, "vm", ZV)
    let SPEC := mallocng_purpose.free_meta_purpose(CTX, m)
    let OVF := exc_val("stack_overflow", empty)
    let Z := seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(0), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0))
    let PRE := (((int_lt(int_add(CTX, 16), int_pow(2, 64)) &&
        (ex x2. x2 in list_type(omega) && (mallocng_purpose.list_at(V0, OB, PH, x2) && mallocng_purpose.meta_joinable(V0, OB, PH, x2, m)))) &&
        abi.thread_ok(V0, FS)) && int_le(int_add(FS, 8), int_pow(2, 64))) && (int_le(int_add(FS, 8), m) || int_le(int_add(m, 40), FS))
    have pu := apply(g.runs_univ, hr)
    have hu: s in univ(1) by simp(pu)
    have vV vfun vdom vb := apply(ms.world_parts, hw)
    have np: !PRE -> runs(SPEC, s, o) proof
      assume hn
      show by simp(pu, hn, keep(abi.overflow, mallocng_purpose.list_at, mallocng_purpose.meta_joinable, mallocng_purpose.meta_freed, abi.thread_ok))
    qed
    have yp: PRE -> runs(SPEC, s, o) proof
      assume hp
      have hctx hex ths hfs hap := hp
      obtain l, hl hq from hex
      have H: mallocng_purpose.list_at(V0, OB, PH, l) by taut(hq)
      have J: mallocng_purpose.meta_joinable(V0, OB, PH, l, m) by taut(hq)
      have {hnz = nonnull, hus = write} := expand(J, mallocng_purpose.meta_joinable)
      // (the spec's outcomes: an overflow, any memory; m's meta freed)
      have sov: all v. v in x86_64_linux.Vm -> runs(SPEC, s, exc(fn_update(s, "vm", v), OVF)) proof
        fix v
        assume hv
        have vu := apply(x86.vm_univ, hv)
        have eu: OVF in univ(1) by defs(simp(), exc_val)
        have pu2: pair(s, exc(fn_update(s, "vm", v), OVF)) in univ(1) by simp(hu, vu, eu)
        have c := apply(ct.contract_ovf[P := x0. (((int_lt(int_add(CTX, 16), int_pow(2, 64)) &&
            (ex x2. x2 in list_type(omega) && (mallocng_purpose.list_at(app(x0, "vm"), app(x0, "objs"), PH, x2) && mallocng_purpose.meta_joinable(app(x0, "vm"), app(x0, "objs"), PH, x2, m)))) &&
            abi.thread_ok(app(x0, "vm"), app(x0, "fs_base"))) && int_le(int_add(app(x0, "fs_base"), 8), int_pow(2, 64))) &&
            (int_le(int_add(app(x0, "fs_base"), 8), m) || int_le(int_add(m, 40), app(x0, "fs_base"))),
          B := x0 x2. letin(app(x0, "vm"), x3. any_rel(x4. x4 in x86_64_linux.Vm && mallocng_purpose.meta_freed(x3, app(fn_update(x0, "vm", x4), "vm"), app(fn_update(x0, "vm", x4), "objs"), PH, m),
            x4. letin(fn_update(x0, "vm", x4), x5. x2 = ok(pair(x5, empty), empty)))),
          s := s, v := v], hp, hv, pu2)
        show by defs(c, mallocng_purpose.free_meta_purpose)
      qed
      have sdone: all V. V in x86_64_linux.Vm -> mallocng_purpose.meta_freed(V0, V, OB, PH, m) -> runs(SPEC, s, ok(fn_update(s, "vm", V), empty)) proof
        fix V
        assume hV hf
        let S1 := fn_update(s, "vm", V)
        let X2 := ok(pair(S1, empty), empty)
        have ex: ex x4. (x4 in x86_64_linux.Vm && mallocng_purpose.meta_freed(V0, app(fn_update(s, "vm", x4), "vm"), app(fn_update(s, "vm", x4), "objs"), PH, m)) &&
            X2 = ok(pair(fn_update(s, "vm", x4), empty), empty)
          by ex_intro({V}, taut(hV, (mallocng_purpose.meta_freed(V0, app(S1, "vm"), app(S1, "objs"), PH, m) by simp(hf)), refl({X2})))
        have b: letin(app(s, "vm"), x3. any_rel(x4. x4 in x86_64_linux.Vm && mallocng_purpose.meta_freed(x3, app(fn_update(s, "vm", x4), "vm"), app(fn_update(s, "vm", x4), "objs"), PH, m),
            x4. letin(fn_update(s, "vm", x4), x5. X2 = ok(pair(x5, empty), empty))))
          by defs(taut(ex), letin, any_rel)
        have vu := apply(x86.vm_univ, hV)
        have pu1: pair(s, ok(S1, empty)) in univ(1) by simp(hu, vu)
        have c := apply(ct.contract_done[P := x0. (((int_lt(int_add(CTX, 16), int_pow(2, 64)) &&
            (ex x2. x2 in list_type(omega) && (mallocng_purpose.list_at(app(x0, "vm"), app(x0, "objs"), PH, x2) && mallocng_purpose.meta_joinable(app(x0, "vm"), app(x0, "objs"), PH, x2, m)))) &&
            abi.thread_ok(app(x0, "vm"), app(x0, "fs_base"))) && int_le(int_add(app(x0, "fs_base"), 8), int_pow(2, 64))) &&
            (int_le(int_add(app(x0, "fs_base"), 8), m) || int_le(int_add(m, 40), app(x0, "fs_base"))),
          B := x0 x2. letin(app(x0, "vm"), x3. any_rel(x4. x4 in x86_64_linux.Vm && mallocng_purpose.meta_freed(x3, app(fn_update(x0, "vm", x4), "vm"), app(fn_update(x0, "vm", x4), "objs"), PH, m),
            x4. letin(fn_update(x0, "vm", x4), x5. x2 = ok(pair(x5, empty), empty)))),
          s := s, s1 := S1], hp, b, pu1)
        show by defs(c, mallocng_purpose.free_meta_purpose)
      qed
      // m's 40 bytes zeroed: the world W1
      have zl := apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, tr.zeros_one)))))))))))))))))))))))))))))))))))))))
      have ln: seq_len(Z) = 40 by arith()
      have md: g.mem_defined(s, m, 0, seq_len(Z), true) by simp(ln, hnz, hus, hm)
      have sd := apply(g.stz_det, {s}, {m}, {0}, {Z}, hu, hm, simp(), zl, md, vV, vfun, vdom)
      have ez: fn_update(s, "vm", fn_update(V0, "bytes", x86_64_linux.store_le(app(V0, "bytes"), int_add(m, 0), seq_len(Z), 0))) = W1 by defs(simp(ln, hm), mallocng_specs.zero_meta)
      have b1 := apply(g.bind_inv, apply(g.runs_elim, expand(hr, c_src_malloc_mallocng_malloc.free_meta)), rewrite(ez, sd))
      have w1W w1u := apply(tr.world_store, {s}, {m}, {40}, {0}, hw, hu, hm)
      have zw: fn_update(s, "vm", fn_update(V0, "bytes", x86_64_linux.store_le(app(V0, "bytes"), m, 40, 0))) = W1 by defs(simp(), mallocng_specs.zero_meta)
      have hw1 := rewrite(zw, w1W)
      have hu1 := rewrite(zw, w1u)
      // ctx + 16
      have cb: CTX in bits(64) by defs(simp(), c_src_malloc_mallocng_malloc.__malloc_context)
      have sv: gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), 16) = 16 by defs(simp(), gimple.sval)
      have pd := rewrite(sv, apply(g.padd_det, {W1}, {CTX}, {16}, hu1, cb, simp(), simp(sv, cb), simp(sv, hctx)))
      have ep: int_add(CTX, 16) = PH by simp(hctx, cb)
      have b2 := apply(g.bind_inv, b1, rewrite(ep, pd))
      have phb: PH in bits(64) by simp()
      // the list kept, m joinable; the thread pointer's word not m's
      have lz jz := apply(mp.fm_pre[vm := V0, objs := OB, phead := PH, m := m, l := l], vV, vb, phb, hm, hl, H, J)
      have fsb: FS in bits(64) by simp(expand(hw, abi.World))
      have fso: FS in omega by simp(fsb)
      have mo: m in omega by simp(hm)
      have ml: int_le(int_add(m, 40), 18446744073709551616) by arith(expand(J, mallocng_purpose.meta_joinable))
      have le8: all j. j in omega -> int_lt(j, 8) ->
          app(x86_64_linux.store_le(app(V0, "bytes"), m, 40, 0), bits_add(64, FS, bits_of_int(64, j))) = app(app(V0, "bytes"), bits_add(64, FS, bits_of_int(64, j))) proof
        fix j
        assume hj hjl
        have ba: bits_add(64, FS, bits_of_int(64, j)) = int_add(FS, j) by defs(arith(fso, hj, hjl, hfs), bits_add, bits_of_int, pow2)
        have xb: int_add(FS, j) in bits(64) by simp(fso, hj, (int_lt(int_add(FS, j), 18446744073709551616) by arith(fso, hj, hjl, hfs)))
        have so := apply(mp.st_out[B := app(V0, "bytes"), c := m, k := 40, v := 0, x := int_add(FS, j)], xb, hm, simp(), ml, arith(hap, fso, hj, hjl, mo))
        show by simp(ba, so)
      qed
      have leq := apply(tr.le_eq8, {x86_64_linux.store_le(app(V0, "bytes"), m, 40, 0)}, {app(V0, "bytes")}, {FS}, le8)
      have tk := apply(ms.thread_keep, {V0}, {x86_64_linux.store_le(app(V0, "bytes"), m, 40, 0)}, {FS}, ths, leq)
      have ths1: gc.sound(W1) by defs(simp(tk), mallocng_specs.zero_meta)
      // the call: queue's contract on W1 -- an overflow, or m queued
      have H1: mallocng_purpose.list_at(app(W1, "vm"), app(W1, "objs"), PH, l) by simp(lz)
      have J1: mallocng_purpose.joinable(app(W1, "vm"), app(W1, "objs"), PH, l, m) by simp(jz)
      have qa: all regs o2. gc.regs_ok(regs, seq_concat(seq_one(gimple.arg(64, PH)), seq_one(gimple.arg(64, m)))) -> runs(app(mallocng_purpose.queue_purpose_fun(), regs), W1, o2) ->
          (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(W1, "vm", v), OVF)) ||
          (ex V r. (V in x86_64_linux.Vm && mallocng_purpose.queued(app(W1, "vm"), V, app(W1, "objs"), PH, m)) && o2 = ok(fn_update(W1, "vm", V), r)) proof
        fix regs o2
        assume hro h2
        show := apply(mp.qu_q, {W1}, {PH}, {m}, {l}, {regs}, {o2}, hw1, hu1, phb, hm, hl, H1, J1, hro, h2)
      qed
      have cc := apply(gc.contract_callV[P := v. mallocng_purpose.queued(app(W1, "vm"), v, app(W1, "objs"), PH, m)], ths1, hw1, apply(gc.regs2_ex, phb, hm), arith(), hg, qa, b2)
      have c1: (ex v. v in x86_64_linux.Vm && o = exc(fn_update(W1, "vm", v), OVF)) -> runs(SPEC, s, o) proof
        assume h
        obtain v, hv ho from h
        have e: o = exc(fn_update(s, "vm", v), OVF) by simp(ho)
        show := rewrite(sym(e), mp(all_elim(sov, {v}), hv))
      qed
      have c2: (ex V r. (V in x86_64_linux.Vm && mallocng_purpose.queued(app(W1, "vm"), V, app(W1, "objs"), PH, m)) && o = ok(fn_update(W1, "vm", V), empty)) -> runs(SPEC, s, o) proof
        assume h
        obtain V, h1 from h
        obtain r, hV hQ ho from h1
        have e: o = ok(fn_update(s, "vm", V), empty) by simp(ho)
        have q2: mallocng_purpose.queued(ZV, V, OB, PH, m) by simp(hQ)
        have f := apply(mp.fm_done[vm := V0, V := V, objs := OB, phead := PH, m := m], vV, vb, phb, hm, q2)
        show := rewrite(sym(e), mp(all_elim(sdone, {V}), hV, f))
      qed
      show by taut(cc, c1, c2)
    qed
    show by taut(np, yp)
  qed
qed

// free_meta as a C function value, for every callee refining queue's purpose
theorem mp.fm_fun: all g. (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(app(g, regs), s, o) -> runs(app(mallocng_purpose.queue_purpose_fun(), regs), s, o)) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
    runs(app(c_src_malloc_mallocng_malloc.free_meta_fun(g), regs), s, o) -> runs(app(mallocng_purpose.free_meta_purpose_fun(c_src_malloc_mallocng_malloc.__malloc_context), regs), s, o))
proof
  fix g
  assume hg
  have hm: all regs. refines(c_src_malloc_mallocng_malloc.free_meta(bits_of_int(64, app(regs, 0)), g), mallocng_purpose.free_meta_purpose(c_src_malloc_mallocng_malloc.__malloc_context, bits_of_int(64, app(regs, 0))), abi.World) proof
    fix regs
    show := mp(all_elim(mp.fm, {bits_of_int(64, app(regs, 0))}, {g}), simp(), hg)
  qed
  show by defs(apply(g.fun_void[n := 1], hm), c_src_malloc_mallocng_malloc.free_meta_fun, mallocng_purpose.free_meta_purpose_fun)
qed

// queue's machine code (with a_crash's contract) implements its purpose
theorem mp.qu_implements: all statics. tr.implements_at(4206220, mallocng_purpose.queue_purpose_fun(), 4198400, text.code, statics)
proof
  fix statics
  let A := mallocng_specs.a_crash_spec_fun()
  have r: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
      runs(app(c_src_malloc_mallocng_malloc_cfg.queue_fun(A), regs), s, o) -> runs(app(mallocng_purpose.queue_purpose_fun(), regs), s, o) proof
    fix regs s o
    assume h1 hl hs hr
    show := mp(all_elim(mp.qu_fun, {A}, {regs}, {s}, {o}), h1, hl, hs, mp(all_elim(queue_ref, {A}, {regs}, {s}, {o}), h1, hl, hs, hr))
  qed
  show := mp(all_elim(tr.implements_refine, {4206220}, {c_src_malloc_mallocng_malloc_cfg.queue_fun(A)}, {mallocng_purpose.queue_purpose_fun()},
    {4198400}, {text.code}, {statics}), all_elim(qutc.linked, {statics}), r)
qed

// free_meta's machine code (linked with queue's) implements its purpose
theorem mp.fm_implements: all statics. tr.implements_at(4206612, mallocng_purpose.free_meta_purpose_fun(c_src_malloc_mallocng_malloc.__malloc_context), 4198400, text.code, statics)
proof
  fix statics
  let G := c_src_malloc_mallocng_malloc_cfg.queue_fun(mallocng_specs.a_crash_spec_fun())
  // queue's machine-level callee: its CFG form refines its code, its code its purpose
  have h: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(app(G, regs), s, o) ->
      runs(app(mallocng_purpose.queue_purpose_fun(), regs), s, o) proof
    fix regs s o
    assume h1 hl hs hr
    show := mp(all_elim(mp.qu_fun, {mallocng_specs.a_crash_spec_fun()}, {regs}, {s}, {o}), h1, hl, hs,
      mp(all_elim(queue_ref, {mallocng_specs.a_crash_spec_fun()}, {regs}, {s}, {o}), h1, hl, hs, hr))
  qed
  have c2 := mp(all_elim(mp.fm_fun, {G}), h)
  have r: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
      runs(app(c_src_malloc_mallocng_malloc_cfg.free_meta_fun(G), regs), s, o) ->
      runs(app(mallocng_purpose.free_meta_purpose_fun(c_src_malloc_mallocng_malloc.__malloc_context), regs), s, o) proof
    fix regs s o
    assume h1 hl hs hr
    show := mp(all_elim(c2, {regs}, {s}, {o}), h1, hl, hs, mp(all_elim(free_meta_ref, {G}, {regs}, {s}, {o}), h1, hl, hs, hr))
  qed
  show := mp(all_elim(tr.implements_refine, {4206612}, {c_src_malloc_mallocng_malloc_cfg.free_meta_fun(G)},
    {mallocng_purpose.free_meta_purpose_fun(c_src_malloc_mallocng_malloc.__malloc_context)}, {4198400}, {text.code}, {statics}), all_elim(fmtc.linked, {statics}), r)
qed

// the ghost record with a new abstract state: a ghost record
theorem mp.g_upd: all h A2. h in mp.G -> A2 in mallocng.Abs -> A2 in univ(1) -> fn_update(h, "A", A2) in mp.G
proof
  fix h A2
  assume hh ha2 hu2
  obtain x y, hx hy he from mp(rec_and_elim[a := malloc.Heap.ghost, b := mallocng_purpose.MallocAbs.ghost, s := h], hh)
  have yp yf yd _ := (y in powerset(cart(insert("A", empty), univ(1))) && is_fun(y) && dom(y) = insert("A", empty) && app(y, "A") in mallocng.Abs
    by simp(expand(hy, mallocng_purpose.MallocAbs.ghost)))
  have xf xd := (is_fun(x) && dom(x) = insert("blocks", empty) by simp(expand(hx, malloc.Heap.ghost)))
  let Y2 := fn_update(y, "A", A2)
  have y2f y2d := mp(fn_update_fd[f := y, k := "A", v := A2, d := insert("A", empty)], yf, yd, simp())
  have ys: subset(y, cart(insert("A", empty), univ(1))) by taut(powerset_def[s := cart(insert("A", empty), univ(1)), a := y], yp)
  have sub: all z. z in Y2 -> z in cart(insert("A", empty), univ(1)) proof
    fix z
    assume hz
    have c := fn_update_iff[f := y, k := "A", v := A2, z := z]
    have c1: z in y -> z in cart(insert("A", empty), univ(1)) proof
      assume h1
      show := mp(subset_elim[a := y, b := cart(insert("A", empty), univ(1)), z := z], ys, h1)
    qed
    have c2: z = pair("A", A2) -> z in cart(insert("A", empty), univ(1)) proof
      assume h2
      show := rewrite(sym(h2), mp(cart_intro[a := insert("A", empty), b := univ(1), x := "A", y := A2], simp(), hu2))
    qed
    show by taut(c, hz, c1, c2)
  qed
  have pw: Y2 in powerset(cart(insert("A", empty), univ(1))) by taut(powerset_def[s := cart(insert("A", empty), univ(1)), a := Y2], (subset(Y2, cart(insert("A", empty), univ(1))) by defs(sub, subset)))
  have ap: app(Y2, "A") = A2 := app_update_same[f := y, k := "A", v := A2]
  have sd := set_select_def[s := powerset(cart(insert("A", empty), univ(1))), p := x0. (is_fun(x0) && dom(x0) = insert("A", empty)) && app(x0, "A") in mallocng.Abs, z := Y2]
  have y2t: Y2 in mallocng_purpose.MallocAbs.ghost by defs(taut(sd, pw, y2f, y2d, rewrite(sym(ap), ha2)), mallocng_purpose.MallocAbs.ghost)
  have ri := mp(rec_and_intro[a := malloc.Heap.ghost, b := mallocng_purpose.MallocAbs.ghost, x := x, y := Y2], hx, y2t)
  have xk := apply(mp.one_key, xf, xd)
  have nk: all z. z in x -> fst(z) != "A" proof
    fix z
    assume hz
    show by simp(mp(all_elim(xk, {z}), hz))
  qed
  have eu := mp(fn_update_union_r[a := x, b := y, k := "A", v := A2], nk)
  have e2: fn_update(h, "A", A2) = union2(x, Y2) := trans(subst({w. fn_update(h, "A", A2) = fn_update(w, "A", A2)}, he, refl({fn_update(h, "A", A2)})), eu)
  show := rewrite(sym(e2), ri)
qed

// ----------------------------------------------------------------------
//  activate_group: its code refines its purpose

// activate_group's contract, the ghost part h read: the code's run
// (`ms.ag_run`) writes the two masks of the new state A2 -- m's freed
// slots up to its active index made available (`mp.act_state`) -- the
// invariant kept (`mp.holds_in_act`), nothing outside the allocator
// touched, the new available mask returned
theorem mp.ag_run(c, m, g0, g1, s, h, o): c in mallocng.Cfg -> m in bits(64) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(app(g1, regs), s, o) -> runs(app(mallocng_specs.a_cas_spec_fun(), regs), s, o)) ->
  s in abi.World -> h in mp.G ->
  mallocng.holds_in(c, app(h, "A"), app(s, "vm"), app(h, "blocks")) -> mallocng.no_reserved(app(h, "A")) -> abi.thread_ok(app(s, "vm"), app(s, "fs_base")) ->
  mallocng.is_used(app(h, "A"), m) -> app(app(app(app(h, "A"), "metas"), m), "avail") = 0 ->
  (all x2. all x3. x2 in omega && x3 in omega -> (int_lt(x2, 48) && int_lt(x3, seq_len(app(app(app(h, "A"), "active"), x2)))) && app(app(app(app(h, "A"), "active"), x2), x3) = m -> x3 = 0) ->
  runs(c_src_malloc_mallocng_malloc.activate_group(m, g0, g1), s, o) ->
  (ex v. v in x86_64_linux.Vm && o = exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex A2 V2. A2 in mallocng.Abs && A2 in univ(1) &&
     mallocng_purpose.activated(app(h, "A"), A2, m, mallocng_purpose.active_idx(app(s, "vm"), app(app(app(h, "A"), "metas"), m))) &&
     V2 in x86_64_linux.Vm && mallocng.holds_in(c, A2, V2, app(h, "blocks")) && mallocng.untouched(c, app(h, "A"), app(h, "blocks"), app(s, "vm"), V2, empty) &&
     o = ok(fn_update(s, "vm", V2), bits_of_int(32, app(app(app(A2, "metas"), m), "avail"))))
proof
  assume hc hm hg1 hs hh hin hnr hth hused av0 hhead hr
  let A := app(h, "A")
  let B := app(h, "blocks")
  let V0 := app(s, "vm")
  let OVF := exc_val("stack_overflow", empty)
  have hgu _ hbt hat := mp(all_elim(mp.g_rec, {h}), hh)
  have au := mp(app_univ[u := 1, f := h, k := "A"], hgu)
  have pv _ _ pb := apply(ms.world_parts, hs)
  have {pre, efr = freed, eact = act, eidx = idx, inat, ilt} := apply(mp.ag_pre[c := c, A := A, vm := V0, b := B, objs := app(s, "objs"), fs := app(s, "fs_base"), g := m],
    hc, au, hat, hbt, pb, hm, hin, hnr, hth, hused, av0)
  have run := mp(all_elim(ms.ag_run, {m}, {g0}, {g1}, {s}, {o}), hm, hg1, hs, pre, hr)
  let IDX := mallocng_purpose.active_idx(V0, app(app(A, "metas"), m))
  let V := app(app(A, "metas"), m)
  let F := app(V, "freed")
  let ACT := mp.act_mask(IDX)
  let AV := bits_and(32, F, ACT)
  let FR := bits_and(32, F, bits_not(32, ACT))
  let FP := mallocng.footprint(c, A, B)
  let HP := mallocng.held(c, A, B)
  let W1 := mallocng_specs.wr32(V0, int_add(m, 28), FR)
  let V2 := mallocng_specs.wr32(W1, int_add(m, 24), AV)
  have mo: m in omega by simp(hm)
  // the new state
  have {a2 = abs, u2 = univ, act2 = act, at = at} := apply(mp.act_state[A := A, g := m, idx := IDX], hat, mo, inat)
  let A2 := mp.act_abs(A, m, IDX)
  have eav: app(app(app(A2, "metas"), m), "avail") = AV by simp(at)
  have efd: app(app(app(A2, "metas"), m), "freed") = FR by simp(at)
  have avb := apply(bits_and_in[n := 32, x := F, y := ACT], simp())
  have frb := apply(bits_and_in[n := 32, x := F, y := bits_not(32, ACT)], simp())
  have avo avl := (AV in omega && int_lt(AV, 4294967296) by defs(simp(avb), bits, pow2))
  have fro frl := (FR in omega && int_lt(FR, 4294967296) by defs(simp(frb), bits, pow2))
  // the code's memory: the two masks written
  have mtop _ := apply(mp.meta_word[c := c, A := A, vm := V0, b := B, g := m], hc, au, hat, hin, hused)
  have _ _ mfp := apply(mp.meta_mem[c := c, A := A, vm := V0, b := B, g := m], hc, au, hat, hin, hused)
  have ba24: bits_add(64, m, 24) = int_add(m, 24) by defs(arith(hm, mtop), bits_add, pow2)
  have ba28: bits_add(64, m, 28) = int_add(m, 28) by defs(arith(hm, mtop), bits_add, pow2)
  have ev0: mallocng_specs.activate_group_vm(V0, m) = mallocng_specs.wr32(mallocng_specs.wr32(V0, bits_add(64, m, 28), bits_and(32, mallocng_specs.ag_freed(V0, m), bits_not(32, mallocng_specs.ag_act(V0, m)))),
      bits_add(64, m, 24), bits_and(32, mallocng_specs.ag_freed(V0, m), mallocng_specs.ag_act(V0, m)))
    by defs(refl({mallocng_specs.wr32(mallocng_specs.wr32(V0, bits_add(64, m, 28), bits_and(32, mallocng_specs.ag_freed(V0, m), bits_not(32, mallocng_specs.ag_act(V0, m)))),
      bits_add(64, m, 24), bits_and(32, mallocng_specs.ag_freed(V0, m), mallocng_specs.ag_act(V0, m)))}), mallocng_specs.activate_group_vm)
  have ev: mallocng_specs.activate_group_vm(V0, m) = V2 := rewrite(ba24, rewrite(ba28, rewrite(eact, rewrite(efr, ev0))))
  let X := bits_and(32, mallocng_specs.ag_freed(V0, m), mallocng_specs.ag_act(V0, m))
  have er0 := subst({y. X = bits_and(32, y, mallocng_specs.ag_act(V0, m))}, efr, refl({X}))
  have er: X = AV := subst({y. X = bits_and(32, F, y)}, eact, er0)
  have c24: int_add(m, 24) in bits(64) by arith(hm, mtop)
  have c28: int_add(m, 28) in bits(64) by arith(hm, mtop)
  have w1b := apply(mp.w32_typed[V := V0, c := int_add(m, 28), v := FR], pb)
  have eb: all x. x in bits(64) -> !(int_le(int_add(m, 24), x) && int_lt(x, int_add(m, 32))) -> app(app(V2, "bytes"), x) = app(app(V0, "bytes"), x) proof
    fix x
    assume hx hw
    have e2 := apply(mp.w32_out[V := W1, c := int_add(m, 24), v := AV, x := x], hx, c24, arith(hm, mtop), arith(hw, hx, hm))
    have e1 := apply(mp.w32_out[V := V0, c := int_add(m, 28), v := FR, x := x], hx, c28, arith(hm, mtop), arith(hw, hx, hm))
    show := trans(e2, e1)
  qed
  have ep: app(V2, "pages") = app(V0, "pages") := trans(apply(mp.w32_keep[V := W1, c := int_add(m, 24), v := AV, k := "pages"], simp()), apply(mp.w32_keep[V := V0, c := int_add(m, 28), v := FR, k := "pages"], simp()))
  have ek: app(V2, "brk") = app(V0, "brk") := trans(apply(mp.w32_keep[V := W1, c := int_add(m, 24), v := AV, k := "brk"], simp()), apply(mp.w32_keep[V := V0, c := int_add(m, 28), v := FR, k := "brk"], simp()))
  have es: app(V2, "brk_start") = app(V0, "brk_start") :=
    trans(apply(mp.w32_keep[V := W1, c := int_add(m, 24), v := AV, k := "brk_start"], simp()), apply(mp.w32_keep[V := V0, c := int_add(m, 28), v := FR, k := "brk_start"], simp()))
  have v2t := apply(mp.w32_vm[V := W1, c := int_add(m, 24), v := AV], apply(mp.w32_vm[V := V0, c := int_add(m, 28), v := FR], pv))
  // the masks read back, through the view
  have fp4: all o. o in omega -> int_le(o, 36) -> (all i. i in omega -> int_lt(i, 4) -> int_add(int_add(m, o), i) in HP) proof
    fix o0
    assume ho hol
    fix i
    assume hi hil
    have a := mp(all_elim(mfp, {int_add(int_add(m, o0), i)}), arith(mo, ho, hi), arith(mo, ho, hi), arith(mo, ho, hi, hol, hil))
    have a1 _ _ := a
    show := a1
  qed
  have vr24 := apply(mp.view_read[vm := V2, fp := HP, a := int_add(m, 24), n := 4], arith(mo), simp(), simp(), mp(all_elim(fp4, {24}), simp(), simp()))
  have vr28 := apply(mp.view_read[vm := V2, fp := HP, a := int_add(m, 28), n := 4], arith(mo), simp(), simp(), mp(all_elim(fp4, {28}), simp(), simp()))
  have b24 := apply(mp.w32_at[V := W1, c := int_add(m, 24), v := AV], w1b, c24, avo, avl)
  have b28o := apply(mp.w32_rd_out[V := W1, c := int_add(m, 24), v := AV, a := int_add(m, 28), n := 4], arith(mo), simp(), c24, arith(hm, mtop), arith(hm, mtop), arith(mo))
  have b28 := apply(mp.w32_at[V := V0, c := int_add(m, 28), v := FR], pb, c28, fro, frl)
  have rav: mallocng.rd(mallocng.mview(V2, HP), int_add(m, 24), 4) = app(app(app(A2, "metas"), m), "avail") := trans(sym(vr24), trans(b24, sym(eav)))
  have rfr: mallocng.rd(mallocng.mview(V2, HP), int_add(m, 28), 4) = app(app(app(A2, "metas"), m), "freed") := trans(sym(vr28), trans(b28o, trans(b28, sym(efd))))
  // m past no active list's head
  have hac2: all sc. all k. sc in omega && k in omega -> int_lt(sc, 48) && int_lt(k, seq_len(app(app(A, "active"), sc))) -> int_lt(0, k) ->
      app(app(app(A, "active"), sc), k) = m -> app(app(app(A2, "metas"), m), "avail") = 0 && !(app(app(app(A2, "metas"), m), "freed") = 0) proof
    fix sc k
    assume ho hl hk he
    have z := mp(all_elim(hhead, {sc}, {k}), ho, taut(hl, he))
    have f: false by arith(z, hk)
    show by taut(f)
  qed
  have hin2 := apply(mp.holds_in_act[c := c, A := A, A2 := A2, vm := V0, vm2 := V2, b := B, g := m, idx := IDX],
    hc, au, hat, a2, hbt, hin, act2, hused, av0, eidx, eb, ep, ek, rav, rfr, hac2)
  // outside the allocator: untouched
  have ut: all x0. x0 in omega -> (!(x0 in FP) && !(x0 in empty)) && x86_64_linux.mapped(V0, int_div(x0, x86_64_linux.PAGE)) ->
      app(app(V2, "bytes"), bits_of_int(64, x0)) = app(app(V0, "bytes"), bits_of_int(64, x0)) &&
      app(app(V2, "pages"), int_div(x0, x86_64_linux.PAGE)) = app(app(V0, "pages"), int_div(x0, x86_64_linux.PAGE)) proof
    fix a
    assume hao hx
    have nf _ hmp := hx
    have lt _ := expand(hmp, x86_64_linux.mapped)
    have ts: int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE) = 34359738367 by defs(simp(), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
    have pg: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
    have al: int_lt(a, 18446744073709551616) by arith(lt, ts, pg, hao)
    have e: bits_of_int(64, a) = a by defs(arith(hao, al), bits_of_int, pow2)
    // (m's mask words: the allocator's)
    have out: !(int_le(int_add(m, 24), a) && int_lt(a, int_add(m, 32))) proof
      assume hw
      have w1 w2 := hw
      have inh _ _ := mp(all_elim(mfp, {a}), hao, arith(w1), arith(w2))
      have {inf = fp} := apply(mp.held_fp, inh)
      show by taut(inf, nf)
    qed
    have bb := rewrite(sym(e), mp(all_elim(eb, {a}), (a in bits(64) by arith(hao, al)), out))
    have pp: app(app(V2, "pages"), int_div(a, x86_64_linux.PAGE)) = app(app(V0, "pages"), int_div(a, x86_64_linux.PAGE)) by simp(ep)
    show by taut(bb, pp)
  qed
  have unt: mallocng.untouched(c, A, B, V0, V2, empty) by defs(taut(ut, es), mallocng.untouched)
  // the outcome
  have c1: (ex v. v in x86_64_linux.Vm && o = exc(fn_update(s, "vm", v), OVF)) ->
      (ex v. v in x86_64_linux.Vm && o = exc(fn_update(s, "vm", v), OVF)) ||
      (ex A2 V2. A2 in mallocng.Abs && A2 in univ(1) && mallocng_purpose.activated(A, A2, m, IDX) &&
        V2 in x86_64_linux.Vm && mallocng.holds_in(c, A2, V2, B) && mallocng.untouched(c, A, B, V0, V2, empty) &&
        o = ok(fn_update(s, "vm", V2), bits_of_int(32, app(app(app(A2, "metas"), m), "avail")))) proof
    assume e
    show by taut(e)
  qed
  have c2: o = ok(fn_update(s, "vm", mallocng_specs.activate_group_vm(V0, m)), bits_and(32, mallocng_specs.ag_freed(V0, m), mallocng_specs.ag_act(V0, m))) ->
      (ex v. v in x86_64_linux.Vm && o = exc(fn_update(s, "vm", v), OVF)) ||
      (ex A2 V2. A2 in mallocng.Abs && A2 in univ(1) && mallocng_purpose.activated(A, A2, m, IDX) &&
        V2 in x86_64_linux.Vm && mallocng.holds_in(c, A2, V2, B) && mallocng.untouched(c, A, B, V0, V2, empty) &&
        o = ok(fn_update(s, "vm", V2), bits_of_int(32, app(app(app(A2, "metas"), m), "avail")))) proof
    assume e
    have bv: bits_of_int(32, app(app(app(A2, "metas"), m), "avail")) = AV by defs(simp(eav, avo, avl), bits_of_int, pow2)
    have oe: o = ok(fn_update(s, "vm", V2), bits_of_int(32, app(app(app(A2, "metas"), m), "avail"))) :=
      subst({y. o = ok(fn_update(s, "vm", V2), y)}, sym(bv), rewrite(er, rewrite(ev, e)))
    have x: ex A2 V2. A2 in mallocng.Abs && A2 in univ(1) && mallocng_purpose.activated(A, A2, m, IDX) &&
        V2 in x86_64_linux.Vm && mallocng.holds_in(c, A2, V2, B) && mallocng.untouched(c, A, B, V0, V2, empty) &&
        o = ok(fn_update(s, "vm", V2), bits_of_int(32, app(app(app(A2, "metas"), m), "avail")))
      by ex_intro({A2}, {V2}, taut(a2, u2, act2, v2t, hin2, unt, oe))
    show by taut(x)
  qed
  show by taut(run, c1, c2)
qed

// activate_group's code by its purpose: its contract (`mp.ag_run`), the
// ghost part's A the activated state
theorem mp.ag: all c m g0 g1. c in mallocng.Cfg -> m in bits(64) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(app(g1, regs), s, o) -> runs(app(mallocng_specs.a_cas_spec_fun(), regs), s, o)) ->
  refines_ghost(c_src_malloc_mallocng_malloc.activate_group(m, g0, g1), mallocng_purpose.activate_group_purpose(c, m), abi.World, mp.G)
proof
  fix c m g0 g1
  assume hc hm hg1
  have rp: all s o. runs(c_src_malloc_mallocng_malloc.activate_group(m, g0, g1), s, o) -> pair(s, o) in univ(1) proof
    fix s o
    assume hr
    show := apply(g.runs_univ, expand(hr, c_src_malloc_mallocng_malloc.activate_group))
  qed
  have body: all s h o. s in abi.World -> h in mp.G -> runs(c_src_malloc_mallocng_malloc.activate_group(m, g0, g1), s, o) ->
      (((((mallocng.holds_in(c, app(union2(s, h), "A"), app(union2(s, h), "vm"), app(union2(s, h), "blocks")) && mallocng.no_reserved(app(union2(s, h), "A"))) &&
        abi.thread_ok(app(union2(s, h), "vm"), app(union2(s, h), "fs_base"))) && mallocng.is_used(app(union2(s, h), "A"), m)) &&
        app(app(app(app(union2(s, h), "A"), "metas"), m), "avail") = 0) &&
        (all x2. all x3. x2 in omega && x3 in omega -> (int_lt(x2, 48) && int_lt(x3, seq_len(app(app(app(union2(s, h), "A"), "active"), x2)))) && app(app(app(app(union2(s, h), "A"), "active"), x2), x3) = m -> x3 = 0)) ->
      (ex v. v in x86_64_linux.Vm && o = exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty))) ||
      (ex s1 v h2. h2 in mp.G && o = ok(s1, v) &&
        letin(app(union2(s, h), "A"), x3. letin(app(union2(s, h), "vm"), x4. any_rel(x5. x5 in mallocng.Abs && mallocng_purpose.activated(x3, x5, m, mallocng_purpose.active_idx(x4, app(app(x3, "metas"), m))),
          x5. letin(fn_update(union2(s, h), "A", x5), x6. any_rel(x7. x7 in x86_64_linux.Vm && (mallocng.holds_in(c, app(fn_update(x6, "vm", x7), "A"), app(fn_update(x6, "vm", x7), "vm"), app(fn_update(x6, "vm", x7), "blocks")) &&
            mallocng.untouched(c, x3, app(fn_update(x6, "vm", x7), "blocks"), x4, app(fn_update(x6, "vm", x7), "vm"), empty)),
          x7. letin(fn_update(x6, "vm", x7), x8. exc(pair(union2(s1, h2), empty), pair("ret", v)) = exc(pair(x8, empty), pair("ret", bits_of_int(32, app(app(app(app(x8, "A"), "metas"), m), "avail"))))))))))) proof
    fix s h o
    assume hs hh hr hpre
    let S := union2(s, h)
    let A := app(h, "A")
    let B := app(h, "blocks")
    let V0 := app(s, "vm")
    let OVF := exc_val("stack_overflow", empty)
    have _ hd _ _ := mp(all_elim(mp.g_rec, {h}), hh)
    have sd: dom(s) = insert("vm", insert("os", insert("fs_base", insert("cpu", insert("objs", empty))))) by simp(expand(hs, abi.World))
    have aS: app(S, "A") = A by simp(sd, hd)
    have vS: app(S, "vm") = V0 by simp(sd, hd)
    have bS: app(S, "blocks") = B by simp(sd, hd)
    have hin: mallocng.holds_in(c, A, V0, B) by simp(hpre, sd, hd)
    have hnr: mallocng.no_reserved(A) by simp(hpre, sd, hd)
    have hth: abi.thread_ok(V0, app(s, "fs_base")) by simp(hpre, sd, hd)
    have hu: mallocng.is_used(A, m) by simp(hpre, sd, hd)
    have av0: app(app(app(A, "metas"), m), "avail") = 0 by simp(hpre, sd, hd)
    have hhead: all x2. all x3. x2 in omega && x3 in omega -> (int_lt(x2, 48) && int_lt(x3, seq_len(app(app(A, "active"), x2)))) && app(app(app(A, "active"), x2), x3) = m -> x3 = 0
      by simp(hpre, sd, hd)
    have run := apply(mp.ag_run[c := c, m := m, g0 := g0, g1 := g1, s := s, h := h, o := o], hc, hm, hg1, hs, hh, hin, hnr, hth, hu, av0, hhead, hr)
    // a return: the ghost part's A the new state
    have c2: (ex A2 V2. A2 in mallocng.Abs && A2 in univ(1) && mallocng_purpose.activated(A, A2, m, mallocng_purpose.active_idx(V0, app(app(A, "metas"), m))) &&
        V2 in x86_64_linux.Vm && mallocng.holds_in(c, A2, V2, B) && mallocng.untouched(c, A, B, V0, V2, empty) &&
        o = ok(fn_update(s, "vm", V2), bits_of_int(32, app(app(app(A2, "metas"), m), "avail")))) ->
      (ex s1 v h2. h2 in mp.G && o = ok(s1, v) &&
        letin(app(S, "A"), x3. letin(app(S, "vm"), x4. any_rel(x5. x5 in mallocng.Abs && mallocng_purpose.activated(x3, x5, m, mallocng_purpose.active_idx(x4, app(app(x3, "metas"), m))),
          x5. letin(fn_update(S, "A", x5), x6. any_rel(x7. x7 in x86_64_linux.Vm && (mallocng.holds_in(c, app(fn_update(x6, "vm", x7), "A"), app(fn_update(x6, "vm", x7), "vm"), app(fn_update(x6, "vm", x7), "blocks")) &&
            mallocng.untouched(c, x3, app(fn_update(x6, "vm", x7), "blocks"), x4, app(fn_update(x6, "vm", x7), "vm"), empty)),
          x7. letin(fn_update(x6, "vm", x7), x8. exc(pair(union2(s1, h2), empty), pair("ret", v)) = exc(pair(x8, empty), pair("ret", bits_of_int(32, app(app(app(app(x8, "A"), "metas"), m), "avail"))))))))))) proof
      assume e
      obtain A2 V2, ha2 hu2 hact hv2 hin2 hunt ho from e
      let S1 := fn_update(fn_update(S, "A", A2), "vm", V2)
      let H2 := fn_update(h, "A", A2)
      let s1 := fn_update(s, "vm", V2)
      let v := bits_of_int(32, app(app(app(A2, "metas"), m), "avail"))
      have hg2 := apply(mp.g_upd, {h}, {A2}, hh, ha2, hu2)
      // the world's part and the ghost part joined: the spec's state
      have sk := apply(abi.keys_of[f := s, d := insert("vm", insert("os", insert("fs_base", insert("cpu", insert("objs", empty)))))], sd)
      have na: all z. z in s -> fst(z) != "A" proof
        fix z
        assume hz
        show by simp(mp(all_elim(sk, {z}), hz))
      qed
      have _ hk := mp(all_elim(mp.g_world, {H2}), hg2)
      have nv: all z. z in H2 -> fst(z) != "vm" proof
        fix z
        assume hz
        show by simp(mp(all_elim(hk, {z}), hz))
      qed
      have e1 := mp(fn_update_union_r[a := s, b := h, k := "A", v := A2], na)
      have e2 := mp(fn_update_union_l[a := s, b := H2, k := "vm", v := V2], nv)
      have eS: union2(s1, H2) = S1 := sym(trans(subst({y. S1 = fn_update(y, "vm", V2)}, e1, refl({S1})), e2))
      // B's witnesses: A2, V2
      have s1a: app(S1, "A") = A2 by simp()
      have s1v: app(S1, "vm") = V2 by simp()
      have s1b: app(S1, "blocks") = B by simp(bS)
      have d5: A2 in mallocng.Abs && mallocng_purpose.activated(app(S, "A"), A2, m, mallocng_purpose.active_idx(app(S, "vm"), app(app(app(S, "A"), "metas"), m))) by simp(ha2, hact, aS, vS)
      have d7: V2 in x86_64_linux.Vm && (mallocng.holds_in(c, app(S1, "A"), app(S1, "vm"), app(S1, "blocks")) &&
          mallocng.untouched(c, app(S, "A"), app(S1, "blocks"), app(S, "vm"), app(S1, "vm"), empty)) by simp(hv2, hin2, hunt, s1a, s1v, s1b, aS, vS)
      have ex: exc(pair(union2(s1, H2), empty), pair("ret", v)) = exc(pair(S1, empty), pair("ret", bits_of_int(32, app(app(app(app(S1, "A"), "metas"), m), "avail")))) by simp(eS, s1a)
      have k7: ex x7. (x7 in x86_64_linux.Vm && (mallocng.holds_in(c, app(fn_update(fn_update(S, "A", A2), "vm", x7), "A"), app(fn_update(fn_update(S, "A", A2), "vm", x7), "vm"), app(fn_update(fn_update(S, "A", A2), "vm", x7), "blocks")) &&
            mallocng.untouched(c, app(S, "A"), app(fn_update(fn_update(S, "A", A2), "vm", x7), "blocks"), app(S, "vm"), app(fn_update(fn_update(S, "A", A2), "vm", x7), "vm"), empty))) &&
          exc(pair(union2(s1, H2), empty), pair("ret", v)) = exc(pair(fn_update(fn_update(S, "A", A2), "vm", x7), empty), pair("ret", bits_of_int(32, app(app(app(app(fn_update(fn_update(S, "A", A2), "vm", x7), "A"), "metas"), m), "avail"))))
        by ex_intro({V2}, taut(d7, ex))
      have k5: ex x5. (x5 in mallocng.Abs && mallocng_purpose.activated(app(S, "A"), x5, m, mallocng_purpose.active_idx(app(S, "vm"), app(app(app(S, "A"), "metas"), m)))) &&
          (!(ex x7. x7 in x86_64_linux.Vm && (mallocng.holds_in(c, app(fn_update(fn_update(S, "A", x5), "vm", x7), "A"), app(fn_update(fn_update(S, "A", x5), "vm", x7), "vm"), app(fn_update(fn_update(S, "A", x5), "vm", x7), "blocks")) &&
             mallocng.untouched(c, app(S, "A"), app(fn_update(fn_update(S, "A", x5), "vm", x7), "blocks"), app(S, "vm"), app(fn_update(fn_update(S, "A", x5), "vm", x7), "vm"), empty))) ||
           (ex x7. (x7 in x86_64_linux.Vm && (mallocng.holds_in(c, app(fn_update(fn_update(S, "A", x5), "vm", x7), "A"), app(fn_update(fn_update(S, "A", x5), "vm", x7), "vm"), app(fn_update(fn_update(S, "A", x5), "vm", x7), "blocks")) &&
             mallocng.untouched(c, app(S, "A"), app(fn_update(fn_update(S, "A", x5), "vm", x7), "blocks"), app(S, "vm"), app(fn_update(fn_update(S, "A", x5), "vm", x7), "vm"), empty))) &&
             exc(pair(union2(s1, H2), empty), pair("ret", v)) = exc(pair(fn_update(fn_update(S, "A", x5), "vm", x7), empty), pair("ret", bits_of_int(32, app(app(app(app(fn_update(fn_update(S, "A", x5), "vm", x7), "A"), "metas"), m), "avail"))))))
        by ex_intro({A2}, taut(d5, k7))
      have bB: letin(app(S, "A"), x3. letin(app(S, "vm"), x4. any_rel(x5. x5 in mallocng.Abs && mallocng_purpose.activated(x3, x5, m, mallocng_purpose.active_idx(x4, app(app(x3, "metas"), m))),
          x5. letin(fn_update(S, "A", x5), x6. any_rel(x7. x7 in x86_64_linux.Vm && (mallocng.holds_in(c, app(fn_update(x6, "vm", x7), "A"), app(fn_update(x6, "vm", x7), "vm"), app(fn_update(x6, "vm", x7), "blocks")) &&
            mallocng.untouched(c, x3, app(fn_update(x6, "vm", x7), "blocks"), x4, app(fn_update(x6, "vm", x7), "vm"), empty)),
          x7. letin(fn_update(x6, "vm", x7), x8. exc(pair(union2(s1, H2), empty), pair("ret", v)) = exc(pair(x8, empty), pair("ret", bits_of_int(32, app(app(app(app(x8, "A"), "metas"), m), "avail"))))))))))
        by defs(taut(k5), letin, any_rel)
      show by ex_intro({s1}, {v}, {H2}, taut(hg2, ho, bB))
    qed
    show by taut(run, c2)
  qed
  show by defs(apply(ct.refines_contract_g, mp.g_world, rp, body), mallocng_purpose.activate_group_purpose)
qed

theorem mp.ag_fun: all c regs g0 g1. c in mallocng.Cfg ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(app(g1, regs), s, o) -> runs(app(mallocng_specs.a_cas_spec_fun(), regs), s, o)) ->
  regs in abi.ARGS ->
  refines_ghost(app(c_src_malloc_mallocng_malloc.activate_group_fun(g0, g1), regs), app(mallocng_purpose.activate_group_purpose_fun(c), regs), abi.World, mp.G)
proof
  fix c regs g0 g1
  assume hc hg1 hr
  have hm: all regs. refines_ghost(c_src_malloc_mallocng_malloc.activate_group(bits_of_int(64, app(regs, 0)), g0, g1), mallocng_purpose.activate_group_purpose(c, bits_of_int(64, app(regs, 0))), abi.World, mp.G) proof
    fix regs
    show := mp(all_elim(mp.ag, {c}, {bits_of_int(64, app(regs, 0))}, {g0}, {g1}), hc, simp(), hg1)
  qed
  have w := mp(g.fun_res_ghost[p := x0. c_src_malloc_mallocng_malloc.activate_group(bits_of_int(64, app(x0, 0)), g0, g1), q := x0. mallocng_purpose.activate_group_purpose(c, bits_of_int(64, app(x0, 0))), w := 32, n := 1, G := mp.G], mp.g_univ, hm)
  show by defs(mp(all_elim(w, {regs}), hr), c_src_malloc_mallocng_malloc.activate_group_fun, mallocng_purpose.activate_group_purpose_fun, letin)
qed

// (the purpose spec diverges nowhere it does not also raise: only where
// it allows anything -- no activated state, no memory holding it)
theorem mp.ag_divg: all c. tr.div_raises_g(mp.G, mallocng_purpose.activate_group_purpose_fun(c))
proof
  fix c
  have qu: all regs s o. runs(mallocng_purpose.activate_group_purpose(c, bits_of_int(64, app(regs, 0))), s, o) -> pair(s, o) in univ(1) proof
    fix regs s o
    assume hr
    show := apply(g.runs_univ, expand(hr, mallocng_purpose.activate_group_purpose))
  qed
  have qd: all regs w h t. regs in abi.ARGS -> w in abi.World -> w in univ(1) -> h in mp.G ->
      runs(mallocng_purpose.activate_group_purpose(c, bits_of_int(64, app(regs, 0))), union2(w, h), diverge(t)) ->
      runs(mallocng_purpose.activate_group_purpose(c, bits_of_int(64, app(regs, 0))), union2(w, h), exc(union2(w, h), empty)) proof
    fix regs w h t
    assume _ hw hwu hh hr
    let S := union2(w, h)
    let m := bits_of_int(64, app(regs, 0))
    have {su = univ, sv = vm} := apply(mp.gS, hw, hwu, hh)
    have bp: all x x2. letin(app(S, "A"), x3. letin(app(S, "vm"), x4. any_rel(x5. x5 in mallocng.Abs && mallocng_purpose.activated(x3, x5, m, mallocng_purpose.active_idx(x4, app(app(x3, "metas"), m))),
          x5. letin(fn_update(S, "A", x5), x6. any_rel(x7. x7 in x86_64_linux.Vm && (mallocng.holds_in(c, app(fn_update(x6, "vm", x7), "A"), app(fn_update(x6, "vm", x7), "vm"), app(fn_update(x6, "vm", x7), "blocks")) &&
            mallocng.untouched(c, x3, app(fn_update(x6, "vm", x7), "blocks"), x4, app(fn_update(x6, "vm", x7), "vm"), empty)),
          x7. letin(fn_update(x6, "vm", x7), x8. x = exc(pair(x8, empty), pair("ret", bits_of_int(32, app(app(app(app(x8, "A"), "metas"), m), "avail")))))))))) -> fst(x) = 2 ->
        letin(app(S, "A"), x3. letin(app(S, "vm"), x4. any_rel(x5. x5 in mallocng.Abs && mallocng_purpose.activated(x3, x5, m, mallocng_purpose.active_idx(x4, app(app(x3, "metas"), m))),
          x5. letin(fn_update(S, "A", x5), x6. any_rel(x7. x7 in x86_64_linux.Vm && (mallocng.holds_in(c, app(fn_update(x6, "vm", x7), "A"), app(fn_update(x6, "vm", x7), "vm"), app(fn_update(x6, "vm", x7), "blocks")) &&
            mallocng.untouched(c, x3, app(fn_update(x6, "vm", x7), "blocks"), x4, app(fn_update(x6, "vm", x7), "vm"), empty)),
          x7. letin(fn_update(x6, "vm", x7), x8. x2 = exc(pair(x8, empty), pair("ret", bits_of_int(32, app(app(app(app(x8, "A"), "metas"), m), "avail")))))))))) proof
      fix x x2
      assume h1 h2
      show by defs(apply(ct.dv_ret2, expand(h1, letin), h2), letin)
    qed
    have r2 := apply(ct.contract_div, su, sv, expand(hr, mallocng_purpose.activate_group_purpose), bp)
    show by defs(r2, mallocng_purpose.activate_group_purpose)
  qed
  show by defs(apply(ct.fun_divg, mp.g_univ, qu, qd), mallocng_purpose.activate_group_purpose_fun)
qed

// activate_group's machine code (linked with a_crash's spec and a_cas's
// code) implements its purpose
theorem mp.ag_implements: all c statics. c in mallocng.Cfg ->
  abi.implements2_at(mp.G, 4206671, mallocng_purpose.activate_group_purpose_fun(c), 4198400, text.code, statics)
proof
  fix c statics
  assume hc
  have hdr := all_elim(mp.ag_divg, {c})
  let LOW := c_src_malloc_mallocng_malloc.activate_group_fun(mallocng_specs.a_crash_spec_fun(), c_src_malloc_mallocng_malloc_cfg.a_cas_fun())
  have r: all args. args in abi.ARGS -> refines_ghost(app(LOW, args), app(mallocng_purpose.activate_group_purpose_fun(c), args), abi.World, mp.G) proof
    fix args
    assume ha
    show := mp(all_elim(mp.ag_fun, {c}, {args}, {mallocng_specs.a_crash_spec_fun()}, {c_src_malloc_mallocng_malloc_cfg.a_cas_fun()}), hc, cc.a_cas, ha)
  qed
  have rf := mp(all_elim(activate_group_ref, {mallocng_specs.a_crash_spec_fun()}, {c_src_malloc_mallocng_malloc_cfg.a_cas_fun()}), acr.io, acstc.io)
  have st := mp(all_elim(tr.implements_refine, {4206671}, {c_src_malloc_mallocng_malloc_cfg.activate_group_fun(mallocng_specs.a_crash_spec_fun(), c_src_malloc_mallocng_malloc_cfg.a_cas_fun())}, {LOW},
    {4198400}, {text.code}, {statics}), all_elim(agtc.linked, {statics}), rf)
  show := mp(all_elim(tr.implements_abi_g, {mp.G}, {4206671}, {LOW}, {mallocng_purpose.activate_group_purpose_fun(c)}, {4198400}, {text.code}, {statics}),
    mp.g_ok, hdr, st, r)
qed

// ----------------------------------------------------------------------
//  The context's counters: step_seq, decay_bounces, account_bounce and
//  is_bouncing -- their code refines their purpose (`counters_purpose`:
//  only the context's free bytes changed; is_bouncing's answer any). What
//  each code writes (its run: `ms.sq_run`, ...) lies in the free bytes;
//  what it reads and writes is accessible as they are (`mp.free_usable`).

// (a byte from the usage counters up to the sequence bytes: a free one;
// so n bytes from a there; a byte: its one byte)
theorem mp.free_at(c, a): app(c, "ctx") in omega -> int_le(int_add(app(c, "ctx"), 464), a) -> int_lt(a, int_add(app(c, "ctx"), 920)) -> mallocng.ctx_free(c, a)
proof
  assume hc h1 h2
  have k3: mallocng.C_USAGE = 464 by defs(refl({464}), mallocng.C_USAGE)
  have k4: mallocng.C_BRK = 920 by defs(refl({920}), mallocng.C_BRK)
  show by defs(arith(hc, h1, h2, k3, k4), mallocng.ctx_free)
qed

theorem mp.free_off(c, a, n): app(c, "ctx") in omega -> a in omega -> int_le(int_add(app(c, "ctx"), 464), a) -> int_le(int_add(a, n), int_add(app(c, "ctx"), 920)) ->
  all i. i in omega -> int_lt(i, n) -> mallocng.ctx_free(c, int_add(a, i))
proof
  assume hc ha h1 h2
  fix i
  assume hi hl
  show := apply(mp.free_at[c := c, a := int_add(a, i)], hc, arith(h1, hi, ha), arith(h2, hl, hi))
qed

theorem mp.free1(c, a): a in omega -> mallocng.ctx_free(c, a) -> all i. i in omega -> int_lt(i, 1) -> mallocng.ctx_free(c, int_add(a, i))
proof
  assume ha hf
  fix i
  assume hi hl
  have e: int_add(a, i) = a by arith(hi, hl, ha)
  show := subst({y. mallocng.ctx_free(c, y)}, sym(e), hf)
qed

// (a free byte written: only free bytes changed)
theorem mp.co_wr8(c, vm, a, v): vm in x86_64_linux.Vm -> a in omega -> int_lt(a, 18446744073709551615) -> mallocng.ctx_free(c, a) ->
  mallocng_purpose.ctx_only(c, vm, mallocng_specs.wr8(vm, a, v)) && mallocng_specs.wr8(vm, a, v) in x86_64_linux.Vm
proof
  assume hv ha hal hf
  have co := apply(mp.co_store[c := c, vm := vm, a := a, k := 1, v := v], hv, arith(ha, hal), simp(), arith(hal), apply(mp.free1, ha, hf))
  have wv := mp(all_elim(ms.wr_any, {vm}, {a}, {1}, {v}), hv)
  show by defs(taut(co, wv), mallocng_specs.wr8)
qed

// size class sc's bounce counter and unmap sequence byte: free ones
theorem mp.bounce_free(c, sc): app(c, "ctx") = c_src_malloc_mallocng_malloc.__malloc_context -> sc in bits(32) -> mallocng_specs.bouncing_class(sc) ->
  at: mallocng_specs.bounce_at(c_src_malloc_mallocng_malloc.__malloc_context, sc) in omega &&
  lt: int_lt(mallocng_specs.bounce_at(c_src_malloc_mallocng_malloc.__malloc_context, sc), 18446744073709551615) &&
  free: mallocng.ctx_free(c, mallocng_specs.bounce_at(c_src_malloc_mallocng_malloc.__malloc_context, sc)) &&
  uat: mallocng_specs.unmap_seq_at(c_src_malloc_mallocng_malloc.__malloc_context, sc) in omega &&
  ufree: mallocng.ctx_free(c, mallocng_specs.unmap_seq_at(c_src_malloc_mallocng_malloc.__malloc_context, sc))
proof
  assume hx hsc h
  let CTX := c_src_malloc_mallocng_malloc.__malloc_context
  have cv: CTX = 4227328 by defs(simp(), c_src_malloc_mallocng_malloc.__malloc_context)
  have p64: pow2(64) = 18446744073709551616 by simp()
  have lo hi := expand(h, mallocng_specs.bouncing_class)
  have co: app(c, "ctx") in omega by arith(hx, cv)
  have ab: mallocng_specs.bounce_at(CTX, sc) = int_sub(int_add(int_add(CTX, 880), sc), 7) by defs(arith(cv, lo, hi, hsc, p64), mallocng_specs.bounce_at, bits_of_int)
  have au: mallocng_specs.unmap_seq_at(CTX, sc) = int_sub(int_add(int_add(CTX, 848), sc), 7) by defs(arith(cv, lo, hi, hsc, p64), mallocng_specs.unmap_seq_at, bits_of_int)
  have fb := apply(mp.free_at[c := c, a := mallocng_specs.bounce_at(CTX, sc)], co, arith(ab, hx, lo), arith(ab, hx, hi))
  have fu := apply(mp.free_at[c := c, a := mallocng_specs.unmap_seq_at(CTX, sc)], co, arith(au, hx, lo), arith(au, hx, hi))
  have bo: mallocng_specs.bounce_at(CTX, sc) in omega := rewrite(sym(ab), (int_sub(int_add(int_add(CTX, 880), sc), 7) in omega by arith(cv, lo, hsc)))
  have bl: int_lt(mallocng_specs.bounce_at(CTX, sc), 18446744073709551615) := rewrite(sym(ab), (int_lt(int_sub(int_add(int_add(CTX, 880), sc), 7), 18446744073709551615) by arith(cv, hi)))
  have uo: mallocng_specs.unmap_seq_at(CTX, sc) in omega := rewrite(sym(au), (int_sub(int_add(int_add(CTX, 848), sc), 7) in omega by arith(cv, lo, hsc)))
  show by taut(bo, bl, fb, uo, fu)
qed

// the counters' preconditions, from the invariant: their bytes free, so
// accessible
theorem mp.sq_pre(c, A, vm, b, objs): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> app(c, "ctx") = c_src_malloc_mallocng_malloc.__malloc_context ->
  mallocng.holds_in(c, A, vm, b) -> mallocng_specs.step_seq_pre(vm, objs, c_src_malloc_mallocng_malloc.__malloc_context)
proof
  assume hc hu ha hx hh
  let CTX := c_src_malloc_mallocng_malloc.__malloc_context
  have cv: CTX = 4227328 by defs(simp(), c_src_malloc_mallocng_malloc.__malloc_context)
  have co: app(c, "ctx") in omega by arith(hx, cv)
  have f912 := apply(mp.free_off[c := c, a := int_add(CTX, 912), n := 1], co, arith(cv), arith(hx, cv), arith(hx, cv))
  have u1 u2 := apply(mp.free_usable[c := c, A := A, vm := vm, b := b, objs := objs, a := int_add(CTX, 912), n := 1], hc, hu, ha, hh, arith(cv), f912)
  have f848 := apply(mp.free_off[c := c, a := int_add(CTX, 848), n := 32], co, arith(cv), arith(hx, cv), arith(hx, cv))
  have _ u3 := apply(mp.free_usable[c := c, A := A, vm := vm, b := b, objs := objs, a := int_add(CTX, 848), n := 32], hc, hu, ha, hh, arith(cv), f848)
  have nz: !(CTX = 0) by arith(cv)
  have lim: int_le(int_add(CTX, 913), int_pow(2, 64)) by simp(cv)
  show by defs(taut(nz, lim, u1, u2, u3), mallocng_specs.step_seq_pre)
qed

theorem mp.bp_pre(c, A, vm, b, objs, sc, w): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> app(c, "ctx") = c_src_malloc_mallocng_malloc.__malloc_context ->
  sc in bits(32) -> mallocng.holds_in(c, A, vm, b) -> mallocng_specs.bounce_pre(vm, objs, c_src_malloc_mallocng_malloc.__malloc_context, sc, w)
proof
  assume hc hu ha hx hsc hh
  let CTX := c_src_malloc_mallocng_malloc.__malloc_context
  have cv: CTX = 4227328 by defs(simp(), c_src_malloc_mallocng_malloc.__malloc_context)
  have ub: mallocng_specs.bouncing_class(sc) ->
      gimple.usable(vm, objs, mallocng_specs.bounce_at(CTX, sc), 1, false) && gimple.usable(vm, objs, mallocng_specs.bounce_at(CTX, sc), 1, true) proof
    assume h
    have {at = at, fb = free} := apply(mp.bounce_free[c := c, sc := sc], hx, hsc, h)
    show := apply(mp.free_usable[c := c, A := A, vm := vm, b := b, objs := objs, a := mallocng_specs.bounce_at(CTX, sc), n := 1], hc, hu, ha, hh, at, apply(mp.free1, at, fb))
  qed
  have nz: !(CTX = 0) by arith(cv)
  have lim: int_le(int_add(CTX, 913), int_pow(2, 64)) by simp(cv)
  show by defs(taut(nz, lim, ub), mallocng_specs.bounce_pre)
qed

theorem mp.ab_pre(c, A, vm, b, objs, sc): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> app(c, "ctx") = c_src_malloc_mallocng_malloc.__malloc_context ->
  sc in bits(32) -> mallocng.holds_in(c, A, vm, b) -> mallocng_specs.account_bounce_pre(vm, objs, c_src_malloc_mallocng_malloc.__malloc_context, sc)
proof
  assume hc hu ha hx hsc hh
  let CTX := c_src_malloc_mallocng_malloc.__malloc_context
  have cv: CTX = 4227328 by defs(simp(), c_src_malloc_mallocng_malloc.__malloc_context)
  have co: app(c, "ctx") in omega by arith(hx, cv)
  have bp := apply(mp.bp_pre[c := c, A := A, vm := vm, b := b, objs := objs, sc := sc, w := true], hc, hu, ha, hx, hsc, hh)
  have us: mallocng_specs.bouncing_class(sc) ->
      gimple.usable(vm, objs, mallocng_specs.unmap_seq_at(CTX, sc), 1, false) && gimple.usable(vm, objs, int_add(CTX, 912), 1, false) proof
    assume h
    have {uat = uat, fu = ufree} := apply(mp.bounce_free[c := c, sc := sc], hx, hsc, h)
    have u1 _ := apply(mp.free_usable[c := c, A := A, vm := vm, b := b, objs := objs, a := mallocng_specs.unmap_seq_at(CTX, sc), n := 1], hc, hu, ha, hh, uat, apply(mp.free1, uat, fu))
    have f912 := apply(mp.free_off[c := c, a := int_add(CTX, 912), n := 1], co, arith(cv), arith(hx, cv), arith(hx, cv))
    have u2 _ := apply(mp.free_usable[c := c, A := A, vm := vm, b := b, objs := objs, a := int_add(CTX, 912), n := 1], hc, hu, ha, hh, arith(cv), f912)
    show by taut(u1, u2)
  qed
  show by defs(taut(bp, us), mallocng_specs.account_bounce_pre)
qed

// the counters' effects: free bytes written
theorem mp.sq_only(c, vm): vm in x86_64_linux.Vm -> app(c, "ctx") = c_src_malloc_mallocng_malloc.__malloc_context ->
  mallocng_purpose.ctx_only(c, vm, mallocng_specs.step_seq_vm(vm, c_src_malloc_mallocng_malloc.__malloc_context)) &&
  mallocng_specs.step_seq_vm(vm, c_src_malloc_mallocng_malloc.__malloc_context) in x86_64_linux.Vm
proof
  assume hv hx
  let CTX := c_src_malloc_mallocng_malloc.__malloc_context
  let B := gimple.bytes_at(vm, mallocng_specs.seq_at(CTX), 1)
  have cv: CTX = 4227328 by defs(simp(), c_src_malloc_mallocng_malloc.__malloc_context)
  have p64: pow2(64) = 18446744073709551616 by simp()
  have sq: mallocng_specs.seq_at(CTX) = int_add(CTX, 912) by defs(arith(cv, p64), mallocng_specs.seq_at, bits_add, pow2)
  have us: mallocng_specs.unmap_seqs_at(CTX) = int_add(CTX, 848) by defs(arith(cv, p64), mallocng_specs.unmap_seqs_at, bits_add, pow2)
  have co: app(c, "ctx") in omega by arith(hx, cv)
  have fs: mallocng.ctx_free(c, mallocng_specs.seq_at(CTX)) := apply(mp.free_at[c := c, a := mallocng_specs.seq_at(CTX)], co, arith(sq, hx, cv), arith(sq, hx, cv))
  // below 255: the byte counted up
  have up: !(B = 255) -> mallocng_purpose.ctx_only(c, vm, mallocng_specs.step_seq_vm(vm, CTX)) && mallocng_specs.step_seq_vm(vm, CTX) in x86_64_linux.Vm proof
    assume h
    have e: mallocng_specs.step_seq_vm(vm, CTX) = mallocng_specs.wr8(vm, mallocng_specs.seq_at(CTX), int_add(B, 1))
      by defs(simp(h, keep(mallocng_specs.wr8, mallocng_specs.seq_at)), mallocng_specs.step_seq_vm)
    have w := apply(mp.co_wr8[c := c, vm := vm, a := mallocng_specs.seq_at(CTX), v := int_add(B, 1)], hv, arith(sq, cv), arith(sq, cv), fs)
    show := rewrite(sym(e), w)
  qed
  // at 255: the unmap sequence bytes zeroed, then the byte 1
  have wrap: B = 255 -> mallocng_purpose.ctx_only(c, vm, mallocng_specs.step_seq_vm(vm, CTX)) && mallocng_specs.step_seq_vm(vm, CTX) in x86_64_linux.Vm proof
    assume h
    let V1 := fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), mallocng_specs.unmap_seqs_at(CTX), 32, 0))
    have e: mallocng_specs.step_seq_vm(vm, CTX) = mallocng_specs.wr8(V1, mallocng_specs.seq_at(CTX), 1)
      by defs(simp(h, keep(mallocng_specs.wr8, mallocng_specs.seq_at, mallocng_specs.unmap_seqs_at)), mallocng_specs.step_seq_vm)
    have f848 := apply(mp.free_off[c := c, a := int_add(CTX, 848), n := 32], co, arith(cv), arith(hx, cv), arith(hx, cv))
    have w1 := apply(mp.co_store[c := c, vm := vm, a := mallocng_specs.unmap_seqs_at(CTX), k := 32, v := 0], hv, arith(us, cv), simp(), arith(us, cv), rewrite(sym(us), f848))
    have v1 := mp(all_elim(ms.wr_any, {vm}, {mallocng_specs.unmap_seqs_at(CTX)}, {32}, {0}), hv)
    have w2 wv := apply(mp.co_wr8[c := c, vm := V1, a := mallocng_specs.seq_at(CTX), v := 1], v1, arith(sq, cv), arith(sq, cv), fs)
    show := rewrite(sym(e), conj(apply(mp.co_trans, w1, w2), wv))
  qed
  show by taut(up, wrap)
qed

theorem mp.db_only(c, vm, sc): vm in x86_64_linux.Vm -> app(c, "ctx") = c_src_malloc_mallocng_malloc.__malloc_context -> sc in bits(32) ->
  mallocng_purpose.ctx_only(c, vm, mallocng_specs.decay_vm(vm, c_src_malloc_mallocng_malloc.__malloc_context, sc)) &&
  mallocng_specs.decay_vm(vm, c_src_malloc_mallocng_malloc.__malloc_context, sc) in x86_64_linux.Vm
proof
  assume hv hx hsc
  let CTX := c_src_malloc_mallocng_malloc.__malloc_context
  let D := gimple.bytes_at(vm, mallocng_specs.bounce_at(CTX, sc), 1)
  have dn: !(mallocng_specs.bouncing_class(sc) && !(D = 0)) ->
      mallocng_purpose.ctx_only(c, vm, mallocng_specs.decay_vm(vm, CTX, sc)) && mallocng_specs.decay_vm(vm, CTX, sc) in x86_64_linux.Vm proof
    assume h
    have e: mallocng_specs.decay_vm(vm, CTX, sc) = vm by defs(simp(h, keep(mallocng_specs.bouncing_class, mallocng_specs.wr8, mallocng_specs.bounce_at)), mallocng_specs.decay_vm)
    show := subst({y. mallocng_purpose.ctx_only(c, vm, y) && y in x86_64_linux.Vm}, sym(e), conj(apply(mp.co_refl[c := c, vm := vm], hv), hv))
  qed
  have dy: mallocng_specs.bouncing_class(sc) && !(D = 0) ->
      mallocng_purpose.ctx_only(c, vm, mallocng_specs.decay_vm(vm, CTX, sc)) && mallocng_specs.decay_vm(vm, CTX, sc) in x86_64_linux.Vm proof
    assume h
    have hb _ := h
    have {at = at, lt = lt, fb = free} := apply(mp.bounce_free[c := c, sc := sc], hx, hsc, hb)
    have e: mallocng_specs.decay_vm(vm, CTX, sc) = mallocng_specs.wr8(vm, mallocng_specs.bounce_at(CTX, sc), int_sub(D, 1))
      by defs(simp(h, keep(mallocng_specs.bouncing_class, mallocng_specs.wr8, mallocng_specs.bounce_at)), mallocng_specs.decay_vm)
    show := rewrite(sym(e), apply(mp.co_wr8[c := c, vm := vm, a := mallocng_specs.bounce_at(CTX, sc), v := int_sub(D, 1)], hv, at, lt, fb))
  qed
  show by taut(dn, dy)
qed

theorem mp.ab_only(c, vm, sc): vm in x86_64_linux.Vm -> app(c, "ctx") = c_src_malloc_mallocng_malloc.__malloc_context -> sc in bits(32) ->
  mallocng_purpose.ctx_only(c, vm, mallocng_specs.account_vm(vm, c_src_malloc_mallocng_malloc.__malloc_context, sc)) &&
  mallocng_specs.account_vm(vm, c_src_malloc_mallocng_malloc.__malloc_context, sc) in x86_64_linux.Vm
proof
  assume hv hx hsc
  let CTX := c_src_malloc_mallocng_malloc.__malloc_context
  let D := gimple.bytes_at(vm, mallocng_specs.bounce_at(CTX, sc), 1)
  have dn: !mallocng_specs.bounced(vm, CTX, sc) ->
      mallocng_purpose.ctx_only(c, vm, mallocng_specs.account_vm(vm, CTX, sc)) && mallocng_specs.account_vm(vm, CTX, sc) in x86_64_linux.Vm proof
    assume h
    have e: mallocng_specs.account_vm(vm, CTX, sc) = vm by defs(simp(h, keep(mallocng_specs.bounced, mallocng_specs.wr8, mallocng_specs.bounce_at)), mallocng_specs.account_vm)
    show := subst({y. mallocng_purpose.ctx_only(c, vm, y) && y in x86_64_linux.Vm}, sym(e), conj(apply(mp.co_refl[c := c, vm := vm], hv), hv))
  qed
  have dy: mallocng_specs.bounced(vm, CTX, sc) ->
      mallocng_purpose.ctx_only(c, vm, mallocng_specs.account_vm(vm, CTX, sc)) && mallocng_specs.account_vm(vm, CTX, sc) in x86_64_linux.Vm proof
    assume h
    have hb _ _ := expand(h, mallocng_specs.bounced)
    have {at = at, lt = lt, fb = free} := apply(mp.bounce_free[c := c, sc := sc], hx, hsc, hb)
    have e: mallocng_specs.account_vm(vm, CTX, sc) = mallocng_specs.wr8(vm, mallocng_specs.bounce_at(CTX, sc), ite(int_le(D, 98), int_add(D, 1), 150))
      by defs(simp(h, keep(mallocng_specs.bounced, mallocng_specs.wr8, mallocng_specs.bounce_at)), mallocng_specs.account_vm)
    show := rewrite(sym(e), apply(mp.co_wr8[c := c, vm := vm, a := mallocng_specs.bounce_at(CTX, sc), v := ite(int_le(D, 98), int_add(D, 1), 150)], hv, at, lt, fb))
  qed
  show by taut(dn, dy)
qed

// A program whose runs, under the invariant, change only the context's
// free bytes: it refines the counters' purpose
theorem mp.counters_ref(c, p): (all s o. runs(p, s, o) -> pair(s, o) in univ(1)) ->
  (all s h o. s in abi.World -> h in mp.G -> mallocng.holds_in(c, app(h, "A"), app(s, "vm"), app(h, "blocks")) -> runs(p, s, o) ->
     ex V2. V2 in x86_64_linux.Vm && mallocng_purpose.ctx_only(c, app(s, "vm"), V2) && o = ok(fn_update(s, "vm", V2), empty)) ->
  refines_ghost(p, mallocng_purpose.counters_purpose(c), abi.World, mp.G)
proof
  assume rp hrun
  have body: all s h o. s in abi.World -> h in mp.G -> runs(p, s, o) -> mallocng.holds_in(c, app(union2(s, h), "A"), app(union2(s, h), "vm"), app(union2(s, h), "blocks")) ->
      (ex v. v in x86_64_linux.Vm && o = exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty))) ||
      (ex s1 v h2. h2 in mp.G && o = ok(s1, v) &&
        letin(app(union2(s, h), "vm"), x3. any_rel(x4. x4 in x86_64_linux.Vm && mallocng_purpose.ctx_only(c, x3, app(fn_update(union2(s, h), "vm", x4), "vm")),
          x4. letin(fn_update(union2(s, h), "vm", x4), x5. exc(pair(union2(s1, h2), empty), pair("ret", v)) = ok(pair(x5, empty), empty))))) ||
      (ex s1 h2. h2 in mp.G && o = ok(s1, empty) &&
        letin(app(union2(s, h), "vm"), x3. any_rel(x4. x4 in x86_64_linux.Vm && mallocng_purpose.ctx_only(c, x3, app(fn_update(union2(s, h), "vm", x4), "vm")),
          x4. letin(fn_update(union2(s, h), "vm", x4), x5. ok(pair(union2(s1, h2), empty), empty) = ok(pair(x5, empty), empty))))) proof
    fix s h o
    assume hs hh hr hpre
    let S := union2(s, h)
    have _ hd _ _ := mp(all_elim(mp.g_rec, {h}), hh)
    have sd: dom(s) = insert("vm", insert("os", insert("fs_base", insert("cpu", insert("objs", empty))))) by simp(expand(hs, abi.World))
    have vS: app(S, "vm") = app(s, "vm") by simp(sd, hd)
    have hin: mallocng.holds_in(c, app(h, "A"), app(s, "vm"), app(h, "blocks")) by simp(hpre, sd, hd)
    obtain V2, hv2 hco ho from mp(all_elim(hrun, {s}, {h}, {o}), hs, hh, hin, hr)
    // the world's part updated, the ghost part joined: the spec's state
    have _ hk := mp(all_elim(mp.g_world, {h}), hh)
    have nv: all z. z in h -> fst(z) != "vm" proof
      fix z
      assume hz
      show by simp(mp(all_elim(hk, {z}), hz))
    qed
    have eu := mp(fn_update_union_l[a := s, b := h, k := "vm", v := V2], nv)
    have d4: V2 in x86_64_linux.Vm && mallocng_purpose.ctx_only(c, app(S, "vm"), app(fn_update(S, "vm", V2), "vm")) by simp(hv2, hco, vS, keep(mallocng_purpose.ctx_only))
    have eq: ok(pair(union2(fn_update(s, "vm", V2), h), empty), empty) = ok(pair(fn_update(S, "vm", V2), empty), empty) by simp(eu)
    have k4: ex x4. (x4 in x86_64_linux.Vm && mallocng_purpose.ctx_only(c, app(S, "vm"), app(fn_update(S, "vm", x4), "vm"))) &&
        ok(pair(union2(fn_update(s, "vm", V2), h), empty), empty) = ok(pair(fn_update(S, "vm", x4), empty), empty) by ex_intro({V2}, taut(d4, eq))
    have bB: letin(app(S, "vm"), x3. any_rel(x4. x4 in x86_64_linux.Vm && mallocng_purpose.ctx_only(c, x3, app(fn_update(S, "vm", x4), "vm")),
        x4. letin(fn_update(S, "vm", x4), x5. ok(pair(union2(fn_update(s, "vm", V2), h), empty), empty) = ok(pair(x5, empty), empty)))) by defs(taut(k4), letin, any_rel)
    have fin: ex s1 h2. h2 in mp.G && o = ok(s1, empty) &&
        letin(app(S, "vm"), x3. any_rel(x4. x4 in x86_64_linux.Vm && mallocng_purpose.ctx_only(c, x3, app(fn_update(S, "vm", x4), "vm")),
          x4. letin(fn_update(S, "vm", x4), x5. ok(pair(union2(s1, h2), empty), empty) = ok(pair(x5, empty), empty)))) by ex_intro({fn_update(s, "vm", V2)}, {h}, taut(hh, ho, bB))
    show by taut(fin)
  qed
  show by defs(apply(ct.refines_contract_ge, mp.g_world, rp, body), mallocng_purpose.counters_purpose)
qed

// step_seq, decay_bounces, account_bounce: their code by their purpose
theorem mp.sq: all c. c in mallocng.Cfg -> app(c, "ctx") = c_src_malloc_mallocng_malloc.__malloc_context ->
  refines_ghost(c_src_malloc_mallocng_malloc.step_seq(), mallocng_purpose.counters_purpose(c), abi.World, mp.G)
proof
  fix c
  assume hc hx
  have rp: all s o. runs(c_src_malloc_mallocng_malloc.step_seq(), s, o) -> pair(s, o) in univ(1) proof
    fix s o
    assume hr
    show := apply(g.runs_univ, expand(hr, c_src_malloc_mallocng_malloc.step_seq))
  qed
  have eff: all s h o. s in abi.World -> h in mp.G -> mallocng.holds_in(c, app(h, "A"), app(s, "vm"), app(h, "blocks")) -> runs(c_src_malloc_mallocng_malloc.step_seq(), s, o) ->
      ex V2. V2 in x86_64_linux.Vm && mallocng_purpose.ctx_only(c, app(s, "vm"), V2) && o = ok(fn_update(s, "vm", V2), empty) proof
    fix s h o
    assume hs hh hin hr
    have hu _ _ hat := mp(all_elim(mp.g_rec, {h}), hh)
    have pre := apply(mp.sq_pre[c := c, A := app(h, "A"), vm := app(s, "vm"), b := app(h, "blocks"), objs := app(s, "objs")], hc, (app(h, "A") in univ(1) by simp(hu)), hat, hx, hin)
    have oe := mp(all_elim(ms.sq_run, {s}, {o}), hs, pre, hr)
    have pv _ _ _ := apply(ms.world_parts, hs)
    have co cv := apply(mp.sq_only[c := c, vm := app(s, "vm")], pv, hx)
    show by ex_intro({mallocng_specs.step_seq_vm(app(s, "vm"), c_src_malloc_mallocng_malloc.__malloc_context)}, taut(cv, co, oe))
  qed
  show := apply(mp.counters_ref[c := c, p := c_src_malloc_mallocng_malloc.step_seq()], rp, eff)
qed

theorem mp.db: all c sc. c in mallocng.Cfg -> app(c, "ctx") = c_src_malloc_mallocng_malloc.__malloc_context -> sc in bits(32) ->
  refines_ghost(c_src_malloc_mallocng_malloc.decay_bounces(sc), mallocng_purpose.counters_purpose(c), abi.World, mp.G)
proof
  fix c sc
  assume hc hx hsc
  have rp: all s o. runs(c_src_malloc_mallocng_malloc.decay_bounces(sc), s, o) -> pair(s, o) in univ(1) proof
    fix s o
    assume hr
    show := apply(g.runs_univ, expand(hr, c_src_malloc_mallocng_malloc.decay_bounces))
  qed
  have eff: all s h o. s in abi.World -> h in mp.G -> mallocng.holds_in(c, app(h, "A"), app(s, "vm"), app(h, "blocks")) -> runs(c_src_malloc_mallocng_malloc.decay_bounces(sc), s, o) ->
      ex V2. V2 in x86_64_linux.Vm && mallocng_purpose.ctx_only(c, app(s, "vm"), V2) && o = ok(fn_update(s, "vm", V2), empty) proof
    fix s h o
    assume hs hh hin hr
    have hu _ _ hat := mp(all_elim(mp.g_rec, {h}), hh)
    have pre := apply(mp.bp_pre[c := c, A := app(h, "A"), vm := app(s, "vm"), b := app(h, "blocks"), objs := app(s, "objs"), sc := sc, w := true], hc, (app(h, "A") in univ(1) by simp(hu)), hat, hx, hsc, hin)
    have oe := mp(all_elim(ms.db_run, {sc}, {s}, {o}), hsc, hs, pre, hr)
    have pv _ _ _ := apply(ms.world_parts, hs)
    have co cv := apply(mp.db_only[c := c, vm := app(s, "vm"), sc := sc], pv, hx, hsc)
    show by ex_intro({mallocng_specs.decay_vm(app(s, "vm"), c_src_malloc_mallocng_malloc.__malloc_context, sc)}, taut(cv, co, oe))
  qed
  show := apply(mp.counters_ref[c := c, p := c_src_malloc_mallocng_malloc.decay_bounces(sc)], rp, eff)
qed

theorem mp.ab: all c sc. c in mallocng.Cfg -> app(c, "ctx") = c_src_malloc_mallocng_malloc.__malloc_context -> sc in bits(32) ->
  refines_ghost(c_src_malloc_mallocng_malloc.account_bounce(sc), mallocng_purpose.counters_purpose(c), abi.World, mp.G)
proof
