    have bp: all x x2. x = exc(pair(S, empty), pair("ret", bits_of_int(64, mallocng.stride(app(app(app(S, "A"), "metas"), g))))) -> fst(x) = 2 ->
        x2 = exc(pair(S, empty), pair("ret", bits_of_int(64, mallocng.stride(app(app(app(S, "A"), "metas"), g))))) proof
