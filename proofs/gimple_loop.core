// The CFG ⊑ its structured form with loops (docs/overview.md): a loop a
// node of the structuring's tree -- the CFG's runs from its head, trip by
// trip, are the structured loop's iterations; finitely many by induction,
// infinitely many by coinduction, the divergence's trace the same.
//
// Traces only grow: a trace is the record of the events so far (each
// field a set), a run's later states' records above its earlier ones;
// then a divergence's trace -- the union over the run's states -- is the
// union over any states of it from which every later one is reached
// (`g.limit_up`): the CFG's over all its states, the structured loop's
// over its iterations' states.
//
// Check after proofs/gimple_cut.core.

// (a trace record below another: the same fields, each a subset)
def g.tr_le(a, b) := dom(b) = dom(a) && (all x. x in dom(a) -> subset(app(a, x), app(b, x)))

theorem g.tr_le_refl(a): g.tr_le(a, a)
proof
  have s: all x. x in dom(a) -> subset(app(a, x), app(a, x)) proof
    fix x
    assume _
    have ss: all z. z in app(a, x) -> z in app(a, x) proof
      fix z
      assume h
      show := h
    qed
    show by defs(ss, subset)
  qed
  have d: dom(a) = dom(a) := refl({dom(a)})
  show by defs(taut(d, s), g.tr_le)
qed

theorem g.tr_le_trans(a, b, c): g.tr_le(a, b) -> g.tr_le(b, c) -> g.tr_le(a, c)
proof
  assume h1 h2
  have d1: dom(b) = dom(a) by taut(expand(h1, g.tr_le))
  have d2: dom(c) = dom(b) by taut(expand(h2, g.tr_le))
  have s1: all x. x in dom(a) -> subset(app(a, x), app(b, x)) by taut(expand(h1, g.tr_le))
  have s2: all x. x in dom(b) -> subset(app(b, x), app(c, x)) by taut(expand(h2, g.tr_le))
  have s: all x. x in dom(a) -> subset(app(a, x), app(c, x)) proof
    fix x
    assume hx
    have hxb: x in dom(b) := rewrite(sym(d1), hx)
    have a1 := expand(mp(all_elim(s1, {x}), hx), subset)
    have a2 := expand(mp(all_elim(s2, {x}), hxb), subset)
    have g: all z. z in app(a, x) -> z in app(c, x) proof
      fix z
      assume hz
      show := mp(all_elim(a2, {z}), mp(all_elim(a1, {z}), hz))
    qed
    show by defs(g, subset)
  qed
  have dc: dom(c) = dom(a) := trans(d2, d1)
  show by defs(taut(dc, s), g.tr_le)
qed

// (a chain of records, each below the next: every one below every later)
theorem g.chain_le(i. T): (all i. i in omega -> g.tr_le(T(i), T(int_add(i, 1)))) ->
  all i j. i in omega -> j in omega -> int_le(i, j) -> g.tr_le(T(i), T(j))
proof
  assume hs
  have up: all k. k in omega -> (all i. i in omega -> g.tr_le(T(i), T(int_add(i, k)))) proof
    have base: all i. i in omega -> g.tr_le(T(i), T(int_add(i, 0))) proof
      fix i
      assume hi
      have e: int_add(i, 0) = i by arith(hi)
      show := subst({y. g.tr_le(T(i), T(y))}, sym(e), g.tr_le_refl[a := T(i)])
    qed
    have step: all k. k in omega -> (all i. i in omega -> g.tr_le(T(i), T(int_add(i, k)))) -> (all i. i in omega -> g.tr_le(T(i), T(int_add(i, int_add(k, 1))))) proof
      fix k
      assume hk ih
      fix i
      assume hi
      have a := mp(all_elim(ih, {i}), hi)
      have io: int_add(i, k) in omega by arith(hi, hk)
      have b0 := mp(all_elim(hs, {int_add(i, k)}), io)
      have e: int_add(int_add(i, k), 1) = int_add(i, int_add(k, 1)) by arith(hi, hk)
      have b1 := subst({y. g.tr_le(T(int_add(i, k)), T(y))}, e, b0)
      show := mp(g.tr_le_trans[a := T(i), b := T(int_add(i, k)), c := T(int_add(i, int_add(k, 1)))], a, b1)
    qed
    show by induct(base, step)
  qed
  fix i j
  assume hi hj hle
  have ko: int_sub(j, i) in omega by arith(hi, hj, hle)
  have e: int_add(i, int_sub(j, i)) = j by arith(hi, hj, hle)
  show := subst({y. g.tr_le(T(i), T(y))}, e, mp(all_elim(mp(all_elim(up, {int_sub(j, i)}), ko), {i}), hi))
qed

// (the limit over the records at positions p(i), never before i: the
// limit over all)
theorem g.limit_up(i. T, i. p): (all i j. i in omega -> j in omega -> int_le(i, j) -> g.tr_le(T(i), T(j))) ->
  (all i. i in omega -> p(i) in omega && int_le(i, p(i))) ->
  trace_limit(i. T(p(i))) = trace_limit(i. T(i))
proof
  assume hm hp
  have p0 := mp(all_elim(hp, {empty}), omega_zero)
  have p0o: p(empty) in omega by taut(p0)
  have p0l: int_le(empty, p(empty)) by taut(p0)
  have t0 := mp(all_elim(hm, {empty}, {p(empty)}), omega_zero, p0o, p0l)
  have d0: dom(T(p(empty))) = dom(T(empty)) by taut(expand(t0, g.tr_le))
  // each field's union: the same
  have u: all f. f in dom(T(empty)) -> union(set_image(omega, i. app(T(p(i)), f))) = union(set_image(omega, i. app(T(i), f))) proof
    fix f
    assume hf
    have l2r: all z. z in union(set_image(omega, i. app(T(p(i)), f))) -> z in union(set_image(omega, i. app(T(i), f))) proof
      fix z
      assume hz
      have e1: ex y. z in y && y in set_image(omega, i. app(T(p(i)), f)) by taut(union_def[s := set_image(omega, i. app(T(p(i)), f)), a := z], hz)
      obtain y, zy yi from e1
      have e2: ex i. i in omega && app(T(p(i)), f) = y by taut(set_image_def[s := omega, f := i. app(T(p(i)), f), y := y], yi)
      obtain i, io ey from e2
      have pi := mp(all_elim(hp, {i}), io)
      have pio: p(i) in omega by taut(pi)
      have e3: ex j. j in omega && app(T(j), f) = y by ex_intro({p(i)}, taut(pio, ey))
      have yi2: y in set_image(omega, i. app(T(i), f)) by taut(set_image_def[s := omega, f := i. app(T(i), f), y := y], e3)
      have e4: ex y. z in y && y in set_image(omega, i. app(T(i), f)) by ex_intro({y}, taut(zy, yi2))
      show by taut(union_def[s := set_image(omega, i. app(T(i), f)), a := z], e4)
    qed
    have r2l: all z. z in union(set_image(omega, i. app(T(i), f))) -> z in union(set_image(omega, i. app(T(p(i)), f))) proof
      fix z
      assume hz
      have e1: ex y. z in y && y in set_image(omega, i. app(T(i), f)) by taut(union_def[s := set_image(omega, i. app(T(i), f)), a := z], hz)
      obtain y, zy yi from e1
      have e2: ex n. n in omega && app(T(n), f) = y by taut(set_image_def[s := omega, f := i. app(T(i), f), y := y], yi)
      obtain n, no ey from e2
      have pn := mp(all_elim(hp, {n}), no)
      have pno: p(n) in omega by taut(pn)
      have pnl: int_le(n, p(n)) by taut(pn)
      have tn := mp(all_elim(hm, {n}, {p(n)}), no, pno, pnl)
      have l0n: int_le(0, n) by arith(no)
      have le0n: int_le(empty, n) := rewrite(lit_zero, l0n)
      have t0n := mp(all_elim(hm, {empty}, {n}), omega_zero, no, le0n)
      have dn: dom(T(n)) = dom(T(empty)) by taut(expand(t0n, g.tr_le))
      have fn: f in dom(T(n)) := rewrite(sym(dn), hf)
      have sn: all x. x in dom(T(n)) -> subset(app(T(n), x), app(T(p(n)), x)) by taut(expand(tn, g.tr_le))
      have sb := expand(mp(all_elim(sn, {f}), fn), subset)
      have zy2: z in app(T(n), f) := rewrite(sym(ey), zy)
      have zp: z in app(T(p(n)), f) := mp(all_elim(sb, {z}), zy2)
      have e3: ex i. i in omega && app(T(p(i)), f) = app(T(p(n)), f) by ex_intro({n}, taut(no, refl({app(T(p(n)), f)})))
      have yi2: app(T(p(n)), f) in set_image(omega, i. app(T(p(i)), f)) by taut(set_image_def[s := omega, f := i. app(T(p(i)), f), y := app(T(p(n)), f)], e3)
      have e4: ex y. z in y && y in set_image(omega, i. app(T(p(i)), f)) by ex_intro({app(T(p(n)), f)}, taut(zp, yi2))
      show by taut(union_def[s := set_image(omega, i. app(T(p(i)), f)), a := z], e4)
    qed
    have iff: all z. z in union(set_image(omega, i. app(T(p(i)), f))) <-> z in union(set_image(omega, i. app(T(i), f))) proof
      fix z
      show by taut(all_elim(l2r, {z}), all_elim(r2l, {z}))
    qed
    show := mp(set_ext[a := union(set_image(omega, i. app(T(p(i)), f))), b := union(set_image(omega, i. app(T(i), f)))], iff)
  qed
  have fe := mp(fn_build_ext[d := dom(T(empty)), f := f. union(set_image(omega, i. app(T(p(i)), f))), g := f. union(set_image(omega, i. app(T(i), f)))], u)
  have fe2 := subst({d. fn_build(d, f. union(set_image(omega, i. app(T(p(i)), f)))) = fn_build(dom(T(empty)), f. union(set_image(omega, i. app(T(i), f))))}, sym(d0), fe)
  show by defs(fe2, trace_limit)
qed

// (the same records at every position: the same limit)
theorem g.limit_cong(i. T1, i. T2): (all i. i in omega -> T1(i) = T2(i)) -> trace_limit(i. T1(i)) = trace_limit(i. T2(i))
proof
  assume he
  have e0 := mp(all_elim(he, {empty}), omega_zero)
  have u: all f. f in dom(T1(empty)) -> union(set_image(omega, i. app(T1(i), f))) = union(set_image(omega, i. app(T2(i), f))) proof
    fix f
    assume _
    have ea: all i. i in omega -> app(T1(i), f) = app(T2(i), f) proof
      fix i
      assume io
      have e := mp(all_elim(he, {i}), io)
      show := subst({y. app(T1(i), f) = app(y, f)}, e, refl({app(T1(i), f)}))
    qed
    have eb: all i. i in omega -> app(T2(i), f) = app(T1(i), f) proof
      fix i
      assume io
      show := sym(mp(all_elim(ea, {i}), io))
    qed
    have iff: all y. y in set_image(omega, i. app(T1(i), f)) <-> y in set_image(omega, i. app(T2(i), f)) proof
      fix y
      have a := mp(image_sub[d := omega, f := i. app(T1(i), f), g := i. app(T2(i), f), y := y], ea)
      have b := mp(image_sub[d := omega, f := i. app(T2(i), f), g := i. app(T1(i), f), y := y], eb)
      show by taut(a, b)
    qed
    have se := mp(set_ext[a := set_image(omega, i. app(T1(i), f)), b := set_image(omega, i. app(T2(i), f))], iff)
    show := subst({y. union(set_image(omega, i. app(T1(i), f))) = union(y)}, se, refl({union(set_image(omega, i. app(T1(i), f)))}))
  qed
  have fe := mp(fn_build_ext[d := dom(T1(empty)), f := f. union(set_image(omega, i. app(T1(i), f))), g := f. union(set_image(omega, i. app(T2(i), f)))], u)
  have fe2 := subst({y. fn_build(dom(T1(empty)), f. union(set_image(omega, i. app(T1(i), f)))) = fn_build(dom(y), f. union(set_image(omega, i. app(T2(i), f))))}, e0, fe)
  show by defs(fe2, trace_limit)
qed

// (a run's records each below the next: a chain)
theorem g.chain_succ(i. T): (all i. i in omega -> g.tr_le(T(i), T(succ(i)))) ->
  all i j. i in omega -> j in omega -> int_le(i, j) -> g.tr_le(T(i), T(j))
proof
  assume hs
  have h1: all i. i in omega -> g.tr_le(T(i), T(int_add(i, 1))) proof
    fix i
    assume io
    have es: succ(i) = int_add(i, 1) by arith(io)
    show := rewrite(es, mp(all_elim(hs, {i}), io))
  qed
  show := mp(g.chain_le[T := i. T(i)], h1)
qed

// (an infinite run, its records a chain: from every state f(k) a
// divergence of the same trace)
theorem g.run_suffix_exact(l. c, l o. b, l. tr, f, k):
  (all i. i in omega -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) ->
  (all i j. i in omega -> j in omega -> int_le(i, j) -> g.tr_le(tr(app(f, i)), tr(app(f, j)))) -> k in omega ->
  while_rel(app(f, k), l. c(l), l o. b(l, o), l. tr(l), diverge(trace_limit(i. tr(app(f, i)))))
proof
  assume hst hm hk
  let G := fn_build(omega, i. app(f, int_add(i, k)))
  have gf := fn_build_fun[d := omega, v := i. app(f, int_add(i, k))]
  have gd := fn_build_dom[d := omega, v := i. app(f, int_add(i, k))]
  have gi: all i. i in omega -> app(G, i) = app(f, int_add(i, k)) proof
    fix i
    assume io
    show := mp(app_fn_build[d := omega, v := i. app(f, int_add(i, k)), a := i], io)
  qed
  have zo: 0 in omega := rewrite(sym(lit_zero), omega_zero)
  have g0a := mp(all_elim(gi, {0}), zo)
  have ek: int_add(0, k) = k by arith(hk)
  have g0b := rewrite(ek, g0a)
  have g0: app(G, empty) = app(f, k) := subst({y. app(G, y) = app(f, k)}, lit_zero, g0b)
  have st: all i. i in omega -> c(app(G, i)) && b(app(G, i), ok(app(G, succ(i)), empty)) proof
    fix i
    assume io
    have i1o: int_add(i, 1) in omega by arith(io)
    have ga := mp(all_elim(gi, {i}), io)
    have gb := mp(all_elim(gi, {int_add(i, 1)}), i1o)
    have es: succ(i) = int_add(i, 1) by arith(io)
    have jo: int_add(i, k) in omega by arith(io, hk)
    have ej1: succ(int_add(i, k)) = int_add(int_add(i, k), 1) by arith(jo)
    have ej2: int_add(int_add(i, k), 1) = int_add(int_add(i, 1), k) by arith(io, hk)
    have ej := trans(ej1, ej2)
    have gs0: app(G, succ(i)) = app(f, int_add(int_add(i, 1), k)) := subst({y. app(G, y) = app(f, int_add(int_add(i, 1), k))}, sym(es), gb)
    have gs: app(G, succ(i)) = app(f, succ(int_add(i, k))) := rewrite(sym(ej), gs0)
    have s0 := mp(all_elim(hst, {int_add(i, k)}), jo)
    have s1 := rewrite(sym(ga), s0)
    show := rewrite(sym(gs), s1)
  qed
  // (its trace: the records at positions i + k, the run's)
  have tg: all i. i in omega -> tr(app(G, i)) = tr(app(f, int_add(i, k))) proof
    fix i
    assume io
    have e := mp(all_elim(gi, {i}), io)
    show := subst({y. tr(app(G, i)) = tr(y)}, e, refl({tr(app(G, i))}))
  qed
  have t1 := mp(g.limit_cong[T1 := i. tr(app(G, i)), T2 := i. tr(app(f, int_add(i, k)))], tg)
  have pk: all i. i in omega -> int_add(i, k) in omega && int_le(i, int_add(i, k)) proof
    fix i
    assume io
    have a: int_add(i, k) in omega by arith(io, hk)
    have b0: int_le(i, int_add(i, k)) by arith(io, hk)
    show by taut(a, b0)
  qed
  have t2 := mp(g.limit_up[T := i. tr(app(f, i)), p := i. int_add(i, k)], hm, pk)
  have t3 := trans(t1, t2)
  have e1: ex g. is_fun(g) && dom(g) = omega && app(g, empty) = app(f, k) &&
      (all i. i in omega -> c(app(g, i)) && b(app(g, i), ok(app(g, succ(i)), empty))) &&
      diverge(trace_limit(i. tr(app(f, i)))) = diverge(trace_limit(i. tr(app(g, i))))
    by ex_intro({G}, taut(gf, gd, g0, st, subst({y. diverge(y) = diverge(trace_limit(i. tr(app(G, i))))}, t3, refl({diverge(trace_limit(i. tr(app(G, i))))}))))
  show by defs(taut(e1), while_rel)
qed

// ----------------------------------------------------------------------
//  A run's stretches as stopped runs (the body stopped at p, its outcome
//  then the cut's mark pair(3, l))

// (from position a to the first stop c: the stopped run to c's mark)
theorem g.seg_wfr(l. p, l o. b, f, a, c): a in omega -> c in omega -> int_le(a, c) ->
  (all i. i in omega -> int_le(a, i) -> int_lt(i, c) -> !p(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) -> p(app(f, c)) ->
  while_fin_rel(app(f, a), l. true, l y. (p(l) && y = pair(3, l)) || (!p(l) && b(l, y)), pair(3, app(f, c)))
proof
  assume ha hc hac hst hp
  let m := int_sub(c, a)
  let G := fn_build(succ(m), i. app(f, int_add(i, a)))
  have mo: m in omega by arith(ha, hc, hac)
  have gf := fn_build_fun[d := succ(m), v := i. app(f, int_add(i, a))]
  have gd := fn_build_dom[d := succ(m), v := i. app(f, int_add(i, a))]
  have em: succ(m) = int_add(m, 1) by arith(mo)
  have m1: int_add(m, 1) in omega by arith(mo)
  have gi: all i. i in omega -> int_le(i, m) -> app(G, i) = app(f, int_add(i, a)) proof
    fix i
    assume io il
    have mm: i in int_add(m, 1) by arith(io, il, mo, m1)
    show := mp(app_fn_build[d := succ(m), v := i. app(f, int_add(i, a)), a := i], rewrite(sym(em), mm))
  qed
  have zo: 0 in omega := rewrite(sym(lit_zero), omega_zero)
  have z0: int_le(0, m) by arith(mo)
  have g0a := mp(mp(all_elim(gi, {0}), zo), z0)
  have ea: int_add(0, a) = a by arith(ha)
  have g0b := rewrite(ea, g0a)
  have g0: app(G, empty) = app(f, a) := subst({y. app(G, y) = app(f, a)}, lit_zero, g0b)
  have st: all i. i in m -> true && ((p(app(G, i)) && ok(app(G, succ(i)), empty) = pair(3, app(G, i))) || (!p(app(G, i)) && b(app(G, i), ok(app(G, succ(i)), empty)))) proof
    fix i
    assume hi
    have io := mp(mp(nat_elem[k := m, i := i], mo), hi)
    have il: int_le(i, m) by arith(io, mo, hi)
    have i1o: int_add(i, 1) in omega by arith(io)
    have i1l: int_le(int_add(i, 1), m) by arith(io, mo, hi)
    have ga := mp(mp(all_elim(gi, {i}), io), il)
    have gb := mp(mp(all_elim(gi, {int_add(i, 1)}), i1o), i1l)
    have es: succ(i) = int_add(i, 1) by arith(io)
    have jo: int_add(i, a) in omega by arith(io, ha)
    have ej1: succ(int_add(i, a)) = int_add(int_add(i, a), 1) by arith(jo)
    have ej2: int_add(int_add(i, a), 1) = int_add(int_add(i, 1), a) by arith(io, ha)
    have ej := trans(ej1, ej2)
    have gs0: app(G, succ(i)) = app(f, int_add(int_add(i, 1), a)) := subst({y. app(G, y) = app(f, int_add(int_add(i, 1), a))}, sym(es), gb)
    have gs: app(G, succ(i)) = app(f, succ(int_add(i, a))) := rewrite(sym(ej), gs0)
    have l1: int_le(a, int_add(i, a)) by arith(io, ha)
    have l2: int_lt(int_add(i, a), c) by arith(io, ha, hi, mo, hc)
    have s0 := mp(all_elim(hst, {int_add(i, a)}), jo, l1, l2)
    have s1 := rewrite(sym(ga), s0)
    have s2 := rewrite(sym(gs), s1)
    show by taut(s2)
  qed
  have ec: int_add(m, a) = c by arith(ha, hc, hac)
  have mm: int_le(m, m) by arith(mo)
  have gma := mp(mp(all_elim(gi, {m}), mo), mm)
  have gm: app(G, m) = app(f, c) := rewrite(ec, gma)
  have pm: p(app(G, m)) := rewrite(sym(gm), hp)
  have nc := g.cut_not_ok[x := app(G, m)]
  have em3: pair(3, app(f, c)) = pair(3, app(G, m)) := subst({y. pair(3, y) = pair(3, app(G, m))}, gm, refl({pair(3, app(G, m))}))
  have bm: (p(app(G, m)) && pair(3, app(f, c)) = pair(3, app(G, m))) || (!p(app(G, m)) && b(app(G, m), pair(3, app(f, c)))) by taut(pm, em3)
  have nc2: !is_ok(pair(3, app(f, c))) := rewrite(gm, nc)
  have e1: ex g. m in omega && is_fun(g) && dom(g) = succ(m) && app(g, empty) = app(f, a) &&
      (all i. i in m -> true && ((p(app(g, i)) && ok(app(g, succ(i)), empty) = pair(3, app(g, i))) || (!p(app(g, i)) && b(app(g, i), ok(app(g, succ(i)), empty))))) &&
      ((!true && pair(3, app(f, c)) = ok(app(g, m), empty)) || (true && ((p(app(g, m)) && pair(3, app(f, c)) = pair(3, app(g, m))) || (!p(app(g, m)) && b(app(g, m), pair(3, app(f, c))))) && !is_ok(pair(3, app(f, c)))))
    by ex_intro({G}, taut(mo, gf, gd, g0, st, bm, nc2))
  have e2: ex n g. n in omega && is_fun(g) && dom(g) = succ(n) && app(g, empty) = app(f, a) &&
      (all i. i in n -> true && ((p(app(g, i)) && ok(app(g, succ(i)), empty) = pair(3, app(g, i))) || (!p(app(g, i)) && b(app(g, i), ok(app(g, succ(i)), empty))))) &&
      ((!true && pair(3, app(f, c)) = ok(app(g, n), empty)) || (true && ((p(app(g, n)) && pair(3, app(f, c)) = pair(3, app(g, n))) || (!p(app(g, n)) && b(app(g, n), pair(3, app(f, c))))) && !is_ok(pair(3, app(f, c)))))
    by ex_intro({m}, e1)
  show by defs(taut(e2), while_fin_rel)
qed

// (from position a to the run's end at n, no stop on the way: the stopped
// run to the end's outcome)
theorem g.seg_end_wfr(l. p, l o. b, f, a, n, r): a in omega -> n in omega -> int_le(a, n) ->
  (all i. i in omega -> int_le(a, i) -> int_lt(i, n) -> !p(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) ->
  !p(app(f, n)) -> b(app(f, n), r) -> !is_ok(r) ->
  while_fin_rel(app(f, a), l. true, l y. (p(l) && y = pair(3, l)) || (!p(l) && b(l, y)), r)
proof
  assume ha hn han hst hp hb hr
  let m := int_sub(n, a)
  let G := fn_build(succ(m), i. app(f, int_add(i, a)))
  have mo: m in omega by arith(ha, hn, han)
  have gf := fn_build_fun[d := succ(m), v := i. app(f, int_add(i, a))]
  have gd := fn_build_dom[d := succ(m), v := i. app(f, int_add(i, a))]
  have em: succ(m) = int_add(m, 1) by arith(mo)
  have m1: int_add(m, 1) in omega by arith(mo)
  have gi: all i. i in omega -> int_le(i, m) -> app(G, i) = app(f, int_add(i, a)) proof
    fix i
    assume io il
    have mm: i in int_add(m, 1) by arith(io, il, mo, m1)
    show := mp(app_fn_build[d := succ(m), v := i. app(f, int_add(i, a)), a := i], rewrite(sym(em), mm))
  qed
  have zo: 0 in omega := rewrite(sym(lit_zero), omega_zero)
  have z0: int_le(0, m) by arith(mo)
  have g0a := mp(mp(all_elim(gi, {0}), zo), z0)
  have ea: int_add(0, a) = a by arith(ha)
  have g0b := rewrite(ea, g0a)
  have g0: app(G, empty) = app(f, a) := subst({y. app(G, y) = app(f, a)}, lit_zero, g0b)
  have st: all i. i in m -> true && ((p(app(G, i)) && ok(app(G, succ(i)), empty) = pair(3, app(G, i))) || (!p(app(G, i)) && b(app(G, i), ok(app(G, succ(i)), empty)))) proof
    fix i
    assume hi
    have io := mp(mp(nat_elem[k := m, i := i], mo), hi)
    have il: int_le(i, m) by arith(io, mo, hi)
    have i1o: int_add(i, 1) in omega by arith(io)
    have i1l: int_le(int_add(i, 1), m) by arith(io, mo, hi)
    have ga := mp(mp(all_elim(gi, {i}), io), il)
    have gb := mp(mp(all_elim(gi, {int_add(i, 1)}), i1o), i1l)
    have es: succ(i) = int_add(i, 1) by arith(io)
    have jo: int_add(i, a) in omega by arith(io, ha)
    have ej1: succ(int_add(i, a)) = int_add(int_add(i, a), 1) by arith(jo)
    have ej2: int_add(int_add(i, a), 1) = int_add(int_add(i, 1), a) by arith(io, ha)
    have ej := trans(ej1, ej2)
    have gs0: app(G, succ(i)) = app(f, int_add(int_add(i, 1), a)) := subst({y. app(G, y) = app(f, int_add(int_add(i, 1), a))}, sym(es), gb)
    have gs: app(G, succ(i)) = app(f, succ(int_add(i, a))) := rewrite(sym(ej), gs0)
    have l1: int_le(a, int_add(i, a)) by arith(io, ha)
    have l2: int_lt(int_add(i, a), n) by arith(io, ha, hi, mo, hn)
    have s0 := mp(all_elim(hst, {int_add(i, a)}), jo, l1, l2)
    have s1 := rewrite(sym(ga), s0)
    have s2 := rewrite(sym(gs), s1)
    show by taut(s2)
  qed
  have en: int_add(m, a) = n by arith(ha, hn, han)
  have mm: int_le(m, m) by arith(mo)
  have gma := mp(mp(all_elim(gi, {m}), mo), mm)
  have gm: app(G, m) = app(f, n) := rewrite(en, gma)
  have pm: !p(app(G, m)) := rewrite(sym(gm), hp)
  have bm: b(app(G, m), r) := rewrite(sym(gm), hb)
  have e1: ex g. m in omega && is_fun(g) && dom(g) = succ(m) && app(g, empty) = app(f, a) &&
      (all i. i in m -> true && ((p(app(g, i)) && ok(app(g, succ(i)), empty) = pair(3, app(g, i))) || (!p(app(g, i)) && b(app(g, i), ok(app(g, succ(i)), empty))))) &&
      ((!true && r = ok(app(g, m), empty)) || (true && ((p(app(g, m)) && r = pair(3, app(g, m))) || (!p(app(g, m)) && b(app(g, m), r))) && !is_ok(r)))
    by ex_intro({G}, taut(mo, gf, gd, g0, st, pm, bm, hr))
  have e2: ex n2 g. n2 in omega && is_fun(g) && dom(g) = succ(n2) && app(g, empty) = app(f, a) &&
      (all i. i in n2 -> true && ((p(app(g, i)) && ok(app(g, succ(i)), empty) = pair(3, app(g, i))) || (!p(app(g, i)) && b(app(g, i), ok(app(g, succ(i)), empty))))) &&
      ((!true && r = ok(app(g, n2), empty)) || (true && ((p(app(g, n2)) && r = pair(3, app(g, n2))) || (!p(app(g, n2)) && b(app(g, n2), r))) && !is_ok(r)))
    by ex_intro({m}, e1)
  show by defs(taut(e2), while_fin_rel)
qed

// (an infinite run whose steps between states off p lower a rank: after
// every position, a state on p)
theorem g.stop_exists_inf(l o. b, l. p, l. v, l. m, f, j):
  (all i. i in omega -> v(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) ->
  (all x y. v(x) -> !p(x) -> b(x, ok(y, empty)) -> !p(y) -> int_lt(m(y), m(x))) ->
  (all x. v(x) -> m(x) in omega) -> j in omega ->
  ex c. c in omega && int_lt(j, c) && p(app(f, c))
proof
  assume hst hd hm hj
  have nn: (all c. c in omega -> int_lt(j, c) -> !p(app(f, c))) -> false proof
    assume hn
    let s := int_add(j, 1)
    have so: s in omega by arith(hj)
    have ms := mp(all_elim(hm, {app(f, s)}), taut(mp(all_elim(hst, {s}), so)))
    // m falls by one at least each step after s
    have down: all k. k in omega -> int_le(int_add(m(app(f, int_add(s, k))), k), m(app(f, s))) proof
      have base: int_le(int_add(m(app(f, int_add(s, 0))), 0), m(app(f, s))) proof
        have e: int_add(s, 0) = s by arith(so)
        have r0: int_le(int_add(m(app(f, s)), 0), m(app(f, s))) by arith(ms)
        show := subst({y. int_le(int_add(m(app(f, y)), 0), m(app(f, s)))}, sym(e), r0)
      qed
      have step: all k. k in omega -> int_le(int_add(m(app(f, int_add(s, k))), k), m(app(f, s))) ->
          int_le(int_add(m(app(f, int_add(s, int_add(k, 1)))), int_add(k, 1)), m(app(f, s))) proof
        fix k
        assume ko ih
        let i := int_add(s, k)
        have io: i in omega by arith(so, ko)
        have i1o: int_add(i, 1) in omega by arith(io)
        have si := mp(all_elim(hst, {i}), io)
        have vi: v(app(f, i)) by taut(si)
        have bi: b(app(f, i), ok(app(f, succ(i)), empty)) by taut(si)
        have es: succ(i) = int_add(i, 1) by arith(io)
        have bi2 := rewrite(es, bi)
        have lt1: int_lt(j, i) by arith(hj, ko)
        have lt2: int_lt(j, int_add(i, 1)) by arith(hj, ko)
        have npi := mp(all_elim(hn, {i}), io, lt1)
        have npi1 := mp(all_elim(hn, {int_add(i, 1)}), i1o, lt2)
        have dec := mp(all_elim(hd, {app(f, i)}, {app(f, int_add(i, 1))}), vi, npi, bi2, npi1)
        have mi := mp(all_elim(hm, {app(f, i)}), vi)
        have vi1: v(app(f, int_add(i, 1))) by taut(mp(all_elim(hst, {int_add(i, 1)}), i1o))
        have mi1 := mp(all_elim(hm, {app(f, int_add(i, 1))}), vi1)
        have e2: int_add(s, int_add(k, 1)) = int_add(i, 1) by arith(so, ko)
        have r1: int_le(int_add(m(app(f, int_add(i, 1))), int_add(k, 1)), m(app(f, s))) by arith(ih, dec, mi, mi1, ko)
        show := subst({y. int_le(int_add(m(app(f, y)), int_add(k, 1)), m(app(f, s)))}, sym(e2), r1)
      qed
      show by induct(base, step)
    qed
    let K := int_add(m(app(f, s)), 1)
    have ko: K in omega by arith(ms)
    have dk := mp(all_elim(down, {K}), ko)
    have io: int_add(s, K) in omega by arith(so, ko)
    have vk: v(app(f, int_add(s, K))) by taut(mp(all_elim(hst, {int_add(s, K)}), io))
    have mk := mp(all_elim(hm, {app(f, int_add(s, K))}), vk)
    show by arith(dk, mk, ms)
  qed
  have imp: !(ex c. c in omega && int_lt(j, c) && p(app(f, c))) -> false proof
    assume ng
    have hn: all c. c in omega -> int_lt(j, c) -> !p(app(f, c)) proof
      fix c
      assume co jc
      have h1: p(app(f, c)) -> false proof
        assume pc
        have e: ex c. c in omega && int_lt(j, c) && p(app(f, c)) by ex_intro({c}, taut(co, jc, pc))
        show by taut(e, ng)
      qed
      show by taut(h1)
    qed
    show := mp(nn, hn)
  qed
  show by taut(imp)
qed

// (the first position after j on p, given one: no state on p between)
theorem g.first_stop(l. p, f, j): j in omega -> (ex c. c in omega && int_lt(j, c) && p(app(f, c))) ->
  ex c. c in omega && int_lt(j, c) && p(app(f, c)) && (all i. i in omega -> int_lt(j, i) -> int_lt(i, c) -> !p(app(f, i)))
proof
  assume hj he
  have he2: ex a. a in omega && (int_lt(j, a) && p(app(f, a))) proof
    obtain a, ha from he
    show by ex_intro({a}, taut(ha))
  qed
  have l := mp(nat_least[p := x. int_lt(j, x) && p(app(f, x))], he2)
  obtain c, hc from l
  have co: c in omega by taut(hc)
  have cl: int_lt(j, c) && p(app(f, c)) by taut(hc)
  have cm: all y. y in omega -> int_lt(j, y) && p(app(f, y)) -> int_le(c, y) by taut(hc)
  have mn: all i. i in omega -> int_lt(j, i) -> int_lt(i, c) -> !p(app(f, i)) proof
    fix i
    assume io ji ic
    have h1: p(app(f, i)) -> false proof
      assume pi
      have jp: int_lt(j, i) && p(app(f, i)) by taut(ji, pi)
      have le := mp(all_elim(cm, {i}), io, jp)
      show by arith(le, ic, io, co)
    qed
    show by taut(h1)
  qed
  show by ex_intro({c}, taut(co, cl, mn))
qed

// (positions: from j0 on q, each one's next on q related to it -- an
// increasing sequence of them, its n-th never before n)
theorem g.coind_pos(x. q, x y. R, j0): j0 in omega -> q(j0) ->
  (all j. j in omega -> q(j) -> ex c. c in omega && int_lt(j, c) && q(c) && R(j, c)) ->
  ex P. is_fun(P) && dom(P) = omega && app(P, empty) = j0 &&
    (all n. n in omega -> app(P, n) in omega && q(app(P, n)) && int_le(n, app(P, n)) &&
      int_lt(app(P, n), app(P, succ(n))) && R(app(P, n), app(P, succ(n))))
proof
  assume hj0 hq0 hs
  let N(v) := choose(c. c in omega && int_lt(v, c) && q(c) && R(v, c))
  let G(n) := nat_rec(j0, k v. N(v), n)
  let F := fn_build(omega, n. G(n))
  have hn: all v. v in omega -> q(v) -> N(v) in omega && int_lt(v, N(v)) && q(N(v)) && R(v, N(v)) proof
    fix v
    assume vo qv
    have e := mp(all_elim(hs, {v}), vo, qv)
    show := mp(choose_spec[p := c. c in omega && int_lt(v, c) && q(c) && R(v, c)], e)
  qed
  // every G(n) a position on q, never before n
  have gs: all n. n in omega -> G(n) in omega && q(G(n)) && int_le(n, G(n)) proof
    have base: G(0) in omega && q(G(0)) && int_le(0, G(0)) proof
      have r: G(0) = j0 := rec({nat_rec(j0, k v. N(v), 0)})
      have l0: int_le(0, j0) by arith(hj0)
      have t0: j0 in omega && q(j0) && int_le(0, j0) by taut(hj0, hq0, l0)
      show := rewrite(sym(r), t0)
    qed
    have step: all n. n in omega -> G(n) in omega && q(G(n)) && int_le(n, G(n)) -> G(int_add(n, 1)) in omega && q(G(int_add(n, 1))) && int_le(int_add(n, 1), G(int_add(n, 1))) proof
      fix n
      assume hn0 ih
      have r: G(int_add(n, 1)) = N(G(n)) := rec({nat_rec(j0, k v. N(v), int_add(n, 1))}, hn0)
      have go: G(n) in omega by taut(ih)
      have gq: q(G(n)) by taut(ih)
      have gl: int_le(n, G(n)) by taut(ih)
      have c := mp(all_elim(hn, {G(n)}), go, gq)
      have no: N(G(n)) in omega by taut(c)
      have nq: q(N(G(n))) by taut(c)
      have nl: int_lt(G(n), N(G(n))) by taut(c)
      have l1: int_le(int_add(n, 1), N(G(n))) by arith(gl, nl, hn0, go, no)
      have t1: N(G(n)) in omega && q(N(G(n))) && int_le(int_add(n, 1), N(G(n))) by taut(no, nq, l1)
      show := rewrite(sym(r), t1)
    qed
    show by induct(base, step)
  qed
  have fa: all n. n in omega -> app(F, n) = G(n) proof
    fix n
    assume hn0
    show := mp(app_fn_build[d := omega, v := n. G(n), a := n], hn0)
  qed
  have ff := fn_build_fun[d := omega, v := n. G(n)]
  have fd := fn_build_dom[d := omega, v := n. G(n)]
  have f0: app(F, empty) = j0 proof
    have z: 0 in omega by simp()
    have a0 := mp(all_elim(fa, {0}), z)
    have r: G(0) = j0 := rec({nat_rec(j0, k v. N(v), 0)})
    show := rewrite(lit_zero, trans(a0, r))
  qed
  have fstep: all n. n in omega -> app(F, n) in omega && q(app(F, n)) && int_le(n, app(F, n)) &&
      int_lt(app(F, n), app(F, succ(n))) && R(app(F, n), app(F, succ(n))) proof
    fix n
    assume hn0
    have sn: succ(n) in omega by simp(hn0)
    have e1: succ(n) = int_add(n, 1) by arith(hn0)
    have an := mp(all_elim(fa, {n}), hn0)
    have as0 := mp(all_elim(fa, {succ(n)}), sn)
    have qq: app(F, succ(n)) = G(int_add(n, 1)) := rewrite(e1, as0, {2})
    have r: G(int_add(n, 1)) = N(G(n)) := rec({nat_rec(j0, k v. N(v), int_add(n, 1))}, hn0)
    have gn := mp(all_elim(gs, {n}), hn0)
    have go: G(n) in omega by taut(gn)
    have gq: q(G(n)) by taut(gn)
    have gl: int_le(n, G(n)) by taut(gn)
    have c := mp(all_elim(hn, {G(n)}), go, gq)
    have lt0: int_lt(G(n), N(G(n))) by taut(c)
    have rr0: R(G(n), N(G(n))) by taut(c)
    have fs: app(F, succ(n)) = N(G(n)) := trans(qq, r)
    have lt1: int_lt(app(F, n), app(F, succ(n))) := rewrite(sym(an), rewrite(sym(fs), lt0))
    have rr1: R(app(F, n), app(F, succ(n))) := rewrite(sym(an), rewrite(sym(fs), rr0))
    have fo: app(F, n) in omega := rewrite(sym(an), go)
    have fq: q(app(F, n)) := rewrite(sym(an), gq)
    have fl: int_le(n, app(F, n)) := rewrite(sym(an), gl)
    show by taut(fo, fq, fl, lt1, rr1)
  qed
  show by ex_intro({F}, taut(ff, fd, f0, fstep))
qed

// (a rank falling at every position of a stretch: lower at its end)
theorem g.desc_chain(i. M, a, c): a in omega -> c in omega -> int_lt(a, c) ->
  (all i. i in omega -> int_le(a, i) -> int_lt(i, c) -> int_lt(M(int_add(i, 1)), M(i))) ->
  int_lt(M(c), M(a))
proof
  assume ha hc hac hd
  have up: all k. k in omega -> int_le(int_add(a, int_add(k, 1)), c) -> int_lt(M(int_add(a, int_add(k, 1))), M(a)) proof
    have base: int_le(int_add(a, int_add(0, 1)), c) -> int_lt(M(int_add(a, int_add(0, 1))), M(a)) proof
      assume hl
      have e: int_add(a, int_add(0, 1)) = int_add(a, 1) by arith(ha)
      have l0: int_le(a, a) by arith(ha)
      have l1: int_lt(a, c) by arith(ha, hc, hl)
      have d0 := mp(all_elim(hd, {a}), ha, l0, l1)
      show := subst({y. int_lt(M(y), M(a))}, sym(e), d0)
    qed
    have step: all k. k in omega -> (int_le(int_add(a, int_add(k, 1)), c) -> int_lt(M(int_add(a, int_add(k, 1))), M(a))) ->
        int_le(int_add(a, int_add(int_add(k, 1), 1)), c) -> int_lt(M(int_add(a, int_add(int_add(k, 1), 1))), M(a)) proof
      fix k
      assume ko ih hl
      let i := int_add(a, int_add(k, 1))
      have io: i in omega by arith(ha, ko)
      have hl0: int_le(i, c) by arith(ha, ko, hl)
      have prev := mp(ih, hl0)
      have l0: int_le(a, i) by arith(ha, ko)
      have l1: int_lt(i, c) by arith(ha, ko, hl)
      have d0 := mp(all_elim(hd, {i}), io, l0, l1)
      have e: int_add(i, 1) = int_add(a, int_add(int_add(k, 1), 1)) by arith(ha, ko)
      have d1 := subst({y. int_lt(M(y), M(i))}, e, d0)
      show by arith(prev, d1)
    qed
    show by induct(base, step)
  qed
  have ko: int_sub(int_sub(c, a), 1) in omega by arith(ha, hc, hac)
  have e: int_add(a, int_add(int_sub(int_sub(c, a), 1), 1)) = c by arith(ha, hc, hac)
  have hl: int_le(int_add(a, int_add(int_sub(int_sub(c, a), 1), 1)), c) by arith(ha, hc, hac)
  have r := mp(all_elim(up, {int_sub(int_sub(c, a), 1)}), ko, hl)
  show := subst({y. int_lt(M(y), M(a))}, e, r)
qed

// (a trip from a head at j, no stop before c: its states in the loop's
// region w, its first stop the head or an exit)
theorem g.trip_w(l o. b, l. pt, l. hd, l. xp, l. w, l. v, f, j, c):
  (all x y. v(x) -> w(x) -> b(x, ok(y, empty)) -> (pt(y) -> hd(y) || xp(y)) && (!pt(y) -> w(y))) ->
  (all x. v(x) -> hd(x) -> w(x)) ->
  j in omega -> c in omega -> int_lt(j, c) -> hd(app(f, j)) ->
  (all i. i in omega -> int_le(j, i) -> int_lt(i, c) -> v(app(f, i)) && b(app(f, i), ok(app(f, int_add(i, 1)), empty))) ->
  (all i. i in omega -> int_lt(j, i) -> int_lt(i, c) -> !pt(app(f, i))) ->
  (all i. i in omega -> int_le(j, i) -> int_lt(i, c) -> w(app(f, i))) && (pt(app(f, c)) -> hd(app(f, c)) || xp(app(f, c)))
proof
  assume hwc hw0 jo co jc jh hst nb
  have up: all k. k in omega -> int_lt(int_add(j, k), c) -> w(app(f, int_add(j, k))) proof
    have base: int_lt(int_add(j, 0), c) -> w(app(f, int_add(j, 0))) proof
      assume _
      have e: int_add(j, 0) = j by arith(jo)
      have vj: v(app(f, j)) by taut(mp(all_elim(hst, {j}), jo, (int_le(j, j) by arith(jo)), jc))
      have wj := mp(all_elim(hw0, {app(f, j)}), vj, jh)
      show := subst({y. w(app(f, y))}, sym(e), wj)
    qed
    have step: all k. k in omega -> (int_lt(int_add(j, k), c) -> w(app(f, int_add(j, k)))) ->
        int_lt(int_add(j, int_add(k, 1)), c) -> w(app(f, int_add(j, int_add(k, 1)))) proof
      fix k
      assume ko ih hl
      let i := int_add(j, k)
      have io: i in omega by arith(jo, ko)
      have il: int_lt(i, c) by arith(jo, ko, hl)
      have wi := mp(ih, il)
      have si := mp(all_elim(hst, {i}), io, (int_le(j, i) by arith(jo, ko)), il)
      have vi: v(app(f, i)) by taut(si)
      have bi: b(app(f, i), ok(app(f, int_add(i, 1)), empty)) by taut(si)
      have i1o: int_add(i, 1) in omega by arith(io)
      have e: int_add(i, 1) = int_add(j, int_add(k, 1)) by arith(jo, ko)
      have np := mp(all_elim(nb, {int_add(i, 1)}), i1o, (int_lt(j, int_add(i, 1)) by arith(jo, ko)), (int_lt(int_add(i, 1), c) by arith(jo, ko, hl)))
      have c2 := mp(all_elim(hwc, {app(f, i)}, {app(f, int_add(i, 1))}), vi, wi, bi)
      have w1: w(app(f, int_add(i, 1))) by taut(c2, np)
      show := subst({y. w(app(f, y))}, e, w1)
    qed
    show by induct(base, step)
  qed
  have all1: all i. i in omega -> int_le(j, i) -> int_lt(i, c) -> w(app(f, i)) proof
    fix i
    assume io il ic
    have ko: int_sub(i, j) in omega by arith(io, jo, il)
    have e: int_add(j, int_sub(i, j)) = i by arith(io, jo)
    have r := mp(all_elim(up, {int_sub(i, j)}), ko, (int_lt(int_add(j, int_sub(i, j)), c) by arith(io, jo, ic)))
    show := subst({y. w(app(f, y))}, e, r)
  qed
  // (the last step: from c - 1, in the region, to c)
  let p := int_sub(c, 1)
  have po: p in omega by arith(jo, co, jc)
  have pl: int_le(j, p) by arith(jo, co, jc)
  have pc: int_lt(p, c) by arith(co, jc, jo)
  have wp := mp(all_elim(all1, {p}), po, pl, pc)
  have sp := mp(all_elim(hst, {p}), po, pl, pc)
  have vp: v(app(f, p)) by taut(sp)
  have bp: b(app(f, p), ok(app(f, int_add(p, 1)), empty)) by taut(sp)
  have ep: int_add(p, 1) = c by arith(co, jc, jo)
  have bp2: b(app(f, p), ok(app(f, c), empty)) := rewrite(ep, bp)
  have c2 := mp(all_elim(hwc, {app(f, p)}, {app(f, c)}), vp, wp, bp2)
  have last: pt(app(f, c)) -> hd(app(f, c)) || xp(app(f, c)) by taut(c2)
  show by taut(all1, last)
qed

// (an outcome ok: tag 0)
theorem g.ok_fst(x): is_ok(x) -> fst(x) = 0
proof
  assume h
  obtain s v, e from expand(h, is_ok)
  show by simp(expand(e, ok, tag))
qed

// (an infinite run whose state at j may end with r, not ok -- an undefined
// step, its records then not growing: the finite run to j ending there)
theorem g.inf_fin(l o. b, f, j, r): (all i. i in omega -> true && b(app(f, i), ok(app(f, succ(i)), empty))) ->
  j in omega -> b(app(f, j), r) -> !is_ok(r) ->
  ex n g. n in omega && is_fun(g) && dom(g) = succ(n) && app(g, empty) = app(f, empty) &&
    (all i. i in n -> true && b(app(g, i), ok(app(g, succ(i)), empty))) &&
    ((!true && r = ok(app(g, n), empty)) || (true && b(app(g, n), r) && !is_ok(r)))
proof
  assume hst hj hb hr
  let G := fn_build(succ(j), i. app(f, i))
  have gf := fn_build_fun[d := succ(j), v := i. app(f, i)]
  have gd := fn_build_dom[d := succ(j), v := i. app(f, i)]
  have ej: succ(j) = int_add(j, 1) by arith(hj)
  have j1: int_add(j, 1) in omega by arith(hj)
  have gi: all i. i in omega -> int_le(i, j) -> app(G, i) = app(f, i) proof
    fix i
    assume io il
    have mm: i in int_add(j, 1) by arith(io, il, hj, j1)
    show := mp(app_fn_build[d := succ(j), v := i. app(f, i), a := i], rewrite(sym(ej), mm))
  qed
  have zo: 0 in omega := rewrite(sym(lit_zero), omega_zero)
  have z0: int_le(0, j) by arith(hj)
  have g0a := mp(mp(all_elim(gi, {0}), zo), z0)
  have g0: app(G, empty) = app(f, empty) := subst({y. app(G, y) = app(f, y)}, lit_zero, g0a)
  have st: all i. i in j -> true && b(app(G, i), ok(app(G, succ(i)), empty)) proof
    fix i
    assume hi
    have io := mp(mp(nat_elem[k := j, i := i], hj), hi)
    have il: int_le(i, j) by arith(io, hj, hi)
    have i1o: int_add(i, 1) in omega by arith(io)
    have i1l: int_le(int_add(i, 1), j) by arith(io, hj, hi)
    have ga := mp(mp(all_elim(gi, {i}), io), il)
    have gb := mp(mp(all_elim(gi, {int_add(i, 1)}), i1o), i1l)
    have es: succ(i) = int_add(i, 1) by arith(io)
    have gs: app(G, succ(i)) = app(f, succ(i)) := subst({y. app(G, y) = app(f, y)}, sym(es), gb)
    have s0 := mp(all_elim(hst, {i}), io)
    have s1 := rewrite(sym(ga), s0)
    have s2 := rewrite(sym(gs), s1)
    show by taut(s2)
  qed
  have jj: int_le(j, j) by arith(hj)
  have gm := mp(mp(all_elim(gi, {j}), hj), jj)
  have bm: b(app(G, j), r) := rewrite(sym(gm), hb)
  have e1: ex g. j in omega && is_fun(g) && dom(g) = succ(j) && app(g, empty) = app(f, empty) &&
      (all i. i in j -> true && b(app(g, i), ok(app(g, succ(i)), empty))) &&
      ((!true && r = ok(app(g, j), empty)) || (true && b(app(g, j), r) && !is_ok(r)))
    by ex_intro({G}, taut(hj, gf, gd, g0, st, bm, hr))
  show by ex_intro({j}, e1)
qed

// ----------------------------------------------------------------------
//  The loop theorem: the CFG's runs from a loop head (hd, its states;
//  stops pt, the head's among them; H a head's or exit's state the
//  structured loop's state) are the structured loop's (bs its body, ks its
//  rest), given each trip's claim -- the CFG from a head state, stopped at
//  the next stop: at the head, the structured body's ok there (marked 4);
//  at an exit, its `break` there (5); else the rest's outcome -- and the
//  claim at the exits. Trip by trip: finitely many trips by induction, the
//  structured loop's finite run; infinitely many, its infinite run over
//  the head visits, the same trace (the records growing: g.limit_up) -- or
//  a step undefined (its records not growing; its state then diverging
//  with any trace, the run's among them: a finite run).
theorem g.loop_head(l o. b, l. tr, r o. k, l. pt, l. hd, l. xp, l. w, l. v, l. m, mh, l. H, x y. bs, x. trs, x9 o. ks):
  (all x y. v(x) -> b(x, ok(y, empty)) -> v(y) && (g.tr_le(tr(x), tr(y)) || (all t. t in univ(1) -> b(x, diverge(t))))) ->
  (all x y. v(x) -> w(x) -> b(x, ok(y, empty)) -> !hd(y) -> int_lt(m(y), m(x))) ->
  (all x. v(x) -> m(x) in omega) ->
  (all x. v(x) -> hd(x) -> pt(x) && m(x) = mh && w(x)) ->
  (all x y. v(x) -> w(x) -> b(x, ok(y, empty)) -> (pt(y) -> hd(y) || xp(y)) && (!pt(y) -> w(y))) ->
  (all x. xp(x) -> pt(x) && !hd(x)) ->
  (all x o. v(x) -> hd(x) ->
    (ex x8. b(x, x8) && ((ex l2. x8 = ok(l2, empty) && (ex x9. while_fin_rel(l2, l. true, l y. (pt(l) && y = pair(3, l)) || (!pt(l) && b(l, y)), x9) &&
      ((fst(x9) = 3 && hd(snd(x9)) && o = pair(4, H(snd(x9)))) || (fst(x9) = 3 && !hd(snd(x9)) && o = pair(5, H(snd(x9)))) || k(x9, o)))) ||
      (!is_ok(x8) && k(x8, o)))) ->
    pair(fst(x), o) in univ(1) ->
    ex x2. bs(H(x), x2) && ((x2 = ok(out_state(x2), empty) && o = pair(4, out_state(x2))) ||
      (!(x2 = ok(out_state(x2), empty)) && ((x2 = exc(out_state(x2), pair("brk", empty)) && o = pair(5, out_state(x2))) ||
        (!(x2 = exc(out_state(x2), pair("brk", empty))) && !(fst(x2) = 0) && ks(x2, o)))))) ->
  (all x r o. v(x) -> xp(x) -> int_lt(m(x), mh) -> while_rel(x, l. true, l y. b(l, y), l. tr(l), r) -> k(r, o) ->
    pair(fst(x), o) in univ(1) -> ks(exc(H(x), pair("brk", empty)), o)) ->
  (all x2 z. !ks(x2, pair(4, z)) && !ks(x2, pair(5, z))) ->
  (all r z. !k(r, pair(4, z)) && !k(r, pair(5, z))) ->
  (all t o. k(diverge(t), o) -> ks(diverge(t), o)) ->
  (all x. v(x) -> trs(H(x)) = tr(x)) ->
  (all x. v(x) -> fst(x) in univ(1) && H(x) in univ(1)) ->
  (all x. v(x) -> tr(x) in univ(1)) ->
  all l r o. v(l) -> hd(l) -> while_rel(l, l. true, l y. b(l, y), l. tr(l), r) -> k(r, o) -> pair(fst(l), o) in univ(1) ->
    ex x9. while_rel(H(l), x. true, x y. bs(x, y), x. trs(x), x9) && ks(x9, o)
proof
  assume h1 h2 hm hh hwc hxp hb hex hko hk45 hkd htr hu htu
  fix l r o
  assume vl hl hw hk hU
  let B(x, y) := (pt(x) && y = pair(3, x)) || (!pt(x) && b(x, y))
  let KT(x9, o2) := (fst(x9) = 3 && hd(snd(x9)) && o2 = pair(4, H(snd(x9)))) || (fst(x9) = 3 && !hd(snd(x9)) && o2 = pair(5, H(snd(x9)))) || k(x9, o2)
  let TRIPK(x, o2) := ex x8. b(x, x8) && ((ex l2. x8 = ok(l2, empty) && (ex x9. while_fin_rel(l2, l. true, l y. B(l, y), x9) && KT(x9, o2))) || (!is_ok(x8) && k(x8, o2)))
  let Z(x) := ex x9. while_fin_rel(H(x), x. true, x y. bs(x, y), x9) && ks(x9, o)
  have ou: o in univ(1) := mp(all_elim(g.univ_snd, {fst(l)}, {o}), hU)
  have hw0: all x. v(x) -> hd(x) -> w(x) proof
    fix x
    assume vx hx
    show by taut(mp(all_elim(hh, {x}), vx, hx))
  qed
  have o4: 4 in univ(1) := mp(univ_trans[u := 1, a := 4, b := omega], omega_univ, (4 in omega by simp()))
  have o5: 5 in univ(1) := mp(univ_trans[u := 1, a := 5, b := omega], omega_univ, (5 in omega by simp()))
  // (the structured body's outcomes from the trips)
  have cont: all x x2. v(x) -> hd(x) -> v(x2) -> TRIPK(x, pair(4, H(x2))) -> bs(H(x), ok(H(x2), empty)) proof
    fix x x2
    assume vx hx vx2 ht
    have ux := mp(all_elim(hu, {x}), vx)
    have ux2 := mp(all_elim(hu, {x2}), vx2)
    have u1: pair(4, H(x2)) in univ(1) := mp(all_elim(g.pair_univ, {4}, {H(x2)}), o4, taut(ux2))
    have u2: pair(fst(x), pair(4, H(x2))) in univ(1) := mp(all_elim(g.pair_univ, {fst(x)}, {pair(4, H(x2))}), taut(ux), u1)
    have e := mp(all_elim(hb, {x}, {pair(4, H(x2))}), vx, hx, ht, u2)
    obtain y2, hbs hk2 from e
    have nk := all_elim(hko, {y2}, {H(x2)})
    have c1: y2 = ok(out_state(y2), empty) && pair(4, H(x2)) = pair(4, out_state(y2)) -> bs(H(x), ok(H(x2), empty)) proof
      assume a
      have eq1: pair(4, H(x2)) = pair(4, out_state(y2)) by taut(a)
      have es: H(x2) = out_state(y2) := mp(pair_snd1[a := 4, b := H(x2), d := out_state(y2)], eq1)
      have ey: y2 = ok(out_state(y2), empty) by taut(a)
      have ey2: y2 = ok(H(x2), empty) := rewrite(sym(es), ey)
      show := rewrite(ey2, hbs)
    qed
    have c2: pair(4, H(x2)) = pair(5, out_state(y2)) -> false proof
      assume a
      have f := mp(pair_fst[a := 4, b := H(x2), c := 5, d := out_state(y2)], a)
      show by simp(f)
    qed
    show by taut(hk2, c1, c2, nk)
  qed
  have brk: all x x2. v(x) -> hd(x) -> v(x2) -> TRIPK(x, pair(5, H(x2))) -> bs(H(x), exc(H(x2), pair("brk", empty))) proof
    fix x x2
    assume vx hx vx2 ht
    have ux := mp(all_elim(hu, {x}), vx)
    have ux2 := mp(all_elim(hu, {x2}), vx2)
    have u1: pair(5, H(x2)) in univ(1) := mp(all_elim(g.pair_univ, {5}, {H(x2)}), o5, taut(ux2))
    have u2: pair(fst(x), pair(5, H(x2))) in univ(1) := mp(all_elim(g.pair_univ, {fst(x)}, {pair(5, H(x2))}), taut(ux), u1)
    have e := mp(all_elim(hb, {x}, {pair(5, H(x2))}), vx, hx, ht, u2)
    obtain y2, hbs hk2 from e
    have nk := all_elim(hko, {y2}, {H(x2)})
    have c1: pair(5, H(x2)) = pair(4, out_state(y2)) -> false proof
      assume a
      have f := mp(pair_fst[a := 5, b := H(x2), c := 4, d := out_state(y2)], a)
      show by simp(f)
    qed
    have c2: y2 = exc(out_state(y2), pair("brk", empty)) && pair(5, H(x2)) = pair(5, out_state(y2)) -> bs(H(x), exc(H(x2), pair("brk", empty))) proof
      assume a
      have eq1: pair(5, H(x2)) = pair(5, out_state(y2)) by taut(a)
      have es: H(x2) = out_state(y2) := mp(pair_snd1[a := 5, b := H(x2), d := out_state(y2)], eq1)
      have ey: y2 = exc(out_state(y2), pair("brk", empty)) by taut(a)
      have ey2: y2 = exc(H(x2), pair("brk", empty)) := rewrite(sym(es), ey)
      show := rewrite(ey2, hbs)
    qed
    show by taut(hk2, c1, c2, nk)
  qed
  have endk: all x r2. v(x) -> hd(x) -> k(r2, o) -> TRIPK(x, o) -> ex y2. bs(H(x), y2) && !is_ok(y2) && ks(y2, o) proof
    fix x r2
    assume vx hx hkr ht
    have ux := mp(all_elim(hu, {x}), vx)
    have u2: pair(fst(x), o) in univ(1) := mp(all_elim(g.pair_univ, {fst(x)}, {o}), taut(ux), ou)
    have e := mp(all_elim(hb, {x}, {o}), vx, hx, ht, u2)
    obtain y2, hbs hk2 from e
    have c1: o = pair(4, out_state(y2)) -> false proof
      assume a
      have n4 := all_elim(hk45, {r2}, {out_state(y2)})
      have k4 := rewrite(a, hkr)
      show by taut(n4, k4)
    qed
    have c2: o = pair(5, out_state(y2)) -> false proof
      assume a
      have n5 := all_elim(hk45, {r2}, {out_state(y2)})
      have k5 := rewrite(a, hkr)
      show by taut(n5, k5)
    qed
    have c3: !(fst(y2) = 0) -> !is_ok(y2) proof
      assume nf
      have i: is_ok(y2) -> false proof
        assume io
        show by taut(mp(g.ok_fst[x := y2], io), nf)
      qed
      show by taut(i)
    qed
    have k3: !(fst(y2) = 0) && ks(y2, o) by taut(hk2, c1, c2)
    show by ex_intro({y2}, taut(hbs, k3, c3))
  qed
  // the run: finitely or infinitely many iterations
  have runs: (ex n f. n in omega && is_fun(f) && dom(f) = succ(n) && app(f, empty) = l &&
      (all i. i in n -> true && b(app(f, i), ok(app(f, succ(i)), empty))) &&
      ((!true && r = ok(app(f, n), empty)) || (true && b(app(f, n), r) && !is_ok(r)))) ||
    (ex f. is_fun(f) && dom(f) = omega && app(f, empty) = l &&
      (all i. i in omega -> true && b(app(f, i), ok(app(f, succ(i)), empty))) &&
      r = diverge(trace_limit(i. tr(app(f, i))))) by taut(expand(hw, while_rel))
  // finitely many: every head state on the run, Z -- by induction on the
  // distance to the end
  have fin: (ex n f. n in omega && is_fun(f) && dom(f) = succ(n) && app(f, empty) = l &&
      (all i. i in n -> true && b(app(f, i), ok(app(f, succ(i)), empty))) &&
      ((!true && r = ok(app(f, n), empty)) || (true && b(app(f, n), r) && !is_ok(r)))) -> Z(l) proof
    assume e
    obtain n f, hn hfun hdom hf0 hst hend from e
    have hbn: b(app(f, n), r) by taut(hend)
    have hnr: !is_ok(r) by taut(hend)
    have stp: all i. i in omega -> int_lt(i, n) -> b(app(f, i), ok(app(f, int_add(i, 1)), empty)) proof
      fix i
      assume io il
      have im: i in n by arith(io, il, hn)
      have es: succ(i) = int_add(i, 1) by arith(io)
      have bi: b(app(f, i), ok(app(f, succ(i)), empty)) by taut(mp(all_elim(hst, {i}), im))
      show := rewrite(es, bi)
    qed
    have vf: all i. i in omega -> int_le(i, n) -> v(app(f, i)) proof
      fix i
      assume io il
      have q0: v(app(f, empty)) := rewrite(sym(hf0), vl)
      have inv: all x y. v(x) -> b(x, ok(y, empty)) -> v(y) proof
        fix x y
        assume vx bx
        show by taut(mp(all_elim(h1, {x}, {y}), vx, bx))
      qed
      show := mp(while_path_inv[c := l. true, b := l y. b(l, y), q := l. v(l), f := f, n := n, k := i], hn, hst, q0, inv, io, il)
    qed
    have down: all d. d in omega -> all j. j in omega -> int_le(j, n) -> int_le(int_sub(n, j), d) -> hd(app(f, j)) -> Z(app(f, j)) proof
      have base: all j. j in omega -> int_le(j, n) -> int_le(int_sub(n, j), 0) -> hd(app(f, j)) -> Z(app(f, j)) proof
        fix j
        assume jo jl jd jh
        have ej: j = n by arith(jo, jl, jd, hn)
        have vj := mp(all_elim(vf, {j}), jo, jl)
        // the head's block leaving: the trip's outcome the run's
        have bj: b(app(f, j), r) := subst({y. b(app(f, y), r)}, sym(ej), hbn)
        have t: TRIPK(app(f, j), o) by ex_intro({r}, taut(bj, hnr, hk))
        have ee := mp(all_elim(endk, {app(f, j)}, {r}), vj, jh, hk, t)
        obtain y2, hbs hny hks from ee
        have w := mp(while_fin_one[l0 := H(app(f, j)), c := x. true, b := x y. bs(x, y), r := y2], taut(hbs, hny))
        show by ex_intro({y2}, taut(w, hks))
      qed
      have step: all d. d in omega -> (all j. j in omega -> int_le(j, n) -> int_le(int_sub(n, j), d) -> hd(app(f, j)) -> Z(app(f, j))) ->
          (all j. j in omega -> int_le(j, n) -> int_le(int_sub(n, j), int_add(d, 1)) -> hd(app(f, j)) -> Z(app(f, j))) proof
        fix d
        assume do ih
        fix j
        assume jo jl jd jh
        have vj := mp(all_elim(vf, {j}), jo, jl)
        have mj: pt(app(f, j)) && m(app(f, j)) = mh by taut(mp(all_elim(hh, {app(f, j)}), vj, jh))
        // at the end: as the base
        have atn: j = n -> Z(app(f, j)) proof
          assume ej
          have bj: b(app(f, j), r) := subst({y. b(app(f, y), r)}, sym(ej), hbn)
          have t: TRIPK(app(f, j), o) by ex_intro({r}, taut(bj, hnr, hk))
          have ee := mp(all_elim(endk, {app(f, j)}, {r}), vj, jh, hk, t)
          obtain y2, hbs hny hks from ee
          have w := mp(while_fin_one[l0 := H(app(f, j)), c := x. true, b := x y. bs(x, y), r := y2], taut(hbs, hny))
          show by ex_intro({y2}, taut(w, hks))
        qed
        have before: int_lt(j, n) -> Z(app(f, j)) proof
          assume jn
          have j1o: int_add(j, 1) in omega by arith(jo)
          have b0: b(app(f, j), ok(app(f, succ(j)), empty)) by taut(mp(all_elim(hst, {j}), (j in n by arith(jo, jn, hn))))
          have es1: succ(j) = int_add(j, 1) by arith(jo)
          // a stop after j, up to n: the trip ends at the first
          have yes: (ex q8. q8 in omega && int_lt(j, q8) && pt(app(f, q8)) && int_le(q8, n)) -> Z(app(f, j)) proof
            assume ew
            obtain q8, hw from ew
            have wo: q8 in omega by taut(hw)
            have jw: int_lt(j, q8) by taut(hw)
            have pw: pt(app(f, q8)) by taut(hw)
            have wn: int_le(q8, n) by taut(hw)
            have es2: ex c. c in omega && int_lt(j, c) && pt(app(f, c)) by ex_intro({q8}, taut(wo, jw, pw))
            have fs := mp(g.first_stop[p := y. pt(y), f := f, j := j], jo, es2)
            obtain c, hcs from fs
            have co: c in omega by taut(hcs)
            have jc: int_lt(j, c) by taut(hcs)
            have pc: pt(app(f, c)) by taut(hcs)
            have nb: all i. i in omega -> int_lt(j, i) -> int_lt(i, c) -> !pt(app(f, i)) by taut(hcs)
            have cw: int_lt(q8, c) -> false proof
              assume wc
              have np := mp(all_elim(nb, {q8}), wo, jw, wc)
              show by taut(np, pw)
            qed
            have cn: int_le(c, n) by arith(cw, wn, co, wo)
            have vc := mp(all_elim(vf, {c}), co, cn)
            // (the trip's states in the loop's region, its stop the head or
            // an exit)
            have tst: all i. i in omega -> int_le(j, i) -> int_lt(i, c) -> v(app(f, i)) && b(app(f, i), ok(app(f, int_add(i, 1)), empty)) proof
              fix i
              assume io il ic
              have vi := mp(all_elim(vf, {i}), io, (int_le(i, n) by arith(io, ic, cn)))
              have bi := mp(all_elim(stp, {i}), io, (int_lt(i, n) by arith(io, ic, cn)))
              show by taut(vi, bi)
            qed
            have tw := mp(g.trip_w[b := y z. b(y, z), pt := y. pt(y), hd := y. hd(y), xp := y. xp(y), w := y. w(y), v := y. v(y), f := f, j := j, c := c], hwc, hw0, jo, co, jc, jh, tst, nb)
            have twa: all i. i in omega -> int_le(j, i) -> int_lt(i, c) -> w(app(f, i)) by taut(tw)
            have twc: pt(app(f, c)) -> hd(app(f, c)) || xp(app(f, c)) by taut(tw)
            // the trip: j's block, then the stopped run to c's mark
            have sgs: all i. i in omega -> int_le(int_add(j, 1), i) -> int_lt(i, c) -> !pt(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty)) proof
              fix i
              assume io il ic
              have np := mp(all_elim(nb, {i}), io, (int_lt(j, i) by arith(io, jo, il)), ic)
              have bi: b(app(f, i), ok(app(f, succ(i)), empty)) by taut(mp(all_elim(hst, {i}), (i in n by arith(io, ic, cn, hn, co))))
              show by taut(np, bi)
            qed
            have sg := mp(g.seg_wfr[p := y. pt(y), b := y z. b(y, z), f := f, a := int_add(j, 1), c := c], j1o, co, (int_le(int_add(j, 1), c) by arith(jo, co, jc)), sgs, pc)
            have sg1: while_fin_rel(app(f, succ(j)), l. true, l y. B(l, y), pair(3, app(f, c))) := rewrite(sym(es1), sg)
            have s3: snd(pair(3, app(f, c))) = app(f, c) by simp()
            have f3: fst(pair(3, app(f, c))) = 3 by simp()
            // (the trip's claim at an outcome KT gives at c's mark)
            have trip: all o2. KT(pair(3, app(f, c)), o2) -> TRIPK(app(f, j), o2) proof
              fix o2
              assume kt
              have e9: ex x9. while_fin_rel(app(f, succ(j)), l. true, l y. B(l, y), x9) && KT(x9, o2) by ex_intro({pair(3, app(f, c))}, taut(sg1, kt))
              have e2: ex l2. ok(app(f, succ(j)), empty) = ok(l2, empty) && (ex x9. while_fin_rel(l2, l. true, l y. B(l, y), x9) && KT(x9, o2))
                by ex_intro({app(f, succ(j))}, taut(refl({ok(app(f, succ(j)), empty)}), e9))
              show by ex_intro({ok(app(f, succ(j)), empty)}, taut(b0, e2))
            qed
            // at a head: an iteration, then Z there
            have athead: hd(app(f, c)) -> Z(app(f, j)) proof
              assume hc
              have kt: KT(pair(3, app(f, c)), pair(4, H(app(f, c)))) by taut(f3, rewrite(sym(s3), hc), rewrite(sym(s3), refl({pair(4, H(app(f, c)))}), {2}))
              have it := mp(all_elim(cont, {app(f, j)}, {app(f, c)}), vj, jh, vc, mp(all_elim(trip, {pair(4, H(app(f, c)))}), kt))
              have zc := mp(all_elim(ih, {c}), co, cn, (int_le(int_sub(n, c), d) by arith(jd, jc, jo, co, hn, do)), hc)
              obtain x9, wz kz from zc
              have w := mp(while_step_fin[l0 := H(app(f, j)), l1 := H(app(f, c)), c := x. true, b := x y. bs(x, y), r := x9], (true by taut()), it, wz)
              show by ex_intro({x9}, taut(w, kz))
            qed
            // at an exit: the iteration's break, the rest the exit's claim
            have atexit: !hd(app(f, c)) -> Z(app(f, j)) proof
              assume hc
              have kt: KT(pair(3, app(f, c)), pair(5, H(app(f, c)))) by taut(f3, rewrite(sym(s3), hc), rewrite(sym(s3), refl({pair(5, H(app(f, c)))}), {2}))
              have it := mp(all_elim(brk, {app(f, j)}, {app(f, c)}), vj, jh, vc, mp(all_elim(trip, {pair(5, H(app(f, c)))}), kt))
              have xc: xp(app(f, c)) by taut(twc, pc, hc)
              have dcs: all i. i in omega -> int_le(j, i) -> int_lt(i, c) -> int_lt(m(app(f, int_add(i, 1))), m(app(f, i))) proof
                  fix i
                  assume io il ic
                  have vi := mp(all_elim(vf, {i}), io, (int_le(i, n) by arith(io, ic, cn)))
                  have wi := mp(all_elim(twa, {i}), io, il, ic)
                  have bi := mp(all_elim(stp, {i}), io, (int_lt(i, n) by arith(io, ic, cn)))
                  have i1o: int_add(i, 1) in omega by arith(io)
                  have tgt: !hd(app(f, int_add(i, 1))) proof
                    have c1: int_add(i, 1) = c -> !hd(app(f, int_add(i, 1))) proof
                      assume e
                      show := subst({y. !hd(app(f, y))}, sym(e), hc)
                    qed
                    have c2: int_lt(int_add(i, 1), c) -> !hd(app(f, int_add(i, 1))) proof
                      assume lt
                      have np := mp(all_elim(nb, {int_add(i, 1)}), i1o, (int_lt(j, int_add(i, 1)) by arith(io, il, jo)), lt)
                      have vi1 := mp(all_elim(vf, {int_add(i, 1)}), i1o, (int_le(int_add(i, 1), n) by arith(io, ic, cn)))
                      have hp: hd(app(f, int_add(i, 1))) -> pt(app(f, int_add(i, 1))) proof
                        assume h
                        show by taut(mp(all_elim(hh, {app(f, int_add(i, 1))}), vi1, h))
                      qed
                      show by taut(hp, np)
                    qed
                    have dj: int_add(i, 1) = c || int_lt(int_add(i, 1), c) by arith(io, ic, co)
                    show by taut(c1, c2, dj)
                  qed
                  show := mp(all_elim(h2, {app(f, i)}, {app(f, int_add(i, 1))}), vi, wi, bi, tgt)
              qed
              have dc := mp(g.desc_chain[M := i. m(app(f, i)), a := j, c := c], jo, co, jc, dcs)
              have mjm: m(app(f, j)) = mh by taut(mj)
              have mlt: int_lt(m(app(f, c)), mh) by arith(dc, mjm)
              have rest := mp(while_suffix[c := l. true, b := l y. b(l, y), tr := l. tr(l), r := r, f := f, n := n, k := c], hn, hst, hend, co, cn)
              have uc := mp(all_elim(hu, {app(f, c)}), vc)
              have u2: pair(fst(app(f, c)), o) in univ(1) := mp(all_elim(g.pair_univ, {fst(app(f, c))}, {o}), taut(uc), ou)
              have kx := mp(all_elim(hex, {app(f, c)}, {r}, {o}), vc, xc, mlt, rest, hk, u2)
              have nx := all_elim(g.not_ok_exc, {H(app(f, c))}, {pair("brk", empty)})
              have w := mp(while_fin_one[l0 := H(app(f, j)), c := x. true, b := x y. bs(x, y), r := exc(H(app(f, c)), pair("brk", empty))], taut(it, nx))
              show by ex_intro({exc(H(app(f, c)), pair("brk", empty))}, taut(w, kx))
            qed
            show by taut(athead, atexit)
          qed
          // no stop after j: the trip runs to the end
          have no: !(ex q8. q8 in omega && int_lt(j, q8) && pt(app(f, q8)) && int_le(q8, n)) -> Z(app(f, j)) proof
            assume nw
            have nb: all i. i in omega -> int_lt(j, i) -> int_le(i, n) -> !pt(app(f, i)) proof
              fix i
              assume io ji il
              have h: pt(app(f, i)) -> false proof
                assume pi
                have e: ex q8. q8 in omega && int_lt(j, q8) && pt(app(f, q8)) && int_le(q8, n) by ex_intro({i}, taut(io, ji, pi, il))
                show by taut(e, nw)
              qed
              show by taut(h)
            qed
            have sgs: all i. i in omega -> int_le(int_add(j, 1), i) -> int_lt(i, n) -> !pt(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty)) proof
              fix i
              assume io il ic
              have np := mp(all_elim(nb, {i}), io, (int_lt(j, i) by arith(io, jo, il)), (int_le(i, n) by arith(io, ic)))
              have bi: b(app(f, i), ok(app(f, succ(i)), empty)) by taut(mp(all_elim(hst, {i}), (i in n by arith(io, ic, hn))))
              show by taut(np, bi)
            qed
            have npn := mp(all_elim(nb, {n}), hn, jn, (int_le(n, n) by arith(hn)))
            have sg := mp(g.seg_end_wfr[p := y. pt(y), b := y z. b(y, z), f := f, a := int_add(j, 1), n := n, r := r], j1o, hn, (int_le(int_add(j, 1), n) by arith(jo, jn)), sgs, npn, hbn, hnr)
            have sg1: while_fin_rel(app(f, succ(j)), l. true, l y. B(l, y), r) := rewrite(sym(es1), sg)
            have e9: ex x9. while_fin_rel(app(f, succ(j)), l. true, l y. B(l, y), x9) && KT(x9, o) by ex_intro({r}, taut(sg1, hk))
            have e2: ex l2. ok(app(f, succ(j)), empty) = ok(l2, empty) && (ex x9. while_fin_rel(l2, l. true, l y. B(l, y), x9) && KT(x9, o))
              by ex_intro({app(f, succ(j))}, taut(refl({ok(app(f, succ(j)), empty)}), e9))
            have t: TRIPK(app(f, j), o) by ex_intro({ok(app(f, succ(j)), empty)}, taut(b0, e2))
            have ee := mp(all_elim(endk, {app(f, j)}, {r}), vj, jh, hk, t)
            obtain y2, hbs hny hks from ee
            have w := mp(while_fin_one[l0 := H(app(f, j)), c := x. true, b := x y. bs(x, y), r := y2], taut(hbs, hny))
            show by ex_intro({y2}, taut(w, hks))
          qed
          show by taut(yes, no)
        qed
        show by taut(atn, before, (j = n || int_lt(j, n) by arith(jo, jl, hn)))
      qed
      show by induct(base, step)
    qed
    have d0 := mp(all_elim(down, {n}), hn)
    have z0 := mp(all_elim(d0, {empty}), omega_zero, (int_le(empty, n) by taut(rewrite(lit_zero, (int_le(0, n) by arith(hn))))),
      (int_le(int_sub(n, empty), n) by taut(rewrite(lit_zero, (int_le(int_sub(n, 0), n) by arith(hn))))), rewrite(sym(hf0), hl))
    show := rewrite(hf0, z0)
  qed
  have zfin: (ex n f. n in omega && is_fun(f) && dom(f) = succ(n) && app(f, empty) = l &&
      (all i. i in n -> true && b(app(f, i), ok(app(f, succ(i)), empty))) &&
      ((!true && r = ok(app(f, n), empty)) || (true && b(app(f, n), r) && !is_ok(r)))) ->
      ex x9. while_rel(H(l), x. true, x y. bs(x, y), x. trs(x), x9) && ks(x9, o) proof
    assume e
    have z := mp(fin, e)
    obtain x9, w9 k9 from z
    have w := mp(while_fin_while[l0 := H(l), c := x. true, b := x y. bs(x, y), tr := x. trs(x), r := x9], w9)
    show by ex_intro({x9}, taut(w, k9))
  qed
  // infinitely many, the records growing: an exit reached (then trip by
  // trip to it), or the head forever (the structured loop's infinite run)
  have zinf: (ex f. is_fun(f) && dom(f) = omega && app(f, empty) = l &&
      (all i. i in omega -> true && b(app(f, i), ok(app(f, succ(i)), empty))) &&
      r = diverge(trace_limit(i. tr(app(f, i)))) && (all i. i in omega -> g.tr_le(tr(app(f, i)), tr(app(f, succ(i)))))) ->
      ex x9. while_rel(H(l), x. true, x y. bs(x, y), x. trs(x), x9) && ks(x9, o) proof
    assume e
    obtain f, hfun hdom hf0 hst hr ch1 from e
    have inv: all x y. v(x) -> b(x, ok(y, empty)) -> v(y) proof
      fix x y
      assume vx bx
      show by taut(mp(all_elim(h1, {x}, {y}), vx, bx))
    qed
    have q0: v(app(f, empty)) := rewrite(sym(hf0), vl)
    have vf: all i. i in omega -> v(app(f, i)) proof
      fix i
      assume io
      show := mp(while_path_inv_inf[c := l. true, b := l y. b(l, y), q := l. v(l), f := f, k := i], hst, q0, inv, io)
    qed
    have stp: all i. i in omega -> b(app(f, i), ok(app(f, int_add(i, 1)), empty)) proof
      fix i
      assume io
      have es: succ(i) = int_add(i, 1) by arith(io)
      have bi: b(app(f, i), ok(app(f, succ(i)), empty)) by taut(mp(all_elim(hst, {i}), io))
      show := rewrite(es, bi)
    qed
    // (the records along the run: a chain)
    have chain := mp(g.chain_succ[T := i. tr(app(f, i))], ch1)
    have hkr: k(diverge(trace_limit(i. tr(app(f, i)))), o) := rewrite(hr, hk)
    // (a stretch from a head to the next stop: the rank falls, to an exit)
    have desc: all j c. j in omega -> c in omega -> int_lt(j, c) -> hd(app(f, j)) -> !hd(app(f, c)) -> pt(app(f, c)) ->
        (all i. i in omega -> int_lt(j, i) -> int_lt(i, c) -> !pt(app(f, i))) -> int_lt(m(app(f, c)), mh) && xp(app(f, c)) proof
      fix j c
      assume jo co jc jh hc pc nb
      have tst: all i. i in omega -> int_le(j, i) -> int_lt(i, c) -> v(app(f, i)) && b(app(f, i), ok(app(f, int_add(i, 1)), empty)) proof
        fix i
        assume io il ic
        show by taut(mp(all_elim(vf, {i}), io), mp(all_elim(stp, {i}), io))
      qed
      have tw := mp(g.trip_w[b := y z. b(y, z), pt := y. pt(y), hd := y. hd(y), xp := y. xp(y), w := y. w(y), v := y. v(y), f := f, j := j, c := c], hwc, hw0, jo, co, jc, jh, tst, nb)
      have twa: all i. i in omega -> int_le(j, i) -> int_lt(i, c) -> w(app(f, i)) by taut(tw)
      have xc: xp(app(f, c)) by taut(tw, pc, hc)
      have dcs: all i. i in omega -> int_le(j, i) -> int_lt(i, c) -> int_lt(m(app(f, int_add(i, 1))), m(app(f, i))) proof
        fix i
        assume io il ic
        have vi := mp(all_elim(vf, {i}), io)
        have wi := mp(all_elim(twa, {i}), io, il, ic)
        have bi := mp(all_elim(stp, {i}), io)
        have i1o: int_add(i, 1) in omega by arith(io)
        have tgt: !hd(app(f, int_add(i, 1))) proof
          have c1: int_add(i, 1) = c -> !hd(app(f, int_add(i, 1))) proof
            assume e
            show := subst({y. !hd(app(f, y))}, sym(e), hc)
          qed
          have c2: int_lt(int_add(i, 1), c) -> !hd(app(f, int_add(i, 1))) proof
            assume lt
            have np := mp(all_elim(nb, {int_add(i, 1)}), i1o, (int_lt(j, int_add(i, 1)) by arith(io, il, jo)), lt)
            have vi1 := mp(all_elim(vf, {int_add(i, 1)}), i1o)
            have hp: hd(app(f, int_add(i, 1))) -> pt(app(f, int_add(i, 1))) proof
              assume h
              show by taut(mp(all_elim(hh, {app(f, int_add(i, 1))}), vi1, h))
            qed
            show by taut(hp, np)
          qed
          have dj: int_add(i, 1) = c || int_lt(int_add(i, 1), c) by arith(io, ic, co)
          show by taut(c1, c2, dj)
        qed
        show := mp(all_elim(h2, {app(f, i)}, {app(f, int_add(i, 1))}), vi, wi, bi, tgt)
      qed
      have dc := mp(g.desc_chain[M := i. m(app(f, i)), a := j, c := c], jo, co, jc, dcs)
      have mj := mp(all_elim(hh, {app(f, j)}), mp(all_elim(vf, {j}), jo), jh)
      have mjm: m(app(f, j)) = mh by taut(mj)
      have mlt: int_lt(m(app(f, c)), mh) by arith(dc, mjm)
      show by taut(mlt, xc)
    qed
    // (a head at j, the first stop after it at c: the trip's claims)
    have tripat: all j c o2. j in omega -> c in omega -> int_lt(j, c) -> pt(app(f, c)) ->
        (all i. i in omega -> int_lt(j, i) -> int_lt(i, c) -> !pt(app(f, i))) ->
        KT(pair(3, app(f, c)), o2) -> TRIPK(app(f, j), o2) proof
      fix j c o2
      assume jo co jc pc nb kt
      have j1o: int_add(j, 1) in omega by arith(jo)
      have es1: succ(j) = int_add(j, 1) by arith(jo)
      have b0: b(app(f, j), ok(app(f, succ(j)), empty)) by taut(mp(all_elim(hst, {j}), jo))
      have sgs: all i. i in omega -> int_le(int_add(j, 1), i) -> int_lt(i, c) -> !pt(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty)) proof
        fix i
        assume io il ic
        have np := mp(all_elim(nb, {i}), io, (int_lt(j, i) by arith(io, jo, il)), ic)
        have bi: b(app(f, i), ok(app(f, succ(i)), empty)) by taut(mp(all_elim(hst, {i}), io))
        show by taut(np, bi)
      qed
      have sg := mp(g.seg_wfr[p := y. pt(y), b := y z. b(y, z), f := f, a := int_add(j, 1), c := c], j1o, co, (int_le(int_add(j, 1), c) by arith(jo, co, jc)), sgs, pc)
      have sg1: while_fin_rel(app(f, succ(j)), l. true, l y. B(l, y), pair(3, app(f, c))) := rewrite(sym(es1), sg)
      have e9: ex x9. while_fin_rel(app(f, succ(j)), l. true, l y. B(l, y), x9) && KT(x9, o2) by ex_intro({pair(3, app(f, c))}, taut(sg1, kt))
      have e2: ex l2. ok(app(f, succ(j)), empty) = ok(l2, empty) && (ex x9. while_fin_rel(l2, l. true, l y. B(l, y), x9) && KT(x9, o2))
        by ex_intro({app(f, succ(j))}, taut(refl({ok(app(f, succ(j)), empty)}), e9))
      show by ex_intro({ok(app(f, succ(j)), empty)}, taut(b0, e2))
    qed
    have kt4: all c. hd(app(f, c)) -> KT(pair(3, app(f, c)), pair(4, H(app(f, c)))) proof
      fix c
      assume hc
      have s3: snd(pair(3, app(f, c))) = app(f, c) by simp()
      have f3: fst(pair(3, app(f, c))) = 3 by simp()
      show by taut(f3, rewrite(sym(s3), hc), rewrite(sym(s3), refl({pair(4, H(app(f, c)))}), {2}))
    qed
    have kt5: all c. !hd(app(f, c)) -> KT(pair(3, app(f, c)), pair(5, H(app(f, c)))) proof
      fix c
      assume hc
      have s3: snd(pair(3, app(f, c))) = app(f, c) by simp()
      have f3: fst(pair(3, app(f, c))) = 3 by simp()
      show by taut(f3, rewrite(sym(s3), hc), rewrite(sym(s3), refl({pair(5, H(app(f, c)))}), {2}))
    qed
    // an exit reached
    have withexit: (ex e. e in omega && (int_lt(0, e) && pt(app(f, e)) && !hd(app(f, e)))) -> ex x9. while_rel(H(l), x. true, x y. bs(x, y), x. trs(x), x9) && ks(x9, o) proof
      assume ee
      have le := mp(nat_least[p := x. int_lt(0, x) && pt(app(f, x)) && !hd(app(f, x))], ee)
      obtain e0, he0 from le
      have e0o: e0 in omega by taut(he0)
      have e0p: int_lt(0, e0) && pt(app(f, e0)) && !hd(app(f, e0)) by taut(he0)
      have e0m: all y. y in omega -> int_lt(0, y) && pt(app(f, y)) && !hd(app(f, y)) -> int_le(e0, y) by taut(he0)
      have pe0: pt(app(f, e0)) by taut(e0p)
      have ne0: !hd(app(f, e0)) by taut(e0p)
      // the rest from the exit: a divergence of the run's trace
      have rest := mp(g.run_suffix_exact[c := l. true, b := l y. b(l, y), tr := l. tr(l), f := f, k := e0], hst, chain, e0o)
      have ve0 := mp(all_elim(vf, {e0}), e0o)
      have ue0 := mp(all_elim(hu, {app(f, e0)}), ve0)
      have u2: pair(fst(app(f, e0)), o) in univ(1) := mp(all_elim(g.pair_univ, {fst(app(f, e0))}, {o}), (fst(app(f, e0)) in univ(1) by taut(ue0)), ou)
      have down: all d. d in omega -> all j. j in omega -> int_lt(j, e0) -> int_le(int_sub(e0, j), d) -> hd(app(f, j)) -> Z(app(f, j)) proof
        have base: all j. j in omega -> int_lt(j, e0) -> int_le(int_sub(e0, j), 0) -> hd(app(f, j)) -> Z(app(f, j)) proof
          fix j
          assume jo je jd jh
          have fl: false by arith(jo, je, jd, e0o)
          show by taut(fl)
        qed
        have step: all d. d in omega -> (all j. j in omega -> int_lt(j, e0) -> int_le(int_sub(e0, j), d) -> hd(app(f, j)) -> Z(app(f, j))) ->
            (all j. j in omega -> int_lt(j, e0) -> int_le(int_sub(e0, j), int_add(d, 1)) -> hd(app(f, j)) -> Z(app(f, j))) proof
          fix d
          assume do ih
          fix j
          assume jo je jd jh
          have vj := mp(all_elim(vf, {j}), jo)
          have es2: ex c. c in omega && int_lt(j, c) && pt(app(f, c)) by ex_intro({e0}, taut(e0o, je, pe0))
          have fs := mp(g.first_stop[p := y. pt(y), f := f, j := j], jo, es2)
          obtain c, hcs from fs
          have co: c in omega by taut(hcs)
          have jc: int_lt(j, c) by taut(hcs)
          have pc: pt(app(f, c)) by taut(hcs)
          have nb: all i. i in omega -> int_lt(j, i) -> int_lt(i, c) -> !pt(app(f, i)) by taut(hcs)
          have ce: int_lt(e0, c) -> false proof
            assume ec
            have np := mp(all_elim(nb, {e0}), e0o, je, ec)
            show by taut(np, pe0)
          qed
          have vc := mp(all_elim(vf, {c}), co)
          // c before the exit: a head (the least exit e0)
          have early: int_lt(c, e0) -> Z(app(f, j)) proof
            assume ce0
            have hc: hd(app(f, c)) proof
              have nh: !hd(app(f, c)) -> false proof
                assume nhc
                have lt0: int_lt(0, c) by arith(jo, jc)
                have m0 := mp(all_elim(e0m, {c}), co, (int_lt(0, c) && pt(app(f, c)) && !hd(app(f, c)) by taut(lt0, pc, nhc)))
                show by arith(m0, ce0)
              qed
              show by taut(nh)
            qed
            have it := mp(all_elim(cont, {app(f, j)}, {app(f, c)}), vj, jh, vc, mp(all_elim(tripat, {j}, {c}, {pair(4, H(app(f, c)))}), jo, co, jc, pc, nb, mp(all_elim(kt4, {c}), hc)))
            have zc := mp(all_elim(ih, {c}), co, ce0, (int_le(int_sub(e0, c), d) by arith(jd, jc, jo, co, e0o, do)), hc)
            obtain x9, wz kz from zc
            have w := mp(while_step_fin[l0 := H(app(f, j)), l1 := H(app(f, c)), c := x. true, b := x y. bs(x, y), r := x9], (true by taut()), it, wz)
            show by ex_intro({x9}, taut(w, kz))
          qed
          // c the exit: the iteration's break, the rest the exit's claim
          have atexit: c = e0 -> Z(app(f, j)) proof
            assume ece
            have hc: !hd(app(f, c)) := subst({y. !hd(app(f, y))}, sym(ece), ne0)
            have it := mp(all_elim(brk, {app(f, j)}, {app(f, c)}), vj, jh, vc, mp(all_elim(tripat, {j}, {c}, {pair(5, H(app(f, c)))}), jo, co, jc, pc, nb, mp(all_elim(kt5, {c}), hc)))
            have dx := mp(all_elim(desc, {j}, {c}), jo, co, jc, jh, hc, pc, nb)
            have mlt: int_lt(m(app(f, c)), mh) by taut(dx)
            have xc: xp(app(f, c)) by taut(dx)
            have rest2 := subst({y. while_rel(app(f, y), l. true, l y. b(l, y), l. tr(l), diverge(trace_limit(i. tr(app(f, i)))))}, sym(ece), rest)
            have uc := subst({y. pair(fst(app(f, y)), o) in univ(1)}, sym(ece), u2)
            have kx := mp(all_elim(hex, {app(f, c)}, {diverge(trace_limit(i. tr(app(f, i))))}, {o}), vc, xc, mlt, rest2, hkr, uc)
            have nx := all_elim(g.not_ok_exc, {H(app(f, c))}, {pair("brk", empty)})
            have w := mp(while_fin_one[l0 := H(app(f, j)), c := x. true, b := x y. bs(x, y), r := exc(H(app(f, c)), pair("brk", empty))], taut(it, nx))
            show by ex_intro({exc(H(app(f, c)), pair("brk", empty))}, taut(w, kx))
          qed
          have dj: int_lt(c, e0) || c = e0 by arith(ce, co, e0o)
          show by taut(early, atexit, dj)
        qed
        show by induct(base, step)
      qed
      have d0 := mp(all_elim(down, {e0}), e0o)
      have lt0: int_lt(empty, e0) := rewrite(lit_zero, (int_lt(0, e0) by taut(e0p)))
      have z0 := mp(all_elim(d0, {empty}), omega_zero, lt0, (int_le(int_sub(e0, empty), e0) by taut(rewrite(lit_zero, (int_le(int_sub(e0, 0), e0) by arith(e0o))))), rewrite(sym(hf0), hl))
      have zl := rewrite(hf0, z0)
      obtain x9, w9 k9 from zl
      have w := mp(while_fin_while[l0 := H(l), c := x. true, b := x y. bs(x, y), tr := x. trs(x), r := x9], w9)
      show by ex_intro({x9}, taut(w, k9))
    qed
    // the head forever: the structured loop's infinite run over the head
    // visits, its trace the run's
    have noexit: !(ex e. e in omega && (int_lt(0, e) && pt(app(f, e)) && !hd(app(f, e)))) -> ex x9. while_rel(H(l), x. true, x y. bs(x, y), x. trs(x), x9) && ks(x9, o) proof
      assume ne
      have allh: all c. c in omega -> int_lt(0, c) -> pt(app(f, c)) -> hd(app(f, c)) proof
        fix c
        assume co c0 pc
        have h: !hd(app(f, c)) -> false proof
          assume nh
          have e1: ex e. e in omega && (int_lt(0, e) && pt(app(f, e)) && !hd(app(f, e))) by ex_intro({c}, taut(co, c0, pc, nh))
          show by taut(e1, ne)
        qed
        show by taut(h)
      qed
      // (every state of the run in the loop's region: a stop the head, any
      // other one after a state of the region)
      have wall: all i. i in omega -> w(app(f, i)) proof
        have base: w(app(f, 0)) proof
          have w0 := mp(all_elim(hw0, {app(f, empty)}), q0, rewrite(sym(hf0), hl))
          show := subst({y. w(app(f, y))}, sym(lit_zero), w0)
        qed
        have step: all i. i in omega -> w(app(f, i)) -> w(app(f, int_add(i, 1))) proof
          fix i
          assume io wi
          have i1o: int_add(i, 1) in omega by arith(io)
          have c2 := mp(all_elim(hwc, {app(f, i)}, {app(f, int_add(i, 1))}), mp(all_elim(vf, {i}), io), wi, mp(all_elim(stp, {i}), io))
          have atp: pt(app(f, int_add(i, 1))) -> w(app(f, int_add(i, 1))) proof
            assume pi
            have hi := mp(all_elim(allh, {int_add(i, 1)}), i1o, (int_lt(0, int_add(i, 1)) by arith(io)), pi)
            show := mp(all_elim(hw0, {app(f, int_add(i, 1))}), mp(all_elim(vf, {int_add(i, 1)}), i1o), hi)
          qed
          show by taut(c2, atp)
        qed
        show := mp(nat_ind[p := i. w(app(f, i))], base, step)
      qed
      have hst2: all i. i in omega -> (v(app(f, i)) && w(app(f, i))) && b(app(f, i), ok(app(f, succ(i)), empty)) proof
        fix i
        assume io
        have bi: b(app(f, i), ok(app(f, succ(i)), empty)) by taut(mp(all_elim(hst, {i}), io))
        show by taut(mp(all_elim(vf, {i}), io), mp(all_elim(wall, {i}), io), bi)
      qed
      have hdec: all x y. v(x) && w(x) -> !pt(x) -> b(x, ok(y, empty)) -> !pt(y) -> int_lt(m(y), m(x)) proof
        fix x y
        assume vwx px bx py
        have vx: v(x) by taut(vwx)
        have wx: w(x) by taut(vwx)
        have vy: v(y) by taut(mp(all_elim(h1, {x}, {y}), vx, bx))
        have nhy: hd(y) -> false proof
          assume hy
          show by taut(mp(all_elim(hh, {y}), vy, hy), py)
        qed
        show := mp(all_elim(h2, {x}, {y}), vx, wx, bx, (!hd(y) by taut(nhy)))
      qed
      have hm2: all x. v(x) && w(x) -> m(x) in omega proof
        fix x
        assume vwx
        show := mp(all_elim(hm, {x}), (v(x) by taut(vwx)))
      qed
      have nexts: all j. j in omega -> hd(app(f, j)) -> ex c. c in omega && int_lt(j, c) && hd(app(f, c)) && (all i. i in omega -> int_lt(j, i) -> int_lt(i, c) -> !pt(app(f, i))) proof
        fix j
        assume jo jh
        have se := mp(g.stop_exists_inf[b := y z. b(y, z), p := y. pt(y), v := y. v(y) && w(y), m := y. m(y), f := f, j := j], hst2, hdec, hm2, jo)
        have fs := mp(g.first_stop[p := y. pt(y), f := f, j := j], jo, se)
        obtain c, hcs from fs
        have co: c in omega by taut(hcs)
        have jc: int_lt(j, c) by taut(hcs)
        have pc: pt(app(f, c)) by taut(hcs)
        have nb: all i. i in omega -> int_lt(j, i) -> int_lt(i, c) -> !pt(app(f, i)) by taut(hcs)
        have hc := mp(all_elim(allh, {c}), co, (int_lt(0, c) by arith(jo, jc)), pc)
        show by ex_intro({c}, taut(co, jc, hc, nb))
      qed
      have h0: hd(app(f, empty)) := rewrite(sym(hf0), hl)
      have cp := mp(g.coind_pos[q := x. hd(app(f, x)), R := x y. all i. i in omega -> int_lt(x, i) -> int_lt(i, y) -> !pt(app(f, i)), j0 := empty], omega_zero, h0, nexts)
      obtain P, hpf hpd hp0 hps from cp
      // each visit to the next: an iteration of the structured loop
      let G := fn_build(omega, n. H(app(f, app(P, n))))
      have gf := fn_build_fun[d := omega, v := n. H(app(f, app(P, n)))]
      have gd := fn_build_dom[d := omega, v := n. H(app(f, app(P, n)))]
      have gi: all n. n in omega -> app(G, n) = H(app(f, app(P, n))) proof
        fix n
        assume no
        show := mp(app_fn_build[d := omega, v := n. H(app(f, app(P, n))), a := n], no)
      qed
      have g0: app(G, empty) = H(l) proof
        have a0 := mp(all_elim(gi, {empty}), omega_zero)
        have a1 := rewrite(hp0, a0)
        show := rewrite(hf0, a1)
      qed
      have gst: all n. n in omega -> true && bs(app(G, n), ok(app(G, succ(n)), empty)) proof
        fix n
        assume no
        have pn := mp(all_elim(hps, {n}), no)
        have pno: app(P, n) in omega by taut(pn)
        have pnh: hd(app(f, app(P, n))) by taut(pn)
        have pnl: int_lt(app(P, n), app(P, succ(n))) by taut(pn)
        have pnr: all i. i in omega -> int_lt(app(P, n), i) -> int_lt(i, app(P, succ(n))) -> !pt(app(f, i)) by taut(pn)
        have sno: succ(n) in omega by simp(no)
        have ps := mp(all_elim(hps, {succ(n)}), sno)
        have pso: app(P, succ(n)) in omega by taut(ps)
        have psh: hd(app(f, app(P, succ(n)))) by taut(ps)
        have vps := mp(all_elim(vf, {app(P, succ(n))}), pso)
        have psp: pt(app(f, app(P, succ(n)))) by taut(mp(all_elim(hh, {app(f, app(P, succ(n)))}), vps, psh))
        have tk := mp(all_elim(tripat, {app(P, n)}, {app(P, succ(n))}, {pair(4, H(app(f, app(P, succ(n)))))}), pno, pso, pnl, psp, pnr, mp(all_elim(kt4, {app(P, succ(n))}), psh))
        have it := mp(all_elim(cont, {app(f, app(P, n))}, {app(f, app(P, succ(n)))}), mp(all_elim(vf, {app(P, n)}), pno), pnh, vps, tk)
        have gn := mp(all_elim(gi, {n}), no)
        have gs := mp(all_elim(gi, {succ(n)}), sno)
        have it2 := rewrite(sym(gs), rewrite(sym(gn), it))
        show by taut(it2)
      qed
      // its trace: the records at the visits, the run's
      have tg: all n. n in omega -> trs(app(G, n)) = tr(app(f, app(P, n))) proof
        fix n
        assume no
        have gn := mp(all_elim(gi, {n}), no)
        have pno: app(P, n) in omega by taut(mp(all_elim(hps, {n}), no))
        have t1 := mp(all_elim(htr, {app(f, app(P, n))}), mp(all_elim(vf, {app(P, n)}), pno))
        show := rewrite(sym(gn), t1)
      qed
      have tl1 := mp(g.limit_cong[T1 := n. trs(app(G, n)), T2 := n. tr(app(f, app(P, n)))], tg)
      have pp: all n. n in omega -> app(P, n) in omega && int_le(n, app(P, n)) proof
        fix n
        assume no
        have pn := mp(all_elim(hps, {n}), no)
        show by taut(pn)
      qed
      have tl2 := mp(g.limit_up[T := i. tr(app(f, i)), p := n. app(P, n)], chain, pp)
      have tl := trans(tl1, tl2)
      have e1: ex g. is_fun(g) && dom(g) = omega && app(g, empty) = H(l) &&
          (all i. i in omega -> true && bs(app(g, i), ok(app(g, succ(i)), empty))) &&
          diverge(trace_limit(i. tr(app(f, i)))) = diverge(trace_limit(i. trs(app(g, i))))
        by ex_intro({G}, taut(gf, gd, g0, gst, subst({y. diverge(trace_limit(i. tr(app(f, i)))) = diverge(y)}, sym(tl), refl({diverge(trace_limit(i. tr(app(f, i))))}))))
      have w: while_rel(H(l), x. true, x y. bs(x, y), x. trs(x), diverge(trace_limit(i. tr(app(f, i))))) by defs(taut(e1), while_rel)
      have kd := mp(all_elim(hkd, {trace_limit(i. tr(app(f, i)))}, {o}), hkr)
      show by ex_intro({diverge(trace_limit(i. tr(app(f, i))))}, taut(w, kd))
    qed
    show by taut(withexit, noexit)
  qed
  // infinitely many: the records growing (above), or a step undefined --
  // the finite run to it, diverging there with the run's trace (above)
  have zinf2: (ex f. is_fun(f) && dom(f) = omega && app(f, empty) = l &&
      (all i. i in omega -> true && b(app(f, i), ok(app(f, succ(i)), empty))) &&
      r = diverge(trace_limit(i. tr(app(f, i))))) ->
      ex x9. while_rel(H(l), x. true, x y. bs(x, y), x. trs(x), x9) && ks(x9, o) proof
    assume e
    obtain f, hfun hdom hf0 hst hr from e
    have inv: all x y. v(x) -> b(x, ok(y, empty)) -> v(y) proof
      fix x y
      assume vx bx
      show by taut(mp(all_elim(h1, {x}, {y}), vx, bx))
    qed
    have q0: v(app(f, empty)) := rewrite(sym(hf0), vl)
    have vf: all i. i in omega -> v(app(f, i)) proof
      fix i
      assume io
      show := mp(while_path_inv_inf[c := l. true, b := l y. b(l, y), q := l. v(l), f := f, k := i], hst, q0, inv, io)
    qed
    have gr1: all i. i in omega -> g.tr_le(tr(app(f, i)), tr(app(f, succ(i)))) || (all t. t in univ(1) -> b(app(f, i), diverge(t))) proof
      fix i
      assume io
      have bi: b(app(f, i), ok(app(f, succ(i)), empty)) by taut(mp(all_elim(hst, {i}), io))
      show by taut(mp(all_elim(h1, {app(f, i)}, {app(f, succ(i))}), mp(all_elim(vf, {i}), io), bi))
    qed
    have ub: (ex j. j in omega && (all t. t in univ(1) -> b(app(f, j), diverge(t)))) ->
        ex x9. while_rel(H(l), x. true, x y. bs(x, y), x. trs(x), x9) && ks(x9, o) proof
      assume ej
      obtain j, hj from ej
      have jo: j in omega by taut(hj)
      have uj: all t. t in univ(1) -> b(app(f, j), diverge(t)) by taut(hj)
      have tu0: all i. i in omega -> tr(app(f, i)) in univ(1) proof
        fix i
        assume io
        show := mp(all_elim(htu, {app(f, i)}), mp(all_elim(vf, {i}), io))
      qed
      have tu := mp(tr.tl_univ[t := i. tr(app(f, i))], tu0)
      have bj0 := mp(all_elim(uj, {trace_limit(i. tr(app(f, i)))}), tu)
      have bj: b(app(f, j), r) := rewrite(sym(hr), bj0)
      have nr: !is_ok(r) := rewrite(sym(hr), all_elim(g.not_ok_div, {trace_limit(i. tr(app(f, i)))}))
      have fw := mp(g.inf_fin[b := x y. b(x, y), f := f, j := j, r := r], hst, jo, bj, nr)
      show := mp(zfin, rewrite(hf0, fw))
    qed
    have gro: !(ex j. j in omega && (all t. t in univ(1) -> b(app(f, j), diverge(t)))) ->
        ex x9. while_rel(H(l), x. true, x y. bs(x, y), x. trs(x), x9) && ks(x9, o) proof
      assume ne
      have ch1: all i. i in omega -> g.tr_le(tr(app(f, i)), tr(app(f, succ(i)))) proof
        fix i
        assume io
        have nu: !(all t. t in univ(1) -> b(app(f, i), diverge(t))) proof
          assume u
          have e2: ex j. j in omega && (all t. t in univ(1) -> b(app(f, j), diverge(t))) by ex_intro({i}, taut(io, u))
          show by taut(ne, e2)
        qed
        show by taut(mp(all_elim(gr1, {i}), io), nu)
      qed
      have e3: ex f2. is_fun(f2) && dom(f2) = omega && app(f2, empty) = l &&
          (all i. i in omega -> true && b(app(f2, i), ok(app(f2, succ(i)), empty))) &&
          r = diverge(trace_limit(i. tr(app(f2, i)))) && (all i. i in omega -> g.tr_le(tr(app(f2, i)), tr(app(f2, succ(i)))))
        by ex_intro({f}, taut(hfun, hdom, hf0, hst, hr, ch1))
      show := mp(zinf, e3)
    qed
    show by taut(ub, gro)
  qed
  show by taut(runs, zfin, zinf2)
qed

// ----------------------------------------------------------------------
//  A segment from a cut point outside the loops (q: a region where every
//  step lowers the rank, closed under steps to states off the stops)

// (a stretch from position 0, no stop before c: in the region, the rank
// falling)
theorem g.stretch_q(l o. b, l. pt, l. q, l. v, l. m, f, c):
  (all x y. v(x) -> q(x) -> b(x, ok(y, empty)) -> int_lt(m(y), m(x)) && (!pt(y) -> q(y))) ->
  c in omega -> q(app(f, 0)) ->
  (all i. i in omega -> int_lt(i, c) -> v(app(f, i)) && b(app(f, i), ok(app(f, int_add(i, 1)), empty))) ->
  (all i. i in omega -> int_lt(0, i) -> int_lt(i, c) -> !pt(app(f, i))) ->
  all i. i in omega -> int_lt(i, c) -> q(app(f, i)) && int_lt(m(app(f, int_add(i, 1))), m(app(f, i)))
proof
  assume hq co q0 hst nb
  have qs: all i. i in omega -> int_lt(i, c) -> q(app(f, i)) proof
    have base: int_lt(0, c) -> q(app(f, 0)) proof
      assume _
      show := q0
    qed
    have step: all i. i in omega -> (int_lt(i, c) -> q(app(f, i))) -> int_lt(int_add(i, 1), c) -> q(app(f, int_add(i, 1))) proof
      fix i
      assume io ih hl
      have il: int_lt(i, c) by arith(io, hl)
      have qi := mp(ih, il)
      have si := mp(all_elim(hst, {i}), io, il)
      have c2 := mp(all_elim(hq, {app(f, i)}, {app(f, int_add(i, 1))}), (v(app(f, i)) by taut(si)), qi, (b(app(f, i), ok(app(f, int_add(i, 1)), empty)) by taut(si)))
      have np := mp(all_elim(nb, {int_add(i, 1)}), (int_add(i, 1) in omega by arith(io)), (int_lt(0, int_add(i, 1)) by arith(io)), hl)
      show by taut(c2, np)
    qed
    show := mp(nat_ind[p := i. int_lt(i, c) -> q(app(f, i))], base, step)
  qed
  fix i
  assume io ic
  have qi := mp(all_elim(qs, {i}), io, ic)
  have si := mp(all_elim(hst, {i}), io, ic)
  have c2 := mp(all_elim(hq, {app(f, i)}, {app(f, int_add(i, 1))}), (v(app(f, i)) by taut(si)), qi, (b(app(f, i), ok(app(f, int_add(i, 1)), empty)) by taut(si)))
  show by taut(qi, c2)
qed

// (the run from l, in such a region: its first block leaving, or the
// segment running to the end without a stop, or reaching a stop x of a
// lower rank -- the run from x the same outcome)
theorem g.seg_split(l o. b, l. tr, l. pt, l. q, l. v, l. m, l, r):
  (all x y. v(x) -> b(x, ok(y, empty)) -> v(y) && (g.tr_le(tr(x), tr(y)) || (all t. t in univ(1) -> b(x, diverge(t))))) ->
  (all x y. v(x) -> q(x) -> b(x, ok(y, empty)) -> int_lt(m(y), m(x)) && (!pt(y) -> q(y))) ->
  (all x. v(x) -> m(x) in omega) ->
  (all x. v(x) -> tr(x) in univ(1)) ->
  v(l) -> q(l) -> while_rel(l, l. true, l y. b(l, y), l. tr(l), r) ->
  (b(l, r) && !is_ok(r)) ||
  (ex l2. b(l, ok(l2, empty)) && while_fin_rel(l2, l. true, l y. (pt(l) && y = pair(3, l)) || (!pt(l) && b(l, y)), r) && !is_ok(r)) ||
  (ex l2 x. b(l, ok(l2, empty)) && while_fin_rel(l2, l. true, l y. (pt(l) && y = pair(3, l)) || (!pt(l) && b(l, y)), pair(3, x)) &&
    pt(x) && v(x) && int_lt(m(x), m(l)) && while_rel(x, l. true, l y. b(l, y), l. tr(l), r))
proof
  assume h1 hq hm htu vl ql hw
  let B(x, y) := (pt(x) && y = pair(3, x)) || (!pt(x) && b(x, y))
  have inv: all x y. v(x) -> b(x, ok(y, empty)) -> v(y) proof
    fix x y
    assume vx bx
    show by taut(mp(all_elim(h1, {x}, {y}), vx, bx))
  qed
  have zo: 0 in omega := rewrite(sym(lit_zero), omega_zero)
  have o1: 1 in omega by arith(zo)
  have runs: (ex n f. n in omega && is_fun(f) && dom(f) = succ(n) && app(f, empty) = l &&
      (all i. i in n -> true && b(app(f, i), ok(app(f, succ(i)), empty))) &&
      ((!true && r = ok(app(f, n), empty)) || (true && b(app(f, n), r) && !is_ok(r)))) ||
    (ex f. is_fun(f) && dom(f) = omega && app(f, empty) = l &&
      (all i. i in omega -> true && b(app(f, i), ok(app(f, succ(i)), empty))) &&
      r = diverge(trace_limit(i. tr(app(f, i))))) by taut(expand(hw, while_rel))
  // (the stopped run to the first stop c, its rank lower, the rest's
  // run given: the third case)
  have atstop: all f c. app(f, empty) = l -> c in omega -> int_lt(0, c) -> pt(app(f, c)) ->
      (all i. i in omega -> int_lt(i, c) -> v(app(f, i)) && b(app(f, i), ok(app(f, int_add(i, 1)), empty))) ->
      (all i. i in omega -> int_lt(0, i) -> int_lt(i, c) -> !pt(app(f, i))) ->
      v(app(f, c)) -> while_rel(app(f, c), l. true, l y. b(l, y), l. tr(l), r) ->
      ex l2 x. b(l, ok(l2, empty)) && while_fin_rel(l2, l. true, l y. B(l, y), pair(3, x)) &&
        pt(x) && v(x) && int_lt(m(x), m(l)) && while_rel(x, l. true, l y. b(l, y), l. tr(l), r) proof
    fix f c
    assume hf0 co c0 pc hst nb vc rest
    have q0: q(app(f, 0)) := subst({y. q(app(f, y))}, sym(lit_zero), rewrite(sym(hf0), ql))
    have sq := mp(g.stretch_q[b := y z. b(y, z), pt := y. pt(y), q := y. q(y), v := y. v(y), m := y. m(y), f := f, c := c], hq, co, q0, hst, nb)
    have dcs: all i. i in omega -> int_le(0, i) -> int_lt(i, c) -> int_lt(m(app(f, int_add(i, 1))), m(app(f, i))) proof
      fix i
      assume io il ic
      show by taut(mp(all_elim(sq, {i}), io, ic))
    qed
    have dc := mp(g.desc_chain[M := i. m(app(f, i)), a := 0, c := c], zo, co, c0, dcs)
    have ml: int_lt(m(app(f, c)), m(l)) := rewrite(hf0, subst({y. int_lt(m(app(f, c)), m(app(f, y)))}, lit_zero, dc))
    have sgs: all i. i in omega -> int_le(1, i) -> int_lt(i, c) -> !pt(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty)) proof
      fix i
      assume io il ic
      have np := mp(all_elim(nb, {i}), io, (int_lt(0, i) by arith(io, il)), ic)
      have bi: b(app(f, i), ok(app(f, int_add(i, 1)), empty)) by taut(mp(all_elim(hst, {i}), io, ic))
      have es: succ(i) = int_add(i, 1) by arith(io)
      show by taut(np, rewrite(sym(es), bi))
    qed
    have sg := mp(g.seg_wfr[p := y. pt(y), b := y z. b(y, z), f := f, a := 1, c := c], o1, co, (int_le(1, c) by arith(co, c0)), sgs, pc)
    have b0a: b(app(f, 0), ok(app(f, int_add(0, 1)), empty)) by taut(mp(all_elim(hst, {0}), zo, c0))
    have e01: int_add(0, 1) = 1 by arith()
    have b0b := rewrite(e01, b0a)
    have b0: b(l, ok(app(f, 1), empty)) := rewrite(hf0, subst({y. b(app(f, y), ok(app(f, 1), empty))}, lit_zero, b0b))
    have e1: ex x. b(l, ok(app(f, 1), empty)) && while_fin_rel(app(f, 1), l. true, l y. B(l, y), pair(3, x)) &&
        pt(x) && v(x) && int_lt(m(x), m(l)) && while_rel(x, l. true, l y. b(l, y), l. tr(l), r) by ex_intro({app(f, c)}, taut(b0, sg, pc, vc, ml, rest))
    show by ex_intro({app(f, 1)}, e1)
  qed
  // finitely many iterations
  have fin: (ex n f. n in omega && is_fun(f) && dom(f) = succ(n) && app(f, empty) = l &&
      (all i. i in n -> true && b(app(f, i), ok(app(f, succ(i)), empty))) &&
      ((!true && r = ok(app(f, n), empty)) || (true && b(app(f, n), r) && !is_ok(r)))) ->
      (b(l, r) && !is_ok(r)) ||
      (ex l2. b(l, ok(l2, empty)) && while_fin_rel(l2, l. true, l y. B(l, y), r) && !is_ok(r)) ||
      (ex l2 x. b(l, ok(l2, empty)) && while_fin_rel(l2, l. true, l y. B(l, y), pair(3, x)) &&
        pt(x) && v(x) && int_lt(m(x), m(l)) && while_rel(x, l. true, l y. b(l, y), l. tr(l), r)) proof
    assume e
    obtain n f, hn hfun hdom hf0 hst hend from e
    have hbn: b(app(f, n), r) by taut(hend)
    have hnr: !is_ok(r) by taut(hend)
    have stp: all i. i in omega -> int_lt(i, n) -> v(app(f, i)) && b(app(f, i), ok(app(f, int_add(i, 1)), empty)) proof
      fix i
      assume io il
      have im: i in n by arith(io, il, hn)
      have es: succ(i) = int_add(i, 1) by arith(io)
      have bi: b(app(f, i), ok(app(f, succ(i)), empty)) by taut(mp(all_elim(hst, {i}), im))
      have q0: v(app(f, empty)) := rewrite(sym(hf0), vl)
      have vi := mp(while_path_inv[c := l. true, b := l y. b(l, y), q := l. v(l), f := f, n := n, k := i], hn, hst, q0, inv, io, (int_le(i, n) by arith(io, il)))
      show by taut(vi, rewrite(es, bi))
    qed
    have z: n = 0 -> b(l, r) && !is_ok(r) proof
      assume e0
      have ee: n = empty := rewrite(lit_zero, e0)
      have fn: app(f, n) = l := subst({y. app(f, y) = l}, sym(ee), hf0)
      show by taut(rewrite(fn, hbn), hnr)
    qed
    have s: int_lt(0, n) -> (ex l2. b(l, ok(l2, empty)) && while_fin_rel(l2, l. true, l y. B(l, y), r) && !is_ok(r)) ||
        (ex l2 x. b(l, ok(l2, empty)) && while_fin_rel(l2, l. true, l y. B(l, y), pair(3, x)) &&
          pt(x) && v(x) && int_lt(m(x), m(l)) && while_rel(x, l. true, l y. b(l, y), l. tr(l), r)) proof
      assume n0
      have b0a: b(app(f, 0), ok(app(f, int_add(0, 1)), empty)) by taut(mp(all_elim(stp, {0}), zo, n0))
      have e01: int_add(0, 1) = 1 by arith()
      have b0: b(l, ok(app(f, 1), empty)) := rewrite(hf0, subst({y. b(app(f, y), ok(app(f, 1), empty))}, lit_zero, rewrite(e01, b0a)))
      have yes: (ex q8. q8 in omega && int_lt(0, q8) && pt(app(f, q8)) && int_le(q8, n)) -> ex l2 x. b(l, ok(l2, empty)) && while_fin_rel(l2, l. true, l y. B(l, y), pair(3, x)) &&
          pt(x) && v(x) && int_lt(m(x), m(l)) && while_rel(x, l. true, l y. b(l, y), l. tr(l), r) proof
        assume ew
        obtain q8, hw8 from ew
        have wo: q8 in omega by taut(hw8)
        have jw: int_lt(0, q8) by taut(hw8)
        have pw: pt(app(f, q8)) by taut(hw8)
        have wn: int_le(q8, n) by taut(hw8)
        have es2: ex c. c in omega && int_lt(0, c) && pt(app(f, c)) by ex_intro({q8}, taut(wo, jw, pw))
        have fs := mp(g.first_stop[p := y. pt(y), f := f, j := 0], zo, es2)
        obtain c, hcs from fs
        have co: c in omega by taut(hcs)
        have c0: int_lt(0, c) by taut(hcs)
        have pc: pt(app(f, c)) by taut(hcs)
        have nb: all i. i in omega -> int_lt(0, i) -> int_lt(i, c) -> !pt(app(f, i)) by taut(hcs)
        have cw: int_lt(q8, c) -> false proof
          assume wc
          have np := mp(all_elim(nb, {q8}), wo, jw, wc)
          show by taut(np, pw)
        qed
        have cn: int_le(c, n) by arith(cw, wn, co, wo)
        have hst2: all i. i in omega -> int_lt(i, c) -> v(app(f, i)) && b(app(f, i), ok(app(f, int_add(i, 1)), empty)) proof
          fix i
          assume io ic
          show := mp(all_elim(stp, {i}), io, (int_lt(i, n) by arith(io, ic, cn)))
        qed
        have q0: v(app(f, empty)) := rewrite(sym(hf0), vl)
        have vc := mp(while_path_inv[c := l. true, b := l y. b(l, y), q := l. v(l), f := f, n := n, k := c], hn, hst, q0, inv, co, cn)
        have rest := mp(while_suffix[c := l. true, b := l y. b(l, y), tr := l. tr(l), r := r, f := f, n := n, k := c], hn, hst, hend, co, cn)
        show := mp(all_elim(atstop, {f}, {c}), hf0, co, c0, pc, hst2, nb, vc, rest)
      qed
      have no: !(ex q8. q8 in omega && int_lt(0, q8) && pt(app(f, q8)) && int_le(q8, n)) -> ex l2. b(l, ok(l2, empty)) && while_fin_rel(l2, l. true, l y. B(l, y), r) && !is_ok(r) proof
        assume nw
        have nb: all i. i in omega -> int_lt(0, i) -> int_le(i, n) -> !pt(app(f, i)) proof
          fix i
          assume io ji il
          have h: pt(app(f, i)) -> false proof
            assume pi
            have e: ex q8. q8 in omega && int_lt(0, q8) && pt(app(f, q8)) && int_le(q8, n) by ex_intro({i}, taut(io, ji, pi, il))
            show by taut(e, nw)
          qed
          show by taut(h)
        qed
        have sgs: all i. i in omega -> int_le(1, i) -> int_lt(i, n) -> !pt(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty)) proof
          fix i
          assume io il ic
          have np := mp(all_elim(nb, {i}), io, (int_lt(0, i) by arith(io, il)), (int_le(i, n) by arith(io, ic)))
          have bi: b(app(f, i), ok(app(f, succ(i)), empty)) by taut(mp(all_elim(hst, {i}), (i in n by arith(io, ic, hn))))
          show by taut(np, bi)
        qed
        have npn := mp(all_elim(nb, {n}), hn, n0, (int_le(n, n) by arith(hn)))
        have sg := mp(g.seg_end_wfr[p := y. pt(y), b := y z. b(y, z), f := f, a := 1, n := n, r := r], o1, hn, (int_le(1, n) by arith(hn, n0)), sgs, npn, hbn, hnr)
        show by ex_intro({app(f, 1)}, taut(b0, sg, hnr))
      qed
      show by taut(yes, no)
    qed
    show by taut(z, s, (n = 0 || int_lt(0, n) by arith(hn)))
  qed
  // infinitely many, the records growing: a stop reached (the rank falls on
  // the way), its rest the same divergence
  have inf: (ex f. is_fun(f) && dom(f) = omega && app(f, empty) = l &&
      (all i. i in omega -> true && b(app(f, i), ok(app(f, succ(i)), empty))) &&
      r = diverge(trace_limit(i. tr(app(f, i)))) && (all i. i in omega -> g.tr_le(tr(app(f, i)), tr(app(f, succ(i)))))) ->
      ex l2 x. b(l, ok(l2, empty)) && while_fin_rel(l2, l. true, l y. B(l, y), pair(3, x)) &&
        pt(x) && v(x) && int_lt(m(x), m(l)) && while_rel(x, l. true, l y. b(l, y), l. tr(l), r) proof
    assume e
    obtain f, hfun hdom hf0 hst hr ch1 from e
    have q0v: v(app(f, empty)) := rewrite(sym(hf0), vl)
    have vf: all i. i in omega -> v(app(f, i)) proof
      fix i
      assume io
      show := mp(while_path_inv_inf[c := l. true, b := l y. b(l, y), q := l. v(l), f := f, k := i], hst, q0v, inv, io)
    qed
    have stp: all i. i in omega -> v(app(f, i)) && b(app(f, i), ok(app(f, int_add(i, 1)), empty)) proof
      fix i
      assume io
      have es: succ(i) = int_add(i, 1) by arith(io)
      have bi: b(app(f, i), ok(app(f, succ(i)), empty)) by taut(mp(all_elim(hst, {i}), io))
      show by taut(mp(all_elim(vf, {i}), io), rewrite(es, bi))
    qed
    // (a stop after 0: else every state in the region, the rank falling
    // for ever)
    have ex0: ex c. c in omega && int_lt(0, c) && pt(app(f, c)) proof
      have imp: !(ex c. c in omega && int_lt(0, c) && pt(app(f, c))) -> false proof
        assume ns
        have nb: all i. i in omega -> int_lt(0, i) -> !pt(app(f, i)) proof
          fix i
          assume io ji
          have h: pt(app(f, i)) -> false proof
            assume pi
            have e1: ex c. c in omega && int_lt(0, c) && pt(app(f, c)) by ex_intro({i}, taut(io, ji, pi))
            show by taut(e1, ns)
          qed
          show by taut(h)
        qed
        have q0: q(app(f, 0)) := subst({y. q(app(f, y))}, sym(lit_zero), rewrite(sym(hf0), ql))
        have qall: all i. i in omega -> q(app(f, i)) proof
          have base: q(app(f, 0)) := q0
          have step: all i. i in omega -> q(app(f, i)) -> q(app(f, int_add(i, 1))) proof
            fix i
            assume io qi
            have si := mp(all_elim(stp, {i}), io)
            have c2 := mp(all_elim(hq, {app(f, i)}, {app(f, int_add(i, 1))}), (v(app(f, i)) by taut(si)), qi, (b(app(f, i), ok(app(f, int_add(i, 1)), empty)) by taut(si)))
            have np := mp(all_elim(nb, {int_add(i, 1)}), (int_add(i, 1) in omega by arith(io)), (int_lt(0, int_add(i, 1)) by arith(io)))
            show by taut(c2, np)
          qed
          show := mp(nat_ind[p := i. q(app(f, i))], base, step)
        qed
        have hst2: all i. i in omega -> (v(app(f, i)) && q(app(f, i))) && b(app(f, i), ok(app(f, succ(i)), empty)) proof
          fix i
          assume io
          have bi: b(app(f, i), ok(app(f, succ(i)), empty)) by taut(mp(all_elim(hst, {i}), io))
          show by taut(mp(all_elim(vf, {i}), io), mp(all_elim(qall, {i}), io), bi)
        qed
        have hdec: all x y. v(x) && q(x) -> !pt(x) -> b(x, ok(y, empty)) -> !pt(y) -> int_lt(m(y), m(x)) proof
          fix x y
          assume vqx px bx py
          show by taut(mp(all_elim(hq, {x}, {y}), (v(x) by taut(vqx)), (q(x) by taut(vqx)), bx))
        qed
        have hm2: all x. v(x) && q(x) -> m(x) in omega proof
          fix x
          assume vqx
          show := mp(all_elim(hm, {x}), (v(x) by taut(vqx)))
        qed
        have se := mp(g.stop_exists_inf[b := y z. b(y, z), p := y. pt(y), v := y. v(y) && q(y), m := y. m(y), f := f, j := 0], hst2, hdec, hm2, zo)
        show by taut(se, ns)
      qed
      show by taut(imp)
    qed
    have fs := mp(g.first_stop[p := y. pt(y), f := f, j := 0], zo, ex0)
    obtain c, hcs from fs
    have co: c in omega by taut(hcs)
    have c0: int_lt(0, c) by taut(hcs)
    have pc: pt(app(f, c)) by taut(hcs)
    have nb: all i. i in omega -> int_lt(0, i) -> int_lt(i, c) -> !pt(app(f, i)) by taut(hcs)
    have hst2: all i. i in omega -> int_lt(i, c) -> v(app(f, i)) && b(app(f, i), ok(app(f, int_add(i, 1)), empty)) proof
      fix i
      assume io ic
      show := mp(all_elim(stp, {i}), io)
    qed
    have chain := mp(g.chain_succ[T := i. tr(app(f, i))], ch1)
    have rest0 := mp(g.run_suffix_exact[c := l. true, b := l y. b(l, y), tr := l. tr(l), f := f, k := c], hst, chain, co)
    have rest := rewrite(sym(hr), rest0)
    show := mp(all_elim(atstop, {f}, {c}), hf0, co, c0, pc, hst2, nb, mp(all_elim(vf, {c}), co), rest)
  qed
  // infinitely many: the records growing (above), or a step undefined --
  // the finite run to it, diverging there with the run's trace (above)
  have inf2: (ex f. is_fun(f) && dom(f) = omega && app(f, empty) = l &&
      (all i. i in omega -> true && b(app(f, i), ok(app(f, succ(i)), empty))) &&
      r = diverge(trace_limit(i. tr(app(f, i))))) ->
      (b(l, r) && !is_ok(r)) ||
      (ex l2. b(l, ok(l2, empty)) && while_fin_rel(l2, l. true, l y. B(l, y), r) && !is_ok(r)) ||
      (ex l2 x. b(l, ok(l2, empty)) && while_fin_rel(l2, l. true, l y. B(l, y), pair(3, x)) &&
        pt(x) && v(x) && int_lt(m(x), m(l)) && while_rel(x, l. true, l y. b(l, y), l. tr(l), r)) proof
    assume e
    obtain f, hfun hdom hf0 hst hr from e
    have q0v: v(app(f, empty)) := rewrite(sym(hf0), vl)
    have vf: all i. i in omega -> v(app(f, i)) proof
      fix i
      assume io
      show := mp(while_path_inv_inf[c := l. true, b := l y. b(l, y), q := l. v(l), f := f, k := i], hst, q0v, inv, io)
    qed
    have gr1: all i. i in omega -> g.tr_le(tr(app(f, i)), tr(app(f, succ(i)))) || (all t. t in univ(1) -> b(app(f, i), diverge(t))) proof
      fix i
      assume io
      have bi: b(app(f, i), ok(app(f, succ(i)), empty)) by taut(mp(all_elim(hst, {i}), io))
      show by taut(mp(all_elim(h1, {app(f, i)}, {app(f, succ(i))}), mp(all_elim(vf, {i}), io), bi))
    qed
    have ub: (ex j. j in omega && (all t. t in univ(1) -> b(app(f, j), diverge(t)))) ->
        (b(l, r) && !is_ok(r)) ||
        (ex l2. b(l, ok(l2, empty)) && while_fin_rel(l2, l. true, l y. B(l, y), r) && !is_ok(r)) ||
        (ex l2 x. b(l, ok(l2, empty)) && while_fin_rel(l2, l. true, l y. B(l, y), pair(3, x)) &&
          pt(x) && v(x) && int_lt(m(x), m(l)) && while_rel(x, l. true, l y. b(l, y), l. tr(l), r)) proof
      assume ej
      obtain j, hj from ej
      have jo: j in omega by taut(hj)
      have uj: all t. t in univ(1) -> b(app(f, j), diverge(t)) by taut(hj)
      have tu0: all i. i in omega -> tr(app(f, i)) in univ(1) proof
        fix i
        assume io
        show := mp(all_elim(htu, {app(f, i)}), mp(all_elim(vf, {i}), io))
      qed
      have tu := mp(tr.tl_univ[t := i. tr(app(f, i))], tu0)
      have bj0 := mp(all_elim(uj, {trace_limit(i. tr(app(f, i)))}), tu)
      have bj: b(app(f, j), r) := rewrite(sym(hr), bj0)
      have nr: !is_ok(r) := rewrite(sym(hr), all_elim(g.not_ok_div, {trace_limit(i. tr(app(f, i)))}))
      have fw := mp(g.inf_fin[b := x y. b(x, y), f := f, j := j, r := r], hst, jo, bj, nr)
      show := mp(fin, rewrite(hf0, fw))
    qed
    have gro: !(ex j. j in omega && (all t. t in univ(1) -> b(app(f, j), diverge(t)))) ->
        ex l2 x. b(l, ok(l2, empty)) && while_fin_rel(l2, l. true, l y. B(l, y), pair(3, x)) &&
          pt(x) && v(x) && int_lt(m(x), m(l)) && while_rel(x, l. true, l y. b(l, y), l. tr(l), r) proof
      assume ne
      have ch1: all i. i in omega -> g.tr_le(tr(app(f, i)), tr(app(f, succ(i)))) proof
        fix i
        assume io
        have nu: !(all t. t in univ(1) -> b(app(f, i), diverge(t))) proof
          assume u
          have e2: ex j. j in omega && (all t. t in univ(1) -> b(app(f, j), diverge(t))) by ex_intro({i}, taut(io, u))
          show by taut(ne, e2)
        qed
        show by taut(mp(all_elim(gr1, {i}), io), nu)
      qed
      have e3: ex f2. is_fun(f2) && dom(f2) = omega && app(f2, empty) = l &&
          (all i. i in omega -> true && b(app(f2, i), ok(app(f2, succ(i)), empty))) &&
          r = diverge(trace_limit(i. tr(app(f2, i)))) && (all i. i in omega -> g.tr_le(tr(app(f2, i)), tr(app(f2, succ(i)))))
        by ex_intro({f}, taut(hfun, hdom, hf0, hst, hr, ch1))
      show := mp(inf, e3)
    qed
    show by taut(ub, gro)
  qed
  show by taut(runs, fin, inf2)
qed

// (a trip's claim with its stop's outcome as a cut's: J at the stop's
// state, the head's mark 4 or else 5 -- as g.loop_head's trips)
theorem g.trip_j(l o. b, l. pt, l. A, l. H, r o. k, x. v, x. hd, x o. G):
  (all x o. v(x) -> hd(x) ->
    (ex x8. b(x, x8) && ((ex l2. x8 = ok(l2, empty) && (ex x9. while_fin_rel(l2, l. true, l y. (pt(l) && y = pair(3, l)) || (!pt(l) && b(l, y)), x9) &&
      ((fst(x9) = 3 && ((A(snd(x9)) && o = pair(4, H(snd(x9)))) || (!A(snd(x9)) && o = pair(5, H(snd(x9)))))) || k(x9, o)))) ||
      (!is_ok(x8) && k(x8, o)))) -> G(x, o)) ->
  (all x o. v(x) -> hd(x) ->
    (ex x8. b(x, x8) && ((ex l2. x8 = ok(l2, empty) && (ex x9. while_fin_rel(l2, l. true, l y. (pt(l) && y = pair(3, l)) || (!pt(l) && b(l, y)), x9) &&
      ((fst(x9) = 3 && A(snd(x9)) && o = pair(4, H(snd(x9)))) || (fst(x9) = 3 && !A(snd(x9)) && o = pair(5, H(snd(x9)))) || k(x9, o)))) ||
      (!is_ok(x8) && k(x8, o)))) -> G(x, o))
proof
  assume hj
  fix x o
  assume vx hx r3
  obtain x8, hb hr from r3
  have c1: (ex l2. x8 = ok(l2, empty) && (ex x9. while_fin_rel(l2, l. true, l y. (pt(l) && y = pair(3, l)) || (!pt(l) && b(l, y)), x9) &&
      ((fst(x9) = 3 && A(snd(x9)) && o = pair(4, H(snd(x9)))) || (fst(x9) = 3 && !A(snd(x9)) && o = pair(5, H(snd(x9)))) || k(x9, o)))) ->
      (ex l2. x8 = ok(l2, empty) && (ex x9. while_fin_rel(l2, l. true, l y. (pt(l) && y = pair(3, l)) || (!pt(l) && b(l, y)), x9) &&
      ((fst(x9) = 3 && ((A(snd(x9)) && o = pair(4, H(snd(x9)))) || (!A(snd(x9)) && o = pair(5, H(snd(x9)))))) || k(x9, o)))) proof
    assume e
    obtain l2, h1 h2 from e
    obtain x9, hw hk from h2
    have e9: ex x9. while_fin_rel(l2, l. true, l y. (pt(l) && y = pair(3, l)) || (!pt(l) && b(l, y)), x9) &&
        ((fst(x9) = 3 && ((A(snd(x9)) && o = pair(4, H(snd(x9)))) || (!A(snd(x9)) && o = pair(5, H(snd(x9)))))) || k(x9, o))
      by ex_intro({x9}, taut(hw, hk))
    show by ex_intro({l2}, taut(h1, e9))
  qed
  have rj: ex x8. b(x, x8) && ((ex l2. x8 = ok(l2, empty) && (ex x9. while_fin_rel(l2, l. true, l y. (pt(l) && y = pair(3, l)) || (!pt(l) && b(l, y)), x9) &&
      ((fst(x9) = 3 && ((A(snd(x9)) && o = pair(4, H(snd(x9)))) || (!A(snd(x9)) && o = pair(5, H(snd(x9)))))) || k(x9, o)))) ||
      (!is_ok(x8) && k(x8, o)))
    by ex_intro({x8}, taut(hb, hr, c1))
  show := mp(all_elim(hj, {x}, {o}), vx, hx, rj)
qed

// ----------------------------------------------------------------------
//  The CFG ⊑ its structured form, with loops:a claim at every cut point
//  (inv relating its states to programs) for every run from it, finite or
//  infinite, by induction on a rank m of the labels -- falling at every
//  step but a loop's back edge (to a head hd from its loop's states, lp
//  their loop's head label, 0 outside the loops). Outside the loops a cut
//  point's segment claim (hs, as g.cut_acyclic's), the next cut point's
//  claim the induction's; at a loop head the loop theorem (g.loop_head),
//  each trip's claim (hb) and the exits' claims (hxk, by the induction),
//  the structured loop the head's program (hq).
theorem g.cut_loops(l o. b, l. tr, r o. k, l. pt, l. hd, h l. xp, l. lp, l. v, l. m, l q. inv, h l. H, h x y. bs, x. trs, h x9 o. ks):
  (all x y. v(x) -> b(x, ok(y, empty)) -> v(y) && (g.tr_le(tr(x), tr(y)) || (all t. t in univ(1) -> b(x, diverge(t))))) ->
  (all x y. v(x) -> b(x, ok(y, empty)) -> (hd(y) && lp(x) = fst(snd(y))) || int_lt(m(y), m(x))) ->
  (all x. v(x) -> m(x) in omega) ->
  (all x y. v(x) -> v(y) -> fst(snd(x)) = fst(snd(y)) -> m(x) = m(y)) ->
  (all x. v(x) -> hd(x) -> pt(x) && lp(x) = fst(snd(x)) && !(fst(snd(x)) = 0)) ->
  (all x y. v(x) -> b(x, ok(y, empty)) -> !pt(y) -> lp(y) = lp(x)) ->
  (all x y. v(x) -> !(lp(x) = 0) -> b(x, ok(y, empty)) -> pt(y) -> (hd(y) && fst(snd(y)) = lp(x)) || xp(lp(x), y)) ->
  (all h x. xp(h, x) -> pt(x) && !(hd(x) && fst(snd(x)) = h)) ->
  (all l q. inv(l, q) -> v(l) && pt(l)) ->
  (all l q. inv(l, q) -> !hd(l) -> lp(l) = 0) ->
  (all l q. inv(l, q) -> !hd(l) -> g.ref(o. ex x8. b(l, x8) &&
     ((ex l2. x8 = ok(l2, empty) && (ex x9. while_fin_rel(l2, x. true, x y. (pt(x) && y = pair(3, x)) || (!pt(x) && b(x, y)), x9) &&
        ((fst(x9) = 3 && (all q2. inv(snd(x9), q2) -> pair(fst(snd(x9)), o) in univ(1) -> runs(q2, fst(snd(x9)), o))) || k(x9, o)))) ||
      (!is_ok(x8) && k(x8, o))), q, fst(l))) ->
  (all l q o. inv(l, q) -> hd(l) -> (ex x9. while_rel(H(fst(snd(l)), l), x. true, x y. bs(fst(snd(l)), x, y), x. trs(x), x9) && ks(fst(snd(l)), x9, o)) ->
    pair(fst(l), o) in univ(1) -> runs(q, fst(l), o)) ->
  (all h x o. v(x) -> hd(x) && fst(snd(x)) = h ->
    (ex x8. b(x, x8) && ((ex l2. x8 = ok(l2, empty) && (ex x9. while_fin_rel(l2, l. true, l y. (pt(l) && y = pair(3, l)) || (!pt(l) && b(l, y)), x9) &&
      ((fst(x9) = 3 && (((hd(snd(x9)) && fst(snd(snd(x9))) = h) && o = pair(4, H(h, snd(x9)))) ||
         (!(hd(snd(x9)) && fst(snd(snd(x9))) = h) && o = pair(5, H(h, snd(x9)))))) || k(x9, o)))) ||
      (!is_ok(x8) && k(x8, o)))) ->
    pair(fst(x), o) in univ(1) ->
    ex x2. bs(h, H(h, x), x2) && ((x2 = ok(out_state(x2), empty) && o = pair(4, out_state(x2))) ||
      (!(x2 = ok(out_state(x2), empty)) && ((x2 = exc(out_state(x2), pair("brk", empty)) && o = pair(5, out_state(x2))) ||
        (!(x2 = exc(out_state(x2), pair("brk", empty))) && !(fst(x2) = 0) && ks(h, x2, o)))))) ->
  (all h x o. v(x) -> xp(h, x) -> (all q. inv(x, q) -> pair(fst(x), o) in univ(1) -> runs(q, fst(x), o)) -> pair(fst(x), o) in univ(1) ->
    ks(h, exc(H(h, x), pair("brk", empty)), o)) ->
  (all h x2 z. !ks(h, x2, pair(4, z)) && !ks(h, x2, pair(5, z))) ->
  (all r z. !k(r, pair(4, z)) && !k(r, pair(5, z))) ->
  (all h t o. k(diverge(t), o) -> ks(h, diverge(t), o)) ->
  (all h x. v(x) -> trs(H(h, x)) = tr(x)) ->
  (all h x. v(x) -> fst(x) in univ(1) && H(h, x) in univ(1)) ->
  (all x. v(x) -> tr(x) in univ(1)) ->
  all l q r o. inv(l, q) -> while_rel(l, x. true, x y. b(x, y), x. tr(x), r) -> k(r, o) -> pair(fst(l), o) in univ(1) -> runs(q, fst(l), o)
proof
  assume hl1 hl2 hm hml hh hcl hxs hxp hv hout hs hq hb hxk hko hk45 hkd htr hu htu
  let J(l) := all q r o. inv(l, q) -> while_rel(l, x. true, x y. b(x, y), x. tr(x), r) -> k(r, o) -> pair(fst(l), o) in univ(1) -> runs(q, fst(l), o)
  // one step: J at l from J at every state of a lower rank
  have core: all l. v(l) -> (all x. v(x) -> int_lt(m(x), m(l)) -> J(x)) -> J(l) proof
    fix l
    assume vl ih
    fix q r o
    assume hi hw hk hU
    // a loop head: the loop theorem for its loop
    have athead: hd(l) -> runs(q, fst(l), o) proof
      assume hl
      let h := fst(snd(l))
      have hhl := mp(all_elim(hh, {l}), vl, hl)
      have hn0: !(h = 0) by taut(hhl)
      have p2: all x y. v(x) -> lp(x) = h -> b(x, ok(y, empty)) -> !(hd(y) && fst(snd(y)) = h) -> int_lt(m(y), m(x)) proof
        fix x y
        assume vx lx bx ny
        have c := mp(all_elim(hl2, {x}, {y}), vx, bx)
        have c1: hd(y) && lp(x) = fst(snd(y)) -> false proof
          assume a
          have e: fst(snd(y)) = h := trans(sym((lp(x) = fst(snd(y)) by taut(a))), lx)
          show by taut(a, e, ny)
        qed
        show by taut(c, c1)
      qed
      have p4: all x. v(x) -> hd(x) && fst(snd(x)) = h -> pt(x) && m(x) = m(l) && lp(x) = h proof
        fix x
        assume vx hx
        have hxx := mp(all_elim(hh, {x}), vx, (hd(x) by taut(hx)))
        have eh: fst(snd(x)) = h by taut(hx)
        have mx := mp(all_elim(hml, {x}, {l}), vx, vl, eh)
        have lx: lp(x) = h := trans((lp(x) = fst(snd(x)) by taut(hxx)), eh)
        show by taut(hxx, mx, lx)
      qed
      have p5: all x y. v(x) -> lp(x) = h -> b(x, ok(y, empty)) -> (pt(y) -> (hd(y) && fst(snd(y)) = h) || xp(h, y)) && (!pt(y) -> lp(y) = h) proof
        fix x y
        assume vx lx bx
        have nz: !(lp(x) = 0) := rewrite(sym(lx), hn0)
        have a1: pt(y) -> (hd(y) && fst(snd(y)) = h) || xp(h, y) proof
          assume py
          have c := mp(all_elim(hxs, {x}, {y}), vx, nz, bx, py)
          show := rewrite(lx, c)
        qed
        have a2: !pt(y) -> lp(y) = h proof
          assume npy
          show := trans(mp(all_elim(hcl, {x}, {y}), vx, bx, npy), lx)
        qed
        show by taut(a1, a2)
      qed
      have p6: all x. xp(h, x) -> pt(x) && !(hd(x) && fst(snd(x)) = h) proof
        fix x
        show := all_elim(hxp, {h}, {x})
      qed
      have p7 := mp(g.trip_j[b := x y. b(x, y), pt := x. pt(x), A := z. hd(z) && fst(snd(z)) = h, H := z. H(h, z), k := r o. k(r, o), v := x. v(x),
          hd := x. hd(x) && fst(snd(x)) = h,
          G := x o. pair(fst(x), o) in univ(1) -> ex x2. bs(h, H(h, x), x2) && ((x2 = ok(out_state(x2), empty) && o = pair(4, out_state(x2))) ||
            (!(x2 = ok(out_state(x2), empty)) && ((x2 = exc(out_state(x2), pair("brk", empty)) && o = pair(5, out_state(x2))) ||
              (!(x2 = exc(out_state(x2), pair("brk", empty))) && !(fst(x2) = 0) && ks(h, x2, o)))))], all_elim(hb, {h}))
      have p8: all x r2 o2. v(x) -> xp(h, x) -> int_lt(m(x), m(l)) -> while_rel(x, l. true, l y. b(l, y), l. tr(l), r2) -> k(r2, o2) ->
          pair(fst(x), o2) in univ(1) -> ks(h, exc(H(h, x), pair("brk", empty)), o2) proof
        fix x r2 o2
        assume vx xx mx wx kx ux
        have jx := mp(all_elim(ih, {x}), vx, mx)
        have jq: all q. inv(x, q) -> pair(fst(x), o2) in univ(1) -> runs(q, fst(x), o2) proof
          fix q
          assume iq uq
          show := mp(all_elim(jx, {q}, {r2}, {o2}), iq, wx, kx, uq)
        qed
        show := mp(all_elim(hxk, {h}, {x}, {o2}), vx, xx, jq, ux)
      qed
      have lh := mp(g.loop_head[b := x y. b(x, y), tr := x. tr(x), k := r o. k(r, o), pt := x. pt(x), hd := x. hd(x) && fst(snd(x)) = h, xp := x. xp(h, x),
          w := x. lp(x) = h, v := x. v(x), m := x. m(x), mh := m(l), H := x. H(h, x), bs := x y. bs(h, x, y), trs := x. trs(x), ks := x9 o. ks(h, x9, o)],
        hl1, p2, hm, p4, p5, p6, p7, p8, all_elim(hko, {h}), hk45, all_elim(hkd, {h}), all_elim(htr, {h}), all_elim(hu, {h}), htu)
      have st := mp(all_elim(lh, {l}, {r}, {o}), vl, (hd(l) && fst(snd(l)) = h by taut(hl, refl({h}))), hw, hk, hU)
      show := mp(all_elim(hq, {l}, {q}, {o}), hi, hl, st, hU)
    qed
    // outside the loops: the segment to the next cut point
    have outside: !hd(l) -> runs(q, fst(l), o) proof
      assume nhl
      have l0: lp(l) = 0 := mp(all_elim(hout, {l}, {q}), hi, nhl)
      have hq0: all x y. v(x) -> lp(x) = 0 -> b(x, ok(y, empty)) -> int_lt(m(y), m(x)) && (!pt(y) -> lp(y) = 0) proof
        fix x y
        assume vx lx bx
        have c := mp(all_elim(hl2, {x}, {y}), vx, bx)
        have vy: v(y) by taut(mp(all_elim(hl1, {x}, {y}), vx, bx))
        have c1: hd(y) && lp(x) = fst(snd(y)) -> false proof
          assume a
          have hy := mp(all_elim(hh, {y}), vy, (hd(y) by taut(a)))
          have e: fst(snd(y)) = 0 := trans(sym((lp(x) = fst(snd(y)) by taut(a))), lx)
          show by taut(hy, e)
        qed
        have a1: int_lt(m(y), m(x)) by taut(c, c1)
        have a2: !pt(y) -> lp(y) = 0 proof
          assume npy
          show := trans(mp(all_elim(hcl, {x}, {y}), vx, bx, npy), lx)
        qed
        show by taut(a1, a2)
      qed
      have sp := mp(g.seg_split[b := x y. b(x, y), tr := x. tr(x), pt := x. pt(x), q := x. lp(x) = 0, v := x. v(x), m := x. m(x), l := l, r := r], hl1, hq0, hm, htu, vl, l0, hw)
      have g := expand(mp(all_elim(hs, {l}, {q}), hi, nhl), g.ref)
      let B(x, y) := (pt(x) && y = pair(3, x)) || (!pt(x) && b(x, y))
      let K(x9) := (fst(x9) = 3 && (all q2. inv(snd(x9), q2) -> pair(fst(snd(x9)), o) in univ(1) -> runs(q2, fst(snd(x9)), o))) || k(x9, o)
      have c1: b(l, r) && !is_ok(r) -> runs(q, fst(l), o) proof
        assume a
        have e: ex x8. b(l, x8) && ((ex l2. x8 = ok(l2, empty) && (ex x9. while_fin_rel(l2, x. true, x y. B(x, y), x9) && K(x9))) || (!is_ok(x8) && k(x8, o)))
          by ex_intro({r}, taut(a, hk))
        show := mp(all_elim(g, {o}), e, hU)
      qed
      have c2: (ex l2. b(l, ok(l2, empty)) && while_fin_rel(l2, x. true, x y. B(x, y), r) && !is_ok(r)) -> runs(q, fst(l), o) proof
        assume a
        obtain l2, hb2 hw2 hn2 from a
        have e9: ex x9. while_fin_rel(l2, x. true, x y. B(x, y), x9) && K(x9) by ex_intro({r}, taut(hw2, hk))
        have e2: ex l3. ok(l2, empty) = ok(l3, empty) && (ex x9. while_fin_rel(l3, x. true, x y. B(x, y), x9) && K(x9)) by ex_intro({l2}, taut(refl({ok(l2, empty)}), e9))
        have e: ex x8. b(l, x8) && ((ex l3. x8 = ok(l3, empty) && (ex x9. while_fin_rel(l3, x. true, x y. B(x, y), x9) && K(x9))) || (!is_ok(x8) && k(x8, o)))
          by ex_intro({ok(l2, empty)}, taut(hb2, e2))
        show := mp(all_elim(g, {o}), e, hU)
      qed
      have c3: (ex l2 x. b(l, ok(l2, empty)) && while_fin_rel(l2, x. true, x y. B(x, y), pair(3, x)) &&
          pt(x) && v(x) && int_lt(m(x), m(l)) && while_rel(x, x. true, x y. b(x, y), x. tr(x), r)) -> runs(q, fst(l), o) proof
        assume a
        obtain l2 x, hb2 hw2 hpx hvx hmx hrx from a
        have jx := mp(all_elim(ih, {x}), hvx, hmx)
        have jq: all q2. inv(x, q2) -> pair(fst(x), o) in univ(1) -> runs(q2, fst(x), o) proof
          fix q2
          assume iq uq
          show := mp(all_elim(jx, {q2}, {r}, {o}), iq, hrx, hk, uq)
        qed
        have s3: snd(pair(3, x)) = x by simp()
        have f3: fst(pair(3, x)) = 3 by simp()
        have kx: K(pair(3, x)) by taut(f3, rewrite(sym(s3), jq))
        have e9: ex x9. while_fin_rel(l2, x. true, x y. B(x, y), x9) && K(x9) by ex_intro({pair(3, x)}, taut(hw2, kx))
        have e2: ex l3. ok(l2, empty) = ok(l3, empty) && (ex x9. while_fin_rel(l3, x. true, x y. B(x, y), x9) && K(x9)) by ex_intro({l2}, taut(refl({ok(l2, empty)}), e9))
        have e: ex x8. b(l, x8) && ((ex l3. x8 = ok(l3, empty) && (ex x9. while_fin_rel(l3, x. true, x y. B(x, y), x9) && K(x9))) || (!is_ok(x8) && k(x8, o)))
          by ex_intro({ok(l2, empty)}, taut(hb2, e2))
        show := mp(all_elim(g, {o}), e, hU)
      qed
      show by taut(sp, c1, c2, c3)
    qed
    show by taut(athead, outside)
  qed
  // by induction on the rank
  have all_d: all d. d in omega -> all l. v(l) -> int_le(m(l), d) -> J(l) proof
    have base: all l. v(l) -> int_le(m(l), 0) -> J(l) proof
      fix l
      assume vl ml
      have vac: all x. v(x) -> int_lt(m(x), m(l)) -> J(x) proof
        fix x
        assume vx mx
        have m0 := mp(all_elim(hm, {x}), vx)
        have f: false by arith(m0, mx, ml)
        show by taut(f)
      qed
      show := mp(all_elim(core, {l}), vl, vac)
    qed
    have step: all d. d in omega -> (all l. v(l) -> int_le(m(l), d) -> J(l)) -> (all l. v(l) -> int_le(m(l), int_add(d, 1)) -> J(l)) proof
      fix d
      assume do ih
      fix l
      assume vl ml
      have lower: all x. v(x) -> int_lt(m(x), m(l)) -> J(x) proof
        fix x
        assume vx mx
        show := mp(all_elim(ih, {x}), vx, (int_le(m(x), d) by arith(mx, ml, do)))
      qed
      show := mp(all_elim(core, {l}), vl, lower)
    qed
    show by induct(base, step)
  qed
  fix l q r o
  assume hi hw hk hU
  have vl: v(l) by taut(mp(all_elim(hv, {l}, {q}), hi))
  have ml := mp(all_elim(hm, {l}), vl)
  have jl := mp(all_elim(all_d, {m(l)}), ml)
  show := mp(all_elim(mp(all_elim(jl, {l}), vl, (int_le(m(l), m(l)) by arith(ml))), {q}, {r}, {o}), hi, hw, hk, hU)
qed
