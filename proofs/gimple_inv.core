// Inversion of readable GIMPLE: every run of a program whose operations
// are defined is the one its operations' lemmas give. C2 (GIMPLE ⊑ a
// function's spec) runs the implementation backwards with these: from a
// run of the code, the outcome it must be.
//
//   checked after proofs/gimple.core (the calls' part: after proofs/translate_call.core)

// (a program's run: its relation)
theorem g.runs_elim(x y. r): all s o. runs(mkprog(x y. r(x, y)), s, o) -> r(s, o)
proof
  fix s o
  assume h
  show by simp(h)
qed

// (a let: its body at the value)
theorem g.letin_e(x. f): all a. letin(a, x. f(x)) -> f(a)
proof
  fix a
  assume h
  show h
qed

// (the outcomes of p from s: just O)
def g.det(p, s, O) := all o. runs(p, s, o) -> o = O

// a program's step, its program having one outcome ok(s1, v1): the
// continuation at s1, v1
theorem g.bind_inv(p, s1 v. k, s1 e. x, t. d): all s s1 v1. bind_rel(p, s, s1 v. k(s1, v), s1 e. x(s1, e), t. d(t)) -> g.det(p, s, ok(s1, v1)) -> k(s1, v1)
proof
  fix s s1 v1
  assume hb hd
  obtain o, hr hc from hb
  have eo := mp(all_elim(hd, {o}), hr)
  have c1: (ex s2 v. o = ok(s2, v) && k(s2, v)) -> k(s1, v1) proof
    assume h
    obtain s2 v, he hk from h
    have e2: ok(s2, v) = ok(s1, v1) := trans(sym(he), eo)
    have es: s2 = s1 && v = v1 by simp(e2)
    have e1 e3 := es
    show := rewrite(e3, rewrite(e1, hk))
  qed
  have c2: (ex s2 e. o = exc(s2, e) && x(s2, e)) -> k(s1, v1) proof
    assume h
    obtain s2 e, he _ from h
    have no: !(exc(s2, e) = ok(s1, v1)) by defs(simp(), exc, ok)
    show by taut(no, trans(sym(he), eo))
  qed
  have c3: (ex t. o = diverge(t) && d(t)) -> k(s1, v1) proof
    assume h
    obtain t, he _ from h
    have no: !(diverge(t) = ok(s1, v1)) by defs(simp(), diverge, ok)
    show by taut(no, trans(sym(he), eo))
  qed
  show by taut(hc, c1, c2, c3)
qed

theorem g.padd_det: all s p d. s in univ(1) -> p in bits(64) -> d in bits(64) ->
  int_le(0, int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), d))) ->
  int_lt(int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), d)), pow2(64)) ->
  g.det(gimple.padd(p, d), s, ok(s, int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), d))))
proof
  fix s p d
  assume hs hp hd h0 h1
  let R := int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), d))
  show proof
    fix o
    assume hr
    show by simp(expand(hr, gimple.padd, gimple.binop, gimple.fits, gimple.wrap, gimple.arith, runs, mkprog, bind_rel), hs, hp, hd, h0, h1)
  qed
qed

theorem g.mem_det: all s p off n w. s in univ(1) -> p in bits(64) -> off in bits(32) -> g.mem_defined(s, p, off, n, w) ->
  g.det(gimple.mem(p, off, n, w), s, ok(s, int_add(p, off)))
proof
  fix s p off n w
  assume hs hp ho hd
  have ol: int_lt(off, 4294967296) by simp(ho)
  have sv: gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), off) = off by defs(simp(ho, ol), gimple.sval)
  have d0 := apply(g.padd_det, {s}, {p}, {off}, hs, hp, simp(ho), simp(sv, hd, hp, ho), simp(sv, hd, hp, ho))
  have pd := rewrite(sv, d0)
  show proof
    fix o
    assume hr
    have h1 := apply(g.runs_elim, hr)
    obtain x2, hx2 hc from h1
    have e2: x2 = ok(pair(s, empty), empty) by taut(hx2, hd)
    have hc2 := rewrite(e2, hc)
    have b: bind_rel(gimple.padd(p, off), s, x3 x4. letin(x4, x5. ex x6. (!gimple.usable(app(x3, "vm"), app(x3, "objs"), x5, n, w) || (!!gimple.usable(app(x3, "vm"), app(x3, "objs"), x5, n, w) && x6 = ok(pair(x3, empty), empty))) &&
        ((fst(x6) = 0 && o = ok(fst(out_state(x6)), x5)) || ((((fst(x6) = 1 && fst(out_value(x6)) = "ret") && o = ok(fst(out_state(x6)), snd(out_value(x6)))) ||
          ((fst(x6) = 1 && fst(out_value(x6)) = "raise") && o = exc(fst(out_state(x6)), snd(out_value(x6))))) || (fst(x6) = 2 && o = diverge(snd(x6)))))),
        x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) by simp(hc2, keep(bind_rel, gimple.padd, gimple.usable))
    have k := apply(g.bind_inv, b, pd)
    show by simp(expand(k, letin), hd)
  qed
qed

// a program that ends with its one step's outcome (an accessor: a load
// returned): that step's
theorem g.ret_det(p): all s s1 v1. g.det(p, s, ok(s1, v1)) ->
  g.det(mkprog(x0 x1. bind_rel(p, x0, x2 x3. x1 = ok(x2, x3), x2 x3. x1 = exc(x2, x3), x2. x1 = diverge(x2))), s, ok(s1, v1))
proof
  fix s s1 v1
  assume hd
  show proof
    fix o
    assume hr
    have b := apply(g.runs_elim, hr)
    show := apply(g.bind_inv, b, hd)
  qed
qed

theorem g.ld64_det: all s p off. s in univ(1) -> p in bits(64) -> off in bits(32) -> g.mem_defined(s, p, off, 8, false) ->
  g.det(gimple.ld64(p, off), s, ok(s, bits_of_int(64, gimple.bytes_at(app(s, "vm"), int_add(p, off), 8))))
proof
  fix s p off
  assume hs hp ho hd
  have md := apply(g.mem_det, {s}, {p}, {off}, {8}, {false}, hs, hp, ho, hd)
  show proof
    fix o
    assume hr
    have b := apply(g.runs_elim, hr)
    show := apply(g.bind_inv, b, md)
  qed
qed

// GIMPLE's write of n bytes: its runs end with the bytes stored (the
// loop's invariant: the first i written; its variant n - i)
theorem g.write_det: all s a n v. a in bits(64) -> n in omega -> int_lt(n, 18446744073709551616) ->
  app(s, "vm") in x86_64_linux.Vm -> is_fun(s) -> "vm" in dom(s) ->
  g.det(gimple.write_bytes(a, n, v), s, ok(fn_update(s, "vm", fn_update(app(s, "vm"), "bytes", x86_64_linux.store_le(app(app(s, "vm"), "bytes"), a, n, v))), empty))
proof
  fix s a n v
  assume ha hn hn64 hvm hf hd
  let B := app(app(s, "vm"), "bytes")
  let ST(i) := fn_update(s, "vm", fn_update(app(s, "vm"), "bytes", x86_64_linux.store_le(B, a, i, v)))
  let P(l) := ex i. i in omega && int_le(i, n) && l = pair(ST(i), i)
  let M(l) := int_sub(n, snd(l))
  let BODY(l, o) := (int_lt(snd(l), n) && letin(snd(l), x6. letin(fn_update(fst(l), "vm", fn_update(app(fst(l), "vm"), "bytes",
      fn_update(app(app(fst(l), "vm"), "bytes"), bits_add(64, a, bits_of_int(64, x6)), bits_of_int(8, int_div(v, int_pow(256, x6)))))), x7. o = ok(pair(x7, int_add(snd(l), 1)), empty)))) ||
    (!int_lt(snd(l), n) && o = exc(pair(fst(l), snd(l)), pair("brk", empty)))
  have bf: is_fun(B) && dom(B) = bits(64) by simp(hvm)
  have vf: is_fun(app(s, "vm")) && "bytes" in dom(app(s, "vm")) by simp(hvm)
  have z := apply(x86.store_zero, {B}, {a}, {v}, taut(bf), taut(bf), ha)
  have e0v := mp(fn_update_same[f := app(s, "vm"), k := "bytes"], taut(vf), taut(vf))
  have e0s := mp(fn_update_same[f := s, k := "vm"], hf, hd)
  have s0: ST(0) = s by simp(z, e0v, e0s)
  have p0: P(pair(s, 0)) by ex_intro({0}, simp(hn, s0))
  have pm: all l. P(l) -> M(l) in omega proof
    fix l
    assume hp
    obtain i, hi from hp
    show by simp(hi, hn)
  qed
  // (a step from the invariant: the next byte written, the invariant again, closer to n)
  have nx: all l l2. P(l) -> true -> BODY(l, ok(l2, empty)) -> P(l2) && int_lt(M(l2), M(l)) proof
    fix l l2
    assume hp ht hb
    obtain i, io il le from hp
    have hb2 := rewrite(le, hb)
    have more: int_lt(i, n) -> P(l2) && int_lt(M(l2), M(l)) proof
      assume hl
      have i64: int_lt(i, 18446744073709551616) by arith(hl, hn64)
      have sst := apply(x86.store_step, {B}, {a}, {i}, {v}, ha, io, i64)
      have tw1 := fn_update_twice[f := app(s, "vm"), k := "bytes", a := x86_64_linux.store_le(B, a, i, v), b := x86_64_linux.store_le(B, a, int_add(i, 1), v)]
      have tw2 := fn_update_twice[f := s, k := "vm", a := fn_update(app(s, "vm"), "bytes", x86_64_linux.store_le(B, a, i, v)), b := fn_update(app(s, "vm"), "bytes", x86_64_linux.store_le(B, a, int_add(i, 1), v))]
      have e2: l2 = pair(ST(int_add(i, 1)), int_add(i, 1)) by simp(expand(hb2, letin), hl, sst, tw1, tw2)
      have p2: P(l2) by ex_intro({int_add(i, 1)}, simp(io, hl, e2))
      have m2: int_lt(M(l2), M(l)) by simp(e2, le, io)
      show by taut(p2, m2)
    qed
    have stop: !int_lt(i, n) -> P(l2) && int_lt(M(l2), M(l)) proof
      assume hl
      have no: !(ok(l2, empty) = exc(pair(ST(i), i), pair("brk", empty))) by defs(simp(), ok, exc)
      have f: false by simp(hb2, hl, no)
      show by taut(f)
    qed
    show by taut(more, stop)
  qed
  have ps: all l l2. P(l) -> true -> BODY(l, ok(l2, empty)) -> P(l2) proof
    fix l l2
    assume hp ht hb
    show by taut(mp(all_elim(nx, {l}, {l2}), hp, ht, hb))
  qed
  have md: all l l2. P(l) -> true -> BODY(l, ok(l2, empty)) -> int_lt(M(l2), M(l)) proof
    fix l l2
    assume hp ht hb
    show by taut(mp(all_elim(nx, {l}, {l2}), hp, ht, hb))
  qed
  show proof
    fix o
    assume hr
    have h1 := apply(g.letin_e, apply(g.runs_elim, hr))
    obtain r, hw ht from h1
    have wv := mp(while_var[l0 := pair(s, 0), c := l. true, b := l o. BODY(l, o), tr := l. fn_update(empty, "os.events", app(app(fst(l), "os"), "events")), r := r, p := l. P(l), m := l. M(l)],
      p0, ps, pm, md, hw)
    obtain l, hpl hcase from wv
    obtain i, io il le from hpl
    // (the loop left by the body: not an ok step, so the break at i = n)
    have hb: BODY(pair(ST(i), i), r) && !is_ok(r) proof
      have c1: (!true && r = ok(l, empty)) -> BODY(pair(ST(i), i), r) && !is_ok(r) by taut()
      have c2: (true && BODY(l, r) && !is_ok(r)) -> BODY(pair(ST(i), i), r) && !is_ok(r) proof
        assume h
        have _ hb3 hnk := h
        have r2 := rewrite(le, hb3)
        show by taut(r2, hnk)
      qed
      show by taut(hcase, c1, c2)
    qed
    have br: r = exc(pair(ST(i), i), pair("brk", empty)) && !int_lt(i, n) proof
      have bb nk := hb
      have c1: int_lt(i, n) -> false proof
        assume hl
        have ok1: ex x7. r = ok(pair(x7, int_add(i, 1)), empty) proof
          let NX := fn_update(ST(i), "vm", fn_update(app(ST(i), "vm"), "bytes", fn_update(app(app(ST(i), "vm"), "bytes"), bits_add(64, a, bits_of_int(64, i)), bits_of_int(8, int_div(v, int_pow(256, i))))))
          have b1: r = ok(pair(NX, int_add(i, 1)), empty) by simp(expand(bb, letin), hl)
          show by ex_intro({NX}, b1)
        qed
        obtain x7, hx7 from ok1
        have k: is_ok(r) by defs(ex_intro({pair(x7, int_add(i, 1))}, {empty}, hx7), is_ok)
        show by taut(k, nk)
      qed
      have nl: !int_lt(i, n) by taut(c1)
      show by simp(bb, nl)
    qed
    have ien: i = n by arith(il, br, io, hn)
    have re: r = exc(pair(ST(n), n), pair("brk", empty)) by simp(br, ien)
    show by simp(rewrite(re, ht), keep(gimple.write_bytes))
  qed
qed

theorem g.st64_det: all s p off v. s in univ(1) -> p in bits(64) -> off in bits(32) -> g.mem_defined(s, p, off, 8, true) ->
  app(s, "vm") in x86_64_linux.Vm -> is_fun(s) -> "vm" in dom(s) ->
  g.det(gimple.st64(p, off, v), s, ok(fn_update(s, "vm", fn_update(app(s, "vm"), "bytes", x86_64_linux.store_le(app(app(s, "vm"), "bytes"), int_add(p, off), 8, v))), empty))
proof
  fix s p off v
  assume hs hp ho hd hvm hf hdm
  have md := apply(g.mem_det, {s}, {p}, {off}, {8}, {true}, hs, hp, ho, hd)
  have ab: int_add(p, off) in bits(64) by simp(hd, hp, ho)
  have wd := apply(g.write_det, {s}, {int_add(p, off)}, {8}, {v}, ab, simp(), simp(), hvm, hf, hdm)
  show proof
    fix o
    assume hr
    have b := apply(g.runs_elim, hr)
    have b2 := apply(g.bind_inv, b, md)
    show := apply(g.bind_inv, b2, wd)
  qed
qed

// a program that ends after its one step, with no value: that step's state
theorem g.unit_det(p): all s s1 v1. g.det(p, s, ok(s1, v1)) ->
  g.det(mkprog(x0 x1. bind_rel(p, x0, x2 x3. x1 = ok(x2, empty), x2 x3. x1 = exc(x2, x3), x2. x1 = diverge(x2))), s, ok(s1, empty))
proof
  fix s s1 v1
  assume hd
  show proof
    fix o
    assume hr
    have b := apply(g.runs_elim, hr)
    show := apply(g.bind_inv, b, hd)
  qed
qed

// ----------------------------------------------------------------------
//  Picking a branch: an `if`'s disjunct by its guard, an outcome's case
//  (the guards' facts given, or simp() -- apply gives it the premise)

theorem g.pick: all a b c d. (a && b) || (c && d) -> a -> !c -> b
proof
  fix a b c d
  assume h ha hc
  show by taut(h, ha, hc)
qed

theorem g.pick2: all a b c d. (a && b) || (c && d) -> c -> !a -> d
proof
  fix a b c d
  assume h hc ha
  show by taut(h, hc, ha)
qed

theorem g.pick0: all a b c. (a && b) || c -> a -> !c -> b
proof
  fix a b c
  assume h ha hc
  show by taut(h, ha, hc)
qed

// (an outcome's parts)
theorem g.ok_state: all a b. out_state(ok(a, b)) = a && fst(ok(a, b)) = 0
proof
  fix a b
  show by defs(simp(), out_state, ok)
qed

// (a run's state and outcome: a set's pair)
theorem g.runs_univ(x y. r): all s o. runs(mkprog(x y. r(x, y)), s, o) -> pair(s, o) in univ(1)
proof
  fix s o
  assume h
  have u := unsel(expand(h, runs, mkprog))
  show by taut(u)
qed

// ----------------------------------------------------------------------
//  Contracts (layers/abi.sl): `overflow` read as outcomes

theorem ct.overflow_inv: all s o. app(s, "vm") in x86_64_linux.Vm -> runs(abi.overflow, s, o) -> ex v. v in x86_64_linux.Vm && o = exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty))
proof
  fix s o
  assume hv h
  have ne: ex x. x in x86_64_linux.Vm by ex_intro({app(s, "vm")}, hv)
  show by simp(h, ne)
qed

theorem ct.overflow_intro: all s v. v in x86_64_linux.Vm -> pair(s, exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty))) in univ(1) ->
  runs(abi.overflow, s, exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty)))
proof
  fix s v
  assume hv hu
  show by simp(hv, hu)
qed

// ----------------------------------------------------------------------
//  Calls: monotone in the callee, inverted under the callee's contract

// (a bind whose first step is refined: refined)
theorem g.bind_mono(p, q, s1 v. k, s1 e. x, t. d): all s. (all o. runs(p, s, o) -> runs(q, s, o)) ->
  bind_rel(p, s, s1 v. k(s1, v), s1 e. x(s1, e), t. d(t)) -> bind_rel(q, s, s1 v. k(s1, v), s1 e. x(s1, e), t. d(t))
proof
  fix s
  assume hm hb
  obtain o, hr hc from expand(hb, bind_rel)
  have hq := mp(all_elim(hm, {o}), hr)
  show by defs(ex_intro({o}, conj(hq, hc)), bind_rel)
qed

// GIMPLE's call (gimple.call), its callee's part c a parameter
abbrev gc.crel(c, x0, x1) := ex x2. (x2 = exc(pair(x0, empty), pair("raise", exc_val("stack_overflow", empty))) || x2 = ok(pair(x0, empty), empty)) && ((fst(x2) = 0 && bind_rel(c, fst(out_state(x2)), x3 x4. letin(x4, x5. ex x6. (x6 = exc(pair(x3, empty), pair("raise", exc_val("stack_overflow", empty))) || x6 = ok(pair(x3, empty), empty)) && ((fst(x6) = 0 && x1 = ok(fst(out_state(x6)), pair(fst(x5), snd(x5)))) || ((((fst(x6) = 1 && fst(out_value(x6)) = "ret") && x1 = ok(fst(out_state(x6)), snd(out_value(x6)))) || ((fst(x6) = 1 && fst(out_value(x6)) = "raise") && x1 = exc(fst(out_state(x6)), snd(out_value(x6))))) || (fst(x6) = 2 && x1 = diverge(snd(x6)))))), x3 x4. x1 = exc(x3, x4), x3. x1 = diverge(x3))) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && x1 = ok(fst(out_state(x2)), snd(out_value(x2)))) || ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && x1 = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && x1 = diverge(snd(x2)))))

// (the call's relation: monotone in the callee's part)
theorem gc.crel_mono(c1, c2): all s o. (all o2. runs(c1, s, o2) -> runs(c2, s, o2)) -> gc.crel(c1, s, o) -> gc.crel(c2, s, o)
proof
  fix s o
  assume hm h
  obtain x2, ha hb from h
  have run: fst(x2) = 0 && bind_rel(c1, fst(out_state(x2)), x3 x4. letin(x4, x5. ex x6. (x6 = exc(pair(x3, empty), pair("raise", exc_val("stack_overflow", empty))) || x6 = ok(pair(x3, empty), empty)) && ((fst(x6) = 0 && o = ok(fst(out_state(x6)), pair(fst(x5), snd(x5)))) || ((((fst(x6) = 1 && fst(out_value(x6)) = "ret") && o = ok(fst(out_state(x6)), snd(out_value(x6)))) || ((fst(x6) = 1 && fst(out_value(x6)) = "raise") && o = exc(fst(out_state(x6)), snd(out_value(x6))))) || (fst(x6) = 2 && o = diverge(snd(x6)))))), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) ->
      fst(x2) = 0 && bind_rel(c2, fst(out_state(x2)), x3 x4. letin(x4, x5. ex x6. (x6 = exc(pair(x3, empty), pair("raise", exc_val("stack_overflow", empty))) || x6 = ok(pair(x3, empty), empty)) && ((fst(x6) = 0 && o = ok(fst(out_state(x6)), pair(fst(x5), snd(x5)))) || ((((fst(x6) = 1 && fst(out_value(x6)) = "ret") && o = ok(fst(out_state(x6)), snd(out_value(x6)))) || ((fst(x6) = 1 && fst(out_value(x6)) = "raise") && o = exc(fst(out_state(x6)), snd(out_value(x6))))) || (fst(x6) = 2 && o = diverge(snd(x6)))))), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) proof
    assume hr
    have h0 hb1 := hr
    have es: fst(out_state(x2)) = s by simp(ha, h0)
    have hm2 := rewrite(sym(es), hm)
    have b2 := apply(g.bind_mono, hm2, hb1)
    show conj(h0, b2)
  qed
  show by ex_intro({x2}, taut(ha, hb, run))
qed

theorem gc.call_mono: all g G args s o. (all o2. runs(gimple.call_callee(g, args), s, o2) -> runs(gimple.call_callee(G, args), s, o2)) ->
  runs(gimple.call(g, args), s, o) -> runs(gimple.call(G, args), s, o)
proof
  fix g G args s o
  assume hm h
  have pu := apply(g.runs_univ, h)
  have r: gc.crel(gimple.call_callee(g, args), s, o) := apply(g.runs_elim, h)
  have r2 := apply(gc.crel_mono, hm, r)
  show by apply(tr.runs_intro, pu, r2)
qed

// (the callee's part of a call, the world sound: monotone in the callee,
// on the call's world)
theorem gc.cc_mono: all g G args s o. gc.sound(s) ->
  (all regs o2. gc.regs_ok(regs, args) -> runs(app(g, regs), s, o2) -> runs(app(G, regs), s, o2)) ->
  runs(gimple.call_callee(g, args), s, o) -> runs(gimple.call_callee(G, args), s, o)
proof
  fix g G args s o
  assume hs hm h
  have pu := apply(g.runs_univ, h)
  have r := expand(apply(g.runs_elim, h), any_rel)
  have c1: !(ex x2. x2 in list_type(bits(64)) && (seq_len(x2) = seq_len(args) && (all x3. x3 in omega -> int_lt(x3, seq_len(args)) -> app(x2, x3) in gimple.in_reg(fst(app(args, x3)), snd(app(args, x3)))))) -> runs(gimple.call_callee(G, args), s, o) proof
    assume hn
    show by apply(tr.runs_intro, pu, defs(taut(hn), any_rel))
  qed
  have c2: (ex x2. x2 in list_type(bits(64)) && (seq_len(x2) = seq_len(args) && (all x3. x3 in omega -> int_lt(x3, seq_len(args)) -> app(x2, x3) in gimple.in_reg(fst(app(args, x3)), snd(app(args, x3))))) && letin(x2, x3. ex x4. (!abi.thread_ok(app(s, "vm"), app(s, "fs_base")) || (!!abi.thread_ok(app(s, "vm"), app(s, "fs_base")) && x4 = ok(pair(s, empty), empty))) && ((fst(x4) = 0 && letin(app(fst(out_state(x4)), "objs"), x5. bind_rel(app(g, x3), fst(out_state(x4)), x6 x7. letin(x7, x8. letin(fn_update(x6, "objs", x5), x9. o = ok(x9, pair(fst(x8), snd(x8))))), x6 x7. o = exc(x6, x7), x6. o = diverge(x6)))) || ((((fst(x4) = 1 && fst(out_value(x4)) = "ret") && o = ok(fst(out_state(x4)), snd(out_value(x4)))) || ((fst(x4) = 1 && fst(out_value(x4)) = "raise") && o = exc(fst(out_state(x4)), snd(out_value(x4))))) || (fst(x4) = 2 && o = diverge(snd(x4))))))) -> runs(gimple.call_callee(G, args), s, o) proof
    assume he
    obtain rg, hd1 hd2 hl from he
    have hb := apply(g.letin_e, hl)
    obtain x4, ha hc from hb
    have e4: x4 = ok(pair(s, empty), empty) by taut(ha, hs)
    have bg: bind_rel(app(g, rg), s, x6 x7. letin(x7, x8. letin(fn_update(x6, "objs", app(s, "objs")), x9. o = ok(x9, pair(fst(x8), snd(x8))))), x6 x7. o = exc(x6, x7), x6. o = diverge(x6)) by simp(rewrite(e4, hc), keep(bind_rel))
    have ro: gc.regs_ok(rg, args) by taut(hd1, hd2)
    have hm2: all o2. runs(app(g, rg), s, o2) -> runs(app(G, rg), s, o2) proof
      fix o2
      assume h2
      show := mp(all_elim(hm, {rg}, {o2}), ro, h2)
    qed
    have bG := apply(g.bind_mono, hm2, bg)
    show by defs(simp(pu, hd1, hd2, bG, hs, keep(bind_rel, abi.thread_ok)), gimple.call_callee)
  qed
  show by taut(r, c1, c2)
qed

// GIMPLE's call, the world sound: monotone in the callee
theorem gc.call_mono2: all g G args s o. gc.sound(s) ->
  (all regs o2. gc.regs_ok(regs, args) -> runs(app(g, regs), s, o2) -> runs(app(G, regs), s, o2)) ->
  runs(gimple.call(g, args), s, o) -> runs(gimple.call(G, args), s, o)
proof
  fix g G args s o
  assume hs hm h
  have cm: all o2. runs(gimple.call_callee(g, args), s, o2) -> runs(gimple.call_callee(G, args), s, o2) proof
    fix o2
    assume h2
    show := apply(gc.cc_mono, hs, hm, h2)
  qed
  show := apply(gc.call_mono, cm, h)
qed

// (a call: an overflow at it, or the callee's part on)
theorem gc.call_cases: all g args s o. runs(gimple.call(g, args), s, o) -> o = exc(s, exc_val("stack_overflow", empty)) || gc.cc(g, args, s, o)
proof
  fix g args s o
  assume h
  show by simp(h, keep(gimple.call_callee, bind_rel))
qed

// (the callee's part, the world sound: the callee run on the world with
// some registers; its return with the caller's objects back, its raise,
// its divergence)
theorem gc.cc_inv: all g args s o. gc.sound(s) -> runs(gimple.call_callee(g, args), s, o) ->
  (ex regs. gc.regs_ok(regs, args)) ->
  ex regs o2. gc.regs_ok(regs, args) && runs(app(g, regs), s, o2) &&
    ((ex w4 r. o2 = ok(w4, r) && o = ok(gc.back(w4, s), pair(fst(r), snd(r)))) || (ex x e. o2 = exc(x, e) && o = exc(x, e)) || (ex t. o2 = diverge(t) && o = diverge(t)))
proof
  fix g args s o
  assume hs h he
  show by simp(h, hs, he, keep(abi.thread_ok))
qed

// (after the callee: the return, or an overflow)
theorem gc.aft_inv: all s1 v o. gc.aft(s1, v, o) -> o = ok(s1, pair(fst(v), snd(v))) || o = exc(s1, exc_val("stack_overflow", empty))
proof
  fix s1 v o
  assume h
  show by simp(h)
qed

// A call, the world sound and the callee's outcomes all satisfying Q (its
// contract, on the call's world): an overflow at the call; or the callee's
// return (Q of it) and then the caller's objects back, the return or an
// overflow; or its raise or divergence (Q of them)
theorem gc.call_inv(o2. Q): all g args s o. gc.sound(s) -> (ex regs. gc.regs_ok(regs, args)) ->
  (all regs o2. gc.regs_ok(regs, args) -> runs(app(g, regs), s, o2) -> Q(o2)) ->
  runs(gimple.call(g, args), s, o) ->
  o = exc(s, exc_val("stack_overflow", empty)) ||
  (ex w4 r. Q(ok(w4, r)) && (o = ok(gc.back(w4, s), pair(fst(r), snd(r))) || o = exc(gc.back(w4, s), exc_val("stack_overflow", empty)))) ||
  (ex x e. Q(exc(x, e)) && o = exc(x, e)) || (ex t. Q(diverge(t)) && o = diverge(t))
proof
  fix g args s o
  assume hs he hq h
  have c := apply(gc.call_cases, h)
  have k: gc.cc(g, args, s, o) ->
      (ex w4 r. Q(ok(w4, r)) && (o = ok(gc.back(w4, s), pair(fst(r), snd(r))) || o = exc(gc.back(w4, s), exc_val("stack_overflow", empty)))) ||
      (ex x e. Q(exc(x, e)) && o = exc(x, e)) || (ex t. Q(diverge(t)) && o = diverge(t)) proof
    assume hc
    obtain o1, hr hk from expand(hc, bind_rel)
    have ci := apply(gc.cc_inv, hs, hr, he)
    obtain regs o2, r1 r2 r3 hrun hcs from ci
    have hro: gc.regs_ok(regs, args) by taut(r1, r2, r3)
    have q := mp(all_elim(hq, {regs}, {o2}), hro, hrun)
    let OVF := exc_val("stack_overflow", empty)
    have ca: (ex w4 r. o2 = ok(w4, r) && o1 = ok(gc.back(w4, s), pair(fst(r), snd(r)))) ->
        (ex w4 r. Q(ok(w4, r)) && (o = ok(gc.back(w4, s), pair(fst(r), snd(r))) || o = exc(gc.back(w4, s), OVF))) proof
      assume ha
      obtain w4 r, e2 e1 from ha
      have qa := rewrite(e2, q)
      have oo: o = ok(gc.back(w4, s), pair(fst(r), snd(r))) || o = exc(gc.back(w4, s), OVF) by simp(hk, e1)
      show by ex_intro({w4}, {r}, taut(qa, oo))
    qed
    have cb: (ex x e. o2 = exc(x, e) && o1 = exc(x, e)) -> (ex x e. Q(exc(x, e)) && o = exc(x, e)) proof
      assume hb
      obtain x e, e2 e1 from hb
      have qb := rewrite(e2, q)
      have oo: o = exc(x, e) by simp(hk, e1)
      show by ex_intro({x}, {e}, taut(qb, oo))
    qed
    have cc: (ex t. o2 = diverge(t) && o1 = diverge(t)) -> (ex t. Q(diverge(t)) && o = diverge(t)) proof
      assume hd
      obtain t, e2 e1 from hd
      have qd := rewrite(e2, q)
      have oo: o = diverge(t) by simp(hk, e1)
      show by ex_intro({t}, taut(qd, oo))
    qed
    show by taut(hcs, ca, cb, cc)
  qed
  show by taut(c, k)
qed

// (the registers of a call with two 64-bit words a, b: a, b)
theorem gc.regs2: all regs a b. a in bits(64) -> b in bits(64) -> gc.regs_ok(regs, seq_concat(seq_one(gimple.arg(64, a)), seq_one(gimple.arg(64, b)))) ->
  regs in list_type(bits(64)) && seq_len(regs) = 2 && app(regs, 0) = a && app(regs, 1) = b
proof
  fix regs a b
  assume ha hb h
  have r1 r2 r3 := h
  have l2: seq_len(seq_concat(seq_one(gimple.arg(64, a)), seq_one(gimple.arg(64, b)))) = 2 by simp()
  have z0 := mp(all_elim(r3, {0}), simp(), (int_lt(0, seq_len(seq_concat(seq_one(gimple.arg(64, a)), seq_one(gimple.arg(64, b))))) by simp(l2)))
  have z1 := mp(all_elim(r3, {1}), simp(), (int_lt(1, seq_len(seq_concat(seq_one(gimple.arg(64, a)), seq_one(gimple.arg(64, b))))) by simp(l2)))
  have q0 := at({app(seq_concat(seq_one(gimple.arg(64, a)), seq_one(gimple.arg(64, b))), 0)})
  have q1 := at({app(seq_concat(seq_one(gimple.arg(64, a)), seq_one(gimple.arg(64, b))), 1)})
  have e0: app(regs, 0) = a by simp(expand(rewrite(q0, z0), gimple.in_reg, gimple.arg), ha)
  have e1: app(regs, 1) = b by simp(expand(rewrite(q1, z1), gimple.in_reg, gimple.arg), hb)
  show by taut(r1, trans(r2, l2), e0, e1)
qed

// ... and such registers exist
theorem gc.regs2_ex: all a b. a in bits(64) -> b in bits(64) ->
  ex regs. gc.regs_ok(regs, seq_concat(seq_one(gimple.arg(64, a)), seq_one(gimple.arg(64, b))))
proof
  fix a b
  assume ha hb
  let R := fn_build(2, i. ite(i = 0, a, b))
  let ARGS := seq_concat(seq_one(gimple.arg(64, a)), seq_one(gimple.arg(64, b)))
  have vt: all i. i in 2 -> ite(i = 0, a, b) in bits(64) proof
    fix i
    assume hi
    show by apply(ite_in, ha, hb)
  qed
  have rl := apply(tr.build_list, (2 in omega by simp()), vt)
  have ln: seq_len(R) = 2 by defs(simp(fn_build_dom[d := 2, v := i. ite(i = 0, a, b)]), seq_len)
  have l2: seq_len(ARGS) = 2 by simp()
  have el: all i. i in omega -> int_lt(i, seq_len(ARGS)) -> app(R, i) in gimple.in_reg(fst(app(ARGS, i)), snd(app(ARGS, i))) proof
    fix i
    assume hi hl
    have c: i = 0 || i = 1 by arith(hi, hl, l2)
    have c0: i = 0 -> app(R, i) in gimple.in_reg(fst(app(ARGS, i)), snd(app(ARGS, i))) proof
      assume e
      have q := at({app(ARGS, 0)})
      have r := mp(app_fn_build[d := 2, v := i. ite(i = 0, a, b), a := 0], simp())
      have g: a in gimple.in_reg(fst(gimple.arg(64, a)), snd(gimple.arg(64, a))) by defs(simp(ha), gimple.in_reg, gimple.arg)
      show by simp(e, q, r, g)
    qed
    have c1: i = 1 -> app(R, i) in gimple.in_reg(fst(app(ARGS, i)), snd(app(ARGS, i))) proof
      assume e
      have q := at({app(ARGS, 1)})
      have r := mp(app_fn_build[d := 2, v := i. ite(i = 0, a, b), a := 1], simp())
      have g: b in gimple.in_reg(fst(gimple.arg(64, b)), snd(gimple.arg(64, b))) by defs(simp(hb), gimple.in_reg, gimple.arg)
      show by simp(e, q, r, g)
    qed
    show by taut(c, c0, c1)
  qed
  show by ex_intro({R}, simp(rl, ln, l2, el))
qed

// (a choice from a nonempty domain: some value of it)
theorem g.any_e(x. d, x. k): (ex x. d(x)) -> any_rel(x. d(x), x. k(x)) -> ex x. d(x) && k(x)
proof
  assume hn h
  show by taut(hn, expand(h, any_rel))
qed
