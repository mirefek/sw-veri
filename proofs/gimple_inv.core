// Inversion of readable GIMPLE: every run of a program whose operations
// are defined is the one its operations' lemmas give. C2 (GIMPLE ⊑ a
// function's spec) runs the implementation backwards with these: from a
// run of the code, the outcome it must be.
//
//   checked after proofs/gimple.core (the calls' part: after proofs/translate_call.core)

// (a program's run: its relation)
theorem g.runs_elim(x y. r): all s o. runs(mkprog(x y. r(x, y)), s, o) -> r(s, o)
proof
  fix s o
  assume h
  show by simp(h)
qed

// (a let: its body at the value)
theorem g.letin_e(x. f): all a. letin(a, x. f(x)) -> f(a)
proof
  fix a
  assume h
  show h
qed

// (the outcomes of p from s: just O)
def g.det(p, s, O) := all o. runs(p, s, o) -> o = O

// a program's step, its program having one outcome ok(s1, v1): the
// continuation at s1, v1
theorem g.bind_inv(p, s1 v. k, s1 e. x, t. d): all s s1 v1. bind_rel(p, s, s1 v. k(s1, v), s1 e. x(s1, e), t. d(t)) -> g.det(p, s, ok(s1, v1)) -> k(s1, v1)
proof
  fix s s1 v1
  assume hb hd
  obtain o, hr hc from hb
  have eo := mp(all_elim(hd, {o}), hr)
  have c1: (ex s2 v. o = ok(s2, v) && k(s2, v)) -> k(s1, v1) proof
    assume h
    obtain s2 v, he hk from h
    have e2: ok(s2, v) = ok(s1, v1) := trans(sym(he), eo)
    have es: s2 = s1 && v = v1 by simp(e2)
    have e1 e3 := es
    show := rewrite(e3, rewrite(e1, hk))
  qed
  have c2: (ex s2 e. o = exc(s2, e) && x(s2, e)) -> k(s1, v1) proof
    assume h
    obtain s2 e, he _ from h
    have no: !(exc(s2, e) = ok(s1, v1)) by defs(simp(), exc, ok)
    show by taut(no, trans(sym(he), eo))
  qed
  have c3: (ex t. o = diverge(t) && d(t)) -> k(s1, v1) proof
    assume h
    obtain t, he _ from h
    have no: !(diverge(t) = ok(s1, v1)) by defs(simp(), diverge, ok)
    show by taut(no, trans(sym(he), eo))
  qed
  show by taut(hc, c1, c2, c3)
qed

theorem g.padd_det: all s p d. s in univ(1) -> p in bits(64) -> d in bits(64) ->
  int_le(0, int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), d))) ->
  int_lt(int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), d)), pow2(64)) ->
  g.det(gimple.padd(p, d), s, ok(s, int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), d))))
proof
  fix s p d
  assume hs hp hd h0 h1
  let R := int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), d))
  show proof
    fix o
    assume hr
    show by simp(expand(hr, gimple.padd, gimple.binop, gimple.fits, gimple.wrap, gimple.arith, runs, mkprog, bind_rel), hs, hp, hd, h0, h1)
  qed
qed

theorem g.mem_det: all s p off n w. s in univ(1) -> p in bits(64) -> off in bits(32) -> g.mem_defined(s, p, off, n, w) ->
  g.det(gimple.mem(p, off, n, w), s, ok(s, int_add(p, off)))
proof
  fix s p off n w
  assume hs hp ho hd
  have ol: int_lt(off, 4294967296) by simp(ho)
  have sv: gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), off) = off by defs(simp(ho, ol), gimple.sval)
  have d0 := apply(g.padd_det, {s}, {p}, {off}, hs, hp, simp(ho), simp(sv, hd, hp, ho), simp(sv, hd, hp, ho))
  have pd := rewrite(sv, d0)
  show proof
    fix o
    assume hr
    have h1 := apply(g.runs_elim, hr)
    obtain x2, hx2 hc from h1
    have e2: x2 = ok(pair(s, empty), empty) by taut(hx2, hd)
    have hc2 := rewrite(e2, hc)
    have b: bind_rel(gimple.padd(p, off), s, x3 x4. letin(x4, x5. ex x6. (!gimple.usable(x3.vm, x3.objs, x5, n, w) || (!!gimple.usable(x3.vm, x3.objs, x5, n, w) && x6 = ok(pair(x3, empty), empty))) &&
        ((fst(x6) = 0 && o = ok(fst(out_state(x6)), x5)) || ((((fst(x6) = 1 && fst(out_value(x6)) = "ret") && o = ok(fst(out_state(x6)), snd(out_value(x6)))) ||
          ((fst(x6) = 1 && fst(out_value(x6)) = "raise") && o = exc(fst(out_state(x6)), snd(out_value(x6))))) || (fst(x6) = 2 && o = diverge(snd(x6)))))),
        x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) by simp(hc2, keep(bind_rel, gimple.padd, gimple.usable))
    have k := apply(g.bind_inv, b, pd)
    show by simp(expand(k, letin), hd)
  qed
qed

// a program that ends with its one step's outcome (an accessor: a load
// returned): that step's
theorem g.ret_det(p): all s s1 v1. g.det(p, s, ok(s1, v1)) ->
  g.det(mkprog(x0 x1. bind_rel(p, x0, x2 x3. x1 = ok(x2, x3), x2 x3. x1 = exc(x2, x3), x2. x1 = diverge(x2))), s, ok(s1, v1))
proof
  fix s s1 v1
  assume hd
  show proof
    fix o
    assume hr
    have b := apply(g.runs_elim, hr)
    show := apply(g.bind_inv, b, hd)
  qed
qed

theorem g.ld64_det: all s p off. s in univ(1) -> p in bits(64) -> off in bits(32) -> g.mem_defined(s, p, off, 8, false) ->
  g.det(gimple.ld64(p, off), s, ok(s, bits_of_int(64, gimple.bytes_at(s.vm, int_add(p, off), 8))))
proof
  fix s p off
  assume hs hp ho hd
  have md := apply(g.mem_det, {s}, {p}, {off}, {8}, {false}, hs, hp, ho, hd)
  show proof
    fix o
    assume hr
    have b := apply(g.runs_elim, hr)
    show := apply(g.bind_inv, b, md)
  qed
qed

// GIMPLE's write of n bytes: its runs end with the bytes stored (the
// loop's invariant: the first i written; its variant n - i)
theorem g.write_det: all s a n v. a in bits(64) -> n in omega -> int_lt(n, 18446744073709551616) ->
  s.vm in x86_64_linux.Vm -> is_fun(s) -> "vm" in dom(s) ->
  g.det(gimple.write_bytes(a, n, v), s, ok(fn_update(s, "vm", fn_update(s.vm, "bytes", x86_64_linux.store_le(s.vm.bytes, a, n, v))), empty))
proof
  fix s a n v
  assume ha hn hn64 hvm hf hd
  let B := s.vm.bytes
  let ST(i) := fn_update(s, "vm", fn_update(s.vm, "bytes", x86_64_linux.store_le(B, a, i, v)))
  let P(l) := ex i. i in omega && int_le(i, n) && l = pair(ST(i), i)
  let M(l) := int_sub(n, snd(l))
  let BODY(l, o) := (int_lt(snd(l), n) && letin(snd(l), x6. letin(fn_update(fst(l), "vm", fn_update(fst(l).vm, "bytes",
      fn_update(fst(l).vm.bytes, bits_add(64, a, bits_of_int(64, x6)), bits_of_int(8, int_div(v, int_pow(256, x6)))))), x7. o = ok(pair(x7, int_add(snd(l), 1)), empty)))) ||
    (!int_lt(snd(l), n) && o = exc(pair(fst(l), snd(l)), pair("brk", empty)))
  have bf: is_fun(B) && dom(B) = bits(64) by simp(hvm)
  have vf: is_fun(s.vm) && "bytes" in dom(s.vm) by simp(hvm)
  have z := apply(x86.store_zero, {B}, {a}, {v}, taut(bf), taut(bf), ha)
  have e0v := mp(fn_update_same[f := s.vm, k := "bytes"], taut(vf), taut(vf))
  have e0s := mp(fn_update_same[f := s, k := "vm"], hf, hd)
  have s0: ST(0) = s by simp(z, e0v, e0s)
  have p0: P(pair(s, 0)) by ex_intro({0}, simp(hn, s0))
  have pm: all l. P(l) -> M(l) in omega proof
    fix l
    assume hp
    obtain i, hi from hp
    show by simp(hi, hn)
  qed
  // (a step from the invariant: the next byte written, the invariant again, closer to n)
  have nx: all l l2. P(l) -> true -> BODY(l, ok(l2, empty)) -> P(l2) && int_lt(M(l2), M(l)) proof
    fix l l2
    assume hp ht hb
    obtain i, io il le from hp
    have hb2 := rewrite(le, hb)
    have more: int_lt(i, n) -> P(l2) && int_lt(M(l2), M(l)) proof
      assume hl
      have i64: int_lt(i, 18446744073709551616) by arith(hl, hn64)
      have sst := apply(x86.store_step, {B}, {a}, {i}, {v}, ha, io, i64)
      have tw1 := fn_update_twice[f := s.vm, k := "bytes", a := x86_64_linux.store_le(B, a, i, v), b := x86_64_linux.store_le(B, a, int_add(i, 1), v)]
      have tw2 := fn_update_twice[f := s, k := "vm", a := fn_update(s.vm, "bytes", x86_64_linux.store_le(B, a, i, v)), b := fn_update(s.vm, "bytes", x86_64_linux.store_le(B, a, int_add(i, 1), v))]
      have e2: l2 = pair(ST(int_add(i, 1)), int_add(i, 1)) by simp(expand(hb2, letin), hl, sst, tw1, tw2)
      have p2: P(l2) by ex_intro({int_add(i, 1)}, simp(io, hl, e2))
      have m2: int_lt(M(l2), M(l)) by simp(e2, le, io)
      show by taut(p2, m2)
    qed
    have stop: !int_lt(i, n) -> P(l2) && int_lt(M(l2), M(l)) proof
      assume hl
      have no: !(ok(l2, empty) = exc(pair(ST(i), i), pair("brk", empty))) by defs(simp(), ok, exc)
      have f: false by simp(hb2, hl, no)
      show by taut(f)
    qed
    show by taut(more, stop)
  qed
  have ps: all l l2. P(l) -> true -> BODY(l, ok(l2, empty)) -> P(l2) proof
    fix l l2
    assume hp ht hb
    show by taut(mp(all_elim(nx, {l}, {l2}), hp, ht, hb))
  qed
  have md: all l l2. P(l) -> true -> BODY(l, ok(l2, empty)) -> int_lt(M(l2), M(l)) proof
    fix l l2
    assume hp ht hb
    show by taut(mp(all_elim(nx, {l}, {l2}), hp, ht, hb))
  qed
  show proof
    fix o
    assume hr
    have h1 := apply(g.letin_e, apply(g.runs_elim, hr))
    obtain r, hw ht from h1
    have wv := mp(while_var[l0 := pair(s, 0), c := l. true, b := l o. BODY(l, o), tr := l. fn_update(empty, "os.events", fst(l).os.events), r := r, p := l. P(l), m := l. M(l)],
      p0, ps, pm, md, hw)
    obtain l, hpl hcase from wv
    obtain i, io il le from hpl
    // (the loop left by the body: not an ok step, so the break at i = n)
    have hb: BODY(pair(ST(i), i), r) && !is_ok(r) proof
      have c1: (!true && r = ok(l, empty)) -> BODY(pair(ST(i), i), r) && !is_ok(r) by taut()
      have c2: (true && BODY(l, r) && !is_ok(r)) -> BODY(pair(ST(i), i), r) && !is_ok(r) proof
        assume h
        have _ hb3 hnk := h
        have r2 := rewrite(le, hb3)
        show by taut(r2, hnk)
      qed
      show by taut(hcase, c1, c2)
    qed
    have br: r = exc(pair(ST(i), i), pair("brk", empty)) && !int_lt(i, n) proof
      have bb nk := hb
      have c1: int_lt(i, n) -> false proof
        assume hl
        have ok1: ex x7. r = ok(pair(x7, int_add(i, 1)), empty) proof
          let NX := fn_update(ST(i), "vm", fn_update(ST(i).vm, "bytes", fn_update(ST(i).vm.bytes, bits_add(64, a, bits_of_int(64, i)), bits_of_int(8, int_div(v, int_pow(256, i))))))
          have b1: r = ok(pair(NX, int_add(i, 1)), empty) by simp(expand(bb, letin), hl)
          show by ex_intro({NX}, b1)
        qed
        obtain x7, hx7 from ok1
        have k: is_ok(r) by defs(ex_intro({pair(x7, int_add(i, 1))}, {empty}, hx7), is_ok)
        show by taut(k, nk)
      qed
      have nl: !int_lt(i, n) by taut(c1)
      show by simp(bb, nl)
    qed
    have ien: i = n by arith(il, br, io, hn)
    have re: r = exc(pair(ST(n), n), pair("brk", empty)) by simp(br, ien)
    show by simp(rewrite(re, ht), keep(gimple.write_bytes))
  qed
qed

// A GIMPLE loop (`loop { .. }`: its condition true, left by its body's
// break, return or failure): with an invariant p, kept by every ok step of
// the body, and a variant m, a natural decreasing at each, the loop's
// outcome r comes from a state with the invariant by a step that is not ok
// (the body b taken from a `step`'s fact: `let B(l, o) := loop_body(F)`)
theorem g.loop(l0, l o. b, l. tr, r, l. p, l. m): p(l0) -> (all l. p(l) -> m(l) in omega) ->
  (all l l2. p(l) -> b(l, ok(l2, empty)) -> p(l2) && int_lt(m(l2), m(l))) ->
  while_rel(l0, l. true, l o. b(l, o), l. tr(l), r) -> ex l. p(l) && b(l, r) && !is_ok(r)
proof
  assume h0 hm hs hw
  have ps: all l l2. p(l) -> true -> b(l, ok(l2, empty)) -> p(l2) proof
    fix l l2
    assume a1 a2 a3
    show by taut(mp(all_elim(hs, {l}, {l2}), a1, a3))
  qed
  have md: all l l2. p(l) -> true -> b(l, ok(l2, empty)) -> int_lt(m(l2), m(l)) proof
    fix l l2
    assume a1 a2 a3
    show by taut(mp(all_elim(hs, {l}, {l2}), a1, a3))
  qed
  have wv := mp(while_var[l0 := l0, c := l. true, b := l o. b(l, o), tr := l. tr(l), r := r, p := l. p(l), m := l. m(l)], h0, ps, hm, md, hw)
  obtain l, hp hc from wv
  have k1: (!true && r = ok(l, empty)) -> ex x. p(x) && b(x, r) && !is_ok(r) by taut()
  have k2: (true && b(l, r) && !is_ok(r)) -> ex x. p(x) && b(x, r) && !is_ok(r) proof
    assume h
    have _ hb hn := h
    show by ex_intro({l}, taut(hp, hb, hn))
  qed
  show by taut(hc, k1, k2)
qed

theorem g.st64_det: all s p off v. s in univ(1) -> p in bits(64) -> off in bits(32) -> g.mem_defined(s, p, off, 8, true) ->
  s.vm in x86_64_linux.Vm -> is_fun(s) -> "vm" in dom(s) ->
  g.det(gimple.st64(p, off, v), s, ok(fn_update(s, "vm", fn_update(s.vm, "bytes", x86_64_linux.store_le(s.vm.bytes, int_add(p, off), 8, v))), empty))
proof
  fix s p off v
  assume hs hp ho hd hvm hf hdm
  have md := apply(g.mem_det, {s}, {p}, {off}, {8}, {true}, hs, hp, ho, hd)
  have ab: int_add(p, off) in bits(64) by simp(hd, hp, ho)
  have wd := apply(g.write_det, {s}, {int_add(p, off)}, {8}, {v}, ab, simp(), simp(), hvm, hf, hdm)
  show proof
    fix o
    assume hr
    have b := apply(g.runs_elim, hr)
    have b2 := apply(g.bind_inv, b, md)
    show := apply(g.bind_inv, b2, wd)
  qed
qed


// ... of 1 and 4 bytes
theorem g.st8_det: all s p off v. s in univ(1) -> p in bits(64) -> off in bits(32) -> g.mem_defined(s, p, off, 1, true) ->
  s.vm in x86_64_linux.Vm -> is_fun(s) -> "vm" in dom(s) ->
  g.det(gimple.st8(p, off, v), s, ok(fn_update(s, "vm", fn_update(s.vm, "bytes", x86_64_linux.store_le(s.vm.bytes, int_add(p, off), 1, v))), empty))
proof
  fix s p off v
  assume hs hp ho hd hvm hf hdm
  have md := apply(g.mem_det, {s}, {p}, {off}, {1}, {true}, hs, hp, ho, hd)
  have ab: int_add(p, off) in bits(64) by simp(hd, hp, ho)
  have wd := apply(g.write_det, {s}, {int_add(p, off)}, {1}, {v}, ab, simp(), simp(), hvm, hf, hdm)
  show proof
    fix o
    assume hr
    have b := apply(g.runs_elim, hr)
    have b2 := apply(g.bind_inv, b, md)
    show := apply(g.bind_inv, b2, wd)
  qed
qed

theorem g.st32_det: all s p off v. s in univ(1) -> p in bits(64) -> off in bits(32) -> g.mem_defined(s, p, off, 4, true) ->
  s.vm in x86_64_linux.Vm -> is_fun(s) -> "vm" in dom(s) ->
  g.det(gimple.st32(p, off, v), s, ok(fn_update(s, "vm", fn_update(s.vm, "bytes", x86_64_linux.store_le(s.vm.bytes, int_add(p, off), 4, v))), empty))
proof
  fix s p off v
  assume hs hp ho hd hvm hf hdm
  have md := apply(g.mem_det, {s}, {p}, {off}, {4}, {true}, hs, hp, ho, hd)
  have ab: int_add(p, off) in bits(64) by simp(hd, hp, ho)
  have wd := apply(g.write_det, {s}, {int_add(p, off)}, {4}, {v}, ab, simp(), simp(), hvm, hf, hdm)
  show proof
    fix o
    assume hr
    have b := apply(g.runs_elim, hr)
    have b2 := apply(g.bind_inv, b, md)
    show := apply(g.bind_inv, b2, wd)
  qed
qed

theorem g.ld8_det: all s p off. s in univ(1) -> p in bits(64) -> off in bits(32) -> g.mem_defined(s, p, off, 1, false) ->
  g.det(gimple.ld8(p, off), s, ok(s, bits_of_int(8, gimple.bytes_at(s.vm, int_add(p, off), 1))))
proof
  fix s p off
  assume hs hp ho hd
  have md := apply(g.mem_det, {s}, {p}, {off}, {1}, {false}, hs, hp, ho, hd)
  show proof
    fix o
    assume hr
    have b := apply(g.runs_elim, hr)
    show := apply(g.bind_inv, b, md)
  qed
qed

// a program that ends after its one step, with no value: that step's state
theorem g.unit_det(p): all s s1 v1. g.det(p, s, ok(s1, v1)) ->
  g.det(mkprog(x0 x1. bind_rel(p, x0, x2 x3. x1 = ok(x2, empty), x2 x3. x1 = exc(x2, x3), x2. x1 = diverge(x2))), s, ok(s1, empty))
proof
  fix s s1 v1
  assume hd
  show proof
    fix o
    assume hr
    have b := apply(g.runs_elim, hr)
    show := apply(g.bind_inv, b, hd)
  qed
qed

// ----------------------------------------------------------------------
//  Picking a branch: an `if`'s disjunct by its guard, an outcome's case
//  (the guards' facts given, or simp() -- apply gives it the premise)

theorem g.pick: all a b c d. (a && b) || (c && d) -> a -> !c -> b
proof
  fix a b c d
  assume h ha hc
  show by taut(h, ha, hc)
qed

theorem g.pick2: all a b c d. (a && b) || (c && d) -> c -> !a -> d
proof
  fix a b c d
  assume h hc ha
  show by taut(h, hc, ha)
qed

theorem g.pick0: all a b c. (a && b) || c -> a -> !c -> b
proof
  fix a b c
  assume h ha hc
  show by taut(h, ha, hc)
qed

// (an outcome's parts)
theorem g.ok_state: all a b. out_state(ok(a, b)) = a && fst(ok(a, b)) = 0
proof
  fix a b
  show by defs(simp(), out_state, ok)
qed

// (a run's state and outcome: a set's pair)
theorem g.runs_univ(x y. r): all s o. runs(mkprog(x y. r(x, y)), s, o) -> pair(s, o) in univ(1)
proof
  fix s o
  assume h
  have u := unsel(expand(h, runs, mkprog))
  show by taut(u)
qed

// ----------------------------------------------------------------------
//  Contracts (layers/abi.sl): `overflow` read as outcomes

theorem ct.overflow_inv: all s o. s.vm in x86_64_linux.Vm -> runs(abi.overflow, s, o) -> ex v. v in x86_64_linux.Vm && o = exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty))
proof
  fix s o
  assume hv h
  have ne: ex x. x in x86_64_linux.Vm by ex_intro({s.vm}, hv)
  show by simp(h, ne)
qed

theorem ct.overflow_intro: all s v. v in x86_64_linux.Vm -> pair(s, exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty))) in univ(1) ->
  runs(abi.overflow, s, exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty)))
proof
  fix s v
  assume hv hu
  show by simp(hv, hu)
qed

// (a bind's dispatch on an outcome known: its continuation for it)
theorem g.disp_ok(s1 v. k, s1 e. x, t. d, a, b):
  ((ex s1 v. ok(a, b) = ok(s1, v) && k(s1, v)) || (ex s1 e. ok(a, b) = exc(s1, e) && x(s1, e))) || (ex t. ok(a, b) = diverge(t) && d(t)) -> k(a, b)
proof
  assume h
  have c1: (ex s1 v. ok(a, b) = ok(s1, v) && k(s1, v)) -> k(a, b) proof
    assume e
    obtain s1 v, he hk from e
    have e1 e2 := (s1 = a && v = b by simp(sym(he)))
    show := subst({y. k(y, b)}, e1, subst({y. k(s1, y)}, e2, hk))
  qed
  have c2: (ex s1 e. ok(a, b) = exc(s1, e) && x(s1, e)) -> k(a, b) proof
    assume e
    obtain s1 e3, he _ from e
    have f: false by simp(he)
    show by taut(f)
  qed
  have c3: (ex t. ok(a, b) = diverge(t) && d(t)) -> k(a, b) proof
    assume e
    obtain t, he _ from e
    have f: false by simp(he)
    show by taut(f)
  qed
  show by taut(h, c1, c2, c3)
qed

theorem g.disp_exc(s1 v. k, s1 e. x, t. d, a, b):
  ((ex s1 v. exc(a, b) = ok(s1, v) && k(s1, v)) || (ex s1 e. exc(a, b) = exc(s1, e) && x(s1, e))) || (ex t. exc(a, b) = diverge(t) && d(t)) -> x(a, b)
proof
  assume h
  have c1: (ex s1 v. exc(a, b) = ok(s1, v) && k(s1, v)) -> x(a, b) proof
    assume e
    obtain s1 v, he _ from e
    have f: false by simp(he)
    show by taut(f)
  qed
  have c2: (ex s1 e. exc(a, b) = exc(s1, e) && x(s1, e)) -> x(a, b) proof
    assume e
    obtain s1 e3, he hk from e
    have e1 e2 := (s1 = a && e3 = b by simp(sym(he)))
    show := subst({y. x(y, b)}, e1, subst({y. x(s1, y)}, e2, hk))
  qed
  have c3: (ex t. exc(a, b) = diverge(t) && d(t)) -> x(a, b) proof
    assume e
    obtain t, he _ from e
    have f: false by simp(he)
    show by taut(f)
  qed
  show by taut(h, c1, c2, c3)
qed

// (an overflow bound: its exception's continuation, at some memory)
theorem ct.bind_ovf(s1 v. k, s1 e. x, t. d): all s. s.vm in x86_64_linux.Vm ->
  bind_rel(abi.overflow, s, s1 v. k(s1, v), s1 e. x(s1, e), t. d(t)) ->
  ex v. v in x86_64_linux.Vm && x(fn_update(s, "vm", v), exc_val("stack_overflow", empty))
proof
  fix s
  assume hv hb
  obtain o1, hr hk from expand(hb, bind_rel)
  obtain v, hv2 he from apply(ct.overflow_inv, {s}, {o1}, hv, hr)
  have xx: x(fn_update(s, "vm", v), exc_val("stack_overflow", empty)) by simp(rewrite(he, hk))
  show by ex_intro({v}, taut(hv2, xx))
qed

// ----------------------------------------------------------------------
//  Calls: monotone in the callee, inverted under the callee's contract

// (a bind whose first step is refined: refined)
theorem g.bind_mono(p, q, s1 v. k, s1 e. x, t. d): all s. (all o. runs(p, s, o) -> runs(q, s, o)) ->
  bind_rel(p, s, s1 v. k(s1, v), s1 e. x(s1, e), t. d(t)) -> bind_rel(q, s, s1 v. k(s1, v), s1 e. x(s1, e), t. d(t))
proof
  fix s
  assume hm hb
  obtain o, hr hc from expand(hb, bind_rel)
  have hq := mp(all_elim(hm, {o}), hr)
  show by defs(ex_intro({o}, conj(hq, hc)), bind_rel)
qed

// GIMPLE's call (gimple.call), its callee's part c a parameter
abbrev gc.crel(c, x0, x1) := ex x2. (x2 = exc(pair(x0, empty), pair("raise", exc_val("stack_overflow", empty))) || x2 = ok(pair(x0, empty), empty)) && ((fst(x2) = 0 && bind_rel(c, fst(out_state(x2)), x3 x4. letin(x4, x5. ex x6. (x6 = exc(pair(x3, empty), pair("raise", exc_val("stack_overflow", empty))) || x6 = ok(pair(x3, empty), empty)) && ((fst(x6) = 0 && x1 = ok(fst(out_state(x6)), pair(fst(x5), snd(x5)))) || ((((fst(x6) = 1 && fst(out_value(x6)) = "ret") && x1 = ok(fst(out_state(x6)), snd(out_value(x6)))) || ((fst(x6) = 1 && fst(out_value(x6)) = "raise") && x1 = exc(fst(out_state(x6)), snd(out_value(x6))))) || (fst(x6) = 2 && x1 = diverge(snd(x6)))))), x3 x4. x1 = exc(x3, x4), x3. x1 = diverge(x3))) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && x1 = ok(fst(out_state(x2)), snd(out_value(x2)))) || ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && x1 = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && x1 = diverge(snd(x2)))))

// (the call's relation: monotone in the callee's part)
theorem gc.crel_mono(c1, c2): all s o. (all o2. runs(c1, s, o2) -> runs(c2, s, o2)) -> gc.crel(c1, s, o) -> gc.crel(c2, s, o)
proof
  fix s o
  assume hm h
  obtain x2, ha hb from h
  have run: fst(x2) = 0 && bind_rel(c1, fst(out_state(x2)), x3 x4. letin(x4, x5. ex x6. (x6 = exc(pair(x3, empty), pair("raise", exc_val("stack_overflow", empty))) || x6 = ok(pair(x3, empty), empty)) && ((fst(x6) = 0 && o = ok(fst(out_state(x6)), pair(fst(x5), snd(x5)))) || ((((fst(x6) = 1 && fst(out_value(x6)) = "ret") && o = ok(fst(out_state(x6)), snd(out_value(x6)))) || ((fst(x6) = 1 && fst(out_value(x6)) = "raise") && o = exc(fst(out_state(x6)), snd(out_value(x6))))) || (fst(x6) = 2 && o = diverge(snd(x6)))))), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) ->
      fst(x2) = 0 && bind_rel(c2, fst(out_state(x2)), x3 x4. letin(x4, x5. ex x6. (x6 = exc(pair(x3, empty), pair("raise", exc_val("stack_overflow", empty))) || x6 = ok(pair(x3, empty), empty)) && ((fst(x6) = 0 && o = ok(fst(out_state(x6)), pair(fst(x5), snd(x5)))) || ((((fst(x6) = 1 && fst(out_value(x6)) = "ret") && o = ok(fst(out_state(x6)), snd(out_value(x6)))) || ((fst(x6) = 1 && fst(out_value(x6)) = "raise") && o = exc(fst(out_state(x6)), snd(out_value(x6))))) || (fst(x6) = 2 && o = diverge(snd(x6)))))), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) proof
    assume hr
    have h0 hb1 := hr
    have es: fst(out_state(x2)) = s by simp(ha, h0)
    have hm2 := rewrite(sym(es), hm)
    have b2 := apply(g.bind_mono, hm2, hb1)
    show conj(h0, b2)
  qed
  show by ex_intro({x2}, taut(ha, hb, run))
qed

theorem gc.call_mono: all g G args s o. (all o2. runs(gimple.call_callee(g, args), s, o2) -> runs(gimple.call_callee(G, args), s, o2)) ->
  runs(gimple.call(g, args), s, o) -> runs(gimple.call(G, args), s, o)
proof
  fix g G args s o
  assume hm h
  have pu := apply(g.runs_univ, h)
  have r: gc.crel(gimple.call_callee(g, args), s, o) := apply(g.runs_elim, h)
  have r2 := apply(gc.crel_mono, hm, r)
  show by apply(tr.runs_intro, pu, r2)
qed

// (the callee's part of a call, the world sound: monotone in the callee,
// on the call's world)
theorem gc.cc_mono: all g G args s o. gc.sound(s) ->
  (all regs o2. gc.regs_ok(regs, args) -> runs(g[regs], s, o2) -> runs(G[regs], s, o2)) ->
  runs(gimple.call_callee(g, args), s, o) -> runs(gimple.call_callee(G, args), s, o)
proof
  fix g G args s o
  assume hs hm h
  have pu := apply(g.runs_univ, h)
  have r := expand(apply(g.runs_elim, h), any_rel)
  have c1: !(ex x2. x2 in list_type(bits(64)) && (seq_len(x2) = seq_len(args) && (all x3. x3 in omega -> int_lt(x3, seq_len(args)) -> x2[x3] in gimple.in_reg(fst(args[x3]), snd(args[x3]))))) -> runs(gimple.call_callee(G, args), s, o) proof
    assume hn
    show by apply(tr.runs_intro, pu, defs(taut(hn), any_rel))
  qed
  have c2: (ex x2. x2 in list_type(bits(64)) && (seq_len(x2) = seq_len(args) && (all x3. x3 in omega -> int_lt(x3, seq_len(args)) -> x2[x3] in gimple.in_reg(fst(args[x3]), snd(args[x3])))) && letin(x2, x3. ex x4. (!abi.thread_ok(s.vm, s.fs_base) || (!!abi.thread_ok(s.vm, s.fs_base) && x4 = ok(pair(s, empty), empty))) && ((fst(x4) = 0 && letin(fst(out_state(x4)).objs, x5. bind_rel(g[x3], fst(out_state(x4)), x6 x7. letin(x7, x8. letin(fn_update(x6, "objs", x5), x9. o = ok(x9, pair(fst(x8), snd(x8))))), x6 x7. o = exc(x6, x7), x6. o = diverge(x6)))) || ((((fst(x4) = 1 && fst(out_value(x4)) = "ret") && o = ok(fst(out_state(x4)), snd(out_value(x4)))) || ((fst(x4) = 1 && fst(out_value(x4)) = "raise") && o = exc(fst(out_state(x4)), snd(out_value(x4))))) || (fst(x4) = 2 && o = diverge(snd(x4))))))) -> runs(gimple.call_callee(G, args), s, o) proof
    assume he
    obtain rg, hd1 hd2 hl from he
    have hb := apply(g.letin_e, hl)
    obtain x4, ha hc from hb
    have e4: x4 = ok(pair(s, empty), empty) by taut(ha, hs)
    have bg: bind_rel(g[rg], s, x6 x7. letin(x7, x8. letin(fn_update(x6, "objs", s.objs), x9. o = ok(x9, pair(fst(x8), snd(x8))))), x6 x7. o = exc(x6, x7), x6. o = diverge(x6)) by simp(rewrite(e4, hc), keep(bind_rel))
    have ro: gc.regs_ok(rg, args) by taut(hd1, hd2)
    have hm2: all o2. runs(g[rg], s, o2) -> runs(G[rg], s, o2) proof
      fix o2
      assume h2
      show := mp(all_elim(hm, {rg}, {o2}), ro, h2)
    qed
    have bG := apply(g.bind_mono, hm2, bg)
    show by defs(simp(pu, hd1, hd2, bG, hs, keep(bind_rel, abi.thread_ok)), gimple.call_callee)
  qed
  show by taut(r, c1, c2)
qed

// GIMPLE's call, the world sound: monotone in the callee
theorem gc.call_mono2: all g G args s o. gc.sound(s) ->
  (all regs o2. gc.regs_ok(regs, args) -> runs(g[regs], s, o2) -> runs(G[regs], s, o2)) ->
  runs(gimple.call(g, args), s, o) -> runs(gimple.call(G, args), s, o)
proof
  fix g G args s o
  assume hs hm h
  have cm: all o2. runs(gimple.call_callee(g, args), s, o2) -> runs(gimple.call_callee(G, args), s, o2) proof
    fix o2
    assume h2
    show := apply(gc.cc_mono, hs, hm, h2)
  qed
  show := apply(gc.call_mono, cm, h)
qed

// (a call: an overflow at it, or the callee's part on)
theorem gc.call_cases: all g args s o. runs(gimple.call(g, args), s, o) -> o = exc(s, exc_val("stack_overflow", empty)) || gc.cc(g, args, s, o)
proof
  fix g args s o
  assume h
  show by simp(h, keep(gimple.call_callee, bind_rel))
qed

// (the callee's part, the world sound: the callee run on the world with
// some registers; its return with the caller's objects back, its raise,
// its divergence)
theorem gc.cc_inv: all g args s o. gc.sound(s) -> runs(gimple.call_callee(g, args), s, o) ->
  (ex regs. gc.regs_ok(regs, args)) ->
  ex regs o2. gc.regs_ok(regs, args) && runs(g[regs], s, o2) &&
    ((ex w4 r. o2 = ok(w4, r) && o = ok(gc.back(w4, s), pair(fst(r), snd(r)))) || (ex x e. o2 = exc(x, e) && o = exc(x, e)) || (ex t. o2 = diverge(t) && o = diverge(t)))
proof
  fix g args s o
  assume hs h he
  show by simp(h, hs, he, keep(abi.thread_ok))
qed

// (after the callee: the return, or an overflow)
theorem gc.aft_inv: all s1 v o. gc.aft(s1, v, o) -> o = ok(s1, pair(fst(v), snd(v))) || o = exc(s1, exc_val("stack_overflow", empty))
proof
  fix s1 v o
  assume h
  show by simp(h)
qed

// A call, the world sound and the callee's outcomes all satisfying Q (its
// contract, on the call's world): an overflow at the call; or the callee's
// return (Q of it) and then the caller's objects back, the return or an
// overflow; or its raise or divergence (Q of them)
theorem gc.call_inv(o2. Q): all g args s o. gc.sound(s) -> (ex regs. gc.regs_ok(regs, args)) ->
  (all regs o2. gc.regs_ok(regs, args) -> runs(g[regs], s, o2) -> Q(o2)) ->
  runs(gimple.call(g, args), s, o) ->
  o = exc(s, exc_val("stack_overflow", empty)) ||
  (ex w4 r. Q(ok(w4, r)) && (o = ok(gc.back(w4, s), pair(fst(r), snd(r))) || o = exc(gc.back(w4, s), exc_val("stack_overflow", empty)))) ||
  (ex x e. Q(exc(x, e)) && o = exc(x, e)) || (ex t. Q(diverge(t)) && o = diverge(t))
proof
  fix g args s o
  assume hs he hq h
  have c := apply(gc.call_cases, h)
  have k: gc.cc(g, args, s, o) ->
      (ex w4 r. Q(ok(w4, r)) && (o = ok(gc.back(w4, s), pair(fst(r), snd(r))) || o = exc(gc.back(w4, s), exc_val("stack_overflow", empty)))) ||
      (ex x e. Q(exc(x, e)) && o = exc(x, e)) || (ex t. Q(diverge(t)) && o = diverge(t)) proof
    assume hc
    obtain o1, hr hk from expand(hc, bind_rel)
    have ci := apply(gc.cc_inv, hs, hr, he)
    obtain regs o2, r1 r2 r3 hrun hcs from ci
    have hro: gc.regs_ok(regs, args) by taut(r1, r2, r3)
    have q := mp(all_elim(hq, {regs}, {o2}), hro, hrun)
    let OVF := exc_val("stack_overflow", empty)
    have ca: (ex w4 r. o2 = ok(w4, r) && o1 = ok(gc.back(w4, s), pair(fst(r), snd(r)))) ->
        (ex w4 r. Q(ok(w4, r)) && (o = ok(gc.back(w4, s), pair(fst(r), snd(r))) || o = exc(gc.back(w4, s), OVF))) proof
      assume ha
      obtain w4 r, e2 e1 from ha
      have qa := rewrite(e2, q)
      have oo: o = ok(gc.back(w4, s), pair(fst(r), snd(r))) || o = exc(gc.back(w4, s), OVF) by simp(hk, e1)
      show by ex_intro({w4}, {r}, taut(qa, oo))
    qed
    have cb: (ex x e. o2 = exc(x, e) && o1 = exc(x, e)) -> (ex x e. Q(exc(x, e)) && o = exc(x, e)) proof
      assume hb
      obtain x e, e2 e1 from hb
      have qb := rewrite(e2, q)
      have oo: o = exc(x, e) by simp(hk, e1)
      show by ex_intro({x}, {e}, taut(qb, oo))
    qed
    have cc: (ex t. o2 = diverge(t) && o1 = diverge(t)) -> (ex t. Q(diverge(t)) && o = diverge(t)) proof
      assume hd
      obtain t, e2 e1 from hd
      have qd := rewrite(e2, q)
      have oo: o = diverge(t) by simp(hk, e1)
      show by ex_intro({t}, taut(qd, oo))
    qed
    show by taut(hcs, ca, cb, cc)
  qed
  show by taut(c, k)
qed

// a call's arguments, registers for them existing (built along the list:
// `step` composes `gc.regs_one` and `gc.regs_cat` by the arguments' nesting)
abbrev gc.regs_for(args) := args in list_type(univ(1)) && (ex regs. gc.regs_ok(regs, args))

// (one argument x of w bits: the register x)
theorem gc.regs_one(w, x): w in omega -> int_le(w, 64) -> x in bits(w) -> gc.regs_for(seq_one(gimple.arg(w, x)))
proof
  assume hw hl hx
  let ARGS := seq_one(gimple.arg(w, x))
  let R := fn_build(1, i. x)
  have xo xl := (x in omega && int_lt(x, pow2(w)) by taut(unsel(expand(hx, bits))))
  have pl := mp(pow2_le[a := w, b := 64], hw, simp(), hl)
  have x64: x in bits(64) by defs(sel(taut(xo, (int_lt(x, pow2(64)) by arith(xl, pl)))), bits)
  have vt: all i. i in 1 -> x in bits(64) proof
    fix i
    assume _
    show x64
  qed
  have rl := apply(build_list, (1 in omega by simp()), vt)
  have ln: seq_len(R) = 1 by defs(simp(fn_build_dom[d := 1, v := i. x]), seq_len)
  have l1: seq_len(ARGS) = 1 by simp()
  have el: all i. i in omega -> int_lt(i, seq_len(ARGS)) -> R[i] in gimple.in_reg(fst(ARGS[i]), snd(ARGS[i])) proof
    fix i
    assume hi hil
    have e: i = 0 by arith(hi, hil, l1)
    have q := at({ARGS[0]})
    have r := mp(app_fn_build[d := 1, v := i. x, a := 0], simp())
    have g: x in gimple.in_reg(fst(gimple.arg(w, x)), snd(gimple.arg(w, x))) by defs(simp(x64), gimple.in_reg, gimple.arg)
    show by simp(e, q, r, g)
  qed
  have au: gimple.arg(w, x) in univ(1) by defs(simp(hw, xo), gimple.arg)
  have al: ARGS in list_type(univ(1)) := mp(all_elim(tr.seq_one_type, {gimple.arg(w, x)}, {univ(1)}), au)
  have ex: ex regs. gc.regs_ok(regs, ARGS) by ex_intro({R}, simp(rl, ln, l1, el))
  show by taut(al, ex)
qed

// (two lists of arguments: registers for both, one after the other)
theorem gc.regs_cat(a, b): gc.regs_for(a) -> gc.regs_for(b) -> gc.regs_for(seq_concat(a, b))
proof
  assume ha hb
  have al ea := ha
  have bl eb := hb
  obtain ra, hra from ea
  obtain rb, hrb from eb
  have ra1 ra2 ra3 := hra
  have rb1 rb2 rb3 := hrb
  let n := seq_len(a)
  let m := seq_len(b)
  have no: n in omega by arith(al)
  have mo: m in omega by arith(bl)
  let R := fn_build(int_add(n, m), i. ite(int_lt(i, n), ra[i], rb[int_sub(i, n)]))
  have nmo: int_add(n, m) in omega by arith(no, mo)
  have vt: all i. i in int_add(n, m) -> ite(int_lt(i, n), ra[i], rb[int_sub(i, n)]) in bits(64) proof
    fix i
    assume hi
    have i1 := mp(nat_elem[k := int_add(n, m), i := i], nmo, hi)
    have i2 := mp(nat_mem_lt[k := int_add(n, m), i := i], nmo, hi)
    have c1: int_lt(i, n) -> ite(int_lt(i, n), ra[i], rb[int_sub(i, n)]) in bits(64) proof
      assume h
      have r := mp(at_type[l := ra, t := bits(64), i := i], ra1, i1, arith(h, ra2))
      show by simp(h, r)
    qed
    have c2: !int_lt(i, n) -> ite(int_lt(i, n), ra[i], rb[int_sub(i, n)]) in bits(64) proof
      assume h
      have r := mp(at_type[l := rb, t := bits(64), i := int_sub(i, n)], rb1, arith(i1, h, no), arith(i2, h, rb2, no, mo))
      show by simp(h, r)
    qed
    show by taut(c1, c2)
  qed
  have rl :=apply(build_list, nmo, vt)
  have ln: seq_len(R) = int_add(n, m) by defs(simp(expand(fn_build_dom[d := int_add(n, m), v := i. ite(int_lt(i, n), ra[i], rb[int_sub(i, n)])], seq_len)), seq_len)
  have lc: seq_len(seq_concat(a, b)) = int_add(n, m) by arith(al, bl)
  have el: all i. i in omega -> int_lt(i, seq_len(seq_concat(a, b))) -> R[i] in gimple.in_reg(fst(seq_concat(a, b)[i]), snd(seq_concat(a, b)[i])) proof
    fix i
    assume hi hil
    have r := mp(app_fn_build[d := int_add(n, m), v := i. ite(int_lt(i, n), ra[i], rb[int_sub(i, n)]), a := i], mp(nat_lt_mem[k := i, n := int_add(n, m)], hi, nmo, rewrite(lc, hil)))
    have c1: int_lt(i, n) -> R[i] in gimple.in_reg(fst(seq_concat(a, b)[i]), snd(seq_concat(a, b)[i])) proof
      assume h
      have q := at({seq_concat(a, b)[i]}, al, bl, hi, h)
      have g := mp(all_elim(ra3, {i}), hi, h)
      show by simp(r, h, q, g)
    qed
    have c2: !int_lt(i, n) -> R[i] in gimple.in_reg(fst(seq_concat(a, b)[i]), snd(seq_concat(a, b)[i])) proof
      assume h
      let k := int_sub(i, n)
      have ko: k in omega by arith(hi, h, no)
      have kl: int_lt(k, m) by arith(hil, h, lc, no, mo)
      have ik: i = int_add(n, k) by arith(hi, h, no)
      have q := rewrite(sym(ik), at({seq_concat(a, b)[int_add(n, k)]}, al, bl, ko, kl))
      have g := mp(all_elim(rb3, {k}), ko, (int_lt(k, seq_len(b)) by arith(kl)))
      show by simp(r, h, q, g)
    qed
    show by taut(c1, c2)
  qed
  have cl: seq_concat(a, b) in list_type(univ(1)) := mp(all_elim(tr.concat_list, {a}, {b}, {univ(1)}), al, bl)
  have ex: ex regs. gc.regs_ok(regs, seq_concat(a, b)) by ex_intro({R}, simp(rl, ln, lc, el))
  show by taut(cl, ex)
qed

// (... so registers for them)
theorem gc.regs_get(a): gc.regs_for(a) -> ex regs. gc.regs_ok(regs, a)
proof
  assume h
  have _ e := h
  show e
qed

// the register of a w-bit argument x at i: x in its low w bits
theorem gc.reg_at(regs, args, i, w, x): gc.regs_ok(regs, args) -> i in omega -> int_lt(i, seq_len(args)) ->
  args[i] = gimple.arg(w, x) -> w in omega -> x in bits(w) -> bits_of_int(w, regs[i]) = x
proof
  assume h hi hil he hw hx
  have _ _ r3 := h
  have g := rewrite(he, mp(all_elim(r3, {i}), hi, hil))
  have m: int_mod(regs[i], int_pow(2, w)) = int_mod(x, int_pow(2, w)) by simp(expand(g, gimple.in_reg, gimple.arg))
  have xo xl := (x in omega && int_lt(x, int_pow(2, w)) by taut(unsel(expand(hx, bits, pow2))))
  have u := refl({int_mul(int_pow(2, w), int_div(x, int_pow(2, w)))})
  have u2 := refl({int_mul(int_pow(2, w), int_sub(int_div(x, int_pow(2, w)), 1))})
  have mx: int_mod(x, int_pow(2, w)) = x by arith(xo, xl, u, u2)
  show by defs(trans(m, mx), bits_of_int, pow2)
qed

// (the registers of a call with two 64-bit words a, b: a, b)
theorem gc.regs2: all regs a b. a in bits(64) -> b in bits(64) -> gc.regs_ok(regs, seq_concat(seq_one(gimple.arg(64, a)), seq_one(gimple.arg(64, b)))) ->
  regs in list_type(bits(64)) && seq_len(regs) = 2 && regs[0] = a && regs[1] = b
proof
  fix regs a b
  assume ha hb h
  have r1 r2 r3 := h
  have l2: seq_len(seq_concat(seq_one(gimple.arg(64, a)), seq_one(gimple.arg(64, b)))) = 2 by simp()
  have z0 := mp(all_elim(r3, {0}), simp(), (int_lt(0, seq_len(seq_concat(seq_one(gimple.arg(64, a)), seq_one(gimple.arg(64, b))))) by simp(l2)))
  have z1 := mp(all_elim(r3, {1}), simp(), (int_lt(1, seq_len(seq_concat(seq_one(gimple.arg(64, a)), seq_one(gimple.arg(64, b))))) by simp(l2)))
  have q0 := at({seq_concat(seq_one(gimple.arg(64, a)), seq_one(gimple.arg(64, b)))[0]})
  have q1 := at({seq_concat(seq_one(gimple.arg(64, a)), seq_one(gimple.arg(64, b)))[1]})
  have e0: regs[0] = a by simp(expand(rewrite(q0, z0), gimple.in_reg, gimple.arg), ha)
  have e1: regs[1] = b by simp(expand(rewrite(q1, z1), gimple.in_reg, gimple.arg), hb)
  show by taut(r1, trans(r2, l2), e0, e1)
qed

// ... and such registers exist
theorem gc.regs2_ex: all a b. a in bits(64) -> b in bits(64) ->
  ex regs. gc.regs_ok(regs, seq_concat(seq_one(gimple.arg(64, a)), seq_one(gimple.arg(64, b))))
proof
  fix a b
  assume ha hb
  show := apply(gc.regs_get, apply(gc.regs_cat, apply(gc.regs_one, simp(), arith(), ha), apply(gc.regs_one, simp(), arith(), hb)))
qed

// (a choice from a nonempty domain: some value of it)
theorem g.any_e(x. d, x. k): (ex x. d(x)) -> any_rel(x. d(x), x. k(x)) -> ex x. d(x) && k(x)
proof
  assume hn h
  show by taut(hn, expand(h, any_rel))
qed

// (a bind whose continuation is refined on the first step's returns: refined)
theorem g.bind_cont(p, s1 v. k1, s1 v. k2, s1 e. x, t. d): all s. (all s1 v. runs(p, s, ok(s1, v)) -> k1(s1, v) -> k2(s1, v)) ->
  bind_rel(p, s, s1 v. k1(s1, v), s1 e. x(s1, e), t. d(t)) -> bind_rel(p, s, s1 v. k2(s1, v), s1 e. x(s1, e), t. d(t))
proof
  fix s
  assume hk hb
  obtain o, hr hc from expand(hb, bind_rel)
  have c1: (ex s1 v. o = ok(s1, v) && k1(s1, v)) -> (ex s1 v. o = ok(s1, v) && k2(s1, v)) proof
    assume e
    obtain s1 v, eo h1 from e
    have k := mp(all_elim(hk, {s1}, {v}), rewrite(eo, hr), h1)
    show by ex_intro({s1}, {v}, conj(eo, k))
  qed
  show by defs(ex_intro({o}, taut(hr, hc, c1)), bind_rel)
qed

// (a 64-bit result: the value itself)
theorem g.result64_inv: all w v o. v in bits(64) -> runs(gimple.result(64, v), w, o) -> o = ok(w, v)
proof
  fix w v o
  assume hv h
  have vi: v in gimple.in_reg(v, fn_update(fn_update(empty, "prec", 64), "signed", false)) by defs(simp(hv), gimple.in_reg)
  have ne: ex x. x in bits(64) && x in gimple.in_reg(v, fn_update(fn_update(empty, "prec", 64), "signed", false)) by ex_intro({v}, conj(hv, vi))
  obtain r, hr1 hr2 ho from apply(g.any_e, ne, apply(g.runs_elim, h))
  have m: int_mod(r, int_pow(2, 64)) = int_mod(v, int_pow(2, 64)) by simp(expand(hr2, gimple.in_reg))
  have e: r = v by arith(m, hr1, hv)
  show by simp(ho, e)
qed

// ----------------------------------------------------------------------
//  A call under a callee's contract, in one step

// The call g(args) at w, g refining F (as C function values), F's
// contract at w: an overflow (the memory any) or the return with the
// memory V. The call's continuation (k, x, d of its bind) then holds of an
// overflow with some memory, or of the return with V -- the call's other
// outcomes (the push's or the return's overflow, the callee's exceptions,
// divergence) folded into these two.
theorem gc.contract_callR(r. R, s1 v. k, s1 e. x, t. d): all g F args w V. gc.sound(w) -> w in abi.World -> V in x86_64_linux.Vm ->
  (ex regs. gc.regs_ok(regs, args)) -> int_le(seq_len(args), 6) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(g[regs], s, o) -> runs(F[regs], s, o)) ->
  (all regs o. gc.regs_ok(regs, args) -> runs(F[regs], w, o) ->
     (ex v. v in x86_64_linux.Vm && o = exc(fn_update(w, "vm", v), exc_val("stack_overflow", empty))) || (ex r. o = ok(fn_update(w, "vm", V), r) && R(r))) ->
  bind_rel(gimple.call(g, args), w, s1 v. k(s1, v), s1 e. x(s1, e), t. d(t)) ->
  (ex v. v in x86_64_linux.Vm && x(fn_update(w, "vm", v), exc_val("stack_overflow", empty))) || (ex r. R(r) && k(fn_update(w, "vm", V), pair(fst(r), snd(r))))
proof
  fix g F args w V
  assume ths hw hV rex hl hg hq hb
  let OVF := exc_val("stack_overflow", empty)
  let W := fn_update(w, "vm", V)
  let Q(o2) := (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(w, "vm", v), OVF)) || (ex r. o2 = ok(W, r) && R(r))
  let G := (ex v. v in x86_64_linux.Vm && x(fn_update(w, "vm", v), OVF)) || (ex r. R(r) && k(W, pair(fst(r), snd(r))))
  // (the callee refines F at w: so does the call)
  have hm: all regs o2. gc.regs_ok(regs, args) -> runs(g[regs], w, o2) -> runs(F[regs], w, o2) proof
    fix regs o2
    assume hro h2
    have rl rn _ := hro
    show := mp(all_elim(hg, {regs}, {w}, {o2}), rl, rewrite(sym(rn), hl), hw, h2)
  qed
  have cm: all o2. runs(gimple.call(g, args), w, o2) -> runs(gimple.call(F, args), w, o2) proof
    fix o2
    assume h2
    show := apply(gc.call_mono2, ths, hm, h2)
  qed
  obtain o1, hr1 hk1 from expand(apply(g.bind_mono, cm, hb), bind_rel)
  have ci := apply(gc.call_inv[Q := o2. Q(o2)], ths, rex, hq, hr1)
  // (w's parts: the memory, the objects)
  have vV: w.vm in x86_64_linux.Vm by simp(expand(hw, abi.World))
  have vfun: is_fun(w) by simp(expand(hw, abi.World))
  have vdom: "vm" in dom(w) by simp(expand(hw, abi.World))
  have od: "objs" in dom(w) by simp(expand(hw, abi.World))
  have ws: fn_update(w, "vm", w.vm) = w := mp(fn_update_same[f := w, k := "vm"], vfun, vdom)
  have fW := mp(fn_update_fun[f := w, k := "vm", v := V], vfun)
  have dW := mp(fn_update_dom[f := w, k := "vm", v := V], vfun, vdom)
  have oW: "objs" in dom(W) := rewrite(sym(dW), od)
  have aW := mp(app_update_other[f := w, k := "vm", v := V, x := "objs"], simp())
  have bW: gc.back(W, w) = W := rewrite(aW, mp(fn_update_same[f := W, k := "objs"], fW, oW))
  // (an overflow at s1: its exception's continuation)
  have xo: all s1. o1 = exc(s1, OVF) -> x(s1, OVF) proof
    fix s1
    assume e
    show by simp(rewrite(e, hk1))
  qed
  have c1: o1 = exc(w, OVF) -> G proof
    assume e
    have x0 := rewrite(sym(ws), mp(all_elim(xo, {w}), e))
    have l: ex v. v in x86_64_linux.Vm && x(fn_update(w, "vm", v), OVF) by ex_intro({w.vm}, taut(vV, x0))
    show by taut(l)
  qed
  have c2: (ex w4 r. Q(ok(w4, r)) && (o1 = ok(gc.back(w4, w), pair(fst(r), snd(r))) || o1 = exc(gc.back(w4, w), OVF))) -> G proof
    assume h
    obtain w4 r, hq2 ho from h
    have ew: w4 = W by simp(hq2)
    have hR: R(r) by simp(hq2)
    have ho2 := rewrite(bW, rewrite(ew, ho))
    have a: o1 = ok(W, pair(fst(r), snd(r))) -> G proof
      assume e
      have kk: k(W, pair(fst(r), snd(r))) by simp(rewrite(e, hk1))
      have l: ex r. R(r) && k(W, pair(fst(r), snd(r))) by ex_intro({r}, taut(hR, kk))
      show by taut(l)
    qed
    have b: o1 = exc(W, OVF) -> G proof
      assume e
      have x1 := mp(all_elim(xo, {W}), e)
      have l: ex v. v in x86_64_linux.Vm && x(fn_update(w, "vm", v), OVF) by ex_intro({V}, taut(hV, x1))
      show by taut(l)
    qed
    show by taut(ho2, a, b)
  qed
  have c3: (ex x0 e. Q(exc(x0, e)) && o1 = exc(x0, e)) -> G proof
    assume h
    obtain x0 e, hq2 ho from h
    obtain v, hv hx he2 from simp(hq2)
    have x1 := mp(all_elim(xo, {fn_update(w, "vm", v)}), rewrite(hx, rewrite(he2, ho)))
    have l: ex v. v in x86_64_linux.Vm && x(fn_update(w, "vm", v), OVF) by ex_intro({v}, taut(hv, x1))
    show by taut(l)
  qed
  have c4: (ex t. Q(diverge(t)) && o1 = diverge(t)) -> G proof
    assume h
    obtain t, hq2 _ from h
    have f: false by simp(hq2)
    show by taut(f)
  qed
  show by taut(ci, c1, c2, c3, c4)
qed

// ... its returns constrained by nothing
theorem gc.contract_call(s1 v. k, s1 e. x, t. d): all g F args w V. gc.sound(w) -> w in abi.World -> V in x86_64_linux.Vm ->
  (ex regs. gc.regs_ok(regs, args)) -> int_le(seq_len(args), 6) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(g[regs], s, o) -> runs(F[regs], s, o)) ->
  (all regs o. gc.regs_ok(regs, args) -> runs(F[regs], w, o) ->
     (ex v. v in x86_64_linux.Vm && o = exc(fn_update(w, "vm", v), exc_val("stack_overflow", empty))) || (ex r. o = ok(fn_update(w, "vm", V), r))) ->
  bind_rel(gimple.call(g, args), w, s1 v. k(s1, v), s1 e. x(s1, e), t. d(t)) ->
  (ex v. v in x86_64_linux.Vm && x(fn_update(w, "vm", v), exc_val("stack_overflow", empty))) || (ex r. k(fn_update(w, "vm", V), r))
proof
  fix g F args w V
  assume ths hw hV rex hl hg hq hb
  have hq2: all regs o. gc.regs_ok(regs, args) -> runs(F[regs], w, o) ->
      (ex v. v in x86_64_linux.Vm && o = exc(fn_update(w, "vm", v), exc_val("stack_overflow", empty))) || (ex r. o = ok(fn_update(w, "vm", V), r) && true) proof
    fix regs o
    assume h1 h2
    have c := mp(all_elim(hq, {regs}, {o}), h1, h2)
    show by simp(c)
  qed
  have c := mp(all_elim(gc.contract_callR[R := r. true, k := s1 v. k(s1, v), x := s1 e. x(s1, e), d := t. d(t)], {g}, {F}, {args}, {w}, {V}), ths, hw, hV, rex, hl, hg, hq2, hb)
  have r1: (ex r. true && k(fn_update(w, "vm", V), pair(fst(r), snd(r)))) -> (ex r. k(fn_update(w, "vm", V), r)) proof
    assume h
    obtain r, _ hk from h
    show by ex_intro({pair(fst(r), snd(r))}, hk)
  qed
  show by taut(c, r1)
qed

// A call under a callee's contract that gives its memory by a property P
// (`havoc vm where P`): the continuation holds of an overflow, or of the
// return with some memory V having P (as `gc.contract_callR`, V not fixed)
theorem gc.contract_callV(v. P, s1 v. k, s1 e. x, t. d): all g F args w. gc.sound(w) -> w in abi.World ->
  (ex regs. gc.regs_ok(regs, args)) -> int_le(seq_len(args), 6) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(g[regs], s, o) -> runs(F[regs], s, o)) ->
  (all regs o. gc.regs_ok(regs, args) -> runs(F[regs], w, o) ->
     (ex v. v in x86_64_linux.Vm && o = exc(fn_update(w, "vm", v), exc_val("stack_overflow", empty))) ||
     (ex V r. (V in x86_64_linux.Vm && P(V)) && o = ok(fn_update(w, "vm", V), r))) ->
  bind_rel(gimple.call(g, args), w, s1 v. k(s1, v), s1 e. x(s1, e), t. d(t)) ->
  (ex v. v in x86_64_linux.Vm && x(fn_update(w, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex V r. (V in x86_64_linux.Vm && P(V)) && k(fn_update(w, "vm", V), pair(fst(r), snd(r))))
proof
  fix g F args w
  assume ths hw rex hl hg hq hb
  let OVF := exc_val("stack_overflow", empty)
  let Q(o2) := (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(w, "vm", v), OVF)) || (ex V r. (V in x86_64_linux.Vm && P(V)) && o2 = ok(fn_update(w, "vm", V), r))
  let G := (ex v. v in x86_64_linux.Vm && x(fn_update(w, "vm", v), OVF)) || (ex V r. (V in x86_64_linux.Vm && P(V)) && k(fn_update(w, "vm", V), pair(fst(r), snd(r))))
  // (the callee refines F at w: so does the call)
  have hm: all regs o2. gc.regs_ok(regs, args) -> runs(g[regs], w, o2) -> runs(F[regs], w, o2) proof
    fix regs o2
    assume hro h2
    have rl rn _ := hro
    show := mp(all_elim(hg, {regs}, {w}, {o2}), rl, rewrite(sym(rn), hl), hw, h2)
  qed
  have cm: all o2. runs(gimple.call(g, args), w, o2) -> runs(gimple.call(F, args), w, o2) proof
    fix o2
    assume h2
    show := apply(gc.call_mono2, ths, hm, h2)
  qed
  obtain o1, hr1 hk1 from expand(apply(g.bind_mono, cm, hb), bind_rel)
  have ci := apply(gc.call_inv[Q := o2. Q(o2)], ths, rex, hq, hr1)
  // (w's parts: the memory, the objects)
  have vV: w.vm in x86_64_linux.Vm by simp(expand(hw, abi.World))
  have vfun: is_fun(w) by simp(expand(hw, abi.World))
  have vdom: "vm" in dom(w) by simp(expand(hw, abi.World))
  have od: "objs" in dom(w) by simp(expand(hw, abi.World))
  have ws: fn_update(w, "vm", w.vm) = w := mp(fn_update_same[f := w, k := "vm"], vfun, vdom)
  // (a world with another memory: its objects w's)
  have bk: all V. gc.back(fn_update(w, "vm", V), w) = fn_update(w, "vm", V) proof
    fix V
    have fW := mp(fn_update_fun[f := w, k := "vm", v := V], vfun)
    have dW := mp(fn_update_dom[f := w, k := "vm", v := V], vfun, vdom)
    have oW: "objs" in dom(fn_update(w, "vm", V)) := rewrite(sym(dW), od)
    have aW := mp(app_update_other[f := w, k := "vm", v := V, x := "objs"], simp())
    show := rewrite(aW, mp(fn_update_same[f := fn_update(w, "vm", V), k := "objs"], fW, oW))
  qed
  // (an overflow at s1: its exception's continuation)
  have xo: all s1. o1 = exc(s1, OVF) -> x(s1, OVF) proof
    fix s1
    assume e
    show by simp(rewrite(e, hk1))
  qed
  have c1: o1 = exc(w, OVF) -> G proof
    assume e
    have x0 := rewrite(sym(ws), mp(all_elim(xo, {w}), e))
    have l: ex v. v in x86_64_linux.Vm && x(fn_update(w, "vm", v), OVF) by ex_intro({w.vm}, taut(vV, x0))
    show by taut(l)
  qed
  have c2: (ex w4 r. Q(ok(w4, r)) && (o1 = ok(gc.back(w4, w), pair(fst(r), snd(r))) || o1 = exc(gc.back(w4, w), OVF))) -> G proof
    assume h
    obtain w4 r, hq2 ho from h
    have ev: ex V. (V in x86_64_linux.Vm && P(V)) && w4 = fn_update(w, "vm", V) proof
      have k0: (ex V r2. (V in x86_64_linux.Vm && P(V)) && ok(w4, r) = ok(fn_update(w, "vm", V), r2)) -> ex V. (V in x86_64_linux.Vm && P(V)) && w4 = fn_update(w, "vm", V) proof
        assume e
        obtain V r2, hV hP he from e
        show by ex_intro({V}, taut(hV, hP, (w4 = fn_update(w, "vm", V) by simp(he))))
      qed
      have n0: !(ex v. v in x86_64_linux.Vm && ok(w4, r) = exc(fn_update(w, "vm", v), OVF)) by simp()
      show by taut(hq2, k0, n0)
    qed
    obtain V, hV hP ew from ev
    have ho2 := rewrite(all_elim(bk, {V}), rewrite(ew, ho))
    have a: o1 = ok(fn_update(w, "vm", V), pair(fst(r), snd(r))) -> G proof
      assume e
      have kk: k(fn_update(w, "vm", V), pair(fst(r), snd(r))) by simp(rewrite(e, hk1))
      have l: ex V2 r2. (V2 in x86_64_linux.Vm && P(V2)) && k(fn_update(w, "vm", V2), pair(fst(r2), snd(r2))) by ex_intro({V}, {r}, taut(hV, hP, kk))
      show by taut(l)
    qed
    have b: o1 = exc(fn_update(w, "vm", V), OVF) -> G proof
      assume e
      have x1 := mp(all_elim(xo, {fn_update(w, "vm", V)}), e)
      have l: ex v. v in x86_64_linux.Vm && x(fn_update(w, "vm", v), OVF) by ex_intro({V}, taut(hV, x1))
      show by taut(l)
    qed
    show by taut(ho2, a, b)
  qed
  have c3: (ex x0 e. Q(exc(x0, e)) && o1 = exc(x0, e)) -> G proof
    assume h
    obtain x0 e, hq2 ho from h
    have n1: !(ex V r. (V in x86_64_linux.Vm && P(V)) && exc(x0, e) = ok(fn_update(w, "vm", V), r)) by simp()
    have q1: ex v. v in x86_64_linux.Vm && exc(x0, e) = exc(fn_update(w, "vm", v), OVF) by taut(hq2, n1)
    obtain v, hv hx from q1
    have he2: x0 = fn_update(w, "vm", v) && e = OVF by simp(hx)
    have x1 := mp(all_elim(xo, {fn_update(w, "vm", v)}), (o1 = exc(fn_update(w, "vm", v), OVF) by simp(ho, he2)))
    have l: ex v. v in x86_64_linux.Vm && x(fn_update(w, "vm", v), OVF) by ex_intro({v}, taut(hv, x1))
    show by taut(l)
  qed
  have c4: (ex t. Q(diverge(t)) && o1 = diverge(t)) -> G proof
    assume h
    obtain t, hq2 _ from h
    have n1: !(ex V r. (V in x86_64_linux.Vm && P(V)) && diverge(t) = ok(fn_update(w, "vm", V), r)) by simp()
    have n2: !(ex v. v in x86_64_linux.Vm && diverge(t) = exc(fn_update(w, "vm", v), OVF)) by simp()
    have f: false by taut(hq2, n1, n2)
    show by taut(f)
  qed
  show by taut(ci, c1, c2, c3, c4)
qed

// ... a call of one result (call1: the first register): the continuation
// holds of an overflow, or of the return with V and a first register r0 of
// some return r with R
theorem gc.contract_call1(r. R, s1 v. k, s1 e. x, t. d): all g F args w V. gc.sound(w) -> w in abi.World -> V in x86_64_linux.Vm ->
  (ex regs. gc.regs_ok(regs, args)) -> int_le(seq_len(args), 6) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(g[regs], s, o) -> runs(F[regs], s, o)) ->
  (all regs o. gc.regs_ok(regs, args) -> runs(F[regs], w, o) ->
     (ex v. v in x86_64_linux.Vm && o = exc(fn_update(w, "vm", v), exc_val("stack_overflow", empty))) || (ex r. o = ok(fn_update(w, "vm", V), r) && R(r))) ->
  bind_rel(gimple.call1(g, args), w, s1 v. k(s1, v), s1 e. x(s1, e), t. d(t)) ->
  (ex v. v in x86_64_linux.Vm && x(fn_update(w, "vm", v), exc_val("stack_overflow", empty))) || (ex r. R(r) && k(fn_update(w, "vm", V), fst(r)))
proof
  fix g F args w V
  assume ths hw hV rex hl hg hq hb
  let OVF := exc_val("stack_overflow", empty)
  let W := fn_update(w, "vm", V)
  let G := (ex v. v in x86_64_linux.Vm && x(fn_update(w, "vm", v), OVF)) || (ex r. R(r) && k(W, fst(r)))
  obtain o1, hr1 hk1 from expand(hb, bind_rel)
  have b := apply(g.runs_elim, expand(hr1, gimple.call1))
  have c := mp(all_elim(gc.contract_callR[R := r. R(r), k := x2 x3. letin(x3, x4. o1 = ok(x2, fst(x4))), x := x2 x3. o1 = exc(x2, x3), d := x2. o1 = diverge(x2)], {g}, {F}, {args}, {w}, {V}),
    ths, hw, hV, rex, hl, hg, hq, b)
  have c1: (ex v. v in x86_64_linux.Vm && o1 = exc(fn_update(w, "vm", v), OVF)) -> G proof
    assume h
    obtain v, hv he from h
    have x1: x(fn_update(w, "vm", v), OVF) by simp(rewrite(he, hk1))
    have l: ex v. v in x86_64_linux.Vm && x(fn_update(w, "vm", v), OVF) by ex_intro({v}, taut(hv, x1))
    show by taut(l)
  qed
  have c2: (ex r. R(r) && letin(pair(fst(r), snd(r)), x4. o1 = ok(W, fst(x4)))) -> G proof
    assume h
    obtain r, hR he from h
    have e: o1 = ok(W, fst(r)) by simp(expand(he, letin))
    have k1: k(W, fst(r)) by simp(rewrite(e, hk1))
    have l: ex r. R(r) && k(W, fst(r)) by ex_intro({r}, taut(hR, k1))
    show by taut(l)
  qed
  show by taut(c, c1, c2)
qed

// A call under a callee's contract that gives its memory and return by a
// property P of both: the continuation holds of an overflow, or of the
// return with some memory V and return r having P (as `gc.contract_callV`)
theorem gc.contract_callVR(v r. P, s1 v. k, s1 e. x, t. d): all g F args w. gc.sound(w) -> w in abi.World ->
  (ex regs. gc.regs_ok(regs, args)) -> int_le(seq_len(args), 6) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(g[regs], s, o) -> runs(F[regs], s, o)) ->
  (all regs o. gc.regs_ok(regs, args) -> runs(F[regs], w, o) ->
     (ex v. v in x86_64_linux.Vm && o = exc(fn_update(w, "vm", v), exc_val("stack_overflow", empty))) ||
     (ex V r. (V in x86_64_linux.Vm && P(V, r)) && o = ok(fn_update(w, "vm", V), r))) ->
  bind_rel(gimple.call(g, args), w, s1 v. k(s1, v), s1 e. x(s1, e), t. d(t)) ->
  (ex v. v in x86_64_linux.Vm && x(fn_update(w, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex V r. (V in x86_64_linux.Vm && P(V, r)) && k(fn_update(w, "vm", V), pair(fst(r), snd(r))))
proof
  fix g F args w
  assume ths hw rex hl hg hq hb
  let OVF := exc_val("stack_overflow", empty)
  let Q(o2) := (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(w, "vm", v), OVF)) || (ex V r. (V in x86_64_linux.Vm && P(V, r)) && o2 = ok(fn_update(w, "vm", V), r))
  let G := (ex v. v in x86_64_linux.Vm && x(fn_update(w, "vm", v), OVF)) || (ex V r. (V in x86_64_linux.Vm && P(V, r)) && k(fn_update(w, "vm", V), pair(fst(r), snd(r))))
  have hm: all regs o2. gc.regs_ok(regs, args) -> runs(g[regs], w, o2) -> runs(F[regs], w, o2) proof
    fix regs o2
    assume hro h2
    have rl rn _ := hro
    show := mp(all_elim(hg, {regs}, {w}, {o2}), rl, rewrite(sym(rn), hl), hw, h2)
  qed
  have cm: all o2. runs(gimple.call(g, args), w, o2) -> runs(gimple.call(F, args), w, o2) proof
    fix o2
    assume h2
    show := apply(gc.call_mono2, ths, hm, h2)
  qed
  obtain o1, hr1 hk1 from expand(apply(g.bind_mono, cm, hb), bind_rel)
  have ci := apply(gc.call_inv[Q := o2. Q(o2)], ths, rex, hq, hr1)
  have vV: w.vm in x86_64_linux.Vm by simp(expand(hw, abi.World))
  have vfun: is_fun(w) by simp(expand(hw, abi.World))
  have vdom: "vm" in dom(w) by simp(expand(hw, abi.World))
  have od: "objs" in dom(w) by simp(expand(hw, abi.World))
  have ws: fn_update(w, "vm", w.vm) = w := mp(fn_update_same[f := w, k := "vm"], vfun, vdom)
  have bk: all V. gc.back(fn_update(w, "vm", V), w) = fn_update(w, "vm", V) proof
    fix V
    have fW := mp(fn_update_fun[f := w, k := "vm", v := V], vfun)
    have dW := mp(fn_update_dom[f := w, k := "vm", v := V], vfun, vdom)
    have oW: "objs" in dom(fn_update(w, "vm", V)) := rewrite(sym(dW), od)
    have aW := mp(app_update_other[f := w, k := "vm", v := V, x := "objs"], simp())
    show := rewrite(aW, mp(fn_update_same[f := fn_update(w, "vm", V), k := "objs"], fW, oW))
  qed
  have xo: all s1. o1 = exc(s1, OVF) -> x(s1, OVF) proof
    fix s1
    assume e
    show by simp(rewrite(e, hk1))
  qed
  have c1: o1 = exc(w, OVF) -> G proof
    assume e
    have x0 := rewrite(sym(ws), mp(all_elim(xo, {w}), e))
    have l: ex v. v in x86_64_linux.Vm && x(fn_update(w, "vm", v), OVF) by ex_intro({w.vm}, taut(vV, x0))
    show by taut(l)
  qed
  have c2: (ex w4 r. Q(ok(w4, r)) && (o1 = ok(gc.back(w4, w), pair(fst(r), snd(r))) || o1 = exc(gc.back(w4, w), OVF))) -> G proof
    assume h
    obtain w4 r, hq2 ho from h
    have ev: ex V. (V in x86_64_linux.Vm && P(V, r)) && w4 = fn_update(w, "vm", V) proof
      have k0: (ex V r2. (V in x86_64_linux.Vm && P(V, r2)) && ok(w4, r) = ok(fn_update(w, "vm", V), r2)) -> ex V. (V in x86_64_linux.Vm && P(V, r)) && w4 = fn_update(w, "vm", V) proof
        assume e
        obtain V r2, hV hP he from e
        have e3 e4 := (w4 = fn_update(w, "vm", V) && r = r2 by simp(he))
        show by ex_intro({V}, taut(hV, subst({y. P(V, y)}, sym(e4), hP), e3))
      qed
      have n0: !(ex v. v in x86_64_linux.Vm && ok(w4, r) = exc(fn_update(w, "vm", v), OVF)) by simp()
      show by taut(hq2, k0, n0)
    qed
    obtain V, hV hP ew from ev
    have ho2 := rewrite(all_elim(bk, {V}), rewrite(ew, ho))
    have a: o1 = ok(fn_update(w, "vm", V), pair(fst(r), snd(r))) -> G proof
      assume e
      have kk: k(fn_update(w, "vm", V), pair(fst(r), snd(r))) by simp(rewrite(e, hk1))
      have l: ex V2 r2. (V2 in x86_64_linux.Vm && P(V2, r2)) && k(fn_update(w, "vm", V2), pair(fst(r2), snd(r2))) by ex_intro({V}, {r}, taut(hV, hP, kk))
      show by taut(l)
    qed
    have b: o1 = exc(fn_update(w, "vm", V), OVF) -> G proof
      assume e
      have x1 := mp(all_elim(xo, {fn_update(w, "vm", V)}), e)
      have l: ex v. v in x86_64_linux.Vm && x(fn_update(w, "vm", v), OVF) by ex_intro({V}, taut(hV, x1))
      show by taut(l)
    qed
    show by taut(ho2, a, b)
  qed
  have c3: (ex x0 e. Q(exc(x0, e)) && o1 = exc(x0, e)) -> G proof
    assume h
    obtain x0 e, hq2 ho from h
    have n1: !(ex V r. (V in x86_64_linux.Vm && P(V, r)) && exc(x0, e) = ok(fn_update(w, "vm", V), r)) by simp()
    have q1: ex v. v in x86_64_linux.Vm && exc(x0, e) = exc(fn_update(w, "vm", v), OVF) by taut(hq2, n1)
    obtain v, hv hx from q1
    have he2: x0 = fn_update(w, "vm", v) && e = OVF by simp(hx)
    have x1 := mp(all_elim(xo, {fn_update(w, "vm", v)}), (o1 = exc(fn_update(w, "vm", v), OVF) by simp(ho, he2)))
    have l: ex v. v in x86_64_linux.Vm && x(fn_update(w, "vm", v), OVF) by ex_intro({v}, taut(hv, x1))
    show by taut(l)
  qed
  have c4: (ex t. Q(diverge(t)) && o1 = diverge(t)) -> G proof
    assume h
    obtain t, hq2 _ from h
    have n1: !(ex V r. (V in x86_64_linux.Vm && P(V, r)) && diverge(t) = ok(fn_update(w, "vm", V), r)) by simp()
    have n2: !(ex v. v in x86_64_linux.Vm && diverge(t) = exc(fn_update(w, "vm", v), OVF)) by simp()
    have f: false by taut(hq2, n1, n2)
    show by taut(f)
  qed
  show by taut(ci, c1, c2, c3, c4)
qed

// ... a call of one result (call1): the continuation holds of an
// overflow, or of the return with V and the first register of a return r,
// P of V and r
theorem gc.contract_call1VR(v r. P, s1 v. k, s1 e. x, t. d): all g F args w. gc.sound(w) -> w in abi.World ->
  (ex regs. gc.regs_ok(regs, args)) -> int_le(seq_len(args), 6) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(g[regs], s, o) -> runs(F[regs], s, o)) ->
  (all regs o. gc.regs_ok(regs, args) -> runs(F[regs], w, o) ->
     (ex v. v in x86_64_linux.Vm && o = exc(fn_update(w, "vm", v), exc_val("stack_overflow", empty))) ||
     (ex V r. (V in x86_64_linux.Vm && P(V, r)) && o = ok(fn_update(w, "vm", V), r))) ->
  bind_rel(gimple.call1(g, args), w, s1 v. k(s1, v), s1 e. x(s1, e), t. d(t)) ->
  (ex v. v in x86_64_linux.Vm && x(fn_update(w, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex V r. (V in x86_64_linux.Vm && P(V, r)) && k(fn_update(w, "vm", V), fst(r)))
proof
  fix g F args w
  assume ths hw rex hl hg hq hb
  let OVF := exc_val("stack_overflow", empty)
  let G := (ex v. v in x86_64_linux.Vm && x(fn_update(w, "vm", v), OVF)) || (ex V r. (V in x86_64_linux.Vm && P(V, r)) && k(fn_update(w, "vm", V), fst(r)))
  obtain o1, hr1 hk1 from expand(hb, bind_rel)
  have b := apply(g.runs_elim, expand(hr1, gimple.call1))
  have c := mp(all_elim(gc.contract_callVR[P := v r. P(v, r), k := x2 x3. letin(x3, x4. o1 = ok(x2, fst(x4))), x := x2 x3. o1 = exc(x2, x3), d := x2. o1 = diverge(x2)], {g}, {F}, {args}, {w}),
    ths, hw, rex, hl, hg, hq, b)
  have c1: (ex v. v in x86_64_linux.Vm && o1 = exc(fn_update(w, "vm", v), OVF)) -> G proof
    assume h
    obtain v, hv he from h
    have x1: x(fn_update(w, "vm", v), OVF) by simp(rewrite(he, hk1))
    have l: ex v. v in x86_64_linux.Vm && x(fn_update(w, "vm", v), OVF) by ex_intro({v}, taut(hv, x1))
    show by taut(l)
  qed
  have c2: (ex V r. (V in x86_64_linux.Vm && P(V, r)) && letin(pair(fst(r), snd(r)), x4. o1 = ok(fn_update(w, "vm", V), fst(x4)))) -> G proof
    assume h
    obtain V r, hV hP he from h
    have e: o1 = ok(fn_update(w, "vm", V), fst(r)) by simp(expand(he, letin))
    have k1: k(fn_update(w, "vm", V), fst(r)) by simp(rewrite(e, hk1))
    have l: ex V2 r2. (V2 in x86_64_linux.Vm && P(V2, r2)) && k(fn_update(w, "vm", V2), fst(r2)) by ex_intro({V}, {r}, taut(hV, hP, k1))
    show by taut(l)
  qed
  show by taut(c, c1, c2)
qed

// ----------------------------------------------------------------------
//  More operations' one outcome, when defined: signed 32-bit arithmetic,
//  an element's address, a 16-bit load

theorem g.sadd32_det: all s a b. s in univ(1) -> a in bits(32) -> b in bits(32) -> tr.s32_fits(int_add(sint(32, a), sint(32, b))) ->
  g.det(gimple.sadd(32, a, b), s, ok(s, bits_add(32, a, b)))
proof
  fix s a b
  assume hs ha hb hf
  have e := mp(tr.sint_add32, {a}, {b}, ha, hb)
  have v: bits_of_int(32, int_add(sint(32, a), sint(32, b))) = bits_add(32, a, b) by defs(simp(e), bits_of_int, bits_add)
  show proof
    fix o
    assume hr
    show by simp(expand(hr, gimple.sadd, gimple.arith, gimple.wrap, runs, mkprog, bind_rel), hs, ha, hb, hf, v)
  qed
qed

theorem g.ssub32_det: all s a b. s in univ(1) -> a in bits(32) -> b in bits(32) -> tr.s32_fits(int_sub(sint(32, a), sint(32, b))) ->
  g.det(gimple.ssub(32, a, b), s, ok(s, bits_sub(32, a, b)))
proof
  fix s a b
  assume hs ha hb hf
  have e := mp(tr.sint_sub32, {a}, {b}, ha, hb)
  have v: bits_of_int(32, int_sub(sint(32, a), sint(32, b))) = bits_sub(32, a, b) by defs(simp(e), bits_of_int, bits_sub)
  show proof
    fix o
    assume hr
    show by simp(expand(hr, gimple.ssub, gimple.arith, gimple.wrap, runs, mkprog, bind_rel), hs, ha, hb, hf, v)
  qed
qed

theorem g.ssub64_det: all s a b. s in univ(1) -> a in bits(64) -> b in bits(64) -> tr.s64_fits(int_sub(sint(64, a), sint(64, b))) ->
  g.det(gimple.ssub(64, a, b), s, ok(s, bits_sub(64, a, b)))
proof
  fix s a b
  assume hs ha hb hf
  have e := mp(tr.sint_sub64, {a}, {b}, ha, hb)
  have v: bits_of_int(64, int_sub(sint(64, a), sint(64, b))) = bits_sub(64, a, b) by defs(simp(e), bits_of_int, bits_sub)
  show proof
    fix o
    assume hr
    show by simp(expand(hr, gimple.ssub, gimple.arith, gimple.wrap, runs, mkprog, bind_rel), hs, ha, hb, hf, v)
  qed
qed

theorem g.sneg32_det: all s a. s in univ(1) -> a in bits(32) -> tr.s32_fits(int_neg(sint(32, a))) ->
  g.det(gimple.sneg(32, a), s, ok(s, bits_sub(32, 0, a)))
proof
  fix s a
  assume hs ha hf
  have sa: sint(32, a) = a || sint(32, a) = int_sub(a, 4294967296) by defs(simp(ha), sint)
  have e: int_mod(int_neg(sint(32, a)), 4294967296) = int_mod(int_sub(0, a), 4294967296) by arith(ha, sa)
  have v: bits_of_int(32, int_neg(sint(32, a))) = bits_sub(32, 0, a) by defs(simp(e), bits_of_int, bits_sub)
  show proof
    fix o
    assume hr
    show by simp(expand(hr, gimple.sneg, gimple.arith, gimple.wrap, runs, mkprog, bind_rel), hs, ha, hf, v)
  qed
qed

theorem g.smul32_det: all s a k. s in univ(1) -> a in bits(32) -> k in bits(32) -> tr.imul_by(k) -> tr.s32_fits(int_mul(sint(32, a), sint(32, k))) ->
  g.det(gimple.smul(32, a, k), s, ok(s, bits_mul(32, a, k)))
proof
  fix s a k
  assume hs ha hk hb hf
  have e := mp(all_elim(expand(hb, tr.imul_by), {a}), ha)
  have v: bits_of_int(32, int_mul(sint(32, a), sint(32, k))) = bits_mul(32, a, k) by defs(simp(e), bits_of_int, bits_add)
  show proof
    fix o
    assume hr
    show by simp(expand(hr, gimple.smul, gimple.arith, gimple.wrap, runs, mkprog, bind_rel), hs, ha, hk, hf, v)
  qed
qed

// (an index of 2-byte elements: times 2, in 64 bits)
theorem g.smul_sx2_det: all s i. s in univ(1) -> i in bits(32) ->
  g.det(gimple.smul(64, bits_sext(32, 64, i), bits_of_int(64, 2)), s, ok(s, bits_add(64, bits_sext(32, 64, i), bits_sext(32, 64, i))))
proof
  fix s i
  assume hs hi
  have sv := mp(tr.sext_vals, {i}, hi)
  have xb: bits_sext(32, 64, i) in bits(64) by taut(sv)
  have s64: sint(64, bits_sext(32, 64, i)) = sint(32, i) by taut(sv)
  have lo: int_le(int_neg(2147483648), sint(32, i)) by taut(sv)
  have hi2: int_lt(sint(32, i), 2147483648) by taut(sv)
  have f: gimple.fits(fn_update(fn_update(empty, "prec", 64), "signed", true), int_mul(sint(32, i), 2)) by defs(simp(lo, hi2), gimple.fits)
  have xd: bits_sext(32, 64, i) = int_mod(sint(32, i), 18446744073709551616) by defs(simp(), bits_sext, bits_of_int, pow2)
  have w0: int_mod(int_mul(sint(32, i), 2), 18446744073709551616) = int_mod(int_add(int_mod(sint(32, i), 18446744073709551616), int_mod(sint(32, i), 18446744073709551616)), 18446744073709551616) by arith(lo, hi2)
  have w: bits_of_int(64, gimple.wrap(fn_update(fn_update(empty, "prec", 64), "signed", true), int_mul(sint(32, i), 2))) = bits_add(64, bits_sext(32, 64, i), bits_sext(32, 64, i))
    by defs(simp(w0, xd), gimple.wrap, bits_of_int, bits_add, pow2)
  show proof
    fix o
    assume hr
    show by simp(expand(hr, gimple.smul, gimple.arith, runs, mkprog, bind_rel), hs, s64, xb, f, w)
  qed
qed

theorem g.elem2_sx_det: all s p i. s in univ(1) -> p in bits(64) -> i in bits(32) -> tr.elem2_sx_def(p, i) ->
  g.det(gimple.elem(p, bits_sext(32, 64, i), 2), s, ok(s, bits_add(64, p, bits_add(64, bits_sext(32, 64, i), bits_sext(32, 64, i)))))
proof
  fix s p i
  assume hs hp hi hd
  let X := bits_add(64, bits_sext(32, 64, i), bits_sext(32, 64, i))
  let SV := gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), X)
  have sv := mp(tr.sext_vals, {i}, hi)
  have lo: int_le(int_neg(2147483648), sint(32, i)) by taut(sv)
  have hi2: int_lt(sint(32, i), 2147483648) by taut(sv)
  have xd: bits_sext(32, 64, i) = int_mod(sint(32, i), 18446744073709551616) by defs(simp(), bits_sext, bits_of_int, pow2)
  have xa: X = int_mod(int_add(bits_sext(32, 64, i), bits_sext(32, 64, i)), 18446744073709551616) by defs(simp(), bits_add, pow2)
  have xv: X = int_mod(int_mul(2, sint(32, i)), 18446744073709551616) by arith(xa, xd, lo, hi2)
  have xb: X in bits(64) by simp()
  have svx: SV = int_mul(2, sint(32, i)) proof
    have c1: int_le(0, sint(32, i)) -> SV = int_mul(2, sint(32, i)) proof
      assume h0
      have m: int_mod(int_mul(2, sint(32, i)), 18446744073709551616) = int_mul(2, sint(32, i)) by arith(h0, hi2)
      show by defs(simp(xv, m, h0, hi2), gimple.sval)
    qed
    have c2: !int_le(0, sint(32, i)) -> SV = int_mul(2, sint(32, i)) proof
      assume h0
      have m: int_mod(int_mul(2, sint(32, i)), 18446744073709551616) = int_add(int_mul(2, sint(32, i)), 18446744073709551616) by arith(h0, lo)
      show by defs(simp(xv, m, h0, lo), gimple.sval)
    qed
    show by taut(c1, c2)
  qed
  have h0: int_le(0, int_add(p, SV)) by simp(svx, hd)
  have p64: pow2(64) = 18446744073709551616 by simp()
  have h1: int_lt(int_add(p, SV), pow2(64)) by simp(svx, hd, p64)
  have pd := apply(g.padd_det, {s}, {p}, {X}, hs, hp, xb, h0, h1)
  have bdef: bits_add(64, p, X) = int_mod(int_add(p, X), 18446744073709551616) by defs(simp(), bits_add)
  have ev: int_add(p, SV) = bits_add(64, p, X) by arith(svx, bdef, xv, hd, hp, lo, hi2)
  have sd := apply(g.smul_sx2_det, {s}, {i}, hs, hi)
  show proof
    fix o
    assume hr
    have b1 := apply(g.bind_inv, apply(g.runs_elim, expand(hr, gimple.elem)), sd)
    have b2 := apply(g.bind_inv, b1, rewrite(ev, pd))
    show := b2
  qed
qed

theorem g.ld32_det: all s p off. s in univ(1) -> p in bits(64) -> off in bits(32) -> g.mem_defined(s, p, off, 4, false) ->
  g.det(gimple.ld32(p, off), s, ok(s, bits_of_int(32, gimple.bytes_at(s.vm, int_add(p, off), 4))))
proof
  fix s p off
  assume hs hp ho hd
  have md := apply(g.mem_det, {s}, {p}, {off}, {4}, {false}, hs, hp, ho, hd)
  show proof
    fix o
    assume hr
    have b := apply(g.runs_elim, hr)
    show := apply(g.bind_inv, b, md)
  qed
qed

theorem g.ld16_det: all s p off. s in univ(1) -> p in bits(64) -> off in bits(32) -> g.mem_defined(s, p, off, 2, false) ->
  g.det(gimple.ld16(p, off), s, ok(s, bits_of_int(16, gimple.bytes_at(s.vm, int_add(p, off), 2))))
proof
  fix s p off
  assume hs hp ho hd
  have md := apply(g.mem_det, {s}, {p}, {off}, {2}, {false}, hs, hp, ho, hd)
  show proof
    fix o
    assume hr
    have b := apply(g.runs_elim, hr)
    show := apply(g.bind_inv, b, md)
  qed
qed

// (the register of a call with one 32-bit word a: a in its low half)
theorem gc.regs1_32: all regs a. a in bits(32) -> gc.regs_ok(regs, seq_one(gimple.arg(32, a))) ->
  regs in list_type(bits(64)) && seq_len(regs) = 1 && bits_of_int(32, regs[0]) = a
proof
  fix regs a
  assume ha h
  have r1 r2 r3 := h
  have l1: seq_len(seq_one(gimple.arg(32, a))) = 1 by simp()
  have z0 := mp(all_elim(r3, {0}), simp(), (int_lt(0, seq_len(seq_one(gimple.arg(32, a)))) by simp(l1)))
  have q0 := at({seq_one(gimple.arg(32, a))[0]})
  have p32: int_pow(2, 32) = 4294967296 by simp()
  have m: int_mod(regs[0], 4294967296) = int_mod(a, 4294967296) by simp(expand(rewrite(q0, z0), gimple.in_reg, gimple.arg), p32)
  have ma: int_mod(a, 4294967296) = a by arith(ha)
  have e0: bits_of_int(32, regs[0]) = a by defs(simp(m, ma), bits_of_int, pow2)
  show by taut(r1, trans(r2, l1), e0)
qed

// ... and such a register exists
theorem gc.regs1_32_ex: all a. a in bits(32) -> ex regs. gc.regs_ok(regs, seq_one(gimple.arg(32, a)))
proof
  fix a
  assume ha
  show := apply(gc.regs_get, apply(gc.regs_one, simp(), arith(), ha))
qed

// a 32-bit result: some word, its low half the value
theorem g.result32_inv: all w v o. v in bits(32) -> runs(gimple.result(32, v), w, o) -> ex u. u in bits(64) && bits_of_int(32, u) = v && o = ok(w, u)
proof
  fix w v o
  assume hv h
  have v64: v in bits(64) by simp(hv)
  have vi: v in gimple.in_reg(v, fn_update(fn_update(empty, "prec", 32), "signed", false)) by defs(simp(v64), gimple.in_reg)
  have ne: ex x. x in bits(64) && x in gimple.in_reg(v, fn_update(fn_update(empty, "prec", 32), "signed", false)) by ex_intro({v}, conj(v64, vi))
  obtain r, hr1 hr2 ho from apply(g.any_e, ne, apply(g.runs_elim, h))
  have p32: int_pow(2, 32) = 4294967296 by simp()
  have m: int_mod(r, 4294967296) = int_mod(v, 4294967296) by simp(expand(hr2, gimple.in_reg), p32)
  have mv: int_mod(v, 4294967296) = v by arith(hv)
  have e: bits_of_int(32, r) = v by defs(simp(m, mv), bits_of_int, pow2)
  show by ex_intro({r}, simp(hr1, e, ho))
qed

// ----------------------------------------------------------------------
//  Reads of several bytes: a natural below 256^n; a read split in two (the
//  bitfields of a word read in parts); a bitfield's load

// (a read of n bytes: a natural below 256^n)
theorem g.bytes_bound: all vm a n. vm.bytes in fn_space(bits(64), bits(8)) -> n in omega ->
  gimple.bytes_at(vm, a, n) in omega && int_lt(gimple.bytes_at(vm, a, n), int_pow(256, n))
proof
  fix vm a n
  assume hb hn
  let B := vm.bytes
  let F(j) := int_mul(B[bits_add(64, a, bits_of_int(64, j))], int_pow(256, j))
  have s: all i. i in omega -> int_sum(0, i, j. F(j)) in omega && int_lt(int_sum(0, i, j. F(j)), int_pow(256, i)) proof
    have base: int_sum(0, 0, j. F(j)) in omega && int_lt(int_sum(0, 0, j. F(j)), int_pow(256, 0)) proof
      have r0 := rec({nat_rec(empty, k v. int_add(v, F(int_add(0, k))), 0)})
      have z: int_sum(0, 0, j. F(j)) = 0 by defs(simp(r0), int_sum)
      show by simp(z)
    qed
    have step: all i. i in omega -> int_sum(0, i, j. F(j)) in omega && int_lt(int_sum(0, i, j. F(j)), int_pow(256, i)) ->
        int_sum(0, int_add(i, 1), j. F(j)) in omega && int_lt(int_sum(0, int_add(i, 1), j. F(j)), int_pow(256, int_add(i, 1))) proof
      fix i
      assume hi ih
      have uF: int_sum(0, int_add(i, 1), j. F(j)) = int_add(int_sum(0, i, j. F(j)), F(i))
        by defs(simp(hi, rec({nat_rec(empty, k v. int_add(v, F(int_add(0, k))), int_add(i, 1))}, hi)), int_sum)
      have by8 := apply(fn_space_app, hb, (bits_add(64, a, bits_of_int(64, i)) in bits(64) by simp()))
      let X := B[bits_add(64, a, bits_of_int(64, i))]
      have xb: X in omega && int_lt(X, 256) by simp(by8)
      let P := int_pow(256, i)
      have pp := apply(pow256_pos, hi)
      have po: P in omega by arith(pp)
      have p1 := mp(all_elim(mp(all_elim(pow256_add, {i}), hi), {1}), simp())
      have p1b: int_pow(256, int_add(i, 1)) = int_mul(P, 256) by simp(p1)
      have m0: int_mul(X, P) in omega by simp(xb, po)
      have m1: int_le(int_mul(X, P), int_mul(255, P)) by arith(xb, pp, refl({int_mul(int_sub(255, X), P)}))
      have so: int_sum(0, int_add(i, 1), j. F(j)) in omega by simp(uF, ih, m0)
      have sl: int_lt(int_sum(0, int_add(i, 1), j. F(j)), int_pow(256, int_add(i, 1))) by arith(uF, ih, m0, m1, p1b)
      show by taut(so, sl)
    qed
    show by induct(base, step)
  qed
  have sn := mp(all_elim(s, {n}), hn)
  show by defs(simp(sn), gimple.bytes_at)
qed

// (a read of n + m bytes: the first n, then m more above them)
theorem g.bytes_split: all vm a n m. a in bits(64) -> n in omega -> m in omega ->
  gimple.bytes_at(vm, a, int_add(n, m)) = int_add(gimple.bytes_at(vm, a, n), int_mul(int_pow(256, n), gimple.bytes_at(vm, bits_add(64, a, n), m)))
proof
  fix vm a n m
  assume ha hn hm
  let B := vm.bytes
  let F(j) := int_mul(B[bits_add(64, a, bits_of_int(64, j))], int_pow(256, j))
  let G(j) := int_mul(B[bits_add(64, bits_add(64, a, n), bits_of_int(64, j))], int_pow(256, j))
  let SN := int_sum(0, n, j. F(j))
  have s: all i. i in omega -> int_sum(0, int_add(n, i), j. F(j)) = int_add(SN, int_mul(int_pow(256, n), int_sum(0, i, j. G(j)))) proof
    have base: int_sum(0, int_add(n, 0), j. F(j)) = int_add(SN, int_mul(int_pow(256, n), int_sum(0, 0, j. G(j)))) proof
      have r0 := rec({nat_rec(empty, k v. int_add(v, G(int_add(0, k))), 0)})
      have z: int_sum(0, 0, j. G(j)) = 0 by defs(simp(r0), int_sum)
      have pn := apply(pow256_pos, hn)
      have m0: int_mul(int_pow(256, n), empty) = 0 by arith(pn)
      show by simp(z, hn, m0)
    qed
    have step: all i. i in omega -> int_sum(0, int_add(n, i), j. F(j)) = int_add(SN, int_mul(int_pow(256, n), int_sum(0, i, j. G(j)))) ->
        int_sum(0, int_add(n, int_add(i, 1)), j. F(j)) = int_add(SN, int_mul(int_pow(256, n), int_sum(0, int_add(i, 1), j. G(j)))) proof
      fix i
      assume hi ih
      have ni: int_add(n, i) in omega by simp(hn, hi)
      have e1: int_add(n, int_add(i, 1)) = int_add(int_add(n, i), 1) by arith(hn, hi)
      have uF: int_sum(0, int_add(int_add(n, i), 1), j. F(j)) = int_add(int_sum(0, int_add(n, i), j. F(j)), F(int_add(n, i)))
        by defs(simp(ni, rec({nat_rec(empty, k v. int_add(v, F(int_add(0, k))), int_add(int_add(n, i), 1))}, ni)), int_sum)
      have uG: int_sum(0, int_add(i, 1), j. G(j)) = int_add(int_sum(0, i, j. G(j)), G(i))
        by defs(simp(hi, rec({nat_rec(empty, k v. int_add(v, G(int_add(0, k))), int_add(i, 1))}, hi)), int_sum)
      // (the byte's address and its weight, from a or from a + n)
      have ad: bits_add(64, a, bits_of_int(64, int_add(n, i))) = bits_add(64, bits_add(64, a, n), bits_of_int(64, i)) by defs(arith(ha, hn, hi), bits_add, bits_of_int)
      have pw := mp(all_elim(mp(all_elim(pow256_add, {n}), hn), {i}), hi)
      have fg0: F(int_add(n, i)) = int_mul(B[bits_add(64, bits_add(64, a, n), bits_of_int(64, i))], int_mul(int_pow(256, n), int_pow(256, i))) by simp(ad, pw)
      have fg: F(int_add(n, i)) = int_mul(int_pow(256, n), G(i)) by arith(fg0)
      let SI := int_sum(0, i, j. G(j))
      have dist: int_mul(int_pow(256, n), int_add(SI, G(i))) = int_add(int_mul(int_pow(256, n), SI), int_mul(int_pow(256, n), G(i))) by arith()
      have g0: int_sum(0, int_add(int_add(n, i), 1), j. F(j)) = int_add(SN, int_mul(int_pow(256, n), int_add(SI, G(i)))) by arith(uF, ih, fg, dist)
      show by simp(e1, uG, g0)
    qed
    show by induct(base, step)
  qed
  have sm := mp(all_elim(s, {m}), hm)
  show by defs(simp(sm), gimple.bytes_at)
qed

theorem g.ldbf_det: all s p off size pos nb. s in univ(1) -> p in bits(64) -> off in bits(32) -> g.mem_defined(s, p, off, size, false) ->
  g.det(gimple.ldbf(p, off, size, pos, nb), s, ok(s, int_mod(int_div(gimple.bytes_at(s.vm, int_add(p, off), size), int_pow(2, pos)), int_pow(2, nb))))
proof
  fix s p off size pos nb
  assume hs hp ho hd
  have md := apply(g.mem_det, {s}, {p}, {off}, {size}, {false}, hs, hp, ho, hd)
  show proof
    fix o
    assume hr
    have b := apply(g.runs_elim, hr)
    show := apply(g.bind_inv, b, md)
  qed
qed
