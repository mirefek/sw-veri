// get_slot_index at -O0, run on the machine: from its entry until it
// returns, when its memory accesses succeed (the stack slot below rsp, the
// byte at rdi - 3, the return address), the exact final state (with the
// AF flag of `and` undefined: either value).
//
//   slc steps build/test_malloc_O0 build/musl_malloc_O0.core get_slot_index -o build/get_slot_index_steps.core
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core core/records.core \
//     core/loop.core build/musl_malloc_O0.core proofs/x86.core proofs/x86_code.core \
//     build/get_slot_index_steps.core proofs/get_slot_index_run.core
//
// The simulation chains the instructions' outcomes (`get_slot_index.ok_A`,
// generated by `slc steps`): one path per instruction. It unrolls the loop
// of run_to_return, so it rests on the open lemma `while_unroll`
// (core/loop.core).

theorem get_slot_index.run(m, o): abi.code_at(app(m, "vm"), 4202755, get_slot_index.code()) -> app(m, "rip") = 4202755 ->
  app(app(m, "gpr"), 4) in bits(64) -> app(app(m, "gpr"), 7) in bits(64) ->
  (all i. i in omega -> int_lt(i, 8) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, bits_add(64, app(app(m, "gpr"), 4), 18446744073709551608), bits_of_int(64, i)), 1)) -> (all i. i in omega -> int_lt(i, 8) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, bits_add(64, app(app(m, "gpr"), 4), 18446744073709551608), bits_of_int(64, i)), 0)) -> (all i. i in omega -> int_lt(i, 1) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, bits_add(64, app(app(m, "gpr"), 7), 18446744073709551613), bits_of_int(64, i)), 0)) -> (all i. i in omega -> int_lt(i, 8) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, app(app(m, "gpr"), 4), bits_of_int(64, i)), 0)) ->
  runs(abi.run_to_return(), m, o) ->
  ex af. (af = false || af = true) && o = ok(fn_update(fn_update(fn_update(fn_update(m, "vm", fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), bits_add(64, app(app(m, "gpr"), 4), 18446744073709551608), 8, app(app(m, "gpr"), 7)))), "flags", fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(app(m, "flags"), "zf", bits_and(32, x86_64_linux.le(app(fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), bits_add(64, app(app(m, "gpr"), 4), 18446744073709551608), 8, app(app(m, "gpr"), 7))), "bytes"), bits_add(64, app(app(m, "gpr"), 7), 18446744073709551613), 1), 31) = 0), "sf", bit(bits_and(32, x86_64_linux.le(app(fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), bits_add(64, app(app(m, "gpr"), 4), 18446744073709551608), 8, app(app(m, "gpr"), 7))), "bytes"), bits_add(64, app(app(m, "gpr"), 7), 18446744073709551613), 1), 31), 31)), "pf", x86_64_linux.even_parity(bits_slice(bits_and(32, x86_64_linux.le(app(fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), bits_add(64, app(app(m, "gpr"), 4), 18446744073709551608), 8, app(app(m, "gpr"), 7))), "bytes"), bits_add(64, app(app(m, "gpr"), 7), 18446744073709551613), 1), 31), 7, 0))), "cf", false), "of", false), "af", af)), "gpr", fn_update(fn_update(app(m, "gpr"), 0, bits_and(32, x86_64_linux.le(app(fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), bits_add(64, app(app(m, "gpr"), 4), 18446744073709551608), 8, app(app(m, "gpr"), 7))), "bytes"), bits_add(64, app(app(m, "gpr"), 7), 18446744073709551613), 1), 31)), 4, bits_add(64, app(app(m, "gpr"), 4), 8))), "rip", x86_64_linux.le(app(app(m, "vm"), "bytes"), app(app(m, "gpr"), 4), 8)), empty)
proof
  assume hc: abi.code_at(app(m, "vm"), 4202755, get_slot_index.code())
  assume hr: app(m, "rip") = 4202755
  assume hsp: app(app(m, "gpr"), 4) in bits(64)
  assume hdi: app(app(m, "gpr"), 7) in bits(64)
  assume a1: (all i. i in omega -> int_lt(i, 8) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, bits_add(64, app(app(m, "gpr"), 4), 18446744073709551608), bits_of_int(64, i)), 1))
  assume a2: (all i. i in omega -> int_lt(i, 8) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, bits_add(64, app(app(m, "gpr"), 4), 18446744073709551608), bits_of_int(64, i)), 0))
  assume a4: (all i. i in omega -> int_lt(i, 1) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, bits_add(64, app(app(m, "gpr"), 7), 18446744073709551613), bits_of_int(64, i)), 0))
  assume a7: (all i. i in omega -> int_lt(i, 8) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, app(app(m, "gpr"), 4), bits_of_int(64, i)), 0))
  assume h: runs(abi.run_to_return(), m, o)
  have r := symex(h, hc, hr, hsp, hdi, a1, a2, a4, a7, get_slot_index.ok_402103, get_slot_index.ok_402108, get_slot_index.ok_40210d, get_slot_index.ok_402111, get_slot_index.ok_402114, get_slot_index.ok_402117, get_slot_index.ok_40211a)
  show by simp(r, hsp, hdi)
qed
