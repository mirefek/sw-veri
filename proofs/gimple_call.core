// Readable GIMPLE calls (layers/gimple.sl, `call_at`): their outcomes from
// the choices the bridge makes -- the stack overflowing before the callee
// runs, the call undefined, the callee's outcomes through the caller.
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core core/records.core \
//     core/list.core core/loop.core build/c_mallocng_malloc.core proofs/x86.core proofs/gimple.core proofs/gimple_call.core

// (a list built element by element: its first i elements, then the next)
theorem gc.build_snoc(i, x. r): i in omega -> seq_concat(fn_build(i, x. r(x)), seq_one(r(i))) = fn_build(succ(i), x. r(x))
proof
  assume hi: i in omega
  have dm := fn_build_dom[d := i, v := x. r(x)]
  have e0: int_add(i, 0) = i by arith(hi)
  let B := set_image(seq_one(r(i)), x0. pair(int_add(dom(fn_build(i, x. r(x))), fst(x0)), snd(x0)))
  have g: all z. z in seq_concat(fn_build(i, x. r(x)), seq_one(r(i))) <-> z in fn_build(succ(i), x. r(x)) proof
    fix z
    have u := union2_iff[a := fn_build(i, x. r(x)), b := B, z := z]
    have ia := set_image_def[s := i, f := x. pair(x, r(x)), y := z]
    have ib := set_image_def[s := seq_one(r(i)), f := x0. pair(int_add(dom(fn_build(i, x. r(x))), fst(x0)), snd(x0)), y := z]
    have b1: (ex x0. x0 in seq_one(r(i)) && pair(int_add(dom(fn_build(i, x. r(x))), fst(x0)), snd(x0)) = z) -> z = pair(i, r(i)) proof
      assume e: ex x0. x0 in seq_one(r(i)) && pair(int_add(dom(fn_build(i, x. r(x))), fst(x0)), snd(x0)) = z
      obtain x0, h0 from e
      have xs0: x0 in seq_one(r(i)) by taut(h0)
      have xs: x0 in single(pair(0, r(i))) by defs(xs0, seq_one)
      have xe := mp(single_elim[a := pair(0, r(i)), z := x0], xs)
      have h2: pair(int_add(dom(fn_build(i, x. r(x))), fst(x0)), snd(x0)) = z by taut(h0)
      have h1 := rewrite(xe, h2)
      show by simp(h1, dm, e0)
    qed
    have b2: z = pair(i, r(i)) -> (ex x0. x0 in seq_one(r(i)) && pair(int_add(dom(fn_build(i, x. r(x))), fst(x0)), snd(x0)) = z) proof
      assume ez: z = pair(i, r(i))
      have m0: pair(0, r(i)) in seq_one(r(i)) by defs(single_intro[a := pair(0, r(i))], seq_one)
      have q: pair(int_add(dom(fn_build(i, x. r(x))), fst(pair(0, r(i)))), snd(pair(0, r(i)))) = z by simp(ez, dm, e0)
      show by ex_intro({pair(0, r(i))}, taut(m0, q))
    qed
    have ia2: z in fn_build(i, x. r(x)) <-> (ex x. x in i && pair(x, r(x)) = z) by defs(ia, fn_build)
    have l: z in seq_concat(fn_build(i, x. r(x)), seq_one(r(i))) <-> (ex x. x in i && pair(x, r(x)) = z) || z = pair(i, r(i))
      by defs(taut(u, ia2, ib, b1, b2), seq_concat)
    have ic := set_image_def[s := succ(i), f := x. pair(x, r(x)), y := z]
    have r1: (ex x. x in succ(i) && pair(x, r(x)) = z) -> (ex x. x in i && pair(x, r(x)) = z) || z = pair(i, r(i)) proof
      assume e: ex x. x in succ(i) && pair(x, r(x)) = z
      obtain x, h0 from e
      have xu0: x in succ(i) by taut(h0)
      have xu: x in union2(i, single(i)) by defs(xu0, succ)
      have xs: x in i || x in single(i) by taut(union2_iff[a := i, b := single(i), z := x], xu)
      have pz: pair(x, r(x)) = z by taut(h0)
      have c1: x in i -> (ex x. x in i && pair(x, r(x)) = z) proof
        assume xi: x in i
        show by ex_intro({x}, taut(xi, pz))
      qed
      have c2: x in single(i) -> z = pair(i, r(i)) proof
        assume xi: x in single(i)
        have xe := mp(single_elim[a := i, z := x], xi)
        show by simp(rewrite(xe, pz))
      qed
      show by taut(xs, c1, c2)
    qed
    have r2: (ex x. x in i && pair(x, r(x)) = z) || z = pair(i, r(i)) -> (ex x. x in succ(i) && pair(x, r(x)) = z) proof
      assume h: (ex x. x in i && pair(x, r(x)) = z) || z = pair(i, r(i))
      have c1: (ex x. x in i && pair(x, r(x)) = z) -> (ex x. x in succ(i) && pair(x, r(x)) = z) proof
        assume e: ex x. x in i && pair(x, r(x)) = z
        obtain x, h0 from e
        have xi: x in i by taut(h0)
        have xu: x in union2(i, single(i)) by taut(union2_iff[a := i, b := single(i), z := x], xi)
        have xs: x in succ(i) by defs(xu, succ)
        show by ex_intro({x}, taut(xs, h0))
      qed
      have c2: z = pair(i, r(i)) -> (ex x. x in succ(i) && pair(x, r(x)) = z) proof
        assume ez: z = pair(i, r(i))
        have xu: i in union2(i, single(i)) by taut(union2_iff[a := i, b := single(i), z := i], single_intro[a := i])
        have xs: i in succ(i) by defs(xu, succ)
        show by ex_intro({i}, taut(xs, sym(ez)))
      qed
      show by taut(h, c1, c2)
    qed
    have ic2: z in fn_build(succ(i), x. r(x)) <-> (ex x. x in succ(i) && pair(x, r(x)) = z) by defs(ic, fn_build)
    have rr: z in fn_build(succ(i), x. r(x)) <-> (ex x. x in i && pair(x, r(x)) = z) || z = pair(i, r(i)) by taut(ic2, r1, r2)
    show by taut(l, rr)
  qed
  show := mp(set_ext[a := seq_concat(fn_build(i, x. r(x)), seq_one(r(i))), b := fn_build(succ(i), x. r(x))], g)
qed

// (no elements: the empty list)
theorem gc.build_empty(x. r): fn_build(0, x. r(x)) = empty
proof
  have g: all z. !(z in fn_build(0, x. r(x))) proof
    fix z
    have n: z in fn_build(0, x. r(x)) -> false proof
      assume h: z in fn_build(0, x. r(x))
      have h2: z in set_image(empty, x. pair(x, r(x))) by defs(rewrite(lit_zero, h), fn_build)
      have e: ex x. x in empty && pair(x, r(x)) = z by taut(set_image_def[s := empty, f := x. pair(x, r(x)), y := z], h2)
      obtain x, hx from e
      show by taut(hx, empty_mem[x := x])
    qed
    show by taut(n)
  qed
  show := mp(empty_ext[y := fn_build(0, x. r(x))], g)
qed

// (one pass of the arguments' loop: the next value x appended)
theorem gc.args_body: all w args b i x o. int_lt(i, seq_len(args)) -> x in bits(64) -> x in gimple.in_reg(fst(app(args, i)), snd(app(args, i))) ->
  o = ok(pair(w, pair(seq_concat(b, seq_one(x)), int_add(i, 1))), empty) ->
  (int_lt(snd(snd(pair(w, pair(b, i)))), seq_len(args)) && letin(snd(snd(pair(w, pair(b, i)))), x8. any_rel(x9. x9 in bits(64) &&
      x9 in gimple.in_reg(fst(app(args, x8)), snd(app(args, x8))), x9. letin(seq_concat(fst(snd(pair(w, pair(b, i)))), seq_one(x9)), x10. o = ok(pair(fst(pair(w, pair(b, i))), pair(x10, int_add(snd(snd(pair(w, pair(b, i)))), 1))), empty))))) ||
    (!int_lt(snd(snd(pair(w, pair(b, i)))), seq_len(args)) && o = exc(pair(fst(pair(w, pair(b, i))), pair(fst(snd(pair(w, pair(b, i)))), snd(snd(pair(w, pair(b, i)))))), pair("brk", empty)))
proof
  fix w
  fix args
  fix b
  fix i
  fix x
  fix o
  assume hl: int_lt(i, seq_len(args))
  assume hb: x in bits(64)
  assume hx: x in gimple.in_reg(fst(app(args, i)), snd(app(args, i)))
  assume eo: o = ok(pair(w, pair(seq_concat(b, seq_one(x)), int_add(i, 1))), empty)
  have ex1: ex x9. (x9 in bits(64) && x9 in gimple.in_reg(fst(app(args, i)), snd(app(args, i)))) && o = ok(pair(w, pair(seq_concat(b, seq_one(x9)), int_add(i, 1))), empty)
    by ex_intro({x}, taut(hb, hx, eo))
  have a: any_rel(x9. x9 in bits(64) && x9 in gimple.in_reg(fst(app(args, i)), snd(app(args, i))), x9. o = ok(pair(w, pair(seq_concat(b, seq_one(x9)), int_add(i, 1))), empty))
    by defs(taut(ex1), any_rel)
  let H(ii, bb, ww) := (int_lt(ii, seq_len(args)) && letin(ii, x8. any_rel(x9. x9 in bits(64) &&
      x9 in gimple.in_reg(fst(app(args, x8)), snd(app(args, x8))), x9. letin(seq_concat(bb, seq_one(x9)), x10. o = ok(pair(ww, pair(x10, int_add(ii, 1))), empty))))) ||
    (!int_lt(ii, seq_len(args)) && o = exc(pair(ww, pair(bb, ii)), pair("brk", empty)))
  have h0: H(i, b, w) by defs(taut(hl, a), letin)
  have e1: i = snd(snd(pair(w, pair(b, i)))) by simp()
  have e2: b = fst(snd(pair(w, pair(b, i)))) by simp()
  have e3: w = fst(pair(w, pair(b, i))) by simp()
  have h1 := subst({y. H(y, b, w)}, e1, h0)
  have h2 := subst({y. H(snd(snd(pair(w, pair(b, i)))), y, w)}, e2, h1)
  show := subst({y. H(snd(snd(pair(w, pair(b, i)))), fst(snd(pair(w, pair(b, i)))), y)}, e3, h2)
qed

// The call's arguments into registers: any values r(i) representing them
// (in_reg), in order -- the loop ends with the list of them.
theorem gc.args_loop(x. r): all w args n. n = seq_len(args) -> n in omega ->
  (all i. i in omega -> int_lt(i, n) -> r(i) in bits(64) && r(i) in gimple.in_reg(fst(app(args, i)), snd(app(args, i)))) ->
  while_rel(pair(w, pair(empty, 0)), x6. true, x6 x7. (int_lt(snd(snd(x6)), seq_len(args)) && letin(snd(snd(x6)), x8. any_rel(x9. x9 in bits(64) &&
      x9 in gimple.in_reg(fst(app(args, x8)), snd(app(args, x8))), x9. letin(seq_concat(fst(snd(x6)), seq_one(x9)), x10. x7 = ok(pair(fst(x6), pair(x10, int_add(snd(snd(x6)), 1))), empty))))) ||
      (!int_lt(snd(snd(x6)), seq_len(args)) && x7 = exc(pair(fst(x6), pair(fst(snd(x6)), snd(snd(x6)))), pair("brk", empty))),
    x6. fn_update(empty, "os.events", app(app(fst(x6), "os"), "events")), exc(pair(w, pair(fn_build(n, x. r(x)), n)), pair("brk", empty)))
proof
  fix w
  fix args
  fix n
  assume hn: n = seq_len(args)
  assume ho: n in omega
  assume hr: all i. i in omega -> int_lt(i, n) -> r(i) in bits(64) && r(i) in gimple.in_reg(fst(app(args, i)), snd(app(args, i)))
  let F := fn_build(omega, i. pair(w, pair(fn_build(i, x. r(x)), i)))
  have fi: all i. i in omega -> app(F, i) = pair(w, pair(fn_build(i, x. r(x)), i)) proof
    fix i
    assume io: i in omega
    show := mp(app_fn_build[d := omega, v := i. pair(w, pair(fn_build(i, x. r(x)), i)), a := i], io)
  qed
  have zo: 0 in omega := rewrite(sym(lit_zero), omega_zero)
  have f0a := mp(all_elim(fi, {0}), zo)
  have be := gc.build_empty[r := x. r(x)]
  have f0b := rewrite(be, f0a)
  have f0: app(F, empty) = pair(w, pair(empty, 0)) := subst({y. app(F, y) = pair(w, pair(empty, 0))}, lit_zero, f0b)
  // each element in turn
  have st: all i. i in n -> true && ((int_lt(snd(snd(app(F, i))), seq_len(args)) && letin(snd(snd(app(F, i))), x8. any_rel(x9. x9 in bits(64) &&
      x9 in gimple.in_reg(fst(app(args, x8)), snd(app(args, x8))), x9. letin(seq_concat(fst(snd(app(F, i))), seq_one(x9)), x10. ok(app(F, succ(i)), empty) = ok(pair(fst(app(F, i)), pair(x10, int_add(snd(snd(app(F, i))), 1))), empty))))) ||
      (!int_lt(snd(snd(app(F, i))), seq_len(args)) && ok(app(F, succ(i)), empty) = exc(pair(fst(app(F, i)), pair(fst(snd(app(F, i))), snd(snd(app(F, i))))), pair("brk", empty)))) proof
    fix i
    assume hi: i in n
    have io := mp(mp(nat_elem[k := n, i := i], ho), hi)
    have il: int_lt(i, n) by arith(io, ho, hi)
    have es: succ(i) = int_add(i, 1) by arith(io)
    have so := mp(omega_succ[n := i], io)
    have fa := mp(all_elim(fi, {i}), io)
    have fb := mp(all_elim(fi, {succ(i)}), so)
    have sn := gc.build_snoc[i := i, r := x. r(x)]
    have sn2 := mp(sn, io)
    have ri := mp(mp(all_elim(hr, {i}), io), il)
    have il2: int_lt(i, seq_len(args)) := rewrite(hn, il)
    have q: ok(app(F, succ(i)), empty) = ok(pair(w, pair(seq_concat(fn_build(i, x. r(x)), seq_one(r(i))), int_add(i, 1))), empty) by simp(fb, sn2, es)
    have rb: r(i) in bits(64) by taut(ri)
    have rg: r(i) in gimple.in_reg(fst(app(args, i)), snd(app(args, i))) by taut(ri)
    have bd := apply(gc.args_body, {w}, {args}, {fn_build(i, x. r(x))}, {i}, {r(i)}, {ok(app(F, succ(i)), empty)}, il2, rb, rg, q)
    have bd2 := rewrite(sym(fa), bd)
    show by taut(bd2)
  qed
  // and the end
  have fn := mp(all_elim(fi, {n}), ho)
  have nl0: !int_lt(n, n) by arith(ho)
  have nl := subst({y. !int_lt(n, y)}, hn, nl0)
  have bk: ((int_lt(snd(snd(app(F, n))), seq_len(args)) && letin(snd(snd(app(F, n))), x8. any_rel(x9. x9 in bits(64) &&
      x9 in gimple.in_reg(fst(app(args, x8)), snd(app(args, x8))), x9. letin(seq_concat(fst(snd(app(F, n))), seq_one(x9)), x10. exc(pair(w, pair(fn_build(n, x. r(x)), n)), pair("brk", empty)) = ok(pair(fst(app(F, n)), pair(x10, int_add(snd(snd(app(F, n))), 1))), empty))))) ||
      (!int_lt(snd(snd(app(F, n))), seq_len(args)) && exc(pair(w, pair(fn_build(n, x. r(x)), n)), pair("brk", empty)) = exc(pair(fst(app(F, n)), pair(fst(snd(app(F, n))), snd(snd(app(F, n))))), pair("brk", empty))))
    by simp(fn, nl)
  have nok: !is_ok(exc(pair(w, pair(fn_build(n, x. r(x)), n)), pair("brk", empty))) proof
    have c: is_ok(exc(pair(w, pair(fn_build(n, x. r(x)), n)), pair("brk", empty))) -> false proof
      assume h: is_ok(exc(pair(w, pair(fn_build(n, x. r(x)), n)), pair("brk", empty)))
      obtain a, h1 from expand(h, is_ok)
      obtain b, h2 from h1
      show by simp(h2)
    qed
    show by taut(c)
  qed
  show := mp(while_prefix[l0 := pair(w, pair(empty, 0)), c := x6. true,
    b := x6 x7. (int_lt(snd(snd(x6)), seq_len(args)) && letin(snd(snd(x6)), x8. any_rel(x9. x9 in bits(64) &&
      x9 in gimple.in_reg(fst(app(args, x8)), snd(app(args, x8))), x9. letin(seq_concat(fst(snd(x6)), seq_one(x9)), x10. x7 = ok(pair(fst(x6), pair(x10, int_add(snd(snd(x6)), 1))), empty))))) ||
      (!int_lt(snd(snd(x6)), seq_len(args)) && x7 = exc(pair(fst(x6), pair(fst(snd(x6)), snd(snd(x6)))), pair("brk", empty))),
    tr := x6. fn_update(empty, "os.events", app(app(fst(x6), "os"), "events")), r := exc(pair(w, pair(fn_build(n, x. r(x)), n)), pair("brk", empty)), f := F, k := n],
    ho, f0, st, taut(), bk, nok)
qed

// a call may overflow the stack first: the world as it is
theorem gc.call_at_ovf: all low hi g args w. w in univ(1) ->
  runs(gimple.call_at(low, hi, g, args), w, exc(w, exc_val("stack_overflow", empty)))
proof
  fix low
  fix hi
  fix g
  fix args
  fix w
  assume hw: w in univ(1)
  have eu: exc_val("stack_overflow", empty) in univ(1) by defs(simp(), exc_val)
  show by simp(hw, eu, keep(gimple.callee_world.get, gimple.callee_world.set, gimple.frame_at_call, gimple.in_reg, abi.thread_ok, abi.stack_ok))
qed

theorem gc.call1_ovf: all g args w. w in univ(1) ->
  runs(gimple.call1(g, args), w, exc(w, exc_val("stack_overflow", empty)))
proof
  fix g
  fix args
  fix w
  assume hw: w in univ(1)
  have c := apply(gc.call_at_ovf, {app(w, "sp")}, {app(w, "sp")}, {g}, {args}, hw)
  have eu: exc_val("stack_overflow", empty) in univ(1) by defs(simp(), exc_val)
  show by simp(hw, c, eu, keep(gimple.call_at))
qed
