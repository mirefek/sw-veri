// Readable GIMPLE's calls (layers/gimple.sl, `call`, `call1`): the callee on
// the caller's world. Its outcomes: a stack overflow before the callee runs
// or after it returns; undefined behavior if the thread pointer or a
// stack's guard gap is broken; else the callee's return, raise or
// divergence.

// the arguments in registers, as the call passes them
abbrev gc.regs_ok(regs, args) := regs in list_type(bits(64)) && seq_len(regs) = seq_len(args) &&
  (all x4. x4 in omega -> int_lt(x4, seq_len(args)) -> app(regs, x4) in gimple.in_reg(fst(app(args, x4)), snd(app(args, x4))))
// the world sound for a call (as the ABI requires at every call)
abbrev gc.sound(w) := abi.thread_ok(app(w, "vm"), app(w, "fs_base")) && abi.stack_gap_free(app(w, "vm"))
// the callee kept the stack's pages (where its callers' frames are)
abbrev gc.keeps_stack(w, w4) := all p. p in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) ->
  !(app(app(app(w, "vm"), "pages"), p) = none) && app(snd(app(app(app(w, "vm"), "pages"), p)), "kind") = 2 -> app(app(app(w4, "vm"), "pages"), p) = app(app(app(w, "vm"), "pages"), p)

theorem gc.call_ovf: all g args w. w in univ(1) -> runs(gimple.call(g, args), w, exc(w, exc_val("stack_overflow", empty)))
proof
  fix g args w
  assume hw
  have eu: exc_val("stack_overflow", empty) in univ(1) by defs(simp(), exc_val)
  show by defs(simp(hw, eu), gimple.call)
qed

theorem gc.call_ub: all g args w regs x e. w in univ(1) -> x in univ(1) -> e in univ(1) -> gc.regs_ok(regs, args) -> !gc.sound(w) ->
  runs(gimple.call(g, args), w, exc(x, e))
proof
  fix g args w regs x e
  assume hw hx he hr hn
  show by defs(simp(hw, hx, he, hr, hn), gimple.call)
qed

theorem gc.call_ok: all g args w regs w4 r0 r1. w in univ(1) -> w4 in univ(1) -> r0 in univ(1) -> r1 in univ(1) -> gc.regs_ok(regs, args) -> gc.sound(w) ->
  runs(app(g, regs), w, ok(w4, pair(r0, r1))) -> gc.keeps_stack(w, w4) -> runs(gimple.call(g, args), w, ok(w4, pair(r0, r1)))
proof
  fix g args w regs w4 r0 r1
  assume hw hw4 h0 h1 hr hs hc hk
  show by defs(simp(hw, hw4, h0, h1, hr, hs, hc, hk), gimple.call)
qed

theorem gc.call_ovf_after: all g args w regs w4 r. w in univ(1) -> w4 in univ(1) -> gc.regs_ok(regs, args) -> gc.sound(w) ->
  runs(app(g, regs), w, ok(w4, r)) -> gc.keeps_stack(w, w4) -> runs(gimple.call(g, args), w, exc(w4, exc_val("stack_overflow", empty)))
proof
  fix g args w regs w4 r
  assume hw hw4 hr hs hc hk
  have eu: exc_val("stack_overflow", empty) in univ(1) by defs(simp(), exc_val)
  show by defs(simp(hw, hw4, hr, hs, hc, hk, eu), gimple.call)
qed

// a callee that changed the stack's pages: the call undefined
theorem gc.call_ub_after: all g args w regs w4 r x e. w in univ(1) -> w4 in univ(1) -> x in univ(1) -> e in univ(1) -> gc.regs_ok(regs, args) -> gc.sound(w) ->
  runs(app(g, regs), w, ok(w4, r)) -> !gc.keeps_stack(w, w4) -> runs(gimple.call(g, args), w, exc(x, e))
proof
  fix g args w regs w4 r x e
  assume hw hw4 hx he hr hs hc hk
  show by defs(simp(hw, hw4, hx, he, hr, hs, hc, hk), gimple.call)
qed

theorem gc.call_exc: all g args w regs x e. w in univ(1) -> x in univ(1) -> e in univ(1) -> gc.regs_ok(regs, args) -> gc.sound(w) ->
  runs(app(g, regs), w, exc(x, e)) -> runs(gimple.call(g, args), w, exc(x, e))
proof
  fix g args w regs x e
  assume hw hx he hr hs hc
  show by defs(simp(hw, hx, he, hr, hs, hc), gimple.call)
qed

theorem gc.call_div: all g args w regs t. w in univ(1) -> t in univ(1) -> gc.regs_ok(regs, args) -> gc.sound(w) ->
  runs(app(g, regs), w, diverge(t)) -> runs(gimple.call(g, args), w, diverge(t))
proof
  fix g args w regs t
  assume hw ht hr hs hc
  show by defs(simp(hw, ht, hr, hs, hc), gimple.call)
qed

// call1: the value in rax only
theorem gc.call1_ok: all g args w w4 r0 r1. w in univ(1) -> w4 in univ(1) -> r0 in univ(1) -> r1 in univ(1) ->
  runs(gimple.call(g, args), w, ok(w4, pair(r0, r1))) -> runs(gimple.call1(g, args), w, ok(w4, r0))
proof
  fix g args w w4 r0 r1
  assume hw hw4 h0 h1 hc
  show by simp(hw, hw4, h0, h1, hc, keep(gimple.call))
qed

theorem gc.call1_exc: all g args w x e. w in univ(1) -> x in univ(1) -> e in univ(1) ->
  runs(gimple.call(g, args), w, exc(x, e)) -> runs(gimple.call1(g, args), w, exc(x, e))
proof
  fix g args w x e
  assume hw hx he hc
  show by simp(hw, hx, he, hc, keep(gimple.call))
qed

theorem gc.call1_div: all g args w t. w in univ(1) -> t in univ(1) ->
  runs(gimple.call(g, args), w, diverge(t)) -> runs(gimple.call1(g, args), w, diverge(t))
proof
  fix g args w t
  assume hw ht hc
  show by simp(hw, ht, hc, keep(gimple.call))
qed

theorem gc.call1_ovf: all g args w. w in univ(1) -> runs(gimple.call1(g, args), w, exc(w, exc_val("stack_overflow", empty)))
proof
  fix g args w
  assume hw
  have eu: exc_val("stack_overflow", empty) in univ(1) by defs(simp(), exc_val)
  show := apply(gc.call1_exc, {g}, {args}, hw, hw, eu, mp(all_elim(gc.call_ovf, {g}, {args}, {w}), hw))
qed
