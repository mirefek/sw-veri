// Readable GIMPLE's calls (layers/gimple.sl, `call`, `call1`): the callee on
// the caller's world. Its outcomes: a stack overflow before the callee runs
// or after it returns; undefined behavior if the thread pointer is broken;
// else the callee's return (the caller's stack objects back), raise or
// divergence. (The stack is not in the world: no growth, no guard gap
// here -- the ABI bridge's business.)

// the arguments in registers, as the call passes them
abbrev gc.regs_ok(regs, args) := regs in list_type(bits(64)) && seq_len(regs) = seq_len(args) &&
  (all x4. x4 in omega -> int_lt(x4, seq_len(args)) -> regs[x4] in gimple.in_reg(fst(args[x4]), snd(args[x4])))
// the world sound for a call (as the ABI requires at every call)
abbrev gc.sound(w) := abi.thread_ok(w.vm, w.fs_base)
// the page numbers
abbrev gc.PN := set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)))
// the callee's world w4 back with the caller's (w's) stack objects -- its
// own bytes the callee's -- and thread pointer
abbrev gc.back(w4, w) := fn_update(fn_update(w4, "objs", fn_update(w4.objs, "live", w.objs.live)), "fs_base", w.fs_base)

// (a world's bytes with their own stack objects: themselves)
theorem gc.objs_same: all w. w in abi.World -> fn_update(w.objs, "live", w.objs.live) = w.objs
proof
  fix w
  assume hw
  have ot: w.objs in abi.Objs by simp(expand(hw, abi.World))
  have of od := (is_fun(w.objs) && dom(w.objs) = insert("live", insert("c_bytes", empty)) by taut(set_select_def[s := powerset(cart(insert("live", insert("c_bytes", empty)), univ(1))),
    p := x0. ((is_fun(x0) && dom(x0) = insert("live", insert("c_bytes", empty))) && x0.live in set_type(omega)) && x0.c_bytes in set_type(omega), z := w.objs], expand(ot, abi.Objs)))
  show := mp(fn_update_same[f := w.objs, k := "live"], of, ("live" in dom(w.objs) by simp(od)))
qed

// (a world with another memory, back with its own objects and thread
// pointer: itself)
theorem gc.back_vm: all w V. w in abi.World -> gc.back(fn_update(w, "vm", V), w) = fn_update(w, "vm", V)
proof
  fix w V
  assume hw
  have vfun: is_fun(w) by simp(expand(hw, abi.World))
  have vdom: "vm" in dom(w) by simp(expand(hw, abi.World))
  have od: "objs" in dom(w) by simp(expand(hw, abi.World))
  have fd: "fs_base" in dom(w) by simp(expand(hw, abi.World))
  have fW := mp(fn_update_fun[f := w, k := "vm", v := V], vfun)
  have dW := mp(fn_update_dom[f := w, k := "vm", v := V], vfun, vdom)
  have oW: "objs" in dom(fn_update(w, "vm", V)) := rewrite(sym(dW), od)
  have fW2: "fs_base" in dom(fn_update(w, "vm", V)) := rewrite(sym(dW), fd)
  have aW := mp(app_update_other[f := w, k := "vm", v := V, x := "objs"], simp())
  have aF := mp(app_update_other[f := w, k := "vm", v := V, x := "fs_base"], simp())
  have os := apply(gc.objs_same, hw)
  have b1: fn_update(fn_update(w, "vm", V), "objs", fn_update(fn_update(w, "vm", V).objs, "live", w.objs.live)) = fn_update(w, "vm", V)
    by simp(os, vfun, od, mp(fn_update_same[f := fn_update(w, "vm", V), k := "objs"], fW, oW))
  have b2: fn_update(fn_update(w, "vm", V), "fs_base", w.fs_base) = fn_update(w, "vm", V) := rewrite(aF, mp(fn_update_same[f := fn_update(w, "vm", V), k := "fs_base"], fW, fW2))
  show by simp(b1, b2, vfun, fd, od, os)
qed

// (a bind from a known run of its first part)
theorem gc.bind_ok(p, s1 v. k, s1 e. x, t. d): all s s1 v. runs(p, s, ok(s1, v)) -> k(s1, v) -> bind_rel(p, s, s1 v. k(s1, v), s1 e. x(s1, e), t. d(t))
proof
  fix s s1 v
  assume hr hk
  show by defs(ex_intro({ok(s1, v)}, simp(hr, hk)), bind_rel)
qed

theorem gc.bind_exc(p, s1 v. k, s1 e. x, t. d): all s s1 e. runs(p, s, exc(s1, e)) -> x(s1, e) -> bind_rel(p, s, s1 v. k(s1, v), s1 e. x(s1, e), t. d(t))
proof
  fix s s1 e
  assume hr hx
  show by defs(ex_intro({exc(s1, e)}, simp(hr, hx)), bind_rel)
qed

theorem gc.bind_div(p, s1 v. k, s1 e. x, t. d): all s t. runs(p, s, diverge(t)) -> d(t) -> bind_rel(p, s, s1 v. k(s1, v), s1 e. x(s1, e), t. d(t))
proof
  fix s t
  assume hr hd
  show by defs(ex_intro({diverge(t)}, simp(hr, hd)), bind_rel)
qed

// a call's parts (gimple.call): after the callee (from x3, its result x5,
// the call's outcome x1), the callee's part on from the world x0
abbrev gc.aft(x3, x5, x1) := ex x6. (x6 = exc(pair(x3, empty), pair("raise", exc_val("stack_overflow", empty))) || x6 = ok(pair(x3, empty), empty)) &&
  ((fst(x6) = 0 && x1 = ok(fst(out_state(x6)), pair(fst(x5), snd(x5)))) || ((((fst(x6) = 1 && fst(out_value(x6)) = "ret") && x1 = ok(fst(out_state(x6)), snd(out_value(x6)))) ||
  ((fst(x6) = 1 && fst(out_value(x6)) = "raise") && x1 = exc(fst(out_state(x6)), snd(out_value(x6))))) || (fst(x6) = 2 && x1 = diverge(snd(x6)))))
abbrev gc.cc(g, args, x0, x1) := bind_rel(gimple.call_callee(g, args), x0, x3 x4. letin(x4, x5. gc.aft(x3, x5, x1)), x3 x4. x1 = exc(x3, x4), x3. x1 = diverge(x3))

// (the call from the callee's part on: the call's run)
theorem gc.call_from: all g args w o. w in univ(1) -> pair(w, o) in univ(1) -> gc.cc(g, args, w, o) -> runs(gimple.call(g, args), w, o)
proof
  fix g args w o
  assume hw hp hc
  show by defs(simp(hp, hc, keep(gimple.call_callee)), gimple.call)
qed

// (after the callee, from w4 with the result r: the return or an overflow)
theorem gc.aft_ok: all w4 r. gc.aft(w4, r, ok(w4, pair(fst(r), snd(r))))
proof
  fix w4 r
  show by ex_intro({ok(pair(w4, empty), empty)}, simp())
qed

theorem gc.aft_ovf: all w4 r. gc.aft(w4, r, exc(w4, exc_val("stack_overflow", empty)))
proof
  fix w4 r
  show by ex_intro({exc(pair(w4, empty), pair("raise", exc_val("stack_overflow", empty)))}, simp())
qed

theorem gc.call_ovf: all g args w. w in univ(1) -> runs(gimple.call(g, args), w, exc(w, exc_val("stack_overflow", empty)))
proof
  fix g args w
  assume hw
  have eu: exc_val("stack_overflow", empty) in univ(1) by defs(simp(), exc_val)
  show by defs(simp(hw, eu), gimple.call)
qed

// The callee's part
theorem gc.cc_ub: all g args w regs x e. w in univ(1) -> x in univ(1) -> e in univ(1) -> gc.regs_ok(regs, args) -> !gc.sound(w) ->
  runs(gimple.call_callee(g, args), w, exc(x, e))
proof
  fix g args w regs x e
  assume hw hx he hr hn
  show by defs(simp(hw, hx, he, hr, hn), gimple.call_callee)
qed

theorem gc.cc_ub_div: all g args w regs t. w in univ(1) -> t in univ(1) -> gc.regs_ok(regs, args) -> !gc.sound(w) ->
  runs(gimple.call_callee(g, args), w, diverge(t))
proof
  fix g args w regs t
  assume hw ht hr hn
  show by defs(simp(hw, ht, hr, hn), gimple.call_callee)
qed

theorem gc.cc_ok: all g args w regs w4 r0 r1. w in univ(1) -> w4 in univ(1) -> r0 in univ(1) -> r1 in univ(1) -> gc.regs_ok(regs, args) -> gc.sound(w) ->
  runs(g[regs], w, ok(w4, pair(r0, r1))) -> runs(gimple.call_callee(g, args), w, ok(gc.back(w4, w), pair(r0, r1)))
proof
  fix g args w regs w4 r0 r1
  assume hw hw4 h0 h1 hr hs hc
  show by defs(simp(hw, hw4, h0, h1, hr, hs, hc), gimple.call_callee)
qed

theorem gc.cc_exc: all g args w regs x e. w in univ(1) -> x in univ(1) -> e in univ(1) -> gc.regs_ok(regs, args) -> gc.sound(w) ->
  runs(g[regs], w, exc(x, e)) -> runs(gimple.call_callee(g, args), w, exc(x, e))
proof
  fix g args w regs x e
  assume hw hx he hr hs hc
  show by defs(simp(hw, hx, he, hr, hs, hc), gimple.call_callee)
qed

theorem gc.cc_div: all g args w regs t. w in univ(1) -> t in univ(1) -> gc.regs_ok(regs, args) -> gc.sound(w) ->
  runs(g[regs], w, diverge(t)) -> runs(gimple.call_callee(g, args), w, diverge(t))
proof
  fix g args w regs t
  assume hw ht hr hs hc
  show by defs(simp(hw, ht, hr, hs, hc), gimple.call_callee)
qed

// The call: from w, the callee's outcome
theorem gc.call_ub: all g args w regs x e. w in univ(1) -> x in univ(1) -> e in univ(1) -> gc.regs_ok(regs, args) ->
  !gc.sound(w) -> runs(gimple.call(g, args), w, exc(x, e))
proof
  fix g args w regs x e
  assume hw hx he hr hn
  have c := apply(gc.cc_ub, {g}, {args}, {w}, {regs}, {x}, {e}, hw, hx, he, hr, hn)
  have b := apply(gc.bind_exc[p := gimple.call_callee(g, args), k := x3 x4. letin(x4, x5. gc.aft(x3, x5, exc(x, e))), x := x3 x4. exc(x, e) = exc(x3, x4), d := x3. exc(x, e) = diverge(x3)], c, refl({exc(x, e)}))
  show := apply(gc.call_from, hw, (pair(w, exc(x, e)) in univ(1) by simp(hw, hx, he)), b)
qed

theorem gc.call_ub_div: all g args w regs t. w in univ(1) -> t in univ(1) -> gc.regs_ok(regs, args) ->
  !gc.sound(w) -> runs(gimple.call(g, args), w, diverge(t))
proof
  fix g args w regs t
  assume hw ht hr hn
  have c := apply(gc.cc_ub_div, {g}, {args}, {w}, {regs}, {t}, hw, ht, hr, hn)
  have b := apply(gc.bind_div[p := gimple.call_callee(g, args), k := x3 x4. letin(x4, x5. gc.aft(x3, x5, diverge(t))), x := x3 x4. diverge(t) = exc(x3, x4), d := x3. diverge(t) = diverge(x3)], c, refl({diverge(t)}))
  show := apply(gc.call_from, hw, (pair(w, diverge(t)) in univ(1) by simp(hw, ht)), b)
qed

theorem gc.call_ok: all g args w regs w4 r0 r1. w in univ(1) -> w4 in univ(1) -> r0 in univ(1) -> r1 in univ(1) -> gc.regs_ok(regs, args) ->
  gc.sound(w) -> runs(g[regs], w, ok(w4, pair(r0, r1))) ->
  runs(gimple.call(g, args), w, ok(gc.back(w4, w), pair(r0, r1)))
proof
  fix g args w regs w4 r0 r1
  assume hw hw4 h0 h1 hr hs hc
  have bu: gc.back(w4, w) in univ(1) by simp(hw4, hw)
  have c := apply(gc.cc_ok, {g}, {args}, {w}, {regs}, {w4}, {r0}, {r1}, hw, hw4, h0, h1, hr, hs, hc)
  have a0 := all_elim(gc.aft_ok, {gc.back(w4, w)}, {pair(r0, r1)})
  have a1: letin(pair(r0, r1), x5. gc.aft(gc.back(w4, w), x5, ok(gc.back(w4, w), pair(r0, r1)))) by defs(simp(a0), letin)
  have b := apply(gc.bind_ok[p := gimple.call_callee(g, args), k := x3 x4. letin(x4, x5. gc.aft(x3, x5, ok(gc.back(w4, w), pair(r0, r1)))), x := x3 x4. ok(gc.back(w4, w), pair(r0, r1)) = exc(x3, x4), d := x3. ok(gc.back(w4, w), pair(r0, r1)) = diverge(x3)], c, a1)
  show := apply(gc.call_from, hw, (pair(w, ok(gc.back(w4, w), pair(r0, r1))) in univ(1) by simp(hw, bu, h0, h1)), b)
qed

theorem gc.call_ovf_after: all g args w regs w4 r0 r1. w in univ(1) -> w4 in univ(1) -> r0 in univ(1) -> r1 in univ(1) -> gc.regs_ok(regs, args) ->
  gc.sound(w) -> runs(g[regs], w, ok(w4, pair(r0, r1))) ->
  runs(gimple.call(g, args), w, exc(gc.back(w4, w), exc_val("stack_overflow", empty)))
proof
  fix g args w regs w4 r0 r1
  assume hw hw4 h0 h1 hr hs hc
  have bu: gc.back(w4, w) in univ(1) by simp(hw4, hw)
  have c0 := apply(gc.cc_ok, {g}, {args}, {w}, {regs}, {w4}, {r0}, {r1}, hw, hw4, h0, h1, hr, hs, hc)
  have a0 := all_elim(gc.aft_ovf, {gc.back(w4, w)}, {pair(r0, r1)})
  have a1: letin(pair(r0, r1), x5. gc.aft(gc.back(w4, w), x5, exc(gc.back(w4, w), exc_val("stack_overflow", empty)))) by defs(simp(a0), letin)
  have b := apply(gc.bind_ok[p := gimple.call_callee(g, args), k := x3 x4. letin(x4, x5. gc.aft(x3, x5, exc(gc.back(w4, w), exc_val("stack_overflow", empty)))), x := x3 x4. exc(gc.back(w4, w), exc_val("stack_overflow", empty)) = exc(x3, x4), d := x3. exc(gc.back(w4, w), exc_val("stack_overflow", empty)) = diverge(x3)], c0, a1)
  have eu: exc_val("stack_overflow", empty) in univ(1) by defs(simp(), exc_val)
  show := apply(gc.call_from, hw, (pair(w, exc(gc.back(w4, w), exc_val("stack_overflow", empty))) in univ(1) by simp(hw, bu, eu)), b)
qed

theorem gc.call_exc: all g args w regs x e. w in univ(1) -> x in univ(1) -> e in univ(1) -> gc.regs_ok(regs, args) -> gc.sound(w) ->
  runs(g[regs], w, exc(x, e)) -> runs(gimple.call(g, args), w, exc(x, e))
proof
  fix g args w regs x e
  assume hw hx he hr hs hc
  have c := apply(gc.cc_exc, {g}, {args}, {w}, {regs}, {x}, {e}, hw, hx, he, hr, hs, hc)
  have b := apply(gc.bind_exc[p := gimple.call_callee(g, args), k := x3 x4. letin(x4, x5. gc.aft(x3, x5, exc(x, e))), x := x3 x4. exc(x, e) = exc(x3, x4), d := x3. exc(x, e) = diverge(x3)], c, refl({exc(x, e)}))
  show := apply(gc.call_from, hw, (pair(w, exc(x, e)) in univ(1) by simp(hw, hx, he)), b)
qed

theorem gc.call_div: all g args w regs t. w in univ(1) -> t in univ(1) -> gc.regs_ok(regs, args) -> gc.sound(w) ->
  runs(g[regs], w, diverge(t)) -> runs(gimple.call(g, args), w, diverge(t))
proof
  fix g args w regs t
  assume hw ht hr hs hc
  have c := apply(gc.cc_div, {g}, {args}, {w}, {regs}, {t}, hw, ht, hr, hs, hc)
  have b := apply(gc.bind_div[p := gimple.call_callee(g, args), k := x3 x4. letin(x4, x5. gc.aft(x3, x5, diverge(t))), x := x3 x4. diverge(t) = exc(x3, x4), d := x3. diverge(t) = diverge(x3)], c, refl({diverge(t)}))
  show := apply(gc.call_from, hw, (pair(w, diverge(t)) in univ(1) by simp(hw, ht)), b)
qed

// call1: the value in rax only
theorem gc.call1_ok: all g args w w4 r0 r1. w in univ(1) -> w4 in univ(1) -> r0 in univ(1) -> r1 in univ(1) ->
  runs(gimple.call(g, args), w, ok(w4, pair(r0, r1))) -> runs(gimple.call1(g, args), w, ok(w4, r0))
proof
  fix g args w w4 r0 r1
  assume hw hw4 h0 h1 hc
  show by simp(hw, hw4, h0, h1, hc, keep(gimple.call))
qed

theorem gc.call1_exc: all g args w x e. w in univ(1) -> x in univ(1) -> e in univ(1) ->
  runs(gimple.call(g, args), w, exc(x, e)) -> runs(gimple.call1(g, args), w, exc(x, e))
proof
  fix g args w x e
  assume hw hx he hc
  show by simp(hw, hx, he, hc, keep(gimple.call))
qed

theorem gc.call1_div: all g args w t. w in univ(1) -> t in univ(1) ->
  runs(gimple.call(g, args), w, diverge(t)) -> runs(gimple.call1(g, args), w, diverge(t))
proof
  fix g args w t
  assume hw ht hc
  show by simp(hw, ht, hc, keep(gimple.call))
qed

theorem gc.call1_ovf: all g args w. w in univ(1) -> runs(gimple.call1(g, args), w, exc(w, exc_val("stack_overflow", empty)))
proof
  fix g args w
  assume hw
  have eu: exc_val("stack_overflow", empty) in univ(1) by defs(simp(), exc_val)
  show := apply(gc.call1_exc, {g}, {args}, hw, hw, eu, mp(all_elim(gc.call_ovf, {g}, {args}, {w}), hw))
qed

// ----------------------------------------------------------------------
//  call0 (layers/gimple.sl: a call before the thread is set up): no
//  check of the thread pointer, the callee's left as it leaves it

// the callee's world w4 back with the caller's (w's) stack objects
abbrev gc.back0(w4, w) := fn_update(w4, "objs", fn_update(w4.objs, "live", w.objs.live))
abbrev gc.cc0(g, args, x0, x1) := bind_rel(gimple.call0_callee(g, args), x0, x3 x4. letin(x4, x5. gc.aft(x3, x5, x1)), x3 x4. x1 = exc(x3, x4), x3. x1 = diverge(x3))

theorem gc.call0_from: all g args w o. w in univ(1) -> pair(w, o) in univ(1) -> gc.cc0(g, args, w, o) -> runs(gimple.call0(g, args), w, o)
proof
  fix g args w o
  assume hw hp hc
  show by defs(simp(hp, hc, keep(gimple.call0_callee)), gimple.call0)
qed

theorem gc.call0_ovf: all g args w. w in univ(1) -> runs(gimple.call0(g, args), w, exc(w, exc_val("stack_overflow", empty)))
proof
  fix g args w
  assume hw
  have eu: exc_val("stack_overflow", empty) in univ(1) by defs(simp(), exc_val)
  show by defs(simp(hw, eu), gimple.call0)
qed

theorem gc.cc0_ok: all g args w regs w4 r0 r1. w in univ(1) -> w4 in univ(1) -> r0 in univ(1) -> r1 in univ(1) -> gc.regs_ok(regs, args) ->
  runs(g[regs], w, ok(w4, pair(r0, r1))) -> runs(gimple.call0_callee(g, args), w, ok(gc.back0(w4, w), pair(r0, r1)))
proof
  fix g args w regs w4 r0 r1
  assume hw hw4 h0 h1 hr hc
  show by defs(simp(hw, hw4, h0, h1, hr, hc), gimple.call0_callee)
qed

theorem gc.cc0_exc: all g args w regs x e. w in univ(1) -> x in univ(1) -> e in univ(1) -> gc.regs_ok(regs, args) ->
  runs(g[regs], w, exc(x, e)) -> runs(gimple.call0_callee(g, args), w, exc(x, e))
proof
  fix g args w regs x e
  assume hw hx he hr hc
  show by defs(simp(hw, hx, he, hr, hc), gimple.call0_callee)
qed

theorem gc.cc0_div: all g args w regs t. w in univ(1) -> t in univ(1) -> gc.regs_ok(regs, args) ->
  runs(g[regs], w, diverge(t)) -> runs(gimple.call0_callee(g, args), w, diverge(t))
proof
  fix g args w regs t
  assume hw ht hr hc
  show by defs(simp(hw, ht, hr, hc), gimple.call0_callee)
qed

theorem gc.call0_ok: all g args w regs w4 r0 r1. w in univ(1) -> w4 in univ(1) -> r0 in univ(1) -> r1 in univ(1) -> gc.regs_ok(regs, args) ->
  runs(g[regs], w, ok(w4, pair(r0, r1))) -> runs(gimple.call0(g, args), w, ok(gc.back0(w4, w), pair(r0, r1)))
proof
  fix g args w regs w4 r0 r1
  assume hw hw4 h0 h1 hr hc
  have bu: gc.back0(w4, w) in univ(1) by simp(hw4, hw)
  have c := apply(gc.cc0_ok, {g}, {args}, {w}, {regs}, {w4}, {r0}, {r1}, hw, hw4, h0, h1, hr, hc)
  have a0 := all_elim(gc.aft_ok, {gc.back0(w4, w)}, {pair(r0, r1)})
  have a1: letin(pair(r0, r1), x5. gc.aft(gc.back0(w4, w), x5, ok(gc.back0(w4, w), pair(r0, r1)))) by defs(simp(a0), letin)
  have b := apply(gc.bind_ok[p := gimple.call0_callee(g, args), k := x3 x4. letin(x4, x5. gc.aft(x3, x5, ok(gc.back0(w4, w), pair(r0, r1)))), x := x3 x4. ok(gc.back0(w4, w), pair(r0, r1)) = exc(x3, x4), d := x3. ok(gc.back0(w4, w), pair(r0, r1)) = diverge(x3)], c, a1)
  show := apply(gc.call0_from, hw, (pair(w, ok(gc.back0(w4, w), pair(r0, r1))) in univ(1) by simp(hw, bu, h0, h1)), b)
qed

theorem gc.call0_ovf_after: all g args w regs w4 r0 r1. w in univ(1) -> w4 in univ(1) -> r0 in univ(1) -> r1 in univ(1) -> gc.regs_ok(regs, args) ->
  runs(g[regs], w, ok(w4, pair(r0, r1))) -> runs(gimple.call0(g, args), w, exc(gc.back0(w4, w), exc_val("stack_overflow", empty)))
proof
  fix g args w regs w4 r0 r1
  assume hw hw4 h0 h1 hr hc
  have bu: gc.back0(w4, w) in univ(1) by simp(hw4, hw)
  have c0 := apply(gc.cc0_ok, {g}, {args}, {w}, {regs}, {w4}, {r0}, {r1}, hw, hw4, h0, h1, hr, hc)
  have a0 := all_elim(gc.aft_ovf, {gc.back0(w4, w)}, {pair(r0, r1)})
  have a1: letin(pair(r0, r1), x5. gc.aft(gc.back0(w4, w), x5, exc(gc.back0(w4, w), exc_val("stack_overflow", empty)))) by defs(simp(a0), letin)
  have b := apply(gc.bind_ok[p := gimple.call0_callee(g, args), k := x3 x4. letin(x4, x5. gc.aft(x3, x5, exc(gc.back0(w4, w), exc_val("stack_overflow", empty)))), x := x3 x4. exc(gc.back0(w4, w), exc_val("stack_overflow", empty)) = exc(x3, x4), d := x3. exc(gc.back0(w4, w), exc_val("stack_overflow", empty)) = diverge(x3)], c0, a1)
  have eu: exc_val("stack_overflow", empty) in univ(1) by defs(simp(), exc_val)
  show := apply(gc.call0_from, hw, (pair(w, exc(gc.back0(w4, w), exc_val("stack_overflow", empty))) in univ(1) by simp(hw, bu, eu)), b)
qed

theorem gc.call0_exc: all g args w regs x e. w in univ(1) -> x in univ(1) -> e in univ(1) -> gc.regs_ok(regs, args) ->
  runs(g[regs], w, exc(x, e)) -> runs(gimple.call0(g, args), w, exc(x, e))
proof
  fix g args w regs x e
  assume hw hx he hr hc
  have c := apply(gc.cc0_exc, {g}, {args}, {w}, {regs}, {x}, {e}, hw, hx, he, hr, hc)
  have b := apply(gc.bind_exc[p := gimple.call0_callee(g, args), k := x3 x4. letin(x4, x5. gc.aft(x3, x5, exc(x, e))), x := x3 x4. exc(x, e) = exc(x3, x4), d := x3. exc(x, e) = diverge(x3)], c, refl({exc(x, e)}))
  show := apply(gc.call0_from, hw, (pair(w, exc(x, e)) in univ(1) by simp(hw, hx, he)), b)
qed

theorem gc.call0_div: all g args w regs t. w in univ(1) -> t in univ(1) -> gc.regs_ok(regs, args) ->
  runs(g[regs], w, diverge(t)) -> runs(gimple.call0(g, args), w, diverge(t))
proof
  fix g args w regs t
  assume hw ht hr hc
  have c := apply(gc.cc0_div, {g}, {args}, {w}, {regs}, {t}, hw, ht, hr, hc)
  have b := apply(gc.bind_div[p := gimple.call0_callee(g, args), k := x3 x4. letin(x4, x5. gc.aft(x3, x5, diverge(t))), x := x3 x4. diverge(t) = exc(x3, x4), d := x3. diverge(t) = diverge(x3)], c, refl({diverge(t)}))
  show := apply(gc.call0_from, hw, (pair(w, diverge(t)) in univ(1) by simp(hw, ht)), b)
qed

// ----------------------------------------------------------------------
//  The call in the mode b (the main run's: call; the startup's: call0)

abbrev gc.cm(b, g, args) := ite(b, gimple.call(g, args), gimple.call0(g, args))
abbrev gc.bm(b, w4, w) := ite(b, gc.back(w4, w), gc.back0(w4, w))

// (a mode's call: the main's or the startup's)
theorem gc.cm_cases(x0. q): all b g args. q(gimple.call(g, args)) -> q(gimple.call0(g, args)) -> q(gc.cm(b, g, args))
proof
  fix b g args
  assume h1 h0
  have t: b -> q(gc.cm(b, g, args)) proof
    assume hb
    show := rewrite(sym(mp(ite_t[c := b, a := gimple.call(g, args), b := gimple.call0(g, args)], hb)), h1)
  qed
  have f: !b -> q(gc.cm(b, g, args)) proof
    assume hb
    show := rewrite(sym(mp(ite_f[c := b, a := gimple.call(g, args), b := gimple.call0(g, args)], hb)), h0)
  qed
  show by taut(t, f)
qed

// (... with the callee's world back as the mode has it)
theorem gc.cm_cases2(x0 x1. q): all b g args w4 w. q(gimple.call(g, args), gc.back(w4, w)) -> q(gimple.call0(g, args), gc.back0(w4, w)) -> q(gc.cm(b, g, args), gc.bm(b, w4, w))
proof
  fix b g args w4 w
  assume h1 h0
  have t: b -> q(gc.cm(b, g, args), gc.bm(b, w4, w)) proof
    assume hb
    have r := rewrite(sym(mp(ite_t[c := b, a := gimple.call(g, args), b := gimple.call0(g, args)], hb)), h1)
    show := rewrite(sym(mp(ite_t[c := b, a := gc.back(w4, w), b := gc.back0(w4, w)], hb)), r)
  qed
  have f: !b -> q(gc.cm(b, g, args), gc.bm(b, w4, w)) proof
    assume hb
    have r := rewrite(sym(mp(ite_f[c := b, a := gimple.call(g, args), b := gimple.call0(g, args)], hb)), h0)
    show := rewrite(sym(mp(ite_f[c := b, a := gc.back(w4, w), b := gc.back0(w4, w)], hb)), r)
  qed
  show by taut(t, f)
qed

// The mode's call: its outcomes from the callee's (GIMPLE's check, the
// thread pointer sound, in the main mode only)
theorem gc.cm_ovf: all b g args w. w in univ(1) -> runs(gc.cm(b, g, args), w, exc(w, exc_val("stack_overflow", empty)))
proof
  fix b g args w
  assume hw
  show := apply(gc.cm_cases[q := x0. runs(x0, w, exc(w, exc_val("stack_overflow", empty)))], {b}, {g}, {args},
    mp(all_elim(gc.call_ovf, {g}, {args}, {w}), hw), mp(all_elim(gc.call0_ovf, {g}, {args}, {w}), hw))
qed

theorem gc.cm_ub: all b g args w regs x e. w in univ(1) -> x in univ(1) -> e in univ(1) -> gc.regs_ok(regs, args) -> b ->
  !gc.sound(w) -> runs(gc.cm(b, g, args), w, exc(x, e))
proof
  fix b g args w regs x e
  assume hw hx he hr hb hn
  have c := apply(gc.call_ub, {g}, {args}, {w}, {regs}, {x}, {e}, hw, hx, he, hr, hn)
  show := rewrite(sym(mp(ite_t[c := b, a := gimple.call(g, args), b := gimple.call0(g, args)], hb)), c)
qed

theorem gc.cm_exc: all b g args w regs x e. w in univ(1) -> x in univ(1) -> e in univ(1) -> gc.regs_ok(regs, args) -> (b -> gc.sound(w)) ->
  runs(g[regs], w, exc(x, e)) -> runs(gc.cm(b, g, args), w, exc(x, e))
proof
  fix b g args w regs x e
  assume hw hx he hr hs hc
  have t: b -> runs(gc.cm(b, g, args), w, exc(x, e)) proof
    assume hb
    have c := apply(gc.call_exc, {g}, {args}, {w}, {regs}, {x}, {e}, hw, hx, he, hr, mp(hs, hb), hc)
    show := rewrite(sym(mp(ite_t[c := b, a := gimple.call(g, args), b := gimple.call0(g, args)], hb)), c)
  qed
  have f: !b -> runs(gc.cm(b, g, args), w, exc(x, e)) proof
    assume hb
    have c := apply(gc.call0_exc, {g}, {args}, {w}, {regs}, {x}, {e}, hw, hx, he, hr, hc)
    show := rewrite(sym(mp(ite_f[c := b, a := gimple.call(g, args), b := gimple.call0(g, args)], hb)), c)
  qed
  show by taut(t, f)
qed

theorem gc.cm_div: all b g args w regs t. w in univ(1) -> t in univ(1) -> gc.regs_ok(regs, args) -> (b -> gc.sound(w)) ->
  runs(g[regs], w, diverge(t)) -> runs(gc.cm(b, g, args), w, diverge(t))
proof
  fix b g args w regs t
  assume hw ht hr hs hc
  have tt: b -> runs(gc.cm(b, g, args), w, diverge(t)) proof
    assume hb
    have c := apply(gc.call_div, {g}, {args}, {w}, {regs}, {t}, hw, ht, hr, mp(hs, hb), hc)
    show := rewrite(sym(mp(ite_t[c := b, a := gimple.call(g, args), b := gimple.call0(g, args)], hb)), c)
  qed
  have f: !b -> runs(gc.cm(b, g, args), w, diverge(t)) proof
    assume hb
    have c := apply(gc.call0_div, {g}, {args}, {w}, {regs}, {t}, hw, ht, hr, hc)
    show := rewrite(sym(mp(ite_f[c := b, a := gimple.call(g, args), b := gimple.call0(g, args)], hb)), c)
  qed
  show by taut(tt, f)
qed

theorem gc.cm_ok: all b g args w regs w4 r0 r1. w in univ(1) -> w4 in univ(1) -> r0 in univ(1) -> r1 in univ(1) -> gc.regs_ok(regs, args) ->
  (b -> gc.sound(w)) -> runs(g[regs], w, ok(w4, pair(r0, r1))) ->
  runs(gc.cm(b, g, args), w, ok(gc.bm(b, w4, w), pair(r0, r1))) && runs(gc.cm(b, g, args), w, exc(gc.bm(b, w4, w), exc_val("stack_overflow", empty)))
proof
  fix b g args w regs w4 r0 r1
  assume hw hw4 h0 h1 hr hs hc
  have t: b -> runs(gc.cm(b, g, args), w, ok(gc.bm(b, w4, w), pair(r0, r1))) && runs(gc.cm(b, g, args), w, exc(gc.bm(b, w4, w), exc_val("stack_overflow", empty))) proof
    assume hb
    have c1 := apply(gc.call_ok, {g}, {args}, {w}, {regs}, {w4}, {r0}, {r1}, hw, hw4, h0, h1, hr, mp(hs, hb), hc)
    have c2 := apply(gc.call_ovf_after, {g}, {args}, {w}, {regs}, {w4}, {r0}, {r1}, hw, hw4, h0, h1, hr, mp(hs, hb), hc)
    have r := rewrite(sym(mp(ite_t[c := b, a := gimple.call(g, args), b := gimple.call0(g, args)], hb)), conj(c1, c2))
    show := rewrite(sym(mp(ite_t[c := b, a := gc.back(w4, w), b := gc.back0(w4, w)], hb)), r)
  qed
  have f: !b -> runs(gc.cm(b, g, args), w, ok(gc.bm(b, w4, w), pair(r0, r1))) && runs(gc.cm(b, g, args), w, exc(gc.bm(b, w4, w), exc_val("stack_overflow", empty))) proof
    assume hb
    have c1 := apply(gc.call0_ok, {g}, {args}, {w}, {regs}, {w4}, {r0}, {r1}, hw, hw4, h0, h1, hr, hc)
    have c2 := apply(gc.call0_ovf_after, {g}, {args}, {w}, {regs}, {w4}, {r0}, {r1}, hw, hw4, h0, h1, hr, hc)
    have r := rewrite(sym(mp(ite_f[c := b, a := gimple.call(g, args), b := gimple.call0(g, args)], hb)), conj(c1, c2))
    show := rewrite(sym(mp(ite_f[c := b, a := gc.back(w4, w), b := gc.back0(w4, w)], hb)), r)
  qed
  show by taut(t, f)
qed

// call1_0: the value in rax only (as call1)
theorem gc.call1_0_exc: all g args w x e. w in univ(1) -> x in univ(1) -> e in univ(1) ->
  runs(gimple.call0(g, args), w, exc(x, e)) -> runs(gimple.call1_0(g, args), w, exc(x, e))
proof
  fix g args w x e
  assume hw hx he hc
  show by simp(hw, hx, he, hc, keep(gimple.call0))
qed

theorem gc.call1_0_div: all g args w t. w in univ(1) -> t in univ(1) ->
  runs(gimple.call0(g, args), w, diverge(t)) -> runs(gimple.call1_0(g, args), w, diverge(t))
proof
  fix g args w t
  assume hw ht hc
  show by simp(hw, ht, hc, keep(gimple.call0))
qed

// (the mode's one-result call)
abbrev gc.c1m(b, g, args) := ite(b, gimple.call1(g, args), gimple.call1_0(g, args))
