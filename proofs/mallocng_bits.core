// C2 of malloc.c's bit counts a_ctz_32 and a_clz_32 (layers/mallocng_specs.sl):
// a de Bruijn multiplication and table lookup, and bit smearing, by the bit
// library (core/bits.core: `bitwise`, `cases`).
//
//   checked after proofs/mallocng_c2.core (and core/bits.core)

// ----------------------------------------------------------------------
//  Trailing zeros

// tz(x), x != 0 an n-bit word: below n, x's lowest set bit
theorem ms.tz_low: all x n. n in omega -> int_le(n, 128) -> x in bits(n) -> !(x = 0) ->
  gimple.tz(x) in omega && int_lt(gimple.tz(x), n) && bit(x, gimple.tz(x)) && (all j. j in omega -> int_lt(j, gimple.tz(x)) -> !bit(x, j))
proof
  fix x n
  assume hn h128 hx hnz
  have xo: x in omega by arith(hx, hn)
  // some bit of x below n is set (else x = 0)
  have some: ex a. a in omega && int_lt(a, n) && bit(x, a) proof
    have nb: !(ex a. a in omega && int_lt(a, n) && bit(x, a)) -> false proof
      assume h
      have none: all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(0, i)) proof
        fix i
        assume hi hl
        have nb: !bit(x, i) proof
          assume b
          have e: ex a. a in omega && int_lt(a, n) && bit(x, a) by ex_intro({i}, conj(hi, hl, b))
          show by taut(e, h)
        qed
        show by taut(nb, mp(bit_zero_none[j := i], hi))
      qed
      have z0: 0 in bits(n) by arith(hn)
      have z := mp(all_elim(mp(all_elim(bits_ext, {n}), hn), {x}, {0}), hx, z0, none)
      show by taut(z, hnz)
    qed
    show by taut(nb)
  qed
  obtain a, ha hal hab from some
  have a128: int_lt(a, 128) by arith(hal, h128)
  have pa: int_lt(a, 128) && int_mod(int_div(x, int_pow(2, a)), 2) = 1 by defs(conj(a128, hab), bit, pow2)
  have m := mp(int_min_spec[p := k. int_lt(k, 128) && int_mod(int_div(x, int_pow(2, k)), 2) = 1, a := a], ha, pa)
  have mo mp1 mle := m
  have tzd: gimple.tz(x) = int_min(set_select(omega, k. int_lt(k, 128) && int_mod(int_div(x, int_pow(2, k)), 2) = 1)) by defs(refl({int_min(set_select(omega, k. int_lt(k, 128) && int_mod(int_div(x, int_pow(2, k)), 2) = 1))}), gimple.tz)
  let T := gimple.tz(x)
  have to := rewrite(sym(tzd), mo)
  have tp := rewrite(sym(tzd), mp1)
  have tl := rewrite(sym(tzd), mle)
  have _ tp2 := tp
  have tb: bit(x, T) by defs(tp2, bit, pow2)
  have tn: int_le(T, a) := mp(all_elim(tl, {a}), ha, pa)
  have below: all j. j in omega -> int_lt(j, T) -> !bit(x, j) proof
    fix j
    assume hj hjt
    have nb: bit(x, j) -> false proof
      assume b
      have j128: int_lt(j, 128) by arith(hjt, tn, hal, h128)
      have pj: int_lt(j, 128) && int_mod(int_div(x, int_pow(2, j)), 2) = 1 by defs(conj(j128, b), bit, pow2)
      have le := mp(all_elim(tl, {j}), hj, pj)
      show by arith(le, hjt)
    qed
    show by taut(nb)
  qed
  show conj(to, (int_lt(T, n) by arith(tn, hal)), tb, below)
qed

// the de Bruijn sequence's index of 2^t, looked up: t
theorem ms.debruijn: all t. t in omega -> int_lt(t, 32) ->
  int_lt(int_div(int_mod(int_mul(pow2(t), 124511785), 4294967296), 134217728), 32) &&
  app(mallocng_specs.debruijn32_tab, int_div(int_mod(int_mul(pow2(t), 124511785), 4294967296), 134217728)) = t
proof
  fix t
  assume ht hl
  show by cases({t}, {0}, {32}, simp(at({app(mallocng_specs.debruijn32_tab, int_div(int_mod(int_mul(pow2(t), 124511785), 4294967296), 134217728))})), ht, hl)
qed

// ----------------------------------------------------------------------
//  A byte table's entry: its address, its load

// (an index i of 1-byte elements, below 2^31: the address p + i)
theorem g.elem1_det: all s p i. s in univ(1) -> p in bits(64) -> i in bits(64) -> int_lt(i, 2147483648) -> int_lt(int_add(p, i), pow2(64)) ->
  g.det(gimple.elem(p, i, 1), s, ok(s, int_add(p, i)))
proof
  fix s p i
  assume hs hp hi hl hr
  let TY := fn_update(fn_update(empty, "prec", 64), "signed", true)
  have si: sint(64, i) = i by arith(hi, hl)
  have s1: sint(64, bits_of_int(64, 1)) = 1 by arith()
  have f: gimple.fits(TY, sint(64, i)) by defs(simp(si, hi, hl), gimple.fits)
  have w: bits_add(64, gimple.wrap(fn_update(empty, "prec", 64), sint(64, i)), 0) = i by defs(simp(si, hi), gimple.wrap, bits_add, pow2)
  have sd: g.det(gimple.smul(64, i, bits_of_int(64, 1)), s, ok(s, i)) proof
    fix o
    assume h
    show by simp(expand(h, gimple.smul, gimple.arith, runs, mkprog, bind_rel), hs, s1, f, w)
  qed
  have sv: gimple.sval(TY, i) = i by defs(simp(hi, hl), gimple.sval)
  have pd := rewrite(sv, apply(g.padd_det, {s}, {p}, {i}, hs, hp, hi, simp(sv, hp, hi), simp(sv, hr)))
  show proof
    fix o
    assume h
    have b1 := apply(g.bind_inv, apply(g.runs_elim, expand(h, gimple.elem)), sd)
    show := apply(g.bind_inv, b1, pd)
  qed
qed

// a byte table's entry I (table_ok): its address t + I, its byte
theorem ms.tab1_rd: all s t I tab. s in univ(1) -> t in bits(64) -> !(t = 0) -> I in bits(64) -> int_lt(I, seq_len(tab)) -> int_lt(I, 2147483648) ->
  mallocng_specs.table_ok(app(s, "vm"), app(s, "objs"), t, 1, tab) ->
  g.det(gimple.elem(t, I, 1), s, ok(s, int_add(t, I))) && g.det(gimple.ld8(int_add(t, I), 0), s, ok(s, bits_of_int(8, app(tab, I))))
proof
  fix s t I tab
  assume hs ht hnz hI hl h31 htab
  have io: I in omega by simp(hI)
  have tu tb := mp(all_elim(expand(htab, mallocng_specs.table_ok), {I}), io, hl)
  have t0: int_le(0, t) by simp(ht)
  have ud := apply(tr.usable_dom, {app(s, "vm")}, {app(s, "objs")}, {int_add(t, int_mul(1, I))}, {1}, {false}, {0}, tu, arith(t0, io), simp(), simp())
  have rng: int_lt(int_add(int_add(t, int_mul(1, I)), 0), 18446744073709551616) by taut(ud)
  have ed := apply(g.elem1_det, {s}, {t}, {I}, hs, ht, hI, h31, arith(rng, io, t0))
  have ab: int_add(t, I) in bits(64) by arith(rng, io, t0)
  have e1: int_add(t, int_mul(1, I)) = int_add(t, I) by arith()
  have tu2 := rewrite(e1, tu)
  have e0: int_add(int_add(t, I), 0) = int_add(t, I) by arith()
  have md: g.mem_defined(s, int_add(t, I), 0, 1, false) by simp(e0, tu2, rng, hnz, t0, io, ht)
  have ld := apply(g.ld8_det, {s}, {int_add(t, I)}, {0}, hs, ab, simp(), md)
  have be: bits_of_int(64, int_add(t, I)) = int_add(int_add(t, I), 0) by arith(rng, io, t0)
  have tb2 := rewrite(be, rewrite(e1, tb))
  have ld2 := rewrite(tb2, ld)
  show conj(ed, ld2)
qed

// ----------------------------------------------------------------------
//  a_ctz_32

// the code's index into the table: 2^tz(x)'s de Bruijn index, whose entry is tz(x)
theorem ms.ctz_idx: all x. x in bits(32) -> !(x = 0) ->
  bits_shr(32, bits_mul(32, bits_and(32, x, bits_sub(32, 0, x)), 124511785), 27) in bits(64) &&
  int_lt(bits_shr(32, bits_mul(32, bits_and(32, x, bits_sub(32, 0, x)), 124511785), 27), 32) &&
  app(mallocng_specs.debruijn32_tab, bits_shr(32, bits_mul(32, bits_and(32, x, bits_sub(32, 0, x)), 124511785), 27)) = gimple.tz(x)
proof
  fix x
  assume hx hnz
  let T := gimple.tz(x)
  have to tl tb tz := mp(all_elim(ms.tz_low, {x}, {32}), arith(), arith(), hx, hnz)
  have ng: bits_sub(32, 0, x) = bits_neg(32, x) by defs(arith(hx), bits_sub, bits_neg)
  have lb := mp(lowest_bit[n := 32, x := x, t := T], arith(), hx, to, tl, tb, tz)
  have e1: bits_and(32, x, bits_sub(32, 0, x)) = pow2(T) := rewrite(sym(ng), lb)
  have ib idx := mp(all_elim(ms.debruijn, {T}), to, tl)
  have pt := mp(pow2_pos[k := T], to)
  have pl := mp(pow2_le[a := T, b := 31], to, arith(), arith(tl))
  have e2: bits_shr(32, bits_mul(32, pow2(T), 124511785), 27) = int_div(int_mod(int_mul(pow2(T), 124511785), 4294967296), 134217728)
    by defs(arith(pt, pl, to), bits_shr, bits_mul, bits_of_int)
  have e3 := rewrite(sym(e1), e2, {1})
  have i64: int_div(int_mod(int_mul(pow2(T), 124511785), 4294967296), 134217728) in bits(64) by arith(ib, pt)
  show rewrite(sym(e3), conj(i64, ib, idx))
qed

// a_ctz_32's readable GIMPLE refines its spec (the table: malloc.c's debruijn32)
theorem ms.a_ctz_32_c2: all x. x in bits(32) ->
  refines(c_src_malloc_mallocng_malloc.a_ctz_32(x), mallocng_specs.a_ctz_32_spec(c_src_malloc_mallocng_malloc.debruijn32, x), abi.World)
proof
  fix x
  assume hx
  show proof
    fix s o
    assume hw hr
    let TB := c_src_malloc_mallocng_malloc.debruijn32
    let SPEC := mallocng_specs.a_ctz_32_spec(TB, x)
    have pu := apply(g.runs_univ, hr)
    have hu: s in univ(1) by simp(pu)
    let PRE := !(x = 0) && mallocng_specs.table_ok(app(s, "vm"), app(s, "objs"), TB, 1, mallocng_specs.debruijn32_tab)
    have np: !PRE -> runs(SPEC, s, o) proof
      assume hn
      show by simp(pu, hn, keep(abi.overflow, mallocng_specs.table_ok))
    qed
    have yp: PRE -> runs(SPEC, s, o) proof
      assume hp
      have hnz htb := hp
      let I := bits_shr(32, bits_mul(32, bits_and(32, x, bits_sub(32, 0, x)), 124511785), 27)
      have ib il ie := mp(all_elim(ms.ctz_idx, {x}), hx, hnz)
      have tbb: TB in bits(64) by defs(simp(), c_src_malloc_mallocng_malloc.debruijn32)
      have tbz: !(TB = 0) by defs(simp(), c_src_malloc_mallocng_malloc.debruijn32)
      have ln: seq_len(mallocng_specs.debruijn32_tab) = 32 by defs(simp(), mallocng_specs.debruijn32_tab)
      have ed ld := mp(all_elim(ms.tab1_rd, {s}, {TB}, {I}, {mallocng_specs.debruijn32_tab}), hu, tbb, tbz, ib, arith(il, ln), arith(il), htb)
      step t8, oe from hr with ed, ld
      // the result: tz(x), below 32
      have to tl .. := mp(all_elim(ms.tz_low, {x}, {32}), arith(), arith(), hx, hnz)
      have v: bits_sext(8, 32, bits_of_int(8, app(mallocng_specs.debruijn32_tab, I))) = bits_of_int(32, gimple.tz(x)) by defs(arith(ie, to, tl), bits_sext)
      have pu2: pair(s, ok(s, bits_of_int(32, gimple.tz(x)))) in univ(1) by simp(hu)
      show by simp(rewrite(v, oe), hp, pu2, keep(abi.overflow, mallocng_specs.table_ok))
    qed
    show by taut(np, yp)
  qed
qed

// ----------------------------------------------------------------------
//  a_clz_32

// (one smearing step of the code: y | y >> m)
abbrev ms.sm(y, m) := bits_or(32, y, bits_shr(32, y, m))

// x's top bit p; x >> 1 smeared, plus 1: 2^p
theorem ms.clz_smear: all x. x in bits(32) -> !(x = 0) ->
  ex p. p in omega && int_lt(p, 32) && int_le(pow2(p), x) && int_lt(x, pow2(int_add(p, 1))) &&
    bits_add(32, ms.sm(ms.sm(ms.sm(ms.sm(ms.sm(bits_shr(32, x, 1), 1), 2), 4), 8), 16), 1) = pow2(p)
proof
  fix x
  assume hx hnz
  have xo: x in omega by arith(hx)
  // p: the least with x < 2^(p+1)
  have w31: int_lt(x, pow2(int_add(31, 1))) by arith(hx)
  have mo ml mle := mp(int_min_spec[p := k. int_lt(x, pow2(int_add(k, 1))), a := 31], arith(), w31)
  let P := int_min(set_select(omega, k. int_lt(x, pow2(int_add(k, 1)))))
  have p31: int_le(P, 31) := mp(all_elim(mle, {31}), arith(), w31)
  have zero: P = 0 -> (ex p. p in omega && int_lt(p, 32) && int_le(pow2(p), x) && int_lt(x, pow2(int_add(p, 1))) &&
      bits_add(32, ms.sm(ms.sm(ms.sm(ms.sm(ms.sm(bits_shr(32, x, 1), 1), 2), 4), 8), 16), 1) = pow2(p)) proof
    assume h0
    have x1: x = 1 by arith(rewrite(h0, ml), xo, hnz)
    have z: ms.sm(ms.sm(ms.sm(ms.sm(ms.sm(bits_shr(32, 1, 1), 1), 2), 4), 8), 16) = 0 by bitwise({32})
    have zx := subst({w. ms.sm(ms.sm(ms.sm(ms.sm(ms.sm(bits_shr(32, w, 1), 1), 2), 4), 8), 16) = 0}, sym(x1), z)
    have r: bits_add(32, ms.sm(ms.sm(ms.sm(ms.sm(ms.sm(bits_shr(32, x, 1), 1), 2), 4), 8), 16), 1) = pow2(0) by arith(zx)
    have l: int_le(pow2(0), x) by arith(x1)
    have u: int_lt(x, pow2(int_add(0, 1))) by arith(x1)
    have z0: 0 in omega by arith()
    have z32: int_lt(0, 32) by arith()
    show by ex_intro({0}, conj(z0, z32, l, u, r))
  qed
  have pos: !(P = 0) -> (ex p. p in omega && int_lt(p, 32) && int_le(pow2(p), x) && int_lt(x, pow2(int_add(p, 1))) &&
      bits_add(32, ms.sm(ms.sm(ms.sm(ms.sm(ms.sm(bits_shr(32, x, 1), 1), 2), 4), 8), 16), 1) = pow2(p)) proof
    assume h0
    let k := int_sub(P, 1)
    have hk: k in omega by arith(mo, h0)
    have ek: int_add(k, 1) = P by arith(mo)
    // 2^P <= x: else P - 1 had x < 2^P
    have lt: int_lt(x, pow2(int_add(k, 1))) -> int_le(P, k) := mp(all_elim(mle, {k}), hk)
    have lo: int_le(pow2(P), x) by arith(rewrite(ek, lt), mo, h0)
    have pp := mp(pow2_pos[k := P], mo)
    // x's bits: P set, none above
    have bp: bit(x, P) by defs(arith(lo, ml, mo, xo, pp), bit)
    have pl1 := mp(pow2_le[a := int_add(P, 1), b := 32], arith(mo), arith(), arith(p31))
    have hiq: all j. j in omega -> int_lt(P, j) -> !bit(x, j) proof
      fix j
      assume hj hpj
      show mp(bit_high[x := x, n := int_add(P, 1), i := j], xo, arith(mo), hj, ml, arith(hpj, hj, mo))
    qed
    // x >> 1: bit k set, none above
    let Y0 := bits_shr(32, x, 1)
    have y0b: Y0 in bits(32) by arith(hx)
    have s0: all j. j in omega -> int_le(j, k) -> int_lt(k, int_add(j, 1)) -> bit(Y0, j) proof
      fix j
      assume hj h1 h2
      show by bitwise(hx, bp, hj, h1, h2, mo, h0)
    qed
    have c0: all j. j in omega -> int_lt(k, j) -> int_lt(j, 32) -> !bit(Y0, j) proof
      fix j
      assume hj h1 h2
      show by bitwise(hx, hiq, hj, h1, h2, mo, h0)
    qed
    have k32: int_lt(k, 32) by arith(p31, mo)
    // the five steps
    have s1 c1 := mp(smear_step[n := 32, y := Y0, k := k, m := 1, m2 := 2], arith(), y0b, hk, k32, arith(), arith(), s0, c0)
    let Y1 := ms.sm(Y0, 1)
    have s2 c2 := mp(smear_step[n := 32, y := Y1, k := k, m := 2, m2 := 4], arith(), mp(bits_or_in[n := 32, x := Y0, y := bits_shr(32, Y0, 1)], arith()), hk, k32, arith(), arith(), s1, c1)
    let Y2 := ms.sm(Y1, 2)
    have s3 c3 := mp(smear_step[n := 32, y := Y2, k := k, m := 4, m2 := 8], arith(), mp(bits_or_in[n := 32, x := Y1, y := bits_shr(32, Y1, 2)], arith()), hk, k32, arith(), arith(), s2, c2)
    let Y3 := ms.sm(Y2, 4)
    have s4 c4 := mp(smear_step[n := 32, y := Y3, k := k, m := 8, m2 := 16], arith(), mp(bits_or_in[n := 32, x := Y2, y := bits_shr(32, Y2, 4)], arith()), hk, k32, arith(), arith(), s3, c3)
    let Y4 := ms.sm(Y3, 8)
    have s5 c5 := mp(smear_step[n := 32, y := Y4, k := k, m := 16, m2 := 32], arith(), mp(bits_or_in[n := 32, x := Y3, y := bits_shr(32, Y3, 8)], arith()), hk, k32, arith(), arith(), s4, c4)
    let Y5 := ms.sm(Y4, 16)
    have all5: all j. j in omega -> int_le(j, k) -> bit(Y5, j) proof
      fix j
      assume hj h1
      show mp(all_elim(s5, {j}), hj, h1, arith(hj, h1, k32))
    qed
    have y5b := mp(bits_or_in[n := 32, x := Y4, y := bits_shr(32, Y4, 16)], arith())
    have d := rewrite(ek, mp(smear_done[n := 32, y := Y5, k := k], arith(), y5b, hk, k32, all5, c5))
    have pl := mp(pow2_le[a := P, b := 31], mo, arith(), p31)
    have r: bits_add(32, Y5, 1) = pow2(P) by arith(d, pl, pp)
    have p32: int_lt(P, 32) by arith(p31, mo)
    show by ex_intro({P}, conj(mo, p32, lo, ml, r))
  qed
  show by taut(zero, pos)
qed

// tz(2^p) = p
theorem ms.tz_pow2: all p. p in omega -> int_lt(p, 32) -> gimple.tz(pow2(p)) = p
proof
  fix p
  assume hp hl
  have pl := mp(pow2_le[a := int_add(p, 1), b := 32], arith(hp), arith(), arith(hl))
  have pp := mp(pow2_pos[k := p], hp)
  have pb: pow2(p) in bits(32) by arith(hp, pl, pp)
  have pz: !(pow2(p) = 0) by arith(pp)
  have to tl tb .. := mp(all_elim(ms.tz_low, {pow2(p)}, {32}), arith(), arith(), pb, pz)
  have e := mp(bit_pow2[k := p, i := gimple.tz(pow2(p))], hp, to)
  show by taut(tb, e)
qed

// a_ctz_32's spec, its precondition holding: an overflow, or tz(x) returned
theorem ms.ctz_spec_inv: all tbl x s o. x in bits(32) -> s in abi.World -> !(x = 0) ->
  mallocng_specs.table_ok(app(s, "vm"), app(s, "objs"), tbl, 1, mallocng_specs.debruijn32_tab) ->
  runs(mallocng_specs.a_ctz_32_spec(tbl, x), s, o) ->
  (ex v. v in x86_64_linux.Vm && o = exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty))) || o = ok(s, bits_of_int(32, gimple.tz(x)))
proof
  fix tbl x s o
  assume hx hw hnz htb h
  have vv: ex y. y in x86_64_linux.Vm by ex_intro({app(s, "vm")}, simp(expand(hw, abi.World)))
  show by simp(h, hnz, htb, vv, keep(mallocng_specs.table_ok))
qed

// a_ctz_32's contract at a call a_ctz_32(x): an overflow, or the return,
// the memory as it was, the first register's low half tz(x)
theorem ms.ctzs_q: all regs s tbl x o2. x in bits(32) -> s in abi.World -> s in univ(1) ->
  !(x = 0) -> mallocng_specs.table_ok(app(s, "vm"), app(s, "objs"), tbl, 1, mallocng_specs.debruijn32_tab) ->
  gc.regs_ok(regs, seq_one(gimple.arg(32, x))) ->
  runs(app(mallocng_specs.a_ctz_32_spec_fun(tbl), regs), s, o2) ->
  (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex r. o2 = ok(fn_update(s, "vm", app(s, "vm")), r) && bits_of_int(32, fst(r)) = bits_of_int(32, gimple.tz(x)))
proof
  fix regs s tbl x o2
  assume hx hw hu hnz htb hr h
  let OVF := exc_val("stack_overflow", empty)
  let T := bits_of_int(32, gimple.tz(x))
  have rl rn r0 := apply(gc.regs1_32, hx, hr)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, mallocng_specs.a_ctz_32_spec_fun, app_fn_build, ra in h
  have vfun: is_fun(s) by simp(expand(hw, abi.World))
  have vdom: "vm" in dom(s) by simp(expand(hw, abi.World))
  have ss: fn_update(s, "vm", app(s, "vm")) = s := mp(fn_update_same[f := s, k := "vm"], vfun, vdom)
  let G := (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(s, "vm", v), OVF)) || (ex r. o2 = ok(fn_update(s, "vm", app(s, "vm")), r) && bits_of_int(32, fst(r)) = T)
  have o1: ord_le(1, seq_len(regs)) by defs(simp(rn), ord_le)
  have b := rewrite(r0, apply(g.runs_elim, h))
  have b2: bind_rel(mallocng_specs.a_ctz_32_spec(tbl, x), s, x3 x4. letin(x4, x5. bind_rel(gimple.result(32, x5), x3, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. o2 = ok(x6, pair(x8, x9)))),
      x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))), x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3)) by taut(b, o1)
  obtain o3, hs3 hk3 from expand(b2, bind_rel)
  have ci := apply(ms.ctz_spec_inv, hx, hw, hnz, htb, hs3)
  have c1: (ex v. v in x86_64_linux.Vm && o3 = exc(fn_update(s, "vm", v), OVF)) -> G proof
    assume e
    obtain v, hv he from e
    have oe: o2 = exc(fn_update(s, "vm", v), OVF) by simp(rewrite(he, hk3))
    have l: ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(s, "vm", v), OVF) by ex_intro({v}, taut(hv, oe))
    show by taut(l)
  qed
  have c2: o3 = ok(s, T) -> G proof
    assume he
    have hr32: T in bits(32) by simp()
    have k1: bind_rel(gimple.result(32, T), s, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. o2 = ok(x6, pair(x8, x9)))), x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))
      by simp(expand(rewrite(he, hk3), letin), keep(bind_rel, gimple.result))
    obtain o4, hr4 hk4 from expand(k1, bind_rel)
    obtain u, hu64 hlow ho4 from apply(g.result32_inv, hr32, hr4)
    have k2: any_rel(x9. x9 in bits(64), x9. o2 = ok(s, pair(u, x9))) by simp(expand(rewrite(ho4, hk4), letin), keep(any_rel))
    have ne: ex y. y in bits(64) by ex_intro({0}, simp())
    obtain y, hy hoy from apply(g.any_e, ne, k2)
    have cl: bits_of_int(32, fst(pair(u, y))) = T by simp(hlow)
    have l: ex r. o2 = ok(fn_update(s, "vm", app(s, "vm")), r) && bits_of_int(32, fst(r)) = T by ex_intro({pair(u, y)}, taut(rewrite(sym(ss), hoy), cl))
    show by taut(l)
  qed
  show by taut(ci, c1, c2)
qed

// a_clz_32's readable GIMPLE refines its spec, for any callee refining
// a_ctz_32's spec (as a C function value)
theorem ms.a_clz_32_c2: all x g tbl. x in bits(32) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(app(g, regs), s, o) -> runs(app(mallocng_specs.a_ctz_32_spec_fun(tbl), regs), s, o)) ->
  refines(c_src_malloc_mallocng_malloc.a_clz_32(x, g), mallocng_specs.a_clz_32_spec(tbl, x), abi.World)
proof
  fix x g tbl
  assume hx hg
  show proof
    fix s o
    assume hw hr
    let SPEC := mallocng_specs.a_clz_32_spec(tbl, x)
    let OVF := exc_val("stack_overflow", empty)
    have pu := apply(g.runs_univ, hr)
    have hu: s in univ(1) by simp(pu)
    have vV vfun vdom .. := apply(ms.world_parts, hw)
    have ss: fn_update(s, "vm", app(s, "vm")) = s := mp(fn_update_same[f := s, k := "vm"], vfun, vdom)
    let PRE := (!(x = 0) && mallocng_specs.table_ok(app(s, "vm"), app(s, "objs"), tbl, 1, mallocng_specs.debruijn32_tab)) && abi.thread_ok(app(s, "vm"), app(s, "fs_base"))
    have np: !PRE -> runs(SPEC, s, o) proof
      assume hn
      show by simp(pu, hn, keep(abi.overflow, mallocng_specs.table_ok, mallocng_specs.clz_of, abi.thread_ok))
    qed
    have yp: PRE -> runs(SPEC, s, o) proof
      assume hp
      have hnz htb hth := hp
      // (the spec's outcomes: an overflow, any memory; x's leading zeros)
      have sov: all v. v in x86_64_linux.Vm -> runs(SPEC, s, exc(fn_update(s, "vm", v), OVF)) proof
        fix v
        assume hv
        have vu := apply(x86.vm_univ, hv)
        have eu: OVF in univ(1) by defs(simp(), exc_val)
        have pu2: pair(s, exc(fn_update(s, "vm", v), OVF)) in univ(1) by simp(hu, vu, eu)
        have ovi := apply(ct.overflow_intro, hv, pu2)
        show by simp(hp, ovi, pu2, keep(abi.overflow, mallocng_specs.table_ok, mallocng_specs.clz_of, abi.thread_ok))
      qed
      have sret: all c. c in bits(32) -> mallocng_specs.clz_of(x, c) -> runs(SPEC, s, ok(s, c)) proof
        fix c
        assume hc hcl
        have pu2: pair(s, ok(s, c)) in univ(1) by simp(hu, hc)
        show by simp(hp, hc, hcl, pu2, keep(abi.overflow, mallocng_specs.table_ok, mallocng_specs.clz_of, abi.thread_ok))
      qed
      // x >> 1 smeared, plus 1: 2^P, P x's top bit
      obtain P, hpo hp32 hlo hhi hsm from apply(ms.clz_smear, hx, hnz)
      let X := bits_add(32, ms.sm(ms.sm(ms.sm(ms.sm(ms.sm(bits_shr(32, x, 1), 1), 2), 4), 8), 16), 1)
      have pp := mp(pow2_pos[k := P], hpo)
      have xb: X in bits(32) by simp()
      have xnz: !(X = 0) by arith(hsm, pp)
      step t17, b from hr
      // the call: a_ctz_32's contract
      have qa: all regs o2. gc.regs_ok(regs, seq_one(gimple.arg(32, X))) -> runs(app(mallocng_specs.a_ctz_32_spec_fun(tbl), regs), s, o2) ->
          (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(s, "vm", v), OVF)) || (ex r. o2 = ok(fn_update(s, "vm", app(s, "vm")), r) && bits_of_int(32, fst(r)) = bits_of_int(32, gimple.tz(X))) proof
        fix regs o2
        assume hro h2
        show := apply(ms.ctzs_q, xb, hw, hu, xnz, htb, hro, h2)
      qed
      have ths: gc.sound(s) by simp(hth)
      have cc := apply(gc.contract_call1[R := r. bits_of_int(32, fst(r)) = bits_of_int(32, gimple.tz(X))], {g}, {mallocng_specs.a_ctz_32_spec_fun(tbl)}, {seq_one(gimple.arg(32, X))}, {s}, {app(s, "vm")},
        ths, hw, vV, apply(gc.regs1_32_ex, xb), (int_le(seq_len(seq_one(gimple.arg(32, X))), 6) by simp()), hg, qa, b)
      have cov: (ex v. v in x86_64_linux.Vm && o = exc(fn_update(s, "vm", v), OVF)) -> runs(SPEC, s, o) proof
        assume h
        obtain v, hv ho from h
        show := rewrite(sym(ho), mp(all_elim(sov, {v}), hv))
      qed
      // the count returned: P; 31 - P
      have cok: case 2 of cc proof
        assume h
        obtain r, hR hk from h
        let C := bits_of_int(32, fst(r))
        have hk2 := rewrite(ss, hk)
        have tp := mp(all_elim(ms.tz_pow2, {P}), hpo, hp32)
        have ce: C = P by arith(rewrite(tp, rewrite(hsm, hR)), hpo, hp32)
        have cb: C in bits(32) by simp()
        have b31: bits_of_int(32, 31) = 31 by arith()
        have sC: sint(32, C) = P by arith(ce, hpo, hp32)
        have s31: sint(32, bits_of_int(32, 31)) = 31 by arith()
        have f: tr.s32_fits(int_sub(sint(32, bits_of_int(32, 31)), sint(32, C))) by defs(simp(sC, s31, hpo, hp32), gimple.fits)
        have sd := apply(g.ssub32_det, {s}, {bits_of_int(32, 31)}, {C}, hu, simp(), cb, f)
        step d from hk2 with sd
        let R0 := bits_sub(32, bits_of_int(32, 31), C)
        have rb: R0 in bits(32) by simp()
        have q1: int_sub(31, R0) = P by arith(ce, hpo, hp32)
        have q2: int_sub(32, R0) = int_add(P, 1) by arith(ce, hpo, hp32)
        have r32: int_lt(R0, 32) by arith(ce, hpo, hp32)
        have c0: int_lt(R0, 32) && int_le(int_pow(2, P), x) && int_lt(x, int_pow(2, int_add(P, 1))) by defs(conj(r32, hlo, hhi), pow2)
        have c1 := subst({w. int_lt(R0, 32) && int_le(int_pow(2, w), x) && int_lt(x, int_pow(2, int_add(P, 1)))}, sym(q1), c0)
        have c2 := subst({w. int_lt(R0, 32) && int_le(int_pow(2, int_sub(31, R0)), x) && int_lt(x, int_pow(2, w))}, sym(q2), c1)
        have cl: mallocng_specs.clz_of(x, R0) by defs(c2, mallocng_specs.clz_of)
        show := rewrite(sym(d), mp(all_elim(sret, {R0}), rb, cl))
      qed
      show by taut(cc, cov, cok)
    qed
    show by taut(np, yp)
  qed
qed

// ----------------------------------------------------------------------
//  As C function values; linked

theorem ms.a_ctz_32_fun_c2: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
  runs(app(c_src_malloc_mallocng_malloc.a_ctz_32_fun(), regs), s, o) -> runs(app(mallocng_specs.a_ctz_32_spec_fun(c_src_malloc_mallocng_malloc.debruijn32), regs), s, o)
proof
  fix regs s o
  assume hr hl hw h
  have lo: seq_len(regs) in omega by simp(hr)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(hl, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(hr, ol, keep(ord_le))
  rsimp only, c_src_malloc_mallocng_malloc.a_ctz_32_fun, app_fn_build, ra in h
  rsimp only, mallocng_specs.a_ctz_32_spec_fun, app_fn_build, ra
  have pu := apply(g.runs_univ, h)
  have r := expand(apply(g.runs_elim, h), letin)
  let A0 := bits_of_int(32, app(regs, 0))
  have a0: A0 in bits(32) by simp()
  have dc := expand(all_elim(ms.a_ctz_32_c2, {A0}), refines)
  have hm: all o2. runs(c_src_malloc_mallocng_malloc.a_ctz_32(A0), s, o2) -> runs(mallocng_specs.a_ctz_32_spec(c_src_malloc_mallocng_malloc.debruijn32, A0), s, o2) proof
    fix o2
    assume h2
    show := mp(all_elim(mp(dc, a0), {s}, {o2}), hw, h2)
  qed
  have k1: case 1 of r proof
    assume hn
    show by apply(tr.runs_intro, pu, taut(hn))
  qed
  have k2: case 2 of r proof
    assume hb
    have b2 := apply(g.bind_mono, hm, hb)
    show by defs(apply(tr.runs_intro, pu, taut(b2)), letin)
  qed
  show by taut(r, k1, k2)
qed

theorem ms.a_clz_32_fun_c2: all g tbl. (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(app(g, regs), s, o) -> runs(app(mallocng_specs.a_ctz_32_spec_fun(tbl), regs), s, o)) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
    runs(app(c_src_malloc_mallocng_malloc.a_clz_32_fun(g), regs), s, o) -> runs(app(mallocng_specs.a_clz_32_spec_fun(tbl), regs), s, o))
proof
  fix g tbl
  assume hg
  fix regs s o
  assume hr hl hw h
  have lo: seq_len(regs) in omega by simp(hr)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(hl, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(hr, ol, keep(ord_le))
  rsimp only, c_src_malloc_mallocng_malloc.a_clz_32_fun, app_fn_build, ra in h
  rsimp only, mallocng_specs.a_clz_32_spec_fun, app_fn_build, ra
  have pu := apply(g.runs_univ, h)
  have r := expand(apply(g.runs_elim, h), letin)
  let A0 := bits_of_int(32, app(regs, 0))
  have a0: A0 in bits(32) by simp()
  have dc := expand(all_elim(ms.a_clz_32_c2, {A0}, {g}, {tbl}), refines)
  have hm: all o2. runs(c_src_malloc_mallocng_malloc.a_clz_32(A0, g), s, o2) -> runs(mallocng_specs.a_clz_32_spec(tbl, A0), s, o2) proof
    fix o2
    assume h2
    show := mp(all_elim(mp(dc, a0, hg), {s}, {o2}), hw, h2)
  qed
  have k1: case 1 of r proof
    assume hn
    show by apply(tr.runs_intro, pu, taut(hn))
  qed
  have k2: case 2 of r proof
    assume hb
    have b2 := apply(g.bind_mono, hm, hb)
    show by defs(apply(tr.runs_intro, pu, taut(b2)), letin)
  qed
  show by taut(r, k1, k2)
qed

// size_to_class with musl's a_clz_32 and a_ctz_32: its contract (the
// de Bruijn table malloc.c's)
theorem ms.size_to_class_c2_linked: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
  runs(app(c_src_malloc_mallocng_malloc.size_to_class_fun(c_src_malloc_mallocng_malloc.a_clz_32_fun(c_src_malloc_mallocng_malloc.a_ctz_32_fun())), regs), s, o) ->
  runs(app(mallocng_specs.size_to_class_spec_fun(c_src_malloc_mallocng_malloc.__malloc_size_classes, c_src_malloc_mallocng_malloc.debruijn32), regs), s, o)
proof
  have clz := mp(all_elim(ms.a_clz_32_fun_c2, {c_src_malloc_mallocng_malloc.a_ctz_32_fun()}, {c_src_malloc_mallocng_malloc.debruijn32}), ms.a_ctz_32_fun_c2)
  show mp(all_elim(ms.size_to_class_fun_c2, {c_src_malloc_mallocng_malloc.a_clz_32_fun(c_src_malloc_mallocng_malloc.a_ctz_32_fun())}, {c_src_malloc_mallocng_malloc.debruijn32}), clz)
qed
