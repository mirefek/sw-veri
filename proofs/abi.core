// The ABI layer (layers/abi.sl), from the machine's side: when a run of the
// machine is one that `abi_function` allows. Proven once, used for every
// function (with no ghost state: G = single(empty)).
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core core/records.core \
//     build/musl_malloc_O0.core proofs/abi.core
//
// - the view `world(sp, objs, mem)`: reading it (`get_ok`: the memory mem,
//   with the stack objects objs) and writing a world back (`set_ok`, for
//   memory that matches it)
// - `ub_intro`: if the spec may raise from the entry world (undefined
//   behavior), any outcome of the machine is allowed
// - `call_ok`: abi_call, the spec run on the world and the world written
//   back

abbrev abi.KEYS := insert("gpr", insert("xmm", insert("rip", insert("flags", insert("cpu", insert("fs_base", insert("gs_base", insert("vm", insert("os", empty)))))))))
abbrev abi.WKEYS := insert("vm", insert("os", insert("fs_base", insert("cpu", insert("objs", empty)))))
abbrev abi.ARGS := set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6))
// the caller's stack pointer and the return address, at entry s
abbrev abi.sp(s) := bits_add(64, s.gpr[4], 8)
abbrev abi.ret(s) := x86_64_linux.le(s.vm.bytes, s.gpr[4], 8)
// the world of the machine state m, with the stack objects objs, its
// memory mem (a view of m's), all bytes its own but the ABI's
abbrev abi.wo(m, objs, mem) := fn_update(fn_update(fn_update(fn_update(fn_update(empty, "vm", mem), "os", m.os), "fs_base", m.fs_base), "cpu", m.cpu), "objs", abi.objs_at(objs, m.fs_base))
// ... in the merged state of abi_call (no ghost state)
abbrev abi.cw(m, objs, mem) := rec_merge(abi.wo(m, objs, mem), ghost_part(m, abi.KEYS))
// the world at the entry s
abbrev abi.view(s, objs, mem) := abi.wo(s, objs, mem)
// mem a view of s's memory (as abi_function requires): its pages, its
// bytes on the world's domain
abbrev abi.view_ok(s, objs, mem) := abi.world_pages(s.vm, mem) && abi.world_matches(s.vm, s.vm, mem, abi.objs_at(objs, s.fs_base), s.fs_base, abi.sp(s))
// the world's bytes as a world written back has them: the callers' objects
// objs, its own bytes own (`world.set`)
abbrev abi.wob(objs, cb) := fn_update(fn_update(empty, "live", objs), "c_bytes", cb)
// the C world's bytes at an entry: all but the ABI's
abbrev abi.cbytes0(fs) := set_select(omega, x0. !(x0 in abi.canary(fs)))
// ... before the thread is set up (the startup's, until main): all, the
// ABI keeping none (docs/todo.md, the startup mode)
abbrev abi.cball := set_select(omega, x0. !(x0 in empty))
// the world at the entry s in the startup mode: no byte the ABI's
abbrev abi.wo0(m, objs, mem) := fn_update(fn_update(fn_update(fn_update(fn_update(empty, "vm", mem), "os", m.os), "fs_base", m.fs_base), "cpu", m.cpu), "objs", abi.wob(objs, abi.cball))
abbrev abi.view0(s, objs, mem) := abi.wo0(s, objs, mem)
abbrev abi.outcome(o) := (ex m1 e. o = ok(m1, e)) || (ex m1 e. o = exc(m1, e)) || (ex t. o = diverge(t))
// the callee-saved registers of m as at entry s
abbrev abi.callee_saved(m, s) := m.gpr[3] = s.gpr[3] && m.gpr[5] = s.gpr[5] &&
  m.gpr[12] = s.gpr[12] && m.gpr[13] = s.gpr[13] &&
  m.gpr[14] = s.gpr[14] && m.gpr[15] = s.gpr[15]

// (the ABI's bytes: a set of numbers; the world's bytes beyond its pages, of
// the universe -- of type Objs)
theorem abi.canary_type: all fs. abi.canary(fs) in set_type(omega) && abi.canary(fs) in univ(1)
proof
  fix fs
  have ss: subset(abi.canary(fs), omega) proof
    fix x
    assume h
    show by taut(set_select_def[s := omega, p := x0. int_le(int_add(fs, 40), x0) && int_lt(x0, int_add(fs, 48)), z := x], expand(h, abi.canary))
  qed
  have t: abi.canary(fs) in set_type(omega) by defs(taut(powerset_def[s := omega, a := abi.canary(fs)], ss), set_type)
  have u := mp(univ_subset[u := 1, a := abi.canary(fs), b := omega], omega_univ, ss)
  show := conj(t, u)
qed

// (the C world's bytes at an entry: the same)
theorem abi.cbytes0_type: all fs. abi.cbytes0(fs) in set_type(omega) && abi.cbytes0(fs) in univ(1)
proof
  fix fs
  have ss: subset(abi.cbytes0(fs), omega) proof
    fix x
    assume h
    show by taut(set_select_def[s := omega, p := x0. !(x0 in abi.canary(fs)), z := x], h)
  qed
  have t: abi.cbytes0(fs) in set_type(omega) by defs(taut(powerset_def[s := omega, a := abi.cbytes0(fs)], ss), set_type)
  have u := mp(univ_subset[u := 1, a := abi.cbytes0(fs), b := omega], omega_univ, ss)
  show := conj(t, u)
qed

// (a byte of the C world's at an entry: one not the ABI's)
theorem abi.cbytes0_in: all fs x. x in abi.cbytes0(fs) <-> x in omega && !(x in abi.canary(fs))
proof
  fix fs x
  show := set_select_def[s := omega, p := x0. !(x0 in abi.canary(fs)), z := x]
qed

theorem abi.objs_at_univ: all objs fs. objs in univ(1) -> abi.objs_at(objs, fs) in univ(1)
proof
  fix objs fs
  assume ho
  have c := all_elim(abi.cbytes0_type, {fs})
  show by defs(simp(ho, c.2), abi.objs_at)
qed

// (the world's bytes of the parts objs and own: of type Objs)
theorem abi.wob_typed: all objs own. objs in set_type(omega) -> own in set_type(omega) -> own in univ(1) -> abi.wob(objs, own) in abi.Objs && abi.wob(objs, own) in univ(1)
proof
  fix objs own
  assume ht hot hou
  let O := abi.wob(objs, own)
  have hs: subset(objs, omega) by taut(powerset_def[s := omega, a := objs], expand(ht, set_type))
  have hu := mp(univ_subset[u := 1, a := objs, b := omega], omega_univ, hs)
  have ou: O in univ(1) by simp(hu, hou)
  have de := dom_empty
  have f0: is_fun(empty) by taut(de)
  have d0: dom(empty) = empty by taut(de)
  have f1 := mp(fn_update_fun[f := empty, k := "live", v := objs], f0)
  have d1 := mp(dom_update[f := empty, k := "live", v := objs], f0)
  have f2 := mp(fn_update_fun[f := fn_update(empty, "live", objs), k := "c_bytes", v := own], f1)
  have d2 := mp(dom_update[f := fn_update(empty, "live", objs), k := "c_bytes", v := own], f1)
  have dset: all x. x in insert("c_bytes", insert("live", empty)) <-> x in insert("live", insert("c_bytes", empty)) proof
    fix x
    have l: x in insert("c_bytes", insert("live", empty)) -> x in insert("live", insert("c_bytes", empty)) proof
      assume h
      show by simp(h)
    qed
    have r: x in insert("live", insert("c_bytes", empty)) -> x in insert("c_bytes", insert("live", empty)) proof
      assume h
      show by simp(h)
    qed
    show by taut(l, r)
  qed
  have deq := mp(set_ext[a := insert("c_bytes", insert("live", empty)), b := insert("live", insert("c_bytes", empty))], dset)
  have fO: is_fun(O) := f2
  have dO: dom(O) = insert("live", insert("c_bytes", empty)) by simp(d2, d1, d0, deq)
  have eL: O.live = objs by simp()
  have eH: O.c_bytes = own by simp()
  have pO: ((is_fun(O) && dom(O) = insert("live", insert("c_bytes", empty))) && O.live in set_type(omega)) && O.c_bytes in set_type(omega) by simp(fO, dO, eL, eH, ht, hot)
  have r := mp(rec_type_intro[u := 1, k := insert("live", insert("c_bytes", empty)), p := x0. ((is_fun(x0) && dom(x0) = insert("live", insert("c_bytes", empty))) && x0.live in set_type(omega)) && x0.c_bytes in set_type(omega), r := O], ou, fO, dO, pO)
  show by defs(conj(r, ou), abi.Objs)
qed

theorem abi.objs_at_typed: all objs fs. objs in set_type(omega) -> abi.objs_at(objs, fs) in abi.Objs
proof
  fix objs fs
  assume ht
  have c := all_elim(abi.cbytes0_type, {fs})
  have r := mp(all_elim(abi.wob_typed, {objs}, {abi.cbytes0(fs)}), ht, c.1, c.2)
  show by defs(r.1, abi.objs_at)
qed

// (the world's bytes: sets of numbers)
theorem abi.objs_parts: all o. o in abi.Objs -> o.live in set_type(omega) && o.c_bytes in set_type(omega)
proof
  fix o
  assume h
  show by taut(set_select_def[s := powerset(cart(insert("live", insert("c_bytes", empty)), univ(1))),
    p := x0. ((is_fun(x0) && dom(x0) = insert("live", insert("c_bytes", empty))) && x0.live in set_type(omega)) && x0.c_bytes in set_type(omega), z := o], expand(h, abi.Objs))
qed

// (other live objects: the world's bytes still)
theorem abi.objs_live_typed: all o y. o in abi.Objs -> o in univ(1) -> y in set_type(omega) -> y in univ(1) -> fn_update(o, "live", y) in abi.Objs
proof
  fix o y
  assume ho hu hy hyu
  let O := fn_update(o, "live", y)
  let K := insert("live", insert("c_bytes", empty))
  have op := apply(abi.objs_parts, ho)
  have pf pd := (is_fun(o) && dom(o) = K by taut(set_select_def[s := powerset(cart(K, univ(1))),
    p := x0. ((is_fun(x0) && dom(x0) = K) && x0.live in set_type(omega)) && x0.c_bytes in set_type(omega), z := o], expand(ho, abi.Objs)))
  have fO := mp(fn_update_fun[f := o, k := "live", v := y], pf)
  have dO0 := mp(fn_update_dom[f := o, k := "live", v := y], pf, (("live" in dom(o)) by simp(pd)))
  have dO: dom(O) = K := trans(dO0, pd)
  have hO: O.c_bytes = o.c_bytes := mp(app_update_other[f := o, k := "live", v := y, x := "c_bytes"], simp())
  have lO: O.live = y by simp(pf)
  have pO: ((is_fun(O) && dom(O) = K) && O.live in set_type(omega)) && O.c_bytes in set_type(omega) by simp(fO, dO, lO, hO, hy, op.2, keep(set_type))
  have ou: O in univ(1) by simp(hu, hyu)
  have r := mp(rec_type_intro[u := 1, k := K, p := x0. ((is_fun(x0) && dom(x0) = K) && x0.live in set_type(omega)) && x0.c_bytes in set_type(omega), r := O], ou, fO, dO, pO)
  show by defs(r, abi.Objs)
qed

// (the world's bytes with other live objects: of their parts)
theorem abi.objs_eta: all o y. o in abi.Objs -> fn_update(o, "live", y) = abi.wob(y, o.c_bytes)
proof
  fix o y
  assume ho
  let K := insert("live", insert("c_bytes", empty))
  let B := abi.wob(y, o.c_bytes)
  have pf pd := (is_fun(o) && dom(o) = K by taut(set_select_def[s := powerset(cart(K, univ(1))),
    p := x0. ((is_fun(x0) && dom(x0) = K) && x0.live in set_type(omega)) && x0.c_bytes in set_type(omega), z := o], expand(ho, abi.Objs)))
  have fA := mp(fn_update_fun[f := o, k := "live", v := y], pf)
  have dA0 := mp(fn_update_dom[f := o, k := "live", v := y], pf, (("live" in dom(o)) by simp(pd)))
  have dA: dom(fn_update(o, "live", y)) = K := trans(dA0, pd)
  have de := dom_empty
  have f1 := mp(fn_update_fun[f := empty, k := "live", v := y], de.1)
  have d1 := mp(dom_update[f := empty, k := "live", v := y], de.1)
  have fB := mp(fn_update_fun[f := fn_update(empty, "live", y), k := "c_bytes", v := o.c_bytes], f1)
  have d2 := mp(dom_update[f := fn_update(empty, "live", y), k := "c_bytes", v := o.c_bytes], f1)
  have dset: all x. x in insert("c_bytes", insert("live", empty)) <-> x in K proof
    fix x
    have l: x in insert("c_bytes", insert("live", empty)) -> x in K proof
      assume h
      show by simp(h)
    qed
    have r: x in K -> x in insert("c_bytes", insert("live", empty)) proof
      assume h
      show by simp(h)
    qed
    show by taut(l, r)
  qed
  have dB: dom(B) = K by simp(d2, d1, de, mp(set_ext[a := insert("c_bytes", insert("live", empty)), b := K], dset))
  have vals: all k. k in dom(fn_update(o, "live", y)) -> fn_update(o, "live", y)[k] = B[k] proof
    fix k
    assume hk
    have k2: k = "live" || k = "c_bytes" by simp(rewrite(dA, hk))
    have c1: k = "live" -> fn_update(o, "live", y)[k] = B[k] proof
      assume e
      show by simp(e)
    qed
    have c2: k = "c_bytes" -> fn_update(o, "live", y)[k] = B[k] proof
      assume e
      show by simp(e)
    qed
    show by taut(k2, c1, c2)
  qed
  show := mp(rec_ext[a := fn_update(o, "live", y), b := B], fA, fB, trans(dA, sym(dB)), vals)
qed

// (the live objects of the ABI's world at an entry, its own bytes)
theorem abi.objs_at_live: all l fs. abi.objs_at(l, fs).live = l && abi.objs_at(l, fs).c_bytes = abi.cbytes0(fs)
proof
  fix l fs
  show by defs(simp(keep(abi.canary)), abi.objs_at)
qed

// (the world's bytes at an entry: its parts)
theorem abi.objs_at_wob: all l fs. abi.objs_at(l, fs) = abi.wob(l, abi.cbytes0(fs))
proof
  fix l fs
  show by defs(simp(keep(abi.canary)), abi.objs_at)
qed

// (other live objects, the same own bytes)
theorem abi.objs_at_upd: all v y fs. fn_update(abi.objs_at(v, fs), "live", y) = abi.objs_at(y, fs)
proof
  fix v y fs
  have sw := mp(fn_update_swap[f := fn_update(empty, "live", v), k := "c_bytes", a := abi.cbytes0(fs), j := "live", b := y], simp())
  have tw := fn_update_twice[f := empty, k := "live", a := v, b := y]
  show by defs(rewrite(tw, sw), abi.objs_at)
qed

theorem abi.get_ok: all sp objs mem s. s in univ(1) -> objs in univ(1) -> mem in univ(1) -> runs(abi.world.get(sp, objs, mem), s, ok(s, abi.wo(s, objs, mem)))
proof
  fix sp objs mem s
  assume hs ho hm
  have c := mp(all_elim(abi.objs_at_univ, {objs}, {s.fs_base}), ho)
  show by simp(hs, ho, hm, c)
qed

theorem abi.set_ok: all sp objs mem s w nv. s in univ(1) -> w in univ(1) -> nv in univ(1) -> nv in x86_64_linux.Vm -> abi.world_matches(s.vm, nv, w.vm, abi.wob(objs, w.objs.c_bytes), s.fs_base, sp) ->
  runs(abi.world.set(sp, objs, mem, w), s, ok(fn_update(fn_update(s, "vm", nv), "os", w.os), empty))
proof
  fix sp objs mem s w nv
  assume hs hw hvu hv hm
  show by simp(hs, hw, hvu, hv, hm, keep(abi.world_matches))
qed

// (abi_call's ghost parameter types its states only: one program for all)
theorem abi.call_ghost: all G spec args sp objs mem. abi.abi_call(G, spec, args, sp, objs, mem) = abi.abi_call(single(empty), spec, args, sp, objs, mem)
proof
  fix G spec args sp objs mem
  show by defs(simp(), abi.abi_call)
qed

theorem abi.ub_intro_g: all G f spec args objs mem s o. pair(s, o) in univ(1) -> abi.outcome(o) -> objs in univ(1) -> mem in univ(1) ->
  s.vm in x86_64_linux.Vm -> s.gpr[4] in bits(64) -> abi.view_ok(s, objs, mem) ->
  abi.cw(s, objs, mem).objs = abi.objs_at(objs, s.fs_base) ->
  abi.spec_raises(rec_and(abi.World, G), abi.cw(s, objs, mem), spec, args) ->
  runs(abi.abi_function(G, f, spec, args, objs, mem), s, o)
proof
  fix G f spec args objs mem s o
  assume hu ho hou hmu hsv hsp hwm hco hr
  have su: s in univ(1) by simp(hu)
  have gp := mp(all_elim(abi.get_ok, {abi.sp(s)}, {objs}, {mem}, {s}), su, hou, hmu)
  have c := mp(all_elim(abi.objs_at_univ, {objs}, {s.fs_base}), hou)
  have wun: abi.wo(s, objs, mem) in univ(1) by simp(su, hou, hmu, c)
  have gpu := mp(ghost_part_univ[u := 1, f := s, d := abi.KEYS], su)
  have cwu: abi.cw(s, objs, mem) in univ(1) by simp(wun, gpu)
  have wu := mp(restrict_univ[u := 1, f := abi.cw(s, objs, mem), d := abi.WKEYS], cwu)
  have vmu: s.vm in univ(1) by simp(su)
  have hw2 := rewrite(all_elim(abi.objs_at_wob, {objs}, {s.fs_base}), hwm.2)
  have hm2: abi.world_matches(s.vm, s.vm, restrict(abi.cw(s, objs, mem), abi.WKEYS).vm, abi.wob(objs, restrict(abi.cw(s, objs, mem), abi.WKEYS).objs.c_bytes), s.fs_base, abi.sp(s)) by simp(hw2, hco, all_elim(abi.objs_at_live, {objs}, {s.fs_base}), keep(abi.world_matches, abi.canary))
  have st := mp(all_elim(abi.set_ok, {abi.sp(s)}, {objs}, {mem}, {s}, {restrict(abi.cw(s, objs, mem), abi.WKEYS)}, {s.vm}), su, wu, vmu, hsv, hm2)
  show by simp(hu, ho, wun, gp, st, hr, gpu, cwu, keep(abi.world_pages, abi.world_matches, abi.spec_raises, abi.entry_ok, abi.world.get, abi.world.set))
qed

// ... with no ghost state
theorem abi.ub_intro: all f spec args objs mem s o. pair(s, o) in univ(1) -> abi.outcome(o) -> objs in univ(1) -> mem in univ(1) ->
  s.vm in x86_64_linux.Vm -> s.gpr[4] in bits(64) -> abi.view_ok(s, objs, mem) ->
  abi.cw(s, objs, mem).objs = abi.objs_at(objs, s.fs_base) ->
  abi.spec_raises(rec_and(abi.World, single(empty)), abi.cw(s, objs, mem), spec, args) ->
  runs(abi.abi_function(single(empty), f, spec, args, objs, mem), s, o)
proof
  show := all_elim(abi.ub_intro_g, {single(empty)})
qed

// The spec run on the world (abi_call): its outcome, written back as nv --
// the result (r0, r1) in the merged state.
theorem abi.call_ok: all spec args sp objs mem m nv w2 r0 r1. m in univ(1) -> objs in univ(1) -> mem in univ(1) ->
  runs(spec[args], abi.cw(m, objs, mem), ok(w2, pair(r0, r1))) -> w2 in univ(1) ->
  nv in univ(1) -> nv in x86_64_linux.Vm -> abi.world_matches(m.vm, nv, w2.vm, abi.wob(objs, w2.objs.c_bytes), m.fs_base, sp) -> r0 in univ(1) -> r1 in univ(1) ->
  runs(abi.abi_call(single(empty), spec, args, sp, objs, mem), m, ok(rec_merge(restrict(fn_update(fn_update(m, "vm", nv), "os", w2.os), abi.KEYS),
    ghost_part(w2, abi.WKEYS)), pair(r0, r1)))
proof
  fix spec args sp objs mem m nv w2 r0 r1
  assume mu ou hmu hspec wu nu hnv hnm r0u r1u
  have g := mp(all_elim(abi.get_ok, {sp}, {objs}, {mem}, {m}), mu, ou, hmu)
  have w2r := mp(restrict_univ[u := 1, f := w2, d := abi.WKEYS], wu)
  have hnm1: abi.world_matches(m.vm, nv, restrict(w2, abi.WKEYS).vm, abi.wob(objs, restrict(w2, abi.WKEYS).objs.c_bytes), m.fs_base, sp) by simp(hnm, keep(abi.world_matches))
  have st := mp(all_elim(abi.set_ok, {sp}, {objs}, {mem}, {m}, {restrict(w2, abi.WKEYS)}, {nv}), mu, w2r, nu, hnv, hnm1)
  have c := mp(all_elim(abi.objs_at_univ, {objs}, {m.fs_base}), ou)
  have wun: abi.wo(m, objs, mem) in univ(1) by simp(mu, ou, hmu, c)
  have gmu := mp(ghost_part_univ[u := 1, f := m, d := abi.KEYS], mu)
  have gwu := mp(ghost_part_univ[u := 1, f := w2, d := abi.WKEYS], wu)
  have m2u: fn_update(fn_update(m, "vm", nv), "os", w2.os) in univ(1) by simp(mu, nu, wu)
  have rmu := mp(restrict_univ[u := 1, f := fn_update(fn_update(m, "vm", nv), "os", w2.os), d := abi.KEYS], m2u)
  have rm := mp(restrict_univ[u := 1, f := m, d := abi.KEYS], mu)
  show by simp(mu, hmu, nu, rm, wun, gmu, gwu, rmu, wu, r0u, r1u, g, st, hspec, keep(abi.world_pages, abi.world_matches, abi.world.get, abi.world.set))
qed

// a run's state and outcome are in the universe
theorem abi.ok_univ: all s x. pair(s, ok(x, empty)) in univ(1) -> s in univ(1) && x in univ(1)
proof
  fix s x
  assume hp
  show by simp(hp)
qed

// the world of a machine state (its memory a memory) is a World
theorem abi.world_typed: all s objs mem. s in x86_64_linux.Machine -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> abi.wo(s, objs, mem) in univ(1) -> abi.wo(s, objs, mem) in abi.World
proof
  fix s objs mem
  assume hM ho hmv hu
  let W := abi.wo(s, objs, mem)
  have mt: s.fs_base in bits(64) && s.cpu in x86_64_linux.Cpu && s.os in x86_64_linux.Os by simp(expand(hM, x86_64_linux.Machine))
  have ot := mp(all_elim(abi.objs_at_typed, {objs}, {s.fs_base}), ho)
  have de := dom_empty
  have f0: is_fun(empty) by taut(de)
  have d0: dom(empty) = empty by taut(de)
  have f1 := mp(fn_update_fun[f := empty, k := "vm", v := mem], f0)
  have d1 := mp(dom_update[f := empty, k := "vm", v := mem], f0)
  have f2 := mp(fn_update_fun[f := fn_update(empty, "vm", mem), k := "os", v := s.os], f1)
  have d2 := mp(dom_update[f := fn_update(empty, "vm", mem), k := "os", v := s.os], f1)
  have f3 := mp(fn_update_fun[f := fn_update(fn_update(empty, "vm", mem), "os", s.os), k := "fs_base", v := s.fs_base], f2)
  have d3 := mp(dom_update[f := fn_update(fn_update(empty, "vm", mem), "os", s.os), k := "fs_base", v := s.fs_base], f2)
  have f4 := mp(fn_update_fun[f := fn_update(fn_update(fn_update(empty, "vm", mem), "os", s.os), "fs_base", s.fs_base), k := "cpu", v := s.cpu], f3)
  have d4 := mp(dom_update[f := fn_update(fn_update(fn_update(empty, "vm", mem), "os", s.os), "fs_base", s.fs_base), k := "cpu", v := s.cpu], f3)
  have f5 := mp(fn_update_fun[f := fn_update(fn_update(fn_update(fn_update(empty, "vm", mem), "os", s.os), "fs_base", s.fs_base), "cpu", s.cpu), k := "objs", v := abi.objs_at(objs, s.fs_base)], f4)
  have d5 := mp(dom_update[f := fn_update(fn_update(fn_update(fn_update(empty, "vm", mem), "os", s.os), "fs_base", s.fs_base), "cpu", s.cpu), k := "objs", v := abi.objs_at(objs, s.fs_base)], f4)
  have dset: all x. x in insert("objs", insert("cpu", insert("fs_base", insert("os", insert("vm", empty))))) <-> x in abi.WKEYS proof
    fix x
    have l: x in insert("objs", insert("cpu", insert("fs_base", insert("os", insert("vm", empty))))) -> x in abi.WKEYS proof
      assume h
      show by simp(h)
    qed
    have r: x in abi.WKEYS -> x in insert("objs", insert("cpu", insert("fs_base", insert("os", insert("vm", empty))))) proof
      assume h
      show by simp(h)
    qed
    show by taut(l, r)
  qed
  have deq := mp(set_ext[a := insert("objs", insert("cpu", insert("fs_base", insert("os", insert("vm", empty))))), b := abi.WKEYS], dset)
  have dw: dom(W) = abi.WKEYS by simp(d5, d4, d3, d2, d1, d0, deq)
  have pw: (((((is_fun(W) && dom(W) = abi.WKEYS) && W.vm in x86_64_linux.Vm) && W.os in x86_64_linux.Os) && W.fs_base in bits(64)) &&
      W.cpu in x86_64_linux.Cpu) && W.objs in abi.Objs by simp(f5, dw, mt, hmv, ot)
  have r := mp(rec_type_intro[u := 1, k := abi.WKEYS, p := x0. (((((is_fun(x0) && dom(x0) = abi.WKEYS) && x0.vm in x86_64_linux.Vm) && x0.os in x86_64_linux.Os) &&
    x0.fs_base in bits(64)) && x0.cpu in x86_64_linux.Cpu) && x0.objs in abi.Objs, r := W], hu, f5, dw, pw)
  show by defs(r, abi.World)
qed

// the spec raises from w: an exception outcome of its run (not a stack
// overflow)
theorem abi.raises_intro: all w x spec args e. x in rec_and(abi.World, single(empty)) -> e in univ(1) -> !(e = exc_val("stack_overflow", empty)) ->
  runs(spec[args], w, exc(x, e)) -> abi.spec_raises(rec_and(abi.World, single(empty)), w, spec, args)
proof
  fix w x spec args e
  assume hw he hno hr
  have ot := mp(mp(exc_outcome_type[s := rec_and(abi.World, single(empty)), v := cart(bits(64), bits(64)), x := x, e := e], hw), he)
  show by defs(ex_intro({exc(x, e)}, simp(ot, hr, hno, keep(outcome_type))), abi.spec_raises)
qed
