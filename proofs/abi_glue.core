// The ABI contract of a function (`abi.implements2_at`), reduced to facts
// about its machine run -- proven once, used for every function:
//
// - `implements_intro`: implements2_at from "every run from an entry that
//   meets entry_ok (with the program loaded) is one abi_function allows"
// - `ub_case`: the spec raises (undefined behavior) on the world the ABI
//   shows (`abi.view`): any outcome is allowed
// - `ret_case`: a normal return, in machine terms -- the final state is a
//   Machine, the callee-saved registers, rsp, rip and df are as the ABI
//   says, and rax:rdx and the memory are what the spec's run on the view
//   gives
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core core/records.core \
//     core/list.core core/loop.core build/musl_malloc_O0.core proofs/x86.core proofs/abi.core \
//     proofs/abi_restore.core proofs/abi_glue.core

// the stack at entry: rsp's page a writable stack page, rsp = 8 (mod 16),
// in the user half
theorem abi.entry_stack: all s args. s in x86_64_linux.Machine -> abi.entry_ok(s, args) ->
  x86_64_linux.can_access(app(s, "vm"), app(app(s, "gpr"), 4), 1) && int_mod(bits_add(64, app(app(s, "gpr"), 4), 8), 16) = 0 &&
  abi.stack_page(app(s, "vm"), int_div(app(app(s, "gpr"), 4), 4096)) && int_lt(app(app(s, "gpr"), 4), 140737488355328)
proof
  fix s args
  assume hM he
  have hsp: app(app(s, "gpr"), 4) in bits(64) by simp(hM)
  have w: x86_64_linux.can_access(app(s, "vm"), app(app(s, "gpr"), 4), 1) by simp(expand(he, abi.entry_ok), keep(x86_64_linux.can_access))
  have mp0: int_lt(int_div(app(app(s, "gpr"), 4), 4096), 34359738367) by simp(expand(expand(expand(w, x86_64_linux.can_access), x86_64_linux.mapped), x86_64_linux.page_of, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))
  have lt: int_lt(app(app(s, "gpr"), 4), 140737488355328) by simp(hsp, mp0)
  show by simp(w, lt, expand(he, abi.entry_ok), keep(x86_64_linux.can_access, abi.stack_page))
qed

// the stack's reserve: no other mapping in the guard gap below a stack
// page, and the gap above 0
theorem abi.reserve_gap: all vm. abi.stack_reserve(vm) -> abi.stack_gap_free(vm)
proof
  fix vm
  assume hr
  have g0 al sp nm := expand(hr, abi.stack_reserve)
  have c1: all p q. p in omega && q in omega -> ((abi.stack_page(vm, p) && int_lt(q, p)) && int_le(int_mul(int_sub(p, q), x86_64_linux.PAGE), x86_64_linux.STACK_GUARD_GAP)) && x86_64_linux.mapped(vm, q) ->
      abi.stack_page(vm, q) proof
    fix p q
    assume ho h
    have hs hl hg hm := h
    have f1 .. := mp(all_elim(sp, {p}), ho.1, hs)
    have ns: !abi.stack_page(vm, q) -> false proof
      assume hn
      have o := mp(all_elim(nm, {q}), ho.2, taut(hm, hn))
      have lo: !int_le(int_add(int_mul(int_add(q, 1), x86_64_linux.PAGE), x86_64_linux.STACK_GUARD_GAP), x86_64_linux.stack_floor(vm)) by defs(arith(expand(f1, x86_64_linux.PAGE), hl, expand(hg, x86_64_linux.PAGE, x86_64_linux.STACK_GUARD_GAP), ho), x86_64_linux.PAGE, x86_64_linux.STACK_GUARD_GAP)
      have hi: !int_le(app(vm, "stack_top"), int_mul(q, x86_64_linux.PAGE)) proof
        have f2 := mp(all_elim(sp, {p}), ho.1, hs).2
        show by defs(arith(expand(f2, x86_64_linux.PAGE), hl, ho), x86_64_linux.PAGE)
      qed
      show by taut(o, lo, hi)
    qed
    show by taut(ns)
  qed
  have c2: all p. p in omega -> abi.stack_page(vm, p) -> int_le(x86_64_linux.STACK_GUARD_GAP, int_mul(p, x86_64_linux.PAGE)) proof
    fix p
    assume ho hs
    have f1 .. := mp(all_elim(sp, {p}), ho, hs)
    show by defs(arith(expand(f1, x86_64_linux.PAGE), expand(g0, x86_64_linux.STACK_GUARD_GAP, x86_64_linux.PAGE), ho), x86_64_linux.STACK_GUARD_GAP, x86_64_linux.PAGE)
  qed
  show by defs(taut(c1, c2), abi.stack_gap_free)
qed

// the entry's stack: its reserve
theorem abi.entry_rsv: all s args. abi.entry_ok(s, args) -> abi.stack_reserve(app(s, "vm"))
proof
  fix s args
  assume he
  show by taut(expand(he, abi.entry_ok))
qed

// ... at the entry
theorem abi.entry_gap: all s args. abi.entry_ok(s, args) -> abi.stack_gap_free(app(s, "vm"))
proof
  fix s args
  assume he
  have r: abi.stack_reserve(app(s, "vm")) by taut(expand(he, abi.entry_ok))
  show := apply(abi.reserve_gap, r)
qed

// the first argument, if passed, is in rdi
theorem abi.arg_passed: all s args. args in abi.ARGS -> abi.entry_ok(s, args) -> ord_le(1, seq_len(args)) -> app(app(s, "gpr"), 7) = app(args, 0)
proof
  fix s args
  assume hA he hl
  have ac: all x0. x0 in omega -> int_lt(x0, seq_len(args)) -> app(app(s, "gpr"), app(abi.ARG_REGS, x0)) = app(args, x0) by taut(expand(he, abi.entry_ok))
  have z0: 0 in omega by simp()
  have n: seq_len(args) in omega by simp(hA)
  have l0: int_lt(0, seq_len(args)) by arith(n, expand(hl, ord_le))
  have ar0 := at({app(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(7), seq_one(6)), seq_one(2)), seq_one(1)), seq_one(8)), seq_one(9)), 0)})
  show by simp(expand(mp(all_elim(ac, {0}), z0, l0), abi.ARG_REGS), ar0)
qed

// the state a raising spec ends in: a world
def abi.raise_state(x) := x in rec_and(abi.World, single(empty))

// (a set of addresses: a value)
theorem abi.objs_univ: all objs. objs in set_type(omega) -> objs in univ(1)
proof
  fix objs
  assume h
  have ss: subset(objs, omega) by taut(powerset_def[s := omega, a := objs], expand(h, set_type))
  show := mp(univ_subset[u := 1, a := objs, b := omega], omega_univ, ss)
qed

// undefined behavior: the spec raises from the world
theorem abi.ub_case: all f spec args objs mem s o e x. s in x86_64_linux.Machine -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> abi.view_ok(s, objs, mem) -> e in univ(1) ->
  !(e = exc_val("stack_overflow", empty)) -> abi.raise_state(x) ->
  runs(app(spec, args), abi.view(s, objs, mem), exc(x, e)) -> pair(s, o) in univ(1) -> abi.outcome(o) ->
  runs(abi.abi_function(single(empty), f, spec, args, objs, mem), s, o)
proof
  fix f spec args objs mem s o e x
  assume hM hot hmv hwm he hno hx hr hp ho
  have hmu := apply(x86.vm_univ, hmv)
  have su: s in univ(1) by simp(hp)
  have ou := apply(abi.objs_univ, hot)
  have kf := apply(pow_cart_fst, unsel(expand(hM, x86_64_linux.Machine)))
  have gs0 := apply(ghost_part_none, kf)
  have hsv: app(s, "vm") in x86_64_linux.Vm by simp(hM)
  have hsp: app(app(s, "gpr"), 4) in bits(64) by simp(hM)
  // the world is a World; with s's (empty) ghost part, the world the ABI shows
  have vu: abi.view(s, objs, mem) in univ(1) by simp(su, ou, hmu)
  have wt := apply(abi.world_typed, hM, hot, hmv, vu)
  have gi: ghost_part(s, abi.KEYS) in single(empty) by simp(gs0)
  have ra: rec_merge(abi.view(s, objs, mem), ghost_part(s, abi.KEYS)) in rec_and(abi.World, single(empty)) by defs(apply(rec_and_intro, wt, gi), rec_merge)
  have e0: rec_merge(abi.view(s, objs, mem), ghost_part(s, abi.KEYS)) = abi.view(s, objs, mem) by simp(gs0)
  have rv: abi.view(s, objs, mem) in rec_and(abi.World, single(empty)) := rewrite(e0, ra)
  have xr: x in rec_and(abi.World, single(empty)) := expand(hx, abi.raise_state)
  have hr2 := rewrite(sym(e0), hr)
  have hra := apply(abi.raises_intro, {rec_merge(abi.view(s, objs, mem), ghost_part(s, abi.KEYS))}, {x}, {spec}, {args}, {e}, xr, he, hno, hr2)
  show := apply(abi.ub_intro, {f}, hp, ho, ou, hmu, hsv, hsp, hwm, hra)
qed

// a normal return: the machine's final state m1, the spec's run on the
// world ending in w2 with the result in rax:rdx
theorem abi.ret_case: all f spec args objs mem s m1 w2. s in x86_64_linux.Machine -> abi.entry_ok(s, args) -> m1 in x86_64_linux.Machine -> pair(s, ok(m1, empty)) in univ(1) ->
  objs in set_type(omega) -> (all x. x in omega -> x in objs -> (int_le(abi.sp(s), x) && abi.stack_page(app(s, "vm"), int_div(x, x86_64_linux.PAGE))) && x86_64_linux.can_access(app(s, "vm"), bits_of_int(64, x), 1)) -> mem in x86_64_linux.Vm -> abi.view_ok(s, objs, mem) ->
  runs(app(spec, args), abi.view(s, objs, mem), ok(w2, pair(app(app(m1, "gpr"), 0), app(app(m1, "gpr"), 2)))) -> w2 in abi.World -> w2 in univ(1) ->
  abi.world_matches(app(s, "vm"), app(m1, "vm"), app(w2, "vm"), objs, abi.sp(s)) -> app(m1, "os") = app(w2, "os") -> app(m1, "fs_base") = app(w2, "fs_base") ->
  app(m1, "cpu") = app(s, "cpu") -> app(m1, "gs_base") = app(s, "gs_base") -> app(m1, "rip") = abi.ret(s) -> app(app(m1, "gpr"), 4) = abi.sp(s) ->
  abi.callee_saved(m1, s) -> !app(app(m1, "flags"), "df") ->
  runs(abi.abi_function(single(empty), f, spec, args, objs, mem), s, ok(m1, empty))
proof
  fix f spec args objs mem s m1 w2
  assume hM he hM1 hp hot hob hmv hwm hr hw hwu hnm hos hfs hcpu hgs hrip hrsp hcs hdf
  // abi.ret_intro's states, for nv, g, xm, fl the machine's
  let x7 := abi.cw(s, objs, mem)
  let s1 := fn_update(fn_update(fn_update(s, "vm", app(s, "vm")), "os", app(s, "os")), "fs_base", app(s, "fs_base"))
  let mm1 := rec_merge(restrict(s1, abi.KEYS), ghost_part(x7, abi.WKEYS))
  let in1 := abi.cw(mm1, objs, mem)
  have ok0 := apply(abi.ok_univ, hp)
  have su: s in univ(1) by taut(ok0)
  have m1u: m1 in univ(1) by taut(ok0)
  have ou := apply(abi.objs_univ, hot)
  have kf := apply(pow_cart_fst, unsel(expand(hM, x86_64_linux.Machine)))
  have rs0 := apply(restrict_all, kf)
  have gs0 := apply(ghost_part_none, kf)
  have gw0 := apply(ghost_part_none, apply(pow_cart_fst, unsel(expand(hw, abi.World))))
  have ein: in1 = abi.view(s, objs, mem) by simp(rs0, gs0)
  have hspec := rewrite(sym(ein), hr)
  // false is a value (the prelude's prop_univ)
  have fbu: false in univ(1) by simp()
  have bdm: app(app(m1, "flags"), "df") in bool by simp(hM1)
  have dfm := apply(not_eq_false, bdm, hdf)
  // the machine's registers, flags and memory: the havoc's choice, the memory written back
  have hsv: app(s, "vm") in x86_64_linux.Vm by simp(hM)
  have hsp: app(app(s, "gpr"), 4) in bits(64) by simp(hM)
  have h0: app(app(m1, "gpr"), 0) in bits(64) by simp(hM1)
  have h1: app(app(m1, "gpr"), 2) in bits(64) by simp(hM1)
  have hnu: app(m1, "vm") in univ(1) by simp(m1u)
  have hnv: app(m1, "vm") in x86_64_linux.Vm by simp(hM1)
  have gu: app(m1, "gpr") in univ(1) by simp(m1u)
  have tg: app(m1, "gpr") in fn_space(x86_64_linux.Reg, bits(64)) by simp(hM1)
  have xu: app(m1, "xmm") in univ(1) by simp(m1u)
  have tx: app(m1, "xmm") in fn_space(x86_64_linux.Reg, bits(128)) by simp(hM1)
  have fu: app(m1, "flags") in univ(1) by simp(m1u)
  have tf: app(m1, "flags") in x86_64_linux.Flags by simp(hM1)
  have hmu := apply(x86.vm_univ, hmv)
  have rt := apply(abi.ret_intro, {f}, {spec}, {args}, {objs}, {mem}, {s}, {app(m1, "vm")}, {w2}, {app(app(m1, "gpr"), 0)}, {app(app(m1, "gpr"), 2)}, {app(m1, "gpr")}, {app(m1, "xmm")}, {app(m1, "flags")},
    su, ou, hmu, hsv, hsp, hob, hwm, hspec, hwu, h0, h1, hnu, hnv, hnm, gu, tg, xu, tx, fu, tf)
  // its final state is m1
  let m2 := fn_update(fn_update(fn_update(mm1, "vm", app(m1, "vm")), "os", app(w2, "os")), "fs_base", app(w2, "fs_base"))
  let x12 := rec_merge(restrict(m2, abi.KEYS), ghost_part(w2, abi.WKEYS))
  let xx := fn_update(fn_update(fn_update(x12, "gpr", app(m1, "gpr")), "xmm", app(m1, "xmm")), "flags", app(m1, "flags"))
  let gg := fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(app(xx, "gpr"), 3, app(app(s, "gpr"), 3)), 5, app(app(s, "gpr"), 5)), 12, app(app(s, "gpr"), 12)), 13, app(app(s, "gpr"), 13)), 14, app(app(s, "gpr"), 14)), 15, app(app(s, "gpr"), 15))
  let xf := fn_update(xx, "gpr", gg)
  let aa := fn_update(xf, "gpr", fn_update(app(xf, "gpr"), 4, abi.sp(s)))
  let bb := fn_update(aa, "gpr", fn_update(app(aa, "gpr"), 0, app(app(m1, "gpr"), 0)))
  let cc := fn_update(bb, "gpr", fn_update(app(bb, "gpr"), 2, app(app(m1, "gpr"), 2)))
  let dd := fn_update(cc, "flags", fn_update(app(cc, "flags"), "df", false))
  let nn := fn_update(dd, "rip", abi.ret(s))
  have neq: nn = m1 by simp(rs0, gs0, gw0, hM, hM1, su, m1u, hwu, fbu, hw, hos, hfs, hcpu, hgs, hrip, hrsp, hcs, dfm)
  show := rewrite(neq, rt)
qed

// the contract from the runs that start at f, as the ABI requires
theorem abi.implements_intro: all f spec base code statics.
  (all args objs mem s o. args in abi.ARGS -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> abi.loaded(app(s, "vm"), base, code, statics) -> app(s, "rip") = f -> abi.entry_ok(s, args) ->
    (all x. x in omega -> x in objs -> (int_le(abi.sp(s), x) && abi.stack_page(app(s, "vm"), int_div(x, x86_64_linux.PAGE))) && x86_64_linux.can_access(app(s, "vm"), bits_of_int(64, x), 1)) -> abi.view_ok(s, objs, mem) ->
    runs(abi.run_to_return(), s, o) -> runs(abi.abi_function(single(empty), f, spec, args, objs, mem), s, o)) ->
  abi.implements2_at(single(empty), f, spec, base, code, statics)
proof
  fix f spec base code statics
  assume hrun
  let ld(m) := abi.loaded(app(m, "vm"), base, code, statics)
  let rel(a, ob, mm) := mkprog(x1 x2. !ld(x1) || bind_rel(abi.abi_function(single(empty), f, spec, a, ob, mm), x1, x3 x4. x2 = ok(x3, empty), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))
  have main: all x0. all x1. all x2. (x0 in abi.ARGS && x1 in set_type(omega)) && x2 in x86_64_linux.Vm -> (all s h o. s in x86_64_linux.Machine -> h in single(empty) -> runs(abi.run_to_return(), s, o) -> (ex h2. h2 in single(empty) && runs(rel(x0, x1, x2), union2(s, h), with_ghost(o, h2)))) proof
    fix args objs mem
    assume hAo
    have hA hot hmv := hAo
    show all s h o. s in x86_64_linux.Machine -> h in single(empty) -> runs(abi.run_to_return(), s, o) -> (ex h2. h2 in single(empty) && runs(rel(args, objs, mem), union2(s, h), with_ghost(o, h2))) proof
      fix s h o
      assume hM hh hr
      have hp := apply(abi.run_univ, hr)
      have hsh := apply(abi.run_shape, hr)
      // abi_function: its preconditions, else the given runs
      have pre: !(app(s, "rip") = f && abi.entry_ok(s, args)) -> runs(abi.abi_function(single(empty), f, spec, args, objs, mem), s, o) proof
        assume hn
        show by simp(hp, hn, keep(abi.entry_ok, abi.world.get, abi.world.set, abi.abi_call, abi.abi_restore, abi.abi_set_result, abi.spec_raises, abi.overflow_ok, abi.overflow_at))
      qed
      have pre2: !(all x. x in omega -> x in objs -> (int_le(abi.sp(s), x) && abi.stack_page(app(s, "vm"), int_div(x, x86_64_linux.PAGE))) && x86_64_linux.can_access(app(s, "vm"), bits_of_int(64, x), 1)) -> runs(abi.abi_function(single(empty), f, spec, args, objs, mem), s, o) proof
        assume hn
        show by simp(hp, hn, keep(abi.entry_ok, abi.world.get, abi.world.set, abi.abi_call, abi.abi_restore, abi.abi_set_result, abi.spec_raises, abi.overflow_ok, abi.overflow_at))
      qed
      have pre3: !abi.view_ok(s, objs, mem) -> runs(abi.abi_function(single(empty), f, spec, args, objs, mem), s, o) proof
        assume hn
        show by simp(hp, hn, keep(abi.world_pages, abi.world_matches, abi.entry_ok, abi.world.get, abi.world.set, abi.abi_call, abi.abi_restore, abi.abi_set_result, abi.spec_raises, abi.overflow_ok, abi.overflow_at))
      qed
      have mc: ld(s) -> runs(abi.abi_function(single(empty), f, spec, args, objs, mem), s, o) proof
        assume hc
        have run: app(s, "rip") = f && abi.entry_ok(s, args) -> (all x. x in omega -> x in objs -> (int_le(abi.sp(s), x) && abi.stack_page(app(s, "vm"), int_div(x, x86_64_linux.PAGE))) && x86_64_linux.can_access(app(s, "vm"), bits_of_int(64, x), 1)) -> abi.view_ok(s, objs, mem) -> runs(abi.abi_function(single(empty), f, spec, args, objs, mem), s, o) proof
          assume hy hb hw
          show := apply(hrun, hA, hot, hmv, hM, hc, hy, hy, hb, hw, hr)
        qed
        show by taut(pre, pre2, pre3, run)
      qed
      have mc2: !ld(s) || runs(abi.abi_function(single(empty), f, spec, args, objs, mem), s, o) by taut(mc)
      show by defs(ex_intro({empty}, simp(hh, hp, hsh, mc2, keep(abi.abi_function, abi.loaded, abi.run_to_return))), with_ghost)
    qed
  qed
  show by defs(main, abi.implements2_at, refines_ghost)
qed
