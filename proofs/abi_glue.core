// The ABI contract of a function (`abi.implements2_at`), reduced to facts
// about its machine run -- proven once, used for every function:
//
// - `implements_intro`: implements2_at from "every run from an entry that
//   meets entry_ok (with the program loaded) is one abi_function allows"
// - `ub_case`: the spec raises (undefined behavior) on the world the ABI
//   shows (`abi.view`): any outcome is allowed
// - `ret_case`: a normal return, in machine terms -- the final state is a
//   Machine, the callee-saved registers, rsp, rip and df are as the ABI
//   says, and rax:rdx and the memory are what the spec's run on the view
//   gives
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core core/records.core \
//     core/list.core core/loop.core build/musl_malloc_O0.core proofs/x86.core proofs/abi.core \
//     proofs/abi_restore.core proofs/abi_glue.core

abbrev abi.KEYS := insert("gpr", insert("xmm", insert("rip", insert("flags", insert("cpu", insert("fs_base", insert("gs_base", insert("vm", insert("os", empty)))))))))
abbrev abi.WKEYS := insert("vm", insert("os", insert("fs_base", insert("cpu", insert("sp", empty)))))
abbrev abi.ARGS := set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6))
// the caller's stack pointer and the return address, at entry s
abbrev abi.sp(s) := bits_add(64, app(app(s, "gpr"), 4), 8)
abbrev abi.ret(s) := x86_64_linux.le(app(app(s, "vm"), "bytes"), app(app(s, "gpr"), 4), 8)
// the world with memory v, the rest from m, the stack pointer of s
abbrev abi.wv(v, m, s) := fn_update(fn_update(fn_update(fn_update(fn_update(empty, "vm", v), "os", app(m, "os")), "fs_base", app(m, "fs_base")), "cpu", app(m, "cpu")), "sp", abi.sp(s))
// the world the spec sees at entry s, through the view v of the memory
abbrev abi.view(v, s) := abi.wv(v, s, s)
abbrev abi.outcome(o) := (ex m1 e. o = ok(m1, e)) || (ex m1 e. o = exc(m1, e)) || (ex t. o = diverge(t))
// the callee-saved registers of m as at entry s
abbrev abi.callee_saved(m, s) := app(app(m, "gpr"), 3) = app(app(s, "gpr"), 3) && app(app(m, "gpr"), 5) = app(app(s, "gpr"), 5) &&
  app(app(m, "gpr"), 12) = app(app(s, "gpr"), 12) && app(app(m, "gpr"), 13) = app(app(s, "gpr"), 13) &&
  app(app(m, "gpr"), 14) = app(app(s, "gpr"), 14) && app(app(m, "gpr"), 15) = app(app(s, "gpr"), 15)

// the stack at entry: rsp's page a writable stack page, rsp = 8 (mod 16),
// in the user half
theorem abi.entry_stack: all s args. s in x86_64_linux.Machine -> abi.entry_ok(s, args) ->
  x86_64_linux.can_access(app(s, "vm"), app(app(s, "gpr"), 4), 1) && int_mod(bits_add(64, app(app(s, "gpr"), 4), 8), 16) = 0 &&
  abi.stack_page(app(s, "vm"), int_div(app(app(s, "gpr"), 4), 4096)) && int_lt(app(app(s, "gpr"), 4), 140737488355328)
proof
  fix s
  fix args
  assume hM: s in x86_64_linux.Machine
  assume he: abi.entry_ok(s, args)
  have hsp: app(app(s, "gpr"), 4) in bits(64) by simp(hM)
  have w: x86_64_linux.can_access(app(s, "vm"), app(app(s, "gpr"), 4), 1) by simp(expand(he, abi.entry_ok), keep(x86_64_linux.can_access))
  have mp0: int_lt(int_div(app(app(s, "gpr"), 4), 4096), 34359738367) by simp(expand(expand(expand(w, x86_64_linux.can_access), x86_64_linux.mapped), x86_64_linux.page_of, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))
  have lt: int_lt(app(app(s, "gpr"), 4), 140737488355328) by simp(hsp, mp0)
  show by simp(w, lt, expand(he, abi.entry_ok), keep(x86_64_linux.can_access, abi.stack_page))
qed

// the first argument, if not 0, is in rdi
theorem abi.arg0: all s args. s in x86_64_linux.Machine -> args in abi.ARGS -> abi.entry_ok(s, args) -> !(bits_of_int(64, app(args, 0)) = 0) ->
  app(app(s, "gpr"), 7) = app(args, 0)
proof
  fix s
  fix args
  assume hM: s in x86_64_linux.Machine
  assume hA: args in abi.ARGS
  assume he: abi.entry_ok(s, args)
  assume hz: !(bits_of_int(64, app(args, 0)) = 0)
  have lt: args in list_type(bits(64)) by simp(hA)
  have nz: app(args, 0) = empty -> false proof
    assume e0: app(args, 0) = empty
    show by simp(rewrite(e0, hz))
  qed
  have hl: int_lt(0, seq_len(args)) by taut(all_elim(abi.args_empty, {args}), lt, nz)
  have ac: all x0. x0 in omega -> int_lt(x0, seq_len(args)) -> app(app(s, "gpr"), app(abi.ARG_REGS, x0)) = app(args, x0) by taut(expand(he, abi.entry_ok))
  have z0: 0 in omega by simp()
  have ar0 := at({app(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(7), seq_one(6)), seq_one(2)), seq_one(1)), seq_one(8)), seq_one(9)), 0)})
  show by simp(expand(mp(all_elim(ac, {0}), z0, hl), abi.ARG_REGS), ar0)
qed

// the first argument, if passed, is in rdi
theorem abi.arg_passed: all s args. args in abi.ARGS -> abi.entry_ok(s, args) -> ord_le(1, seq_len(args)) -> app(app(s, "gpr"), 7) = app(args, 0)
proof
  fix s
  fix args
  assume hA: args in abi.ARGS
  assume he: abi.entry_ok(s, args)
  assume hl: ord_le(1, seq_len(args))
  have ac: all x0. x0 in omega -> int_lt(x0, seq_len(args)) -> app(app(s, "gpr"), app(abi.ARG_REGS, x0)) = app(args, x0) by taut(expand(he, abi.entry_ok))
  have z0: 0 in omega by simp()
  have n: seq_len(args) in omega by simp(hA)
  have l0: int_lt(0, seq_len(args)) by arith(n, expand(hl, ord_le))
  have ar0 := at({app(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(7), seq_one(6)), seq_one(2)), seq_one(1)), seq_one(8)), seq_one(9)), 0)})
  show by simp(expand(mp(all_elim(ac, {0}), z0, l0), abi.ARG_REGS), ar0)
qed

// undefined behavior: the spec raises from the view
theorem abi.ub_case: all f spec args s o v e. s in x86_64_linux.Machine -> v in x86_64_linux.Vm -> v in univ(1) ->
  abi.scratch_view(v, app(s, "vm"), abi.sp(s)) -> abi.world_matches(app(s, "vm"), app(s, "vm"), v, abi.sp(s)) -> e in univ(1) ->
  runs(app(spec, args), abi.view(v, s), exc(abi.view(v, s), e)) -> pair(s, o) in univ(1) -> abi.outcome(o) ->
  runs(abi.abi_function(single(empty), f, spec, args), s, o)
proof
  fix f
  fix spec
  fix args
  fix s
  fix o
  fix v
  fix e
  assume hM: s in x86_64_linux.Machine
  assume hv: v in x86_64_linux.Vm
  assume hvu: v in univ(1)
  assume hs: abi.scratch_view(v, app(s, "vm"), abi.sp(s))
  assume hm: abi.world_matches(app(s, "vm"), app(s, "vm"), v, abi.sp(s))
  assume he: e in univ(1)
  assume hr: runs(app(spec, args), abi.view(v, s), exc(abi.view(v, s), e))
  assume hp: pair(s, o) in univ(1)
  assume ho: abi.outcome(o)
  have su: s in univ(1) by simp(hp)
  have kf := apply(pow_cart_fst, unsel(expand(hM, x86_64_linux.Machine)))
  have gs0 := apply(ghost_part_none, kf)
  have hsv: app(s, "vm") in x86_64_linux.Vm by simp(hM)
  have hsp: app(app(s, "gpr"), 4) in bits(64) by simp(hM)
  // the view is a World; with s's (empty) ghost part, the world the ABI shows
  have vu: abi.view(v, s) in univ(1) by simp(su, hvu)
  have wt: abi.view(v, s) in abi.World by simp(hM, hv, vu)
  have gi: ghost_part(s, abi.KEYS) in single(empty) by simp(gs0)
  have ra: rec_merge(abi.view(v, s), ghost_part(s, abi.KEYS)) in rec_and(abi.World, single(empty)) by defs(apply(rec_and_intro, wt, gi), rec_merge)
  have e0: rec_merge(abi.view(v, s), ghost_part(s, abi.KEYS)) = abi.view(v, s) by simp(gs0)
  have hra := apply(abi.raises_intro, ra, he, rewrite(sym(e0), hr))
  show := apply(abi.ub_intro, {f}, hp, ho, hvu, hv, hs, hm, hsv, hsp, hra)
qed

// a normal return: the machine's final state m1, the spec's run on the view
// v ending in w2 with the result in rax:rdx
theorem abi.ret_case: all f spec args s m1 v w2. s in x86_64_linux.Machine -> abi.entry_ok(s, args) -> m1 in x86_64_linux.Machine -> pair(s, ok(m1, empty)) in univ(1) ->
  v in x86_64_linux.Vm -> v in univ(1) -> abi.scratch_view(v, app(s, "vm"), abi.sp(s)) -> abi.world_matches(app(s, "vm"), app(s, "vm"), v, abi.sp(s)) ->
  runs(app(spec, args), abi.view(v, s), ok(w2, pair(app(app(m1, "gpr"), 0), app(app(m1, "gpr"), 2)))) -> w2 in abi.World -> w2 in univ(1) ->
  abi.world_matches(app(s, "vm"), app(m1, "vm"), app(w2, "vm"), abi.sp(s)) -> app(m1, "os") = app(w2, "os") -> app(m1, "fs_base") = app(w2, "fs_base") ->
  app(m1, "cpu") = app(s, "cpu") -> app(m1, "gs_base") = app(s, "gs_base") -> app(m1, "rip") = abi.ret(s) -> app(app(m1, "gpr"), 4) = abi.sp(s) ->
  abi.callee_saved(m1, s) -> !app(app(m1, "flags"), "df") ->
  runs(abi.abi_function(single(empty), f, spec, args), s, ok(m1, empty))
proof
  fix f
  fix spec
  fix args
  fix s
  fix m1
  fix v
  fix w2
  assume hM: s in x86_64_linux.Machine
  assume he: abi.entry_ok(s, args)
  assume hM1: m1 in x86_64_linux.Machine
  assume hp: pair(s, ok(m1, empty)) in univ(1)
  assume hv: v in x86_64_linux.Vm
  assume hvu: v in univ(1)
  assume hs: abi.scratch_view(v, app(s, "vm"), abi.sp(s))
  assume hm: abi.world_matches(app(s, "vm"), app(s, "vm"), v, abi.sp(s))
  assume hr: runs(app(spec, args), abi.view(v, s), ok(w2, pair(app(app(m1, "gpr"), 0), app(app(m1, "gpr"), 2))))
  assume hw: w2 in abi.World
  assume hwu: w2 in univ(1)
  assume hnm: abi.world_matches(app(s, "vm"), app(m1, "vm"), app(w2, "vm"), abi.sp(s))
  assume hos: app(m1, "os") = app(w2, "os")
  assume hfs: app(m1, "fs_base") = app(w2, "fs_base")
  assume hcpu: app(m1, "cpu") = app(s, "cpu")
  assume hgs: app(m1, "gs_base") = app(s, "gs_base")
  assume hrip: app(m1, "rip") = abi.ret(s)
  assume hrsp: app(app(m1, "gpr"), 4) = abi.sp(s)
  assume hcs: abi.callee_saved(m1, s)
  assume hdf: !app(app(m1, "flags"), "df")
  // abi.ret_intro's states, for nv, g, xm, fl the machine's
  let x7 := rec_merge(abi.view(v, s), ghost_part(s, abi.KEYS))
  let s1 := fn_update(fn_update(fn_update(s, "vm", app(s, "vm")), "os", app(s, "os")), "fs_base", app(s, "fs_base"))
  let mm1 := rec_merge(restrict(s1, abi.KEYS), ghost_part(x7, abi.WKEYS))
  let in1 := rec_merge(abi.wv(v, mm1, s), ghost_part(mm1, abi.KEYS))
  have ok0 := apply(abi.ok_univ, hp)
  have su: s in univ(1) by taut(ok0)
  have m1u: m1 in univ(1) by taut(ok0)
  have kf := apply(pow_cart_fst, unsel(expand(hM, x86_64_linux.Machine)))
  have rs0 := apply(restrict_all, kf)
  have gs0 := apply(ghost_part_none, kf)
  have gw0 := apply(ghost_part_none, apply(pow_cart_fst, unsel(expand(hw, abi.World))))
  have ein: in1 = abi.view(v, s) by simp(rs0, gs0)
  have hspec := rewrite(sym(ein), hr)
  // false is a value (the prelude's prop_univ)
  have fbu: false in univ(1) by simp()
  have bdm: app(app(m1, "flags"), "df") in bool by simp(hM1)
  have dfm := apply(not_eq_false, bdm, hdf)
  // the machine's registers, flags and memory: the havoc's choice, the memory written back
  have hsv: app(s, "vm") in x86_64_linux.Vm by simp(hM)
  have hsp: app(app(s, "gpr"), 4) in bits(64) by simp(hM)
  have h0: app(app(m1, "gpr"), 0) in bits(64) by simp(hM1)
  have h1: app(app(m1, "gpr"), 2) in bits(64) by simp(hM1)
  have hnu: app(m1, "vm") in univ(1) by simp(m1u)
  have hnv: app(m1, "vm") in x86_64_linux.Vm by simp(hM1)
  have gu: app(m1, "gpr") in univ(1) by simp(m1u)
  have tg: app(m1, "gpr") in fn_space(x86_64_linux.Reg, bits(64)) by simp(hM1)
  have xu: app(m1, "xmm") in univ(1) by simp(m1u)
  have tx: app(m1, "xmm") in fn_space(x86_64_linux.Reg, bits(128)) by simp(hM1)
  have fu: app(m1, "flags") in univ(1) by simp(m1u)
  have tf: app(m1, "flags") in x86_64_linux.Flags by simp(hM1)
  have rt := apply(abi.ret_intro, {f}, {spec}, {args}, {s}, {v}, {app(m1, "vm")}, {w2}, {app(app(m1, "gpr"), 0)}, {app(app(m1, "gpr"), 2)}, {app(m1, "gpr")}, {app(m1, "xmm")}, {app(m1, "flags")},
    su, hvu, hv, hsv, hsp, hs, hm, hspec, hwu, h0, h1, hnu, hnv, hnm, gu, tg, xu, tx, fu, tf)
  // its final state is m1
  let m2 := fn_update(fn_update(fn_update(mm1, "vm", app(m1, "vm")), "os", app(w2, "os")), "fs_base", app(w2, "fs_base"))
  let x12 := rec_merge(restrict(m2, abi.KEYS), ghost_part(w2, abi.WKEYS))
  let xx := fn_update(fn_update(fn_update(x12, "gpr", app(m1, "gpr")), "xmm", app(m1, "xmm")), "flags", app(m1, "flags"))
  let gg := fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(app(xx, "gpr"), 3, app(app(s, "gpr"), 3)), 5, app(app(s, "gpr"), 5)), 12, app(app(s, "gpr"), 12)), 13, app(app(s, "gpr"), 13)), 14, app(app(s, "gpr"), 14)), 15, app(app(s, "gpr"), 15))
  let xf := fn_update(xx, "gpr", gg)
  let aa := fn_update(xf, "gpr", fn_update(app(xf, "gpr"), 4, abi.sp(s)))
  let bb := fn_update(aa, "gpr", fn_update(app(aa, "gpr"), 0, app(app(m1, "gpr"), 0)))
  let cc := fn_update(bb, "gpr", fn_update(app(bb, "gpr"), 2, app(app(m1, "gpr"), 2)))
  let dd := fn_update(cc, "flags", fn_update(app(cc, "flags"), "df", false))
  let nn := fn_update(dd, "rip", abi.ret(s))
  have neq: nn = m1 by simp(rs0, gs0, gw0, hM, hM1, su, m1u, hwu, fbu, hw, hos, hfs, hcpu, hgs, hrip, hrsp, hcs, dfm)
  show := rewrite(neq, rt)
qed

// the contract from the runs that start at f, as the ABI requires
theorem abi.implements_intro: all f spec base code statics.
  (all args s o. args in abi.ARGS -> s in x86_64_linux.Machine -> abi.loaded(app(s, "vm"), base, code, statics) -> app(s, "rip") = f -> abi.entry_ok(s, args) ->
    runs(abi.run_to_return(), s, o) -> runs(abi.abi_function(single(empty), f, spec, args), s, o)) ->
  abi.implements2_at(single(empty), f, spec, base, code, statics)
proof
  fix f
  fix spec
  fix base
  fix code
  fix statics
  assume hrun: all args s o. args in abi.ARGS -> s in x86_64_linux.Machine -> abi.loaded(app(s, "vm"), base, code, statics) -> app(s, "rip") = f -> abi.entry_ok(s, args) ->
    runs(abi.run_to_return(), s, o) -> runs(abi.abi_function(single(empty), f, spec, args), s, o)
  let ld(m) := abi.loaded(app(m, "vm"), base, code, statics)
  let rel(a) := mkprog(x1 x2. !ld(x1) || bind_rel(abi.abi_function(single(empty), f, spec, a), x1, x3 x4. x2 = ok(x3, empty), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))
  have main: all x0. x0 in abi.ARGS -> (all s h o. s in x86_64_linux.Machine -> h in single(empty) -> runs(abi.run_to_return(), s, o) -> (ex h2. h2 in single(empty) && runs(rel(x0), union2(s, h), with_ghost(o, h2)))) proof
    fix args
    assume hA: args in abi.ARGS
    show all s h o. s in x86_64_linux.Machine -> h in single(empty) -> runs(abi.run_to_return(), s, o) -> (ex h2. h2 in single(empty) && runs(rel(args), union2(s, h), with_ghost(o, h2))) proof
      fix s
      fix h
      fix o
      assume hM: s in x86_64_linux.Machine
      assume hh: h in single(empty)
      assume hr: runs(abi.run_to_return(), s, o)
      have hp := apply(abi.run_univ, hr)
      have hsh := apply(abi.run_shape, hr)
      // abi_function: its precondition, else the given runs
      have pre: !(app(s, "rip") = f && abi.entry_ok(s, args)) -> runs(abi.abi_function(single(empty), f, spec, args), s, o) proof
        assume hn: !(app(s, "rip") = f && abi.entry_ok(s, args))
        show by simp(hp, hn, keep(abi.entry_ok, abi.world.get, abi.world.set, abi.abi_call, abi.abi_restore, abi.abi_set_result, abi.spec_raises, abi.scratch, abi.crash_io_ok))
      qed
      have mc: ld(s) -> runs(abi.abi_function(single(empty), f, spec, args), s, o) proof
        assume hc: ld(s)
        have run: app(s, "rip") = f && abi.entry_ok(s, args) -> runs(abi.abi_function(single(empty), f, spec, args), s, o) proof
          assume hy: app(s, "rip") = f && abi.entry_ok(s, args)
          show := apply(hrun, hA, hM, hc, hy, hy, hr)
        qed
        show by taut(pre, run)
      qed
      have mc2: !ld(s) || runs(abi.abi_function(single(empty), f, spec, args), s, o) by taut(mc)
      show by defs(ex_intro({empty}, simp(hh, hp, hsh, mc2, keep(abi.abi_function, abi.loaded, abi.run_to_return))), with_ghost)
    qed
  qed
  show by defs(main, abi.implements2_at, refines_ghost)
qed
