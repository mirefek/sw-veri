// get_slot_index's stack, from the ABI's entry conditions: its stack slot
// (rsp - 8) and the return address (at rsp) lie in rsp's page, which is
// writable at entry (rsp = 8 mod 16), and the slot is scratch space of the
// callee: the memory after the store is a view of the memory at entry.
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core core/records.core \
//     build/musl_malloc_O0.core proofs/x86.core proofs/get_slot_index_stack.core

// rsp = 8 (mod 16): the 16 bytes from rsp - 8 lie in rsp's page
theorem gsi.stack_pages: all sp. sp in bits(64) -> int_mod(bits_add(64, sp, 8), 16) = 0 -> int_lt(sp, 140737488355328) -> all i. i in omega -> int_lt(i, 8) ->
  int_div(bits_add(64, bits_add(64, sp, 18446744073709551608), bits_of_int(64, i)), 4096) = int_div(sp, 4096) && int_div(bits_add(64, sp, bits_of_int(64, i)), 4096) = int_div(sp, 4096)
proof
  fix sp
  assume h1: sp in bits(64)
  assume h2: int_mod(bits_add(64, sp, 8), 16) = 0
  assume h3: int_lt(sp, 140737488355328)
  fix i
  assume h4: i in omega
  assume h5: int_lt(i, 8)
  have m1: int_mod(int_add(sp, 8), 16) = 0 by simp(h1, h2, h3)
  have m2: int_le(8, int_mod(sp, 4096)) && int_le(int_mod(sp, 4096), 4088) by simp(h1, m1)
  have s8: int_le(8, sp) by simp(h1, m2)
  have e1: bits_add(64, sp, 18446744073709551608) = int_sub(sp, 8) by simp(h1, h3, s8)
  have e2: bits_add(64, int_sub(sp, 8), bits_of_int(64, i)) = int_add(int_sub(sp, 8), i) by simp(h1, h3, h4, h5, s8)
  have e3: bits_add(64, sp, bits_of_int(64, i)) = int_add(sp, i) by simp(h1, h3, h4, h5)
  have d1: int_div(int_add(int_sub(sp, 8), i), 4096) = int_div(sp, 4096) by simp(h1, h3, h4, h5, m2)
  have d2: int_div(int_add(sp, i), 4096) = int_div(sp, 4096) by simp(h1, h3, h4, h5, m2)
  show by simp(e1, e2, e3, d1, d2)
qed

// the stack accesses of get_slot_index (the slot at rsp - 8, the return
// address at rsp): in rsp's page, which is writable at entry
theorem gsi.stack_access: all vm sp. sp in bits(64) -> x86_64_linux.can_access(vm, sp, 1) -> int_mod(bits_add(64, sp, 8), 16) = 0 ->
  (all i. i in omega -> int_lt(i, 8) -> x86_64_linux.can_access(vm, bits_add(64, bits_add(64, sp, 18446744073709551608), bits_of_int(64, i)), 1)) &&
  (all i. i in omega -> int_lt(i, 8) -> x86_64_linux.can_access(vm, bits_add(64, bits_add(64, sp, 18446744073709551608), bits_of_int(64, i)), 0)) &&
  (all i. i in omega -> int_lt(i, 8) -> x86_64_linux.can_access(vm, bits_add(64, sp, bits_of_int(64, i)), 0))
proof
  fix vm
  fix sp
  assume h1: sp in bits(64)
  assume h2: x86_64_linux.can_access(vm, sp, 1)
  assume h3: int_mod(bits_add(64, sp, 8), 16) = 0
  have mp0: int_lt(int_div(sp, 4096), 34359738367) by simp(expand(expand(expand(h2, x86_64_linux.can_access), x86_64_linux.mapped), x86_64_linux.page_of, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))
  have lt: int_lt(sp, 140737488355328) by simp(h1, mp0)
  have pg := mp(mp(mp(all_elim(gsi.stack_pages, {sp}), h1), h3), lt)
  have hr := mp(all_elim(all_elim(x86.write_read, {vm}), {sp}), h2)
  have c1: all i. i in omega -> int_lt(i, 8) -> x86_64_linux.can_access(vm, bits_add(64, bits_add(64, sp, 18446744073709551608), bits_of_int(64, i)), 1) proof
    fix i
    assume h4: i in omega
    assume h5: int_lt(i, 8)
    have pi := mp(mp(all_elim(pg, {i}), h4), h5)
    have p1: int_div(bits_add(64, bits_add(64, sp, 18446744073709551608), bits_of_int(64, i)), 4096) = int_div(sp, 4096) by taut(pi)
    show := mp(mp(all_elim(all_elim(all_elim(all_elim(x86.same_page, {vm}), {bits_add(64, bits_add(64, sp, 18446744073709551608), bits_of_int(64, i))}), {sp}), {1}), h2), p1)
  qed
  have c2: all i. i in omega -> int_lt(i, 8) -> x86_64_linux.can_access(vm, bits_add(64, bits_add(64, sp, 18446744073709551608), bits_of_int(64, i)), 0) proof
    fix i
    assume h4: i in omega
    assume h5: int_lt(i, 8)
    have pi := mp(mp(all_elim(pg, {i}), h4), h5)
    have p1: int_div(bits_add(64, bits_add(64, sp, 18446744073709551608), bits_of_int(64, i)), 4096) = int_div(sp, 4096) by taut(pi)
    show := mp(mp(all_elim(all_elim(all_elim(all_elim(x86.same_page, {vm}), {bits_add(64, bits_add(64, sp, 18446744073709551608), bits_of_int(64, i))}), {sp}), {0}), hr), p1)
  qed
  have c3: all i. i in omega -> int_lt(i, 8) -> x86_64_linux.can_access(vm, bits_add(64, sp, bits_of_int(64, i)), 0) proof
    fix i
    assume h4: i in omega
    assume h5: int_lt(i, 8)
    have pi := mp(mp(all_elim(pg, {i}), h4), h5)
    have p2: int_div(bits_add(64, sp, bits_of_int(64, i)), 4096) = int_div(sp, 4096) by taut(pi)
    show := mp(mp(all_elim(all_elim(all_elim(all_elim(x86.same_page, {vm}), {bits_add(64, sp, bits_of_int(64, i))}), {sp}), {0}), hr), p2)
  qed
  show by taut(c1, c2, c3)
qed

// the 8 bytes below rsp are scratch space of a callee entered with rsp
theorem gsi.slot_scratch: all vm sp a. sp in bits(64) -> abi.stack_page(vm, int_div(sp, 4096)) -> int_mod(bits_add(64, sp, 8), 16) = 0 -> int_lt(sp, 140737488355328) ->
  a in bits(64) -> int_lt(bits_sub(64, a, bits_add(64, sp, 18446744073709551608)), 8) -> abi.scratch(vm, bits_add(64, sp, 8), a)
proof
  fix vm
  fix sp
  fix a
  assume h1: sp in bits(64)
  assume h2: abi.stack_page(vm, int_div(sp, 4096))
  assume h3: int_mod(bits_add(64, sp, 8), 16) = 0
  assume h4: int_lt(sp, 140737488355328)
  assume h5: a in bits(64)
  assume h6: int_lt(bits_sub(64, a, bits_add(64, sp, 18446744073709551608)), 8)
  have m1: int_mod(int_add(sp, 8), 16) = 0 by simp(h1, h3, h4)
  have m2: int_le(8, int_mod(sp, 4096)) && int_le(int_mod(sp, 4096), 4088) by simp(h1, m1)
  have s8: int_le(8, sp) by simp(h1, m2)
  have e1: bits_add(64, sp, 18446744073709551608) = int_sub(sp, 8) by simp(h1, h4, s8)
  have e2: bits_add(64, sp, 8) = int_add(sp, 8) by simp(h1, h4)
  have ar: int_le(int_sub(sp, 8), a) && int_lt(a, sp) by simp(rewrite(e1, h6), h1, h5, s8)
  have d1: int_div(a, 4096) = int_div(sp, 4096) by simp(ar, m2, h1, h5)
  have d2: int_div(int_sub(int_add(sp, 8), 1), 4096) = int_div(sp, 4096) by simp(m2, h1)
  have pg: all p. p in omega -> int_le(int_div(a, 4096), p) -> int_le(p, int_div(int_sub(int_add(sp, 8), 1), 4096)) -> p = int_div(sp, 4096) proof
    fix p
    assume q1: p in omega
    assume q2: int_le(int_div(a, 4096), p)
    assume q3: int_le(p, int_div(int_sub(int_add(sp, 8), 1), 4096))
    show by simp(d1, d2, q1, q2, q3)
  qed
  have spall: all p. p in omega -> int_le(int_div(a, 4096), p) && int_le(p, int_div(int_add(sp, 7), 4096)) -> abi.stack_page(vm, p) || !x86_64_linux.mapped(vm, p) proof
    fix p
    assume q1: p in omega
    assume q2: int_le(int_div(a, 4096), p) && int_le(p, int_div(int_add(sp, 7), 4096))
    have eq: p = int_div(sp, 4096) by simp(pg, e2, q1, q2)
    show by simp(eq, h2, keep(abi.stack_page))
  qed
  show by defs(simp(e2, ar, spall, keep(abi.stack_page)), abi.scratch)
qed

// get_slot_index's store to its slot: the memory after it is a view of the
// memory at entry, and matches it as a callee's result
theorem gsi.store_view: all vm sp x. vm in x86_64_linux.Vm -> sp in bits(64) -> abi.stack_page(vm, int_div(sp, 4096)) -> int_mod(bits_add(64, sp, 8), 16) = 0 -> int_lt(sp, 140737488355328) ->
  abi.scratch_view(fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), bits_add(64, sp, 18446744073709551608), 8, x)), vm, bits_add(64, sp, 8)) &&
  abi.world_matches(vm, vm, fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), bits_add(64, sp, 18446744073709551608), 8, x)), bits_add(64, sp, 8))
proof
  fix vm
  fix sp
  fix x
  assume hv: vm in x86_64_linux.Vm
  assume h1: sp in bits(64)
  assume h2: abi.stack_page(vm, int_div(sp, 4096))
  assume h3: int_mod(bits_add(64, sp, 8), 16) = 0
  assume h4: int_lt(sp, 140737488355328)
  have ht: is_fun(vm) && dom(vm) = insert("pages", insert("bytes", insert("stack_top", insert("stack_limit", insert("brk_start", insert("brk", empty)))))) by simp(expand(hv, x86_64_linux.Vm))
  have hf: is_fun(vm) by taut(ht)
  have bd: "bytes" in dom(vm) by simp(ht)
  have fs := mp(mp(fn_update_same[f := vm, k := "bytes"], hf), bd)
  have out: all a. a in bits(64) -> !abi.scratch(vm, bits_add(64, sp, 8), a) -> app(x86_64_linux.store_le(app(vm, "bytes"), bits_add(64, sp, 18446744073709551608), 8, x), a) = app(app(vm, "bytes"), a) proof
    fix a
    assume ha: a in bits(64)
    assume hn: !abi.scratch(vm, bits_add(64, sp, 8), a)
    have sl := mp(mp(mp(mp(mp(all_elim(all_elim(all_elim(gsi.slot_scratch, {vm}), {sp}), {a}), h1), h2), h3), h4), ha)
    have nl: !int_lt(bits_sub(64, a, bits_add(64, sp, 18446744073709551608)), 8) by taut(sl, hn)
    have ab := mp(app_fn_build[d := bits(64), v := y. ite(int_lt(bits_sub(64, y, bits_add(64, sp, 18446744073709551608)), 8), bits_of_int(8, int_div(x, int_pow(256, bits_sub(64, y, bits_add(64, sp, 18446744073709551608))))), app(app(vm, "bytes"), y)), a := a], ha)
    have itf := mp(ite_f[c := int_lt(bits_sub(64, a, bits_add(64, sp, 18446744073709551608)), 8), a := bits_of_int(8, int_div(x, int_pow(256, bits_sub(64, a, bits_add(64, sp, 18446744073709551608))))), b := app(app(vm, "bytes"), a)], nl)
    show by defs(trans(ab, itf), x86_64_linux.store_le)
  qed
  have sv: abi.scratch_view(fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), bits_add(64, sp, 18446744073709551608), 8, x)), vm, bits_add(64, sp, 8)) by defs(simp(fs, out, keep(abi.scratch, x86_64_linux.store_le)), abi.scratch_view)
  have out2: all a. a in bits(64) -> !abi.scratch(vm, bits_add(64, sp, 8), a) -> app(app(vm, "bytes"), a) = app(x86_64_linux.store_le(app(vm, "bytes"), bits_add(64, sp, 18446744073709551608), 8, x), a) proof
    fix a
    assume ha: a in bits(64)
    assume hn: !abi.scratch(vm, bits_add(64, sp, 8), a)
    show := sym(mp(mp(all_elim(out, {a}), ha), hn))
  qed
  have wm: abi.world_matches(vm, vm, fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), bits_add(64, sp, 18446744073709551608), 8, x)), bits_add(64, sp, 8)) by defs(simp(out2, keep(abi.scratch, x86_64_linux.store_le)), abi.world_matches)
  show by taut(sv, wm)
qed
