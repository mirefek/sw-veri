// The run to return (`abi.run_to_return`) continued from a state s it
// reaches (`abi.run_from`): the run the translation's claim at a point is
// about (`tr.sim`, proofs/translate.core).
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core core/records.core \
//     core/list.core core/loop.core build/c_mallocng_malloc.core proofs/x86.core proofs/abi.core \
//     proofs/abi_restore.core proofs/abi_glue.core proofs/abi_loop.core

// The run of `abi.run_to_return` from m0, continued at s with the outcome o:
// the machine steps from s until it is back at m0's caller (rip the return
// address m0's rsp points to, rsp past it). From s = m0 it is the run itself.
def abi.run_from(m0, s, o) := ex x4. while_rel(pair(s, empty), x5. true, x5 x6. (!(fst(x5).rip = x86_64_linux.le(m0.vm.bytes, m0.gpr[4], 8) && fst(x5).gpr[4] = bits_add(64, m0.gpr[4], 8)) && bind_rel(x86_64_linux.step, fst(x5), x7 x8. x6 = ok(pair(x7, empty), empty), x7 x8. x6 = exc(pair(x7, empty), pair("raise", x8)), x7. x6 = diverge(x7))) || (!!(fst(x5).rip = x86_64_linux.le(m0.vm.bytes, m0.gpr[4], 8) && fst(x5).gpr[4] = bits_add(64, m0.gpr[4], 8)) && x6 = exc(pair(fst(x5), empty), pair("brk", empty))), x5. fn_update(empty, "os.events", fst(x5).os.events), x4) && (((fst(x4) = 0 || (fst(x4) = 1 && fst(out_value(x4)) = "brk")) && o = ok(fst(out_state(x4)), empty)) || ((((fst(x4) = 1 && fst(out_value(x4)) = "ret") && o = ok(fst(out_state(x4)), snd(out_value(x4)))) || ((fst(x4) = 1 && fst(out_value(x4)) = "raise") && o = exc(fst(out_state(x4)), snd(out_value(x4))))) || (fst(x4) = 2 && o = diverge(snd(x4)))))

theorem abi.run_from_entry: all m o. runs(abi.run_to_return(), m, o) -> abi.run_from(m, m, o)
proof
  fix m o
  assume h
  show by defs(simp(expand(h, abi.run_to_return)), abi.run_from)
qed
