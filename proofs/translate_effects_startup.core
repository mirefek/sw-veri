// The startup mode's calls (call0: the thread not checked, the callee's
// world with the caller's objects back, gc.back0): their effects, as
// tr.eff_call's.

// (no argument registers possible: the call undefined)
theorem tr.call0_noregs: all g args w x e. w in univ(1) -> x in univ(1) -> e in univ(1) -> !(ex regs. gc.regs_ok(regs, args)) ->
  runs(gimple.call0(g, args), w, exc(x, e))
proof
  fix g args w x e
  assume hw hx he hn
  have hn2: !(ex x0. x0 in list_type(bits(64)) && (seq_len(x0) = seq_len(args) && (all x1. x1 in omega -> int_lt(x1, seq_len(args)) -> x0[x1] in gimple.in_reg(fst(args[x1]), snd(args[x1]))))) proof
    have c0: (ex x0. x0 in list_type(bits(64)) && (seq_len(x0) = seq_len(args) && (all x1. x1 in omega -> int_lt(x1, seq_len(args)) -> x0[x1] in gimple.in_reg(fst(args[x1]), snd(args[x1]))))) -> false proof
      assume he0
      obtain r0, h1 h23 from he0
      have h2 h3 := h23
      have ex1: ex regs. gc.regs_ok(regs, args) by ex_intro({r0}, conj(h1, h2, h3))
      show by taut(ex1, hn)
    qed
    show by taut(c0)
  qed
  have c: runs(gimple.call0_callee(g, args), w, exc(x, e)) by defs(simp(hw, hx, he, hn2), gimple.call0_callee)
  have b := apply(gc.bind_exc[p := gimple.call0_callee(g, args), k := x3 x4. letin(x4, x5. gc.aft(x3, x5, exc(x, e))), x := x3 x4. exc(x, e) = exc(x3, x4), d := x3. exc(x, e) = diverge(x3)], c, refl({exc(x, e)}))
  show := apply(gc.call0_from, hw, (pair(w, exc(x, e)) in univ(1) by simp(hw, hx, he)), b)
qed

theorem tr.call0_noregs_div: all g args w t. w in univ(1) -> t in univ(1) -> !(ex regs. gc.regs_ok(regs, args)) ->
  runs(gimple.call0(g, args), w, diverge(t))
proof
  fix g args w t
  assume hw ht hn
  have hn2: !(ex x0. x0 in list_type(bits(64)) && (seq_len(x0) = seq_len(args) && (all x1. x1 in omega -> int_lt(x1, seq_len(args)) -> x0[x1] in gimple.in_reg(fst(args[x1]), snd(args[x1]))))) proof
    have c0: (ex x0. x0 in list_type(bits(64)) && (seq_len(x0) = seq_len(args) && (all x1. x1 in omega -> int_lt(x1, seq_len(args)) -> x0[x1] in gimple.in_reg(fst(args[x1]), snd(args[x1]))))) -> false proof
      assume he0
      obtain r0, h1 h23 from he0
      have h2 h3 := h23
      have ex1: ex regs. gc.regs_ok(regs, args) by ex_intro({r0}, conj(h1, h2, h3))
      show by taut(ex1, hn)
    qed
    show by taut(c0)
  qed
  have c: runs(gimple.call0_callee(g, args), w, diverge(t)) by defs(simp(hw, ht, hn2), gimple.call0_callee)
  have b := apply(gc.bind_div[p := gimple.call0_callee(g, args), k := x3 x4. letin(x4, x5. gc.aft(x3, x5, diverge(t))), x := x3 x4. diverge(t) = exc(x3, x4), d := x3. diverge(t) = diverge(x3)], c, refl({diverge(t)}))
  show := apply(gc.call0_from, hw, (pair(w, diverge(t)) in univ(1) by simp(hw, ht)), b)
qed

// (the callee's stack objects replaced: the world as valid)
theorem tr.rv_back0: all w w4 z. tr.returns_valid(w, w4) -> tr.returns_valid(w, fn_update(w4, "objs", z))
proof
  fix w w4 z
  assume h
  have i ev ld cpu bk := expand(h, tr.returns_valid)
  have ld2: all gb gc st. gb in omega -> abi.loaded(w.vm, gb, gc, st) -> abi.loaded(fn_update(w4, "objs", z).vm, gb, gc, st) proof
    fix gb gc st
    assume hb hl
    have l := mp(all_elim(ld, {gb}, {gc}, {st}), hb, hl)
    show by simp(l, keep(abi.loaded))
  qed
  show by defs(simp(i, ev, ld2, cpu, bk, keep(abi.loaded)), tr.returns_valid)
qed

// A startup call of g with at least its n arguments: its returns keep the
// world valid, or it is undefined -- as g's (tr.callee_io)
theorem tr.eff_call0: all g args n w. tr.callee_io(g, n) -> ord_le(n, seq_len(args)) -> tr.eff(w, o. runs(gimple.call0(g, args), w, o))
proof
  fix g args n w
  assume hio hn
  let C := gimple.call0(g, args)
  let U := tr.undef(o. runs(C, w, o))
  have toE: U -> tr.eff(w, o. runs(C, w, o)) proof
    assume hu
    show by defs(taut(hu), tr.eff)
  qed
  have nu: !(w in univ(1)) -> tr.eff(w, o. runs(C, w, o)) proof
    assume hn0
    have g0: all w2 v. runs(C, w, ok(w2, v)) -> tr.returns_valid(w, w2) proof
      fix w2 v
      assume h
      have pu: pair(w, ok(w2, v)) in univ(1) by taut(unsel(expand(h, runs, gimple.call0, mkprog)))
      have f: false by simp(pu, hn0)
      show by taut(f)
    qed
    show by defs(taut(g0), tr.eff)
  qed
  have yu: w in univ(1) -> tr.eff(w, o. runs(C, w, o)) proof
    assume hw
    have u0: !(ex regs. gc.regs_ok(regs, args)) -> tr.eff(w, o. runs(C, w, o)) proof
      assume hr
      have ex: all x e. x in univ(1) -> e in univ(1) -> runs(C, w, exc(x, e)) proof
        fix x e
        assume hx he
        show := apply(tr.call0_noregs, {g}, {args}, {w}, {x}, {e}, hw, hx, he, hr)
      qed
      have dv: all t. t in univ(1) -> runs(C, w, diverge(t)) proof
        fix t
        assume ht
        show := apply(tr.call0_noregs_div, {g}, {args}, {w}, {t}, hw, ht, hr)
      qed
      have hu: U by defs(taut(ex, dv), tr.undef)
      show := mp(toE, hu)
    qed
    have u2: (ex regs. gc.regs_ok(regs, args) && tr.may_raise(g, regs, w)) -> tr.eff(w, o. runs(C, w, o)) proof
      assume hr
      obtain regs, r1 r2 r3 hm from hr
      have rg: gc.regs_ok(regs, args) := conj(r1, r2, r3)
      have hm2 := expand(expand(hm, tr.may_raise), tr.undef)
      have mx: all x e. x in univ(1) -> e in univ(1) -> runs(g[regs], w, exc(x, e)) by taut(hm2)
      have md: all t. t in univ(1) -> runs(g[regs], w, diverge(t)) by taut(hm2)
      have ex: all x e. x in univ(1) -> e in univ(1) -> runs(C, w, exc(x, e)) proof
        fix x e
        assume hx he
        have c := mp(all_elim(mx, {x}, {e}), hx, he)
        show := apply(gc.call0_exc, {g}, {args}, {w}, {regs}, {x}, {e}, hw, hx, he, rg, c)
      qed
      have dv: all t. t in univ(1) -> runs(C, w, diverge(t)) proof
        fix t
        assume ht
        have c := mp(all_elim(md, {t}), ht)
        show := apply(gc.call0_div, {g}, {args}, {w}, {regs}, {t}, hw, ht, rg, c)
      qed
      have hu: U by defs(taut(ex, dv), tr.undef)
      show := mp(toE, hu)
    qed
    have v: (ex regs. gc.regs_ok(regs, args)) -> !(ex regs. gc.regs_ok(regs, args) && tr.may_raise(g, regs, w)) -> tr.eff(w, o. runs(C, w, o)) proof
      assume hr hnm
      have g0: all w2 v. runs(C, w, ok(w2, v)) -> tr.returns_valid(w, w2) proof
        fix w2 v
        assume h
        have cs := apply(gc.call0_cases, h)
        have c0: ok(w2, v) = exc(w, exc_val("stack_overflow", empty)) -> tr.returns_valid(w, w2) proof
          assume e
          have f: false by simp(e)
          show by taut(f)
        qed
        have c1: gc.cc0(g, args, w, ok(w2, v)) -> tr.returns_valid(w, w2) proof
          assume hc
          obtain o1, h1 hk from expand(hc, bind_rel)
          have ci := apply(gc.cc0_inv, h1, hr)
          obtain regs o2, r1 r2 r3 ho2 hcase from ci
          have rg: gc.regs_ok(regs, args) := conj(r1, r2, r3)
          have rl := r2
          have k1: (ex s1 v1. o1 = ok(s1, v1) && letin(v1, x5. gc.aft(s1, x5, ok(w2, v)))) -> tr.returns_valid(w, w2) proof
            assume e
            obtain s1 v1, eo1 ha from e
            have af := apply(gc.aft_inv, expand(ha, letin))
            have ws: w2 = s1 by simp(af)
            have q1: (ex w4 r. o2 = ok(w4, r) && o1 = ok(gc.back0(w4, w), pair(fst(r), snd(r)))) -> tr.returns_valid(w, w2) proof
              assume e2
              obtain w4 r, eo2 eo1b from e2
              have sb: s1 = gc.back0(w4, w) by simp(eo1, eo1b)
              have hg := rewrite(eo2, ho2)
              have io := mp(all_elim(expand(hio, tr.callee_io), {regs}, {w}, {w4}, {r}), (ord_le(n, seq_len(regs)) by simp(rl, hn)), hg)
              have nm: !tr.may_raise(g, regs, w) proof
                have c: tr.may_raise(g, regs, w) -> false proof
                  assume hm
                  have ex1: ex regs. gc.regs_ok(regs, args) && tr.may_raise(g, regs, w) by ex_intro({regs}, conj(rg, hm))
                  show by taut(ex1, hnm)
                qed
                show by taut(c)
              qed
              have rv: tr.returns_valid(w, w4) by taut(io, nm)
              have rb := apply(tr.rv_back0, {w}, {w4}, {fn_update(w4.objs, "live", w.objs.live)}, rv)
              show by simp(ws, sb, rb, keep(tr.returns_valid))
            qed
            have q2: (ex x e. o2 = exc(x, e) && o1 = exc(x, e)) -> tr.returns_valid(w, w2) proof
              assume e2
              obtain x e, _ eo1b from e2
              have f: false by simp(eo1, eo1b)
              show by taut(f)
            qed
            have q3: (ex t. o2 = diverge(t) && o1 = diverge(t)) -> tr.returns_valid(w, w2) proof
              assume e2
              obtain t, _ eo1b from e2
              have f: false by simp(eo1, eo1b)
              show by taut(f)
            qed
            show by taut(hcase, q1, q2, q3)
          qed
          have k2: (ex s1 e1. o1 = exc(s1, e1) && ok(w2, v) = exc(s1, e1)) -> tr.returns_valid(w, w2) proof
            assume e
            obtain s1 e1, _ eo from e
            have f: false by simp(eo)
            show by taut(f)
          qed
          have k3: (ex t. o1 = diverge(t) && ok(w2, v) = diverge(t)) -> tr.returns_valid(w, w2) proof
            assume e
            obtain t, _ eo from e
            have f: false by simp(eo)
            show by taut(f)
          qed
          show by taut(hk, k1, k2, k3)
        qed
        show by taut(cs, c0, c1)
      qed
      show by defs(taut(g0), tr.eff)
    qed
    show by taut(u0, u2, v)
  qed
  show by taut(nu, yu)
qed

// ... call1_0 (the result's rax only)
theorem tr.eff_call1_0: all g args n w. tr.callee_io(g, n) -> ord_le(n, seq_len(args)) -> tr.eff(w, o. runs(gimple.call1_0(g, args), w, o))
proof
  fix g args n w
  assume hio hn
  have c := mp(all_elim(tr.eff_call0, {g}, {args}, {n}, {w}), hio, hn)
  have b := mp(all_elim(tr.eff_bind_ret[p := gimple.call0(g, args), f := v. fst(v)], {w}), c)
  show by defs(apply(tr.eff_prog, {w}, b), gimple.call1_0, letin)
qed

// ... of a callee with stack arguments, called with its n (tr.callee_io_s)
theorem tr.eff_call0_sn: all g args n w. tr.callee_io_s(g, n) -> seq_len(args) = n -> tr.eff(w, o. runs(gimple.call0(g, args), w, o))
proof
  fix g args n w
  assume hio hn
  let C := gimple.call0(g, args)
  let U := tr.undef(o. runs(C, w, o))
  have toE: U -> tr.eff(w, o. runs(C, w, o)) proof
    assume hu
    show by defs(taut(hu), tr.eff)
  qed
  have nu: !(w in univ(1)) -> tr.eff(w, o. runs(C, w, o)) proof
    assume hn0
    have g0: all w2 v. runs(C, w, ok(w2, v)) -> tr.returns_valid(w, w2) proof
      fix w2 v
      assume h
      have pu: pair(w, ok(w2, v)) in univ(1) by taut(unsel(expand(h, runs, gimple.call0, mkprog)))
      have f: false by simp(pu, hn0)
      show by taut(f)
    qed
    show by defs(taut(g0), tr.eff)
  qed
  have yu: w in univ(1) -> tr.eff(w, o. runs(C, w, o)) proof
    assume hw
    have u0: !(ex regs. gc.regs_ok(regs, args)) -> tr.eff(w, o. runs(C, w, o)) proof
      assume hr
      have ex: all x e. x in univ(1) -> e in univ(1) -> runs(C, w, exc(x, e)) proof
        fix x e
        assume hx he
        show := apply(tr.call0_noregs, {g}, {args}, {w}, {x}, {e}, hw, hx, he, hr)
      qed
      have dv: all t. t in univ(1) -> runs(C, w, diverge(t)) proof
        fix t
        assume ht
        show := apply(tr.call0_noregs_div, {g}, {args}, {w}, {t}, hw, ht, hr)
      qed
      have hu: U by defs(taut(ex, dv), tr.undef)
      show := mp(toE, hu)
    qed
    have u2: (ex regs. gc.regs_ok(regs, args) && tr.may_raise(g, regs, w)) -> tr.eff(w, o. runs(C, w, o)) proof
      assume hr
      obtain regs, r1 r2 r3 hm from hr
      have rg: gc.regs_ok(regs, args) := conj(r1, r2, r3)
      have hm2 := expand(expand(hm, tr.may_raise), tr.undef)
      have mx: all x e. x in univ(1) -> e in univ(1) -> runs(g[regs], w, exc(x, e)) by taut(hm2)
      have md: all t. t in univ(1) -> runs(g[regs], w, diverge(t)) by taut(hm2)
      have ex: all x e. x in univ(1) -> e in univ(1) -> runs(C, w, exc(x, e)) proof
        fix x e
        assume hx he
        have c := mp(all_elim(mx, {x}, {e}), hx, he)
        show := apply(gc.call0_exc, {g}, {args}, {w}, {regs}, {x}, {e}, hw, hx, he, rg, c)
      qed
      have dv: all t. t in univ(1) -> runs(C, w, diverge(t)) proof
        fix t
        assume ht
        have c := mp(all_elim(md, {t}), ht)
        show := apply(gc.call0_div, {g}, {args}, {w}, {regs}, {t}, hw, ht, rg, c)
      qed
      have hu: U by defs(taut(ex, dv), tr.undef)
      show := mp(toE, hu)
    qed
    have v: (ex regs. gc.regs_ok(regs, args)) -> !(ex regs. gc.regs_ok(regs, args) && tr.may_raise(g, regs, w)) -> tr.eff(w, o. runs(C, w, o)) proof
      assume hr hnm
      have g0: all w2 v. runs(C, w, ok(w2, v)) -> tr.returns_valid(w, w2) proof
        fix w2 v
        assume h
        have cs := apply(gc.call0_cases, h)
        have c0: ok(w2, v) = exc(w, exc_val("stack_overflow", empty)) -> tr.returns_valid(w, w2) proof
          assume e
          have f: false by simp(e)
          show by taut(f)
        qed
        have c1: gc.cc0(g, args, w, ok(w2, v)) -> tr.returns_valid(w, w2) proof
          assume hc
          obtain o1, h1 hk from expand(hc, bind_rel)
          have ci := apply(gc.cc0_inv, h1, hr)
          obtain regs o2, r1 r2 r3 ho2 hcase from ci
          have rg: gc.regs_ok(regs, args) := conj(r1, r2, r3)
          have rl := r2
          have k1: (ex s1 v1. o1 = ok(s1, v1) && letin(v1, x5. gc.aft(s1, x5, ok(w2, v)))) -> tr.returns_valid(w, w2) proof
            assume e
            obtain s1 v1, eo1 ha from e
            have af := apply(gc.aft_inv, expand(ha, letin))
            have ws: w2 = s1 by simp(af)
            have q1: (ex w4 r. o2 = ok(w4, r) && o1 = ok(gc.back0(w4, w), pair(fst(r), snd(r)))) -> tr.returns_valid(w, w2) proof
              assume e2
              obtain w4 r, eo2 eo1b from e2
              have sb: s1 = gc.back0(w4, w) by simp(eo1, eo1b)
              have hg := rewrite(eo2, ho2)
              have io := mp(all_elim(expand(hio, tr.callee_io_s), {regs}, {w}, {w4}, {r}), r1, (seq_len(regs) = n by simp(rl, hn)), hg)
              have nm: !tr.may_raise(g, regs, w) proof
                have c: tr.may_raise(g, regs, w) -> false proof
                  assume hm
                  have ex1: ex regs. gc.regs_ok(regs, args) && tr.may_raise(g, regs, w) by ex_intro({regs}, conj(rg, hm))
                  show by taut(ex1, hnm)
                qed
                show by taut(c)
              qed
              have rv: tr.returns_valid(w, w4) by taut(io, nm)
              have rb := apply(tr.rv_back0, {w}, {w4}, {fn_update(w4.objs, "live", w.objs.live)}, rv)
              show by simp(ws, sb, rb, keep(tr.returns_valid))
            qed
            have q2: (ex x e. o2 = exc(x, e) && o1 = exc(x, e)) -> tr.returns_valid(w, w2) proof
              assume e2
              obtain x e, _ eo1b from e2
              have f: false by simp(eo1, eo1b)
              show by taut(f)
            qed
            have q3: (ex t. o2 = diverge(t) && o1 = diverge(t)) -> tr.returns_valid(w, w2) proof
              assume e2
              obtain t, _ eo1b from e2
              have f: false by simp(eo1, eo1b)
              show by taut(f)
            qed
            show by taut(hcase, q1, q2, q3)
          qed
          have k2: (ex s1 e1. o1 = exc(s1, e1) && ok(w2, v) = exc(s1, e1)) -> tr.returns_valid(w, w2) proof
            assume e
            obtain s1 e1, _ eo from e
            have f: false by simp(eo)
            show by taut(f)
          qed
          have k3: (ex t. o1 = diverge(t) && ok(w2, v) = diverge(t)) -> tr.returns_valid(w, w2) proof
            assume e
            obtain t, _ eo from e
            have f: false by simp(eo)
            show by taut(f)
          qed
          show by taut(hk, k1, k2, k3)
        qed
        show by taut(cs, c0, c1)
      qed
      show by defs(taut(g0), tr.eff)
    qed
    show by taut(u0, u2, v)
  qed
  show by taut(nu, yu)
qed

theorem tr.eff_call0_s: all g args n w. tr.callee_io_s(g, n) -> seq_len(args) = n -> tr.eff(w, o. runs(gimple.call0_s(g, args), w, o))
proof
  fix g args n w
  assume hio hn
  have c := mp(all_elim(tr.eff_call0_sn, {g}, {args}, {n}, {w}), hio, hn)
  show := rewrite(sym(all_elim(gc.call0_s_eq, {g}, {args})), c)
qed

theorem tr.eff_call1_0_s: all g args n w. tr.callee_io_s(g, n) -> seq_len(args) = n -> tr.eff(w, o. runs(gimple.call1_0_s(g, args), w, o))
proof
  fix g args n w
  assume hio hn
  have c := mp(all_elim(tr.eff_call0_sn, {g}, {args}, {n}, {w}), hio, hn)
  have b := mp(all_elim(tr.eff_bind_ret[p := gimple.call0(g, args), f := v. fst(v)], {w}), c)
  have c1: tr.eff(w, o. runs(gimple.call1_0(g, args), w, o)) by defs(apply(tr.eff_prog, {w}, b), gimple.call1_0, letin)
  show := rewrite(sym(all_elim(gc.call1_0_s_eq, {g}, {args})), c1)
qed

// (with the caller's stack objects named: the call itself)
theorem tr.eff_call0_objs: all objs g args n w. tr.callee_io(g, n) -> ord_le(n, seq_len(args)) -> tr.eff(w, o. runs(gimple.call0_objs(objs, g, args), w, o))
proof
  fix objs g args n w
  assume hio hn
  have c := mp(all_elim(tr.eff_call0, {g}, {args}, {n}, {w}), hio, hn)
  have b := mp(all_elim(tr.eff_bind_ret[p := gimple.call0(g, args), f := v. v], {w}), c)
  show by defs(apply(tr.eff_prog, {w}, b), gimple.call0_objs)
qed

theorem tr.eff_call1_0_objs: all objs g args n w. tr.callee_io(g, n) -> ord_le(n, seq_len(args)) -> tr.eff(w, o. runs(gimple.call1_0_objs(objs, g, args), w, o))
proof
  fix objs g args n w
  assume hio hn
  have c := mp(all_elim(tr.eff_call0_objs, {objs}, {g}, {args}, {n}, {w}), hio, hn)
  have b := mp(all_elim(tr.eff_bind_ret[p := gimple.call0_objs(objs, g, args), f := v. fst(v)], {w}), c)
  show by defs(apply(tr.eff_prog, {w}, b), gimple.call1_0_objs, letin)
qed

// (a loaded word: a word -- a value bound by ld64, its type in hand)
theorem tr.ld64_typed: all p off w w2 v. runs(gimple.ld64(p, off), w, ok(w2, v)) -> v in bits(64)
proof
  fix p off w w2 v
  assume h
  show by simp(h, keep(gimple.mem, gimple.bytes_at))
qed

// (GIMPLE's `undefined`, `true`: every outcome allowed)
theorem tr.seff_true: all w. tr.seff(w, x. true)
proof
  fix w
  have ex: all y e. y in univ(1) -> e in univ(1) -> (ex l. true) proof
    fix y e
    assume _ _
    show by ex_intro({empty}, taut())
  qed
  have dv: all t. t in univ(1) -> true proof
    fix t
    assume _
    show by taut()
  qed
  have u: tr.sundef(x. true) by defs(taut(ex, dv), tr.sundef)
  show by defs(taut(u), tr.seff)
qed

theorem tr.eff_true: all w. tr.eff(w, o. true)
proof
  fix w
  have ex: all x e. x in univ(1) -> e in univ(1) -> true proof
    fix x e
    assume _ _
    show by taut()
  qed
  have dv: all t. t in univ(1) -> true proof
    fix t
    assume _
    show by taut()
  qed
  have u: tr.undef(o. true) by defs(taut(ex, dv), tr.undef)
  show by defs(taut(u), tr.eff)
qed

// (an `if c` whose other branch is `undefined`, `true` -- as elaborated,
// (c && R) || !c: R's where c holds, every outcome where not)
theorem tr.seff_if_undef(c, x. r): all w. (c -> tr.seff(w, x. r(x))) -> tr.seff(w, x. (c && r(x)) || !c)
proof
  fix w
  assume h
  have t1: c -> tr.seff(w, x. (c && r(x)) || !c) proof
    assume hc
    have s := expand(mp(h, hc), tr.seff, tr.sundef)
    show by defs(simp(s, hc), tr.seff, tr.sundef)
  qed
  have t2: !c -> tr.seff(w, x. (c && r(x)) || !c) proof
    assume hn
    have ex: all y e. y in univ(1) -> e in univ(1) -> (ex l. (c && r(exc(pair(y, l), pair("raise", e)))) || !c) proof
      fix y e
      assume _ _
      show by ex_intro({empty}, taut(hn))
    qed
    have dv: all t. t in univ(1) -> (c && r(diverge(t))) || !c proof
      fix t
      assume _
      show by taut(hn)
    qed
    have u: tr.sundef(x. (c && r(x)) || !c) by defs(taut(ex, dv), tr.sundef)
    show by defs(taut(u), tr.seff)
  qed
  show by taut(t1, t2)
qed

theorem tr.eff_if_undef(c, o. r): all w. (c -> tr.eff(w, o. r(o))) -> tr.eff(w, o. (c && r(o)) || !c)
proof
  fix w
  assume h
  have t1: c -> tr.eff(w, o. (c && r(o)) || !c) proof
    assume hc
    have s := expand(mp(h, hc), tr.eff, tr.undef)
    show by defs(simp(s, hc), tr.eff, tr.undef)
  qed
  have t2: !c -> tr.eff(w, o. (c && r(o)) || !c) proof
    assume hn
    have ex: all x e. x in univ(1) -> e in univ(1) -> (c && r(exc(x, e))) || !c proof
      fix x e
      assume _ _
      show by taut(hn)
    qed
    have dv: all t. t in univ(1) -> (c && r(diverge(t))) || !c proof
      fix t
      assume _
      show by taut(hn)
    qed
    have u: tr.undef(o. (c && r(o)) || !c) by defs(taut(ex, dv), tr.undef)
    show by defs(taut(u), tr.eff)
  qed
  show by taut(t1, t2)
qed
