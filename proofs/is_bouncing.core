// is_bouncing (musl mallocng, `sc - 7 < 32 && ctx.bounces[sc - 7] >= 100`
// at -O0): C1 under the ABI. The argument goes to a stack slot (4 bytes at
// rsp - 4) and is read back; the counter is a byte of the static
// __malloc_context, read on the memory with the slot written (the spec's
// view). Three machine paths (out of range; in range, below 100 or not),
// summarized by abi.returns.
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core core/records.core \
//     core/list.core core/loop.core build/c_mallocng_malloc.core proofs/x86.core proofs/x86_code.core \
//     build/leaf_steps.core proofs/abi.core proofs/abi_restore.core proofs/abi_glue.core proofs/gimple.core \
//     proofs/abi_stack.core proofs/is_bouncing.core

abbrev ib.spec := c_src_malloc_mallocng_malloc.is_bouncing_fun()
// sc - 7, as 32 bits; the counter's address (ctx.bounces at ctx + 880)
abbrev ib.d(sc) := bits_add(32, sc, 4294967289)
abbrev ib.addr(sc) := int_add(4228208, ib.d(sc))
abbrev ib.byte(v, sc) := bits_of_int(8, gimple.bytes_at(v, ib.addr(sc), 1))
abbrev ib.res(v, sc) := ite(int_le(ib.d(sc), 31) && int_lt(99, ib.byte(v, sc)), 1, 0)
abbrev ib.defined(v, sc) := int_le(ib.d(sc), 31) -> gimple.usable(v, ib.addr(sc), 1, false)
abbrev ib.arg(args) := bits_of_int(32, app(args, 0))
abbrev ib.ok(v, args) := ord_le(1, seq_len(args)) && ib.defined(v, ib.arg(args))

// the spec's branches (spec_run: out of range; the counter's byte usable,
// above 99 or not; not usable)
theorem ib.proc_ok: all w sc. w in univ(1) -> sc in bits(32) -> ib.defined(app(w, "vm"), sc) ->
  runs(c_src_malloc_mallocng_malloc.is_bouncing(sc), w, ok(w, ib.res(app(w, "vm"), sc)))
proof
  fix w
  fix sc
  assume hw: w in univ(1)
  assume hx: sc in bits(32)
  assume hu: ib.defined(app(w, "vm"), sc)
  have r := spec_run({c_src_malloc_mallocng_malloc.is_bouncing(sc)}, {w}, hw, hx, g.padd_ok, g.padd_ub, g.ld8_ok, g.ld8_ub)
  show by simp(r, hu, hx, keep(c_src_malloc_mallocng_malloc.is_bouncing))
qed

theorem ib.proc_raises: all w sc e. w in univ(1) -> e in univ(1) -> sc in bits(32) -> !ib.defined(app(w, "vm"), sc) ->
  runs(c_src_malloc_mallocng_malloc.is_bouncing(sc), w, exc(w, e))
proof
  fix w
  fix sc
  fix e
  assume hw: w in univ(1)
  assume he: e in univ(1)
  assume hx: sc in bits(32)
  assume hn: !ib.defined(app(w, "vm"), sc)
  have r := spec_run({c_src_malloc_mallocng_malloc.is_bouncing(sc)}, {w}, hw, hx, g.padd_ok, g.padd_ub, g.ld8_ok, g.ld8_ub)
  show by simp(r, hn, hx, hw, he, keep(c_src_malloc_mallocng_malloc.is_bouncing))
qed

theorem ib.fun_ok: all w args y. w in univ(1) -> args in abi.ARGS -> y in bits(64) -> ib.ok(app(w, "vm"), args) ->
  runs(app(ib.spec, args), w, ok(w, pair(ib.res(app(w, "vm"), ib.arg(args)), y)))
proof
  fix w
  fix args
  fix y
  assume hw: w in univ(1)
  assume hA: args in abi.ARGS
  assume hy: y in bits(64)
  assume hu: ib.ok(app(w, "vm"), args)
  have r := spec_run({app(ib.spec, args)}, {w}, hw, hA, ib.proc_ok, ib.proc_raises, g.result_ok)
  show by simp(r, hu, hy, keep(c_src_malloc_mallocng_malloc.is_bouncing_fun))
qed

theorem ib.fun_raises: all w args e. w in univ(1) -> e in univ(1) -> args in abi.ARGS -> !ib.ok(app(w, "vm"), args) ->
  runs(app(ib.spec, args), w, exc(w, e))
proof
  fix w
  fix args
  fix e
  assume hw: w in univ(1)
  assume he: e in univ(1)
  assume hA: args in abi.ARGS
  assume hn: !ib.ok(app(w, "vm"), args)
  have r := spec_run({app(ib.spec, args)}, {w}, hw, hA, ib.proc_ok, ib.proc_raises, g.result_ok)
  show by simp(r, hn, hw, he, keep(c_src_malloc_mallocng_malloc.is_bouncing_fun))
qed

// the machine, from entry to return (three paths: out of range; the
// counter below 100 or not), summarized
abbrev ibm.rsp(m) := app(app(m, "gpr"), 4)
abbrev ibm.x(m) := bits_slice(app(app(m, "gpr"), 7), 31, 0)
abbrev ibm.slot(m) := bits_add(64, ibm.rsp(m), 18446744073709551612)
abbrev ibm.vm1(m) := fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), ibm.slot(m), 4, ibm.x(m)))
abbrev ibm.d(m) := bits_add(32, ibm.x(m), 4294967289)
abbrev ibm.addr(m) := bits_add(64, bits_sext(32, 64, ibm.d(m)), 4228208)
abbrev ibm.res(m) := ite(int_le(ibm.d(m), 31) && int_lt(99, x86_64_linux.le(app(ibm.vm1(m), "bytes"), ibm.addr(m), 1)), 1, 0)

theorem is_bouncing.run(m, o): m in x86_64_linux.Machine -> m in univ(1) -> abi.code_at(app(m, "vm"), 4203843, is_bouncing.code()) -> app(m, "rip") = 4203843 ->
  (all i. i in omega -> int_lt(i, 4) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, ibm.slot(m), bits_of_int(64, i)), 1)) ->
  (all i. i in omega -> int_lt(i, 4) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, ibm.slot(m), bits_of_int(64, i)), 0)) ->
  (int_le(ibm.d(m), 31) -> (all i. i in omega -> int_lt(i, 1) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, ibm.addr(m), bits_of_int(64, i)), 0))) ->
  (all i. i in omega -> int_lt(i, 8) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, ibm.rsp(m), bits_of_int(64, i)), 0)) ->
  runs(abi.run_to_return(), m, o) ->
  ex m1. o = ok(m1, empty) && abi.returns(m, m1, ibm.vm1(m), ibm.res(m))
proof
  assume hM: m in x86_64_linux.Machine
  assume hu: m in univ(1)
  assume hc: abi.code_at(app(m, "vm"), 4203843, is_bouncing.code())
  assume hr: app(m, "rip") = 4203843
  assume aw: all i. i in omega -> int_lt(i, 4) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, ibm.slot(m), bits_of_int(64, i)), 1)
  assume ar: all i. i in omega -> int_lt(i, 4) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, ibm.slot(m), bits_of_int(64, i)), 0)
  assume at: int_le(ibm.d(m), 31) -> (all i. i in omega -> int_lt(i, 1) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, ibm.addr(m), bits_of_int(64, i)), 0))
  assume a7: all i. i in omega -> int_lt(i, 8) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, ibm.rsp(m), bits_of_int(64, i)), 0)
  assume h: runs(abi.run_to_return(), m, o)
  have hsp: ibm.rsp(m) in bits(64) by simp(hM)
  have hdi: app(app(m, "gpr"), 7) in bits(64) by simp(hM)
  have hv: app(m, "vm") in x86_64_linux.Vm by simp(hM)
  have r := symex(h, hM, hc, hr, hsp, hdi, aw, ar, at, a7, x86.cond_eval, is_bouncing.ok_402543, is_bouncing.ok_402547, is_bouncing.ok_40254b, is_bouncing.ok_40254e, is_bouncing.ok_402551, is_bouncing.ok_402553, is_bouncing.ok_402557, is_bouncing.ok_40255a, is_bouncing.ok_40255c, is_bouncing.ok_402563, is_bouncing.ok_402567, is_bouncing.ok_402569, is_bouncing.ok_40256b, is_bouncing.ok_402570, is_bouncing.ok_402571, is_bouncing.ok_402576)
  show by simp(r, hM, hu, hv, g.store_univ, x86.store_typed, hsp, hdi)
qed

// C1: the machine code implements the C function's spec, in any program
theorem ib.implements: all statics. abi.implements2_at(single(empty), 4203843, ib.spec, 4203843, is_bouncing.code(), statics)
proof
  fix statics
  have runs: all args s o. args in abi.ARGS -> s in x86_64_linux.Machine -> abi.loaded(app(s, "vm"), 4203843, is_bouncing.code(), statics) -> app(s, "rip") = 4203843 -> abi.entry_ok(s, args) ->
      runs(abi.run_to_return(), s, o) -> runs(abi.abi_function(single(empty), 4203843, ib.spec, args), s, o) proof
    fix args
    fix s
    fix o
    assume hA: args in abi.ARGS
    assume hM: s in x86_64_linux.Machine
    assume hl: abi.loaded(app(s, "vm"), 4203843, is_bouncing.code(), statics)
    assume hrip: app(s, "rip") = 4203843
    assume he: abi.entry_ok(s, args)
    assume hr: runs(abi.run_to_return(), s, o)
    have hc: abi.code_at(app(s, "vm"), 4203843, is_bouncing.code()) by taut(expand(hl, abi.loaded))
    have hp := apply(abi.run_univ, hr)
    have su: s in univ(1) by simp(hp)
    have hsv: app(s, "vm") in x86_64_linux.Vm by simp(hM)
    have hsp: ibm.rsp(s) in bits(64) by simp(hM)
    have hdi: app(app(s, "gpr"), 7) in bits(64) by simp(hM)
    have ent := apply(abi.entry_stack, hM, he)
    // the slot: scratch space, the memory after the store a view of the memory at entry
    have sv := apply(abi.slot_view, {app(s, "vm")}, {ibm.rsp(s)}, {18446744073709551612}, {4}, {ibm.x(s)}, hsv, hsp, ent, ent, ent, simp(), simp(), simp())
    have v1u: ibm.vm1(s) in univ(1) by simp(su, hsv, g.store_univ)
    have v1: ibm.vm1(s) in x86_64_linux.Vm by simp(hM, v1u, x86.store_typed)
    let w := abi.view(ibm.vm1(s), s)
    have wu: w in univ(1) by simp(su, v1u)
    have eu: empty in univ(1) by simp()
    // no argument, or the counter not readable: the spec raises
    have ub: !ib.ok(ibm.vm1(s), args) -> runs(abi.abi_function(single(empty), 4203843, ib.spec, args), s, o) proof
      assume hn: !ib.ok(ibm.vm1(s), args)
      have fr := apply(ib.fun_raises, wu, eu, hA, simp(hn))
      show := apply(abi.ub_case, {4203843}, {ib.spec}, {args}, {s}, {o}, {ibm.vm1(s)}, {empty}, hM, v1, v1u, sv, sv, eu, fr, hp, simp(apply(abi.run_shape, hr)))
    qed
    // defined: the run returns normally, with the spec's result
    have ret: ib.ok(ibm.vm1(s), args) -> runs(abi.abi_function(single(empty), 4203843, ib.spec, args), s, o) proof
      assume hd: ib.ok(ibm.vm1(s), args)
      have pa := apply(abi.arg_passed, hA, he, simp(hd))
      // the argument the machine reads back is the spec's
      have sl: bits_slice(app(args, 0), 31, 0) = bits_of_int(32, app(args, 0)) by defs(simp(), bits_slice, bits_of_int)
      have ex: ibm.x(s) = ib.arg(args) by simp(pa, sl)
      have xb: ib.arg(args) in bits(32) by simp()
      have db: ib.d(ib.arg(args)) in bits(32) by simp(xb)
      // in range: the counter's address, as the machine computes it
      have ea: int_le(ib.d(ib.arg(args)), 31) -> ibm.addr(s) = ib.addr(ib.arg(args)) proof
        assume hl: int_le(ib.d(ib.arg(args)), 31)
        have se: bits_sext(32, 64, ib.d(ib.arg(args))) = ib.d(ib.arg(args)) by defs(simp(db, hl), bits_sext, sint)
        show by simp(pa, ex,se, db, hl)
      qed
      // the counter can be read (when in range)
      have at: int_le(ibm.d(s), 31) -> (all i. i in omega -> int_lt(i, 1) -> x86_64_linux.can_access(app(s, "vm"), bits_add(64, ibm.addr(s), bits_of_int(64, i)), 0)) proof
        assume hl0: int_le(ibm.d(s), 31)
        have hl: int_le(ib.d(ib.arg(args)), 31) by simp(rewrite(pa, hl0))
        fix i
        assume i1: i in omega
        assume i2: int_lt(i, 1)
        have r := apply(g.usable_read, {ibm.vm1(s)}, {app(s, "vm")}, {ib.addr(ib.arg(args))}, {1}, {i}, simp(hd, hl), simp(), simp(db), i1, i2)
        have e2: bits_add(64, ibm.addr(s), bits_of_int(64, i)) = bits_of_int(64, int_add(ib.addr(ib.arg(args)), i)) by simp(mp(ea, hl), db, hl, i1, i2)
        show := rewrite(sym(e2), r)
      qed
      have sa := apply(abi.slot_access, {app(s, "vm")}, {ibm.rsp(s)}, {18446744073709551612}, {4}, hsp, ent, ent, simp(), simp(), simp())
      have ra := apply(abi.ret_access, {app(s, "vm")}, {ibm.rsp(s)}, hsp, ent, ent)
      have run := apply(is_bouncing.run, hM, su, hc, hrip, sa, sa, at, ra, hr)
      obtain m1, hm1 from run
      have eo: o = ok(m1, empty) by taut(hm1)
      have hp2 := rewrite(eo, hp)
      have m1M: m1 in x86_64_linux.Machine by taut(hm1)
      // the machine's result is the spec's
      have c1: !int_le(ib.d(ib.arg(args)), 31) -> ibm.res(s) = ib.res(ibm.vm1(s), ib.arg(args)) proof
        assume hl: !int_le(ib.d(ib.arg(args)), 31)
        show by simp(pa, ex,hl)
      qed
      have c2: int_le(ib.d(ib.arg(args)), 31) -> ibm.res(s) = ib.res(ibm.vm1(s), ib.arg(args)) proof
        assume hl: int_le(ib.d(ib.arg(args)), 31)
        have se: bits_sext(32, 64, ib.d(ib.arg(args))) = ib.d(ib.arg(args)) by defs(simp(db, hl), bits_sext, sint)
        show by defs(simp(pa, ex,hl, se, db), gimple.bytes_at, x86_64_linux.le)
      qed
      have er: ibm.res(s) = ib.res(ibm.vm1(s), ib.arg(args)) by taut(c1, c2)
      have e0: ib.res(app(w, "vm"), ib.arg(args)) = app(app(m1, "gpr"), 0) by simp(er, hm1)
      have fo := apply(ib.fun_ok, {w}, {args}, {app(app(m1, "gpr"), 2)}, wu, hA, simp(m1M), simp(hd))
      have rv := apply(abi.ret_view, {4203843}, {ib.spec}, {args}, {s}, {m1}, {ibm.vm1(s)}, hM, he, hp2, v1, v1u, sv, sv, simp(hm1), rewrite(e0, fo))
      show := rewrite(sym(eo), rv)
    qed
    show by taut(ub, ret)
  qed
  show := apply(abi.implements_intro, runs)
qed

// C1 again, by the bridge: the machine code against the readable GIMPLE,
// with no reasoning about what either computes (proofs/abi_bridge.core)
theorem ib.implements_bridge: all statics. abi.implements2_at(single(empty), 4203843, ib.spec, 4203843, is_bouncing.code(), statics)
proof
  fix statics
  have m: all args s o. args in abi.ARGS -> s in x86_64_linux.Machine -> abi.loaded(app(s, "vm"), 4203843, is_bouncing.code(), statics) -> app(s, "rip") = 4203843 ->
      abi.entry_ok(s, args) -> runs(abi.run_to_return(), s, o) -> abi.matches(ib.spec, args, s, o) proof
    fix args
    fix s
    fix o
    assume hA: args in abi.ARGS
    assume hM: s in x86_64_linux.Machine
    assume hl: abi.loaded(app(s, "vm"), 4203843, is_bouncing.code(), statics)
    assume hrip: app(s, "rip") = 4203843
    assume he: abi.entry_ok(s, args)
    assume hr: runs(abi.run_to_return(), s, o)
    have hc: abi.code_at(app(s, "vm"), 4203843, is_bouncing.code()) by taut(expand(hl, abi.loaded))
    have su: s in univ(1) by simp(apply(abi.run_univ, hr))
    have ent := apply(abi.entry_stack, hM, he)
    show := bridge(hr, {app(ib.spec, args)}, hA, hM, hc, hrip, su, ent, he, expand(he, abi.entry_ok),
      is_bouncing.ok_402543, is_bouncing.ok_402547, is_bouncing.ok_40254b, is_bouncing.ok_40254e, is_bouncing.ok_402551, is_bouncing.ok_402553, is_bouncing.ok_402557, is_bouncing.ok_40255a,
      is_bouncing.ok_40255c, is_bouncing.ok_402563, is_bouncing.ok_402567, is_bouncing.ok_402569, is_bouncing.ok_40256b, is_bouncing.ok_402570, is_bouncing.ok_402571, is_bouncing.ok_402576)
  qed
  show := apply(abi.bridge_implements, m)
qed
