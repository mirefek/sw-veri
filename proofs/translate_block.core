// ----------------------------------------------------------------------
//  Blocks: per-block simulation. A block of the spec is proven on its own:
//  its claim from the block's start runs to the block's end, an extra
//  breakpoint bk, arrived at with ab (the locals coupled, the spec reduced
//  to the rest after the block) -- each path inside the block shows that
//  arrival for its own locals, no claim has to fit them. The rest's claim
//  from each state of bk with ab completes it: tr.bk_seq composes the two
//  into the claim without bk.

// (an outcome with bk among the breakpoints: one without it -- bk apart
// from the other breakpoints)
theorem tr.gk_bk(zb. bk, zb pb wb. ab, zb. bkp, zb pb wb. bka): all s v p w o. (all z. bkp(z) -> !bk(z)) ->
  tr.gk(s, zb. bk(zb) || bkp(zb), zb pb wb. (bk(zb) && ab(zb, pb, wb)) || (!bk(zb) && bka(zb, pb, wb)), v, p, w, o) ->
  tr.gk(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, o)
proof
  fix s v p w o
  assume hd h
  have k: (ex m1. o = ok(m1, empty) && tr.arr(s, zb. bk(zb) || bkp(zb), zb pb wb. (bk(zb) && ab(zb, pb, wb)) || (!bk(zb) && bka(zb, pb, wb)), v, m1, p, w)) ->
      (ex m1. o = ok(m1, empty) && tr.arr(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, m1, p, w)) proof
    assume e
    obtain m1, oe ha from e
    have a1 a2 := expand(ha, tr.arr)
    have b2: !tr.out(s, m1) -> bkp(m1) -> (ex p2 w2. tr.red(p, w, p2, w2) && bka(m1, p2, w2)) proof
      assume no hb
      have nb := mp(all_elim(hd, {m1}), hb)
      have hb2: bk(m1) || bkp(m1) by taut(hb)
      obtain p2 w2, rd ar from mp(a2, no, hb2)
      have ka: bka(m1, p2, w2) by taut(ar, nb)
      show by ex_intro({p2}, {w2}, taut(rd, ka))
    qed
    have a: tr.arr(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, m1, p, w) by defs(taut(a1, b2), tr.arr)
    show by ex_intro({m1}, taut(oe, a))
  qed
  show by defs(taut(expand(h, tr.gk), k), tr.gk)
qed

// The composition: the claim with the block's end bk as a breakpoint (its
// arrival ab), and the claim from each state of bk with ab -- the claim
// without bk
theorem tr.bk_seq(zb. bk, zb pb wb. ab, zb. bkp, zb pb wb. bka): all s v p w m. (all z. bkp(z) -> !bk(z)) ->
  (all z p2 w2. bk(z) -> ab(z, p2, w2) -> tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p2, w2, z)) ->
  tr.sim(s, zb. bk(zb) || bkp(zb), zb pb wb. (bk(zb) && ab(zb, pb, wb)) || (!bk(zb) && bka(zb, pb, wb)), v, p, w, m) ->
  tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m)
proof
  fix s v p w m
  assume hd hr hs
  let TR(x5) := fn_update(empty, "os.events", app(app(fst(x5), "os"), "events"))
  let BRK(l) := exc(pair(fst(l), empty), pair("brk", empty))
  // (an outcome of the run with bk: the claim's, without it)
  have gi: all o. tr.run_k(s, zb. bk(zb) || bkp(zb), m, o) -> tr.gk(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, o) proof
    fix o
    assume ho
    have c := mp(all_elim(expand(hs, tr.sim), {o}), ho)
    show := apply(tr.gk_bk[bk := zb. bk(zb), ab := zb pb wb. ab(zb, pb, wb), bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {p}, {w}, {o}, hd, c)
  qed
  // (a pass of the run without bk, until a state of bk: one with it)
  have gb: all l o2. (!bk(fst(l)) && tr.rbk(s, zb. bkp(zb), l, o2)) || (!!bk(fst(l)) && o2 = BRK(l)) -> tr.rbk(s, zb. bk(zb) || bkp(zb), l, o2) proof
    fix l o2
    assume g
    have g1: !bk(fst(l)) && tr.rbk(s, zb. bkp(zb), l, o2) -> tr.rbk(s, zb. bk(zb) || bkp(zb), l, o2) proof
      assume g2
      show by defs(taut(expand(g2.2, tr.rbk, tr.stopk), g2.1), tr.rbk, tr.stopk)
    qed
    have g3: !!bk(fst(l)) && o2 = BRK(l) -> tr.rbk(s, zb. bk(zb) || bkp(zb), l, o2) proof
      assume g2
      have st: tr.stopk(s, zb. bk(zb) || bkp(zb), fst(l)) by defs(taut(g2.1), tr.stopk)
      show by defs(taut(st, g2.2), tr.rbk)
    qed
    show by taut(g, g1, g3)
  qed
  have g: all o. tr.run_k(s, zb. bkp(zb), m, o) -> tr.gk(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, o) proof
    fix o
    assume ho
    obtain r, rk rm from expand(ho, tr.run_k)
    // the first step not ok: the same with bk
    have k2: tr.rst(pair(m, empty), r) && !is_ok(r) -> tr.gk(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, o) proof
      assume e
      have rk2: tr.rk(s, zb. bk(zb) || bkp(zb), m, r) by defs(taut(e), tr.rk)
      have hr2: tr.run_k(s, zb. bk(zb) || bkp(zb), m, o) by defs(ex_intro({r}, taut(rk2, rm)), tr.run_k)
      show := mp(all_elim(gi, {o}), hr2)
    qed
    // the passes: cut where they first reach a state of bk
    have k1: (ex l1. tr.rst(pair(m, empty), ok(l1, empty)) && tr.rwk(s, zb. bkp(zb), l1, r)) -> tr.gk(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, o) proof
      assume e
      obtain l1, rb0 rw from e
      have q1s: l1 = pair(fst(l1), empty) by simp(expand(rb0, tr.rst), keep(x86_64_linux.step))
      have he: all l. !is_ok(BRK(l)) proof
        fix l
        show by defs(simp(), is_ok)
      qed
      have hqs: all l l2. l = pair(fst(l), empty) -> tr.rbk(s, zb. bkp(zb), l, ok(l2, empty)) -> l2 = pair(fst(l2), empty) proof
        fix l l2
        assume _ hb1
        have c := apply(tr.rbk_ok[bkp := zb. bkp(zb)], {s}, {l}, {l2}, {empty}, hb1)
        show by taut(c)
      qed
      have sp := mp(while_split[l0 := l1, b := x5 x6. tr.rbk(s, zb. bkp(zb), x5, x6), tr := x5. TR(x5), p := l. !bk(fst(l)), e := l. BRK(l), r := r, q := l. l = pair(fst(l), empty)],
        he, q1s, hqs, expand(rw, tr.rwk))
      // never at bk: a run with bk
      have ca: while_rel(l1, l. true, l o2. (!bk(fst(l)) && tr.rbk(s, zb. bkp(zb), l, o2)) || (!!bk(fst(l)) && o2 = BRK(l)), l. TR(l), r) ->
          tr.gk(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, o) proof
        assume wg
        have w2 := mp(while_mono[l0 := l1, c := l. true, b1 := l o2. (!bk(fst(l)) && tr.rbk(s, zb. bkp(zb), l, o2)) || (!!bk(fst(l)) && o2 = BRK(l)),
          b2 := l o2. tr.rbk(s, zb. bk(zb) || bkp(zb), l, o2), tr := l. TR(l), r := r], gb, wg)
        have rw2: tr.rwk(s, zb. bk(zb) || bkp(zb), l1, r) by defs(w2, tr.rwk)
        have e2: ex l2. tr.rst(pair(m, empty), ok(l2, empty)) && tr.rwk(s, zb. bk(zb) || bkp(zb), l2, r) by ex_intro({l1}, taut(rb0, rw2))
        have rk2: tr.rk(s, zb. bk(zb) || bkp(zb), m, r) by defs(taut(e2), tr.rk)
        have hr2: tr.run_k(s, zb. bk(zb) || bkp(zb), m, o) by defs(ex_intro({r}, taut(rk2, rm)), tr.run_k)
        show := mp(all_elim(gi, {o}), hr2)
      qed
      // at a state l of bk first: the block's end, the run going on from l
      have cb: (ex l. l = pair(fst(l), empty) && while_rel(l1, l. true, l o2. (!bk(fst(l)) && tr.rbk(s, zb. bkp(zb), l, o2)) || (!!bk(fst(l)) && o2 = BRK(l)), l. TR(l), BRK(l)) &&
          (ex r1. while_rel(l, l. true, l o2. tr.rbk(s, zb. bkp(zb), l, o2), l. TR(l), r1) && fst(r1) = fst(r) && (!(fst(r) = 2) -> r1 = r))) ->
          tr.gk(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, o) proof
        assume e2
        obtain l, ql wg er from e2
        obtain r1, wr1 f1 fe from er
        have w2 := mp(while_mono[l0 := l1, c := l. true, b1 := l o2. (!bk(fst(l)) && tr.rbk(s, zb. bkp(zb), l, o2)) || (!!bk(fst(l)) && o2 = BRK(l)),
          b2 := l o2. tr.rbk(s, zb. bk(zb) || bkp(zb), l, o2), tr := l. TR(l), r := BRK(l)], gb, wg)
        have rw2: tr.rwk(s, zb. bk(zb) || bkp(zb), l1, BRK(l)) by defs(w2, tr.rwk)
        have e3: ex l2. tr.rst(pair(m, empty), ok(l2, empty)) && tr.rwk(s, zb. bk(zb) || bkp(zb), l2, BRK(l)) by ex_intro({l1}, taut(rb0, rw2))
        have rk2: tr.rk(s, zb. bk(zb) || bkp(zb), m, BRK(l)) by defs(taut(e3), tr.rk)
        have rmb: tr.rmap(BRK(l), ok(fst(l), empty)) by defs(simp(), tr.rmap)
        have hr2: tr.run_k(s, zb. bk(zb) || bkp(zb), m, ok(fst(l), empty)) by defs(ex_intro({BRK(l)}, taut(rk2, rmb)), tr.run_k)
        have stp := apply(tr.run_k_stop[bkp := zb. bk(zb) || bkp(zb)], {s}, {m}, {fst(l)}, {empty}, hr2)
        // (a stop of the run without bk there: the run's outcome there)
        have s1: tr.stopk(s, zb. bkp(zb), fst(l)) -> tr.gk(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, o) proof
          assume st
          have un := mp(while_unroll[l0 := l, c := l. true, b := l o2. tr.rbk(s, zb. bkp(zb), l, o2), tr := l. TR(l), r := r1], wr1)
          have u1: tr.rbk(s, zb. bkp(zb), l, r1) && !is_ok(r1) -> r1 = BRK(l) proof
            assume e4
            show by taut(expand(e4.1, tr.rbk), st)
          qed
          have u2: (ex l3. tr.rbk(s, zb. bkp(zb), l, ok(l3, empty)) && (ex r3. while_rel(l3, l. true, l o2. tr.rbk(s, zb. bkp(zb), l, o2), l. TR(l), r3) &&
              fst(r3) = fst(r1) && (!(fst(r1) = 2) -> r3 = r1))) -> r1 = BRK(l) proof
            assume e4
            obtain l3, hb3 _ from e4
            have c := apply(tr.rbk_ok[bkp := zb. bkp(zb)], {s}, {l}, {l3}, {empty}, hb3)
            show by taut(c, st)
          qed
          have u0: (!true && r1 = ok(l, empty)) -> r1 = BRK(l) proof
            assume e4
            show by taut(e4)
          qed
          have r1e: r1 = BRK(l) by taut(un, u0, u1, u2)
          have fr1: fst(r1) = 1 by simp(r1e)
          have f2: !(fst(r) = 2) by arith(fr1, f1)
          have re: r1 = r := mp(fe, f2)
          have rm2: tr.rmap(BRK(l), o) := rewrite(r1e, rewrite(sym(re), rm))
          have oe: o = ok(fst(l), empty) by simp(expand(rm2, tr.rmap))
          have hr3: tr.run_k(s, zb. bk(zb) || bkp(zb), m, o) := rewrite(sym(oe), hr2)
          show := mp(all_elim(gi, {o}), hr3)
        qed
        // (no stop of it: a state of bk -- the spec reduced there, the
        // rest's claim from it)
        have s2: !tr.stopk(s, zb. bkp(zb), fst(l)) -> tr.gk(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, o) proof
          assume nst
          have no: !tr.out(s, fst(l)) && !bkp(fst(l)) by taut(expand(nst, tr.stopk))
          have b1: bk(fst(l)) by taut(expand(stp, tr.stopk), no)
          have ci := mp(all_elim(expand(hs, tr.sim), {ok(fst(l), empty)}), hr2)
          let GK := tr.gk(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, o)
          have cu: tr.ub(s, v, p, w) -> GK proof
            assume hu
            show by defs(taut(hu), tr.gk)
          qed
          have cc: tr.crash(s, p, w, ok(fst(l), empty)) -> GK proof
            assume c
            obtain m1 a k0, {oe} from expand(c, tr.crash)
            show by simp(oe)
          qed
          have cd: tr.div(p, w, ok(fst(l), empty)) -> GK proof
            assume c
            obtain t, te from expand(c, tr.div).1
            show by simp(te)
          qed
          have ck: (ex m1. ok(fst(l), empty) = ok(m1, empty) && tr.arr(s, zb. bk(zb) || bkp(zb), zb pb wb. (bk(zb) && ab(zb, pb, wb)) || (!bk(zb) && bka(zb, pb, wb)), v, m1, p, w)) -> GK proof
            assume e4
            obtain m1, oe ha from e4
            have me: m1 = fst(l) by simp(oe)
            have ha2 := rewrite(me, ha)
            have a1 a2 := expand(ha2, tr.arr)
            have hb2: bk(fst(l)) || bkp(fst(l)) by taut(b1)
            obtain p2 w2, rd ar from mp(a2, no.1, hb2)
            have ab1: ab(fst(l), p2, w2) by taut(ar, b1)
            have sm := mp(all_elim(hr, {fst(l)}, {p2}, {w2}), b1, ab1)
            have cl: tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p2, w2, fst(l)) by defs(taut(nst, sm), tr.cl)
            have wr2: while_rel(pair(fst(l), empty), l. true, l o2. tr.rbk(s, zb. bkp(zb), l, o2), l. TR(l), r1) := rewrite(ql, wr1)
            have rw3: tr.rwk(s, zb. bkp(zb), pair(fst(l), empty), r1) by defs(wr2, tr.rwk)
            // (the run from there: to the outcome o, or a divergence as o)
            have d1: !(fst(r) = 2) -> GK proof
              assume nd
              have re: r1 = r := mp(fe, nd)
              have rm3: tr.rmap(r1, o) := rewrite(sym(re), rm)
              have gk2 := apply(tr.cl_rwk[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {p2}, {w2}, {fst(l)}, {r1}, {o}, cl, rw3, rm3)
              show := apply(tr.gk_red[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {p}, {w}, {p2}, {w2}, {o}, rd, gk2)
            qed
            have d2: fst(r) = 2 -> GK proof
              assume dd
              have rmo := rewrite(dd, expand(rm, tr.rmap))
              have od: o = diverge(snd(r)) by simp(rmo)
              have f12: fst(r1) = 2 by simp(f1, dd)
              have rmd: tr.rmap(r1, diverge(snd(r1))) by defs(simp(f12), tr.rmap)
              have gk2 := apply(tr.cl_rwk[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {p2}, {w2}, {fst(l)}, {r1}, {diverge(snd(r1))}, cl, rw3, rmd)
              have gk3 := apply(tr.gk_div[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {p2}, {w2}, {snd(r1)}, {snd(r)}, gk2)
              have gk4 := apply(tr.gk_red[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {p}, {w}, {p2}, {w2}, {diverge(snd(r))}, rd, gk3)
              show := rewrite(sym(od), gk4)
            qed
            show by taut(d1, d2)
          qed
          show by taut(expand(ci, tr.gk), cu, cc, cd, ck)
        qed
        show by taut(s1, s2)
      qed
      show by taut(sp, ca, cb)
    qed
    show by taut(expand(rk, tr.rk), k1, k2)
  qed
  show by defs(g, tr.sim)
qed

// ----------------------------------------------------------------------
//  A block of the spec at its start: the block a (of the world x0, to its
//  outcome x8), then the rest k, in the function's result wrapper kw
//  (tr.bprog: the point's program as the engine has it); the block on its
//  own (tr.bone): a, then -- completing with its locals -- a return marked
//  by 2^64 (no 64-bit word: never the function's return), or -- not
//  completing (a raise, a return) -- the rest in the wrapper (tr.lcont, as
//  a loop's iteration ends); the rest after the block, its locals y
//  (tr.brest). The block's lemma is about tr.bone alone: what follows it
//  only where the block does not complete.

def tr.bp0(x0 x8. a, x8 x1. k) := mkprog(x0 x1. ex x8. a(x0, x8) && k(x8, x1))
def tr.bprog(x0 x8. a, x8 x1. k, x3 x4 x2. kw) :=
  mkprog(x1 x2. bind_rel(tr.bp0(x0 x8. a(x0, x8), x8 x1. k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))
def tr.biter(x0 x8. a, x8 x1. k, x3 x4 x2. kw) := mkprog(x0 x3. ex x8. a(x0, x8) && tr.lcont(x8, x3, x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)))
def tr.bone(x0 x8. a, x8 x1. k, x3 x4 x2. kw) :=
  mkprog(x1 x2. bind_rel(tr.biter(x0 x8. a(x0, x8), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), x1, x3 x4. x2 = ok(x3, x4), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))
def tr.brest(y, x8 x1. k, x3 x4 x2. kw) :=
  mkprog(x1 x2. bind_rel(mkprog(x0 x3. k(ok(pair(x0, y), empty), x3)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))

// (the block's unmarked outcome: the whole's)
theorem tr.bone_f(x0 x8. a, x8 x1. k, x3 x4 x2. kw): all w o. runs(tr.bone(x0 x8. a(x0, x8), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w, o) -> !tr.mk(o) ->
  runs(tr.bprog(x0 x8. a(x0, x8), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w, o)
proof
  fix w o
  assume hr hm
  have hq := apply(tr.wrap_id_out[r := x0 x3. ex x8. a(x0, x8) && tr.lcont(x8, x3, x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2))], {w}, {o}, expand(hr, tr.bone, tr.biter))
  have pu := apply(g.runs_univ, hq)
  have wu: w in univ(1) by simp(pu)
  obtain x8, br cr0 from apply(g.runs_elim, hq)
  have cr := expand(cr0, tr.lcont)
  have go: (ex w2 y2. x8 = ok(pair(w2, y2), empty) && o = ok(w2, pair(18446744073709551616, y2))) -> false proof
    assume e
    obtain w2 y2, _ oe from e
    have m: tr.mk(o) by defs(ex_intro({w2}, {y2}, oe), tr.mk)
    show by taut(m, hm)
  qed
  have lv: !is_ok(x8) && bind_rel(mkprog(x0 x3. k(x8, x3)), fst(out_state(x8)), x4 x5. kw(x4, x5, o), x4 x5. o = exc(x4, x5), x4. o = diverge(x4)) by taut(cr, go)
  obtain o1, r1 c1 from expand(lv.2, bind_rel)
  have pu1 := apply(g.runs_univ, r1)
  have k1 := apply(g.runs_elim, r1)
  have u1: pair(w, o1) in univ(1) by simp(wu, pu1)
  have r0: ex x9. a(w, x9) && k(x9, o1) by ex_intro({x8}, taut(br, k1))
  have rf0 := apply(tr.runs_intro[r := x0 x1. ex x9. a(x0, x9) && k(x9, x1)], {w}, {o1}, u1, r0)
  have rf: runs(tr.bp0(x0 x8. a(x0, x8), x8 x1. k(x8, x1)), w, o1) by defs(rf0, tr.bp0)
  have b1: bind_rel(tr.bp0(x0 x8. a(x0, x8), x8 x1. k(x8, x1)), w, x3 x4. kw(x3, x4, o), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) by defs(ex_intro({o1}, taut(rf, c1)), bind_rel)
  have r2 := apply(tr.runs_intro[r := x1 x2. bind_rel(tr.bp0(x0 x8. a(x0, x8), x8 x1. k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))], {w}, {o}, pu, b1)
  show by defs(r2, tr.bprog)
qed

// (the block's marked return: the block completed, with y2)
theorem tr.bone_mk(x0 x8. a, x8 x1. k, x3 x4 x2. kw): all w w2 y2. runs(tr.bone(x0 x8. a(x0, x8), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w, ok(w2, pair(18446744073709551616, y2))) ->
  a(w, ok(pair(w2, y2), empty))
proof
  fix w w2 y2
  assume hr
  have hq := apply(tr.wrap_id_out[r := x0 x3. ex x8. a(x0, x8) && tr.lcont(x8, x3, x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2))], {w}, {ok(w2, pair(18446744073709551616, y2))}, expand(hr, tr.bone, tr.biter))
  obtain x8, br cr0 from apply(g.runs_elim, hq)
  have cr := expand(cr0, tr.lcont)
  have m: tr.mk(ok(w2, pair(18446744073709551616, y2))) by defs(ex_intro({w2}, {y2}, refl({ok(w2, pair(18446744073709551616, y2))})), tr.mk)
  have c1: ex w3 y3. x8 = ok(pair(w3, y3), empty) && ok(w2, pair(18446744073709551616, y2)) = ok(w3, pair(18446744073709551616, y3)) by taut(cr, m)
  obtain w3 y3, xe oe from c1
  have e1: w3 = w2 && y3 = y2 by simp(oe)
  have xe2: x8 = ok(pair(w2, y2), empty) by simp(xe, e1)
  show := rewrite(xe2, br)
qed

// (the block completed with y2: the whole goes on as the rest from y2)
theorem tr.brest_red(x0 x8. a, x8 x1. k, x3 x4 x2. kw): all w w2 y2. w in univ(1) -> a(w, ok(pair(w2, y2), empty)) ->
  tr.red(tr.bprog(x0 x8. a(x0, x8), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w, tr.brest(y2, x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w2)
proof
  fix w w2 y2
  assume hw ha
  have g: all o. runs(tr.brest(y2, x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w2, o) -> runs(tr.bprog(x0 x8. a(x0, x8), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w, o) proof
    fix o
    assume hr
    have pu := apply(g.runs_univ, hr)
    have b2 := apply(g.runs_elim, expand(hr, tr.brest))
    obtain o1, r1 c1 from expand(b2, bind_rel)
    have pu1 := apply(g.runs_univ, r1)
    have k1 := apply(g.runs_elim, r1)
    have u1: pair(w, o1) in univ(1) by simp(hw, pu1)
    have r0: ex x9. a(w, x9) && k(x9, o1) by ex_intro({ok(pair(w2, y2), empty)}, taut(ha, k1))
    have rf0 := apply(tr.runs_intro[r := x0 x1. ex x9. a(x0, x9) && k(x9, x1)], {w}, {o1}, u1, r0)
    have rf: runs(tr.bp0(x0 x8. a(x0, x8), x8 x1. k(x8, x1)), w, o1) by defs(rf0, tr.bp0)
    have b1: bind_rel(tr.bp0(x0 x8. a(x0, x8), x8 x1. k(x8, x1)), w, x3 x4. kw(x3, x4, o), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) by defs(ex_intro({o1}, taut(rf, c1)), bind_rel)
    have u: pair(w, o) in univ(1) by simp(hw, pu)
    have r2 := apply(tr.runs_intro[r := x1 x2. bind_rel(tr.bp0(x0 x8. a(x0, x8), x8 x1. k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))], {w}, {o}, u, b1)
    show by defs(r2, tr.bprog)
  qed
  show by defs(g, tr.red)
qed

// The block rule: at the block's start, the claim for the whole -- from the
// block's lemma (its claim for tr.bone, the block's end ha a breakpoint
// arrived at coupled to the locals y2, the spec's return of them marked;
// as a loop's iteration) and the claim for the rest after the block from
// its end, for every locals and world
theorem tr.block_lv(s, v, base, code, fr, ha, fd, y. hs, y. yt, z. bkp, z p w. bka, x0 x8. a, x8 x1. k, x3 x4 x2. kw):
  (all z. app(z, "rip") = ha -> !bkp(z)) ->
  (all y w. pair(w, y) in univ(1) -> yt(y) -> w in abi.World && w in univ(1) ->
    tr.lv(s, z. bkp(z), z p w. bka(z, p, w), v, base, code, fr, ha, hs(y), fd, empty, tr.brest(y, x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w)) ->
  all b hsb rs w. tr.lv(s, z. tr.hd(z) = pair(ha, int_sub(app(app(s, "gpr"), 4), fr)) || bkp(z),
      z p2 w2. tr.hd(z) = pair(ha, int_sub(app(app(s, "gpr"), 4), fr)) && (ex y2. (tr.inv(s, base, code, fr, z, w2) && app(z, "rip") = ha && tr.homes(s, z, hs(y2)) &&
        tr.mem(s, z, w2, v) && tr.frame(s, z, fd) && pair(w2, y2) in univ(1) && yt(y2)) && runs(p2, w2, ok(w2, pair(18446744073709551616, y2)))),
      v, base, code, fr, b, hsb, fd, rs, tr.bone(x0 x8. a(x0, x8), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w) ->
    tr.lv(s, z. bkp(z), z p w. bka(z, p, w), v, base, code, fr, b, hsb, fd, rs, tr.bprog(x0 x8. a(x0, x8), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w)
proof
  assume hbo hrest
  let Q(x, y, w) := tr.inv(s, base, code, fr, x, w) && app(x, "rip") = ha && tr.homes(s, x, hs(y)) && tr.mem(s, x, w, v) && tr.frame(s, x, fd) && pair(w, y) in univ(1) && yt(y)
  let H := pair(ha, int_sub(app(app(s, "gpr"), 4), fr))
  let PB := tr.bone(x0 x8. a(x0, x8), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2))
  let PP := tr.bprog(x0 x8. a(x0, x8), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2))
  fix b hsb rs w
  assume hblk
  // (the block's unmarked runs: the whole's)
  have hx: all x e. runs(PB, w, exc(x, e)) -> runs(PP, w, exc(x, e)) proof
    fix x e
    assume r1
    have nm: tr.mk(exc(x, e)) -> false proof
      assume m
      obtain a0 b0, me from expand(m, tr.mk)
      show by simp(me)
    qed
    show := apply(tr.bone_f[a := x0 x8. a(x0, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {exc(x, e)}, r1, taut(nm))
  qed
  have hd: all t. runs(PB, w, diverge(t)) -> runs(PP, w, diverge(t)) proof
    fix t
    assume r1
    have nm: tr.mk(diverge(t)) -> false proof
      assume m
      obtain a0 b0, me from expand(m, tr.mk)
      show by simp(me)
    qed
    show := apply(tr.bone_f[a := x0 x8. a(x0, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {diverge(t)}, r1, taut(nm))
  qed
  // (the outcome condition of the block's claim: the whole's, the block's
  // end arrived at with the rest after it)
  have cv: all o. tr.gk(s, z. tr.hd(z) = H || bkp(z), z p2 w2. tr.hd(z) = H && (ex y2. Q(z, y2, w2) && runs(p2, w2, ok(w2, pair(18446744073709551616, y2)))), v, PB, w, o) ->
      tr.gk(s, z. tr.hd(z) = H || bkp(z), z p2 w2. (tr.hd(z) = H && (ex y2. Q(z, y2, w2) && p2 = tr.brest(y2, x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)))) || (!(tr.hd(z) = H) && bka(z, p2, w2)),
        v, PP, w, o) proof
    fix o
    assume h
    let G := tr.gk(s, z. tr.hd(z) = H || bkp(z), z p2 w2. (tr.hd(z) = H && (ex y2. Q(z, y2, w2) && p2 = tr.brest(y2, x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)))) || (!(tr.hd(z) = H) && bka(z, p2, w2)),
        v, PP, w, o)
    have c1: tr.ub(s, v, PB, w) -> G proof
      assume u
      obtain e x, eu en rs0 rr from expand(u, tr.ub)
      have r := mp(all_elim(hx, {x}, {e}), rr)
      have u2: tr.ub(s, v, PP, w) by defs(ex_intro({e}, {x}, taut(eu, en, rs0, r)), tr.ub)
      show by defs(taut(u2), tr.gk)
    qed
    have c2: tr.crash(s, PB, w, o) -> G proof
      assume c
      obtain m1 a0 k0, c3 from expand(c, tr.crash)
      have o2: tr.ovf(PB, w, app(m1, "os")) -> tr.ovf(PP, w, app(m1, "os")) proof
        assume hv
        have e1: (ex x. x in rec_and(abi.World, single(empty)) && runs(PB, w, exc(x, exc_val("stack_overflow", empty))) && app(app(x, "os"), "events") = app(app(m1, "os"), "events")) ->
            tr.ovf(PP, w, app(m1, "os")) proof
          assume e
          obtain x, xa xr xe from e
          have r := mp(all_elim(hx, {x}, {exc_val("stack_overflow", empty)}), xr)
          have e2: ex x1. x1 in rec_and(abi.World, single(empty)) && runs(PP, w, exc(x1, exc_val("stack_overflow", empty))) && app(app(x1, "os"), "events") = app(app(m1, "os"), "events")
            by ex_intro({x}, taut(xa, r, xe))
          show by defs(taut(e2), tr.ovf)
        qed
        have e3: (ex t. runs(PB, w, diverge(t))) -> tr.ovf(PP, w, app(m1, "os")) proof
          assume e
          obtain t, tr2 from e
          have r := mp(all_elim(hd, {t}), tr2)
          have e2: ex t1. runs(PP, w, diverge(t1)) by ex_intro({t}, r)
          show by defs(taut(e2), tr.ovf)
        qed
        show by taut(expand(hv, tr.ovf), e1, e3)
      qed
      have cr: tr.crash(s, PP, w, o) by defs(ex_intro({m1}, {a0}, {k0}, taut(c3, o2)), tr.crash)
      show by defs(taut(cr), tr.gk)
    qed
    have c3: tr.div(PB, w, o) -> G proof
      assume d
      have d1 d2 := expand(d, tr.div)
      obtain t, rt from d2
      have r := mp(all_elim(hd, {t}), rt)
      have e2: ex t1. runs(PP, w, diverge(t1)) by ex_intro({t}, r)
      have dv: tr.div(PP, w, o) by defs(taut(d1, e2), tr.div)
      show by defs(taut(dv), tr.gk)
    qed
    have c4: (ex m1. o = ok(m1, empty) && tr.arr(s, z. tr.hd(z) = H || bkp(z), z p2 w2. tr.hd(z) = H && (ex y2. Q(z, y2, w2) && runs(p2, w2, ok(w2, pair(18446744073709551616, y2)))), v, m1, PB, w)) -> G proof
      assume e
      obtain m1, oe ha0 from e
      have a1 a2 := expand(ha0, tr.arr)
      // (returned: the whole returns so)
      have b1: tr.out(s, m1) -> tr.retok(s, v, PP, w, m1) proof
        assume at
        have rx := expand(mp(a1, at), tr.retok)
        have mM: m1 in x86_64_linux.Machine by taut(rx)
        have ew: ex w3. runs(PB, w, ok(w3, pair(app(app(m1, "gpr"), 0), app(app(m1, "gpr"), 2)))) && w3 in abi.World && w3 in univ(1) &&
            abi.world_matches(app(s, "vm"), app(m1, "vm"), app(w3, "vm"), v, abi.sp(s)) && app(m1, "os") = app(w3, "os") && app(m1, "fs_base") = app(w3, "fs_base") by taut(rx)
        obtain w3, h3 from ew
        have r0: 0 in x86_64_linux.Reg by simp()
        have rb := apply(x86i.reg_typed, mM, r0)
        have nm: tr.mk(ok(w3, pair(app(app(m1, "gpr"), 0), app(app(m1, "gpr"), 2)))) -> false proof
          assume m
          obtain a3 b3, me from expand(m, tr.mk)
          have e5: app(app(m1, "gpr"), 0) = 18446744073709551616 by simp(me)
          show by arith(e5, rb)
        qed
        have r := apply(tr.bone_f[a := x0 x8. a(x0, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {ok(w3, pair(app(app(m1, "gpr"), 0), app(app(m1, "gpr"), 2)))}, h3.1, taut(nm))
        have ew2: ex w4. runs(PP, w, ok(w4, pair(app(app(m1, "gpr"), 0), app(app(m1, "gpr"), 2)))) && w4 in abi.World && w4 in univ(1) &&
            abi.world_matches(app(s, "vm"), app(m1, "vm"), app(w4, "vm"), v, abi.sp(s)) && app(m1, "os") = app(w4, "os") && app(m1, "fs_base") = app(w4, "fs_base")
          by ex_intro({w3}, taut(r, h3))
        show by defs(taut(rx, ew2), tr.retok)
      qed
      // (at the block's end: the block completed, the whole goes on as the
      // rest after it; at no other breakpoint)
      have b2: !tr.out(s, m1) -> tr.hd(m1) = H || bkp(m1) -> (ex p3 w3. tr.red(PP, w, p3, w3) &&
          ((tr.hd(m1) = H && (ex y2. Q(m1, y2, w3) && p3 = tr.brest(y2, x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)))) || (!(tr.hd(m1) = H) && bka(m1, p3, w3)))) proof
        assume no hb
        obtain p2 w2, rd ar from mp(a2, no, hb)
        obtain y2, qr from ar.2
        have q2: Q(m1, y2, w2) by taut(qr)
        have r2: runs(p2, w2, ok(w2, pair(18446744073709551616, y2))) by taut(qr)
        have r1 := mp(all_elim(expand(rd, tr.red), {ok(w2, pair(18446744073709551616, y2))}), r2)
        have pu := apply(g.runs_univ, r1)
        have wu: w in univ(1) by simp(pu)
        have bc := apply(tr.bone_mk[a := x0 x8. a(x0, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {w2}, {y2}, r1)
        have rd2 := apply(tr.brest_red[a := x0 x8. a(x0, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {w2}, {y2}, wu, bc)
        have ey: ex y3. Q(m1, y3, w2) && tr.brest(y2, x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)) = tr.brest(y3, x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2))
          by ex_intro({y2}, taut(q2, refl({tr.brest(y2, x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2))})))
        show by ex_intro({tr.brest(y2, x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2))}, {w2}, taut(rd2, ar.1, ey))
      qed
      have a3: tr.arr(s, z. tr.hd(z) = H || bkp(z), z p2 w2. (tr.hd(z) = H && (ex y2. Q(z, y2, w2) && p2 = tr.brest(y2, x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)))) || (!(tr.hd(z) = H) && bka(z, p2, w2)),
          v, m1, PP, w) by defs(taut(b1, b2), tr.arr)
      have e2: ex m2. o = ok(m2, empty) && tr.arr(s, z. tr.hd(z) = H || bkp(z), z p2 w2. (tr.hd(z) = H && (ex y2. Q(z, y2, w2) && p2 = tr.brest(y2, x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)))) || (!(tr.hd(z) = H) && bka(z, p2, w2)),
          v, m2, PP, w) by ex_intro({m1}, taut(oe, a3))
      show by defs(taut(e2), tr.gk)
    qed
    show by taut(expand(h, tr.gk), c1, c2, c3, c4)
  qed
  // (bkp apart from the block's end; the rest's claim from the block's end)
  have hdis: all z. bkp(z) -> !(tr.hd(z) = H) proof
    fix z
    assume hb
    have n: tr.hd(z) = H -> false proof
      assume e
      have r: app(z, "rip") = ha by simp(expand(e, tr.hd))
      show by taut(mp(all_elim(hbo, {z}), r), hb)
    qed
    show by taut(n)
  qed
  have hr2: all z p2 w2. tr.hd(z) = H -> (ex y2. Q(z, y2, w2) && p2 = tr.brest(y2, x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2))) ->
      tr.sim(s, z. bkp(z), z p w. bka(z, p, w), v, p2, w2, z) proof
    fix z p2 w2
    assume _ e
    obtain y2, hi2 hr3 hh2 hm2 hf2 hu2 hy2 pe from e
    have wW := hi2.wW
    have wu := hi2.wu
    have l := mp(all_elim(hrest, {y2}, {w2}), hu2, hy2, conj(wW, wu))
    have s3 := mp(all_elim(expand(l, tr.lv), {z}), hi2, hr3, hh2, all_elim(tr.regs_empty, {z}), hm2, hf2)
    show := rewrite(sym(pe), s3)
  qed
  have g: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = b -> tr.homes(s, m, hsb) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, fd) ->
      tr.sim(s, z. bkp(z), z p w. bka(z, p, w), v, PP, w, m) proof
    fix m
    assume hi hr hh hrs hm hf
    have s1 := mp(all_elim(expand(hblk, tr.lv), {m}), hi, hr, hh, hrs, hm, hf)
    have g2: all o. tr.run_k(s, z. tr.hd(z) = H || bkp(z), m, o) ->
        tr.gk(s, z. tr.hd(z) = H || bkp(z), z p2 w2. (tr.hd(z) = H && (ex y2. Q(z, y2, w2) && p2 = tr.brest(y2, x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)))) || (!(tr.hd(z) = H) && bka(z, p2, w2)),
          v, PP, w, o) proof
      fix o
      assume ho
      show := mp(all_elim(cv, {o}), mp(all_elim(expand(s1, tr.sim), {o}), ho))
    qed
    have s2: tr.sim(s, z. tr.hd(z) = H || bkp(z), z p2 w2. (tr.hd(z) = H && (ex y2. Q(z, y2, w2) && p2 = tr.brest(y2, x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)))) || (!(tr.hd(z) = H) && bka(z, p2, w2)),
        v, PP, w, m) by defs(g2, tr.sim)
    show := apply(tr.bk_seq[bk := z. tr.hd(z) = H, ab := z p2 w2. ex y2. Q(z, y2, w2) && p2 = tr.brest(y2, x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), bkp := z. bkp(z), bka := z p w. bka(z, p, w)],
      {s}, {v}, {PP}, {w}, {m}, hdis, hr2, s2)
  qed
  show by defs(g, tr.lv)
qed
