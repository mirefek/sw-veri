// A call in the translation (docs/bridge-pattern-design.md, step 8): the
// machine's `call` against readable GIMPLE's call_at -- the push (a fault:
// a crash or GIMPLE's undefined call), the callee's contract
// (tr.implements_at) on its entry state, the caller's run split at the
// callee's return (tr.run_split), and the claim after the call.
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core core/records.core \
//     core/list.core core/loop.core build/c_mallocng_malloc.core proofs/x86.core proofs/x86_code.core \
//     proofs/x86_stack.core proofs/x86_insn.core proofs/abi.core proofs/abi_restore.core proofs/abi_glue.core \
//     proofs/gimple.core proofs/gimple_call.core proofs/abi_stack.core proofs/abi_loop.core proofs/abi_bridge.core \
//     proofs/translate.core proofs/translate_store_loop.core proofs/translate_call.core

// ----------------------------------------------------------------------
//  Generic pieces

// a step that may fault: its successors' claims, and every fault a crash
// or undefined
theorem tr.step_x(s, v, p, w, m, x. q, x y. qx): (all o. runs(x86_64_linux.step(), m, o) -> (ex m2. o = ok(m2, empty) && q(m2)) || (ex x e. o = exc(x, e) && qx(x, e))) ->
  int_lt(app(app(m, "gpr"), 4), abi.sp(s)) -> (all m2. q(m2) -> tr.sim(s, v, p, w, m2)) ->
  (all x e. qx(x, e) -> tr.ub(s, v, p, w) || tr.crash(s, p, w, exc(x, e))) -> tr.sim(s, v, p, w, m)
proof
  assume hs hlt h hx
  have hn0: app(app(m, "gpr"), 4) = abi.sp(s) -> false proof
    assume e
    have l2 := rewrite(e, hlt)
    show by arith(l2)
  qed
  have hn: !(app(m, "rip") = abi.ret(s) && app(app(m, "gpr"), 4) = abi.sp(s)) by taut(hn0)
  have dok: tr.disc_ok(s, fst(pair(m, empty))) by simp(hlt)
  have hbd: all r. tr.rbd(s, pair(m, empty), r) -> tr.rb(s, pair(m, empty), r) proof
    fix r
    assume hb
    show by taut(expand(hb, tr.rbd), dok)
  qed
  // the pass from m: a step to some m2 with q, or a fault
  have hb_ok: all l1. tr.rb(s, pair(m, empty), ok(l1, empty)) -> (ex m2. l1 = pair(m2, empty) && q(m2)) proof
    fix l1
    assume hb
    have b1: ex x1. runs(x86_64_linux.step(), m, x1) && (ex x2 x3. x1 = ok(x2, x3) && l1 = pair(x2, empty)) by simp(expand(hb, tr.rb), hn, keep(x86_64_linux.step))
    obtain x1, c1 from b1
    have e := mp(all_elim(hs, {x1}), taut(c1))
    have c2: (ex x e. x1 = exc(x, e) && qx(x, e)) -> false proof
      assume ex
      obtain x e3, ex3 from ex
      show by simp(c1, ex3, keep(x86_64_linux.step))
    qed
    have e1: ex m2. x1 = ok(m2, empty) && q(m2) by taut(e, c2)
    obtain m2, e2 from e1
    have l1e: l1 = pair(m2, empty) by simp(c1, e2, keep(x86_64_linux.step))
    show by ex_intro({m2}, taut(l1e, e2))
  qed
  have hb_nok: all r. tr.rb(s, pair(m, empty), r) -> !is_ok(r) -> (ex x e. r = exc(pair(x, empty), pair("raise", e)) && qx(x, e)) proof
    fix r
    assume hb hn2
    have b1: ex x1. runs(x86_64_linux.step(), m, x1) && ((ex x2 x3. x1 = ok(x2, x3) && r = ok(pair(x2, empty), empty)) ||
      (ex x2 x3. x1 = exc(x2, x3) && r = exc(pair(x2, empty), pair("raise", x3))) || (ex x2. x1 = diverge(x2) && r = diverge(x2))) by simp(expand(hb, tr.rb), hn, keep(x86_64_linux.step))
    obtain x1, c1 from b1
    have e := mp(all_elim(hs, {x1}), taut(c1))
    have k1: (ex m2. x1 = ok(m2, empty) && q(m2)) -> (ex x e. r = exc(pair(x, empty), pair("raise", e)) && qx(x, e)) proof
      assume ek
      obtain m2, e2 from ek
      show by simp(c1, e2, hn2, keep(x86_64_linux.step))
    qed
    have k2: (ex x e. x1 = exc(x, e) && qx(x, e)) -> (ex x e. r = exc(pair(x, empty), pair("raise", e)) && qx(x, e)) proof
      assume ek
      obtain x e3, ek3 from ek
      have re: r = exc(pair(x, empty), pair("raise", e3)) by simp(c1, ek3, keep(x86_64_linux.step))
      show by ex_intro({x}, {e3}, taut(re, ek3.2))
    qed
    show by taut(e, k1, k2)
  qed
  have hk: all m2 r o2. q(m2) -> tr.rwd(s, pair(m2, empty), r) -> tr.rmap(r, o2) -> tr.ub(s, v, p, w) || tr.ok(s, v, p, w, o2) || tr.crash(s, p, w, o2) proof
    fix m2 r o2
    assume hq hw hm
    have rf: tr.run_d(s, m2, o2) by defs(ex_intro({r}, taut(hw, hm)), tr.run_d)
    show := mp(all_elim(expand(mp(all_elim(h, {m2}), hq), tr.sim), {o2}), rf)
  qed
  have g: all o. tr.run_d(s, m, o) -> tr.ub(s, v, p, w) || tr.ok(s, v, p, w, o) || tr.crash(s, p, w, o) proof
    fix o
    assume ho
    obtain x4, hw hm from expand(ho, tr.run_d)
    let W(l, r) := while_rel(l, x5. true, x5 x6. tr.rbd(s, x5, x6), x5. fn_update(empty, "os.events", app(app(fst(x5), "os"), "events")), r)
    have u := mp(while_unroll[l0 := pair(m, empty), c := l. true, b := l o. tr.rbd(s, l, o),
      tr := l. fn_update(empty, "os.events", app(app(fst(l), "os"), "events")), r := x4], expand(hw, tr.rwd))
    // (the first pass faults: the run's outcome that fault)
    have fl: tr.rbd(s, pair(m, empty), x4) && !is_ok(x4) -> tr.ub(s, v, p, w) || tr.ok(s, v, p, w, o) || tr.crash(s, p, w, o) proof
      assume hf
      have rb := mp(all_elim(hbd, {x4}), hf.1)
      have ef := mp(all_elim(hb_nok, {x4}), rb, hf.2)
      obtain x e, xe q3 from ef
      have hm2 := rewrite(xe, hm)
      have oe: o = exc(x, e) by simp(expand(hm2, tr.rmap))
      have c := mp(all_elim(hx, {x}, {e}), q3)
      have c2: tr.ub(s, v, p, w) || tr.ok(s, v, p, w, exc(x, e)) || tr.crash(s, p, w, exc(x, e)) by taut(c)
      show := rewrite(sym(oe), c2)
    qed
    // (the loop goes on from m2)
    have on: (ex l1. tr.rbd(s, pair(m, empty), ok(l1, empty)) && (ex r1. W(l1, r1) && fst(r1) = fst(x4) && (!(fst(x4) = 2) -> r1 = x4))) ->
        tr.ub(s, v, p, w) || tr.ok(s, v, p, w, o) || tr.crash(s, p, w, o) proof
      assume e
      obtain l1, rbd1 e1b from e
      have rb1 := mp(all_elim(hbd, {ok(l1, empty)}), rbd1)
      obtain m2, l1e hq from mp(all_elim(hb_ok, {l1}), rb1)
      obtain r1, w0 f4 re4 from e1b
      have w1: tr.rwd(s, pair(m2, empty), r1) by defs(rewrite(l1e, w0), tr.rwd)
      have same: !(fst(x4) = 2) -> tr.ub(s, v, p, w) || tr.ok(s, v, p, w, o) || tr.crash(s, p, w, o) proof
        assume nd
        have re := mp(re4, nd)
        show := mp(mp(mp(all_elim(hk, {m2}, {r1}, {o}), hq), w1), rewrite(sym(re), hm))
      qed
      have div: fst(x4) = 2 -> tr.ub(s, v, p, w) || tr.ok(s, v, p, w, o) || tr.crash(s, p, w, o) proof
        assume d
        have d1: fst(r1) = 2 by simp(f4, d)
        have c := mp(mp(mp(all_elim(hk, {m2}, {r1}, {diverge(snd(r1))}), hq), w1), defs(simp(d1), tr.rmap))
        have nk := all_elim(tr.ok_not_div, {s}, {v}, {p}, {w}, {snd(r1)})
        have nc := all_elim(tr.crash_not_div, {s}, {p}, {w}, {snd(r1)})
        show by taut(c, nk, nc)
      qed
      show by taut(same, div)
    qed
    show by taut(u, on, fl)
  qed
  show by defs(g, tr.sim)
qed

// an operation that changes the world: the spec's rest from its result
theorem tr.qs_call(op, w4, r, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k): all w. w in univ(1) -> runs(op, w, ok(w4, r)) ->
  (all o. runs(mkprog(x0 x1. ex x8. a(x0, r, x8) && k(x8, x1)), w4, o) ->
    runs(mkprog(x0 x1. ex x8. bind_rel(op, x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), w, o))
proof
  fix w
  assume hwu hq
  fix o
  assume h0
  have hu: pair(w4, o) in univ(1) && (ex x8. a(w4, r, x8) && k(x8, o)) by simp(expand(expand(h0, runs), mkprog))
  have pu: pair(w, o) in univ(1) by simp(hu, hwu)
  obtain y, hy from hu.2
  have ay := hy.1
  have e: ex o2. runs(op, w, o2) && ((ex s1 v. o2 = ok(s1, v) && a(s1, v, y)) || (ex s1 e. o2 = exc(s1, e) && xx(s1, e, y)) || (ex t. o2 = diverge(t) && dd(t, y)))
    by ex_intro({ok(w4, r)}, simp(hq, ay))
  have b: bind_rel(op, w, x9 x10. a(x9, x10, y), x9 x10. xx(x9, x10, y), x9. dd(x9, y)) by defs(e, bind_rel)
  have g: ex x8. bind_rel(op, w, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, o) by ex_intro({y}, taut(b, hy))
  show := mp(all_elim(tr.runs_intro[r := x0 x1. ex x8. bind_rel(op, x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)], {w}, {o}), pu, g)
qed

// the procedure's rest raising: the function raising
theorem tr.p_exc(q, x3 x4 x2. kw): all w x e. w in univ(1) -> x in univ(1) -> e in univ(1) -> runs(q, w, exc(x, e)) ->
  runs(mkprog(x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, exc(x, e))
proof
  fix w x e
  assume hw hx he hr
  have b0: ex o2. runs(q, w, o2) && ((ex s1 v. o2 = ok(s1, v) && kw(s1, v, exc(x, e))) || (ex s1 e1. o2 = exc(s1, e1) && exc(x, e) = exc(s1, e1)) ||
    (ex t. o2 = diverge(t) && exc(x, e) = diverge(t))) by ex_intro({exc(x, e)}, simp(hr))
  have b: bind_rel(q, w, x3 x4. kw(x3, x4, exc(x, e)), x3 x4. exc(x, e) = exc(x3, x4), x3. exc(x, e) = diverge(x3)) by defs(b0, bind_rel)
  have pu: pair(w, exc(x, e)) in univ(1) by simp(hw, hx, he)
  show := mp(all_elim(tr.runs_intro[r := x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))], {w}, {exc(x, e)}), pu, b)
qed

// ... at a call: the call raising
theorem tr.call_exc(g, args, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all w x e. w in univ(1) -> x in univ(1) -> e in univ(1) ->
  runs(gimple.call1(g, args), w, exc(x, e)) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e)) ->
  runs(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, exc(x, e))
proof
  fix w x e
  assume hw hx he hc hk
  have q := mp(all_elim(mp(all_elim(tr.qs_raise[op := gimple.call1(g, args), s2 := x, e := e, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1)], {w}), hc), {exc(x, e)}), hk)
  show := apply(tr.p_exc[q := mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), kw := x3 x4 x2. kw(x3, x4, x2)],
    {w}, {x}, {e}, hw, hx, he, q)
qed

// (a one-element list)
theorem tr.seq_one_type: all x t. x in t -> seq_one(x) in list_type(t)
proof
  fix x t
  assume hx
  have mem: all z. z in seq_one(x) -> z = pair(0, x) proof
    fix z
    assume hz
    show := mp(single_elim[a := pair(0, x), z := z], expand(hz, seq_one))
  qed
  have f1: all z. z in seq_one(x) -> (ex a b. z = pair(a, b)) proof
    fix z
    assume hz
    have e := mp(all_elim(mem, {z}), hz)
    show by ex_intro({0}, {x}, e)
  qed
  have f2: all a b c. pair(a, b) in seq_one(x) -> pair(a, c) in seq_one(x) -> b = c proof
    fix a b c
    assume h1 h2
    have e1 := mp(all_elim(mem, {pair(a, b)}), h1)
    have e2 := mp(all_elim(mem, {pair(a, c)}), h2)
    show by simp(e1, e2)
  qed
  have fu: is_fun(seq_one(x)) by defs(taut(f1, f2), is_fun)
  have ss: all z. z in seq_one(x) -> z in cart(omega, t) proof
    fix z
    assume hz
    have e := mp(all_elim(mem, {z}), hz)
    have c := mp(mp(cart_intro[a := omega, b := t, x := 0, y := x], simp()), hx)
    show := rewrite(sym(e), c)
  qed
  have sb: subset(seq_one(x), cart(omega, t)) by defs(ss, subset)
  have pw: seq_one(x) in powerset(cart(omega, t)) by taut(powerset_def[s := cart(omega, t), a := seq_one(x)], sb)
  have l1: seq_len(seq_one(x)) = 1 by arith()
  have l1d: dom(seq_one(x)) = 1 by defs(l1, seq_len)
  have o1: 1 in omega by simp()
  have d1: dom(seq_one(x)) in omega := rewrite(sym(l1d), o1)
  show by defs(simp(pw, fu, d1), list_type, seq_type, is_seq)
qed

// one argument, in a register
theorem tr.regs1: all u ar. u in bits(64) -> u in gimple.in_reg(fst(ar), snd(ar)) ->
  seq_one(u) in list_type(bits(64)) && seq_one(u) in univ(1) && seq_len(seq_one(u)) = seq_len(seq_one(ar)) &&
  (all i. i in omega -> int_lt(i, seq_len(seq_one(ar))) -> app(seq_one(u), i) in gimple.in_reg(fst(app(seq_one(ar), i)), snd(app(seq_one(ar), i))))
proof
  fix u ar
  assume hu hi
  have g: all i. i in omega -> int_lt(i, seq_len(seq_one(ar))) -> app(seq_one(u), i) in gimple.in_reg(fst(app(seq_one(ar), i)), snd(app(seq_one(ar), i))) proof
    fix i
    assume h1 h2
    have z: i = 0 by simp(h1, h2)
    have e1 := at({app(seq_one(u), 0)})
    have e2 := at({app(seq_one(ar), 0)})
    show by simp(z, hi, e1, e2)
  qed
  have l1: seq_len(seq_one(u)) = 1 by arith()
  have l2: seq_len(seq_one(ar)) = 1 by arith()
  have lt := apply(tr.seq_one_type, {u}, {bits(64)}, hu)
  have lu: seq_one(u) in univ(1) by defs(simp(hu), seq_one)
  show by simp(lt, lu, l1, l2, g)
qed

// ----------------------------------------------------------------------
//  The push of a call from a frame of 8 bytes: rsp S - 8 (S the entry's
//  rsp), the return address to the 8 bytes from S - 16 -- one page, at most
//  the one below S's

theorem tr.push_at: all S j. S in bits(64) -> int_le(16, S) -> int_lt(S, 140737488355328) -> int_mod(bits_add(64, S, 8), 16) = 0 ->
  j in omega -> int_lt(j, 8) ->
  bits_add(64, bits_sub(64, int_sub(S, 8), 8), bits_of_int(64, j)) = int_add(int_sub(S, 16), j) &&
  int_div(int_add(int_sub(S, 16), j), 4096) = int_div(int_sub(S, 16), 4096)
proof
  fix S j
  assume hs h16 hl ha hj hj8
  have p64: pow2(64) = 18446744073709551616 by simp()
  have sb: int_le(0, S) && int_lt(S, 18446744073709551616) by simp(hs)
  have m1: int_mod(int_add(S, 8), 16) = 0 by simp(hs, ha, hl)
  have e0: int_mod(int_add(int_mod(int_sub(int_sub(S, 8), 8), 18446744073709551616), int_mod(j, 18446744073709551616)), 18446744073709551616) = int_add(int_sub(S, 16), j)
    by arith(sb, h16, hl, hj, hj8)
  have e: bits_add(64, bits_sub(64, int_sub(S, 8), 8), bits_of_int(64, j)) = int_add(int_sub(S, 16), j) by defs(rewrite(sym(p64), e0), bits_add, bits_sub, bits_of_int)
  have m2: int_le(8, int_mod(int_sub(S, 16), 4096)) && int_le(int_mod(int_sub(S, 16), 4096), 4088) by simp(hs, m1, h16)
  have d: int_div(int_add(int_sub(S, 16), j), 4096) = int_div(int_sub(S, 16), 4096) by simp(hs, h16, m2, hj, hj8)
  show by taut(e, d)
qed

// (the page of S - 16: S's, or the one below; S's page holds S + 7)
theorem tr.push_pages: all S. S in bits(64) -> int_le(16, S) -> int_lt(S, 140737488355328) -> int_mod(bits_add(64, S, 8), 16) = 0 ->
  int_le(int_div(int_sub(S, 16), 4096), int_div(S, 4096)) && int_le(int_div(S, 4096), int_add(int_div(int_sub(S, 16), 4096), 1)) &&
  int_div(int_sub(bits_add(64, S, 8), 1), 4096) = int_div(S, 4096) && bits_add(64, S, 8) = int_add(S, 8)
proof
  fix S
  assume hs h16 hl ha
  have m1: int_mod(int_add(S, 8), 16) = 0 by simp(hs, ha, hl)
  have m2: int_le(8, int_mod(S, 4096)) && int_le(int_mod(S, 4096), 4088) by simp(hs, m1)
  have e8: bits_add(64, S, 8) = int_add(S, 8) by simp(hs, hl)
  have d1: int_le(int_div(int_sub(S, 16), 4096), int_div(S, 4096)) by simp(hs, h16)
  have d2: int_le(int_div(S, 4096), int_add(int_div(int_sub(S, 16), 4096), 1)) by simp(hs, h16, m2)
  have d3: int_div(int_sub(int_add(S, 8), 1), 4096) = int_div(S, 4096) by simp(hs, m2)
  show by simp(e8, d1, d2, d3)
qed

// the pushed bytes, at a fault for want of a mapping (the page of S - 16
// unmapped, S's a stack page): where the stack could not grow, rsp S - 8
theorem tr.push_overflow: all xv S j. S in bits(64) -> int_le(16, S) -> int_lt(S, 140737488355328) -> int_mod(bits_add(64, S, 8), 16) = 0 ->
  abi.stack_page(xv, int_div(S, 4096)) -> !x86_64_linux.mapped(xv, int_div(int_sub(S, 16), 4096)) -> j in omega -> int_lt(j, 8) ->
  abi.overflow_at(xv, int_sub(S, 8), bits_add(64, S, 8), int_add(int_sub(S, 16), j))
proof
  fix xv S j
  assume hs h16 hl ha hsp hnm hj hj8
  have _ pa2 := apply(tr.push_at, {S}, {j}, hs, h16, hl, ha, hj, hj8)
  have _ pp2 _ pp4 := apply(tr.push_pages, {S}, hs, h16, hl, ha)
  have so: S in omega by simp(hs)
  have p0: int_div(S, 4096) in omega by simp(so)
  have m1: int_mod(int_add(S, 8), 16) = 0 by simp(hs, ha, hl)
  have m2: int_le(8, int_mod(S, 4096)) && int_le(int_mod(S, 4096), 4088) by simp(hs, m1)
  have r8: int_div(int_sub(S, 8), 4096) = int_div(S, 4096) by simp(hs, m2, h16)
  have gp: all p. p in omega -> int_le(int_div(int_add(int_sub(S, 16), j), 4096), p) && int_le(p, int_div(int_sub(S, 8), 4096)) ->
      abi.stack_page(xv, p) || !x86_64_linux.mapped(xv, p) proof
    fix p
    assume hp h12
    have h1 h2 := h12
    have c1: p = int_div(S, 4096) -> abi.stack_page(xv, p) || !x86_64_linux.mapped(xv, p) proof
      assume e
      have r := rewrite(sym(e), hsp)
      show by taut(r)
    qed
    have c2: !(p = int_div(S, 4096)) -> abi.stack_page(xv, p) || !x86_64_linux.mapped(xv, p) proof
      assume ne
      have h2b := rewrite(r8, h2)
      have h1b := rewrite(pa2, h1)
      have pl: p = int_div(int_sub(S, 16), 4096) by arith(h2b, h1b, ne, pp2, hp, p0)
      have n := rewrite(sym(pl), hnm)
      show by taut(n)
    qed
    show by taut(c1, c2)
  qed
  have lt1: int_lt(int_add(int_sub(S, 16), j), int_add(S, 8)) by arith(hj8)
  have lt0 := rewrite(sym(pp4), lt1)
  show by defs(taut(lt0, gp), abi.overflow_at, x86_64_linux.PAGE)
qed

// (an access allowed or not: its page's entry only)
theorem tr.access_page: all v1 v2 a b k. x86_64_linux.page_of(a) = x86_64_linux.page_of(b) ->
  app(app(v1, "pages"), x86_64_linux.page_of(a)) = app(app(v2, "pages"), x86_64_linux.page_of(b)) ->
  (x86_64_linux.can_access(v1, a, k) <-> x86_64_linux.can_access(v2, b, k))
proof
  fix v1 v2 a b k
  assume hp he
  have he2 := rewrite(hp, he)
  show by defs(simp(hp, he2, keep(x86_64_linux.page_of)), x86_64_linux.can_access, x86_64_linux.mapped)
qed

// the call overflowing the stack first: the function overflows, with the
// world's I/O
theorem tr.call_ovf(g, args, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all w os.
  w in abi.World -> w in univ(1) -> app(app(w, "os"), "events") = app(os, "events") ->
  runs(mkprog(x0 x1. ex x8. xx(w, exc_val("stack_overflow", empty), x8) && k(x8, x1)), w, exc(w, exc_val("stack_overflow", empty))) ->
  tr.ovf(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, os)
proof
  fix w os
  assume hW hw hev hk
  have ou: exc_val("stack_overflow", empty) in univ(1) by defs(simp(), exc_val)
  have c1 := apply(gc.call1_ovf, {g}, {args}, {w}, hw)
  have pe := apply(tr.call_exc[g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)],
    {w}, {w}, {exc_val("stack_overflow", empty)}, hw, hw, ou, c1, hk)
  have wa := apply(tr.world_and, hW)
  have ot := mp(mp(exc_outcome_type[s := rec_and(abi.World, single(empty)), v := cart(bits(64), bits(64)), x := w, e := exc_val("stack_overflow", empty)], wa), ou)
  have it1 := apply(tr.ite_f, {fst(exc(w, exc_val("stack_overflow", empty))) = 0}, {app(app(fst(snd(exc(w, exc_val("stack_overflow", empty)))), "os"), "events") = app(os, "events")},
    {ite(fst(exc(w, exc_val("stack_overflow", empty))) = 1, snd(snd(exc(w, exc_val("stack_overflow", empty)))) = exc_val("stack_overflow", empty) &&
      app(app(fst(snd(exc(w, exc_val("stack_overflow", empty)))), "os"), "events") = app(os, "events"), app(snd(exc(w, exc_val("stack_overflow", empty))), "os.events") = app(os, "events"))}, simp())
  have it2 := apply(tr.ite_t, {fst(exc(w, exc_val("stack_overflow", empty))) = 1}, {snd(snd(exc(w, exc_val("stack_overflow", empty)))) = exc_val("stack_overflow", empty) &&
      app(app(fst(snd(exc(w, exc_val("stack_overflow", empty)))), "os"), "events") = app(os, "events")}, {app(snd(exc(w, exc_val("stack_overflow", empty))), "os.events") = app(os, "events")}, simp())
  have cc: snd(snd(exc(w, exc_val("stack_overflow", empty)))) = exc_val("stack_overflow", empty) &&
      app(app(fst(snd(exc(w, exc_val("stack_overflow", empty)))), "os"), "events") = app(os, "events") by simp(hev)
  have iv := rewrite(sym(trans(it1, it2)), cc)
  show by defs(ex_intro({exc(w, exc_val("stack_overflow", empty))}, taut(ot, pe, iv)), tr.ovf)
qed

// (the coupling at a call from a frame of 8 bytes: its parts)
theorem tr.inv_call: all s base code m w. tr.inv(s, base, code, 8, m, w) ->
  sM: s in x86_64_linux.Machine && mM: m in x86_64_linux.Machine && mu: m in univ(1) && wW: w in abi.World && wu: w in univ(1) &&
  wst: (all p. abi.stack_page(app(s, "vm"), p) -> app(app(app(w, "vm"), "pages"), p) = app(app(app(s, "vm"), "pages"), p)) && wcpu: app(w, "cpu") = app(s, "cpu") && mos: app(m, "os") = app(w, "os") && mfs: app(m, "fs_base") = app(w, "fs_base") &&
  er4: app(app(m, "gpr"), 4) = int_sub(app(app(s, "gpr"), 4), 8) && sb: app(app(s, "gpr"), 4) in bits(64) && slt: int_lt(app(app(s, "gpr"), 4), 140737488355328) &&
  sal: int_mod(bits_add(64, app(app(s, "gpr"), 4), 8), 16) = 0 && hsps: abi.stack_page(app(s, "vm"), int_div(app(app(s, "gpr"), 4), 4096)) &&
  sgf: abi.stack_gap_free(app(s, "vm")) && winp: app(app(w, "os"), "input") = app(app(s, "os"), "input") &&
  sws: subset(app(app(s, "os"), "events"), app(app(w, "os"), "events")) && mcpu: app(m, "cpu") = app(s, "cpu") && mgs: app(m, "gs_base") = app(s, "gs_base") &&
  mdf: !app(app(m, "flags"), "df")
proof
  fix s base code m w
  assume hi
  have {sM, mM, mu, wW, wu, wst, wcpu, mos, mfs, rspm, slt, sal, hsps, sgf, winp, sws, mcpu, mgs, mdf} := hi
  have sb := apply(x86i.rsp_typed, sM)
  show := conj(sM, mM, mu, wW, wu, wst, wcpu, mos, mfs, rspm, sb, slt, sal, hsps, sgf, winp, sws, mcpu, mgs, mdf)
qed

// ----------------------------------------------------------------------
//  GIMPLE's call when the callee runs

// (worlds: their fields only, and with a memory, an os, a thread pointer put in)
theorem tr.world_keys: all w. w in abi.World -> restrict(w, abi.WKEYS) = w && ghost_part(w, abi.WKEYS) = empty
proof
  fix w
  assume hw
  have kf := apply(pow_cart_fst, unsel(expand(hw, abi.World)))
  have r := apply(restrict_all, kf)
  have g := apply(ghost_part_none, kf)
  show by taut(r, g)
qed

theorem tr.world_set: all w v os fs. w in abi.World -> w in univ(1) -> v in x86_64_linux.Vm -> v in univ(1) ->
  os in x86_64_linux.Os -> os in univ(1) -> fs in bits(64) ->
  fn_update(fn_update(fn_update(w, "vm", v), "os", os), "fs_base", fs) in abi.World && fn_update(fn_update(fn_update(w, "vm", v), "os", os), "fs_base", fs) in univ(1) &&
  fn_update(w, "vm", v) in abi.World && fn_update(w, "vm", v) in univ(1)
proof
  fix w v os fs
  assume hw hu hv hvu ho hou hf
  have wf := expand(hw, abi.World)
  have r1: fn_update(fn_update(fn_update(w, "vm", v), "os", os), "fs_base", fs) in abi.World by defs(simp(wf, hu, hv, hvu, ho, hou, hf), abi.World)
  have r2: fn_update(fn_update(fn_update(w, "vm", v), "os", os), "fs_base", fs) in univ(1) by simp(hu, hvu, hou, hf)
  have r3: fn_update(w, "vm", v) in abi.World by defs(simp(wf, hu, hv, hvu), abi.World)
  have r4: fn_update(w, "vm", v) in univ(1) by simp(hu, hvu)
  show by taut(r1, r2, r3, r4)
qed

// (a World with an empty ghost part: a World)
theorem tr.and_world: all x. x in rec_and(abi.World, single(empty)) -> x in abi.World
proof
  fix x
  assume h
  obtain x0 y0, x0w y0e xe from mp(rec_and_elim[a := abi.World, b := single(empty), s := x], h)
  have ye: y0 = empty := mp(single_elim[a := empty, z := y0], y0e)
  have xe1 := rewrite(ye, xe)
  have xe2 := trans(xe1, union2_empty[a := x0])
  show := rewrite(sym(xe2), x0w)
qed

// the spec's rest diverging: the function diverging
theorem tr.qs_div(op, t, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k): all w. runs(op, w, diverge(t)) ->
  (all o. runs(mkprog(x0 x1. ex x8. dd(t, x8) && k(x8, x1)), w, o) ->
    runs(mkprog(x0 x1. ex x8. bind_rel(op, x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), w, o))
proof
  fix w
  assume hq
  have g: all o. (ex x8. dd(t, x8) && k(x8, o)) -> (ex x8. bind_rel(op, w, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, o)) proof
    fix o
    assume h
    obtain y, hy from h
    have dy := hy.1
    have e1: ex o2. runs(op, w, o2) && ((ex s1 v. o2 = ok(s1, v) && a(s1, v, y)) || (ex s1 e2. o2 = exc(s1, e2) && xx(s1, e2, y)) || (ex t2. o2 = diverge(t2) && dd(t2, y)))
      by ex_intro({diverge(t)}, simp(hq, dy))
    have b: bind_rel(op, w, x9 x10. a(x9, x10, y), x9 x10. xx(x9, x10, y), x9. dd(x9, y)) by defs(e1, bind_rel)
    show by ex_intro({y}, taut(b, hy))
  qed
  show := mp(tr.mkprog_mono[s := w, r1 := x0 x1. ex x8. bind_rel(op, x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1),
    r2 := x0 x1. ex x8. dd(t, x8) && k(x8, x1)], g)
qed

theorem tr.p_div(q, x3 x4 x2. kw): all w t. w in univ(1) -> t in univ(1) -> runs(q, w, diverge(t)) ->
  runs(mkprog(x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, diverge(t))
proof
  fix w t
  assume hw ht hr
  have b0: ex o2. runs(q, w, o2) && ((ex s1 v. o2 = ok(s1, v) && kw(s1, v, diverge(t))) || (ex s1 e1. o2 = exc(s1, e1) && diverge(t) = exc(s1, e1)) ||
    (ex t2. o2 = diverge(t2) && diverge(t) = diverge(t2))) by ex_intro({diverge(t)}, simp(hr))
  have b: bind_rel(q, w, x3 x4. kw(x3, x4, diverge(t)), x3 x4. diverge(t) = exc(x3, x4), x3. diverge(t) = diverge(x3)) by defs(b0, bind_rel)
  have pu: pair(w, diverge(t)) in univ(1) by simp(hw, ht)
  show := mp(all_elim(tr.runs_intro[r := x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))], {w}, {diverge(t)}), pu, b)
qed

// ... at a call: the call diverging
theorem tr.call_div(g, args, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all w t. w in univ(1) -> t in univ(1) ->
  runs(gimple.call1(g, args), w, diverge(t)) -> runs(mkprog(x0 x1. ex x8. dd(t, x8) && k(x8, x1)), w, diverge(t)) ->
  runs(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, diverge(t))
proof
  fix w t
  assume hw ht hc hk
  have q := mp(all_elim(mp(all_elim(tr.qs_div[op := gimple.call1(g, args), t := t, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1)], {w}), hc), {diverge(t)}), hk)
  show := apply(tr.p_div[q := mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), kw := x3 x4 x2. kw(x3, x4, x2)],
    {w}, {t}, hw, ht, q)
qed

// the function's rest from the procedure's rest
theorem tr.p_red(q, q2, x3 x4 x2. kw): all w w2. w in univ(1) -> (all o. runs(q2, w2, o) -> runs(q, w, o)) ->
  (all o. runs(mkprog(x1 x2. bind_rel(q2, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w2, o) ->
    runs(mkprog(x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, o))
proof
  fix w w2
  assume hw hq
  fix o
  assume h0
  have hu: pair(w2, o) in univ(1) && bind_rel(q2, w2, x3 x4. kw(x3, x4, o), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) by simp(expand(expand(h0, runs), mkprog))
  have pu: pair(w, o) in univ(1) by simp(hu, hw)
  obtain o2, ho2 from expand(hu.2, bind_rel)
  have r := mp(all_elim(hq, {o2}), ho2.1)
  have b0: ex o3. runs(q, w, o3) && ((ex s1 v. o3 = ok(s1, v) && kw(s1, v, o)) || (ex s1 e1. o3 = exc(s1, e1) && o = exc(s1, e1)) ||
    (ex t2. o3 = diverge(t2) && o = diverge(t2))) by ex_intro({o2}, taut(r, ho2))
  have b: bind_rel(q, w, x3 x4. kw(x3, x4, o), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) by defs(b0, bind_rel)
  show := mp(all_elim(tr.runs_intro[r := x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))], {w}, {o}), pu, b)
qed

// ----------------------------------------------------------------------
//  The push done: the callee's entry state C

// (a machine with a memory, rsp and rip put in: a machine)
theorem tr.mach_push: all m1 nv r T. m1 in x86_64_linux.Machine -> m1 in univ(1) -> nv in x86_64_linux.Vm -> nv in univ(1) -> r in bits(64) -> T in bits(64) ->
  fn_update(fn_update(fn_update(m1, "vm", nv), "gpr", fn_update(app(m1, "gpr"), 4, r)), "rip", T) in x86_64_linux.Machine &&
  fn_update(fn_update(fn_update(m1, "vm", nv), "gpr", fn_update(app(m1, "gpr"), 4, r)), "rip", T) in univ(1)
proof
  fix m1 nv r T
  assume hM hu hv hvu hr ht
  have _ gt _ _ := apply(x86i.parts, hM)
  have g4 := apply(x86.space_upd, {x86_64_linux.Reg}, {bits(64)}, {app(m1, "gpr")}, {4}, {r}, gt, simp(), hr)
  have gu := mp(app_univ[u := 1, f := m1, k := "gpr"], hu)
  have a: fn_update(fn_update(fn_update(m1, "vm", nv), "gpr", fn_update(app(m1, "gpr"), 4, r)), "rip", T) in x86_64_linux.Machine
    by defs(simp(expand(hM, x86_64_linux.Machine), hu, hv, hvu, g4, gu, hr, ht), x86_64_linux.Machine)
  have b: fn_update(fn_update(fn_update(m1, "vm", nv), "gpr", fn_update(app(m1, "gpr"), 4, r)), "rip", T) in univ(1) by simp(hu, hvu, gu, hr, ht)
  show by taut(a, b)
qed

// (a page mapped before the stack grew: its entry kept)
theorem tr.pages_eq_mapped: all v0 v1 l r p. x86.pages_in(v0, v1, l, r) -> p in omega -> x86_64_linux.mapped(v0, p) ->
  app(app(v1, "pages"), p) = app(app(v0, "pages"), p)
proof
  fix v0 v1 l r p
  assume h hp hm
  have a := mp(all_elim(expand(h, x86.pages_in), {p}), hp)
  have mm := expand(hm, x86_64_linux.mapped)
  show by taut(a, mm)
qed

theorem tr.push_ok: all s base code m w RA T m1 e1 C. tr.inv(s, base, code, 8, m, w) -> int_le(16, app(app(s, "gpr"), 4)) ->
  RA in bits(64) -> T in bits(64) ->
  runs(x86_64_linux.touch_range(bits_sub(64, app(app(m, "gpr"), 4), 8), 8, 1), fn_update(m, "rip", RA), ok(m1, e1)) ->
  C = fn_update(fn_update(fn_update(m1, "vm", fn_update(app(m1, "vm"), "bytes", x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), bits_sub(64, app(app(m, "gpr"), 4), 8), 8, RA))),
    "gpr", fn_update(app(m1, "gpr"), 4, bits_sub(64, app(app(m, "gpr"), 4), 8))), "rip", T) ->
  C in x86_64_linux.Machine && C in univ(1) &&
  app(C, "os") = app(m, "os") && app(C, "fs_base") = app(m, "fs_base") && app(C, "cpu") = app(m, "cpu") && app(C, "gs_base") = app(m, "gs_base") &&
  app(C, "flags") = app(m, "flags") && app(C, "gpr") = fn_update(app(m, "gpr"), 4, int_sub(app(app(s, "gpr"), 4), 16)) && app(C, "rip") = T &&
  tr.keeps_code(app(m, "vm"), app(C, "vm")) && x86.vm_fields(app(m, "vm"), app(C, "vm")) &&
  x86_64_linux.le(app(app(C, "vm"), "bytes"), int_sub(app(app(s, "gpr"), 4), 16), 8) = RA &&
  x86.pages_in(app(m, "vm"), app(C, "vm"), int_div(int_sub(app(app(s, "gpr"), 4), 16), 4096), int_div(app(app(s, "gpr"), 4), 4096)) &&
  (all a. a in bits(64) -> !(int_le(int_sub(app(app(s, "gpr"), 4), 16), a) && int_lt(a, int_sub(app(app(s, "gpr"), 4), 8))) ->
    x86_64_linux.mapped(app(m, "vm"), x86_64_linux.page_of(a)) -> app(app(app(C, "vm"), "bytes"), a) = app(app(app(m, "vm"), "bytes"), a))
proof
  fix s base code m w RA T m1 e1 C
  assume hi h16 hra ht htr hC
  let S := app(app(s, "gpr"), 4)
  let M2 := fn_update(m, "rip", RA)
  let PA := int_sub(S, 16)
  let L := int_div(int_sub(S, 16), 4096)
  let P0 := int_div(S, 4096)
  have {mM, mu, er4, sb, slt, sal, hsps} := apply(tr.inv_call, hi)
  have so: S in omega by simp(sb)
  have bs: bits_sub(64, app(app(m, "gpr"), 4), 8) = PA by defs(simp(er4, sb, h16, slt), bits_sub)
  have htr2 := rewrite(bs, htr)
  have hC2 := rewrite(bs, hC)
  have pab: PA in bits(64) by simp(sb, h16)
  have m2M: M2 in x86_64_linux.Machine by defs(simp(expand(mM, x86_64_linux.Machine), mu, hra), x86_64_linux.Machine)
  have m2u: M2 in univ(1) by simp(mu, hra)
  // (the pushed bytes: on page L, at most S's page P0, which is mapped)
  have lp _ _ _ := apply(tr.push_pages, {S}, sb, h16, slt, sal)
  have rb: x86.range_below(PA, 8, L, P0) proof
    have g: all j. j in omega -> int_lt(j, 8) ->
        int_le(L, x86_64_linux.page_of(bits_add(64, PA, bits_of_int(64, j)))) && int_le(x86_64_linux.page_of(bits_add(64, PA, bits_of_int(64, j))), P0) proof
      fix j
      assume hj hj8
      have pa1 pa2 := apply(tr.push_at, {S}, {j}, sb, h16, slt, sal, hj, hj8)
      have bs2: bits_sub(64, int_sub(S, 8), 8) = PA by defs(simp(sb, h16, slt), bits_sub)
      have pa3 := rewrite(bs2, pa1)
      have pg: x86_64_linux.page_of(bits_add(64, PA, bits_of_int(64, j))) = L by defs(simp(pa3, pa2), x86_64_linux.page_of, x86_64_linux.PAGE)
      show by simp(pg, lp, keep(x86_64_linux.page_of))
    qed
    show by defs(g, x86.range_below)
  qed
  have kpt: tr.kept(app(s, "vm"), app(m, "vm"), S) by simp(expand(hi, tr.inv), keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, abi.stack_gap_free, x86_64_linux.can_access, tr.kept, tr.keeps_code))
  have kr := mp(all_elim(expand(kpt, tr.kept), {S}), so, arith(so), arith(so))
  have kr2: app(app(app(m, "vm"), "pages"), P0) = app(app(app(s, "vm"), "pages"), P0) by defs(kr, x86_64_linux.page_of, x86_64_linux.PAGE)
  have mp0: x86_64_linux.mapped(app(M2, "vm"), P0) by defs(simp(kr2, expand(hsps, abi.stack_page, x86_64_linux.mapped)), x86_64_linux.mapped)
  have p0o: P0 in omega by simp(so)
  have pin := apply(x86.touch_range_ok_pages, {M2}, {PA}, {8}, {1}, {L}, {P0}, {m1}, {e1}, p0o, mp0, rb, htr2)
  // (m1: M2 grown, typed, its fields)
  have m1M m1u := apply(x86.touch_range_typed, {M2}, {PA}, {8}, {1}, {m1}, {e1}, m2M, m2u, htr2)
  have tv := apply(x86.touch_range_vm, {M2}, {PA}, {8}, {1}, {m1}, {e1}, htr2)
  have gr := apply(x86.touch_range_frame, {M2}, {PA}, {8}, {1}, {m1}, {e1}, simp(), htr2)
  have fl := apply(x86.touch_range_fields, {M2}, {PA}, {8}, {1}, {m1}, {e1}, htr2)
  have mf: app(m1, "os") = app(m, "os") && app(m1, "fs_base") = app(m, "fs_base") && app(m1, "cpu") = app(m, "cpu") && app(m1, "gs_base") = app(m, "gs_base") &&
    app(m1, "flags") = app(m, "flags") && app(m1, "gpr") = app(m, "gpr") && app(m1, "rip") = RA by simp(tv)
  have v1: app(m1, "vm") in x86_64_linux.Vm := apply(x86i.parts, m1M).4
  have b1: app(app(m1, "vm"), "bytes") in fn_space(bits(64), bits(8)) by simp(v1)
  // C: typed
  have su := apply(g.store_univ, {app(m1, "vm")}, {PA}, {8}, {RA}, v1)
  have v1u := mp(app_univ[u := 1, f := m1, k := "vm"], m1u)
  have nu: fn_update(app(m1, "vm"), "bytes", x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), PA, 8, RA)) in univ(1) by simp(v1u, su)
  have nv := apply(x86.store_vm, {app(m1, "vm")}, {PA}, {8}, {RA}, v1, nu)
  have mpu := apply(tr.mach_push, {m1}, {fn_update(app(m1, "vm"), "bytes", x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), PA, 8, RA))}, {PA}, {T}, m1M, m1u, nv, nu, pab, ht)
  have cM cu := rewrite(sym(hC2), mpu)
  have cf: app(C, "os") = app(m, "os") && app(C, "fs_base") = app(m, "fs_base") && app(C, "cpu") = app(m, "cpu") && app(C, "gs_base") = app(m, "gs_base") &&
    app(C, "flags") = app(m, "flags") && app(C, "gpr") = fn_update(app(m, "gpr"), 4, PA) && app(C, "rip") = T by simp(hC2, mf)
  have cvm: app(C, "vm") = fn_update(app(m1, "vm"), "bytes", x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), PA, 8, RA)) by simp(hC2)
  // its memory: fields, pages, the return address, the other bytes
  have cfl: x86.vm_fields(app(m, "vm"), app(C, "vm")) by defs(simp(cvm, expand(fl, x86.vm_fields)), x86.vm_fields)
  have cpi: x86.pages_in(app(m, "vm"), app(C, "vm"), L, P0) by defs(simp(cvm, expand(pin, x86.pages_in)), x86.pages_in)
  have rao: RA in omega by simp(hra)
  have ls := apply(tr.le_store8, {app(app(m1, "vm"), "bytes")}, {PA}, {RA}, b1, pab, rao)
  have cle: x86_64_linux.le(app(app(C, "vm"), "bytes"), PA, 8) = RA by simp(cvm, ls, hra)
  have cby: all a. a in bits(64) -> !(int_le(PA, a) && int_lt(a, int_sub(S, 8))) -> x86_64_linux.mapped(app(m, "vm"), x86_64_linux.page_of(a)) ->
      app(app(app(C, "vm"), "bytes"), a) = app(app(app(m, "vm"), "bytes"), a) proof
    fix a
    assume ha hn hm
    have ne: all i. i in omega -> int_lt(i, 8) -> !(bits_add(64, PA, bits_of_int(64, i)) = a) proof
      fix i
      assume hi0 hi8
      have pa1 _ := apply(tr.push_at, {S}, {i}, sb, h16, slt, sal, hi0, hi8)
      have bs2: bits_sub(64, int_sub(S, 8), 8) = PA by defs(simp(sb, h16, slt), bits_sub)
      have pa3 := rewrite(bs2, pa1)
      have ao: a in omega by simp(ha)
      have nq: !(int_add(int_sub(S, 16), i) = a) by arith(hn, hi0, hi8, so, ao)
      show := rewrite(sym(pa3), nq)
    qed
    have so2 := apply(x86.store_outside, {app(app(m1, "vm"), "bytes")}, {PA}, {8}, {RA}, {a}, ha, ne)
    have gb: all x0. x0 in bits(64) -> x86_64_linux.mapped(app(M2, "vm"), x86_64_linux.page_of(x0)) -> app(app(app(m1, "vm"), "bytes"), x0) = app(app(app(M2, "vm"), "bytes"), x0)
      := expand(gr, abi.vm_grows).2
    have gg := mp(all_elim(gb, {a}), ha, simp(hm))
    show by simp(cvm, so2, gg)
  qed
  // the code: kept by the push (its bytes writable or newly mapped stack)
  have kc: tr.keeps_code(app(m, "vm"), app(C, "vm")) proof
    have g: all gb gc st. gb in omega -> abi.loaded(app(m, "vm"), gb, gc, st) -> abi.loaded(app(C, "vm"), gb, gc, st) proof
      fix gb gc st
      assume hb hl
      have lc: abi.code_at(app(M2, "vm"), gb, gc) by simp(expand(hl, abi.loaded), keep(abi.code_at))
      have sc := all_elim(apply(x86.store_code, {gb}, {gc}, {M2}, {PA}, {8}, {m1}, {e1}, simp(), hb, htr2, lc), {RA})
      have cc: abi.code_at(app(C, "vm"), gb, gc) := rewrite(sym(cvm), sc)
      have stt: all x. x in omega -> x in st -> x86_64_linux.mapped(app(C, "vm"), int_div(x, x86_64_linux.PAGE)) && !abi.stack_page(app(C, "vm"), int_div(x, x86_64_linux.PAGE)) proof
        fix x
        assume hx hs
        have l0 := mp(all_elim(expand(hl, abi.loaded).2, {x}), hx, hs)
        have po: int_div(x, x86_64_linux.PAGE) in omega by defs(simp(hx), x86_64_linux.PAGE)
        have pe := apply(tr.pages_eq_mapped, {app(m, "vm")}, {app(C, "vm")}, {L}, {P0}, {int_div(x, x86_64_linux.PAGE)}, cpi, po, l0.1)
        show by defs(simp(pe, expand(l0, abi.stack_page, x86_64_linux.mapped), keep(x86_64_linux.PAGE)), abi.stack_page, x86_64_linux.mapped)
      qed
      show by defs(taut(cc, stt), abi.loaded)
    qed
    show by defs(g, tr.keeps_code)
  qed
  show by taut(cM, cu, cf, kc, cfl, cle, cpi, cby)
qed

// a disciplined run returns only at its return point
theorem tr.run_d_ok: all s m x e. tr.run_d(s, m, ok(x, e)) -> tr.at_ret(s, x)
proof
  fix s m x e
  assume h
  obtain r, hw hm from expand(h, tr.run_d)
  have wi := mp(mp(mp(while_inv[l0 := pair(m, empty), c := l. true, b := l o. tr.rbd(s, l, o),
    tr := l. fn_update(empty, "os.events", app(app(fst(l), "os"), "events")), r := r, p := l. true], simp()), simp()), expand(hw, tr.rwd))
  have nd: !(ex t. r = diverge(t)) proof
    have g: (ex t. r = diverge(t)) -> false proof
      assume ed
      obtain t, ht from ed
      show by simp(expand(rewrite(ht, hm), tr.rmap))
    qed
    show by taut(g)
  qed
  have el: ex l. true && ((!true && r = ok(l, empty)) || (true && tr.rbd(s, l, r) && !is_ok(r))) by taut(wi, nd)
  obtain l, hl from el
  have hb: tr.rbd(s, l, r) by taut(hl)
  have nk: !is_ok(r) by taut(hl)
  have rr := expand(hm, tr.rmap)
  have c1: tr.disc_ok(s, fst(l)) && tr.rb(s, l, r) -> tr.at_ret(s, x) proof
    assume hd
    have b1: (!tr.at_ret(s, fst(l)) && bind_rel(x86_64_linux.step, fst(l), x7 x8. r = ok(pair(x7, empty), empty), x7 x8. r = exc(pair(x7, empty), pair("raise", x8)), x7. r = diverge(x7))) ->
        tr.at_ret(s, x) proof
      assume hb1
      obtain o2, ho2 from expand(hb1.2, bind_rel)
      have k1: (ex s1 v1. o2 = ok(s1, v1) && r = ok(pair(s1, empty), empty)) -> tr.at_ret(s, x) proof
        assume ek
        obtain s1 v1, _ re from ek
        show by simp(expand(rewrite(re, nk), is_ok))
      qed
      have k2: (ex s1 e1. o2 = exc(s1, e1) && r = exc(pair(s1, empty), pair("raise", e1))) -> tr.at_ret(s, x) proof
        assume ek
        obtain s1 e1, _ re from ek
        show by simp(expand(rewrite(re, hm), tr.rmap))
      qed
      have k3: (ex t. o2 = diverge(t) && r = diverge(t)) -> tr.at_ret(s, x) proof
        assume ek
        obtain t, _ re from ek
        show by simp(expand(rewrite(re, hm), tr.rmap))
      qed
      show by taut(ho2, k1, k2, k3)
    qed
    have b2: (!!tr.at_ret(s, fst(l)) && r = exc(pair(fst(l), empty), pair("brk", empty))) -> tr.at_ret(s, x) proof
      assume hb2
      have nar re := hb2
      have xe: x = fst(l) by simp(expand(rewrite(re, hm), tr.rmap))
      have ar: tr.at_ret(s, fst(l)) by taut(nar)
      show := rewrite(sym(xe), ar)
    qed
    show by taut(expand(hd.2, tr.rb), b1, b2)
  qed
  have c2: !tr.disc_ok(s, fst(l)) && r = exc(l, pair("raise", exc_val("disc", empty))) -> tr.at_ret(s, x) proof
    assume hd
    show by simp(expand(rewrite(hd.2, hm), tr.rmap))
  qed
  show by taut(expand(hb, tr.rbd), c1, c2)
qed

// ----------------------------------------------------------------------
//  After the callee: the loaded code, the return address

// (code at the same pages and bytes: loaded still)
theorem tr.code_at_tr: all v1 v2 gb gc. abi.code_at(v1, gb, gc) ->
  (all i. i in omega -> int_lt(i, seq_len(gc)) ->
    app(app(v2, "pages"), x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))) = app(app(v1, "pages"), x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))) &&
    app(app(v2, "bytes"), bits_of_int(64, int_add(gb, i))) = app(app(v1, "bytes"), bits_of_int(64, int_add(gb, i)))) ->
  abi.code_at(v2, gb, gc)
proof
  fix v1 v2 gb gc
  assume hc he
  have cc := expand(hc, abi.code_at)
  have r: all i. i in omega -> int_lt(i, seq_len(gc)) ->
      ((x86_64_linux.fetchable(v2, bits_of_int(64, int_add(gb, i))) && !x86_64_linux.can_access(v2, bits_of_int(64, int_add(gb, i)), 1)) &&
        !abi.stack_page(v2, x86_64_linux.page_of(bits_of_int(64, int_add(gb, i))))) &&
      app(app(v2, "bytes"), bits_of_int(64, int_add(gb, i))) = app(gc, i) proof
    fix i
    assume hi hl
    have f1 _ s1 b1 := mp(all_elim(cc, {i}), hi, hl)
    have pe be := mp(all_elim(he, {i}), hi, hl)
    have ac := apply(tr.access_page, {v2}, {v1}, {bits_of_int(64, int_add(gb, i))}, {bits_of_int(64, int_add(gb, i))}, {1}, refl({x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))}), pe)
    have f2: x86_64_linux.fetchable(v2, bits_of_int(64, int_add(gb, i))) by defs(rewrite(sym(pe), expand(f1, x86_64_linux.fetchable, x86_64_linux.mapped)), x86_64_linux.fetchable, x86_64_linux.mapped)
    have s2: !abi.stack_page(v2, x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))) by defs(rewrite(sym(pe), expand(s1, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
    have ci := mp(all_elim(cc, {i}), hi, hl)
    have b2 := trans(be, b1)
    show by taut(ci, ac, f2, s2, b2)
  qed
  show by defs(r, abi.code_at)
qed

// (a code byte: on a mapped, non-stack page)
theorem tr.code_page: all vm gb gc i. abi.code_at(vm, gb, gc) -> i in omega -> int_lt(i, seq_len(gc)) ->
  x86_64_linux.mapped(vm, x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))) && !abi.stack_page(vm, x86_64_linux.page_of(bits_of_int(64, int_add(gb, i))))
proof
  fix vm gb gc i
  assume hc hi hl
  have f _ ns _ := mp(all_elim(expand(hc, abi.code_at), {i}), hi, hl)
  have m: x86_64_linux.mapped(vm, x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))) by taut(expand(f, x86_64_linux.fetchable))
  show by taut(m, ns)
qed

// (8 bytes the same: so their little-endian read)
theorem tr.le_eq8: all b1 b2 a. (all j. j in omega -> int_lt(j, 8) -> app(b1, bits_add(64, a, bits_of_int(64, j))) = app(b2, bits_add(64, a, bits_of_int(64, j)))) ->
  x86_64_linux.le(b1, a, 8) = x86_64_linux.le(b2, a, 8)
proof
  fix b1 b2 a
  assume h
  have k0 := mp(all_elim(h, {0}), simp(), simp())
  have k1 := mp(all_elim(h, {1}), simp(), simp())
  have k2 := mp(all_elim(h, {2}), simp(), simp())
  have k3 := mp(all_elim(h, {3}), simp(), simp())
  have k4 := mp(all_elim(h, {4}), simp(), simp())
  have k5 := mp(all_elim(h, {5}), simp(), simp())
  have k6 := mp(all_elim(h, {6}), simp(), simp())
  have k7 := mp(all_elim(h, {7}), simp(), simp())
  show by defs(simp(k0, k1, k2, k3, k4, k5, k6, k7), x86_64_linux.le)
qed

// A return keeps the world valid for GIMPLE (C1's bookkeeping, nothing
// function-specific): the input as it was, the events grown, the program
// loaded still
def tr.returns_valid(w, w2) := app(app(w2, "os"), "input") = app(app(w, "os"), "input") && subset(app(app(w, "os"), "events"), app(app(w2, "os"), "events")) &&
  (all gb gc st. gb in omega -> abi.loaded(app(w, "vm"), gb, gc, st) -> abi.loaded(app(w2, "vm"), gb, gc, st))

// the spec is undefined from w: it allows every exception (and so, as
// GIMPLE's undefined behaviour does, every outcome)
def tr.may_raise(g, args, w) := all x e. x in univ(1) -> e in univ(1) -> runs(app(g, args), w, exc(x, e))

// The callee's spec, program-wide: called with at least its n arguments
// (with fewer, a `_fun` wrapper allows any outcome), a return keeps the
// world valid -- or the spec is undefined there (so is its caller's call)
def tr.callee_io(g, n) := all args w w2 r. ord_le(n, seq_len(args)) -> w in abi.World -> runs(app(g, args), w, ok(w2, r)) ->
  tr.returns_valid(w, w2) || tr.may_raise(g, args, w)

// a spec built as GIMPLE's `_fun` wrappers are (a program per argument
// list): typed as the ABI has specs
theorem tr.fun_typed(x0 x1 x2. r): fn_build(abi.ARGS, x0. mkprog(x1 x2. r(x0, x1, x2))) in fn_space(abi.ARGS, powerset(univ(1)))
proof
  have v: all x0. x0 in abi.ARGS -> mkprog(x1 x2. r(x0, x1, x2)) in powerset(univ(1)) proof
    fix x0
    assume _
    have g: all z. z in mkprog(x1 x2. r(x0, x1, x2)) -> z in univ(1) proof
      fix z
      assume hz
      have m := set_select_def[s := univ(1), p := y. ex x1 x2. y = pair(x1, x2) && r(x0, x1, x2), z := z]
      show by taut(m, expand(hz, mkprog))
    qed
    have s: subset(mkprog(x1 x2. r(x0, x1, x2)), univ(1)) by defs(g, subset)
    show by taut(powerset_def[s := univ(1), a := mkprog(x1 x2. r(x0, x1, x2))], s)
  qed
  show := mp(fn_build_space[d := abi.ARGS, v := x0. mkprog(x1 x2. r(x0, x1, x2)), b := powerset(univ(1))], v)
qed

// (the callee's spec typed, as the ABI has specs: its runs in univ(1))
theorem tr.spec_univ: all g args w o. g in fn_space(abi.ARGS, powerset(univ(1))) -> args in abi.ARGS -> runs(app(g, args), w, o) -> pair(w, o) in univ(1)
proof
  fix g args w o
  assume hg ha hr
  have pa := mp(mp(fn_space_app[a := abi.ARGS, b := powerset(univ(1)), f := g, x := args], hg), ha)
  have ss: subset(app(g, args), univ(1)) by taut(powerset_def[s := univ(1), a := app(g, args)], pa)
  show := mp(subset_elim[a := app(g, args), b := univ(1), z := pair(w, o)], ss, expand(hr, runs))
qed

// (an outcome of a type: a return, an exception, a divergence)
theorem tr.outcome_cases: all S V x0. x0 in outcome_type(S, V) ->
  (ex a b. a in S && b in V && x0 = ok(a, b)) || (ex a b. a in S && b in univ(1) && x0 = exc(a, b)) || (ex t. t in univ(1) && x0 = diverge(t))
proof
  fix S V x0
  assume h
  have u1 := union2_iff[a := set_image(cart(S, V), z. ok(fst(z), snd(z))), b := union2(set_image(cart(S, univ(1)), z. exc(fst(z), snd(z))), set_image(univ(1), t. diverge(t))), z := x0]
  have u2 := union2_iff[a := set_image(cart(S, univ(1)), z. exc(fst(z), snd(z))), b := set_image(univ(1), t. diverge(t)), z := x0]
  have s1 := set_image_def[s := cart(S, V), f := z. ok(fst(z), snd(z)), y := x0]
  have s2 := set_image_def[s := cart(S, univ(1)), f := z. exc(fst(z), snd(z)), y := x0]
  have s3 := set_image_def[s := univ(1), f := t. diverge(t), y := x0]
  have hh: x0 in union2(set_image(cart(S, V), z. ok(fst(z), snd(z))), union2(set_image(cart(S, univ(1)), z. exc(fst(z), snd(z))), set_image(univ(1), t. diverge(t)))) by defs(h, outcome_type)
  have c1: (ex z. z in cart(S, V) && ok(fst(z), snd(z)) = x0) -> (ex a b. a in S && b in V && x0 = ok(a, b)) proof
    assume e
    obtain z, hz from e
    obtain a b, hb from mp(cart_elim[a := S, b := V, z := z], hz.1)
    have eq: x0 = ok(a, b) by simp(hz, hb)
    show by ex_intro({a}, {b}, taut(hb, eq))
  qed
  have c2: (ex z. z in cart(S, univ(1)) && exc(fst(z), snd(z)) = x0) -> (ex a b. a in S && b in univ(1) && x0 = exc(a, b)) proof
    assume e
    obtain z, hz from e
    obtain a b, hb from mp(cart_elim[a := S, b := univ(1), z := z], hz.1)
    have eq: x0 = exc(a, b) by simp(hz, hb)
    show by ex_intro({a}, {b}, taut(hb, eq))
  qed
  have c3: (ex t. t in univ(1) && diverge(t) = x0) -> (ex t. t in univ(1) && x0 = diverge(t)) proof
    assume e
    obtain t, ht from e
    have eq: x0 = diverge(t) by simp(ht)
    show by ex_intro({t}, taut(ht, eq))
  qed
  show by taut(hh, u1, u2, s1, s2, s3, c1, c2, c3)
qed

// a crash's I/O: that of the function's overflow (or divergence) from w
theorem tr.ovf_exc: all p w os x. x in rec_and(abi.World, single(empty)) -> runs(p, w, exc(x, exc_val("stack_overflow", empty))) ->
  app(app(x, "os"), "events") = app(os, "events") -> tr.ovf(p, w, os)
proof
  fix p w os x
  assume hx hr hev
  have ou: exc_val("stack_overflow", empty) in univ(1) by defs(simp(), exc_val)
  have ot := mp(mp(exc_outcome_type[s := rec_and(abi.World, single(empty)), v := cart(bits(64), bits(64)), x := x, e := exc_val("stack_overflow", empty)], hx), ou)
  have it1 := apply(tr.ite_f, {fst(exc(x, exc_val("stack_overflow", empty))) = 0}, {app(app(fst(snd(exc(x, exc_val("stack_overflow", empty)))), "os"), "events") = app(os, "events")},
    {ite(fst(exc(x, exc_val("stack_overflow", empty))) = 1, snd(snd(exc(x, exc_val("stack_overflow", empty)))) = exc_val("stack_overflow", empty) &&
      app(app(fst(snd(exc(x, exc_val("stack_overflow", empty)))), "os"), "events") = app(os, "events"), app(snd(exc(x, exc_val("stack_overflow", empty))), "os.events") = app(os, "events"))}, simp())
  have it2 := apply(tr.ite_t, {fst(exc(x, exc_val("stack_overflow", empty))) = 1}, {snd(snd(exc(x, exc_val("stack_overflow", empty)))) = exc_val("stack_overflow", empty) &&
      app(app(fst(snd(exc(x, exc_val("stack_overflow", empty)))), "os"), "events") = app(os, "events")}, {app(snd(exc(x, exc_val("stack_overflow", empty))), "os.events") = app(os, "events")}, simp())
  have cc: snd(snd(exc(x, exc_val("stack_overflow", empty)))) = exc_val("stack_overflow", empty) &&
      app(app(fst(snd(exc(x, exc_val("stack_overflow", empty)))), "os"), "events") = app(os, "events") by simp(hev)
  have iv := rewrite(sym(trans(it1, it2)), cc)
  show by defs(ex_intro({exc(x, exc_val("stack_overflow", empty))}, taut(ot, hr, iv)), tr.ovf)
qed

theorem tr.ovf_div: all p w os t. t in univ(1) -> runs(p, w, diverge(t)) -> app(t, "os.events") = app(os, "events") -> tr.ovf(p, w, os)
proof
  fix p w os t
  assume ht hr hev
  have si := set_image_def[s := univ(1), f := t0. diverge(t0), y := diverge(t)]
  have ex1: ex t0. t0 in univ(1) && diverge(t0) = diverge(t) by ex_intro({t}, taut(ht, refl({diverge(t)})))
  have m3: diverge(t) in set_image(univ(1), t0. diverge(t0)) by taut(si, ex1)
  have u1 := union2_iff[a := set_image(cart(rec_and(abi.World, single(empty)), cart(bits(64), bits(64))), z. ok(fst(z), snd(z))),
    b := union2(set_image(cart(rec_and(abi.World, single(empty)), univ(1)), z. exc(fst(z), snd(z))), set_image(univ(1), t0. diverge(t0))), z := diverge(t)]
  have u2 := union2_iff[a := set_image(cart(rec_and(abi.World, single(empty)), univ(1)), z. exc(fst(z), snd(z))), b := set_image(univ(1), t0. diverge(t0)), z := diverge(t)]
  have ot: diverge(t) in outcome_type(rec_and(abi.World, single(empty)), cart(bits(64), bits(64))) by defs(taut(m3, u1, u2), outcome_type)
  have it1 := apply(tr.ite_f, {fst(diverge(t)) = 0}, {app(app(fst(snd(diverge(t))), "os"), "events") = app(os, "events")},
    {ite(fst(diverge(t)) = 1, snd(snd(diverge(t))) = exc_val("stack_overflow", empty) && app(app(fst(snd(diverge(t))), "os"), "events") = app(os, "events"),
      app(snd(diverge(t)), "os.events") = app(os, "events"))}, simp())
  have it2 := apply(tr.ite_f, {fst(diverge(t)) = 1}, {snd(snd(diverge(t))) = exc_val("stack_overflow", empty) && app(app(fst(snd(diverge(t))), "os"), "events") = app(os, "events")},
    {app(snd(diverge(t)), "os.events") = app(os, "events")}, simp())
  have cc: app(snd(diverge(t)), "os.events") = app(os, "events") by simp(hev)
  have iv := rewrite(sym(trans(it1, it2)), cc)
  show by defs(ex_intro({diverge(t)}, taut(ot, hr, iv)), tr.ovf)
qed

// (subsets: transitive)
theorem tr.subset_trans: all a b c. subset(a, b) -> subset(b, c) -> subset(a, c)
proof
  fix a b c
  assume h1 h2
  have g: all z. z in a -> z in c proof
    fix z
    assume hz
    have zb := mp(subset_elim[a := a, b := b, z := z], h1, hz)
    show := mp(subset_elim[a := b, b := c, z := z], h2, zb)
  qed
  show by defs(g, subset)
qed

// (the spec raising: the claim, whatever the machine does)
theorem tr.sim_ub: all s v p w m. tr.ub(s, v, p, w) -> tr.sim(s, v, p, w, m)
proof
  fix s v p w m
  assume h
  have g: all o. tr.run_d(s, m, o) -> tr.ub(s, v, p, w) || tr.ok(s, v, p, w, o) || tr.crash(s, p, w, o) proof
    fix o
    assume ho
    show by taut(h)
  qed
  show by defs(g, tr.sim)
qed

// ----------------------------------------------------------------------
//  The callee runs: from its entry state C, the caller's claim

// ----------------------------------------------------------------------
//  The rule

// ----------------------------------------------------------------------
//  A caller's contract: its code with its callees'

// (code loaded as two pieces: each loaded at its place)
theorem tr.code_concat: all vm b c1 c2 t. c1 in list_type(t) -> c2 in list_type(t) -> b in omega -> abi.code_at(vm, b, seq_concat(c1, c2)) ->
  abi.code_at(vm, b, c1) && abi.code_at(vm, int_add(b, seq_len(c1)), c2)
proof
  fix vm b c1 c2 t
  assume h1 h2 hb hc
  have cc := expand(hc, abi.code_at)
  have n1: seq_len(c1) in omega by simp(h1)
  have n2: seq_len(c2) in omega by simp(h2)
  have ln: seq_len(seq_concat(c1, c2)) = int_add(seq_len(c1), seq_len(c2)) by arith(h1, h2)
  have g1: all i. i in omega -> int_lt(i, seq_len(c1)) ->
      ((x86_64_linux.fetchable(vm, bits_of_int(64, int_add(b, i))) && !x86_64_linux.can_access(vm, bits_of_int(64, int_add(b, i)), 1)) &&
        !abi.stack_page(vm, x86_64_linux.page_of(bits_of_int(64, int_add(b, i))))) && app(app(vm, "bytes"), bits_of_int(64, int_add(b, i))) = app(c1, i) proof
    fix i
    assume hi hl
    have l2: int_lt(i, seq_len(seq_concat(c1, c2))) by arith(hl, ln, n2, hi)
    have ci := mp(all_elim(cc, {i}), hi, l2)
    have e := at({app(seq_concat(c1, c2), i)}, h1, h2, hi, hl)
    show by simp(ci, e)
  qed
  have g2: all i. i in omega -> int_lt(i, seq_len(c2)) ->
      ((x86_64_linux.fetchable(vm, bits_of_int(64, int_add(int_add(b, seq_len(c1)), i))) && !x86_64_linux.can_access(vm, bits_of_int(64, int_add(int_add(b, seq_len(c1)), i)), 1)) &&
        !abi.stack_page(vm, x86_64_linux.page_of(bits_of_int(64, int_add(int_add(b, seq_len(c1)), i))))) &&
      app(app(vm, "bytes"), bits_of_int(64, int_add(int_add(b, seq_len(c1)), i))) = app(c2, i) proof
    fix i
    assume hi hl
    have jo: int_add(seq_len(c1), i) in omega by simp(n1, hi)
    have l2: int_lt(int_add(seq_len(c1), i), seq_len(seq_concat(c1, c2))) by arith(hl, ln, n1, hi)
    have ci := mp(all_elim(cc, {int_add(seq_len(c1), i)}), jo, l2)
    have e0 := at({app(seq_concat(c1, c2), int_add(seq_len(c1), i))}, h1, h2, hi, hl, n1)
    have k: int_sub(int_add(seq_len(c1), i), seq_len(c1)) = i by arith(hi, n1)
    have e := rewrite(k, e0)
    have ad: int_add(b, int_add(seq_len(c1), i)) = int_add(int_add(b, seq_len(c1)), i) by arith(hb, n1, hi)
    have ci2 := rewrite(ad, ci)
    show by simp(ci2, e)
  qed
  have r1: abi.code_at(vm, b, c1) by defs(g1, abi.code_at)
  have r2: abi.code_at(vm, int_add(b, seq_len(c1)), c2) by defs(g2, abi.code_at)
  show by taut(r1, r2)
qed

// ... and so the program with its statics
theorem tr.loaded_concat: all vm b c1 c2 t st. c1 in list_type(t) -> c2 in list_type(t) -> b in omega -> abi.loaded(vm, b, seq_concat(c1, c2), st) ->
  abi.loaded(vm, b, c1, st) && abi.loaded(vm, int_add(b, seq_len(c1)), c2, st)
proof
  fix vm b c1 c2 t st
  assume h1 h2 hb hl
  have l := expand(hl, abi.loaded)
  have cc := apply(tr.code_concat, {vm}, {b}, {c1}, {c2}, {t}, h1, h2, hb, taut(l))
  show by defs(taut(l, cc), abi.loaded)
qed

// a callee's contract for its own code: for more code loaded too
theorem tr.implements_widen: all f spec b c b2 c2 st. tr.implements_at(f, spec, b, c, st) ->
  (all vm. abi.loaded(vm, b2, c2, st) -> abi.loaded(vm, b, c, st)) -> tr.implements_at(f, spec, b2, c2, st)
proof
  fix f spec b c b2 c2 st
  assume h hw
  have g: all args objs mem s o. args in abi.ARGS -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(app(s, "vm"), b2, c2, st) ->
      app(s, "rip") = f -> abi.entry_ok(s, args) -> tr.objs_ok(s, objs) -> abi.view_ok(s, objs, mem) -> tr.run_d(s, s, o) -> tr.matches_t(spec, args, objs, mem, s, o) proof
    fix args objs mem s o
    assume hA ho hmv hM hu hl hr he hob hvw hd
    have l := mp(all_elim(hw, {app(s, "vm")}), hl)
    show := mp(all_elim(expand(h, tr.implements_at), {args}, {objs}, {mem}, {s}, {o}), hA, ho, hmv, hM, hu, l, hr, he, hob, hvw, hd)
  qed
  show by defs(g, tr.implements_at)
qed

// tr.entry1_32s for a contract whose code lb/lc holds the function's own
// (base/code) -- a caller's, holding its callees' code too
theorem tr.entry1_32s_w(lb, lc, base, code, statics, f, k, len0, z0, a1, len, d, c, z1, z2, a2, x0. q, x3 x4 x2. kw): base in omega ->
  (all vm. abi.loaded(vm, lb, lc, statics) -> abi.code_at(vm, base, code)) ->
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = f ->
    runs(x86_64_linux.exec_body(len0, tag(60, pair(8, pair(5, pair(tag(0, 4), pair(z0, k)))))), m, o)) ->
  a1 = bits_add(64, f, len0) -> k in bits(8) -> int_lt(k, 128) -> int_le(k, 8) ->
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a1 ->
    runs(x86_64_linux.exec_body(len, tag(75, pair(4, pair(7, pair(x86i.rsp_mem(d), pair(z1, z2)))))), m, o)) ->
  a2 = bits_add(64, a1, len) -> d in bits(64) -> c = int_mod(int_sub(d, k), 18446744073709551616) -> c in bits(64) ->
  int_le(18446744073709551608, c) -> int_le(4, int_sub(18446744073709551616, c)) ->
  (all args v mem s. args in abi.ARGS -> v in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> ord_le(1, seq_len(args)) -> abi.view(s, v, mem) in univ(1) ->
    abi.loaded(app(s, "vm"), lb, lc, statics) -> abi.view(s, v, mem) in abi.World ->
    tr.pt(s, v, base, code, k, a2, fn_update(empty, c, pair(4, bits_of_int(32, app(args, 0)))), v, empty,
      mkprog(x1 x2. bind_rel(q(args), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), abi.view(s, v, mem))) ->
  (all args v mem s o. args in abi.ARGS -> v in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(app(s, "vm"), lb, lc, statics) -> app(s, "rip") = f ->
    abi.entry_ok(s, args) -> tr.objs_ok(s, v) -> abi.view_ok(s, v, mem) -> tr.run_d(s, s, o) ->
    tr.matches_t(fn_build(abi.ARGS, x0. mkprog(x1 x2. !ord_le(1, seq_len(x0)) || bind_rel(q(x0), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))), args, v, mem, s, o))
proof
  assume hbase hsub hat0 ha1 hk hkl hk8 hat ha2 hd hcd hcb hd1 hd2 hbody
  have hpro: all args v mem s. args in abi.ARGS -> v in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(app(s, "vm"), lb, lc, statics) -> app(s, "rip") = f ->
      abi.entry_ok(s, args) -> tr.objs_ok(s, v) -> abi.view_ok(s, v, mem) -> ord_le(1, seq_len(args)) ->
      tr.sim(s, v, mkprog(x1 x2. bind_rel(q(args), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), abi.view(s, v, mem), s) proof
    fix args v mem s
    assume hA hvo hmv hM su hl hrip he hob hvw hg
    let BIND := mkprog(x1 x2. bind_rel(q(args), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))
    have hc := mp(all_elim(hsub, {app(s, "vm")}), hl)
    have ent := apply(abi.entry_stack, hM, he)
    have hdf: !app(app(s, "flags"), "df") by taut(expand(he, abi.entry_ok))
    have ou := apply(abi.objs_univ, hvo)
    have mu := apply(x86.vm_univ, hmv)
    have hvu: abi.view(s, v, mem) in univ(1) by simp(su, ou, mu)
    have ap := apply(abi.arg_passed, {s}, {args}, hA, he, hg)
    have hx: bits_of_int(32, app(app(s, "gpr"), 7)) = bits_of_int(32, app(args, 0)) by simp(ap)
    have hWw := apply(abi.world_typed, hM, hvo, hmv, hvu)
    have body := mp(all_elim(hbody, {args}, {v}, {mem}, {s}), hA, hvo, hmv, hM, hg, hvu, hl, hWw)
    show := apply(tr.prologue_sub1_32, {s}, {v}, {mem}, {base}, {code}, {f}, {k}, {len0}, {z0}, {a1}, {len}, {d}, {c}, {z1}, {z2}, {a2}, {bits_of_int(32, app(args, 0))}, {BIND},
      hM, su, hvo, hob, hmv, hvw, hbase, hc, hrip, hdf, taut(ent), taut(ent), taut(ent), taut(ent), apply(abi.entry_gap, he), hat0, ha1, hk, hkl, hk8, hat, ha2, hd, hcd, hcb, hd1, hd2, hx, hvu, body)
  qed
  show := mp(tr.entry1g[base := lb, code := lc, statics := statics, f := f, q := x0. q(x0), kw := x3 x4 x2. kw(x3, x4, x2)], hpro)
qed

// (a 32-bit argument in rdi: its register value GIMPLE's)
theorem tr.arg32_reg: all rs x. 7 in dom(rs) -> app(rs, 7) = pair(4, x) ->
  (all m. tr.regs(m, rs) -> app(app(m, "gpr"), 7) in gimple.in_reg(fst(gimple.arg(32, x)), snd(gimple.arg(32, x))))
proof
  fix rs x
  assume hd hx
  fix m
  assume hr
  have rg := apply(tr.regs_get, {m}, {rs}, {7}, {4}, {x}, hr, hd, hx)
  have e: app(app(m, "gpr"), 7) = x by taut(rg)
  have xb: x in bits(int_mul(8, 4)) by taut(rg)
  show by defs(simp(e, xb), gimple.in_reg, gimple.arg)
qed

// (a function built on a number: a list of its values' set)
theorem tr.build_list(d, x. v, t): d in omega -> (all x. x in d -> v(x) in t) -> fn_build(d, x. v(x)) in list_type(t)
proof
  assume hd hv
  have sp := mp(fn_build_space[d := d, v := x. v(x), b := t], hv)
  have fd: fn_build(d, x. v(x)) in powerset(cart(d, t)) && is_fun(fn_build(d, x. v(x))) && dom(fn_build(d, x. v(x))) = d by simp(expand(sp, fn_space))
  have ss: subset(fn_build(d, x. v(x)), cart(d, t)) by taut(powerset_def[s := cart(d, t), a := fn_build(d, x. v(x))], fd)
  have g: all z. z in fn_build(d, x. v(x)) -> z in cart(omega, t) proof
    fix z
    assume hz
    have zc := mp(subset_elim[a := fn_build(d, x. v(x)), b := cart(d, t), z := z], ss, hz)
    obtain a, ha from mp(cart_elim[a := d, b := t, z := z], zc)
    obtain b, hb from ha
    have ao := mp(mp(nat_elem[k := d, i := a], hd), taut(hb))
    have c := mp(mp(cart_intro[a := omega, b := t, x := a, y := b], ao), taut(hb))
    have ze: z = pair(a, b) by taut(hb)
    show := rewrite(sym(ze), c)
  qed
  have so: subset(fn_build(d, x. v(x)), cart(omega, t)) by defs(g, subset)
  have pw: fn_build(d, x. v(x)) in powerset(cart(omega, t)) by taut(powerset_def[s := cart(omega, t), a := fn_build(d, x. v(x))], so)
  have dd: dom(fn_build(d, x. v(x))) in omega by simp(fd, hd)
  show by defs(simp(pw, fd, dd), list_type, seq_type, is_seq)
qed

// (code bytes: a list of the bytes it has, or of more)
theorem tr.bytes_list: all b t. (all i. i in bytes_len(b) -> bytes_at(b, i) in t) -> bytes_len(b) in omega -> bytes_seq(b) in list_type(t)
proof
  fix b t
  assume h hn
  have l := mp(mp(tr.build_list[d := bytes_len(b), v := i. bytes_at(b, i), t := t], hn), h)
  show by defs(l, bytes_seq)
qed

// two pieces of code loaded one after the other: the first at its place
theorem tr.loaded_before: all vm b1 b2 lb st. bytes_len(b1) in omega -> bytes_len(b2) in omega -> lb in omega ->
  abi.loaded(vm, lb, seq_concat(bytes_seq(b1), bytes_seq(b2)), st) -> abi.loaded(vm, lb, bytes_seq(b1), st)
proof
  fix vm b1 b2 lb st
  assume h1 h2 hl h
  let T := union2(set_image(bytes_len(b1), i. bytes_at(b1, i)), set_image(bytes_len(b2), i. bytes_at(b2, i)))
  have m1: all i. i in bytes_len(b1) -> bytes_at(b1, i) in T proof
    fix i
    assume hi
    have si := set_image_def[s := bytes_len(b1), f := j. bytes_at(b1, j), y := bytes_at(b1, i)]
    have ex: ex j. j in bytes_len(b1) && bytes_at(b1, j) = bytes_at(b1, i) by ex_intro({i}, taut(hi, refl({bytes_at(b1, i)})))
    have u := union2_iff[a := set_image(bytes_len(b1), j. bytes_at(b1, j)), b := set_image(bytes_len(b2), j. bytes_at(b2, j)), z := bytes_at(b1, i)]
    show by taut(si, ex, u)
  qed
  have m2: all i. i in bytes_len(b2) -> bytes_at(b2, i) in T proof
    fix i
    assume hi
    have si := set_image_def[s := bytes_len(b2), f := j. bytes_at(b2, j), y := bytes_at(b2, i)]
    have ex: ex j. j in bytes_len(b2) && bytes_at(b2, j) = bytes_at(b2, i) by ex_intro({i}, taut(hi, refl({bytes_at(b2, i)})))
    have u := union2_iff[a := set_image(bytes_len(b1), j. bytes_at(b1, j)), b := set_image(bytes_len(b2), j. bytes_at(b2, j)), z := bytes_at(b2, i)]
    show by taut(si, ex, u)
  qed
  have l1 := apply(tr.bytes_list, {b1}, {T}, m1, h1)
  have l2 := apply(tr.bytes_list, {b2}, {T}, m2, h2)
  have lc := apply(tr.loaded_concat, {vm}, {lb}, {bytes_seq(b1)}, {bytes_seq(b2)}, {T}, {st}, l1, l2, hl, h)
  show := lc.1
qed

// two pieces of code loaded one after the other: the second at its place
theorem tr.loaded_after: all vm b1 b2 lb st. bytes_len(b1) in omega -> bytes_len(b2) in omega -> lb in omega ->
  abi.loaded(vm, lb, seq_concat(bytes_seq(b1), bytes_seq(b2)), st) -> abi.loaded(vm, int_add(lb, bytes_len(b1)), bytes_seq(b2), st)
proof
  fix vm b1 b2 lb st
  assume h1 h2 hl h
  let T := union2(set_image(bytes_len(b1), i. bytes_at(b1, i)), set_image(bytes_len(b2), i. bytes_at(b2, i)))
  have m1: all i. i in bytes_len(b1) -> bytes_at(b1, i) in T proof
    fix i
    assume hi
    have si := set_image_def[s := bytes_len(b1), f := j. bytes_at(b1, j), y := bytes_at(b1, i)]
    have ex: ex j. j in bytes_len(b1) && bytes_at(b1, j) = bytes_at(b1, i) by ex_intro({i}, taut(hi, refl({bytes_at(b1, i)})))
    have u := union2_iff[a := set_image(bytes_len(b1), j. bytes_at(b1, j)), b := set_image(bytes_len(b2), j. bytes_at(b2, j)), z := bytes_at(b1, i)]
    show by taut(si, ex, u)
  qed
  have m2: all i. i in bytes_len(b2) -> bytes_at(b2, i) in T proof
    fix i
    assume hi
    have si := set_image_def[s := bytes_len(b2), f := j. bytes_at(b2, j), y := bytes_at(b2, i)]
    have ex: ex j. j in bytes_len(b2) && bytes_at(b2, j) = bytes_at(b2, i) by ex_intro({i}, taut(hi, refl({bytes_at(b2, i)})))
    have u := union2_iff[a := set_image(bytes_len(b1), j. bytes_at(b1, j)), b := set_image(bytes_len(b2), j. bytes_at(b2, j)), z := bytes_at(b2, i)]
    show by taut(si, ex, u)
  qed
  have l1 := apply(tr.bytes_list, {b1}, {T}, m1, h1)
  have l2 := apply(tr.bytes_list, {b2}, {T}, m2, h2)
  have lc := apply(tr.loaded_concat, {vm}, {lb}, {bytes_seq(b1)}, {bytes_seq(b2)}, {T}, {st}, l1, l2, hl, h)
  have fdm := fn_build_dom[d := bytes_len(b1), v := i. bytes_at(b1, i)]
  have sl: seq_len(bytes_seq(b1)) = bytes_len(b1) by defs(fdm, bytes_seq, seq_len)
  have r: abi.loaded(vm, int_add(lb, seq_len(bytes_seq(b1))), bytes_seq(b2), st) by taut(lc)
  show := rewrite(sl, r)
qed
