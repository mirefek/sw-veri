// A call in the translation (docs/overview.md, C1): the
// machine's `call` against readable GIMPLE's call_at -- the push (a fault:
// a crash or GIMPLE's undefined call), the callee's contract
// (tr.implements_at) on its entry state, the caller's run split at the
// callee's return (tr.run_split), and the claim after the call.
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core core/records.core \
//     core/list.core core/loop.core build/c_mallocng_malloc.core proofs/x86.core proofs/x86_code.core \
//     proofs/x86_stack.core proofs/x86_insn.core proofs/abi.core proofs/abi_restore.core proofs/abi_glue.core \
//     proofs/gimple.core proofs/gimple_call.core proofs/abi_stack.core proofs/abi_loop.core proofs/abi_bridge.core \
//     proofs/translate.core proofs/translate_store_loop.core proofs/translate_call.core

// ----------------------------------------------------------------------
//  Generic pieces

// an operation that changes the world: the spec's rest from its result
theorem tr.qs_call(op, w4, r, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k): all w. w in univ(1) -> runs(op, w, ok(w4, r)) ->
  (all o. runs(mkprog(x0 x1. ex x8. a(x0, r, x8) && k(x8, x1)), w4, o) ->
    runs(mkprog(x0 x1. ex x8. bind_rel(op, x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), w, o))
proof
  fix w
  assume hwu hq
  fix o
  assume h0
  have hu: pair(w4, o) in univ(1) && (ex x8. a(w4, r, x8) && k(x8, o)) by simp(expand(expand(h0, runs), mkprog))
  have pu: pair(w, o) in univ(1) by simp(hu, hwu)
  obtain y, hy from hu.2
  have ay := hy.1
  have e: ex o2. runs(op, w, o2) && ((ex s1 v. o2 = ok(s1, v) && a(s1, v, y)) || (ex s1 e. o2 = exc(s1, e) && xx(s1, e, y)) || (ex t. o2 = diverge(t) && dd(t, y)))
    by ex_intro({ok(w4, r)}, simp(hq, ay))
  have b: bind_rel(op, w, x9 x10. a(x9, x10, y), x9 x10. xx(x9, x10, y), x9. dd(x9, y)) by defs(e, bind_rel)
  have g: ex x8. bind_rel(op, w, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, o) by ex_intro({y}, taut(b, hy))
  show := mp(all_elim(tr.runs_intro[r := x0 x1. ex x8. bind_rel(op, x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)], {w}, {o}), pu, g)
qed

// the procedure's rest raising: the function raising
theorem tr.p_exc(q, x3 x4 x2. kw): all w x e. w in univ(1) -> x in univ(1) -> e in univ(1) -> runs(q, w, exc(x, e)) ->
  runs(mkprog(x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, exc(x, e))
proof
  fix w x e
  assume hw hx he hr
  have b0: ex o2. runs(q, w, o2) && ((ex s1 v. o2 = ok(s1, v) && kw(s1, v, exc(x, e))) || (ex s1 e1. o2 = exc(s1, e1) && exc(x, e) = exc(s1, e1)) ||
    (ex t. o2 = diverge(t) && exc(x, e) = diverge(t))) by ex_intro({exc(x, e)}, simp(hr))
  have b: bind_rel(q, w, x3 x4. kw(x3, x4, exc(x, e)), x3 x4. exc(x, e) = exc(x3, x4), x3. exc(x, e) = diverge(x3)) by defs(b0, bind_rel)
  have pu: pair(w, exc(x, e)) in univ(1) by simp(hw, hx, he)
  show := mp(all_elim(tr.runs_intro[r := x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))], {w}, {exc(x, e)}), pu, b)
qed

// (a one-element list)
theorem tr.seq_one_type: all x t. x in t -> seq_one(x) in list_type(t)
proof
  fix x t
  assume hx
  have mem: all z. z in seq_one(x) -> z = pair(0, x) proof
    fix z
    assume hz
    show := mp(single_elim[a := pair(0, x), z := z], expand(hz, seq_one))
  qed
  have f1: all z. z in seq_one(x) -> (ex a b. z = pair(a, b)) proof
    fix z
    assume hz
    have e := mp(all_elim(mem, {z}), hz)
    show by ex_intro({0}, {x}, e)
  qed
  have f2: all a b c. pair(a, b) in seq_one(x) -> pair(a, c) in seq_one(x) -> b = c proof
    fix a b c
    assume h1 h2
    have e1 := mp(all_elim(mem, {pair(a, b)}), h1)
    have e2 := mp(all_elim(mem, {pair(a, c)}), h2)
    show by simp(e1, e2)
  qed
  have fu: is_fun(seq_one(x)) by defs(taut(f1, f2), is_fun)
  have ss: all z. z in seq_one(x) -> z in cart(omega, t) proof
    fix z
    assume hz
    have e := mp(all_elim(mem, {z}), hz)
    have c := mp(mp(cart_intro[a := omega, b := t, x := 0, y := x], simp()), hx)
    show := rewrite(sym(e), c)
  qed
  have sb: subset(seq_one(x), cart(omega, t)) by defs(ss, subset)
  have pw: seq_one(x) in powerset(cart(omega, t)) by taut(powerset_def[s := cart(omega, t), a := seq_one(x)], sb)
  have l1: seq_len(seq_one(x)) = 1 by arith()
  have l1d: dom(seq_one(x)) = 1 by defs(l1, seq_len)
  have o1: 1 in omega by simp()
  have d1: dom(seq_one(x)) in omega := rewrite(sym(l1d), o1)
  show by defs(simp(pw, fu, d1), list_type, seq_type, is_seq)
qed

// ----------------------------------------------------------------------
//  Pages

// (an access allowed or not: its page's entry only)
theorem tr.access_page: all v1 v2 a b k. x86_64_linux.page_of(a) = x86_64_linux.page_of(b) ->
  v1.pages[x86_64_linux.page_of(a)] = v2.pages[x86_64_linux.page_of(b)] ->
  (x86_64_linux.can_access(v1, a, k) <-> x86_64_linux.can_access(v2, b, k))
proof
  fix v1 v2 a b k
  assume hp he
  have he2 := rewrite(hp, he)
  show by defs(simp(hp, he2, keep(x86_64_linux.page_of)), x86_64_linux.can_access, x86_64_linux.mapped)
qed

// ----------------------------------------------------------------------
//  GIMPLE's call when the callee runs

// (worlds: their fields only, and with a memory, an os, a thread pointer put in)
theorem tr.world_keys: all w. w in abi.World -> restrict(w, abi.WKEYS) = w && ghost_part(w, abi.WKEYS) = empty
proof
  fix w
  assume hw
  have kf := apply(pow_cart_fst, unsel(expand(hw, abi.World)))
  have r := apply(restrict_all, kf)
  have g := apply(ghost_part_none, kf)
  show by taut(r, g)
qed

theorem tr.world_set: all w v os fs. w in abi.World -> w in univ(1) -> v in x86_64_linux.Vm -> v in univ(1) ->
  os in x86_64_linux.Os -> os in univ(1) -> fs in bits(64) ->
  fn_update(fn_update(fn_update(w, "vm", v), "os", os), "fs_base", fs) in abi.World && fn_update(fn_update(fn_update(w, "vm", v), "os", os), "fs_base", fs) in univ(1) &&
  fn_update(w, "vm", v) in abi.World && fn_update(w, "vm", v) in univ(1)
proof
  fix w v os fs
  assume hw hu hv hvu ho hou hf
  have wf := expand(hw, abi.World)
  have r1: fn_update(fn_update(fn_update(w, "vm", v), "os", os), "fs_base", fs) in abi.World by defs(simp(wf, hu, hv, hvu, ho, hou, hf), abi.World)
  have r2: fn_update(fn_update(fn_update(w, "vm", v), "os", os), "fs_base", fs) in univ(1) by simp(hu, hvu, hou, hf)
  have r3: fn_update(w, "vm", v) in abi.World by defs(simp(wf, hu, hv, hvu), abi.World)
  have r4: fn_update(w, "vm", v) in univ(1) by simp(hu, hvu)
  show by taut(r1, r2, r3, r4)
qed

// (a World with an empty ghost part: a World)
theorem tr.and_world: all x. x in rec_and(abi.World, single(empty)) -> x in abi.World
proof
  fix x
  assume h
  obtain x0 y0, x0w y0e xe from mp(rec_and_elim[a := abi.World, b := single(empty), s := x], h)
  have ye: y0 = empty := mp(single_elim[a := empty, z := y0], y0e)
  have xe1 := rewrite(ye, xe)
  have xe2 := trans(xe1, union2_empty[a := x0])
  show := rewrite(sym(xe2), x0w)
qed

// the spec's rest diverging: the function diverging
theorem tr.qs_div(op, t, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k): all w. runs(op, w, diverge(t)) ->
  (all o. runs(mkprog(x0 x1. ex x8. dd(t, x8) && k(x8, x1)), w, o) ->
    runs(mkprog(x0 x1. ex x8. bind_rel(op, x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), w, o))
proof
  fix w
  assume hq
  have g: all o. (ex x8. dd(t, x8) && k(x8, o)) -> (ex x8. bind_rel(op, w, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, o)) proof
    fix o
    assume h
    obtain y, hy from h
    have dy := hy.1
    have e1: ex o2. runs(op, w, o2) && ((ex s1 v. o2 = ok(s1, v) && a(s1, v, y)) || (ex s1 e2. o2 = exc(s1, e2) && xx(s1, e2, y)) || (ex t2. o2 = diverge(t2) && dd(t2, y)))
      by ex_intro({diverge(t)}, simp(hq, dy))
    have b: bind_rel(op, w, x9 x10. a(x9, x10, y), x9 x10. xx(x9, x10, y), x9. dd(x9, y)) by defs(e1, bind_rel)
    show by ex_intro({y}, taut(b, hy))
  qed
  show := mp(tr.mkprog_mono[s := w, r1 := x0 x1. ex x8. bind_rel(op, x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1),
    r2 := x0 x1. ex x8. dd(t, x8) && k(x8, x1)], g)
qed

theorem tr.p_div(q, x3 x4 x2. kw): all w t. w in univ(1) -> t in univ(1) -> runs(q, w, diverge(t)) ->
  runs(mkprog(x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, diverge(t))
proof
  fix w t
  assume hw ht hr
  have b0: ex o2. runs(q, w, o2) && ((ex s1 v. o2 = ok(s1, v) && kw(s1, v, diverge(t))) || (ex s1 e1. o2 = exc(s1, e1) && diverge(t) = exc(s1, e1)) ||
    (ex t2. o2 = diverge(t2) && diverge(t) = diverge(t2))) by ex_intro({diverge(t)}, simp(hr))
  have b: bind_rel(q, w, x3 x4. kw(x3, x4, diverge(t)), x3 x4. diverge(t) = exc(x3, x4), x3. diverge(t) = diverge(x3)) by defs(b0, bind_rel)
  have pu: pair(w, diverge(t)) in univ(1) by simp(hw, ht)
  show := mp(all_elim(tr.runs_intro[r := x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))], {w}, {diverge(t)}), pu, b)
qed

// the function's rest from the procedure's rest
theorem tr.p_red(q, q2, x3 x4 x2. kw): all w w2. w in univ(1) -> (all o. runs(q2, w2, o) -> runs(q, w, o)) ->
  (all o. runs(mkprog(x1 x2. bind_rel(q2, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w2, o) ->
    runs(mkprog(x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, o))
proof
  fix w w2
  assume hw hq
  fix o
  assume h0
  have hu: pair(w2, o) in univ(1) && bind_rel(q2, w2, x3 x4. kw(x3, x4, o), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) by simp(expand(expand(h0, runs), mkprog))
  have pu: pair(w, o) in univ(1) by simp(hu, hw)
  obtain o2, ho2 from expand(hu.2, bind_rel)
  have r := mp(all_elim(hq, {o2}), ho2.1)
  have b0: ex o3. runs(q, w, o3) && ((ex s1 v. o3 = ok(s1, v) && kw(s1, v, o)) || (ex s1 e1. o3 = exc(s1, e1) && o = exc(s1, e1)) ||
    (ex t2. o3 = diverge(t2) && o = diverge(t2))) by ex_intro({o2}, taut(r, ho2))
  have b: bind_rel(q, w, x3 x4. kw(x3, x4, o), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) by defs(b0, bind_rel)
  show := mp(all_elim(tr.runs_intro[r := x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))], {w}, {o}), pu, b)
qed

// ----------------------------------------------------------------------
//  The push done: the callee's entry state C

// (a machine with a memory, rsp and rip put in: a machine)
theorem tr.mach_push: all m1 nv r T. m1 in x86_64_linux.Machine -> m1 in univ(1) -> nv in x86_64_linux.Vm -> nv in univ(1) -> r in bits(64) -> T in bits(64) ->
  fn_update(fn_update(fn_update(m1, "vm", nv), "gpr", fn_update(m1.gpr, 4, r)), "rip", T) in x86_64_linux.Machine &&
  fn_update(fn_update(fn_update(m1, "vm", nv), "gpr", fn_update(m1.gpr, 4, r)), "rip", T) in univ(1)
proof
  fix m1 nv r T
  assume hM hu hv hvu hr ht
  have _ gt .. := apply(x86i.parts, hM)
  have g4 := apply(x86.space_upd, {x86_64_linux.Reg}, {bits(64)}, {m1.gpr}, {4}, {r}, gt, simp(), hr)
  have gu := mp(app_univ[u := 1, f := m1, k := "gpr"], hu)
  have a: fn_update(fn_update(fn_update(m1, "vm", nv), "gpr", fn_update(m1.gpr, 4, r)), "rip", T) in x86_64_linux.Machine
    by defs(simp(expand(hM, x86_64_linux.Machine), hu, hv, hvu, g4, gu, hr, ht), x86_64_linux.Machine)
  have b: fn_update(fn_update(fn_update(m1, "vm", nv), "gpr", fn_update(m1.gpr, 4, r)), "rip", T) in univ(1) by simp(hu, hvu, gu, hr, ht)
  show by taut(a, b)
qed

// (a page mapped before the stack grew: its entry kept)
theorem tr.pages_eq_mapped: all v0 v1 l r p. x86.pages_in(v0, v1, l, r) -> p in omega -> x86_64_linux.mapped(v0, p) ->
  v1.pages[p] = v0.pages[p]
proof
  fix v0 v1 l r p
  assume h hp hm
  have a := mp(all_elim(expand(h, x86.pages_in), {p}), hp)
  have mm := expand(hm, x86_64_linux.mapped)
  show by taut(a, mm)
qed

// a disciplined run returns only at its return point
theorem tr.run_d_ok: all s m x e. tr.run_d(s, m, ok(x, e)) -> tr.at_ret(s, x)
proof
  fix s m x e
  assume h
  obtain r, hw hm from expand(h, tr.run_d)
  have wi := mp(mp(mp(while_inv[l0 := pair(m, empty), c := l. true, b := l o. tr.rbd(s, l, o),
    tr := l. fn_update(empty, "os.events", fst(l).os.events), r := r, p := l. true], simp()), simp()), expand(hw, tr.rwd))
  have nd: !(ex t. r = diverge(t)) proof
    have g: (ex t. r = diverge(t)) -> false proof
      assume ed
      obtain t, ht from ed
      show by simp(expand(rewrite(ht, hm), tr.rmap))
    qed
    show by taut(g)
  qed
  have el: ex l. true && ((!true && r = ok(l, empty)) || (true && tr.rbd(s, l, r) && !is_ok(r))) by taut(wi, nd)
  obtain l, hl from el
  have hb: tr.rbd(s, l, r) by taut(hl)
  have nk: !is_ok(r) by taut(hl)
  show := apply(tr.rbd_last[s := s, l := l, r := r, x := x, e := e], hb, nk, hm)
qed

// ----------------------------------------------------------------------
//  After the callee: the loaded code, the return address

// (code at the same pages and bytes: loaded still)
theorem tr.code_at_tr: all v1 v2 gb gc. abi.code_at(v1, gb, gc) ->
  (all i. i in omega -> int_lt(i, seq_len(gc)) ->
    v2.pages[x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))] = v1.pages[x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))] &&
    v2.bytes[bits_of_int(64, int_add(gb, i))] = v1.bytes[bits_of_int(64, int_add(gb, i))]) ->
  abi.code_at(v2, gb, gc)
proof
  fix v1 v2 gb gc
  assume hc he
  have cc := expand(hc, abi.code_at)
  have r: all i. i in omega -> int_lt(i, seq_len(gc)) ->
      ((x86_64_linux.fetchable(v2, bits_of_int(64, int_add(gb, i))) && !x86_64_linux.can_access(v2, bits_of_int(64, int_add(gb, i)), 1)) &&
        !abi.stack_page(v2, x86_64_linux.page_of(bits_of_int(64, int_add(gb, i))))) &&
      v2.bytes[bits_of_int(64, int_add(gb, i))] = gc[i] proof
    fix i
    assume hi hl
    have f1 _ s1 b1 := mp(all_elim(cc, {i}), hi, hl)
    have pe be := mp(all_elim(he, {i}), hi, hl)
    have ac := apply(tr.access_page, {v2}, {v1}, {bits_of_int(64, int_add(gb, i))}, {bits_of_int(64, int_add(gb, i))}, {1}, refl({x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))}), pe)
    have f2: x86_64_linux.fetchable(v2, bits_of_int(64, int_add(gb, i))) by defs(rewrite(sym(pe), expand(f1, x86_64_linux.fetchable, x86_64_linux.mapped)), x86_64_linux.fetchable, x86_64_linux.mapped)
    have s2: !abi.stack_page(v2, x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))) by defs(rewrite(sym(pe), expand(s1, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
    have ci := mp(all_elim(cc, {i}), hi, hl)
    have b2 := trans(be, b1)
    show by taut(ci, ac, f2, s2, b2)
  qed
  show by defs(r, abi.code_at)
qed

// (a code byte: on a mapped, non-stack page)
theorem tr.code_page: all vm gb gc i. abi.code_at(vm, gb, gc) -> i in omega -> int_lt(i, seq_len(gc)) ->
  x86_64_linux.mapped(vm, x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))) && !abi.stack_page(vm, x86_64_linux.page_of(bits_of_int(64, int_add(gb, i))))
proof
  fix vm gb gc i
  assume hc hi hl
  have f _ ns .. := mp(all_elim(expand(hc, abi.code_at), {i}), hi, hl)
  have m: x86_64_linux.mapped(vm, x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))) by taut(expand(f, x86_64_linux.fetchable))
  show by taut(m, ns)
qed

// (8 bytes the same: so their little-endian read)
theorem tr.le_eq8: all b1 b2 a. (all j. j in omega -> int_lt(j, 8) -> b1[bits_add(64, a, bits_of_int(64, j))] = b2[bits_add(64, a, bits_of_int(64, j))]) ->
  x86_64_linux.le(b1, a, 8) = x86_64_linux.le(b2, a, 8)
proof
  fix b1 b2 a
  assume h
  have k0 := mp(all_elim(h, {0}), simp(), simp())
  have k1 := mp(all_elim(h, {1}), simp(), simp())
  have k2 := mp(all_elim(h, {2}), simp(), simp())
  have k3 := mp(all_elim(h, {3}), simp(), simp())
  have k4 := mp(all_elim(h, {4}), simp(), simp())
  have k5 := mp(all_elim(h, {5}), simp(), simp())
  have k6 := mp(all_elim(h, {6}), simp(), simp())
  have k7 := mp(all_elim(h, {7}), simp(), simp())
  show by defs(simp(k0, k1, k2, k3, k4, k5, k6, k7), x86_64_linux.le)
qed

// A return keeps the world valid for GIMPLE (C1's bookkeeping, nothing
// function-specific): the input as it was, the events grown, the program
// loaded still, the break's start as it was
def tr.returns_valid(w, w2) := w2.os.input = w.os.input && subset(w.os.events, w2.os.events) &&
  (all gb gc st. gb in omega -> abi.loaded(w.vm, gb, gc, st) -> abi.loaded(w2.vm, gb, gc, st)) && w2.cpu = w.cpu &&
  w2.vm.brk_start = w.vm.brk_start

// outcomes r undefined: every exception and every divergence among them
// (as GIMPLE's undefined behaviour allows every outcome)
def tr.undef(o. r) := (all x e. x in univ(1) -> e in univ(1) -> r(exc(x, e))) && (all t. t in univ(1) -> r(diverge(t)))

// the spec is undefined from w
def tr.may_raise(g, args, w) := tr.undef(o. runs(g[args], w, o))

// The callee's spec, program-wide: called with at least its n arguments
// (with fewer, a `_fun` wrapper allows any outcome), a return keeps the
// world valid -- or the spec is undefined there (so is its caller's call)
def tr.callee_io(g, n) := all args w w2 r. ord_le(n, seq_len(args)) -> runs(g[args], w, ok(w2, r)) ->
  tr.returns_valid(w, w2) || tr.may_raise(g, args, w)

// a spec built as GIMPLE's `_fun` wrappers are (a program per argument
// list): typed as the ABI has specs
theorem tr.fun_typed(x0 x1 x2. r): fn_build(abi.ARGS, x0. mkprog(x1 x2. r(x0, x1, x2))) in fn_space(abi.ARGS, powerset(univ(1)))
proof
  have v: all x0. x0 in abi.ARGS -> mkprog(x1 x2. r(x0, x1, x2)) in powerset(univ(1)) proof
    fix x0
    assume _
    have g: all z. z in mkprog(x1 x2. r(x0, x1, x2)) -> z in univ(1) proof
      fix z
      assume hz
      have m := set_select_def[s := univ(1), p := y. ex x1 x2. y = pair(x1, x2) && r(x0, x1, x2), z := z]
      show by taut(m, expand(hz, mkprog))
    qed
    have s: subset(mkprog(x1 x2. r(x0, x1, x2)), univ(1)) by defs(g, subset)
    show by taut(powerset_def[s := univ(1), a := mkprog(x1 x2. r(x0, x1, x2))], s)
  qed
  show := mp(fn_build_space[d := abi.ARGS, v := x0. mkprog(x1 x2. r(x0, x1, x2)), b := powerset(univ(1))], v)
qed

// (the callee's spec typed, as the ABI has specs: its runs in univ(1))
theorem tr.spec_univ: all g args w o. g in fn_space(abi.ARGS, powerset(univ(1))) -> args in abi.ARGS -> runs(g[args], w, o) -> pair(w, o) in univ(1)
proof
  fix g args w o
  assume hg ha hr
  have pa := mp(mp(fn_space_app[a := abi.ARGS, b := powerset(univ(1)), f := g, x := args], hg), ha)
  have ss: subset(g[args], univ(1)) by taut(powerset_def[s := univ(1), a := g[args]], pa)
  show := mp(subset_elim[a := g[args], b := univ(1), z := pair(w, o)], ss, expand(hr, runs))
qed

// a crash's I/O: that of the function's overflow (or divergence) from w
theorem tr.ovf_exc: all p w os x. x in rec_and(abi.World, single(empty)) -> runs(p, w, exc(x, exc_val("stack_overflow", empty))) ->
  x.os.events = os.events -> tr.ovf(p, w, os)
proof
  fix p w os x
  assume hx hr hev
  have e: ex x1. x1 in rec_and(abi.World, single(empty)) && runs(p, w, exc(x1, exc_val("stack_overflow", empty))) && x1.os.events = os.events
    by ex_intro({x}, taut(hx, hr, hev))
  show by defs(taut(e), tr.ovf)
qed

theorem tr.ovf_div: all p w os t. runs(p, w, diverge(t)) -> tr.ovf(p, w, os)
proof
  fix p w os t
  assume hr
  have e: ex t1. runs(p, w, diverge(t1)) by ex_intro({t}, hr)
  show by defs(taut(e), tr.ovf)
qed

// (subsets: transitive)
theorem tr.subset_trans: all a b c. subset(a, b) -> subset(b, c) -> subset(a, c)
proof
  fix a b c
  assume h1 h2
  have g: all z. z in a -> z in c proof
    fix z
    assume hz
    have zb := mp(subset_elim[a := a, b := b, z := z], h1, hz)
    show := mp(subset_elim[a := b, b := c, z := z], h2, zb)
  qed
  show by defs(g, subset)
qed

// (the spec raising: the claim, whatever the machine does)
theorem tr.sim_ub(zb. bkp, zb pb wb. bka): all s v p w m. tr.ub(s, v, p, w) -> tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m)
proof
  fix s v p w m
  assume h
  have g: all o. tr.run_k(s, zb. bkp(zb), m, o) -> tr.gk(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, o) proof
    fix o
    assume ho
    show by defs(taut(h), tr.gk)
  qed
  show by defs(g, tr.sim)
qed
// (the stack's guard gap: the pages' only)
theorem tr.sgf_pages: all v1 v2. v2.pages = v1.pages -> abi.stack_gap_free(v1) -> abi.stack_gap_free(v2)
proof
  fix v1 v2
  assume e h
  show by defs(simp(e, expand(h, abi.stack_gap_free, abi.stack_page, x86_64_linux.mapped)), abi.stack_gap_free, abi.stack_page, x86_64_linux.mapped)
qed

// the machine's memory after the push (cv): the world's pages its pages
// but the stack's (the world has none; the push grew only the stack)
theorem tr.push_wpages: all s m w ds cv l r. tr.mem(s, m, w, ds) -> x86.pages_in(m.vm, cv, l, r) -> x86.stk_ext(m.vm, cv) ->
  abi.world_pages(cv, w.vm)
proof
  fix s m w ds cv l r
  assume hmm hpi hse
  have {pages, nostk} := expand(hmm, tr.mem).wm
  have g: all p. p in gc.PN -> w.vm.pages[p] = ite(abi.stack_page(cv, p), none, cv.pages[p]) proof
    fix p
    assume hp
    have po: p in omega by simp(hp)
    have pl: int_lt(p, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) by simp(hp)
    have a1 := mp(all_elim(pages, {p}), hp)
    have a2 := mp(all_elim(expand(hpi, x86.pages_in), {p}), po)
    have a3 := mp(all_elim(expand(hse, x86.stk_ext).1, {p}), po)
    have ns := mp(all_elim(nostk, {p}), hp)
    // (a stack page of cv: none of the world's -- a world's page is the machine's, not the stack's)
    have st: abi.stack_page(cv, p) -> w.vm.pages[p] = none proof
      assume hs
      have c: !(w.vm.pages[p] = none) -> false proof
        assume hn
        have mw: m.vm.pages[p] = w.vm.pages[p] by taut(a1, hn)
        have mn: !(m.vm.pages[p] = none) := rewrite(sym(mw), hn)
        have cm: cv.pages[p] = m.vm.pages[p] by taut(a2, mn)
        have k := mp(ns, hn)
        have sk := expand(hs, abi.stack_page, x86_64_linux.mapped)
        have k2: snd(cv.pages[p]).kind = 2 by taut(sk)
        have k3 := rewrite(mw, rewrite(cm, k2))
        show by taut(k3, k)
      qed
      show by taut(c)
    qed
    // (not a stack page: the machine's before the push, the world's)
    have nst: !abi.stack_page(cv, p) -> w.vm.pages[p] = cv.pages[p] proof
      assume hn
      have cm: cv.pages[p] = m.vm.pages[p] by taut(a3, hn)
      have nsm: !abi.stack_page(m.vm, p) by defs(rewrite(cm, expand(hn, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
      have mw: m.vm.pages[p] = w.vm.pages[p] by taut(a1, nsm)
      show := sym(trans(cm, mw))
    qed
    have t: abi.stack_page(cv, p) -> w.vm.pages[p] = ite(abi.stack_page(cv, p), none, cv.pages[p]) proof
      assume hs
      show := trans(mp(st, hs), sym(mp(tr.ite_t[c := abi.stack_page(cv, p), a := none, b := cv.pages[p]], hs)))
    qed
    have f: !abi.stack_page(cv, p) -> w.vm.pages[p] = ite(abi.stack_page(cv, p), none, cv.pages[p]) proof
      assume hn
      show := trans(mp(nst, hn), sym(mp(tr.ite_f[c := abi.stack_page(cv, p), a := none, b := cv.pages[p]], hn)))
    qed
    show by taut(t, f)
  qed
  show by defs(g, abi.world_pages)
qed

// a sound thread pointer, in a memory whose pages the world's are (but
// the stack's) and with the same bytes on the domain: sound there
theorem tr.thread_xfer: all wv cv ob fs. abi.world_pages(cv, wv) -> abi.thread_ok(wv, fs) -> fs in bits(64) ->
  (all a. a in bits(64) -> abi.in_domain(wv, abi.objs_at(ob, fs), a) -> cv.bytes[a] = wv.bytes[a]) -> abi.thread_ok(cv, fs)
proof
  fix wv cv ob fs
  assume e ht hf hb
  have rd ns le nz := expand(ht, abi.thread_ok)
  // (a page the world maps: the machine's, not a stack page)
  have wp: all q. q in omega -> x86_64_linux.mapped(wv, q) -> cv.pages[q] = wv.pages[q] && !abi.stack_page(cv, q) proof
    fix q
    assume hq hm
    have mq := expand(hm, x86_64_linux.mapped)
    have qp: q in gc.PN by simp(hq, mq)
    have eq := mp(all_elim(expand(e, abi.world_pages), {q}), qp)
    have c: abi.stack_page(cv, q) -> false proof
      assume hs
      have n := rewrite(mp(tr.ite_t[c := abi.stack_page(cv, q), a := none, b := cv.pages[q]], hs), eq)
      show by taut(n, mq)
    qed
    have ns2: !abi.stack_page(cv, q) by taut(c)
    have e2 := rewrite(mp(tr.ite_f[c := abi.stack_page(cv, q), a := none, b := cv.pages[q]], ns2), eq)
    show conj(sym(e2), ns2)
  qed
  have by: all k. k in omega -> int_lt(k, 8) -> cv.bytes[bits_add(64, fs, bits_of_int(64, k))] = wv.bytes[bits_add(64, fs, bits_of_int(64, k))] proof
    fix k
    assume k1 k2
    have r := mp(all_elim(expand(rd, x86_64_linux.readable), {k}), k1, k2)
    have n := mp(all_elim(ns, {k}), k1, k2)
    have lt: int_lt(int_add(fs, k), 18446744073709551616) by simp(expand(r, x86_64_linux.mapped, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE), k1)
    have ea: bits_add(64, fs, bits_of_int(64, k)) = int_add(fs, k) by defs(simp(hf, k1, k2, lt), bits_add, bits_of_int)
    // (the thread pointer's word: not the stack protector's, 40 bytes on)
    have nc: int_add(fs, k) in abi.canary(fs) -> false proof
      assume hc
      have ci: int_add(fs, k) in omega && int_le(int_add(fs, 40), int_add(fs, k)) && int_lt(int_add(fs, k), int_add(fs, 48))
        by taut(set_select_def[s := omega, p := x0. int_le(int_add(fs, 40), x0) && int_lt(x0, int_add(fs, 48)), z := int_add(fs, k)], expand(hc, abi.canary))
      have _ c1 _ := ci
      have fo: fs in omega by simp(hf)
      show by arith(c1, k1, k2, fo)
    qed
    have nh: int_add(fs, k) in abi.objs_at(ob, fs).c_bytes by simp(all_elim(abi.objs_at_live, {ob}, {fs}), all_elim(abi.cbytes0_in, {fs}, {int_add(fs, k)}), nc, hf, k1, keep(abi.canary))
    have dm: abi.in_domain(wv, abi.objs_at(ob, fs), int_add(fs, k)) by defs(taut(r, expand(n, abi.stack_page), nh), abi.in_domain)
    have b := mp(all_elim(hb, {int_add(fs, k)}), (int_add(fs, k) in bits(64) by simp(hf, k1, lt)), dm)
    show := rewrite(sym(ea), b)
  qed
  have ls := apply(tr.le_same, {cv.bytes}, {wv.bytes}, {fs}, {8}, simp(), by)
  have rd2: all x0. x0 in omega -> int_lt(x0, 8) -> x86_64_linux.mapped(cv, int_div(int_add(fs, x0), x86_64_linux.PAGE)) && snd(cv.pages[int_div(int_add(fs, x0), x86_64_linux.PAGE)]).prot.r proof
    fix k
    assume k1 k2
    have r := mp(all_elim(expand(rd, x86_64_linux.readable), {k}), k1, k2)
    have qo: int_div(int_add(fs, k), x86_64_linux.PAGE) in omega by defs(simp(hf, k1), x86_64_linux.PAGE)
    have w2 := mp(all_elim(wp, {int_div(int_add(fs, k), x86_64_linux.PAGE)}), qo, r.1)
    show by defs(rewrite(sym(w2.1), expand(r, x86_64_linux.mapped)), x86_64_linux.mapped)
  qed
  have ns2: all x0. x0 in omega -> int_lt(x0, 8) -> !abi.stack_page(cv, int_div(int_add(fs, x0), x86_64_linux.PAGE)) proof
    fix k
    assume k1 k2
    have r := mp(all_elim(expand(rd, x86_64_linux.readable), {k}), k1, k2)
    have qo: int_div(int_add(fs, k), x86_64_linux.PAGE) in omega by defs(simp(hf, k1), x86_64_linux.PAGE)
    show := mp(all_elim(wp, {int_div(int_add(fs, k), x86_64_linux.PAGE)}), qo, r.1).2
  qed
  have rd3: x86_64_linux.readable(cv, fs, 8) by defs(rd2, x86_64_linux.readable)
  show by defs(taut(rd3, ns2, trans(ls, le), nz), abi.thread_ok)
qed

// (a world: its fields)
theorem tr.world_eta: all w. w in abi.World ->
  w = fn_update(fn_update(fn_update(fn_update(fn_update(empty, "vm", w.vm), "os", w.os), "fs_base", w.fs_base), "cpu", w.cpu), "objs", w.objs)
proof
  fix w
  assume hw
  let R := fn_update(fn_update(fn_update(fn_update(fn_update(empty, "vm", w.vm), "os", w.os), "fs_base", w.fs_base), "cpu", w.cpu), "objs", w.objs)
  have wf: is_fun(w) && dom(w) = abi.WKEYS by simp(expand(hw, abi.World))
  have de := dom_empty
  have f1 := mp(fn_update_fun[f := empty, k := "vm", v := w.vm], de.1)
  have f2 := mp(fn_update_fun[f := fn_update(empty, "vm", w.vm), k := "os", v := w.os], f1)
  have f3 := mp(fn_update_fun[f := fn_update(fn_update(empty, "vm", w.vm), "os", w.os), k := "fs_base", v := w.fs_base], f2)
  have f4 := mp(fn_update_fun[f := fn_update(fn_update(fn_update(empty, "vm", w.vm), "os", w.os), "fs_base", w.fs_base), k := "cpu", v := w.cpu], f3)
  have f5 := mp(fn_update_fun[f := fn_update(fn_update(fn_update(fn_update(empty, "vm", w.vm), "os", w.os), "fs_base", w.fs_base), "cpu", w.cpu), k := "objs", v := w.objs], f4)
  have d1 := mp(dom_update[f := empty, k := "vm", v := w.vm], de.1)
  have d2 := mp(dom_update[f := fn_update(empty, "vm", w.vm), k := "os", v := w.os], f1)
  have d3 := mp(dom_update[f := fn_update(fn_update(empty, "vm", w.vm), "os", w.os), k := "fs_base", v := w.fs_base], f2)
  have d4 := mp(dom_update[f := fn_update(fn_update(fn_update(empty, "vm", w.vm), "os", w.os), "fs_base", w.fs_base), k := "cpu", v := w.cpu], f3)
  have d5 := mp(dom_update[f := fn_update(fn_update(fn_update(fn_update(empty, "vm", w.vm), "os", w.os), "fs_base", w.fs_base), "cpu", w.cpu), k := "objs", v := w.objs], f4)
  have dset: all x. x in insert("objs", insert("cpu", insert("fs_base", insert("os", insert("vm", empty))))) <-> x in abi.WKEYS proof
    fix x
    have l: x in insert("objs", insert("cpu", insert("fs_base", insert("os", insert("vm", empty))))) -> x in abi.WKEYS proof
      assume h
      show by simp(h)
    qed
    have r: x in abi.WKEYS -> x in insert("objs", insert("cpu", insert("fs_base", insert("os", insert("vm", empty))))) proof
      assume h
      show by simp(h)
    qed
    show by taut(l, r)
  qed
  have deq := mp(set_ext[a := insert("objs", insert("cpu", insert("fs_base", insert("os", insert("vm", empty))))), b := abi.WKEYS], dset)
  have dr: dom(R) = abi.WKEYS by simp(d5, d4, d3, d2, d1, de.2, deq)
  have dw: dom(w) = dom(R) := trans(wf.2, sym(dr))
  have ap: all k. k in dom(w) -> w[k] = R[k] proof
    fix k
    assume hk
    have k5: k = "vm" || k = "os" || k = "fs_base" || k = "cpu" || k = "objs" by simp(rewrite(wf.2, hk))
    show by simp(k5)
  qed
  show := mp(rec_ext[a := w, b := R], wf.1, f5, dw, ap)
qed

// (the entry's stack pages from its rsp up: the machine's still -- the
// callees kept them)
theorem tr.inv_stack: all s base code fr m w ds p. tr.inv(s, base, code, fr, m, w) -> tr.mem(s, m, w, ds) -> p in omega -> abi.stack_page(s.vm, p) ->
  int_le(int_div(s.gpr[4], 4096), p) -> m.vm.pages[p] = s.vm.pages[p]
proof
  fix s base code fr m w ds p
  assume hi hmm hp hs hl
  have {sM, slt} := hi
  have sb := apply(x86i.rsp_typed, sM)
  have {stk} := expand(hmm, tr.mem).wm
  have l2: int_le(int_div(int_sub(abi.sp(s), 8), x86_64_linux.PAGE), p) by defs(arith(hl, sb, slt, hp), x86_64_linux.PAGE)
  show := mp(all_elim(stk, {p}), hp, conj(hs, l2))
qed

// (the program loaded, in a memory with the same mapped pages -- but the
// stack's -- and the same bytes on them, the same stack space: loaded
// there)
theorem tr.loaded_xfer: all v1 v2 gb gc st. (all p. p in omega -> x86_64_linux.mapped(v1, p) -> !abi.stack_page(v1, p) -> v2.pages[p] = v1.pages[p]) ->
  (all a. a in bits(64) -> x86_64_linux.mapped(v1, x86_64_linux.page_of(a)) -> !abi.stack_page(v1, x86_64_linux.page_of(a)) -> !x86_64_linux.can_access(v1, a, 1) -> v2.bytes[a] = v1.bytes[a]) ->
  v2.stack_top = v1.stack_top -> v2.stack_limit = v1.stack_limit ->
  abi.loaded(v1, gb, gc, st) -> abi.loaded(v2, gb, gc, st)
proof
  fix v1 v2 gb gc st
  assume hp hb et el hl
  have l1 l2 := expand(hl, abi.loaded)
  have e: all i. i in omega -> int_lt(i, seq_len(gc)) ->
      v2.pages[x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))] = v1.pages[x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))] &&
      v2.bytes[bits_of_int(64, int_add(gb, i))] = v1.bytes[bits_of_int(64, int_add(gb, i))] proof
    fix i
    assume hi hn
    have cm cs := apply(tr.code_page, {v1}, {gb}, {gc}, {i}, l1, hi, hn)
    have po: x86_64_linux.page_of(bits_of_int(64, int_add(gb, i))) in omega by defs(simp(), x86_64_linux.page_of)
    have pe := mp(all_elim(hp, {x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))}), po, cm, cs)
    // (a code byte: not writable)
    have nw: !x86_64_linux.can_access(v1, bits_of_int(64, int_add(gb, i)), 1) by taut(mp(all_elim(expand(l1, abi.code_at), {i}), hi, hn))
    have be := mp(all_elim(hb, {bits_of_int(64, int_add(gb, i))}), simp(), cm, cs, nw)
    show by taut(pe, be)
  qed
  have c2 := apply(tr.code_at_tr, {v1}, {v2}, {gb}, {gc}, l1, e)
  have s2 := apply(tr.statics_same, {v1}, {v2}, {st}, et, el, l2)
  show by defs(taut(c2, s2), abi.loaded)
qed

// (the program loaded: in the world a machine's memory matches, from the
// machine's -- and back; the ABI's bytes writable, so no code)
theorem tr.wm_back: all o n wv ob fs sp gb gcode st. abi.world_matches(o, n, wv, ob, fs, sp) ->
  (all a. a in bits(64) -> a in abi.canary(fs) -> x86_64_linux.can_access(n, a, 1)) -> abi.loaded(n, gb, gcode, st) -> abi.loaded(wv, gb, gcode, st)
proof
  fix o n wv ob fs sp gb gcode st
  assume hw hhw hl
  have {top, limit, bytes, own = c_bytes, pages} := hw
  have pp: all p. p in omega -> x86_64_linux.mapped(n, p) -> !abi.stack_page(n, p) -> wv.pages[p] = n.pages[p] proof
    fix p
    assume hp hm hs
    have pn: p in gc.PN by simp(hp, expand(hm, x86_64_linux.mapped))
    have c := mp(all_elim(pages, {p}), pn)
    have ns: !(wv.pages[p] = none && abi.stack_page(n, p)) by taut(hs)
    have e1: n.pages[p] = wv.pages[p] by taut(c, ns)
    show := sym(e1)
  qed
  have bb: all a. a in bits(64) -> x86_64_linux.mapped(n, x86_64_linux.page_of(a)) -> !abi.stack_page(n, x86_64_linux.page_of(a)) -> !x86_64_linux.can_access(n, a, 1) -> wv.bytes[a] = n.bytes[a] proof
    fix a
    assume ha hm hs hnw
    have po: x86_64_linux.page_of(a) in omega by defs(simp(ha), x86_64_linux.page_of)
    have e := mp(all_elim(pp, {x86_64_linux.page_of(a)}), po, hm, hs)
    have pe: x86_64_linux.page_of(a) = int_div(a, x86_64_linux.PAGE) by defs(simp(), x86_64_linux.page_of)
    have nh0: a in abi.canary(fs) -> false proof
      assume hh
      show by taut(mp(all_elim(hhw, {a}), ha, hh), hnw)
    qed
    have nh: !(a in abi.canary(fs)) by taut(nh0)
    have ow: a in ob.c_bytes := rewrite(sym(own), (a in abi.cbytes0(fs) by simp(all_elim(abi.cbytes0_in, {fs}, {a}), nh, ha, keep(abi.canary))))
    have d: abi.in_domain(wv, ob, a) by defs(simp(rewrite(pe, e), ow, expand(rewrite(pe, hm), x86_64_linux.mapped), expand(rewrite(pe, hs), abi.stack_page, x86_64_linux.mapped)), abi.in_domain, x86_64_linux.mapped)
    have b := mp(all_elim(bytes, {a}), ha, d)
    show := sym(b)
  qed
  show := apply(tr.loaded_xfer, {n}, {wv}, {gb}, {gcode}, {st}, pp, bb, sym(top), sym(limit), hl)
qed

theorem tr.wm_fwd: all o n wv ob fs sp gb gcode st. abi.world_matches(o, n, wv, ob, fs, sp) ->
  (all a. a in bits(64) -> a in abi.canary(fs) -> x86_64_linux.can_access(n, a, 1)) -> abi.loaded(wv, gb, gcode, st) -> abi.loaded(n, gb, gcode, st)
proof
  fix o n wv ob fs sp gb gcode st
  assume hw hhw hl
  have {top, limit, bytes, own = c_bytes, pages} := hw
  have pp: all p. p in omega -> x86_64_linux.mapped(wv, p) -> !abi.stack_page(wv, p) -> n.pages[p] = wv.pages[p] proof
    fix p
    assume hp hm hs
    have pn: p in gc.PN by simp(hp, expand(hm, x86_64_linux.mapped))
    have c := mp(all_elim(pages, {p}), pn)
    have nn: !(wv.pages[p] = none) by taut(expand(hm, x86_64_linux.mapped))
    show by taut(c, nn)
  qed
  have bb: all a. a in bits(64) -> x86_64_linux.mapped(wv, x86_64_linux.page_of(a)) -> !abi.stack_page(wv, x86_64_linux.page_of(a)) -> !x86_64_linux.can_access(wv, a, 1) -> n.bytes[a] = wv.bytes[a] proof
    fix a
    assume ha hm hs hnw
    have pe: x86_64_linux.page_of(a) = int_div(a, x86_64_linux.PAGE) by defs(simp(), x86_64_linux.page_of)
    have po: x86_64_linux.page_of(a) in omega by defs(simp(ha), x86_64_linux.page_of)
    have ep := mp(all_elim(pp, {x86_64_linux.page_of(a)}), po, hm, hs)
    have ac := apply(tr.access_page, {n}, {wv}, {a}, {a}, {1}, refl({x86_64_linux.page_of(a)}), ep)
    have nh0: a in abi.canary(fs) -> false proof
      assume hh
      show by taut(mp(all_elim(hhw, {a}), ha, hh), hnw, ac)
    qed
    have nh: !(a in abi.canary(fs)) by taut(nh0)
    have ow: a in ob.c_bytes := rewrite(sym(own), (a in abi.cbytes0(fs) by simp(all_elim(abi.cbytes0_in, {fs}, {a}), nh, ha, keep(abi.canary))))
    have d: abi.in_domain(wv, ob, a) by defs(simp(ow, expand(rewrite(pe, hm), x86_64_linux.mapped), expand(rewrite(pe, hs), abi.stack_page, x86_64_linux.mapped)), abi.in_domain, x86_64_linux.mapped)
    show := mp(all_elim(bytes, {a}), ha, d)
  qed
  show := apply(tr.loaded_xfer, {wv}, {n}, {gb}, {gcode}, {st}, pp, bb, top, limit, hl)
qed

// (the callee's world xw back with the caller's (w's) stack objects: a world)
theorem tr.back_world: all xw w. xw in abi.World -> xw in univ(1) -> w in abi.World -> w in univ(1) ->
  gc.back(xw, w) in abi.World && gc.back(xw, w) in univ(1)
proof
  fix xw w
  assume hx hxu hw hwu
  have xf := expand(hx, abi.World)
  have wf := expand(hw, abi.World)
  have wou := mp(app_univ[u := 1, f := w, k := "objs"], hwu)
  have wfu := mp(app_univ[u := 1, f := w, k := "fs_base"], hwu)
  have xou := mp(app_univ[u := 1, f := xw, k := "objs"], hxu)
  have wlu := mp(app_univ[u := 1, f := w.objs, k := "live"], wou)
  have wl: w.objs.live in set_type(omega) := apply(abi.objs_parts, (w.objs in abi.Objs by simp(wf))).1
  have ot := apply(abi.objs_live_typed, (xw.objs in abi.Objs by simp(xf)), xou, wl, wlu)
  have a: gc.back(xw, w) in abi.World by defs(simp(xf, wf, hxu, wou, wfu, ot), abi.World)
  have b: gc.back(xw, w) in univ(1) by simp(hxu, wou, wfu, xou, wlu)
  show by taut(a, b)
qed

// ----------------------------------------------------------------------
//  A call from a frame of fr bytes (a multiple of 8, at most tr.FMAX; 0
//  too, a function without a frame): rsp R = S - fr (S the entry's rsp) --
//  16-byte aligned if fr = 8 mod 16, as the ABI wants; GCC calls a local
//  function that needs no alignment without (IPA stack alignment) --; the
//  return address to the 8 bytes from R - 8, below S's own, on one page,
//  at most 17 pages below S's

def tr.cfr(fr) := fr in omega && int_mod(fr, 8) = 0 && int_le(0, fr) && int_le(int_add(fr, 8), tr.FMAX)

// (rsp at a call: R)
theorem tr.call_rsp: all s base code fr m w. tr.inv(s, base, code, fr, m, w) -> tr.cfr(fr) ->
  rb: m.gpr[4] in bits(64) && r16: int_le(16, m.gpr[4]) && rlt: int_lt(m.gpr[4], 140737488355328) &&
  ral: int_mod(m.gpr[4], 8) = 0 && rs: int_le(m.gpr[4], s.gpr[4]) &&
  rS: int_le(int_sub(s.gpr[4], tr.FMAX), m.gpr[4]) && sb: s.gpr[4] in bits(64) &&
  slt: int_lt(s.gpr[4], 140737488355328) && sal: int_mod(s.gpr[4], 8) = 0 && sg: int_le(1048576, s.gpr[4])
proof
  fix s base code fr m w
  assume hi hc
  let S := s.gpr[4]
  have {sM, rspm, slt, sal} := hi
  have fo f16 f8 fm := expand(hc, tr.cfr)
  have sb := apply(x86i.rsp_typed, sM)
  have sg := apply(tr.inv_gap, hi)
  have so: S in omega by simp(sb)
  have rb: int_sub(S, fr) in bits(64) by arith(sb, sg, fo, fm)
  have ra: int_mod(int_sub(S, fr), 8) = 0 by arith(sal, f16, so, fo)
  have r1 := rewrite(sym(rspm), rb)
  have r2: int_le(16, m.gpr[4]) by arith(rspm, sg, fm, fo)
  have r3: int_lt(m.gpr[4], 140737488355328) by arith(rspm, slt, fo)
  have r4 := rewrite(sym(rspm), ra)
  have r5: int_le(m.gpr[4], S) by arith(rspm, f8, fo)
  have r6: int_le(int_sub(S, tr.FMAX), m.gpr[4]) by arith(rspm, fm)
  show := conj(r1, r2, r3, r4, r5, r6, sb, slt, sal, sg)
qed

// the push's bytes: R - 8 + j, on R - 8's page
theorem tr.push_at: all R j. R in bits(64) -> int_le(16, R) -> int_lt(R, 140737488355328) -> int_mod(R, 8) = 0 ->
  j in omega -> int_lt(j, 8) ->
  bits_add(64, bits_sub(64, R, 8), bits_of_int(64, j)) = int_add(int_sub(R, 8), j) &&
  int_div(int_add(int_sub(R, 8), j), 4096) = int_div(int_sub(R, 8), 4096)
proof
  fix R j
  assume hr h16 hl ha hj hj8
  have p64: pow2(64) = 18446744073709551616 by simp()
  have sb: int_le(0, R) && int_lt(R, 18446744073709551616) by simp(hr)
  have e0: int_mod(int_add(int_mod(int_sub(R, 8), 18446744073709551616), int_mod(j, 18446744073709551616)), 18446744073709551616) = int_add(int_sub(R, 8), j)
    by arith(sb, h16, hl, hj, hj8)
  have e: bits_add(64, bits_sub(64, R, 8), bits_of_int(64, j)) = int_add(int_sub(R, 8), j) by defs(rewrite(sym(p64), e0), bits_add, bits_sub, bits_of_int)
  have m2: int_le(int_mod(int_sub(R, 8), 4096), 4088) by simp(hr, ha, h16)
  have d: int_div(int_add(int_sub(R, 8), j), 4096) = int_div(int_sub(R, 8), 4096) by simp(hr, h16, m2, hj, hj8)
  show by taut(e, d)
qed

// the pages: R - 8's (L), R's, S's (P0) in order, within the guard gap
theorem tr.call_pages: all S R. R in bits(64) -> int_le(16, R) -> int_mod(R, 8) = 0 -> int_le(R, S) -> int_le(int_sub(S, tr.FMAX), R) -> S in bits(64) ->
  lr: int_le(int_div(int_sub(R, 8), 4096), int_div(R, 4096)) && rl: int_le(int_div(R, 4096), int_add(int_div(int_sub(R, 8), 4096), 1)) &&
  rp: int_le(int_div(R, 4096), int_div(S, 4096)) && gap: int_le(int_mul(int_sub(int_div(S, 4096), int_div(int_sub(R, 8), 4096)), 4096), 1048576)
proof
  fix S R
  assume hr h16 ha hrs hsr hs
  have ro: R in omega by simp(hr)
  have so: S in omega by simp(hs)
  have d1: int_le(int_div(int_sub(R, 8), 4096), int_div(R, 4096)) by simp(hr, h16)
  have d2: int_le(int_div(R, 4096), int_add(int_div(int_sub(R, 8), 4096), 1)) by simp(hr, h16)
  have d3: int_le(int_div(R, 4096), int_div(S, 4096)) by simp(hr, hs, hrs)
  have d4: int_le(int_mul(int_sub(int_div(S, 4096), int_div(int_sub(R, 8), 4096)), 4096), 1048576) by arith(hrs, hsr, ro, so, h16)
  show := conj(d1, d2, d3, d4)
qed

// (a mapped page within the guard gap below a stack page: the stack's)
theorem tr.gap_below: all v P q. abi.stack_gap_free(v) -> abi.stack_page(v, P) -> P in omega -> q in omega -> int_le(q, P) ->
  int_le(int_mul(int_sub(P, q), 4096), 1048576) -> abi.stack_page(v, q) || !x86_64_linux.mapped(v, q)
proof
  fix v P q
  assume hg hp hpo hqo hl hgap
  have c1: q = P -> abi.stack_page(v, q) || !x86_64_linux.mapped(v, q) proof
    assume e
    show by taut(rewrite(sym(e), hp))
  qed
  have c2: !(q = P) -> x86_64_linux.mapped(v, q) -> abi.stack_page(v, q) proof
    assume ne hm
    have lt: int_lt(q, P) by arith(hl, ne, hqo, hpo)
    have gap: int_le(int_mul(int_sub(P, q), x86_64_linux.PAGE), x86_64_linux.STACK_GUARD_GAP) by defs(arith(hgap), x86_64_linux.PAGE, x86_64_linux.STACK_GUARD_GAP)
    have pr2: ((abi.stack_page(v, P) && int_lt(q, P)) && int_le(int_mul(int_sub(P, q), x86_64_linux.PAGE), x86_64_linux.STACK_GUARD_GAP)) && x86_64_linux.mapped(v, q) by taut(hp, lt, gap, hm)
    show := mp(all_elim(expand(hg, abi.stack_gap_free).1, {P}, {q}), conj(hpo, hqo), pr2)
  qed
  show by taut(c1, c2)
qed

// (the stack: one run of equal pages up to its top -- between two stack
// pages, the lower one's)
theorem tr.stack_run: all v L P q. abi.stack_reserve(v) -> abi.stack_page(v, L) -> abi.stack_page(v, P) -> L in omega -> P in omega -> q in omega -> int_le(L, q) -> int_le(q, P) ->
  v.pages[q] = v.pages[L]
proof
  fix v L P q
  assume hr hl hp hlo po hqo h1 h2
  have _ _ r3 _ := expand(hr, abi.stack_reserve)
  have pl := mp(all_elim(r3, {L}), hlo, hl)
  have pp := mp(all_elim(r3, {P}), po, hp)
  have top: int_le(int_mul(int_add(q, 1), x86_64_linux.PAGE), v.stack_top) by defs(arith(expand(pp.2, x86_64_linux.PAGE), h2, hqo), x86_64_linux.PAGE)
  show := mp(all_elim(pl.3, {q}), hqo, conj(h1, top))
qed

// (the coupling at a call: its parts)
theorem tr.inv_call: all s base code fr m w. tr.inv(s, base, code, fr, m, w) ->
  sM: s in x86_64_linux.Machine && mM: m in x86_64_linux.Machine && mu: m in univ(1) && wW: w in abi.World && wu: w in univ(1) &&
  wcpu: w.cpu = s.cpu && mos: m.os = w.os && mfs: m.fs_base = w.fs_base &&
  er4: m.gpr[4] = int_sub(s.gpr[4], fr) && sb: s.gpr[4] in bits(64) && slt: int_lt(s.gpr[4], 140737488355328) &&
  sal: int_mod(s.gpr[4], 8) = 0 && hsps: abi.stack_page(s.vm, int_div(s.gpr[4], 4096)) &&
  sgf: abi.stack_gap_free(s.vm) && srsv: abi.stack_reserve(s.vm) && winp: w.os.input = s.os.input &&
  sws: subset(s.os.events, w.os.events) && mcpu: m.cpu = s.cpu && mgs: m.gs_base = s.gs_base &&
  mdf: !m.flags.df
proof
  fix s base code fr m w
  assume hi
  have {sM, mM, mu, wW, wu, wcpu, mos, mfs, rspm, slt, sal, hsps, sgf, srsv, winp, sws, mcpu, mgs, mdf} := hi
  have sb := apply(x86i.rsp_typed, sM)
  show := conj(sM, mM, mu, wW, wu, wcpu, mos, mfs, rspm, sb, slt, sal, hsps, sgf, srsv, winp, sws, mcpu, mgs, mdf)
qed

// The push of a call from a frame of fr bytes (rsp R): its state C
theorem tr.push_ok: all s base code fr m w RA T m1 e1 C. tr.inv(s, base, code, fr, m, w) -> tr.cfr(fr) ->
  RA in bits(64) -> T in bits(64) ->
  runs(x86_64_linux.touch_range(bits_sub(64, m.gpr[4], 8), 8, 1), fn_update(m, "rip", RA), ok(m1, e1)) ->
  C = fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, bits_sub(64, m.gpr[4], 8), 8, RA))),
    "gpr", fn_update(m1.gpr, 4, bits_sub(64, m.gpr[4], 8))), "rip", T) ->
  C in x86_64_linux.Machine && C in univ(1) &&
  C.os = m.os && C.fs_base = m.fs_base && C.cpu = m.cpu && C.gs_base = m.gs_base &&
  C.flags = m.flags && C.gpr = fn_update(m.gpr, 4, int_sub(m.gpr[4], 8)) && C.rip = T &&
  tr.keeps_code(m.vm, C.vm) && x86.vm_fields(m.vm, C.vm) &&
  x86_64_linux.le(C.vm.bytes, int_sub(m.gpr[4], 8), 8) = RA &&
  x86.pages_in(m.vm, C.vm, int_div(int_sub(m.gpr[4], 8), 4096), int_div(s.gpr[4], 4096)) &&
  (all a. a in bits(64) -> !(int_le(int_sub(m.gpr[4], 8), a) && int_lt(a, m.gpr[4])) ->
    x86_64_linux.mapped(m.vm, x86_64_linux.page_of(a)) -> C.vm.bytes[a] = m.vm.bytes[a]) &&
  x86.stk_ext(m.vm, C.vm) &&
  (all j. j in omega -> int_lt(j, 8) -> x86_64_linux.can_access(C.vm, bits_add(64, int_sub(m.gpr[4], 8), bits_of_int(64, j)), 1))
proof
  fix s base code fr m w RA T m1 e1 C
  assume hi hcf hra ht htr hC
  let S := s.gpr[4]
  let R := m.gpr[4]
  let M2 := fn_update(m, "rip", RA)
  let PA := int_sub(R, 8)
  let L := int_div(int_sub(R, 8), 4096)
  let P0 := int_div(S, 4096)
  have {mM, mu, hsps} := apply(tr.inv_call, hi)
  have {rb, r16, rlt, ral, rs, rS, sb} := apply(tr.call_rsp, hi, hcf)
  have so: S in omega by simp(sb)
  have bs: bits_sub(64, R, 8) = PA by defs(simp(rb, r16), bits_sub)
  have htr2 := rewrite(bs, htr)
  have hC2 := rewrite(bs, hC)
  have pab: PA in bits(64) by simp(rb, r16)
  have m2M: M2 in x86_64_linux.Machine by defs(simp(expand(mM, x86_64_linux.Machine), mu, hra), x86_64_linux.Machine)
  have m2u: M2 in univ(1) by simp(mu, hra)
  have {lr, rp} := apply(tr.call_pages, {S}, {R}, rb, r16, ral, rs, rS, sb)
  // (the pushed bytes: on page L, at most S's page P0, which is mapped)
  have rbl: x86.range_below(PA, 8, L, P0) proof
    have g: all j. j in omega -> int_lt(j, 8) ->
        int_le(L, x86_64_linux.page_of(bits_add(64, PA, bits_of_int(64, j)))) && int_le(x86_64_linux.page_of(bits_add(64, PA, bits_of_int(64, j))), P0) proof
      fix j
      assume hj hj8
      have pa1 pa2 := apply(tr.push_at, {R}, {j}, rb, r16, rlt, ral, hj, hj8)
      have pa3 := rewrite(bs, pa1)
      have pg: x86_64_linux.page_of(bits_add(64, PA, bits_of_int(64, j))) = L by defs(simp(pa3, pa2), x86_64_linux.page_of, x86_64_linux.PAGE)
      have lp: int_le(L, P0) by arith(lr, rp)
      show by simp(pg, lp, keep(x86_64_linux.page_of))
    qed
    show by defs(g, x86.range_below)
  qed
  have kpt: tr.kept(s.vm, m.vm, S) by simp(expand(hi, tr.inv), keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, abi.stack_gap_free, abi.stack_reserve, x86_64_linux.can_access, tr.kept, tr.keeps_code))
  have kr := mp(all_elim(expand(kpt, tr.kept), {S}), so, arith(so), arith(so))
  have kr2: m.vm.pages[P0] = s.vm.pages[P0] by defs(kr, x86_64_linux.page_of, x86_64_linux.PAGE)
  have mp0: x86_64_linux.mapped(M2.vm, P0) by defs(simp(kr2, expand(hsps, abi.stack_page, x86_64_linux.mapped)), x86_64_linux.mapped)
  have p0o: P0 in omega by simp(so)
  have pin := apply(x86.touch_range_ok_pages, {M2}, {PA}, {8}, {1}, {L}, {P0}, {m1}, {e1}, p0o, mp0, rbl, htr2)
  // (m1: M2 grown, typed, its fields)
  have m1M m1u := apply(x86.touch_range_typed, {M2}, {PA}, {8}, {1}, {m1}, {e1}, m2M, m2u, htr2)
  have tv := apply(x86.touch_range_vm, {M2}, {PA}, {8}, {1}, {m1}, {e1}, htr2)
  have gr := apply(x86.touch_range_frame, {M2}, {PA}, {8}, {1}, {m1}, {e1}, simp(), htr2)
  have fl := apply(x86.touch_range_fields, {M2}, {PA}, {8}, {1}, {m1}, {e1}, htr2)
  have mf: m1.os = m.os && m1.fs_base = m.fs_base && m1.cpu = m.cpu && m1.gs_base = m.gs_base &&
    m1.flags = m.flags && m1.gpr = m.gpr && m1.rip = RA by simp(tv)
  have v1: m1.vm in x86_64_linux.Vm := apply(x86i.parts, m1M).4
  have b1: m1.vm.bytes in fn_space(bits(64), bits(8)) by simp(v1)
  // C: typed
  have su := apply(g.store_univ, {m1.vm}, {PA}, {8}, {RA}, v1)
  have v1u := mp(app_univ[u := 1, f := m1, k := "vm"], m1u)
  have nu: fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, PA, 8, RA)) in univ(1) by simp(v1u, su)
  have nv := apply(x86.store_vm, {m1.vm}, {PA}, {8}, {RA}, v1, nu)
  have mpu := apply(tr.mach_push, {m1}, {fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, PA, 8, RA))}, {PA}, {T}, m1M, m1u, nv, nu, pab, ht)
  have cM cu := rewrite(sym(hC2), mpu)
  have cf: C.os = m.os && C.fs_base = m.fs_base && C.cpu = m.cpu && C.gs_base = m.gs_base &&
    C.flags = m.flags && C.gpr = fn_update(m.gpr, 4, PA) && C.rip = T by simp(hC2, mf)
  have cvm: C.vm = fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, PA, 8, RA)) by simp(hC2)
  // its memory: fields, pages, the return address, the other bytes
  have cfl: x86.vm_fields(m.vm, C.vm) by defs(simp(cvm, expand(fl, x86.vm_fields)), x86.vm_fields)
  have cpi: x86.pages_in(m.vm, C.vm, L, P0) by defs(simp(cvm, expand(pin, x86.pages_in)), x86.pages_in)
  have rao: RA in omega by simp(hra)
  have ls := apply(tr.le_store8, {m1.vm.bytes}, {PA}, {RA}, b1, pab, rao)
  have cle: x86_64_linux.le(C.vm.bytes, PA, 8) = RA by simp(cvm, ls, hra)
  have cby: all a. a in bits(64) -> !(int_le(PA, a) && int_lt(a, R)) -> x86_64_linux.mapped(m.vm, x86_64_linux.page_of(a)) ->
      C.vm.bytes[a] = m.vm.bytes[a] proof
    fix a
    assume ha hn hm
    have ne: all i. i in omega -> int_lt(i, 8) -> !(bits_add(64, PA, bits_of_int(64, i)) = a) proof
      fix i
      assume hi0 hi8
      have pa1 .. := apply(tr.push_at, {R}, {i}, rb, r16, rlt, ral, hi0, hi8)
      have pa3 := rewrite(bs, pa1)
      have ao: a in omega by simp(ha)
      have ro: R in omega by simp(rb)
      have nq: !(int_add(int_sub(R, 8), i) = a) by arith(hn, hi0, hi8, ro, ao)
      show := rewrite(sym(pa3), nq)
    qed
    have so2 := apply(x86.store_outside, {m1.vm.bytes}, {PA}, {8}, {RA}, {a}, ha, ne)
    have gb: all x0. x0 in bits(64) -> x86_64_linux.mapped(M2.vm, x86_64_linux.page_of(x0)) -> m1.vm.bytes[x0] = M2.vm.bytes[x0]
      := expand(gr, abi.vm_grows).2
    have gg := mp(all_elim(gb, {a}), ha, simp(hm))
    show by simp(cvm, so2, gg)
  qed
  // the code: kept by the push (its bytes writable or newly mapped stack)
  have kc: tr.keeps_code(m.vm, C.vm) proof
    have g: all gb gc st. gb in omega -> abi.loaded(m.vm, gb, gc, st) -> abi.loaded(C.vm, gb, gc, st) proof
      fix gb gc st
      assume hb hl
      have lc: abi.code_at(M2.vm, gb, gc) by simp(expand(hl, abi.loaded), keep(abi.code_at))
      have sc := all_elim(apply(x86.store_code, {gb}, {gc}, {M2}, {PA}, {8}, {m1}, {e1}, simp(), hb, htr2, lc), {RA})
      have cc: abi.code_at(C.vm, gb, gc) := rewrite(sym(cvm), sc)
      have ft fm _ _ := expand(cfl, x86.vm_fields)
      have stt := apply(tr.statics_same, {m.vm}, {C.vm}, {st}, ft, fm, expand(hl, abi.loaded).2)
      show by defs(taut(cc, stt), abi.loaded)
    qed
    show by defs(g, tr.keeps_code)
  qed
  // the grown pages: stack pages; the pushed bytes: writable
  have st0 := apply(x86.touch_range_stk, {M2}, {PA}, {8}, {1}, {m1}, {e1}, htr2)
  have pe: C.vm.pages = m1.vm.pages by simp(cvm)
  have stk: x86.stk_ext(m.vm, C.vm) proof
    have g: all i. i in omega -> C.vm.pages[i] = m.vm.pages[i] || abi.stack_page(C.vm, i) proof
      fix i
      assume hi
      have a0 := mp(all_elim(expand(st0, x86.stk_ext).1, {i}), hi)
      have sq := mp(all_elim(tr.sp_pages, {m1.vm}, {C.vm}, {i}), pe)
      show by simp(a0, pe, sq)
    qed
    have r: abi.stack_reserve(m.vm) -> abi.stack_reserve(C.vm) proof
      assume h0
      have r1: abi.stack_reserve(m1.vm) := mp(expand(st0, x86.stk_ext).2, (abi.stack_reserve(M2.vm) by simp(h0)))
      show := apply(tr.rsv_same, pe, (C.vm.stack_top = m1.vm.stack_top by simp(cvm)), (C.vm.stack_limit = m1.vm.stack_limit by simp(cvm)), r1)
    qed
    show by defs(taut(g, r), x86.stk_ext)
  qed
  have ac0 := apply(x86.touch_range_acc, {M2}, {PA}, {8}, {m1}, {e1}, htr2)
  have acc: all j. j in omega -> int_lt(j, 8) -> x86_64_linux.can_access(C.vm, bits_add(64, PA, bits_of_int(64, j)), 1) proof
    fix j
    assume j1 j2
    have c := mp(all_elim(ac0, {j}), j1, j2)
    show := apply(tr.acc_pages, {m1.vm}, {C.vm}, {bits_add(64, PA, bits_of_int(64, j))}, {1}, pe, c)
  qed
  show by taut(cM, cu, cf, kc, cfl, cle, cpi, cby, stk, acc)
qed

// ----------------------------------------------------------------------
//  GIMPLE's call (its result pair to the rest), any argument list

// the call raising: the function raising
theorem tr.call_exc(g, args, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all w x e. w in univ(1) -> x in univ(1) -> e in univ(1) ->
  runs(gimple.call(g, args), w, exc(x, e)) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e)) ->
  runs(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, exc(x, e))
proof
  fix w x e
  assume hw hx he hc hk
  have q := mp(all_elim(mp(all_elim(tr.qs_raise[op := gimple.call(g, args), s2 := x, e := e, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1)], {w}), hc), {exc(x, e)}), hk)
  show := apply(tr.p_exc[q := mkprog(x0 x1. ex x8. bind_rel(gimple.call(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), kw := x3 x4 x2. kw(x3, x4, x2)],
    {w}, {x}, {e}, hw, hx, he, q)
qed

// the call diverging: the function diverging
theorem tr.call_div(g, args, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all w t. w in univ(1) -> t in univ(1) ->
  runs(gimple.call(g, args), w, diverge(t)) -> runs(mkprog(x0 x1. ex x8. dd(t, x8) && k(x8, x1)), w, diverge(t)) ->
  runs(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, diverge(t))
proof
  fix w t
  assume hw ht hc hk
  have q := mp(all_elim(mp(all_elim(tr.qs_div[op := gimple.call(g, args), t := t, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1)], {w}), hc), {diverge(t)}), hk)
  show := apply(tr.p_div[q := mkprog(x0 x1. ex x8. bind_rel(gimple.call(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), kw := x3 x4 x2. kw(x3, x4, x2)],
    {w}, {t}, hw, ht, q)
qed

// the call overflowing the stack first: the function overflows, with the
// world's I/O
theorem tr.call_ovf(g, args, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all w os.
  w in abi.World -> w in univ(1) -> w.os.events = os.events ->
  runs(mkprog(x0 x1. ex x8. xx(w, exc_val("stack_overflow", empty), x8) && k(x8, x1)), w, exc(w, exc_val("stack_overflow", empty))) ->
  tr.ovf(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, os)
proof
  fix w os
  assume hW hw hev hk
  have ou: exc_val("stack_overflow", empty) in univ(1) by defs(simp(), exc_val)
  have c1 := apply(gc.call_ovf, {g}, {args}, {w}, hw)
  have pe := apply(tr.call_exc[g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)],
    {w}, {w}, {exc_val("stack_overflow", empty)}, hw, hw, ou, c1, hk)
  have wa := apply(tr.world_and, hW)
  show := apply(tr.ovf_exc, {mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))}, {w}, {os}, {w}, wa, pe, hev)
qed

// the callee raising, diverging: the caller's rest so
theorem tr.gcall_exc(g, args, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all w regs x e. w in univ(1) -> x in univ(1) -> e in univ(1) -> gc.regs_ok(regs, args) ->
  gc.sound(w) -> runs(g[regs], w, exc(x, e)) -> (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) ->
  runs(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, exc(x, e))
proof
  fix w regs x e
  assume hw hx he rg hs hc hk
  have c := apply(gc.call_exc, {g}, {args}, {w}, {regs}, {x}, {e}, hw, hx, he, rg, hs, hc)
  show := apply(tr.call_exc[g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {x}, {e}, hw, hx, he, c, mp(all_elim(hk, {x}, {e}), hx, he))
qed

theorem tr.gcall_div(g, args, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all w regs t. w in univ(1) -> t in univ(1) -> gc.regs_ok(regs, args) ->
  gc.sound(w) -> runs(g[regs], w, diverge(t)) -> (all t. t in univ(1) -> runs(mkprog(x0 x1. ex x8. dd(t, x8) && k(x8, x1)), w, diverge(t))) ->
  runs(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, diverge(t))
proof
  fix w regs t
  assume hw ht rg hs hc hd
  have c := apply(gc.call_div, {g}, {args}, {w}, {regs}, {t}, hw, ht, rg, hs, hc)
  show := apply(tr.call_div[g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {t}, hw, ht, c, mp(all_elim(hd, {t}), ht))
qed

// GIMPLE's call undefined (any of its exceptions): the caller undefined
theorem tr.gcall_ub(g, args, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all s v w. w in abi.World -> w in univ(1) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(gimple.call(g, args), w, exc(x, e))) -> (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) ->
  tr.ub(s, v, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w)
proof
  fix s v w
  assume hW hw hall hk
  have eu: empty in univ(1) by simp()
  have c := mp(all_elim(hall, {w}, {empty}), hw, eu)
  have pe := apply(tr.call_exc[g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {w}, {empty}, hw, hw, eu, c, mp(all_elim(hk, {w}, {empty}), hw, eu))
  have eno := tr.undef_empty
  have rst: abi.raise_state(w) by defs(apply(tr.world_and, hW), abi.raise_state)
  show by defs(ex_intro({empty}, {w}, taut(eu, eno, rst, pe)), tr.ub)
qed

// the callee returned (w4, the result r0:r1): the call overflowing after
// it, or the caller's rest from W4 (w4 with the caller's objects) with r0:r1
theorem tr.gcall_ret(g, args, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all w regs w4 r0 r1. w in univ(1) -> w4 in univ(1) -> r0 in univ(1) -> r1 in univ(1) -> gc.regs_ok(regs, args) ->
  gc.sound(w) -> runs(g[regs], w, ok(w4, pair(r0, r1))) -> (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) ->
  runs(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, exc(gc.back(w4, w), exc_val("stack_overflow", empty))) &&
  (all o. runs(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. a(x0, pair(r0, r1), x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), gc.back(w4, w), o) ->
    runs(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, o))
proof
  fix w regs w4 r0 r1
  assume hw hw4 h0 h1 rg hs hc hk
  let W4 := gc.back(w4, w)
  have w4u: W4 in univ(1) by simp(hw4, hw)
  have ou: exc_val("stack_overflow", empty) in univ(1) by defs(simp(), exc_val)
  have co := apply(gc.call_ovf_after, {g}, {args}, {w}, {regs}, {w4}, {r0}, {r1}, hw, hw4, h0, h1, rg, hs, hc)
  have po := apply(tr.call_exc[g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {W4}, {exc_val("stack_overflow", empty)}, hw, w4u, ou, co, mp(all_elim(hk, {W4}, {exc_val("stack_overflow", empty)}), w4u, ou))
  have ck := apply(gc.call_ok, {g}, {args}, {w}, {regs}, {w4}, {r0}, {r1}, hw, hw4, h0, h1, rg, hs, hc)
  have qc := mp(all_elim(tr.qs_call[op := gimple.call(g, args), w4 := W4, r := pair(r0, r1), a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1)], {w}), hw, ck)
  have pk := apply(tr.p_red[q := mkprog(x0 x1. ex x8. bind_rel(gimple.call(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)),
    q2 := mkprog(x0 x1. ex x8. a(x0, pair(r0, r1), x8) && k(x8, x1)), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {W4}, hw, qc)
  show by taut(po, pk)
qed

// ----------------------------------------------------------------------
//  A call's arguments: in the argument registers (rdi, rsi, rdx, rcx,
//  r8, r9), each as GIMPLE's argument has it

// the registers' values: the callee's argument list
def tr.aregs(m, n) := fn_build(n, i. m.gpr[abi.ARG_REGS[i]])

// each argument in its register
def tr.args_in(m, args) := all i. i in omega -> int_lt(i, seq_len(args)) ->
  m.gpr[abi.ARG_REGS[i]] in gimple.in_reg(fst(args[i]), snd(args[i]))

// (an argument register: a register, not rsp)
theorem tr.argreg: all i. i in omega -> int_lt(i, 6) -> abi.ARG_REGS[i] in x86_64_linux.Reg && !(abi.ARG_REGS[i] = 4)
proof
  fix i
  assume hi h6
  have a0 a1 a2 a3 a4 a5 := tr.argregs
  have c: i = 0 || i = 1 || i = 2 || i = 3 || i = 4 || i = 5 by arith(hi, h6)
  show by simp(c, a0, a1, a2, a3, a4, a5)
qed

// the argument list: GIMPLE's call's registers, an ABI argument list
theorem tr.aregs_ok: all m args n. m in x86_64_linux.Machine -> seq_len(args) = n -> n in omega -> int_le(n, 6) -> tr.args_in(m, args) ->
  gc.regs_ok(tr.aregs(m, n), args) && tr.aregs(m, n) in abi.ARGS && tr.aregs(m, n) in univ(1) && seq_len(tr.aregs(m, n)) = n &&
  (all i. i in omega -> int_lt(i, n) -> tr.aregs(m, n)[i] = m.gpr[abi.ARG_REGS[i]])
proof
  fix m args n
  assume hm hl hn h6 ha
  let A := tr.aregs(m, n)
  have at: all i. i in omega -> int_lt(i, n) -> A[i] = m.gpr[abi.ARG_REGS[i]] proof
    fix i
    assume hi hlt
    have im: i in n by arith(hn, hi, hlt)
    show by defs(mp(app_fn_build[d := n, v := i. m.gpr[abi.ARG_REGS[i]], a := i], im), tr.aregs)
  qed
  have vt: all i. i in n -> m.gpr[abi.ARG_REGS[i]] in bits(64) proof
    fix i
    assume hi
    have io := mp(mp(nat_elem[k := n, i := i], hn), hi)
    have il: int_lt(i, n) by arith(hn, io, hi)
    have r := apply(tr.argreg, io, (int_lt(i, 6) by arith(il, h6)))
    show := mp(mp(all_elim(x86i.reg_typed, {m}, {abi.ARG_REGS[i]}), hm), r.1)
  qed
  have lt: A in list_type(bits(64)) by defs(apply(build_list, hn, vt), tr.aregs)
  have ln: seq_len(A) = n by defs(simp(fn_build_dom[d := n, v := i. m.gpr[abi.ARG_REGS[i]]]), seq_len, tr.aregs)
  have ol0: ord_le(n, 6) by defs(arith(hn, h6), ord_le)
  have ol := rewrite(sym(ln), ol0)
  have aA: A in abi.ARGS by simp(lt, ol, keep(ord_le))
  have sp := mp(fn_build_space[d := n, v := i. m.gpr[abi.ARG_REGS[i]], b := bits(64)], vt)
  have nu: n in univ(1) by simp(hn)
  have au: A in univ(1) by defs(mp(fn_space_univ[u := 1, a := n, b := bits(64), f := fn_build(n, i. m.gpr[abi.ARG_REGS[i]])], nu, bits_univ[n := 64], sp), tr.aregs)
  have el: all i. i in omega -> int_lt(i, seq_len(args)) -> A[i] in gimple.in_reg(fst(args[i]), snd(args[i])) proof
    fix i
    assume hi hlt
    have e := mp(all_elim(at, {i}), hi, rewrite(hl, hlt))
    show := rewrite(sym(e), mp(all_elim(expand(ha, tr.args_in), {i}), hi, hlt))
  qed
  have rg: gc.regs_ok(A, args) by simp(lt, ln, hl, el)
  show := conj(rg, aA, au, ln, at)
qed

// A fault of the push (from m, rip past the call: a2): a crash where the
// stack could not grow -- every page from the push's up to S's is a stack
// page or unmapped (the stack's guard gap, which its reserve keeps free)
theorem tr.call_fault(g, args, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all s v base code fr m w a2 x e.
  tr.inv(s, base, code, fr, m, w) -> tr.cfr(fr) -> tr.mem(s, m, w, v) -> (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) -> a2 in bits(64) ->
  x86.grown(fn_update(m, "rip", a2), int_div(int_sub(m.gpr[4], 8), 4096), int_div(s.gpr[4], 4096), x) ->
  x86.fault_at(bits_sub(64, m.gpr[4], 8), 8, 1, x, e) -> x86.stk_ext(m.vm, x.vm) ->
  tr.ub(s, v, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w) || tr.crash(s, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, exc(x, e))
proof
  fix s v base code fr m w a2 x e
  assume hi hcf hmm hk ha2 hg hf hse
  let S := s.gpr[4]
  let R := m.gpr[4]
  let M2 := fn_update(m, "rip", a2)
  let P := mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))
  let L := int_div(int_sub(R, 8), 4096)
  let P0 := int_div(S, 4096)
  have {mM, mu, wW, wu, mos, hsps, srsv, winp, sws} := apply(tr.inv_call, hi)
  have {rb, r16, rlt, ral, rs, rS, sb, slt} := apply(tr.call_rsp, hi, hcf)
  have {lr, rl, rp, gap} := apply(tr.call_pages, {S}, {R}, rb, r16, ral, rs, rS, sb)
  have {rsv} := expand(hmm, tr.mem).wm
  have so: S in omega by simp(sb)
  have ro: R in omega by simp(rb)
  have m2M: M2 in x86_64_linux.Machine by defs(simp(expand(mM, x86_64_linux.Machine), mu, ha2), x86_64_linux.Machine)
  have m2u: M2 in univ(1) by simp(mu, ha2)
  have gt := apply(x86.grown_typed, {M2}, {L}, {P0}, {x}, m2M, m2u, hg)
  have {xM = cM, xos = cos} := gt
  have g1 .. := expand(hg, x86.grown)
  // (S's page: s's at the fault, a stack page; the guard gap below it free)
  have p0o: P0 in omega by simp(so)
  have k2 := apply(tr.inv_stack, {s}, {base}, {code}, {fr}, {m}, {w}, {v}, {P0}, hi, hmm, p0o, hsps, (int_le(P0, P0) by arith(p0o)))
  have g1a := mp(all_elim(expand(g1, x86.pages_in), {P0}), p0o)
  have sm := expand(hsps, abi.stack_page, x86_64_linux.mapped)
  have nn: !(M2.vm.pages[P0] = none) by simp(k2, sm)
  have xp0: x.vm.pages[P0] = s.vm.pages[P0] by simp(g1a, nn, k2)
  have hspx: abi.stack_page(x.vm, P0) by defs(simp(xp0, sm), abi.stack_page, x86_64_linux.mapped)
  have rx: abi.stack_reserve(x.vm) := mp(expand(hse, x86.stk_ext).2, mp(rsv, srsv))
  have gx := apply(abi.reserve_gap, rx)
  // the faulting byte: R - 8 + j, on page L
  obtain j, jo j8 tf0 from expand(hf, x86.fault_at)
  have pa1 pa2 := apply(tr.push_at, {R}, {j}, rb, r16, rlt, ral, jo, j8)
  have tf := expand(rewrite(pa1, tf0), x86.touch_fault)
  let B := int_add(int_sub(R, 8), j)
  have bb: B in bits(64) by simp(rb, r16, rlt, jo, j8)
  have pb: x86_64_linux.page_of(B) = L by defs(pa2, x86_64_linux.page_of, x86_64_linux.PAGE)
  // where the stack could not grow: from B's page up to R's, stack pages or none
  have xr: x.gpr[4] = R by simp(gt)
  have ovp: abi.overflow_at(x.vm, x.gpr[4], bits_add(64, S, 8), B) proof
    have lt: int_lt(B, bits_add(64, S, 8)) by simp(rs, j8, sb, slt, ro)
    have gp: all p. p in omega -> int_le(int_div(B, x86_64_linux.PAGE), p) && int_le(p, int_div(x.gpr[4], x86_64_linux.PAGE)) ->
        abi.stack_page(x.vm, p) || !x86_64_linux.mapped(x.vm, p) proof
      fix p
      assume hp h12
      have h1 h2 := h12
      have pl: int_le(L, p) by defs(arith(expand(h1, x86_64_linux.PAGE), pa2), x86_64_linux.PAGE)
      have pr: int_le(p, int_div(R, 4096)) := rewrite(xr, expand(h2, x86_64_linux.PAGE))
      have pg: int_le(int_mul(int_sub(P0, p), 4096), 1048576) by arith(gap, pl)
      show := apply(tr.gap_below, {x.vm}, {P0}, {p}, gx, hspx, p0o, hp, (int_le(p, P0) by arith(pr, rp)), pg)
    qed
    show by defs(taut(lt, gp), abi.overflow_at)
  qed
  // a crash there: the I/O the call's overflow before the callee has
  have ev: w.os.events = x.os.events by simp(xos, mos)
  have ov := apply(tr.call_ovf[g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {x.os}, wW, wu, ev, mp(all_elim(hk, {w}, {exc_val("stack_overflow", empty)}), wu, defs(simp(), exc_val)))
  have sub: subset(s.os.events, x.os.events) by simp(sws, xos, mos)
  have inp: s.os.input = x.os.input by simp(winp, xos, mos)
  have crash: all kk. (kk = 0 || kk = 1 || kk = 3) -> e = exc_val("segv", pair(B, kk)) -> tr.ub(s, v, P, w) || tr.crash(s, P, w, exc(x, e)) proof
    fix kk
    assume hkk he
    have cr: exc(x, e) = exc(x, exc_val("segv", pair(B, kk))) by simp(he)
    have c: tr.crash(s, P, w, exc(x, e)) by defs(ex_intro({x}, {B}, {kk}, taut(cr, hkk, ovp, xM, bb, sub, inp, ov)), tr.crash)
    show by taut(c)
  qed
  have c0: (e = exc_val("segv", pair(B, 0)) && !x86_64_linux.mapped(x.vm, x86_64_linux.page_of(B))) -> tr.ub(s, v, P, w) || tr.crash(s, P, w, exc(x, e)) proof
    assume h
    show := mp(all_elim(crash, {0}), simp(), h.1)
  qed
  // non-canonical: not so
  have c2: (e = exc_val("segv", pair(0, 2)) && !x86_64_linux.canonical(B)) -> tr.ub(s, v, P, w) || tr.crash(s, P, w, exc(x, e)) proof
    assume hc
    have cn: x86_64_linux.canonical(B) by defs(simp(rlt, jo, j8, r16), x86_64_linux.canonical)
    show by taut(hc, cn)
  qed
  have c13: ((e = exc_val("segv", pair(B, 1)) || e = exc_val("segv", pair(B, 3))) && !x86_64_linux.can_access(x.vm, B, 1)) ->
      tr.ub(s, v, P, w) || tr.crash(s, P, w, exc(x, e)) proof
    assume h
    have he hn := h
    have c1: e = exc_val("segv", pair(B, 1)) -> tr.ub(s, v, P, w) || tr.crash(s, P, w, exc(x, e)) proof
      assume e1
      show := mp(all_elim(crash, {1}), simp(), e1)
    qed
    have c3: e = exc_val("segv", pair(B, 3)) -> tr.ub(s, v, P, w) || tr.crash(s, P, w, exc(x, e)) proof
      assume e3
      show := mp(all_elim(crash, {3}), simp(), e3)
    qed
    show by taut(he, c1, c3)
  qed
  show by taut(tf, c0, c2, c13)
qed

// (the push's slot, R - 8, accessible: on a stack page -- the guard gap
// below S's leaves it to the stack)
theorem tr.push_page_stack: all cv S R. R in bits(64) -> int_le(16, R) -> int_mod(R, 8) = 0 -> int_le(R, S) -> int_le(int_sub(S, tr.FMAX), R) -> S in bits(64) ->
  abi.stack_gap_free(cv) -> abi.stack_page(cv, int_div(S, 4096)) -> x86_64_linux.can_access(cv, int_sub(R, 8), 1) ->
  abi.stack_page(cv, int_div(int_sub(R, 8), 4096))
proof
  fix cv S R
  assume hr h16 ha hrs hsr hs hg hp hc
  have {lr, rp, gap} := apply(tr.call_pages, {S}, {R}, hr, h16, ha, hrs, hsr, hs)
  have so: S in omega by simp(hs)
  have p0: int_div(S, 4096) in omega by simp(so)
  have q0: int_div(int_sub(R, 8), 4096) in omega by simp(hr, h16)
  have mq0: x86_64_linux.mapped(cv, x86_64_linux.page_of(int_sub(R, 8))) by taut(expand(hc, x86_64_linux.can_access))
  have pe: x86_64_linux.page_of(int_sub(R, 8)) = int_div(int_sub(R, 8), 4096) by defs(simp(), x86_64_linux.page_of, x86_64_linux.PAGE)
  have mq := rewrite(pe, mq0)
  have c := apply(tr.gap_below, {cv}, {int_div(S, 4096)}, {int_div(int_sub(R, 8), 4096)}, hg, hp, p0, q0, (int_le(int_div(int_sub(R, 8), 4096), int_div(S, 4096)) by arith(lr, rp)), gap)
  show by taut(c, mq)
qed

// after the push (the callee's entry memory cv): on the world's domain, the
// machine's bytes the world's, its pages mapped before
theorem tr.push_dom: all s base code fr m w ds cv. tr.ofr(s, fr, ds) -> tr.inv(s, base, code, fr, m, w) -> tr.cfr(fr) -> tr.mem(s, m, w, ds) ->
  x86.pages_in(m.vm, cv, int_div(int_sub(m.gpr[4], 8), 4096), int_div(s.gpr[4], 4096)) ->
  (all a. a in bits(64) -> !(int_le(int_sub(m.gpr[4], 8), a) && int_lt(a, m.gpr[4])) ->
    x86_64_linux.mapped(m.vm, x86_64_linux.page_of(a)) -> cv.bytes[a] = m.vm.bytes[a]) ->
  abi.stack_page(cv, int_div(int_sub(m.gpr[4], 8), 4096)) ->
  (all a. a in bits(64) -> abi.in_domain(w.vm, abi.wob(ds, w.objs.c_bytes), a) ->
    x86_64_linux.mapped(m.vm, x86_64_linux.page_of(a)) && cv.bytes[a] = w.vm.bytes[a])
proof
  fix s base code fr m w ds cv
  assume hofr hi hcf hmm hpi hby hsp
  let S := s.gpr[4]
  let R := m.gpr[4]
  have {rb, r16, rlt, ral, rs, sb, slt} := apply(tr.call_rsp, hi, hcf)
  have so: S in omega by simp(sb)
  have ro: R in omega by simp(rb)
  have {oacc} := hmm
  have {bytes, pages} := expand(hmm, tr.mem).wm
  fix a
  assume ha hd
  have ao: a in omega by simp(ha)
  have mw := mp(all_elim(bytes, {a}), ha, hd)
  // (an object's byte: above sp, accessible)
  have c1: a in abi.wob(ds, w.objs.c_bytes).live -> x86_64_linux.mapped(m.vm, x86_64_linux.page_of(a)) && !(int_le(int_sub(R, 8), a) && int_lt(a, R)) proof
    assume hx0
    have hx: a in ds by simp(hx0)
    have o := mp(all_elim(oacc, {a}), ao, hx)
    have ab: bits_of_int(64, a) = a by simp(ha)
    have ca0: x86_64_linux.can_access(m.vm, bits_of_int(64, a), 1) by taut(o)
    have sp8: abi.sp(s) = int_add(S, 8) by simp(sb, slt)
    have ca := rewrite(ab, ca0)
    have m0: x86_64_linux.mapped(m.vm, x86_64_linux.page_of(a)) by taut(expand(ca, x86_64_linux.can_access))
    // (a caller's above sp; an own one in the frame, at or above rsp)
    have {er4} := apply(tr.inv_call, hi)
    have n1: int_le(abi.sp(s), a) -> !(int_le(int_sub(R, 8), a) && int_lt(a, R)) proof
      assume sa
      show by arith(sa, sp8, rs, so, ao)
    qed
    have n2: int_lt(a, S) -> !(int_le(int_sub(R, 8), a) && int_lt(a, R)) proof
      assume al
      have ra := mp(all_elim(hofr, {a}), ao, hx, al)
      show by arith(ra, er4, ao)
    qed
    have nr: !(int_le(int_sub(R, 8), a) && int_lt(a, R)) by taut(o, n1, n2)
    show by taut(m0, nr)
  qed
  // (a mapped page's, not the stack's: the machine's too, not the push's)
  have c2: x86_64_linux.mapped(w.vm, int_div(a, x86_64_linux.PAGE)) && !(snd(w.vm.pages[int_div(a, x86_64_linux.PAGE)]).kind = 2) ->
      x86_64_linux.mapped(m.vm, x86_64_linux.page_of(a)) && !(int_le(int_sub(R, 8), a) && int_lt(a, R)) proof
    assume hn
    have pa: int_div(a, 4096) in gc.PN by simp(ha, expand(hn.1, x86_64_linux.mapped, x86_64_linux.PAGE))
    have pc := mp(all_elim(pages, {int_div(a, 4096)}), pa)
    have nn: !(w.vm.pages[int_div(a, 4096)] = none) by taut(expand(hn.1, x86_64_linux.mapped, x86_64_linux.PAGE))
    have mpw: m.vm.pages[int_div(a, 4096)] = w.vm.pages[int_div(a, 4096)] by taut(pc, nn)
    have m0: x86_64_linux.mapped(m.vm, x86_64_linux.page_of(a)) by defs(simp(mpw, expand(hn.1, x86_64_linux.mapped)), x86_64_linux.mapped, x86_64_linux.page_of, x86_64_linux.PAGE)
    have nr: int_le(int_sub(R, 8), a) && int_lt(a, R) -> false proof
      assume hr
      have j0: int_sub(a, int_sub(R, 8)) in omega by arith(hr, ao, ro)
      have j8: int_lt(int_sub(a, int_sub(R, 8)), 8) by arith(hr)
      have _ pa2 := apply(tr.push_at, {R}, {int_sub(a, int_sub(R, 8))}, rb, r16, rlt, ral, j0, j8)
      have ea: int_add(int_sub(R, 8), int_sub(a, int_sub(R, 8))) = a by arith(ro, ao)
      have pg: int_div(a, 4096) = int_div(int_sub(R, 8), 4096) := rewrite(ea, pa2)
      // (the push's page: the machine's, mapped -- so the world's -- a stack page)
      have pq0: int_div(int_sub(R, 8), 4096) in omega by simp(rb, r16)
      have pi := mp(all_elim(expand(hpi, x86.pages_in), {int_div(int_sub(R, 8), 4096)}), pq0)
      have mpw2 := rewrite(pg, mpw)
      have nn2 := rewrite(pg, nn)
      have mn := rewrite(sym(mpw2), nn2)
      have cvm0: cv.pages[int_div(int_sub(R, 8), 4096)] = m.vm.pages[int_div(int_sub(R, 8), 4096)] by taut(pi, mn)
      have cvm := trans(cvm0, mpw2)
      have k2 := rewrite(pg, expand(hn.2, x86_64_linux.PAGE))
      have sp2 := expand(hsp, abi.stack_page)
      have k3: snd(cv.pages[int_div(int_sub(R, 8), 4096)]).kind = 2 by taut(sp2)
      have k4 := rewrite(cvm, k3)
      show by taut(k4, k2)
    qed
    show by taut(m0, nr)
  qed
  have mr: x86_64_linux.mapped(m.vm, x86_64_linux.page_of(a)) && !(int_le(int_sub(R, 8), a) && int_lt(a, R)) by taut(expand(hd, abi.in_domain), c1, c2)
  have cb := mp(all_elim(hby, {a}), ha, mr.2, mr.1)
  show by taut(mr.1, trans(cb, mw))
qed

// (the argument list's length and elements)
theorem tr.aregs_at: all m n. n in omega -> seq_len(tr.aregs(m, n)) = n &&
  (all i. i in omega -> int_lt(i, n) -> tr.aregs(m, n)[i] = m.gpr[abi.ARG_REGS[i]])
proof
  fix m n
  assume hn
  have at: all i. i in omega -> int_lt(i, n) -> tr.aregs(m, n)[i] = m.gpr[abi.ARG_REGS[i]] proof
    fix i
    assume hi hlt
    have im: i in n by arith(hn, hi, hlt)
    show by defs(mp(app_fn_build[d := n, v := i. m.gpr[abi.ARG_REGS[i]], a := i], im), tr.aregs)
  qed
  have ln: seq_len(tr.aregs(m, n)) = n by defs(simp(fn_build_dom[d := n, v := i. m.gpr[abi.ARG_REGS[i]]]), seq_len, tr.aregs)
  show conj(ln, at)
qed

// The push done (C), GIMPLE's check holding on the world (the thread
// pointer): the callee's entry as the ABI has it (its n arguments in their
// registers) -- the stack's reserve kept by the push --, the world's memory
// a view of C's (its pages but the stack's), the stack objects the
// callee's, the world the callee's
theorem tr.callee_ready: all s base code fr m w ds RA T m1 e1 C n. tr.ofr(s, fr, ds) -> tr.inv(s, base, code, fr, m, w) -> tr.cfr(fr) -> tr.mem(s, m, w, ds) ->
  RA in bits(64) -> T in bits(64) -> n in omega -> int_le(n, 6) ->
  runs(x86_64_linux.touch_range(bits_sub(64, m.gpr[4], 8), 8, 1), fn_update(m, "rip", RA), ok(m1, e1)) ->
  C = fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, bits_sub(64, m.gpr[4], 8), 8, RA))),
    "gpr", fn_update(m1.gpr, 4, bits_sub(64, m.gpr[4], 8))), "rip", T) ->
  gc.sound(w) ->
  tr.entry_ok_u(C, tr.aregs(m, n)) && (int_mod(fr, 16) = 8 -> tr.sal16(s) -> abi.entry_ok(C, tr.aregs(m, n))) && abi.view_ok(C, ds, w.vm) && tr.objs_ok(C, ds) &&
  abi.view(C, ds, w.vm) = w && w.vm in x86_64_linux.Vm && ds in set_type(omega)
proof
  fix s base code fr m w ds RA T m1 e1 C n
  assume hofr hi hcf hmm hra ht hno hn6 htr hC hsd
  let S := s.gpr[4]
  let R := m.gpr[4]
  let WV := w.vm
  let L := int_div(int_sub(R, 8), 4096)
  let P0 := int_div(S, 4096)
  have {sM, mM, mu, wW, wu, wcpu, mos, mfs, hsps, srsv, mdf, mcpu} := apply(tr.inv_call, hi)
  have {rb, r16, rlt, ral, rs, rS, sb, slt} := apply(tr.call_rsp, hi, hcf)
  have {lr, rp} := apply(tr.call_pages, {S}, {R}, rb, r16, ral, rs, rS, sb)
  have so: S in omega by simp(sb)
  have ro: R in omega by simp(rb)
  have cM cu co cf cc0 cgs cfl cgpr crip ckc cvf cle cpi cby cstk cacc := apply(tr.push_ok, {s}, {base}, {code}, {fr}, {m}, {w}, {RA}, {T}, {m1}, {e1}, {C}, hi, hcf, hra, ht, htr, hC)
  have cv: C.vm in x86_64_linux.Vm := apply(x86i.parts, cM).4
  have wpg := apply(tr.push_wpages, {s}, {m}, {w}, {ds}, {C.vm}, {L}, {P0}, hmm, cpi, cstk)
  have {rsv, nostk, top, limit, brk0, brk} := expand(hmm, tr.mem).wm
  // (the stack's reserve: the entry's, the machine's, C's -- no other mapping where the stack may grow)
  have rsvC: abi.stack_reserve(C.vm) := mp(expand(cstk, x86.stk_ext).2, mp(rsv, srsv))
  have sgfC := apply(abi.reserve_gap, rsvC)
  // (the entry's stack pages from its rsp up: C's still)
  have kst: all p. p in omega -> abi.stack_page(s.vm, p) -> int_le(P0, p) -> C.vm.pages[p] = s.vm.pages[p] proof
    fix p
    assume hp hsp hl
    have k2 := apply(tr.inv_stack, {s}, {base}, {code}, {fr}, {m}, {w}, {ds}, {p}, hi, hmm, hp, hsp, hl)
    have pi := mp(all_elim(expand(cpi, x86.pages_in), {p}), hp)
    have nn: !(m.vm.pages[p] = none) by simp(k2, expand(hsp, abi.stack_page, x86_64_linux.mapped))
    have e: C.vm.pages[p] = m.vm.pages[p] by taut(pi, nn)
    show := trans(e, k2)
  qed
  have kspc: all p. p in omega -> abi.stack_page(s.vm, p) -> int_le(P0, p) -> abi.stack_page(C.vm, p) proof
    fix p
    assume hp hsp hl
    have e := mp(all_elim(kst, {p}), hp, hsp, hl)
    show by defs(rewrite(sym(e), expand(hsp, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
  qed
  have p0o: P0 in omega by simp(so)
  have p0c := mp(all_elim(kspc, {P0}), p0o, hsps, (int_le(P0, P0) by arith(p0o)))
  have a00 := mp(all_elim(cacc, {0}), simp(), simp())
  have ea: bits_add(64, int_sub(R, 8), bits_of_int(64, 0)) = int_sub(R, 8) by arith(ro, r16, rlt)
  have acc0 := rewrite(ea, a00)
  have spC := apply(tr.push_page_stack, {C.vm}, {S}, {R}, rb, r16, ral, rs, rS, sb, sgfC, p0c, acc0)
  have dom := apply(tr.push_dom, {s}, {base}, {code}, {fr}, {m}, {w}, {ds}, {C.vm}, hofr, hi, hcf, hmm, cpi, cby, spC)
  // C's bytes: the world's on its domain (its own bytes the entry's)
  have mo := apply(tr.mem_objs, hmm)
  have oaw := all_elim(abi.objs_at_wob, {ds}, {s.fs_base})
  have byW: all a. a in bits(64) -> abi.in_domain(WV, abi.objs_at(ds, s.fs_base), a) -> C.vm.bytes[a] = WV.bytes[a] proof
    fix a
    assume ha hd
    have hd2 := rewrite(sym(mo.1), rewrite(oaw, hd))
    show := mp(all_elim(dom, {a}), ha, hd2).2
  qed
  have {mfs0, scan} := hi
  have wfs: w.fs_base = s.fs_base := trans(sym(mfs), mfs0)
  have byW2 := rewrite(sym(wfs), byW)
  have fsb: w.fs_base in bits(64) by simp(expand(wW, abi.World))
  have tC := apply(tr.thread_xfer, {WV}, {C.vm}, {ds}, {w.fs_base}, wpg, hsd, fsb, byW2)
  have cfs: C.fs_base = w.fs_base := trans(cf, mfs)
  have cfs0: C.fs_base = s.fs_base := trans(cfs, wfs)
  // (the stack protector's word: on its pages, s's still -- C's the push's, m's there)
  have sfb: s.fs_base in bits(64) := rewrite(wfs, fsb)
  have cpg: all i. i in omega -> int_lt(i, 8) -> C.vm.pages[int_div(int_add(int_add(s.fs_base, 40), i), x86_64_linux.PAGE)] = s.vm.pages[int_div(int_add(int_add(s.fs_base, 40), i), x86_64_linux.PAGE)] proof
    fix i
    assume i1 i2
    have hp hmp := apply(tr.hid_pages, {s}, {m}, {w}, {ds}, {i}, hmm, scan, sfb, i1, i2)
    have po: int_div(int_add(int_add(s.fs_base, 40), i), x86_64_linux.PAGE) in omega by defs(simp(sfb, i1), x86_64_linux.PAGE)
    have pi := apply(tr.pages_eq_mapped, {m.vm}, {C.vm}, {L}, {P0}, {int_div(int_add(int_add(s.fs_base, 40), i), x86_64_linux.PAGE)}, cpi, po, hmp)
    show := trans(pi, hp)
  qed
  have cnC0 := apply(tr.canary_pages, {s.vm}, {C.vm}, {s.fs_base}, scan, cpg)
  have cnC: abi.canary_ok(C.vm, C.fs_base) := rewrite(sym(cfs0), cnC0)
  // the ABI's entry
  have c4: C.gpr[4] = int_sub(R, 8) by simp(cgpr)
  have cdf: !C.flags.df by simp(cfl, mdf)
  have aln aat := apply(tr.aregs_at, {m}, {n}, hno)
  have ar: all x0. x0 in omega -> int_lt(x0, seq_len(tr.aregs(m, n))) -> C.gpr[abi.ARG_REGS[x0]] = tr.aregs(m, n)[x0] proof
    fix x0
    assume h0 h1
    have h1n := rewrite(aln, h1)
    have rg := apply(tr.argreg, h0, (int_lt(x0, 6) by arith(h1n, hn6)))
    have e1 := mp(all_elim(aat, {x0}), h0, h1n)
    have uo := mp(app_update_other[f := m.gpr, k := 4, v := int_sub(R, 8), x := abi.ARG_REGS[x0]], rg.2)
    have e2: C.gpr[abi.ARG_REGS[x0]] = m.gpr[abi.ARG_REGS[x0]] := rewrite(sym(cgpr), uo)
    show := trans(e2, sym(e1))
  qed
  have tC2 := rewrite(sym(cfs), tC)
  have spC2: abi.stack_page(C.vm, int_div(C.gpr[4], x86_64_linux.PAGE)) by defs(simp(c4, spC), x86_64_linux.PAGE)
  have acc2: x86_64_linux.can_access(C.vm, C.gpr[4], 1) by simp(c4, acc0)
  // (the break's start: the world's)
  have {wbk} := expand(hi, tr.inv)
  have _ _ cvb _ := expand(cvf, x86.vm_fields)
  have cbk: abi.brk_start_ok(C.vm) by defs(simp(cvb, brk0, expand(wbk, abi.brk_start_ok)), abi.brk_start_ok)
  // (rsp 8-byte aligned: R's less 8)
  have al8: int_mod(C.gpr[4], 8) = 0 by simp(c4, (int_mod(int_sub(R, 8), 8) = 0 by arith(ral, ro, r16)))
  have eoku: tr.entry_ok_u(C, tr.aregs(m, n)) by defs(taut(spC2, acc2, rsvC, cdf, ar, tC2, al8, cbk, cnC), tr.entry_ok_u)
  // (aligned as the ABI wants: the entry aligned, a frame of 8 mod 16)
  have eok: int_mod(fr, 16) = 8 -> tr.sal16(s) -> abi.entry_ok(C, tr.aregs(m, n)) proof
    assume h8 h16
    have {er4} := apply(tr.inv_call, hi)
    have m1: int_mod(int_add(S, 8), 16) = 0 by simp(sb, h16, slt)
    have fo: fr in omega := expand(hcf, tr.cfr).1
    have ra16: int_mod(R, 16) = 0 by arith(er4, m1, h8, so, fo)
    have al: int_mod(bits_add(64, int_sub(R, 8), 8), 16) = 0 by simp(rb, r16, rlt, ra16)
    have al2: int_mod(bits_add(64, C.gpr[4], 8), 16) = 0 by simp(c4, al)
    show by defs(taut(spC2, acc2, rsvC, al2, cdf, ar, tC2, cbk, cnC), abi.entry_ok)
  qed
  // the view
  have vf := expand(cvf, x86.vm_fields)
  have byWC := rewrite(sym(cfs0), byW)
  have wmC: abi.world_matches(C.vm, C.vm, WV, abi.objs_at(ds, C.fs_base), C.fs_base, abi.sp(C)) proof
    have fr: all x0. x0 in bits(64) -> (int_le(abi.sp(C), x0) && !abi.in_domain(WV, abi.objs_at(ds, C.fs_base), x0)) && abi.stack_page(C.vm, x86_64_linux.page_of(x0)) ->
        C.vm.bytes[x0] = C.vm.bytes[x0] proof
      fix x0
      assume h1 h2
      show := refl({C.vm.bytes[x0]})
    qed
    have hd: all x0. x0 in bits(64) -> x0 in abi.canary(C.fs_base) ->
        C.vm.bytes[x0] = C.vm.bytes[x0] && C.vm.pages[x86_64_linux.page_of(x0)] = C.vm.pages[x86_64_linux.page_of(x0)] proof
      fix x0
      assume h1 h2
      show := conj(refl({C.vm.bytes[x0]}), refl({C.vm.pages[x86_64_linux.page_of(x0)]}))
    qed
    have pg: all x0. x0 in gc.PN -> C.vm.pages[x0] = WV.pages[x0] || (WV.pages[x0] = none && abi.stack_page(C.vm, x0)) proof
      fix x0
      assume h
      have eq := mp(all_elim(expand(wpg, abi.world_pages), {x0}), h)
      have t: abi.stack_page(C.vm, x0) -> WV.pages[x0] = none && abi.stack_page(C.vm, x0) proof
        assume hs
        show conj(rewrite(mp(tr.ite_t[c := abi.stack_page(C.vm, x0), a := none, b := C.vm.pages[x0]], hs), eq), hs)
      qed
      have f: !abi.stack_page(C.vm, x0) -> C.vm.pages[x0] = WV.pages[x0] proof
        assume hn
        show := sym(rewrite(mp(tr.ite_f[c := abi.stack_page(C.vm, x0), a := none, b := C.vm.pages[x0]], hn), eq))
      qed
      show by taut(t, f)
    qed
    have st: all x0. x0 in omega -> abi.stack_page(C.vm, x0) && int_le(int_div(int_sub(abi.sp(C), 8), x86_64_linux.PAGE), x0) -> C.vm.pages[x0] = C.vm.pages[x0] proof
      fix x0
      assume h1 h2
      show := refl({C.vm.pages[x0]})
    qed
    have rs2: abi.stack_reserve(C.vm) -> abi.stack_reserve(C.vm) by taut()
    have ow := all_elim(abi.objs_at_live, {ds}, {C.fs_base}).2
    show by defs(simp(vf, top, limit, brk0, brk, byWC, fr, hd, ow, pg, nostk, st, rs2, keep(abi.in_domain, abi.stack_page, abi.stack_reserve, abi.objs_at, abi.canary)), abi.world_matches)
  qed
  have vok: abi.view_ok(C, ds, WV) := conj(wpg, wmC)
  // the stack objects
  have {oacc} := hmm
  have spc: abi.sp(C) = R by simp(c4, rb, r16, rlt)
  have ook: tr.objs_ok(C, ds) proof
    have g: all x. x in omega -> x in ds -> (int_le(abi.sp(C), x) && abi.stack_page(C.vm, int_div(x, x86_64_linux.PAGE))) && x86_64_linux.can_access(C.vm, bits_of_int(64, x), 1) proof
      fix x
      assume h1 h2
      have o ca := mp(all_elim(oacc, {x}), h1, h2)
      have sp8: abi.sp(s) = int_add(S, 8) by simp(sb, slt)
      have xpo: int_div(x, x86_64_linux.PAGE) in omega by defs(simp(h1), x86_64_linux.PAGE)
      // (its page: m's in C, so accessible)
      have mc: x86_64_linux.mapped(m.vm, x86_64_linux.page_of(bits_of_int(64, x))) by taut(expand(ca, x86_64_linux.can_access))
      have pgo: x86_64_linux.page_of(bits_of_int(64, x)) in omega by defs(simp(), x86_64_linux.page_of)
      have pi := apply(tr.pages_eq_mapped, {m.vm}, {C.vm}, {L}, {P0}, {x86_64_linux.page_of(bits_of_int(64, x))}, cpi, pgo, mc)
      have cc := apply(tr.access_page, {C.vm}, {m.vm}, {bits_of_int(64, x)}, {bits_of_int(64, x)}, {1}, refl({x86_64_linux.page_of(bits_of_int(64, x))}), pi)
      // a caller's: above sp, on the entry's stack pages (C's)
      have k1: int_le(abi.sp(s), x) && abi.stack_page(s.vm, int_div(x, x86_64_linux.PAGE)) -> int_le(abi.sp(C), x) && abi.stack_page(C.vm, int_div(x, x86_64_linux.PAGE)) proof
        assume h
        have sa sp0 := h
        have l: int_le(abi.sp(C), x) by arith(sa, spc, sp8, rs, so, h1)
        have xl: int_le(P0, int_div(x, x86_64_linux.PAGE)) by defs(arith(sa, sp8, sb, slt, h1), x86_64_linux.PAGE)
        have sc := mp(all_elim(kspc, {int_div(x, x86_64_linux.PAGE)}), xpo, sp0, xl)
        show by taut(l, sc)
      qed
      // an own one: at or above rsp, on a stack page of m (C's)
      have k2: tr.own(s, m, x) -> int_le(abi.sp(C), x) && abi.stack_page(C.vm, int_div(x, x86_64_linux.PAGE)) proof
        assume h
        have xl0 hsp := h
        have {er4} := apply(tr.inv_call, hi)
        have ra := mp(all_elim(hofr, {x}), h1, h2, xl0)
        have l: int_le(abi.sp(C), x) by arith(ra, er4, spc)
        have sm := expand(hsp, abi.stack_page, x86_64_linux.mapped)
        have xl: int_lt(x, 18446744073709551616) by simp(h1, expand(sm, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))
        have xb: bits_of_int(64, x) = x by simp(h1, xl)
        have pe: x86_64_linux.page_of(bits_of_int(64, x)) = int_div(x, x86_64_linux.PAGE) by defs(simp(xb), x86_64_linux.page_of)
        have pi2 := rewrite(pe, pi)
        have sc: abi.stack_page(C.vm, int_div(x, x86_64_linux.PAGE)) by defs(simp(pi2, sm), abi.stack_page, x86_64_linux.mapped)
        show by taut(l, sc)
      qed
      show by taut(o, k1, k2, cc, ca)
    qed
    show by defs(g, tr.objs_ok)
  qed
  // the callee's world: the caller's
  have we := apply(tr.world_eta, wW)
  have ccw: C.cpu = w.cpu := trans(cc0, trans(mcpu, sym(wcpu)))
  have cow: C.os = w.os := trans(co, mos)
  have veq: abi.view(C, ds, WV) = w by simp(we, cow, cfs0, ccw, mo.2, wfs, keep(abi.objs_at))
  have wvv: WV in x86_64_linux.Vm by simp(expand(wW, abi.World))
  have op := apply(abi.objs_parts, (w.objs in abi.Objs by simp(expand(wW, abi.World))))
  have ol := rewrite(mo.2, op.1)
  have dso: ds in set_type(omega) := rewrite(all_elim(abi.objs_at_live, {ds}, {s.fs_base}).1, ol)
  show by taut(eoku, eok, vok, ook, veq, wvv, dso)
qed

// A callee's contract at a call from a frame of fr bytes: the ABI's (its
// entry aligned), or one for any entry
def tr.callee_contract(fr, f, g, cb, cc, st) := (int_mod(fr, 16) = 8 && tr.implements_at(f, g, cb, cc, st)) || tr.implements_at_u(f, g, cb, cc, st)

// the homes: within the frame (at or above the call's rsp, S - fr)
def tr.hin(hs, fr) := all c. c in dom(hs) -> int_le(int_sub(18446744073709551616, fr), c)

theorem tr.hin_empty: all fr. tr.hin(empty, fr)
proof
  fix fr
  show by defs(simp(dom_empty), tr.hin)
qed

theorem tr.hin_upd: all hs fr c x. tr.hin(hs, fr) -> int_le(int_sub(18446744073709551616, fr), c) -> tr.hin(fn_update(hs, c, x), fr)
proof
  fix hs fr c x
  assume h hc
  have g: all k. k in dom(fn_update(hs, c, x)) -> int_le(int_sub(18446744073709551616, fr), k) proof
    fix k
    assume hk
    have cs := apply(tr.dom_cases, hk)
    have c1: k = c -> int_le(int_sub(18446744073709551616, fr), k) proof
      assume e
      show := rewrite(sym(e), hc)
    qed
    have c2: k in dom(hs) -> int_le(int_sub(18446744073709551616, fr), k) proof
      assume hd
      show := mp(all_elim(expand(h, tr.hin), {k}), hd)
    qed
    show by taut(cs, c1, c2)
  qed
  show by defs(g, tr.hin)
qed

// (an access allowed: its page's entry only, the page a user one)
theorem tr.access_entry: all v1 v2 a b k. v1.pages[x86_64_linux.page_of(a)] = v2.pages[x86_64_linux.page_of(b)] ->
  int_lt(x86_64_linux.page_of(a), int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) -> x86_64_linux.can_access(v2, b, k) -> x86_64_linux.can_access(v1, a, k)
proof
  fix v1 v2 a b k
  assume he hl hc
  show by defs(simp(he, hl, expand(hc, x86_64_linux.can_access, x86_64_linux.mapped), keep(x86_64_linux.page_of, x86_64_linux.hw_allows)), x86_64_linux.can_access, x86_64_linux.mapped)
qed

// The callee returned (x, its world w2, from C on the caller's world w):
// the caller's coupling at the return address with the world W4 (w2 with
// the caller's stack objects) -- its homes (within the frame) kept, the
// frame from the push up accessible (the stack's pages one run), rax:rdx
// the result, the callee-saved registers (rs's part rc) as they were
theorem tr.post_call: all s base code fr m w ds RA T m1 e1 C x w2 hs fd rs rc. tr.inv(s, base, code, fr, m, w) -> tr.cfr(fr) -> tr.mem(s, m, w, ds) -> base in omega -> RA in bits(64) -> T in bits(64) ->
  runs(x86_64_linux.touch_range(bits_sub(64, m.gpr[4], 8), 8, 1), fn_update(m, "rip", RA), ok(m1, e1)) ->
  C = fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, bits_sub(64, m.gpr[4], 8), 8, RA))),
    "gpr", fn_update(m1.gpr, 4, bits_sub(64, m.gpr[4], 8))), "rip", T) ->
  tr.returns_valid(w, w2) ->
  x in x86_64_linux.Machine -> x in univ(1) -> w2 in abi.World -> w2 in univ(1) ->
  abi.world_matches(C.vm, x.vm, w2.vm, abi.wob(ds, w2.objs.c_bytes), C.fs_base, abi.sp(C)) -> x.os = w2.os -> x.fs_base = C.fs_base ->
  x.cpu = C.cpu -> x.gs_base = C.gs_base -> x.rip = abi.ret(C) -> x.gpr[4] = abi.sp(C) ->
  abi.callee_saved(x, C) -> !x.flags.df ->
  tr.homes(s, m, hs) -> tr.hap(s, hs, ds) -> tr.ofr(s, fr, ds) -> tr.hin(hs, fr) -> fd in omega -> int_le(fd, int_add(fr, 8)) -> tr.regs(m, rs) -> tr.cs_sub(rc, rs) ->
  tr.inv(s, base, code, fr, x, gc.back(w2, w)) && tr.mem(s, x, gc.back(w2, w), ds) &&
  tr.homes(s, x, hs) && tr.frame(s, x, fd) &&
  tr.regs(x, fn_update(fn_update(rc, 0, pair(8, x.gpr[0])), 2, pair(8, x.gpr[2]))) && x.rip = RA
proof
  fix s base code fr m w ds RA T m1 e1 C x w2 hs fd rs rc
  assume hi hcf hmm hbo hra ht htr hC hrv xM xu w2W w2u hwm0 xos xfs xcpu xgs xrip xr4 xcs xdf hh hap hob hin hfo hfd hrs hsub
  let S := s.gpr[4]
  let R := m.gpr[4]
  let L := int_div(int_sub(R, 8), 4096)
  let P0 := int_div(S, 4096)
  let XV := x.vm
  let W4 := gc.back(w2, w)
  have {sM, mM, mu, wW, wu, wcpu, mos, mfs, er4, sb, slt, sal, hsps, sgf, srsv, winp, sws, mcpu, mgs, mdf} := apply(tr.inv_call, hi)
  have {cd, kc, ra8, sacc} := hi
  have {rb, r16, rlt, ral, rs, rS, sg} := apply(tr.call_rsp, hi, hcf)
  have {lr, rl, rp, gap} := apply(tr.call_pages, {S}, {R}, rb, r16, ral, rs, rS, sb)
  have so: S in omega by simp(sb)
  have ro: R in omega by simp(rb)
  have sp8: abi.sp(s) = int_add(S, 8) by simp(sb, slt)
  have cM cu co cf cc0 cgs cfl cgpr crip ckc cvf cle cpi cby cstk cacc := apply(tr.push_ok, {s}, {base}, {code}, {fr}, {m}, {w}, {RA}, {T}, {m1}, {e1}, {C}, hi, hcf, hra, ht, htr, hC)
  have rinp rev rld rcpu rbk := expand(hrv, tr.returns_valid)
  // (the thread pointer: the entry's throughout)
  have {mfs0, scan} := hi
  have cfs0: C.fs_base = s.fs_base := trans(cf, mfs0)
  have sfb: s.fs_base in bits(64) by simp(expand(sM, x86_64_linux.Machine))
  have hwm := rewrite(cfs0, hwm0)
  have {top, limit, brk0, brk, bytes, frames, hid, own = c_bytes, pages, nostk, stk, rsv} := hwm
  have {wob, wm, hlv} := hmm
  have {mpages = pages, mnostk = nostk, mrsv = rsv} := expand(hmm, tr.mem).wm
  have spc: abi.sp(C) = R by simp(cgpr, rb, r16, rlt)
  have lv := all_elim(abi.objs_at_live, {ds}, {s.fs_base})
  // (a stack page of m: C's; from L up, x's as C's)
  have mc: all p. p in omega -> abi.stack_page(m.vm, p) -> C.vm.pages[p] = m.vm.pages[p] proof
    fix p
    assume hp hsp
    have pi := mp(all_elim(expand(cpi, x86.pages_in), {p}), hp)
    have nn: !(m.vm.pages[p] = none) by simp(expand(hsp, abi.stack_page, x86_64_linux.mapped))
    show by taut(pi, nn)
  qed
  have cx: all p. p in omega -> abi.stack_page(C.vm, p) -> int_le(L, p) -> XV.pages[p] = C.vm.pages[p] proof
    fix p
    assume hp hsp hl
    have lp: int_le(int_div(int_sub(abi.sp(C), 8), x86_64_linux.PAGE), p) by defs(simp(spc, hl), x86_64_linux.PAGE)
    show := mp(all_elim(stk, {p}), hp, conj(hsp, lp))
  qed
  // (the entry's stack pages from its rsp up: C's, x's as s's)
  have pst: all p. p in omega -> abi.stack_page(s.vm, p) -> int_le(P0, p) ->
      C.vm.pages[p] = s.vm.pages[p] && XV.pages[p] = s.vm.pages[p] proof
    fix p
    assume hp hsp hl
    have k2 := apply(tr.inv_stack, {s}, {base}, {code}, {fr}, {m}, {w}, {ds}, {p}, hi, hmm, hp, hsp, hl)
    have smp: abi.stack_page(m.vm, p) by defs(rewrite(sym(k2), expand(hsp, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
    have ec := trans(mp(all_elim(mc, {p}), hp, smp), k2)
    have scp: abi.stack_page(C.vm, p) by defs(rewrite(sym(ec), expand(hsp, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
    have xc0 := mp(all_elim(cx, {p}), hp, scp, (int_le(L, p) by arith(hl, lr, rp)))
    show conj(ec, trans(xc0, ec))
  qed
  have p0o: P0 in omega by simp(so)
  have ps0 := mp(all_elim(pst, {P0}), p0o, hsps, (int_le(P0, P0) by arith(p0o)))
  // (a stack page of x's: none of the world's -- the world has no stack pages)
  have nw: all q. q in omega -> abi.stack_page(XV, q) -> w2.vm.pages[q] = none proof
    fix q
    assume hq hsq
    have sm := expand(hsq, abi.stack_page, x86_64_linux.mapped)
    have qp: q in gc.PN by simp(hq, sm)
    have c := mp(all_elim(pages, {q}), qp)
    have d: !(w2.vm.pages[q] = none) -> false proof
      assume hn
      have e2: XV.pages[q] = w2.vm.pages[q] by taut(c, hn)
      have k := mp(all_elim(nostk, {q}), qp, hn)
      have k2: snd(XV.pages[q]).kind = 2 by taut(sm)
      have k3 := rewrite(e2, k2)
      show by taut(k3, k)
    qed
    show by taut(d)
  qed
  // (a byte at or above R, on a stack page of m, not an object: x's as m's)
  have xb: all a. a in bits(64) -> int_le(R, a) -> !(a in ds) -> abi.stack_page(m.vm, int_div(a, 4096)) ->
      XV.bytes[a] = m.vm.bytes[a] proof
    fix a
    assume ha hl hn hsp
    have ao: a in omega by simp(ha)
    have po: int_div(a, 4096) in omega by simp(ha)
    have pe: x86_64_linux.page_of(a) = int_div(a, 4096) by defs(simp(), x86_64_linux.page_of, x86_64_linux.PAGE)
    have e1 := mp(all_elim(mc, {int_div(a, 4096)}), po, hsp)
    have sm := expand(hsp, abi.stack_page, x86_64_linux.mapped)
    have scp: abi.stack_page(C.vm, int_div(a, 4096)) by defs(simp(e1, sm), abi.stack_page, x86_64_linux.mapped)
    have pl: int_le(L, int_div(a, 4096)) by simp(hl, ro, ao, r16)
    have e2 := mp(all_elim(cx, {int_div(a, 4096)}), po, scp, pl)
    have sxp: abi.stack_page(XV, int_div(a, 4096)) by defs(simp(e2, e1, sm), abi.stack_page, x86_64_linux.mapped)
    have w2n := mp(all_elim(nw, {int_div(a, 4096)}), po, sxp)
    have nd: !abi.in_domain(w2.vm, abi.wob(ds, w2.objs.c_bytes), a) by defs(simp(hn, w2n, lv, keep(abi.objs_at)), abi.in_domain, x86_64_linux.mapped, x86_64_linux.PAGE)
    have sc: abi.stack_page(C.vm, x86_64_linux.page_of(a)) := rewrite(sym(pe), scp)
    have l2: int_le(abi.sp(C), a) by simp(spc, hl)
    have lns: (int_le(abi.sp(C), a) && !abi.in_domain(w2.vm, abi.wob(ds, w2.objs.c_bytes), a)) && abi.stack_page(C.vm, x86_64_linux.page_of(a)) by taut(l2, nd, sc)
    have f := mp(all_elim(frames, {a}), ha, lns)
    have nr: !(int_le(int_sub(R, 8), a) && int_lt(a, R)) by arith(hl, ro, ao)
    have mm: x86_64_linux.mapped(m.vm, x86_64_linux.page_of(a)) by defs(simp(pe, sm), x86_64_linux.mapped)
    have cb := mp(all_elim(cby, {a}), ha, nr, mm)
    show := trans(f, cb)
  qed
  // (the frame from R - 8 up to S: accessible stack pages of x -- the
  // stack's run from the push's page to S's)
  have rsvx: abi.stack_reserve(XV) := mp(rsv, mp(expand(cstk, x86.stk_ext).2, mp(mrsv, srsv)))
  have sgfC := apply(abi.reserve_gap, mp(expand(cstk, x86.stk_ext).2, mp(mrsv, srsv)))
  have a00 := mp(all_elim(cacc, {0}), simp(), simp())
  have ea: bits_add(64, int_sub(R, 8), bits_of_int(64, 0)) = int_sub(R, 8) by arith(ro, r16, rlt)
  have acc0 := rewrite(ea, a00)
  have p0c: abi.stack_page(C.vm, P0) by defs(simp(ps0.1, expand(hsps, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
  have spL := apply(tr.push_page_stack, {C.vm}, {S}, {R}, rb, r16, ral, rs, rS, sb, sgfC, p0c, acc0)
  // (the stack protector's word: off the stack, so not the push's; x's as
  // s's, writable)
  have hwx: all a. a in bits(64) -> a in abi.canary(s.fs_base) ->
      XV.bytes[a] = s.vm.bytes[a] && XV.pages[x86_64_linux.page_of(a)] = s.vm.pages[x86_64_linux.page_of(a)] &&
      x86_64_linux.can_access(m.vm, a, 1) && x86_64_linux.can_access(XV, a, 1) proof
    fix a
    assume ha hh
    have hca: a in abi.canary(s.fs_base) := hh
    have km kn kp kb := apply(tr.hid_at, {s}, {m}, {w}, {ds}, {a}, hmm, scan, sfb, ha, hca)
    have mw := apply(tr.hid_write, {s}, {m}, {w}, {ds}, {a}, hmm, scan, sfb, ha, hca)
    have pe: x86_64_linux.page_of(a) = int_div(a, x86_64_linux.PAGE) by defs(simp(), x86_64_linux.page_of)
    have po: int_div(a, x86_64_linux.PAGE) in omega by defs(simp(ha), x86_64_linux.PAGE)
    have cpe := apply(tr.pages_eq_mapped, {m.vm}, {C.vm}, {L}, {P0}, {int_div(a, x86_64_linux.PAGE)}, cpi, po, km)
    // (not the push's 8 bytes: those on a stack page of C, this not)
    have np: int_le(int_sub(R, 8), a) && int_lt(a, R) -> false proof
      assume hr
      have ao: a in omega by simp(ha)
      have j0: int_sub(a, int_sub(R, 8)) in omega by arith(hr, ao, ro)
      have j8: int_lt(int_sub(a, int_sub(R, 8)), 8) by arith(hr)
      have _ pa2 := apply(tr.push_at, {R}, {int_sub(a, int_sub(R, 8))}, rb, r16, rlt, ral, j0, j8)
      have ea2: int_add(int_sub(R, 8), int_sub(a, int_sub(R, 8))) = a by arith(ro, ao)
      have pg: int_div(a, 4096) = int_div(int_sub(R, 8), 4096) := rewrite(ea2, pa2)
      have spa: abi.stack_page(C.vm, int_div(a, x86_64_linux.PAGE)) by defs(simp(pg, spL), x86_64_linux.PAGE)
      have nsc: !abi.stack_page(C.vm, int_div(a, x86_64_linux.PAGE)) by defs(simp(cpe, expand(kn, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
      show by taut(spa, nsc)
    qed
    have cb := mp(all_elim(cby, {a}), ha, (!(int_le(int_sub(R, 8), a) && int_lt(a, R)) by taut(np)), rewrite(sym(pe), km))
    have xh := mp(all_elim(hid, {a}), ha, hh)
    have xb0: XV.bytes[a] = s.vm.bytes[a] by simp(xh, cb, kb)
    have xp0: XV.pages[x86_64_linux.page_of(a)] = m.vm.pages[x86_64_linux.page_of(a)] by simp(xh, pe, cpe)
    have xp: XV.pages[x86_64_linux.page_of(a)] = s.vm.pages[x86_64_linux.page_of(a)] by simp(xp0, pe, kp)
    have ac := apply(tr.access_page, {XV}, {m.vm}, {a}, {a}, {1}, refl({x86_64_linux.page_of(a)}), xp0)
    have xw: x86_64_linux.can_access(XV, a, 1) by taut(ac, mw)
    show := conj(xb0, xp, mw, xw)
  qed
  // the program loaded at x: loaded at m, the world, the callee's world
  have chain: all gb gc st. gb in omega -> abi.loaded(m.vm, gb, gc, st) -> abi.loaded(XV, gb, gc, st) proof
    fix gb gc st
    assume hb l1
    have hm: all a. a in bits(64) -> a in abi.canary(s.fs_base) -> x86_64_linux.can_access(m.vm, a, 1) proof
      fix a
      assume ha hh
      show := mp(all_elim(hwx, {a}), ha, hh).3
    qed
    have hx: all a. a in bits(64) -> a in abi.canary(s.fs_base) -> x86_64_linux.can_access(XV, a, 1) proof
      fix a
      assume ha hh
      show := mp(all_elim(hwx, {a}), ha, hh).4
    qed
    have l2 := apply(tr.wm_back, wm, hm, l1)
    have l4 := mp(all_elim(rld, {gb}, {gc}, {st}), hb, l2)
    show := apply(tr.wm_fwd, hwm, hx, l4)
  qed
  have kcx: tr.keeps_code(s.vm, XV) proof
    have g: all gb gc st. gb in omega -> abi.loaded(s.vm, gb, gc, st) -> abi.loaded(XV, gb, gc, st) proof
      fix gb gc st
      assume hb hl
      have l1 := mp(all_elim(expand(kc, tr.keeps_code), {gb}, {gc}, {st}), hb, hl)
      show := mp(all_elim(chain, {gb}, {gc}, {st}), hb, l1)
    qed
    show by defs(g, tr.keeps_code)
  qed
  have lm: abi.loaded(m.vm, base, code, empty) by defs(simp(cd), abi.loaded)
  have lx := mp(all_elim(chain, {base}, {code}, {empty}), hbo, lm)
  have cdx := expand(lx, abi.loaded).1
  have lo: L in omega by simp(rb, r16)
  have xL := mp(all_elim(cx, {L}), lo, spL, (int_le(L, L) by arith(lo)))
  have spLx: abi.stack_page(XV, L) by defs(simp(xL, expand(spL, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
  have spPx: abi.stack_page(XV, P0) by defs(simp(ps0.2, expand(hsps, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
  have pL: x86_64_linux.page_of(int_sub(R, 8)) = L by defs(simp(), x86_64_linux.page_of, x86_64_linux.PAGE)
  have fa: all X. X in omega -> int_le(int_sub(R, 8), X) -> int_lt(X, S) ->
      x86_64_linux.can_access(XV, X, 1) && abi.stack_page(XV, int_div(X, 4096)) proof
    fix X
    assume hx h1 h2
    have xo: int_div(X, 4096) in omega by simp(hx)
    have q1: int_le(L, int_div(X, 4096)) by simp(h1, ro, r16, hx)
    have q2: int_le(int_div(X, 4096), P0) by simp(h2, hx, so)
    have eq := apply(tr.stack_run, {XV}, {L}, {P0}, {int_div(X, 4096)}, rsvx, spLx, spPx, lo, p0o, xo, q1, q2)
    have pX: x86_64_linux.page_of(X) = int_div(X, 4096) by defs(simp(), x86_64_linux.page_of, x86_64_linux.PAGE)
    have eq2: XV.pages[x86_64_linux.page_of(X)] = C.vm.pages[x86_64_linux.page_of(int_sub(R, 8))] by simp(pX, pL, eq, xL)
    have tl0: int_lt(int_div(X, 4096), int_div(x86_64_linux.TASK_SIZE, 4096)) by arith(q2, expand(spPx, abi.stack_page, x86_64_linux.mapped, x86_64_linux.PAGE))
    have tl: int_lt(x86_64_linux.page_of(X), int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) by defs(simp(pX, tl0), x86_64_linux.PAGE)
    have ca := apply(tr.access_entry, {XV}, {C.vm}, {X}, {int_sub(R, 8)}, {1}, eq2, tl, acc0)
    have sx: abi.stack_page(XV, int_div(X, 4096)) by defs(simp(eq, tl0, expand(spLx, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped, x86_64_linux.PAGE)
    show conj(ca, sx)
  qed
  have frx: tr.frame(s, x, fd) proof
    have g: all i. i in omega -> int_lt(i, fd) ->
        x86_64_linux.can_access(XV, bits_add(64, tr.ha(s, int_sub(18446744073709551616, fd)), bits_of_int(64, i)), 1) &&
        abi.stack_page(XV, int_div(bits_add(64, tr.ha(s, int_sub(18446744073709551616, fd)), bits_of_int(64, i)), 4096)) proof
      fix i
      assume i1 i2
      have hr0: tr.hrange(int_sub(18446744073709551616, fd), fd) by defs(arith(hfo, hfd, expand(hcf, tr.cfr), i1, i2), tr.hrange)
      have e xo xl .. := apply(tr.ha_byte, {S}, {int_sub(18446744073709551616, fd)}, {fd}, {i}, sb, sg, hr0, i1, i2)
      have l1: int_le(int_sub(R, 8), int_add(int_sub(S, int_sub(18446744073709551616, int_sub(18446744073709551616, fd))), i)) by arith(er4, hfd, i1, hfo)
