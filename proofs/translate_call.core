// A call in the translation (docs/bridge-pattern-design.md, step 8): the
// machine's `call` against readable GIMPLE's call_at -- the push (a fault:
// a crash or GIMPLE's undefined call), the callee's contract
// (tr.implements_at) on its entry state, the caller's run split at the
// callee's return (tr.run_split), and the claim after the call.
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core core/records.core \
//     core/list.core core/loop.core build/c_mallocng_malloc.core proofs/x86.core proofs/x86_code.core \
//     proofs/x86_stack.core proofs/x86_insn.core proofs/abi.core proofs/abi_restore.core proofs/abi_glue.core \
//     proofs/gimple.core proofs/gimple_call.core proofs/abi_stack.core proofs/abi_loop.core proofs/abi_bridge.core \
//     proofs/translate.core proofs/translate_store_loop.core proofs/translate_call.core

// ----------------------------------------------------------------------
//  Generic pieces

// a step that may fault: its successors' claims, and every fault a crash
// or undefined
theorem tr.step_x(s, v, p, w, m, x. q, x y. qx): (all o. runs(x86_64_linux.step(), m, o) -> (ex m2. o = ok(m2, empty) && q(m2)) || (ex x e. o = exc(x, e) && qx(x, e))) ->
  int_lt(app(app(m, "gpr"), 4), abi.sp(s)) -> (all m2. q(m2) -> tr.sim(s, v, p, w, m2)) ->
  (all x e. qx(x, e) -> tr.ub(s, v, p, w) || tr.crash(s, p, w, exc(x, e))) -> tr.sim(s, v, p, w, m)
proof
  assume hs hlt h hx
  have hn0: app(app(m, "gpr"), 4) = abi.sp(s) -> false proof
    assume e
    have l2 := rewrite(e, hlt)
    show by arith(l2)
  qed
  have hn: !(app(m, "rip") = abi.ret(s) && app(app(m, "gpr"), 4) = abi.sp(s)) by taut(hn0)
  have dok: tr.disc_ok(s, fst(pair(m, empty))) by simp(hlt)
  have hbd: all r. tr.rbd(s, pair(m, empty), r) -> tr.rb(s, pair(m, empty), r) proof
    fix r
    assume hb
    show by taut(expand(hb, tr.rbd), dok)
  qed
  // the pass from m: a step to some m2 with q, or a fault
  have hb_ok: all l1. tr.rb(s, pair(m, empty), ok(l1, empty)) -> (ex m2. l1 = pair(m2, empty) && q(m2)) proof
    fix l1
    assume hb
    have b1: ex x1. runs(x86_64_linux.step(), m, x1) && (ex x2 x3. x1 = ok(x2, x3) && l1 = pair(x2, empty)) by simp(expand(hb, tr.rb), hn, keep(x86_64_linux.step))
    obtain x1, c1 from b1
    have e := mp(all_elim(hs, {x1}), taut(c1))
    have c2: (ex x e. x1 = exc(x, e) && qx(x, e)) -> false proof
      assume ex
      obtain x e3, ex3 from ex
      show by simp(c1, ex3, keep(x86_64_linux.step))
    qed
    have e1: ex m2. x1 = ok(m2, empty) && q(m2) by taut(e, c2)
    obtain m2, e2 from e1
    have l1e: l1 = pair(m2, empty) by simp(c1, e2, keep(x86_64_linux.step))
    show by ex_intro({m2}, taut(l1e, e2))
  qed
  have hb_nok: all r. tr.rb(s, pair(m, empty), r) -> !is_ok(r) -> (ex x e. r = exc(pair(x, empty), pair("raise", e)) && qx(x, e)) proof
    fix r
    assume hb hn2
    have b1: ex x1. runs(x86_64_linux.step(), m, x1) && ((ex x2 x3. x1 = ok(x2, x3) && r = ok(pair(x2, empty), empty)) ||
      (ex x2 x3. x1 = exc(x2, x3) && r = exc(pair(x2, empty), pair("raise", x3))) || (ex x2. x1 = diverge(x2) && r = diverge(x2))) by simp(expand(hb, tr.rb), hn, keep(x86_64_linux.step))
    obtain x1, c1 from b1
    have e := mp(all_elim(hs, {x1}), taut(c1))
    have k1: (ex m2. x1 = ok(m2, empty) && q(m2)) -> (ex x e. r = exc(pair(x, empty), pair("raise", e)) && qx(x, e)) proof
      assume ek
      obtain m2, e2 from ek
      show by simp(c1, e2, hn2, keep(x86_64_linux.step))
    qed
    have k2: (ex x e. x1 = exc(x, e) && qx(x, e)) -> (ex x e. r = exc(pair(x, empty), pair("raise", e)) && qx(x, e)) proof
      assume ek
      obtain x e3, ek3 from ek
      have re: r = exc(pair(x, empty), pair("raise", e3)) by simp(c1, ek3, keep(x86_64_linux.step))
      show by ex_intro({x}, {e3}, taut(re, ek3.2))
    qed
    show by taut(e, k1, k2)
  qed
  have hk: all m2 r o2. q(m2) -> tr.rwd(s, pair(m2, empty), r) -> tr.rmap(r, o2) -> tr.ub(s, v, p, w) || tr.ok(s, v, p, w, o2) || tr.crash(s, p, w, o2) proof
    fix m2 r o2
    assume hq hw hm
    have rf: tr.run_d(s, m2, o2) by defs(ex_intro({r}, taut(hw, hm)), tr.run_d)
    show := mp(all_elim(expand(mp(all_elim(h, {m2}), hq), tr.sim), {o2}), rf)
  qed
  have g: all o. tr.run_d(s, m, o) -> tr.ub(s, v, p, w) || tr.ok(s, v, p, w, o) || tr.crash(s, p, w, o) proof
    fix o
    assume ho
    obtain x4, hw hm from expand(ho, tr.run_d)
    let W(l, r) := while_rel(l, x5. true, x5 x6. tr.rbd(s, x5, x6), x5. fn_update(empty, "os.events", app(app(fst(x5), "os"), "events")), r)
    have u := mp(while_unroll[l0 := pair(m, empty), c := l. true, b := l o. tr.rbd(s, l, o),
      tr := l. fn_update(empty, "os.events", app(app(fst(l), "os"), "events")), r := x4], expand(hw, tr.rwd))
    // (the first pass faults: the run's outcome that fault)
    have fl: tr.rbd(s, pair(m, empty), x4) && !is_ok(x4) -> tr.ub(s, v, p, w) || tr.ok(s, v, p, w, o) || tr.crash(s, p, w, o) proof
      assume hf
      have rb := mp(all_elim(hbd, {x4}), hf.1)
      have ef := mp(all_elim(hb_nok, {x4}), rb, hf.2)
      obtain x e, xe q3 from ef
      have hm2 := rewrite(xe, hm)
      have oe: o = exc(x, e) by simp(expand(hm2, tr.rmap))
      have c := mp(all_elim(hx, {x}, {e}), q3)
      have c2: tr.ub(s, v, p, w) || tr.ok(s, v, p, w, exc(x, e)) || tr.crash(s, p, w, exc(x, e)) by taut(c)
      show := rewrite(sym(oe), c2)
    qed
    // (the loop goes on from m2)
    have on: (ex l1. tr.rbd(s, pair(m, empty), ok(l1, empty)) && (ex r1. W(l1, r1) && fst(r1) = fst(x4) && (!(fst(x4) = 2) -> r1 = x4))) ->
        tr.ub(s, v, p, w) || tr.ok(s, v, p, w, o) || tr.crash(s, p, w, o) proof
      assume e
      obtain l1, rbd1 e1b from e
      have rb1 := mp(all_elim(hbd, {ok(l1, empty)}), rbd1)
      obtain m2, l1e hq from mp(all_elim(hb_ok, {l1}), rb1)
      obtain r1, w0 f4 re4 from e1b
      have w1: tr.rwd(s, pair(m2, empty), r1) by defs(rewrite(l1e, w0), tr.rwd)
      have same: !(fst(x4) = 2) -> tr.ub(s, v, p, w) || tr.ok(s, v, p, w, o) || tr.crash(s, p, w, o) proof
        assume nd
        have re := mp(re4, nd)
        show := mp(mp(mp(all_elim(hk, {m2}, {r1}, {o}), hq), w1), rewrite(sym(re), hm))
      qed
      have div: fst(x4) = 2 -> tr.ub(s, v, p, w) || tr.ok(s, v, p, w, o) || tr.crash(s, p, w, o) proof
        assume d
        have d1: fst(r1) = 2 by simp(f4, d)
        have c := mp(mp(mp(all_elim(hk, {m2}, {r1}, {diverge(snd(r1))}), hq), w1), defs(simp(d1), tr.rmap))
        have nk := all_elim(tr.ok_not_div, {s}, {v}, {p}, {w}, {snd(r1)})
        have nc := all_elim(tr.crash_not_div, {s}, {p}, {w}, {snd(r1)})
        show by taut(c, nk, nc)
      qed
      show by taut(same, div)
    qed
    show by taut(u, on, fl)
  qed
  show by defs(g, tr.sim)
qed

// an operation that changes the world: the spec's rest from its result
theorem tr.qs_call(op, w4, r, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k): all w. w in univ(1) -> runs(op, w, ok(w4, r)) ->
  (all o. runs(mkprog(x0 x1. ex x8. a(x0, r, x8) && k(x8, x1)), w4, o) ->
    runs(mkprog(x0 x1. ex x8. bind_rel(op, x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), w, o))
proof
  fix w
  assume hwu hq
  fix o
  assume h0
  have hu: pair(w4, o) in univ(1) && (ex x8. a(w4, r, x8) && k(x8, o)) by simp(expand(expand(h0, runs), mkprog))
  have pu: pair(w, o) in univ(1) by simp(hu, hwu)
  obtain y, hy from hu.2
  have ay := hy.1
  have e: ex o2. runs(op, w, o2) && ((ex s1 v. o2 = ok(s1, v) && a(s1, v, y)) || (ex s1 e. o2 = exc(s1, e) && xx(s1, e, y)) || (ex t. o2 = diverge(t) && dd(t, y)))
    by ex_intro({ok(w4, r)}, simp(hq, ay))
  have b: bind_rel(op, w, x9 x10. a(x9, x10, y), x9 x10. xx(x9, x10, y), x9. dd(x9, y)) by defs(e, bind_rel)
  have g: ex x8. bind_rel(op, w, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, o) by ex_intro({y}, taut(b, hy))
  show := mp(all_elim(tr.runs_intro[r := x0 x1. ex x8. bind_rel(op, x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)], {w}, {o}), pu, g)
qed

// the procedure's rest raising: the function raising
theorem tr.p_exc(q, x3 x4 x2. kw): all w x e. w in univ(1) -> x in univ(1) -> e in univ(1) -> runs(q, w, exc(x, e)) ->
  runs(mkprog(x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, exc(x, e))
proof
  fix w x e
  assume hw hx he hr
  have b0: ex o2. runs(q, w, o2) && ((ex s1 v. o2 = ok(s1, v) && kw(s1, v, exc(x, e))) || (ex s1 e1. o2 = exc(s1, e1) && exc(x, e) = exc(s1, e1)) ||
    (ex t. o2 = diverge(t) && exc(x, e) = diverge(t))) by ex_intro({exc(x, e)}, simp(hr))
  have b: bind_rel(q, w, x3 x4. kw(x3, x4, exc(x, e)), x3 x4. exc(x, e) = exc(x3, x4), x3. exc(x, e) = diverge(x3)) by defs(b0, bind_rel)
  have pu: pair(w, exc(x, e)) in univ(1) by simp(hw, hx, he)
  show := mp(all_elim(tr.runs_intro[r := x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))], {w}, {exc(x, e)}), pu, b)
qed

// ... at a call: the call raising
theorem tr.call_exc(g, args, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all w x e. w in univ(1) -> x in univ(1) -> e in univ(1) ->
  runs(gimple.call1(g, args), w, exc(x, e)) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e)) ->
  runs(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, exc(x, e))
proof
  fix w x e
  assume hw hx he hc hk
  have q := mp(all_elim(mp(all_elim(tr.qs_raise[op := gimple.call1(g, args), s2 := x, e := e, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1)], {w}), hc), {exc(x, e)}), hk)
  show := apply(tr.p_exc[q := mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), kw := x3 x4 x2. kw(x3, x4, x2)],
    {w}, {x}, {e}, hw, hx, he, q)
qed

// (a one-element list)
theorem tr.seq_one_type: all x t. x in t -> seq_one(x) in list_type(t)
proof
  fix x t
  assume hx
  have mem: all z. z in seq_one(x) -> z = pair(0, x) proof
    fix z
    assume hz
    show := mp(single_elim[a := pair(0, x), z := z], expand(hz, seq_one))
  qed
  have f1: all z. z in seq_one(x) -> (ex a b. z = pair(a, b)) proof
    fix z
    assume hz
    have e := mp(all_elim(mem, {z}), hz)
    show by ex_intro({0}, {x}, e)
  qed
  have f2: all a b c. pair(a, b) in seq_one(x) -> pair(a, c) in seq_one(x) -> b = c proof
    fix a b c
    assume h1 h2
    have e1 := mp(all_elim(mem, {pair(a, b)}), h1)
    have e2 := mp(all_elim(mem, {pair(a, c)}), h2)
    show by simp(e1, e2)
  qed
  have fu: is_fun(seq_one(x)) by defs(taut(f1, f2), is_fun)
  have ss: all z. z in seq_one(x) -> z in cart(omega, t) proof
    fix z
    assume hz
    have e := mp(all_elim(mem, {z}), hz)
    have c := mp(mp(cart_intro[a := omega, b := t, x := 0, y := x], simp()), hx)
    show := rewrite(sym(e), c)
  qed
  have sb: subset(seq_one(x), cart(omega, t)) by defs(ss, subset)
  have pw: seq_one(x) in powerset(cart(omega, t)) by taut(powerset_def[s := cart(omega, t), a := seq_one(x)], sb)
  have l1: seq_len(seq_one(x)) = 1 by arith()
  have l1d: dom(seq_one(x)) = 1 by defs(l1, seq_len)
  have o1: 1 in omega by simp()
  have d1: dom(seq_one(x)) in omega := rewrite(sym(l1d), o1)
  show by defs(simp(pw, fu, d1), list_type, seq_type, is_seq)
qed

// one argument, in a register
theorem tr.regs1: all u ar. u in bits(64) -> u in gimple.in_reg(fst(ar), snd(ar)) ->
  seq_one(u) in list_type(bits(64)) && seq_one(u) in univ(1) && seq_len(seq_one(u)) = seq_len(seq_one(ar)) &&
  (all i. i in omega -> int_lt(i, seq_len(seq_one(ar))) -> app(seq_one(u), i) in gimple.in_reg(fst(app(seq_one(ar), i)), snd(app(seq_one(ar), i))))
proof
  fix u ar
  assume hu hi
  have g: all i. i in omega -> int_lt(i, seq_len(seq_one(ar))) -> app(seq_one(u), i) in gimple.in_reg(fst(app(seq_one(ar), i)), snd(app(seq_one(ar), i))) proof
    fix i
    assume h1 h2
    have z: i = 0 by simp(h1, h2)
    have e1 := at({app(seq_one(u), 0)})
    have e2 := at({app(seq_one(ar), 0)})
    show by simp(z, hi, e1, e2)
  qed
  have l1: seq_len(seq_one(u)) = 1 by arith()
  have l2: seq_len(seq_one(ar)) = 1 by arith()
  have lt := apply(tr.seq_one_type, {u}, {bits(64)}, hu)
  have lu: seq_one(u) in univ(1) by defs(simp(hu), seq_one)
  show by simp(lt, lu, l1, l2, g)
qed

// ----------------------------------------------------------------------
//  The push of a call from a frame of 8 bytes: rsp S - 8 (S the entry's
//  rsp), the return address to the 8 bytes from S - 16 -- one page, at most
//  the one below S's

theorem tr.push_at: all S j. S in bits(64) -> int_le(16, S) -> int_lt(S, 140737488355328) -> int_mod(bits_add(64, S, 8), 16) = 0 ->
  j in omega -> int_lt(j, 8) ->
  bits_add(64, bits_sub(64, int_sub(S, 8), 8), bits_of_int(64, j)) = int_add(int_sub(S, 16), j) &&
  int_div(int_add(int_sub(S, 16), j), 4096) = int_div(int_sub(S, 16), 4096)
proof
  fix S j
  assume hs h16 hl ha hj hj8
  have p64: pow2(64) = 18446744073709551616 by simp()
  have sb: int_le(0, S) && int_lt(S, 18446744073709551616) by simp(hs)
  have m1: int_mod(int_add(S, 8), 16) = 0 by simp(hs, ha, hl)
  have e0: int_mod(int_add(int_mod(int_sub(int_sub(S, 8), 8), 18446744073709551616), int_mod(j, 18446744073709551616)), 18446744073709551616) = int_add(int_sub(S, 16), j)
    by arith(sb, h16, hl, hj, hj8)
  have e: bits_add(64, bits_sub(64, int_sub(S, 8), 8), bits_of_int(64, j)) = int_add(int_sub(S, 16), j) by defs(rewrite(sym(p64), e0), bits_add, bits_sub, bits_of_int)
  have m2: int_le(8, int_mod(int_sub(S, 16), 4096)) && int_le(int_mod(int_sub(S, 16), 4096), 4088) by simp(hs, m1, h16)
  have d: int_div(int_add(int_sub(S, 16), j), 4096) = int_div(int_sub(S, 16), 4096) by simp(hs, h16, m2, hj, hj8)
  show by taut(e, d)
qed

// (the page of S - 16: S's, or the one below; S's page holds S + 7)
theorem tr.push_pages: all S. S in bits(64) -> int_le(16, S) -> int_lt(S, 140737488355328) -> int_mod(bits_add(64, S, 8), 16) = 0 ->
  int_le(int_div(int_sub(S, 16), 4096), int_div(S, 4096)) && int_le(int_div(S, 4096), int_add(int_div(int_sub(S, 16), 4096), 1)) &&
  int_div(int_sub(bits_add(64, S, 8), 1), 4096) = int_div(S, 4096) && bits_add(64, S, 8) = int_add(S, 8)
proof
  fix S
  assume hs h16 hl ha
  have m1: int_mod(int_add(S, 8), 16) = 0 by simp(hs, ha, hl)
  have m2: int_le(8, int_mod(S, 4096)) && int_le(int_mod(S, 4096), 4088) by simp(hs, m1)
  have e8: bits_add(64, S, 8) = int_add(S, 8) by simp(hs, hl)
  have d1: int_le(int_div(int_sub(S, 16), 4096), int_div(S, 4096)) by simp(hs, h16)
  have d2: int_le(int_div(S, 4096), int_add(int_div(int_sub(S, 16), 4096), 1)) by simp(hs, h16, m2)
  have d3: int_div(int_sub(int_add(S, 8), 1), 4096) = int_div(S, 4096) by simp(hs, m2)
  show by simp(e8, d1, d2, d3)
qed

// the pushed bytes, at a fault for want of a mapping (the page of S - 16
// unmapped, S's a stack page): where the stack could not grow, rsp S - 8
theorem tr.push_overflow: all xv S j. S in bits(64) -> int_le(16, S) -> int_lt(S, 140737488355328) -> int_mod(bits_add(64, S, 8), 16) = 0 ->
  abi.stack_page(xv, int_div(S, 4096)) -> !x86_64_linux.mapped(xv, int_div(int_sub(S, 16), 4096)) -> j in omega -> int_lt(j, 8) ->
  abi.overflow_at(xv, int_sub(S, 8), bits_add(64, S, 8), int_add(int_sub(S, 16), j))
proof
  fix xv S j
  assume hs h16 hl ha hsp hnm hj hj8
  have _ pa2 := apply(tr.push_at, {S}, {j}, hs, h16, hl, ha, hj, hj8)
  have _ pp2 _ pp4 := apply(tr.push_pages, {S}, hs, h16, hl, ha)
  have so: S in omega by simp(hs)
  have p0: int_div(S, 4096) in omega by simp(so)
  have m1: int_mod(int_add(S, 8), 16) = 0 by simp(hs, ha, hl)
  have m2: int_le(8, int_mod(S, 4096)) && int_le(int_mod(S, 4096), 4088) by simp(hs, m1)
  have r8: int_div(int_sub(S, 8), 4096) = int_div(S, 4096) by simp(hs, m2, h16)
  have gp: all p. p in omega -> int_le(int_div(int_add(int_sub(S, 16), j), 4096), p) && int_le(p, int_div(int_sub(S, 8), 4096)) ->
      abi.stack_page(xv, p) || !x86_64_linux.mapped(xv, p) proof
    fix p
    assume hp h12
    have h1 h2 := h12
    have c1: p = int_div(S, 4096) -> abi.stack_page(xv, p) || !x86_64_linux.mapped(xv, p) proof
      assume e
      have r := rewrite(sym(e), hsp)
      show by taut(r)
    qed
    have c2: !(p = int_div(S, 4096)) -> abi.stack_page(xv, p) || !x86_64_linux.mapped(xv, p) proof
      assume ne
      have h2b := rewrite(r8, h2)
      have h1b := rewrite(pa2, h1)
      have pl: p = int_div(int_sub(S, 16), 4096) by arith(h2b, h1b, ne, pp2, hp, p0)
      have n := rewrite(sym(pl), hnm)
      show by taut(n)
    qed
    show by taut(c1, c2)
  qed
  have lt1: int_lt(int_add(int_sub(S, 16), j), int_add(S, 8)) by arith(hj8)
  have lt0 := rewrite(sym(pp4), lt1)
  show by defs(taut(lt0, gp), abi.overflow_at, x86_64_linux.PAGE)
qed

// (an access allowed or not: its page's entry only)
theorem tr.access_page: all v1 v2 a b k. x86_64_linux.page_of(a) = x86_64_linux.page_of(b) ->
  app(app(v1, "pages"), x86_64_linux.page_of(a)) = app(app(v2, "pages"), x86_64_linux.page_of(b)) ->
  (x86_64_linux.can_access(v1, a, k) <-> x86_64_linux.can_access(v2, b, k))
proof
  fix v1 v2 a b k
  assume hp he
  have he2 := rewrite(hp, he)
  show by defs(simp(hp, he2, keep(x86_64_linux.page_of)), x86_64_linux.can_access, x86_64_linux.mapped)
qed

// the call overflowing the stack first: the function overflows, with the
// world's I/O
theorem tr.call_ovf(g, args, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all w os.
  w in abi.World -> w in univ(1) -> app(app(w, "os"), "events") = app(os, "events") ->
  runs(mkprog(x0 x1. ex x8. xx(w, exc_val("stack_overflow", empty), x8) && k(x8, x1)), w, exc(w, exc_val("stack_overflow", empty))) ->
  tr.ovf(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, os)
proof
  fix w os
  assume hW hw hev hk
  have ou: exc_val("stack_overflow", empty) in univ(1) by defs(simp(), exc_val)
  have c1 := apply(gc.call1_ovf, {g}, {args}, {w}, hw)
  have pe := apply(tr.call_exc[g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)],
    {w}, {w}, {exc_val("stack_overflow", empty)}, hw, hw, ou, c1, hk)
  have wa := apply(tr.world_and, hW)
  have ot := mp(mp(exc_outcome_type[s := rec_and(abi.World, single(empty)), v := cart(bits(64), bits(64)), x := w, e := exc_val("stack_overflow", empty)], wa), ou)
  have it1 := apply(tr.ite_f, {fst(exc(w, exc_val("stack_overflow", empty))) = 0}, {app(app(fst(snd(exc(w, exc_val("stack_overflow", empty)))), "os"), "events") = app(os, "events")},
    {ite(fst(exc(w, exc_val("stack_overflow", empty))) = 1, snd(snd(exc(w, exc_val("stack_overflow", empty)))) = exc_val("stack_overflow", empty) &&
      app(app(fst(snd(exc(w, exc_val("stack_overflow", empty)))), "os"), "events") = app(os, "events"), app(snd(exc(w, exc_val("stack_overflow", empty))), "os.events") = app(os, "events"))}, simp())
  have it2 := apply(tr.ite_t, {fst(exc(w, exc_val("stack_overflow", empty))) = 1}, {snd(snd(exc(w, exc_val("stack_overflow", empty)))) = exc_val("stack_overflow", empty) &&
      app(app(fst(snd(exc(w, exc_val("stack_overflow", empty)))), "os"), "events") = app(os, "events")}, {app(snd(exc(w, exc_val("stack_overflow", empty))), "os.events") = app(os, "events")}, simp())
  have cc: snd(snd(exc(w, exc_val("stack_overflow", empty)))) = exc_val("stack_overflow", empty) &&
      app(app(fst(snd(exc(w, exc_val("stack_overflow", empty)))), "os"), "events") = app(os, "events") by simp(hev)
  have iv := rewrite(sym(trans(it1, it2)), cc)
  show by defs(ex_intro({exc(w, exc_val("stack_overflow", empty))}, taut(ot, pe, iv)), tr.ovf)
qed

// (the coupling at a call from a frame of 8 bytes: its parts)
theorem tr.inv_call: all s base code m w. tr.inv(s, base, code, 8, m, w) ->
  sM: s in x86_64_linux.Machine && mM: m in x86_64_linux.Machine && mu: m in univ(1) && wW: w in abi.World && wu: w in univ(1) &&
  wst: (all p. p in omega -> abi.stack_page(app(s, "vm"), p) -> app(app(app(w, "vm"), "pages"), p) = app(app(app(s, "vm"), "pages"), p)) && wcpu: app(w, "cpu") = app(s, "cpu") && mos: app(m, "os") = app(w, "os") && mfs: app(m, "fs_base") = app(w, "fs_base") &&
  er4: app(app(m, "gpr"), 4) = int_sub(app(app(s, "gpr"), 4), 8) && sb: app(app(s, "gpr"), 4) in bits(64) && slt: int_lt(app(app(s, "gpr"), 4), 140737488355328) &&
  sal: int_mod(bits_add(64, app(app(s, "gpr"), 4), 8), 16) = 0 && hsps: abi.stack_page(app(s, "vm"), int_div(app(app(s, "gpr"), 4), 4096)) &&
  sgf: abi.stack_gap_free(app(s, "vm")) && winp: app(app(w, "os"), "input") = app(app(s, "os"), "input") &&
  sws: subset(app(app(s, "os"), "events"), app(app(w, "os"), "events")) && mcpu: app(m, "cpu") = app(s, "cpu") && mgs: app(m, "gs_base") = app(s, "gs_base") &&
  mdf: !app(app(m, "flags"), "df")
proof
  fix s base code m w
  assume hi
  have {sM, mM, mu, wW, wu, wst, wcpu, mos, mfs, rspm, slt, sal, hsps, sgf, winp, sws, mcpu, mgs, mdf} := hi
  have sb := apply(x86i.rsp_typed, sM)
  show := conj(sM, mM, mu, wW, wu, wst, wcpu, mos, mfs, rspm, sb, slt, sal, hsps, sgf, winp, sws, mcpu, mgs, mdf)
qed

// ----------------------------------------------------------------------
//  GIMPLE's call when the callee runs

// (worlds: their fields only, and with a memory, an os, a thread pointer put in)
theorem tr.world_keys: all w. w in abi.World -> restrict(w, abi.WKEYS) = w && ghost_part(w, abi.WKEYS) = empty
proof
  fix w
  assume hw
  have kf := apply(pow_cart_fst, unsel(expand(hw, abi.World)))
  have r := apply(restrict_all, kf)
  have g := apply(ghost_part_none, kf)
  show by taut(r, g)
qed

theorem tr.world_set: all w v os fs. w in abi.World -> w in univ(1) -> v in x86_64_linux.Vm -> v in univ(1) ->
  os in x86_64_linux.Os -> os in univ(1) -> fs in bits(64) ->
  fn_update(fn_update(fn_update(w, "vm", v), "os", os), "fs_base", fs) in abi.World && fn_update(fn_update(fn_update(w, "vm", v), "os", os), "fs_base", fs) in univ(1) &&
  fn_update(w, "vm", v) in abi.World && fn_update(w, "vm", v) in univ(1)
proof
  fix w v os fs
  assume hw hu hv hvu ho hou hf
  have wf := expand(hw, abi.World)
  have r1: fn_update(fn_update(fn_update(w, "vm", v), "os", os), "fs_base", fs) in abi.World by defs(simp(wf, hu, hv, hvu, ho, hou, hf), abi.World)
  have r2: fn_update(fn_update(fn_update(w, "vm", v), "os", os), "fs_base", fs) in univ(1) by simp(hu, hvu, hou, hf)
  have r3: fn_update(w, "vm", v) in abi.World by defs(simp(wf, hu, hv, hvu), abi.World)
  have r4: fn_update(w, "vm", v) in univ(1) by simp(hu, hvu)
  show by taut(r1, r2, r3, r4)
qed

// (a World with an empty ghost part: a World)
theorem tr.and_world: all x. x in rec_and(abi.World, single(empty)) -> x in abi.World
proof
  fix x
  assume h
  obtain x0 y0, x0w y0e xe from mp(rec_and_elim[a := abi.World, b := single(empty), s := x], h)
  have ye: y0 = empty := mp(single_elim[a := empty, z := y0], y0e)
  have xe1 := rewrite(ye, xe)
  have xe2 := trans(xe1, union2_empty[a := x0])
  show := rewrite(sym(xe2), x0w)
qed

// the spec's rest diverging: the function diverging
theorem tr.qs_div(op, t, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k): all w. runs(op, w, diverge(t)) ->
  (all o. runs(mkprog(x0 x1. ex x8. dd(t, x8) && k(x8, x1)), w, o) ->
    runs(mkprog(x0 x1. ex x8. bind_rel(op, x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), w, o))
proof
  fix w
  assume hq
  have g: all o. (ex x8. dd(t, x8) && k(x8, o)) -> (ex x8. bind_rel(op, w, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, o)) proof
    fix o
    assume h
    obtain y, hy from h
    have dy := hy.1
    have e1: ex o2. runs(op, w, o2) && ((ex s1 v. o2 = ok(s1, v) && a(s1, v, y)) || (ex s1 e2. o2 = exc(s1, e2) && xx(s1, e2, y)) || (ex t2. o2 = diverge(t2) && dd(t2, y)))
      by ex_intro({diverge(t)}, simp(hq, dy))
    have b: bind_rel(op, w, x9 x10. a(x9, x10, y), x9 x10. xx(x9, x10, y), x9. dd(x9, y)) by defs(e1, bind_rel)
    show by ex_intro({y}, taut(b, hy))
  qed
  show := mp(tr.mkprog_mono[s := w, r1 := x0 x1. ex x8. bind_rel(op, x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1),
    r2 := x0 x1. ex x8. dd(t, x8) && k(x8, x1)], g)
qed

theorem tr.p_div(q, x3 x4 x2. kw): all w t. w in univ(1) -> t in univ(1) -> runs(q, w, diverge(t)) ->
  runs(mkprog(x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, diverge(t))
proof
  fix w t
  assume hw ht hr
  have b0: ex o2. runs(q, w, o2) && ((ex s1 v. o2 = ok(s1, v) && kw(s1, v, diverge(t))) || (ex s1 e1. o2 = exc(s1, e1) && diverge(t) = exc(s1, e1)) ||
    (ex t2. o2 = diverge(t2) && diverge(t) = diverge(t2))) by ex_intro({diverge(t)}, simp(hr))
  have b: bind_rel(q, w, x3 x4. kw(x3, x4, diverge(t)), x3 x4. diverge(t) = exc(x3, x4), x3. diverge(t) = diverge(x3)) by defs(b0, bind_rel)
  have pu: pair(w, diverge(t)) in univ(1) by simp(hw, ht)
  show := mp(all_elim(tr.runs_intro[r := x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))], {w}, {diverge(t)}), pu, b)
qed

// ... at a call: the call diverging
theorem tr.call_div(g, args, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all w t. w in univ(1) -> t in univ(1) ->
  runs(gimple.call1(g, args), w, diverge(t)) -> runs(mkprog(x0 x1. ex x8. dd(t, x8) && k(x8, x1)), w, diverge(t)) ->
  runs(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, diverge(t))
proof
  fix w t
  assume hw ht hc hk
  have q := mp(all_elim(mp(all_elim(tr.qs_div[op := gimple.call1(g, args), t := t, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1)], {w}), hc), {diverge(t)}), hk)
  show := apply(tr.p_div[q := mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), kw := x3 x4 x2. kw(x3, x4, x2)],
    {w}, {t}, hw, ht, q)
qed

// the function's rest from the procedure's rest
theorem tr.p_red(q, q2, x3 x4 x2. kw): all w w2. w in univ(1) -> (all o. runs(q2, w2, o) -> runs(q, w, o)) ->
  (all o. runs(mkprog(x1 x2. bind_rel(q2, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w2, o) ->
    runs(mkprog(x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, o))
proof
  fix w w2
  assume hw hq
  fix o
  assume h0
  have hu: pair(w2, o) in univ(1) && bind_rel(q2, w2, x3 x4. kw(x3, x4, o), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) by simp(expand(expand(h0, runs), mkprog))
  have pu: pair(w, o) in univ(1) by simp(hu, hw)
  obtain o2, ho2 from expand(hu.2, bind_rel)
  have r := mp(all_elim(hq, {o2}), ho2.1)
  have b0: ex o3. runs(q, w, o3) && ((ex s1 v. o3 = ok(s1, v) && kw(s1, v, o)) || (ex s1 e1. o3 = exc(s1, e1) && o = exc(s1, e1)) ||
    (ex t2. o3 = diverge(t2) && o = diverge(t2))) by ex_intro({o2}, taut(r, ho2))
  have b: bind_rel(q, w, x3 x4. kw(x3, x4, o), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) by defs(b0, bind_rel)
  show := mp(all_elim(tr.runs_intro[r := x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))], {w}, {o}), pu, b)
qed

// ----------------------------------------------------------------------
//  The push done: the callee's entry state C

// (a machine with a memory, rsp and rip put in: a machine)
theorem tr.mach_push: all m1 nv r T. m1 in x86_64_linux.Machine -> m1 in univ(1) -> nv in x86_64_linux.Vm -> nv in univ(1) -> r in bits(64) -> T in bits(64) ->
  fn_update(fn_update(fn_update(m1, "vm", nv), "gpr", fn_update(app(m1, "gpr"), 4, r)), "rip", T) in x86_64_linux.Machine &&
  fn_update(fn_update(fn_update(m1, "vm", nv), "gpr", fn_update(app(m1, "gpr"), 4, r)), "rip", T) in univ(1)
proof
  fix m1 nv r T
  assume hM hu hv hvu hr ht
  have _ gt _ _ := apply(x86i.parts, hM)
  have g4 := apply(x86.space_upd, {x86_64_linux.Reg}, {bits(64)}, {app(m1, "gpr")}, {4}, {r}, gt, simp(), hr)
  have gu := mp(app_univ[u := 1, f := m1, k := "gpr"], hu)
  have a: fn_update(fn_update(fn_update(m1, "vm", nv), "gpr", fn_update(app(m1, "gpr"), 4, r)), "rip", T) in x86_64_linux.Machine
    by defs(simp(expand(hM, x86_64_linux.Machine), hu, hv, hvu, g4, gu, hr, ht), x86_64_linux.Machine)
  have b: fn_update(fn_update(fn_update(m1, "vm", nv), "gpr", fn_update(app(m1, "gpr"), 4, r)), "rip", T) in univ(1) by simp(hu, hvu, gu, hr, ht)
  show by taut(a, b)
qed

// (a page mapped before the stack grew: its entry kept)
theorem tr.pages_eq_mapped: all v0 v1 l r p. x86.pages_in(v0, v1, l, r) -> p in omega -> x86_64_linux.mapped(v0, p) ->
  app(app(v1, "pages"), p) = app(app(v0, "pages"), p)
proof
  fix v0 v1 l r p
  assume h hp hm
  have a := mp(all_elim(expand(h, x86.pages_in), {p}), hp)
  have mm := expand(hm, x86_64_linux.mapped)
  show by taut(a, mm)
qed

theorem tr.push_ok: all s base code m w RA T m1 e1 C. tr.inv(s, base, code, 8, m, w) -> int_le(16, app(app(s, "gpr"), 4)) ->
  RA in bits(64) -> T in bits(64) ->
  runs(x86_64_linux.touch_range(bits_sub(64, app(app(m, "gpr"), 4), 8), 8, 1), fn_update(m, "rip", RA), ok(m1, e1)) ->
  C = fn_update(fn_update(fn_update(m1, "vm", fn_update(app(m1, "vm"), "bytes", x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), bits_sub(64, app(app(m, "gpr"), 4), 8), 8, RA))),
    "gpr", fn_update(app(m1, "gpr"), 4, bits_sub(64, app(app(m, "gpr"), 4), 8))), "rip", T) ->
  C in x86_64_linux.Machine && C in univ(1) &&
  app(C, "os") = app(m, "os") && app(C, "fs_base") = app(m, "fs_base") && app(C, "cpu") = app(m, "cpu") && app(C, "gs_base") = app(m, "gs_base") &&
  app(C, "flags") = app(m, "flags") && app(C, "gpr") = fn_update(app(m, "gpr"), 4, int_sub(app(app(s, "gpr"), 4), 16)) && app(C, "rip") = T &&
  tr.keeps_code(app(m, "vm"), app(C, "vm")) && x86.vm_fields(app(m, "vm"), app(C, "vm")) &&
  x86_64_linux.le(app(app(C, "vm"), "bytes"), int_sub(app(app(s, "gpr"), 4), 16), 8) = RA &&
  x86.pages_in(app(m, "vm"), app(C, "vm"), int_div(int_sub(app(app(s, "gpr"), 4), 16), 4096), int_div(app(app(s, "gpr"), 4), 4096)) &&
  (all a. a in bits(64) -> !(int_le(int_sub(app(app(s, "gpr"), 4), 16), a) && int_lt(a, int_sub(app(app(s, "gpr"), 4), 8))) ->
    x86_64_linux.mapped(app(m, "vm"), x86_64_linux.page_of(a)) -> app(app(app(C, "vm"), "bytes"), a) = app(app(app(m, "vm"), "bytes"), a)) &&
  x86.stk_ext(app(m, "vm"), app(C, "vm")) &&
  (all j. j in omega -> int_lt(j, 8) -> x86_64_linux.can_access(app(C, "vm"), bits_add(64, int_sub(app(app(s, "gpr"), 4), 16), bits_of_int(64, j)), 1))
proof
  fix s base code m w RA T m1 e1 C
  assume hi h16 hra ht htr hC
  let S := app(app(s, "gpr"), 4)
  let M2 := fn_update(m, "rip", RA)
  let PA := int_sub(S, 16)
  let L := int_div(int_sub(S, 16), 4096)
  let P0 := int_div(S, 4096)
  have {mM, mu, er4, sb, slt, sal, hsps} := apply(tr.inv_call, hi)
  have so: S in omega by simp(sb)
  have bs: bits_sub(64, app(app(m, "gpr"), 4), 8) = PA by defs(simp(er4, sb, h16, slt), bits_sub)
  have htr2 := rewrite(bs, htr)
  have hC2 := rewrite(bs, hC)
  have pab: PA in bits(64) by simp(sb, h16)
  have m2M: M2 in x86_64_linux.Machine by defs(simp(expand(mM, x86_64_linux.Machine), mu, hra), x86_64_linux.Machine)
  have m2u: M2 in univ(1) by simp(mu, hra)
  // (the pushed bytes: on page L, at most S's page P0, which is mapped)
  have lp _ _ _ := apply(tr.push_pages, {S}, sb, h16, slt, sal)
  have rb: x86.range_below(PA, 8, L, P0) proof
    have g: all j. j in omega -> int_lt(j, 8) ->
        int_le(L, x86_64_linux.page_of(bits_add(64, PA, bits_of_int(64, j)))) && int_le(x86_64_linux.page_of(bits_add(64, PA, bits_of_int(64, j))), P0) proof
      fix j
      assume hj hj8
      have pa1 pa2 := apply(tr.push_at, {S}, {j}, sb, h16, slt, sal, hj, hj8)
      have bs2: bits_sub(64, int_sub(S, 8), 8) = PA by defs(simp(sb, h16, slt), bits_sub)
      have pa3 := rewrite(bs2, pa1)
      have pg: x86_64_linux.page_of(bits_add(64, PA, bits_of_int(64, j))) = L by defs(simp(pa3, pa2), x86_64_linux.page_of, x86_64_linux.PAGE)
      show by simp(pg, lp, keep(x86_64_linux.page_of))
    qed
    show by defs(g, x86.range_below)
  qed
  have kpt: tr.kept(app(s, "vm"), app(m, "vm"), S) by simp(expand(hi, tr.inv), keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, abi.stack_gap_free, x86_64_linux.can_access, tr.kept, tr.keeps_code))
  have kr := mp(all_elim(expand(kpt, tr.kept), {S}), so, arith(so), arith(so))
  have kr2: app(app(app(m, "vm"), "pages"), P0) = app(app(app(s, "vm"), "pages"), P0) by defs(kr, x86_64_linux.page_of, x86_64_linux.PAGE)
  have mp0: x86_64_linux.mapped(app(M2, "vm"), P0) by defs(simp(kr2, expand(hsps, abi.stack_page, x86_64_linux.mapped)), x86_64_linux.mapped)
  have p0o: P0 in omega by simp(so)
  have pin := apply(x86.touch_range_ok_pages, {M2}, {PA}, {8}, {1}, {L}, {P0}, {m1}, {e1}, p0o, mp0, rb, htr2)
  // (m1: M2 grown, typed, its fields)
  have m1M m1u := apply(x86.touch_range_typed, {M2}, {PA}, {8}, {1}, {m1}, {e1}, m2M, m2u, htr2)
  have tv := apply(x86.touch_range_vm, {M2}, {PA}, {8}, {1}, {m1}, {e1}, htr2)
  have gr := apply(x86.touch_range_frame, {M2}, {PA}, {8}, {1}, {m1}, {e1}, simp(), htr2)
  have fl := apply(x86.touch_range_fields, {M2}, {PA}, {8}, {1}, {m1}, {e1}, htr2)
  have mf: app(m1, "os") = app(m, "os") && app(m1, "fs_base") = app(m, "fs_base") && app(m1, "cpu") = app(m, "cpu") && app(m1, "gs_base") = app(m, "gs_base") &&
    app(m1, "flags") = app(m, "flags") && app(m1, "gpr") = app(m, "gpr") && app(m1, "rip") = RA by simp(tv)
  have v1: app(m1, "vm") in x86_64_linux.Vm := apply(x86i.parts, m1M).4
  have b1: app(app(m1, "vm"), "bytes") in fn_space(bits(64), bits(8)) by simp(v1)
  // C: typed
  have su := apply(g.store_univ, {app(m1, "vm")}, {PA}, {8}, {RA}, v1)
  have v1u := mp(app_univ[u := 1, f := m1, k := "vm"], m1u)
  have nu: fn_update(app(m1, "vm"), "bytes", x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), PA, 8, RA)) in univ(1) by simp(v1u, su)
  have nv := apply(x86.store_vm, {app(m1, "vm")}, {PA}, {8}, {RA}, v1, nu)
  have mpu := apply(tr.mach_push, {m1}, {fn_update(app(m1, "vm"), "bytes", x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), PA, 8, RA))}, {PA}, {T}, m1M, m1u, nv, nu, pab, ht)
  have cM cu := rewrite(sym(hC2), mpu)
  have cf: app(C, "os") = app(m, "os") && app(C, "fs_base") = app(m, "fs_base") && app(C, "cpu") = app(m, "cpu") && app(C, "gs_base") = app(m, "gs_base") &&
    app(C, "flags") = app(m, "flags") && app(C, "gpr") = fn_update(app(m, "gpr"), 4, PA) && app(C, "rip") = T by simp(hC2, mf)
  have cvm: app(C, "vm") = fn_update(app(m1, "vm"), "bytes", x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), PA, 8, RA)) by simp(hC2)
  // its memory: fields, pages, the return address, the other bytes
  have cfl: x86.vm_fields(app(m, "vm"), app(C, "vm")) by defs(simp(cvm, expand(fl, x86.vm_fields)), x86.vm_fields)
  have cpi: x86.pages_in(app(m, "vm"), app(C, "vm"), L, P0) by defs(simp(cvm, expand(pin, x86.pages_in)), x86.pages_in)
  have rao: RA in omega by simp(hra)
  have ls := apply(tr.le_store8, {app(app(m1, "vm"), "bytes")}, {PA}, {RA}, b1, pab, rao)
  have cle: x86_64_linux.le(app(app(C, "vm"), "bytes"), PA, 8) = RA by simp(cvm, ls, hra)
  have cby: all a. a in bits(64) -> !(int_le(PA, a) && int_lt(a, int_sub(S, 8))) -> x86_64_linux.mapped(app(m, "vm"), x86_64_linux.page_of(a)) ->
      app(app(app(C, "vm"), "bytes"), a) = app(app(app(m, "vm"), "bytes"), a) proof
    fix a
    assume ha hn hm
    have ne: all i. i in omega -> int_lt(i, 8) -> !(bits_add(64, PA, bits_of_int(64, i)) = a) proof
      fix i
      assume hi0 hi8
      have pa1 _ := apply(tr.push_at, {S}, {i}, sb, h16, slt, sal, hi0, hi8)
      have bs2: bits_sub(64, int_sub(S, 8), 8) = PA by defs(simp(sb, h16, slt), bits_sub)
      have pa3 := rewrite(bs2, pa1)
      have ao: a in omega by simp(ha)
      have nq: !(int_add(int_sub(S, 16), i) = a) by arith(hn, hi0, hi8, so, ao)
      show := rewrite(sym(pa3), nq)
    qed
    have so2 := apply(x86.store_outside, {app(app(m1, "vm"), "bytes")}, {PA}, {8}, {RA}, {a}, ha, ne)
    have gb: all x0. x0 in bits(64) -> x86_64_linux.mapped(app(M2, "vm"), x86_64_linux.page_of(x0)) -> app(app(app(m1, "vm"), "bytes"), x0) = app(app(app(M2, "vm"), "bytes"), x0)
      := expand(gr, abi.vm_grows).2
    have gg := mp(all_elim(gb, {a}), ha, simp(hm))
    show by simp(cvm, so2, gg)
  qed
  // the code: kept by the push (its bytes writable or newly mapped stack)
  have kc: tr.keeps_code(app(m, "vm"), app(C, "vm")) proof
    have g: all gb gc st. gb in omega -> abi.loaded(app(m, "vm"), gb, gc, st) -> abi.loaded(app(C, "vm"), gb, gc, st) proof
      fix gb gc st
      assume hb hl
      have lc: abi.code_at(app(M2, "vm"), gb, gc) by simp(expand(hl, abi.loaded), keep(abi.code_at))
      have sc := all_elim(apply(x86.store_code, {gb}, {gc}, {M2}, {PA}, {8}, {m1}, {e1}, simp(), hb, htr2, lc), {RA})
      have cc: abi.code_at(app(C, "vm"), gb, gc) := rewrite(sym(cvm), sc)
      have stt: all x. x in omega -> x in st -> x86_64_linux.mapped(app(C, "vm"), int_div(x, x86_64_linux.PAGE)) && !abi.stack_page(app(C, "vm"), int_div(x, x86_64_linux.PAGE)) proof
        fix x
        assume hx hs
        have l0 := mp(all_elim(expand(hl, abi.loaded).2, {x}), hx, hs)
        have po: int_div(x, x86_64_linux.PAGE) in omega by defs(simp(hx), x86_64_linux.PAGE)
        have pe := apply(tr.pages_eq_mapped, {app(m, "vm")}, {app(C, "vm")}, {L}, {P0}, {int_div(x, x86_64_linux.PAGE)}, cpi, po, l0.1)
        show by defs(simp(pe, expand(l0, abi.stack_page, x86_64_linux.mapped), keep(x86_64_linux.PAGE)), abi.stack_page, x86_64_linux.mapped)
      qed
      show by defs(taut(cc, stt), abi.loaded)
    qed
    show by defs(g, tr.keeps_code)
  qed
  // the grown pages: stack pages; the pushed bytes: writable
  have st0 := apply(x86.touch_range_stk, {M2}, {PA}, {8}, {1}, {m1}, {e1}, htr2)
  have pe: app(app(C, "vm"), "pages") = app(app(m1, "vm"), "pages") by simp(cvm)
  have stk: x86.stk_ext(app(m, "vm"), app(C, "vm")) proof
    have g: all i. i in omega -> app(app(app(C, "vm"), "pages"), i) = app(app(app(m, "vm"), "pages"), i) || abi.stack_page(app(C, "vm"), i) proof
      fix i
      assume hi
      have a0 := mp(all_elim(expand(st0, x86.stk_ext), {i}), hi)
      have sq := mp(all_elim(tr.sp_pages, {app(m1, "vm")}, {app(C, "vm")}, {i}), pe)
      show by simp(a0, pe, sq)
    qed
    show by defs(g, x86.stk_ext)
  qed
  have ac0 := apply(x86.touch_range_acc, {M2}, {PA}, {8}, {m1}, {e1}, htr2)
  have acc: all j. j in omega -> int_lt(j, 8) -> x86_64_linux.can_access(app(C, "vm"), bits_add(64, PA, bits_of_int(64, j)), 1) proof
    fix j
    assume j1 j2
    have c := mp(all_elim(ac0, {j}), j1, j2)
    show := apply(tr.acc_pages, {app(m1, "vm")}, {app(C, "vm")}, {bits_add(64, PA, bits_of_int(64, j))}, {1}, pe, c)
  qed
  show by taut(cM, cu, cf, kc, cfl, cle, cpi, cby, stk, acc)
qed

// a disciplined run returns only at its return point
theorem tr.run_d_ok: all s m x e. tr.run_d(s, m, ok(x, e)) -> tr.at_ret(s, x)
proof
  fix s m x e
  assume h
  obtain r, hw hm from expand(h, tr.run_d)
  have wi := mp(mp(mp(while_inv[l0 := pair(m, empty), c := l. true, b := l o. tr.rbd(s, l, o),
    tr := l. fn_update(empty, "os.events", app(app(fst(l), "os"), "events")), r := r, p := l. true], simp()), simp()), expand(hw, tr.rwd))
  have nd: !(ex t. r = diverge(t)) proof
    have g: (ex t. r = diverge(t)) -> false proof
      assume ed
      obtain t, ht from ed
      show by simp(expand(rewrite(ht, hm), tr.rmap))
    qed
    show by taut(g)
  qed
  have el: ex l. true && ((!true && r = ok(l, empty)) || (true && tr.rbd(s, l, r) && !is_ok(r))) by taut(wi, nd)
  obtain l, hl from el
  have hb: tr.rbd(s, l, r) by taut(hl)
  have nk: !is_ok(r) by taut(hl)
  have rr := expand(hm, tr.rmap)
  have c1: tr.disc_ok(s, fst(l)) && tr.rb(s, l, r) -> tr.at_ret(s, x) proof
    assume hd
    have b1: (!tr.at_ret(s, fst(l)) && bind_rel(x86_64_linux.step, fst(l), x7 x8. r = ok(pair(x7, empty), empty), x7 x8. r = exc(pair(x7, empty), pair("raise", x8)), x7. r = diverge(x7))) ->
        tr.at_ret(s, x) proof
      assume hb1
      obtain o2, ho2 from expand(hb1.2, bind_rel)
      have k1: (ex s1 v1. o2 = ok(s1, v1) && r = ok(pair(s1, empty), empty)) -> tr.at_ret(s, x) proof
        assume ek
        obtain s1 v1, _ re from ek
        show by simp(expand(rewrite(re, nk), is_ok))
      qed
      have k2: (ex s1 e1. o2 = exc(s1, e1) && r = exc(pair(s1, empty), pair("raise", e1))) -> tr.at_ret(s, x) proof
        assume ek
        obtain s1 e1, _ re from ek
        show by simp(expand(rewrite(re, hm), tr.rmap))
      qed
      have k3: (ex t. o2 = diverge(t) && r = diverge(t)) -> tr.at_ret(s, x) proof
        assume ek
        obtain t, _ re from ek
        show by simp(expand(rewrite(re, hm), tr.rmap))
      qed
      show by taut(ho2, k1, k2, k3)
    qed
    have b2: (!!tr.at_ret(s, fst(l)) && r = exc(pair(fst(l), empty), pair("brk", empty))) -> tr.at_ret(s, x) proof
      assume hb2
      have nar re := hb2
      have xe: x = fst(l) by simp(expand(rewrite(re, hm), tr.rmap))
      have ar: tr.at_ret(s, fst(l)) by taut(nar)
      show := rewrite(sym(xe), ar)
    qed
    show by taut(expand(hd.2, tr.rb), b1, b2)
  qed
  have c2: !tr.disc_ok(s, fst(l)) && r = exc(l, pair("raise", exc_val("disc", empty))) -> tr.at_ret(s, x) proof
    assume hd
    show by simp(expand(rewrite(hd.2, hm), tr.rmap))
  qed
  show by taut(expand(hb, tr.rbd), c1, c2)
qed

// ----------------------------------------------------------------------
//  After the callee: the loaded code, the return address

// (code at the same pages and bytes: loaded still)
theorem tr.code_at_tr: all v1 v2 gb gc. abi.code_at(v1, gb, gc) ->
  (all i. i in omega -> int_lt(i, seq_len(gc)) ->
    app(app(v2, "pages"), x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))) = app(app(v1, "pages"), x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))) &&
    app(app(v2, "bytes"), bits_of_int(64, int_add(gb, i))) = app(app(v1, "bytes"), bits_of_int(64, int_add(gb, i)))) ->
  abi.code_at(v2, gb, gc)
proof
  fix v1 v2 gb gc
  assume hc he
  have cc := expand(hc, abi.code_at)
  have r: all i. i in omega -> int_lt(i, seq_len(gc)) ->
      ((x86_64_linux.fetchable(v2, bits_of_int(64, int_add(gb, i))) && !x86_64_linux.can_access(v2, bits_of_int(64, int_add(gb, i)), 1)) &&
        !abi.stack_page(v2, x86_64_linux.page_of(bits_of_int(64, int_add(gb, i))))) &&
      app(app(v2, "bytes"), bits_of_int(64, int_add(gb, i))) = app(gc, i) proof
    fix i
    assume hi hl
    have f1 _ s1 b1 := mp(all_elim(cc, {i}), hi, hl)
    have pe be := mp(all_elim(he, {i}), hi, hl)
    have ac := apply(tr.access_page, {v2}, {v1}, {bits_of_int(64, int_add(gb, i))}, {bits_of_int(64, int_add(gb, i))}, {1}, refl({x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))}), pe)
    have f2: x86_64_linux.fetchable(v2, bits_of_int(64, int_add(gb, i))) by defs(rewrite(sym(pe), expand(f1, x86_64_linux.fetchable, x86_64_linux.mapped)), x86_64_linux.fetchable, x86_64_linux.mapped)
    have s2: !abi.stack_page(v2, x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))) by defs(rewrite(sym(pe), expand(s1, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
    have ci := mp(all_elim(cc, {i}), hi, hl)
    have b2 := trans(be, b1)
    show by taut(ci, ac, f2, s2, b2)
  qed
  show by defs(r, abi.code_at)
qed

// (a code byte: on a mapped, non-stack page)
theorem tr.code_page: all vm gb gc i. abi.code_at(vm, gb, gc) -> i in omega -> int_lt(i, seq_len(gc)) ->
  x86_64_linux.mapped(vm, x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))) && !abi.stack_page(vm, x86_64_linux.page_of(bits_of_int(64, int_add(gb, i))))
proof
  fix vm gb gc i
  assume hc hi hl
  have f _ ns _ := mp(all_elim(expand(hc, abi.code_at), {i}), hi, hl)
  have m: x86_64_linux.mapped(vm, x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))) by taut(expand(f, x86_64_linux.fetchable))
  show by taut(m, ns)
qed

// (8 bytes the same: so their little-endian read)
theorem tr.le_eq8: all b1 b2 a. (all j. j in omega -> int_lt(j, 8) -> app(b1, bits_add(64, a, bits_of_int(64, j))) = app(b2, bits_add(64, a, bits_of_int(64, j)))) ->
  x86_64_linux.le(b1, a, 8) = x86_64_linux.le(b2, a, 8)
proof
  fix b1 b2 a
  assume h
  have k0 := mp(all_elim(h, {0}), simp(), simp())
  have k1 := mp(all_elim(h, {1}), simp(), simp())
  have k2 := mp(all_elim(h, {2}), simp(), simp())
  have k3 := mp(all_elim(h, {3}), simp(), simp())
  have k4 := mp(all_elim(h, {4}), simp(), simp())
  have k5 := mp(all_elim(h, {5}), simp(), simp())
  have k6 := mp(all_elim(h, {6}), simp(), simp())
  have k7 := mp(all_elim(h, {7}), simp(), simp())
  show by defs(simp(k0, k1, k2, k3, k4, k5, k6, k7), x86_64_linux.le)
qed

// A return keeps the world valid for GIMPLE (C1's bookkeeping, nothing
// function-specific): the input as it was, the events grown, the program
// loaded still
def tr.returns_valid(w, w2) := app(app(w2, "os"), "input") = app(app(w, "os"), "input") && subset(app(app(w, "os"), "events"), app(app(w2, "os"), "events")) &&
  (all gb gc st. gb in omega -> abi.loaded(app(w, "vm"), gb, gc, st) -> abi.loaded(app(w2, "vm"), gb, gc, st)) && app(w2, "cpu") = app(w, "cpu")

// the spec is undefined from w: it allows every exception (and so, as
// GIMPLE's undefined behaviour does, every outcome)
def tr.may_raise(g, args, w) := all x e. x in univ(1) -> e in univ(1) -> runs(app(g, args), w, exc(x, e))

// The callee's spec, program-wide: called with at least its n arguments
// (with fewer, a `_fun` wrapper allows any outcome), a return keeps the
// world valid -- or the spec is undefined there (so is its caller's call)
def tr.callee_io(g, n) := all args w w2 r. ord_le(n, seq_len(args)) -> w in abi.World -> runs(app(g, args), w, ok(w2, r)) ->
  tr.returns_valid(w, w2) || tr.may_raise(g, args, w)

// a spec built as GIMPLE's `_fun` wrappers are (a program per argument
// list): typed as the ABI has specs
theorem tr.fun_typed(x0 x1 x2. r): fn_build(abi.ARGS, x0. mkprog(x1 x2. r(x0, x1, x2))) in fn_space(abi.ARGS, powerset(univ(1)))
proof
  have v: all x0. x0 in abi.ARGS -> mkprog(x1 x2. r(x0, x1, x2)) in powerset(univ(1)) proof
    fix x0
    assume _
    have g: all z. z in mkprog(x1 x2. r(x0, x1, x2)) -> z in univ(1) proof
      fix z
      assume hz
      have m := set_select_def[s := univ(1), p := y. ex x1 x2. y = pair(x1, x2) && r(x0, x1, x2), z := z]
      show by taut(m, expand(hz, mkprog))
    qed
    have s: subset(mkprog(x1 x2. r(x0, x1, x2)), univ(1)) by defs(g, subset)
    show by taut(powerset_def[s := univ(1), a := mkprog(x1 x2. r(x0, x1, x2))], s)
  qed
  show := mp(fn_build_space[d := abi.ARGS, v := x0. mkprog(x1 x2. r(x0, x1, x2)), b := powerset(univ(1))], v)
qed

// (the callee's spec typed, as the ABI has specs: its runs in univ(1))
theorem tr.spec_univ: all g args w o. g in fn_space(abi.ARGS, powerset(univ(1))) -> args in abi.ARGS -> runs(app(g, args), w, o) -> pair(w, o) in univ(1)
proof
  fix g args w o
  assume hg ha hr
  have pa := mp(mp(fn_space_app[a := abi.ARGS, b := powerset(univ(1)), f := g, x := args], hg), ha)
  have ss: subset(app(g, args), univ(1)) by taut(powerset_def[s := univ(1), a := app(g, args)], pa)
  show := mp(subset_elim[a := app(g, args), b := univ(1), z := pair(w, o)], ss, expand(hr, runs))
qed

// (an outcome of a type: a return, an exception, a divergence)
theorem tr.outcome_cases: all S V x0. x0 in outcome_type(S, V) ->
  (ex a b. a in S && b in V && x0 = ok(a, b)) || (ex a b. a in S && b in univ(1) && x0 = exc(a, b)) || (ex t. t in univ(1) && x0 = diverge(t))
proof
  fix S V x0
  assume h
  have u1 := union2_iff[a := set_image(cart(S, V), z. ok(fst(z), snd(z))), b := union2(set_image(cart(S, univ(1)), z. exc(fst(z), snd(z))), set_image(univ(1), t. diverge(t))), z := x0]
  have u2 := union2_iff[a := set_image(cart(S, univ(1)), z. exc(fst(z), snd(z))), b := set_image(univ(1), t. diverge(t)), z := x0]
  have s1 := set_image_def[s := cart(S, V), f := z. ok(fst(z), snd(z)), y := x0]
  have s2 := set_image_def[s := cart(S, univ(1)), f := z. exc(fst(z), snd(z)), y := x0]
  have s3 := set_image_def[s := univ(1), f := t. diverge(t), y := x0]
  have hh: x0 in union2(set_image(cart(S, V), z. ok(fst(z), snd(z))), union2(set_image(cart(S, univ(1)), z. exc(fst(z), snd(z))), set_image(univ(1), t. diverge(t)))) by defs(h, outcome_type)
  have c1: (ex z. z in cart(S, V) && ok(fst(z), snd(z)) = x0) -> (ex a b. a in S && b in V && x0 = ok(a, b)) proof
    assume e
    obtain z, hz from e
    obtain a b, hb from mp(cart_elim[a := S, b := V, z := z], hz.1)
    have eq: x0 = ok(a, b) by simp(hz, hb)
    show by ex_intro({a}, {b}, taut(hb, eq))
  qed
  have c2: (ex z. z in cart(S, univ(1)) && exc(fst(z), snd(z)) = x0) -> (ex a b. a in S && b in univ(1) && x0 = exc(a, b)) proof
    assume e
    obtain z, hz from e
    obtain a b, hb from mp(cart_elim[a := S, b := univ(1), z := z], hz.1)
    have eq: x0 = exc(a, b) by simp(hz, hb)
    show by ex_intro({a}, {b}, taut(hb, eq))
  qed
  have c3: (ex t. t in univ(1) && diverge(t) = x0) -> (ex t. t in univ(1) && x0 = diverge(t)) proof
    assume e
    obtain t, ht from e
    have eq: x0 = diverge(t) by simp(ht)
    show by ex_intro({t}, taut(ht, eq))
  qed
  show by taut(hh, u1, u2, s1, s2, s3, c1, c2, c3)
qed

// a crash's I/O: that of the function's overflow (or divergence) from w
theorem tr.ovf_exc: all p w os x. x in rec_and(abi.World, single(empty)) -> runs(p, w, exc(x, exc_val("stack_overflow", empty))) ->
  app(app(x, "os"), "events") = app(os, "events") -> tr.ovf(p, w, os)
proof
  fix p w os x
  assume hx hr hev
  have ou: exc_val("stack_overflow", empty) in univ(1) by defs(simp(), exc_val)
  have ot := mp(mp(exc_outcome_type[s := rec_and(abi.World, single(empty)), v := cart(bits(64), bits(64)), x := x, e := exc_val("stack_overflow", empty)], hx), ou)
  have it1 := apply(tr.ite_f, {fst(exc(x, exc_val("stack_overflow", empty))) = 0}, {app(app(fst(snd(exc(x, exc_val("stack_overflow", empty)))), "os"), "events") = app(os, "events")},
    {ite(fst(exc(x, exc_val("stack_overflow", empty))) = 1, snd(snd(exc(x, exc_val("stack_overflow", empty)))) = exc_val("stack_overflow", empty) &&
      app(app(fst(snd(exc(x, exc_val("stack_overflow", empty)))), "os"), "events") = app(os, "events"), app(snd(exc(x, exc_val("stack_overflow", empty))), "os.events") = app(os, "events"))}, simp())
  have it2 := apply(tr.ite_t, {fst(exc(x, exc_val("stack_overflow", empty))) = 1}, {snd(snd(exc(x, exc_val("stack_overflow", empty)))) = exc_val("stack_overflow", empty) &&
      app(app(fst(snd(exc(x, exc_val("stack_overflow", empty)))), "os"), "events") = app(os, "events")}, {app(snd(exc(x, exc_val("stack_overflow", empty))), "os.events") = app(os, "events")}, simp())
  have cc: snd(snd(exc(x, exc_val("stack_overflow", empty)))) = exc_val("stack_overflow", empty) &&
      app(app(fst(snd(exc(x, exc_val("stack_overflow", empty)))), "os"), "events") = app(os, "events") by simp(hev)
  have iv := rewrite(sym(trans(it1, it2)), cc)
  show by defs(ex_intro({exc(x, exc_val("stack_overflow", empty))}, taut(ot, hr, iv)), tr.ovf)
qed

theorem tr.ovf_div: all p w os t. t in univ(1) -> runs(p, w, diverge(t)) -> app(t, "os.events") = app(os, "events") -> tr.ovf(p, w, os)
proof
  fix p w os t
  assume ht hr hev
  have si := set_image_def[s := univ(1), f := t0. diverge(t0), y := diverge(t)]
  have ex1: ex t0. t0 in univ(1) && diverge(t0) = diverge(t) by ex_intro({t}, taut(ht, refl({diverge(t)})))
  have m3: diverge(t) in set_image(univ(1), t0. diverge(t0)) by taut(si, ex1)
  have u1 := union2_iff[a := set_image(cart(rec_and(abi.World, single(empty)), cart(bits(64), bits(64))), z. ok(fst(z), snd(z))),
    b := union2(set_image(cart(rec_and(abi.World, single(empty)), univ(1)), z. exc(fst(z), snd(z))), set_image(univ(1), t0. diverge(t0))), z := diverge(t)]
  have u2 := union2_iff[a := set_image(cart(rec_and(abi.World, single(empty)), univ(1)), z. exc(fst(z), snd(z))), b := set_image(univ(1), t0. diverge(t0)), z := diverge(t)]
  have ot: diverge(t) in outcome_type(rec_and(abi.World, single(empty)), cart(bits(64), bits(64))) by defs(taut(m3, u1, u2), outcome_type)
  have it1 := apply(tr.ite_f, {fst(diverge(t)) = 0}, {app(app(fst(snd(diverge(t))), "os"), "events") = app(os, "events")},
    {ite(fst(diverge(t)) = 1, snd(snd(diverge(t))) = exc_val("stack_overflow", empty) && app(app(fst(snd(diverge(t))), "os"), "events") = app(os, "events"),
      app(snd(diverge(t)), "os.events") = app(os, "events"))}, simp())
  have it2 := apply(tr.ite_f, {fst(diverge(t)) = 1}, {snd(snd(diverge(t))) = exc_val("stack_overflow", empty) && app(app(fst(snd(diverge(t))), "os"), "events") = app(os, "events")},
    {app(snd(diverge(t)), "os.events") = app(os, "events")}, simp())
  have cc: app(snd(diverge(t)), "os.events") = app(os, "events") by simp(hev)
  have iv := rewrite(sym(trans(it1, it2)), cc)
  show by defs(ex_intro({diverge(t)}, taut(ot, hr, iv)), tr.ovf)
qed

// (subsets: transitive)
theorem tr.subset_trans: all a b c. subset(a, b) -> subset(b, c) -> subset(a, c)
proof
  fix a b c
  assume h1 h2
  have g: all z. z in a -> z in c proof
    fix z
    assume hz
    have zb := mp(subset_elim[a := a, b := b, z := z], h1, hz)
    show := mp(subset_elim[a := b, b := c, z := z], h2, zb)
  qed
  show by defs(g, subset)
qed

// (the spec raising: the claim, whatever the machine does)
theorem tr.sim_ub: all s v p w m. tr.ub(s, v, p, w) -> tr.sim(s, v, p, w, m)
proof
  fix s v p w m
  assume h
  have g: all o. tr.run_d(s, m, o) -> tr.ub(s, v, p, w) || tr.ok(s, v, p, w, o) || tr.crash(s, p, w, o) proof
    fix o
    assume ho
    show by taut(h)
  qed
  show by defs(g, tr.sim)
qed

// ----------------------------------------------------------------------
//  The callee runs: from its entry state C, the caller's claim

// ----------------------------------------------------------------------
//  The rule

// ----------------------------------------------------------------------
//  A call (GIMPLE's call: the stack grown, the callee on the caller's
//  world, its stack objects restored, the stack grown again)

// (the entry's rsp: above the guard gap -- a frame's push does not wrap)
theorem tr.inv_gap: all s base code fr m w. tr.inv(s, base, code, fr, m, w) -> int_le(1048576, app(app(s, "gpr"), 4))
proof
  fix s base code fr m w
  assume hi
  have {sM, hsps, sgf} := hi
  have r4 := apply(x86i.rsp_typed, sM)
  have po: int_div(app(app(s, "gpr"), 4), 4096) in omega by simp(r4)
  have c := mp(all_elim(expand(sgf, abi.stack_gap_free).2, {int_div(app(app(s, "gpr"), 4), 4096)}), po, hsps)
  have c2: int_le(1048576, int_mul(int_div(app(app(s, "gpr"), 4), 4096), 4096)) by simp(expand(c, x86_64_linux.STACK_GUARD_GAP, x86_64_linux.PAGE))
  show by arith(c2, r4)
qed

// (the stack's guard gap: the pages' only)
theorem tr.sgf_pages: all v1 v2. app(v2, "pages") = app(v1, "pages") -> abi.stack_gap_free(v1) -> abi.stack_gap_free(v2)
proof
  fix v1 v2
  assume e h
  show by defs(simp(e, expand(h, abi.stack_gap_free, abi.stack_page, x86_64_linux.mapped)), abi.stack_gap_free, abi.stack_page, x86_64_linux.mapped)
qed

// the machine's memory after the push (cv): the world's stack grown
theorem tr.push_grown: all s m w ds cv l r. tr.mem(s, m, w, ds) -> cv in x86_64_linux.Vm -> x86.pages_in(app(m, "vm"), cv, l, r) -> x86.stk_ext(app(m, "vm"), cv) ->
  gc.grown(app(w, "vm"), app(cv, "pages"))
proof
  fix s m w ds cv l r
  assume hmm hv hpi hse
  have {pages} := expand(hmm, tr.mem).wm
  have f: app(cv, "pages") in fn_space(gc.PN, option(x86_64_linux.Page)) by simp(expand(hv, x86_64_linux.Vm))
  have g: all p. p in gc.PN -> app(app(cv, "pages"), p) = app(app(app(w, "vm"), "pages"), p) ||
      (app(app(app(w, "vm"), "pages"), p) = none && !(app(app(cv, "pages"), p) = none) && app(snd(app(app(cv, "pages"), p)), "kind") = 2) proof
    fix p
    assume hp
    have po: p in omega by simp(hp)
    have a1 := mp(all_elim(pages, {p}), hp)
    have a2 := mp(all_elim(expand(hpi, x86.pages_in), {p}), po)
    have a3 := mp(all_elim(expand(hse, x86.stk_ext), {p}), po)
    show by simp(a1, a2, expand(a3, abi.stack_page, x86_64_linux.mapped), expand(a1, abi.stack_page, x86_64_linux.mapped))
  qed
  show by taut(f, g)
qed

// (the push's slot, S - 16, accessible: on a stack page -- S's, or the one
// below, which the guard gap leaves to the stack)
theorem tr.push_page_stack: all cv S. S in bits(64) -> int_le(16, S) -> int_lt(S, 140737488355328) -> int_mod(bits_add(64, S, 8), 16) = 0 ->
  abi.stack_gap_free(cv) -> abi.stack_page(cv, int_div(S, 4096)) -> x86_64_linux.can_access(cv, int_sub(S, 16), 1) ->
  abi.stack_page(cv, int_div(int_sub(S, 16), 4096))
proof
  fix cv S
  assume hs h16 hl ha hg hp hc
  have l1 l2 _ _ := apply(tr.push_pages, {S}, hs, h16, hl, ha)
  have so: S in omega by simp(hs)
  have c1: int_div(int_sub(S, 16), 4096) = int_div(S, 4096) -> abi.stack_page(cv, int_div(int_sub(S, 16), 4096)) proof
    assume e
    show := rewrite(sym(e), hp)
  qed
  have c2: !(int_div(int_sub(S, 16), 4096) = int_div(S, 4096)) -> abi.stack_page(cv, int_div(int_sub(S, 16), 4096)) proof
    assume ne
    have lt: int_lt(int_div(int_sub(S, 16), 4096), int_div(S, 4096)) by arith(l1, ne, so)
    have gap: int_le(int_mul(int_sub(int_div(S, 4096), int_div(int_sub(S, 16), 4096)), x86_64_linux.PAGE), x86_64_linux.STACK_GUARD_GAP)
      by defs(arith(l1, l2, lt, so), x86_64_linux.PAGE, x86_64_linux.STACK_GUARD_GAP)
    have mq0: x86_64_linux.mapped(cv, x86_64_linux.page_of(int_sub(S, 16))) by taut(expand(hc, x86_64_linux.can_access))
    have pe: x86_64_linux.page_of(int_sub(S, 16)) = int_div(int_sub(S, 16), 4096) by defs(simp(), x86_64_linux.page_of, x86_64_linux.PAGE)
    have mq := rewrite(pe, mq0)
    have p0: int_div(S, 4096) in omega by simp(so)
    have q0: int_div(int_sub(S, 16), 4096) in omega by simp(so, h16)
    have pr1: int_div(S, 4096) in omega && int_div(int_sub(S, 16), 4096) in omega by taut(p0, q0)
    have pr2: ((abi.stack_page(cv, int_div(S, 4096)) && int_lt(int_div(int_sub(S, 16), 4096), int_div(S, 4096))) &&
      int_le(int_mul(int_sub(int_div(S, 4096), int_div(int_sub(S, 16), 4096)), x86_64_linux.PAGE), x86_64_linux.STACK_GUARD_GAP)) && x86_64_linux.mapped(cv, int_div(int_sub(S, 16), 4096)) by taut(hp, lt, gap, mq)
    show := mp(all_elim(expand(hg, abi.stack_gap_free).1, {int_div(S, 4096)}, {int_div(int_sub(S, 16), 4096)}), pr1, pr2)
  qed
  show by taut(c1, c2)
qed

// after the push (the callee's entry memory cv): on the world's domain, the
// machine's bytes the world's, its pages mapped before
theorem tr.push_dom: all s base code m w ds cv. tr.inv(s, base, code, 8, m, w) -> tr.mem(s, m, w, ds) ->
  x86.pages_in(app(m, "vm"), cv, int_div(int_sub(app(app(s, "gpr"), 4), 16), 4096), int_div(app(app(s, "gpr"), 4), 4096)) ->
  (all a. a in bits(64) -> !(int_le(int_sub(app(app(s, "gpr"), 4), 16), a) && int_lt(a, int_sub(app(app(s, "gpr"), 4), 8))) ->
    x86_64_linux.mapped(app(m, "vm"), x86_64_linux.page_of(a)) -> app(app(cv, "bytes"), a) = app(app(app(m, "vm"), "bytes"), a)) ->
  abi.stack_page(cv, int_div(int_sub(app(app(s, "gpr"), 4), 16), 4096)) ->
  (all a. a in bits(64) -> abi.in_domain(app(w, "vm"), ds, a) ->
    x86_64_linux.mapped(app(m, "vm"), x86_64_linux.page_of(a)) && app(app(cv, "bytes"), a) = app(app(app(w, "vm"), "bytes"), a))
proof
  fix s base code m w ds cv
  assume hi hmm hpi hby hsp
  let S := app(app(s, "gpr"), 4)
  have {sM, slt, sal} := hi
  have sb := apply(x86i.rsp_typed, sM)
  have s16 := apply(tr.inv_gap, hi)
  have h16: int_le(16, S) by arith(s16)
  have so: S in omega by simp(sb)
  have {oacc} := hmm
  have {bytes, pages} := expand(hmm, tr.mem).wm
  have _ _ _ pp4 := apply(tr.push_pages, {S}, sb, h16, slt, sal)
  fix a
  assume ha hd
  have ao: a in omega by simp(ha)
  have mw := mp(all_elim(bytes, {a}), ha, hd)
  // (an object's byte: above sp, accessible)
  have c1: a in ds -> x86_64_linux.mapped(app(m, "vm"), x86_64_linux.page_of(a)) && !(int_le(int_sub(S, 16), a) && int_lt(a, int_sub(S, 8))) proof
    assume hx
    have o := mp(all_elim(oacc, {a}), ao, hx)
    have ab: bits_of_int(64, a) = a by simp(ha)
    have ca0: x86_64_linux.can_access(app(m, "vm"), bits_of_int(64, a), 1) by taut(o)
    have sa: int_le(abi.sp(s), a) by taut(o)
    have ca := rewrite(ab, ca0)
    have m0: x86_64_linux.mapped(app(m, "vm"), x86_64_linux.page_of(a)) by taut(expand(ca, x86_64_linux.can_access))
    have nr: !(int_le(int_sub(S, 16), a) && int_lt(a, int_sub(S, 8))) by arith(sa, pp4, so, ao)
    show by taut(m0, nr)
  qed
  // (a mapped page's, not the stack's: the machine's too, not the push's)
  have c2: x86_64_linux.mapped(app(w, "vm"), int_div(a, x86_64_linux.PAGE)) && !(app(snd(app(app(app(w, "vm"), "pages"), int_div(a, x86_64_linux.PAGE))), "kind") = 2) ->
      x86_64_linux.mapped(app(m, "vm"), x86_64_linux.page_of(a)) && !(int_le(int_sub(S, 16), a) && int_lt(a, int_sub(S, 8))) proof
    assume hn
    have pa: int_div(a, 4096) in gc.PN by simp(ha, expand(hn.1, x86_64_linux.mapped, x86_64_linux.PAGE))
    have pc := mp(all_elim(pages, {int_div(a, 4096)}), pa)
    have nn: !(app(app(app(w, "vm"), "pages"), int_div(a, 4096)) = none) by taut(expand(hn.1, x86_64_linux.mapped, x86_64_linux.PAGE))
    have mpw: app(app(app(m, "vm"), "pages"), int_div(a, 4096)) = app(app(app(w, "vm"), "pages"), int_div(a, 4096)) by taut(pc, nn)
    have m0: x86_64_linux.mapped(app(m, "vm"), x86_64_linux.page_of(a)) by defs(simp(mpw, expand(hn.1, x86_64_linux.mapped)), x86_64_linux.mapped, x86_64_linux.page_of, x86_64_linux.PAGE)
    have nr: int_le(int_sub(S, 16), a) && int_lt(a, int_sub(S, 8)) -> false proof
      assume hr
      have j0: int_sub(a, int_sub(S, 16)) in omega by arith(hr, ao, so)
      have j8: int_lt(int_sub(a, int_sub(S, 16)), 8) by arith(hr)
      have _ pa2 := apply(tr.push_at, {S}, {int_sub(a, int_sub(S, 16))}, sb, h16, slt, sal, j0, j8)
      have ea: int_add(int_sub(S, 16), int_sub(a, int_sub(S, 16))) = a by arith(so, ao)
      have pg: int_div(a, 4096) = int_div(int_sub(S, 16), 4096) := rewrite(ea, pa2)
      // (the push's page: the machine's, mapped -- so the world's -- a stack page)
      have pq0: int_div(int_sub(S, 16), 4096) in omega by simp(so, h16)
      have pi := mp(all_elim(expand(hpi, x86.pages_in), {int_div(int_sub(S, 16), 4096)}), pq0)
      have mpw2 := rewrite(pg, mpw)
      have nn2 := rewrite(pg, nn)
      have mn := rewrite(sym(mpw2), nn2)
      have cvm0: app(app(cv, "pages"), int_div(int_sub(S, 16), 4096)) = app(app(app(m, "vm"), "pages"), int_div(int_sub(S, 16), 4096)) by taut(pi, mn)
      have cvm := trans(cvm0, mpw2)
      have k2 := rewrite(pg, expand(hn.2, x86_64_linux.PAGE))
      have sp2 := expand(hsp, abi.stack_page)
      have k3: app(snd(app(app(cv, "pages"), int_div(int_sub(S, 16), 4096))), "kind") = 2 by taut(sp2)
      have k4 := rewrite(cvm, k3)
      show by taut(k4, k2)
    qed
    show by taut(m0, nr)
  qed
  have mr: x86_64_linux.mapped(app(m, "vm"), x86_64_linux.page_of(a)) && !(int_le(int_sub(S, 16), a) && int_lt(a, int_sub(S, 8))) by taut(expand(hd, abi.in_domain), c1, c2)
  have cb := mp(all_elim(hby, {a}), ha, mr.2, mr.1)
  show by taut(mr.1, trans(cb, mw))
qed

// (the stack grown: the world's domain as before)
theorem tr.dom_grown: all wv pg ob a. a in bits(64) -> gc.grown(wv, pg) -> abi.in_domain(fn_update(wv, "pages", pg), ob, a) -> abi.in_domain(wv, ob, a)
proof
  fix wv pg ob a
  assume ha hg hd
  have c1: a in ob -> abi.in_domain(wv, ob, a) proof
    assume h
    show by defs(taut(h), abi.in_domain)
  qed
  have c2: x86_64_linux.mapped(fn_update(wv, "pages", pg), int_div(a, x86_64_linux.PAGE)) && !(app(snd(app(app(fn_update(wv, "pages", pg), "pages"), int_div(a, x86_64_linux.PAGE))), "kind") = 2) ->
      abi.in_domain(wv, ob, a) proof
    assume h
    have pp: int_div(a, x86_64_linux.PAGE) in gc.PN by simp(ha, expand(h.1, x86_64_linux.mapped))
    have gp := mp(all_elim(hg.2, {int_div(a, x86_64_linux.PAGE)}), pp)
    have e: app(pg, int_div(a, x86_64_linux.PAGE)) = app(app(wv, "pages"), int_div(a, x86_64_linux.PAGE)) by simp(gp, h.2)
    have hm: (int_lt(int_div(a, x86_64_linux.PAGE), int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) && !(app(pg, int_div(a, x86_64_linux.PAGE)) = none)) && !(app(snd(app(pg, int_div(a, x86_64_linux.PAGE))), "kind") = 2) by simp(expand(h, x86_64_linux.mapped))
    have hm2 := rewrite(e, hm)
    have m2: x86_64_linux.mapped(wv, int_div(a, x86_64_linux.PAGE)) && !(app(snd(app(app(wv, "pages"), int_div(a, x86_64_linux.PAGE))), "kind") = 2) by defs(taut(hm2), x86_64_linux.mapped)
    show by defs(taut(m2), abi.in_domain)
  qed
  show by taut(expand(hd, abi.in_domain), c1, c2)
qed

// a sound thread pointer, in a memory with the same pages and bytes on the
// domain: sound there
theorem tr.thread_xfer: all wv cv ob fs. app(cv, "pages") = app(wv, "pages") -> abi.thread_ok(wv, fs) -> fs in bits(64) ->
  (all a. a in bits(64) -> abi.in_domain(wv, ob, a) -> app(app(cv, "bytes"), a) = app(app(wv, "bytes"), a)) -> abi.thread_ok(cv, fs)
proof
  fix wv cv ob fs
  assume e ht hf hb
  have rd ns le := expand(ht, abi.thread_ok)
  have by: all k. k in omega -> int_lt(k, 8) -> app(app(cv, "bytes"), bits_add(64, fs, bits_of_int(64, k))) = app(app(wv, "bytes"), bits_add(64, fs, bits_of_int(64, k))) proof
    fix k
    assume k1 k2
    have r := mp(all_elim(expand(rd, x86_64_linux.readable), {k}), k1, k2)
    have n := mp(all_elim(ns, {k}), k1, k2)
    have lt: int_lt(int_add(fs, k), 18446744073709551616) by simp(expand(r, x86_64_linux.mapped, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE), k1)
    have ea: bits_add(64, fs, bits_of_int(64, k)) = int_add(fs, k) by defs(simp(hf, k1, k2, lt), bits_add, bits_of_int)
    have dm: abi.in_domain(wv, ob, int_add(fs, k)) by defs(taut(r, expand(n, abi.stack_page)), abi.in_domain)
    have b := mp(all_elim(hb, {int_add(fs, k)}), (int_add(fs, k) in bits(64) by simp(hf, k1, lt)), dm)
    show := rewrite(sym(ea), b)
  qed
  have ls := apply(tr.le_same, {app(cv, "bytes")}, {app(wv, "bytes")}, {fs}, {8}, simp(), by)
  have rd2: x86_64_linux.readable(cv, fs, 8) by defs(rewrite(sym(e), expand(rd, x86_64_linux.readable, x86_64_linux.mapped)), x86_64_linux.readable, x86_64_linux.mapped)
  have ns2: all x0. x0 in omega -> int_lt(x0, 8) -> !abi.stack_page(cv, int_div(int_add(fs, x0), x86_64_linux.PAGE)) by defs(rewrite(sym(e), expand(ns, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
  show by defs(taut(rd2, ns2, trans(ls, le)), abi.thread_ok)
qed


// (a world: its fields)
theorem tr.world_eta: all w. w in abi.World ->
  w = fn_update(fn_update(fn_update(fn_update(fn_update(empty, "vm", app(w, "vm")), "os", app(w, "os")), "fs_base", app(w, "fs_base")), "cpu", app(w, "cpu")), "objs", app(w, "objs"))
proof
  fix w
  assume hw
  let R := fn_update(fn_update(fn_update(fn_update(fn_update(empty, "vm", app(w, "vm")), "os", app(w, "os")), "fs_base", app(w, "fs_base")), "cpu", app(w, "cpu")), "objs", app(w, "objs"))
  have wf: is_fun(w) && dom(w) = abi.WKEYS by simp(expand(hw, abi.World))
  have de := dom_empty
  have f1 := mp(fn_update_fun[f := empty, k := "vm", v := app(w, "vm")], de.1)
  have f2 := mp(fn_update_fun[f := fn_update(empty, "vm", app(w, "vm")), k := "os", v := app(w, "os")], f1)
  have f3 := mp(fn_update_fun[f := fn_update(fn_update(empty, "vm", app(w, "vm")), "os", app(w, "os")), k := "fs_base", v := app(w, "fs_base")], f2)
  have f4 := mp(fn_update_fun[f := fn_update(fn_update(fn_update(empty, "vm", app(w, "vm")), "os", app(w, "os")), "fs_base", app(w, "fs_base")), k := "cpu", v := app(w, "cpu")], f3)
  have f5 := mp(fn_update_fun[f := fn_update(fn_update(fn_update(fn_update(empty, "vm", app(w, "vm")), "os", app(w, "os")), "fs_base", app(w, "fs_base")), "cpu", app(w, "cpu")), k := "objs", v := app(w, "objs")], f4)
  have d1 := mp(dom_update[f := empty, k := "vm", v := app(w, "vm")], de.1)
  have d2 := mp(dom_update[f := fn_update(empty, "vm", app(w, "vm")), k := "os", v := app(w, "os")], f1)
  have d3 := mp(dom_update[f := fn_update(fn_update(empty, "vm", app(w, "vm")), "os", app(w, "os")), k := "fs_base", v := app(w, "fs_base")], f2)
  have d4 := mp(dom_update[f := fn_update(fn_update(fn_update(empty, "vm", app(w, "vm")), "os", app(w, "os")), "fs_base", app(w, "fs_base")), k := "cpu", v := app(w, "cpu")], f3)
  have d5 := mp(dom_update[f := fn_update(fn_update(fn_update(fn_update(empty, "vm", app(w, "vm")), "os", app(w, "os")), "fs_base", app(w, "fs_base")), "cpu", app(w, "cpu")), k := "objs", v := app(w, "objs")], f4)
  have dset: all x. x in insert("objs", insert("cpu", insert("fs_base", insert("os", insert("vm", empty))))) <-> x in abi.WKEYS proof
    fix x
    have l: x in insert("objs", insert("cpu", insert("fs_base", insert("os", insert("vm", empty))))) -> x in abi.WKEYS proof
      assume h
      show by simp(h)
    qed
    have r: x in abi.WKEYS -> x in insert("objs", insert("cpu", insert("fs_base", insert("os", insert("vm", empty))))) proof
      assume h
      show by simp(h)
    qed
    show by taut(l, r)
  qed
  have deq := mp(set_ext[a := insert("objs", insert("cpu", insert("fs_base", insert("os", insert("vm", empty))))), b := abi.WKEYS], dset)
  have dr: dom(R) = abi.WKEYS by simp(d5, d4, d3, d2, d1, de.2, deq)
  have dw: dom(w) = dom(R) := trans(wf.2, sym(dr))
  have ap: all k. k in dom(w) -> app(w, k) = app(R, k) proof
    fix k
    assume hk
    have k5: k = "vm" || k = "os" || k = "fs_base" || k = "cpu" || k = "objs" by simp(rewrite(wf.2, hk))
    show by simp(k5)
  qed
  show := mp(rec_ext[a := w, b := R], wf.1, f5, dw, ap)
qed

// (the entry's stack pages: the machine's still, the world's)
theorem tr.inv_stack: all s base code fr m w ds p. tr.inv(s, base, code, fr, m, w) -> tr.mem(s, m, w, ds) -> p in omega -> abi.stack_page(app(s, "vm"), p) ->
  app(app(app(w, "vm"), "pages"), p) = app(app(app(s, "vm"), "pages"), p) && app(app(app(m, "vm"), "pages"), p) = app(app(app(s, "vm"), "pages"), p)
proof
  fix s base code fr m w ds p
  assume hi hmm hp hs
  have {wst} := hi
  have {pages} := expand(hmm, tr.mem).wm
  have e1 := mp(all_elim(wst, {p}), hp, hs)
  have sm := expand(hs, abi.stack_page, x86_64_linux.mapped)
  have pp: p in gc.PN by simp(hp, sm)
  have pc := mp(all_elim(pages, {p}), pp)
  have nn: !(app(app(app(w, "vm"), "pages"), p) = none) by simp(e1, sm)
  have e2: app(app(app(m, "vm"), "pages"), p) = app(app(app(w, "vm"), "pages"), p) by taut(pc, nn)
  show by taut(e1, trans(e2, e1))
qed

// The push done (C), GIMPLE's checks holding on the world grown to C's
// pages (W1): the callee's entry as the ABI has it, W1's memory a view of
// C's, the stack objects the callee's, W1 the callee's world
theorem tr.callee_ready: all s base code m w ds u RA T m1 e1 C. tr.inv(s, base, code, 8, m, w) -> tr.mem(s, m, w, ds) ->
  RA in bits(64) -> T in bits(64) -> app(app(m, "gpr"), 7) = u ->
  runs(x86_64_linux.touch_range(bits_sub(64, app(app(m, "gpr"), 4), 8), 8, 1), fn_update(m, "rip", RA), ok(m1, e1)) ->
  C = fn_update(fn_update(fn_update(m1, "vm", fn_update(app(m1, "vm"), "bytes", x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), bits_sub(64, app(app(m, "gpr"), 4), 8), 8, RA))),
    "gpr", fn_update(app(m1, "gpr"), 4, bits_sub(64, app(app(m, "gpr"), 4), 8))), "rip", T) ->
  gc.sound(gc.gw(w, app(app(C, "vm"), "pages"))) ->
  abi.entry_ok(C, seq_one(u)) && abi.view_ok(C, ds, app(gc.gw(w, app(app(C, "vm"), "pages")), "vm")) && tr.objs_ok(C, ds) &&
  abi.view(C, ds, app(gc.gw(w, app(app(C, "vm"), "pages")), "vm")) = gc.gw(w, app(app(C, "vm"), "pages")) &&
  app(gc.gw(w, app(app(C, "vm"), "pages")), "vm") in x86_64_linux.Vm && ds in set_type(omega)
proof
  fix s base code m w ds u RA T m1 e1 C
  assume hi hmm hra ht hu7 htr hC hsd
  let S := app(app(s, "gpr"), 4)
  let PG := app(app(C, "vm"), "pages")
  let WV := fn_update(app(w, "vm"), "pages", PG)
  have {sM, mM, mu, wW, wu, wcpu, mos, mfs, er4, sb, slt, sal, hsps, mdf, mcpu} := apply(tr.inv_call, hi)
  have s16 := apply(tr.inv_gap, hi)
  have h16: int_le(16, S) by arith(s16)
  have so: S in omega by simp(sb)
  have cM cu co cf cc0 cgs cfl cgpr crip ckc cvf cle cpi cby cstk cacc := apply(tr.push_ok, {s}, {base}, {code}, {m}, {w}, {RA}, {T}, {m1}, {e1}, {C}, hi, h16, hra, ht, htr, hC)
  have cv: app(C, "vm") in x86_64_linux.Vm := apply(x86i.parts, cM).4
  have gr := apply(tr.push_grown, {s}, {m}, {w}, {ds}, {app(C, "vm")}, {int_div(int_sub(S, 16), 4096)}, {int_div(S, 4096)}, hmm, cv, cpi, cstk)
  have hs: abi.thread_ok(WV, app(w, "fs_base")) && abi.stack_gap_free(WV) by simp(hsd, keep(abi.thread_ok, abi.stack_gap_free))
  have pe: app(app(C, "vm"), "pages") = app(WV, "pages") by simp()
  have sgfC := apply(tr.sgf_pages, {WV}, {app(C, "vm")}, pe, hs.2)
  // (the entry's stack pages: C's still)
  have kst: all p. p in omega -> abi.stack_page(app(s, "vm"), p) -> app(PG, p) = app(app(app(s, "vm"), "pages"), p) proof
    fix p
    assume hp hsp
    have k1 k2 := apply(tr.inv_stack, {s}, {base}, {code}, {8}, {m}, {w}, {ds}, {p}, hi, hmm, hp, hsp)
    have pi := mp(all_elim(expand(cpi, x86.pages_in), {p}), hp)
    have nn: !(app(app(app(m, "vm"), "pages"), p) = none) by simp(k2, expand(hsp, abi.stack_page, x86_64_linux.mapped))
    have e: app(PG, p) = app(app(app(m, "vm"), "pages"), p) by taut(pi, nn)
    show := trans(e, k2)
  qed
  have kspc: all p. p in omega -> abi.stack_page(app(s, "vm"), p) -> abi.stack_page(app(C, "vm"), p) proof
    fix p
    assume hp hsp
    have e := mp(all_elim(kst, {p}), hp, hsp)
    show by defs(rewrite(sym(e), expand(hsp, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
  qed
  have p0o: int_div(S, 4096) in omega by simp(so)
  have p0c := mp(all_elim(kspc, {int_div(S, 4096)}), p0o, hsps)
  have a00 := mp(all_elim(cacc, {0}), simp(), simp())
  have p64: pow2(64) = 18446744073709551616 by simp()
  have ea0: int_mod(int_add(int_sub(S, 16), int_mod(0, 18446744073709551616)), 18446744073709551616) = int_sub(S, 16) by arith(so, h16, slt)
  have ea: bits_add(64, int_sub(S, 16), bits_of_int(64, 0)) = int_sub(S, 16) by defs(rewrite(sym(p64), ea0), bits_add, bits_of_int)
  have acc0 := rewrite(ea, a00)
  have spC := apply(tr.push_page_stack, {app(C, "vm")}, {S}, sb, h16, slt, sal, sgfC, p0c, acc0)
  have dom := apply(tr.push_dom, {s}, {base}, {code}, {m}, {w}, {ds}, {app(C, "vm")}, hi, hmm, cpi, cby, spC)
  // C's bytes: the grown world's on its domain
  have byW: all a. a in bits(64) -> abi.in_domain(WV, ds, a) -> app(app(app(C, "vm"), "bytes"), a) = app(app(WV, "bytes"), a) proof
    fix a
    assume ha hd
    have d0 := apply(tr.dom_grown, {app(w, "vm")}, {PG}, {ds}, {a}, ha, gr, hd)
    have d1 := mp(all_elim(dom, {a}), ha, d0)
    show by simp(d1.2)
  qed
  have fsb: app(w, "fs_base") in bits(64) by simp(expand(wW, abi.World))
  have tC := apply(tr.thread_xfer, {WV}, {app(C, "vm")}, {ds}, {app(w, "fs_base")}, pe, hs.1, fsb, byW)
  have cfs: app(C, "fs_base") = app(w, "fs_base") := trans(cf, mfs)
  // the ABI's entry
  have c4: app(app(C, "gpr"), 4) = int_sub(S, 16) by simp(cgpr)
  have c7: app(app(C, "gpr"), 7) = u by simp(cgpr, hu7)
  have cdf: !app(app(C, "flags"), "df") by simp(cfl, mdf)
  have m1: int_mod(int_add(S, 8), 16) = 0 by simp(sb, sal, slt)
  have al: int_mod(bits_add(64, int_sub(S, 16), 8), 16) = 0 by simp(sb, h16, slt, m1)
  have ar: all x0. x0 in omega -> int_lt(x0, seq_len(seq_one(u))) -> app(app(C, "gpr"), app(abi.ARG_REGS, x0)) = app(seq_one(u), x0) proof
    fix x0
    assume h0 h1
    have l1: seq_len(seq_one(u)) = 1 by arith()
    have z: x0 = 0 by simp(h0, h1, l1)
    have ar0 := at({app(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(7), seq_one(6)), seq_one(2)), seq_one(1)), seq_one(8)), seq_one(9)), 0)})
    have u0 := at({app(seq_one(u), 0)})
    show by defs(simp(z, ar0, u0, c7), abi.ARG_REGS)
  qed
  have tC2 := rewrite(sym(cfs), tC)
  have spC2: abi.stack_page(app(C, "vm"), int_div(app(app(C, "gpr"), 4), x86_64_linux.PAGE)) by defs(simp(c4, spC), x86_64_linux.PAGE)
  have acc2: x86_64_linux.can_access(app(C, "vm"), app(app(C, "gpr"), 4), 1) by simp(c4, acc0)
  have al2: int_mod(bits_add(64, app(app(C, "gpr"), 4), 8), 16) = 0 by simp(c4, al)
  have eok: abi.entry_ok(C, seq_one(u)) by defs(taut(spC2, acc2, sgfC, al2, cdf, ar, tC2), abi.entry_ok)
  // the view
  have {top, limit, brk0, brk} := expand(hmm, tr.mem).wm
  have vf := expand(cvf, x86.vm_fields)
  have wmC: abi.world_matches(app(C, "vm"), app(C, "vm"), WV, ds, abi.sp(C)) proof
    have fr: all x0. x0 in bits(64) -> (int_le(abi.sp(C), x0) && !abi.in_domain(WV, ds, x0)) && abi.stack_page(app(C, "vm"), x86_64_linux.page_of(x0)) ->
        app(app(app(C, "vm"), "bytes"), x0) = app(app(app(C, "vm"), "bytes"), x0) proof
      fix x0
      assume h1 h2
      show := refl({app(app(app(C, "vm"), "bytes"), x0)})
    qed
    have pg: all x0. x0 in gc.PN -> app(app(app(C, "vm"), "pages"), x0) = app(app(WV, "pages"), x0) || (app(app(WV, "pages"), x0) = none && abi.stack_page(app(C, "vm"), x0)) proof
      fix x0
      assume h
      show by simp()
    qed
    show by defs(simp(vf, top, limit, brk0, brk, byW, fr, pg, keep(abi.in_domain, abi.stack_page)), abi.world_matches)
  qed
  have vok: abi.view_ok(C, ds, app(gc.gw(w, PG), "vm")) by simp(wmC, keep(abi.world_matches))
  // the stack objects
  have {oacc} := hmm
  have spc: abi.sp(C) = int_sub(S, 8) by simp(c4, sb, h16, slt)
  have pp4 := apply(tr.push_pages, {S}, sb, h16, slt, sal).4
  have ook: tr.objs_ok(C, ds) proof
    have g: all x. x in omega -> x in ds -> (int_le(abi.sp(C), x) && abi.stack_page(app(C, "vm"), int_div(x, x86_64_linux.PAGE))) && x86_64_linux.can_access(app(C, "vm"), bits_of_int(64, x), 1) proof
      fix x
      assume h1 h2
      have o := mp(all_elim(oacc, {x}), h1, h2)
      have sa: int_le(abi.sp(s), x) by taut(o)
      have sp0: abi.stack_page(app(s, "vm"), int_div(x, x86_64_linux.PAGE)) by taut(o)
      have ca: x86_64_linux.can_access(app(m, "vm"), bits_of_int(64, x), 1) by taut(o)
      have l: int_le(abi.sp(C), x) by arith(sa, spc, pp4, so, h1)
      have xpo: int_div(x, x86_64_linux.PAGE) in omega by defs(simp(h1), x86_64_linux.PAGE)
      have sc := mp(all_elim(kspc, {int_div(x, x86_64_linux.PAGE)}), xpo, sp0)
      // (its page: s's in C and in m)
      have xb: bits_of_int(64, x) in bits(64) by simp()
      have mc: x86_64_linux.mapped(app(m, "vm"), x86_64_linux.page_of(bits_of_int(64, x))) by taut(expand(ca, x86_64_linux.can_access))
      have pgo: x86_64_linux.page_of(bits_of_int(64, x)) in omega by defs(simp(), x86_64_linux.page_of)
      have pi := apply(tr.pages_eq_mapped, {app(m, "vm")}, {app(C, "vm")}, {int_div(int_sub(S, 16), 4096)}, {int_div(S, 4096)}, {x86_64_linux.page_of(bits_of_int(64, x))}, cpi, pgo, mc)
      have cc := apply(tr.access_page, {app(C, "vm")}, {app(m, "vm")}, {bits_of_int(64, x)}, {bits_of_int(64, x)}, {1}, refl({x86_64_linux.page_of(bits_of_int(64, x))}), pi)
      show by taut(l, sc, cc, ca)
    qed
    show by defs(g, tr.objs_ok)
  qed
  // the callee's world: the grown one
  have we := apply(tr.world_eta, wW)
  have {wob} := hmm
  have veq: abi.view(C, ds, app(gc.gw(w, PG), "vm")) = gc.gw(w, PG) proof
    have e2: gc.gw(w, PG) = fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(empty, "vm", app(w, "vm")), "os", app(w, "os")), "fs_base", app(w, "fs_base")), "cpu", app(w, "cpu")), "objs", app(w, "objs")), "vm", WV)
      := subst({y. fn_update(y, "vm", WV) = fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(empty, "vm", app(w, "vm")), "os", app(w, "os")), "fs_base", app(w, "fs_base")), "cpu", app(w, "cpu")), "objs", app(w, "objs")), "vm", WV)}, sym(we), refl({fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(empty, "vm", app(w, "vm")), "os", app(w, "os")), "fs_base", app(w, "fs_base")), "cpu", app(w, "cpu")), "objs", app(w, "objs")), "vm", WV)}))
    show by simp(e2, co, mos, cf, mfs, cc0, mcpu, wcpu, wob)
  qed
  have wu2 := mp(app_univ[u := 1, f := w, k := "vm"], wu)
  have wv0: app(w, "vm") in x86_64_linux.Vm by simp(expand(wW, abi.World))
  have pgu := mp(app_univ[u := 1, f := app(C, "vm"), k := "pages"], mp(app_univ[u := 1, f := C, k := "vm"], cu))
  have vt := apply(x86.vm_pages_put, {app(w, "vm")}, {PG}, wv0, wu2, apply(x86.vm_pages_typed, cv), pgu)
  have wvv: app(gc.gw(w, PG), "vm") in x86_64_linux.Vm by simp(vt.1)
  have dso: ds in set_type(omega) by simp(expand(wW, abi.World), wob)
  show by taut(eok, vok, ook, veq, wvv, dso)
qed


// (the program loaded, in a memory with the same mapped pages -- but the
// stack's -- and the same bytes on them: loaded there)
theorem tr.loaded_xfer: all v1 v2 gb gc st. (all p. p in omega -> x86_64_linux.mapped(v1, p) -> !abi.stack_page(v1, p) -> app(app(v2, "pages"), p) = app(app(v1, "pages"), p)) ->
  (all a. a in bits(64) -> x86_64_linux.mapped(v1, x86_64_linux.page_of(a)) -> !abi.stack_page(v1, x86_64_linux.page_of(a)) -> app(app(v2, "bytes"), a) = app(app(v1, "bytes"), a)) ->
  abi.loaded(v1, gb, gc, st) -> abi.loaded(v2, gb, gc, st)
proof
  fix v1 v2 gb gc st
  assume hp hb hl
  have l1 l2 := expand(hl, abi.loaded)
  have e: all i. i in omega -> int_lt(i, seq_len(gc)) ->
      app(app(v2, "pages"), x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))) = app(app(v1, "pages"), x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))) &&
      app(app(v2, "bytes"), bits_of_int(64, int_add(gb, i))) = app(app(v1, "bytes"), bits_of_int(64, int_add(gb, i))) proof
    fix i
    assume hi hn
    have cm cs := apply(tr.code_page, {v1}, {gb}, {gc}, {i}, l1, hi, hn)
    have po: x86_64_linux.page_of(bits_of_int(64, int_add(gb, i))) in omega by defs(simp(), x86_64_linux.page_of)
    have pe := mp(all_elim(hp, {x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))}), po, cm, cs)
    have be := mp(all_elim(hb, {bits_of_int(64, int_add(gb, i))}), simp(), cm, cs)
    show by taut(pe, be)
  qed
  have c2 := apply(tr.code_at_tr, {v1}, {v2}, {gb}, {gc}, l1, e)
  have s2: all x0. x0 in omega -> x0 in st -> x86_64_linux.mapped(v2, int_div(x0, x86_64_linux.PAGE)) && !abi.stack_page(v2, int_div(x0, x86_64_linux.PAGE)) proof
    fix x0
    assume h1 h2
    have c := mp(all_elim(l2, {x0}), h1, h2)
    have po: int_div(x0, x86_64_linux.PAGE) in omega by defs(simp(h1), x86_64_linux.PAGE)
    have pe := mp(all_elim(hp, {int_div(x0, x86_64_linux.PAGE)}), po, c.1, c.2)
    show by defs(rewrite(sym(pe), expand(c, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
  qed
  show by defs(taut(c2, s2), abi.loaded)
qed

// (the entry's stack pages kept to the callee's return x: through the
// push, the world grown, the callee -- which kept the world's stack pages
// -- and its return)
theorem tr.post_stack: all s base code m w ds RA T m1 e1 C x w2 p. tr.inv(s, base, code, 8, m, w) -> tr.mem(s, m, w, ds) -> RA in bits(64) -> T in bits(64) ->
  runs(x86_64_linux.touch_range(bits_sub(64, app(app(m, "gpr"), 4), 8), 8, 1), fn_update(m, "rip", RA), ok(m1, e1)) ->
  C = fn_update(fn_update(fn_update(m1, "vm", fn_update(app(m1, "vm"), "bytes", x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), bits_sub(64, app(app(m, "gpr"), 4), 8), 8, RA))),
    "gpr", fn_update(app(m1, "gpr"), 4, bits_sub(64, app(app(m, "gpr"), 4), 8))), "rip", T) ->
  gc.keeps_stack(gc.gw(w, app(app(C, "vm"), "pages")), w2) -> abi.world_matches(app(C, "vm"), app(x, "vm"), app(w2, "vm"), ds, abi.sp(C)) ->
  p in omega -> abi.stack_page(app(s, "vm"), p) ->
  app(app(app(C, "vm"), "pages"), p) = app(app(app(s, "vm"), "pages"), p) && app(app(app(w2, "vm"), "pages"), p) = app(app(app(s, "vm"), "pages"), p) &&
  app(app(app(x, "vm"), "pages"), p) = app(app(app(s, "vm"), "pages"), p)
proof
  fix s base code m w ds RA T m1 e1 C x w2 p
  assume hi hmm hra ht htr hC hks hwm hp hsp
  let S := app(app(s, "gpr"), 4)
  have s16 := apply(tr.inv_gap, hi)
  have h16: int_le(16, S) by arith(s16)
  have _ _ _ _ _ _ _ _ _ _ _ _ cpi _ _ _ := apply(tr.push_ok, {s}, {base}, {code}, {m}, {w}, {RA}, {T}, {m1}, {e1}, {C}, hi, h16, hra, ht, htr, hC)
  have k1 k2 := apply(tr.inv_stack, {s}, {base}, {code}, {8}, {m}, {w}, {ds}, {p}, hi, hmm, hp, hsp)
  have sm := expand(hsp, abi.stack_page, x86_64_linux.mapped)
  have pi := mp(all_elim(expand(cpi, x86.pages_in), {p}), hp)
  have nn: !(app(app(app(m, "vm"), "pages"), p) = none) by simp(k2, sm)
  have ec: app(app(app(C, "vm"), "pages"), p) = app(app(app(s, "vm"), "pages"), p) := trans((app(app(app(C, "vm"), "pages"), p) = app(app(app(m, "vm"), "pages"), p) by taut(pi, nn)), k2)
  have pp: p in gc.PN by simp(hp, sm)
  have ks := mp(all_elim(hks, {p}), pp)
  have ks1: !(app(app(app(C, "vm"), "pages"), p) = none) && app(snd(app(app(app(C, "vm"), "pages"), p)), "kind") = 2 -> app(app(app(w2, "vm"), "pages"), p) = app(app(app(C, "vm"), "pages"), p) by simp(ks)
  have ks2 := rewrite(ec, ks1)
  have sm2: !(app(app(app(s, "vm"), "pages"), p) = none) && app(snd(app(app(app(s, "vm"), "pages"), p)), "kind") = 2 by taut(sm)
  have ew := mp(ks2, sm2)
  have {pages} := hwm
  have px := mp(all_elim(pages, {p}), pp)
  have n2: !(app(app(app(w2, "vm"), "pages"), p) = none) by simp(ew, sm)
  have ex: app(app(app(x, "vm"), "pages"), p) = app(app(app(s, "vm"), "pages"), p) := trans((app(app(app(x, "vm"), "pages"), p) = app(app(app(w2, "vm"), "pages"), p) by taut(px, n2)), ew)
  show by taut(ec, ew, ex)
qed

// (the program loaded: in the world a machine's memory matches, from the
// machine's -- and back)
theorem tr.wm_back: all o n wv ob sp gb gc st. abi.world_matches(o, n, wv, ob, sp) -> abi.loaded(n, gb, gc, st) -> abi.loaded(wv, gb, gc, st)
proof
  fix o n wv ob sp gb gc st
  assume hw hl
  have {bytes, pages} := hw
  have pp: all p. p in omega -> x86_64_linux.mapped(n, p) -> !abi.stack_page(n, p) -> app(app(wv, "pages"), p) = app(app(n, "pages"), p) proof
    fix p
    assume hp hm hs
    have pn: p in gc.PN by simp(hp, expand(hm, x86_64_linux.mapped))
    have c := mp(all_elim(pages, {p}), pn)
    have ns: !(app(app(wv, "pages"), p) = none && abi.stack_page(n, p)) by taut(hs)
    have e1: app(app(n, "pages"), p) = app(app(wv, "pages"), p) by taut(c, ns)
    show := sym(e1)
  qed
  have bb: all a. a in bits(64) -> x86_64_linux.mapped(n, x86_64_linux.page_of(a)) -> !abi.stack_page(n, x86_64_linux.page_of(a)) -> app(app(wv, "bytes"), a) = app(app(n, "bytes"), a) proof
    fix a
    assume ha hm hs
    have po: x86_64_linux.page_of(a) in omega by defs(simp(ha), x86_64_linux.page_of)
    have e := mp(all_elim(pp, {x86_64_linux.page_of(a)}), po, hm, hs)
    have pe: x86_64_linux.page_of(a) = int_div(a, x86_64_linux.PAGE) by defs(simp(), x86_64_linux.page_of)
    have d: abi.in_domain(wv, ob, a) by defs(simp(rewrite(pe, e), expand(rewrite(pe, hm), x86_64_linux.mapped), expand(rewrite(pe, hs), abi.stack_page, x86_64_linux.mapped)), abi.in_domain, x86_64_linux.mapped)
    have b := mp(all_elim(bytes, {a}), ha, d)
    show := sym(b)
  qed
  show := apply(tr.loaded_xfer, {n}, {wv}, {gb}, {gc}, {st}, pp, bb, hl)
qed

theorem tr.wm_fwd: all o n wv ob sp gb gc st. abi.world_matches(o, n, wv, ob, sp) -> abi.loaded(wv, gb, gc, st) -> abi.loaded(n, gb, gc, st)
proof
  fix o n wv ob sp gb gc st
  assume hw hl
  have {bytes, pages} := hw
  have pp: all p. p in omega -> x86_64_linux.mapped(wv, p) -> !abi.stack_page(wv, p) -> app(app(n, "pages"), p) = app(app(wv, "pages"), p) proof
    fix p
    assume hp hm hs
    have pn: p in gc.PN by simp(hp, expand(hm, x86_64_linux.mapped))
    have c := mp(all_elim(pages, {p}), pn)
    have nn: !(app(app(wv, "pages"), p) = none) by taut(expand(hm, x86_64_linux.mapped))
    show by taut(c, nn)
  qed
  have bb: all a. a in bits(64) -> x86_64_linux.mapped(wv, x86_64_linux.page_of(a)) -> !abi.stack_page(wv, x86_64_linux.page_of(a)) -> app(app(n, "bytes"), a) = app(app(wv, "bytes"), a) proof
    fix a
    assume ha hm hs
    have pe: x86_64_linux.page_of(a) = int_div(a, x86_64_linux.PAGE) by defs(simp(), x86_64_linux.page_of)
    have d: abi.in_domain(wv, ob, a) by defs(simp(expand(rewrite(pe, hm), x86_64_linux.mapped), expand(rewrite(pe, hs), abi.stack_page, x86_64_linux.mapped)), abi.in_domain, x86_64_linux.mapped)
    show := mp(all_elim(bytes, {a}), ha, d)
  qed
  show := apply(tr.loaded_xfer, {wv}, {n}, {gb}, {gc}, {st}, pp, bb, hl)
qed

// (... and in the world grown)
theorem tr.grown_loaded: all wv pg gb gc st. gc.grown(wv, pg) -> abi.loaded(wv, gb, gc, st) -> abi.loaded(fn_update(wv, "pages", pg), gb, gc, st)
proof
  fix wv pg gb gc st
  assume hg hl
  have pp: all p. p in omega -> x86_64_linux.mapped(wv, p) -> !abi.stack_page(wv, p) -> app(app(fn_update(wv, "pages", pg), "pages"), p) = app(app(wv, "pages"), p) proof
    fix p
    assume hp hm hs
    have pn: p in gc.PN by simp(hp, expand(hm, x86_64_linux.mapped))
    have c := mp(all_elim(hg.2, {p}), pn)
    have nn: !(app(app(wv, "pages"), p) = none) by taut(expand(hm, x86_64_linux.mapped))
    show by simp(c, nn)
  qed
  have bb: all a. a in bits(64) -> x86_64_linux.mapped(wv, x86_64_linux.page_of(a)) -> !abi.stack_page(wv, x86_64_linux.page_of(a)) ->
      app(app(fn_update(wv, "pages", pg), "bytes"), a) = app(app(wv, "bytes"), a) proof
    fix a
    assume ha hm hs
    show by simp()
  qed
  show := apply(tr.loaded_xfer, {wv}, {fn_update(wv, "pages", pg)}, {gb}, {gc}, {st}, pp, bb, hl)
qed


// The callee returned (x, its world w2, from C at the world grown W1):
// the caller's coupling at the return address with the world W4 (w2 with
// the caller's stack objects, its pages the machine's), rax the result
theorem tr.post_call: all s base code m w ds RA T m1 e1 C x w2. tr.inv(s, base, code, 8, m, w) -> tr.mem(s, m, w, ds) -> base in omega -> RA in bits(64) -> T in bits(64) ->
  runs(x86_64_linux.touch_range(bits_sub(64, app(app(m, "gpr"), 4), 8), 8, 1), fn_update(m, "rip", RA), ok(m1, e1)) ->
  C = fn_update(fn_update(fn_update(m1, "vm", fn_update(app(m1, "vm"), "bytes", x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), bits_sub(64, app(app(m, "gpr"), 4), 8), 8, RA))),
    "gpr", fn_update(app(m1, "gpr"), 4, bits_sub(64, app(app(m, "gpr"), 4), 8))), "rip", T) ->
  tr.returns_valid(gc.gw(w, app(app(C, "vm"), "pages")), w2) -> gc.keeps_stack(gc.gw(w, app(app(C, "vm"), "pages")), w2) ->
  x in x86_64_linux.Machine -> x in univ(1) -> w2 in abi.World -> w2 in univ(1) ->
  abi.world_matches(app(C, "vm"), app(x, "vm"), app(w2, "vm"), ds, abi.sp(C)) -> app(x, "os") = app(w2, "os") -> app(x, "fs_base") = app(w2, "fs_base") ->
  app(x, "cpu") = app(C, "cpu") -> app(x, "gs_base") = app(C, "gs_base") -> app(x, "rip") = abi.ret(C) -> app(app(x, "gpr"), 4) = abi.sp(C) ->
  abi.callee_saved(x, C) -> !app(app(x, "flags"), "df") ->
  tr.inv(s, base, code, 8, x, gc.gw(gc.back(w2, gc.gw(w, app(app(C, "vm"), "pages"))), app(app(x, "vm"), "pages"))) &&
  tr.mem(s, x, gc.gw(gc.back(w2, gc.gw(w, app(app(C, "vm"), "pages"))), app(app(x, "vm"), "pages")), ds) &&
  tr.homes(s, x, empty) && tr.regs(x, fn_update(empty, 0, pair(8, app(app(x, "gpr"), 0)))) && app(x, "rip") = RA
proof
  fix s base code m w ds RA T m1 e1 C x w2
  assume hi hmm hbo hra ht htr hC hrv hks xM xu w2W w2u hwm xos xfs xcpu xgs xrip xr4 xcs xdf
  let S := app(app(s, "gpr"), 4)
  let PG := app(app(C, "vm"), "pages")
  let W1 := gc.gw(w, PG)
  let XV := app(x, "vm")
  let W4 := gc.gw(gc.back(w2, W1), app(XV, "pages"))
  have {sM, mM, mu, wW, wu, wst, wcpu, mos, mfs, er4, sb, slt, sal, hsps, sgf, winp, sws, mcpu, mgs, mdf} := apply(tr.inv_call, hi)
  have {cd, kc, ra8, mcs, sacc} := hi
  have s16 := apply(tr.inv_gap, hi)
  have h16: int_le(16, S) by arith(s16)
  have so: S in omega by simp(sb)
  have cM cu co cf cc0 cgs cfl cgpr crip ckc cvf cle cpi cby cstk cacc := apply(tr.push_ok, {s}, {base}, {code}, {m}, {w}, {RA}, {T}, {m1}, {e1}, {C}, hi, h16, hra, ht, htr, hC)
  have cv: app(C, "vm") in x86_64_linux.Vm := apply(x86i.parts, cM).4
  have gr := apply(tr.push_grown, {s}, {m}, {w}, {ds}, {app(C, "vm")}, {int_div(int_sub(S, 16), 4096)}, {int_div(S, 4096)}, hmm, cv, cpi, cstk)
  have rinp rev rld rcpu := expand(hrv, tr.returns_valid)
  have {top, limit, brk0, brk, bytes, frames, pages} := hwm
  have {wob, wm} := hmm
  have xv: XV in x86_64_linux.Vm := apply(x86i.parts, xM).4
  // (x's pages: w2's stack grown)
  have gr2: gc.grown(app(w2, "vm"), app(XV, "pages")) proof
    have f: app(XV, "pages") in fn_space(gc.PN, option(x86_64_linux.Page)) := apply(x86.vm_pages_typed, xv)
    have g: all p. p in gc.PN -> app(app(XV, "pages"), p) = app(app(app(w2, "vm"), "pages"), p) ||
        (app(app(app(w2, "vm"), "pages"), p) = none && !(app(app(XV, "pages"), p) = none) && app(snd(app(app(XV, "pages"), p)), "kind") = 2) proof
      fix p
      assume hp
      have c := mp(all_elim(pages, {p}), hp)
      show by simp(c, expand(c, abi.stack_page, x86_64_linux.mapped))
    qed
    show by taut(f, g)
  qed
  // the program loaded at x: loaded at m, the world, the world grown, the callee's world
  have chain: all gb gc st. gb in omega -> abi.loaded(app(m, "vm"), gb, gc, st) -> abi.loaded(XV, gb, gc, st) proof
    fix gb gc st
    assume hb l1
    have l2 := apply(tr.wm_back, wm, l1)
    have l3 := apply(tr.grown_loaded, gr, l2)
    have l3b: abi.loaded(app(W1, "vm"), gb, gc, st) by simp(l3)
    have l4 := mp(all_elim(rld, {gb}, {gc}, {st}), hb, l3b)
    show := apply(tr.wm_fwd, hwm, l4)
  qed
  have kcx: tr.keeps_code(app(s, "vm"), XV) proof
    have g: all gb gc st. gb in omega -> abi.loaded(app(s, "vm"), gb, gc, st) -> abi.loaded(XV, gb, gc, st) proof
      fix gb gc st
      assume hb hl
      have l1 := mp(all_elim(expand(kc, tr.keeps_code), {gb}, {gc}, {st}), hb, hl)
      show := mp(all_elim(chain, {gb}, {gc}, {st}), hb, l1)
    qed
    show by defs(g, tr.keeps_code)
  qed
  have lm: abi.loaded(app(m, "vm"), base, code, empty) by defs(simp(cd), abi.loaded)
  have lx := mp(all_elim(chain, {base}, {code}, {empty}), hbo, lm)
  have cdx := expand(lx, abi.loaded).1
  // (the entry's stack pages: x's, w2's, C's as s's)
  have pst: all p. p in omega -> abi.stack_page(app(s, "vm"), p) ->
      app(app(app(C, "vm"), "pages"), p) = app(app(app(s, "vm"), "pages"), p) && app(app(app(w2, "vm"), "pages"), p) = app(app(app(s, "vm"), "pages"), p) &&
      app(app(XV, "pages"), p) = app(app(app(s, "vm"), "pages"), p) proof
    fix p
    assume hp hsp
    show := apply(tr.post_stack, {s}, {base}, {code}, {m}, {w}, {ds}, {RA}, {T}, {m1}, {e1}, {C}, {x}, {w2}, {p}, hi, hmm, hra, ht, htr, hC, hks, hwm, hp, hsp)
  qed
  have p0o: int_div(S, 4096) in omega by simp(so)
  have ps0 := mp(all_elim(pst, {int_div(S, 4096)}), p0o, hsps)
  have spc: abi.sp(C) = int_sub(S, 8) by simp(cgpr, sb, h16, slt)
  have pp4 := apply(tr.push_pages, {S}, sb, h16, slt, sal).4
  // (a byte of the entry's stack pages, at or above sp(C), not an object: x's as C's, as m's)
  have xc: all a. a in bits(64) -> int_le(int_sub(S, 8), a) -> !(a in ds) -> abi.stack_page(app(s, "vm"), int_div(a, 4096)) ->
      app(app(XV, "bytes"), a) = app(app(app(m, "vm"), "bytes"), a) proof
    fix a
    assume ha hl hn hsp
    have ao: a in omega by simp(ha)
    have po: int_div(a, 4096) in omega by simp(ha)
    have e1 e2 _ := mp(all_elim(pst, {int_div(a, 4096)}), po, hsp)
    have pe: x86_64_linux.page_of(a) = int_div(a, 4096) by defs(simp(), x86_64_linux.page_of, x86_64_linux.PAGE)
    have sm := expand(hsp, abi.stack_page, x86_64_linux.mapped)
    have nd: !abi.in_domain(app(w2, "vm"), ds, a) by defs(simp(hn, e2, sm), abi.in_domain, x86_64_linux.mapped, x86_64_linux.PAGE)
    have sc: abi.stack_page(app(C, "vm"), x86_64_linux.page_of(a)) by defs(simp(pe, e1, sm), abi.stack_page, x86_64_linux.mapped)
    have l2: int_le(abi.sp(C), a) by simp(spc, hl)
    have lns: (int_le(abi.sp(C), a) && !abi.in_domain(app(w2, "vm"), ds, a)) && abi.stack_page(app(C, "vm"), x86_64_linux.page_of(a)) by taut(l2, nd, sc)
    have f := mp(all_elim(frames, {a}), ha, lns)
    have nr: !(int_le(int_sub(S, 16), a) && int_lt(a, int_sub(S, 8))) by arith(hl, so, ao)
    have k1 k2 := apply(tr.inv_stack, {s}, {base}, {code}, {8}, {m}, {w}, {ds}, {int_div(a, 4096)}, hi, hmm, po, hsp)
    have mm: x86_64_linux.mapped(app(m, "vm"), x86_64_linux.page_of(a)) by defs(simp(pe, k2, sm), x86_64_linux.mapped)
    have cb := mp(all_elim(cby, {a}), ha, nr, mm)
    show := trans(f, cb)
  qed
  // the invariant
  have x4: app(app(x, "gpr"), 4) = int_sub(S, 8) := trans(xr4, spc)
  have z8: int_sub(S, 8) = int_sub(app(app(s, "gpr"), 4), 8) := refl({int_sub(S, 8)})
  have kpx: tr.kept(app(s, "vm"), XV, S) proof
    have g: all a. a in omega -> int_le(int_sub(S, 8), a) -> int_lt(a, int_add(S, 8)) ->
        app(app(XV, "pages"), x86_64_linux.page_of(a)) = app(app(app(s, "vm"), "pages"), x86_64_linux.page_of(a)) proof
      fix a
      assume h1 h2 h3
      have pn := apply(tr.page_near, {S}, {a}, sb, sal, slt, h2, h3)
      have pe: x86_64_linux.page_of(a) = int_div(S, 4096) by defs(simp(pn), x86_64_linux.page_of, x86_64_linux.PAGE)
      show by simp(pe, ps0.3)
    qed
    show by defs(g, tr.kept)
  qed
  have rax: x86_64_linux.le(app(XV, "bytes"), S, 8) = abi.ret(s) proof
    have bs: all j. j in omega -> int_lt(j, 8) -> app(app(XV, "bytes"), bits_add(64, S, bits_of_int(64, j))) = app(app(app(m, "vm"), "bytes"), bits_add(64, S, bits_of_int(64, j))) proof
      fix j
      assume j1 j2
      have rb := apply(tr.ret_range, {S}, {j}, sb, slt, j1, j2)
      have pn := apply(tr.page_near, {S}, {bits_add(64, S, bits_of_int(64, j))}, sb, sal, slt, rb.2, rb.3)
      have sp1: abi.stack_page(app(s, "vm"), int_div(bits_add(64, S, bits_of_int(64, j)), 4096)) := rewrite(sym(pn), hsps)
      have {oacc} := hmm
      have nd: !(bits_add(64, S, bits_of_int(64, j)) in ds) proof
        have c: bits_add(64, S, bits_of_int(64, j)) in ds -> false proof
          assume hd
          have o := mp(all_elim(oacc, {bits_add(64, S, bits_of_int(64, j))}), rb.1, hd)
          have sa: int_le(abi.sp(s), bits_add(64, S, bits_of_int(64, j))) by taut(o)
          show by arith(sa, pp4, rb.3)
        qed
        show by taut(c)
      qed
      show := mp(all_elim(xc, {bits_add(64, S, bits_of_int(64, j))}), simp(), (int_le(int_sub(S, 8), bits_add(64, S, bits_of_int(64, j))) by arith(rb.2)), nd, sp1)
    qed
    have ls := apply(tr.le_same, {app(XV, "bytes")}, {app(app(m, "vm"), "bytes")}, {S}, {8}, simp(), bs)
    show := trans(ls, ra8)
  qed
  have xcs2: abi.callee_saved(x, s) by simp(xcs, cgpr, mcs)
  have xcpu2: app(x, "cpu") = app(s, "cpu") by simp(xcpu, cc0, mcpu)
  have xgs2: app(x, "gs_base") = app(s, "gs_base") by simp(xgs, cgs, mgs)
  have w4os: app(W4, "os") = app(w2, "os") by simp()
  have w4fs: app(W4, "fs_base") = app(w2, "fs_base") by simp()
  have w4in: app(app(W4, "os"), "input") = app(app(s, "os"), "input") by simp(rinp, winp)
  have w4ev: subset(app(app(s, "os"), "events"), app(app(W4, "os"), "events")) proof
    have e1: subset(app(app(s, "os"), "events"), app(app(W1, "os"), "events")) by simp(sws)
    have e2 := apply(tr.subset_trans, e1, rev)
    show by simp(e2)
  qed
  have w4cpu: app(W4, "cpu") = app(s, "cpu") by simp(rcpu, wcpu)
  // (W4: a world)
  have w2f := expand(w2W, abi.World)
  have wf := expand(wW, abi.World)
  have w2v: app(w2, "vm") in x86_64_linux.Vm by simp(w2f)
  have w2vu := mp(app_univ[u := 1, f := w2, k := "vm"], w2u)
  have xpu := mp(app_univ[u := 1, f := XV, k := "pages"], mp(app_univ[u := 1, f := x, k := "vm"], xu))
  have vt := apply(x86.vm_pages_put, {app(w2, "vm")}, {app(XV, "pages")}, w2v, w2vu, apply(x86.vm_pages_typed, xv), xpu)
  have wou := mp(app_univ[u := 1, f := w, k := "objs"], wu)
  have w4W: W4 in abi.World by defs(simp(w2f, wf, vt, w2u, wou), abi.World)
  have w4u: W4 in univ(1) by simp(w2u, vt, wou)
  have w4st: all p. p in omega -> abi.stack_page(app(s, "vm"), p) -> app(app(app(W4, "vm"), "pages"), p) = app(app(app(s, "vm"), "pages"), p) proof
    fix p
    assume po hsp
    show by simp(mp(all_elim(pst, {p}), po, hsp).3)
  qed
  have invx: tr.inv(s, base, code, 8, x, W4) by defs(simp(xM, xu, cdx, kcx, (app(app(x, "gpr"), 4) = int_sub(S, 8) by simp(x4)), (8 in omega by simp()), kpx, rax, xcs2, xcpu2, xgs2,
    (app(x, "os") = app(W4, "os") by simp(xos)), (app(x, "fs_base") = app(W4, "fs_base") by simp(xfs)), xdf, w4in, w4ev, w4W, w4u, w4cpu, w4st, sM, sacc, sal, hsps, slt, sgf, keep(abi.code_at, tr.keeps_code, tr.kept, x86_64_linux.Machine, abi.World, abi.stack_page, abi.stack_gap_free, x86_64_linux.can_access)), tr.inv)
  // the coupling
  have {oacc} := hmm
  have {wm} := hmm
  have mby := expand(wm, abi.world_matches)
  have mframes: all x0. x0 in bits(64) -> (int_le(abi.sp(s), x0) && !abi.in_domain(app(w, "vm"), ds, x0)) && abi.stack_page(app(s, "vm"), x86_64_linux.page_of(x0)) ->
      app(app(app(m, "vm"), "bytes"), x0) = app(app(app(s, "vm"), "bytes"), x0) := expand(wm, abi.world_matches).frames
  have by4: all a. a in bits(64) -> abi.in_domain(app(W4, "vm"), ds, a) -> app(app(XV, "bytes"), a) = app(app(app(W4, "vm"), "bytes"), a) proof
    fix a
    assume ha hd
    have hd2: abi.in_domain(fn_update(app(w2, "vm"), "pages", app(XV, "pages")), ds, a) by simp(hd)
    have d0 := apply(tr.dom_grown, {app(w2, "vm")}, {app(XV, "pages")}, {ds}, {a}, ha, gr2, hd2)
    have b := mp(all_elim(bytes, {a}), ha, d0)
    show by simp(b)
  qed
  have fr4: all a. a in bits(64) -> (int_le(abi.sp(s), a) && !abi.in_domain(app(W4, "vm"), ds, a)) && abi.stack_page(app(s, "vm"), x86_64_linux.page_of(a)) ->
      app(app(XV, "bytes"), a) = app(app(app(s, "vm"), "bytes"), a) proof
    fix a
    assume ha hf
    have ao: a in omega by simp(ha)
    have pe: x86_64_linux.page_of(a) = int_div(a, 4096) by defs(simp(), x86_64_linux.page_of, x86_64_linux.PAGE)
    have hn: !abi.in_domain(app(W4, "vm"), ds, a) by taut(hf)
    have nd: !(a in ds) by taut(expand(hn, abi.in_domain))
    have sp0: abi.stack_page(app(s, "vm"), x86_64_linux.page_of(a)) by taut(hf)
    have sp1: abi.stack_page(app(s, "vm"), int_div(a, 4096)) := rewrite(pe, sp0)
    have la: int_le(abi.sp(s), a) by taut(hf)
    have l1: int_le(int_sub(S, 8), a) by arith(la, pp4, so, ao)
    have xm := mp(all_elim(xc, {a}), ha, l1, nd, sp1)
    // (m's: s's -- the world's page there s's stack page)
    have po: int_div(a, 4096) in omega by simp(ha)
    have k1 _ := apply(tr.inv_stack, {s}, {base}, {code}, {8}, {m}, {w}, {ds}, {int_div(a, 4096)}, hi, hmm, po, sp1)
    have sm := expand(sp1, abi.stack_page, x86_64_linux.mapped)
    have ndw: !abi.in_domain(app(w, "vm"), ds, a) by defs(simp(nd, k1, sm), abi.in_domain, x86_64_linux.mapped, x86_64_linux.PAGE)
    have pre: (int_le(abi.sp(s), a) && !abi.in_domain(app(w, "vm"), ds, a)) && abi.stack_page(app(s, "vm"), x86_64_linux.page_of(a)) by taut(hf, ndw)
    have ms := mp(all_elim(mframes, {a}), ha, pre)
    show := trans(xm, ms)
  qed
  have pg4: all x0. x0 in gc.PN -> app(app(XV, "pages"), x0) = app(app(app(W4, "vm"), "pages"), x0) || (app(app(app(W4, "vm"), "pages"), x0) = none && abi.stack_page(XV, x0)) proof
    fix x0
    assume h
    show by simp()
  qed
  have wm4: abi.world_matches(app(s, "vm"), XV, app(W4, "vm"), ds, abi.sp(s)) by defs(simp(top, limit, brk0, brk, by4, fr4, pg4, keep(abi.in_domain, abi.stack_page)), abi.world_matches)
  have oa4: all y. y in omega -> y in ds -> (int_le(abi.sp(s), y) && abi.stack_page(app(s, "vm"), int_div(y, x86_64_linux.PAGE))) && x86_64_linux.can_access(XV, bits_of_int(64, y), 1) proof
    fix y
    assume h1 h2
    have o := mp(all_elim(oacc, {y}), h1, h2)
    have sp1: abi.stack_page(app(s, "vm"), int_div(y, x86_64_linux.PAGE)) by taut(o)
    have ca: x86_64_linux.can_access(app(m, "vm"), bits_of_int(64, y), 1) by taut(o)
    have sm := expand(sp1, abi.stack_page, x86_64_linux.mapped)
    have yl: int_lt(y, 18446744073709551616) by simp(h1, expand(sm, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))
    have yb: bits_of_int(64, y) = y by simp(h1, yl)
    have po: int_div(y, x86_64_linux.PAGE) in omega by defs(simp(h1), x86_64_linux.PAGE)
    have k1 k2 := apply(tr.inv_stack, {s}, {base}, {code}, {8}, {m}, {w}, {ds}, {int_div(y, x86_64_linux.PAGE)}, hi, hmm, po, sp1)
    have xp := mp(all_elim(pst, {int_div(y, x86_64_linux.PAGE)}), po, sp1).3
    have pe: x86_64_linux.page_of(y) = int_div(y, x86_64_linux.PAGE) by defs(simp(), x86_64_linux.page_of)
    have eqp: app(app(XV, "pages"), x86_64_linux.page_of(y)) = app(app(app(m, "vm"), "pages"), x86_64_linux.page_of(y)) by simp(pe, xp, k2)
    have ca2 := rewrite(yb, ca)
    have cc := apply(tr.access_page, {XV}, {app(m, "vm")}, {y}, {y}, {1}, refl({x86_64_linux.page_of(y)}), eqp)
    have cx: x86_64_linux.can_access(XV, y, 1) by taut(cc, ca2)
    have cx2 := rewrite(sym(yb), cx)
    show by taut(o, cx2)
  qed
  have wob4: app(W4, "objs") = ds by simp(wob)
  have mem4: tr.mem(s, x, W4, ds) by defs(taut(wob4, wm4, oa4), tr.mem)
  // the homes, rax, the return address
  have hom: tr.homes(s, x, empty) by defs(simp(dom_empty), tr.homes)
  have r0R: 0 in x86_64_linux.Reg by simp()
  have r0 := mp(mp(all_elim(x86i.reg_typed, {x}, {0}), xM), r0R)
  have re0: tr.regs(x, empty) by defs(simp(dom_empty), tr.regs)
  have rs1 := apply(tr.regs_set, {x}, {empty}, {0}, {8}, {app(app(x, "gpr"), 0)}, re0, simp(r0))
  have _ xg _ _ := apply(x86i.parts, xM)
  have gfd: is_fun(app(x, "gpr")) && dom(app(x, "gpr")) = x86_64_linux.Reg by simp(expand(xg, fn_space))
  have xfd: is_fun(x) && "gpr" in dom(x) by simp(expand(xM, x86_64_linux.Machine))
  have g0 := mp(mp(fn_update_same[f := app(x, "gpr"), k := 0], gfd.1), simp(gfd))
  have x0 := mp(mp(fn_update_same[f := x, k := "gpr"], xfd.1), xfd.2)
  have rs2 := rewrite(x0, rewrite(g0, rs1))
  have rg: tr.regs(x, fn_update(empty, 0, pair(8, app(app(x, "gpr"), 0)))) := rs2
  have rip: app(x, "rip") = RA by simp(xrip, cgpr, cle, sb, h16)
  show by taut(invx, mem4, hom, rg, rip)
qed


// (the argument in its register: the call's)
theorem tr.regs_one: all u ar. u in bits(64) -> u in gimple.in_reg(fst(ar), snd(ar)) -> gc.regs_ok(seq_one(u), seq_one(ar))
proof
  fix u ar
  assume hu hi
  have r1 _ r3 r4 := apply(tr.regs1, {u}, {ar}, hu, hi)
  show by taut(r1, r3, r4)
qed

// GIMPLE's call (the stack grown to pg) with the callee raising: the
// caller's rest raising
theorem tr.gcall_exc(g, ar, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all w pg u x e. w in univ(1) -> x in univ(1) -> e in univ(1) -> gc.grown(app(w, "vm"), pg) -> u in bits(64) -> u in gimple.in_reg(fst(ar), snd(ar)) ->
  gc.sound(gc.gw(w, pg)) -> runs(app(g, seq_one(u)), gc.gw(w, pg), exc(x, e)) -> (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) ->
  runs(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, seq_one(ar)), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, exc(x, e))
proof
  fix w pg u x e
  assume hw hx he hg hu hi hs hc hk
  have rg := apply(tr.regs_one, hu, hi)
  have c := apply(gc.call_exc, {g}, {seq_one(ar)}, {w}, {pg}, {seq_one(u)}, {x}, {e}, hw, hx, he, hg, rg, hs, hc)
  have c1 := apply(gc.call1_exc, {g}, {seq_one(ar)}, {w}, {x}, {e}, hw, hx, he, c)
  show := apply(tr.call_exc[g := g, args := seq_one(ar), a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {x}, {e}, hw, hx, he, c1, mp(all_elim(hk, {x}, {e}), hx, he))
qed

theorem tr.gcall_div(g, ar, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all w pg u t. w in univ(1) -> t in univ(1) -> gc.grown(app(w, "vm"), pg) -> u in bits(64) -> u in gimple.in_reg(fst(ar), snd(ar)) ->
  gc.sound(gc.gw(w, pg)) -> runs(app(g, seq_one(u)), gc.gw(w, pg), diverge(t)) -> (all t. t in univ(1) -> runs(mkprog(x0 x1. ex x8. dd(t, x8) && k(x8, x1)), w, diverge(t))) ->
  runs(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, seq_one(ar)), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, diverge(t))
proof
  fix w pg u t
  assume hw ht hg hu hi hs hc hd
  have rg := apply(tr.regs_one, hu, hi)
  have c := apply(gc.call_div, {g}, {seq_one(ar)}, {w}, {pg}, {seq_one(u)}, {t}, hw, ht, hg, rg, hs, hc)
  have c1 := apply(gc.call1_div, {g}, {seq_one(ar)}, {w}, {t}, hw, ht, c)
  show := apply(tr.call_div[g := g, args := seq_one(ar), a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {t}, hw, ht, c1, mp(all_elim(hd, {t}), ht))
qed

// GIMPLE's call undefined (any of its exceptions): the caller undefined
theorem tr.gcall_ub(g, ar, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all s v w. w in abi.World -> w in univ(1) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(gimple.call(g, seq_one(ar)), w, exc(x, e))) -> (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) ->
  tr.ub(s, v, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, seq_one(ar)), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w)
proof
  fix s v w
  assume hW hw hall hk
  have eu: empty in univ(1) by simp()
  have c := mp(all_elim(hall, {w}, {empty}), hw, eu)
  have c1 := apply(gc.call1_exc, {g}, {seq_one(ar)}, {w}, {w}, {empty}, hw, hw, eu, c)
  have pe := apply(tr.call_exc[g := g, args := seq_one(ar), a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {w}, {empty}, hw, hw, eu, c1, mp(all_elim(hk, {w}, {empty}), hw, eu))
  have eno: !(empty = exc_val("stack_overflow", empty)) by defs(all_elim(tr.pair_ne, {"stack_overflow"}, {empty}), exc_val)
  have rst: abi.raise_state(w) by defs(apply(tr.world_and, hW), abi.raise_state)
  show by defs(ex_intro({empty}, {w}, taut(eu, eno, rst, pe)), tr.ub)
qed

// the callee returned (w4, the result r0:r1): the call overflowing after
// it (the stack grown to pg2), or the caller's rest from W4 with r0
theorem tr.gcall_ret(g, ar, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all w pg u w4 r0 r1 pg2. w in univ(1) -> w4 in univ(1) -> r0 in univ(1) -> r1 in univ(1) -> gc.grown(app(w, "vm"), pg) -> u in bits(64) -> u in gimple.in_reg(fst(ar), snd(ar)) ->
  gc.sound(gc.gw(w, pg)) -> runs(app(g, seq_one(u)), gc.gw(w, pg), ok(w4, pair(r0, r1))) -> gc.keeps_stack(gc.gw(w, pg), w4) -> gc.grown(app(w4, "vm"), pg2) -> (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) ->
  runs(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, seq_one(ar)), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, exc(gc.gw(gc.back(w4, gc.gw(w, pg)), pg2), exc_val("stack_overflow", empty))) &&
  (all o. runs(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. a(x0, r0, x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), gc.gw(gc.back(w4, gc.gw(w, pg)), pg2), o) ->
    runs(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, seq_one(ar)), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, o))
proof
  fix w pg u w4 r0 r1 pg2
  assume hw hw4 h0 h1 hg hu hi hs hc hks hg2 hk
  let W4 := gc.gw(gc.back(w4, gc.gw(w, pg)), pg2)
  have rg := apply(tr.regs_one, hu, hi)
  have gu := apply(gc.gw_univ, hw, hg)
  have bu: gc.back(w4, gc.gw(w, pg)) in univ(1) by simp(hw4, hw, gu)
  have w4u := apply(gc.gw_univ, bu, (gc.grown(app(gc.back(w4, gc.gw(w, pg)), "vm"), pg2) by simp(hg2)))
  have ou: exc_val("stack_overflow", empty) in univ(1) by defs(simp(), exc_val)
  have co := apply(gc.call_ovf_after, {g}, {seq_one(ar)}, {w}, {pg}, {seq_one(u)}, {w4}, {r0}, {r1}, {pg2}, hw, hw4, h0, h1, hg, rg, hs, hc, hks, hg2)
  have c1o := apply(gc.call1_exc, {g}, {seq_one(ar)}, {w}, {W4}, {exc_val("stack_overflow", empty)}, hw, w4u, ou, co)
  have po := apply(tr.call_exc[g := g, args := seq_one(ar), a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {W4}, {exc_val("stack_overflow", empty)}, hw, w4u, ou, c1o, mp(all_elim(hk, {W4}, {exc_val("stack_overflow", empty)}), w4u, ou))
  have ck := apply(gc.call_ok, {g}, {seq_one(ar)}, {w}, {pg}, {seq_one(u)}, {w4}, {pg2}, {r0}, {r1}, hw, hw4, h0, h1, hg, rg, hs, hc, hks, hg2)
  have c1k := apply(gc.call1_ok, {g}, {seq_one(ar)}, {w}, {W4}, {r0}, {r1}, hw, w4u, h0, h1, ck)
  have qc := mp(all_elim(tr.qs_call[op := gimple.call1(g, seq_one(ar)), w4 := W4, r := r0, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1)], {w}), hw, c1k)
  have pk := apply(tr.p_red[q := mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, seq_one(ar)), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)),
    q2 := mkprog(x0 x1. ex x8. a(x0, r0, x8) && k(x8, x1)), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {W4}, hw, qc)
  show by taut(po, pk)
qed

// (a memory's own pages: grown)
theorem tr.grown_refl: all vm. vm in x86_64_linux.Vm -> gc.grown(vm, app(vm, "pages"))
proof
  fix vm
  assume hv
  have f := apply(x86.vm_pages_typed, hv)
  have g: all p. p in gc.PN -> app(app(vm, "pages"), p) = app(app(vm, "pages"), p) ||
      (app(app(vm, "pages"), p) = none && !(app(app(vm, "pages"), p) = none) && app(snd(app(app(vm, "pages"), p)), "kind") = 2) proof
    fix p
    assume h
    show by simp()
  qed
  show by taut(f, g)
qed

// (the callee's world xw back with the caller's (w's) stack objects: a world)
theorem tr.back_world: all xw w pg. xw in abi.World -> xw in univ(1) -> w in abi.World -> w in univ(1) ->
  gc.gw(gc.back(xw, gc.gw(w, pg)), app(app(xw, "vm"), "pages")) in abi.World && gc.gw(gc.back(xw, gc.gw(w, pg)), app(app(xw, "vm"), "pages")) in univ(1)
proof
  fix xw w pg
  assume hx hxu hw hwu
  have xf := expand(hx, abi.World)
  have wf := expand(hw, abi.World)
  have xv: app(xw, "vm") in x86_64_linux.Vm by simp(xf)
  have xvu := mp(app_univ[u := 1, f := xw, k := "vm"], hxu)
  have vs := apply(abi.vm_bytes_same, xv)
  have pe: fn_update(app(xw, "vm"), "pages", app(app(xw, "vm"), "pages")) = app(xw, "vm") by simp(mp(mp(fn_update_same[f := app(xw, "vm"), k := "pages"], simp(expand(xv, x86_64_linux.Vm))), simp(expand(xv, x86_64_linux.Vm))))
  have wou := mp(app_univ[u := 1, f := w, k := "objs"], hwu)
  have pt := apply(x86.vm_pages_typed, xv)
  have a: gc.gw(gc.back(xw, gc.gw(w, pg)), app(app(xw, "vm"), "pages")) in abi.World by defs(simp(xf, wf, pe, pt, xv, xvu, hxu, wou), abi.World)
  have b: gc.gw(gc.back(xw, gc.gw(w, pg)), app(app(xw, "vm"), "pages")) in univ(1) by simp(pe, xvu, hxu, wou)
  show by taut(a, b)
qed

// The callee (on W1, the world grown) crashing as the ABI allows: the
// caller crashing as it allows
theorem tr.callee_crash(g, ar, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all s base code m w ds pg u C o. tr.inv(s, base, code, 8, m, w) -> tr.mem(s, m, w, ds) ->
  app(C, "os") = app(m, "os") -> app(app(C, "gpr"), 4) = int_sub(app(app(s, "gpr"), 4), 16) ->
  gc.grown(app(w, "vm"), pg) -> u in bits(64) -> u in gimple.in_reg(fst(ar), snd(ar)) -> gc.sound(gc.gw(w, pg)) ->
  g in fn_space(abi.ARGS, powerset(univ(1))) -> seq_one(u) in abi.ARGS -> abi.view(C, ds, app(gc.gw(w, pg), "vm")) = gc.gw(w, pg) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) -> (all t. t in univ(1) -> runs(mkprog(x0 x1. ex x8. dd(t, x8) && k(x8, x1)), w, diverge(t))) ->
  abi.crashes_at(g, seq_one(u), ds, app(gc.gw(w, pg), "vm"), C, o) ->
  tr.crash(s, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, seq_one(ar)), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, o)
proof
  fix s base code m w ds pg u C o
  assume hi hmm co c4 hg hu hi0 hs hgt hA veq hk hd hc
  let S := app(app(s, "gpr"), 4)
  let P := mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, seq_one(ar)), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))
  have {wW, wu, mos, sb, slt, sal, winp, sws} := apply(tr.inv_call, hi)
  have s16 := apply(tr.inv_gap, hi)
  have h16: int_le(16, S) by arith(s16)
  have spc: abi.sp(C) = int_sub(S, 8) by simp(c4, sb, h16, slt)
  have pp4 := apply(tr.push_pages, {S}, sb, h16, slt, sal).4
  have gu := apply(gc.gw_univ, wu, hg)
  obtain m1 a0 k0, {oe, m1M, ab, sev, ovk} from expand(hc, abi.crashes_at)
  // the fault: below the caller's sp too
  have oe2: (o = exc(m1, exc_val("segv", pair(a0, k0))) && (k0 = 0 || k0 = 1 || k0 = 3) && abi.overflow_at(app(m1, "vm"), app(app(m1, "gpr"), 4), abi.sp(s), a0)) ||
      o = exc(m1, exc_val("stack_fault", empty)) proof
    have c1: (o = exc(m1, exc_val("segv", pair(a0, k0))) && (k0 = 0 || k0 = 1 || k0 = 3) && abi.overflow_at(app(m1, "vm"), app(app(m1, "gpr"), 4), abi.sp(C), a0)) ->
        (o = exc(m1, exc_val("segv", pair(a0, k0))) && (k0 = 0 || k0 = 1 || k0 = 3) && abi.overflow_at(app(m1, "vm"), app(app(m1, "gpr"), 4), abi.sp(s), a0)) proof
      assume h
      have lt al := expand(rewrite(spc, h.3), abi.overflow_at)
      have lt2: int_lt(a0, abi.sp(s)) by simp(lt, pp4)
      have ov: abi.overflow_at(app(m1, "vm"), app(app(m1, "gpr"), 4), abi.sp(s), a0) by defs(taut(al, lt2), abi.overflow_at)
      show by taut(h, ov)
    qed
    show by taut(oe, c1)
  qed
  // the I/O so far: the input as at the entry, the events grown since
  have sev2 := rewrite(trans(co, mos), sev)
  have sub := apply(tr.subset_trans, {app(app(s, "os"), "events")}, {app(app(w, "os"), "events")}, {app(app(m1, "os"), "events")}, sws, sev2)
  have inp0 ex0 := expand(ovk, abi.overflow_ok)
  have inp1: app(app(C, "os"), "input") = app(app(m1, "os"), "input") by simp(inp0)
  have inp2 := rewrite(trans(co, mos), inp1)
  have inp := trans(sym(winp), inp2)
  // (the callee overflowed right at its call: GIMPLE's call overflows first)
  have oc: app(app(abi.view(C, ds, app(gc.gw(w, pg), "vm")), "os"), "events") = app(app(m1, "os"), "events") -> tr.ovf(P, w, app(m1, "os")) proof
    assume e
    have ev: app(app(w, "os"), "events") = app(app(m1, "os"), "events") by simp(e, co, mos)
    show := apply(tr.call_ovf[g := g, args := seq_one(ar), a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {app(m1, "os")}, wW, wu, ev, mp(all_elim(hk, {w}, {exc_val("stack_overflow", empty)}), wu, defs(simp(), exc_val)))
  qed
  // (the spec's point where the I/O stops: the caller's rest stops there too)
  have ox: (ex x0. x0 in outcome_type(rec_and(abi.World, single(empty)), cart(bits(64), bits(64))) && (runs(app(g, seq_one(u)), abi.view(C, ds, app(gc.gw(w, pg), "vm")), x0) &&
      ite(fst(x0) = 0, app(app(fst(snd(x0)), "os"), "events") = app(app(m1, "os"), "events"),
        ite(fst(x0) = 1, snd(snd(x0)) = exc_val("stack_overflow", empty) && app(app(fst(snd(x0)), "os"), "events") = app(app(m1, "os"), "events"),
          app(snd(x0), "os.events") = app(app(m1, "os"), "events"))))) -> tr.ovf(P, w, app(m1, "os")) proof
    assume ex1
    obtain x0, hx0t hx0ri from ex1
    have hx0r hit := hx0ri
    have hx0r2 := rewrite(veq, hx0r)
    have pu := apply(tr.spec_univ, {g}, {seq_one(u)}, {gc.gw(w, pg)}, {x0}, hgt, hA, hx0r2)
    have cs := apply(tr.outcome_cases, {rec_and(abi.World, single(empty))}, {cart(bits(64), bits(64))}, {x0}, hx0t)
    // the callee returned (its I/O the crash's): GIMPLE's call overflows after it, or is undefined
    have c1: (ex a b. a in rec_and(abi.World, single(empty)) && b in cart(bits(64), bits(64)) && x0 = ok(a, b)) -> tr.ovf(P, w, app(m1, "os")) proof
      assume e
      obtain xw r, xa rb xe from e
      have xW := apply(tr.and_world, xa)
      have pu2 := rewrite(xe, pu)
      have xu: xw in univ(1) by simp(pu2)
      obtain r0 r1, r0b r1b re from mp(cart_elim[a := bits(64), b := bits(64), z := r], rb)
      have r0u: r0 in univ(1) by simp(r0b)
      have r1u: r1 in univ(1) by simp(r1b)
      have it := apply(tr.ite_t, {fst(x0) = 0}, {app(app(fst(snd(x0)), "os"), "events") = app(app(m1, "os"), "events")},
        {ite(fst(x0) = 1, snd(snd(x0)) = exc_val("stack_overflow", empty) && app(app(fst(snd(x0)), "os"), "events") = app(app(m1, "os"), "events"),
          app(snd(x0), "os.events") = app(app(m1, "os"), "events"))}, simp(xe))
      have ev0 := rewrite(it, hit)
      have ev: app(app(xw, "os"), "events") = app(app(m1, "os"), "events") by simp(rewrite(xe, ev0))
      have hg2 := rewrite(re, rewrite(xe, hx0r2))
      have xv: app(xw, "vm") in x86_64_linux.Vm by simp(expand(xW, abi.World))
      have ks: gc.keeps_stack(gc.gw(w, pg), xw) -> tr.ovf(P, w, app(m1, "os")) proof
        assume hks
        have gr2 := apply(tr.grown_refl, xv)
        have po _ := apply(tr.gcall_ret[g := g, ar := ar, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {pg}, {u}, {xw}, {r0}, {r1}, {app(app(xw, "vm"), "pages")}, wu, xu, r0u, r1u, hg, hu, hi0, hs, hg2, hks, gr2, hk)
        have bw bu := apply(tr.back_world, {xw}, {w}, {pg}, xW, xu, wW, wu)
        have ev3: app(app(gc.gw(gc.back(xw, gc.gw(w, pg)), app(app(xw, "vm"), "pages")), "os"), "events") = app(app(m1, "os"), "events") by simp(ev)
        show := apply(tr.ovf_exc, {P}, {w}, {app(m1, "os")}, {gc.gw(gc.back(xw, gc.gw(w, pg)), app(app(xw, "vm"), "pages"))}, apply(tr.world_and, bw), po, ev3)
      qed
      have nks: !gc.keeps_stack(gc.gw(w, pg), xw) -> tr.ovf(P, w, app(m1, "os")) proof
        assume hn
        have rg := apply(tr.regs_one, hu, hi0)
        have ou: exc_val("stack_overflow", empty) in univ(1) by defs(simp(), exc_val)
        have cu := apply(gc.call_ub_after, {g}, {seq_one(ar)}, {w}, {pg}, {seq_one(u)}, {xw}, {pair(r0, r1)}, {xw}, {exc_val("stack_overflow", empty)}, wu, xu, xu, ou, hg, rg, hs, hg2, hn)
        have c1x := apply(gc.call1_exc, {g}, {seq_one(ar)}, {w}, {xw}, {exc_val("stack_overflow", empty)}, wu, xu, ou, cu)
        have pe := apply(tr.call_exc[g := g, args := seq_one(ar), a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {xw}, {exc_val("stack_overflow", empty)}, wu, xu, ou, c1x, mp(all_elim(hk, {xw}, {exc_val("stack_overflow", empty)}), xu, ou))
        show := apply(tr.ovf_exc, {P}, {w}, {app(m1, "os")}, {xw}, xa, pe, ev)
      qed
      show by taut(ks, nks)
    qed
    // the callee overflowed: so does the caller
    have c2: (ex a b. a in rec_and(abi.World, single(empty)) && b in univ(1) && x0 = exc(a, b)) -> tr.ovf(P, w, app(m1, "os")) proof
      assume e
      obtain xw eb, xa ebu xe from e
      have pu2 := rewrite(xe, pu)
      have xu: xw in univ(1) by simp(pu2)
      have itf := apply(tr.ite_f, {fst(x0) = 0}, {app(app(fst(snd(x0)), "os"), "events") = app(app(m1, "os"), "events")},
        {ite(fst(x0) = 1, snd(snd(x0)) = exc_val("stack_overflow", empty) && app(app(fst(snd(x0)), "os"), "events") = app(app(m1, "os"), "events"),
          app(snd(x0), "os.events") = app(app(m1, "os"), "events"))}, simp(xe))
      have itt := apply(tr.ite_t, {fst(x0) = 1}, {snd(snd(x0)) = exc_val("stack_overflow", empty) && app(app(fst(snd(x0)), "os"), "events") = app(app(m1, "os"), "events")},
        {app(snd(x0), "os.events") = app(app(m1, "os"), "events")}, simp(xe))
      have c0 := rewrite(trans(itf, itt), hit)
      have eo ev: eb = exc_val("stack_overflow", empty) && app(app(xw, "os"), "events") = app(app(m1, "os"), "events") by simp(rewrite(xe, c0))
      have hg2 := rewrite(xe, hx0r2)
      have pe0 := apply(tr.gcall_exc[g := g, ar := ar, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {pg}, {u}, {xw}, {eb}, wu, xu, ebu, hg, hu, hi0, hs, hg2, hk)
      have pe := rewrite(eo, pe0)
      show := apply(tr.ovf_exc, {P}, {w}, {app(m1, "os")}, {xw}, xa, pe, ev)
    qed
    // the callee ran on: so does the caller
    have c3: (ex t. t in univ(1) && x0 = diverge(t)) -> tr.ovf(P, w, app(m1, "os")) proof
      assume e
      obtain t, tu xe from e
      have itf := apply(tr.ite_f, {fst(x0) = 0}, {app(app(fst(snd(x0)), "os"), "events") = app(app(m1, "os"), "events")},
        {ite(fst(x0) = 1, snd(snd(x0)) = exc_val("stack_overflow", empty) && app(app(fst(snd(x0)), "os"), "events") = app(app(m1, "os"), "events"),
          app(snd(x0), "os.events") = app(app(m1, "os"), "events"))}, simp(xe))
      have itf2 := apply(tr.ite_f, {fst(x0) = 1}, {snd(snd(x0)) = exc_val("stack_overflow", empty) && app(app(fst(snd(x0)), "os"), "events") = app(app(m1, "os"), "events")},
        {app(snd(x0), "os.events") = app(app(m1, "os"), "events")}, simp(xe))
      have c0 := rewrite(trans(itf, itf2), hit)
      have ev: app(t, "os.events") = app(app(m1, "os"), "events") by simp(rewrite(xe, c0))
      have hg2 := rewrite(xe, hx0r2)
      have pd := apply(tr.gcall_div[g := g, ar := ar, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {pg}, {u}, {t}, wu, tu, hg, hu, hi0, hs, hg2, hd)
      show := apply(tr.ovf_div, {P}, {w}, {app(m1, "os")}, {t}, tu, pd, ev)
    qed
    show by taut(cs, c1, c2, c3)
  qed
  have ovf: tr.ovf(P, w, app(m1, "os")) by taut(ex0, oc, ox)
  show by defs(ex_intro({m1}, {a0}, {k0}, taut(oe2, m1M, ab, sub, inp, ovf)), tr.crash)
qed


// ----------------------------------------------------------------------
//  The callee runs: from its entry state C, the caller's claim

theorem tr.callee_sim(g, ar, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all s v base code m w ds u RA T m1 e1 C cb cc st.
  tr.inv(s, base, code, 8, m, w) -> tr.mem(s, m, w, ds) -> base in omega ->
  app(app(m, "gpr"), 7) = u -> u in bits(64) -> u in gimple.in_reg(fst(ar), snd(ar)) -> RA in bits(64) -> T in bits(64) ->
  runs(x86_64_linux.touch_range(bits_sub(64, app(app(m, "gpr"), 4), 8), 8, 1), fn_update(m, "rip", RA), ok(m1, e1)) ->
  C = fn_update(fn_update(fn_update(m1, "vm", fn_update(app(m1, "vm"), "bytes", x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), bits_sub(64, app(app(m, "gpr"), 4), 8), 8, RA))),
    "gpr", fn_update(app(m1, "gpr"), 4, bits_sub(64, app(app(m, "gpr"), 4), 8))), "rip", T) ->
  tr.implements_at(T, g, cb, cc, st) -> abi.loaded(app(s, "vm"), cb, cc, st) -> cb in omega ->
  g in fn_space(abi.ARGS, powerset(univ(1))) -> tr.callee_io(g, 1) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) -> (all t. t in univ(1) -> runs(mkprog(x0 x1. ex x8. dd(t, x8) && k(x8, x1)), w, diverge(t))) ->
  (all w4 r0. w4 in abi.World && w4 in univ(1) -> r0 in bits(64) -> tr.pt(s, v, base, code, 8, RA, empty, ds, fn_update(empty, 0, pair(8, r0)),
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. a(x0, r0, x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w4)) ->
  tr.sim(s, v, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, seq_one(ar)), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, C)
proof
  fix s v base code m w ds u RA T m1 e1 C cb cc st
  assume hi hmm hb hu7 hu hin hra ht htr hC himp hld hcb hgt hio hk hd hpost
  let S := app(app(s, "gpr"), 4)
  let PG := app(app(C, "vm"), "pages")
  let W1 := gc.gw(w, PG)
  let P := mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, seq_one(ar)), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))
  have {sM, wW, wu, sb, slt, sal} := apply(tr.inv_call, hi)
  have {kc} := hi
  have s16 := apply(tr.inv_gap, hi)
  have h16: int_le(16, S) by arith(s16)
  have cM cu co cf cc0 cgs cfl cgpr crip ckc cvf cle cpi cby cstk cacc := apply(tr.push_ok, {s}, {base}, {code}, {m}, {w}, {RA}, {T}, {m1}, {e1}, {C}, hi, h16, hra, ht, htr, hC)
  have cv: app(C, "vm") in x86_64_linux.Vm := apply(x86i.parts, cM).4
  have gr := apply(tr.push_grown, {s}, {m}, {w}, {ds}, {app(C, "vm")}, {int_div(int_sub(S, 16), 4096)}, {int_div(S, 4096)}, hmm, cv, cpi, cstk)
  have c4: app(app(C, "gpr"), 4) = int_sub(S, 16) by simp(cgpr)
  have spc: abi.sp(C) = int_sub(S, 8) by simp(c4, sb, h16, slt)
  have pp4 := apply(tr.push_pages, {S}, sb, h16, slt, sal).4
  have rg := apply(tr.regs_one, hu, hin)
  // GIMPLE's checks failing at the world grown: undefined
  have bad: !gc.sound(W1) -> tr.sim(s, v, P, w, C) proof
    assume hn
    have all: all x e. x in univ(1) -> e in univ(1) -> runs(gimple.call(g, seq_one(ar)), w, exc(x, e)) proof
      fix x e
      assume hx he
      show := apply(gc.call_ub, {g}, {seq_one(ar)}, {w}, {PG}, {seq_one(u)}, {x}, {e}, wu, hx, he, gr, rg, hn)
    qed
    have ub := apply(tr.gcall_ub[g := g, ar := ar, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {s}, {v}, {w}, wW, wu, all, hk)
    show := apply(tr.sim_ub, {s}, {v}, {P}, {w}, {C}, ub)
  qed
  // ... holding: the callee's entry, its contract
  have good: gc.sound(W1) -> tr.sim(s, v, P, w, C) proof
    assume hs
    have eok vok ook veq wvv dso := apply(tr.callee_ready, {s}, {base}, {code}, {m}, {w}, {ds}, {u}, {RA}, {T}, {m1}, {e1}, {C}, hi, hmm, hra, ht, hu7, htr, hC, hs)
    have l1 := mp(all_elim(expand(kc, tr.keeps_code), {cb}, {cc}, {st}), hcb, hld)
    have lC := mp(all_elim(expand(ckc, tr.keeps_code), {cb}, {cc}, {st}), hcb, l1)
    have ul := apply(tr.seq_one_type, {u}, {bits(64)}, hu)
    have l1n: seq_len(seq_one(u)) = 1 by arith()
    have hA: seq_one(u) in abi.ARGS by simp(ul, l1n)
    let WV := app(W1, "vm")
    have ctr: all oc. tr.run_d(C, C, oc) -> tr.matches_t(g, seq_one(u), ds, WV, C, oc) proof
      fix oc
      assume hrd
      show := mp(all_elim(expand(himp, tr.implements_at), {seq_one(u)}, {ds}, {WV}, {C}, {oc}), hA, dso, wvv, cM, cu, lC, crip, eok, ook, vok, hrd)
    qed
    // (W1: a world)
    have ou := apply(abi.objs_univ, dso)
    have wvu := apply(x86.vm_univ, wvv)
    have vu: abi.view(C, ds, WV) in univ(1) by simp(cu, ou, wvu)
    have vW := apply(abi.world_typed, cM, dso, wvv, vu)
    have w1W: W1 in abi.World := rewrite(veq, vW)
    have w1u := apply(gc.gw_univ, wu, gr)
    // the callee raising: the caller undefined
    have rub: abi.raises_at(g, seq_one(u), ds, WV, C) -> tr.ub(s, v, P, w) proof
      assume hr
      obtain e x, eu eno rst rr from expand(hr, abi.raises_at)
      have rr2 := rewrite(veq, rr)
      have pu := apply(tr.spec_univ, {g}, {seq_one(u)}, {W1}, {exc(x, e)}, hgt, hA, rr2)
      have xu: x in univ(1) by simp(pu)
      have pe := apply(tr.gcall_exc[g := g, ar := ar, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {PG}, {u}, {x}, {e}, wu, xu, eu, gr, hu, hin, hs, rr2, hk)
      show by defs(ex_intro({e}, {x}, taut(eu, eno, rst, pe)), tr.ub)
    qed
    // the caller's run from C
    have g0: all o. tr.run_d(s, C, o) -> tr.ub(s, v, P, w) || tr.ok(s, v, P, w, o) || tr.crash(s, P, w, o) proof
      fix o
      assume hr
      have spl: int_le(abi.sp(C), abi.sp(s)) by simp(spc, pp4)
      have rs := apply(tr.run_split, {s}, {C}, {o}, sM, spl, hr)
      // (1) the caller's run is the callee's
      have b1: tr.run_d(C, C, o) -> tr.ub(s, v, P, w) || tr.ok(s, v, P, w, o) || tr.crash(s, P, w, o) proof
        assume hrc
        have mt2 := expand(mp(all_elim(ctr, {o}), hrc), tr.matches_t)
        have u1: abi.raises_at(g, seq_one(u), ds, WV, C) -> tr.ub(s, v, P, w) || tr.ok(s, v, P, w, o) || tr.crash(s, P, w, o) proof
          assume ra
          have ub := mp(rub, ra)
          show by taut(ub)
        qed
        have u2: abi.crashes_at(g, seq_one(u), ds, WV, C, o) -> tr.ub(s, v, P, w) || tr.ok(s, v, P, w, o) || tr.crash(s, P, w, o) proof
          assume ca
          have cr := apply(tr.callee_crash[g := g, ar := ar, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {s}, {base}, {code}, {m}, {w}, {ds}, {PG}, {u}, {C}, {o}, hi, hmm, co, c4, gr, hu, hin, hs, hgt, hA, veq, hk, hd, ca)
          show by taut(cr)
        qed
        // (a return of the callee is not the caller's: its rsp is lower)
        have u3: (ex m2 w2. o = ok(m2, empty) && app(app(m2, "gpr"), 4) = abi.sp(C)) -> tr.ub(s, v, P, w) || tr.ok(s, v, P, w, o) || tr.crash(s, P, w, o) proof
          assume eo
          obtain m2 w2, oe r2 from eo
          have _ r1 := apply(tr.run_d_ok, {s}, {C}, {m2}, {empty}, rewrite(oe, hr))
          have ne: false by simp(r1, r2, spc, pp4, sb, h16)
          show by taut(ne)
        qed
        have okc: (ex m1 w2. o = ok(m1, empty) && m1 in x86_64_linux.Machine && m1 in univ(1) &&
            runs(app(g, seq_one(u)), abi.view(C, ds, WV), ok(w2, pair(app(app(m1, "gpr"), 0), app(app(m1, "gpr"), 2)))) && w2 in abi.World && w2 in univ(1) &&
            abi.world_matches(app(C, "vm"), app(m1, "vm"), app(w2, "vm"), ds, abi.sp(C)) && app(m1, "os") = app(w2, "os") && app(m1, "fs_base") = app(w2, "fs_base") &&
            app(m1, "cpu") = app(C, "cpu") && app(m1, "gs_base") = app(C, "gs_base") && app(m1, "rip") = abi.ret(C) && app(app(m1, "gpr"), 4) = abi.sp(C) &&
            abi.callee_saved(m1, C) && !app(app(m1, "flags"), "df")) -> (ex m2 w2. o = ok(m2, empty) && app(app(m2, "gpr"), 4) = abi.sp(C)) proof
          assume eo
          obtain m2 w2, eo2 from eo
          show by ex_intro({m2}, {w2}, taut(eo2.1, eo2.13))
        qed
        show by taut(mt2, u1, u2, u3, okc)
      qed
      // (3) the callee leaving its discipline: its contract has it raise
      have b3: (ex x. tr.run_d(C, C, exc(x, exc_val("disc", empty)))) -> tr.ub(s, v, P, w) || tr.ok(s, v, P, w, o) || tr.crash(s, P, w, o) proof
        assume ed
        obtain x, hx from ed
        have mt2 := expand(mp(all_elim(ctr, {exc(x, exc_val("disc", empty))}), hx), tr.matches_t)
        have n1: (ex m1 w2. exc(x, exc_val("disc", empty)) = ok(m1, empty) && m1 in x86_64_linux.Machine && m1 in univ(1) &&
            runs(app(g, seq_one(u)), abi.view(C, ds, WV), ok(w2, pair(app(app(m1, "gpr"), 0), app(app(m1, "gpr"), 2)))) && w2 in abi.World && w2 in univ(1) &&
            abi.world_matches(app(C, "vm"), app(m1, "vm"), app(w2, "vm"), ds, abi.sp(C)) && app(m1, "os") = app(w2, "os") && app(m1, "fs_base") = app(w2, "fs_base") &&
            app(m1, "cpu") = app(C, "cpu") && app(m1, "gs_base") = app(C, "gs_base") && app(m1, "rip") = abi.ret(C) && app(app(m1, "gpr"), 4) = abi.sp(C) &&
            abi.callee_saved(m1, C) && !app(app(m1, "flags"), "df")) -> false proof
          assume eo
          obtain m2 w2, eo2 from eo
          show by simp(eo2.1)
        qed
        have n2: abi.crashes_at(g, seq_one(u), ds, WV, C, exc(x, exc_val("disc", empty))) -> false proof
          assume ca
          obtain m2 a0 k0, {oe} from expand(ca, abi.crashes_at)
          show by simp(expand(oe, exc_val))
        qed
        have r3: abi.raises_at(g, seq_one(u), ds, WV, C) by taut(mt2, n1, n2)
        have ub := mp(rub, r3)
        show by taut(ub)
      qed
      // (2) the callee returned to the caller, whose run goes on
      have b2: (ex x o1. tr.run_d(C, C, ok(x, empty)) && tr.run_d(s, x, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2))) -> tr.ub(s, v, P, w) || tr.ok(s, v, P, w, o) || tr.crash(s, P, w, o) proof
        assume eb
        obtain x o1, hrx hr1 ho1 from eb
        have mt2 := expand(mp(all_elim(ctr, {ok(x, empty)}), hrx), tr.matches_t)
        have n2: abi.crashes_at(g, seq_one(u), ds, WV, C, ok(x, empty)) -> false proof
          assume ca
          obtain m2 a0 k0, {oe} from expand(ca, abi.crashes_at)
          show by simp(oe)
        qed
        have u1: abi.raises_at(g, seq_one(u), ds, WV, C) -> tr.ub(s, v, P, w) || tr.ok(s, v, P, w, o) || tr.crash(s, P, w, o) proof
          assume ra
          have ub := mp(rub, ra)
          show by taut(ub)
        qed
        have u2: (ex m1 w2. ok(x, empty) = ok(m1, empty) && m1 in x86_64_linux.Machine && m1 in univ(1) &&
            runs(app(g, seq_one(u)), abi.view(C, ds, WV), ok(w2, pair(app(app(m1, "gpr"), 0), app(app(m1, "gpr"), 2)))) && w2 in abi.World && w2 in univ(1) &&
            abi.world_matches(app(C, "vm"), app(m1, "vm"), app(w2, "vm"), ds, abi.sp(C)) && app(m1, "os") = app(w2, "os") && app(m1, "fs_base") = app(w2, "fs_base") &&
            app(m1, "cpu") = app(C, "cpu") && app(m1, "gs_base") = app(C, "gs_base") && app(m1, "rip") = abi.ret(C) && app(app(m1, "gpr"), 4) = abi.sp(C) &&
            abi.callee_saved(m1, C) && !app(app(m1, "flags"), "df")) -> tr.ub(s, v, P, w) || tr.ok(s, v, P, w, o) || tr.crash(s, P, w, o) proof
          assume eo
          obtain m2 w2, eo2 from eo
          have xm: x = m2 by simp(eo2.1)
          let r0 := app(app(x, "gpr"), 0)
          let r1 := app(app(x, "gpr"), 2)
          have _ xM xu hg0 w2W w2u wm0 xos xfs xcpu xgs xrip0 xr4 xcs xdf := rewrite(sym(xm), eo2)
          have hg8 := rewrite(veq, hg0)
          have r0R: 0 in x86_64_linux.Reg by simp()
          have r2R: 2 in x86_64_linux.Reg by simp()
          have r0b := mp(mp(all_elim(x86i.reg_typed, {x}, {0}), xM), r0R)
          have r1b := mp(mp(all_elim(x86i.reg_typed, {x}, {2}), xM), r2R)
          have r0u: r0 in univ(1) by simp(r0b)
          have r1u: r1 in univ(1) by simp(r1b)
          // the callee's spec: a valid world on its return, or undefined there (so is this call)
          have ci := mp(all_elim(expand(hio, tr.callee_io), {seq_one(u)}, {W1}, {w2}, {pair(r0, r1)}),
            (ord_le(1, seq_len(seq_one(u))) by defs(arith(), ord_le)), w1W, hg8)
          have mr: tr.may_raise(g, seq_one(u), W1) -> tr.ub(s, v, P, w) || tr.ok(s, v, P, w, o) || tr.crash(s, P, w, o) proof
            assume hm
            have eu: empty in univ(1) by simp()
            have pe := mp(all_elim(expand(hm, tr.may_raise), {W1}, {empty}), w1u, eu)
            have eno: !(empty = exc_val("stack_overflow", empty)) by defs(all_elim(tr.pair_ne, {"stack_overflow"}, {empty}), exc_val)
            have rst: abi.raise_state(W1) by defs(apply(tr.world_and, w1W), abi.raise_state)
            have pe2 := subst({y. runs(app(g, seq_one(u)), y, exc(W1, empty))}, sym(veq), pe)
            have ra: abi.raises_at(g, seq_one(u), ds, WV, C) by defs(ex_intro({empty}, {W1}, taut(eu, eno, rst, pe2)), abi.raises_at)
            show := mp(u1, ra)
          qed
          // the callee changed the world's stack pages: undefined
          have fc: !gc.keeps_stack(W1, w2) -> tr.ub(s, v, P, w) || tr.ok(s, v, P, w, o) || tr.crash(s, P, w, o) proof
            assume hn
            have all: all x e. x in univ(1) -> e in univ(1) -> runs(gimple.call(g, seq_one(ar)), w, exc(x, e)) proof
              fix x0 e0
              assume hx he
              show := apply(gc.call_ub_after, {g}, {seq_one(ar)}, {w}, {PG}, {seq_one(u)}, {w2}, {pair(r0, r1)}, {x0}, {e0}, wu, w2u, hx, he, gr, rg, hs, hg8, hn)
            qed
            have ub := apply(tr.gcall_ub[g := g, ar := ar, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {s}, {v}, {w}, wW, wu, all, hk)
            show by taut(ub)
          qed
          // ... kept: the caller goes on at the return address with the result
          have fk: gc.keeps_stack(W1, w2) -> tr.returns_valid(W1, w2) -> tr.ub(s, v, P, w) || tr.ok(s, v, P, w, o) || tr.crash(s, P, w, o) proof
            assume hks rv
            have xv: app(x, "vm") in x86_64_linux.Vm := apply(x86i.parts, xM).4
            have pinv pmem phom preg prip := apply(tr.post_call, {s}, {base}, {code}, {m}, {w}, {ds}, {RA}, {T}, {m1}, {e1}, {C}, {x}, {w2},
              hi, hmm, hb, hra, ht, htr, hC, rv, hks, xM, xu, w2W, w2u, wm0, xos, xfs, xcpu, xgs, xrip0, xr4, xcs, xdf)
            let W4 := gc.gw(gc.back(w2, W1), app(app(x, "vm"), "pages"))
            have gr2: gc.grown(app(w2, "vm"), app(app(x, "vm"), "pages")) proof
              have f := apply(x86.vm_pages_typed, xv)
              have {pages} := wm0
              have g1: all p. p in gc.PN -> app(app(app(x, "vm"), "pages"), p) = app(app(app(w2, "vm"), "pages"), p) ||
                  (app(app(app(w2, "vm"), "pages"), p) = none && !(app(app(app(x, "vm"), "pages"), p) = none) && app(snd(app(app(app(x, "vm"), "pages"), p)), "kind") = 2) proof
                fix p
                assume hp
                have c := mp(all_elim(pages, {p}), hp)
                show by simp(c, expand(c, abi.stack_page, x86_64_linux.mapped))
              qed
              show by taut(f, g1)
            qed
            have _ pk := apply(tr.gcall_ret[g := g, ar := ar, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {PG}, {u}, {w2}, {r0}, {r1}, {app(app(x, "vm"), "pages")}, wu, w2u, r0u, r1u, gr, hu, hin, hs, hg8, hks, gr2, hk)
            have red: tr.red(P, w, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. a(x0, r0, x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), W4) by defs(pk, tr.red)
            have {w4W = wW, w4u = wu} := pinv
            have ptk := mp(all_elim(hpost, {W4}, {r0}), taut(w4W, w4u), r0b)
            have sm := mp(all_elim(expand(ptk, tr.pt), {x}), pinv, prip, phom, preg, pmem)
            have sm2 := apply(tr.sim_red, {s}, {v}, {P}, {w}, {mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. a(x0, r0, x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))}, {W4}, {x}, red, sm)
            have t1 := mp(all_elim(expand(sm2, tr.sim), {o1}), hr1)
            have same: o1 = o -> tr.ub(s, v, P, w) || tr.ok(s, v, P, w, o) || tr.crash(s, P, w, o) proof
              assume e
              show := rewrite(e, t1)
            qed
            have divs: (fst(o1) = 2 && fst(o) = 2) -> tr.ub(s, v, P, w) || tr.ok(s, v, P, w, o) || tr.crash(s, P, w, o) proof
              assume dd2
              have nk: tr.ok(s, v, P, w, o1) -> false proof
                assume k1
                obtain mk wk, k3 from expand(k1, tr.ok)
                show by simp(rewrite(k3.1, dd2))
              qed
              have nc: tr.crash(s, P, w, o1) -> false proof
                assume k1
                obtain mk ak kk, {oe} from expand(k1, tr.crash)
                have q1: o1 = exc(mk, exc_val("stack_fault", empty)) -> false proof
                  assume e
                  show by simp(rewrite(e, dd2))
                qed
                have q2: o1 = exc(mk, exc_val("segv", pair(ak, kk))) -> false proof
                  assume e
                  show by simp(rewrite(e, dd2))
                qed
                show by taut(oe, q1, q2)
              qed
              show by taut(t1, nk, nc)
            qed
            show by taut(ho1, same, divs)
          qed
          show by taut(fc, fk, ci, mr)
        qed
        show by taut(mt2, n2, u1, u2)
      qed
      show by taut(rs, b1, b2, b3)
    qed
    show by defs(g0, tr.sim)
  qed
  show by taut(bad, good)
qed

// ----------------------------------------------------------------------
//  A caller's contract: its code with its callees'

// (code loaded as two pieces: each loaded at its place)
theorem tr.code_concat: all vm b c1 c2 t. c1 in list_type(t) -> c2 in list_type(t) -> b in omega -> abi.code_at(vm, b, seq_concat(c1, c2)) ->
  abi.code_at(vm, b, c1) && abi.code_at(vm, int_add(b, seq_len(c1)), c2)
proof
  fix vm b c1 c2 t
  assume h1 h2 hb hc
  have cc := expand(hc, abi.code_at)
  have n1: seq_len(c1) in omega by simp(h1)
  have n2: seq_len(c2) in omega by simp(h2)
  have ln: seq_len(seq_concat(c1, c2)) = int_add(seq_len(c1), seq_len(c2)) by arith(h1, h2)
  have g1: all i. i in omega -> int_lt(i, seq_len(c1)) ->
      ((x86_64_linux.fetchable(vm, bits_of_int(64, int_add(b, i))) && !x86_64_linux.can_access(vm, bits_of_int(64, int_add(b, i)), 1)) &&
        !abi.stack_page(vm, x86_64_linux.page_of(bits_of_int(64, int_add(b, i))))) && app(app(vm, "bytes"), bits_of_int(64, int_add(b, i))) = app(c1, i) proof
    fix i
    assume hi hl
    have l2: int_lt(i, seq_len(seq_concat(c1, c2))) by arith(hl, ln, n2, hi)
    have ci := mp(all_elim(cc, {i}), hi, l2)
    have e := at({app(seq_concat(c1, c2), i)}, h1, h2, hi, hl)
    show by simp(ci, e)
  qed
  have g2: all i. i in omega -> int_lt(i, seq_len(c2)) ->
      ((x86_64_linux.fetchable(vm, bits_of_int(64, int_add(int_add(b, seq_len(c1)), i))) && !x86_64_linux.can_access(vm, bits_of_int(64, int_add(int_add(b, seq_len(c1)), i)), 1)) &&
        !abi.stack_page(vm, x86_64_linux.page_of(bits_of_int(64, int_add(int_add(b, seq_len(c1)), i))))) &&
      app(app(vm, "bytes"), bits_of_int(64, int_add(int_add(b, seq_len(c1)), i))) = app(c2, i) proof
    fix i
    assume hi hl
    have jo: int_add(seq_len(c1), i) in omega by simp(n1, hi)
    have l2: int_lt(int_add(seq_len(c1), i), seq_len(seq_concat(c1, c2))) by arith(hl, ln, n1, hi)
    have ci := mp(all_elim(cc, {int_add(seq_len(c1), i)}), jo, l2)
    have e0 := at({app(seq_concat(c1, c2), int_add(seq_len(c1), i))}, h1, h2, hi, hl, n1)
    have k: int_sub(int_add(seq_len(c1), i), seq_len(c1)) = i by arith(hi, n1)
    have e := rewrite(k, e0)
    have ad: int_add(b, int_add(seq_len(c1), i)) = int_add(int_add(b, seq_len(c1)), i) by arith(hb, n1, hi)
    have ci2 := rewrite(ad, ci)
    show by simp(ci2, e)
  qed
  have r1: abi.code_at(vm, b, c1) by defs(g1, abi.code_at)
  have r2: abi.code_at(vm, int_add(b, seq_len(c1)), c2) by defs(g2, abi.code_at)
  show by taut(r1, r2)
qed

// ... and so the program with its statics
theorem tr.loaded_concat: all vm b c1 c2 t st. c1 in list_type(t) -> c2 in list_type(t) -> b in omega -> abi.loaded(vm, b, seq_concat(c1, c2), st) ->
  abi.loaded(vm, b, c1, st) && abi.loaded(vm, int_add(b, seq_len(c1)), c2, st)
proof
  fix vm b c1 c2 t st
  assume h1 h2 hb hl
  have l := expand(hl, abi.loaded)
  have cc := apply(tr.code_concat, {vm}, {b}, {c1}, {c2}, {t}, h1, h2, hb, taut(l))
  show by defs(taut(l, cc), abi.loaded)
qed

// a callee's contract for its own code: for more code loaded too
theorem tr.implements_widen: all f spec b c b2 c2 st. tr.implements_at(f, spec, b, c, st) ->
  (all vm. abi.loaded(vm, b2, c2, st) -> abi.loaded(vm, b, c, st)) -> tr.implements_at(f, spec, b2, c2, st)
proof
  fix f spec b c b2 c2 st
  assume h hw
  have g: all args objs mem s o. args in abi.ARGS -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(app(s, "vm"), b2, c2, st) ->
      app(s, "rip") = f -> abi.entry_ok(s, args) -> tr.objs_ok(s, objs) -> abi.view_ok(s, objs, mem) -> tr.run_d(s, s, o) -> tr.matches_t(spec, args, objs, mem, s, o) proof
    fix args objs mem s o
    assume hA ho hmv hM hu hl hr he hob hvw hd
    have l := mp(all_elim(hw, {app(s, "vm")}), hl)
    show := mp(all_elim(expand(h, tr.implements_at), {args}, {objs}, {mem}, {s}, {o}), hA, ho, hmv, hM, hu, l, hr, he, hob, hvw, hd)
  qed
  show by defs(g, tr.implements_at)
qed

// tr.entry1_32s for a contract whose code lb/lc holds the function's own
// (base/code) -- a caller's, holding its callees' code too
theorem tr.entry1_32s_w(lb, lc, base, code, statics, f, k, len0, z0, a1, len, d, c, z1, z2, a2, x0. q, x3 x4 x2. kw): base in omega ->
  (all vm. abi.loaded(vm, lb, lc, statics) -> abi.code_at(vm, base, code)) ->
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = f ->
    runs(x86_64_linux.exec_body(len0, tag(60, pair(8, pair(5, pair(tag(0, 4), pair(z0, k)))))), m, o)) ->
  a1 = bits_add(64, f, len0) -> k in bits(8) -> int_lt(k, 128) -> int_le(k, 8) ->
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a1 ->
    runs(x86_64_linux.exec_body(len, tag(75, pair(4, pair(7, pair(x86i.rsp_mem(d), pair(z1, z2)))))), m, o)) ->
  a2 = bits_add(64, a1, len) -> d in bits(64) -> c = int_mod(int_sub(d, k), 18446744073709551616) -> c in bits(64) ->
  int_le(18446744073709551608, c) -> int_le(4, int_sub(18446744073709551616, c)) ->
  (all args v mem s. args in abi.ARGS -> v in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> ord_le(1, seq_len(args)) -> abi.view(s, v, mem) in univ(1) ->
    abi.loaded(app(s, "vm"), lb, lc, statics) -> abi.view(s, v, mem) in abi.World ->
    tr.pt(s, v, base, code, k, a2, fn_update(empty, c, pair(4, bits_of_int(32, app(args, 0)))), v, empty,
      mkprog(x1 x2. bind_rel(q(args), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), abi.view(s, v, mem))) ->
  (all args v mem s o. args in abi.ARGS -> v in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(app(s, "vm"), lb, lc, statics) -> app(s, "rip") = f ->
    abi.entry_ok(s, args) -> tr.objs_ok(s, v) -> abi.view_ok(s, v, mem) -> tr.run_d(s, s, o) ->
    tr.matches_t(fn_build(abi.ARGS, x0. mkprog(x1 x2. !ord_le(1, seq_len(x0)) || bind_rel(q(x0), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))), args, v, mem, s, o))
proof
  assume hbase hsub hat0 ha1 hk hkl hk8 hat ha2 hd hcd hcb hd1 hd2 hbody
  have hpro: all args v mem s. args in abi.ARGS -> v in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(app(s, "vm"), lb, lc, statics) -> app(s, "rip") = f ->
      abi.entry_ok(s, args) -> tr.objs_ok(s, v) -> abi.view_ok(s, v, mem) -> ord_le(1, seq_len(args)) ->
      tr.sim(s, v, mkprog(x1 x2. bind_rel(q(args), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), abi.view(s, v, mem), s) proof
    fix args v mem s
    assume hA hvo hmv hM su hl hrip he hob hvw hg
    let BIND := mkprog(x1 x2. bind_rel(q(args), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))
    have hc := mp(all_elim(hsub, {app(s, "vm")}), hl)
    have ent := apply(abi.entry_stack, hM, he)
    have hdf: !app(app(s, "flags"), "df") by taut(expand(he, abi.entry_ok))
    have ou := apply(abi.objs_univ, hvo)
    have mu := apply(x86.vm_univ, hmv)
    have hvu: abi.view(s, v, mem) in univ(1) by simp(su, ou, mu)
    have ap := apply(abi.arg_passed, {s}, {args}, hA, he, hg)
    have hx: bits_of_int(32, app(app(s, "gpr"), 7)) = bits_of_int(32, app(args, 0)) by simp(ap)
    have hWw := apply(abi.world_typed, hM, hvo, hmv, hvu)
    have body := mp(all_elim(hbody, {args}, {v}, {mem}, {s}), hA, hvo, hmv, hM, hg, hvu, hl, hWw)
    show := apply(tr.prologue_sub1_32, {s}, {v}, {mem}, {base}, {code}, {f}, {k}, {len0}, {z0}, {a1}, {len}, {d}, {c}, {z1}, {z2}, {a2}, {bits_of_int(32, app(args, 0))}, {BIND},
      hM, su, hvo, hob, hmv, hvw, hbase, hc, hrip, hdf, taut(ent), taut(ent), taut(ent), taut(ent), apply(abi.entry_gap, he), hat0, ha1, hk, hkl, hk8, hat, ha2, hd, hcd, hcb, hd1, hd2, hx, hvu, body)
  qed
  show := mp(tr.entry1g[base := lb, code := lc, statics := statics, f := f, q := x0. q(x0), kw := x3 x4 x2. kw(x3, x4, x2)], hpro)
qed

// (a 32-bit argument in rdi: its register value GIMPLE's)
theorem tr.arg32_reg: all rs x. 7 in dom(rs) -> app(rs, 7) = pair(4, x) ->
  (all m. tr.regs(m, rs) -> app(app(m, "gpr"), 7) in gimple.in_reg(fst(gimple.arg(32, x)), snd(gimple.arg(32, x))))
proof
  fix rs x
  assume hd hx
  fix m
  assume hr
  have rg := apply(tr.regs_get, {m}, {rs}, {7}, {4}, {x}, hr, hd, hx)
  have e: app(app(m, "gpr"), 7) = x by taut(rg)
  have xb: x in bits(int_mul(8, 4)) by taut(rg)
  show by defs(simp(e, xb), gimple.in_reg, gimple.arg)
qed

// (a function built on a number: a list of its values' set)
theorem tr.build_list(d, x. v, t): d in omega -> (all x. x in d -> v(x) in t) -> fn_build(d, x. v(x)) in list_type(t)
proof
  assume hd hv
  have sp := mp(fn_build_space[d := d, v := x. v(x), b := t], hv)
  have fd: fn_build(d, x. v(x)) in powerset(cart(d, t)) && is_fun(fn_build(d, x. v(x))) && dom(fn_build(d, x. v(x))) = d by simp(expand(sp, fn_space))
  have ss: subset(fn_build(d, x. v(x)), cart(d, t)) by taut(powerset_def[s := cart(d, t), a := fn_build(d, x. v(x))], fd)
  have g: all z. z in fn_build(d, x. v(x)) -> z in cart(omega, t) proof
    fix z
    assume hz
    have zc := mp(subset_elim[a := fn_build(d, x. v(x)), b := cart(d, t), z := z], ss, hz)
    obtain a, ha from mp(cart_elim[a := d, b := t, z := z], zc)
    obtain b, hb from ha
    have ao := mp(mp(nat_elem[k := d, i := a], hd), taut(hb))
    have c := mp(mp(cart_intro[a := omega, b := t, x := a, y := b], ao), taut(hb))
    have ze: z = pair(a, b) by taut(hb)
    show := rewrite(sym(ze), c)
  qed
  have so: subset(fn_build(d, x. v(x)), cart(omega, t)) by defs(g, subset)
  have pw: fn_build(d, x. v(x)) in powerset(cart(omega, t)) by taut(powerset_def[s := cart(omega, t), a := fn_build(d, x. v(x))], so)
  have dd: dom(fn_build(d, x. v(x))) in omega by simp(fd, hd)
  show by defs(simp(pw, fd, dd), list_type, seq_type, is_seq)
qed

// (code bytes: a list of the bytes it has, or of more)
theorem tr.bytes_list: all b t. (all i. i in bytes_len(b) -> bytes_at(b, i) in t) -> bytes_len(b) in omega -> bytes_seq(b) in list_type(t)
proof
  fix b t
  assume h hn
  have l := mp(mp(tr.build_list[d := bytes_len(b), v := i. bytes_at(b, i), t := t], hn), h)
  show by defs(l, bytes_seq)
qed

// two pieces of code loaded one after the other: the first at its place
theorem tr.loaded_before: all vm b1 b2 lb st. bytes_len(b1) in omega -> bytes_len(b2) in omega -> lb in omega ->
  abi.loaded(vm, lb, seq_concat(bytes_seq(b1), bytes_seq(b2)), st) -> abi.loaded(vm, lb, bytes_seq(b1), st)
proof
  fix vm b1 b2 lb st
  assume h1 h2 hl h
  let T := union2(set_image(bytes_len(b1), i. bytes_at(b1, i)), set_image(bytes_len(b2), i. bytes_at(b2, i)))
  have m1: all i. i in bytes_len(b1) -> bytes_at(b1, i) in T proof
    fix i
    assume hi
    have si := set_image_def[s := bytes_len(b1), f := j. bytes_at(b1, j), y := bytes_at(b1, i)]
    have ex: ex j. j in bytes_len(b1) && bytes_at(b1, j) = bytes_at(b1, i) by ex_intro({i}, taut(hi, refl({bytes_at(b1, i)})))
    have u := union2_iff[a := set_image(bytes_len(b1), j. bytes_at(b1, j)), b := set_image(bytes_len(b2), j. bytes_at(b2, j)), z := bytes_at(b1, i)]
    show by taut(si, ex, u)
  qed
  have m2: all i. i in bytes_len(b2) -> bytes_at(b2, i) in T proof
    fix i
    assume hi
    have si := set_image_def[s := bytes_len(b2), f := j. bytes_at(b2, j), y := bytes_at(b2, i)]
    have ex: ex j. j in bytes_len(b2) && bytes_at(b2, j) = bytes_at(b2, i) by ex_intro({i}, taut(hi, refl({bytes_at(b2, i)})))
    have u := union2_iff[a := set_image(bytes_len(b1), j. bytes_at(b1, j)), b := set_image(bytes_len(b2), j. bytes_at(b2, j)), z := bytes_at(b2, i)]
    show by taut(si, ex, u)
  qed
  have l1 := apply(tr.bytes_list, {b1}, {T}, m1, h1)
  have l2 := apply(tr.bytes_list, {b2}, {T}, m2, h2)
  have lc := apply(tr.loaded_concat, {vm}, {lb}, {bytes_seq(b1)}, {bytes_seq(b2)}, {T}, {st}, l1, l2, hl, h)
  show := lc.1
qed

// two pieces of code loaded one after the other: the second at its place
theorem tr.loaded_after: all vm b1 b2 lb st. bytes_len(b1) in omega -> bytes_len(b2) in omega -> lb in omega ->
  abi.loaded(vm, lb, seq_concat(bytes_seq(b1), bytes_seq(b2)), st) -> abi.loaded(vm, int_add(lb, bytes_len(b1)), bytes_seq(b2), st)
proof
  fix vm b1 b2 lb st
  assume h1 h2 hl h
  let T := union2(set_image(bytes_len(b1), i. bytes_at(b1, i)), set_image(bytes_len(b2), i. bytes_at(b2, i)))
  have m1: all i. i in bytes_len(b1) -> bytes_at(b1, i) in T proof
    fix i
    assume hi
    have si := set_image_def[s := bytes_len(b1), f := j. bytes_at(b1, j), y := bytes_at(b1, i)]
    have ex: ex j. j in bytes_len(b1) && bytes_at(b1, j) = bytes_at(b1, i) by ex_intro({i}, taut(hi, refl({bytes_at(b1, i)})))
    have u := union2_iff[a := set_image(bytes_len(b1), j. bytes_at(b1, j)), b := set_image(bytes_len(b2), j. bytes_at(b2, j)), z := bytes_at(b1, i)]
    show by taut(si, ex, u)
  qed
  have m2: all i. i in bytes_len(b2) -> bytes_at(b2, i) in T proof
    fix i
    assume hi
    have si := set_image_def[s := bytes_len(b2), f := j. bytes_at(b2, j), y := bytes_at(b2, i)]
    have ex: ex j. j in bytes_len(b2) && bytes_at(b2, j) = bytes_at(b2, i) by ex_intro({i}, taut(hi, refl({bytes_at(b2, i)})))
    have u := union2_iff[a := set_image(bytes_len(b1), j. bytes_at(b1, j)), b := set_image(bytes_len(b2), j. bytes_at(b2, j)), z := bytes_at(b2, i)]
    show by taut(si, ex, u)
  qed
  have l1 := apply(tr.bytes_list, {b1}, {T}, m1, h1)
  have l2 := apply(tr.bytes_list, {b2}, {T}, m2, h2)
  have lc := apply(tr.loaded_concat, {vm}, {lb}, {bytes_seq(b1)}, {bytes_seq(b2)}, {T}, {st}, l1, l2, hl, h)
  have fdm := fn_build_dom[d := bytes_len(b1), v := i. bytes_at(b1, i)]
  have sl: seq_len(bytes_seq(b1)) = bytes_len(b1) by defs(fdm, bytes_seq, seq_len)
  have r: abi.loaded(vm, int_add(lb, seq_len(bytes_seq(b1))), bytes_seq(b2), st) by taut(lc)
  show := rewrite(sl, r)
qed
