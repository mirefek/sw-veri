      show := mp(all_elim(xb, {bits_add(64, S, bits_of_int(64, j))}), simp(), (int_le(R, bits_add(64, S, bits_of_int(64, j))) by arith(rj, rs)), nd, sp1)
    qed
    have ls := apply(tr.le_same, {XV.bytes}, {m.vm.bytes}, {S}, {8}, simp(), bs)
    show := trans(ls, ra8)
  qed
  have xcs2 := apply(tr.cs_eq[m := m, x := x], (x.gpr[3] = m.gpr[3] && x.gpr[5] = m.gpr[5] && x.gpr[12] = m.gpr[12] && x.gpr[13] = m.gpr[13] &&
    x.gpr[14] = m.gpr[14] && x.gpr[15] = m.gpr[15] by simp(xcs, cgpr)))
  have xcpu2: x.cpu = s.cpu by simp(xcpu, cc0, mcpu)
  have xgs2: x.gs_base = s.gs_base by simp(xgs, cgs, mgs)
  have w4in: W4.os.input = s.os.input by simp(rinp, winp)
  have w4ev: subset(s.os.events, W4.os.events) proof
    have e2 := apply(tr.subset_trans, sws, rev)
    show by simp(e2)
  qed
  have w4cpu: W4.cpu = s.cpu by simp(rcpu, wcpu)
  // (W4: a world)
  have w4W w4u := apply(tr.back_world, w2W, w2u, wW, wu)
  have fro: fr in omega := expand(hcf, tr.cfr).1
  have {wbk} := expand(hi, tr.inv)
  have w4bk: abi.brk_start_ok(W4.vm) by defs(simp(rbk, expand(wbk, abi.brk_start_ok)), abi.brk_start_ok)
  have invx: tr.inv(s, base, code, fr, x, W4) by defs(simp(xM, xu, cdx, kcx, x4, fro, kpx, rax, xcpu2, xgs2,
    (x.os = W4.os by simp(xos)), (x.fs_base = W4.fs_base by simp(xfs, cf, mfs)), (x.fs_base = s.fs_base by simp(xfs, cfs0)), xdf, w4in, w4ev, w4W, w4u, w4cpu, w4bk, sM, sacc, sal, hsps, slt, sgf, srsv, scan, keep(abi.code_at, tr.keeps_code, tr.kept, x86_64_linux.Machine, abi.World, abi.stack_page, abi.stack_gap_free, abi.stack_reserve, x86_64_linux.can_access, abi.brk_start_ok)), tr.inv)
  // the coupling
  have {oacc} := hmm
  have mframes: all x0. x0 in bits(64) -> (int_le(abi.sp(s), x0) && !abi.in_domain(w.vm, abi.wob(ds, w.objs.c_bytes), x0)) && abi.stack_page(s.vm, x86_64_linux.page_of(x0)) ->
      m.vm.bytes[x0] = s.vm.bytes[x0] := expand(wm, abi.world_matches).frames
  have by4: all a. a in bits(64) -> abi.in_domain(W4.vm, abi.wob(ds, W4.objs.c_bytes), a) -> XV.bytes[a] = W4.vm.bytes[a] proof
    fix a
