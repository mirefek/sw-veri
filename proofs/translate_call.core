  qed
  have fr4: all a. a in bits(64) -> (int_le(abi.sp(s), a) && !abi.in_domain(W4.vm, abi.wob(ds, W4.objs.c_bytes), a)) && abi.stack_page(s.vm, x86_64_linux.page_of(a)) ->
      XV.bytes[a] = s.vm.bytes[a] proof
    fix a
    assume ha hf
    have ao: a in omega by simp(ha)
    have pe: x86_64_linux.page_of(a) = int_div(a, 4096) by defs(simp(), x86_64_linux.page_of, x86_64_linux.PAGE)
    have hn: !abi.in_domain(W4.vm, abi.wob(ds, W4.objs.c_bytes), a) by taut(hf)
    have nd0: !(a in abi.wob(ds, W4.objs.c_bytes).live) by taut(expand(hn, abi.in_domain))
    have nd: !(a in ds) by simp(nd0)
    have sp0: abi.stack_page(s.vm, x86_64_linux.page_of(a)) by taut(hf)
    have sp1: abi.stack_page(s.vm, int_div(a, 4096)) := rewrite(pe, sp0)
    have la: int_le(abi.sp(s), a) by taut(hf)
    have po: int_div(a, 4096) in omega by simp(ha)
    have pl: int_le(P0, int_div(a, 4096)) by arith(la, sp8, sal, sb, slt, ao)
    have k2 := apply(tr.inv_stack, {s}, {base}, {code}, {fr}, {m}, {w}, {ds}, {int_div(a, 4096)}, hi, hmm, po, sp1, pl)
    have spm: abi.stack_page(m.vm, int_div(a, 4096)) by defs(simp(k2, expand(sp1, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
    have l1: int_le(R, a) by arith(la, sp8, rs, so, ao)
    have xm := mp(all_elim(xb, {a}), ha, l1, nd, spm)
    // (m's: s's -- the world has no page there)
    have mwn: w.vm.pages[int_div(a, 4096)] = none proof
      have sm := expand(sp1, abi.stack_page, x86_64_linux.mapped)
      have qp: int_div(a, 4096) in gc.PN by simp(po, sm)
      have c := mp(all_elim(mpages, {int_div(a, 4096)}), qp)
      have d: !(w.vm.pages[int_div(a, 4096)] = none) -> false proof
        assume hn2
        have e2: m.vm.pages[int_div(a, 4096)] = w.vm.pages[int_div(a, 4096)] by taut(c, hn2)
        have k := mp(all_elim(mnostk, {int_div(a, 4096)}), qp, hn2)
        have k3: snd(m.vm.pages[int_div(a, 4096)]).kind = 2 by simp(k2, sm)
        have k4 := rewrite(e2, k3)
        show by taut(k4, k)
      qed
      show by taut(d)
    qed
    have ndw: !abi.in_domain(w.vm, abi.wob(ds, w.objs.c_bytes), a) by defs(simp(nd, mwn, lv, keep(abi.objs_at)), abi.in_domain, x86_64_linux.mapped, x86_64_linux.PAGE)
    have pre: (int_le(abi.sp(s), a) && !abi.in_domain(w.vm, abi.wob(ds, w.objs.c_bytes), a)) && abi.stack_page(s.vm, x86_64_linux.page_of(a)) by taut(hf, ndw)
    have ms := mp(all_elim(mframes, {a}), ha, pre)
    show := trans(xm, ms)
  qed
  have stk4: all x0. x0 in omega -> abi.stack_page(s.vm, x0) && int_le(int_div(int_sub(abi.sp(s), 8), x86_64_linux.PAGE), x0) -> XV.pages[x0] = s.vm.pages[x0] proof
    fix x0
    assume h0 h1
    have pl: int_le(P0, x0) by defs(arith(expand(h1, x86_64_linux.PAGE), sp8, sb, slt, h0), x86_64_linux.PAGE)
    show := mp(all_elim(pst, {x0}), h0, h1.1, pl).2
  qed
  have rsv4: abi.stack_reserve(s.vm) -> abi.stack_reserve(XV) proof
    assume h0
    show := mp(rsv, mp(expand(cstk, x86.stk_ext).2, mp(mrsv, h0)))
  qed
  have hid4: all a. a in bits(64) -> a in abi.canary(s.fs_base) ->
      XV.bytes[a] = s.vm.bytes[a] && XV.pages[x86_64_linux.page_of(a)] = s.vm.pages[x86_64_linux.page_of(a)] proof
    fix a
    assume ha hh
    have c := mp(all_elim(hwx, {a}), ha, hh)
    show := conj(c.1, c.2)
  qed
  have wm4: abi.world_matches(s.vm, XV, W4.vm, abi.wob(ds, W4.objs.c_bytes), s.fs_base, abi.sp(s)) by defs(simp(top, limit, brk0, brk, by4, fr4, hid4, own, pages, nostk, stk4, rsv4, keep(abi.in_domain, abi.stack_page, abi.stack_reserve, abi.objs_at, abi.canary)), abi.world_matches)
  have oa4: all y. y in omega -> y in ds -> ((int_le(abi.sp(s), y) && abi.stack_page(s.vm, int_div(y, x86_64_linux.PAGE))) || tr.own(s, x, y)) &&
      x86_64_linux.can_access(XV, bits_of_int(64, y), 1) proof
    fix y
    assume h1 h2
    have o ca := mp(all_elim(oacc, {y}), h1, h2)
    have po: int_div(y, x86_64_linux.PAGE) in omega by defs(simp(h1), x86_64_linux.PAGE)
    have pe: x86_64_linux.page_of(y) = int_div(y, x86_64_linux.PAGE) by defs(simp(), x86_64_linux.page_of)
    // (its page x's as m's: then accessible as at m)
    have acc: XV.pages[x86_64_linux.page_of(y)] = m.vm.pages[x86_64_linux.page_of(y)] -> int_lt(y, 18446744073709551616) ->
        x86_64_linux.can_access(XV, bits_of_int(64, y), 1) proof
      assume eqp yl
      have yb: bits_of_int(64, y) = y by simp(h1, yl)
      have ca2 := rewrite(yb, ca)
      have cc := apply(tr.access_page, {XV}, {m.vm}, {y}, {y}, {1}, refl({x86_64_linux.page_of(y)}), eqp)
      have cx2: x86_64_linux.can_access(XV, y, 1) by taut(cc, ca2)
      show := rewrite(sym(yb), cx2)
    qed
    // a caller's: on the entry's stack pages from sp up, x's as s's
    have c1: int_le(abi.sp(s), y) && abi.stack_page(s.vm, int_div(y, x86_64_linux.PAGE)) -> x86_64_linux.can_access(XV, bits_of_int(64, y), 1) proof
      assume h
      have sa sp1 := h
      have sm := expand(sp1, abi.stack_page, x86_64_linux.mapped)
      have yl: int_lt(y, 18446744073709551616) by simp(h1, expand(sm, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))
      have pl: int_le(P0, int_div(y, x86_64_linux.PAGE)) by defs(arith(sa, sp8, sb, slt, h1), x86_64_linux.PAGE)
      have k2 := apply(tr.inv_stack, {s}, {base}, {code}, {fr}, {m}, {w}, {ds}, {int_div(y, x86_64_linux.PAGE)}, hi, hmm, po, sp1, pl)
      have xp := mp(all_elim(pst, {int_div(y, x86_64_linux.PAGE)}), po, sp1, pl).2
      have eqp: XV.pages[x86_64_linux.page_of(y)] = m.vm.pages[x86_64_linux.page_of(y)] by simp(pe, xp, k2)
      show := mp(acc, eqp, yl)
    qed
    // an own one: at or above rsp, on a stack page of m -- C's, x's
    have c2: tr.own(s, m, y) -> tr.own(s, x, y) && x86_64_linux.can_access(XV, bits_of_int(64, y), 1) proof
      assume h
      have yl0 hsp := h
      have ya0 := mp(all_elim(hob, {y}), h1, h2, yl0)
      have ya: int_le(R, y) by arith(ya0, er4)
      have sm := expand(hsp, abi.stack_page, x86_64_linux.mapped)
      have yl: int_lt(y, 18446744073709551616) by simp(h1, expand(sm, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))
      have e1 := mp(all_elim(mc, {int_div(y, x86_64_linux.PAGE)}), po, hsp)
      have hspc: abi.stack_page(C.vm, int_div(y, x86_64_linux.PAGE)) by defs(simp(e1, sm), abi.stack_page, x86_64_linux.mapped)
      have lp: int_le(L, int_div(y, x86_64_linux.PAGE)) by defs(arith(ya, rb, h1), x86_64_linux.PAGE)
      have e2 := mp(all_elim(cx, {int_div(y, x86_64_linux.PAGE)}), po, hspc, lp)
      have eq: XV.pages[int_div(y, x86_64_linux.PAGE)] = m.vm.pages[int_div(y, x86_64_linux.PAGE)] := trans(e2, e1)
      have eqp: XV.pages[x86_64_linux.page_of(y)] = m.vm.pages[x86_64_linux.page_of(y)] := rewrite(sym(pe), eq)
      have hsx: abi.stack_page(XV, int_div(y, x86_64_linux.PAGE)) by defs(simp(eq, sm), abi.stack_page, x86_64_linux.mapped)
      show by taut(yl0, hsx, mp(acc, eqp, yl))
    qed
    show by taut(o, c1, c2)
  qed
  // (W4's bytes: the caller's objects, the callee's own bytes)
  have wl: w.objs.live = ds by simp(apply(tr.mem_objs, hmm).2, lv)
  have wob4: W4.objs = abi.wob(ds, W4.objs.c_bytes) by simp(wl, apply(abi.objs_eta, {w2.objs}, {ds}, (w2.objs in abi.Objs by simp(expand(w2W, abi.World)))))
  have {cok} := hmm
  have mem4: tr.mem(s, x, W4, ds) by defs(taut(wob4, wm4, oa4, hlv, cok), tr.mem)
  // rax:rdx, the return address
  have r0R: 0 in x86_64_linux.Reg by simp()
  have r2R: 2 in x86_64_linux.Reg by simp()
  have r0 := mp(mp(all_elim(x86i.reg_typed, {x}, {0}), xM), r0R)
  have r2 := mp(mp(all_elim(x86i.reg_typed, {x}, {2}), xM), r2R)
  have re0 := apply(tr.regs_cs_keep, hrs, hsub, xcs2)
  have rs1 := apply(tr.regs_set, {x}, {rc}, {0}, {8}, {x.gpr[0]}, re0, simp(r0))
  have _ xg .. := apply(x86i.parts, xM)
  have gfd: is_fun(x.gpr) && dom(x.gpr) = x86_64_linux.Reg by simp(expand(xg, fn_space))
  have xfd: is_fun(x) && "gpr" in dom(x) by simp(expand(xM, x86_64_linux.Machine))
  have g0 := mp(mp(fn_update_same[f := x.gpr, k := 0], gfd.1), simp(gfd))
  have x0 := mp(mp(fn_update_same[f := x, k := "gpr"], xfd.1), xfd.2)
  have rs2 := rewrite(x0, rewrite(g0, rs1))
  have rs3 := apply(tr.regs_set, {x}, {fn_update(rc, 0, pair(8, x.gpr[0]))}, {2}, {8}, {x.gpr[2]}, rs2, simp(r2))
  have g2 := mp(mp(fn_update_same[f := x.gpr, k := 2], gfd.1), simp(gfd))
  have rs4 := rewrite(x0, rewrite(g2, rs3))
  have rip: x.rip = RA by simp(xrip, cgpr, cle, rb, r16)
  show by taut(invx, mem4, homx, frx, rs4, rip)
qed

// The callee (on the caller's world) crashing as the ABI allows: the
// caller crashing as it allows
theorem tr.callee_crash(g, args, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all s base code fr m w ds regs C o. tr.inv(s, base, code, fr, m, w) -> tr.cfr(fr) -> tr.mem(s, m, w, ds) ->
  C.os = m.os -> C.gpr[4] = int_sub(m.gpr[4], 8) ->
  gc.regs_ok(regs, args) -> gc.sound(w) ->
  g in fn_space(abi.ARGS, powerset(univ(1))) -> regs in abi.ARGS -> abi.view(C, ds, w.vm) = w ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) -> (all t. t in univ(1) -> runs(mkprog(x0 x1. ex x8. dd(t, x8) && k(x8, x1)), w, diverge(t))) ->
  tr.crashes_t(g, regs, ds, w.vm, C, o) ->
  tr.crash(s, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, o)
proof
  fix s base code fr m w ds regs C o
  assume hi hcf hmm co c4 rg hs hgt hA veq hk hd hc
  let S := s.gpr[4]
  let P := mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))
  have {wW, wu, mos, winp, sws} := apply(tr.inv_call, hi)
  have {rb, r16, rlt, rs, sb, slt} := apply(tr.call_rsp, hi, hcf)
  have spc: abi.sp(C) = m.gpr[4] by simp(c4, rb, r16, rlt)
  have sp8: abi.sp(s) = int_add(S, 8) by simp(sb, slt)
  obtain m1 a0 k0, {oe, m1M, ab, sev, ovk} from expand(hc, tr.crashes_t)
  // the fault: below the caller's sp too
  have oe2: (o = exc(m1, exc_val("segv", pair(a0, k0))) && (k0 = 0 || k0 = 1 || k0 = 3) && abi.overflow_at(m1.vm, m1.gpr[4], abi.sp(s), a0)) ||
      o = exc(m1, exc_val("stack_fault", empty)) proof
    have c1: (o = exc(m1, exc_val("segv", pair(a0, k0))) && (k0 = 0 || k0 = 1 || k0 = 3) && abi.overflow_at(m1.vm, m1.gpr[4], abi.sp(C), a0)) ->
        (o = exc(m1, exc_val("segv", pair(a0, k0))) && (k0 = 0 || k0 = 1 || k0 = 3) && abi.overflow_at(m1.vm, m1.gpr[4], abi.sp(s), a0)) proof
      assume h
      have lt al := expand(rewrite(spc, h.3), abi.overflow_at)
      have lt2: int_lt(a0, abi.sp(s)) by arith(lt, sp8, rs)
      have ov: abi.overflow_at(m1.vm, m1.gpr[4], abi.sp(s), a0) by defs(taut(al, lt2), abi.overflow_at)
      show by taut(h, ov)
    qed
    show by taut(oe, c1)
  qed
  // the I/O so far: the input as at the entry, the events grown since
  have sev2 := rewrite(trans(co, mos), sev)
  have sub := apply(tr.subset_trans, {s.os.events}, {w.os.events}, {m1.os.events}, sws, sev2)
  have inp0 ex0 := expand(ovk, tr.overflow_t)
  have inp1: C.os.input = m1.os.input by simp(inp0)
  have inp2 := rewrite(trans(co, mos), inp1)
  have inp := trans(sym(winp), inp2)
  // (the callee overflowed right at its call: GIMPLE's call overflows first)
  have oc: abi.view(C, ds, w.vm).os.events = m1.os.events -> tr.ovf(P, w, m1.os) proof
    assume e
    have ev: w.os.events = m1.os.events by simp(e, co, mos)
    show := apply(tr.call_ovf[g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {m1.os}, wW, wu, ev, mp(all_elim(hk, {w}, {exc_val("stack_overflow", empty)}), wu, defs(simp(), exc_val)))
  qed
  // (the spec's point where the I/O stops: the caller's rest stops there too)
  have ox: tr.ovf(g[regs], abi.view(C, ds, w.vm), m1.os) -> tr.ovf(P, w, m1.os) proof
    assume ex1
    // the callee overflowed: so does the caller
    have c2: (ex x. x in rec_and(abi.World, single(empty)) && runs(g[regs], abi.view(C, ds, w.vm), exc(x, exc_val("stack_overflow", empty))) &&
        x.os.events = m1.os.events) -> tr.ovf(P, w, m1.os) proof
      assume e
      obtain xw, xa xr ev from e
      have hg2 := rewrite(veq, xr)
      have pu := apply(tr.spec_univ, {g}, {regs}, {w}, {exc(xw, exc_val("stack_overflow", empty))}, hgt, hA, hg2)
      have xu: xw in univ(1) by simp(pu)
      have ebu: exc_val("stack_overflow", empty) in univ(1) by defs(simp(), exc_val)
      have pe := apply(tr.gcall_exc[g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {regs}, {xw}, {exc_val("stack_overflow", empty)}, wu, xu, ebu, rg, hs, hg2, hk)
      show := apply(tr.ovf_exc, {P}, {w}, {m1.os}, {xw}, xa, pe, ev)
    qed
    // the callee ran on: so does the caller
    have c3: (ex t. runs(g[regs], abi.view(C, ds, w.vm), diverge(t))) -> tr.ovf(P, w, m1.os) proof
      assume e
      obtain t, xr from e
      have hg2 := rewrite(veq, xr)
      have pu := apply(tr.spec_univ, {g}, {regs}, {w}, {diverge(t)}, hgt, hA, hg2)
      have tu: t in univ(1) by simp(pu)
      have pd := apply(tr.gcall_div[g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {regs}, {t}, wu, tu, rg, hs, hg2, hd)
      show := apply(tr.ovf_div, {P}, {w}, {m1.os}, {t}, pd)
    qed
    show by taut(expand(ex1, tr.ovf), c2, c3)
  qed
  have ovf: tr.ovf(P, w, m1.os) by taut(ex0, oc, ox)
  show by defs(ex_intro({m1}, {a0}, {k0}, taut(oe2, m1M, ab, sub, inp, ovf)), tr.crash)
qed

// ----------------------------------------------------------------------
//  The callee runs: from its entry state C, the caller's claim

theorem tr.callee_sim(g, args, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw, zb. bkp, zb pb wb. bka): all s v base code fr m w n hs fd RA T m1 e1 C cb cc st rs rc. tr.hap(s, hs, v) -> tr.ofr(s, fr, v) -> 
  tr.inv(s, base, code, fr, m, w) -> tr.cfr(fr) -> tr.mem(s, m, w, v) -> base in omega -> tr.regs(m, rs) -> tr.cs_sub(rc, rs) ->
  tr.args_in(m, args) -> seq_len(args) = n -> n in omega -> int_le(n, 6) -> RA in bits(64) -> T in bits(64) ->
  runs(x86_64_linux.touch_range(bits_sub(64, m.gpr[4], 8), 8, 1), fn_update(m, "rip", RA), ok(m1, e1)) ->
  C = fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, bits_sub(64, m.gpr[4], 8), 8, RA))),
    "gpr", fn_update(m1.gpr, 4, bits_sub(64, m.gpr[4], 8))), "rip", T) ->
  tr.callee_contract(fr, T, g, cb, cc, st) -> (int_mod(fr, 16) = 8 -> tr.sal16(s)) -> abi.loaded(s.vm, cb, cc, st) -> cb in omega ->
  tr.homes(s, m, hs) -> tr.hin(hs, fr) -> fd in omega -> int_le(fd, int_add(fr, 8)) ->
  g in fn_space(abi.ARGS, powerset(univ(1))) -> tr.callee_io(g, n) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) -> (all t. t in univ(1) -> runs(mkprog(x0 x1. ex x8. dd(t, x8) && k(x8, x1)), w, diverge(t))) ->
  (all w4 r0 r1. w4 in abi.World && w4 in univ(1) -> r0 in bits(64) -> r1 in bits(64) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, RA, hs, fd, fn_update(fn_update(rc, 0, pair(8, r0)), 2, pair(8, r1)),
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. a(x0, pair(r0, r1), x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w4)) ->
  (all z. int_lt(z.gpr[4], m.gpr[4]) -> !bkp(z)) ->
  tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, C)
proof
  fix s v base code fr m w n hs fd RA T m1 e1 C cb cc st rs rc
  assume hap hofr hi hcf hmm hb hrs hsub hargs hln hno hn6 hra ht htr hC himp hal hld hcb hhs hhin hfo hfd hgt hio hk hd hpost hbx
  let S := s.gpr[4]
  let W1 := w
  let P := mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))
  let R := m.gpr[4]
  let regs := tr.aregs(m, n)
  have {sM, mM, wW, wu} := apply(tr.inv_call, hi)
  have {kc} := hi
  have {rb, r16, rlt, rss = rs, sb, slt} := apply(tr.call_rsp, hi, hcf)
  have cM cu co cf cc0 cgs cfl cgpr crip ckc cvf cle cpi cby cstk cacc := apply(tr.push_ok, {s}, {base}, {code}, {fr}, {m}, {w}, {RA}, {T}, {m1}, {e1}, {C}, hi, hcf, hra, ht, htr, hC)
  have cv: C.vm in x86_64_linux.Vm := apply(x86i.parts, cM).4
  have c4: C.gpr[4] = int_sub(R, 8) by simp(cgpr)
  have spc: abi.sp(C) = R by simp(c4, rb, r16, rlt)
  have sp8: abi.sp(s) = int_add(S, 8) by simp(sb, slt)
  have rg1 rg2 rg3 hA _ rlen _ := apply(tr.aregs_ok, {m}, {args}, {n}, mM, hln, hno, hn6, hargs)
  have rg: gc.regs_ok(regs, args) := conj(rg1, rg2, rg3)
  // (C: no stop of the caller's -- below its rsp)
  have nrC: int_lt(C.gpr[4], abi.sp(s)) by arith(c4, sp8, rss, rb, r16)
  have ltC: int_lt(C.gpr[4], m.gpr[4]) by arith(c4, r16)
  have nbC := mp(all_elim(hbx, {C}), ltC)
  // GIMPLE's checks failing at the world grown: undefined
  have bad: !gc.sound(W1) -> tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, P, w, C) proof
    assume hn
    have all: all x e. x in univ(1) -> e in univ(1) -> runs(gimple.call(g, args), w, exc(x, e)) proof
      fix x e
      assume hx he
      show := apply(gc.call_ub, {g}, {args}, {w}, {regs}, {x}, {e}, wu, hx, he, rg, hn)
    qed
    have ub := apply(tr.gcall_ub[g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {s}, {v}, {w}, wW, wu, all, hk)
    have su := apply(tr.sim_ub[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {P}, {w}, {C}, ub)
    show := apply(tr.sim_cl[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {P}, {w}, {C}, nrC, nbC, su)
  qed
  // ... holding: the callee's entry, its contract
  have good: gc.sound(W1) -> tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, P, w, C) proof
    assume hs
    have eoku eok vok ook veq wvv dso := apply(tr.callee_ready, {s}, {base}, {code}, {fr}, {m}, {w}, {v}, {RA}, {T}, {m1}, {e1}, {C}, {n}, hofr, hi, hcf, hmm, hra, ht, hno, hn6, htr, hC, hs)
    have l1 := mp(all_elim(expand(kc, tr.keeps_code), {cb}, {cc}, {st}), hcb, hld)
    have lC := mp(all_elim(expand(ckc, tr.keeps_code), {cb}, {cc}, {st}), hcb, l1)
    let WV := W1.vm
    have ctr: all oc. tr.run_d(C, C, oc) -> tr.matches_t(g, regs, v, WV, C, oc) proof
      fix oc
      assume hrd
      have a8: (int_mod(fr, 16) = 8 && tr.implements_at(T, g, cb, cc, st)) -> tr.matches_t(g, regs, v, WV, C, oc) proof
        assume h8
        show := mp(all_elim(expand(h8.2, tr.implements_at), {regs}, {v}, {WV}, {C}, {oc}), hA, dso, wvv, cM, cu, lC, crip, mp(eok, h8.1, mp(hal, h8.1)), ook, vok, hrd)
      qed
      have au: tr.implements_at_u(T, g, cb, cc, st) -> tr.matches_t(g, regs, v, WV, C, oc) proof
        assume hu0
        show := mp(all_elim(expand(hu0, tr.implements_at_u), {regs}, {v}, {WV}, {C}, {oc}), hA, dso, wvv, cM, cu, lC, crip, eoku, ook, vok, hrd)
      qed
      show by taut(expand(himp, tr.callee_contract), a8, au)
    qed
    // (W1: a world)
    have ou := apply(abi.objs_univ, dso)
    have wvu := apply(x86.vm_univ, wvv)
    have ocu := mp(all_elim(abi.objs_at_univ, {v}, {C.fs_base}), ou)
    have vu: abi.view(C, v, WV) in univ(1) by simp(cu, ou, wvu, ocu)
    have vW := apply(abi.world_typed, cM, dso, wvv, vu)
    have w1W: W1 in abi.World := rewrite(veq, vW)
    have w1u: W1 in univ(1) := wu
    // the callee raising: the caller undefined
    have rub: abi.raises_at(g, regs, v, WV, C) -> tr.ub(s, v, P, w) proof
      assume hr
      obtain e x, eu eno ena rst rr from expand(hr, abi.raises_at)
      have rr2 := rewrite(veq, rr)
      have pu := apply(tr.spec_univ, {g}, {regs}, {W1}, {exc(x, e)}, hgt, hA, rr2)
      have xu: x in univ(1) by simp(pu)
      have pe := apply(tr.gcall_exc[g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {regs}, {x}, {e}, wu, xu, eu, rg, hs, rr2, hk)
      show by defs(ex_intro({e}, {x}, taut(eu, eno, ena, rst, pe)), tr.ub)
    qed
    // the callee returned to x: the caller's claim reaching x (or the call
    // undefined)
    have rcl: all x. tr.run_d(C, C, ok(x, empty)) -> tr.ub(s, v, P, w) || tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, P, w, x) proof
      fix x
      assume hrx
      have mt2 := expand(mp(all_elim(ctr, {ok(x, empty)}), hrx), tr.matches_t)
      have n2: tr.crashes_t(g, regs, v, WV, C, ok(x, empty)) -> false proof
        assume ca
        obtain m2 a0 k0, {oe} from expand(ca, tr.crashes_t)
        show by simp(oe)
      qed
      have u1: abi.raises_at(g, regs, v, WV, C) -> tr.ub(s, v, P, w) || tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, P, w, x) proof
        assume ra
        have ub := mp(rub, ra)
        show by taut(ub)
      qed
      have u2: (ex m1 w2. ok(x, empty) = ok(m1, empty) && m1 in x86_64_linux.Machine && m1 in univ(1) &&
          runs(g[regs], abi.view(C, v, WV), ok(w2, pair(m1.gpr[0], m1.gpr[2]))) && w2 in abi.World && w2 in univ(1) &&
          abi.world_matches(C.vm, m1.vm, w2.vm, abi.wob(v, w2.objs.c_bytes), C.fs_base, abi.sp(C)) && m1.os = w2.os && m1.fs_base = C.fs_base &&
          m1.cpu = C.cpu && m1.gs_base = C.gs_base && m1.rip = abi.ret(C) && m1.gpr[4] = abi.sp(C) &&
          abi.callee_saved(m1, C) && !m1.flags.df) -> tr.ub(s, v, P, w) || tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, P, w, x) proof
        assume eo
        obtain m2 w2, eo2 from eo
        have xm: x = m2 by simp(eo2.1)
        let r0 := x.gpr[0]
        let r1 := x.gpr[2]
        have _ xM xu hg0 w2W w2u wm0 xos xfs xcpu xgs xrip0 xr4 xcs xdf := rewrite(sym(xm), eo2)
        have hg8 := rewrite(veq, hg0)
        have r0R: 0 in x86_64_linux.Reg by simp()
        have r2R: 2 in x86_64_linux.Reg by simp()
        have r0b := mp(mp(all_elim(x86i.reg_typed, {x}, {0}), xM), r0R)
        have r1b := mp(mp(all_elim(x86i.reg_typed, {x}, {2}), xM), r2R)
        have r0u: r0 in univ(1) by simp(r0b)
        have r1u: r1 in univ(1) by simp(r1b)
        // the callee's spec: a valid world on its return, or undefined there (so is this call)
        have ci := mp(all_elim(expand(hio, tr.callee_io), {regs}, {W1}, {w2}, {pair(r0, r1)}),
          (ord_le(n, seq_len(regs)) by defs(simp(rlen), ord_le)), hg8)
        have mr: tr.may_raise(g, regs, W1) -> tr.ub(s, v, P, w) || tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, P, w, x) proof
          assume hm
          have eu: empty in univ(1) by simp()
          have hx: all x e. x in univ(1) -> e in univ(1) -> runs(g[regs], W1, exc(x, e)) by taut(expand(expand(hm, tr.may_raise), tr.undef))
          have pe := mp(all_elim(hx, {W1}, {empty}), w1u, eu)
          have eno := tr.undef_empty
          have rst: abi.raise_state(W1) by defs(apply(tr.world_and, w1W), abi.raise_state)
          have pe2 := subst({y. runs(g[regs], y, exc(W1, empty))}, sym(veq), pe)
          have ra: abi.raises_at(g, regs, v, WV, C) by defs(ex_intro({empty}, {W1}, taut(eu, eno, rst, pe2)), abi.raises_at)
          show := mp(u1, ra)
        qed
        // the caller goes on at the return address with the result
        have fk: tr.returns_valid(W1, w2) -> tr.ub(s, v, P, w) || tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, P, w, x) proof
          assume rv
          have xv: x.vm in x86_64_linux.Vm := apply(x86i.parts, xM).4
          have pinv pmem phom pfr preg prip := apply(tr.post_call, {s}, {base}, {code}, {fr}, {m}, {w}, {v}, {RA}, {T}, {m1}, {e1}, {C}, {x}, {w2}, {hs}, {fd}, {rs}, {rc},
            hi, hcf, hmm, hb, hra, ht, htr, hC, rv, xM, xu, w2W, w2u, wm0, xos, xfs, xcpu, xgs, xrip0, xr4, xcs, xdf, hhs, hap, hofr, hhin, hfo, hfd, hrs, hsub)
          let W4 := gc.back(w2, W1)
          have _ pk := apply(tr.gcall_ret[g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {regs}, {w2}, {r0}, {r1}, wu, w2u, r0u, r1u, rg, hs, hg8, hk)
          have red: tr.red(P, w, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. a(x0, pair(r0, r1), x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), W4) by defs(pk, tr.red)
          have {w4W = wW, w4u = wu} := pinv
          have ptk := mp(all_elim(hpost, {W4}, {r0}, {r1}), taut(w4W, w4u), r0b, r1b)
          have sm := mp(all_elim(expand(ptk, tr.pt), {x}), pinv, prip, phom, preg, pmem, pfr)
          have sm2 := apply(tr.cl_red[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {P}, {w}, {mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. a(x0, pair(r0, r1), x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))}, {W4}, {x}, red, sm)
          show by taut(sm2)
        qed
        show by taut(fk, ci, mr)
      qed
      have n3 := all_elim(tr.div_ok, {g[regs]}, {abi.view(C, v, WV)}, {x}, {empty})
      show by taut(mt2, n2, n3, u1, u2)
    qed
    // the caller's run from C
    have spl: int_le(abi.sp(C), abi.sp(s)) by arith(spc, sp8, rss)
    have cl0: int_lt(C.gpr[4], abi.sp(C)) by arith(c4, spc, r16)
    have hbc: all z. int_lt(z.gpr[4], abi.sp(C)) -> !bkp(z) proof
      fix z
      assume lt
      show := mp(all_elim(hbx, {z}), rewrite(spc, lt))
    qed
    have g0: all o. tr.run_k(s, zb. bkp(zb), C, o) -> tr.gk(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, P, w, o) proof
      fix o
      assume hr
      let GK(o2) := tr.gk(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, P, w, o2)
      have rs := apply(tr.run_split_k[bkp := zb. bkp(zb)], {s}, {C}, {o}, sM, spl, cl0, hbc, hr)
      have ub2: tr.ub(s, v, P, w) -> GK(o) proof
        assume u
        show by defs(taut(u), tr.gk)
      qed
      // (a return reached at x: the caller's run stops there, or goes on)
      have atx: all x. tr.run_d(C, C, ok(x, empty)) -> o = ok(x, empty) -> GK(o) proof
        fix x
        assume hrx oe
        have c := mp(all_elim(rcl, {x}), hrx)
        have k2: tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, P, w, x) -> GK(o) proof
          assume hc
          have st := apply(tr.run_k_stop[bkp := zb. bkp(zb)], {s}, {C}, {x}, {empty}, rewrite(oe, hr))
          have ar := mp(expand(hc, tr.cl).1, st)
          have e2: ex m3. o = ok(m3, empty) && tr.arr(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, m3, P, w) by ex_intro({x}, taut(oe, ar))
          show by defs(taut(e2), tr.gk)
        qed
        show by taut(c, ub2, k2)
      qed
      // (1) the caller's run is the callee's
      have b1: (ex o1. tr.run_d(C, C, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2))) -> GK(o) proof
        assume e
        obtain o1, hrc eo from e
        have mt2 := expand(mp(all_elim(ctr, {o1}), hrc), tr.matches_t)
        have u1: abi.raises_at(g, regs, v, WV, C) -> GK(o) proof
          assume ra
          show := mp(ub2, mp(rub, ra))
        qed
        have u2: tr.crashes_t(g, regs, v, WV, C, o1) -> GK(o) proof
          assume ca
          have cr := apply(tr.callee_crash[g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {s}, {base}, {code}, {fr}, {m}, {w}, {v}, {regs}, {C}, {o1}, hi, hcf, hmm, co, c4, rg, hs, hgt, hA, veq, hk, hd, ca)
          obtain m2 a0 k0, {oe} from expand(cr, tr.crash)
          have nd: !(fst(o1) = 2) by simp(oe)
          have oe1: o1 = o by taut(eo, nd)
          have cr2 := rewrite(oe1, cr)
          show by defs(taut(cr2), tr.gk)
        qed
        have u3: (ex m1 w2. o1 = ok(m1, empty) && m1 in x86_64_linux.Machine && m1 in univ(1) &&
            runs(g[regs], abi.view(C, v, WV), ok(w2, pair(m1.gpr[0], m1.gpr[2]))) && w2 in abi.World && w2 in univ(1) &&
            abi.world_matches(C.vm, m1.vm, w2.vm, abi.wob(v, w2.objs.c_bytes), C.fs_base, abi.sp(C)) && m1.os = w2.os && m1.fs_base = C.fs_base &&
            m1.cpu = C.cpu && m1.gs_base = C.gs_base && m1.rip = abi.ret(C) && m1.gpr[4] = abi.sp(C) &&
            abi.callee_saved(m1, C) && !m1.flags.df) -> GK(o) proof
          assume eo2
          obtain m2 w2, eo3 from eo2
          have nd: !(fst(o1) = 2) by simp(eo3.1)
          have oe1: o1 = o by taut(eo, nd)
          have oe: o = ok(m2, empty) := trans(sym(oe1), eo3.1)
          have hrx := rewrite(eo3.1, hrc)
          show := mp(all_elim(atx, {m2}), hrx, oe)
        qed
        // (the callee diverging: so does the caller's spec)
        have u4: tr.div(g[regs], abi.view(C, v, WV), o1) -> GK(o) proof
          assume dv
          have dv1 dv2 := expand(dv, tr.div)
          obtain t2, rd from dv2
          obtain t3, te from dv1
          have f1: fst(o1) = 2 by simp(te)
          have f0a: o1 = o -> fst(o) = 2 proof
            assume e5
            show := rewrite(e5, f1)
          qed
          have f0: fst(o) = 2 by taut(eo, f0a)
          obtain r0, _ rm0 from expand(hr, tr.run_k)
          have od := apply(tr.rmap_div, {r0}, {o}, rm0, f0)
          have rd2 := rewrite(veq, rd)
          have pu := apply(tr.spec_univ, {g}, {regs}, {W1}, {diverge(t2)}, hgt, hA, rd2)
          have t2u: t2 in univ(1) by simp(pu)
          have pd := apply(tr.gcall_div[g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {regs}, {t2}, wu, t2u, rg, hs, rd2, hd)
          have e2: ex t4. runs(P, w, diverge(t4)) by ex_intro({t2}, pd)
          have e3: ex t5. o = diverge(t5) by ex_intro({snd(r0)}, od)
          have d: tr.div(P, w, o) by defs(taut(e3, e2), tr.div)
          show by defs(taut(d), tr.gk)
        qed
        show by taut(mt2, u1, u2, u3, u4)
      qed
      // (2) the callee returned to x, the caller's run on from x
      have b2: (ex x r1 o1. tr.run_d(C, C, ok(x, empty)) && tr.rwk(s, zb. bkp(zb), pair(x, empty), r1) && tr.rmap(r1, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2))) -> GK(o) proof
        assume e
        obtain x r1 o1, hrx hw1 hm1 eo from e
        have c := mp(all_elim(rcl, {x}), hrx)
        have k2: tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, P, w, x) -> GK(o) proof
          assume hc
          have g1 := apply(tr.cl_rwk[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {P}, {w}, {x}, {r1}, {o1}, hc, hw1, hm1)
          have same: o1 = o -> GK(o) proof
            assume e5
            show := rewrite(e5, g1)
          qed
          have divs: (fst(o1) = 2 && fst(o) = 2) -> GK(o) proof
            assume dd2
            have od1 := apply(tr.rmap_div, {r1}, {o1}, hm1, dd2.1)
            obtain r0, _ rm0 from expand(hr, tr.run_k)
            have od := apply(tr.rmap_div, {r0}, {o}, rm0, dd2.2)
            have g2 := apply(tr.gk_div[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {P}, {w}, {snd(r1)}, {snd(r0)}, rewrite(od1, g1))
            show := rewrite(sym(od), g2)
          qed
          show by taut(eo, same, divs)
        qed
        show by taut(c, ub2, k2)
      qed
      // (3) the callee leaving its discipline: its contract has it raise
      have b3: (ex x. tr.run_d(C, C, exc(x, exc_val("disc", empty)))) -> GK(o) proof
        assume ed
        obtain x, hx from ed
        have mt2 := expand(mp(all_elim(ctr, {exc(x, exc_val("disc", empty))}), hx), tr.matches_t)
        have n1: (ex m1 w2. exc(x, exc_val("disc", empty)) = ok(m1, empty) && m1 in x86_64_linux.Machine && m1 in univ(1) &&
            runs(g[regs], abi.view(C, v, WV), ok(w2, pair(m1.gpr[0], m1.gpr[2]))) && w2 in abi.World && w2 in univ(1) &&
            abi.world_matches(C.vm, m1.vm, w2.vm, abi.wob(v, w2.objs.c_bytes), C.fs_base, abi.sp(C)) && m1.os = w2.os && m1.fs_base = C.fs_base &&
            m1.cpu = C.cpu && m1.gs_base = C.gs_base && m1.rip = abi.ret(C) && m1.gpr[4] = abi.sp(C) &&
            abi.callee_saved(m1, C) && !m1.flags.df) -> false proof
          assume eo
          obtain m2 w2, eo2 from eo
          show by simp(eo2.1)
        qed
        have n2: tr.crashes_t(g, regs, v, WV, C, exc(x, exc_val("disc", empty))) -> false proof
          assume ca
          obtain m2 a0 k0, {oe} from expand(ca, tr.crashes_t)
          show by simp(expand(oe, exc_val))
        qed
        have n3 := all_elim(tr.div_exc, {g[regs]}, {abi.view(C, v, WV)}, {x}, {exc_val("disc", empty)})
        have r3: abi.raises_at(g, regs, v, WV, C) by taut(mt2, n1, n2, n3)
        show := mp(ub2, mp(rub, r3))
      qed
      show by taut(rs, b1, b2, b3)
    qed
    have sm: tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, P, w, C) by defs(g0, tr.sim)
    show := apply(tr.sim_cl[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {P}, {w}, {C}, nrC, nbC, sm)
  qed
  show by taut(bad, good)
qed

// (the push's bytes: from R - 8's page, at most S's, which is mapped)
theorem tr.push_range: all s base code fr m w RA. tr.inv(s, base, code, fr, m, w) -> tr.cfr(fr) ->
  x86.range_below(bits_sub(64, m.gpr[4], 8), 8, int_div(int_sub(m.gpr[4], 8), 4096), int_div(s.gpr[4], 4096)) &&
  x86_64_linux.mapped(fn_update(m, "rip", RA).vm, int_div(s.gpr[4], 4096))
proof
  fix s base code fr m w RA
  assume hi hcf
  let S := s.gpr[4]
  let R := m.gpr[4]
  have {hsps} := apply(tr.inv_call, hi)
  have {rb, r16, rlt, ral, rs, rS, sb} := apply(tr.call_rsp, hi, hcf)
  have {lr, rp} := apply(tr.call_pages, {S}, {R}, rb, r16, ral, rs, rS, sb)
  have so: S in omega by simp(sb)
  have rb2: x86.range_below(bits_sub(64, R, 8), 8, int_div(int_sub(R, 8), 4096), int_div(S, 4096)) proof
    have g: all j. j in omega -> int_lt(j, 8) ->
        int_le(int_div(int_sub(R, 8), 4096), x86_64_linux.page_of(bits_add(64, bits_sub(64, R, 8), bits_of_int(64, j)))) &&
        int_le(x86_64_linux.page_of(bits_add(64, bits_sub(64, R, 8), bits_of_int(64, j))), int_div(S, 4096)) proof
      fix j
      assume hj hj8
      have pa1 pa2 := apply(tr.push_at, {R}, {j}, rb, r16, rlt, ral, hj, hj8)
      have pg: x86_64_linux.page_of(bits_add(64, bits_sub(64, R, 8), bits_of_int(64, j))) = int_div(int_sub(R, 8), 4096)
        by defs(simp(pa1, pa2), x86_64_linux.page_of, x86_64_linux.PAGE)
      have lp: int_le(int_div(int_sub(R, 8), 4096), int_div(S, 4096)) by arith(lr, rp)
      show by simp(pg, lp, keep(x86_64_linux.page_of))
    qed
    show by defs(g, x86.range_below)
  qed
  have kpt: tr.kept(s.vm, m.vm, S) by simp(expand(hi, tr.inv), keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, abi.stack_gap_free, abi.stack_reserve, x86_64_linux.can_access, tr.kept, tr.keeps_code))
  have kr := mp(all_elim(expand(kpt, tr.kept), {S}), so, arith(so), arith(so))
  have kr2: m.vm.pages[int_div(S, 4096)] = s.vm.pages[int_div(S, 4096)] by defs(kr, x86_64_linux.page_of, x86_64_linux.PAGE)
  have mp0: x86_64_linux.mapped(fn_update(m, "rip", RA).vm, int_div(S, 4096)) by defs(simp(kr2, expand(hsps, abi.stack_page, x86_64_linux.mapped)), x86_64_linux.mapped)
  show by taut(rb2, mp0)
qed

// ----------------------------------------------------------------------
//  The rule

// A call's push (any call instruction at a: the return address a2 pushed,
// rip the target T -- or the push faulting): the claim at the callee's
// entry C for every push done gives the claim before the call
theorem tr.call_g(s, v, base, code, fr, a, a2, T, g, args, hs, ds, rs, w, x9 x10 x8. ka, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw, zb. bkp, zb pb wb. bka):
  (all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
    (ex m1 e1. runs(x86_64_linux.touch_range(bits_sub(64, m.gpr[4], 8), 8, 1), fn_update(m, "rip", a2), ok(m1, e1)) &&
      o = ok(fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, bits_sub(64, m.gpr[4], 8), 8, a2))),
        "gpr", fn_update(m1.gpr, 4, bits_sub(64, m.gpr[4], 8))), "rip", T), empty)) ||
    (ex x e. runs(x86_64_linux.touch_range(bits_sub(64, m.gpr[4], 8), 8, 1), fn_update(m, "rip", a2), exc(x, e)) && o = exc(x, e))) ->
  a2 in bits(64) -> tr.cfr(fr) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) ->
  (all m m1 e1 C. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, ds) ->
    runs(x86_64_linux.touch_range(bits_sub(64, m.gpr[4], 8), 8, 1), fn_update(m, "rip", a2), ok(m1, e1)) ->
    C = fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, bits_sub(64, m.gpr[4], 8), 8, a2))),
      "gpr", fn_update(m1.gpr, 4, bits_sub(64, m.gpr[4], 8))), "rip", T) ->
    tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call(g, args), x0, x9 x10. ka(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
      x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, C)) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call(g, args), x0, x9 x10. ka(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w)
proof
  assume hst ha2 hcf hk hcl
  let P := mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call(g, args), x0, x9 x10. ka(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))
  have g0: all m. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, ds) -> tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, P, w, m) proof
    fix m
    assume hi hr hh hrs hmm hfr
    let S := s.gpr[4]
    have {mM, mu} := apply(tr.inv_call, hi)
    have {rb, r16, rlt, sb} := apply(tr.call_rsp, hi, hcf)
    let M2 := fn_update(m, "rip", a2)
    let PA := bits_sub(64, m.gpr[4], 8)
    // the step: the push done, or its fault
    have st: all o. runs(x86_64_linux.step(), m, o) ->
        (ex m2. o = ok(m2, empty) && (ex m1 e1. runs(x86_64_linux.touch_range(PA, 8, 1), M2, ok(m1, e1)) &&
          m2 = fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, PA, 8, a2))),
              "gpr", fn_update(m1.gpr, 4, PA)), "rip", T))) ||
        (ex x e. o = exc(x, e) && runs(x86_64_linux.touch_range(PA, 8, 1), M2, exc(x, e))) proof
      fix o
      assume ho
      have cr := mp(all_elim(hst, {m}, {o}), hi, hr, hrs, ho)
      have c1: (ex m1 e1. runs(x86_64_linux.touch_range(PA, 8, 1), M2, ok(m1, e1)) &&
          o = ok(fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, PA, 8, a2))),
              "gpr", fn_update(m1.gpr, 4, PA)), "rip", T), empty)) ->
          (ex m2. o = ok(m2, empty) && (ex m1 e1. runs(x86_64_linux.touch_range(PA, 8, 1), M2, ok(m1, e1)) &&
            m2 = fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, PA, 8, a2))),
              "gpr", fn_update(m1.gpr, 4, PA)), "rip", T))) proof
        assume e
        obtain m1 e1, tr0 oe from e
        let C := fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, PA, 8, a2))),
              "gpr", fn_update(m1.gpr, 4, PA)), "rip", T)
        have q: ex m1 e1. runs(x86_64_linux.touch_range(PA, 8, 1), M2, ok(m1, e1)) && C = fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, PA, 8, a2))),
              "gpr", fn_update(m1.gpr, 4, PA)), "rip", T)
          by ex_intro({m1}, {e1}, taut(tr0, refl({C})))
        show by ex_intro({C}, taut(oe, q))
      qed
      have c2: (ex x e. runs(x86_64_linux.touch_range(PA, 8, 1), M2, exc(x, e)) && o = exc(x, e)) ->
          (ex x e. o = exc(x, e) && runs(x86_64_linux.touch_range(PA, 8, 1), M2, exc(x, e))) proof
        assume e
        obtain x e0, ex2 from e
        show by ex_intro({x}, {e0}, taut(ex2))
      qed
      show by taut(cr, c1, c2)
    qed
    have nr := apply(tr.inv_nr, hi)
    // the push done: the callee runs
    have okc: all C. (ex m1 e1. runs(x86_64_linux.touch_range(PA, 8, 1), M2, ok(m1, e1)) && C = fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, PA, 8, a2))),
              "gpr", fn_update(m1.gpr, 4, PA)), "rip", T)) -> tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, P, w, C) proof
      fix C
      assume e
      obtain m1 e1, tr0 hC0 from e
      show := mp(all_elim(hcl, {m}, {m1}, {e1}, {C}), hi, hr, hh, hrs, hmm, hfr, tr0, hC0)
    qed
    // the push faulted: a crash, or GIMPLE's call undefined
    have exs: all x e. runs(x86_64_linux.touch_range(PA, 8, 1), M2, exc(x, e)) -> tr.ub(s, v, P, w) || tr.crash(s, P, w, exc(x, e)) proof
      fix x e
      assume hx
      have prb prm := apply(tr.push_range, {s}, {base}, {code}, {fr}, {m}, {w}, {a2}, hi, hcf)
      have mv: M2.vm in x86_64_linux.Vm by simp(apply(x86i.parts, mM))
      have m2u: M2 in univ(1) by simp(mu, ha2)
      have p0o: int_div(S, 4096) in omega by simp(sb)
      have gr fa := apply(x86.touch_range_exc, {M2}, {PA}, {8}, {1}, {int_div(int_sub(m.gpr[4], 8), 4096)}, {int_div(S, 4096)}, {x}, {e}, mv, m2u, p0o, prm, prb, hx)
      have se0 := apply(x86.touch_range_stk_exc, {M2}, {PA}, {8}, {1}, {x}, {e}, hx)
      have se: x86.stk_ext(m.vm, x.vm) by simp(se0)
      show := apply(tr.call_fault[g := g, args := args, a := x9 x10 x8. ka(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)],
        {s}, {v}, {base}, {code}, {fr}, {m}, {w}, {a2}, {x}, {e}, hi, hcf, hmm, hk, ha2, gr, fa, se)
    qed
    show := mp(mp(mp(mp(tr.step_x[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb), s := s, v := v, p := P, w := w, m := m,
      q := y. ex m1 e1. runs(x86_64_linux.touch_range(PA, 8, 1), M2, ok(m1, e1)) &&
        y = fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, PA, 8, a2))),
              "gpr", fn_update(m1.gpr, 4, PA)), "rip", T),
      qx := y z. runs(x86_64_linux.touch_range(PA, 8, 1), M2, exc(y, z))], st), nr), okc), exs)
  qed
  show by defs(g0, tr.lv)
qed

// `call rel32` (E8) at a: a2 pushed, rip f (a2 + off) -- or the push faulting
theorem tr.push_rel(s, base, code, fr, a, a2, len, off, f, rs, w):
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a -> runs(x86_64_linux.exec_body(len, tag(120, off)), m, o)) ->
  a2 = bits_add(64, a, bits_of_int(64, len)) -> off in bits(32) -> f = bits_add(64, a2, bits_sext(32, 64, off)) -> tr.cfr(fr) ->
  (all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
    (ex m1 e1. runs(x86_64_linux.touch_range(bits_sub(64, m.gpr[4], 8), 8, 1), fn_update(m, "rip", a2), ok(m1, e1)) &&
      o = ok(fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, bits_sub(64, m.gpr[4], 8), 8, a2))),
        "gpr", fn_update(m1.gpr, 4, bits_sub(64, m.gpr[4], 8))), "rip", f), empty)) ||
    (ex x e. runs(x86_64_linux.touch_range(bits_sub(64, m.gpr[4], 8), 8, 1), fn_update(m, "rip", a2), exc(x, e)) && o = exc(x, e)))
proof
  assume hat ha2 hoff hf hcf
  fix m o
  assume hi hr _ ho
  have {mM, mu} := apply(tr.inv_call, hi)
  have {rb, r16, rlt, sb} := apply(tr.call_rsp, hi, hcf)
  let RA := bits_add(64, m.rip, bits_of_int(64, len))
  let M2 := fn_update(m, "rip", RA)
  let PA := bits_sub(64, m.gpr[4], 8)
  have rae: RA = a2 by simp(hr, ha2)
  have r8: int_le(8, m.gpr[4]) by arith(r16)
  have cd: abi.code_at(m.vm, base, code) by simp(expand(hi, tr.inv), keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, abi.stack_gap_free, x86_64_linux.can_access, tr.kept, tr.keeps_code))
  have hx := mp(all_elim(hat, {m}, {o}), ho, cd, hr)
  have cr := apply(x86i.call_rel32, {m}, {o}, {off}, {len}, mM, mu, hoff, r8, rlt, hx)
  have c1: (ex m1 e1. runs(x86_64_linux.touch_range(PA, 8, 1), M2, ok(m1, e1)) &&
      o = ok(fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, PA, 8, RA))),
          "gpr", fn_update(m1.gpr, 4, PA)), "rip", bits_add(64, m1.rip, bits_sext(32, 64, off))), empty)) ->
      (ex m1 e1. runs(x86_64_linux.touch_range(PA, 8, 1), fn_update(m, "rip", a2), ok(m1, e1)) &&
        o = ok(fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, PA, 8, a2))),
          "gpr", fn_update(m1.gpr, 4, PA)), "rip", f), empty)) proof
    assume e
    obtain m1 e1, tr0 oe from e
    have tv := apply(x86.touch_range_vm, {M2}, {PA}, {8}, {1}, {m1}, {e1}, tr0)
    have m1r: m1.rip = RA by simp(tv)
    have tf: bits_add(64, m1.rip, bits_sext(32, 64, off)) = f by simp(m1r, rae, hf)
    have oe2 := rewrite(rae, rewrite(tf, oe))
    have tr2 := rewrite(rae, tr0)
    show by ex_intro({m1}, {e1}, taut(tr2, oe2))
  qed
  have c2: (ex x e. runs(x86_64_linux.touch_range(PA, 8, 1), M2, exc(x, e)) && o = exc(x, e)) ->
      (ex x e. runs(x86_64_linux.touch_range(PA, 8, 1), fn_update(m, "rip", a2), exc(x, e)) && o = exc(x, e)) proof
    assume e
    obtain x e0, ex2 from e
    have ex3 := rewrite(rae, ex2)
    show by ex_intro({x}, {e0}, taut(ex3))
  qed
  have c3: (ex t. runs(x86_64_linux.touch_range(PA, 8, 1), M2, diverge(t)) && o = diverge(t)) -> false proof
    assume e
    obtain t, et _ from e
    have nd := apply(x86.touch_range_nodiv, {M2}, {PA}, {8}, {1}, {t}, simp())
    show by taut(et, nd)
  qed
  show by taut(cr, c1, c2, c3)
qed

// `call *%g` (FF /2) at a, g holding T (its value in the registers' map):
// a2 pushed, rip T -- or the push faulting
theorem tr.push_reg(s, base, code, fr, a, a2, len, g, z, nb, T, rs, w):
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a -> runs(x86_64_linux.exec_body(len, tag(121, pair(tag(0, g), z))), m, o)) ->
  a2 = bits_add(64, a, bits_of_int(64, len)) -> g in x86_64_linux.Reg -> g in dom(rs) -> rs[g] = pair(nb, T) -> tr.cfr(fr) ->
  (all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
    (ex m1 e1. runs(x86_64_linux.touch_range(bits_sub(64, m.gpr[4], 8), 8, 1), fn_update(m, "rip", a2), ok(m1, e1)) &&
      o = ok(fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, bits_sub(64, m.gpr[4], 8), 8, a2))),
        "gpr", fn_update(m1.gpr, 4, bits_sub(64, m.gpr[4], 8))), "rip", T), empty)) ||
    (ex x e. runs(x86_64_linux.touch_range(bits_sub(64, m.gpr[4], 8), 8, 1), fn_update(m, "rip", a2), exc(x, e)) && o = exc(x, e)))
proof
  assume hat ha2 hg hgd hgu hcf
  fix m o
  assume hi hr hrs ho
  have {mM, mu} := apply(tr.inv_call, hi)
  have {rb, r16, rlt, sb} := apply(tr.call_rsp, hi, hcf)
  let RA := bits_add(64, m.rip, bits_of_int(64, len))
  let M2 := fn_update(m, "rip", RA)
  let PA := bits_sub(64, m.gpr[4], 8)
  have rae: RA = a2 by simp(hr, ha2)
  have r8: int_le(8, m.gpr[4]) by arith(r16)
  have rg _ := apply(tr.regs_get, {m}, {rs}, {g}, {nb}, {T}, hrs, hgd, hgu)
  have cd: abi.code_at(m.vm, base, code) by simp(expand(hi, tr.inv), keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, abi.stack_gap_free, x86_64_linux.can_access, tr.kept, tr.keeps_code))
  have hx := mp(all_elim(hat, {m}, {o}), ho, cd, hr)
  have cr := apply(x86i.call_reg, {m}, {o}, {g}, {z}, {len}, mM, mu, hg, r8, rlt, hx)
  have c1: (ex m1 e1. runs(x86_64_linux.touch_range(PA, 8, 1), M2, ok(m1, e1)) &&
      o = ok(fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, PA, 8, RA))),
          "gpr", fn_update(m1.gpr, 4, PA)), "rip", m.gpr[g]), empty)) ->
      (ex m1 e1. runs(x86_64_linux.touch_range(PA, 8, 1), fn_update(m, "rip", a2), ok(m1, e1)) &&
        o = ok(fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, PA, 8, a2))),
          "gpr", fn_update(m1.gpr, 4, PA)), "rip", T), empty)) proof
    assume e
    obtain m1 e1, tr0 oe from e
    have oe2 := rewrite(rae, rewrite(rg, oe))
    have tr2 := rewrite(rae, tr0)
    show by ex_intro({m1}, {e1}, taut(tr2, oe2))
  qed
  have c2: (ex x e. runs(x86_64_linux.touch_range(PA, 8, 1), M2, exc(x, e)) && o = exc(x, e)) ->
      (ex x e. runs(x86_64_linux.touch_range(PA, 8, 1), fn_update(m, "rip", a2), exc(x, e)) && o = exc(x, e)) proof
    assume e
    obtain x e0, ex2 from e
    have ex3 := rewrite(rae, ex2)
    show by ex_intro({x}, {e0}, taut(ex3))
  qed
  have c3: (ex t. runs(x86_64_linux.touch_range(PA, 8, 1), M2, diverge(t)) && o = diverge(t)) -> false proof
    assume e
    obtain t, et _ from e
    have nd := apply(x86.touch_range_nodiv, {M2}, {PA}, {8}, {1}, {t}, simp())
    show by taut(et, nd)
  qed
  show by taut(cr, c1, c2, c3)
qed

// A call `call rel32` (E8) at a, from a frame of fr bytes (8 mod 16, at
// most tr.FMAX), its n arguments in their registers (tr.args_in), against
// readable GIMPLE's call (the callee g at a2 + off, its contract
// tr.implements_at with the program cb/cc loaded at the entry, its spec
// typed and keeping I/O and code, tr.callee_io): the claim after the call
// (at a2, rax:rdx the result, the homes -- within the frame -- kept, the
// frame from the push up accessible: fd2 bytes, the world the callee's with
// the caller's stack objects) for every world gives the claim before it.
theorem tr.call(s, v, base, code, fr, a, a2, len, off, f, g, args, n, cb, cc, st, hs, ds, fd2, rs, rc, w, x9 x10 x8. ka, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw, zb. bkp, zb pb wb. bka): tr.ofr(s, fr, v) -> tr.hap(s, hs, v) -> 
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a -> runs(x86_64_linux.exec_body(len, tag(120, off)), m, o)) ->
  a2 = bits_add(64, a, bits_of_int(64, len)) -> off in bits(32) -> base in omega ->
  f = bits_add(64, a2, bits_sext(32, 64, off)) -> tr.callee_contract(fr, f, g, cb, cc, st) -> (int_mod(fr, 16) = 8 -> tr.sal16(s)) -> abi.loaded(s.vm, cb, cc, st) -> cb in omega ->
  tr.cfr(fr) -> seq_len(args) = n -> n in omega -> int_le(n, 6) ->
  g in fn_space(abi.ARGS, powerset(univ(1))) -> tr.callee_io(g, n) ->
  (all m. tr.regs(m, rs) -> tr.args_in(m, args)) -> tr.cs_sub(rc, rs) -> tr.hin(hs, fr) -> fd2 in omega -> int_le(fd2, int_add(fr, 8)) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) ->
  (all t. t in univ(1) -> runs(mkprog(x0 x1. ex x8. dd(t, x8) && k(x8, x1)), w, diverge(t))) ->
  (all w4 r0 r1. w4 in abi.World && w4 in univ(1) -> r0 in bits(64) -> r1 in bits(64) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, fd2, fn_update(fn_update(rc, 0, pair(8, r0)), 2, pair(8, r1)),
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. ka(x0, pair(r0, r1), x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w4)) ->
  (all z. int_lt(z.gpr[4], int_sub(s.gpr[4], fr)) -> !bkp(z)) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call(g, args), x0, x9 x10. ka(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w)
proof
  assume hofr hap hat ha2 hoff hb hf himp hal hld hcb hcf hln hno hn6 hgt hio hreg hsub hhin hfo hfd hk hd hpost hbf
  have a2b: a2 in bits(64) by simp(ha2)
  // (the instruction: the return address a2 pushed, rip f)
  have hst := apply(tr.push_rel[s := s, base := base, code := code, fr := fr, a := a, a2 := a2, len := len, off := off, f := f, rs := rs, w := w], hat, ha2, hoff, hf, hcf)
  // (the push done: the callee runs under its contract)
  have hcl: all m m1 e1 C. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, ds) ->
      runs(x86_64_linux.touch_range(bits_sub(64, m.gpr[4], 8), 8, 1), fn_update(m, "rip", a2), ok(m1, e1)) ->
      C = fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, bits_sub(64, m.gpr[4], 8), 8, a2))),
        "gpr", fn_update(m1.gpr, 4, bits_sub(64, m.gpr[4], 8))), "rip", f) ->
      tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call(g, args), x0, x9 x10. ka(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
        x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, C) proof
    fix m m1 e1 C
    assume hi hr hh hrs hmm hfr tr2 hC2
    have hin := mp(all_elim(hreg, {m}), hrs)
    have tb: f in bits(64) by simp(hf)
    have hbm: all z. int_lt(z.gpr[4], m.gpr[4]) -> !bkp(z) proof
      fix z
      assume lt
      have rspm := apply(tr.inv_parts, hi).4
      show := mp(all_elim(hbf, {z}), rewrite(rspm, lt))
    qed
    show := apply(tr.callee_sim[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb), g := g, args := args, a := x9 x10 x8. ka(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)],
      {s}, {v}, {base}, {code}, {fr}, {m}, {w}, {n}, {hs}, {fd2}, {a2}, {f}, {m1}, {e1}, {C}, {cb}, {cc}, {st}, {rs}, {rc}, hap, hofr,
      hi, hcf, hmm, hb, hrs, hsub, hin, hln, hno, hn6, a2b, tb, tr2, hC2, himp, hal, hld, hcb, hh, hhin, hfo, hfd, hgt, hio, hk, hd, hpost, hbm)
  qed
  show := apply(tr.call_g[s := s, v := v, base := base, code := code, fr := fr, a := a, a2 := a2, T := f, g := g, args := args, hs := hs, ds := ds, rs := rs, w := w,
    ka := x9 x10 x8. ka(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2),
    bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], hst, a2b, hcf, hk, hcl)
qed

// (a register holding x (k bytes, a word's size): as GIMPLE's argument x of n bits)
theorem tr.argv_reg: all rs r k n x. r in dom(rs) -> rs[r] = pair(k, x) -> (k = 1 || k = 2 || k = 4 || k = 8) ->
  (all m. tr.regs(m, rs) -> m.gpr[r] in gimple.in_reg(fst(gimple.arg(n, x)), snd(gimple.arg(n, x))))
proof
  fix rs r k n x
  assume hd hx hk
  fix m
  assume hr
  have rg := apply(tr.regs_get, {m}, {rs}, {r}, {k}, {x}, hr, hd, hx)
  have e: m.gpr[r] = x by taut(rg)
  have xb: x in bits(int_mul(8, k)) by taut(rg)
  have k1: k = 1 -> x in bits(64) proof
    assume e
    have b: x in bits(8) by simp(rewrite(e, xb))
    show by arith(b)
  qed
  have k2: k = 2 -> x in bits(64) proof
    assume e
    have b: x in bits(16) by simp(rewrite(e, xb))
    show by arith(b)
  qed
  have k4: k = 4 -> x in bits(64) proof
    assume e
    have b: x in bits(32) by simp(rewrite(e, xb))
    show by arith(b)
  qed
  have k8: k = 8 -> x in bits(64) proof
    assume e
    have b: x in bits(64) by simp(rewrite(e, xb))
    show by arith(b)
  qed
  have x64: x in bits(64) by taut(hk, k1, k2, k4, k8)
  show by defs(simp(e, x64), gimple.in_reg, gimple.arg)
qed

// (no arguments)
theorem tr.args0: all rs. (all m. tr.regs(m, rs) -> tr.args_in(m, empty))
proof
  fix rs
  fix m
  assume hr
  have g: all i. i in omega -> int_lt(i, seq_len(empty)) ->
      m.gpr[abi.ARG_REGS[i]] in gimple.in_reg(fst(empty[i]), snd(empty[i])) proof
    fix i
    assume hi hl
    have l0: seq_len(empty) = 0 by arith()
    have f: false by arith(hi, hl, l0)
    show by taut(f)
  qed
  show by defs(g, tr.args_in)
qed

// (1 argument(s): in rdi, rsi, rdx, rcx, r8, r9 in order)
theorem tr.args1: all rs a0.
  (all m. tr.regs(m, rs) -> m.gpr[7] in gimple.in_reg(fst(a0), snd(a0))) ->
  (all m. tr.regs(m, rs) -> tr.args_in(m, seq_one(a0)))
proof
  fix rs a0
  assume h0
  fix m
  assume hr
  have ar := tr.argregs
  have g: all i. i in omega -> int_lt(i, seq_len(seq_one(a0))) ->
      m.gpr[abi.ARG_REGS[i]] in gimple.in_reg(fst(seq_one(a0)[i]), snd(seq_one(a0)[i])) proof
    fix i
    assume hi hl
    have ln: seq_len(seq_one(a0)) = 1 by arith()
    have cs: i = 0 by arith(hi, hl, ln)
    have c0: i = 0 -> m.gpr[abi.ARG_REGS[i]] in gimple.in_reg(fst(seq_one(a0)[i]), snd(seq_one(a0)[i])) proof
      assume e
      have q := at({seq_one(a0)[0]})
      have v := mp(all_elim(h0, {m}), hr)
      show by simp(e, q, ar, v)
    qed
    show by taut(cs, c0)
  qed
  show by defs(g, tr.args_in)
qed

// (2 argument(s): in rdi, rsi, rdx, rcx, r8, r9 in order)
theorem tr.args2: all rs a0 a1.
  (all m. tr.regs(m, rs) -> m.gpr[7] in gimple.in_reg(fst(a0), snd(a0))) ->
  (all m. tr.regs(m, rs) -> m.gpr[6] in gimple.in_reg(fst(a1), snd(a1))) ->
  (all m. tr.regs(m, rs) -> tr.args_in(m, seq_concat(seq_one(a0), seq_one(a1))))
proof
  fix rs a0 a1
  assume h0 h1
  fix m
  assume hr
  have ar := tr.argregs
  have g: all i. i in omega -> int_lt(i, seq_len(seq_concat(seq_one(a0), seq_one(a1)))) ->
      m.gpr[abi.ARG_REGS[i]] in gimple.in_reg(fst(seq_concat(seq_one(a0), seq_one(a1))[i]), snd(seq_concat(seq_one(a0), seq_one(a1))[i])) proof
    fix i
    assume hi hl
    have ln: seq_len(seq_concat(seq_one(a0), seq_one(a1))) = 2 by arith()
    have cs: i = 0 || i = 1 by arith(hi, hl, ln)
    have c0: i = 0 -> m.gpr[abi.ARG_REGS[i]] in gimple.in_reg(fst(seq_concat(seq_one(a0), seq_one(a1))[i]), snd(seq_concat(seq_one(a0), seq_one(a1))[i])) proof
      assume e
      have q := at({seq_concat(seq_one(a0), seq_one(a1))[0]})
      have v := mp(all_elim(h0, {m}), hr)
      show by simp(e, q, ar, v)
    qed
    have c1: i = 1 -> m.gpr[abi.ARG_REGS[i]] in gimple.in_reg(fst(seq_concat(seq_one(a0), seq_one(a1))[i]), snd(seq_concat(seq_one(a0), seq_one(a1))[i])) proof
      assume e
      have q := at({seq_concat(seq_one(a0), seq_one(a1))[1]})
      have v := mp(all_elim(h1, {m}), hr)
      show by simp(e, q, ar, v)
    qed
    show by taut(cs, c0, c1)
  qed
  show by defs(g, tr.args_in)
qed

// (3 argument(s): in rdi, rsi, rdx, rcx, r8, r9 in order)
theorem tr.args3: all rs a0 a1 a2.
  (all m. tr.regs(m, rs) -> m.gpr[7] in gimple.in_reg(fst(a0), snd(a0))) ->
  (all m. tr.regs(m, rs) -> m.gpr[6] in gimple.in_reg(fst(a1), snd(a1))) ->
  (all m. tr.regs(m, rs) -> m.gpr[2] in gimple.in_reg(fst(a2), snd(a2))) ->
  (all m. tr.regs(m, rs) -> tr.args_in(m, seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2))))
proof
  fix rs a0 a1 a2
  assume h0 h1 h2
  fix m
  assume hr
  have ar := tr.argregs
  have g: all i. i in omega -> int_lt(i, seq_len(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)))) ->
      m.gpr[abi.ARG_REGS[i]] in gimple.in_reg(fst(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2))[i]), snd(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2))[i])) proof
    fix i
    assume hi hl
    have ln: seq_len(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2))) = 3 by arith()
    have cs: i = 0 || i = 1 || i = 2 by arith(hi, hl, ln)
    have c0: i = 0 -> m.gpr[abi.ARG_REGS[i]] in gimple.in_reg(fst(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2))[i]), snd(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2))[i])) proof
      assume e
      have q := at({seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2))[0]})
      have v := mp(all_elim(h0, {m}), hr)
      show by simp(e, q, ar, v)
    qed
    have c1: i = 1 -> m.gpr[abi.ARG_REGS[i]] in gimple.in_reg(fst(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2))[i]), snd(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2))[i])) proof
      assume e
      have q := at({seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2))[1]})
      have v := mp(all_elim(h1, {m}), hr)
      show by simp(e, q, ar, v)
    qed
    have c2: i = 2 -> m.gpr[abi.ARG_REGS[i]] in gimple.in_reg(fst(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2))[i]), snd(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2))[i])) proof
      assume e
      have q := at({seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2))[2]})
      have v := mp(all_elim(h2, {m}), hr)
      show by simp(e, q, ar, v)
    qed
    show by taut(cs, c0, c1, c2)
  qed
  show by defs(g, tr.args_in)
qed

// (4 argument(s): in rdi, rsi, rdx, rcx, r8, r9 in order)
theorem tr.args4: all rs a0 a1 a2 a3.
  (all m. tr.regs(m, rs) -> m.gpr[7] in gimple.in_reg(fst(a0), snd(a0))) ->
  (all m. tr.regs(m, rs) -> m.gpr[6] in gimple.in_reg(fst(a1), snd(a1))) ->
  (all m. tr.regs(m, rs) -> m.gpr[2] in gimple.in_reg(fst(a2), snd(a2))) ->
  (all m. tr.regs(m, rs) -> m.gpr[1] in gimple.in_reg(fst(a3), snd(a3))) ->
  (all m. tr.regs(m, rs) -> tr.args_in(m, seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3))))
proof
  fix rs a0 a1 a2 a3
  assume h0 h1 h2 h3
  fix m
  assume hr
  have ar := tr.argregs
  have g: all i. i in omega -> int_lt(i, seq_len(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)))) ->
      m.gpr[abi.ARG_REGS[i]] in gimple.in_reg(fst(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3))[i]), snd(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3))[i])) proof
    fix i
    assume hi hl
    have ln: seq_len(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3))) = 4 by arith()
    have cs: i = 0 || i = 1 || i = 2 || i = 3 by arith(hi, hl, ln)
    have c0: i = 0 -> m.gpr[abi.ARG_REGS[i]] in gimple.in_reg(fst(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3))[i]), snd(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3))[i])) proof
      assume e
      have q := at({seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3))[0]})
      have v := mp(all_elim(h0, {m}), hr)
      show by simp(e, q, ar, v)
    qed
    have c1: i = 1 -> m.gpr[abi.ARG_REGS[i]] in gimple.in_reg(fst(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3))[i]), snd(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3))[i])) proof
      assume e
      have q := at({seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3))[1]})
      have v := mp(all_elim(h1, {m}), hr)
      show by simp(e, q, ar, v)
    qed
    have c2: i = 2 -> m.gpr[abi.ARG_REGS[i]] in gimple.in_reg(fst(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3))[i]), snd(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3))[i])) proof
      assume e
      have q := at({seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3))[2]})
      have v := mp(all_elim(h2, {m}), hr)
      show by simp(e, q, ar, v)
    qed
    have c3: i = 3 -> m.gpr[abi.ARG_REGS[i]] in gimple.in_reg(fst(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3))[i]), snd(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3))[i])) proof
      assume e
      have q := at({seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3))[3]})
      have v := mp(all_elim(h3, {m}), hr)
      show by simp(e, q, ar, v)
    qed
    show by taut(cs, c0, c1, c2, c3)
  qed
  show by defs(g, tr.args_in)
qed

// (5 argument(s): in rdi, rsi, rdx, rcx, r8, r9 in order)
theorem tr.args5: all rs a0 a1 a2 a3 a4.
  (all m. tr.regs(m, rs) -> m.gpr[7] in gimple.in_reg(fst(a0), snd(a0))) ->
  (all m. tr.regs(m, rs) -> m.gpr[6] in gimple.in_reg(fst(a1), snd(a1))) ->
  (all m. tr.regs(m, rs) -> m.gpr[2] in gimple.in_reg(fst(a2), snd(a2))) ->
  (all m. tr.regs(m, rs) -> m.gpr[1] in gimple.in_reg(fst(a3), snd(a3))) ->
  (all m. tr.regs(m, rs) -> m.gpr[8] in gimple.in_reg(fst(a4), snd(a4))) ->
  (all m. tr.regs(m, rs) -> tr.args_in(m, seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4))))
proof
  fix rs a0 a1 a2 a3 a4
  assume h0 h1 h2 h3 h4
  fix m
  assume hr
  have ar := tr.argregs
  have g: all i. i in omega -> int_lt(i, seq_len(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4)))) ->
      m.gpr[abi.ARG_REGS[i]] in gimple.in_reg(fst(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4))[i]), snd(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4))[i])) proof
    fix i
    assume hi hl
    have ln: seq_len(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4))) = 5 by arith()
    have cs: i = 0 || i = 1 || i = 2 || i = 3 || i = 4 by arith(hi, hl, ln)
    have c0: i = 0 -> m.gpr[abi.ARG_REGS[i]] in gimple.in_reg(fst(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4))[i]), snd(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4))[i])) proof
      assume e
      have q := at({seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4))[0]})
      have v := mp(all_elim(h0, {m}), hr)
      show by simp(e, q, ar, v)
    qed
    have c1: i = 1 -> m.gpr[abi.ARG_REGS[i]] in gimple.in_reg(fst(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4))[i]), snd(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4))[i])) proof
      assume e
      have q := at({seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4))[1]})
      have v := mp(all_elim(h1, {m}), hr)
      show by simp(e, q, ar, v)
    qed
    have c2: i = 2 -> m.gpr[abi.ARG_REGS[i]] in gimple.in_reg(fst(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4))[i]), snd(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4))[i])) proof
      assume e
      have q := at({seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4))[2]})
      have v := mp(all_elim(h2, {m}), hr)
      show by simp(e, q, ar, v)
    qed
    have c3: i = 3 -> m.gpr[abi.ARG_REGS[i]] in gimple.in_reg(fst(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4))[i]), snd(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4))[i])) proof
      assume e
      have q := at({seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4))[3]})
      have v := mp(all_elim(h3, {m}), hr)
      show by simp(e, q, ar, v)
    qed
    have c4: i = 4 -> m.gpr[abi.ARG_REGS[i]] in gimple.in_reg(fst(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4))[i]), snd(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4))[i])) proof
      assume e
      have q := at({seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4))[4]})
      have v := mp(all_elim(h4, {m}), hr)
      show by simp(e, q, ar, v)
    qed
    show by taut(cs, c0, c1, c2, c3, c4)
  qed
  show by defs(g, tr.args_in)
qed

// (6 argument(s): in rdi, rsi, rdx, rcx, r8, r9 in order)
theorem tr.args6: all rs a0 a1 a2 a3 a4 a5.
  (all m. tr.regs(m, rs) -> m.gpr[7] in gimple.in_reg(fst(a0), snd(a0))) ->
  (all m. tr.regs(m, rs) -> m.gpr[6] in gimple.in_reg(fst(a1), snd(a1))) ->
  (all m. tr.regs(m, rs) -> m.gpr[2] in gimple.in_reg(fst(a2), snd(a2))) ->
  (all m. tr.regs(m, rs) -> m.gpr[1] in gimple.in_reg(fst(a3), snd(a3))) ->
  (all m. tr.regs(m, rs) -> m.gpr[8] in gimple.in_reg(fst(a4), snd(a4))) ->
  (all m. tr.regs(m, rs) -> m.gpr[9] in gimple.in_reg(fst(a5), snd(a5))) ->
  (all m. tr.regs(m, rs) -> tr.args_in(m, seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4)), seq_one(a5))))
proof
  fix rs a0 a1 a2 a3 a4 a5
  assume h0 h1 h2 h3 h4 h5
  fix m
  assume hr
  have ar := tr.argregs
  have g: all i. i in omega -> int_lt(i, seq_len(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4)), seq_one(a5)))) ->
      m.gpr[abi.ARG_REGS[i]] in gimple.in_reg(fst(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4)), seq_one(a5))[i]), snd(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4)), seq_one(a5))[i])) proof
    fix i
    assume hi hl
    have ln: seq_len(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4)), seq_one(a5))) = 6 by arith()
    have cs: i = 0 || i = 1 || i = 2 || i = 3 || i = 4 || i = 5 by arith(hi, hl, ln)
    have c0: i = 0 -> m.gpr[abi.ARG_REGS[i]] in gimple.in_reg(fst(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4)), seq_one(a5))[i]), snd(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4)), seq_one(a5))[i])) proof
      assume e
      have q := at({seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4)), seq_one(a5))[0]})
      have v := mp(all_elim(h0, {m}), hr)
      show by simp(e, q, ar, v)
    qed
    have c1: i = 1 -> m.gpr[abi.ARG_REGS[i]] in gimple.in_reg(fst(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4)), seq_one(a5))[i]), snd(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4)), seq_one(a5))[i])) proof
      assume e
      have q := at({seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4)), seq_one(a5))[1]})
      have v := mp(all_elim(h1, {m}), hr)
      show by simp(e, q, ar, v)
    qed
    have c2: i = 2 -> m.gpr[abi.ARG_REGS[i]] in gimple.in_reg(fst(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4)), seq_one(a5))[i]), snd(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4)), seq_one(a5))[i])) proof
      assume e
      have q := at({seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4)), seq_one(a5))[2]})
      have v := mp(all_elim(h2, {m}), hr)
      show by simp(e, q, ar, v)
    qed
    have c3: i = 3 -> m.gpr[abi.ARG_REGS[i]] in gimple.in_reg(fst(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4)), seq_one(a5))[i]), snd(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4)), seq_one(a5))[i])) proof
      assume e
      have q := at({seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4)), seq_one(a5))[3]})
      have v := mp(all_elim(h3, {m}), hr)
      show by simp(e, q, ar, v)
    qed
    have c4: i = 4 -> m.gpr[abi.ARG_REGS[i]] in gimple.in_reg(fst(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4)), seq_one(a5))[i]), snd(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4)), seq_one(a5))[i])) proof
      assume e
      have q := at({seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4)), seq_one(a5))[4]})
      have v := mp(all_elim(h4, {m}), hr)
      show by simp(e, q, ar, v)
    qed
    have c5: i = 5 -> m.gpr[abi.ARG_REGS[i]] in gimple.in_reg(fst(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4)), seq_one(a5))[i]), snd(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4)), seq_one(a5))[i])) proof
      assume e
      have q := at({seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(a0), seq_one(a1)), seq_one(a2)), seq_one(a3)), seq_one(a4)), seq_one(a5))[5]})
      have v := mp(all_elim(h5, {m}), hr)
      show by simp(e, q, ar, v)
    qed
    show by taut(cs, c0, c1, c2, c3, c4, c5)
  qed
  show by defs(g, tr.args_in)
qed

// ----------------------------------------------------------------------
//  call1 (the result's rax only): the call, its result's first half

// (a step of call1: the call's, its result's first half)
theorem tr.call1_bind(g, args, x9 x10. a, x9 x10. xx, x9. dd): all w. bind_rel(gimple.call(g, args), w, x9 x10. a(x9, fst(x10)), x9 x10. xx(x9, x10), x9. dd(x9)) ->
  bind_rel(gimple.call1(g, args), w, x9 x10. a(x9, x10), x9 x10. xx(x9, x10), x9. dd(x9))
proof
  fix w
  assume h
  obtain o2, hr hc from expand(h, bind_rel)
  have pu: pair(w, o2) in univ(1) by taut(unsel(expand(hr, runs, gimple.call, mkprog)))
  have wu: w in univ(1) by simp(pu)
  have c1: (ex s1 v. o2 = ok(s1, v) && a(s1, fst(v))) -> bind_rel(gimple.call1(g, args), w, x9 x10. a(x9, x10), x9 x10. xx(x9, x10), x9. dd(x9)) proof
    assume e
    obtain s1 v, eo ha from e
    have hr2 := rewrite(eo, hr)
    have pu2 := rewrite(eo, pu)
    have pu3: pair(w, ok(s1, fst(v))) in univ(1) by simp(pu2)
    have b: bind_rel(gimple.call(g, args), w, x2 x3. letin(x3, x4. ok(s1, fst(v)) = ok(x2, fst(x4))), x2 x3. ok(s1, fst(v)) = exc(x2, x3), x2. ok(s1, fst(v)) = diverge(x2))
      by defs(ex_intro({ok(s1, v)}, simp(hr2, keep(gimple.call))), bind_rel)
    have r1: runs(gimple.call1(g, args), w, ok(s1, fst(v))) by defs(mp(all_elim(tr.runs_intro[r := x0 x1. bind_rel(gimple.call(g, args), x0, x2 x3. letin(x3, x4. x1 = ok(x2, fst(x4))), x2 x3. x1 = exc(x2, x3), x2. x1 = diverge(x2))], {w}, {ok(s1, fst(v))}), pu3, b), gimple.call1)
    show by defs(ex_intro({ok(s1, fst(v))}, simp(r1, ha, keep(gimple.call1))), bind_rel)
  qed
  have c2: (ex s1 e. o2 = exc(s1, e) && xx(s1, e)) -> bind_rel(gimple.call1(g, args), w, x9 x10. a(x9, x10), x9 x10. xx(x9, x10), x9. dd(x9)) proof
    assume e
    obtain s1 e1, eo hx from e
    have pu2 := rewrite(eo, pu)
    have r1 := apply(gc.call1_exc, {g}, {args}, {w}, {s1}, {e1}, wu, simp(pu2), simp(pu2), rewrite(eo, hr))
    show by defs(ex_intro({exc(s1, e1)}, simp(r1, hx, keep(gimple.call1))), bind_rel)
  qed
  have c3: (ex t. o2 = diverge(t) && dd(t)) -> bind_rel(gimple.call1(g, args), w, x9 x10. a(x9, x10), x9 x10. xx(x9, x10), x9. dd(x9)) proof
    assume e
    obtain t, eo hd from e
    have pu2 := rewrite(eo, pu)
    have r1 := apply(gc.call1_div, {g}, {args}, {w}, {t}, wu, simp(pu2), rewrite(eo, hr))
    show by defs(ex_intro({diverge(t)}, simp(r1, hd, keep(gimple.call1))), bind_rel)
  qed
  show by taut(hc, c1, c2, c3)
qed

// the function's program with call1: refined by the one with the call
theorem tr.call1_red(g, args, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all w. w in univ(1) ->
  tr.red(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w,
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call(g, args), x0, x9 x10. a(x9, fst(x10), x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w)
proof
  fix w
  assume hw
  have g0: all o. (ex x8. bind_rel(gimple.call(g, args), w, x9 x10. a(x9, fst(x10), x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, o)) ->
      (ex x8. bind_rel(gimple.call1(g, args), w, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, o)) proof
    fix o
    assume h
    obtain y, hb hk from h
    have b := apply(tr.call1_bind[g := g, args := args, a := x9 x10. a(x9, x10, y), xx := x9 x10. xx(x9, x10, y), dd := x9. dd(x9, y)], {w}, hb)
    show by ex_intro({y}, conj(b, hk))
  qed
  have q := mp(tr.mkprog_mono[s := w, r1 := x0 x1. ex x8. bind_rel(gimple.call1(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1),
    r2 := x0 x1. ex x8. bind_rel(gimple.call(g, args), x0, x9 x10. a(x9, fst(x10), x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)], g0)
  have pr := apply(tr.p_red[q := mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)),
    q2 := mkprog(x0 x1. ex x8. bind_rel(gimple.call(g, args), x0, x9 x10. a(x9, fst(x10), x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {w}, hw, q)
  show by defs(pr, tr.red)
qed

// (registers: rax:rdx's map, rax's)
theorem tr.regs_rax: all m rc a b. tr.regs(m, fn_update(fn_update(rc, 0, a), 2, b)) -> is_fun(rc) -> !(2 in dom(rc)) -> tr.regs(m, fn_update(rc, 0, a))
proof
  fix m rc a b
  assume h hf n2
  have f d := expand(h, tr.regs)
  have f1 := mp(fn_update_fun[f := rc, k := 0, v := a], hf)
  have dA := mp(dom_update[f := fn_update(rc, 0, a), k := 2, v := b], f1)
  have dB := mp(dom_update[f := rc, k := 0, v := a], hf)
  have g: all r. r in dom(fn_update(rc, 0, a)) -> m.gpr[r] = snd(fn_update(rc, 0, a)[r]) && snd(fn_update(rc, 0, a)[r]) in bits(int_mul(8, fst(fn_update(rc, 0, a)[r]))) proof
    fix r
    assume hr
    have hr2 := rewrite(dB, hr)
    have ne: !(r = 2) proof
      assume e
      have c: r in dom(rc) by simp(hr2, e)
      show by taut(rewrite(e, c), n2)
    qed
    have z: r in dom(fn_update(fn_update(rc, 0, a), 2, b)) by simp(rewrite(dB, dA), hr2)
    have k := mp(all_elim(d, {r}), z)
    have e2 := mp(app_update_other[f := fn_update(rc, 0, a), k := 2, v := b, x := r], ne)
    show by simp(k, e2)
  qed
  show by defs(conj(f1, g), tr.regs)
qed

// (rs's callee-saved part: no rax, no rdx)
theorem tr.cs_sub_no(rc, rs, r): tr.cs_sub(rc, rs) -> !tr.cs_reg(r) -> !(r in dom(rc))
proof
  assume hs hn
  have _ k := expand(hs, tr.cs_sub)
  show proof
    assume hd
    have c _ _ := mp(all_elim(k, {r}), hd)
    show by taut(c, hn)
  qed
qed

// ... with call1 (the result's rax only): the call's rule, the result's first half
theorem tr.call1(s, v, base, code, fr, a, a2, len, off, f, g, args, n, cb, cc, st, hs, ds, fd2, rs, rc, w, x9 x10 x8. ka, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw, zb. bkp, zb pb wb. bka): tr.hap(s, hs, v) -> tr.ofr(s, fr, v) -> 
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a -> runs(x86_64_linux.exec_body(len, tag(120, off)), m, o)) ->
  a2 = bits_add(64, a, bits_of_int(64, len)) -> off in bits(32) -> base in omega ->
  f = bits_add(64, a2, bits_sext(32, 64, off)) -> tr.callee_contract(fr, f, g, cb, cc, st) -> (int_mod(fr, 16) = 8 -> tr.sal16(s)) -> abi.loaded(s.vm, cb, cc, st) -> cb in omega ->
  tr.cfr(fr) -> seq_len(args) = n -> n in omega -> int_le(n, 6) ->
  g in fn_space(abi.ARGS, powerset(univ(1))) -> tr.callee_io(g, n) ->
  (all m. tr.regs(m, rs) -> tr.args_in(m, args)) -> tr.cs_sub(rc, rs) -> tr.hin(hs, fr) -> fd2 in omega -> int_le(fd2, int_add(fr, 8)) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) ->
  (all t. t in univ(1) -> runs(mkprog(x0 x1. ex x8. dd(t, x8) && k(x8, x1)), w, diverge(t))) ->
  (all w4 r0. w4 in abi.World && w4 in univ(1) -> r0 in bits(64) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, fd2, fn_update(rc, 0, pair(8, r0)),
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. ka(x0, r0, x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w4)) ->
  (all z. int_lt(z.gpr[4], int_sub(s.gpr[4], fr)) -> !bkp(z)) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, args), x0, x9 x10. ka(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w)
proof
  assume hap hofr hat ha2 hoff hb hf himp0 hal hld hcb hcf hln hno hn6 hgt hio hreg hsub hhin hfo hfd hk hd hpost hbf
  have rcf _ := expand(hsub, tr.cs_sub)
  have n2 := apply(tr.cs_sub_no[rc := rc, rs := rs, r := 2], hsub, (!tr.cs_reg(2) by defs(simp(), tr.cs_reg)))
  // (the claim after the call: rax's, rdx dropped)
  have post: all w4 r0 r1. w4 in abi.World && w4 in univ(1) -> r0 in bits(64) -> r1 in bits(64) ->
      tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, fd2, fn_update(fn_update(rc, 0, pair(8, r0)), 2, pair(8, r1)), mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. ka(x0, fst(pair(r0, r1)), x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w4) proof
    fix w4 r0 r1
    assume hw4 hr0 hr1
    have pt0 := mp(all_elim(hpost, {w4}, {r0}), hw4, hr0)
    have g: all m. tr.inv(s, base, code, fr, m, w4) -> m.rip = a2 -> tr.homes(s, m, hs) -> tr.regs(m, fn_update(fn_update(rc, 0, pair(8, r0)), 2, pair(8, r1))) ->
        tr.mem(s, m, w4, v) -> tr.frame(s, m, fd2) -> tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. ka(x0, fst(pair(r0, r1)), x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w4, m) proof
      fix m
      assume h1 h2 h3 h4 h5 h6
      have sm := mp(all_elim(expand(pt0, tr.pt), {m}), h1, h2, h3, apply(tr.regs_rax, h4, rcf, n2), h5, h6)
      have e := fst_pair[a := r0, b := r1]
      have rd: all o. runs(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. ka(x0, r0, x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w4, o) -> runs(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. ka(x0, fst(pair(r0, r1)), x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w4, o) proof
        fix o
        assume h
        show := rewrite(sym(e), h)
      qed
      show := apply(tr.cl_red[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], (tr.red(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. ka(x0, fst(pair(r0, r1)), x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w4, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. ka(x0, r0, x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w4) by defs(rd, tr.red)), sm)
    qed
    show by defs(g, tr.pt)
  qed
  have c := mp(tr.call[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb), s := s, v := v, base := base, code := code, fr := fr, a := a, a2 := a2, len := len, off := off, f := f, g := g, args := args, n := n, cb := cb, cc := cc, st := st,
    hs := hs, ds := ds, fd2 := fd2, rs := rs, rc := rc, w := w, ka := x9 x10 x8. ka(x9, fst(x10), x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], hofr, hap,
    hat, ha2, hoff, hb, hf, himp0, hal, hld, hcb, hcf, hln, hno, hn6, hgt, hio, hreg, hsub, hhin, hfo, hfd, hk, hd, post, hbf)
  // (the call1 claim: the call's, refined)
  have g: all m. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      tr.mem(s, m, w, v) -> tr.frame(s, m, ds) -> tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, args), x0, x9 x10. ka(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, m) proof
    fix m
    assume h1 h2 h3 h4 h5 h6
    have sm := mp(all_elim(expand(c, tr.lv), {m}), h1, h2, h3, h4, h5, h6)
    have {wu} := h1
    have rd := all_elim(tr.call1_red[g := g, args := args, a := x9 x10 x8. ka(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w})
    show := apply(tr.sim_red[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], mp(rd, wu), sm)
  qed
  show by defs(g, tr.lv)
qed

// ----------------------------------------------------------------------
//  A caller's contract: its code with its callees'

// (code loaded as two pieces: each loaded at its place)
theorem tr.code_concat: all vm b c1 c2 t. c1 in list_type(t) -> c2 in list_type(t) -> b in omega -> abi.code_at(vm, b, seq_concat(c1, c2)) ->
  abi.code_at(vm, b, c1) && abi.code_at(vm, int_add(b, seq_len(c1)), c2)
proof
  fix vm b c1 c2 t
  assume h1 h2 hb hc
  have cc := expand(hc, abi.code_at)
  have n1: seq_len(c1) in omega by simp(h1)
  have n2: seq_len(c2) in omega by simp(h2)
  have ln: seq_len(seq_concat(c1, c2)) = int_add(seq_len(c1), seq_len(c2)) by arith(h1, h2)
  have g1: all i. i in omega -> int_lt(i, seq_len(c1)) ->
      ((x86_64_linux.fetchable(vm, bits_of_int(64, int_add(b, i))) && !x86_64_linux.can_access(vm, bits_of_int(64, int_add(b, i)), 1)) &&
        !abi.stack_page(vm, x86_64_linux.page_of(bits_of_int(64, int_add(b, i))))) && vm.bytes[bits_of_int(64, int_add(b, i))] = c1[i] proof
    fix i
    assume hi hl
    have l2: int_lt(i, seq_len(seq_concat(c1, c2))) by arith(hl, ln, n2, hi)
    have ci := mp(all_elim(cc, {i}), hi, l2)
    have e := at({seq_concat(c1, c2)[i]}, h1, h2, hi, hl)
    show by simp(ci, e)
  qed
  have g2: all i. i in omega -> int_lt(i, seq_len(c2)) ->
      ((x86_64_linux.fetchable(vm, bits_of_int(64, int_add(int_add(b, seq_len(c1)), i))) && !x86_64_linux.can_access(vm, bits_of_int(64, int_add(int_add(b, seq_len(c1)), i)), 1)) &&
        !abi.stack_page(vm, x86_64_linux.page_of(bits_of_int(64, int_add(int_add(b, seq_len(c1)), i))))) &&
      vm.bytes[bits_of_int(64, int_add(int_add(b, seq_len(c1)), i))] = c2[i] proof
    fix i
    assume hi hl
    have jo: int_add(seq_len(c1), i) in omega by simp(n1, hi)
    have l2: int_lt(int_add(seq_len(c1), i), seq_len(seq_concat(c1, c2))) by arith(hl, ln, n1, hi)
    have ci := mp(all_elim(cc, {int_add(seq_len(c1), i)}), jo, l2)
    have e0 := at({seq_concat(c1, c2)[int_add(seq_len(c1), i)]}, h1, h2, hi, hl, n1)
    have k: int_sub(int_add(seq_len(c1), i), seq_len(c1)) = i by arith(hi, n1)
    have e := rewrite(k, e0)
    have ad: int_add(b, int_add(seq_len(c1), i)) = int_add(int_add(b, seq_len(c1)), i) by arith(hb, n1, hi)
    have ci2 := rewrite(ad, ci)
    show by simp(ci2, e)
  qed
  have r1: abi.code_at(vm, b, c1) by defs(g1, abi.code_at)
  have r2: abi.code_at(vm, int_add(b, seq_len(c1)), c2) by defs(g2, abi.code_at)
  show by taut(r1, r2)
qed

// ... and so the program with its statics
theorem tr.loaded_concat: all vm b c1 c2 t st. c1 in list_type(t) -> c2 in list_type(t) -> b in omega -> abi.loaded(vm, b, seq_concat(c1, c2), st) ->
  abi.loaded(vm, b, c1, st) && abi.loaded(vm, int_add(b, seq_len(c1)), c2, st)
proof
  fix vm b c1 c2 t st
  assume h1 h2 hb hl
  have l := expand(hl, abi.loaded)
  have cc := apply(tr.code_concat, {vm}, {b}, {c1}, {c2}, {t}, h1, h2, hb, taut(l))
  show by defs(taut(l, cc), abi.loaded)
qed

// (a byte string's list: its length the string's)
theorem tr.bytes_seq_len: all b. seq_len(bytes_seq(b)) = bytes_len(b)
proof
  fix b
  have m: all i. i in bytes_len(b) -> bytes_at(b, i) in set_image(bytes_len(b), j. bytes_at(b, j)) proof
    fix i
    assume hi
    have si := set_image_def[s := bytes_len(b), f := j. bytes_at(b, j), y := bytes_at(b, i)]
    have ex: ex j. j in bytes_len(b) && bytes_at(b, j) = bytes_at(b, i) by ex_intro({i}, taut(hi, refl({bytes_at(b, i)})))
    show by taut(si, ex)
  qed
  have sp := mp(fn_build_space[d := bytes_len(b), v := i. bytes_at(b, i), b := set_image(bytes_len(b), j. bytes_at(b, j))], m)
  have fd: dom(fn_build(bytes_len(b), i. bytes_at(b, i))) = bytes_len(b) by simp(expand(sp, fn_space))
  show by defs(fd, seq_len, bytes_seq)
qed

// code loaded as a byte string: a slice of it at its place (bytes C
// at offset off of B)
theorem tr.code_slice: all vm b B C off. b in omega -> off in omega -> bytes_len(B) in omega -> bytes_len(C) in omega ->
  int_le(int_add(off, bytes_len(C)), bytes_len(B)) ->
  (all i. i in bytes_len(C) -> bytes_at(B, int_add(off, i)) = bytes_at(C, i)) ->
  abi.code_at(vm, b, bytes_seq(B)) -> abi.code_at(vm, int_add(b, off), bytes_seq(C))
proof
  fix vm b B C off
  assume hb ho nb nc hle hs hc
  have cc := expand(hc, abi.code_at)
  have g: all i. i in omega -> int_lt(i, seq_len(bytes_seq(C))) ->
      ((x86_64_linux.fetchable(vm, bits_of_int(64, int_add(int_add(b, off), i))) && !x86_64_linux.can_access(vm, bits_of_int(64, int_add(int_add(b, off), i)), 1)) &&
        !abi.stack_page(vm, x86_64_linux.page_of(bits_of_int(64, int_add(int_add(b, off), i))))) &&
      vm.bytes[bits_of_int(64, int_add(int_add(b, off), i))] = bytes_seq(C)[i] proof
    fix i
    assume hi hl
    have lc: int_lt(i, bytes_len(C)) by simp(hl, tr.bytes_seq_len)
    have jo: int_add(off, i) in omega by simp(ho, hi)
    have lj0: int_lt(int_add(off, i), bytes_len(B)) by arith(hle, lc, hi, ho, nb, nc)
    have lj: int_lt(int_add(off, i), seq_len(bytes_seq(B))) by simp(lj0, tr.bytes_seq_len)
    have ci := mp(all_elim(cc, {int_add(off, i)}), jo, lj)
    have ad: int_add(b, int_add(off, i)) = int_add(int_add(b, off), i) by arith(hb, ho, hi)
    have mb: int_add(off, i) in bytes_len(B) by arith(lj0, jo, nb)
    have mc: i in bytes_len(C) by arith(lc, hi, nc)
    have e := mp(all_elim(hs, {i}), mc)
    have eb: bytes_seq(B)[int_add(off, i)] = bytes_at(B, int_add(off, i))
      by defs(mp(app_fn_build[d := bytes_len(B), v := k. bytes_at(B, k), a := int_add(off, i)], mb), bytes_seq)
    have ec: bytes_seq(C)[i] = bytes_at(C, i) by defs(mp(app_fn_build[d := bytes_len(C), v := k. bytes_at(C, k), a := i], mc), bytes_seq)
    show by simp(rewrite(ad, ci), e, eb, ec)
  qed
  show by defs(g, abi.code_at)
qed

theorem tr.loaded_slice: all vm b B C off st. b in omega -> off in omega -> bytes_len(B) in omega -> bytes_len(C) in omega ->
  int_le(int_add(off, bytes_len(C)), bytes_len(B)) ->
  (all i. i in bytes_len(C) -> bytes_at(B, int_add(off, i)) = bytes_at(C, i)) ->
  abi.loaded(vm, b, bytes_seq(B), st) -> abi.loaded(vm, int_add(b, off), bytes_seq(C), st)
proof
  fix vm b B C off st
  assume hb ho nb nc hle hs hl
  have l := expand(hl, abi.loaded)
  have c := apply(tr.code_slice, {vm}, {b}, {B}, {C}, {off}, hb, ho, nb, nc, hle, hs, taut(l))
  show by defs(taut(l, c), abi.loaded)
qed

// (code bytes: a list of the bytes it has, or of more)
theorem tr.bytes_list: all b t. (all i. i in bytes_len(b) -> bytes_at(b, i) in t) -> bytes_len(b) in omega -> bytes_seq(b) in list_type(t)
proof
  fix b t
  assume h hn
  have l := mp(mp(build_list[d := bytes_len(b), v := i. bytes_at(b, i), t := t], hn), h)
  show by defs(l, bytes_seq)
qed

// ----------------------------------------------------------------------
//  Lists of code: concatenated, peeled (the program text's pieces)

// (a pair in a list: its index below the length)
theorem tr.list_idx: all l t i x. l in list_type(t) -> pair(i, x) in l -> i in omega && int_lt(i, seq_len(l)) && x in t
proof
  fix l t i x
  assume hl hp
  have sub: subset(l, cart(omega, t)) by taut(powerset_def[s := cart(omega, t), a := l], simp(expand(hl, list_type, seq_type)))
  have c := mp(subset_elim[a := l, b := cart(omega, t), z := pair(i, x)], sub, hp)
  obtain i2 x2, hi hx he from mp(cart_elim[a := omega, b := t, z := pair(i, x)], c)
  have e1: i = i2 && x = x2 by simp(he)
  have io: i in omega by simp(e1, hi)
  have xt: x in t by simp(e1, hx)
  have dm: i in dom(l) proof
    have si := set_image_def[s := l, f := z. fst(z), y := i]
    have ex1: ex z. z in l && fst(z) = i by ex_intro({pair(i, x)}, simp(hp))
    show by defs(taut(si, ex1), dom)
  qed
  have lo: dom(l) in omega by simp(expand(hl, list_type))
  have lt: int_lt(i, seq_len(l)) by defs(arith(dm, lo, io), seq_len)
  show conj(io, lt, xt)
qed

// (two lists, one after the other: a list)
theorem tr.concat_list: all a b t. a in list_type(t) -> b in list_type(t) -> seq_concat(a, b) in list_type(t)
proof
  fix a b t
  assume ha hb
  let C := seq_concat(a, b)
  have mem: all z. z in C -> z in a || (ex y. y in b && z = pair(int_add(dom(a), fst(y)), snd(y))) proof
    fix z
    assume hz
    have u := union2_iff[a := a, b := set_image(b, y. pair(int_add(dom(a), fst(y)), snd(y))), z := z]
    have si := set_image_def[s := b, f := y. pair(int_add(dom(a), fst(y)), snd(y)), y := z]
    have hz2: z in union2(a, set_image(b, y. pair(int_add(dom(a), fst(y)), snd(y)))) by defs(hz, seq_concat)
    have c: z in a || (ex y. y in b && pair(int_add(dom(a), fst(y)), snd(y)) = z) by taut(u, si, hz2)
    have c2: (ex y. y in b && pair(int_add(dom(a), fst(y)), snd(y)) = z) -> (ex y. y in b && z = pair(int_add(dom(a), fst(y)), snd(y))) proof
      assume e
      obtain y, hy ey from e
      show by ex_intro({y}, conj(hy, sym(ey)))
    qed
    show by taut(c, c2)
  qed
  have lao: dom(a) in omega by simp(expand(ha, list_type))
  // (each element: a pair (i, x), i natural, x in t; from a: i below dom(a), from b: at or above)
  have el: all z. z in C -> ex i x. z = pair(i, x) && i in omega && x in t && ((pair(i, x) in a && int_lt(i, dom(a))) || int_le(dom(a), i)) proof
    fix z
    assume hz
    have m := mp(all_elim(mem, {z}), hz)
    have k1: z in a -> ex i x. z = pair(i, x) && i in omega && x in t && ((pair(i, x) in a && int_lt(i, dom(a))) || int_le(dom(a), i)) proof
      assume hza
      have sub: subset(a, cart(omega, t)) by taut(powerset_def[s := cart(omega, t), a := a], simp(expand(ha, list_type, seq_type)))
      have c := mp(subset_elim[a := a, b := cart(omega, t), z := z], sub, hza)
      obtain i x, hi hx he from mp(cart_elim[a := omega, b := t, z := z], c)
      have pa := rewrite(he, hza)
      have li := apply(tr.list_idx, ha, pa)
      have lt: int_lt(i, dom(a)) by defs(li.2, seq_len)
      show by ex_intro({i}, {x}, taut(he, hi, hx, pa, lt))
    qed
    have k2: (ex y. y in b && z = pair(int_add(dom(a), fst(y)), snd(y))) -> ex i x. z = pair(i, x) && i in omega && x in t && ((pair(i, x) in a && int_lt(i, dom(a))) || int_le(dom(a), i)) proof
      assume e
      obtain y, hy ez from e
      have subb: subset(b, cart(omega, t)) by taut(powerset_def[s := cart(omega, t), a := b], simp(expand(hb, list_type, seq_type)))
      have c := mp(subset_elim[a := b, b := cart(omega, t), z := y], subb, hy)
      obtain j x, hj hx ey from mp(cart_elim[a := omega, b := t, z := y], c)
      have ez2: z = pair(int_add(dom(a), j), x) by simp(ez, ey)
      have io: int_add(dom(a), j) in omega by arith(lao, hj)
      have ge: int_le(dom(a), int_add(dom(a), j)) by arith(lao, hj)
      show by ex_intro({int_add(dom(a), j)}, {x}, taut(ez2, io, hx, ge))
    qed
    show by taut(m, k1, k2)
  qed
  // (a pair of C at or above dom(a): b's, shifted)
  have hi: all i x. pair(i, x) in C -> int_le(dom(a), i) -> pair(int_sub(i, dom(a)), x) in b proof
    fix i x
    assume hp hge
    have m := mp(all_elim(mem, {pair(i, x)}), hp)
    have k1: pair(i, x) in a -> pair(int_sub(i, dom(a)), x) in b proof
      assume hpa
      have li := apply(tr.list_idx, ha, hpa)
      have f: false by arith(expand(li.2, seq_len), hge)
      show by taut(f)
    qed
    have k2: (ex y. y in b && pair(i, x) = pair(int_add(dom(a), fst(y)), snd(y))) -> pair(int_sub(i, dom(a)), x) in b proof
      assume e
      obtain y, hy ey from e
      have subb: subset(b, cart(omega, t)) by taut(powerset_def[s := cart(omega, t), a := b], simp(expand(hb, list_type, seq_type)))
      have c := mp(subset_elim[a := b, b := cart(omega, t), z := y], subb, hy)
      obtain j x2, hj hx ey2 from mp(cart_elim[a := omega, b := t, z := y], c)
      have e3: i = int_add(dom(a), j) && x = x2 by simp(rewrite(ey2, ey))
      have ia: int_add(dom(a), j) in omega by arith(lao, hj)
      have io: i in omega := rewrite(sym(e3.1), ia)
      have ij: int_sub(i, dom(a)) = j by arith(e3, lao, hj, io)
      have yy: y = pair(int_sub(i, dom(a)), x) by simp(ey2, ij, e3)
      show := rewrite(yy, hy)
    qed
    show by taut(m, k1, k2)
  qed
  have fb: all p q r. pair(p, q) in b -> pair(p, r) in b -> q = r by simp(expand(hb, list_type, seq_type, is_seq, is_fun))
  have fa: all p q r. pair(p, q) in a -> pair(p, r) in a -> q = r by simp(expand(ha, list_type, seq_type, is_seq, is_fun))
  have f1: all z. z in C -> (ex p q. z = pair(p, q)) proof
    fix z
    assume hz
    obtain i x, ez .. from mp(all_elim(el, {z}), hz)
    show by ex_intro({i}, {x}, ez)
  qed
  have f2: all p q r. pair(p, q) in C -> pair(p, r) in C -> q = r proof
    fix p q r
    assume h1 h2
    obtain i1 x1, e1 io1 xt1 w1 from mp(all_elim(el, {pair(p, q)}), h1)
    obtain i2 x2, e2 io2 xt2 w2 from mp(all_elim(el, {pair(p, r)}), h2)
    have pi: p = i1 && q = x1 by simp(e1)
    have pj: p = i2 && r = x2 by simp(e2)
    have lo: int_lt(p, dom(a)) -> q = r proof
      assume hl
      have a1: pair(p, q) in a by simp(w1, pi, hl)
      have a2: pair(p, r) in a by simp(w2, pj, hl)
      show := mp(all_elim(fa, {p}, {q}, {r}), a1, a2)
    qed
    have up: int_le(dom(a), p) -> q = r proof
      assume hl
      have b1 := mp(all_elim(hi, {p}, {q}), h1, hl)
      have b2 := mp(all_elim(hi, {p}, {r}), h2, hl)
      show := mp(all_elim(fb, {int_sub(p, dom(a))}, {q}, {r}), b1, b2)
    qed
    have cs: int_lt(p, dom(a)) || int_le(dom(a), p) by arith(lao, io1, pi)
    show by taut(cs, lo, up)
  qed
  have fu: is_fun(C) by defs(conj(f1, f2), is_fun)
  have ss: all z. z in C -> z in cart(omega, t) proof
    fix z
    assume hz
    obtain i x, ez io xt .. from mp(all_elim(el, {z}), hz)
    have c := mp(mp(cart_intro[a := omega, b := t, x := i, y := x], io), xt)
    show := rewrite(sym(ez), c)
  qed
  have sb: subset(C, cart(omega, t)) by defs(ss, subset)
  have pw: C in powerset(cart(omega, t)) by taut(powerset_def[s := cart(omega, t), a := C], sb)
  have lc: seq_len(C) = int_add(seq_len(a), seq_len(b)) by arith(ha, hb)
  have lbo: seq_len(b) in omega by defs(simp(expand(hb, list_type)), seq_len)
  have dc: dom(C) in omega by arith(expand(lc, seq_len), lao, expand(lbo, seq_len))
  show by defs(simp(pw, fu, dc), list_type, seq_type, is_seq)
qed

// (a list of elements of t: of any superset)
theorem tr.list_mono: all l t u. l in list_type(t) -> subset(t, u) -> l in list_type(u)
proof
  fix l t u
  assume hl hs
  have sub: subset(l, cart(omega, t)) by taut(powerset_def[s := cart(omega, t), a := l], simp(expand(hl, list_type, seq_type)))
  have g: all z. z in l -> z in cart(omega, u) proof
    fix z
    assume hz
    have c := mp(subset_elim[a := l, b := cart(omega, t), z := z], sub, hz)
    obtain i x, hi hx he from mp(cart_elim[a := omega, b := t, z := z], c)
    have xu := mp(subset_elim[a := t, b := u, z := x], hs, hx)
    have c2 := mp(mp(cart_intro[a := omega, b := u, x := i, y := x], hi), xu)
    show := rewrite(sym(he), c2)
  qed
  have sb: subset(l, cart(omega, u)) by defs(g, subset)
  have pw: l in powerset(cart(omega, u)) by taut(powerset_def[s := cart(omega, u), a := l], sb)
  show by defs(simp(pw, expand(hl, list_type, seq_type, is_seq)), list_type, seq_type, is_seq)
qed

// (a byte string's list: of its bytes)
theorem tr.bytes_list_img: all b. bytes_len(b) in omega -> bytes_seq(b) in list_type(set_image(bytes_len(b), i. bytes_at(b, i)))
proof
  fix b
  assume hb
  have m: all i. i in bytes_len(b) -> bytes_at(b, i) in set_image(bytes_len(b), j. bytes_at(b, j)) proof
    fix i
    assume hi
    have si := set_image_def[s := bytes_len(b), f := j. bytes_at(b, j), y := bytes_at(b, i)]
    have ex: ex j. j in bytes_len(b) && bytes_at(b, j) = bytes_at(b, i) by ex_intro({i}, taut(hi, refl({bytes_at(b, i)})))
    show by taut(si, ex)
  qed
  show := apply(tr.bytes_list, {b}, {set_image(bytes_len(b), j. bytes_at(b, j))}, m, hb)
qed

// (subsets of a union)
theorem tr.sub_union_l: all a b. subset(a, union2(a, b))
proof
  fix a b
  have g: all z. z in a -> z in union2(a, b) proof
    fix z
    assume h
    show by taut(union2_iff[a := a, b := b, z := z], h)
  qed
  show by defs(g, subset)
qed

theorem tr.sub_union_r: all a b. subset(b, union2(a, b))
proof
  fix a b
  have g: all z. z in b -> z in union2(a, b) proof
    fix z
    assume h
    show by taut(union2_iff[a := a, b := b, z := z], h)
  qed
  show by defs(g, subset)
qed

// (two lists of different elements, concatenated: a list of either's)
theorem tr.concat_list2: all a b t1 t2. a in list_type(t1) -> b in list_type(t2) -> seq_concat(a, b) in list_type(union2(t1, t2))
proof
  fix a b t1 t2
  assume ha hb
  have a2 := apply(tr.list_mono, ha, all_elim(tr.sub_union_l, {t1}, {t2}))
  have b2 := apply(tr.list_mono, hb, all_elim(tr.sub_union_r, {t1}, {t2}))
  show := apply(tr.concat_list, a2, b2)
qed

// code loaded as two pieces (lists of any elements): the first, the second at its place
theorem tr.peel_left: all vm b x p t1 t2 st. x in list_type(t1) -> p in list_type(t2) -> b in omega -> abi.loaded(vm, b, seq_concat(x, p), st) -> abi.loaded(vm, b, x, st)
proof
  fix vm b x p t1 t2 st
  assume hx hp hb h
  have x2 := apply(tr.list_mono, hx, all_elim(tr.sub_union_l, {t1}, {t2}))
  have p2 := apply(tr.list_mono, hp, all_elim(tr.sub_union_r, {t1}, {t2}))
  show := apply(tr.loaded_concat, x2, p2, hb, h).1
qed

theorem tr.peel_right: all vm b x p t1 t2 st. x in list_type(t1) -> p in list_type(t2) -> b in omega -> abi.loaded(vm, b, seq_concat(x, p), st) -> abi.loaded(vm, int_add(b, seq_len(x)), p, st)
proof
  fix vm b x p t1 t2 st
  assume hx hp hb h
  have x2 := apply(tr.list_mono, hx, all_elim(tr.sub_union_l, {t1}, {t2}))
  have p2 := apply(tr.list_mono, hp, all_elim(tr.sub_union_r, {t1}, {t2}))
  show := apply(tr.loaded_concat, x2, p2, hb, h).2
qed

// (a byte string of bytes: a sequence of bytes -- a file)
theorem tr.bytes_seq_type: all b. (all i. i in bytes_len(b) -> bytes_at(b, i) in bits(8)) -> bytes_len(b) in omega -> bytes_seq(b) in seq_type(bits(8))
proof
  fix b
  assume h hn
  have l := apply(tr.bytes_list, {b}, {bits(8)}, h, hn)
  show by simp(unsel(expand(l, list_type)))
qed

// (a code piece defined as a byte string: a list of its bytes)
theorem tr.code_list: all c b. c = bytes_seq(b) -> bytes_len(b) in omega -> c in list_type(set_image(bytes_len(b), i. bytes_at(b, i)))
proof
  fix c b
  assume e hb
  show := rewrite(sym(e), apply(tr.bytes_list_img, hb))
qed
