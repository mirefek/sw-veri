        have hk := mp(all_elim(expand(ha0, tr.hacc), {k}), k1, k2)
        have sp0 := rewrite(e, hk.2)
        have l1: int_le(R, int_add(int_sub(S, int_sub(18446744073709551616, c)), k)) by arith(er4, cl, k1, c64)
        have nd: !(int_add(int_sub(S, int_sub(18446744073709551616, c)), k) in ds) := mp(all_elim(mp(all_elim(expand(apply(tr.hap_get, hap, hh), tr.hapart), {c}), hc), {k}), k1, k2)
        have xbb: int_add(int_sub(S, int_sub(18446744073709551616, c)), k) in bits(64) by simp(xo, xl, sb)
        have r := mp(all_elim(xb, {int_add(int_sub(S, int_sub(18446744073709551616, c)), k)}), xbb, l1, nd, sp0)
