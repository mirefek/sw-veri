      have ls := apply(tr.le_same, {XV.bytes}, {m.vm.bytes}, {bits_add(64, int_add(S, c), 0)}, {fst(hs[c])}, no, by)
      have ac: tr.hacc(s, XV, c, fst(hs[c])) proof
        have g2: all i. i in omega -> int_lt(i, fst(hs[c])) ->
            x86_64_linux.can_access(XV, bits_add(64, tr.ha(s, c), bits_of_int(64, i)), 1) && abi.stack_page(XV, int_div(bits_add(64, tr.ha(s, c), bits_of_int(64, i)), 4096)) proof
          fix i
