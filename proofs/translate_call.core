  // the invariant
  have x4: x.gpr[4] = int_sub(S, fr) := trans(xr4, trans(spc, er4))
  have kpx: tr.kept(s.vm, XV, S) proof
    have g: all a. a in omega -> int_le(S, a) -> int_lt(a, int_add(S, 8)) ->
