    show by defs(taut(h), tr.frame)
  qed
  // the homes: their bytes kept (at or above R, on m's stack pages), accessible
  have homx: tr.homes(s, x, hs) proof
    have g: all c. c in dom(hs) ->
        x86_64_linux.le(XV.bytes, bits_add(64, int_add(S, c), 0), fst(hs[c])) = snd(hs[c]) &&
        tr.hrange(c, fst(hs[c])) && tr.hacc(s, XV, c, fst(hs[c])) proof
      fix c
      assume hc
      have hv hr ha0 := mp(all_elim(expand(hh, tr.homes), {c}), hc)
      have cl := mp(all_elim(expand(hin, tr.hin), {c}), hc)
