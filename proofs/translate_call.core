      fix j
      assume j1 j2
      have rb2 := apply(tr.ret_range, {S}, {j}, sb, slt, j1, j2)
      have pn := apply(tr.page_ret, {S}, {bits_add(64, S, bits_of_int(64, j))}, sb, sal, rb2.2, rb2.3)
      have k2 := apply(tr.inv_stack, {s}, {base}, {code}, {fr}, {m}, {w}, {ds}, {P0}, hi, hmm, p0o, hsps, (int_le(P0, P0) by arith(p0o)))
      have spm: abi.stack_page(m.vm, P0) by defs(simp(k2, expand(hsps, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
      have sp1: abi.stack_page(m.vm, int_div(bits_add(64, S, bits_of_int(64, j)), 4096)) := rewrite(sym(pn), spm)
