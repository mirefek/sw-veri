// A call in the translation (docs/bridge-pattern-design.md, step 8): the
// machine's `call` against readable GIMPLE's call_at -- the push (a fault:
// a crash or GIMPLE's undefined call), the callee's contract
// (tr.implements_at) on its entry state, the caller's run split at the
// callee's return (tr.run_split), and the claim after the call.
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core core/records.core \
//     core/list.core core/loop.core build/c_mallocng_malloc.core proofs/x86.core proofs/x86_code.core \
//     proofs/x86_stack.core proofs/x86_insn.core proofs/abi.core proofs/abi_restore.core proofs/abi_glue.core \
//     proofs/gimple.core proofs/gimple_call.core proofs/abi_stack.core proofs/abi_loop.core proofs/abi_bridge.core \
//     proofs/translate.core proofs/translate_store_loop.core proofs/translate_call.core

// ----------------------------------------------------------------------
//  Generic pieces

// a step that may fault: its successors' claims, and every fault a crash
// or undefined
theorem tr.step_x(s, v, p, w, m, x. q, x y. qx): (all o. runs(x86_64_linux.step(), m, o) -> (ex m2. o = ok(m2, empty) && q(m2)) || (ex x e. o = exc(x, e) && qx(x, e))) ->
  int_lt(app(app(m, "gpr"), 4), abi.sp(s)) -> (all m2. q(m2) -> tr.sim(s, v, p, w, m2)) ->
  (all x e. qx(x, e) -> tr.ub(s, v, p, w) || tr.crash(s, p, w, exc(x, e))) -> tr.sim(s, v, p, w, m)
proof
  assume hs hlt h hx
  have hn0: app(app(m, "gpr"), 4) = abi.sp(s) -> false proof
    assume e
    have l2 := rewrite(e, hlt)
    show by arith(l2)
  qed
  have hn: !(app(m, "rip") = abi.ret(s) && app(app(m, "gpr"), 4) = abi.sp(s)) by taut(hn0)
  have dok: tr.disc_ok(s, fst(pair(m, empty))) by simp(hlt)
  have hbd: all r. tr.rbd(s, pair(m, empty), r) -> tr.rb(s, pair(m, empty), r) proof
    fix r
    assume hb
    show by taut(expand(hb, tr.rbd), dok)
  qed
  // the pass from m: a step to some m2 with q, or a fault
  have hb_ok: all l1. tr.rb(s, pair(m, empty), ok(l1, empty)) -> (ex m2. l1 = pair(m2, empty) && q(m2)) proof
    fix l1
    assume hb
    have b1: ex x1. runs(x86_64_linux.step(), m, x1) && (ex x2 x3. x1 = ok(x2, x3) && l1 = pair(x2, empty)) by simp(expand(hb, tr.rb), hn, keep(x86_64_linux.step))
    obtain x1, c1 from b1
    have e := mp(all_elim(hs, {x1}), taut(c1))
    have c2: (ex x e. x1 = exc(x, e) && qx(x, e)) -> false proof
      assume ex
      obtain x e3, ex3 from ex
      show by simp(c1, ex3, keep(x86_64_linux.step))
    qed
    have e1: ex m2. x1 = ok(m2, empty) && q(m2) by taut(e, c2)
    obtain m2, e2 from e1
    have l1e: l1 = pair(m2, empty) by simp(c1, e2, keep(x86_64_linux.step))
    show by ex_intro({m2}, taut(l1e, e2))
  qed
  have hb_nok: all r. tr.rb(s, pair(m, empty), r) -> !is_ok(r) -> (ex x e. r = exc(pair(x, empty), pair("raise", e)) && qx(x, e)) proof
    fix r
    assume hb hn2
    have b1: ex x1. runs(x86_64_linux.step(), m, x1) && ((ex x2 x3. x1 = ok(x2, x3) && r = ok(pair(x2, empty), empty)) ||
      (ex x2 x3. x1 = exc(x2, x3) && r = exc(pair(x2, empty), pair("raise", x3))) || (ex x2. x1 = diverge(x2) && r = diverge(x2))) by simp(expand(hb, tr.rb), hn, keep(x86_64_linux.step))
    obtain x1, c1 from b1
    have e := mp(all_elim(hs, {x1}), taut(c1))
    have k1: (ex m2. x1 = ok(m2, empty) && q(m2)) -> (ex x e. r = exc(pair(x, empty), pair("raise", e)) && qx(x, e)) proof
      assume ek
      obtain m2, e2 from ek
      show by simp(c1, e2, hn2, keep(x86_64_linux.step))
    qed
    have k2: (ex x e. x1 = exc(x, e) && qx(x, e)) -> (ex x e. r = exc(pair(x, empty), pair("raise", e)) && qx(x, e)) proof
      assume ek
      obtain x e3, ek3 from ek
      have re: r = exc(pair(x, empty), pair("raise", e3)) by simp(c1, ek3, keep(x86_64_linux.step))
      show by ex_intro({x}, {e3}, taut(re, ek3.2))
    qed
    show by taut(e, k1, k2)
  qed
  have hk: all m2 r o2. q(m2) -> tr.rwd(s, pair(m2, empty), r) -> tr.rmap(r, o2) -> tr.ub(s, v, p, w) || tr.ok(s, p, w, o2) || tr.crash(s, p, w, o2) proof
    fix m2 r o2
    assume hq hw hm
    have rf: tr.run_d(s, m2, o2) by defs(ex_intro({r}, taut(hw, hm)), tr.run_d)
    show := mp(all_elim(expand(mp(all_elim(h, {m2}), hq), tr.sim), {o2}), rf)
  qed
  have g: all o. tr.run_d(s, m, o) -> tr.ub(s, v, p, w) || tr.ok(s, p, w, o) || tr.crash(s, p, w, o) proof
    fix o
    assume ho
    obtain x4, hw hm from expand(ho, tr.run_d)
    let W(l, r) := while_rel(l, x5. true, x5 x6. tr.rbd(s, x5, x6), x5. fn_update(empty, "os.events", app(app(fst(x5), "os"), "events")), r)
    have u := mp(while_unroll[l0 := pair(m, empty), c := l. true, b := l o. tr.rbd(s, l, o),
      tr := l. fn_update(empty, "os.events", app(app(fst(l), "os"), "events")), r := x4], expand(hw, tr.rwd))
    // (the first pass faults: the run's outcome that fault)
    have fl: tr.rbd(s, pair(m, empty), x4) && !is_ok(x4) -> tr.ub(s, v, p, w) || tr.ok(s, p, w, o) || tr.crash(s, p, w, o) proof
      assume hf
      have rb := mp(all_elim(hbd, {x4}), hf.1)
      have ef := mp(all_elim(hb_nok, {x4}), rb, hf.2)
      obtain x e, xe q3 from ef
      have hm2 := rewrite(xe, hm)
      have oe: o = exc(x, e) by simp(expand(hm2, tr.rmap))
      have c := mp(all_elim(hx, {x}, {e}), q3)
      have c2: tr.ub(s, v, p, w) || tr.ok(s, p, w, exc(x, e)) || tr.crash(s, p, w, exc(x, e)) by taut(c)
      show := rewrite(sym(oe), c2)
    qed
    // (the loop goes on from m2)
    have on: (ex l1. tr.rbd(s, pair(m, empty), ok(l1, empty)) && (ex r1. W(l1, r1) && fst(r1) = fst(x4) && (!(fst(x4) = 2) -> r1 = x4))) ->
        tr.ub(s, v, p, w) || tr.ok(s, p, w, o) || tr.crash(s, p, w, o) proof
      assume e
      obtain l1, rbd1 e1b from e
      have rb1 := mp(all_elim(hbd, {ok(l1, empty)}), rbd1)
      obtain m2, l1e hq from mp(all_elim(hb_ok, {l1}), rb1)
      obtain r1, w0 f4 re4 from e1b
      have w1: tr.rwd(s, pair(m2, empty), r1) by defs(rewrite(l1e, w0), tr.rwd)
      have same: !(fst(x4) = 2) -> tr.ub(s, v, p, w) || tr.ok(s, p, w, o) || tr.crash(s, p, w, o) proof
        assume nd
        have re := mp(re4, nd)
        show := mp(mp(mp(all_elim(hk, {m2}, {r1}, {o}), hq), w1), rewrite(sym(re), hm))
      qed
      have div: fst(x4) = 2 -> tr.ub(s, v, p, w) || tr.ok(s, p, w, o) || tr.crash(s, p, w, o) proof
        assume d
        have d1: fst(r1) = 2 by simp(f4, d)
        have c := mp(mp(mp(all_elim(hk, {m2}, {r1}, {diverge(snd(r1))}), hq), w1), defs(simp(d1), tr.rmap))
        have nk := all_elim(tr.ok_not_div, {s}, {p}, {w}, {snd(r1)})
        have nc := all_elim(tr.crash_not_div, {s}, {p}, {w}, {snd(r1)})
        show by taut(c, nk, nc)
      qed
      show by taut(same, div)
    qed
    show by taut(u, on, fl)
  qed
  show by defs(g, tr.sim)
qed

// an operation that changes the world: the spec's rest from its result
theorem tr.qs_call(op, w4, r, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k): all w. w in univ(1) -> runs(op, w, ok(w4, r)) ->
  (all o. runs(mkprog(x0 x1. ex x8. a(x0, r, x8) && k(x8, x1)), w4, o) ->
    runs(mkprog(x0 x1. ex x8. bind_rel(op, x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), w, o))
proof
  fix w
  assume hwu hq
  fix o
  assume h0
  have hu: pair(w4, o) in univ(1) && (ex x8. a(w4, r, x8) && k(x8, o)) by simp(expand(expand(h0, runs), mkprog))
  have pu: pair(w, o) in univ(1) by simp(hu, hwu)
  obtain y, hy from hu.2
  have ay := hy.1
  have e: ex o2. runs(op, w, o2) && ((ex s1 v. o2 = ok(s1, v) && a(s1, v, y)) || (ex s1 e. o2 = exc(s1, e) && xx(s1, e, y)) || (ex t. o2 = diverge(t) && dd(t, y)))
    by ex_intro({ok(w4, r)}, simp(hq, ay))
  have b: bind_rel(op, w, x9 x10. a(x9, x10, y), x9 x10. xx(x9, x10, y), x9. dd(x9, y)) by defs(e, bind_rel)
  have g: ex x8. bind_rel(op, w, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, o) by ex_intro({y}, taut(b, hy))
  show := mp(all_elim(tr.runs_intro[r := x0 x1. ex x8. bind_rel(op, x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)], {w}, {o}), pu, g)
qed

// the procedure's rest raising: the function raising
theorem tr.p_exc(q, x3 x4 x2. kw): all w x e. w in univ(1) -> x in univ(1) -> e in univ(1) -> runs(q, w, exc(x, e)) ->
  runs(mkprog(x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, exc(x, e))
proof
  fix w x e
  assume hw hx he hr
  have b0: ex o2. runs(q, w, o2) && ((ex s1 v. o2 = ok(s1, v) && kw(s1, v, exc(x, e))) || (ex s1 e1. o2 = exc(s1, e1) && exc(x, e) = exc(s1, e1)) ||
    (ex t. o2 = diverge(t) && exc(x, e) = diverge(t))) by ex_intro({exc(x, e)}, simp(hr))
  have b: bind_rel(q, w, x3 x4. kw(x3, x4, exc(x, e)), x3 x4. exc(x, e) = exc(x3, x4), x3. exc(x, e) = diverge(x3)) by defs(b0, bind_rel)
  have pu: pair(w, exc(x, e)) in univ(1) by simp(hw, hx, he)
  show := mp(all_elim(tr.runs_intro[r := x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))], {w}, {exc(x, e)}), pu, b)
qed

// ... at a call: the call raising
theorem tr.call_exc(g, args, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all w x e. w in univ(1) -> x in univ(1) -> e in univ(1) ->
  runs(gimple.call1(g, args), w, exc(x, e)) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e)) ->
  runs(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, exc(x, e))
proof
  fix w x e
  assume hw hx he hc hk
  have q := mp(all_elim(mp(all_elim(tr.qs_raise[op := gimple.call1(g, args), s2 := x, e := e, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1)], {w}), hc), {exc(x, e)}), hk)
  show := apply(tr.p_exc[q := mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), kw := x3 x4 x2. kw(x3, x4, x2)],
    {w}, {x}, {e}, hw, hx, he, q)
qed

// (a World, with no ghost part)
theorem tr.world_and: all w. w in abi.World -> w in rec_and(abi.World, single(empty))
proof
  fix w
  assume hw
  have r := mp(mp(rec_and_intro[a := abi.World, b := single(empty), x := w, y := empty], hw), simp())
  show by simp(r)
qed

// (a one-element list)
theorem tr.seq_one_type: all x t. x in t -> seq_one(x) in list_type(t)
proof
  fix x t
  assume hx
  have mem: all z. z in seq_one(x) -> z = pair(0, x) proof
    fix z
    assume hz
    show := mp(single_elim[a := pair(0, x), z := z], expand(hz, seq_one))
  qed
  have f1: all z. z in seq_one(x) -> (ex a b. z = pair(a, b)) proof
    fix z
    assume hz
    have e := mp(all_elim(mem, {z}), hz)
    show by ex_intro({0}, {x}, e)
  qed
  have f2: all a b c. pair(a, b) in seq_one(x) -> pair(a, c) in seq_one(x) -> b = c proof
    fix a b c
    assume h1 h2
    have e1 := mp(all_elim(mem, {pair(a, b)}), h1)
    have e2 := mp(all_elim(mem, {pair(a, c)}), h2)
    show by simp(e1, e2)
  qed
  have fu: is_fun(seq_one(x)) by defs(taut(f1, f2), is_fun)
  have ss: all z. z in seq_one(x) -> z in cart(omega, t) proof
    fix z
    assume hz
    have e := mp(all_elim(mem, {z}), hz)
    have c := mp(mp(cart_intro[a := omega, b := t, x := 0, y := x], simp()), hx)
    show := rewrite(sym(e), c)
  qed
  have sb: subset(seq_one(x), cart(omega, t)) by defs(ss, subset)
  have pw: seq_one(x) in powerset(cart(omega, t)) by taut(powerset_def[s := cart(omega, t), a := seq_one(x)], sb)
  have l1: seq_len(seq_one(x)) = 1 by arith()
  have l1d: dom(seq_one(x)) = 1 by defs(l1, seq_len)
  have o1: 1 in omega by simp()
  have d1: dom(seq_one(x)) in omega := rewrite(sym(l1d), o1)
  show by defs(simp(pw, fu, d1), list_type, seq_type, is_seq)
qed

// one argument, in a register
theorem tr.regs1: all u ar. u in bits(64) -> u in gimple.in_reg(fst(ar), snd(ar)) ->
  seq_one(u) in list_type(bits(64)) && seq_one(u) in univ(1) && seq_len(seq_one(u)) = seq_len(seq_one(ar)) &&
  (all i. i in omega -> int_lt(i, seq_len(seq_one(ar))) -> app(seq_one(u), i) in gimple.in_reg(fst(app(seq_one(ar), i)), snd(app(seq_one(ar), i))))
proof
  fix u ar
  assume hu hi
  have g: all i. i in omega -> int_lt(i, seq_len(seq_one(ar))) -> app(seq_one(u), i) in gimple.in_reg(fst(app(seq_one(ar), i)), snd(app(seq_one(ar), i))) proof
    fix i
    assume h1 h2
    have z: i = 0 by simp(h1, h2)
    have e1 := at({app(seq_one(u), 0)})
    have e2 := at({app(seq_one(ar), 0)})
    show by simp(z, hi, e1, e2)
  qed
  have l1: seq_len(seq_one(u)) = 1 by arith()
  have l2: seq_len(seq_one(ar)) = 1 by arith()
  have lt := apply(tr.seq_one_type, {u}, {bits(64)}, hu)
  have lu: seq_one(u) in univ(1) by defs(simp(hu), seq_one)
  show by simp(lt, lu, l1, l2, g)
qed

// GIMPLE's call undefined (the thread pointer or the stack unsound at the
// callee's frame vm1): the function's spec raises
theorem tr.call_ub(g, ar, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all s v w u sp2 vm1.
  w in univ(1) -> abi.view(v, s) in univ(1) -> u in bits(64) -> u in gimple.in_reg(fst(ar), snd(ar)) ->
  sp2 in bits(64) -> int_le(sp2, app(w, "sp")) -> int_mod(sp2, 16) = 0 ->
  vm1 in x86_64_linux.Vm -> vm1 in univ(1) -> gimple.frame_at_call(app(w, "vm"), vm1, sp2, app(w, "sp")) ->
  !(abi.thread_ok(vm1, app(w, "fs_base")) && abi.stack_ok(vm1, bits_sub(64, sp2, 8))) ->
  runs(mkprog(x0 x1. ex x8. xx(abi.view(v, s), empty, x8) && k(x8, x1)), w, exc(abi.view(v, s), empty)) ->
  tr.ub(s, v, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, seq_one(ar)), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w)
proof
  fix s v w u sp2 vm1
  assume hw hvu hu hi hs hl ha hv hv1 hf hn hk
  have eu: empty in univ(1) by simp()
  have r1 := apply(tr.regs1, {u}, {ar}, hu, hi)
  have en := apply(gc.enter_ub, {app(w, "sp")}, {app(w, "sp")}, {seq_one(ar)}, {w}, {seq_one(u)}, {sp2}, {vm1}, {abi.view(v, s)}, {empty},
    hw, hvu, eu, r1.1, r1.2, r1.3, r1.4, hs, hl, ha, hv, hv1, hf, hn)
  have ca := apply(gc.call_at_enter_exc, {app(w, "sp")}, {app(w, "sp")}, {g}, {seq_one(ar)}, {w}, {abi.view(v, s)}, {empty}, hw, hvu, eu, en)
  have c1 := apply(gc.call1_exc, {g}, {seq_one(ar)}, {w}, {abi.view(v, s)}, {empty}, hw, hvu, eu, ca)
  have pe := apply(tr.call_exc[g := g, args := seq_one(ar), a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)],
    {w}, {abi.view(v, s)}, {empty}, hw, hvu, eu, c1, hk)
  have eno: !(empty = exc_val("stack_overflow", empty)) by defs(all_elim(tr.pair_ne, {"stack_overflow"}, {empty}), exc_val)
  have rst: abi.raise_state(v, s, abi.view(v, s)) by defs(taut(refl({abi.view(v, s)})), abi.raise_state)
  show by defs(ex_intro({empty}, {abi.view(v, s)}, taut(eu, eno, rst, pe)), tr.ub)
qed

// ----------------------------------------------------------------------
//  The push of a call from a frame of 8 bytes: rsp S - 8 (S the entry's
//  rsp), the return address to the 8 bytes from S - 16 -- one page, at most
//  the one below S's

theorem tr.push_at: all S j. S in bits(64) -> int_le(16, S) -> int_lt(S, 140737488355328) -> int_mod(bits_add(64, S, 8), 16) = 0 ->
  j in omega -> int_lt(j, 8) ->
  bits_add(64, bits_sub(64, int_sub(S, 8), 8), bits_of_int(64, j)) = int_add(int_sub(S, 16), j) &&
  int_div(int_add(int_sub(S, 16), j), 4096) = int_div(int_sub(S, 16), 4096)
proof
  fix S j
  assume hs h16 hl ha hj hj8
  have p64: pow2(64) = 18446744073709551616 by simp()
  have sb: int_le(0, S) && int_lt(S, 18446744073709551616) by simp(hs)
  have m1: int_mod(int_add(S, 8), 16) = 0 by simp(hs, ha, hl)
  have e0: int_mod(int_add(int_mod(int_sub(int_sub(S, 8), 8), 18446744073709551616), int_mod(j, 18446744073709551616)), 18446744073709551616) = int_add(int_sub(S, 16), j)
    by arith(sb, h16, hl, hj, hj8)
  have e: bits_add(64, bits_sub(64, int_sub(S, 8), 8), bits_of_int(64, j)) = int_add(int_sub(S, 16), j) by defs(rewrite(sym(p64), e0), bits_add, bits_sub, bits_of_int)
  have m2: int_le(8, int_mod(int_sub(S, 16), 4096)) && int_le(int_mod(int_sub(S, 16), 4096), 4088) by simp(hs, m1, h16)
  have d: int_div(int_add(int_sub(S, 16), j), 4096) = int_div(int_sub(S, 16), 4096) by simp(hs, h16, m2, hj, hj8)
  show by taut(e, d)
qed

// (the page of S - 16: S's, or the one below; S's page holds S + 7)
theorem tr.push_pages: all S. S in bits(64) -> int_le(16, S) -> int_lt(S, 140737488355328) -> int_mod(bits_add(64, S, 8), 16) = 0 ->
  int_le(int_div(int_sub(S, 16), 4096), int_div(S, 4096)) && int_le(int_div(S, 4096), int_add(int_div(int_sub(S, 16), 4096), 1)) &&
  int_div(int_sub(bits_add(64, S, 8), 1), 4096) = int_div(S, 4096) && bits_add(64, S, 8) = int_add(S, 8)
proof
  fix S
  assume hs h16 hl ha
  have m1: int_mod(int_add(S, 8), 16) = 0 by simp(hs, ha, hl)
  have m2: int_le(8, int_mod(S, 4096)) && int_le(int_mod(S, 4096), 4088) by simp(hs, m1)
  have e8: bits_add(64, S, 8) = int_add(S, 8) by simp(hs, hl)
  have d1: int_le(int_div(int_sub(S, 16), 4096), int_div(S, 4096)) by simp(hs, h16)
  have d2: int_le(int_div(S, 4096), int_add(int_div(int_sub(S, 16), 4096), 1)) by simp(hs, h16, m2)
  have d3: int_div(int_sub(int_add(S, 8), 1), 4096) = int_div(S, 4096) by simp(hs, m2)
  show by simp(e8, d1, d2, d3)
qed

// the pushed bytes, at a fault for want of a mapping (the page of S - 16
// unmapped, S's a stack page): where the stack could not grow, rsp S - 8
theorem tr.push_overflow: all xv S j. S in bits(64) -> int_le(16, S) -> int_lt(S, 140737488355328) -> int_mod(bits_add(64, S, 8), 16) = 0 ->
  abi.stack_page(xv, int_div(S, 4096)) -> !x86_64_linux.mapped(xv, int_div(int_sub(S, 16), 4096)) -> j in omega -> int_lt(j, 8) ->
  abi.overflow_at(xv, int_sub(S, 8), bits_add(64, S, 8), int_add(int_sub(S, 16), j))
proof
  fix xv S j
  assume hs h16 hl ha hsp hnm hj hj8
  have _ pa2 := apply(tr.push_at, {S}, {j}, hs, h16, hl, ha, hj, hj8)
  have _ pp2 _ pp4 := apply(tr.push_pages, {S}, hs, h16, hl, ha)
  have so: S in omega by simp(hs)
  have p0: int_div(S, 4096) in omega by simp(so)
  have m1: int_mod(int_add(S, 8), 16) = 0 by simp(hs, ha, hl)
  have m2: int_le(8, int_mod(S, 4096)) && int_le(int_mod(S, 4096), 4088) by simp(hs, m1)
  have r8: int_div(int_sub(S, 8), 4096) = int_div(S, 4096) by simp(hs, m2, h16)
  have gp: all p. p in omega -> int_le(int_div(int_add(int_sub(S, 16), j), 4096), p) && int_le(p, int_div(int_sub(S, 8), 4096)) ->
      abi.stack_page(xv, p) || !x86_64_linux.mapped(xv, p) proof
    fix p
    assume hp h12
    have h1 h2 := h12
    have c1: p = int_div(S, 4096) -> abi.stack_page(xv, p) || !x86_64_linux.mapped(xv, p) proof
      assume e
      have r := rewrite(sym(e), hsp)
      show by taut(r)
    qed
    have c2: !(p = int_div(S, 4096)) -> abi.stack_page(xv, p) || !x86_64_linux.mapped(xv, p) proof
      assume ne
      have h2b := rewrite(r8, h2)
      have h1b := rewrite(pa2, h1)
      have pl: p = int_div(int_sub(S, 16), 4096) by arith(h2b, h1b, ne, pp2, hp, p0)
      have n := rewrite(sym(pl), hnm)
      show by taut(n)
    qed
    show by taut(c1, c2)
  qed
  have lt1: int_lt(int_add(int_sub(S, 16), j), int_add(S, 8)) by arith(hj8)
  have lt0 := rewrite(sym(pp4), lt1)
  show by defs(taut(lt0, gp), abi.overflow_at, x86_64_linux.PAGE)
qed

// (the coupled memories: the world's but for the machine's bytes)
theorem tr.mem_vm_eq: all s m w ds. app(m, "vm") in x86_64_linux.Vm -> tr.mem(s, m, w, ds) -> fn_update(app(w, "vm"), "bytes", app(app(m, "vm"), "bytes")) = app(m, "vm")
proof
  fix s m w ds
  assume hv h
  have vb := apply(abi.vm_bytes_same, hv)
  have c1: (!ds && app(w, "vm") = app(m, "vm")) -> fn_update(app(w, "vm"), "bytes", app(app(m, "vm"), "bytes")) = app(m, "vm") proof
    assume h1
    show by simp(h1.2, vb)
  qed
  show by taut(expand(h, tr.mem), c1)
qed

// GIMPLE's frame at a call from a world memory wv: its pages those grown
// by the push (from a memory v0 with wv's pages: in [L, R), L the return
// address slot's page, R's start at most hi)
theorem tr.frame_pages: all v0 xv wv sp2 hi l r. x86.pages_in(v0, xv, l, r) -> app(v0, "pages") = app(wv, "pages") ->
  l = int_div(int_sub(sp2, 8), 4096) -> r in omega -> int_le(int_mul(r, 4096), hi) ->
  gimple.frame_at_call(wv, fn_update(wv, "pages", app(xv, "pages")), sp2, hi)
proof
  fix v0 xv wv sp2 hi l r
  assume hp he hl hr hh
  have g: all p. p in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) ->
      app(app(xv, "pages"), p) = app(app(wv, "pages"), p) ||
      ((int_le(int_div(int_sub(sp2, 8), x86_64_linux.PAGE), p) && int_lt(int_mul(p, x86_64_linux.PAGE), hi)) && app(app(wv, "pages"), p) = none) proof
    fix p
    assume hpp
    have po: p in omega by simp(hpp)
    have a := mp(all_elim(expand(hp, x86.pages_in), {p}), po)
    have a2 := rewrite(he, a)
    have c: int_lt(p, r) -> int_lt(int_mul(p, 4096), hi) proof
      assume hlt
      show by arith(po, hr, hlt, hh)
    qed
    show by defs(simp(a2, hl, c), x86_64_linux.PAGE)
  qed
  show by defs(simp(g), gimple.frame_at_call)
qed

// (an access allowed or not: its page's entry only)
theorem tr.access_page: all v1 v2 a b k. x86_64_linux.page_of(a) = x86_64_linux.page_of(b) ->
  app(app(v1, "pages"), x86_64_linux.page_of(a)) = app(app(v2, "pages"), x86_64_linux.page_of(b)) ->
  (x86_64_linux.can_access(v1, a, k) <-> x86_64_linux.can_access(v2, b, k))
proof
  fix v1 v2 a b k
  assume hp he
  have he2 := rewrite(hp, he)
  show by defs(simp(hp, he2, keep(x86_64_linux.page_of)), x86_64_linux.can_access, x86_64_linux.mapped)
qed

// the call overflowing the stack first: the function overflows, with the
// world's I/O
theorem tr.call_ovf(g, args, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all w os.
  w in abi.World -> w in univ(1) -> app(app(w, "os"), "events") = app(os, "events") ->
  runs(mkprog(x0 x1. ex x8. xx(w, exc_val("stack_overflow", empty), x8) && k(x8, x1)), w, exc(w, exc_val("stack_overflow", empty))) ->
  tr.ovf(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, os)
proof
  fix w os
  assume hW hw hev hk
  have ou: exc_val("stack_overflow", empty) in univ(1) by defs(simp(), exc_val)
  have c1 := apply(gc.call1_ovf, {g}, {args}, {w}, hw)
  have pe := apply(tr.call_exc[g := g, args := args, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)],
    {w}, {w}, {exc_val("stack_overflow", empty)}, hw, hw, ou, c1, hk)
  have wa := apply(tr.world_and, hW)
  have ot := mp(mp(exc_outcome_type[s := rec_and(abi.World, single(empty)), v := cart(bits(64), bits(64)), x := w, e := exc_val("stack_overflow", empty)], wa), ou)
  have it1 := apply(tr.ite_f, {fst(exc(w, exc_val("stack_overflow", empty))) = 0}, {app(app(fst(snd(exc(w, exc_val("stack_overflow", empty)))), "os"), "events") = app(os, "events")},
    {ite(fst(exc(w, exc_val("stack_overflow", empty))) = 1, snd(snd(exc(w, exc_val("stack_overflow", empty)))) = exc_val("stack_overflow", empty) &&
      app(app(fst(snd(exc(w, exc_val("stack_overflow", empty)))), "os"), "events") = app(os, "events"), app(snd(exc(w, exc_val("stack_overflow", empty))), "os.events") = app(os, "events"))}, simp())
  have it2 := apply(tr.ite_t, {fst(exc(w, exc_val("stack_overflow", empty))) = 1}, {snd(snd(exc(w, exc_val("stack_overflow", empty)))) = exc_val("stack_overflow", empty) &&
      app(app(fst(snd(exc(w, exc_val("stack_overflow", empty)))), "os"), "events") = app(os, "events")}, {app(snd(exc(w, exc_val("stack_overflow", empty))), "os.events") = app(os, "events")}, simp())
  have cc: snd(snd(exc(w, exc_val("stack_overflow", empty)))) = exc_val("stack_overflow", empty) &&
      app(app(fst(snd(exc(w, exc_val("stack_overflow", empty)))), "os"), "events") = app(os, "events") by simp(hev)
  have iv := rewrite(sym(trans(it1, it2)), cc)
  show by defs(ex_intro({exc(w, exc_val("stack_overflow", empty))}, taut(ot, pe, iv)), tr.ovf)
qed

// (the coupling at a call from a frame of 8 bytes: its parts)
theorem tr.inv_call: all s base code m w. tr.inv(s, base, code, 8, m, w) ->
  sM: s in x86_64_linux.Machine && mM: m in x86_64_linux.Machine && mu: m in univ(1) && wW: w in abi.World && wu: w in univ(1) &&
  wsp: app(w, "sp") = abi.sp(s) && wcpu: app(w, "cpu") = app(s, "cpu") && mos: app(m, "os") = app(w, "os") && mfs: app(m, "fs_base") = app(w, "fs_base") &&
  er4: app(app(m, "gpr"), 4) = int_sub(app(app(s, "gpr"), 4), 8) && sb: app(app(s, "gpr"), 4) in bits(64) && slt: int_lt(app(app(s, "gpr"), 4), 140737488355328) &&
  sal: int_mod(bits_add(64, app(app(s, "gpr"), 4), 8), 16) = 0 && hsps: abi.stack_page(app(s, "vm"), int_div(app(app(s, "gpr"), 4), 4096)) &&
  sgf: abi.stack_gap_free(app(s, "vm")) && winp: app(app(w, "os"), "input") = app(app(s, "os"), "input") &&
  sws: subset(app(app(s, "os"), "events"), app(app(w, "os"), "events")) && mcpu: app(m, "cpu") = app(s, "cpu") && mgs: app(m, "gs_base") = app(s, "gs_base") &&
  mdf: !app(app(m, "flags"), "df")
proof
  fix s base code m w
  assume hi
  have {sM, mM, mu, wW, wu, wsp, wcpu, mos, mfs, rspm, slt, sal, hsps, sgf, winp, sws, mcpu, mgs, mdf} := hi
  have sb := apply(x86i.rsp_typed, sM)
  show by taut(sM, mM, mu, wW, wu, wsp, wcpu, mos, mfs, rspm, sb, slt, sal, hsps, sgf, winp, sws, mcpu, mgs, mdf)
qed

// A fault of the push (from m, rip past the call: a2): a crash in the
// entry's scratch space after the world's I/O (the call overflowing first),
// or the page mapped without write access -- GIMPLE's call undefined
theorem tr.call_fault(g, ar, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all s v base code m w ds u a2 x e.
  tr.inv(s, base, code, 8, m, w) -> tr.mem(s, m, w, ds) -> abi.view(v, s) in univ(1) -> int_le(16, app(app(s, "gpr"), 4)) ->
  u in bits(64) -> u in gimple.in_reg(fst(ar), snd(ar)) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) -> a2 in bits(64) ->
  x86.grown(fn_update(m, "rip", a2), int_div(int_sub(app(app(s, "gpr"), 4), 16), 4096), int_div(app(app(s, "gpr"), 4), 4096), x) ->
  x86.fault_at(bits_sub(64, app(app(m, "gpr"), 4), 8), 8, 1, x, e) ->
  tr.ub(s, v, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, seq_one(ar)), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w) ||
  tr.crash(s, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, seq_one(ar)), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, exc(x, e))
proof
  fix s v base code m w ds u a2 x e
  assume hi hmm hvu h16 hu hin hk ha2 hg hf
  let S := app(app(s, "gpr"), 4)
  let M2 := fn_update(m, "rip", a2)
  let P := mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, seq_one(ar)), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))
  have ic := apply(tr.inv_call, hi)
  have {mM, mu, wW, wu, wsp, mos, er4, sb, slt, sal, hsps, winp, sws} := ic
  have m2M: M2 in x86_64_linux.Machine by defs(simp(expand(mM, x86_64_linux.Machine), mu, ha2), x86_64_linux.Machine)
  have m2u: M2 in univ(1) by simp(mu, ha2)
  have gt := apply(x86.grown_typed, {M2}, {int_div(int_sub(S, 16), 4096)}, {int_div(S, 4096)}, {x}, m2M, m2u, hg)
  have {xM = cM, xu = cu, xos = cos} := gt
  have g1 _ _ xv _ := expand(hg, x86.grown)
  // the faulting byte: S - 16 + j
  obtain j, jo j8 tf0 from expand(rewrite(er4, hf), x86.fault_at)
  have pa1 pa2 := apply(tr.push_at, {S}, {j}, sb, h16, slt, sal, jo, j8)
  have tf := expand(rewrite(pa1, tf0), x86.touch_fault)
  let B := int_add(int_sub(S, 16), j)
  have bb: B in bits(64) by simp(sb, h16, slt, jo, j8)
  // no mapping: a crash
  have c0: (e = exc_val("segv", pair(B, 0)) && !x86_64_linux.mapped(app(x, "vm"), x86_64_linux.page_of(B))) -> tr.ub(s, v, P, w) || tr.crash(s, P, w, exc(x, e)) proof
    assume ee0
    have ee nm0 := ee0
    // (S's page: a stack page at the fault -- kept from the entry, not grown)
    have kpt: tr.kept(app(s, "vm"), app(m, "vm"), S) by simp(expand(hi, tr.inv), keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, abi.stack_gap_free, x86_64_linux.can_access, tr.kept, tr.keeps_code))
    have so: S in omega by simp(sb)
    have kr := mp(all_elim(expand(kpt, tr.kept), {S}), so, arith(so), arith(so))
    have p0o: int_div(S, 4096) in omega by simp(so)
    have g1a := mp(all_elim(expand(g1, x86.pages_in), {int_div(S, 4096)}), p0o)
    have kr2: app(app(app(m, "vm"), "pages"), int_div(S, 4096)) = app(app(app(s, "vm"), "pages"), int_div(S, 4096)) by defs(kr, x86_64_linux.page_of, x86_64_linux.PAGE)
    have xp: app(app(app(x, "vm"), "pages"), int_div(S, 4096)) = app(app(app(s, "vm"), "pages"), int_div(S, 4096)) by simp(g1a, kr2)
    have hspx: abi.stack_page(app(x, "vm"), int_div(S, 4096)) by defs(simp(xp, expand(hsps, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
    have pb: x86_64_linux.page_of(B) = int_div(int_sub(S, 16), 4096) by defs(pa2, x86_64_linux.page_of, x86_64_linux.PAGE)
    have nm := rewrite(pb, nm0)
    have ovp := apply(tr.push_overflow, {app(x, "vm")}, {S}, {j}, sb, h16, slt, sal, hspx, nm, jo, j8)
    have xr: app(app(x, "gpr"), 4) = int_sub(S, 8) by simp(gt, er4)
    have sc := rewrite(sym(xr), ovp)
    have ev: app(app(w, "os"), "events") = app(app(x, "os"), "events") by simp(xos, mos)
    have ov := apply(tr.call_ovf[g := g, args := seq_one(ar), a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)],
      {w}, {app(x, "os")}, wW, wu, ev, mp(all_elim(hk, {w}, {exc_val("stack_overflow", empty)}), wu, defs(simp(), exc_val)))
    have sub: subset(app(app(s, "os"), "events"), app(app(x, "os"), "events")) by simp(sws, xos, mos)
    have inp: app(app(s, "os"), "input") = app(app(x, "os"), "input") by simp(winp, xos, mos)
    have k01: 0 = 0 || 0 = 1 by simp()
    have cr: exc(x, e) = exc(x, exc_val("segv", pair(B, 0))) by simp(ee)
    have crash: tr.crash(s, P, w, exc(x, e)) by defs(ex_intro({x}, {B}, {0}, taut(cr, k01, xM, bb, sc, sub, inp, ov)), tr.crash)
    show by taut(crash)
  qed
  // non-canonical: not so
  have c2: (e = exc_val("segv", pair(0, 2)) && !x86_64_linux.canonical(B)) -> tr.ub(s, v, P, w) || tr.crash(s, P, w, exc(x, e)) proof
    assume hc
    have cn: x86_64_linux.canonical(B) by defs(simp(slt, jo, j8), x86_64_linux.canonical)
    show by taut(hc, cn)
  qed
  // mapped, not writable: GIMPLE's stack check fails at the push's page
  have c13: !x86_64_linux.can_access(app(x, "vm"), B, 1) -> tr.ub(s, v, P, w) proof
    assume hn
    let VM1 := fn_update(app(w, "vm"), "pages", app(app(x, "vm"), "pages"))
    have mv: app(m, "vm") in x86_64_linux.Vm := apply(x86i.parts, mM).4
    have mve := apply(tr.mem_vm_eq, {s}, {m}, {w}, {ds}, mv, hmm)
    have pe: app(app(M2, "vm"), "pages") = app(app(w, "vm"), "pages") by simp(sym(mve))
    have so: S in omega by simp(sb)
    have l0: int_div(int_sub(S, 16), 4096) = int_div(int_sub(int_sub(S, 8), 8), 4096) by arith(so)
    have r0: int_div(S, 4096) in omega by simp(so)
    have _ _ _ pp4 := apply(tr.push_pages, {S}, sb, h16, slt, sal)
    have hh0: int_le(int_mul(int_div(S, 4096), 4096), int_add(S, 8)) by arith(so)
    have hh: int_le(int_mul(int_div(S, 4096), 4096), app(w, "sp")) by simp(hh0, pp4, wsp)
    have fr := apply(tr.frame_pages, {app(M2, "vm")}, {app(x, "vm")}, {app(w, "vm")}, {int_sub(S, 8)}, {app(w, "sp")}, {int_div(int_sub(S, 16), 4096)}, {int_div(S, 4096)},
      g1, pe, l0, r0, hh)
    // (vm1: a memory)
    have wv: app(w, "vm") in x86_64_linux.Vm by simp(wW)
    have wvu := mp(app_univ[u := 1, f := w, k := "vm"], wu)
    have xpu := mp(app_univ[u := 1, f := app(x, "vm"), k := "pages"], mp(app_univ[u := 1, f := x, k := "vm"], xu))
    have vt := apply(x86.vm_pages_put, {app(w, "vm")}, {app(app(x, "vm"), "pages")}, wv, wvu, apply(x86.vm_pages_typed, {app(x, "vm")}, xv), xpu)
    // (the push's page: as in x's memory, not writable)
    have bs: bits_sub(64, int_sub(S, 8), 8) = int_sub(S, 16) by defs(simp(sb, h16, slt), bits_sub)
    have pg: x86_64_linux.page_of(int_sub(S, 16)) = x86_64_linux.page_of(B) by defs(simp(pa2), x86_64_linux.page_of)
    have pv: app(app(VM1, "pages"), x86_64_linux.page_of(int_sub(S, 16))) = app(app(app(x, "vm"), "pages"), x86_64_linux.page_of(B)) by simp(pg)
    have ac := apply(tr.access_page, {VM1}, {app(x, "vm")}, {int_sub(S, 16)}, {B}, {1}, pg, pv)
    have nso0: !abi.stack_ok(VM1, int_sub(S, 16)) by defs(taut(ac, hn), abi.stack_ok)
    have nso: !(abi.thread_ok(VM1, app(w, "fs_base")) && abi.stack_ok(VM1, bits_sub(64, int_sub(S, 8), 8))) by simp(nso0, bs, keep(abi.thread_ok, abi.stack_ok))
    have s8b: int_sub(S, 8) in bits(64) by simp(sb, h16)
    have s8l: int_le(int_sub(S, 8), app(w, "sp")) by simp(wsp, pp4)
    have s8a: int_mod(int_sub(S, 8), 16) = 0 by simp(sb, sal, slt)
    have ke := mp(all_elim(hk, {abi.view(v, s)}, {empty}), hvu, simp())
    show := apply(tr.call_ub[g := g, ar := ar, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)],
      {s}, {v}, {w}, {u}, {int_sub(S, 8)}, {VM1}, wu, hvu, hu, hin, s8b, s8l, s8a, vt.1, vt.2, fr, nso, ke)
  qed
  have c13b: ((e = exc_val("segv", pair(B, 1)) || e = exc_val("segv", pair(B, 3))) && !x86_64_linux.can_access(app(x, "vm"), B, 1)) ->
      tr.ub(s, v, P, w) || tr.crash(s, P, w, exc(x, e)) proof
    assume h3
    have u3 := mp(c13, h3.2)
    show by taut(u3)
  qed
  show by taut(tf, c0, c2, c13b)
qed

// ----------------------------------------------------------------------
//  GIMPLE's call when the callee runs

// (worlds: their fields only, and with a memory, an os, a thread pointer put in)
theorem tr.world_keys: all w. w in abi.World -> restrict(w, abi.WKEYS) = w && ghost_part(w, abi.WKEYS) = empty
proof
  fix w
  assume hw
  have kf := apply(pow_cart_fst, unsel(expand(hw, abi.World)))
  have r := apply(restrict_all, kf)
  have g := apply(ghost_part_none, kf)
  show by taut(r, g)
qed

theorem tr.world_set: all w v os fs. w in abi.World -> w in univ(1) -> v in x86_64_linux.Vm -> v in univ(1) ->
  os in x86_64_linux.Os -> os in univ(1) -> fs in bits(64) ->
  fn_update(fn_update(fn_update(w, "vm", v), "os", os), "fs_base", fs) in abi.World && fn_update(fn_update(fn_update(w, "vm", v), "os", os), "fs_base", fs) in univ(1) &&
  fn_update(w, "vm", v) in abi.World && fn_update(w, "vm", v) in univ(1)
proof
  fix w v os fs
  assume hw hu hv hvu ho hou hf
  have wf := expand(hw, abi.World)
  have r1: fn_update(fn_update(fn_update(w, "vm", v), "os", os), "fs_base", fs) in abi.World by defs(simp(wf, hu, hv, hvu, ho, hou, hf), abi.World)
  have r2: fn_update(fn_update(fn_update(w, "vm", v), "os", os), "fs_base", fs) in univ(1) by simp(hu, hvu, hou, hf)
  have r3: fn_update(w, "vm", v) in abi.World by defs(simp(wf, hu, hv, hvu), abi.World)
  have r4: fn_update(w, "vm", v) in univ(1) by simp(hu, hvu)
  show by taut(r1, r2, r3, r4)
qed

// (a World with an empty ghost part: a World)
theorem tr.and_world: all x. x in rec_and(abi.World, single(empty)) -> x in abi.World
proof
  fix x
  assume h
  obtain x0 y0, x0w y0e xe from mp(rec_and_elim[a := abi.World, b := single(empty), s := x], h)
  have ye: y0 = empty := mp(single_elim[a := empty, z := y0], y0e)
  have xe1 := rewrite(ye, xe)
  have xe2 := trans(xe1, union2_empty[a := x0])
  show := rewrite(sym(xe2), x0w)
qed

// the spec's rest diverging: the function diverging
theorem tr.qs_div(op, t, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k): all w. runs(op, w, diverge(t)) ->
  (all o. runs(mkprog(x0 x1. ex x8. dd(t, x8) && k(x8, x1)), w, o) ->
    runs(mkprog(x0 x1. ex x8. bind_rel(op, x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), w, o))
proof
  fix w
  assume hq
  have g: all o. (ex x8. dd(t, x8) && k(x8, o)) -> (ex x8. bind_rel(op, w, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, o)) proof
    fix o
    assume h
    obtain y, hy from h
    have dy := hy.1
    have e1: ex o2. runs(op, w, o2) && ((ex s1 v. o2 = ok(s1, v) && a(s1, v, y)) || (ex s1 e2. o2 = exc(s1, e2) && xx(s1, e2, y)) || (ex t2. o2 = diverge(t2) && dd(t2, y)))
      by ex_intro({diverge(t)}, simp(hq, dy))
    have b: bind_rel(op, w, x9 x10. a(x9, x10, y), x9 x10. xx(x9, x10, y), x9. dd(x9, y)) by defs(e1, bind_rel)
    show by ex_intro({y}, taut(b, hy))
  qed
  show := mp(tr.mkprog_mono[s := w, r1 := x0 x1. ex x8. bind_rel(op, x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1),
    r2 := x0 x1. ex x8. dd(t, x8) && k(x8, x1)], g)
qed

theorem tr.p_div(q, x3 x4 x2. kw): all w t. w in univ(1) -> t in univ(1) -> runs(q, w, diverge(t)) ->
  runs(mkprog(x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, diverge(t))
proof
  fix w t
  assume hw ht hr
  have b0: ex o2. runs(q, w, o2) && ((ex s1 v. o2 = ok(s1, v) && kw(s1, v, diverge(t))) || (ex s1 e1. o2 = exc(s1, e1) && diverge(t) = exc(s1, e1)) ||
    (ex t2. o2 = diverge(t2) && diverge(t) = diverge(t2))) by ex_intro({diverge(t)}, simp(hr))
  have b: bind_rel(q, w, x3 x4. kw(x3, x4, diverge(t)), x3 x4. diverge(t) = exc(x3, x4), x3. diverge(t) = diverge(x3)) by defs(b0, bind_rel)
  have pu: pair(w, diverge(t)) in univ(1) by simp(hw, ht)
  show := mp(all_elim(tr.runs_intro[r := x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))], {w}, {diverge(t)}), pu, b)
qed

// ... at a call: the call diverging
theorem tr.call_div(g, args, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all w t. w in univ(1) -> t in univ(1) ->
  runs(gimple.call1(g, args), w, diverge(t)) -> runs(mkprog(x0 x1. ex x8. dd(t, x8) && k(x8, x1)), w, diverge(t)) ->
  runs(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, diverge(t))
proof
  fix w t
  assume hw ht hc hk
  have q := mp(all_elim(mp(all_elim(tr.qs_div[op := gimple.call1(g, args), t := t, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1)], {w}), hc), {diverge(t)}), hk)
  show := apply(tr.p_div[q := mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, args), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), kw := x3 x4 x2. kw(x3, x4, x2)],
    {w}, {t}, hw, ht, q)
qed

// (the callee's world: its view of the caller's, no ghost part)
theorem tr.callee_view: all w1 vv sp2. w1 in abi.World ->
  rec_merge(fn_update(fn_update(fn_update(fn_update(fn_update(empty, "vm", vv), "os", app(w1, "os")), "fs_base", app(w1, "fs_base")), "cpu", app(w1, "cpu")), "sp", sp2),
    ghost_part(w1, insert("vm", insert("os", insert("fs_base", insert("cpu", insert("sp", empty))))))) =
  fn_update(fn_update(fn_update(fn_update(fn_update(empty, "vm", vv), "os", app(w1, "os")), "fs_base", app(w1, "fs_base")), "cpu", app(w1, "cpu")), "sp", sp2)
proof
  fix w1 vv sp2
  assume hw
  have _ g := apply(tr.world_keys, hw)
  show by defs(simp(g, union2_empty[a := fn_update(fn_update(fn_update(fn_update(fn_update(empty, "vm", vv), "os", app(w1, "os")), "fs_base", app(w1, "fs_base")), "cpu", app(w1, "cpu")), "sp", sp2)]), rec_merge)
qed

// the callee's final world xw written back (the memory vm2, matching it
// outside the callee's scratch space): the caller's world W3
theorem tr.callee_set: all w1 xw vm2 sp2. w1 in abi.World -> w1 in univ(1) -> xw in abi.World -> xw in univ(1) ->
  vm2 in x86_64_linux.Vm -> vm2 in univ(1) -> abi.world_matches(app(w1, "vm"), vm2, app(xw, "vm"), sp2) ->
  runs(gimple.callee_world.set(sp2, restrict(xw, abi.WKEYS)), w1, ok(fn_update(fn_update(fn_update(w1, "vm", vm2), "os", app(xw, "os")), "fs_base", app(xw, "fs_base")), empty)) &&
  rec_merge(restrict(fn_update(fn_update(fn_update(w1, "vm", vm2), "os", app(xw, "os")), "fs_base", app(xw, "fs_base")), abi.WKEYS), ghost_part(xw, abi.WKEYS)) =
    fn_update(fn_update(fn_update(w1, "vm", vm2), "os", app(xw, "os")), "fs_base", app(xw, "fs_base")) &&
  fn_update(fn_update(fn_update(w1, "vm", vm2), "os", app(xw, "os")), "fs_base", app(xw, "fs_base")) in abi.World &&
  fn_update(fn_update(fn_update(w1, "vm", vm2), "os", app(xw, "os")), "fs_base", app(xw, "fs_base")) in univ(1)
proof
  fix w1 xw vm2 sp2
  assume hw hwu hx hxu hv hvu hm
  let W3 := fn_update(fn_update(fn_update(w1, "vm", vm2), "os", app(xw, "os")), "fs_base", app(xw, "fs_base"))
  have rx gx := apply(tr.world_keys, hx)
  have xf := expand(hx, abi.World)
  have xos: app(xw, "os") in x86_64_linux.Os by simp(xf)
  have xosu := mp(app_univ[u := 1, f := xw, k := "os"], hxu)
  have xfs: app(xw, "fs_base") in bits(64) by simp(xf)
  have w3W w3u _ _ := apply(tr.world_set, {w1}, {vm2}, {app(xw, "os")}, {app(xw, "fs_base")}, hw, hwu, hv, hvu, xos, xosu, xfs)
  have so := apply(gc.set_ok, {sp2}, {xw}, {w1}, {vm2}, hwu, hxu, hv, hvu, hm)
  have se: gimple.callee_world.set(sp2, xw) = gimple.callee_world.set(sp2, restrict(xw, abi.WKEYS)) by simp(rx)
  have so2 := rewrite(se, so)
  have r3 _ := apply(tr.world_keys, w3W)
  have e: rec_merge(restrict(W3, abi.WKEYS), ghost_part(xw, abi.WKEYS)) = W3 by defs(simp(r3, gx, union2_empty[a := W3]), rec_merge)
  show by taut(so2, e, w3W, w3u)
qed

// GIMPLE's call entered (the callee's frame vm1 sound): the world with vm1,
// the argument in its register, the callee's sp2
theorem tr.g_enter: all w u ar sp2 vm1. w in univ(1) -> u in bits(64) -> u in gimple.in_reg(fst(ar), snd(ar)) ->
  sp2 in bits(64) -> int_le(sp2, app(w, "sp")) -> int_mod(sp2, 16) = 0 ->
  vm1 in x86_64_linux.Vm -> vm1 in univ(1) -> gimple.frame_at_call(app(w, "vm"), vm1, sp2, app(w, "sp")) ->
  abi.thread_ok(vm1, app(w, "fs_base")) -> abi.stack_ok(vm1, bits_sub(64, sp2, 8)) ->
  runs(gimple.call_enter(app(w, "sp"), app(w, "sp"), seq_one(ar)), w, ok(fn_update(w, "vm", vm1), pair(seq_one(u), sp2)))
proof
  fix w u ar sp2 vm1
  assume hw hu hi hs hl ha hv hv1 hf ht hk
  have r1 r2 r3 r4 := apply(tr.regs1, {u}, {ar}, hu, hi)
  show := apply(gc.enter_ok, {app(w, "sp")}, {app(w, "sp")}, {seq_one(ar)}, {w}, {seq_one(u)}, {sp2}, {vm1},
    hw, r1, r2, r3, r4, hs, hl, ha, hv, hv1, hf, ht, hk)
qed

// the callee raising (from the world the call shows it): so does the
// function, the callee's world written back
theorem tr.callee_exc_p(g, ar, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all w u sp2 vm1 vv xw e.
  w in abi.World -> w in univ(1) -> vm1 in x86_64_linux.Vm -> vm1 in univ(1) -> vv in x86_64_linux.Vm -> vv in univ(1) -> sp2 in bits(64) ->
  runs(gimple.call_enter(app(w, "sp"), app(w, "sp"), seq_one(ar)), w, ok(fn_update(w, "vm", vm1), pair(seq_one(u), sp2))) ->
  abi.scratch_view(vv, vm1, sp2) ->
  runs(app(g, seq_one(u)), fn_update(fn_update(fn_update(fn_update(fn_update(empty, "vm", vv), "os", app(w, "os")), "fs_base", app(w, "fs_base")), "cpu", app(w, "cpu")), "sp", sp2), exc(xw, e)) ->
  xw in rec_and(abi.World, single(empty)) -> xw in univ(1) -> e in univ(1) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) ->
  runs(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, seq_one(ar)), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w,
    exc(fn_update(fn_update(fn_update(fn_update(w, "vm", vm1), "vm", app(xw, "vm")), "os", app(xw, "os")), "fs_base", app(xw, "fs_base")), e)) &&
  fn_update(fn_update(fn_update(fn_update(w, "vm", vm1), "vm", app(xw, "vm")), "os", app(xw, "os")), "fs_base", app(xw, "fs_base")) in abi.World
proof
  fix w u sp2 vm1 vv xw e
  assume hw hwu hv hvu hvv hvvu hs hen hsv hg hxa hxu he hk
  let W1 := fn_update(w, "vm", vm1)
  let WV := fn_update(fn_update(fn_update(fn_update(fn_update(empty, "vm", vv), "os", app(w, "os")), "fs_base", app(w, "fs_base")), "cpu", app(w, "cpu")), "sp", sp2)
  let W3 := fn_update(fn_update(fn_update(W1, "vm", app(xw, "vm")), "os", app(xw, "os")), "fs_base", app(xw, "fs_base"))
  have xW := apply(tr.and_world, hxa)
  have _ _ w1W w1u := apply(tr.world_set, {w}, {vm1}, {app(w, "os")}, {app(w, "fs_base")}, hw, hwu, hv, hvu, simp(expand(hw, abi.World)), mp(app_univ[u := 1, f := w, k := "os"], hwu), simp(expand(hw, abi.World)))
  // (the callee's world: read through the view)
  have sv1: abi.scratch_view(vv, app(W1, "vm"), sp2) by simp(hsv)
  have su: sp2 in univ(1) by simp(hs)
  have gt := apply(gc.get_ok, {sp2}, {W1}, {vv}, w1u, su, hvv, hvvu, sv1)
  have gt2: runs(gimple.callee_world.get(sp2), W1, ok(W1, WV)) by simp(gt, keep(gimple.callee_world.get))
  have wvu: WV in univ(1) by simp(hwu, hvvu, su)
  have cv := apply(tr.callee_view, {W1}, {vv}, {sp2}, w1W)
  have cv2: rec_merge(WV, ghost_part(W1, insert("vm", insert("os", insert("fs_base", insert("cpu", insert("sp", empty))))))) = WV by simp(cv)
  have hg2 := rewrite(sym(cv2), hg)
  // (written back: the callee's memory, its os and thread pointer)
  have xv: app(xw, "vm") in x86_64_linux.Vm by simp(expand(xW, abi.World))
  have xvu := mp(app_univ[u := 1, f := xw, k := "vm"], hxu)
  have wm := all_elim(abi.wm_refl, {app(W1, "vm")}, {app(xw, "vm")}, {sp2})
  have cset mg w3W w3u := apply(tr.callee_set, {W1}, {xw}, {app(xw, "vm")}, {sp2}, w1W, w1u, xW, hxu, xv, xvu, wm)
  have ce := apply(gc.callee_exc, {sp2}, {g}, {seq_one(u)}, {W1}, {WV}, {xw}, {e}, {W3}, w1u, wvu, hxu, he, w3u, gt2, hg2, cset)
  have ce2 := rewrite(mg, ce)
  have ca := apply(gc.call_at_callee_exc, {app(w, "sp")}, {app(w, "sp")}, {g}, {seq_one(ar)}, {w}, {W1}, {seq_one(u)}, {sp2}, {W3}, {e}, hwu, w3u, he, hen, ce2)
  have c1 := apply(gc.call1_exc, {g}, {seq_one(ar)}, {w}, {W3}, {e}, hwu, w3u, he, ca)
  have pe := apply(tr.call_exc[g := g, args := seq_one(ar), a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)],
    {w}, {W3}, {e}, hwu, w3u, he, c1, mp(all_elim(hk, {W3}, {e}), w3u, he))
  show by taut(pe, w3W)
qed

// the callee running on: so does the function
theorem tr.callee_div_p(g, ar, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all w u sp2 vm1 vv t.
  w in abi.World -> w in univ(1) -> vm1 in x86_64_linux.Vm -> vm1 in univ(1) -> vv in x86_64_linux.Vm -> vv in univ(1) -> sp2 in bits(64) ->
  runs(gimple.call_enter(app(w, "sp"), app(w, "sp"), seq_one(ar)), w, ok(fn_update(w, "vm", vm1), pair(seq_one(u), sp2))) ->
  abi.scratch_view(vv, vm1, sp2) ->
  runs(app(g, seq_one(u)), fn_update(fn_update(fn_update(fn_update(fn_update(empty, "vm", vv), "os", app(w, "os")), "fs_base", app(w, "fs_base")), "cpu", app(w, "cpu")), "sp", sp2), diverge(t)) ->
  t in univ(1) -> (all t. t in univ(1) -> runs(mkprog(x0 x1. ex x8. dd(t, x8) && k(x8, x1)), w, diverge(t))) ->
  runs(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, seq_one(ar)), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, diverge(t))
proof
  fix w u sp2 vm1 vv t
  assume hw hwu hv hvu hvv hvvu hs hen hsv hg ht hd
  let W1 := fn_update(w, "vm", vm1)
  let WV := fn_update(fn_update(fn_update(fn_update(fn_update(empty, "vm", vv), "os", app(w, "os")), "fs_base", app(w, "fs_base")), "cpu", app(w, "cpu")), "sp", sp2)
  have _ _ w1W w1u := apply(tr.world_set, {w}, {vm1}, {app(w, "os")}, {app(w, "fs_base")}, hw, hwu, hv, hvu, simp(expand(hw, abi.World)), mp(app_univ[u := 1, f := w, k := "os"], hwu), simp(expand(hw, abi.World)))
  have sv1: abi.scratch_view(vv, app(W1, "vm"), sp2) by simp(hsv)
  have su: sp2 in univ(1) by simp(hs)
  have gt := apply(gc.get_ok, {sp2}, {W1}, {vv}, w1u, su, hvv, hvvu, sv1)
  have gt2: runs(gimple.callee_world.get(sp2), W1, ok(W1, WV)) by simp(gt, keep(gimple.callee_world.get))
  have wvu: WV in univ(1) by simp(hwu, hvvu, su)
  have cv := apply(tr.callee_view, {W1}, {vv}, {sp2}, w1W)
  have cv2: rec_merge(WV, ghost_part(W1, insert("vm", insert("os", insert("fs_base", insert("cpu", insert("sp", empty))))))) = WV by simp(cv)
  have hg2 := rewrite(sym(cv2), hg)
  have cd := apply(gc.callee_div, {sp2}, {g}, {seq_one(u)}, {W1}, {WV}, {t}, w1u, wvu, ht, gt2, hg2)
  have ca := apply(gc.call_at_callee_div, {app(w, "sp")}, {app(w, "sp")}, {g}, {seq_one(ar)}, {w}, {W1}, {seq_one(u)}, {sp2}, {t}, hwu, ht, hen, cd)
  have c1 := apply(gc.call1_div, {g}, {seq_one(ar)}, {w}, {t}, hwu, ht, ca)
  show := apply(tr.call_div[g := g, args := seq_one(ar), a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)],
    {w}, {t}, hwu, ht, c1, mp(all_elim(hd, {t}), ht))
qed

// the callee returning (its world xw, the machine's memory vm2 matching
// it): the caller's world W3 after the callee
theorem tr.callee_ok_p: all g w u sp2 vm1 vv xw res vm2.
  w in abi.World -> w in univ(1) -> vm1 in x86_64_linux.Vm -> vm1 in univ(1) -> vv in x86_64_linux.Vm -> vv in univ(1) -> sp2 in bits(64) ->
  abi.scratch_view(vv, vm1, sp2) ->
  runs(app(g, seq_one(u)), fn_update(fn_update(fn_update(fn_update(fn_update(empty, "vm", vv), "os", app(w, "os")), "fs_base", app(w, "fs_base")), "cpu", app(w, "cpu")), "sp", sp2), ok(xw, res)) ->
  xw in abi.World -> xw in univ(1) -> res in univ(1) -> vm2 in x86_64_linux.Vm -> vm2 in univ(1) -> abi.world_matches(vm1, vm2, app(xw, "vm"), sp2) ->
  runs(gimple.call_callee(sp2, g, seq_one(u)), fn_update(w, "vm", vm1),
    ok(fn_update(fn_update(fn_update(fn_update(w, "vm", vm1), "vm", vm2), "os", app(xw, "os")), "fs_base", app(xw, "fs_base")), pair(fst(res), snd(res)))) &&
  fn_update(fn_update(fn_update(fn_update(w, "vm", vm1), "vm", vm2), "os", app(xw, "os")), "fs_base", app(xw, "fs_base")) in abi.World &&
  fn_update(fn_update(fn_update(fn_update(w, "vm", vm1), "vm", vm2), "os", app(xw, "os")), "fs_base", app(xw, "fs_base")) in univ(1)
proof
  fix g w u sp2 vm1 vv xw res vm2
  assume hw hwu hv hvu hvv hvvu hs hsv hg hx hxu hr h2 h2u hm
  let W1 := fn_update(w, "vm", vm1)
  let WV := fn_update(fn_update(fn_update(fn_update(fn_update(empty, "vm", vv), "os", app(w, "os")), "fs_base", app(w, "fs_base")), "cpu", app(w, "cpu")), "sp", sp2)
  let W3 := fn_update(fn_update(fn_update(W1, "vm", vm2), "os", app(xw, "os")), "fs_base", app(xw, "fs_base"))
  have _ _ w1W w1u := apply(tr.world_set, {w}, {vm1}, {app(w, "os")}, {app(w, "fs_base")}, hw, hwu, hv, hvu, simp(expand(hw, abi.World)), mp(app_univ[u := 1, f := w, k := "os"], hwu), simp(expand(hw, abi.World)))
  have sv1: abi.scratch_view(vv, app(W1, "vm"), sp2) by simp(hsv)
  have su: sp2 in univ(1) by simp(hs)
  have gt := apply(gc.get_ok, {sp2}, {W1}, {vv}, w1u, su, hvv, hvvu, sv1)
  have gt2: runs(gimple.callee_world.get(sp2), W1, ok(W1, WV)) by simp(gt, keep(gimple.callee_world.get))
  have wvu: WV in univ(1) by simp(hwu, hvvu, su)
  have cv := apply(tr.callee_view, {W1}, {vv}, {sp2}, w1W)
  have cv2: rec_merge(WV, ghost_part(W1, insert("vm", insert("os", insert("fs_base", insert("cpu", insert("sp", empty))))))) = WV by simp(cv)
  have hg2 := rewrite(sym(cv2), hg)
  have hm1: abi.world_matches(app(W1, "vm"), vm2, app(xw, "vm"), sp2) by simp(hm, keep(abi.world_matches))
  have cset mg w3W w3u := apply(tr.callee_set, {W1}, {xw}, {vm2}, {sp2}, w1W, w1u, hx, hxu, h2, h2u, hm1)
  have co := apply(gc.callee_ok, {sp2}, {g}, {seq_one(u)}, {W1}, {WV}, {xw}, {res}, {W3}, w1u, wvu, hxu, hr, w3u, gt2, hg2, cset)
  have co2 := rewrite(mg, co)
  show by taut(co2, w3W, w3u)
qed

// the function's rest from the procedure's rest
theorem tr.p_red(q, q2, x3 x4 x2. kw): all w w2. w in univ(1) -> (all o. runs(q2, w2, o) -> runs(q, w, o)) ->
  (all o. runs(mkprog(x1 x2. bind_rel(q2, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w2, o) ->
    runs(mkprog(x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, o))
proof
  fix w w2
  assume hw hq
  fix o
  assume h0
  have hu: pair(w2, o) in univ(1) && bind_rel(q2, w2, x3 x4. kw(x3, x4, o), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) by simp(expand(expand(h0, runs), mkprog))
  have pu: pair(w, o) in univ(1) by simp(hu, hw)
  obtain o2, ho2 from expand(hu.2, bind_rel)
  have r := mp(all_elim(hq, {o2}), ho2.1)
  have b0: ex o3. runs(q, w, o3) && ((ex s1 v. o3 = ok(s1, v) && kw(s1, v, o)) || (ex s1 e1. o3 = exc(s1, e1) && o = exc(s1, e1)) ||
    (ex t2. o3 = diverge(t2) && o = diverge(t2))) by ex_intro({o2}, taut(r, ho2))
  have b: bind_rel(q, w, x3 x4. kw(x3, x4, o), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) by defs(b0, bind_rel)
  show := mp(all_elim(tr.runs_intro[r := x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))], {w}, {o}), pu, b)
qed

// (the caller's private frame [sp2, hi) after the callee: as before, in
// bytes and pages)
def tr.frame_same(v3, v1, sp2, hi) := all a. a in bits(64) -> int_le(sp2, a) && int_lt(a, hi) ->
  app(app(v3, "bytes"), a) = app(app(v1, "bytes"), a) && app(app(v3, "pages"), x86_64_linux.page_of(a)) = app(app(v1, "pages"), x86_64_linux.page_of(a))

// after the callee returned (the caller's world W3, the callee's result
// r0:r1): the call overflowing the stack, undefined (the frame changed),
// or the spec's rest from W3 with the result r0
theorem tr.leave_p(g, ar, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all w u sp2 vm1 w3 r0 r1.
  w in univ(1) -> w3 in univ(1) -> r0 in univ(1) -> r1 in univ(1) ->
  runs(gimple.call_enter(app(w, "sp"), app(w, "sp"), seq_one(ar)), w, ok(fn_update(w, "vm", vm1), pair(seq_one(u), sp2))) ->
  runs(gimple.call_callee(sp2, g, seq_one(u)), fn_update(w, "vm", vm1), ok(w3, pair(r0, r1))) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) ->
  runs(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, seq_one(ar)), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, exc(w3, exc_val("stack_overflow", empty))) &&
  (!tr.frame_same(app(w3, "vm"), vm1, sp2, app(w, "sp")) -> (all x e. x in univ(1) -> e in univ(1) ->
    runs(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, seq_one(ar)), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
      x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, exc(x, e)))) &&
  (tr.frame_same(app(w3, "vm"), vm1, sp2, app(w, "sp")) -> (all o.
    runs(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. a(x0, r0, x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w3, o) ->
    runs(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, seq_one(ar)), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
      x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, o)))
proof
  fix w u sp2 vm1 w3 r0 r1
  assume hw hw3 hr0 hr1 hen hco hk
  let Q := mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, seq_one(ar)), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1))
  let LV := gimple.call_leave(sp2, app(w, "sp"), app(app(fn_update(w, "vm", vm1), "vm"), "bytes"), app(app(fn_update(w, "vm", vm1), "vm"), "pages"), fst(pair(r0, r1)), snd(pair(r0, r1)))
  have ou: exc_val("stack_overflow", empty) in univ(1) by defs(simp(), exc_val)
  // overflow after the callee
  have lo0 := apply(gc.leave_ovf, {sp2}, {app(w, "sp")}, {app(app(fn_update(w, "vm", vm1), "vm"), "bytes")}, {app(app(fn_update(w, "vm", vm1), "vm"), "pages")},
    {fst(pair(r0, r1))}, {snd(pair(r0, r1))}, {w3}, hw3)
  have ao := apply(gc.call_at_via_exc, {app(w, "sp")}, {app(w, "sp")}, {g}, {seq_one(ar)}, {w}, {fn_update(w, "vm", vm1)}, {seq_one(u)}, {sp2}, {w3}, {pair(r0, r1)},
    {w3}, {exc_val("stack_overflow", empty)}, hw, hw3, ou, hen, hco, lo0)
  have c1o := apply(gc.call1_exc, {g}, {seq_one(ar)}, {w}, {w3}, {exc_val("stack_overflow", empty)}, hw, hw3, ou, ao)
  have po := apply(tr.call_exc[g := g, args := seq_one(ar), a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)],
    {w}, {w3}, {exc_val("stack_overflow", empty)}, hw, hw3, ou, c1o, mp(all_elim(hk, {w3}, {exc_val("stack_overflow", empty)}), hw3, ou))
  // the frame changed: undefined
  have pu: !tr.frame_same(app(w3, "vm"), vm1, sp2, app(w, "sp")) -> (all x e. x in univ(1) -> e in univ(1) ->
      runs(mkprog(x1 x2. bind_rel(Q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, exc(x, e))) proof
    assume hn
    fix x e
    assume hx he
    have hn2: !(all a. a in bits(64) -> int_le(sp2, a) && int_lt(a, app(w, "sp")) ->
        app(app(app(w3, "vm"), "bytes"), a) = app(app(app(fn_update(w, "vm", vm1), "vm"), "bytes"), a) &&
        app(app(app(w3, "vm"), "pages"), x86_64_linux.page_of(a)) = app(app(app(fn_update(w, "vm", vm1), "vm"), "pages"), x86_64_linux.page_of(a))) by simp(expand(hn, tr.frame_same))
    have lu := apply(gc.leave_ub, {sp2}, {app(w, "sp")}, {app(app(fn_update(w, "vm", vm1), "vm"), "bytes")}, {app(app(fn_update(w, "vm", vm1), "vm"), "pages")},
      {fst(pair(r0, r1))}, {snd(pair(r0, r1))}, {w3}, {x}, {e}, hw3, hx, he, hn2)
    have au := apply(gc.call_at_via_exc, {app(w, "sp")}, {app(w, "sp")}, {g}, {seq_one(ar)}, {w}, {fn_update(w, "vm", vm1)}, {seq_one(u)}, {sp2}, {w3}, {pair(r0, r1)},
      {x}, {e}, hw, hx, he, hen, hco, lu)
    have c1u := apply(gc.call1_exc, {g}, {seq_one(ar)}, {w}, {x}, {e}, hw, hx, he, au)
    show := apply(tr.call_exc[g := g, args := seq_one(ar), a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)],
      {w}, {x}, {e}, hw, hx, he, c1u, mp(all_elim(hk, {x}, {e}), hx, he))
  qed
  // the frame as before: the call returns r0
  have pk: tr.frame_same(app(w3, "vm"), vm1, sp2, app(w, "sp")) -> (all o.
      runs(mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. a(x0, r0, x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w3, o) ->
      runs(mkprog(x1 x2. bind_rel(Q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, o)) proof
    assume hs
    have hs2: all a. a in bits(64) -> int_le(sp2, a) && int_lt(a, app(w, "sp")) ->
        app(app(app(w3, "vm"), "bytes"), a) = app(app(app(fn_update(w, "vm", vm1), "vm"), "bytes"), a) &&
        app(app(app(w3, "vm"), "pages"), x86_64_linux.page_of(a)) = app(app(app(fn_update(w, "vm", vm1), "vm"), "pages"), x86_64_linux.page_of(a)) by defs(simp(expand(hs, tr.frame_same)), tr.frame_same)
    have lk := apply(gc.leave_ok, {sp2}, {app(w, "sp")}, {app(app(fn_update(w, "vm", vm1), "vm"), "bytes")}, {app(app(fn_update(w, "vm", vm1), "vm"), "pages")},
      {fst(pair(r0, r1))}, {snd(pair(r0, r1))}, {w3}, hw3, simp(hr0), simp(hr1), hs2)
    have ak := apply(gc.call_at_via_ok, {app(w, "sp")}, {app(w, "sp")}, {g}, {seq_one(ar)}, {w}, {fn_update(w, "vm", vm1)}, {seq_one(u)}, {sp2}, {w3}, {pair(r0, r1)},
      {w3}, {pair(fst(pair(r0, r1)), snd(pair(r0, r1)))}, hw, hw3, simp(hr0, hr1), hen, hco, lk)
    have ak2: runs(gimple.call_at(app(w, "sp"), app(w, "sp"), g, seq_one(ar)), w, ok(w3, pair(r0, r1))) by simp(ak, keep(gimple.call_at))
    have c1k := apply(gc.call1_ok, {g}, {seq_one(ar)}, {w}, {w3}, {r0}, {r1}, hw, hw3, hr0, hr1, ak2)
    have qc := mp(all_elim(tr.qs_call[op := gimple.call1(g, seq_one(ar)), w4 := w3, r := r0, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1)], {w}), hw, c1k)
    show := apply(tr.p_red[q := Q, q2 := mkprog(x0 x1. ex x8. a(x0, r0, x8) && k(x8, x1)), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {w3}, hw, qc)
  qed
  show by taut(po, pu, pk)
qed

// ----------------------------------------------------------------------
//  The push done: the callee's entry state C

// (a machine with a memory, rsp and rip put in: a machine)
theorem tr.mach_push: all m1 nv r T. m1 in x86_64_linux.Machine -> m1 in univ(1) -> nv in x86_64_linux.Vm -> nv in univ(1) -> r in bits(64) -> T in bits(64) ->
  fn_update(fn_update(fn_update(m1, "vm", nv), "gpr", fn_update(app(m1, "gpr"), 4, r)), "rip", T) in x86_64_linux.Machine &&
  fn_update(fn_update(fn_update(m1, "vm", nv), "gpr", fn_update(app(m1, "gpr"), 4, r)), "rip", T) in univ(1)
proof
  fix m1 nv r T
  assume hM hu hv hvu hr ht
  have _ gt _ _ := apply(x86i.parts, hM)
  have g4 := apply(x86.space_upd, {x86_64_linux.Reg}, {bits(64)}, {app(m1, "gpr")}, {4}, {r}, gt, simp(), hr)
  have gu := mp(app_univ[u := 1, f := m1, k := "gpr"], hu)
  have a: fn_update(fn_update(fn_update(m1, "vm", nv), "gpr", fn_update(app(m1, "gpr"), 4, r)), "rip", T) in x86_64_linux.Machine
    by defs(simp(expand(hM, x86_64_linux.Machine), hu, hv, hvu, g4, gu, hr, ht), x86_64_linux.Machine)
  have b: fn_update(fn_update(fn_update(m1, "vm", nv), "gpr", fn_update(app(m1, "gpr"), 4, r)), "rip", T) in univ(1) by simp(hu, hvu, gu, hr, ht)
  show by taut(a, b)
qed

// (a page mapped before the stack grew: its entry kept)
theorem tr.pages_eq_mapped: all v0 v1 l r p. x86.pages_in(v0, v1, l, r) -> p in omega -> x86_64_linux.mapped(v0, p) ->
  app(app(v1, "pages"), p) = app(app(v0, "pages"), p)
proof
  fix v0 v1 l r p
  assume h hp hm
  have a := mp(all_elim(expand(h, x86.pages_in), {p}), hp)
  have mm := expand(hm, x86_64_linux.mapped)
  show by taut(a, mm)
qed

theorem tr.push_ok: all s base code m w RA T m1 e1 C. tr.inv(s, base, code, 8, m, w) -> int_le(16, app(app(s, "gpr"), 4)) ->
  RA in bits(64) -> T in bits(64) ->
  runs(x86_64_linux.touch_range(bits_sub(64, app(app(m, "gpr"), 4), 8), 8, 1), fn_update(m, "rip", RA), ok(m1, e1)) ->
  C = fn_update(fn_update(fn_update(m1, "vm", fn_update(app(m1, "vm"), "bytes", x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), bits_sub(64, app(app(m, "gpr"), 4), 8), 8, RA))),
    "gpr", fn_update(app(m1, "gpr"), 4, bits_sub(64, app(app(m, "gpr"), 4), 8))), "rip", T) ->
  C in x86_64_linux.Machine && C in univ(1) &&
  app(C, "os") = app(m, "os") && app(C, "fs_base") = app(m, "fs_base") && app(C, "cpu") = app(m, "cpu") && app(C, "gs_base") = app(m, "gs_base") &&
  app(C, "flags") = app(m, "flags") && app(C, "gpr") = fn_update(app(m, "gpr"), 4, int_sub(app(app(s, "gpr"), 4), 16)) && app(C, "rip") = T &&
  tr.keeps_code(app(m, "vm"), app(C, "vm")) && x86.vm_fields(app(m, "vm"), app(C, "vm")) &&
  x86_64_linux.le(app(app(C, "vm"), "bytes"), int_sub(app(app(s, "gpr"), 4), 16), 8) = RA &&
  x86.pages_in(app(m, "vm"), app(C, "vm"), int_div(int_sub(app(app(s, "gpr"), 4), 16), 4096), int_div(app(app(s, "gpr"), 4), 4096)) &&
  (all a. a in bits(64) -> !(int_le(int_sub(app(app(s, "gpr"), 4), 16), a) && int_lt(a, int_sub(app(app(s, "gpr"), 4), 8))) ->
    x86_64_linux.mapped(app(m, "vm"), x86_64_linux.page_of(a)) -> app(app(app(C, "vm"), "bytes"), a) = app(app(app(m, "vm"), "bytes"), a))
proof
  fix s base code m w RA T m1 e1 C
  assume hi h16 hra ht htr hC
  let S := app(app(s, "gpr"), 4)
  let M2 := fn_update(m, "rip", RA)
  let PA := int_sub(S, 16)
  let L := int_div(int_sub(S, 16), 4096)
  let P0 := int_div(S, 4096)
  have {mM, mu, er4, sb, slt, sal, hsps} := apply(tr.inv_call, hi)
  have so: S in omega by simp(sb)
  have bs: bits_sub(64, app(app(m, "gpr"), 4), 8) = PA by defs(simp(er4, sb, h16, slt), bits_sub)
  have htr2 := rewrite(bs, htr)
  have hC2 := rewrite(bs, hC)
  have pab: PA in bits(64) by simp(sb, h16)
  have m2M: M2 in x86_64_linux.Machine by defs(simp(expand(mM, x86_64_linux.Machine), mu, hra), x86_64_linux.Machine)
  have m2u: M2 in univ(1) by simp(mu, hra)
  // (the pushed bytes: on page L, at most S's page P0, which is mapped)
  have lp _ _ _ := apply(tr.push_pages, {S}, sb, h16, slt, sal)
  have rb: x86.range_below(PA, 8, L, P0) proof
    have g: all j. j in omega -> int_lt(j, 8) ->
        int_le(L, x86_64_linux.page_of(bits_add(64, PA, bits_of_int(64, j)))) && int_le(x86_64_linux.page_of(bits_add(64, PA, bits_of_int(64, j))), P0) proof
      fix j
      assume hj hj8
      have pa1 pa2 := apply(tr.push_at, {S}, {j}, sb, h16, slt, sal, hj, hj8)
      have bs2: bits_sub(64, int_sub(S, 8), 8) = PA by defs(simp(sb, h16, slt), bits_sub)
      have pa3 := rewrite(bs2, pa1)
      have pg: x86_64_linux.page_of(bits_add(64, PA, bits_of_int(64, j))) = L by defs(simp(pa3, pa2), x86_64_linux.page_of, x86_64_linux.PAGE)
      show by simp(pg, lp, keep(x86_64_linux.page_of))
    qed
    show by defs(g, x86.range_below)
  qed
  have kpt: tr.kept(app(s, "vm"), app(m, "vm"), S) by simp(expand(hi, tr.inv), keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, abi.stack_gap_free, x86_64_linux.can_access, tr.kept, tr.keeps_code))
  have kr := mp(all_elim(expand(kpt, tr.kept), {S}), so, arith(so), arith(so))
  have kr2: app(app(app(m, "vm"), "pages"), P0) = app(app(app(s, "vm"), "pages"), P0) by defs(kr, x86_64_linux.page_of, x86_64_linux.PAGE)
  have mp0: x86_64_linux.mapped(app(M2, "vm"), P0) by defs(simp(kr2, expand(hsps, abi.stack_page, x86_64_linux.mapped)), x86_64_linux.mapped)
  have p0o: P0 in omega by simp(so)
  have pin := apply(x86.touch_range_ok_pages, {M2}, {PA}, {8}, {1}, {L}, {P0}, {m1}, {e1}, p0o, mp0, rb, htr2)
  // (m1: M2 grown, typed, its fields)
  have m1M m1u := apply(x86.touch_range_typed, {M2}, {PA}, {8}, {1}, {m1}, {e1}, m2M, m2u, htr2)
  have tv := apply(x86.touch_range_vm, {M2}, {PA}, {8}, {1}, {m1}, {e1}, htr2)
  have gr := apply(x86.touch_range_frame, {M2}, {PA}, {8}, {1}, {m1}, {e1}, simp(), htr2)
  have fl := apply(x86.touch_range_fields, {M2}, {PA}, {8}, {1}, {m1}, {e1}, htr2)
  have mf: app(m1, "os") = app(m, "os") && app(m1, "fs_base") = app(m, "fs_base") && app(m1, "cpu") = app(m, "cpu") && app(m1, "gs_base") = app(m, "gs_base") &&
    app(m1, "flags") = app(m, "flags") && app(m1, "gpr") = app(m, "gpr") && app(m1, "rip") = RA by simp(tv)
  have v1: app(m1, "vm") in x86_64_linux.Vm := apply(x86i.parts, m1M).4
  have b1: app(app(m1, "vm"), "bytes") in fn_space(bits(64), bits(8)) by simp(v1)
  // C: typed
  have su := apply(g.store_univ, {app(m1, "vm")}, {PA}, {8}, {RA}, v1)
  have v1u := mp(app_univ[u := 1, f := m1, k := "vm"], m1u)
  have nu: fn_update(app(m1, "vm"), "bytes", x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), PA, 8, RA)) in univ(1) by simp(v1u, su)
  have nv := apply(x86.store_vm, {app(m1, "vm")}, {PA}, {8}, {RA}, v1, nu)
  have mpu := apply(tr.mach_push, {m1}, {fn_update(app(m1, "vm"), "bytes", x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), PA, 8, RA))}, {PA}, {T}, m1M, m1u, nv, nu, pab, ht)
  have cM cu := rewrite(sym(hC2), mpu)
  have cf: app(C, "os") = app(m, "os") && app(C, "fs_base") = app(m, "fs_base") && app(C, "cpu") = app(m, "cpu") && app(C, "gs_base") = app(m, "gs_base") &&
    app(C, "flags") = app(m, "flags") && app(C, "gpr") = fn_update(app(m, "gpr"), 4, PA) && app(C, "rip") = T by simp(hC2, mf)
  have cvm: app(C, "vm") = fn_update(app(m1, "vm"), "bytes", x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), PA, 8, RA)) by simp(hC2)
  // its memory: fields, pages, the return address, the other bytes
  have cfl: x86.vm_fields(app(m, "vm"), app(C, "vm")) by defs(simp(cvm, expand(fl, x86.vm_fields)), x86.vm_fields)
  have cpi: x86.pages_in(app(m, "vm"), app(C, "vm"), L, P0) by defs(simp(cvm, expand(pin, x86.pages_in)), x86.pages_in)
  have rao: RA in omega by simp(hra)
  have ls := apply(tr.le_store8, {app(app(m1, "vm"), "bytes")}, {PA}, {RA}, b1, pab, rao)
  have cle: x86_64_linux.le(app(app(C, "vm"), "bytes"), PA, 8) = RA by simp(cvm, ls, hra)
  have cby: all a. a in bits(64) -> !(int_le(PA, a) && int_lt(a, int_sub(S, 8))) -> x86_64_linux.mapped(app(m, "vm"), x86_64_linux.page_of(a)) ->
      app(app(app(C, "vm"), "bytes"), a) = app(app(app(m, "vm"), "bytes"), a) proof
    fix a
    assume ha hn hm
    have ne: all i. i in omega -> int_lt(i, 8) -> !(bits_add(64, PA, bits_of_int(64, i)) = a) proof
      fix i
      assume hi0 hi8
      have pa1 _ := apply(tr.push_at, {S}, {i}, sb, h16, slt, sal, hi0, hi8)
      have bs2: bits_sub(64, int_sub(S, 8), 8) = PA by defs(simp(sb, h16, slt), bits_sub)
      have pa3 := rewrite(bs2, pa1)
      have ao: a in omega by simp(ha)
      have nq: !(int_add(int_sub(S, 16), i) = a) by arith(hn, hi0, hi8, so, ao)
      show := rewrite(sym(pa3), nq)
    qed
    have so2 := apply(x86.store_outside, {app(app(m1, "vm"), "bytes")}, {PA}, {8}, {RA}, {a}, ha, ne)
    have gb: all x0. x0 in bits(64) -> x86_64_linux.mapped(app(M2, "vm"), x86_64_linux.page_of(x0)) -> app(app(app(m1, "vm"), "bytes"), x0) = app(app(app(M2, "vm"), "bytes"), x0)
      := expand(gr, abi.vm_grows).2
    have gg := mp(all_elim(gb, {a}), ha, simp(hm))
    show by simp(cvm, so2, gg)
  qed
  // the code: kept by the push (its bytes writable or newly mapped stack)
  have kc: tr.keeps_code(app(m, "vm"), app(C, "vm")) proof
    have g: all gb gc st. gb in omega -> abi.loaded(app(m, "vm"), gb, gc, st) -> abi.loaded(app(C, "vm"), gb, gc, st) proof
      fix gb gc st
      assume hb hl
      have lc: abi.code_at(app(M2, "vm"), gb, gc) by simp(expand(hl, abi.loaded), keep(abi.code_at))
      have sc := all_elim(apply(x86.store_code, {gb}, {gc}, {M2}, {PA}, {8}, {m1}, {e1}, simp(), hb, htr2, lc), {RA})
      have cc: abi.code_at(app(C, "vm"), gb, gc) := rewrite(sym(cvm), sc)
      have stt: all x. x in omega -> x in st -> x86_64_linux.mapped(app(C, "vm"), int_div(x, x86_64_linux.PAGE)) && !abi.stack_page(app(C, "vm"), int_div(x, x86_64_linux.PAGE)) proof
        fix x
        assume hx hs
        have l0 := mp(all_elim(expand(hl, abi.loaded).2, {x}), hx, hs)
        have po: int_div(x, x86_64_linux.PAGE) in omega by defs(simp(hx), x86_64_linux.PAGE)
        have pe := apply(tr.pages_eq_mapped, {app(m, "vm")}, {app(C, "vm")}, {L}, {P0}, {int_div(x, x86_64_linux.PAGE)}, cpi, po, l0.1)
        show by defs(simp(pe, expand(l0, abi.stack_page, x86_64_linux.mapped), keep(x86_64_linux.PAGE)), abi.stack_page, x86_64_linux.mapped)
      qed
      show by defs(taut(cc, stt), abi.loaded)
    qed
    show by defs(g, tr.keeps_code)
  qed
  show by taut(cM, cu, cf, kc, cfl, cle, cpi, cby)
qed

// GIMPLE's frame at the call: the callee's entry memory cv (the world's but
// for the return address's slot, the homes, the stack grown below S's page)
theorem tr.push_frame: all s base code m w ds cv. tr.inv(s, base, code, 8, m, w) -> tr.mem(s, m, w, ds) -> int_le(16, app(app(s, "gpr"), 4)) ->
  x86.vm_fields(app(m, "vm"), cv) ->
  x86.pages_in(app(m, "vm"), cv, int_div(int_sub(app(app(s, "gpr"), 4), 16), 4096), int_div(app(app(s, "gpr"), 4), 4096)) ->
  (all a. a in bits(64) -> !(int_le(int_sub(app(app(s, "gpr"), 4), 16), a) && int_lt(a, int_sub(app(app(s, "gpr"), 4), 8))) ->
    x86_64_linux.mapped(app(m, "vm"), x86_64_linux.page_of(a)) -> app(app(cv, "bytes"), a) = app(app(app(m, "vm"), "bytes"), a)) ->
  gimple.frame_at_call(app(w, "vm"), cv, int_sub(app(app(s, "gpr"), 4), 8), app(w, "sp"))
proof
  fix s base code m w ds cv
  assume hi hmm h16 hf hp hb
  let S := app(app(s, "gpr"), 4)
  have {mM, wsp, sb, slt, sal} := apply(tr.inv_call, hi)
  have so: S in omega by simp(sb)
  have mv: app(m, "vm") in x86_64_linux.Vm := apply(x86i.parts, mM).4
  have mve := apply(tr.mem_vm_eq, {s}, {m}, {w}, {ds}, mv, hmm)
  have wst wsl wbs wbk wpe: app(app(w, "vm"), "stack_top") = app(app(m, "vm"), "stack_top") && app(app(w, "vm"), "stack_limit") = app(app(m, "vm"), "stack_limit") &&
    app(app(w, "vm"), "brk_start") = app(app(m, "vm"), "brk_start") && app(app(w, "vm"), "brk") = app(app(m, "vm"), "brk") &&
    app(app(w, "vm"), "pages") = app(app(m, "vm"), "pages") by simp(sym(mve))
  have _ _ _ pp4 := apply(tr.push_pages, {S}, sb, h16, slt, sal)
  have hiw: app(w, "sp") = int_add(S, 8) by simp(wsp, pp4)
  // the bytes outside the frame [S - 16, S + 8): the world's
  have bw: all a. a in bits(64) -> !(int_le(int_sub(int_sub(S, 8), 8), a) && int_lt(a, app(w, "sp"))) && x86_64_linux.mapped(app(w, "vm"), x86_64_linux.page_of(a)) ->
      app(app(cv, "bytes"), a) = app(app(app(w, "vm"), "bytes"), a) proof
    fix a
    assume ha h2
    have ao: a in omega by simp(ha)
    have nfr mw := rewrite(hiw, h2)
    have n1: !(int_le(int_sub(S, 16), a) && int_lt(a, int_sub(S, 8))) by arith(nfr, so, ao)
    have n2: !(int_le(int_sub(S, 8), a) && int_lt(a, S)) by arith(nfr, so, ao)
    have mm: x86_64_linux.mapped(app(m, "vm"), x86_64_linux.page_of(a)) by defs(rewrite(wpe, expand(mw, x86_64_linux.mapped)), x86_64_linux.mapped)
    have cb := mp(all_elim(hb, {a}), ha, n1, mm)
    have c1: (!ds && app(w, "vm") = app(m, "vm")) -> app(app(app(m, "vm"), "bytes"), a) = app(app(app(w, "vm"), "bytes"), a) proof
      assume h1
      show by simp(h1.2)
    qed
    have c2: (ds && fn_update(app(w, "vm"), "bytes", app(app(m, "vm"), "bytes")) = app(m, "vm") &&
        abi.agree(app(s, "vm"), abi.sp(s), app(app(m, "vm"), "bytes"), app(app(w, "vm"), "bytes")) &&
        tr.fagree(s, app(app(m, "vm"), "bytes"), app(app(w, "vm"), "bytes"))) -> app(app(app(m, "vm"), "bytes"), a) = app(app(app(w, "vm"), "bytes"), a) proof
      assume h1
      show := mp(all_elim(expand(h1.4, tr.fagree), {a}), ha, n2)
    qed
    have mw2: app(app(app(m, "vm"), "bytes"), a) = app(app(app(w, "vm"), "bytes"), a) by taut(expand(hmm, tr.mem), c1, c2)
    show := trans(cb, mw2)
  qed
  // the pages: the world's, or grown in [S - 16's page, S's page)
  have pw: all p. p in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) ->
      app(app(cv, "pages"), p) = app(app(app(w, "vm"), "pages"), p) ||
      ((int_le(int_div(int_sub(int_sub(S, 8), 8), x86_64_linux.PAGE), p) && int_lt(int_mul(p, x86_64_linux.PAGE), app(w, "sp"))) && app(app(app(w, "vm"), "pages"), p) = none) proof
    fix p
    assume hpp
    have po: p in omega by simp(hpp)
    have a := mp(all_elim(expand(hp, x86.pages_in), {p}), po)
    have l0: int_div(int_sub(S, 16), 4096) = int_div(int_sub(int_sub(S, 8), 8), 4096) by arith(so)
    have c: int_lt(p, int_div(S, 4096)) -> int_lt(int_mul(p, 4096), int_add(S, 8)) proof
      assume hlt
      show by arith(po, so, hlt)
    qed
    have pe: app(app(app(w, "vm"), "pages"), p) = app(app(app(m, "vm"), "pages"), p) by simp(wpe)
    show by defs(simp(a, pe, l0, c, hiw), x86_64_linux.PAGE)
  qed
  show by defs(simp(wst, wsl, wbs, wbk, expand(hf, x86.vm_fields), bw, pw), gimple.frame_at_call)
qed

// the callee's entry (GIMPLE's checks at the call holding on its memory):
// the ABI's entry conditions, the argument in rdi
theorem tr.callee_entry: all S C u fs. S in bits(64) -> int_le(16, S) -> int_lt(S, 140737488355328) -> int_mod(bits_add(64, S, 8), 16) = 0 ->
  app(app(C, "gpr"), 4) = int_sub(S, 16) -> app(app(C, "gpr"), 7) = u -> !app(app(C, "flags"), "df") -> app(C, "fs_base") = fs ->
  abi.thread_ok(app(C, "vm"), fs) -> abi.stack_ok(app(C, "vm"), bits_sub(64, int_sub(S, 8), 8)) ->
  abi.entry_ok(C, seq_one(u))
proof
  fix S C u fs
  assume hs h16 hl ha hr4 hr7 hdf hfs ht hk
  have bs: bits_sub(64, int_sub(S, 8), 8) = int_sub(S, 16) by defs(simp(hs, h16, hl), bits_sub)
  have hk2 := rewrite(bs, hk)
  have m1: int_mod(int_add(S, 8), 16) = 0 by simp(hs, ha, hl)
  have al: int_mod(bits_add(64, int_sub(S, 16), 8), 16) = 0 by simp(hs, h16, hl, m1)
  have ar: all x0. x0 in omega -> int_lt(x0, seq_len(seq_one(u))) -> app(app(C, "gpr"), app(abi.ARG_REGS, x0)) = app(seq_one(u), x0) proof
    fix x0
    assume h0 h1
    have l1: seq_len(seq_one(u)) = 1 by arith()
    have z: x0 = 0 by simp(h0, h1, l1)
    have ar0 := at({app(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(7), seq_one(6)), seq_one(2)), seq_one(1)), seq_one(8)), seq_one(9)), 0)})
    have u0 := at({app(seq_one(u), 0)})
    show by defs(simp(z, ar0, u0, hr7), abi.ARG_REGS)
  qed
  show by defs(simp(expand(hk2, abi.stack_ok), expand(ht, abi.thread_ok), hr4, al, hdf, ar, hfs, keep(abi.stack_page, abi.stack_gap_free, x86_64_linux.can_access, x86_64_linux.readable, abi.ARG_REGS)), abi.entry_ok)
qed

// a disciplined run returns only at its return point
theorem tr.run_d_ok: all s m x e. tr.run_d(s, m, ok(x, e)) -> tr.at_ret(s, x)
proof
  fix s m x e
  assume h
  obtain r, hw hm from expand(h, tr.run_d)
  have wi := mp(mp(mp(while_inv[l0 := pair(m, empty), c := l. true, b := l o. tr.rbd(s, l, o),
    tr := l. fn_update(empty, "os.events", app(app(fst(l), "os"), "events")), r := r, p := l. true], simp()), simp()), expand(hw, tr.rwd))
  have nd: !(ex t. r = diverge(t)) proof
    have g: (ex t. r = diverge(t)) -> false proof
      assume ed
      obtain t, ht from ed
      show by simp(expand(rewrite(ht, hm), tr.rmap))
    qed
    show by taut(g)
  qed
  have el: ex l. true && ((!true && r = ok(l, empty)) || (true && tr.rbd(s, l, r) && !is_ok(r))) by taut(wi, nd)
  obtain l, hl from el
  have hb: tr.rbd(s, l, r) by taut(hl)
  have nk: !is_ok(r) by taut(hl)
  have rr := expand(hm, tr.rmap)
  have c1: tr.disc_ok(s, fst(l)) && tr.rb(s, l, r) -> tr.at_ret(s, x) proof
    assume hd
    have b1: (!tr.at_ret(s, fst(l)) && bind_rel(x86_64_linux.step, fst(l), x7 x8. r = ok(pair(x7, empty), empty), x7 x8. r = exc(pair(x7, empty), pair("raise", x8)), x7. r = diverge(x7))) ->
        tr.at_ret(s, x) proof
      assume hb1
      obtain o2, ho2 from expand(hb1.2, bind_rel)
      have k1: (ex s1 v1. o2 = ok(s1, v1) && r = ok(pair(s1, empty), empty)) -> tr.at_ret(s, x) proof
        assume ek
        obtain s1 v1, _ re from ek
        show by simp(expand(rewrite(re, nk), is_ok))
      qed
      have k2: (ex s1 e1. o2 = exc(s1, e1) && r = exc(pair(s1, empty), pair("raise", e1))) -> tr.at_ret(s, x) proof
        assume ek
        obtain s1 e1, _ re from ek
        show by simp(expand(rewrite(re, hm), tr.rmap))
      qed
      have k3: (ex t. o2 = diverge(t) && r = diverge(t)) -> tr.at_ret(s, x) proof
        assume ek
        obtain t, _ re from ek
        show by simp(expand(rewrite(re, hm), tr.rmap))
      qed
      show by taut(ho2, k1, k2, k3)
    qed
    have b2: (!!tr.at_ret(s, fst(l)) && r = exc(pair(fst(l), empty), pair("brk", empty))) -> tr.at_ret(s, x) proof
      assume hb2
      have nar re := hb2
      have xe: x = fst(l) by simp(expand(rewrite(re, hm), tr.rmap))
      have ar: tr.at_ret(s, fst(l)) by taut(nar)
      show := rewrite(sym(xe), ar)
    qed
    show by taut(expand(hd.2, tr.rb), b1, b2)
  qed
  have c2: !tr.disc_ok(s, fst(l)) && r = exc(l, pair("raise", exc_val("disc", empty))) -> tr.at_ret(s, x) proof
    assume hd
    show by simp(expand(rewrite(hd.2, hm), tr.rmap))
  qed
  show by taut(expand(hb, tr.rbd), c1, c2)
qed

// ----------------------------------------------------------------------
//  After the callee: the loaded code, the return address

// (code at the same pages and bytes: loaded still)
theorem tr.code_at_tr: all v1 v2 gb gc. abi.code_at(v1, gb, gc) ->
  (all i. i in omega -> int_lt(i, seq_len(gc)) ->
    app(app(v2, "pages"), x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))) = app(app(v1, "pages"), x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))) &&
    app(app(v2, "bytes"), bits_of_int(64, int_add(gb, i))) = app(app(v1, "bytes"), bits_of_int(64, int_add(gb, i)))) ->
  abi.code_at(v2, gb, gc)
proof
  fix v1 v2 gb gc
  assume hc he
  have cc := expand(hc, abi.code_at)
  have r: all i. i in omega -> int_lt(i, seq_len(gc)) ->
      ((x86_64_linux.fetchable(v2, bits_of_int(64, int_add(gb, i))) && !x86_64_linux.can_access(v2, bits_of_int(64, int_add(gb, i)), 1)) &&
        !abi.stack_page(v2, x86_64_linux.page_of(bits_of_int(64, int_add(gb, i))))) &&
      app(app(v2, "bytes"), bits_of_int(64, int_add(gb, i))) = app(gc, i) proof
    fix i
    assume hi hl
    have f1 _ s1 b1 := mp(all_elim(cc, {i}), hi, hl)
    have pe be := mp(all_elim(he, {i}), hi, hl)
    have ac := apply(tr.access_page, {v2}, {v1}, {bits_of_int(64, int_add(gb, i))}, {bits_of_int(64, int_add(gb, i))}, {1}, refl({x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))}), pe)
    have f2: x86_64_linux.fetchable(v2, bits_of_int(64, int_add(gb, i))) by defs(rewrite(sym(pe), expand(f1, x86_64_linux.fetchable, x86_64_linux.mapped)), x86_64_linux.fetchable, x86_64_linux.mapped)
    have s2: !abi.stack_page(v2, x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))) by defs(rewrite(sym(pe), expand(s1, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
    have ci := mp(all_elim(cc, {i}), hi, hl)
    have b2 := trans(be, b1)
    show by taut(ci, ac, f2, s2, b2)
  qed
  show by defs(r, abi.code_at)
qed

// (a mapped, non-stack page: no scratch byte on it)
theorem tr.not_scratch: all vm sp a. a in bits(64) -> x86_64_linux.mapped(vm, x86_64_linux.page_of(a)) -> !abi.stack_page(vm, x86_64_linux.page_of(a)) ->
  !abi.scratch(vm, sp, a)
proof
  fix vm sp a
  assume ha hm hs
  have g: abi.scratch(vm, sp, a) -> false proof
    assume sc
    have lt al := expand(sc, abi.scratch)
    have ao: a in omega by simp(ha)
    have po: int_div(a, x86_64_linux.PAGE) in omega by defs(simp(ao), x86_64_linux.PAGE)
    have rg: int_le(int_div(a, x86_64_linux.PAGE), int_div(a, x86_64_linux.PAGE)) && int_le(int_div(a, x86_64_linux.PAGE), int_div(int_sub(sp, 1), x86_64_linux.PAGE))
      by defs(arith(ao, lt), x86_64_linux.PAGE)
    have c := mp(all_elim(al, {int_div(a, x86_64_linux.PAGE)}), po, rg)
    have hm2: x86_64_linux.mapped(vm, int_div(a, x86_64_linux.PAGE)) by defs(hm, x86_64_linux.page_of)
    have hs2: !abi.stack_page(vm, int_div(a, x86_64_linux.PAGE)) by defs(hs, x86_64_linux.page_of)
    show by taut(c, hm2, hs2)
  qed
  show by taut(g)
qed

// (a code byte: on a mapped, non-stack page)
theorem tr.code_page: all vm gb gc i. abi.code_at(vm, gb, gc) -> i in omega -> int_lt(i, seq_len(gc)) ->
  x86_64_linux.mapped(vm, x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))) && !abi.stack_page(vm, x86_64_linux.page_of(bits_of_int(64, int_add(gb, i))))
proof
  fix vm gb gc i
  assume hc hi hl
  have f _ ns _ := mp(all_elim(expand(hc, abi.code_at), {i}), hi, hl)
  have m: x86_64_linux.mapped(vm, x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))) by taut(expand(f, x86_64_linux.fetchable))
  show by taut(m, ns)
qed

// loaded code: seen through a callee's view of the memory
theorem tr.loaded_sv: all vv cv sp gb gc st. abi.scratch_view(vv, cv, sp) -> abi.loaded(cv, gb, gc, st) -> abi.loaded(vv, gb, gc, st)
proof
  fix vv cv sp gb gc st
  assume hs hl
  have e0 be := expand(hs, abi.scratch_view)
  have q0: app(fn_update(vv, "bytes", app(cv, "bytes")), "pages") = app(vv, "pages") by simp()
  have pe := sym(rewrite(e0, q0))
  have cc stc := expand(hl, abi.loaded)
  have he: all i. i in omega -> int_lt(i, seq_len(gc)) ->
      app(app(vv, "pages"), x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))) = app(app(cv, "pages"), x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))) &&
      app(app(vv, "bytes"), bits_of_int(64, int_add(gb, i))) = app(app(cv, "bytes"), bits_of_int(64, int_add(gb, i))) proof
    fix i
    assume hi hli
    have cpm cps := apply(tr.code_page, {cv}, {gb}, {gc}, {i}, cc, hi, hli)
    have xb: bits_of_int(64, int_add(gb, i)) in bits(64) by defs(simp(), bits_of_int, pow2)
    have ns := apply(tr.not_scratch, {cv}, {sp}, {bits_of_int(64, int_add(gb, i))}, xb, cpm, cps)
    have b := mp(all_elim(be, {bits_of_int(64, int_add(gb, i))}), xb, ns)
    have p: app(app(vv, "pages"), x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))) = app(app(cv, "pages"), x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))) by simp(pe)
    show by taut(p, b)
  qed
  have c2 := apply(tr.code_at_tr, {cv}, {vv}, {gb}, {gc}, cc, he)
  have stv: all x0. x0 in omega -> x0 in st -> x86_64_linux.mapped(vv, int_div(x0, x86_64_linux.PAGE)) && !abi.stack_page(vv, int_div(x0, x86_64_linux.PAGE)) proof
    fix x0
    assume h0 h1
    have c := mp(all_elim(stc, {x0}), h0, h1)
    show by defs(rewrite(sym(pe), expand(c, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
  qed
  show by defs(taut(c2, stv), abi.loaded)
qed

// ... and through the write-back of the callee's world wv (machine memory
// xv matching it outside the callee's scratch space)
theorem tr.loaded_wm: all cv xv wv sp gb gc st. abi.world_matches(cv, xv, wv, sp) -> abi.loaded(cv, gb, gc, st) -> abi.loaded(wv, gb, gc, st) ->
  abi.loaded(xv, gb, gc, st)
proof
  fix cv xv wv sp gb gc st
  assume hm hl hw
  have _ _ _ _ be pg := expand(hm, abi.world_matches)
  // (a page mapped in wv: xv's the same)
  have pm: all p. p in omega -> x86_64_linux.mapped(wv, p) -> app(app(xv, "pages"), p) = app(app(wv, "pages"), p) proof
    fix p
    assume hp hmp
    have mm := expand(hmp, x86_64_linux.mapped)
    have pd: p in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) by simp(hp, mm)
    have c := mp(all_elim(pg, {p}), pd)
    show by taut(c, mm)
  qed
  have ccv _ := expand(hl, abi.loaded)
  have cwv stw := expand(hw, abi.loaded)
  have he: all i. i in omega -> int_lt(i, seq_len(gc)) ->
      app(app(xv, "pages"), x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))) = app(app(wv, "pages"), x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))) &&
      app(app(xv, "bytes"), bits_of_int(64, int_add(gb, i))) = app(app(wv, "bytes"), bits_of_int(64, int_add(gb, i))) proof
    fix i
    assume hi hli
    have cpm cps := apply(tr.code_page, {cv}, {gb}, {gc}, {i}, ccv, hi, hli)
    have cwm _ := apply(tr.code_page, {wv}, {gb}, {gc}, {i}, cwv, hi, hli)
    have xb: bits_of_int(64, int_add(gb, i)) in bits(64) by defs(simp(), bits_of_int, pow2)
    have po: x86_64_linux.page_of(bits_of_int(64, int_add(gb, i))) in omega by defs(simp(xb), x86_64_linux.page_of, x86_64_linux.PAGE)
    have ns := apply(tr.not_scratch, {cv}, {sp}, {bits_of_int(64, int_add(gb, i))}, xb, cpm, cps)
    have b := mp(all_elim(be, {bits_of_int(64, int_add(gb, i))}), xb, ns)
    have p := mp(all_elim(pm, {x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))}), po, cwm)
    show by taut(p, b)
  qed
  have c2 := apply(tr.code_at_tr, {wv}, {xv}, {gb}, {gc}, cwv, he)
  have stx: all x0. x0 in omega -> x0 in st -> x86_64_linux.mapped(xv, int_div(x0, x86_64_linux.PAGE)) && !abi.stack_page(xv, int_div(x0, x86_64_linux.PAGE)) proof
    fix x0
    assume h0 h1
    have c := mp(all_elim(stw, {x0}), h0, h1)
    have po: int_div(x0, x86_64_linux.PAGE) in omega by defs(simp(h0), x86_64_linux.PAGE)
    have p := mp(all_elim(pm, {int_div(x0, x86_64_linux.PAGE)}), po, c.1)
    show by defs(rewrite(sym(p), expand(c, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
  qed
  show by defs(taut(c2, stx), abi.loaded)
qed

// (8 bytes the same: so their little-endian read)
theorem tr.le_eq8: all b1 b2 a. (all j. j in omega -> int_lt(j, 8) -> app(b1, bits_add(64, a, bits_of_int(64, j))) = app(b2, bits_add(64, a, bits_of_int(64, j)))) ->
  x86_64_linux.le(b1, a, 8) = x86_64_linux.le(b2, a, 8)
proof
  fix b1 b2 a
  assume h
  have k0 := mp(all_elim(h, {0}), simp(), simp())
  have k1 := mp(all_elim(h, {1}), simp(), simp())
  have k2 := mp(all_elim(h, {2}), simp(), simp())
  have k3 := mp(all_elim(h, {3}), simp(), simp())
  have k4 := mp(all_elim(h, {4}), simp(), simp())
  have k5 := mp(all_elim(h, {5}), simp(), simp())
  have k6 := mp(all_elim(h, {6}), simp(), simp())
  have k7 := mp(all_elim(h, {7}), simp(), simp())
  show by defs(simp(k0, k1, k2, k3, k4, k5, k6, k7), x86_64_linux.le)
qed

// The callee's spec, program-wide: on a return, the input as it was, the
// events grown, the program loaded still
def tr.callee_io(g) := all args w w2 r. w in abi.World -> runs(app(g, args), w, ok(w2, r)) ->
  app(app(w2, "os"), "input") = app(app(w, "os"), "input") && subset(app(app(w, "os"), "events"), app(app(w2, "os"), "events")) &&
  (all gb gc st. gb in omega -> abi.loaded(app(w, "vm"), gb, gc, st) -> abi.loaded(app(w2, "vm"), gb, gc, st))

// (the callee's spec typed, as the ABI has specs: its runs in univ(1))
theorem tr.spec_univ: all g args w o. g in fn_space(abi.ARGS, powerset(univ(1))) -> args in abi.ARGS -> runs(app(g, args), w, o) -> pair(w, o) in univ(1)
proof
  fix g args w o
  assume hg ha hr
  have pa := mp(mp(fn_space_app[a := abi.ARGS, b := powerset(univ(1)), f := g, x := args], hg), ha)
  have ss: subset(app(g, args), univ(1)) by taut(powerset_def[s := univ(1), a := app(g, args)], pa)
  show := mp(subset_elim[a := app(g, args), b := univ(1), z := pair(w, o)], ss, expand(hr, runs))
qed

// (an outcome of a type: a return, an exception, a divergence)
theorem tr.outcome_cases: all S V x0. x0 in outcome_type(S, V) ->
  (ex a b. a in S && b in V && x0 = ok(a, b)) || (ex a b. a in S && b in univ(1) && x0 = exc(a, b)) || (ex t. t in univ(1) && x0 = diverge(t))
proof
  fix S V x0
  assume h
  have u1 := union2_iff[a := set_image(cart(S, V), z. ok(fst(z), snd(z))), b := union2(set_image(cart(S, univ(1)), z. exc(fst(z), snd(z))), set_image(univ(1), t. diverge(t))), z := x0]
  have u2 := union2_iff[a := set_image(cart(S, univ(1)), z. exc(fst(z), snd(z))), b := set_image(univ(1), t. diverge(t)), z := x0]
  have s1 := set_image_def[s := cart(S, V), f := z. ok(fst(z), snd(z)), y := x0]
  have s2 := set_image_def[s := cart(S, univ(1)), f := z. exc(fst(z), snd(z)), y := x0]
  have s3 := set_image_def[s := univ(1), f := t. diverge(t), y := x0]
  have hh: x0 in union2(set_image(cart(S, V), z. ok(fst(z), snd(z))), union2(set_image(cart(S, univ(1)), z. exc(fst(z), snd(z))), set_image(univ(1), t. diverge(t)))) by defs(h, outcome_type)
  have c1: (ex z. z in cart(S, V) && ok(fst(z), snd(z)) = x0) -> (ex a b. a in S && b in V && x0 = ok(a, b)) proof
    assume e
    obtain z, hz from e
    obtain a b, hb from mp(cart_elim[a := S, b := V, z := z], hz.1)
    have eq: x0 = ok(a, b) by simp(hz, hb)
    show by ex_intro({a}, {b}, taut(hb, eq))
  qed
  have c2: (ex z. z in cart(S, univ(1)) && exc(fst(z), snd(z)) = x0) -> (ex a b. a in S && b in univ(1) && x0 = exc(a, b)) proof
    assume e
    obtain z, hz from e
    obtain a b, hb from mp(cart_elim[a := S, b := univ(1), z := z], hz.1)
    have eq: x0 = exc(a, b) by simp(hz, hb)
    show by ex_intro({a}, {b}, taut(hb, eq))
  qed
  have c3: (ex t. t in univ(1) && diverge(t) = x0) -> (ex t. t in univ(1) && x0 = diverge(t)) proof
    assume e
    obtain t, ht from e
    have eq: x0 = diverge(t) by simp(ht)
    show by ex_intro({t}, taut(ht, eq))
  qed
  show by taut(hh, u1, u2, s1, s2, s3, c1, c2, c3)
qed

// a crash's I/O: that of the function's overflow (or divergence) from w
theorem tr.ovf_exc: all p w os x. x in rec_and(abi.World, single(empty)) -> runs(p, w, exc(x, exc_val("stack_overflow", empty))) ->
  app(app(x, "os"), "events") = app(os, "events") -> tr.ovf(p, w, os)
proof
  fix p w os x
  assume hx hr hev
  have ou: exc_val("stack_overflow", empty) in univ(1) by defs(simp(), exc_val)
  have ot := mp(mp(exc_outcome_type[s := rec_and(abi.World, single(empty)), v := cart(bits(64), bits(64)), x := x, e := exc_val("stack_overflow", empty)], hx), ou)
  have it1 := apply(tr.ite_f, {fst(exc(x, exc_val("stack_overflow", empty))) = 0}, {app(app(fst(snd(exc(x, exc_val("stack_overflow", empty)))), "os"), "events") = app(os, "events")},
    {ite(fst(exc(x, exc_val("stack_overflow", empty))) = 1, snd(snd(exc(x, exc_val("stack_overflow", empty)))) = exc_val("stack_overflow", empty) &&
      app(app(fst(snd(exc(x, exc_val("stack_overflow", empty)))), "os"), "events") = app(os, "events"), app(snd(exc(x, exc_val("stack_overflow", empty))), "os.events") = app(os, "events"))}, simp())
  have it2 := apply(tr.ite_t, {fst(exc(x, exc_val("stack_overflow", empty))) = 1}, {snd(snd(exc(x, exc_val("stack_overflow", empty)))) = exc_val("stack_overflow", empty) &&
      app(app(fst(snd(exc(x, exc_val("stack_overflow", empty)))), "os"), "events") = app(os, "events")}, {app(snd(exc(x, exc_val("stack_overflow", empty))), "os.events") = app(os, "events")}, simp())
  have cc: snd(snd(exc(x, exc_val("stack_overflow", empty)))) = exc_val("stack_overflow", empty) &&
      app(app(fst(snd(exc(x, exc_val("stack_overflow", empty)))), "os"), "events") = app(os, "events") by simp(hev)
  have iv := rewrite(sym(trans(it1, it2)), cc)
  show by defs(ex_intro({exc(x, exc_val("stack_overflow", empty))}, taut(ot, hr, iv)), tr.ovf)
qed

theorem tr.ovf_div: all p w os t. t in univ(1) -> runs(p, w, diverge(t)) -> app(t, "os.events") = app(os, "events") -> tr.ovf(p, w, os)
proof
  fix p w os t
  assume ht hr hev
  have si := set_image_def[s := univ(1), f := t0. diverge(t0), y := diverge(t)]
  have ex1: ex t0. t0 in univ(1) && diverge(t0) = diverge(t) by ex_intro({t}, taut(ht, refl({diverge(t)})))
  have m3: diverge(t) in set_image(univ(1), t0. diverge(t0)) by taut(si, ex1)
  have u1 := union2_iff[a := set_image(cart(rec_and(abi.World, single(empty)), cart(bits(64), bits(64))), z. ok(fst(z), snd(z))),
    b := union2(set_image(cart(rec_and(abi.World, single(empty)), univ(1)), z. exc(fst(z), snd(z))), set_image(univ(1), t0. diverge(t0))), z := diverge(t)]
  have u2 := union2_iff[a := set_image(cart(rec_and(abi.World, single(empty)), univ(1)), z. exc(fst(z), snd(z))), b := set_image(univ(1), t0. diverge(t0)), z := diverge(t)]
  have ot: diverge(t) in outcome_type(rec_and(abi.World, single(empty)), cart(bits(64), bits(64))) by defs(taut(m3, u1, u2), outcome_type)
  have it1 := apply(tr.ite_f, {fst(diverge(t)) = 0}, {app(app(fst(snd(diverge(t))), "os"), "events") = app(os, "events")},
    {ite(fst(diverge(t)) = 1, snd(snd(diverge(t))) = exc_val("stack_overflow", empty) && app(app(fst(snd(diverge(t))), "os"), "events") = app(os, "events"),
      app(snd(diverge(t)), "os.events") = app(os, "events"))}, simp())
  have it2 := apply(tr.ite_f, {fst(diverge(t)) = 1}, {snd(snd(diverge(t))) = exc_val("stack_overflow", empty) && app(app(fst(snd(diverge(t))), "os"), "events") = app(os, "events")},
    {app(snd(diverge(t)), "os.events") = app(os, "events")}, simp())
  have cc: app(snd(diverge(t)), "os.events") = app(os, "events") by simp(hev)
  have iv := rewrite(sym(trans(it1, it2)), cc)
  show by defs(ex_intro({diverge(t)}, taut(ot, hr, iv)), tr.ovf)
qed

// (subsets: transitive)
theorem tr.subset_trans: all a b c. subset(a, b) -> subset(b, c) -> subset(a, c)
proof
  fix a b c
  assume h1 h2
  have g: all z. z in a -> z in c proof
    fix z
    assume hz
    have zb := mp(subset_elim[a := a, b := b, z := z], h1, hz)
    show := mp(subset_elim[a := b, b := c, z := z], h2, zb)
  qed
  show by defs(g, subset)
qed

// The coupling after the callee returned (x, its world w2, the caller's
// frame [S - 8, S + 8) as at the call): the caller's world W3, the result
// in rax, the homes gone (the spec's world is the machine's again)
theorem tr.post_call: all s base code m w C x w2 vv g regs.
  tr.inv(s, base, code, 8, m, w) -> base in omega -> int_le(16, app(app(s, "gpr"), 4)) ->
  C in x86_64_linux.Machine -> C in univ(1) -> app(C, "os") = app(m, "os") -> app(C, "cpu") = app(m, "cpu") -> app(C, "gs_base") = app(m, "gs_base") ->
  app(C, "gpr") = fn_update(app(m, "gpr"), 4, int_sub(app(app(s, "gpr"), 4), 16)) -> tr.keeps_code(app(m, "vm"), app(C, "vm")) ->
  x86.pages_in(app(m, "vm"), app(C, "vm"), int_div(int_sub(app(app(s, "gpr"), 4), 16), 4096), int_div(app(app(s, "gpr"), 4), 4096)) ->
  (all a. a in bits(64) -> !(int_le(int_sub(app(app(s, "gpr"), 4), 16), a) && int_lt(a, int_sub(app(app(s, "gpr"), 4), 8))) ->
    x86_64_linux.mapped(app(m, "vm"), x86_64_linux.page_of(a)) -> app(app(app(C, "vm"), "bytes"), a) = app(app(app(m, "vm"), "bytes"), a)) ->
  vv in x86_64_linux.Vm -> vv in univ(1) -> abi.scratch_view(vv, app(C, "vm"), abi.sp(C)) ->
  tr.callee_io(g) -> runs(app(g, regs), abi.view(vv, C), ok(w2, pair(app(app(x, "gpr"), 0), app(app(x, "gpr"), 2)))) ->
  x in x86_64_linux.Machine -> x in univ(1) -> w2 in abi.World -> w2 in univ(1) ->
  abi.world_matches(app(C, "vm"), app(x, "vm"), app(w2, "vm"), abi.sp(C)) -> app(x, "os") = app(w2, "os") -> app(x, "fs_base") = app(w2, "fs_base") ->
  app(x, "cpu") = app(C, "cpu") -> app(x, "gs_base") = app(C, "gs_base") -> app(app(x, "gpr"), 4) = abi.sp(C) ->
  abi.callee_saved(x, C) -> !app(app(x, "flags"), "df") ->
  tr.frame_same(app(x, "vm"), app(C, "vm"), int_sub(app(app(s, "gpr"), 4), 8), app(w, "sp")) ->
  tr.inv(s, base, code, 8, x, fn_update(fn_update(fn_update(fn_update(w, "vm", app(C, "vm")), "vm", app(x, "vm")), "os", app(w2, "os")), "fs_base", app(w2, "fs_base"))) &&
  tr.mem(s, x, fn_update(fn_update(fn_update(fn_update(w, "vm", app(C, "vm")), "vm", app(x, "vm")), "os", app(w2, "os")), "fs_base", app(w2, "fs_base")), false) &&
  tr.homes(s, x, empty) && tr.regs(x, fn_update(empty, 0, pair(8, app(app(x, "gpr"), 0))))
proof
  fix s base code m w C x w2 vv g regs
  assume hi hb h16 cM cu cos ccpu cgs cgpr ckc cpi cby hvv hvvu hsv hio hg xM xu w2W w2u hwm xos xfs xcpu xgs xr4 xcs xdf hfs
  let S := app(app(s, "gpr"), 4)
  let W1 := fn_update(w, "vm", app(C, "vm"))
  let W3 := fn_update(fn_update(fn_update(W1, "vm", app(x, "vm")), "os", app(w2, "os")), "fs_base", app(w2, "fs_base"))
  have ic := apply(tr.inv_call, hi)
  have {wW, wu, wsp0 = wsp, wcpu, mos, sb, slt, sal, hsps, winp, sws, mcpu, mgs} := ic
  have i := expand(hi, tr.inv)
  have so: S in omega by simp(sb)
  have m1: int_mod(int_add(S, 8), 16) = 0 by simp(sb, sal, slt)
  have m2: int_le(8, int_mod(S, 4096)) && int_le(int_mod(S, 4096), 4088) by simp(sb, m1)
  // the callee's sp: S - 8; the caller's sp: S + 8
  have csp: abi.sp(C) = int_sub(S, 8) by simp(cgpr, sb, h16, slt)
  have _ _ _ pp4 := apply(tr.push_pages, {S}, sb, h16, slt, sal)
  have wsp: app(w, "sp") = int_add(S, 8) by simp(wsp0, pp4)
  have fs := expand(hfs, tr.frame_same)
  // the callee's spec: input kept, events grown, the program loaded still
  have vt := apply(abi.world_typed, {C}, {vv}, {abi.sp(C)}, cM, hvv, simp(csp, sb, h16), simp(cu, hvvu, csp, sb, h16))
  have io := mp(all_elim(expand(hio, tr.callee_io), {regs}, {abi.view(vv, C)}, {w2}, {pair(app(app(x, "gpr"), 0), app(app(x, "gpr"), 2))}), vt, hg)
  have ioi ioe iol := io
  // the code loaded at the entry: loaded still (the push, the callee's view, its spec, the write-back)
  have kc: tr.keeps_code(app(s, "vm"), app(x, "vm")) proof
    have g0: all gb gc st. gb in omega -> abi.loaded(app(s, "vm"), gb, gc, st) -> abi.loaded(app(x, "vm"), gb, gc, st) proof
      fix gb gc st
      assume hgb hl
      have km: tr.keeps_code(app(s, "vm"), app(m, "vm")) by simp(i, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, abi.stack_gap_free, x86_64_linux.can_access, tr.kept, tr.keeps_code))
      have l1 := mp(all_elim(expand(km, tr.keeps_code), {gb}, {gc}, {st}), hgb, hl)
      have l2 := mp(all_elim(expand(ckc, tr.keeps_code), {gb}, {gc}, {st}), hgb, l1)
      have l3 := apply(tr.loaded_sv, {vv}, {app(C, "vm")}, {abi.sp(C)}, {gb}, {gc}, {st}, hsv, l2)
      have l3v: abi.loaded(app(abi.view(vv, C), "vm"), gb, gc, st) by simp(l3, keep(abi.loaded))
      have l4 := mp(all_elim(iol, {gb}, {gc}, {st}), hgb, l3v)
      show := apply(tr.loaded_wm, {app(C, "vm")}, {app(x, "vm")}, {app(w2, "vm")}, {abi.sp(C)}, {gb}, {gc}, {st}, hwm, l2, l4)
    qed
    show by defs(g0, tr.keeps_code)
  qed
  // the function's own code: as loaded code without statics
  have cm: abi.code_at(app(m, "vm"), base, code) by simp(i, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, abi.stack_gap_free, x86_64_linux.can_access, tr.kept, tr.keeps_code))
  have lm: abi.loaded(app(m, "vm"), base, code, empty) by defs(simp(cm, keep(abi.code_at)), abi.loaded)
  have lx: abi.loaded(app(x, "vm"), base, code, empty) proof
    have l2 := mp(all_elim(expand(ckc, tr.keeps_code), {base}, {code}, {empty}), hb, lm)
    have l3 := apply(tr.loaded_sv, {vv}, {app(C, "vm")}, {abi.sp(C)}, {base}, {code}, {empty}, hsv, l2)
    have l3v: abi.loaded(app(abi.view(vv, C), "vm"), base, code, empty) by simp(l3, keep(abi.loaded))
    have l4 := mp(all_elim(iol, {base}, {code}, {empty}), hb, l3v)
    show := apply(tr.loaded_wm, {app(C, "vm")}, {app(x, "vm")}, {app(w2, "vm")}, {abi.sp(C)}, {base}, {code}, {empty}, hwm, l2, l4)
  qed
  have cx _ := expand(lx, abi.loaded)
  // the frame [S - 8, S + 8): as at the call, so as before it
  have ina: all a. a in omega -> int_le(int_sub(S, 8), a) -> int_lt(a, int_add(S, 8)) ->
      app(app(app(x, "vm"), "bytes"), a) = app(app(app(m, "vm"), "bytes"), a) &&
      app(app(app(x, "vm"), "pages"), x86_64_linux.page_of(a)) = app(app(app(s, "vm"), "pages"), x86_64_linux.page_of(a)) proof
    fix a
    assume ha h1 h2
    have ab: a in bits(64) by simp(ha, h2, slt)
    have rg: int_le(int_sub(S, 8), a) && int_lt(a, app(w, "sp")) by simp(h1, h2, wsp)
    have f1 := mp(all_elim(fs, {a}), ab, rg)
    have pa: x86_64_linux.page_of(a) = int_div(S, 4096) by defs(simp(ha, h1, h2, m2, so), x86_64_linux.page_of, x86_64_linux.PAGE)
    have kpt: tr.kept(app(s, "vm"), app(m, "vm"), S) by simp(i, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, abi.stack_gap_free, x86_64_linux.can_access, tr.kept, tr.keeps_code))
    have kr := mp(all_elim(expand(kpt, tr.kept), {a}), ha, h1, h2)
    have mm0: x86_64_linux.mapped(app(s, "vm"), x86_64_linux.page_of(a)) by defs(simp(pa, expand(hsps, abi.stack_page)), abi.stack_page)
    have mm: x86_64_linux.mapped(app(m, "vm"), x86_64_linux.page_of(a)) by defs(rewrite(sym(kr), expand(mm0, x86_64_linux.mapped)), x86_64_linux.mapped)
    have po: x86_64_linux.page_of(a) in omega by simp(pa, so)
    have pe := apply(tr.pages_eq_mapped, {app(m, "vm")}, {app(C, "vm")}, {int_div(int_sub(S, 16), 4096)}, {int_div(S, 4096)}, {x86_64_linux.page_of(a)}, cpi, po, mm)
    have nb: !(int_le(int_sub(S, 16), a) && int_lt(a, int_sub(S, 8))) by arith(h1)
    have cb := mp(all_elim(cby, {a}), ab, nb, mm)
    have b: app(app(app(x, "vm"), "bytes"), a) = app(app(app(m, "vm"), "bytes"), a) by simp(f1, cb)
    have p: app(app(app(x, "vm"), "pages"), x86_64_linux.page_of(a)) = app(app(app(s, "vm"), "pages"), x86_64_linux.page_of(a)) by simp(f1, pe, kr)
    show by taut(b, p)
  qed
  have kx: tr.kept(app(s, "vm"), app(x, "vm"), S) proof
    have g0: all a. a in omega -> int_le(int_sub(S, 8), a) -> int_lt(a, int_add(S, 8)) ->
        app(app(app(x, "vm"), "pages"), x86_64_linux.page_of(a)) = app(app(app(s, "vm"), "pages"), x86_64_linux.page_of(a)) proof
      fix a
      assume ha h1 h2
      show := mp(all_elim(ina, {a}), ha, h1, h2).2
    qed
    show by defs(g0, tr.kept)
  qed
  have rx: x86_64_linux.le(app(app(x, "vm"), "bytes"), S, 8) = abi.ret(s) proof
    have eq: all j. j in omega -> int_lt(j, 8) -> app(app(app(x, "vm"), "bytes"), bits_add(64, S, bits_of_int(64, j))) = app(app(app(m, "vm"), "bytes"), bits_add(64, S, bits_of_int(64, j))) proof
      fix j
      assume hj hj8
      have e: bits_add(64, S, bits_of_int(64, j)) = int_add(S, j) by simp(sb, slt, hj, hj8)
      have c1 _ := mp(all_elim(ina, {int_add(S, j)}), simp(so, hj), arith(hj), arith(hj8))
      show := rewrite(sym(e), c1)
    qed
    have le := apply(tr.le_eq8, {app(app(x, "vm"), "bytes")}, {app(app(m, "vm"), "bytes")}, {S}, eq)
    have lm2: x86_64_linux.le(app(app(m, "vm"), "bytes"), S, 8) = abi.ret(s) by simp(i, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, abi.stack_gap_free, x86_64_linux.can_access, tr.kept, tr.keeps_code))
    show := trans(le, lm2)
  qed
  // the rest of the coupling
  have e3 := mp(app_update_other[f := app(m, "gpr"), k := 4, v := int_sub(S, 16), x := 3], simp())
  have e5 := mp(app_update_other[f := app(m, "gpr"), k := 4, v := int_sub(S, 16), x := 5], simp())
  have e12 := mp(app_update_other[f := app(m, "gpr"), k := 4, v := int_sub(S, 16), x := 12], simp())
  have e13 := mp(app_update_other[f := app(m, "gpr"), k := 4, v := int_sub(S, 16), x := 13], simp())
  have e14 := mp(app_update_other[f := app(m, "gpr"), k := 4, v := int_sub(S, 16), x := 14], simp())
  have e15 := mp(app_update_other[f := app(m, "gpr"), k := 4, v := int_sub(S, 16), x := 15], simp())
  have cs: abi.callee_saved(x, s) by simp(xcs, cgpr, e3, e5, e12, e13, e14, e15, i, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, abi.stack_gap_free, x86_64_linux.can_access, tr.kept, tr.keeps_code))
  have r4: app(app(x, "gpr"), 4) = int_sub(S, 8) by simp(xr4, csp)
  have ri: app(app(W3, "os"), "input") = app(app(s, "os"), "input") by simp(ioi, xos, cos, mos, winp)
  have sv: app(app(abi.view(vv, C), "os"), "events") = app(app(w, "os"), "events") by simp(cos, mos)
  have sw3 := rewrite(sv, ioe)
  have se := apply(tr.subset_trans, {app(app(s, "os"), "events")}, {app(app(w, "os"), "events")}, {app(app(w2, "os"), "events")}, sws, sw3)
  have se3: subset(app(app(s, "os"), "events"), app(app(W3, "os"), "events")) by simp(se)
  // (W3: a world)
  have cv: app(C, "vm") in x86_64_linux.Vm := apply(x86i.parts, cM).4
  have cvu := mp(app_univ[u := 1, f := C, k := "vm"], cu)
  have _ _ w1W w1u := apply(tr.world_set, {w}, {app(C, "vm")}, {app(w, "os")}, {app(w, "fs_base")}, wW, wu, cv, cvu, simp(expand(wW, abi.World)), mp(app_univ[u := 1, f := w, k := "os"], wu), simp(expand(wW, abi.World)))
  have xv: app(x, "vm") in x86_64_linux.Vm := apply(x86i.parts, xM).4
  have xvu := mp(app_univ[u := 1, f := x, k := "vm"], xu)
  have w2f := expand(w2W, abi.World)
  have w3W w3u _ _ := apply(tr.world_set, {W1}, {app(x, "vm")}, {app(w2, "os")}, {app(w2, "fs_base")}, w1W, w1u, xv, xvu, simp(w2f), mp(app_univ[u := 1, f := w2, k := "os"], w2u), simp(w2f))
  have oth: app(x, "cpu") = app(s, "cpu") && app(x, "gs_base") = app(s, "gs_base") && app(x, "os") = app(W3, "os") && app(x, "fs_base") = app(W3, "fs_base") &&
    app(W3, "cpu") = app(s, "cpu") && app(W3, "sp") = abi.sp(s) by simp(xcpu, ccpu, xgs, cgs, xos, xfs, mcpu, mgs, wcpu, wsp0)
  have sf: s in x86_64_linux.Machine && x86_64_linux.can_access(app(s, "vm"), S, 1) && int_mod(bits_add(64, S, 8), 16) = 0 &&
    abi.stack_page(app(s, "vm"), int_div(S, 4096)) && int_lt(S, 140737488355328) && abi.stack_gap_free(app(s, "vm")) by simp(i, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, abi.stack_gap_free, x86_64_linux.can_access, tr.kept, tr.keeps_code))
  have f8: 8 in omega by simp()
  have inv2: tr.inv(s, base, code, 8, x, W3) by defs(taut(xM, xu, cx, kc, r4, f8, kx, rx, cs, oth, xdf, ri, se3, w3W, w3u, sf), tr.inv)
  have mem2: tr.mem(s, x, W3, false) by defs(simp(), tr.mem)
  have hom: tr.homes(s, x, empty) by defs(simp(dom_empty), tr.homes)
  have r0R: 0 in x86_64_linux.Reg by simp()
  have r0 := mp(mp(all_elim(x86i.reg_typed, {x}, {0}), xM), r0R)
  have re0: tr.regs(x, empty) by defs(simp(dom_empty), tr.regs)
  have rs1 := apply(tr.regs_set, {x}, {empty}, {0}, {8}, {app(app(x, "gpr"), 0)}, re0, simp(r0))
  have _ xg _ _ := apply(x86i.parts, xM)
  have gfd: is_fun(app(x, "gpr")) && dom(app(x, "gpr")) = x86_64_linux.Reg by simp(expand(xg, fn_space))
  have xfd: is_fun(x) && "gpr" in dom(x) by simp(expand(xM, x86_64_linux.Machine))
  have g0 := mp(mp(fn_update_same[f := app(x, "gpr"), k := 0], gfd.1), simp(gfd))
  have x0 := mp(mp(fn_update_same[f := x, k := "gpr"], xfd.1), xfd.2)
  have rs2 := rewrite(x0, rewrite(g0, rs1))
  have rg: tr.regs(x, fn_update(empty, 0, pair(8, app(app(x, "gpr"), 0)))) := rs2
  show by taut(inv2, mem2, hom, rg)
qed

// (the world the callee's contract shows it: the one GIMPLE's call shows it)
theorem tr.callee_world_eq: all s base code m w C vv. tr.inv(s, base, code, 8, m, w) -> int_le(16, app(app(s, "gpr"), 4)) ->
  app(C, "os") = app(m, "os") -> app(C, "fs_base") = app(m, "fs_base") -> app(C, "cpu") = app(m, "cpu") ->
  app(app(C, "gpr"), 4) = int_sub(app(app(s, "gpr"), 4), 16) ->
  abi.view(vv, C) = fn_update(fn_update(fn_update(fn_update(fn_update(empty, "vm", vv), "os", app(w, "os")), "fs_base", app(w, "fs_base")), "cpu", app(w, "cpu")), "sp",
    int_sub(app(app(s, "gpr"), 4), 8)) && abi.sp(C) = int_sub(app(app(s, "gpr"), 4), 8)
proof
  fix s base code m w C vv
  assume hi h16 co cf cc c4
  have {wcpu, mos, mfs, sb, slt, mcpu} := apply(tr.inv_call, hi)
  have sp: abi.sp(C) = int_sub(app(app(s, "gpr"), 4), 8) by simp(c4, sb, h16, slt)
  have v: abi.view(vv, C) = fn_update(fn_update(fn_update(fn_update(fn_update(empty, "vm", vv), "os", app(w, "os")), "fs_base", app(w, "fs_base")), "cpu", app(w, "cpu")), "sp",
    int_sub(app(app(s, "gpr"), 4), 8)) by simp(sp, co, cf, cc, mos, mfs, mcpu, wcpu)
  show by taut(v, sp)
qed

// A crash of the callee (its contract's crash case): the caller's crash --
// below the callee's sp, so below the caller's; the I/O that of the
// callee's spec where it stops, so of the caller's (GIMPLE's call
// overflowing after the callee returned, the callee's overflow, its
// divergence)
theorem tr.callee_crash(g, ar, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all s base code m w C u vv o.
  tr.inv(s, base, code, 8, m, w) -> int_le(16, app(app(s, "gpr"), 4)) ->
  app(C, "os") = app(m, "os") -> app(C, "fs_base") = app(m, "fs_base") -> app(C, "cpu") = app(m, "cpu") -> app(app(C, "gpr"), 4) = int_sub(app(app(s, "gpr"), 4), 16) ->
  app(C, "vm") in x86_64_linux.Vm -> app(C, "vm") in univ(1) -> vv in x86_64_linux.Vm -> vv in univ(1) -> abi.scratch_view(vv, app(C, "vm"), int_sub(app(app(s, "gpr"), 4), 8)) ->
  runs(gimple.call_enter(app(w, "sp"), app(w, "sp"), seq_one(ar)), w, ok(fn_update(w, "vm", app(C, "vm")), pair(seq_one(u), int_sub(app(app(s, "gpr"), 4), 8)))) ->
  g in fn_space(abi.ARGS, powerset(univ(1))) -> seq_one(u) in abi.ARGS ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) ->
  (all t. t in univ(1) -> runs(mkprog(x0 x1. ex x8. dd(t, x8) && k(x8, x1)), w, diverge(t))) ->
  abi.crashes_at(g, seq_one(u), C, vv, o) ->
  tr.crash(s, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, seq_one(ar)), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, o)
proof
  fix s base code m w C u vv o
  assume hi h16 co cf cc c4 cv cvu hvv hvvu hsv hen hgt hA hk hd hc
  let S := app(app(s, "gpr"), 4)
  let P := mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, seq_one(ar)), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))
  let WV := fn_update(fn_update(fn_update(fn_update(fn_update(empty, "vm", vv), "os", app(w, "os")), "fs_base", app(w, "fs_base")), "cpu", app(w, "cpu")), "sp", int_sub(S, 8))
  have {wW, wu, mos, sb, slt, sal, winp, sws} := apply(tr.inv_call, hi)
  have s8b: int_sub(S, 8) in bits(64) by simp(sb, h16)
  have weq spc := apply(tr.callee_world_eq, {s}, {base}, {code}, {m}, {w}, {C}, {vv}, hi, h16, co, cf, cc, c4)
  obtain m1 a0 k0, oe kk m1M ab ovat sev ovk from expand(hc, abi.crashes_at)
  // the address: below the caller's sp too
  have _ _ _ pp4 := apply(tr.push_pages, {S}, sb, h16, slt, sal)
  have ov2: abi.overflow_at(app(m1, "vm"), app(app(m1, "gpr"), 4), abi.sp(s), a0) proof
    have lt al := expand(rewrite(spc, ovat), abi.overflow_at)
    have lt2: int_lt(a0, abi.sp(s)) by simp(lt, pp4)
    show by defs(taut(al, lt2), abi.overflow_at)
  qed
  // the I/O so far: the input as at the entry, the events grown since
  have sev2 := rewrite(trans(co, mos), sev)
  have sub := apply(tr.subset_trans, {app(app(s, "os"), "events")}, {app(app(w, "os"), "events")}, {app(app(m1, "os"), "events")}, sws, sev2)
  have inp0 ex0 := expand(ovk, abi.overflow_ok)
  have inp1: app(app(C, "os"), "input") = app(app(m1, "os"), "input") by simp(inp0)
  have inp2 := rewrite(trans(co, mos), inp1)
  have inp := trans(sym(winp), inp2)
  // the spec's point where the I/O stops: the caller's spec stops there too
  obtain x0, hx0t hx0ri from ex0
  have hx0r hit := hx0ri
  have hx0r2 := rewrite(weq, hx0r)
  have pu := apply(tr.spec_univ, {g}, {seq_one(u)}, {WV}, {x0}, hgt, hA, hx0r2)
  have w1v: app(fn_update(w, "vm", app(C, "vm")), "vm") = app(C, "vm") by simp()
  have ovf: tr.ovf(P, w, app(m1, "os")) proof
    have cs := apply(tr.outcome_cases, {rec_and(abi.World, single(empty))}, {cart(bits(64), bits(64))}, {x0}, hx0t)
    // the callee returned (its I/O the crash's): GIMPLE's call overflows after it
    have c1: (ex a b. a in rec_and(abi.World, single(empty)) && b in cart(bits(64), bits(64)) && x0 = ok(a, b)) -> tr.ovf(P, w, app(m1, "os")) proof
      assume e
      obtain xw r, xa _ xe from e
      have xW := apply(tr.and_world, xa)
      have pu2 := rewrite(xe, pu)
      have xu: xw in univ(1) by simp(pu2)
      have ru: r in univ(1) by simp(pu2)
      have it := apply(tr.ite_t, {fst(x0) = 0}, {app(app(fst(snd(x0)), "os"), "events") = app(app(m1, "os"), "events")},
        {ite(fst(x0) = 1, snd(snd(x0)) = exc_val("stack_overflow", empty) && app(app(fst(snd(x0)), "os"), "events") = app(app(m1, "os"), "events"),
          app(snd(x0), "os.events") = app(app(m1, "os"), "events"))}, simp(xe))
      have ev0 := rewrite(it, hit)
      have ev: app(app(xw, "os"), "events") = app(app(m1, "os"), "events") by simp(rewrite(xe, ev0))
      have xv: app(xw, "vm") in x86_64_linux.Vm by simp(expand(xW, abi.World))
      have xvu := mp(app_univ[u := 1, f := xw, k := "vm"], xu)
      have wm := all_elim(abi.wm_refl, {app(C, "vm")}, {app(xw, "vm")}, {int_sub(S, 8)})
      have hg2 := rewrite(xe, hx0r2)
      have ckr w3W w3u := apply(tr.callee_ok_p, {g}, {w}, {u}, {int_sub(S, 8)}, {app(C, "vm")}, {vv}, {xw}, {r}, {app(xw, "vm")}, wW, wu, cv, cvu, hvv, hvvu, s8b, hsv, hg2, xW, xu, ru, xv, xvu, wm)
      let W3 := fn_update(fn_update(fn_update(fn_update(w, "vm", app(C, "vm")), "vm", app(xw, "vm")), "os", app(xw, "os")), "fs_base", app(xw, "fs_base"))
      have r0u: fst(r) in univ(1) by simp(ru)
      have r1u: snd(r) in univ(1) by simp(ru)
      have pe _ _ := apply(tr.leave_p[g := g, ar := ar, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)],
        {w}, {u}, {int_sub(S, 8)}, {app(C, "vm")}, {W3}, {fst(r)}, {snd(r)}, wu, w3u, r0u, r1u, hen, ckr, hk)
      have w3a := apply(tr.world_and, w3W)
      have ev3: app(app(W3, "os"), "events") = app(app(m1, "os"), "events") by simp(ev)
      show := apply(tr.ovf_exc, {P}, {w}, {app(m1, "os")}, {W3}, w3a, pe, ev3)
    qed
    // the callee overflowed: so does the caller
    have c2: (ex a b. a in rec_and(abi.World, single(empty)) && b in univ(1) && x0 = exc(a, b)) -> tr.ovf(P, w, app(m1, "os")) proof
      assume e
      obtain xw eb, xa ebu xe from e
      have pu2 := rewrite(xe, pu)
      have xu: xw in univ(1) by simp(pu2)
      have itf := apply(tr.ite_f, {fst(x0) = 0}, {app(app(fst(snd(x0)), "os"), "events") = app(app(m1, "os"), "events")},
        {ite(fst(x0) = 1, snd(snd(x0)) = exc_val("stack_overflow", empty) && app(app(fst(snd(x0)), "os"), "events") = app(app(m1, "os"), "events"),
          app(snd(x0), "os.events") = app(app(m1, "os"), "events"))}, simp(xe))
      have itt := apply(tr.ite_t, {fst(x0) = 1}, {snd(snd(x0)) = exc_val("stack_overflow", empty) && app(app(fst(snd(x0)), "os"), "events") = app(app(m1, "os"), "events")},
        {app(snd(x0), "os.events") = app(app(m1, "os"), "events")}, simp(xe))
      have c0 := rewrite(trans(itf, itt), hit)
      have eo ev: eb = exc_val("stack_overflow", empty) && app(app(xw, "os"), "events") = app(app(m1, "os"), "events") by simp(rewrite(xe, c0))
      have hg2 := rewrite(xe, hx0r2)
      have pe0 w3W := apply(tr.callee_exc_p[g := g, ar := ar, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)],
        {w}, {u}, {int_sub(S, 8)}, {app(C, "vm")}, {vv}, {xw}, {eb}, wW, wu, cv, cvu, hvv, hvvu, s8b, hen, hsv, hg2, xa, xu, ebu, hk)
      let W3 := fn_update(fn_update(fn_update(fn_update(w, "vm", app(C, "vm")), "vm", app(xw, "vm")), "os", app(xw, "os")), "fs_base", app(xw, "fs_base"))
      have pe := rewrite(eo, pe0)
      have w3a := apply(tr.world_and, w3W)
      have ev3: app(app(W3, "os"), "events") = app(app(m1, "os"), "events") by simp(ev)
      show := apply(tr.ovf_exc, {P}, {w}, {app(m1, "os")}, {W3}, w3a, pe, ev3)
    qed
    // the callee ran on: so does the caller
    have c3: (ex t. t in univ(1) && x0 = diverge(t)) -> tr.ovf(P, w, app(m1, "os")) proof
      assume e
      obtain t, tu xe from e
      have itf := apply(tr.ite_f, {fst(x0) = 0}, {app(app(fst(snd(x0)), "os"), "events") = app(app(m1, "os"), "events")},
        {ite(fst(x0) = 1, snd(snd(x0)) = exc_val("stack_overflow", empty) && app(app(fst(snd(x0)), "os"), "events") = app(app(m1, "os"), "events"),
          app(snd(x0), "os.events") = app(app(m1, "os"), "events"))}, simp(xe))
      have itf2 := apply(tr.ite_f, {fst(x0) = 1}, {snd(snd(x0)) = exc_val("stack_overflow", empty) && app(app(fst(snd(x0)), "os"), "events") = app(app(m1, "os"), "events")},
        {app(snd(x0), "os.events") = app(app(m1, "os"), "events")}, simp(xe))
      have c0 := rewrite(trans(itf, itf2), hit)
      have ev: app(t, "os.events") = app(app(m1, "os"), "events") by simp(rewrite(xe, c0))
      have hg2 := rewrite(xe, hx0r2)
      have pd := apply(tr.callee_div_p[g := g, ar := ar, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)],
        {w}, {u}, {int_sub(S, 8)}, {app(C, "vm")}, {vv}, {t}, wW, wu, cv, cvu, hvv, hvvu, s8b, hen, hsv, hg2, tu, hd)
      show := apply(tr.ovf_div, {P}, {w}, {app(m1, "os")}, {t}, tu, pd, ev)
    qed
    show by taut(cs, c1, c2, c3)
  qed
  have cr: exc(m1, exc_val("segv", pair(a0, k0))) = exc(m1, exc_val("segv", pair(a0, k0))) := refl({exc(m1, exc_val("segv", pair(a0, k0)))})
  have crash: tr.crash(s, P, w, exc(m1, exc_val("segv", pair(a0, k0)))) by defs(ex_intro({m1}, {a0}, {k0}, taut(cr, kk, m1M, ab, ov2, sub, inp, ovf)), tr.crash)
  show := rewrite(sym(oe), crash)
qed

// (the spec raising: the claim, whatever the machine does)
theorem tr.sim_ub: all s v p w m. tr.ub(s, v, p, w) -> tr.sim(s, v, p, w, m)
proof
  fix s v p w m
  assume h
  have g: all o. tr.run_d(s, m, o) -> tr.ub(s, v, p, w) || tr.ok(s, p, w, o) || tr.crash(s, p, w, o) proof
    fix o
    assume ho
    show by taut(h)
  qed
  show by defs(g, tr.sim)
qed

// the callee's spec raising (undefined): so does the caller's
theorem tr.callee_raise_ub(g, ar, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all s v base code m w C u vv.
  tr.inv(s, base, code, 8, m, w) -> int_le(16, app(app(s, "gpr"), 4)) -> C in x86_64_linux.Machine ->
  app(C, "os") = app(m, "os") -> app(C, "fs_base") = app(m, "fs_base") -> app(C, "cpu") = app(m, "cpu") -> app(app(C, "gpr"), 4) = int_sub(app(app(s, "gpr"), 4), 16) ->
  app(C, "vm") in x86_64_linux.Vm -> app(C, "vm") in univ(1) -> vv in x86_64_linux.Vm -> vv in univ(1) -> abi.scratch_view(vv, app(C, "vm"), int_sub(app(app(s, "gpr"), 4), 8)) ->
  runs(gimple.call_enter(app(w, "sp"), app(w, "sp"), seq_one(ar)), w, ok(fn_update(w, "vm", app(C, "vm")), pair(seq_one(u), int_sub(app(app(s, "gpr"), 4), 8)))) ->
  g in fn_space(abi.ARGS, powerset(univ(1))) -> seq_one(u) in abi.ARGS ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) ->
  abi.raises_at(g, seq_one(u), C, vv) ->
  tr.ub(s, v, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, seq_one(ar)), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w)
proof
  fix s v base code m w C u vv
  assume hi h16 cM co cf cc c4 cv cvu hvv hvvu hsv hen hgt hA hk hr
  let S := app(app(s, "gpr"), 4)
  have {wW, wu, sb} := apply(tr.inv_call, hi)
  have s8b: int_sub(S, 8) in bits(64) by simp(sb, h16)
  have weq _ := apply(tr.callee_world_eq, {s}, {base}, {code}, {m}, {w}, {C}, {vv}, hi, h16, co, cf, cc, c4)
  obtain e x, eu eno rs rr from expand(hr, abi.raises_at)
  have rr2 := rewrite(weq, rr)
  have pu := apply(tr.spec_univ, {g}, {seq_one(u)}, {fn_update(fn_update(fn_update(fn_update(fn_update(empty, "vm", vv), "os", app(w, "os")), "fs_base", app(w, "fs_base")), "cpu", app(w, "cpu")), "sp", int_sub(S, 8))}, {exc(x, e)}, hgt, hA, rr2)
  have xu: x in univ(1) by simp(pu)
  // (the callee's raise state: its view, or a World)
  have xa: x in rec_and(abi.World, single(empty)) proof
    have c1: x = abi.view(vv, C) -> x in rec_and(abi.World, single(empty)) proof
      assume ex
      have xu2 := rewrite(ex, xu)
      have spb: abi.sp(C) in bits(64) by simp(c4, sb, h16)
      have vw := apply(abi.world_typed, {C}, {vv}, {abi.sp(C)}, cM, hvv, spb, xu2)
      have vw2 := rewrite(sym(ex), vw)
      show := apply(tr.world_and, vw2)
    qed
    show by taut(expand(rs, abi.raise_state), c1)
  qed
  have pe w3W := apply(tr.callee_exc_p[g := g, ar := ar, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)],
    {w}, {u}, {int_sub(S, 8)}, {app(C, "vm")}, {vv}, {x}, {e}, wW, wu, cv, cvu, hvv, hvvu, s8b, hen, hsv, rr2, xa, xu, eu, hk)
  let W3 := fn_update(fn_update(fn_update(fn_update(w, "vm", app(C, "vm")), "vm", app(x, "vm")), "os", app(x, "os")), "fs_base", app(x, "fs_base"))
  have w3a := apply(tr.world_and, w3W)
  have rst: abi.raise_state(v, s, W3) by defs(taut(w3a), abi.raise_state)
  show by defs(ex_intro({e}, {W3}, taut(eu, eno, rst, pe)), tr.ub)
qed

// ----------------------------------------------------------------------
//  The callee runs: from its entry state C, the caller's claim

theorem tr.callee_sim(g, ar, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all s v base code m w ds u RA T m1 e1 C cb cc st.
  tr.inv(s, base, code, 8, m, w) -> tr.mem(s, m, w, ds) -> base in omega -> int_le(16, app(app(s, "gpr"), 4)) -> abi.view(v, s) in univ(1) ->
  app(app(m, "gpr"), 7) = u -> u in bits(64) -> u in gimple.in_reg(fst(ar), snd(ar)) -> RA in bits(64) -> T in bits(64) ->
  runs(x86_64_linux.touch_range(bits_sub(64, app(app(m, "gpr"), 4), 8), 8, 1), fn_update(m, "rip", RA), ok(m1, e1)) ->
  C = fn_update(fn_update(fn_update(m1, "vm", fn_update(app(m1, "vm"), "bytes", x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), bits_sub(64, app(app(m, "gpr"), 4), 8), 8, RA))),
    "gpr", fn_update(app(m1, "gpr"), 4, bits_sub(64, app(app(m, "gpr"), 4), 8))), "rip", T) ->
  tr.implements_at(T, g, cb, cc, st) -> abi.loaded(app(s, "vm"), cb, cc, st) -> cb in omega ->
  g in fn_space(abi.ARGS, powerset(univ(1))) -> tr.callee_io(g) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) ->
  (all t. t in univ(1) -> runs(mkprog(x0 x1. ex x8. dd(t, x8) && k(x8, x1)), w, diverge(t))) ->
  (all w4 r0. w4 in abi.World && w4 in univ(1) -> r0 in bits(64) -> tr.pt(s, v, base, code, 8, RA, empty, false, fn_update(empty, 0, pair(8, r0)),
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. a(x0, r0, x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w4)) ->
  tr.sim(s, v, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, seq_one(ar)), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, C)
proof
  fix s v base code m w ds u RA T m1 e1 C cb cc st
  assume hi hmm hb h16 hvu hu7 hu hin hra ht htr hC himp hld hcb hgt hio hk hd hpost
  let S := app(app(s, "gpr"), 4)
  let P := mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, seq_one(ar)), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))
  have {sM, wW, wu, wsp, mfs, sb, slt, sal, mdf} := apply(tr.inv_call, hi)
  have s8b: int_sub(S, 8) in bits(64) by simp(sb, h16)
  // the push done: C
  have cM cu co cf cc0 cgs cfl cgpr crip ckc cfs cle cpi cby := apply(tr.push_ok, {s}, {base}, {code}, {m}, {w}, {RA}, {T}, {m1}, {e1}, {C}, hi, h16, hra, ht, htr, hC)
  have c4: app(app(C, "gpr"), 4) = int_sub(S, 16) by simp(cgpr)
  have cv: app(C, "vm") in x86_64_linux.Vm := apply(x86i.parts, cM).4
  have cvu := mp(app_univ[u := 1, f := C, k := "vm"], cu)
  // GIMPLE's frame at the call: C's memory
  have fr := apply(tr.push_frame, {s}, {base}, {code}, {m}, {w}, {ds}, {app(C, "vm")}, hi, hmm, h16, cfs, cpi, cby)
  have _ _ _ pp4 := apply(tr.push_pages, {S}, sb, h16, slt, sal)
  have s8l: int_le(int_sub(S, 8), app(w, "sp")) by simp(wsp, pp4)
  have s8a: int_mod(int_sub(S, 8), 16) = 0 by simp(sb, sal, slt)
  have ke := mp(all_elim(hk, {abi.view(v, s)}, {empty}), hvu, simp())
  // GIMPLE's checks at the call failing: undefined
  have bad: !(abi.thread_ok(app(C, "vm"), app(w, "fs_base")) && abi.stack_ok(app(C, "vm"), bits_sub(64, int_sub(S, 8), 8))) -> tr.sim(s, v, P, w, C) proof
    assume hn
    have ub := apply(tr.call_ub[g := g, ar := ar, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)],
      {s}, {v}, {w}, {u}, {int_sub(S, 8)}, {app(C, "vm")}, wu, hvu, hu, hin, s8b, s8l, s8a, cv, cvu, fr, hn, ke)
    show := apply(tr.sim_ub, {s}, {v}, {P}, {w}, {C}, ub)
  qed
  // ... holding: the callee's entry, its contract
  have good: abi.thread_ok(app(C, "vm"), app(w, "fs_base")) && abi.stack_ok(app(C, "vm"), bits_sub(64, int_sub(S, 8), 8)) -> tr.sim(s, v, P, w, C) proof
    assume hok
    have hth hst := hok
    have hen := apply(tr.g_enter, {w}, {u}, {ar}, {int_sub(S, 8)}, {app(C, "vm")}, wu, hu, hin, s8b, s8l, s8a, cv, cvu, fr, hth, hst)
    have c7: app(app(C, "gpr"), 7) = u by simp(cgpr, hu7)
    have cdf: !app(app(C, "flags"), "df") by simp(cfl, mdf)
    have cfw: app(C, "fs_base") = app(w, "fs_base") := trans(cf, mfs)
    have eok := apply(tr.callee_entry, {S}, {C}, {u}, {app(w, "fs_base")}, sb, h16, slt, sal, c4, c7, cdf, cfw, hth, hst)
    // (the callee's return, as its contract has it)
    let OKC(vv, o) := ex m2 w2. o = ok(m2, empty) && m2 in x86_64_linux.Machine && m2 in univ(1) &&
      runs(app(g, seq_one(u)), abi.view(vv, C), ok(w2, pair(app(app(m2, "gpr"), 0), app(app(m2, "gpr"), 2)))) && w2 in abi.World && w2 in univ(1) &&
      abi.world_matches(app(C, "vm"), app(m2, "vm"), app(w2, "vm"), abi.sp(C)) && app(m2, "os") = app(w2, "os") && app(m2, "fs_base") = app(w2, "fs_base") &&
      app(m2, "cpu") = app(C, "cpu") && app(m2, "gs_base") = app(C, "gs_base") && app(m2, "rip") = abi.ret(C) && app(app(m2, "gpr"), 4) = abi.sp(C) &&
      abi.callee_saved(m2, C) && !app(app(m2, "flags"), "df")
    have km: tr.keeps_code(app(s, "vm"), app(m, "vm")) by simp(expand(hi, tr.inv), keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, abi.stack_gap_free, x86_64_linux.can_access, tr.kept, tr.keeps_code))
    have l1 := mp(all_elim(expand(km, tr.keeps_code), {cb}, {cc}, {st}), hcb, hld)
    have lC := mp(all_elim(expand(ckc, tr.keeps_code), {cb}, {cc}, {st}), hcb, l1)
    have ul := apply(tr.seq_one_type, {u}, {bits(64)}, hu)
    have l1n: seq_len(seq_one(u)) = 1 by arith()
    have hA: seq_one(u) in abi.ARGS by simp(ul, l1n)
    have ctr: all oc. tr.run_d(C, C, oc) -> tr.matches_t(g, seq_one(u), C, oc) proof
      fix oc
      assume hrd
      show := mp(all_elim(expand(himp, tr.implements_at), {seq_one(u)}, {C}, {oc}), hA, cM, cu, lC, crip, eok, hrd)
    qed
    have spc: abi.sp(C) = int_sub(S, 8) by simp(c4, sb, h16, slt)
    // a matching from the callee's contract: its view of the memory
    have mview: all oc. tr.matches_t(g, seq_one(u), C, oc) -> (ex vv. vv in x86_64_linux.Vm && vv in univ(1) && abi.scratch_view(vv, app(C, "vm"), int_sub(S, 8)) &&
        tr.matches_at_t(g, seq_one(u), C, vv, oc)) proof
      fix oc
      assume hm
      obtain vv, {vV, vU, sv0 = sv, mt} from expand(hm, tr.matches_t)
      have sv := rewrite(spc, sv0)
      show by ex_intro({vv}, taut(vV, vU, sv, mt))
    qed
    // the callee raising: the caller undefined
    have rub: all vv. vv in x86_64_linux.Vm -> vv in univ(1) -> abi.scratch_view(vv, app(C, "vm"), int_sub(S, 8)) -> abi.raises_at(g, seq_one(u), C, vv) -> tr.ub(s, v, P, w) proof
      fix vv
      assume h1 h2 h3 h4
      show := apply(tr.callee_raise_ub[g := g, ar := ar, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)],
        {s}, {v}, {base}, {code}, {m}, {w}, {C}, {u}, {vv}, hi, h16, cM, co, cf, cc0, c4, cv, cvu, h1, h2, h3, hen, hgt, hA, hk, h4)
    qed
    // the caller's run from C
    have g0: all o. tr.run_d(s, C, o) -> tr.ub(s, v, P, w) || tr.ok(s, P, w, o) || tr.crash(s, P, w, o) proof
      fix o
      assume hr
      have spl: int_le(abi.sp(C), abi.sp(s)) by simp(spc, pp4)
      have rs := apply(tr.run_split, {s}, {C}, {o}, sM, spl, hr)
      // (1) the caller's run is the callee's
      have b1: tr.run_d(C, C, o) -> tr.ub(s, v, P, w) || tr.ok(s, P, w, o) || tr.crash(s, P, w, o) proof
        assume hrc
        obtain vv, vV vU sv8 mt from mp(all_elim(mview, {o}), mp(all_elim(ctr, {o}), hrc))
        have mt2 := expand(mt, tr.matches_at_t)
        have u1: abi.raises_at(g, seq_one(u), C, vv) -> tr.ub(s, v, P, w) || tr.ok(s, P, w, o) || tr.crash(s, P, w, o) proof
          assume ra
          have ub := mp(all_elim(rub, {vv}), vV, vU, sv8, ra)
          show by taut(ub)
        qed
        have u2: abi.crashes_at(g, seq_one(u), C, vv, o) -> tr.ub(s, v, P, w) || tr.ok(s, P, w, o) || tr.crash(s, P, w, o) proof
          assume ca
          have cr := apply(tr.callee_crash[g := g, ar := ar, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)],
            {s}, {base}, {code}, {m}, {w}, {C}, {u}, {vv}, {o}, hi, h16, co, cf, cc0, c4, cv, cvu, vV, vU, sv8, hen, hgt, hA, hk, hd, ca)
          show by taut(cr)
        qed
        // (a return of the callee is not the caller's: its rsp is lower)
        have u3: (ex m2 w2. o = ok(m2, empty) && app(app(m2, "gpr"), 4) = abi.sp(C)) -> tr.ub(s, v, P, w) || tr.ok(s, P, w, o) || tr.crash(s, P, w, o) proof
          assume eo
          obtain m2 w2, oe r2 from eo
          have _ r1 := apply(tr.run_d_ok, {s}, {C}, {m2}, {empty}, rewrite(oe, hr))
          have ne: false by simp(r1, r2, spc, pp4, sb, h16)
          show by taut(ne)
        qed
        have okc: OKC(vv, o) -> (ex m2 w2. o = ok(m2, empty) && app(app(m2, "gpr"), 4) = abi.sp(C)) proof
          assume eo
          obtain m2 w2, eo2 from eo
          show by ex_intro({m2}, {w2}, taut(eo2.1, eo2.13))
        qed
        show by taut(mt2, u1, u2, u3, okc)
      qed
      // (3) the callee leaving its discipline: its contract has it raise
      have b3: (ex x. tr.run_d(C, C, exc(x, exc_val("disc", empty)))) -> tr.ub(s, v, P, w) || tr.ok(s, P, w, o) || tr.crash(s, P, w, o) proof
        assume ed
        obtain x, hx from ed
        obtain vv, vV vU sv8 mt from mp(all_elim(mview, {exc(x, exc_val("disc", empty))}), mp(all_elim(ctr, {exc(x, exc_val("disc", empty))}), hx))
        have mt2 := expand(mt, tr.matches_at_t)
        have n1: OKC(vv, exc(x, exc_val("disc", empty))) -> false proof
          assume eo
          obtain m2 w2, eo2 from eo
          show by simp(eo2.1)
        qed
        have n2: abi.crashes_at(g, seq_one(u), C, vv, exc(x, exc_val("disc", empty))) -> false proof
          assume ca
          obtain m2 a0 k0, {oe} from expand(ca, abi.crashes_at)
          show by simp(expand(oe, exc_val))
        qed
        have r3: abi.raises_at(g, seq_one(u), C, vv) by taut(mt2, n1, n2)
        have ub := mp(all_elim(rub, {vv}), vV, vU, sv8, r3)
        show by taut(ub)
      qed
      // (2) the callee returned to the caller, whose run goes on
      have b2: (ex x o1. tr.run_d(C, C, ok(x, empty)) && tr.run_d(s, x, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2))) ->
          tr.ub(s, v, P, w) || tr.ok(s, P, w, o) || tr.crash(s, P, w, o) proof
        assume eb
        obtain x o1, hrx hr1 ho1 from eb
        obtain vv, vV vU sv8 mt from mp(all_elim(mview, {ok(x, empty)}), mp(all_elim(ctr, {ok(x, empty)}), hrx))
        have mt2 := expand(mt, tr.matches_at_t)
        have n2: abi.crashes_at(g, seq_one(u), C, vv, ok(x, empty)) -> false proof
          assume ca
          obtain m2 a0 k0, {oe} from expand(ca, abi.crashes_at)
          show by simp(oe)
        qed
        have u1: abi.raises_at(g, seq_one(u), C, vv) -> tr.ub(s, v, P, w) || tr.ok(s, P, w, o) || tr.crash(s, P, w, o) proof
          assume ra
          have ub := mp(all_elim(rub, {vv}), vV, vU, sv8, ra)
          show by taut(ub)
        qed
        have u2: OKC(vv, ok(x, empty)) -> tr.ub(s, v, P, w) || tr.ok(s, P, w, o) || tr.crash(s, P, w, o) proof
          assume eo
          obtain m2 w2, eo2 from eo
          have xm: x = m2 by simp(eo2.1)
          let r0 := app(app(x, "gpr"), 0)
          let r1 := app(app(x, "gpr"), 2)
          have _ xM xu hg0 w2W w2u wm0 xos xfs xcpu xgs xrip0 xr4 xcs xdf := rewrite(sym(xm), eo2)
          have wm8 := rewrite(spc, wm0)
          have weq _ := apply(tr.callee_world_eq, {s}, {base}, {code}, {m}, {w}, {C}, {vv}, hi, h16, co, cf, cc0, c4)
          have hg8 := rewrite(weq, hg0)
          have xv: app(x, "vm") in x86_64_linux.Vm := apply(x86i.parts, xM).4
          have xvu := mp(app_univ[u := 1, f := x, k := "vm"], xu)
          have r0R: 0 in x86_64_linux.Reg by simp()
          have r2R: 2 in x86_64_linux.Reg by simp()
          have r0b := mp(mp(all_elim(x86i.reg_typed, {x}, {0}), xM), r0R)
          have r1b := mp(mp(all_elim(x86i.reg_typed, {x}, {2}), xM), r2R)
          have r0u: r0 in univ(1) by simp(r0b)
          have r1u: r1 in univ(1) by simp(r1b)
          have ru: pair(r0, r1) in univ(1) by simp(r0u, r1u)
          have ckr w3W w3u := apply(tr.callee_ok_p, {g}, {w}, {u}, {int_sub(S, 8)}, {app(C, "vm")}, {vv}, {w2}, {pair(r0, r1)}, {app(x, "vm")},
            wW, wu, cv, cvu, vV, vU, s8b, sv8, hg8, w2W, w2u, ru, xv, xvu, wm8)
          let W3 := fn_update(fn_update(fn_update(fn_update(w, "vm", app(C, "vm")), "vm", app(x, "vm")), "os", app(w2, "os")), "fs_base", app(w2, "fs_base"))
          have hco: runs(gimple.call_callee(int_sub(S, 8), g, seq_one(u)), fn_update(w, "vm", app(C, "vm")), ok(W3, pair(r0, r1))) by simp(ckr, keep(gimple.call_callee))
          have _ lu lk := apply(tr.leave_p[g := g, ar := ar, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)],
            {w}, {u}, {int_sub(S, 8)}, {app(C, "vm")}, {W3}, {r0}, {r1}, wu, w3u, r0u, r1u, hen, hco, hk)
          have w3v: app(W3, "vm") = app(x, "vm") by simp()
          // the caller's frame changed by the callee: undefined
          have fc: !tr.frame_same(app(x, "vm"), app(C, "vm"), int_sub(S, 8), app(w, "sp")) -> tr.ub(s, v, P, w) || tr.ok(s, P, w, o) || tr.crash(s, P, w, o) proof
            assume hn
            have hn2 := rewrite(sym(w3v), hn)
            have pe := mp(all_elim(mp(lu, hn2), {abi.view(v, s)}, {empty}), hvu, simp())
            have eno: !(empty = exc_val("stack_overflow", empty)) by defs(all_elim(tr.pair_ne, {"stack_overflow"}, {empty}), exc_val)
            have rst: abi.raise_state(v, s, abi.view(v, s)) by defs(taut(refl({abi.view(v, s)})), abi.raise_state)
            have eu: empty in univ(1) by simp()
            have ub: tr.ub(s, v, P, w) by defs(ex_intro({empty}, {abi.view(v, s)}, taut(eu, eno, rst, pe)), tr.ub)
            show by taut(ub)
          qed
          // ... kept: the caller goes on at the return address with the result
          have fk: tr.frame_same(app(x, "vm"), app(C, "vm"), int_sub(S, 8), app(w, "sp")) -> tr.ub(s, v, P, w) || tr.ok(s, P, w, o) || tr.crash(s, P, w, o) proof
            assume hs
            have hs2 := rewrite(sym(w3v), hs)
            have red: tr.red(P, w, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. a(x0, r0, x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), W3)
              by defs(mp(lk, hs2), tr.red)
            have sv0 := rewrite(sym(spc), sv8)
            have pinv pmem phom preg := apply(tr.post_call, {s}, {base}, {code}, {m}, {w}, {C}, {x}, {w2}, {vv}, {g}, {seq_one(u)}, hi, hb, h16, cM, cu, co, cc0, cgs, cgpr, ckc, cpi, cby,
              vV, vU, sv0, hio, hg0, xM, xu, w2W, w2u, wm0, xos, xfs, xcpu, xgs, xr4, xcs, xdf, hs)
            have xrip: app(x, "rip") = RA by simp(xrip0, c4, cle)
            have ptk := mp(all_elim(hpost, {W3}, {r0}), taut(w3W, w3u), r0b)
            have sm := mp(all_elim(expand(ptk, tr.pt), {x}), pinv, xrip, phom, preg, pmem)
            have sm2 := apply(tr.sim_red, {s}, {v}, {P}, {w}, {mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. a(x0, r0, x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))},
              {W3}, {x}, red, sm)
            have t1 := mp(all_elim(expand(sm2, tr.sim), {o1}), hr1)
            have same: o1 = o -> tr.ub(s, v, P, w) || tr.ok(s, P, w, o) || tr.crash(s, P, w, o) proof
              assume e
              show := rewrite(e, t1)
            qed
            have divs: (fst(o1) = 2 && fst(o) = 2) -> tr.ub(s, v, P, w) || tr.ok(s, P, w, o) || tr.crash(s, P, w, o) proof
              assume dd2
              have nk: tr.ok(s, P, w, o1) -> false proof
                assume k1
                obtain mk wk, k3 from expand(k1, tr.ok)
                show by simp(rewrite(k3.1, dd2))
              qed
              have nc: tr.crash(s, P, w, o1) -> false proof
                assume k1
                obtain mk ak kk, k4 from expand(k1, tr.crash)
                show by simp(rewrite(k4.1, dd2))
              qed
              show by taut(t1, nk, nc)
            qed
            show by taut(ho1, same, divs)
          qed
          show by taut(fc, fk)
        qed
        show by taut(mt2, n2, u1, u2)
      qed
      show by taut(rs, b1, b2, b3)
    qed
    show by defs(g0, tr.sim)
  qed
  show by taut(bad, good)
qed

// ----------------------------------------------------------------------
//  The rule

// (the entry's rsp 8: the push would wrap around -- GIMPLE's call is
// undefined, the return address's slot not on the stack)
theorem tr.small_stack_ub(g, ar, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all s v base code m w ds u.
  tr.inv(s, base, code, 8, m, w) -> tr.mem(s, m, w, ds) -> !int_le(16, app(app(s, "gpr"), 4)) -> abi.view(v, s) in univ(1) ->
  u in bits(64) -> u in gimple.in_reg(fst(ar), snd(ar)) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) ->
  tr.ub(s, v, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, seq_one(ar)), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w)
proof
  fix s v base code m w ds u
  assume hi hmm hn hvu hu hin hk
  let S := app(app(s, "gpr"), 4)
  have {wW, wu, wsp, sb, slt, sal} := apply(tr.inv_call, hi)
  have s8 := apply(tr.inv_sp8, hi)
  have m1: int_mod(int_add(S, 8), 16) = 0 by simp(sb, sal, slt)
  have se: S = 8 by arith(hn, s8, m1, sb)
  have wv: app(w, "vm") in x86_64_linux.Vm by simp(expand(wW, abi.World))
  have wvu := mp(app_univ[u := 1, f := w, k := "vm"], wu)
  have s0b: int_sub(S, 8) in bits(64) by simp(se)
  have s0l: int_le(int_sub(S, 8), app(w, "sp")) by simp(se, wsp)
  have s0a: int_mod(int_sub(S, 8), 16) = 0 by simp(se)
  have fr: gimple.frame_at_call(app(w, "vm"), app(w, "vm"), int_sub(S, 8), app(w, "sp")) by defs(simp(), gimple.frame_at_call)
  // (the slot's page: past the user address space, not mapped)
  have nso: !abi.stack_ok(app(w, "vm"), bits_sub(64, int_sub(S, 8), 8)) by defs(simp(se), abi.stack_ok, abi.stack_page, x86_64_linux.mapped, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
  have nn: !(abi.thread_ok(app(w, "vm"), app(w, "fs_base")) && abi.stack_ok(app(w, "vm"), bits_sub(64, int_sub(S, 8), 8))) by taut(nso)
  have ke := mp(all_elim(hk, {abi.view(v, s)}, {empty}), hvu, simp())
  show := apply(tr.call_ub[g := g, ar := ar, a := x9 x10 x8. a(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)],
    {s}, {v}, {w}, {u}, {int_sub(S, 8)}, {app(w, "vm")}, wu, hvu, hu, hin, s0b, s0l, s0a, wv, wvu, fr, nn, ke)
qed

// (the push's bytes: in S - 16's page, at most S's, which is mapped)
theorem tr.push_range: all s base code m w RA. tr.inv(s, base, code, 8, m, w) -> int_le(16, app(app(s, "gpr"), 4)) ->
  x86.range_below(bits_sub(64, app(app(m, "gpr"), 4), 8), 8, int_div(int_sub(app(app(s, "gpr"), 4), 16), 4096), int_div(app(app(s, "gpr"), 4), 4096)) &&
  x86_64_linux.mapped(app(fn_update(m, "rip", RA), "vm"), int_div(app(app(s, "gpr"), 4), 4096))
proof
  fix s base code m w RA
  assume hi h16
  let S := app(app(s, "gpr"), 4)
  have {er4, sb, slt, sal, hsps} := apply(tr.inv_call, hi)
  have so: S in omega by simp(sb)
  have lp _ _ _ := apply(tr.push_pages, {S}, sb, h16, slt, sal)
  have rb: x86.range_below(bits_sub(64, app(app(m, "gpr"), 4), 8), 8, int_div(int_sub(S, 16), 4096), int_div(S, 4096)) proof
    have g: all j. j in omega -> int_lt(j, 8) ->
        int_le(int_div(int_sub(S, 16), 4096), x86_64_linux.page_of(bits_add(64, bits_sub(64, app(app(m, "gpr"), 4), 8), bits_of_int(64, j)))) &&
        int_le(x86_64_linux.page_of(bits_add(64, bits_sub(64, app(app(m, "gpr"), 4), 8), bits_of_int(64, j))), int_div(S, 4096)) proof
      fix j
      assume hj hj8
      have pa1 pa2 := apply(tr.push_at, {S}, {j}, sb, h16, slt, sal, hj, hj8)
      have pa3 := rewrite(sym(er4), pa1)
      have pg: x86_64_linux.page_of(bits_add(64, bits_sub(64, app(app(m, "gpr"), 4), 8), bits_of_int(64, j))) = int_div(int_sub(S, 16), 4096)
        by defs(simp(pa3, pa2), x86_64_linux.page_of, x86_64_linux.PAGE)
      show by simp(pg, lp, keep(x86_64_linux.page_of))
    qed
    show by defs(g, x86.range_below)
  qed
  have kpt: tr.kept(app(s, "vm"), app(m, "vm"), S) by simp(expand(hi, tr.inv), keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, abi.stack_gap_free, x86_64_linux.can_access, tr.kept, tr.keeps_code))
  have kr := mp(all_elim(expand(kpt, tr.kept), {S}), so, arith(so), arith(so))
  have kr2: app(app(app(m, "vm"), "pages"), int_div(S, 4096)) = app(app(app(s, "vm"), "pages"), int_div(S, 4096)) by defs(kr, x86_64_linux.page_of, x86_64_linux.PAGE)
  have mp0: x86_64_linux.mapped(app(fn_update(m, "rip", RA), "vm"), int_div(S, 4096)) by defs(simp(kr2, expand(hsps, abi.stack_page, x86_64_linux.mapped)), x86_64_linux.mapped)
  show by taut(rb, mp0)
qed

// A call `call rel32` (E8) at a, from a frame of 8 bytes, its argument in
// rdi, against readable GIMPLE's call1 of one argument (the callee g at
// a2 + off, its contract tr.implements_at with the program cb/cc loaded at
// the entry, its spec typed and keeping I/O and code, tr.callee_io): the
// claim after the call (at a2, rax the result, no homes, the machine's
// memory the world's) for every world gives the claim before it.
theorem tr.call1(s, v, base, code, a, a2, len, off, f, g, ar, cb, cc, st, hs, ds, rs, w, x9 x10 x8. ka, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw):
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a -> runs(x86_64_linux.exec_body(len, tag(120, off)), m, o)) ->
  a2 = bits_add(64, a, bits_of_int(64, len)) -> off in bits(32) -> base in omega -> abi.view(v, s) in univ(1) ->
  f = bits_add(64, a2, bits_sext(32, 64, off)) -> tr.implements_at(f, g, cb, cc, st) -> abi.loaded(app(s, "vm"), cb, cc, st) -> cb in omega ->
  g in fn_space(abi.ARGS, powerset(univ(1))) -> tr.callee_io(g) ->
  (all m. tr.regs(m, rs) -> app(app(m, "gpr"), 7) in gimple.in_reg(fst(ar), snd(ar))) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) ->
  (all t. t in univ(1) -> runs(mkprog(x0 x1. ex x8. dd(t, x8) && k(x8, x1)), w, diverge(t))) ->
  (all w4 r0. w4 in abi.World && w4 in univ(1) -> r0 in bits(64) -> tr.pt(s, v, base, code, 8, a2, empty, false, fn_update(empty, 0, pair(8, r0)),
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. ka(x0, r0, x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w4)) ->
  tr.pt(s, v, base, code, 8, a, hs, ds, rs,
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, seq_one(ar)), x0, x9 x10. ka(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
      x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w)
proof
  assume hat ha2 hoff hb hvu hf himp0 hld hcb hgt hio hreg hk hd hpost
  have himp: tr.implements_at(bits_add(64, a2, bits_sext(32, 64, off)), g, cb, cc, st) by rewrite(hf, himp0)
  let P := mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1(g, seq_one(ar)), x0, x9 x10. ka(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))
  have g0: all m. tr.inv(s, base, code, 8, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, ds) -> tr.sim(s, v, P, w, m) proof
    fix m
    assume hi hr hh hrs hmm
    let S := app(app(s, "gpr"), 4)
    let u := app(app(m, "gpr"), 7)
    have {mM, mu, er4, sb, slt} := apply(tr.inv_call, hi)
    have r7R: 7 in x86_64_linux.Reg by simp()
    have hu := mp(mp(all_elim(x86i.reg_typed, {m}, {7}), mM), r7R)
    have hin := mp(all_elim(hreg, {m}), hrs)
    // the entry's rsp 8: undefined
    have small: !int_le(16, S) -> tr.sim(s, v, P, w, m) proof
      assume hn
      have ub := apply(tr.small_stack_ub[g := g, ar := ar, a := x9 x10 x8. ka(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)],
        {s}, {v}, {base}, {code}, {m}, {w}, {ds}, {u}, hi, hmm, hn, hvu, hu, hin, hk)
      show := apply(tr.sim_ub, {s}, {v}, {P}, {w}, {m}, ub)
    qed
    have big: int_le(16, S) -> tr.sim(s, v, P, w, m) proof
      assume h16
      let RA := bits_add(64, app(m, "rip"), bits_of_int(64, len))
      let M2 := fn_update(m, "rip", RA)
      let PA := bits_sub(64, app(app(m, "gpr"), 4), 8)
      have rae: RA = a2 by simp(hr, ha2)
      have rab: RA in bits(64) by simp()
      have r8: int_le(8, app(app(m, "gpr"), 4)) by simp(er4, h16)
      have rl: int_lt(app(app(m, "gpr"), 4), 140737488355328) by simp(er4, slt, h16)
      have cd: abi.code_at(app(m, "vm"), base, code) by simp(expand(hi, tr.inv), keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, abi.stack_gap_free, x86_64_linux.can_access, tr.kept, tr.keeps_code))
      // the step: the push done, or its fault
      have st: all o. runs(x86_64_linux.step(), m, o) ->
          (ex m2. o = ok(m2, empty) && (ex m1 e1. runs(x86_64_linux.touch_range(PA, 8, 1), M2, ok(m1, e1)) &&
            m2 = fn_update(fn_update(fn_update(m1, "vm", fn_update(app(m1, "vm"), "bytes", x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), PA, 8, RA))),
              "gpr", fn_update(app(m1, "gpr"), 4, PA)), "rip", bits_add(64, app(m1, "rip"), bits_sext(32, 64, off))))) ||
          (ex x e. o = exc(x, e) && runs(x86_64_linux.touch_range(PA, 8, 1), M2, exc(x, e))) proof
        fix o
        assume ho
        have hx := mp(all_elim(hat, {m}, {o}), ho, cd, hr)
        have cr := apply(x86i.call_rel32, {m}, {o}, {off}, {len}, mM, mu, hoff, r8, rl, hx)
        have c1: (ex m1 e1. runs(x86_64_linux.touch_range(PA, 8, 1), M2, ok(m1, e1)) &&
            o = ok(fn_update(fn_update(fn_update(m1, "vm", fn_update(app(m1, "vm"), "bytes", x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), PA, 8, RA))),
              "gpr", fn_update(app(m1, "gpr"), 4, PA)), "rip", bits_add(64, app(m1, "rip"), bits_sext(32, 64, off))), empty)) ->
            (ex m2. o = ok(m2, empty) && (ex m1 e1. runs(x86_64_linux.touch_range(PA, 8, 1), M2, ok(m1, e1)) &&
              m2 = fn_update(fn_update(fn_update(m1, "vm", fn_update(app(m1, "vm"), "bytes", x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), PA, 8, RA))),
                "gpr", fn_update(app(m1, "gpr"), 4, PA)), "rip", bits_add(64, app(m1, "rip"), bits_sext(32, 64, off))))) proof
          assume e
          obtain m1 e1, tr0 oe from e
          let C := fn_update(fn_update(fn_update(m1, "vm", fn_update(app(m1, "vm"), "bytes", x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), PA, 8, RA))),
            "gpr", fn_update(app(m1, "gpr"), 4, PA)), "rip", bits_add(64, app(m1, "rip"), bits_sext(32, 64, off)))
          have q: ex m1 e1. runs(x86_64_linux.touch_range(PA, 8, 1), M2, ok(m1, e1)) && C = fn_update(fn_update(fn_update(m1, "vm", fn_update(app(m1, "vm"), "bytes",
            x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), PA, 8, RA))), "gpr", fn_update(app(m1, "gpr"), 4, PA)), "rip", bits_add(64, app(m1, "rip"), bits_sext(32, 64, off)))
            by ex_intro({m1}, {e1}, taut(tr0, refl({C})))
          show by ex_intro({C}, taut(oe, q))
        qed
        have c2: (ex x e. runs(x86_64_linux.touch_range(PA, 8, 1), M2, exc(x, e)) && o = exc(x, e)) ->
            (ex x e. o = exc(x, e) && runs(x86_64_linux.touch_range(PA, 8, 1), M2, exc(x, e))) proof
          assume e
          obtain x e0, ex2 from e
          show by ex_intro({x}, {e0}, taut(ex2))
        qed
        have c3: (ex t. runs(x86_64_linux.touch_range(PA, 8, 1), M2, diverge(t)) && o = diverge(t)) -> false proof
          assume e
          obtain t, et _ from e
          have nd := apply(x86.touch_range_nodiv, {M2}, {PA}, {8}, {1}, {t}, simp())
          show by taut(et, nd)
        qed
        show by taut(cr, c1, c2, c3)
      qed
      have nr := apply(tr.inv_nr, hi)
      // the push done: the callee runs
      have okc: all C. (ex m1 e1. runs(x86_64_linux.touch_range(PA, 8, 1), M2, ok(m1, e1)) &&
          C = fn_update(fn_update(fn_update(m1, "vm", fn_update(app(m1, "vm"), "bytes", x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), PA, 8, RA))),
            "gpr", fn_update(app(m1, "gpr"), 4, PA)), "rip", bits_add(64, app(m1, "rip"), bits_sext(32, 64, off)))) -> tr.sim(s, v, P, w, C) proof
        fix C
        assume e
        obtain m1 e1, tr0 hC0 from e
        have tv := apply(x86.touch_range_vm, {M2}, {PA}, {8}, {1}, {m1}, {e1}, tr0)
        have m1r: app(m1, "rip") = RA by simp(tv)
        have tf: bits_add(64, app(m1, "rip"), bits_sext(32, 64, off)) = bits_add(64, a2, bits_sext(32, 64, off)) by simp(m1r, rae)
        have hC1 := rewrite(tf, hC0)
        have hC2 := rewrite(rae, hC1)
        have tr2 := rewrite(rae, tr0)
        have tb: bits_add(64, a2, bits_sext(32, 64, off)) in bits(64) by simp()
        have a2b: a2 in bits(64) by simp(ha2)
        have hpost2: all w4 r0. w4 in abi.World && w4 in univ(1) -> r0 in bits(64) -> tr.pt(s, v, base, code, 8, a2, empty, false, fn_update(empty, 0, pair(8, r0)),
            mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. ka(x0, r0, x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w4) := hpost
        show := apply(tr.callee_sim[g := g, ar := ar, a := x9 x10 x8. ka(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)],
          {s}, {v}, {base}, {code}, {m}, {w}, {ds}, {u}, {a2}, {bits_add(64, a2, bits_sext(32, 64, off))}, {m1}, {e1}, {C}, {cb}, {cc}, {st},
          hi, hmm, hb, h16, hvu, refl({u}), hu, hin, a2b, tb, tr2, hC2, himp, hld, hcb, hgt, hio, hk, hd, hpost2)
      qed
      // the push faulted: a crash, or GIMPLE's call undefined
      have exs: all x e. runs(x86_64_linux.touch_range(PA, 8, 1), M2, exc(x, e)) -> tr.ub(s, v, P, w) || tr.crash(s, P, w, exc(x, e)) proof
        fix x e
        assume hx
        have prb prm := apply(tr.push_range, {s}, {base}, {code}, {m}, {w}, {RA}, hi, h16)
        have mv: app(M2, "vm") in x86_64_linux.Vm by simp(apply(x86i.parts, mM))
        have m2u: M2 in univ(1) by simp(mu, rab)
        have p0o: int_div(S, 4096) in omega by simp(sb)
        have gr0 fa := apply(x86.touch_range_exc, {M2}, {PA}, {8}, {1}, {int_div(int_sub(S, 16), 4096)}, {int_div(S, 4096)}, {x}, {e}, mv, m2u, p0o, prm, prb, hx)
        have gr := rewrite(rae, gr0)
        show := apply(tr.call_fault[g := g, ar := ar, a := x9 x10 x8. ka(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)],
          {s}, {v}, {base}, {code}, {m}, {w}, {ds}, {u}, {a2}, {x}, {e}, hi, hmm, hvu, h16, hu, hin, hk, simp(ha2), gr, fa)
      qed
      show := mp(mp(mp(mp(tr.step_x[s := s, v := v, p := P, w := w, m := m,
        q := y. ex m1 e1. runs(x86_64_linux.touch_range(PA, 8, 1), M2, ok(m1, e1)) &&
          y = fn_update(fn_update(fn_update(m1, "vm", fn_update(app(m1, "vm"), "bytes", x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), PA, 8, RA))),
            "gpr", fn_update(app(m1, "gpr"), 4, PA)), "rip", bits_add(64, app(m1, "rip"), bits_sext(32, 64, off))),
        qx := y z. runs(x86_64_linux.touch_range(PA, 8, 1), M2, exc(y, z))], st), nr), okc), exs)
    qed
    show by taut(small, big)
  qed
  show by defs(g0, tr.pt)
qed

// ----------------------------------------------------------------------
//  A caller's contract: its code with its callees'

// (code loaded as two pieces: each loaded at its place)
theorem tr.code_concat: all vm b c1 c2 t. c1 in list_type(t) -> c2 in list_type(t) -> b in omega -> abi.code_at(vm, b, seq_concat(c1, c2)) ->
  abi.code_at(vm, b, c1) && abi.code_at(vm, int_add(b, seq_len(c1)), c2)
proof
  fix vm b c1 c2 t
  assume h1 h2 hb hc
  have cc := expand(hc, abi.code_at)
  have n1: seq_len(c1) in omega by simp(h1)
  have n2: seq_len(c2) in omega by simp(h2)
  have ln: seq_len(seq_concat(c1, c2)) = int_add(seq_len(c1), seq_len(c2)) by arith(h1, h2)
  have g1: all i. i in omega -> int_lt(i, seq_len(c1)) ->
      ((x86_64_linux.fetchable(vm, bits_of_int(64, int_add(b, i))) && !x86_64_linux.can_access(vm, bits_of_int(64, int_add(b, i)), 1)) &&
        !abi.stack_page(vm, x86_64_linux.page_of(bits_of_int(64, int_add(b, i))))) && app(app(vm, "bytes"), bits_of_int(64, int_add(b, i))) = app(c1, i) proof
    fix i
    assume hi hl
    have l2: int_lt(i, seq_len(seq_concat(c1, c2))) by arith(hl, ln, n2, hi)
    have ci := mp(all_elim(cc, {i}), hi, l2)
    have e := at({app(seq_concat(c1, c2), i)}, h1, h2, hi, hl)
    show by simp(ci, e)
  qed
  have g2: all i. i in omega -> int_lt(i, seq_len(c2)) ->
      ((x86_64_linux.fetchable(vm, bits_of_int(64, int_add(int_add(b, seq_len(c1)), i))) && !x86_64_linux.can_access(vm, bits_of_int(64, int_add(int_add(b, seq_len(c1)), i)), 1)) &&
        !abi.stack_page(vm, x86_64_linux.page_of(bits_of_int(64, int_add(int_add(b, seq_len(c1)), i))))) &&
      app(app(vm, "bytes"), bits_of_int(64, int_add(int_add(b, seq_len(c1)), i))) = app(c2, i) proof
    fix i
    assume hi hl
    have jo: int_add(seq_len(c1), i) in omega by simp(n1, hi)
    have l2: int_lt(int_add(seq_len(c1), i), seq_len(seq_concat(c1, c2))) by arith(hl, ln, n1, hi)
    have ci := mp(all_elim(cc, {int_add(seq_len(c1), i)}), jo, l2)
    have e0 := at({app(seq_concat(c1, c2), int_add(seq_len(c1), i))}, h1, h2, hi, hl, n1)
    have k: int_sub(int_add(seq_len(c1), i), seq_len(c1)) = i by arith(hi, n1)
    have e := rewrite(k, e0)
    have ad: int_add(b, int_add(seq_len(c1), i)) = int_add(int_add(b, seq_len(c1)), i) by arith(hb, n1, hi)
    have ci2 := rewrite(ad, ci)
    show by simp(ci2, e)
  qed
  have r1: abi.code_at(vm, b, c1) by defs(g1, abi.code_at)
  have r2: abi.code_at(vm, int_add(b, seq_len(c1)), c2) by defs(g2, abi.code_at)
  show by taut(r1, r2)
qed

// ... and so the program with its statics
theorem tr.loaded_concat: all vm b c1 c2 t st. c1 in list_type(t) -> c2 in list_type(t) -> b in omega -> abi.loaded(vm, b, seq_concat(c1, c2), st) ->
  abi.loaded(vm, b, c1, st) && abi.loaded(vm, int_add(b, seq_len(c1)), c2, st)
proof
  fix vm b c1 c2 t st
  assume h1 h2 hb hl
  have l := expand(hl, abi.loaded)
  have cc := apply(tr.code_concat, {vm}, {b}, {c1}, {c2}, {t}, h1, h2, hb, taut(l))
  show by defs(taut(l, cc), abi.loaded)
qed

// a callee's contract for its own code: for more code loaded too
theorem tr.implements_widen: all f spec b c b2 c2 st. tr.implements_at(f, spec, b, c, st) ->
  (all vm. abi.loaded(vm, b2, c2, st) -> abi.loaded(vm, b, c, st)) -> tr.implements_at(f, spec, b2, c2, st)
proof
  fix f spec b c b2 c2 st
  assume h hw
  have g: all args s o. args in abi.ARGS -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(app(s, "vm"), b2, c2, st) -> app(s, "rip") = f ->
      abi.entry_ok(s, args) -> tr.run_d(s, s, o) -> tr.matches_t(spec, args, s, o) proof
    fix args s o
    assume hA hM hu hl hr he hd
    have l := mp(all_elim(hw, {app(s, "vm")}), hl)
    show := mp(all_elim(expand(h, tr.implements_at), {args}, {s}, {o}), hA, hM, hu, l, hr, he, hd)
  qed
  show by defs(g, tr.implements_at)
qed

// tr.entry1_32s for a contract whose code lb/lc holds the function's own
// (base/code) -- a caller's, holding its callees' code too
theorem tr.entry1_32s_w(lb, lc, base, code, statics, f, k, len0, z0, a1, len, d, c, z1, z2, a2, x0. q, x3 x4 x2. kw): base in omega ->
  (all vm. abi.loaded(vm, lb, lc, statics) -> abi.code_at(vm, base, code)) ->
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = f ->
    runs(x86_64_linux.exec_body(len0, tag(60, pair(8, pair(5, pair(tag(0, 4), pair(z0, k)))))), m, o)) ->
  a1 = bits_add(64, f, len0) -> k in bits(8) -> int_lt(k, 128) -> int_le(k, 8) ->
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a1 ->
    runs(x86_64_linux.exec_body(len, tag(75, pair(4, pair(7, pair(x86i.rsp_mem(d), pair(z1, z2)))))), m, o)) ->
  a2 = bits_add(64, a1, len) -> d in bits(64) -> c = int_mod(int_sub(d, k), 18446744073709551616) -> c in bits(64) ->
  int_le(18446744073709551608, c) -> int_le(4, int_sub(18446744073709551616, c)) ->
  (all args s. args in abi.ARGS -> s in x86_64_linux.Machine -> ord_le(1, seq_len(args)) ->
    abi.view(tr.view1(s, c, 4, bits_slice(app(app(s, "gpr"), 7), 31, 0)), s) in univ(1) ->
    abi.loaded(app(s, "vm"), lb, lc, statics) -> abi.view(tr.view1(s, c, 4, bits_slice(app(app(s, "gpr"), 7), 31, 0)), s) in abi.World ->
    tr.pt(s, tr.view1(s, c, 4, bits_slice(app(app(s, "gpr"), 7), 31, 0)), base, code, k, a2, fn_update(empty, c, pair(4, bits_of_int(32, app(args, 0)))), false, empty,
      mkprog(x1 x2. bind_rel(q(args), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))),
      abi.view(tr.view1(s, c, 4, bits_slice(app(app(s, "gpr"), 7), 31, 0)), s))) ->
  (all args s o. args in abi.ARGS -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(app(s, "vm"), lb, lc, statics) -> app(s, "rip") = f ->
    abi.entry_ok(s, args) -> tr.run_d(s, s, o) ->
    tr.matches_t(fn_build(abi.ARGS, x0. mkprog(x1 x2. !ord_le(1, seq_len(x0)) || bind_rel(q(x0), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))), args, s, o))
proof
  assume hbase hsub hat0 ha1 hk hkl hk8 hat ha2 hd hcd hcb hd1 hd2 hbody
  have hpro: all args s. args in abi.ARGS -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(app(s, "vm"), lb, lc, statics) -> app(s, "rip") = f ->
      abi.entry_ok(s, args) -> ord_le(1, seq_len(args)) ->
      tr.sim(s, tr.view1(s, c, 4, bits_slice(app(app(s, "gpr"), 7), 31, 0)), mkprog(x1 x2. bind_rel(q(args), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))),
        abi.view(tr.view1(s, c, 4, bits_slice(app(app(s, "gpr"), 7), 31, 0)), s), s) proof
    fix args s
    assume hA hM su hl hrip he hg
    let X := bits_slice(app(app(s, "gpr"), 7), 31, 0)
    let V := tr.view1(s, c, 4, X)
    let BIND := mkprog(x1 x2. bind_rel(q(args), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))
    have hc := mp(all_elim(hsub, {app(s, "vm")}), hl)
    have ent := apply(abi.entry_stack, hM, he)
    have hdf: !app(app(s, "flags"), "df") by taut(expand(he, abi.entry_ok))
    have r7R: 7 in x86_64_linux.Reg by simp()
    have r7 := mp(mp(all_elim(x86i.reg_typed, {s}, {7}), hM), r7R)
    have xo: X in omega by simp(r7)
    have vf := apply(tr.view1_ok, {s}, {c}, {4}, {X}, hM, su, taut(ent), taut(ent), taut(ent), hcb, hd1, hd2, simp(), xo)
    have vV: V in x86_64_linux.Vm by taut(vf)
    have vU: V in univ(1) by taut(vf)
    have hvu: abi.view(V, s) in univ(1) by simp(su, vU)
    have ap := apply(abi.arg_passed, {s}, {args}, hA, he, hg)
    have hx: bits_of_int(32, app(app(s, "gpr"), 7)) = bits_of_int(32, app(args, 0)) by simp(ap)
    have r4 := apply(x86i.rsp_typed, hM)
    have hWw := apply(abi.world_typed, {s}, {V}, {abi.sp(s)}, hM, vV, simp(r4), hvu)
    have body := mp(mp(mp(mp(mp(mp(all_elim(hbody, {args}, {s}), hA), hM), hg), hvu), hl), hWw)
    show := apply(tr.prologue_sub1_32, {s}, {base}, {code}, {f}, {k}, {len0}, {z0}, {a1}, {len}, {d}, {c}, {z1}, {z2}, {a2}, {bits_of_int(32, app(args, 0))}, {BIND},
      hM, su, hbase, hc, hrip, hdf, taut(ent), taut(ent), taut(ent), taut(ent), apply(abi.entry_gap, he), hat0, ha1, hk, hkl, hk8, hat, ha2, hd, hcd, hcb, hd1, hd2, hx, hvu, body)
  qed
  show := mp(tr.entry1_32g[base := lb, code := lc, statics := statics, f := f, d := c, q := x0. q(x0), kw := x3 x4 x2. kw(x3, x4, x2)], hcb, hd1, hd2, hpro)
qed

// (a 32-bit argument in rdi: its register value GIMPLE's)
theorem tr.arg32_reg: all rs x. 7 in dom(rs) -> app(rs, 7) = pair(4, x) ->
  (all m. tr.regs(m, rs) -> app(app(m, "gpr"), 7) in gimple.in_reg(fst(gimple.arg(32, x)), snd(gimple.arg(32, x))))
proof
  fix rs x
  assume hd hx
  fix m
  assume hr
  have rg := apply(tr.regs_get, {m}, {rs}, {7}, {4}, {x}, hr, hd, hx)
  have e: app(app(m, "gpr"), 7) = x by taut(rg)
  have xb: x in bits(int_mul(8, 4)) by taut(rg)
  show by defs(simp(e, xb), gimple.in_reg, gimple.arg)
qed

// (a function built on a number: a list of its values' set)
theorem tr.build_list(d, x. v, t): d in omega -> (all x. x in d -> v(x) in t) -> fn_build(d, x. v(x)) in list_type(t)
proof
  assume hd hv
  have sp := mp(fn_build_space[d := d, v := x. v(x), b := t], hv)
  have fd: fn_build(d, x. v(x)) in powerset(cart(d, t)) && is_fun(fn_build(d, x. v(x))) && dom(fn_build(d, x. v(x))) = d by simp(expand(sp, fn_space))
  have ss: subset(fn_build(d, x. v(x)), cart(d, t)) by taut(powerset_def[s := cart(d, t), a := fn_build(d, x. v(x))], fd)
  have g: all z. z in fn_build(d, x. v(x)) -> z in cart(omega, t) proof
    fix z
    assume hz
    have zc := mp(subset_elim[a := fn_build(d, x. v(x)), b := cart(d, t), z := z], ss, hz)
    obtain a, ha from mp(cart_elim[a := d, b := t, z := z], zc)
    obtain b, hb from ha
    have ao := mp(mp(nat_elem[k := d, i := a], hd), taut(hb))
    have c := mp(mp(cart_intro[a := omega, b := t, x := a, y := b], ao), taut(hb))
    have ze: z = pair(a, b) by taut(hb)
    show := rewrite(sym(ze), c)
  qed
  have so: subset(fn_build(d, x. v(x)), cart(omega, t)) by defs(g, subset)
  have pw: fn_build(d, x. v(x)) in powerset(cart(omega, t)) by taut(powerset_def[s := cart(omega, t), a := fn_build(d, x. v(x))], so)
  have dd: dom(fn_build(d, x. v(x))) in omega by simp(fd, hd)
  show by defs(simp(pw, fd, dd), list_type, seq_type, is_seq)
qed

// (code bytes: a list of the bytes it has, or of more)
theorem tr.bytes_list: all b t. (all i. i in bytes_len(b) -> bytes_at(b, i) in t) -> bytes_len(b) in omega -> bytes_seq(b) in list_type(t)
proof
  fix b t
  assume h hn
  have l := mp(mp(tr.build_list[d := bytes_len(b), v := i. bytes_at(b, i), t := t], hn), h)
  show by defs(l, bytes_seq)
qed

// two pieces of code loaded one after the other: the second at its place
theorem tr.loaded_after: all vm b1 b2 lb st. bytes_len(b1) in omega -> bytes_len(b2) in omega -> lb in omega ->
  abi.loaded(vm, lb, seq_concat(bytes_seq(b1), bytes_seq(b2)), st) -> abi.loaded(vm, int_add(lb, bytes_len(b1)), bytes_seq(b2), st)
proof
  fix vm b1 b2 lb st
  assume h1 h2 hl h
  let T := union2(set_image(bytes_len(b1), i. bytes_at(b1, i)), set_image(bytes_len(b2), i. bytes_at(b2, i)))
  have m1: all i. i in bytes_len(b1) -> bytes_at(b1, i) in T proof
    fix i
    assume hi
    have si := set_image_def[s := bytes_len(b1), f := j. bytes_at(b1, j), y := bytes_at(b1, i)]
    have ex: ex j. j in bytes_len(b1) && bytes_at(b1, j) = bytes_at(b1, i) by ex_intro({i}, taut(hi, refl({bytes_at(b1, i)})))
    have u := union2_iff[a := set_image(bytes_len(b1), j. bytes_at(b1, j)), b := set_image(bytes_len(b2), j. bytes_at(b2, j)), z := bytes_at(b1, i)]
    show by taut(si, ex, u)
  qed
  have m2: all i. i in bytes_len(b2) -> bytes_at(b2, i) in T proof
    fix i
    assume hi
    have si := set_image_def[s := bytes_len(b2), f := j. bytes_at(b2, j), y := bytes_at(b2, i)]
    have ex: ex j. j in bytes_len(b2) && bytes_at(b2, j) = bytes_at(b2, i) by ex_intro({i}, taut(hi, refl({bytes_at(b2, i)})))
    have u := union2_iff[a := set_image(bytes_len(b1), j. bytes_at(b1, j)), b := set_image(bytes_len(b2), j. bytes_at(b2, j)), z := bytes_at(b2, i)]
    show by taut(si, ex, u)
  qed
  have l1 := apply(tr.bytes_list, {b1}, {T}, m1, h1)
  have l2 := apply(tr.bytes_list, {b2}, {T}, m2, h2)
  have lc := apply(tr.loaded_concat, {vm}, {lb}, {bytes_seq(b1)}, {bytes_seq(b2)}, {T}, {st}, l1, l2, hl, h)
  have fdm := fn_build_dom[d := bytes_len(b1), v := i. bytes_at(b1, i)]
  have sl: seq_len(bytes_seq(b1)) = bytes_len(b1) by defs(fdm, bytes_seq, seq_len)
  have r: abi.loaded(vm, int_add(lb, seq_len(bytes_seq(b1))), bytes_seq(b2), st) by taut(lc)
  show := rewrite(sl, r)
qed
