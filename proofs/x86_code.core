// Loaded machine code in the x86-64 model: fetching it, and why the
// program's memory accesses keep it (`abi.code_at`).
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core core/records.core \
//     build/musl_malloc_O0.core proofs/x86.core proofs/x86_code.core
//
// Accesses may grow the stack, but only into unmapped pages: the memory
// "grows" (`abi.vm_grows`: mapped pages and their bytes are kept). A write
// access to a mapped byte succeeds only if it is writable, and code is not:
// stores never change it.

// ----------------------------------------------------------------------
//  Fetching loaded code

// a + (rip - a) + i, as 64-bit addresses
theorem x86.addr_off(a, rip, i): a in omega -> rip in omega -> i in omega -> int_le(a, rip) -> int_lt(int_add(rip, i), 18446744073709551616) ->
  bits_add(64, rip, bits_of_int(64, i)) = bits_of_int(64, int_add(a, int_add(int_sub(rip, a), i)))
proof
  assume ha hr hi hle hlt
  show by defs(simp(ha, hr, hi, hle, hlt), bits_add, bits_of_int, pow2)
qed

// the n bytes at rip, inside loaded code, are fetchable
theorem x86.code_fetch: all vm a code rip n. a in omega -> rip in omega -> n in omega -> seq_len(code) in omega ->
  int_le(a, rip) -> int_le(int_add(rip, n), int_add(a, seq_len(code))) -> int_lt(int_add(a, seq_len(code)), 18446744073709551616) ->
  abi.code_at(vm, a, code) ->
  (all i. i in omega -> int_lt(i, n) -> x86_64_linux.fetchable(vm, bits_add(64, rip, bits_of_int(64, i))))
proof
  fix vm a code rip n
  assume ha hr hn hl h1 h2 h3 hc
  fix i
  assume hi hin
  have c := expand(hc, abi.code_at)
  have jo: int_add(int_sub(rip, a), i) in omega by arith(ha, hr, hi, h1)
  have jl: int_lt(int_add(int_sub(rip, a), i), seq_len(code)) by arith(ha, hr, hi, hn, hl, h1, h2, hin)
  have j := mp(mp(all_elim(c, {int_add(int_sub(rip, a), i)}), jo), jl)
  have lt: int_lt(int_add(rip, i), 18446744073709551616) by arith(ha, hr, hi, hn, hl, h2, h3, hin)
  have e := mp(mp(mp(mp(mp(x86.addr_off[a := a, rip := rip, i := i], ha), hr), hi), h1), lt)
  show by taut(rewrite(sym(e), j))
qed

// ----------------------------------------------------------------------
//  Memory that grows

theorem x86.grows_refl: all vm. abi.vm_grows(vm, vm)
proof
  fix vm
  show by defs(simp(), abi.vm_grows)
qed

theorem x86.grows_trans: all u v w. abi.vm_grows(u, v) -> abi.vm_grows(v, w) -> abi.vm_grows(u, w)
proof
  fix u v w
  assume h1 h2
  have g1 := expand(h1, abi.vm_grows)
  have g2 := expand(h2, abi.vm_grows)
  have g1p: all p. p in omega -> x86_64_linux.mapped(u, p) -> v.pages[p] = u.pages[p] by taut(g1)
  have g1b: all a. a in bits(64) -> x86_64_linux.mapped(u, x86_64_linux.page_of(a)) -> v.bytes[a] = u.bytes[a] by taut(g1)
  have g2p: all p. p in omega -> x86_64_linux.mapped(v, p) -> w.pages[p] = v.pages[p] by taut(g2)
  have g2b: all a. a in bits(64) -> x86_64_linux.mapped(v, x86_64_linux.page_of(a)) -> w.bytes[a] = v.bytes[a] by taut(g2)
  have pg: all p. p in omega -> x86_64_linux.mapped(u, p) -> w.pages[p] = u.pages[p] proof
    fix p
    assume hp hm
    have e1: v.pages[p] = u.pages[p] by taut(mp(mp(all_elim(g1p, {p}), hp), hm))
    have mv: x86_64_linux.mapped(v, p) by defs(taut(rewrite(sym(e1), expand(hm, x86_64_linux.mapped))), x86_64_linux.mapped)
    have e2: w.pages[p] = v.pages[p] by taut(mp(mp(all_elim(g2p, {p}), hp), mv))
    show trans(e2, e1)
  qed
  have by: all a. a in bits(64) -> x86_64_linux.mapped(u, x86_64_linux.page_of(a)) -> w.bytes[a] = u.bytes[a] proof
    fix a
    assume ha hm
    have po: x86_64_linux.page_of(a) in omega by defs(arith(ha), x86_64_linux.page_of, x86_64_linux.PAGE)
    have e1: v.pages[x86_64_linux.page_of(a)] = u.pages[x86_64_linux.page_of(a)] by taut(mp(mp(all_elim(g1p, {x86_64_linux.page_of(a)}), po), hm))
    have mv: x86_64_linux.mapped(v, x86_64_linux.page_of(a)) by defs(taut(rewrite(sym(e1), expand(hm, x86_64_linux.mapped))), x86_64_linux.mapped)
    have b1: v.bytes[a] = u.bytes[a] by taut(mp(mp(all_elim(g1b, {a}), ha), hm))
    have b2: w.bytes[a] = v.bytes[a] by taut(mp(mp(all_elim(g2b, {a}), ha), mv))
    show trans(b2, b1)
  qed
  show by defs(taut(pg, by), abi.vm_grows)
qed

// mapping a page that was unmapped keeps the old memory
theorem x86.grows_page: all v0 v i w. abi.vm_grows(v0, v) -> !x86_64_linux.mapped(v0, i) ->
  abi.vm_grows(v0, fn_update(v, "pages", fn_update(v.pages, i, w)))
proof
  fix v0 v i w
  assume h hn
  have g := expand(h, abi.vm_grows)
  have gp: all p. p in omega -> x86_64_linux.mapped(v0, p) -> v.pages[p] = v0.pages[p] by taut(g)
  have gb: all a. a in bits(64) -> x86_64_linux.mapped(v0, x86_64_linux.page_of(a)) -> v.bytes[a] = v0.bytes[a] by taut(g)
  have pg: all p. p in omega -> x86_64_linux.mapped(v0, p) -> fn_update(v.pages, i, w)[p] = v0.pages[p] proof
    fix p
    assume hp hm
    have ne0: p = i -> false proof
      assume e
      show by taut(rewrite(e, hm), hn)
    qed
    have ne: !(p = i) by taut(ne0)
    have a := mp(app_update_other[f := v.pages, k := i, v := w, x := p], ne)
    show trans(a, mp(mp(all_elim(gp, {p}), hp), hm))
  qed
  show by defs(simp(pg, gb), abi.vm_grows)
qed

// writing a byte on an unmapped page keeps the old memory
theorem x86.grows_byte: all v0 v b w. abi.vm_grows(v0, v) -> !x86_64_linux.mapped(v0, x86_64_linux.page_of(b)) ->
  abi.vm_grows(v0, fn_update(v, "bytes", fn_update(v.bytes, b, w)))
proof
  fix v0 v b w
  assume h hn
  have g := expand(h, abi.vm_grows)
  have gp: all p. p in omega -> x86_64_linux.mapped(v0, p) -> v.pages[p] = v0.pages[p] by taut(g)
  have gb: all a. a in bits(64) -> x86_64_linux.mapped(v0, x86_64_linux.page_of(a)) -> v.bytes[a] = v0.bytes[a] by taut(g)
  have bg: all a. a in bits(64) -> x86_64_linux.mapped(v0, x86_64_linux.page_of(a)) -> fn_update(v.bytes, b, w)[a] = v0.bytes[a] proof
    fix a
    assume ha hm
    have ne0: a = b -> false proof
      assume e
      show by taut(rewrite(e, hm), hn)
    qed
    have ne: !(a = b) by taut(ne0)
    have e1 := mp(app_update_other[f := v.bytes, k := b, v := w, x := a], ne)
    show trans(e1, mp(mp(all_elim(gb, {a}), ha), hm))
  qed
  show by defs(simp(gp, bg), abi.vm_grows)
qed

// loaded code stays loaded
theorem x86.code_grows: all v0 v a c. a in omega -> abi.code_at(v0, a, c) -> abi.vm_grows(v0, v) -> abi.code_at(v, a, c)
proof
  fix v0 v a c
  assume ha hc hg
  have cc := expand(hc, abi.code_at)
  have g := expand(hg, abi.vm_grows)
  have gp: all p. p in omega -> x86_64_linux.mapped(v0, p) -> v.pages[p] = v0.pages[p] by taut(g)
  have gb: all x. x in bits(64) -> x86_64_linux.mapped(v0, x86_64_linux.page_of(x)) -> v.bytes[x] = v0.bytes[x] by taut(g)
  have r: all i. i in omega -> int_lt(i, seq_len(c)) ->
      ((x86_64_linux.fetchable(v, bits_of_int(64, int_add(a, i))) && !x86_64_linux.can_access(v, bits_of_int(64, int_add(a, i)), 1)) &&
        !abi.stack_page(v, x86_64_linux.page_of(bits_of_int(64, int_add(a, i))))) &&
      v.bytes[bits_of_int(64, int_add(a, i))] = c[i] proof
    fix i
    assume hi hl
    have ci := mp(mp(all_elim(cc, {i}), hi), hl)
    have f0: x86_64_linux.fetchable(v0, bits_of_int(64, int_add(a, i))) by taut(ci)
    have n0: !x86_64_linux.can_access(v0, bits_of_int(64, int_add(a, i)), 1) by taut(ci)
    have s0: !abi.stack_page(v0, x86_64_linux.page_of(bits_of_int(64, int_add(a, i)))) by taut(ci)
    have b0: v0.bytes[bits_of_int(64, int_add(a, i))] = c[i] by taut(ci)
    have xo: bits_of_int(64, int_add(a, i)) in bits(64) by defs(simp(ha, hi), bits_of_int, pow2)
    have po: x86_64_linux.page_of(bits_of_int(64, int_add(a, i))) in omega by defs(simp(ha, hi), x86_64_linux.page_of, x86_64_linux.PAGE, bits_of_int, pow2)
    have m0: x86_64_linux.mapped(v0, x86_64_linux.page_of(bits_of_int(64, int_add(a, i)))) by taut(expand(f0, x86_64_linux.fetchable))
    have ep := mp(mp(all_elim(gp, {x86_64_linux.page_of(bits_of_int(64, int_add(a, i)))}), po), m0)
    have eb := mp(mp(all_elim(gb, {bits_of_int(64, int_add(a, i))}), xo), m0)
    have f1 := rewrite(sym(ep), expand(expand(f0, x86_64_linux.fetchable), x86_64_linux.mapped))
    have n1 := rewrite(sym(ep), expand(expand(n0, x86_64_linux.can_access), x86_64_linux.mapped))
    have b1 := rewrite(sym(eb), b0)
    have s1 := rewrite(sym(ep), expand(expand(s0, abi.stack_page), x86_64_linux.mapped))
    show by defs(taut(f1, n1, s1, b1), x86_64_linux.fetchable, x86_64_linux.can_access, x86_64_linux.mapped, abi.stack_page)
  qed
  show by defs(taut(r), abi.code_at)
qed

// an accessible byte stays accessible
theorem x86.access_grows: all v0 v x k. x in bits(64) -> x86_64_linux.can_access(v0, x, k) -> abi.vm_grows(v0, v) -> x86_64_linux.can_access(v, x, k)
proof
  fix v0 v x k
  assume hx hc hg
  have g := expand(hg, abi.vm_grows)
  have gp: all p. p in omega -> x86_64_linux.mapped(v0, p) -> v.pages[p] = v0.pages[p] by taut(g)
  have po: x86_64_linux.page_of(x) in omega by defs(simp(hx), x86_64_linux.page_of, x86_64_linux.PAGE)
  have m0: x86_64_linux.mapped(v0, x86_64_linux.page_of(x)) by taut(expand(hc, x86_64_linux.can_access))
  have ep := mp(mp(all_elim(gp, {x86_64_linux.page_of(x)}), po), m0)
  have c1 := rewrite(sym(ep), expand(expand(hc, x86_64_linux.can_access), x86_64_linux.mapped))
  show by defs(taut(c1), x86_64_linux.can_access, x86_64_linux.mapped)
qed

// a mapped page stays mapped
theorem x86.mapped_grows: all v0 v p. p in omega -> x86_64_linux.mapped(v0, p) -> abi.vm_grows(v0, v) -> x86_64_linux.mapped(v, p)
proof
  fix v0 v p
  assume hp hm hg
  have gp: all q. q in omega -> x86_64_linux.mapped(v0, q) -> v.pages[q] = v0.pages[q] by taut(expand(hg, abi.vm_grows))
  have e := mp(mp(all_elim(gp, {p}), hp), hm)
  show by defs(taut(rewrite(sym(e), expand(hm, x86_64_linux.mapped))), x86_64_linux.mapped)
qed

// ... and a byte on a page mapped before is accessible as it was
theorem x86.access_back: all v0 v x k. x in bits(64) -> x86_64_linux.mapped(v0, x86_64_linux.page_of(x)) -> abi.vm_grows(v0, v) ->
  x86_64_linux.can_access(v, x, k) -> x86_64_linux.can_access(v0, x, k)
proof
  fix v0 v x k
  assume hx hm hg hc
  have gp: all q. q in omega -> x86_64_linux.mapped(v0, q) -> v.pages[q] = v0.pages[q] by taut(expand(hg, abi.vm_grows))
  have po: x86_64_linux.page_of(x) in omega by defs(simp(hx), x86_64_linux.page_of)
  have e := mp(mp(all_elim(gp, {x86_64_linux.page_of(x)}), po), hm)
  have c1 := rewrite(e, expand(expand(hc, x86_64_linux.can_access), x86_64_linux.mapped))
  show by defs(taut(c1), x86_64_linux.can_access, x86_64_linux.mapped)
qed

// 64-bit address arithmetic stays in 64 bits
theorem x86.bits_add_type: all a b. a in omega -> b in omega -> bits_add(64, a, b) in bits(64)
proof
  fix a b
  assume ha hb
  show by defs(simp(ha, hb), bits_add, pow2)
qed

theorem x86.bits_of_int_type: all j. j in omega -> bits_of_int(64, j) in omega
proof
  fix j
  assume hj
  show by defs(simp(hj), bits_of_int, pow2)
qed

// ----------------------------------------------------------------------
//  Stack growth maps only unmapped pages

// the pages from p up to the next mapped page are unmapped
theorem x86.next_mapped_gap: all vm p j. p in omega -> j in omega -> int_le(p, j) ->
  int_lt(j, snd(x86_64_linux.next_mapped(vm, p))) -> !x86_64_linux.mapped(vm, j)
proof
  fix vm p j
  assume hp hj hle hlt
  have nm0: x86_64_linux.mapped(vm, j) -> false proof
    assume hm
    have pj: int_le(p, j) && x86_64_linux.mapped(vm, j) by taut(hle, hm)
    have c: j in omega && (int_le(p, j) && x86_64_linux.mapped(vm, j)) by taut(hj, hle, hm)
    have ex := ex_intro({j}, {x. x in omega && (int_le(p, x) && x86_64_linux.mapped(vm, x))}, c)
    have ms := mp(mp(int_min_spec[p := x. int_le(p, x) && x86_64_linux.mapped(vm, x), a := j], hj), pj)
    have low: all y. y in omega -> int_le(p, y) && x86_64_linux.mapped(vm, y) -> int_le(int_min(set_select(omega, x. int_le(p, x) && x86_64_linux.mapped(vm, x))), y) by taut(ms)
    have lm := mp(mp(all_elim(low, {j}), hj), pj)
    have it := mp(ite_t[c := ex x. x in omega && (int_le(p, x) && x86_64_linux.mapped(vm, x)), a := some(int_min(set_select(omega, x. int_le(p, x) && x86_64_linux.mapped(vm, x)))), b := none], ex)
    have lt := simp(rewrite(it, expand(hlt, x86_64_linux.next_mapped)))
    have mo: int_min(set_select(omega, x. int_le(p, x) && x86_64_linux.mapped(vm, x))) in omega by taut(ms)
    show by arith(hj, mo, lm, lt)
  qed
  show by taut(nm0)
qed

// ... in bytes: the addresses from page p up to the next mapped page
theorem x86.next_mapped_gap_bytes: all vm p i. p in omega -> i in omega -> int_le(int_mul(p, x86_64_linux.PAGE), i) ->
  int_lt(i, int_mul(snd(x86_64_linux.next_mapped(vm, p)), x86_64_linux.PAGE)) -> !x86_64_linux.mapped(vm, x86_64_linux.page_of(bits_of_int(64, i)))
proof
  fix vm p i
  assume hp hi hle hlt
  // the next mapped page exists (else the range is empty) and is below 2^47 / PAGE
  have nn0: !(ex x. x in omega && (int_le(p, x) && x86_64_linux.mapped(vm, x))) -> false proof
    assume ne
    have it := mp(ite_f[c := ex x. x in omega && (int_le(p, x) && x86_64_linux.mapped(vm, x)), a := some(int_min(set_select(omega, x. int_le(p, x) && x86_64_linux.mapped(vm, x)))), b := none], ne)
    have lt := simp(rewrite(it, expand(hlt, x86_64_linux.next_mapped)))
    show by arith(hi, lt)
  qed
  have ex: ex x. x in omega && (int_le(p, x) && x86_64_linux.mapped(vm, x)) by taut(nn0)
  obtain w, hw from ex
  have wo: w in omega by taut(hw)
  have pw: int_le(p, w) && x86_64_linux.mapped(vm, w) by taut(hw)
  have ms := mp(mp(int_min_spec[p := x. int_le(p, x) && x86_64_linux.mapped(vm, x), a := w], wo), pw)
  have it := mp(ite_t[c := ex x. x in omega && (int_le(p, x) && x86_64_linux.mapped(vm, x)), a := some(int_min(set_select(omega, x. int_le(p, x) && x86_64_linux.mapped(vm, x)))), b := none], ex)
  have lt := simp(rewrite(it, expand(hlt, x86_64_linux.next_mapped)))
  have mo: int_min(set_select(omega, x. int_le(p, x) && x86_64_linux.mapped(vm, x))) in omega by taut(ms)
  have mm: x86_64_linux.mapped(vm, int_min(set_select(omega, x. int_le(p, x) && x86_64_linux.mapped(vm, x)))) by taut(ms)
  have mb: int_lt(int_min(set_select(omega, x. int_le(p, x) && x86_64_linux.mapped(vm, x))), int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) by defs(taut(expand(mm, x86_64_linux.mapped)), x86_64_linux.mapped)
  have tv: int_div(x86_64_linux.TASK_SIZE, 4096) = 34359738367 by defs(simp(), x86_64_linux.TASK_SIZE)
  have small: int_lt(i, 18446744073709551616) by arith(hi, mo, simp(lt), rewrite(tv, simp(mb)))
  have md: int_mod(i, 18446744073709551616) = i by arith(hi, small)
  have pg: x86_64_linux.page_of(bits_of_int(64, i)) = int_div(i, 4096) by defs(simp(hi, small, md), x86_64_linux.page_of, x86_64_linux.PAGE, bits_of_int, pow2)
  have j1: int_le(p, int_div(i, 4096)) by arith(hp, hi, simp(hle))
  have j2: int_lt(int_div(i, 4096), int_min(set_select(omega, x. int_le(p, x) && x86_64_linux.mapped(vm, x)))) by arith(hi, mo, simp(lt))
  have jo: int_div(i, 4096) in omega by arith(hi)
  have j2x: int_lt(int_div(i, 4096), snd(x86_64_linux.next_mapped(vm, p))) by defs(simp(j2, it), x86_64_linux.next_mapped)
  have g := mp(mp(mp(mp(all_elim(all_elim(all_elim(x86.next_mapped_gap, {vm}), {p}), {int_div(i, 4096)}), hp), jo), j1), j2x)
  show by taut(rewrite(sym(pg), g))
qed

// the previous mapped page, if any, is an option
theorem x86.prev_mapped_cases: all vm p. fst(x86_64_linux.prev_mapped(vm, p)) = 1 || x86_64_linux.prev_mapped(vm, p) = none
proof
  fix vm p
  have c1: (ex x. x in omega && (int_lt(x, p) && x86_64_linux.mapped(vm, x))) -> fst(x86_64_linux.prev_mapped(vm, p)) = 1 proof
    assume e
    have it := mp(ite_t[c := ex x. x in omega && (int_lt(x, p) && x86_64_linux.mapped(vm, x)), a := some(int_max(set_select(omega, x. int_lt(x, p) && x86_64_linux.mapped(vm, x)))), b := none], e)
    show by defs(simp(it), x86_64_linux.prev_mapped)
  qed
  have c2: !(ex x. x in omega && (int_lt(x, p) && x86_64_linux.mapped(vm, x))) -> x86_64_linux.prev_mapped(vm, p) = none proof
    assume e
    have it := mp(ite_f[c := ex x. x in omega && (int_lt(x, p) && x86_64_linux.mapped(vm, x)), a := some(int_max(set_select(omega, x. int_lt(x, p) && x86_64_linux.mapped(vm, x)))), b := none], e)
    show by defs(simp(it), x86_64_linux.prev_mapped)
  qed
  show by taut(c1, c2)
qed

// growing the stack keeps the memory
theorem x86.grow_stack_grows: all m a p m1 e. p in omega -> runs(x86_64_linux.grow_stack(a, p), m, ok(m1, e)) -> abi.vm_grows(m.vm, m1.vm)
proof
  fix m a p m1 e
  assume hp h
  have gap := all_elim(all_elim(x86.next_mapped_gap, {m.vm}), {p})
  have gapb := all_elim(all_elim(x86.next_mapped_gap_bytes, {m.vm}), {p})
  show by simp(h, hp, gap, gapb, x86.prev_mapped_cases, x86.grows_page, x86.grows_byte, x86.grows_refl, keep(abi.vm_grows, x86_64_linux.mapped, x86_64_linux.next_mapped, x86_64_linux.prev_mapped, x86_64_linux.run_end),
    {l0 l. abi.vm_grows(m.vm, fst(l).vm) && snd(l) in omega && int_le(p, snd(l))},
    {l0 l. abi.vm_grows(m.vm, fst(l).vm) && snd(l) in omega && int_le(int_mul(p, x86_64_linux.PAGE), snd(l))})
qed

// ----------------------------------------------------------------------
//  Accesses

// an access keeps the memory (up to stack growth)
theorem x86.touch_frame: all m x k m1 e. x in bits(64) -> runs(x86_64_linux.touch(x, k), m, ok(m1, e)) -> abi.vm_grows(m.vm, m1.vm)
proof
  fix m x k m1 e
  assume hx h
  have po: x86_64_linux.page_of(x) in omega by defs(simp(hx), x86_64_linux.page_of)
  show by simp(h, hx, po, x86.grow_stack_grows, x86.grows_refl, keep(x86_64_linux.grow_stack, abi.vm_grows, x86_64_linux.mapped, x86_64_linux.page_of))
qed

// a write access to a mapped byte succeeds only if it is writable
theorem x86.touch_write: all m x m1 e. runs(x86_64_linux.touch(x, 1), m, ok(m1, e)) ->
  x86_64_linux.mapped(m.vm, x86_64_linux.page_of(x)) -> x86_64_linux.can_access(m.vm, x, 1)
proof
  fix m x m1 e
  assume h hm
  show by defs(simp(expand(expand(h, x86_64_linux.touch), x86_64_linux.hw_allows), hm, keep(x86_64_linux.grow_stack, x86_64_linux.mapped, x86_64_linux.page_of)), x86_64_linux.can_access, x86_64_linux.hw_allows)
qed

// ... after the memory grew from v0: the byte is unmapped in v0 or was
// writable there
theorem x86.touch_write0: all v0 m x m1 e. x in bits(64) -> abi.vm_grows(v0, m.vm) -> runs(x86_64_linux.touch(x, 1), m, ok(m1, e)) ->
  !x86_64_linux.mapped(v0, x86_64_linux.page_of(x)) || x86_64_linux.can_access(v0, x, 1)
proof
  fix v0 m x m1 e
  assume hx hg h
  have c: x86_64_linux.mapped(v0, x86_64_linux.page_of(x)) -> x86_64_linux.can_access(v0, x, 1) proof
    assume hm
    have po: x86_64_linux.page_of(x) in omega by defs(simp(hx), x86_64_linux.page_of)
    have mm := mp(mp(mp(all_elim(all_elim(all_elim(x86.mapped_grows, {v0}), {m.vm}), {x86_64_linux.page_of(x)}), po), hm), hg)
    have cw := mp(mp(all_elim(all_elim(all_elim(all_elim(x86.touch_write, {m}), {x}), {m1}), {e}), h), mm)
    show mp(mp(mp(mp(all_elim(all_elim(all_elim(all_elim(x86.access_back, {v0}), {m.vm}), {x}), {1}), hx), hm), hg), cw)
  qed
  show by taut(c)
qed

// the two touch lemmas at an address a + j
theorem x86.touch_frame_at: all m a j k m1 e. runs(x86_64_linux.touch(bits_add(64, a, bits_of_int(64, j)), k), m, ok(m1, e)) -> abi.vm_grows(m.vm, m1.vm)
proof
  fix m a j k m1 e
  assume h
  have t: bits_add(64, a, bits_of_int(64, j)) in bits(64) by simp()
  show mp(mp(all_elim(all_elim(all_elim(all_elim(all_elim(x86.touch_frame, {m}), {bits_add(64, a, bits_of_int(64, j))}), {k}), {m1}), {e}), t), h)
qed

theorem x86.touch_write_at: all v0 m a j m1 e. abi.vm_grows(v0, m.vm) -> runs(x86_64_linux.touch(bits_add(64, a, bits_of_int(64, j)), 1), m, ok(m1, e)) ->
  !x86_64_linux.mapped(v0, x86_64_linux.page_of(bits_add(64, a, bits_of_int(64, j)))) || x86_64_linux.can_access(v0, bits_add(64, a, bits_of_int(64, j)), 1)
proof
  fix v0 m a j m1 e
  assume hg h
  have t: bits_add(64, a, bits_of_int(64, j)) in bits(64) by simp()
  show mp(mp(mp(all_elim(all_elim(all_elim(all_elim(all_elim(x86.touch_write0, {v0}), {m}), {bits_add(64, a, bits_of_int(64, j))}), {m1}), {e}), t), hg), h)
qed

// the bytes a + j (j < i) written: unmapped in v0 or writable there
theorem x86.prefix_zero: all v0 a. all j. j in omega -> int_lt(j, 0) -> (!x86_64_linux.mapped(v0, x86_64_linux.page_of(bits_add(64, a, bits_of_int(64, j)))) || x86_64_linux.can_access(v0, bits_add(64, a, bits_of_int(64, j)), 1))
proof
  fix v0 a j
  assume hj hl
  have f: false by arith(hj, hl)
  show by taut(f)
qed

theorem x86.prefix_ext: all v0 a i. i in omega -> (all j. j in omega -> int_lt(j, i) -> (!x86_64_linux.mapped(v0, x86_64_linux.page_of(bits_add(64, a, bits_of_int(64, j)))) || x86_64_linux.can_access(v0, bits_add(64, a, bits_of_int(64, j)), 1))) -> (!x86_64_linux.mapped(v0, x86_64_linux.page_of(bits_add(64, a, bits_of_int(64, i)))) || x86_64_linux.can_access(v0, bits_add(64, a, bits_of_int(64, i)), 1)) ->
  (all j. j in omega -> int_lt(j, int_add(i, 1)) -> (!x86_64_linux.mapped(v0, x86_64_linux.page_of(bits_add(64, a, bits_of_int(64, j)))) || x86_64_linux.can_access(v0, bits_add(64, a, bits_of_int(64, j)), 1)))
proof
  fix v0 a i
  assume hi hp hq
  fix j
  assume hj hl
  have c1: int_lt(j, i) -> (!x86_64_linux.mapped(v0, x86_64_linux.page_of(bits_add(64, a, bits_of_int(64, j)))) || x86_64_linux.can_access(v0, bits_add(64, a, bits_of_int(64, j)), 1)) by taut(all_elim(hp, {j}), hj)
  have c2: !int_lt(j, i) -> (!x86_64_linux.mapped(v0, x86_64_linux.page_of(bits_add(64, a, bits_of_int(64, j)))) || x86_64_linux.can_access(v0, bits_add(64, a, bits_of_int(64, j)), 1)) proof
    assume n
    have e: i = j by arith(hi, hj, hl, n)
    show by taut(rewrite(e, hq))
  qed
  show by taut(c1, c2)
qed

// a write access to n bytes: each is unmapped before or was writable
theorem x86.touch_range_write: all m a n m1 e. n in omega -> runs(x86_64_linux.touch_range(a, n, 1), m, ok(m1, e)) ->
  (all j. j in omega -> int_lt(j, n) -> (!x86_64_linux.mapped(m.vm, x86_64_linux.page_of(bits_add(64, a, bits_of_int(64, j)))) || x86_64_linux.can_access(m.vm, bits_add(64, a, bits_of_int(64, j)), 1)))
proof
  fix m a n m1 e
  assume hn h
  have en: all p. p in omega -> int_le(p, n) -> !int_lt(p, n) -> n = p proof
    fix p
    assume hp h1 h2
    show by arith(hp, hn, h1, h2)
  qed
  show by simp(h, hn, en, x86.touch_frame_at, x86.grows_trans, x86.grows_refl, x86.touch_write_at, x86.prefix_ext, x86.prefix_zero,
    keep(x86_64_linux.touch, abi.vm_grows, x86_64_linux.mapped, x86_64_linux.page_of, x86_64_linux.can_access),
    {l0 l. abi.vm_grows(m.vm, fst(l).vm) && snd(l) in omega && int_le(snd(l), n) && (all j. j in omega -> int_lt(j, snd(l)) -> (!x86_64_linux.mapped(m.vm, x86_64_linux.page_of(bits_add(64, a, bits_of_int(64, j)))) || x86_64_linux.can_access(m.vm, bits_add(64, a, bits_of_int(64, j)), 1)))},
    {l. int_sub(n, snd(l))})
qed

// accesses to n bytes keep the memory (up to stack growth)
theorem x86.touch_range_frame: all m a n k m1 e. n in omega -> runs(x86_64_linux.touch_range(a, n, k), m, ok(m1, e)) ->
  abi.vm_grows(m.vm, m1.vm)
proof
  fix m a n k m1 e
  assume hn h
  show by simp(h, hn, x86.touch_frame_at, x86.grows_trans, x86.grows_refl, keep(x86_64_linux.touch, abi.vm_grows),
    {l0 l. abi.vm_grows(m.vm, fst(l).vm) && snd(l) in omega && int_le(snd(l), n)}, {l. int_sub(n, snd(l))})
qed

// stack growth changes only the memory
theorem x86.grow_stack_vm: all m a p m1 e. runs(x86_64_linux.grow_stack(a, p), m, ok(m1, e)) -> m1 = m || (ex v. m1 = fn_update(m, "vm", v))
proof
  fix m a p m1 e
  assume h
  show by simp(h, x86.prev_mapped_cases, keep(x86_64_linux.next_mapped, x86_64_linux.prev_mapped, x86_64_linux.run_end, x86_64_linux.mapped),
    {l0 l. fst(l) = m || (ex v. fst(l) = fn_update(m, "vm", v))})
qed

// ... and so do accesses
theorem x86.touch_vm: all m x k m1 e. runs(x86_64_linux.touch(x, k), m, ok(m1, e)) -> e = empty && (m1 = m || (ex v. m1 = fn_update(m, "vm", v)))
proof
  fix m x k m1 e
  assume h
  show by simp(h, x86.grow_stack_vm, keep(x86_64_linux.grow_stack, x86_64_linux.mapped))
qed

theorem x86.touch_range_vm: all m a n k m1 e. runs(x86_64_linux.touch_range(a, n, k), m, ok(m1, e)) -> e = empty && (m1 = m || (ex v. m1 = fn_update(m, "vm", v)))
proof
  fix m a n k m1 e
  assume h
  show by simp(h, x86.touch_vm, keep(x86_64_linux.touch), {l0 l. fst(l) = m || (ex v. fst(l) = fn_update(m, "vm", v))})
qed

// ----------------------------------------------------------------------
//  Loaded code survives the program's accesses and stores

// a + (c - a) = c, as 64-bit addresses (any a: effective addresses are
// sums that wrap around)
theorem x86.bits_add_sub_any(a, c): c in bits(64) -> bits_add(64, a, bits_of_int(64, bits_sub(64, c, a))) = c
proof
  assume hc
  show by arith(hc)
qed

// reading through a store of n bytes at a, at an address c none of them is
theorem x86.store_outside: all b a n v c. c in bits(64) ->
  (all i. i in omega -> int_lt(i, n) -> !(bits_add(64, a, bits_of_int(64, i)) = c)) ->
  x86_64_linux.store_le(b, a, n, v)[c] = b[c]
proof
  fix b a n v c
  assume hc hw
  have e1 := mp(app_fn_build[d := bits(64), v := x. ite(int_lt(bits_sub(64, x, a), n), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), b[x]), a := c], hc)
  have k: bits_sub(64, c, a) in omega by simp()
  have id := mp(x86.bits_add_sub_any[a := a, c := c], hc)
  have nlt0: int_lt(bits_sub(64, c, a), n) -> false proof
    assume lt
    have w := mp(mp(all_elim(hw, {bits_sub(64, c, a)}), k), lt)
    show by taut(id, w)
  qed
  have nlt: !int_lt(bits_sub(64, c, a), n) by taut(nlt0)
  have f := mp(ite_f[c := int_lt(bits_sub(64, c, a), n), a := bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, c, a)))), b := b[c]], nlt)
  show by defs(taut(trans(e1, f)), x86_64_linux.store_le)
qed

// a store (after its write accesses) keeps loaded code: code is not writable
// (the code first: instantiated for a function, a rule for simp)
theorem x86.store_code: all f code m a n m1 e. n in omega -> f in omega ->
  runs(x86_64_linux.touch_range(a, n, 1), m, ok(m1, e)) -> abi.code_at(m.vm, f, code) ->
  (all v. abi.code_at(fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, a, n, v)), f, code))
proof
  fix f code m a n m1 e
  assume hn hf h hc
  have g := mp(mp(all_elim(all_elim(all_elim(all_elim(all_elim(all_elim(x86.touch_range_frame, {m}), {a}), {n}), {1}), {m1}), {e}), hn), h)
  have c1 := mp(mp(mp(all_elim(all_elim(all_elim(all_elim(x86.code_grows, {m.vm}), {m1.vm}), {f}), {code}), hf), hc), g)
  have tw := mp(mp(all_elim(all_elim(all_elim(all_elim(all_elim(x86.touch_range_write, {m}), {a}), {n}), {m1}), {e}), hn), h)
  have cc := expand(hc, abi.code_at)
  have cc1 := expand(c1, abi.code_at)
  fix v
  have r: all i. i in omega -> int_lt(i, seq_len(code)) ->
      (x86_64_linux.fetchable(fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, a, n, v)), bits_of_int(64, int_add(f, i))) &&
       !x86_64_linux.can_access(fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, a, n, v)), bits_of_int(64, int_add(f, i)), 1) &&
       !abi.stack_page(fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, a, n, v)), x86_64_linux.page_of(bits_of_int(64, int_add(f, i))))) &&
      fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, a, n, v)).bytes[bits_of_int(64, int_add(f, i))] = code[i] proof
    fix i
    assume hi hl
    have ci := mp(mp(all_elim(cc, {i}), hi), hl)
    have ci1 := mp(mp(all_elim(cc1, {i}), hi), hl)
    have co: bits_of_int(64, int_add(f, i)) in bits(64) by defs(simp(hf, hi), bits_of_int, pow2)
    have fe: x86_64_linux.fetchable(m.vm, bits_of_int(64, int_add(f, i))) by taut(ci)
    have mp0: x86_64_linux.mapped(m.vm, x86_64_linux.page_of(bits_of_int(64, int_add(f, i)))) by taut(expand(fe, x86_64_linux.fetchable))
    have nw: !x86_64_linux.can_access(m.vm, bits_of_int(64, int_add(f, i)), 1) by taut(ci)
    have out: all j. j in omega -> int_lt(j, n) -> !(bits_add(64, a, bits_of_int(64, j)) = bits_of_int(64, int_add(f, i))) proof
      fix j
      assume hj hjl
      have tj := mp(mp(all_elim(tw, {j}), hj), hjl)
      have ne0: bits_add(64, a, bits_of_int(64, j)) = bits_of_int(64, int_add(f, i)) -> false proof
        assume eq
        show by taut(rewrite(eq, tj), mp0, nw)
      qed
      show by taut(ne0)
    qed
    have so := mp(mp(all_elim(all_elim(all_elim(all_elim(all_elim(x86.store_outside, {m1.vm.bytes}), {a}), {n}), {v}), {bits_of_int(64, int_add(f, i))}), co), out)
    show by defs(simp(expand(ci1, x86_64_linux.fetchable, x86_64_linux.can_access, x86_64_linux.mapped, abi.stack_page), so), x86_64_linux.fetchable, x86_64_linux.can_access, x86_64_linux.mapped, abi.stack_page)
  qed
  show by defs(taut(r), abi.code_at)
qed

// ----------------------------------------------------------------------
//  Accesses to accessible bytes change nothing (rules for simp, per
//  access size: a byte-by-byte fact for each byte, the address a + i in
//  simp's canonical form)

theorem x86.touch_range_ok_1: all m a k o. x86_64_linux.can_access(m.vm, bits_add(64, a, 0), k) ->
  runs(x86_64_linux.touch_range(a, 1, k), m, o) -> o = ok(m, empty)
proof
  fix m a k o
  assume h0 h
  have mem := members({set_select(omega, i. int_lt(i, 1))})
  have hall: all i. i in omega -> int_lt(i, 1) -> x86_64_linux.can_access(m.vm, bits_add(64, a, bits_of_int(64, i)), k) proof
    fix i
    assume hi hl
    have s: i in set_select(omega, i. int_lt(i, 1)) by sel(taut(hi, hl))
    have ei: i = 0 by taut(all_elim(mem, {i}), s)
    show by simp(ei, h0, keep(x86_64_linux.can_access))
  qed
  have no: 1 in omega by arith()
  show mp(mp(mp(all_elim(all_elim(all_elim(all_elim(all_elim(x86.touch_range_access, {m}), {a}), {1}), {k}), {o}), no), hall), h)
qed

theorem x86.touch_range_ok_2: all m a k o. x86_64_linux.can_access(m.vm, bits_add(64, a, 0), k) -> x86_64_linux.can_access(m.vm, bits_add(64, a, 1), k) ->
  runs(x86_64_linux.touch_range(a, 2, k), m, o) -> o = ok(m, empty)
proof
  fix m a k o
  assume h0 h1 h
  have mem := members({set_select(omega, i. int_lt(i, 2))})
  have hall: all i. i in omega -> int_lt(i, 2) -> x86_64_linux.can_access(m.vm, bits_add(64, a, bits_of_int(64, i)), k) proof
    fix i
    assume hi hl
    have s: i in set_select(omega, i. int_lt(i, 2)) by sel(taut(hi, hl))
    have ei: i = 0 || i = 1 by taut(all_elim(mem, {i}), s)
    show by simp(ei, h0, h1, keep(x86_64_linux.can_access))
  qed
  have no: 2 in omega by arith()
  show mp(mp(mp(all_elim(all_elim(all_elim(all_elim(all_elim(x86.touch_range_access, {m}), {a}), {2}), {k}), {o}), no), hall), h)
qed

theorem x86.touch_range_ok_4: all m a k o. x86_64_linux.can_access(m.vm, bits_add(64, a, 0), k) -> x86_64_linux.can_access(m.vm, bits_add(64, a, 1), k) ->
  x86_64_linux.can_access(m.vm, bits_add(64, a, 2), k) -> x86_64_linux.can_access(m.vm, bits_add(64, a, 3), k) ->
  runs(x86_64_linux.touch_range(a, 4, k), m, o) -> o = ok(m, empty)
proof
  fix m a k o
  assume h0 h1 h2 h3 h
  have mem := members({set_select(omega, i. int_lt(i, 4))})
  have hall: all i. i in omega -> int_lt(i, 4) -> x86_64_linux.can_access(m.vm, bits_add(64, a, bits_of_int(64, i)), k) proof
    fix i
    assume hi hl
    have s: i in set_select(omega, i. int_lt(i, 4)) by sel(taut(hi, hl))
    have ei: i = 0 || i = 1 || i = 2 || i = 3 by taut(all_elim(mem, {i}), s)
    show by simp(ei, h0, h1, h2, h3, keep(x86_64_linux.can_access))
  qed
  have no: 4 in omega by arith()
  show mp(mp(mp(all_elim(all_elim(all_elim(all_elim(all_elim(x86.touch_range_access, {m}), {a}), {4}), {k}), {o}), no), hall), h)
qed

theorem x86.touch_range_ok_8: all m a k o. x86_64_linux.can_access(m.vm, bits_add(64, a, 0), k) -> x86_64_linux.can_access(m.vm, bits_add(64, a, 1), k) ->
  x86_64_linux.can_access(m.vm, bits_add(64, a, 2), k) -> x86_64_linux.can_access(m.vm, bits_add(64, a, 3), k) ->
  x86_64_linux.can_access(m.vm, bits_add(64, a, 4), k) -> x86_64_linux.can_access(m.vm, bits_add(64, a, 5), k) ->
  x86_64_linux.can_access(m.vm, bits_add(64, a, 6), k) -> x86_64_linux.can_access(m.vm, bits_add(64, a, 7), k) ->
  runs(x86_64_linux.touch_range(a, 8, k), m, o) -> o = ok(m, empty)
proof
  fix m a k o
  assume h0 h1 h2 h3 h4 h5 h6 h7 h
  have mem := members({set_select(omega, i. int_lt(i, 8))})
  have hall: all i. i in omega -> int_lt(i, 8) -> x86_64_linux.can_access(m.vm, bits_add(64, a, bits_of_int(64, i)), k) proof
    fix i
    assume hi hl
    have s: i in set_select(omega, i. int_lt(i, 8)) by sel(taut(hi, hl))
    have ei: i = 0 || i = 1 || i = 2 || i = 3 || i = 4 || i = 5 || i = 6 || i = 7 by taut(all_elim(mem, {i}), s)
    show by simp(ei, h0, h1, h2, h3, h4, h5, h6, h7, keep(x86_64_linux.can_access))
  qed
  have no: 8 in omega by arith()
  show mp(mp(mp(all_elim(all_elim(all_elim(all_elim(all_elim(x86.touch_range_access, {m}), {a}), {8}), {k}), {o}), no), hall), h)
qed

// an accessible address is canonical (its page is mapped, below TASK_SIZE)
theorem x86.access_canonical: all v a k. x86_64_linux.can_access(v, a, k) -> x86_64_linux.canonical(a)
proof
  fix v a k
  assume h
  have m: int_lt(int_div(a, 4096), 34359738367) by simp(expand(expand(expand(h, x86_64_linux.can_access), x86_64_linux.mapped), x86_64_linux.page_of, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))
  show by defs(simp(m), x86_64_linux.canonical)
qed
