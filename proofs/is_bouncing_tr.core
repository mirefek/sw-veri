theorem ibt.implements: all statics. tr.implements_at(4203843, c_src_malloc_mallocng_malloc.is_bouncing_fun(), 4202755, text.code, statics)
proof
  fix statics
  have hsub: all vm. abi.loaded(vm, 4202755, text.code, statics) -> abi.code_at(vm, 4203843, is_bouncing.code) proof
    fix vm
    assume h: abi.loaded(vm, 4202755, text.code, statics)
    have l := mp(all_elim(is_bouncing.in_text, {vm}, {statics}), h)
    show by taut(expand(l, abi.loaded))
  qed
  have hregs: all args s. args in abi.ARGS -> s in x86_64_linux.Machine -> abi.entry_ok(s, args) -> ord_le(1, seq_len(args)) -> tr.regs(s, fn_update(empty, 7, pair(8, bits_of_int(64, app(args, 0))))) proof
    fix args
    fix s
    assume hA hM he hg
    have ln: seq_len(args) in omega by simp(hA)
    have r0 := all_elim(tr.regs_empty, {s})
    have a0 := apply(tr.arg_reg, {s}, {args}, {0}, {7}, hM, he, simp(), (int_lt(0, seq_len(args)) by arith(ln, expand(hg, ord_le))), simp(tr.argregs), simp())
    have r1 := apply(tr.regs_add, {s}, {empty}, {7}, {8}, {bits_of_int(64, app(args, 0))}, r0, simp(a0), simp(a0))
    show := r1
  qed
  have m0 := mp(tr.entry_n[lb := 4202755, lc := text.code, base := 4203843, code := is_bouncing.code, statics := statics, f := 4203843, n := 1, fd := 4, rs := x0. fn_update(empty, 7, pair(8, bits_of_int(64, app(x0, 0)))),
    q := x0. c_src_malloc_mallocng_malloc.is_bouncing(bits_of_int(32, app(x0, 0))), kw := x0 x1 x2. letin(x1, x3. bind_rel(gimple.result(32, x3), x0, x4 x5. any_rel(x6. x6 in bits(64), x6. x2 = ok(x4, pair(x5, x6))), x4 x5. x2 = exc(x4, x5), x4. x2 = diverge(x4)))],
    simp(), hsub, hregs, all_elim(ibt.body, {statics}))
  have m: all args objs mem s o. args in abi.ARGS -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) ->
      abi.loaded(app(s, "vm"), 4202755, text.code, statics) -> app(s, "rip") = 4203843 -> abi.entry_ok(s, args) -> tr.objs_ok(s, objs) -> abi.view_ok(s, objs, mem) -> tr.run_d(s, s, o) ->
      tr.matches_t(c_src_malloc_mallocng_malloc.is_bouncing_fun(), args, objs, mem, s, o) by defs(m0, c_src_malloc_mallocng_malloc.is_bouncing_fun)
  show by defs(m, tr.implements_at)
qed

theorem ibt.implements_abi: all statics. abi.implements2_at(single(empty), 4203843, c_src_malloc_mallocng_malloc.is_bouncing_fun(), 4202755, text.code, statics)
proof
  fix statics
  show := apply(tr.implements_abi, all_elim(ibt.implements, {statics}))
qed

