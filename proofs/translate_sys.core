// A system call in the translation (docs/overview.md, C1): the machine's
// `syscall` against readable GIMPLE's sys_call1 / sys_call3 / sys_call6.
// Linux changes the pages p .. p+n-1 (and their bytes, the break) of the
// machine's memory, off the stack's space, none of them executable; the
// world's memory changes the same way there (the world's call allows it:
// proofs/gimple_sys.core), and the coupling holds after it -- its stack,
// its code, its frames untouched (tr.chg_*).
//
//   checked after proofs/linux_sys.core

// ----------------------------------------------------------------------
//  The change: the machine's memory m0 to V, the world's w0 to WV

def tr.vm_chg(m0, V, w0, WV, p, n) :=
  V.stack_top = m0.stack_top && V.stack_limit = m0.stack_limit && V.brk_start = m0.brk_start &&
  WV.stack_top = w0.stack_top && WV.stack_limit = w0.stack_limit && WV.brk_start = w0.brk_start && V.brk = WV.brk &&
  p in omega && n in omega && x86_64_linux.off_stack_space(m0, p, n) &&
  (all q. q in omega -> int_le(p, q) -> int_lt(q, int_add(p, n)) -> x86_64_linux.mapped(m0, q) -> !snd(m0.pages[q]).prot.x) &&
  (all q. q in omega -> !(int_le(p, q) && int_lt(q, int_add(p, n))) -> V.pages[q] = m0.pages[q]) &&
  (all q. q in omega -> int_lt(q, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) -> !(int_le(p, q) && int_lt(q, int_add(p, n))) -> WV.pages[q] = w0.pages[q]) &&
  (all q. q in omega -> int_lt(q, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) -> int_le(p, q) -> int_lt(q, int_add(p, n)) -> WV.pages[q] = V.pages[q]) &&
  (all q. q in omega -> int_le(p, q) -> int_lt(q, int_add(p, n)) -> V.pages[q] = none || !(snd(V.pages[q]).kind = 2)) &&
  (all a. a in bits(64) -> !(int_le(p, x86_64_linux.page_of(a)) && int_lt(x86_64_linux.page_of(a), int_add(p, n))) ->
    V.bytes[a] = m0.bytes[a] && WV.bytes[a] = w0.bytes[a]) &&
  (all a. a in bits(64) -> int_le(p, x86_64_linux.page_of(a)) -> int_lt(x86_64_linux.page_of(a), int_add(p, n)) ->
    x86_64_linux.mapped(V, x86_64_linux.page_of(a)) -> WV.bytes[a] = V.bytes[a])

// (a page within the stack's space: not in a range off it)
theorem tr.chg_space(vm, p, n, q): x86_64_linux.off_stack_space(vm, p, n) -> p in omega -> n in omega -> q in omega ->
  int_le(x86_64_linux.stack_floor(vm), int_mul(q, x86_64_linux.PAGE)) -> int_le(int_mul(int_add(q, 1), x86_64_linux.PAGE), vm.stack_top) ->
  !(int_le(p, q) && int_lt(q, int_add(p, n)))
proof
  assume ho hp hn hq l1 l2
  have pg4: x86_64_linux.PAGE = 4096 by rsimp(x86_64_linux.PAGE)
  have gp: x86_64_linux.STACK_GUARD_GAP = 1048576 by rsimp(x86_64_linux.STACK_GUARD_GAP, x86_64_linux.PAGE)
  have o := expand(ho, x86_64_linux.off_stack_space)
  have k1: int_le(int_add(int_mul(int_add(p, n), x86_64_linux.PAGE), x86_64_linux.STACK_GUARD_GAP), x86_64_linux.stack_floor(vm)) ->
      !(int_le(p, q) && int_lt(q, int_add(p, n))) proof
    assume h
    show by arith(h, l1, pg4, gp, hp, hn, hq)
  qed
  have k2: int_le(vm.stack_top, int_mul(p, x86_64_linux.PAGE)) -> !(int_le(p, q) && int_lt(q, int_add(p, n))) proof
    assume h
    show by arith(h, l2, pg4, hp, hn, hq)
  qed
  show by taut(o, k1, k2)
qed

// (a stack page: not in the range, off the stack's space -- the stack's
// pages are within it)
theorem tr.chg_stack(vm, p, n, q): abi.stack_reserve(vm) -> x86_64_linux.off_stack_space(vm, p, n) -> p in omega -> n in omega -> q in omega ->
  abi.stack_page(vm, q) -> !(int_le(p, q) && int_lt(q, int_add(p, n)))
proof
  assume hr ho hp hn hq hs
  have _ _ rc _ := expand(hr, abi.stack_reserve)
  have l1 l2 _ _ := mp(all_elim(rc, {q}), hq, hs)
  show := apply(tr.chg_space, ho, hp, hn, hq, l1, l2)
qed

// (a range's page of V: no stack page)
theorem tr.chg_nostk(m0, V, w0, WV, p, n, q): tr.vm_chg(m0, V, w0, WV, p, n) -> q in omega -> int_le(p, q) -> int_lt(q, int_add(p, n)) -> !abi.stack_page(V, q)
proof
  assume hc hq h1 h2
  have _ _ _ _ _ _ _ _ _ _ _ _ _ _ vns _ _ := expand(hc, tr.vm_chg)
  have k := mp(all_elim(vns, {q}), hq, h1, h2)
  show by defs(taut(k), abi.stack_page, x86_64_linux.mapped)
qed

// (a stack page of V: m0's, out of the range)
theorem tr.chg_stk_back(m0, V, w0, WV, p, n, q): tr.vm_chg(m0, V, w0, WV, p, n) -> q in omega -> abi.stack_page(V, q) ->
  !(int_le(p, q) && int_lt(q, int_add(p, n))) && V.pages[q] = m0.pages[q] && abi.stack_page(m0, q)
proof
  assume hc hq hs
  have _ _ _ _ _ _ _ _ _ _ _ vp _ _ _ _ _ := expand(hc, tr.vm_chg)
  have nr: !(int_le(p, q) && int_lt(q, int_add(p, n))) proof
    assume h
    have h1 h2 := h
    show by taut(hs, apply(tr.chg_nostk, hc, hq, h1, h2))
  qed
  have e := mp(all_elim(vp, {q}), hq, nr)
  have sm: abi.stack_page(m0, q) by defs(rewrite(e, expand(hs, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
  show by taut(nr, e, sm)
qed

// the stack's reserve kept: its pages m0's, the new ones off its space
theorem tr.rsv_chg(m0, V, w0, WV, p, n): abi.stack_reserve(m0) -> m0.stack_top in omega -> tr.vm_chg(m0, V, w0, WV, p, n) -> abi.stack_reserve(V)
proof
  assume hr htop hc
  have vt vl _ _ _ _ _ po no os _ vp _ _ vns _ _ := expand(hc, tr.vm_chg)
  have ra rb rc rd := expand(hr, abi.stack_reserve)
  have fl: x86_64_linux.stack_floor(V) = x86_64_linux.stack_floor(m0) by rsimp(x86_64_linux.stack_floor, vt, vl)
  have a2: int_le(x86_64_linux.STACK_GUARD_GAP, x86_64_linux.stack_floor(V)) := rewrite(sym(fl), ra)
  have b2: int_mod(V.stack_top, x86_64_linux.PAGE) = 0 := rewrite(sym(vt), rb)
  // a stack page of V: m0's, its run to the top m0's
  have c2: all x0. x0 in omega -> abi.stack_page(V, x0) ->
      ((int_le(x86_64_linux.stack_floor(V), int_mul(x0, x86_64_linux.PAGE)) && int_le(int_mul(int_add(x0, 1), x86_64_linux.PAGE), V.stack_top)) &&
        (all x1. x1 in omega -> int_le(x0, x1) && int_le(int_mul(int_add(x1, 1), x86_64_linux.PAGE), V.stack_top) -> V.pages[x1] = V.pages[x0])) &&
      !(V.pages[int_div(V.stack_top, x86_64_linux.PAGE)] = V.pages[x0]) proof
    fix x0
    assume hx hs
    have nr e0 sm := apply(tr.chg_stk_back, hc, hx, hs)
    have cl1 cl2 crun ctop := mp(all_elim(rc, {x0}), hx, sm)
    have bnds: int_le(x86_64_linux.stack_floor(V), int_mul(x0, x86_64_linux.PAGE)) && int_le(int_mul(int_add(x0, 1), x86_64_linux.PAGE), V.stack_top)
      by taut(rewrite(sym(fl), cl1), rewrite(sym(vt), cl2))
    have run: all x1. x1 in omega -> int_le(x0, x1) && int_le(int_mul(int_add(x1, 1), x86_64_linux.PAGE), V.stack_top) -> V.pages[x1] = V.pages[x0] proof
      fix x1
      assume h1 h2
      have em := mp(all_elim(crun, {x1}), h1, rewrite(vt, h2))
      have pg4: x86_64_linux.PAGE = 4096 by rsimp(x86_64_linux.PAGE)
      have f1: int_le(x86_64_linux.stack_floor(m0), int_mul(x1, x86_64_linux.PAGE)) by arith(cl1, h2, pg4, hx, h1)
      have n1 := apply(tr.chg_space, os, po, no, h1, f1, rewrite(vt, (int_le(int_mul(int_add(x1, 1), x86_64_linux.PAGE), V.stack_top) by taut(h2))))
      have e1 := mp(all_elim(vp, {x1}), h1, n1)
      show := trans(e1, trans(em, sym(e0)))
    qed
    // (the page at the top: not the stack's -- in the range none of V's
    // stack pages, else m0's)
    let T := int_div(V.stack_top, x86_64_linux.PAGE)
    have pg4: x86_64_linux.PAGE = 4096 by rsimp(x86_64_linux.PAGE)
    have to: T in omega by arith(rewrite(sym(vt), htop), pg4)
    have sx: !(m0.pages[x0] = none) && snd(m0.pages[x0]).kind = 2 by taut(expand(sm, abi.stack_page, x86_64_linux.mapped))
    have tp: !(V.pages[T] = V.pages[x0]) proof
      assume e
      have c1: (int_le(p, T) && int_lt(T, int_add(p, n))) -> false proof
        assume h
        have h1 h2 := h
        have k := mp(all_elim(vns, {T}), to, h1, h2)
        show by taut(rewrite(e0, rewrite(e, k)), sx)
      qed
      have c2: !(int_le(p, T) && int_lt(T, int_add(p, n))) -> false proof
        assume h
        have eT := mp(all_elim(vp, {T}), to, h)
        have tq := ctop
        have ee: m0.pages[int_div(m0.stack_top, x86_64_linux.PAGE)] = m0.pages[x0] := trans(sym(rewrite(vt, eT)), trans(rewrite(vt, e), e0))
        show by taut(tq, ee)
      qed
      show by taut(c1, c2)
    qed
    show by taut(bnds, run, tp)
  qed
  // a mapped page of V not the stack's: off its space -- in the range by
  // the range's place, else as m0's
  have d2: all x0. x0 in omega -> x86_64_linux.mapped(V, x0) && !abi.stack_page(V, x0) ->
      int_le(int_add(int_mul(int_add(x0, 1), x86_64_linux.PAGE), x86_64_linux.STACK_GUARD_GAP), x86_64_linux.stack_floor(V)) || int_le(V.stack_top, int_mul(x0, x86_64_linux.PAGE)) proof
    fix x0
    assume hx hm
    have c1: (int_le(p, x0) && int_lt(x0, int_add(p, n))) -> int_le(int_add(int_mul(int_add(x0, 1), x86_64_linux.PAGE), x86_64_linux.STACK_GUARD_GAP), x86_64_linux.stack_floor(V)) ||
        int_le(V.stack_top, int_mul(x0, x86_64_linux.PAGE)) proof
      assume h
      have h1 h2 := h
      have o := rewrite(sym(vt), rewrite(sym(fl), expand(os, x86_64_linux.off_stack_space)))
      have pg4: x86_64_linux.PAGE = 4096 by rsimp(x86_64_linux.PAGE)
      have k1: int_le(int_add(int_mul(int_add(p, n), x86_64_linux.PAGE), x86_64_linux.STACK_GUARD_GAP), x86_64_linux.stack_floor(V)) ->
          int_le(int_add(int_mul(int_add(x0, 1), x86_64_linux.PAGE), x86_64_linux.STACK_GUARD_GAP), x86_64_linux.stack_floor(V)) proof
        assume k
        show by arith(k, h2, pg4, hx, po, no)
      qed
      have k2: int_le(V.stack_top, int_mul(p, x86_64_linux.PAGE)) -> int_le(V.stack_top, int_mul(x0, x86_64_linux.PAGE)) proof
        assume k
        show by arith(k, h1, pg4, hx, po)
      qed
      show by taut(o, k1, k2)
    qed
    have c2: !(int_le(p, x0) && int_lt(x0, int_add(p, n))) -> int_le(int_add(int_mul(int_add(x0, 1), x86_64_linux.PAGE), x86_64_linux.STACK_GUARD_GAP), x86_64_linux.stack_floor(V)) ||
        int_le(V.stack_top, int_mul(x0, x86_64_linux.PAGE)) proof
      assume h
      have e := mp(all_elim(vp, {x0}), hx, h)
      have mm: x86_64_linux.mapped(m0, x0) && !abi.stack_page(m0, x0) by defs(rewrite(e, expand(hm, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
      have k := mp(all_elim(rd, {x0}), hx, mm)
      show := rewrite(sym(vt), rewrite(sym(fl), k))
    qed
    show by taut(c1, c2)
  qed
  show by defs(taut(a2, b2, c2, d2), abi.stack_reserve)
qed

// (by a page's entry alone: a byte in the domain, accessible; a stack page)
theorem tr.dom_pt(v1, v2, ob, a): (int_lt(int_div(a, x86_64_linux.PAGE), int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) ->
    v2.pages[int_div(a, x86_64_linux.PAGE)] = v1.pages[int_div(a, x86_64_linux.PAGE)]) ->
  abi.in_domain(v1, ob, a) -> abi.in_domain(v2, ob, a)
proof
  assume he hd
  have d := expand(hd, abi.in_domain)
  have c1: a in ob -> abi.in_domain(v2, ob, a) proof
    assume h
    show by defs(taut(h), abi.in_domain)
  qed
  have c2: x86_64_linux.mapped(v1, int_div(a, x86_64_linux.PAGE)) && !(snd(v1.pages[int_div(a, x86_64_linux.PAGE)]).kind = 2) -> abi.in_domain(v2, ob, a) proof
    assume h
    have hm hk := h
    have lt _ := expand(hm, x86_64_linux.mapped)
    have e := mp(he, lt)
    show by defs(taut(rewrite(sym(e), expand(h, x86_64_linux.mapped))), abi.in_domain, x86_64_linux.mapped)
  qed
  show by taut(d, c1, c2)
qed

theorem tr.acc_pt(v1, v2, a, k): v2.pages[x86_64_linux.page_of(a)] = v1.pages[x86_64_linux.page_of(a)] ->
  x86_64_linux.can_access(v1, a, k) -> x86_64_linux.can_access(v2, a, k)
proof
  assume e h
  show by defs(rewrite(sym(e), expand(h, x86_64_linux.can_access, x86_64_linux.mapped)), x86_64_linux.can_access, x86_64_linux.mapped)
qed

theorem tr.sp_pt(v1, v2, q): v2.pages[q] = v1.pages[q] -> abi.stack_page(v1, q) -> abi.stack_page(v2, q)
proof
  assume e h
  show by defs(rewrite(sym(e), expand(h, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
qed

// the coupling after the change: the world's domain, the callers' frames,
// the pages, the stack's -- off the range, the machine's and the world's
// as before; in it, the same
theorem tr.mem_chg(s, m, w, v, V, WV, p, n, m2, w2): tr.mem(s, m, w, v) -> abi.stack_reserve(s.vm) -> m.vm.stack_top in omega ->
  tr.vm_chg(m.vm, V, w.vm, WV, p, n) -> m2.vm = V -> w2.vm = WV -> w2.objs = w.objs -> tr.mem(s, m2, w2, v)
proof
  assume h hsr htop hc em ew eo
  have {wob, wm, oacc} := h
  have {top, limit, brk0, brk, bytes, frames, pages, nostk, stk, rsv} := wm
  have vt vl vbs wt wl wbs vbk po no os nx vp wp wvp vns vby wby := expand(hc, tr.vm_chg)
  have rm := mp(rsv, hsr)
  have pg4: x86_64_linux.PAGE = 4096 by rsimp(x86_64_linux.PAGE)
  let TSP := int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
  let IN(q) := int_le(p, q) && int_lt(q, int_add(p, n))
  // (a page off the range: the world's as before)
  have wq: all q. q in omega -> !IN(q) -> (int_lt(q, TSP) -> WV.pages[q] = w.vm.pages[q]) proof
    fix q
    assume hq hn hl
    show := mp(all_elim(wp, {q}), hq, hl, hn)
  qed
  have pe: all a. x86_64_linux.page_of(a) = int_div(a, x86_64_linux.PAGE) proof
    fix a
    show by rsimp(x86_64_linux.page_of)
  qed
  // (a stack page of the entry at or above sp - 8: m's, off the range)
  have sk: all q. q in omega -> abi.stack_page(s.vm, q) -> int_le(int_div(int_sub(abi.sp(s), 8), x86_64_linux.PAGE), q) ->
      m.vm.pages[q] = s.vm.pages[q] && !IN(q) && V.pages[q] = s.vm.pages[q] proof
    fix q
    assume hq hs hl
    have e0 := mp(all_elim(stk, {q}), hq, (abi.stack_page(s.vm, q) && int_le(int_div(int_sub(abi.sp(s), 8), x86_64_linux.PAGE), q) by taut(hs, hl)))
    have sm := apply(tr.sp_pt, e0, hs)
    have nr := apply(tr.chg_stack, rm, os, po, no, hq, sm)
    have ev := mp(all_elim(vp, {q}), hq, nr)
    show by taut(e0, nr, trans(ev, e0))
  qed
  // bytes: in the world's domain, the world's
  have by2: all a. a in bits(64) -> abi.in_domain(WV, v, a) -> V.bytes[a] = WV.bytes[a] proof
    fix a
    assume ha hd
    let P := int_div(a, x86_64_linux.PAGE)
    have pa: P in omega by arith(ha, pg4)
    have pe1 := all_elim(pe, {a})
    // (in the range: not a stack object -- those are on the entry's stack
    // pages --, so on a page of the world's, V's: mapped)
    have c1: IN(P) -> V.bytes[a] = WV.bytes[a] proof
      assume hi
      have h1 h2 := hi
      have d := expand(hd, abi.in_domain)
      have o1: a in v -> false proof
        assume hv
        have ao: a in omega by simp(ha)
        have hle hsp _ := mp(all_elim(oacc, {a}), ao, hv)
        have so: abi.sp(s) in omega by simp(hle, ao)
        have lq: int_le(int_div(int_sub(abi.sp(s), 8), x86_64_linux.PAGE), P) by arith(hle, ao, pg4, so)
        have _ nr _ := mp(all_elim(sk, {P}), pa, hsp, lq)
        show by taut(nr, hi)
      qed
      have o2: x86_64_linux.mapped(WV, P) && !(snd(WV.pages[P]).kind = 2) -> x86_64_linux.mapped(V, x86_64_linux.page_of(a)) proof
        assume h
        have hm _ := h
        have lt nn := expand(hm, x86_64_linux.mapped)
        have e := mp(all_elim(wvp, {P}), pa, lt, h1, h2)
        show := rewrite(sym(pe1), (x86_64_linux.mapped(V, P) by defs(taut(lt, rewrite(e, nn)), x86_64_linux.mapped)))
      qed
      have mv: x86_64_linux.mapped(V, x86_64_linux.page_of(a)) by taut(d, o1, o2)
      show := sym(mp(all_elim(wby, {a}), ha, rewrite(sym(pe1), h1), rewrite(sym(pe1), h2), mv))
    qed
    have c2: !IN(P) -> V.bytes[a] = WV.bytes[a] proof
      assume hn
      have eb1 eb2 := mp(all_elim(vby, {a}), ha, rewrite(sym(pe1), hn))
      have wb: int_lt(P, TSP) -> w.vm.pages[P] = WV.pages[P] proof
        assume l
        show := sym(mp(all_elim(wq, {P}), pa, hn, l))
      qed
      have dw := apply(tr.dom_pt, wb, hd)
      have mb := mp(all_elim(bytes, {a}), ha, dw)
      show := trans(eb1, trans(mb, sym(eb2)))
    qed
    show by taut(c1, c2)
  qed
  // the callers' frames: the entry's bytes
  have fr2: all a. a in bits(64) -> (int_le(abi.sp(s), a) && !abi.in_domain(WV, v, a)) && abi.stack_page(s.vm, x86_64_linux.page_of(a)) ->
      V.bytes[a] = s.vm.bytes[a] proof
    fix a
    assume ha hf
    have hle hnd hsp := hf
    let P := int_div(a, x86_64_linux.PAGE)
    have pe1 := all_elim(pe, {a})
    have pa: P in omega by arith(ha, pg4)
    have sp0 := rewrite(pe1, hsp)
    have so: abi.sp(s) in omega by simp(hle, ha)
    have lq: int_le(int_div(int_sub(abi.sp(s), 8), x86_64_linux.PAGE), P) by arith(hle, ha, pg4, so)
    have _ nr _ := mp(all_elim(sk, {P}), pa, sp0, lq)
    have eb1 _ := mp(all_elim(vby, {a}), ha, rewrite(sym(pe1), nr))
    have wb: int_lt(P, TSP) -> WV.pages[P] = w.vm.pages[P] proof
      assume l
      show := mp(all_elim(wq, {P}), pa, nr, l)
    qed
    have ndw: !abi.in_domain(w.vm, v, a) proof
      assume d
      show by taut(hnd, apply(tr.dom_pt, wb, d))
    qed
    have mf := mp(all_elim(frames, {a}), ha, (((int_le(abi.sp(s), a) && !abi.in_domain(w.vm, v, a)) && abi.stack_page(s.vm, x86_64_linux.page_of(a))) by taut(hle, ndw, hsp)))
    show := trans(eb1, mf)
  qed
  // the pages: in the range the same, else as before
  have pg2: all x0. x0 in set_select(omega, x1. int_lt(x1, TSP)) -> V.pages[x0] = WV.pages[x0] || (WV.pages[x0] = none && abi.stack_page(V, x0)) proof
    fix x0
    assume hx
    have xo: x0 in omega by simp(hx)
    have xl: int_lt(x0, TSP) by simp(hx)
    have c1: IN(x0) -> V.pages[x0] = WV.pages[x0] proof
      assume hi
      have h1 h2 := hi
      show := sym(mp(all_elim(wvp, {x0}), xo, xl, h1, h2))
    qed
    have c2: !IN(x0) -> V.pages[x0] = WV.pages[x0] || (WV.pages[x0] = none && abi.stack_page(V, x0)) proof
      assume hn
      have ev := mp(all_elim(vp, {x0}), xo, hn)
      have ew2 := mp(all_elim(wq, {x0}), xo, hn, xl)
      have c := mp(all_elim(pages, {x0}), hx)
      have sv: abi.stack_page(m.vm, x0) -> abi.stack_page(V, x0) proof
        assume h
        show := apply(tr.sp_pt, ev, h)
      qed
      show by taut(rewrite(sym(ew2), rewrite(sym(ev), c)), sv)
    qed
    show by taut(c1, c2)
  qed
  have ns2: all x0. x0 in set_select(omega, x1. int_lt(x1, TSP)) -> !(WV.pages[x0] = none) -> !(snd(WV.pages[x0]).kind = 2) proof
    fix x0
    assume hx hnn
    have xo: x0 in omega by simp(hx)
    have xl: int_lt(x0, TSP) by simp(hx)
    have c1: IN(x0) -> !(snd(WV.pages[x0]).kind = 2) proof
      assume hi
      have h1 h2 := hi
      have e := mp(all_elim(wvp, {x0}), xo, xl, h1, h2)
      have k := mp(all_elim(vns, {x0}), xo, h1, h2)
      show by taut(rewrite(sym(e), k), hnn)
    qed
    have c2: !IN(x0) -> !(snd(WV.pages[x0]).kind = 2) proof
      assume hn
      have e := mp(all_elim(wq, {x0}), xo, hn, xl)
      have k := mp(all_elim(nostk, {x0}), hx, rewrite(e, hnn))
      show := rewrite(sym(e), k)
    qed
    show by taut(c1, c2)
  qed
  have stk2: all x0. x0 in omega -> abi.stack_page(s.vm, x0) && int_le(int_div(int_sub(abi.sp(s), 8), x86_64_linux.PAGE), x0) -> V.pages[x0] = s.vm.pages[x0] proof
    fix x0
    assume hx h0
    have hs hl := h0
    have _ _ e := mp(all_elim(sk, {x0}), hx, hs, hl)
    show := e
  qed
  have rsv2: abi.stack_reserve(s.vm) -> abi.stack_reserve(V) proof
    assume _
    show := apply(tr.rsv_chg, rm, htop, hc)
  qed
  // the stack objects: on the entry's stack pages at or above sp, accessible still
  have oa2: all y. y in omega -> y in v -> (int_le(abi.sp(s), y) && abi.stack_page(s.vm, int_div(y, x86_64_linux.PAGE))) && x86_64_linux.can_access(V, bits_of_int(64, y), 1) proof
    fix y
    assume h1 h2
    have c := mp(all_elim(oacc, {y}), h1, h2)
    have hle hsp hac := c
    let P := int_div(y, x86_64_linux.PAGE)
    have pa: P in omega by arith(h1, pg4)
    have so: abi.sp(s) in omega by simp(hle, h1)
    have lq: int_le(int_div(int_sub(abi.sp(s), 8), x86_64_linux.PAGE), P) by arith(hle, h1, pg4, so)
    have _ _ ev := mp(all_elim(sk, {P}), pa, hsp, lq)
    have em _ _ := mp(all_elim(sk, {P}), pa, hsp, lq)
    // (y below the task's top: its page mapped -- y its address)
    have ml _ := expand(expand(hsp, abi.stack_page).1, x86_64_linux.mapped)
    have td: TSP = 34359738367 by defs(simp(), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
    have yb: bits_of_int(64, y) = y := mp(bits_of_int_small[n := 64, a := y], h1, (int_lt(y, pow2(64)) by arith(ml, td, pg4, h1, (pow2(64) = 18446744073709551616 by rsimp()))))
    have pq: x86_64_linux.page_of(bits_of_int(64, y)) = P by rsimp(yb, x86_64_linux.page_of)
    have eVm: V.pages[x86_64_linux.page_of(bits_of_int(64, y))] = m.vm.pages[x86_64_linux.page_of(bits_of_int(64, y))] := rewrite(sym(pq), trans(ev, sym(em)))
    show by taut(hle, hsp, apply(tr.acc_pt, eVm, hac))
  qed
  have wm2: abi.world_matches(s.vm, V, WV, v, abi.sp(s)) by defs(taut(trans(vt, trans(top, sym(wt))), trans(vl, trans(limit, sym(wl))),
    trans(vbs, trans(brk0, sym(wbs))), vbk, by2, fr2, pg2, ns2, stk2, rsv2), abi.world_matches)
  have wo2: w2.objs = v := trans(eo, wob)
  show by defs(taut(wo2, rewrite(sym(em), rewrite(sym(ew), wm2)), rewrite(sym(em), oa2)), tr.mem)
qed

// (a page off the range: V's and its bytes m0's)
theorem tr.chg_off(m0, V, w0, WV, p, n, a): tr.vm_chg(m0, V, w0, WV, p, n) -> a in bits(64) ->
  !(int_le(p, x86_64_linux.page_of(a)) && int_lt(x86_64_linux.page_of(a), int_add(p, n))) ->
  V.pages[x86_64_linux.page_of(a)] = m0.pages[x86_64_linux.page_of(a)] && V.bytes[a] = m0.bytes[a]
proof
  assume hc ha hn
  have _ _ _ _ _ _ _ _ _ _ _ vp _ _ _ vby _ := expand(hc, tr.vm_chg)
  have po: x86_64_linux.page_of(a) in omega by defs(arith(ha), x86_64_linux.page_of, x86_64_linux.PAGE)
  have e1 := mp(all_elim(vp, {x86_64_linux.page_of(a)}), po, hn)
  have e2 _ := mp(all_elim(vby, {a}), ha, hn)
  show by taut(e1, e2)
qed

// the code: on executable pages, off the range -- as it was
theorem tr.code_chg(m0, V, w0, WV, p, n, gb, gc): abi.code_at(m0, gb, gc) -> tr.vm_chg(m0, V, w0, WV, p, n) -> abi.code_at(V, gb, gc)
proof
  assume hd hc
  have _ _ _ _ _ _ _ _ _ _ nx _ _ _ _ _ _ := expand(hc, tr.vm_chg)
  have e: all i. i in omega -> int_lt(i, seq_len(gc)) ->
      V.pages[x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))] = m0.pages[x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))] &&
      V.bytes[bits_of_int(64, int_add(gb, i))] = m0.bytes[bits_of_int(64, int_add(gb, i))] proof
    fix i
    assume hi hl
    let A := bits_of_int(64, int_add(gb, i))
    let Q := x86_64_linux.page_of(A)
    have c0 := mp(all_elim(expand(hd, abi.code_at), {i}), hi, hl)
    have cf _ _ _ := c0
    have fm fx := expand(cf, x86_64_linux.fetchable)
    have xq: snd(m0.pages[Q]).prot.x := rsimp(expand(fx, x86_64_linux.hw_allows))
    have qo: Q in omega by defs(arith((A in bits(64) by simp())), x86_64_linux.page_of, x86_64_linux.PAGE)
    have nr: !(int_le(p, Q) && int_lt(Q, int_add(p, n))) proof
      assume h
      have h1 h2 := h
      show by taut(mp(all_elim(nx, {Q}), qo, h1, h2, fm), xq)
    qed
    show := apply(tr.chg_off, hc, (A in bits(64) by simp()), nr)
  qed
  show := apply(tr.code_at_tr, hd, e)
qed

// the program loaded: its code as it was, its statics off the stack's space still
theorem tr.loaded_chg(m0, V, w0, WV, p, n, gb, gc, st): abi.loaded(m0, gb, gc, st) -> tr.vm_chg(m0, V, w0, WV, p, n) -> abi.loaded(V, gb, gc, st)
proof
  assume hl hc
  have vt vl _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ := expand(hc, tr.vm_chg)
  have l1 l2 := expand(hl, abi.loaded)
  have c := apply(tr.code_chg, l1, hc)
  have s2 := apply(tr.statics_same, {m0}, {V}, {st}, vt, vl, l2)
  show by defs(taut(c, s2), abi.loaded)
qed

// the homes: on stack pages, off the range -- as they were
theorem tr.homes_chg(s, m, m2, hs, V, w0, WV, p, n): tr.homes(s, m, hs) -> abi.stack_reserve(m.vm) -> tr.vm_chg(m.vm, V, w0, WV, p, n) -> m2.vm = V ->
  tr.homes(s, m2, hs)
proof
  assume hh hr hc em
  have _ _ _ _ _ _ _ po no os _ _ _ _ _ _ _ := expand(hc, tr.vm_chg)
  have g: all c. c in dom(hs) -> x86_64_linux.le(m2.vm.bytes, tr.ha(s, c), fst(hs[c])) = snd(hs[c]) && tr.hrange(c, fst(hs[c])) &&
      tr.hacc(s, m2.vm, c, fst(hs[c])) proof
    fix c
    assume hd
    have hv hcr ha := mp(all_elim(expand(hh, tr.homes), {c}), hd)
    have nko: fst(hs[c]) in omega by taut(expand(hcr, tr.hrange))
    // (each byte: on a stack page of m, so off the range)
    have bt: all k. k in omega -> int_lt(k, fst(hs[c])) ->
        V.pages[x86_64_linux.page_of(bits_add(64, tr.ha(s, c), bits_of_int(64, k)))] = m.vm.pages[x86_64_linux.page_of(bits_add(64, tr.ha(s, c), bits_of_int(64, k)))] &&
        V.bytes[bits_add(64, tr.ha(s, c), bits_of_int(64, k))] = m.vm.bytes[bits_add(64, tr.ha(s, c), bits_of_int(64, k))] &&
        x86_64_linux.can_access(m.vm, bits_add(64, tr.ha(s, c), bits_of_int(64, k)), 1) &&
        abi.stack_page(m.vm, int_div(bits_add(64, tr.ha(s, c), bits_of_int(64, k)), 4096)) proof
      fix k
      assume k1 k2
      let A := bits_add(64, tr.ha(s, c), bits_of_int(64, k))
      have a1 a2 := mp(all_elim(expand(ha, tr.hacc), {k}), k1, k2)
      have ab: A in bits(64) by simp()
      have pq: x86_64_linux.page_of(A) = int_div(A, 4096) by rsimp(x86_64_linux.page_of, x86_64_linux.PAGE)
      have qo: int_div(A, 4096) in omega by arith(ab)
      have nr := apply(tr.chg_stack, hr, os, po, no, qo, a2)
      have e1 e2 := apply(tr.chg_off, hc, ab, rewrite(sym(pq), nr))
      show by taut(e1, e2, a1, a2)
    qed
    have bb: all k. k in omega -> int_lt(k, fst(hs[c])) ->
        V.bytes[bits_add(64, tr.ha(s, c), bits_of_int(64, k))] = m.vm.bytes[bits_add(64, tr.ha(s, c), bits_of_int(64, k))] proof
      fix k
      assume k1 k2
      have _ e2 _ _ := mp(all_elim(bt, {k}), k1, k2)
      show := e2
    qed
    have ls := apply(tr.le_same, {V.bytes}, {m.vm.bytes}, {tr.ha(s, c)}, {fst(hs[c])}, nko, bb)
    have ac: tr.hacc(s, V, c, fst(hs[c])) proof
      have q: all k. k in omega -> int_lt(k, fst(hs[c])) ->
          x86_64_linux.can_access(V, bits_add(64, tr.ha(s, c), bits_of_int(64, k)), 1) && abi.stack_page(V, int_div(bits_add(64, tr.ha(s, c), bits_of_int(64, k)), 4096)) proof
        fix k
        assume k1 k2
        let A := bits_add(64, tr.ha(s, c), bits_of_int(64, k))
        have e1 _ a1 a2 := mp(all_elim(bt, {k}), k1, k2)
        have pq: x86_64_linux.page_of(A) = int_div(A, 4096) by rsimp(x86_64_linux.page_of, x86_64_linux.PAGE)
        show by taut(apply(tr.acc_pt, e1, a1), apply(tr.sp_pt, rewrite(pq, e1), a2))
      qed
      show by defs(q, tr.hacc)
    qed
    show by taut(rewrite(sym(em), trans(ls, hv)), hcr, rewrite(sym(em), ac))
  qed
  show by defs(g, tr.homes)
qed

// the invariant after the change: the code, the program, the return
// address and its page as they were; the machine's other parts as given
theorem tr.inv_chg(s, base, code, fr, m, w, v, V, WV, p, n, m2, w2): tr.inv(s, base, code, fr, m, w) -> tr.mem(s, m, w, v) ->
  tr.vm_chg(m.vm, V, w.vm, WV, p, n) ->
  m2 in x86_64_linux.Machine -> m2 in univ(1) -> m2.vm = V -> m2.gpr[4] = m.gpr[4] -> m2.cpu = m.cpu ->
  m2.gs_base = m.gs_base -> m2.os = m.os -> m2.fs_base = m.fs_base -> !m2.flags.df ->
  w2 in abi.World -> w2 in univ(1) -> w2.vm = WV -> w2.os = w.os -> w2.fs_base = w.fs_base -> w2.cpu = w.cpu ->
  tr.inv(s, base, code, fr, m2, w2)
proof
  assume hi hm hc m2M m2u em e4 ecpu egs eos efs mdf2 w2W w2u ew wos wfs wcp
  have {cd, kc, rspm, fro, kp, ra8, mcpu, mgs, mos, mfs, winp, sws, wcpu, wbk, sM, sacc, sal, hsps, slt, sgf, srsv} := hi
  have {rsv} := expand(hm, tr.mem).wm
  have rm := mp(rsv, srsv)
  have _ _ _ _ _ wbs _ po no os _ _ _ _ _ _ _ := expand(hc, tr.vm_chg)
  let R := s.gpr[4]
  have r4 := apply(x86i.rsp_typed, sM)
  have so: R in omega by simp(r4)
  // the code and the program, loaded still
  have cd2: abi.code_at(m2.vm, base, code) := rewrite(sym(em), apply(tr.code_chg, cd, hc))
  have kc2: tr.keeps_code(s.vm, m2.vm) proof
    have g: all gb gc st. gb in omega -> abi.loaded(s.vm, gb, gc, st) -> abi.loaded(m2.vm, gb, gc, st) proof
      fix gb gc st
      assume hb hl
      have l1 := mp(all_elim(expand(kc, tr.keeps_code), {gb}, {gc}, {st}), hb, hl)
      show := rewrite(sym(em), apply(tr.loaded_chg, l1, hc))
    qed
    show by defs(g, tr.keeps_code)
  qed
  // the return address's page: rsp's, a stack page -- off the range
  have kr := mp(all_elim(expand(kp, tr.kept), {R}), so, arith(so), arith(so))
  have p0: m.vm.pages[int_div(R, 4096)] = s.vm.pages[int_div(R, 4096)] by defs(kr, x86_64_linux.page_of, x86_64_linux.PAGE)
  have sm0 := apply(tr.sp_pt, p0, hsps)
  have po0: int_div(R, 4096) in omega by arith(so)
  have nr0 := apply(tr.chg_stack, rm, os, po, no, po0, sm0)
  have kp2: tr.kept(s.vm, m2.vm, R) proof
    have g: all a. a in omega -> int_le(int_sub(R, 8), a) -> int_lt(a, int_add(R, 8)) ->
        m2.vm.pages[x86_64_linux.page_of(a)] = s.vm.pages[x86_64_linux.page_of(a)] proof
      fix a
      assume a1 ab2 a3
      have pa: x86_64_linux.page_of(a) = int_div(R, 4096) by defs(arith(a1, ab2, a3, so, sal, slt, r4), x86_64_linux.page_of, x86_64_linux.PAGE)
      have ab: a in bits(64) by simp(a1, (int_lt(a, pow2(64)) by arith(a3, slt, (pow2(64) = 18446744073709551616 by rsimp()))))
      have e1 _ := apply(tr.chg_off, hc, ab, rewrite(sym(pa), nr0))
      have k0 := mp(all_elim(expand(kp, tr.kept), {a}), a1, ab2, a3)
      show := rewrite(sym(em), trans(e1, k0))
    qed
    show by defs(g, tr.kept)
  qed
  have rb: all k. k in omega -> int_lt(k, 8) -> m2.vm.bytes[bits_add(64, R, bits_of_int(64, k))] = m.vm.bytes[bits_add(64, R, bits_of_int(64, k))] proof
    fix k
    assume k1 k2
    have rp := apply(abi.ret_pages, {R}, {k}, r4, sal, slt, k1, k2)
    have peA: x86_64_linux.page_of(bits_add(64, R, bits_of_int(64, k))) = int_div(bits_add(64, R, bits_of_int(64, k)), 4096) by rsimp(x86_64_linux.page_of, x86_64_linux.PAGE)
    have pq := rewrite(sym(peA), rp)
    have _ e2 := apply(tr.chg_off, hc, (bits_add(64, R, bits_of_int(64, k)) in bits(64) by simp()), rewrite(sym(pq), nr0))
    show := rewrite(sym(em), e2)
  qed
  have ra82: x86_64_linux.le(m2.vm.bytes, R, 8) = abi.ret(s) := trans(apply(tr.le_same, {m2.vm.bytes}, {m.vm.bytes}, {R}, {8}, (8 in omega by simp()), rb), ra8)
  // the rest: as given
  have rspm2: m2.gpr[4] = int_sub(R, fr) := trans(e4, rspm)
  have mcpu2: m2.cpu = s.cpu := trans(ecpu, mcpu)
  have mgs2: m2.gs_base = s.gs_base := trans(egs, mgs)
  have mos2: m2.os = w2.os := trans(eos, trans(mos, sym(wos)))
  have mfs2: m2.fs_base = w2.fs_base := trans(efs, trans(mfs, sym(wfs)))
  have winp2: w2.os.input = s.os.input := rewrite(sym(wos), winp)
  have sws2: subset(s.os.events, w2.os.events) := rewrite(sym(wos), sws)
  have wcpu2: w2.cpu = s.cpu := trans(wcp, wcpu)
  have eb: w2.vm.brk_start = w.vm.brk_start by rsimp(ew, wbs)
  have wbk2: abi.brk_start_ok(w2.vm) by defs(rewrite(sym(eb), expand(wbk, abi.brk_start_ok)), abi.brk_start_ok)
  show by defs(taut(m2M, m2u, cd2, kc2, rspm2, fro, kp2, ra82, mcpu2, mgs2, mos2, mfs2, mdf2, winp2, sws2, w2W, w2u, wcpu2, wbk2,
    sM, sacc, sal, hsps, slt, sgf, srsv), tr.inv)
qed

// ----------------------------------------------------------------------
//  brk: the world's memory after it, the change

// (a value by a case: the case's)
theorem tr.ite_yes(c, a, b, x): x = ite(c, a, b) -> c -> x = a
proof
  assume e h
  show := trans(e, mp(ite_t[c := c, a := a, b := b], h))
qed

theorem tr.ite_no(c, a, b, x): x = ite(c, a, b) -> !c -> x = b
proof
  assume e h
  show := trans(e, mp(ite_f[c := c, a := a, b := b], h))
qed

// (a byte's page in the range: the byte in the range's bytes)
theorem tr.pg_rng(a, p, n): a in bits(64) -> p in omega -> n in omega ->
  ((int_le(p, x86_64_linux.page_of(a)) && int_lt(x86_64_linux.page_of(a), int_add(p, n))) <->
   (int_le(int_mul(p, x86_64_linux.PAGE), a) && int_lt(a, int_mul(int_add(p, n), x86_64_linux.PAGE))))
proof
  assume ha hp hn
  show by defs(arith(ha, hp, hn), x86_64_linux.page_of, x86_64_linux.PAGE)
qed

// (... for any range: its ends integers -- the integer operations' any
// arguments)
theorem tr.pg_rng2(a, p, n): a in bits(64) ->
  ((int_le(p, x86_64_linux.page_of(a)) && int_lt(x86_64_linux.page_of(a), int_add(p, n))) <->
   (int_le(int_mul(p, x86_64_linux.PAGE), a) && int_lt(a, int_mul(int_add(p, n), x86_64_linux.PAGE))))
proof
  assume ha
  show by defs(arith(ha), x86_64_linux.page_of, x86_64_linux.PAGE)
qed

// nothing changed: the empty range
theorem tr.chg_refl(m0, V, w0, WV): abi.stack_reserve(m0) -> V.stack_top = m0.stack_top -> V.stack_limit = m0.stack_limit ->
  V.brk_start = m0.brk_start -> WV.stack_top = w0.stack_top -> WV.stack_limit = w0.stack_limit -> WV.brk_start = w0.brk_start -> V.brk = WV.brk ->
  (all q. q in omega -> V.pages[q] = m0.pages[q]) -> (all q. q in omega -> int_lt(q, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) -> WV.pages[q] = w0.pages[q]) ->
  (all a. a in bits(64) -> V.bytes[a] = m0.bytes[a] && WV.bytes[a] = w0.bytes[a]) ->
  tr.vm_chg(m0, V, w0, WV, 0, 0)
proof
  assume hr vt vl vb wt wl wb vk hvp hwp hby
  have ra _ _ _ := expand(hr, abi.stack_reserve)
  have os: x86_64_linux.off_stack_space(m0, 0, 0) by defs(taut((int_le(int_add(int_mul(int_add(0, 0), x86_64_linux.PAGE), x86_64_linux.STACK_GUARD_GAP),
    x86_64_linux.stack_floor(m0)) by arith(ra))), x86_64_linux.off_stack_space)
  have e0: all q. q in omega -> !(int_le(0, q) && int_lt(q, int_add(0, 0))) proof
    fix q
    assume hq
    show by arith(hq)
  qed
  have c1: all q. q in omega -> int_le(0, q) -> int_lt(q, int_add(0, 0)) -> x86_64_linux.mapped(m0, q) -> !snd(m0.pages[q]).prot.x proof
    fix q
    assume hq h1 h2
    show by taut(mp(all_elim(e0, {q}), hq), h1, h2)
  qed
  have c2: all q. q in omega -> !(int_le(0, q) && int_lt(q, int_add(0, 0))) -> V.pages[q] = m0.pages[q] proof
    fix q
    assume hq _
    show := mp(all_elim(hvp, {q}), hq)
  qed
  have c3: all q. q in omega -> int_lt(q, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) -> !(int_le(0, q) && int_lt(q, int_add(0, 0))) -> WV.pages[q] = w0.pages[q] proof
    fix q
    assume hq hl _
    show := mp(all_elim(hwp, {q}), hq, hl)
  qed
  have c4: all q. q in omega -> int_lt(q, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) -> int_le(0, q) -> int_lt(q, int_add(0, 0)) -> WV.pages[q] = V.pages[q] proof
    fix q
    assume hq _ h1 h2
    show by taut(mp(all_elim(e0, {q}), hq), h1, h2)
  qed
  have c5: all q. q in omega -> int_le(0, q) -> int_lt(q, int_add(0, 0)) -> V.pages[q] = none || !(snd(V.pages[q]).kind = 2) proof
    fix q
    assume hq h1 h2
    show by taut(mp(all_elim(e0, {q}), hq), h1, h2)
  qed
  have c6: all a. a in bits(64) -> !(int_le(0, x86_64_linux.page_of(a)) && int_lt(x86_64_linux.page_of(a), int_add(0, 0))) ->
      V.bytes[a] = m0.bytes[a] && WV.bytes[a] = w0.bytes[a] proof
    fix a
    assume ha _
    show := mp(all_elim(hby, {a}), ha)
  qed
  have c7: all a. a in bits(64) -> int_le(0, x86_64_linux.page_of(a)) -> int_lt(x86_64_linux.page_of(a), int_add(0, 0)) ->
      x86_64_linux.mapped(V, x86_64_linux.page_of(a)) -> WV.bytes[a] = V.bytes[a] proof
    fix a
    assume ha h1 h2 _
    have f: false by arith(h1, h2)
    show by taut(f)
  qed
  show by defs(taut(vt, vl, vb, wt, wl, wb, vk, (0 in omega by simp()), os, c1, c2, c3, c4, c5, c6, c7), tr.vm_chg)
qed

// (free pages of the machine: free in the world -- its pages the machine's
// but stack pages, none of its own the stack's)
theorem tr.free_xfer(s, m, w, v, p, n): tr.mem(s, m, w, v) -> x86_64_linux.free_range(m.vm, p, n) -> x86_64_linux.free_range(w.vm, p, n)
proof
  assume hm hf
  have {wm} := hm
  have {pages, nostk} := wm
  have f1 f2 f3 := expand(hf, x86_64_linux.free_range)
  have g2: all q. q in omega -> int_le(p, q) && int_lt(q, int_add(p, n)) -> !x86_64_linux.mapped(w.vm, q) proof
    fix q
    assume hq hr
    have nm := mp(all_elim(f2, {q}), hq, hr)
    have ql: int_lt(q, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) by arith(hr, f1)
    have mn: m.vm.pages[q] = none by taut(expand(nm, x86_64_linux.mapped), ql)
    have c := mp(all_elim(pages, {q}), (q in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) by simp(hq, ql)))
    have wn: w.vm.pages[q] = none by taut(rewrite(mn, c))
    show by defs(taut(wn), x86_64_linux.mapped)
  qed
  have g3: all q. q in omega -> (int_le(int_add(p, n), q) && int_lt(q, int_add(int_add(p, n), int_div(x86_64_linux.STACK_GUARD_GAP, x86_64_linux.PAGE)))) &&
      x86_64_linux.mapped(w.vm, q) -> !(snd(w.vm.pages[q]).kind = 2) proof
    fix q
    assume hq h
    have _ _ hm2 := h
    have ql nn := expand(hm2, x86_64_linux.mapped)
    show := mp(all_elim(nostk, {q}), (q in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) by simp(hq, ql)), nn)
  qed
  show by defs(taut(f1, g2, g3), x86_64_linux.free_range)
qed

// (the stack's space: the world's the machine's)
theorem tr.off_xfer(s, m, w, v, p, n): tr.mem(s, m, w, v) -> x86_64_linux.off_stack_space(m.vm, p, n) -> x86_64_linux.off_stack_space(w.vm, p, n)
proof
  assume hm ho
  have {wm} := hm
  have {top, limit} := wm
  have fe: x86_64_linux.stack_floor(m.vm) = x86_64_linux.stack_floor(w.vm) by rsimp(x86_64_linux.stack_floor, top, limit)
  show by defs(rewrite(top, rewrite(fe, expand(ho, x86_64_linux.off_stack_space))), x86_64_linux.off_stack_space)
qed

// brk growing: the world's memory fresh heap pages there too
theorem tr.brk_grow_world(s, m, w, v, N, V, r): tr.mem(s, m, w, v) -> m.vm in x86_64_linux.Vm -> w.vm in x86_64_linux.Vm -> N in bits(64) ->
  lx.brk_grow(m.vm, N, V, r) ->
  ex WV p n. WV in x86_64_linux.Vm && gimple.brk_post(w.vm, WV, N) && r = WV.brk && V in x86_64_linux.Vm && tr.vm_chg(m.vm, V, w.vm, WV, p, n)
proof
  assume hm hmv hwv hN hg
  have {wm} := hm
  have {top, limit, brk0, brk} := wm
  obtain Q B, nl gl fr os eV er hq hb hqt hbt from expand(hg, lx.brk_grow)
  let PO := x86_64_linux.pages_for(m.vm.brk)
  let PN := x86_64_linux.pages_for(N)
  let n := int_sub(PN, PO)
  let HP := fn_update(fn_update(empty, "prot", fn_update(fn_update(fn_update(empty, "r", true), "w", true), "x", false)), "kind", 1)
  have pg4: x86_64_linux.PAGE = 4096 by rsimp(x86_64_linux.PAGE)
  have bo: m.vm.brk in omega by simp(expand(hmv, x86_64_linux.Vm))
  have po: PO in omega by defs(arith(bo), x86_64_linux.pages_for, x86_64_linux.PAGE)
  have pno: PN in omega by defs(arith(hN), x86_64_linux.pages_for, x86_64_linux.PAGE)
  have no: n in omega by arith(gl, po, pno)
  have ad: int_add(PO, n) = PN by arith(gl)
  obtain WV, wv1 wfp wbk from apply(g.fresh_ex, hwv, apply(x86.vm_univ, hwv), po, no, g.heap_page, hN)
  // the world's call: growing onto free pages off the stack's space
  have frw := rewrite(brk, apply(tr.free_xfer, hm, fr))
  have osw := rewrite(brk, apply(tr.off_xfer, hm, os))
  have nlw: int_le(w.vm.brk_start, N) by arith(rewrite(brk0, nl))
  have bp: gimple.brk_post(w.vm, WV, N) by defs(taut(nlw, rewrite(brk, gl), frw, osw, rewrite(brk, wfp), wbk), gimple.brk_post)
  // V: a memory
  have vv: V in x86_64_linux.Vm := rewrite(sym(eV), apply(g.vm_set, hmv, apply(x86.vm_univ, hmv), hqt, hbt, hN))
  // the change: the pages PO .. PN-1 heap pages on both sides, their bytes 0
  have wt wl wb wpg wby0 := expand(wfp, gimple.fresh_pages)
  let IN(q) := int_le(PO, q) && int_lt(q, int_add(PO, n))
  have vt: V.stack_top = m.vm.stack_top by rsimp(eV)
  have vl: V.stack_limit = m.vm.stack_limit by rsimp(eV)
  have vb: V.brk_start = m.vm.brk_start by rsimp(eV)
  have vk: V.brk = WV.brk by rsimp(eV, wbk)
  have vq: V.pages = Q by rsimp(eV)
  have vbs: V.bytes = B by rsimp(eV)
  have _ f2 _ := expand(fr, x86_64_linux.free_range)
  have c1: all q. q in omega -> int_le(PO, q) -> int_lt(q, int_add(PO, n)) -> x86_64_linux.mapped(m.vm, q) -> !snd(m.vm.pages[q]).prot.x proof
    fix q
    assume hq h1 h2 hmq
    show by taut(mp(all_elim(f2, {q}), hq, (int_le(PO, q) && int_lt(q, int_add(PO, int_sub(PN, PO))) by taut(h1, h2))), hmq)
  qed
  have c2: all q. q in omega -> !IN(q) -> V.pages[q] = m.vm.pages[q] proof
    fix q
    assume hq0 hn
    have e := rewrite(sym(vq), mp(all_elim(hq, {q}), hq0))
    show := apply(tr.ite_no, e, rewrite(ad, hn))
  qed
  have c3: all q. q in omega -> int_lt(q, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) -> !IN(q) -> WV.pages[q] = w.vm.pages[q] proof
    fix q
    assume hq0 hl hn
    show := apply(tr.ite_no, mp(all_elim(wpg, {q}), hq0, hl), hn)
  qed
  have c4: all q. q in omega -> int_lt(q, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) -> int_le(PO, q) -> int_lt(q, int_add(PO, n)) -> WV.pages[q] = V.pages[q] proof
    fix q
    assume hq0 hl h1 h2
    have ew := apply(tr.ite_yes, mp(all_elim(wpg, {q}), hq0, hl), (int_le(PO, q) && int_lt(q, int_add(PO, n)) by taut(h1, h2)))
    have ev := apply(tr.ite_yes, rewrite(sym(vq), mp(all_elim(hq, {q}), hq0)), (int_le(PO, q) && int_lt(q, PN) by taut(h1, rewrite(ad, h2))))
    show := trans(ew, sym(ev))
  qed
  have c5: all q. q in omega -> int_le(PO, q) -> int_lt(q, int_add(PO, n)) -> V.pages[q] = none || !(snd(V.pages[q]).kind = 2) proof
    fix q
    assume hq0 h1 h2
    have ev := apply(tr.ite_yes, rewrite(sym(vq), mp(all_elim(hq, {q}), hq0)), (int_le(PO, q) && int_lt(q, PN) by taut(h1, rewrite(ad, h2))))
    have k: !(snd(some(HP)).kind = 2) by rsimp(some, tag)
    show by taut(rewrite(sym(ev), k))
  qed
  have c6: all a. a in bits(64) -> !(int_le(PO, x86_64_linux.page_of(a)) && int_lt(x86_64_linux.page_of(a), int_add(PO, n))) ->
      V.bytes[a] = m.vm.bytes[a] && WV.bytes[a] = w.vm.bytes[a] proof
    fix a
    assume ha hn
    have ao: a in omega by simp(ha)
    have a64: int_lt(a, pow2(64)) by simp(ha)
    have rng := apply(tr.pg_rng, ha, po, no)
    have nb: !(int_le(int_mul(PO, x86_64_linux.PAGE), a) && int_lt(a, int_mul(int_add(PO, n), x86_64_linux.PAGE))) by taut(rng, hn)
    have ev := apply(tr.ite_no, rewrite(sym(vbs), mp(all_elim(hb, {a}), ao, a64)), rewrite(ad, nb))
    have ew := apply(tr.ite_no, mp(all_elim(wby0, {a}), ha), nb)
    show by taut(ev, ew)
  qed
  have c7: all a. a in bits(64) -> int_le(PO, x86_64_linux.page_of(a)) -> int_lt(x86_64_linux.page_of(a), int_add(PO, n)) ->
      x86_64_linux.mapped(V, x86_64_linux.page_of(a)) -> WV.bytes[a] = V.bytes[a] proof
    fix a
    assume ha h1 h2 _
    have ao: a in omega by simp(ha)
    have a64: int_lt(a, pow2(64)) by simp(ha)
    have rng := apply(tr.pg_rng, ha, po, no)
    have yb: int_le(int_mul(PO, x86_64_linux.PAGE), a) && int_lt(a, int_mul(int_add(PO, n), x86_64_linux.PAGE)) by taut(rng, h1, h2)
    have ev := apply(tr.ite_yes, rewrite(sym(vbs), mp(all_elim(hb, {a}), ao, a64)), rewrite(ad, yb))
    have ew := apply(tr.ite_yes, mp(all_elim(wby0, {a}), ha), yb)
    have z: bits_of_int(8, 0) = 0 by simp()
    show := trans(ew, trans(z, sym(ev)))
  qed
  have ch: tr.vm_chg(m.vm, V, w.vm, WV, PO, n) by defs(taut(vt, vl, vb, wt, wl, wb, vk, po, no, os, c1, c2, c3, c4, c5, c6, c7), tr.vm_chg)
  show by ex_intro({WV}, {PO}, {n}, taut(wv1, bp, trans(er, sym(wbk)), vv, ch))
qed

// brk unchanged: the world's memory too
theorem tr.brk_same_world(s, m, w, v, N, V, r): tr.mem(s, m, w, v) -> abi.stack_reserve(m.vm) -> m.vm in x86_64_linux.Vm -> w.vm in x86_64_linux.Vm ->
  lx.brk_same(m.vm, N, V, r) ->
  ex WV p n. WV in x86_64_linux.Vm && gimple.brk_post(w.vm, WV, N) && r = WV.brk && V in x86_64_linux.Vm && tr.vm_chg(m.vm, V, w.vm, WV, p, n)
proof
  assume hm hr hmv hwv hs
  have {wm} := hm
  have {brk0, brk} := wm
  have eV er c := expand(hs, lx.brk_same)
  have bp: gimple.brk_post(w.vm, w.vm, N) by defs(taut(refl({w.vm}), rewrite(brk0, rewrite(brk, c))), gimple.brk_post)
  have pv: all q. q in omega -> V.pages[q] = m.vm.pages[q] proof
    fix q
    assume _
    show by rsimp(eV)
  qed
  have pw: all q. q in omega -> int_lt(q, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) -> w.vm.pages[q] = w.vm.pages[q] proof
    fix q
    assume _ _
    show := refl({w.vm.pages[q]})
  qed
  have bv: all a. a in bits(64) -> V.bytes[a] = m.vm.bytes[a] && w.vm.bytes[a] = w.vm.bytes[a] proof
    fix a
    assume _
    have e: V.bytes[a] = m.vm.bytes[a] by rsimp(eV)
    show by taut(e, refl({w.vm.bytes[a]}))
  qed
  have ch := apply(tr.chg_refl, hr, (V.stack_top = m.vm.stack_top by rsimp(eV)), (V.stack_limit = m.vm.stack_limit by rsimp(eV)),
    (V.brk_start = m.vm.brk_start by rsimp(eV)), refl({w.vm.stack_top}), refl({w.vm.stack_limit}), refl({w.vm.brk_start}),
    (V.brk = w.vm.brk by rsimp(eV, brk)), pv, pw, bv)
  show by ex_intro({w.vm}, {0}, {0}, taut(hwv, bp, trans(er, brk), rewrite(sym(eV), hmv), ch))
qed

// (a memory with its pages and break replaced)
theorem tr.vm_set2(vm, pg, br): vm in x86_64_linux.Vm -> lx.pgs(pg) -> br in bits(64) -> fn_update(fn_update(vm, "pages", pg), "brk", br) in x86_64_linux.Vm
proof
  assume hv hp hb
  have bt: vm.bytes in fn_space(bits(64), bits(8)) by simp(expand(hv, x86_64_linux.Vm))
  have h := apply(g.vm_set, hv, apply(x86.vm_univ, hv), hp, bt, hb)
  let F := fn_update(vm, "pages", pg)
  have vf: is_fun(vm) && "bytes" in dom(vm) by simp(expand(hv, x86_64_linux.Vm))
  have ff := mp(fn_update_fun[f := vm, k := "pages", v := pg], vf.1)
  have fd := mp(dom_update[f := vm, k := "pages", v := pg], vf.1)
  have bd: "bytes" in dom(F) by simp(fd, vf)
  have fs := mp(mp(fn_update_same[f := F, k := "bytes"], ff), bd)
  have fb: F.bytes = vm.bytes by rsimp()
  show := rewrite(rewrite(fb, fs), h)
qed

// (the stack's space: the machine's the world's)
theorem tr.off_back(s, m, w, v, p, n): tr.mem(s, m, w, v) -> x86_64_linux.off_stack_space(w.vm, p, n) -> x86_64_linux.off_stack_space(m.vm, p, n)
proof
  assume hm ho
  have {wm} := hm
  have {top, limit} := wm
  have fe: x86_64_linux.stack_floor(w.vm) = x86_64_linux.stack_floor(m.vm) by rsimp(x86_64_linux.stack_floor, top, limit)
  show by defs(rewrite(sym(top), rewrite(fe, expand(ho, x86_64_linux.off_stack_space))), x86_64_linux.off_stack_space)
qed

// brk shrinking: the world's pages gone too -- by the call's requirement
// off the stack's space, not executable, within the task's pages
theorem tr.brk_shrink_world(s, m, w, v, N, V, r): tr.mem(s, m, w, v) -> abi.stack_reserve(m.vm) -> m.vm in x86_64_linux.Vm -> w.vm in x86_64_linux.Vm -> N in bits(64) ->
  (int_lt(x86_64_linux.pages_for(N), x86_64_linux.pages_for(w.vm.brk)) -> int_le(w.vm.brk_start, N) ->
    int_le(x86_64_linux.pages_for(w.vm.brk), int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) &&
    gimple.sys_pages_ok(w.vm, x86_64_linux.pages_for(N), int_sub(x86_64_linux.pages_for(w.vm.brk), x86_64_linux.pages_for(N)))) ->
  lx.brk_shrink(m.vm, N, V, r) ->
  ex WV p n. WV in x86_64_linux.Vm && gimple.brk_post(w.vm, WV, N) && r = WV.brk && V in x86_64_linux.Vm && tr.vm_chg(m.vm, V, w.vm, WV, p, n)
proof
  assume hm hr hmv hwv hN hq0 hs
  have {wm} := hm
  have {top, limit, brk0, brk, pages} := wm
  obtain Q, nl gl eV er hq hqt from expand(hs, lx.brk_shrink)
  let PO := x86_64_linux.pages_for(m.vm.brk)
  let PN := x86_64_linux.pages_for(N)
  let n := int_sub(PO, PN)
  let TSP := int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
  have bo: m.vm.brk in omega by simp(expand(hmv, x86_64_linux.Vm))
  have po: PO in omega by defs(arith(bo), x86_64_linux.pages_for, x86_64_linux.PAGE)
  have pno: PN in omega by defs(arith(hN), x86_64_linux.pages_for, x86_64_linux.PAGE)
  have no: n in omega by arith(gl, po, pno)
  have ad: int_add(PN, n) = PO by arith(gl)
  have nlw: int_le(w.vm.brk_start, N) by arith(rewrite(brk0, nl))
  have req := rewrite(sym(brk), hq0)
  obtain WV, wv1 wgp wbk from mp(g.gone_ex[before := w.vm, p := PN, n := n, br := N], hwv, apply(x86.vm_univ, hwv), hN)
  have gle: int_le(PN, PO) by arith(gl)
  have bp: gimple.brk_post(w.vm, WV, N) by defs(taut(nlw, rewrite(brk, gle), rewrite(brk, wgp), wbk), gimple.brk_post)
  // V: a memory (its pages within the task's, the requirement's)
  have bnd: int_lt(PN, PO) -> int_le(PO, TSP) proof
    assume l
    have b1 _ := mp(req, l, nlw)
    show := b1
  qed
  have vv: V in x86_64_linux.Vm := rewrite(sym(eV), apply(tr.vm_set2, hmv, mp(hqt, bnd), hN))
  have wt wl wb wpg wby0 := expand(wgp, gimple.gone_pages)
  have vt: V.stack_top = m.vm.stack_top by rsimp(eV)
  have vl: V.stack_limit = m.vm.stack_limit by rsimp(eV)
  have vb: V.brk_start = m.vm.brk_start by rsimp(eV)
  have vk: V.brk = WV.brk by rsimp(eV, wbk)
  have vq: V.pages = Q by rsimp(eV)
  have vbs: V.bytes = m.vm.bytes by rsimp(eV)
  // shrinking by a page or more: the range PN .. PO-1
  have k1: int_lt(PN, PO) -> tr.vm_chg(m.vm, V, w.vm, WV, PN, n) proof
    assume l
    have _ spk := mp(req, l, nlw)
    have offw nxw := expand(spk, gimple.sys_pages_ok)
    have osm := apply(tr.off_back, hm, offw)
    let IN(q) := int_le(PN, q) && int_lt(q, int_add(PN, n))
    have c1: all q. q in omega -> int_le(PN, q) -> int_lt(q, int_add(PN, n)) -> x86_64_linux.mapped(m.vm, q) -> !snd(m.vm.pages[q]).prot.x proof
      fix q
      assume hq0 h1 h2 hmq
      have ns: !abi.stack_page(m.vm, q) proof
        assume hs0
        show by taut(apply(tr.chg_stack, hr, osm, pno, no, hq0, hs0), h1, h2)
      qed
      have ql _ := expand(hmq, x86_64_linux.mapped)
      have c := mp(all_elim(pages, {q}), (q in set_select(omega, x1. int_lt(x1, TSP)) by simp(hq0, ql)))
      have e: m.vm.pages[q] = w.vm.pages[q] by taut(c, ns)
      have mw: x86_64_linux.mapped(w.vm, q) by defs(rewrite(e, expand(hmq, x86_64_linux.mapped)), x86_64_linux.mapped)
      have k := mp(all_elim(nxw, {q}), hq0, (int_le(PN, q) && int_lt(q, int_add(PN, n)) by taut(h1, h2)), mw)
      show := rewrite(sym(e), k)
    qed
    have c2: all q. q in omega -> !IN(q) -> V.pages[q] = m.vm.pages[q] proof
      fix q
      assume hq0 hn
      show := apply(tr.ite_no, rewrite(sym(vq), mp(all_elim(hq, {q}), hq0)), rewrite(ad, hn))
    qed
    have c3: all q. q in omega -> int_lt(q, TSP) -> !IN(q) -> WV.pages[q] = w.vm.pages[q] proof
      fix q
      assume hq0 hl hn
      show := apply(tr.ite_no, mp(all_elim(wpg, {q}), hq0, hl), hn)
    qed
    have c4: all q. q in omega -> int_lt(q, TSP) -> int_le(PN, q) -> int_lt(q, int_add(PN, n)) -> WV.pages[q] = V.pages[q] proof
      fix q
      assume hq0 hl h1 h2
      have ew := apply(tr.ite_yes, mp(all_elim(wpg, {q}), hq0, hl), (IN(q) by taut(h1, h2)))
      have ev := apply(tr.ite_yes, rewrite(sym(vq), mp(all_elim(hq, {q}), hq0)), (int_le(PN, q) && int_lt(q, PO) by taut(h1, rewrite(ad, h2))))
      show := trans(ew, sym(ev))
    qed
    have c5: all q. q in omega -> int_le(PN, q) -> int_lt(q, int_add(PN, n)) -> V.pages[q] = none || !(snd(V.pages[q]).kind = 2) proof
      fix q
      assume hq0 h1 h2
      have ev := apply(tr.ite_yes, rewrite(sym(vq), mp(all_elim(hq, {q}), hq0)), (int_le(PN, q) && int_lt(q, PO) by taut(h1, rewrite(ad, h2))))
      show by taut(ev)
    qed
    have c6: all a. a in bits(64) -> !(int_le(PN, x86_64_linux.page_of(a)) && int_lt(x86_64_linux.page_of(a), int_add(PN, n))) ->
        V.bytes[a] = m.vm.bytes[a] && WV.bytes[a] = w.vm.bytes[a] proof
      fix a
      assume _ _
      show by taut((V.bytes[a] = m.vm.bytes[a] by rsimp(vbs)), (WV.bytes[a] = w.vm.bytes[a] by rsimp(wby0)))
    qed
    have c7: all a. a in bits(64) -> int_le(PN, x86_64_linux.page_of(a)) -> int_lt(x86_64_linux.page_of(a), int_add(PN, n)) ->
        x86_64_linux.mapped(V, x86_64_linux.page_of(a)) -> WV.bytes[a] = V.bytes[a] proof
      fix a
      assume ha h1 h2 hmv2
      have qo: x86_64_linux.page_of(a) in omega by defs(arith(ha), x86_64_linux.page_of, x86_64_linux.PAGE)
      have ev := mp(all_elim(c5, {x86_64_linux.page_of(a)}), qo, h1, h2)
      have nn: V.pages[x86_64_linux.page_of(a)] = none := apply(tr.ite_yes, rewrite(sym(vq), mp(all_elim(hq, {x86_64_linux.page_of(a)}), qo)),
        (int_le(PN, x86_64_linux.page_of(a)) && int_lt(x86_64_linux.page_of(a), PO) by taut(h1, rewrite(ad, h2))))
      have f: false by taut(expand(hmv2, x86_64_linux.mapped), nn)
      show by taut(f)
    qed
    show by defs(taut(vt, vl, vb, wt, wl, wb, vk, pno, no, osm, c1, c2, c3, c4, c5, c6, c7), tr.vm_chg)
  qed
  // shrinking by nothing: no page changed
  have k2: !int_lt(PN, PO) -> tr.vm_chg(m.vm, V, w.vm, WV, 0, 0) proof
    assume l
    have pv: all q. q in omega -> V.pages[q] = m.vm.pages[q] proof
      fix q
      assume hq0
      show := apply(tr.ite_no, rewrite(sym(vq), mp(all_elim(hq, {q}), hq0)), (!(int_le(PN, q) && int_lt(q, PO)) by arith(l)))
    qed
    have pw: all q. q in omega -> int_lt(q, TSP) -> WV.pages[q] = w.vm.pages[q] proof
      fix q
      assume hq0 hl
      show := apply(tr.ite_no, mp(all_elim(wpg, {q}), hq0, hl), (!(int_le(PN, q) && int_lt(q, int_add(PN, n))) by arith(l, gle)))
    qed
    have bv: all a. a in bits(64) -> V.bytes[a] = m.vm.bytes[a] && WV.bytes[a] = w.vm.bytes[a] proof
      fix a
      assume _
      show by taut((V.bytes[a] = m.vm.bytes[a] by rsimp(vbs)), (WV.bytes[a] = w.vm.bytes[a] by rsimp(wby0)))
    qed
    show := apply(tr.chg_refl, hr, vt, vl, vb, wt, wl, wb, vk, pv, pw, bv)
  qed
  have rr: r = WV.brk := trans(er, sym(wbk))
  have g1: int_lt(PN, PO) -> ex WV p n. WV in x86_64_linux.Vm && gimple.brk_post(w.vm, WV, N) && r = WV.brk && V in x86_64_linux.Vm && tr.vm_chg(m.vm, V, w.vm, WV, p, n) proof
    assume l
    show by ex_intro({WV}, {PN}, {n}, taut(wv1, bp, rr, vv, mp(k1, l)))
  qed
  have g2: !int_lt(PN, PO) -> ex WV p n. WV in x86_64_linux.Vm && gimple.brk_post(w.vm, WV, N) && r = WV.brk && V in x86_64_linux.Vm && tr.vm_chg(m.vm, V, w.vm, WV, p, n) proof
    assume l
    show by ex_intro({WV}, {0}, {0}, taut(wv1, bp, rr, vv, mp(k2, l)))
  qed
  show by taut(g1, g2)
qed

// brk(N) on the machine: the world's call allows the same, the memories
// changed alike
theorem tr.brk_world(s, m, w, v, N, V, r): tr.mem(s, m, w, v) -> abi.stack_reserve(m.vm) -> m.vm in x86_64_linux.Vm -> w.vm in x86_64_linux.Vm -> N in bits(64) ->
  (int_lt(x86_64_linux.pages_for(N), x86_64_linux.pages_for(w.vm.brk)) -> int_le(w.vm.brk_start, N) ->
    int_le(x86_64_linux.pages_for(w.vm.brk), int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) &&
    gimple.sys_pages_ok(w.vm, x86_64_linux.pages_for(N), int_sub(x86_64_linux.pages_for(w.vm.brk), x86_64_linux.pages_for(N)))) ->
  lx.brk_post(m.vm, N, V, r) ->
  ex WV p n. WV in x86_64_linux.Vm && gimple.brk_post(w.vm, WV, N) && r = WV.brk && V in x86_64_linux.Vm && tr.vm_chg(m.vm, V, w.vm, WV, p, n)
proof
  assume hm hr hmv hwv hN hq hp
  have c := expand(hp, lx.brk_post)
  have k1: lx.brk_same(m.vm, N, V, r) -> ex WV p n. WV in x86_64_linux.Vm && gimple.brk_post(w.vm, WV, N) && r = WV.brk && V in x86_64_linux.Vm &&
      tr.vm_chg(m.vm, V, w.vm, WV, p, n) proof
    assume h
    show := apply(tr.brk_same_world, hm, hr, hmv, hwv, h)
  qed
  have k2: lx.brk_grow(m.vm, N, V, r) -> ex WV p n. WV in x86_64_linux.Vm && gimple.brk_post(w.vm, WV, N) && r = WV.brk && V in x86_64_linux.Vm &&
      tr.vm_chg(m.vm, V, w.vm, WV, p, n) proof
    assume h
    show := apply(tr.brk_grow_world, hm, hmv, hwv, hN, h)
  qed
  have k3: lx.brk_shrink(m.vm, N, V, r) -> ex WV p n. WV in x86_64_linux.Vm && gimple.brk_post(w.vm, WV, N) && r = WV.brk && V in x86_64_linux.Vm &&
      tr.vm_chg(m.vm, V, w.vm, WV, p, n) proof
    assume h
    show := apply(tr.brk_shrink_world, hm, hr, hmv, hwv, hN, hq, h)
  qed
  show by taut(c, k1, k2, k3)
qed

// ----------------------------------------------------------------------
//  The rule

// (sys_call1's requirement on brk's shrinking, the world w's memory)
abbrev tr.req1(w, a1) := int_lt(x86_64_linux.pages_for(a1), x86_64_linux.pages_for(w.vm.brk)) -> int_le(w.vm.brk_start, a1) ->
  (int_le(x86_64_linux.pages_for(w.vm.brk), int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) &&
   gimple.sys_pages_ok(w.vm, x86_64_linux.pages_for(a1), int_sub(x86_64_linux.pages_for(w.vm.brk), x86_64_linux.pages_for(a1)))) &&
  (all x2. x2 in omega -> int_le(x86_64_linux.pages_for(a1), x2) && int_lt(x2, x86_64_linux.pages_for(w.vm.brk)) -> x86_64_linux.mapped(w.vm, x2) ->
    snd(w.vm.pages[x2]).kind = 1)

// (not brk, or its requirement not met: any outcome, a raise too)
theorem tr.sys1_raise(n, a1, w, x, e): !(n = 12 && tr.req1(w, a1)) -> pair(w, exc(x, e)) in univ(1) -> runs(gimple.sys_call1(n, a1), w, exc(x, e))
proof
  assume h pu
  show by defs(simp(h, pu, keep(gimple.os_brk, gimple.sys_pages_ok, bind_rel)), gimple.sys_call1)
qed

// (the flags' word: a word)
theorem tr.rflags_typed(f): x86_64_linux.rflags_word(f) in bits(64)
proof
  show by defs(apply(bits_build_in, (64 in omega by simp())), x86_64_linux.rflags_word, letin, bits_set_bit)
qed

// (the machine after the syscall: rip on, rcx, r11 and rax set, its memory
// V -- a machine)
theorem tr.mach_sys(m, A, V, r): m in x86_64_linux.Machine -> m in univ(1) -> A in bits(64) -> V in x86_64_linux.Vm -> r in bits(64) ->
  fn_update(fn_update(fn_update(fn_update(m, "rip", A), "gpr", fn_update(fn_update(m.gpr, 1, A), 11, x86_64_linux.rflags_word(m.flags))), "vm", V), "gpr",
    fn_update(fn_update(fn_update(m.gpr, 1, A), 11, x86_64_linux.rflags_word(m.flags)), 0, r)) in x86_64_linux.Machine &&
  fn_update(fn_update(fn_update(fn_update(m, "rip", A), "gpr", fn_update(fn_update(m.gpr, 1, A), 11, x86_64_linux.rflags_word(m.flags))), "vm", V), "gpr",
    fn_update(fn_update(fn_update(m.gpr, 1, A), 11, x86_64_linux.rflags_word(m.flags)), 0, r)) in univ(1)
proof
  assume hM hu ha hv hr
  have _ gt .. := apply(x86i.parts, hM)
  have g1 := apply(x86.space_upd, {x86_64_linux.Reg}, {bits(64)}, {m.gpr}, {1}, {A}, gt, simp(), ha)
  have g2 := apply(x86.space_upd, {x86_64_linux.Reg}, {bits(64)}, {fn_update(m.gpr, 1, A)}, {11}, {x86_64_linux.rflags_word(m.flags)}, g1, simp(), tr.rflags_typed[f := m.flags])
  have g3 := apply(x86.space_upd, {x86_64_linux.Reg}, {bits(64)}, {fn_update(fn_update(m.gpr, 1, A), 11, x86_64_linux.rflags_word(m.flags))}, {0}, {r}, g2, simp(), hr)
  have gu := mp(app_univ[u := 1, f := m, k := "gpr"], hu)
  have vu := apply(x86.vm_univ, hv)
  have rw := tr.rflags_typed[f := m.flags]
  have a: fn_update(fn_update(fn_update(fn_update(m, "rip", A), "gpr", fn_update(fn_update(m.gpr, 1, A), 11, x86_64_linux.rflags_word(m.flags))), "vm", V), "gpr",
      fn_update(fn_update(fn_update(m.gpr, 1, A), 11, x86_64_linux.rflags_word(m.flags)), 0, r)) in x86_64_linux.Machine
    by defs(simp(expand(hM, x86_64_linux.Machine), hu, hv, vu, g3, gu, ha, hr, rw), x86_64_linux.Machine)
  have b: fn_update(fn_update(fn_update(fn_update(m, "rip", A), "gpr", fn_update(fn_update(m.gpr, 1, A), 11, x86_64_linux.rflags_word(m.flags))), "vm", V), "gpr",
      fn_update(fn_update(fn_update(m.gpr, 1, A), 11, x86_64_linux.rflags_word(m.flags)), 0, r)) in univ(1) by simp(hu, vu, gu, ha, hr, rw)
  show by taut(a, b)
qed

// syscall (0F 05), rax holding n and rdi a1: the spec's sys_call1(n, a1) --
// undefined but for brk meeting its requirement; else Linux's brk, the
// world's memory changed alike, the result in rax (the other registers
// not known on: rcx and r11 clobbered), the frame 8 bytes (rsp's page)
theorem tr.sys_call1(s, v, base, code, fr, a, a2, hs, ds, rs, rc, w, nv, a1, x9 x10 x8. ka, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw, zb. bkp, zb pb wb. bka):
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a -> runs(x86_64_linux.exec_body(2, tag(156, empty)), m, o)) ->
  a2 = bits_add(64, a, bits_of_int(64, 2)) ->
  0 in dom(rs) -> rs[0] = pair(8, nv) -> 7 in dom(rs) -> rs[7] = pair(8, a1) -> tr.cs_sub(rc, rs) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) ->
  (all w4 r0. w4 in abi.World && w4 in univ(1) -> r0 in bits(64) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, 8, fn_update(rc, 0, pair(8, r0)),
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. ka(x0, r0, x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w4)) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs,
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.sys_call1(nv, a1), x0, x9 x10. ka(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
      x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w)
proof
  assume hat ha2 h0d h0u h7d h7u hsub hk hpost
  let Q := mkprog(x0 x1. ex x8. bind_rel(gimple.sys_call1(nv, a1), x0, x9 x10. ka(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1))
  let P := mkprog(x1 x2. bind_rel(Q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))
  have g: all m. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, ds) ->
      tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, P, w, m) proof
    fix m
    assume hi hr hh hrs hmm hfr
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have {sM, srsv, wW, wu} := hi
    have rn nb := apply(tr.regs_get, {m}, {rs}, {0}, {8}, {nv}, hrs, h0d, h0u)
    have r7 ab := apply(tr.regs_get, {m}, {rs}, {7}, {8}, {a1}, hrs, h7d, h7u)
    // undefined: the spec raises
    have cu: !(nv = 12 && tr.req1(w, a1)) -> tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, P, w, m) proof
      assume h
      have rst: abi.raise_state(w) by defs(apply(tr.world_and, wW), abi.raise_state)
      have eu: empty in univ(1) by simp()
      have eno: !(empty = exc_val("stack_overflow", empty)) by defs(all_elim(tr.pair_ne, {"stack_overflow"}, {empty}), exc_val)
      have pu: pair(w, exc(w, empty)) in univ(1) by simp(wu, eu)
      have ro := apply(tr.sys1_raise, h, pu)
      have q1 := mp(all_elim(tr.qs_raise[op := gimple.sys_call1(nv, a1), s2 := w, e := empty, a := x9 x10 x8. ka(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8),
        dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1)], {w}), ro)
      have rq := mp(all_elim(q1, {exc(w, empty)}), mp(all_elim(hk, {w}, {empty}), wu, eu))
      have rp := mp(all_elim(tr.p_exc[q := Q, kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {w}, {empty}), wu, wu, eu, rq)
      have ub: tr.ub(s, v, P, w) by defs(ex_intro({empty}, {w}, taut(eu, eno, rst, rp)), tr.ub)
      show := mp(all_elim(tr.sim_ub[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {P}, {w}, {m}), ub)
    qed
    // brk, its requirement met: the machine's step, the world's alike
    have cd: nv = 12 && tr.req1(w, a1) -> tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, P, w, m) proof
      assume h
      have e12 hreq := h
      let A := bits_add(64, m.rip, bits_of_int(64, 2))
      let G1 := fn_update(fn_update(m.gpr, 1, A), 11, x86_64_linux.rflags_word(m.flags))
      let MM(V, r) := fn_update(fn_update(fn_update(fn_update(m, "rip", A), "gpr", G1), "vm", V), "gpr", fn_update(G1, 0, r))
      let QM(y) := ex V r. lx.brk_post(m.vm, m.gpr[7], V, r) && y = MM(V, r)
      have g12: m.gpr[0] = 12 := trans(rn, e12)
      have st: all o. runs(x86_64_linux.step(), m, o) -> (ex m2. o = ok(m2, empty) && QM(m2)) proof
        fix o
        assume ho
        have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
        obtain V r, bp eo from apply(x86i.brk_insn, ipM, g12, hx)
        have hq: QM(MM(V, r)) by ex_intro({V}, {r}, taut(bp, refl({MM(V, r)})))
        show by ex_intro({MM(V, r)}, taut(eo, hq))
      qed
      have nr := apply(tr.inv_nr, hi)
      // (the coupling's parts at m)
      have {rsv} := expand(hmm, tr.mem).wm
      have rm := mp(rsv, srsv)
      have mvm: m.vm in x86_64_linux.Vm := apply(x86i.parts, ipM).4
      have wf := expand(wW, abi.World)
      have wvm: w.vm in x86_64_linux.Vm by simp(wf)
      have wos: w.os in x86_64_linux.Os by simp(wf)
      have wfs: w.fs_base in bits(64) by simp(wf)
      have wosu := mp(app_univ[u := 1, f := w, k := "os"], wu)
      have htop: m.vm.stack_top in omega by simp(expand(mvm, x86_64_linux.Vm))
      have req2: int_lt(x86_64_linux.pages_for(a1), x86_64_linux.pages_for(w.vm.brk)) -> int_le(w.vm.brk_start, a1) ->
          int_le(x86_64_linux.pages_for(w.vm.brk), int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) &&
          gimple.sys_pages_ok(w.vm, x86_64_linux.pages_for(a1), int_sub(x86_64_linux.pages_for(w.vm.brk), x86_64_linux.pages_for(a1))) proof
        assume l1 l2
        have c := mp(hreq, l1, l2)
        show by taut(c)
      qed
      have post: all m2. QM(m2) -> tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, P, w, m2) proof
        fix m2
        assume hq
        obtain V r, bp em from hq
        obtain WV p n, wv bpw er vv ch from apply(tr.brk_world, hmm, rm, mvm, wvm, (a1 in bits(64) by simp(ab)), req2, rewrite(r7, bp))
        let W4 := fn_update(w, "vm", WV)
        have wvu := apply(x86.vm_univ, wv)
        have _ _ w4W w4u := apply(tr.world_set, wW, wu, wv, wvu, wos, wosu, wfs)
        have rb: r in bits(64) by simp(er, expand(wv, x86_64_linux.Vm))
        have mt mu2 := apply(tr.mach_sys, ipM, ipU, (A in bits(64) by simp()), vv, rb)
        have m2M := rewrite(sym(em), mt)
        have m2u := rewrite(sym(em), mu2)
        // m2: as m but rip, rax, rcx, r11 and its memory
        have ev: m2.vm = V by rsimp(em)
        have e4: m2.gpr[4] = m.gpr[4] by rsimp(em)
        have cs := apply(tr.cs_eq[m := m, x := m2], (m2.gpr[3] = m.gpr[3] && m2.gpr[5] = m.gpr[5] && m2.gpr[12] = m.gpr[12] && m2.gpr[13] = m.gpr[13] &&
          m2.gpr[14] = m.gpr[14] && m2.gpr[15] = m.gpr[15] by rsimp(em)))
        have ecpu: m2.cpu = m.cpu by rsimp(em)
        have egs: m2.gs_base = m.gs_base by rsimp(em)
        have eos: m2.os = m.os by rsimp(em)
        have efs: m2.fs_base = m.fs_base by rsimp(em)
        have {mdf} := hi
        have df2: !m2.flags.df by rsimp(em, mdf)
        have e0: m2.gpr[0] = r by rsimp(em)
        have rip2: m2.rip = a2 by rsimp(em, hr, ha2)
        have w4v: W4.vm = WV by rsimp()
        have w4os: W4.os = w.os by rsimp()
        have w4fs: W4.fs_base = w.fs_base by rsimp()
        have w4cpu: W4.cpu = w.cpu by rsimp()
        have w4ob: W4.objs = w.objs by rsimp()
        have i2 := apply(tr.inv_chg, hi, hmm, ch, m2M, m2u, ev, e4, ecpu, egs, eos, efs, df2, w4W, w4u, w4v, w4os, w4fs, w4cpu)
        have mm2 := apply(tr.mem_chg, hmm, srsv, htop, ch, ev, w4v, w4ob)
        have hh2 := apply(tr.homes_chg, hh, rm, ch, ev)
        have rs2 := apply(tr.regs_add, apply(tr.regs_cs_keep, hrs, hsub, cs), e0, (r in bits(int_mul(8, 8)) by simp(rb)))
        have f2 := apply(tr.frame8, i2, (8 in omega by simp()), (int_le(8, 8) by arith()))
        have pt := mp(all_elim(hpost, {W4}, {r}), (W4 in abi.World && W4 in univ(1) by taut(w4W, w4u)), rb)
        have cl := mp(all_elim(expand(pt, tr.pt), {m2}), i2, rip2, hh2, rs2, mm2, f2)
        // the spec's call: allowed, its rest from the result
        have okw := rewrite(sym(er), mp(g.sys_call1_ok[w := w, n := nv, a1 := a1, V := WV], wu, wv, bpw))
        let Q2 := mkprog(x0 x1. ex x8. ka(x0, r, x8) && k(x8, x1))
        have q1 := mp(all_elim(tr.qs_call[op := gimple.sys_call1(nv, a1), w4 := W4, r := r, a := x9 x10 x8. ka(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8),
          dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1)], {w}), wu, okw)
        have r2 := mp(all_elim(tr.p_red[q := Q, q2 := Q2, kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {W4}), wu, q1)
        have red: tr.red(P, w, mkprog(x1 x2. bind_rel(Q2, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), W4) by defs(r2, tr.red)
        show := apply(tr.cl_red[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], red, cl)
      qed
      show := mp(mp(mp(tr.step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb), s := s, v := v, p := P, w := w, m := m, q := y. QM(y)], st), nr), post)
    qed
    show by taut(cu, cd)
  qed
  show by defs(g, tr.lv)
qed

// ----------------------------------------------------------------------
//  The call's effect (tr.eff, for its callers' tr.callee_io): its returns
//  keep the world valid -- the program loaded (its code on executable
//  pages, which brk neither takes nor gives back), the break's start

// (a code byte: on a mapped, executable page)
theorem tr.code_pg(vm, gb, gc, i): abi.code_at(vm, gb, gc) -> i in omega -> int_lt(i, seq_len(gc)) ->
  x86_64_linux.mapped(vm, x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))) &&
  snd(vm.pages[x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))]).prot.x &&
  x86_64_linux.page_of(bits_of_int(64, int_add(gb, i))) in omega && bits_of_int(64, int_add(gb, i)) in bits(64)
proof
  assume hd hi hl
  have c0 := mp(all_elim(expand(hd, abi.code_at), {i}), hi, hl)
  have cf _ _ _ := c0
  have fm fx := expand(cf, x86_64_linux.fetchable)
  have xq: snd(vm.pages[x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))]).prot.x := rsimp(expand(fx, x86_64_linux.hw_allows))
  have ab: bits_of_int(64, int_add(gb, i)) in bits(64) by simp()
  have qo: x86_64_linux.page_of(bits_of_int(64, int_add(gb, i))) in omega by defs(arith(ab), x86_64_linux.page_of, x86_64_linux.PAGE)
  show by taut(fm, xq, qo, ab)
qed

// brk's return: the world valid still
theorem tr.brk_valid(w, V, a1): tr.req1(w, a1) -> gimple.brk_post(w.vm, V, a1) -> tr.returns_valid(w, fn_update(w, "vm", V))
proof
  assume hq hp
  let W2 := fn_update(w, "vm", V)
  let PO := x86_64_linux.pages_for(w.vm.brk)
  let PN := x86_64_linux.pages_for(a1)
  let TSP := int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
  have c := expand(hp, gimple.brk_post)
  // the program loaded, its break's start: as before
  let G := all gb gc st. gb in omega -> abi.loaded(w.vm, gb, gc, st) -> abi.loaded(V, gb, gc, st)
  let GB := V.brk_start = w.vm.brk_start
  have k1: V = w.vm && (int_lt(a1, w.vm.brk_start) || int_lt(PO, PN)) -> G && GB proof
    assume h
    have e _ := h
    have g: G proof
      fix gb gc st
      assume _ hl
      show := rewrite(sym(e), hl)
    qed
    have b: GB by rsimp(e)
    show by taut(g, b)
  qed
  have k2: ((((int_le(w.vm.brk_start, a1) && int_lt(PO, PN)) && x86_64_linux.free_range(w.vm, PO, int_sub(PN, PO))) &&
      x86_64_linux.off_stack_space(w.vm, PO, int_sub(PN, PO))) && gimple.fresh_pages(w.vm, V, PO, int_sub(PN, PO),
      fn_update(fn_update(empty, "prot", fn_update(fn_update(fn_update(empty, "r", true), "w", true), "x", false)), "kind", 1))) && V.brk = a1 -> G && GB proof
    assume h
    have nl gl fr _ fp _ := h
    have vt vl vb vpg vby := expand(fp, gimple.fresh_pages)
    have _ f2 _ := expand(fr, x86_64_linux.free_range)
    have g: G proof
      fix gb gc st
      assume _ hl
      have l1 l2 := expand(hl, abi.loaded)
      have e: all i. i in omega -> int_lt(i, seq_len(gc)) ->
          V.pages[x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))] = w.vm.pages[x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))] &&
          V.bytes[bits_of_int(64, int_add(gb, i))] = w.vm.bytes[bits_of_int(64, int_add(gb, i))] proof
        fix i
        assume hi hli
        let A := bits_of_int(64, int_add(gb, i))
        let Q := x86_64_linux.page_of(A)
        have fm _ qo ab := apply(tr.code_pg, l1, hi, hli)
        have nr: !(int_le(PO, Q) && int_lt(Q, int_add(PO, int_sub(PN, PO)))) proof
          assume hr
          show by taut(mp(all_elim(f2, {Q}), qo, hr), fm)
        qed
        have ql _ := expand(fm, x86_64_linux.mapped)
        have ep := apply(tr.ite_no, mp(all_elim(vpg, {Q}), qo, ql), nr)
        have rng := mp(tr.pg_rng2[a := A, p := PO, n := int_sub(PN, PO)], ab)
        have eb := apply(tr.ite_no, mp(all_elim(vby, {A}), ab), (!(int_le(int_mul(PO, x86_64_linux.PAGE), A) && int_lt(A, int_mul(int_add(PO, int_sub(PN, PO)), x86_64_linux.PAGE))) by taut(rng, nr)))
        show by taut(ep, eb)
      qed
      have cd2 := apply(tr.code_at_tr, l1, e)
      have s2 := apply(tr.statics_same, {w.vm}, {V}, {st}, vt, vl, l2)
      show by defs(taut(cd2, s2), abi.loaded)
    qed
    show by taut(g, vb)
  qed
  have k3: ((int_le(w.vm.brk_start, a1) && int_le(PN, PO)) && gimple.gone_pages(w.vm, V, PN, int_sub(PO, PN))) && V.brk = a1 -> G && GB proof
    assume h
    have nl gl gp _ := h
    have vt vl vb vpg vby := expand(gp, gimple.gone_pages)
    have g: G proof
      fix gb gc st
      assume _ hl
      have l1 l2 := expand(hl, abi.loaded)
      have e: all i. i in omega -> int_lt(i, seq_len(gc)) ->
          V.pages[x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))] = w.vm.pages[x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))] &&
          V.bytes[bits_of_int(64, int_add(gb, i))] = w.vm.bytes[bits_of_int(64, int_add(gb, i))] proof
        fix i
        assume hi hli
        let A := bits_of_int(64, int_add(gb, i))
        let Q := x86_64_linux.page_of(A)
        have fm fx qo ab := apply(tr.code_pg, l1, hi, hli)
        // (a page given back: not executable, by the requirement -- so not the code's)
        have nr: !(int_le(PN, Q) && int_lt(Q, int_add(PN, int_sub(PO, PN)))) proof
          assume hr
          have h1 h2 := hr
          have lt: int_lt(PN, PO) by arith(h1, h2)
          have _ spk _ := mp(hq, lt, nl)
          have _ nx := expand(spk, gimple.sys_pages_ok)
          show by taut(mp(all_elim(nx, {Q}), qo, hr, fm), fx)
        qed
        have ql _ := expand(fm, x86_64_linux.mapped)
        have ep := apply(tr.ite_no, mp(all_elim(vpg, {Q}), qo, ql), nr)
        have eb: V.bytes[A] = w.vm.bytes[A] by rsimp(vby)
        show by taut(ep, eb)
      qed
      have cd2 := apply(tr.code_at_tr, l1, e)
      have s2 := apply(tr.statics_same, {w.vm}, {V}, {st}, vt, vl, l2)
      show by defs(taut(cd2, s2), abi.loaded)
    qed
    show by taut(g, vb)
  qed
  have gg gb := (G && GB by taut(c, k1, k2, k3))
  have ev: W2.vm = V by rsimp()
  have eos: W2.os = w.os by rsimp()
  have ecp: W2.cpu = w.cpu by rsimp()
  have l: all gb gc st. gb in omega -> abi.loaded(w.vm, gb, gc, st) -> abi.loaded(W2.vm, gb, gc, st) := rewrite(sym(ev), gg)
  have ei: W2.os.input = w.os.input by rsimp()
  have se: subset(w.os.events, W2.os.events) := rewrite(sym(eos), subset_refl[s := w.os.events], {2})
  show by defs(taut(ei, se, l, ecp, rewrite(sym(ev), gb)), tr.returns_valid)
qed

// (the same outcomes: the same effect)
theorem tr.eff_iff(w, o. r, o. q): (all o. r(o) <-> q(o)) -> tr.eff(w, o. q(o)) -> tr.eff(w, o. r(o))
proof
  assume he hq
  have c := expand(hq, tr.eff)
  have l: (all w2 v. q(ok(w2, v)) -> tr.returns_valid(w, w2)) -> (all w2 v. r(ok(w2, v)) -> tr.returns_valid(w, w2)) proof
    assume h
    fix w2 v
    assume hr
    have qv: q(ok(w2, v)) by taut(all_elim(he, {ok(w2, v)}), hr)
    show := mp(all_elim(h, {w2}, {v}), qv)
  qed
  have u: tr.undef(o. q(o)) -> tr.undef(o. r(o)) proof
    assume h
    have ux ud := expand(h, tr.undef)
    have gx: all x e. x in univ(1) -> e in univ(1) -> r(exc(x, e)) proof
      fix x e
      assume h1 h2
      show by taut(mp(all_elim(ux, {x}, {e}), h1, h2), all_elim(he, {exc(x, e)}))
    qed
    have gd: all t. t in univ(1) -> r(diverge(t)) proof
      fix t
      assume h1
      show by taut(mp(all_elim(ud, {t}), h1), all_elim(he, {diverge(t)}))
    qed
    show by defs(taut(gx, gd), tr.undef)
  qed
  show by defs(taut(c, l, u), tr.eff)
qed

// brk's world call (its requirement met): its returns valid
theorem tr.eff_os_brk(w, a1): tr.req1(w, a1) -> tr.eff(w, o. runs(gimple.os_brk(a1), w, o))
proof
  assume hq
  have k: all V. V in x86_64_linux.Vm && gimple.brk_post(w.vm, fn_update(w, "vm", V).vm, a1) ->
      tr.eff(w, o. letin(fn_update(w, "vm", V), x4. o = ok(x4, x4.vm.brk))) proof
    fix V
    assume h
    have _ hp := h
    have bp: gimple.brk_post(w.vm, V, a1) := rsimp(hp)
    have rv := apply(tr.brk_valid, hq, bp)
    have g: all w2 v. ok(w2, v) = ok(fn_update(w, "vm", V), fn_update(w, "vm", V).vm.brk) -> tr.returns_valid(w, w2) proof
      fix w2 v
      assume e
      have ew: w2 = fn_update(w, "vm", V) by simp(e)
      show := rewrite(sym(ew), rv)
    qed
    show by defs(taut(g), tr.eff, letin)
  qed
  have a := apply(tr.eff_any[d := x3. x3 in x86_64_linux.Vm && gimple.brk_post(w.vm, fn_update(w, "vm", x3).vm, a1),
    k := x3 o. letin(fn_update(w, "vm", x3), x4. o = ok(x4, x4.vm.brk))], {w}, k)
  show by defs(apply(tr.eff_prog, {w}, (tr.eff(w, o. letin(w.vm, x2. any_rel(x3. x3 in x86_64_linux.Vm && gimple.brk_post(x2, fn_update(w, "vm", x3).vm, a1),
    x3. letin(fn_update(w, "vm", x3), x4. o = ok(x4, x4.vm.brk))))) by defs(a, letin))), gimple.os_brk)
qed

// sys_call1's effect: undefined but for brk with its requirement; then brk's
theorem tr.eff_sys_call1: all w n a1. tr.eff(w, o. runs(gimple.sys_call1(n, a1), w, o))
proof
  fix w n a1
  let B(o) := bind_rel(gimple.os_brk(a1), w, x2 x3. o = ok(x2, x3), x2 x3. o = exc(x2, x3), x2. o = diverge(x2))
  let BODY(o) := !(n = 12) || (!tr.req1(w, a1) || B(o))
  have c1: !(n = 12 && tr.req1(w, a1)) -> tr.eff(w, o. BODY(o)) proof
    assume h
    have ux: all x e. x in univ(1) -> e in univ(1) -> BODY(exc(x, e)) proof
      fix x e
      assume _ _
      show by taut(h)
    qed
    have ud: all t. t in univ(1) -> BODY(diverge(t)) proof
      fix t
      assume _
      show by taut(h)
    qed
    have u: tr.undef(o. BODY(o)) by defs(taut(ux, ud), tr.undef)
    show by defs(taut(u), tr.eff)
  qed
  have c2: n = 12 && tr.req1(w, a1) -> tr.eff(w, o. BODY(o)) proof
    assume h
    have _ hq := h
    have eo := apply(tr.eff_os_brk, hq)
    have rt: all s1 v. runs(gimple.os_brk(a1), w, ok(s1, v)) -> tr.eff(s1, o. o = ok(s1, v)) proof
      fix s1 v
      assume _
      show := all_elim(tr.eff_ret, {s1}, {v})
    qed
    have eb := apply(tr.eff_bind[p := gimple.os_brk(a1), k := s1 v o. o = ok(s1, v)], {w}, eo, rt)
    have iff: all o. BODY(o) <-> B(o) proof
      fix o
      show by taut(h)
    qed
    show := apply(tr.eff_iff[w := w, r := o. BODY(o), q := o. B(o)], iff, eb)
  qed
  have be: tr.eff(w, o. BODY(o)) by taut(c1, c2)
  show by defs(apply(tr.eff_prog, {w}, be), gimple.sys_call1)
qed
