// get_stride (musl mallocng, at -O0): the stride of a group's slots from
// its meta (at g): for a mapped group (sizeclass bits 0 and a page count,
// `maplen`), maplen * 4096 - 16; otherwise UNIT * size_classes[sizeclass].
// C1 under the ABI; the machine reads the meta's word at g + 32 as one
// byte, eight bytes or two, where the spec reads its bit fields.
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core core/records.core \
//     core/list.core core/loop.core build/c_mallocng_malloc.core proofs/x86.core proofs/x86_code.core \
//     build/leaf_steps.core proofs/abi.core proofs/abi_restore.core proofs/abi_glue.core proofs/gimple.core \
//     proofs/abi_stack.core proofs/get_stride.core

abbrev gs.spec := c_src_malloc_mallocng_malloc.get_stride_fun()
// the spec's reads of the meta at g (on the memory v)
abbrev gs.bf(v, g, off, n, pos, k) := int_mod(int_div(gimple.bytes_at(v, int_add(g, off), n), int_pow(2, pos)), int_pow(2, k))
abbrev gs.c1(v, g) := bits_and(8, bits_of_int(8, gs.bf(v, g, 32, 1, 0, 8)), 31) = 0
abbrev gs.c2(v, g) := !(bits_and(64, bits_of_int(64, gs.bf(v, g, 32, 8, 0, 64)), bits_neg(64, 4096)) = 0)
abbrev gs.maplen(v, g) := bits_of_int(52, gs.bf(v, g, 33, 7, 4, 52))
abbrev gs.sc(v, g) := bits_of_int(6, gs.bf(v, g, 32, 2, 6, 6))
abbrev gs.taddr(v, g) := int_add(4218912, int_mul(gs.sc(v, g), 2))
abbrev gs.ent(v, g) := bits_of_int(16, gimple.bytes_at(v, gs.taddr(v, g), 2))
abbrev gs.res_map(v, g) := bits_add(64, bits_mul(64, gs.maplen(v, g), 4096), bits_neg(64, 16))
abbrev gs.res_sc(v, g) := bits_sext(32, 64, int_mul(gs.ent(v, g), 16))
abbrev gs.res(v, g) := ite(gs.c1(v, g) && gs.c2(v, g), gs.res_map(v, g), gs.res_sc(v, g))
// defined: the reads it makes can be made
abbrev gs.defined(v, g) := g.mem_defined(v, g, 32, 1, false) &&
  (gs.c1(v, g) -> g.mem_defined(v, g, 32, 8, false) && (gs.c2(v, g) -> g.mem_defined(v, g, 33, 7, false))) &&
  (!(gs.c1(v, g) && gs.c2(v, g)) -> g.mem_defined(v, g, 32, 2, false) && g.mem_defined(v, gs.taddr(v, g), 0, 2, false))
abbrev gs.arg(args) := bits_of_int(64, app(args, 0))
abbrev gs.ok(v, args) := ord_le(1, seq_len(args)) && gs.defined(v, gs.arg(args))

// the accessors: the bit fields
theorem gs.maplen_ok: all w g. w in univ(1) -> g in bits(64) -> g.mem_defined(app(w, "vm"), g, 33, 7, false) ->
  runs(c_src_malloc_mallocng_malloc.meta_maplen(g), w, ok(w, gs.maplen(app(w, "vm"), g)))
proof
  fix w
  fix g
  assume hw: w in univ(1)
  assume hg: g in bits(64)
  assume hd: g.mem_defined(app(w, "vm"), g, 33, 7, false)
  have l := apply(g.ldbf_ok, {w}, {g}, {33}, {7}, {4}, {52}, hw, hg, simp(), hd)
  show by defs(simp(hw, l, keep(gimple.ldbf)), c_src_malloc_mallocng_malloc.meta_maplen)
qed

theorem gs.sizeclass_ok: all w g. w in univ(1) -> g in bits(64) -> g.mem_defined(app(w, "vm"), g, 32, 2, false) ->
  runs(c_src_malloc_mallocng_malloc.meta_sizeclass(g), w, ok(w, gs.sc(app(w, "vm"), g)))
proof
  fix w
  fix g
  assume hw: w in univ(1)
  assume hg: g in bits(64)
  assume hd: g.mem_defined(app(w, "vm"), g, 32, 2, false)
  have l := apply(g.ldbf_ok, {w}, {g}, {32}, {2}, {6}, {6}, hw, hg, simp(), hd)
  show by defs(simp(hw, l, keep(gimple.ldbf)), c_src_malloc_mallocng_malloc.meta_sizeclass)
qed

// the size-class path: the table's entry, times 16
theorem gs.sc_path: all w g. w in univ(1) -> g in bits(64) -> g.mem_defined(app(w, "vm"), g, 32, 2, false) -> g.mem_defined(app(w, "vm"), gs.taddr(app(w, "vm"), g), 0, 2, false) ->
  runs(c_src_malloc_mallocng_malloc.meta_sizeclass(g), w, ok(w, gs.sc(app(w, "vm"), g))) &&
  runs(gimple.elem(c_src_malloc_mallocng_malloc.__malloc_size_classes, bits_sext(32, 64, gs.sc(app(w, "vm"), g)), 2), w, ok(w, gs.taddr(app(w, "vm"), g))) &&
  runs(gimple.ld16(gs.taddr(app(w, "vm"), g), 0), w, ok(w, gs.ent(app(w, "vm"), g))) &&
  runs(gimple.smul(32, gs.ent(app(w, "vm"), g), 16), w, ok(w, int_mul(gs.ent(app(w, "vm"), g), 16)))
proof
  fix w
  fix g
  assume hw: w in univ(1)
  assume hg: g in bits(64)
  assume h2: g.mem_defined(app(w, "vm"), g, 32, 2, false)
  assume ht: g.mem_defined(app(w, "vm"), gs.taddr(app(w, "vm"), g), 0, 2, false)
  have ms := apply(gs.sizeclass_ok, hw, hg, h2)
  have sb: gs.sc(app(w, "vm"), g) in bits(6) by simp()
  have el := apply(g.elem_ok, {w}, {4218912}, {gs.sc(app(w, "vm"), g)}, {2}, hw, simp(), simp(sb), simp(), simp(sb), simp(sb))
  have ec: runs(gimple.elem(c_src_malloc_mallocng_malloc.__malloc_size_classes, bits_sext(32, 64, gs.sc(app(w, "vm"), g)), 2), w, ok(w, gs.taddr(app(w, "vm"), g)))
    by defs(simp(el, sb, keep(gimple.elem)), c_src_malloc_mallocng_malloc.__malloc_size_classes)
  have ld := apply(g.ld16_ok, {w}, {gs.taddr(app(w, "vm"), g)}, hw, simp(sb), ht)
  have eb: gs.ent(app(w, "vm"), g) in bits(16) by simp()
  have sm: runs(gimple.smul(32, gs.ent(app(w, "vm"), g), 16), w, ok(w, int_mul(gs.ent(app(w, "vm"), g), 16)))
    by defs(simp(hw, eb), gimple.smul, gimple.arith, gimple.fits, gimple.wrap, sint)
  show by taut(ms, ec, ld, sm)
qed

theorem gs.proc_ok: all w g. w in univ(1) -> g in bits(64) -> gs.defined(app(w, "vm"), g) ->
  runs(c_src_malloc_mallocng_malloc.get_stride(g), w, ok(w, gs.res(app(w, "vm"), g)))
proof
  fix w
  fix g
  assume hw: w in univ(1)
  assume hg: g in bits(64)
  assume hd: gs.defined(app(w, "vm"), g)
  have l1 := apply(g.ldbf_ok, {w}, {g}, {32}, {1}, {0}, {8}, hw, hg, simp(), simp(hd))
  // mapped: the page count
  have ca: gs.c1(app(w, "vm"), g) && gs.c2(app(w, "vm"), g) -> runs(c_src_malloc_mallocng_malloc.get_stride(g), w, ok(w, gs.res_map(app(w, "vm"), g))) proof
    assume hc: gs.c1(app(w, "vm"), g) && gs.c2(app(w, "vm"), g)
    have l8 := apply(g.ldbf_ok, {w}, {g}, {32}, {8}, {0}, {64}, hw, hg, simp(), simp(hd, hc))
    have mm := apply(gs.maplen_ok, hw, hg, simp(hd, hc))
    show by defs(simp(hw, hg, hc, l1, l8, mm, keep(gimple.ldbf, c_src_malloc_mallocng_malloc.meta_maplen, c_src_malloc_mallocng_malloc.meta_sizeclass)), c_src_malloc_mallocng_malloc.get_stride)
  qed
  // otherwise: the size class
  have cb: !(gs.c1(app(w, "vm"), g) && gs.c2(app(w, "vm"), g)) -> runs(c_src_malloc_mallocng_malloc.get_stride(g), w, ok(w, gs.res_sc(app(w, "vm"), g))) proof
    assume hc: !(gs.c1(app(w, "vm"), g) && gs.c2(app(w, "vm"), g))
    have sp := apply(gs.sc_path, hw, hg, simp(hd, hc), simp(hd, hc))
    have b1: !gs.c1(app(w, "vm"), g) -> runs(c_src_malloc_mallocng_malloc.get_stride(g), w, ok(w, gs.res_sc(app(w, "vm"), g))) proof
      assume h1: !gs.c1(app(w, "vm"), g)
      show by defs(simp(hw, hg, h1, l1, sp, keep(gimple.ldbf, gimple.elem, gimple.ld16, gimple.smul, c_src_malloc_mallocng_malloc.meta_maplen, c_src_malloc_mallocng_malloc.meta_sizeclass)), c_src_malloc_mallocng_malloc.get_stride)
    qed
    have b2: gs.c1(app(w, "vm"), g) -> runs(c_src_malloc_mallocng_malloc.get_stride(g), w, ok(w, gs.res_sc(app(w, "vm"), g))) proof
      assume h1: gs.c1(app(w, "vm"), g)
      have h2: !gs.c2(app(w, "vm"), g) by taut(hc, h1)
      have l8 := apply(g.ldbf_ok, {w}, {g}, {32}, {8}, {0}, {64}, hw, hg, simp(), simp(hd, h1))
      show by defs(simp(hw, hg, h1, h2, l1, l8, sp, keep(gimple.ldbf, gimple.elem, gimple.ld16, gimple.smul, c_src_malloc_mallocng_malloc.meta_maplen, c_src_malloc_mallocng_malloc.meta_sizeclass)), c_src_malloc_mallocng_malloc.get_stride)
    qed
    show by taut(b1, b2)
  qed
  show by simp(ca, cb, keep(c_src_malloc_mallocng_malloc.get_stride))
qed

theorem gs.maplen_ub: all w g e. w in univ(1) -> e in univ(1) -> g in bits(64) -> !g.mem_defined(app(w, "vm"), g, 33, 7, false) ->
  runs(c_src_malloc_mallocng_malloc.meta_maplen(g), w, exc(w, e))
proof
  fix w
  fix g
  fix e
  assume hw: w in univ(1)
  assume he: e in univ(1)
  assume hg: g in bits(64)
  assume hn: !g.mem_defined(app(w, "vm"), g, 33, 7, false)
  have l := apply(g.ldbf_ub, {w}, {g}, {33}, {7}, {4}, {52}, {e}, hw, he, hg, simp(), hn)
  show by defs(simp(hw, he, l, keep(gimple.ldbf)), c_src_malloc_mallocng_malloc.meta_maplen)
qed

theorem gs.sizeclass_ub: all w g e. w in univ(1) -> e in univ(1) -> g in bits(64) -> !g.mem_defined(app(w, "vm"), g, 32, 2, false) ->
  runs(c_src_malloc_mallocng_malloc.meta_sizeclass(g), w, exc(w, e))
proof
  fix w
  fix g
  fix e
  assume hw: w in univ(1)
  assume he: e in univ(1)
  assume hg: g in bits(64)
  assume hn: !g.mem_defined(app(w, "vm"), g, 32, 2, false)
  have l := apply(g.ldbf_ub, {w}, {g}, {32}, {2}, {6}, {6}, {e}, hw, he, hg, simp(), hn)
  show by defs(simp(hw, he, l, keep(gimple.ldbf)), c_src_malloc_mallocng_malloc.meta_sizeclass)
qed

theorem gs.proc_raises: all w g e. w in univ(1) -> e in univ(1) -> g in bits(64) -> !gs.defined(app(w, "vm"), g) ->
  runs(c_src_malloc_mallocng_malloc.get_stride(g), w, exc(w, e))
proof
  fix w
  fix g
  fix e
  assume hw: w in univ(1)
  assume he: e in univ(1)
  assume hg: g in bits(64)
  assume hn: !gs.defined(app(w, "vm"), g)
  let v := app(w, "vm")
  // the byte at g + 32 not readable
  have r1: !g.mem_defined(v, g, 32, 1, false) -> runs(c_src_malloc_mallocng_malloc.get_stride(g), w, exc(w, e)) proof
    assume h1: !g.mem_defined(v, g, 32, 1, false)
    have u1 := apply(g.ldbf_ub, {w}, {g}, {32}, {1}, {0}, {8}, {e}, hw, he, hg, simp(), h1)
    show by defs(simp(hw, he, hg, u1, keep(gimple.ldbf, gimple.elem, gimple.ld16, gimple.smul, c_src_malloc_mallocng_malloc.meta_maplen, c_src_malloc_mallocng_malloc.meta_sizeclass)), c_src_malloc_mallocng_malloc.get_stride)
  qed
  have rest: g.mem_defined(v, g, 32, 1, false) -> runs(c_src_malloc_mallocng_malloc.get_stride(g), w, exc(w, e)) proof
    assume h1: g.mem_defined(v, g, 32, 1, false)
    have l1 := apply(g.ldbf_ok, {w}, {g}, {32}, {1}, {0}, {8}, hw, hg, simp(), h1)
    // the word not readable
    have r2: gs.c1(v, g) -> !g.mem_defined(v, g, 32, 8, false) -> runs(c_src_malloc_mallocng_malloc.get_stride(g), w, exc(w, e)) proof
      assume hc1: gs.c1(v, g)
      assume h8: !g.mem_defined(v, g, 32, 8, false)
      have u8 := apply(g.ldbf_ub, {w}, {g}, {32}, {8}, {0}, {64}, {e}, hw, he, hg, simp(), h8)
      show by defs(simp(hw, he, hg, hc1, l1, u8, keep(gimple.ldbf, gimple.elem, gimple.ld16, gimple.smul, c_src_malloc_mallocng_malloc.meta_maplen, c_src_malloc_mallocng_malloc.meta_sizeclass)), c_src_malloc_mallocng_malloc.get_stride)
    qed
    // the page count not readable
    have r3: gs.c1(v, g) -> g.mem_defined(v, g, 32, 8, false) -> gs.c2(v, g) -> !g.mem_defined(v, g, 33, 7, false) -> runs(c_src_malloc_mallocng_malloc.get_stride(g), w, exc(w, e)) proof
      assume hc1: gs.c1(v, g)
      assume h8: g.mem_defined(v, g, 32, 8, false)
      assume hc2: gs.c2(v, g)
      assume h7: !g.mem_defined(v, g, 33, 7, false)
      have l8 := apply(g.ldbf_ok, {w}, {g}, {32}, {8}, {0}, {64}, hw, hg, simp(), h8)
      have um := apply(gs.maplen_ub, hw, he, hg, h7)
      show by defs(simp(hw, he, hg, hc1, hc2, l1, l8, um, keep(gimple.ldbf, gimple.elem, gimple.ld16, gimple.smul, c_src_malloc_mallocng_malloc.meta_maplen, c_src_malloc_mallocng_malloc.meta_sizeclass)), c_src_malloc_mallocng_malloc.get_stride)
    qed
    // the size class or its table entry not readable (after the word, when
    // c1: defined there)
    have r4: !(gs.c1(v, g) && gs.c2(v, g)) -> (gs.c1(v, g) -> g.mem_defined(v, g, 32, 8, false)) -> !(g.mem_defined(v, g, 32, 2, false) && g.mem_defined(v, gs.taddr(v, g), 0, 2, false)) ->
        runs(c_src_malloc_mallocng_malloc.get_stride(g), w, exc(w, e)) proof
      assume hc: !(gs.c1(v, g) && gs.c2(v, g))
      assume h8: gs.c1(v, g) -> g.mem_defined(v, g, 32, 8, false)
      assume hb: !(g.mem_defined(v, g, 32, 2, false) && g.mem_defined(v, gs.taddr(v, g), 0, 2, false))
      have m2: !g.mem_defined(v, g, 32, 2, false) -> runs(c_src_malloc_mallocng_malloc.get_stride(g), w, exc(w, e)) proof
        assume h2: !g.mem_defined(v, g, 32, 2, false)
        have us := apply(gs.sizeclass_ub, hw, he, hg, h2)
        have n1: !gs.c1(v, g) -> runs(c_src_malloc_mallocng_malloc.get_stride(g), w, exc(w, e)) proof
          assume hn1: !gs.c1(v, g)
          show by defs(simp(hw, he, hg, hn1, l1, us, keep(gimple.ldbf, gimple.elem, gimple.ld16, gimple.smul, c_src_malloc_mallocng_malloc.meta_maplen, c_src_malloc_mallocng_malloc.meta_sizeclass)), c_src_malloc_mallocng_malloc.get_stride)
        qed
        have y1: gs.c1(v, g) -> runs(c_src_malloc_mallocng_malloc.get_stride(g), w, exc(w, e)) proof
          assume hy1: gs.c1(v, g)
          have hn2: !gs.c2(v, g) by taut(hc, hy1)
          have l8 := apply(g.ldbf_ok, {w}, {g}, {32}, {8}, {0}, {64}, hw, hg, simp(), mp(h8, hy1))
          show by defs(simp(hw, he, hg, hy1, hn2, l1, l8, us, keep(gimple.ldbf, gimple.elem, gimple.ld16, gimple.smul, c_src_malloc_mallocng_malloc.meta_maplen, c_src_malloc_mallocng_malloc.meta_sizeclass)), c_src_malloc_mallocng_malloc.get_stride)
        qed
        show by taut(n1, y1)
      qed
      have mt: g.mem_defined(v, g, 32, 2, false) -> !g.mem_defined(v, gs.taddr(v, g), 0, 2, false) -> runs(c_src_malloc_mallocng_malloc.get_stride(g), w, exc(w, e)) proof
        assume h2: g.mem_defined(v, g, 32, 2, false)
        assume ht: !g.mem_defined(v, gs.taddr(v, g), 0, 2, false)
        have ms := apply(gs.sizeclass_ok, hw, hg, h2)
        have sb: gs.sc(v, g) in bits(6) by simp()
        have el := apply(g.elem_ok, {w}, {4218912}, {gs.sc(v, g)}, {2}, hw, simp(), simp(sb), simp(), simp(sb), simp(sb))
        have ec: runs(gimple.elem(c_src_malloc_mallocng_malloc.__malloc_size_classes, bits_sext(32, 64, gs.sc(v, g)), 2), w, ok(w, gs.taddr(v, g)))
          by defs(simp(el, sb, keep(gimple.elem)), c_src_malloc_mallocng_malloc.__malloc_size_classes)
        have ut := apply(g.ld16_ub, {w}, {gs.taddr(v, g)}, {e}, hw, he, simp(sb), ht)
        have n1: !gs.c1(v, g) -> runs(c_src_malloc_mallocng_malloc.get_stride(g), w, exc(w, e)) proof
          assume hn1: !gs.c1(v, g)
          show by defs(simp(hw, he, hg, hn1, l1, ms, ec, ut, keep(gimple.ldbf, gimple.elem, gimple.ld16, gimple.smul, c_src_malloc_mallocng_malloc.meta_maplen, c_src_malloc_mallocng_malloc.meta_sizeclass)), c_src_malloc_mallocng_malloc.get_stride)
        qed
        have y1: gs.c1(v, g) -> runs(c_src_malloc_mallocng_malloc.get_stride(g), w, exc(w, e)) proof
          assume hy1: gs.c1(v, g)
          have hn2: !gs.c2(v, g) by taut(hc, hy1)
          have l8 := apply(g.ldbf_ok, {w}, {g}, {32}, {8}, {0}, {64}, hw, hg, simp(), mp(h8, hy1))
          show by defs(simp(hw, he, hg, hy1, hn2, l1, l8, ms, ec, ut, keep(gimple.ldbf, gimple.elem, gimple.ld16, gimple.smul, c_src_malloc_mallocng_malloc.meta_maplen, c_src_malloc_mallocng_malloc.meta_sizeclass)), c_src_malloc_mallocng_malloc.get_stride)
        qed
        show by taut(n1, y1)
      qed
      show by taut(hb, m2, mt)
    qed
    show by taut(hn, h1, r2, r3, r4)
  qed
  show by taut(r1, rest)
qed

theorem gs.fun_ok: all w args y. w in univ(1) -> args in abi.ARGS -> y in bits(64) -> gs.ok(app(w, "vm"), args) ->
  runs(app(gs.spec, args), w, ok(w, pair(gs.res(app(w, "vm"), gs.arg(args)), y)))
proof
  fix w
  fix args
  fix y
  assume hw: w in univ(1)
  assume hA: args in abi.ARGS
  assume hy: y in bits(64)
  assume hu: gs.ok(app(w, "vm"), args)
  have pr := apply(gs.proc_ok, {w}, {gs.arg(args)}, hw, simp(), simp(hu))
  have rb: gs.res(app(w, "vm"), gs.arg(args)) in bits(64) by simp()
  have rs: runs(gimple.result(64, gs.res(app(w, "vm"), gs.arg(args))), w, ok(w, gs.res(app(w, "vm"), gs.arg(args)))) by defs(simp(hw, rb), gimple.result, gimple.in_reg)
  show by defs(simp(hw, hA, hy, hu, pr, rs, keep(c_src_malloc_mallocng_malloc.get_stride, gimple.result)), c_src_malloc_mallocng_malloc.get_stride_fun)
qed

theorem gs.fun_raises: all w args e. w in univ(1) -> e in univ(1) -> args in abi.ARGS -> !gs.ok(app(w, "vm"), args) ->
  runs(app(gs.spec, args), w, exc(w, e))
proof
  fix w
  fix args
  fix e
  assume hw: w in univ(1)
  assume he: e in univ(1)
  assume hA: args in abi.ARGS
  assume hn: !gs.ok(app(w, "vm"), args)
  have c1: !ord_le(1, seq_len(args)) -> runs(app(gs.spec, args), w, exc(w, e)) proof
    assume hl: !ord_le(1, seq_len(args))
    show by defs(simp(hw, he, hA, hl, keep(c_src_malloc_mallocng_malloc.get_stride, gimple.result)), c_src_malloc_mallocng_malloc.get_stride_fun)
  qed
  have c2: !gs.defined(app(w, "vm"), gs.arg(args)) -> runs(app(gs.spec, args), w, exc(w, e)) proof
    assume hd: !gs.defined(app(w, "vm"), gs.arg(args))
    have pr := apply(gs.proc_raises, {w}, {gs.arg(args)}, {e}, hw, he, simp(), hd)
    show by defs(simp(hw, he, hA, pr, keep(c_src_malloc_mallocng_malloc.get_stride, gimple.result)), c_src_malloc_mallocng_malloc.get_stride_fun)
  qed
  show by taut(hn, c1, c2)
qed

// the machine's reads of the meta against the spec's bit fields, on any
// memory vm (its bytes 8-bit where the arithmetic needs it)
abbrev gb.rd(vm, g, n) := x86_64_linux.le(app(vm, "bytes"), bits_add(64, g, 32), n)
abbrev gb.byte(vm, a) := app(app(vm, "bytes"), a)

theorem gb.le_bytes(vm, a, n): x86_64_linux.le(app(vm, "bytes"), a, n) = bits_of_int(int_mul(8, n), gimple.bytes_at(vm, a, n))
proof
  show by defs(simp(), x86_64_linux.le, gimple.bytes_at)
qed

theorem gb.c1(vm, g): g in bits(64) -> (bits_add(5, gb.rd(vm, g, 1), 0) = 0 <-> gs.c1(vm, g))
proof
  assume hg: g in bits(64)
  show by defs(simp(hg), x86_64_linux.le, gimple.bytes_at)
qed

theorem gb.c2(vm, g): g in bits(64) -> (!(bits_and(64, gb.rd(vm, g, 8), 18446744073709547520) = 0) <-> gs.c2(vm, g))
proof
  assume hg: g in bits(64)
  show by defs(simp(hg), x86_64_linux.le, gimple.bytes_at)
qed

theorem gb.sc(vm, g): g in bits(64) -> gb.byte(vm, bits_add(64, g, 32)) in bits(8) -> gb.byte(vm, bits_add(64, g, 33)) in bits(8) ->
  bits_add(6, bits_shr(16, gb.rd(vm, g, 2), 6), 0) = gs.sc(vm, g)
proof
  assume hg: g in bits(64)
  assume b0: gb.byte(vm, bits_add(64, g, 32)) in bits(8)
  assume b1: gb.byte(vm, bits_add(64, g, 33)) in bits(8)
  show by defs(simp(hg, b0, b1), x86_64_linux.le, gimple.bytes_at, bits_shr)
qed

// the size-class result, for a class x: `movzwl (2x + table)`, `shl $4`
theorem gb.res_sc(vm, x): x in bits(6) -> gb.byte(vm, int_add(4218912, int_mul(x, 2))) in bits(8) -> gb.byte(vm, int_add(4218913, int_mul(x, 2))) in bits(8) ->
  bits_sext(32, 64, bits_shl(32, x86_64_linux.le(app(vm, "bytes"), bits_add(64, int_add(x, x), 4218912), 2), 4)) =
  bits_sext(32, 64, int_mul(bits_of_int(16, gimple.bytes_at(vm, int_add(4218912, int_mul(x, 2)), 2)), 16))
proof
  assume hx: x in bits(6)
  assume t0: gb.byte(vm, int_add(4218912, int_mul(x, 2))) in bits(8)
  assume t1: gb.byte(vm, int_add(4218913, int_mul(x, 2))) in bits(8)
  show by defs(simp(hx, t0, t1), x86_64_linux.le, gimple.bytes_at, bits_shl)
qed

// the mapped result: the word's pages (bits 12 and up) are maplen's
theorem gb.res_map(vm, g): g in bits(64) -> gb.byte(vm, bits_add(64, g, 32)) in bits(8) -> gb.byte(vm, bits_add(64, g, 33)) in bits(8) -> gb.byte(vm, bits_add(64, g, 34)) in bits(8) ->
  gb.byte(vm, bits_add(64, g, 35)) in bits(8) -> gb.byte(vm, bits_add(64, g, 36)) in bits(8) -> gb.byte(vm, bits_add(64, g, 37)) in bits(8) -> gb.byte(vm, bits_add(64, g, 38)) in bits(8) ->
  gb.byte(vm, bits_add(64, g, 39)) in bits(8) ->
  bits_add(64, bits_shl(64, bits_shr(64, gb.rd(vm, g, 8), 12), 12), 18446744073709551600) = gs.res_map(vm, g)
proof
  assume hg: g in bits(64)
  assume b32: gb.byte(vm, bits_add(64, g, 32)) in bits(8)
  assume b33: gb.byte(vm, bits_add(64, g, 33)) in bits(8)
  assume b34: gb.byte(vm, bits_add(64, g, 34)) in bits(8)
  assume b35: gb.byte(vm, bits_add(64, g, 35)) in bits(8)
  assume b36: gb.byte(vm, bits_add(64, g, 36)) in bits(8)
  assume b37: gb.byte(vm, bits_add(64, g, 37)) in bits(8)
  assume b38: gb.byte(vm, bits_add(64, g, 38)) in bits(8)
  assume b39: gb.byte(vm, bits_add(64, g, 39)) in bits(8)
  let s8 := gimple.bytes_at(vm, bits_add(64, g, 32), 8)
  let s7 := gimple.bytes_at(vm, bits_add(64, g, 33), 7)
  // s8 = its first byte + 256 * s7: the pages are s7 / 16
  have e1: s8 = int_add(gb.byte(vm, bits_add(64, g, 32)), int_mul(s7, 256)) by defs(simp(hg, b32, b33, b34, b35, b36, b37, b38, b39), gimple.bytes_at)
  have r8: s8 in bits(64) by defs(simp(hg, b32, b33, b34, b35, b36, b37, b38, b39), gimple.bytes_at)
  have r7: s7 in bits(56) by defs(simp(hg, b32, b33, b34, b35, b36, b37, b38, b39), gimple.bytes_at)
  have q: int_div(s8, 4096) = int_div(s7, 16) by arith(e1, b32, r7, r8)
  have d52: int_div(s7, 16) in bits(52) by arith(r7)
  have l8 := gb.le_bytes[vm := vm, a := bits_add(64, g, 32), n := 8]
  show by defs(simp(hg, l8, r8, q, d52), bits_shl, bits_shr, bits_mul)
qed

// a read the spec can make on the view v: the machine can make it on vm
// (the same pages)
theorem gs.reads: all v vm g off n. g in bits(64) -> off in bits(32) -> g.mem_defined(v, g, off, n, false) -> app(v, "pages") = app(vm, "pages") ->
  (all i. i in omega -> int_lt(i, n) -> x86_64_linux.can_access(vm, bits_add(64, bits_add(64, g, off), bits_of_int(64, i)), 0))
proof
  fix v
  fix vm
  fix g
  fix off
  fix n
  assume hg: g in bits(64)
  assume ho: off in bits(32)
  assume hd: g.mem_defined(v, g, off, n, false)
  assume hp: app(v, "pages") = app(vm, "pages")
  show all i. i in omega -> int_lt(i, n) -> x86_64_linux.can_access(vm, bits_add(64, bits_add(64, g, off), bits_of_int(64, i)), 0) proof
    fix i
    assume i1: i in omega
    assume i2: int_lt(i, n)
    have r := apply(g.usable_read, {v}, {vm}, {int_add(g, off)}, {n}, {i}, simp(hd), hp, simp(hg, ho), i1, i2)
    have ea: bits_add(64, bits_add(64, g, off), bits_of_int(64, i)) = bits_of_int(64, int_add(int_add(g, off), i)) by simp(hg, ho, i1)
    show := rewrite(sym(ea), r)
  qed
qed

// the machine, from entry to return (three paths: the size class from either
// test, or the mapped group's pages), summarized
abbrev gsm.rsp(m) := app(app(m, "gpr"), 4)
abbrev gsm.g(m) := app(app(m, "gpr"), 7)
abbrev gsm.slot(m) := bits_add(64, gsm.rsp(m), 18446744073709551608)
abbrev gsm.vm1(m) := fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), gsm.slot(m), 8, gsm.g(m)))
abbrev gsm.f(m) := bits_add(64, gsm.g(m), 32)
abbrev gsm.rd(m, n) := x86_64_linux.le(app(gsm.vm1(m), "bytes"), gsm.f(m), n)
abbrev gsm.sc(m) := bits_add(6, bits_shr(16, gsm.rd(m, 2), 6), 0)
abbrev gsm.taddr(m) := bits_add(64, int_add(gsm.sc(m), gsm.sc(m)), 4218912)
// the paths: the low 5 bits of the byte 0 and a page count in the word (maplen)
abbrev gsm.mapped(m) := bits_add(5, gsm.rd(m, 1), 0) = 0 && !(bits_and(64, gsm.rd(m, 8), 18446744073709547520) = 0)
abbrev gsm.res(m) := ite(gsm.mapped(m), bits_add(64, bits_shl(64, bits_shr(64, gsm.rd(m, 8), 12), 12), 18446744073709551600),
  bits_sext(32, 64, bits_shl(32, x86_64_linux.le(app(gsm.vm1(m), "bytes"), gsm.taddr(m), 2), 4)))
abbrev gsm.reads(m, a, n) := all i. i in omega -> int_lt(i, n) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, a, bits_of_int(64, i)), 0)

theorem get_stride.run(m, o): m in x86_64_linux.Machine -> m in univ(1) -> abi.code_at(app(m, "vm"), 4203614, get_stride.code()) -> app(m, "rip") = 4203614 ->
  (all i. i in omega -> int_lt(i, 8) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, gsm.slot(m), bits_of_int(64, i)), 1)) ->
  gsm.reads(m, gsm.slot(m), 8) -> gsm.reads(m, gsm.rsp(m), 8) -> gsm.reads(m, gsm.f(m), 1) ->
  (bits_add(5, gsm.rd(m, 1), 0) = 0 -> gsm.reads(m, gsm.f(m), 8)) ->
  (!gsm.mapped(m) -> gsm.reads(m, gsm.f(m), 2) && gsm.reads(m, gsm.taddr(m), 2)) ->
  runs(abi.run_to_return(), m, o) ->
  ex m1. o = ok(m1, empty) && abi.returns(m, m1, gsm.vm1(m), gsm.res(m))
proof
  assume hM: m in x86_64_linux.Machine
  assume hu: m in univ(1)
  assume hc: abi.code_at(app(m, "vm"), 4203614, get_stride.code())
  assume hr: app(m, "rip") = 4203614
  assume aw: all i. i in omega -> int_lt(i, 8) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, gsm.slot(m), bits_of_int(64, i)), 1)
  assume ar: gsm.reads(m, gsm.slot(m), 8)
  assume a7: gsm.reads(m, gsm.rsp(m), 8)
  assume a1: gsm.reads(m, gsm.f(m), 1)
  assume a8: bits_add(5, gsm.rd(m, 1), 0) = 0 -> gsm.reads(m, gsm.f(m), 8)
  assume ab: !gsm.mapped(m) -> gsm.reads(m, gsm.f(m), 2) && gsm.reads(m, gsm.taddr(m), 2)
  assume h: runs(abi.run_to_return(), m, o)
  have hsp: gsm.rsp(m) in bits(64) by simp(hM)
  have hdi: gsm.g(m) in bits(64) by simp(hM)
  have hv: app(m, "vm") in x86_64_linux.Vm by simp(hM)
  have r := symex(h, hc, hr, hM, hsp, hdi, aw, ar, a7, a1, a8, ab, x86.cond_eval, get_stride.ok_40245e, get_stride.ok_402463, get_stride.ok_402468, get_stride.ok_40246c, get_stride.ok_40246f, get_stride.ok_402471, get_stride.ok_402473, get_stride.ok_402478, get_stride.ok_40247c, get_stride.ok_402482, get_stride.ok_402485, get_stride.ok_402487, get_stride.ok_40248c, get_stride.ok_402490, get_stride.ok_402494, get_stride.ok_402498, get_stride.ok_40249c, get_stride.ok_40249d, get_stride.ok_4024a2, get_stride.ok_4024a6, get_stride.ok_4024aa, get_stride.ok_4024ad, get_stride.ok_4024b0, get_stride.ok_4024b2, get_stride.ok_4024b6, get_stride.ok_4024bd, get_stride.ok_4024c1, get_stride.ok_4024c4, get_stride.ok_4024c7, get_stride.ok_4024c9)
  show by simp(r, hM, hu, hv, g.store_univ, x86.store_typed, hsp, hdi)
qed

// C1: the machine code implements the C function's spec, in any program
theorem gs.implements: all statics. abi.implements2_at(single(empty), 4203614, gs.spec, 4203614, get_stride.code(), statics)
proof
  fix statics
  have runs: all args s o. args in abi.ARGS -> s in x86_64_linux.Machine -> abi.loaded(app(s, "vm"), 4203614, get_stride.code(), statics) -> app(s, "rip") = 4203614 -> abi.entry_ok(s, args) ->
      runs(abi.run_to_return(), s, o) -> runs(abi.abi_function(single(empty), 4203614, gs.spec, args), s, o) proof
    fix args
    fix s
    fix o
    assume hA: args in abi.ARGS
    assume hM: s in x86_64_linux.Machine
    assume hl: abi.loaded(app(s, "vm"), 4203614, get_stride.code(), statics)
    assume hrip: app(s, "rip") = 4203614
    assume he: abi.entry_ok(s, args)
    assume hr: runs(abi.run_to_return(), s, o)
    have hc: abi.code_at(app(s, "vm"), 4203614, get_stride.code()) by taut(expand(hl, abi.loaded))
    have hp := apply(abi.run_univ, hr)
    have su: s in univ(1) by simp(hp)
    have hsv: app(s, "vm") in x86_64_linux.Vm by simp(hM)
    have hsp: gsm.rsp(s) in bits(64) by simp(hM)
    have hdi: gsm.g(s) in bits(64) by simp(hM)
    have ent := apply(abi.entry_stack, hM, he)
    // the slot (8 bytes at rsp - 8): scratch space; the view is the memory after the store
    have sv := apply(abi.slot_view, {app(s, "vm")}, {gsm.rsp(s)}, {18446744073709551608}, {8}, {gsm.g(s)}, hsv, hsp, ent, ent, ent, simp(), simp(), simp())
    have v1u: gsm.vm1(s) in univ(1) by simp(su, hsv, g.store_univ)
    have v1: gsm.vm1(s) in x86_64_linux.Vm by simp(hM, v1u, x86.store_typed)
    let w := abi.view(gsm.vm1(s), s)
    have wu: w in univ(1) by simp(su, v1u)
    have eu: empty in univ(1) by simp()
    // no argument, or a read of the meta not possible: the spec raises
    have ub: !gs.ok(gsm.vm1(s), args) -> runs(abi.abi_function(single(empty), 4203614, gs.spec, args), s, o) proof
      assume hn: !gs.ok(gsm.vm1(s), args)
      have fr := apply(gs.fun_raises, wu, eu, hA, simp(hn))
      show := apply(abi.ub_case, {4203614}, {gs.spec}, {args}, {s}, {o}, {gsm.vm1(s)}, {empty}, hM, v1, v1u, sv, sv, eu, fr, hp, simp(apply(abi.run_shape, hr)))
    qed
    // defined: the run returns normally, with the spec's result
    have ret: gs.ok(gsm.vm1(s), args) -> runs(abi.abi_function(single(empty), 4203614, gs.spec, args), s, o) proof
      assume hd0: gs.ok(gsm.vm1(s), args)
      have pa := apply(abi.arg_passed, hA, he, simp(hd0))
      // the pointer the machine stores and reloads is the spec's g
      have ex: gs.arg(args) = gsm.g(s) by simp(pa, hdi)
      have hd1 := rewrite(ex, hd0)
      have hd: gs.defined(gsm.vm1(s), gsm.g(s)) by taut(hd1)
      have pg: app(gsm.vm1(s), "pages") = app(app(s, "vm"), "pages") by simp()
      // the view's bytes: 8 bits
      have vb: app(gsm.vm1(s), "bytes") in fn_space(bits(64), bits(8)) by simp(hM, x86.store_typed)
      // the paths agree
      have ec1 := mp(gb.c1[vm := gsm.vm1(s), g := gsm.g(s)], hdi)
      have ec2 := mp(gb.c2[vm := gsm.vm1(s), g := gsm.g(s)], hdi)
      have b32: gb.byte(gsm.vm1(s), bits_add(64, gsm.g(s), 32)) in bits(8) by simp(vb)
      have b33: gb.byte(gsm.vm1(s), bits_add(64, gsm.g(s), 33)) in bits(8) by simp(vb)
      have esc := mp(gb.sc[vm := gsm.vm1(s), g := gsm.g(s)], hdi, b32, b33)
      have sb: gs.sc(gsm.vm1(s), gsm.g(s)) in bits(6) by simp()
      have eta: gsm.taddr(s) = bits_add(64, gs.taddr(gsm.vm1(s), gsm.g(s)), 0) by simp(esc, sb)
      // the machine's reads
      have a1 := apply(gs.reads, {gsm.vm1(s)}, {app(s, "vm")}, {gsm.g(s)}, {32}, {1}, hdi, simp(), simp(hd), pg)
      have a8: bits_add(5, gsm.rd(s, 1), 0) = 0 -> gsm.reads(s, gsm.f(s), 8) proof
        assume h1: bits_add(5, gsm.rd(s, 1), 0) = 0
        have c1: gs.c1(gsm.vm1(s), gsm.g(s)) by taut(h1, ec1)
        show := apply(gs.reads, {gsm.vm1(s)}, {app(s, "vm")}, {gsm.g(s)}, {32}, {8}, hdi, simp(), simp(hd, c1), pg)
      qed
      have ab: !gsm.mapped(s) -> gsm.reads(s, gsm.f(s), 2) && gsm.reads(s, gsm.taddr(s), 2) proof
        assume hm: !gsm.mapped(s)
        have nc: !(gs.c1(gsm.vm1(s), gsm.g(s)) && gs.c2(gsm.vm1(s), gsm.g(s))) by taut(hm, ec1, ec2)
        have r2 := apply(gs.reads, {gsm.vm1(s)}, {app(s, "vm")}, {gsm.g(s)}, {32}, {2}, hdi, simp(), simp(hd, nc), pg)
        have rt := apply(gs.reads, {gsm.vm1(s)}, {app(s, "vm")}, {gs.taddr(gsm.vm1(s), gsm.g(s))}, {0}, {2}, simp(sb), simp(), simp(hd, nc), pg)
        show by simp(r2, rt, eta)
      qed
      have sa := apply(abi.slot_access, {app(s, "vm")}, {gsm.rsp(s)}, {18446744073709551608}, {8}, hsp, ent, ent, simp(), simp(), simp())
      have ra := apply(abi.ret_access, {app(s, "vm")}, {gsm.rsp(s)}, hsp, ent, ent)
      have run := apply(get_stride.run, hM, su, hc, hrip, sa, sa, ra, a1, a8, ab, hr)
      obtain m1, hm1 from run
      have eo: o = ok(m1, empty) by taut(hm1)
      have hp2 := rewrite(eo, hp)
      have m1M: m1 in x86_64_linux.Machine by taut(hm1)
      // the machine's result is the spec's
      have rm: gsm.mapped(s) -> gsm.res(s) = gs.res(gsm.vm1(s), gsm.g(s)) proof
        assume hm: gsm.mapped(s)
        have cc: gs.c1(gsm.vm1(s), gsm.g(s)) && gs.c2(gsm.vm1(s), gsm.g(s)) by taut(hm, ec1, ec2)
        have b34: gb.byte(gsm.vm1(s), bits_add(64, gsm.g(s), 34)) in bits(8) by simp(vb)
        have b35: gb.byte(gsm.vm1(s), bits_add(64, gsm.g(s), 35)) in bits(8) by simp(vb)
        have b36: gb.byte(gsm.vm1(s), bits_add(64, gsm.g(s), 36)) in bits(8) by simp(vb)
        have b37: gb.byte(gsm.vm1(s), bits_add(64, gsm.g(s), 37)) in bits(8) by simp(vb)
        have b38: gb.byte(gsm.vm1(s), bits_add(64, gsm.g(s), 38)) in bits(8) by simp(vb)
        have b39: gb.byte(gsm.vm1(s), bits_add(64, gsm.g(s), 39)) in bits(8) by simp(vb)
        have em := mp(gb.res_map[vm := gsm.vm1(s), g := gsm.g(s)], hdi, b32, b33, b34, b35, b36, b37, b38, b39)
        show by simp(hm, cc, em)
      qed
      have rs: !gsm.mapped(s) -> gsm.res(s) = gs.res(gsm.vm1(s), gsm.g(s)) proof
        assume hm: !gsm.mapped(s)
        have nc: !(gs.c1(gsm.vm1(s), gsm.g(s)) && gs.c2(gsm.vm1(s), gsm.g(s))) by taut(hm, ec1, ec2)
        have t0: gb.byte(gsm.vm1(s), int_add(4218912, int_mul(gs.sc(gsm.vm1(s), gsm.g(s)), 2))) in bits(8) by simp(vb, sb)
        have t1: gb.byte(gsm.vm1(s), int_add(4218913, int_mul(gs.sc(gsm.vm1(s), gsm.g(s)), 2))) in bits(8) by simp(vb, sb)
        have es := mp(gb.res_sc[vm := gsm.vm1(s), x := gs.sc(gsm.vm1(s), gsm.g(s))], sb, t0, t1)
        show by simp(hm, nc, esc, es)
      qed
      have er: gsm.res(s) = gs.res(gsm.vm1(s), gsm.g(s)) by taut(rm, rs)
      have e0: gs.res(app(w, "vm"), gsm.g(s)) = app(app(m1, "gpr"), 0) by simp(er, hm1)
      have fo0 := apply(gs.fun_ok, {w}, {args}, {app(app(m1, "gpr"), 2)}, wu, hA, simp(m1M), simp(hd0))
      have fo := rewrite(e0, rewrite(ex, fo0))
      have rv := apply(abi.ret_view, {4203614}, {gs.spec}, {args}, {s}, {m1}, {gsm.vm1(s)}, hM, he, hp2, v1, v1u, sv, sv, simp(hm1), fo)
      show := rewrite(sym(eo), rv)
    qed
    show by taut(ub, ret)
  qed
  show := apply(abi.implements_intro, runs)
qed
