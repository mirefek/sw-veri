    have k12: all ws11 vs12. runs(gimple.ld64(as9, 8), ws8, ok(ws11, vs12)) -> tr.eff(ws11, x0. x0 = ok(ws11, vs12)) proof
      fix ws11 vs12
      assume _
      show by defs(apply(tr.eff_ret, {ws11}), letin)
    qed
    show by defs(apply(tr.eff_bind, {ws8}, all_elim(tr.eff_ld64, {ws8}, {as9}, {8}), k12), letin)
  qed
  show by defs(apply(tr.eff_prog, {ws8}, kb), c_src_malloc_mallocng_malloc.meta_next, letin)
qed

