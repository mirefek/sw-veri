theorem dqt.implements: all statics. tr.implements_at(4206409, c_src_malloc_mallocng_malloc.dequeue_fun(), 4206409, dequeue.code, statics)
proof
  fix statics
  have hsub: all vm. abi.loaded(vm, 4206409, dequeue.code, statics) -> abi.code_at(vm, 4206409, dequeue.code) proof
    fix vm
    assume h: abi.loaded(vm, 4206409, dequeue.code, statics)
    show by taut(expand(h, abi.loaded))
  qed
  have hregs: all args s. args in abi.ARGS -> s in x86_64_linux.Machine -> abi.entry_ok(s, args) -> ord_le(2, seq_len(args)) -> tr.regs(s, fn_update(fn_update(empty, 7, pair(8, bits_of_int(64, app(args, 0)))), 6, pair(8, bits_of_int(64, app(args, 1))))) proof
    fix args
    fix s
    assume hA hM he hg
    have ln: seq_len(args) in omega by simp(hA)
    have r0 := all_elim(tr.regs_empty, {s})
    have a0 := apply(tr.arg_reg, {s}, {args}, {0}, {7}, hM, he, simp(), (int_lt(0, seq_len(args)) by arith(ln, expand(hg, ord_le))), simp(tr.argregs), simp())
    have r1 := apply(tr.regs_add, {s}, {empty}, {7}, {8}, {bits_of_int(64, app(args, 0))}, r0, simp(a0), simp(a0))
    have a1 := apply(tr.arg_reg, {s}, {args}, {1}, {6}, hM, he, simp(), (int_lt(1, seq_len(args)) by arith(ln, expand(hg, ord_le))), simp(tr.argregs), simp())
    have r2 := apply(tr.regs_add, {s}, {fn_update(empty, 7, pair(8, bits_of_int(64, app(args, 0))))}, {6}, {8}, {bits_of_int(64, app(args, 1))}, r1, simp(a1), simp(a1))
    show := r2
  qed
  have m0 := mp(tr.entry_n[lb := 4206409, lc := dequeue.code, base := 4206409, code := dequeue.code, statics := statics, f := 4206409, n := 2, fd := 16, rs := x0. fn_update(fn_update(empty, 7, pair(8, bits_of_int(64, app(x0, 0)))), 6, pair(8, bits_of_int(64, app(x0, 1)))),
    q := x0. c_src_malloc_mallocng_malloc.dequeue(bits_of_int(64, app(x0, 0)), bits_of_int(64, app(x0, 1))), kw := x0 x1 x2. any_rel(x3. x3 in bits(64), x3. any_rel(x4. x4 in bits(64), x4. x2 = ok(x0, pair(x3, x4))))],
    simp(), hsub, hregs, all_elim(dqt.body, {statics}))
  have m: all args objs mem s o. args in abi.ARGS -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) ->
      abi.loaded(app(s, "vm"), 4206409, dequeue.code, statics) -> app(s, "rip") = 4206409 -> abi.entry_ok(s, args) -> tr.objs_ok(s, objs) -> abi.view_ok(s, objs, mem) -> tr.run_d(s, s, o) ->
      tr.matches_t(c_src_malloc_mallocng_malloc.dequeue_fun(), args, objs, mem, s, o) by defs(m0, c_src_malloc_mallocng_malloc.dequeue_fun)
  show by defs(m, tr.implements_at)
qed

theorem dqt.implements_abi: all statics. abi.implements2_at(single(empty), 4206409, c_src_malloc_mallocng_malloc.dequeue_fun(), 4206409, dequeue.code, statics)
proof
  fix statics
  show := apply(tr.implements_abi, all_elim(dqt.implements, {statics}))
qed

