theorem ms.sc_step: all j. j in omega -> int_lt(j, 47) -> int_lt(app(mallocng.size_classes, j), app(mallocng.size_classes, int_add(j, 1)))
proof
  fix j
  assume hj hl
  have k0: int_le(0, j) && int_lt(j, 11) -> int_lt(app(mallocng.size_classes, j), app(mallocng.size_classes, int_add(j, 1))) proof
    assume hc
    have d: j = 0 || j = 1 || j = 2 || j = 3 || j = 4 || j = 5 || j = 6 || j = 7 || j = 8 || j = 9 || j = 10 by arith(hj, hc)
    show by simp(d, ms.sc_vals)
  qed
  have k11: int_le(11, j) && int_lt(j, 22) -> int_lt(app(mallocng.size_classes, j), app(mallocng.size_classes, int_add(j, 1))) proof
    assume hc
    have d: j = 11 || j = 12 || j = 13 || j = 14 || j = 15 || j = 16 || j = 17 || j = 18 || j = 19 || j = 20 || j = 21 by arith(hj, hc)
    show by simp(d, ms.sc_vals)
  qed
  have k22: int_le(22, j) && int_lt(j, 33) -> int_lt(app(mallocng.size_classes, j), app(mallocng.size_classes, int_add(j, 1))) proof
    assume hc
    have d: j = 22 || j = 23 || j = 24 || j = 25 || j = 26 || j = 27 || j = 28 || j = 29 || j = 30 || j = 31 || j = 32 by arith(hj, hc)
    show by simp(d, ms.sc_vals)
  qed
  have k33: int_le(33, j) && int_lt(j, 44) -> int_lt(app(mallocng.size_classes, j), app(mallocng.size_classes, int_add(j, 1))) proof
    assume hc
    have d: j = 33 || j = 34 || j = 35 || j = 36 || j = 37 || j = 38 || j = 39 || j = 40 || j = 41 || j = 42 || j = 43 by arith(hj, hc)
    show by simp(d, ms.sc_vals)
  qed
  have k44: int_le(44, j) && int_lt(j, 47) -> int_lt(app(mallocng.size_classes, j), app(mallocng.size_classes, int_add(j, 1))) proof
    assume hc
    have d: j = 44 || j = 45 || j = 46 by arith(hj, hc)
    show by simp(d, ms.sc_vals)
  qed
  have cs: (int_le(0, j) && int_lt(j, 11)) || (int_le(11, j) && int_lt(j, 22)) || (int_le(22, j) && int_lt(j, 33)) || (int_le(33, j) && int_lt(j, 44)) || (int_le(44, j) && int_lt(j, 47)) by arith(hj, hl)
  show by taut(cs, k0, k11, k22, k33, k44)
qed

// (so a class's size is at most a later one's)
theorem ms.sc_mono: all j k. j in omega -> k in omega -> int_le(j, k) -> int_lt(k, 48) -> int_le(app(mallocng.size_classes, j), app(mallocng.size_classes, k))
proof
  fix j
  have base: int_le(j, 0) -> int_lt(0, 48) -> j in omega -> int_le(app(mallocng.size_classes, j), app(mallocng.size_classes, 0)) proof
    assume h1 _ hj
    have e: j = 0 by arith(h1, hj)
    show by simp(e)
  qed
  have step: all k. k in omega -> (int_le(j, k) -> int_lt(k, 48) -> j in omega -> int_le(app(mallocng.size_classes, j), app(mallocng.size_classes, k))) ->
      (int_le(j, int_add(k, 1)) -> int_lt(int_add(k, 1), 48) -> j in omega -> int_le(app(mallocng.size_classes, j), app(mallocng.size_classes, int_add(k, 1)))) proof
    fix k
    assume hk ih h1 h2 hj
    have c1: j = int_add(k, 1) -> int_le(app(mallocng.size_classes, j), app(mallocng.size_classes, int_add(k, 1))) proof
      assume e
      show by simp(e)
    qed
    have c2: int_le(j, k) -> int_le(app(mallocng.size_classes, j), app(mallocng.size_classes, int_add(k, 1))) proof
      assume h
      have a := mp(ih, h, (int_lt(k, 48) by arith(h2)), hj)
      have b := mp(all_elim(ms.sc_step, {k}), hk, (int_lt(k, 47) by arith(h2)))
      show by arith(a, b)
    qed
    have cs: j = int_add(k, 1) || int_le(j, k) by arith(h1, hj, hk)
    show by taut(c1, c2, cs)
  qed
  have all := mp(nat_ind[p := k. int_le(j, k) -> int_lt(k, 48) -> j in omega -> int_le(app(mallocng.size_classes, j), app(mallocng.size_classes, k))], base, step)
  fix k
  assume hj hk hjk hk48
  show := mp(all_elim(all, {k}), hk, hjk, hk48, hj)
qed

// (powers of 2: increasing in the exponent)
theorem ms.pow2_mono: all k l. k in omega -> l in omega -> int_le(k, l) -> int_le(pow2(k), pow2(l))
proof
  fix k
  have base: int_le(k, 0) -> k in omega -> int_le(pow2(k), pow2(0)) proof
    assume h hk
    have e: k = 0 by arith(h, hk)
    show by simp(e)
  qed
  have step: all l. l in omega -> (int_le(k, l) -> k in omega -> int_le(pow2(k), pow2(l))) -> (int_le(k, int_add(l, 1)) -> k in omega -> int_le(pow2(k), pow2(int_add(l, 1)))) proof
    fix l
    assume hl ih h hk
    have c1: k = int_add(l, 1) -> int_le(pow2(k), pow2(int_add(l, 1))) proof
      assume e
      show by simp(e)
    qed
    have c2: int_le(k, l) -> int_le(pow2(k), pow2(int_add(l, 1))) proof
      assume h2
      have a := mp(ih, h2, hk)
      show by arith(a, hl, hk)
    qed
    have cs: k = int_add(l, 1) || int_le(k, l) by arith(h, hk, hl)
    show by taut(c1, c2, cs)
  qed
  have all := mp(nat_ind[p := l. int_le(k, l) -> k in omega -> int_le(pow2(k), pow2(l))], base, step)
  fix l
  assume hk hl hkl
  show := mp(all_elim(all, {l}), hl, hkl, hk)
qed

// (the classes: naturals, at most 8191)
theorem ms.sc_nat: all j. j in omega -> int_lt(j, 48) -> app(mallocng.size_classes, j) in omega && int_le(app(mallocng.size_classes, j), 8191)
proof
  fix j
  assume hj hl
  have k0: int_le(0, j) && int_lt(j, 11) -> app(mallocng.size_classes, j) in omega && int_le(app(mallocng.size_classes, j), 8191) proof
    assume hc
    have d: j = 0 || j = 1 || j = 2 || j = 3 || j = 4 || j = 5 || j = 6 || j = 7 || j = 8 || j = 9 || j = 10 by arith(hj, hc)
    show by simp(d, ms.sc_vals)
  qed
  have k11: int_le(11, j) && int_lt(j, 22) -> app(mallocng.size_classes, j) in omega && int_le(app(mallocng.size_classes, j), 8191) proof
    assume hc
    have d: j = 11 || j = 12 || j = 13 || j = 14 || j = 15 || j = 16 || j = 17 || j = 18 || j = 19 || j = 20 || j = 21 by arith(hj, hc)
    show by simp(d, ms.sc_vals)
  qed
  have k22: int_le(22, j) && int_lt(j, 33) -> app(mallocng.size_classes, j) in omega && int_le(app(mallocng.size_classes, j), 8191) proof
    assume hc
    have d: j = 22 || j = 23 || j = 24 || j = 25 || j = 26 || j = 27 || j = 28 || j = 29 || j = 30 || j = 31 || j = 32 by arith(hj, hc)
    show by simp(d, ms.sc_vals)
  qed
  have k33: int_le(33, j) && int_lt(j, 44) -> app(mallocng.size_classes, j) in omega && int_le(app(mallocng.size_classes, j), 8191) proof
    assume hc
    have d: j = 33 || j = 34 || j = 35 || j = 36 || j = 37 || j = 38 || j = 39 || j = 40 || j = 41 || j = 42 || j = 43 by arith(hj, hc)
    show by simp(d, ms.sc_vals)
  qed
  have k44: int_le(44, j) && int_lt(j, 48) -> app(mallocng.size_classes, j) in omega && int_le(app(mallocng.size_classes, j), 8191) proof
    assume hc
    have d: j = 44 || j = 45 || j = 46 || j = 47 by arith(hj, hc)
    show by simp(d, ms.sc_vals)
  qed
  have cs: (int_le(0, j) && int_lt(j, 11)) || (int_le(11, j) && int_lt(j, 22)) || (int_le(22, j) && int_lt(j, 33)) || (int_le(33, j) && int_lt(j, 44)) || (int_le(44, j) && int_lt(j, 48)) by arith(hj, hl)
  show by taut(cs, k0, k11, k22, k33, k44)
qed

// (class_of from the class's size and the one before: the earlier ones
// smaller still)
theorem ms.class_from: all n c. n in omega -> c in omega -> int_lt(c, 48) -> int_le(int_div(int_add(n, 19), 16), app(mallocng.size_classes, c)) ->
  (c = 0 || int_lt(app(mallocng.size_classes, int_sub(c, 1)), int_div(int_add(n, 19), 16))) -> mallocng_specs.class_of(n, c)
proof
  fix n c
  assume hn hc h48 hle hprev
  have lt: all j. j in omega -> int_lt(j, c) -> int_lt(app(mallocng.size_classes, j), int_div(int_add(n, 19), 16)) proof
    fix j
    assume hj hjc
    have c0: !(c = 0) by arith(hj, hjc, hc)
    have hp: int_lt(app(mallocng.size_classes, int_sub(c, 1)), int_div(int_add(n, 19), 16)) by taut(hprev, c0)
    have m := mp(all_elim(ms.sc_mono, {j}, {int_sub(c, 1)}), hj, (int_sub(c, 1) in omega by arith(hc, hjc, hj)), (int_le(j, int_sub(c, 1)) by arith(hjc, hj, hc)), (int_lt(int_sub(c, 1), 48) by arith(h48, hjc, hc)))
    show by arith(m, hp)
  qed
  show by defs(taut(h48, hle, lt), mallocng_specs.class_of)
qed

// a small size: at most 10 units, the class units - 1
theorem ms.stc_small: all n. n in omega -> int_le(int_div(int_add(n, 3), 16), 9) -> mallocng_specs.class_of(n, int_div(int_add(n, 3), 16))
proof
  fix n
  assume hn hq
  let Q := int_div(int_add(n, 3), 16)
  have qo: Q in omega by arith(hn)
  have u: int_div(int_add(n, 19), 16) = int_add(Q, 1) by arith(hn)
  have d: Q = 0 || Q = 1 || Q = 2 || Q = 3 || Q = 4 || Q = 5 || Q = 6 || Q = 7 || Q = 8 || Q = 9 by arith(qo, hq)
  have v: app(mallocng.size_classes, Q) = int_add(Q, 1) by simp(d, ms.sc_vals)
  have pv: Q = 0 || int_lt(app(mallocng.size_classes, int_sub(Q, 1)), int_add(Q, 1)) by simp(d, ms.sc_vals)
  have le: int_le(int_div(int_add(n, 19), 16), app(mallocng.size_classes, Q)) by arith(u, v)
  have pv2: Q = 0 || int_lt(app(mallocng.size_classes, int_sub(Q, 1)), int_div(int_add(n, 19), 16)) := rewrite(sym(u), pv)
  show := apply(ms.class_from, hn, qo, (int_lt(Q, 48) by arith(hq, qo)), le, pv2)
qed

// (a large size: its units' leading-zero count, 19 to 28)
theorem ms.stc_bounds: all u c. u in omega -> int_le(11, u) -> int_le(u, 8191) -> c in omega -> mallocng_specs.clz_of(u, c) -> int_le(19, c) && int_le(c, 28)
proof
  fix u c
  assume hu h11 h8k hc hz
  have c32 lo hi := expand(hz, mallocng_specs.clz_of)
  have a: int_lt(c, 19) -> false proof
    assume h
    have m := mp(all_elim(ms.pow2_mono, {13}, {int_sub(31, c)}), (13 in omega by simp()), (int_sub(31, c) in omega by arith(hc, c32)), (int_le(13, int_sub(31, c)) by arith(h, hc)))
    have p13: pow2(13) = 8192 by simp()
    show by arith(expand(rewrite(p13, m), pow2), lo, h8k)
  qed
  have b: int_lt(28, c) -> false proof
    assume h
    have m := mp(all_elim(ms.pow2_mono, {int_sub(32, c)}, {3}), (int_sub(32, c) in omega by arith(hc, c32)), (3 in omega by simp()), (int_le(int_sub(32, c), 3) by arith(h, hc)))
    have p3: pow2(3) = 8 by simp()
    show by arith(expand(rewrite(p3, m), pow2), hi, h11)
  qed
  show by arith(a, b, hc)
qed

// a large size (more than 10 units u): the class the code picks -- from
// u's leading-zero count c the bucket's four classes at 4 * (30 - c), two
// comparisons -- is u's
theorem ms.stc_big: all n c i1 i2. n in omega -> int_le(n, 131052) -> !int_le(int_div(int_add(n, 3), 16), 9) -> c in omega -> mallocng_specs.clz_of(int_add(int_div(int_add(n, 3), 16), 1), c) ->
  (int_lt(app(mallocng.size_classes, int_add(int_mul(4, int_sub(30, c)), 1)), int_add(int_div(int_add(n, 3), 16), 1)) -> i1 = int_add(int_mul(4, int_sub(30, c)), 2)) -> (!int_lt(app(mallocng.size_classes, int_add(int_mul(4, int_sub(30, c)), 1)), int_add(int_div(int_add(n, 3), 16), 1)) -> i1 = int_mul(4, int_sub(30, c))) ->
  (int_lt(app(mallocng.size_classes, i1), int_add(int_div(int_add(n, 3), 16), 1)) -> i2 = int_add(i1, 1)) -> (!int_lt(app(mallocng.size_classes, i1), int_add(int_div(int_add(n, 3), 16), 1)) -> i2 = i1) ->
  mallocng_specs.class_of(n, i2)
proof
  fix n c i1 i2
  assume hn h131 hbig hc hz ha1 ha2 hb1 hb2
  have uo: int_add(int_div(int_add(n, 3), 16), 1) in omega by arith(hn)
  have u11: int_le(11, int_add(int_div(int_add(n, 3), 16), 1)) by arith(hn, hbig)
  have u8k: int_le(int_add(int_div(int_add(n, 3), 16), 1), 8191) by arith(hn, h131)
  have ue: int_div(int_add(n, 19), 16) = int_add(int_div(int_add(n, 3), 16), 1) by arith(hn)
  have b19 b28 := apply(ms.stc_bounds, uo, u11, u8k, hc, hz)
  have d: c = 19 || c = 20 || c = 21 || c = 22 || c = 23 || c = 24 || c = 25 || c = 26 || c = 27 || c = 28 by arith(hc, b19, b28)
  have k19: c = 19 -> mallocng_specs.class_of(n, i2) proof
    assume e
    have zl zlo zhi := expand(rewrite(e, hz), mallocng_specs.clz_of)
    have lo: int_le(4096, int_add(int_div(int_add(n, 3), 16), 1)) by simp(zlo)
    have hi: int_lt(int_add(int_div(int_add(n, 3), 16), 1), 8192) by simp(zhi)
    have e0: int_mul(4, int_sub(30, c)) = 44 by simp(e)
    have a1 := rewrite(e0, ha1)
    have a2 := rewrite(e0, ha2)
    have v43: app(mallocng.size_classes, 43) = 4095 by simp(ms.sc_vals)
    have v44: app(mallocng.size_classes, 44) = 4680 by simp(ms.sc_vals)
    have v45: app(mallocng.size_classes, 45) = 5460 by simp(ms.sc_vals)
    have v46: app(mallocng.size_classes, 46) = 6552 by simp(ms.sc_vals)
    have v47: app(mallocng.size_classes, 47) = 8191 by simp(ms.sc_vals)
    have w1: app(mallocng.size_classes, int_add(44, 1)) = 5460 by simp(ms.sc_vals)
    have sAB: int_lt(app(mallocng.size_classes, int_add(44, 1)), int_add(int_div(int_add(n, 3), 16), 1)) -> int_lt(app(mallocng.size_classes, 46), int_add(int_div(int_add(n, 3), 16), 1)) -> mallocng_specs.class_of(n, i2) proof
      assume hA hB
      have ei1: i1 = 46 by simp(hA, a1)
      have ei2: i2 = 47 by simp(rewrite(ei1, hb1), hB)
      have pv: app(mallocng.size_classes, int_sub(47, 1)) = 6552 by simp(ms.sc_vals)
      have le: int_le(int_div(int_add(n, 19), 16), app(mallocng.size_classes, 47)) by arith(ue, hi, lo, hA, hB, w1, v47, v46)
      have pr: 47 = 0 || int_lt(app(mallocng.size_classes, int_sub(47, 1)), int_div(int_add(n, 19), 16)) by arith(ue, hi, lo, u11, hA, hB, w1, pv, v46)
      have cl := apply(ms.class_from, hn, (47 in omega by simp()), (int_lt(47, 48) by simp()), le, pr)
      show := rewrite(sym(ei2), cl)
    qed
    have sAb: int_lt(app(mallocng.size_classes, int_add(44, 1)), int_add(int_div(int_add(n, 3), 16), 1)) -> !int_lt(app(mallocng.size_classes, 46), int_add(int_div(int_add(n, 3), 16), 1)) -> mallocng_specs.class_of(n, i2) proof
      assume hA hB
      have ei1: i1 = 46 by simp(hA, a1)
      have ei2: i2 = 46 by simp(rewrite(ei1, hb2), hB)
      have pv: app(mallocng.size_classes, int_sub(46, 1)) = 5460 by simp(ms.sc_vals)
      have le: int_le(int_div(int_add(n, 19), 16), app(mallocng.size_classes, 46)) by arith(ue, hi, lo, hA, hB, w1, v46, v46)
      have pr: 46 = 0 || int_lt(app(mallocng.size_classes, int_sub(46, 1)), int_div(int_add(n, 19), 16)) by arith(ue, hi, lo, u11, hA, hB, w1, pv, v46)
      have cl := apply(ms.class_from, hn, (46 in omega by simp()), (int_lt(46, 48) by simp()), le, pr)
      show := rewrite(sym(ei2), cl)
    qed
    have saB: !int_lt(app(mallocng.size_classes, int_add(44, 1)), int_add(int_div(int_add(n, 3), 16), 1)) -> int_lt(app(mallocng.size_classes, 44), int_add(int_div(int_add(n, 3), 16), 1)) -> mallocng_specs.class_of(n, i2) proof
      assume hA hB
