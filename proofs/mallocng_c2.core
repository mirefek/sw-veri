theorem ms.sc_len: seq_len(mallocng.size_classes) = 48
proof
  show by defs(arith(), mallocng.size_classes)
qed

// (ms.stc_big with the code's choices as outcomes: the first i1, the
// class K)
theorem ms.stc_fin: all n c i1 k. n in omega -> int_le(n, 131052) -> !int_le(int_div(int_add(n, 3), 16), 9) -> c in omega ->
  mallocng_specs.clz_of(int_add(int_div(int_add(n, 3), 16), 1), c) ->
  (i1 = int_add(int_mul(4, int_sub(30, c)), 2) && int_lt(app(mallocng.size_classes, int_add(int_mul(4, int_sub(30, c)), 1)), int_add(int_div(int_add(n, 3), 16), 1))) ||
  (i1 = int_mul(4, int_sub(30, c)) && !int_lt(app(mallocng.size_classes, int_add(int_mul(4, int_sub(30, c)), 1)), int_add(int_div(int_add(n, 3), 16), 1))) ->
  (k = int_add(i1, 1) && int_lt(app(mallocng.size_classes, i1), int_add(int_div(int_add(n, 3), 16), 1))) ||
  (k = i1 && !int_lt(app(mallocng.size_classes, i1), int_add(int_div(int_add(n, 3), 16), 1))) ->
  mallocng_specs.class_of(n, k)
proof
  fix n c i1 k
  assume hn h131 hbig hc hz h1 h2
  have a1: int_lt(app(mallocng.size_classes, int_add(int_mul(4, int_sub(30, c)), 1)), int_add(int_div(int_add(n, 3), 16), 1)) -> i1 = int_add(int_mul(4, int_sub(30, c)), 2) by taut(h1)
  have a2: !int_lt(app(mallocng.size_classes, int_add(int_mul(4, int_sub(30, c)), 1)), int_add(int_div(int_add(n, 3), 16), 1)) -> i1 = int_mul(4, int_sub(30, c)) by taut(h1)
  have b1: int_lt(app(mallocng.size_classes, i1), int_add(int_div(int_add(n, 3), 16), 1)) -> k = int_add(i1, 1) by taut(h2)
  have b2: !int_lt(app(mallocng.size_classes, i1), int_add(int_div(int_add(n, 3), 16), 1)) -> k = i1 by taut(h2)
  show := apply(ms.stc_big, hn, h131, hbig, hc, hz, a1, a2, b1, b2)
qed

// (multiplying by 4: GIMPLE's signed product's low half, the unsigned one)
theorem ms.imul_4: tr.imul_by(4)
proof
  have g: all y. y in bits(32) -> bits_add(32, int_mul(sint(32, y), sint(32, 4)), 0) = bits_mul(32, y, 4) proof
    fix y
    assume hy: y in bits(32)
    have c1: int_lt(y, 2147483648) -> bits_add(32, int_mul(sint(32, y), 4), 0) = bits_mul(32, y, 4) proof
      assume hl: int_lt(y, 2147483648)
      show by defs(simp(hy, hl), bits_add, bits_mul, sint)
    qed
    have c2: !int_lt(y, 2147483648) -> bits_add(32, int_mul(sint(32, y), 4), 0) = bits_mul(32, y, 4) proof
      assume hl: !int_lt(y, 2147483648)
      have e: int_mod(int_mul(int_sub(y, 4294967296), 4), 4294967296) = int_mod(int_mul(y, 4), 4294967296) by arith(hy)
      show by defs(simp(hy, hl, e), bits_add, bits_mul, sint)
    qed
    have e: bits_add(32, int_mul(sint(32, y), 4), 0) = bits_mul(32, y, 4) by taut(c1, c2)
    show by simp(e)
  qed
  show by defs(g, tr.imul_by)
qed

// (a small non-negative word: its signed value itself)
theorem ms.sint_small: all v. v in omega -> int_lt(v, 2147483648) -> sint(32, v) = v
proof
  fix v
  assume hv hl
  have b: bits_of_int(32, v) = v by defs(arith(hv, hl), bits_of_int, pow2)
  show by defs(simp(b, hv, hl), sint, pow2)
qed

// size_to_class's contract from a_clz_32's: for every callee refining
// a_clz_32's spec (as a C function value), size_to_class's readable GIMPLE
// refines its spec
theorem ms.size_to_class_c2: all n g tbl. n in bits(64) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(app(g, regs), s, o) -> runs(app(mallocng_specs.a_clz_32_spec_fun(tbl), regs), s, o)) ->
  refines(c_src_malloc_mallocng_malloc.size_to_class(n, g), mallocng_specs.size_to_class_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, tbl, n), abi.World)
proof
  fix n g tbl
  assume hn hg
  show proof
    fix s o
    assume hw hr
    let SCT := c_src_malloc_mallocng_malloc.__malloc_size_classes
    let SC := mallocng.size_classes
    let SPEC := mallocng_specs.size_to_class_spec(SCT, tbl, n)
    let OVF := exc_val("stack_overflow", empty)
    have pu := apply(g.runs_univ, hr)
    have hu: s in univ(1) by simp(pu)
    have vV vfun vdom .. := apply(ms.world_parts, hw)
    have ss: fn_update(s, "vm", app(s, "vm")) = s := mp(fn_update_same[f := s, k := "vm"], vfun, vdom)
    have no: n in omega by simp(hn)
    let PRE := ((int_le(n, 131052) && mallocng_specs.table_ok(app(s, "vm"), app(s, "objs"), SCT, 2, SC)) && mallocng_specs.table_ok(app(s, "vm"), app(s, "objs"), tbl, 1, mallocng_specs.debruijn32_tab)) &&
      abi.thread_ok(app(s, "vm"), app(s, "fs_base"))
    have np: !PRE -> runs(SPEC, s, o) proof
      assume hn2
      show by simp(pu, hn2, keep(abi.overflow, mallocng_specs.table_ok, mallocng_specs.class_of, abi.thread_ok))
    qed
    have yp: PRE -> runs(SPEC, s, o) proof
      assume hp
      have h131 hsct htbl hth := hp
      // (the spec's outcomes: an overflow, any memory; a class of n)
      have sov: all v. v in x86_64_linux.Vm -> runs(SPEC, s, exc(fn_update(s, "vm", v), OVF)) proof
        fix v
        assume hv
        have vu := apply(x86.vm_univ, hv)
        have eu: OVF in univ(1) by defs(simp(), exc_val)
        have pu2: pair(s, exc(fn_update(s, "vm", v), OVF)) in univ(1) by simp(hu, vu, eu)
        have ovi := apply(ct.overflow_intro, hv, pu2)
        show by simp(hp, ovi, pu2, keep(abi.overflow, mallocng_specs.table_ok, mallocng_specs.class_of, abi.thread_ok))
      qed
      have sret: all c. c in bits(32) -> mallocng_specs.class_of(n, c) -> runs(SPEC, s, ok(s, c)) proof
        fix c
        assume hc hcl
        have pu2: pair(s, ok(s, c)) in univ(1) by simp(hu, hc)
        show by simp(hp, hc, hcl, pu2, keep(abi.overflow, mallocng_specs.table_ok, mallocng_specs.class_of, abi.thread_ok))
      qed
      // the locals' choices, then n's units Q
      // n's units Q
      let Q := bits_shr(64, bits_add(64, n, 3), 4)
      have p64: pow2(64) = 18446744073709551616 by simp()
      have p4: pow2(4) = 16 by simp()
      have m3: int_mod(int_add(n, 3), 18446744073709551616) = int_add(n, 3) by arith(no, h131)
      have ba: bits_add(64, n, 3) = int_add(n, 3) by defs(rewrite(sym(p64), m3), bits_add)
      have bo: bits_of_int(64, int_add(n, 3)) = int_add(n, 3) by defs(rewrite(sym(p64), m3), bits_of_int)
      have qe: Q = int_div(int_add(n, 3), 16) by defs(simp(ba, bo, p4), bits_shr)
      have qo: Q in omega by arith(qe, no)
      // at most 10 units: the class Q
      have small: int_le(Q, 9) -> runs(SPEC, s, o) proof
        assume hq
        step a3 a5 a7 a9 x13, oe from hr with hq
        have bq: bits_of_int(32, Q) = Q by defs(arith(qo, hq), bits_of_int, pow2)
        have cl := apply(ms.stc_small, no, rewrite(qe, hq))
        have r := mp(all_elim(sret, {Q}), arith(qo, hq), rewrite(sym(qe), cl))
        show := rewrite(sym(rewrite(bq, oe)), r)
      qed
      // more: a_clz_32 of the units N = Q + 1, the bucket's classes
      have big: !int_le(Q, 9) -> runs(SPEC, s, o) proof
        assume hq
        step a3 a5 a7 a9 x13, b from hr with hq
        let N := bits_add(64, Q, 1)
        have q131: int_le(Q, 8190) by arith(qe, no, h131)
        have mq: int_mod(int_add(Q, 1), 18446744073709551616) = int_add(Q, 1) by arith(qo, q131)
        have nq: N = int_add(Q, 1) by defs(rewrite(sym(p64), mq), bits_add)
        let X := bits_of_int(32, N)
        have p32: pow2(32) = 4294967296 by simp()
        have mx: int_mod(N, 4294967296) = N by arith(nq, qo, q131)
        have xn: X = N by defs(rewrite(sym(p32), mx), bits_of_int)
        have xb: X in bits(32) by simp()
        have xo: X in omega by simp()
        have x11: int_le(11, X) by arith(xn, nq, hq)
        have x8k: int_le(X, 8191) by arith(xn, nq, q131)
        have xnz: !(X = 0) by arith(x11, xo)
        // the call: a_clz_32's contract
        have qa: all regs o2. gc.regs_ok(regs, seq_one(gimple.arg(32, X))) -> runs(app(mallocng_specs.a_clz_32_spec_fun(tbl), regs), s, o2) ->
            (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(s, "vm", v), OVF)) || (ex r. o2 = ok(fn_update(s, "vm", app(s, "vm")), r) && mallocng_specs.clz_of(X, bits_of_int(32, fst(r)))) proof
          fix regs o2
          assume hro h2
          show := apply(ms.clzs_q, xb, hw, hu, xnz, htbl, hth, hro, h2)
        qed
        have ths: gc.sound(s) by simp(hth)
        have cc := apply(gc.contract_call1[R := r. mallocng_specs.clz_of(X, bits_of_int(32, fst(r)))], {g}, {mallocng_specs.a_clz_32_spec_fun(tbl)}, {seq_one(gimple.arg(32, X))}, {s}, {app(s, "vm")},
          ths, hw, vV, apply(gc.regs1_32_ex, xb), (int_le(seq_len(seq_one(gimple.arg(32, X))), 6) by simp()), hg, qa, b)
        have cov: (ex v. v in x86_64_linux.Vm && o = exc(fn_update(s, "vm", v), OVF)) -> runs(SPEC, s, o) proof
          assume h
          obtain v, hv ho from h
          show := rewrite(sym(ho), mp(all_elim(sov, {v}), hv))
        qed
        // the count C returned: the bucket's index I, its two lookups
        have cok: case 2 of cc proof
          assume h
          obtain r, hR hk from h
          let C := bits_of_int(32, fst(r))
          let I0 := int_mul(4, int_sub(30, C))
          let U := int_add(int_div(int_add(n, 3), 16), 1)
          have hk2 := rewrite(ss, hk)
          have cb: C in bits(32) by simp()
          have co: C in omega by simp()
          have c19 c28 := apply(ms.stc_bounds, xo, x11, x8k, co, hR)
          have ue: N = U by simp(nq, qe)
          have hRU: mallocng_specs.clz_of(U, C) := rewrite(ue, rewrite(xn, hR))
          have sctb: SCT in bits(64) by defs(simp(), c_src_malloc_mallocng_malloc.__malloc_size_classes)
          have sctnz: !(SCT = 0) by defs(simp(), c_src_malloc_mallocng_malloc.__malloc_size_classes)
          // 30 - C
          have b30: bits_of_int(32, 30) = 30 by simp()
          have sC := apply(ms.sint_small, co, (int_lt(C, 2147483648) by arith(c28, co)))
          have f1: tr.s32_fits(int_sub(sint(32, bits_of_int(32, 30)), sint(32, C))) by defs(simp(b30, sC, c19, c28, co), gimple.fits)
          have sd := apply(g.ssub32_det, {s}, {bits_of_int(32, 30)}, {C}, hu, simp(), cb, f1)
          let T4 := bits_sub(32, bits_of_int(32, 30), C)
          have m4: int_mod(int_sub(30, C), 4294967296) = int_sub(30, C) by arith(c28, co)
          have t4e: T4 = int_sub(30, C) by defs(simp(b30, rewrite(sym(p32), m4)), bits_sub)
          have t4b: T4 in bits(32) by simp()
          have sT0 := apply(ms.sint_small, (int_sub(30, C) in omega by arith(c28, co)), (int_lt(int_sub(30, C), 2147483648) by arith(co)))
          have sT: sint(32, T4) = int_sub(30, C) by simp(t4e, sT0)
          // I = 4 (30 - C)
          have f2: tr.s32_fits(int_mul(sint(32, T4), sint(32, 4))) by defs(simp(sT, c19, c28, co), gimple.fits)
          have md := apply(g.smul32_det, {s}, {T4}, {4}, hu, t4b, simp(), ms.imul_4, f2)
          let I := bits_mul(32, T4, 4)
          have mI: int_mod(int_mul(int_sub(30, C), 4), 4294967296) = I0 by arith(c19, c28, co)
          have ie: I = I0 by defs(simp(t4e, rewrite(sym(p32), mI)), bits_mul)
          have ib: I in bits(32) by simp()
          have sI0 := apply(ms.sint_small, (I0 in omega by arith(c28, co)), (int_lt(I0, 2147483648) by arith(co)))
          have sI: sint(32, I) = I0 by simp(ie, sI0)
          // I + 1, the first lookup
          have f3: tr.s32_fits(int_add(sint(32, I), sint(32, 1))) by defs(simp(sI, c19, c28, co), gimple.fits)
          have ad := apply(g.sadd32_det, {s}, {I}, {1}, hu, ib, simp(), f3)
          let I1 := bits_add(32, I, 1)
          have m1: int_mod(int_add(I0, 1), 4294967296) = int_add(I0, 1) by arith(c19, c28, co)
          have i1e: I1 = int_add(I0, 1) by defs(simp(ie, rewrite(sym(p32), m1)), bits_add)
          have i1b: I1 in bits(32) by simp()
          have sI10 := apply(ms.sint_small, (int_add(I0, 1) in omega by arith(c28, co)), (int_lt(int_add(I0, 1), 2147483648) by arith(co)))
          have sI1: sint(32, I1) = int_add(I0, 1) by simp(i1e, sI10)
          have rd1 ld1 := apply(ms.tab_rd, {s}, {SCT}, {I1}, {SC}, hu, sctb, sctnz, i1b, (int_le(0, sint(32, I1)) by arith(sI1, co, c28)),
            (int_lt(sint(32, I1), seq_len(SC)) by arith(sI1, ms.sc_len, c19, co)), hsct)
          step x17, hx17 hk17 from hk2 with sd, md, ad, rd1, ld1
          // (a table entry: a 16-bit value, itself)
          have p16: pow2(16) = 65536 by simp()
          have ent: all j. j in omega -> int_lt(j, 48) -> bits_of_int(16, app(SC, j)) = app(SC, j) proof
            fix j
            assume hj hj48
            have so sl := apply(ms.sc_nat, hj, hj48)
            have m: int_mod(app(SC, j), 65536) = app(SC, j) by arith(so, sl)
            show by defs(rewrite(sym(p16), m), bits_of_int)
          qed
          // the second lookup at J, and the class: J + 1 or J
          have fin: all J. J in bits(32) -> int_le(0, sint(32, J)) -> int_lt(sint(32, J), 48) -> x17 = ok(pair(s, pair(N, pair(J, pair(a5, pair(a7, a9))))), empty) ->
              (int_lt(app(SC, sint(32, J)), U) && o = ok(s, bits_add(32, J, 1))) || (!int_lt(app(SC, sint(32, J)), U) && o = ok(s, J)) proof
            fix J
            assume hJ hJ0 hJ48 hx
            let P := pair(s, pair(N, pair(J, pair(a5, pair(a7, a9)))))
            have os2 := all_elim(g.ok_state, {P}, {empty})
            have rd2 ld2 := apply(ms.tab_rd, {s}, {SCT}, {J}, {SC}, hu, sctb, sctnz, hJ, hJ0, (int_lt(sint(32, J), seq_len(SC)) by arith(hJ48, ms.sc_len)), hsct)
            step x24, hx24 hk24 from rewrite(hx, hk17) with rd2, ld2
            have ve := mp(all_elim(ent, {sint(32, J)}), (sint(32, J) in omega by arith(hJ0)), hJ48)
            have ve2: bits_of_int(16, app(SC, sint(32, J))) = app(SC, sint(32, J)) := ve
            have bB: int_lt(app(SC, sint(32, J)), U) -> o = ok(s, bits_add(32, J, 1)) proof
              assume hb
              have hb2: int_lt(bits_of_int(16, app(SC, sint(32, J))), N) by simp(hb, ve2, ue)
              have p1 := apply(g.pick, hx24, hb2, (!!int_lt(bits_of_int(16, app(SC, sint(32, J))), N) by taut(hb2)))
              have f4: tr.s32_fits(int_add(sint(32, J), sint(32, 1))) by defs(simp(hJ0, hJ48), gimple.fits)
              have ad2 := apply(g.sadd32_det, {s}, {J}, {1}, hu, hJ, simp(), f4)
              have e24 := apply(g.letin_e, apply(g.bind_inv, p1, ad2))
              show by simp(rewrite(e24, hk24))
            qed
            have bb: !int_lt(app(SC, sint(32, J)), U) -> o = ok(s, J) proof
              assume hb
              have hb2: !int_lt(bits_of_int(16, app(SC, sint(32, J))), N) by simp(hb, ve2, ue)
              have e24 := apply(g.pick2, hx24, hb2, hb2)
              show by simp(rewrite(e24, hk24))
            qed
            have cs: int_lt(app(SC, sint(32, J)), U) || !int_lt(app(SC, sint(32, J)), U) by taut()
            show by taut(cs, bB, bb)
          qed
          // the first comparison: J = I + 2 or I
          have v1: bits_of_int(16, app(SC, sint(32, I1))) = app(SC, int_add(I0, 1)) by simp(sI1, mp(all_elim(ent, {int_add(I0, 1)}), arith(co, c28), arith(co, c19)))
          have os := all_elim(g.ok_state, {pair(s, pair(Q, pair(a3, pair(a5, pair(a7, a9)))))}, {empty})
          // (the class K: J's outcome, a class of n)
          have done: all J. J in bits(32) -> int_le(0, sint(32, J)) -> int_lt(sint(32, J), 48) ->
              ((sint(32, J) = int_add(I0, 2) && int_lt(app(SC, int_add(I0, 1)), U)) || (sint(32, J) = I0 && !int_lt(app(SC, int_add(I0, 1)), U))) ->
              x17 = ok(pair(s, pair(N, pair(J, pair(a5, pair(a7, a9))))), empty) -> runs(SPEC, s, o) proof
            fix J
            assume hJ hJ0 hJ48 hj hx
            have fr := apply(fin, hJ, hJ0, hJ48, hx)
            have kA: int_lt(app(SC, sint(32, J)), U) && o = ok(s, bits_add(32, J, 1)) -> runs(SPEC, s, o) proof
              assume hc
              have hl ho := hc
              have mk: int_mod(int_add(sint(32, J), 1), 4294967296) = int_add(sint(32, J), 1) by arith(hJ0, hJ48)
              have sv: sint(32, J) = J || sint(32, J) = int_sub(J, 4294967296) by defs(simp(hJ), sint)
              have sJ: sint(32, J) = J by arith(sv, hJ0, hJ)
              have kv: bits_add(32, J, 1) = int_add(sint(32, J), 1) by defs(simp(sJ, rewrite(sym(p32), mk)), bits_add)
              have cl := apply(ms.stc_fin, {n}, {C}, {sint(32, J)}, {int_add(sint(32, J), 1)}, no, h131, rewrite(qe, hq), co, hRU, hj, (int_add(sint(32, J), 1) = int_add(sint(32, J), 1) && int_lt(app(SC, sint(32, J)), U) || (int_add(sint(32, J), 1) = sint(32, J) && !int_lt(app(SC, sint(32, J)), U)) by taut(hl, refl({int_add(sint(32, J), 1)}))))
              have r2 := mp(all_elim(sret, {bits_add(32, J, 1)}), simp(), rewrite(sym(kv), cl))
              show := rewrite(sym(ho), r2)
            qed
            have kB: !int_lt(app(SC, sint(32, J)), U) && o = ok(s, J) -> runs(SPEC, s, o) proof
              assume hc
              have hl ho := hc
              have sv: sint(32, J) = J || sint(32, J) = int_sub(J, 4294967296) by defs(simp(hJ), sint)
              have sJ: sint(32, J) = J by arith(sv, hJ0, hJ)
              have cl := apply(ms.stc_fin, {n}, {C}, {sint(32, J)}, {sint(32, J)}, no, h131, rewrite(qe, hq), co, hRU, hj, (sint(32, J) = int_add(sint(32, J), 1) && int_lt(app(SC, sint(32, J)), U) || (sint(32, J) = sint(32, J) && !int_lt(app(SC, sint(32, J)), U)) by taut(hl, refl({sint(32, J)}))))
              have r2 := mp(all_elim(sret, {J}), hJ, rewrite(sJ, cl))
              show := rewrite(sym(ho), r2)
            qed
            show by taut(fr, kA, kB)
          qed
          have bA: int_lt(app(SC, int_add(I0, 1)), U) -> runs(SPEC, s, o) proof
            assume hA
            have hA2: int_lt(bits_of_int(16, app(SC, sint(32, I1))), N) by simp(hA, v1, ue)
            have p1 := apply(g.pick, hx17, hA2, (!!int_lt(bits_of_int(16, app(SC, sint(32, I1))), N) by taut(hA2)))
            have f5: tr.s32_fits(int_add(sint(32, I), sint(32, 2))) by defs(simp(sI, c19, c28, co), gimple.fits)
            have ad3 := apply(g.sadd32_det, {s}, {I}, {2}, hu, ib, simp(), f5)
            let I2 := bits_add(32, I, 2)
            have e17 := apply(g.letin_e, apply(g.bind_inv, p1, ad3))
            have e17b: x17 = ok(pair(s, pair(N, pair(I2, pair(a5, pair(a7, a9))))), empty) by simp(e17, os)
            have m2: int_mod(int_add(I0, 2), 4294967296) = int_add(I0, 2) by arith(c19, c28, co)
            have i2e: I2 = int_add(I0, 2) by defs(simp(ie, rewrite(sym(p32), m2)), bits_add)
            have sI20 := apply(ms.sint_small, (int_add(I0, 2) in omega by arith(c28, co)), (int_lt(int_add(I0, 2), 2147483648) by arith(co)))
            have sI2: sint(32, I2) = int_add(I0, 2) by simp(i2e, sI20)
            show := apply(done, {I2}, simp(), arith(sI2, co, c28), arith(sI2, co, c19), (sint(32, I2) = int_add(I0, 2) && int_lt(app(SC, int_add(I0, 1)), U) || (sint(32, I2) = I0 && !int_lt(app(SC, int_add(I0, 1)), U)) by taut(sI2, hA)), e17b)
          qed
          have ba: !int_lt(app(SC, int_add(I0, 1)), U) -> runs(SPEC, s, o) proof
            assume ha
            have ha2: !int_lt(bits_of_int(16, app(SC, sint(32, I1))), N) by simp(ha, v1, ue)
            have e17 := apply(g.pick2, hx17, ha2, ha2)
            have e17b: x17 = ok(pair(s, pair(N, pair(I, pair(a5, pair(a7, a9))))), empty) by simp(e17, os)
            show := apply(done, {I}, ib, arith(sI, co, c28), arith(sI, co, c19), (sint(32, I) = int_add(I0, 2) && int_lt(app(SC, int_add(I0, 1)), U) || (sint(32, I) = I0 && !int_lt(app(SC, int_add(I0, 1)), U)) by taut(sI, ha)), e17b)
          qed
          have cA: int_lt(app(SC, int_add(I0, 1)), U) || !int_lt(app(SC, int_add(I0, 1)), U) by taut()
          show by taut(cA, bA, ba)
        qed
        show by taut(cc, cov, cok)
      qed
      have cq: int_le(Q, 9) || !int_le(Q, 9) by taut()
      show by taut(cq, small, big)
    qed
    show by taut(np, yp)
  qed
qed

// size_to_class as a C function value: its register wrapper refines the
// spec's (for every callee refining a_clz_32's)
theorem ms.size_to_class_fun_c2: all g tbl. (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(app(g, regs), s, o) -> runs(app(mallocng_specs.a_clz_32_spec_fun(tbl), regs), s, o)) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
    runs(app(c_src_malloc_mallocng_malloc.size_to_class_fun(g), regs), s, o) -> runs(app(mallocng_specs.size_to_class_spec_fun(c_src_malloc_mallocng_malloc.__malloc_size_classes, tbl), regs), s, o))
proof
  fix g tbl
  assume hg
  have hm: all regs. refines(c_src_malloc_mallocng_malloc.size_to_class(bits_of_int(64, app(regs, 0)), g), mallocng_specs.size_to_class_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, tbl, bits_of_int(64, app(regs, 0))), abi.World) proof
    fix regs
    show := mp(all_elim(ms.size_to_class_c2, {bits_of_int(64, app(regs, 0))}, {g}, {tbl}), simp(), hg)
  qed
  show by defs(apply(g.fun_res[n := 1, w := 32], hm), c_src_malloc_mallocng_malloc.size_to_class_fun, mallocng_specs.size_to_class_spec_fun, letin)
qed
