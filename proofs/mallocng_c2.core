// C2 of mallocng's internal functions: their readable GIMPLE refines their
// specs (layers/mallocng_specs.sl). A run of the code is inverted step by
// step (proofs/gimple_inv.core: each operation's one outcome), in the
// specs' vocabulary (rd64, wr64, word_ok); the spec's run is the outcome.
// The memory's reads and writes go by the memory rules (`step .. using`,
// `mem`), with the views and frames of proofs/mallocng_mem.core.
//
//   checked after proofs/translate_effects.core, proofs/gimple_inv.core and
//   proofs/mallocng_mem.core

// ----------------------------------------------------------------------
//  Addresses

// (a word's address: no wrap -- int_add the code's, bits_add the spec's)
theorem ms.addr: all p off. p in bits(64) -> off in bits(32) -> int_le(int_add(int_add(p, off), 8), int_pow(2, 64)) -> int_add(p, off) = bits_add(64, p, off)
proof
  fix p off
  assume hp ho hl
  show by arith(hp, ho, hl)
qed

// ----------------------------------------------------------------------
//  Worlds after a word written

theorem ms.world_wr: all s a v. s in abi.World -> s in univ(1) -> a in bits(64) ->
  fn_update(s, "vm", mallocng_specs.wr64(app(s, "vm"), a, v)) in abi.World && fn_update(s, "vm", mallocng_specs.wr64(app(s, "vm"), a, v)) in univ(1)
proof
  fix s a v
  assume hw hu ha
  have r := apply(tr.world_store, {s}, {a}, {8}, {v}, hw, hu, ha)
  show r
qed

// (a world's parts, for GIMPLE's stores)
theorem ms.world_parts: all s. s in abi.World -> mem: app(s, "vm") in x86_64_linux.Vm && record: is_fun(s) && has_vm: "vm" in dom(s) && bytes: app(app(s, "vm"), "bytes") in fn_space(bits(64), bits(8))
proof
  fix s
  assume h
  have wf := expand(h, abi.World)
  show by simp(wf)
qed

// ----------------------------------------------------------------------
//  The accessors' runs: one outcome each (the word defined)

theorem ms.ld_det: all s p off. s in univ(1) -> p in bits(64) -> off in bits(32) -> mallocng_specs.word_ok(app(s, "vm"), app(s, "objs"), p, off) ->
  g.det(gimple.ld64(p, off), s, ok(s, mallocng_specs.rd64(app(s, "vm"), bits_add(64, p, off))))
proof
  fix s p off
  assume hs hp ho hk
  have nz lt ur uw := hk
  have ea := apply(ms.addr, {p}, {off}, hp, ho, lt)
  have md: g.mem_defined(s, p, off, 8, false) by simp(nz, lt, ur, hp, ho)
  have ld := apply(g.ld64_det, {s}, {p}, {off}, hs, hp, ho, md)
  show rewrite(ea, ld)
qed

theorem ms.st_det: all s p off v. s in abi.World -> s in univ(1) -> p in bits(64) -> off in bits(32) -> mallocng_specs.word_ok(app(s, "vm"), app(s, "objs"), p, off) ->
  g.det(gimple.st64(p, off, v), s, ok(fn_update(s, "vm", mallocng_specs.wr64(app(s, "vm"), bits_add(64, p, off), v)), empty))
proof
  fix s p off v
  assume hw hs hp ho hk
  have nz lt ur uw := hk
  have ea := apply(ms.addr, {p}, {off}, hp, ho, lt)
  have md: g.mem_defined(s, p, off, 8, true) by simp(nz, lt, uw, hp, ho)
  have pv pf pd .. := apply(ms.world_parts, hw)
  have st := apply(g.st64_det, {s}, {p}, {off}, {v}, hs, hp, ho, md, pv, pf, pd)
  show rewrite(ea, st)
qed

theorem ms.next_det: all s m. s in univ(1) -> m in bits(64) -> mallocng_specs.word_ok(app(s, "vm"), app(s, "objs"), m, 8) ->
  g.det(c_src_malloc_mallocng_malloc.meta_next(m), s, ok(s, mallocng_specs.mnext(app(s, "vm"), m)))
proof
  fix s m
  assume hs hm hk
  have d := apply(ms.ld_det, {s}, {m}, {8}, hs, hm, simp(), hk)
  show apply(g.ret_det, d)
qed

theorem ms.prev_det: all s m. s in univ(1) -> m in bits(64) -> mallocng_specs.word_ok(app(s, "vm"), app(s, "objs"), m, 0) ->
  g.det(c_src_malloc_mallocng_malloc.meta_prev(m), s, ok(s, mallocng_specs.mprev(app(s, "vm"), m)))
proof
  fix s m
  assume hs hm hk
  have d := apply(ms.ld_det, {s}, {m}, {0}, hs, hm, simp(), hk)
  have z: bits_add(64, m, 0) = m by simp(hm)
  show apply(g.ret_det, rewrite(z, d))
qed

theorem ms.setnext_det: all s p v. s in abi.World -> s in univ(1) -> p in bits(64) -> mallocng_specs.word_ok(app(s, "vm"), app(s, "objs"), p, 8) ->
  g.det(c_src_malloc_mallocng_malloc.set_meta_next(p, v), s, ok(fn_update(s, "vm", mallocng_specs.wr64(app(s, "vm"), bits_add(64, p, 8), v)), empty))
proof
  fix s p v
  assume hw hs hp hk
  have d := apply(ms.st_det, {s}, {p}, {8}, {v}, hw, hs, hp, simp(), hk)
  show apply(g.unit_det, d)
qed

theorem ms.setprev_det: all s p v. s in abi.World -> s in univ(1) -> p in bits(64) -> mallocng_specs.word_ok(app(s, "vm"), app(s, "objs"), p, 0) ->
  g.det(c_src_malloc_mallocng_malloc.set_meta_prev(p, v), s, ok(fn_update(s, "vm", mallocng_specs.wr64(app(s, "vm"), p, v)), empty))
proof
  fix s p v
  assume hw hs hp hk
  have d := apply(ms.st_det, {s}, {p}, {0}, {v}, hw, hs, hp, simp(), hk)
  have z: bits_add(64, p, 0) = p by simp(hp)
  show apply(g.unit_det, rewrite(z, d))
qed

// ----------------------------------------------------------------------
//  Worlds as the code writes them: s with its memory X

// (a world written again: one update)
theorem ms.upd: all s X a v. fn_update(fn_update(s, "vm", X), "vm", mallocng_specs.wr64(app(fn_update(s, "vm", X), "vm"), a, v)) = fn_update(s, "vm", mallocng_specs.wr64(X, a, v))
proof
  fix s X a v
  have t := fn_update_twice[f := s, k := "vm", a := X, b := mallocng_specs.wr64(X, a, v)]
  show by simp(t)
qed

// (s with its memory X, X then written: a world, its memory's facts)
theorem ms.sw: all s X a v. fn_update(s, "vm", X) in abi.World -> fn_update(s, "vm", X) in univ(1) -> a in bits(64) ->
  fn_update(s, "vm", mallocng_specs.wr64(X, a, v)) in abi.World && fn_update(s, "vm", mallocng_specs.wr64(X, a, v)) in univ(1)
proof
  fix s X a v
  assume hw hu ha
  have r := apply(ms.world_wr, {fn_update(s, "vm", X)}, {a}, {v}, hw, hu, ha)
  show by simp(rewrite(all_elim(ms.upd, {s}, {X}, {a}, {v}), r))
qed

// (the memory procedure's closures: a world written is a world)
mem_closure ms.world_wr
mem_closure ms.sw

// (an 8-aligned word's successor's address: aligned, no wrap)
theorem ms.al8_add: all p. p in bits(64) -> mallocng_specs.al8(p) -> int_le(int_add(int_add(p, 8), 8), int_pow(2, 64)) ->
  mallocng_specs.al8(bits_add(64, p, 8)) && bits_add(64, p, 8) = int_add(p, 8) && bits_add(64, p, 8) in bits(64)
proof
  fix p
  assume hp ha hl
  have a8 := expand(ha, mallocng_specs.al8)
  show by defs(arith(a8, hp, hl), mallocng_specs.al8)
qed

// ----------------------------------------------------------------------
//  dequeue

// m alone (its next itself): the head cleared, m's links cleared
theorem ms.dq_alone: all phead m s o. phead in bits(64) -> m in bits(64) -> s in abi.World -> s in univ(1) ->
  mallocng_specs.dequeue_pre(app(s, "vm"), app(s, "objs"), phead, m) -> m = mallocng_specs.mnext(app(s, "vm"), m) ->
  runs(c_src_malloc_mallocng_malloc.dequeue(phead, m), s, o) ->
  o = ok(fn_update(s, "vm", mallocng_specs.wr64(mallocng_specs.wr64(mallocng_specs.wr64(app(s, "vm"), phead, 0), bits_add(64, m, 8), 0), m, 0)), empty)
proof
  fix phead m s o
  assume hph hm hw hu hpre heq hr
  have kh km0 km8 ah am nhm nhm8 .. := hpre
  have _ mlt .. := km8
  have am8 em8 hm8 := apply(ms.al8_add, {m}, hm, am, mlt)
  have zp: bits_add(64, phead, 0) = phead by simp(hph)
  // t1 := m.next, the branch not taken; *phead := 0; m.next := 0; t8 := m.next; m.prev := t8
  have F := conj(hw, hu, hm, hph, hm8, kh, km0, km8, expand(ah, mallocng_specs.al8), expand(am, mallocng_specs.al8), mlt, nhm, nhm8, zp)
  step x5, c from hr with ms.next_det, heq, ms.st_det, ms.setnext_det, ms.next_det, ms.setprev_det using F
  show by simp(c, zp)
qed

// m linked (its next another meta): the neighbours linked to each other,
// the head moved past m if it was m, m's links cleared
theorem ms.dq_linked: all phead m s o. phead in bits(64) -> m in bits(64) -> s in abi.World -> s in univ(1) ->
  mallocng_specs.dequeue_pre(app(s, "vm"), app(s, "objs"), phead, m) -> !(m = mallocng_specs.mnext(app(s, "vm"), m)) ->
  runs(c_src_malloc_mallocng_malloc.dequeue(phead, m), s, o) ->
  o = ok(fn_update(s, "vm", mallocng_specs.dequeue_vm(app(s, "vm"), phead, m)), empty)
proof
  fix phead m s o
  assume hph hm hw hu hpre hne hr
  let V0 := app(s, "vm")
  let N := mallocng_specs.mnext(V0, m)
  let P := mallocng_specs.mprev(V0, m)
  let M8 := bits_add(64, m, 8)
  let H := mallocng_specs.rd64(V0, phead)
  have kh km0 km8 ah am nhm nhm8 hl := hpre
  have nNm: !(N = m) by taut(hne)
  have kp8 kn0 ap an npm np8m nn8 np8h nnh np8n := mp(hl, nNm)
  have hP: P in bits(64) by defs(simp(), mallocng_specs.mprev, mallocng_specs.rd64)
  have hN: N in bits(64) by defs(simp(), mallocng_specs.mnext, mallocng_specs.rd64)
  have _ plt .. := kp8
  have _ mlt .. := km8
  have apa epa hpa := apply(ms.al8_add, {P}, hP, ap, plt)
  have am8 em8 hm8 := apply(ms.al8_add, {m}, hm, am, mlt)
  have zp: bits_add(64, phead, 0) = phead by simp(hph)
  // (the facts the memory steps use)
  have F := conj(hw, hu, hm, hph, hP, hN, hpa, hm8, kh, km0, km8, kp8, kn0, expand(ah, mallocng_specs.al8), expand(am, mallocng_specs.al8), expand(ap, mallocng_specs.al8), expand(an, mallocng_specs.al8), mlt, plt, nhm, nhm8, npm, np8m, nn8, np8h, nnh, np8n)
  step x5, c from hr with ms.next_det, hne, ms.prev_det, ms.next_det, ms.setnext_det, ms.next_det, ms.prev_det, ms.setprev_det, ms.ld_det using F
  let V2 := mallocng_specs.wr64(mallocng_specs.wr64(V0, bits_add(64, P, 8), N), N, P)
  have r2: mallocng_specs.rd64(V2, phead) = H by mem(F)
  // the spec's effect: m's neighbours linked, then the head moved past m if it was m
  have dl: mallocng_specs.dq_links(V0, phead, m) = V2 by defs(mp(tr.ite_t[c := !(N = m), a := V2, b := mallocng_specs.wr64(V0, phead, 0)], nNm), mallocng_specs.dq_links)
  have d0: mallocng_specs.dequeue_vm(V0, phead, m) = mallocng_specs.wr64(mallocng_specs.wr64(mallocng_specs.dq_head(mallocng_specs.dq_links(V0, phead, m), V0, phead, m), M8, 0), m, 0)
    by defs(refl({mallocng_specs.wr64(mallocng_specs.wr64(mallocng_specs.dq_head(mallocng_specs.dq_links(V0, phead, m), V0, phead, m), M8, 0), m, 0)}), mallocng_specs.dequeue_vm)
  have dv := rewrite(dl, d0)
  have was: m = H -> o = ok(fn_update(s, "vm", mallocng_specs.dequeue_vm(V0, phead, m)), empty) proof
    assume hmh
    step x25, d from rewrite(zp, c) with hmh, ms.next_det, ms.st_det, ms.setnext_det, ms.next_det, ms.setprev_det using F, zp
    have hc: m = mallocng_specs.rd64(V2, phead) := trans(hmh, sym(r2))
    have dh: mallocng_specs.dq_head(V2, V0, phead, m) = mallocng_specs.wr64(V2, phead, N) by defs(mp(tr.ite_t[c := !(N = m) && mallocng_specs.rd64(V2, phead) = m, a := mallocng_specs.wr64(V2, phead, N), b := V2], conj(nNm, sym(hc))), mallocng_specs.dq_head)
    have qv := rewrite(dh, dv)
    show by simp(d, qv, zp)
  qed
  have wasnt: !(m = H) -> o = ok(fn_update(s, "vm", mallocng_specs.dequeue_vm(V0, phead, m)), empty) proof
    assume hmh
    step x25, d from rewrite(zp, c) with hmh, ms.setnext_det, ms.next_det, ms.setprev_det using F
    have hc: !(m = mallocng_specs.rd64(V2, phead)) := rewrite(sym(r2), hmh)
    have dh: mallocng_specs.dq_head(V2, V0, phead, m) = V2 by defs(mp(tr.ite_f[c := !(N = m) && mallocng_specs.rd64(V2, phead) = m, a := mallocng_specs.wr64(V2, phead, N), b := V2], (!(!(N = m) && mallocng_specs.rd64(V2, phead) = m) by taut(hc))), mallocng_specs.dq_head)
    have qv := rewrite(dh, dv)
    show by simp(d, qv)
  qed
  show by taut(was, wasnt)
qed

// dequeue's run, its precondition holding: its effect `dequeue_vm` (m
// alone: the head word cleared, then m's links)
theorem ms.dq_run: all phead m s o. phead in bits(64) -> m in bits(64) -> s in abi.World -> s in univ(1) ->
  mallocng_specs.dequeue_pre(app(s, "vm"), app(s, "objs"), phead, m) ->
  runs(c_src_malloc_mallocng_malloc.dequeue(phead, m), s, o) ->
  o = ok(fn_update(s, "vm", mallocng_specs.dequeue_vm(app(s, "vm"), phead, m)), empty)
proof
  fix phead m s o
  assume hph hm hw hu hp hr
  let V0 := app(s, "vm")
  let N := mallocng_specs.mnext(V0, m)
  let M8 := bits_add(64, m, 8)
  have alone: m = N -> o = ok(fn_update(s, "vm", mallocng_specs.dequeue_vm(V0, phead, m)), empty) proof
    assume e
    have oe := apply(ms.dq_alone, {phead}, {m}, {s}, {o}, hph, hm, hw, hu, hp, e, hr)
    have nn: !!(N = m) by taut(e)
    have nc: !(!(N = m) && mallocng_specs.rd64(mallocng_specs.wr64(V0, phead, 0), phead) = m) by taut(nn)
    have dl: mallocng_specs.dq_links(V0, phead, m) = mallocng_specs.wr64(V0, phead, 0)
      by defs(mp(tr.ite_f[c := !(N = m), a := mallocng_specs.wr64(mallocng_specs.wr64(V0, bits_add(64, mallocng_specs.mprev(V0, m), 8), N), N, mallocng_specs.mprev(V0, m)),
        b := mallocng_specs.wr64(V0, phead, 0)], nn), mallocng_specs.dq_links)
    have dh: mallocng_specs.dq_head(mallocng_specs.wr64(V0, phead, 0), V0, phead, m) = mallocng_specs.wr64(V0, phead, 0)
      by defs(mp(tr.ite_f[c := !(N = m) && mallocng_specs.rd64(mallocng_specs.wr64(V0, phead, 0), phead) = m, a := mallocng_specs.wr64(mallocng_specs.wr64(V0, phead, 0), phead, N),
        b := mallocng_specs.wr64(V0, phead, 0)], nc), mallocng_specs.dq_head)
    have d0: mallocng_specs.dequeue_vm(V0, phead, m) = mallocng_specs.wr64(mallocng_specs.wr64(mallocng_specs.dq_head(mallocng_specs.dq_links(V0, phead, m), V0, phead, m), M8, 0), m, 0)
      by defs(refl({mallocng_specs.wr64(mallocng_specs.wr64(mallocng_specs.dq_head(mallocng_specs.dq_links(V0, phead, m), V0, phead, m), M8, 0), m, 0)}), mallocng_specs.dequeue_vm)
    have dv := rewrite(dh, rewrite(dl, d0))
    show := rewrite(sym(dv), oe)
  qed
  have linked: !(m = N) -> o = ok(fn_update(s, "vm", mallocng_specs.dequeue_vm(V0, phead, m)), empty) proof
    assume e
    show := apply(ms.dq_linked, {phead}, {m}, {s}, {o}, hph, hm, hw, hu, hp, e, hr)
  qed
  show by taut(alone, linked)
qed

// (memories after words written: memories)
theorem ms.wr_vm: all vm a v. vm in x86_64_linux.Vm -> vm in univ(1) -> a in bits(64) ->
  mallocng_specs.wr64(vm, a, v) in x86_64_linux.Vm && mallocng_specs.wr64(vm, a, v) in univ(1)
proof
  fix vm a v
  assume hv hu ha
  have su := apply(g.store_univ, {vm}, {a}, {8}, {v}, hv)
  have nu: fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, 8, v)) in univ(1) by simp(hu, su)
  have nv := apply(x86.store_vm, {vm}, {a}, {8}, {v}, hv, nu)
  show conj(nv, nu)
qed

theorem ms.dqvm_vm: all vm phead m. vm in x86_64_linux.Vm -> vm in univ(1) -> phead in bits(64) -> m in bits(64) ->
  mem: mallocng_specs.dequeue_vm(vm, phead, m) in x86_64_linux.Vm && small: mallocng_specs.dequeue_vm(vm, phead, m) in univ(1)
proof
  fix vm phead m
  assume hv hu hph hm
  let N := mallocng_specs.mnext(vm, m)
  let P := mallocng_specs.mprev(vm, m)
  have hN: N in bits(64) by defs(simp(), mallocng_specs.mnext, mallocng_specs.rd64)
  have hP: P in bits(64) by defs(simp(), mallocng_specs.mprev, mallocng_specs.rd64)
  have hP8: bits_add(64, P, 8) in bits(64) by arith(hP)
  have hm8: bits_add(64, m, 8) in bits(64) by arith(hm)
  have a1 a2 := apply(ms.wr_vm, {vm}, {bits_add(64, P, 8)}, {N}, hv, hu, hP8)
  have b1 b2 := apply(ms.wr_vm, {mallocng_specs.wr64(vm, bits_add(64, P, 8), N)}, {N}, {P}, a1, a2, hN)
  have c1 c2 := apply(ms.wr_vm, {vm}, {phead}, {0}, hv, hu, hph)
  let L := mallocng_specs.dq_links(vm, phead, m)
  have l1: L in x86_64_linux.Vm by apply(ite_in, b1, c1)
  have l2: L in univ(1) by apply(ite_in, b2, c2)
  have d1 d2 := apply(ms.wr_vm, {L}, {phead}, {N}, l1, l2, hph)
  let H := mallocng_specs.dq_head(L, vm, phead, m)
  have h1: H in x86_64_linux.Vm by apply(ite_in, d1, l1)
  have h2: H in univ(1) by apply(ite_in, d2, l2)
  have e1 e2 := apply(ms.wr_vm, {H}, {bits_add(64, m, 8)}, {0}, h1, h2, hm8)
  have f1 f2 := apply(ms.wr_vm, {mallocng_specs.wr64(H, bits_add(64, m, 8), 0)}, {m}, {0}, e1, e2, hm)
  show conj(f1, f2)
qed

// ----------------------------------------------------------------------
//  queue

// m unlinked (else a_crash, which the precondition excludes): the list
// empty -- m alone, the head --, or m before the head H, after H's prev P
theorem ms.qu_run: all phead m g s o. phead in bits(64) -> m in bits(64) -> s in abi.World -> s in univ(1) ->
  mallocng_specs.queue_pre(app(s, "vm"), app(s, "objs"), phead, m) ->
  runs(c_src_malloc_mallocng_malloc.queue(phead, m, g), s, o) ->
  o = ok(fn_update(s, "vm", mallocng_specs.queue_vm(app(s, "vm"), phead, m)), empty)
proof
  fix phead m g s o
  assume hph hm hw hu hpre hr
  let V0 := app(s, "vm")
  let OB := app(s, "objs")
  let M8 := bits_add(64, m, 8)
  let H := mallocng_specs.rd64(V0, phead)
  have kh km0 km8 ah am n0 p0 hl := hpre
  have hH: H in bits(64) by defs(simp(), mallocng_specs.rd64)
  have _ mlt .. := km8
  have am8 em8 hm8 := apply(ms.al8_add, {m}, hm, am, mlt)
  have zp: bits_add(64, phead, 0) = phead by simp(hph)
  // m's links 0 (no a_crash), then *phead
  have d0 := apply(ms.next_det, {s}, {m}, hu, hm, km8)
  have d1 := apply(ms.prev_det, {s}, {m}, hu, hm, km0)
  have d2 := rewrite(zp, apply(ms.ld_det, {s}, {phead}, {0}, hu, hph, simp(), kh))
  step x2 x7 x11 x15, hc3 hrest3 from hr with d0, n0, d1, p0, d2
  // the list empty: m alone, the head
  have emp: H = 0 -> o = ok(fn_update(s, "vm", mallocng_specs.queue_vm(V0, phead, m)), empty) proof
    assume hz
    step c4 from conj(hc3, hrest3) with hz, ms.setnext_det, ms.next_det, ms.setprev_det, ms.st_det using hw, hu, hm, hph, hm8, km0, km8, kh, expand(am, mallocng_specs.al8), expand(ah, mallocng_specs.al8), mlt, n0, p0, zp
    have qv: mallocng_specs.queue_vm(V0, phead, m) = mallocng_specs.wr64(mallocng_specs.wr64(mallocng_specs.wr64(V0, M8, m), m, m), phead, m) by defs(simp(hz), mallocng_specs.queue_vm)
    show by simp(c4, qv, zp)
  qed
  have lnk: !(H = 0) -> o = ok(fn_update(s, "vm", mallocng_specs.queue_vm(V0, phead, m)), empty) proof
    assume nn
    let P := mallocng_specs.mprev(V0, H)
    let PA := bits_add(64, P, 8)
    have kH0 aH kP8 aP nHm8 nPm := mp(hl, nn)
    have hP: P in bits(64) by defs(simp(), mallocng_specs.mprev, mallocng_specs.rd64)
    have _ plt .. := kP8
    have apa epa hpa := apply(ms.al8_add, {P}, hP, aP, plt)
    step c9 from conj(hc3, hrest3) with nn, d2, ms.setnext_det, ms.prev_det, ms.setprev_det, ms.prev_det, ms.setnext_det, ms.next_det, ms.next_det, ms.setprev_det using hw, hu, hm, hH, hP, hm8, hpa, km0, km8, kH0, kP8, expand(am, mallocng_specs.al8), expand(aH, mallocng_specs.al8), expand(aP, mallocng_specs.al8), mlt, plt, nHm8, nPm
    have qv: mallocng_specs.queue_vm(V0, phead, m) = mallocng_specs.wr64(mallocng_specs.wr64(mallocng_specs.wr64(mallocng_specs.wr64(V0, M8, H), m, P), PA, m), H, m) by defs(simp(nn), mallocng_specs.queue_vm)
    show by simp(c9, qv)
  qed
  show by taut(emp, lnk)
qed

// (queue's memory after: a memory)
theorem ms.quvm_vm: all vm phead m. vm in x86_64_linux.Vm -> vm in univ(1) -> phead in bits(64) -> m in bits(64) ->
  mem: mallocng_specs.queue_vm(vm, phead, m) in x86_64_linux.Vm && small: mallocng_specs.queue_vm(vm, phead, m) in univ(1)
proof
  fix vm phead m
  assume hv hu hph hm
  let H := mallocng_specs.rd64(vm, phead)
  let P := mallocng_specs.mprev(vm, H)
  have hH: H in bits(64) by defs(simp(), mallocng_specs.rd64)
  have hP: P in bits(64) by defs(simp(), mallocng_specs.mprev, mallocng_specs.rd64)
  have hP8: bits_add(64, P, 8) in bits(64) by arith(hP)
  have hm8: bits_add(64, m, 8) in bits(64) by arith(hm)
  have a1 a2 := apply(ms.wr_vm, {vm}, {bits_add(64, m, 8)}, {H}, hv, hu, hm8)
  have b1 b2 := apply(ms.wr_vm, {mallocng_specs.wr64(vm, bits_add(64, m, 8), H)}, {m}, {P}, a1, a2, hm)
  have c1 c2 := apply(ms.wr_vm, {mallocng_specs.wr64(mallocng_specs.wr64(vm, bits_add(64, m, 8), H), m, P)}, {bits_add(64, P, 8)}, {m}, b1, b2, hP8)
  have d1 d2 := apply(ms.wr_vm, {mallocng_specs.wr64(mallocng_specs.wr64(mallocng_specs.wr64(vm, bits_add(64, m, 8), H), m, P), bits_add(64, P, 8), m)}, {H}, {m}, c1, c2, hH)
  have e1 e2 := apply(ms.wr_vm, {vm}, {bits_add(64, m, 8)}, {m}, hv, hu, hm8)
  have f1 f2 := apply(ms.wr_vm, {mallocng_specs.wr64(vm, bits_add(64, m, 8), m)}, {m}, {m}, e1, e2, hm)
  have g1 g2 := apply(ms.wr_vm, {mallocng_specs.wr64(mallocng_specs.wr64(vm, bits_add(64, m, 8), m), m, m)}, {phead}, {m}, f1, f2, hph)
  have q1: mallocng_specs.queue_vm(vm, phead, m) in x86_64_linux.Vm by defs(apply(ite_in, d1, g1), mallocng_specs.queue_vm)
  have q2: mallocng_specs.queue_vm(vm, phead, m) in univ(1) by defs(apply(ite_in, d2, g2), mallocng_specs.queue_vm)
  show conj(q1, q2)
qed

// ----------------------------------------------------------------------
//  size_to_class: from a_clz_32's contract (a_clz_32's own C2:
//  proofs/mallocng_bits.core)

// (a word not 0 has a leading-zero count: the least k with x < 2^k, then r = 32 - k)
theorem ms.clz_exists: all x. x in bits(32) -> !(x = 0) -> ex r. r in bits(32) && mallocng_specs.clz_of(x, r)
proof
  fix x
  assume hx hnz
  have p32: int_lt(x, pow2(32)) by simp(hx)
  have ex0: ex k. k in omega && int_lt(x, pow2(k)) by ex_intro({32}, taut((32 in omega by simp()), p32))
  obtain k, ko kl kmin from mp(nat_least[p := k. int_lt(x, pow2(k))], ex0)
  have k32: int_le(k, 32) := mp(all_elim(kmin, {32}), simp(), p32)
  have k1: int_le(1, k) proof
    have c: k = 0 -> false proof
      assume e
      have l := rewrite(e, kl)
      have p0: pow2(0) = 1 by simp()
      show by arith(rewrite(p0, l), hx, hnz)
    qed
    show by arith(c, ko)
  qed
  let j := int_sub(k, 1)
  have jo: j in omega by arith(ko, k1)
  have nj: !int_lt(x, pow2(j)) proof
    have c: int_lt(x, pow2(j)) -> false proof
      assume h
      have le := mp(all_elim(kmin, {j}), jo, h)
      show by arith(le, k1)
    qed
    show by taut(c)
  qed
  let r := int_sub(32, k)
  have e1: int_sub(31, r) = j by arith(ko)
  have e2: int_sub(32, r) = k by arith(ko)
  have rb: r in bits(32) by arith(ko, k1, k32)
  have g1: int_lt(r, 32) by arith(k1, ko)
  have g2: int_le(int_pow(2, int_sub(k, 1)), x) by arith(expand(nj, pow2))
  have g3: int_lt(x, int_pow(2, k)) := expand(kl, pow2)
  have c: mallocng_specs.clz_of(x, r) by defs(simp(e1, e2, g1, g2, g3), mallocng_specs.clz_of)
  show by ex_intro({r}, taut(rb, c))
qed

// a_clz_32's spec, its precondition holding: an overflow, or x's leading
// zeros returned, the world as it was
theorem ms.clz_spec_inv: all tbl x s o. x in bits(32) -> s in abi.World -> !(x = 0) ->
  mallocng_specs.table_ok(app(s, "vm"), app(s, "objs"), tbl, 1, mallocng_specs.debruijn32_tab) -> abi.thread_ok(app(s, "vm"), app(s, "fs_base")) ->
  runs(mallocng_specs.a_clz_32_spec(tbl, x), s, o) ->
  (ex v. v in x86_64_linux.Vm && o = exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty))) || (ex r. r in bits(32) && mallocng_specs.clz_of(x, r) && o = ok(s, r))
proof
  fix tbl x s o
  assume hx hw hnz htb hth h
  have ce := apply(ms.clz_exists, hx, hnz)
  have vv: ex y. y in x86_64_linux.Vm by ex_intro({app(s, "vm")}, simp(expand(hw, abi.World)))
  show by simp(h, hnz, htb, hth, ce, vv, keep(mallocng_specs.table_ok, mallocng_specs.clz_of, abi.thread_ok))
qed

// a_clz_32's contract at a call a_clz_32(x) (its spec's register wrapper,
// on a world where its precondition holds): an overflow (the memory any),
// or the return, the memory as it was, the first register's low half x's
// leading zeros
theorem ms.clzs_q: all regs s tbl x o2. x in bits(32) -> s in abi.World -> s in univ(1) ->
  !(x = 0) -> mallocng_specs.table_ok(app(s, "vm"), app(s, "objs"), tbl, 1, mallocng_specs.debruijn32_tab) -> abi.thread_ok(app(s, "vm"), app(s, "fs_base")) ->
  gc.regs_ok(regs, seq_one(gimple.arg(32, x))) ->
  runs(app(mallocng_specs.a_clz_32_spec_fun(tbl), regs), s, o2) ->
  (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex r. o2 = ok(fn_update(s, "vm", app(s, "vm")), r) && mallocng_specs.clz_of(x, bits_of_int(32, fst(r))))
proof
  fix regs s tbl x o2
  assume hx hw hu hnz htb hth hr h
  let OVF := exc_val("stack_overflow", empty)
  have rl rn r0 := apply(gc.regs1_32, hx, hr)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, mallocng_specs.a_clz_32_spec_fun, app_fn_build, ra in h
  have vfun: is_fun(s) by simp(expand(hw, abi.World))
  have vdom: "vm" in dom(s) by simp(expand(hw, abi.World))
  have ss: fn_update(s, "vm", app(s, "vm")) = s := mp(fn_update_same[f := s, k := "vm"], vfun, vdom)
  let G := (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(s, "vm", v), OVF)) || (ex r. o2 = ok(fn_update(s, "vm", app(s, "vm")), r) && mallocng_specs.clz_of(x, bits_of_int(32, fst(r))))
  // (one argument: the spec's run)
  have o1: ord_le(1, seq_len(regs)) by defs(simp(rn), ord_le)
  have b := rewrite(r0, apply(g.runs_elim, h))
  have b2: bind_rel(mallocng_specs.a_clz_32_spec(tbl, x), s, x3 x4. letin(x4, x5. bind_rel(gimple.result(32, x5), x3, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. o2 = ok(x6, pair(x8, x9)))),
      x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))), x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3)) by taut(b, o1)
  obtain o3, hs3 hk3 from expand(b2, bind_rel)
  have ci := apply(ms.clz_spec_inv, hx, hw, hnz, htb, hth, hs3)
  have c1: (ex v. v in x86_64_linux.Vm && o3 = exc(fn_update(s, "vm", v), OVF)) -> G proof
    assume e
    obtain v, hv he from e
    have oe: o2 = exc(fn_update(s, "vm", v), OVF) by simp(rewrite(he, hk3))
    have l: ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(s, "vm", v), OVF) by ex_intro({v}, taut(hv, oe))
    show by taut(l)
  qed
  have c2: (ex r. r in bits(32) && mallocng_specs.clz_of(x, r) && o3 = ok(s, r)) -> G proof
    assume e
    obtain r, hr32 hc he from e
    have k1: bind_rel(gimple.result(32, r), s, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. o2 = ok(x6, pair(x8, x9)))), x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))
      by simp(expand(rewrite(he, hk3), letin), keep(bind_rel, gimple.result))
    obtain o4, hr4 hk4 from expand(k1, bind_rel)
    obtain u, hu64 hlow ho4 from apply(g.result32_inv, hr32, hr4)
    have k2: any_rel(x9. x9 in bits(64), x9. o2 = ok(s, pair(u, x9))) by simp(expand(rewrite(ho4, hk4), letin), keep(any_rel))
    have ne: ex y. y in bits(64) by ex_intro({0}, simp())
    obtain y, hy hoy from apply(g.any_e, ne, k2)
    have cl: mallocng_specs.clz_of(x, bits_of_int(32, fst(pair(u, y)))) by simp(hlow, hc)
    have l: ex r. o2 = ok(fn_update(s, "vm", app(s, "vm")), r) && mallocng_specs.clz_of(x, bits_of_int(32, fst(r))) by ex_intro({pair(u, y)}, taut(rewrite(sym(ss), hoy), cl))
    show by taut(l)
  qed
  show by taut(ci, c1, c2)
qed

// ----------------------------------------------------------------------
//  A table's entry i (2 bytes each, at t; table_ok): its address
//  (GIMPLE's elem with the index sign-extended) and the load's one
//  outcome, the list's entry

theorem ms.tab_rd: all s t I tab. s in univ(1) -> t in bits(64) -> !(t = 0) -> I in bits(32) -> int_le(0, sint(32, I)) -> int_lt(sint(32, I), seq_len(tab)) ->
  mallocng_specs.table_ok(app(s, "vm"), app(s, "objs"), t, 2, tab) ->
  g.det(gimple.elem(t, bits_sext(32, 64, I), 2), s, ok(s, bits_add(64, t, bits_add(64, bits_sext(32, 64, I), bits_sext(32, 64, I))))) &&
  g.det(gimple.ld16(bits_add(64, t, bits_add(64, bits_sext(32, 64, I), bits_sext(32, 64, I))), 0), s, ok(s, bits_of_int(16, app(tab, sint(32, I)))))
proof
  fix s t I tab
  assume hs ht hnz hI h0 hl htab
  let i := sint(32, I)
  let A := bits_add(64, t, bits_add(64, bits_sext(32, 64, I), bits_sext(32, 64, I)))
  have io: i in omega by arith(h0)
  have tu tb := mp(all_elim(expand(htab, mallocng_specs.table_ok), {i}), io, hl)
  // (the entry's address: in range, t + 2i)
  have t0: int_le(0, t) by simp(ht)
  have ud := apply(tr.usable_dom, {app(s, "vm")}, {app(s, "objs")}, {int_add(t, int_mul(2, i))}, {2}, {false}, {1}, tu, arith(t0, h0), simp(), simp())
  have rng: int_lt(int_add(int_add(t, int_mul(2, i)), 1), 18446744073709551616) by taut(ud)
  have sv := mp(tr.sext_vals, {I}, hI)
  have xd: bits_sext(32, 64, I) = int_mod(i, 18446744073709551616) by defs(simp(), bits_sext, bits_of_int, pow2)
  have ea: A = int_add(t, int_mul(2, i)) by defs(arith(xd, rng, h0, t0, ht), bits_add, pow2)
  have def: tr.elem2_sx_def(t, I) by arith(rng, h0, t0)
  have ed := apply(g.elem2_sx_det, {s}, {t}, {I}, hs, ht, hI, def)
  // (the load: its bytes the entry's)
  have ab: A in bits(64) by simp()
  have e0: int_add(A, 0) = int_add(t, int_mul(2, i)) by arith(ea)
  have md: g.mem_defined(s, A, 0, 2, false) by simp(e0, tu, rng, hnz, ea, t0, h0, ht)
  have ld := apply(g.ld16_det, {s}, {A}, {0}, hs, ab, simp(), md)
  have be: bits_of_int(64, int_add(t, int_mul(2, i))) = int_add(A, 0) by defs(arith(e0, rng, h0, t0), bits_of_int, pow2)
  have tb2 := rewrite(be, tb)
  have ld2 := rewrite(tb2, ld)
  show by taut(ed, ld2)
qed

