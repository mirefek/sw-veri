      assume hA hB
      have ei1: i1 = 46 by simp(hA, a1)
      have ei2: i2 = 47 by simp(rewrite(ei1, hb1), hB)
      have pv: app(mallocng.size_classes, int_sub(47, 1)) = 6552 by simp(ms.sc_vals)
      have le: int_le(int_div(int_add(n, 19), 16), app(mallocng.size_classes, 47)) by arith(ue, hi, lo, hA, hB, w1, v47, v46)
      have pr: 47 = 0 || int_lt(app(mallocng.size_classes, int_sub(47, 1)), int_div(int_add(n, 19), 16)) by arith(ue, hi, lo, u11, hA, hB, w1, pv, v46)
      have cl := apply(ms.class_from, hn, (47 in omega by simp()), (int_lt(47, 48) by simp()), le, pr)
