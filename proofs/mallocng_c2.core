      have pr: 45 = 0 || int_lt(app(mallocng.size_classes, int_sub(45, 1)), int_div(int_add(n, 19), 16)) by arith(ue, hi, lo, u11, hA, hB, w1, pv, v44)
      have cl := apply(ms.class_from, hn, (45 in omega by simp()), (int_lt(45, 48) by simp()), le, pr)
