theorem ms.sc_vals: app(mallocng.size_classes, 0) = 1 && app(mallocng.size_classes, 1) = 2 && app(mallocng.size_classes, 2) = 3 && app(mallocng.size_classes, 3) = 4 && app(mallocng.size_classes, 4) = 5 && app(mallocng.size_classes, 5) = 6 && app(mallocng.size_classes, 6) = 7 && app(mallocng.size_classes, 7) = 8 && app(mallocng.size_classes, 8) = 9 && app(mallocng.size_classes, 9) = 10 && app(mallocng.size_classes, 10) = 12 && app(mallocng.size_classes, 11) = 15 && app(mallocng.size_classes, 12) = 18 && app(mallocng.size_classes, 13) = 20 && app(mallocng.size_classes, 14) = 25 && app(mallocng.size_classes, 15) = 31 && app(mallocng.size_classes, 16) = 36 && app(mallocng.size_classes, 17) = 42 && app(mallocng.size_classes, 18) = 50 && app(mallocng.size_classes, 19) = 63 && app(mallocng.size_classes, 20) = 72 && app(mallocng.size_classes, 21) = 84 && app(mallocng.size_classes, 22) = 102 && app(mallocng.size_classes, 23) = 127 && app(mallocng.size_classes, 24) = 146 && app(mallocng.size_classes, 25) = 170 && app(mallocng.size_classes, 26) = 204 && app(mallocng.size_classes, 27) = 255 && app(mallocng.size_classes, 28) = 292 && app(mallocng.size_classes, 29) = 340 && app(mallocng.size_classes, 30) = 409 && app(mallocng.size_classes, 31) = 511 && app(mallocng.size_classes, 32) = 584 && app(mallocng.size_classes, 33) = 682 && app(mallocng.size_classes, 34) = 818 && app(mallocng.size_classes, 35) = 1023 && app(mallocng.size_classes, 36) = 1169 && app(mallocng.size_classes, 37) = 1364 && app(mallocng.size_classes, 38) = 1637 && app(mallocng.size_classes, 39) = 2047 && app(mallocng.size_classes, 40) = 2340 && app(mallocng.size_classes, 41) = 2730 && app(mallocng.size_classes, 42) = 3276 && app(mallocng.size_classes, 43) = 4095 && app(mallocng.size_classes, 44) = 4680 && app(mallocng.size_classes, 45) = 5460 && app(mallocng.size_classes, 46) = 6552 && app(mallocng.size_classes, 47) = 8191
proof
