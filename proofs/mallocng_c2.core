    qed
    have cA: int_lt(app(mallocng.size_classes, int_add(44, 1)), int_add(int_div(int_add(n, 3), 16), 1)) || !int_lt(app(mallocng.size_classes, int_add(44, 1)), int_add(int_div(int_add(n, 3), 16), 1)) by taut()
    have cB1: int_lt(app(mallocng.size_classes, 46), int_add(int_div(int_add(n, 3), 16), 1)) || !int_lt(app(mallocng.size_classes, 46), int_add(int_div(int_add(n, 3), 16), 1)) by taut()
    have cB2: int_lt(app(mallocng.size_classes, 44), int_add(int_div(int_add(n, 3), 16), 1)) || !int_lt(app(mallocng.size_classes, 44), int_add(int_div(int_add(n, 3), 16), 1)) by taut()
    show by taut(cA, cB1, cB2, sAB, sAb, saB, sab)
  qed
  have k20: c = 20 -> mallocng_specs.class_of(n, i2) proof
    assume e
    have zl zlo zhi := expand(rewrite(e, hz), mallocng_specs.clz_of)
    have lo: int_le(2048, int_add(int_div(int_add(n, 3), 16), 1)) by simp(zlo)
    have hi: int_lt(int_add(int_div(int_add(n, 3), 16), 1), 4096) by simp(zhi)
    have e0: int_mul(4, int_sub(30, c)) = 40 by simp(e)
    have a1 := rewrite(e0, ha1)
    have a2 := rewrite(e0, ha2)
    have v39: app(mallocng.size_classes, 39) = 2047 by simp(ms.sc_vals)
    have v40: app(mallocng.size_classes, 40) = 2340 by simp(ms.sc_vals)
    have v41: app(mallocng.size_classes, 41) = 2730 by simp(ms.sc_vals)
    have v42: app(mallocng.size_classes, 42) = 3276 by simp(ms.sc_vals)
    have v43: app(mallocng.size_classes, 43) = 4095 by simp(ms.sc_vals)
    have w1: app(mallocng.size_classes, int_add(40, 1)) = 2730 by simp(ms.sc_vals)
    have sAB: int_lt(app(mallocng.size_classes, int_add(40, 1)), int_add(int_div(int_add(n, 3), 16), 1)) -> int_lt(app(mallocng.size_classes, 42), int_add(int_div(int_add(n, 3), 16), 1)) -> mallocng_specs.class_of(n, i2) proof
