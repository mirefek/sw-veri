  have u8k: int_le(int_add(int_div(int_add(n, 3), 16), 1), 8191) by arith(hn, h131)
  have ue: int_div(int_add(n, 19), 16) = int_add(int_div(int_add(n, 3), 16), 1) by arith(hn)
  have b19 b28 := apply(ms.stc_bounds, uo, u11, u8k, hc, hz)
  have d: c = 19 || c = 20 || c = 21 || c = 22 || c = 23 || c = 24 || c = 25 || c = 26 || c = 27 || c = 28 by arith(hc, b19, b28)
  have k19: c = 19 -> mallocng_specs.class_of(n, i2) proof
    assume e
    have zl zlo zhi := expand(rewrite(e, hz), mallocng_specs.clz_of)
    have lo: int_le(4096, int_add(int_div(int_add(n, 3), 16), 1)) by simp(zlo)
