// C2 of mallocng's internal functions: their readable GIMPLE refines their
// specs (layers/mallocng_specs.sl). A run of the code is inverted step by
// step (proofs/gimple_inv.core: each operation's one outcome), in the
// specs' vocabulary (rd64, wr64, word_ok); the spec's run is the outcome.
//
//   checked after proofs/translate_effects.core and proofs/gimple_inv.core

// ----------------------------------------------------------------------
//  Words: written, read back

// (a word's address: no wrap -- int_add the code's, bits_add the spec's)
theorem ms.addr: all p off. p in bits(64) -> off in bits(32) -> int_le(int_add(int_add(p, off), 8), int_pow(2, 64)) -> int_add(p, off) = bits_add(64, p, off)
proof
  fix p off
  assume hp ho hl
  show by arith(hp, ho, hl)
qed

theorem ms.rd_wr_same: all vm a v. app(vm, "bytes") in fn_space(bits(64), bits(8)) -> a in bits(64) -> v in bits(64) ->
  mallocng_specs.rd64(mallocng_specs.wr64(vm, a, v), a) = v
proof
  fix vm a v
  assume hb ha hv
  let W := fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, 8, v))
  have ew: mallocng_specs.wr64(vm, a, v) = W by rsimp(mallocng_specs.wr64)
  have l := apply(tr.le_store8, {app(vm, "bytes")}, {a}, {v}, hb, ha, simp(hv))
  have lb := all_elim(tr.le_bytes, {W}, {a}, {8})
  have r: bits_of_int(64, gimple.bytes_at(W, a, 8)) = v by simp(lb, l, hv, keep(x86_64_linux.le, gimple.bytes_at))
  show by rsimp(mallocng_specs.rd64, ew, r)
qed

theorem ms.rd_wr_far: all vm a b v. a in bits(64) -> b in bits(64) -> mallocng_specs.al8(a) -> mallocng_specs.al8(b) -> !(a = b) ->
  mallocng_specs.rd64(mallocng_specs.wr64(vm, a, v), b) = mallocng_specs.rd64(vm, b)
proof
  fix vm a b v
  assume ha hb aa ab ne
  have a8 := expand(aa, mallocng_specs.al8)
  have b8 := expand(ab, mallocng_specs.al8)
  have far: all k. k in omega -> int_lt(k, 8) -> !int_lt(bits_sub(64, bits_add(64, b, bits_of_int(64, k)), a), 8) proof
    fix k
    assume k1 k2
    show by arith(ha, hb, a8, b8, ne, k1, k2)
  qed
  have lf := apply(x86.le_store_far, {app(vm, "bytes")}, {b}, {a}, {8}, {v}, hb, ha, far)
  let W := fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, 8, v))
  have ew: mallocng_specs.wr64(vm, a, v) = W by rsimp(mallocng_specs.wr64)
  have l1 := all_elim(tr.le_bytes, {W}, {b}, {8})
  have l2 := all_elim(tr.le_bytes, {vm}, {b}, {8})
  have r: bits_of_int(64, gimple.bytes_at(W, b, 8)) = bits_of_int(64, gimple.bytes_at(vm, b, 8)) by simp(l1, l2, lf, keep(x86_64_linux.le, x86_64_linux.store_le, gimple.bytes_at))
  show by rsimp(mallocng_specs.rd64, ew, r)
qed

// ----------------------------------------------------------------------
//  Worlds after a word written

theorem ms.world_wr: all s a v. s in abi.World -> s in univ(1) -> a in bits(64) ->
  fn_update(s, "vm", mallocng_specs.wr64(app(s, "vm"), a, v)) in abi.World && fn_update(s, "vm", mallocng_specs.wr64(app(s, "vm"), a, v)) in univ(1)
proof
  fix s a v
  assume hw hu ha
  have r := apply(tr.world_store, {s}, {a}, {8}, {v}, hw, hu, ha)
  show r
qed

theorem ms.word_wr: all vm objs p off a v. mallocng_specs.word_ok(vm, objs, p, off) -> mallocng_specs.word_ok(mallocng_specs.wr64(vm, a, v), objs, p, off)
proof
  fix vm objs p off a v
  assume h
  show by defs(simp(expand(h, mallocng_specs.word_ok, gimple.usable)), mallocng_specs.word_ok, gimple.usable, mallocng_specs.wr64)
qed

// (a world's parts, for GIMPLE's stores)
theorem ms.world_parts: all s. s in abi.World -> app(s, "vm") in x86_64_linux.Vm && is_fun(s) && "vm" in dom(s) && app(app(s, "vm"), "bytes") in fn_space(bits(64), bits(8))
proof
  fix s
  assume h
  have wf := expand(h, abi.World)
  show by simp(wf)
qed

// ----------------------------------------------------------------------
//  The accessors' runs: one outcome each (the word defined)

theorem ms.ld_det: all s p off. s in univ(1) -> p in bits(64) -> off in bits(32) -> mallocng_specs.word_ok(app(s, "vm"), app(s, "objs"), p, off) ->
  g.det(gimple.ld64(p, off), s, ok(s, mallocng_specs.rd64(app(s, "vm"), bits_add(64, p, off))))
proof
  fix s p off
  assume hs hp ho hk
  have nz lt ur uw := hk
  have ea := apply(ms.addr, {p}, {off}, hp, ho, lt)
  have md: g.mem_defined(s, p, off, 8, false) by simp(nz, lt, ur, hp, ho)
  have ld := apply(g.ld64_det, {s}, {p}, {off}, hs, hp, ho, md)
  show rewrite(ea, ld)
qed

theorem ms.st_det: all s p off v. s in abi.World -> s in univ(1) -> p in bits(64) -> off in bits(32) -> mallocng_specs.word_ok(app(s, "vm"), app(s, "objs"), p, off) ->
  g.det(gimple.st64(p, off, v), s, ok(fn_update(s, "vm", mallocng_specs.wr64(app(s, "vm"), bits_add(64, p, off), v)), empty))
proof
  fix s p off v
  assume hw hs hp ho hk
  have nz lt ur uw := hk
  have ea := apply(ms.addr, {p}, {off}, hp, ho, lt)
  have md: g.mem_defined(s, p, off, 8, true) by simp(nz, lt, uw, hp, ho)
  have pv pf pd .. := apply(ms.world_parts, hw)
  have st := apply(g.st64_det, {s}, {p}, {off}, {v}, hs, hp, ho, md, pv, pf, pd)
  show rewrite(ea, st)
qed

theorem ms.next_det: all s m. s in univ(1) -> m in bits(64) -> mallocng_specs.word_ok(app(s, "vm"), app(s, "objs"), m, 8) ->
  g.det(c_src_malloc_mallocng_malloc.meta_next(m), s, ok(s, mallocng_specs.mnext(app(s, "vm"), m)))
proof
  fix s m
  assume hs hm hk
  have d := apply(ms.ld_det, {s}, {m}, {8}, hs, hm, simp(), hk)
  show apply(g.ret_det, d)
qed

theorem ms.prev_det: all s m. s in univ(1) -> m in bits(64) -> mallocng_specs.word_ok(app(s, "vm"), app(s, "objs"), m, 0) ->
  g.det(c_src_malloc_mallocng_malloc.meta_prev(m), s, ok(s, mallocng_specs.mprev(app(s, "vm"), m)))
proof
  fix s m
  assume hs hm hk
  have d := apply(ms.ld_det, {s}, {m}, {0}, hs, hm, simp(), hk)
  have z: bits_add(64, m, 0) = m by simp(hm)
  show apply(g.ret_det, rewrite(z, d))
qed

theorem ms.setnext_det: all s p v. s in abi.World -> s in univ(1) -> p in bits(64) -> mallocng_specs.word_ok(app(s, "vm"), app(s, "objs"), p, 8) ->
  g.det(c_src_malloc_mallocng_malloc.set_meta_next(p, v), s, ok(fn_update(s, "vm", mallocng_specs.wr64(app(s, "vm"), bits_add(64, p, 8), v)), empty))
proof
  fix s p v
  assume hw hs hp hk
  have d := apply(ms.st_det, {s}, {p}, {8}, {v}, hw, hs, hp, simp(), hk)
  show apply(g.unit_det, d)
qed

theorem ms.setprev_det: all s p v. s in abi.World -> s in univ(1) -> p in bits(64) -> mallocng_specs.word_ok(app(s, "vm"), app(s, "objs"), p, 0) ->
  g.det(c_src_malloc_mallocng_malloc.set_meta_prev(p, v), s, ok(fn_update(s, "vm", mallocng_specs.wr64(app(s, "vm"), p, v)), empty))
proof
  fix s p v
  assume hw hs hp hk
  have d := apply(ms.st_det, {s}, {p}, {0}, {v}, hw, hs, hp, simp(), hk)
  have z: bits_add(64, p, 0) = p by simp(hp)
  show apply(g.unit_det, rewrite(z, d))
qed

// ----------------------------------------------------------------------
//  Worlds as the code writes them: s with its memory X

// (a world written again: one update)
theorem ms.upd: all s X a v. fn_update(fn_update(s, "vm", X), "vm", mallocng_specs.wr64(app(fn_update(s, "vm", X), "vm"), a, v)) = fn_update(s, "vm", mallocng_specs.wr64(X, a, v))
proof
  fix s X a v
  have t := fn_update_twice[f := s, k := "vm", a := X, b := mallocng_specs.wr64(X, a, v)]
  show by simp(t)
qed

// (s with its memory X, X then written: a world, its memory's facts)
theorem ms.sw: all s X a v. fn_update(s, "vm", X) in abi.World -> fn_update(s, "vm", X) in univ(1) -> a in bits(64) ->
  fn_update(s, "vm", mallocng_specs.wr64(X, a, v)) in abi.World && fn_update(s, "vm", mallocng_specs.wr64(X, a, v)) in univ(1)
proof
  fix s X a v
  assume hw hu ha
  have r := apply(ms.world_wr, {fn_update(s, "vm", X)}, {a}, {v}, hw, hu, ha)
  show by simp(rewrite(all_elim(ms.upd, {s}, {X}, {a}, {v}), r))
qed

// (an 8-aligned word's successor's address: aligned, no wrap)
theorem ms.al8_add: all p. p in bits(64) -> mallocng_specs.al8(p) -> int_le(int_add(int_add(p, 8), 8), int_pow(2, 64)) ->
  mallocng_specs.al8(bits_add(64, p, 8)) && bits_add(64, p, 8) = int_add(p, 8) && bits_add(64, p, 8) in bits(64)
proof
  fix p
  assume hp ha hl
  have a8 := expand(ha, mallocng_specs.al8)
  show by defs(arith(a8, hp, hl), mallocng_specs.al8)
qed

// ----------------------------------------------------------------------
//  dequeue

// m alone (its next itself): the head cleared, m's links cleared
theorem ms.dq_alone: all phead m s o. phead in bits(64) -> m in bits(64) -> s in abi.World -> s in univ(1) ->
  mallocng_specs.dequeue_pre(app(s, "vm"), app(s, "objs"), phead, m) -> m = mallocng_specs.mnext(app(s, "vm"), m) ->
  runs(c_src_malloc_mallocng_malloc.dequeue(phead, m), s, o) ->
  o = ok(fn_update(s, "vm", mallocng_specs.wr64(mallocng_specs.wr64(mallocng_specs.wr64(app(s, "vm"), phead, 0), bits_add(64, m, 8), 0), m, 0)), empty)
proof
  fix phead m s o
  assume hph hm hw hu hpre heq hr
  let V0 := app(s, "vm")
  let N := mallocng_specs.mnext(V0, m)
  have kh km0 km8 ah am nhm nhm8 .. := hpre
  // the first load, the branch not taken
  have h0 := apply(g.runs_elim, hr)
  have d0 := apply(ms.next_det, {s}, {m}, hu, hm, km8)
  obtain x5, hc hrest from apply(g.letin_e, apply(g.bind_inv, h0, d0))
  have e5: x5 = ok(pair(s, empty), empty) := apply(g.pick2, hc, (!!(m = N) by taut(heq)), (!!(m = N) by taut(heq)))
  have os := all_elim(g.ok_state, {pair(s, empty)}, {empty})
  have h1 := apply(g.pick0, rewrite(e5, hrest), simp(os), simp(os))
  // *phead := 0
  have fp: fst(pair(s, empty)) = s by rsimp()
  have hs1 := apply(g.bind_inv, rewrite(fp, rewrite(os.1, h1)), apply(ms.st_det, {s}, {phead}, {0}, {0}, hw, hu, hph, simp(), kh))
  // m.next := 0
  have zp: bits_add(64, phead, 0) = phead by simp(hph)
  let V1 := mallocng_specs.wr64(V0, phead, 0)
  let S1 := fn_update(s, "vm", V1)
  have w1 u1 := apply(ms.world_wr, {s}, {phead}, {0}, hw, hu, hph)
  have km8b: mallocng_specs.word_ok(app(S1, "vm"), app(S1, "objs"), m, 8) by simp(apply(ms.word_wr, {V0}, {app(s, "objs")}, {m}, {8}, {phead}, {0}, km8))
  have km0b: mallocng_specs.word_ok(app(S1, "vm"), app(S1, "objs"), m, 0) by simp(apply(ms.word_wr, {V0}, {app(s, "objs")}, {m}, {0}, {phead}, {0}, km0))
  have hs2 := apply(g.bind_inv, rewrite(zp, hs1), apply(ms.setnext_det, {S1}, {m}, {0}, w1, u1, hm, km8b))
  let M8 := bits_add(64, m, 8)
  let V2 := mallocng_specs.wr64(V1, M8, 0)
  let S2 := fn_update(s, "vm", V2)
  have hs2b := rewrite(all_elim(ms.upd, {s}, {V1}, {M8}, {0}), hs2)
  have w2 u2 := apply(ms.sw, {s}, {V1}, {M8}, {0}, w1, u1, simp())
  have km8c: mallocng_specs.word_ok(app(S2, "vm"), app(S2, "objs"), m, 8) by simp(apply(ms.word_wr, {V1}, {app(s, "objs")}, {m}, {8}, {M8}, {0}, simp(km8b)))
  have km0c: mallocng_specs.word_ok(app(S2, "vm"), app(S2, "objs"), m, 0) by simp(apply(ms.word_wr, {V1}, {app(s, "objs")}, {m}, {0}, {M8}, {0}, simp(km0b)))
  // t8 := m.next (0, just written)
  have bt1 := apply(ms.world_parts, w1).4
  have r0: mallocng_specs.mnext(app(S2, "vm"), m) = 0 by rsimp(mallocng_specs.mnext, apply(ms.rd_wr_same, {V1}, {M8}, {0}, simp(bt1), simp(), simp()))
  have hs3 := rewrite(r0, apply(g.letin_e, apply(g.bind_inv, hs2b, apply(ms.next_det, {S2}, {m}, u2, hm, km8c))))
  // m.prev := t8
  have hs4 := apply(g.bind_inv, hs3, apply(ms.setprev_det, {S2}, {m}, {0}, w2, u2, hm, km0c))
  show := rewrite(all_elim(ms.upd, {s}, {V2}, {m}, {0}), hs4)
qed

// (a meta's links: its words)
theorem ms.mnext_def: all vm m. mallocng_specs.mnext(vm, m) = mallocng_specs.rd64(vm, bits_add(64, m, 8))
proof
  fix vm m
  show refl({mallocng_specs.rd64(vm, bits_add(64, m, 8))})
qed

theorem ms.mprev_def: all vm m. mallocng_specs.mprev(vm, m) = mallocng_specs.rd64(vm, m)
proof
  fix vm m
  show refl({mallocng_specs.rd64(vm, m)})
qed

// (two 8-aligned addresses x + 8, y + 8: equal only if x, y are)
theorem ms.add8_ne: all x y. x in bits(64) -> y in bits(64) -> int_le(int_add(int_add(x, 8), 8), int_pow(2, 64)) -> int_le(int_add(int_add(y, 8), 8), int_pow(2, 64)) ->
  !(x = y) -> !(bits_add(64, x, 8) = bits_add(64, y, 8))
proof
  fix x y
  assume hx hy lx ly ne
  show by arith(ne, hx, hy, lx, ly)
qed

// m linked (its next another meta): the neighbours linked to each other,
// the head moved past m if it was m, m's links cleared
theorem ms.dq_linked: all phead m s o. phead in bits(64) -> m in bits(64) -> s in abi.World -> s in univ(1) ->
  mallocng_specs.dequeue_pre(app(s, "vm"), app(s, "objs"), phead, m) -> !(m = mallocng_specs.mnext(app(s, "vm"), m)) ->
  runs(c_src_malloc_mallocng_malloc.dequeue(phead, m), s, o) ->
  o = ok(fn_update(s, "vm", mallocng_specs.dequeue_vm(app(s, "vm"), phead, m)), empty)
proof
  fix phead m s o
  assume hph hm hw hu hpre hne hr
  let V0 := app(s, "vm")
  let OB := app(s, "objs")
  let N := mallocng_specs.mnext(V0, m)
  let P := mallocng_specs.mprev(V0, m)
  let PA := bits_add(64, P, 8)
  let M8 := bits_add(64, m, 8)
  have kh km0 km8 ah am nhm nhm8 hl := hpre
  have nNm: !(N = m) by taut(hne)
  have kp8 kn0 ap an npm np8m nn8 np8h nnh np8n := mp(hl, nNm)
  have hP: P in bits(64) by defs(simp(), mallocng_specs.mprev, mallocng_specs.rd64)
  have hN: N in bits(64) by defs(simp(), mallocng_specs.mnext, mallocng_specs.rd64)
  // (the addresses: P + 8, m + 8 aligned, no wrap)
  have _ plt .. := kp8
  have _ mlt .. := km8
  have apa epa hpa := apply(ms.al8_add, {P}, hP, ap, plt)
  have am8 em8 hm8 := apply(ms.al8_add, {m}, hm, am, mlt)
  have pa_m8 := apply(ms.add8_ne, {P}, {m}, hP, hm, plt, mlt, npm)
  have pa_m: !(PA = m) := rewrite(sym(epa), np8m)
  have n_m8: !(N = M8) := rewrite(sym(em8), nn8)
  have pa_h: !(PA = phead) := rewrite(sym(epa), np8h)
  have pa_n: !(PA = N) := rewrite(sym(epa), np8n)
  // t1 := m.next, the branch taken
  have h0 := apply(g.runs_elim, hr)
  have d0 := apply(ms.next_det, {s}, {m}, hu, hm, km8)
  obtain x5, hc hrest from apply(g.letin_e, apply(g.bind_inv, h0, d0))
  have hA := apply(g.pick, hc, hne, (!!!(m = N) by taut(hne)))
  // t2 := m.prev, t3 := m.next, t2.next := t3
  have a1 := apply(g.letin_e, apply(g.bind_inv, hA, apply(ms.prev_det, {s}, {m}, hu, hm, km0)))
  have a2 := apply(g.letin_e, apply(g.bind_inv, a1, d0))
  have a3 := apply(g.bind_inv, a2, apply(ms.setnext_det, {s}, {P}, {N}, hw, hu, hP, kp8))
  let V1 := mallocng_specs.wr64(V0, PA, N)
  let S1 := fn_update(s, "vm", V1)
  have w1 u1 := apply(ms.world_wr, {s}, {PA}, {N}, hw, hu, hpa)
  have km8_1: mallocng_specs.word_ok(app(S1, "vm"), app(S1, "objs"), m, 8) by simp(apply(ms.word_wr, {V0}, {OB}, {m}, {8}, {PA}, {N}, km8))
  have km0_1: mallocng_specs.word_ok(app(S1, "vm"), app(S1, "objs"), m, 0) by simp(apply(ms.word_wr, {V0}, {OB}, {m}, {0}, {PA}, {N}, km0))
  have kn0_1: mallocng_specs.word_ok(app(S1, "vm"), app(S1, "objs"), N, 0) by simp(apply(ms.word_wr, {V0}, {OB}, {N}, {0}, {PA}, {N}, kn0))
  // t4 := m.next (N: m's next not written), t5 := m.prev (P), t4.prev := t5
  have sv1: app(S1, "vm") = V1 by rsimp()
  have e1a: mallocng_specs.mnext(V1, m) = N := trans(all_elim(ms.mnext_def, {V1}, {m}), trans(apply(ms.rd_wr_far, {V0}, {PA}, {M8}, {N}, hpa, hm8, apa, am8, pa_m8), sym(all_elim(ms.mnext_def, {V0}, {m}))))
  have e1 := rewrite(sym(sv1), e1a)
  have a4 := rewrite(e1, apply(g.letin_e, apply(g.bind_inv, a3, apply(ms.next_det, {S1}, {m}, u1, hm, km8_1))))
  have e2a: mallocng_specs.mprev(V1, m) = P := trans(all_elim(ms.mprev_def, {V1}, {m}), trans(apply(ms.rd_wr_far, {V0}, {PA}, {m}, {N}, hpa, hm, apa, am, pa_m), sym(all_elim(ms.mprev_def, {V0}, {m}))))
  have e2 := rewrite(sym(sv1), e2a)
  have a5 := rewrite(e2, apply(g.letin_e, apply(g.bind_inv, a4, apply(ms.prev_det, {S1}, {m}, u1, hm, km0_1))))
  have a6 := rewrite(all_elim(ms.upd, {s}, {V1}, {N}, {P}), apply(g.bind_inv, a5, apply(ms.setprev_det, {S1}, {N}, {P}, w1, u1, hN, kn0_1)))
  let V2 := mallocng_specs.wr64(V1, N, P)
  let S2 := fn_update(s, "vm", V2)
  have w2 u2 := apply(ms.sw, {s}, {V1}, {N}, {P}, w1, u1, hN)
  have sv2: app(S2, "vm") = V2 by rsimp()
  have kh_2: mallocng_specs.word_ok(app(S2, "vm"), app(S2, "objs"), phead, 0) by simp(apply(ms.word_wr, {V1}, {OB}, {phead}, {0}, {N}, {P}, simp(apply(ms.word_wr, {V0}, {OB}, {phead}, {0}, {PA}, {N}, kh))))
  have km8_2: mallocng_specs.word_ok(V2, OB, m, 8) := apply(ms.word_wr, {V1}, {OB}, {m}, {8}, {N}, {P}, simp(km8_1))
  // t6 := *phead (as at the entry: the neighbours' words are apart from it)
  let H := mallocng_specs.rd64(V0, phead)
  have zp: bits_add(64, phead, 0) = phead by simp(hph)
  have e3a: mallocng_specs.rd64(V2, phead) = H :=
    trans(apply(ms.rd_wr_far, {V1}, {N}, {phead}, {P}, hN, hph, an, ah, nnh), apply(ms.rd_wr_far, {V0}, {PA}, {phead}, {N}, hpa, hph, apa, ah, pa_h))
  have e3 := rewrite(sym(sv2), e3a)
  have a7 := rewrite(e3, rewrite(zp, apply(g.letin_e, apply(g.bind_inv, a6, apply(ms.ld_det, {S2}, {phead}, {0}, u2, hph, simp(), kh_2)))))
  obtain x25, hc2 hrest2 from a7
  // the rest after the head's update: m's links cleared, the return
  have tl: all X. fn_update(s, "vm", X) in abi.World -> fn_update(s, "vm", X) in univ(1) -> mallocng_specs.word_ok(X, OB, m, 8) -> mallocng_specs.word_ok(X, OB, m, 0) ->
      x25 = ok(pair(fn_update(s, "vm", X), empty), empty) ->
      x5 = exc(pair(fn_update(s, "vm", mallocng_specs.wr64(mallocng_specs.wr64(X, M8, 0), m, 0)), empty), pair("ret", empty)) proof
    fix X
    assume hwx hux k8 k0 ex
    let SX := fn_update(s, "vm", X)
    have os := all_elim(g.ok_state, {pair(SX, empty)}, {empty})
    have t1 := apply(g.pick0, rewrite(ex, hrest2), simp(os), simp(os))
    have fp: fst(pair(SX, empty)) = SX by rsimp()
    have k8x: mallocng_specs.word_ok(app(SX, "vm"), app(SX, "objs"), m, 8) by simp(k8)
    have k0x: mallocng_specs.word_ok(app(SX, "vm"), app(SX, "objs"), m, 0) by simp(k0)
    have t2 := rewrite(all_elim(ms.upd, {s}, {X}, {M8}, {0}), apply(g.bind_inv, rewrite(fp, rewrite(os.1, t1)), apply(ms.setnext_det, {SX}, {m}, {0}, hwx, hux, hm, k8x)))
    let X1 := mallocng_specs.wr64(X, M8, 0)
    let SX1 := fn_update(s, "vm", X1)
    have wx1 ux1 := apply(ms.sw, {s}, {X}, {M8}, {0}, hwx, hux, hm8)
    have k8y: mallocng_specs.word_ok(app(SX1, "vm"), app(SX1, "objs"), m, 8) by simp(apply(ms.word_wr, {X}, {OB}, {m}, {8}, {M8}, {0}, k8))
    have k0y: mallocng_specs.word_ok(app(SX1, "vm"), app(SX1, "objs"), m, 0) by simp(apply(ms.word_wr, {X}, {OB}, {m}, {0}, {M8}, {0}, k0))
    have btx := apply(ms.world_parts, hwx).4
    have r0a: mallocng_specs.mnext(X1, m) = 0 := trans(all_elim(ms.mnext_def, {X1}, {m}), apply(ms.rd_wr_same, {X}, {M8}, {0}, simp(btx), hm8, simp()))
    have svx: app(SX1, "vm") = X1 by rsimp()
    have t3 := rewrite(rewrite(sym(svx), r0a), apply(g.letin_e, apply(g.bind_inv, t2, apply(ms.next_det, {SX1}, {m}, ux1, hm, k8y))))
    have t4 := apply(g.bind_inv, t3, apply(ms.setprev_det, {SX1}, {m}, {0}, wx1, ux1, hm, k0y))
    show := rewrite(all_elim(ms.upd, {s}, {X1}, {m}, {0}), t4)
  qed
  // the head: moved past m if it was m
  let X3 := ite(m = H, mallocng_specs.wr64(V2, phead, N), V2)
  have km0_2: mallocng_specs.word_ok(V2, OB, m, 0) := apply(ms.word_wr, {V1}, {OB}, {m}, {0}, {N}, {P}, simp(km0_1))
  have ex3: x25 = ok(pair(fn_update(s, "vm", X3), empty), empty) && fn_update(s, "vm", X3) in abi.World && fn_update(s, "vm", X3) in univ(1) &&
      mallocng_specs.word_ok(X3, OB, m, 8) && mallocng_specs.word_ok(X3, OB, m, 0) proof
    have was: m = H -> x25 = ok(pair(fn_update(s, "vm", X3), empty), empty) && fn_update(s, "vm", X3) in abi.World && fn_update(s, "vm", X3) in univ(1) &&
        mallocng_specs.word_ok(X3, OB, m, 8) && mallocng_specs.word_ok(X3, OB, m, 0) proof
      assume hmh
      have x3e: X3 = mallocng_specs.wr64(V2, phead, N) by simp(hmh)
      have b1 := apply(g.pick, hc2, hmh, (!!(m = H) by taut(hmh)))
      have km8_2b: mallocng_specs.word_ok(app(S2, "vm"), app(S2, "objs"), m, 8) by simp(km8_2)
      have e4a: mallocng_specs.mnext(V2, m) = N := trans(all_elim(ms.mnext_def, {V2}, {m}),
        trans(apply(ms.rd_wr_far, {V1}, {N}, {M8}, {P}, hN, hm8, an, am8, n_m8), trans(apply(ms.rd_wr_far, {V0}, {PA}, {M8}, {N}, hpa, hm8, apa, am8, pa_m8), sym(all_elim(ms.mnext_def, {V0}, {m})))))
      have b2 := rewrite(rewrite(sym(sv2), e4a), apply(g.letin_e, apply(g.bind_inv, b1, apply(ms.next_det, {S2}, {m}, u2, hm, km8_2b))))
      have b3 := rewrite(all_elim(ms.upd, {s}, {V2}, {phead}, {N}), rewrite(zp, apply(g.bind_inv, b2, apply(ms.st_det, {S2}, {phead}, {0}, {N}, w2, u2, hph, simp(), kh_2))))
      have ww uu := apply(ms.sw, {s}, {V2}, {phead}, {N}, w2, u2, hph)
      have k8 := apply(ms.word_wr, {V2}, {OB}, {m}, {8}, {phead}, {N}, km8_2)
      have k0 := apply(ms.word_wr, {V2}, {OB}, {m}, {0}, {phead}, {N}, km0_2)
      show := rewrite(sym(x3e), conj(b3, ww, uu, k8, k0))
    qed
    have wasnt: !(m = H) -> x25 = ok(pair(fn_update(s, "vm", X3), empty), empty) && fn_update(s, "vm", X3) in abi.World && fn_update(s, "vm", X3) in univ(1) &&
        mallocng_specs.word_ok(X3, OB, m, 8) && mallocng_specs.word_ok(X3, OB, m, 0) proof
      assume hmh
      have x3e: X3 = V2 by simp(hmh)
      have b1 := apply(g.pick2, hc2, hmh, (!(m = H) by taut(hmh)))
      show := rewrite(sym(x3e), conj(b1, w2, u2, km8_2, km0_2))
    qed
    show by taut(was, wasnt)
  qed
  have ex25 hw3 hu3 k83 k03 := ex3
  have ex5 := mp(all_elim(tl, {X3}), hw3, hu3, k83, k03, ex25)
  // the return: o, the world after
  have oe: o = ok(fn_update(s, "vm", mallocng_specs.wr64(mallocng_specs.wr64(X3, M8, 0), m, 0)), empty) by simp(rewrite(ex5, hrest))
  // the spec's effect: the same memory
  have hd0: (!(N = m) && H = m) <-> m = H by taut(nNm)
  have hd: !(N = m) && mallocng_specs.rd64(V2, phead) = m <-> m = H by simp(hd0, e3a)
  have dl: mallocng_specs.dq_links(V0, phead, m) = V2 by defs(mp(tr.ite_t[c := !(N = m), a := V2, b := mallocng_specs.wr64(V0, phead, 0)], nNm), mallocng_specs.dq_links)
  have dh: mallocng_specs.dq_head(V2, V0, phead, m) = X3 proof
    let C := !(N = m) && mallocng_specs.rd64(V2, phead) = m
    have t: m = H -> mallocng_specs.dq_head(V2, V0, phead, m) = X3 proof
      assume e
      have c: C by taut(hd, e)
      have i1 := mp(tr.ite_t[c := C, a := mallocng_specs.wr64(V2, phead, N), b := V2], c)
      have i2 := mp(tr.ite_t[c := m = H, a := mallocng_specs.wr64(V2, phead, N), b := V2], e)
      show trans(i1, sym(i2))
    qed
    have f: !(m = H) -> mallocng_specs.dq_head(V2, V0, phead, m) = X3 proof
      assume e
      have c: !C by taut(hd, e)
      have i1 := mp(tr.ite_f[c := C, a := mallocng_specs.wr64(V2, phead, N), b := V2], c)
      have i2 := mp(tr.ite_f[c := m = H, a := mallocng_specs.wr64(V2, phead, N), b := V2], e)
      show trans(i1, sym(i2))
    qed
    show by taut(t, f)
  qed
  have d0: mallocng_specs.dequeue_vm(V0, phead, m) = mallocng_specs.wr64(mallocng_specs.wr64(mallocng_specs.dq_head(mallocng_specs.dq_links(V0, phead, m), V0, phead, m), M8, 0), m, 0)
    by defs(refl({mallocng_specs.wr64(mallocng_specs.wr64(mallocng_specs.dq_head(mallocng_specs.dq_links(V0, phead, m), V0, phead, m), M8, 0), m, 0)}), mallocng_specs.dequeue_vm)
  have dv := rewrite(dh, rewrite(dl, d0))
  show := rewrite(sym(dv), oe)
qed

// C2 of dequeue: its readable GIMPLE refines its spec, on every world
theorem ms.dequeue_c2: all phead m. phead in bits(64) -> m in bits(64) ->
  refines(c_src_malloc_mallocng_malloc.dequeue(phead, m), mallocng_specs.dequeue_spec(phead, m), abi.World)
proof
  fix phead m
  assume hph hm
  have g: all s o. s in abi.World -> runs(c_src_malloc_mallocng_malloc.dequeue(phead, m), s, o) -> runs(mallocng_specs.dequeue_spec(phead, m), s, o) proof
    fix s o
    assume hw hr
    let V0 := app(s, "vm")
    let N := mallocng_specs.mnext(V0, m)
    let M8 := bits_add(64, m, 8)
    have pu := apply(g.runs_univ, hr)
    have hu: s in univ(1) by simp(pu)
    let SPEC := mallocng_specs.dequeue_spec(phead, m)
    have np: !mallocng_specs.dequeue_pre(V0, app(s, "objs"), phead, m) -> runs(SPEC, s, o) proof
      assume hn
      show by simp(pu, hn, keep(abi.overflow, mallocng_specs.dequeue_pre, mallocng_specs.dequeue_vm))
    qed
    have yp: mallocng_specs.dequeue_pre(V0, app(s, "objs"), phead, m) -> runs(SPEC, s, o) proof
        assume hp
        have alone: m = N -> o = ok(fn_update(s, "vm", mallocng_specs.dequeue_vm(V0, phead, m)), empty) proof
          assume e
          have oe := apply(ms.dq_alone, {phead}, {m}, {s}, {o}, hph, hm, hw, hu, hp, e, hr)
          have nn: !!(N = m) by taut(e)
          have nc: !(!(N = m) && mallocng_specs.rd64(mallocng_specs.wr64(V0, phead, 0), phead) = m) by taut(nn)
          have dl: mallocng_specs.dq_links(V0, phead, m) = mallocng_specs.wr64(V0, phead, 0)
            by defs(mp(tr.ite_f[c := !(N = m), a := mallocng_specs.wr64(mallocng_specs.wr64(V0, bits_add(64, mallocng_specs.mprev(V0, m), 8), N), N, mallocng_specs.mprev(V0, m)),
              b := mallocng_specs.wr64(V0, phead, 0)], nn), mallocng_specs.dq_links)
          have dh: mallocng_specs.dq_head(mallocng_specs.wr64(V0, phead, 0), V0, phead, m) = mallocng_specs.wr64(V0, phead, 0)
            by defs(mp(tr.ite_f[c := !(N = m) && mallocng_specs.rd64(mallocng_specs.wr64(V0, phead, 0), phead) = m, a := mallocng_specs.wr64(mallocng_specs.wr64(V0, phead, 0), phead, N),
              b := mallocng_specs.wr64(V0, phead, 0)], nc), mallocng_specs.dq_head)
          have d0: mallocng_specs.dequeue_vm(V0, phead, m) = mallocng_specs.wr64(mallocng_specs.wr64(mallocng_specs.dq_head(mallocng_specs.dq_links(V0, phead, m), V0, phead, m), M8, 0), m, 0)
            by defs(refl({mallocng_specs.wr64(mallocng_specs.wr64(mallocng_specs.dq_head(mallocng_specs.dq_links(V0, phead, m), V0, phead, m), M8, 0), m, 0)}), mallocng_specs.dequeue_vm)
          have dv := rewrite(dh, rewrite(dl, d0))
          show := rewrite(sym(dv), oe)
        qed
        have linked: !(m = N) -> o = ok(fn_update(s, "vm", mallocng_specs.dequeue_vm(V0, phead, m)), empty) proof
          assume e
          show := apply(ms.dq_linked, {phead}, {m}, {s}, {o}, hph, hm, hw, hu, hp, e, hr)
        qed
        have oe: o = ok(fn_update(s, "vm", mallocng_specs.dequeue_vm(V0, phead, m)), empty) by taut(alone, linked)
        show by simp(oe, pu, hp, keep(abi.overflow, mallocng_specs.dequeue_pre, mallocng_specs.dequeue_vm))
    qed
    show by taut(np, yp)
  qed
  show g
qed

// ----------------------------------------------------------------------
//  dequeue_head: from dequeue's contract

// dequeue as a C function value: its register wrapper refines the spec's
theorem ms.dequeue_fun_c2: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
  runs(app(c_src_malloc_mallocng_malloc.dequeue_fun, regs), s, o) -> runs(app(mallocng_specs.dequeue_spec_fun, regs), s, o)
proof
  fix regs s o
  assume hr hl hw h
  have lo: seq_len(regs) in omega by simp(hr)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(hl, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(hr, ol, keep(ord_le))
  rsimp only, c_src_malloc_mallocng_malloc.dequeue_fun, app_fn_build, ra in h
  rsimp only, mallocng_specs.dequeue_spec_fun, app_fn_build, ra
  have pu := apply(g.runs_univ, h)
  have r := apply(g.runs_elim, h)
  have a0: bits_of_int(64, app(regs, 0)) in bits(64) by simp()
  have a1: bits_of_int(64, app(regs, 1)) in bits(64) by simp()
  have dc := expand(all_elim(ms.dequeue_c2, {bits_of_int(64, app(regs, 0))}, {bits_of_int(64, app(regs, 1))}), refines)
  have hm: all o2. runs(c_src_malloc_mallocng_malloc.dequeue(bits_of_int(64, app(regs, 0)), bits_of_int(64, app(regs, 1))), s, o2) ->
      runs(mallocng_specs.dequeue_spec(bits_of_int(64, app(regs, 0)), bits_of_int(64, app(regs, 1))), s, o2) proof
    fix o2
    assume h2
    show := mp(all_elim(mp(dc, a0, a1), {s}, {o2}), hw, h2)
  qed
  have c1: !ord_le(2, seq_len(regs)) -> runs(mkprog(x1 x2. !ord_le(2, seq_len(regs)) || bind_rel(mallocng_specs.dequeue_spec(bits_of_int(64, app(regs, 0)), bits_of_int(64, app(regs, 1))), x1,
      x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. x2 = ok(x3, pair(x5, x6)))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), s, o) proof
    assume hn
    show by apply(tr.runs_intro, pu, taut(hn))
  qed
  have c2: bind_rel(c_src_malloc_mallocng_malloc.dequeue(bits_of_int(64, app(regs, 0)), bits_of_int(64, app(regs, 1))), s,
      x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o = ok(x3, pair(x5, x6)))), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) ->
      runs(mkprog(x1 x2. !ord_le(2, seq_len(regs)) || bind_rel(mallocng_specs.dequeue_spec(bits_of_int(64, app(regs, 0)), bits_of_int(64, app(regs, 1))), x1,
      x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. x2 = ok(x3, pair(x5, x6)))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), s, o) proof
    assume hb
    have b2 := apply(g.bind_mono, hm, hb)
    show by apply(tr.runs_intro, pu, taut(b2))
  qed
  show by taut(r, c1, c2)
qed

// dequeue's contract at a call dequeue(phead, m) (its spec's register
// wrapper, on a world where its precondition holds): an overflow (the
// memory any), or the return with dequeue's effect
theorem ms.dqs_q: all regs s phead m o2. phead in bits(64) -> m in bits(64) -> s in abi.World -> s in univ(1) ->
  mallocng_specs.dequeue_pre(app(s, "vm"), app(s, "objs"), phead, m) ->
  gc.regs_ok(regs, seq_concat(seq_one(gimple.arg(64, phead)), seq_one(gimple.arg(64, m)))) ->
  runs(app(mallocng_specs.dequeue_spec_fun, regs), s, o2) ->
  (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex r. o2 = ok(fn_update(s, "vm", mallocng_specs.dequeue_vm(app(s, "vm"), phead, m)), r))
proof
  fix regs s phead m o2
  assume hp hm hw hu hpre hr h
  have rl rn r0 r1 := apply(gc.regs2, hp, hm, hr)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, mallocng_specs.dequeue_spec_fun, app_fn_build, ra in h
  have vv: ex x. x in x86_64_linux.Vm by ex_intro({app(s, "vm")}, simp(expand(hw, abi.World)))
  show by simp(h, r0, r1, rn, hp, hm, hpre, vv, keep(mallocng_specs.dequeue_pre, mallocng_specs.dequeue_vm))
qed

// (memories after words written: memories)
theorem ms.wr_vm: all vm a v. vm in x86_64_linux.Vm -> vm in univ(1) -> a in bits(64) ->
  mallocng_specs.wr64(vm, a, v) in x86_64_linux.Vm && mallocng_specs.wr64(vm, a, v) in univ(1)
proof
  fix vm a v
  assume hv hu ha
  have su := apply(g.store_univ, {vm}, {a}, {8}, {v}, hv)
  have nu: fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, 8, v)) in univ(1) by simp(hu, su)
  have nv := apply(x86.store_vm, {vm}, {a}, {8}, {v}, hv, nu)
  show conj(nv, nu)
qed

theorem ms.dqvm_vm: all vm phead m. vm in x86_64_linux.Vm -> vm in univ(1) -> phead in bits(64) -> m in bits(64) ->
  mallocng_specs.dequeue_vm(vm, phead, m) in x86_64_linux.Vm && mallocng_specs.dequeue_vm(vm, phead, m) in univ(1)
proof
  fix vm phead m
  assume hv hu hph hm
  let N := mallocng_specs.mnext(vm, m)
  let P := mallocng_specs.mprev(vm, m)
  have hN: N in bits(64) by defs(simp(), mallocng_specs.mnext, mallocng_specs.rd64)
  have hP: P in bits(64) by defs(simp(), mallocng_specs.mprev, mallocng_specs.rd64)
  have hP8: bits_add(64, P, 8) in bits(64) by arith(hP)
  have hm8: bits_add(64, m, 8) in bits(64) by arith(hm)
  have a1 a2 := apply(ms.wr_vm, {vm}, {bits_add(64, P, 8)}, {N}, hv, hu, hP8)
  have b1 b2 := apply(ms.wr_vm, {mallocng_specs.wr64(vm, bits_add(64, P, 8), N)}, {N}, {P}, a1, a2, hN)
  have c1 c2 := apply(ms.wr_vm, {vm}, {phead}, {0}, hv, hu, hph)
  let L := mallocng_specs.dq_links(vm, phead, m)
  have l1: L in x86_64_linux.Vm by apply(ite_in, b1, c1)
  have l2: L in univ(1) by apply(ite_in, b2, c2)
  have d1 d2 := apply(ms.wr_vm, {L}, {phead}, {N}, l1, l2, hph)
  let H := mallocng_specs.dq_head(L, vm, phead, m)
  have h1: H in x86_64_linux.Vm by apply(ite_in, d1, l1)
  have h2: H in univ(1) by apply(ite_in, d2, l2)
  have e1 e2 := apply(ms.wr_vm, {H}, {bits_add(64, m, 8)}, {0}, h1, h2, hm8)
  have f1 f2 := apply(ms.wr_vm, {mallocng_specs.wr64(H, bits_add(64, m, 8), 0)}, {m}, {0}, e1, e2, hm)
  show conj(f1, f2)
qed

// dequeue_head's contract from dequeue's: for every callee refining
// dequeue's spec (as a C function value), dequeue_head's readable GIMPLE
// refines its spec
theorem ms.dequeue_head_c2: all phead g. phead in bits(64) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(app(g, regs), s, o) -> runs(app(mallocng_specs.dequeue_spec_fun, regs), s, o)) ->
  refines(c_src_malloc_mallocng_malloc.dequeue_head(phead, g), mallocng_specs.dequeue_head_spec(phead), abi.World)
proof
  fix phead g
  assume hph hg
  show proof
    fix s o
    assume hw hr
    let V0 := app(s, "vm")
    let SPEC := mallocng_specs.dequeue_head_spec(phead)
    let M := mallocng_specs.rd64(V0, phead)
    let DV := mallocng_specs.dequeue_vm(V0, phead, M)
    let OVF := exc_val("stack_overflow", empty)
    have pu := apply(g.runs_univ, hr)
    have hu: s in univ(1) by simp(pu)
    have vV vfun vdom .. := apply(ms.world_parts, hw)
    have ss: fn_update(s, "vm", V0) = s := mp(fn_update_same[f := s, k := "vm"], vfun, vdom)
    have np: !mallocng_specs.dequeue_head_pre(V0, app(s, "objs"), app(s, "fs_base"), phead) -> runs(SPEC, s, o) proof
      assume hn
      show by simp(pu, hn, keep(abi.overflow, mallocng_specs.dequeue_head_pre, mallocng_specs.dequeue_head_vm, mallocng_specs.rd64))
    qed
    have yp: mallocng_specs.dequeue_head_pre(V0, app(s, "objs"), app(s, "fs_base"), phead) -> runs(SPEC, s, o) proof
      assume hp
      have kh hcall := expand(hp, mallocng_specs.dequeue_head_pre)
      // (the spec's outcomes: an overflow, any memory; the head returned, dequeued)
      have sov: all v. v in x86_64_linux.Vm -> runs(SPEC, s, exc(fn_update(s, "vm", v), OVF)) proof
        fix v
        assume hv
        have vu := apply(x86.vm_univ, hv)
        have eu: OVF in univ(1) by defs(simp(), exc_val)
        have pu2: pair(s, exc(fn_update(s, "vm", v), OVF)) in univ(1) by simp(hu, vu, eu)
        have ovi := apply(ct.overflow_intro, hv, pu2)
        show by simp(hp, ovi, pu2, keep(abi.overflow, mallocng_specs.dequeue_head_pre, mallocng_specs.dequeue_head_vm, mallocng_specs.rd64))
      qed
      // the run: the locals' choices, then *phead loaded
      have ne64: ex x. x in bits(64) by ex_intro({0}, simp())
      obtain x2, h2b h2l from apply(g.any_e, ne64, apply(g.runs_elim, hr))
      have l2 := apply(g.letin_e, h2l)
      obtain x4, h4b h4l from apply(g.any_e, ne64, l2)
      have l4 := apply(g.letin_e, h4l)
      have zp: bits_add(64, phead, 0) = phead by simp(hph)
      have ld := rewrite(zp, apply(ms.ld_det, {s}, {phead}, {0}, hu, hph, simp(), kh))
      have l6 := apply(g.bind_inv, l4, ld)
      obtain x9, hd he from apply(g.letin_e, l6)
      // no head: nothing done, 0 returned
      have z: M = 0 -> runs(SPEC, s, o) proof
        assume e0
        have x9e: x9 = ok(pair(s, pair(M, x4)), empty) by simp(hd, e0)
        have oe: o = ok(s, M) by simp(rewrite(x9e, he))
        have dv: mallocng_specs.dequeue_head_vm(V0, phead) = V0 by rsimp(mallocng_specs.dequeue_head_vm, e0)
        show by simp(pu, oe, hp, dv, ss, e0, keep(abi.overflow, mallocng_specs.dequeue_head_pre, mallocng_specs.dequeue_head_vm, mallocng_specs.rd64))
      qed
      // a head: dequeued by the call (its contract: dequeue's), returned
      have nz: !(M = 0) -> runs(SPEC, s, o) proof
        assume hn
        have dpre ths := mp(hcall, hn)
        have b := apply(g.pick, hd, hn, (!!!(M = 0) by taut(hn)))
        have mb: M in bits(64) by defs(simp(), mallocng_specs.rd64)
        // the call: dequeue's contract -- an overflow, or M dequeued
        have vu0 := apply(x86.vm_univ, vV)
        have dv1 dv2 := apply(ms.dqvm_vm, vV, vu0, hph, mb)
        have qa: all regs o2. gc.regs_ok(regs, seq_concat(seq_one(gimple.arg(64, phead)), seq_one(gimple.arg(64, M)))) -> runs(app(mallocng_specs.dequeue_spec_fun, regs), s, o2) ->
            (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(s, "vm", v), OVF)) || (ex r. o2 = ok(fn_update(s, "vm", DV), r)) proof
          fix regs o2
          assume hro h2
          show := apply(ms.dqs_q, hph, mb, hw, hu, dpre, hro, h2)
        qed
        have cc := apply(gc.contract_call, ths, hw, dv1, apply(gc.regs2_ex, hph, mb), arith(), hg, qa, b)
        // (the rest: M returned)
        have c1: (ex v. v in x86_64_linux.Vm && x9 = exc(pair(fn_update(s, "vm", v), pair(M, x4)), pair("raise", OVF))) -> runs(SPEC, s, o) proof
          assume h
          obtain v, hv hx from h
          have oe: o = exc(fn_update(s, "vm", v), OVF) by simp(rewrite(hx, he))
          show := rewrite(sym(oe), mp(all_elim(sov, {v}), hv))
        qed
        have c2: (ex r. x9 = ok(pair(fn_update(s, "vm", DV), pair(M, x4)), empty)) -> runs(SPEC, s, o) proof
          assume h
          obtain r, hx from h
          have oe: o = ok(fn_update(s, "vm", DV), M) by simp(rewrite(hx, he))
          have dv: mallocng_specs.dequeue_head_vm(V0, phead) = DV by rsimp(mallocng_specs.dequeue_head_vm, hn)
          have sok: runs(SPEC, s, ok(fn_update(s, "vm", DV), M)) by simp(pu, hp, dv, dv2, mb, keep(abi.overflow, mallocng_specs.dequeue_head_pre, mallocng_specs.dequeue_head_vm, mallocng_specs.rd64, mallocng_specs.dequeue_vm))
          show := rewrite(sym(oe), sok)
        qed
        show by taut(cc, c1, c2)
      qed
      show by taut(z, nz)
    qed
    show by taut(np, yp)
  qed
qed

// ... with musl's dequeue as the callee
theorem ms.dequeue_head_c2_dq: all phead. phead in bits(64) ->
  refines(c_src_malloc_mallocng_malloc.dequeue_head(phead, c_src_malloc_mallocng_malloc.dequeue_fun), mallocng_specs.dequeue_head_spec(phead), abi.World)
proof
  fix phead
  assume hph
  show := mp(all_elim(ms.dequeue_head_c2, {phead}, {c_src_malloc_mallocng_malloc.dequeue_fun}), hph, ms.dequeue_fun_c2)
qed

// dequeue_head as a C function value: its register wrapper refines the spec's
// (dequeue_head's spec returns a word, under its precondition)
theorem ms.dqh_word: all phead s s1 v. s in abi.World -> runs(mallocng_specs.dequeue_head_spec(phead), s, ok(s1, v)) ->
  mallocng_specs.dequeue_head_pre(app(s, "vm"), app(s, "objs"), app(s, "fs_base"), phead) -> v in bits(64)
proof
  fix phead s s1 v
  assume hw h hp
  have vv: ex x. x in x86_64_linux.Vm by ex_intro({app(s, "vm")}, simp(expand(hw, abi.World)))
  have no: all x. !runs(abi.overflow, s, ok(s1, x)) proof
    fix x
    have c: runs(abi.overflow, s, ok(s1, x)) -> false proof
      assume ho
      show by simp(ho, vv)
    qed
    show by taut(c)
  qed
  have e: v = mallocng_specs.rd64(app(s, "vm"), phead) by simp(h, hp, no, keep(abi.overflow, mallocng_specs.dequeue_head_pre, mallocng_specs.dequeue_head_vm, mallocng_specs.rd64))
  have b: mallocng_specs.rd64(app(s, "vm"), phead) in bits(64) by defs(simp(), mallocng_specs.rd64)
  show := rewrite(sym(e), b)
qed

theorem ms.dequeue_head_fun_c2: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
  runs(app(c_src_malloc_mallocng_malloc.dequeue_head_fun(c_src_malloc_mallocng_malloc.dequeue_fun()), regs), s, o) -> runs(app(mallocng_specs.dequeue_head_spec_fun, regs), s, o)
proof
  fix regs s o
  assume hr hl hw h
  have lo: seq_len(regs) in omega by simp(hr)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(hl, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(hr, ol, keep(ord_le))
  rsimp only, c_src_malloc_mallocng_malloc.dequeue_head_fun, app_fn_build, ra in h
  rsimp only, mallocng_specs.dequeue_head_spec_fun, app_fn_build, ra
  have pu := apply(g.runs_univ, h)
  have su: s in univ(1) by simp(pu)
  have r := apply(g.runs_elim, h)
  have a0: bits_of_int(64, app(regs, 0)) in bits(64) by simp()
  have c1: !ord_le(1, seq_len(regs)) -> runs(mkprog(x0 x1. !ord_le(1, seq_len(regs)) || bind_rel(mallocng_specs.dequeue_head_spec(bits_of_int(64, app(regs, 0))), x0, x2 x3. letin(x3, x4. any_rel(x5. x5 in bits(64), x5. x1 = ok(x2, pair(x4, x5)))), x2 x3. x1 = exc(x2, x3), x2. x1 = diverge(x2))), s, o) proof
    assume hn
    show by apply(tr.runs_intro, pu, taut(hn))
  qed
  // the precondition: the spec's run is the code's (C2), its result a word
  have c2: mallocng_specs.dequeue_head_pre(app(s, "vm"), app(s, "objs"), app(s, "fs_base"), bits_of_int(64, app(regs, 0))) -> bind_rel(c_src_malloc_mallocng_malloc.dequeue_head(bits_of_int(64, app(regs, 0)), c_src_malloc_mallocng_malloc.dequeue_fun), s, x2 x3. letin(x3, x4. bind_rel(gimple.result(64, x4), x2, x5 x6. any_rel(x7. x7 in bits(64), x7. o = ok(x5, pair(x6, x7))), x5 x6. o = exc(x5, x6), x5. o = diverge(x5))), x2 x3. o = exc(x2, x3), x2. o = diverge(x2)) -> runs(mkprog(x0 x1. !ord_le(1, seq_len(regs)) || bind_rel(mallocng_specs.dequeue_head_spec(bits_of_int(64, app(regs, 0))), x0, x2 x3. letin(x3, x4. any_rel(x5. x5 in bits(64), x5. x1 = ok(x2, pair(x4, x5)))), x2 x3. x1 = exc(x2, x3), x2. x1 = diverge(x2))), s, o) proof
    assume hp hb
    have dc := expand(all_elim(ms.dequeue_head_c2_dq, {bits_of_int(64, app(regs, 0))}), refines)
    have hm: all o2. runs(c_src_malloc_mallocng_malloc.dequeue_head(bits_of_int(64, app(regs, 0)), c_src_malloc_mallocng_malloc.dequeue_fun), s, o2) -> runs(mallocng_specs.dequeue_head_spec(bits_of_int(64, app(regs, 0))), s, o2) proof
      fix o2
      assume h2
      show := mp(all_elim(mp(dc, a0), {s}, {o2}), hw, h2)
    qed
    have b2 := apply(g.bind_mono, hm, hb)
    have kk: all s1 v. runs(mallocng_specs.dequeue_head_spec(bits_of_int(64, app(regs, 0))), s, ok(s1, v)) -> letin(v, x4. bind_rel(gimple.result(64, x4), s1, x5 x6. any_rel(x7. x7 in bits(64), x7. o = ok(x5, pair(x6, x7))), x5 x6. o = exc(x5, x6), x5. o = diverge(x5))) ->
        letin(v, x4. any_rel(x5. x5 in bits(64), x5. o = ok(s1, pair(x4, x5)))) proof
      fix s1 v
      assume hs hk
      have vb := apply(ms.dqh_word, hw, hs, hp)
      obtain o3, h3 hc from expand(apply(g.letin_e, hk), bind_rel)
      have e3 := apply(g.result64_inv, vb, h3)
      have hc2 := rewrite(e3, hc)
      have k: any_rel(x7. x7 in bits(64), x7. o = ok(s1, pair(v, x7))) by simp(hc2, keep(any_rel))
      show by defs(k, letin)
    qed
    have b3 := apply(g.bind_cont, kk, b2)
    show by apply(tr.runs_intro, pu, taut(b3))
  qed
  // no precondition: the spec allows every outcome, the code's too
  have c3: !mallocng_specs.dequeue_head_pre(app(s, "vm"), app(s, "objs"), app(s, "fs_base"), bits_of_int(64, app(regs, 0))) -> bind_rel(c_src_malloc_mallocng_malloc.dequeue_head(bits_of_int(64, app(regs, 0)), c_src_malloc_mallocng_malloc.dequeue_fun), s, x2 x3. letin(x3, x4. bind_rel(gimple.result(64, x4), x2, x5 x6. any_rel(x7. x7 in bits(64), x7. o = ok(x5, pair(x6, x7))), x5 x6. o = exc(x5, x6), x5. o = diverge(x5))), x2 x3. o = exc(x2, x3), x2. o = diverge(x2)) -> runs(mkprog(x0 x1. !ord_le(1, seq_len(regs)) || bind_rel(mallocng_specs.dequeue_head_spec(bits_of_int(64, app(regs, 0))), x0, x2 x3. letin(x3, x4. any_rel(x5. x5 in bits(64), x5. x1 = ok(x2, pair(x4, x5)))), x2 x3. x1 = exc(x2, x3), x2. x1 = diverge(x2))), s, o) proof
    assume hn hb
    have any: all o2. pair(s, o2) in univ(1) -> runs(mallocng_specs.dequeue_head_spec(bits_of_int(64, app(regs, 0))), s, o2) proof
      fix o2
      assume hu
      show by simp(hu, hn, keep(abi.overflow, mallocng_specs.dequeue_head_pre, mallocng_specs.dequeue_head_vm, mallocng_specs.rd64))
    qed
    obtain o1, h1 hc from expand(hb, bind_rel, {1})
    have pu1 := apply(g.runs_univ, expand(h1, c_src_malloc_mallocng_malloc.dequeue_head))
    // (the first step's outcome o1 is the spec's: but for a return, whose
    // value the result step turns into rax)
    have q1: (ex s1 v. o1 = ok(s1, v) && letin(v, x4. bind_rel(gimple.result(64, x4), s1, x5 x6. any_rel(x7. x7 in bits(64), x7. o = ok(x5, pair(x6, x7))), x5 x6. o = exc(x5, x6), x5. o = diverge(x5)))) ->
        bind_rel(mallocng_specs.dequeue_head_spec(bits_of_int(64, app(regs, 0))), s, x2 x3. letin(x3, x4. any_rel(x5. x5 in bits(64), x5. o = ok(x2, pair(x4, x5)))), x2 x3. o = exc(x2, x3), x2. o = diverge(x2)) proof
      assume e
      obtain s1 v, eo hk from e
      obtain o3, h3 hc3 from expand(apply(g.letin_e, hk), bind_rel)
      have pu3 := apply(g.runs_univ, expand(h3, gimple.result))
      have r1: (ex x5 x6. o3 = ok(x5, x6) && any_rel(x7. x7 in bits(64), x7. o = ok(x5, pair(x6, x7)))) -> bind_rel(mallocng_specs.dequeue_head_spec(bits_of_int(64, app(regs, 0))), s, x2 x3. letin(x3, x4. any_rel(x5. x5 in bits(64), x5. o = ok(x2, pair(x4, x5)))), x2 x3. o = exc(x2, x3), x2. o = diverge(x2)) proof
        assume e2
        obtain x5 x6, eo3 ha from e2
        have u: pair(s, ok(x5, x6)) in univ(1) by simp(rewrite(eo3, pu3), su)
        have sr := mp(all_elim(any, {ok(x5, x6)}), u)
        show by defs(ex_intro({ok(x5, x6)}, simp(sr, ha, keep(mallocng_specs.dequeue_head_spec, any_rel))), bind_rel)
      qed
      have r2: (ex x5 x6. o3 = exc(x5, x6) && o = exc(x5, x6)) -> bind_rel(mallocng_specs.dequeue_head_spec(bits_of_int(64, app(regs, 0))), s, x2 x3. letin(x3, x4. any_rel(x5. x5 in bits(64), x5. o = ok(x2, pair(x4, x5)))), x2 x3. o = exc(x2, x3), x2. o = diverge(x2)) proof
        assume e2
        obtain x5 x6, eo3 eo from e2
        have u: pair(s, exc(x5, x6)) in univ(1) by simp(rewrite(eo3, pu3), su)
        have sr := mp(all_elim(any, {exc(x5, x6)}), u)
        show by defs(ex_intro({exc(x5, x6)}, simp(sr, eo, keep(mallocng_specs.dequeue_head_spec))), bind_rel)
      qed
      have r3: (ex t. o3 = diverge(t) && o = diverge(t)) -> bind_rel(mallocng_specs.dequeue_head_spec(bits_of_int(64, app(regs, 0))), s, x2 x3. letin(x3, x4. any_rel(x5. x5 in bits(64), x5. o = ok(x2, pair(x4, x5)))), x2 x3. o = exc(x2, x3), x2. o = diverge(x2)) proof
        assume e2
        obtain t, eo3 eo from e2
        have u: pair(s, diverge(t)) in univ(1) by simp(rewrite(eo3, pu3), su)
        have sr := mp(all_elim(any, {diverge(t)}), u)
        show by defs(ex_intro({diverge(t)}, simp(sr, eo, keep(mallocng_specs.dequeue_head_spec))), bind_rel)
      qed
      show by taut(hc3, r1, r2, r3)
    qed
    have q2: (ex s1 e. o1 = exc(s1, e) && o = exc(s1, e)) -> bind_rel(mallocng_specs.dequeue_head_spec(bits_of_int(64, app(regs, 0))), s, x2 x3. letin(x3, x4. any_rel(x5. x5 in bits(64), x5. o = ok(x2, pair(x4, x5)))), x2 x3. o = exc(x2, x3), x2. o = diverge(x2)) proof
      assume e
      obtain s1 e1, eo eo2 from e
      have sr := mp(all_elim(any, {o1}), pu1)
      show by defs(ex_intro({o1}, simp(sr, eo, eo2, keep(mallocng_specs.dequeue_head_spec))), bind_rel)
    qed
    have q3: (ex t. o1 = diverge(t) && o = diverge(t)) -> bind_rel(mallocng_specs.dequeue_head_spec(bits_of_int(64, app(regs, 0))), s, x2 x3. letin(x3, x4. any_rel(x5. x5 in bits(64), x5. o = ok(x2, pair(x4, x5)))), x2 x3. o = exc(x2, x3), x2. o = diverge(x2)) proof
      assume e
      obtain t, eo eo2 from e
      have sr := mp(all_elim(any, {o1}), pu1)
      show by defs(ex_intro({o1}, simp(sr, eo, eo2, keep(mallocng_specs.dequeue_head_spec))), bind_rel)
    qed
    have b3: bind_rel(mallocng_specs.dequeue_head_spec(bits_of_int(64, app(regs, 0))), s, x2 x3. letin(x3, x4. any_rel(x5. x5 in bits(64), x5. o = ok(x2, pair(x4, x5)))), x2 x3. o = exc(x2, x3), x2. o = diverge(x2)) by taut(hc, q1, q2, q3)
    show by apply(tr.runs_intro, pu, taut(b3))
  qed
  show by taut(r, c1, c2, c3)
qed

// ----------------------------------------------------------------------
//  queue

// m unlinked (else a_crash, which the precondition excludes): the list
// empty -- m alone, the head --, or m before the head H, after H's prev P
theorem ms.qu_run: all phead m g s o. phead in bits(64) -> m in bits(64) -> s in abi.World -> s in univ(1) ->
  mallocng_specs.queue_pre(app(s, "vm"), app(s, "objs"), phead, m) ->
  runs(c_src_malloc_mallocng_malloc.queue(phead, m, g), s, o) ->
  o = ok(fn_update(s, "vm", mallocng_specs.queue_vm(app(s, "vm"), phead, m)), empty)
proof
  fix phead m g s o
  assume hph hm hw hu hpre hr
  let V0 := app(s, "vm")
  let OB := app(s, "objs")
  let M8 := bits_add(64, m, 8)
  let H := mallocng_specs.rd64(V0, phead)
  have kh km0 km8 ah am n0 p0 hl := hpre
  have hH: H in bits(64) by defs(simp(), mallocng_specs.rd64)
  have _ mlt .. := km8
  have am8 em8 hm8 := apply(ms.al8_add, {m}, hm, am, mlt)
  have zp: bits_add(64, phead, 0) = phead by simp(hph)
  // m's links: 0 -- no a_crash
  have h0 := apply(g.runs_elim, hr)
  have ne64: ex x. x in bits(64) by ex_intro({0}, simp())
  obtain x2, h2b h2l from apply(g.any_e, ne64, h0)
  have l2 := apply(g.letin_e, h2l)
  have d0 := apply(ms.next_det, {s}, {m}, hu, hm, km8)
  obtain x7, hc hrest from apply(g.letin_e, apply(g.bind_inv, l2, d0))
  have e7 := apply(g.pick2, hc, (!!(mallocng_specs.mnext(V0, m) = 0) by taut(n0)), (!!(mallocng_specs.mnext(V0, m) = 0) by taut(n0)))
  have os := all_elim(g.ok_state, {pair(s, x2)}, {empty})
  have h1 := apply(g.pick0, rewrite(e7, hrest), simp(os), simp(os))
  have fp: fst(pair(s, x2)) = s by rsimp()
  have d1 := apply(ms.prev_det, {s}, {m}, hu, hm, km0)
  have q11 := apply(g.letin_e, apply(g.bind_inv, rewrite(fp, rewrite(os.1, h1)), d1))
  obtain x11, hc2 hrest2 from q11
  have e11 := apply(g.pick2, hc2, (!!(mallocng_specs.mprev(V0, m) = 0) by taut(p0)), (!!(mallocng_specs.mprev(V0, m) = 0) by taut(p0)))
  have os2 := all_elim(g.ok_state, {pair(s, snd(pair(s, x2)))}, {empty})
  have fp2: fst(pair(s, snd(pair(s, x2)))) = s by rsimp()
  have h3 := apply(g.pick0, rewrite(e11, hrest2), simp(os2), simp(os2))
  // *phead
  have d2 := rewrite(zp, apply(ms.ld_det, {s}, {phead}, {0}, hu, hph, simp(), kh))
  obtain x15, hc3 hrest3 from apply(g.letin_e, apply(g.bind_inv, rewrite(fp2, rewrite(os2.1, h3)), d2))
  // the list empty: m alone, the head
  have emp: H = 0 -> o = ok(fn_update(s, "vm", mallocng_specs.queue_vm(V0, phead, m)), empty) proof
    assume hz
    have e15 := apply(g.pick2, hc3, (!!(H = 0) by taut(hz)), (!!(H = 0) by taut(hz)))
    have os3 := all_elim(g.ok_state, {pair(s, snd(pair(s, snd(pair(s, x2)))))}, {empty})
    have fp3: fst(pair(s, snd(pair(s, snd(pair(s, x2)))))) = s by rsimp()
    have h4 := rewrite(fp3, rewrite(os3.1, apply(g.pick0, rewrite(e15, hrest3), simp(os3), simp(os3))))
    // m.next := m
    have t1 := apply(g.bind_inv, h4, apply(ms.setnext_det, {s}, {m}, {m}, hw, hu, hm, km8))
    let V1 := mallocng_specs.wr64(V0, M8, m)
    let S1 := fn_update(s, "vm", V1)
    have w1 u1 := apply(ms.world_wr, {s}, {M8}, {m}, hw, hu, hm8)
    have sv1: app(S1, "vm") = V1 by rsimp()
    have km8_1: mallocng_specs.word_ok(app(S1, "vm"), app(S1, "objs"), m, 8) by simp(apply(ms.word_wr, {V0}, {OB}, {m}, {8}, {M8}, {m}, km8))
    have km0_1: mallocng_specs.word_ok(app(S1, "vm"), app(S1, "objs"), m, 0) by simp(apply(ms.word_wr, {V0}, {OB}, {m}, {0}, {M8}, {m}, km0))
    have kh_1: mallocng_specs.word_ok(app(S1, "vm"), app(S1, "objs"), phead, 0) by simp(apply(ms.word_wr, {V0}, {OB}, {phead}, {0}, {M8}, {m}, kh))
    // t8 := m.next (m, just written); m.prev := t8
    have bt0 := apply(ms.world_parts, hw).4
    have r1a: mallocng_specs.mnext(V1, m) = m := trans(all_elim(ms.mnext_def, {V1}, {m}), apply(ms.rd_wr_same, {V0}, {M8}, {m}, simp(bt0), hm8, hm))
    have t2 := rewrite(rewrite(sym(sv1), r1a), apply(g.letin_e, apply(g.bind_inv, t1, apply(ms.next_det, {S1}, {m}, u1, hm, km8_1))))
    have t3 := rewrite(all_elim(ms.upd, {s}, {V1}, {m}, {m}), apply(g.bind_inv, t2, apply(ms.setprev_det, {S1}, {m}, {m}, w1, u1, hm, km0_1)))
    let V2 := mallocng_specs.wr64(V1, m, m)
    let S2 := fn_update(s, "vm", V2)
    have w2 u2 := apply(ms.sw, {s}, {V1}, {m}, {m}, w1, u1, hm)
    have kh_2: mallocng_specs.word_ok(app(S2, "vm"), app(S2, "objs"), phead, 0) by simp(apply(ms.word_wr, {V1}, {OB}, {phead}, {0}, {m}, {m}, simp(kh_1)))
    // *phead := m
    have t4 := rewrite(all_elim(ms.upd, {s}, {V2}, {phead}, {m}), rewrite(zp, apply(g.bind_inv, t3, apply(ms.st_det, {S2}, {phead}, {0}, {m}, w2, u2, hph, simp(), kh_2))))
    // the spec's effect: the same memory
    have qv: mallocng_specs.queue_vm(V0, phead, m) = mallocng_specs.wr64(V2, phead, m) by defs(simp(hz), mallocng_specs.queue_vm)
    show by simp(t4, qv)
  qed
  // the list not empty: m between H's prev P and H
  have lnk: !(H = 0) -> o = ok(fn_update(s, "vm", mallocng_specs.queue_vm(V0, phead, m)), empty) proof
    assume nn
    let P := mallocng_specs.mprev(V0, H)
    let PA := bits_add(64, P, 8)
    have kH0 aH kP8 aP nHm8 nPm := mp(hl, nn)
    have hP: P in bits(64) by defs(simp(), mallocng_specs.mprev, mallocng_specs.rd64)
    have _ plt .. := kP8
    have apa epa hpa := apply(ms.al8_add, {P}, hP, aP, plt)
    have pa_m8 := apply(ms.add8_ne, {P}, {m}, hP, hm, plt, mlt, nPm)
    have h_m8: !(H = M8) := rewrite(sym(em8), nHm8)
    have m_m8: !(m = M8) by arith(em8, hm)
    // head := *phead; m.next := head
    have b := apply(g.pick, hc3, nn, (!!!(H = 0) by taut(nn)))
    have c1 := apply(g.letin_e, apply(g.bind_inv, b, d2))
    have c2 := apply(g.bind_inv, c1, apply(ms.setnext_det, {s}, {m}, {H}, hw, hu, hm, km8))
    let V1 := mallocng_specs.wr64(V0, M8, H)
    let S1 := fn_update(s, "vm", V1)
    have w1 u1 := apply(ms.world_wr, {s}, {M8}, {H}, hw, hu, hm8)
    have sv1: app(S1, "vm") = V1 by rsimp()
    have km0_1: mallocng_specs.word_ok(app(S1, "vm"), app(S1, "objs"), m, 0) by simp(apply(ms.word_wr, {V0}, {OB}, {m}, {0}, {M8}, {H}, km0))
    have kH0_1: mallocng_specs.word_ok(app(S1, "vm"), app(S1, "objs"), H, 0) by simp(apply(ms.word_wr, {V0}, {OB}, {H}, {0}, {M8}, {H}, kH0))
    // t4 := head.prev (P: m.next apart from it); m.prev := t4
    have e1a: mallocng_specs.mprev(V1, H) = P := trans(all_elim(ms.mprev_def, {V1}, {H}), trans(apply(ms.rd_wr_far, {V0}, {M8}, {H}, {H}, hm8, hH, am8, aH, (!(M8 = H) by taut(h_m8))), sym(all_elim(ms.mprev_def, {V0}, {H}))))
    have c3 := rewrite(rewrite(sym(sv1), e1a), apply(g.letin_e, apply(g.bind_inv, c2, apply(ms.prev_det, {S1}, {H}, u1, hH, kH0_1))))
    have c4 := rewrite(all_elim(ms.upd, {s}, {V1}, {m}, {P}), apply(g.bind_inv, c3, apply(ms.setprev_det, {S1}, {m}, {P}, w1, u1, hm, km0_1)))
    let V2 := mallocng_specs.wr64(V1, m, P)
    let S2 := fn_update(s, "vm", V2)
    have w2 u2 := apply(ms.sw, {s}, {V1}, {m}, {P}, w1, u1, hm)
    have sv2: app(S2, "vm") = V2 by rsimp()
    have km0_2: mallocng_specs.word_ok(app(S2, "vm"), app(S2, "objs"), m, 0) by simp(apply(ms.word_wr, {V1}, {OB}, {m}, {0}, {m}, {P}, simp(km0_1)))
    have kP8_2: mallocng_specs.word_ok(app(S2, "vm"), app(S2, "objs"), P, 8) by simp(apply(ms.word_wr, {V1}, {OB}, {P}, {8}, {m}, {P}, apply(ms.word_wr, {V0}, {OB}, {P}, {8}, {M8}, {H}, kP8)))
    // t5 := m.prev (P, just written); t5.next := m
    have bt1 := apply(ms.world_parts, w1).4
    have e2a: mallocng_specs.mprev(V2, m) = P := trans(all_elim(ms.mprev_def, {V2}, {m}), apply(ms.rd_wr_same, {V1}, {m}, {P}, simp(bt1), hm, hP))
    have c5 := rewrite(rewrite(sym(sv2), e2a), apply(g.letin_e, apply(g.bind_inv, c4, apply(ms.prev_det, {S2}, {m}, u2, hm, km0_2))))
    have c6 := rewrite(all_elim(ms.upd, {s}, {V2}, {PA}, {m}), apply(g.bind_inv, c5, apply(ms.setnext_det, {S2}, {P}, {m}, w2, u2, hP, kP8_2)))
    let V3 := mallocng_specs.wr64(V2, PA, m)
    let S3 := fn_update(s, "vm", V3)
    have w3 u3 := apply(ms.sw, {s}, {V2}, {PA}, {m}, w2, u2, hpa)
    have sv3: app(S3, "vm") = V3 by rsimp()
    have km8_3: mallocng_specs.word_ok(app(S3, "vm"), app(S3, "objs"), m, 8) by simp(apply(ms.word_wr, {V2}, {OB}, {m}, {8}, {PA}, {m}, apply(ms.word_wr, {V1}, {OB}, {m}, {8}, {m}, {P}, apply(ms.word_wr, {V0}, {OB}, {m}, {8}, {M8}, {H}, km8))))
    have kP8_3: mallocng_specs.word_ok(app(S3, "vm"), app(S3, "objs"), P, 8) by simp(apply(ms.word_wr, {V2}, {OB}, {P}, {8}, {PA}, {m}, simp(kP8_2)))
    have kH0_3: mallocng_specs.word_ok(app(S3, "vm"), app(S3, "objs"), H, 0) by simp(apply(ms.word_wr, {V2}, {OB}, {H}, {0}, {PA}, {m}, apply(ms.word_wr, {V1}, {OB}, {H}, {0}, {m}, {P}, simp(kH0_1))))
    // t6 := m.next (H: P + 8, m apart from m + 8), t7 := t5.next (m, just written); t6.prev := t7
    have bt0 := apply(ms.world_parts, hw).4
    have e3a: mallocng_specs.mnext(V3, m) = H := trans(all_elim(ms.mnext_def, {V3}, {m}),
      trans(apply(ms.rd_wr_far, {V2}, {PA}, {M8}, {m}, hpa, hm8, apa, am8, pa_m8), trans(apply(ms.rd_wr_far, {V1}, {m}, {M8}, {P}, hm, hm8, am, am8, m_m8),
        apply(ms.rd_wr_same, {V0}, {M8}, {H}, simp(bt0), hm8, hH))))
    have c7 := rewrite(rewrite(sym(sv3), e3a), apply(g.letin_e, apply(g.bind_inv, c6, apply(ms.next_det, {S3}, {m}, u3, hm, km8_3))))
    have bt2 := apply(ms.world_parts, w2).4
    have e4a: mallocng_specs.mnext(V3, P) = m := trans(all_elim(ms.mnext_def, {V3}, {P}), apply(ms.rd_wr_same, {V2}, {PA}, {m}, simp(bt2), hpa, hm))
    have c8 := rewrite(rewrite(sym(sv3), e4a), apply(g.letin_e, apply(g.bind_inv, c7, apply(ms.next_det, {S3}, {P}, u3, hP, kP8_3))))
    have c9 := rewrite(all_elim(ms.upd, {s}, {V3}, {H}, {m}), apply(g.bind_inv, c8, apply(ms.setprev_det, {S3}, {H}, {m}, w3, u3, hH, kH0_3)))
    // the return: o, the world after
    have oe: o = ok(fn_update(s, "vm", mallocng_specs.wr64(V3, H, m)), empty) by simp(rewrite(c9, hrest3))
    // the spec's effect: the same memory
    have qv: mallocng_specs.queue_vm(V0, phead, m) = mallocng_specs.wr64(V3, H, m) by defs(simp(nn), mallocng_specs.queue_vm)
    show by simp(oe, qv)
  qed
  show by taut(emp, lnk)
qed

theorem ms.queue_c2: all phead m g. phead in bits(64) -> m in bits(64) ->
  refines(c_src_malloc_mallocng_malloc.queue(phead, m, g), mallocng_specs.queue_spec(phead, m), abi.World)
proof
  fix phead m g
  assume hph hm
  have k: all s o. s in abi.World -> runs(c_src_malloc_mallocng_malloc.queue(phead, m, g), s, o) -> runs(mallocng_specs.queue_spec(phead, m), s, o) proof
    fix s o
    assume hw hr
    let V0 := app(s, "vm")
    have pu := apply(g.runs_univ, hr)
    have hu: s in univ(1) by simp(pu)
    let SPEC := mallocng_specs.queue_spec(phead, m)
    have np: !mallocng_specs.queue_pre(V0, app(s, "objs"), phead, m) -> runs(SPEC, s, o) proof
      assume hn
      show by simp(pu, hn, keep(abi.overflow, mallocng_specs.queue_pre, mallocng_specs.queue_vm))
    qed
    have yp: mallocng_specs.queue_pre(V0, app(s, "objs"), phead, m) -> runs(SPEC, s, o) proof
      assume hp
      have oe := apply(ms.qu_run, {phead}, {m}, {g}, {s}, {o}, hph, hm, hw, hu, hp, hr)
      show by simp(oe, pu, hp, keep(abi.overflow, mallocng_specs.queue_pre, mallocng_specs.queue_vm))
    qed
    show by taut(np, yp)
  qed
  show by defs(k, refines)
qed

// queue as a C function value (with a_crash's contract): its register
// wrapper refines the spec's
theorem ms.queue_fun_c2: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
  runs(app(c_src_malloc_mallocng_malloc.queue_fun(mallocng_specs.a_crash_spec_fun()), regs), s, o) -> runs(app(mallocng_specs.queue_spec_fun, regs), s, o)
proof
  fix regs s o
  assume hr hl hw h
  have lo: seq_len(regs) in omega by simp(hr)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(hl, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(hr, ol, keep(ord_le))
  rsimp only, c_src_malloc_mallocng_malloc.queue_fun, app_fn_build, ra in h
  rsimp only, mallocng_specs.queue_spec_fun, app_fn_build, ra
  have pu := apply(g.runs_univ, h)
  have r := apply(g.runs_elim, h)
  let A0 := bits_of_int(64, app(regs, 0))
  let A1 := bits_of_int(64, app(regs, 1))
  have a0: A0 in bits(64) by simp()
  have a1: A1 in bits(64) by simp()
  have dc := expand(all_elim(ms.queue_c2, {A0}, {A1}, {mallocng_specs.a_crash_spec_fun}), refines)
  have hm: all o2. runs(c_src_malloc_mallocng_malloc.queue(A0, A1, mallocng_specs.a_crash_spec_fun), s, o2) -> runs(mallocng_specs.queue_spec(A0, A1), s, o2) proof
    fix o2
    assume h2
    show := mp(all_elim(mp(dc, a0, a1), {s}, {o2}), hw, h2)
  qed
  have c1: !ord_le(2, seq_len(regs)) -> runs(mkprog(x1 x2. !ord_le(2, seq_len(regs)) || bind_rel(mallocng_specs.queue_spec(A0, A1), x1,
      x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. x2 = ok(x3, pair(x5, x6)))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), s, o) proof
    assume hn
    show by apply(tr.runs_intro, pu, taut(hn))
  qed
  have c2: bind_rel(c_src_malloc_mallocng_malloc.queue(A0, A1, mallocng_specs.a_crash_spec_fun), s,
      x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o = ok(x3, pair(x5, x6)))), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) ->
      runs(mkprog(x1 x2. !ord_le(2, seq_len(regs)) || bind_rel(mallocng_specs.queue_spec(A0, A1), x1,
      x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. x2 = ok(x3, pair(x5, x6)))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), s, o) proof
    assume hb
    have b2 := apply(g.bind_mono, hm, hb)
    show by apply(tr.runs_intro, pu, taut(b2))
  qed
  show by taut(r, c1, c2)
qed

// ----------------------------------------------------------------------
//  free_meta: from queue's contract

// queue's contract at a call queue(phead, m) (its spec's register wrapper,
// on a world where its precondition holds): an overflow (the memory any),
// or the return with queue's effect
theorem ms.qus_q: all regs s phead m o2. phead in bits(64) -> m in bits(64) -> s in abi.World -> s in univ(1) ->
  mallocng_specs.queue_pre(app(s, "vm"), app(s, "objs"), phead, m) ->
  gc.regs_ok(regs, seq_concat(seq_one(gimple.arg(64, phead)), seq_one(gimple.arg(64, m)))) ->
  runs(app(mallocng_specs.queue_spec_fun, regs), s, o2) ->
  (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex r. o2 = ok(fn_update(s, "vm", mallocng_specs.queue_vm(app(s, "vm"), phead, m)), r))
proof
  fix regs s phead m o2
  assume hp hm hw hu hpre hr h
  have rl rn r0 r1 := apply(gc.regs2, hp, hm, hr)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, mallocng_specs.queue_spec_fun, app_fn_build, ra in h
  have vv: ex x. x in x86_64_linux.Vm by ex_intro({app(s, "vm")}, simp(expand(hw, abi.World)))
  show by simp(h, r0, r1, rn, hp, hm, hpre, vv, keep(mallocng_specs.queue_pre, mallocng_specs.queue_vm))
qed

// (queue's memory after: a memory)
theorem ms.quvm_vm: all vm phead m. vm in x86_64_linux.Vm -> vm in univ(1) -> phead in bits(64) -> m in bits(64) ->
  mallocng_specs.queue_vm(vm, phead, m) in x86_64_linux.Vm && mallocng_specs.queue_vm(vm, phead, m) in univ(1)
proof
  fix vm phead m
  assume hv hu hph hm
  let H := mallocng_specs.rd64(vm, phead)
  let P := mallocng_specs.mprev(vm, H)
  have hH: H in bits(64) by defs(simp(), mallocng_specs.rd64)
  have hP: P in bits(64) by defs(simp(), mallocng_specs.mprev, mallocng_specs.rd64)
  have hP8: bits_add(64, P, 8) in bits(64) by arith(hP)
  have hm8: bits_add(64, m, 8) in bits(64) by arith(hm)
  have a1 a2 := apply(ms.wr_vm, {vm}, {bits_add(64, m, 8)}, {H}, hv, hu, hm8)
  have b1 b2 := apply(ms.wr_vm, {mallocng_specs.wr64(vm, bits_add(64, m, 8), H)}, {m}, {P}, a1, a2, hm)
  have c1 c2 := apply(ms.wr_vm, {mallocng_specs.wr64(mallocng_specs.wr64(vm, bits_add(64, m, 8), H), m, P)}, {bits_add(64, P, 8)}, {m}, b1, b2, hP8)
  have d1 d2 := apply(ms.wr_vm, {mallocng_specs.wr64(mallocng_specs.wr64(mallocng_specs.wr64(vm, bits_add(64, m, 8), H), m, P), bits_add(64, P, 8), m)}, {H}, {m}, c1, c2, hH)
  have e1 e2 := apply(ms.wr_vm, {vm}, {bits_add(64, m, 8)}, {m}, hv, hu, hm8)
  have f1 f2 := apply(ms.wr_vm, {mallocng_specs.wr64(vm, bits_add(64, m, 8), m)}, {m}, {m}, e1, e2, hm)
  have g1 g2 := apply(ms.wr_vm, {mallocng_specs.wr64(mallocng_specs.wr64(vm, bits_add(64, m, 8), m), m, m)}, {phead}, {m}, f1, f2, hph)
  have q1: mallocng_specs.queue_vm(vm, phead, m) in x86_64_linux.Vm by defs(apply(ite_in, d1, g1), mallocng_specs.queue_vm)
  have q2: mallocng_specs.queue_vm(vm, phead, m) in univ(1) by defs(apply(ite_in, d2, g2), mallocng_specs.queue_vm)
  show conj(q1, q2)
qed

// free_meta's contract from queue's: for every callee refining queue's
// spec (as a C function value), free_meta's readable GIMPLE refines its
// spec (ctx: the malloc context's address)
theorem ms.free_meta_c2: all m g. m in bits(64) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(app(g, regs), s, o) -> runs(app(mallocng_specs.queue_spec_fun, regs), s, o)) ->
  refines(c_src_malloc_mallocng_malloc.free_meta(m, g), mallocng_specs.free_meta_spec(c_src_malloc_mallocng_malloc.__malloc_context, m), abi.World)
proof
  fix m g
  assume hm hg
  show proof
    fix s o
    assume hw hr
    let V0 := app(s, "vm")
    let CTX := c_src_malloc_mallocng_malloc.__malloc_context
    let PH := bits_add(64, CTX, 16)
    let ZV := mallocng_specs.zero_meta(V0, m)
    let W1 := fn_update(s, "vm", ZV)
    let QV := mallocng_specs.queue_vm(ZV, PH, m)
    let SPEC := mallocng_specs.free_meta_spec(CTX, m)
    let OVF := exc_val("stack_overflow", empty)
    let Z := seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(0), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0))
    have pu := apply(g.runs_univ, hr)
    have hu: s in univ(1) by simp(pu)
    have vV vfun vdom .. := apply(ms.world_parts, hw)
    have np: !mallocng_specs.free_meta_pre(V0, app(s, "objs"), app(s, "fs_base"), CTX, m) -> runs(SPEC, s, o) proof
      assume hn
      show by simp(pu, hn, keep(abi.overflow, mallocng_specs.free_meta_pre, mallocng_specs.queue_vm, mallocng_specs.zero_meta))
    qed
    have yp: mallocng_specs.free_meta_pre(V0, app(s, "objs"), app(s, "fs_base"), CTX, m) -> runs(SPEC, s, o) proof
      assume hp
      have hnz hus hctx hq hth := expand(hp, mallocng_specs.free_meta_pre)
      // (the spec's outcomes: an overflow, any memory; m zeroed and queued)
      have sov: all v. v in x86_64_linux.Vm -> runs(SPEC, s, exc(fn_update(s, "vm", v), OVF)) proof
        fix v
        assume hv
        have vu := apply(x86.vm_univ, hv)
        have eu: OVF in univ(1) by defs(simp(), exc_val)
        have pu2: pair(s, exc(fn_update(s, "vm", v), OVF)) in univ(1) by simp(hu, vu, eu)
        have ovi := apply(ct.overflow_intro, hv, pu2)
        show by simp(hp, ovi, pu2, keep(abi.overflow, mallocng_specs.free_meta_pre, mallocng_specs.queue_vm, mallocng_specs.zero_meta))
      qed
      // m's 40 bytes zeroed: the world W1
      have zl := apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, tr.zeros_one)))))))))))))))))))))))))))))))))))))))
      have ln: seq_len(Z) = 40 by arith()
      have md: g.mem_defined(s, m, 0, seq_len(Z), true) by simp(ln, hnz, hus, hm)
      have sd := apply(g.stz_det, {s}, {m}, {0}, {Z}, hu, hm, simp(), zl, md, vV, vfun, vdom)
      have ez: fn_update(s, "vm", fn_update(V0, "bytes", x86_64_linux.store_le(app(V0, "bytes"), int_add(m, 0), seq_len(Z), 0))) = W1 by defs(simp(ln, hm), mallocng_specs.zero_meta)
      have b1 := apply(g.bind_inv, apply(g.runs_elim, expand(hr, c_src_malloc_mallocng_malloc.free_meta)), rewrite(ez, sd))
      have w1W w1u := apply(tr.world_store, {s}, {m}, {40}, {0}, hw, hu, hm)
      have zw: fn_update(s, "vm", fn_update(V0, "bytes", x86_64_linux.store_le(app(V0, "bytes"), m, 40, 0))) = W1 by defs(simp(), mallocng_specs.zero_meta)
      have hw1 := rewrite(zw, w1W)
      have hu1 := rewrite(zw, w1u)
      // ctx + 16
      have cb: CTX in bits(64) by defs(simp(), c_src_malloc_mallocng_malloc.__malloc_context)
      have sv: gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), 16) = 16 by defs(simp(), gimple.sval)
      have pd := rewrite(sv, apply(g.padd_det, {W1}, {CTX}, {16}, hu1, cb, simp(), simp(sv, cb), simp(sv, hctx)))
      have ep: int_add(CTX, 16) = PH by simp(hctx, cb)
      have b2 := apply(g.bind_inv, b1, rewrite(ep, pd))
      have phb: PH in bits(64) by simp()
      // the call: queue's contract on W1 -- an overflow, or m queued
      have ths: gc.sound(W1) by simp(hth)
      have qpre: mallocng_specs.queue_pre(app(W1, "vm"), app(W1, "objs"), PH, m) by simp(hq)
      have zV: ZV in x86_64_linux.Vm by simp(expand(hw1, abi.World))
      have qV qU := apply(ms.quvm_vm, zV, apply(x86.vm_univ, zV), phb, hm)
      have qa: all regs o2. gc.regs_ok(regs, seq_concat(seq_one(gimple.arg(64, PH)), seq_one(gimple.arg(64, m)))) -> runs(app(mallocng_specs.queue_spec_fun, regs), W1, o2) ->
          (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(W1, "vm", v), OVF)) || (ex r. o2 = ok(fn_update(W1, "vm", QV), r)) proof
        fix regs o2
        assume hro h2
        have c := apply(ms.qus_q, phb, hm, hw1, hu1, qpre, hro, h2)
        show by simp(c)
      qed
      have cc := apply(gc.contract_call, ths, hw1, qV, apply(gc.regs2_ex, phb, hm), arith(), hg, qa, b2)
      have c1: (ex v. v in x86_64_linux.Vm && o = exc(fn_update(W1, "vm", v), OVF)) -> runs(SPEC, s, o) proof
        assume h
        obtain v, hv ho from h
        have e: o = exc(fn_update(s, "vm", v), OVF) by simp(ho)
        show := rewrite(sym(e), mp(all_elim(sov, {v}), hv))
      qed
      have c2: (ex r. o = ok(fn_update(W1, "vm", QV), empty)) -> runs(SPEC, s, o) proof
        assume h
        obtain r, ho from h
        have e: o = ok(fn_update(s, "vm", QV), empty) by simp(ho)
        have sok: runs(SPEC, s, ok(fn_update(s, "vm", QV), empty)) by simp(pu, hp, qU, keep(abi.overflow, mallocng_specs.free_meta_pre, mallocng_specs.queue_vm, mallocng_specs.zero_meta))
        show := rewrite(sym(e), sok)
      qed
      show by taut(cc, c1, c2)
    qed
    show by taut(np, yp)
  qed
qed

// ... with musl's queue (with a_crash's contract) as the callee
theorem ms.free_meta_c2_qu: all m. m in bits(64) ->
  refines(c_src_malloc_mallocng_malloc.free_meta(m, c_src_malloc_mallocng_malloc.queue_fun(mallocng_specs.a_crash_spec_fun())),
    mallocng_specs.free_meta_spec(c_src_malloc_mallocng_malloc.__malloc_context, m), abi.World)
proof
  fix m
  assume hm
  show := mp(all_elim(ms.free_meta_c2, {m}, {c_src_malloc_mallocng_malloc.queue_fun(mallocng_specs.a_crash_spec_fun())}), hm, ms.queue_fun_c2)
qed

// free_meta as a C function value: its register wrapper refines the spec's
theorem ms.free_meta_fun_c2: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
  runs(app(c_src_malloc_mallocng_malloc.free_meta_fun(c_src_malloc_mallocng_malloc.queue_fun(mallocng_specs.a_crash_spec_fun())), regs), s, o) ->
  runs(app(mallocng_specs.free_meta_spec_fun(c_src_malloc_mallocng_malloc.__malloc_context), regs), s, o)
proof
  fix regs s o
  assume hr hl hw h
  have lo: seq_len(regs) in omega by simp(hr)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(hl, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(hr, ol, keep(ord_le))
  rsimp only, c_src_malloc_mallocng_malloc.free_meta_fun, app_fn_build, ra in h
  rsimp only, mallocng_specs.free_meta_spec_fun, app_fn_build, ra
  have pu := apply(g.runs_univ, h)
  have r := apply(g.runs_elim, h)
  let A0 := bits_of_int(64, app(regs, 0))
  let QF := c_src_malloc_mallocng_malloc.queue_fun(mallocng_specs.a_crash_spec_fun())
  let CTX := c_src_malloc_mallocng_malloc.__malloc_context
  have a0: A0 in bits(64) by simp()
  have dc := expand(all_elim(ms.free_meta_c2_qu, {A0}), refines)
  have hm: all o2. runs(c_src_malloc_mallocng_malloc.free_meta(A0, QF), s, o2) -> runs(mallocng_specs.free_meta_spec(CTX, A0), s, o2) proof
    fix o2
    assume h2
    show := mp(all_elim(mp(dc, a0), {s}, {o2}), hw, h2)
  qed
  have c1: !ord_le(1, seq_len(regs)) -> runs(mkprog(x1 x2. !ord_le(1, seq_len(regs)) || bind_rel(mallocng_specs.free_meta_spec(CTX, A0), x1,
      x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. x2 = ok(x3, pair(x5, x6)))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), s, o) proof
    assume hn
    show by apply(tr.runs_intro, pu, taut(hn))
  qed
  have c2: bind_rel(c_src_malloc_mallocng_malloc.free_meta(A0, QF), s,
      x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o = ok(x3, pair(x5, x6)))), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) ->
      runs(mkprog(x1 x2. !ord_le(1, seq_len(regs)) || bind_rel(mallocng_specs.free_meta_spec(CTX, A0), x1,
      x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. x2 = ok(x3, pair(x5, x6)))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), s, o) proof
    assume hb
    have b2 := apply(g.bind_mono, hm, hb)
    show by apply(tr.runs_intro, pu, taut(b2))
  qed
  show by taut(r, c1, c2)
qed
