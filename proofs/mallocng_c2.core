    have sAB: int_lt(app(mallocng.size_classes, int_add(36, 1)), int_add(int_div(int_add(n, 3), 16), 1)) -> int_lt(app(mallocng.size_classes, 38), int_add(int_div(int_add(n, 3), 16), 1)) -> mallocng_specs.class_of(n, i2) proof
