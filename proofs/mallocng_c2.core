    have cB2: int_lt(app(mallocng.size_classes, 40), int_add(int_div(int_add(n, 3), 16), 1)) || !int_lt(app(mallocng.size_classes, 40), int_add(int_div(int_add(n, 3), 16), 1)) by taut()
