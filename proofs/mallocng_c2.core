      have le: int_le(int_div(int_add(n, 19), 16), app(mallocng.size_classes, 44)) by arith(ue, hi, lo, hA, hB, w1, v44, v44)
      have pr: 44 = 0 || int_lt(app(mallocng.size_classes, int_sub(44, 1)), int_div(int_add(n, 19), 16)) by arith(ue, hi, lo, u11, hA, hB, w1, pv, v44)
      have cl := apply(ms.class_from, hn, (44 in omega by simp()), (int_lt(44, 48) by simp()), le, pr)
