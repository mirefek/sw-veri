      x10 x11. letin(x11, x12. letin(bits_sext(8, 32, x12), x13. x1 = ok(x10, x13))), x10 x11. x1 = exc(x10, x11), x10. x1 = diverge(x10)), x8 x9. x1 = exc(x8, x9), x8. x1 = diverge(x8))))], {act.w(s)})), p7f)
  // 402c7b and eax, [rsp - 4]: x & t1
  have p7b := mp(mp(mp(mp(mp(mp(mp(mp(mp(mp(mp(all_elim(tr.and32_home, {s}, {act.v(s)}, {4205681}, {a_ctz_32.code()}, {4205691}, {4205695}, {4}, {0}, {18446744073709551612}, {act.slot}, {tag(0, 0)},
