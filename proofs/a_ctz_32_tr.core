// a_ctz_32's C1 by translation (docs/bridge-pattern-design.md): the
// machine code matched against the readable GIMPLE statement by statement,
// each step an instance of a rule of proofs/translate.core -- the
// instruction's decode fact (build/leaf_steps.core), the coupling's maps,
// the spec's rest. No search: the facts beside the rules are literal
// evaluations (an address, a map's entry, a constant's range).
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core core/records.core \
//     core/list.core core/loop.core build/c_mallocng_malloc.core proofs/x86.core proofs/x86_code.core \
//     proofs/x86_insn.core build/leaf_steps.core proofs/abi.core proofs/abi_restore.core proofs/abi_glue.core \
//     proofs/gimple.core proofs/abi_stack.core proofs/abi_loop.core proofs/abi_bridge.core proofs/translate.core \
//     proofs/a_ctz_32.core proofs/a_ctz_32_tr.core

// the values: x the argument, t1..t4 the hash, the table's byte, its sign extension
abbrev act.x(args) := bits_of_int(32, app(args, 0))
abbrev act.t1(args) := bits_sub(32, 0, act.x(args))
abbrev act.t2(args) := bits_and(32, act.x(args), act.t1(args))
abbrev act.t3(args) := bits_mul(32, act.t2(args), 124511785)
abbrev act.t4(args) := bits_shr(32, act.t3(args), 27)
abbrev act.by(w, args) := bits_of_int(8, gimple.bytes_at(app(w, "vm"), int_add(c_src_malloc_mallocng_malloc.debruijn32, act.t4(args)), 1))
abbrev act.sx(w, args) := bits_sext(8, 32, act.by(w, args))

// the spec's view (the prologue's store) and world
abbrev act.v(s) := tr.view1(s, 18446744073709551612, 4, bits_slice(app(app(s, "gpr"), 7), 31, 0))
abbrev act.w(s) := abi.view(act.v(s), s)

// the wrapper around the procedure's rest q
abbrev act.wrap(q) := mkprog(x1 x2. bind_rel(q, x1, x3 x4. letin(x4, x5. bind_rel(gimple.result(32, x5), x3, x6 x7. any_rel(x8. x8 in bits(64), x8. x2 = ok(x6, pair(x7, x8))),
  x6 x7. x2 = exc(x6, x7), x6. x2 = diverge(x6))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))

// the procedure's rest at each point
abbrev act.q6(args) := mkprog(x0 x1. bind_rel(gimple.elem(c_src_malloc_mallocng_malloc.debruijn32, act.t4(args), 1), x0, x8 x9. bind_rel(gimple.ld8(x9, 0), x8,
  x10 x11. letin(x11, x12. letin(bits_sext(8, 32, x12), x13. x1 = ok(x10, x13))), x10 x11. x1 = exc(x10, x11), x10. x1 = diverge(x10)), x8 x9. x1 = exc(x8, x9), x8. x1 = diverge(x8)))
abbrev act.q5(args) := mkprog(x0 x1. letin(act.t4(args), x7. bind_rel(gimple.elem(c_src_malloc_mallocng_malloc.debruijn32, x7, 1), x0, x8 x9. bind_rel(gimple.ld8(x9, 0), x8,
  x10 x11. letin(x11, x12. letin(bits_sext(8, 32, x12), x13. x1 = ok(x10, x13))), x10 x11. x1 = exc(x10, x11), x10. x1 = diverge(x10)), x8 x9. x1 = exc(x8, x9), x8. x1 = diverge(x8))))
abbrev act.q4(args) := mkprog(x0 x1. letin(act.t3(args), x6. letin(bits_shr(32, x6, 27), x7. bind_rel(gimple.elem(c_src_malloc_mallocng_malloc.debruijn32, x7, 1), x0, x8 x9. bind_rel(gimple.ld8(x9, 0), x8,
  x10 x11. letin(x11, x12. letin(bits_sext(8, 32, x12), x13. x1 = ok(x10, x13))), x10 x11. x1 = exc(x10, x11), x10. x1 = diverge(x10)), x8 x9. x1 = exc(x8, x9), x8. x1 = diverge(x8)))))
abbrev act.q3(args) := mkprog(x0 x1. letin(act.t2(args), x5. letin(bits_mul(32, x5, 124511785), x6. letin(bits_shr(32, x6, 27), x7. bind_rel(gimple.elem(c_src_malloc_mallocng_malloc.debruijn32, x7, 1), x0, x8 x9. bind_rel(gimple.ld8(x9, 0), x8,
  x10 x11. letin(x11, x12. letin(bits_sext(8, 32, x12), x13. x1 = ok(x10, x13))), x10 x11. x1 = exc(x10, x11), x10. x1 = diverge(x10)), x8 x9. x1 = exc(x8, x9), x8. x1 = diverge(x8))))))
abbrev act.q2(args) := mkprog(x0 x1. letin(act.t1(args), x4. letin(bits_and(32, act.x(args), x4), x5. letin(bits_mul(32, x5, 124511785), x6. letin(bits_shr(32, x6, 27), x7. bind_rel(gimple.elem(c_src_malloc_mallocng_malloc.debruijn32, x7, 1), x0, x8 x9. bind_rel(gimple.ld8(x9, 0), x8,
  x10 x11. letin(x11, x12. letin(bits_sext(8, 32, x12), x13. x1 = ok(x10, x13))), x10 x11. x1 = exc(x10, x11), x10. x1 = diverge(x10)), x8 x9. x1 = exc(x8, x9), x8. x1 = diverge(x8)))))))
abbrev act.q1(args) := mkprog(x0 x1. letin(0, x3. letin(bits_sub(32, 0, act.x(args)), x4. letin(bits_and(32, act.x(args), x4), x5. letin(bits_mul(32, x5, 124511785), x6. letin(bits_shr(32, x6, 27), x7. bind_rel(gimple.elem(c_src_malloc_mallocng_malloc.debruijn32, x7, 1), x0, x8 x9. bind_rel(gimple.ld8(x9, 0), x8,
  x10 x11. letin(x11, x12. letin(bits_sext(8, 32, x12), x13. x1 = ok(x10, x13))), x10 x11. x1 = exc(x10, x11), x10. x1 = diverge(x10)), x8 x9. x1 = exc(x8, x9), x8. x1 = diverge(x8))))))))
abbrev act.q0b(args) := mkprog(x0 x1. any_rel(x2. x2 in bits(32), x2. letin(x2, x3. letin(bits_sub(32, 0, act.x(args)), x4. letin(bits_and(32, act.x(args), x4), x5. letin(bits_mul(32, x5, 124511785), x6. letin(bits_shr(32, x6, 27), x7. bind_rel(gimple.elem(c_src_malloc_mallocng_malloc.debruijn32, x7, 1), x0, x8 x9. bind_rel(gimple.ld8(x9, 0), x8,
  x10 x11. letin(x11, x12. letin(bits_sext(8, 32, x12), x13. x1 = ok(x10, x13))), x10 x11. x1 = exc(x10, x11), x10. x1 = diverge(x10)), x8 x9. x1 = exc(x8, x9), x8. x1 = diverge(x8)))))))))
abbrev act.q0(args) := c_src_malloc_mallocng_malloc.a_ctz_32(act.x(args))
abbrev act.q7(w, args) := mkprog(x0 x1. letin(act.by(w, args), x12. letin(bits_sext(8, 32, x12), x13. x1 = ok(x0, x13))))
abbrev act.q8(w, args) := mkprog(x0 x1. letin(act.sx(w, args), x13. x1 = ok(x0, x13)))
abbrev act.q9(w, args) := mkprog(x0 x1. x1 = ok(x0, act.sx(w, args)))
abbrev act.p10(w, args) := mkprog(x1 x2. letin(act.sx(w, args), x5. bind_rel(gimple.result(32, x5), x1, x6 x7. any_rel(x8. x8 in bits(64), x8. x2 = ok(x6, pair(x7, x8))),
  x6 x7. x2 = exc(x6, x7), x6. x2 = diverge(x6))))

// the homes and registers at each point
abbrev act.hs(args) := fn_update(empty, 18446744073709551612, pair(4, act.x(args)))
abbrev act.rs1(args) := fn_update(empty, 0, pair(4, act.x(args)))
abbrev act.rs2(args) := fn_update(act.rs1(args), 0, pair(4, act.t1(args)))
abbrev act.rs3(args) := fn_update(act.rs2(args), 0, pair(4, act.t2(args)))
abbrev act.rs4(args) := fn_update(act.rs3(args), 0, pair(4, act.t3(args)))
abbrev act.rs5(args) := fn_update(act.rs4(args), 0, pair(4, act.t4(args)))
abbrev act.rs6(args) := fn_update(act.rs5(args), 2, pair(4, act.t4(args)))
abbrev act.rs7(args) := fn_update(act.rs6(args), 0, pair(8, c_src_malloc_mallocng_malloc.debruijn32))
abbrev act.rs8(w, args) := fn_update(act.rs7(args), 0, pair(1, act.by(w, args)))
abbrev act.rs9(w, args) := fn_update(act.rs8(w, args), 0, pair(4, act.sx(w, args)))

// the decode facts' memory operands
abbrev act.slot := tag(2, fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(2, 4)), "index", none), "scale", 1), "disp", 18446744073709551612))
abbrev act.tab := fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(1, empty)), "index", none), "scale", 1), "disp", 13327)

// the immediate's signed product: the unsigned one's low 32 bits
theorem act.imul_by: tr.imul_by(124511785)
proof
  have g: all y. y in bits(32) -> bits_add(32, int_mul(sint(32, y), sint(32, 124511785)), 0) = bits_mul(32, y, 124511785) proof
    fix y
    assume hy: y in bits(32)
    have e := mp(all_elim(ac.imul, {y}), hy)
    show by simp(e)
  qed
  show by defs(g, tr.imul_by)
qed

// the body: from after the prologue to the return, for every entry
theorem act.body: all args s. args in abi.ARGS -> s in x86_64_linux.Machine -> ord_le(1, seq_len(args)) -> act.w(s) in univ(1) ->
  tr.pt(s, act.v(s), 4205681, a_ctz_32.code(), 4205685, act.hs(args), empty, act.wrap(act.q0(args)), act.w(s))
proof
  fix args
  fix s
  assume hA: args in abi.ARGS
  assume hM: s in x86_64_linux.Machine
  assume hg: ord_le(1, seq_len(args))
  assume hvu: act.w(s) in univ(1)
  have sc0: tr.scratch_reg(0) by defs(simp(), tr.scratch_reg)
  have sc2: tr.scratch_reg(2) by defs(simp(), tr.scratch_reg)
  let KW(x3, x4, x2) := letin(x4, x5. bind_rel(gimple.result(32, x5), x3, x6 x7. any_rel(x8. x8 in bits(64), x8. x2 = ok(x6, pair(x7, x8))), x6 x7. x2 = exc(x6, x7), x6. x2 = diverge(x6)))
  // 402c98 ret: rax holds the result, the wrapper returns it
  have p98 := mp(mp(mp(mp(all_elim(tr.ret_insn, {s}, {act.v(s)}, {4205681}, {a_ctz_32.code()}, {4205720}, {1}, {act.hs(args)}, {act.rs9(act.w(s), args)}, {act.p10(act.w(s), args)},
    {act.w(s)}, {4}, {act.sx(act.w(s), args)}), a_ctz_32.at_402c98), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), all_elim(tr.result32, {act.w(s)}, {act.sx(act.w(s), args)}))
  // (the procedure returns its result to the wrapper)
  have p98b := mp(mp(tr.wret[s := s, v := act.v(s), base := 4205681, code := a_ctz_32.code(), a := 4205720, hs := act.hs(args), rs := act.rs9(act.w(s), args), w := act.w(s),
    val := act.sx(act.w(s), args), kw := x3 x4 x2. KW(x3, x4, x2)], simp(hvu)), p98)
  // 402c95 movsx eax, al
  have p95 := mp(mp(mp(mp(mp(mp(mp(mp(all_elim(tr.movsx8, {s}, {act.v(s)}, {4205681}, {a_ctz_32.code()}, {4205717}, {4205720}, {3}, {0}, {0}, {tag(0, 0)}, {act.by(act.w(s), args)},
    {act.hs(args)}, {act.rs8(act.w(s), args)}, {act.wrap(act.q9(act.w(s), args))}, {act.w(s)}), a_ctz_32.at_402c95), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), p98b)
  // (the lets: the sign extension, the byte)
  have p95b := mp(mp(tr.wred[s := s, v := act.v(s), base := 4205681, code := a_ctz_32.code(), a := 4205717, hs := act.hs(args), rs := act.rs8(act.w(s), args), w := act.w(s),
    q := act.q8(act.w(s), args), q2 := act.q9(act.w(s), args), kw := x3 x4 x2. KW(x3, x4, x2)], all_elim(tr.q_let[e := act.sx(act.w(s), args), b := x0 x1 x. x1 = ok(x0, x)], {act.w(s)})), p95)
  have p95c := mp(mp(tr.wred[s := s, v := act.v(s), base := 4205681, code := a_ctz_32.code(), a := 4205717, hs := act.hs(args), rs := act.rs8(act.w(s), args), w := act.w(s),
    q := act.q7(act.w(s), args), q2 := act.q8(act.w(s), args), kw := x3 x4 x2. KW(x3, x4, x2)],
    all_elim(tr.q_let[e := act.by(act.w(s), args), b := x0 x1 x. letin(bits_sext(8, 32, x), x13. x1 = ok(x0, x13))], {act.w(s)})), p95b)
  // 402c91 movzx eax, byte [rdx + rax]: the table's byte (ld8(elem(debruijn32, t4, 1)))
  have p91 := mp(mp(mp(mp(mp(mp(mp(mp(mp(mp(mp(mp(mp(mp(mp(tr.ld8_elem[s := s, v := act.v(s), base := 4205681, code := a_ctz_32.code(), a := 4205713, a2 := 4205717, len := 4,
    g := 0, b := 2, i := 0, z2 := tag(0, 0), gg := c_src_malloc_mallocng_malloc.debruijn32, u := act.t4(args), hs := act.hs(args), rs := act.rs7(args), w := act.w(s), k := x10 x11 x1. letin(x11, x12. letin(bits_sext(8, 32, x12), x13. x1 = ok(x10, x13))), kw := x3 x4 x2. KW(x3, x4, x2)],
    a_ctz_32.at_402c91),simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), hvu), p95c)
  // 402c8a lea rax, [rip + 13327]: the table's address
  have p8a := mp(mp(mp(mp(mp(mp(all_elim(tr.lea_rip, {s}, {act.v(s)}, {4205681}, {a_ctz_32.code()}, {4205706}, {4205713}, {7}, {0}, {13327}, {tag(2, act.tab)}, {tag(2, act.tab)}, {tag(0, 0)},
    {c_src_malloc_mallocng_malloc.debruijn32}, {act.hs(args)}, {act.rs6(args)}, {act.wrap(act.q6(args))}, {act.w(s)}), a_ctz_32.at_402c8a), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), p91)
  // 402c88 mov edx, eax
  have p88 := mp(mp(mp(mp(mp(mp(mp(all_elim(tr.mov32_rr, {s}, {act.v(s)}, {4205681}, {a_ctz_32.code()}, {4205704}, {4205706}, {2}, {0}, {2}, {tag(0, 2)}, {tag(0, 0)}, {act.t4(args)},
    {act.hs(args)}, {act.rs5(args)}, {act.wrap(act.q6(args))}, {act.w(s)}), a_ctz_32.at_402c88), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), p8a)
  // (let t4)
  have p88b := mp(mp(tr.wred[s := s, v := act.v(s), base := 4205681, code := a_ctz_32.code(), a := 4205704, hs := act.hs(args), rs := act.rs5(args), w := act.w(s),
    q := act.q5(args), q2 := act.q6(args), kw := x3 x4 x2. KW(x3, x4, x2)],
    all_elim(tr.q_let[e := act.t4(args), b := x0 x1 x. bind_rel(gimple.elem(c_src_malloc_mallocng_malloc.debruijn32, x, 1), x0, x8 x9. bind_rel(gimple.ld8(x9, 0), x8,
      x10 x11. letin(x11, x12. letin(bits_sext(8, 32, x12), x13. x1 = ok(x10, x13))), x10 x11. x1 = exc(x10, x11), x10. x1 = diverge(x10)), x8 x9. x1 = exc(x8, x9), x8. x1 = diverge(x8))], {act.w(s)})), p88)
  // 402c85 shr eax, 27
  have p85 := mp(mp(mp(mp(mp(mp(mp(mp(mp(all_elim(tr.shr32, {s}, {act.v(s)}, {4205681}, {a_ctz_32.code()}, {4205701}, {4205704}, {3}, {0}, {tag(0, 0)}, {27}, {act.t3(args)},
    {act.hs(args)}, {act.rs4(args)}, {act.wrap(act.q5(args))}, {act.w(s)}), a_ctz_32.at_402c85), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), p88b)
  // (let t3)
  have p85b := mp(mp(tr.wred[s := s, v := act.v(s), base := 4205681, code := a_ctz_32.code(), a := 4205701, hs := act.hs(args), rs := act.rs4(args), w := act.w(s),
    q := act.q4(args), q2 := act.q5(args), kw := x3 x4 x2. KW(x3, x4, x2)],
    all_elim(tr.q_let[e := act.t3(args), b := x0 x1 x. letin(bits_shr(32, x, 27), x7. bind_rel(gimple.elem(c_src_malloc_mallocng_malloc.debruijn32, x7, 1), x0, x8 x9. bind_rel(gimple.ld8(x9, 0), x8,
      x10 x11. letin(x11, x12. letin(bits_sext(8, 32, x12), x13. x1 = ok(x10, x13))), x10 x11. x1 = exc(x10, x11), x10. x1 = diverge(x10)), x8 x9. x1 = exc(x8, x9), x8. x1 = diverge(x8)))], {act.w(s)})), p85)
  // 402c7f imul eax, eax, 124511785
  have p7f := mp(mp(mp(mp(mp(mp(mp(mp(mp(all_elim(tr.imul32, {s}, {act.v(s)}, {4205681}, {a_ctz_32.code()}, {4205695}, {4205701}, {6}, {0}, {0}, {tag(0, 0)}, {tag(0, 0)}, {124511785},
    {act.t2(args)}, {act.hs(args)}, {act.rs3(args)}, {act.wrap(act.q4(args))}, {act.w(s)}), a_ctz_32.at_402c7f), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), act.imul_by), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), simp(tr.dom_upd, tr.dom_keep, sc0, sc2)), p85b)
  // (let t2)
  have p7fb := mp(mp(tr.wred[s := s, v := act.v(s), base := 4205681, code := a_ctz_32.code(), a := 4205695, hs := act.hs(args), rs := act.rs3(args), w := act.w(s),
    q := act.q3(args), q2 := act.q4(args), kw := x3 x4 x2. KW(x3, x4, x2)],
