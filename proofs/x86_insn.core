// mov [rsp + d], r32 / r64 (89 /r) where the bytes may not be accessible
// yet (the frame's first store there): touched for writing -- the stack may
// grow, or the touch fault -- then written
theorem x86i.store_rsp_t: all m o n g d z1 z2 len x. m in x86_64_linux.Machine -> m in univ(1) -> g in x86_64_linux.Reg -> d in bits(64) ->
  (n = 4 && x = bits_slice(m.gpr[g], 31, 0) || n = 8 && x = m.gpr[g]) ->
  (all i. i in omega -> int_lt(i, n) -> x86_64_linux.canonical(bits_add(64, x86i.rsp_ea(m, d), bits_of_int(64, i)))) ->
  runs(x86_64_linux.exec_body(len, tag(75, pair(n, pair(g, pair(x86i.rsp_mem(d), pair(z1, z2)))))), m, o) ->
  (ex m1 e1. runs(x86_64_linux.touch_range(x86i.rsp_ea(m, d), n, 1), fn_update(m, "rip", bits_add(64, m.rip, len)), ok(m1, e1)) &&
    o = ok(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, x86i.rsp_ea(m, d), n, x))), empty)) ||
  (ex y e. runs(x86_64_linux.touch_range(x86i.rsp_ea(m, d), n, 1), fn_update(m, "rip", bits_add(64, m.rip, len)), exc(y, e)) && o = exc(y, e)) ||
  (ex t. runs(x86_64_linux.touch_range(x86i.rsp_ea(m, d), n, 1), fn_update(m, "rip", bits_add(64, m.rip, len)), diverge(t)) && o = diverge(t))
proof
  fix m o n g d z1 z2 len x
  assume hM hu hg hd hn hk hr
  have pt := apply(x86i.parts, hM)
  show by simp(hr, hu, pt, hn, apply(x86i.reg_typed, hM, hg), hd, apply(x86i.rsp_typed, hM), hk, keep(x86_64_linux.touch_range))
qed

// mov dword [rsp + d], imm32 (C7 /0 id) where the bytes may not be
// accessible yet: touched for writing, then written
theorem x86i.store32i_rsp_t: all m o d k len. m in x86_64_linux.Machine -> m in univ(1) -> d in bits(64) -> k in bits(32) ->
  (all i. i in omega -> int_lt(i, 4) -> x86_64_linux.canonical(bits_add(64, x86i.rsp_ea(m, d), bits_of_int(64, i)))) ->
  runs(x86_64_linux.exec_body(len, tag(77, pair(4, pair(x86i.rsp_mem(d), pair(x86i.rsp_mem(d), k))))), m, o) ->
  (ex m1 e1. runs(x86_64_linux.touch_range(x86i.rsp_ea(m, d), 4, 1), fn_update(m, "rip", bits_add(64, m.rip, len)), ok(m1, e1)) &&
    o = ok(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, x86i.rsp_ea(m, d), 4, k))), empty)) ||
  (ex y e. runs(x86_64_linux.touch_range(x86i.rsp_ea(m, d), 4, 1), fn_update(m, "rip", bits_add(64, m.rip, len)), exc(y, e)) && o = exc(y, e)) ||
  (ex t. runs(x86_64_linux.touch_range(x86i.rsp_ea(m, d), 4, 1), fn_update(m, "rip", bits_add(64, m.rip, len)), diverge(t)) && o = diverge(t))
proof
  fix m o d k len
  assume hM hu hd hk k0 h
  have pt := apply(x86i.parts, hM)
  have se: bits_sext(32, 32, k) = k by defs(simp(hk), bits_sext)
  show by simp(h, hu, pt, hk, se, hd, apply(x86i.rsp_typed, hM), k0, keep(x86_64_linux.touch_range))
qed

// mov qword [rsp + d], simm32 (REX.W C7 /0 id): the frame's bytes touched
theorem x86i.store64i_rsp_t: all m o d k len. m in x86_64_linux.Machine -> m in univ(1) -> d in bits(64) -> k in bits(32) ->
  (all i. i in omega -> int_lt(i, 8) -> x86_64_linux.canonical(bits_add(64, x86i.rsp_ea(m, d), bits_of_int(64, i)))) ->
  runs(x86_64_linux.exec_body(len, tag(77, pair(8, pair(x86i.rsp_mem(d), pair(x86i.rsp_mem(d), k))))), m, o) ->
  (ex m1 e1. runs(x86_64_linux.touch_range(x86i.rsp_ea(m, d), 8, 1), fn_update(m, "rip", bits_add(64, m.rip, len)), ok(m1, e1)) &&
    o = ok(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, x86i.rsp_ea(m, d), 8, bits_sext(32, 64, k)))), empty)) ||
  (ex y e. runs(x86_64_linux.touch_range(x86i.rsp_ea(m, d), 8, 1), fn_update(m, "rip", bits_add(64, m.rip, len)), exc(y, e)) && o = exc(y, e)) ||
  (ex t. runs(x86_64_linux.touch_range(x86i.rsp_ea(m, d), 8, 1), fn_update(m, "rip", bits_add(64, m.rip, len)), diverge(t)) && o = diverge(t))
proof
  fix m o d k len
  assume hM hu hd hk k0 h
  have pt := apply(x86i.parts, hM)
  show by simp(h, hu, pt, hk, hd, apply(x86i.rsp_typed, hM), k0, keep(x86_64_linux.touch_range))
qed

// a base-plus-displacement memory operand [b + d], and its address
abbrev x86i.bd_mem(b, d) := tag(2, fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(2, b)), "index", none), "scale", 1), "disp", d))
abbrev x86i.bd_ea(m, b, d) := bits_add(64, int_add(m.gpr[b], d), 0)

// mov [b + d], r64 (REX.W 89 /r)
theorem x86i.store64_bd: all m o g b d z1 z2 len. m in x86_64_linux.Machine -> m in univ(1) -> g in x86_64_linux.Reg -> b in x86_64_linux.Reg -> d in bits(64) ->
  x86i.acc(m, x86i.bd_ea(m, b, d), 8, 1) ->
  runs(x86_64_linux.exec_body(len, tag(75, pair(8, pair(g, pair(x86i.bd_mem(b, d), pair(z1, z2)))))), m, o) ->
  o = ok(fn_update(fn_update(m, "rip", bits_add(64, m.rip, len)), "vm",
    fn_update(m.vm, "bytes", x86_64_linux.store_le(m.vm.bytes, x86i.bd_ea(m, b, d), 8, m.gpr[g]))), empty)
proof
  fix m o g b d z1 z2 len
  assume hM hu hg hb hd a0 h
  have pt := apply(x86i.parts, hM)
  have k0: all i. i in omega -> int_lt(i, 8) -> x86_64_linux.canonical(bits_add(64, x86i.bd_ea(m, b, d), bits_of_int(64, i))) proof
    fix i
    assume i1 i2
    show by mp(all_elim(all_elim(all_elim(x86.access_canonical, {m.vm}), {bits_add(64, x86i.bd_ea(m, b, d), bits_of_int(64, i))}), {1}), mp(mp(all_elim(a0, {i}), i1), i2))
  qed
  show by simp(h, hu, pt, apply(x86i.reg_typed, hM, hg), apply(x86i.reg_typed, hM, hb), hd, a0, k0, x86.touch_range_access, keep(x86_64_linux.touch_range, x86_64_linux.can_access))
qed

// mov [b + d], r32 (89 /r)
theorem x86i.store32_bd: all m o g b d z1 z2 len. m in x86_64_linux.Machine -> m in univ(1) -> g in x86_64_linux.Reg -> b in x86_64_linux.Reg -> d in bits(64) ->
  x86i.acc(m, x86i.bd_ea(m, b, d), 4, 1) ->
  runs(x86_64_linux.exec_body(len, tag(75, pair(4, pair(g, pair(x86i.bd_mem(b, d), pair(z1, z2)))))), m, o) ->
