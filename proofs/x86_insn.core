// `xor` commutes (as `and`, x86.and_comm)
theorem x86i.xor_comm: all n a b. bits_xor(n, a, b) = bits_xor(n, b, a)
proof
  fix n a b
  have pq: all x. (x in bits(n) && (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> !(bit(a, i) <-> bit(b, i))))) <-> (x in bits(n) && (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> !(bit(b, i) <-> bit(a, i))))) proof
    fix x
    have d1: (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> !(bit(a, i) <-> bit(b, i)))) -> (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> !(bit(b, i) <-> bit(a, i)))) proof
      assume h
      fix i
      assume i1 i2
      have hi := mp(all_elim(h, {i}), i1, i2)
      show by taut(hi)
    qed
    have d2: (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> !(bit(b, i) <-> bit(a, i)))) -> (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> !(bit(a, i) <-> bit(b, i)))) proof
      assume h
      fix i
      assume i1 i2
      have hi := mp(all_elim(h, {i}), i1, i2)
      show by taut(hi)
    qed
    show by taut(d1, d2)
  qed
  have e := mp(choose_ext[p := x. x in bits(n) && (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> !(bit(a, i) <-> bit(b, i)))), q := x. x in bits(n) && (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> !(bit(b, i) <-> bit(a, i))))], pq)
  show by defs(e, bits_xor, bits_build)
qed

