theorem x86i.mov64_simm: all m o g z k len. m in x86_64_linux.Machine -> m in univ(1) -> g in x86_64_linux.Reg -> k in bits(32) ->
  runs(x86_64_linux.exec_body(len, tag(77, pair(8, pair(tag(0, g), pair(z, k))))), m, o) ->
  o = ok(fn_update(fn_update(m, "rip", bits_add(64, m.rip, len)), "gpr", fn_update(m.gpr, g, bits_sext(32, 64, k))), empty)
proof
  fix m o g z k len
  assume hM hu hg hk hr
  have pt := apply(x86i.parts, hM)
  show by simp(hr, hu, pt, hk, apply(x86i.reg_typed, hM, hg), x86i.bool_univ)
qed

// mov r64, [rip + d] (REX.W 8B /r)
theorem x86i.load64_rip: all m o g d z2 len. m in x86_64_linux.Machine -> m in univ(1) -> g in x86_64_linux.Reg -> d in bits(64) ->
  x86i.acc(m, x86i.rip_ea(m, len, d), 8, 0) ->
  runs(x86_64_linux.exec_body(len, tag(76, pair(8, pair(g, pair(x86i.rip_mem(d), pair(x86i.rip_mem(d), z2)))))), m, o) ->
  o = ok(fn_update(fn_update(m, "rip", bits_add(64, m.rip, len)), "gpr",
    fn_update(m.gpr, g, x86_64_linux.le(m.vm.bytes, x86i.rip_ea(m, len, d), 8))), empty)
proof
  fix m o g d z2 len
  assume hM hu h0 h2 a0 hr
  have pt := apply(x86i.parts, hM)
  have k0: all j. j in omega -> int_lt(j, 8) -> x86_64_linux.canonical(bits_add(64, x86i.rip_ea(m, len, d), bits_of_int(64, j))) proof
    fix j
    assume j1 j2
    show by mp(all_elim(all_elim(all_elim(x86.access_canonical, {m.vm}), {bits_add(64, x86i.rip_ea(m, len, d), bits_of_int(64, j))}), {0}), mp(mp(all_elim(a0, {j}), j1), j2))
  qed
  show by simp(hr, hu, pt, h2, apply(x86i.reg_typed, hM, h0), a0, k0, x86.touch_range_access, keep(x86_64_linux.touch_range, x86_64_linux.can_access))
qed

