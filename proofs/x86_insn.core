    fn_update(m.gpr, g, bits_of_int(32, int_mul(sint(32, bits_slice(m.gpr[g], 31, 0)), sint(32, bits_slice(m.gpr[h], 31, 0)))))), empty)
proof
  fix m o g h z1 z2 len
  assume hM hu hg hh hr
  have pt := apply(x86i.parts, hM)
  show by defs(simp(hr, hu, pt, apply(x86i.reg_typed, hM, hg), apply(x86i.reg_typed, hM, hh), x86i.bool_univ), x86i.flags_ok)
qed

// and ax, imm16 (66 25 iw)
theorem x86i.and16_ax: all m o k len. m in x86_64_linux.Machine -> m in univ(1) -> k in bits(16) ->
  runs(x86_64_linux.exec_body(len, tag(49, pair(2, k))), m, o) ->
