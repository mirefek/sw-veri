// (a word and itself: itself)
theorem x86i.and_self: all n y. n in omega -> y in bits(n) -> bits_and(n, y, y) = y
proof
  fix n y
  assume hn hy
  have ai := mp(bits_and_in[n := n, x := y, y := y], hn)
  have g: all i. i in omega -> int_lt(i, n) -> (bit(bits_and(n, y, y), i) <-> bit(y, i)) proof
    fix i
    assume i1 i2
    have b := mp(bit_and[n := n, x := y, y := y, i := i], hn, i1, i2)
    show by taut(b)
  qed
  show := mp(all_elim(mp(all_elim(bits_ext, {n}), hn), {bits_and(n, y, y)}, {y}), ai, hy, g)
qed

