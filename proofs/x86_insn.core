// mov [rsp + d], r64 (REX.W 89 /r)
theorem x86i.store64_rsp: all m o g d z1 z2 len. m in x86_64_linux.Machine -> m in univ(1) -> g in x86_64_linux.Reg -> d in bits(64) ->
  x86i.acc(m, x86i.rsp_ea(m, d), 8, 1) ->
  runs(x86_64_linux.exec_body(len, tag(75, pair(8, pair(g, pair(x86i.rsp_mem(d), pair(z1, z2)))))), m, o) ->
  o = ok(fn_update(fn_update(m, "rip", bits_add(64, app(m, "rip"), len)), "vm",
    fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), x86i.rsp_ea(m, d), 8, app(app(m, "gpr"), g)))), empty)
proof
  fix m
  fix o
  fix g
  fix d
  fix z1
  fix z2
  fix len
  assume hM: m in x86_64_linux.Machine
  assume hu: m in univ(1)
  assume hg: g in x86_64_linux.Reg
  assume hd: d in bits(64)
  assume a0: x86i.acc(m, x86i.rsp_ea(m, d), 8, 1)
  assume h: runs(x86_64_linux.exec_body(len, tag(75, pair(8, pair(g, pair(x86i.rsp_mem(d), pair(z1, z2)))))), m, o)
  have pt := apply(x86i.parts, hM)
  have k0: all i. i in omega -> int_lt(i, 8) -> x86_64_linux.canonical(bits_add(64, x86i.rsp_ea(m, d), bits_of_int(64, i))) proof
    fix i
    assume i1: i in omega
    assume i2: int_lt(i, 8)
    show by mp(all_elim(all_elim(all_elim(x86.access_canonical, {app(m, "vm")}), {bits_add(64, x86i.rsp_ea(m, d), bits_of_int(64, i))}), {1}), mp(mp(all_elim(a0, {i}), i1), i2))
  qed
  show by simp(h, hu, pt, apply(x86i.reg_typed, hM, hg), hd, apply(x86i.rsp_typed, hM), a0, k0, x86.touch_range_access, keep(x86_64_linux.touch_range, x86_64_linux.can_access))
qed

// mov r64, [rsp + d] (REX.W 8B /r)
theorem x86i.load64_rsp: all m o g d z1 z2 len. m in x86_64_linux.Machine -> m in univ(1) -> g in x86_64_linux.Reg -> d in bits(64) ->
  x86i.acc(m, x86i.rsp_ea(m, d), 8, 0) ->
  runs(x86_64_linux.exec_body(len, tag(76, pair(8, pair(g, pair(x86i.rsp_mem(d), pair(z1, z2)))))), m, o) ->
  o = ok(fn_update(fn_update(m, "rip", bits_add(64, app(m, "rip"), len)), "gpr",
    fn_update(app(m, "gpr"), g, x86_64_linux.le(app(app(m, "vm"), "bytes"), x86i.rsp_ea(m, d), 8))), empty)
proof
  fix m
  fix o
  fix g
  fix d
  fix z1
  fix z2
  fix len
  assume hM: m in x86_64_linux.Machine
  assume hu: m in univ(1)
  assume hg: g in x86_64_linux.Reg
  assume hd: d in bits(64)
  assume a0: x86i.acc(m, x86i.rsp_ea(m, d), 8, 0)
  assume h: runs(x86_64_linux.exec_body(len, tag(76, pair(8, pair(g, pair(x86i.rsp_mem(d), pair(z1, z2)))))), m, o)
  have pt := apply(x86i.parts, hM)
  have k0: all i. i in omega -> int_lt(i, 8) -> x86_64_linux.canonical(bits_add(64, x86i.rsp_ea(m, d), bits_of_int(64, i))) proof
    fix i
    assume i1: i in omega
    assume i2: int_lt(i, 8)
    show by mp(all_elim(all_elim(all_elim(x86.access_canonical, {app(m, "vm")}), {bits_add(64, x86i.rsp_ea(m, d), bits_of_int(64, i))}), {0}), mp(mp(all_elim(a0, {i}), i1), i2))
  qed
  show by simp(h, hu, pt, apply(x86i.reg_typed, hM, hg), hd, apply(x86i.rsp_typed, hM), a0, k0, x86.touch_range_access, keep(x86_64_linux.touch_range, x86_64_linux.can_access))
qed

// sub r/m64 (a register g), imm8 (REX.W 83 /5 ib): the immediate sign-extended
theorem x86i.sub64_imm: all m o g z k len. m in x86_64_linux.Machine -> m in univ(1) -> g in x86_64_linux.Reg -> k in bits(8) ->
  runs(x86_64_linux.exec_body(len, tag(60, pair(8, pair(5, pair(tag(0, g), pair(z, k)))))), m, o) ->
  ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", bits_add(64, app(m, "rip"), len)), "flags", f), "gpr",
    fn_update(app(m, "gpr"), g, bits_sub(64, app(app(m, "gpr"), g), bits_sext(8, 64, k)))), empty)
proof
  fix m
  fix o
  fix g
  fix z
  fix k
  fix len
  assume hM: m in x86_64_linux.Machine
  assume hu: m in univ(1)
  assume hg: g in x86_64_linux.Reg
  assume hk: k in bits(8)
  assume hr: runs(x86_64_linux.exec_body(len, tag(60, pair(8, pair(5, pair(tag(0, g), pair(z, k)))))), m, o)
  have pt := apply(x86i.parts, hM)
  show by defs(simp(hr, hu, pt, apply(x86i.reg_typed, hM, hg), hk, x86i.bool_univ), x86i.flags_ok)
qed

// call rel32 (E8 cd): the return address (rip after it) pushed -- its 8
// bytes touched for writing (the stack may grow, or the touch fault) --
// then rip := the target
theorem x86i.call_rel32: all m o off len. m in x86_64_linux.Machine -> m in univ(1) -> off in bits(32) ->
  int_le(8, app(app(m, "gpr"), 4)) -> int_lt(app(app(m, "gpr"), 4), 140737488355328) ->
  runs(x86_64_linux.exec_body(len, tag(120, off)), m, o) ->
  (ex m1 e1. runs(x86_64_linux.touch_range(bits_sub(64, app(app(m, "gpr"), 4), 8), 8, 1), fn_update(m, "rip", bits_add(64, app(m, "rip"), bits_of_int(64, len))), ok(m1, e1)) &&
    o = ok(fn_update(fn_update(fn_update(m1, "vm", fn_update(app(m1, "vm"), "bytes", x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), bits_sub(64, app(app(m, "gpr"), 4), 8), 8,
      bits_add(64, app(m, "rip"), bits_of_int(64, len))))), "gpr", fn_update(app(m1, "gpr"), 4, bits_sub(64, app(app(m, "gpr"), 4), 8))), "rip",
      bits_add(64, app(m1, "rip"), bits_sext(32, 64, off))), empty)) ||
  (ex x e. runs(x86_64_linux.touch_range(bits_sub(64, app(app(m, "gpr"), 4), 8), 8, 1), fn_update(m, "rip", bits_add(64, app(m, "rip"), bits_of_int(64, len))), exc(x, e)) &&
    o = exc(x, e)) ||
  (ex t. runs(x86_64_linux.touch_range(bits_sub(64, app(app(m, "gpr"), 4), 8), 8, 1), fn_update(m, "rip", bits_add(64, app(m, "rip"), bits_of_int(64, len))), diverge(t)) &&
    o = diverge(t))
proof
  fix m
  fix o
  fix off
  fix len
  assume hM: m in x86_64_linux.Machine
  assume hu: m in univ(1)
  assume ho: off in bits(32)
  assume h8: int_le(8, app(app(m, "gpr"), 4))
  assume hl: int_lt(app(app(m, "gpr"), 4), 140737488355328)
  assume hr: runs(x86_64_linux.exec_body(len, tag(120, off)), m, o)
  have pt := apply(x86i.parts, hM)
  have r4 := apply(x86i.rsp_typed, hM)
  have k0: all j. j in omega -> int_lt(j, 8) -> x86_64_linux.canonical(bits_add(64, bits_sub(64, app(app(m, "gpr"), 4), 8), bits_of_int(64, j))) proof
    fix j
    assume j1: j in omega
    assume j2: int_lt(j, 8)
    have p64: pow2(64) = 18446744073709551616 by simp()
    have e0: int_mod(int_add(int_mod(int_sub(app(app(m, "gpr"), 4), 8), 18446744073709551616), int_mod(j, 18446744073709551616)), 18446744073709551616) =
      int_add(int_sub(app(app(m, "gpr"), 4), 8), j) by arith(r4, h8, hl, j1, j2)
    have e: bits_add(64, bits_sub(64, app(app(m, "gpr"), 4), 8), bits_of_int(64, j)) = int_add(int_sub(app(app(m, "gpr"), 4), 8), j)
      by defs(rewrite(sym(p64), e0), bits_add, bits_sub, bits_of_int)
    have c0: int_lt(int_add(int_sub(app(app(m, "gpr"), 4), 8), j), 140737488355328) by arith(r4, hl, j1, j2)
    have pw: int_pow(2, 47) = 140737488355328 by simp()
    have c := rewrite(sym(pw), c0)
    have c2 := rewrite(sym(e), c)
    show by defs(taut(c2), x86_64_linux.canonical)
  qed
  show by simp(hr, hu, pt, r4, ho, k0, keep(x86_64_linux.touch_range))
qed

// add r/m64 (a register g), imm8 (REX.W 83 /0 ib)
theorem x86i.add64_imm: all m o g z k len. m in x86_64_linux.Machine -> m in univ(1) -> g in x86_64_linux.Reg -> k in bits(8) ->
