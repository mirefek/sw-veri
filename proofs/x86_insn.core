qed

// lea r64, [i * k]
theorem x86i.lea64_is: all m o g i sc z1 z2 z3 len. m in x86_64_linux.Machine -> m in univ(1) -> g in x86_64_linux.Reg -> i in x86_64_linux.Reg -> sc in omega ->
  runs(x86_64_linux.exec_body(len, tag(78, pair(8, pair(g, pair(z1, pair(z2, pair(z3, fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(0, empty)), "index", some(i)), "scale", sc), "disp", 0)))))))), m, o) ->
  o = ok(fn_update(fn_update(m, "rip", bits_add(64, m.rip, len)), "gpr", fn_update(m.gpr, g, bits_mul(64, m.gpr[i], bits_add(64, sc, 0)))), empty)
