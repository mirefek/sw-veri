  x86i.acc(m, x86i.rsp_ea(m, d), 4, 0) -> x86i.acc(m, x86i.rsp_ea(m, d), 4, 1) ->
  runs(x86_64_linux.exec_body(len, tag(73, pair(4, pair(7, pair(x86i.rsp_mem(d), x86i.rsp_mem(d)))))), m, o) ->
  ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", bits_add(64, m.rip, len)), "flags", f), "vm",
    fn_update(m.vm, "bytes", x86_64_linux.store_le(m.vm.bytes, x86i.rsp_ea(m, d), 4,
      bits_sar(32, x86_64_linux.le(m.vm.bytes, x86i.rsp_ea(m, d), 4), 1)))), empty)
proof
  fix m o d len
  assume hM hu hd a0 a1 h
  have pt := apply(x86i.parts, hM)
  have k0: all i. i in omega -> int_lt(i, 4) -> x86_64_linux.canonical(bits_add(64, x86i.rsp_ea(m, d), bits_of_int(64, i))) proof
    fix i
    assume i1 i2
    show by mp(all_elim(all_elim(all_elim(x86.access_canonical, {m.vm}), {bits_add(64, x86i.rsp_ea(m, d), bits_of_int(64, i))}), {0}), mp(mp(all_elim(a0, {i}), i1), i2))
  qed
  show by defs(simp(h, hu, pt, hd, apply(x86i.rsp_typed, hM), a0, a1, k0, x86.touch_range_access, x86i.bool_univ, keep(x86_64_linux.touch_range, x86_64_linux.can_access)), x86i.flags_ok)
qed

