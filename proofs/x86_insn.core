qed

// lock cmpxchg [b], r32 (F0 0F B1 /r): the dword D at b against eax (A): g's
// low dword written if they agree, else D written back and eax := D
theorem x86i.cas32_b: all m o g b z1 z2 z3 len. m in x86_64_linux.Machine -> m in univ(1) -> g in x86_64_linux.Reg -> b in x86_64_linux.Reg ->
  x86i.acc(m, x86i.bd_ea(m, b, 0), 4, 0) -> x86i.acc(m, x86i.bd_ea(m, b, 0), 4, 1) ->
  runs(x86_64_linux.exec_body(len, tag(97, pair(4, pair(g, pair(x86i.bd_mem(b, 0), pair(z1, pair(z2, z3))))))), m, o) ->
  (bits_slice(m.gpr[0], 31, 0) = x86_64_linux.le(m.vm.bytes, x86i.bd_ea(m, b, 0), 4) ->
    ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", bits_add(64, m.rip, len)), "flags", f), "vm",
      fn_update(m.vm, "bytes", x86_64_linux.store_le(m.vm.bytes, x86i.bd_ea(m, b, 0), 4, bits_slice(m.gpr[g], 31, 0)))), empty)) &&
  (!(bits_slice(m.gpr[0], 31, 0) = x86_64_linux.le(m.vm.bytes, x86i.bd_ea(m, b, 0), 4)) ->
    ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(fn_update(m, "rip", bits_add(64, m.rip, len)), "flags", f), "vm",
      fn_update(m.vm, "bytes", x86_64_linux.store_le(m.vm.bytes, x86i.bd_ea(m, b, 0), 4, x86_64_linux.le(m.vm.bytes, x86i.bd_ea(m, b, 0), 4)))), "gpr",
      fn_update(m.gpr, 0, x86_64_linux.le(m.vm.bytes, x86i.bd_ea(m, b, 0), 4))), empty))
proof
  fix m o g b z1 z2 z3 len
  assume hM hu hg hb a0 a1 h
  have pt := apply(x86i.parts, hM)
  have k0: all i. i in omega -> int_lt(i, 4) -> x86_64_linux.canonical(bits_add(64, x86i.bd_ea(m, b, 0), bits_of_int(64, i))) proof
    fix i
    assume i1 i2
    show by mp(all_elim(all_elim(all_elim(x86.access_canonical, {m.vm}), {bits_add(64, x86i.bd_ea(m, b, 0), bits_of_int(64, i))}), {1}), mp(mp(all_elim(a1, {i}), i1), i2))
  qed
  show by defs(simp(h, hu, pt, apply(x86i.reg_typed, hM, hg), apply(x86i.reg_typed, hM, hb), mp(x86i.reg_typed, {m}, {0}, hM, simp()), a0, a1, k0, x86.touch_range_access, x86i.bool_univ, keep(x86_64_linux.touch_range, x86_64_linux.can_access)), x86i.flags_ok)
qed

// ----------------------------------------------------------------------
//  Compares and tests by their flags: all a jump reads, as x86 sets them
//  (a jump's condition then by the flags alone, proofs/translate_flags.core)

// cmp a, b (n bits): its difference's zero and sign, the borrow, the signed
// overflow
def x86i.subf(n, a, b, f) := a in bits(n) && b in bits(n) &&
  f.zf = (bits_sub(n, a, b) = 0) && f.cf = int_lt(a, b) && f.sf = bit(bits_sub(n, a, b), int_sub(n, 1)) &&
  f.of = (!(int_sub(sint(n, a), sint(n, b)) = sint(n, bits_sub(n, a, b))))

// test (n bits) of the result r: its zero and sign, no carry, no overflow
def x86i.logf(n, r, f) := r in bits(n) && f.zf = (r = 0) && f.sf = bit(r, int_sub(n, 1)) &&
  f.cf = false && f.of = false

// cmp dword [rsp + d], r32
theorem x86i.cmpf32_rsp_r: all m o g d len. m in x86_64_linux.Machine -> m in univ(1) -> g in x86_64_linux.Reg -> d in bits(64) ->
  x86i.acc(m, x86i.rsp_ea(m, d), 4, 0) ->
  runs(x86_64_linux.exec_body(len, tag(56, pair(4, pair(g, pair(x86i.rsp_mem(d), pair(x86i.rsp_mem(d), tag(0, g))))))), m, o) ->
  ex f. x86i.flags_ok(m, f) && x86i.subf(32, x86_64_linux.le(m.vm.bytes, x86i.rsp_ea(m, d), 4), bits_slice(m.gpr[g], 31, 0), f) && o = ok(fn_update(fn_update(m, "rip", bits_add(64, m.rip, len)), "flags", f), empty)
proof
  fix m o g d len
  assume hM hu hg hd a0 h
  have pt := apply(x86i.parts, hM)
  have k0: all i. i in omega -> int_lt(i, 4) -> x86_64_linux.canonical(bits_add(64, x86i.rsp_ea(m, d), bits_of_int(64, i))) proof
    fix i
    assume i1 i2
    show by mp(all_elim(all_elim(all_elim(x86.access_canonical, {m.vm}), {bits_add(64, x86i.rsp_ea(m, d), bits_of_int(64, i))}), {0}), mp(mp(all_elim(a0, {i}), i1), i2))
  qed
  show by defs(simp(h, hu, pt, hd, apply(x86i.reg_typed, hM, hg), apply(x86i.rsp_typed, hM), a0, k0, x86.touch_range_access, x86i.bool_univ, keep(x86_64_linux.touch_range, x86_64_linux.can_access)), x86i.flags_ok, x86i.subf)
qed

