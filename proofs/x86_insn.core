// movzx r32, r/m8 (a byte register h, 0F B6 /r)
theorem x86i.movzx8_rr: all m o g h z2 len. m in x86_64_linux.Machine -> m in univ(1) -> g in x86_64_linux.Reg -> h in x86_64_linux.Reg -> int_lt(h, 4) ->
  runs(x86_64_linux.exec_body(len, tag(79, pair(4, pair(g, pair(tag(0, h), pair(tag(0, h), z2)))))), m, o) ->
  o = ok(fn_update(fn_update(m, "rip", bits_add(64, app(m, "rip"), len)), "gpr", fn_update(app(m, "gpr"), g, bits_slice(app(app(m, "gpr"), h), 7, 0))), empty)
proof
  fix m
  fix o
  fix g
  fix h
  fix z2
  fix len
  assume hM: m in x86_64_linux.Machine
  assume hu: m in univ(1)
  assume hg: g in x86_64_linux.Reg
  assume hh: h in x86_64_linux.Reg
  assume hh2: int_lt(h, 4)
  assume hr: runs(x86_64_linux.exec_body(len, tag(79, pair(4, pair(g, pair(tag(0, h), pair(tag(0, h), z2)))))), m, o)
  have pt := apply(x86i.parts, hM)
  show by simp(hr, hu, pt, apply(x86i.reg_typed, hM, hg), hh, hh2, apply(x86i.reg_typed, hM, hh))
qed

// movzx r32, byte [b] (0F B6 /r)
theorem x86i.movzx8_base: all m o g b z2 len. m in x86_64_linux.Machine -> m in univ(1) -> g in x86_64_linux.Reg -> b in x86_64_linux.Reg ->
  x86i.acc(m, bits_add(64, app(app(m, "gpr"), b), 0), 1, 0) ->
  runs(x86_64_linux.exec_body(len, tag(79, pair(4, pair(g, pair(tag(2, fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(2, b)), "index", none), "scale", 1), "disp", 0)), pair(tag(2, fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(2, b)), "index", none), "scale", 1), "disp", 0)), z2)))))), m, o) ->
  o = ok(fn_update(fn_update(m, "rip", bits_add(64, app(m, "rip"), len)), "gpr",
    fn_update(app(m, "gpr"), g, x86_64_linux.le(app(app(m, "vm"), "bytes"), bits_add(64, app(app(m, "gpr"), b), 0), 1))), empty)
proof
  fix m
  fix o
  fix g
  fix b
  fix z2
  fix len
  assume hM: m in x86_64_linux.Machine
  assume hu: m in univ(1)
  assume hg: g in x86_64_linux.Reg
  assume hb: b in x86_64_linux.Reg
  assume a0: x86i.acc(m, bits_add(64, app(app(m, "gpr"), b), 0), 1, 0)
  assume hr: runs(x86_64_linux.exec_body(len, tag(79, pair(4, pair(g, pair(tag(2, fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(2, b)), "index", none), "scale", 1), "disp", 0)), pair(tag(2, fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(2, b)), "index", none), "scale", 1), "disp", 0)), z2)))))), m, o)
  have pt := apply(x86i.parts, hM)
  have k0: all j. j in omega -> int_lt(j, 1) -> x86_64_linux.canonical(bits_add(64, bits_add(64, app(app(m, "gpr"), b), 0), bits_of_int(64, j))) proof
    fix j
    assume j1: j in omega
    assume j2: int_lt(j, 1)
    show by mp(all_elim(all_elim(all_elim(x86.access_canonical, {app(m, "vm")}), {bits_add(64, bits_add(64, app(app(m, "gpr"), b), 0), bits_of_int(64, j))}), {0}), mp(mp(all_elim(a0, {j}), j1), j2))
  qed
  show by simp(hr, hu, pt, apply(x86i.reg_typed, hM, hg), apply(x86i.reg_typed, hM, hb), a0, k0, x86.touch_range_access, keep(x86_64_linux.touch_range, x86_64_linux.can_access))
qed

