      show by defs(ex_intro({empty}, simp(hh, hp, hsh, mc2, keep(abi.abi_function, abi.code_at, abi.run_to_return))), with_ghost)
    qed
  qed
  show by defs(main, abi.implements2_at, refines_ghost)
qed
