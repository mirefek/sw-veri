    fix args
    assume hA: args in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6))
    show all s h o. s in x86_64_linux.Machine -> h in single(empty) -> runs(abi.run_to_return(), s, o) -> (ex h2. h2 in single(empty) && runs(mkprog(x1 x2. !abi.code_at(app(x1, "vm"), 4202755, get_slot_index.code()) || bind_rel(abi.abi_function(single(empty), 4202755, c_src_malloc_mallocng_malloc.get_slot_index_fun(), args), x1, x3 x4. x2 = ok(x3, empty), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), union2(s, h), with_ghost(o, h2))) proof
      fix s
      fix h
      fix o
      assume hM: s in x86_64_linux.Machine
      assume hh: h in single(empty)
      assume hr: runs(abi.run_to_return(), s, o)
      have hp := mp(all_elim(all_elim(abi.run_univ, {s}), {o}), hr)
      have hsh := mp(all_elim(all_elim(abi.run_shape, {s}), {o}), hr)
      have mc: abi.code_at(app(s, "vm"), 4202755, get_slot_index.code()) -> runs(abi.abi_function(single(empty), 4202755, c_src_malloc_mallocng_malloc.get_slot_index_fun(), args), s, o) proof
        assume hc: abi.code_at(app(s, "vm"), 4202755, get_slot_index.code())
        show := mp(mp(mp(mp(all_elim(all_elim(all_elim(gsi.machine, {args}), {s}), {o}), hA), hM), hc), hr)
      qed
