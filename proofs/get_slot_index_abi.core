// undefined behavior: the spec raises from the world the ABI shows (with
// the stack slot as the machine will have written it)
theorem gsi.ub: all f args s o. s in x86_64_linux.Machine -> args in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) -> abi.entry_ok(s, args) ->
  !(int_le(3, bits_of_int(64, app(args, 0))) && !(int_sub(bits_of_int(64, app(args, 0)), 3) = 0) && gimple.usable(fn_update(app(s, "vm"), "bytes", x86_64_linux.store_le(app(app(s, "vm"), "bytes"), bits_add(64, app(app(s, "gpr"), 4), 18446744073709551608), 8, app(app(s, "gpr"), 7))), int_sub(bits_of_int(64, app(args, 0)), 3), 1, false)) -> pair(s, o) in univ(1) -> ((ex m1 e. o = ok(m1, e)) || (ex m1 e. o = exc(m1, e)) || (ex t. o = diverge(t))) ->
  runs(abi.abi_function(single(empty), f, c_src_malloc_mallocng_malloc.get_slot_index_fun(), args), s, o)
proof
  fix f
  fix args
  fix s
  fix o
  assume hM: s in x86_64_linux.Machine
  assume hA: args in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6))
  assume he: abi.entry_ok(s, args)
  assume hnc: !(int_le(3, bits_of_int(64, app(args, 0))) && !(int_sub(bits_of_int(64, app(args, 0)), 3) = 0) && gimple.usable(fn_update(app(s, "vm"), "bytes", x86_64_linux.store_le(app(app(s, "vm"), "bytes"), bits_add(64, app(app(s, "gpr"), 4), 18446744073709551608), 8, app(app(s, "gpr"), 7))), int_sub(bits_of_int(64, app(args, 0)), 3), 1, false))
  assume hp: pair(s, o) in univ(1)
  assume ho: (ex m1 e. o = ok(m1, e)) || (ex m1 e. o = exc(m1, e)) || (ex t. o = diverge(t))
  have su: s in univ(1) by simp(hp)
  have mtyp: s in powerset(cart(insert("gpr", insert("xmm", insert("rip", insert("flags", insert("cpu", insert("fs_base", insert("gs_base", insert("vm", insert("os", empty))))))))), univ(1))) && is_fun(s) && dom(s) = insert("gpr", insert("xmm", insert("rip", insert("flags", insert("cpu", insert("fs_base", insert("gs_base", insert("vm", insert("os", empty))))))))) && app(s, "gpr") in fn_space(x86_64_linux.Reg, bits(64)) && app(s, "vm") in x86_64_linux.Vm by simp(expand(hM, x86_64_linux.Machine))
  have and_l0: s in powerset(cart(insert("gpr", insert("xmm", insert("rip", insert("flags", insert("cpu", insert("fs_base", insert("gs_base", insert("vm", insert("os", empty))))))))), univ(1))) by taut(mtyp)
  have tg: app(s, "gpr") in fn_space(x86_64_linux.Reg, bits(64)) by taut(mtyp)
  have hsv: app(s, "vm") in x86_64_linux.Vm by taut(mtyp)
  have r4: 4 in x86_64_linux.Reg by defs(simp(), x86_64_linux.Reg)
  have hsp := mp(mp(fn_space_app[a := x86_64_linux.Reg, b := bits(64), f := app(s, "gpr"), x := 4], tg), r4)
  have bt: app(app(s, "vm"), "bytes") in fn_space(bits(64), bits(8)) by simp(expand(hsv, x86_64_linux.Vm))
  have stt := mp(all_elim(all_elim(all_elim(all_elim(x86.store_typed, {app(app(s, "vm"), "bytes")}), {bits_add(64, app(app(s, "gpr"), 4), 18446744073709551608)}), {8}), {app(app(s, "gpr"), 7)}), bt)
  have stu := mp(mp(mp(fn_space_univ[u := 1, a := bits(64), b := bits(8), f := x86_64_linux.store_le(app(app(s, "vm"), "bytes"), bits_add(64, app(app(s, "gpr"), 4), 18446744073709551608), 8, app(app(s, "gpr"), 7))], bits_univ[n := 64]), bits_univ[n := 8]), stt)
  have hvu: fn_update(app(s, "vm"), "bytes", x86_64_linux.store_le(app(app(s, "vm"), "bytes"), bits_add(64, app(app(s, "gpr"), 4), 18446744073709551608), 8, app(app(s, "gpr"), 7))) in univ(1) by simp(su, stu, keep(x86_64_linux.store_le))
  have hv := mp(mp(all_elim(all_elim(all_elim(all_elim(x86.store_vm, {app(s, "vm")}), {bits_add(64, app(app(s, "gpr"), 4), 18446744073709551608)}), {8}), {app(app(s, "gpr"), 7)}), hsv), hvu)
  have spg: abi.stack_page(app(s, "vm"), int_div(app(app(s, "gpr"), 4), 4096)) by simp(expand(he, abi.entry_ok), keep(abi.stack_page))
  have m16: int_mod(bits_add(64, app(app(s, "gpr"), 4), 8), 16) = 0 by simp(expand(he, abi.entry_ok))
  have wsp: x86_64_linux.can_access(app(s, "vm"), app(app(s, "gpr"), 4), 1) by simp(expand(he, abi.entry_ok), keep(x86_64_linux.can_access))
  have mp0: int_lt(int_div(app(app(s, "gpr"), 4), 4096), 34359738367) by simp(expand(expand(expand(wsp, x86_64_linux.can_access), x86_64_linux.mapped), x86_64_linux.page_of, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))
  have lt47: int_lt(app(app(s, "gpr"), 4), 140737488355328) by simp(hsp, mp0)
  have sv := mp(mp(mp(mp(mp(all_elim(all_elim(all_elim(gsi.store_view, {app(s, "vm")}), {app(app(s, "gpr"), 4)}), {app(app(s, "gpr"), 7)}), hsv), hsp), spg), m16), lt47)
  have hsv1: abi.scratch_view(fn_update(app(s, "vm"), "bytes", x86_64_linux.store_le(app(app(s, "vm"), "bytes"), bits_add(64, app(app(s, "gpr"), 4), 18446744073709551608), 8, app(app(s, "gpr"), 7))), app(s, "vm"), bits_add(64, app(app(s, "gpr"), 4), 8)) by taut(sv)
  have hm1: abi.world_matches(app(s, "vm"), app(s, "vm"), fn_update(app(s, "vm"), "bytes", x86_64_linux.store_le(app(app(s, "vm"), "bytes"), bits_add(64, app(app(s, "gpr"), 4), 18446744073709551608), 8, app(app(s, "gpr"), 7))), bits_add(64, app(app(s, "gpr"), 4), 8)) by taut(sv)
  // the world is a World, and the spec raises from it
  have spb: bits_add(64, app(app(s, "gpr"), 4), 8) in bits(64) by simp(hsp)
  have w0u: fn_update(fn_update(fn_update(fn_update(fn_update(empty, "vm", fn_update(app(s, "vm"), "bytes", x86_64_linux.store_le(app(app(s, "vm"), "bytes"), bits_add(64, app(app(s, "gpr"), 4), 18446744073709551608), 8, app(app(s, "gpr"), 7)))), "os", app(s, "os")), "fs_base", app(s, "fs_base")), "cpu", app(s, "cpu")), "sp", bits_add(64, app(app(s, "gpr"), 4), 8)) in univ(1) by simp(su, hvu, stu, keep(x86_64_linux.store_le))
  have wt := mp(mp(mp(mp(all_elim(all_elim(all_elim(abi.world_typed, {s}), {fn_update(app(s, "vm"), "bytes", x86_64_linux.store_le(app(app(s, "vm"), "bytes"), bits_add(64, app(app(s, "gpr"), 4), 18446744073709551608), 8, app(app(s, "gpr"), 7)))}), {bits_add(64, app(app(s, "gpr"), 4), 8)}), hM), hv), spb), w0u)
  have kf := mp(pow_cart_fst[a := insert("gpr", insert("xmm", insert("rip", insert("flags", insert("cpu", insert("fs_base", insert("gs_base", insert("vm", insert("os", empty))))))))), b := univ(1), f := s], and_l0)
