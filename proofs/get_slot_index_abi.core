// C1 for get_slot_index: its machine code (at -O0, at 0x402103) implements
// its readable GIMPLE under the ABI.
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core core/records.core \
//     core/list.core core/loop.core build/c_mallocng_malloc.core proofs/x86.core proofs/x86_code.core \
//     build/get_slot_index_steps.core proofs/get_slot_index_run.core proofs/abi.core proofs/abi_restore.core \
//     proofs/abi_glue.core proofs/gimple.core proofs/get_slot_index.core proofs/get_slot_index_stack.core \
//     proofs/get_slot_index_abi.core
//
// From abi.implements_intro: a run from a valid entry is one abi_function
// allows. The view of memory the ABI gives the spec is the memory with the
// stack slot as the machine writes it (`vm1`: the slot is scratch space).
// If the spec raises on it, that is undefined behavior (abi.ub_case);
// otherwise the run (get_slot_index.run) returns normally, and its final
// state is the one abi.ret_case asks for.

abbrev gsi.rsp(s) := app(app(s, "gpr"), 4)
abbrev gsi.rdi(s) := app(app(s, "gpr"), 7)
abbrev gsi.vm1(s) := fn_update(app(s, "vm"), "bytes", x86_64_linux.store_le(app(app(s, "vm"), "bytes"), bits_add(64, gsi.rsp(s), 18446744073709551608), 8, gsi.rdi(s)))
// the result, in eax
abbrev gsi.res(s) := bits_and(32, x86_64_linux.le(app(gsi.vm1(s), "bytes"), bits_add(64, gsi.rdi(s), 18446744073709551613), 1), 31)
abbrev gsi.final(s, af) := fn_update(fn_update(fn_update(fn_update(s, "vm", gsi.vm1(s)), "flags",
    fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(app(s, "flags"), "zf", gsi.res(s) = 0), "sf", bit(gsi.res(s), 31)), "pf", x86_64_linux.even_parity(bits_slice(gsi.res(s), 7, 0))), "cf", false), "of", false), "af", af)),
  "gpr", fn_update(fn_update(app(s, "gpr"), 0, gsi.res(s)), 4, bits_add(64, gsi.rsp(s), 8))), "rip", abi.ret(s))
// the spec's argument p, and when p[-3] is defined (on the memory v)
abbrev gsi.p(args) := bits_of_int(64, app(args, 0))
abbrev gsi.defined(v, args) := int_le(3, gsi.p(args)) && !(int_sub(gsi.p(args), 3) = 0) && gimple.usable(v, int_sub(gsi.p(args), 3), 1, false)
abbrev gsi.spec := c_src_malloc_mallocng_malloc.get_slot_index_fun()

theorem gsi.implements: all statics. abi.implements2_at(single(empty), 4202755, gsi.spec, 4202755, get_slot_index.code(), statics)
proof
  fix statics
  have runs: all args s o. args in abi.ARGS -> s in x86_64_linux.Machine -> abi.loaded(app(s, "vm"), 4202755, get_slot_index.code(), statics) -> app(s, "rip") = 4202755 -> abi.entry_ok(s, args) ->
      runs(abi.run_to_return(), s, o) -> runs(abi.abi_function(single(empty), 4202755, gsi.spec, args), s, o) proof
    fix args
    fix s
    fix o
    assume hA: args in abi.ARGS
    assume hM: s in x86_64_linux.Machine
    assume hl: abi.loaded(app(s, "vm"), 4202755, get_slot_index.code(), statics)
    have hc: abi.code_at(app(s, "vm"), 4202755, get_slot_index.code()) by taut(expand(hl, abi.loaded))
    assume hrip: app(s, "rip") = 4202755
    assume he: abi.entry_ok(s, args)
    assume hr: runs(abi.run_to_return(), s, o)
    have hp := apply(abi.run_univ, hr)
    have su: s in univ(1) by simp(hp)
    // the entry: rsp's page is a writable stack page, rsp = 8 (mod 16)
    have hsv: app(s, "vm") in x86_64_linux.Vm by simp(hM)
    have hsp: gsi.rsp(s) in bits(64) by simp(hM)
    have hdi: gsi.rdi(s) in bits(64) by simp(hM)
    have ent := apply(abi.entry_stack, hM, he)
    have sv := apply(gsi.store_view, {app(s, "vm")}, {gsi.rsp(s)}, {gsi.rdi(s)}, hsv, hsp, ent, ent, ent)
    // the view vm1: a memory, in the universe
    have bt: app(app(s, "vm"), "bytes") in fn_space(bits(64), bits(8)) by simp(hM)
    have stt := apply(x86.store_typed, {app(app(s, "vm"), "bytes")}, {bits_add(64, gsi.rsp(s), 18446744073709551608)}, {8}, {gsi.rdi(s)}, bt)
    have stu := apply(fn_space_univ, bits_univ[n := 64], bits_univ[n := 8], stt)
    have v1u: gsi.vm1(s) in univ(1) by simp(su, stu, keep(x86_64_linux.store_le))
    have v1: gsi.vm1(s) in x86_64_linux.Vm by simp(hM, v1u, x86.store_typed)
    let w := abi.view(gsi.vm1(s), s)
    have wu: w in univ(1) by simp(su, v1u)
    have eu: empty in univ(1) by simp()
    // p[-3] undefined: the spec raises
    have ub: !gsi.defined(gsi.vm1(s), args) -> runs(abi.abi_function(single(empty), 4202755, gsi.spec, args), s, o) proof
      assume hn: !gsi.defined(gsi.vm1(s), args)
      have fr := apply(gsi.fun_raises, wu, eu, hA, simp(hn))
      show := apply(abi.ub_case, {4202755}, {gsi.spec}, {args}, {s}, {o}, {gsi.vm1(s)}, {empty}, hM, v1, v1u, sv, sv, eu, fr, hp, simp(apply(abi.run_shape, hr)))
    qed
    // p[-3] defined: the run returns normally, in the state abi.ret_case asks for
    have ret: gsi.defined(gsi.vm1(s), args) -> runs(abi.abi_function(single(empty), 4202755, gsi.spec, args), s, o) proof
      assume hd: gsi.defined(gsi.vm1(s), args)
      have pa := apply(abi.arg0, hM, hA, he, simp(hd))
      have sa := apply(gsi.stack_access, {app(s, "vm")}, {gsi.rsp(s)}, hsp, ent, ent)
      // the byte at p - 3 = rdi - 3 can be read
      have a4: all i. i in omega -> int_lt(i, 1) -> x86_64_linux.can_access(app(s, "vm"), bits_add(64, bits_add(64, gsi.rdi(s), 18446744073709551613), bits_of_int(64, i)), 0) proof
        fix i
        assume i1: i in omega
        assume i2: int_lt(i, 1)
        have r := apply(g.usable_read, {gsi.vm1(s)}, {app(s, "vm")}, {int_sub(gsi.p(args), 3)}, {1}, {i}, hd, simp(), simp(hd), i1, i2)
        have ea: bits_add(64, bits_add(64, gsi.rdi(s), 18446744073709551613), bits_of_int(64, i)) = bits_of_int(64, int_add(int_sub(gsi.p(args), 3), i)) by simp(pa, hdi, hd, i1, i2)
        show := rewrite(sym(ea), r)
      qed
      // the run
      have run := apply(get_slot_index.run, hc, hrip, hsp, hdi, sa, sa, a4, sa, hr)
      obtain af, haf from run
      let m1 := gsi.final(s, af)
      have eo: o = ok(m1, empty) by taut(haf)
      have hp2 := rewrite(eo, hp)
      have m1u: m1 in univ(1) by taut(apply(abi.ok_univ, hp2))
      have m1M: m1 in x86_64_linux.Machine by simp(hM, haf, m1u, x86.store_typed)
      // the spec's run on the view: its result is the machine's
      have fo := apply(gsi.fun_ok, {w}, {args}, {app(app(s, "gpr"), 2)}, wu, hA, simp(hM), simp(hd), simp(hd), simp(hd))
      have e0: bits_and(32, bits_of_int(8, gimple.bytes_at(app(w, "vm"), int_sub(gsi.p(args), 3), 1)), 31) = app(app(m1, "gpr"), 0)
        by defs(simp(pa, hdi, hd), gimple.bytes_at, x86_64_linux.le)
      have e2: app(app(s, "gpr"), 2) = app(app(m1, "gpr"), 2) by simp()
      have rc := apply(abi.ret_case, {4202755}, {gsi.spec}, {args}, {s}, {m1}, {gsi.vm1(s)}, {w},
        hM, he, m1M, hp2, v1, v1u, sv, sv, rewrite(e2, rewrite(e0, fo)), simp(hM, v1, wu), wu,
        defs(simp(keep(abi.scratch, abi.scratch_page, abi.stack_page)), abi.world_matches),
        simp(), simp(), simp(), simp(), simp(), simp(), simp(), simp(expand(he, abi.entry_ok)))
      show := rewrite(sym(eo), rc)
    qed
    show by taut(ub, ret)
  qed
  show := apply(abi.implements_intro, runs)
qed
