theorem ssz.implements: all statics. tr.implements_at(4207548, c_src_malloc_mallocng_malloc.set_size_fun(), 4202755, text.code, statics)
proof
  fix statics
  have hsub: all vm. abi.loaded(vm, 4202755, text.code, statics) -> abi.code_at(vm, 4207548, set_size.code) proof
    fix vm
    assume h: abi.loaded(vm, 4202755, text.code, statics)
    have l := mp(all_elim(set_size.in_text, {vm}, {statics}), h)
    show by taut(expand(l, abi.loaded))
  qed
  have hregs: all args s. args in abi.ARGS -> s in x86_64_linux.Machine -> abi.entry_ok(s, args) -> ord_le(3, seq_len(args)) -> tr.regs(s, fn_update(fn_update(fn_update(empty, 7, pair(8, bits_of_int(64, app(args, 0)))), 6, pair(8, bits_of_int(64, app(args, 1)))), 2, pair(8, bits_of_int(64, app(args, 2))))) proof
    fix args
    fix s
    assume hA hM he hg
    have ln: seq_len(args) in omega by simp(hA)
    have r0 := all_elim(tr.regs_empty, {s})
    have a0 := apply(tr.arg_reg, {s}, {args}, {0}, {7}, hM, he, simp(), (int_lt(0, seq_len(args)) by arith(ln, expand(hg, ord_le))), simp(tr.argregs), simp())
    have r1 := apply(tr.regs_add, {s}, {empty}, {7}, {8}, {bits_of_int(64, app(args, 0))}, r0, simp(a0), simp(a0))
    have a1 := apply(tr.arg_reg, {s}, {args}, {1}, {6}, hM, he, simp(), (int_lt(1, seq_len(args)) by arith(ln, expand(hg, ord_le))), simp(tr.argregs), simp())
    have r2 := apply(tr.regs_add, {s}, {fn_update(empty, 7, pair(8, bits_of_int(64, app(args, 0))))}, {6}, {8}, {bits_of_int(64, app(args, 1))}, r1, simp(a1), simp(a1))
    have a2 := apply(tr.arg_reg, {s}, {args}, {2}, {2}, hM, he, simp(), (int_lt(2, seq_len(args)) by arith(ln, expand(hg, ord_le))), simp(tr.argregs), simp())
    have r3 := apply(tr.regs_add, {s}, {fn_update(fn_update(empty, 7, pair(8, bits_of_int(64, app(args, 0)))), 6, pair(8, bits_of_int(64, app(args, 1))))}, {2}, {8}, {bits_of_int(64, app(args, 2))}, r2, simp(a2), simp(a2))
    show := r3
