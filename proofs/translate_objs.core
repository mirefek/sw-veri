// Stack objects of the function's own frame (an address-taken local:
// readable GIMPLE's `alloc_objs`, slc/cli/src/c1): the claims' objects
// grown by them from where the spec allocates them -- after the machine's
// first store to the object's bytes, then a home's, accessible -- to the
// return, where the callers' objects alone are matched (the frame's below
// sp: tr.wm_sub). Checked after proofs/translate_struct.core.

// ---------------------------------------------------------------------
//  The claims with more objects, below sp: the claims with fewer

theorem tr.wm_sub: all old new w v v2 fs sp. abi.world_matches(old, new, w, abi.objs_at(v2, fs), sp) -> (all x. x in v -> x in v2) ->
  (all x. x in omega -> x in v2 -> !(x in v) -> int_lt(x, sp)) -> abi.world_matches(old, new, w, abi.objs_at(v, fs), sp)
proof
  fix old new w v v2 fs sp
  assume h hs hb
  have {top, limit, brk0, brk, bytes, frames, hid, pages, nostk, stk, rsv} := h
  have l1 := all_elim(abi.objs_at_live, {v}, {fs})
  have l2 := all_elim(abi.objs_at_live, {v2}, {fs})
  have by2: all a. a in bits(64) -> abi.in_domain(w, abi.objs_at(v, fs), a) -> new.bytes[a] = w.bytes[a] proof
    fix a
    assume ha hd
    have c1: a in v -> a in v2 := all_elim(hs, {a})
    have d0 := rewrite(l1.2, rewrite(l1.1, expand(hd, abi.in_domain)))
    have d1: a in v2 || ((x86_64_linux.mapped(w, int_div(a, x86_64_linux.PAGE)) && !(snd(w.pages[int_div(a, x86_64_linux.PAGE)]).kind = 2)) && !(a in abi.canary(fs))) by taut(d0, c1)
    have d2: abi.in_domain(w, abi.objs_at(v2, fs), a) by defs(rewrite(sym(l2.2), rewrite(sym(l2.1), d1)), abi.in_domain)
    show := mp(all_elim(bytes, {a}), ha, d2)
  qed
  have fr2: all a. a in bits(64) -> (int_le(sp, a) && !abi.in_domain(w, abi.objs_at(v, fs), a)) && abi.stack_page(old, x86_64_linux.page_of(a)) -> new.bytes[a] = old.bytes[a] proof
    fix a
    assume ha hf
    have hl hn hsp := hf
    have ao: a in omega by simp(ha)
    have c2: a in v2 -> !(a in v) -> false proof
      assume h2 h3
      have lt := mp(all_elim(hb, {a}), ao, h2, h3)
      show by arith(lt, hl)
    qed
    have n0 := rewrite(l1.2, rewrite(l1.1, expand(hn, abi.in_domain)))
    have n1: !(a in v2 || ((x86_64_linux.mapped(w, int_div(a, x86_64_linux.PAGE)) && !(snd(w.pages[int_div(a, x86_64_linux.PAGE)]).kind = 2)) && !(a in abi.canary(fs)))) by taut(n0, c2)
    have nd2: !abi.in_domain(w, abi.objs_at(v2, fs), a) by defs(rewrite(sym(l2.2), rewrite(sym(l2.1), n1)), abi.in_domain)
    show := mp(all_elim(frames, {a}), ha, conj(conj(hl, nd2), hsp))
  qed
  have hd2: all a. a in bits(64) -> a in abi.objs_at(v, fs).hidden -> new.bytes[a] = old.bytes[a] && new.pages[x86_64_linux.page_of(a)] = old.pages[x86_64_linux.page_of(a)] proof
    fix a
    assume ha hh
    have hh2: a in abi.objs_at(v2, fs).hidden := rewrite(sym(l2.2), rewrite(l1.2, hh))
    show := mp(all_elim(hid, {a}), ha, hh2)
  qed
  show by defs(taut(top, limit, brk0, brk, by2, fr2, hd2, pages, nostk, stk, rsv), abi.world_matches)
qed

// (the objects v2: v's and some below sp(s))
abbrev tr.osub(s, v, v2) := (all x. x in v -> x in v2) && (all x. x in omega -> x in v2 -> !(x in v) -> int_lt(x, abi.sp(s)))

theorem tr.retok_sub: all s v v2 p w m1. tr.osub(s, v, v2) -> tr.retok(s, v2, p, w, m1) -> tr.retok(s, v, p, w, m1)
proof
  fix s v v2 p w m1
  assume ho h
  have hs hb := ho
  have a1 a2 a3 a4 a5 a6 a7 a8 a9 := expand(h, tr.retok)
  obtain w2, r1 r2 r3 r4 r5 r6 from a3
  have r4b := apply(tr.wm_sub, r4, hs, hb)
  have e: ex w2. runs(p, w, ok(w2, pair(m1.gpr[0], m1.gpr[2]))) && w2 in abi.World && w2 in univ(1) &&
      abi.world_matches(s.vm, m1.vm, w2.vm, abi.objs_at(v, s.fs_base), abi.sp(s)) && m1.os = w2.os && m1.fs_base = s.fs_base by ex_intro({w2}, taut(r1, r2, r3, r4b, r5, r6))
  show by defs(taut(a1, a2, e, a4, a5, a6, a7, a8, a9), tr.retok)
qed

theorem tr.arr_sub(zb. bkp, zb pb wb. bka): all s v v2 m p w. tr.osub(s, v, v2) -> tr.arr(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v2, m, p, w) ->
  tr.arr(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, m, p, w)
proof
  fix s v v2 m p w
  assume ho h
  have c1 c2 := expand(h, tr.arr)
  have d1: tr.out(s, m) -> tr.retok(s, v, p, w, m) proof
    assume hout
    show := apply(tr.retok_sub, ho, mp(c1, hout))
  qed
  show by defs(taut(d1, c2), tr.arr)
qed

theorem tr.gk_sub(zb. bkp, zb pb wb. bka): all s v v2 p w o. tr.osub(s, v, v2) -> tr.gk(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v2, p, w, o) ->
  tr.gk(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, o)
proof
  fix s v v2 p w o
  assume ho h
  have e := expand(h, tr.gk)
  have u: tr.ub(s, v2, p, w) -> tr.ub(s, v, p, w) proof
    assume hu
    show by defs(expand(hu, tr.ub), tr.ub)
  qed
  have a: (ex m1. o = ok(m1, empty) && tr.arr(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v2, m1, p, w)) ->
      (ex m1. o = ok(m1, empty) && tr.arr(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, m1, p, w)) proof
    assume ha
    obtain m1, h1 h2 from ha
    show by ex_intro({m1}, taut(h1, apply(tr.arr_sub[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], ho, h2)))
  qed
  show by defs(taut(e, u, a), tr.gk)
qed

theorem tr.sim_sub(zb. bkp, zb pb wb. bka): all s v v2 p w m. tr.osub(s, v, v2) -> tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v2, p, w, m) ->
  tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m)
proof
  fix s v v2 p w m
  assume ho h
  have g: all o. tr.run_k(s, zb. bkp(zb), m, o) -> tr.gk(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, o) proof
    fix o
    assume hr
    show := apply(tr.gk_sub[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], ho, mp(all_elim(expand(h, tr.sim), {o}), hr))
  qed
  show by defs(g, tr.sim)
qed

theorem tr.cl_sub(zb. bkp, zb pb wb. bka): all s v v2 p w m. tr.osub(s, v, v2) -> tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v2, p, w, m) ->
  tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m)
proof
  fix s v v2 p w m
  assume ho h
  have c1 c2 := expand(h, tr.cl)
  have d1: tr.stopk(s, zb. bkp(zb), m) -> tr.arr(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, m, p, w) proof
    assume st
    show := apply(tr.arr_sub[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], ho, mp(c1, st))
  qed
  have d2: !tr.stopk(s, zb. bkp(zb), m) -> tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m) proof
    assume st
    show := apply(tr.sim_sub[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], ho, mp(c2, st))
  qed
  show by defs(taut(d1, d2), tr.cl)
qed

// ---------------------------------------------------------------------
//  One object of 8 bytes at A (readable GIMPLE's alloc_objs([(8, 8)]))

// (the objects with it: as alloc_objs makes them)
abbrev tr.obj1(v, A) := set_select(omega, x6. x6 in v || (ex x7. x7 in omega && ((int_lt(x7, seq_len(seq_one(pair(8, 8)))) &&
  int_le(app(seq_one(A), x7), x6)) && int_lt(x6, int_add(app(seq_one(A), x7), fst(app(seq_one(pair(8, 8)), x7)))))))

theorem tr.obj1_in: all v A x. x in tr.obj1(v, A) <-> x in omega && (x in v || (int_le(A, x) && int_lt(x, int_add(A, 8))))
proof
  fix v A x
  let IN(y, k) := y in omega && ((int_lt(y, seq_len(seq_one(pair(8, 8)))) && int_le(app(seq_one(A), y), k)) && int_lt(k, int_add(app(seq_one(A), y), fst(app(seq_one(pair(8, 8)), y)))))
  have e := set_select_def[s := omega, p := x6. x6 in v || (ex x7. IN(x7, x6)), z := x]
  have l1: seq_len(seq_one(pair(8, 8))) = 1 by simp()
  have a0: app(seq_one(A), 0) = A by simp()
  have f0: fst(app(seq_one(pair(8, 8)), 0)) = 8 by simp()
  have d1: (ex x7. IN(x7, x)) -> int_le(A, x) && int_lt(x, int_add(A, 8)) proof
    assume h
    obtain y, hy from h
    have y0 hr := hy
    have h11 h12 h2 := hr
    have ez: y = 0 by arith(y0, h11, l1)
    have h12z := rewrite(ez, h12)
    have h2z := rewrite(ez, h2)
    show by taut(rewrite(a0, h12z), rewrite(f0, rewrite(a0, h2z)))
  qed
  have d2: int_le(A, x) && int_lt(x, int_add(A, 8)) -> (ex x7. IN(x7, x)) proof
    assume h
    have h1 h2 := h
    have z0: 0 in omega by arith()
    have zl: int_lt(0, seq_len(seq_one(pair(8, 8)))) by arith(l1)
    show by ex_intro({0}, taut(z0, zl, rewrite(sym(a0), h1), rewrite(sym(f0), rewrite(sym(a0), h2))))
  qed
  show by taut(e, d1, d2)
qed

// (a byte within a store: the stored value's, whatever was there)
theorem tr.store_le_in: all b1 b2 a n x z. z in bits(64) -> int_lt(bits_sub(64, z, a), n) ->
  x86_64_linux.store_le(b1, a, n, x)[z] = x86_64_linux.store_le(b2, a, n, x)[z]
proof
  fix b1 b2 a n x z
  assume hz hl
  have e1 := mp(app_fn_build[d := bits(64), v := y. ite(int_lt(bits_sub(64, y, a), n), bits_of_int(8, int_div(x, int_pow(256, bits_sub(64, y, a)))), b1[y]), a := z], hz)
  have e2 := mp(app_fn_build[d := bits(64), v := y. ite(int_lt(bits_sub(64, y, a), n), bits_of_int(8, int_div(x, int_pow(256, bits_sub(64, y, a)))), b2[y]), a := z], hz)
  have i1 := mp(ite_t[c := int_lt(bits_sub(64, z, a), n), a := bits_of_int(8, int_div(x, int_pow(256, bits_sub(64, z, a)))), b := b1[z]], hl)
  have i2 := mp(ite_t[c := int_lt(bits_sub(64, z, a), n), a := bits_of_int(8, int_div(x, int_pow(256, bits_sub(64, z, a)))), b := b2[z]], hl)
  show by defs(trans(trans(e1, i1), sym(trans(e2, i2))), x86_64_linux.store_le)
qed

// (the invariant for another world of the same I/O, thread pointer, CPU
// and break's start)
theorem tr.inv_world: all s base code fr m w w2. tr.inv(s, base, code, fr, m, w) -> w2 in abi.World -> w2 in univ(1) -> w2.os = w.os ->
  w2.fs_base = w.fs_base -> w2.cpu = w.cpu -> w2.vm.brk_start = w.vm.brk_start -> tr.inv(s, base, code, fr, m, w2)
proof
  fix s base code fr m w w2
  assume hi hW hu eos efs ecpu ebk
  have {mM, mu, cd, kc, rspm, fro, kp, ra8, mcpu, mgs, mos, mfs, mfs0, mdf, winp, sws, wW, wu, wcpu, wbk, sM, sacc, sal, hsps, slt, sgf, srsv, scan} := hi
  have mos2: m.os = w2.os := trans(mos, sym(eos))
  have mfs2: m.fs_base = w2.fs_base := trans(mfs, sym(efs))
  have winp2 := rewrite(sym(eos), winp)
  have sws2 := rewrite(sym(eos), sws)
  have wcpu2: w2.cpu = s.cpu := trans(ecpu, wcpu)
  have wbk2: abi.brk_start_ok(w2.vm) by defs(rewrite(sym(ebk), expand(wbk, abi.brk_start_ok)), abi.brk_start_ok)
  show by defs(taut(mM, mu, cd, kc, rspm, fro, kp, ra8, mcpu, mgs, mos2, mfs2, mfs0, mdf, winp2, sws2, hW, hu, wcpu2, wbk2, sM, sacc, sal, hsps, slt, sgf, srsv, scan), tr.inv)
qed

// (the objects with the one at the home c: the callers' and one below sp)
theorem tr.osub_obj1: all s base code fr m w v c. tr.inv(s, base, code, fr, m, w) -> v in set_type(omega) -> tr.hrange(c, 8) -> tr.osub(s, v, tr.obj1(v, tr.ha(s, c)))
proof
  fix s base code fr m w v c
  assume hi hvo hc
  have {sM, slt} := hi
  have r4 := apply(x86i.rsp_typed, sM)
  have g8 := apply(tr.inv_gap, hi)
  let H := tr.ha(s, c)
  have e0 _ _ _ := apply(tr.ha_byte, {s.gpr[4]}, {c}, {8}, {0}, r4, g8, hc, arith(), arith())
  have hb: H in bits(64) by simp()
  have h0: bits_add(64, H, bits_of_int(64, 0)) = H by simp(hb)
  have eh: H = int_add(int_sub(s.gpr[4], int_sub(18446744073709551616, c)), 0) := trans(sym(h0), e0)
  have c64 cl no nl := expand(hc, tr.hrange)
  have sp8: abi.sp(s) = int_add(s.gpr[4], 8) by simp(r4, slt)
  have s1: all x. x in v -> x in tr.obj1(v, H) proof
    fix x
    assume hv
    have oi := all_elim(tr.obj1_in, {v}, {H}, {x})
    have sub: subset(v, omega) by taut(powerset_def[s := omega, a := v], expand(hvo, set_type))
    have xo := mp(subset_elim[a := v, b := omega, z := x], sub, hv)
    show by taut(oi, hv, xo)
  qed
  have s2: all x. x in omega -> x in tr.obj1(v, H) -> !(x in v) -> int_lt(x, abi.sp(s)) proof
    fix x
    assume h1 h2 h3
    have oi := all_elim(tr.obj1_in, {v}, {H}, {x})
    have r: int_le(H, x) && int_lt(x, int_add(H, 8)) by taut(oi, h2, h3)
    show by arith(r.2, eh, nl, c64, sp8, r4)
  qed
  show by taut(s1, s2)
qed

// the coupling after the machine's store of the 8 bytes x to the home c
// (accessible after it, none of the objects) as the object the spec
// allocates there, the world's bytes the same
theorem tr.mem_alloc: all s base code fr m0 m m2 w w2 v c x. tr.inv(s, base, code, fr, m0, w) -> tr.mem(s, m, w, v) -> tr.hrange(c, 8) ->
  tr.hacc(s, m2.vm, c, 8) -> tr.hfree(s, c, 8, v) ->
  m2.vm = fn_update(m.vm, "bytes", x86_64_linux.store_le(m.vm.bytes, tr.ha(s, c), 8, x)) ->
  w2.vm = fn_update(w.vm, "bytes", x86_64_linux.store_le(w.vm.bytes, tr.ha(s, c), 8, x)) -> w2.objs = fn_update(w.objs, "live", tr.obj1(w.objs.live, tr.ha(s, c))) ->
  tr.mem(s, m2, w2, tr.obj1(v, tr.ha(s, c)))
proof
  fix s base code fr m0 m m2 w w2 v c x
  assume hi h hc ha hf em ew eo
  have {sM, slt} := hi
  have r4 := apply(x86i.rsp_typed, sM)
  have g8 := apply(tr.inv_gap, hi)
  have {wob, wm, oacc, hlv, cok} := h
  have hcan fsb := cok
  have {top, limit, brk0, brk, bytes, frames, hid, pages, nostk, stk, rsv} := wm
  let S := s.gpr[4]
  let H := tr.ha(s, c)
  let V2 := tr.obj1(v, H)
  let O := abi.objs_at(v, s.fs_base)
  let O2 := abi.objs_at(V2, s.fs_base)
  have lv := all_elim(abi.objs_at_live, {v}, {s.fs_base})
  have lv2 := all_elim(abi.objs_at_live, {V2}, {s.fs_base})
  have c64 cl no nl := expand(hc, tr.hrange)
  // (the object's bytes H .. H + 7: below S, H itself the home's address)
  have b0 := apply(tr.ha_byte, {S}, {c}, {8}, {0}, r4, g8, hc, arith(), arith())
  have e0 _ _ _ := b0
  have hb: H in bits(64) by simp()
  have h0: bits_add(64, H, bits_of_int(64, 0)) = H by simp(hb)
  have eh: H = int_add(int_sub(S, int_sub(18446744073709551616, c)), 0) := trans(sym(h0), e0)
  have hS: int_le(int_add(H, 8), S) by arith(eh, nl, c64, r4)
  have ho: H in omega by simp(hb)
  // (a byte of the object: in range of the store)
  have inr: all z. z in bits(64) -> int_le(H, z) -> int_lt(z, int_add(H, 8)) -> int_lt(bits_sub(64, z, H), 8) proof
    fix z
    assume hz z1 z2
    show by defs(arith(hz, hb, z1, z2), bits_sub, pow2)
  qed
  // (not one: off the store)
  have outr: all z. z in bits(64) -> !(int_le(H, z) && int_lt(z, int_add(H, 8))) ->
      (all j. j in omega -> int_lt(j, 8) -> !(z = bits_add(64, H, bits_of_int(64, j)))) proof
    fix z
    assume hz hn
    fix j
    assume j1 j2
    have ej _ _ _ := apply(tr.ha_byte, {S}, {c}, {8}, {j}, r4, g8, hc, j1, j2)
    have ejh: bits_add(64, H, bits_of_int(64, j)) = int_add(H, j) by arith(ej, eh)
    assume ez
    show by taut(hn, (int_le(H, z) && int_lt(z, int_add(H, 8)) by arith(ez, ejh, j1, j2)))
  qed
  // (the object's bytes: on the machine's stack pages, addresses)
  have pm0: m2.vm.pages = m.vm.pages by simp(em)
  have rsp: all y. y in omega -> int_le(H, y) -> int_lt(y, int_add(H, 8)) -> abi.stack_page(m.vm, int_div(y, x86_64_linux.PAGE)) && y in bits(64) proof
    fix y
    assume h1 r1 r2
    have j: int_sub(y, H) in omega by arith(r1, ho, h1)
    have jl: int_lt(int_sub(y, H), 8) by arith(r2, r1)
    have _ a2 := mp(all_elim(expand(ha, tr.hacc), {int_sub(y, H)}), j, jl)
    have ej _ _ _ := apply(tr.ha_byte, {S}, {c}, {8}, {int_sub(y, H)}, r4, g8, hc, j, jl)
    have ey: bits_add(64, H, bits_of_int(64, int_sub(y, H))) = y by arith(ej, eh)
    have sp2: abi.stack_page(m2.vm, int_div(y, 4096)) := rewrite(ey, a2)
    have sp: abi.stack_page(m.vm, int_div(y, x86_64_linux.PAGE)) by defs(simp(pm0, expand(sp2, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped, x86_64_linux.PAGE)
    have yb: y in bits(64) by simp(h1, (int_lt(y, 18446744073709551616) by arith(hS, r4, r2)))
    show := conj(sp, yb)
  qed
  // (the ABI's word: off the stack, so none of the object's bytes)
  have ncan: all y. y in omega -> int_le(H, y) -> int_lt(y, int_add(H, 8)) -> !(y in abi.canary(s.fs_base)) proof
    fix y
    assume h1 r1 r2
    have sp yb := mp(all_elim(rsp, {y}), h1, r1, r2)
    have no: y in abi.canary(s.fs_base) -> false proof
      assume hca
      have _ ns _ _ := apply(tr.hid_at, {s}, {m}, {w}, {v}, {y}, h, hcan, fsb, yb, hca)
      show by taut(ns, sp)
    qed
    show by taut(no)
  qed
  // the world's domain: v's and the object
  have dq: all z. abi.in_domain(w2.vm, O2, z) -> abi.in_domain(w.vm, O, z) || (int_le(H, z) && int_lt(z, int_add(H, 8))) proof
    fix z
    assume hd
    have oi := all_elim(tr.obj1_in, {v}, {H}, {z})
    have pw: w2.vm.pages = w.vm.pages by simp(ew)
    have e2 := rewrite(lv2.2, rewrite(lv2.1, expand(hd, abi.in_domain)))
    have k1: z in V2 -> abi.in_domain(w.vm, O, z) || (int_le(H, z) && int_lt(z, int_add(H, 8))) proof
      assume hz
      have c1: z in v -> abi.in_domain(w.vm, O, z) proof
        assume hv
        have hv2: z in O.live := rewrite(sym(lv.1), hv)
        show by defs(taut(hv2), abi.in_domain)
      qed
      show by taut(oi, hz, c1)
    qed
    have k2: (x86_64_linux.mapped(w2.vm, int_div(z, x86_64_linux.PAGE)) && !(snd(w2.vm.pages[int_div(z, x86_64_linux.PAGE)]).kind = 2)) && !(z in abi.canary(s.fs_base)) -> abi.in_domain(w.vm, O, z) proof
      assume hm0
      have hma hmk hmc := hm0
      have hm2 := rewrite(pw, expand(conj(hma, hmk), x86_64_linux.mapped))
      have hc2: !(z in O.hidden) := rewrite(sym(lv.2), hmc)
      show by defs(taut(hm2, hc2), abi.in_domain, x86_64_linux.mapped)
    qed
    show by taut(e2, k1, k2)
  qed
  have by2: all z. z in bits(64) -> abi.in_domain(w2.vm, O2, z) -> m2.vm.bytes[z] = w2.vm.bytes[z] proof
    fix z
    assume hz hd
    have d := mp(all_elim(dq, {z}), hd)
    have c1: abi.in_domain(w.vm, O, z) -> m2.vm.bytes[z] = w2.vm.bytes[z] proof
      assume hd0
      have e := mp(all_elim(bytes, {z}), hz, hd0)
      have sa := apply(tr.store_le_agree, {m.vm.bytes}, {w.vm.bytes}, {H}, {8}, {x}, {z}, hz, e)
      show by simp(em, ew, sa)
    qed
    have c2: int_le(H, z) && int_lt(z, int_add(H, 8)) -> m2.vm.bytes[z] = w2.vm.bytes[z] proof
      assume hr
      have l := mp(all_elim(inr, {z}), hz, hr.1, hr.2)
      have si := apply(tr.store_le_in, {m.vm.bytes}, {w.vm.bytes}, {H}, {8}, {x}, {z}, hz, l)
      show by simp(em, ew, si)
    qed
    show by taut(d, c1, c2)
  qed
  have fr2: all z. z in bits(64) -> (int_le(abi.sp(s), z) && !abi.in_domain(w2.vm, O2, z)) && abi.stack_page(s.vm, x86_64_linux.page_of(z)) ->
      m2.vm.bytes[z] = s.vm.bytes[z] proof
    fix z
    assume hz hf2
    have hl nd2 hsp := hf2
    have sp8: abi.sp(s) = int_add(S, 8) by simp(r4, slt)
    have nf: !(int_le(H, z) && int_lt(z, int_add(H, 8))) by arith(hl, sp8, hS)
    have nd: !abi.in_domain(w.vm, O, z) proof
      assume hd0
      have oi := all_elim(tr.obj1_in, {v}, {H}, {z})
      have pw: w2.vm.pages = w.vm.pages by simp(ew)
      have e0 := rewrite(lv.2, rewrite(lv.1, expand(hd0, abi.in_domain)))
      have zo: z in omega by simp(hz)
      have c1: z in v -> abi.in_domain(w2.vm, O2, z) proof
        assume hv
        have hv2: z in O2.live := rewrite(sym(lv2.1), (z in V2 by taut(oi, zo, hv)))
        show by defs(taut(hv2), abi.in_domain)
      qed
      have c2: (x86_64_linux.mapped(w.vm, int_div(z, x86_64_linux.PAGE)) && !(snd(w.vm.pages[int_div(z, x86_64_linux.PAGE)]).kind = 2)) && !(z in abi.canary(s.fs_base)) -> abi.in_domain(w2.vm, O2, z) proof
        assume hm0
        have hma hmk hmc := hm0
        have hm2 := rewrite(sym(pw), expand(conj(hma, hmk), x86_64_linux.mapped))
        have hc2: !(z in O2.hidden) := rewrite(sym(lv2.2), hmc)
        show by defs(taut(hm2, hc2), abi.in_domain, x86_64_linux.mapped)
      qed
      show by taut(e0, c1, c2, nd2)
    qed
    have e := mp(all_elim(frames, {z}), hz, conj(conj(hl, nd), hsp))
    have so := apply(tr.storen_other, {m.vm.bytes}, {H}, {8}, {x}, {z}, hz, mp(all_elim(outr, {z}), hz, nf))
    show by simp(em, so, e)
  qed
  have pm: m2.vm.pages = m.vm.pages by simp(em)
  have pw: w2.vm.pages = w.vm.pages by simp(ew)
  have pg2: all x0. x0 in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) ->
      m2.vm.pages[x0] = w2.vm.pages[x0] || (w2.vm.pages[x0] = none && abi.stack_page(m2.vm, x0)) proof
    fix x0
    assume hx
    have c := mp(all_elim(pages, {x0}), hx)
    have sq := mp(all_elim(tr.sp_pages, {m.vm}, {m2.vm}, {x0}), pm)
    show := rewrite(sym(pw), rewrite(sym(sq), rewrite(sym(pm), c)))
  qed
  have rsv2: abi.stack_reserve(s.vm) -> abi.stack_reserve(m2.vm) proof
    assume h0
    show := apply(tr.rsv_same, pm, (m2.vm.stack_top = m.vm.stack_top by simp(em)), (m2.vm.stack_limit = m.vm.stack_limit by simp(em)), mp(rsv, h0))
  qed
  // the ABI's word: none of the object's bytes, so kept
  have hid2: all z. z in bits(64) -> z in O2.hidden -> m2.vm.bytes[z] = s.vm.bytes[z] && m2.vm.pages[x86_64_linux.page_of(z)] = s.vm.pages[x86_64_linux.page_of(z)] proof
    fix z
    assume hz hh
    have hca: z in abi.canary(s.fs_base) := rewrite(lv2.2, hh)
    have zo: z in omega by simp(hz)
    have nf: !(int_le(H, z) && int_lt(z, int_add(H, 8))) proof
      assume hr
      have r1 r2 := hr
      show by taut(mp(all_elim(ncan, {z}), zo, r1, r2), hca)
    qed
    have so := apply(tr.storen_other, {m.vm.bytes}, {H}, {8}, {x}, {z}, hz, mp(all_elim(outr, {z}), hz, nf))
    have hh1: z in O.hidden := rewrite(sym(lv.2), hca)
    have e := mp(all_elim(hid, {z}), hz, hh1)
    show by simp(em, so, e, pm0)
  qed
  have wm2: abi.world_matches(s.vm, m2.vm, w2.vm, O2, abi.sp(s)) by defs(simp(em, ew, top, limit, brk0, brk, rewrite(em, rewrite(ew, by2)),
    rewrite(em, rewrite(ew, fr2)), rewrite(em, hid2), rewrite(em, rewrite(ew, pg2)), nostk, stk, rewrite(em, rsv2), keep(abi.in_domain, abi.stack_page, abi.stack_reserve, abi.objs_at)), abi.world_matches)
  // the objects: v's as before, the object's own -- below S, on stack pages, accessible
  have oa1 := apply(tr.oacc_pages, pm, oacc)
  have oa2: all y. y in omega -> y in V2 -> ((int_le(abi.sp(s), y) && abi.stack_page(s.vm, int_div(y, x86_64_linux.PAGE))) || tr.own(s, m2, y)) &&
      x86_64_linux.can_access(m2.vm, bits_of_int(64, y), 1) proof
    fix y
    assume h1 h2
    have oi := all_elim(tr.obj1_in, {v}, {H}, {y})
    have c1: y in v -> ((int_le(abi.sp(s), y) && abi.stack_page(s.vm, int_div(y, x86_64_linux.PAGE))) || tr.own(s, m2, y)) &&
        x86_64_linux.can_access(m2.vm, bits_of_int(64, y), 1) := mp(all_elim(oa1, {y}), h1)
    have c2: int_le(H, y) && int_lt(y, int_add(H, 8)) -> tr.own(s, m2, y) && x86_64_linux.can_access(m2.vm, bits_of_int(64, y), 1) proof
      assume hr
      have j: int_sub(y, H) in omega by arith(hr.1, ho, h1)
      have jl: int_lt(int_sub(y, H), 8) by arith(hr.2, hr.1)
      have a1 a2 := mp(all_elim(expand(ha, tr.hacc), {int_sub(y, H)}), j, jl)
      have ej _ _ _ := apply(tr.ha_byte, {S}, {c}, {8}, {int_sub(y, H)}, r4, g8, hc, j, jl)
      have ey: bits_add(64, H, bits_of_int(64, int_sub(y, H))) = y by arith(ej, eh)
      have yb: bits_of_int(64, y) = y by simp(h1, (int_lt(y, 18446744073709551616) by arith(hS, r4, hr.2)))
      have ca: x86_64_linux.can_access(m2.vm, bits_of_int(64, y), 1) := rewrite(sym(yb), rewrite(ey, a1))
      have sp: abi.stack_page(m2.vm, int_div(y, x86_64_linux.PAGE)) by defs(rewrite(ey, a2), x86_64_linux.PAGE)
      have yl: int_lt(y, S) by arith(hS, hr.2)
      show by taut(yl, sp, ca)
    qed
    show by taut(oi, h2, c1, c2)
  qed
  have wo0 := rewrite(lv.1, rewrite(wob, eo))
  have wo2: w2.objs = O2 := rewrite(all_elim(abi.objs_at_upd, {v}, {V2}, {s.fs_base}), wo0)
  have hlv2: all y. y in V2 -> !(y in abi.canary(s.fs_base)) proof
    fix y
    assume hy
    have oi := all_elim(tr.obj1_in, {v}, {H}, {y})
    have yo: y in omega by taut(oi, hy)
    have c1: y in v -> !(y in abi.canary(s.fs_base)) := all_elim(hlv, {y})
    have c2: int_le(H, y) && int_lt(y, int_add(H, 8)) -> !(y in abi.canary(s.fs_base)) proof
      assume hr
      have r1 r2 := hr
      show := mp(all_elim(ncan, {y}), yo, r1, r2)
    qed
    show by taut(oi, hy, c1, c2)
  qed
  show by defs(taut(wo2, wm2, oa2, hlv2, cok), tr.mem)
qed

// (the n bytes from A outside the world's domain: as alloc_objs takes its
// objects' bytes)
// (the 8 bytes at the home c as an object takes them: aligned, in range)
abbrev tr.aslot(s, c) := int_mod(tr.ha(s, c), 8) = 0 && int_le(int_add(tr.ha(s, c), 8), 18446744073709551616)

abbrev tr.nodom(w, A, n) := all a. a in omega -> int_le(A, a) && int_lt(a, int_add(A, n)) -> !abi.in_domain(w.vm, w.objs, a) && !(a in w.objs.hidden)

// (the 8 bytes of the home c on the machine's stack pages, none of the
// objects: outside the world's domain -- its pages none there, or the
// machine's, the stack's)
theorem tr.nodom_frame: all s base code fr m0 m w v c. tr.inv(s, base, code, fr, m0, w) -> tr.mem(s, m, w, v) -> tr.hrange(c, 8) ->
  tr.hacc(s, m.vm, c, 8) -> tr.hfree(s, c, 8, v) -> tr.nodom(w, tr.ha(s, c), 8)
proof
  fix s base code fr m0 m w v c
  assume hi h hc ha hf
  have {sM} := hi
  have r4 := apply(x86i.rsp_typed, sM)
  have g8 := apply(tr.inv_gap, hi)
  have {wob, wm} := h
  have {pages} := wm
  let S := s.gpr[4]
  let H := tr.ha(s, c)
  have c64 cl no nl := expand(hc, tr.hrange)
  have e0 _ _ _ := apply(tr.ha_byte, {S}, {c}, {8}, {0}, r4, g8, hc, arith(), arith())
  have hb: H in bits(64) by simp()
  have h0: bits_add(64, H, bits_of_int(64, 0)) = H by simp(hb)
  have eh: H = int_add(int_sub(S, int_sub(18446744073709551616, c)), 0) := trans(sym(h0), e0)
  have ho: H in omega by simp(hb)
  fix a
  assume a0 ar
  let J := int_sub(a, H)
  have j: J in omega by arith(ar.1, ho, a0)
  have jl: int_lt(J, 8) by arith(ar.2, ar.1)
  have ej _ _ _ := apply(tr.ha_byte, {S}, {c}, {8}, {J}, r4, g8, hc, j, jl)
  have ea: bits_add(64, H, bits_of_int(64, J)) = a by arith(ej, eh)
  // (not an object: the home's byte J)
  have ej2: int_add(int_sub(S, int_sub(18446744073709551616, c)), J) = a by arith(eh)
  have lv := all_elim(abi.objs_at_live, {v}, {s.fs_base})
  have nv0 := rewrite(ej2, mp(all_elim(hf, {J}), j, jl))
  have nv1: !(a in abi.objs_at(v, s.fs_base).live) := rewrite(sym(lv.1), nv0)
  have nv: !(a in w.objs.live) := rewrite(sym(wob), nv1)
  // (its page the machine's stack page: the world's none, or the same)
  have a1 a2 := mp(all_elim(expand(ha, tr.hacc), {J}), j, jl)
  let P := int_div(a, 4096)
  have sp: abi.stack_page(m.vm, P) := rewrite(ea, a2)
  have po: P in omega by simp(a0)
  have hp: P in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) by simp(expand(sp, abi.stack_page, x86_64_linux.mapped), po)
  have pc := mp(all_elim(pages, {P}), hp)
  have spk: snd(m.vm.pages[P]).kind = 2 by taut(expand(sp, abi.stack_page))
  have c1: m.vm.pages[P] = w.vm.pages[P] -> !(x86_64_linux.mapped(w.vm, P) && !(snd(w.vm.pages[P]).kind = 2)) proof
    assume e
    show by taut(rewrite(e, spk))
  qed
  have c2: w.vm.pages[P] = none -> !x86_64_linux.mapped(w.vm, P) proof
    assume e
    show by defs(taut(e), x86_64_linux.mapped)
  qed
  have pq: int_div(a, x86_64_linux.PAGE) = P by defs(simp(), x86_64_linux.PAGE)
  have g: !(a in w.objs.live || ((x86_64_linux.mapped(w.vm, P) && !(snd(w.vm.pages[P]).kind = 2)) && !(a in w.objs.hidden))) by taut(nv, pc, c1, c2)
  have nd: !abi.in_domain(w.vm, w.objs, a) by defs(rewrite(sym(pq), g), abi.in_domain)
  // (not the ABI's word: that is off the stack)
  have {cok} := h
  have hcan fsb := cok
  have nh0: a in w.objs.hidden -> false proof
    assume hh
    have hh2: a in abi.canary(s.fs_base) := rewrite(lv.2, rewrite(wob, hh))
    have ab: a in bits(64) by simp(a0, (int_lt(a, 18446744073709551616) by arith(ej2, c64, nl, r4, jl, j)))
    have _ ns _ _ := apply(tr.hid_at, {s}, {m}, {w}, {v}, {a}, h, hcan, fsb, ab, hh2)
    show by taut(ns, (abi.stack_page(m.vm, int_div(a, x86_64_linux.PAGE)) by defs(sp, x86_64_linux.PAGE)))
  qed
  show by taut(nd, nh0)
qed

// The objects after the frame's object at c0 allocated: the callers' v0
// and the 8 bytes at c0 -- the homes apart from them by their ranges, the
// frame's own within any frame reaching c0
def tr.vone(s, v, v0, c0) := tr.vabove(s, v0) && tr.hrange(c0, 8) && int_le(1048576, s.gpr[4]) && v = tr.obj1(v0, tr.ha(s, c0))

theorem tr.hfree_one: all s v v0 c0 c n. tr.vone(s, v, v0, c0) -> tr.hrange(c, n) -> (int_le(int_add(c, n), c0) || int_le(int_add(c0, 8), c)) ->
  tr.hfree(s, c, n, v)
proof
  fix s v v0 c0 c n
  assume ho hc hd
  have ha h0 hg ev := expand(ho, tr.vone)
  have r4 slt _ _ := expand(ha, tr.vabove)
  have hf0 := apply(tr.hfree_above, ha, hc)
  have e0 _ _ _ := apply(tr.ha_byte, {s.gpr[4]}, {c0}, {8}, {0}, r4, hg, h0, arith(), arith())
  let H := tr.ha(s, c0)
  have hb: H in bits(64) by simp()
  have hz: bits_add(64, H, bits_of_int(64, 0)) = H by simp(hb)
  have eh: H = int_add(int_sub(s.gpr[4], int_sub(18446744073709551616, c0)), 0) := trans(sym(hz), e0)
  fix j
  assume j1 j2
  let X := int_add(int_sub(s.gpr[4], int_sub(18446744073709551616, c)), j)
  have g: !(X in v) proof
    assume hx
    have oi := all_elim(tr.obj1_in, {v0}, {H}, {X})
    have hx2: X in tr.obj1(v0, H) := rewrite(ev, hx)
    have n0 := mp(all_elim(hf0, {j}), j1, j2)
    have r: int_le(H, X) && int_lt(X, int_add(H, 8)) by taut(oi, hx2, n0)
    have f1: int_le(int_add(c, n), c0) -> false proof
      assume l
      show by arith(r.1, eh, l, j2)
    qed
    have f2: int_le(int_add(c0, 8), c) -> false proof
      assume l
      show by arith(r.2, eh, l, j1)
    qed
    show by taut(hd, f1, f2)
  qed
  show := g
qed

theorem tr.ofr_one: all s fr v v0 c0. tr.vone(s, v, v0, c0) -> int_le(int_sub(18446744073709551616, c0), fr) -> tr.ofr(s, fr, v)
proof
  fix s fr v v0 c0
  assume ho hl
  have ha h0 hg ev := expand(ho, tr.vone)
  have r4 slt _ ab := expand(ha, tr.vabove)
  have e0 _ _ _ := apply(tr.ha_byte, {s.gpr[4]}, {c0}, {8}, {0}, r4, hg, h0, arith(), arith())
  let H := tr.ha(s, c0)
  have hb: H in bits(64) by simp()
  have hz: bits_add(64, H, bits_of_int(64, 0)) = H by simp(hb)
  have eh: H = int_add(int_sub(s.gpr[4], int_sub(18446744073709551616, c0)), 0) := trans(sym(hz), e0)
  fix x
  assume h1 h2 h3
  have oi := all_elim(tr.obj1_in, {v0}, {H}, {x})
  have h2b: x in tr.obj1(v0, H) := rewrite(ev, h2)
  have c1: x in v0 -> int_le(int_sub(s.gpr[4], fr), x) proof
    assume hv
    have a := mp(all_elim(ab, {x}), h1, hv)
    have sp8: abi.sp(s) = int_add(s.gpr[4], 8) by simp(r4, slt)
    have f: false by arith(a, sp8, h3)
    show by taut(f)
  qed
  have c2: int_le(H, x) -> int_le(int_sub(s.gpr[4], fr), x) proof
    assume hh
    show by arith(hh, eh, hl)
  qed
  show by taut(oi, h2b, c1, c2)
qed

// The machine's store of the 8 bytes x to the home c (its touch -- the
// stack grown there, or a fault -- then the bytes written) where the spec
// allocates an object (p to p2, w to w2: w with x there and the object
// among its objects): the claim after it, with the object, gives the claim
// before (as tr.fstore_step's, the home not one)
theorem tr.astore_step(zb. bkp, zb pb wb. bka): all s v base code fr a a2 c x hs hs2 fd rs p p2 w w2.
  (all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
     (ex m1 e1. runs(x86_64_linux.touch_range(tr.ha(s, c), 8, 1), fn_update(m, "rip", a2), ok(m1, e1)) &&
        o = ok(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, tr.ha(s, c), 8, x))), empty)) ||
     (ex y e. runs(x86_64_linux.touch_range(tr.ha(s, c), 8, 1), fn_update(m, "rip", a2), exc(y, e)) && o = exc(y, e))) ->
  base in omega -> a2 in bits(64) -> tr.hrange(c, 8) -> fd in omega -> int_le(int_sub(18446744073709551616, fd), c) -> int_le(fd, tr.FMAX) ->
  x in bits(64) -> tr.hkeep(hs, hs2, c, 8) -> tr.vabove(s, v) ->
  w2 = fn_update(fn_update(w, "vm", fn_update(w.vm, "bytes", x86_64_linux.store_le(w.vm.bytes, tr.ha(s, c), 8, x))), "objs", fn_update(w.objs, "live", tr.obj1(w.objs.live, tr.ha(s, c)))) ->
  int_mod(c, 8) = 0 -> w2 in abi.World -> w2 in univ(1) -> (tr.aslot(s, c) -> tr.nodom(w, tr.ha(s, c), 8) -> tr.red(p, w, p2, w2)) ->
  (tr.vone(s, tr.obj1(v, tr.ha(s, c)), v, c) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), tr.obj1(v, tr.ha(s, c)), base, code, fr, a2, hs2, fd, rs, p2, w2)) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, fd, rs, p, w)
proof
  fix s v base code fr a a2 c x hs hs2 fd rs p p2 w w2
  assume he hb ha2 hc hfo hfd hfm hx hk hva hw2 hc8 hW hu hred hpt0
  have _ _ hvo _ := expand(hva, tr.vabove)
  let V2 := tr.obj1(v, tr.ha(s, c))
  have g: all m. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, fd) ->
      tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m) proof
    fix m
    assume hi hr hh hrs hmm hfr
    have {sM} := hi
    have r4 := apply(x86i.rsp_typed, sM)
    have g8 := apply(tr.inv_gap, hi)
    have nr := apply(tr.inv_nr, hi)
    // (the object's address: aligned as the entry's rsp and c, below rsp)
    have {sal} := hi
    have e0 _ _ _ := apply(tr.ha_byte, {s.gpr[4]}, {c}, {8}, {0}, r4, g8, hc, arith(), arith())
    have hb0: tr.ha(s, c) in bits(64) by simp()
    have hz: bits_add(64, tr.ha(s, c), bits_of_int(64, 0)) = tr.ha(s, c) by simp(hb0)
    have eh: tr.ha(s, c) = int_add(int_sub(s.gpr[4], int_sub(18446744073709551616, c)), 0) := trans(sym(hz), e0)
    have c64 _ _ nl := expand(hc, tr.hrange)
    have hsl: tr.aslot(s, c) by arith(eh, sal, hc8, c64, nl, r4)
    let ST(m1) := fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, tr.ha(s, c), 8, x)))
    let Q(m2) := ex m1 e1. runs(x86_64_linux.touch_range(tr.ha(s, c), 8, 1), fn_update(m, "rip", a2), ok(m1, e1)) && m2 = ST(m1)
    let QX(y, e) := runs(x86_64_linux.touch_range(tr.ha(s, c), 8, 1), fn_update(m, "rip", a2), exc(y, e))
    have st: all o. runs(x86_64_linux.step(), m, o) -> (ex m2. o = ok(m2, empty) && Q(m2)) || (ex y e. o = exc(y, e) && QX(y, e)) proof
      fix o
      assume ho
      have c0 := mp(all_elim(he, {m}, {o}), hi, hr, hh, hrs, ho)
      have okc: (ex m1 e1. runs(x86_64_linux.touch_range(tr.ha(s, c), 8, 1), fn_update(m, "rip", a2), ok(m1, e1)) && o = ok(ST(m1), empty)) ->
          (ex m2. o = ok(m2, empty) && Q(m2)) proof
        assume h
        obtain m1, h0 from h
        obtain e1, h1 from h0
        have q: Q(ST(m1)) by ex_intro({m1}, {e1}, taut(h1, refl({ST(m1)})))
        show by ex_intro({ST(m1)}, taut(h1, q))
      qed
      have exc0: (ex y e. QX(y, e) && o = exc(y, e)) -> (ex y e. o = exc(y, e) && QX(y, e)) proof
        assume h
        obtain y, h0 from h
        obtain e, h1 from h0
        show by ex_intro({y}, {e}, taut(h1))
      qed
      show by taut(c0, okc, exc0)
    qed
    have post: all m2. Q(m2) -> tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m2) proof
      fix m2
      assume hq
      obtain m1, hq1 from hq
      obtain e1, ht e2 from hq1
      have i2 cos crip cgpr gr stk fl cvm v1 := apply(tr.inv_fstore, {s}, {base}, {code}, {fr}, {m}, {w}, {c}, {8}, {x}, {a2}, {m1}, {e1}, {ST(m1)}, hi, hb, ha2, hc, ht, refl({ST(m1)}))
      // the world: w2 (its I/O, thread pointer, CPU, break's start w's)
      have i3 := apply(tr.inv_world, i2, hW, hu, (w2.os = w.os by simp(hw2)), (w2.fs_base = w.fs_base by simp(hw2)), (w2.cpu = w.cpu by simp(hw2)),
        (w2.vm.brk_start = w.vm.brk_start by simp(hw2)))
      // the homes: those left, kept (the stored bytes the object's)
      have hk2 := apply(tr.homes_store, {s}, {m}, {ST(m1)}, {hs}, {hs2}, {c}, {8}, {x}, {m1.vm}, r4, g8, hh, hk, hc, gr, cvm)
      have ac1 := apply(tr.fstore_acc, {s}, {base}, {code}, {fr}, {m}, {w}, {fd}, {c}, {8}, {a2}, {m1}, {e1}, hi, hfr, hc, hfo, hfd, hfm, ht)
      have pe: ST(m1).vm.pages = m1.vm.pages by simp()
      have ac2 := apply(tr.hacc_pages, {s}, {m1.vm}, {ST(m1).vm}, {c}, {8}, pe, ac1)
      have rs2: tr.regs(ST(m1), rs) by defs(simp(expand(hrs, tr.regs), cgpr), tr.regs)
      have mm1 := apply(tr.mem_grow, {s}, {base}, {code}, {fr}, {m}, {m1}, {w}, {v}, hi, hmm, gr, stk, fl)
      have hf0 := apply(tr.hfree_above, hva, hc)
      have hvn: tr.vone(s, V2, v, c) by defs(taut(hva, hc, g8, refl({V2})), tr.vone)
      have hpt := mp(hpt0, hvn)
      have mm2 := apply(tr.mem_alloc, {s}, {base}, {code}, {fr}, {m}, {m1}, {ST(m1)}, {w}, {w2}, {v}, {c}, {x}, hi, mm1, hc, ac2, hf0, simp(),
        (w2.vm = fn_update(w.vm, "bytes", x86_64_linux.store_le(w.vm.bytes, tr.ha(s, c), 8, x)) by simp(hw2)), (w2.objs = fn_update(w.objs, "live", tr.obj1(w.objs.live, tr.ha(s, c))) by simp(hw2)))
      have f2 := apply(tr.frame_store, {s}, {m}, {ST(m1)}, {fd}, {m1.vm}, hfr, cos, gr, stk, pe, simp(), simp())
      have c1 := mp(all_elim(expand(hpt, tr.pt), {ST(m1)}), i3, crip, hk2, rs2, mm2, f2)
      // (the claim with the callers' objects; the spec's allocation)
      have os := apply(tr.osub_obj1, {s}, {base}, {code}, {fr}, {m}, {w}, {v}, {c}, hi, hvo, hc)
      have c2 := apply(tr.cl_sub[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], os, c1)
      have nd := apply(tr.nodom_frame, {s}, {base}, {code}, {fr}, {m}, {m1}, {w}, {v}, {c}, hi, mm1, hc, ac1, hf0)
      have c3 := apply(tr.cl_red[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], mp(hred, hsl, nd), c2)
      show := rewrite(sym(e2), c3)
    qed
    have fault: all y e. QX(y, e) -> tr.ub(s, v, p, w) || tr.crash(s, p, w, exc(y, e)) proof
      fix y e
      assume hq
      have cr := apply(tr.frame_fault, {s}, {base}, {code}, {fr}, {m}, {w}, {fd}, {c}, {8}, {a2}, {y}, {e}, {p}, hi, hfr, hc, hfo, hfd, hfm, ha2, hq)
      show by taut(cr)
    qed
    show := mp(tr.step_x[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb), s := s, v := v, p := p, w := w, m := m, q := x. Q(x), qx := y e. QX(y, e)], st, nr, post, fault)
  qed
  show by defs(g, tr.lv)
qed

// (the instruction mov [rsp + d], r64 so: the register's word u stored,
// the object's first bytes)
theorem tr.astore_r(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g d c z1 z2 u hs hs2 fd rs p p2 w w2.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a ->
    runs(x86_64_linux.exec_body(len, tag(75, pair(8, pair(g, pair(x86i.rsp_mem(d), pair(z1, z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> base in omega -> g in x86_64_linux.Reg -> g in dom(rs) -> rs[g] = pair(8, u) -> u in bits(64) ->
  d in bits(64) -> c = int_mod(int_sub(d, fr), 18446744073709551616) -> tr.hrange(c, 8) -> fd in omega -> int_le(int_sub(18446744073709551616, fd), c) -> int_le(fd, tr.FMAX) ->
  tr.hkeep(hs, hs2, c, 8) -> tr.vabove(s, v) ->
  w2 = fn_update(fn_update(w, "vm", fn_update(w.vm, "bytes", x86_64_linux.store_le(w.vm.bytes, tr.ha(s, c), 8, u))), "objs", fn_update(w.objs, "live", tr.obj1(w.objs.live, tr.ha(s, c)))) ->
  int_mod(c, 8) = 0 -> w2 in abi.World -> w2 in univ(1) -> (tr.aslot(s, c) -> tr.nodom(w, tr.ha(s, c), 8) -> tr.red(p, w, p2, w2)) ->
  (tr.vone(s, tr.obj1(v, tr.ha(s, c)), v, c) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), tr.obj1(v, tr.ha(s, c)), base, code, fr, a2, hs2, fd, rs, p2, w2)) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, fd, rs, p, w)
proof
  fix s v base code fr a a2 len g d c z1 z2 u hs hs2 fd rs p p2 w w2
  assume hat ha2 hb hg hgd hgu ub hd hcd hc hfo hfd hfm hk hva hw2 hc8 hW hu hred hpt
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex m1 e1. runs(x86_64_linux.touch_range(tr.ha(s, c), 8, 1), fn_update(m, "rip", a2), ok(m1, e1)) &&
        o = ok(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, tr.ha(s, c), 8, u))), empty)) ||
      (ex y e. runs(x86_64_linux.touch_range(tr.ha(s, c), 8, 1), fn_update(m, "rip", a2), exc(y, e)) && o = exc(y, e)) proof
    fix m o
    assume hi hr hh hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have {sM} := hi
    have r4 := apply(x86i.rsp_typed, sM)
    have g8 := apply(tr.inv_gap, hi)
    have {slt} := hi
    have fe := apply(tr.frame_ea, {s}, {base}, {code}, {fr}, {m}, {w}, {d}, {c}, {0}, hi, hd, hcd, simp())
    have rg _ := apply(tr.regs_get, {m}, {rs}, {g}, {8}, {u}, hrs, hgd, hgu)
    have xv: (8 = 4 && u = bits_slice(m.gpr[g], 31, 0) || 8 = 8 && u = m.gpr[g]) by simp(rg)
    have k0: all i. i in omega -> int_lt(i, 8) -> x86_64_linux.canonical(bits_add(64, x86i.rsp_ea(m, d), bits_of_int(64, i))) proof
      fix i
      assume i1 i2
      have ei _ il .. := apply(tr.ha_byte, {s.gpr[4]}, {c}, {8}, {i}, r4, g8, hc, i1, i2)
      have ea: bits_add(64, x86i.rsp_ea(m, d), bits_of_int(64, i)) = int_add(int_sub(s.gpr[4], int_sub(18446744073709551616, c)), i) by simp(fe, ei)
      have cr := expand(hc, tr.hrange)
      show by defs(simp(ea, il, slt, i1, cr), x86_64_linux.canonical)
    qed
    have hx2 := mp(mp(mp(all_elim(hat, {m}, {o}), ho), ipC), hr)
    have r := apply(x86i.store_rsp_t, {m}, {o}, {8}, {g}, {d}, {z1}, {z2}, {len}, {u}, ipM, ipU, hg, hd, xv, k0, hx2)
    have ra: bits_add(64, m.rip, len) = a2 by simp(hr, ha2)
    have r2 := rewrite(ra, rewrite(fe, r))
    have nd: all t. !runs(x86_64_linux.touch_range(tr.ha(s, c), 8, 1), fn_update(m, "rip", a2), diverge(t)) proof
      fix t
      show := apply(x86.touch_range_nodiv, {fn_update(m, "rip", a2)}, {tr.ha(s, c)}, {8}, {1}, {t}, (8 in omega by arith()))
    qed
    have dv: (ex t. runs(x86_64_linux.touch_range(tr.ha(s, c), 8, 1), fn_update(m, "rip", a2), diverge(t)) && o = diverge(t)) -> false proof
      assume h
      obtain t, ht from h
      show by taut(ht, all_elim(nd, {t}))
    qed
    show by taut(r2, dv)
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.astore_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {c}, {u}, {hs}, {hs2}, {fd}, {rs}, {p}, {p2}, {w}, {w2},
    he, hb, a2b, hc, hfo, hfd, hfm, ub, hk, hva, hw2, hc8, hW, hu, hred, hpt)
qed

// ---------------------------------------------------------------------
//  The spec's allocation of one object of 8 bytes at A (its bytes x:
//  any, as alloc_objs allows)

theorem tr.alloc1_run: all w A x. w in abi.World -> w in univ(1) -> A in bits(64) -> int_le(int_add(A, 8), 18446744073709551616) -> int_mod(A, 8) = 0 ->
  (all a. a in omega -> int_le(A, a) && int_lt(a, int_add(A, 8)) -> !abi.in_domain(w.vm, w.objs, a) && !(a in w.objs.hidden)) ->
  runs(gimple.alloc_objs(seq_one(pair(8, 8))), w, ok(fn_update(fn_update(w, "vm", fn_update(w.vm, "bytes", x86_64_linux.store_le(w.vm.bytes, A, 8, x))), "objs", fn_update(w.objs, "live", tr.obj1(w.objs.live, A))), seq_one(A)))
proof
  fix w A x
  assume hW hu hA hA8 hal hnd
  let SZ := seq_one(pair(8, 8))
  let V := fn_update(w.vm, "bytes", x86_64_linux.store_le(w.vm.bytes, A, 8, x))
  let W2 := fn_update(fn_update(w, "vm", V), "objs", fn_update(w.objs, "live", tr.obj1(w.objs.live, A)))
  let D(x2) := x2 in list_type(bits(64)) && ((seq_len(x2) = seq_len(SZ) && (all x3. x3 in omega -> int_lt(x3, seq_len(SZ)) -> int_mod(app(x2, x3), snd(app(SZ, x3))) = 0 &&
    (all x4. x4 in omega -> int_le(app(x2, x3), x4) && int_lt(x4, int_add(app(x2, x3), fst(app(SZ, x3)))) -> !abi.in_domain(app(w, "vm"), app(w, "objs"), x4) && !(x4 in app(app(w, "objs"), "hidden"))))) &&
    (all x3. all x4. x3 in omega && x4 in omega -> int_lt(x3, x4) && int_lt(x4, seq_len(SZ)) -> int_le(int_add(app(x2, x3), fst(app(SZ, x3))), app(x2, x4)) ||
      int_le(int_add(app(x2, x4), fst(app(SZ, x4))), app(x2, x3))))
  let P2(x3, x5) := x5 in x86_64_linux.Vm && (fn_update(app(fn_update(w, "vm", x5), "vm"), "bytes", app(app(w, "vm"), "bytes")) = app(w, "vm") &&
    (all x6. x6 in bits(64) -> (all x7. x7 in omega -> int_lt(x7, seq_len(SZ)) -> !(int_le(app(x3, x7), x6) && int_lt(x6, int_add(app(x3, x7), fst(app(SZ, x7)))))) ->
      app(app(app(fn_update(w, "vm", x5), "vm"), "bytes"), x6) = app(app(app(w, "vm"), "bytes"), x6)))
  let Q2(x3, x5) := ok(W2, seq_one(A)) = ok(fn_update(fn_update(w, "vm", x5), "objs", fn_update(app(fn_update(w, "vm", x5), "objs"), "live", set_select(omega, x7. x7 in app(app(fn_update(w, "vm", x5), "objs"), "live") ||
    (ex x8. x8 in omega && ((int_lt(x8, seq_len(SZ)) && int_le(app(x3, x8), x7)) && int_lt(x7, int_add(app(x3, x8), fst(app(SZ, x8))))))))), x3)
  have l1: seq_len(SZ) = 1 by simp()
  have k0: all k. k in omega -> int_lt(k, seq_len(SZ)) -> k = 0 proof
    fix k
    assume k1 k2
    show by arith(k1, k2, l1)
  qed
  // the addresses: [A], aligned, off the domain
  have dA: D(seq_one(A)) proof
    have t1 := mp(all_elim(tr.seq_one_type, {A}, {bits(64)}), hA)
    have t2: seq_len(seq_one(A)) = seq_len(SZ) by simp()
    have t3: all x3. x3 in omega -> int_lt(x3, seq_len(SZ)) -> int_mod(app(seq_one(A), x3), snd(app(SZ, x3))) = 0 &&
        (all x4. x4 in omega -> int_le(app(seq_one(A), x3), x4) && int_lt(x4, int_add(app(seq_one(A), x3), fst(app(SZ, x3)))) -> !abi.in_domain(app(w, "vm"), app(w, "objs"), x4) && !(x4 in app(app(w, "objs"), "hidden"))) proof
      fix k
      assume k1 k2
      have e := mp(all_elim(k0, {k}), k1, k2)
      have m0: int_mod(app(seq_one(A), k), snd(app(SZ, k))) = 0 by simp(e, hal)
      have nd: all x4. x4 in omega -> int_le(app(seq_one(A), k), x4) && int_lt(x4, int_add(app(seq_one(A), k), fst(app(SZ, k)))) -> !abi.in_domain(app(w, "vm"), app(w, "objs"), x4) && !(x4 in app(app(w, "objs"), "hidden")) proof
        fix y
        assume y1 y2
        have y3 := rewrite(e, y2)
        have yy: int_le(A, y) && int_lt(y, int_add(A, 8)) by simp(y3)
        show := mp(all_elim(hnd, {y}), y1, yy)
      qed
      show by taut(m0, nd)
    qed
    have t4: all x3. all x4. x3 in omega && x4 in omega -> int_lt(x3, x4) && int_lt(x4, seq_len(SZ)) -> int_le(int_add(app(seq_one(A), x3), fst(app(SZ, x3))), app(seq_one(A), x4)) ||
        int_le(int_add(app(seq_one(A), x4), fst(app(SZ, x4))), app(seq_one(A), x3)) proof
      fix j k
      assume h1 h2
      have jo ko := h1
      have f: false by arith(jo, ko, h2, l1)
      show by taut(f)
    qed
    show by taut(t1, t2, t3, t4)
  qed
  // the memory: x at A, else as it was
  have vm0: w.vm in x86_64_linux.Vm by simp(hW, keep(x86_64_linux.Vm))
  have su := apply(g.store_univ, {w.vm}, {A}, {8}, {x}, vm0)
  have vu: V in univ(1) by simp(hu, su)
  have vV := apply(x86.store_vm, {w.vm}, {A}, {8}, {x}, vm0, vu)
  have pV: P2(seq_one(A), V) proof
    have e1: fn_update(app(fn_update(w, "vm", V), "vm"), "bytes", app(app(w, "vm"), "bytes")) = app(w, "vm") by simp(vm0, keep(x86_64_linux.Vm))
    have e2: all x6. x6 in bits(64) -> (all x7. x7 in omega -> int_lt(x7, seq_len(SZ)) -> !(int_le(app(seq_one(A), x7), x6) && int_lt(x6, int_add(app(seq_one(A), x7), fst(app(SZ, x7)))))) ->
        app(app(app(fn_update(w, "vm", V), "vm"), "bytes"), x6) = app(app(app(w, "vm"), "bytes"), x6) proof
      fix z
      assume hz hn
      have n0 := mp(all_elim(hn, {0}), arith(), (int_lt(0, seq_len(SZ)) by arith(l1)))
      have ne: all j. j in omega -> int_lt(j, 8) -> !(z = bits_add(64, A, bits_of_int(64, j))) proof
        fix j
        assume j1 j2
        assume ez
        have zr: int_le(A, z) && int_lt(z, int_add(A, 8)) by defs(arith(ez, j1, j2, hA, hA8), bits_add, bits_of_int, pow2)
        show by taut(n0, (int_le(app(seq_one(A), 0), z) && int_lt(z, int_add(app(seq_one(A), 0), fst(app(SZ, 0)))) by simp(zr)))
      qed
      have so := apply(tr.storen_other, {w.vm.bytes}, {A}, {8}, {x}, {z}, hz, ne)
      show by simp(so)
    qed
    show by taut(vV, e1, e2)
  qed
  have qV: Q2(seq_one(A), V) by simp()
  have e5: ex x5. P2(seq_one(A), x5) && Q2(seq_one(A), x5) by ex_intro({V}, taut(pV, qV))
  have e2: ex x2. D(x2) && (!(ex x5. P2(x2, x5)) || (ex x5. P2(x2, x5) && Q2(x2, x5))) by ex_intro({seq_one(A)}, taut(dA, e5))
  let BODY(x0, x1) := any_rel(x2. x2 in list_type(bits(64)) && ((seq_len(x2) = seq_len(seq_one(pair(8, 8))) && (all x3. x3 in omega -> int_lt(x3, seq_len(seq_one(pair(8, 8)))) -> int_mod(app(x2, x3), snd(app(seq_one(pair(8, 8)), x3))) = 0 && (all x4. x4 in omega -> int_le(app(x2, x3), x4) && int_lt(x4, int_add(app(x2, x3), fst(app(seq_one(pair(8, 8)), x3)))) -> !abi.in_domain(app(x0, "vm"), app(x0, "objs"), x4) && !(x4 in app(app(x0, "objs"), "hidden"))))) && (all x3. all x4. x3 in omega && x4 in omega -> int_lt(x3, x4) && int_lt(x4, seq_len(seq_one(pair(8, 8)))) -> int_le(int_add(app(x2, x3), fst(app(seq_one(pair(8, 8)), x3))), app(x2, x4)) || int_le(int_add(app(x2, x4), fst(app(seq_one(pair(8, 8)), x4))), app(x2, x3)))), x2. letin(x2, x3. letin(app(x0, "vm"), x4. any_rel(x5. x5 in x86_64_linux.Vm && (fn_update(app(fn_update(x0, "vm", x5), "vm"), "bytes", app(x4, "bytes")) = x4 && (all x6. x6 in bits(64) -> (all x7. x7 in omega -> int_lt(x7, seq_len(seq_one(pair(8, 8)))) -> !(int_le(app(x3, x7), x6) && int_lt(x6, int_add(app(x3, x7), fst(app(seq_one(pair(8, 8)), x7)))))) -> app(app(app(fn_update(x0, "vm", x5), "vm"), "bytes"), x6) = app(app(x4, "bytes"), x6))), x5. letin(fn_update(x0, "vm", x5), x6. letin(fn_update(x6, "objs", fn_update(app(x6, "objs"), "live", set_select(omega, x7. x7 in app(app(x6, "objs"), "live") || (ex x8. x8 in omega && ((int_lt(x8, seq_len(seq_one(pair(8, 8)))) && int_le(app(x3, x8), x7)) && int_lt(x7, int_add(app(x3, x8), fst(app(seq_one(pair(8, 8)), x8))))))))), x7. x1 = ok(x7, x3)))))))
  have rb: BODY(w, ok(W2, seq_one(A))) by defs(taut(e2), any_rel, letin)
  have a1 := mp(univ_trans[u := 1, a := A, b := bits(64)], bits_univ[n := 64], hA)
  have ss: subset(tr.obj1(w.objs.live, A), omega) proof
    have g: all z. z in tr.obj1(w.objs.live, A) -> z in omega proof
      fix z
      assume hz
      show by taut(all_elim(tr.obj1_in, {w.objs.live}, {A}, {z}), hz)
    qed
    show by defs(g, subset)
  qed
  have o1u := mp(univ_subset[u := 1, a := tr.obj1(w.objs.live, A), b := omega], omega_univ, ss)
  have wou := mp(app_univ[u := 1, f := w, k := "objs"], hu)
  have ou: fn_update(w.objs, "live", tr.obj1(w.objs.live, A)) in univ(1) by simp(wou, o1u)
  have so1: seq_one(A) in univ(1) by defs(simp(a1), seq_one)
  have pu: pair(w, ok(W2, seq_one(A))) in univ(1) by simp(hu, vu, ou, so1)
  show by defs(apply(tr.runs_intro[r := x0 x1. BODY(x0, x1)], {w}, {ok(W2, seq_one(A))}, pu, rb), gimple.alloc_objs)
qed

// (the same bytes stored again: the bytes as they are)
theorem tr.store_le_twice: all b a n x. x86_64_linux.store_le(x86_64_linux.store_le(b, a, n, x), a, n, x) = x86_64_linux.store_le(b, a, n, x)
proof
  fix b a n x
  let C(y) := int_lt(bits_sub(64, y, a), n)
  let X(y) := bits_of_int(8, int_div(x, int_pow(256, bits_sub(64, y, a))))
  let S := x86_64_linux.store_le(b, a, n, x)
  have g: all y. y in bits(64) -> ite(C(y), X(y), S[y]) = ite(C(y), X(y), b[y]) proof
    fix y
    assume hy
    have e1: S[y] = ite(C(y), X(y), b[y]) by defs(mp(app_fn_build[d := bits(64), v := y. ite(C(y), X(y), b[y]), a := y], hy), x86_64_linux.store_le)
    have c1: C(y) -> ite(C(y), X(y), S[y]) = ite(C(y), X(y), b[y]) proof
      assume h
      have l := mp(ite_t[c := C(y), a := X(y), b := S[y]], h)
      have r := mp(ite_t[c := C(y), a := X(y), b := b[y]], h)
      show := trans(l, sym(r))
    qed
    have c2: !C(y) -> ite(C(y), X(y), S[y]) = ite(C(y), X(y), b[y]) proof
      assume h
      have l := mp(ite_f[c := C(y), a := X(y), b := S[y]], h)
      show := trans(l, e1)
    qed
    show by taut(c1, c2)
  qed
  have ex := mp(fn_build_ext[d := bits(64), f := y. ite(C(y), X(y), S[y]), g := y. ite(C(y), X(y), b[y])], g)
  show by defs(ex, x86_64_linux.store_le)
qed

// (a world whose object's bytes are x already: the store of x keeps it)
theorem tr.store_same: all w a x O. w in abi.World ->
  fn_update(fn_update(w, "vm", fn_update(w.vm, "bytes", x86_64_linux.store_le(w.vm.bytes, a, 8, x))), "objs", O) in abi.World ->
  fn_update(fn_update(fn_update(w, "vm", fn_update(w.vm, "bytes", x86_64_linux.store_le(w.vm.bytes, a, 8, x))), "objs", O), "vm",
    fn_update(fn_update(fn_update(w, "vm", fn_update(w.vm, "bytes", x86_64_linux.store_le(w.vm.bytes, a, 8, x))), "objs", O).vm, "bytes",
      x86_64_linux.store_le(fn_update(fn_update(w, "vm", fn_update(w.vm, "bytes", x86_64_linux.store_le(w.vm.bytes, a, 8, x))), "objs", O).vm.bytes, a, 8, x))) =
  fn_update(fn_update(w, "vm", fn_update(w.vm, "bytes", x86_64_linux.store_le(w.vm.bytes, a, 8, x))), "objs", O)
proof
  fix w a x O
  assume hw h2
  let W2 := fn_update(fn_update(w, "vm", fn_update(w.vm, "bytes", x86_64_linux.store_le(w.vm.bytes, a, 8, x))), "objs", O)
  have eb: W2.vm.bytes = x86_64_linux.store_le(w.vm.bytes, a, 8, x) by simp()
  have tw := all_elim(tr.store_le_twice, {w.vm.bytes}, {a}, {8}, {x})
  have e1: x86_64_linux.store_le(W2.vm.bytes, a, 8, x) = W2.vm.bytes by simp(eb, tw)
  have wf := expand(h2, abi.World)
  have vf: is_fun(W2.vm) && "bytes" in dom(W2.vm) by simp(wf, keep(x86_64_linux.Vm))
  have e2 := mp(fn_update_same[f := W2.vm, k := "bytes"], vf.1, vf.2)
  have wf2: is_fun(W2) && "vm" in dom(W2) by simp(wf)
  have e3 := mp(fn_update_same[f := W2, k := "vm"], wf2.1, wf2.2)
  show by simp(e1, e2, e3)
qed

// (a store's run there: to the same world)
theorem tr.run_kept(op): all W2 w a x a2 x2 O. W2 = fn_update(fn_update(w, "vm", fn_update(w.vm, "bytes", x86_64_linux.store_le(w.vm.bytes, a, 8, x))), "objs", O) ->
  a2 = a -> x2 = x -> w in abi.World -> W2 in abi.World ->
  runs(op, W2, ok(fn_update(W2, "vm", fn_update(W2.vm, "bytes", x86_64_linux.store_le(W2.vm.bytes, a2, 8, x2))), empty)) -> runs(op, W2, ok(W2, empty))
proof
  fix W2 w a x a2 x2 O
  assume e ea ex hw h2 hr
  have h2b := rewrite(e, h2)
  have s := apply(tr.store_same, {w}, {a}, {x}, {O}, hw, h2b)
  have s2 := rewrite(sym(e), s)
  have hr2 := rewrite(ea, rewrite(ex, hr))
  show := rewrite(s2, hr2)
qed

// (N's equation for the objects' list: an object's address, the first)
theorem nf.seq_one0: all x. app(seq_one(x), 0) = x
proof
  fix x
  show by simp()
qed

// (the world after: a world)
theorem tr.world_alloc: all w A x. w in abi.World -> w in univ(1) -> A in bits(64) ->
  fn_update(fn_update(w, "vm", fn_update(w.vm, "bytes", x86_64_linux.store_le(w.vm.bytes, A, 8, x))), "objs", fn_update(w.objs, "live", tr.obj1(w.objs.live, A))) in abi.World &&
  fn_update(fn_update(w, "vm", fn_update(w.vm, "bytes", x86_64_linux.store_le(w.vm.bytes, A, 8, x))), "objs", fn_update(w.objs, "live", tr.obj1(w.objs.live, A))) in univ(1)
proof
  fix w A x
  assume hW hu hA
  let W1 := fn_update(w, "vm", fn_update(w.vm, "bytes", x86_64_linux.store_le(w.vm.bytes, A, 8, x)))
  have w1W w1u := apply(tr.world_store, {w}, {A}, {8}, {x}, hW, hu, hA)
  have wf := expand(w1W, abi.World)
  have ss: subset(tr.obj1(w.objs.live, A), omega) proof
    have g: all z. z in tr.obj1(w.objs.live, A) -> z in omega proof
      fix z
      assume hz
      show by taut(all_elim(tr.obj1_in, {w.objs.live}, {A}, {z}), hz)
    qed
    show by defs(g, subset)
  qed
  have ot1: tr.obj1(w.objs.live, A) in set_type(omega) by defs(taut(powerset_def[s := omega, a := tr.obj1(w.objs.live, A)], ss), set_type)
  have o1u := mp(univ_subset[u := 1, a := tr.obj1(w.objs.live, A), b := omega], omega_univ, ss)
  have wou := mp(app_univ[u := 1, f := w, k := "objs"], hu)
  have wot: w.objs in abi.Objs by simp(expand(hW, abi.World))
  have ot := apply(abi.objs_live_typed, wot, wou, ot1, o1u)
  have ou: fn_update(w.objs, "live", tr.obj1(w.objs.live, A)) in univ(1) by simp(wou, o1u)
  have r1: fn_update(W1, "objs", fn_update(w.objs, "live", tr.obj1(w.objs.live, A))) in abi.World by defs(simp(wf, expand(hW, abi.World), ot, w1u, ou), abi.World)
  have r2: fn_update(W1, "objs", fn_update(w.objs, "live", tr.obj1(w.objs.live, A))) in univ(1) by simp(w1u, ou)
  show by taut(r1, r2)
qed

// ----------------------------------------------------------------------
//  A wrapper with more than the procedure's call: a function of no
//  arguments whose spec P is any program (its stack objects' release, the
//  stack protector's canary read before the call and compared after) -- the
//  claim at the entry on P itself, as tr.entry0's on the call's wrapper

theorem tr.entry0p(lb, lc, base, code, statics, f, fd, x1. rs, P, x5 x6 x7. E): base in omega ->
  (all vm. abi.loaded(vm, lb, lc, statics) -> abi.code_at(vm, base, code)) ->
  (all s args v. s in x86_64_linux.Machine -> E(s, args, v) -> tr.entry_ok_u(s, args)) ->
  (all s. s in x86_64_linux.Machine -> tr.regs(s, rs(s))) ->
  (all args v mem s. args in abi.ARGS -> v in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> abi.loaded(s.vm, lb, lc, statics) -> abi.view(s, v, mem) in univ(1) -> E(s, args, v) -> tr.vabove(s, v) ->
    tr.pt(s, zb. false, zb pb wb. false, v, base, code, 0, f, empty, fd, rs(s), P, abi.view(s, v, mem))) ->
  (all args v mem s o. args in abi.ARGS -> v in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(s.vm, lb, lc, statics) -> s.rip = f ->
    E(s, args, v) -> tr.objs_ok(s, v) -> abi.view_ok(s, v, mem) -> tr.run_d(s, s, o) ->
    tr.matches_t(fn_build(abi.ARGS, x0. P), args, v, mem, s, o))
proof
  assume hbase hsub hE hregs hbody
  fix args v mem s o
  assume hA hvo hmv hM hsu hl hrip he hob hvw hr
  let W := abi.view(s, v, mem)
  let SPEC := fn_build(abi.ARGS, x0. P)
  have heu := mp(all_elim(hE, {s}, {args}, {v}), hM, he)
  have hc := mp(all_elim(hsub, {s.vm}), hl)
  have su := hsu
  have ent := apply(tr.entry_stack_u, hM, heu)
  have rsv gap hdf := apply(tr.entry_rsv_u, heu)
  have r4 := apply(x86i.rsp_typed, hM)
  have ou := apply(abi.objs_univ, hvo)
  have mu := apply(x86.vm_univ, hmv)
  have ocu := mp(all_elim(abi.objs_at_univ, {v}, {s.fs_base}), ou)
  have hvu: W in univ(1) by simp(su, ou, mu, ocu)
  have wt := apply(abi.world_typed, hM, hvo, hmv, hvu)
  have z0: int_sub(s.gpr[4], 0) = s.gpr[4] by arith(r4)
  have wbk := apply(tr.entry_brk_u, heu, hvw)
  have can := apply(tr.entry_can_u, heu)
  have inv: tr.inv(s, base, code, 0, s, W) by defs(simp(subset_refl[s := s.os.events], hvw.1, gap, rsv, all_elim(tr.keeps_refl, {s.vm}), all_elim(tr.kept_refl, {s.vm}, {s.gpr[4]}), z0, hM, su, hc, hdf, wt, hvu, ent, wbk, can, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access, abi.brk_start_ok)), tr.inv)
  have {slt} := inv
  have vab := apply(tr.vabove_ok, hM, slt, hvo, hob)
  have body := mp(all_elim(hbody, {args}, {v}, {mem}, {s}), hA, hvo, hmv, hM, hl, hvu, he, vab)
  have hh: tr.homes(s, s, empty) by defs(simp(dom_empty), tr.homes)
  have rr := mp(all_elim(hregs, {s}), hM)
  have mm := apply(tr.mem_entry, hM, can, hob, hvw)
  have fe := all_elim(tr.frame_entry, {s}, {fd})
  have lt0 := apply(tr.sp_lt, {s.gpr[4]}, r4, ent.4)
  have ns0: !tr.stopk(s, zb. false, s) by defs(taut(lt0), tr.stopk)
  have c0 := mp(all_elim(expand(body, tr.pt), {s}), inv, hrip, hh, rr, mm, fe)
  have sim := mp(expand(c0, tr.cl).2, ns0)
  have ae: SPEC[args] = P by simp(hA)
  have r0: all o2. runs(P, W, o2) -> runs(SPEC[args], W, o2) proof
    fix o2
    assume h
    show := rewrite(sym(ae), h)
  qed
  have red: tr.red(SPEC[args], W, P, W) by defs(r0, tr.red)
  have sim2 := apply(tr.sim_red[bkp := zb. false, bka := zb pb wb. false], red, sim)
  show := apply(tr.entry_d, {SPEC}, {args}, {s}, {v}, {mem}, {o}, hM, ent.4, sim2, hr)
qed

// (an operation whose arguments read the world -- `ld64(fs_base, 40)`: at
// the point's)
theorem tr.qs_atop(w, x0. op, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k): all o.
  runs(mkprog(x0 x1. ex x8. bind_rel(op(w), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), w, o) ->
  runs(mkprog(x0 x1. ex x8. bind_rel(op(x0), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), w, o)
proof
  fix o
  assume hr
  have pu := apply(g.runs_univ, hr)
  have c := apply(g.runs_elim, hr)
  show := apply(tr.runs_intro[r := x0 x1. ex x8. bind_rel(op(x0), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)], {w}, {o}, pu, c)
qed

// (a let of the world's part -- `let objs0 = objs`: the point's)
theorem tr.qs_letw(w, x0. e, x0 x8 x. a, x8 x1. k): all o. runs(mkprog(x0 x1. ex x8. letin(e(w), x. a(x0, x8, x)) && k(x8, x1)), w, o) ->
  runs(mkprog(x0 x1. ex x8. letin(e(x0), x. a(x0, x8, x)) && k(x8, x1)), w, o)
proof
  fix o
  assume hr
  have pu := apply(g.runs_univ, hr)
  have c := apply(g.runs_elim, hr)
  show := apply(tr.runs_intro[r := x0 x1. ex x8. letin(e(x0), x. a(x0, x8, x)) && k(x8, x1)], {w}, {o}, pu, c)
qed

// (a block that is the whole rest: its head the program -- tr.qs_intro back)
theorem tr.qs_outro(x0 x1. a): all w o. runs(mkprog(x0 x1. a(x0, x1)), w, o) -> runs(mkprog(x0 x1. ex x8. a(x0, x8) && x1 = x8), w, o)
proof
  fix w o
  assume hr
  have pu := apply(g.runs_univ, hr)
  have c := apply(g.runs_elim, hr)
  have b: ex x8. a(w, x8) && o = x8 by ex_intro({o}, taut(c, refl({o})))
  show := apply(tr.runs_intro[r := x0 x1. ex x8. a(x0, x8) && x1 = x8], {w}, {o}, pu, b)
qed

// (`if !C { undefined }` with C false -- the canary changed: the program
// raises, any claim)
theorem tr.undef_ub(C, x2 x3. L, zb. bkp, zb pb wb. bka): all s v base code fr a hs ds rs w. !C -> w in abi.World -> w in univ(1) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs,
    mkprog(x0 x1. ex x2. (!C || (!!C && x2 = ok(pair(x0, empty), empty))) && (ex x3. lx.top(x2, L(x2, x3), x3) && x1 = x3)), w)
proof
  fix s v base code fr a hs ds rs w
  assume hc hW hu
  let X := exc(pair(w, empty), pair("raise", empty))
  let O := exc(w, empty)
  have f1: fst(X) = 1 by rsimp()
  have f2: fst(out_value(X)) = "raise" by rsimp()
  have s1: fst(out_state(X)) = w by rsimp()
  have s2: snd(out_value(X)) = empty by rsimp()
  have tp: lx.top(X, L(X, O), O) by taut(f1, f2, (O = exc(fst(out_state(X)), snd(out_value(X))) by simp(s1, s2)))
  have e3: ex x3. lx.top(X, L(X, x3), x3) && O = x3 by ex_intro({O}, taut(tp, refl({O})))
  have b: ex x2. (!C || (!!C && x2 = ok(pair(w, empty), empty))) && (ex x3. lx.top(x2, L(x2, x3), x3) && O = x3)
    by ex_intro({X}, taut(hc, e3))
  have eu: empty in univ(1) by simp()
  have pu: pair(w, O) in univ(1) by simp(hu)
  have r := apply(tr.runs_intro[r := x0 x1. ex x2. (!C || (!!C && x2 = ok(pair(x0, empty), empty))) && (ex x3. lx.top(x2, L(x2, x3), x3) && x1 = x3)], {w}, {O}, pu, b)
  have wa := apply(tr.world_and, hW)
  have eno: !(empty = exc_val("stack_overflow", empty)) by defs(all_elim(tr.pair_ne, {"stack_overflow"}, {empty}), exc_val)
  have rst: abi.raise_state(w) by defs(wa, abi.raise_state)
  have ub: tr.ub(s, v, mkprog(x0 x1. ex x2. (!C || (!!C && x2 = ok(pair(x0, empty), empty))) && (ex x3. lx.top(x2, L(x2, x3), x3) && x1 = x3)), w)
    by defs(ex_intro({empty}, {w}, taut(eu, eno, rst, r)), tr.ub)
  have g: all m. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, ds) ->
      tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, mkprog(x0 x1. ex x2. (!C || (!!C && x2 = ok(pair(x0, empty), empty))) && (ex x3. lx.top(x2, L(x2, x3), x3) && x1 = x3)), w, m) proof
    fix m
    assume hi hm hh hrs hmm hfr
    show := apply(tr.sim_ub[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {mkprog(x0 x1. ex x2. (!C || (!!C && x2 = ok(pair(x0, empty), empty))) && (ex x3. lx.top(x2, L(x2, x3), x3) && x1 = x3))}, {w}, {m}, ub)
  qed
  show by defs(g, tr.lv)
qed

// (a program that may raise: any claim)
theorem tr.lv_ub(zb. bkp, zb pb wb. bka): all s v base code fr a hs fd rs p w. tr.ub(s, v, p, w) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, fd, rs, p, w)
proof
  fix s v base code fr a hs fd rs p w
  assume hu
  have g: all m. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, fd) ->
      tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m) proof
    fix m
    assume hi hm hh hrs hmm hfr
    show := apply(tr.sim_ub[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {p}, {w}, {m}, hu)
  qed
  show by defs(g, tr.lv)
qed

// (an operation's definedness split, as tr.wsplit's, on the program itself:
// raising where c fails)
theorem tr.psplit(s, v, base, code, fr, a, hs, ds, rs, w, q, c, zb. bkp, zb pb wb. bka): all x. x in abi.World -> x in univ(1) -> (!c -> runs(q, w, exc(x, empty))) ->
  (c -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, q, w)) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, q, w)
proof
  fix x
  assume hxW hxu hu hd
  have nu: !c -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, q, w) proof
    assume hn
    have wa := apply(tr.world_and, hxW)
    have eu: empty in univ(1) by simp()
    have eno: !(empty = exc_val("stack_overflow", empty)) by defs(all_elim(tr.pair_ne, {"stack_overflow"}, {empty}), exc_val)
    have rst: abi.raise_state(x) by defs(wa, abi.raise_state)
    have ub: tr.ub(s, v, q, w) by defs(ex_intro({empty}, {x}, taut(eu, eno, rst, mp(hu, hn))), tr.ub)
    show := apply(tr.lv_ub[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {hs}, {ds}, {rs}, {q}, {w}, ub)
  qed
  show by taut(hd, nu)
qed

// ----------------------------------------------------------------------
//  The stack protector's instructions: the canary cleared from rax

// lea r64, [rsp + d] (8D /r): the frame's address d
theorem x86i.lea_rsp: all m o g d z1 z2 z3 len. m in x86_64_linux.Machine -> m in univ(1) -> g in x86_64_linux.Reg -> d in bits(64) ->
  runs(x86_64_linux.exec_body(len, tag(78, pair(8, pair(g, pair(z1, pair(z2, pair(z3, fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(2, 4)), "index", none), "scale", 1), "disp", d)))))))), m, o) ->
  o = ok(fn_update(fn_update(m, "rip", bits_add(64, m.rip, len)), "gpr", fn_update(m.gpr, g, bits_add(64, int_add(m.gpr[4], d), 0))), empty)
proof
  fix m o g d z1 z2 z3 len
  assume hM hu hg hd hr
  have pt := apply(x86i.parts, hM)
  show by simp(hr, hu, pt, apply(x86i.reg_typed, hM, hg), apply(x86i.rsp_typed, hM), hd)
qed

// lea r64, [rsp + d]: g := the address of the frame's bytes at c (a stack
// object's)
theorem tr.lea_rsp(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g d c z1 z2 z3 hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a ->
    runs(x86_64_linux.exec_body(len, tag(78, pair(8, pair(g, pair(z1, pair(z2, pair(z3, fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(2, 4)), "index", none), "scale", 1), "disp", d)))))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> d in bits(64) -> c = int_mod(int_sub(d, fr), 18446744073709551616) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs, g, pair(8, tr.ha(s, c))), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g d c z1 z2 z3 hs ds rs p w
  assume hat ha2 hg hd hc hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(m.gpr, g, tr.ha(s, c))), empty) proof
    fix m o
    assume hi hr hhs hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have hx := mp(mp(mp(all_elim(hat, {m}, {o}), ho), ipC), hr)
    have e := apply(x86i.lea_rsp, {m}, {o}, {g}, {d}, {z1}, {z2}, {z3}, {len}, ipM, ipU, gR, hd, hx)
    have fe := apply(tr.frame_ea, {s}, {base}, {code}, {fr}, {m}, {w}, {d}, {c}, {0}, hi, hd, hc, simp())
    show by simp(e, fe, hr, ha2)
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      tr.ha(s, c) in bits(int_mul(8, 8)) && tr.ha(s, c) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {8}, {tr.ha(s, c)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// imul r64, r/m64 (a register), imm32 (REX.W 69 /r id)
theorem x86i.imul64_imm: all m o g h z1 z2 k len. m in x86_64_linux.Machine -> m in univ(1) -> g in x86_64_linux.Reg -> h in x86_64_linux.Reg -> k in bits(32) ->
  runs(x86_64_linux.exec_body(len, tag(89, pair(8, pair(g, pair(tag(0, h), pair(z1, pair(z2, k))))))), m, o) ->
  ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", bits_add(64, m.rip, len)), "flags", f), "gpr",
    fn_update(m.gpr, g, bits_add(64, int_mul(sint(64, m.gpr[h]), sint(32, k)), 0))), empty)
proof
  fix m o g h z1 z2 k len
  assume hM hu hg hh hk hr
  have pt := apply(x86i.parts, hM)
  show by defs(simp(hr, hu, pt, apply(x86i.reg_typed, hM, hg), apply(x86i.reg_typed, hM, hh), hk, x86i.bool_univ), x86i.flags_ok)
qed

// (the signed product by a positive 32-bit immediate: the word product)
theorem tr.imul64_by: all u k. u in bits(64) -> k in bits(32) -> int_lt(k, 2147483648) -> bits_add(64, int_mul(sint(64, u), sint(32, k)), 0) = bits_mul(64, u, k)
proof
  fix u k
  assume hu hk hl
  have sk: sint(32, k) = k by defs(simp(hk, hl), sint)
  have c1: int_lt(u, 9223372036854775808) -> bits_add(64, int_mul(sint(64, u), k), 0) = bits_mul(64, u, k) proof
    assume h
    show by defs(simp(hu, h), bits_add, bits_mul, sint)
  qed
  have c2: !int_lt(u, 9223372036854775808) -> bits_add(64, int_mul(sint(64, u), k), 0) = bits_mul(64, u, k) proof
    assume h
    have eg: int_mod(int_mul(int_sub(u, 18446744073709551616), k), 18446744073709551616) = int_mod(int_mul(u, k), 18446744073709551616) by arith(hu, hk)
    show by defs(simp(hu, h, eg), bits_add, bits_mul, sint)
  qed
  have c: bits_add(64, int_mul(sint(64, u), k), 0) = bits_mul(64, u, k) by taut(c1, c2)
  show by simp(sk, c)
qed

// imul r64, r64, imm32 (positive): g := u * k
theorem tr.imul64(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g h z1 z2 k u r hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a ->
    runs(x86_64_linux.exec_body(len, tag(89, pair(8, pair(g, pair(tag(0, h), pair(z1, pair(z2, k))))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> h in x86_64_linux.Reg -> k in bits(32) -> int_lt(k, 2147483648) -> h in dom(rs) -> rs[h] = pair(8, u) ->
  r = bits_mul(64, u, k) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs, g, pair(8, r)), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g h z1 z2 k u r hs ds rs p w
  assume hat ha2 hg hh hk hkl hd hu hr hpt0
  have hpt := rewrite(hr, hpt0)
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(m.gpr, g, bits_mul(64, u, k))), empty)) proof
    fix m o
    assume hi hr2 hhs hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rg u64 := apply(tr.regs_get, {m}, {rs}, {h}, {8}, {u}, hrs, hd, hu)
    have u64b: u in bits(64) by simp(u64)
    have mu := apply(tr.imul64_by, {u}, {k}, u64b, hk, hkl)
    have hx := mp(mp(mp(all_elim(hat, {m}, {o}), ho), ipC), hr2)
    obtain f, hf from apply(x86i.imul64_imm, {m}, {o}, {g}, {h}, {z1}, {z2}, {k}, {len}, ipM, ipU, gR, hh, hk, hx)
    show by ex_intro({f}, simp(hf, rg, mu, hr2, ha2, keep(x86i.flags_ok)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_mul(64, u, k) in bits(int_mul(8, 8)) && bits_mul(64, u, k) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {8}, {bits_mul(64, u, k)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// mov r64, [rsp + d] of a stack object's bytes (not a home): the spec's
// load there (pp + off its address as the spec has it)
theorem tr.load64_obj(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g d c z2 pp off r hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a ->
    runs(x86_64_linux.exec_body(len, tag(76, pair(8, pair(g, pair(tag(2, fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(2, 4)), "index", none), "scale", 1), "disp", d)),
      pair(tag(2, fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(2, 4)), "index", none), "scale", 1), "disp", d)), z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> d in bits(64) -> c = int_mod(int_sub(d, fr), 18446744073709551616) -> pp in bits(64) -> off in bits(32) ->
  tr.ha(s, c) = bits_add(64, pp, off) -> g.mem_defined(w, pp, off, 8, false) ->
  r = bits_of_int(64, gimple.bytes_at(w.vm, bits_add(64, pp, off), 8)) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs, g, pair(8, r)), p, w) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g d c z2 pp off r hs ds rs p w
  assume hat ha2 hg hd hc hp ho hA hdef hr hpt0
  have hpt := rewrite(hr, hpt0)
  let BY := bits_of_int(64, gimple.bytes_at(w.vm, bits_add(64, pp, off), 8))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(m.gpr, g, BY)), empty) proof
    fix m o
    assume hi0 hr2 hhs hrs hmm ho2
    have ipM ipU ipC .. := apply(tr.inv_parts, hi0)
    have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
    have fe := apply(tr.frame_ea, {s}, {base}, {code}, {fr}, {m}, {w}, {d}, {c}, {0}, hi0, hd, hc, simp())
    have ea: bits_add(64, int_add(m.gpr[4], d), 0) = bits_add(64, pp, off) := trans(fe, hA)
    have rd := apply(tr.reads, {s}, {m}, {w}, {v}, {pp}, {off}, {8}, hp, ho, hdef, hmm, simp())
    have ac := rewrite(sym(ea), rd.1)
    have hx := mp(all_elim(hat, {m}, {o}), ho2, ipC, hr2)
    have e := apply(x86i.load64_bd, {m}, {o}, {g}, {4}, {d}, {z2}, {len}, ipM, ipU, gR, (4 in x86_64_linux.Reg by simp()), hd, ac, hx)
    have lw := all_elim(tr.le_bytes, {w.vm}, {bits_add(64, pp, off)}, {8})
    show by simp(e, ea, rd.2, lw, hr2, ha2, keep(gimple.bytes_at, x86_64_linux.le))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> BY in bits(int_mul(8, 8)) && BY in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs, gimple.bytes_at))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0v[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {8}, {BY}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// (a branch on the flags of a step that also writes the register g, x:
// `sub r64, fs:[0x28]; je` -- as tr.branch)
theorem tr.branch_w(s, v, base, code, fr, a, a2, a3, t, cc, hs, ds, rs, p, w, g, x, f. ff, c, zb. bkp, zb pb wb. bka):
  (all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
    (ex f. x86i.flags_ok(m, f) && ff(f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(m.gpr, g, x)), empty))) ->
  (all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a2 -> runs(x86_64_linux.step(), m, o) ->
    o = ok(fn_update(m, "rip", ite(x86_64_linux.cond(m.flags, cc), t, a3)), empty)) ->
  (all m f. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> ff(f) -> (x86_64_linux.cond(f, cc) <-> !c)) ->
  (all m. m.rip = a2 -> !bkp(m)) -> a2 in bits(64) -> a3 in bits(64) -> t in bits(64) -> tr.scratch_reg(g) -> x in bits(64) ->
  (c -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a3, hs, ds, fn_update(rs, g, pair(8, x)), p, w)) ->
  (!c -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, t, hs, ds, fn_update(rs, g, pair(8, x)), p, w)) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  assume h1 h2 h3 hb2 ha2 ha3 ht hg hx pa pb
  let RS2 := fn_update(rs, g, pair(8, x))
  have g0: all m. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, ds) -> tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m) proof
    fix m
    assume hi hr hh hrs hmm hfr
    have nr := apply(tr.inv_nr, hi)
    let Q1(m2) := ex f. x86i.flags_ok(m, f) && ff(f) && m2 = fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(m.gpr, g, x))
    have st1: all o. runs(x86_64_linux.step(), m, o) -> (ex m2. o = ok(m2, empty) && Q1(m2)) proof
      fix o
      assume ho
      obtain f, hf from mp(all_elim(h1, {m}, {o}), hi, hr, hh, hrs, hmm, ho)
      have q1: Q1(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(m.gpr, g, x))) by ex_intro({f}, simp(hf, keep(x86i.flags_ok)))
      show by ex_intro({fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(m.gpr, g, x))}, taut(q1, hf))
    qed
    have post1: all m2. Q1(m2) -> tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m2) proof
      fix m2
      assume hq
      obtain f, hf from hq
      have fo: x86i.flags_ok(m, f) by taut(hf)
      have fff: ff(f) by taut(hf)
      have e: m2 = fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(m.gpr, g, x)) by taut(hf)
      let M2 := fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(m.gpr, g, x))
      have i2 := apply(tr.inv_reg, {s}, {base}, {code}, {fr}, {m}, {w}, {a2}, {f}, {g}, {x}, hi, ha2, fo, hg, hx)
      have hx8: x in bits(int_mul(8, 8)) by simp(hx)
      have rs1 := apply(tr.regs_set, {m}, {rs}, {g}, {8}, {x}, hrs, hx8)
      have rs2: tr.regs(M2, RS2) by defs(simp(expand(rs1, tr.regs)), tr.regs)
      have nr2: int_lt(M2.gpr[4], abi.sp(s)) by simp(apply(tr.inv_parts, i2).4, nr, apply(tr.inv_parts, hi).4)
      have k := mp(all_elim(h3, {m}, {f}), hi, hr, hh, hrs, fff)
      let Q2(m3) := m3 = fn_update(M2, "rip", ite(x86_64_linux.cond(f, cc), t, a3))
      have st2: all o. runs(x86_64_linux.step(), M2, o) -> (ex m3. o = ok(m3, empty) && Q2(m3)) proof
        fix o
        assume ho
        have r2: M2.rip = a2 by simp()
        have eo := mp(all_elim(h2, {M2}, {o}), i2, r2, ho)
        have fl: M2.flags = f by simp()
        have eo2 := rewrite(fl, eo)
        show by ex_intro({fn_update(M2, "rip", ite(x86_64_linux.cond(f, cc), t, a3))}, simp(eo2))
      qed
      have post2: all m3. Q2(m3) -> tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m3) proof
        fix m3
        assume e3
        have ca: c -> tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m3) proof
          assume hc
          have ec: m3 = fn_update(M2, "rip", a3) by simp(e3, k, hc)
          have i3 := mp(tr.inv_rip, {s}, {base}, {code}, {fr}, {M2}, {w}, {a3}, i2, ha3)
          have rs3: tr.regs(fn_update(M2, "rip", a3), RS2) by defs(simp(expand(rs2, tr.regs)), tr.regs)
          have r3: fn_update(M2, "rip", a3).rip = a3 by simp()
          have c3 := apply(tr.pt_regs[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], mp(pa, hc), i3, r3, rs3, hh, hmm, hfr, simp(), simp())
          show := rewrite(sym(ec), c3)
        qed
        have cb: !c -> tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m3) proof
          assume hc
          have ec: m3 = fn_update(M2, "rip", t) by simp(e3, k, hc)
          have i3 := mp(tr.inv_rip, {s}, {base}, {code}, {fr}, {M2}, {w}, {t}, i2, ht)
          have rs3: tr.regs(fn_update(M2, "rip", t), RS2) by defs(simp(expand(rs2, tr.regs)), tr.regs)
          have r3: fn_update(M2, "rip", t).rip = t by simp()
          have c3 := apply(tr.pt_regs[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], mp(pb, hc), i3, r3, rs3, hh, hmm, hfr, simp(), simp())
          show := rewrite(sym(ec), c3)
        qed
        show by taut(ca, cb)
      qed
      have sm := mp(tr.step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb), s := s, v := v, p := p, w := w, m := M2, q := x. Q2(x)], st2, nr2, post2)
      have rm2: M2.rip = a2 by simp()
      have cm := apply(tr.sim_cl[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {p}, {w}, {M2}, nr2, mp(all_elim(hb2, {M2}), rm2), sm)
      show := rewrite(sym(e), cm)
    qed
    show := mp(tr.step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb), s := s, v := v, p := p, w := w, m := m, q := x. Q1(x)], st1, nr, post1)
  qed
  show by defs(g0, tr.lv)
qed

// (as tr.jcc: the jump after such a step)
theorem tr.jcc_w(f. ff, zb. bkp, zb pb wb. bka): all s v base code fr a a2 a3 t len2 jn jw cc r c hs ds rs p w g x.
  (all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
    (ex f. x86i.flags_ok(m, f) && ff(f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(m.gpr, g, x)), empty))) ->
  (all f. ff(f) -> (x86_64_linux.cond(f, cc) <-> !c)) ->
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a2 ->
    runs(x86_64_linux.exec_body(len2, tag(jn, pair(cc, r))), m, o)) ->
  a3 = bits_add(64, a2, len2) -> t = bits_add(64, a3, bits_sext(jw, 64, r)) -> (jn = 127 && jw = 8) || (jn = 128 && jw = 32) ->
  a2 in bits(64) -> cc in bits(4) -> r in bits(32) -> tr.scratch_reg(g) -> x in bits(64) ->
  (all m. m.rip = a2 -> !bkp(m)) -> (c -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a3, hs, ds, fn_update(rs, g, pair(8, x)), p, w)) ->
  (!c -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, t, hs, ds, fn_update(rs, g, pair(8, x)), p, w)) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 a3 t len2 jn jw cc r c hs ds rs p w g x
  assume h1 hcc hat2 ha3 hta hjw ha2 hc4 hr8 hg hx hb2 pa pb
  have h2: all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a2 -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(m, "rip", ite(x86_64_linux.cond(m.flags, cc), t, a3)), empty) proof
    fix m o
    assume hi hr ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have hx2 := mp(all_elim(hat2, {m}, {o}), ho, ipC, hr)
    have e := apply(x86i.jcc, {m}, {o}, {cc}, {r}, {len2}, {jn}, {jw}, ipM, ipU, hc4, hr8, hjw, hx2)
    show by simp(e, hr, ha3, hta)
  qed
  have h3: all m f. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> ff(f) -> (x86_64_linux.cond(f, cc) <-> !c) proof
    fix m f
    assume hi hr hh hrs hf
    show := mp(all_elim(hcc, {f}), hf)
  qed
  have ha3b: a3 in bits(64) by simp(ha3)
  have htb: t in bits(64) by simp(hta)
  show := mp(tr.branch_w[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb), s := s, v := v, base := base, code := code, fr := fr, a := a, a2 := a2, a3 := a3, t := t, cc := cc, hs := hs, ds := ds, rs := rs, p := p, w := w,
    g := g, x := x, ff := f. ff(f), c := c], h1, h2, h3, hb2, ha2, ha3b, htb, hg, hx, pa, pb)
qed

// sub r64, qword fs:[d] (REX.W 64 2B /r): g := g - the thread's word at
// d, the flags of the subtraction
theorem x86i.subf64_fs: all m o g d z len. m in x86_64_linux.Machine -> m in univ(1) -> g in x86_64_linux.Reg -> d in bits(64) ->
  x86i.acc(m, bits_add(64, int_add(m.fs_base, d), 0), 8, 0) ->
  runs(x86_64_linux.exec_body(len, tag(51, pair(8, pair(g, pair(x86i.fs_mem(d), pair(x86i.fs_mem(d), z)))))), m, o) ->
  ex f. x86i.flags_ok(m, f) && x86i.subf(64, m.gpr[g], x86_64_linux.le(m.vm.bytes, bits_add(64, int_add(m.fs_base, d), 0), 8), f) &&
    o = ok(fn_update(fn_update(fn_update(m, "rip", bits_add(64, m.rip, len)), "flags", f), "gpr",
      fn_update(m.gpr, g, bits_sub(64, m.gpr[g], x86_64_linux.le(m.vm.bytes, bits_add(64, int_add(m.fs_base, d), 0), 8)))), empty)
proof
  fix m o g d z len
  assume hM hu hg hd a0 hr
  have pt := apply(x86i.parts, hM)
  have fb: m.fs_base in bits(64) by simp(expand(hM, x86_64_linux.Machine))
  have k0: all j. j in omega -> int_lt(j, 8) -> x86_64_linux.canonical(bits_add(64, bits_add(64, int_add(m.fs_base, d), 0), bits_of_int(64, j))) proof
    fix j
    assume j1 j2
    show by mp(all_elim(all_elim(all_elim(x86.access_canonical, {m.vm}), {bits_add(64, bits_add(64, int_add(m.fs_base, d), 0), bits_of_int(64, j))}), {0}), mp(mp(all_elim(a0, {j}), j1), j2))
  qed
  show by defs(simp(hr, hu, pt, hd, fb, apply(x86i.reg_typed, hM, hg), a0, k0, x86.touch_range_access, x86i.bool_univ, keep(x86_64_linux.touch_range, x86_64_linux.can_access)), x86i.flags_ok, x86i.subf)
qed

// (the step: the register's u less the spec's word y at the world's
// fs_base + d, defined there)
theorem tr.fsub64_fs: all s v base code fr a a2 len g d z u y hs rs w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a ->
    runs(x86_64_linux.exec_body(len, tag(51, pair(8, pair(g, pair(x86i.fs_mem(d), pair(x86i.fs_mem(d), z)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> g in x86_64_linux.Reg -> g in dom(rs) -> rs[g] = pair(8, u) -> d in bits(32) ->
  g.mem_defined(w, w.fs_base, d, 8, false) -> y = bits_of_int(64, gimple.bytes_at(w.vm, bits_add(64, w.fs_base, d), 8)) ->
  all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
    (ex f. x86i.flags_ok(m, f) && x86i.subf(64, u, y, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(m.gpr, g, bits_sub(64, u, y))), empty))
proof
  fix s v base code fr a a2 len g d z u y hs rs w
  assume hat ha2 hg hgd hgu hd hdef hy
  fix m o
  assume hi hr hhs hrs hmm ho
  have ipM ipU ipC .. := apply(tr.inv_parts, hi)
  have mf := hi.mfs
  have fb: m.fs_base in bits(64) by simp(expand(ipM, x86_64_linux.Machine))
  have wf: w.fs_base in bits(64) by simp(rewrite(mf, fb))
  have d64: d in bits(64) by simp(hd)
  have ea: bits_add(64, int_add(m.fs_base, d), 0) = bits_add(64, w.fs_base, d) by simp(mf, wf, d64)
  have rd := apply(tr.reads, {s}, {m}, {w}, {v}, {w.fs_base}, {d}, {8}, wf, hd, hdef, hmm, simp())
  have ac := rewrite(sym(ea), rd.1)
  have rg := apply(tr.regs_get, {m}, {rs}, {g}, {8}, {u}, hrs, hgd, hgu)
  have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
  obtain f, hf from apply(x86i.subf64_fs, {m}, {o}, {g}, {d}, {z}, {len}, ipM, ipU, hg, d64, ac, hx)
  have lw := all_elim(tr.le_bytes, {w.vm}, {bits_add(64, w.fs_base, d)}, {8})
  show by ex_intro({f}, simp(hf, ea, rd.2, lw, rg, hy, hr, ha2, keep(x86i.flags_ok, x86i.subf, gimple.bytes_at, x86_64_linux.le)))
qed

// ---------------------------------------------------------------------
//  The stack protector's word (fs:0x28): the ABI's, hidden from the world
//  -- the machine's loads of it read the entry's word, readable there

// the entry's word
abbrev tr.canv(s) := x86_64_linux.le(s.vm.bytes, bits_add(64, int_add(s.fs_base, 40), 0), 8)

// (at a point of the function: the word readable, the entry's)
theorem tr.canary_read: all s base code fr m w v. tr.inv(s, base, code, fr, m, w) -> tr.mem(s, m, w, v) ->
  x86i.acc(m, bits_add(64, int_add(m.fs_base, 40), 0), 8, 0) && x86_64_linux.le(m.vm.bytes, bits_add(64, int_add(m.fs_base, 40), 0), 8) = tr.canv(s)
proof
  fix s base code fr m w v
  assume hi hmm
  have {mfs0} := hi
  have {cok} := hmm
  have hcan fsb := cok
  have fo: s.fs_base in omega by simp(fsb)
  let F := s.fs_base
  // (the i-th byte: its address F + 40 + i, the entry's page, mapped, readable, the entry's byte)
  have bi: all i. i in omega -> int_lt(i, 8) ->
      bits_add(64, bits_add(64, int_add(m.fs_base, 40), 0), bits_of_int(64, i)) = int_add(int_add(F, 40), i) &&
      x86_64_linux.can_access(m.vm, bits_add(64, bits_add(64, int_add(m.fs_base, 40), 0), bits_of_int(64, i)), 0) &&
      m.vm.bytes[bits_add(64, bits_add(64, int_add(m.fs_base, 40), 0), bits_of_int(64, i))] = s.vm.bytes[bits_add(64, bits_add(64, int_add(m.fs_base, 40), 0), bits_of_int(64, i))] proof
    fix i
    assume i1 i2
    let A := int_add(int_add(F, 40), i)
    have kp km := apply(tr.hid_pages, {s}, {m}, {w}, {v}, {i}, hmm, hcan, fsb, i1, i2)
    have ao: A in omega by arith(fo, i1)
    have al: int_lt(A, 18446744073709551616) by simp(expand(km, x86_64_linux.mapped, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE), ao)
    have ab: A in bits(64) by simp(ao, al)
    have ea: bits_add(64, bits_add(64, int_add(m.fs_base, 40), 0), bits_of_int(64, i)) = A by defs(arith(mfs0, fsb, fo, i1, i2, al), bits_add, bits_of_int, pow2)
    have l1: int_le(int_add(F, 40), A) by arith(fo, i1)
    have l2: int_lt(A, int_add(F, 48)) by arith(fo, i1, i2)
    have ac: A in abi.canary(F) by defs(taut(set_select_def[s := omega, p := x0. int_le(int_add(F, 40), x0) && int_lt(x0, int_add(F, 48)), z := A], ao, l1, l2), abi.canary)
    have _ _ _ kb := apply(tr.hid_at, {s}, {m}, {w}, {v}, {A}, hmm, hcan, fsb, ab, ac)
    have cr _ := expand(hcan, abi.canary_ok)
    have rd := mp(all_elim(expand(cr, x86_64_linux.readable), {i}), i1, i2)
    have pr: snd(m.vm.pages[int_div(A, x86_64_linux.PAGE)]).prot.r := rewrite(sym(kp), rd.2)
    have ca: x86_64_linux.can_access(m.vm, A, 0) by defs(simp(km, pr, keep(x86_64_linux.mapped)), x86_64_linux.can_access, x86_64_linux.page_of, x86_64_linux.hw_allows, x86_64_linux.accessible)
    show by simp(ea, ca, kb)
  qed
  have acc: x86i.acc(m, bits_add(64, int_add(m.fs_base, 40), 0), 8, 0) proof
    fix i
    assume i1 i2
    show := mp(all_elim(bi, {i}), i1, i2).2
  qed
  have by: all k. k in omega -> int_lt(k, 8) -> m.vm.bytes[bits_add(64, bits_add(64, int_add(m.fs_base, 40), 0), bits_of_int(64, k))] =
      s.vm.bytes[bits_add(64, bits_add(64, int_add(m.fs_base, 40), 0), bits_of_int(64, k))] proof
    fix k
    assume k1 k2
    show := mp(all_elim(bi, {k}), k1, k2).3
  qed
  have ls := apply(tr.le_same, {m.vm.bytes}, {s.vm.bytes}, {bits_add(64, int_add(m.fs_base, 40), 0)}, {8}, simp(), by)
  have e2: x86_64_linux.le(s.vm.bytes, bits_add(64, int_add(m.fs_base, 40), 0), 8) = tr.canv(s) by simp(mfs0)
  show := conj(acc, trans(ls, e2))
qed

// mov r64, fs:[40]: g := the entry's stack protector's word
theorem tr.load64_can(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g z2 hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a ->
    runs(x86_64_linux.exec_body(len, tag(76, pair(8, pair(g, pair(x86i.fs_mem(40), pair(x86i.fs_mem(40), z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs, g, pair(8, tr.canv(s))), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g z2 hs ds rs p w
  assume hat ha2 hg hpt
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(m.gpr, g, tr.canv(s))), empty) proof
    fix m o
    assume hi hr hhs hrs hmm ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
    have ac le := apply(tr.canary_read, {s}, {base}, {code}, {fr}, {m}, {w}, {v}, hi, hmm)
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    have e := apply(x86i.load64_fs, {m}, {o}, {g}, {40}, {z2}, {len}, ipM, ipU, gR, (40 in bits(64) by simp()), ac, hx)
    show by simp(e, le, hr, ha2, keep(x86_64_linux.le))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.canv(s) in bits(int_mul(8, 8)) && tr.canv(s) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs, x86_64_linux.le))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0v[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {8}, {tr.canv(s)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// (the step of sub r64, fs:[40]: the register's u less the entry's word)
theorem tr.fsub64_can: all s v base code fr a a2 len g z u hs rs w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a ->
    runs(x86_64_linux.exec_body(len, tag(51, pair(8, pair(g, pair(x86i.fs_mem(40), pair(x86i.fs_mem(40), z)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> g in x86_64_linux.Reg -> g in dom(rs) -> rs[g] = pair(8, u) ->
  all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
    (ex f. x86i.flags_ok(m, f) && x86i.subf(64, u, tr.canv(s), f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(m.gpr, g, bits_sub(64, u, tr.canv(s)))), empty))
proof
  fix s v base code fr a a2 len g z u hs rs w
  assume hat ha2 hg hgd hgu
  fix m o
  assume hi hr hhs hrs hmm ho
  have ipM ipU ipC .. := apply(tr.inv_parts, hi)
  have ac le := apply(tr.canary_read, {s}, {base}, {code}, {fr}, {m}, {w}, {v}, hi, hmm)
  have rg := apply(tr.regs_get, {m}, {rs}, {g}, {8}, {u}, hrs, hgd, hgu)
  have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
  obtain f, hf from apply(x86i.subf64_fs, {m}, {o}, {g}, {40}, {z}, {len}, ipM, ipU, hg, (40 in bits(64) by simp()), ac, hx)
  show by ex_intro({f}, simp(hf, le, rg, hr, ha2, keep(x86i.flags_ok, x86i.subf, x86_64_linux.le)))
qed

// xor r/m32, r32 (31 /r), both registers
theorem x86i.xor32_rr: all m o g h len. m in x86_64_linux.Machine -> m in univ(1) -> g in x86_64_linux.Reg -> h in x86_64_linux.Reg ->
  runs(x86_64_linux.exec_body(len, tag(53, pair(4, pair(h, pair(tag(0, g), pair(tag(0, g), tag(0, h))))))), m, o) ->
  ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", bits_add(64, m.rip, len)), "flags", f), "gpr",
    fn_update(m.gpr, g, bits_xor(32, bits_slice(m.gpr[g], 31, 0), bits_slice(m.gpr[h], 31, 0)))), empty)
proof
  fix m o g h len
  assume hM hu hg hh hr
  have pt := apply(x86i.parts, hM)
  show by defs(simp(hr, hu, pt, apply(x86i.reg_typed, hM, hg), apply(x86i.reg_typed, hM, hh), x86i.bool_univ), x86i.flags_ok)
qed

// xor r32, r32 of one register: g := 0
theorem tr.xor32_self(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a ->
    runs(x86_64_linux.exec_body(len, tag(53, pair(4, pair(g, pair(tag(0, g), pair(tag(0, g), tag(0, g))))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs, g, pair(4, 0)), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g hs ds rs p w
  assume hat ha2 hg hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(m.gpr, g, 0)), empty)) proof
    fix m o
    assume hi hr hh0 hrs ho
    have ip := apply(tr.inv_parts, hi)
    have hx2 := mp(mp(mp(all_elim(hat, {m}, {o}), ho), taut(ip)), hr)
    obtain f, hf from apply(x86i.xor32_rr, {m}, {o}, {g}, {g}, {len}, taut(ip), taut(ip), gR, gR, hx2)
    have z := all_elim(bits_xor_self, {32}, {bits_slice(m.gpr[g], 31, 0)})
    have z0: bits_xor(32, bits_slice(m.gpr[g], 31, 0), bits_slice(m.gpr[g], 31, 0)) = 0 := mp(z, (32 in omega by arith()))
    show by ex_intro({f}, simp(hf, z0, hr, ha2, keep(x86i.flags_ok)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      0 in bits(int_mul(8, 4)) && 0 in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {0}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// ----------------------------------------------------------------------
//  The CFG entered within its first block: the first iteration walked from
//  a point a0 inside it (after the stack object's allocation, which the
//  block's code makes) up to the labels' cut points, the CFG from there.
//  a0 is a cut point too (no walk reaches it), its claim the start's.

// (a weaker arrival: the same claim)
theorem tr.arr_ar(zb. bkp, zb pb wb. bka, zb pb wb. bka2): all s v m p w. (all z p2 w2. bka(z, p2, w2) -> bka2(z, p2, w2)) ->
  tr.arr(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, m, p, w) -> tr.arr(s, zb. bkp(zb), zb pb wb. bka2(zb, pb, wb), v, m, p, w)
proof
  fix s v m p w
  assume hm ha
  have r1 r2 := expand(ha, tr.arr)
  have g: !tr.out(s, m) -> bkp(m) -> (ex p2 w2. tr.red(p, w, p2, w2) && bka2(m, p2, w2)) proof
    assume h1 h2
    obtain p2 w2, hr hb from mp(r2, h1, h2)
    show by ex_intro({p2}, {w2}, taut(hr, mp(all_elim(hm, {m}, {p2}, {w2}), hb)))
  qed
  show by defs(taut(r1, g), tr.arr)
qed

theorem tr.sim_ar(zb. bkp, zb pb wb. bka, zb pb wb. bka2): all s v p w m. (all z p2 w2. bka(z, p2, w2) -> bka2(z, p2, w2)) ->
  tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m) -> tr.sim(s, zb. bkp(zb), zb pb wb. bka2(zb, pb, wb), v, p, w, m)
proof
  fix s v p w m
  assume hm hs
  have g: all o. tr.run_k(s, zb. bkp(zb), m, o) -> tr.gk(s, zb. bkp(zb), zb pb wb. bka2(zb, pb, wb), v, p, w, o) proof
    fix o
    assume hr
    have gk := mp(all_elim(expand(hs, tr.sim), {o}), hr)
    have c: (ex m1. o = ok(m1, empty) && tr.arr(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, m1, p, w)) ->
        (ex m1. o = ok(m1, empty) && tr.arr(s, zb. bkp(zb), zb pb wb. bka2(zb, pb, wb), v, m1, p, w)) proof
      assume e
      obtain m1, eo ar from e
      have ar2 := apply(tr.arr_ar[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb), bka2 := zb pb wb. bka2(zb, pb, wb)], {s}, {v}, {m1}, {p}, {w}, hm, ar)
      show by ex_intro({m1}, taut(eo, ar2))
    qed
    show by defs(taut(expand(gk, tr.gk), c), tr.gk)
  qed
  show by defs(g, tr.sim)
qed

theorem tr.cfg_lvk_st(s, v, base, code, fr, fd, rc, a. ct, c. ad, y. hs, y. yt, c. kk, z. bkp, z p w. bka, l o. b, l. tr, x8 x1. k, x3 x4 x2. kw, a0, hs0, rs0):
  (all t. k(diverge(t), diverge(t))) -> (all l. l in univ(1) -> tr(l) in univ(1)) ->
  (all c. kk(c) -> ct(ad(c))) -> (all z c. kk(c) -> z.rip = ad(c) -> !bkp(z)) ->
  (all c. kk(c) -> (all ys w. pair(w, pair(c, ys)) in univ(1) -> yt(pair(c, ys)) -> w in abi.World && w in univ(1) ->
    tr.lv(s, z. tr.cut(s, fr, a. ct(a), z) || bkp(z),
      z p2 w2. tr.cut(s, fr, a. ct(a), z) && (ex y2. (tr.inv(s, base, code, fr, z, w2) && z.rip = ad(fst(y2)) && tr.homes(s, z, hs(y2)) && tr.regs(z, rc) &&
        tr.mem(s, z, w2, v) && tr.frame(s, z, fd) && pair(w2, y2) in univ(1) && tr.cyt(y. yt(y), c. kk(c), y2)) && runs(p2, w2, ok(w2, pair(18446744073709551616, y2)))),
      v, base, code, fr, ad(c), hs(pair(c, ys)), fd, rc,mkprog(x1 x2. bind_rel(tr.liter(pair(c, ys), l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), x1, x3 x4. x2 = ok(x3, x4), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w))) ->
  ct(a0) -> (all z. z.rip = a0 -> !bkp(z)) ->
  all y0 w0. pair(w0, y0) in univ(1) ->
    tr.lv(s, z. tr.cut(s, fr, a. ct(a), z) || bkp(z),
      z p2 w2. tr.cut(s, fr, a. ct(a), z) && (ex y2. (tr.inv(s, base, code, fr, z, w2) && z.rip = ad(fst(y2)) && tr.homes(s, z, hs(y2)) && tr.regs(z, rc) &&
        tr.mem(s, z, w2, v) && tr.frame(s, z, fd) && pair(w2, y2) in univ(1) && tr.cyt(y. yt(y), c. kk(c), y2)) && runs(p2, w2, ok(w2, pair(18446744073709551616, y2)))),
      v, base, code, fr, a0, hs0, fd, rs0, tr.lone(y0, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w0) ->
    tr.lv(s, z. bkp(z), z p w. bka(z, p, w), v, base, code, fr, a0, hs0, fd, rs0, tr.lprog(y0, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w0)
proof
  assume hk2 htr hct hbo hb hct0 hbo0
  fix y0 w0
  assume hu0 hst
  let YT(y) := tr.cyt(y. yt(y), c. kk(c), y)
  let Q(x, y, w) := tr.inv(s, base, code, fr, x, w) && x.rip = ad(fst(y)) && tr.homes(s, x, hs(y)) && tr.regs(x, rc) && tr.mem(s, x, w, v) && tr.frame(s, x, fd) && pair(w, y) in univ(1) && YT(y)
  let Q0(x, y, w) := tr.inv(s, base, code, fr, x, w) && x.rip = a0 && tr.homes(s, x, hs0) && tr.regs(x, rs0) && tr.mem(s, x, w, v) && tr.frame(s, x, fd) && y = y0 && w = w0
  let QQ(x, y, w) := Q(x, y, w) || Q0(x, y, w)
  let C(z) := tr.cut(s, fr, a. ct(a), z)
  let AR(z, p2, w2) := C(z) && (ex y2. Q(z, y2, w2) && runs(p2, w2, ok(w2, pair(18446744073709551616, y2))))
  let AR2(z, p2, w2) := C(z) && (ex y2. QQ(z, y2, w2) && runs(p2, w2, ok(w2, pair(18446744073709551616, y2))))
  have arw: all z p2 w2. AR(z, p2, w2) -> AR2(z, p2, w2) proof
    fix z p2 w2
    assume h
    have hc he := h
    obtain y2, hy2 from he
    have q2: QQ(z, y2, w2) && runs(p2, w2, ok(w2, pair(18446744073709551616, y2))) by taut(hy2)
    have e2: ex y3. QQ(z, y3, w2) && runs(p2, w2, ok(w2, pair(18446744073709551616, y3))) by ex_intro({y2}, taut(q2))
    show by taut(hc, e2)
  qed
  // (the labels' claims, as tr.cfg_lvk has them)
  have hb2: all y w. pair(w, y) in univ(1) -> YT(y) -> w in abi.World && w in univ(1) ->
      tr.lv(s, z. C(z) || bkp(z), z p2 w2. AR(z, p2, w2), v, base, code, fr, ad(fst(y)), hs(y), fd, rc, tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w) proof
    fix y w
    assume hu hy hw
    obtain c ys, e kc yc from expand(hy, tr.cyt)
    have hu2: pair(w, pair(c, ys)) in univ(1) := rewrite(e, hu)
    have l := mp(all_elim(mp(all_elim(hb, {c}), kc), {ys}, {w}), hu2, yc, hw)
    have ef: fst(y) = c by simp(e)
    have l2 := subst({x. tr.lv(s, z. C(z) || bkp(z), z p2 w2. AR(z, p2, w2), v, base, code, fr, ad(x), hs(pair(c, ys)), fd, rc,
        mkprog(x1 x2. bind_rel(tr.liter(pair(c, ys), l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), x1, x3 x4. x2 = ok(x3, x4), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w)}, sym(ef), l)
    have l3 := rewrite(sym(e), l2)
    show by defs(l3, tr.lone)
  qed
  have hq: all x y w. QQ(x, y, w) -> C(x) && !bkp(x) && !tr.out(s, x) && w in univ(1) && pair(w, y) in univ(1) proof
    fix x y w
    assume q
    have c1: Q(x, y, w) -> C(x) && !bkp(x) && !tr.out(s, x) && w in univ(1) && pair(w, y) in univ(1) proof
      assume q1
      have hi hr hh hg hm hf hu hy := q1
      obtain c ys, e kc yc from expand(hy, tr.cyt)
      have ef: fst(y) = c by simp(e)
      have rspm := apply(tr.inv_parts, hi).4
      have ca: ct(x.rip) := rewrite(sym(rewrite(ef, hr)), mp(all_elim(hct, {c}), kc))
      have cc: C(x) by defs(taut(ca, rspm), tr.cut)
      have nb := mp(all_elim(hbo, {x}, {c}), kc, rewrite(ef, hr))
      have nr := apply(tr.inv_nr, hi)
      have wu := hi.wu
      show by taut(cc, nb, nr, wu, hu)
    qed
    have c2: Q0(x, y, w) -> C(x) && !bkp(x) && !tr.out(s, x) && w in univ(1) && pair(w, y) in univ(1) proof
      assume q0
      have hi hr hh hg hm hf ey ew := q0
      have rspm := apply(tr.inv_parts, hi).4
      have ca: ct(x.rip) := rewrite(sym(hr), hct0)
      have cc: C(x) by defs(taut(ca, rspm), tr.cut)
      have nb := mp(all_elim(hbo0, {x}), hr)
      have nr := apply(tr.inv_nr, hi)
      have wu := hi.wu
      have pu: pair(w, y) in univ(1) := rewrite(sym(ey), rewrite(sym(ew), hu0))
      show by taut(cc, nb, nr, wu, pu)
    qed
    show by taut(q, c1, c2)
  qed
  have hnr: all x y w m. QQ(x, y, w) -> C(m) -> !tr.out(s, m) proof
    fix x y w m
    assume q hc
    have hi: tr.inv(s, base, code, fr, x, w) by taut(q)
    show := apply(tr.cut_nret[s := s, base := base, code := code, fr := fr, ct := a. ct(a)], {x}, {w}, {m}, hi, hc)
  qed
  have hbq: all x y w. QQ(x, y, w) -> tr.sim(s, z. C(z) || bkp(z), z p2 w2. AR2(z, p2, w2), v, tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w, x) proof
    fix x y w
    assume q
    have c1: Q(x, y, w) -> tr.sim(s, z. C(z) || bkp(z), z p2 w2. AR2(z, p2, w2), v, tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w, x) proof
      assume q1
      have hi hr hh hg hm hf hu hy := q1
      have l := mp(all_elim(hb2, {y}, {w}), hu, hy, conj(hi.wW, hi.wu))
      have sm := mp(all_elim(expand(l, tr.lv), {x}), hi, hr, hh, hg, hm, hf)
      show := apply(tr.sim_ar[bkp := z. C(z) || bkp(z), bka := z p2 w2. AR(z, p2, w2), bka2 := z p2 w2. AR2(z, p2, w2)], {s}, {v}, {tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2))}, {w}, {x}, arw, sm)
    qed
    have c2: Q0(x, y, w) -> tr.sim(s, z. C(z) || bkp(z), z p2 w2. AR2(z, p2, w2), v, tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w, x) proof
      assume q0
      have hi hr hh hg hm hf ey ew := q0
      have hi0 := rewrite(ew, hi)
      have hm0 := rewrite(ew, hm)
      have sm := mp(all_elim(expand(hst, tr.lv), {x}), hi0, hr, hh, hg, hm0, hf)
      have sm2 := apply(tr.sim_ar[bkp := z. C(z) || bkp(z), bka := z p2 w2. AR(z, p2, w2), bka2 := z p2 w2. AR2(z, p2, w2)], {s}, {v}, {tr.lone(y0, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2))}, {w0}, {x}, arw, sm)
      have sm3 := subst({u. tr.sim(s, z. C(z) || bkp(z), z p2 w2. AR2(z, p2, w2), v, tr.lone(u, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w0, x)}, sym(ey), sm2)
      show := subst({u. tr.sim(s, z. C(z) || bkp(z), z p2 w2. AR2(z, p2, w2), v, tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), u, x)}, sym(ew), sm3)
    qed
    show by taut(q, c1, c2)
  qed
  have lp := mp(tr.loop_cut[s := s, v := v, hp := z. C(z), bp := z. bkp(z), ar := z p w. bka(z, p, w), b := l o. b(l, o), tr := l. tr(l), k := x8 x1. k(x8, x1),
    kw := x3 x4 x2. kw(x3, x4, x2), q := x y w. QQ(x, y, w)], hq, hnr, hk2, htr, hbq)
  have g: all m. tr.inv(s, base, code, fr, m, w0) -> m.rip = a0 -> tr.homes(s, m, hs0) -> tr.regs(m, rs0) -> tr.mem(s, m, w0, v) -> tr.frame(s, m, fd) ->
      tr.sim(s, z. bkp(z), z p w. bka(z, p, w), v, tr.lprog(y0, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w0, m) proof
    fix m
    assume hi hr hh hg hm hf
    have q: QQ(m, y0, w0) by taut(hi, hr, hh, hg, hm, hf, refl({y0}), refl({w0}))
    show := mp(all_elim(lp, {m}, {y0}, {w0}), q)
  qed
  show by defs(g, tr.lv)
qed

// ----------------------------------------------------------------------
//  A call from a function with stack objects (`call_objs(objs, g, args)`,
//  readable GIMPLE's): the call itself, its outcome the bind's

theorem tr.bind_callobjs(objs, g, l, x9 x10. a, x9 x10. xx, x9. dd): all w. bind_rel(gimple.call(g, l), w, x9 x10. a(x9, x10), x9 x10. xx(x9, x10), x9. dd(x9)) ->
  bind_rel(gimple.call_objs(objs, g, l), w, x9 x10. a(x9, x10), x9 x10. xx(x9, x10), x9. dd(x9))
proof
  fix w
  assume h
  obtain x, hr hk from expand(h, bind_rel)
  have k1: (ex s1 v1. x = ok(s1, v1) && a(s1, v1)) -> (ex s1 v1. x = ok(s1, v1) && x = ok(s1, v1)) proof
    assume e
    obtain s1 v1, e1 from e
    show by ex_intro({s1}, {v1}, taut(e1))
  qed
  have k2: (ex s1 e0. x = exc(s1, e0) && xx(s1, e0)) -> (ex s1 e0. x = exc(s1, e0) && x = exc(s1, e0)) proof
    assume e
    obtain s1 e0, e1 from e
    show by ex_intro({s1}, {e0}, taut(e1))
  qed
  have k3: (ex t. x = diverge(t) && dd(t)) -> (ex t. x = diverge(t) && x = diverge(t)) proof
    assume e
    obtain t, e1 from e
    show by ex_intro({t}, taut(e1))
  qed
  have sh: (ex s1 v1. x = ok(s1, v1) && x = ok(s1, v1)) || (ex s1 e0. x = exc(s1, e0) && x = exc(s1, e0)) || (ex t. x = diverge(t) && x = diverge(t)) by taut(hk, k1, k2, k3)
  have bc: bind_rel(gimple.call(g, l), w, x2 x3. x = ok(x2, x3), x2 x3. x = exc(x2, x3), x2. x = diverge(x2)) by defs(ex_intro({x}, taut(hr, sh)), bind_rel)
  have pu := apply(g.runs_univ, expand(hr, gimple.call))
  have rc: runs(gimple.call_objs(objs, g, l), w, x) by defs(apply(tr.runs_intro[r := x0 x1. bind_rel(gimple.call(g, l), x0, x2 x3. x1 = ok(x2, x3), x2 x3. x1 = exc(x2, x3), x2. x1 = diverge(x2))], {w}, {x}, pu, bc), gimple.call_objs)
  show by defs(ex_intro({x}, taut(rc, hk)), bind_rel)
qed

theorem tr.qs_callobjs(objs, g, l, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k): all w o.
  runs(mkprog(x0 x1. ex x8. bind_rel(gimple.call(g, l), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), w, o) ->
  runs(mkprog(x0 x1. ex x8. bind_rel(gimple.call_objs(objs, g, l), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), w, o)
proof
  fix w o
  assume hr
  have pu := apply(g.runs_univ, hr)
  obtain y, hb hk from apply(g.runs_elim, hr)
  have b2 := apply(tr.bind_callobjs[objs := objs, g := g, l := l, a := x9 x10. a(x9, x10, y), xx := x9 x10. xx(x9, x10, y), dd := x9. dd(x9, y)], {w}, hb)
  have e: ex x8. bind_rel(gimple.call_objs(objs, g, l), w, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, o) by ex_intro({y}, taut(b2, hk))
  show := apply(tr.runs_intro[r := x0 x1. ex x8. bind_rel(gimple.call_objs(objs, g, l), x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)], {w}, {o}, pu, e)
qed

// ----------------------------------------------------------------------
//  The return with the frame's objects released: the wrapper's last part
//  (`objs := objs0`, the result's cast, rdx any) to the world with the
//  objects O, its memory the same

theorem tr.result64_objs: all w V O. O in univ(1) -> w in univ(1) -> V in bits(int_mul(8, 8)) -> (all y. y in bits(64) ->
  runs(mkprog(x1 x2. letin(V, x3. letin(fn_update(x1, "objs", O), x4. bind_rel(gimple.result(64, x3), x4,
    x5 x6. any_rel(x7. x7 in bits(64), x7. x2 = ok(x5, pair(x6, x7))), x5 x6. x2 = exc(x5, x6), x5. x2 = diverge(x5))))), w, ok(fn_update(w, "objs", O), pair(V, y))))
proof
  fix w V O
  assume ho hw hb
  fix y
  assume hy
  let W2 := fn_update(w, "objs", O)
  let R2 := ok(W2, pair(V, y))
  have b64: V in bits(64) by simp(hb)
  have w2u: W2 in univ(1) by simp(hw, ho)
  have ro := apply(g.result64_ok, {W2}, {V}, w2u, b64)
  have k: bind_rel(gimple.result(64, V), W2, x6 x7. any_rel(x8. x8 in bits(64), x8. R2 = ok(x6, pair(x7, x8))), x6 x7. R2 = exc(x6, x7), x6. R2 = diverge(x6))
    by defs(ex_intro({ok(W2, V)}, simp(ro, hy, keep(runs, gimple.result))), bind_rel)
  have b: letin(V, x3. letin(fn_update(w, "objs", O), x4. bind_rel(gimple.result(64, x3), x4,
      x5 x6. any_rel(x7. x7 in bits(64), x7. R2 = ok(x5, pair(x6, x7))), x5 x6. R2 = exc(x5, x6), x5. R2 = diverge(x5)))) by defs(k, letin)
  have pu: pair(w, R2) in univ(1) by simp(hw, w2u, b64, hy)
  show := apply(tr.runs_intro[r := x1 x2. letin(V, x3. letin(fn_update(x1, "objs", O), x4. bind_rel(gimple.result(64, x3), x4,
    x5 x6. any_rel(x7. x7 in bits(64), x7. x2 = ok(x5, pair(x6, x7))), x5 x6. x2 = exc(x5, x6), x5. x2 = diverge(x5))))], {w}, {R2}, pu, b)
qed

// (the world with the objects O: a world, its memory, I/O, thread pointer
// w's)
theorem tr.world_objs: all w O. w in abi.World -> w in univ(1) -> O in abi.Objs -> O in univ(1) ->
  fn_update(w, "objs", O) in abi.World && fn_update(w, "objs", O) in univ(1) && fn_update(w, "objs", O).vm = w.vm &&
  fn_update(w, "objs", O).os = w.os && fn_update(w, "objs", O).fs_base = w.fs_base && O in univ(1)
proof
  fix w O
  assume hW hu ho ou
  have wf := expand(hW, abi.World)
  have r1: fn_update(w, "objs", O) in abi.World by defs(simp(wf, ho, hu, ou), abi.World)
  have r2: fn_update(w, "objs", O) in univ(1) by simp(hu, ou)
  have e1: fn_update(w, "objs", O).vm = w.vm by simp()
  have e2: fn_update(w, "objs", O).os = w.os by simp()
  have e3: fn_update(w, "objs", O).fs_base = w.fs_base by simp()
  show by taut(r1, r2, e1, e2, e3, ou)
qed

// ret: as tr.ret_insn, the spec's result world w2 (w's memory, I/O and
// thread pointer; its objects the callers')
theorem tr.ret_insn_w(zb. bkp, zb pb wb. bka): all s v base code a len hs fd rs p w n bigv w2.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a -> runs(x86_64_linux.exec_body(len, tag(122, empty)), m, o)) ->
  0 in dom(rs) -> rs[0] = pair(n, bigv) -> tr.cs_rs(s, rs) ->
  w2 in abi.World -> w2 in univ(1) -> w2.vm = w.vm -> w2.os = w.os -> w2.fs_base = w.fs_base ->
  (w in univ(1) -> bigv in bits(int_mul(8, n)) -> (all y. y in bits(64) -> runs(p, w, ok(w2, pair(bigv, y))))) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, 0, a, hs, fd, rs, p, w)
proof
  fix s v base code a len hs fd rs p w n bigv w2
  assume hat h0d h0 hcs hW2 hu2 evm eos efs hsp
  have g: all m. tr.inv(s, base, code, 0, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, fd) -> tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m) proof
    fix m
    assume hi hr hhs hrs hmm hfr
    have {mM, mu, cd, kp, ra8, mcpu, mgs, mos, mfs, mfs0, mdf, wW, wu, sM, sacc, sal, slt} := hi
    have mcs := apply(tr.cs_of_rs, hrs, hcs)
    have rspm := apply(tr.inv0_rsp, hi)
    have rest: x86_64_linux.le(m.vm.bytes, s.gpr[4], 8) = abi.ret(s) && abi.callee_saved(m, s) && m.cpu = s.cpu && m.gs_base = s.gs_base &&
      m.os = w.os && m.fs_base = w.fs_base && !m.flags.df && w in abi.World && w in univ(1)
      := conj(ra8, mcs, mcpu, mgs, mos, mfs, mdf, wW, wu)
    have r4 := apply(x86i.rsp_typed, sM)
    have ra := apply(abi.ret_access, {s.vm}, {s.gpr[4]}, r4, sacc, sal)
    have acc: all j. j in omega -> int_lt(j, 8) -> x86_64_linux.can_access(m.vm, bits_add(64, m.gpr[4], bits_of_int(64, j)), 0) proof
      fix j
      assume j1 j2
      have c1 := mp(mp(all_elim(ra, {j}), j1), j2)
      have jr1 jr2 jr3 := apply(tr.ret_range, {s.gpr[4]}, {j}, r4, slt, j1, j2)
      have c3 := apply(tr.kept_acc, {s.vm}, {m.vm}, {s.gpr[4]}, {bits_add(64, s.gpr[4], bits_of_int(64, j))}, {0}, kp,
        jr1, jr2, jr3, c1)
      show by simp(c3, rspm)
    qed
    let M2 := fn_update(fn_update(m, "gpr", fn_update(m.gpr, 4, bits_add(64, m.gpr[4], 8))), "rip", x86_64_linux.le(m.vm.bytes, m.gpr[4], 8))
    have st: all o. runs(x86_64_linux.step(), m, o) -> (ex m2. o = ok(m2, empty) && m2 = M2) proof
      fix o
      assume ho
      have hx := mp(mp(mp(all_elim(hat, {m}, {o}), ho), cd), hr)
      have e := apply(x86i.ret, {m}, {o}, {len}, mM, mu, acc, hx)
      show by ex_intro({M2}, simp(e))
    qed
    have nr := apply(tr.inv_nr, hi)
    have post: all m2. m2 = M2 -> tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m2) proof
      fix m2
      assume e2
      have pt := apply(x86i.parts, mM)
      have r0 := apply(tr.regs_get, {m}, {rs}, {0}, {n}, {bigv}, hrs, h0d, h0)
      have r2R: 2 in x86_64_linux.Reg by simp()
      have r2t := mp(mp(all_elim(x86i.reg_typed, {m}, {2}), mM), r2R)
      have atr: tr.at_ret(s, M2) by simp(rest, rspm, r4)
      have lt: x86_64_linux.le(m.vm.bytes, m.gpr[4], 8) in bits(64) by simp()
      have m2M: M2 in x86_64_linux.Machine by defs(simp(expand(mM, x86_64_linux.Machine), mu, pt, lt, r4, rspm), x86_64_linux.Machine)
      have sp := mp(mp(hsp, wu), r0.2)
      have rr: runs(p, w, ok(w2, pair(M2.gpr[0], M2.gpr[2]))) by simp(sp, r0, r2t)
      have wm := apply(tr.mem_wm, {s}, {m}, {w}, {v}, hmm)
      have wm2: abi.world_matches(s.vm, M2.vm, w2.vm, abi.objs_at(v, s.fs_base), abi.sp(s)) by simp(wm, evm, keep(abi.world_matches, abi.objs_at))
      have e3 := mp(app_update_other[f := m.gpr, k := 4, v := bits_add(64, m.gpr[4], 8), x := 3], simp())
      have e5 := mp(app_update_other[f := m.gpr, k := 4, v := bits_add(64, m.gpr[4], 8), x := 5], simp())
      have e12 := mp(app_update_other[f := m.gpr, k := 4, v := bits_add(64, m.gpr[4], 8), x := 12], simp())
      have e13 := mp(app_update_other[f := m.gpr, k := 4, v := bits_add(64, m.gpr[4], 8), x := 13], simp())
      have e14 := mp(app_update_other[f := m.gpr, k := 4, v := bits_add(64, m.gpr[4], 8), x := 14], simp())
      have e15 := mp(app_update_other[f := m.gpr, k := 4, v := bits_add(64, m.gpr[4], 8), x := 15], simp())
      have cs: abi.callee_saved(M2, s) by simp(rest, e3, e5, e12, e13, e14, e15)
      have oth: M2.os = w2.os && M2.fs_base = s.fs_base && M2.cpu = s.cpu && M2.gs_base = s.gs_base &&
        !M2.flags.df by simp(rest, eos, mfs0)
      have gu := mp(app_univ[u := 1, f := m, k := "gpr"], mu)
      have m2u: M2 in univ(1) by simp(mu, gu, lt, r4)
      have ew: ex w3. runs(p, w, ok(w3, pair(M2.gpr[0], M2.gpr[2]))) && w3 in abi.World && w3 in univ(1) &&
          abi.world_matches(s.vm, M2.vm, w3.vm, abi.objs_at(v, s.fs_base), abi.sp(s)) && M2.os = w3.os && M2.fs_base = s.fs_base
        by ex_intro({w2}, taut(rr, hW2, hu2, wm2, oth))
      have rk: tr.retok(s, v, p, w, M2) by defs(taut(m2M, m2u, ew, oth, atr, cs), tr.retok)
      have ou: tr.out(s, M2) by simp(atr)
      have c := apply(tr.cl_ret[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {p}, {w}, {M2}, ou, rk)
      show := rewrite(sym(e2), c)
    qed
    show := mp(mp(mp(tr.step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb), s := s, v := v, p := p, w := w, m := m, q := x. x = M2], st), nr), post)
  qed
  show by defs(g, tr.lv)
qed
