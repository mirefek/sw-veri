          have vss := apply(ms.ssvm_vm, {app(S3, "vm")}, {P}, {ENDP}, {n}, v3V)
          let ARGS := seq_concat(seq_concat(seq_one(gimple.arg(64, P)), seq_one(gimple.arg(64, ENDP))), seq_one(gimple.arg(64, n)))
          have qa3: all regs o2. gc.regs_ok(regs, ARGS) -> runs(app(mallocng_specs.set_size_spec_fun(), regs), S3, o2) ->
