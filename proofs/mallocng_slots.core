          have bA: !int_lt(SL, bits_sext(32, 64, OFF)) -> ex O2 M2. (O2 in bits(32) && int_le(O2, SLV) && int_lt(O2, 256)) && x11 = ok(pair(s, pair(ENDP, pair(M2, pair(O2, pair(E, pair(SL, pair(SW, x7))))))), empty) proof
            assume h
            have e := apply(g.pick2, c9, h, h)
            have h2 := rewrite(sxo, rewrite(slv, h))
            have le: int_le(OFF, SLV) by arith(h2, slo, hob)
            show by ex_intro({OFF}, {x2}, taut(hob, le, hol, e))
          qed
          have bB: int_lt(SL, bits_sext(32, 64, OFF)) -> ex O2 M2. (O2 in bits(32) && int_le(O2, SLV) && int_lt(O2, 256)) && x11 = ok(pair(s, pair(ENDP, pair(M2, pair(O2, pair(E, pair(SL, pair(SW, x7))))))), empty) proof
            assume h
            have p1 := apply(g.pick, c9, h, (!!int_lt(SL, bits_sext(32, 64, OFF)) by taut(h)))
            have h2 := rewrite(sxo, rewrite(slv, h))
            have s256: int_lt(SL, 256) by arith(h2, hol, slv)
            let M3 := ms.sm64(ms.sm64(ms.sm64(SL, 1), 2), 4)
            let O1 := bits_and(32, bits_of_int(32, M3), OFF)
            have mk := apply(ms.ef_mask, {SL}, {OFF}, slb, s256, hob)
            have o1b: O1 in bits(32) by simp()
            have so1: bits_sext(32, 64, O1) = O1 by defs(simp(o1b, mk, s256, slv, slo), bits_sext, sint)
            have bsl: bits_of_int(32, SL) = SLV by defs(arith(slv, slo), bits_of_int, pow2)
            have p32: pow2(32) = 4294967296 by simp()
            let G := ex O2 M2. (O2 in bits(32) && int_le(O2, SLV) && int_lt(O2, 256)) && x11 = ok(pair(s, pair(ENDP, pair(M2, pair(O2, pair(E, pair(SL, pair(SW, x7))))))), empty)
            // above the slack: less the slack and 1
            have bI: int_lt(SL, bits_sext(32, 64, O1)) -> G proof
              assume hI
              have hI2: int_lt(SLV, O1) by arith(hI, so1, slv)
              let O2 := bits_add(32, bits_sub(32, O1, bits_of_int(32, SL)), bits_neg(32, 1))
              have d1 := rewrite(sym(bsl), apply(ms.sub32, {O1}, {SLV}, o1b, slo, arith(hI2)), {1})
              have d2 := apply(ms.dec32, {int_sub(O1, SLV)}, arith(hI2, slo), arith(hI2), arith(o1b, slo))
              have o2v: O2 = int_sub(int_sub(O1, SLV), 1) := rewrite(sym(d1), d2, {1})
              have o2b: O2 in bits(32) by simp()
