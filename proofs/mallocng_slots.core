          have q3e: Q3 = int_sub(P, 3) by arith(svm3)
          have uq2 := mp(all_elim(ms.usable_part, {V0}, {app(s, "objs")}, {int_sub(E, 4)}, {SW}, {int_add(Q2, 0)}, {2}, {true}), arith(eo), arith(q2e, hpb), arith(q2e, hpe), arith(q2e, hpl, hn), huw4)
          have uq3 := mp(all_elim(ms.usable_part, {V0}, {app(s, "objs")}, {int_sub(E, 4)}, {SW}, {int_add(Q3, 0)}, {1}, {true}), arith(eo), arith(q3e, hpb), arith(q3e, hpe), arith(q3e, hpl, hn), huw4)
