        obtain OFF, hob hol hx9 from offx
        have c7 := rewrite(hx9, c6)
        let X9 := pair(s, pair(ENDP, pair(x2, pair(OFF, pair(E, pair(SL, pair(SW, x7)))))))
        have os := all_elim(g.ok_state, {X9}, {empty})
        // (the check byte at p - 4: 0, no trap)
        have pd6 := apply(g.padd_det, {s}, {E}, {bits_neg(64, 4)}, hu, eo, simp(), arith(svm4, eb), arith(svm4, eb, p64, swo))
        let P4 := int_add(E, gimple.sval(T64, bits_neg(64, 4)))
        have p4e: P4 = int_sub(E, 4) by arith(svm4)
        have ur4 := mp(all_elim(ms.usable_part, {V0}, {app(s, "objs")}, {int_sub(E, 4)}, {SW}, {int_add(P4, 0)}, {1}, {false}), arith(eo), arith(p4e, eo), arith(p4e), arith(p4e, hns4, hn), hur4)
        have md4: g.mem_defined(s, P4, 0, 1, false) by simp(ur4, p4e, eb, p64, eo)
        have ld4 := apply(g.ld8_det, {s}, {P4}, {0}, hu, arith(p4e, eo, eb), simp(), md4)
        have b4: bits_of_int(64, int_sub(E, 4)) = int_add(P4, 0) by defs(arith(p4e, eo, eb, p64), bits_of_int)
        have hck0: gimple.bytes_at(V0, bits_of_int(64, int_sub(E, 4)), 1) = 0 by defs(simp(hck), mallocng.IB)
        have hck4 := rewrite(b4, hck0)
        have hz: bits_of_int(8, gimple.bytes_at(V0, int_add(P4, 0), 1)) = 0 by simp(hck4)
        have hzz: !!(bits_of_int(8, gimple.bytes_at(V0, int_add(P4, 0), 1)) = 0) by taut(hz)
        step x10 x11, c8 from c7 with pd6, ld4, hzz using F
        have c9 c10 := c8
        // the slack SLV: (stride - n - 4) / 16
        let SLV := int_div(int_sub(int_sub(SW, n), 4), 16)
        have p4v: pow2(4) = 16 by simp()
        have bs1: bits_sub(64, SW, n) = int_sub(SW, n) by defs(arith(swo, hns4, hn, hs31, p64), bits_sub, pow2)
        have bs2: bits_add(64, int_sub(SW, n), bits_neg(64, 4)) = int_sub(int_sub(SW, n), 4) by defs(simp(swo, hns4, hn, hs31), bits_add, bits_neg)
        have bo2: bits_of_int(64, int_sub(int_sub(SW, n), 4)) = int_sub(int_sub(SW, n), 4) by defs(arith(swo, hns4, hn, hs31, p64), bits_of_int, pow2)
        have slv: SL = SLV by defs(simp(bs1, bs2, bo2, p4v), bits_shr)
