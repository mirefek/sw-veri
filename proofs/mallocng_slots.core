          show by taut(cc3, cov3, cok3)
        qed
        have nz: !(O2 = 0) -> runs(SPEC, s, o) proof
          assume h
          have cb := apply(g.pick, cdis, h, h)
          // (the slot's header at E - 2, E - 3; p's check byte at P - 4, P = E + 16 O2)
          let P2 := int_add(E, gimple.sval(T64, bits_neg(64, 2)))
          have p2e: P2 = int_sub(E, 2) by arith(svm2)
          have uw2 := mp(all_elim(ms.usable_part, {V0}, {app(s, "objs")}, {int_sub(E, 4)}, {SW}, {int_add(P2, 0)}, {2}, {true}), arith(eo), arith(p2e, eo), arith(p2e), arith(p2e, hns4, hn), huw4)
          have uw3 := mp(all_elim(ms.usable_part, {V0}, {app(s, "objs")}, {int_sub(E, 4)}, {SW}, {int_add(P3, 0)}, {1}, {true}), arith(eo), arith(p3e, eo), arith(p3e), arith(p3e, hns4, hn), huw4)
          have o8k: int_le(O2, 8191) by arith(ho2t)
          have o2o: O2 in omega by simp(ho2b)
          have q16 := mp(all_elim(ms.sext_mul16, {O2}), o2o, o8k)
          let Q16 := bits_sext(32, 64, bits_mul(32, O2, 16))
          have svq: gimple.sval(T64, Q16) = int_mul(16, O2) by defs(simp(q16, ho2t, o2o), gimple.sval)
          let PP := int_add(E, gimple.sval(T64, Q16))
          have ppe: PP = int_add(E, int_mul(16, O2)) by simp(svq)
          have ppl: int_le(int_add(int_add(PP, n), 4), int_add(E, SW)) by arith(ppe, ho2l, slo, swo, hns4, hn)
          let PP4 := int_add(PP, gimple.sval(T64, bits_neg(64, 4)))
          have pp4e: PP4 = int_sub(PP, 4) by arith(svm4)
          have uw4 := mp(all_elim(ms.usable_part, {V0}, {app(s, "objs")}, {int_sub(E, 4)}, {SW}, {int_add(PP4, 0)}, {1}, {true}), arith(eo), arith(pp4e, ppe, eo, o2o), arith(pp4e, ppe, o2o), arith(pp4e, ppl, hn), huw4)
          have f16: tr.s32_fits(int_mul(sint(32, O2), sint(32, 16))) by defs(simp(ho2b, ho2t, o2o), gimple.fits, sint)
          have F2 := conj(F, eo, p2e, p3e, ppe, pp4e, uw2, uw3, uw4, svq, ho2b, ho2t, o2o, ms.imul_16, f16, ppl)
          step c13 from cb with g.padd_det, ms.st16_det, g.padd_det, ms.st8_det, g.smul32_det, g.padd_det, g.padd_det, ms.st8_det using F2
          // the three writes; the reads after them apart
          let B1 := x86_64_linux.store_le(x86_64_linux.store_le(x86_64_linux.store_le(app(V0, "bytes"), int_add(P2, 0), 2, bits_of_int(16, O2)), int_add(P3, 0), 1, bits_neg(8, 32)), int_add(PP4, 0), 1, 0)
          have wp2: int_le(0, int_add(P2, 0)) && int_le(int_add(int_add(P2, 0), 2), pow2(64)) by arith(p2e, eb, p64, swo)
          have wp3: int_le(0, int_add(P3, 0)) && int_le(int_add(int_add(P3, 0), 1), pow2(64)) by arith(p3e, eb, p64, swo)
          have wp4: int_le(0, int_add(PP4, 0)) && int_le(int_add(int_add(PP4, 0), 1), pow2(64)) by arith(pp4e, ppe, o2o, eb, ppl, hn, p64, swo)
          have hdjI: int_le(int_add(g, 24), int_sub(E, 4)) || int_le(int_add(int_sub(E, 4), SW), int_add(g, 16)) by defs(simp(hdj), mallocng.IB)
          have hdf4: int_le(int_add(app(s, "fs_base"), 8), int_sub(E, 4)) || int_le(int_add(int_sub(E, 4), SW), app(s, "fs_base")) by defs(simp(hdf), mallocng.IB)
          have fsw: app(s, "fs_base") in bits(64) by simp(expand(hw, abi.World))
          have th1 th2 th3 := expand(hth, abi.thread_ok)
          have r7 := mp(all_elim(expand(th1, x86_64_linux.readable), {7}), arith(), arith())
          have m7 _ := r7
          have fsr: int_lt(int_div(int_add(app(s, "fs_base"), 7), 4096), 34359738367) by simp(expand(m7, x86_64_linux.mapped, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))
          have fsb: int_le(0, app(s, "fs_base")) && int_le(int_add(app(s, "fs_base"), 8), pow2(64)) by arith(fsr, fsw, p64)
          have g24: int_le(0, int_add(g, 16)) && int_le(int_add(int_add(g, 16), 8), pow2(64)) by arith(hg, g40, p64)
          have rd16: gimple.bytes_at(fn_update(V0, "bytes", B1), int_add(g, 16), 8) = gimple.bytes_at(V0, int_add(g, 16), 8) by mem(conj(F2, hdjI, g24))
          have rdfs: gimple.bytes_at(fn_update(V0, "bytes", B1), app(s, "fs_base"), 8) = gimple.bytes_at(V0, app(s, "fs_base"), 8) by mem(conj(F2, hdf4, fsb))
          // the worlds; p; the spec's writes
          have x1W x1u := apply(tr.world_store, {s}, {int_add(P2, 0)}, {2}, {bits_of_int(16, O2)}, hw, hu, arith(wp2, p64))
          have x2W x2u := apply(ms.sw_st, {s}, {V0}, {x86_64_linux.store_le(app(V0, "bytes"), int_add(P2, 0), 2, bits_of_int(16, O2))}, {int_add(P3, 0)}, {1}, {bits_neg(8, 32)}, x1W, x1u, arith(wp3, p64))
          have x3W x3u := apply(ms.sw_st, {s}, {V0}, {x86_64_linux.store_le(x86_64_linux.store_le(app(V0, "bytes"), int_add(P2, 0), 2, bits_of_int(16, O2)), int_add(P3, 0), 1, bits_neg(8, 32))}, {int_add(PP4, 0)}, {1}, {0}, x2W, x2u, arith(wp4, p64))
          have ppb: PP in bits(64) by arith(ppe, ppl, eb, o2o, p64, hn, swo)
          have pplt: int_lt(E, PP) by arith(ppe, h, o2o)
          have ppm: int_mod(int_sub(PP, E), 16) = 0 by arith(ppe, o2o)
          have ae2: int_add(P2, 0) = bits_of_int(64, int_sub(E, 2)) by defs(arith(p2e, eb, p64, swo), bits_of_int, pow2)
          have ae3: int_add(P3, 0) = bits_of_int(64, int_sub(E, 3)) by defs(arith(p3e, eb, p64, swo), bits_of_int, pow2)
          have ae4: int_add(PP4, 0) = bits_sub(64, PP, 4) by defs(arith(pp4e, ppe, o2o, eb, p64, swo, ppl, hn), bits_sub, pow2)
          have vo: bits_of_int(16, O2) = int_div(int_sub(PP, E), mallocng.UNIT) by defs(arith(ppe, o2o, ho2t), bits_of_int, pow2, mallocng.UNIT)
          have v32: bits_neg(8, 32) = int_mul(7, 32) by defs(simp(), bits_neg)
          have hV: fn_update(V0, "bytes", B1) = ite(int_lt(E, PP), mallocng_specs.wr8(mallocng_specs.wr8(mallocng_specs.wr16(V0, bits_of_int(64, int_sub(E, 2)), int_div(int_sub(PP, E), mallocng.UNIT)), bits_of_int(64, int_sub(E, 3)), int_mul(7, 32)), bits_sub(64, PP, 4), 0), V0)
            by simp(pplt, ms.v_wr8, ms.v_wr16, ae2, ae3, ae4, vo, v32)
          show := mp(all_elim(tail, {B1}, {PP}), x3W, x3u, rd16, rdfs, ppb, arith(pplt), ppm, ppl, hV, c13)
        qed
        // no offset: p the slot's start, the memory as it was
        have zr: O2 = 0 -> runs(SPEC, s, o) proof
          assume h
          have e0 := apply(g.pick2, cdis, h, (!!(O2 = 0) by taut(h)))
          have vbs := apply(abi.vm_bytes_same, vV)
          have se: fn_update(s, "vm", fn_update(V0, "bytes", app(V0, "bytes"))) = s by simp(vbs, ss)
          have hx: x13 = ok(pair(fn_update(s, "vm", fn_update(V0, "bytes", app(V0, "bytes"))), pair(ENDP, pair(M2, pair(O2, pair(E, pair(SL, pair(SW, x7))))))), empty) by simp(e0, se)
          have hbw := rewrite(sym(se), hw)
          have hbu := rewrite(sym(se), hu)
          have hrd: gimple.bytes_at(fn_update(V0, "bytes", app(V0, "bytes")), int_add(g, 16), 8) = gimple.bytes_at(V0, int_add(g, 16), 8) by simp(vbs)
          have htb: gimple.bytes_at(fn_update(V0, "bytes", app(V0, "bytes")), app(s, "fs_base"), 8) = gimple.bytes_at(V0, app(s, "fs_base"), 8) by simp(vbs)
          have hpm: int_mod(int_sub(E, E), 16) = 0 by arith()
          have hpl: int_le(int_add(int_add(E, n), 4), int_add(E, SW)) by arith(hns4)
          have hV: fn_update(V0, "bytes", app(V0, "bytes")) = ite(int_lt(E, E), mallocng_specs.wr8(mallocng_specs.wr8(mallocng_specs.wr16(V0, bits_of_int(64, int_sub(E, 2)), int_div(int_sub(E, E), mallocng.UNIT)), bits_of_int(64, int_sub(E, 3)), int_mul(7, 32)), bits_sub(64, E, 4), 0), V0)
            by simp(vbs)
          show := mp(all_elim(tail, {app(V0, "bytes")}, {E}), hbw, hbu, hrd, htb, eo, (int_le(E, E) by arith()), hpm, hpl, hV, hx)
        qed
        have cz: O2 = 0 || !(O2 = 0) by taut()
        show by taut(cz, zr, nz)
      qed
      show by taut(cc, cov, cok)
    qed
    show by taut(np, yp)
  qed
qed

// (the spec's return: a word)
theorem ms.ef_ret_word: all g idx n s s1 v. g in bits(64) -> idx in bits(32) -> n in bits(64) -> s in abi.World -> runs(mallocng_specs.enframe_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, g, idx, n), s, ok(s1, v)) ->
  mallocng_specs.enframe_pre(app(s, "vm"), app(s, "objs"), app(s, "fs_base"), c_src_malloc_mallocng_malloc.__malloc_size_classes, g, idx, n) -> v in bits(64)
proof
  fix g idx n s s1 v
  assume hg hi hn hw h hp
  let V0 := app(s, "vm")
  let E := mallocng_specs.eslot(V0, g, idx)
  let SW := mallocng_specs.stride_w(V0, g)
  have hgs h16 hi31 hns hs31 hib he63 hdj hdf hur huw hck hth := expand(hp, mallocng_specs.enframe_pre)
  have swo := apply(ms.sw_nat, hw, hg, hgs)
  have rdb: mallocng_specs.rd64(V0, bits_add(64, g, 16)) in bits(64) by defs(simp(), mallocng_specs.rd64)
  have ee: E = int_add(int_add(mallocng_specs.rd64(V0, bits_add(64, g, 16)), 16), int_mul(SW, idx)) by defs(simp(), mallocng_specs.eslot, mallocng.UNIT)
  have mo: int_mul(SW, idx) in omega by arith(swo, hi)
  have hns4: int_le(int_add(n, 4), SW) by defs(simp(hns), mallocng.IB)
  have eb: E in bits(64) by defs(arith(ee, rdb, mo, he63, swo), pow2)
  have at: mallocng_specs.enframe_at(V0, g, idx, n, E) by defs(arith(hns4, ee, rdb, mo), mallocng_specs.enframe_at, mallocng.UNIT, mallocng.IB)
  have ex: ex x1. x1 in bits(64) && mallocng_specs.enframe_at(V0, g, idx, n, x1) by ex_intro({E}, conj(eb, at))
  have vv: ex x. x in x86_64_linux.Vm by ex_intro({app(s, "vm")}, simp(expand(hw, abi.World)))
  have no: all x. !runs(abi.overflow, s, ok(s1, x)) proof
    fix x
    have c: runs(abi.overflow, s, ok(s1, x)) -> false proof
      assume ho
      show by simp(ho, vv)
    qed
    show by taut(c)
  qed
  show by simp(h, hp, no, ex, keep(abi.overflow, mallocng_specs.enframe_pre, mallocng_specs.enframe_at, mallocng_specs.enframe_vm))
qed

// enframe as a C function value: its register wrapper refines the spec's
// (for callees refining get_stride's and set_size's)
theorem ms.enframe_fun_c2: all g0 g1 g2.
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(app(g0, regs), s, o) ->
    runs(app(mallocng_specs.get_stride_spec_fun(c_src_malloc_mallocng_malloc.__malloc_size_classes), regs), s, o)) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(app(g2, regs), s, o) ->
    runs(app(mallocng_specs.set_size_spec_fun(), regs), s, o)) ->
  all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
  runs(app(c_src_malloc_mallocng_malloc.enframe_fun(g0, g1, g2), regs), s, o) -> runs(app(mallocng_specs.enframe_spec_fun(c_src_malloc_mallocng_malloc.__malloc_size_classes), regs), s, o)
proof
  fix g0 g1 g2
  assume hg0 hg2
  fix regs s o
  assume hr hl hw h
  have lo: seq_len(regs) in omega by simp(hr)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(hl, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(hr, ol, keep(ord_le))
  rsimp only, c_src_malloc_mallocng_malloc.enframe_fun, app_fn_build, ra in h
  rsimp only, mallocng_specs.enframe_spec_fun, app_fn_build, ra
  have pu := apply(g.runs_univ, h)
  have su: s in univ(1) by simp(pu)
  have r := apply(g.runs_elim, h)
  have a0: bits_of_int(64, app(regs, 0)) in bits(64) by simp()
  have a1: bits_of_int(32, app(regs, 1)) in bits(32) by simp()
  have a2: bits_of_int(64, app(regs, 2)) in bits(64) by simp()
  have a3: bits_of_int(32, app(regs, 3)) in bits(32) by simp()
  have c1: !ord_le(4, seq_len(regs)) -> runs(mkprog(x0 x1. !ord_le(4, seq_len(regs)) || bind_rel(mallocng_specs.enframe_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, bits_of_int(64, app(regs, 0)), bits_of_int(32, app(regs, 1)), bits_of_int(64, app(regs, 2))), x0, x2 x3. letin(x3, x4. any_rel(x5. x5 in bits(64), x5. x1 = ok(x2, pair(x4, x5)))), x2 x3. x1 = exc(x2, x3), x2. x1 = diverge(x2))), s, o) proof
    assume hn
    show by apply(tr.runs_intro, pu, taut(hn))
  qed
  // the precondition: the spec's run is the code's (C2), its result a word
  have c2: mallocng_specs.enframe_pre(app(s, "vm"), app(s, "objs"), app(s, "fs_base"), c_src_malloc_mallocng_malloc.__malloc_size_classes, bits_of_int(64, app(regs, 0)), bits_of_int(32, app(regs, 1)), bits_of_int(64, app(regs, 2))) -> bind_rel(c_src_malloc_mallocng_malloc.enframe(bits_of_int(64, app(regs, 0)), bits_of_int(32, app(regs, 1)), bits_of_int(64, app(regs, 2)), bits_of_int(32, app(regs, 3)), g0, g1, g2), s, x2 x3. letin(x3, x4. bind_rel(gimple.result(64, x4), x2, x5 x6. any_rel(x7. x7 in bits(64), x7. o = ok(x5, pair(x6, x7))), x5 x6. o = exc(x5, x6), x5. o = diverge(x5))), x2 x3. o = exc(x2, x3), x2. o = diverge(x2)) -> runs(mkprog(x0 x1. !ord_le(4, seq_len(regs)) || bind_rel(mallocng_specs.enframe_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, bits_of_int(64, app(regs, 0)), bits_of_int(32, app(regs, 1)), bits_of_int(64, app(regs, 2))), x0, x2 x3. letin(x3, x4. any_rel(x5. x5 in bits(64), x5. x1 = ok(x2, pair(x4, x5)))), x2 x3. x1 = exc(x2, x3), x2. x1 = diverge(x2))), s, o) proof
    assume hp hb
    have dc := expand(all_elim(ms.enframe_c2, {bits_of_int(64, app(regs, 0))}, {bits_of_int(32, app(regs, 1))}, {bits_of_int(64, app(regs, 2))}, {bits_of_int(32, app(regs, 3))}, {g0}, {g1}, {g2}), refines)
    have hm: all o2. runs(c_src_malloc_mallocng_malloc.enframe(bits_of_int(64, app(regs, 0)), bits_of_int(32, app(regs, 1)), bits_of_int(64, app(regs, 2)), bits_of_int(32, app(regs, 3)), g0, g1, g2), s, o2) -> runs(mallocng_specs.enframe_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, bits_of_int(64, app(regs, 0)), bits_of_int(32, app(regs, 1)), bits_of_int(64, app(regs, 2))), s, o2) proof
      fix o2
      assume h2
      show := mp(all_elim(mp(dc, a0, a1, a2, a3, hg0, hg2), {s}, {o2}), hw, h2)
    qed
    have b2 := apply(g.bind_mono, hm, hb)
    have kk: all s1 v. runs(mallocng_specs.enframe_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, bits_of_int(64, app(regs, 0)), bits_of_int(32, app(regs, 1)), bits_of_int(64, app(regs, 2))), s, ok(s1, v)) -> letin(v, x4. bind_rel(gimple.result(64, x4), s1, x5 x6. any_rel(x7. x7 in bits(64), x7. o = ok(x5, pair(x6, x7))), x5 x6. o = exc(x5, x6), x5. o = diverge(x5))) ->
        letin(v, x4. any_rel(x5. x5 in bits(64), x5. o = ok(s1, pair(x4, x5)))) proof
      fix s1 v
      assume hs hk
      have vb := apply(ms.ef_ret_word, a0, a1, a2, hw, hs, hp)
      obtain o3, h3 hc from expand(apply(g.letin_e, hk), bind_rel)
      have e3 := apply(g.result64_inv, vb, h3)
      have hc2 := rewrite(e3, hc)
      have k: any_rel(x7. x7 in bits(64), x7. o = ok(s1, pair(v, x7))) by simp(hc2, keep(any_rel))
      show by defs(k, letin)
    qed
    have b3 := apply(g.bind_cont, kk, b2)
    show by apply(tr.runs_intro, pu, taut(b3))
  qed
  // no precondition: the spec allows every outcome, the code's too
  have c3: !mallocng_specs.enframe_pre(app(s, "vm"), app(s, "objs"), app(s, "fs_base"), c_src_malloc_mallocng_malloc.__malloc_size_classes, bits_of_int(64, app(regs, 0)), bits_of_int(32, app(regs, 1)), bits_of_int(64, app(regs, 2))) -> bind_rel(c_src_malloc_mallocng_malloc.enframe(bits_of_int(64, app(regs, 0)), bits_of_int(32, app(regs, 1)), bits_of_int(64, app(regs, 2)), bits_of_int(32, app(regs, 3)), g0, g1, g2), s, x2 x3. letin(x3, x4. bind_rel(gimple.result(64, x4), x2, x5 x6. any_rel(x7. x7 in bits(64), x7. o = ok(x5, pair(x6, x7))), x5 x6. o = exc(x5, x6), x5. o = diverge(x5))), x2 x3. o = exc(x2, x3), x2. o = diverge(x2)) -> runs(mkprog(x0 x1. !ord_le(4, seq_len(regs)) || bind_rel(mallocng_specs.enframe_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, bits_of_int(64, app(regs, 0)), bits_of_int(32, app(regs, 1)), bits_of_int(64, app(regs, 2))), x0, x2 x3. letin(x3, x4. any_rel(x5. x5 in bits(64), x5. x1 = ok(x2, pair(x4, x5)))), x2 x3. x1 = exc(x2, x3), x2. x1 = diverge(x2))), s, o) proof
    assume hn hb
    have any: all o2. pair(s, o2) in univ(1) -> runs(mallocng_specs.enframe_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, bits_of_int(64, app(regs, 0)), bits_of_int(32, app(regs, 1)), bits_of_int(64, app(regs, 2))), s, o2) proof
      fix o2
      assume hu
      show by simp(hu, hn, keep(abi.overflow, mallocng_specs.enframe_pre, mallocng_specs.enframe_at, mallocng_specs.enframe_vm))
    qed
    obtain o1, h1 hc from expand(hb, bind_rel, {1})
    have pu1 := apply(g.runs_univ, expand(h1, c_src_malloc_mallocng_malloc.enframe))
    // (the first step's outcome o1 is the spec's: but for a return, whose
    // value the result step turns into rax)
    have q1: (ex s1 v. o1 = ok(s1, v) && letin(v, x4. bind_rel(gimple.result(64, x4), s1, x5 x6. any_rel(x7. x7 in bits(64), x7. o = ok(x5, pair(x6, x7))), x5 x6. o = exc(x5, x6), x5. o = diverge(x5)))) ->
        bind_rel(mallocng_specs.enframe_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, bits_of_int(64, app(regs, 0)), bits_of_int(32, app(regs, 1)), bits_of_int(64, app(regs, 2))), s, x2 x3. letin(x3, x4. any_rel(x5. x5 in bits(64), x5. o = ok(x2, pair(x4, x5)))), x2 x3. o = exc(x2, x3), x2. o = diverge(x2)) proof
      assume e
      obtain s1 v, eo hk from e
      obtain o3, h3 hc3 from expand(apply(g.letin_e, hk), bind_rel)
      have pu3 := apply(g.runs_univ, expand(h3, gimple.result))
      have r1: (ex x5 x6. o3 = ok(x5, x6) && any_rel(x7. x7 in bits(64), x7. o = ok(x5, pair(x6, x7)))) -> bind_rel(mallocng_specs.enframe_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, bits_of_int(64, app(regs, 0)), bits_of_int(32, app(regs, 1)), bits_of_int(64, app(regs, 2))), s, x2 x3. letin(x3, x4. any_rel(x5. x5 in bits(64), x5. o = ok(x2, pair(x4, x5)))), x2 x3. o = exc(x2, x3), x2. o = diverge(x2)) proof
        assume e2
        obtain x5 x6, eo3 ha from e2
        have u: pair(s, ok(x5, x6)) in univ(1) by simp(rewrite(eo3, pu3), su)
        have sr := mp(all_elim(any, {ok(x5, x6)}), u)
        show by defs(ex_intro({ok(x5, x6)}, simp(sr, ha, keep(mallocng_specs.enframe_spec, any_rel))), bind_rel)
      qed
      have r2: (ex x5 x6. o3 = exc(x5, x6) && o = exc(x5, x6)) -> bind_rel(mallocng_specs.enframe_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, bits_of_int(64, app(regs, 0)), bits_of_int(32, app(regs, 1)), bits_of_int(64, app(regs, 2))), s, x2 x3. letin(x3, x4. any_rel(x5. x5 in bits(64), x5. o = ok(x2, pair(x4, x5)))), x2 x3. o = exc(x2, x3), x2. o = diverge(x2)) proof
        assume e2
        obtain x5 x6, eo3 eo from e2
        have u: pair(s, exc(x5, x6)) in univ(1) by simp(rewrite(eo3, pu3), su)
        have sr := mp(all_elim(any, {exc(x5, x6)}), u)
        show by defs(ex_intro({exc(x5, x6)}, simp(sr, eo, keep(mallocng_specs.enframe_spec))), bind_rel)
      qed
      have r3: (ex t. o3 = diverge(t) && o = diverge(t)) -> bind_rel(mallocng_specs.enframe_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, bits_of_int(64, app(regs, 0)), bits_of_int(32, app(regs, 1)), bits_of_int(64, app(regs, 2))), s, x2 x3. letin(x3, x4. any_rel(x5. x5 in bits(64), x5. o = ok(x2, pair(x4, x5)))), x2 x3. o = exc(x2, x3), x2. o = diverge(x2)) proof
        assume e2
        obtain t, eo3 eo from e2
        have u: pair(s, diverge(t)) in univ(1) by simp(rewrite(eo3, pu3), su)
        have sr := mp(all_elim(any, {diverge(t)}), u)
        show by defs(ex_intro({diverge(t)}, simp(sr, eo, keep(mallocng_specs.enframe_spec))), bind_rel)
      qed
      show by taut(hc3, r1, r2, r3)
    qed
    have q2: (ex s1 e. o1 = exc(s1, e) && o = exc(s1, e)) -> bind_rel(mallocng_specs.enframe_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, bits_of_int(64, app(regs, 0)), bits_of_int(32, app(regs, 1)), bits_of_int(64, app(regs, 2))), s, x2 x3. letin(x3, x4. any_rel(x5. x5 in bits(64), x5. o = ok(x2, pair(x4, x5)))), x2 x3. o = exc(x2, x3), x2. o = diverge(x2)) proof
      assume e
      obtain s1 e1, eo eo2 from e
      have sr := mp(all_elim(any, {o1}), pu1)
      show by defs(ex_intro({o1}, simp(sr, eo, eo2, keep(mallocng_specs.enframe_spec))), bind_rel)
    qed
    have q3: (ex t. o1 = diverge(t) && o = diverge(t)) -> bind_rel(mallocng_specs.enframe_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, bits_of_int(64, app(regs, 0)), bits_of_int(32, app(regs, 1)), bits_of_int(64, app(regs, 2))), s, x2 x3. letin(x3, x4. any_rel(x5. x5 in bits(64), x5. o = ok(x2, pair(x4, x5)))), x2 x3. o = exc(x2, x3), x2. o = diverge(x2)) proof
      assume e
      obtain t, eo eo2 from e
      have sr := mp(all_elim(any, {o1}), pu1)
      show by defs(ex_intro({o1}, simp(sr, eo, eo2, keep(mallocng_specs.enframe_spec))), bind_rel)
    qed
    have b3: bind_rel(mallocng_specs.enframe_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, bits_of_int(64, app(regs, 0)), bits_of_int(32, app(regs, 1)), bits_of_int(64, app(regs, 2))), s, x2 x3. letin(x3, x4. any_rel(x5. x5 in bits(64), x5. o = ok(x2, pair(x4, x5)))), x2 x3. o = exc(x2, x3), x2. o = diverge(x2)) by taut(hc, q1, q2, q3)
    show by apply(tr.runs_intro, pu, taut(b3))
  qed
  show by taut(r, c1, c2, c3)
qed

// ----------------------------------------------------------------------
//  get_slot_index: the low 5 bits of p's header byte

// a byte's low 5 bits, in 32 bits
theorem ms.low5: all x. x in omega -> bits_and(32, bits_of_int(8, x), 31) = int_mod(x, 32)
proof
  fix x
  assume hx
  have p5: pow2(5) = 32 by simp()
  have m31: int_sub(pow2(5), 1) = 31 by simp()
  have mb: int_mod(x, pow2(5)) in bits(32) by arith(hx, p5)
  have e0: bits_and(32, bits_of_int(8, x), int_sub(pow2(5), 1)) = int_mod(x, pow2(5)) by bitwise({32}, hx, mb)
  show := rewrite(p5, rewrite(m31, e0))
qed

// C2 of get_slot_index
theorem ms.get_slot_index_c2: all p. p in bits(64) -> refines(c_src_malloc_mallocng_malloc.get_slot_index(p), mallocng_specs.get_slot_index_spec(p), abi.World)
proof
  fix p
  assume hp
  show proof
    fix s o
    assume hw hr
    let SPEC := mallocng_specs.get_slot_index_spec(p)
    let V0 := app(s, "vm")
    let T64 := fn_update(fn_update(empty, "prec", 64), "signed", true)
    have pu := apply(g.runs_univ, hr)
    have hu: s in univ(1) by simp(pu)
    have np: !mallocng_specs.get_slot_index_pre(V0, app(s, "objs"), p) -> runs(SPEC, s, o) proof
      assume hn
      show by simp(pu, hn, keep(abi.overflow, mallocng_specs.get_slot_index_pre))
    qed
    have yp: mallocng_specs.get_slot_index_pre(V0, app(s, "objs"), p) -> runs(SPEC, s, o) proof
      assume hpre
      have p3 ur := expand(hpre, mallocng_specs.get_slot_index_pre)
      have sv: gimple.sval(T64, bits_neg(64, 3)) = int_neg(3) by defs(simp(), gimple.sval)
      let P3 := int_add(p, gimple.sval(T64, bits_neg(64, 3)))
      have e3: P3 = int_sub(p, 3) by arith(sv)
      have ur3: gimple.usable(V0, app(s, "objs"), int_add(P3, 0), 1, false) by simp(ur, e3)
      have p64: pow2(64) = 18446744073709551616 by simp()
      step x1, oe from hr with g.padd_det, g.ld8_det using conj(hu, hp, sv, e3, p3, ur3, p64)
      let X := gimple.bytes_at(V0, int_add(P3, 0), 1)
      have a3: int_add(P3, 0) = bits_sub(64, p, 3) by defs(arith(e3, hp, p3, p64), bits_sub, pow2)
      have _ _ _ pb := apply(ms.world_parts, hw)
      have xo _ := mp(all_elim(g.bytes_bound, {V0}, {int_add(P3, 0)}, {1}), pb, arith())
      have lv := apply(ms.low5, xo)
      have bm: bits_of_int(32, int_mod(X, 32)) = int_mod(X, 32) by defs(arith(xo), bits_of_int, pow2)
      show by simp(oe, pu, hpre, lv, bm, a3, keep(abi.overflow, mallocng_specs.get_slot_index_pre))
    qed
    show by taut(np, yp)
  qed
qed

// get_slot_index as a C function value: its register wrapper refines the spec's
theorem ms.get_slot_index_fun_c2: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
  runs(app(c_src_malloc_mallocng_malloc.get_slot_index_fun(), regs), s, o) -> runs(app(mallocng_specs.get_slot_index_spec_fun(), regs), s, o)
proof
  fix regs s o
  assume hr hl hw h
  have lo: seq_len(regs) in omega by simp(hr)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(hl, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(hr, ol, keep(ord_le))
  rsimp only, c_src_malloc_mallocng_malloc.get_slot_index_fun, app_fn_build, ra in h
  rsimp only, mallocng_specs.get_slot_index_spec_fun, app_fn_build, ra
  have pu := apply(g.runs_univ, h)
  have r := expand(apply(g.runs_elim, h), letin)
  let A0 := bits_of_int(64, app(regs, 0))
  have a0: A0 in bits(64) by simp()
  have dc := expand(all_elim(ms.get_slot_index_c2, {A0}), refines)
  have hm: all o2. runs(c_src_malloc_mallocng_malloc.get_slot_index(A0), s, o2) -> runs(mallocng_specs.get_slot_index_spec(A0), s, o2) proof
    fix o2
    assume h2
    show := mp(all_elim(mp(dc, a0), {s}, {o2}), hw, h2)
  qed
  // (fewer than one argument: the spec allows anything; else the spec's run)
  have k1: case 1 of r proof
    assume hn
    show by apply(tr.runs_intro, pu, taut(hn))
  qed
  have k2: case 2 of r proof
    assume hb
    have b2 := apply(g.bind_mono, hm, hb)
    show by defs(apply(tr.runs_intro, pu, taut(b2)), letin)
  qed
  show by taut(r, k1, k2)
qed
