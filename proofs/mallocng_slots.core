// C2 of malloc.c's slot functions (layers/mallocng_specs.sl): set_size.
// Checked after proofs/mallocng_c2.core.

// ----------------------------------------------------------------------
//  Views: the spec's byte and word writes

theorem ms.v_wr8: all vm a v. mallocng_specs.wr8(vm, a, v) = fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, 1, v))
proof
  fix vm a v
  show by defs(refl({fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, 1, v))}), mallocng_specs.wr8)
qed

theorem ms.v_wr32: all vm a v. mallocng_specs.wr32(vm, a, v) = fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, 4, v))
proof
  fix vm a v
  show by defs(refl({fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, 4, v))}), mallocng_specs.wr32)
qed

mem_view ms.v_wr8
mem_view ms.v_wr32

// ----------------------------------------------------------------------
//  Worlds after n bytes written (the memory procedure's closures, as GIMPLE's
//  stores leave them)

// (s with its memory M's bytes B, B then written: as the steps keep it)
theorem ms.sw_st: all s M B a n v. fn_update(s, "vm", fn_update(M, "bytes", B)) in abi.World -> fn_update(s, "vm", fn_update(M, "bytes", B)) in univ(1) -> a in bits(64) ->
  fn_update(s, "vm", fn_update(M, "bytes", x86_64_linux.store_le(B, a, n, v))) in abi.World &&
  fn_update(s, "vm", fn_update(M, "bytes", x86_64_linux.store_le(B, a, n, v))) in univ(1)
proof
  fix s M B a n v
  assume hw hu ha
  have r := apply(tr.world_store, {fn_update(s, "vm", fn_update(M, "bytes", B))}, {a}, {n}, {v}, hw, hu, ha)
  have t1 := fn_update_twice[f := s, k := "vm", a := fn_update(M, "bytes", B), b := fn_update(fn_update(M, "bytes", B), "bytes", x86_64_linux.store_le(B, a, n, v))]
  have t2 := fn_update_twice[f := M, k := "bytes", a := B, b := x86_64_linux.store_le(B, a, n, v)]
  show by simp(t1, t2, r)
qed

mem_closure tr.world_store
mem_closure ms.sw_st

// GIMPLE's stores of 1 and 4 bytes in a world
theorem ms.st8_det: all s p off v. s in abi.World -> s in univ(1) -> p in bits(64) -> off in bits(32) -> g.mem_defined(s, p, off, 1, true) ->
  g.det(gimple.st8(p, off, v), s, ok(fn_update(s, "vm", fn_update(app(s, "vm"), "bytes", x86_64_linux.store_le(app(app(s, "vm"), "bytes"), int_add(p, off), 1, v))), empty))
proof
  fix s p off v
  assume hw hs hp ho hd
  have pv pf pd .. := apply(ms.world_parts, hw)
  show := apply(g.st8_det, {s}, {p}, {off}, {v}, hs, hp, ho, hd, pv, pf, pd)
qed

theorem ms.st32_det: all s p off v. s in abi.World -> s in univ(1) -> p in bits(64) -> off in bits(32) -> g.mem_defined(s, p, off, 4, true) ->
  g.det(gimple.st32(p, off, v), s, ok(fn_update(s, "vm", fn_update(app(s, "vm"), "bytes", x86_64_linux.store_le(app(app(s, "vm"), "bytes"), int_add(p, off), 4, v))), empty))
proof
  fix s p off v
  assume hw hs hp ho hd
  have pv pf pd .. := apply(ms.world_parts, hw)
  show := apply(g.st32_det, {s}, {p}, {off}, {v}, hs, hp, ho, hd, pv, pf, pd)
qed

// (bytes within usable ones: usable)
theorem ms.usable_part: all vm objs a n b m w. a in int -> b in int -> int_le(a, b) -> int_le(int_add(b, m), int_add(a, n)) ->
  gimple.usable(vm, objs, a, n, w) -> gimple.usable(vm, objs, b, m, w)
proof
  fix vm objs a n b m w
  assume ha hb hle hle2 hu
  have h := expand(hu, gimple.usable)
  have g: all i. i in omega -> int_lt(i, m) -> ite(x86_64_linux.mapped(vm, int_div(int_add(b, i), x86_64_linux.PAGE)) &&
      !(app(snd(app(app(vm, "pages"), int_div(int_add(b, i), x86_64_linux.PAGE))), "kind") = 2),
      ite(w, app(app(snd(app(app(vm, "pages"), int_div(int_add(b, i), x86_64_linux.PAGE))), "prot"), "w"), app(app(snd(app(app(vm, "pages"), int_div(int_add(b, i), x86_64_linux.PAGE))), "prot"), "r")),
      int_lt(int_add(b, i), int_pow(2, 64)) && int_add(b, i) in objs) proof
    fix i
    assume hi hlt
    have hj: int_sub(int_add(b, i), a) in omega by arith(ha, hb, hi, hle)
    have jl: int_lt(int_sub(int_add(b, i), a), n) by arith(ha, hb, hi, hlt, hle2)
    have e: int_add(a, int_sub(int_add(b, i), a)) = int_add(b, i) by arith(ha, hb, hi)
    show := rewrite(e, mp(all_elim(h, {int_sub(int_add(b, i), a)}), hj, jl))
  qed
  show by defs(g, gimple.usable)
qed

// ----------------------------------------------------------------------
//  set_size

theorem ms.ss_run: all p e n s o. p in bits(64) -> e in bits(64) -> n in bits(64) -> s in abi.World -> s in univ(1) ->
  mallocng_specs.set_size_pre(app(s, "vm"), app(s, "objs"), p, e, n) ->
  runs(c_src_malloc_mallocng_malloc.set_size(p, e, n), s, o) ->
  o = ok(fn_update(s, "vm", mallocng_specs.set_size_vm(app(s, "vm"), p, e, n)), empty)
proof
  fix p e n s o
  assume hp he hn hw hu hpre hr
  let V0 := app(s, "vm")
  have p4 pne e63 r31 u3r u3w ur1 ur5 := expand(hpre, mallocng_specs.set_size_pre, mallocng_specs.reserved)
  have se: sint(64, e) = e by defs(simp(he, e63), sint)
  have sp: sint(64, p) = p by defs(simp(hp, hn, pne, e63), sint)
  have f1: tr.s64_fits(int_sub(sint(64, e), sint(64, p))) by defs(simp(se, sp, hp, he), gimple.fits)
  have d1 := apply(g.ssub64_det, {s}, {e}, {p}, hu, he, hp, f1)
  let R := bits_sub(32, bits_of_int(32, bits_sub(64, e, p)), bits_of_int(32, n))
  let T64 := fn_update(fn_update(empty, "prec", 64), "signed", true)
  let SX := bits_sub(32, 0, R)
  have eR: R = int_sub(int_sub(e, p), n) by defs(arith(hp, he, hn, pne, r31), bits_sub, bits_of_int)
  have R32: R in bits(32) by simp()
  have pos: int_lt(0, int_sub(int_sub(e, p), n)) -> gimple.sval(T64, bits_sext(32, 64, SX)) = int_neg(int_sub(int_sub(e, p), n)) proof
    assume h0
    let r := int_sub(int_sub(e, p), n)
    have ex: SX = int_sub(4294967296, r) by defs(arith(eR, hp, he, hn, h0, r31), bits_sub)
    have s1: sint(32, SX) = int_neg(r) by defs(simp(ex, h0, r31), sint)
    have s2a: bits_sext(32, 64, SX) = bits_of_int(64, sint(32, SX)) by defs(refl({bits_of_int(64, sint(32, SX))}), bits_sext)
    have p64: pow2(64) = 18446744073709551616 by simp()
    have m64: int_mod(int_neg(r), 18446744073709551616) = int_sub(18446744073709551616, r) by arith(h0, r31)
    have s2b: bits_of_int(64, int_neg(r)) = int_sub(18446744073709551616, r) by defs(simp(m64, p64), bits_of_int)
    have s2 := trans(rewrite(s1, s2a), s2b)
    show by defs(simp(s2, h0, r31), gimple.sval)
  qed
  have pv pf pd .. := apply(ms.world_parts, hw)
  // (the header byte at p - 3)
  have hP3: gimple.sval(T64, bits_neg(64, 3)) = int_neg(3) by defs(simp(), gimple.sval)
  have p3: int_add(int_add(p, gimple.sval(T64, bits_neg(64, 3))), 0) = int_sub(p, 3) by simp(hP3)
  have u3r3 := rewrite(sym(p3), u3r)
  have u3w3 := rewrite(sym(p3), u3w)
  step x2, c1 from hr with d1
  have rpos: int_lt(0, int_sub(int_sub(e, p), n)) -> o = ok(fn_update(s, "vm", mallocng_specs.set_size_vm(V0, p, e, n)), empty) proof
    assume h0
    have hX := mp(pos, h0)
    have nz: !(R = 0) by arith(eR, h0)
    have sR: sint(32, R) = int_sub(int_sub(e, p), n) by defs(simp(eR, h0, r31), sint)
    have fn: tr.s32_fits(int_neg(sint(32, R))) by defs(simp(sR, h0, r31), gimple.fits)
    let X := int_add(e, gimple.sval(T64, bits_sext(32, 64, SX)))
    have ea: int_add(X, 0) = int_add(p, n) by arith(hX, hp, he, hn)
    have ux := rewrite(sym(ea), mp(ur1, h0))
    have F := conj(hu, hw, hp, he, hn, hX, h0, r31, pne, e63, p4, ux, pv, pf, pd, fn)
    step x5, c2 from c1 with nz, g.sneg32_det, g.padd_det, ms.st8_det using F
    have small: int_lt(int_sub(int_sub(e, p), n), 5) -> o = ok(fn_update(s, "vm", mallocng_specs.set_size_vm(V0, p, e, n)), empty) proof
      assume h5
      have n5: !int_lt(sint(32, 4), sint(32, R)) by defs(simp(sR, h5), sint)
      have F2 := conj(F, ea, h5, hP3, p3, u3r3, u3w3)
      step x6, c3 from c2 with n5, g.padd_det, g.ld8_det, g.padd_det, ms.st8_det using F2
      let P3 := int_add(int_add(p, gimple.sval(T64, bits_neg(64, 3))), 0)
      let H := gimple.bytes_at(V0, bits_sub(64, p, 3), 1)
      have a1: int_add(X, 0) = bits_add(64, p, n) by defs(arith(ea, hp, hn, pne, e63), bits_add)
      have a3: P3 = bits_sub(64, p, 3) by defs(arith(p3, hp, p4), bits_sub)
      have rd: gimple.bytes_at(fn_update(V0, "bytes", x86_64_linux.store_le(app(V0, "bytes"), int_add(X, 0), 1, 0)), P3, 1) = gimple.bytes_at(V0, P3, 1) by mem(F2)
      have vv: bits_add(8, bits_and(8, bits_of_int(8, H), 31), bits_shl(8, bits_of_int(8, R), 5)) = int_add(int_mod(H, 32), int_mul(32, int_sub(int_sub(e, p), n)))
        by defs(simp(eR, h0, h5), bits_add, bits_shl, bits_of_int)
      have sp: mallocng_specs.set_size_vm(V0, p, e, n) = fn_update(V0, "bytes", x86_64_linux.store_le(x86_64_linux.store_le(app(V0, "bytes"), bits_add(64, p, n), 1, 0), bits_sub(64, p, 3), 1,
          int_add(int_mod(H, 32), int_mul(32, int_sub(int_sub(e, p), n)))))
        by defs(simp(h0, h5, ms.v_wr8, ms.v_wr32), mallocng_specs.set_size_vm, mallocng_specs.reserved)
      have c4a := rewrite(rd, c3)
      have c4b := rewrite(a1, c4a)
      have c4c := rewrite(a3, c4b)
      have c4 := rewrite(vv, c4c)
      show := rewrite(sym(sp), c4)
    qed
    have big: !int_lt(int_sub(int_sub(e, p), n), 5) -> o = ok(fn_update(s, "vm", mallocng_specs.set_size_vm(V0, p, e, n)), empty) proof
      assume h5
      have b5: int_lt(sint(32, 4), sint(32, R)) by defs(simp(sR, h5), sint)
      // (the count's word at e - 4, the 0 byte at e - 5)
      have hY4: gimple.sval(T64, bits_neg(64, 4)) = int_neg(4) by defs(simp(), gimple.sval)
      have hY5: gimple.sval(T64, bits_neg(64, 5)) = int_neg(5) by defs(simp(), gimple.sval)
      let Y4 := int_add(int_add(e, gimple.sval(T64, bits_neg(64, 4))), 0)
      let Y5 := int_add(int_add(e, gimple.sval(T64, bits_neg(64, 5))), 0)
      have y4: Y4 = int_sub(e, 4) by simp(hY4)
      have y5: Y5 = int_sub(e, 5) by simp(hY5)
      have u5 := mp(ur5, (int_le(5, int_sub(int_sub(e, p), n)) by arith(h5)))
      have uY4 := rewrite(sym(y4), mp(all_elim(ms.usable_part, {V0}, {app(s, "objs")}, {int_sub(e, 5)}, {5}, {int_sub(e, 4)}, {4}, {true}), arith(he), arith(he), arith(), arith(), u5))
      have uY5 := rewrite(sym(y5), mp(all_elim(ms.usable_part, {V0}, {app(s, "objs")}, {int_sub(e, 5)}, {5}, {int_sub(e, 5)}, {1}, {true}), arith(he), arith(he), arith(), arith(), u5))
      have F3 := conj(F, ea, h5, hP3, p3, u3r3, u3w3, hY4, hY5, y4, y5, uY4, uY5)
      step x6, c3 from c2 with b5, g.padd_det, ms.st32_det, g.padd_det, ms.st8_det, g.padd_det, g.ld8_det, g.padd_det, ms.st8_det using F3
      let P3 := int_add(int_add(p, gimple.sval(T64, bits_neg(64, 3))), 0)
      let H := gimple.bytes_at(V0, bits_sub(64, p, 3), 1)
      let B3 := x86_64_linux.store_le(x86_64_linux.store_le(x86_64_linux.store_le(app(V0, "bytes"), int_add(X, 0), 1, 0), Y4, 4, R), Y5, 1, 0)
      have a1: int_add(X, 0) = bits_add(64, p, n) by defs(arith(ea, hp, hn, pne, e63), bits_add)
      have a3: P3 = bits_sub(64, p, 3) by defs(arith(p3, hp, p4), bits_sub)
      have a4: Y4 = bits_sub(64, e, 4) by defs(arith(y4, he, pne, hp, hn, h5), bits_sub)
      have a5: Y5 = bits_sub(64, e, 5) by defs(arith(y5, he, pne, hp, hn, h5), bits_sub)
      // (the read through the writes one by one: each over the memory before)
      let W1 := fn_update(V0, "bytes", x86_64_linux.store_le(app(V0, "bytes"), int_add(X, 0), 1, 0))
      let W2 := fn_update(W1, "bytes", x86_64_linux.store_le(app(W1, "bytes"), Y4, 4, R))
      let W3 := fn_update(W2, "bytes", x86_64_linux.store_le(app(W2, "bytes"), Y5, 1, 0))
      have w3: W3 = fn_update(V0, "bytes", B3) by simp()
      have rd0: gimple.bytes_at(W3, P3, 1) = gimple.bytes_at(V0, P3, 1) by mem(F3)
      have rd := rewrite(w3, rd0)
      have vv: bits_add(8, bits_and(8, bits_of_int(8, H), 31), bits_shl(8, bits_of_int(8, 5), 5)) = int_add(int_mod(H, 32), int_mul(32, 5))
        by defs(simp(), bits_add, bits_shl, bits_of_int)
      have sp: mallocng_specs.set_size_vm(V0, p, e, n) = fn_update(V0, "bytes", x86_64_linux.store_le(x86_64_linux.store_le(x86_64_linux.store_le(x86_64_linux.store_le(app(V0, "bytes"),
          bits_add(64, p, n), 1, 0), bits_sub(64, e, 4), 4, int_sub(int_sub(e, p), n)), bits_sub(64, e, 5), 1, 0), bits_sub(64, p, 3), 1, int_add(int_mod(H, 32), int_mul(32, 5))))
        by defs(simp(h0, h5, ms.v_wr8, ms.v_wr32), mallocng_specs.set_size_vm, mallocng_specs.reserved)
      have c4a := rewrite(rd, c3)
      have c4b := rewrite(a1, c4a)
      have c4c := rewrite(a5, rewrite(a4, rewrite(a3, c4b)))
      have c4 := rewrite(eR, rewrite(vv, c4c))
      show := rewrite(sym(sp), c4)
    qed
    show by taut(small, big)
  qed
  have rzero: !int_lt(0, int_sub(int_sub(e, p), n)) -> o = ok(fn_update(s, "vm", mallocng_specs.set_size_vm(V0, p, e, n)), empty) proof
    assume h0
    have z: R = 0 by arith(eR, h0, pne)
    have zz: !!(R = 0) by taut(z)
    have n5: !int_lt(sint(32, 4), sint(32, R)) by defs(simp(z), sint)
    have F2 := conj(hu, hw, hp, he, hn, pv, pf, pd, hP3, p3, u3r3, u3w3, p4, pne, e63)
    step x5 x6, c3 from c1 with zz, n5, g.padd_det, g.ld8_det, g.padd_det, ms.st8_det using F2
    let P3 := int_add(int_add(p, gimple.sval(T64, bits_neg(64, 3))), 0)
    let H := gimple.bytes_at(V0, bits_sub(64, p, 3), 1)
    have a3: P3 = bits_sub(64, p, 3) by defs(arith(p3, hp, p4), bits_sub)
    have vv: bits_add(8, bits_and(8, bits_of_int(8, H), 31), bits_shl(8, bits_of_int(8, R), 5)) = int_add(int_mod(H, 32), int_mul(32, int_sub(int_sub(e, p), n)))
      by defs(simp(z, eR, h0, pne), bits_add, bits_shl, bits_of_int)
    have sp: mallocng_specs.set_size_vm(V0, p, e, n) = fn_update(V0, "bytes", x86_64_linux.store_le(app(V0, "bytes"), bits_sub(64, p, 3), 1,
        int_add(int_mod(H, 32), int_mul(32, int_sub(int_sub(e, p), n)))))
      by defs(simp(h0, pne, ms.v_wr8, ms.v_wr32), mallocng_specs.set_size_vm, mallocng_specs.reserved)
    have c4 := rewrite(vv, rewrite(a3, c3))
    show := rewrite(sym(sp), c4)
  qed
  show by taut(rpos, rzero)
qed

// C2 of set_size: its readable GIMPLE refines its spec, on every world
theorem ms.set_size_c2: all p e n. p in bits(64) -> e in bits(64) -> n in bits(64) ->
  refines(c_src_malloc_mallocng_malloc.set_size(p, e, n), mallocng_specs.set_size_spec(p, e, n), abi.World)
proof
  fix p e n
  assume hp he hn
  have g: all s o. s in abi.World -> runs(c_src_malloc_mallocng_malloc.set_size(p, e, n), s, o) -> runs(mallocng_specs.set_size_spec(p, e, n), s, o) proof
    fix s o
    assume hw hr
    let V0 := app(s, "vm")
    have pu := apply(g.runs_univ, hr)
    have hu: s in univ(1) by simp(pu)
    have np: !mallocng_specs.set_size_pre(V0, app(s, "objs"), p, e, n) -> runs(mallocng_specs.set_size_spec(p, e, n), s, o) proof
      assume hn0
      show by simp(pu, hn0, keep(abi.overflow, mallocng_specs.set_size_pre, mallocng_specs.set_size_vm))
    qed
    have yp: mallocng_specs.set_size_pre(V0, app(s, "objs"), p, e, n) -> runs(mallocng_specs.set_size_spec(p, e, n), s, o) proof
      assume hpre
      have oe := apply(ms.ss_run, {p}, {e}, {n}, {s}, {o}, hp, he, hn, hw, hu, hpre, hr)
      show by simp(oe, pu, hpre, keep(abi.overflow, mallocng_specs.set_size_pre, mallocng_specs.set_size_vm))
    qed
    show by taut(np, yp)
  qed
  show g
qed

// set_size as a C function value: its register wrapper refines the spec's
theorem ms.set_size_fun_c2: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
  runs(app(c_src_malloc_mallocng_malloc.set_size_fun(), regs), s, o) -> runs(app(mallocng_specs.set_size_spec_fun(), regs), s, o)
proof
  fix regs s o
  assume hr hl hw h
  have lo: seq_len(regs) in omega by simp(hr)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(hl, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(hr, ol, keep(ord_le))
  rsimp only, c_src_malloc_mallocng_malloc.set_size_fun, app_fn_build, ra in h
  rsimp only, mallocng_specs.set_size_spec_fun, app_fn_build, ra
  have pu := apply(g.runs_univ, h)
  have r := apply(g.runs_elim, h)
  let A0 := bits_of_int(64, app(regs, 0))
  let A1 := bits_of_int(64, app(regs, 1))
  let A2 := bits_of_int(64, app(regs, 2))
  have dc := expand(all_elim(ms.set_size_c2, {A0}, {A1}, {A2}), refines)
  have hm: all o2. runs(c_src_malloc_mallocng_malloc.set_size(A0, A1, A2), s, o2) -> runs(mallocng_specs.set_size_spec(A0, A1, A2), s, o2) proof
    fix o2
    assume h2
    show := mp(all_elim(mp(dc, simp(), simp(), simp()), {s}, {o2}), hw, h2)
  qed
  have c1: !ord_le(3, seq_len(regs)) -> runs(mkprog(x1 x2. !ord_le(3, seq_len(regs)) || bind_rel(mallocng_specs.set_size_spec(A0, A1, A2), x1,
      x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. x2 = ok(x3, pair(x5, x6)))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), s, o) proof
    assume hn
    show by apply(tr.runs_intro, pu, taut(hn))
  qed
  have c2: bind_rel(c_src_malloc_mallocng_malloc.set_size(A0, A1, A2), s,
      x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o = ok(x3, pair(x5, x6)))), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) ->
      runs(mkprog(x1 x2. !ord_le(3, seq_len(regs)) || bind_rel(mallocng_specs.set_size_spec(A0, A1, A2), x1,
      x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. x2 = ok(x3, pair(x5, x6)))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), s, o) proof
    assume hb
    have b2 := apply(g.bind_mono, hm, hb)
    show by apply(tr.runs_intro, pu, taut(b2))
  qed
  show by taut(r, c1, c2)
qed
