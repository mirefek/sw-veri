// C2 of malloc.c's slot functions (layers/mallocng_specs.sl): set_size,
// get_stride.
// Checked after proofs/mallocng_c2.core.

// ----------------------------------------------------------------------
//  Views: the spec's byte and word writes

theorem ms.v_wr8: all vm a v. mallocng_specs.wr8(vm, a, v) = fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, 1, v))
proof
  fix vm a v
  show by defs(refl({fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, 1, v))}), mallocng_specs.wr8)
qed

theorem ms.v_wr32: all vm a v. mallocng_specs.wr32(vm, a, v) = fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, 4, v))
proof
  fix vm a v
  show by defs(refl({fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, 4, v))}), mallocng_specs.wr32)
qed

mem_view ms.v_wr8
mem_view ms.v_wr32

// ----------------------------------------------------------------------
//  Worlds after n bytes written (the memory procedure's closures, as GIMPLE's
//  stores leave them)

// (s with its memory M's bytes B, B then written: as the steps keep it)
theorem ms.sw_st: all s M B a n v. fn_update(s, "vm", fn_update(M, "bytes", B)) in abi.World -> fn_update(s, "vm", fn_update(M, "bytes", B)) in univ(1) -> a in bits(64) ->
  fn_update(s, "vm", fn_update(M, "bytes", x86_64_linux.store_le(B, a, n, v))) in abi.World &&
  fn_update(s, "vm", fn_update(M, "bytes", x86_64_linux.store_le(B, a, n, v))) in univ(1)
proof
  fix s M B a n v
  assume hw hu ha
  have r := apply(tr.world_store, {fn_update(s, "vm", fn_update(M, "bytes", B))}, {a}, {n}, {v}, hw, hu, ha)
  have t1 := fn_update_twice[f := s, k := "vm", a := fn_update(M, "bytes", B), b := fn_update(fn_update(M, "bytes", B), "bytes", x86_64_linux.store_le(B, a, n, v))]
  have t2 := fn_update_twice[f := M, k := "bytes", a := B, b := x86_64_linux.store_le(B, a, n, v)]
  show by simp(t1, t2, r)
qed

mem_closure tr.world_store
mem_closure ms.sw_st

// GIMPLE's stores of 1 and 4 bytes in a world
theorem ms.st8_det: all s p off v. s in abi.World -> s in univ(1) -> p in bits(64) -> off in bits(32) -> g.mem_defined(s, p, off, 1, true) ->
  g.det(gimple.st8(p, off, v), s, ok(fn_update(s, "vm", fn_update(app(s, "vm"), "bytes", x86_64_linux.store_le(app(app(s, "vm"), "bytes"), int_add(p, off), 1, v))), empty))
proof
  fix s p off v
  assume hw hs hp ho hd
  have pv pf pd .. := apply(ms.world_parts, hw)
  show := apply(g.st8_det, {s}, {p}, {off}, {v}, hs, hp, ho, hd, pv, pf, pd)
qed

theorem ms.st32_det: all s p off v. s in abi.World -> s in univ(1) -> p in bits(64) -> off in bits(32) -> g.mem_defined(s, p, off, 4, true) ->
  g.det(gimple.st32(p, off, v), s, ok(fn_update(s, "vm", fn_update(app(s, "vm"), "bytes", x86_64_linux.store_le(app(app(s, "vm"), "bytes"), int_add(p, off), 4, v))), empty))
proof
  fix s p off v
  assume hw hs hp ho hd
  have pv pf pd .. := apply(ms.world_parts, hw)
  show := apply(g.st32_det, {s}, {p}, {off}, {v}, hs, hp, ho, hd, pv, pf, pd)
qed

// (bytes within usable ones: usable)
theorem ms.usable_part: all vm objs a n b m w. a in int -> b in int -> int_le(a, b) -> int_le(int_add(b, m), int_add(a, n)) ->
  gimple.usable(vm, objs, a, n, w) -> gimple.usable(vm, objs, b, m, w)
proof
  fix vm objs a n b m w
  assume ha hb hle hle2 hu
  have h := expand(hu, gimple.usable)
  have g: all i. i in omega -> int_lt(i, m) -> ite(x86_64_linux.mapped(vm, int_div(int_add(b, i), x86_64_linux.PAGE)) &&
      !(app(snd(app(app(vm, "pages"), int_div(int_add(b, i), x86_64_linux.PAGE))), "kind") = 2),
      ite(w, app(app(snd(app(app(vm, "pages"), int_div(int_add(b, i), x86_64_linux.PAGE))), "prot"), "w"), app(app(snd(app(app(vm, "pages"), int_div(int_add(b, i), x86_64_linux.PAGE))), "prot"), "r")),
      int_lt(int_add(b, i), int_pow(2, 64)) && int_add(b, i) in objs) proof
    fix i
    assume hi hlt
    have hj: int_sub(int_add(b, i), a) in omega by arith(ha, hb, hi, hle)
    have jl: int_lt(int_sub(int_add(b, i), a), n) by arith(ha, hb, hi, hlt, hle2)
    have e: int_add(a, int_sub(int_add(b, i), a)) = int_add(b, i) by arith(ha, hb, hi)
    show := rewrite(e, mp(all_elim(h, {int_sub(int_add(b, i), a)}), hj, jl))
  qed
  show by defs(g, gimple.usable)
qed

// ----------------------------------------------------------------------
//  set_size

theorem ms.ss_run: all p e n s o. p in bits(64) -> e in bits(64) -> n in bits(64) -> s in abi.World -> s in univ(1) ->
  mallocng_specs.set_size_pre(app(s, "vm"), app(s, "objs"), p, e, n) ->
  runs(c_src_malloc_mallocng_malloc.set_size(p, e, n), s, o) ->
  o = ok(fn_update(s, "vm", mallocng_specs.set_size_vm(app(s, "vm"), p, e, n)), empty)
proof
  fix p e n s o
  assume hp he hn hw hu hpre hr
  let V0 := app(s, "vm")
  have p4 pne e63 r31 u3r u3w ur1 ur5 := expand(hpre, mallocng_specs.set_size_pre, mallocng_specs.reserved)
  have se: sint(64, e) = e by defs(simp(he, e63), sint)
  have sp: sint(64, p) = p by defs(simp(hp, hn, pne, e63), sint)
  have f1: tr.s64_fits(int_sub(sint(64, e), sint(64, p))) by defs(simp(se, sp, hp, he), gimple.fits)
  have d1 := apply(g.ssub64_det, {s}, {e}, {p}, hu, he, hp, f1)
  let R := bits_sub(32, bits_of_int(32, bits_sub(64, e, p)), bits_of_int(32, n))
  let T64 := fn_update(fn_update(empty, "prec", 64), "signed", true)
  let SX := bits_sub(32, 0, R)
  have eR: R = int_sub(int_sub(e, p), n) by defs(arith(hp, he, hn, pne, r31), bits_sub, bits_of_int)
  have R32: R in bits(32) by simp()
  have pos: int_lt(0, int_sub(int_sub(e, p), n)) -> gimple.sval(T64, bits_sext(32, 64, SX)) = int_neg(int_sub(int_sub(e, p), n)) proof
    assume h0
    let r := int_sub(int_sub(e, p), n)
    have ex: SX = int_sub(4294967296, r) by defs(arith(eR, hp, he, hn, h0, r31), bits_sub)
    have s1: sint(32, SX) = int_neg(r) by defs(simp(ex, h0, r31), sint)
    have s2a: bits_sext(32, 64, SX) = bits_of_int(64, sint(32, SX)) by defs(refl({bits_of_int(64, sint(32, SX))}), bits_sext)
    have p64: pow2(64) = 18446744073709551616 by simp()
    have m64: int_mod(int_neg(r), 18446744073709551616) = int_sub(18446744073709551616, r) by arith(h0, r31)
    have s2b: bits_of_int(64, int_neg(r)) = int_sub(18446744073709551616, r) by defs(simp(m64, p64), bits_of_int)
    have s2 := trans(rewrite(s1, s2a), s2b)
    show by defs(simp(s2, h0, r31), gimple.sval)
  qed
  have pv pf pd .. := apply(ms.world_parts, hw)
  // (the header byte at p - 3)
  have hP3: gimple.sval(T64, bits_neg(64, 3)) = int_neg(3) by defs(simp(), gimple.sval)
  have p3: int_add(int_add(p, gimple.sval(T64, bits_neg(64, 3))), 0) = int_sub(p, 3) by simp(hP3)
  have u3r3 := rewrite(sym(p3), u3r)
  have u3w3 := rewrite(sym(p3), u3w)
  step x2, c1 from hr with d1
  have rpos: int_lt(0, int_sub(int_sub(e, p), n)) -> o = ok(fn_update(s, "vm", mallocng_specs.set_size_vm(V0, p, e, n)), empty) proof
    assume h0
    have hX := mp(pos, h0)
    have nz: !(R = 0) by arith(eR, h0)
    have sR: sint(32, R) = int_sub(int_sub(e, p), n) by defs(simp(eR, h0, r31), sint)
    have fn: tr.s32_fits(int_neg(sint(32, R))) by defs(simp(sR, h0, r31), gimple.fits)
    let X := int_add(e, gimple.sval(T64, bits_sext(32, 64, SX)))
    have ea: int_add(X, 0) = int_add(p, n) by arith(hX, hp, he, hn)
    have ux := rewrite(sym(ea), mp(ur1, h0))
    have F := conj(hu, hw, hp, he, hn, hX, h0, r31, pne, e63, p4, ux, pv, pf, pd, fn)
    step x5, c2 from c1 with nz, g.sneg32_det, g.padd_det, ms.st8_det using F
    have small: int_lt(int_sub(int_sub(e, p), n), 5) -> o = ok(fn_update(s, "vm", mallocng_specs.set_size_vm(V0, p, e, n)), empty) proof
      assume h5
      have n5: !int_lt(sint(32, 4), sint(32, R)) by defs(simp(sR, h5), sint)
      have F2 := conj(F, ea, h5, hP3, p3, u3r3, u3w3)
      step x6, c3 from c2 with n5, g.padd_det, g.ld8_det, g.padd_det, ms.st8_det using F2
      let P3 := int_add(int_add(p, gimple.sval(T64, bits_neg(64, 3))), 0)
      let H := gimple.bytes_at(V0, bits_sub(64, p, 3), 1)
      have a1: int_add(X, 0) = bits_add(64, p, n) by defs(arith(ea, hp, hn, pne, e63), bits_add)
      have a3: P3 = bits_sub(64, p, 3) by defs(arith(p3, hp, p4), bits_sub)
      have rd: gimple.bytes_at(fn_update(V0, "bytes", x86_64_linux.store_le(app(V0, "bytes"), int_add(X, 0), 1, 0)), P3, 1) = gimple.bytes_at(V0, P3, 1) by mem(F2)
      have vv: bits_add(8, bits_and(8, bits_of_int(8, H), 31), bits_shl(8, bits_of_int(8, R), 5)) = int_add(int_mod(H, 32), int_mul(32, int_sub(int_sub(e, p), n)))
        by defs(simp(eR, h0, h5), bits_add, bits_shl, bits_of_int)
      have sp: mallocng_specs.set_size_vm(V0, p, e, n) = fn_update(V0, "bytes", x86_64_linux.store_le(x86_64_linux.store_le(app(V0, "bytes"), bits_add(64, p, n), 1, 0), bits_sub(64, p, 3), 1,
          int_add(int_mod(H, 32), int_mul(32, int_sub(int_sub(e, p), n)))))
        by defs(simp(h0, h5, ms.v_wr8, ms.v_wr32), mallocng_specs.set_size_vm, mallocng_specs.reserved)
      have c4a := rewrite(rd, c3)
      have c4b := rewrite(a1, c4a)
      have c4c := rewrite(a3, c4b)
      have c4 := rewrite(vv, c4c)
      show := rewrite(sym(sp), c4)
    qed
    have big: !int_lt(int_sub(int_sub(e, p), n), 5) -> o = ok(fn_update(s, "vm", mallocng_specs.set_size_vm(V0, p, e, n)), empty) proof
      assume h5
      have b5: int_lt(sint(32, 4), sint(32, R)) by defs(simp(sR, h5), sint)
      // (the count's word at e - 4, the 0 byte at e - 5)
      have hY4: gimple.sval(T64, bits_neg(64, 4)) = int_neg(4) by defs(simp(), gimple.sval)
      have hY5: gimple.sval(T64, bits_neg(64, 5)) = int_neg(5) by defs(simp(), gimple.sval)
      let Y4 := int_add(int_add(e, gimple.sval(T64, bits_neg(64, 4))), 0)
      let Y5 := int_add(int_add(e, gimple.sval(T64, bits_neg(64, 5))), 0)
      have y4: Y4 = int_sub(e, 4) by simp(hY4)
      have y5: Y5 = int_sub(e, 5) by simp(hY5)
      have u5 := mp(ur5, (int_le(5, int_sub(int_sub(e, p), n)) by arith(h5)))
      have uY4 := rewrite(sym(y4), mp(all_elim(ms.usable_part, {V0}, {app(s, "objs")}, {int_sub(e, 5)}, {5}, {int_sub(e, 4)}, {4}, {true}), arith(he), arith(he), arith(), arith(), u5))
      have uY5 := rewrite(sym(y5), mp(all_elim(ms.usable_part, {V0}, {app(s, "objs")}, {int_sub(e, 5)}, {5}, {int_sub(e, 5)}, {1}, {true}), arith(he), arith(he), arith(), arith(), u5))
      have F3 := conj(F, ea, h5, hP3, p3, u3r3, u3w3, hY4, hY5, y4, y5, uY4, uY5)
      step x6, c3 from c2 with b5, g.padd_det, ms.st32_det, g.padd_det, ms.st8_det, g.padd_det, g.ld8_det, g.padd_det, ms.st8_det using F3
      let P3 := int_add(int_add(p, gimple.sval(T64, bits_neg(64, 3))), 0)
      let H := gimple.bytes_at(V0, bits_sub(64, p, 3), 1)
      let B3 := x86_64_linux.store_le(x86_64_linux.store_le(x86_64_linux.store_le(app(V0, "bytes"), int_add(X, 0), 1, 0), Y4, 4, R), Y5, 1, 0)
      have a1: int_add(X, 0) = bits_add(64, p, n) by defs(arith(ea, hp, hn, pne, e63), bits_add)
      have a3: P3 = bits_sub(64, p, 3) by defs(arith(p3, hp, p4), bits_sub)
      have a4: Y4 = bits_sub(64, e, 4) by defs(arith(y4, he, pne, hp, hn, h5), bits_sub)
      have a5: Y5 = bits_sub(64, e, 5) by defs(arith(y5, he, pne, hp, hn, h5), bits_sub)
      // (the read through the writes one by one: each over the memory before)
      let W1 := fn_update(V0, "bytes", x86_64_linux.store_le(app(V0, "bytes"), int_add(X, 0), 1, 0))
      let W2 := fn_update(W1, "bytes", x86_64_linux.store_le(app(W1, "bytes"), Y4, 4, R))
      let W3 := fn_update(W2, "bytes", x86_64_linux.store_le(app(W2, "bytes"), Y5, 1, 0))
      have w3: W3 = fn_update(V0, "bytes", B3) by simp()
      have rd0: gimple.bytes_at(W3, P3, 1) = gimple.bytes_at(V0, P3, 1) by mem(F3)
      have rd := rewrite(w3, rd0)
      have vv: bits_add(8, bits_and(8, bits_of_int(8, H), 31), bits_shl(8, bits_of_int(8, 5), 5)) = int_add(int_mod(H, 32), int_mul(32, 5))
        by defs(simp(), bits_add, bits_shl, bits_of_int)
      have sp: mallocng_specs.set_size_vm(V0, p, e, n) = fn_update(V0, "bytes", x86_64_linux.store_le(x86_64_linux.store_le(x86_64_linux.store_le(x86_64_linux.store_le(app(V0, "bytes"),
          bits_add(64, p, n), 1, 0), bits_sub(64, e, 4), 4, int_sub(int_sub(e, p), n)), bits_sub(64, e, 5), 1, 0), bits_sub(64, p, 3), 1, int_add(int_mod(H, 32), int_mul(32, 5))))
        by defs(simp(h0, h5, ms.v_wr8, ms.v_wr32), mallocng_specs.set_size_vm, mallocng_specs.reserved)
      have c4a := rewrite(rd, c3)
      have c4b := rewrite(a1, c4a)
      have c4c := rewrite(a5, rewrite(a4, rewrite(a3, c4b)))
      have c4 := rewrite(eR, rewrite(vv, c4c))
      show := rewrite(sym(sp), c4)
    qed
    show by taut(small, big)
  qed
  have rzero: !int_lt(0, int_sub(int_sub(e, p), n)) -> o = ok(fn_update(s, "vm", mallocng_specs.set_size_vm(V0, p, e, n)), empty) proof
    assume h0
    have z: R = 0 by arith(eR, h0, pne)
    have zz: !!(R = 0) by taut(z)
    have n5: !int_lt(sint(32, 4), sint(32, R)) by defs(simp(z), sint)
    have F2 := conj(hu, hw, hp, he, hn, pv, pf, pd, hP3, p3, u3r3, u3w3, p4, pne, e63)
    step x5 x6, c3 from c1 with zz, n5, g.padd_det, g.ld8_det, g.padd_det, ms.st8_det using F2
    let P3 := int_add(int_add(p, gimple.sval(T64, bits_neg(64, 3))), 0)
    let H := gimple.bytes_at(V0, bits_sub(64, p, 3), 1)
    have a3: P3 = bits_sub(64, p, 3) by defs(arith(p3, hp, p4), bits_sub)
    have vv: bits_add(8, bits_and(8, bits_of_int(8, H), 31), bits_shl(8, bits_of_int(8, R), 5)) = int_add(int_mod(H, 32), int_mul(32, int_sub(int_sub(e, p), n)))
      by defs(simp(z, eR, h0, pne), bits_add, bits_shl, bits_of_int)
    have sp: mallocng_specs.set_size_vm(V0, p, e, n) = fn_update(V0, "bytes", x86_64_linux.store_le(app(V0, "bytes"), bits_sub(64, p, 3), 1,
        int_add(int_mod(H, 32), int_mul(32, int_sub(int_sub(e, p), n)))))
      by defs(simp(h0, pne, ms.v_wr8, ms.v_wr32), mallocng_specs.set_size_vm, mallocng_specs.reserved)
    have c4 := rewrite(vv, rewrite(a3, c3))
    show := rewrite(sym(sp), c4)
  qed
  show by taut(rpos, rzero)
qed

// C2 of set_size: its readable GIMPLE refines its spec, on every world
theorem ms.set_size_c2: all p e n. p in bits(64) -> e in bits(64) -> n in bits(64) ->
  refines(c_src_malloc_mallocng_malloc.set_size(p, e, n), mallocng_specs.set_size_spec(p, e, n), abi.World)
proof
  fix p e n
  assume hp he hn
  have g: all s o. s in abi.World -> runs(c_src_malloc_mallocng_malloc.set_size(p, e, n), s, o) -> runs(mallocng_specs.set_size_spec(p, e, n), s, o) proof
    fix s o
    assume hw hr
    let V0 := app(s, "vm")
    have pu := apply(g.runs_univ, hr)
    have hu: s in univ(1) by simp(pu)
    have np: !mallocng_specs.set_size_pre(V0, app(s, "objs"), p, e, n) -> runs(mallocng_specs.set_size_spec(p, e, n), s, o) proof
      assume hn0
      show by simp(pu, hn0, keep(abi.overflow, mallocng_specs.set_size_pre, mallocng_specs.set_size_vm))
    qed
    have yp: mallocng_specs.set_size_pre(V0, app(s, "objs"), p, e, n) -> runs(mallocng_specs.set_size_spec(p, e, n), s, o) proof
      assume hpre
      have oe := apply(ms.ss_run, {p}, {e}, {n}, {s}, {o}, hp, he, hn, hw, hu, hpre, hr)
      show by simp(oe, pu, hpre, keep(abi.overflow, mallocng_specs.set_size_pre, mallocng_specs.set_size_vm))
    qed
    show by taut(np, yp)
  qed
  show g
qed

// set_size as a C function value: its register wrapper refines the spec's
theorem ms.set_size_fun_c2: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
  runs(app(c_src_malloc_mallocng_malloc.set_size_fun(), regs), s, o) -> runs(app(mallocng_specs.set_size_spec_fun(), regs), s, o)
proof
  fix regs s o
  assume hr hl hw h
  have lo: seq_len(regs) in omega by simp(hr)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(hl, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(hr, ol, keep(ord_le))
  rsimp only, c_src_malloc_mallocng_malloc.set_size_fun, app_fn_build, ra in h
  rsimp only, mallocng_specs.set_size_spec_fun, app_fn_build, ra
  have pu := apply(g.runs_univ, h)
  have r := apply(g.runs_elim, h)
  let A0 := bits_of_int(64, app(regs, 0))
  let A1 := bits_of_int(64, app(regs, 1))
  let A2 := bits_of_int(64, app(regs, 2))
  have dc := expand(all_elim(ms.set_size_c2, {A0}, {A1}, {A2}), refines)
  have hm: all o2. runs(c_src_malloc_mallocng_malloc.set_size(A0, A1, A2), s, o2) -> runs(mallocng_specs.set_size_spec(A0, A1, A2), s, o2) proof
    fix o2
    assume h2
    show := mp(all_elim(mp(dc, simp(), simp(), simp()), {s}, {o2}), hw, h2)
  qed
  have c1: !ord_le(3, seq_len(regs)) -> runs(mkprog(x1 x2. !ord_le(3, seq_len(regs)) || bind_rel(mallocng_specs.set_size_spec(A0, A1, A2), x1,
      x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. x2 = ok(x3, pair(x5, x6)))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), s, o) proof
    assume hn
    show by apply(tr.runs_intro, pu, taut(hn))
  qed
  have c2: bind_rel(c_src_malloc_mallocng_malloc.set_size(A0, A1, A2), s,
      x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o = ok(x3, pair(x5, x6)))), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) ->
      runs(mkprog(x1 x2. !ord_le(3, seq_len(regs)) || bind_rel(mallocng_specs.set_size_spec(A0, A1, A2), x1,
      x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. x2 = ok(x3, pair(x5, x6)))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), s, o) proof
    assume hb
    have b2 := apply(g.bind_mono, hm, hb)
    show by apply(tr.runs_intro, pu, taut(b2))
  qed
  show by taut(r, c1, c2)
qed

// ----------------------------------------------------------------------
//  get_stride: a group's slot size, from struct meta's bitfield word at
//  g + 32 (read in parts by GIMPLE: its byte, 2 bytes, the word, 7 bytes
//  from g + 33) and the size classes' table

// get_stride's reads of struct meta's bitfield word at g + 32 (the byte, 2
// bytes, the word, 7 bytes from g + 33), as the spec's word W (mword)
theorem ms.gs_word: all vm g. app(vm, "bytes") in fn_space(bits(64), bits(8)) -> g in bits(64) -> int_le(int_add(g, 40), int_pow(2, 64)) ->
  int_add(g, 32) = bits_add(64, g, 32) &&
  gimple.bytes_at(vm, int_add(g, 32), 8) in bits(64) &&
  bits_and(8, bits_of_int(8, int_mod(int_div(gimple.bytes_at(vm, int_add(g, 32), 1), int_pow(2, 0)), int_pow(2, 8))), 31) = int_mod(gimple.bytes_at(vm, int_add(g, 32), 8), 32) &&
  bits_and(64, bits_of_int(64, int_mod(int_div(gimple.bytes_at(vm, int_add(g, 32), 8), int_pow(2, 0)), int_pow(2, 64))), bits_neg(64, 4096)) =
    int_mul(int_div(gimple.bytes_at(vm, int_add(g, 32), 8), 4096), 4096) &&
  bits_of_int(52, int_mod(int_div(gimple.bytes_at(vm, int_add(g, 33), 7), int_pow(2, 4)), int_pow(2, 52))) = int_div(gimple.bytes_at(vm, int_add(g, 32), 8), 4096) &&
  bits_of_int(6, int_mod(int_div(gimple.bytes_at(vm, int_add(g, 32), 2), int_pow(2, 6)), int_pow(2, 6))) = int_mod(int_div(gimple.bytes_at(vm, int_add(g, 32), 8), 64), 64)
proof
  fix vm g
  assume hb hg h40
  let A := int_add(g, 32)
  let W := gimple.bytes_at(vm, A, 8)
  let B1 := gimple.bytes_at(vm, A, 1)
  let B2 := gimple.bytes_at(vm, A, 2)
  let B7 := gimple.bytes_at(vm, int_add(g, 33), 7)
  let B6 := gimple.bytes_at(vm, int_add(g, 34), 6)
  have a32: A = bits_add(64, g, 32) by defs(arith(hg, h40), bits_add, pow2)
  have ab: A in bits(64) by arith(hg, h40)
  have a33: bits_add(64, A, 1) = int_add(g, 33) by defs(arith(hg, h40), bits_add, pow2)
  have a34: bits_add(64, A, 2) = int_add(g, 34) by defs(arith(hg, h40), bits_add, pow2)
  // (the word: the byte and 7 above it; 2 bytes and 6 above them)
  have s17 := mp(all_elim(g.bytes_split, {vm}, {A}, {1}, {7}), ab, simp(), simp())
  have s26 := mp(all_elim(g.bytes_split, {vm}, {A}, {2}, {6}), ab, simp(), simp())
  have w17: W = int_add(B1, int_mul(256, B7)) by simp(s17, a33)
  have w26: W = int_add(B2, int_mul(65536, B6)) by simp(s26, a34)
  have b1o b1l := mp(all_elim(g.bytes_bound, {vm}, {A}, {1}), hb, simp())
  have b2o b2l := mp(all_elim(g.bytes_bound, {vm}, {A}, {2}), hb, simp())
  have b7o b7l := mp(all_elim(g.bytes_bound, {vm}, {int_add(g, 33)}, {7}), hb, simp())
  have b6o b6l := mp(all_elim(g.bytes_bound, {vm}, {int_add(g, 34)}, {6}), hb, simp())
  have wo wl := mp(all_elim(g.bytes_bound, {vm}, {A}, {8}), hb, simp())
  have b1v: int_lt(B1, 256) by simp(b1l)
  have b2v: int_lt(B2, 65536) by simp(b2l)
  have b7v: int_lt(B7, 72057594037927936) by simp(b7l)
  have b6v: int_lt(B6, 281474976710656) by simp(b6l)
  have wv: int_lt(W, 18446744073709551616) by simp(wl)
  have pw: int_pow(2, 0) = 1 && int_pow(2, 4) = 16 && int_pow(2, 6) = 64 && int_pow(2, 8) = 256 && int_pow(2, 52) = 4503599627370496 && int_pow(2, 64) = 18446744073709551616
    by simp()
  // (the byte's low 5 bits: W's)
  have bb1: B1 in bits(8) by arith(b1o, b1v)
  have e1L: int_mod(int_div(B1, 1), 256) = B1 by arith(b1o, b1v)
  have e1: bits_of_int(8, int_mod(int_div(B1, int_pow(2, 0)), int_pow(2, 8))) = B1 by simp(pw, e1L, bb1)
  have m1: bits_and(8, B1, 31) = int_mod(B1, 32) by bitwise({8}, bb1)
  have m1w: int_mod(B1, 32) = int_mod(W, 32) by arith(w17, b1o, b1v, b7o, b7v)
  have g1: bits_and(8, bits_of_int(8, int_mod(int_div(B1, int_pow(2, 0)), int_pow(2, 8))), 31) = int_mod(W, 32) by simp(e1, m1, m1w)
  // (the word above its low 12 bits)
  have wb: W in bits(64) by arith(wo, wv)
  have e2L: int_mod(int_div(W, 1), 18446744073709551616) = W by arith(wo, wv)
  have e2: bits_of_int(64, int_mod(int_div(W, int_pow(2, 0)), int_pow(2, 64))) = W by simp(pw, e2L, wb)
  have nm: bits_neg(64, 4096) = bits_not(64, 4095) by simp()
  have m2: bits_and(64, W, bits_not(64, 4095)) = int_mul(int_div(W, 4096), 4096) by bitwise({64}, wb)
  have g2: bits_and(64, bits_of_int(64, int_mod(int_div(W, int_pow(2, 0)), int_pow(2, 64))), bits_neg(64, 4096)) = int_mul(int_div(W, 4096), 4096) by simp(e2, nm, m2)
  // (maplen: 7 bytes from g + 33 shifted by 4 -- W's bits from 12)
  have g3L: int_mod(int_div(B7, 16), 4503599627370496) = int_div(W, 4096) by arith(w17, b1o, b1v, b7o, b7v)
  have g3b: int_div(W, 4096) in bits(52) by arith(wo, wv)
  have g3: bits_of_int(52, int_mod(int_div(B7, int_pow(2, 4)), int_pow(2, 52))) = int_div(W, 4096) by simp(pw, g3L, g3b)
  // (sizeclass: 2 bytes' bits 6..11 -- W's)
  have g4L: int_mod(int_div(B2, 64), 64) = int_mod(int_div(W, 64), 64) by arith(w26, b2o, b2v, b6o, b6v)
  have g4b: int_mod(int_div(W, 64), 64) in bits(6) by arith(wo, wv)
  have g4: bits_of_int(6, int_mod(int_div(B2, int_pow(2, 6)), int_pow(2, 6))) = int_mod(int_div(W, 64), 64) by simp(pw, g4L, g4b)
  show by taut(a32, wb, g1, g2, g3, g4)
qed

theorem ms.sizeclass_det: all s p. s in univ(1) -> p in bits(64) -> g.mem_defined(s, p, 32, 2, false) ->
  g.det(c_src_malloc_mallocng_malloc.meta_sizeclass(p), s, ok(s, bits_of_int(6, int_mod(int_div(gimple.bytes_at(app(s, "vm"), int_add(p, 32), 2), int_pow(2, 6)), int_pow(2, 6)))))
proof
  fix s p
  assume hs hp hd
  have ld := apply(g.ldbf_det, {s}, {p}, {32}, {2}, {6}, {6}, hs, hp, simp(), hd)
  show proof
    fix o
    assume hr
    step oe from hr with ld
    show oe
  qed
qed

theorem ms.maplen_det: all s p. s in univ(1) -> p in bits(64) -> g.mem_defined(s, p, 33, 7, false) ->
  g.det(c_src_malloc_mallocng_malloc.meta_maplen(p), s, ok(s, bits_of_int(52, int_mod(int_div(gimple.bytes_at(app(s, "vm"), int_add(p, 33), 7), int_pow(2, 4)), int_pow(2, 52)))))
proof
  fix s p
  assume hs hp hd
  have ld := apply(g.ldbf_det, {s}, {p}, {33}, {7}, {4}, {52}, hs, hp, simp(), hd)
  show proof
    fix o
    assume hr
    step oe from hr with ld
    show oe
  qed
qed

theorem ms.imul_16: tr.imul_by(16)
proof
  have g: all y. y in bits(32) -> bits_add(32, int_mul(sint(32, y), sint(32, 16)), 0) = bits_mul(32, y, 16) proof
    fix y
    assume hy: y in bits(32)
    have c1: int_lt(y, 2147483648) -> bits_add(32, int_mul(sint(32, y), 16), 0) = bits_mul(32, y, 16) proof
      assume hl: int_lt(y, 2147483648)
      show by defs(simp(hy, hl), bits_add, bits_mul, sint)
    qed
    have c2: !int_lt(y, 2147483648) -> bits_add(32, int_mul(sint(32, y), 16), 0) = bits_mul(32, y, 16) proof
      assume hl: !int_lt(y, 2147483648)
      have e: int_mod(int_mul(int_sub(y, 4294967296), 16), 4294967296) = int_mod(int_mul(y, 16), 4294967296) by arith(hy)
      show by defs(simp(hy, hl, e), bits_add, bits_mul, sint)
    qed
    have e: bits_add(32, int_mul(sint(32, y), 16), 0) = bits_mul(32, y, 16) by taut(c1, c2)
    show by simp(e)
  qed
  show by defs(g, tr.imul_by)
qed

// (a unit times a class's entry, as GIMPLE computes it: a 32-bit product,
// sign-extended)
theorem ms.sext_mul16: all x. x in omega -> int_le(x, 8191) -> bits_sext(32, 64, bits_mul(32, x, 16)) = int_mul(16, x)
proof
  fix x
  assume ho hl
  have m: bits_mul(32, x, 16) = int_mul(16, x) by defs(arith(ho, hl), bits_mul, pow2)
  have sx := apply(ms.sint_small, (int_mul(16, x) in omega by arith(ho)), (int_lt(int_mul(16, x), 2147483648) by arith(ho, hl)))
  have t31: int_mul(16, x) in bits(31) by arith(ho, hl)
  show by simp(m, t31)
qed

theorem ms.gs_run: all g s o. g in bits(64) -> s in abi.World -> s in univ(1) ->
  mallocng_specs.get_stride_pre(app(s, "vm"), app(s, "objs"), c_src_malloc_mallocng_malloc.__malloc_size_classes, g) ->
  runs(c_src_malloc_mallocng_malloc.get_stride(g), s, o) -> o = ok(s, bits_of_int(64, mallocng_specs.stride_w(app(s, "vm"), g)))
proof
  fix g s o
  assume hg hw hu hpre hr
  let V0 := app(s, "vm")
  let O := app(s, "objs")
  let W := gimple.bytes_at(V0, int_add(g, 32), 8)
  have gnz g40 u8 rest := expand(hpre, mallocng_specs.get_stride_pre)
  have pv pf pd pb := apply(ms.world_parts, hw)
  have a32 wb g1 g2 g3 g4 := mp(all_elim(ms.gs_word, {V0}, {g}), pb, hg, g40)
  have g32: int_lt(int_add(g, 32), pow2(64)) by defs(arith(g40), pow2)
  have g33: int_lt(int_add(g, 33), pow2(64)) by defs(arith(g40), pow2)
  have u1 := mp(all_elim(ms.usable_part, {V0}, {O}, {int_add(g, 32)}, {8}, {int_add(g, 32)}, {1}, {false}), arith(hg), arith(hg), arith(), arith(), u8)
  have u2 := mp(all_elim(ms.usable_part, {V0}, {O}, {int_add(g, 32)}, {8}, {int_add(g, 32)}, {2}, {false}), arith(hg), arith(hg), arith(), arith(), u8)
  have u7 := mp(all_elim(ms.usable_part, {V0}, {O}, {int_add(g, 32)}, {8}, {int_add(g, 33)}, {7}, {false}), arith(hg), arith(hg), arith(), arith(), u8)
  have md1: g.mem_defined(s, g, 32, 1, false) by simp(gnz, u1, g32)
  have md2: g.mem_defined(s, g, 32, 2, false) by simp(gnz, u2, g32)
  have md7: g.mem_defined(s, g, 33, 7, false) by simp(gnz, u7, g33)
  have md8: g.mem_defined(s, g, 32, 8, false) by simp(gnz, u8, g32)
  have ld1 := apply(g.ldbf_det, {s}, {g}, {32}, {1}, {0}, {8}, hu, hg, simp(), md1)
  have ld8 := apply(g.ldbf_det, {s}, {g}, {32}, {8}, {0}, {64}, hu, hg, simp(), md8)
  have mld := apply(ms.maplen_det, {s}, {g}, hu, hg, md7)
  have scd := apply(ms.sizeclass_det, {s}, {g}, hu, hg, md2)
  // (the spec's word: W)
  have mw: mallocng_specs.mword(V0, g) = W by defs(simp(a32), mallocng_specs.mword)
  // a single slot mapped on its own
  have cm: int_mod(W, 32) = 0 -> !(int_div(W, 4096) = 0) -> o = ok(s, bits_of_int(64, mallocng_specs.stride_w(V0, g))) proof
    assume h1 h2
    have G1: bits_and(8, bits_of_int(8, int_mod(int_div(gimple.bytes_at(V0, int_add(g, 32), 1), int_pow(2, 0)), int_pow(2, 8))), 31) = 0 by simp(g1, h1)
    have T4: !(bits_and(64, bits_of_int(64, int_mod(int_div(W, int_pow(2, 0)), int_pow(2, 64))), bits_neg(64, 4096)) = 0) by simp(g2, h2)
    step x2 x4 x6 i1, c1 from hr with ld1, G1, ld8
    have cL cR := c1
    step i3, c2 from cL with T4, mld
    let M := bits_of_int(52, int_mod(int_div(gimple.bytes_at(V0, int_add(g, 33), 7), int_pow(2, 4)), int_pow(2, 52)))
    let VAL := bits_add(64, bits_mul(64, M, 4096), bits_neg(64, 16))
    have r2 := rewrite(c2, cR)
    have c3: o = ok(s, VAL) by simp(r2)
    // (the value: maplen pages less a unit)
    let Q := int_div(W, 4096)
    have qb: Q in omega && int_lt(Q, 4503599627370496) by arith(wb)
    have v1: VAL = bits_add(64, bits_mul(64, Q, 4096), bits_neg(64, 16)) by simp(g3)
    have v2: bits_add(64, bits_mul(64, Q, 4096), bits_neg(64, 16)) = int_sub(int_mul(Q, 4096), 16) by defs(arith(qb, h2), bits_add, bits_mul, bits_neg, bits_of_int, pow2)
    have ms1: mallocng_specs.mapped_single(V0, g) by defs(simp(mw, h1, h2), mallocng_specs.mapped_single)
    have sw: mallocng_specs.stride_w(V0, g) = int_sub(int_mul(Q, 4096), 16) by defs(simp(ms1, mw), mallocng_specs.stride_w, mallocng.UNIT)
    have sb: bits_of_int(64, int_sub(int_mul(Q, 4096), 16)) = int_sub(int_mul(Q, 4096), 16) by defs(arith(qb, h2), bits_of_int, pow2)
    show by simp(c3, v1, v2, sw, sb)
  qed
  // the class's entry (the group not a single slot mapped on its own)
  let SCT := c_src_malloc_mallocng_malloc.__malloc_size_classes
  let SC6 := bits_of_int(6, int_mod(int_div(gimple.bytes_at(V0, int_add(g, 32), 2), int_pow(2, 6)), int_pow(2, 6)))
  let C := int_mod(int_div(W, 64), 64)
  let A16 := bits_of_int(16, app(mallocng.size_classes, sint(32, SC6)))
  have sctb: SCT in bits(64) by defs(simp(), c_src_malloc_mallocng_malloc.__malloc_size_classes)
  have sctnz: !(SCT = 0) by defs(simp(), c_src_malloc_mallocng_malloc.__malloc_size_classes)
  have ccl: !mallocng_specs.mapped_single(V0, g) -> runs(c_src_malloc_mallocng_malloc.get_stride(g), s, o) -> o = ok(s, bits_of_int(64, mallocng_specs.stride_w(V0, g))) proof
    assume hnm hr2
    have c48 tok := mp(rest, hnm)
    have c48w: int_lt(C, 48) by simp(c48, mw)
    have co: C in omega by arith(wb)
    have e6: SC6 = C by simp(g4)
    have sC := apply(ms.sint_small, co, (int_lt(C, 2147483648) by arith(c48w, co)))
    have sI: sint(32, SC6) = C by simp(e6, sC)
    have I32: SC6 in bits(32) by simp(e6, co, c48w)
    have rd ld := apply(ms.tab_rd, {s}, {SCT}, {SC6}, {mallocng.size_classes}, hu, sctb, sctnz, I32, (int_le(0, sint(32, SC6)) by simp(sI, co)),
      (int_lt(sint(32, SC6), seq_len(mallocng.size_classes)) by simp(sI, c48w, ms.sc_len)), tok)
    have eo el := apply(ms.sc_nat, co, c48w)
    have a16: A16 = app(mallocng.size_classes, C) by defs(simp(sI, eo, el), bits_of_int, pow2)
    have a32b: A16 in bits(32) by simp(a16, eo, el)
    have sA := apply(ms.sint_small, (A16 in omega by simp(a16, eo)), (int_lt(A16, 2147483648) by simp(a16, eo, el)))
    have f: tr.s32_fits(int_mul(sint(32, A16), sint(32, 16))) by defs(simp(sA, a16, eo, el), gimple.fits)
    have sm := apply(g.smul32_det, {s}, {A16}, {16}, hu, a32b, simp(), ms.imul_16, f)
    // (the value: a unit times the class's entry)
    let E := app(mallocng.size_classes, C)
    have vc0 := mp(all_elim(ms.sext_mul16, {E}), eo, el)
    have vc := rewrite(sym(a16), vc0, {1})
    have sw: mallocng_specs.stride_w(V0, g) = int_mul(16, E) by defs(simp(hnm, mw), mallocng_specs.stride_w, mallocng.UNIT)
    have sb: bits_of_int(64, int_mul(16, E)) = int_mul(16, E) by defs(arith(eo, el), bits_of_int, pow2)
    have val: bits_sext(32, 64, bits_mul(32, A16, 16)) = bits_of_int(64, mallocng_specs.stride_w(V0, g)) by simp(vc, sw, sb)
    // (no last_idx 0: on to the class)
    have ca: !(int_mod(W, 32) = 0) -> o = ok(s, bits_of_int(64, mallocng_specs.stride_w(V0, g))) proof
      assume h1
      have G1n: !(bits_and(8, bits_of_int(8, int_mod(int_div(gimple.bytes_at(V0, int_add(g, 32), 1), int_pow(2, 0)), int_pow(2, 8))), 31) = 0) by simp(g1, h1)
      step x2 x4 x6 i1, c1 from hr2 with ld1, G1n, scd, rd, ld, sm
      show := rewrite(val, c1)
    qed
    // (last_idx 0, no mapping of its own: the word tested, then the class)
    have cb: int_mod(W, 32) = 0 -> int_div(W, 4096) = 0 -> o = ok(s, bits_of_int(64, mallocng_specs.stride_w(V0, g))) proof
      assume h1 h2
      have G1: bits_and(8, bits_of_int(8, int_mod(int_div(gimple.bytes_at(V0, int_add(g, 32), 1), int_pow(2, 0)), int_pow(2, 8))), 31) = 0 by simp(g1, h1)
      have T4z: !!(bits_and(64, bits_of_int(64, int_mod(int_div(W, int_pow(2, 0)), int_pow(2, 64))), bits_neg(64, 4096)) = 0) by simp(g2, h2)
      step x2 x4 x6 i1, c1 from hr2 with ld1, G1, ld8
      have cL cR := c1
      step i3, c2 from cL with T4z
      have r2 := rewrite(c2, cR)
      step c3 from r2 with scd, rd, ld, sm
      show := rewrite(val, c3)
    qed
    have hm: !mallocng_specs.mapped_single(V0, g) -> !(int_mod(W, 32) = 0) || int_div(W, 4096) = 0 by defs(simp(mw), mallocng_specs.mapped_single)
    show by taut(ca, cb, mp(hm, hnm))
  qed
  have hm2: mallocng_specs.mapped_single(V0, g) -> int_mod(W, 32) = 0 && !(int_div(W, 4096) = 0) by defs(simp(mw), mallocng_specs.mapped_single)
  have cms: mallocng_specs.mapped_single(V0, g) -> o = ok(s, bits_of_int(64, mallocng_specs.stride_w(V0, g))) proof
    assume hms
    have h1 h2 := mp(hm2, hms)
    show := mp(cm, h1, h2)
  qed
  have cnm: !mallocng_specs.mapped_single(V0, g) -> o = ok(s, bits_of_int(64, mallocng_specs.stride_w(V0, g))) proof
    assume hn
    show := mp(ccl, hn, hr)
  qed
  show by taut(cms, cnm)
qed

// C2 of get_stride: its readable GIMPLE refines its spec, on every world
theorem ms.get_stride_c2: all g. g in bits(64) ->
  refines(c_src_malloc_mallocng_malloc.get_stride(g), mallocng_specs.get_stride_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, g), abi.World)
proof
  fix g
  assume hg
  have c: all s o. s in abi.World -> runs(c_src_malloc_mallocng_malloc.get_stride(g), s, o) -> runs(mallocng_specs.get_stride_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, g), s, o) proof
    fix s o
    assume hw hr
    have pu := apply(g.runs_univ, hr)
    have hu: s in univ(1) by simp(pu)
    have np: !mallocng_specs.get_stride_pre(app(s, "vm"), app(s, "objs"), c_src_malloc_mallocng_malloc.__malloc_size_classes, g) -> runs(mallocng_specs.get_stride_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, g), s, o) proof
      assume hn0
      show by simp(pu, hn0, keep(abi.overflow, mallocng_specs.get_stride_pre, mallocng_specs.stride_w))
    qed
    have yp: mallocng_specs.get_stride_pre(app(s, "vm"), app(s, "objs"), c_src_malloc_mallocng_malloc.__malloc_size_classes, g) -> runs(mallocng_specs.get_stride_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, g), s, o) proof
      assume hpre
      have oe := apply(ms.gs_run, {g}, {s}, {o}, hg, hw, hu, hpre, hr)
      show by simp(oe, pu, hpre, keep(abi.overflow, mallocng_specs.get_stride_pre, mallocng_specs.stride_w))
    qed
    show by taut(np, yp)
  qed
  show by defs(c, refines)
qed

// get_stride as a C function value: its register wrapper refines the spec's
// (get_stride's spec returns a word, under its precondition)
theorem ms.gs_ret_word: all g s s1 v. s in abi.World -> runs(mallocng_specs.get_stride_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, g), s, ok(s1, v)) ->
  mallocng_specs.get_stride_pre(app(s, "vm"), app(s, "objs"), c_src_malloc_mallocng_malloc.__malloc_size_classes, g) -> v in bits(64)
proof
  fix g s s1 v
  assume hw h hp
  have vv: ex x. x in x86_64_linux.Vm by ex_intro({app(s, "vm")}, simp(expand(hw, abi.World)))
  have no: all x. !runs(abi.overflow, s, ok(s1, x)) proof
    fix x
    have c: runs(abi.overflow, s, ok(s1, x)) -> false proof
      assume ho
      show by simp(ho, vv)
    qed
    show by taut(c)
  qed
  have e: v = bits_of_int(64, mallocng_specs.stride_w(app(s, "vm"), g)) by simp(h, hp, no, keep(abi.overflow, mallocng_specs.get_stride_pre, mallocng_specs.stride_w))
  show := rewrite(sym(e), (bits_of_int(64, mallocng_specs.stride_w(app(s, "vm"), g)) in bits(64) by simp()))
qed

theorem ms.get_stride_fun_c2: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
  runs(app(c_src_malloc_mallocng_malloc.get_stride_fun(), regs), s, o) -> runs(app(mallocng_specs.get_stride_spec_fun(c_src_malloc_mallocng_malloc.__malloc_size_classes), regs), s, o)
proof
  fix regs s o
  assume hr hl hw h
  have lo: seq_len(regs) in omega by simp(hr)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(hl, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(hr, ol, keep(ord_le))
  rsimp only, c_src_malloc_mallocng_malloc.get_stride_fun, app_fn_build, ra in h
  rsimp only, mallocng_specs.get_stride_spec_fun, app_fn_build, ra
  have pu := apply(g.runs_univ, h)
  have su: s in univ(1) by simp(pu)
  have r := apply(g.runs_elim, h)
  have a0: bits_of_int(64, app(regs, 0)) in bits(64) by simp()
  have c1: !ord_le(1, seq_len(regs)) -> runs(mkprog(x0 x1. !ord_le(1, seq_len(regs)) || bind_rel(mallocng_specs.get_stride_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, bits_of_int(64, app(regs, 0))), x0, x2 x3. letin(x3, x4. any_rel(x5. x5 in bits(64), x5. x1 = ok(x2, pair(x4, x5)))), x2 x3. x1 = exc(x2, x3), x2. x1 = diverge(x2))), s, o) proof
    assume hn
    show by apply(tr.runs_intro, pu, taut(hn))
  qed
  // the precondition: the spec's run is the code's (C2), its result a word
  have c2: mallocng_specs.get_stride_pre(app(s, "vm"), app(s, "objs"), c_src_malloc_mallocng_malloc.__malloc_size_classes, bits_of_int(64, app(regs, 0))) -> bind_rel(c_src_malloc_mallocng_malloc.get_stride(bits_of_int(64, app(regs, 0))), s, x2 x3. letin(x3, x4. bind_rel(gimple.result(64, x4), x2, x5 x6. any_rel(x7. x7 in bits(64), x7. o = ok(x5, pair(x6, x7))), x5 x6. o = exc(x5, x6), x5. o = diverge(x5))), x2 x3. o = exc(x2, x3), x2. o = diverge(x2)) -> runs(mkprog(x0 x1. !ord_le(1, seq_len(regs)) || bind_rel(mallocng_specs.get_stride_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, bits_of_int(64, app(regs, 0))), x0, x2 x3. letin(x3, x4. any_rel(x5. x5 in bits(64), x5. x1 = ok(x2, pair(x4, x5)))), x2 x3. x1 = exc(x2, x3), x2. x1 = diverge(x2))), s, o) proof
    assume hp hb
    have dc := expand(all_elim(ms.get_stride_c2, {bits_of_int(64, app(regs, 0))}), refines)
    have hm: all o2. runs(c_src_malloc_mallocng_malloc.get_stride(bits_of_int(64, app(regs, 0))), s, o2) -> runs(mallocng_specs.get_stride_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, bits_of_int(64, app(regs, 0))), s, o2) proof
      fix o2
      assume h2
      show := mp(all_elim(mp(dc, a0), {s}, {o2}), hw, h2)
    qed
    have b2 := apply(g.bind_mono, hm, hb)
    have kk: all s1 v. runs(mallocng_specs.get_stride_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, bits_of_int(64, app(regs, 0))), s, ok(s1, v)) -> letin(v, x4. bind_rel(gimple.result(64, x4), s1, x5 x6. any_rel(x7. x7 in bits(64), x7. o = ok(x5, pair(x6, x7))), x5 x6. o = exc(x5, x6), x5. o = diverge(x5))) ->
        letin(v, x4. any_rel(x5. x5 in bits(64), x5. o = ok(s1, pair(x4, x5)))) proof
      fix s1 v
      assume hs hk
      have vb := apply(ms.gs_ret_word, hw, hs, hp)
      obtain o3, h3 hc from expand(apply(g.letin_e, hk), bind_rel)
      have e3 := apply(g.result64_inv, vb, h3)
      have hc2 := rewrite(e3, hc)
      have k: any_rel(x7. x7 in bits(64), x7. o = ok(s1, pair(v, x7))) by simp(hc2, keep(any_rel))
      show by defs(k, letin)
    qed
    have b3 := apply(g.bind_cont, kk, b2)
    show by apply(tr.runs_intro, pu, taut(b3))
  qed
  // no precondition: the spec allows every outcome, the code's too
  have c3: !mallocng_specs.get_stride_pre(app(s, "vm"), app(s, "objs"), c_src_malloc_mallocng_malloc.__malloc_size_classes, bits_of_int(64, app(regs, 0))) -> bind_rel(c_src_malloc_mallocng_malloc.get_stride(bits_of_int(64, app(regs, 0))), s, x2 x3. letin(x3, x4. bind_rel(gimple.result(64, x4), x2, x5 x6. any_rel(x7. x7 in bits(64), x7. o = ok(x5, pair(x6, x7))), x5 x6. o = exc(x5, x6), x5. o = diverge(x5))), x2 x3. o = exc(x2, x3), x2. o = diverge(x2)) -> runs(mkprog(x0 x1. !ord_le(1, seq_len(regs)) || bind_rel(mallocng_specs.get_stride_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, bits_of_int(64, app(regs, 0))), x0, x2 x3. letin(x3, x4. any_rel(x5. x5 in bits(64), x5. x1 = ok(x2, pair(x4, x5)))), x2 x3. x1 = exc(x2, x3), x2. x1 = diverge(x2))), s, o) proof
    assume hn hb
    have any: all o2. pair(s, o2) in univ(1) -> runs(mallocng_specs.get_stride_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, bits_of_int(64, app(regs, 0))), s, o2) proof
      fix o2
      assume hu
      show by simp(hu, hn, keep(abi.overflow, mallocng_specs.get_stride_pre, mallocng_specs.stride_w))
    qed
    obtain o1, h1 hc from expand(hb, bind_rel, {1})
    have pu1 := apply(g.runs_univ, expand(h1, c_src_malloc_mallocng_malloc.get_stride))
    // (the first step's outcome o1 is the spec's: but for a return, whose
    // value the result step turns into rax)
    have q1: (ex s1 v. o1 = ok(s1, v) && letin(v, x4. bind_rel(gimple.result(64, x4), s1, x5 x6. any_rel(x7. x7 in bits(64), x7. o = ok(x5, pair(x6, x7))), x5 x6. o = exc(x5, x6), x5. o = diverge(x5)))) ->
        bind_rel(mallocng_specs.get_stride_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, bits_of_int(64, app(regs, 0))), s, x2 x3. letin(x3, x4. any_rel(x5. x5 in bits(64), x5. o = ok(x2, pair(x4, x5)))), x2 x3. o = exc(x2, x3), x2. o = diverge(x2)) proof
      assume e
      obtain s1 v, eo hk from e
      obtain o3, h3 hc3 from expand(apply(g.letin_e, hk), bind_rel)
      have pu3 := apply(g.runs_univ, expand(h3, gimple.result))
      have r1: (ex x5 x6. o3 = ok(x5, x6) && any_rel(x7. x7 in bits(64), x7. o = ok(x5, pair(x6, x7)))) -> bind_rel(mallocng_specs.get_stride_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, bits_of_int(64, app(regs, 0))), s, x2 x3. letin(x3, x4. any_rel(x5. x5 in bits(64), x5. o = ok(x2, pair(x4, x5)))), x2 x3. o = exc(x2, x3), x2. o = diverge(x2)) proof
        assume e2
        obtain x5 x6, eo3 ha from e2
        have u: pair(s, ok(x5, x6)) in univ(1) by simp(rewrite(eo3, pu3), su)
        have sr := mp(all_elim(any, {ok(x5, x6)}), u)
        show by defs(ex_intro({ok(x5, x6)}, simp(sr, ha, keep(mallocng_specs.get_stride_spec, any_rel))), bind_rel)
      qed
      have r2: (ex x5 x6. o3 = exc(x5, x6) && o = exc(x5, x6)) -> bind_rel(mallocng_specs.get_stride_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, bits_of_int(64, app(regs, 0))), s, x2 x3. letin(x3, x4. any_rel(x5. x5 in bits(64), x5. o = ok(x2, pair(x4, x5)))), x2 x3. o = exc(x2, x3), x2. o = diverge(x2)) proof
        assume e2
        obtain x5 x6, eo3 eo from e2
        have u: pair(s, exc(x5, x6)) in univ(1) by simp(rewrite(eo3, pu3), su)
        have sr := mp(all_elim(any, {exc(x5, x6)}), u)
        show by defs(ex_intro({exc(x5, x6)}, simp(sr, eo, keep(mallocng_specs.get_stride_spec))), bind_rel)
      qed
      have r3: (ex t. o3 = diverge(t) && o = diverge(t)) -> bind_rel(mallocng_specs.get_stride_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, bits_of_int(64, app(regs, 0))), s, x2 x3. letin(x3, x4. any_rel(x5. x5 in bits(64), x5. o = ok(x2, pair(x4, x5)))), x2 x3. o = exc(x2, x3), x2. o = diverge(x2)) proof
        assume e2
        obtain t, eo3 eo from e2
        have u: pair(s, diverge(t)) in univ(1) by simp(rewrite(eo3, pu3), su)
        have sr := mp(all_elim(any, {diverge(t)}), u)
        show by defs(ex_intro({diverge(t)}, simp(sr, eo, keep(mallocng_specs.get_stride_spec))), bind_rel)
      qed
      show by taut(hc3, r1, r2, r3)
    qed
    have q2: (ex s1 e. o1 = exc(s1, e) && o = exc(s1, e)) -> bind_rel(mallocng_specs.get_stride_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, bits_of_int(64, app(regs, 0))), s, x2 x3. letin(x3, x4. any_rel(x5. x5 in bits(64), x5. o = ok(x2, pair(x4, x5)))), x2 x3. o = exc(x2, x3), x2. o = diverge(x2)) proof
      assume e
      obtain s1 e1, eo eo2 from e
      have sr := mp(all_elim(any, {o1}), pu1)
      show by defs(ex_intro({o1}, simp(sr, eo, eo2, keep(mallocng_specs.get_stride_spec))), bind_rel)
    qed
    have q3: (ex t. o1 = diverge(t) && o = diverge(t)) -> bind_rel(mallocng_specs.get_stride_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, bits_of_int(64, app(regs, 0))), s, x2 x3. letin(x3, x4. any_rel(x5. x5 in bits(64), x5. o = ok(x2, pair(x4, x5)))), x2 x3. o = exc(x2, x3), x2. o = diverge(x2)) proof
      assume e
      obtain t, eo eo2 from e
      have sr := mp(all_elim(any, {o1}), pu1)
      show by defs(ex_intro({o1}, simp(sr, eo, eo2, keep(mallocng_specs.get_stride_spec))), bind_rel)
    qed
    have b3: bind_rel(mallocng_specs.get_stride_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, bits_of_int(64, app(regs, 0))), s, x2 x3. letin(x3, x4. any_rel(x5. x5 in bits(64), x5. o = ok(x2, pair(x4, x5)))), x2 x3. o = exc(x2, x3), x2. o = diverge(x2)) by taut(hc, q1, q2, q3)
    show by apply(tr.runs_intro, pu, taut(b3))
  qed
  show by taut(r, c1, c2, c3)
qed
