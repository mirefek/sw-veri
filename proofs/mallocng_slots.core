        obtain O2, offz from offy
        obtain M2, ho2b ho2l ho2t hx11 from offz
        have c11 := rewrite(hx11, c10)
        let X11 := pair(s, pair(ENDP, pair(M2, pair(O2, pair(E, pair(SL, pair(SW, x7)))))))
        have os11 := all_elim(g.ok_state, {X11}, {empty})
        step x13, c12 from c11 using F
        have cdis crest := c12
        // the rest, after the slot's header (B: the bytes then; P: p)
        have tail: all B P. fn_update(s, "vm", fn_update(V0, "bytes", B)) in abi.World -> fn_update(s, "vm", fn_update(V0, "bytes", B)) in univ(1) ->
            gimple.bytes_at(fn_update(V0, "bytes", B), int_add(g, 16), 8) = gimple.bytes_at(V0, int_add(g, 16), 8) ->
            gimple.bytes_at(fn_update(V0, "bytes", B), app(s, "fs_base"), 8) = gimple.bytes_at(V0, app(s, "fs_base"), 8) ->
            P in bits(64) -> int_le(E, P) -> int_mod(int_sub(P, E), 16) = 0 -> int_le(int_add(int_add(P, n), 4), int_add(E, SW)) ->
            fn_update(V0, "bytes", B) = ite(int_lt(E, P), mallocng_specs.wr8(mallocng_specs.wr8(mallocng_specs.wr16(V0, bits_of_int(64, int_sub(E, 2)), int_div(int_sub(P, E), mallocng.UNIT)), bits_of_int(64, int_sub(E, 3)), int_mul(7, 32)), bits_sub(64, P, 4), 0), V0) ->
            x13 = ok(pair(fn_update(s, "vm", fn_update(V0, "bytes", B)), pair(ENDP, pair(M2, pair(O2, pair(P, pair(SL, pair(SW, x7))))))), empty) ->
            runs(SPEC, s, o) proof
          fix B P
          assume hbw hbu hrd htb hpb hpe hpm hpl hV hx
          let V1 := fn_update(V0, "bytes", B)
          let S1 := fn_update(s, "vm", V1)
          have c14 := rewrite(hx, crest)
          have os13 := all_elim(g.ok_state, {pair(S1, pair(ENDP, pair(M2, pair(O2, pair(P, pair(SL, pair(SW, x7)))))))}, {empty})
          have u16: gimple.usable(V1, app(s, "objs"), int_add(g, 16), 8, false) := rewrite(sym(all_elim(ms.f_usable, {V0}, {B}, {app(s, "objs")}, {int_add(g, 16)}, {8}, {false})), h16)
          have md16b: g.mem_defined(S1, g, 16, 8, false) by simp(gnz, g16, u16)
          let MEM1 := bits_of_int(64, gimple.bytes_at(V1, int_add(g, 16), 8))
          have m1e: MEM1 = MEM by simp(hrd)
          let A := int_add(MEM1, gimple.sval(T64, 16))
          have ae: A = int_add(MEM, 16) by simp(m1e, sv16)
          have pl63: int_lt(P, 9223372036854775808) by arith(hpl, eb, hn)
          have sP: sint(64, P) = P by defs(simp(hpb, pl63), sint)
          have al: int_le(A, E) && int_lt(A, 9223372036854775808) by arith(ae, ee, mulo, eb, swo)
          have ab: A in bits(64) by arith(ae, al, memb)
          have sA: sint(64, A) = A by defs(simp(ab, al), sint)
