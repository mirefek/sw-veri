// step_seq (musl mallocng, meta.h: `if (ctx.seq == 255) { for (i = 0; i <
// 32; i++) ctx.unmap_seq[i] = 0; ctx.seq = 1; } else ctx.seq++;` at -O0):
// C1 under the ABI. The loop is reasoned about as a loop -- an invariant at
// its head and a variant, the body once for any i -- on both sides: the
// spec by `spec_run` with the invariant (`while_exists`), the machine by
// `symex` to the loop's head and around it once (`abi.run_cut`).
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core core/records.core \
//     core/list.core core/loop.core build/c_mallocng_malloc.core proofs/x86.core proofs/x86_code.core \
//     build/leaf_steps.core proofs/abi.core proofs/abi_restore.core proofs/abi_glue.core proofs/gimple.core \
//     proofs/abi_stack.core proofs/abi_loop.core proofs/abi_bridge.core proofs/step_seq.core

abbrev ss.spec := c_src_malloc_mallocng_malloc.step_seq_fun()
// ctx.seq (at __malloc_context + 912) and ctx.unmap_seq (+ 848, 32 bytes)
abbrev ss.seq(v) := bits_add(8, gimple.bytes_at(v, 4228240, 1), 0)
// the spec's bytes b with the first n of unmap_seq zeroed
def ss.zs(b, n) := nat_rec(b, k v. fn_update(v, int_add(4228176, k), 0), n)
abbrev ss.ws(w, n) := fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", ss.zs(app(app(w, "vm"), "bytes"), n)))
// the loop's state, the world s and i (from the world w at the loop's
// entry): its invariant (the variant is 32 - i)
abbrev ss.inv(w, s, i) := i in bits(32) && int_le(i, 32) && s = ss.ws(w, i) && s in univ(1) &&
  (all j. j in omega -> int_lt(j, i) -> gimple.usable(app(w, "vm"), int_add(4228176, j), 1, true))

// the bytes after zeroing stay in the universe (a world of them is one)
theorem ss.zs_univ: all b. b in univ(1) -> (all n. n in omega -> ss.zs(b, n) in univ(1))
proof
  fix b
  assume hb: b in univ(1)
  have base: ss.zs(b, 0) in univ(1) by defs(simp(hb, rec({nat_rec(b, k v. fn_update(v, int_add(4228176, k), 0), 0)})), ss.zs)
  have step: all n. n in omega -> ss.zs(b, n) in univ(1) -> ss.zs(b, int_add(n, 1)) in univ(1) proof
    fix n
    assume hn: n in omega
    assume ih: ss.zs(b, n) in univ(1)
    have r := rec({nat_rec(b, k v. fn_update(v, int_add(4228176, k), 0), int_add(n, 1))}, hn)
    show by defs(simp(r, hn, expand(ih, ss.zs)), ss.zs)
  qed
  show by induct(base, step)
qed

theorem ss.ws_univ: all w n. w in univ(1) -> n in omega -> ss.ws(w, n) in univ(1)
proof
  fix w
  fix n
  assume hw: w in univ(1)
  assume hn: n in omega
  have bu: app(app(w, "vm"), "bytes") in univ(1) by simp(hw)
  have z := mp(all_elim(mp(all_elim(ss.zs_univ, {app(app(w, "vm"), "bytes")}), bu), {n}), hn)
  show by simp(hw, z)
qed

// the loop's entry: i = 0, nothing written
theorem ss.entry: all w. w in abi.World -> w in univ(1) -> ss.inv(w, w, 0)
proof
  fix w
  assume hW: w in abi.World
  assume hw: w in univ(1)
  have r := rec({nat_rec(app(app(w, "vm"), "bytes"), k v. fn_update(v, int_add(4228176, k), 0), 0)})
  have hz: ss.zs(app(app(w, "vm"), "bytes"), 0) = app(app(w, "vm"), "bytes") by defs(simp(r), ss.zs)
  have he: w = ss.ws(w, 0) by simp(hW, hz)
  have hh: all j. j in omega -> int_lt(j, 0) -> gimple.usable(app(w, "vm"), int_add(4228176, j), 1, true) proof
    fix j
    assume hj: j in omega
    assume lt: int_lt(j, 0)
    have f: false by arith(hj, lt)
    show by taut(f)
  qed
  show by simp(he, hh, hw)
qed

// one pass through the loop's body keeps the invariant (unmap_seq[i] = 0)
// and decreases the variant
theorem ss.step: all w s i. ss.inv(w, s, i) -> !int_lt(31, i) -> gimple.usable(app(s, "vm"), int_add(4228176, i), 1, true) ->
  ss.inv(w, fn_update(s, "vm", fn_update(app(s, "vm"), "bytes", fn_update(app(app(s, "vm"), "bytes"), int_add(4228176, i), 0))), int_add(i, 1)) &&
  int_lt(int_sub(32, int_add(i, 1)), int_sub(32, i))
proof
  fix w
  fix s
  fix i
  assume hi: ss.inv(w, s, i)
  assume hlt: !int_lt(31, i)
  assume hu: gimple.usable(app(s, "vm"), int_add(4228176, i), 1, true)
  have hb: i in bits(32) by taut(hi)
  have ho: i in omega by simp(hb)
  have hf: s = ss.ws(w, i) by taut(hi)
  have hh: all j. j in omega -> int_lt(j, i) -> gimple.usable(app(w, "vm"), int_add(4228176, j), 1, true) by taut(hi)
  have r := rec({nat_rec(app(app(w, "vm"), "bytes"), k v. fn_update(v, int_add(4228176, k), 0), int_add(i, 1))}, ho)
  have hw: fn_update(s, "vm", fn_update(app(s, "vm"), "bytes", fn_update(app(app(s, "vm"), "bytes"), int_add(4228176, i), 0))) = ss.ws(w, int_add(i, 1))
    by defs(simp(expand(hf, ss.zs), r), ss.zs)
  have hu1: gimple.usable(fn_update(app(w, "vm"), "bytes", ss.zs(app(app(w, "vm"), "bytes"), i)), int_add(4228176, i), 1, true) by simp(rewrite(hf, hu))
  have ub := all_elim(g.usable_bytes, {app(w, "vm")}, {ss.zs(app(app(w, "vm"), "bytes"), i)}, {int_add(4228176, i)}, {1}, {true})
  have hu2: gimple.usable(app(w, "vm"), int_add(4228176, i), 1, true) by taut(hu1, ub)
  have hh2: all j. j in omega -> int_lt(j, int_add(i, 1)) -> gimple.usable(app(w, "vm"), int_add(4228176, j), 1, true) proof
    fix j
    assume hj: j in omega
    assume lt: int_lt(j, int_add(i, 1))
    have c1: int_lt(j, i) -> gimple.usable(app(w, "vm"), int_add(4228176, j), 1, true) proof
      assume l1: int_lt(j, i)
      show := mp(mp(all_elim(hh, {j}), hj), l1)
    qed
    have c2: !int_lt(j, i) -> gimple.usable(app(w, "vm"), int_add(4228176, j), 1, true) proof
      assume l2: !int_lt(j, i)
      have e: j = i by arith(hj, ho, lt, l2)
      show := rewrite(sym(e), hu2)
    qed
    show by taut(c1, c2)
  qed
  have b2: int_add(i, 1) in bits(32) && int_le(int_add(i, 1), 32) by simp(hb, hlt)
  have dv: int_lt(int_sub(32, int_add(i, 1)), int_sub(32, i)) by arith(ho)
  have su: s in univ(1) by taut(hi)
  have nu: fn_update(s, "vm", fn_update(app(s, "vm"), "bytes", fn_update(app(app(s, "vm"), "bytes"), int_add(4228176, i), 0))) in univ(1) by simp(su, ho)
  show by simp(b2, hw, hh2, dv, nu)
qed

// the loop's exit (i > 31): i = 32, unmap_seq zeroed -- the loop's
// post-state
theorem ss.exit: all w s i. ss.inv(w, s, i) -> int_lt(31, i) -> i = 32 && s = ss.ws(w, 32)
proof
  fix w
  fix s
  fix i
  assume hi: ss.inv(w, s, i)
  assume hx: int_lt(31, i)
  have hb: i in bits(32) by taut(hi)
  have hle: int_le(i, 32) by taut(hi)
  have e: i = 32 by arith(hb, hle, hx)
  have hf: s = ss.ws(w, i) by taut(hi)
  show by taut(e, rewrite(e, hf))
qed

// defined: seq can be read and written, and when it is 255 the 32 bytes of
// unmap_seq written
abbrev ss.defined(v) := gimple.usable(v, 4228240, 1, false) && gimple.usable(v, 4228240, 1, true) &&
  (ss.seq(v) = 255 -> (all j. j in omega -> int_lt(j, 32) -> gimple.usable(v, int_add(4228176, j), 1, true)))
// the world after: seq + 1, or unmap_seq zeroed and seq = 1
abbrev ss.res(w) := ite(ss.seq(app(w, "vm")) = 255,
  fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", fn_update(ss.zs(app(app(w, "vm"), "bytes"), 32), 4228240, 1))),
  fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", fn_update(app(app(w, "vm"), "bytes"), 4228240, bits_add(8, gimple.bytes_at(app(w, "vm"), 4228240, 1), 1)))))

// the spec, from defined: seq + 1, or (seq = 255) unmap_seq zeroed and seq
// = 1 -- the loop by its invariant, its post-state by ss.exit
theorem ss.fun_ok: all w args y z. w in abi.World -> w in univ(1) -> args in abi.ARGS -> y in bits(64) -> z in bits(64) -> ss.defined(app(w, "vm")) ->
  runs(app(ss.spec, args), w, ok(ss.res(w), pair(y, z)))
proof
  fix w
  fix args
  fix y
  fix z
  assume hW: w in abi.World
  assume hw: w in univ(1)
  assume hA: args in abi.ARGS
  assume hy: y in bits(64)
  assume hz: z in bits(64)
  assume hd: ss.defined(app(w, "vm"))
  have e := apply(ss.entry, hW, hw)
  have r := spec_run({app(ss.spec, args)}, {w}, {l. ss.inv(w, fst(l), snd(l))}, {l. int_sub(32, snd(l))}, hw, hA, e, ss.step,
    g.padd_ok, g.padd_ub, g.ld8_ok, g.ld8_ub, g.mem_at_ok, g.mem_at_ub, g.elem1_ok)
  // (the branches: seq + 1; the loop's statement, its results y, z and its
  // exceptions' values chosen)
  have r1 := part(r, {1})
  have r3 := all_elim(part(r, {3}), {y}, {z}, {w}, {empty}, {w}, {empty})
  have c1: !(ss.seq(app(w, "vm")) = 255) -> runs(app(ss.spec, args), w, ok(ss.res(w), pair(y, z))) proof
    assume hs: !(ss.seq(app(w, "vm")) = 255)
    show by simp(r1, hs, hd, hy, hz, keep(c_src_malloc_mallocng_malloc.step_seq_fun))
  qed
  have c2: ss.seq(app(w, "vm")) = 255 -> runs(app(ss.spec, args), w, ok(ss.res(w), pair(y, z))) proof
    assume hs: ss.seq(app(w, "vm")) = 255
    show by simp(r3, hs, hd, hy, hz, hw, ss.exit, keep(c_src_malloc_mallocng_malloc.step_seq_fun))
  qed
  show by taut(c1, c2)
qed

// not defined: the spec raises (from the world it starts in, as undefined
// behaviour allows)
theorem ss.fun_raises: all w args e. w in abi.World -> w in univ(1) -> e in univ(1) -> args in abi.ARGS -> !ss.defined(app(w, "vm")) ->
  runs(app(ss.spec, args), w, exc(w, e))
proof
  fix w
  fix args
  fix e
  assume hW: w in abi.World
  assume hw: w in univ(1)
  assume he: e in univ(1)
  assume hA: args in abi.ARGS
  assume hn: !ss.defined(app(w, "vm"))
  have ent := apply(ss.entry, hW, hw)
  have r := spec_run({app(ss.spec, args)}, {w}, {l. ss.inv(w, fst(l), snd(l))}, {l. int_sub(32, snd(l))}, hw, hA, ent, ss.step,
    g.padd_ok, g.padd_ub, g.ld8_ok, g.ld8_ub, g.mem_at_ok, g.mem_at_ub, g.elem1_ok)
  // (the undefined behaviour of the increment; the loop's statement, its
  // results any words, its exceptions' values this one)
  have r2 := all_elim(part(r, {2}), {w}, {e})
  have r3 := all_elim(part(r, {3}), {0}, {0}, {w}, {e}, {w}, {e})
  have c1: !(ss.seq(app(w, "vm")) = 255) -> runs(app(ss.spec, args), w, exc(w, e)) proof
    assume hs: !(ss.seq(app(w, "vm")) = 255)
    show by simp(r2, hs, hn, hw, he, keep(c_src_malloc_mallocng_malloc.step_seq_fun))
  qed
  have c2: ss.seq(app(w, "vm")) = 255 -> runs(app(ss.spec, args), w, exc(w, e)) proof
    assume hs: ss.seq(app(w, "vm")) = 255
    have u1: !gimple.usable(app(w, "vm"), 4228240, 1, false) -> runs(app(ss.spec, args), w, exc(w, e)) proof
      assume hr: !gimple.usable(app(w, "vm"), 4228240, 1, false)
      show by simp(r2, hs, hr, hw, he, keep(c_src_malloc_mallocng_malloc.step_seq_fun))
    qed
    have u2: gimple.usable(app(w, "vm"), 4228240, 1, false) -> runs(app(ss.spec, args), w, exc(w, e)) proof
      assume hr: gimple.usable(app(w, "vm"), 4228240, 1, false)
      show by simp(r3, hs, hr, hn, hw, he, ss.exit, keep(c_src_malloc_mallocng_malloc.step_seq_fun))
    qed
    show by taut(u1, u2)
  qed
  show by taut(c1, c2)
qed

// C1 by the bridge: the loop cut at its head with the invariant i <= 32, the
// machine coupled to the spec there. The precondition places the static
// data (ctx.seq, ctx.unmap_seq) among the statics.
theorem ss.implements_bridge: all statics. (all a. a in omega -> int_le(4228176, a) -> int_lt(a, 4228241) -> a in statics) ->
  abi.implements2_at(single(empty), 4203722, ss.spec, 4203722, step_seq.code(), statics)
proof
  fix statics
  assume hst: all a. a in omega -> int_le(4228176, a) -> int_lt(a, 4228241) -> a in statics
  have m: all args s o. args in abi.ARGS -> s in x86_64_linux.Machine -> abi.loaded(app(s, "vm"), 4203722, step_seq.code(), statics) -> app(s, "rip") = 4203722 ->
      abi.entry_ok(s, args) -> runs(abi.run_to_return(), s, o) -> abi.matches(ss.spec, args, s, o) proof
    fix args
    fix s
    fix o
    assume hA: args in abi.ARGS
    assume hM: s in x86_64_linux.Machine
    assume hl: abi.loaded(app(s, "vm"), 4203722, step_seq.code(), statics)
    assume hrip: app(s, "rip") = 4203722
    assume he: abi.entry_ok(s, args)
    assume hr: runs(abi.run_to_return(), s, o)
    have hc: abi.code_at(app(s, "vm"), 4203722, step_seq.code()) by taut(expand(hl, abi.loaded))
    have su: s in univ(1) by simp(apply(abi.run_univ, hr))
    have ent := apply(abi.entry_stack, hM, he)
    have hsp: app(app(s, "gpr"), 4) in bits(64) by simp(hM)
    // the static data apart from the frame (statics: no stack pages)
    have ns: all j. j in omega -> int_lt(j, 65) -> !abi.stack_page(app(s, "vm"), int_div(int_add(4228176, j), 4096)) proof
      fix j
      assume j1: j in omega
      assume j2: int_lt(j, 65)
      have m := mp(mp(mp(all_elim(hst, {int_add(4228176, j)}), simp(j1)), simp(j1)), simp(j1, j2))
      have ls: all x0. x0 in omega -> x0 in statics -> !abi.stack_page(app(s, "vm"), int_div(x0, 4096)) by simp(expand(hl, abi.loaded))
      show := mp(mp(all_elim(ls, {int_add(4228176, j)}), simp(j1)), m)
    qed
    have ap := apply(abi.frame_apart, {app(s, "vm")}, {app(app(s, "gpr"), 4)}, {4228176}, {65}, hsp, ent, ent, ent, simp(), simp(), ns)
    show := bridge(hr, {app(ss.spec, args)}, {l. int_le(snd(l), 32)}, hA, hM, hc, hrip, su, ent, ap, he, expand(he, abi.entry_ok),
      step_seq.ok_4024ca, step_seq.ok_4024d1, step_seq.ok_4024d3, step_seq.ok_4024d5, step_seq.ok_4024dd, step_seq.ok_4024df, step_seq.ok_4024e3, step_seq.ok_4024e5,
      step_seq.ok_4024ec, step_seq.ok_4024f0, step_seq.ok_4024f5, step_seq.ok_4024fa, step_seq.ok_4024fc, step_seq.ok_402503, step_seq.ok_402505, step_seq.ok_40250c,
      step_seq.ok_40250f, step_seq.ok_402515, step_seq.ok_402516)
  qed
  show := apply(abi.bridge_implements, m)
qed
