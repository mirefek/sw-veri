// step_seq (musl mallocng, meta.h: `if (ctx.seq == 255) { for (i = 0; i <
// 32; i++) ctx.unmap_seq[i] = 0; ctx.seq = 1; } else ctx.seq++;` at -O0):
// C1 under the ABI. The loop is reasoned about as a loop -- an invariant at
// its head and a variant, the body once for any i -- on both sides: the
// spec by `spec_run` with the invariant (`while_exists`), the machine by
// `symex` to the loop's head and around it once (`abi.run_cut`).
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core core/records.core \
//     core/list.core core/loop.core build/c_mallocng_malloc.core proofs/x86.core proofs/x86_code.core \
//     build/leaf_steps.core proofs/abi.core proofs/abi_restore.core proofs/abi_glue.core proofs/gimple.core \
//     proofs/abi_stack.core proofs/abi_loop.core proofs/step_seq.core

abbrev ss.spec := c_src_malloc_mallocng_malloc.step_seq_fun()
// ctx.seq (at __malloc_context + 912) and ctx.unmap_seq (+ 848, 32 bytes)
abbrev ss.seq(v) := bits_add(8, gimple.bytes_at(v, 4228240, 1), 0)
// the spec's bytes b with the first n of unmap_seq zeroed
def ss.zs(b, n) := nat_rec(b, k v. fn_update(v, int_add(4228176, k), 0), n)
abbrev ss.ws(w, n) := fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", ss.zs(app(app(w, "vm"), "bytes"), n)))
// the loop's state (the world, i): its invariant and variant
abbrev ss.inv(w, l) := snd(l) in bits(32) && int_le(snd(l), 32) && fst(l) = ss.ws(w, snd(l)) && fst(l) in univ(1) &&
  (all j. j in omega -> int_lt(j, snd(l)) -> gimple.usable(app(w, "vm"), int_add(4228176, j), 1, true))

// one pass through the loop's body keeps the invariant (unmap_seq[i] = 0)
// and decreases the variant
theorem ss.step: all w l. ss.inv(w, l) -> !int_lt(31, snd(l)) -> gimple.usable(app(fst(l), "vm"), int_add(4228176, snd(l)), 1, true) ->
  ss.inv(w, pair(fn_update(fst(l), "vm", fn_update(app(fst(l), "vm"), "bytes", fn_update(app(app(fst(l), "vm"), "bytes"), int_add(4228176, snd(l)), 0))), int_add(snd(l), 1))) &&
  int_lt(int_sub(32, int_add(snd(l), 1)), int_sub(32, snd(l)))
proof
  fix w
  fix l
  assume hi: ss.inv(w, l)
  assume hlt: !int_lt(31, snd(l))
  assume hu: gimple.usable(app(fst(l), "vm"), int_add(4228176, snd(l)), 1, true)
  have hb: snd(l) in bits(32) by taut(hi)
  have ho: snd(l) in omega by simp(hb)
  have hf: fst(l) = ss.ws(w, snd(l)) by taut(hi)
  have hh: all j. j in omega -> int_lt(j, snd(l)) -> gimple.usable(app(w, "vm"), int_add(4228176, j), 1, true) by taut(hi)
  have r := rec({nat_rec(app(app(w, "vm"), "bytes"), k v. fn_update(v, int_add(4228176, k), 0), int_add(snd(l), 1))}, ho)
  have hw: fn_update(fst(l), "vm", fn_update(app(fst(l), "vm"), "bytes", fn_update(app(app(fst(l), "vm"), "bytes"), int_add(4228176, snd(l)), 0))) = ss.ws(w, int_add(snd(l), 1))
    by defs(simp(expand(hf, ss.zs), r), ss.zs)
  have hu1: gimple.usable(fn_update(app(w, "vm"), "bytes", ss.zs(app(app(w, "vm"), "bytes"), snd(l))), int_add(4228176, snd(l)), 1, true) by simp(rewrite(hf, hu))
  have ub := all_elim(g.usable_bytes, {app(w, "vm")}, {ss.zs(app(app(w, "vm"), "bytes"), snd(l))}, {int_add(4228176, snd(l))}, {1}, {true})
  have hu2: gimple.usable(app(w, "vm"), int_add(4228176, snd(l)), 1, true) by taut(hu1, ub)
  have hh2: all j. j in omega -> int_lt(j, int_add(snd(l), 1)) -> gimple.usable(app(w, "vm"), int_add(4228176, j), 1, true) proof
    fix j
    assume hj: j in omega
    assume lt: int_lt(j, int_add(snd(l), 1))
    have c1: int_lt(j, snd(l)) -> gimple.usable(app(w, "vm"), int_add(4228176, j), 1, true) proof
      assume l1: int_lt(j, snd(l))
      show := mp(mp(all_elim(hh, {j}), hj), l1)
    qed
    have c2: !int_lt(j, snd(l)) -> gimple.usable(app(w, "vm"), int_add(4228176, j), 1, true) proof
      assume l2: !int_lt(j, snd(l))
      have e: j = snd(l) by arith(hj, ho, lt, l2)
      show := rewrite(sym(e), hu2)
    qed
    show by taut(c1, c2)
  qed
  have b2: int_add(snd(l), 1) in bits(32) && int_le(int_add(snd(l), 1), 32) by simp(hb, hlt)
  have fu: fst(l) in univ(1) by taut(hi)
  have nu: fn_update(fst(l), "vm", fn_update(app(fst(l), "vm"), "bytes", fn_update(app(app(fst(l), "vm"), "bytes"), int_add(4228176, snd(l)), 0))) in univ(1) by simp(fu, ho)
  have dv: int_lt(int_sub(32, int_add(snd(l), 1)), int_sub(32, snd(l))) by arith(ho)
  show by simp(b2, hw, hh2, nu, dv)
qed

// the loop's entry: i = 0, nothing written
theorem ss.entry: all w. w in abi.World -> w in univ(1) -> ss.inv(w, pair(w, 0))
proof
  fix w
  assume hW: w in abi.World
  assume hw: w in univ(1)
  have r := rec({nat_rec(app(app(w, "vm"), "bytes"), k v. fn_update(v, int_add(4228176, k), 0), 0)})
  have hz: ss.zs(app(app(w, "vm"), "bytes"), 0) = app(app(w, "vm"), "bytes") by defs(simp(r), ss.zs)
  have he: w = ss.ws(w, 0) by simp(hW, hz)
  have hh: all j. j in omega -> int_lt(j, 0) -> gimple.usable(app(w, "vm"), int_add(4228176, j), 1, true) proof
    fix j
    assume hj: j in omega
    assume lt: int_lt(j, 0)
    have f: false by arith(hj, lt)
    show by taut(f)
  qed
  show by simp(he, hh, hw)
qed

// defined: seq can be read and written, and when it is 255 the 32 bytes of
// unmap_seq written
abbrev ss.defined(v) := gimple.usable(v, 4228240, 1, false) && gimple.usable(v, 4228240, 1, true) &&
  (ss.seq(v) = 255 -> (all j. j in omega -> int_lt(j, 32) -> gimple.usable(v, int_add(4228176, j), 1, true)))
// the world after: seq + 1, or unmap_seq zeroed and seq = 1
abbrev ss.res(w) := ite(ss.seq(app(w, "vm")) = 255,
  fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", fn_update(ss.zs(app(app(w, "vm"), "bytes"), 32), 4228240, 1))),
  fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", fn_update(app(app(w, "vm"), "bytes"), 4228240, bits_add(8, gimple.bytes_at(app(w, "vm"), 4228240, 1), 1)))))

// (in progress: ss.fun_ok / ss.fun_raises from
//   spec_run({app(ss.spec, args)}, {w}, {l. ss.inv(w, l)}, {l. int_sub(32, snd(l))}, ..)
// whose obligations ss.entry and ss.step discharge; then the machine side
// by symex to the head 0x4024f5 and abi.run_cut, and the ABI glue)
