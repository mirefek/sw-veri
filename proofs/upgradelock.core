// upgradelock (musl mallocng; `nop; ret` at -O0): C1 under the ABI.
//
//   slc steps build/test_malloc_O0 build/musl_malloc_O0.core get_slot_index upgradelock resetlock a_ctz_32 -o build/leaf_steps.core
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core core/records.core \
//     core/list.core core/loop.core build/c_mallocng_malloc.core proofs/x86.core proofs/x86_code.core \
//     build/leaf_steps.core proofs/abi.core proofs/abi_restore.core proofs/abi_glue.core proofs/gimple.core \
//     proofs/abi_stack.core proofs/upgradelock.core

abbrev ug.spec := c_src_malloc_mallocng_malloc.upgradelock_fun()

// the spec: no effect, any result
theorem ug.fun_ok: all w args x y. w in univ(1) -> args in abi.ARGS -> x in bits(64) -> y in bits(64) -> runs(app(ug.spec, args), w, ok(w, pair(x, y)))
proof
  fix w
  fix args
  fix x
  fix y
  assume hw: w in univ(1)
  assume hA: args in abi.ARGS
  assume hx: x in bits(64)
  assume hy: y in bits(64)
  show by defs(simp(hw, hA, hx, hy), c_src_malloc_mallocng_malloc.upgradelock_fun)
qed

// the machine: from the entry to the return
theorem upgradelock.run(m, o): abi.code_at(app(m, "vm"), 4206144, upgradelock.code()) -> app(m, "rip") = 4206144 -> app(app(m, "gpr"), 4) in bits(64) ->
  (all i. i in omega -> int_lt(i, 8) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, app(app(m, "gpr"), 4), bits_of_int(64, i)), 0)) ->
  runs(abi.run_to_return(), m, o) ->
  o = ok(fn_update(fn_update(m, "gpr", fn_update(app(m, "gpr"), 4, abi.sp(m))), "rip", abi.ret(m)), empty)
proof
  assume hc: abi.code_at(app(m, "vm"), 4206144, upgradelock.code())
  assume hr: app(m, "rip") = 4206144
  assume hsp: app(app(m, "gpr"), 4) in bits(64)
  assume a7: all i. i in omega -> int_lt(i, 8) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, app(app(m, "gpr"), 4), bits_of_int(64, i)), 0)
  assume h: runs(abi.run_to_return(), m, o)
  have r := symex(h, hc, hr, hsp, a7, upgradelock.ok_402e40, upgradelock.ok_402e41)
  show by simp(r, hsp)
qed

theorem ug.implements: all statics. abi.implements2_at(single(empty), 4206144, ug.spec, 4206144, upgradelock.code(), statics)
proof
  fix statics
  have runs: all args s o. args in abi.ARGS -> s in x86_64_linux.Machine -> abi.loaded(app(s, "vm"), 4206144, upgradelock.code(), statics) -> app(s, "rip") = 4206144 -> abi.entry_ok(s, args) ->
      runs(abi.run_to_return(), s, o) -> runs(abi.abi_function(single(empty), 4206144, ug.spec, args), s, o) proof
    fix args
    fix s
    fix o
    assume hA: args in abi.ARGS
    assume hM: s in x86_64_linux.Machine
    assume hl: abi.loaded(app(s, "vm"), 4206144, upgradelock.code(), statics)
    have hc: abi.code_at(app(s, "vm"), 4206144, upgradelock.code()) by taut(expand(hl, abi.loaded))
    assume hrip: app(s, "rip") = 4206144
    assume he: abi.entry_ok(s, args)
    assume hr: runs(abi.run_to_return(), s, o)
    have hp := apply(abi.run_univ, hr)
    have su: s in univ(1) by simp(hp)
    have hsp: app(app(s, "gpr"), 4) in bits(64) by simp(hM)
    have ent := apply(abi.entry_stack, hM, he)
    have sa := apply(abi.ret_access, {app(s, "vm")}, {app(app(s, "gpr"), 4)}, hsp, ent, ent)
    have eo := apply(upgradelock.run, hc, hrip, hsp, sa, hr)
    let m1 := fn_update(fn_update(s, "gpr", fn_update(app(s, "gpr"), 4, abi.sp(s))), "rip", abi.ret(s))
    have hp2 := rewrite(eo, hp)
    have m1u: m1 in univ(1) by taut(apply(abi.ok_univ, hp2))
    have m1M: m1 in x86_64_linux.Machine by simp(hM, m1u)
    // the view: the memory as it is
    let w := abi.view(app(s, "vm"), s)
    have wu: w in univ(1) by simp(su)
    have fo := apply(ug.fun_ok, {w}, {args}, {app(app(m1, "gpr"), 0)}, {app(app(m1, "gpr"), 2)}, wu, hA, simp(hM), simp(hM))
    have rc := apply(abi.ret_case, {4206144}, {ug.spec}, {args}, {s}, {m1}, {app(s, "vm")}, {w},
      hM, he, m1M, hp2, simp(hM), simp(su), defs(simp(hM), abi.scratch_view), defs(simp(), abi.world_matches), fo, simp(hM, su), wu,
      defs(simp(), abi.world_matches), simp(), simp(), simp(), simp(), simp(), simp(), simp(), simp(expand(he, abi.entry_ok)))
    show := rewrite(sym(eo), rc)
  qed
  show := apply(abi.implements_intro, runs)
qed
