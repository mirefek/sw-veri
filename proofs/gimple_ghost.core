// GIMPLE-world programs and a ghost part of the state (proving GIMPLE
// spec): a spec over `World & G` refined by a program over the world
// (`refines_ghost`). The ghost part rides along: a step that does not read
// it runs the same with it joined to its state (`with_ghost` on its
// outcome); binding (`bind_rel`) carries that through a continuation. The
// C function values' wrappers: `g.fun_res_ghost`, as `g.fun_res`.

// (an outcome with a ghost part: in the universe if both are)
theorem g.with_ghost_univ(o, h): o in univ(1) -> h in univ(1) -> with_ghost(o, h) in univ(1)
proof
  assume ho hh
  show by defs(simp(ho, hh), with_ghost)
qed

// Binding with a ghost part h: a step's outcome o1 from s, run with h
// joined (S) to `with_ghost(o1, h)`, and continuations that keep h (each
// of the first's cases one of the second's with h joined): the second
// binding holds.
theorem g.bind_ghost(q, S, h, o1, s1 v. k, s1 e. x, t. d, s1 v. k2, s1 e. x2, t. d2):
  runs(q, S, with_ghost(o1, h)) ->
  ((ex s1 v. o1 = ok(s1, v) && k(s1, v)) || (ex s1 e. o1 = exc(s1, e) && x(s1, e)) || (ex t. o1 = diverge(t) && d(t))) ->
  (all s1 v. k(s1, v) -> k2(union2(s1, h), v)) ->
  (all s1 e. x(s1, e) -> x2(union2(s1, h), e)) ->
  (all t. d(t) -> d2(t)) ->
  bind_rel(q, S, s1 v. k2(s1, v), s1 e. x2(s1, e), t. d2(t))
proof
  assume hq hc hk hx hd
  let O := with_ghost(o1, h)
  have c1: (ex s1 v. o1 = ok(s1, v) && k(s1, v)) -> (ex s1 v. O = ok(s1, v) && k2(s1, v)) proof
    assume e
    obtain s1 v, he hkv from e
    have oe: O = ok(union2(s1, h), v) by defs(simp(he), with_ghost)
    show by ex_intro({union2(s1, h)}, {v}, taut(oe, mp(all_elim(hk, {s1}, {v}), hkv)))
  qed
  have c2: (ex s1 e. o1 = exc(s1, e) && x(s1, e)) -> (ex s1 e. O = exc(s1, e) && x2(s1, e)) proof
    assume e
    obtain s1 v, he hxv from e
    have oe: O = exc(union2(s1, h), v) by defs(simp(he), with_ghost)
    show by ex_intro({union2(s1, h)}, {v}, taut(oe, mp(all_elim(hx, {s1}, {v}), hxv)))
  qed
  have c3: (ex t. o1 = diverge(t) && d(t)) -> (ex t. O = diverge(t) && d2(t)) proof
    assume e
    obtain t, he hdt from e
    have oe: O = diverge(t) by defs(simp(he), with_ghost)
    show by ex_intro({t}, taut(oe, mp(all_elim(hd, {t}), hdt)))
  qed
  have w: runs(q, S, O) && ((ex s1 v. O = ok(s1, v) && k2(s1, v)) || (ex s1 e. O = exc(s1, e) && x2(s1, e)) || (ex t. O = diverge(t) && d2(t)))
    by taut(hq, hc, c1, c2, c3)
  show by defs(ex_intro({O}, w), bind_rel)
qed

// GIMPLE's `result` does not read the state: it runs the same with a
// ghost part
theorem g.result_ghost(w, v, s, h, o): h in univ(1) -> runs(gimple.result(w, v), s, o) ->
  runs(gimple.result(w, v), union2(s, h), with_ghost(o, h))
proof
  assume hh hr
  have pu := apply(g.runs_univ, hr)
  have ou: o in univ(1) by simp(pu)
  have gu := apply(g.with_ghost_univ, ou, hh)
  have r := apply(g.runs_elim, expand(hr, gimple.result))
  have pu2: pair(union2(s, h), with_ghost(o, h)) in univ(1) by simp(pu, hh, gu)
  have c1: !(ex x2. x2 in bits(64) && x2 in gimple.in_reg(v, fn_update(fn_update(empty, "prec", w), "signed", false))) ->
      runs(gimple.result(w, v), union2(s, h), with_ghost(o, h)) proof
    assume n
    show by defs(apply(tr.runs_intro, pu2, (any_rel(x2. x2 in bits(64) && x2 in gimple.in_reg(v, fn_update(fn_update(empty, "prec", w), "signed", false)), x2. with_ghost(o, h) = ok(union2(s, h), x2)) by defs(taut(n), any_rel))), gimple.result)
  qed
  have c2: (ex x2. (x2 in bits(64) && x2 in gimple.in_reg(v, fn_update(fn_update(empty, "prec", w), "signed", false))) && o = ok(s, x2)) ->
      runs(gimple.result(w, v), union2(s, h), with_ghost(o, h)) proof
    assume e
    obtain x2, hb hd he from e
    have g: with_ghost(o, h) = ok(union2(s, h), x2) by defs(simp(he), with_ghost)
    have ee: ex x3. (x3 in bits(64) && x3 in gimple.in_reg(v, fn_update(fn_update(empty, "prec", w), "signed", false))) && with_ghost(o, h) = ok(union2(s, h), x3)
      by ex_intro({x2}, taut(hb, hd, g))
    have a: any_rel(x3. x3 in bits(64) && x3 in gimple.in_reg(v, fn_update(fn_update(empty, "prec", w), "signed", false)), x3. with_ghost(o, h) = ok(union2(s, h), x3))
      by defs(taut(ee), any_rel)
    show by defs(apply(tr.runs_intro, pu2, a), gimple.result)
  qed
  show by taut(expand(r, any_rel), c1, c2)
qed

// (a w-bit result; `g.fun_res` with a ghost part G: the procedure's
// refinement at every register list gives the wrapper's)
theorem g.fun_res_ghost(x0. p, x0. q, w, n, G): (all h. h in G -> h in univ(1)) ->
  (all regs. refines_ghost(p(regs), q(regs), abi.World, G)) ->
  all regs. regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) ->
  refines_ghost(fn_build(set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)), x0. mkprog(x1 x2. !ord_le(n, seq_len(x0)) || bind_rel(p(x0), x1, x3 x4. letin(x4, x5. bind_rel(gimple.result(w, x5), x3, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. x2 = ok(x6, pair(x8, x9)))), x6 x7. x2 = exc(x6, x7), x6. x2 = diverge(x6))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))))[regs],
    fn_build(set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)), x0. mkprog(x1 x2. !ord_le(n, seq_len(x0)) || bind_rel(q(x0), x1, x3 x4. letin(x4, x5. bind_rel(gimple.result(w, x5), x3, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. x2 = ok(x6, pair(x8, x9)))), x6 x7. x2 = exc(x6, x7), x6. x2 = diverge(x6))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))))[regs],
    abi.World, G)
proof
  assume hG hc
  fix regs
  assume hr
  rsimp only, app_fn_build, hr
  let MQ := mkprog(x1 x2. !ord_le(n, seq_len(regs)) || bind_rel(q(regs), x1, x3 x4. letin(x4, x5. bind_rel(gimple.result(w, x5), x3, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. x2 = ok(x6, pair(x8, x9)))), x6 x7. x2 = exc(x6, x7), x6. x2 = diverge(x6))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))
  have main: all s h o. s in abi.World -> h in G -> runs(mkprog(x1 x2. !ord_le(n, seq_len(regs)) || bind_rel(p(regs), x1, x3 x4. letin(x4, x5. bind_rel(gimple.result(w, x5), x3, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. x2 = ok(x6, pair(x8, x9)))), x6 x7. x2 = exc(x6, x7), x6. x2 = diverge(x6))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), s, o) ->
      (ex h2. h2 in G && runs(mkprog(x1 x2. !ord_le(n, seq_len(regs)) || bind_rel(q(regs), x1, x3 x4. letin(x4, x5. bind_rel(gimple.result(w, x5), x3, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. x2 = ok(x6, pair(x8, x9)))), x6 x7. x2 = exc(x6, x7), x6. x2 = diverge(x6))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), union2(s, h), with_ghost(o, h2))) proof
    fix s h o
    assume hs hh ho
    have pu := apply(g.runs_univ, ho)
    have ou: o in univ(1) by simp(pu)
    have su: s in univ(1) by simp(pu)
    have r := apply(g.runs_elim, ho)
    // (too few arguments: the spec allows anything, the ghost part kept)
    have k1: case 1 of r proof
      assume hn
      have hu := mp(all_elim(hG, {h}), hh)
      have gu := apply(g.with_ghost_univ, ou, hu)
      have pu2: pair(union2(s, h), with_ghost(o, h)) in univ(1) by simp(su, hu, gu)
      have rq: runs(MQ, union2(s, h), with_ghost(o, h)) by apply(tr.runs_intro, pu2, taut(hn))
      show by ex_intro({h}, taut(hh, rq))
    qed
    // (else the spec's run, with the ghost part it chooses)
    have k2: case 2 of r proof
      assume hb
      obtain o1, h1 hk from expand(hb, bind_rel)
      obtain h2, hg2 hq from mp(all_elim(expand(all_elim(hc, {regs}), refines_ghost), {s}, {h}, {o1}), hs, hh, h1)
      have hu2 := mp(all_elim(hG, {h2}), hg2)
      have gu := apply(g.with_ghost_univ, ou, hu2)
      have pu2: pair(union2(s, h), with_ghost(o, h2)) in univ(1) by simp(su, mp(all_elim(hG, {h}), hh), gu)
      // the continuation: the result as returned, the ghost part kept
      have kk: all s1 v. letin(v, x5. bind_rel(gimple.result(w, x5), s1, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. o = ok(x6, pair(x8, x9)))), x6 x7. o = exc(x6, x7), x6. o = diverge(x6))) ->
          letin(v, x5. bind_rel(gimple.result(w, x5), union2(s1, h2), x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. with_ghost(o, h2) = ok(x6, pair(x8, x9)))), x6 x7. with_ghost(o, h2) = exc(x6, x7), x6. with_ghost(o, h2) = diverge(x6))) proof
        fix s1 v
        assume hl
        obtain o5, h5 hk5 from expand(expand(hl, letin), bind_rel)
        have q5 := apply(g.result_ghost, hu2, h5)
        have ka: all s6 x7. any_rel(x9. x9 in bits(64), x9. o = ok(s6, pair(x7, x9))) ->
            any_rel(x9. x9 in bits(64), x9. with_ghost(o, h2) = ok(union2(s6, h2), pair(x7, x9))) proof
          fix s6 x7
          assume ha
          have a2 := expand(ha, any_rel)
          have c1: !(ex x9. x9 in bits(64)) -> any_rel(x9. x9 in bits(64), x9. with_ghost(o, h2) = ok(union2(s6, h2), pair(x7, x9))) proof
            assume n
            show by defs(taut(n), any_rel)
          qed
          have c2: (ex x9. x9 in bits(64) && o = ok(s6, pair(x7, x9))) -> any_rel(x9. x9 in bits(64), x9. with_ghost(o, h2) = ok(union2(s6, h2), pair(x7, x9))) proof
            assume e
            obtain x9, hx9 he from e
            have g: with_ghost(o, h2) = ok(union2(s6, h2), pair(x7, x9)) by defs(simp(he), with_ghost)
            have ee: ex x9. x9 in bits(64) && with_ghost(o, h2) = ok(union2(s6, h2), pair(x7, x9)) by ex_intro({x9}, taut(hx9, g))
            show by defs(taut(ee), any_rel)
          qed
          show by taut(a2, c1, c2)
        qed
        have kx: all s6 e. o = exc(s6, e) -> with_ghost(o, h2) = exc(union2(s6, h2), e) proof
          fix s6 e
          assume he
          show by defs(simp(he), with_ghost)
        qed
        have kd: all t. o = diverge(t) -> with_ghost(o, h2) = diverge(t) proof
          fix t
          assume he
          show by defs(simp(he), with_ghost)
        qed
        have b := apply(g.bind_ghost[k2 := s9 v9. any_rel(x9. x9 in bits(64), x9. with_ghost(o, h2) = ok(s9, pair(v9, x9))),
          x2 := s9 e9. with_ghost(o, h2) = exc(s9, e9), d2 := t9. with_ghost(o, h2) = diverge(t9)], q5, hk5, ka, kx, kd)
        show by defs(b, letin)
      qed
      have kx: all s1 e. o = exc(s1, e) -> with_ghost(o, h2) = exc(union2(s1, h2), e) proof
        fix s1 e
        assume he
        show by defs(simp(he), with_ghost)
      qed
      have kd: all t. o = diverge(t) -> with_ghost(o, h2) = diverge(t) proof
        fix t
        assume he
        show by defs(simp(he), with_ghost)
      qed
      have b := apply(g.bind_ghost[k2 := s9 v9. letin(v9, x5. bind_rel(gimple.result(w, x5), s9, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. with_ghost(o, h2) = ok(x6, pair(x8, x9)))), x6 x7. with_ghost(o, h2) = exc(x6, x7), x6. with_ghost(o, h2) = diverge(x6))),
        x2 := s9 e9. with_ghost(o, h2) = exc(s9, e9), d2 := t9. with_ghost(o, h2) = diverge(t9)], hq, hk, kk, kx, kd)
      have rq: runs(MQ, union2(s, h), with_ghost(o, h2)) by apply(tr.runs_intro, pu2, taut(b))
      show by ex_intro({h2}, taut(hg2, rq))
    qed
    show by taut(r, k1, k2)
  qed
  show by defs(main, refines_ghost)
qed

// (the same for a procedure of no arguments: no count to check, its
// result returned as computed)
theorem g.fun_res_ghost0(p, q, w, G): (all h. h in G -> h in univ(1)) ->
  refines_ghost(p, q, abi.World, G) ->
  all regs. regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) ->
  refines_ghost(fn_build(set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)), x0. mkprog(x1 x2. bind_rel(p, x1, x3 x4. letin(x4, x5. bind_rel(gimple.result(w, x5), x3, x6 x7. any_rel(x8. x8 in bits(64), x8. x2 = ok(x6, pair(x7, x8))), x6 x7. x2 = exc(x6, x7), x6. x2 = diverge(x6))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))))[regs],
    fn_build(set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)), x0. mkprog(x1 x2. bind_rel(q, x1, x3 x4. letin(x4, x5. bind_rel(gimple.result(w, x5), x3, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. x2 = ok(x6, pair(x8, x9)))), x6 x7. x2 = exc(x6, x7), x6. x2 = diverge(x6))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))))[regs],
    abi.World, G)
proof
  assume hG hc
  fix regs
  assume hr
  rsimp only, app_fn_build, hr
  let MQ := mkprog(x1 x2. bind_rel(q, x1, x3 x4. letin(x4, x5. bind_rel(gimple.result(w, x5), x3, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. x2 = ok(x6, pair(x8, x9)))), x6 x7. x2 = exc(x6, x7), x6. x2 = diverge(x6))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))
  have main: all s h o. s in abi.World -> h in G -> runs(mkprog(x1 x2. bind_rel(p, x1, x3 x4. letin(x4, x5. bind_rel(gimple.result(w, x5), x3, x6 x7. any_rel(x8. x8 in bits(64), x8. x2 = ok(x6, pair(x7, x8))), x6 x7. x2 = exc(x6, x7), x6. x2 = diverge(x6))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), s, o) ->
      (ex h2. h2 in G && runs(MQ, union2(s, h), with_ghost(o, h2))) proof
    fix s h o
    assume hs hh ho
    have pu := apply(g.runs_univ, ho)
    have ou: o in univ(1) by simp(pu)
    have su: s in univ(1) by simp(pu)
    have hb := apply(g.runs_elim, ho)
    obtain o1, h1 hk from expand(hb, bind_rel)
    obtain h2, hg2 hq from mp(all_elim(expand(hc, refines_ghost), {s}, {h}, {o1}), hs, hh, h1)
    have hu2 := mp(all_elim(hG, {h2}), hg2)
    have gu := apply(g.with_ghost_univ, ou, hu2)
    have pu2: pair(union2(s, h), with_ghost(o, h2)) in univ(1) by simp(su, mp(all_elim(hG, {h}), hh), gu)
    // the continuation: the result as returned, the ghost part kept
    have kk: all s1 v. letin(v, x5. bind_rel(gimple.result(w, x5), s1, x6 x7. any_rel(x8. x8 in bits(64), x8. o = ok(x6, pair(x7, x8))), x6 x7. o = exc(x6, x7), x6. o = diverge(x6))) ->
        letin(v, x5. bind_rel(gimple.result(w, x5), union2(s1, h2), x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. with_ghost(o, h2) = ok(x6, pair(x8, x9)))), x6 x7. with_ghost(o, h2) = exc(x6, x7), x6. with_ghost(o, h2) = diverge(x6))) proof
      fix s1 v
      assume hl
      obtain o5, h5 hk5 from expand(expand(hl, letin), bind_rel)
      have q5 := apply(g.result_ghost, hu2, h5)
      have ka: all s6 x7. any_rel(x9. x9 in bits(64), x9. o = ok(s6, pair(x7, x9))) ->
          any_rel(x9. x9 in bits(64), x9. with_ghost(o, h2) = ok(union2(s6, h2), pair(x7, x9))) proof
        fix s6 x7
        assume ha
        have a2 := expand(ha, any_rel)
        have c1: !(ex x9. x9 in bits(64)) -> any_rel(x9. x9 in bits(64), x9. with_ghost(o, h2) = ok(union2(s6, h2), pair(x7, x9))) proof
          assume n
          show by defs(taut(n), any_rel)
        qed
        have c2: (ex x9. x9 in bits(64) && o = ok(s6, pair(x7, x9))) -> any_rel(x9. x9 in bits(64), x9. with_ghost(o, h2) = ok(union2(s6, h2), pair(x7, x9))) proof
          assume e
          obtain x9, hx9 he from e
          have g: with_ghost(o, h2) = ok(union2(s6, h2), pair(x7, x9)) by defs(simp(he), with_ghost)
          have ee: ex x9. x9 in bits(64) && with_ghost(o, h2) = ok(union2(s6, h2), pair(x7, x9)) by ex_intro({x9}, taut(hx9, g))
          show by defs(taut(ee), any_rel)
        qed
        show by taut(a2, c1, c2)
      qed
      have kx: all s6 e. o = exc(s6, e) -> with_ghost(o, h2) = exc(union2(s6, h2), e) proof
        fix s6 e
        assume he
        show by defs(simp(he), with_ghost)
      qed
      have kd: all t. o = diverge(t) -> with_ghost(o, h2) = diverge(t) proof
        fix t
        assume he
        show by defs(simp(he), with_ghost)
      qed
      have b := apply(g.bind_ghost[k2 := s9 v9. any_rel(x9. x9 in bits(64), x9. with_ghost(o, h2) = ok(s9, pair(v9, x9))),
        x2 := s9 e9. with_ghost(o, h2) = exc(s9, e9), d2 := t9. with_ghost(o, h2) = diverge(t9)], q5, hk5, ka, kx, kd)
      show by defs(b, letin)
    qed
    have kx: all s1 e. o = exc(s1, e) -> with_ghost(o, h2) = exc(union2(s1, h2), e) proof
      fix s1 e
      assume he
      show by defs(simp(he), with_ghost)
    qed
    have kd: all t. o = diverge(t) -> with_ghost(o, h2) = diverge(t) proof
      fix t
      assume he
      show by defs(simp(he), with_ghost)
    qed
    have b := apply(g.bind_ghost[k2 := s9 v9. letin(v9, x5. bind_rel(gimple.result(w, x5), s9, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. with_ghost(o, h2) = ok(x6, pair(x8, x9)))), x6 x7. with_ghost(o, h2) = exc(x6, x7), x6. with_ghost(o, h2) = diverge(x6))),
      x2 := s9 e9. with_ghost(o, h2) = exc(s9, e9), d2 := t9. with_ghost(o, h2) = diverge(t9)], hq, hk, kk, kx, kd)
    have rq: runs(MQ, union2(s, h), with_ghost(o, h2)) by apply(tr.runs_intro, pu2, b)
    show by ex_intro({h2}, taut(hg2, rq))
  qed
  show by defs(main, refines_ghost)
qed

// (no result: the wrapper's registers any. Its continuation with a ghost
// part h2 joined; it never diverges)
theorem g.void_k_ghost(s3, o, h2):
  any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o = ok(s3, pair(x5, x6)))) ->
  any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. with_ghost(o, h2) = ok(union2(s3, h2), pair(x5, x6))))
proof
  assume hk
  have nz: ex y. y in bits(64) by ex_intro({0}, (0 in bits(64) by simp()))
  // (both choices from bits(64): some x5, x6)
  have e5: ex x5. x5 in bits(64) && (!(ex x6. x6 in bits(64)) || (ex x6. x6 in bits(64) && o = ok(s3, pair(x5, x6)))) by taut(expand(hk, any_rel), nz)
  obtain x5, hx5 h5 from e5
  have e6: ex x6. x6 in bits(64) && o = ok(s3, pair(x5, x6)) by taut(h5, nz)
  obtain x6, hx6 he from e6
  have g: with_ghost(o, h2) = ok(union2(s3, h2), pair(x5, x6)) by defs(simp(he), with_ghost)
  have f6: ex y. y in bits(64) && with_ghost(o, h2) = ok(union2(s3, h2), pair(x5, y)) by ex_intro({x6}, taut(hx6, g))
  have f5: ex y. y in bits(64) && (!(ex x6. x6 in bits(64)) || (ex x6. x6 in bits(64) && with_ghost(o, h2) = ok(union2(s3, h2), pair(y, x6))))
    by ex_intro({x5}, taut(hx5, f6))
  show by defs(taut(f5), any_rel)
qed

theorem g.void_k_ndiv(s3, t): !any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. diverge(t) = ok(s3, pair(x5, x6))))
proof
  assume hk
  have nz: ex y. y in bits(64) by ex_intro({0}, (0 in bits(64) by simp()))
  have e5: ex x5. x5 in bits(64) && (!(ex x6. x6 in bits(64)) || (ex x6. x6 in bits(64) && diverge(t) = ok(s3, pair(x5, x6)))) by taut(expand(hk, any_rel), nz)
  obtain x5, _ h5 from e5
  have e6: ex x6. x6 in bits(64) && diverge(t) = ok(s3, pair(x5, x6)) by taut(h5, nz)
  obtain x6, _ he from e6
  show by defs(simp(he), ok, diverge, tag)
qed

// (a void wrapper's call, the procedure refined with a ghost part: the
// spec's call, the ghost part it chooses)
theorem g.void_bind_ghost(p, q, G, s, h, o): (all h. h in G -> h in univ(1)) -> refines_ghost(p, q, abi.World, G) ->
  s in abi.World -> h in G -> pair(s, o) in univ(1) ->
  bind_rel(p, s, x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o = ok(x3, pair(x5, x6)))), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) ->
  ex h2. h2 in G && pair(union2(s, h), with_ghost(o, h2)) in univ(1) &&
    bind_rel(q, union2(s, h), x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. with_ghost(o, h2) = ok(x3, pair(x5, x6)))),
      x3 x4. with_ghost(o, h2) = exc(x3, x4), x3. with_ghost(o, h2) = diverge(x3))
proof
  assume hG hc hs hh pu hb
  have ou: o in univ(1) by simp(pu)
  have su: s in univ(1) by simp(pu)
  obtain o1, h1 hk from expand(hb, bind_rel)
  obtain h2, hg2 hq from mp(all_elim(expand(hc, refines_ghost), {s}, {h}, {o1}), hs, hh, h1)
  have hu2 := mp(all_elim(hG, {h2}), hg2)
  have gu := apply(g.with_ghost_univ, ou, hu2)
  have pu2: pair(union2(s, h), with_ghost(o, h2)) in univ(1) by simp(su, mp(all_elim(hG, {h}), hh), gu)
  // (the spec's outcome: o1's with h2 joined, each case as o's)
  let O := with_ghost(o1, h2)
  let K2(s9) := any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. with_ghost(o, h2) = ok(s9, pair(x5, x6))))
  have c1: (ex s1 v. o1 = ok(s1, v) && any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o = ok(s1, pair(x5, x6))))) ->
      (ex s1 v. O = ok(s1, v) && K2(s1)) proof
    assume e
    obtain s1 v, he hkv from e
    have oe: O = ok(union2(s1, h2), v) by defs(simp(he), with_ghost)
    show by ex_intro({union2(s1, h2)}, {v}, taut(oe, apply(g.void_k_ghost[s3 := s1, o := o, h2 := h2], hkv)))
  qed
  have c2: (ex s1 e. o1 = exc(s1, e) && o = exc(s1, e)) -> (ex s1 e. O = exc(s1, e) && with_ghost(o, h2) = exc(s1, e)) proof
    assume e
    obtain s1 v, he hxv from e
    have oe: O = exc(union2(s1, h2), v) by defs(simp(he), with_ghost)
    have ge: with_ghost(o, h2) = exc(union2(s1, h2), v) by defs(simp(hxv), with_ghost)
    show by ex_intro({union2(s1, h2)}, {v}, taut(oe, ge))
  qed
  have c3: (ex t. o1 = diverge(t) && o = diverge(t)) -> (ex t. O = diverge(t) && with_ghost(o, h2) = diverge(t)) proof
    assume e
    obtain t, he hdt from e
    have oe: O = diverge(t) by defs(simp(he), with_ghost)
    have ge: with_ghost(o, h2) = diverge(t) by defs(simp(hdt), with_ghost)
    show by ex_intro({t}, taut(oe, ge))
  qed
  have w: runs(q, union2(s, h), O) && ((ex s1 v. O = ok(s1, v) && K2(s1)) || (ex s1 e. O = exc(s1, e) && with_ghost(o, h2) = exc(s1, e)) ||
      (ex t. O = diverge(t) && with_ghost(o, h2) = diverge(t))) by taut(hq, hk, c1, c2, c3)
  have b: bind_rel(q, union2(s, h), x3 x4. K2(x3), x3 x4. with_ghost(o, h2) = exc(x3, x4), x3. with_ghost(o, h2) = diverge(x3)) by defs(ex_intro({O}, w), bind_rel)
  show by ex_intro({h2}, taut(hg2, pu2, b))
qed

// (no result; `g.fun_void` with a ghost part G)
theorem g.fun_void_ghost(x0. p, x0. q, n, G): (all h. h in G -> h in univ(1)) ->
  (all regs. refines_ghost(p(regs), q(regs), abi.World, G)) ->
  all regs. regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) ->
  refines_ghost(fn_build(set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)), x0. mkprog(x1 x2. !ord_le(n, seq_len(x0)) || bind_rel(p(x0), x1, x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. x2 = ok(x3, pair(x5, x6)))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))))[regs],
    fn_build(set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)), x0. mkprog(x1 x2. !ord_le(n, seq_len(x0)) || bind_rel(q(x0), x1, x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. x2 = ok(x3, pair(x5, x6)))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))))[regs],
    abi.World, G)
proof
  assume hG hc
  fix regs
  assume hr
  rsimp only, app_fn_build, hr
  let MQ := mkprog(x1 x2. !ord_le(n, seq_len(regs)) || bind_rel(q(regs), x1, x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. x2 = ok(x3, pair(x5, x6)))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))
  have main: all s h o. s in abi.World -> h in G -> runs(mkprog(x1 x2. !ord_le(n, seq_len(regs)) || bind_rel(p(regs), x1, x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. x2 = ok(x3, pair(x5, x6)))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), s, o) ->
      (ex h2. h2 in G && runs(MQ, union2(s, h), with_ghost(o, h2))) proof
    fix s h o
    assume hs hh ho
    have pu := apply(g.runs_univ, ho)
    have ou: o in univ(1) by simp(pu)
    have su: s in univ(1) by simp(pu)
    have r := apply(g.runs_elim, ho)
    // (too few arguments: the spec allows anything, the ghost part kept)
    have k1: case 1 of r proof
      assume hn
      have hu := mp(all_elim(hG, {h}), hh)
      have gu := apply(g.with_ghost_univ, ou, hu)
      have pu2: pair(union2(s, h), with_ghost(o, h)) in univ(1) by simp(su, hu, gu)
      have rq: runs(MQ, union2(s, h), with_ghost(o, h)) by apply(tr.runs_intro, pu2, taut(hn))
      show by ex_intro({h}, taut(hh, rq))
    qed
    // (else the spec's run, with the ghost part it chooses)
    have k2: case 2 of r proof
      assume hb
      obtain h2, hg2 pu2 b from apply(g.void_bind_ghost[p := p(regs), q := q(regs), G := G, s := s, h := h, o := o], hG, all_elim(hc, {regs}), hs, hh, pu, hb)
      have rq: runs(MQ, union2(s, h), with_ghost(o, h2)) by apply(tr.runs_intro, pu2, taut(b))
      show by ex_intro({h2}, taut(hg2, rq))
    qed
    show by taut(r, k1, k2)
  qed
  show by defs(main, refines_ghost)
qed

// (no argument read, no result)
theorem g.fun_void0_ghost(p, q, G): (all h. h in G -> h in univ(1)) -> refines_ghost(p, q, abi.World, G) ->
  all regs. regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) ->
  refines_ghost(fn_build(set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)), x0. mkprog(x1 x2. bind_rel(p, x1, x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. x2 = ok(x3, pair(x5, x6)))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))))[regs],
    fn_build(set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)), x0. mkprog(x1 x2. bind_rel(q, x1, x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. x2 = ok(x3, pair(x5, x6)))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))))[regs],
    abi.World, G)
proof
  assume hG hc
  fix regs
  assume hr
  rsimp only, app_fn_build, hr
  let MQ := mkprog(x1 x2. bind_rel(q, x1, x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. x2 = ok(x3, pair(x5, x6)))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))
  have main: all s h o. s in abi.World -> h in G -> runs(mkprog(x1 x2. bind_rel(p, x1, x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. x2 = ok(x3, pair(x5, x6)))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), s, o) ->
      (ex h2. h2 in G && runs(MQ, union2(s, h), with_ghost(o, h2))) proof
    fix s h o
    assume hs hh ho
    have pu := apply(g.runs_univ, ho)
    have r := apply(g.runs_elim, ho)
    obtain h2, hg2 pu2 b from apply(g.void_bind_ghost[p := p, q := q, G := G, s := s, h := h, o := o], hG, hc, hs, hh, pu, r)
    have rq: runs(MQ, union2(s, h), with_ghost(o, h2)) by apply(tr.runs_intro, pu2, b)
    show by ex_intro({h2}, taut(hg2, rq))
  qed
  show by defs(main, refines_ghost)
qed

// ----------------------------------------------------------------------
//  A contract's runs (layers/abi.sl: `require P; either { overflow() } or
//  { B }`, B's outcome x2 read as the procedure's): a run from s that
//  overflows, or one that B returns from with v

theorem ct.contract_ovf(x0. P, x0 x2. B, s, v, ob): P(s) -> v in x86_64_linux.Vm -> ob in abi.Objs ->
  pair(s, exc(fn_update(fn_update(s, "vm", v), "objs", ob), exc_val("stack_overflow", empty))) in univ(1) ->
  runs(mkprog(x0 x1. !P(x0) || (ex x2. (bind_rel(abi.overflow, x0, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)), x3. x2 = diverge(x3)) || B(x0, x2)) &&
    ((fst(x2) = 0 && x1 = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && x1 = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
      ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && x1 = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && x1 = diverge(snd(x2))))))),
    s, exc(fn_update(fn_update(s, "vm", v), "objs", ob), exc_val("stack_overflow", empty)))
proof
  assume hp hv hob hu
  let OVF := exc_val("stack_overflow", empty)
  let WV := fn_update(fn_update(s, "vm", v), "objs", ob)
  let O := exc(WV, OVF)
  let X2 := exc(pair(WV, empty), pair("raise", OVF))
  have ov := apply(ct.overflow_intro, hv, hob, hu)
  have bo: bind_rel(abi.overflow, s, x3 x4. X2 = ok(pair(x3, empty), empty), x3 x4. X2 = exc(pair(x3, empty), pair("raise", x4)), x3. X2 = diverge(x3))
    by defs(ex_intro({O}, taut(ov, (ex x3 x4. O = exc(x3, x4) && X2 = exc(pair(x3, empty), pair("raise", x4)) by ex_intro({WV}, {OVF}, simp())))), bind_rel)
  have mp1: fst(X2) = 1 && fst(out_value(X2)) = "raise" && O = exc(fst(out_state(X2)), snd(out_value(X2))) by simp()
  have e: (ex x2. (bind_rel(abi.overflow, s, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)), x3. x2 = diverge(x3)) || B(s, x2)) &&
    ((fst(x2) = 0 && O = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && O = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
      ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && O = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && O = diverge(snd(x2))))))
    by ex_intro({X2}, taut(bo, mp1))
  have r: !P(s) || (ex x2. (bind_rel(abi.overflow, s, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)), x3. x2 = diverge(x3)) || B(s, x2)) &&
    ((fst(x2) = 0 && O = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && O = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
      ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && O = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && O = diverge(snd(x2)))))) by taut(e)
  show by apply(tr.runs_intro, hu, r)
qed

theorem ct.contract_ret(x0. P, x0 x2. B, s, s1, v): P(s) -> B(s, exc(pair(s1, empty), pair("ret", v))) -> pair(s, ok(s1, v)) in univ(1) ->
  runs(mkprog(x0 x1. !P(x0) || (ex x2. (bind_rel(abi.overflow, x0, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)), x3. x2 = diverge(x3)) || B(x0, x2)) &&
    ((fst(x2) = 0 && x1 = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && x1 = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
      ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && x1 = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && x1 = diverge(snd(x2))))))),
    s, ok(s1, v))
proof
  assume hp hb hu
  let O := ok(s1, v)
  let X2 := exc(pair(s1, empty), pair("ret", v))
  have mp1: fst(X2) = 1 && fst(out_value(X2)) = "ret" && O = ok(fst(out_state(X2)), snd(out_value(X2))) by simp()
  have e: (ex x2. (bind_rel(abi.overflow, s, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)), x3. x2 = diverge(x3)) || B(s, x2)) &&
    ((fst(x2) = 0 && O = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && O = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
      ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && O = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && O = diverge(snd(x2))))))
    by ex_intro({X2}, taut(hb, mp1))
  have r: !P(s) || (ex x2. (bind_rel(abi.overflow, s, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)), x3. x2 = diverge(x3)) || B(s, x2)) &&
    ((fst(x2) = 0 && O = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && O = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
      ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && O = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && O = diverge(snd(x2)))))) by taut(e)
  show by apply(tr.runs_intro, hu, r)
qed

// (B ending without a value: the procedure's end, at state s1)
theorem ct.contract_done(x0. P, x0 x2. B, s, s1): P(s) -> B(s, ok(pair(s1, empty), empty)) -> pair(s, ok(s1, empty)) in univ(1) ->
  runs(mkprog(x0 x1. !P(x0) || (ex x2. (bind_rel(abi.overflow, x0, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)), x3. x2 = diverge(x3)) || B(x0, x2)) &&
    ((fst(x2) = 0 && x1 = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && x1 = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
      ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && x1 = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && x1 = diverge(snd(x2))))))),
    s, ok(s1, empty))
proof
  assume hp hb hu
  let O := ok(s1, empty)
  let X2 := ok(pair(s1, empty), empty)
  have mp1: fst(X2) = 0 && O = ok(fst(out_state(X2)), empty) by simp()
  have e: (ex x2. (bind_rel(abi.overflow, s, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)), x3. x2 = diverge(x3)) || B(s, x2)) &&
    ((fst(x2) = 0 && O = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && O = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
      ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && O = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && O = diverge(snd(x2))))))
    by ex_intro({X2}, taut(hb, mp1))
  have r: !P(s) || (ex x2. (bind_rel(abi.overflow, s, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)), x3. x2 = diverge(x3)) || B(s, x2)) &&
    ((fst(x2) = 0 && O = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && O = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
      ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && O = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && O = diverge(snd(x2)))))) by taut(e)
  show by apply(tr.runs_intro, hu, r)
qed

// A contract's run, its precondition holding: an overflow (the memory any)
// or an outcome of its body B (read as the procedure's)
theorem ct.contract_inv(x0. P, x0 x2. B, s, o):
  runs(mkprog(x0 x1. !P(x0) || (ex x2. (bind_rel(abi.overflow, x0, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)), x3. x2 = diverge(x3)) || B(x0, x2)) &&
    ((fst(x2) = 0 && x1 = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && x1 = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
      ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && x1 = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && x1 = diverge(snd(x2))))))),
    s, o) -> P(s) -> s.vm in x86_64_linux.Vm ->
  abi.ovf_out(s, o) ||
  (ex x2. B(s, x2) && ((fst(x2) = 0 && o = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && o = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
      ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && o = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && o = diverge(snd(x2))))))
proof
  assume hr hp hv
  let OVF := exc_val("stack_overflow", empty)
  have r := apply(g.runs_elim, hr)
  have e: ex x2. (bind_rel(abi.overflow, s, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)), x3. x2 = diverge(x3)) || B(s, x2)) &&
    ((fst(x2) = 0 && o = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && o = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
      ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && o = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && o = diverge(snd(x2))))) by taut(r, hp)
  obtain x2, hb hout from e
  have cb: B(s, x2) -> (ex x2. B(s, x2) && ((fst(x2) = 0 && o = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && o = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
      ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && o = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && o = diverge(snd(x2)))))) proof
    assume h
    show by ex_intro({x2}, taut(h, hout))
  qed
  have co: bind_rel(abi.overflow, s, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)), x3. x2 = diverge(x3)) ->
      abi.ovf_out(s, o) proof
    assume h
    obtain o1, hr1 hk1 from expand(h, bind_rel)
    obtain v ob, hv1 hob ho1 from mp(all_elim(ct.overflow_inv, {s}, {o1}), hv, hr1)
    have x2e: x2 = exc(pair(fn_update(fn_update(s, "vm", v), "objs", ob), empty), pair("raise", OVF)) by simp(rewrite(ho1, hk1))
    have oe: o = exc(fn_update(fn_update(s, "vm", v), "objs", ob), OVF) by simp(rewrite(x2e, hout))
    show by ex_intro({v}, {ob}, taut(hv1, hob, oe))
  qed
  show by taut(hb, cb, co)
qed

// (... a contract with no precondition: so too)
theorem ct.contract_inv0(x0 x2. B, s, o):
  runs(mkprog(x0 x1. ex x2. (bind_rel(abi.overflow, x0, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)), x3. x2 = diverge(x3)) || B(x0, x2)) &&
    ((fst(x2) = 0 && x1 = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && x1 = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
      ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && x1 = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && x1 = diverge(snd(x2)))))),
    s, o) -> s.vm in x86_64_linux.Vm ->
  abi.ovf_out(s, o) ||
  (ex x2. B(s, x2) && ((fst(x2) = 0 && o = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && o = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
      ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && o = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && o = diverge(snd(x2))))))
proof
  assume hr hv
  let OVF := exc_val("stack_overflow", empty)
  have r := apply(g.runs_elim, hr)
  obtain x2, hb hout from r
  have cb: B(s, x2) -> (ex x2. B(s, x2) && ((fst(x2) = 0 && o = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && o = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
      ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && o = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && o = diverge(snd(x2)))))) proof
    assume h
    show by ex_intro({x2}, taut(h, hout))
  qed
  have co: bind_rel(abi.overflow, s, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)), x3. x2 = diverge(x3)) ->
      abi.ovf_out(s, o) proof
    assume h
    obtain o1, hr1 hk1 from expand(h, bind_rel)
    obtain v ob, hv1 hob ho1 from mp(all_elim(ct.overflow_inv, {s}, {o1}), hv, hr1)
    have x2e: x2 = exc(pair(fn_update(fn_update(s, "vm", v), "objs", ob), empty), pair("raise", OVF)) by simp(rewrite(ho1, hk1))
    have oe: o = exc(fn_update(fn_update(s, "vm", v), "objs", ob), OVF) by simp(rewrite(x2e, hout))
    show by ex_intro({v}, {ob}, taut(hv1, hob, oe))
  qed
  show by taut(hb, cb, co)
qed

// ----------------------------------------------------------------------
//  A procedure's contract at a call: its C function value (GIMPLE's
//  wrapper, the result in a register)

// the procedure overflows or returns v, the world unchanged: so does its
// value, v in the result register's low w bits (`res`: GIMPLE's `result`
// at w bits, `g.result32_inv` / `g.result64_inv`)
theorem g.fun_q(x0. p, w, n, regs, s, o2, v): regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) -> ord_le(n, seq_len(regs)) -> s in abi.World ->
  (all o. runs(p(regs), s, o) -> abi.ovf_out(s, o) || o = ok(s, v)) ->
  (all o. runs(gimple.result(w, v), s, o) -> ex u. u in bits(64) && bits_of_int(w, u) = v && o = ok(s, u)) ->
  runs(fn_build(set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)), x0. mkprog(x1 x2. !ord_le(n, seq_len(x0)) || bind_rel(p(x0), x1, x3 x4. letin(x4, x5. bind_rel(gimple.result(w, x5), x3, x6 x7. any_rel(x8. x8 in bits(64), x8. x2 = ok(x6, pair(x7, x8))),
    x6 x7. x2 = exc(x6, x7), x6. x2 = diverge(x6))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))))[regs], s, o2) ->
  abi.ovf_out(s, o2) ||
  (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && bits_of_int(w, fst(r)) = v && fst(r) in bits(64))
proof
  assume hr hn hw hp hres h
  let OVF := exc_val("stack_overflow", empty)
  rsimp only, app_fn_build, hr in h
  have pv pf pd pb := apply(ms.world_parts, hw)
  have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], pf, pd)
  have b := apply(g.runs_elim, h)
  have b2: bind_rel(p(regs), s, x3 x4. letin(x4, x5. bind_rel(gimple.result(w, x5), x3, x6 x7. any_rel(x8. x8 in bits(64), x8. o2 = ok(x6, pair(x7, x8))),
      x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))), x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3)) by taut(b, hn)
  obtain o3, hs3 hk3 from expand(b2, bind_rel)
  have c1: abi.ovf_out(s, o3) ->
      abi.ovf_out(s, o2) || (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && bits_of_int(w, fst(r)) = v && fst(r) in bits(64)) proof
    assume e
    obtain vm ob, hv hob he from e
    have oe: o2 = exc(fn_update(fn_update(s, "vm", vm), "objs", ob), OVF) by simp(rewrite(he, hk3))
    have l: abi.ovf_out(s, o2) by ex_intro({vm}, {ob}, taut(hv, hob, oe))
    show by taut(l)
  qed
  have c2: o3 = ok(s, v) ->
      abi.ovf_out(s, o2) || (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && bits_of_int(w, fst(r)) = v && fst(r) in bits(64)) proof
    assume he
    have k1: bind_rel(gimple.result(w, v), s, x6 x7. any_rel(x8. x8 in bits(64), x8. o2 = ok(x6, pair(x7, x8))), x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))
      by simp(expand(rewrite(he, hk3), letin), keep(bind_rel, gimple.result))
    obtain o4, hr4 hk4 from expand(k1, bind_rel)
    obtain u, hu64 hlow ho4 from mp(all_elim(hres, {o4}), hr4)
    have k2: any_rel(x8. x8 in bits(64), x8. o2 = ok(s, pair(u, x8))) by simp(rewrite(ho4, hk4), keep(any_rel))
    have ne: ex y. y in bits(64) by ex_intro({0}, simp())
    obtain y, hy hoy from apply(g.any_e, ne, k2)
    have cl: bits_of_int(w, fst(pair(u, y))) = v by simp(hlow)
    have fb: fst(pair(u, y)) in bits(64) by simp(hu64)
    have l: ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && bits_of_int(w, fst(r)) = v && fst(r) in bits(64) by ex_intro({pair(u, y)}, taut(rewrite(sym(ss), hoy), cl, fb))
    show by taut(l)
  qed
  show by taut(mp(all_elim(hp, {o3}), hs3), c1, c2)
qed

// ----------------------------------------------------------------------
//  A contract refined with the ghost part kept: the code's outcomes
//  under the precondition

// A contract spec over the world with a ghost part, refined by a program
// over the world that leaves the ghost part alone: under the precondition
// at the joined state, the program overflows or returns as B allows.
theorem ct.refines_contract(p, x0. P, x0 x2. B, G):
  (all h. h in G -> h in univ(1) && (all z. z in h -> !(fst(z) in abi.WKEYS))) ->
  (all s o. runs(p, s, o) -> pair(s, o) in univ(1)) ->
  (all s h o. s in abi.World -> h in G -> runs(p, s, o) -> P(union2(s, h)) ->
    abi.ovf_out(s, o) ||
    (ex s1 v. o = ok(s1, v) && B(union2(s, h), exc(pair(union2(s1, h), empty), pair("ret", v))))) ->
  refines_ghost(p, mkprog(x0 x1. !P(x0) || (ex x2. (bind_rel(abi.overflow, x0, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)), x3. x2 = diverge(x3)) || B(x0, x2)) &&
    ((fst(x2) = 0 && x1 = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && x1 = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
      ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && x1 = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && x1 = diverge(snd(x2))))))),
    abi.World, G)
proof
  assume hG hp hc
  let Q := mkprog(x0 x1. !P(x0) || (ex x2. (bind_rel(abi.overflow, x0, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)), x3. x2 = diverge(x3)) || B(x0, x2)) &&
    ((fst(x2) = 0 && x1 = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && x1 = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
      ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && x1 = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && x1 = diverge(snd(x2)))))))
  let OVF := exc_val("stack_overflow", empty)
  have main: all s h o. s in abi.World -> h in G -> runs(p, s, o) -> (ex h2. h2 in G && runs(Q, union2(s, h), with_ghost(o, h2))) proof
    fix s h o
    assume hs hh hr
    have hu hk := mp(all_elim(hG, {h}), hh)
    have pu := mp(all_elim(hp, {s}, {o}), hr)
    have su: s in univ(1) by simp(pu)
    have ou: o in univ(1) by simp(pu)
    let S := union2(s, h)
    have gu := apply(g.with_ghost_univ, ou, hu)
    have pu2: pair(S, with_ghost(o, h)) in univ(1) by simp(su, hu, gu)
    // the precondition fails: anything
    have n: !P(S) -> runs(Q, S, with_ghost(o, h)) proof
      assume hn
      show by apply(tr.runs_intro, pu2, taut(hn))
    qed
    have y: P(S) -> runs(Q, S, with_ghost(o, h)) proof
      assume hP
      have cs := mp(all_elim(hc, {s}, {h}, {o}), hs, hh, hr, hP)
      // an overflow: its memory in the world's part
      have c1: abi.ovf_out(s, o) -> runs(Q, S, with_ghost(o, h)) proof
        assume e
        obtain v ob, hv hob hov from e
        have lv: all z. z in h -> fst(z) != "vm" proof
          fix z
          assume hz
          show by simp(mp(all_elim(hk, {z}), hz))
        qed
        have lo: all z. z in h -> fst(z) != "objs" proof
          fix z
          assume hz
          show by simp(mp(all_elim(hk, {z}), hz))
        qed
        have eu := mp(fn_update_union_l[a := s, b := h, k := "vm", v := v], lv)
        have eo := mp(fn_update_union_l[a := fn_update(s, "vm", v), b := h, k := "objs", v := ob], lo)
        have eu2: union2(fn_update(fn_update(s, "vm", v), "objs", ob), h) = fn_update(fn_update(S, "vm", v), "objs", ob) :=
          trans(sym(eo), subst({y. fn_update(union2(fn_update(s, "vm", v), h), "objs", ob) = fn_update(y, "objs", ob)}, sym(eu), refl({fn_update(union2(fn_update(s, "vm", v), h), "objs", ob)})))
        have wg0: with_ghost(o, h) = exc(union2(fn_update(fn_update(s, "vm", v), "objs", ob), h), OVF) by simp(hov)
        have wg: with_ghost(o, h) = exc(fn_update(fn_update(S, "vm", v), "objs", ob), OVF) := trans(wg0, subst({y. exc(union2(fn_update(fn_update(s, "vm", v), "objs", ob), h), OVF) = exc(y, OVF)}, eu2, refl({exc(union2(fn_update(fn_update(s, "vm", v), "objs", ob), h), OVF)})))
        have pu3 := rewrite(wg, pu2)
        have t: runs(Q, S, exc(fn_update(fn_update(S, "vm", v), "objs", ob), OVF)) by apply(ct.contract_ovf, hP, hv, hob, pu3)
        show := rewrite(sym(wg), t)
      qed
      // a return: as B allows, the ghost part kept
      have c2: (ex s1 v. o = ok(s1, v) && B(S, exc(pair(union2(s1, h), empty), pair("ret", v)))) -> runs(Q, S, with_ghost(o, h)) proof
        assume e
        obtain s1 v, hov hb from e
        have wg: with_ghost(o, h) = ok(union2(s1, h), v) by simp(hov)
        have pu3 := rewrite(wg, pu2)
        have t: runs(Q, S, ok(union2(s1, h), v)) by apply(ct.contract_ret, hP, hb, pu3)
        show := rewrite(sym(wg), t)
      qed
      show by taut(cs, c1, c2)
    qed
    show by ex_intro({h}, taut(hh, n, y))
  qed
  show by defs(main, refines_ghost)
qed

// A contract spec over the world with a ghost part, refined by a program
// over the world: under the precondition at the joined state, the program
// overflows (the ghost part kept) or returns as B allows, the ghost part
// h2 chosen (B's ghost updates) -- or, B ending without a value, ends.
theorem ct.refines_contract_ge(p, x0. P, x0 x2. B, G):
  (all h. h in G -> h in univ(1) && (all z. z in h -> !(fst(z) in abi.WKEYS))) ->
  (all s o. runs(p, s, o) -> pair(s, o) in univ(1)) ->
  (all s h o. s in abi.World -> h in G -> runs(p, s, o) -> P(union2(s, h)) ->
    abi.ovf_out(s, o) ||
    (ex s1 v h2. h2 in G && o = ok(s1, v) && B(union2(s, h), exc(pair(union2(s1, h2), empty), pair("ret", v)))) ||
    (ex s1 h2. h2 in G && o = ok(s1, empty) && B(union2(s, h), ok(pair(union2(s1, h2), empty), empty)))) ->
  refines_ghost(p, mkprog(x0 x1. !P(x0) || (ex x2. (bind_rel(abi.overflow, x0, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)), x3. x2 = diverge(x3)) || B(x0, x2)) &&
    ((fst(x2) = 0 && x1 = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && x1 = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
      ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && x1 = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && x1 = diverge(snd(x2))))))),
    abi.World, G)
proof
  assume hG hp hc
  let Q := mkprog(x0 x1. !P(x0) || (ex x2. (bind_rel(abi.overflow, x0, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)), x3. x2 = diverge(x3)) || B(x0, x2)) &&
    ((fst(x2) = 0 && x1 = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && x1 = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
      ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && x1 = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && x1 = diverge(snd(x2)))))))
  let OVF := exc_val("stack_overflow", empty)
  have main: all s h o. s in abi.World -> h in G -> runs(p, s, o) -> (ex h2. h2 in G && runs(Q, union2(s, h), with_ghost(o, h2))) proof
    fix s h o
    assume hs hh hr
    have hu hk := mp(all_elim(hG, {h}), hh)
    have pu := mp(all_elim(hp, {s}, {o}), hr)
    have su: s in univ(1) by simp(pu)
    have ou: o in univ(1) by simp(pu)
    let S := union2(s, h)
    have gu := apply(g.with_ghost_univ, ou, hu)
    have pu2: pair(S, with_ghost(o, h)) in univ(1) by simp(su, hu, gu)
    // the precondition fails: anything
    have n: !P(S) -> runs(Q, S, with_ghost(o, h)) proof
      assume hn
      show by apply(tr.runs_intro, pu2, taut(hn))
    qed
    have kept: runs(Q, S, with_ghost(o, h)) -> (ex h2. h2 in G && runs(Q, S, with_ghost(o, h2))) proof
      assume hq
      show by ex_intro({h}, taut(hh, hq))
    qed
    have y: P(S) -> (ex h2. h2 in G && runs(Q, S, with_ghost(o, h2))) proof
      assume hP
      have cs := mp(all_elim(hc, {s}, {h}, {o}), hs, hh, hr, hP)
      // an overflow: its memory in the world's part
      have c1: abi.ovf_out(s, o) -> runs(Q, S, with_ghost(o, h)) proof
        assume e
        obtain v ob, hv hob hov from e
        have lv: all z. z in h -> fst(z) != "vm" proof
          fix z
          assume hz
          show by simp(mp(all_elim(hk, {z}), hz))
        qed
        have lo: all z. z in h -> fst(z) != "objs" proof
          fix z
          assume hz
          show by simp(mp(all_elim(hk, {z}), hz))
        qed
        have eu := mp(fn_update_union_l[a := s, b := h, k := "vm", v := v], lv)
        have eo := mp(fn_update_union_l[a := fn_update(s, "vm", v), b := h, k := "objs", v := ob], lo)
        have eu2: union2(fn_update(fn_update(s, "vm", v), "objs", ob), h) = fn_update(fn_update(S, "vm", v), "objs", ob) :=
          trans(sym(eo), subst({y. fn_update(union2(fn_update(s, "vm", v), h), "objs", ob) = fn_update(y, "objs", ob)}, sym(eu), refl({fn_update(union2(fn_update(s, "vm", v), h), "objs", ob)})))
        have wg0: with_ghost(o, h) = exc(union2(fn_update(fn_update(s, "vm", v), "objs", ob), h), OVF) by simp(hov)
        have wg: with_ghost(o, h) = exc(fn_update(fn_update(S, "vm", v), "objs", ob), OVF) := trans(wg0, subst({y. exc(union2(fn_update(fn_update(s, "vm", v), "objs", ob), h), OVF) = exc(y, OVF)}, eu2, refl({exc(union2(fn_update(fn_update(s, "vm", v), "objs", ob), h), OVF)})))
        have pu3 := rewrite(wg, pu2)
        have t: runs(Q, S, exc(fn_update(fn_update(S, "vm", v), "objs", ob), OVF)) by apply(ct.contract_ovf, hP, hv, hob, pu3)
        show := rewrite(sym(wg), t)
      qed
      // a return: as B allows, the ghost part h2
      have c2: (ex s1 v h2. h2 in G && o = ok(s1, v) && B(S, exc(pair(union2(s1, h2), empty), pair("ret", v)))) -> (ex h2. h2 in G && runs(Q, S, with_ghost(o, h2))) proof
        assume e
        obtain s1 v h2, hg2 hov hb from e
        have hu2 _ := mp(all_elim(hG, {h2}), hg2)
        have gu2 := apply(g.with_ghost_univ, ou, hu2)
        have wg: with_ghost(o, h2) = ok(union2(s1, h2), v) by simp(hov)
        have pu3: pair(S, ok(union2(s1, h2), v)) in univ(1) := rewrite(wg, (pair(S, with_ghost(o, h2)) in univ(1) by simp(su, hu, gu2)))
        have t: runs(Q, S, ok(union2(s1, h2), v)) by apply(ct.contract_ret, hP, hb, pu3)
        show by ex_intro({h2}, taut(hg2, rewrite(sym(wg), t)))
      qed
      // an end without a value: as B allows, the ghost part h2
      have c3: (ex s1 h2. h2 in G && o = ok(s1, empty) && B(S, ok(pair(union2(s1, h2), empty), empty))) -> (ex h2. h2 in G && runs(Q, S, with_ghost(o, h2))) proof
        assume e
        obtain s1 h2, hg2 hov hb from e
        have hu2 _ := mp(all_elim(hG, {h2}), hg2)
        have gu2 := apply(g.with_ghost_univ, ou, hu2)
        have wg: with_ghost(o, h2) = ok(union2(s1, h2), empty) by simp(hov)
        have pu3: pair(S, ok(union2(s1, h2), empty)) in univ(1) := rewrite(wg, (pair(S, with_ghost(o, h2)) in univ(1) by simp(su, hu, gu2)))
        have t: runs(Q, S, ok(union2(s1, h2), empty)) by apply(ct.contract_done, hP, hb, pu3)
        show by ex_intro({h2}, taut(hg2, rewrite(sym(wg), t)))
      qed
      show by taut(cs, c1, c2, c3, kept)
    qed
    show by taut(n, y, kept)
  qed
  show by defs(main, refines_ghost)
qed

// (B always returning a value)
theorem ct.refines_contract_g(p, x0. P, x0 x2. B, G):
  (all h. h in G -> h in univ(1) && (all z. z in h -> !(fst(z) in abi.WKEYS))) ->
  (all s o. runs(p, s, o) -> pair(s, o) in univ(1)) ->
  (all s h o. s in abi.World -> h in G -> runs(p, s, o) -> P(union2(s, h)) ->
    abi.ovf_out(s, o) ||
    (ex s1 v h2. h2 in G && o = ok(s1, v) && B(union2(s, h), exc(pair(union2(s1, h2), empty), pair("ret", v))))) ->
  refines_ghost(p, mkprog(x0 x1. !P(x0) || (ex x2. (bind_rel(abi.overflow, x0, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)), x3. x2 = diverge(x3)) || B(x0, x2)) &&
    ((fst(x2) = 0 && x1 = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && x1 = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
      ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && x1 = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && x1 = diverge(snd(x2))))))),
    abi.World, G)
proof
  assume hG hp hc
  have hc3: all s h o. s in abi.World -> h in G -> runs(p, s, o) -> P(union2(s, h)) ->
      abi.ovf_out(s, o) ||
      (ex s1 v h2. h2 in G && o = ok(s1, v) && B(union2(s, h), exc(pair(union2(s1, h2), empty), pair("ret", v)))) ||
      (ex s1 h2. h2 in G && o = ok(s1, empty) && B(union2(s, h), ok(pair(union2(s1, h2), empty), empty))) proof
    fix s h o
    assume hs hh hr hP
    show by taut(mp(all_elim(hc, {s}, {h}, {o}), hs, hh, hr, hP))
  qed
  show := apply(ct.refines_contract_ge[p := p, P := x0. P(x0), B := x0 x2. B(x0, x2), G := G], hG, hp, hc3)
qed

// ----------------------------------------------------------------------
//  A contract diverges only where it raises (`tr.div_raises_g`): only
//  where it is undefined -- its precondition failing, or a choice from
//  nothing in its body -- and so anything

// (a choice from d, then k: an outcome tagged 2 only where any is)
theorem ct.dv_any(x. d, y x. k, x, x2): (all y. d(y) -> k(y, x) -> fst(x) = 2 -> k(y, x2)) -> any_rel(y. d(y), y. k(y, x)) -> fst(x) = 2 -> any_rel(y. d(y), y. k(y, x2))
proof
  assume hk ha hf
  have c1: !(ex y. d(y)) -> any_rel(y. d(y), y. k(y, x2)) proof
    assume hn
    show by defs(taut(hn), any_rel)
  qed
  have c2: (ex y. d(y) && k(y, x)) -> any_rel(y. d(y), y. k(y, x2)) proof
    assume e
    obtain y, hd hky from e
    have k2 := mp(all_elim(hk, {y}), hd, hky, hf)
    have e2: ex y. d(y) && k(y, x2) by ex_intro({y}, taut(hd, k2))
    show by defs(taut(e2), any_rel)
  qed
  show by taut(expand(ha, any_rel), c1, c2)
qed

// (an exception: tagged 1, not 2)
theorem ct.exc_not2(x, a, b): x = exc(a, b) -> !(fst(x) = 2)
proof
  assume he
  have f1: fst(x) = 1 by defs(simp(he), exc, tag)
  show by arith(f1)
qed

// (an outcome given: tagged 0 or 1, not 2)
theorem ct.dv_exc(x, a, b, x2): x = exc(a, b) -> fst(x) = 2 -> x = x2
proof
  assume he hf
  have n := apply(ct.exc_not2[x := x, a := a, b := b], he)
  show by taut(n, hf)
qed

// a contract (`require P; either { overflow() } or { B }`) diverging at s:
// its precondition failing or B undefined there, so it raises at s too
theorem ct.contract_div(x0. P, x0 x2. B, s, t): s in univ(1) -> s.vm in x86_64_linux.Vm ->
  runs(mkprog(x0 x1. !P(x0) || (ex x2. (bind_rel(abi.overflow, x0, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)), x3. x2 = diverge(x3)) || B(x0, x2)) &&
    ((fst(x2) = 0 && x1 = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && x1 = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
      ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && x1 = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && x1 = diverge(snd(x2))))))),
    s, diverge(t)) -> (all x x2. B(s, x) -> fst(x) = 2 -> B(s, x2)) ->
  runs(mkprog(x0 x1. !P(x0) || (ex x2. (bind_rel(abi.overflow, x0, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)), x3. x2 = diverge(x3)) || B(x0, x2)) &&
    ((fst(x2) = 0 && x1 = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && x1 = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
      ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && x1 = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && x1 = diverge(snd(x2))))))),
    s, exc(s, empty))
proof
  assume hu hv hr hb
  let OV(x2) := bind_rel(abi.overflow, s, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)), x3. x2 = diverge(x3))
  let D(x2, o) := (fst(x2) = 0 && o = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && o = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
      ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && o = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && o = diverge(snd(x2))))
  let X2 := exc(pair(s, empty), pair("raise", empty))
  have r := apply(g.runs_elim, hr)
  have pu: pair(s, exc(s, empty)) in univ(1) by simp(hu)
  have c1: !P(s) -> !P(s) || (ex x2. (OV(x2) || B(s, x2)) && D(x2, exc(s, empty))) proof
    assume hn
    show by taut(hn)
  qed
  have c2: (ex x2. (OV(x2) || B(s, x2)) && D(x2, diverge(t))) -> !P(s) || (ex x2. (OV(x2) || B(s, x2)) && D(x2, exc(s, empty))) proof
    assume e
    obtain x2, hob hd from e
    // (the dispatch: a divergence only from a value tagged 2)
    have f2: fst(x2) = 2 by defs(simp(hd), ok, exc, diverge, tag)
    // (the overflow's outcome: an exception, tagged 1)
    have nov: !OV(x2) proof
      assume h
      obtain o1, hr1 hk1 from expand(h, bind_rel)
      obtain v ob, _ _ ho1 from mp(all_elim(ct.overflow_inv, {s}, {o1}), hv, hr1)
      have k := rewrite(ho1, hk1)
      have n2 := ct.exc_not2[x := x2, a := pair(fn_update(fn_update(s, "vm", v), "objs", ob), empty), b := pair("raise", exc_val("stack_overflow", empty))]
      show by defs(simp(k, f2, n2), ok, exc, diverge, tag)
    qed
    have bx := mp(all_elim(hb, {x2}, {X2}), taut(hob, nov), f2)
    have dx: D(X2, exc(s, empty)) by defs(simp(), exc, tag, out_state, out_value)
    have ex: ex x2. (OV(x2) || B(s, x2)) && D(x2, exc(s, empty)) by ex_intro({X2}, taut(bx, dx))
    show by taut(ex)
  qed
  have rr: !P(s) || (ex x2. (OV(x2) || B(s, x2)) && D(x2, exc(s, empty))) by taut(r, c1, c2)
  show by apply(tr.runs_intro, pu, rr)
qed

// a function value of a procedure q (GIMPLE's wrapper, its result in a
// register): it raises where it diverges, if q does
theorem ct.fun_div(x0. q, n, w, regs, s, t): regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) -> s in univ(1) ->
  (all o. runs(q(regs), s, o) -> pair(s, o) in univ(1)) -> (all t2. runs(q(regs), s, diverge(t2)) -> runs(q(regs), s, exc(s, empty))) ->
  runs(fn_build(set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)), x0. mkprog(x1 x2. !ord_le(n, seq_len(x0)) || bind_rel(q(x0), x1, x3 x4. letin(x4, x5. bind_rel(gimple.result(w, x5), x3, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. x2 = ok(x6, pair(x8, x9)))), x6 x7. x2 = exc(x6, x7), x6. x2 = diverge(x6))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))))[regs], s, diverge(t)) ->
  runs(fn_build(set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)), x0. mkprog(x1 x2. !ord_le(n, seq_len(x0)) || bind_rel(q(x0), x1, x3 x4. letin(x4, x5. bind_rel(gimple.result(w, x5), x3, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. x2 = ok(x6, pair(x8, x9)))), x6 x7. x2 = exc(x6, x7), x6. x2 = diverge(x6))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))))[regs], s, exc(s, empty))
proof
  assume hr hu hqu hq h
  let K(s3, v, o) := letin(v, x5. bind_rel(gimple.result(w, x5), s3, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. o = ok(x6, pair(x8, x9)))), x6 x7. o = exc(x6, x7), x6. o = diverge(x6)))
  let R(o) := !ord_le(n, seq_len(regs)) || bind_rel(q(regs), s, x3 x4. K(x3, x4, o), x3 x4. o = exc(x3, x4), x3. o = diverge(x3))
  let O := exc(s, empty)
  have ef := app_fn_build[d := set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)), v := x0. mkprog(x1 x2. !ord_le(n, seq_len(x0)) || bind_rel(q(x0), x1, x3 x4. K(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), a := regs]
  have e1 := mp(ef, hr)
  have r := apply(g.runs_elim, rewrite(e1, h))
  have pu: pair(s, O) in univ(1) by simp(hu)
  have g1: !ord_le(n, seq_len(regs)) -> R(O) proof
    assume hn
    show by taut(hn)
  qed
  have g2: bind_rel(q(regs), s, x3 x4. K(x3, x4, diverge(t)), x3 x4. diverge(t) = exc(x3, x4), x3. diverge(t) = diverge(x3)) -> R(O) proof
    assume hb
    have hb2: ex o1. runs(q(regs), s, o1) && ((ex s3 v. o1 = ok(s3, v) && K(s3, v, diverge(t))) || (ex s1 e. o1 = exc(s1, e) && diverge(t) = exc(s1, e)) ||
        (ex t2. o1 = diverge(t2) && diverge(t) = diverge(t2))) by defs(expand(hb, bind_rel), bind_rel)
    obtain o1, hr1 hk1 from hb2
    // q diverging: it raises at s, the wrapper too
    have d1: (ex t2. o1 = diverge(t2) && diverge(t) = diverge(t2)) -> R(O) proof
      assume e
      obtain t2, eo _ from e
      have rq := mp(all_elim(hq, {t2}), rewrite(eo, hr1))
      have b: bind_rel(q(regs), s, x3 x4. K(x3, x4, O), x3 x4. O = exc(x3, x4), x3. O = diverge(x3))
        by defs(ex_intro({O}, taut(rq, (ex s1 e. O = exc(s1, e) && O = exc(s1, e) by ex_intro({s}, {empty}, simp())))), bind_rel)
      show by taut(b)
    qed
    // q returning: the result step diverging, undefined, so anything
    have d2: (ex s3 v. o1 = ok(s3, v) && K(s3, v, diverge(t))) -> R(O) proof
      assume e
      obtain s3 v, eo hk from e
      have o1u: o1 in univ(1) by simp(mp(all_elim(hqu, {o1}), hr1))
      have oku := expand(rewrite(eo, o1u), ok, tag)
      have s3u: s3 in univ(1) by simp(oku)
      obtain o2, hr2 hk2 from expand(expand(hk, letin), bind_rel)
      have nok: !(ex x6 x7. o2 = ok(x6, x7) && any_rel(x9. x9 in bits(64), x9. diverge(t) = ok(x6, pair(x7, x9)))) proof
        assume e2
        obtain x6 x7, _ ha from e2
        have z: 0 in bits(64) by simp()
        show by defs(simp(ha, z), letin, any_rel, ok, diverge, tag)
      qed
      have nex: !(ex x6 x7. o2 = exc(x6, x7) && diverge(t) = exc(x6, x7)) by defs(simp(), exc, diverge, tag)
      have dv: ex t3. o2 = diverge(t3) && diverge(t) = diverge(t3) by taut(hk2, nok, nex)
      obtain t3, eo2 _ from dv
      have rr := apply(g.runs_elim, rewrite(eo2, expand(hr2, gimple.result)))
      have und: !(ex x2. x2 in bits(64) && x2 in gimple.in_reg(v, fn_update(fn_update(empty, "prec", w), "signed", false))) by defs(simp(rr), any_rel, ok, diverge, tag)
      have p3: pair(s3, O) in univ(1) by simp(s3u, hu)
      have rO: runs(gimple.result(w, v), s3, O) by defs(apply(tr.runs_intro, p3, (any_rel(x2. x2 in bits(64) && x2 in gimple.in_reg(v, fn_update(fn_update(empty, "prec", w), "signed", false)), x2. O = ok(s3, x2)) by defs(taut(und), any_rel))), gimple.result)
      have xO: ex x6 x7. O = exc(x6, x7) && O = exc(x6, x7) by ex_intro({s}, {empty}, simp())
      have kOb: bind_rel(gimple.result(w, v), s3, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. O = ok(x6, pair(x8, x9)))), x6 x7. O = exc(x6, x7), x6. O = diverge(x6))
        by defs(ex_intro({O}, taut(rO, xO)), bind_rel)
      have kO: K(s3, v, O) by defs(expand(kOb, letin), letin)
      have b: bind_rel(q(regs), s, x3 x4. K(x3, x4, O), x3 x4. O = exc(x3, x4), x3. O = diverge(x3))
        by defs(ex_intro({o1}, taut(hr1, expand((ex s1 v1. o1 = ok(s1, v1) && K(s1, v1, O) by ex_intro({s3}, {v}, taut(eo, kO))), bind_rel))), bind_rel)
      show by taut(b)
    qed
    have d3: !(ex s1 e. o1 = exc(s1, e) && diverge(t) = exc(s1, e)) by defs(simp(), exc, diverge, tag)
    show by taut(hk1, d1, d2, d3)
  qed
  have rO: R(O) by taut(r, g1, g2)
  have rm: runs(mkprog(x1 x2. !ord_le(n, seq_len(regs)) || bind_rel(q(regs), x1, x3 x4. K(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), s, O)
    by apply(tr.runs_intro, pu, rO)
  show := rewrite(sym(e1), rm)
qed

// (a contract's body returning a value chosen from d: tagged 2 only where
// d is empty)
theorem ct.dv_ret(x. d, s, x, x2): any_rel(y. d(y), y. x = exc(pair(s, empty), pair("ret", y))) -> fst(x) = 2 ->
  any_rel(y. d(y), y. x2 = exc(pair(s, empty), pair("ret", y)))
proof
  assume ha hf
  have k: all y. d(y) -> x = exc(pair(s, empty), pair("ret", y)) -> fst(x) = 2 -> x2 = exc(pair(s, empty), pair("ret", y)) proof
    fix y
    assume _ he hf2
    have n := apply(ct.exc_not2[x := x, a := pair(s, empty), b := pair("ret", y)], he)
    show by taut(n, hf2)
  qed
  show := apply(ct.dv_any[d := y. d(y), k := y x. x = exc(pair(s, empty), pair("ret", y)), x := x, x2 := x2], k, ha, hf)
qed

// (two choices, then the return: tagged 2 only where one is from nothing)
theorem ct.dv_ret2(x. d, y z. e, y z. f, y z. g, x, x2):
  any_rel(y. d(y), y. any_rel(z. e(y, z), z. x = exc(pair(f(y, z), empty), pair("ret", g(y, z))))) -> fst(x) = 2 ->
  any_rel(y. d(y), y. any_rel(z. e(y, z), z. x2 = exc(pair(f(y, z), empty), pair("ret", g(y, z)))))
proof
  assume ha hf
  have k: all y. d(y) -> any_rel(z. e(y, z), z. x = exc(pair(f(y, z), empty), pair("ret", g(y, z)))) -> fst(x) = 2 ->
      any_rel(z. e(y, z), z. x2 = exc(pair(f(y, z), empty), pair("ret", g(y, z)))) proof
    fix y
    assume _ hy hf2
    have k2: all z. e(y, z) -> x = exc(pair(f(y, z), empty), pair("ret", g(y, z))) -> fst(x) = 2 -> x2 = exc(pair(f(y, z), empty), pair("ret", g(y, z))) proof
      fix z
      assume _ he hf3
      have n := apply(ct.exc_not2[x := x, a := pair(f(y, z), empty), b := pair("ret", g(y, z))], he)
      show by taut(n, hf3)
    qed
    show := apply(ct.dv_any[d := z. e(y, z), k := z x. x = exc(pair(f(y, z), empty), pair("ret", g(y, z))), x := x, x2 := x2], k2, hy, hf2)
  qed
  show := apply(ct.dv_any[d := y. d(y), k := y x. any_rel(z. e(y, z), z. x = exc(pair(f(y, z), empty), pair("ret", g(y, z)))), x := x, x2 := x2], k, ha, hf)
qed

// (three choices, then the return)
theorem ct.dv_ret3(x. d, y z. e, y z u. f, y z u. g, y z u. v, x, x2):
  any_rel(y. d(y), y. any_rel(z. e(y, z), z. any_rel(u. f(y, z, u), u. x = exc(pair(g(y, z, u), empty), pair("ret", v(y, z, u)))))) -> fst(x) = 2 ->
  any_rel(y. d(y), y. any_rel(z. e(y, z), z. any_rel(u. f(y, z, u), u. x2 = exc(pair(g(y, z, u), empty), pair("ret", v(y, z, u))))))
proof
  assume ha hf
  have k: all y. d(y) -> any_rel(z. e(y, z), z. any_rel(u. f(y, z, u), u. x = exc(pair(g(y, z, u), empty), pair("ret", v(y, z, u))))) -> fst(x) = 2 ->
      any_rel(z. e(y, z), z. any_rel(u. f(y, z, u), u. x2 = exc(pair(g(y, z, u), empty), pair("ret", v(y, z, u))))) proof
    fix y
    assume _ hy hf2
    show := apply(ct.dv_ret2[d := z. e(y, z), e := z u. f(y, z, u), f := z u. g(y, z, u), g := z u. v(y, z, u), x := x, x2 := x2], hy, hf2)
  qed
  show := apply(ct.dv_any[d := y. d(y), k := y x. any_rel(z. e(y, z), z. any_rel(u. f(y, z, u), u. x = exc(pair(g(y, z, u), empty), pair("ret", v(y, z, u))))), x := x, x2 := x2],
    k, ha, hf)
qed

// a purpose spec's function value (GIMPLE's wrapper around q, a contract
// over the world with a ghost part): it raises where it diverges, if q
// does at each world with a ghost part (`ct.contract_div`)
theorem ct.fun_divg(G, x0. q, n, w): (all h. h in G -> h in univ(1)) -> (all regs s o. runs(q(regs), s, o) -> pair(s, o) in univ(1)) ->
  (all regs w h t. regs in abi.ARGS -> w in abi.World -> w in univ(1) -> h in G -> runs(q(regs), union2(w, h), diverge(t)) -> runs(q(regs), union2(w, h), exc(union2(w, h), empty))) ->
  tr.div_raises_g(G, fn_build(set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)), x0. mkprog(x1 x2. !ord_le(n, seq_len(x0)) || bind_rel(q(x0), x1, x3 x4. letin(x4, x5. bind_rel(gimple.result(w, x5), x3, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. x2 = ok(x6, pair(x8, x9)))), x6 x7. x2 = exc(x6, x7), x6. x2 = diverge(x6))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))))
proof
  assume hgu hqu hq
  show proof
    fix args wd h t
    assume hA hw hwu hh hr
    let S := union2(wd, h)
    have hu := mp(all_elim(hgu, {h}), hh)
    have su := mp(union2_univ[u := 1, a := wd, b := h], hwu, hu)
    have qd: all t2. runs(q(args), S, diverge(t2)) -> runs(q(args), S, exc(S, empty)) proof
      fix t2
      assume h2
      show := mp(all_elim(hq, {args}, {wd}, {h}, {t2}), hA, hw, hwu, hh, h2)
    qed
    have qu: all o. runs(q(args), S, o) -> pair(S, o) in univ(1) proof
      fix o
      assume h2
      show := mp(all_elim(hqu, {args}, {S}, {o}), h2)
    qed
    have rx := apply(ct.fun_div[q := x0. q(x0), n := n, w := w, regs := args, s := S, t := t], hA, su, qu, qd, hr)
    have eu: empty in univ(1) by simp()
    have eno: !(empty = exc_val("stack_overflow", empty)) by defs(all_elim(tr.pair_ne, {"stack_overflow"}, {empty}), exc_val)
    have xg := apply(rec_and_intro[a := abi.World, b := G, x := wd, y := h], hw, hh)
    show by ex_intro({empty}, {S}, taut(eu, eno, xg, rx))
  qed
qed

// (no argument read: q's result returned)
theorem ct.fun_div0(q, w, regs, s, t): regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) -> s in univ(1) ->
  (all o. runs(q, s, o) -> pair(s, o) in univ(1)) -> (all t2. runs(q, s, diverge(t2)) -> runs(q, s, exc(s, empty))) ->
  runs(fn_build(set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)), x0. mkprog(x1 x2. bind_rel(q, x1, x3 x4. letin(x4, x5. bind_rel(gimple.result(w, x5), x3, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. x2 = ok(x6, pair(x8, x9)))), x6 x7. x2 = exc(x6, x7), x6. x2 = diverge(x6))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))))[regs], s, diverge(t)) ->
  runs(fn_build(set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)), x0. mkprog(x1 x2. bind_rel(q, x1, x3 x4. letin(x4, x5. bind_rel(gimple.result(w, x5), x3, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. x2 = ok(x6, pair(x8, x9)))), x6 x7. x2 = exc(x6, x7), x6. x2 = diverge(x6))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))))[regs], s, exc(s, empty))
proof
  assume hr hu hqu hq h
  let K(s3, v, o) := letin(v, x5. bind_rel(gimple.result(w, x5), s3, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. o = ok(x6, pair(x8, x9)))), x6 x7. o = exc(x6, x7), x6. o = diverge(x6)))
  let O := exc(s, empty)
  have ef := app_fn_build[d := set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)), v := x0. mkprog(x1 x2. bind_rel(q, x1, x3 x4. K(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), a := regs]
  have e1 := mp(ef, hr)
  have hb := apply(g.runs_elim, rewrite(e1, h))
  have pu: pair(s, O) in univ(1) by simp(hu)
  have hb2: ex o1. runs(q, s, o1) && ((ex s3 v. o1 = ok(s3, v) && K(s3, v, diverge(t))) || (ex s1 e. o1 = exc(s1, e) && diverge(t) = exc(s1, e)) ||
      (ex t2. o1 = diverge(t2) && diverge(t) = diverge(t2))) by defs(expand(hb, bind_rel), bind_rel)
  obtain o1, hr1 hk1 from hb2
  // q diverging: it raises at s, the wrapper too
  have d1: (ex t2. o1 = diverge(t2) && diverge(t) = diverge(t2)) -> bind_rel(q, s, x3 x4. K(x3, x4, O), x3 x4. O = exc(x3, x4), x3. O = diverge(x3)) proof
    assume e
    obtain t2, eo _ from e
    have rq := mp(all_elim(hq, {t2}), rewrite(eo, hr1))
    show by defs(ex_intro({O}, taut(rq, (ex s1 e. O = exc(s1, e) && O = exc(s1, e) by ex_intro({s}, {empty}, simp())))), bind_rel)
  qed
  // q returning: the result step diverging, undefined, so anything
  have d2: (ex s3 v. o1 = ok(s3, v) && K(s3, v, diverge(t))) -> bind_rel(q, s, x3 x4. K(x3, x4, O), x3 x4. O = exc(x3, x4), x3. O = diverge(x3)) proof
    assume e
    obtain s3 v, eo hk from e
    have o1u: o1 in univ(1) by simp(mp(all_elim(hqu, {o1}), hr1))
    have oku := expand(rewrite(eo, o1u), ok, tag)
    have s3u: s3 in univ(1) by simp(oku)
    obtain o2, hr2 hk2 from expand(expand(hk, letin), bind_rel)
    have nok: !(ex x6 x7. o2 = ok(x6, x7) && any_rel(x9. x9 in bits(64), x9. diverge(t) = ok(x6, pair(x7, x9)))) proof
      assume e2
      obtain x6 x7, _ ha from e2
      have z: 0 in bits(64) by simp()
      show by defs(simp(ha, z), letin, any_rel, ok, diverge, tag)
    qed
    have nex: !(ex x6 x7. o2 = exc(x6, x7) && diverge(t) = exc(x6, x7)) by defs(simp(), exc, diverge, tag)
    have dv: ex t3. o2 = diverge(t3) && diverge(t) = diverge(t3) by taut(hk2, nok, nex)
    obtain t3, eo2 _ from dv
    have rr := apply(g.runs_elim, rewrite(eo2, expand(hr2, gimple.result)))
    have und: !(ex x2. x2 in bits(64) && x2 in gimple.in_reg(v, fn_update(fn_update(empty, "prec", w), "signed", false))) by defs(simp(rr), any_rel, ok, diverge, tag)
    have p3: pair(s3, O) in univ(1) by simp(s3u, hu)
    have rO: runs(gimple.result(w, v), s3, O) by defs(apply(tr.runs_intro, p3, (any_rel(x2. x2 in bits(64) && x2 in gimple.in_reg(v, fn_update(fn_update(empty, "prec", w), "signed", false)), x2. O = ok(s3, x2)) by defs(taut(und), any_rel))), gimple.result)
    have xO: ex x6 x7. O = exc(x6, x7) && O = exc(x6, x7) by ex_intro({s}, {empty}, simp())
    have kOb: bind_rel(gimple.result(w, v), s3, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. O = ok(x6, pair(x8, x9)))), x6 x7. O = exc(x6, x7), x6. O = diverge(x6))
      by defs(ex_intro({O}, taut(rO, xO)), bind_rel)
    have kO: K(s3, v, O) by defs(expand(kOb, letin), letin)
    show by defs(ex_intro({o1}, taut(hr1, expand((ex s1 v1. o1 = ok(s1, v1) && K(s1, v1, O) by ex_intro({s3}, {v}, taut(eo, kO))), bind_rel))), bind_rel)
  qed
  have d3: !(ex s1 e. o1 = exc(s1, e) && diverge(t) = exc(s1, e)) by defs(simp(), exc, diverge, tag)
  have b: bind_rel(q, s, x3 x4. K(x3, x4, O), x3 x4. O = exc(x3, x4), x3. O = diverge(x3)) by taut(hk1, d1, d2, d3)
  have rm: runs(mkprog(x1 x2. bind_rel(q, x1, x3 x4. K(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), s, O)
    by apply(tr.runs_intro, pu, b)
  show := rewrite(sym(e1), rm)
qed

// (`ct.fun_divg` for no argument read)
theorem ct.fun_divg0(G, q, w): (all h. h in G -> h in univ(1)) -> (all s o. runs(q, s, o) -> pair(s, o) in univ(1)) ->
  (all w h t. w in abi.World -> w in univ(1) -> h in G -> runs(q, union2(w, h), diverge(t)) -> runs(q, union2(w, h), exc(union2(w, h), empty))) ->
  tr.div_raises_g(G, fn_build(set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)), x0. mkprog(x1 x2. bind_rel(q, x1, x3 x4. letin(x4, x5. bind_rel(gimple.result(w, x5), x3, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. x2 = ok(x6, pair(x8, x9)))), x6 x7. x2 = exc(x6, x7), x6. x2 = diverge(x6))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))))
proof
  assume hgu hqu hq
  show proof
    fix args wd h t
    assume hA hw hwu hh hr
    let S := union2(wd, h)
    have hu := mp(all_elim(hgu, {h}), hh)
    have su := mp(union2_univ[u := 1, a := wd, b := h], hwu, hu)
    have qd: all t2. runs(q, S, diverge(t2)) -> runs(q, S, exc(S, empty)) proof
      fix t2
      assume h2
      show := mp(all_elim(hq, {wd}, {h}, {t2}), hw, hwu, hh, h2)
    qed
    have qu: all o. runs(q, S, o) -> pair(S, o) in univ(1) proof
      fix o
      assume h2
      show := mp(all_elim(hqu, {S}, {o}), h2)
    qed
    have rx := apply(ct.fun_div0[q := q, w := w, regs := args, s := S, t := t], hA, su, qu, qd, hr)
    have eu: empty in univ(1) by simp()
    have eno: !(empty = exc_val("stack_overflow", empty)) by defs(all_elim(tr.pair_ne, {"stack_overflow"}, {empty}), exc_val)
    have xg := apply(rec_and_intro[a := abi.World, b := G, x := wd, y := h], hw, hh)
    show by ex_intro({empty}, {S}, taut(eu, eno, xg, rx))
  qed
qed

// (no result: the wrapper diverges only where q does -- its continuation
// never does)
theorem ct.fun_div_v(x0. q, n, regs, s, t): regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) -> s in univ(1) ->
  (all t2. runs(q(regs), s, diverge(t2)) -> runs(q(regs), s, exc(s, empty))) ->
  runs(fn_build(set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)), x0. mkprog(x1 x2. !ord_le(n, seq_len(x0)) || bind_rel(q(x0), x1, x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. x2 = ok(x3, pair(x5, x6)))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))))[regs], s, diverge(t)) ->
  runs(fn_build(set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)), x0. mkprog(x1 x2. !ord_le(n, seq_len(x0)) || bind_rel(q(x0), x1, x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. x2 = ok(x3, pair(x5, x6)))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))))[regs], s, exc(s, empty))
proof
  assume hr hu hq h
  let K(s3, o) := any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o = ok(s3, pair(x5, x6))))
  let R(o) := !ord_le(n, seq_len(regs)) || bind_rel(q(regs), s, x3 x4. K(x3, o), x3 x4. o = exc(x3, x4), x3. o = diverge(x3))
  let O := exc(s, empty)
  have ef := app_fn_build[d := set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)), v := x0. mkprog(x1 x2. !ord_le(n, seq_len(x0)) || bind_rel(q(x0), x1, x3 x4. K(x3, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), a := regs]
  have e1 := mp(ef, hr)
  have r := apply(g.runs_elim, rewrite(e1, h))
  have pu: pair(s, O) in univ(1) by simp(hu)
  have g1: !ord_le(n, seq_len(regs)) -> R(O) proof
    assume hn
    show by taut(hn)
  qed
  have g2: bind_rel(q(regs), s, x3 x4. K(x3, diverge(t)), x3 x4. diverge(t) = exc(x3, x4), x3. diverge(t) = diverge(x3)) -> R(O) proof
    assume hb
    obtain o1, hr1 hk1 from expand(hb, bind_rel)
    // q diverging: it raises at s, the wrapper too
    have d1: (ex t2. o1 = diverge(t2) && diverge(t) = diverge(t2)) -> R(O) proof
      assume e
      obtain t2, eo _ from e
      have rq := mp(all_elim(hq, {t2}), rewrite(eo, hr1))
      have b: bind_rel(q(regs), s, x3 x4. K(x3, O), x3 x4. O = exc(x3, x4), x3. O = diverge(x3))
        by defs(ex_intro({O}, taut(rq, (ex s1 e. O = exc(s1, e) && O = exc(s1, e) by ex_intro({s}, {empty}, simp())))), bind_rel)
      show by taut(b)
    qed
    have d2: !(ex s3 v. o1 = ok(s3, v) && K(s3, diverge(t))) proof
      assume e
      obtain s3 v, _ hk from e
      have n := g.void_k_ndiv[s3 := s3, t := t]
      show by taut(n, hk)
    qed
    have d3: !(ex s1 e. o1 = exc(s1, e) && diverge(t) = exc(s1, e)) by defs(simp(), exc, diverge, tag)
    show by taut(hk1, d1, d2, d3)
  qed
  have rO: R(O) by taut(r, g1, g2)
  have rm: runs(mkprog(x1 x2. !ord_le(n, seq_len(regs)) || bind_rel(q(regs), x1, x3 x4. K(x3, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), s, O)
    by apply(tr.runs_intro, pu, rO)
  show := rewrite(sym(e1), rm)
qed

// (no argument read, no result)
theorem ct.fun_div_v0(q, regs, s, t): regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) -> s in univ(1) ->
  (all t2. runs(q, s, diverge(t2)) -> runs(q, s, exc(s, empty))) ->
  runs(fn_build(set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)), x0. mkprog(x1 x2. bind_rel(q, x1, x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. x2 = ok(x3, pair(x5, x6)))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))))[regs], s, diverge(t)) ->
  runs(fn_build(set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)), x0. mkprog(x1 x2. bind_rel(q, x1, x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. x2 = ok(x3, pair(x5, x6)))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))))[regs], s, exc(s, empty))
proof
  assume hr hu hq h
  let K(s3, o) := any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o = ok(s3, pair(x5, x6))))
  let O := exc(s, empty)
  have ef := app_fn_build[d := set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)), v := x0. mkprog(x1 x2. bind_rel(q, x1, x3 x4. K(x3, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), a := regs]
  have e1 := mp(ef, hr)
  have hb := apply(g.runs_elim, rewrite(e1, h))
  have pu: pair(s, O) in univ(1) by simp(hu)
  obtain o1, hr1 hk1 from expand(hb, bind_rel)
  have d1: (ex t2. o1 = diverge(t2) && diverge(t) = diverge(t2)) -> bind_rel(q, s, x3 x4. K(x3, O), x3 x4. O = exc(x3, x4), x3. O = diverge(x3)) proof
    assume e
    obtain t2, eo _ from e
    have rq := mp(all_elim(hq, {t2}), rewrite(eo, hr1))
    show by defs(ex_intro({O}, taut(rq, (ex s1 e. O = exc(s1, e) && O = exc(s1, e) by ex_intro({s}, {empty}, simp())))), bind_rel)
  qed
  have d2: !(ex s3 v. o1 = ok(s3, v) && K(s3, diverge(t))) proof
    assume e
    obtain s3 v, _ hk from e
    have n := g.void_k_ndiv[s3 := s3, t := t]
    show by taut(n, hk)
  qed
  have d3: !(ex s1 e. o1 = exc(s1, e) && diverge(t) = exc(s1, e)) by defs(simp(), exc, diverge, tag)
  have b: bind_rel(q, s, x3 x4. K(x3, O), x3 x4. O = exc(x3, x4), x3. O = diverge(x3)) by taut(hk1, d1, d2, d3)
  have rm: runs(mkprog(x1 x2. bind_rel(q, x1, x3 x4. K(x3, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), s, O)
    by apply(tr.runs_intro, pu, b)
  show := rewrite(sym(e1), rm)
qed

// a purpose spec's function value without a result: it raises where it
// diverges, if q does (`ct.fun_divg` for no result)
theorem ct.fun_divg_v(G, x0. q, n): (all h. h in G -> h in univ(1)) ->
  (all regs w h t. regs in abi.ARGS -> w in abi.World -> w in univ(1) -> h in G -> runs(q(regs), union2(w, h), diverge(t)) -> runs(q(regs), union2(w, h), exc(union2(w, h), empty))) ->
  tr.div_raises_g(G, fn_build(set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)), x0. mkprog(x1 x2. !ord_le(n, seq_len(x0)) || bind_rel(q(x0), x1, x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. x2 = ok(x3, pair(x5, x6)))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))))
proof
  assume hgu hq
  show proof
    fix args wd h t
    assume hA hw hwu hh hr
    let S := union2(wd, h)
    have hu := mp(all_elim(hgu, {h}), hh)
    have su := mp(union2_univ[u := 1, a := wd, b := h], hwu, hu)
    have qd: all t2. runs(q(args), S, diverge(t2)) -> runs(q(args), S, exc(S, empty)) proof
      fix t2
      assume h2
      show := mp(all_elim(hq, {args}, {wd}, {h}, {t2}), hA, hw, hwu, hh, h2)
    qed
    have rx := apply(ct.fun_div_v[q := x0. q(x0), n := n, regs := args, s := S, t := t], hA, su, qd, hr)
    have eu: empty in univ(1) by simp()
    have eno: !(empty = exc_val("stack_overflow", empty)) by defs(all_elim(tr.pair_ne, {"stack_overflow"}, {empty}), exc_val)
    have xg := apply(rec_and_intro[a := abi.World, b := G, x := wd, y := h], hw, hh)
    show by ex_intro({empty}, {S}, taut(eu, eno, xg, rx))
  qed
qed

theorem ct.fun_divg_v0(G, q): (all h. h in G -> h in univ(1)) ->
  (all w h t. w in abi.World -> w in univ(1) -> h in G -> runs(q, union2(w, h), diverge(t)) -> runs(q, union2(w, h), exc(union2(w, h), empty))) ->
  tr.div_raises_g(G, fn_build(set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)), x0. mkprog(x1 x2. bind_rel(q, x1, x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. x2 = ok(x3, pair(x5, x6)))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))))
proof
  assume hgu hq
  show proof
    fix args wd h t
    assume hA hw hwu hh hr
    let S := union2(wd, h)
    have hu := mp(all_elim(hgu, {h}), hh)
    have su := mp(union2_univ[u := 1, a := wd, b := h], hwu, hu)
    have qd: all t2. runs(q, S, diverge(t2)) -> runs(q, S, exc(S, empty)) proof
      fix t2
      assume h2
      show := mp(all_elim(hq, {wd}, {h}, {t2}), hw, hwu, hh, h2)
    qed
    have rx := apply(ct.fun_div_v0[q := q, regs := args, s := S, t := t], hA, su, qd, hr)
    have eu: empty in univ(1) by simp()
    have eno: !(empty = exc_val("stack_overflow", empty)) by defs(all_elim(tr.pair_ne, {"stack_overflow"}, {empty}), exc_val)
    have xg := apply(rec_and_intro[a := abi.World, b := G, x := wd, y := h], hw, hh)
    show by ex_intro({empty}, {S}, taut(eu, eno, xg, rx))
  qed
qed

// (a World spec: one with the empty ghost part -- what diverges raises)
theorem ct.div_of_g(spec): tr.div_raises_g(single(empty), spec) -> tr.div_raises(spec)
proof
  assume hd
  fix args w t
  assume ha hw hwu hr
  have ue := union2_empty[a := w]
  have he := single_intro[a := empty]
  have e0 := mp(all_elim(expand(hd, tr.div_raises_g), {args}, {w}, {empty}, {t}), ha, hw, hwu, he, rewrite(sym(ue), hr))
  obtain e x, heu hne hx hrx from e0
  have rs: abi.raise_state(x) by defs(hx, abi.raise_state)
  show by ex_intro({e}, {x}, taut(heu, hne, rs, rewrite(ue, hrx)))
qed

// (the empty ghost part: in the universe)
theorem ct.single_univ: all h. h in single(empty) -> h in univ(1)
proof
  fix h
  assume hh
  have e := mp(single_elim[a := empty, z := h], hh)
  show by simp(e)
qed

// (a World state and the empty ghost part: the state the World's)
theorem ct.w_single(w, h): w in abi.World -> w in univ(1) -> h in single(empty) ->
  univ: union2(w, h) in univ(1) && vm: union2(w, h).vm in x86_64_linux.Vm
proof
  assume hw hwu hh
  have e := mp(single_elim[a := empty, z := h], hh)
  have ue: union2(w, h) = w := trans(subst({y. union2(w, h) = union2(w, y)}, e, refl({union2(w, h)})), union2_empty[a := w])
  have wv: w.vm in x86_64_linux.Vm by simp(expand(hw, abi.World))
  show by taut(rewrite(sym(ue), hwu), rewrite(sym(ue), wv))
qed

// (a memory havocked, then the step done: never diverging -- with no memory
// to choose, any outcome)
theorem ct.dv_havoc(y. P, y. q): all x0 x1. any_rel(y. P(y), y. x0 = ok(q(y), empty)) -> fst(x0) = 2 ->
  any_rel(y. P(y), y. x1 = ok(q(y), empty))
proof
  fix x0 x1
  assume h0 hf
  have h := expand(h0, any_rel)
  have c2: (ex y. P(y) && x0 = ok(q(y), empty)) -> false proof
    assume e
    obtain y, _ he from e
    have z: fst(x0) = 0 by simp(he)
    show by simp(z, hf)
  qed
  show by defs(taut(h, c2), any_rel)
qed

// (the body premise of `ct.contract_div`, for each shape of World spec: a
// step done, a value returned -- after a choice or two)
theorem ct.dv_ok_a(a): all x0 x1. x0 = ok(a, empty) -> fst(x0) = 2 -> x1 = ok(a, empty)
proof
  fix x0 x1
  assume he hf
  have z: fst(x0) = 0 by simp(he)
  show by simp(z, hf)
qed

theorem ct.dv_exc_a(a, b): all x0 x1. x0 = exc(a, b) -> fst(x0) = 2 -> x1 = exc(a, b)
proof
  fix x0 x1
  assume he hf
  have n := apply(ct.exc_not2[x := x0, a := a, b := b], he)
  show by taut(n, hf)
qed

theorem ct.dv_ret_a(x. d, s): all x0 x1. any_rel(y. d(y), y. x0 = exc(pair(s, empty), pair("ret", y))) -> fst(x0) = 2 ->
  any_rel(y. d(y), y. x1 = exc(pair(s, empty), pair("ret", y)))
proof
  fix x0 x1
  assume ha hf
  show := apply(ct.dv_ret[d := y. d(y), s := s, x := x0, x2 := x1], ha, hf)
qed

theorem ct.dv_ret2_a(x. d, y z. e, y z. f, y z. g): all x0 x1.
  any_rel(y. d(y), y. any_rel(z. e(y, z), z. x0 = exc(pair(f(y, z), empty), pair("ret", g(y, z))))) -> fst(x0) = 2 ->
  any_rel(y. d(y), y. any_rel(z. e(y, z), z. x1 = exc(pair(f(y, z), empty), pair("ret", g(y, z)))))
proof
  fix x0 x1
  assume ha hf
  show := apply(ct.dv_ret2[d := y. d(y), e := y z. e(y, z), f := y z. f(y, z), g := y z. g(y, z), x := x0, x2 := x1], ha, hf)
qed

// (... a contract with no precondition: so too)
theorem ct.contract_div0(x0 x2. B, s, t): s in univ(1) -> s.vm in x86_64_linux.Vm ->
  runs(mkprog(x0 x1. ex x2. (bind_rel(abi.overflow, x0, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)), x3. x2 = diverge(x3)) || B(x0, x2)) &&
    ((fst(x2) = 0 && x1 = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && x1 = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
      ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && x1 = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && x1 = diverge(snd(x2)))))),
    s, diverge(t)) -> (all x x2. B(s, x) -> fst(x) = 2 -> B(s, x2)) ->
  runs(mkprog(x0 x1. ex x2. (bind_rel(abi.overflow, x0, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)), x3. x2 = diverge(x3)) || B(x0, x2)) &&
    ((fst(x2) = 0 && x1 = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && x1 = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
      ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && x1 = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && x1 = diverge(snd(x2)))))),
    s, exc(s, empty))
proof
  assume hu hv hr hb
  let OV(x2) := bind_rel(abi.overflow, s, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)), x3. x2 = diverge(x3))
  let D(x2, o) := (fst(x2) = 0 && o = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && o = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
      ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && o = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && o = diverge(snd(x2))))
  let X2 := exc(pair(s, empty), pair("raise", empty))
  have r := apply(g.runs_elim, hr)
  have pu: pair(s, exc(s, empty)) in univ(1) by simp(hu)
  obtain x2, hob hd from r
  have f2: fst(x2) = 2 by defs(simp(hd), ok, exc, diverge, tag)
  have nov: !OV(x2) proof
    assume h
    obtain o1, hr1 hk1 from expand(h, bind_rel)
    obtain v ob, _ _ ho1 from mp(all_elim(ct.overflow_inv, {s}, {o1}), hv, hr1)
    have k := rewrite(ho1, hk1)
    have n2 := ct.exc_not2[x := x2, a := pair(fn_update(fn_update(s, "vm", v), "objs", ob), empty), b := pair("raise", exc_val("stack_overflow", empty))]
    show by defs(simp(k, f2, n2), ok, exc, diverge, tag)
  qed
  have bx := mp(all_elim(hb, {x2}, {X2}), taut(hob, nov), f2)
  have dx: D(X2, exc(s, empty)) by defs(simp(), exc, tag, out_state, out_value)
  have rr: ex x2. (OV(x2) || B(s, x2)) && D(x2, exc(s, empty)) by ex_intro({X2}, taut(bx, dx))
  show by apply(tr.runs_intro, pu, rr)
qed

theorem ct.dv_ret3_a(x. d, y z. e, y z u. f, y z u. g, y z u. v): all x0 x1.
  any_rel(y. d(y), y. any_rel(z. e(y, z), z. any_rel(u. f(y, z, u), u. x0 = exc(pair(g(y, z, u), empty), pair("ret", v(y, z, u)))))) -> fst(x0) = 2 ->
  any_rel(y. d(y), y. any_rel(z. e(y, z), z. any_rel(u. f(y, z, u), u. x1 = exc(pair(g(y, z, u), empty), pair("ret", v(y, z, u))))))
proof
  fix x0 x1
  assume ha hf
  show := apply(ct.dv_ret3[d := y. d(y), e := y z. e(y, z), f := y z u. f(y, z, u), g := y z u. g(y, z, u), v := y z u. v(y, z, u), x := x0, x2 := x1], ha, hf)
qed
