// The frame in the translation: frames of any size (tr.FMAX), homes
// anywhere in them. A home's first store touches its bytes: the stack may
// grow there, or the store fault -- a fault the frame's coupling
// (tr.frame) makes a stack overflow at the call that entered the function
// (its I/O the entry's), or rules out (the frame accessible, after a
// call). The homes after a store: the stored one, and those it leaves
// alone (tr.hkeep, a determined chain over the map's entries).
//
//   checked after proofs/translate.core

// ----------------------------------------------------------------------
//  Addresses

// (a home's i-th byte: the entry's rsp less -c, plus i -- no wrap)
theorem tr.ha_byte: all r c n i. r in bits(64) -> int_le(1048576, r) -> tr.hrange(c, n) -> i in omega -> int_lt(i, n) ->
  bits_add(64, bits_add(64, int_add(r, c), 0), bits_of_int(64, i)) = int_add(int_sub(r, int_sub(18446744073709551616, c)), i) &&
  int_add(int_sub(r, int_sub(18446744073709551616, c)), i) in omega && int_lt(int_add(int_sub(r, int_sub(18446744073709551616, c)), i), r) &&
  int_le(int_sub(r, tr.FMAX), int_add(int_sub(r, int_sub(18446744073709551616, c)), i))
proof
  fix r c n i
  assume hr hg hc hi hn
  have c64 c1 no nc := expand(hc, tr.hrange)
  have p64: pow2(64) = 18446744073709551616 by simp()
  have ib: int_mod(i, 18446744073709551616) = i by arith(hi, hn, nc, c64)
  have e0: int_mod(int_add(int_mod(int_add(int_add(r, c), 0), 18446744073709551616), int_mod(i, 18446744073709551616)), 18446744073709551616) =
    int_add(int_sub(r, int_sub(18446744073709551616, c)), i) by arith(hr, hg, c64, c1, hi, hn, nc, ib)
  have e1 := subst({y. int_mod(int_add(int_mod(int_add(int_add(r, c), 0), y), int_mod(i, y)), y) = int_add(int_sub(r, int_sub(18446744073709551616, c)), i)}, sym(p64), e0)
  have e: bits_add(64, bits_add(64, int_add(r, c), 0), bits_of_int(64, i)) = int_add(int_sub(r, int_sub(18446744073709551616, c)), i)
    by defs(e1, bits_add, bits_of_int)
  have g: int_add(int_sub(r, int_sub(18446744073709551616, c)), i) in omega && int_lt(int_add(int_sub(r, int_sub(18446744073709551616, c)), i), r) &&
    int_le(int_sub(r, tr.FMAX), int_add(int_sub(r, int_sub(18446744073709551616, c)), i)) by arith(hr, hg, c64, c1, hi, hn, nc)
  show by taut(e, g)
qed

// ----------------------------------------------------------------------
//  Accessible bytes: kept where the pages are

theorem tr.hacc_pages: all s v0 v1 c n. app(v1, "pages") = app(v0, "pages") -> tr.hacc(s, v0, c, n) -> tr.hacc(s, v1, c, n)
proof
  fix s v0 v1 c n
  assume e h
  have g: all i. i in omega -> int_lt(i, n) ->
      x86_64_linux.can_access(v1, bits_add(64, tr.ha(s, c), bits_of_int(64, i)), 1) && abi.stack_page(v1, int_div(bits_add(64, tr.ha(s, c), bits_of_int(64, i)), 4096)) proof
    fix i
    assume i1 i2
    have k := mp(all_elim(expand(h, tr.hacc), {i}), i1, i2)
    have a := apply(tr.acc_pages, {v0}, {v1}, {bits_add(64, tr.ha(s, c), bits_of_int(64, i))}, {1}, e, taut(k))
    have sq := mp(all_elim(tr.sp_pages, {v0}, {v1}, {int_div(bits_add(64, tr.ha(s, c), bits_of_int(64, i)), 4096)}), e)
    show by simp(a, sq, k)
  qed
  show by defs(g, tr.hacc)
qed

theorem tr.hacc_grow: all s v0 v1 c n. abi.vm_grows(v0, v1) -> tr.hacc(s, v0, c, n) -> tr.hacc(s, v1, c, n)
proof
  fix s v0 v1 c n
  assume hg h
  have pg := expand(hg, abi.vm_grows).1
  have g: all i. i in omega -> int_lt(i, n) ->
      x86_64_linux.can_access(v1, bits_add(64, tr.ha(s, c), bits_of_int(64, i)), 1) && abi.stack_page(v1, int_div(bits_add(64, tr.ha(s, c), bits_of_int(64, i)), 4096)) proof
    fix i
    assume i1 i2
    let X := bits_add(64, tr.ha(s, c), bits_of_int(64, i))
    have k1 k2 := mp(all_elim(expand(h, tr.hacc), {i}), i1, i2)
    have xb: X in bits(64) by simp()
    have a := apply(x86.access_fwd, {v0}, {v1}, {X}, {1}, xb, hg, k1)
    have mp0: x86_64_linux.mapped(v0, int_div(X, 4096)) by simp(expand(k2, abi.stack_page), keep(x86_64_linux.mapped))
    have po: int_div(X, 4096) in omega by simp()
    have pe := mp(all_elim(pg, {int_div(X, 4096)}), po, mp0)
    have sp: abi.stack_page(v1, int_div(X, 4096)) by defs(simp(pe, expand(k2, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
    show by taut(a, sp)
  qed
  show by defs(g, tr.hacc)
qed

// ----------------------------------------------------------------------
//  The homes a store leaves: entries of the old map, apart from it

def tr.hdisj(k, nk, c, n) := int_le(int_add(k, nk), c) || int_le(int_add(c, n), k)

def tr.hkeep(hs, hs2, c, n) := all k. k in dom(hs2) -> k in dom(hs) && app(hs2, k) = app(hs, k) && tr.hdisj(k, fst(app(hs, k)), c, n)

// (a key of an updated map: the updated one, or the map's)
theorem tr.dom_cases: all f k v j. j in dom(fn_update(f, k, v)) -> j = k || j in dom(f)
proof
  fix f k v j
  assume h
  have si := set_image_def[s := fn_update(f, k, v), f := x. fst(x), y := j]
  have e: ex z. z in fn_update(f, k, v) && fst(z) = j by taut(si, expand(h, dom))
  obtain z, hz from e
  have i := fn_update_iff[f := f, k := k, v := v, z := z]
  have c1: z in f && fst(z) != k -> j in dom(f) proof
    assume h1
    have si2 := set_image_def[s := f, f := x. fst(x), y := j]
    have e2: ex y. y in f && fst(y) = j by ex_intro({z}, taut(h1, hz))
    show by defs(taut(si2, e2), dom)
  qed
  have c2: z = pair(k, v) -> j = k proof
    assume e3
    have f3: fst(z) = k by simp(e3)
    show := trans(sym(hz.2), f3)
  qed
  show by taut(i, hz, c1, c2)
qed

theorem tr.hkeep_empty: all hs c n. tr.hkeep(hs, empty, c, n)
proof
  fix hs c n
  have g: all k. k in dom(empty) -> k in dom(hs) && app(empty, k) = app(hs, k) && tr.hdisj(k, fst(app(hs, k)), c, n) by simp(dom_empty)
  show by defs(g, tr.hkeep)
qed

theorem tr.hkeep_upd: all hs f c n k nk xk. tr.hkeep(hs, f, c, n) -> k in dom(hs) -> app(hs, k) = pair(nk, xk) -> tr.hdisj(k, nk, c, n) ->
  tr.hkeep(hs, fn_update(f, k, pair(nk, xk)), c, n)
proof
  fix hs f c n k nk xk
  assume h hk he hd
  have g: all j. j in dom(fn_update(f, k, pair(nk, xk))) -> j in dom(hs) && app(fn_update(f, k, pair(nk, xk)), j) = app(hs, j) && tr.hdisj(j, fst(app(hs, j)), c, n) proof
    fix j
    assume hj
    have cs := apply(tr.dom_cases, {f}, {k}, {pair(nk, xk)}, {j}, hj)
    have same: j = k -> j in dom(hs) && app(fn_update(f, k, pair(nk, xk)), j) = app(hs, j) && tr.hdisj(j, fst(app(hs, j)), c, n) proof
      assume e
      have g0: k in dom(hs) && app(fn_update(f, k, pair(nk, xk)), k) = app(hs, k) && tr.hdisj(k, fst(app(hs, k)), c, n) by simp(hk, he, hd)
      show := subst({y. y in dom(hs) && app(fn_update(f, k, pair(nk, xk)), y) = app(hs, y) && tr.hdisj(y, fst(app(hs, y)), c, n)}, sym(e), g0)
    qed
    have other: !(j = k) -> j in dom(hs) && app(fn_update(f, k, pair(nk, xk)), j) = app(hs, j) && tr.hdisj(j, fst(app(hs, j)), c, n) proof
      assume ne
      have jd: j in dom(f) by taut(cs, ne)
      have k0 := mp(all_elim(expand(h, tr.hkeep), {j}), jd)
      have e1 := mp(app_update_other[f := f, k := k, v := pair(nk, xk), x := j], ne)
      show by simp(k0, e1)
    qed
    show by taut(same, other)
  qed
  show by defs(g, tr.hkeep)
qed

// ----------------------------------------------------------------------
//  The entry's stack below its rsp: within tr.FMAX, a mapped page is a
//  stack page (Linux's guard gap: abi.stack_gap_free)

theorem tr.gap_stack: all s base code fr m w p. tr.inv(s, base, code, fr, m, w) -> p in omega ->
  int_le(int_div(int_sub(app(app(s, "gpr"), 4), tr.FMAX), 4096), p) -> int_le(p, int_div(app(app(s, "gpr"), 4), 4096)) ->
  x86_64_linux.mapped(app(s, "vm"), p) -> abi.stack_page(app(s, "vm"), p)
proof
  fix s base code fr m w p
  assume hi hp h1 h2 hm
  have {sM, hsps, sgf} := hi
  have r4 := apply(x86i.rsp_typed, sM)
  have g8 := apply(tr.inv_gap, hi)
  let P0 := int_div(app(app(s, "gpr"), 4), 4096)
  have p0o: P0 in omega by simp(r4)
  have top: p = P0 -> abi.stack_page(app(s, "vm"), p) proof
    assume e
    show := subst({y. abi.stack_page(app(s, "vm"), y)}, sym(e), hsps)
  qed
  have below: int_lt(p, P0) -> abi.stack_page(app(s, "vm"), p) proof
    assume hl
    have gap: int_le(int_mul(int_sub(P0, p), x86_64_linux.PAGE), x86_64_linux.STACK_GUARD_GAP) by defs(arith(r4, g8, h1, h2, hp), x86_64_linux.PAGE, x86_64_linux.STACK_GUARD_GAP)
    have c := mp(all_elim(expand(sgf, abi.stack_gap_free).1, {P0}, {p}), taut(p0o, hp), taut(hsps, hl, gap, hm))
    show := c
  qed
  have cs: p = P0 || int_lt(p, P0) by arith(h2, hp, p0o)
  show by taut(cs, top, below)
qed

// ----------------------------------------------------------------------
//  The homes after a store at the home c (the stack grown before it): the
//  homes it leaves, as they were; the stored one, holding its value

theorem tr.homes_store: all s m m2 hs hs2 c n x vm1. app(app(s, "gpr"), 4) in bits(64) -> int_le(1048576, app(app(s, "gpr"), 4)) ->
  tr.homes(s, m, hs) -> tr.hkeep(hs, hs2, c, n) -> tr.hrange(c, n) -> abi.vm_grows(app(m, "vm"), vm1) ->
  app(m2, "vm") = fn_update(vm1, "bytes", x86_64_linux.store_le(app(vm1, "bytes"), tr.ha(s, c), n, x)) -> tr.homes(s, m2, hs2)
proof
  fix s m m2 hs hs2 c n x vm1
  assume hr hg hh hk hc hgr em
  let R := app(app(s, "gpr"), 4)
  have gb := expand(hgr, abi.vm_grows).2
  have g: all k. k in dom(hs2) ->
      x86_64_linux.le(app(app(m2, "vm"), "bytes"), bits_add(64, int_add(R, k), 0), fst(app(hs2, k))) = snd(app(hs2, k)) &&
      tr.hrange(k, fst(app(hs2, k))) && tr.hacc(s, app(m2, "vm"), k, fst(app(hs2, k))) proof
    fix k
    assume hd
    have kd ke kj := mp(all_elim(expand(hk, tr.hkeep), {k}), hd)
    have hv hkr ha := mp(all_elim(expand(hh, tr.homes), {k}), kd)
    let NK := fst(app(hs, k))
    have nko: NK in omega by taut(expand(hkr, tr.hrange))
    // (each byte of the home: not stored, not grown)
    have bk: all i. i in omega -> int_lt(i, NK) ->
        app(app(app(m2, "vm"), "bytes"), bits_add(64, bits_add(64, int_add(R, k), 0), bits_of_int(64, i))) =
        app(app(app(m, "vm"), "bytes"), bits_add(64, bits_add(64, int_add(R, k), 0), bits_of_int(64, i))) proof
      fix i
      assume i1 i2
      have ek .. := apply(tr.ha_byte, {R}, {k}, {NK}, {i}, hr, hg, hkr, i1, i2)
      have ne: all j. j in omega -> int_lt(j, n) -> !(bits_add(64, tr.ha(s, c), bits_of_int(64, j)) = bits_add(64, bits_add(64, int_add(R, k), 0), bits_of_int(64, i))) proof
        fix j
        assume j1 j2
        have ec .. := apply(tr.ha_byte, {R}, {c}, {n}, {j}, hr, hg, hc, j1, j2)
        have kr := expand(hkr, tr.hrange)
        have cr := expand(hc, tr.hrange)
        have d0 := expand(kj, tr.hdisj)
        have nq: !(int_add(int_sub(R, int_sub(18446744073709551616, c)), j) = int_add(int_sub(R, int_sub(18446744073709551616, k)), i)) by arith(d0, kr, cr, i1, i2, j1, j2)
        show by simp(ec, ek, nq)
      qed
      have so := apply(x86.store_outside, {app(vm1, "bytes")}, {tr.ha(s, c)}, {n}, {x}, {bits_add(64, bits_add(64, int_add(R, k), 0), bits_of_int(64, i))}, simp(), ne)
      have k1 k2 := mp(all_elim(expand(ha, tr.hacc), {i}), i1, i2)
      have mpd: x86_64_linux.mapped(app(m, "vm"), x86_64_linux.page_of(bits_add(64, bits_add(64, int_add(R, k), 0), bits_of_int(64, i))))
        by defs(simp(expand(k2, abi.stack_page), keep(x86_64_linux.mapped)), x86_64_linux.page_of, x86_64_linux.PAGE)
      have gg := mp(all_elim(gb, {bits_add(64, bits_add(64, int_add(R, k), 0), bits_of_int(64, i))}), simp(), mpd)
      show by simp(em, so, gg)
    qed
    have ls := apply(tr.le_same, {app(app(m2, "vm"), "bytes")}, {app(app(m, "vm"), "bytes")}, {bits_add(64, int_add(R, k), 0)}, {NK}, nko, bk)
    have pe: app(app(m2, "vm"), "pages") = app(vm1, "pages") by simp(em)
    have ha2 := apply(tr.hacc_pages, {s}, {vm1}, {app(m2, "vm")}, {k}, {NK}, pe, apply(tr.hacc_grow, {s}, {app(m, "vm")}, {vm1}, {k}, {NK}, hgr, ha))
    show by simp(ke, ls, hv, hkr, ha2)
  qed
  show by defs(g, tr.homes)
qed

theorem tr.homes_put: all s m hs c n x. tr.homes(s, m, hs) -> x86_64_linux.le(app(app(m, "vm"), "bytes"), tr.ha(s, c), n) = x -> tr.hrange(c, n) ->
  tr.hacc(s, app(m, "vm"), c, n) -> tr.homes(s, m, fn_update(hs, c, pair(n, x)))
proof
  fix s m hs c n x
  assume hh hv hc ha
  have g: all k. k in dom(fn_update(hs, c, pair(n, x))) ->
      x86_64_linux.le(app(app(m, "vm"), "bytes"), bits_add(64, int_add(app(app(s, "gpr"), 4), k), 0), fst(app(fn_update(hs, c, pair(n, x)), k))) = snd(app(fn_update(hs, c, pair(n, x)), k)) &&
      tr.hrange(k, fst(app(fn_update(hs, c, pair(n, x)), k))) && tr.hacc(s, app(m, "vm"), k, fst(app(fn_update(hs, c, pair(n, x)), k))) proof
    fix k
    assume hd
    have cs := apply(tr.dom_cases, {hs}, {c}, {pair(n, x)}, {k}, hd)
    have same: k = c -> x86_64_linux.le(app(app(m, "vm"), "bytes"), bits_add(64, int_add(app(app(s, "gpr"), 4), k), 0), fst(app(fn_update(hs, c, pair(n, x)), k))) = snd(app(fn_update(hs, c, pair(n, x)), k)) &&
        tr.hrange(k, fst(app(fn_update(hs, c, pair(n, x)), k))) && tr.hacc(s, app(m, "vm"), k, fst(app(fn_update(hs, c, pair(n, x)), k))) proof
      assume e
      have g0: x86_64_linux.le(app(app(m, "vm"), "bytes"), bits_add(64, int_add(app(app(s, "gpr"), 4), c), 0), fst(app(fn_update(hs, c, pair(n, x)), c))) = snd(app(fn_update(hs, c, pair(n, x)), c)) &&
        tr.hrange(c, fst(app(fn_update(hs, c, pair(n, x)), c))) && tr.hacc(s, app(m, "vm"), c, fst(app(fn_update(hs, c, pair(n, x)), c))) by simp(hv, hc, ha)
      show := subst({y. x86_64_linux.le(app(app(m, "vm"), "bytes"), bits_add(64, int_add(app(app(s, "gpr"), 4), y), 0), fst(app(fn_update(hs, c, pair(n, x)), y))) = snd(app(fn_update(hs, c, pair(n, x)), y)) &&
        tr.hrange(y, fst(app(fn_update(hs, c, pair(n, x)), y))) && tr.hacc(s, app(m, "vm"), y, fst(app(fn_update(hs, c, pair(n, x)), y)))}, sym(e), g0)
    qed
    have other: !(k = c) -> x86_64_linux.le(app(app(m, "vm"), "bytes"), bits_add(64, int_add(app(app(s, "gpr"), 4), k), 0), fst(app(fn_update(hs, c, pair(n, x)), k))) = snd(app(fn_update(hs, c, pair(n, x)), k)) &&
        tr.hrange(k, fst(app(fn_update(hs, c, pair(n, x)), k))) && tr.hacc(s, app(m, "vm"), k, fst(app(fn_update(hs, c, pair(n, x)), k))) proof
      assume ne
      have kd: k in dom(hs) by taut(cs, ne)
      have h0 := mp(all_elim(expand(hh, tr.homes), {k}), kd)
      have e1 := mp(app_update_other[f := hs, k := c, v := pair(n, x), x := k], ne)
      show by simp(h0, e1)
    qed
    show by taut(same, other)
  qed
  show by defs(g, tr.homes)
qed

// ----------------------------------------------------------------------
//  The frame and the memory after the stack grew (pages newly mapped as
//  stack pages, the rest kept) and a frame store

// (pages equal: an extension)
theorem tr.stk_ext_pages: all v0 v1. app(v1, "pages") = app(v0, "pages") -> app(v1, "stack_top") = app(v0, "stack_top") -> app(v1, "stack_limit") = app(v0, "stack_limit") -> x86.stk_ext(v0, v1)
proof
  fix v0 v1
  assume e et el
  have g: all i. i in omega -> app(app(v1, "pages"), i) = app(app(v0, "pages"), i) || abi.stack_page(v1, i) by simp(e)
  have r: abi.stack_reserve(v0) -> abi.stack_reserve(v1) proof
    assume h
    show := apply(tr.rsv_same, e, et, el, h)
  qed
  show by defs(taut(g, r), x86.stk_ext)
qed

theorem tr.frame_store: all s m m2 fd vm1. tr.frame(s, m, fd) -> app(m2, "os") = app(m, "os") -> abi.vm_grows(app(m, "vm"), vm1) -> x86.stk_ext(app(m, "vm"), vm1) ->
  app(app(m2, "vm"), "pages") = app(vm1, "pages") -> app(app(m2, "vm"), "stack_top") = app(vm1, "stack_top") -> app(app(m2, "vm"), "stack_limit") = app(vm1, "stack_limit") -> tr.frame(s, m2, fd)
proof
  fix s m m2 fd vm1
  assume hf eo hg hx ep et el
  have d1: app(m, "os") = app(s, "os") && x86.stk_ext(app(s, "vm"), app(m, "vm")) -> tr.frame(s, m2, fd) proof
    assume h
    have ho hse := h
    have x2 := apply(tr.stk_ext_pages, {vm1}, {app(m2, "vm")}, ep, et, el)
    have t1 := apply(x86.stk_ext_trans, {app(s, "vm")}, {app(m, "vm")}, {vm1}, hse, hx)
    have t2 := apply(x86.stk_ext_trans, {app(s, "vm")}, {vm1}, {app(m2, "vm")}, t1, x2)
    have o2: app(m2, "os") = app(s, "os") := trans(eo, ho)
    show by defs(taut(o2, t2), tr.frame)
  qed
  have d2: tr.hacc(s, app(m, "vm"), int_sub(18446744073709551616, fd), fd) -> tr.frame(s, m2, fd) proof
    assume h
    have a1 := apply(tr.hacc_grow, {s}, {app(m, "vm")}, {vm1}, {int_sub(18446744073709551616, fd)}, {fd}, hg, h)
    have a2 := apply(tr.hacc_pages, {s}, {vm1}, {app(m2, "vm")}, {int_sub(18446744073709551616, fd)}, {fd}, ep, a1)
    show by defs(taut(a2), tr.frame)
  qed
  show by taut(expand(hf, tr.frame), d1, d2)
qed

// the memory's coupling, after the stack grew: the world's domain (its
// pages mapped in the machine), the callers' frames (on the entry's stack
// pages, the world's) as they were; the grown pages unmapped in the world
theorem tr.mem_grow: all s base code fr m m1 w v. tr.inv(s, base, code, fr, m, w) -> tr.mem(s, m, w, v) -> abi.vm_grows(app(m, "vm"), app(m1, "vm")) ->
  x86.stk_ext(app(m, "vm"), app(m1, "vm")) -> x86.vm_fields(app(m, "vm"), app(m1, "vm")) -> tr.mem(s, m1, w, v)
proof
  fix s base code fr m m1 w v
  assume hi hmm hg hx hfl
  have {wob, wm, oacc} := hmm
  have {top, limit, brk0, brk, bytes, frames, pages, nostk, stk, rsv} := wm
  have gp gb := expand(hg, abi.vm_grows)
  have fl := expand(hfl, x86.vm_fields)
  // (a page the world maps: the machine's, mapped)
  have wmap: all p. p in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) -> !(app(app(app(w, "vm"), "pages"), p) = none) ->
      app(app(app(m, "vm"), "pages"), p) = app(app(app(w, "vm"), "pages"), p) && x86_64_linux.mapped(app(m, "vm"), p) proof
    fix p
    assume hp hn
    have c := mp(all_elim(pages, {p}), hp)
    have e: app(app(app(m, "vm"), "pages"), p) = app(app(app(w, "vm"), "pages"), p) by taut(c, hn)
    have mp0: x86_64_linux.mapped(app(m, "vm"), p) by defs(simp(e, hn, hp), x86_64_linux.mapped)
    show by taut(e, mp0)
  qed
  have by2: all x0. x0 in bits(64) -> abi.in_domain(app(w, "vm"), v, x0) -> app(app(app(m1, "vm"), "bytes"), x0) = app(app(app(w, "vm"), "bytes"), x0) proof
    fix x0
    assume hx0 hd
    have e := mp(all_elim(bytes, {x0}), hx0, hd)
    let P := int_div(x0, x86_64_linux.PAGE)
    have mpd: x86_64_linux.mapped(app(m, "vm"), x86_64_linux.page_of(x0)) proof
      have c1: x0 in v -> x86_64_linux.mapped(app(m, "vm"), x86_64_linux.page_of(x0)) proof
        assume ho
        have c0 c1 c3 := mp(all_elim(oacc, {x0}), simp(hx0), ho)
        have bx: bits_of_int(64, x0) = x0 by simp(hx0)
        have ca := rewrite(bx, c3)
        show by simp(expand(ca, x86_64_linux.can_access), keep(x86_64_linux.mapped, x86_64_linux.page_of))
      qed
      have c2: x86_64_linux.mapped(app(w, "vm"), P) && !(app(snd(app(app(app(w, "vm"), "pages"), P)), "kind") = 2) -> x86_64_linux.mapped(app(m, "vm"), x86_64_linux.page_of(x0)) proof
        assume h
        have hm0 hk0 := h
        have po: P in omega by defs(simp(hx0), x86_64_linux.PAGE)
        have hp: P in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) by simp(expand(hm0, x86_64_linux.mapped), po, keep(x86_64_linux.PAGE))
        have hn: !(app(app(app(w, "vm"), "pages"), P) = none) by simp(expand(hm0, x86_64_linux.mapped))
        have ke km := mp(all_elim(wmap, {P}), hp, hn)
        show by defs(km, x86_64_linux.page_of)
      qed
      show by taut(expand(hd, abi.in_domain), c1, c2)
    qed
    have g := mp(all_elim(gb, {x0}), hx0, mpd)
    show := trans(g, e)
  qed
  have fr2: all x0. x0 in bits(64) -> (int_le(abi.sp(s), x0) && !abi.in_domain(app(w, "vm"), v, x0)) && abi.stack_page(app(s, "vm"), x86_64_linux.page_of(x0)) ->
      app(app(app(m1, "vm"), "bytes"), x0) = app(app(app(s, "vm"), "bytes"), x0) proof
    fix x0
    assume hx0 hf
    have e := mp(all_elim(frames, {x0}), hx0, hf)
    let P := x86_64_linux.page_of(x0)
    have po: P in omega by defs(simp(hx0), x86_64_linux.page_of)
    have hf1 hf2 sp := hf
    have hp: P in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) by simp(expand(sp, abi.stack_page, x86_64_linux.mapped), po)
    // (a callers' stack page: the machine's still, mapped)
    have pl: int_le(int_div(int_sub(abi.sp(s), 8), x86_64_linux.PAGE), P) by defs(arith(hf1, hx0), x86_64_linux.page_of, x86_64_linux.PAGE)
    have sk := mp(all_elim(stk, {P}), po, conj(sp, pl))
    have km: x86_64_linux.mapped(app(m, "vm"), P) by defs(taut(rewrite(sym(sk), expand(sp, abi.stack_page, x86_64_linux.mapped))), x86_64_linux.mapped)
    have g := mp(all_elim(gb, {x0}), hx0, km)
    show := trans(g, e)
  qed
  have pg2: all x0. x0 in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) ->
      app(app(app(m1, "vm"), "pages"), x0) = app(app(app(w, "vm"), "pages"), x0) || (app(app(app(w, "vm"), "pages"), x0) = none && abi.stack_page(app(m1, "vm"), x0)) proof
    fix x0
    assume hp
    have c := mp(all_elim(pages, {x0}), hp)
    have po: x0 in omega by simp(hp)
    have xe := mp(all_elim(expand(hx, x86.stk_ext).1, {x0}), po)
    have same: app(app(app(m1, "vm"), "pages"), x0) = app(app(app(m, "vm"), "pages"), x0) ->
        app(app(app(m1, "vm"), "pages"), x0) = app(app(app(w, "vm"), "pages"), x0) || (app(app(app(w, "vm"), "pages"), x0) = none && abi.stack_page(app(m1, "vm"), x0)) proof
      assume e
      have sq: abi.stack_page(app(m1, "vm"), x0) = abi.stack_page(app(m, "vm"), x0) by defs(simp(e), abi.stack_page, x86_64_linux.mapped)
      show by simp(c, e, sq)
    qed
    have grown: !(app(app(app(m1, "vm"), "pages"), x0) = app(app(app(m, "vm"), "pages"), x0)) && abi.stack_page(app(m1, "vm"), x0) ->
        app(app(app(m1, "vm"), "pages"), x0) = app(app(app(w, "vm"), "pages"), x0) || (app(app(app(w, "vm"), "pages"), x0) = none && abi.stack_page(app(m1, "vm"), x0)) proof
      assume h
      // (a page changed: unmapped before, so the world's too)
      have nm0: x86_64_linux.mapped(app(m, "vm"), x0) -> false proof
        assume hm
        have pe := mp(all_elim(gp, {x0}), po, hm)
        show by taut(pe, h)
      qed
      have nm: !x86_64_linux.mapped(app(m, "vm"), x0) by taut(nm0)
      have nn: app(app(app(m, "vm"), "pages"), x0) = none by simp(expand(nm, x86_64_linux.mapped), hp, keep(x86_64_linux.TASK_SIZE))
      have wn: app(app(app(w, "vm"), "pages"), x0) = none by simp(c, nn)
      show by taut(wn, h)
    qed
    show by taut(xe, same, grown)
  qed
  have stk2: all x0. x0 in omega -> abi.stack_page(app(s, "vm"), x0) && int_le(int_div(int_sub(abi.sp(s), 8), x86_64_linux.PAGE), x0) -> app(app(app(m1, "vm"), "pages"), x0) = app(app(app(s, "vm"), "pages"), x0) proof
    fix x0
    assume po h
    have sk := mp(all_elim(stk, {x0}), po, h)
    have km: x86_64_linux.mapped(app(m, "vm"), x0) by defs(taut(rewrite(sym(sk), expand(h.1, abi.stack_page, x86_64_linux.mapped))), x86_64_linux.mapped)
    show trans(mp(all_elim(gp, {x0}), po, km), sk)
  qed
  have rsv2: abi.stack_reserve(app(s, "vm")) -> abi.stack_reserve(app(m1, "vm")) proof
    assume h0
    show := mp(expand(hx, x86.stk_ext).2, mp(rsv, h0))
  qed
  have wm2: abi.world_matches(app(s, "vm"), app(m1, "vm"), app(w, "vm"), v, abi.sp(s)) by defs(simp(fl, top, limit, brk0, brk, by2, fr2, pg2, nostk, stk2, rsv2, keep(abi.in_domain, abi.stack_page, abi.stack_reserve)), abi.world_matches)
  have oa2: all y. y in omega -> y in v -> (int_le(abi.sp(s), y) && abi.stack_page(app(s, "vm"), int_div(y, x86_64_linux.PAGE))) && x86_64_linux.can_access(app(m1, "vm"), bits_of_int(64, y), 1) proof
    fix y
    assume h1 h2
    have c0 c1 c3 := mp(all_elim(oacc, {y}), h1, h2)
    have ca := apply(x86.access_fwd, {app(m, "vm")}, {app(m1, "vm")}, {bits_of_int(64, y)}, {1}, simp(), hg, c3)
    show by taut(c0, c1, ca)
  qed
  show by defs(taut(wob, wm2, oa2), tr.mem)
qed

// the memory's coupling after a store to a home (its bytes on stack pages,
// below the entry's rsp: off the world's domain, below its objects)
theorem tr.mem_fstore: all s base code fr m0 m m2 w v c n x. tr.inv(s, base, code, fr, m0, w) -> tr.mem(s, m, w, v) -> tr.hrange(c, n) -> tr.hacc(s, app(m, "vm"), c, n) ->
  app(m2, "vm") = fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), tr.ha(s, c), n, x)) -> tr.mem(s, m2, w, v)
proof
  fix s base code fr m0 m m2 w v c n x
  assume hi hmm hc ha em
  have {sM, slt} := hi
  have r4 := apply(x86i.rsp_typed, sM)
  have g8 := apply(tr.inv_gap, hi)
  have nr := apply(tr.sp_lt, {app(app(s, "gpr"), 4)}, r4, slt)
  have {wob, wm, oacc} := hmm
  have {pages} := wm
  let B := app(app(m, "vm"), "bytes")
  have k: all a. a in bits(64) -> abi.in_domain(app(w, "vm"), v, a) || int_le(abi.sp(s), a) -> app(x86_64_linux.store_le(B, tr.ha(s, c), n, x), a) = app(B, a) proof
    fix a
    assume hab hda
    have ne: all j. j in omega -> int_lt(j, n) -> !(bits_add(64, tr.ha(s, c), bits_of_int(64, j)) = a) proof
      fix j
      assume j1 j2
      have no: bits_add(64, tr.ha(s, c), bits_of_int(64, j)) = a -> false proof
        assume e
        have ev ao alt .. := apply(tr.ha_byte, {app(app(s, "gpr"), 4)}, {c}, {n}, {j}, r4, g8, hc, j1, j2)
        have ea: a = int_add(int_sub(app(app(s, "gpr"), 4), int_sub(18446744073709551616, c)), j) := trans(sym(e), ev)
        have lo: !int_le(abi.sp(s), a) by arith(ea, alt, nr)
        have sp1 sp2 := mp(all_elim(expand(ha, tr.hacc), {j}), j1, j2)
        have sp3 := rewrite(e, sp2)
        let P := int_div(a, x86_64_linux.PAGE)
        have po: int_div(a, 4096) in omega by simp(hab)
        have hp: P in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) by defs(simp(expand(sp3, abi.stack_page, x86_64_linux.mapped), po, keep(x86_64_linux.TASK_SIZE)), x86_64_linux.PAGE)
        have pc := mp(all_elim(pages, {P}), hp)
        have nd: !(x86_64_linux.mapped(app(w, "vm"), P) && !(app(snd(app(app(app(w, "vm"), "pages"), P)), "kind") = 2))
          by defs(simp(pc, expand(sp3, abi.stack_page, x86_64_linux.mapped), keep(x86_64_linux.TASK_SIZE)), x86_64_linux.mapped, x86_64_linux.PAGE)
        have nob: a in v -> false proof
          assume hv
          have c1 := mp(all_elim(oacc, {a}), simp(hab), hv)
          show by taut(c1, lo)
        qed
        have nd2: !abi.in_domain(app(w, "vm"), v, a) by defs(taut(nd, nob), abi.in_domain)
        show by taut(hda, nd2, lo)
      qed
      show by taut(no)
    qed
    show := apply(x86.store_outside, {B}, {tr.ha(s, c)}, {n}, {x}, {a}, hab, ne)
  qed
  show := apply(tr.mem_bytes, {s}, {m}, {m2}, {w}, {v}, {x86_64_linux.store_le(B, tr.ha(s, c), n, x)}, hmm, em, k)
qed

// ----------------------------------------------------------------------
//  The frame's pages: a mapped one is a stack page (as at the entry, or
//  grown; or the frame accessible)

theorem tr.frame_page: all s base code fr m w fd c n i. tr.inv(s, base, code, fr, m, w) -> tr.frame(s, m, fd) -> tr.hrange(c, n) ->
  fd in omega -> int_le(int_sub(18446744073709551616, fd), c) -> int_le(fd, tr.FMAX) -> i in omega -> int_lt(i, n) ->
  x86_64_linux.mapped(app(m, "vm"), int_div(bits_add(64, tr.ha(s, c), bits_of_int(64, i)), 4096)) ->
  abi.stack_page(app(m, "vm"), int_div(bits_add(64, tr.ha(s, c), bits_of_int(64, i)), 4096))
proof
  fix s base code fr m w fd c n i
  assume hi hf hc hfo hfd hfm i1 i2 hm
  have {sM} := hi
  have r4 := apply(x86i.rsp_typed, sM)
  have g8 := apply(tr.inv_gap, hi)
  let R := app(app(s, "gpr"), 4)
  let X := bits_add(64, tr.ha(s, c), bits_of_int(64, i))
  let P := int_div(X, 4096)
  have ex xo xl xg := apply(tr.ha_byte, {R}, {c}, {n}, {i}, r4, g8, hc, i1, i2)
  have po: P in omega by simp()
  have d1: app(m, "os") = app(s, "os") && x86.stk_ext(app(s, "vm"), app(m, "vm")) -> abi.stack_page(app(m, "vm"), P) proof
    assume h
    have ho hse := h
    have xe := mp(all_elim(expand(hse, x86.stk_ext).1, {P}), po)
    have eq: app(app(app(m, "vm"), "pages"), P) = app(app(app(s, "vm"), "pages"), P) -> abi.stack_page(app(m, "vm"), P) proof
      assume e
      have ms: x86_64_linux.mapped(app(s, "vm"), P) by defs(simp(sym(e), expand(hm, x86_64_linux.mapped)), x86_64_linux.mapped)
      have l1: int_le(int_div(int_sub(R, tr.FMAX), 4096), P) by simp(ex, xg, xo, r4, g8)
      have l2: int_le(P, int_div(R, 4096)) by simp(ex, xl, xo, r4)
      have ss := apply(tr.gap_stack, {s}, {base}, {code}, {fr}, {m}, {w}, {P}, hi, po, l1, l2, ms)
      show by defs(simp(e, expand(ss, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
    qed
    show by taut(xe, eq)
  qed
  have d2: tr.hacc(s, app(m, "vm"), int_sub(18446744073709551616, fd), fd) -> abi.stack_page(app(m, "vm"), P) proof
    assume h
    let J := int_add(int_sub(c, int_sub(18446744073709551616, fd)), i)
    have cr := expand(hc, tr.hrange)
    have jo: J in omega by arith(cr, hfd, i1)
    have jl: int_lt(J, fd) by arith(cr, hfd, i1, i2)
    have fr0: tr.hrange(int_sub(18446744073709551616, fd), fd) by defs(arith(cr, hfo, hfd, hfm, i1, i2), tr.hrange)
    have ef .. := apply(tr.ha_byte, {R}, {int_sub(18446744073709551616, fd)}, {fd}, {J}, r4, g8, fr0, jo, jl)
    have same: bits_add(64, tr.ha(s, int_sub(18446744073709551616, fd)), bits_of_int(64, J)) = X by simp(ef, ex, cr, hfd)
    have k1 k2 := mp(all_elim(expand(h, tr.hacc), {J}), jo, jl)
    show := rewrite(same, k2)
  qed
  show by taut(expand(hf, tr.frame), d1, d2)
qed

// the bytes a store to the home c touched: writable, on stack pages
theorem tr.fstore_acc: all s base code fr m w fd c n a2 m1 e1. tr.inv(s, base, code, fr, m, w) -> tr.frame(s, m, fd) -> tr.hrange(c, n) ->
  fd in omega -> int_le(int_sub(18446744073709551616, fd), c) -> int_le(fd, tr.FMAX) ->
  runs(x86_64_linux.touch_range(tr.ha(s, c), n, 1), fn_update(m, "rip", a2), ok(m1, e1)) -> tr.hacc(s, app(m1, "vm"), c, n)
proof
  fix s base code fr m w fd c n a2 m1 e1
  assume hi hf hc hfo hfd hfm ht
  have ac := apply(x86.touch_range_acc, {fn_update(m, "rip", a2)}, {tr.ha(s, c)}, {n}, {m1}, {e1}, ht)
  have st := apply(x86.touch_range_stk, {fn_update(m, "rip", a2)}, {tr.ha(s, c)}, {n}, {1}, {m1}, {e1}, ht)
  have g: all i. i in omega -> int_lt(i, n) ->
      x86_64_linux.can_access(app(m1, "vm"), bits_add(64, tr.ha(s, c), bits_of_int(64, i)), 1) && abi.stack_page(app(m1, "vm"), int_div(bits_add(64, tr.ha(s, c), bits_of_int(64, i)), 4096)) proof
    fix i
    assume i1 i2
    let P := int_div(bits_add(64, tr.ha(s, c), bits_of_int(64, i)), 4096)
    have a := mp(all_elim(ac, {i}), i1, i2)
    have po: P in omega by simp()
    have xe := mp(all_elim(expand(st, x86.stk_ext).1, {P}), po)
    have eq: app(app(app(m1, "vm"), "pages"), P) = app(app(app(fn_update(m, "rip", a2), "vm"), "pages"), P) -> abi.stack_page(app(m1, "vm"), P) proof
      assume e
      have e2: app(app(app(m1, "vm"), "pages"), P) = app(app(app(m, "vm"), "pages"), P) by simp(e)
      have mm: x86_64_linux.mapped(app(m, "vm"), P) by defs(simp(sym(e2), expand(a, x86_64_linux.can_access, x86_64_linux.mapped, x86_64_linux.page_of, x86_64_linux.PAGE)), x86_64_linux.mapped)
      have sp := apply(tr.frame_page, {s}, {base}, {code}, {fr}, {m}, {w}, {fd}, {c}, {n}, {i}, hi, hf, hc, hfo, hfd, hfm, i1, i2, mm)
      show by defs(simp(e2, expand(sp, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
    qed
    have sp: abi.stack_page(app(m1, "vm"), P) by taut(xe, eq)
    show by taut(a, sp)
  qed
  show by defs(g, tr.hacc)
qed

// ----------------------------------------------------------------------
//  The invariant after a store to the home c (its bytes touched: the stack
//  grown there, if at all)

theorem tr.inv_fstore: all s base code fr m w c n x a2 m1 e1 C. tr.inv(s, base, code, fr, m, w) -> base in omega -> a2 in bits(64) -> tr.hrange(c, n) ->
  runs(x86_64_linux.touch_range(tr.ha(s, c), n, 1), fn_update(m, "rip", a2), ok(m1, e1)) ->
  C = fn_update(m1, "vm", fn_update(app(m1, "vm"), "bytes", x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), tr.ha(s, c), n, x))) ->
  tr.inv(s, base, code, fr, C, w) && app(C, "os") = app(m, "os") && app(C, "rip") = a2 && app(C, "gpr") = app(m, "gpr") &&
  abi.vm_grows(app(m, "vm"), app(m1, "vm")) && x86.stk_ext(app(m, "vm"), app(m1, "vm")) && x86.vm_fields(app(m, "vm"), app(m1, "vm")) &&
  app(C, "vm") = fn_update(app(m1, "vm"), "bytes", x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), tr.ha(s, c), n, x)) &&
  app(app(m1, "vm"), "bytes") in fn_space(bits(64), bits(8))
proof
  fix s base code fr m w c n x a2 m1 e1 C
  assume hi hb ha2 hc ht hC
  have i := expand(hi, tr.inv)
  have {mM, mu, cd, kc, kp, ra8, sM, slt, sal, hsps} := hi
  let M0 := fn_update(m, "rip", a2)
  let R := app(app(s, "gpr"), 4)
  let A := tr.ha(s, c)
  have r4 := apply(x86i.rsp_typed, sM)
  have g8 := apply(tr.inv_gap, hi)
  have cr := expand(hc, tr.hrange)
  have no: n in omega by taut(cr)
  have m0M: M0 in x86_64_linux.Machine by defs(simp(expand(mM, x86_64_linux.Machine), mu, ha2), x86_64_linux.Machine)
  have m0u: M0 in univ(1) by simp(mu, ha2)
  have m1M m1u := apply(x86.touch_range_typed, {M0}, {A}, {n}, {1}, {m1}, {e1}, m0M, m0u, ht)
  have tv := apply(x86.touch_range_vm, {M0}, {A}, {n}, {1}, {m1}, {e1}, ht)
  have gr0 := apply(x86.touch_range_frame, {M0}, {A}, {n}, {1}, {m1}, {e1}, no, ht)
  have gr: abi.vm_grows(app(m, "vm"), app(m1, "vm")) by simp(gr0)
  have st0 := apply(x86.touch_range_stk, {M0}, {A}, {n}, {1}, {m1}, {e1}, ht)
  have stk: x86.stk_ext(app(m, "vm"), app(m1, "vm")) by simp(st0)
  have fl0 := apply(x86.touch_range_fields, {M0}, {A}, {n}, {1}, {m1}, {e1}, ht)
  have fl: x86.vm_fields(app(m, "vm"), app(m1, "vm")) by simp(fl0)
  have mf: app(m1, "os") = app(m, "os") && app(m1, "fs_base") = app(m, "fs_base") && app(m1, "cpu") = app(m, "cpu") && app(m1, "gs_base") = app(m, "gs_base") &&
    app(m1, "flags") = app(m, "flags") && app(m1, "gpr") = app(m, "gpr") && app(m1, "rip") = a2 by simp(tv)
  // C: typed
  have v1: app(m1, "vm") in x86_64_linux.Vm := apply(x86i.parts, m1M).4
  have su := apply(g.store_univ, {app(m1, "vm")}, {A}, {n}, {x}, v1)
  have v1u := mp(app_univ[u := 1, f := m1, k := "vm"], m1u)
  have nu: fn_update(app(m1, "vm"), "bytes", x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), A, n, x)) in univ(1) by simp(v1u, su)
  have nv := apply(x86.store_vm, {app(m1, "vm")}, {A}, {n}, {x}, v1, nu)
  have cM0 cu0 := apply(x86.mach_vm, {m1}, {fn_update(app(m1, "vm"), "bytes", x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), A, n, x))}, m1M, m1u, nv, nu)
  have cM := rewrite(sym(hC), cM0)
  have cu := rewrite(sym(hC), cu0)
  have cvm: app(C, "vm") = fn_update(app(m1, "vm"), "bytes", x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), A, n, x)) by simp(hC)
  have cf: app(C, "os") = app(m, "os") && app(C, "fs_base") = app(m, "fs_base") && app(C, "cpu") = app(m, "cpu") && app(C, "gs_base") = app(m, "gs_base") &&
    app(C, "flags") = app(m, "flags") && app(C, "gpr") = app(m, "gpr") && app(C, "rip") = a2 by simp(hC, mf)
  // the code: still there
  have lc: abi.code_at(app(M0, "vm"), base, code) by simp(cd, keep(abi.code_at))
  have sc := all_elim(apply(x86.store_code, {base}, {code}, {M0}, {A}, {n}, {m1}, {e1}, no, hb, ht, lc), {x})
  have cd2: abi.code_at(app(C, "vm"), base, code) := rewrite(sym(cvm), sc)
  have gp gb := expand(gr, abi.vm_grows)
  have kc2: tr.keeps_code(app(s, "vm"), app(C, "vm")) proof
    have g: all gb2 gc st. gb2 in omega -> abi.loaded(app(s, "vm"), gb2, gc, st) -> abi.loaded(app(C, "vm"), gb2, gc, st) proof
      fix gb2 gc st
      assume hb2 hl
      have l1 := mp(all_elim(expand(kc, tr.keeps_code), {gb2}, {gc}, {st}), hb2, hl)
      have lc1: abi.code_at(app(M0, "vm"), gb2, gc) by simp(expand(l1, abi.loaded), keep(abi.code_at))
      have sc1 := all_elim(apply(x86.store_code, {gb2}, {gc}, {M0}, {A}, {n}, {m1}, {e1}, no, hb2, ht, lc1), {x})
      have cc: abi.code_at(app(C, "vm"), gb2, gc) := rewrite(sym(cvm), sc1)
      have stt: all y. y in omega -> y in st -> x86_64_linux.mapped(app(C, "vm"), int_div(y, x86_64_linux.PAGE)) && !abi.stack_page(app(C, "vm"), int_div(y, x86_64_linux.PAGE)) proof
        fix y
        assume hy hs
        have l0 := mp(all_elim(expand(l1, abi.loaded).2, {y}), hy, hs)
        have po: int_div(y, x86_64_linux.PAGE) in omega by defs(simp(hy), x86_64_linux.PAGE)
        have pe := mp(all_elim(gp, {int_div(y, x86_64_linux.PAGE)}), po, l0.1)
        show by defs(simp(cvm, pe, expand(l0, abi.stack_page, x86_64_linux.mapped), keep(x86_64_linux.PAGE)), abi.stack_page, x86_64_linux.mapped)
      qed
      show by defs(taut(cc, stt), abi.loaded)
    qed
    show by defs(g, tr.keeps_code)
  qed
  // the return address's page (mapped, as at the entry): kept; its bytes
  have so: R in omega by simp(r4)
  have kr := mp(all_elim(expand(kp, tr.kept), {R}), so, arith(so), arith(so))
  have p0: app(app(app(m, "vm"), "pages"), int_div(R, 4096)) = app(app(app(s, "vm"), "pages"), int_div(R, 4096)) by defs(kr, x86_64_linux.page_of, x86_64_linux.PAGE)
  have mp0: x86_64_linux.mapped(app(m, "vm"), int_div(R, 4096)) by defs(simp(p0, expand(hsps, abi.stack_page, x86_64_linux.mapped)), x86_64_linux.mapped)
  have kp2: tr.kept(app(s, "vm"), app(C, "vm"), R) proof
    have g: all a. a in omega -> int_le(int_sub(R, 8), a) -> int_lt(a, int_add(R, 8)) ->
        app(app(app(C, "vm"), "pages"), x86_64_linux.page_of(a)) = app(app(app(s, "vm"), "pages"), x86_64_linux.page_of(a)) proof
      fix a
      assume a1 ab2 a3
      have k0 := mp(all_elim(expand(kp, tr.kept), {a}), a1, ab2, a3)
      have pa: x86_64_linux.page_of(a) = int_div(R, 4096) by defs(arith(a1, ab2, a3, so, sal, slt, r4), x86_64_linux.page_of, x86_64_linux.PAGE)
      have pe := mp(all_elim(gp, {int_div(R, 4096)}), simp(so), mp0)
      show by simp(cvm, pa, pe, p0)
    qed
    show by defs(g, tr.kept)
  qed
  have rb: all k. k in omega -> int_lt(k, 8) -> app(app(app(C, "vm"), "bytes"), bits_add(64, R, bits_of_int(64, k))) = app(app(app(m, "vm"), "bytes"), bits_add(64, R, bits_of_int(64, k))) proof
    fix k
    assume k1 k2
    have rp := apply(abi.ret_pages, {R}, {k}, r4, sal, slt, k1, k2)
    have ne: all j. j in omega -> int_lt(j, n) -> !(bits_add(64, A, bits_of_int(64, j)) = bits_add(64, R, bits_of_int(64, k))) proof
      fix j
      assume j1 j2
      have ej _ jl .. := apply(tr.ha_byte, {R}, {c}, {n}, {j}, r4, g8, hc, j1, j2)
      have ek: bits_add(64, R, bits_of_int(64, k)) = int_add(R, k) by simp(r4, slt, k1, k2)
      have nq: !(int_add(int_sub(R, int_sub(18446744073709551616, c)), j) = int_add(R, k)) by arith(jl, k1)
      show by simp(ej, ek, nq)
    qed
    have so2 := apply(x86.store_outside, {app(app(m1, "vm"), "bytes")}, {A}, {n}, {x}, {bits_add(64, R, bits_of_int(64, k))}, simp(), ne)
    have mpk: x86_64_linux.mapped(app(m, "vm"), x86_64_linux.page_of(bits_add(64, R, bits_of_int(64, k)))) by defs(simp(rp, mp0), x86_64_linux.page_of, x86_64_linux.PAGE)
    have gg := mp(all_elim(gb, {bits_add(64, R, bits_of_int(64, k))}), simp(), mpk)
    show by simp(cvm, so2, gg)
  qed
  have rl := apply(tr.le_same, {app(app(C, "vm"), "bytes")}, {app(app(m, "vm"), "bytes")}, {R}, {8}, simp(), rb)
  have ra2: x86_64_linux.le(app(app(C, "vm"), "bytes"), R, 8) = abi.ret(s) := trans(rl, ra8)
  have cs: abi.callee_saved(C, s) by simp(cf, i, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access, tr.kept, tr.keeps_code, abi.stack_gap_free))
  have i2: tr.inv(s, base, code, fr, C, w) by defs(simp(i, cM, cu, cf, cd2, kc2, kp2, ra2, cs, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access, tr.kept, tr.keeps_code, abi.stack_gap_free)), tr.inv)
  have b1: app(app(m1, "vm"), "bytes") in fn_space(bits(64), bits(8)) by simp(v1)
  show by taut(i2, cf, gr, stk, fl, cvm, b1)
qed

// ----------------------------------------------------------------------
//  A fault in the frame: a stack overflow (the pages from it up to rsp
//  stack pages or unmapped: as at the entry -- the guard gap -- or grown)

theorem tr.frame_ovf: all s base code fr m w yv X. tr.inv(s, base, code, fr, m, w) -> x86.stk_ext(app(s, "vm"), yv) -> X in omega ->
  int_le(int_sub(app(app(s, "gpr"), 4), tr.FMAX), X) -> int_lt(X, app(app(s, "gpr"), 4)) -> abi.overflow_at(yv, int_sub(app(app(s, "gpr"), 4), fr), abi.sp(s), X)
proof
  fix s base code fr m w yv X
  assume hi hx hxo hl hu
  have {sM, slt, fro} := hi
  have r4 := apply(x86i.rsp_typed, sM)
  have g8 := apply(tr.inv_gap, hi)
  let R := app(app(s, "gpr"), 4)
  have nr := apply(tr.sp_lt, {R}, r4, slt)
  have lt: int_lt(X, abi.sp(s)) by arith(hu, nr)
  have g: all p. p in omega -> int_le(int_div(X, x86_64_linux.PAGE), p) && int_le(p, int_div(int_sub(R, fr), x86_64_linux.PAGE)) ->
      abi.stack_page(yv, p) || !x86_64_linux.mapped(yv, p) proof
    fix p
    assume hp hr
    have xe := mp(all_elim(expand(hx, x86.stk_ext).1, {p}), hp)
    have eq: app(app(yv, "pages"), p) = app(app(app(s, "vm"), "pages"), p) -> abi.stack_page(yv, p) || !x86_64_linux.mapped(yv, p) proof
      assume e
      have mc: x86_64_linux.mapped(yv, p) -> abi.stack_page(yv, p) proof
        assume hm
        have ms: x86_64_linux.mapped(app(s, "vm"), p) by defs(simp(sym(e), expand(hm, x86_64_linux.mapped)), x86_64_linux.mapped)
        have hr2 := expand(hr, x86_64_linux.PAGE)
        have l1: int_le(int_div(int_sub(R, tr.FMAX), 4096), p) by arith(hr2, hl, hxo, r4, g8)
        have l2: int_le(p, int_div(R, 4096)) by arith(hr2, fro, r4, g8)
        have ss := apply(tr.gap_stack, {s}, {base}, {code}, {fr}, {m}, {w}, {p}, hi, hp, l1, l2, ms)
        show by defs(simp(e, expand(ss, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
      qed
      show by taut(mc)
    qed
    show by taut(xe, eq)
  qed
  show by defs(taut(lt, g), abi.overflow_at)
qed

// a store's touch of the home c faulting: a crash with the entry's I/O
// (the frame, before a call), or not at all (the frame accessible)
theorem tr.frame_fault: all s base code fr m w fd c n a2 y e p. tr.inv(s, base, code, fr, m, w) -> tr.frame(s, m, fd) -> tr.hrange(c, n) ->
  fd in omega -> int_le(int_sub(18446744073709551616, fd), c) -> int_le(fd, tr.FMAX) -> a2 in bits(64) ->
  runs(x86_64_linux.touch_range(tr.ha(s, c), n, 1), fn_update(m, "rip", a2), exc(y, e)) -> tr.crash(s, p, w, exc(y, e))
proof
  fix s base code fr m w fd c n a2 y e p
  assume hi hf hc hfo hfd hfm ha2 ht
  have i := expand(hi, tr.inv)
  have {mM, mu, kp, rspm, sM, slt, hsps, sal} := hi
  let M0 := fn_update(m, "rip", a2)
  let R := app(app(s, "gpr"), 4)
  let A := tr.ha(s, c)
  let P0 := int_div(R, 4096)
  have r4 := apply(x86i.rsp_typed, sM)
  have g8 := apply(tr.inv_gap, hi)
  have so: R in omega by simp(r4)
  have p0o: P0 in omega by simp(r4)
  have cr := expand(hc, tr.hrange)
  have no: n in omega by taut(cr)
  have m0M: M0 in x86_64_linux.Machine by defs(simp(expand(mM, x86_64_linux.Machine), mu, ha2), x86_64_linux.Machine)
  have m0u: M0 in univ(1) by simp(mu, ha2)
  have v0: app(M0, "vm") in x86_64_linux.Vm := apply(x86i.parts, m0M).4
  // (rsp's page: mapped, as at the entry)
  have kr := mp(all_elim(expand(kp, tr.kept), {R}), so, arith(so), arith(so))
  have pe0: app(app(app(m, "vm"), "pages"), P0) = app(app(app(s, "vm"), "pages"), P0) by defs(kr, x86_64_linux.page_of, x86_64_linux.PAGE)
  have mp0: x86_64_linux.mapped(app(M0, "vm"), P0) by defs(simp(pe0, expand(hsps, abi.stack_page, x86_64_linux.mapped)), x86_64_linux.mapped)
  have rb: x86.range_below(A, n, 0, P0) proof
    have g: all j. j in omega -> int_lt(j, n) -> int_le(0, x86_64_linux.page_of(bits_add(64, A, bits_of_int(64, j)))) && int_le(x86_64_linux.page_of(bits_add(64, A, bits_of_int(64, j))), P0) proof
      fix j
      assume j1 j2
      have ej jo jl .. := apply(tr.ha_byte, {R}, {c}, {n}, {j}, r4, g8, hc, j1, j2)
      show by defs(simp(ej, jo, jl, r4, keep(x86_64_linux.PAGE)), x86_64_linux.page_of, x86_64_linux.PAGE)
    qed
    show by defs(g, x86.range_below)
  qed
  have gr fa := apply(x86.touch_range_exc, {M0}, {A}, {n}, {1}, {0}, {P0}, {y}, {e}, v0, m0u, p0o, mp0, rb, ht)
  have {yM = cM, yos = cos, ygpr = cgpr} := apply(x86.grown_typed, {M0}, {0}, {P0}, {y}, m0M, m0u, gr)
  // the frame accessible: no fault
  have d2: tr.hacc(s, app(m, "vm"), int_sub(18446744073709551616, fd), fd) -> tr.crash(s, p, w, exc(y, e)) proof
    assume h
    have ac: all i0. i0 in omega -> int_lt(i0, n) -> x86_64_linux.can_access(app(M0, "vm"), bits_add(64, A, bits_of_int(64, i0)), 1) proof
      fix i0
      assume i1 i2
      let J := int_add(int_sub(c, int_sub(18446744073709551616, fd)), i0)
      have jo: J in omega by arith(cr, hfd, i1)
      have jl: int_lt(J, fd) by arith(cr, hfd, i1, i2)
      have fr0: tr.hrange(int_sub(18446744073709551616, fd), fd) by defs(arith(cr, hfo, hfd, hfm, i1, i2), tr.hrange)
      have ef .. := apply(tr.ha_byte, {R}, {int_sub(18446744073709551616, fd)}, {fd}, {J}, r4, g8, fr0, jo, jl)
      have ex .. := apply(tr.ha_byte, {R}, {c}, {n}, {i0}, r4, g8, hc, i1, i2)
      have same: bits_add(64, tr.ha(s, int_sub(18446744073709551616, fd)), bits_of_int(64, J)) = bits_add(64, A, bits_of_int(64, i0)) by simp(ef, ex, cr, hfd)
      have k1 k2 := mp(all_elim(expand(h, tr.hacc), {J}), jo, jl)
      have k3 := rewrite(same, k1)
      show by simp(k3)
    qed
    have ok0 := apply(x86.touch_range_access, {M0}, {A}, {n}, {1}, {exc(y, e)}, no, ac, ht)
    have ne: !(exc(y, e) = ok(M0, empty)) by defs(simp(), exc, ok)
    show by taut(ok0, ne)
  qed
  // before a call: the I/O the entry's -- a stack overflow there
  have d1: app(m, "os") = app(s, "os") && x86.stk_ext(app(s, "vm"), app(m, "vm")) -> tr.crash(s, p, w, exc(y, e)) proof
    assume h
    have ho hse := h
    have sx := apply(x86.touch_range_stk_exc, {M0}, {A}, {n}, {1}, {y}, {e}, ht)
    have sx2: x86.stk_ext(app(m, "vm"), app(y, "vm")) by simp(sx)
    have sy := apply(x86.stk_ext_trans, {app(s, "vm")}, {app(m, "vm")}, {app(y, "vm")}, hse, sx2)
    obtain j, jo jn tf0 from expand(fa, x86.fault_at)
    let X := bits_add(64, A, bits_of_int(64, j))
    have ex xo xl xg := apply(tr.ha_byte, {R}, {c}, {n}, {j}, r4, g8, hc, jo, jn)
    have xb: X in bits(64) by simp()
    have yr: app(app(y, "gpr"), 4) = int_sub(R, fr) by simp(ygpr, rspm)
    have ov0 := apply(tr.frame_ovf, {s}, {base}, {code}, {fr}, {m}, {w}, {app(y, "vm")}, {int_add(int_sub(R, int_sub(18446744073709551616, c)), j)}, hi, sy, xo, xg, xl)
    have ov: abi.overflow_at(app(y, "vm"), app(app(y, "gpr"), 4), abi.sp(s), X) by simp(ov0, yr, ex)
    have yo: app(y, "os") = app(s, "os") by simp(yos, ho)
    have sub: subset(app(app(s, "os"), "events"), app(app(y, "os"), "events")) by simp(yo, subset_refl[s := app(app(s, "os"), "events")])
    have inp: app(app(s, "os"), "input") = app(app(y, "os"), "input") by simp(yo)
    have io: tr.ovf(p, w, app(y, "os")) || app(app(s, "os"), "events") = app(app(y, "os"), "events") by simp(yo)
    have crash: all kk. (kk = 0 || kk = 1 || kk = 3) -> e = exc_val("segv", pair(X, kk)) -> tr.crash(s, p, w, exc(y, e)) proof
      fix kk
      assume hkk he
      have cr2: exc(y, e) = exc(y, exc_val("segv", pair(X, kk))) by simp(he)
      show by defs(ex_intro({y}, {X}, {kk}, taut(cr2, hkk, ov, yM, xb, sub, inp, io)), tr.crash)
    qed
    have tf := expand(tf0, x86.touch_fault)
    have cn: x86_64_linux.canonical(X) by defs(simp(ex, xl, slt, xo), x86_64_linux.canonical)
    have c0: e = exc_val("segv", pair(X, 0)) -> tr.crash(s, p, w, exc(y, e)) := mp(all_elim(crash, {0}), simp())
    have c1: e = exc_val("segv", pair(X, 1)) -> tr.crash(s, p, w, exc(y, e)) := mp(all_elim(crash, {1}), simp())
    have c3: e = exc_val("segv", pair(X, 3)) -> tr.crash(s, p, w, exc(y, e)) := mp(all_elim(crash, {3}), simp())
    show by taut(tf, cn, c0, c1, c3)
  qed
  show by taut(expand(hf, tr.frame), d1, d2)
qed

// (n bytes stored, read back: the value, n a word's size)
theorem tr.le_store_n: all b a n x. b in fn_space(bits(64), bits(8)) -> a in bits(64) -> (n = 1 || n = 2 || n = 4 || n = 8) -> x in bits(int_mul(8, n)) ->
  x86_64_linux.le(x86_64_linux.store_le(b, a, n, x), a, n) = x
proof
  fix b a n x
  assume hb ha hn hx
  have c1: n = 1 -> x86_64_linux.le(x86_64_linux.store_le(b, a, n, x), a, n) = x proof
    assume e
    show by simp(e, hb, ha, rewrite(e, hx))
  qed
  have c2: n = 2 -> x86_64_linux.le(x86_64_linux.store_le(b, a, n, x), a, n) = x proof
    assume e
    show by simp(e, hb, ha, rewrite(e, hx))
  qed
  have c4: n = 4 -> x86_64_linux.le(x86_64_linux.store_le(b, a, n, x), a, n) = x proof
    assume e
    show by simp(e, hb, ha, rewrite(e, hx))
  qed
  have c8: n = 8 -> x86_64_linux.le(x86_64_linux.store_le(b, a, n, x), a, n) = x proof
    assume e
    show by simp(e, hb, ha, rewrite(e, hx))
  qed
  show by taut(hn, c1, c2, c4, c8)
qed

// ----------------------------------------------------------------------
//  A store to the home c (n bytes x, the frame reaching fd bytes): its
//  touch -- the stack grown there, or a fault (tr.frame_fault) -- then the
//  bytes written; the claim after it, the home holding x (and the homes it
//  left, hs2), gives the claim before

theorem tr.fstore_step(zb. bkp, zb pb wb. bka): all s v base code fr a a2 c n x hs hs2 fd rs p w.
  (all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
     (ex m1 e1. runs(x86_64_linux.touch_range(tr.ha(s, c), n, 1), fn_update(m, "rip", a2), ok(m1, e1)) &&
        o = ok(fn_update(m1, "vm", fn_update(app(m1, "vm"), "bytes", x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), tr.ha(s, c), n, x))), empty)) ||
     (ex y e. runs(x86_64_linux.touch_range(tr.ha(s, c), n, 1), fn_update(m, "rip", a2), exc(y, e)) && o = exc(y, e))) ->
  base in omega -> a2 in bits(64) -> tr.hrange(c, n) -> fd in omega -> int_le(int_sub(18446744073709551616, fd), c) -> int_le(fd, tr.FMAX) ->
  (n = 1 || n = 2 || n = 4 || n = 8) -> x in bits(int_mul(8, n)) -> tr.hkeep(hs, hs2, c, n) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, fn_update(hs2, c, pair(n, x)), fd, rs, p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, fd, rs, p, w)
proof
  fix s v base code fr a a2 c n x hs hs2 fd rs p w
  assume he hb ha2 hc hfo hfd hfm hn hx hk hpt
  have g: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, fd) ->
      tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m) proof
    fix m
    assume hi hr hh hrs hmm hfr
    have {sM} := hi
    have r4 := apply(x86i.rsp_typed, sM)
    have g8 := apply(tr.inv_gap, hi)
    have nr := apply(tr.inv_nr, hi)
    let ST(m1) := fn_update(m1, "vm", fn_update(app(m1, "vm"), "bytes", x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), tr.ha(s, c), n, x)))
    let Q(m2) := ex m1 e1. runs(x86_64_linux.touch_range(tr.ha(s, c), n, 1), fn_update(m, "rip", a2), ok(m1, e1)) && m2 = ST(m1)
    let QX(y, e) := runs(x86_64_linux.touch_range(tr.ha(s, c), n, 1), fn_update(m, "rip", a2), exc(y, e))
    have st: all o. runs(x86_64_linux.step(), m, o) -> (ex m2. o = ok(m2, empty) && Q(m2)) || (ex y e. o = exc(y, e) && QX(y, e)) proof
      fix o
      assume ho
      have c := mp(all_elim(he, {m}, {o}), hi, hr, hh, hrs, ho)
      have okc: (ex m1 e1. runs(x86_64_linux.touch_range(tr.ha(s, c), n, 1), fn_update(m, "rip", a2), ok(m1, e1)) && o = ok(ST(m1), empty)) ->
          (ex m2. o = ok(m2, empty) && Q(m2)) proof
        assume h
        obtain m1, h0 from h
        obtain e1, h1 from h0
        have q: Q(ST(m1)) by ex_intro({m1}, {e1}, taut(h1, refl({ST(m1)})))
        show by ex_intro({ST(m1)}, taut(h1, q))
      qed
      have exc0: (ex y e. QX(y, e) && o = exc(y, e)) -> (ex y e. o = exc(y, e) && QX(y, e)) proof
        assume h
        obtain y, h0 from h
        obtain e, h1 from h0
        show by ex_intro({y}, {e}, taut(h1))
      qed
      show by taut(c, okc, exc0)
    qed
    have post: all m2. Q(m2) -> tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m2) proof
      fix m2
      assume hq
      obtain m1, hq1 from hq
      obtain e1, ht e2 from hq1
      have i2 cos crip cgpr gr stk fl cvm v1 := apply(tr.inv_fstore, {s}, {base}, {code}, {fr}, {m}, {w}, {c}, {n}, {x}, {a2}, {m1}, {e1}, {ST(m1)}, hi, hb, ha2, hc, ht, refl({ST(m1)}))
      // the homes: those left, kept; the stored one
      have hk2 := apply(tr.homes_store, {s}, {m}, {ST(m1)}, {hs}, {hs2}, {c}, {n}, {x}, {app(m1, "vm")}, r4, g8, hh, hk, hc, gr, cvm)
      have ac1 := apply(tr.fstore_acc, {s}, {base}, {code}, {fr}, {m}, {w}, {fd}, {c}, {n}, {a2}, {m1}, {e1}, hi, hfr, hc, hfo, hfd, hfm, ht)
      have pe: app(app(ST(m1), "vm"), "pages") = app(app(m1, "vm"), "pages") by simp()
      have ac2 := apply(tr.hacc_pages, {s}, {app(m1, "vm")}, {app(ST(m1), "vm")}, {c}, {n}, pe, ac1)
      have lv: x86_64_linux.le(app(app(ST(m1), "vm"), "bytes"), tr.ha(s, c), n) = x by simp(apply(tr.le_store_n, {app(app(m1, "vm"), "bytes")}, {tr.ha(s, c)}, {n}, {x}, v1, simp(), hn, hx))
      have h2 := apply(tr.homes_put, {s}, {ST(m1)}, {hs2}, {c}, {n}, {x}, hk2, lv, hc, ac2)
      have rs2: tr.regs(ST(m1), rs) by defs(simp(expand(hrs, tr.regs), cgpr), tr.regs)
      have mm1 := apply(tr.mem_grow, {s}, {base}, {code}, {fr}, {m}, {m1}, {w}, {v}, hi, hmm, gr, stk, fl)
      have mm2 := apply(tr.mem_fstore, {s}, {base}, {code}, {fr}, {m}, {m1}, {ST(m1)}, {w}, {v}, {c}, {n}, {x}, hi, mm1, hc, ac1, simp())
      have f2 := apply(tr.frame_store, {s}, {m}, {ST(m1)}, {fd}, {app(m1, "vm")}, hfr, cos, gr, stk, pe, simp(), simp())
      have c := mp(all_elim(expand(hpt, tr.pt), {ST(m1)}), i2, crip, h2, rs2, mm2, f2)
      show := rewrite(sym(e2), c)
    qed
    have fault: all y e. QX(y, e) -> tr.ub(s, v, p, w) || tr.crash(s, p, w, exc(y, e)) proof
      fix y e
      assume hq
      have cr := apply(tr.frame_fault, {s}, {base}, {code}, {fr}, {m}, {w}, {fd}, {c}, {n}, {a2}, {y}, {e}, {p}, hi, hfr, hc, hfo, hfd, hfm, ha2, hq)
      show by taut(cr)
    qed
    show := mp(tr.step_x[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb), s := s, v := v, p := p, w := w, m := m, q := x. Q(x), qx := y e. QX(y, e)], st, nr, post, fault)
  qed
  show by defs(g, tr.lv)
qed

// ----------------------------------------------------------------------
//  Frame stores

// mov [rsp + d], r32 / r64 (n = 4, 8; g holding u): the home c (rsp + d in
// the frame) := u's low n bytes
theorem tr.store_home_r(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len n g d c z1 z2 ng u x hs hs2 fd rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(75, pair(n, pair(g, pair(x86i.rsp_mem(d), pair(z1, z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> base in omega -> g in x86_64_linux.Reg -> g in dom(rs) -> app(rs, g) = pair(ng, u) -> (n = 4 || n = 8) -> x = bits_of_int(int_mul(8, n), u) ->
  d in bits(64) -> c = int_mod(int_sub(d, fr), 18446744073709551616) -> tr.hrange(c, n) -> fd in omega -> int_le(int_sub(18446744073709551616, fd), c) -> int_le(fd, tr.FMAX) ->
  tr.hkeep(hs, hs2, c, n) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, fn_update(hs2, c, pair(n, x)), fd, rs, p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, fd, rs, p, w)
proof
  fix s v base code fr a a2 len n g d c z1 z2 ng u x hs hs2 fd rs p w
  assume hat ha2 hb hg hgd hgu hn hxe hd hcd hc hfo hfd hfm hk hpt
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex m1 e1. runs(x86_64_linux.touch_range(tr.ha(s, c), n, 1), fn_update(m, "rip", a2), ok(m1, e1)) &&
        o = ok(fn_update(m1, "vm", fn_update(app(m1, "vm"), "bytes", x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), tr.ha(s, c), n, x))), empty)) ||
      (ex y e. runs(x86_64_linux.touch_range(tr.ha(s, c), n, 1), fn_update(m, "rip", a2), exc(y, e)) && o = exc(y, e)) proof
    fix m o
    assume hi hr hh hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have {sM} := hi
    have r4 := apply(x86i.rsp_typed, sM)
    have g8 := apply(tr.inv_gap, hi)
    have {slt} := hi
    have fe := apply(tr.frame_ea, {s}, {base}, {code}, {fr}, {m}, {w}, {d}, {c}, {0}, hi, hd, hcd, simp())
    have rg ut := apply(tr.regs_get, {m}, {rs}, {g}, {ng}, {u}, hrs, hgd, hgu)
    have u64 := apply(x86i.reg_typed, ipM, hg)
    have u64b: u in bits(64) := rewrite(rg, u64)
    have xv: (n = 4 && x = bits_slice(app(app(m, "gpr"), g), 31, 0) || n = 8 && x = app(app(m, "gpr"), g)) by simp(hn, hxe, rg, u64b)
    have k0: all i. i in omega -> int_lt(i, n) -> x86_64_linux.canonical(bits_add(64, x86i.rsp_ea(m, d), bits_of_int(64, i))) proof
      fix i
      assume i1 i2
      have ei _ il .. := apply(tr.ha_byte, {app(app(s, "gpr"), 4)}, {c}, {n}, {i}, r4, g8, hc, i1, i2)
      have ea: bits_add(64, x86i.rsp_ea(m, d), bits_of_int(64, i)) = int_add(int_sub(app(app(s, "gpr"), 4), int_sub(18446744073709551616, c)), i) by simp(fe, ei)
      have cr := expand(hc, tr.hrange)
      show by defs(simp(ea, il, slt, i1, cr), x86_64_linux.canonical)
    qed
    have hx2 := mp(mp(mp(all_elim(hat, {m}, {o}), ho), ipC), hr)
    have r := apply(x86i.store_rsp_t, {m}, {o}, {n}, {g}, {d}, {z1}, {z2}, {len}, {x}, ipM, ipU, hg, hd, xv, k0, hx2)
    have ra: bits_add(64, app(m, "rip"), len) = a2 by simp(hr, ha2)
    have r2 := rewrite(ra, rewrite(fe, r))
    have no: n in omega by simp(hn)
    have nd: all t. !runs(x86_64_linux.touch_range(tr.ha(s, c), n, 1), fn_update(m, "rip", a2), diverge(t)) proof
      fix t
      show := apply(x86.touch_range_nodiv, {fn_update(m, "rip", a2)}, {tr.ha(s, c)}, {n}, {1}, {t}, no)
    qed
    have dv: (ex t. runs(x86_64_linux.touch_range(tr.ha(s, c), n, 1), fn_update(m, "rip", a2), diverge(t)) && o = diverge(t)) -> false proof
      assume h
      obtain t, ht from h
      show by taut(ht, all_elim(nd, {t}))
    qed
    show by taut(r2, dv)
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  have hx: x in bits(int_mul(8, n)) by simp(hxe, hn)
  have hn2: n = 1 || n = 2 || n = 4 || n = 8 by taut(hn)
  show := apply(tr.fstore_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {c}, {n}, {x}, {hs}, {hs2}, {fd}, {rs}, {p}, {w}, he, hb, a2b, hc, hfo, hfd, hfm, hn2, hx, hk, hpt)
qed

// ----------------------------------------------------------------------
//  The entry: the claim at the function's first instruction (no homes, the
//  arguments in their registers rs(args)), for every entry with n
//  arguments, gives abi.matches -- for the contract's code lb/lc, which
//  holds the function's (base/code; a caller's: its callees' too). The
//  prologue -- `sub rsp, k`, the arguments' stores -- is ordinary
//  instructions after it.

theorem tr.entry_n(lb, lc, base, code, statics, f, n, fd, x0. rs, x0. q, x3 x4 x2. kw): base in omega ->
  (all vm. abi.loaded(vm, lb, lc, statics) -> abi.code_at(vm, base, code)) ->
  (all args s. args in abi.ARGS -> s in x86_64_linux.Machine -> abi.entry_ok(s, args) -> ord_le(n, seq_len(args)) -> tr.regs(s, rs(args))) ->
  (all args v mem s. args in abi.ARGS -> v in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> ord_le(n, seq_len(args)) ->
    abi.loaded(app(s, "vm"), lb, lc, statics) -> abi.view(s, v, mem) in univ(1) ->
    tr.pt(s, zb. false, zb pb wb. false, v, base, code, 0, f, empty, fd, rs(args), mkprog(x1 x2. bind_rel(q(args), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), abi.view(s, v, mem))) ->
  (all args v mem s o. args in abi.ARGS -> v in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(app(s, "vm"), lb, lc, statics) -> app(s, "rip") = f ->
    abi.entry_ok(s, args) -> tr.objs_ok(s, v) -> abi.view_ok(s, v, mem) -> tr.run_d(s, s, o) ->
    tr.matches_t(fn_build(abi.ARGS, x0. mkprog(x1 x2. !ord_le(n, seq_len(x0)) || bind_rel(q(x0), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))), args, v, mem, s, o))
proof
  assume hbase hsub hregs hbody
  have hpro: all args v mem s. args in abi.ARGS -> v in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(app(s, "vm"), lb, lc, statics) -> app(s, "rip") = f ->
      abi.entry_ok(s, args) -> tr.objs_ok(s, v) -> abi.view_ok(s, v, mem) -> ord_le(n, seq_len(args)) ->
      tr.sim(s, zb. false, zb pb wb. false, v, mkprog(x1 x2. bind_rel(q(args), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), abi.view(s, v, mem), s) proof
    fix args v mem s
    assume hA hvo hmv hM su hl hrip he hob hvw hg
    let W := abi.view(s, v, mem)
    have hc := mp(all_elim(hsub, {app(s, "vm")}), hl)
    have ent := apply(abi.entry_stack, hM, he)
    have hdf: !app(app(s, "flags"), "df") by taut(expand(he, abi.entry_ok))
    have r4 := apply(x86i.rsp_typed, hM)
    have ou := apply(abi.objs_univ, hvo)
    have mu := apply(x86.vm_univ, hmv)
    have hvu: W in univ(1) by simp(su, ou, mu)
    have wt := apply(abi.world_typed, hM, hvo, hmv, hvu)
    have body := mp(all_elim(hbody, {args}, {v}, {mem}, {s}), hA, hvo, hmv, hM, hg, hl, hvu)
    have z0: int_sub(app(app(s, "gpr"), 4), 0) = app(app(s, "gpr"), 4) by arith(r4)
    have inv: tr.inv(s, base, code, 0, s, W) by defs(simp(subset_refl[s := app(app(s, "os"), "events")], hvw.1, apply(abi.entry_gap, he), apply(abi.entry_rsv, he), all_elim(tr.keeps_refl, {app(s, "vm")}),
      all_elim(tr.kept_refl, {app(s, "vm")}, {app(app(s, "gpr"), 4)}), z0, hM, su, hc, hdf, wt, hvu, ent,
      keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access)), tr.inv)
    have hh := all_elim(tr.homes_empty, {s}, {s})
    have rr := mp(all_elim(hregs, {args}, {s}), hA, hM, he, hg)
    have mm := apply(tr.mem_entry, hob, hvw)
    have fe := all_elim(tr.frame_entry, {s}, {fd})
    have lt0 := apply(tr.sp_lt, {app(app(s, "gpr"), 4)}, r4, ent.4)
    have ns0: !tr.stopk(s, zb. false, s) by defs(taut(lt0), tr.stopk)
    have c0 := mp(all_elim(expand(body, tr.pt), {s}), inv, hrip, hh, rr, mm, fe)
    show := mp(expand(c0, tr.cl).2, ns0)
  qed
  show := mp(tr.entry_g[base := lb, code := lc, statics := statics, f := f, n := n, q := x0. q(x0), kw := x3 x4 x2. kw(x3, x4, x2)], hpro)
qed

// (the argument registers: rdi, rsi, rdx, rcx, r8, r9)
theorem tr.argregs: app(abi.ARG_REGS, 0) = 7 && app(abi.ARG_REGS, 1) = 6 && app(abi.ARG_REGS, 2) = 2 && app(abi.ARG_REGS, 3) = 1 &&
  app(abi.ARG_REGS, 4) = 8 && app(abi.ARG_REGS, 5) = 9
proof
  let L := seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(7), seq_one(6)), seq_one(2)), seq_one(1)), seq_one(8)), seq_one(9))
  have a0 := at({app(L, 0)})
  have a1 := at({app(L, 1)})
  have a2 := at({app(L, 2)})
  have a3 := at({app(L, 3)})
  have a4 := at({app(L, 4)})
  have a5 := at({app(L, 5)})
  show by defs(simp(a0, a1, a2, a3, a4, a5), abi.ARG_REGS)
qed

// argument i: in its register r at the entry, 64 bits
theorem tr.arg_reg: all s args i r. s in x86_64_linux.Machine -> abi.entry_ok(s, args) -> i in omega -> int_lt(i, seq_len(args)) ->
  app(abi.ARG_REGS, i) = r -> r in x86_64_linux.Reg -> app(app(s, "gpr"), r) = app(args, i) && app(args, i) in bits(int_mul(8, 8))
proof
  fix s args i r
  assume hM he hi lt hr hR
  have ac: all x0. x0 in omega -> int_lt(x0, seq_len(args)) -> app(app(s, "gpr"), app(abi.ARG_REGS, x0)) = app(args, x0) by taut(expand(he, abi.entry_ok))
  have e0 := mp(all_elim(ac, {i}), hi, lt)
  have e := rewrite(hr, e0)
  have t := apply(x86i.reg_typed, hM, hR)
  have t2 := rewrite(e, t)
  show by simp(e, t2)
qed

// the registers' map: empty; a register added (holding x)
theorem tr.regs_empty: all m. tr.regs(m, empty)
proof
  fix m
  show by defs(simp(dom_empty), tr.regs)
qed

theorem tr.regs_add: all m rs g k x. tr.regs(m, rs) -> app(app(m, "gpr"), g) = x -> x in bits(int_mul(8, k)) -> tr.regs(m, fn_update(rs, g, pair(k, x)))
proof
  fix m rs g k x
  assume h he hx
  have fr r := expand(h, tr.regs)
  have fu := mp(fn_update_fun[f := rs, k := g, v := pair(k, x)], fr)
  have g0: all r0. r0 in dom(fn_update(rs, g, pair(k, x))) -> app(app(m, "gpr"), r0) = snd(app(fn_update(rs, g, pair(k, x)), r0)) &&
      snd(app(fn_update(rs, g, pair(k, x)), r0)) in bits(int_mul(8, fst(app(fn_update(rs, g, pair(k, x)), r0)))) proof
    fix r0
    assume hd
    have cs := apply(tr.dom_cases, {rs}, {g}, {pair(k, x)}, {r0}, hd)
    have same: r0 = g -> app(app(m, "gpr"), r0) = snd(app(fn_update(rs, g, pair(k, x)), r0)) &&
        snd(app(fn_update(rs, g, pair(k, x)), r0)) in bits(int_mul(8, fst(app(fn_update(rs, g, pair(k, x)), r0)))) proof
      assume e
      have g1: app(app(m, "gpr"), g) = snd(app(fn_update(rs, g, pair(k, x)), g)) && snd(app(fn_update(rs, g, pair(k, x)), g)) in bits(int_mul(8, fst(app(fn_update(rs, g, pair(k, x)), g)))) by simp(he, hx)
      show := subst({y. app(app(m, "gpr"), y) = snd(app(fn_update(rs, g, pair(k, x)), y)) && snd(app(fn_update(rs, g, pair(k, x)), y)) in bits(int_mul(8, fst(app(fn_update(rs, g, pair(k, x)), y))))}, sym(e), g1)
    qed
    have other: !(r0 = g) -> app(app(m, "gpr"), r0) = snd(app(fn_update(rs, g, pair(k, x)), r0)) &&
        snd(app(fn_update(rs, g, pair(k, x)), r0)) in bits(int_mul(8, fst(app(fn_update(rs, g, pair(k, x)), r0)))) proof
      assume ne
      have d0: r0 in dom(rs) by taut(cs, ne)
      have c := mp(all_elim(r, {r0}), d0)
      have e1 := mp(app_update_other[f := rs, k := g, v := pair(k, x), x := r0], ne)
      show by simp(c, e1)
    qed
    show by taut(same, other)
  qed
  show by defs(taut(fu, g0), tr.regs)
qed

// ----------------------------------------------------------------------
//  A home rewritten (its bytes accessible: no touch, no growth; the
//  instruction may set the flags)

// (bytes stored below the entry's rsp: the return address as before)
theorem tr.ret_off: all s base code fr m w c n x b. tr.inv(s, base, code, fr, m, w) -> tr.hrange(c, n) ->
  x86_64_linux.le(x86_64_linux.store_le(b, tr.ha(s, c), n, x), app(app(s, "gpr"), 4), 8) = x86_64_linux.le(b, app(app(s, "gpr"), 4), 8)
proof
  fix s base code fr m w c n x b
  assume hi hc
  have {sM, slt} := hi
  have r4 := apply(x86i.rsp_typed, sM)
  have g8 := apply(tr.inv_gap, hi)
  let R := app(app(s, "gpr"), 4)
  have rb: all k. k in omega -> int_lt(k, 8) -> app(x86_64_linux.store_le(b, tr.ha(s, c), n, x), bits_add(64, R, bits_of_int(64, k))) = app(b, bits_add(64, R, bits_of_int(64, k))) proof
    fix k
    assume k1 k2
    have ne: all j. j in omega -> int_lt(j, n) -> !(bits_add(64, tr.ha(s, c), bits_of_int(64, j)) = bits_add(64, R, bits_of_int(64, k))) proof
      fix j
      assume j1 j2
      have ej _ jl .. := apply(tr.ha_byte, {R}, {c}, {n}, {j}, r4, g8, hc, j1, j2)
      have ek: bits_add(64, R, bits_of_int(64, k)) = int_add(R, k) by simp(r4, slt, k1, k2)
      have nq: !(int_add(int_sub(R, int_sub(18446744073709551616, c)), j) = int_add(R, k)) by arith(jl, k1)
      show by simp(ej, ek, nq)
    qed
    show := apply(x86.store_outside, {b}, {tr.ha(s, c)}, {n}, {x}, {bits_add(64, R, bits_of_int(64, k))}, simp(), ne)
  qed
  show := apply(tr.le_same, {x86_64_linux.store_le(b, tr.ha(s, c), n, x)}, {b}, {R}, {8}, simp(), rb)
qed

theorem tr.inv_hbytes: all s base code fr m w c n x. tr.inv(s, base, code, fr, m, w) -> base in omega -> tr.hrange(c, n) -> tr.hacc(s, app(m, "vm"), c, n) ->
  tr.inv(s, base, code, fr, fn_update(m, "vm", fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), tr.ha(s, c), n, x))), w)
proof
  fix s base code fr m w c n x
  assume hi hb hc ha
  have i := expand(hi, tr.inv)
  have {mM, mu, cd, kc, kp, ra8} := hi
  let V2 := fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), tr.ha(s, c), n, x))
  have no: n in omega by taut(expand(hc, tr.hrange))
  have wa: all j. j in omega -> int_lt(j, n) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, tr.ha(s, c), bits_of_int(64, j)), 1) proof
    fix j
    assume j1 j2
    show by taut(mp(all_elim(expand(ha, tr.hacc), {j}), j1, j2))
  qed
  have cd2: abi.code_at(V2, base, code) := all_elim(apply(tr.store_code_acc, {base}, {code}, {app(m, "vm")}, {tr.ha(s, c)}, {n}, no, hb, cd, wa), {x})
  have kc2 := apply(tr.keeps_store, {app(s, "vm")}, {app(m, "vm")}, {tr.ha(s, c)}, {n}, {x}, no, kc, wa)
  have kp2 := apply(tr.kept_bytes, {app(s, "vm")}, {app(m, "vm")}, {app(app(s, "gpr"), 4)}, {x86_64_linux.store_le(app(app(m, "vm"), "bytes"), tr.ha(s, c), n, x)}, kp)
  have ro := apply(tr.ret_off, {s}, {base}, {code}, {fr}, {m}, {w}, {c}, {n}, {x}, {app(app(m, "vm"), "bytes")}, hi, hc)
  have ra2: x86_64_linux.le(app(V2, "bytes"), app(app(s, "gpr"), 4), 8) = abi.ret(s) by simp(ro, ra8)
  have pt := apply(x86i.parts, mM)
  have vV: app(m, "vm") in x86_64_linux.Vm by simp(pt)
  have su := apply(g.store_univ, {app(m, "vm")}, {tr.ha(s, c)}, {n}, {x}, vV)
  have vu := mp(app_univ[u := 1, f := m, k := "vm"], mu)
  have nu: V2 in univ(1) by simp(vu, su)
  have nv := apply(x86.store_vm, {app(m, "vm")}, {tr.ha(s, c)}, {n}, {x}, vV, nu)
  have m2M m2u := apply(x86.mach_vm, {m}, {V2}, mM, mu, nv, nu)
  show by defs(simp(i, m2M, m2u, cd2, kc2, kp2, ra2, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access, tr.kept, tr.keeps_code, abi.stack_gap_free)), tr.inv)
qed

// the home c (n bytes, an existing one) rewritten with x: the claim after
// it (the home holding x, the homes it leaves) gives the claim before
theorem tr.hstore_step(zb. bkp, zb pb wb. bka): all s v base code fr a a2 c n x0 x hs hs2 fd rs p w.
  (all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
     (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "vm",
       fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), tr.ha(s, c), n, x))), empty))) ->
  base in omega -> a2 in bits(64) -> c in dom(hs) -> app(hs, c) = pair(n, x0) -> (n = 1 || n = 2 || n = 4 || n = 8) -> x in bits(int_mul(8, n)) ->
  tr.hkeep(hs, hs2, c, n) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, fn_update(hs2, c, pair(n, x)), fd, rs, p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, fd, rs, p, w)
proof
  fix s v base code fr a a2 c n x0 x hs hs2 fd rs p w
  assume he hb ha2 hcd hce hn hx hk hpt
  have g: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, fd) ->
      tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m) proof
    fix m
    assume hi hr hh hrs hmm hfr
    have {sM} := hi
    have r4 := apply(x86i.rsp_typed, sM)
    have g8 := apply(tr.inv_gap, hi)
    have nr := apply(tr.inv_nr, hi)
    have hv0 hc0 ha0 := mp(all_elim(expand(hh, tr.homes), {c}), hcd)
    have hc: tr.hrange(c, n) by simp(rewrite(hce, hc0))
    have ha: tr.hacc(s, app(m, "vm"), c, n) by simp(rewrite(hce, ha0))
    let V2 := fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), tr.ha(s, c), n, x))
    let M2(f) := fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "vm", V2)
    let Q(m2) := ex f. x86i.flags_ok(m, f) && m2 = M2(f)
    have st: all o. runs(x86_64_linux.step(), m, o) -> (ex m2. o = ok(m2, empty) && Q(m2)) proof
      fix o
      assume ho
      obtain f, hf from mp(all_elim(he, {m}, {o}), hi, hr, hh, hrs, ho)
      have q2: Q(M2(f)) by ex_intro({f}, simp(hf, keep(x86i.flags_ok)))
      show by ex_intro({M2(f)}, taut(q2, hf))
    qed
    have post: all m2. Q(m2) -> tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m2) proof
      fix m2
      assume hq
      obtain f, fo e2 from hq
      let M1 := fn_update(fn_update(m, "rip", a2), "flags", f)
      have i1 := apply(tr.inv_flags, {s}, {base}, {code}, {fr}, {m}, {w}, {a2}, {f}, hi, ha2, fo)
      have ha1: tr.hacc(s, app(M1, "vm"), c, n) by simp(ha)
      have i2 := apply(tr.inv_hbytes, {s}, {base}, {code}, {fr}, {M1}, {w}, {c}, {n}, {x}, i1, hb, hc, ha1)
      have i3: tr.inv(s, base, code, fr, M2(f), w) by simp(i2)
      have ev: app(M2(f), "vm") = fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), tr.ha(s, c), n, x)) by simp()
      have hk2 := apply(tr.homes_store, {s}, {m}, {M2(f)}, {hs}, {hs2}, {c}, {n}, {x}, {app(m, "vm")}, r4, g8, hh, hk, hc, all_elim(x86.grows_refl, {app(m, "vm")}), ev)
      have {mM} := hi
      have pt := apply(x86i.parts, mM)
      have bm: app(app(m, "vm"), "bytes") in fn_space(bits(64), bits(8)) by simp(pt)
      have lv: x86_64_linux.le(app(app(M2(f), "vm"), "bytes"), tr.ha(s, c), n) = x by simp(apply(tr.le_store_n, {app(app(m, "vm"), "bytes")}, {tr.ha(s, c)}, {n}, {x}, bm, simp(), hn, hx))
      have pe: app(app(M2(f), "vm"), "pages") = app(app(m, "vm"), "pages") by simp()
      have hacc2 := apply(tr.hacc_pages, {s}, {app(m, "vm")}, {app(M2(f), "vm")}, {c}, {n}, pe, ha)
      have h2 := apply(tr.homes_put, {s}, {M2(f)}, {hs2}, {c}, {n}, {x}, hk2, lv, hc, hacc2)
      have rs2: tr.regs(M2(f), rs) by defs(simp(expand(hrs, tr.regs)), tr.regs)
      have mm2 := apply(tr.mem_fstore, {s}, {base}, {code}, {fr}, {m}, {m}, {M2(f)}, {w}, {v}, {c}, {n}, {x}, hi, hmm, hc, ha, ev)
      have f2 := apply(tr.frame_store, {s}, {m}, {M2(f)}, {fd}, {app(m, "vm")}, hfr, simp(), all_elim(x86.grows_refl, {app(m, "vm")}), all_elim(x86.stk_ext_refl, {app(m, "vm")}), pe, simp(), simp())
      have rp: app(M2(f), "rip") = a2 by simp()
      have c := mp(all_elim(expand(hpt, tr.pt), {M2(f)}), i3, rp, h2, rs2, mm2, f2)
      show := rewrite(sym(e2), c)
    qed
    show := mp(mp(mp(tr.step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb), s := s, v := v, p := p, w := w, m := m, q := y. Q(y)], st), nr), post)
  qed
  show by defs(g, tr.lv)
qed

// ----------------------------------------------------------------------
//  A frame of at most 8 bytes: on the entry rsp's page (kept, writable),
//  accessible always

theorem tr.frame8: all s base code fr m w fd. tr.inv(s, base, code, fr, m, w) -> fd in omega -> int_le(fd, 8) -> tr.frame(s, m, fd)
proof
  fix s base code fr m w fd
  assume hi hfo hf8
  have {kp, sM, sacc, sal, slt, hsps} := hi
  have r4 := apply(x86i.rsp_typed, sM)
  have g8 := apply(tr.inv_gap, hi)
  let R := app(app(s, "gpr"), 4)
  have g: all i. i in omega -> int_lt(i, fd) ->
      x86_64_linux.can_access(app(m, "vm"), bits_add(64, tr.ha(s, int_sub(18446744073709551616, fd)), bits_of_int(64, i)), 1) &&
      abi.stack_page(app(m, "vm"), int_div(bits_add(64, tr.ha(s, int_sub(18446744073709551616, fd)), bits_of_int(64, i)), 4096)) proof
    fix i
    assume i1 i2
    have hr0: tr.hrange(int_sub(18446744073709551616, fd), fd) by defs(arith(hfo, hf8, i1, i2), tr.hrange)
    have e xo xl .. := apply(tr.ha_byte, {R}, {int_sub(18446744073709551616, fd)}, {fd}, {i}, r4, g8, hr0, i1, i2)
    let X := int_add(int_sub(R, int_sub(18446744073709551616, int_sub(18446744073709551616, fd))), i)
    have l1: int_le(int_sub(R, 8), X) by arith(hfo, hf8, i1, r4)
    have l2: int_lt(X, int_add(R, 8)) by arith(xl)
    have pn := apply(tr.page_near, {R}, {X}, r4, sal, slt, l1, l2)
    have kx := mp(all_elim(expand(kp, tr.kept), {X}), xo, l1, l2)
    have kx2 := expand(kx, x86_64_linux.page_of, x86_64_linux.PAGE)
    have pe: app(app(app(m, "vm"), "pages"), int_div(X, 4096)) = app(app(app(s, "vm"), "pages"), int_div(R, 4096)) by simp(kx2, pn)
    have ca: x86_64_linux.can_access(app(m, "vm"), X, 1) by defs(simp(pe, pn, expand(sacc, x86_64_linux.can_access, x86_64_linux.mapped, x86_64_linux.page_of, x86_64_linux.PAGE), keep(x86_64_linux.hw_allows)),
      x86_64_linux.can_access, x86_64_linux.mapped, x86_64_linux.page_of, x86_64_linux.PAGE)
    have sp0: abi.stack_page(app(m, "vm"), int_div(R, 4096)) by defs(simp(rewrite(pn, pe), expand(hsps, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
    have sp: abi.stack_page(app(m, "vm"), int_div(X, 4096)) := rewrite(sym(pn), sp0)
    show by simp(e, ca, sp)
  qed
  have h: tr.hacc(s, app(m, "vm"), int_sub(18446744073709551616, fd), fd) by defs(g, tr.hacc)
  show by defs(taut(h), tr.frame)
qed
