// A call through a register into the code map, no stop (exit.c's
// libc_exit_fini: the fini_array's entries): `call *%r` against GIMPLE's
// call of fptr[T], r holding T -- as tr.call, the callee fptr[T] by the
// map's contract at T.

// (the body of any outcome before the rest K -- undefined after a call
// never returning, within blocks: the outcome e, as tr.q_some_e)
theorem tr.q_some_g(e, x2 x1. K): all w o. runs(mkprog(x0 x1. K(e, x1)), w, o) -> runs(mkprog(x0 x1. ex x2. true && K(x2, x1)), w, o)
proof
  fix w o
  assume hr
  have pu := apply(g.runs_univ, hr)
  have c := apply(g.runs_elim, hr)
  have c2: ex x2. true && K(x2, o) by ex_intro({e}, taut(c))
  show := apply(tr.runs_intro[r := x0 x1. ex x2. true && K(x2, x1)], {w}, {o}, pu, c2)
qed

// the code map's contract: at every address its callee's contract, its
// returns' effects
def tr.code_okn(fptr, n, fr, cb, cc, st) := all T. T in bits(64) -> tr.callee_contract(fr, T, fptr[T], cb, cc, st) && tr.callee_io(fptr[T], n)

theorem tr.calli(s, v, base, code, fr, a, a2, len, gr, z, nb, T, fptr, args, n, cb, cc, st, hs, ds, fd2, rs, rc, w, x9 x10 x8. ka, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw, zb. bkp, zb pb wb. bka): tr.mainv(s, v) -> tr.ofr(s, fr, v) -> tr.hap(s, hs, v) ->
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a -> runs(x86_64_linux.exec_body(len, tag(121, pair(tag(0, gr), z))), m, o)) ->
  a2 = bits_add(64, a, bits_of_int(64, len)) -> gr in x86_64_linux.Reg -> gr in dom(rs) -> rs[gr] = pair(nb, T) -> T in bits(64) -> base in omega ->
  tr.code_okn(fptr, n, fr, cb, cc, st) -> (int_mod(fr, 16) = 8 -> tr.sal16(s)) -> abi.loaded(s.vm, cb, cc, st) -> cb in omega ->
  tr.cfr(fr) -> seq_len(args) = n -> n in omega -> int_le(n, 6) ->
  fptr in fn_space(bits(64), fn_space(abi.ARGS, powerset(univ(1)))) ->
  (all m. tr.regs(m, rs) -> tr.args_in(m, args)) -> tr.cs_sub(rc, rs) -> tr.hin(hs, fr) -> fd2 in omega -> int_le(fd2, int_add(fr, 8)) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) ->
  (all t. t in univ(1) -> runs(mkprog(x0 x1. ex x8. dd(t, x8) && k(x8, x1)), w, diverge(t))) ->
  (all w4 r0 r1. w4 in abi.World && w4 in univ(1) -> r0 in bits(64) -> r1 in bits(64) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, fd2, fn_update(fn_update(rc, 0, pair(8, r0)), 2, pair(8, r1)),
    mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. ka(x0, pair(r0, r1), x8) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w4)) ->
  (all z. int_lt(z.gpr[4], int_sub(s.gpr[4], fr)) -> !bkp(z)) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call(fptr[T], args), x0, x9 x10. ka(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
    x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w)
proof
  assume hmn hofr hap hat ha2 hg hgd hgu htb hb hcode hal hld hcb hcf hln hno hn6 hft hreg hsub hhin hfo hfd hk hd hpost hbf
  have a2b: a2 in bits(64) by simp(ha2)
  // (the map's entry at T: its contract, its effects, its type)
  have hct := mp(all_elim(expand(hcode, tr.code_okn), {T}), htb)
  have himp: tr.callee_contract(fr, T, fptr[T], cb, cc, st) by taut(hct)
  have hio: tr.callee_io(fptr[T], n) by taut(hct)
  have hgt: fptr[T] in fn_space(abi.ARGS, powerset(univ(1))) := mp(fn_space_app[a := bits(64), b := fn_space(abi.ARGS, powerset(univ(1))), f := fptr, x := T], hft, htb)
  // (the instruction: the return address a2 pushed, rip T)
  have hst := apply(tr.push_reg[s := s, base := base, code := code, fr := fr, a := a, a2 := a2, len := len, g := gr, z := z, nb := nb, T := T, rs := rs, w := w], hat, ha2, hg, hgd, hgu, hcf)
  // (the push done: the callee runs under its contract)
  have hcl: all m m1 e1 C. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, ds) ->
      runs(x86_64_linux.touch_range(bits_sub(64, m.gpr[4], 8), 8, 1), fn_update(m, "rip", a2), ok(m1, e1)) ->
      C = fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, bits_sub(64, m.gpr[4], 8), 8, a2))),
        "gpr", fn_update(m1.gpr, 4, bits_sub(64, m.gpr[4], 8))), "rip", T) ->
      tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call(fptr[T], args), x0, x9 x10. ka(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1,
        x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, C) proof
    fix m m1 e1 C
    assume hi hr hh hrs hmm hfr tr2 hC2
    have hin := mp(all_elim(hreg, {m}), hrs)
    have hbm: all z. int_lt(z.gpr[4], m.gpr[4]) -> !bkp(z) proof
      fix z
      assume lt
      have rspm := apply(tr.inv_parts, hi).4
      show := mp(all_elim(hbf, {z}), rewrite(rspm, lt))
    qed
    show := apply(tr.callee_sim[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb), g := fptr[T], args := args, a := x9 x10 x8. ka(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)],
      {s}, {v}, {base}, {code}, {fr}, {m}, {w}, {n}, {hs}, {fd2}, {a2}, {T}, {m1}, {e1}, {C}, {cb}, {cc}, {st}, {rs}, {rc}, hap, hofr,
      hi, hcf, hmm, hmn, hb, hrs, hsub, hin, hln, hno, hn6, a2b, htb, tr2, hC2, himp, hal, hld, hcb, hh, hhin, hfo, hfd, hgt, hio, hk, hd, hpost, hbm)
  qed
  show := apply(tr.call_g[s := s, v := v, base := base, code := code, fr := fr, a := a, a2 := a2, T := T, g := fptr[T], args := args, hs := hs, ds := ds, rs := rs, w := w,
    ka := x9 x10 x8. ka(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2),
    bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], hst, a2b, hcf, hk, hcl)
qed
