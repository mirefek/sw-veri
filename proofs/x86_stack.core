// The stack growing (spec/x86_64/memory.sl, `touch` / `grow_stack`): the
// machine stays well-typed -- what a call's push needs for the callee's
// entry state.
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core core/records.core \
//     build/musl_malloc_O0.core proofs/x86.core proofs/x86_code.core proofs/x86_stack.core

// a function updated inside its domain, with a value of its range
theorem x86.space_upd: all a b f k v. f in fn_space(a, b) -> k in a -> v in b -> fn_update(f, k, v) in fn_space(a, b)
proof
  fix a b f k v
  assume hf hk hv
  have fd: is_fun(f) && dom(f) = a by simp(expand(hf, fn_space))
  have vals: all x. x in a -> ite(x = k, v, app(f, x)) in b proof
    fix x
    assume hx
    have c1: x = k -> ite(x = k, v, app(f, x)) in b proof
      assume e
      have t := mp(ite_t[c := x = k, a := v, b := app(f, x)], e)
      show := rewrite(sym(t), hv)
    qed
    have c2: !(x = k) -> ite(x = k, v, app(f, x)) in b proof
      assume e
      have t := mp(ite_f[c := x = k, a := v, b := app(f, x)], e)
      have fx := mp(mp(fn_space_app[a := a, b := b, f := f, x := x], hf), hx)
      show := rewrite(sym(t), fx)
    qed
    show by taut(c1, c2)
  qed
  have sp := mp(fn_build_space[d := a, v := x. ite(x = k, v, app(f, x)), b := b], vals)
  // (the update is that function)
  have gk: ite(k = k, v, app(f, k)) = v := mp(ite_t[c := k = k, a := v, b := app(f, k)], refl({k}))
  have go: all x. x in a -> !(x = k) -> ite(x = k, v, app(f, x)) = app(f, x) proof
    fix x
    assume hx e
    show := mp(ite_f[c := x = k, a := v, b := app(f, x)], e)
  qed
  have ub := mp(mp(mp(fn_update_build[d := a, f := x. app(f, x), g := x. ite(x = k, v, app(f, x)), k := k, w := v], hk), gk), go)
  have e := mp(mp(fn_eta[f := f, d := a], taut(fd)), taut(fd))
  have ub2 := rewrite(e, ub)
  show := rewrite(sym(ub2), sp)
qed

// a memory with one page entry set (a page or none) is a memory
theorem x86.vm_page_set: all vm i w. vm in x86_64_linux.Vm -> vm in univ(1) -> i in omega -> int_lt(i, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) ->
  w in option(x86_64_linux.Page) -> w in univ(1) ->
  fn_update(vm, "pages", fn_update(app(vm, "pages"), i, w)) in x86_64_linux.Vm && fn_update(vm, "pages", fn_update(app(vm, "pages"), i, w)) in univ(1)
proof
  fix vm i w
  assume h hu hi hl hw hwu
  have ht: is_fun(vm) && dom(vm) = insert("pages", insert("bytes", insert("stack_top", insert("stack_limit", insert("brk_start", insert("brk", empty)))))) &&
    app(vm, "pages") in fn_space(set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))), option(x86_64_linux.Page)) by simp(expand(h, x86_64_linux.Vm))
  have pt: app(vm, "pages") in fn_space(set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))), option(x86_64_linux.Page)) by taut(ht)
  have id: i in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) by simp(hi, hl)
  have sp := apply(x86.space_upd, {set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)))}, {option(x86_64_linux.Page)}, {app(vm, "pages")}, {i}, {w}, pt, id, hw)
  have pu := mp(app_univ[u := 1, f := vm, k := "pages"], hu)
  have iu := mp(mp(univ_trans[u := 1, a := i, b := omega], omega_univ), hi)
  have nu: fn_update(vm, "pages", fn_update(app(vm, "pages"), i, w)) in univ(1) by simp(hu, pu, hwu, iu)
  have hf: is_fun(vm) by taut(ht)
  have pd: "pages" in dom(vm) by simp(ht)
  have fuf := mp(fn_update_fun[f := vm, k := "pages", v := fn_update(app(vm, "pages"), i, w)], hf)
  have fud := mp(mp(fn_update_dom[f := vm, k := "pages", v := fn_update(app(vm, "pages"), i, w)], hf), pd)
  have dv: dom(vm) = insert("pages", insert("bytes", insert("stack_top", insert("stack_limit", insert("brk_start", insert("brk", empty)))))) by taut(ht)
  have pv: ((((((is_fun(fn_update(vm, "pages", fn_update(app(vm, "pages"), i, w))) && dom(fn_update(vm, "pages", fn_update(app(vm, "pages"), i, w))) = insert("pages", insert("bytes", insert("stack_top", insert("stack_limit", insert("brk_start", insert("brk", empty))))))) && app(fn_update(vm, "pages", fn_update(app(vm, "pages"), i, w)), "pages") in fn_space(set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))), option(x86_64_linux.Page))) && app(fn_update(vm, "pages", fn_update(app(vm, "pages"), i, w)), "bytes") in fn_space(bits(64), bits(8))) && app(fn_update(vm, "pages", fn_update(app(vm, "pages"), i, w)), "stack_top") in bits(64)) && app(fn_update(vm, "pages", fn_update(app(vm, "pages"), i, w)), "stack_limit") in omega) && app(fn_update(vm, "pages", fn_update(app(vm, "pages"), i, w)), "brk_start") in bits(64)) && app(fn_update(vm, "pages", fn_update(app(vm, "pages"), i, w)), "brk") in bits(64)
    by simp(expand(h, x86_64_linux.Vm), sp, fuf, fud, dv)
  have r := mp(mp(mp(mp(rec_type_intro[u := 1, k := insert("pages", insert("bytes", insert("stack_top", insert("stack_limit", insert("brk_start", insert("brk", empty)))))), p := x0. ((((((is_fun(x0) && dom(x0) = insert("pages", insert("bytes", insert("stack_top", insert("stack_limit", insert("brk_start", insert("brk", empty))))))) && app(x0, "pages") in fn_space(set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))), option(x86_64_linux.Page))) && app(x0, "bytes") in fn_space(bits(64), bits(8))) && app(x0, "stack_top") in bits(64)) && app(x0, "stack_limit") in omega) && app(x0, "brk_start") in bits(64)) && app(x0, "brk") in bits(64), r := fn_update(vm, "pages", fn_update(app(vm, "pages"), i, w))], nu), fuf), trans(fud, dv)), pv)
  have rv: fn_update(vm, "pages", fn_update(app(vm, "pages"), i, w)) in x86_64_linux.Vm by defs(r, x86_64_linux.Vm)
  show by taut(rv, nu)
qed

// ... and with a page table put in
theorem x86.vm_pages_put: all vm pg. vm in x86_64_linux.Vm -> vm in univ(1) ->
  pg in fn_space(set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))), option(x86_64_linux.Page)) -> pg in univ(1) ->
  fn_update(vm, "pages", pg) in x86_64_linux.Vm && fn_update(vm, "pages", pg) in univ(1)
proof
  fix vm pg
  assume h hu hp hpu
  have ht: is_fun(vm) && dom(vm) = insert("pages", insert("bytes", insert("stack_top", insert("stack_limit", insert("brk_start", insert("brk", empty)))))) by simp(expand(h, x86_64_linux.Vm))
  have nu: fn_update(vm, "pages", pg) in univ(1) by simp(hu, hpu)
  have hf: is_fun(vm) by taut(ht)
  have pd: "pages" in dom(vm) by simp(ht)
  have fuf := mp(fn_update_fun[f := vm, k := "pages", v := pg], hf)
  have fud := mp(mp(fn_update_dom[f := vm, k := "pages", v := pg], hf), pd)
  have dv: dom(vm) = insert("pages", insert("bytes", insert("stack_top", insert("stack_limit", insert("brk_start", insert("brk", empty)))))) by taut(ht)
  have pv: ((((((is_fun(fn_update(vm, "pages", pg)) && dom(fn_update(vm, "pages", pg)) = insert("pages", insert("bytes", insert("stack_top", insert("stack_limit", insert("brk_start", insert("brk", empty))))))) && app(fn_update(vm, "pages", pg), "pages") in fn_space(set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))), option(x86_64_linux.Page))) && app(fn_update(vm, "pages", pg), "bytes") in fn_space(bits(64), bits(8))) && app(fn_update(vm, "pages", pg), "stack_top") in bits(64)) && app(fn_update(vm, "pages", pg), "stack_limit") in omega) && app(fn_update(vm, "pages", pg), "brk_start") in bits(64)) && app(fn_update(vm, "pages", pg), "brk") in bits(64)
    by simp(expand(h, x86_64_linux.Vm), hp, fuf, fud, dv)
  have r := mp(mp(mp(mp(rec_type_intro[u := 1, k := insert("pages", insert("bytes", insert("stack_top", insert("stack_limit", insert("brk_start", insert("brk", empty)))))), p := x0. ((((((is_fun(x0) && dom(x0) = insert("pages", insert("bytes", insert("stack_top", insert("stack_limit", insert("brk_start", insert("brk", empty))))))) && app(x0, "pages") in fn_space(set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))), option(x86_64_linux.Page))) && app(x0, "bytes") in fn_space(bits(64), bits(8))) && app(x0, "stack_top") in bits(64)) && app(x0, "stack_limit") in omega) && app(x0, "brk_start") in bits(64)) && app(x0, "brk") in bits(64), r := fn_update(vm, "pages", pg)], nu), fuf), trans(fud, dv)), pv)
  have rv: fn_update(vm, "pages", pg) in x86_64_linux.Vm by defs(r, x86_64_linux.Vm)
  show by taut(rv, nu)
qed

// ... and with one byte set
theorem x86.vm_byte_set: all vm b w. vm in x86_64_linux.Vm -> vm in univ(1) -> b in bits(64) -> w in bits(8) ->
  fn_update(vm, "bytes", fn_update(app(vm, "bytes"), b, w)) in x86_64_linux.Vm && fn_update(vm, "bytes", fn_update(app(vm, "bytes"), b, w)) in univ(1)
proof
  fix vm b w
  assume h hu hb hw
  have ht: is_fun(vm) && dom(vm) = insert("pages", insert("bytes", insert("stack_top", insert("stack_limit", insert("brk_start", insert("brk", empty)))))) &&
    app(vm, "bytes") in fn_space(bits(64), bits(8)) by simp(expand(h, x86_64_linux.Vm))
  have bt: app(vm, "bytes") in fn_space(bits(64), bits(8)) by taut(ht)
  have sp := apply(x86.space_upd, {bits(64)}, {bits(8)}, {app(vm, "bytes")}, {b}, {w}, bt, hb, hw)
  have bu := mp(app_univ[u := 1, f := vm, k := "bytes"], hu)
  have wu := mp(mp(univ_trans[u := 1, a := w, b := bits(8)], bits_univ[n := 8]), hw)
  have nu: fn_update(vm, "bytes", fn_update(app(vm, "bytes"), b, w)) in univ(1) by simp(hu, bu, wu, hb)
  have hf: is_fun(vm) by taut(ht)
  have bd: "bytes" in dom(vm) by simp(ht)
  have fuf := mp(fn_update_fun[f := vm, k := "bytes", v := fn_update(app(vm, "bytes"), b, w)], hf)
  have fud := mp(mp(fn_update_dom[f := vm, k := "bytes", v := fn_update(app(vm, "bytes"), b, w)], hf), bd)
  have dv: dom(vm) = insert("pages", insert("bytes", insert("stack_top", insert("stack_limit", insert("brk_start", insert("brk", empty)))))) by taut(ht)
  have pv: ((((((is_fun(fn_update(vm, "bytes", fn_update(app(vm, "bytes"), b, w))) && dom(fn_update(vm, "bytes", fn_update(app(vm, "bytes"), b, w))) = insert("pages", insert("bytes", insert("stack_top", insert("stack_limit", insert("brk_start", insert("brk", empty))))))) && app(fn_update(vm, "bytes", fn_update(app(vm, "bytes"), b, w)), "pages") in fn_space(set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))), option(x86_64_linux.Page))) && app(fn_update(vm, "bytes", fn_update(app(vm, "bytes"), b, w)), "bytes") in fn_space(bits(64), bits(8))) && app(fn_update(vm, "bytes", fn_update(app(vm, "bytes"), b, w)), "stack_top") in bits(64)) && app(fn_update(vm, "bytes", fn_update(app(vm, "bytes"), b, w)), "stack_limit") in omega) && app(fn_update(vm, "bytes", fn_update(app(vm, "bytes"), b, w)), "brk_start") in bits(64)) && app(fn_update(vm, "bytes", fn_update(app(vm, "bytes"), b, w)), "brk") in bits(64)
    by simp(expand(h, x86_64_linux.Vm), sp, fuf, fud, dv)
  have r := mp(mp(mp(mp(rec_type_intro[u := 1, k := insert("pages", insert("bytes", insert("stack_top", insert("stack_limit", insert("brk_start", insert("brk", empty)))))), p := x0. ((((((is_fun(x0) && dom(x0) = insert("pages", insert("bytes", insert("stack_top", insert("stack_limit", insert("brk_start", insert("brk", empty))))))) && app(x0, "pages") in fn_space(set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))), option(x86_64_linux.Page))) && app(x0, "bytes") in fn_space(bits(64), bits(8))) && app(x0, "stack_top") in bits(64)) && app(x0, "stack_limit") in omega) && app(x0, "brk_start") in bits(64)) && app(x0, "brk") in bits(64), r := fn_update(vm, "bytes", fn_update(app(vm, "bytes"), b, w))], nu), fuf), trans(fud, dv)), pv)
  have rv: fn_update(vm, "bytes", fn_update(app(vm, "bytes"), b, w)) in x86_64_linux.Vm by defs(r, x86_64_linux.Vm)
  show by taut(rv, nu)
qed

// the next mapped page, when there is one, is a page number
theorem x86.next_mapped_in: all vm p. !(x86_64_linux.next_mapped(vm, p) = none) ->
  snd(x86_64_linux.next_mapped(vm, p)) in omega && int_lt(snd(x86_64_linux.next_mapped(vm, p)), int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) &&
  int_le(p, snd(x86_64_linux.next_mapped(vm, p)))
proof
  fix vm p
  assume hn
  have c1: !(ex x. x in omega && (int_le(p, x) && x86_64_linux.mapped(vm, x))) -> false proof
    assume ne
    have it := mp(ite_f[c := ex x. x in omega && (int_le(p, x) && x86_64_linux.mapped(vm, x)), a := some(int_min(set_select(omega, x. int_le(p, x) && x86_64_linux.mapped(vm, x)))), b := none], ne)
    have e: x86_64_linux.next_mapped(vm, p) = none by defs(it, x86_64_linux.next_mapped)
    show by taut(e, hn)
  qed
  have ex: ex x. x in omega && (int_le(p, x) && x86_64_linux.mapped(vm, x)) by taut(c1)
  have it := mp(ite_t[c := ex x. x in omega && (int_le(p, x) && x86_64_linux.mapped(vm, x)), a := some(int_min(set_select(omega, x. int_le(p, x) && x86_64_linux.mapped(vm, x)))), b := none], ex)
  have e: x86_64_linux.next_mapped(vm, p) = some(int_min(set_select(omega, x. int_le(p, x) && x86_64_linux.mapped(vm, x)))) by defs(it, x86_64_linux.next_mapped)
  obtain j, hj from ex
  have ms := mp(mp(int_min_spec[p := x. int_le(p, x) && x86_64_linux.mapped(vm, x), a := j], taut(hj)), taut(hj))
  have mo: int_min(set_select(omega, x. int_le(p, x) && x86_64_linux.mapped(vm, x))) in omega by taut(ms)
  have mm: x86_64_linux.mapped(vm, int_min(set_select(omega, x. int_le(p, x) && x86_64_linux.mapped(vm, x)))) by taut(ms)
  have mq: all q. x86_64_linux.mapped(vm, q) -> int_lt(q, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) proof
    fix q
    assume h
    show by simp(expand(h, x86_64_linux.mapped))
  qed
  have ml := mp(all_elim(mq, {int_min(set_select(omega, x. int_le(p, x) && x86_64_linux.mapped(vm, x)))}), mm)
  have mp0: int_le(p, int_min(set_select(omega, x. int_le(p, x) && x86_64_linux.mapped(vm, x)))) by taut(ms)
  show by simp(e, mo, ml, mp0)
qed

// a memory's page table, and an entry of it
theorem x86.vm_pages_typed: all vm. vm in x86_64_linux.Vm ->
  app(vm, "pages") in fn_space(set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))), option(x86_64_linux.Page))
proof
  fix vm
  assume h
  show by simp(expand(h, x86_64_linux.Vm))
qed

theorem x86.vm_page_at: all vm q. vm in x86_64_linux.Vm -> q in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) ->
  app(app(vm, "pages"), q) in option(x86_64_linux.Page)
proof
  fix vm q
  assume h hq
  show := mp(mp(fn_space_app[a := set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))), b := option(x86_64_linux.Page), f := app(vm, "pages"), x := q], apply(x86.vm_pages_typed, {vm}, h)), hq)
qed

// growing the stack keeps the memory typed
theorem x86.grow_stack_typed: all m a p m1 e. app(m, "vm") in x86_64_linux.Vm -> m in univ(1) -> p in omega ->
  runs(x86_64_linux.grow_stack(a, p), m, ok(m1, e)) -> app(m1, "vm") in x86_64_linux.Vm && m1 in univ(1)
proof
  fix m a p m1 e
  assume hv hmu
  have hu := mp(app_univ[u := 1, f := m, k := "vm"], hmu)
  assume hp h
  have nq := all_elim(all_elim(x86.next_mapped_in, {app(m, "vm")}), {p})
  // (the pages copied to, and the one copied: page numbers)
  have nq2: !(x86_64_linux.next_mapped(app(m, "vm"), p) = none) -> all i. i in omega -> int_lt(i, snd(x86_64_linux.next_mapped(app(m, "vm"), p))) ->
    i in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) proof
    assume hn
    have q := mp(nq, hn)
    fix i
    assume hi hl
    have l2: int_lt(i, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) by arith(q, hi, hl)
    show by simp(hi, l2)
  qed
  have nq3: !(x86_64_linux.next_mapped(app(m, "vm"), p) = none) ->
    snd(x86_64_linux.next_mapped(app(m, "vm"), p)) in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) proof
    assume hn
    show by simp(mp(nq, hn))
  qed
  show by simp(h, hv, hu, hmu, hp, nq2, nq3, x86.prev_mapped_cases, x86.space_upd, x86.vm_pages_typed, x86.vm_page_at, keep(x86_64_linux.Vm, x86_64_linux.mapped, x86_64_linux.next_mapped, x86_64_linux.prev_mapped, x86_64_linux.run_end),
    {l0 l. app(fst(l), "vm") in x86_64_linux.Vm && l in univ(1) && fst(l) in univ(1) && snd(l) in omega && int_le(p, snd(l))},
    {l0 l. app(fst(l), "vm") in x86_64_linux.Vm && l in univ(1) && fst(l) in univ(1)})
qed

// ... and so does an access
theorem x86.touch_typed: all m x k m1 e. app(m, "vm") in x86_64_linux.Vm -> m in univ(1) -> x in bits(64) ->
  runs(x86_64_linux.touch(x, k), m, ok(m1, e)) -> app(m1, "vm") in x86_64_linux.Vm && m1 in univ(1)
proof
  fix m x k m1 e
  assume hv hmu hx h
  have po: x86_64_linux.page_of(x) in omega by defs(simp(hx), x86_64_linux.page_of)
  show by simp(h, hv, hmu, po, x86.grow_stack_typed, keep(x86_64_linux.Vm, x86_64_linux.grow_stack, x86_64_linux.mapped, x86_64_linux.page_of))
qed

// ... and a range of them
theorem x86.touch_range_vm_typed: all m a n k m1 e. app(m, "vm") in x86_64_linux.Vm -> m in univ(1) ->
  runs(x86_64_linux.touch_range(a, n, k), m, ok(m1, e)) -> app(m1, "vm") in x86_64_linux.Vm && m1 in univ(1)
proof
  fix m a n k m1 e
  assume hv hmu h
  show by simp(h, hv, hmu, x86.touch_typed, keep(x86_64_linux.Vm, x86_64_linux.touch),
    {l0 l. app(fst(l), "vm") in x86_64_linux.Vm && l in univ(1) && fst(l) in univ(1)})
qed

// a machine with a memory put in is a machine
theorem x86.mach_vm: all m v. m in x86_64_linux.Machine -> m in univ(1) -> v in x86_64_linux.Vm -> v in univ(1) ->
  fn_update(m, "vm", v) in x86_64_linux.Machine && fn_update(m, "vm", v) in univ(1)
proof
  fix m v
  assume hM hu hv hvu
  have mM: fn_update(m, "vm", v) in x86_64_linux.Machine by defs(simp(expand(hM, x86_64_linux.Machine), hu, hv, hvu), x86_64_linux.Machine)
  have mu: fn_update(m, "vm", v) in univ(1) by simp(hu, hvu)
  show by taut(mM, mu)
qed

// a range of accesses keeps the machine typed
theorem x86.touch_range_typed: all m a n k m1 e. m in x86_64_linux.Machine -> m in univ(1) ->
  runs(x86_64_linux.touch_range(a, n, k), m, ok(m1, e)) -> m1 in x86_64_linux.Machine && m1 in univ(1)
proof
  fix m a n k m1 e
  assume hM hu h
  have vm: app(m, "vm") in x86_64_linux.Vm by simp(expand(hM, x86_64_linux.Machine))
  have t := apply(x86.touch_range_vm_typed, {m}, {a}, {n}, {k}, {m1}, {e}, vm, hu, h)
  have c := apply(x86.touch_range_vm, {m}, {a}, {n}, {k}, {m1}, {e}, h)
  have c1: m1 = m -> m1 in x86_64_linux.Machine && m1 in univ(1) proof
    assume e1
    show by simp(e1, hM, hu)
  qed
  have c2: (ex v. m1 = fn_update(m, "vm", v)) -> m1 in x86_64_linux.Machine && m1 in univ(1) proof
    assume ev
    obtain v, hv from ev
    have t2 := rewrite(hv, t)
    have au := mp(app_univ[u := 1, f := fn_update(m, "vm", v), k := "vm"], taut(t2))
    have tv: v in x86_64_linux.Vm && v in univ(1) by simp(t2, au)
    have mv := apply(x86.mach_vm, {m}, {v}, hM, hu, taut(tv), taut(tv))
    show := rewrite(sym(hv), mv)
  qed
  show by taut(c, c1, c2)
qed

// ----------------------------------------------------------------------
//  Where the stack grows: the page entries of v1 those of v0 but for
//  pages unmapped in v0 in [l, r) -- below a mapped page r, from the lowest
//  page touched l (a push: GIMPLE's frame at a call may have them)

def x86.pages_in(v0, v1, l, r) := all p. p in omega ->
  app(app(v1, "pages"), p) = app(app(v0, "pages"), p) || (app(app(v0, "pages"), p) = none && int_le(l, p) && int_lt(p, r))

theorem x86.pages_in_refl: all v l r. x86.pages_in(v, v, l, r)
proof
  fix v l r
  show by defs(simp(), x86.pages_in)
qed

theorem x86.pages_in_trans: all v0 v1 v2 l r. x86.pages_in(v0, v1, l, r) -> x86.pages_in(v1, v2, l, r) -> x86.pages_in(v0, v2, l, r)
proof
  fix v0 v1 v2 l r
  assume h1 h2
  have g: all p. p in omega ->
      app(app(v2, "pages"), p) = app(app(v0, "pages"), p) || (app(app(v0, "pages"), p) = none && int_le(l, p) && int_lt(p, r)) proof
    fix p
    assume hp
    have a1 := mp(all_elim(expand(h1, x86.pages_in), {p}), hp)
    have a2 := mp(all_elim(expand(h2, x86.pages_in), {p}), hp)
    have c1: app(app(v2, "pages"), p) = app(app(v1, "pages"), p) ->
        app(app(v2, "pages"), p) = app(app(v0, "pages"), p) || (app(app(v0, "pages"), p) = none && int_le(l, p) && int_lt(p, r)) proof
      assume e
      show by simp(e, a1)
    qed
    have c2: (app(app(v1, "pages"), p) = none && int_le(l, p) && int_lt(p, r)) ->
        app(app(v2, "pages"), p) = app(app(v0, "pages"), p) || (app(app(v0, "pages"), p) = none && int_le(l, p) && int_lt(p, r)) proof
      assume e
      have n1: app(app(v1, "pages"), p) = none by taut(e)
      have c3: app(app(v1, "pages"), p) = app(app(v0, "pages"), p) -> app(app(v0, "pages"), p) = none proof
        assume e3
        show := trans(sym(e3), n1)
      qed
      show by taut(a1, c3, e)
    qed
    show by taut(a2, c1, c2)
  qed
  show by defs(g, x86.pages_in)
qed

// (a step of the growth: a page unmapped in v0, in the range, set)
theorem x86.pages_in_set: all v0 v1 l r i w. x86.pages_in(v0, v1, l, r) -> i in omega -> int_le(l, i) -> int_lt(i, r) -> app(app(v0, "pages"), i) = none ->
  x86.pages_in(v0, fn_update(v1, "pages", fn_update(app(v1, "pages"), i, w)), l, r)
proof
  fix v0 v1 l r i w
  assume h hi hl hr hn
  have g: all p. p in omega -> app(fn_update(app(v1, "pages"), i, w), p) = app(app(v0, "pages"), p) ||
      (app(app(v0, "pages"), p) = none && int_le(l, p) && int_lt(p, r)) proof
    fix p
    assume hp
    have c1: p = i -> app(fn_update(app(v1, "pages"), i, w), p) = app(app(v0, "pages"), p) ||
        (app(app(v0, "pages"), p) = none && int_le(l, p) && int_lt(p, r)) proof
      assume e
      show by simp(e, hn, hl, hr)
    qed
    have c2: !(p = i) -> app(fn_update(app(v1, "pages"), i, w), p) = app(app(v0, "pages"), p) ||
        (app(app(v0, "pages"), p) = none && int_le(l, p) && int_lt(p, r)) proof
      assume e
      have a := mp(app_update_other[f := app(v1, "pages"), k := i, v := w, x := p], e)
      have a1 := mp(all_elim(expand(h, x86.pages_in), {p}), hp)
      show := rewrite(sym(a), a1)
    qed
    show by taut(c1, c2)
  qed
  show by defs(simp(g), x86.pages_in)
qed

// (... and bytes written)
theorem x86.pages_in_byte: all v0 v1 l r b w. x86.pages_in(v0, v1, l, r) ->
  x86.pages_in(v0, fn_update(v1, "bytes", fn_update(app(v1, "bytes"), b, w)), l, r)
proof
  fix v0 v1 l r b w
  assume h
  show by defs(simp(expand(h, x86.pages_in)), x86.pages_in)
qed

// the next mapped page from p is at most a mapped page r >= p
theorem x86.next_mapped_le: all vm p r. p in omega -> r in omega -> int_le(p, r) -> x86_64_linux.mapped(vm, r) ->
  !(x86_64_linux.next_mapped(vm, p) = none) && int_le(snd(x86_64_linux.next_mapped(vm, p)), r)
proof
  fix vm p r
  assume hp hr hle hm
  have c: r in omega && (int_le(p, r) && x86_64_linux.mapped(vm, r)) by taut(hr, hle, hm)
  have ex := ex_intro({r}, {x. x in omega && (int_le(p, x) && x86_64_linux.mapped(vm, x))}, c)
  have it := mp(ite_t[c := ex x. x in omega && (int_le(p, x) && x86_64_linux.mapped(vm, x)), a := some(int_min(set_select(omega, x. int_le(p, x) && x86_64_linux.mapped(vm, x)))), b := none], ex)
  have e: x86_64_linux.next_mapped(vm, p) = some(int_min(set_select(omega, x. int_le(p, x) && x86_64_linux.mapped(vm, x)))) by defs(it, x86_64_linux.next_mapped)
  have pr: int_le(p, r) && x86_64_linux.mapped(vm, r) by taut(hle, hm)
  have ms := mp(mp(int_min_spec[p := x. int_le(p, x) && x86_64_linux.mapped(vm, x), a := r], hr), pr)
  have lw: all y. y in omega -> int_le(p, y) && x86_64_linux.mapped(vm, y) -> int_le(int_min(set_select(omega, x. int_le(p, x) && x86_64_linux.mapped(vm, x))), y) by taut(ms)
  have low := mp(all_elim(lw, {r}), hr, pr)
  show by simp(e, low)
qed

// growing the stack from page p below the mapped page r: pages in [p, r)
theorem x86.grow_pages: all m a p r m1 e. p in omega -> r in omega -> int_le(p, r) -> x86_64_linux.mapped(app(m, "vm"), r) ->
  runs(x86_64_linux.grow_stack(a, p), m, ok(m1, e)) -> x86.pages_in(app(m, "vm"), app(m1, "vm"), p, r)
proof
  fix m a p r m1 e
  assume hp hr hle hm h
  have nl := apply(x86.next_mapped_le, {app(m, "vm")}, {p}, {r}, hp, hr, hle, hm)
  have rt: int_lt(r, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) by taut(expand(hm, x86_64_linux.mapped))
  // (the pages from p below the next mapped one: none)
  have gapn: all i. i in omega -> int_le(p, i) -> int_lt(i, snd(x86_64_linux.next_mapped(app(m, "vm"), p))) -> app(app(app(m, "vm"), "pages"), i) = none proof
    fix i
    assume hi h1 h2
    have nm := apply(x86.next_mapped_gap, {app(m, "vm")}, {p}, {i}, hp, hi, h1, h2)
    have it: int_lt(i, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) by arith(hi, h2, nl, rt)
    show by taut(expand(nm, x86_64_linux.mapped), it)
  qed
  // (... and below r)
  have gapr: all i. i in omega -> int_lt(i, snd(x86_64_linux.next_mapped(app(m, "vm"), p))) -> int_lt(i, r) proof
    fix i
    assume hi h2
    show by arith(h2, nl)
  qed
  have rf := all_elim(x86.pages_in_refl, {app(m, "vm")}, {p}, {r})
  show by simp(h, hp, nl, gapn, gapr, rf, x86.prev_mapped_cases, x86.pages_in_set, x86.pages_in_byte, keep(x86.pages_in, x86_64_linux.mapped, x86_64_linux.next_mapped, x86_64_linux.prev_mapped, x86_64_linux.run_end),
    {l0 l. x86.pages_in(app(m, "vm"), app(fst(l), "vm"), p, r) && snd(l) in omega && int_le(p, snd(l))},
    {l0 l. x86.pages_in(app(m, "vm"), app(fst(l), "vm"), p, r)})
qed

// ... and when it fails: nothing changed
theorem x86.grow_exc: all m a p y e. runs(x86_64_linux.grow_stack(a, p), m, exc(y, e)) -> y = m && e = exc_val("segv", pair(a, 0))
proof
  fix m a p y e
  assume h
  show by simp(h, x86.prev_mapped_cases, keep(x86_64_linux.mapped, x86_64_linux.next_mapped, x86_64_linux.prev_mapped, x86_64_linux.run_end),
    {l0 l. true}, {l0 l. true})
qed

// An access's fault at x in the state y: no mapping (stack growth refused),
// a non-canonical address, or the page mapped without the access allowed
def x86.touch_fault(x, k, y, e) := (e = exc_val("segv", pair(x, 0)) && !x86_64_linux.mapped(app(y, "vm"), x86_64_linux.page_of(x))) || (e = exc_val("segv", pair(0, 2)) && !x86_64_linux.canonical(x)) ||
  ((e = exc_val("segv", pair(x, 1)) || e = exc_val("segv", pair(x, 3))) && !x86_64_linux.can_access(app(y, "vm"), x, k))

// an access below the mapped page r: the pages grown in [page_of(x), r)
theorem x86.touch_ok_pages: all m x k r y e. x in bits(64) -> r in omega -> x86_64_linux.mapped(app(m, "vm"), r) -> int_le(x86_64_linux.page_of(x), r) ->
  runs(x86_64_linux.touch(x, k), m, ok(y, e)) -> x86.pages_in(app(m, "vm"), app(y, "vm"), x86_64_linux.page_of(x), r)
proof
  fix m x k r y e
  assume hx hr hm hle h
  have po: x86_64_linux.page_of(x) in omega by defs(simp(hx), x86_64_linux.page_of)
  have gp := all_elim(x86.grow_pages, {m}, {x}, {x86_64_linux.page_of(x)}, {r})
  have rf := all_elim(x86.pages_in_refl, {app(m, "vm")}, {x86_64_linux.page_of(x)}, {r})
  show by simp(h, po, hr, hle, hm, gp, rf, keep(x86.pages_in, x86_64_linux.grow_stack, x86_64_linux.mapped, x86_64_linux.page_of))
qed

// ... its faults
theorem x86.touch_exc: all m x k r y e. x in bits(64) -> r in omega -> x86_64_linux.mapped(app(m, "vm"), r) -> int_le(x86_64_linux.page_of(x), r) ->
  runs(x86_64_linux.touch(x, k), m, exc(y, e)) ->
  x86.pages_in(app(m, "vm"), app(y, "vm"), x86_64_linux.page_of(x), r) && abi.vm_grows(app(m, "vm"), app(y, "vm")) && x86.touch_fault(x, k, y, e) &&
  (y = m || (ex v. y = fn_update(m, "vm", v)))
proof
  fix m x k r y e
  assume hx hr hm hle h
  have po: x86_64_linux.page_of(x) in omega by defs(simp(hx), x86_64_linux.page_of)
  have gp := all_elim(x86.grow_pages, {m}, {x}, {x86_64_linux.page_of(x)}, {r})
  have rf := all_elim(x86.pages_in_refl, {app(m, "vm")}, {x86_64_linux.page_of(x)}, {r})
  have gr := all_elim(x86.grow_stack_grows, {m}, {x})
  have gv := all_elim(x86.grow_stack_vm, {m}, {x})
  have ge := all_elim(x86.grow_exc, {m}, {x}, {x86_64_linux.page_of(x)})
  have g0 := all_elim(x86.grows_refl, {app(m, "vm")})
  show by defs(simp(h, po, hr, hle, hm, gp, rf, gr, gv, ge, g0, keep(x86.pages_in, abi.vm_grows, x86_64_linux.grow_stack, x86_64_linux.mapped, x86_64_linux.page_of, x86_64_linux.can_access)),
    x86.touch_fault, x86_64_linux.can_access, x86_64_linux.canonical)
qed

// ... typed, as the machine was
theorem x86.touch_exc_typed: all m x k y e. app(m, "vm") in x86_64_linux.Vm -> m in univ(1) -> x in bits(64) ->
  runs(x86_64_linux.touch(x, k), m, exc(y, e)) -> app(y, "vm") in x86_64_linux.Vm && y in univ(1)
proof
  fix m x k y e
  assume hv hmu hx h
  have po: x86_64_linux.page_of(x) in omega by defs(simp(hx), x86_64_linux.page_of)
  have ge := all_elim(x86.grow_exc, {m}, {x}, {x86_64_linux.page_of(x)})
  show by simp(h, hv, hmu, po, ge, x86.grow_stack_typed, keep(x86_64_linux.Vm, x86_64_linux.grow_stack, x86_64_linux.mapped, x86_64_linux.page_of))
qed

// an access ends
theorem x86.touch_nodiv: all m x k t. x in bits(64) -> !runs(x86_64_linux.touch(x, k), m, diverge(t))
proof
  fix m x k t
  assume hx
  have po: x86_64_linux.page_of(x) in omega by defs(simp(hx), x86_64_linux.page_of)
  have g: runs(x86_64_linux.touch(x, k), m, diverge(t)) -> false proof
    assume h
    have nq := all_elim(x86.next_mapped_in, {app(m, "vm")}, {x86_64_linux.page_of(x)})
    show by simp(h, po, nq, x86.prev_mapped_cases, keep(x86_64_linux.mapped, x86_64_linux.next_mapped, x86_64_linux.prev_mapped, x86_64_linux.run_end),
      {l0 l. snd(l) in omega && int_le(snd(l), snd(x86_64_linux.next_mapped(app(m, "vm"), x86_64_linux.page_of(x))))},
      {l. int_sub(snd(x86_64_linux.next_mapped(app(m, "vm"), x86_64_linux.page_of(x))), snd(l))},
      {l0 l. snd(l) in omega && int_le(snd(l), int_mul(snd(x86_64_linux.next_mapped(app(m, "vm"), x86_64_linux.page_of(x))), x86_64_linux.PAGE))},
      {l. int_sub(int_mul(snd(x86_64_linux.next_mapped(app(m, "vm"), x86_64_linux.page_of(x))), x86_64_linux.PAGE), snd(l))})
  qed
  show by taut(g)
qed

// (pages_in: a mapped page stays; a wider range)
theorem x86.pages_in_mapped: all v0 v1 l r q. x86.pages_in(v0, v1, l, r) -> q in omega -> x86_64_linux.mapped(v0, q) -> x86_64_linux.mapped(v1, q)
proof
  fix v0 v1 l r q
  assume h hq hm
  have a := mp(all_elim(expand(h, x86.pages_in), {q}), hq)
  have mm := expand(hm, x86_64_linux.mapped)
  have e: app(app(v1, "pages"), q) = app(app(v0, "pages"), q) by taut(a, mm)
  show by defs(simp(e, mm), x86_64_linux.mapped)
qed

theorem x86.pages_in_widen: all v0 v1 l l2 r. x86.pages_in(v0, v1, l2, r) -> int_le(l, l2) -> x86.pages_in(v0, v1, l, r)
proof
  fix v0 v1 l l2 r
  assume h hl
  have g: all p. p in omega ->
      app(app(v1, "pages"), p) = app(app(v0, "pages"), p) || (app(app(v0, "pages"), p) = none && int_le(l, p) && int_lt(p, r)) proof
    fix p
    assume hp
    have a := mp(all_elim(expand(h, x86.pages_in), {p}), hp)
    have c: int_le(l2, p) -> int_le(l, p) proof
      assume h2
      show by arith(hl, h2)
    qed
    show by taut(a, c)
  qed
  show by defs(g, x86.pages_in)
qed

// A range of accesses whose pages lie in [l, r], r mapped: the pages grown
// in [l, r) -- when it succeeds, and when it faults (at one of its bytes)
def x86.range_below(a, n, l, r) := all j. j in omega -> int_lt(j, n) ->
  int_le(l, x86_64_linux.page_of(bits_add(64, a, bits_of_int(64, j)))) && int_le(x86_64_linux.page_of(bits_add(64, a, bits_of_int(64, j))), r)

theorem x86.touch_range_ok_pages: all m a n k l r y e. r in omega -> x86_64_linux.mapped(app(m, "vm"), r) -> x86.range_below(a, n, l, r) ->
  runs(x86_64_linux.touch_range(a, n, k), m, ok(y, e)) -> x86.pages_in(app(m, "vm"), app(y, "vm"), l, r)
proof
  fix m a n k l r y e
  assume hr hm hb h
  // (one access from a state grown from m)
  have st: all c j c2 e2. j in omega -> int_lt(j, n) -> x86.pages_in(app(m, "vm"), app(c, "vm"), l, r) ->
      runs(x86_64_linux.touch(bits_add(64, a, bits_of_int(64, j)), k), c, ok(c2, e2)) -> x86.pages_in(app(m, "vm"), app(c2, "vm"), l, r) proof
    fix c j c2 e2
    assume hj hjn hc ht
    have bj := mp(all_elim(expand(hb, x86.range_below), {j}), hj, hjn)
    have cm := apply(x86.pages_in_mapped, {app(m, "vm")}, {app(c, "vm")}, {l}, {r}, {r}, hc, hr, hm)
    have xb: bits_add(64, a, bits_of_int(64, j)) in bits(64) by simp()
    have tp := apply(x86.touch_ok_pages, {c}, {bits_add(64, a, bits_of_int(64, j))}, {k}, {r}, {c2}, {e2}, xb, hr, cm, taut(bj), ht)
    have tw := apply(x86.pages_in_widen, {app(c, "vm")}, {app(c2, "vm")}, {l}, {x86_64_linux.page_of(bits_add(64, a, bits_of_int(64, j)))}, {r}, tp, taut(bj))
    show := apply(x86.pages_in_trans, {app(m, "vm")}, {app(c, "vm")}, {app(c2, "vm")}, {l}, {r}, hc, tw)
  qed
  have rf := all_elim(x86.pages_in_refl, {app(m, "vm")}, {l}, {r})
  show by simp(h, rf, st, keep(x86.pages_in, x86_64_linux.touch), {l0 l1. x86.pages_in(app(m, "vm"), app(fst(l1), "vm"), l, r) && snd(l1) in omega})
qed

// (the fault of one of the n accesses from a)
def x86.fault_at(a, n, k, y, e) := ex j. j in omega && int_lt(j, n) && x86.touch_fault(bits_add(64, a, bits_of_int(64, j)), k, y, e)

// (a state reached from m by accesses: grown, typed, only its memory new)
def x86.grown(m, l, r, c) := x86.pages_in(app(m, "vm"), app(c, "vm"), l, r) && abi.vm_grows(app(m, "vm"), app(c, "vm")) &&
  (c = m || (ex v. c = fn_update(m, "vm", v))) && app(c, "vm") in x86_64_linux.Vm && c in univ(1)

theorem x86.touch_range_exc: all m a n k l r y e. app(m, "vm") in x86_64_linux.Vm -> m in univ(1) -> r in omega -> x86_64_linux.mapped(app(m, "vm"), r) ->
  x86.range_below(a, n, l, r) -> runs(x86_64_linux.touch_range(a, n, k), m, exc(y, e)) ->
  x86.grown(m, l, r, y) && x86.fault_at(a, n, k, y, e)
proof
  fix m a n k l r y e
  assume hv hmu hr hm hb h
  // (an access from a grown state: grown again, or the fault)
  have st: all c j c2 e2. j in omega -> int_lt(j, n) -> x86.grown(m, l, r, c) ->
      runs(x86_64_linux.touch(bits_add(64, a, bits_of_int(64, j)), k), c, ok(c2, e2)) -> x86.grown(m, l, r, c2) proof
    fix c j c2 e2
    assume hj hjn hc ht
    have g := expand(hc, x86.grown)
    have bj := mp(all_elim(expand(hb, x86.range_below), {j}), hj, hjn)
    have pc: x86.pages_in(app(m, "vm"), app(c, "vm"), l, r) by taut(g)
    have cm := apply(x86.pages_in_mapped, {app(m, "vm")}, {app(c, "vm")}, {l}, {r}, {r}, pc, hr, hm)
    have xb: bits_add(64, a, bits_of_int(64, j)) in bits(64) by simp()
    have tp := apply(x86.touch_ok_pages, {c}, {bits_add(64, a, bits_of_int(64, j))}, {k}, {r}, {c2}, {e2}, xb, hr, cm, taut(bj), ht)
    have tw := apply(x86.pages_in_widen, {app(c, "vm")}, {app(c2, "vm")}, {l}, {x86_64_linux.page_of(bits_add(64, a, bits_of_int(64, j)))}, {r}, tp, taut(bj))
    have p2 := apply(x86.pages_in_trans, {app(m, "vm")}, {app(c, "vm")}, {app(c2, "vm")}, {l}, {r}, pc, tw)
    have tf := apply(x86.touch_frame, {c}, {bits_add(64, a, bits_of_int(64, j))}, {k}, {c2}, {e2}, xb, ht)
    have gc: abi.vm_grows(app(m, "vm"), app(c, "vm")) by taut(g)
    have g2 := apply(x86.grows_trans, {app(m, "vm")}, {app(c, "vm")}, {app(c2, "vm")}, gc, tf)
    have tv := apply(x86.touch_vm, {c}, {bits_add(64, a, bits_of_int(64, j))}, {k}, {c2}, {e2}, ht)
    have cf: c = m || (ex v. c = fn_update(m, "vm", v)) by taut(g)
    have f2: c2 = m || (ex v. c2 = fn_update(m, "vm", v)) by simp(cf, tv)
    have ty := apply(x86.touch_typed, {c}, {bits_add(64, a, bits_of_int(64, j))}, {k}, {c2}, {e2}, taut(g), taut(g), xb, ht)
    show by defs(taut(p2, g2, f2, ty), x86.grown)
  qed
  have sx: all c j. j in omega -> int_lt(j, n) -> x86.grown(m, l, r, c) ->
      runs(x86_64_linux.touch(bits_add(64, a, bits_of_int(64, j)), k), c, exc(y, e)) -> x86.grown(m, l, r, y) && x86.fault_at(a, n, k, y, e) proof
    fix c j
    assume hj hjn hc ht
    have g := expand(hc, x86.grown)
    have bj := mp(all_elim(expand(hb, x86.range_below), {j}), hj, hjn)
    have pc: x86.pages_in(app(m, "vm"), app(c, "vm"), l, r) by taut(g)
    have cm := apply(x86.pages_in_mapped, {app(m, "vm")}, {app(c, "vm")}, {l}, {r}, {r}, pc, hr, hm)
    have xb: bits_add(64, a, bits_of_int(64, j)) in bits(64) by simp()
    have te := apply(x86.touch_exc, {c}, {bits_add(64, a, bits_of_int(64, j))}, {k}, {r}, {y}, {e}, xb, hr, cm, taut(bj), ht)
    have tw := apply(x86.pages_in_widen, {app(c, "vm")}, {app(y, "vm")}, {l}, {x86_64_linux.page_of(bits_add(64, a, bits_of_int(64, j)))}, {r}, taut(te), taut(bj))
    have p2 := apply(x86.pages_in_trans, {app(m, "vm")}, {app(c, "vm")}, {app(y, "vm")}, {l}, {r}, pc, tw)
    have gc: abi.vm_grows(app(m, "vm"), app(c, "vm")) by taut(g)
    have g2 := apply(x86.grows_trans, {app(m, "vm")}, {app(c, "vm")}, {app(y, "vm")}, gc, taut(te))
    have cf: c = m || (ex v. c = fn_update(m, "vm", v)) by taut(g)
    have yf: y = c || (ex v. y = fn_update(c, "vm", v)) by taut(te)
    have f2: y = m || (ex v. y = fn_update(m, "vm", v)) by simp(cf, yf)
    have ty := apply(x86.touch_exc_typed, {c}, {bits_add(64, a, bits_of_int(64, j))}, {k}, {y}, {e}, taut(g), taut(g), xb, ht)
    have tfa: x86.touch_fault(bits_add(64, a, bits_of_int(64, j)), k, y, e) by taut(te)
    have fa: x86.fault_at(a, n, k, y, e) by defs(ex_intro({j}, taut(hj, hjn, tfa)), x86.fault_at)
    have gy: x86.grown(m, l, r, y) by defs(taut(p2, g2, f2, ty), x86.grown)
    show by taut(gy, fa)
  qed
  have rf := all_elim(x86.pages_in_refl, {app(m, "vm")}, {l}, {r})
  have g0 := all_elim(x86.grows_refl, {app(m, "vm")})
  have mm: m = m := refl({m})
  have gm: x86.grown(m, l, r, m) by defs(taut(rf, g0, hv, hmu, mm), x86.grown)
  show by simp(h, gm, st, sx, keep(x86.grown, x86.fault_at, x86_64_linux.touch), {l0 l1. x86.grown(m, l, r, fst(l1)) && snd(l1) in omega})
qed

// a range of accesses ends
theorem x86.touch_range_nodiv: all m a n k t. n in omega -> !runs(x86_64_linux.touch_range(a, n, k), m, diverge(t))
proof
  fix m a n k t
  assume hn
  have nd: all c j t2. !runs(x86_64_linux.touch(bits_add(64, a, bits_of_int(64, j)), k), c, diverge(t2)) proof
    fix c j t2
    have xb: bits_add(64, a, bits_of_int(64, j)) in bits(64) by simp()
    show := apply(x86.touch_nodiv, {c}, {bits_add(64, a, bits_of_int(64, j))}, {k}, {t2}, xb)
  qed
  have g: runs(x86_64_linux.touch_range(a, n, k), m, diverge(t)) -> false proof
    assume h
    show by simp(h, hn, nd, keep(x86_64_linux.touch), {l0 l1. snd(l1) in omega && int_le(snd(l1), n)}, {l1. int_sub(n, snd(l1))})
  qed
  show by taut(g)
qed

// a grown state: a machine, m's but for its memory
theorem x86.grown_typed: all m l r c. m in x86_64_linux.Machine -> m in univ(1) -> x86.grown(m, l, r, c) ->
  cM: c in x86_64_linux.Machine && cu: c in univ(1) && cos: app(c, "os") = app(m, "os") && cgpr: app(c, "gpr") = app(m, "gpr") && crip: app(c, "rip") = app(m, "rip") &&
  cfl: app(c, "flags") = app(m, "flags") && ccpu: app(c, "cpu") = app(m, "cpu") && cfs: app(c, "fs_base") = app(m, "fs_base") && cgs: app(c, "gs_base") = app(m, "gs_base")
proof
  fix m l r c
  assume hM hu hg
  have g := expand(hg, x86.grown)
  have c1: c = m -> c in x86_64_linux.Machine && c in univ(1) && app(c, "os") = app(m, "os") && app(c, "gpr") = app(m, "gpr") && app(c, "rip") = app(m, "rip") &&
      app(c, "flags") = app(m, "flags") && app(c, "cpu") = app(m, "cpu") && app(c, "fs_base") = app(m, "fs_base") && app(c, "gs_base") = app(m, "gs_base") proof
    assume e
    show by simp(e, hM, hu)
  qed
  have c2: (ex v. c = fn_update(m, "vm", v)) -> c in x86_64_linux.Machine && c in univ(1) && app(c, "os") = app(m, "os") && app(c, "gpr") = app(m, "gpr") && app(c, "rip") = app(m, "rip") &&
      app(c, "flags") = app(m, "flags") && app(c, "cpu") = app(m, "cpu") && app(c, "fs_base") = app(m, "fs_base") && app(c, "gs_base") = app(m, "gs_base") proof
    assume ev
    obtain v, hv from ev
    have t: app(c, "vm") in x86_64_linux.Vm && c in univ(1) by taut(g)
    have t2 := rewrite(hv, t)
    have au := mp(app_univ[u := 1, f := fn_update(m, "vm", v), k := "vm"], taut(t2))
    have tv: v in x86_64_linux.Vm && v in univ(1) by simp(t2, au)
    have mv := apply(x86.mach_vm, {m}, {v}, hM, hu, taut(tv), taut(tv))
    have mc := rewrite(sym(hv), mv)
    have fs: app(c, "os") = app(m, "os") && app(c, "gpr") = app(m, "gpr") && app(c, "rip") = app(m, "rip") &&
      app(c, "flags") = app(m, "flags") && app(c, "cpu") = app(m, "cpu") && app(c, "fs_base") = app(m, "fs_base") && app(c, "gs_base") = app(m, "gs_base") by simp(hv)
    show by taut(mc, fs)
  qed
  show by taut(g, c1, c2)
qed

// (the memory's other fields: as they were)
def x86.vm_fields(v0, v1) := app(v1, "stack_top") = app(v0, "stack_top") && app(v1, "stack_limit") = app(v0, "stack_limit") &&
  app(v1, "brk_start") = app(v0, "brk_start") && app(v1, "brk") = app(v0, "brk")

theorem x86.grow_fields: all m a p m1 e. runs(x86_64_linux.grow_stack(a, p), m, ok(m1, e)) -> x86.vm_fields(app(m, "vm"), app(m1, "vm"))
proof
  fix m a p m1 e
  assume h
  show by defs(simp(h, x86.prev_mapped_cases, keep(x86_64_linux.mapped, x86_64_linux.next_mapped, x86_64_linux.prev_mapped, x86_64_linux.run_end),
    {l0 l. app(app(fst(l), "vm"), "stack_top") = app(app(m, "vm"), "stack_top") && app(app(fst(l), "vm"), "stack_limit") = app(app(m, "vm"), "stack_limit") &&
      app(app(fst(l), "vm"), "brk_start") = app(app(m, "vm"), "brk_start") && app(app(fst(l), "vm"), "brk") = app(app(m, "vm"), "brk")},
    {l0 l. app(app(fst(l), "vm"), "stack_top") = app(app(m, "vm"), "stack_top") && app(app(fst(l), "vm"), "stack_limit") = app(app(m, "vm"), "stack_limit") &&
      app(app(fst(l), "vm"), "brk_start") = app(app(m, "vm"), "brk_start") && app(app(fst(l), "vm"), "brk") = app(app(m, "vm"), "brk")}), x86.vm_fields)
qed

theorem x86.touch_fields: all m x k m1 e. runs(x86_64_linux.touch(x, k), m, ok(m1, e)) -> x86.vm_fields(app(m, "vm"), app(m1, "vm"))
proof
  fix m x k m1 e
  assume h
  have gf := all_elim(x86.grow_fields, {m}, {x})
  show by defs(simp(h, expand(gf, x86.vm_fields), keep(x86_64_linux.grow_stack, x86_64_linux.mapped)), x86.vm_fields)
qed

theorem x86.touch_range_fields: all m a n k m1 e. runs(x86_64_linux.touch_range(a, n, k), m, ok(m1, e)) -> x86.vm_fields(app(m, "vm"), app(m1, "vm"))
proof
  fix m a n k m1 e
  assume h
  have st: all c x c2 e2. x86.vm_fields(app(m, "vm"), app(c, "vm")) -> runs(x86_64_linux.touch(x, k), c, ok(c2, e2)) -> x86.vm_fields(app(m, "vm"), app(c2, "vm")) proof
    fix c x c2 e2
    assume hc ht
    have t := apply(x86.touch_fields, {c}, {x}, {k}, {c2}, {e2}, ht)
    show by defs(simp(expand(hc, x86.vm_fields), expand(t, x86.vm_fields)), x86.vm_fields)
  qed
  have r0: x86.vm_fields(app(m, "vm"), app(m, "vm")) by defs(simp(), x86.vm_fields)
  show by simp(h, r0, st, keep(x86.vm_fields, x86_64_linux.touch), {l0 l1. x86.vm_fields(app(m, "vm"), app(fst(l1), "vm"))})
qed

// (a page table P from P0 with pages below Q set to Q's entry PQ)
def x86.gstk(P, P0, Q, PQ) := (all i. i in omega -> app(P, i) = app(P0, i) || (int_lt(i, Q) && app(P, i) = PQ)) && app(P, Q) = PQ

theorem x86.gstk_step: all P P0 Q PQ k. x86.gstk(P, P0, Q, PQ) -> k in omega -> int_lt(k, Q) -> x86.gstk(fn_update(P, k, app(P, Q)), P0, Q, PQ)
proof
  fix P P0 Q PQ k
  assume h hk hl
  have a1 a2 := expand(h, x86.gstk)
  have kq: !(Q = k) proof
    have c: Q = k -> false proof
      assume e
      have l := rewrite(sym(e), hl)
      show by arith(l)
    qed
    show by taut(c)
  qed
  have eq := mp(app_update_other[f := P, k := k, v := app(P, Q), x := Q], kq)
  have g: all i. i in omega -> app(fn_update(P, k, app(P, Q)), i) = app(P0, i) || (int_lt(i, Q) && app(fn_update(P, k, app(P, Q)), i) = PQ) proof
    fix i
    assume hi
    have c1: i = k -> app(fn_update(P, k, app(P, Q)), i) = app(P0, i) || (int_lt(i, Q) && app(fn_update(P, k, app(P, Q)), i) = PQ) proof
      assume e
      have v: app(fn_update(P, k, app(P, Q)), i) = app(P, Q) by simp(e)
      have l := rewrite(sym(e), hl)
      show by taut(trans(v, a2), l)
    qed
    have c2: !(i = k) -> app(fn_update(P, k, app(P, Q)), i) = app(P0, i) || (int_lt(i, Q) && app(fn_update(P, k, app(P, Q)), i) = PQ) proof
      assume ne
      have o := mp(app_update_other[f := P, k := k, v := app(P, Q), x := i], ne)
      have a := mp(all_elim(a1, {i}), hi)
      show := rewrite(sym(o), a)
    qed
    show by taut(c1, c2)
  qed
  show by defs(taut(g, trans(eq, a2)), x86.gstk)
qed

theorem x86.gstk_refl: all P Q. x86.gstk(P, P, Q, app(P, Q))
proof
  fix P Q
  show by defs(simp(), x86.gstk)
qed

// (the next mapped page: mapped)
theorem x86.next_mapped_mapped: all vm p. !(x86_64_linux.next_mapped(vm, p) = none) -> !(app(app(vm, "pages"), snd(x86_64_linux.next_mapped(vm, p))) = none)
proof
  fix vm p
  assume hn
  have c1: !(ex x. x in omega && (int_le(p, x) && x86_64_linux.mapped(vm, x))) -> false proof
    assume ne
    have it := mp(ite_f[c := ex x. x in omega && (int_le(p, x) && x86_64_linux.mapped(vm, x)), a := some(int_min(set_select(omega, x. int_le(p, x) && x86_64_linux.mapped(vm, x)))), b := none], ne)
    have e: x86_64_linux.next_mapped(vm, p) = none by defs(it, x86_64_linux.next_mapped)
    show by taut(e, hn)
  qed
  have ex: ex x. x in omega && (int_le(p, x) && x86_64_linux.mapped(vm, x)) by taut(c1)
  have it := mp(ite_t[c := ex x. x in omega && (int_le(p, x) && x86_64_linux.mapped(vm, x)), a := some(int_min(set_select(omega, x. int_le(p, x) && x86_64_linux.mapped(vm, x)))), b := none], ex)
  have e: x86_64_linux.next_mapped(vm, p) = some(int_min(set_select(omega, x. int_le(p, x) && x86_64_linux.mapped(vm, x)))) by defs(it, x86_64_linux.next_mapped)
  obtain j, hj from ex
  have ms := mp(mp(int_min_spec[p := x. int_le(p, x) && x86_64_linux.mapped(vm, x), a := j], taut(hj)), taut(hj))
  have mm: x86_64_linux.mapped(vm, int_min(set_select(omega, x. int_le(p, x) && x86_64_linux.mapped(vm, x)))) by taut(ms)
  have mm2 := expand(mm, x86_64_linux.mapped)
  have e2 := expand(e, x86_64_linux.mapped)
  have sn: snd(x86_64_linux.next_mapped(vm, p)) = int_min(set_select(omega, x. int_le(p, x) && (int_lt(x, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) && !(app(app(vm, "pages"), x) = none)))) by simp(e2)
  show := rewrite(sym(sn), mm2.2)
qed

// growing the stack: each page as before, or a stack page (a copy of the
// stack's page above it)
theorem x86.grow_stackp: all m a p m1 e. p in omega -> runs(x86_64_linux.grow_stack(a, p), m, ok(m1, e)) ->
  (all i. i in omega -> app(app(app(m1, "vm"), "pages"), i) = app(app(app(m, "vm"), "pages"), i) || abi.stack_page(app(m1, "vm"), i))
proof
  fix m a p m1 e
  assume hp h
  let Q := snd(x86_64_linux.next_mapped(app(m, "vm"), p))
  let PQ := app(app(app(m, "vm"), "pages"), Q)
  have nmi := all_elim(x86.next_mapped_in, {app(m, "vm")}, {p})
  have nmm := all_elim(x86.next_mapped_mapped, {app(m, "vm")}, {p})
  have g: x86.gstk(app(app(m1, "vm"), "pages"), app(app(m, "vm"), "pages"), Q, PQ) &&
      !(x86_64_linux.next_mapped(app(m, "vm"), p) = none) && !(PQ = none) && app(snd(PQ), "kind") = 2
    by simp(h, hp, nmi, nmm, x86.gstk_step, x86.gstk_refl, x86.prev_mapped_cases, keep(x86.gstk, x86_64_linux.mapped, x86_64_linux.next_mapped, x86_64_linux.prev_mapped, x86_64_linux.run_end),
      {l0 l. x86.gstk(app(app(fst(l), "vm"), "pages"), app(app(m, "vm"), "pages"), Q, PQ) && snd(l) in omega}, {l0 l. x86.gstk(app(app(fst(l), "vm"), "pages"), app(app(m, "vm"), "pages"), Q, PQ) && snd(l) in omega})
  fix i
  assume hi
  have gi := mp(all_elim(expand(g.1, x86.gstk).1, {i}), hi)
  have nn := mp(nmi, g.2)
  have c2: int_lt(i, Q) && app(app(app(m1, "vm"), "pages"), i) = PQ -> abi.stack_page(app(m1, "vm"), i) proof
    assume hq
    have lt: int_lt(i, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) by arith(hq.1, nn.2)
    show by defs(simp(hq.2, lt, g.3, g.4), abi.stack_page, x86_64_linux.mapped)
  qed
  show by taut(gi, c2)
qed

// (v1's pages: v0's, or stack pages)
def x86.stk_ext(v0, v1) := all i. i in omega -> app(app(v1, "pages"), i) = app(app(v0, "pages"), i) || abi.stack_page(v1, i)

theorem x86.stk_ext_refl: all v. x86.stk_ext(v, v)
proof
  fix v
  show by defs(simp(), x86.stk_ext)
qed

theorem x86.stk_ext_trans: all v0 v1 v2. x86.stk_ext(v0, v1) -> x86.stk_ext(v1, v2) -> x86.stk_ext(v0, v2)
proof
  fix v0 v1 v2
  assume h1 h2
  have g: all i. i in omega -> app(app(v2, "pages"), i) = app(app(v0, "pages"), i) || abi.stack_page(v2, i) proof
    fix i
    assume hi
    have a1 := mp(all_elim(expand(h1, x86.stk_ext), {i}), hi)
    have a2 := mp(all_elim(expand(h2, x86.stk_ext), {i}), hi)
    have c: app(app(v2, "pages"), i) = app(app(v1, "pages"), i) -> abi.stack_page(v1, i) -> abi.stack_page(v2, i) proof
      assume e s1
      show by defs(rewrite(sym(e), expand(s1, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
    qed
    have c2: app(app(v2, "pages"), i) = app(app(v1, "pages"), i) -> app(app(v1, "pages"), i) = app(app(v0, "pages"), i) -> app(app(v2, "pages"), i) = app(app(v0, "pages"), i) proof
      assume e1 e2
      show := trans(e1, e2)
    qed
    show by taut(a1, a2, c, c2)
  qed
  show by defs(g, x86.stk_ext)
qed

theorem x86.touch_stk: all m x k y e. x in bits(64) -> runs(x86_64_linux.touch(x, k), m, ok(y, e)) -> x86.stk_ext(app(m, "vm"), app(y, "vm"))
proof
  fix m x k y e
  assume hx h
  have po: x86_64_linux.page_of(x) in omega by defs(simp(hx), x86_64_linux.page_of)
  have gs := all_elim(x86.grow_stackp, {m}, {x}, {x86_64_linux.page_of(x)})
  have rf := all_elim(x86.stk_ext_refl, {app(m, "vm")})
  show by defs(simp(h, po, gs, rf, keep(x86.stk_ext, x86_64_linux.grow_stack, x86_64_linux.mapped, x86_64_linux.page_of)), x86.stk_ext)
qed

theorem x86.touch_range_stk: all m a n k y e. runs(x86_64_linux.touch_range(a, n, k), m, ok(y, e)) -> x86.stk_ext(app(m, "vm"), app(y, "vm"))
proof
  fix m a n k y e
  assume h
  have st: all c j c2 e2. x86.stk_ext(app(m, "vm"), app(c, "vm")) -> runs(x86_64_linux.touch(bits_add(64, a, bits_of_int(64, j)), k), c, ok(c2, e2)) ->
      x86.stk_ext(app(m, "vm"), app(c2, "vm")) proof
    fix c j c2 e2
    assume hc ht
    have t1 := apply(x86.touch_stk, {c}, {bits_add(64, a, bits_of_int(64, j))}, {k}, {c2}, {e2}, (bits_add(64, a, bits_of_int(64, j)) in bits(64) by simp()), ht)
    show := apply(x86.stk_ext_trans, {app(m, "vm")}, {app(c, "vm")}, {app(c2, "vm")}, hc, t1)
  qed
  have rf := all_elim(x86.stk_ext_refl, {app(m, "vm")})
  show by simp(h, rf, st, keep(x86.stk_ext, x86_64_linux.touch), {l0 l1. x86.stk_ext(app(m, "vm"), app(fst(l1), "vm"))})
qed

// (... and the pages from p below n set to PQ)
def x86.gst2(P, P0, Q, PQ, p, n) := x86.gstk(P, P0, Q, PQ) && (all i. i in omega -> int_le(p, i) -> int_lt(i, n) -> app(P, i) = PQ)

theorem x86.gst2_init: all P Q p. x86.gst2(P, P, Q, app(P, Q), p, p)
proof
  fix P Q p
  have g: all i. i in omega -> int_le(p, i) -> int_lt(i, p) -> app(P, i) = app(P, Q) proof
    fix i
    assume h1 h2 h3
    show by arith(h2, h3)
  qed
  show by defs(taut(all_elim(x86.gstk_refl, {P}, {Q}), g), x86.gst2)
qed

theorem x86.gst2_step: all P P0 Q PQ p n. x86.gst2(P, P0, Q, PQ, p, n) -> n in omega -> int_lt(n, Q) -> x86.gst2(fn_update(P, n, app(P, Q)), P0, Q, PQ, p, int_add(n, 1))
proof
  fix P P0 Q PQ p n
  assume h hn hl
  have hs hset := expand(h, x86.gst2)
  have s2 := apply(x86.gstk_step, {P}, {P0}, {Q}, {PQ}, {n}, hs, hn, hl)
  have pq := expand(hs, x86.gstk).2
  have g: all i. i in omega -> int_le(p, i) -> int_lt(i, int_add(n, 1)) -> app(fn_update(P, n, app(P, Q)), i) = PQ proof
    fix i
    assume h1 h2 h3
    have c1: i = n -> app(fn_update(P, n, app(P, Q)), i) = PQ proof
      assume e
      have v: app(fn_update(P, n, app(P, Q)), i) = app(P, Q) by simp(e)
      show := trans(v, pq)
    qed
    have c2: !(i = n) -> app(fn_update(P, n, app(P, Q)), i) = PQ proof
      assume ne
      have o := mp(app_update_other[f := P, k := n, v := app(P, Q), x := i], ne)
      have l: int_lt(i, n) by arith(h1, hn, h3, ne)
      show := trans(o, mp(all_elim(hset, {i}), h1, h2, l))
    qed
    show by taut(c1, c2)
  qed
  show by defs(taut(s2, g), x86.gst2)
qed

theorem x86.gst2_mono: all P P0 Q PQ p n. x86.gst2(P, P0, Q, PQ, p, n) -> int_le(Q, n) -> x86.gst2(P, P0, Q, PQ, p, Q)
proof
  fix P P0 Q PQ p n
  assume h hl
  have hs hset := expand(h, x86.gst2)
  have g: all i. i in omega -> int_le(p, i) -> int_lt(i, Q) -> app(P, i) = PQ proof
    fix i
    assume h1 h2 h3
    have l: int_lt(i, n) by arith(h3, hl)
    show := mp(all_elim(hset, {i}), h1, h2, l)
  qed
  show by defs(taut(hs, g), x86.gst2)
qed

// growing the stack from the unmapped page p: p mapped after
theorem x86.grow_sets: all m a p m1 e. p in omega -> app(app(app(m, "vm"), "pages"), p) = none -> runs(x86_64_linux.grow_stack(a, p), m, ok(m1, e)) ->
  !(app(app(app(m1, "vm"), "pages"), p) = none)
proof
  fix m a p m1 e
  assume hp hn h
  let Q := snd(x86_64_linux.next_mapped(app(m, "vm"), p))
  let PQ := app(app(app(m, "vm"), "pages"), Q)
  have nmi := all_elim(x86.next_mapped_in, {app(m, "vm")}, {p})
  have nmm := all_elim(x86.next_mapped_mapped, {app(m, "vm")}, {p})
  have g: x86.gst2(app(app(m1, "vm"), "pages"), app(app(m, "vm"), "pages"), Q, PQ, p, Q) &&
      !(x86_64_linux.next_mapped(app(m, "vm"), p) = none) && !(PQ = none)
    by simp(h, hp, nmi, nmm, x86.gst2_step, x86.gst2_init, x86.gst2_mono, x86.prev_mapped_cases, keep(x86.gst2, x86_64_linux.mapped, x86_64_linux.next_mapped, x86_64_linux.prev_mapped, x86_64_linux.run_end),
      {l0 l. x86.gst2(app(app(fst(l), "vm"), "pages"), app(app(m, "vm"), "pages"), Q, PQ, p, snd(l)) && snd(l) in omega && int_le(p, snd(l))},
      {l0 l. x86.gst2(app(app(fst(l), "vm"), "pages"), app(app(m, "vm"), "pages"), Q, PQ, p, Q) && snd(l) in omega})
  have nn := mp(nmi, g.2)
  // (p below the next mapped page: p is not mapped)
  have pq: !(p = Q) proof
    have c: p = Q -> false proof
      assume e
      have e2 := rewrite(sym(e), g.3)
      show by taut(e2, hn)
    qed
    show by taut(c)
  qed
  have lt: int_lt(p, Q) by arith(nn.1, nn.3, pq, hp)
  have v := mp(all_elim(expand(g.1, x86.gst2).2, {p}), hp, arith(hp), lt)
  show := rewrite(sym(v), g.3)
qed
// a write access done: the address writable after it
theorem x86.touch_acc: all m x y e. x in bits(64) -> runs(x86_64_linux.touch(x, 1), m, ok(y, e)) -> x86_64_linux.can_access(app(y, "vm"), x, 1)
proof
  fix m x y e
  assume hx h
  let PG := app(app(app(y, "vm"), "pages"), x86_64_linux.page_of(x))
  have po: x86_64_linux.page_of(x) in omega by defs(simp(hx), x86_64_linux.page_of)
  let P := x86_64_linux.page_of(x)
  have k1: x86_64_linux.hw_allows(app(snd(PG), "prot"), 1) by simp(hx, h, keep(x86_64_linux.grow_stack, x86_64_linux.hw_allows, x86_64_linux.page_of, x86_64_linux.mapped))
  have k2: x86_64_linux.mapped(app(y, "vm"), P) || (!x86_64_linux.mapped(app(m, "vm"), P) && !int_le(int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE), P) &&
      (ex e2. runs(x86_64_linux.grow_stack(x, P), m, ok(y, e2))))
    by simp(hx, h, keep(x86_64_linux.grow_stack, x86_64_linux.hw_allows, x86_64_linux.page_of, x86_64_linux.mapped))
  have c2: (!x86_64_linux.mapped(app(m, "vm"), P) && !int_le(int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE), P) &&
      (ex e2. runs(x86_64_linux.grow_stack(x, P), m, ok(y, e2)))) -> x86_64_linux.mapped(app(y, "vm"), P) proof
    assume hc
    have nm lt eg := hc
    have l: int_lt(P, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) by arith(lt, po)
    have pn: app(app(app(m, "vm"), "pages"), P) = none by taut(expand(nm, x86_64_linux.mapped), l)
    obtain e2, hg from eg
    have ny := apply(x86.grow_sets, {m}, {x}, {P}, {y}, {e2}, po, pn, hg)
    show by defs(taut(l, ny), x86_64_linux.mapped)
  qed
  have k: x86_64_linux.hw_allows(app(snd(PG), "prot"), 1) && x86_64_linux.mapped(app(y, "vm"), x86_64_linux.page_of(x)) by taut(k1, k2, c2)
  have w: app(app(snd(PG), "prot"), "w") by simp(expand(k.1, x86_64_linux.hw_allows))
  show by defs(taut(k, w), x86_64_linux.can_access)
qed

// (an access allowed: still, the memory grown)
theorem x86.access_fwd: all v0 v x k. x in bits(64) -> abi.vm_grows(v0, v) -> x86_64_linux.can_access(v0, x, k) -> x86_64_linux.can_access(v, x, k)
proof
  fix v0 v x k
  assume hx hg hc
  have c := expand(expand(hc, x86_64_linux.can_access), x86_64_linux.mapped)
  have m0: x86_64_linux.mapped(v0, x86_64_linux.page_of(x)) by defs(taut(c), x86_64_linux.mapped)
  have po: x86_64_linux.page_of(x) in omega by defs(simp(hx), x86_64_linux.page_of)
  have e := mp(all_elim(expand(hg, abi.vm_grows).1, {x86_64_linux.page_of(x)}), po, m0)
  have c2 := rewrite(sym(e), c)
  show by defs(defs(c2, x86_64_linux.mapped), x86_64_linux.can_access)
qed

// (one more byte of a write access done)
theorem x86.tra_step: all c c2 e2 a j. (all i. i in omega -> int_lt(i, j) -> x86_64_linux.can_access(app(c, "vm"), bits_add(64, a, bits_of_int(64, i)), 1)) -> j in omega ->
  runs(x86_64_linux.touch(bits_add(64, a, bits_of_int(64, j)), 1), c, ok(c2, e2)) ->
  (all i. i in omega -> int_lt(i, int_add(j, 1)) -> x86_64_linux.can_access(app(c2, "vm"), bits_add(64, a, bits_of_int(64, i)), 1))
proof
  fix c c2 e2 a j
  assume hp hj ht
  have gr := apply(x86.touch_frame_at, {c}, {a}, {j}, {1}, {c2}, {e2}, ht)
  have ta := apply(x86.touch_acc, {c}, {bits_add(64, a, bits_of_int(64, j))}, {c2}, {e2}, (bits_add(64, a, bits_of_int(64, j)) in bits(64) by simp()), ht)
  fix i
  assume hi hl
  have c1: i = j -> x86_64_linux.can_access(app(c2, "vm"), bits_add(64, a, bits_of_int(64, i)), 1) proof
    assume e
    show := rewrite(sym(e), ta)
  qed
  have c3: !(i = j) -> x86_64_linux.can_access(app(c2, "vm"), bits_add(64, a, bits_of_int(64, i)), 1) proof
    assume ne
    have l: int_lt(i, j) by arith(hi, hj, hl, ne)
    have o := mp(all_elim(hp, {i}), hi, l)
    show := apply(x86.access_fwd, (bits_add(64, a, bits_of_int(64, i)) in bits(64) by simp()), gr, o)
  qed
  show by taut(c1, c3)
qed

// ... and all n bytes of a write access done
theorem x86.touch_range_acc: all m a n y e. runs(x86_64_linux.touch_range(a, n, 1), m, ok(y, e)) ->
  (all j. j in omega -> int_lt(j, n) -> x86_64_linux.can_access(app(y, "vm"), bits_add(64, a, bits_of_int(64, j)), 1))
proof
  fix m a n y e
  assume h
  have i0: all i. i in omega -> int_lt(i, 0) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, a, bits_of_int(64, i)), 1) proof
    fix i
    assume h1 h2
    show by arith(h1, h2)
  qed
  show by simp(h, i0, x86.tra_step, keep(x86_64_linux.touch, x86_64_linux.can_access),
    {l0 l1. (all j. j in omega -> int_lt(j, snd(l1)) -> x86_64_linux.can_access(app(fst(l1), "vm"), bits_add(64, a, bits_of_int(64, j)), 1)) && snd(l1) in omega})
qed
