// The ABI contract with ghost state: machine code implementing a C function
// value (its GIMPLE, ghost-free: the bridge's `abi.matches`, C1) that
// refines a spec over `World & G` (`refines_ghost`) implements the spec
// (`abi.implements2_at(G, ..)`). The ghost fields are the spec's alone: the
// machine's state carries them along unchanged, the spec's run chooses
// the final ones. Proven once, for every G whose fields are apart from the
// machine's and the world's.

// ----------------------------------------------------------------------
//  A machine state with a ghost part

// G's values: records whose fields are none of the machine's or the world's
abbrev abi.ghost_ok(G) := all h. h in G -> h in univ(1) && is_fun(h) && (all z. z in h -> !(fst(z) in abi.KEYS) && !(fst(z) in abi.WKEYS))

// (a record joined with one of other fields: its part on its fields, and
// the other's off them)
theorem abi.restrict_union_l(a, b, d): (all z. z in a -> fst(z) in d) -> (all z. z in b -> !(fst(z) in d)) -> restrict(union2(a, b), d) = a
proof
  assume ha hb
  have all_z: all z. z in restrict(union2(a, b), d) <-> z in a proof
    fix z
    have sd := set_select_def[s := union2(a, b), p := z. fst(z) in d, z := z]
    have ui := union2_iff[a := a, b := b, z := z]
    show by defs(taut(sd, ui, all_elim(ha, {z}), all_elim(hb, {z})), restrict)
  qed
  show by mp(set_ext[a := restrict(union2(a, b), d), b := a], all_z)
qed

theorem abi.ghost_part_union_r(a, b, d): (all z. z in a -> fst(z) in d) -> (all z. z in b -> !(fst(z) in d)) -> ghost_part(union2(a, b), d) = b
proof
  assume ha hb
  have all_z: all z. z in ghost_part(union2(a, b), d) <-> z in b proof
    fix z
    have sd := set_select_def[s := union2(a, b), p := z. !(fst(z) in d), z := z]
    have ui := union2_iff[a := a, b := b, z := z]
    show by defs(taut(sd, ui, all_elim(ha, {z}), all_elim(hb, {z})), ghost_part)
  qed
  show by mp(set_ext[a := ghost_part(union2(a, b), d), b := b], all_z)
qed

// (a key of none of h's pairs: not in its domain)
theorem abi.not_dom(h, k): (all z. z in h -> !(fst(z) = k)) -> !(k in dom(h))
proof
  assume hz
  have im := set_image_def[s := h, f := z. fst(z), y := k]
  have nk: !(ex x. x in h && fst(x) = k) proof
    assume e
    obtain x, hx hk from e
    have n := mp(all_elim(hz, {x}), hx)
    show by taut(n, hk)
  qed
  show by defs(taut(im, nk), dom)
qed

// a machine state s with a ghost part h: its fields s's, its machine part
// s, its ghost part h
theorem abi.ghost_parts: all G s h. abi.ghost_ok(G) -> h in G -> s in x86_64_linux.Machine ->
  restrict(union2(s, h), abi.KEYS) = s && ghost_part(union2(s, h), abi.KEYS) = h &&
  (all k. k in abi.KEYS -> union2(s, h)[k] = s[k])
proof
  fix G s h
  assume hg hh hM
  have hu hf hz := mp(all_elim(hg, {h}), hh)
  have kf := apply(pow_cart_fst, unsel(expand(hM, x86_64_linux.Machine)))
  have hk: all z. z in h -> !(fst(z) in abi.KEYS) proof
    fix z
    assume hz2
    have a _ := mp(all_elim(hz, {z}), hz2)
    show a
  qed
  have r := mp(abi.restrict_union_l[a := s, b := h, d := abi.KEYS], kf, hk)
  have g := mp(abi.ghost_part_union_r[a := s, b := h, d := abi.KEYS], kf, hk)
  have sf: is_fun(s) && dom(s) = abi.KEYS by simp(expand(hM, x86_64_linux.Machine))
  have ap: all k. k in abi.KEYS -> union2(s, h)[k] = s[k] proof
    fix k
    assume hkk
    have nz: all z. z in h -> !(fst(z) = k) proof
      fix z
      assume hz2
      have a _ := mp(all_elim(hz, {z}), hz2)
      show proof
        assume e
        have kz: fst(z) in abi.KEYS := rewrite(sym(e), hkk)
        show by taut(a, kz)
      qed
    qed
    have nd := mp(abi.not_dom[h := h, k := k], nz)
    show := mp(app_union2_l[w := s, g := h, k := k], sf.1, (k in dom(s) by simp(sf, hkk)), nd)
  qed
  show by taut(r, g, ap)
qed

// (two records merged: from their parts' equations)
theorem abi.merge_eq(a, b, c, d): a = c -> b = d -> rec_merge(a, b) = union2(c, d)
proof
  assume e1 e2
  show by defs(rewrite(e2, rewrite(e1, refl({rec_merge(a, b)}), {2}), {2}), rec_merge)
qed

// ----------------------------------------------------------------------
//  The cases of the bridge, with a ghost part h: the machine state s's
//  with it (union2(s, h)), the spec run on the entry's world with it

// abi_function's state after reading the world and writing it back, from S
abbrev abi.gs1(S) := fn_update(fn_update(S, "vm", S.vm), "os", S.os)
abbrev abi.gmm1(S, objs, mem) := rec_merge(restrict(abi.gs1(S), abi.KEYS), ghost_part(abi.cw(S, objs, mem), abi.WKEYS))

// (a record's pairs: their first components its domain)
theorem abi.keys_of(f, d): dom(f) = d -> (all z. z in f -> fst(z) in d)
proof
  assume hd
  fix z
  assume hz
  have im := set_image_def[s := f, f := x. fst(x), y := fst(z)]
  have e: ex x. x in f && fst(x) = fst(z) by ex_intro({z}, taut(hz, refl({fst(z)})))
  have kd: fst(z) in dom(f) by defs(taut(im, e), dom)
  show := rewrite(hd, kd)
qed

// a world w with a ghost part h: its fields w's, its world part w, its
// ghost part h
theorem abi.ghost_parts_w: all G w h. abi.ghost_ok(G) -> h in G -> w in abi.World ->
  restrict(union2(w, h), abi.WKEYS) = w && ghost_part(union2(w, h), abi.WKEYS) = h &&
  (all k. k in abi.WKEYS -> union2(w, h)[k] = w[k])
proof
  fix G w h
  assume hg hh hw
  have hu hf hz := mp(all_elim(hg, {h}), hh)
  have wd: dom(w) = abi.WKEYS by simp(expand(hw, abi.World))
  have kw := mp(abi.keys_of[f := w, d := abi.WKEYS], wd)
  have hk: all z. z in h -> !(fst(z) in abi.WKEYS) proof
    fix z
    assume hz2
    have _ b := mp(all_elim(hz, {z}), hz2)
    show b
  qed
  have r := mp(abi.restrict_union_l[a := w, b := h, d := abi.WKEYS], kw, hk)
  have g := mp(abi.ghost_part_union_r[a := w, b := h, d := abi.WKEYS], kw, hk)
  have ap: all k. k in abi.WKEYS -> union2(w, h)[k] = w[k] proof
    fix k
    assume hkk
    have nz: all z. z in h -> fst(z) != k proof
      fix z
      assume hz2
      show proof
        assume e
        have kz: fst(z) in abi.WKEYS := rewrite(sym(e), hkk)
        show by taut(mp(all_elim(hk, {z}), hz2), kz)
      qed
    qed
    show := mp(app_union2_lacks[a := w, b := h, k := k], nz)
  qed
  show by taut(r, g, ap)
qed

// ----------------------------------------------------------------------
//  The other cases with a ghost part

// the entry s with the ghost part h: the world the spec runs on, the
// entry's with h; the state at the call, S itself; the entry's facts as of S
theorem abi.ghost_entry: all G s h objs mem. abi.ghost_ok(G) -> h in G -> s in x86_64_linux.Machine -> s in univ(1) -> objs in set_type(omega) -> mem in x86_64_linux.Vm ->
  abi.view_ok(s, objs, mem) ->
  (all x. x in omega -> x in objs -> (int_le(abi.sp(s), x) && abi.stack_page(s.vm, int_div(x, x86_64_linux.PAGE))) && x86_64_linux.can_access(s.vm, bits_of_int(64, x), 1)) ->
  union2(s, h) in univ(1) &&
  abi.cw(union2(s, h), objs, mem) = union2(abi.view(s, objs, mem), h) &&
  abi.gmm1(union2(s, h), objs, mem) = union2(s, h) &&
  abi.view_ok(union2(s, h), objs, mem) &&
  (all x. x in omega -> x in objs -> (int_le(abi.sp(union2(s, h)), x) && abi.stack_page(union2(s, h).vm, int_div(x, x86_64_linux.PAGE))) && x86_64_linux.can_access(union2(s, h).vm, bits_of_int(64, x), 1)) &&
  union2(s, h).vm in x86_64_linux.Vm && union2(s, h).gpr[4] in bits(64) &&
  (all k. k in abi.KEYS -> union2(s, h)[k] = s[k]) &&
  abi.cw(union2(s, h), objs, mem).objs = abi.objs_at(objs, union2(s, h).fs_base)
proof
  fix G s h objs mem
  assume hg hh hM su hot hmv hwm hob
  let S := union2(s, h)
  have rS gS apS := apply(abi.ghost_parts, hg, hh, hM)
  have hu hf hz := mp(all_elim(hg, {h}), hh)
  have a1 := mp(all_elim(apS, {"gpr"}), simp())
  have a5 := mp(all_elim(apS, {"cpu"}), simp())
  have a6 := mp(all_elim(apS, {"fs_base"}), simp())
  have a8 := mp(all_elim(apS, {"vm"}), simp())
  have a9 := mp(all_elim(apS, {"os"}), simp())
  have Su: S in univ(1) := mp(union2_univ[u := 1, a := s, b := h], su, hu)
  have ou := apply(abi.objs_univ, hot)
  have hmu := apply(x86.vm_univ, hmv)
  have sf: is_fun(s) && dom(s) = abi.KEYS by simp(expand(hM, x86_64_linux.Machine))
  have hzw: all z. z in h -> !(fst(z) in abi.WKEYS) proof
    fix z
    assume hz2
    have _ b := mp(all_elim(hz, {z}), hz2)
    show b
  qed
  have nd: all k. k in abi.KEYS -> !(k in dom(h)) proof
    fix k
    assume hkk
    have nz: all z. z in h -> !(fst(z) = k) proof
      fix z
      assume hz2
      show proof
        assume e
        have kz: fst(z) in abi.KEYS := rewrite(sym(e), hkk)
        have a _ := mp(all_elim(hz, {z}), hz2)
        show by taut(a, kz)
      qed
    qed
    show := mp(abi.not_dom[h := h, k := k], nz)
  qed
  have u8 := mp(fn_update_union[w := s, g := h, k := "vm"], sf.1, simp(sf), mp(all_elim(nd, {"vm"}), simp()))
  have u9 := mp(fn_update_union[w := s, g := h, k := "os"], sf.1, simp(sf), mp(all_elim(nd, {"os"}), simp()))
  have s1e: abi.gs1(S) = S by simp(a8, a9, u8, u9)
  have wo_s: abi.wo(S, objs, mem) = abi.view(s, objs, mem) by simp(a5, a6, a9)
  have wkw: all z. z in abi.view(s, objs, mem) -> fst(z) in abi.WKEYS by defs(simp(), fn_update, insert)
  have gw := mp(abi.ghost_part_union_r[a := abi.view(s, objs, mem), b := h, d := abi.WKEYS], wkw, hzw)
  have x7e := mp(abi.merge_eq[a := abi.wo(S, objs, mem), b := ghost_part(S, abi.KEYS), c := abi.view(s, objs, mem), d := h], wo_s, gS)
  have e1: restrict(abi.gs1(S), abi.KEYS) = s := rewrite(sym(s1e), rS)
  have e2: ghost_part(abi.cw(S, objs, mem), abi.WKEYS) = h := rewrite(sym(x7e), gw)
  have m1e := mp(abi.merge_eq[a := restrict(abi.gs1(S), abi.KEYS), b := ghost_part(abi.cw(S, objs, mem), abi.WKEYS), c := s, d := h], e1, e2)
  have hwmS: abi.view_ok(S, objs, mem) := rewrite(sym(a6), rewrite(sym(a1), rewrite(sym(a8), hwm)))
  have hobS := rewrite(sym(a1), rewrite(sym(a8), hob))
  have hsvS: S.vm in x86_64_linux.Vm := rewrite(sym(a8), (s.vm in x86_64_linux.Vm by simp(hM)))
  have hspS: S.gpr[4] in bits(64) := rewrite(sym(a1), (s.gpr[4] in bits(64) by simp(hM)))
  // (the world's bytes at the call: the entry's)
  have vu: abi.view(s, objs, mem) in univ(1) by simp(su, ou, hmu, mp(all_elim(abi.objs_at_univ, {objs}, {s.fs_base}), ou))
  have wt := apply(abi.world_typed, hM, hot, hmv, vu)
  have _ _ apw := apply(abi.ghost_parts_w, hg, hh, wt)
  have vo := mp(all_elim(apw, {"objs"}), simp())
  have co: abi.cw(S, objs, mem).objs = abi.objs_at(objs, S.fs_base) by simp(x7e, vo, a6)
  show by taut(Su, x7e, m1e, hwmS, hobS, hsvS, hspS, apS, co)
qed

// (the spec raises from w: an exception of its run, its state with a ghost
// part in G)
theorem abi.raises_intro_g: all G w x spec args e. x in rec_and(abi.World, G) -> e in univ(1) -> !(e = exc_val("stack_overflow", empty)) ->
  runs(spec[args], w, exc(x, e)) -> abi.spec_raises(rec_and(abi.World, G), w, spec, args)
proof
  fix G w x spec args e
  assume hw he hno hr
  have ot := mp(mp(exc_outcome_type[s := rec_and(abi.World, G), v := cart(bits(64), bits(64)), x := x, e := e], hw), he)
  show by defs(ex_intro({exc(x, e)}, simp(ot, hr, hno, keep(outcome_type))), abi.spec_raises)
qed

// a divergence: the spec diverging on the entry's world (with h), with
// the machine's trace
theorem abi.div_case_g: all G f spec args objs mem s h t. abi.ghost_ok(G) -> h in G -> s in x86_64_linux.Machine -> pair(s, diverge(t)) in univ(1) -> objs in set_type(omega) ->
  (all x. x in omega -> x in objs -> (int_le(abi.sp(s), x) && abi.stack_page(s.vm, int_div(x, x86_64_linux.PAGE))) && x86_64_linux.can_access(s.vm, bits_of_int(64, x), 1)) -> mem in x86_64_linux.Vm -> abi.view_ok(s, objs, mem) ->
  runs(spec[args], union2(abi.view(s, objs, mem), h), diverge(t)) ->
  runs(abi.abi_function(G, f, spec, args, objs, mem), union2(s, h), diverge(t))
proof
  fix G f spec args objs mem s h t
  assume hg hh hM hp hot hob hmv hwm hr
  let S := union2(s, h)
  have rS gS apS := apply(abi.ghost_parts, hg, hh, hM)
  have hu hf hz := mp(all_elim(hg, {h}), hh)
  // (the machine part's fields: s's)
  have a1 := mp(all_elim(apS, {"gpr"}), simp())
  have a2 := mp(all_elim(apS, {"xmm"}), simp())
  have a3 := mp(all_elim(apS, {"rip"}), simp())
  have a4 := mp(all_elim(apS, {"flags"}), simp())
  have a5 := mp(all_elim(apS, {"cpu"}), simp())
  have a6 := mp(all_elim(apS, {"fs_base"}), simp())
  have a7 := mp(all_elim(apS, {"gs_base"}), simp())
  have a8 := mp(all_elim(apS, {"vm"}), simp())
  have a9 := mp(all_elim(apS, {"os"}), simp())
  // the states of abi_function's way to the call (as abi.div_case's)
  let x7 := abi.cw(S, objs, mem)
  let s1 := fn_update(fn_update(S, "vm", S.vm), "os", S.os)
  let mm1 := rec_merge(restrict(s1, abi.KEYS), ghost_part(x7, abi.WKEYS))
  have su: s in univ(1) by simp(hp)
  have Su: S in univ(1) := mp(union2_univ[u := 1, a := s, b := h], su, hu)
  have tu: t in univ(1) by simp(hp)
  have ou := apply(abi.objs_univ, hot)
  have hmu := apply(x86.vm_univ, hmv)
  have hsv: s.vm in x86_64_linux.Vm by simp(hM)
  have vmu: s.vm in univ(1) by simp(su)
  have sf: is_fun(s) && dom(s) = abi.KEYS by simp(expand(hM, x86_64_linux.Machine))
  // (S written back as it was: S)
  have hzk: all z. z in h -> !(fst(z) in abi.KEYS) proof
    fix z
    assume hz2
    have a _ := mp(all_elim(hz, {z}), hz2)
    show a
  qed
  have hzw: all z. z in h -> !(fst(z) in abi.WKEYS) proof
    fix z
    assume hz2
    have _ b := mp(all_elim(hz, {z}), hz2)
    show b
  qed
  have nd: all k. k in abi.KEYS -> !(k in dom(h)) proof
    fix k
    assume hkk
    have nz: all z. z in h -> !(fst(z) = k) proof
      fix z
      assume hz2
      show proof
        assume e
        have kz: fst(z) in abi.KEYS := rewrite(sym(e), hkk)
        show by taut(mp(all_elim(hzk, {z}), hz2), kz)
      qed
    qed
    show := mp(abi.not_dom[h := h, k := k], nz)
  qed
  have u8 := mp(fn_update_union[w := s, g := h, k := "vm"], sf.1, simp(sf), mp(all_elim(nd, {"vm"}), simp()))
  have u9 := mp(fn_update_union[w := s, g := h, k := "os"], sf.1, simp(sf), mp(all_elim(nd, {"os"}), simp()))
  have s1e: s1 = S by simp(a8, a9, u8, u9)
  // (the world at the call: the entry's, with h)
  have wo_s: abi.wo(S, objs, mem) = abi.view(s, objs, mem) by simp(a5, a6, a9)
  have wkw: all z. z in abi.view(s, objs, mem) -> fst(z) in abi.WKEYS by defs(simp(), fn_update, insert)
  have gw := mp(abi.ghost_part_union_r[a := abi.view(s, objs, mem), b := h, d := abi.WKEYS], wkw, hzw)
  have x7e := mp(abi.merge_eq[a := abi.wo(S, objs, mem), b := ghost_part(S, abi.KEYS), c := abi.view(s, objs, mem), d := h], wo_s, gS)
  have e1: restrict(s1, abi.KEYS) = s := rewrite(sym(s1e), rS)
  have e2: ghost_part(x7, abi.WKEYS) = h := rewrite(sym(x7e), gw)
  have m1e := mp(abi.merge_eq[a := restrict(s1, abi.KEYS), b := ghost_part(x7, abi.WKEYS), c := s, d := h], e1, e2)
  have ein: abi.cw(mm1, objs, mem) = union2(abi.view(s, objs, mem), h) := rewrite(sym(m1e), x7e)
  have hspec := rewrite(sym(ein), hr)
  have wun: abi.view(s, objs, mem) in univ(1) by simp(su, ou, hmu, mp(all_elim(abi.objs_at_univ, {objs}, {s.fs_base}), ou))
  have x7u: x7 in univ(1) := rewrite(sym(x7e), mp(union2_univ[u := 1, a := abi.view(s, objs, mem), b := h], wun, hu))
  have gsu: ghost_part(S, abi.KEYS) in univ(1) := rewrite(sym(gS), hu)
  // (the entry's facts as of S: its fields s's)
  have hwmS: abi.view_ok(S, objs, mem) := rewrite(sym(a6), rewrite(sym(a1), rewrite(sym(a8), hwm)))
  have hobS := rewrite(sym(a1), rewrite(sym(a8), hob))
  have hsvS: S.vm in x86_64_linux.Vm := rewrite(sym(a8), hsv)
  have vmuS: S.vm in univ(1) := rewrite(sym(a8), vmu)
  have wunS: abi.wo(S, objs, mem) in univ(1) := rewrite(sym(wo_s), wun)
  // the entry world: read, and written back unchanged
  have g0 := mp(all_elim(abi.get_ok, {abi.sp(S)}, {objs}, {mem}, {S}), Su, ou, hmu)
  have wu := mp(restrict_univ[u := 1, f := x7, d := abi.WKEYS], x7u)
  have wt0 := apply(abi.world_typed, hM, hot, hmv, wun)
  have _ _ apw := apply(abi.ghost_parts_w, hg, hh, wt0)
  have co: restrict(x7, abi.WKEYS).objs = abi.objs_at(objs, S.fs_base) by simp(x7e, mp(all_elim(apw, {"objs"}), simp()), a6)
  have hm0: abi.world_matches(S.vm, S.vm, restrict(x7, abi.WKEYS).vm, abi.wob(objs, restrict(x7, abi.WKEYS).objs.c_bytes), S.fs_base, abi.sp(S))
    by simp(rewrite(all_elim(abi.objs_at_wob, {objs}, {S.fs_base}), hwmS.2), co, all_elim(abi.objs_at_live, {objs}, {S.fs_base}), keep(abi.world_matches, abi.canary))
  have s0 := mp(all_elim(abi.set_ok, {abi.sp(S)}, {objs}, {mem}, {S}, {restrict(x7, abi.WKEYS)}, {S.vm}), Su, wu, vmuS, hsvS, hm0)
  // the spec on the world, from mm1 (= S)
  have m1u: mm1 in univ(1) := rewrite(sym(m1e), Su)
  have cl0 := mp(all_elim(abi.call_div, {spec}, {args}, {abi.sp(S)}, {objs}, {mem}, {mm1}, {t}), m1u, ou, hmu, hspec, tu)
  have cl := rewrite(sym(all_elim(abi.call_ghost, {G}, {spec}, {args}, {abi.sp(S)}, {objs}, {mem})), cl0)
  have pS: pair(S, diverge(t)) in univ(1) by simp(Su, tu)
  show by simp(Su, ou, hmu, hwmS, wunS, x7u, gsu, m1u, g0, s0, cl, pS, hobS,
    keep(abi.world_pages, abi.world_matches, abi.spec_raises, abi.entry_ok, abi.world.get, abi.world.set, abi.abi_call, abi.abi_restore))
qed

// ----------------------------------------------------------------------
//  A record joined with a ghost part of other keys (its updates and reads:
//  `fn_update_union_l`, `app_union2_lacks`, core/records.core)

// (a record's part on d, joined with one of other keys: its own)
theorem abi.restrict_union_g(a, b, d): (all z. z in b -> !(fst(z) in d)) -> restrict(union2(a, b), d) = restrict(a, d)
proof
  assume hb
  have all_z: all z. z in restrict(union2(a, b), d) <-> z in restrict(a, d) proof
    fix z
    have s1 := set_select_def[s := union2(a, b), p := z. fst(z) in d, z := z]
    have s2 := set_select_def[s := a, p := z. fst(z) in d, z := z]
    have ui := union2_iff[a := a, b := b, z := z]
    show by defs(taut(s1, s2, ui, all_elim(hb, {z})), restrict)
  qed
  show by mp(set_ext[a := restrict(union2(a, b), d), b := restrict(a, d)], all_z)
qed

// undefined behavior: the spec raises from the entry's world with h
theorem abi.ub_case_g: all G f spec args objs mem s h o e x. abi.ghost_ok(G) -> h in G -> s in x86_64_linux.Machine -> s in univ(1) -> objs in set_type(omega) -> mem in x86_64_linux.Vm ->
  abi.view_ok(s, objs, mem) ->
  (all x. x in omega -> x in objs -> (int_le(abi.sp(s), x) && abi.stack_page(s.vm, int_div(x, x86_64_linux.PAGE))) && x86_64_linux.can_access(s.vm, bits_of_int(64, x), 1)) ->
  e in univ(1) -> !(e = exc_val("stack_overflow", empty)) -> x in rec_and(abi.World, G) ->
  runs(spec[args], union2(abi.view(s, objs, mem), h), exc(x, e)) -> pair(union2(s, h), o) in univ(1) -> abi.outcome(o) ->
  runs(abi.abi_function(G, f, spec, args, objs, mem), union2(s, h), o)
proof
  fix G f spec args objs mem s h o e x
  assume hg hh hM su hot hmv hwm hob he hno hx hr hp ho
  have Su x7e m1e hwmS hobS hsvS hspS apS hcoS := apply(abi.ghost_entry, hg, hh, hM, su, hot, hmv, hwm, hob)
  have ou := apply(abi.objs_univ, hot)
  have hmu := apply(x86.vm_univ, hmv)
  have hra := apply(abi.raises_intro_g, {G}, {abi.cw(union2(s, h), objs, mem)}, {x}, {spec}, {args}, {e}, hx, he, hno, rewrite(sym(x7e), hr))
  show := apply(abi.ub_intro_g, {G}, {f}, hp, ho, ou, hmu, hsvS, hspS, hwmS, hcoS, hra)
qed

// a crash: the machine faulting on its stack (its ghost part h kept), with
// I/O the spec allows a stack overflow to have from the world with h
theorem abi.crash_case_g: all G f spec args objs mem s h m1 c. abi.ghost_ok(G) -> h in G -> s in x86_64_linux.Machine -> pair(s, exc(m1, c)) in univ(1) -> objs in set_type(omega) ->
  (all x. x in omega -> x in objs -> (int_le(abi.sp(s), x) && abi.stack_page(s.vm, int_div(x, x86_64_linux.PAGE))) && x86_64_linux.can_access(s.vm, bits_of_int(64, x), 1)) -> mem in x86_64_linux.Vm -> abi.view_ok(s, objs, mem) ->
  ((ex a k. c = exc_val("segv", pair(a, k)) && (k = 0 || k = 1 || k = 3) && a in bits(64) && abi.overflow_at(m1.vm, m1.gpr[4], abi.sp(s), a)) ||
    c = exc_val("stack_fault", empty)) ->
  m1 in x86_64_linux.Machine -> subset(s.os.events, m1.os.events) ->
  abi.overflow_ok(rec_and(abi.World, G), union2(abi.view(s, objs, mem), h), spec, args, m1.os) ->
  runs(abi.abi_function(G, f, spec, args, objs, mem), union2(s, h), exc(union2(m1, h), c))
proof
  fix G f spec args objs mem s h m1 c
  assume hg hh hM hp hot hob hmv hwm hc hM1 hev hov
  let S := union2(s, h)
  let M1 := union2(m1, h)
  have su: s in univ(1) by simp(hp)
  have m1u: m1 in univ(1) by simp(hp)
  have cu: c in univ(1) by simp(hp)
  have Su x7e m1e hwmS hobS hsvS hspS apS hcoS := apply(abi.ghost_entry, hg, hh, hM, su, hot, hmv, hwm, hob)
  have _ _ apM := apply(abi.ghost_parts, hg, hh, hM1)
  have hu _ _ := mp(all_elim(hg, {h}), hh)
  have a1 := mp(all_elim(apS, {"gpr"}), simp())
  have a6 := mp(all_elim(apS, {"fs_base"}), simp())
  have a9 := mp(all_elim(apS, {"os"}), simp())
  have b1 := mp(all_elim(apM, {"gpr"}), simp())
  have b8 := mp(all_elim(apM, {"vm"}), simp())
  have b9 := mp(all_elim(apM, {"os"}), simp())
  have ou := apply(abi.objs_univ, hot)
  have hmu := apply(x86.vm_univ, hmv)
  have M1u: M1 in univ(1) := mp(union2_univ[u := 1, a := m1, b := h], m1u, hu)
  // the states of abi_function's way to the crash, from S (as abi.crash_case's)
  let x7 := abi.cw(S, objs, mem)
  let mm1 := abi.gmm1(S, objs, mem)
  have wun: abi.view(s, objs, mem) in univ(1) by simp(su, ou, hmu, mp(all_elim(abi.objs_at_univ, {objs}, {s.fs_base}), ou))
  have x7u: x7 in univ(1) := rewrite(sym(x7e), mp(union2_univ[u := 1, a := abi.view(s, objs, mem), b := h], wun, hu))
  have vmuS: S.vm in univ(1) by simp(Su)
  have g0 := mp(all_elim(abi.get_ok, {abi.sp(S)}, {objs}, {mem}, {S}), Su, ou, hmu)
  have wu := mp(restrict_univ[u := 1, f := x7, d := abi.WKEYS], x7u)
  have wt0 := apply(abi.world_typed, hM, hot, hmv, wun)
  have _ _ apw := apply(abi.ghost_parts_w, hg, hh, wt0)
  have co: restrict(x7, abi.WKEYS).objs = abi.objs_at(objs, S.fs_base) by simp(x7e, mp(all_elim(apw, {"objs"}), simp()), a6)
  have hm0: abi.world_matches(S.vm, S.vm, restrict(x7, abi.WKEYS).vm, abi.wob(objs, restrict(x7, abi.WKEYS).objs.c_bytes), S.fs_base, abi.sp(S))
    by simp(rewrite(all_elim(abi.objs_at_wob, {objs}, {S.fs_base}), hwmS.2), co, all_elim(abi.objs_at_live, {objs}, {S.fs_base}), keep(abi.world_matches, abi.canary))
  have s0 := mp(all_elim(abi.set_ok, {abi.sp(S)}, {objs}, {mem}, {S}, {restrict(x7, abi.WKEYS)}, {S.vm}), Su, wu, vmuS, hsvS, hm0)
  have m1u2: mm1 in univ(1) := rewrite(sym(m1e), Su)
  // the crash state: M1, a machine with the ghost part h; its I/O as overflow_ok has it
  have mr: M1 in rec_and(x86_64_linux.Machine, G) := apply(rec_and_intro, hM1, hh)
  have hcM := rewrite(sym(a1), rewrite(sym(b1), rewrite(sym(b8), hc)))
  have hevM := rewrite(sym(m1e), rewrite(sym(a9), rewrite(sym(b9), hev)))
  have hovM := rewrite(sym(x7e), rewrite(sym(b9), hov))
  have pS: pair(S, exc(M1, c)) in univ(1) by simp(Su, M1u, cu)
  have gsu := mp(ghost_part_univ[u := 1, f := S, d := abi.KEYS], Su)
  have wunS: abi.wo(S, objs, mem) in univ(1) by simp(Su, ou, hmu, mp(all_elim(abi.objs_at_univ, {objs}, {S.fs_base}), ou))
  show by simp(Su, ou, hmu, hwmS, wunS, x7u, gsu, m1u2, g0, s0, pS, hobS, hcM, cu, hevM, hovM, mr, M1u,
    keep(abi.world_pages, abi.world_matches, abi.spec_raises, abi.entry_ok, abi.world.get, abi.world.set, abi.abi_call, abi.abi_restore, abi.overflow_at, abi.overflow_ok))
qed

// a normal return: the machine's final state m1, the spec's run on the
// world with h ending in w2 with the ghost part h2, its result in rax:rdx
// -- the machine's final state m1 with h2
theorem abi.ret_case_g: all G f spec args objs mem s h m1 w2 h2. abi.ghost_ok(G) -> h in G -> h2 in G ->
  s in x86_64_linux.Machine -> abi.entry_ok(s, args) -> m1 in x86_64_linux.Machine -> pair(s, ok(m1, empty)) in univ(1) ->
  objs in set_type(omega) -> (all x. x in omega -> x in objs -> (int_le(abi.sp(s), x) && abi.stack_page(s.vm, int_div(x, x86_64_linux.PAGE))) && x86_64_linux.can_access(s.vm, bits_of_int(64, x), 1)) -> mem in x86_64_linux.Vm -> abi.view_ok(s, objs, mem) ->
  runs(spec[args], union2(abi.view(s, objs, mem), h), ok(union2(w2, h2), pair(m1.gpr[0], m1.gpr[2]))) -> w2 in abi.World -> w2 in univ(1) ->
  abi.world_matches(s.vm, m1.vm, w2.vm, abi.wob(objs, w2.objs.c_bytes), s.fs_base, abi.sp(s)) -> m1.os = w2.os -> m1.fs_base = s.fs_base ->
  m1.cpu = s.cpu -> m1.gs_base = s.gs_base -> m1.rip = abi.ret(s) -> m1.gpr[4] = abi.sp(s) ->
  abi.callee_saved(m1, s) -> !m1.flags.df ->
  runs(abi.abi_function(G, f, spec, args, objs, mem), union2(s, h), ok(union2(m1, h2), empty))
proof
  fix G f spec args objs mem s h m1 w2 h2
  assume hg hh hh2 hM he hM1 hp hot hob hmv hwm hr hw hwu hnm hos hfs hcpu hgs hrip hrsp hcs hdf
  let S := union2(s, h)
  let W2 := union2(w2, h2)
  have ok0 := apply(abi.ok_univ, hp)
  have su: s in univ(1) by taut(ok0)
  have m1u: m1 in univ(1) by taut(ok0)
  have Su x7e m1e hwmS hobS hsvS hspS apS hcoS := apply(abi.ghost_entry, hg, hh, hM, su, hot, hmv, hwm, hob)
  have rW gW apW := apply(abi.ghost_parts_w, hg, hh2, hw)
  have hu2 _ _ := mp(all_elim(hg, {h2}), hh2)
  have W2u: W2 in univ(1) := mp(union2_univ[u := 1, a := w2, b := h2], hwu, hu2)
  have a1 := mp(all_elim(apS, {"gpr"}), simp())
  have a8 := mp(all_elim(apS, {"vm"}), simp())
  have c8 := mp(all_elim(apW, {"vm"}), simp())
  have ou := apply(abi.objs_univ, hot)
  have hmu := apply(x86.vm_univ, hmv)
  // the spec's run, on the world abi_function gives it at the call
  have ein: abi.cw(abi.gmm1(S, objs, mem), objs, mem) = union2(abi.view(s, objs, mem), h) := rewrite(sym(m1e), x7e)
  have hspec := rewrite(sym(ein), hr)
  // the machine's registers, flags and memory: the havoc's choice, the memory written back
  have h0: m1.gpr[0] in bits(64) by simp(hM1)
  have h1: m1.gpr[2] in bits(64) by simp(hM1)
  have hnu: m1.vm in univ(1) by simp(m1u)
  have hnv: m1.vm in x86_64_linux.Vm by simp(hM1)
  have gu: m1.gpr in univ(1) by simp(m1u)
  have tg: m1.gpr in fn_space(x86_64_linux.Reg, bits(64)) by simp(hM1)
  have xu: m1.xmm in univ(1) by simp(m1u)
  have tx: m1.xmm in fn_space(x86_64_linux.Reg, bits(128)) by simp(hM1)
  have fu: m1.flags in univ(1) by simp(m1u)
  have tf: m1.flags in x86_64_linux.Flags by simp(hM1)
  have co8 := mp(all_elim(apW, {"objs"}), simp())
  have hnmS := rewrite(sym(mp(all_elim(apS, {"fs_base"}), simp())), rewrite(sym(a1), rewrite(sym(a8), rewrite(sym(c8), rewrite(sym(co8), hnm)))))
  have rt := apply(abi.ret_intro_g, {G}, {f}, {spec}, {args}, {objs}, {mem}, {S}, {m1.vm}, {W2}, {m1.gpr[0]}, {m1.gpr[2]}, {m1.gpr}, {m1.xmm}, {m1.flags},
    Su, ou, hmu, hsvS, hspS, hobS, hwmS, hcoS, hspec, W2u, h0, h1, hnu, hnv, hnmS, gu, tg, xu, tx, fu, tf)
  have rt2 := rewrite(m1e, rt)
  // its final state is m1 with h2: the ghost parts carried past the
  // machine's fields (h at the entry, h2 from the spec's world)
  have _ _ hz := mp(all_elim(hg, {h}), hh)
  have _ _ hz2 := mp(all_elim(hg, {h2}), hh2)
  have nk: all g. (all z. z in g -> !(fst(z) in abi.KEYS) && !(fst(z) in abi.WKEYS)) -> all k. k in abi.KEYS -> (all z. z in g -> fst(z) != k) proof
    fix g
    assume hzg
    fix k
    assume hk
    fix z
    assume hz3
    have a _ := mp(all_elim(hzg, {z}), hz3)
    show proof
      assume e
      have kz: fst(z) in abi.KEYS := rewrite(sym(e), hk)
      show by taut(a, kz)
    qed
  qed
  have UH: all X k v. k in abi.KEYS -> fn_update(union2(X, h), k, v) = union2(fn_update(X, k, v), h) proof
    fix X k v
    assume hk
    show := mp(fn_update_union_l[a := X, b := h, k := k, v := v], mp(all_elim(mp(all_elim(nk, {h}), hz), {k}), hk))
  qed
  have UH2: all X k v. k in abi.KEYS -> fn_update(union2(X, h2), k, v) = union2(fn_update(X, k, v), h2) proof
    fix X k v
    assume hk
    show := mp(fn_update_union_l[a := X, b := h2, k := k, v := v], mp(all_elim(mp(all_elim(nk, {h2}), hz2), {k}), hk))
  qed
  have AH2: all X k. k in abi.KEYS -> union2(X, h2)[k] = X[k] proof
    fix X k
    assume hk
    show := mp(app_union2_lacks[a := X, b := h2, k := k], mp(all_elim(mp(all_elim(nk, {h2}), hz2), {k}), hk))
  qed
  have hkk: all z. z in h -> !(fst(z) in abi.KEYS) proof
    fix z
    assume hz3
    have a _ := mp(all_elim(hz, {z}), hz3)
    show a
  qed
  have RH: all X. restrict(union2(X, h), abi.KEYS) = restrict(X, abi.KEYS) proof
    fix X
    show := mp(abi.restrict_union_g[a := X, b := h, d := abi.KEYS], hkk)
  qed
  have kf := apply(pow_cart_fst, unsel(expand(hM, x86_64_linux.Machine)))
  have rs0 := apply(restrict_all, kf)
  have fbu: false in univ(1) by simp()
  have bdm: m1.flags.df in bool by simp(hM1)
  have dfm := apply(not_eq_false, bdm, hdf)
  have a5 := mp(all_elim(apS, {"cpu"}), simp())
  have a6 := mp(all_elim(apS, {"fs_base"}), simp())
  have a7 := mp(all_elim(apS, {"gs_base"}), simp())
  have a9 := mp(all_elim(apS, {"os"}), simp())
  have a2 := mp(all_elim(apS, {"xmm"}), simp())
  have a3 := mp(all_elim(apS, {"rip"}), simp())
  have a4 := mp(all_elim(apS, {"flags"}), simp())
  have c6 := mp(all_elim(apW, {"fs_base"}), simp())
  have c9 := mp(all_elim(apW, {"os"}), simp())
  // (1) the world written back: s's fields updated, h beside them; its
  // machine part, with the spec's ghost part h2
  let V := m1.vm
  let O := W2.os
  let m2s := fn_update(fn_update(s, "vm", V), "os", O)
  have i1 := mp(all_elim(UH, {s}, {"vm"}, {V}), simp())
  have i2 := mp(all_elim(UH, {fn_update(s, "vm", V)}, {"os"}, {O}), simp())
  have em2 := rewrite(i2, rewrite(i1, refl({fn_update(fn_update(S, "vm", V), "os", O)}), {2}), {1})
  have sf: is_fun(s) && dom(s) = abi.KEYS by simp(expand(hM, x86_64_linux.Machine))
  have d1 := mp(fn_update_fd[f := s, k := "vm", v := V, d := abi.KEYS], sf.1, sf.2, simp())
  have d2 := mp(fn_update_fd[f := fn_update(s, "vm", V), k := "os", v := O, d := abi.KEYS], d1.1, d1.2, simp())
  have km := mp(abi.keys_of[f := m2s, d := abi.KEYS], d2.2)
  have erm: restrict(union2(m2s, h), abi.KEYS) = m2s := trans(all_elim(RH, {m2s}), mp(restrict_all[f := m2s, d := abi.KEYS], km))
  have ex12 := mp(abi.merge_eq[a := m2s, b := ghost_part(W2, abi.WKEYS), c := m2s, d := h2], refl({m2s}), gW)
  have rt3 := rewrite(ex12, rewrite(erm, rewrite(em2, rt2)))
  // (2) the havoc's registers, flags; each later update and read of the
  // machine's fields past h2
  let G1 := m1.gpr
  let X1 := m1.xmm
  let F1 := m1.flags
  let xxs := fn_update(fn_update(fn_update(m2s, "gpr", G1), "xmm", X1), "flags", F1)
  have j1 := mp(all_elim(UH2, {m2s}, {"gpr"}, {G1}), simp())
  have j2 := mp(all_elim(UH2, {fn_update(m2s, "gpr", G1)}, {"xmm"}, {X1}), simp())
  have j3 := mp(all_elim(UH2, {fn_update(fn_update(m2s, "gpr", G1), "xmm", X1)}, {"flags"}, {F1}), simp())
  have exx := rewrite(j3, rewrite(j2, rewrite(j1, refl({fn_update(fn_update(fn_update(union2(m2s, h2), "gpr", G1), "xmm", X1), "flags", F1)}), {2}), {1}), {1})
  have rt4 := rewrite(mp(all_elim(AH2, {xxs}, {"gpr"}), simp()), rewrite(exx, rt3))
  // (3) the callee-saved registers restored
  let GG := fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(xxs.gpr, 3, S.gpr[3]), 5, S.gpr[5]), 12, S.gpr[12]), 13, S.gpr[13]), 14, S.gpr[14]), 15, S.gpr[15])
  let xfs := fn_update(xxs, "gpr", GG)
  have rt5 := rewrite(mp(all_elim(AH2, {xfs}, {"gpr"}), simp()), rewrite(mp(all_elim(UH2, {xxs}, {"gpr"}, {GG}), simp()), rt4))
  // (4) rsp, rax, rdx, df, rip
  let SP := bits_add(64, S.gpr[4], 8)
  let aas := fn_update(xfs, "gpr", fn_update(xfs.gpr, 4, SP))
  have rt6 := rewrite(mp(all_elim(AH2, {aas}, {"gpr"}), simp()), rewrite(mp(all_elim(UH2, {xfs}, {"gpr"}, {fn_update(xfs.gpr, 4, SP)}), simp()), rt5))
  let bbs := fn_update(aas, "gpr", fn_update(aas.gpr, 0, m1.gpr[0]))
  have rt7 := rewrite(mp(all_elim(AH2, {bbs}, {"gpr"}), simp()), rewrite(mp(all_elim(UH2, {aas}, {"gpr"}, {fn_update(aas.gpr, 0, m1.gpr[0])}), simp()), rt6))
  let ccs := fn_update(bbs, "gpr", fn_update(bbs.gpr, 2, m1.gpr[2]))
  have rt8 := rewrite(mp(all_elim(AH2, {ccs}, {"flags"}), simp()), rewrite(mp(all_elim(UH2, {bbs}, {"gpr"}, {fn_update(bbs.gpr, 2, m1.gpr[2])}), simp()), rt7))
  let dds := fn_update(ccs, "flags", fn_update(ccs.flags, "df", false))
  let RET := x86_64_linux.le(S.vm.bytes, S.gpr[4], 8)
  have rt9 := rewrite(mp(all_elim(UH2, {dds}, {"rip"}, {RET}), simp()), rewrite(mp(all_elim(UH2, {ccs}, {"flags"}, {fn_update(ccs.flags, "df", false)}), simp()), rt8))
  // (5) the machine part: m1 (as abi.ret_case's)
  have rs1 := apply(restrict_all, apply(pow_cart_fst, unsel(expand(hM1, x86_64_linux.Machine))))
  have neq: fn_update(dds, "rip", RET) = m1 by simp(hM, hM1, su, m1u, hwu, hw, fbu, hos, hfs, hcpu, hgs, hrip, hrsp, hcs, dfm, a1, a2, a3, a4, a5, a6, a7, a8, a9, c6, c9)
  show := rewrite(neq, rt9)
qed

// ----------------------------------------------------------------------
//  Outcomes with a ghost part

theorem abi.wg_ok: all s v h. with_ghost(ok(s, v), h) = ok(union2(s, h), v)
proof
  fix s v h
  show by defs(simp(), with_ghost)
qed

theorem abi.wg_exc: all s e h. with_ghost(exc(s, e), h) = exc(union2(s, h), e)
proof
  fix s e h
  show by defs(simp(), with_ghost)
qed

theorem abi.wg_div: all t h. with_ghost(diverge(t), h) = diverge(t)
proof
  fix t h
  show by defs(simp(), with_ghost)
qed

theorem abi.ok_outcome_type(s, v, x, r): x in s -> r in v -> ok(x, r) in outcome_type(s, v)
proof
  assume hx hr
  have c := mp(mp(cart_intro[a := s, b := v, x := x, y := r], hx), hr)
  have w: ex z. z in cart(s, v) && ok(fst(z), snd(z)) = ok(x, r) by ex_intro({pair(x, r)}, simp(c))
  show by defs(taut(set_image_def[s := cart(s, v), f := z. ok(fst(z), snd(z)), y := ok(x, r)], w, union2_iff[a := set_image(cart(s, v), z. ok(fst(z), snd(z))), b := union2(set_image(cart(s, univ(1)), z. exc(fst(z), snd(z))), set_image(univ(1), t. diverge(t))), z := ok(x, r)]), outcome_type)
qed

theorem abi.div_outcome_type(s, v, t): t in univ(1) -> diverge(t) in outcome_type(s, v)
proof
  assume ht
  have w: ex t2. t2 in univ(1) && diverge(t2) = diverge(t) by ex_intro({t}, taut(ht, refl({diverge(t)})))
  show by defs(taut(set_image_def[s := univ(1), f := t2. diverge(t2), y := diverge(t)], w,
    union2_iff[a := set_image(cart(s, v), z. ok(fst(z), snd(z))), b := union2(set_image(cart(s, univ(1)), z. exc(fst(z), snd(z))), set_image(univ(1), t. diverge(t))), z := diverge(t)],
    union2_iff[a := set_image(cart(s, univ(1)), z. exc(fst(z), snd(z))), b := set_image(univ(1), t. diverge(t)), z := diverge(t)]), outcome_type)
qed

// (an outcome of a type: a return, an exception or a divergence, its parts typed)
theorem abi.outcome_type_elim(s, v, o): o in outcome_type(s, v) ->
  (ex x r. x in s && r in v && o = ok(x, r)) || (ex x e. x in s && e in univ(1) && o = exc(x, e)) || (ex t. t in univ(1) && o = diverge(t))
proof
  assume ho
  have u1 := union2_iff[a := set_image(cart(s, v), z. ok(fst(z), snd(z))), b := union2(set_image(cart(s, univ(1)), z. exc(fst(z), snd(z))), set_image(univ(1), t. diverge(t))), z := o]
  have u2 := union2_iff[a := set_image(cart(s, univ(1)), z. exc(fst(z), snd(z))), b := set_image(univ(1), t. diverge(t)), z := o]
  have i1 := set_image_def[s := cart(s, v), f := z. ok(fst(z), snd(z)), y := o]
  have i2 := set_image_def[s := cart(s, univ(1)), f := z. exc(fst(z), snd(z)), y := o]
  have i3 := set_image_def[s := univ(1), f := t. diverge(t), y := o]
  have m: (ex z. z in cart(s, v) && ok(fst(z), snd(z)) = o) || (ex z. z in cart(s, univ(1)) && exc(fst(z), snd(z)) = o) || (ex t. t in univ(1) && diverge(t) = o)
    by taut(expand(ho, outcome_type), u1, u2, i1, i2, i3)
  have c1: (ex z. z in cart(s, v) && ok(fst(z), snd(z)) = o) -> ex x r. x in s && r in v && o = ok(x, r) proof
    assume e
    obtain z, hz hzo from e
    obtain x y, hx hy hp from apply(cart_elim, hz)
    show by ex_intro({x}, {y}, simp(hx, hy, sym(hzo), hp))
  qed
  have c2: (ex z. z in cart(s, univ(1)) && exc(fst(z), snd(z)) = o) -> ex x e. x in s && e in univ(1) && o = exc(x, e) proof
    assume e
    obtain z, hz hzo from e
    obtain x y, hx hy hp from apply(cart_elim, hz)
    show by ex_intro({x}, {y}, simp(hx, hy, sym(hzo), hp))
  qed
  have c3: (ex t. t in univ(1) && diverge(t) = o) -> ex t. t in univ(1) && o = diverge(t) proof
    assume e
    obtain t, ht hto from e
    show by ex_intro({t}, taut(ht, sym(hto)))
  qed
  show by taut(m, c1, c2, c3)
qed

// low refines spec over World & G but for stack overflows that keep the
// world's OS state (its I/O: the ABI's own crash branch allows them, as at
// the call); of its outcomes, the returns of a pair of words, exceptions
// and divergences
// ... from the world s with the ghost part h
abbrev abi.refines_ovf_at(low, spec, G, s, h) := all o. runs(low, s, o) ->
  abi.outcome(o) -> (all x v. o = ok(x, v) -> v in cart(bits(64), bits(64))) ->
  (ex h2. h2 in G && runs(spec, union2(s, h), with_ghost(o, h2))) ||
  (ex x. o = exc(x, exc_val("stack_overflow", empty)) && x.os = s.os)
abbrev abi.refines_ovf(low, spec, G) := all s h. s in abi.World -> h in G -> abi.refines_ovf_at(low, spec, G, s, h)

// (a refinement: so too)
theorem abi.ovf_of_ref(low, spec, G): refines_ghost(low, spec, abi.World, G) -> abi.refines_ovf(low, spec, G)
proof
  assume hr
  fix s h
  assume hs hh
  fix o
  assume hro _ _
  show by taut(mp(all_elim(expand(hr, refines_ghost), {s}, {h}, {o}), hs, hh, hro))
qed

// (... an outcome no such overflow: the spec's)
theorem abi.ovf_left(low, spec, G, s, h, o): abi.refines_ovf_at(low, spec, G, s, h) -> runs(low, s, o) -> abi.outcome(o) ->
  (all x v. o = ok(x, v) -> v in cart(bits(64), bits(64))) -> !(ex e x. o = exc(x, e) && e = exc_val("stack_overflow", empty)) ->
  ex h2. h2 in G && runs(spec, union2(s, h), with_ghost(o, h2))
proof
  assume hr hro hsh hv hn
  have d := mp(all_elim(hr, {o}), hro, hsh, hv)
  have r: (ex x. o = exc(x, exc_val("stack_overflow", empty)) && x.os = s.os) -> false proof
    assume w
    obtain x, e1 _ from w
    show by taut(hn, (ex e x. o = exc(x, e) && e = exc_val("stack_overflow", empty) by ex_intro({exc_val("stack_overflow", empty)}, {x}, taut(e1, refl({exc_val("stack_overflow", empty)})))))
  qed
  show by taut(d, r)
qed

// (... so a return of a pair of words, an exception but an overflow, a
// divergence)
theorem abi.ov_ok(low, spec, G, s, h, x, v): abi.refines_ovf_at(low, spec, G, s, h) -> v in cart(bits(64), bits(64)) ->
  runs(low, s, ok(x, v)) -> ex h2. h2 in G && runs(spec, union2(s, h), with_ghost(ok(x, v), h2))
proof
  assume hr hv hro
  have vt: all x9 v9. ok(x, v) = ok(x9, v9) -> v9 in cart(bits(64), bits(64)) proof
    fix x9 v9
    assume e9
    have vv: v = v9 by simp(e9)
    show := rewrite(vv, hv)
  qed
  have no: !(ex e9 x9. ok(x, v) = exc(x9, e9) && e9 = exc_val("stack_overflow", empty)) proof
    assume w9
    obtain e9 x9, q9 _ from w9
    show by simp(q9)
  qed
  have sh: abi.outcome(ok(x, v)) by disj({1}, ex_intro({x}, {v}, refl({ok(x, v)})))
  show := apply(abi.ovf_left, hr, hro, sh, vt, no)
qed

theorem abi.ov_exc(low, spec, G, s, h, x, e): abi.refines_ovf_at(low, spec, G, s, h) -> !(e = exc_val("stack_overflow", empty)) ->
  runs(low, s, exc(x, e)) -> ex h2. h2 in G && runs(spec, union2(s, h), with_ghost(exc(x, e), h2))
proof
  assume hr hn hro
  have vt: all x9 v9. exc(x, e) = ok(x9, v9) -> v9 in cart(bits(64), bits(64)) proof
    fix x9 v9
    assume e9
    show by simp(e9)
  qed
  have no: !(ex e9 x9. exc(x, e) = exc(x9, e9) && e9 = exc_val("stack_overflow", empty)) proof
    assume w9
    obtain e9 x9, q9 r9 from w9
    have ee: e = e9 by simp(q9)
    show by taut(hn, rewrite(sym(ee), r9))
  qed
  have sh: abi.outcome(exc(x, e)) by disj({2}, ex_intro({x}, {e}, refl({exc(x, e)})))
  show := apply(abi.ovf_left, hr, hro, sh, vt, no)
qed

theorem abi.ov_div(low, spec, G, s, h, t): abi.refines_ovf_at(low, spec, G, s, h) ->
  runs(low, s, diverge(t)) -> ex h2. h2 in G && runs(spec, union2(s, h), with_ghost(diverge(t), h2))
proof
  assume hr hro
  have vt: all x9 v9. diverge(t) = ok(x9, v9) -> v9 in cart(bits(64), bits(64)) proof
    fix x9 v9
    assume e9
    show by simp(e9)
  qed
  have no: !(ex e9 x9. diverge(t) = exc(x9, e9) && e9 = exc_val("stack_overflow", empty)) proof
    assume w9
    obtain e9 x9, q9 _ from w9
    show by simp(q9)
  qed
  have sh: abi.outcome(diverge(t)) by disj({3}, ex_intro({t}, refl({diverge(t)})))
  show := apply(abi.ovf_left, hr, hro, sh, vt, no)
qed

// I/O of a stack overflow the ghost-free spec allows: the spec over
// World & G allows it too (from the world with h)
theorem abi.overflow_ok_g: all G w h low spec args crash. abi.ghost_ok(G) -> h in G -> w in abi.World ->
  abi.refines_ovf_at(low[args], spec[args], G, w, h) ->
  abi.overflow_ok(rec_and(abi.World, single(empty)), w, low, args, crash) ->
  abi.overflow_ok(rec_and(abi.World, G), union2(w, h), spec, args, crash)
proof
  fix G w h low spec args crash
  assume hg hh hw href hov
  have hin hevs := expand(hov, abi.overflow_ok)
  have _ _ apW := apply(abi.ghost_parts_w, hg, hh, hw)
  have aos := mp(all_elim(apW, {"os"}), simp())
  have hin2 := rewrite(sym(aos), hin)
  have rf := href
  let CT := cart(bits(64), bits(64))
  let EXG := ex x0. x0 in outcome_type(rec_and(abi.World, G), CT) && (runs(spec[args], union2(w, h), x0) &&
      ite(fst(x0) = 0, fst(snd(x0)).os.events = crash.events,
        ite(fst(x0) = 1, snd(snd(x0)) = exc_val("stack_overflow", empty) && fst(snd(x0)).os.events = crash.events,
          snd(x0)["os.events"] = crash.events)))
  have ev: (union2(w, h).os.events = crash.events) || EXG proof
    have at: w.os.events = crash.events -> union2(w, h).os.events = crash.events proof
      assume e
      show := rewrite(sym(aos), e)
    qed
    have ex1: (ex x0. x0 in outcome_type(rec_and(abi.World, single(empty)), CT) && (runs(low[args], w, x0) &&
        ite(fst(x0) = 0, fst(snd(x0)).os.events = crash.events,
          ite(fst(x0) = 1, snd(snd(x0)) = exc_val("stack_overflow", empty) && fst(snd(x0)).os.events = crash.events,
            snd(x0)["os.events"] = crash.events)))) -> (union2(w, h).os.events = crash.events) || EXG proof
      assume e
      obtain x0, hot hrr from e
      have hrun hite := hrr
      have sh := apply(abi.outcome_type_elim, hot)
      have k1: (ex x r. x in rec_and(abi.World, single(empty)) && r in CT && x0 = ok(x, r)) -> EXG proof
        assume e1
        obtain x r, hx hr hx0 from e1
        have vt: all x9 v. x0 = ok(x9, v) -> v in CT proof
          fix x9 v
          assume e9
          have rv: r = v by simp(rewrite(hx0, e9))
          show := rewrite(rv, hr)
        qed
        have no: !(ex e9 x9. x0 = exc(x9, e9) && e9 = exc_val("stack_overflow", empty)) proof
          assume w9
          obtain e9 x9, q9 _ from w9
          show by simp(rewrite(hx0, q9))
        qed
        have sh0: abi.outcome(x0) by disj({1}, ex_intro({x}, {r}, hx0))
        obtain h2, hh2 hrun2 from apply(abi.ovf_left[low := low[args], spec := spec[args], G := G, s := w, h := h, o := x0], rf, hrun, sh0, vt, no)
        have xw := apply(tr.and_world, hx)
        have _ _ apX := apply(abi.ghost_parts_w, hg, hh2, xw)
        have xos := mp(all_elim(apX, {"os"}), simp())
        have ot := mp(abi.ok_outcome_type[s := rec_and(abi.World, G), v := CT, x := union2(x, h2), r := r], apply(rec_and_intro, xw, hh2), hr)
        have r2 := rewrite(all_elim(abi.wg_ok, {x}, {r}, {h2}), rewrite(hx0, hrun2))
        have it2: x.os.events = crash.events by simp(rewrite(hx0, hite))
        have it3 := rewrite(sym(xos), it2)
        show by ex_intro({ok(union2(x, h2), r)}, simp(ot, r2, it3))
      qed
      have k2: (ex x e. x in rec_and(abi.World, single(empty)) && e in univ(1) && x0 = exc(x, e)) -> (union2(w, h).os.events = crash.events) || EXG proof
        assume e1
        obtain x ee, hx he hx0 from e1
        have it2: ee = exc_val("stack_overflow", empty) && x.os.events = crash.events by simp(rewrite(hx0, hite))
        have vt: all x9 v. x0 = ok(x9, v) -> v in CT proof
          fix x9 v
          assume e9
          show by simp(rewrite(hx0, e9))
        qed
        have sh0: abi.outcome(x0) by disj({2}, ex_intro({x}, {ee}, hx0))
        have d := mp(all_elim(rf, {x0}), hrun, sh0, vt)
        // the overflow keeping the world's OS state: as at the call
        have c0: (ex x9. x0 = exc(x9, exc_val("stack_overflow", empty)) && x9.os = w.os) -> union2(w, h).os.events = crash.events proof
          assume w9
          obtain x9, q9 o9 from w9
          have xx: x = x9 by simp(rewrite(hx0, q9))
          have _ i2 := it2
          have ev: w.os.events = crash.events := rewrite(o9, rewrite(xx, i2))
          show := rewrite(sym(aos), ev)
        qed
        have c1: (ex h2. h2 in G && runs(spec[args], union2(w, h), with_ghost(x0, h2))) -> EXG proof
          assume w9
          obtain h2, hh2 hrun2 from w9
          have xw := apply(tr.and_world, hx)
          have _ _ apX := apply(abi.ghost_parts_w, hg, hh2, xw)
          have xos := mp(all_elim(apX, {"os"}), simp())
          have ot := mp(exc_outcome_type[s := rec_and(abi.World, G), v := CT, x := union2(x, h2), e := ee], apply(rec_and_intro, xw, hh2), he)
          have r2 := rewrite(all_elim(abi.wg_exc, {x}, {ee}, {h2}), rewrite(hx0, hrun2))
          have it3 := rewrite(sym(xos), it2)
          show by ex_intro({exc(union2(x, h2), ee)}, simp(ot, r2, it3))
        qed
        show by taut(d, c0, c1)
      qed
      have k3: (ex t. t in univ(1) && x0 = diverge(t)) -> EXG proof
        assume e1
        obtain t, ht hx0 from e1
        have vt: all x9 v. x0 = ok(x9, v) -> v in CT proof
          fix x9 v
          assume e9
          show by simp(rewrite(hx0, e9))
        qed
        have no: !(ex e9 x9. x0 = exc(x9, e9) && e9 = exc_val("stack_overflow", empty)) proof
          assume w9
          obtain e9 x9, q9 _ from w9
          show by simp(rewrite(hx0, q9))
        qed
        have sh0: abi.outcome(x0) by disj({3}, ex_intro({t}, hx0))
        obtain h2, hh2 hrun2 from apply(abi.ovf_left[low := low[args], spec := spec[args], G := G, s := w, h := h, o := x0], rf, hrun, sh0, vt, no)
        have ot := mp(abi.div_outcome_type[s := rec_and(abi.World, G), v := CT, t := t], ht)
        have r2 := rewrite(all_elim(abi.wg_div, {t}, {h2}), rewrite(hx0, hrun2))
        have it2: t["os.events"] = crash.events by simp(rewrite(hx0, hite))
        show by ex_intro({diverge(t)}, simp(ot, r2, it2))
      qed
      show by taut(sh, k1, k2, k3)
    qed
    show by taut(hevs, at, ex1)
  qed
  show by defs(taut(hin2, ev), abi.overflow_ok)
qed

// (a machine run's outcome with a ghost part: in the universe, an outcome)
theorem abi.wg_univ: all s o h. pair(s, o) in univ(1) -> h in univ(1) -> abi.outcome(o) ->
  pair(union2(s, h), with_ghost(o, h)) in univ(1) && abi.outcome(with_ghost(o, h))
proof
  fix s o h
  assume hp hu ho
  have su: s in univ(1) by simp(hp)
  have Su := mp(union2_univ[u := 1, a := s, b := h], su, hu)
  have c1: (ex m1 e. o = ok(m1, e)) -> pair(union2(s, h), with_ghost(o, h)) in univ(1) && abi.outcome(with_ghost(o, h)) proof
    assume e
    obtain m1 ee, eo from e
    have mu: m1 in univ(1) && ee in univ(1) by simp(rewrite(eo, hp))
    have Mu := mp(union2_univ[u := 1, a := m1, b := h], mu.1, hu)
    have w := all_elim(abi.wg_ok, {m1}, {ee}, {h})
    have g1: pair(union2(s, h), ok(union2(m1, h), ee)) in univ(1) && abi.outcome(ok(union2(m1, h), ee)) by simp(Su, Mu, mu)
    show := rewrite(sym(eo), rewrite(sym(w), g1))
  qed
  have c2: (ex m1 e. o = exc(m1, e)) -> pair(union2(s, h), with_ghost(o, h)) in univ(1) && abi.outcome(with_ghost(o, h)) proof
    assume e
    obtain m1 ee, eo from e
    have mu: m1 in univ(1) && ee in univ(1) by simp(rewrite(eo, hp))
    have Mu := mp(union2_univ[u := 1, a := m1, b := h], mu.1, hu)
    have w := all_elim(abi.wg_exc, {m1}, {ee}, {h})
    have g1: pair(union2(s, h), exc(union2(m1, h), ee)) in univ(1) && abi.outcome(exc(union2(m1, h), ee)) by simp(Su, Mu, mu)
    show := rewrite(sym(eo), rewrite(sym(w), g1))
  qed
  have c3: (ex t. o = diverge(t)) -> pair(union2(s, h), with_ghost(o, h)) in univ(1) && abi.outcome(with_ghost(o, h)) proof
    assume e
    obtain t, eo from e
    have tu: t in univ(1) by simp(rewrite(eo, hp))
    have w := all_elim(abi.wg_div, {t}, {h})
    have g1: pair(union2(s, h), diverge(t)) in univ(1) && abi.outcome(diverge(t)) by simp(Su, tu)
    show := rewrite(sym(eo), rewrite(sym(w), g1))
  qed
  show by taut(ho, c1, c2, c3)
qed

// ----------------------------------------------------------------------
//  The bridge with a ghost: from C1's matching against the ghost-free
//  function low, and low refining spec over World & G

// a run C1 matched with low is one abi_function allows for spec, from the
// entry with any ghost part h (the final one: spec's)
// A spec over the world with a ghost part diverges only where it raises
// (undefined there: a contract's body has no loop), the raise's state a
// world with a ghost part
def tr.div_raises_g(G, spec) := all args w h t. args in abi.ARGS -> w in abi.World -> w in univ(1) -> h in G -> runs(spec[args], union2(w, h), diverge(t)) ->
  (ex e x. e in univ(1) && !(e = exc_val("stack_overflow", empty)) && abi.nstop(e) && x in rec_and(abi.World, G) &&
    runs(spec[args], union2(w, h), exc(x, e)))

// ... the code low diverging only where the spec raises: from the world w
// with the ghost part h, and from any
abbrev tr.div_low_at(low, spec, G, w, h) := all t. runs(low, w, diverge(t)) ->
  (ex e x. e in univ(1) && !(e = exc_val("stack_overflow", empty)) && abi.nstop(e) && x in rec_and(abi.World, G) && runs(spec, union2(w, h), exc(x, e)))
def tr.div_raises_low(low, spec, G) := all args w h. args in abi.ARGS -> w in abi.World -> w in univ(1) -> h in G -> tr.div_low_at(low[args], spec[args], G, w, h)

// (so where the spec diverges only where it raises, low refining it)
theorem tr.div_low_of(low, spec, G): tr.div_raises_g(G, spec) -> (all args. args in abi.ARGS -> abi.refines_ovf(low[args], spec[args], G)) ->
  tr.div_raises_low(low, spec, G)
proof
  assume hdg hrf
  unfold tr.div_raises_low
  fix args w h
  assume hA hw hwu hh
  fix t
  assume hr
  obtain h2, hh2 r2 from apply(abi.ov_div[low := low[args], spec := spec[args], G := G, s := w, h := h, t := t], mp(all_elim(mp(all_elim(hrf, {args}), hA), {w}, {h}), hw, hh), hr)
  have r3 := rewrite(all_elim(abi.wg_div, {t}, {h2}), r2)
  show := mp(all_elim(expand(hdg, tr.div_raises_g), {args}, {w}, {h}, {t}), hA, hw, hwu, hh, r3)
qed

// (the world at an entry: a world in the universe)
theorem abi.view_typed(s, objs, mem): s in x86_64_linux.Machine -> s in univ(1) -> objs in set_type(omega) -> mem in x86_64_linux.Vm ->
  abi.view(s, objs, mem) in univ(1) && abi.view(s, objs, mem) in abi.World
proof
  assume hM su hot hmv
  have ou := apply(abi.objs_univ, hot)
  have hmu := apply(x86.vm_univ, hmv)
  have vu: abi.view(s, objs, mem) in univ(1) by simp(su, ou, hmu, mp(all_elim(abi.objs_at_univ, {objs}, {s.fs_base}), ou))
  have vW := apply(abi.world_typed, hM, hot, hmv, vu)
  show by taut(vu, vW)
qed

theorem abi.bridge_run_g: all G f low spec args objs mem s h o. abi.ghost_ok(G) -> h in G ->
  abi.refines_ovf_at(low[args], spec[args], G, abi.view(s, objs, mem), h) -> tr.div_low_at(low[args], spec[args], G, abi.view(s, objs, mem), h) -> args in abi.ARGS ->
  s in x86_64_linux.Machine -> abi.entry_ok(s, args) -> objs in set_type(omega) ->
  (all x. x in omega -> x in objs -> (int_le(abi.sp(s), x) && abi.stack_page(s.vm, int_div(x, x86_64_linux.PAGE))) && x86_64_linux.can_access(s.vm, bits_of_int(64, x), 1)) -> mem in x86_64_linux.Vm -> abi.view_ok(s, objs, mem) ->
  runs(abi.run_to_return(), s, o) -> abi.matches(low, args, objs, mem, s, o) || (ex t. runs(low[args], abi.view(s, objs, mem), diverge(t))) ->
  ex h2. h2 in G && runs(abi.abi_function(G, f, spec, args, objs, mem), union2(s, h), with_ghost(o, h2))
proof
  fix G f low spec args objs mem s h o
  assume hg hh href hdg hA hM he hot hob hmv hwm hr hm
  have hp := apply(abi.run_univ, hr)
  have hsh := apply(abi.run_shape, hr)
  have su: s in univ(1) by simp(hp)
  have hu _ _ := mp(all_elim(hg, {h}), hh)
  have ou := apply(abi.objs_univ, hot)
  have hmu := apply(x86.vm_univ, hmv)
  have vu: abi.view(s, objs, mem) in univ(1) by simp(su, ou, hmu, mp(all_elim(abi.objs_at_univ, {objs}, {s.fs_base}), ou))
  have vW := apply(abi.world_typed, hM, hot, hmv, vu)
  let GOAL := ex h2. h2 in G && runs(abi.abi_function(G, f, spec, args, objs, mem), union2(s, h), with_ghost(o, h2))
  // the spec raises: anything
  have c1: abi.raises_ab(low, args, objs, mem, s) -> GOAL proof
    assume hra
    obtain e x, eu eno _ hx rx from expand(hra, abi.raises_ab)
    obtain h2, hh2 r2 from apply(abi.ov_exc[low := low[args], spec := spec[args], G := G, s := abi.view(s, objs, mem), h := h, x := x, e := e], href, eno, rx)
    have r3 := rewrite(all_elim(abi.wg_exc, {x}, {e}, {h2}), r2)
    have xg: union2(x, h2) in rec_and(abi.World, G) := apply(rec_and_intro, apply(tr.and_world, expand(hx, abi.raise_state)), hh2)
    have ho: abi.outcome(o) by simp(hsh)
    have pu ou2 := apply(abi.wg_univ, hp, hu, ho)
    have r := apply(abi.ub_case_g, {G}, {f}, {spec}, {args}, {objs}, {mem}, {s}, {h}, {with_ghost(o, h)}, {e}, {union2(x, h2)}, hg, hh, hM, su, hot, hmv, hwm, hob, eu, eno, xg, r3, pu, ou2)
    show by ex_intro({h}, taut(hh, r))
  qed
  // a return
  have c2: (ex m1 w2. o = ok(m1, empty) && m1 in x86_64_linux.Machine &&
      runs(low[args], abi.view(s, objs, mem), ok(w2, pair(m1.gpr[0], m1.gpr[2]))) && w2 in abi.World && w2 in univ(1) &&
      abi.world_matches(s.vm, m1.vm, w2.vm, abi.wob(objs, w2.objs.c_bytes), s.fs_base, abi.sp(s)) && m1.os = w2.os && m1.fs_base = s.fs_base &&
      m1.cpu = s.cpu && m1.gs_base = s.gs_base && m1.rip = abi.ret(s) && m1.gpr[4] = abi.sp(s) &&
      abi.callee_saved(m1, s) && !m1.flags.df) -> GOAL proof
    assume hc
    obtain m1 w2, eo m1M rw w2W w2u wm2 xos xfs xcpu xgs xrip xr4 xcs xdf from hc
    have g0: m1.gpr[0] in bits(64) by simp(m1M)
    have g2: m1.gpr[2] in bits(64) by simp(m1M)
    have pv := apply(cart_intro, g0, g2)
    obtain h2, hh2 r2 from apply(abi.ov_ok[low := low[args], spec := spec[args], G := G, s := abi.view(s, objs, mem), h := h, x := w2, v := pair(m1.gpr[0], m1.gpr[2])], href, pv, rw)
    have r3 := rewrite(all_elim(abi.wg_ok, {w2}, {pair(m1.gpr[0], m1.gpr[2])}, {h2}), r2)
    have hp1 := rewrite(eo, hp)
    have rt := apply(abi.ret_case_g, {G}, {f}, {spec}, {args}, {objs}, {mem}, {s}, {h}, {m1}, {w2}, {h2}, hg, hh, hh2, hM, he, m1M, hp1, hot, hob, hmv, hwm,
      r3, w2W, w2u, wm2, xos, xfs, xcpu, xgs, xrip, xr4, xcs, xdf)
    have wo := rewrite(sym(eo), rewrite(sym(all_elim(abi.wg_ok, {m1}, {empty}, {h2})), rt))
    show by ex_intro({h2}, taut(hh2, wo))
  qed
  // a divergence
  have c3: (ex t. o = diverge(t) && runs(low[args], abi.view(s, objs, mem), diverge(t))) -> GOAL proof
    assume hc
    obtain t, eo rd from hc
    obtain h2, hh2 r2 from apply(abi.ov_div[low := low[args], spec := spec[args], G := G, s := abi.view(s, objs, mem), h := h, t := t], href, rd)
    have r3 := rewrite(all_elim(abi.wg_div, {t}, {h2}), r2)
    have hp1 := rewrite(eo, hp)
    have dv := apply(abi.div_case_g, {G}, {f}, {spec}, {args}, {objs}, {mem}, {s}, {h}, {t}, hg, hh, hM, hp1, hot, hob, hmv, hwm, r3)
    have wo := rewrite(sym(eo), rewrite(sym(all_elim(abi.wg_div, {t}, {h2})), dv))
    show by ex_intro({h2}, taut(hh2, wo))
  qed
  // a crash
  have c4: abi.crashes_at(low, args, objs, mem, s, o) -> GOAL proof
    assume hc
    obtain m1 a k, oe m1M ab sev ovk from expand(hc, abi.crashes_at)
    have ovg := apply(abi.overflow_ok_g, {G}, {abi.view(s, objs, mem)}, {h}, {low}, {spec}, {args}, {m1.os}, hg, hh, vW, href, ovk)
    have cr: all cv. o = exc(m1, cv) ->
        ((ex a2 k2. cv = exc_val("segv", pair(a2, k2)) && (k2 = 0 || k2 = 1 || k2 = 3) && a2 in bits(64) && abi.overflow_at(m1.vm, m1.gpr[4], abi.sp(s), a2)) ||
          cv = exc_val("stack_fault", empty)) -> GOAL proof
      fix cv
      assume eo hcv
      have hp1 := rewrite(eo, hp)
      have r := apply(abi.crash_case_g, {G}, {f}, {spec}, {args}, {objs}, {mem}, {s}, {h}, {m1}, {cv}, hg, hh, hM, hp1, hot, hob, hmv, hwm, hcv, m1M, sev, ovg)
      have wo := rewrite(sym(eo), rewrite(sym(all_elim(abi.wg_exc, {m1}, {cv}, {h})), r))
      show by ex_intro({h}, taut(hh, wo))
    qed
    have k1: (o = exc(m1, exc_val("segv", pair(a, k))) && (k = 0 || k = 1 || k = 3) && abi.overflow_at(m1.vm, m1.gpr[4], abi.sp(s), a)) -> GOAL proof
      assume h1
      have eo kk ov := h1
      have ex1: ex a2 k2. exc_val("segv", pair(a, k)) = exc_val("segv", pair(a2, k2)) && (k2 = 0 || k2 = 1 || k2 = 3) && a2 in bits(64) &&
          abi.overflow_at(m1.vm, m1.gpr[4], abi.sp(s), a2) by ex_intro({a}, {k}, taut(refl({exc_val("segv", pair(a, k))}), kk, ab, ov))
      show := mp(all_elim(cr, {exc_val("segv", pair(a, k))}), eo, taut(ex1))
    qed
    have k2: o = exc(m1, exc_val("stack_fault", empty)) -> GOAL proof
      assume eo
      show := mp(all_elim(cr, {exc_val("stack_fault", empty)}), eo, taut(refl({exc_val("stack_fault", empty)})))
    qed
    show by taut(oe, k1, k2)
  qed
  // the code diverging (its trace not compared): the spec raises there
  have c5: (ex t. runs(low[args], abi.view(s, objs, mem), diverge(t))) -> GOAL proof
    assume hc
    obtain t, rd from hc
    obtain e x, eu eno _ xg rx from mp(all_elim(hdg, {t}), rd)
    have ho: abi.outcome(o) by simp(hsh)
    have pu ou2 := apply(abi.wg_univ, hp, hu, ho)
    have r := apply(abi.ub_case_g, {G}, {f}, {spec}, {args}, {objs}, {mem}, {s}, {h}, {with_ghost(o, h)}, {e}, {x}, hg, hh, hM, su, hot, hmv, hwm, hob, eu, eno, xg, rx, pu, ou2)
    show by ex_intro({h}, taut(hh, r))
  qed
  show by taut(hm, expand(hm, abi.matches), c1, c2, c3, c4, c5)
qed

// the contract with a ghost: from the runs C1 matched with low, low
// refining spec (for every arguments) over World & G
theorem abi.bridge_implements_g: all G f low spec base code statics. abi.ghost_ok(G) ->
  (all args. args in abi.ARGS -> abi.refines_ovf(low[args], spec[args], G)) -> tr.div_raises_g(G, spec) ->
  (all args objs mem s o. args in abi.ARGS -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> abi.loaded(s.vm, base, code, statics) -> s.rip = f ->
    abi.entry_ok(s, args) -> (all x. x in omega -> x in objs -> (int_le(abi.sp(s), x) && abi.stack_page(s.vm, int_div(x, x86_64_linux.PAGE))) && x86_64_linux.can_access(s.vm, bits_of_int(64, x), 1)) -> abi.view_ok(s, objs, mem) ->
    runs(abi.run_to_return(), s, o) -> abi.matches(low, args, objs, mem, s, o) || (ex t. runs(low[args], abi.view(s, objs, mem), diverge(t)))) ->
  abi.implements2_at(G, f, spec, base, code, statics)
proof
  fix G f low spec base code statics
  assume hg hrf hdg0 hb
  have hdg := apply(tr.div_low_of[low := low, spec := spec, G := G], hdg0, hrf)
  let ld(m) := abi.loaded(m.vm, base, code, statics)
  let rel(a, ob, mm) := mkprog(x1 x2. !ld(x1) || bind_rel(abi.abi_function(G, f, spec, a, ob, mm), x1, x3 x4. x2 = ok(x3, empty), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))
  have main: all x0. all x1. all x2. (x0 in abi.ARGS && x1 in set_type(omega)) && x2 in x86_64_linux.Vm -> (all s h o. s in x86_64_linux.Machine -> h in G -> runs(abi.run_to_return(), s, o) -> (ex h2. h2 in G && runs(rel(x0, x1, x2), union2(s, h), with_ghost(o, h2)))) proof
    fix args objs mem
    assume hAo
    have hA hot hmv := hAo
    show all s h o. s in x86_64_linux.Machine -> h in G -> runs(abi.run_to_return(), s, o) -> (ex h2. h2 in G && runs(rel(args, objs, mem), union2(s, h), with_ghost(o, h2))) proof
      fix s h o
      assume hM hh hr
      let S := union2(s, h)
      have hp := apply(abi.run_univ, hr)
      have hsh := apply(abi.run_shape, hr)
      have su: s in univ(1) by simp(hp)
      have ho: abi.outcome(o) by simp(hsh)
      have _ _ apS := apply(abi.ghost_parts, hg, hh, hM)
      have a1 := mp(all_elim(apS, {"gpr"}), simp())
      have a3 := mp(all_elim(apS, {"rip"}), simp())
      have a8 := mp(all_elim(apS, {"vm"}), simp())
      // a run of abi_function from S: one of rel's
      have hu _ _ := mp(all_elim(hg, {h}), hh)
      have Su := mp(union2_univ[u := 1, a := s, b := h], su, hu)
      have relO: all O. pair(S, O) in univ(1) -> ((ex m. O = ok(m, empty)) || (ex m e. O = exc(m, e)) || (ex t. O = diverge(t))) ->
          (!ld(S) || runs(abi.abi_function(G, f, spec, args, objs, mem), S, O)) -> runs(rel(args, objs, mem), S, O) proof
        fix O
        assume hpO hshO hx
        show by simp(hpO, hshO, hx, keep(abi.abi_function, abi.loaded, abi.run_to_return))
      qed
      have relk: all h2. h2 in G -> (!ld(S) || runs(abi.abi_function(G, f, spec, args, objs, mem), S, with_ghost(o, h2))) -> runs(rel(args, objs, mem), S, with_ghost(o, h2)) proof
        fix h2
        assume hh2 hx
        have hu2 _ _ := mp(all_elim(hg, {h2}), hh2)
        have pu _ := apply(abi.wg_univ, hp, hu2, ho)
        have wu: with_ghost(o, h2) in univ(1) by simp(pu)
        have pS: pair(S, with_ghost(o, h2)) in univ(1) by simp(Su, wu)
        have shp: (ex m. with_ghost(o, h2) = ok(m, empty)) || (ex m e. with_ghost(o, h2) = exc(m, e)) || (ex t. with_ghost(o, h2) = diverge(t)) proof
          have d1: (ex m. o = ok(m, empty)) -> (ex m. with_ghost(o, h2) = ok(m, empty)) proof
            assume e
            obtain m, eo from e
            show by ex_intro({union2(m, h2)}, rewrite(sym(eo), all_elim(abi.wg_ok, {m}, {empty}, {h2}), {1}))
          qed
          have d2: (ex m e. o = exc(m, e)) -> (ex m e. with_ghost(o, h2) = exc(m, e)) proof
            assume e
            obtain m ee, eo from e
            show by ex_intro({union2(m, h2)}, {ee}, rewrite(sym(eo), all_elim(abi.wg_exc, {m}, {ee}, {h2}), {1}))
          qed
          have d3: (ex t. o = diverge(t)) -> (ex t. with_ghost(o, h2) = diverge(t)) proof
            assume e
            obtain t, eo from e
            show by ex_intro({t}, rewrite(sym(eo), all_elim(abi.wg_div, {t}, {h2}), {1}))
          qed
          show by taut(hsh, d1, d2, d3)
        qed
        show := mp(all_elim(relO, {with_ghost(o, h2)}), pS, shp, hx)
      qed
      // abi_function's preconditions failing: anything (h kept)
      have pu0 _ := apply(abi.wg_univ, hp, hu, ho)
      have wu0: with_ghost(o, h) in univ(1) by simp(pu0)
      have pu: pair(S, with_ghost(o, h)) in univ(1) by simp(Su, wu0)
      have pre: !(S.rip = f && abi.entry_ok(S, args)) -> runs(abi.abi_function(G, f, spec, args, objs, mem), S, with_ghost(o, h)) proof
        assume hn
        show by simp(pu, hn, keep(abi.entry_ok, abi.world.get, abi.world.set, abi.abi_call, abi.abi_restore, abi.abi_set_result, abi.spec_raises, abi.overflow_ok, abi.overflow_at, with_ghost))
      qed
      have pre2: !(all x. x in omega -> x in objs -> (int_le(abi.sp(S), x) && abi.stack_page(S.vm, int_div(x, x86_64_linux.PAGE))) && x86_64_linux.can_access(S.vm, bits_of_int(64, x), 1)) -> runs(abi.abi_function(G, f, spec, args, objs, mem), S, with_ghost(o, h)) proof
        assume hn
        show by simp(pu, hn, keep(abi.entry_ok, abi.world.get, abi.world.set, abi.abi_call, abi.abi_restore, abi.abi_set_result, abi.spec_raises, abi.overflow_ok, abi.overflow_at, with_ghost))
      qed
      have pre3: !abi.view_ok(S, objs, mem) -> runs(abi.abi_function(G, f, spec, args, objs, mem), S, with_ghost(o, h)) proof
        assume hn
        show by simp(pu, hn, keep(abi.world_pages, abi.world_matches, abi.entry_ok, abi.world.get, abi.world.set, abi.abi_call, abi.abi_restore, abi.abi_set_result, abi.spec_raises, abi.overflow_ok, abi.overflow_at, with_ghost))
      qed
      // otherwise: the bridge's run
      have mc: ld(s) -> s.rip = f && abi.entry_ok(s, args) ->
          (all x. x in omega -> x in objs -> (int_le(abi.sp(s), x) && abi.stack_page(s.vm, int_div(x, x86_64_linux.PAGE))) && x86_64_linux.can_access(s.vm, bits_of_int(64, x), 1)) -> abi.view_ok(s, objs, mem) ->
          ex h2. h2 in G && runs(rel(args, objs, mem), S, with_ghost(o, h2)) proof
        assume hc hy hb2 hw
        have hm := mp(all_elim(hb, {args}, {objs}, {mem}, {s}, {o}), hA, hot, hmv, hM, hc, hy.1, hy.2, hb2, hw, hr)
        have vu vW := apply(abi.view_typed, hM, su, hot, hmv)
        have ra := mp(all_elim(mp(all_elim(hrf, {args}), hA), {abi.view(s, objs, mem)}, {h}), vW, hh)
        have da := mp(all_elim(expand(hdg, tr.div_raises_low), {args}, {abi.view(s, objs, mem)}, {h}), hA, vW, vu, hh)
        obtain h2, hh2 r from apply(abi.bridge_run_g, {G}, {f}, {low}, {spec}, {args}, {objs}, {mem}, {s}, {h}, {o}, hg, hh, ra, da, hA, hM, hy.2, hot, hb2, hmv, hw, hr, hm)
        show by ex_intro({h2}, taut(hh2, mp(all_elim(relk, {h2}), hh2, taut(r))))
      qed
      // (the preconditions as of S: s's)
      have a2 := mp(all_elim(apS, {"xmm"}), simp())
      have a4 := mp(all_elim(apS, {"flags"}), simp())
      have a5 := mp(all_elim(apS, {"cpu"}), simp())
      have a6 := mp(all_elim(apS, {"fs_base"}), simp())
      have a7 := mp(all_elim(apS, {"gs_base"}), simp())
      have a9 := mp(all_elim(apS, {"os"}), simp())
      have eS1: (S.rip = f && abi.entry_ok(S, args)) <-> (s.rip = f && abi.entry_ok(s, args)) by defs(simp(a1, a2, a3, a4, a5, a6, a7, a8, a9), abi.entry_ok)
      have eS2: (all x. x in omega -> x in objs -> (int_le(abi.sp(S), x) && abi.stack_page(S.vm, int_div(x, x86_64_linux.PAGE))) && x86_64_linux.can_access(S.vm, bits_of_int(64, x), 1)) <->
          (all x. x in omega -> x in objs -> (int_le(abi.sp(s), x) && abi.stack_page(s.vm, int_div(x, x86_64_linux.PAGE))) && x86_64_linux.can_access(s.vm, bits_of_int(64, x), 1)) by simp(a1, a8)
      have eS3: abi.view_ok(S, objs, mem) <-> abi.view_ok(s, objs, mem) by simp(a1, a8, a6)
      have eL: ld(S) <-> ld(s) by simp(a8)
      // the cases: not loaded, a precondition failing, or the bridge's run
      have nl: !ld(S) -> ex h2. h2 in G && runs(rel(args, objs, mem), S, with_ghost(o, h2)) proof
        assume hn
        show by ex_intro({h}, taut(hh, mp(all_elim(relk, {h}), hh, taut(hn))))
      qed
      have pf: !(S.rip = f && abi.entry_ok(S, args)) || !(all x. x in omega -> x in objs -> (int_le(abi.sp(S), x) && abi.stack_page(S.vm, int_div(x, x86_64_linux.PAGE))) && x86_64_linux.can_access(S.vm, bits_of_int(64, x), 1)) ||
          !abi.view_ok(S, objs, mem) -> ex h2. h2 in G && runs(rel(args, objs, mem), S, with_ghost(o, h2)) proof
        assume hn
        have r: runs(abi.abi_function(G, f, spec, args, objs, mem), S, with_ghost(o, h)) by taut(hn, pre, pre2, pre3)
        show by ex_intro({h}, taut(hh, mp(all_elim(relk, {h}), hh, taut(r))))
      qed
      show by taut(eS1, eS2, eS3, eL, nl, pf, mc)
    qed
  qed
  show by defs(main, abi.implements2_at, refines_ghost)
qed

// the bridge's contract: every run from an entry matched with the spec
// (tr.implements_abi's first step)
theorem tr.implements_matches_d: all f spec base code statics. tr.implements_at(f, spec, base, code, statics) ->
  all args objs mem s o. args in abi.ARGS -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> abi.loaded(s.vm, base, code, statics) -> s.rip = f ->
    abi.entry_ok(s, args) -> (all x. x in omega -> x in objs -> (int_le(abi.sp(s), x) && abi.stack_page(s.vm, int_div(x, x86_64_linux.PAGE))) && x86_64_linux.can_access(s.vm, bits_of_int(64, x), 1)) -> abi.view_ok(s, objs, mem) ->
    runs(abi.run_to_return(), s, o) -> abi.matches(spec, args, objs, mem, s, o) || (ex t. runs(spec[args], abi.view(s, objs, mem), diverge(t)))
proof
  fix f spec base code statics
  assume hi
  fix args objs mem s o
  assume hA hot hmv hM hl hrip he hob hwm hr
  have su: s in univ(1) by simp(apply(abi.run_univ, hr))
  have ok: tr.objs_ok(s, objs) by defs(hob, tr.objs_ok)
  have ou := apply(abi.objs_univ, hot)
  have mu := apply(x86.vm_univ, hmv)
  have hvu: abi.view(s, objs, mem) in univ(1) by simp(su, ou, mu, mp(all_elim(abi.objs_at_univ, {objs}, {s.fs_base}), ou))
  have hvW := apply(abi.world_typed, hM, hot, hmv, hvu)
  have c := expand(hi, tr.implements_at)
  have d := apply(tr.run_disc, {s}, {o}, hr)
  let DV := ex t. runs(spec[args], abi.view(s, objs, mem), diverge(t))
  have c1: tr.run_d(s, s, o) -> abi.matches(spec, args, objs, mem, s, o) || DV proof
    assume rd
    have mt := mp(all_elim(c, {args}, {objs}, {mem}, {s}, {o}), hA, hot, hmv, hM, su, hl, hrip, he, ok, hwm, rd)
    show := apply(tr.matches_t_abi_d, {spec}, {args}, {objs}, {mem}, {s}, {o}, mt)
  qed
  have c2: (ex x. tr.run_d(s, s, exc(x, exc_val("disc", empty)))) -> abi.matches(spec, args, objs, mem, s, o) || DV proof
    assume e
    obtain x, rd from e
    have mt := mp(all_elim(c, {args}, {objs}, {mem}, {s}, {exc(x, exc_val("disc", empty))}), hA, hot, hmv, hM, su, hl, hrip, he, ok, hwm, rd)
    have mx := apply(tr.matches_t_abi_d, {spec}, {args}, {objs}, {mem}, {s}, {exc(x, exc_val("disc", empty))}, mt)
    have mr: abi.matches(spec, args, objs, mem, s, exc(x, exc_val("disc", empty))) -> abi.matches(spec, args, objs, mem, s, o) proof
      assume h
      show := apply(tr.matches_raise, {spec}, {args}, {objs}, {mem}, {s}, {x}, {o}, h)
    qed
    show by taut(mx, mr)
  qed
  show by taut(d, c1, c2)
qed

// Machine code implementing (the bridge's contract) a ghost-free C
// function value low that refines a spec over World & G -- but for stack
// overflows keeping the I/O, the ABI's own crash -- implements the spec:
// the ABI's contract with G. The code's divergence (its trace not
// compared) is the spec's by the refinement; the spec raises there
// (`tr.div_raises_g`: a contract diverges only where it is undefined).
theorem tr.implements_abi_ov: all G f low spec base code statics. abi.ghost_ok(G) -> tr.div_raises_g(G, spec) -> tr.implements_at(f, low, base, code, statics) ->
  (all args. args in abi.ARGS -> abi.refines_ovf(low[args], spec[args], G)) ->
  abi.implements2_at(G, f, spec, base, code, statics)
proof
  fix G f low spec base code statics
  assume hg hdg hi hrf
  show := apply(abi.bridge_implements_g, hg, hrf, hdg, apply(tr.implements_matches_d, hi))
qed

// (... low refining the spec)
theorem tr.implements_abi_g: all G f low spec base code statics. abi.ghost_ok(G) -> tr.div_raises_g(G, spec) -> tr.implements_at(f, low, base, code, statics) ->
  (all args. args in abi.ARGS -> refines_ghost(low[args], spec[args], abi.World, G)) ->
  abi.implements2_at(G, f, spec, base, code, statics)
proof
  fix G f low spec base code statics
  assume hg hdg hi hrf
  have ro: all args. args in abi.ARGS -> abi.refines_ovf(low[args], spec[args], G) proof
    fix args
    assume hA
    show := apply(abi.ovf_of_ref, mp(all_elim(hrf, {args}), hA))
  qed
  show := apply(tr.implements_abi_ov, hg, hdg, hi, ro)
qed

// (a refinement, then one with ghosts: one with ghosts)
theorem g.refines_then_ghost: all p q r t G. refines(p, q, t) -> refines_ghost(q, r, t, G) -> refines_ghost(p, r, t, G)
proof
  fix p q r t G
  assume h1 h2
  have a := expand(h1, refines)
  have b := expand(h2, refines_ghost)
  fix s h o
  assume hs hh hr
  show := mp(all_elim(b, {s}, {h}, {o}), hs, hh, mp(all_elim(a, {s}, {o}), hs, hr))
qed

// ----------------------------------------------------------------------
//  The program loaded: from the spec's precondition

// The program loaded in the world's view of the memory (at a function's
// entry), the stack protector's word writable there: loaded in the
// machine's (the code's pages the world's, its bytes the C world's -- no
// code byte the canary's, which is writable)
theorem abi.loaded_of_view(vm, mem, objs, fs, sp, base, code, statics): fs in bits(64) ->
  abi.world_pages(vm, mem) -> abi.world_matches(vm, vm, mem, abi.objs_at(objs, fs), fs, sp) -> abi.canary_ok(mem, fs) ->
  abi.loaded(mem, base, code, statics) -> abi.loaded(vm, base, code, statics)
proof
  assume fsb hwp hwm hcn hl
  have lc ls := expand(hl, abi.loaded)
  have {top = top, lim = limit, bytes = bytes, nostk = nostk} := expand(hwm, abi.world_matches)
  have kp: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
  have cv: abi.code_at(vm, base, code) proof
    fix i
    assume hi hil
    let a := bits_of_int(64, int_add(base, i))
    have ab: a in bits(64) by simp()
    let p := int_div(a, x86_64_linux.PAGE)
    have f1 nw ns bt := mp(all_elim(expand(lc, abi.code_at), {i}), hi, hil)
    have mt mn _ := expand(expand(f1, x86_64_linux.fetchable, x86_64_linux.page_of), x86_64_linux.mapped)
    have ps: p in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) by sel(taut((p in omega by arith(ab, kp)), mt))
    have wp := mp(all_elim(expand(hwp, abi.world_pages), {p}), ps)
    have nsv: !abi.stack_page(vm, p) proof
      assume st
      have e0: mem.pages[p] = none by simp(wp, st)
      show by taut(mn, e0)
    qed
    have pe: mem.pages[p] = vm.pages[p] by simp(wp, nsv)
    have fv: x86_64_linux.fetchable(vm, a) by defs(taut(rewrite(pe, expand(expand(f1, x86_64_linux.fetchable, x86_64_linux.page_of), x86_64_linux.mapped))), x86_64_linux.fetchable, x86_64_linux.page_of, x86_64_linux.mapped)
    have nwv: !x86_64_linux.can_access(vm, a, 1) by defs(taut(rewrite(pe, expand(expand(nw, x86_64_linux.can_access, x86_64_linux.page_of), x86_64_linux.mapped))), x86_64_linux.can_access, x86_64_linux.page_of, x86_64_linux.mapped)
    have nsp: !abi.stack_page(vm, x86_64_linux.page_of(a)) by defs(nsv, x86_64_linux.page_of)
    // its byte: the C world's (no canary byte: writable), so the world's
    have nca: !(a in abi.canary(fs)) proof
      assume w
      have w1 w2 := (int_le(int_add(fs, 40), a) && int_lt(a, int_add(fs, 48)) by taut(set_select_def[s := omega, p := x0. int_le(int_add(fs, 40), x0) && int_lt(x0, int_add(fs, 48)), z := a], expand(w, abi.canary)))
      let j := int_sub(int_sub(a, fs), 40)
      have ja: int_add(int_add(fs, 40), j) = a by arith()
      have jo: j in omega by arith(w1)
      have jl: int_lt(j, 8) by arith(w2)
      have crd cwr := expand(hcn, abi.canary_ok)
      have r1 r2 := rewrite(ja, mp(all_elim(expand(crd, x86_64_linux.readable), {j}), jo, jl))
      have cw _ := rewrite(ja, mp(all_elim(cwr, {j}), jo, jl))
      have ca: x86_64_linux.can_access(mem, a, 1) by defs(simp(r1, r2, cw), x86_64_linux.can_access, x86_64_linux.page_of, x86_64_linux.hw_allows)
      show by taut(nw, ca)
    qed
    have kn := mp(all_elim(nostk, {p}), ps, mn)
    have mp1: x86_64_linux.mapped(mem, p) by defs(taut(mt, mn), x86_64_linux.mapped)
    have ao: a in omega by arith(ab)
    have dm: abi.in_domain(mem, abi.objs_at(objs, fs), a) by defs(simp(mp1, kn, nca, ao, keep(x86_64_linux.mapped)), abi.in_domain, abi.objs_at)
    have be := mp(all_elim(bytes, {a}), ab, dm)
    show by taut(fv, nwv, nsp, trans(be, bt))
  qed
  have sv: all x0. x0 in omega -> x0 in statics -> x86_64_linux.off_stack_space(vm, int_div(x0, x86_64_linux.PAGE), 1) proof
    fix x
    assume hx hs
    have o1 := mp(all_elim(ls, {x}), hx, hs)
    show by defs(rewrite(sym(lim), rewrite(sym(top), expand(o1, x86_64_linux.off_stack_space, x86_64_linux.stack_floor))), x86_64_linux.off_stack_space, x86_64_linux.stack_floor)
  qed
  show by defs(taut(cv, sv), abi.loaded)
qed

// The machine's thread pointer sound: so in the world's view of the memory
// (the descriptor's pages not the stack's -- the world's; its word not
// the canary's -- the C world's)
theorem abi.thread_view(vm, mem, objs, fs, sp): fs in bits(64) -> abi.world_pages(vm, mem) ->
  abi.world_matches(vm, vm, mem, abi.objs_at(objs, fs), fs, sp) -> abi.thread_ok(vm, fs) -> abi.thread_ok(mem, fs)
proof
  assume hf hwp hwm ht
  have rd ns le nz := expand(ht, abi.thread_ok)
  have {bytes = bytes, nostk = nostk} := expand(hwm, abi.world_matches)
  // (the descriptor's pages: the machine's, mapped, no stack page)
  have wp: all k. k in omega -> int_lt(k, 8) -> mem.pages[int_div(int_add(fs, k), x86_64_linux.PAGE)] = vm.pages[int_div(int_add(fs, k), x86_64_linux.PAGE)] &&
      x86_64_linux.mapped(vm, int_div(int_add(fs, k), x86_64_linux.PAGE)) && !abi.stack_page(vm, int_div(int_add(fs, k), x86_64_linux.PAGE)) proof
    fix k
    assume k1 k2
    let q := int_div(int_add(fs, k), x86_64_linux.PAGE)
    have r := mp(all_elim(expand(rd, x86_64_linux.readable), {k}), k1, k2)
    have n := mp(all_elim(ns, {k}), k1, k2)
    have mq := expand(r.1, x86_64_linux.mapped)
    have qp: q in gc.PN by simp(hf, k1, mq)
    have eq := mp(all_elim(expand(hwp, abi.world_pages), {q}), qp)
    have e2 := rewrite(mp(tr.ite_f[c := abi.stack_page(vm, q), a := none, b := vm.pages[q]], n), eq)
    show by taut(e2, r.1, n)
  qed
  have by: all k. k in omega -> int_lt(k, 8) -> mem.bytes[bits_add(64, fs, bits_of_int(64, k))] = vm.bytes[bits_add(64, fs, bits_of_int(64, k))] proof
    fix k
    assume k1 k2
    have r := mp(all_elim(expand(rd, x86_64_linux.readable), {k}), k1, k2)
    have pe mv nsv := mp(all_elim(wp, {k}), k1, k2)
    have lt: int_lt(int_add(fs, k), 18446744073709551616) by simp(expand(r, x86_64_linux.mapped, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE), k1)
    have ea: bits_add(64, fs, bits_of_int(64, k)) = int_add(fs, k) by defs(simp(hf, k1, k2, lt), bits_add, bits_of_int)
    have nc: int_add(fs, k) in abi.canary(fs) -> false proof
      assume hc
      have ci: int_add(fs, k) in omega && int_le(int_add(fs, 40), int_add(fs, k)) && int_lt(int_add(fs, k), int_add(fs, 48))
        by taut(set_select_def[s := omega, p := x0. int_le(int_add(fs, 40), x0) && int_lt(x0, int_add(fs, 48)), z := int_add(fs, k)], expand(hc, abi.canary))
      have _ c1 _ := ci
      have fo: fs in omega by simp(hf)
      show by arith(c1, k1, k2, fo)
    qed
    have nh: int_add(fs, k) in abi.objs_at(objs, fs).c_bytes by simp(all_elim(abi.objs_at_live, {objs}, {fs}), all_elim(abi.cbytes0_in, {fs}, {int_add(fs, k)}), nc, hf, k1, keep(abi.canary))
    have mm: x86_64_linux.mapped(mem, int_div(int_add(fs, k), x86_64_linux.PAGE)) by defs(rewrite(sym(pe), expand(mv, x86_64_linux.mapped)), x86_64_linux.mapped)
    have mm1 mm2 := expand(mm, x86_64_linux.mapped)
    have qp: int_div(int_add(fs, k), x86_64_linux.PAGE) in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) by sel(simp(hf, k1, mm1))
    have kn := mp(all_elim(nostk, {int_div(int_add(fs, k), x86_64_linux.PAGE)}), qp, mm2)
    have dm: abi.in_domain(mem, abi.objs_at(objs, fs), int_add(fs, k)) by defs(taut(mm, kn, nh), abi.in_domain)
    have b := mp(all_elim(bytes, {int_add(fs, k)}), (int_add(fs, k) in bits(64) by simp(hf, k1, lt)), dm)
    show := rewrite(sym(ea), sym(b))
  qed
  have ls := apply(tr.le_same, {mem.bytes}, {vm.bytes}, {fs}, {8}, simp(), by)
  have rd2: all x0. x0 in omega -> int_lt(x0, 8) -> x86_64_linux.mapped(mem, int_div(int_add(fs, x0), x86_64_linux.PAGE)) && snd(mem.pages[int_div(int_add(fs, x0), x86_64_linux.PAGE)]).prot.r proof
    fix k
    assume k1 k2
    have r := mp(all_elim(expand(rd, x86_64_linux.readable), {k}), k1, k2)
    have pe _ _ := mp(all_elim(wp, {k}), k1, k2)
    show by defs(rewrite(sym(pe), expand(r, x86_64_linux.mapped)), x86_64_linux.mapped)
  qed
  have ns2: all x0. x0 in omega -> int_lt(x0, 8) -> !abi.stack_page(mem, int_div(int_add(fs, x0), x86_64_linux.PAGE)) proof
    fix k
    assume k1 k2
    have pe _ nsv := mp(all_elim(wp, {k}), k1, k2)
    show by defs(rewrite(sym(pe), expand(nsv, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
  qed
  have rd3: x86_64_linux.readable(mem, fs, 8) by defs(rd2, x86_64_linux.readable)
  show by defs(taut(rd3, ns2, trans(ls, le), nz), abi.thread_ok)
qed

// The contract at a program's entry point: the bridge's, the spec raising
// where the world's view has the program not loaded (or the stack
// protector's word not writable) -- so the program need not be assumed
// loaded (`implements2`, not `implements2_at`)
// Each entry (its arguments, its world w and ghost part h) may take a code
// of its own (C1-implemented by the machine code, refining spec from w
// with h): the code of a recursion unrolled as deep as the entry needs.
theorem abi.bridge_implements_lf: all G f spec base code statics. abi.ghost_ok(G) ->
  (all args w h. args in abi.ARGS -> w in abi.World -> w in univ(1) -> h in G -> abi.thread_ok(w.vm, w.fs_base) ->
     ex low. tr.implements_at(f, low, base, code, statics) && abi.refines_ovf_at(low[args], spec[args], G, w, h) && tr.div_low_at(low[args], spec[args], G, w, h)) ->
  (all args w. args in abi.ARGS -> w in rec_and(abi.World, G) -> w in univ(1) -> !(abi.loaded(w.vm, base, code, statics) && abi.canary_ok(w.vm, w.fs_base)) ->
     abi.spec_raises(rec_and(abi.World, G), w, spec, args)) ->
  abi.implements2(G, f, spec)
proof
  fix G f spec base code statics
  assume hg hfam hnl
  let ld(m) := abi.loaded(m.vm, base, code, statics)
  have main: all x0. all x1. all x2. (x0 in abi.ARGS && x1 in set_type(omega)) && x2 in x86_64_linux.Vm -> (all s h o. s in x86_64_linux.Machine -> h in G -> runs(abi.run_to_return(), s, o) ->
      (ex h2. h2 in G && runs(abi.abi_function(G, f, spec, x0, x1, x2), union2(s, h), with_ghost(o, h2)))) proof
    fix args objs mem
    assume hAo
    have hA hot hmv := hAo
    show all s h o. s in x86_64_linux.Machine -> h in G -> runs(abi.run_to_return(), s, o) -> (ex h2. h2 in G && runs(abi.abi_function(G, f, spec, args, objs, mem), union2(s, h), with_ghost(o, h2))) proof
      fix s h o
      assume hM hh hr
      let S := union2(s, h)
      let GOAL := ex h2. h2 in G && runs(abi.abi_function(G, f, spec, args, objs, mem), S, with_ghost(o, h2))
      have hp := apply(abi.run_univ, hr)
      have hsh := apply(abi.run_shape, hr)
      have su: s in univ(1) by simp(hp)
      have ho: abi.outcome(o) by simp(hsh)
      have _ _ apS := apply(abi.ghost_parts, hg, hh, hM)
      have a1 := mp(all_elim(apS, {"gpr"}), simp())
      have a3 := mp(all_elim(apS, {"rip"}), simp())
      have a8 := mp(all_elim(apS, {"vm"}), simp())
      have hu _ _ := mp(all_elim(hg, {h}), hh)
      have Su := mp(union2_univ[u := 1, a := s, b := h], su, hu)
      // abi_function's preconditions failing: anything (h kept)
      have pu0 ou2 := apply(abi.wg_univ, hp, hu, ho)
      have wu0: with_ghost(o, h) in univ(1) by simp(pu0)
      have pu: pair(S, with_ghost(o, h)) in univ(1) by simp(Su, wu0)
      have pre: !(S.rip = f && abi.entry_ok(S, args)) -> runs(abi.abi_function(G, f, spec, args, objs, mem), S, with_ghost(o, h)) proof
        assume hn
        show by simp(pu, hn, keep(abi.entry_ok, abi.world.get, abi.world.set, abi.abi_call, abi.abi_restore, abi.abi_set_result, abi.spec_raises, abi.overflow_ok, abi.overflow_at, with_ghost))
      qed
      have pre2: !(all x. x in omega -> x in objs -> (int_le(abi.sp(S), x) && abi.stack_page(S.vm, int_div(x, x86_64_linux.PAGE))) && x86_64_linux.can_access(S.vm, bits_of_int(64, x), 1)) -> runs(abi.abi_function(G, f, spec, args, objs, mem), S, with_ghost(o, h)) proof
        assume hn
        show by simp(pu, hn, keep(abi.entry_ok, abi.world.get, abi.world.set, abi.abi_call, abi.abi_restore, abi.abi_set_result, abi.spec_raises, abi.overflow_ok, abi.overflow_at, with_ghost))
      qed
      have pre3: !abi.view_ok(S, objs, mem) -> runs(abi.abi_function(G, f, spec, args, objs, mem), S, with_ghost(o, h)) proof
        assume hn
        show by simp(pu, hn, keep(abi.world_pages, abi.world_matches, abi.entry_ok, abi.world.get, abi.world.set, abi.abi_call, abi.abi_restore, abi.abi_set_result, abi.spec_raises, abi.overflow_ok, abi.overflow_at, with_ghost))
      qed
      // loaded: the bridge's run
      have mc: ld(s) -> s.rip = f && abi.entry_ok(s, args) ->
          (all x. x in omega -> x in objs -> (int_le(abi.sp(s), x) && abi.stack_page(s.vm, int_div(x, x86_64_linux.PAGE))) && x86_64_linux.can_access(s.vm, bits_of_int(64, x), 1)) -> abi.view_ok(s, objs, mem) -> GOAL proof
        assume hc hy hb2 hw
        have vu vW := apply(abi.view_typed, hM, su, hot, hmv)
        // (the thread pointer sound in the world's view: the machine's)
        have th: abi.thread_ok(s.vm, s.fs_base) by simp(expand(hy.2, abi.entry_ok))
        have fsb: s.fs_base in bits(64) by simp(hM)
        have wp wm := hw
        have tv := apply(abi.thread_view[vm := s.vm, mem := mem, objs := objs, fs := s.fs_base, sp := abi.sp(s)], fsb, wp, wm, th)
        have tw: abi.thread_ok(abi.view(s, objs, mem).vm, abi.view(s, objs, mem).fs_base) by simp(tv)
        obtain low, hi ra da from mp(all_elim(hfam, {args}, {abi.view(s, objs, mem)}, {h}), hA, vW, vu, hh, tw)
        have hb := apply(tr.implements_matches_d, hi)
        have hm := mp(all_elim(hb, {args}, {objs}, {mem}, {s}, {o}), hA, hot, hmv, hM, hc, hy.1, hy.2, hb2, hw, hr)
        show := apply(abi.bridge_run_g, {G}, {f}, {low}, {spec}, {args}, {objs}, {mem}, {s}, {h}, {o}, hg, hh, ra, da, hA, hM, hy.2, hot, hb2, hmv, hw, hr, hm)
      qed
      // not loaded: nor in the world's view, so the spec raises
      have nl: !ld(s) -> (all x. x in omega -> x in objs -> (int_le(abi.sp(s), x) && abi.stack_page(s.vm, int_div(x, x86_64_linux.PAGE))) && x86_64_linux.can_access(s.vm, bits_of_int(64, x), 1)) ->
          abi.view_ok(s, objs, mem) -> GOAL proof
        assume hn hb2 hw
        have _ x7e _ hwmS hobS hsvS hspS _ hcoS := apply(abi.ghost_entry, hg, hh, hM, su, hot, hmv, hw, hb2)
        have ou := apply(abi.objs_univ, hot)
        have hmu := apply(x86.vm_univ, hmv)
        have vu: abi.view(s, objs, mem) in univ(1) by simp(su, ou, hmu, mp(all_elim(abi.objs_at_univ, {objs}, {s.fs_base}), ou))
        have vW := apply(abi.world_typed, hM, hot, hmv, vu)
        have _ _ apW := apply(abi.ghost_parts_w, hg, hh, vW)
        have wv := mp(all_elim(apW, {"vm"}), simp())
        have wf := mp(all_elim(apW, {"fs_base"}), simp())
        let W := union2(abi.view(s, objs, mem), h)
        have wvm: W.vm = mem by simp(wv)
        have wfs: W.fs_base = s.fs_base by simp(wf)
        have fsb: s.fs_base in bits(64) by simp(hM)
        have wp wm := hw
        have nlw: !(abi.loaded(W.vm, base, code, statics) && abi.canary_ok(W.vm, W.fs_base)) proof
          assume w
          have l1 c1 := rewrite(wfs, rewrite(wvm, w))
          show by taut(hn, apply(abi.loaded_of_view[vm := s.vm, mem := mem, objs := objs, fs := s.fs_base, sp := abi.sp(s), base := base, code := code, statics := statics], fsb, wp, wm, c1, l1))
        qed
        have WG := apply(rec_and_intro, vW, hh)
        have WU := mp(union2_univ[u := 1, a := abi.view(s, objs, mem), b := h], vu, hu)
        have hra := mp(all_elim(hnl, {args}, {W}), hA, WG, WU, nlw)
        have hra2 := rewrite(sym(x7e), hra)
        have r := apply(abi.ub_intro_g, {G}, {f}, pu, ou2, ou, hmu, hsvS, hspS, hwmS, hcoS, hra2)
        show by ex_intro({h}, taut(hh, r))
      qed
      // (the preconditions as of S: s's)
      have a2 := mp(all_elim(apS, {"xmm"}), simp())
      have a4 := mp(all_elim(apS, {"flags"}), simp())
      have a5 := mp(all_elim(apS, {"cpu"}), simp())
      have a6 := mp(all_elim(apS, {"fs_base"}), simp())
      have a7 := mp(all_elim(apS, {"gs_base"}), simp())
      have a9 := mp(all_elim(apS, {"os"}), simp())
      have eS1: (S.rip = f && abi.entry_ok(S, args)) <-> (s.rip = f && abi.entry_ok(s, args)) by defs(simp(a1, a2, a3, a4, a5, a6, a7, a8, a9), abi.entry_ok)
      have eS2: (all x. x in omega -> x in objs -> (int_le(abi.sp(S), x) && abi.stack_page(S.vm, int_div(x, x86_64_linux.PAGE))) && x86_64_linux.can_access(S.vm, bits_of_int(64, x), 1)) <->
          (all x. x in omega -> x in objs -> (int_le(abi.sp(s), x) && abi.stack_page(s.vm, int_div(x, x86_64_linux.PAGE))) && x86_64_linux.can_access(s.vm, bits_of_int(64, x), 1)) by simp(a1, a8)
      have eS3: abi.view_ok(S, objs, mem) <-> abi.view_ok(s, objs, mem) by simp(a1, a8, a6)
      have pf: !(S.rip = f && abi.entry_ok(S, args)) || !(all x. x in omega -> x in objs -> (int_le(abi.sp(S), x) && abi.stack_page(S.vm, int_div(x, x86_64_linux.PAGE))) && x86_64_linux.can_access(S.vm, bits_of_int(64, x), 1)) ||
          !abi.view_ok(S, objs, mem) -> GOAL proof
        assume hn
        have r: runs(abi.abi_function(G, f, spec, args, objs, mem), S, with_ghost(o, h)) by taut(hn, pre, pre2, pre3)
        show by ex_intro({h}, taut(hh, r))
      qed
      show by taut(eS1, eS2, eS3, nl, pf, mc)
    qed
  qed
  show by defs(main, abi.implements2, refines_ghost)
qed

// ... from C1 (`tr.implements_at`)
theorem tr.implements_abi_l: all G f low spec base code statics. abi.ghost_ok(G) -> tr.div_raises_low(low, spec, G) -> tr.implements_at(f, low, base, code, statics) ->
  (all args. args in abi.ARGS -> abi.refines_ovf(low[args], spec[args], G)) ->
  (all args w. args in abi.ARGS -> w in rec_and(abi.World, G) -> w in univ(1) -> !(abi.loaded(w.vm, base, code, statics) && abi.canary_ok(w.vm, w.fs_base)) ->
     abi.spec_raises(rec_and(abi.World, G), w, spec, args)) ->
  abi.implements2(G, f, spec)
proof
  fix G f low spec base code statics
  assume hg hdg hi hrf hnl
  have fam: all args w h. args in abi.ARGS -> w in abi.World -> w in univ(1) -> h in G -> abi.thread_ok(w.vm, w.fs_base) ->
      ex low2. tr.implements_at(f, low2, base, code, statics) && abi.refines_ovf_at(low2[args], spec[args], G, w, h) && tr.div_low_at(low2[args], spec[args], G, w, h) proof
    fix args w h
    assume hA hw hwu hh _
    have ra := mp(all_elim(mp(all_elim(hrf, {args}), hA), {w}, {h}), hw, hh)
    have da := mp(all_elim(expand(hdg, tr.div_raises_low), {args}, {w}, {h}), hA, hw, hwu, hh)
    show by ex_intro({low}, taut(hi, ra, da))
  qed
  show := apply(abi.bridge_implements_lf, hg, fam, hnl)
qed
