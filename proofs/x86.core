// Facts about the x86-64 model (spec/x86_64), for any binary: used with
// the generated step theorems (`slc steps`) to run instructions.
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core core/records.core \
//     build/musl_malloc_O0.core proofs/x86.core
//
// (The model's definitions come with a claim file; `exec` is the access
// kind 2, `write` 1.) Also: that refactorings of the model mean the same as
// before (`x86.store_bytes_closed`).

// fetching a byte whose page is mapped and executable changes nothing
theorem x86.touch_fetch: all m a o. x86_64_linux.fetchable(m.vm, a) -> runs(x86_64_linux.touch(a, 2), m, o) -> o = ok(m, empty)
proof
  fix m a o
  assume hf h
  have hf2 := expand(hf, x86_64_linux.fetchable)
  show by simp(h, hf2, keep(x86_64_linux.grow_stack))
qed

// accessing an accessible byte changes nothing (any access kind)
theorem x86.touch_access: all m a k o. x86_64_linux.can_access(m.vm, a, k) -> runs(x86_64_linux.touch(a, k), m, o) -> o = ok(m, empty)
proof
  fix m a k o
  assume hf h
  have hf2 := expand(hf, x86_64_linux.can_access)
  show by simp(h, hf2, keep(x86_64_linux.grow_stack))
qed

// accessing n bytes that are all accessible changes nothing
theorem x86.touch_range_access: all m a n k o. n in omega ->
  (all i. i in omega -> int_lt(i, n) -> x86_64_linux.can_access(m.vm, bits_add(64, a, bits_of_int(64, i)), k)) ->
  runs(x86_64_linux.touch_range(a, n, k), m, o) -> o = ok(m, empty)
proof
  fix m a n k o
  assume hn hf h
  show by simp(h, hn, hf, x86.touch_access, keep(x86_64_linux.touch), {l0 l. fst(l) = m && snd(l) in omega && int_le(snd(l), n)}, {l. int_sub(n, snd(l))})
qed

// fetching n bytes that are all fetchable changes nothing
theorem x86.touch_range_fetch: all m a n o. n in omega ->
  (all i. i in omega -> int_lt(i, n) -> x86_64_linux.fetchable(m.vm, bits_add(64, a, bits_of_int(64, i)))) ->
  runs(x86_64_linux.touch_range(a, n, 2), m, o) -> o = ok(m, empty)
proof
  fix m a n o
  assume hn hf h
  show by simp(h, hn, hf, x86.touch_fetch, keep(x86_64_linux.touch), {l0 l. fst(l) = m && snd(l) in omega && int_le(snd(l), n)}, {l. int_sub(n, snd(l))})
qed

// ----------------------------------------------------------------------
//  Memory

// 64-bit addresses: a + (c - a) = c
theorem x86.bits_add_sub(a, c): c in bits(64) -> a in bits(64) -> bits_add(64, a, bits_of_int(64, bits_sub(64, c, a))) = c
proof
  assume hc ha
  show by defs(simp(hc, ha), bits_add, bits_sub, bits_of_int, pow2)
qed

// reading a byte through a store that did not cover it: the old byte. A
// byte that is not writable (code) is never covered by a store of
// writable bytes.
theorem x86.store_other: all vm b a n v c. c in bits(64) -> a in bits(64) ->
  (all i. i in omega -> int_lt(i, n) -> x86_64_linux.can_access(vm, bits_add(64, a, bits_of_int(64, i)), 1)) ->
  !x86_64_linux.can_access(vm, c, 1) ->
  x86_64_linux.store_le(b, a, n, v)[c] = b[c]
proof
  fix vm b a n v c
  assume hc ha hw hn
  have e1 := mp(app_fn_build[d := bits(64), v := x. ite(int_lt(bits_sub(64, x, a), n), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), b[x]), a := c], hc)
  have k: bits_sub(64, c, a) in omega by defs(simp(hc, ha), bits_sub, pow2)
  have id := mp(mp(x86.bits_add_sub[a := a, c := c], hc), ha)
  have nlt0: int_lt(bits_sub(64, c, a), n) -> false proof
    assume lt
    have w := mp(mp(all_elim(hw, {bits_sub(64, c, a)}), k), lt)
    show by taut(rewrite(id, w), hn)
  qed
  have nlt: !int_lt(bits_sub(64, c, a), n) by taut(nlt0)
  have f := mp(ite_f[c := int_lt(bits_sub(64, c, a), n), a := bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, c, a)))), b := b[c]], nlt)
  show by defs(taut(trans(e1, f)), x86_64_linux.store_le)
qed
// storing byte i after bytes 0..i-1 is storing bytes 0..i
theorem x86.store_step: all b a i v. a in bits(64) -> i in omega -> int_lt(i, 18446744073709551616) ->
  fn_update(x86_64_linux.store_le(b, a, i, v), bits_add(64, a, bits_of_int(64, i)), bits_of_int(8, int_div(v, int_pow(256, i)))) = x86_64_linux.store_le(b, a, int_add(i, 1), v)
proof
  fix b a i v
  assume ha hi hm
  have kb: bits_add(64, a, bits_of_int(64, i)) in bits(64) by defs(simp(ha, hi, hm), bits_add, bits_of_int, pow2)
  have dk: bits_sub(64, bits_add(64, a, bits_of_int(64, i)), a) = i by defs(simp(ha, hi, hm), bits_add, bits_sub, bits_of_int, pow2)
  have lt1: int_lt(i, int_add(i, 1)) by arith(hi)
  have gk0 := mp(ite_t[c := int_lt(i, int_add(i, 1)), a := bits_of_int(8, int_div(v, int_pow(256, i))), b := b[bits_add(64, a, bits_of_int(64, i))]], lt1)
  have gk: ite(int_lt(bits_sub(64, bits_add(64, a, bits_of_int(64, i)), a), int_add(i, 1)), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, bits_add(64, a, bits_of_int(64, i)), a)))), b[bits_add(64, a, bits_of_int(64, i))]) = bits_of_int(8, int_div(v, int_pow(256, i))) by simp(dk, gk0)
  have others: all x. x in bits(64) -> !(x = bits_add(64, a, bits_of_int(64, i))) -> ite(int_lt(bits_sub(64, x, a), int_add(i, 1)), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), b[x]) = ite(int_lt(bits_sub(64, x, a), i), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), b[x]) proof
    fix x
    assume xb xk
    have db: bits_sub(64, x, a) in omega by defs(simp(xb, ha), bits_sub, pow2)
    have back := mp(mp(x86.bits_add_sub[a := a, c := x], xb), ha)
    have ne0: bits_sub(64, x, a) = i -> false proof
      assume e
      show by taut(sym(rewrite(e, back)), xk)
    qed
    have nei: !(bits_sub(64, x, a) = i) by taut(ne0)
    have c1: int_lt(bits_sub(64, x, a), i) -> ite(int_lt(bits_sub(64, x, a), int_add(i, 1)), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), b[x]) = ite(int_lt(bits_sub(64, x, a), i), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), b[x]) proof
      assume l
      have l2: int_lt(bits_sub(64, x, a), int_add(i, 1)) by arith(l, db, hi)
      have t1 := mp(ite_t[c := int_lt(bits_sub(64, x, a), int_add(i, 1)), a := bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), b := b[x]], l2)
      have t2 := mp(ite_t[c := int_lt(bits_sub(64, x, a), i), a := bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), b := b[x]], l)
      show by taut(trans(t1, sym(t2)))
    qed
    have c2: !int_lt(bits_sub(64, x, a), i) -> ite(int_lt(bits_sub(64, x, a), int_add(i, 1)), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), b[x]) = ite(int_lt(bits_sub(64, x, a), i), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), b[x]) proof
      assume l
      have l2: !int_lt(bits_sub(64, x, a), int_add(i, 1)) by arith(l, db, hi, nei)
      have t1 := mp(ite_f[c := int_lt(bits_sub(64, x, a), int_add(i, 1)), a := bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), b := b[x]], l2)
      have t2 := mp(ite_f[c := int_lt(bits_sub(64, x, a), i), a := bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), b := b[x]], l)
      show by taut(trans(t1, sym(t2)))
    qed
    show by taut(c1, c2)
  qed
  have fu := mp(mp(mp(fn_update_build[d := bits(64), f := x. ite(int_lt(bits_sub(64, x, a), i), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), b[x]), g := x. ite(int_lt(bits_sub(64, x, a), int_add(i, 1)), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), b[x]), k := bits_add(64, a, bits_of_int(64, i)), w := bits_of_int(8, int_div(v, int_pow(256, i)))], kb), gk), others)
  show by defs(taut(fu), x86_64_linux.store_le)
qed

// storing no bytes changes nothing (memory: a function on 64-bit addresses)
theorem x86.store_zero: all b a v. is_fun(b) -> dom(b) = bits(64) -> a in bits(64) -> x86_64_linux.store_le(b, a, 0, v) = b
proof
  fix b a v
  assume hf hd ha
  have pw: all x. x in bits(64) -> ite(int_lt(bits_sub(64, x, a), 0), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), b[x]) = b[x] proof
    fix x
    assume xb
    have n0: !int_lt(bits_sub(64, x, a), 0) by defs(simp(xb, ha), bits_sub, pow2)
    show by taut(mp(ite_f[c := int_lt(bits_sub(64, x, a), 0), a := bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), b := b[x]], n0))
  qed
  have ext := mp(fn_build_ext[d := bits(64), f := x. ite(int_lt(bits_sub(64, x, a), 0), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), b[x]), g := x. b[x]], pw)
  have eta := mp(mp(fn_eta[f := b, d := bits(64)], hf), hd)
  show by defs(taut(trans(ext, eta)), x86_64_linux.store_le)
qed

// a natural at most q and not below q is q
theorem x86.le_not_lt: all p q. p in omega -> q in omega -> int_le(p, q) -> !int_lt(p, q) -> p = q
proof
  fix p q
  assume hp hq h1 h2
  show by arith(hp, hq, h1, h2)
qed

// The closed form of the memory write means the same as the byte loop it
// replaced (layers/x86_checks.sl), for every store of at most 2^64 bytes
// (the model stores at most 16) and a machine whose memory is a function
// on 64-bit addresses.
theorem x86.store_bytes_closed: all m a n v o. n in omega -> int_le(n, 18446744073709551616) -> a in bits(64) ->
  is_fun(m.vm["bytes"]) -> dom(m.vm["bytes"]) = bits(64) ->
  is_fun(m) -> "vm" in dom(m) -> is_fun(m.vm) -> "bytes" in dom(m.vm) ->
  runs(x86_checks.store_bytes(a, n, v), m, o) -> o = ok(fn_update(m, "vm", fn_update(m.vm, "bytes", x86_64_linux.store_le(m.vm["bytes"], a, n, v))), empty)
proof
  fix m a n v o
  assume hn hm ha hb hd hf hv hf2 hv2 h
  // the start: no bytes stored is m itself
  have z := mp(mp(mp(all_elim(all_elim(all_elim(x86.store_zero, {m.vm["bytes"]}), {a}), {v}), hb), hd), ha)
  have s1 := mp(mp(fn_update_same[f := m.vm, k := "bytes"], hf2), hv2)
  have s2 := mp(mp(fn_update_same[f := m, k := "vm"], hf), hv)
  have start: fn_update(m, "vm", fn_update(m.vm, "bytes", x86_64_linux.store_le(m.vm["bytes"], a, 0, v))) = m by taut(trans(rewrite(sym(z), rewrite(sym(s1), s2)), refl({m})))
  show by simp(h, hn, hm, ha, start, x86.store_step, x86.le_not_lt,
    {l0 l. snd(l) in omega && int_le(snd(l), n) && fst(l) = fn_update(m, "vm", fn_update(m.vm, "bytes", x86_64_linux.store_le(m.vm["bytes"], a, snd(l), v)))}, {l. int_sub(n, snd(l))})
qed

// access rights are per page
theorem x86.same_page: all vm a b k. x86_64_linux.can_access(vm, b, k) -> int_div(a, 4096) = int_div(b, 4096) -> x86_64_linux.can_access(vm, a, k)
proof
  fix vm a b k
  assume h e
  show by defs(simp(expand(h, x86_64_linux.can_access, x86_64_linux.page_of), e), x86_64_linux.can_access, x86_64_linux.page_of)
qed

// what can be written can be read
theorem x86.write_read: all vm a. x86_64_linux.can_access(vm, a, 1) -> x86_64_linux.can_access(vm, a, 0)
proof
  fix vm a
  assume h
  show by defs(simp(expand(h, x86_64_linux.can_access, x86_64_linux.hw_allows)), x86_64_linux.can_access, x86_64_linux.hw_allows, x86_64_linux.accessible)
qed

// storing bytes keeps a byte map a byte map
theorem x86.store_typed: all b a n v. b in fn_space(bits(64), bits(8)) -> x86_64_linux.store_le(b, a, n, v) in fn_space(bits(64), bits(8))
proof
  fix b a n v
  assume bt
  have vals: all x. x in bits(64) -> ite(int_lt(bits_sub(64, x, a), n), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), b[x]) in bits(8) proof
    fix x
    assume hx
    have ax := mp(mp(fn_space_app[a := bits(64), b := bits(8), f := b, x := x], bt), hx)
    have c1: int_lt(bits_sub(64, x, a), n) -> ite(int_lt(bits_sub(64, x, a), n), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), b[x]) in bits(8) proof
      assume hc
      have e := mp(ite_t[c := int_lt(bits_sub(64, x, a), n), a := bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), b := b[x]], hc)
      have m: bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))) in bits(8) by simp()
      show := rewrite(sym(e), m)
    qed
    have c2: !int_lt(bits_sub(64, x, a), n) -> ite(int_lt(bits_sub(64, x, a), n), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), b[x]) in bits(8) proof
      assume hc
      have e := mp(ite_f[c := int_lt(bits_sub(64, x, a), n), a := bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), b := b[x]], hc)
      show := rewrite(sym(e), ax)
    qed
    show by taut(c1, c2)
  qed
  have st := mp(fn_build_space[d := bits(64), v := x. ite(int_lt(bits_sub(64, x, a), n), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), b[x]), b := bits(8)], vals)
  show by defs(st, x86_64_linux.store_le)
qed

// storing bytes keeps a memory well-typed
theorem x86.store_vm: all vm a n v. vm in x86_64_linux.Vm -> fn_update(vm, "bytes", x86_64_linux.store_le(vm.bytes, a, n, v)) in univ(1) ->
  fn_update(vm, "bytes", x86_64_linux.store_le(vm.bytes, a, n, v)) in x86_64_linux.Vm
proof
  fix vm a n v
  assume h hu
  have ht: is_fun(vm) && dom(vm) = insert("pages", insert("bytes", insert("stack_top", insert("stack_limit", insert("brk_start", insert("brk", empty)))))) && vm.bytes in fn_space(bits(64), bits(8)) by simp(expand(h, x86_64_linux.Vm))
  have bt: vm.bytes in fn_space(bits(64), bits(8)) by taut(ht)
  have st := expand(mp(all_elim(all_elim(all_elim(all_elim(x86.store_typed, {vm.bytes}), {a}), {n}), {v}), bt), x86_64_linux.store_le)
  have hf: is_fun(vm) by taut(ht)
  have bd: "bytes" in dom(vm) by simp(ht)
  have fuf := mp(fn_update_fun[f := vm, k := "bytes", v := x86_64_linux.store_le(vm.bytes, a, n, v)], hf)
  have fud := mp(mp(fn_update_dom[f := vm, k := "bytes", v := x86_64_linux.store_le(vm.bytes, a, n, v)], hf), bd)
  have dv: dom(vm) = insert("pages", insert("bytes", insert("stack_top", insert("stack_limit", insert("brk_start", insert("brk", empty)))))) by taut(ht)
  have pv: ((((((is_fun(fn_update(vm, "bytes", x86_64_linux.store_le(vm.bytes, a, n, v))) && dom(fn_update(vm, "bytes", x86_64_linux.store_le(vm.bytes, a, n, v))) = insert("pages", insert("bytes", insert("stack_top", insert("stack_limit", insert("brk_start", insert("brk", empty))))))) && fn_update(vm, "bytes", x86_64_linux.store_le(vm.bytes, a, n, v)).pages in fn_space(set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))), option(x86_64_linux.Page))) && fn_update(vm, "bytes", x86_64_linux.store_le(vm.bytes, a, n, v)).bytes in fn_space(bits(64), bits(8))) && fn_update(vm, "bytes", x86_64_linux.store_le(vm.bytes, a, n, v)).stack_top in bits(64)) && fn_update(vm, "bytes", x86_64_linux.store_le(vm.bytes, a, n, v)).stack_limit in omega) && fn_update(vm, "bytes", x86_64_linux.store_le(vm.bytes, a, n, v)).brk_start in bits(64)) && fn_update(vm, "bytes", x86_64_linux.store_le(vm.bytes, a, n, v)).brk in bits(64) by defs(simp(expand(h, x86_64_linux.Vm), st, expand(fuf, x86_64_linux.store_le), expand(fud, x86_64_linux.store_le), dv), x86_64_linux.store_le)
  have r := mp(mp(mp(mp(rec_type_intro[u := 1, k := insert("pages", insert("bytes", insert("stack_top", insert("stack_limit", insert("brk_start", insert("brk", empty)))))), p := x0. ((((((is_fun(x0) && dom(x0) = insert("pages", insert("bytes", insert("stack_top", insert("stack_limit", insert("brk_start", insert("brk", empty))))))) && x0.pages in fn_space(set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))), option(x86_64_linux.Page))) && x0.bytes in fn_space(bits(64), bits(8))) && x0.stack_top in bits(64)) && x0.stack_limit in omega) && x0.brk_start in bits(64)) && x0.brk in bits(64), r := fn_update(vm, "bytes", x86_64_linux.store_le(vm.bytes, a, n, v))], hu), fuf), trans(fud, dv)), pv)
  show by defs(r, x86_64_linux.Vm)
qed

// a store away from the 8 bytes at r leaves them (e.g. a return address)
theorem x86.le_store_far: all b r a n v. r in bits(64) -> a in bits(64) ->
  (all k. k in omega -> int_lt(k, 8) -> !int_lt(bits_sub(64, bits_add(64, r, bits_of_int(64, k)), a), n)) ->
  x86_64_linux.le(x86_64_linux.store_le(b, a, n, v), r, 8) = x86_64_linux.le(b, r, 8)
proof
  fix b r a n v
  assume hr ha hk
  have k0 := mp(all_elim(hk, {0}), simp(), simp())
  have k1 := mp(all_elim(hk, {1}), simp(), simp())
  have k2 := mp(all_elim(hk, {2}), simp(), simp())
  have k3 := mp(all_elim(hk, {3}), simp(), simp())
  have k4 := mp(all_elim(hk, {4}), simp(), simp())
  have k5 := mp(all_elim(hk, {5}), simp(), simp())
  have k6 := mp(all_elim(hk, {6}), simp(), simp())
  have k7 := mp(all_elim(hk, {7}), simp(), simp())
  show by defs(simp(hr, ha, k0, k1, k2, k3, k4, k5, k6, k7), x86_64_linux.le, x86_64_linux.store_le)
qed

// a 4-byte store as its byte updates
theorem x86.store4: all b a v. is_fun(b) -> dom(b) = bits(64) -> a in bits(64) -> v in omega ->
  x86_64_linux.store_le(b, a, 4, v) = fn_update(fn_update(fn_update(fn_update(b, a, bits_of_int(8, v)), bits_add(64, a, 1), bits_of_int(8, int_div(v, 256))), bits_add(64, a, 2), bits_of_int(8, int_div(v, 65536))), bits_add(64, a, 3), bits_of_int(8, int_div(v, 16777216)))
proof
  fix b a v
  assume hf hd ha hv
  have z := apply(x86.store_zero, {b}, {a}, {v}, hf, hd, ha)
  have e1: fn_update(b, a, bits_of_int(8, v)) = x86_64_linux.store_le(b, a, 1, v) by simp(ha, hv, rewrite(z, apply(x86.store_step, {b}, {a}, {0}, {v}, ha, simp(), simp())))
  have e2: fn_update(fn_update(b, a, bits_of_int(8, v)), bits_add(64, a, 1), bits_of_int(8, int_div(v, 256))) = x86_64_linux.store_le(b, a, 2, v)
    by simp(ha, hv, rewrite(sym(e1), apply(x86.store_step, {b}, {a}, {1}, {v}, ha, simp(), simp())))
  have e3: fn_update(fn_update(fn_update(b, a, bits_of_int(8, v)), bits_add(64, a, 1), bits_of_int(8, int_div(v, 256))), bits_add(64, a, 2), bits_of_int(8, int_div(v, 65536))) = x86_64_linux.store_le(b, a, 3, v)
    by simp(ha, hv, rewrite(sym(e2), apply(x86.store_step, {b}, {a}, {2}, {v}, ha, simp(), simp())))
  have e4: fn_update(fn_update(fn_update(fn_update(b, a, bits_of_int(8, v)), bits_add(64, a, 1), bits_of_int(8, int_div(v, 256))), bits_add(64, a, 2), bits_of_int(8, int_div(v, 65536))), bits_add(64, a, 3), bits_of_int(8, int_div(v, 16777216))) = x86_64_linux.store_le(b, a, 4, v)
    by simp(ha, hv, rewrite(sym(e3), apply(x86.store_step, {b}, {a}, {3}, {v}, ha, simp(), simp())))
  show := sym(e4)
qed

// the n bytes at a and the m bytes at b are disjoint (addresses mod 2^64).
// As a literal on a simp path, a read of one region skips stores to the
// other, and stores to the first region move out past stores to the
// second (simp's read_store, store_order).
def x86.apart(a, n, b, m) := all i j. i in omega -> int_lt(i, n) -> j in omega -> int_lt(j, m) ->
  !(bits_add(64, a, bits_of_int(64, i)) = bits_add(64, b, bits_of_int(64, j)))

// an example: a frame (16 bytes at r - 8) apart from a static object (928
// bytes at 4227328); a loop's interleaved stores: the frame's move out, the
// last one stays
theorem x86.apart_order(b, r): r in bits(64) -> x86.apart(bits_add(64, r, 18446744073709551608), 16, 4227328, 928) ->
  x86_64_linux.store_le(x86_64_linux.store_le(x86_64_linux.store_le(x86_64_linux.store_le(b, bits_add(64, r, 18446744073709551612), 4, 0), 4228176, 1, 0), bits_add(64, r, 18446744073709551612), 4, 1), 4228177, 1, 0) =
  x86_64_linux.store_le(x86_64_linux.store_le(x86_64_linux.store_le(b, 4228176, 1, 0), 4228177, 1, 0), bits_add(64, r, 18446744073709551612), 4, 1)
proof
  assume hr ha
  show by simp(hr, ha)
qed

// a condition code's test of the flags, computed (a conditional jump's
// branch condition: `ja` is cc 7, !(cf || zf))
abbrev x86.cc_test(f, cc) := ite(bits_slice(cc, 3, 1) = 0, f.of, ite(bits_slice(cc, 3, 1) = 1, f.cf, ite(bits_slice(cc, 3, 1) = 2, f.zf, ite(bits_slice(cc, 3, 1) = 3, f.cf || f.zf, ite(bits_slice(cc, 3, 1) = 4, f.sf, ite(bits_slice(cc, 3, 1) = 5, f.pf, ite(bits_slice(cc, 3, 1) = 6, !(f.sf = f.of), f.zf || !(f.sf = f.of))))))))
// (bit 0 of the code negates the test)
abbrev x86.cc_val(f, cc) := (!(x86.cc_test(f, cc) = bit(cc, 0)))

theorem x86.cond_eval: all f cc. x86_64_linux.cond(f, cc) = x86.cc_val(f, cc)
proof
  fix f cc
  show by rsimp(x86_64_linux.cond)
qed

// `imul` commutes (as `and`, below)
theorem x86.mul_comm: all n a b. bits_mul(n, a, b) = bits_mul(n, b, a)
proof
  fix n a b
  have h: int_mul(a, b) = int_mul(b, a) by arith()
  show by defs(simp(h), bits_mul)
qed

// `and` commutes (the machine's `and` may take its operands in the other
// order than the source)
theorem x86.and_comm: all n a b. bits_and(n, a, b) = bits_and(n, b, a)
proof
  fix n a b
  have pq: all x. (x in bits(n) && (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(a, i) && bit(b, i)))) <-> (x in bits(n) && (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(b, i) && bit(a, i)))) proof
    fix x
    have d1: (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(a, i) && bit(b, i))) -> (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(b, i) && bit(a, i))) proof
      assume h
      fix i
      assume i1 i2
      have hi := mp(all_elim(h, {i}), i1, i2)
      show by taut(hi)
    qed
    have d2: (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(b, i) && bit(a, i))) -> (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(a, i) && bit(b, i))) proof
      assume h
      fix i
      assume i1 i2
      have hi := mp(all_elim(h, {i}), i1, i2)
      show by taut(hi)
    qed
    show by taut(d1, d2)
  qed
  have e := mp(choose_ext[p := x. x in bits(n) && (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(a, i) && bit(b, i))), q := x. x in bits(n) && (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(b, i) && bit(a, i)))], pq)
  show by defs(e, bits_and, bits_build)
qed

// (a member's insertion into a member: a member)
theorem x86.insert_univ: all a s. a in univ(1) -> s in univ(1) -> insert(a, s) in univ(1)
proof
  fix a s
  assume ha hs
  have su: single(a) in univ(1) by defs(simp(ha), single)
  show by defs(mp(mp(union2_univ[u := 1, a := single(a), b := s], su), hs), insert)
qed

// (a function space between members: a member)
theorem x86.fn_space_univ: all a b. a in univ(1) -> b in univ(1) -> fn_space(a, b) in univ(1)
proof
  fix a b
  assume ha hb
  have cu := mp(mp(cart_univ[u := 1, a := a, b := b], ha), hb)
  have pu := mp(univ_powerset[u := 1, s := cart(a, b)], cu)
  have g: all f. f in fn_space(a, b) -> f in powerset(cart(a, b)) proof
    fix f
    assume hf
    show by simp(expand(hf, fn_space))
  qed
  have ss: subset(fn_space(a, b), powerset(cart(a, b))) by defs(g, subset)
  show := mp(mp(univ_subset[u := 1, a := fn_space(a, b), b := powerset(cart(a, b))], pu), ss)
qed

// The memory's types are members of the universe (a page entry's, the
// memory's), so is every memory
theorem x86.opt_page_univ: option(x86_64_linux.Page) in univ(1)
proof
  let K3 := insert("r", insert("w", insert("x", empty)))
  have k3: K3 in univ(1) by simp(x86.insert_univ)
  have bu: bool in univ(1) by defs(simp(), bool)
  have pr: all r. r in set_select(powerset(cart(K3, univ(1))), x0. (((is_fun(x0) && dom(x0) = K3) && x0.r in bool) && x0.w in bool) && x0.x in bool) ->
      is_fun(r) && (all y. y in K3 -> r[y] in bool) proof
    fix r
    assume h
    have hp: is_fun(r) && r.r in bool && r.w in bool && r.x in bool by simp(h)
    have g: all y. y in K3 -> r[y] in bool proof
      fix y
      assume hy
      have c: y = "r" || y = "w" || y = "x" by simp(hy)
      show by simp(c, hp)
    qed
    show by taut(hp, g)
  qed
  have protu: x86_64_linux.Prot in univ(1) by defs(apply(rec_type_univ, k3, bu, pr), x86_64_linux.Prot)
  have kindu: x86_64_linux.Kind in univ(1) by defs(simp(x86.insert_univ), x86_64_linux.Kind)
  let K2 := insert("prot", insert("kind", empty))
  have k2: K2 in univ(1) by simp(x86.insert_univ)
  have b2 := mp(mp(union2_univ[u := 1, a := x86_64_linux.Prot, b := x86_64_linux.Kind], protu), kindu)
  have pg: all r. r in set_select(powerset(cart(K2, univ(1))), x0. ((is_fun(x0) && dom(x0) = K2) && x0.prot in x86_64_linux.Prot) && x0.kind in x86_64_linux.Kind) ->
      is_fun(r) && (all y. y in K2 -> r[y] in union2(x86_64_linux.Prot, x86_64_linux.Kind)) proof
    fix r
    assume h
    have hp: is_fun(r) && r.prot in x86_64_linux.Prot && r.kind in x86_64_linux.Kind by simp(h)
    have g: all y. y in K2 -> r[y] in union2(x86_64_linux.Prot, x86_64_linux.Kind) proof
      fix y
      assume hy
      have c: y = "prot" || y = "kind" by simp(hy)
      have c1: y = "prot" -> r[y] in union2(x86_64_linux.Prot, x86_64_linux.Kind) proof
        assume e
        show by simp(e, hp, union2_iff)
      qed
      have c2: y = "kind" -> r[y] in union2(x86_64_linux.Prot, x86_64_linux.Kind) proof
        assume e
        show by simp(e, hp, union2_iff)
      qed
      show by taut(c, c1, c2)
    qed
    show by taut(hp, g)
  qed
  have pageu: x86_64_linux.Page in univ(1) by defs(apply(rec_type_univ, k2, b2, pg), x86_64_linux.Page)
  // option(Page)
  have smu: all x. x in x86_64_linux.Page -> some(x) in univ(1) proof
    fix x
    assume hx
    have xu := mp(mp(univ_trans[u := 1, a := x, b := x86_64_linux.Page], pageu), hx)
    show by defs(simp(xu), some)
  qed
  have imu := mp(mp(univ_image[u := 1, s := x86_64_linux.Page, f := x. some(x)], pageu), smu)
  have nu: single(none) in univ(1) by defs(simp(), single, none)
  show by defs(mp(mp(union2_univ[u := 1, a := single(none), b := set_image(x86_64_linux.Page, x. some(x))], nu), imu), option)
qed

// (the page numbers: a member)
theorem x86.pn_univ: set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) in univ(1)
proof
  have pns: subset(set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))), omega) by defs(simp(), subset)
  show := mp(mp(univ_subset[u := 1, a := set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))), b := omega], omega_univ), pns)
qed

theorem x86.vm_univ: all v. v in x86_64_linux.Vm -> v in univ(1)
proof
  fix v
  assume hv
  have optu := x86.opt_page_univ
  // the page numbers, the field types
  let PN := set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)))
  have pnu := x86.pn_univ
  have f1 := apply(x86.fn_space_univ, pnu, optu)
  have f2 := apply(x86.fn_space_univ, bits_univ[n := 64], bits_univ[n := 8])
  let B := union2(fn_space(PN, option(x86_64_linux.Page)), union2(fn_space(bits(64), bits(8)), union2(bits(64), omega)))
  have bu3 := mp(mp(union2_univ[u := 1, a := bits(64), b := omega], bits_univ[n := 64]), omega_univ)
  have bu2 := mp(mp(union2_univ[u := 1, a := fn_space(bits(64), bits(8)), b := union2(bits(64), omega)], f2), bu3)
  have bb := mp(mp(union2_univ[u := 1, a := fn_space(PN, option(x86_64_linux.Page)), b := union2(fn_space(bits(64), bits(8)), union2(bits(64), omega))], f1), bu2)
  let K6 := insert("pages", insert("bytes", insert("stack_top", insert("stack_limit", insert("brk_start", insert("brk", empty))))))
  have k6: K6 in univ(1) by simp(x86.insert_univ)
  have pv: all r. r in set_select(powerset(cart(K6, univ(1))), x0. ((((((is_fun(x0) && dom(x0) = K6) && x0.pages in fn_space(PN, option(x86_64_linux.Page))) &&
      x0.bytes in fn_space(bits(64), bits(8))) && x0.stack_top in bits(64)) && x0.stack_limit in omega) && x0.brk_start in bits(64)) && x0.brk in bits(64)) ->
      is_fun(r) && (all y. y in K6 -> r[y] in B) proof
    fix r
    assume h
    have hp: is_fun(r) && r.pages in fn_space(PN, option(x86_64_linux.Page)) && r.bytes in fn_space(bits(64), bits(8)) &&
      r.stack_top in bits(64) && r.stack_limit in omega && r.brk_start in bits(64) && r.brk in bits(64) by simp(h)
    have g: all y. y in K6 -> r[y] in B proof
      fix y
      assume hy
      have c: y = "pages" || y = "bytes" || y = "stack_top" || y = "stack_limit" || y = "brk_start" || y = "brk" by simp(hy)
      show by simp(c, hp, union2_iff)
    qed
    show by taut(hp, g)
  qed
  have vmu: x86_64_linux.Vm in univ(1) by defs(apply(rec_type_univ, k6, bb, pv), x86_64_linux.Vm)
  show := mp(mp(univ_trans[u := 1, a := v, b := x86_64_linux.Vm], vmu), hv)
qed

// ----------------------------------------------------------------------
//  The executable's header fields

// a little-endian field of a byte string: a natural
theorem x86.le_at_nat(f, off, n): f in seq_type(bits(8)) -> n in omega -> x86_64_linux.le_at(f, off, n) in omega
proof
  assume hf hn
  have fp: f in powerset(cart(omega, bits(8))) by taut(unsel(expand(hf, seq_type)))
  have el: all i. i in omega -> int_mul(f[int_add(off, i)], int_pow(256, i)) in omega proof
    fix i
    assume hi
    have sp := app_space[f := f, a := omega, b := bits(8), k := int_add(off, i)]
    have c1: f[int_add(off, i)] in omega by simp(mp(sp, fp), lit_zero)
    have pw: int_lt(0, int_pow(256, i)) := mp(all_elim(pow256_pos, {i}), hi)
    show by arith(c1, pw)
  qed
  show by defs(mp(int_sum_nat[a := 0, b := n, f := i. int_mul(f[int_add(off, i)], int_pow(256, i))], simp(), hn, el), x86_64_linux.le_at)
qed
