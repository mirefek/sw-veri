// Facts about the x86-64 model (spec/x86_64), for any binary: used with
// the generated step theorems (`slc steps`) to run instructions.
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/records.core \
//     build/musl_malloc_O0.core proofs/x86.core
//
// (The model's definitions come with a claim file; `exec` is the access
// kind 2, `write` 1.) Also: that refactorings of the model mean the same as
// before (`x86.store_bytes_closed`).

// fetching a byte whose page is mapped and executable changes nothing
theorem x86.touch_fetch: all m a o. x86_64_linux.fetchable(app(m, "vm"), a) -> runs(x86_64_linux.touch(a, 2), m, o) -> o = ok(m, empty)
proof
  fix m
  fix a
  fix o
  assume hf: x86_64_linux.fetchable(app(m, "vm"), a)
  assume h: runs(x86_64_linux.touch(a, 2), m, o)
  have hf2 := expand(hf, x86_64_linux.fetchable)
  show by simp(h, hf2, keep(x86_64_linux.grow_stack))
qed

// accessing an accessible byte changes nothing (any access kind)
theorem x86.touch_access: all m a k o. x86_64_linux.can_access(app(m, "vm"), a, k) -> runs(x86_64_linux.touch(a, k), m, o) -> o = ok(m, empty)
proof
  fix m
  fix a
  fix k
  fix o
  assume hf: x86_64_linux.can_access(app(m, "vm"), a, k)
  assume h: runs(x86_64_linux.touch(a, k), m, o)
  have hf2 := expand(hf, x86_64_linux.can_access)
  show by simp(h, hf2, keep(x86_64_linux.grow_stack))
qed

// accessing n bytes that are all accessible changes nothing
theorem x86.touch_range_access: all m a n k o. n in omega ->
  (all i. i in omega -> int_lt(i, n) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, a, bits_of_int(64, i)), k)) ->
  runs(x86_64_linux.touch_range(a, n, k), m, o) -> o = ok(m, empty)
proof
  fix m
  fix a
  fix n
  fix k
  fix o
  assume hn: n in omega
  assume hf: all i. i in omega -> int_lt(i, n) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, a, bits_of_int(64, i)), k)
  assume h: runs(x86_64_linux.touch_range(a, n, k), m, o)
  show by simp(h, hn, hf, x86.touch_access, keep(x86_64_linux.touch), {l0 l. fst(l) = m && snd(l) in omega && int_le(snd(l), n)}, {l. int_sub(n, snd(l))})
qed

// fetching n bytes that are all fetchable changes nothing
theorem x86.touch_range_fetch: all m a n o. n in omega ->
  (all i. i in omega -> int_lt(i, n) -> x86_64_linux.fetchable(app(m, "vm"), bits_add(64, a, bits_of_int(64, i)))) ->
  runs(x86_64_linux.touch_range(a, n, 2), m, o) -> o = ok(m, empty)
proof
  fix m
  fix a
  fix n
  fix o
  assume hn: n in omega
  assume hf: all i. i in omega -> int_lt(i, n) -> x86_64_linux.fetchable(app(m, "vm"), bits_add(64, a, bits_of_int(64, i)))
  assume h: runs(x86_64_linux.touch_range(a, n, 2), m, o)
  show by simp(h, hn, hf, x86.touch_fetch, keep(x86_64_linux.touch), {l0 l. fst(l) = m && snd(l) in omega && int_le(snd(l), n)}, {l. int_sub(n, snd(l))})
qed

// ----------------------------------------------------------------------
//  Memory

// 64-bit addresses: a + (c - a) = c
theorem x86.bits_add_sub(a, c): c in bits(64) -> a in bits(64) -> bits_add(64, a, bits_of_int(64, bits_sub(64, c, a))) = c
proof
  assume hc: c in bits(64)
  assume ha: a in bits(64)
  show by defs(simp(hc, ha), bits_add, bits_sub, bits_of_int, pow2)
qed

// reading a byte through a store that did not cover it: the old byte. A
// byte that is not writable (code) is never covered by a store of
// writable bytes.
theorem x86.store_other: all vm b a n v c. c in bits(64) -> a in bits(64) ->
  (all i. i in omega -> int_lt(i, n) -> x86_64_linux.can_access(vm, bits_add(64, a, bits_of_int(64, i)), 1)) ->
  !x86_64_linux.can_access(vm, c, 1) ->
  app(x86_64_linux.store_le(b, a, n, v), c) = app(b, c)
proof
  fix vm
  fix b
  fix a
  fix n
  fix v
  fix c
  assume hc: c in bits(64)
  assume ha: a in bits(64)
  assume hw: all i. i in omega -> int_lt(i, n) -> x86_64_linux.can_access(vm, bits_add(64, a, bits_of_int(64, i)), 1)
  assume hn: !x86_64_linux.can_access(vm, c, 1)
  have e1 := mp(app_fn_build[d := bits(64), v := x. ite(int_lt(bits_sub(64, x, a), n), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), app(b, x)), a := c], hc)
  have k: bits_sub(64, c, a) in omega by defs(simp(hc, ha), bits_sub, pow2)
  have id := mp(mp(x86.bits_add_sub[a := a, c := c], hc), ha)
  have nlt0: int_lt(bits_sub(64, c, a), n) -> false proof
    assume lt: int_lt(bits_sub(64, c, a), n)
    have w := mp(mp(all_elim(hw, {bits_sub(64, c, a)}), k), lt)
    show by taut(rewrite(id, w), hn)
  qed
  have nlt: !int_lt(bits_sub(64, c, a), n) by taut(nlt0)
  have f := mp(ite_f[c := int_lt(bits_sub(64, c, a), n), a := bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, c, a)))), b := app(b, c)], nlt)
  show by defs(taut(trans(e1, f)), x86_64_linux.store_le)
qed
// storing byte i after bytes 0..i-1 is storing bytes 0..i
theorem x86.store_step: all b a i v. a in bits(64) -> i in omega -> int_lt(i, 18446744073709551616) ->
  fn_update(x86_64_linux.store_le(b, a, i, v), bits_add(64, a, bits_of_int(64, i)), bits_of_int(8, int_div(v, int_pow(256, i)))) = x86_64_linux.store_le(b, a, int_add(i, 1), v)
proof
  fix b
  fix a
  fix i
  fix v
  assume ha: a in bits(64)
  assume hi: i in omega
  assume hm: int_lt(i, 18446744073709551616)
  have kb: bits_add(64, a, bits_of_int(64, i)) in bits(64) by defs(simp(ha, hi, hm), bits_add, bits_of_int, pow2)
  have dk: bits_sub(64, bits_add(64, a, bits_of_int(64, i)), a) = i by defs(simp(ha, hi, hm), bits_add, bits_sub, bits_of_int, pow2)
  have lt1: int_lt(i, int_add(i, 1)) by arith(hi)
  have gk0 := mp(ite_t[c := int_lt(i, int_add(i, 1)), a := bits_of_int(8, int_div(v, int_pow(256, i))), b := app(b, bits_add(64, a, bits_of_int(64, i)))], lt1)
  have gk: ite(int_lt(bits_sub(64, bits_add(64, a, bits_of_int(64, i)), a), int_add(i, 1)), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, bits_add(64, a, bits_of_int(64, i)), a)))), app(b, bits_add(64, a, bits_of_int(64, i)))) = bits_of_int(8, int_div(v, int_pow(256, i))) by simp(dk, gk0)
  have others: all x. x in bits(64) -> !(x = bits_add(64, a, bits_of_int(64, i))) -> ite(int_lt(bits_sub(64, x, a), int_add(i, 1)), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), app(b, x)) = ite(int_lt(bits_sub(64, x, a), i), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), app(b, x)) proof
    fix x
    assume xb: x in bits(64)
    assume xk: !(x = bits_add(64, a, bits_of_int(64, i)))
    have db: bits_sub(64, x, a) in omega by defs(simp(xb, ha), bits_sub, pow2)
    have back := mp(mp(x86.bits_add_sub[a := a, c := x], xb), ha)
    have ne0: bits_sub(64, x, a) = i -> false proof
      assume e: bits_sub(64, x, a) = i
      show by taut(sym(rewrite(e, back)), xk)
    qed
    have nei: !(bits_sub(64, x, a) = i) by taut(ne0)
    have c1: int_lt(bits_sub(64, x, a), i) -> ite(int_lt(bits_sub(64, x, a), int_add(i, 1)), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), app(b, x)) = ite(int_lt(bits_sub(64, x, a), i), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), app(b, x)) proof
      assume l: int_lt(bits_sub(64, x, a), i)
      have l2: int_lt(bits_sub(64, x, a), int_add(i, 1)) by arith(l, db, hi)
      have t1 := mp(ite_t[c := int_lt(bits_sub(64, x, a), int_add(i, 1)), a := bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), b := app(b, x)], l2)
      have t2 := mp(ite_t[c := int_lt(bits_sub(64, x, a), i), a := bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), b := app(b, x)], l)
      show by taut(trans(t1, sym(t2)))
    qed
    have c2: !int_lt(bits_sub(64, x, a), i) -> ite(int_lt(bits_sub(64, x, a), int_add(i, 1)), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), app(b, x)) = ite(int_lt(bits_sub(64, x, a), i), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), app(b, x)) proof
      assume l: !int_lt(bits_sub(64, x, a), i)
      have l2: !int_lt(bits_sub(64, x, a), int_add(i, 1)) by arith(l, db, hi, nei)
      have t1 := mp(ite_f[c := int_lt(bits_sub(64, x, a), int_add(i, 1)), a := bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), b := app(b, x)], l2)
      have t2 := mp(ite_f[c := int_lt(bits_sub(64, x, a), i), a := bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), b := app(b, x)], l)
      show by taut(trans(t1, sym(t2)))
    qed
    show by taut(c1, c2)
  qed
  have fu := mp(mp(mp(fn_update_build[d := bits(64), f := x. ite(int_lt(bits_sub(64, x, a), i), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), app(b, x)), g := x. ite(int_lt(bits_sub(64, x, a), int_add(i, 1)), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), app(b, x)), k := bits_add(64, a, bits_of_int(64, i)), w := bits_of_int(8, int_div(v, int_pow(256, i)))], kb), gk), others)
  show by defs(taut(fu), x86_64_linux.store_le)
qed

// storing no bytes changes nothing (memory: a function on 64-bit addresses)
theorem x86.store_zero: all b a v. is_fun(b) -> dom(b) = bits(64) -> a in bits(64) -> x86_64_linux.store_le(b, a, 0, v) = b
proof
  fix b
  fix a
  fix v
  assume hf: is_fun(b)
  assume hd: dom(b) = bits(64)
  assume ha: a in bits(64)
  have pw: all x. x in bits(64) -> ite(int_lt(bits_sub(64, x, a), 0), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), app(b, x)) = app(b, x) proof
    fix x
    assume xb: x in bits(64)
    have n0: !int_lt(bits_sub(64, x, a), 0) by defs(simp(xb, ha), bits_sub, pow2)
    show by taut(mp(ite_f[c := int_lt(bits_sub(64, x, a), 0), a := bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), b := app(b, x)], n0))
  qed
  have ext := mp(fn_build_ext[d := bits(64), f := x. ite(int_lt(bits_sub(64, x, a), 0), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), app(b, x)), g := x. app(b, x)], pw)
  have eta := mp(mp(fn_eta[f := b, d := bits(64)], hf), hd)
  show by defs(taut(trans(ext, eta)), x86_64_linux.store_le)
qed

// a natural at most q and not below q is q
theorem x86.le_not_lt: all p q. p in omega -> q in omega -> int_le(p, q) -> !int_lt(p, q) -> p = q
proof
  fix p
  fix q
  assume hp: p in omega
  assume hq: q in omega
  assume h1: int_le(p, q)
  assume h2: !int_lt(p, q)
  show by arith(hp, hq, h1, h2)
qed

// The closed form of the memory write means the same as the byte loop it
// replaced (layers/x86_checks.sl), for every store of at most 2^64 bytes
// (the model stores at most 16) and a machine whose memory is a function
// on 64-bit addresses.
theorem x86.store_bytes_closed: all m a n v o. n in omega -> int_le(n, 18446744073709551616) -> a in bits(64) ->
  is_fun(app(app(m, "vm"), "bytes")) -> dom(app(app(m, "vm"), "bytes")) = bits(64) ->
  is_fun(m) -> "vm" in dom(m) -> is_fun(app(m, "vm")) -> "bytes" in dom(app(m, "vm")) ->
  runs(x86_checks.store_bytes(a, n, v), m, o) -> o = ok(fn_update(m, "vm", fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), a, n, v))), empty)
proof
  fix m
  fix a
  fix n
  fix v
  fix o
  assume hn: n in omega
  assume hm: int_le(n, 18446744073709551616)
  assume ha: a in bits(64)
  assume hb: is_fun(app(app(m, "vm"), "bytes"))
  assume hd: dom(app(app(m, "vm"), "bytes")) = bits(64)
  assume hf: is_fun(m)
  assume hv: "vm" in dom(m)
  assume hf2: is_fun(app(m, "vm"))
  assume hv2: "bytes" in dom(app(m, "vm"))
  assume h: runs(x86_checks.store_bytes(a, n, v), m, o)
  // the start: no bytes stored is m itself
  have z := mp(mp(mp(all_elim(all_elim(all_elim(x86.store_zero, {app(app(m, "vm"), "bytes")}), {a}), {v}), hb), hd), ha)
  have s1 := mp(mp(fn_update_same[f := app(m, "vm"), k := "bytes"], hf2), hv2)
  have s2 := mp(mp(fn_update_same[f := m, k := "vm"], hf), hv)
  have start: fn_update(m, "vm", fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), a, 0, v))) = m by taut(trans(rewrite(sym(z), rewrite(sym(s1), s2)), refl({m})))
  show by simp(h, hn, hm, ha, start, x86.store_step, x86.le_not_lt,
    {l0 l. snd(l) in omega && int_le(snd(l), n) && fst(l) = fn_update(m, "vm", fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), a, snd(l), v)))}, {l. int_sub(n, snd(l))})
qed

// access rights are per page
theorem x86.same_page: all vm a b k. x86_64_linux.can_access(vm, b, k) -> int_div(a, 4096) = int_div(b, 4096) -> x86_64_linux.can_access(vm, a, k)
proof
  fix vm
  fix a
  fix b
  fix k
  assume h: x86_64_linux.can_access(vm, b, k)
  assume e: int_div(a, 4096) = int_div(b, 4096)
  show by defs(simp(expand(h, x86_64_linux.can_access, x86_64_linux.page_of), e), x86_64_linux.can_access, x86_64_linux.page_of)
qed

// what can be written can be read
theorem x86.write_read: all vm a. x86_64_linux.can_access(vm, a, 1) -> x86_64_linux.can_access(vm, a, 0)
proof
  fix vm
  fix a
  assume h: x86_64_linux.can_access(vm, a, 1)
  show by defs(simp(expand(h, x86_64_linux.can_access, x86_64_linux.hw_allows)), x86_64_linux.can_access, x86_64_linux.hw_allows, x86_64_linux.accessible)
qed

// storing bytes keeps a byte map a byte map
theorem x86.store_typed: all b a n v. b in fn_space(bits(64), bits(8)) -> x86_64_linux.store_le(b, a, n, v) in fn_space(bits(64), bits(8))
proof
  fix b
  fix a
  fix n
  fix v
  assume bt: b in fn_space(bits(64), bits(8))
  have vals: all x. x in bits(64) -> ite(int_lt(bits_sub(64, x, a), n), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), app(b, x)) in bits(8) proof
    fix x
    assume hx: x in bits(64)
    have ax := mp(mp(fn_space_app[a := bits(64), b := bits(8), f := b, x := x], bt), hx)
    have c1: int_lt(bits_sub(64, x, a), n) -> ite(int_lt(bits_sub(64, x, a), n), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), app(b, x)) in bits(8) proof
      assume hc: int_lt(bits_sub(64, x, a), n)
      have e := mp(ite_t[c := int_lt(bits_sub(64, x, a), n), a := bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), b := app(b, x)], hc)
      have m: bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))) in bits(8) by simp()
      show := rewrite(sym(e), m)
    qed
    have c2: !int_lt(bits_sub(64, x, a), n) -> ite(int_lt(bits_sub(64, x, a), n), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), app(b, x)) in bits(8) proof
      assume hc: !int_lt(bits_sub(64, x, a), n)
      have e := mp(ite_f[c := int_lt(bits_sub(64, x, a), n), a := bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), b := app(b, x)], hc)
      show := rewrite(sym(e), ax)
    qed
    show by taut(c1, c2)
  qed
  have st := mp(fn_build_space[d := bits(64), v := x. ite(int_lt(bits_sub(64, x, a), n), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, a)))), app(b, x)), b := bits(8)], vals)
  show by defs(st, x86_64_linux.store_le)
qed

// storing bytes keeps a memory well-typed
theorem x86.store_vm: all vm a n v. vm in x86_64_linux.Vm -> fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, n, v)) in univ(1) ->
  fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, n, v)) in x86_64_linux.Vm
proof
  fix vm
  fix a
  fix n
  fix v
  assume h: vm in x86_64_linux.Vm
  assume hu: fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, n, v)) in univ(1)
  have ht: is_fun(vm) && dom(vm) = insert("pages", insert("bytes", insert("stack_top", insert("stack_limit", insert("brk_start", insert("brk", empty)))))) && app(vm, "bytes") in fn_space(bits(64), bits(8)) by simp(expand(h, x86_64_linux.Vm))
  have bt: app(vm, "bytes") in fn_space(bits(64), bits(8)) by taut(ht)
  have st := expand(mp(all_elim(all_elim(all_elim(all_elim(x86.store_typed, {app(vm, "bytes")}), {a}), {n}), {v}), bt), x86_64_linux.store_le)
  have hf: is_fun(vm) by taut(ht)
  have bd: "bytes" in dom(vm) by simp(ht)
  have fuf := mp(fn_update_fun[f := vm, k := "bytes", v := x86_64_linux.store_le(app(vm, "bytes"), a, n, v)], hf)
  have fud := mp(mp(fn_update_dom[f := vm, k := "bytes", v := x86_64_linux.store_le(app(vm, "bytes"), a, n, v)], hf), bd)
  have dv: dom(vm) = insert("pages", insert("bytes", insert("stack_top", insert("stack_limit", insert("brk_start", insert("brk", empty)))))) by taut(ht)
  have pv: ((((((is_fun(fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, n, v))) && dom(fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, n, v))) = insert("pages", insert("bytes", insert("stack_top", insert("stack_limit", insert("brk_start", insert("brk", empty))))))) && app(fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, n, v)), "pages") in fn_space(set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))), option(x86_64_linux.Page))) && app(fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, n, v)), "bytes") in fn_space(bits(64), bits(8))) && app(fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, n, v)), "stack_top") in bits(64)) && app(fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, n, v)), "stack_limit") in omega) && app(fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, n, v)), "brk_start") in bits(64)) && app(fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, n, v)), "brk") in bits(64) by defs(simp(expand(h, x86_64_linux.Vm), st, expand(fuf, x86_64_linux.store_le), expand(fud, x86_64_linux.store_le), dv), x86_64_linux.store_le)
  have r := mp(mp(mp(mp(rec_type_intro[u := 1, k := insert("pages", insert("bytes", insert("stack_top", insert("stack_limit", insert("brk_start", insert("brk", empty)))))), p := x0. ((((((is_fun(x0) && dom(x0) = insert("pages", insert("bytes", insert("stack_top", insert("stack_limit", insert("brk_start", insert("brk", empty))))))) && app(x0, "pages") in fn_space(set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))), option(x86_64_linux.Page))) && app(x0, "bytes") in fn_space(bits(64), bits(8))) && app(x0, "stack_top") in bits(64)) && app(x0, "stack_limit") in omega) && app(x0, "brk_start") in bits(64)) && app(x0, "brk") in bits(64), r := fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, n, v))], hu), fuf), trans(fud, dv)), pv)
  show by defs(r, x86_64_linux.Vm)
qed

// a store away from the 8 bytes at r leaves them (e.g. a return address)
theorem x86.le_store_far: all b r a n v. r in bits(64) -> a in bits(64) ->
  (all k. k in omega -> int_lt(k, 8) -> !int_lt(bits_sub(64, bits_add(64, r, bits_of_int(64, k)), a), n)) ->
  x86_64_linux.le(x86_64_linux.store_le(b, a, n, v), r, 8) = x86_64_linux.le(b, r, 8)
proof
  fix b
  fix r
  fix a
  fix n
  fix v
  assume hr: r in bits(64)
  assume ha: a in bits(64)
  assume hk: all k. k in omega -> int_lt(k, 8) -> !int_lt(bits_sub(64, bits_add(64, r, bits_of_int(64, k)), a), n)
  have k0 := mp(all_elim(hk, {0}), simp(), simp())
  have k1 := mp(all_elim(hk, {1}), simp(), simp())
  have k2 := mp(all_elim(hk, {2}), simp(), simp())
  have k3 := mp(all_elim(hk, {3}), simp(), simp())
  have k4 := mp(all_elim(hk, {4}), simp(), simp())
  have k5 := mp(all_elim(hk, {5}), simp(), simp())
  have k6 := mp(all_elim(hk, {6}), simp(), simp())
  have k7 := mp(all_elim(hk, {7}), simp(), simp())
  show by defs(simp(hr, ha, k0, k1, k2, k3, k4, k5, k6, k7), x86_64_linux.le, x86_64_linux.store_le)
qed

// a 4-byte store as its byte updates
theorem x86.store4: all b a v. is_fun(b) -> dom(b) = bits(64) -> a in bits(64) -> v in omega ->
  x86_64_linux.store_le(b, a, 4, v) = fn_update(fn_update(fn_update(fn_update(b, a, bits_of_int(8, v)), bits_add(64, a, 1), bits_of_int(8, int_div(v, 256))), bits_add(64, a, 2), bits_of_int(8, int_div(v, 65536))), bits_add(64, a, 3), bits_of_int(8, int_div(v, 16777216)))
proof
  fix b
  fix a
  fix v
  assume hf: is_fun(b)
  assume hd: dom(b) = bits(64)
  assume ha: a in bits(64)
  assume hv: v in omega
  have z := apply(x86.store_zero, {b}, {a}, {v}, hf, hd, ha)
  have e1: fn_update(b, a, bits_of_int(8, v)) = x86_64_linux.store_le(b, a, 1, v) by simp(ha, hv, rewrite(z, apply(x86.store_step, {b}, {a}, {0}, {v}, ha, simp(), simp())))
  have e2: fn_update(fn_update(b, a, bits_of_int(8, v)), bits_add(64, a, 1), bits_of_int(8, int_div(v, 256))) = x86_64_linux.store_le(b, a, 2, v)
    by simp(ha, hv, rewrite(sym(e1), apply(x86.store_step, {b}, {a}, {1}, {v}, ha, simp(), simp())))
  have e3: fn_update(fn_update(fn_update(b, a, bits_of_int(8, v)), bits_add(64, a, 1), bits_of_int(8, int_div(v, 256))), bits_add(64, a, 2), bits_of_int(8, int_div(v, 65536))) = x86_64_linux.store_le(b, a, 3, v)
    by simp(ha, hv, rewrite(sym(e2), apply(x86.store_step, {b}, {a}, {2}, {v}, ha, simp(), simp())))
  have e4: fn_update(fn_update(fn_update(fn_update(b, a, bits_of_int(8, v)), bits_add(64, a, 1), bits_of_int(8, int_div(v, 256))), bits_add(64, a, 2), bits_of_int(8, int_div(v, 65536))), bits_add(64, a, 3), bits_of_int(8, int_div(v, 16777216))) = x86_64_linux.store_le(b, a, 4, v)
    by simp(ha, hv, rewrite(sym(e3), apply(x86.store_step, {b}, {a}, {3}, {v}, ha, simp(), simp())))
  show := sym(e4)
qed

// a condition code's test of the flags, computed (a conditional jump's
// branch condition: `ja` is cc 7, !(cf || zf))
abbrev x86.cc_test(f, cc) := ite(bits_slice(cc, 3, 1) = 0, app(f, "of"), ite(bits_slice(cc, 3, 1) = 1, app(f, "cf"), ite(bits_slice(cc, 3, 1) = 2, app(f, "zf"), ite(bits_slice(cc, 3, 1) = 3, app(f, "cf") || app(f, "zf"), ite(bits_slice(cc, 3, 1) = 4, app(f, "sf"), ite(bits_slice(cc, 3, 1) = 5, app(f, "pf"), ite(bits_slice(cc, 3, 1) = 6, !(app(f, "sf") = app(f, "of")), app(f, "zf") || !(app(f, "sf") = app(f, "of")))))))))
abbrev x86.cc_prog(f, cc) := mkprog(x2 x3. letin(x86.cc_test(f, cc), x4. x3 = ok(x2, !(x4 = bit(cc, 0)))))
// (bit 0 of the code negates the test)
abbrev x86.cc_val(f, cc) := (!(x86.cc_test(f, cc) = bit(cc, 0)))

theorem x86.cond_eval: all f cc. x86_64_linux.cond(f, cc) = x86.cc_val(f, cc)
proof
  fix f
  fix cc
  have pq: all x0. (ex x1. runs(x86.cc_prog(f, cc), empty, ok(x1, x0))) <-> x0 = x86.cc_val(f, cc) proof
    fix x0
    have d1: (ex x1. runs(x86.cc_prog(f, cc), empty, ok(x1, x0))) -> x0 = x86.cc_val(f, cc) proof
      assume h: ex x1. runs(x86.cc_prog(f, cc), empty, ok(x1, x0))
      obtain y, hy from h
      show by simp(hy)
    qed
    have d2: x0 = x86.cc_val(f, cc) -> (ex x1. runs(x86.cc_prog(f, cc), empty, ok(x1, x0))) proof
      assume h: x0 = x86.cc_val(f, cc)
      // (a proposition: in univ(0), by the prelude's prop_univ)
      have u: x86.cc_val(f, cc) in univ(1) by simp()
      have ux: x0 in univ(1) := rewrite(sym(h), u)
      have r: runs(x86.cc_prog(f, cc), empty, ok(empty, x0)) by simp(h, ux)
      show := ex_intro({empty}, {x1. runs(x86.cc_prog(f, cc), empty, ok(x1, x0))}, r)
    qed
    show by taut(d1, d2)
  qed
  have e := mp(choose_ext[p := x0. ex x1. runs(x86.cc_prog(f, cc), empty, ok(x1, x0)), q := x0. x0 = x86.cc_val(f, cc)], pq)
  have ea := ex_intro({x86.cc_val(f, cc)}, {x. x = x86.cc_val(f, cc)}, all_elim(all_refl, {x86.cc_val(f, cc)}))
  have c := mp(choose_eq[a := x86.cc_val(f, cc)], ea)
  show by defs(trans(e, c), x86_64_linux.cond)
qed

// `and` commutes (the machine's `and` may take its operands in the other
// order than the source)
theorem x86.and_comm: all n a b. bits_and(n, a, b) = bits_and(n, b, a)
proof
  fix n
  fix a
  fix b
  have pq: all x. (x in bits(n) && (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(a, i) && bit(b, i)))) <-> (x in bits(n) && (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(b, i) && bit(a, i)))) proof
    fix x
    have d1: (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(a, i) && bit(b, i))) -> (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(b, i) && bit(a, i))) proof
      assume h: all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(a, i) && bit(b, i))
      fix i
      assume i1: i in omega
      assume i2: int_lt(i, n)
      have hi := mp(all_elim(h, {i}), i1, i2)
      show by taut(hi)
    qed
    have d2: (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(b, i) && bit(a, i))) -> (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(a, i) && bit(b, i))) proof
      assume h: all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(b, i) && bit(a, i))
      fix i
      assume i1: i in omega
      assume i2: int_lt(i, n)
      have hi := mp(all_elim(h, {i}), i1, i2)
      show by taut(hi)
    qed
    show by taut(d1, d2)
  qed
  have e := mp(choose_ext[p := x. x in bits(n) && (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(a, i) && bit(b, i))), q := x. x in bits(n) && (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(b, i) && bit(a, i)))], pq)
  show by defs(e, bits_and, bits_build)
qed
