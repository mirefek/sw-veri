// What a client of the malloc layer can conclude from the spec alone
// (layers/malloc.sl), by symbolic execution (`simp`).
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core core/records.core \
//     core/list.core core/loop.core build/musl_malloc.core proofs/malloc_client.core

// free(NULL) returns and changes nothing (in a process as at any call)
theorem malloc.free_null(i, o, e, b, c, st, s, r): runs(malloc.free(i, o, e, b, c, st, 0), s, r) -> malloc.world_ok(b, c, st, s) -> r = ok(s, empty)
proof
  assume h hwo
  show by simp(h, hwo)
qed

// free(p) of a live block returns normally, with p no longer live. (The
// law free_step rules out the path where no allocator step exists.)
theorem malloc.free_live(i, o, e, b, c, st, p, s, r):
  malloc.free_step(i, o, e, b, c, st) -> s in rec_and(abi.World, malloc.Heap.ghost) -> p in bits(64) ->
  runs(malloc.free(i, o, e, b, c, st, p), s, r) -> !(p = 0) -> s in i -> malloc.errno_ok(e, s) -> malloc.world_ok(b, c, st, s) -> !(s.blocks[p] = none) ->
    ex t. r = ok(t, empty) && t.blocks = malloc.set_block(s.blocks, p, none)
proof
  assume hl hs hp h h0 hi he hwo hb
  // a step exists (the law, for s and p)
  have hsp: s in rec_and(abi.World, malloc.Heap.ghost) && p in bits(64) by taut(hs, hp)
  have hib: s in i && malloc.world_ok(b, c, st, s) && malloc.errno_ok(e, s) && !(s.blocks[p] = none) by taut(hi, hwo, he, hb)
  have step := mp(mp(all_elim(all_elim(expand(hl, malloc.free_step), {s}), {p}), hsp), hib)
  show by simp(h, h0, hi, he, hwo, hb, step)
qed

// malloc must fail when there is no place for a block: if no 16-aligned,
// non-null address has a free range (allocator memory or unmapped pages) of
// any size, a normal return gives NULL.
theorem malloc.no_place_null(i, o, e, b, c, st, n, s, r, t, v):
  runs(malloc.malloc(i, o, e, b, c, st, n), s, r) ->
  (all z. !(ex p. p in bits(64) && ((!(p = 0) && int_mod(p, 16) = 0) && malloc.fresh_block(o, s, p, z)))) ->
  s in i -> malloc.errno_ok(e, s) -> malloc.world_ok(b, c, st, s) -> r = ok(t, v) -> v = 0
proof
  assume h hn hi he hwo hr
  show by simp(h, hn, hi, he, hwo, hr)
qed

// reading the block set where it was set
theorem malloc.set_block_at: all b p z. p in bits(64) -> malloc.set_block(b, p, z)[p] = z
proof
  fix b p z
  assume hp
  have a := mp(app_fn_build[d := bits(64), v := x. ite(x = p, z, b[x]), a := p], hp)
  have it := mp(ite_t[c := p = p, a := z, b := b[p]], eq_refl[a := p])
  show by defs(taut(trans(a, it)), malloc.set_block)
qed

// a block malloc returns is 16-byte aligned and live afterwards. (simp
// left one path, the block set read at p; malloc.set_block_at, passed as
// a rule, closes it.)
theorem malloc.result_live(i, o, e, b, c, st, n, s, r, t, v):
  runs(malloc.malloc(i, o, e, b, c, st, n), s, r) -> s in i -> malloc.errno_ok(e, s) -> malloc.world_ok(b, c, st, s) ->
  r = ok(t, v) -> !(v = 0) -> int_mod(v, 16) = 0 && !(t.blocks[v] = none)
proof
  assume h hi he hwo hr h0
  show by simp(h, hi, he, hwo, hr, h0, malloc.set_block_at, {l0 l. snd(l) in omega})
qed

// a live block's usable byte is none of the callers' stack objects: the
// block is mapped, so off the stack's space, where the objects are
theorem malloc.block_not_obj(i, b, c, st, t, p, a):
  malloc.inv_wf(i) -> t in rec_and(abi.World, malloc.Heap.ghost) -> t in i -> malloc.world_ok(b, c, st, t) -> p in bits(64) -> !(t.blocks[p] = none) ->
  a in omega -> int_le(p, a) -> int_lt(a, int_add(p, snd(t.blocks[p]))) -> !(a in t.objs.live)
proof
  assume hw ht hi hwo hp hb ha h1 h2
  have hf := mp(all_elim(expand(hw, malloc.inv_wf), {t}), ht, hi)
  have _ lr := expand(hf, malloc.heap_wf)
  have rw := mp(all_elim(expand(lr, malloc.live_rw), {p}), hp, hb)
  have rm := mp(all_elim(rw, {a}), ha, conj(h1, h2))
  have m _ _ := expand(rm, malloc.rw_mapped)
  have ml mn := expand(m, x86_64_linux.mapped)
  have _ _ _ _ _ _ lv os := expand(hwo, malloc.world_ok)
  have qo: int_div(a, x86_64_linux.PAGE) in omega by defs(arith(ha), x86_64_linux.PAGE)
  have qs: int_div(a, x86_64_linux.PAGE) in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) by simp(qo, ml)
  have o := mp(all_elim(os, {int_div(a, x86_64_linux.PAGE)}), qs, mn)
  assume hl
  have l1 l2 _ := mp(all_elim(lv, {a}), ha, hl)
  have gp: x86_64_linux.STACK_GUARD_GAP in omega by defs(simp(), x86_64_linux.STACK_GUARD_GAP)
  show by arith(expand(o, x86_64_linux.off_stack_space, x86_64_linux.PAGE), l1, l2, ha, gp)
qed

// The allocator can always take a step: keeping memory as it is (the
// memory of a heap state is its `vm` field; its ghost part has no `vm`).
theorem malloc.idle_step(i, o, s, x):
  s in rec_and(abi.World, malloc.Heap.ghost) -> s in i ->
  ex vm. vm in x86_64_linux.Vm && malloc.step_ok(i, o, s, fn_update(s, "vm", vm), x) && fn_update(s, "vm", vm) = s
proof
  assume hs hi
  obtain w, hw from mp(rec_and_elim[a := abi.World, b := malloc.Heap.ghost, s := s], hs)
  obtain g, hg from hw
  have sw: s = union2(w, g) by taut(hg)
  have hw1: w in abi.World by taut(hg)
  have hg1: g in malloc.Heap.ghost by taut(hg)
  have ww := unsel(expand(hw1, abi.World))
  have gg := unsel(expand(hg1, malloc.Heap.ghost))
  // "vm" is a field of the world, not a ghost field
  have fw: is_fun(w) by taut(ww)
  have dw: dom(w) = insert("vm", insert("os", insert("fs_base", insert("cpu", insert("objs", empty))))) by taut(ww)
  have vw := rewrite(sym(dw), insert_l[a := "vm", s := insert("os", insert("fs_base", insert("cpu", insert("objs", empty))))])
  have dg: dom(g) = insert("blocks", empty) by taut(gg)
  have ng0: "vm" in dom(g) -> false proof
    assume h
    have c := mp(insert_elim[a := "blocks", s := empty, z := "vm"], rewrite(dg, h))
    have d: !("vm" = "blocks") by simp()
    show by taut(c, d, empty_mem[x := "vm"])
  qed
  have ng: !("vm" in dom(g)) by taut(ng0)
  // updating vm with its value changes nothing
  have fu := rewrite(sym(sw), mp(mp(mp(fn_update_union[w := w, g := g, k := "vm"], fw), vw), ng))
  // a step to s itself: frame and invariant kept, nothing newly owned
  have own: all a. a in omega -> a in o[s] ->
      (a in o[s] || a in x) || (!x86_64_linux.mapped(s.vm, int_div(a, x86_64_linux.PAGE)) && !(a in s.objs.live)) proof
    fix a
    show by taut()
  qed
  have st: malloc.step_ok(i, o, s, s, x) by defs(simp(hi, own), malloc.step_ok, malloc.alloc_frame)
  have st2 := subst({t. malloc.step_ok(i, o, s, t, x)}, sym(fu), st)
  have vm: w.vm in x86_64_linux.Vm by taut(ww)
  show by ex_intro({w.vm}, taut(vm, st2, sym(fu)))
qed

// malloc terminates. The loop of set_errno (state: the program state and
// the counter) needs an invariant and a variant.
theorem malloc.terminates(i, o, e, b, c, st, n, s, r):
  runs(malloc.malloc(i, o, e, b, c, st, n), s, r) -> s in rec_and(abi.World, malloc.Heap.ghost) -> s in i -> malloc.errno_ok(e, s) ->
  malloc.world_ok(b, c, st, s) -> !(ex t. r = diverge(t))
proof
  assume h ht hi he hwo
  have hs0 := mp(mp(malloc.idle_step[i := i, o := o, s := s, x := malloc.errno_bytes(e, s)], ht), hi)
  obtain vm, hv hst hse from hs0
  have hs: ex vm. vm in x86_64_linux.Vm && (malloc.step_ok(i, o, s, fn_update(s, "vm", vm), malloc.errno_bytes(e, s)) &&
      malloc.world_ok(b, c, st, fn_update(s, "vm", vm)) && malloc.errno_ok(e, fn_update(s, "vm", vm))) by ex_intro({vm}, taut(hv, hst, rewrite(sym(hse), hwo), rewrite(sym(hse), he)))
  show by simp(h, hi, he, hwo, hs, {l0 l. snd(l) in omega && int_le(snd(l), 4)}, {l. int_sub(4, snd(l))})
qed

// malloc's block p: a place of size z >= n fresh before, the new state
// that block set and the memory any of an allocator step (the world as
// any call needs it)
theorem malloc.malloc_blk(i, o, e, b, c, st, n, s, t, v):
  runs(malloc.malloc(i, o, e, b, c, st, n), s, ok(t, v)) -> s in i -> malloc.errno_ok(e, s) -> malloc.world_ok(b, c, st, s) -> !(v = 0) ->
  int_mod(v, 16) = 0 && (ex z V. z in omega && int_le(n, z) && malloc.fresh_block(o, s, v, z) &&
    t = fn_update(fn_update(s, "blocks", malloc.set_block(s.blocks, v, some(z))), "vm", V) &&
    malloc.step_ok(i, o, s, t, malloc.errno_bytes(e, s)) && malloc.world_ok(b, c, st, t) && malloc.errno_ok(e, t))
proof
  assume h hi he hwo h0
  show by simp(h, hi, he, hwo, h0, {l0 l. snd(l) in omega})
qed
