// What a client of the malloc layer can conclude from the spec alone
// (layers/malloc.sl), by symbolic execution (`simp`).
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core core/list.core \
//     core/loop.core core/records.core build/musl_malloc.core proofs/malloc_client.core

// free(NULL) returns and changes nothing
theorem malloc.free_null(i, o, e, s, r): runs(malloc.free(i, o, e, 0), s, r) -> r = ok(s, empty)
proof
  assume h: runs(malloc.free(i, o, e, 0), s, r)
  show by simp(h)
qed

// free(p) of a live block returns normally, with p no longer live. (The
// law free_step rules out the path where no allocator step exists.)
theorem malloc.free_live(i, o, e, p, s, r):
  malloc.free_step(i, o) -> s in rec_and(abi.World, malloc.Heap.ghost) -> p in bits(64) ->
  runs(malloc.free(i, o, e, p), s, r) -> !(p = 0) -> s in i -> malloc.errno_ok(e, s) -> !(app(app(s, "blocks"), p) = none) ->
    ex t. r = ok(t, empty) && app(t, "blocks") = malloc.set_block(app(s, "blocks"), p, none)
proof
  assume hl: malloc.free_step(i, o)
  assume hs: s in rec_and(abi.World, malloc.Heap.ghost)
  assume hp: p in bits(64)
  assume h: runs(malloc.free(i, o, e, p), s, r)
  assume h0: !(p = 0)
  assume hi: s in i
  assume he: malloc.errno_ok(e, s)
  assume hb: !(app(app(s, "blocks"), p) = none)
  // a step exists (the law, for s and p)
  have hsp: s in rec_and(abi.World, malloc.Heap.ghost) && p in bits(64) by taut(hs, hp)
  have hib: s in i && !(app(app(s, "blocks"), p) = none) by taut(hi, hb)
  have step := mp(mp(all_elim(all_elim(expand(hl, malloc.free_step), {s}), {p}), hsp), hib)
  show by simp(h, h0, hi, he, hb, step)
qed

// malloc must fail when there is no place for a block: if no 16-aligned,
// non-null address has a free range (allocator memory or unmapped pages) of
// any size, a normal return gives NULL.
theorem malloc.no_place_null(i, o, e, n, s, r, t, v):
  runs(malloc.malloc(i, o, e, n), s, r) ->
  (all z. !(ex p. p in bits(64) && ((!(p = 0) && nat_mod(p, 16) = 0) && malloc.fresh_block(o, s, p, z)))) ->
  s in i -> malloc.errno_ok(e, s) -> r = ok(t, v) -> v = 0
proof
  assume h: runs(malloc.malloc(i, o, e, n), s, r)
  assume hn: all z. !(ex p. p in bits(64) && ((!(p = 0) && nat_mod(p, 16) = 0) && malloc.fresh_block(o, s, p, z)))
  assume hi: s in i
  assume he: malloc.errno_ok(e, s)
  assume hr: r = ok(t, v)
  show by simp(h, hn, hi, he, hr)
qed

// The allocator can always take a step: keeping memory as it is (the
// memory of a heap state is its `vm` field; its ghost part has no `vm`).
theorem malloc.idle_step(i, o, s, x):
  s in rec_and(abi.World, malloc.Heap.ghost) -> s in i ->
  ex vm. vm in x86_64_linux.Vm && malloc.step_ok(i, o, s, fn_update(s, "vm", vm), x)
proof
  assume hs: s in rec_and(abi.World, malloc.Heap.ghost)
  assume hi: s in i
  obtain w, hw from mp(rec_and_elim[a := abi.World, b := malloc.Heap.ghost, s := s], hs)
  obtain g, hg from hw
  have sw: s = union2(w, g) by taut(hg)
  have hw1: w in abi.World by taut(hg)
  have hg1: g in malloc.Heap.ghost by taut(hg)
  have ww := unsel(expand(hw1, abi.World))
  have gg := unsel(expand(hg1, malloc.Heap.ghost))
  // "vm" is a field of the world, not a ghost field
  have fw: is_fun(w) by taut(ww)
  have dw: dom(w) = insert("vm", insert("os", insert("fs_base", insert("cpu", insert("sp", empty))))) by taut(ww)
  have vw := rewrite(sym(dw), insert_l[a := "vm", s := insert("os", insert("fs_base", insert("cpu", insert("sp", empty))))])
  have dg: dom(g) = insert("blocks", empty) by taut(gg)
  have ng0: "vm" in dom(g) -> false proof
    assume h: "vm" in dom(g)
    have c := mp(insert_elim[a := "blocks", s := empty, z := "vm"], rewrite(dg, h))
    have d: !("vm" = "blocks") by simp()
    show by taut(c, d, empty_mem[x := "vm"])
  qed
  have ng: !("vm" in dom(g)) by taut(ng0)
  // updating vm with its value changes nothing
  have fu := rewrite(sym(sw), mp(mp(mp(fn_update_union[w := w, g := g, k := "vm"], fw), vw), ng))
  // a step to s itself: frame and invariant kept, nothing newly owned
  have own: all a. a in omega -> a in app(o, s) ->
      (a in app(o, s) || a in x) || !x86_64_linux.mapped(app(s, "vm"), nat_div(a, x86_64_linux.PAGE)) proof
    fix a
    show by taut()
  qed
  have st: malloc.step_ok(i, o, s, s, x) by defs(simp(hi, own), malloc.step_ok, malloc.alloc_frame)
  have st2 := subst({t. malloc.step_ok(i, o, s, t, x)}, sym(fu), st)
  have vm: app(w, "vm") in x86_64_linux.Vm by taut(ww)
  show by ex_intro({app(w, "vm")}, taut(vm, st2))
qed

// malloc terminates. The loop of set_errno (state: the program state and
// the counter) needs an invariant and a variant.
theorem malloc.terminates(i, o, e, n, s, r):
  runs(malloc.malloc(i, o, e, n), s, r) -> s in rec_and(abi.World, malloc.Heap.ghost) -> s in i -> malloc.errno_ok(e, s) ->
  !(ex t. r = diverge(t))
proof
  assume h: runs(malloc.malloc(i, o, e, n), s, r)
  assume ht: s in rec_and(abi.World, malloc.Heap.ghost)
  assume hi: s in i
  assume he: malloc.errno_ok(e, s)
  have hs := mp(mp(malloc.idle_step[i := i, o := o, s := s, x := malloc.errno_bytes(e, s)], ht), hi)
  show by simp(h, hi, he, hs, {l0 l. snd(l) in omega && nat_le(snd(l), 4)}, {l. nat_sub(4, snd(l))})
qed
