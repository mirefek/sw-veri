// step_seq's C1 by the bridge, its loop cut at the head. Run after the leaf
// chain + proofs/abi_loop.core + proofs/abi_bridge.core + proofs/step_seq.core
// (BRIDGE_DEBUG=1 shows the segments).
theorem brt.ss(args, s, o, statics): args in abi.ARGS -> s in x86_64_linux.Machine -> abi.loaded(app(s, "vm"), 4203722, step_seq.code(), statics) ->
  (all a. a in omega -> int_le(4228176, a) -> int_lt(a, 4228241) -> a in statics) -> app(s, "rip") = 4203722 ->
  abi.entry_ok(s, args) -> runs(abi.run_to_return(), s, o) -> abi.matches(ss.spec, args, s, o)
proof
  assume hA: args in abi.ARGS
  assume hM: s in x86_64_linux.Machine
  assume hl: abi.loaded(app(s, "vm"), 4203722, step_seq.code(), statics)
  assume hst: all a. a in omega -> int_le(4228176, a) -> int_lt(a, 4228241) -> a in statics
  assume hrip: app(s, "rip") = 4203722
  assume he: abi.entry_ok(s, args)
  assume hr: runs(abi.run_to_return(), s, o)
  have hc: abi.code_at(app(s, "vm"), 4203722, step_seq.code()) by taut(expand(hl, abi.loaded))
  have su: s in univ(1) by simp(apply(abi.run_univ, hr))
  have ent := apply(abi.entry_stack, hM, he)
  have hsp: app(app(s, "gpr"), 4) in bits(64) by simp(hM)
  // the static data apart from the frame (statics: no stack pages)
  have ns: all j. j in omega -> int_lt(j, 65) -> !abi.stack_page(app(s, "vm"), int_div(int_add(4228176, j), 4096)) proof
    fix j
    assume j1: j in omega
    assume j2: int_lt(j, 65)
    have m := mp(mp(mp(all_elim(hst, {int_add(4228176, j)}), simp(j1)), simp(j1)), simp(j1, j2))
    have ls: all x0. x0 in omega -> x0 in statics -> !abi.stack_page(app(s, "vm"), int_div(x0, 4096)) by simp(expand(hl, abi.loaded))
    show := mp(mp(all_elim(ls, {int_add(4228176, j)}), simp(j1)), m)
  qed
  have ap := apply(abi.frame_apart, {app(s, "vm")}, {app(app(s, "gpr"), 4)}, {4228176}, {65}, hsp, ent, ent, ent, simp(), simp(), ns)
  show := bridge(hr, {app(ss.spec, args)}, {l. int_le(snd(l), 32)}, hA, hM, hc, hrip, su, ent, ap, he, expand(he, abi.entry_ok), x86.cond_eval,
    step_seq.ok_4024ca, step_seq.ok_4024d1, step_seq.ok_4024d3, step_seq.ok_4024d5, step_seq.ok_4024dd, step_seq.ok_4024df, step_seq.ok_4024e3, step_seq.ok_4024e5,
    step_seq.ok_4024ec, step_seq.ok_4024f0, step_seq.ok_4024f5, step_seq.ok_4024fa, step_seq.ok_4024fc, step_seq.ok_402503, step_seq.ok_402505, step_seq.ok_40250c,
    step_seq.ok_40250f, step_seq.ok_402515, step_seq.ok_402516,
    g.padd_ok, g.padd_ub, g.ld8_ok, g.ld8_ub, g.mem_at_ok, g.mem_at_ub, g.elem1_ok,
    abi.slot_at, abi.ret_at, g.read_at, g.write_at, g.read_off, g.write_off, g.store_univ, x86.store_typed, abi.sp_low,
    abi.sv_refl, abi.sv_base, abi.slot_sv, abi.wm_base, abi.slot_wm, abi.wm_refl, abi.slot_matches,
    abi.agree_refl, abi.agree_slot, abi.agree_st1, abi.agree_st1b, abi.agree_wm2)
qed
