// The thread pointer (readable GIMPLE's `thread_ptr()`, layers/gimple.sl:
// the ABI's fs_base in a sound thread; musl's __get_tp's `mov %fs:0, r`,
// the word there): the machine's load, GIMPLE's op, C1's rule.
//
//   checked after proofs/translate.core

// (fs:[d], no base, no index)
abbrev x86i.fs_mem(d) := tag(2, fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 2), "base", tag(0, empty)), "index", none), "scale", 1), "disp", d))

// mov r64, qword fs:[d] (64 8B /r): g := the 8 bytes at fs_base + d
theorem x86i.load64_fs: all m o g d z2 len. m in x86_64_linux.Machine -> m in univ(1) -> g in x86_64_linux.Reg -> d in bits(64) ->
  x86i.acc(m, bits_add(64, int_add(m.fs_base, d), 0), 8, 0) ->
  runs(x86_64_linux.exec_body(len, tag(76, pair(8, pair(g, pair(x86i.fs_mem(d), pair(x86i.fs_mem(d), z2)))))), m, o) ->
  o = ok(fn_update(fn_update(m, "rip", bits_add(64, m.rip, len)), "gpr",
    fn_update(m.gpr, g, x86_64_linux.le(m.vm.bytes, bits_add(64, int_add(m.fs_base, d), 0), 8))), empty)
proof
  fix m o g d z2 len
  assume hM hu h0 h2 a0 hr
  have pt := apply(x86i.parts, hM)
  have fb: m.fs_base in bits(64) by simp(expand(hM, x86_64_linux.Machine))
  have k0: all j. j in omega -> int_lt(j, 8) -> x86_64_linux.canonical(bits_add(64, bits_add(64, int_add(m.fs_base, d), 0), bits_of_int(64, j))) proof
    fix j
    assume j1 j2
    show by mp(all_elim(all_elim(all_elim(x86.access_canonical, {m.vm}), {bits_add(64, bits_add(64, int_add(m.fs_base, d), 0), bits_of_int(64, j))}), {0}), mp(mp(all_elim(a0, {j}), j1), j2))
  qed
  show by simp(hr, hu, pt, h2, fb, apply(x86i.reg_typed, hM, h0), a0, k0, x86.touch_range_access, keep(x86_64_linux.touch_range, x86_64_linux.can_access))
qed

// GIMPLE's: the ABI's thread pointer, in a sound thread (else undefined)
// -- a word (C1's values: bits_of_int as a load's)
theorem tr.tp_ok: all s. s in abi.World && s in univ(1) -> abi.thread_ok(s.vm, s.fs_base) ->
  runs(gimple.thread_ptr(), s, ok(s, bits_of_int(64, s.fs_base)))
proof
  fix s
  assume hws ht
  have hW hs := hws
  have hf: s.fs_base in bits(64) by simp(expand(hW, abi.World))
  have bt: bits_of_int(64, s.fs_base) = s.fs_base by simp(hf)
  show by defs(simp(hs, hf, ht, bt), gimple.thread_ptr)
qed

theorem tr.tp_ub: all s s2 e. s in abi.World && s in univ(1) -> s2 in univ(1) -> e in univ(1) -> !abi.thread_ok(s.vm, s.fs_base) ->
  runs(gimple.thread_ptr(), s, exc(s2, e))
proof
  fix s s2 e
  assume hws h2 he hn
  have hW hs := hws
  show by defs(simp(hs, h2, he, hn), gimple.thread_ptr)
qed

// (the coupling: a sound thread's word at fs:0 the world's to read -- off
// the stack, not the ABI's stack protector's word)
theorem tr.tp_def: all s m w ob. tr.mem(s, m, w, ob) -> w.fs_base = s.fs_base -> abi.thread_ok(w.vm, w.fs_base) -> g.mem_defined(w, w.fs_base, 0, 8, false)
proof
  fix s m w ob
  assume hmm he ht
  let FS := w.fs_base
  have {wob, cok} := hmm
  have _ sfb := cok
  have fsw: FS in bits(64) by simp(he, sfb)
  have o1 _ := apply(tr.mem_objs, hmm)
  have own: w.objs.c_bytes = abi.cbytes0(FS) by simp(o1, he)
  have rd ns _ nz := expand(ht, abi.thread_ok)
  have rd1 := expand(rd, x86_64_linux.readable)
  have k: all x0. x0 in omega -> int_lt(x0, 8) ->
      ite(x86_64_linux.mapped(w.vm, int_div(int_add(FS, x0), x86_64_linux.PAGE)) && !(snd(w.vm.pages[int_div(int_add(FS, x0), x86_64_linux.PAGE)]).kind = 2),
        ite(false, snd(w.vm.pages[int_div(int_add(FS, x0), x86_64_linux.PAGE)]).prot.w, snd(w.vm.pages[int_div(int_add(FS, x0), x86_64_linux.PAGE)]).prot.r) && int_add(FS, x0) in w.objs.c_bytes,
        int_lt(int_add(FS, x0), int_pow(2, 64)) && int_add(FS, x0) in w.objs.live) proof
    fix i
    assume i1 i2
    have r := mp(all_elim(rd1, {i}), i1, i2)
    have n := expand(mp(all_elim(ns, {i}), i1, i2), abi.stack_page)
    have no: int_add(FS, i) in abi.canary(FS) -> false proof
      assume hca
      have ci: int_le(int_add(FS, 40), int_add(FS, i))
        by taut(set_select_def[s := omega, p := x0. int_le(int_add(FS, 40), x0) && int_lt(x0, int_add(FS, 48)), z := int_add(FS, i)], expand(hca, abi.canary))
      show by arith(ci, i2)
    qed
    have io: int_add(FS, i) in omega by simp(fsw, i1)
    have nh: int_add(FS, i) in w.objs.c_bytes := rewrite(sym(own), (int_add(FS, i) in abi.cbytes0(FS) by taut(all_elim(abi.cbytes0_in, {FS}, {int_add(FS, i)}), io, no)))
    show by simp(r, n, nh)
  qed
  have us0: gimple.usable(w.vm, w.objs, FS, 8, false) by defs(k, gimple.usable)
  have e0: int_add(FS, 0) = FS by arith(fsw)
  have us := rewrite(sym(e0), us0)
  have lt: int_lt(int_add(FS, 0), pow2(64)) by simp(fsw)
  show by taut(nz, lt, us)
qed

// C1's rule: mov r64, fs:[0] -- g := the world's fs_base (the machine's,
// tr.inv), the thread sound (the spec's thread_ptr() defined): the word
// there, the world's (tr.tp_def), the thread pointer itself
theorem tr.load64_tp(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g z2 hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a ->
    runs(x86_64_linux.exec_body(len, tag(76, pair(8, pair(g, pair(x86i.fs_mem(0), pair(x86i.fs_mem(0), z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) ->
  abi.thread_ok(w.vm, w.fs_base) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs, g, pair(8, bits_of_int(64, w.fs_base))), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g z2 hs ds rs p w
  assume hat ha2 hg ht hpt
  let FS := w.fs_base
  let BF := bits_of_int(64, FS)
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(m.gpr, g, BF)), empty) proof
    fix m o
    assume hi hr hhs hrs hmm ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have mf := hi.mfs
    have ews: FS = s.fs_base := trans(sym(mf), hi.mfs0)
    have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
    have fb: m.fs_base in bits(64) by simp(expand(ipM, x86_64_linux.Machine))
    have wf: FS in bits(64) by simp(rewrite(mf, fb))
    have ea: bits_add(64, int_add(m.fs_base, 0), 0) = bits_add(64, FS, 0) by simp(mf, wf)
    have hdef := apply(tr.tp_def, hmm, ews, ht)
    have rd := apply(tr.reads, {s}, {m}, {w}, {v}, {FS}, {0}, {8}, wf, (0 in bits(32) by simp()), hdef, hmm, simp())
    have ac := rewrite(sym(ea), rd.1)
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    have e := apply(x86i.load64_fs, {m}, {o}, {g}, {0}, {z2}, {len}, ipM, ipU, gR, (0 in bits(64) by simp()), ac, hx)
    have _ _ le _ := expand(ht, abi.thread_ok)
    have e0: bits_add(64, FS, 0) = FS by simp(wf)
    have bt: BF = FS by simp(wf)
    show by simp(e, mf, rd.2, e0, le, ha2, hr, bt)
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> BF in bits(int_mul(8, 8)) && BF in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs, tr.mem))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0v[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {8}, {BF}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// its effect: none but its value (callers' tr.callee_io)
theorem tr.eff_thread_ptr: all w. tr.eff(w, o. runs(gimple.thread_ptr(), w, o))
proof
  fix w
  let C := !abi.thread_ok(w.vm, w.fs_base)
  have b := mp(all_elim(tr.eff_undef_if[c := C, k := s o. o = ok(s, s.fs_base)], {w}), (!C -> tr.eff(w, o. o = ok(w, w.fs_base)) by taut(all_elim(tr.eff_ret, {w}, {w.fs_base}))))
  show by defs(apply(tr.eff_prog, {w}, b), gimple.thread_ptr)
qed
