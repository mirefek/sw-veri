// The laws of the malloc layer for mallocng's invariant (layers/mallocng.sl),
// for any binary (`c: Cfg`).
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core \
//     build/musl_malloc.core proofs/mallocng/laws.core proofs/mallocng/claim.core

// ----------------------------------------------------------------------
//  Membership in inv and owned

theorem mallocng.inv_rep(c, s): s in mallocng.inv(c) -> ex A. A in mallocng.Abs && mallocng.rep(c, A, s)
proof
  assume h
  show ex A. A in mallocng.Abs && mallocng.rep(c, A, s) by taut(unsel(expand(h, mallocng.inv)))
qed

theorem mallocng.inv_intro(c, s, A):
  s in rec_and(abi.World, malloc.Heap.ghost) -> A in mallocng.Abs -> mallocng.rep(c, A, s) -> s in mallocng.inv(c)
proof
  assume hs ha hr
  have e: ex B. B in mallocng.Abs && mallocng.rep(c, B, s) by ex_intro({A}, taut(ha, hr))
  show s in mallocng.inv(c) by defs(sel(taut(hs, e)), mallocng.inv)
qed

theorem mallocng.owned_app(c, s): s in rec_and(abi.World, malloc.Heap.ghost) -> mallocng.owned(c)[s] = mallocng.owned_of(c, s)
proof
  assume hs
  show mallocng.owned(c)[s] = mallocng.owned_of(c, s)
    by defs(mp(app_fn_build[d := rec_and(abi.World, malloc.Heap.ghost), v := x. mallocng.owned_of(c, x), a := s], hs), mallocng.owned)
qed

theorem mallocng.owned_mem(c, s, a):
  s in rec_and(abi.World, malloc.Heap.ghost) -> a in mallocng.owned(c)[s] ->
    ex A. A in mallocng.Abs && (mallocng.rep(c, A, s) && a in mallocng.footprint(c, A, s.blocks))
proof
  assume hs ha
  have h2 := rewrite(mp(mallocng.owned_app[c := c, s := s], hs), ha)
  show ex A. A in mallocng.Abs && (mallocng.rep(c, A, s) && a in mallocng.footprint(c, A, s.blocks))
    by taut(unsel(expand(h2, mallocng.owned_of)))
qed

theorem mallocng.owned_intro(c, s, A, a):
  s in rec_and(abi.World, malloc.Heap.ghost) -> A in mallocng.Abs -> mallocng.rep(c, A, s) ->
    a in omega -> a in mallocng.footprint(c, A, s.blocks) -> a in mallocng.owned(c)[s]
proof
  assume hs ha hr ho hf
  have e: ex B. B in mallocng.Abs && (mallocng.rep(c, B, s) && a in mallocng.footprint(c, B, s.blocks))
    by ex_intro({A}, taut(ha, hr, hf))
  have m: a in mallocng.owned_of(c, s) by defs(sel(taut(ho, e)), mallocng.owned_of)
  show a in mallocng.owned(c)[s] by rewrite(sym(mp(mallocng.owned_app[c := c, s := s], hs)), m)
qed

// a byte of the footprint: in its ranges, no client's (and in no reserved
// slot)
theorem mallocng.fp_parts(c, A, b, a): a in mallocng.footprint(c, A, b) ->
  a in omega && mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) && !(a in malloc.live_of(b))
proof
  assume h
  have u1 := unsel(expand(h, mallocng.footprint))
  have i1: a in mallocng.fp_set(mallocng.fp_ranges(c, A), b) by taut(u1)
  show by taut(unsel(expand(i1, mallocng.fp_set)))
qed

theorem mallocng.fp_not_live(c, A, b, a): a in mallocng.footprint(c, A, b) -> !(a in malloc.live_of(b))
proof
  assume h
  show !(a in malloc.live_of(b)) by taut(mp(mallocng.fp_parts[c := c, A := A, b := b, a := a], h))
qed

// ----------------------------------------------------------------------
//  inv_wf

theorem mallocng.wf_pt(c, s): s in mallocng.inv(c) -> malloc.heap_wf(s)
proof
  assume h
  obtain A, hA from mp(mallocng.inv_rep[c := c, s := s], h)
  have r: mallocng.rep(c, A, s) by taut(hA)
  have h0 _ _ _ _ _ hl := expand(r, mallocng.rep)
  have {hb = wf} := expand(h0, mallocng.holds)
  show malloc.heap_wf(s) by defs(taut(hb, hl), malloc.heap_wf)
qed

theorem mallocng.law_inv_wf(c): malloc.inv_wf(mallocng.inv(c))
proof
  fix s
  assume hs: s in rec_and(abi.World, malloc.Heap.ghost)
  assume hi: s in mallocng.inv(c)
  have g := gen(discharge(discharge(mp(mallocng.wf_pt[c := c, s := s], hi), hi), hs), s)
  show malloc.inv_wf(mallocng.inv(c)) by defs(g, malloc.inv_wf)
qed

// ----------------------------------------------------------------------
//  owned_private

theorem mallocng.private_pt(c, s, a):
  s in rec_and(abi.World, malloc.Heap.ghost) -> a in mallocng.owned(c)[s] -> !(a in malloc.live(s))
proof
  assume hs ha
  obtain A, hA from mp(mp(mallocng.owned_mem[c := c, s := s, a := a], hs), ha)
  have f: a in mallocng.footprint(c, A, s.blocks) by taut(hA)
  show !(a in malloc.live(s)) by defs(mp(mallocng.fp_not_live[c := c, A := A, b := s.blocks, a := a], f), malloc.live)
qed

theorem mallocng.law_owned_private(c): malloc.owned_private(mallocng.inv(c), mallocng.owned(c))
proof
  fix s
  assume hs hi
  fix a
  assume ho
  show by taut(mp(mallocng.private_pt[c := c, s := s, a := a], hs))
qed

// ----------------------------------------------------------------------
//  owned_mapped

theorem mallocng.mapped_pt(c, s, a):
  s in rec_and(abi.World, malloc.Heap.ghost) -> a in omega -> a in mallocng.owned(c)[s] ->
    x86_64_linux.mapped(s.vm, int_div(a, x86_64_linux.PAGE))
proof
  assume hs ho ha
  obtain A, hA from mp(mp(mallocng.owned_mem[c := c, s := s, a := a], hs), ha)
  have r: mallocng.rep(c, A, s) by taut(hA)
  have f: a in mallocng.footprint(c, A, s.blocks) by taut(hA)
  // a is in one of the ranges, and not live
  have u := mp(mallocng.fp_parts[c := c, A := A, b := s.blocks, a := a], f)
  have ir: mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) by taut(u)
  have nl: !(a in malloc.live_of(s.blocks)) by taut(u)
  obtain k, hk from expand(ir, mallocng.in_ranges)
  have kin: k in omega by taut(hk)
  have klt: int_lt(k, seq_len(mallocng.fp_ranges(c, A))) by taut(hk)
  have kr: mallocng.in_range(a, mallocng.fp_ranges(c, A)[k]) by taut(hk)
  have fm: mallocng.fp_mapped(mallocng.fp_ranges(c, A), s.blocks, s.vm) by taut(expand(r, mallocng.rep))
  have inst := all_elim(all_elim(expand(fm, mallocng.fp_mapped), {k}), {a})
  show x86_64_linux.mapped(s.vm, int_div(a, x86_64_linux.PAGE)) by taut(inst, kin, ho, klt, expand(kr, mallocng.in_range), nl)
qed

theorem mallocng.law_owned_mapped(c): malloc.owned_mapped(mallocng.inv(c), mallocng.owned(c))
proof
  fix s
  assume hs: s in rec_and(abi.World, malloc.Heap.ghost)
  assume hi: s in mallocng.inv(c)
  fix a
  assume ho: a in omega
  assume ha: a in mallocng.owned(c)[s]
  have m := mp(mp(mp(mallocng.mapped_pt[c := c, s := s, a := a], hs), ho), ha)
  have g := gen(discharge(discharge(gen(discharge(discharge(m, ha), ho), a), hi), hs), s)
  show malloc.owned_mapped(mallocng.inv(c), mallocng.owned(c)) by defs(g, malloc.owned_mapped)
qed

// ----------------------------------------------------------------------
//  frame

// The abstract state is determined by the memory. To prove: the ctx fields
// are read from ctx; the lists (areas, free metas, active lists) by
// following their links from ctx; the metas, slots and blocks from the
// meta areas and groups those lists reach (see layers/mallocng.sl).
lemma mallocng.abs_unique(c, s, A, B):
  s in rec_and(abi.World, malloc.Heap.ghost) -> A in mallocng.Abs -> B in mallocng.Abs ->
    mallocng.rep(c, A, s) -> mallocng.rep(c, B, s) -> A = B

// memory that agrees on the owned bytes (the frame law's hypothesis)
def mallocng.agree(c, s, t) :=
  all x. x in omega -> x in mallocng.owned(c)[s] ->
    t.vm.bytes[bits_of_int(64, x)] = s.vm.bytes[bits_of_int(64, x)] &&
    t.vm.pages[int_div(x, x86_64_linux.PAGE)] = s.vm.pages[int_div(x, x86_64_linux.PAGE)]

// agreement on the footprint of a representing state
theorem mallocng.agree_fp(c, s, t, A, x):
  s in rec_and(abi.World, malloc.Heap.ghost) -> A in mallocng.Abs -> mallocng.rep(c, A, s) -> mallocng.agree(c, s, t) ->
    x in omega -> x in mallocng.footprint(c, A, s.blocks) ->
      t.vm.bytes[bits_of_int(64, x)] = s.vm.bytes[bits_of_int(64, x)] &&
      t.vm.pages[int_div(x, x86_64_linux.PAGE)] = s.vm.pages[int_div(x, x86_64_linux.PAGE)]
proof
  assume hs ha hr hg ho hx
  have own := mp(mp(mp(mp(mp(mallocng.owned_intro[c := c, s := s, A := A, a := x], hs), ha), hr), ho), hx)
  show mp(mp(all_elim(expand(hg, mallocng.agree), {x}), ho), own)
qed

// the view of bytes of the footprint (the invariant's, `held`; the
// footprint's) is the same
theorem mallocng.view_eq(c, s, t, A, S):
  s in rec_and(abi.World, malloc.Heap.ghost) -> A in mallocng.Abs -> mallocng.rep(c, A, s) -> mallocng.agree(c, s, t) ->
    (all x. x in omega -> x in S -> x in mallocng.footprint(c, A, s.blocks)) ->
    mallocng.mview(t.vm, S) = mallocng.mview(s.vm, S)
proof
  assume hs ha hr hg hS
  fix x
  assume ho: x in omega
  assume hx: x in S
  have hxf := mp(mp(all_elim(hS, {x}), ho), hx)
  have eqs := mp(mp(mp(mp(mp(mp(mallocng.agree_fp[c := c, s := s, t := t, A := A, x := x], hs), ha), hr), hg), ho), hxf)
  have eb: t.vm.bytes[bits_of_int(64, x)] = s.vm.bytes[bits_of_int(64, x)] by taut(eqs)
  have ep: t.vm.pages[int_div(x, x86_64_linux.PAGE)] = s.vm.pages[int_div(x, x86_64_linux.PAGE)] by taut(eqs)
  have q0 := refl({some(pair(t.vm.bytes[bits_of_int(64, x)], t.vm.pages[int_div(x, x86_64_linux.PAGE)]))})
  have q1 := subst({z. some(pair(t.vm.bytes[bits_of_int(64, x)], t.vm.pages[int_div(x, x86_64_linux.PAGE)])) =
                       some(pair(z, t.vm.pages[int_div(x, x86_64_linux.PAGE)]))}, eb, q0)
  have q2 := subst({z. some(pair(t.vm.bytes[bits_of_int(64, x)], t.vm.pages[int_div(x, x86_64_linux.PAGE)])) =
                       some(pair(s.vm.bytes[bits_of_int(64, x)], z))}, ep, q1)
  have ic := mp(ite_cong[c := x in S,
                         a := some(pair(t.vm.bytes[bits_of_int(64, x)], t.vm.pages[int_div(x, x86_64_linux.PAGE)])),
                         b := some(pair(s.vm.bytes[bits_of_int(64, x)], s.vm.pages[int_div(x, x86_64_linux.PAGE)])),
                         e := none], discharge(q2, hx))
  have pw := gen(discharge(ic, ho), x)
  have ext := mp(fn_build_ext[d := omega,
     f := y. ite(y in S, some(pair(t.vm.bytes[bits_of_int(64, y)], t.vm.pages[int_div(y, x86_64_linux.PAGE)])), none),
     g := y. ite(y in S, some(pair(s.vm.bytes[bits_of_int(64, y)], s.vm.pages[int_div(y, x86_64_linux.PAGE)])), none)], pw)
  show mallocng.mview(t.vm, S) = mallocng.mview(s.vm, S) by defs(ext, mallocng.mview)
qed

// the representation carries over to a state that agrees on the footprint
theorem mallocng.rep_frame(c, A, s, t):
  s in rec_and(abi.World, malloc.Heap.ghost) -> A in mallocng.Abs -> mallocng.rep(c, A, s) ->
    t.blocks = s.blocks -> t.vm.brk = s.vm.brk ->
    mallocng.agree(c, s, t) -> (all x. x in omega -> x in malloc.live(s) ->
      t.vm.pages[int_div(x, x86_64_linux.PAGE)] = s.vm.pages[int_div(x, x86_64_linux.PAGE)]) -> mallocng.rep(c, A, t)
proof
  assume hs ha hr hb hk hg hl
  have rs := expand(hr, mallocng.rep)
  let HS := mallocng.held(c, A, s.blocks)
  let FS := mallocng.footprint(c, A, s.blocks)
  have sh: all x. x in omega -> x in HS -> x in FS proof
    fix x
    assume ho hx
    show by taut(set_select_def[s := omega, p := y. y in FS && !mallocng.ctx_free(c, y), z := x], expand(hx, mallocng.held))
  qed
  have sf: all x. x in omega -> x in FS -> x in FS proof
    fix x
    assume ho hx
    show := hx
  qed
  have ve := mp(mp(mp(mp(mp(mallocng.view_eq[c := c, s := s, t := t, A := A, S := HS], hs), ha), hr), hg), sh)
  have vf := mp(mp(mp(mp(mp(mallocng.view_eq[c := c, s := s, t := t, A := A, S := FS], hs), ha), hr), hg), sf)
  have FR: mallocng.free_rw(c, mallocng.mview(s.vm, FS)) by taut(rs)
  have FR3 := rewrite(sym(hb), rewrite(sym(vf), FR))
  have H: mallocng.holds(c, A, mallocng.mview(s.vm, mallocng.held(c, A, s.blocks)), s.blocks, s.vm.brk)
    by taut(rs)
  have H3 := rewrite(sym(hk), rewrite(sym(hb), rewrite(sym(ve), H)))
  // the footprint stays mapped: its pages are unchanged
  have FM: mallocng.fp_mapped(mallocng.fp_ranges(c, A), s.blocks, s.vm) by taut(rs)
  fix k x
  assume hko: k in omega && x in omega
  assume hp: ((int_lt(k, seq_len(mallocng.fp_ranges(c, A))) && int_le(fst(mallocng.fp_ranges(c, A)[k]), x)) &&
      int_lt(x, int_add(fst(mallocng.fp_ranges(c, A)[k]), snd(mallocng.fp_ranges(c, A)[k])))) && !(x in malloc.live_of(t.blocks))
  have hp2 := rewrite(hb, hp)
  have ms := mp(mp(all_elim(all_elim(expand(FM, mallocng.fp_mapped), {k}), {x}), hko), hp2)
  have kin: k in omega by taut(hko)
  have ho: x in omega by taut(hko)
  have klt: int_lt(k, seq_len(mallocng.fp_ranges(c, A))) by taut(hp)
  have irk: mallocng.in_range(x, mallocng.fp_ranges(c, A)[k]) by defs(taut(hp), mallocng.in_range)
  have ir: mallocng.in_ranges(x, mallocng.fp_ranges(c, A)) by defs(ex_intro({k}, taut(kin, klt, irk)), mallocng.in_ranges)
  have nl: !(x in malloc.live_of(s.blocks)) by taut(hp2)
  // (no slot reserved between the allocator's calls: x in none)
  have NR0: mallocng.no_reserved(A) by taut(rs)
  have nrx: mallocng.in_reserved(A, x) -> false proof
    assume h
    obtain g i, hg hi _ hil hrs _ from expand(h, mallocng.in_reserved)
    have ne := mp(all_elim(expand(NR0, mallocng.no_reserved), {g}, {i}), conj(hg, hi), hil)
    show by taut(ne, hrs)
  qed
  // (no meta taken between the allocator's calls)
  have TK0: seq_len(A.taken) = 0 by taut(rs)
  have ntx: mallocng.in_taken(A, x) -> false proof
    assume h
    obtain j, hj hjl _ _ from expand(h, mallocng.in_taken)
    show by arith(hj, hjl, TK0)
  qed
  have hfs: x in mallocng.fp_set(mallocng.fp_ranges(c, A), s.blocks) by defs(sel(taut(ho, ir, nl)), mallocng.fp_set)
  have hx: x in mallocng.footprint(c, A, s.blocks) by defs(sel(taut(ho, hfs, nrx, ntx)), mallocng.footprint)
  have eqs := mp(mp(mp(mp(mp(mp(mallocng.agree_fp[c := c, s := s, t := t, A := A, x := x], hs), ha), hr), hg), ho), hx)
  have ep: t.vm.pages[int_div(x, x86_64_linux.PAGE)] = s.vm.pages[int_div(x, x86_64_linux.PAGE)] by taut(eqs)
  have mt: x86_64_linux.mapped(t.vm, int_div(x, x86_64_linux.PAGE))
    by defs(rewrite(sym(ep), expand(ms, x86_64_linux.mapped)), x86_64_linux.mapped)
  have MT: mallocng.fp_mapped(mallocng.fp_ranges(c, A), t.blocks, t.vm)
    by defs(gen(gen(discharge(discharge(mt, hp), hko), x), k), mallocng.fp_mapped)
  // live blocks stay read-write: their pages are unchanged
  have LS: malloc.live_rw(s) by taut(rs)
  fix p
  assume hp8: p in bits(64)
  assume hn: !(t.blocks[p] = none)
  fix y
  assume hy: y in omega
  assume hr2: int_le(p, y) && int_lt(y, int_add(p, snd(t.blocks[p])))
  have hn2 := rewrite(hb, hn)
  have hr3 := rewrite(hb, hr2)
  have rs_y := mp(mp(all_elim(mp(mp(all_elim(expand(LS, malloc.live_rw), {p}), hp8), hn2), {y}), hy), hr3)
  have yr: y in malloc.range(p, snd(s.blocks[p])) by defs(sel(taut(hy, hr3)), malloc.range)
  have ey: ex q. q in bits(64) && (!(s.blocks[q] = none) && y in malloc.range(q, snd(s.blocks[q])))
    by ex_intro({p}, taut(hp8, hn2, yr))
  have yl: y in malloc.live(s) by defs(sel(taut(hy, ey)), malloc.live, malloc.live_of)
  have pe := mp(mp(all_elim(hl, {y}), hy), yl)
  have rt_y: malloc.rw_mapped(t.vm, y)
    by defs(rewrite(sym(pe), expand(rs_y, malloc.rw_mapped, x86_64_linux.mapped)), malloc.rw_mapped, x86_64_linux.mapped)
  have LT: malloc.live_rw(t)
    by defs(gen(discharge(discharge(gen(discharge(discharge(rt_y, hr2), hy), y), hn), hp8), p), malloc.live_rw)
  have NR: mallocng.no_reserved(A) by taut(rs)
  // the groups' bytes stay accessible: the allocator's and the live
  // blocks' pages unchanged (no slot reserved)
  have GR: mallocng.grp_rw(c, A, s.vm, s.blocks) by taut(rs)
  have g0 := expand(GR, mallocng.grp_rw)
  have GW: all x0. all x1. x0 in omega && x1 in omega -> (mallocng.is_used(A, x0) && mallocng.in_range(x1, mallocng.group_range(A.metas[x0]))) &&
      (x1 in mallocng.footprint(c, A, t.blocks) || x1 in malloc.live_of(t.blocks) || mallocng.in_reserved(A, x1)) ->
      mallocng.m_rw(mallocng.mview(t.vm, mallocng.all_bytes), x1) && !(snd(mallocng.pg(mallocng.mview(t.vm, mallocng.all_bytes), x1)).kind = 2) proof
    fix g z
    assume hgz hq
    have hzo: z in omega by taut(hgz)
    have hq2 := rewrite(hb, hq)
    have kz := mp(all_elim(g0, {g}, {z}), hgz, hq2)
    have c1: z in mallocng.footprint(c, A, s.blocks) -> t.vm.pages[int_div(z, x86_64_linux.PAGE)] = s.vm.pages[int_div(z, x86_64_linux.PAGE)] proof
      assume hf
      have eqz := mp(mp(mp(mp(mp(mp(mallocng.agree_fp[c := c, s := s, t := t, A := A, x := z], hs), ha), hr), hg), hzo), hf)
      show by taut(eqz)
    qed
    have c2: z in malloc.live_of(s.blocks) -> t.vm.pages[int_div(z, x86_64_linux.PAGE)] = s.vm.pages[int_div(z, x86_64_linux.PAGE)] proof
      assume hlz
      show := mp(mp(all_elim(hl, {z}), hzo), (z in malloc.live(s) by defs(hlz, malloc.live)))
    qed
    have c3: mallocng.in_reserved(A, z) -> t.vm.pages[int_div(z, x86_64_linux.PAGE)] = s.vm.pages[int_div(z, x86_64_linux.PAGE)] proof
      assume h
      obtain g2 i2, hg2 hi2 _ hil2 hrs2 _ from expand(h, mallocng.in_reserved)
      have ne2 := mp(all_elim(expand(NR0, mallocng.no_reserved), {g2}, {i2}), conj(hg2, hi2), hil2)
      have f: false by taut(ne2, hrs2)
      show by taut(f)
    qed
    have ez: t.vm.pages[int_div(z, x86_64_linux.PAGE)] = s.vm.pages[int_div(z, x86_64_linux.PAGE)] by taut(hq2, c1, c2, c3)
    have pz: mallocng.pg(mallocng.mview(t.vm, mallocng.all_bytes), z) = mallocng.pg(mallocng.mview(s.vm, mallocng.all_bytes), z)
      by defs(simp(ez, hzo), mallocng.pg, mallocng.mview, mallocng.all_bytes)
    show by defs(rewrite(sym(pz), expand(kz, mallocng.m_rw, mallocng.m_mapped)), mallocng.m_rw, mallocng.m_mapped)
  qed
  have GR3: mallocng.grp_rw(c, A, t.vm, t.blocks) by defs(GW, mallocng.grp_rw)
  show mallocng.rep(c, A, t) by defs(taut(H3, NR, TK0, MT, FR3, GR3, LT), mallocng.rep)
qed

// with a unique representation, what t owns s owned
theorem mallocng.owned_sub(c, s, t, A, a):
  s in rec_and(abi.World, malloc.Heap.ghost) -> t in rec_and(abi.World, malloc.Heap.ghost) -> A in mallocng.Abs ->
    mallocng.rep(c, A, s) -> mallocng.rep(c, A, t) -> t.blocks = s.blocks ->
    a in mallocng.owned_of(c, t) -> a in mallocng.owned_of(c, s)
proof
  assume hs ht ha hrs hrt hb ho
  have u := unsel(expand(ho, mallocng.owned_of))
  have ao: a in omega by taut(u)
  have e: ex B. B in mallocng.Abs && (mallocng.rep(c, B, t) && a in mallocng.footprint(c, B, t.blocks)) by taut(u)
  obtain B, hB from e
  have hBa: B in mallocng.Abs by taut(hB)
  have hBr: mallocng.rep(c, B, t) by taut(hB)
  have hBf: a in mallocng.footprint(c, B, t.blocks) by taut(hB)
  have eq := mp(mp(mp(mp(mp(mallocng.abs_unique[c := c, s := t, A := B, B := A], ht), hBa), ha), hBr), hrt)
  have f2 := rewrite(hb, rewrite(eq, hBf))
  have e2: ex B. B in mallocng.Abs && (mallocng.rep(c, B, s) && a in mallocng.footprint(c, B, s.blocks))
    by ex_intro({A}, taut(ha, hrs, f2))
  show a in mallocng.owned_of(c, s) by defs(sel(taut(ao, e2)), mallocng.owned_of)
qed

theorem mallocng.frame_pt(c, s, t):
  s in rec_and(abi.World, malloc.Heap.ghost) -> t in rec_and(abi.World, malloc.Heap.ghost) -> s in mallocng.inv(c) ->
    t.blocks = s.blocks -> t.vm.brk = s.vm.brk ->
    mallocng.agree(c, s, t) -> (all x. x in omega -> x in malloc.live(s) ->
      t.vm.pages[int_div(x, x86_64_linux.PAGE)] = s.vm.pages[int_div(x, x86_64_linux.PAGE)]) ->
    t in mallocng.inv(c) && mallocng.owned(c)[t] = mallocng.owned(c)[s]
proof
  assume hs ht hi hb hk hg hl
  obtain A, hA from mp(mallocng.inv_rep[c := c, s := s], hi)
  have ha: A in mallocng.Abs by taut(hA)
  have hr: mallocng.rep(c, A, s) by taut(hA)
  have rt := mp(mp(mp(mp(mp(mp(mp(mallocng.rep_frame[c := c, A := A, s := s, t := t], hs), ha), hr), hb), hk), hg), hl)
  have ti := mp(mp(mp(mallocng.inv_intro[c := c, s := t, A := A], ht), ha), rt)
  fix a
  have d1 := mp(mp(mp(mp(mp(mp(mallocng.owned_sub[c := c, s := s, t := t, A := A, a := a], hs), ht), ha), hr), rt), hb)
  have d2 := mp(mp(mp(mp(mp(mp(mallocng.owned_sub[c := c, s := t, t := s, A := A, a := a], ht), hs), ha), rt), hr), sym(hb))
  have ie: a in mallocng.owned_of(c, t) <-> a in mallocng.owned_of(c, s) by taut(d1, d2)
  have oe := mp(set_ext[a := mallocng.owned_of(c, t), b := mallocng.owned_of(c, s)], gen(ie, a))
  have oe2 := trans(trans(mp(mallocng.owned_app[c := c, s := t], ht), oe), sym(mp(mallocng.owned_app[c := c, s := s], hs)))
  show t in mallocng.inv(c) && mallocng.owned(c)[t] = mallocng.owned(c)[s] by taut(ti, oe2)
qed

theorem mallocng.law_frame(c): malloc.frame(mallocng.inv(c), mallocng.owned(c))
proof
  fix s t
  assume h1: s in rec_and(abi.World, malloc.Heap.ghost) && t in rec_and(abi.World, malloc.Heap.ghost)
  assume h2: (((s in mallocng.inv(c) && t.blocks = s.blocks) && t.vm.brk = s.vm.brk) &&
    (all x. x in omega -> x in mallocng.owned(c)[s] ->
       t.vm.bytes[bits_of_int(64, x)] = s.vm.bytes[bits_of_int(64, x)] &&
       t.vm.pages[int_div(x, x86_64_linux.PAGE)] = s.vm.pages[int_div(x, x86_64_linux.PAGE)])) &&
    (all x. x in omega -> x in malloc.live(s) ->
      t.vm.pages[int_div(x, x86_64_linux.PAGE)] = s.vm.pages[int_div(x, x86_64_linux.PAGE)])
  have hs: s in rec_and(abi.World, malloc.Heap.ghost) by taut(h1)
  have ht: t in rec_and(abi.World, malloc.Heap.ghost) by taut(h1)
  have hi: s in mallocng.inv(c) by taut(h2)
  have hb: t.blocks = s.blocks by taut(h2)
  have hk: t.vm.brk = s.vm.brk by taut(h2)
  have hg: mallocng.agree(c, s, t) by defs(taut(h2), mallocng.agree)
  have hl: all x. x in omega -> x in malloc.live(s) ->
      t.vm.pages[int_div(x, x86_64_linux.PAGE)] = s.vm.pages[int_div(x, x86_64_linux.PAGE)] by taut(h2)
  have r := mp(mp(mp(mp(mp(mp(mp(mallocng.frame_pt[c := c, s := s, t := t], hs), ht), hi), hb), hk), hg), hl)
  have g := gen(gen(discharge(discharge(r, h2), h1), t), s)
  show malloc.frame(mallocng.inv(c), mallocng.owned(c)) by defs(g, malloc.frame)
qed
