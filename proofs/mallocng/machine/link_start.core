  fix statics
  show := mp(all_elim(c1il.impl_m, {statics}, {sitl.F}, {sspl.F}, {c_src_env___libc_start_main_cfg.__syscall3_fun()}, {mallocng_specs.a_crash_spec_fun()},
      {c_src_env___libc_start_main_cfg.__syscall2_fun()}),
    all_elim(sitl.linked, {statics}), sitl.typed, sitl.io, all_elim(sspl.linked, {statics}), sspl.typed, sspl.io, all_elim(c1l3.impl_m, {statics}), c1l3.typed, c1l3.io,
    all_elim(acr.impl_m, {false}, {false}, {4199585}, {4199109}, {false}, {statics}), acr.typed, acr.io, all_elim(c1l2.impl_m, {statics}), c1l2.typed, c1l2.io)
