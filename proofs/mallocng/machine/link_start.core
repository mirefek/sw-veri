// ----------------------------------------------------------------------
//  __libc_start_main with __init_libc (linked) and stage2's map (stage2
//  at its address, linked)

abbrev lsml.FP := lnk.FP1(4199109, 4200634, s2l.F)
abbrev lsml.F := c_src_env___libc_start_main_cfg.__libc_start_main_fun(ilcl.F, lsml.FP)

theorem lsml.linked: all statics. tr.impl_m(false, false, 4200493, lsml.F, 4199109, true, 4198400, text.code, statics)
proof
  fix statics
  have ccs: tr.ccs_m(false, 72, 4200634, s2l.F, 4199109, true, 4198400, text.code, statics)
    by defs(taut(all_elim(s2l.linked, {statics}), (int_mod(72, 16) = 8 by simp())), tr.ccs_m)
  have co := mp(all_elim(lnk.code_ok1, {4199109}, {4200634}, {s2l.F}, {3}, {72}, {statics}), (!(4200634 = 4199109) by simp()), ccs, s2l.io)
  have ft := mp(all_elim(lnk.fp1_typed, {4199109}, {4200634}, {s2l.F}), s2l.typed)
  show := mp(all_elim(c1lsm.impl_m, {statics}, {ilcl.F}, {lsml.FP}), apply(tr.impl_m_k, all_elim(ilcl.linked, {statics})), ilcl.typed, ilcl.io, co, ft)
qed

theorem lsml.io: tr.callee_io(lsml.F, 6)
proof
  show := mp(all_elim(c1lsm.io, {ilcl.F}, {lsml.FP}), ilcl.io, mp(all_elim(lnk.fp1_io, {4199109}, {4200634}, {s2l.F}, {3}), s2l.io),
    ilcl.typed, mp(all_elim(lnk.fp1_typed, {4199109}, {4200634}, {s2l.F}), s2l.typed))
qed

theorem lsml.typed: lsml.F in fn_space(abi.ARGS, powerset(univ(1)))
proof
  show := all_elim(c1lsm.typed, {ilcl.F}, {lsml.FP})
qed

// ----------------------------------------------------------------------
//  _start_c with __libc_start_main (linked): the startup path from
//  _start_c's entry, its machine code against its GIMPLE linked

abbrev stl.F := c_crt_crt1_cfg._start_c_fun(lsml.F)

theorem stl.linked: all statics. tr.impl_m(false, false, 4198565, stl.F, 4199109, true, 4198400, text.code, statics)
proof
  fix statics
  show := mp(all_elim(c1st.impl_m, {statics}, {lsml.F}), all_elim(lsml.linked, {statics}), lsml.typed, lsml.io)
qed
