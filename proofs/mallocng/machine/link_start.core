    all_elim(lsil.linked, {statics}), lsil.typed, lsil.io, all_elim(lnk.code_ok0, {4199109}, {3}, {56}, {statics}), all_elim(lnk.fp0_typed, {4199109}),
    all_elim(acr.impl_m, {false}, {false}, {4198416}, {4199109}, {true}, {statics}), acr.typed, mp.undef_io[n := 1])
qed

