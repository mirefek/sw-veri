      {c_src_env___init_tls_cfg.__init_tp_fun(musl_asm_cfg.__set_thread_area_fun(), c_src_env___init_tls_cfg.__syscall1_fun())}, {mallocng_specs.a_crash_spec_fun()}),
    all_elim(c1t6.impl_m_s, {statics}), c1t6.typed, c1t6.io, all_elim(ctll.linked, {statics}), ctll.typed, ctll.io, all_elim(itpl.linked, {statics}), itpl.typed, itpl.io,
    all_elim(acr.impl_m, {false}, {false}, {4215302}, {4199109}, {false}, {statics}), acr.typed, acr.io)
