// The startup path's machine contracts linked: each caller's C1 contract
// (its callees' contracts, types and effects premises) with its callees'
// own, bottom up, as proofs/mallocng/machine/cfg.core does for malloc's
// -- every function of the path in the startup mode (tr.impl_m(false, ..)).

// ----------------------------------------------------------------------
//  __init_tls.c

// __init_tp with __set_thread_area and the unit's __syscall1
theorem itpl.linked: all statics. tr.impl_m(false, false, 4215305,
  c_src_env___init_tls_cfg.__init_tp_fun(musl_asm_cfg.__set_thread_area_fun(), c_src_env___init_tls_cfg.__syscall1_fun()), 4199109, false, 4198400, text.code, statics)
proof
  fix statics
  show := mp(all_elim(c1itp.impl_m, {statics}, {musl_asm_cfg.__set_thread_area_fun()}, {c_src_env___init_tls_cfg.__syscall1_fun()}),
    all_elim(sta.impl_m, {statics}), sta.typed, sta.io, all_elim(c1t1.impl_m, {statics}), c1t1.typed, c1t1.io)
qed

theorem itpl.io: tr.callee_io(c_src_env___init_tls_cfg.__init_tp_fun(musl_asm_cfg.__set_thread_area_fun(), c_src_env___init_tls_cfg.__syscall1_fun()), 1)
proof
  show := mp(all_elim(c1itp.io, {musl_asm_cfg.__set_thread_area_fun()}, {c_src_env___init_tls_cfg.__syscall1_fun()}), sta.io, c1t1.io)
qed

theorem itpl.typed: c_src_env___init_tls_cfg.__init_tp_fun(musl_asm_cfg.__set_thread_area_fun(), c_src_env___init_tls_cfg.__syscall1_fun()) in fn_space(abi.ARGS, powerset(univ(1)))
proof
  show := all_elim(c1itp.typed, {musl_asm_cfg.__set_thread_area_fun()}, {c_src_env___init_tls_cfg.__syscall1_fun()})
qed

