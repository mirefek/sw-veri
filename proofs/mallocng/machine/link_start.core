// ----------------------------------------------------------------------
//  main, at t: a spec raising at main and nothing else (the stop's: what
//  runs to main sees of it) -- the code maps' entry at main

def lnk.main() := fn_build(abi.ARGS, x0. mkprog(x1 x2. x2 = exc(x1, exc_val("at_main", empty))))

theorem lnk.main_typed: lnk.main() in fn_space(abi.ARGS, powerset(univ(1)))
proof
  show by defs(tr.fun_typed, lnk.main)
qed

theorem lnk.main_raises: tr.raises_main(lnk.main())
proof
  have g: all args w. args in set_select(list_type(bits(64)), x. ord_le(seq_len(x), 6)) -> w in abi.World -> w in univ(1) ->
      runs(lnk.main()[args], w, exc(w, exc_val("at_main", empty))) || tr.may_raise(lnk.main(), args, w) proof
    fix args w
    assume ha _ hu
    have au: exc_val("at_main", empty) in univ(1) by defs(simp(), exc_val)
    have pu: pair(w, exc(w, exc_val("at_main", empty))) in univ(1) by simp(hu, au)
    have r: runs(lnk.main()[args], w, exc(w, exc_val("at_main", empty))) by defs(simp(ha, pu), lnk.main)
    show by taut(r)
  qed
  show by defs(g, tr.raises_main)
qed

theorem lnk.main_io(n): tr.callee_io(lnk.main(), n)
proof
  have g: all args w w2 r. ord_le(n, seq_len(args)) -> runs(lnk.main()[args], w, ok(w2, r)) -> tr.returns_valid(w, w2) || tr.may_raise(lnk.main(), args, w) proof
    fix args w w2 r
    assume _ h
    have ha hp := apply(runs_fn_build, expand(h, lnk.main))
    have f: false by simp(expand(hp, runs, mkprog))
    show by taut(f)
  qed
  show by defs(g, tr.callee_io)
qed

// ----------------------------------------------------------------------
//  The code maps of the calls through pointers (GIMPLE's fptr): main at
//  t, one callee G at a, a_crash's contract (undefined) everywhere else

abbrev lnk.A := mallocng_specs.a_crash_spec_fun()
abbrev lnk.FP1(t, a, G) := fn_build(bits(64), T. ite(T = t, lnk.main(), ite(T = a, G, lnk.A)))
abbrev lnk.FP0(t) := fn_build(bits(64), T. ite(T = t, lnk.main(), lnk.A))

theorem lnk.code_ok1: all t a G n fr statics. !(a = t) -> tr.ccs_m(false, fr, a, G, t, true, 4198400, text.code, statics) -> tr.callee_io(G, n) ->
  tr.code_okm(false, lnk.FP1(t, a, G), n, fr, t, 4198400, text.code, statics)
proof
  fix t a G n fr statics
  assume hat hc hio
  have g: all T. T in bits(64) -> (T = t && tr.raises_main(lnk.FP1(t, a, G)[T])) ||
      (!(T = t) && tr.ccs_m(false, fr, T, lnk.FP1(t, a, G)[T], t, true, 4198400, text.code, statics) && tr.callee_io(lnk.FP1(t, a, G)[T], n)) proof
    fix T
    assume hT
    have e := mp(app_fn_build[d := bits(64), v := x. ite(x = t, lnk.main(), ite(x = a, G, lnk.A)), a := T], hT)
    have k1: T = t -> tr.raises_main(lnk.FP1(t, a, G)[T]) proof
      assume et
      have m: lnk.FP1(t, a, G)[T] = lnk.main() by simp(e, et)
      show := rewrite(sym(m), lnk.main_raises)
    qed
    have k2: !(T = t) -> T = a -> tr.ccs_m(false, fr, T, lnk.FP1(t, a, G)[T], t, true, 4198400, text.code, statics) && tr.callee_io(lnk.FP1(t, a, G)[T], n) proof
      assume n1 ea
      have i1: ite(T = t, lnk.main(), ite(T = a, G, lnk.A)) = G by simp(n1, ea)
      have m := trans(e, i1)
      have c := rewrite(sym(m), rewrite(sym(ea), hc))
      have i := rewrite(sym(m), hio)
      show by taut(c, i)
    qed
    have k3: !(T = t) -> !(T = a) -> tr.ccs_m(false, fr, T, lnk.FP1(t, a, G)[T], t, true, 4198400, text.code, statics) && tr.callee_io(lnk.FP1(t, a, G)[T], n) proof
      assume n1 n2
      have m: lnk.FP1(t, a, G)[T] = lnk.A by simp(e, n1, n2)
      have i0 := all_elim(acr.impl_m, {false}, {true}, {T}, {t}, {true}, {statics})
      have c0: tr.ccs_m(false, fr, T, lnk.A, t, true, 4198400, text.code, statics) by defs(taut(i0), tr.ccs_m)
      have c := rewrite(sym(m), c0)
      have i := rewrite(sym(m), mp.undef_io[n := n])
      show by taut(c, i)
    qed
    show by taut(k1, k2, k3)
  qed
  show by defs(g, tr.code_okm)
qed

theorem lnk.code_ok0: all t n fr statics. tr.code_okm(false, lnk.FP0(t), n, fr, t, 4198400, text.code, statics)
proof
  fix t n fr statics
  have g: all T. T in bits(64) -> (T = t && tr.raises_main(lnk.FP0(t)[T])) ||
      (!(T = t) && tr.ccs_m(false, fr, T, lnk.FP0(t)[T], t, true, 4198400, text.code, statics) && tr.callee_io(lnk.FP0(t)[T], n)) proof
    fix T
    assume hT
    have e := mp(app_fn_build[d := bits(64), v := x. ite(x = t, lnk.main(), lnk.A), a := T], hT)
    have k1: T = t -> tr.raises_main(lnk.FP0(t)[T]) proof
      assume et
      have m: lnk.FP0(t)[T] = lnk.main() by simp(e, et)
      show := rewrite(sym(m), lnk.main_raises)
    qed
    have k3: !(T = t) -> tr.ccs_m(false, fr, T, lnk.FP0(t)[T], t, true, 4198400, text.code, statics) && tr.callee_io(lnk.FP0(t)[T], n) proof
      assume n1
      have m: lnk.FP0(t)[T] = lnk.A by simp(e, n1)
      have i0 := all_elim(acr.impl_m, {false}, {true}, {T}, {t}, {true}, {statics})
      have c0: tr.ccs_m(false, fr, T, lnk.A, t, true, 4198400, text.code, statics) by defs(taut(i0), tr.ccs_m)
      have c := rewrite(sym(m), c0)
      have i := rewrite(sym(m), mp.undef_io[n := n])
      show by taut(c, i)
    qed
    show by taut(k1, k3)
  qed
  show by defs(g, tr.code_okm)
qed

// (their entries typed; each entry's effects)
theorem lnk.fp1_typed: all t a G. G in fn_space(abi.ARGS, powerset(univ(1))) -> lnk.FP1(t, a, G) in fn_space(bits(64), fn_space(abi.ARGS, powerset(univ(1))))
proof
  fix t a G
  assume hg
  have v: all x. x in bits(64) -> ite(x = t, lnk.main(), ite(x = a, G, lnk.A)) in fn_space(abi.ARGS, powerset(univ(1))) proof
    fix x
    assume _
    show by simp(lnk.main_typed, hg, acr.typed)
  qed
  show := mp(fn_build_space[d := bits(64), v := x. ite(x = t, lnk.main(), ite(x = a, G, lnk.A)), b := fn_space(abi.ARGS, powerset(univ(1)))], v)
qed

theorem lnk.fp0_typed: all t. lnk.FP0(t) in fn_space(bits(64), fn_space(abi.ARGS, powerset(univ(1))))
proof
  fix t
  have v: all x. x in bits(64) -> ite(x = t, lnk.main(), lnk.A) in fn_space(abi.ARGS, powerset(univ(1))) proof
    fix x
    assume _
    show by simp(lnk.main_typed, acr.typed)
  qed
  show := mp(fn_build_space[d := bits(64), v := x. ite(x = t, lnk.main(), lnk.A), b := fn_space(abi.ARGS, powerset(univ(1)))], v)
qed

theorem lnk.fp1_io: all t a G n. tr.callee_io(G, n) -> (all T. T in bits(64) -> tr.callee_io(lnk.FP1(t, a, G)[T], n))
proof
  fix t a G n
  assume hio
  fix T
  assume hT
  have e := mp(app_fn_build[d := bits(64), v := x. ite(x = t, lnk.main(), ite(x = a, G, lnk.A)), a := T], hT)
  have i: tr.callee_io(ite(T = t, lnk.main(), ite(T = a, G, lnk.A)), n) by simp(hio, lnk.main_io[n := n], mp.undef_io[n := n])
  show := rewrite(sym(e), i)
qed

theorem lnk.fp0_io: all t n. all T. T in bits(64) -> tr.callee_io(lnk.FP0(t)[T], n)
proof
  fix t n T
  assume hT
  have e := mp(app_fn_build[d := bits(64), v := x. ite(x = t, lnk.main(), lnk.A), a := T], hT)
  show by simp(e, lnk.main_io[n := n], mp.undef_io[n := n])
qed

// ----------------------------------------------------------------------
//  __libc_start_init with _init and the init_array's map (frame_dummy:
//  register_tm_clones through its jump, its CFG form)

theorem fdm.impl_m_cfg: all statics. tr.impl_m(false, true, 4198864, musl_asm_cfg.register_tm_clones_fun(), 4199109, false, 4198400, text.code, statics)
proof
  fix statics
  show := mp(all_elim(tr.impl_m_jmp, {false}, {true}, {4198864}, {4198868}, {4198720}, {4294967143}, {4198400}, {text.code}, {frame_dummy.code}, {statics},
      {musl_asm_cfg.register_tm_clones_fun()}, {4199109}, {false}),
    frame_dummy.in_text, frame_dummy.at_4011d0, frame_dummy.at_4011d4, simp(), simp(), simp(), simp(), simp(), all_elim(c1rtc.impl_m, {statics}))
qed

abbrev lsil.FP := lnk.FP1(4199109, 4198864, musl_asm_cfg.register_tm_clones_fun())
abbrev lsil.F := c_src_env___libc_start_main_cfg.libc_start_init_fun(musl_asm_cfg._init_fun(), lsil.FP)

theorem lsil.linked: all statics. tr.impl_m(false, false, 4200433, lsil.F, 4199109, true, 4198400, text.code, statics)
proof
  fix statics
  have ccs: tr.ccs_m(false, 24, 4198864, musl_asm_cfg.register_tm_clones_fun(), 4199109, true, 4198400, text.code, statics)
    by defs(taut(apply(tr.impl_m_k, all_elim(fdm.impl_m_cfg, {statics}))), tr.ccs_m)
  have co := mp(all_elim(lnk.code_ok1, {4199109}, {4198864}, {musl_asm_cfg.register_tm_clones_fun()}, {0}, {24}, {statics}), (!(4198864 = 4199109) by simp()), ccs, c1rtc.io)
  have ft := mp(all_elim(lnk.fp1_typed, {4199109}, {4198864}, {musl_asm_cfg.register_tm_clones_fun()}), c1rtc.typed)
  show := mp(all_elim(c1lsi.impl_m, {statics}, {musl_asm_cfg._init_fun()}, {lsil.FP}),
    apply(tr.impl_m_u, apply(tr.impl_m_k, all_elim(c1in.impl_m, {statics}))), c1in.typed, c1in.io, co, ft)
qed

theorem lsil.io: tr.callee_io(lsil.F, 0)
proof
  show := mp(all_elim(c1lsi.io, {musl_asm_cfg._init_fun()}, {lsil.FP}), c1in.io, mp(all_elim(lnk.fp1_io, {4199109}, {4198864}, {musl_asm_cfg.register_tm_clones_fun()}, {0}), c1rtc.io))
qed

theorem lsil.typed: lsil.F in fn_space(abi.ARGS, powerset(univ(1)))
proof
  show := all_elim(c1lsi.typed, {musl_asm_cfg._init_fun()}, {lsil.FP})
qed

