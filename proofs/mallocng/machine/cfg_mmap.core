// __mmap's translation unit by its CFG form, as proofs/mallocng/machine/
// cfg.core's: __syscall6 (seven arguments, the last on the stack, its
// contract `tr.implements_at_s`) refined and composed with its spec.

refines __syscall6_ref c_src_mman_mmap_cfg.__syscall6_fun c_src_mman_mmap.__syscall6_fun

// __syscall6: its code's contract, the spec's
theorem sy6c.composed: all statics. tr.implements_at_s(4213388, mallocng_specs.syscall6_spec_fun(), 4198400, text.code, statics)
proof
  fix statics
  have st := mp(all_elim(tr.implements_refine_s, {4213388}, {c_src_mman_mmap_cfg.__syscall6_fun()}, {c_src_mman_mmap.__syscall6_fun()},
    {4198400}, {text.code}, {statics}), all_elim(sy6c.implements_s, {statics}), __syscall6_ref)
  show := mp(all_elim(tr.implements_refine_s, {4213388}, {c_src_mman_mmap.__syscall6_fun()}, {mallocng_specs.syscall6_spec_fun()},
    {4198400}, {text.code}, {statics}), st, ms.syscall6_fun_c2)
qed
