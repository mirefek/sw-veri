// __mmap's translation unit by its CFG form, as proofs/mallocng/machine/
// cfg.core's: __syscall6 (seven arguments, the last on the stack, its
// contract `tr.implements_at_s`) refined and composed with its spec.

refines __syscall6_ref c_src_mman_mmap_cfg.__syscall6_fun c_src_mman_mmap.__syscall6_fun

// __syscall6: its code's contract, the spec's
theorem sy6c.composed: all statics. tr.implements_at_s(4213388, mallocng_specs.syscall6_spec_fun(), 4198400, text.code, statics)
proof
  fix statics
  have st := mp(all_elim(tr.implements_refine_s, {4213388}, {c_src_mman_mmap_cfg.__syscall6_fun()}, {c_src_mman_mmap.__syscall6_fun()},
    {4198400}, {text.code}, {statics}), all_elim(sy6c.implements_s, {statics}), __syscall6_ref)
  show := mp(all_elim(tr.implements_refine_s, {4213388}, {c_src_mman_mmap.__syscall6_fun()}, {mallocng_specs.syscall6_spec_fun()},
    {4198400}, {text.code}, {statics}), st, ms.syscall6_fun_c2)
qed

refines __mmap_ref c_src_mman_mmap_cfg.__mmap_fun c_src_mman_mmap.__mmap_fun

theorem cc.vm_wait: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
  runs(c_src_mman_mmap_cfg.dummy_fun()[regs], s, o) -> runs(mallocng_specs.vm_wait_spec_fun()[regs], s, o)
proof
  fix regs s o
  assume h1 h2 h3 hr
  show := mp(all_elim(ms.vm_wait_fun_c2, {regs}, {s}, {o}), h1, h2, h3, mp(all_elim(__vm_wait_ref, {regs}, {s}, {o}), h1, h2, h3, hr))
qed

theorem cc.syscall6: all regs s o. regs in list_type(bits(64)) -> s in abi.World ->
  runs(c_src_mman_mmap_cfg.__syscall6_fun()[regs], s, o) -> runs(mallocng_specs.syscall6_spec_fun()[regs], s, o)
proof
  fix regs s o
  assume h1 h2 hr
  show := mp(all_elim(ms.syscall6_fun_c2, {regs}, {s}, {o}), h1, h2, mp(all_elim(__syscall6_ref, {regs}, {s}, {o}), h1, h2, hr))
qed

// __mmap with its callees (linked): its code's contract, the spec's
theorem mmc.linked: all statics. tr.implements_at(4213468, c_src_mman_mmap_cfg.__mmap_fun(
  c_src_errno___errno_location_cfg.__errno_location_fun(c_src_errno___errno_location_cfg.__get_tp_fun()), c_src_mman_mmap_cfg.dummy_fun(),
  c_src_mman_mmap_cfg.__syscall6_fun(),
  c_src_internal_syscall_ret_cfg.__syscall_ret_fun(c_src_errno___errno_location_cfg.__errno_location_fun(c_src_errno___errno_location_cfg.__get_tp_fun()))),
  4198400, text.code, statics)
proof
  fix statics
  let ELF := c_src_errno___errno_location_cfg.__errno_location_fun(c_src_errno___errno_location_cfg.__get_tp_fun())
  show := mp(all_elim(mmc.implements, {statics}, {ELF}, {c_src_mman_mmap_cfg.dummy_fun()}, {c_src_mman_mmap_cfg.__syscall6_fun()},
    {c_src_internal_syscall_ret_cfg.__syscall_ret_fun(ELF)}),
    all_elim(elc.linked, {statics}), elc.typed_linked, elc.io_linked, all_elim(vwc.implements, {statics}), vwc.typed, vwc.io,
    all_elim(sy6c.implements_s, {statics}), sy6c.typed, sy6c.io, all_elim(srtc.linked, {statics}), srtc.typed_linked, srtc.io_linked)
qed

theorem mmc.composed: all statics. tr.implements_at(4213468, mallocng_specs.mmap_spec_fun(), 4198400, text.code, statics)
proof
  fix statics
  let ELF := c_src_errno___errno_location_cfg.__errno_location_fun(c_src_errno___errno_location_cfg.__get_tp_fun())
  let VW := c_src_mman_mmap_cfg.dummy_fun()
  let S6 := c_src_mman_mmap_cfg.__syscall6_fun()
  let GR := c_src_internal_syscall_ret_cfg.__syscall_ret_fun(ELF)
  have cc: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
      runs(c_src_mman_mmap_cfg.__mmap_fun(ELF, VW, S6, GR)[regs], s, o) -> runs(mallocng_specs.mmap_spec_fun()[regs], s, o) proof
    fix regs s o
    assume h1 h2 h3 hr
    have c2 := mp(all_elim(ms.mmap_fun_c2, {ELF}, {VW}, {S6}, {GR}), cc.errno_location, cc.vm_wait, cc.syscall6, cc.syscall_ret)
    show := mp(all_elim(c2, {regs}, {s}, {o}), h1, h2, h3, mp(all_elim(__mmap_ref, {ELF}, {VW}, {S6}, {GR}, {regs}, {s}, {o}), h1, h2, h3, hr))
  qed
  show := mp(all_elim(tr.implements_refine, {4213468}, {c_src_mman_mmap_cfg.__mmap_fun(ELF, VW, S6, GR)}, {mallocng_specs.mmap_spec_fun()},
    {4198400}, {text.code}, {statics}), all_elim(mmc.linked, {statics}), cc)
qed
