// C1 of the exit path's units (src/exit/exit.c, src/exit/_Exit.c): exit,
// its unit's copies of musl's helpers (`ex_*`, by address), _Exit and its
// unit's __syscall1 (exit_group, then exit: the process's end).

c1 ex___syscall1 c_src_exit__Exit_cfg.__syscall1_fun exs1c
c1 _Exit c_src_exit__Exit_cfg._Exit_fun exitc
c1 ex___get_tp c_src_exit_exit_cfg.__get_tp_fun exgtc
c1 ex_a_cas c_src_malloc_mallocng_malloc_cfg.a_cas_fun excasc
c1 ex_dummy c_src_exit_exit_cfg.dummy_fun exdmc

// gcc's crtbegin: the fini_array's one entry, __do_global_dtors_aux (its
// deregister_tm_clones call; the weak __cxa_finalize's, absent, not run);
// crti's _fini (push rax; pop rax; ret: _init's code)
c1 deregister_tm_clones musl_asm_cfg.deregister_tm_clones_fun dtmc
refines dtm_ref musl_asm_cfg.deregister_tm_clones_fun musl_asm.deregister_tm_clones_fun
c1 __do_global_dtors_aux musl_asm.__do_global_dtors_aux_fun gdtc
c1 _fini musl_asm_cfg._init_fun finic

// exit.c's libc_exit_fini (the fini_array's entries through the code map,
// downwards; then _fini) and exit itself (its callees by their contracts)
c1 __libc_exit_fini c_src_exit_exit_cfg.libc_exit_fini_fun exfnc
c1 exit c_src_exit_exit_cfg.exit_fun exc1
