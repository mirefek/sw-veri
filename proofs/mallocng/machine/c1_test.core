// C1 of the test program's functions (tests/test_malloc.c): its helpers
// and main, in the main mode (the thread pointer and the canary set up).

// (here while the test's C1 is made, for short checks; then beside
// tr.fs32_rr in proofs/translate_flags.core)
// cmp r32, r32 with either register maybe wider: its low 32 bits (u of g
// holding u0, x of h holding x0 -- a call's result in rax compared at once)
theorem tr.fs32_rrl: all s base code fr a a2 len g h n1 u0 u n2 x0 x hs rs w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a ->
    runs(x86_64_linux.exec_body(len, tag(56, pair(4, pair(h, pair(tag(0, g), pair(tag(0, g), tag(0, h))))))), m, o)) ->
  a2 = bits_add(64, a, len) -> g in x86_64_linux.Reg -> h in x86_64_linux.Reg ->
  g in dom(rs) -> rs[g] = pair(n1, u0) -> (u = bits_of_int(32, u0) || (u = u0 && n1 = 4) || (u = u0 && u0 in bits(32))) ->
  h in dom(rs) -> rs[h] = pair(n2, x0) -> (x = bits_of_int(32, x0) || (x = x0 && n2 = 4) || (x = x0 && x0 in bits(32))) ->
  all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
    (ex f. x86i.flags_ok(m, f) && x86i.subf(32, u, x, f) && o = ok(fn_update(fn_update(m, "rip", a2), "flags", f), empty))
proof
  fix s base code fr a a2 len g h n1 u0 u n2 x0 x hs rs w
  assume hat ha2 hg hh0 hgd hgu hu hhd hhu hx
  fix m o
  assume hi hr hh hrs ho
  have ipM ipU ipC .. := apply(tr.inv_parts, hi)
  have su := apply(tr.reg_low32, {m}, {rs}, {g}, {n1}, {u0}, {u}, ipM, hg, hrs, hgd, hgu, hu)
  have sx := apply(tr.reg_low32, {m}, {rs}, {h}, {n2}, {x0}, {x}, ipM, hh0, hrs, hhd, hhu, hx)
  have e := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
  obtain f, hf from apply(x86i.cmpf32_rr, {m}, {o}, {g}, {h}, {len}, ipM, ipU, hg, hh0, e)
  have hf2 := rewrite(sx, rewrite(su, hf))
  show by ex_intro({f}, simp(hf2, hr, ha2, keep(x86i.flags_ok, x86i.subf, x86i.logf)))
qed

// (... beside tr.cdqe in proofs/translate.core) cdqe with rax maybe wider:
// its low 32 bits u (of u0) sign-extended -- a call's result at once
theorem tr.cdqe_l(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len n u0 u r hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a ->
    runs(x86_64_linux.exec_body(len, tag(91, 8)), m, o)) ->
  a2 = bits_add(64, a, len) -> 0 in dom(rs) -> rs[0] = pair(n, u0) ->
  (u = bits_of_int(32, u0) || (u = u0 && n = 4) || (u = u0 && u0 in bits(32))) -> r = bits_sext(32, 64, u) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs, 0, pair(8, r)), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len n u0 u r hs ds rs p w
  assume hat ha2 hd hu hul hr hpt0
  have hpt := rewrite(hr, hpt0)
  have sc0: tr.scratch_reg(0) by defs(simp(), tr.scratch_reg)
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(m.gpr, 0, bits_sext(32, 64, u))), empty) proof
    fix m o
    assume hi hr2 hhs hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have sl := apply(tr.reg_low32, {m}, {rs}, {0}, {n}, {u0}, {u}, ipM, (0 in x86_64_linux.Reg by simp()), hrs, hd, hu, hul)
    have hx := mp(mp(mp(all_elim(hat, {m}, {o}), ho), ipC), hr2)
    have e := apply(x86i.cdqe, {m}, {o}, {len}, ipM, ipU, hx)
    show by simp(rewrite(sl, e), hr2, ha2)
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_sext(32, 64, u) in bits(int_mul(8, 8)) && bits_sext(32, 64, u) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {0}, {8}, {bits_sext(32, 64, u)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, sc0, ty, hpt)
qed

// (... beside tr.result64_live in proofs/translate_objs.core) a 32-bit
// result, the objects released: the world with the callers' objects L
theorem tr.result32_live: all w V L. L in univ(1) -> w in univ(1) -> V in bits(int_mul(8, 4)) -> (all y. y in bits(64) ->
  runs(mkprog(x1 x2. letin(V, x3. letin(fn_update(x1, "objs", fn_update(x1.objs, "live", L)), x4. bind_rel(gimple.result(32, x3), x4,
    x5 x6. any_rel(x7. x7 in bits(64), x7. x2 = ok(x5, pair(x6, x7))), x5 x6. x2 = exc(x5, x6), x5. x2 = diverge(x5))))), w, ok(tr.wlive(w, L), pair(V, y))))
proof
  fix w V L
  assume hl hw hb
  fix y
  assume hy
  let W2 := tr.wlive(w, L)
  let R2 := ok(W2, pair(V, y))
  have b32: V in bits(32) by simp(hb)
  have ou := mp(app_univ[u := 1, f := w, k := "objs"], hw)
  have w2u: W2 in univ(1) by simp(hw, hl, ou)
  have ro := apply(g.result_ok, {W2}, {V}, w2u, b32)
  have k: bind_rel(gimple.result(32, V), W2, x6 x7. any_rel(x8. x8 in bits(64), x8. R2 = ok(x6, pair(x7, x8))), x6 x7. R2 = exc(x6, x7), x6. R2 = diverge(x6))
    by defs(ex_intro({ok(W2, V)}, simp(ro, hy, keep(runs, gimple.result))), bind_rel)
  have b: letin(V, x3. letin(fn_update(w, "objs", fn_update(w.objs, "live", L)), x4. bind_rel(gimple.result(32, x3), x4,
      x5 x6. any_rel(x7. x7 in bits(64), x7. R2 = ok(x5, pair(x6, x7))), x5 x6. R2 = exc(x5, x6), x5. R2 = diverge(x5)))) by defs(k, letin)
  have pu: pair(w, R2) in univ(1) by simp(hw, w2u, b32, hy)
  show := apply(tr.runs_intro[r := x1 x2. letin(V, x3. letin(fn_update(x1, "objs", fn_update(x1.objs, "live", L)), x4. bind_rel(gimple.result(32, x3), x4,
    x5 x6. any_rel(x7. x7 in bits(64), x7. x2 = ok(x5, pair(x6, x7))), x5 x6. x2 = exc(x5, x6), x5. x2 = diverge(x5))))], {w}, {R2}, pu, b)
qed

// (... beside x86i.movzx16_sib in proofs/x86_insn.core) mov r64, qword
// [b + i*k + d] (8B /r)
theorem x86i.load64_sib: all m o g b i k d z2 len. m in x86_64_linux.Machine -> m in univ(1) -> g in x86_64_linux.Reg -> b in x86_64_linux.Reg -> i in x86_64_linux.Reg ->
  k in bits(64) -> x86i.acc(m, x86i.sib_ea(m, b, i, k, d), 8, 0) ->
  runs(x86_64_linux.exec_body(len, tag(76, pair(8, pair(g, pair(x86i.sib_mem(b, i, k, d), pair(x86i.sib_mem(b, i, k, d), z2)))))), m, o) ->
  o = ok(fn_update(fn_update(m, "rip", bits_add(64, m.rip, len)), "gpr",
    fn_update(m.gpr, g, x86_64_linux.le(m.vm.bytes, x86i.sib_ea(m, b, i, k, d), 8))), empty)
proof
  fix m o g b i k d z2 len
  assume hM hu hg hb hi hk a0 h
  have pt := apply(x86i.parts, hM)
  have kk: bits_add(64, k, 0) = k by defs(simp(hk), bits_add)
  have k0: all j. j in omega -> int_lt(j, 8) -> x86_64_linux.canonical(bits_add(64, x86i.sib_ea(m, b, i, k, d), bits_of_int(64, j))) proof
    fix j
    assume j1 j2
    show by mp(all_elim(all_elim(all_elim(x86.access_canonical, {m.vm}), {bits_add(64, x86i.sib_ea(m, b, i, k, d), bits_of_int(64, j))}), {0}), mp(mp(all_elim(a0, {j}), j1), j2))
  qed
  show by simp(h, hu, pt, kk, apply(x86i.reg_typed, hM, hg), apply(x86i.reg_typed, hM, hb), apply(x86i.reg_typed, hM, hi), a0, k0, x86.touch_range_access, keep(x86_64_linux.touch_range, x86_64_linux.can_access))
qed

// (... beside tr.movzx16_rsib in proofs/translate_objsn.core) mov r64,
// qword [rsp + i*k + d] (i holding iv): the spec's 8-byte load at pp + off,
// the frame's address at the offset c plus i*k (an element of a frame's
// stack object)
theorem tr.load64_rsib(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g i k d c z2 iv pp off r hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a ->
    runs(x86_64_linux.exec_body(len, tag(76, pair(8, pair(g, pair(x86i.sib_mem(4, i, k, d), pair(x86i.sib_mem(4, i, k, d), z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> i in x86_64_linux.Reg -> k in bits(64) -> i in dom(rs) -> rs[i] = pair(8, iv) ->
  d in bits(64) -> c = int_mod(int_sub(d, fr), 18446744073709551616) -> pp in bits(64) -> off in bits(32) ->
  bits_add(64, tr.ha(s, c), bits_mul(64, iv, k)) = bits_add(64, pp, off) -> g.mem_defined(w, pp, off, 8, false) ->
  r = bits_of_int(64, gimple.bytes_at(w.vm, bits_add(64, pp, off), 8)) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs, g, pair(8, r)), p, w) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g i k d c z2 iv pp off r hs ds rs p w
  assume hat ha2 hg hi0 hk hid hiu hd hc hp ho hA hdef hr hpt0
  have hpt := rewrite(hr, hpt0)
  let A := bits_add(64, pp, off)
  let BY := bits_of_int(64, gimple.bytes_at(w.vm, A, 8))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(m.gpr, g, BY)), empty) proof
    fix m o
    assume hi hr2 hhs hrs hmm ho2
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
    have ri .. := apply(tr.regs_get, {m}, {rs}, {i}, {8}, {iv}, hrs, hid, hiu)
    // (the frame's address at c, plus the index's)
    let X := bits_mul(64, iv, k)
    have xo: X in omega by simp()
    have fe := apply(tr.frame_ea, {s}, {base}, {code}, {fr}, {m}, {w}, {d}, {c}, {X}, hi, hd, hc, xo)
    have q1: bits_add(64, int_add(int_add(m.gpr[4], X), d), 0) = bits_add(64, int_add(m.gpr[4], d), X) by defs(arith(), bits_add)
    have q2: bits_add(64, int_add(s.gpr[4], c), X) = bits_add(64, tr.ha(s, c), X) by defs(arith(), bits_add)
    have ea: x86i.sib_ea(m, 4, i, k, d) = A by simp(ri, q1, fe, q2, hA)
    have rd := apply(tr.reads, {s}, {m}, {w}, {v}, {pp}, {off}, {8}, hp, ho, hdef, hmm, simp())
    have ac := rewrite(sym(ea), rd.1)
    have hx := mp(all_elim(hat, {m}, {o}), ho2, ipC, hr2)
    have e := apply(x86i.load64_sib, {m}, {o}, {g}, {4}, {i}, {k}, {d}, {z2}, {len}, ipM, ipU, gR, simp(), hi0, hk, ac, hx)
    have lw := all_elim(tr.le_bytes, {w.vm}, {A}, {8})
    show by simp(e, ea, rd.2, lw, hr2, ha2, keep(gimple.bytes_at, x86_64_linux.le))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> BY in bits(int_mul(8, 8)) && BY in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs, gimple.bytes_at))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0v[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {8}, {BY}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

c1 pat c_tests_test_malloc_cfg.pat_fun tpat
c1 size c_tests_test_malloc_cfg.size_fun tsize
c1 intact c_tests_test_malloc_cfg.intact_fun tintact
c1 fill c_tests_test_malloc_cfg.fill_fun tfill
c1 main c_tests_test_malloc_cfg.main_fun tmain
