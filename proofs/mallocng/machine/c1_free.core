// C1 of free's translation unit (free.c; the layer
// c_src_malloc_mallocng_free_cfg) and of the `free` symbol (src/malloc/free.c).
// free.c's copies of malloc.c's static functions (`fr_*`, by address) have
// the same GIMPLE: each is checked against malloc.c's CFG form, their
// purpose proofs then the same.

c1 a_or c_src_malloc_mallocng_free_cfg.a_or_fun aorc
c1 fr_a_cas c_src_malloc_mallocng_malloc_cfg.a_cas_fun facsc
c1 fr_wrlock c_src_malloc_mallocng_malloc_cfg.wrlock_fun fwrlc
c1 fr_unlock c_src_malloc_mallocng_malloc_cfg.unlock_fun funlc
c1 fr_queue c_src_malloc_mallocng_malloc_cfg.queue_fun fqutc
c1 fr_dequeue c_src_malloc_mallocng_malloc_cfg.dequeue_fun fdqtc
c1 fr_free_meta c_src_malloc_mallocng_malloc_cfg.free_meta_fun ffmtc
c1 fr_activate_group c_src_malloc_mallocng_malloc_cfg.activate_group_fun fagtc
c1 fr_get_slot_index c_src_malloc_mallocng_malloc_cfg.get_slot_index_fun fgsitc
c1 fr_get_meta c_src_malloc_mallocng_malloc_cfg.get_meta_fun fgmtc
c1 fr_get_stride c_src_malloc_mallocng_malloc_cfg.get_stride_fun fgstc
c1 fr_step_seq c_src_malloc_mallocng_malloc_cfg.step_seq_fun fsstc
c1 fr_is_bouncing c_src_malloc_mallocng_malloc_cfg.is_bouncing_fun fibtc
c1 get_nominal_size c_src_malloc_mallocng_free_cfg.get_nominal_size_fun gnsc
c1 record_seq c_src_malloc_mallocng_free_cfg.record_seq_fun rsqc
c1 okay_to_free c_src_malloc_mallocng_free_cfg.okay_to_free_fun otfc
c1 free_group c_src_malloc_mallocng_free_cfg.free_group_fun fgrc
c1 nontrivial_free c_src_malloc_mallocng_free_cfg.nontrivial_free_fun ntfc
c1 __libc_free c_src_malloc_mallocng_free_cfg.__libc_free_fun lfrc
c1 free c_src_malloc_free_cfg.free_fun frc

// free.c's own functions: each CFG form refining its structured one
refines a_or_ref c_src_malloc_mallocng_free_cfg.a_or_fun c_src_malloc_mallocng_free.a_or_fun
refines get_nominal_size_ref c_src_malloc_mallocng_free_cfg.get_nominal_size_fun c_src_malloc_mallocng_free.get_nominal_size_fun
refines record_seq_ref c_src_malloc_mallocng_free_cfg.record_seq_fun c_src_malloc_mallocng_free.record_seq_fun
refines okay_to_free_ref c_src_malloc_mallocng_free_cfg.okay_to_free_fun c_src_malloc_mallocng_free.okay_to_free_fun
refines free_group_ref c_src_malloc_mallocng_free_cfg.free_group_fun c_src_malloc_mallocng_free.free_group_fun
refines nontrivial_free_ref c_src_malloc_mallocng_free_cfg.nontrivial_free_fun c_src_malloc_mallocng_free.nontrivial_free_fun
refines __libc_free_ref c_src_malloc_mallocng_free_cfg.__libc_free_fun c_src_malloc_mallocng_free.__libc_free_fun
refines free_ref c_src_malloc_free_cfg.free_fun c_src_malloc_free.free_fun
