// C1 of the libc leaves mallocng calls (their own translation units:
// errno, the syscall wrappers), on GIMPLE's control-flow graph as
// proofs/mallocng/machine/c1.core's.

c1 __get_tp c_src_errno___errno_location_cfg.__get_tp_fun gtpc
c1 __errno_location c_src_errno___errno_location_cfg.__errno_location_fun elc
