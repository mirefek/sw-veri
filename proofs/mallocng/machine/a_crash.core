// a_crash at the machine level: the trap, its outcome a crash (the
// ABI's `implements` with no return).

theorem acr.implements_u: all statics. tr.implements_at_u(4205678, mallocng_specs.a_crash_spec_fun(), 4198400, text.code, statics)
proof
  fix statics
  have g: all args objs mem s o. args in abi.ARGS -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) ->
      abi.loaded(s.vm, 4198400, text.code, statics) -> s.rip = 4205678 -> tr.entry_ok_u(s, args) -> tr.objs_ok(s, objs) -> abi.view_ok(s, objs, mem) ->
      tr.run_d(s, s, o) -> tr.matches_t(mallocng_specs.a_crash_spec_fun(), args, objs, mem, s, o) proof
    fix args objs mem s o
    assume hA ho hm hs hu _ _ _ _ _ _
    let V := abi.view(s, objs, mem)
    have ou := apply(abi.objs_univ, ho)
    have mu := apply(x86.vm_univ, hm)
    have vu: V in univ(1) by simp(hu, ou, mu)
    have vW := apply(abi.world_typed, hs, ho, hm, vu)
    have rst: abi.raise_state(V) by defs(apply(tr.world_and, vW), abi.raise_state)
    have eu: empty in univ(1) by simp()
    have eno: !(empty = exc_val("stack_overflow", empty)) by defs(all_elim(tr.pair_ne, {"stack_overflow"}, {empty}), exc_val)
    have pu: pair(V, exc(V, empty)) in univ(1) by simp(vu)
    have rf: runs(mallocng_specs.a_crash_spec_fun()[args], V, exc(V, empty)) by defs(simp(hA, pu), mallocng_specs.a_crash_spec_fun)
    have ra: abi.raises_at(mallocng_specs.a_crash_spec_fun(), args, objs, mem, s) by defs(ex_intro({empty}, {V}, taut(eu, eno, rst, rf)), abi.raises_at)
    show by defs(taut(ra), tr.matches_t)
  qed
  show by defs(g, tr.implements_at_u)
qed

theorem acr.implements: all statics. tr.implements_at(4205678, mallocng_specs.a_crash_spec_fun(), 4198400, text.code, statics)
proof
  fix statics
  show := apply(tr.implements_u, all_elim(acr.implements_u, {statics}))
qed

// (its spec raises from every world: so where it diverges)
theorem acr.div_raises: tr.div_raises(mallocng_specs.a_crash_spec_fun())
proof
  have g: all args w t. args in abi.ARGS -> w in abi.World -> w in univ(1) -> runs(mallocng_specs.a_crash_spec_fun()[args], w, diverge(t)) ->
      (ex e x. e in univ(1) && !(e = exc_val("stack_overflow", empty)) && abi.raise_state(x) && runs(mallocng_specs.a_crash_spec_fun()[args], w, exc(x, e))) proof
    fix args w t
    assume hA hW hu _
    have rst: abi.raise_state(w) by defs(apply(tr.world_and, hW), abi.raise_state)
    have eu: empty in univ(1) by simp()
    have eno: !(empty = exc_val("stack_overflow", empty)) by defs(all_elim(tr.pair_ne, {"stack_overflow"}, {empty}), exc_val)
    have pu: pair(w, exc(w, empty)) in univ(1) by simp(hu)
    have rf: runs(mallocng_specs.a_crash_spec_fun()[args], w, exc(w, empty)) by defs(simp(hA, pu), mallocng_specs.a_crash_spec_fun)
    show by ex_intro({empty}, {w}, taut(eu, eno, rst, rf))
  qed
  show by defs(g, tr.div_raises)
qed

theorem acr.implements_abi: all statics. abi.implements2_at(single(empty), 4205678, mallocng_specs.a_crash_spec_fun(), 4198400, text.code, statics)
proof
  fix statics
  show := apply(tr.implements_abi, acr.div_raises, all_elim(acr.implements, {statics}))
qed

// (as a callee: undefined wherever it returns)
theorem acr.io: tr.callee_io(mallocng_specs.a_crash_spec_fun(), 0)
proof
  have g: all args w w2 r. ord_le(0, seq_len(args)) -> runs(mallocng_specs.a_crash_spec_fun()[args], w, ok(w2, r)) ->
      tr.returns_valid(w, w2) || tr.may_raise(mallocng_specs.a_crash_spec_fun(), args, w) proof
    fix args w w2 r
    assume _ h
    have ha hp := apply(runs_fn_build, expand(h, mallocng_specs.a_crash_spec_fun))
    have wu: w in univ(1) by simp(apply(g.runs_univ, hp))
    have m: all x e. x in univ(1) -> e in univ(1) -> runs(mallocng_specs.a_crash_spec_fun()[args], w, exc(x, e)) proof
      fix x e
      assume hx he
      have pu: pair(w, exc(x, e)) in univ(1) by simp(wu, hx, he)
      show by defs(simp(ha, pu), mallocng_specs.a_crash_spec_fun)
    qed
    have d: all t. t in univ(1) -> runs(mallocng_specs.a_crash_spec_fun()[args], w, diverge(t)) proof
      fix t
      assume ht
      have pu: pair(w, diverge(t)) in univ(1) by simp(wu, ht)
      show by defs(simp(ha, pu), mallocng_specs.a_crash_spec_fun)
    qed
    have mr: tr.may_raise(mallocng_specs.a_crash_spec_fun(), args, w) by defs(taut(m, d), tr.may_raise, tr.undef)
    show by taut(mr)
  qed
  show by defs(g, tr.callee_io)
qed

theorem acr.typed: mallocng_specs.a_crash_spec_fun() in fn_space(abi.ARGS, powerset(univ(1)))
proof
  show by defs(tr.fun_typed, mallocng_specs.a_crash_spec_fun)
qed
