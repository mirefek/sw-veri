// a_crash's contract in either mode (tr.impl_m), at any address: its
// spec raises from every world, so every outcome is the undefined one
// (tr.ub). The startup units' copies (tls_a_crash, lsm_a_crash: hlt, as
// proofs/mallocng/machine/a_crash.core's) by it.

theorem acr.impl_m: all b u f t k statics. tr.impl_m(b, u, f, mallocng_specs.a_crash_spec_fun(), t, k, 4198400, text.code, statics)
proof
  fix b u f t k statics
  have g: all args objs mem s o. args in abi.ARGS -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) ->
      abi.loaded(s.vm, 4198400, text.code, statics) -> s.rip = f -> tr.eok(b, u, s, args) -> tr.objs_ok(s, objs) -> tr.vok(b, s, objs, mem) -> tr.run_s(s, t, s, o) ->
      tr.mtv(b, s, abi.wob(objs, tr.cbm(b, s.fs_base)), mallocng_specs.a_crash_spec_fun()[args], tr.vw(b, s, objs, mem), o, k) proof
    fix args objs mem s o
    assume hA ho hm hs hu _ _ _ _ _ _
    let W := tr.vw(b, s, objs, mem)
    have wu := apply(tr.vw_univ, {b}, hu, ho, hm)
    have wW := apply(tr.vw_typed, {b}, hs, ho, hm, wu)
    have rst: abi.raise_state(W) by defs(apply(tr.world_and, wW), abi.raise_state)
    have eu: empty in univ(1) by simp()
    have eno := tr.undef_empty
    have pu: pair(W, exc(W, empty)) in univ(1) by simp(wu)
    have rf: runs(mallocng_specs.a_crash_spec_fun()[args], W, exc(W, empty)) by defs(simp(hA, pu), mallocng_specs.a_crash_spec_fun)
    have ub: tr.ub(s, abi.wob(objs, tr.cbm(b, s.fs_base)), mallocng_specs.a_crash_spec_fun()[args], W) by defs(ex_intro({empty}, {W}, taut(eu, eno, rst, rf)), tr.ub)
    show by defs(taut(ub), tr.mtv)
  qed
  show by defs(g, tr.impl_m)
qed
