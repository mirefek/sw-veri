// C1 of musl's assembly functions against their hand-written readable
// GIMPLE (layers/musl_asm_cfg.sl): the locals in registers, no frame.

// (memcpy: called in either mode -- by get_random_secret after main, by
// __init_ssp and __copy_tls before -- one C1 for every mode b, its body
// using no mode's own rule; the main mode's ABI contract from b true,
// tr.impl_m_main)
c1 memcpy musl_asm_cfg.memcpy_fun mcp nostop 4199122 both

theorem mcp.implements: all statics. tr.implements_at(4214179, musl_asm_cfg.memcpy_fun(), 4198400, text.code, statics)
proof
  fix statics
  show := apply(tr.impl_m_main, apply(tr.impl_m_u, all_elim(mcp.impl_m, {statics}, {true})))
qed

// (memset: called before main, in __init_libc -- the startup mode's
// contract; a leaf, never stopping)
c1 memset musl_asm_cfg.memset_fun mset nostop 4199122 startup
// (__set_thread_area: in __init_tp, the thread pointer set -- the startup
// mode's only)
c1 __set_thread_area musl_asm_cfg.__set_thread_area_fun sta nostop 4199122 startup

// (the CFG form refining the structured one)
refines memcpy_ref musl_asm_cfg.memcpy_fun musl_asm.memcpy_fun
refines memset_ref musl_asm_cfg.memset_fun musl_asm.memset_fun
refines sta_ref musl_asm_cfg.__set_thread_area_fun musl_asm.__set_thread_area_fun
