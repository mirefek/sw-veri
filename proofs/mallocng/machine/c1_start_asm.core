// C1 of the startup path's code not from musl's C (crti/crtn's _init;
// layers/musl_asm_cfg.sl's readable forms) in the startup mode, never
// reaching main (`nostop`).

c1 _init musl_asm_cfg._init_fun c1in nostop 4198873 startup
refines init_ref musl_asm_cfg._init_fun musl_asm._init_fun
// (gcc's crtbegin: the init_array's constructor frame_dummy jumps to
// register_tm_clones -- nothing done, its tests constant)
c1 register_tm_clones musl_asm_cfg.register_tm_clones_fun c1rtc nostop 4198873 startup
refines rtc_ref musl_asm_cfg.register_tm_clones_fun musl_asm.register_tm_clones_fun

// frame_dummy (endbr64; jmp register_tm_clones): register_tm_clones's
// contract its own (tr.impl_m_jmp)
theorem fdm.impl_m: all statics. tr.impl_m(false, true, 4198864, musl_asm.frame_dummy_fun(), 4198873, false, 4198400, text.code, statics)
proof
  fix statics
  have rt := mp(all_elim(tr.impl_m_refine, {false}, {true}, {4198720}, {musl_asm_cfg.register_tm_clones_fun()}, {musl_asm.register_tm_clones_fun()}, {4198873}, {false}, {4198400}, {text.code}, {statics}),
    all_elim(c1rtc.impl_m, {statics}), rtc_ref)
  have j := mp(all_elim(tr.impl_m_jmp, {false}, {true}, {4198864}, {4198868}, {4198720}, {4294967143}, {4198400}, {text.code}, {frame_dummy.code}, {statics}, {musl_asm.register_tm_clones_fun()}, {4198873}, {false}),
    frame_dummy.in_text, frame_dummy.at_4011d0, frame_dummy.at_4011d4, simp(), simp(), simp(), simp(), simp(), rt)
  show by defs(j, musl_asm.frame_dummy_fun)
qed
