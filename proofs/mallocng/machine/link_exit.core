// The exit path linked: exit with its callees' contracts (no stop: after
// main). The fini_array's code map: __do_global_dtors_aux at its one entry
// (0x401180, with deregister_tm_clones), a_crash's contract (undefined)
// everywhere else; a_crash and __syscall0 (no C1: hlt, a 0-argument
// syscall) by the undefined contract too -- their calls undefined in the
// spec.

// ----------------------------------------------------------------------
//  The code map: one callee G at a, undefined elsewhere

abbrev lxp.FP(a, G) := fn_build(bits(64), T. ite(T = a, G, lnk.A))

theorem lxp.code_ok: all a G n fr statics. tr.callee_contract(fr, a, G, 4198400, text.code, statics) -> tr.callee_io(G, n) ->
  tr.code_okn(lxp.FP(a, G), n, fr, 4198400, text.code, statics)
proof
  fix a G n fr statics
  assume hc hio
  have g: all T. T in bits(64) -> tr.callee_contract(fr, T, lxp.FP(a, G)[T], 4198400, text.code, statics) && tr.callee_io(lxp.FP(a, G)[T], n) proof
    fix T
    assume hT
    have e := mp(app_fn_build[d := bits(64), v := x. ite(x = a, G, lnk.A), a := T], hT)
    have k1: T = a -> tr.callee_contract(fr, T, lxp.FP(a, G)[T], 4198400, text.code, statics) && tr.callee_io(lxp.FP(a, G)[T], n) proof
      assume ea
      have m: lxp.FP(a, G)[T] = G by simp(e, ea)
      have c := rewrite(sym(m), rewrite(sym(ea), hc))
      have i := rewrite(sym(m), hio)
      show by taut(c, i)
    qed
    have k2: !(T = a) -> tr.callee_contract(fr, T, lxp.FP(a, G)[T], 4198400, text.code, statics) && tr.callee_io(lxp.FP(a, G)[T], n) proof
      assume n1
      have m: lxp.FP(a, G)[T] = lnk.A by simp(e, n1)
      have c0: tr.callee_contract(fr, T, lnk.A, 4198400, text.code, statics) by defs(taut(all_elim(mp.undef_implements_u, {T}, {statics})), tr.callee_contract)
      have c := rewrite(sym(m), c0)
      have i := rewrite(sym(m), mp.undef_io[n := n])
      show by taut(c, i)
    qed
    show by taut(k1, k2)
  qed
  show by defs(g, tr.code_okn)
qed

theorem lxp.fp_typed: all a G. G in fn_space(abi.ARGS, powerset(univ(1))) -> lxp.FP(a, G) in fn_space(bits(64), fn_space(abi.ARGS, powerset(univ(1))))
proof
  fix a G
  assume hg
  have v: all x. x in bits(64) -> ite(x = a, G, lnk.A) in fn_space(abi.ARGS, powerset(univ(1))) proof
    fix x
    assume _
    show by simp(hg, acr.typed)
  qed
  show := mp(fn_build_space[d := bits(64), v := x. ite(x = a, G, lnk.A), b := fn_space(abi.ARGS, powerset(univ(1)))], v)
qed

// ----------------------------------------------------------------------
//  __do_global_dtors_aux with deregister_tm_clones; __libc_exit_fini with
//  the map and _fini

abbrev lxp.DT := musl_asm.__do_global_dtors_aux_fun(musl_asm_cfg.deregister_tm_clones_fun())

theorem lxp.dt_impl: all statics. tr.implements_at(4198784, lxp.DT, 4198400, text.code, statics)
proof
  fix statics
  show := mp(all_elim(gdtc.implements, {statics}, {musl_asm_cfg.deregister_tm_clones_fun()}), all_elim(dtmc.implements, {statics}), dtmc.typed, dtmc.io)
qed

abbrev lxp.FN := c_src_exit_exit_cfg.libc_exit_fini_fun(lxp.FP(4198784, lxp.DT), musl_asm_cfg._init_fun())

theorem lxp.fn_impl: all statics. tr.implements_at(4201008, lxp.FN, 4198400, text.code, statics)
proof
  fix statics
  have cc: tr.callee_contract(24, 4198784, lxp.DT, 4198400, text.code, statics) by defs(taut(all_elim(lxp.dt_impl, {statics}), (int_mod(24, 16) = 8 by simp())), tr.callee_contract)
  have co := mp(all_elim(lxp.code_ok, {4198784}, {lxp.DT}, {0}, {24}, {statics}), cc, mp(all_elim(gdtc.io, {musl_asm_cfg.deregister_tm_clones_fun()}), dtmc.io))
  have ft := mp(all_elim(lxp.fp_typed, {4198784}, {lxp.DT}), all_elim(gdtc.typed, {musl_asm_cfg.deregister_tm_clones_fun()}))
  show := mp(all_elim(exfnc.implements, {statics}, {lxp.FP(4198784, lxp.DT)}, {musl_asm_cfg._init_fun()}), co, ft, all_elim(finic.implements, {statics}), finic.typed, finic.io)
qed

theorem lxp.fn_typed: lxp.FN in fn_space(abi.ARGS, powerset(univ(1)))
proof
  show := all_elim(exfnc.typed, {lxp.FP(4198784, lxp.DT)}, {musl_asm_cfg._init_fun()})
qed

theorem lxp.fn_io: tr.callee_io(lxp.FN, 0)
proof
  have fi: all T. T in bits(64) -> tr.callee_io(lxp.FP(4198784, lxp.DT)[T], 0) proof
    fix T
    assume hT
    have e := mp(app_fn_build[d := bits(64), v := x. ite(x = 4198784, lxp.DT, lnk.A), a := T], hT)
    have i: tr.callee_io(ite(T = 4198784, lxp.DT, lnk.A), 0) by simp(mp(all_elim(gdtc.io, {musl_asm_cfg.deregister_tm_clones_fun()}), dtmc.io), mp.undef_io[n := 0])
    show := rewrite(sym(e), i)
  qed
  show := mp(all_elim(exfnc.io, {lxp.FP(4198784, lxp.DT)}, {musl_asm_cfg._init_fun()}), fi, finic.io)
qed

// ----------------------------------------------------------------------
//  _Exit with its __syscall1; exit with all its callees (a_crash and
//  __syscall0 undefined, __funcs_on_exit and __stdio_exit the dummy)

abbrev lxp.XE := c_src_exit__Exit_cfg._Exit_fun(c_src_exit__Exit_cfg.__syscall1_fun())

theorem lxp.xe_impl: all statics. tr.implements_at(4216566, lxp.XE, 4198400, text.code, statics)
proof
  fix statics
  show := mp(all_elim(exitc.implements, {statics}, {c_src_exit__Exit_cfg.__syscall1_fun()}), all_elim(exs1c.implements, {statics}), exs1c.typed, exs1c.io)
qed

abbrev lxp.EX := c_src_exit_exit_cfg.exit_fun(c_src_exit_exit_cfg.__get_tp_fun(), c_src_malloc_mallocng_malloc_cfg.a_cas_fun(), lnk.A, lnk.A,
  c_src_exit_exit_cfg.dummy_fun(), lxp.FN, c_src_exit_exit_cfg.dummy_fun(), lxp.XE)

theorem lxp.linked: all statics. tr.implements_at(4198416, lxp.EX, 4198400, text.code, statics)
proof
  fix statics
  show := mp(all_elim(exc1.implements, {statics}, {c_src_exit_exit_cfg.__get_tp_fun()}, {c_src_malloc_mallocng_malloc_cfg.a_cas_fun()}, {lnk.A}, {lnk.A},
      {c_src_exit_exit_cfg.dummy_fun()}, {lxp.FN}, {c_src_exit_exit_cfg.dummy_fun()}, {lxp.XE}),
    all_elim(exgtc.implements, {statics}), exgtc.typed, exgtc.io,
    all_elim(excasc.implements, {statics}), excasc.typed, excasc.io,
    all_elim(mp.undef_implements, {4200983}, {statics}), acr.typed, mp.undef_io[n := 0],
    all_elim(mp.undef_implements, {4200921}, {statics}), acr.typed, mp.undef_io[n := 1],
    all_elim(exdmc.implements, {statics}), exdmc.typed, exdmc.io,
    all_elim(lxp.fn_impl, {statics}), lxp.fn_typed, lxp.fn_io,
    all_elim(exdmc.implements, {statics}), exdmc.typed, exdmc.io,
    all_elim(lxp.xe_impl, {statics}), all_elim(exitc.typed, {c_src_exit__Exit_cfg.__syscall1_fun()}), mp(all_elim(exitc.io, {c_src_exit__Exit_cfg.__syscall1_fun()}), exs1c.io))
qed
