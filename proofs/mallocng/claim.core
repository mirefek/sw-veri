// The top of the proof of `musl_malloc` (docs/overview.md): the claim
// (build/chain/claim.core, `slc claim malloc` of the -O0 binary) from the
// chain.

// ----------------------------------------------------------------------
//  The witnesses: mallocng's invariant and the memory it owns
//  (layers/mallocng.sl), for this binary -- its file and its symbols'
//  addresses (the readable GIMPLE's)

def musl.cfg() := fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(empty,
  "file", musl_malloc.file), "ctx", c_src_malloc_mallocng_malloc.__malloc_context),
  "lock", c_src_malloc_mallocng_malloc.__malloc_lock), "libc", c_src_malloc_mallocng_malloc.__libc),
  "sct", c_src_malloc_mallocng_malloc.__malloc_size_classes), "dbj", c_src_malloc_mallocng_malloc.debruijn32),
  "scnt", c_src_malloc_mallocng_malloc.small_cnt_tab), "mcnt", c_src_malloc_mallocng_malloc.med_cnt_tab)
def musl.inv() := mallocng.inv(musl.cfg)
def musl.owned() := mallocng.owned(musl.cfg)

// the file: a sequence of bytes (each of its bytes evaluated)
theorem musl.bytes_file: all c b. c = bytes_seq(b) -> (all i. i in bytes_len(b) -> bytes_at(b, i) in bits(8)) -> bytes_len(b) in omega ->
  c in list_type(bits(8))
proof
  fix c b
  assume e h hn
  show := rewrite(sym(e), apply(tr.bytes_list, {b}, {bits(8)}, h, hn))
qed

theorem musl.file_list: musl_malloc.file in list_type(bits(8))
proof
  show := mp(apply(musl.bytes_file, unfold(musl_malloc.file)), eval(), eval())
qed

theorem musl.file_bytes: musl_malloc.file in seq_type(bits(8)) && musl_malloc.file in univ(1)
proof
  have s: musl_malloc.file in seq_type(bits(8)) by simp(unsel(expand(musl.file_list, list_type)))
  have u := mp(univ_trans[u := 1, a := musl_malloc.file, b := list_type(bits(8))], mp(mp.list_univ[t := bits(8)], bits_univ[n := 8]), musl.file_list)
  show by taut(s, u)
qed

theorem musl.cfg_ok: musl.cfg in mallocng.Cfg
proof
  show by defs(simp(musl.file_bytes), musl.cfg, mallocng.Cfg)
qed

// ----------------------------------------------------------------------
//  The laws (proofs/mallocng/laws.core)

theorem musl.inv_wf: malloc.inv_wf(musl.inv)
proof
  show by defs(mallocng.law_inv_wf[c := musl.cfg], musl.inv)
qed

theorem musl.owned_private: malloc.owned_private(musl.inv, musl.owned)
proof
  show by defs(mallocng.law_owned_private[c := musl.cfg], musl.inv, musl.owned)
qed

theorem musl.owned_mapped: malloc.owned_mapped(musl.inv, musl.owned)
proof
  show by defs(mallocng.law_owned_mapped[c := musl.cfg], musl.inv, musl.owned)
qed

theorem musl.frame: malloc.frame(musl.inv, musl.owned)
proof
  show by defs(mp(mallocng.law_frame[c := musl.cfg], musl.cfg_ok), musl.inv, musl.owned)
qed

// ----------------------------------------------------------------------
//  Startup (proofs/mallocng/init.core): from process start to `main`, the
//  invariant is established, the allocator owning its static bytes and
//  libc's data on the initial stack

theorem musl.init:
  claim_malloc.init_at_main(musl.inv, musl.owned, musl_malloc.errno_offset, musl_malloc.file, musl_malloc.main_at, musl_malloc.static)
proof
  have e: musl.cfg = ui.C by defs(refl({ui.C}), musl.cfg)
  show by defs(rewrite(sym(e), ui.init_main), musl.inv, musl.owned)
qed

// ----------------------------------------------------------------------
//  malloc and free: their machine code implements their specs
//  (proofs/mallocng/top.core, top_free.core) -- the program as the claim
//  has it loaded: errno's offset, the executable segment (the program
//  text, `text.code`) at its address, the statics

// (the claim's constants of the program: functions of the unit)
theorem musl.unit_app: all f v. f = fn_build(single(empty), x. v) -> app(f, empty) = v
proof
  fix f v
  assume e
  show := rewrite(sym(e), mp(app_fn_build[d := single(empty), v := x. v, a := empty], single_intro[a := empty]))
qed

// errno's offset, the program text and its address as the top theorems
// have them
theorem musl.prog: app(musl_malloc.errno_offset, empty) = 52 && app(musl_malloc.prog_base, empty) = 4198400 &&
  app(musl_malloc.prog_code, empty) = text.code
proof
  have he := apply(musl.unit_app, unfold(musl_malloc.errno_offset))
  have hb := apply(musl.unit_app, unfold(musl_malloc.prog_base))
  have hcd := trans(apply(musl.unit_app, unfold(musl_malloc.prog_code)), sym(unfold(text.code)))
  show by taut(he, hb, hcd)
qed

// a live block: none of the thread's words (errno at 0x34)
theorem musl.live_apart: malloc.live_apart(musl.inv, musl_malloc.errno_offset)
proof
  have he _ _ := musl.prog
  show by defs(mp(mallocng.law_live_apart[c := musl.cfg, eo := musl_malloc.errno_offset], musl.cfg_ok, he), musl.inv)
qed

// the program text: the file's read-only executable segment 1, its pages
// that segment's last
theorem musl.code_img: mp.code_img(musl.cfg, app(musl_malloc.prog_base, empty), app(musl_malloc.prog_code, empty), 1)
proof
  have _ hb hcd := musl.prog
  have cf: musl.cfg.file = musl_malloc.file by simp(unfold(musl.cfg))
  let F := musl_malloc.file
  have {pn = phnum, s1 = s1} := ui.elf
  have _ fl _ va _ ms := expand(s1, ui.segis)
  have {ln = len} := ui.text_bytes
  have nf: !bit(x86_64_linux.segment(F, 1).flags, 1) by defs(simp(fl), bit)
  have pg: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
  have body: all i. i in omega -> int_lt(i, seq_len(text.code)) ->
      (int_le(x86_64_linux.segment(F, 1).vaddr, int_add(4198400, i)) && int_lt(int_add(4198400, i), int_add(x86_64_linux.segment(F, 1).vaddr, x86_64_linux.segment(F, 1).memsz))) &&
      x86_64_linux.last_on_page(F, 1, int_div(int_add(4198400, i), x86_64_linux.PAGE)) && int_lt(int_add(4198400, i), 18446744073709551616) proof
    fix i
    assume hi hil
    have il: int_lt(i, 18292) := rewrite(ln, hil)
    have r: int_le(x86_64_linux.segment(F, 1).vaddr, int_add(4198400, i)) && int_lt(int_add(4198400, i), int_add(x86_64_linux.segment(F, 1).vaddr, x86_64_linux.segment(F, 1).memsz))
      by simp(va, ms, (int_le(4198400, int_add(4198400, i)) && int_lt(int_add(4198400, i), int_add(4198400, 18292)) by arith(hi, il)))
    have qo: int_div(int_add(4198400, i), x86_64_linux.PAGE) in omega by defs(arith(hi), x86_64_linux.PAGE)
    have tb: ui.TAB(1, int_div(int_add(4198400, i), x86_64_linux.PAGE)) by arith(pg, hi, il)
    have lp := mp(all_elim(ui.last_tab, {1}, {int_div(int_add(4198400, i), x86_64_linux.PAGE)}), (1 in omega by simp()), qo, tb)
    show by taut(r, lp, (int_lt(int_add(4198400, i), 18446744073709551616) by arith(hi, il)))
  qed
  have l1 := ui.load1
  have all6 := conj(conj(conj(conj(conj((1 in omega by simp()), (int_lt(1, x86_64_linux.phnum(F)) by simp(pn))), l1), nf), (4198400 in omega by simp())), body)
  show := rewrite(sym(cf), rewrite(sym(hcd), rewrite(sym(hb), all6)))
qed

// freeing a live block leaves a state mallocng's invariant allows
// (proofs/mallocng/free_step.core; the context word-aligned, low)
theorem musl.free_step: malloc.free_step(musl.inv, musl.owned, musl_malloc.errno_offset, musl_malloc.prog_base, musl_malloc.prog_code, musl_malloc.prog_statics)
proof
  have cx: musl.cfg.ctx = 4227328 by simp(unfold(musl.cfg), unfold(c_src_malloc_mallocng_malloc.__malloc_context))
  have HE _ _ := musl.prog
  have t := mp(mallocng.law_free_step[c := musl.cfg, eo := musl_malloc.errno_offset, b := musl_malloc.prog_base, cd := musl_malloc.prog_code, st := musl_malloc.prog_statics, ks := 1], musl.cfg_ok,
    (int_mod(musl.cfg.ctx, 8) = 0 by simp(cx)), (int_lt(musl.cfg.ctx, 4294967296) by simp(cx)), musl.code_img, HE)
  show by defs(t, musl.inv, musl.owned)
qed

theorem musl.impl_malloc:
  abi.implements(malloc.Heap.ghost, musl_malloc.malloc_at,
    malloc.malloc_fun(musl.inv, musl.owned, musl_malloc.errno_offset, musl_malloc.prog_base, musl_malloc.prog_code, musl_malloc.prog_statics))
proof
  have hc: mp.mi_cfg(musl.cfg) by simp(musl.cfg_ok, unfold(musl.cfg))
  have he hb hcd := musl.prog
  have t := mp(all_elim(mp.top_malloc, {musl.cfg}, {app(musl_malloc.prog_statics, empty)}, {musl_malloc.errno_offset}, {musl_malloc.prog_base},
    {musl_malloc.prog_code}, {musl_malloc.prog_statics}), hc, he, hb, hcd, refl({app(musl_malloc.prog_statics, empty)}), musl.code_img)
  show by defs(t, musl.inv, musl.owned, musl_malloc.malloc_at)
qed

theorem musl.impl_free:
  abi.implements(malloc.Heap.ghost, musl_malloc.free_at,
    malloc.free_fun(musl.inv, musl.owned, musl_malloc.errno_offset, musl_malloc.prog_base, musl_malloc.prog_code, musl_malloc.prog_statics))
proof
  have hc: mp.fr_cfg(musl.cfg) by simp(musl.cfg_ok, unfold(musl.cfg))
  have he hb hcd := musl.prog
  have t := mp(all_elim(mp.top_free, {musl.cfg}, {app(musl_malloc.prog_statics, empty)}, {musl_malloc.errno_offset}, {musl_malloc.prog_base},
    {musl_malloc.prog_code}, {musl_malloc.prog_statics}), hc, he, hb, hcd, refl({app(musl_malloc.prog_statics, empty)}), musl.code_img)
  show by defs(t, musl.inv, musl.owned, musl_malloc.free_at)
qed

// ----------------------------------------------------------------------
//  The claim

theorem musl.allocator_correct:
  malloc.allocator_correct(musl.inv, musl.owned, musl_malloc.errno_offset, musl_malloc.prog_base, musl_malloc.prog_code,
                           musl_malloc.prog_statics, musl_malloc.malloc_at, musl_malloc.free_at)
proof
  show by defs(taut(musl.impl_malloc, musl.impl_free), malloc.allocator_correct)
qed

theorem musl.allocator_claim:
  claim_malloc.allocator_claim(musl.inv, musl.owned, musl_malloc.errno_offset, musl_malloc.prog_base, musl_malloc.prog_code,
                               musl_malloc.prog_statics, musl_malloc.file, musl_malloc.main_at, musl_malloc.malloc_at, musl_malloc.free_at,
                               musl_malloc.static)
proof
  show by defs(taut(musl.init, musl.allocator_correct), claim_malloc.allocator_claim)
qed

theorem musl_malloc
proof
  show by ex_intro({musl.inv}, {musl.owned},
    taut(musl.inv_wf, musl.owned_private, musl.owned_mapped, musl.live_apart, musl.frame, musl.free_step, musl.allocator_claim))
qed
