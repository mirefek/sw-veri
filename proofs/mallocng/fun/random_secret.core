// get_random_secret by its purpose (mallocng_specs.random_secret_spec): a
// secret -- the auxiliary vector walked to AT_NULL, AT_RANDOM's 8 bytes
// copied (memcpy) into the stack object, its word returned --, nothing
// else changed but the object's bytes, the stack's free ones after the
// return.

// ----------------------------------------------------------------------
//  memcpy at a call

// (n bytes at s copied to d, the two apart and usable: an overflow, or
// the bytes stored, d returned)
theorem mp.mc_q: all t d s n regs o2. t in abi.World -> t in univ(1) -> d in bits(64) -> s in bits(64) -> n in bits(64) ->
  gimple.usable(t.vm, t.objs, s, n, false) -> gimple.usable(t.vm, t.objs, d, n, true) -> (int_le(int_add(d, n), s) || int_le(int_add(s, n), d)) ->
  gc.regs_ok(regs, seq_concat(seq_concat(seq_one(gimple.arg(64, d)), seq_one(gimple.arg(64, s))), seq_one(gimple.arg(64, n)))) ->
  runs(mallocng_specs.memcpy_spec_fun()[regs], t, o2) ->
  abi.ovf_out(t, o2) ||
  (ex r. o2 = ok(fn_update(t, "vm", fn_update(t.vm, "bytes", x86_64_linux.store_le(t.vm.bytes, d, n, gimple.bytes_at(t.vm, s, n)))), r) && fst(r) = d)
proof
  fix t d s n regs o2
  assume hw htu hd hs hn hus hud hap hro h
  let OVF := exc_val("stack_overflow", empty)
  let ARGS := seq_concat(seq_concat(seq_one(gimple.arg(64, d)), seq_one(gimple.arg(64, s))), seq_one(gimple.arg(64, n)))
  have rl rln _ := hro
  have an: seq_len(ARGS) = 3 by simp()
  have rn: seq_len(regs) = 3 := trans(rln, an)
  have lo: seq_len(regs) in omega by simp(rn)
  have q0 := apply(gc.reg_at[regs := regs, args := ARGS, i := 0, w := 64, x := d], hro, simp(), simp(an), at({ARGS[0]}), simp(), hd)
  have q1 := apply(gc.reg_at[regs := regs, args := ARGS, i := 1, w := 64, x := s], hro, simp(), simp(an), at({ARGS[1]}), simp(), hs)
  have q2 := apply(gc.reg_at[regs := regs, args := ARGS, i := 2, w := 64, x := n], hro, simp(), simp(an), at({ARGS[2]}), simp(), hn)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, mallocng_specs.memcpy_spec_fun, app_fn_build, ra in h
  have o3l: ord_le(3, seq_len(regs)) by defs(simp(rn), ord_le)
  have b := rewrite(q2, rewrite(q1, rewrite(q0, apply(g.runs_elim, h))))
  have b2: bind_rel(mallocng_specs.memcpy_spec(d, s, n), t, x0 x1. letin(x1, x2. bind_rel(gimple.result(64, x2), x0, x3 x4. any_rel(x5. x5 in bits(64), x5. o2 = ok(x3, pair(x4, x5))),
      x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3))), x0 x1. o2 = exc(x0, x1), x0. o2 = diverge(x0)) by taut(b, o3l)
  obtain o3, hs3 hk3 from expand(b2, bind_rel)
  rsimp only, mallocng_specs.memcpy_spec in hs3
  obtain x0, hbr hout from apply(or_resolve, apply(g.runs_elim, hs3), (gimple.usable(t.vm, t.objs, s, n, false) && gimple.usable(t.vm, t.objs, d, n, true) &&
    (int_le(int_add(d, n), s) || int_le(int_add(s, n), d)) by taut(hus, hud, hap)))
  let T2 := fn_update(t, "vm", fn_update(t.vm, "bytes", x86_64_linux.store_le(t.vm.bytes, d, n, gimple.bytes_at(t.vm, s, n))))
  let G := abi.ovf_out(t, o2) || (ex r. o2 = ok(T2, r) && fst(r) = d)
  have k1: case 1 of hbr proof
    assume e
    rsimp only, abi.overflow in e
    have pv _ _ _ := apply(ms.world_parts, hw)
    have vv: ex x. x in x86_64_linux.Vm by ex_intro({t.vm}, simp(pv))
    have l: ex v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && x0 = exc(pair(fn_update(fn_update(t, "vm", v), "objs", ob), empty), pair("raise", OVF)) by simp(e, vv, ct.objs_ne)
    obtain v ob, hv hob hx from l
    have oe: o3 = exc(fn_update(fn_update(t, "vm", v), "objs", ob), OVF) by simp(rewrite(hx, hout))
    have o2e: o2 = exc(fn_update(fn_update(t, "vm", v), "objs", ob), OVF) by simp(rewrite(oe, hk3))
    have x: abi.ovf_out(t, o2) by ex_intro({v}, {ob}, taut(hv, hob, o2e))
    show by taut(x)
  qed
  have k2: case 2 of hbr proof
    assume e
    have e2: x0 = exc(pair(T2, empty), pair("ret", d)) by simp(expand(e, letin))
    have oe: o3 = ok(T2, d) by simp(rewrite(e2, hout))
    have k4: bind_rel(gimple.result(64, d), T2, x3 x4. any_rel(x5. x5 in bits(64), x5. o2 = ok(x3, pair(x4, x5))), x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3))
      by simp(expand(rewrite(oe, hk3), letin), keep(bind_rel, gimple.result))
    obtain o4, hr4 hk4 from expand(k4, bind_rel)
    have ho4 := apply(g.result64_inv, hd, hr4)
    have k5: any_rel(x5. x5 in bits(64), x5. o2 = ok(T2, pair(d, x5))) by simp(expand(rewrite(ho4, hk4), letin), keep(any_rel))
    obtain z, hz hoz from apply(g.any_e, (ex z. z in bits(64) by ex_intro({0}, simp())), k5)
    have x: ex r. o2 = ok(T2, r) && fst(r) = d by ex_intro({pair(d, z)}, taut(hoz, (fst(pair(d, z)) = d by simp())))
    show by taut(x)
  qed
  show by taut(hbr, k1, k2)
qed

// ----------------------------------------------------------------------
//  The stack object

// (the live objects with the one at l[0])
abbrev mp.live1(v, l) := set_select(omega, x7. x7 in v || (ex x8. x8 in omega && ((int_lt(x8, seq_len(seq_one(pair(8, 8)))) && int_le(app(l, x8), x7)) &&
  int_lt(x7, int_add(app(l, x8), fst(app(seq_one(pair(8, 8)), x8)))))))

// (one object of 8 bytes allocated: no room, an overflow; or at l[0],
// placed as objs_fit has it, its bytes any)
theorem mp.alloc1_inv: all w o. w in abi.World -> runs(gimple.alloc_objs(seq_one(pair(8, 8))), w, o) ->
  abi.ovf_out(w, o) ||
  (ex l V. ((l in list_type(bits(64)) && gimple.objs_fit(w.vm, w.objs, seq_one(pair(8, 8)), l)) &&
     (V in x86_64_linux.Vm && fn_update(V, "bytes", w.vm.bytes) = w.vm &&
      (all x. x in bits(64) -> !(int_le(l[0], x) && int_lt(x, int_add(l[0], 8))) -> V.bytes[x] = w.vm.bytes[x]))) &&
     o = ok(fn_update(fn_update(w, "vm", V), "objs", fn_update(w.objs, "live", mp.live1(w.objs.live, l))), l))
proof
  fix w o
  assume hw h
  let SZ := seq_one(pair(8, 8))
  let OVF := exc_val("stack_overflow", empty)
  have b := apply(g.runs_elim, expand(h, gimple.alloc_objs))
  obtain x0, hg ht from b
  let FIT := ex x1. x1 in list_type(bits(64)) && gimple.objs_fit(w.vm, w.objs, SZ, x1)
  have pv pf pd _ := apply(ms.world_parts, hw)
  have ws: fn_update(w, "vm", w.vm) = w := mp(fn_update_same[f := w, k := "vm"], pf, pd)
  have wo: fn_update(fn_update(w, "vm", w.vm), "objs", w.objs) = w := trans(apply(gc.vm_objs, {w}, {w.vm}, hw), ws)
  have oo: w.objs in abi.Objs by simp(expand(hw, abi.World))
  // (no room: the overflow, the world as it was)
  have c1: !FIT -> abi.ovf_out(w, o) proof
    assume nf
    have e: x0 = exc(pair(w, empty), pair("raise", OVF)) by taut(hg, nf)
    have oe: o = exc(w, OVF) by simp(rewrite(e, ht))
    show by ex_intro({w.vm}, {w.objs}, taut(pv, oo, subst({y. o = exc(y, OVF)}, sym(wo), oe)))
  qed
  // (room: the object's place and bytes)
  let PV(l, V) := V in x86_64_linux.Vm && (fn_update(V, "bytes", w.vm.bytes) = w.vm && (all x5. x5 in bits(64) -> (all x6. x6 in omega -> int_lt(x6, seq_len(SZ)) ->
    !(int_le(l[x6], x5) && int_lt(x5, int_add(l[x6], fst(SZ[x6]))))) -> V.bytes[x5] = w.vm.bytes[x5]))
  have c2: FIT -> ex l V. ((l in list_type(bits(64)) && gimple.objs_fit(w.vm, w.objs, SZ, l)) &&
      (V in x86_64_linux.Vm && fn_update(V, "bytes", w.vm.bytes) = w.vm &&
       (all x. x in bits(64) -> !(int_le(l[0], x) && int_lt(x, int_add(l[0], 8))) -> V.bytes[x] = w.vm.bytes[x]))) &&
      o = ok(fn_update(fn_update(w, "vm", V), "objs", fn_update(w.objs, "live", mp.live1(w.objs.live, l))), l) proof
    assume f
    have e: x0 = ok(pair(w, empty), empty) by taut(hg, f)
    have t1 := rewrite(e, ht)
    have f0: fst(ok(pair(w, empty), empty)) = 0 by simp()
    have f1: fst(out_state(ok(pair(w, empty), empty))) = w by simp()
    have t2 := rewrite(f1, rewrite(f0, t1))
    have a0: any_rel(x1. x1 in list_type(bits(64)) && gimple.objs_fit(w.vm, w.objs, SZ, x1), x1. letin(x1, x2. letin(w.vm, x3. any_rel(x4. x4 in x86_64_linux.Vm &&
        (fn_update(fn_update(w, "vm", x4).vm, "bytes", x3.bytes) = x3 && (all x5. x5 in bits(64) -> (all x6. x6 in omega -> int_lt(x6, seq_len(SZ)) ->
          !(int_le(x2[x6], x5) && int_lt(x5, int_add(x2[x6], fst(SZ[x6]))))) -> fn_update(w, "vm", x4).vm.bytes[x5] = x3.bytes[x5])),
        x4. letin(fn_update(w, "vm", x4), x5. letin(fn_update(x5, "objs", fn_update(x5.objs, "live", set_select(omega, x6. x6 in x5.objs.live ||
          (ex x7. x7 in omega && ((int_lt(x7, seq_len(SZ)) && int_le(x2[x7], x6)) && int_lt(x6, int_add(x2[x7], fst(SZ[x7])))))))), x6. o = ok(x6, x2)))))))
      by taut(t2, refl({0}), (!(0 = 1) by simp()), (!(0 = 2) by simp()))
    obtain l, hl1 hl2 hk from apply(g.any_e, f, a0)
    have hl: l in list_type(bits(64)) && gimple.objs_fit(w.vm, w.objs, SZ, l) by taut(hl1, hl2)
    have vb: fn_update(w.vm, "bytes", w.vm.bytes) = w.vm := mp(fn_update_same[f := w.vm, k := "bytes"], (is_fun(w.vm) by simp(expand(pv, x86_64_linux.Vm))), ("bytes" in dom(w.vm) by simp(expand(pv, x86_64_linux.Vm))))
    have vx: ex V. PV(l, V) by ex_intro({w.vm}, simp(pv, vb))
    have k2: any_rel(x4. PV(l, x4), x4. o = ok(fn_update(fn_update(w, "vm", x4), "objs", fn_update(w.objs, "live", mp.live1(w.objs.live, l))), l))
      by simp(expand(hk, letin), keep(any_rel))
    obtain V, v1 v23 hoV from apply(g.any_e, vx, k2)
    have v2 v3 := v23
    have v3b: all x. x in bits(64) -> !(int_le(l[0], x) && int_lt(x, int_add(l[0], 8))) -> V.bytes[x] = w.vm.bytes[x] proof
      fix x
      assume hx hn
      have q: all x6. x6 in omega -> int_lt(x6, seq_len(SZ)) -> !(int_le(l[x6], x) && int_lt(x, int_add(l[x6], fst(SZ[x6])))) proof
        fix k
        assume k1 k2
        have k0: k = 0 by arith(k1, (int_lt(k, 1) by simp(k2)))
        show by simp(k0, hn)
      qed
      show := mp(all_elim(v3, {x}), hx, q)
    qed
    show by ex_intro({l}, {V}, taut(hl, v1, v2, v3b, hoV))
  qed
  show by taut(c1, c2)
qed

// (the one object's place: aligned, not null, in range, of free bytes)
theorem mp.fit1(vm, objs, l): gimple.objs_fit(vm, objs, seq_one(pair(8, 8)), l) ->
  seq_len(l) = 1 && int_mod(l[0], 8) = 0 && !(l[0] = 0) && int_le(int_add(l[0], 8), int_pow(2, 64)) &&
  (all a. a in omega -> int_le(l[0], a) && int_lt(a, int_add(l[0], 8)) -> abi.stack_free(vm, objs, a))
proof
  assume h
  have hl hk _ := expand(h, gimple.objs_fit)
  have m nz le sf := mp(all_elim(hk, {0}), simp(), (int_lt(0, seq_len(seq_one(pair(8, 8)))) by simp()))
  have l1: seq_len(l) = 1 by simp(hl)
  have m8: int_mod(l[0], 8) = 0 by simp(m)
  have l8: int_le(int_add(l[0], 8), int_pow(2, 64)) by simp(le)
  have sf2: all a. a in omega -> int_le(l[0], a) && int_lt(a, int_add(l[0], 8)) -> abi.stack_free(vm, objs, a) proof
    fix a
    assume ha hr
    show := mp(all_elim(sf, {a}), ha, (int_le(app(l, 0), a) && int_lt(a, int_add(app(l, 0), fst(app(seq_one(pair(8, 8)), 0)))) by simp(hr)))
  qed
  show by taut(l1, m8, nz, l8, sf2)
qed

// (the object's bytes, live, usable -- on none of the world's pages)
theorem mp.obj_usable(vm, objs, V, l, w): gimple.objs_fit(vm, objs, seq_one(pair(8, 8)), l) -> l[0] in omega -> V.pages = vm.pages ->
  gimple.usable(V, fn_update(objs, "live", mp.live1(objs.live, l)), l[0], 8, w)
proof
  assume hf ho hp
  have l1 m8 nz l8 sf := apply(mp.fit1[vm := vm, objs := objs, l := l], hf)
  let O := fn_update(objs, "live", mp.live1(objs.live, l))
  let P(i) := int_div(int_add(l[0], i), x86_64_linux.PAGE)
  let C(i) := x86_64_linux.mapped(V, P(i)) && !(snd(V.pages[P(i)]).kind = 2)
  have g: all i. i in omega -> int_lt(i, 8) -> ite(C(i), ite(w, snd(V.pages[P(i)]).prot.w, snd(V.pages[P(i)]).prot.r) && int_add(l[0], i) in O.c_bytes,
      int_lt(int_add(l[0], i), int_pow(2, 64)) && int_add(l[0], i) in O.live) proof
    fix i
    assume hi hil
    have s1 := mp(all_elim(sf, {int_add(l[0], i)}), arith(ho, hi), arith(ho, hi, hil))
    have s2 := rewrite(sym(hp), expand(s1, abi.stack_free, x86_64_linux.mapped))
    have nc: !C(i) by defs(taut(s2), x86_64_linux.mapped)
    have lt: int_lt(int_add(l[0], i), int_pow(2, 64)) by arith(l8, hil, ho, hi)
    have ek: ex x8. x8 in omega && ((int_lt(x8, seq_len(seq_one(pair(8, 8)))) && int_le(app(l, x8), int_add(l[0], i))) &&
        int_lt(int_add(l[0], i), int_add(app(l, x8), fst(app(seq_one(pair(8, 8)), x8))))) by ex_intro({0},
          simp((int_le(l[0], int_add(l[0], i)) by arith(ho, hi)), (int_lt(int_add(l[0], i), int_add(l[0], 8)) by arith(ho, hil))))
    have il0: int_add(l[0], i) in mp.live1(objs.live, l) by sel(taut((int_add(l[0], i) in omega by arith(ho, hi)), ek))
    have il: int_add(l[0], i) in O.live by simp(il0)
    show := rewrite(sym(mp(ite_f[c := C(i), a := ite(w, snd(V.pages[P(i)]).prot.w, snd(V.pages[P(i)]).prot.r) && int_add(l[0], i) in O.c_bytes,
      b := int_lt(int_add(l[0], i), int_pow(2, 64)) && int_add(l[0], i) in O.live], nc)),
      (int_lt(int_add(l[0], i), int_pow(2, 64)) && int_add(l[0], i) in O.live by taut(lt, il)))
  qed
  show by defs(g, gimple.usable)
qed

// (the world with the object: a world)
theorem mp.w1_world(s, V, l): s in abi.World -> s in univ(1) -> V in x86_64_linux.Vm ->
  fn_update(fn_update(s, "vm", V), "objs", fn_update(s.objs, "live", mp.live1(s.objs.live, l))) in abi.World &&
  fn_update(fn_update(s, "vm", V), "objs", fn_update(s.objs, "live", mp.live1(s.objs.live, l))) in univ(1)
proof
  assume hw hu hv
  let L := mp.live1(s.objs.live, l)
  have vu := apply(x86.vm_univ, hv)
  have ss: subset(L, omega) proof
    have g: all z. z in L -> z in omega proof
      fix z
      assume hz
      have d := set_select_def[s := omega, p := x7. x7 in s.objs.live || (ex x8. x8 in omega && ((int_lt(x8, seq_len(seq_one(pair(8, 8)))) && int_le(app(l, x8), x7)) &&
        int_lt(x7, int_add(app(l, x8), fst(app(seq_one(pair(8, 8)), x8)))))), z := z]
      show by taut(d, hz)
    qed
    show by defs(g, subset)
  qed
  have lu := mp(univ_subset[u := 1, a := L, b := omega], omega_univ, ss)
  have lt: L in set_type(omega) by defs(taut(ss, powerset_def[s := omega, a := L]), set_type)
  have wou := mp(app_univ[u := 1, f := s, k := "objs"], hu)
  have ou: fn_update(s.objs, "live", L) in univ(1) by simp(wou, lu)
  have wW: fn_update(fn_update(s, "vm", V), "objs", fn_update(s.objs, "live", L)) in abi.World by defs(simp(expand(hw, abi.World), hu, hv, vu, ss, lu, lt), abi.World)
  show by taut(wW, (fn_update(fn_update(s, "vm", V), "objs", fn_update(s.objs, "live", L)) in univ(1) by simp(hu, vu, ou)))
qed

// ----------------------------------------------------------------------
//  Memory kept but the stack's free bytes (mp.rs_vm)

// (usable bytes: none of the stack's free ones)
theorem mp.nofree(vm, objs, a, n, w, i): gimple.usable(vm, objs, a, n, w) -> i in omega -> int_lt(i, n) -> !abi.stack_free(vm, objs, int_add(a, i))
proof
  assume hu hi hn
  have ui := mp(all_elim(expand(hu, gimple.usable), {i}), hi, hn)
  let P := int_div(int_add(a, i), x86_64_linux.PAGE)
  let C := x86_64_linux.mapped(vm, P) && !(snd(vm.pages[P]).kind = 2)
  have c2: !C -> int_add(a, i) in objs.live proof
    assume hc
    have y := rewrite(mp(ite_f[c := C, a := ite(w, snd(vm.pages[P]).prot.w, snd(vm.pages[P]).prot.r) && int_add(a, i) in objs.c_bytes,
      b := int_lt(int_add(a, i), int_pow(2, 64)) && int_add(a, i) in objs.live], hc), ui)
    show by taut(y)
  qed
  show by defs(taut(c2), abi.stack_free)
qed

// (more live objects: still usable)
theorem mp.usable_live(vm, objs, L, a, n, w): gimple.usable(vm, objs, a, n, w) -> (all x. x in objs.live -> x in L) ->
  gimple.usable(vm, fn_update(objs, "live", L), a, n, w)
proof
  assume hu hl
  let O := fn_update(objs, "live", L)
  let P(i) := int_div(int_add(a, i), x86_64_linux.PAGE)
  let C(i) := x86_64_linux.mapped(vm, P(i)) && !(snd(vm.pages[P(i)]).kind = 2)
  let X(i, ob) := ite(w, snd(vm.pages[P(i)]).prot.w, snd(vm.pages[P(i)]).prot.r) && int_add(a, i) in ob.c_bytes
  let Y(i, ob) := int_lt(int_add(a, i), int_pow(2, 64)) && int_add(a, i) in ob.live
  have g: all i. i in omega -> int_lt(i, n) -> ite(C(i), X(i, O), Y(i, O)) proof
    fix i
    assume hi hn
    have ui := mp(all_elim(expand(hu, gimple.usable), {i}), hi, hn)
    have c1: C(i) -> ite(C(i), X(i, O), Y(i, O)) proof
      assume hc
      have x0 := rewrite(mp(ite_t[c := C(i), a := X(i, objs), b := Y(i, objs)], hc), ui)
      have x1: X(i, O) by simp(x0)
      show := rewrite(sym(mp(ite_t[c := C(i), a := X(i, O), b := Y(i, O)], hc)), x1)
    qed
    have c2: !C(i) -> ite(C(i), X(i, O), Y(i, O)) proof
      assume hc
      have y0 := rewrite(mp(ite_f[c := C(i), a := X(i, objs), b := Y(i, objs)], hc), ui)
      have y1 y2 := y0
      have y3: int_add(a, i) in O.live by simp(mp(all_elim(hl, {int_add(a, i)}), y2))
      show := rewrite(sym(mp(ite_f[c := C(i), a := X(i, O), b := Y(i, O)], hc)), (Y(i, O) by taut(y1, y3)))
    qed
    show by taut(c1, c2)
  qed
  show by defs(g, gimple.usable)
qed

// (n bytes the same: read the same)
theorem mp.bytes_same(U, vm, a, n): n in omega ->
  (all i. i in omega -> int_lt(i, n) -> U.bytes[bits_add(64, a, bits_of_int(64, i))] = vm.bytes[bits_add(64, a, bits_of_int(64, i))]) ->
  gimple.bytes_at(U, a, n) = gimple.bytes_at(vm, a, n)
proof
  assume hn he
  have pe: all i. i in omega -> int_le(0, i) -> int_lt(i, n) ->
      int_mul(U.bytes[bits_add(64, a, bits_of_int(64, i))], int_pow(256, i)) = int_mul(vm.bytes[bits_add(64, a, bits_of_int(64, i))], int_pow(256, i)) proof
    fix i
    assume hi _ hil
    show by simp(mp(all_elim(he, {i}), hi, hil))
  qed
  have e := mp(int_sum_ext[a := 0, b := n, f := i. int_mul(U.bytes[bits_add(64, a, bits_of_int(64, i))], int_pow(256, i)),
    g := i. int_mul(vm.bytes[bits_add(64, a, bits_of_int(64, i))], int_pow(256, i))], simp(), hn, pe)
  show by defs(e, gimple.bytes_at)
qed

// (a word's value: itself)
theorem mp.boi(x): x in omega -> int_lt(x, 18446744073709551616) -> bits_of_int(64, x) = x
proof
  assume h1 h2
  show by defs(arith(h1, h2), bits_of_int, pow2)
qed

// (an address 8 on, below 2^64: no wrap)
theorem mp.badd8(x): x in omega -> int_lt(int_add(x, 8), 18446744073709551616) -> bits_add(64, x, 8) = int_add(x, 8)
proof
  assume h1 h2
  show by defs(arith(h1, h2), bits_add, bits_of_int, pow2)
qed

// (a usable byte: below 2^64)
theorem mp.usable_lt(vm, objs, a, n, w, i): gimple.usable(vm, objs, a, n, w) -> a in omega -> i in omega -> int_lt(i, n) -> int_lt(int_add(a, i), int_pow(2, 64))
proof
  assume hu ha hi hn
  have ui := mp(all_elim(expand(hu, gimple.usable), {i}), hi, hn)
  let P := int_div(int_add(a, i), x86_64_linux.PAGE)
  let C := x86_64_linux.mapped(vm, P) && !(snd(vm.pages[P]).kind = 2)
  let X := ite(w, snd(vm.pages[P]).prot.w, snd(vm.pages[P]).prot.r) && int_add(a, i) in objs.c_bytes
  let Y := int_lt(int_add(a, i), int_pow(2, 64)) && int_add(a, i) in objs.live
  have c1: C -> int_lt(int_add(a, i), int_pow(2, 64)) proof
    assume hc
    have m _ := hc
    have ml _ := expand(m, x86_64_linux.mapped)
    show by arith(expand(ml, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE), ha, hi)
  qed
  have c2: !C -> int_lt(int_add(a, i), int_pow(2, 64)) proof
    assume hc
    have y := rewrite(mp(ite_f[c := C, a := X, b := Y], hc), ui)
    show by taut(y)
  qed
  show by taut(c1, c2)
qed

// (read where it was usable: as at the entry)
theorem mp.rs_read(s, U, a, n, w): mp.rs_vm(s, U) -> gimple.usable(s.vm, s.objs, a, n, w) -> a in omega -> n in omega ->
  gimple.bytes_at(U, a, n) = gimple.bytes_at(s.vm, a, n)
proof
  assume hr hu ha hn
  have er eb0 := hr
  have pe: all i. i in omega -> int_lt(i, n) -> U.bytes[bits_add(64, a, bits_of_int(64, i))] = s.vm.bytes[bits_add(64, a, bits_of_int(64, i))] proof
    fix i
    assume hi hil
    have nf := apply(mp.nofree[vm := s.vm, objs := s.objs, a := a, n := n, w := w, i := i], hu, hi, hil)
    have lt := apply(mp.usable_lt[vm := s.vm, objs := s.objs, a := a, n := n, w := w, i := i], hu, ha, hi, hil)
    have ea: bits_add(64, a, bits_of_int(64, i)) = int_add(a, i) by defs(arith(ha, hi, lt), bits_add, bits_of_int, pow2)
    have ab: int_add(a, i) in bits(64) by arith(ha, hi, lt)
    show := rewrite(sym(ea), mp(all_elim(eb0, {int_add(a, i)}), ab, nf))
  qed
  show := apply(mp.bytes_same[U := U, vm := s.vm, a := a, n := n], hn, pe)
qed

// (the object's 8 bytes stored, at A -- free bytes at the entry: still
// the entry's memory but the free bytes)
theorem mp.rs_obj(s, U, A, X): mp.rs_vm(s, U) -> A in bits(64) -> int_le(int_add(A, 8), int_pow(2, 64)) ->
  (all a. a in omega -> int_le(A, a) && int_lt(a, int_add(A, 8)) -> abi.stack_free(s.vm, s.objs, a)) ->
  mp.rs_vm(s, fn_update(U, "bytes", x86_64_linux.store_le(U.bytes, A, 8, X)))
proof
  assume hr ha hl8 hf
  have er eb0 := hr
  have e1: fn_update(fn_update(U, "bytes", x86_64_linux.store_le(U.bytes, A, 8, X)), "bytes", s.vm.bytes) = s.vm :=
    trans(fn_update_twice[f := U, k := "bytes", a := x86_64_linux.store_le(U.bytes, A, 8, X), b := s.vm.bytes], er)
  have e2: all x. x in bits(64) -> !abi.stack_free(s.vm, s.objs, x) -> fn_update(U, "bytes", x86_64_linux.store_le(U.bytes, A, 8, X)).bytes[x] = s.vm.bytes[x] proof
    fix x
    assume hx hn
    have ne: all j. j in omega -> int_lt(j, 8) -> !(x = bits_add(64, A, bits_of_int(64, j))) proof
      fix j
      assume j1 j2
      assume ex
      have xo: x in omega by simp(hx)
      have c: int_le(A, x) && int_lt(x, int_add(A, 8)) -> false proof
        assume r
        show by taut(hn, mp(all_elim(hf, {x}), xo, r))
      qed
      have xa: x = int_add(A, j) by defs(arith(ex, ha, j1, j2, hl8), bits_add, bits_of_int, pow2)
      show := mp(c, (int_le(A, x) && int_lt(x, int_add(A, 8)) by arith(xa, j1, j2, ha)))
    qed
    have so := apply(tr.storen_other, {U.bytes}, {A}, {8}, {X}, {x}, hx, ne)
    show by simp(so, mp(all_elim(eb0, {x}), hx, hn))
  qed
  show by taut(e1, e2)
qed

// (the thread sound: its word none of the stack's free bytes)
theorem mp.rs_thread(t, V): t.fs_base in bits(64) -> abi.thread_ok(t.vm, t.fs_base) -> mp.rs_vm(t, V) -> abi.thread_ok(V, t.fs_base)
proof
  assume hfb ht hr
  let fs := t.fs_base
  let V0 := t.vm
  have er eb0 := hr
  have up := mp(app_update_other[f := V, k := "bytes", v := V0.bytes, x := "pages"], (!("pages" = "bytes") by simp()))
  have vp: V.pages = V0.pages := sym(rewrite(er, up))
  have r0 ns0 le0 nz0 := expand(ht, abi.thread_ok)
  have ts: int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE) = 34359738367 by defs(simp(), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
  have pg: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
  have same: all i. i in omega -> int_lt(i, 8) -> V.bytes[bits_of_int(64, int_add(fs, i))] = V0.bytes[bits_of_int(64, int_add(fs, i))] &&
      V.pages[int_div(int_add(fs, i), x86_64_linux.PAGE)] = V0.pages[int_div(int_add(fs, i), x86_64_linux.PAGE)] proof
    fix i
    assume hi hil
    have mp1 _ := mp(all_elim(expand(r0, x86_64_linux.readable), {i}), hi, hil)
    have ml _ := expand(mp1, x86_64_linux.mapped)
    have ns := mp(all_elim(ns0, {i}), hi, hil)
    have nfr: !abi.stack_free(V0, t.objs, int_add(fs, i)) by defs(taut(expand(ns, abi.stack_page), mp1), abi.stack_free)
    have ea: bits_of_int(64, int_add(fs, i)) = int_add(fs, i) by defs(arith(hfb, hi, hil, ml, ts, pg), bits_of_int, pow2)
    have bt := mp(all_elim(eb0, {bits_of_int(64, int_add(fs, i))}), simp(), rewrite(sym(ea), nfr))
    show by taut(bt, (V.pages[int_div(int_add(fs, i), x86_64_linux.PAGE)] = V0.pages[int_div(int_add(fs, i), x86_64_linux.PAGE)] by simp(vp)))
  qed
  have r1: all x0. x0 in omega -> int_lt(x0, 8) -> x86_64_linux.mapped(V, int_div(int_add(fs, x0), x86_64_linux.PAGE)) &&
      snd(V.pages[int_div(int_add(fs, x0), x86_64_linux.PAGE)]).prot.r proof
    fix i
    assume hi hil
    have m0 p0 := mp(all_elim(expand(r0, x86_64_linux.readable), {i}), hi, hil)
    have _ ep := mp(all_elim(same, {i}), hi, hil)
    have m1: x86_64_linux.mapped(V, int_div(int_add(fs, i), x86_64_linux.PAGE)) by defs(rewrite(sym(ep), expand(m0, x86_64_linux.mapped)), x86_64_linux.mapped)
    show by taut(m1, rewrite(sym(ep), p0))
  qed
  have ns1: all x0. x0 in omega -> int_lt(x0, 8) -> !abi.stack_page(V, int_div(int_add(fs, x0), x86_64_linux.PAGE)) proof
    fix i
    assume hi hil
    have n0 := mp(all_elim(ns0, {i}), hi, hil)
    have _ ep := mp(all_elim(same, {i}), hi, hil)
    show by defs(rewrite(sym(ep), expand(n0, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
  qed
  have eb: all i. i in omega -> int_le(0, i) -> int_lt(i, 8) ->
      int_mul(V.bytes[bits_add(64, fs, bits_of_int(64, i))], int_pow(256, i)) = int_mul(V0.bytes[bits_add(64, fs, bits_of_int(64, i))], int_pow(256, i)) proof
    fix i
    assume hi _ hil
    have m0 _ := mp(all_elim(expand(r0, x86_64_linux.readable), {i}), hi, hil)
    have ml _ := expand(m0, x86_64_linux.mapped)
    have ea: bits_add(64, fs, bits_of_int(64, i)) = bits_of_int(64, int_add(fs, i)) by defs(arith(hfb, hi, hil, ml, ts, pg), bits_add, bits_of_int, pow2)
    have b1 _ := mp(all_elim(same, {i}), hi, hil)
    show by simp(ea, b1)
  qed
  have sx := mp(int_sum_ext[a := 0, b := 8, f := i. int_mul(V.bytes[bits_add(64, fs, bits_of_int(64, i))], int_pow(256, i)),
    g := i. int_mul(V0.bytes[bits_add(64, fs, bits_of_int(64, i))], int_pow(256, i))], simp(), simp(), eb)
  have l1: x86_64_linux.le(V.bytes, fs, 8) = fs by defs(simp(sx, expand(le0, x86_64_linux.le)), x86_64_linux.le)
  show by defs(taut(r1, ns1, l1, nz0), abi.thread_ok, x86_64_linux.readable)
qed

// (the world with the object, memory v and objects ob: the entry's with them)
theorem mp.w2_norm: all s V L v ob. fn_update(fn_update(fn_update(fn_update(s, "vm", V), "objs", fn_update(s.objs, "live", L)), "vm", v), "objs", ob) =
  fn_update(fn_update(s, "vm", v), "objs", ob)
proof
  fix s V L v ob
  let O := fn_update(s.objs, "live", L)
  have sw := mp(fn_update_swap[f := fn_update(s, "vm", V), k := "objs", a := O, j := "vm", b := v], (!("objs" = "vm") by simp()))
  have t1 := fn_update_twice[f := s, k := "vm", a := V, b := v]
  have t2 := fn_update_twice[f := fn_update(fn_update(s, "vm", V), "vm", v), k := "objs", a := O, b := ob]
  have e1 := subst({y. fn_update(y, "objs", ob) = fn_update(fn_update(fn_update(fn_update(s, "vm", V), "vm", v), "objs", O), "objs", ob)}, sym(sw),
    refl({fn_update(fn_update(fn_update(fn_update(s, "vm", V), "vm", v), "objs", O), "objs", ob)}))
  have e2 := subst({y. fn_update(fn_update(fn_update(s, "vm", V), "vm", v), "objs", ob) = fn_update(y, "objs", ob)}, t1, refl({fn_update(fn_update(fn_update(s, "vm", V), "vm", v), "objs", ob)}))
  show := trans(e1, trans(t2, e2))
qed

// ----------------------------------------------------------------------
//  get_random_secret's run

// (its outcomes: an overflow -- at the allocation, the world as it was;
// later, the records as they were --, or a word returned, the memory as
// it was but the stack's free bytes, the object live)
abbrev mp.grs_out(s, o) := abi.ovf_out(s, o) ||
  (ex V L r. (V in x86_64_linux.Vm && mp.rs_vm(s, V)) && r in bits(64) && o = ok(fn_update(fn_update(s, "vm", V), "objs", fn_update(s.objs, "live", L)), r))

theorem mp.grs_run(G, s, o): mp.calls(G, mallocng_specs.memcpy_spec_fun()) -> s in abi.World ->
  mallocng_specs.auxv_ok(s.vm, s.objs, c_src_malloc_mallocng_malloc.__libc) -> abi.thread_ok(s.vm, s.fs_base) ->
  runs(c_src_malloc_mallocng_malloc.get_random_secret(G), s, o) -> mp.grs_out(s, o)
proof
  assume hg hw hax hth hr
  have hu: s in univ(1) by simp(apply(g.runs_univ, expand(hr, c_src_malloc_mallocng_malloc.get_random_secret)))
  step i0 t0 oa l V, e hA from hr with mp.alloc1_inv using hw
  // the object at l[0]: off the world's pages, live, its first word stored
  have hl hfit hV1 hV2 hV3 := hA
  have l1 m8 nz l8 sf := apply(mp.fit1[vm := s.vm, objs := s.objs, l := l], hfit)
  have lb := apply(at_type[l := l, t := bits(64), i := 0], hl, simp(), (int_lt(0, seq_len(l)) by simp(l1)))
  have up := mp(app_update_other[f := V, k := "bytes", v := s.vm.bytes, x := "pages"], (!("pages" = "bytes") by simp()))
  have vp: V.pages = s.vm.pages := sym(rewrite(hV2, up))
  have ou := apply(mp.obj_usable[vm := s.vm, objs := s.objs, V := V, l := l, w := true], hfit, (l[0] in omega by simp(lb)), vp)
  have w1W w1u := apply(mp.w1_world[s := s, V := V, l := l], hw, hu, hV1)
  let S1 := fn_update(fn_update(s, "vm", V), "objs", fn_update(s.objs, "live", mp.live1(s.objs.live, l)))
  have _ wpr wpd _ := apply(ms.world_parts, w1W)
  have z0: int_add(l[0], 0) = l[0] by arith(lb)
  have md: g.mem_defined(S1, l[0], 0, 8, true) by simp(z0, nz, ou, (int_lt(int_add(l[0], 0), pow2(64)) by defs(arith(l8, lb), pow2)))
  have sd := apply(g.st64_det, {S1}, {l[0]}, {0}, {bits_mul(64, l[0], 1103515245)}, w1u, lb, simp(), md, (S1.vm in x86_64_linux.Vm by simp(hV1)), wpr, wpd)
  obtain x2, hs2 hk2 from e
  have ex2 := mp(all_elim(expand(sd, g.det), {x2}), hs2)
  step e3 from rewrite(ex2, hk2)
  obtain r, wl kr from e3
  let BODY(x, y) := loop_body(wl)
  // the vector: AX, its pairs at AV + 16 k
  have ua anz ax := expand(hax, mallocng_specs.auxv_ok)
  obtain AX, axt ax1 from ax
  have axl axk axe axn := ax1
  have axo: seq_len(AX) in omega by arith(axt)
  // a trip from k pairs passed, the memory U (the entry's, but the
  // stack's free bytes)
  let W(U) := fn_update(S1, "vm", U)
  let P(x) := ex k U. (k in omega && int_lt(k, seq_len(AX))) && (U in x86_64_linux.Vm && mp.rs_vm(s, U)) && x = pair(W(U), pair(int_mul(2, k), t0))
  // (a trip: the break at AT_NULL, the next pair -- the random bytes
  // copied at AT_RANDOM --, or an overflow)
  let G3(k, U, y) := (fst(AX[k]) = 0 && y = exc(pair(W(U), pair(int_mul(2, k), t0)), pair("brk", empty))) ||
    (int_lt(int_add(k, 1), seq_len(AX)) && (ex U2. (U2 in x86_64_linux.Vm && mp.rs_vm(s, U2)) && y = ok(pair(W(U2), pair(bits_add(64, int_mul(2, k), 2), t0)), empty))) ||
    (ex v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && y = exc(pair(fn_update(W(v), "objs", ob), pair(int_mul(2, k), t0)), pair("raise", exc_val("stack_overflow", empty))))
  have trip: all k U y. k in omega -> int_lt(k, seq_len(AX)) -> U in x86_64_linux.Vm -> mp.rs_vm(s, U) -> BODY(pair(W(U), pair(int_mul(2, k), t0)), y) -> G3(k, U, y) proof
    fix k U y
    assume hk hkl hU hrs hb
    have er eb0 := hrs
    have wW wu := apply(mp.am_world, w1W, w1u, hU)
    let O1 := fn_update(s.objs, "live", mp.live1(s.objs.live, l))
    have lv: all x. x in s.objs.live -> x in mp.live1(s.objs.live, l) proof
      fix x
      assume hx
      have d := set_select_def[s := omega, p := x7. x7 in s.objs.live || (ex x8. x8 in omega && ((int_lt(x8, seq_len(seq_one(pair(8, 8)))) && int_le(app(l, x8), x7)) &&
        int_lt(x7, int_add(app(l, x8), fst(app(seq_one(pair(8, 8)), x8)))))), z := x]
      have lt0: s.objs.live in set_type(omega) by simp(expand(hw, abi.World, abi.Objs))
      have sb: subset(s.objs.live, omega) by taut(expand(lt0, set_type), powerset_def[s := omega, a := s.objs.live])
      have xo := mp(all_elim(expand(sb, subset), {x}), hx)
      show by taut(d, hx, xo)
    qed
    // (what was usable at the entry: usable here)
    have us: all a n w. gimple.usable(s.vm, s.objs, a, n, w) -> gimple.usable(U, O1, a, n, w) proof
      fix a n w
      assume h0
      show := apply(mp.usable_live[vm := U, objs := s.objs, L := mp.live1(s.objs.live, l), a := a, n := n, w := w],
        apply(mp.usable_bytes[v := s.vm, v2 := U, objs := s.objs, a := a, n := n, w := w], er, h0), lv)
    qed
    let LB := c_src_malloc_mallocng_malloc.__libc
    have lbv: LB = 4227136 by defs(refl({4227136}), c_src_malloc_mallocng_malloc.__libc)
    have md1: g.mem_defined(W(U), LB, 8, 8, false) by simp(lbv, mp(all_elim(us, {int_add(LB, 8)}, {8}, {false}), ua))
    // (the vector's address AV; pair k at AV + 16 k)
    let AVn := gimple.bytes_at(s.vm, bits_add(64, LB, 8), 8)
    have ku kb k0 k1 kr := mp(all_elim(axk, {k}), hk, hkl)
    have _ _ _ svb := apply(ms.world_parts, hw)
    have avo _ := apply(g.bytes_bound, {s.vm}, {bits_add(64, LB, 8)}, {8}, svb, simp())
    have ba8: bits_add(64, LB, 8) = int_add(LB, 8) by defs(simp(lbv), bits_add, bits_of_int, pow2)
    have r1 := apply(mp.rs_read[s := s, U := U, a := int_add(LB, 8), n := 8, w := false], hrs, ua, simp(lbv), simp())
    have ea := subst({y. AVn = gimple.bytes_at(s.vm, y, 8)}, ba8, refl({AVn}))
    have e2: gimple.bytes_at(U, int_add(LB, 8), 8) = AVn := trans(r1, sym(ea))
    have avu: bits_of_int(64, gimple.bytes_at(U, int_add(LB, 8), 8)) = AVn by defs(arith(e2, avo, kb, hk), bits_of_int, pow2)
    have m16: bits_mul(64, int_mul(2, k), 8) = int_mul(16, k) by defs(arith(hk, kb, avo), bits_mul, bits_of_int, pow2)
    let T64 := fn_update(fn_update(empty, "prec", 64), "signed", true)
    have sv: gimple.sval(T64, int_mul(16, k)) = int_mul(16, k) by defs(simp((int_lt(int_mul(16, k), 9223372036854775808) by arith(hk, kb, avo))), gimple.sval)
    let P0 := bits_of_int(64, gimple.bytes_at(U, int_add(LB, 8), 8))
    have pa1: int_le(0, int_add(P0, gimple.sval(T64, bits_mul(64, int_mul(2, k), 8)))) by arith(avu, m16, sv, avo, hk)
    have pa2: int_lt(int_add(P0, gimple.sval(T64, bits_mul(64, int_mul(2, k), 8))), pow2(64)) by defs(arith(avu, m16, sv, kb, hk), pow2)
    have avb: P0 in bits(64) by simp()
    have kb16: bits_mul(64, int_mul(2, k), 8) in bits(64) by simp()
    have pd := apply(g.padd_det, {W(U)}, {P0}, {bits_mul(64, int_mul(2, k), 8)}, wu, avb, kb16, pa1, pa2)
    // (pair k's first word, at R0 = AV + 16 k: its tag)
    let R0 := int_add(P0, gimple.sval(T64, bits_mul(64, int_mul(2, k), 8)))
    have r0e: R0 = int_add(AVn, int_mul(16, k)) by simp(avu, m16, sv)
    have r0o: R0 in omega by arith(r0e, avo, hk)
    have r0b: R0 in bits(64) by arith(r0e, avo, hk, kb)
    have z0: int_add(R0, 0) = R0 by arith(r0o)
    have u8 := apply(mp.usable_sub[vm := s.vm, objs := s.objs, a := int_add(AVn, int_mul(16, k)), n := 16, k := 0, m := 8, w := false], simp(), simp(), simp(), ku)
    have u8b: gimple.usable(s.vm, s.objs, R0, 8, false) by simp(r0e, u8)
    have md2: g.mem_defined(W(U), R0, 0, 8, false) by simp(z0, mp(all_elim(us, {R0}, {8}, {false}), u8b), (!(R0 = 0) by arith(r0e, anz, avo, hk)),
      (int_lt(R0, pow2(64)) by defs(arith(r0b), bits, pow2)))
    have d2 := apply(g.ld64_det, {W(U)}, {R0}, {0}, wu, r0b, simp(), md2)
    step eb3 from hb with g.ld64_det, pd, d2 using conj(wu, md1)
    let TG := bits_of_int(64, gimple.bytes_at(U, int_add(R0, 0), 8))
    have rr0 := apply(mp.rs_read[s := s, U := U, a := R0, n := 8, w := false], hrs, u8b, r0o, simp())
    have bq: bits_of_int(64, int_add(AVn, int_mul(16, k))) = R0 by defs(arith(r0e, r0b), bits_of_int, bits, pow2)
    have tgo tgl := apply(g.bytes_bound, {s.vm}, {R0}, {8}, svb, simp())
    have e1 := subst({y. gimple.bytes_at(U, y, 8) = gimple.bytes_at(s.vm, R0, 8)}, sym(z0), rr0)
    have e2: gimple.bytes_at(s.vm, R0, 8) = fst(AX[k]) := rewrite(bq, k0)
    have e3: gimple.bytes_at(U, int_add(R0, 0), 8) = fst(AX[k]) := trans(e1, e2)
    have tge: TG = fst(AX[k]) := rewrite(e3, apply(mp.boi[x := gimple.bytes_at(U, int_add(R0, 0), 8)], rewrite(sym(e1), tgo),
      rewrite(sym(e1), (int_lt(gimple.bytes_at(s.vm, R0, 8), 18446744073709551616) by simp(tgl)))))
    have an0: x86_64_linux.AT_NULL = 0 by defs(refl({0}), x86_64_linux.AT_NULL)
    have caseA: fst(AX[k]) = 0 -> G3(k, U, y) proof
      assume h0
      have tg0: TG = 0 := trans(tge, h0)
      step eA from eb3 using conj(tg0)
      show by taut(h0, eA)
    qed
    have caseB: !(fst(AX[k]) = 0) -> G3(k, U, y) proof
      assume h0
      have tgn: !(TG = 0) := rewrite(sym(tge), h0)
      step eB2 from eb3 with g.ld64_det, pd, d2 using conj(tgn, wu, md1)
      // (not the last pair: that one's tag AT_NULL)
      have kn: int_lt(int_add(k, 1), seq_len(AX)) proof
        have c: int_add(k, 1) = seq_len(AX) -> false proof
          assume e
          have ek: k = int_sub(seq_len(AX), 1) by arith(e, hk, axo)
          show by taut(h0, rewrite(an0, rewrite(sym(ek), axe)))
        qed
        have c2: int_add(k, 1) = seq_len(AX) || int_lt(int_add(k, 1), seq_len(AX)) by arith(hkl, hk, axo)
        show by taut(c, c2)
      qed
      have caseB1: fst(AX[k]) = 25 -> G3(k, U, y) proof
        assume h1
        have tg1: TG = 25 := trans(tge, h1)
        // (pair k's second word, at R1 = AV + 16 k + 8: the random bytes' address)
        let D1 := bits_mul(64, bits_add(64, int_mul(2, k), 1), 8)
        have m168: D1 = int_add(int_mul(16, k), 8) by defs(arith(hk, kb, avo), bits_mul, bits_add, bits_of_int, pow2)
        have sv8: gimple.sval(T64, int_add(int_mul(16, k), 8)) = int_add(int_mul(16, k), 8) by defs(simp((int_lt(int_add(int_mul(16, k), 8), 9223372036854775808) by arith(hk, kb, avo))), gimple.sval)
        have pb1: int_le(0, int_add(P0, gimple.sval(T64, D1))) by arith(avu, m168, sv8, avo, hk)
        have pb2: int_lt(int_add(P0, gimple.sval(T64, D1)), pow2(64)) by defs(arith(avu, m168, sv8, kb, hk), pow2)
        have pd1 := apply(g.padd_det, {W(U)}, {P0}, {D1}, wu, avb, (D1 in bits(64) by simp()), pb1, pb2)
        let R1 := int_add(P0, gimple.sval(T64, D1))
        have r1e: R1 = int_add(int_add(AVn, int_mul(16, k)), 8) by arith(avu, m168, sv8)
        have r1o: R1 in omega by arith(r1e, avo, hk)
        have r1b: R1 in bits(64) by arith(r1e, avo, hk, kb)
        have z1: int_add(R1, 0) = R1 by arith(r1o)
        have v8 := apply(mp.usable_sub[vm := s.vm, objs := s.objs, a := int_add(AVn, int_mul(16, k)), n := 16, k := 8, m := 8, w := false], simp(), simp(), simp(), ku)
        have v8b: gimple.usable(s.vm, s.objs, R1, 8, false) by simp(r1e, v8)
        have md3: g.mem_defined(W(U), R1, 0, 8, false) by simp(z1, mp(all_elim(us, {R1}, {8}, {false}), v8b), (!(R1 = 0) by arith(r1e, avo, hk)),
          (int_lt(R1, pow2(64)) by defs(arith(r1b), bits, pow2)))
        have d3 := apply(g.ld64_det, {W(U)}, {R1}, {0}, wu, r1b, simp(), md3)
        step eC2 from eB2 with g.ld64_det, pd1, d3 using conj(tg1, wu, md1)
        // the copy's source: AT_RANDOM's address + 8, its 8 bytes readable
        let VAL := bits_of_int(64, gimple.bytes_at(U, int_add(R1, 0), 8))
        let SRC := bits_add(64, VAL, 8)
        let SV := snd(AX[k])
        have rr1 := apply(mp.rs_read[s := s, U := U, a := R1, n := 8, w := false], hrs, v8b, r1o, simp())
        have bq1: bits_of_int(64, int_add(int_add(AVn, int_mul(16, k)), 8)) = R1 by defs(arith(r1e, r1b), bits_of_int, bits, pow2)
        have vo vl := apply(g.bytes_bound, {s.vm}, {R1}, {8}, svb, simp())
        have f1 := subst({y. gimple.bytes_at(U, y, 8) = gimple.bytes_at(s.vm, R1, 8)}, sym(z1), rr1)
        have f2: gimple.bytes_at(s.vm, R1, 8) = SV := rewrite(bq1, k1)
        have vale: VAL = SV := rewrite(trans(f1, f2), apply(mp.boi[x := gimple.bytes_at(U, int_add(R1, 0), 8)], rewrite(sym(f1), vo),
          rewrite(sym(f1), (int_lt(gimple.bytes_at(s.vm, R1, 8), 18446744073709551616) by simp(vl)))))
        have lk := apply(at_type[l := AX, t := cart(omega, omega), i := k], axt, hk, hkl)
        have _ s0 := apply(mp.cart_nat, lk)
        have ar: x86_64_linux.AT_RANDOM = 25 by defs(refl({25}), x86_64_linux.AT_RANDOM)
        have kr2 := mp(kr, rewrite(sym(ar), h1))
        have so8: int_add(SV, 8) in omega by arith(s0)
        have sl := apply(mp.usable_lt[vm := s.vm, objs := s.objs, a := int_add(SV, 8), n := 8, w := false, i := 7], kr2, so8, simp(), simp())
        have srce: SRC = int_add(SV, 8) := rewrite(vale, apply(mp.badd8[x := VAL], rewrite(sym(vale), s0), rewrite(sym(vale), (int_lt(int_add(SV, 8), 18446744073709551616) by arith(sl, s0)))))
        have n8: bits_of_int(64, 8) = 8 by simp()
        have hs8: gimple.usable(U, O1, SRC, bits_of_int(64, 8), false) by simp(srce, n8, mp(all_elim(us, {int_add(SV, 8)}, {8}, {false}), kr2))
        have up2 := mp(app_update_other[f := U, k := "bytes", v := s.vm.bytes, x := "pages"], (!("pages" = "bytes") by simp()))
        have uvp: U.pages = s.vm.pages := sym(rewrite(er, up2))
        have hd8: gimple.usable(U, O1, l[0], bits_of_int(64, 8), true) by simp(n8, apply(mp.obj_usable[vm := s.vm, objs := s.objs, V := U, l := l, w := true], hfit, (l[0] in omega by simp(lb)), uvp))
        // (the object's bytes free, the source's not: apart)
        have nov: !(int_lt(int_add(SV, 8), int_add(l[0], 8)) && int_lt(l[0], int_add(int_add(SV, 8), 8))) proof
          assume ov
          have o1 o2 := ov
          have l0o: l[0] in omega by simp(lb)
          have c1: int_le(l[0], int_add(SV, 8)) -> false proof
            assume le
            have fr := mp(all_elim(sf, {int_add(SV, 8)}), so8, (int_le(l[0], int_add(SV, 8)) && int_lt(int_add(SV, 8), int_add(l[0], 8)) by taut(le, o1)))
            have nf := apply(mp.nofree[vm := s.vm, objs := s.objs, a := int_add(SV, 8), n := 8, w := false, i := 0], kr2, simp(), simp())
            have z: int_add(int_add(SV, 8), 0) = int_add(SV, 8) by arith(so8)
            show by taut(fr, rewrite(z, nf))
          qed
          have c2: int_lt(int_add(SV, 8), l[0]) -> false proof
            assume lt
            let J := int_sub(l[0], int_add(SV, 8))
            have jo: J in omega by arith(lt, so8, l0o)
            have jl: int_lt(J, 8) by arith(o2, so8, l0o)
            have nf := apply(mp.nofree[vm := s.vm, objs := s.objs, a := int_add(SV, 8), n := 8, w := false, i := J], kr2, jo, jl)
            have z: int_add(int_add(SV, 8), J) = l[0] by arith(so8, l0o)
            have fr := mp(all_elim(sf, {l[0]}), l0o, (int_le(l[0], l[0]) && int_lt(l[0], int_add(l[0], 8)) by arith(l0o)))
            show by taut(fr, rewrite(z, nf))
          qed
          show by taut(c1, c2, (int_le(l[0], int_add(SV, 8)) || int_lt(int_add(SV, 8), l[0]) by arith(so8, l0o)))
        qed
        have hap: int_le(int_add(l[0], bits_of_int(64, 8)), SRC) || int_le(int_add(SRC, bits_of_int(64, 8)), l[0]) by arith(srce, n8, nov, so8, lb)
        have fsb: s.fs_base in bits(64) by simp(expand(hw, abi.World))
        have snd0: abi.thread_ok(U, s.fs_base) := apply(mp.rs_thread[t := s, V := U], fsb, hth, hrs)
        have srb: SRC in bits(64) by simp()
        let CP := gimple.bytes_at(U, SRC, bits_of_int(64, 8))
        let U2 := fn_update(U, "bytes", x86_64_linux.store_le(U.bytes, l[0], bits_of_int(64, 8), CP))
        have su := apply(g.store_univ, {U}, {l[0]}, {bits_of_int(64, 8)}, {CP}, hU)
        have vu2: U2 in univ(1) by simp(apply(x86.vm_univ, hU), su)
        have vV2 := apply(x86.store_vm, {U}, {l[0]}, {bits_of_int(64, 8)}, {CP}, hU, vu2)
        step r9 rr, eC3 from eC2 with mp.mc_q using conj(wW, wu, lb, srb, hs8, hd8, hap, snd0, hg, vV2)
        have eo _ := eC3
        have l0b8: int_le(int_add(l[0], 8), int_pow(2, 64)) := l8
        have ro := apply(mp.rs_obj[s := s, U := U, A := l[0], X := CP], hrs, lb, l0b8, sf)
        have ro2 := subst({y. mp.rs_vm(s, fn_update(U, "bytes", x86_64_linux.store_le(U.bytes, l[0], y, CP)))}, sym(n8), ro)
        have x2: ex U2. (U2 in x86_64_linux.Vm && mp.rs_vm(s, U2)) && y = ok(pair(W(U2), pair(bits_add(64, int_mul(2, k), 2), t0)), empty)
          by ex_intro({U2}, taut(vV2, ro2, eo))
        show by taut(kn, x2)
      qed
      have caseB2: !(fst(AX[k]) = 25) -> G3(k, U, y) proof
        assume h2
        have tg2: !(TG = 25) := rewrite(sym(tge), h2)
        step eB3 from eB2 using conj(tg2)
        have x2: ex U2. (U2 in x86_64_linux.Vm && mp.rs_vm(s, U2)) && y = ok(pair(W(U2), pair(bits_add(64, int_mul(2, k), 2), t0)), empty)
          by ex_intro({U}, taut(hU, hrs, eB3))
        show by taut(kn, x2)
      qed
      show by taut(caseB1, caseB2)
    qed
    show by taut(caseA, caseB)
  qed
  // the loop: from no pair passed, the object's word stored
  let M(x) := int_sub(int_mul(2, seq_len(AX)), fst(snd(x)))
  let X0 := bits_mul(64, l[0], 1103515245)
  let V2 := fn_update(V, "bytes", x86_64_linux.store_le(V.bytes, int_add(l[0], 0), 8, X0))
  have rsv: mp.rs_vm(s, V) proof
    have g2: all x. x in bits(64) -> !abi.stack_free(s.vm, s.objs, x) -> V.bytes[x] = s.vm.bytes[x] proof
      fix x
      assume hx hn
      have no: !(int_le(l[0], x) && int_lt(x, int_add(l[0], 8))) proof
        assume r
        show by taut(hn, mp(all_elim(sf, {x}), (x in omega by simp(hx)), r))
      qed
      show := mp(all_elim(hV3, {x}), hx, no)
    qed
    show by taut(hV2, g2)
  qed
  have rs1 := apply(mp.rs_obj[s := s, U := V, A := l[0], X := X0], rsv, lb, l8, sf)
  have rs2 := subst({y. mp.rs_vm(s, fn_update(V, "bytes", x86_64_linux.store_le(V.bytes, y, 8, X0)))}, sym(z0), rs1)
  have su0 := apply(g.store_univ, {V}, {int_add(l[0], 0)}, {8}, {X0}, hV1)
  have vu0: V2 in univ(1) by simp(apply(x86.vm_univ, hV1), su0)
  have vV0 := apply(x86.store_vm, {V}, {int_add(l[0], 0)}, {8}, {X0}, hV1, vu0)
  have l1x: int_lt(0, seq_len(AX)) by arith(expand(axl, ord_le), axo)
  have p0: P(pair(W(V2), pair(0, t0))) by ex_intro({0}, {V2}, taut((0 in omega by simp()), l1x, vV0, rs2, (pair(W(V2), pair(0, t0)) = pair(W(V2), pair(int_mul(2, 0), t0)) by simp())))
  have pm: all x. P(x) -> M(x) in omega proof
    fix x
    assume hp
    obtain k U, hk hkl hU1 hx from hp
    have m: int_sub(int_mul(2, seq_len(AX)), int_mul(2, k)) in omega by arith(hk, hkl, axo)
    show by simp(hx, m)
  qed
  have nx: all x x2. P(x) -> BODY(x, ok(x2, empty)) -> P(x2) && int_lt(M(x2), M(x)) proof
    fix x x2
    assume hp hb
    obtain k U, hk hkl hU1 hx from hp
    have hU hrs := hU1
    have t := mp(all_elim(trip, {k}, {U}, {ok(x2, empty)}), hk, hkl, hU, hrs, rewrite(hx, hb))
    have _ kb _ _ _ := mp(all_elim(axk, {k}), hk, hkl)
    have n1: !(ok(x2, empty) = exc(pair(W(U), pair(int_mul(2, k), t0)), pair("brk", empty))) by defs(simp(), ok, exc)
    have n3: !(ex v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && ok(x2, empty) = exc(pair(fn_update(W(v), "objs", ob), pair(int_mul(2, k), t0)), pair("raise", exc_val("stack_overflow", empty)))) proof
      assume e
      obtain v ob, _ _ ev from e
      show by defs(simp(ev), ok, exc)
    qed
    have kn ex2 := (int_lt(int_add(k, 1), seq_len(AX)) && (ex U2. (U2 in x86_64_linux.Vm && mp.rs_vm(s, U2)) &&
      ok(x2, empty) = ok(pair(W(U2), pair(bits_add(64, int_mul(2, k), 2), t0)), empty)) by taut(t, n1, n3))
    obtain U2, hU2a hU2b he2 from ex2
    have hU2: U2 in x86_64_linux.Vm && mp.rs_vm(s, U2) by taut(hU2a, hU2b)
    have avo _ := apply(g.bytes_bound, {s.vm}, {bits_add(64, c_src_malloc_mallocng_malloc.__libc, 8)}, {8}, apply(ms.world_parts, hw).bytes, simp())
    have b2: bits_add(64, int_mul(2, k), 2) = int_mul(2, int_add(k, 1)) by defs(arith(hk, kb, avo), bits_add, bits_of_int, pow2)
    have xe: x2 = pair(W(U2), pair(int_mul(2, int_add(k, 1)), t0)) by simp(he2, b2)
    have p2: P(x2) by ex_intro({int_add(k, 1)}, {U2}, taut((int_add(k, 1) in omega by arith(hk)), kn, hU2, xe))
    have m2: int_lt(M(x2), M(x)) by simp(xe, hx, (int_lt(int_sub(int_mul(2, seq_len(AX)), int_mul(2, int_add(k, 1))), int_sub(int_mul(2, seq_len(AX)), int_mul(2, k))) by arith(hk)))
    show by taut(p2, m2)
  qed
  have wv := apply(g.loop[b := x y. BODY(x, y), p := x. P(x), m := x. M(x)], p0, pm, nx, wl)
  // the loop left: at AT_NULL, or an overflow
  obtain x, hpl bb nk from wv
  obtain k U, hk hkl hU1 hx from hpl
  have hU hrs := hU1
  have t := mp(all_elim(trip, {k}, {U}, {r}), hk, hkl, hU, hrs, rewrite(hx, bb))
  have cB: fst(AX[k]) = 0 && r = exc(pair(W(U), pair(int_mul(2, k), t0)), pair("brk", empty)) -> mp.grs_out(s, o) proof
    assume h
    have _ re := h
    // (the object's word read: the secret)
    have er _ := hrs
    have up3 := mp(app_update_other[f := U, k := "bytes", v := s.vm.bytes, x := "pages"], (!("pages" = "bytes") by simp()))
    have uvp: U.pages = s.vm.pages := sym(rewrite(er, up3))
    have wW wu := apply(mp.am_world, w1W, w1u, hU)
    have our := apply(mp.obj_usable[vm := s.vm, objs := s.objs, V := U, l := l, w := false], hfit, (l[0] in omega by simp(lb)), uvp)
    have md5: g.mem_defined(W(U), l[0], 0, 8, false) by simp(z0, nz, our, (int_lt(int_add(l[0], 0), pow2(64)) by defs(arith(l8, lb), pow2)))
    have d5 := apply(g.ld64_det, {W(U)}, {l[0]}, {0}, wu, lb, simp(), md5)
    step y5, eK from rewrite(re, kr) with expand(d5, g.det)
    let O1 := fn_update(s.objs, "live", mp.live1(s.objs.live, l))
    have sw := mp(fn_update_swap[f := fn_update(s, "vm", V), k := "objs", a := O1, j := "vm", b := U], (!("objs" = "vm") by simp()))
    have tw := subst({y. fn_update(fn_update(fn_update(s, "vm", V), "vm", U), "objs", O1) = fn_update(y, "objs", O1)},
      fn_update_twice[f := s, k := "vm", a := V, b := U], refl({fn_update(fn_update(fn_update(s, "vm", V), "vm", U), "objs", O1)}))
    have ew: W(U) = fn_update(fn_update(s, "vm", U), "objs", O1) := trans(sw, tw)
    let RV := bits_of_int(64, gimple.bytes_at(U, int_add(l[0], 0), 8))
    have oe: o = ok(fn_update(fn_update(s, "vm", U), "objs", O1), RV) := rewrite(ew, eK)
    have x3: ex V3 L r2. (V3 in x86_64_linux.Vm && mp.rs_vm(s, V3)) && r2 in bits(64) && o = ok(fn_update(fn_update(s, "vm", V3), "objs", fn_update(s.objs, "live", L)), r2)
      by ex_intro({U}, {mp.live1(s.objs.live, l)}, {RV}, taut(hU, hrs, (RV in bits(64) by simp()), oe))
    show by taut(x3)
  qed
  have cO: (ex v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && r = exc(pair(fn_update(W(v), "objs", ob), pair(int_mul(2, k), t0)), pair("raise", exc_val("stack_overflow", empty)))) -> mp.grs_out(s, o) proof
    assume h
    obtain v ob, hv hob re from h
    step eO from rewrite(re, kr)
    // (the world: the entry's, any memory and objects)
    have ew := apply(mp.w2_norm, {s}, {V}, {mp.live1(s.objs.live, l)}, {v}, {ob})
    have x2: abi.ovf_out(s, o) by ex_intro({v}, {ob}, taut(hv, hob, rewrite(ew, eO)))
    show by taut(x2)
  qed
  have cK: !(int_lt(int_add(k, 1), seq_len(AX)) && (ex U2. (U2 in x86_64_linux.Vm && mp.rs_vm(s, U2)) && r = ok(pair(W(U2), pair(bits_add(64, int_mul(2, k), 2), t0)), empty))) proof
    assume h
    have _ e := h
    obtain U2, _ _ re from e
    have io: is_ok(r) by defs(ex_intro({pair(W(U2), pair(bits_add(64, int_mul(2, k), 2), t0))}, {empty}, re), is_ok)
    show by taut(io, nk)
  qed
  show by taut(t, cB, cO, cK)
qed

// ----------------------------------------------------------------------
//  The spec's runs

// (its requirement not met: anything; else an overflow, or a word with
// the memory as it was but the stack's free bytes)
theorem mp.rss_run(s, libc, o): s in abi.World -> pair(s, o) in univ(1) ->
  (!(mallocng_specs.auxv_ok(s.vm, s.objs, libc) && abi.thread_ok(s.vm, s.fs_base)) ||
   abi.ovf_out(s, o) ||
   (ex V r. (V in x86_64_linux.Vm && mp.rs_vm(s, V)) && r in bits(64) && o = ok(fn_update(s, "vm", V), r))) ->
  runs(mallocng_specs.random_secret_spec(libc), s, o)
proof
  assume hw pu h
  let OVF := exc_val("stack_overflow", empty)
  let PRE(x0) := mallocng_specs.auxv_ok(app(x0, "vm"), app(x0, "objs"), libc) && abi.thread_ok(app(x0, "vm"), app(x0, "fs_base"))
  let BR1(x0, x2) := bind_rel(abi.overflow, x0, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)), x3. x2 = diverge(x3))
  let BR2(x0, x2) := letin(app(x0, "vm"), x3. any_rel(x4. x4 in x86_64_linux.Vm && (fn_update(app(fn_update(x0, "vm", x4), "vm"), "bytes", app(x3, "bytes")) = x3 &&
    (all x5. x5 in bits(64) -> !abi.stack_free(x3, app(fn_update(x0, "vm", x4), "objs"), x5) -> app(app(app(fn_update(x0, "vm", x4), "vm"), "bytes"), x5) = app(app(x3, "bytes"), x5))),
    x4. letin(fn_update(x0, "vm", x4), x5. any_rel(x6. x6 in bits(64), x6. x2 = exc(pair(x5, empty), pair("ret", x6))))))
  let DS(x2, x1) := (fst(x2) = 0 && x1 = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && x1 = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
    ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && x1 = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && x1 = diverge(snd(x2))))
  let SB(x0, x1) := !PRE(x0) || (ex x2. (BR1(x0, x2) || BR2(x0, x2)) && DS(x2, x1))
  have g: SB(s, o) proof
    have c1: !PRE(s) -> SB(s, o) proof
      assume hn
      show by taut(hn)
    qed
    have c2: abi.ovf_out(s, o) -> SB(s, o) proof
      assume e
      obtain v ob, hv hob ho from e
      let X2 := exc(pair(fn_update(fn_update(s, "vm", v), "objs", ob), empty), pair("raise", OVF))
      have pu1 := rewrite(ho, pu)
      have r1 := apply(ct.overflow_intro, hv, hob, pu1)
      have b1: BR1(s, X2) by defs(ex_intro({exc(fn_update(fn_update(s, "vm", v), "objs", ob), OVF)}, simp(r1, pu1)), bind_rel)
      have d1: DS(X2, o) by simp(ho)
      show by taut((ex x2. (BR1(s, x2) || BR2(s, x2)) && DS(x2, o) by ex_intro({X2}, taut(b1, d1))))
    qed
    have c3: (ex V r. (V in x86_64_linux.Vm && mp.rs_vm(s, V)) && r in bits(64) && o = ok(fn_update(s, "vm", V), r)) -> SB(s, o) proof
      assume e
      obtain V r, hV1 hV2 hr ho from e
      let X2 := exc(pair(fn_update(s, "vm", V), empty), pair("ret", r))
      have ev: ex x4. (x4 in x86_64_linux.Vm && (fn_update(app(fn_update(s, "vm", x4), "vm"), "bytes", app(s.vm, "bytes")) = s.vm &&
          (all x5. x5 in bits(64) -> !abi.stack_free(s.vm, app(fn_update(s, "vm", x4), "objs"), x5) -> app(app(app(fn_update(s, "vm", x4), "vm"), "bytes"), x5) = app(app(s.vm, "bytes"), x5)))) &&
          letin(fn_update(s, "vm", x4), x5. any_rel(x6. x6 in bits(64), x6. X2 = exc(pair(x5, empty), pair("ret", x6))))
        by ex_intro({V}, defs(simp(hV1, hV2, hr, (ex x6. x6 in bits(64) && X2 = exc(pair(fn_update(s, "vm", V), empty), pair("ret", x6)) by ex_intro({r}, taut(hr, refl({X2}))))), any_rel, letin))
      have b2: BR2(s, X2) by defs(taut(expand(ev, any_rel, letin)), any_rel, letin)
      have d2: DS(X2, o) by simp(ho)
      show by taut((ex x2. (BR1(s, x2) || BR2(s, x2)) && DS(x2, o) by ex_intro({X2}, taut(b2, d2))))
    qed
    show by taut(h, c1, c2, c3)
  qed
  show by defs(apply(tr.runs_intro[r := x0 x1. SB(x0, x1)], {s}, {o}, pu, g), mallocng_specs.random_secret_spec)
qed

// (the spec's C function value: its procedure's outcome o3, the result
// then)
theorem mp.rsf_intro(libc, regs, s, o, o3): regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) -> pair(s, o) in univ(1) ->
  runs(mallocng_specs.random_secret_spec(libc), s, o3) ->
  ((ex w r. o3 = ok(w, r) && bind_rel(gimple.result(64, r), w, x5 x6. any_rel(x8. x8 in bits(64), x8. o = ok(x5, pair(x6, x8))), x5 x6. o = exc(x5, x6), x5. o = diverge(x5))) ||
   (ex w e. o3 = exc(w, e) && o = exc(w, e)) || (ex t. o3 = diverge(t) && o = diverge(t))) ->
  runs(mallocng_specs.random_secret_spec_fun(libc)[regs], s, o)
proof
  assume ra pu hs hd
  let K(w, r) := bind_rel(gimple.result(64, r), w, x5 x6. letin(x6, x7. any_rel(x8. x8 in bits(64), x8. o = ok(x5, pair(x7, x8)))), x5 x6. o = exc(x5, x6), x5. o = diverge(x5))
  have bb: bind_rel(mallocng_specs.random_secret_spec(libc), s, x2 x3. letin(x3, x4. K(x2, x4)), x2 x3. o = exc(x2, x3), x2. o = diverge(x2))
    by defs(ex_intro({o3}, taut(hs, expand(hd, bind_rel, letin))), bind_rel, letin)
  rsimp only, mallocng_specs.random_secret_spec_fun, app_fn_build, ra
  show := apply(tr.runs_intro[r := x0 x1. bind_rel(mallocng_specs.random_secret_spec(libc), x0, x2 x3. letin(x3, x4. bind_rel(gimple.result(64, x4), x2,
    x5 x6. letin(x6, x7. any_rel(x8. x8 in bits(64), x8. x1 = ok(x5, pair(x7, x8)))), x5 x6. x1 = exc(x5, x6), x5. x1 = diverge(x5))), x2 x3. x1 = exc(x2, x3), x2. x1 = diverge(x2))], {s}, {o}, pu, bb)
qed

// ----------------------------------------------------------------------
//  get_random_secret's code by its purpose: up to an overflow's world

theorem mp.grs_fun: all G regs s o. mp.calls(G, mallocng_specs.memcpy_spec_fun()) -> regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
  runs(c_src_malloc_mallocng_malloc.get_random_secret_fun(G)[regs], s, o) ->
  runs(mallocng_specs.random_secret_spec_fun(c_src_malloc_mallocng_malloc.__libc)[regs], s, o)
proof
  fix G regs s o
  assume hg hr hl hw h
  have lo: seq_len(regs) in omega by simp(hr)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(hl, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(hr, ol, keep(ord_le))
  rsimp only, c_src_malloc_mallocng_malloc.get_random_secret_fun, app_fn_build, ra in h
  have pu := apply(g.runs_univ, h)
  have b := apply(g.runs_elim, h)
  obtain o3, hs3 hk3 from expand(b, letin, bind_rel)
  let LB := c_src_malloc_mallocng_malloc.__libc
  let SF := mallocng_specs.random_secret_spec_fun(LB)
  let OVF := exc_val("stack_overflow", empty)
  let LV := s.objs.live
  let WL(w) := fn_update(w, "objs", fn_update(w.objs, "live", LV))
  let DSP(w, r) := bind_rel(gimple.result(64, r), w, x5 x6. any_rel(x8. x8 in bits(64), x8. o = ok(x5, pair(x6, x8))), x5 x6. o = exc(x5, x6), x5. o = diverge(x5))
  let PRE := mallocng_specs.auxv_ok(s.vm, s.objs, LB) && abi.thread_ok(s.vm, s.fs_base)
  have psu := apply(g.runs_univ, expand(hs3, c_src_malloc_mallocng_malloc.get_random_secret))
  // (the code's procedure's outcome o3, the spec's procedure's o3' -- the
  // objects restored --, the same rest)
  have via: all o3x. runs(mallocng_specs.random_secret_spec(LB), s, o3x) ->
      ((ex w r. o3x = ok(w, r) && DSP(w, r)) || (ex w e. o3x = exc(w, e) && o = exc(w, e)) || (ex t. o3x = diverge(t) && o = diverge(t))) -> runs(SF[regs], s, o) proof
    fix o3x
    assume r1 r2
    show := apply(mp.rsf_intro[libc := LB, regs := regs, s := s, o := o, o3 := o3x], ra, pu, r1, r2)
  qed
  have cok: all w r. o3 = ok(w, r) -> DSP(WL(w), r) proof
    fix w r
    assume e
    show by defs(simp(rewrite(e, hk3), keep(gimple.result, any_rel)), bind_rel)
  qed
  have cexc: all w e. o3 = exc(w, e) -> o = exc(w, e) proof
    fix w e
    assume h3
    show by simp(rewrite(h3, hk3), keep(gimple.result, any_rel))
  qed
  have cdv: all t. o3 = diverge(t) -> o = diverge(t) proof
    fix t
    assume h3
    show by simp(rewrite(h3, hk3), keep(gimple.result, any_rel))
  qed
  have hu: s in univ(1) by simp(pu)
  have pv pf pd _ := apply(ms.world_parts, hw)
  let D3(x) := ((ex w r. x = ok(w, r) && DSP(w, r)) || (ex w e. x = exc(w, e) && o = exc(w, e))) || (ex t. x = diverge(t) && o = diverge(t))
  let G2 := runs(SF[regs], s, o)
  // the requirement not met: the spec's anything, its procedure's
  // outcome the code's, the objects restored
  have caseN: !PRE -> G2 proof
    assume hn
    have k1: (ex w r. o3 = ok(w, r)) -> G2 proof
      assume e
      obtain w r, e3 from e
      have wu: pair(w, r) in univ(1) by simp(rewrite(e3, psu))
      have wou := mp(app_univ[u := 1, f := w, k := "objs"], (w in univ(1) by simp(wu)))
      have lvu := mp(app_univ[u := 1, f := s.objs, k := "live"], mp(app_univ[u := 1, f := s, k := "objs"], hu))
      have pu3: pair(s, ok(WL(w), r)) in univ(1) by simp(hu, wu, wou, lvu)
      have rs := apply(mp.rss_run[s := s, libc := LB, o := ok(WL(w), r)], hw, pu3, taut(hn))
      have d := mp(all_elim(cok, {w}, {r}), e3)
      have x1: ex w2 r2. ok(WL(w), r) = ok(w2, r2) && DSP(w2, r2) by ex_intro({WL(w)}, {r}, taut(refl({ok(WL(w), r)}), d))
      show by taut(mp(all_elim(via, {ok(WL(w), r)}), rs, (D3(ok(WL(w), r)) by taut(x1))))
    qed
    have k2: (ex w e. o3 = exc(w, e)) -> G2 proof
      assume e
      obtain w x, e3 from e
      have rs := apply(mp.rss_run[s := s, libc := LB, o := o3], hw, psu, taut(hn))
      have oe := mp(all_elim(cexc, {w}, {x}), e3)
      have x1: ex w2 e2. o3 = exc(w2, e2) && o = exc(w2, e2) by ex_intro({w}, {x}, taut(e3, oe))
      show by taut(mp(all_elim(via, {o3}), rs, (D3(o3) by taut(x1))))
    qed
    have k3: (ex t. o3 = diverge(t)) -> G2 proof
      assume e
      obtain t, e3 from e
      have rs := apply(mp.rss_run[s := s, libc := LB, o := o3], hw, psu, taut(hn))
      have oe := mp(all_elim(cdv, {t}), e3)
      have x1: ex t2. o3 = diverge(t2) && o = diverge(t2) by ex_intro({t}, taut(e3, oe))
      show by taut(mp(all_elim(via, {o3}), rs, (D3(o3) by taut(x1))))
    qed
    have ot: (ex w r. o3 = ok(w, r)) || (ex w e. o3 = exc(w, e)) || (ex t. o3 = diverge(t)) proof
      have c1: (ex x0 x1. o3 = ok(x0, x1) && (ex x2. runs(gimple.result(64, x1), WL(x0), x2) && (((ex x3 x4. x2 = ok(x3, x4) && any_rel(x5. x5 in bits(64), x5. o = ok(x3, pair(x4, x5)))) ||
          (ex x3 x4. x2 = exc(x3, x4) && o = exc(x3, x4))) || (ex x3. x2 = diverge(x3) && o = diverge(x3))))) -> ex w r. o3 = ok(w, r) proof
        assume q
        obtain w r, q1 _ from q
        show by ex_intro({w}, {r}, q1)
      qed
      have c2: (ex x0 x1. o3 = exc(x0, x1) && o = exc(x0, x1)) -> ex w e. o3 = exc(w, e) proof
        assume q
        obtain w e, q1 _ from q
        show by ex_intro({w}, {e}, q1)
      qed
      have c3: (ex x0. o3 = diverge(x0) && o = diverge(x0)) -> ex t. o3 = diverge(t) proof
        assume q
        obtain t, q1 _ from q
        show by ex_intro({t}, q1)
      qed
      show by taut(hk3, c1, c2, c3)
    qed
    show by taut(ot, k1, k2, k3)
  qed
  // the requirement met: the run's outcomes
  have caseP: PRE -> G2 proof
    assume hp
    have hax hth := hp
    have go := apply(mp.grs_run[G := G, s := s, o := o3], hg, hw, hax, hth, hs3)
    have eu: OVF in univ(1) by defs(simp(), exc_val)
    // (an overflow: the spec's)
    have p1: abi.ovf_out(s, o3) -> G2 proof
      assume e
      obtain v ob, hv hob e3 from e
      have rs := apply(mp.rss_run[s := s, libc := LB, o := o3], hw, psu, taut(e))
      have oe := mp(all_elim(cexc, {fn_update(fn_update(s, "vm", v), "objs", ob)}, {OVF}), e3)
      have x1: ex w2 e2. o3 = exc(w2, e2) && o = exc(w2, e2) by ex_intro({fn_update(fn_update(s, "vm", v), "objs", ob)}, {OVF}, taut(e3, oe))
      show by taut(mp(all_elim(via, {o3}), rs, (D3(o3) by taut(x1))))
    qed
    // (a word returned: the objects restored, the spec's memory)
    have p3: (ex V L r. (V in x86_64_linux.Vm && mp.rs_vm(s, V)) && r in bits(64) && o3 = ok(fn_update(fn_update(s, "vm", V), "objs", fn_update(s.objs, "live", L)), r)) -> G2 proof
      assume e
      obtain V L r, hV1 hV2 hr e3 from e
      let W3 := fn_update(fn_update(s, "vm", V), "objs", fn_update(s.objs, "live", L))
      have d := mp(all_elim(cok, {W3}, {r}), e3)
      have of ol0 := (is_fun(s.objs) && "live" in dom(s.objs) by simp(expand(hw, abi.World, abi.Objs)))
      have e2: fn_update(fn_update(s.objs, "live", L), "live", LV) = s.objs := trans(fn_update_twice[f := s.objs, k := "live", a := L, b := LV], mp(fn_update_same[f := s.objs, k := "live"], of, ol0))
      have f1: is_fun(fn_update(s, "vm", V)) := mp(fn_update_fun[f := s, k := "vm", v := V], pf)
      have f2: "objs" in dom(fn_update(s, "vm", V)) by simp(mp(fn_update_dom[f := s, k := "vm", v := V], pf, pd), expand(hw, abi.World))
      have e4 := mp(fn_update_same[f := fn_update(s, "vm", V), k := "objs"], f1, f2)
      have od: "objs" in dom(s) by simp(expand(hw, abi.World))
      have eqW: WL(W3) = fn_update(s, "vm", V) by simp(e2, e4, pf, od)
      have vu := apply(x86.vm_univ, hV1)
      have pu3: pair(s, ok(fn_update(s, "vm", V), r)) in univ(1) by simp(hu, vu, hr)
      have rv: ex V2 r2. (V2 in x86_64_linux.Vm && mp.rs_vm(s, V2)) && r2 in bits(64) && ok(fn_update(s, "vm", V), r) = ok(fn_update(s, "vm", V2), r2)
        by ex_intro({V}, {r}, taut(hV1, hV2, hr, refl({ok(fn_update(s, "vm", V), r)})))
      have rs := apply(mp.rss_run[s := s, libc := LB, o := ok(fn_update(s, "vm", V), r)], hw, pu3, taut(rv))
      have x1: ex w2 r2. ok(fn_update(s, "vm", V), r) = ok(w2, r2) && DSP(w2, r2) by ex_intro({fn_update(s, "vm", V)}, {r}, taut(refl({ok(fn_update(s, "vm", V), r)}), rewrite(eqW, d)))
      show by taut(mp(all_elim(via, {ok(fn_update(s, "vm", V), r)}), rs, (D3(ok(fn_update(s, "vm", V), r)) by taut(x1))))
    qed
    show by taut(go, p1, p3)
  qed
  show by taut(caseN, caseP)
qed

// get_random_secret's machine code (C1: proofs/mallocng/machine/c1_objs.core,
// its CFG form refining the structured one), linked with memcpy's
// (mcp), implements its purpose
theorem grsc.composed: all statics. tr.implements_at(4206030, mallocng_specs.random_secret_spec_fun(c_src_malloc_mallocng_malloc.__libc), 4198400, text.code, statics)
proof
  fix statics
  let MC := musl_asm_cfg.memcpy_fun()
  let LOW := c_src_malloc_mallocng_malloc.get_random_secret_fun(MC)
  have i0 := mp(all_elim(grsc.implements, {statics}, {MC}), all_elim(mcp.implements, {statics}), mcp.typed, mcp.io)
  have st := mp(all_elim(tr.implements_refine, {4206030}, {c_src_malloc_mallocng_malloc_cfg.get_random_secret_fun(MC)}, {LOW}, {4198400}, {text.code}, {statics}),
    i0, mp(all_elim(get_random_secret_ref, {MC}), mcp.io))
  // (memcpy's CFG form called as its contract says)
  have hc: mp.calls(MC, mallocng_specs.memcpy_spec_fun()) proof
    fix regs s o
    assume h1 h2 h3 hr
    show := mp(all_elim(mp.memcpy_fun_c2, {regs}, {s}, {o}), h1, h2, h3, mp(all_elim(memcpy_ref, {regs}, {s}, {o}), h1, h2, h3, hr))
  qed
  have r: all regs w o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> w in abi.World -> runs(LOW[regs], w, o) ->
      runs(mallocng_specs.random_secret_spec_fun(c_src_malloc_mallocng_malloc.__libc)[regs], w, o) proof
    fix regs w o
    assume h1 h2 h3 h
    show := mp(all_elim(mp.grs_fun, {MC}, {regs}, {w}, {o}), hc, h1, h2, h3, h)
  qed
  show := mp(all_elim(tr.implements_refine, {4206030}, {LOW}, {mallocng_specs.random_secret_spec_fun(c_src_malloc_mallocng_malloc.__libc)}, {4198400}, {text.code}, {statics}), st, r)
qed

// ... and its CFG form, linked, called as its purpose says (a caller's
// callee: alloc_meta's get_random_secret)
theorem grsc.calls: mp.calls(c_src_malloc_mallocng_malloc_cfg.get_random_secret_fun(musl_asm_cfg.memcpy_fun()), mallocng_specs.random_secret_spec_fun(c_src_malloc_mallocng_malloc.__libc))
proof
  let MC := musl_asm_cfg.memcpy_fun()
  have hc: mp.calls(MC, mallocng_specs.memcpy_spec_fun()) proof
    fix regs s o
    assume h1 h2 h3 hr
    show := mp(all_elim(mp.memcpy_fun_c2, {regs}, {s}, {o}), h1, h2, h3, mp(all_elim(memcpy_ref, {regs}, {s}, {o}), h1, h2, h3, hr))
  qed
  fix regs s o
  assume h1 h2 h3 hr
  have hs := mp(all_elim(mp(all_elim(get_random_secret_ref, {MC}), mcp.io), {regs}, {s}, {o}), h1, h2, h3, hr)
  show := mp(all_elim(mp.grs_fun, {MC}, {regs}, {s}, {o}), hc, h1, h2, h3, hs)
qed
