// __init_tls (static_init_tls) by its purpose (startup_specs.init_tls_spec):
// the program headers walked (none of them PT_TLS: no TLS module), the
// TLS sizes in libc, the thread's descriptor set up in the static TLS area
// (__copy_tls), the thread pointer at it (__init_tp).

// ----------------------------------------------------------------------
//  The system calls

// (arch_prctl(ARCH_SET_FS, p), p in the user space: the thread pointer p)
theorem sp.sfs_det: all w p. p in bits(64) -> int_lt(p, x86_64_linux.TASK_SIZE) -> g.det(gimple.sys_set_fs(p), w, ok(fn_update(w, "fs_base", p), 0))
proof
  fix w p
  assume hp hl
  have g0: all o. runs(gimple.sys_set_fs(p), w, o) -> o = ok(fn_update(w, "fs_base", p), 0) proof
    fix o
    assume h
    rsimp only, gimple.sys_set_fs in h
    have b := apply(g.runs_elim, h)
    show by simp(b, hl)
  qed
  show by defs(g0, g.det)
qed

// (set_tid_address: a thread id -- a number in (0, 2^22) --, the world as it
// was)
theorem sp.tid_inv: all w a1 o. runs(gimple.sys_call1(218, a1), w, o) -> ex r. (r in bits(64) && (int_lt(0, r) && int_lt(r, 4194304))) && o = ok(w, r)
proof
  fix w a1 o
  assume h
  rsimp only, gimple.sys_call1 in h
  have b := apply(g.runs_elim, h)
  have ne: ex t. t in bits(64) && (int_lt(0, t) && int_lt(t, 4194304)) by ex_intro({1}, simp())
  show by simp(b, ne)
qed

// __set_thread_area(p) at a call, p in the user space: the thread pointer
// p, 0 returned
theorem sp.sta_q: all t p regs o2. t in abi.World -> t in univ(1) -> p in bits(64) -> int_lt(p, x86_64_linux.TASK_SIZE) ->
  gc.regs_ok(regs, seq_one(gimple.arg(64, p))) -> runs(musl_asm.__set_thread_area_fun()[regs], t, o2) ->
  ex r. o2 = ok(fn_update(t, "fs_base", p), r) && fst(r) = 0
proof
  fix t p regs o2
  assume hw hu hp hl hro h
  let ARGS := seq_one(gimple.arg(64, p))
  let FT := fn_update(t, "fs_base", p)
  have rl rln _ := hro
  have an: seq_len(ARGS) = 1 by simp()
  have rn: seq_len(regs) = 1 := trans(rln, an)
  have lo: seq_len(regs) in omega by simp(rn)
  have q0 := apply(gc.reg_at[regs := regs, args := ARGS, i := 0, w := 64, x := p], hro, simp(), simp(an), at({ARGS[0]}), simp(), hp)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, musl_asm.__set_thread_area_fun, app_fn_build, ra in h
  have o1l: ord_le(1, seq_len(regs)) by defs(simp(rn), ord_le)
  have b := rewrite(q0, apply(g.runs_elim, h))
  have b2: bind_rel(musl_asm.__set_thread_area(p), t, x3 x4. letin(x4, x5. bind_rel(gimple.result(64, x5), x3, x6 x7. any_rel(x8. x8 in bits(64), x8. o2 = ok(x6, pair(x7, x8))),
      x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))), x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3)) by taut(b, o1l)
  obtain o3, hs3 hk3 from expand(b2, bind_rel)
  step x2, e3 from hs3 with sp.sfs_det using conj(hp, hl)
  have k1: bind_rel(gimple.result(64, 0), FT, x6 x7. any_rel(x8. x8 in bits(64), x8. o2 = ok(x6, pair(x7, x8))), x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))
    by simp(expand(rewrite(e3, hk3), letin), keep(bind_rel, gimple.result))
  obtain o4, hr4 hk4 from expand(k1, bind_rel)
  have ho4 := apply(g.result64_inv, (0 in bits(64) by simp()), hr4)
  have k2: any_rel(x8. x8 in bits(64), x8. o2 = ok(FT, pair(0, x8))) by simp(rewrite(ho4, hk4), keep(any_rel))
  obtain y, hy hoy from apply(g.any_e, (ex y. y in bits(64) by ex_intro({0}, simp())), k2)
  show by ex_intro({pair(0, y)}, taut(hoy, (fst(pair(0, y)) = 0 by simp())))
qed

// __syscall1(218, a) (set_tid_address) at a call: a thread id returned, the
// world as it was
theorem sp.s1t_q: all t a regs o2. t in abi.World -> t in univ(1) -> a in bits(64) ->
  gc.regs_ok(regs, seq_concat(seq_one(gimple.arg(64, 218)), seq_one(gimple.arg(64, a)))) -> runs(c_src_env___init_tls.__syscall1_fun()[regs], t, o2) ->
  ex r. o2 = ok(t, r) && (fst(r) in bits(64) && (int_lt(0, fst(r)) && int_lt(fst(r), 4194304)))
proof
  fix t a regs o2
  assume hw hu ha hro h
  let ARGS := seq_concat(seq_one(gimple.arg(64, 218)), seq_one(gimple.arg(64, a)))
  have rl rln _ := hro
  have an: seq_len(ARGS) = 2 by simp()
  have rn: seq_len(regs) = 2 := trans(rln, an)
  have lo: seq_len(regs) in omega by simp(rn)
  have q0 := apply(gc.reg_at[regs := regs, args := ARGS, i := 0, w := 64, x := 218], hro, simp(), simp(an), at({ARGS[0]}), simp(), simp())
  have q1 := apply(gc.reg_at[regs := regs, args := ARGS, i := 1, w := 64, x := a], hro, simp(), simp(an), at({ARGS[1]}), simp(), ha)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, c_src_env___init_tls.__syscall1_fun, app_fn_build, ra in h
  have o2l: ord_le(2, seq_len(regs)) by defs(simp(rn), ord_le)
  have b := rewrite(q1, rewrite(q0, apply(g.runs_elim, h)))
  have b2: bind_rel(c_src_env___init_tls.__syscall1(218, a), t, x3 x4. letin(x4, x5. bind_rel(gimple.result(64, x5), x3, x6 x7. any_rel(x8. x8 in bits(64), x8. o2 = ok(x6, pair(x7, x8))),
      x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))), x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3)) by taut(b, o2l)
  obtain o3, hs3 hk3 from expand(b2, bind_rel)
  step x2 x4 r, hrb e3 from hs3 with sp.tid_inv
  obtain v, hv hv0 hv1 er from hrb
  have o3e: o3 = ok(t, v) by simp(expand(rewrite(er, e3), letin))
  have k1: bind_rel(gimple.result(64, v), t, x6 x7. any_rel(x8. x8 in bits(64), x8. o2 = ok(x6, pair(x7, x8))), x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))
    by simp(expand(rewrite(o3e, hk3), letin), keep(bind_rel, gimple.result))
  obtain o4, hr4 hk4 from expand(k1, bind_rel)
  have ho4 := apply(g.result64_inv, hv, hr4)
  have k2: any_rel(x8. x8 in bits(64), x8. o2 = ok(t, pair(v, x8))) by simp(rewrite(ho4, hk4), keep(any_rel))
  obtain y, hy hoy from apply(g.any_e, (ex y. y in bits(64) by ex_intro({0}, simp())), k2)
  show by ex_intro({pair(v, y)}, taut(hoy, (fst(pair(v, y)) in bits(64) && (int_lt(0, fst(pair(v, y))) && int_lt(fst(pair(v, y)), 4194304)) by simp(hv, hv0, hv1))))
qed

// (a call of a callee returning at the world it was called at: an overflow
// there, or a return there)
// (the callee's value with P: the call's)
theorem sp.c10_same(v. P): all G args W o. W in abi.World -> (ex regs. gc.regs_ok(regs, args)) ->
  (all regs o2. gc.regs_ok(regs, args) -> runs(G[regs], W, o2) -> ex r. o2 = ok(W, r) && P(fst(r))) ->
  runs(gimple.call1_0(G, args), W, o) -> o = exc(W, exc_val("stack_overflow", empty)) || (ex r. o = ok(W, r) && P(r))
proof
  fix G args W o
  assume hw rg hq h
  let OVF := exc_val("stack_overflow", empty)
  obtain o2, hc0 hrel from apply(sp.call1_0_e, h)
  have ci := apply(gc.call0_inv[Q := o2. ex r. o2 = ok(W, r) && P(fst(r))], {G}, {args}, {W}, {o2}, rg, hq, hc0)
  have _ pf _ _ := apply(ms.world_parts, hw)
  have od: "objs" in dom(W) by simp(expand(hw, abi.World))
  have os := apply(gc.objs_same, hw)
  have bk: gc.back0(W, W) = W by simp(os, pf, od)
  have ca: o2 = exc(W, OVF) -> o = exc(W, OVF) || (ex r. o = ok(W, r) && P(r)) proof
    assume e
    have oe: o = exc(W, OVF) by simp(rewrite(e, hrel))
    show by taut(oe)
  qed
  have cb: (ex w4 r. (ex r2. ok(w4, r) = ok(W, r2) && P(fst(r2))) && (o2 = ok(gc.back0(w4, W), pair(fst(r), snd(r))) || o2 = exc(gc.back0(w4, W), OVF))) ->
      o = exc(W, OVF) || (ex r. o = ok(W, r) && P(r)) proof
    assume q
    obtain w4 r, hq4 ho4 from q
    obtain r2, e42 p42 from hq4
    have w4e: w4 = W by simp(e42)
    have re: r = r2 by simp(e42)
    have pr: P(fst(r)) := rewrite(sym(re), p42)
    have k1: o2 = ok(gc.back0(w4, W), pair(fst(r), snd(r))) -> o = exc(W, OVF) || (ex r3. o = ok(W, r3) && P(r3)) proof
      assume e
      have oe0: o = ok(gc.back0(w4, W), fst(r)) by simp(rewrite(e, hrel))
      have oe := rewrite(bk, rewrite(w4e, oe0))
      show by taut((ex r3. o = ok(W, r3) && P(r3) by ex_intro({fst(r)}, taut(oe, pr))))
    qed
    have k2: o2 = exc(gc.back0(w4, W), OVF) -> o = exc(W, OVF) || (ex r3. o = ok(W, r3) && P(r3)) proof
      assume e
      have oe0: o = exc(gc.back0(w4, W), OVF) by simp(rewrite(e, hrel))
      have oe := rewrite(bk, rewrite(w4e, oe0))
      show by taut(oe)
    qed
    show by taut(ho4, k1, k2)
  qed
  have cc: (ex x e. (ex r. exc(x, e) = ok(W, r) && P(fst(r))) && o2 = exc(x, e)) -> o = exc(W, OVF) || (ex r. o = ok(W, r) && P(r)) proof
    assume q
    obtain x e, hq2 _ from q
    obtain r, hr2 _ from hq2
    show by defs(simp(hr2), ok, exc)
  qed
  have cd: (ex t. (ex r. diverge(t) = ok(W, r) && P(fst(r))) && o2 = diverge(t)) -> o = exc(W, OVF) || (ex r. o = ok(W, r) && P(r)) proof
    assume q
    obtain t, hq2 _ from q
    obtain r, hr2 _ from hq2
    show by defs(simp(hr2), ok, diverge)
  qed
  show by taut(ci, ca, cb, cc, cd)
qed

// (an operation's exception: its continuation's)
theorem sp.exc_of(s1 v. K, s1 e. X, t. D): all oc Y E. (((ex s1 v. oc = ok(s1, v) && K(s1, v)) || (ex s1 e. oc = exc(s1, e) && X(s1, e))) || (ex t. oc = diverge(t) && D(t))) ->
  oc = exc(Y, E) -> X(Y, E)
proof
  fix oc Y E
  assume hd he
  have c1: (ex s1 v. oc = ok(s1, v) && K(s1, v)) -> false proof
    assume e1
    obtain s1 v, e2 _ from e1
    have ne: !(ok(s1, v) = exc(Y, E)) by defs(simp(), ok, exc)
    show by taut(ne, trans(sym(e2), he))
  qed
  have c3: (ex t. oc = diverge(t) && D(t)) -> false proof
    assume e1
    obtain t, e2 _ from e1
    have ne: !(diverge(t) = exc(Y, E)) by defs(simp(), diverge, exc)
    show by taut(ne, trans(sym(e2), he))
  qed
  have c2: (ex s1 e. oc = exc(s1, e) && X(s1, e)) -> X(Y, E) proof
    assume e1
    obtain s1 e, e2 x from e1
    have q: s1 = Y && e = E by simp(trans(sym(e2), he))
    have q1 q2 := q
    show := rewrite(q2, rewrite(q1, x))
  qed
  show by taut(hd, c1, c2, c3)
qed

// ----------------------------------------------------------------------
//  __init_tp(td): the descriptor's fields, the thread pointer at td

// (a byte of the static TLS area, of libc's first: startup's writes, and
// __init_tls's)
theorem sp.tw_b: all g x. x in omega -> int_le(g.builtin_tls, x) -> int_lt(x, int_add(g.builtin_tls, 336)) ->
  x in startup_specs.start_writes(g) && x in startup_specs.tls_writes(g)
proof
  fix g x
  assume xo h1 h2
  have s1 := apply(sp.in_span, {g.builtin_tls}, {336}, {x}, xo, h1, h2)
  have a: x in startup_specs.start_writes(g) by defs(sel(taut(xo, s1)), startup_specs.start_writes)
  have b: x in startup_specs.tls_writes(g) by defs(sel(taut(xo, s1)), startup_specs.tls_writes)
  show by taut(a, b)
qed

theorem sp.tw_l: all g. g.libc in omega -> g.libc in startup_specs.start_writes(g) && g.libc in startup_specs.tls_writes(g)
proof
  fix g
  assume lo
  have s1 := apply(sp.in_span, {g.libc}, {1}, {g.libc}, lo, arith(lo), arith(lo))
  have a: g.libc in startup_specs.start_writes(g) by defs(sel(taut(lo, s1)), startup_specs.start_writes)
  have b: g.libc in startup_specs.tls_writes(g) by defs(sel(taut(lo, s1)), startup_specs.tls_writes)
  show by taut(a, b)
qed

// (b's bytes X: a memory, within the frame W, its word at td td)
def sp.qst(b, X, objs, W, td) := (fn_update(b, "bytes", X) in x86_64_linux.Vm && startup_specs.frame(b, fn_update(b, "bytes", X), objs, W)) &&
  gimple.bytes_at(fn_update(b, "bytes", X), td, 8) = td

// (n bytes at a: addresses, in W)
abbrev sp.rng(a, n, W) := ((a in bits(64) && n in omega) && int_le(int_add(a, n), 18446744073709551616)) && (all i. i in omega -> int_lt(i, n) -> int_add(a, i) in W)

// (a store in W, apart from td's word: qst kept)
theorem sp.q_peel(b, X, objs, W, td, a, n, v): sp.rng(a, n, W) -> int_le(int_add(a, n), td) || int_le(int_add(td, 8), a) -> td in bits(64) ->
  int_le(int_add(td, 8), 18446744073709551616) -> sp.qst(b, X, objs, W, td) -> sp.qst(b, x86_64_linux.store_le(X, a, n, v), objs, W, td)
proof
  assume hr hap htd ht8 hq
  have ab no le hin := hr
  have qv qf qb := expand(hq, sp.qst)
  let M := fn_update(b, "bytes", X)
  have e: fn_update(M, "bytes", x86_64_linux.store_le(M.bytes, a, n, v)) = fn_update(b, "bytes", x86_64_linux.store_le(X, a, n, v)) by simp()
  have v2 := rewrite(e, apply(ms.wr_any, {M}, {a}, {n}, {v}, qv))
  have og: all i. i in omega -> int_lt(i, n) -> int_add(a, i) in W || abi.stack_free(b, objs, int_add(a, i)) proof
    fix i
    assume hi hil
    show by taut(mp(all_elim(hin, {i}), hi, hil))
  qed
  have f2 := rewrite(e, apply(sp.fr_store[b := b, U := M, objs := objs, W := W, a := a, n := n, v := v], qf, ab, no, le, og))
  let U := fn_update(b, "bytes", x86_64_linux.store_le(X, a, n, v))
  have out: all x. x in bits(64) -> !(int_le(a, x) && int_lt(x, int_add(a, n))) -> U.bytes[x] = M.bytes[x] proof
    fix x
    assume hx hno
    have ne: all i. i in omega -> int_lt(i, n) -> !(bits_add(64, a, bits_of_int(64, i)) = x) proof
      fix i
      assume hi hil
      have ea := apply(ms.add_i, {a}, {i}, arith(ab), hi, arith(ab, le, hi, hil))
      show by arith(ea, hno, hi, hil, ab)
    qed
    have so := apply(x86.store_outside, {X}, {a}, {n}, {v}, {x}, hx, ne)
    show by simp(so)
  qed
  have r := apply(g.read_outside[U := U, M := M, b := a, m := n, a := td, n := 8], out, taut(hap), arith(htd), simp(), ht8)
  have b2: gimple.bytes_at(U, td, 8) = td := trans(r, qb)
  show by defs(taut(v2, f2, b2), sp.qst)
qed

// (td's word stored at td: qst)
theorem sp.q_base(b, objs, W, td): b in x86_64_linux.Vm -> td in bits(64) -> sp.rng(int_add(td, 0), 8, W) ->
  sp.qst(b, x86_64_linux.store_le(b.bytes, int_add(td, 0), 8, td), objs, W, td)
proof
  assume hb htd hr
  have ab no le hin := hr
  have v2 := apply(ms.wr_any, {b}, {int_add(td, 0)}, {8}, {td}, hb)
  have og: all i. i in omega -> int_lt(i, 8) -> int_add(int_add(td, 0), i) in W || abi.stack_free(b, objs, int_add(int_add(td, 0), i)) proof
    fix i
    assume hi hil
    show by taut(mp(all_elim(hin, {i}), hi, hil))
  qed
  have f2 := apply(sp.fr_store[b := b, U := b, objs := objs, W := W, a := int_add(td, 0), n := 8, v := td], apply(sp.fr_self[b := b, objs := objs, W := W], hb), ab, no, le, og)
  have b2: gimple.bytes_at(fn_update(b, "bytes", x86_64_linux.store_le(b.bytes, int_add(td, 0), 8, td)), td, 8) = td by mem(htd, le)
  show by defs(taut(v2, f2, b2), sp.qst)
qed

// its outcomes: an overflow (the thread pointer any), or the memory within
// __init_tls's frame, the descriptor's first word its address, the thread
// pointer td, its id set (not 0), 0 returned
abbrev sp.itp_out(g, s, td, o) := sp.ovf_any(s, o) ||
  (ex V. (((V in x86_64_linux.Vm && startup_specs.frame(s.vm, V, s.objs, startup_specs.tls_writes(g))) && gimple.bytes_at(V, td, 8) = td) &&
    !(gimple.bytes_at(V, int_add(td, 48), 4) = 0)) && o = ok(fn_update(fn_update(s, "vm", V), "fs_base", td), 0))

// (the return: its memory b's bytes X, qst, the id)
theorem sp.itp_close(g, s, td, o, U, X): o = ok(fn_update(fn_update(fn_update(s, "vm", U), "fs_base", td), "vm", fn_update(s.vm, "bytes", X)), 0) ->
  sp.qst(s.vm, X, s.objs, startup_specs.tls_writes(g), td) -> !(gimple.bytes_at(fn_update(s.vm, "bytes", X), int_add(td, 48), 4) = 0) -> sp.itp_out(g, s, td, o)
proof
  assume ho hq hid
  have qv qf qb := expand(hq, sp.qst)
  have e: fn_update(fn_update(fn_update(s, "vm", U), "fs_base", td), "vm", fn_update(s.vm, "bytes", X)) = fn_update(fn_update(s, "vm", fn_update(s.vm, "bytes", X)), "fs_base", td) by simp()
  have x: ex V. (((V in x86_64_linux.Vm && startup_specs.frame(s.vm, V, s.objs, startup_specs.tls_writes(g))) && gimple.bytes_at(V, td, 8) = td) &&
    !(gimple.bytes_at(V, int_add(td, 48), 4) = 0)) && o = ok(fn_update(fn_update(s, "vm", V), "fs_base", td), 0) by ex_intro({fn_update(s.vm, "bytes", X)}, taut(qv, qf, qb, hid, rewrite(e, ho)))
  show by taut(x)
qed

theorem sp.itp_run: all g td SA S1 s o. s in abi.World -> runs(c_src_env___init_tls.__init_tp(td, SA, S1), s, o) -> td in bits(64) ->
  g.libc = c_src_env___init_tls.__libc -> g.builtin_tls = c_src_env___init_tls.builtin_tls -> g.sysinfo = c_src_env___init_tls.__sysinfo ->
  mp.calls(SA, musl_asm.__set_thread_area_fun()) -> mp.calls(S1, c_src_env___init_tls.__syscall1_fun()) ->
  startup_specs.globals_ok(s.vm, s.objs, g) -> int_le(c_src_env___init_tls.builtin_tls, td) -> int_le(int_add(td, 200), int_add(c_src_env___init_tls.builtin_tls, 336)) ->
  sp.itp_out(g, s, td, o)
proof
  fix g td SA S1 s o
  assume hw hr htd hgL hgB hgS hSA hS1 hglob hb1 hb2
  have pu := apply(g.runs_univ, expand(hr, c_src_env___init_tls.__init_tp))
  have hu: s in univ(1) by simp(pu)
  have sv pf pd sb := apply(ms.world_parts, hw)
  have btv: c_src_env___init_tls.builtin_tls = 4228288 by defs(refl({4228288}), c_src_env___init_tls.builtin_tls)
  have lbv: c_src_env___init_tls.__libc = 4227136 by defs(refl({4227136}), c_src_env___init_tls.__libc)
  have tdo: td in omega by arith(htd)
  // (the descriptor's bytes: startup's writes, usable)
  have rT: all off n x. off in omega -> int_le(int_add(off, n), 200) -> x in omega -> int_le(int_add(td, off), x) -> int_lt(x, int_add(int_add(td, off), n)) ->
      x in startup_specs.start_writes(g) proof
    fix off n x
    assume ho hn xo h1 h2
    have a _ := apply(sp.tw_b, {g}, {x}, xo, arith(hgB, hb1, ho, h1), arith(hgB, hb2, hn, h2))
    show := a
  qed
