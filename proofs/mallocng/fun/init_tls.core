        let X9 := x86_64_linux.store_le(X8, int_add(td, 24), 8, bits_of_int(64, gimple.bytes_at(fn_update(s.vm, "bytes", X8), int_add(td, 16), 8)))
        let OBJ := s.objs
        have q1 := apply(sp.q_base[b := s.vm, objs := OBJ, W := TW, td := td], sv, htd, r0)
        have q2 := apply(sp.q_peel[b := s.vm, X := X1, objs := OBJ, W := TW, td := td, a := int_add(LIB, 0), n := 1, v := 1], rL,
          (int_le(int_add(int_add(LIB, 0), 1), td) || int_le(int_add(td, 8), int_add(LIB, 0)) by arith(lbv, hb1, btv)), htd, t8, q1)
        have q3 := apply(sp.q_peel[b := s.vm, X := X2, objs := OBJ, W := TW, td := td, a := int_add(td, 56), n := 4, v := 2], r56,
          (int_le(int_add(int_add(td, 56), 4), td) || int_le(int_add(td, 8), int_add(td, 56)) by arith(tdo)), htd, t8, q2)
        have q4 := apply(sp.q_peel[b := s.vm, X := X3, objs := OBJ, W := TW, td := td, a := int_add(td, 48), n := 4, v := bits_of_int(32, tid)], r48,
          (int_le(int_add(int_add(td, 48), 4), td) || int_le(int_add(td, 8), int_add(td, 48)) by arith(tdo)), htd, t8, q3)
        have q5 := apply(sp.q_peel[b := s.vm, X := X4, objs := OBJ, W := TW, td := td, a := int_add(td, 168), n := 8, v := int_add(LIB, gimple.sval(T64, 56))], r168,
          (int_le(int_add(int_add(td, 168), 8), td) || int_le(int_add(td, 8), int_add(td, 168)) by arith(tdo)), htd, t8, q4)
        have q6 := apply(sp.q_peel[b := s.vm, X := X5, objs := OBJ, W := TW, td := td, a := int_add(A136, 0), n := 8, v := A136], r136,
          (int_le(int_add(int_add(A136, 0), 8), td) || int_le(int_add(td, 8), int_add(A136, 0)) by arith(e136, tdo)), htd, t8, q5)
        have q7 := apply(sp.q_peel[b := s.vm, X := X6, objs := OBJ, W := TW, td := td, a := int_add(td, 32), n := 8,
          v := bits_of_int(64, gimple.bytes_at(fn_update(s.vm, "bytes", X6), int_add(SYS0, 0), 8))], r32,
          (int_le(int_add(int_add(td, 32), 8), td) || int_le(int_add(td, 8), int_add(td, 32)) by arith(tdo)), htd, t8, q6)
        have q8 := apply(sp.q_peel[b := s.vm, X := X7, objs := OBJ, W := TW, td := td, a := int_add(td, 16), n := 8, v := td], r16,
          (int_le(int_add(int_add(td, 16), 8), td) || int_le(int_add(td, 8), int_add(td, 16)) by arith(tdo)), htd, t8, q7)
        have q9 := apply(sp.q_peel[b := s.vm, X := X8, objs := OBJ, W := TW, td := td, a := int_add(td, 24), n := 8,
          v := bits_of_int(64, gimple.bytes_at(fn_update(s.vm, "bytes", X8), int_add(td, 16), 8))], r24,
          (int_le(int_add(int_add(td, 24), 8), td) || int_le(int_add(td, 8), int_add(td, 24)) by arith(tdo)), htd, t8, q8)
        show := apply(sp.itp_close[g := g, s := s, td := td, o := o, U := U1, X := X9], h3, q9)
      qed
      show by taut(cs, j1, j2)
    qed
    show by taut(ho4, k1, k2)
  qed
  show by taut(ci, cA, cB, cC, cD)
qed
