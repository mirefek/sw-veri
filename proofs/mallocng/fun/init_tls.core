        let X1 := x86_64_linux.store_le(s.vm.bytes, int_add(td, 0), 8, td)
        let X2 := x86_64_linux.store_le(X1, int_add(LIB, 0), 1, 1)
        let X3 := x86_64_linux.store_le(X2, int_add(td, 56), 4, 2)
        let X4 := x86_64_linux.store_le(X3, int_add(td, 48), 4, bits_of_int(32, tid))
        let X5 := x86_64_linux.store_le(X4, int_add(td, 168), 8, int_add(LIB, gimple.sval(T64, 56)))
        let X6 := x86_64_linux.store_le(X5, int_add(A136, 0), 8, A136)
        let X7 := x86_64_linux.store_le(X6, int_add(td, 32), 8, bits_of_int(64, gimple.bytes_at(fn_update(s.vm, "bytes", X6), int_add(SYS0, 0), 8)))
        let X8 := x86_64_linux.store_le(X7, int_add(td, 16), 8, td)
        let X9 := x86_64_linux.store_le(X8, int_add(td, 24), 8, bits_of_int(64, gimple.bytes_at(fn_update(s.vm, "bytes", X8), int_add(td, 16), 8)))
        let OBJ := s.objs
        have q1 := apply(sp.q_base[b := s.vm, objs := OBJ, W := TW, td := td], sv, htd, r0)
        have q2 := apply(sp.q_peel[b := s.vm, X := X1, objs := OBJ, W := TW, td := td, a := int_add(LIB, 0), n := 1, v := 1], rL,
          (int_le(int_add(int_add(LIB, 0), 1), td) || int_le(int_add(td, 8), int_add(LIB, 0)) by arith(lbv, hb1, btv)), htd, t8, q1)
        have q3 := apply(sp.q_peel[b := s.vm, X := X2, objs := OBJ, W := TW, td := td, a := int_add(td, 56), n := 4, v := 2], r56,
          (int_le(int_add(int_add(td, 56), 4), td) || int_le(int_add(td, 8), int_add(td, 56)) by arith(tdo)), htd, t8, q2)
        have q4 := apply(sp.q_peel[b := s.vm, X := X3, objs := OBJ, W := TW, td := td, a := int_add(td, 48), n := 4, v := bits_of_int(32, tid)], r48,
          (int_le(int_add(int_add(td, 48), 4), td) || int_le(int_add(td, 8), int_add(td, 48)) by arith(tdo)), htd, t8, q3)
        have q5 := apply(sp.q_peel[b := s.vm, X := X4, objs := OBJ, W := TW, td := td, a := int_add(td, 168), n := 8, v := int_add(LIB, gimple.sval(T64, 56))], r168,
          (int_le(int_add(int_add(td, 168), 8), td) || int_le(int_add(td, 8), int_add(td, 168)) by arith(tdo)), htd, t8, q4)
        have q6 := apply(sp.q_peel[b := s.vm, X := X5, objs := OBJ, W := TW, td := td, a := int_add(A136, 0), n := 8, v := A136], r136,
          (int_le(int_add(int_add(A136, 0), 8), td) || int_le(int_add(td, 8), int_add(A136, 0)) by arith(e136, tdo)), htd, t8, q5)
        have q7 := apply(sp.q_peel[b := s.vm, X := X6, objs := OBJ, W := TW, td := td, a := int_add(td, 32), n := 8,
          v := bits_of_int(64, gimple.bytes_at(fn_update(s.vm, "bytes", X6), int_add(SYS0, 0), 8))], r32,
          (int_le(int_add(int_add(td, 32), 8), td) || int_le(int_add(td, 8), int_add(td, 32)) by arith(tdo)), htd, t8, q6)
        have q8 := apply(sp.q_peel[b := s.vm, X := X7, objs := OBJ, W := TW, td := td, a := int_add(td, 16), n := 8, v := td], r16,
          (int_le(int_add(int_add(td, 16), 8), td) || int_le(int_add(td, 8), int_add(td, 16)) by arith(tdo)), htd, t8, q7)
        have q9 := apply(sp.q_peel[b := s.vm, X := X8, objs := OBJ, W := TW, td := td, a := int_add(td, 24), n := 8,
          v := bits_of_int(64, gimple.bytes_at(fn_update(s.vm, "bytes", X8), int_add(td, 16), 8))], r24,
          (int_le(int_add(int_add(td, 24), 8), td) || int_le(int_add(td, 8), int_add(td, 24)) by arith(tdo)), htd, t8, q8)
        // the thread's id: stored at td + 48, the later stores apart
        have i9: gimple.bytes_at(fn_update(s.vm, "bytes", X9), int_add(td, 48), 4) = bits_of_int(32, tid) by mem(htd, tdo, hb2, btv, e136)
        have i32: bits_of_int(32, tid) = tid by defs(arith(tb, t0, t1), bits_of_int, pow2)
        have inz: !(gimple.bytes_at(fn_update(s.vm, "bytes", X9), int_add(td, 48), 4) = 0) by arith(i9, i32, t0)
        show := apply(sp.itp_close[g := g, s := s, td := td, o := o, U := U1, X := X9], h3, q9, inz)
      qed
      show by taut(cs, j1, j2)
    qed
    show by taut(ho4, k1, k2)
  qed
  show by taut(ci, cA, cB, cC, cD)
qed

// ----------------------------------------------------------------------
//  __copy_tls(builtin_tls): no TLS module; the descriptor at its end,
//  aligned (builtin_tls + 24), its dtv the area's start

abbrev sp.ctl_out(g, s, o) := ex V. (V in x86_64_linux.Vm && startup_specs.frame(s.vm, V, s.objs, startup_specs.tls_writes(g))) &&
  o = ok(fn_update(s, "vm", V), int_add(c_src_env___init_tls.builtin_tls, 24))

theorem sp.ctl_run: all g MC s o. s in abi.World -> runs(c_src_env___init_tls.__copy_tls(c_src_env___init_tls.builtin_tls, MC), s, o) ->
  g.libc = c_src_env___init_tls.__libc -> g.builtin_tls = c_src_env___init_tls.builtin_tls -> startup_specs.globals_ok(s.vm, s.objs, g) ->
  gimple.bytes_at(s.vm, int_add(c_src_env___init_tls.__libc, 16), 8) = 0 -> gimple.bytes_at(s.vm, int_add(c_src_env___init_tls.__libc, 24), 8) = 224 ->
  gimple.bytes_at(s.vm, int_add(c_src_env___init_tls.__libc, 32), 8) = 8 -> gimple.bytes_at(s.vm, int_add(c_src_env___init_tls.__libc, 40), 8) = 0 ->
  sp.ctl_out(g, s, o)
proof
  fix g MC s o
  assume hw hr hgL hgB hglob hhd hsz hal hcn
  have pu := apply(g.runs_univ, expand(hr, c_src_env___init_tls.__copy_tls))
  have hu: s in univ(1) by simp(pu)
  have sv pf pd sb := apply(ms.world_parts, hw)
  let LIB := c_src_env___init_tls.__libc
  let BT := c_src_env___init_tls.builtin_tls
  have btv: BT = 4228288 by defs(refl({4228288}), c_src_env___init_tls.builtin_tls)
  have lbv: LIB = 4227136 by defs(refl({4227136}), c_src_env___init_tls.__libc)
  have lb: LIB in bits(64) by defs(simp(), c_src_env___init_tls.__libc)
  have bb: BT in bits(64) by defs(simp(), c_src_env___init_tls.builtin_tls)
  // (libc's TLS fields, bytes 16 to 48: readable)
  have rL: all x. x in omega -> int_le(int_add(g.libc, 16), x) -> int_lt(x, int_add(int_add(g.libc, 16), 32)) -> x in startup_specs.start_writes(g) proof
    fix x
    assume xo h1 h2
    show := apply(sp.sw_libc8, {g}, {x}, rewrite(sym(hgL), lb), arith(hgL, lbv), xo, arith(h1), arith(h2))
  qed
  have _ ul := apply(sp.glob_usable, {g}, {s.vm}, {s.objs}, {int_add(g.libc, 16)}, {32}, hglob, arith(hgL, lbv), rL)
  have ul2: gimple.usable(s.vm, s.objs, int_add(LIB, 16), 32, false) := rewrite(hgL, ul)
  have u16 := apply(mp.usable_sub[vm := s.vm, objs := s.objs, a := int_add(LIB, 16), n := 32, k := 0, m := 8, w := false], simp(), simp(), simp(), ul2)
  have u24 := apply(mp.usable_sub[vm := s.vm, objs := s.objs, a := int_add(LIB, 16), n := 32, k := 8, m := 8, w := false], simp(), simp(), simp(), ul2)
  have u32 := apply(mp.usable_sub[vm := s.vm, objs := s.objs, a := int_add(LIB, 16), n := 32, k := 16, m := 8, w := false], simp(), simp(), simp(), ul2)
  have u40 := apply(mp.usable_sub[vm := s.vm, objs := s.objs, a := int_add(LIB, 16), n := 32, k := 24, m := 8, w := false], simp(), simp(), simp(), ul2)
  have m16: g.mem_defined(s, LIB, 16, 8, false) by simp(lbv, u16)
  have m24: g.mem_defined(s, LIB, 24, 8, false) by simp(lbv, u24)
  have m32: g.mem_defined(s, LIB, 32, 8, false) by simp(lbv, u32)
  have m40: g.mem_defined(s, LIB, 40, 8, false) by simp(lbv, u40)
  unfold c_src_env___init_tls.__copy_tls c_src_env___init_tls.__libc_tls_size c_src_env___init_tls.__libc_tls_align c_src_env___init_tls.__libc_tls_head c_src_env___init_tls.__libc_tls_cnt c_src_env___init_tls.set___pthread_dtv in hr
  have e16: bits_of_int(64, gimple.bytes_at(s.vm, int_add(LIB, 16), 8)) = 0 by simp(hhd)
  have e24: bits_of_int(64, gimple.bytes_at(s.vm, int_add(LIB, 24), 8)) = 224 by simp(hsz)
  have e32: bits_of_int(64, gimple.bytes_at(s.vm, int_add(LIB, 32), 8)) = 8 by simp(hal)
  have e40: bits_of_int(64, gimple.bytes_at(s.vm, int_add(LIB, 40), 8)) = 0 by simp(hcn)
  step a1 a2 a3 a4 a5, h1 from hr with g.ld64_det, g.padd_det, e16, e24, e32 using conj(hu, lb, bb, m16, m24, m32, m40, btv)
  obtain r, wl kr from h1
  // the modules' loop: none (the list's head 0)
  let T64 := fn_update(fn_update(empty, "prec", 64), "signed", true)
  let M24 := int_add(BT, gimple.sval(T64, bits_add(64, 224, bits_neg(64, 200))))
  let TD := int_add(M24, gimple.sval(T64, bits_sub(64, 0, bits_and(64, bits_add(64, 8, bits_neg(64, 1)), M24))))
  let L0 := pair(s, pair(TD, pair(BT, pair(1, pair(0, pair(a4, TD))))))
  let BODY(x, y) := loop_body(wl)
  have nx: all x x2. x = L0 -> BODY(x, ok(x2, empty)) -> x2 = L0 && int_lt(0, 0) proof
    fix x x2
    assume hp hb
    step eT from rewrite(hp, hb)
    show by defs(simp(eT), ok, exc)
  qed
  have wv := apply(g.loop[b := x y. BODY(x, y), p := x. x = L0, m := x. 0], refl({L0}), (all x. x = L0 -> 0 in omega by simp()), nx, wl)
  obtain x, hpl bb nk from wv
  step y, eB from rewrite(hpl, bb)
  have tde: TD = int_add(BT, 24) by defs(simp(btv), gimple.sval)
  // the dtv: the module count at the area's start, the descriptor's dtv
  have rB: all x. x in omega -> int_le(BT, x) -> int_lt(x, int_add(BT, 336)) -> x in startup_specs.start_writes(g) proof
    fix x
    assume xo h1 h2
    have a _ := apply(sp.tw_b, {g}, {x}, xo, arith(hgB, h1), arith(hgB, h2))
    show := a
  qed
  have ub _ := apply(sp.glob_usable, {g}, {s.vm}, {s.objs}, {BT}, {336}, hglob, arith(btv), rB)
  have ub0 := apply(mp.usable_sub[vm := s.vm, objs := s.objs, a := BT, n := 336, k := 0, m := 8, w := true], simp(), simp(), simp(), ub)
  have ub32 := apply(mp.usable_sub[vm := s.vm, objs := s.objs, a := BT, n := 336, k := 32, m := 8, w := true], simp(), simp(), simp(), ub)
  have md0: g.mem_defined(s, BT, 0, 8, true) by simp(btv, ub0)
  have ut8: gimple.usable(s.vm, s.objs, int_add(TD, 8), 8, true) by simp(tde, btv, ub32)
  have tdb: TD in bits(64) by simp(tde, btv)
  step h2 from rewrite(eB, kr) with g.ld64_det, g.st64_det, e40 using conj(hw, hu, lb, bb, m40, md0, ut8, tdb, tde, btv, sv, pf, pd)
  // the memory: the two words in the static TLS area
  let TW := startup_specs.tls_writes(g)
  let X1 := x86_64_linux.store_le(s.vm.bytes, int_add(BT, 0), 8, 0)
  let A8 := int_add(int_add(BT, 24), 8)
  let V := fn_update(s.vm, "bytes", x86_64_linux.store_le(X1, A8, 8, BT))
  have og: all a n. a in omega -> n in omega -> int_le(BT, a) -> int_le(int_add(a, n), int_add(BT, 336)) ->
      (all i. i in omega -> int_lt(i, n) -> int_add(a, i) in TW || abi.stack_free(s.vm, s.objs, int_add(a, i))) proof
    fix a n
    assume ao no h1 h2
    fix i
    assume hi hil
    have _ b := apply(sp.tw_b, {g}, {int_add(a, i)}, arith(ao, hi), arith(hgB, h1, hi), arith(hgB, h2, hil, hi))
    show by taut(b)
  qed
  have F1 := apply(sp.fr_store[b := s.vm, U := s.vm, objs := s.objs, W := TW, a := int_add(BT, 0), n := 8, v := 0], apply(sp.fr_self[b := s.vm, objs := s.objs, W := TW], sv),
    arith(bb), simp(), arith(btv), mp(all_elim(og, {int_add(BT, 0)}, {8}), arith(btv), simp(), arith(btv), arith(btv)))
  have F2 := apply(sp.fr_store[b := s.vm, U := fn_update(s.vm, "bytes", X1), objs := s.objs, W := TW, a := A8, n := 8, v := BT], F1,
    arith(btv), simp(), arith(btv), mp(all_elim(og, {A8}, {8}), arith(btv), simp(), arith(btv), arith(btv)))
  have fr: startup_specs.frame(s.vm, V, s.objs, TW) by simp(F2, keep(startup_specs.frame))
  have v1 := apply(ms.wr_any, {s.vm}, {int_add(BT, 0)}, {8}, {0}, sv)
  have vV: V in x86_64_linux.Vm by simp(apply(ms.wr_any, {fn_update(s.vm, "bytes", X1)}, {A8}, {8}, {BT}, v1))
  have oe := rewrite(tde, h2)
  show by ex_intro({V}, taut(vV, fr, oe))
qed

// ----------------------------------------------------------------------
//  __copy_tls and __init_tp at a call

theorem sp.ctl_q: all g MC t regs o2. t in abi.World -> t in univ(1) -> gc.regs_ok(regs, seq_one(gimple.arg(64, c_src_env___init_tls.builtin_tls))) ->
  runs(c_src_env___init_tls.__copy_tls_fun(MC)[regs], t, o2) ->
  g.libc = c_src_env___init_tls.__libc -> g.builtin_tls = c_src_env___init_tls.builtin_tls -> startup_specs.globals_ok(t.vm, t.objs, g) ->
  gimple.bytes_at(t.vm, int_add(c_src_env___init_tls.__libc, 16), 8) = 0 -> gimple.bytes_at(t.vm, int_add(c_src_env___init_tls.__libc, 24), 8) = 224 ->
  gimple.bytes_at(t.vm, int_add(c_src_env___init_tls.__libc, 32), 8) = 8 -> gimple.bytes_at(t.vm, int_add(c_src_env___init_tls.__libc, 40), 8) = 0 ->
  ex V r. ((V in x86_64_linux.Vm && startup_specs.frame(t.vm, V, t.objs, startup_specs.tls_writes(g))) && o2 = ok(fn_update(t, "vm", V), r)) &&
    fst(r) = int_add(c_src_env___init_tls.builtin_tls, 24)
proof
  fix g MC t regs o2
  assume hw hu hro h hgL hgB hglob hhd hsz hal hcn
  let BT := c_src_env___init_tls.builtin_tls
  let ARGS := seq_one(gimple.arg(64, BT))
  have bb: BT in bits(64) by defs(simp(), c_src_env___init_tls.builtin_tls)
  have rl rln _ := hro
  have an: seq_len(ARGS) = 1 by simp()
  have rn: seq_len(regs) = 1 := trans(rln, an)
  have lo: seq_len(regs) in omega by simp(rn)
  have q0 := apply(gc.reg_at[regs := regs, args := ARGS, i := 0, w := 64, x := BT], hro, simp(), simp(an), at({ARGS[0]}), simp(), bb)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, c_src_env___init_tls.__copy_tls_fun, app_fn_build, ra in h
  have o1l: ord_le(1, seq_len(regs)) by defs(simp(rn), ord_le)
  have b := rewrite(q0, apply(g.runs_elim, h))
  have b2: bind_rel(c_src_env___init_tls.__copy_tls(BT, MC), t, x3 x4. letin(x4, x5. bind_rel(gimple.result(64, x5), x3, x6 x7. any_rel(x8. x8 in bits(64), x8. o2 = ok(x6, pair(x7, x8))),
      x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))), x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3)) by taut(b, o1l)
  obtain o3, hs3 hk3 from expand(b2, bind_rel)
  have co := apply(sp.ctl_run, {g}, {MC}, {t}, {o3}, hw, hs3, hgL, hgB, hglob, hhd, hsz, hal, hcn)
  obtain V, hV hfr e3 from co
  let TV := fn_update(t, "vm", V)
  have tdb: int_add(BT, 24) in bits(64) by defs(simp(), c_src_env___init_tls.builtin_tls)
  have k1: bind_rel(gimple.result(64, int_add(BT, 24)), TV, x6 x7. any_rel(x8. x8 in bits(64), x8. o2 = ok(x6, pair(x7, x8))), x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))
    by simp(expand(rewrite(e3, hk3), letin), keep(bind_rel, gimple.result))
  obtain o4, hr4 hk4 from expand(k1, bind_rel)
  have ho4 := apply(g.result64_inv, tdb, hr4)
  have k2: any_rel(x8. x8 in bits(64), x8. o2 = ok(TV, pair(int_add(BT, 24), x8))) by simp(rewrite(ho4, hk4), keep(any_rel))
  obtain y, hy hoy from apply(g.any_e, (ex y. y in bits(64) by ex_intro({0}, simp())), k2)
  show by ex_intro({V}, {pair(int_add(BT, 24), y)}, taut(hV, hfr, hoy, (fst(pair(int_add(BT, 24), y)) = int_add(BT, 24) by simp())))
qed

// (__init_tp's outcomes at a call: an overflow, or itp_out's memory, 0
// returned)
abbrev sp.itq_out(g, t, td, o2) := sp.ovf_any(t, o2) ||
  (ex V r. ((((V in x86_64_linux.Vm && startup_specs.frame(t.vm, V, t.objs, startup_specs.tls_writes(g))) && gimple.bytes_at(V, td, 8) = td) &&
    !(gimple.bytes_at(V, int_add(td, 48), 4) = 0)) && o2 = ok(fn_update(fn_update(t, "vm", V), "fs_base", td), r)) && bits_of_int(32, fst(r)) = 0)

theorem sp.itp_q: all g td SA S1 t regs o2. t in abi.World -> t in univ(1) -> td in bits(64) -> gc.regs_ok(regs, seq_one(gimple.arg(64, td))) ->
  runs(c_src_env___init_tls.__init_tp_fun(SA, S1)[regs], t, o2) ->
  g.libc = c_src_env___init_tls.__libc -> g.builtin_tls = c_src_env___init_tls.builtin_tls -> g.sysinfo = c_src_env___init_tls.__sysinfo ->
  mp.calls(SA, musl_asm.__set_thread_area_fun()) -> mp.calls(S1, c_src_env___init_tls.__syscall1_fun()) ->
  startup_specs.globals_ok(t.vm, t.objs, g) -> int_le(c_src_env___init_tls.builtin_tls, td) -> int_le(int_add(td, 200), int_add(c_src_env___init_tls.builtin_tls, 336)) ->
  sp.itq_out(g, t, td, o2)
proof
  fix g td SA S1 t regs o2
  assume hw hu htd hro h hgL hgB hgS hSA hS1 hglob hb1 hb2
  let ARGS := seq_one(gimple.arg(64, td))
  have rl rln _ := hro
  have an: seq_len(ARGS) = 1 by simp()
  have rn: seq_len(regs) = 1 := trans(rln, an)
  have lo: seq_len(regs) in omega by simp(rn)
  have q0 := apply(gc.reg_at[regs := regs, args := ARGS, i := 0, w := 64, x := td], hro, simp(), simp(an), at({ARGS[0]}), simp(), htd)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, c_src_env___init_tls.__init_tp_fun, app_fn_build, ra in h
  have o1l: ord_le(1, seq_len(regs)) by defs(simp(rn), ord_le)
  have b := rewrite(q0, apply(g.runs_elim, h))
  have b2: bind_rel(c_src_env___init_tls.__init_tp(td, SA, S1), t, x3 x4. letin(x4, x5. bind_rel(gimple.result(32, x5), x3, x6 x7. any_rel(x8. x8 in bits(64), x8. o2 = ok(x6, pair(x7, x8))),
      x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))), x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3)) by taut(b, o1l)
  obtain o3, hs3 hk3 from expand(b2, bind_rel)
  have go := apply(sp.itp_run, {g}, {td}, {SA}, {S1}, {t}, {o3}, hw, hs3, htd, hgL, hgB, hgS, hSA, hS1, hglob, hb1, hb2)
  have c1: sp.ovf_any(t, o3) -> sp.itq_out(g, t, td, o2) proof
    assume e
    obtain f v ob, hf hv hob e3 from expand(e, sp.ovf_any)
    have oe: o2 = exc(fn_update(fn_update(fn_update(t, "fs_base", f), "vm", v), "objs", ob), exc_val("stack_overflow", empty)) by simp(rewrite(e3, hk3))
    show by taut((sp.ovf_any(t, o2) by defs(ex_intro({f}, {v}, {ob}, taut(hf, hv, hob, oe)), sp.ovf_any)))
  qed
  have c2: (ex V. (((V in x86_64_linux.Vm && startup_specs.frame(t.vm, V, t.objs, startup_specs.tls_writes(g))) && gimple.bytes_at(V, td, 8) = td) &&
      !(gimple.bytes_at(V, int_add(td, 48), 4) = 0)) && o3 = ok(fn_update(fn_update(t, "vm", V), "fs_base", td), 0)) -> sp.itq_out(g, t, td, o2) proof
    assume e
    obtain V, hV hfr hbt hid e3 from e
    let TV := fn_update(fn_update(t, "vm", V), "fs_base", td)
    have k1: bind_rel(gimple.result(32, 0), TV, x6 x7. any_rel(x8. x8 in bits(64), x8. o2 = ok(x6, pair(x7, x8))), x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))
      by simp(expand(rewrite(e3, hk3), letin), keep(bind_rel, gimple.result))
    obtain o4, hr4 hk4 from expand(k1, bind_rel)
    obtain u, hub hu0 ho4 from apply(g.result32_inv, (0 in bits(32) by simp()), hr4)
    have k2: any_rel(x8. x8 in bits(64), x8. o2 = ok(TV, pair(u, x8))) by simp(rewrite(ho4, hk4), keep(any_rel))
    obtain y, hy hoy from apply(g.any_e, (ex y. y in bits(64) by ex_intro({0}, simp())), k2)
    have x: ex V2 r. ((((V2 in x86_64_linux.Vm && startup_specs.frame(t.vm, V2, t.objs, startup_specs.tls_writes(g))) && gimple.bytes_at(V2, td, 8) = td) &&
      !(gimple.bytes_at(V2, int_add(td, 48), 4) = 0)) && o2 = ok(fn_update(fn_update(t, "vm", V2), "fs_base", td), r)) && bits_of_int(32, fst(r)) = 0
      by ex_intro({V}, {pair(u, y)}, taut(hV, hfr, hbt, hid, hoy, (bits_of_int(32, fst(pair(u, y))) = 0 by simp(hu0))))
    show by taut(x)
  qed
  show by taut(go, c1, c2)
qed

// (48 zero bytes: their words at 8, 24 and 32 zero)
theorem sp.z48: all vm a. vm.bytes in fn_space(bits(64), bits(8)) -> a in omega -> int_lt(int_add(a, 48), 18446744073709551616) -> gimple.bytes_at(vm, a, 48) = 0 ->
  (gimple.bytes_at(vm, int_add(a, 8), 8) = 0 && gimple.bytes_at(vm, int_add(a, 24), 8) = 0) && gimple.bytes_at(vm, int_add(a, 32), 8) = 0
proof
  fix vm a
  assume hb ha hl hz
  have ab: a in bits(64) by arith(ha, hl)
  have e8: bits_add(64, a, 8) = int_add(a, 8) by defs(arith(ha, hl), bits_add, bits_of_int, pow2)
  have e16: bits_add(64, int_add(a, 8), 8) = int_add(a, 16) by defs(arith(ha, hl), bits_add, bits_of_int, pow2)
  have e24: bits_add(64, int_add(a, 16), 8) = int_add(a, 24) by defs(arith(ha, hl), bits_add, bits_of_int, pow2)
  have e32: bits_add(64, int_add(a, 24), 8) = int_add(a, 32) by defs(arith(ha, hl), bits_add, bits_of_int, pow2)
  let P8 := 18446744073709551616
  have s1: gimple.bytes_at(vm, a, 48) = int_add(gimple.bytes_at(vm, a, 8), int_mul(P8, gimple.bytes_at(vm, int_add(a, 8), 40)))
    by simp(rewrite(e8, apply(g.bytes_split, {vm}, {a}, {8}, {40}, ab, simp(), simp())))
  have s2: gimple.bytes_at(vm, int_add(a, 8), 40) = int_add(gimple.bytes_at(vm, int_add(a, 8), 8), int_mul(P8, gimple.bytes_at(vm, int_add(a, 16), 32)))
    by simp(rewrite(e16, apply(g.bytes_split, {vm}, {int_add(a, 8)}, {8}, {32}, arith(ha, hl), simp(), simp())))
  have s3: gimple.bytes_at(vm, int_add(a, 16), 32) = int_add(gimple.bytes_at(vm, int_add(a, 16), 8), int_mul(P8, gimple.bytes_at(vm, int_add(a, 24), 24)))
    by simp(rewrite(e24, apply(g.bytes_split, {vm}, {int_add(a, 16)}, {8}, {24}, arith(ha, hl), simp(), simp())))
  have s4: gimple.bytes_at(vm, int_add(a, 24), 24) = int_add(gimple.bytes_at(vm, int_add(a, 24), 8), int_mul(P8, gimple.bytes_at(vm, int_add(a, 32), 16)))
    by simp(rewrite(e32, apply(g.bytes_split, {vm}, {int_add(a, 24)}, {8}, {16}, arith(ha, hl), simp(), simp())))
  have q0 _ := apply(g.bytes_bound, {vm}, {a}, {8}, hb, simp())
  have q1 _ := apply(g.bytes_bound, {vm}, {int_add(a, 8)}, {40}, hb, simp())
  have q2 _ := apply(g.bytes_bound, {vm}, {int_add(a, 8)}, {8}, hb, simp())
  have q3 _ := apply(g.bytes_bound, {vm}, {int_add(a, 16)}, {32}, hb, simp())
  have q4 _ := apply(g.bytes_bound, {vm}, {int_add(a, 16)}, {8}, hb, simp())
  have q5 _ := apply(g.bytes_bound, {vm}, {int_add(a, 24)}, {24}, hb, simp())
  have q6 _ := apply(g.bytes_bound, {vm}, {int_add(a, 24)}, {8}, hb, simp())
  have q7 _ := apply(g.bytes_bound, {vm}, {int_add(a, 32)}, {16}, hb, simp())
  have z1: gimple.bytes_at(vm, int_add(a, 8), 40) = 0 by arith(hz, s1, q0, q1)
  have z2: gimple.bytes_at(vm, int_add(a, 8), 8) = 0 by arith(z1, s2, q2, q3)
  have z3: gimple.bytes_at(vm, int_add(a, 16), 32) = 0 by arith(z1, s2, q2, q3)
  have z4: gimple.bytes_at(vm, int_add(a, 24), 24) = 0 by arith(z3, s3, q4, q5)
  have z5: gimple.bytes_at(vm, int_add(a, 24), 8) = 0 by arith(z4, s4, q6, q7)
  have z6: gimple.bytes_at(vm, int_add(a, 32), 16) = 0 by arith(z4, s4, q6, q7)
  have e40: bits_add(64, int_add(a, 32), 8) = int_add(a, 40) by defs(arith(ha, hl), bits_add, bits_of_int, pow2)
  have s5: gimple.bytes_at(vm, int_add(a, 32), 16) = int_add(gimple.bytes_at(vm, int_add(a, 32), 8), int_mul(P8, gimple.bytes_at(vm, int_add(a, 40), 8)))
    by simp(rewrite(e40, apply(g.bytes_split, {vm}, {int_add(a, 32)}, {8}, {8}, arith(ha, hl), simp(), simp())))
  have q8 _ := apply(g.bytes_bound, {vm}, {int_add(a, 32)}, {8}, hb, simp())
  have q9 _ := apply(g.bytes_bound, {vm}, {int_add(a, 40)}, {8}, hb, simp())
  have z7: gimple.bytes_at(vm, int_add(a, 32), 8) = 0 by arith(z6, s5, q8, q9)
  show by taut(z2, z5, z7)
qed

// (a descriptor in the static TLS area, its first word its address, its
// id set: the thread set up -- its pages startup's data pages)
theorem sp.ts_from: all g vm V objs fs. startup_specs.globals_ok(vm, objs, g) -> fn_update(V, "bytes", vm.bytes) = vm -> V.bytes in fn_space(bits(64), bits(8)) ->
  startup_specs.in_tls(g, fs) -> g.builtin_tls in bits(64) -> fs in bits(64) -> !(fs = 0) -> gimple.bytes_at(V, fs, 8) = fs ->
  !(gimple.bytes_at(V, int_add(fs, 48), 4) = 0) -> startup_specs.thread_set(V, fs)
proof
  fix g vm V objs fs
  assume hg hvb hvt hit hb hfs hnz hbt hid
  have hall _ _ hbl := expand(hg, startup_specs.globals_ok)
  have it1 it2 := expand(hit, startup_specs.in_tls)
  have e48: bits_add(64, fs, 48) = int_add(fs, 48) by defs(arith(hfs, hb, it2, hbl), bits_add, bits_of_int, pow2)
  have hid2: !(gimple.bytes_at(V, bits_add(64, fs, 48), 4) = 0) by simp(e48, hid)
  have e2 := mp(app_update_other[f := V, k := "bytes", v := vm.bytes, x := "pages"], (!("pages" = "bytes") by simp()))
  have vp: V.pages = vm.pages := sym(rewrite(hvb, e2))
  have rd: all k. k in omega -> int_le(int_add(k, 8), 200) -> x86_64_linux.readable(V, int_add(fs, k), 8) &&
      (all i. i in omega -> int_lt(i, 8) -> snd(V.pages[int_div(int_add(int_add(fs, k), i), x86_64_linux.PAGE)]).prot.w &&
        !abi.stack_page(V, int_div(int_add(int_add(fs, k), i), x86_64_linux.PAGE))) proof
    fix k
    assume hk hk8
    have each: all i. i in omega -> int_lt(i, 8) -> (x86_64_linux.mapped(V, int_div(int_add(int_add(fs, k), i), x86_64_linux.PAGE)) &&
        snd(V.pages[int_div(int_add(int_add(fs, k), i), x86_64_linux.PAGE)]).prot.r) &&
        snd(V.pages[int_div(int_add(int_add(fs, k), i), x86_64_linux.PAGE)]).prot.w && !abi.stack_page(V, int_div(int_add(int_add(fs, k), i), x86_64_linux.PAGE)) proof
      fix i
      assume hi hil
      let J := int_sub(int_add(int_add(fs, k), i), g.builtin_tls)
      have jo: J in omega by arith(it1, hk, hi, hfs)
      have e: int_add(int_add(fs, k), i) = int_add(g.builtin_tls, J) by arith(hb, hfs)
      have w := apply(sp.tls_w, {g}, {J}, hb, jo, arith(it2, hk8, hil, hi))
      have pi := mp(all_elim(hall, {int_add(g.builtin_tls, J)}), arith(hb, jo), w)
      have pi2 := rewrite(sym(e), pi)
      show by defs(simp(vp, expand(pi2, x86_64_linux.mapped, abi.stack_page)), x86_64_linux.mapped, abi.stack_page)
    qed
    have r1: all i. i in omega -> int_lt(i, 8) -> x86_64_linux.mapped(V, int_div(int_add(int_add(fs, k), i), x86_64_linux.PAGE)) &&
        snd(V.pages[int_div(int_add(int_add(fs, k), i), x86_64_linux.PAGE)]).prot.r proof
      fix i
      assume hi hil
      have x := mp(all_elim(each, {i}), hi, hil)
      show by taut(x)
    qed
    have r2: all i. i in omega -> int_lt(i, 8) -> snd(V.pages[int_div(int_add(int_add(fs, k), i), x86_64_linux.PAGE)]).prot.w &&
        !abi.stack_page(V, int_div(int_add(int_add(fs, k), i), x86_64_linux.PAGE)) proof
      fix i
      assume hi hil
      have x := mp(all_elim(each, {i}), hi, hil)
      show by taut(x)
    qed
    have r3: x86_64_linux.readable(V, int_add(fs, k), 8) by defs(r1, x86_64_linux.readable)
    show by taut(r3, r2)
  qed
  have r0 r0w := mp(all_elim(rd, {0}), simp(), simp())
  have r40 r40w := mp(all_elim(rd, {40}), simp(), simp())
  have z0: int_add(fs, 0) = fs by arith(hfs)
  have le0: x86_64_linux.le(V.bytes, fs, 8) = gimple.bytes_at(V, fs, 8) := apply(x86.le8_nat, {V}, {fs}, hvt)
  have tok: abi.thread_ok(V, fs) proof
    have st: all i. i in omega -> int_lt(i, 8) -> !abi.stack_page(V, int_div(int_add(fs, i), x86_64_linux.PAGE)) proof
      fix i
      assume hi hil
      have x := rewrite(z0, mp(all_elim(r0w, {i}), hi, hil))
      show by taut(x)
    qed
    show by defs(taut(rewrite(z0, r0), st, trans(le0, hbt), hnz), abi.thread_ok)
  qed
  have cok: abi.canary_ok(V, fs) by defs(taut(r40, r40w), abi.canary_ok)
  show by defs(taut(tok, cok, hid2), startup_specs.thread_set)
qed

// (a memory's bytes stored: a memory)
theorem sp.vm_st: all M X a n v. fn_update(M, "bytes", X) in x86_64_linux.Vm -> fn_update(M, "bytes", x86_64_linux.store_le(X, a, n, v)) in x86_64_linux.Vm
proof
  fix M X a n v
  assume h
  show by simp(apply(ms.wr_any, {fn_update(M, "bytes", X)}, {a}, {n}, {v}, h))
qed

// ----------------------------------------------------------------------
//  static_init_tls (__init_tls): the program headers walked, the TLS
//  sizes, the descriptor copied into builtin_tls and the thread pointer set

abbrev sp.sit_out(g, s, o) := sp.ovf_any(s, o) ||
  (ex V fs. ((V in x86_64_linux.Vm && startup_specs.frame(s.vm, V, s.objs, startup_specs.tls_writes(g))) && fs in bits(64) &&
    startup_specs.thread_set(V, fs) && startup_specs.in_tls(g, fs)) && o = ok(fn_update(fn_update(s, "vm", V), "fs_base", fs), empty))

theorem sp.sit_run: all g aux S6 CT ITP AC MC SA S1 s o. s in abi.World -> runs(c_src_env___init_tls.static_init_tls(aux, S6, CT, ITP, AC), s, o) -> aux in bits(64) ->
  g.libc = c_src_env___init_tls.__libc -> g.builtin_tls = c_src_env___init_tls.builtin_tls -> g.sysinfo = c_src_env___init_tls.__sysinfo ->
  g.main_tls = c_src_env___init_tls.main_tls -> g.default_stacksize = c_src_env___init_tls.__default_stacksize ->
  mp.calls(CT, c_src_env___init_tls.__copy_tls_fun(MC)) -> mp.calls(ITP, c_src_env___init_tls.__init_tp_fun(SA, S1)) ->
  mp.calls(SA, musl_asm.__set_thread_area_fun()) -> mp.calls(S1, c_src_env___init_tls.__syscall1_fun()) ->
  startup_specs.init_tls_pre(s.vm, s.objs, g, aux) -> sp.sit_out(g, s, o)
proof
  fix g aux S6 CT ITP AC MC SA S1 s o
  assume hw hr hab hgL hgB hgS hgM hgD hCT hITP hSA hS1 hpre
  have pu := apply(g.runs_univ, expand(hr, c_src_env___init_tls.static_init_tls))
  have hu: s in univ(1) by simp(pu)
  have sv pf pd sb := apply(ms.world_parts, hw)
  have anz hua ha304 hap hglob htf hph := expand(hpre, startup_specs.init_tls_pre)
  have ao: aux in omega by arith(hab)
  have u24 := apply(mp.usable_sub[vm := s.vm, objs := s.objs, a := aux, n := 304, k := 24, m := 8, w := false], simp(), simp(), simp(), hua)
  have u32 := apply(mp.usable_sub[vm := s.vm, objs := s.objs, a := aux, n := 304, k := 32, m := 8, w := false], simp(), simp(), simp(), hua)
  have u40 := apply(mp.usable_sub[vm := s.vm, objs := s.objs, a := aux, n := 304, k := 40, m := 8, w := false], simp(), simp(), simp(), hua)
  have m24: g.mem_defined(s, int_add(aux, 24), 0, 8, false) by simp(u24, (!(int_add(aux, 24) = 0) by arith(ao)), (int_lt(int_add(aux, 24), pow2(64)) by defs(arith(ha304), pow2)))
  have m40: g.mem_defined(s, aux, 40, 8, false) by simp(u40, anz, (int_lt(int_add(aux, 40), pow2(64)) by defs(arith(ha304), pow2)))
  unfold c_src_env___init_tls.static_init_tls c_src_env___init_tls.Elf64_Phdr_p_type c_src_env___init_tls.Elf64_Phdr_p_vaddr c_src_env___init_tls.Elf64_Phdr_p_memsz c_src_env___init_tls.Elf64_Phdr_p_filesz c_src_env___init_tls.Elf64_Phdr_p_align c_src_env___init_tls.tls_module_size c_src_env___init_tls.tls_module_image c_src_env___init_tls.tls_module_align c_src_env___init_tls.set_tls_module_image c_src_env___init_tls.set_tls_module_len_ c_src_env___init_tls.set_tls_module_size c_src_env___init_tls.set_tls_module_align c_src_env___init_tls.set_tls_module_offset c_src_env___init_tls.set___libc_tls_cnt c_src_env___init_tls.set___libc_tls_head c_src_env___init_tls.set___libc_tls_align c_src_env___init_tls.set___libc_tls_size c_src_env___init_tls.__libc_tls_size in hr
  step b0 m0 n0 p0 ph0 tp0, h1 from hr with g.padd_det, g.ld64_det using conj(hu, hab, m24, m40)
  obtain r, wl kr from h1
  // the headers' loop: i of them walked, the memory the entry's but
  // __default_stacksize
  let T64 := fn_update(fn_update(empty, "prec", 64), "signed", true)
  let DS := c_src_env___init_tls.__default_stacksize
  let SW := startup_specs.start_writes(g)
  let PH := gimple.bytes_at(s.vm, int_add(aux, 24), 8)
  let PE := gimple.bytes_at(s.vm, int_add(aux, 32), 8)
  let PN := gimple.bytes_at(s.vm, int_add(aux, 40), 8)
  let UC(U) := (U in x86_64_linux.Vm && fn_update(U, "bytes", s.vm.bytes) = s.vm) && (all x. x in bits(64) -> !(int_le(DS, x) && int_lt(x, int_add(DS, 4))) -> U.bytes[x] = s.vm.bytes[x])
  let X(i, U, b, ph) := pair(fn_update(s, "vm", U), pair(b, pair(m0, pair(int_sub(PN, i), pair(int_add(PH, int_mul(PE, i)), pair(ph, 0))))))
  let BODY(x, y) := loop_body(wl)
  have dsv: DS = 4227080 by defs(refl({4227080}), c_src_env___init_tls.__default_stacksize)
  have ba24: bits_add(64, aux, 24) = int_add(aux, 24) by defs(arith(hab, ha304), bits_add, bits_of_int, pow2)
  have ba32: bits_add(64, aux, 32) = int_add(aux, 32) by defs(arith(hab, ha304), bits_add, bits_of_int, pow2)
  have ba40: bits_add(64, aux, 40) = int_add(aux, 40) by defs(arith(hab, ha304), bits_add, bits_of_int, pow2)
  have hph2 := rewrite(ba24, rewrite(ba32, rewrite(ba40, hph)))
  have pbd pall := expand(hph2, startup_specs.phdrs_ok)
  have pho phl := apply(g.bytes_bound, {s.vm}, {int_add(aux, 24)}, {8}, sb, simp())
  have peo pel := apply(g.bytes_bound, {s.vm}, {int_add(aux, 32)}, {8}, sb, simp())
  have pno pnl := apply(g.bytes_bound, {s.vm}, {int_add(aux, 40)}, {8}, sb, simp())
  let G(i, U, b, ph, y) := (int_lt(i, PN) && (ex U2 b2 ph2. UC(U2) && y = ok(X(int_add(i, 1), U2, b2, ph2), empty))) || (i = PN && y = exc(X(i, U, b, ph), pair("brk", empty)))
  have trip: all i U b ph y. i in omega -> int_le(i, PN) -> UC(U) -> BODY(X(i, U, b, ph), y) -> G(i, U, b, ph, y) proof
    fix i U b ph y
    assume hi hiN hU hb
    have hUv hUb hUo := hU
    have wW wu := apply(mp.am_world[s := s, V := U], hw, hu, hUv)
    have _ wf wd _ := apply(ms.world_parts, wW)
    have cEnd: i = PN -> G(i, U, b, ph, y) proof
      assume he
      have z: int_sub(PN, i) = 0 by arith(he)
      step eT from hb using conj(z)
      show by taut(he, eT)
    qed
    have cMid: int_lt(i, PN) -> G(i, U, b, ph, y) proof
      assume hl
      have nz: !(int_sub(PN, i) = 0) by arith(hl)
      let A := int_add(PH, int_mul(PE, i))
      have pnz ua nt nw := mp(all_elim(pall, {i}), hi, hl)
      have u4 := apply(mp.usable_sub[vm := s.vm, objs := s.objs, a := A, n := 56, k := 0, m := 4, w := false], simp(), simp(), simp(), ua)
      have ml := apply(ms.mul_le, {PE}, {i}, {PE}, {PN}, peo, hi, simp(peo), simp(pno), arith(peo), arith(hl))
      have al: int_lt(int_add(A, 56), int_pow(2, 63)) by arith(pbd, pho, peo, hi, ml)
      have ab: A in bits(64) by arith(pho, peo, hi, al)
      have u4U := apply(mp.usable_bytes[v := s.vm, v2 := U, objs := s.objs, a := int_add(A, 0), n := 4, w := false], hUb, u4)
      step h2 from hb with g.ld32_det using conj(wu, nz, ab, pnz, u4U, al)
      // (the header's type: read as at the entry -- the header apart from
      // __default_stacksize --, not PT_TLS)
      have aon: A in omega by arith(ab)
      have hA: all x. x in omega -> int_le(A, x) && int_lt(x, int_add(A, 56)) -> !(x in SW) proof
        fix x
        assume xo h
        have h1 h2 := h
        have e: int_add(A, int_sub(x, A)) = x by arith(aon, xo)
        show := rewrite(e, mp(all_elim(nw, {int_sub(x, A)}), arith(h1, xo, aon), arith(h2)))
      qed
      have hB: all x. x in omega -> int_le(DS, x) -> int_lt(x, int_add(DS, 4)) -> x in SW proof
        fix x
        assume xo h1 h2
        have s1 := apply(sp.in_span, {g.default_stacksize}, {4}, {x}, xo, arith(hgD, h1), arith(hgD, h2))
        show by defs(sel(taut(xo, s1)), startup_specs.start_writes)
      qed
      have apD := apply(sp.apart[W := SW, a := A, c := int_add(A, 56), b := DS, m := 4], hA, hB, aon, arith(dsv), arith(aon), arith())
      have rt := apply(g.read_outside[U := U, M := s.vm, b := DS, m := 4, a := int_add(A, 0), n := 4], hUo, arith(apD, aon), arith(aon), simp(), arith(al))
      have tyo tyl := apply(g.bytes_bound, {s.vm}, {A}, {4}, sb, simp())
      have b64 := apply(mp.boi[x := A], aon, arith(al))
      have pt: startup_specs.PT_TLS = 7 by defs(refl({7}), startup_specs.PT_TLS)
      have t32: bits_of_int(32, gimple.bytes_at(s.vm, A, 4)) = gimple.bytes_at(s.vm, A, 4) by defs(arith(tyo, tyl), bits_of_int, pow2)
      have n7: !(bits_of_int(32, gimple.bytes_at(U, int_add(A, 0), 4)) = 7) by simp(rt, t32, rewrite(pt, rewrite(b64, nt)), (int_add(A, 0) = A by arith(aon)))
      // (the next header: PE on, PE below 2^63; aux's words as at the entry)
