// ----------------------------------------------------------------------
//  exit's writes: apart from the thread's word, so the thread kept

theorem xt.th_store: all V fs a n v. abi.thread_ok(V, fs) -> fs in bits(64) -> a in bits(64) -> n in omega ->
  int_lt(int_add(fs, 8), 9223372036854775808) -> int_lt(int_add(a, n), 9223372036854775808) -> (int_le(int_add(fs, 8), a) || int_le(int_add(a, n), fs)) ->
  abi.thread_ok(fn_update(V, "bytes", x86_64_linux.store_le(V.bytes, a, n, v)), fs)
proof
  fix V fs a n v
  assume ht hf ha hn h1 h2 hd
  have far: all k. k in omega -> int_lt(k, 8) -> !int_lt(bits_sub(64, bits_add(64, fs, bits_of_int(64, k)), a), n) proof
    fix k
    assume hk hkl
    have bk: bits_of_int(64, k) = k := apply(nf.boi_in[n := 64, x := k], eval(), (k in bits(64) by arith(hk, hkl)))
    show by defs(arith(rewrite(bk, refl({bits_add(64, fs, bits_of_int(64, k))})), hk, hkl, hf, ha, hn, h1, h2, hd), bits_sub, bits_add, pow2)
  qed
  have le := apply(x86.le_store_far[b := V.bytes, r := fs, a := a, n := n, v := v], hf, ha, far)
  show := apply(ms.thread_keep, {V}, {x86_64_linux.store_le(V.bytes, a, n, v)}, {fs}, ht, le)
qed

// ----------------------------------------------------------------------
//  exit's run (its CFG form): label 2 -- the tid, the lock taken (it was
//  free: a_cas returns 0, not the tid); label 4 -- 0, no other thread
//  holds it; label 6 -- the dummies, __libc_exit_fini, _Exit's exit

abbrev xt.ST(W, b, p, t) := pair(W, pair(b, pair(p, t)))

// (the call of _Exit: an overflow or the exit, from the caller's world)
theorem xt.xe_call: all G8 S1 W c o. W in abi.World -> gc.sound(W) -> c in bits(32) ->
  mp.calls(G8, c_src_exit__Exit._Exit_fun(S1)) -> mp.calls(S1, c_src_exit__Exit.__syscall1_fun()) ->
  runs(gimple.call(G8, seq_one(gimple.arg(32, c))), W, o) ->
  (ex s1 e. o = exc(s1, e)) && (o = exc(W, exc_val("stack_overflow", empty)) || o = exc(W, xt.EXIT(bits_sext(32, 64, c))))
proof
  fix G8 S1 W c o
  assume hw ths hc hG hS r
  let OVF := exc_val("stack_overflow", empty)
  let XT := exc(W, xt.EXIT(bits_sext(32, 64, c)))
  let ARGS := seq_one(gimple.arg(32, c))
  have rex2 := apply(gc.regs1_32_ex, hc)
  have hq: all regs2 o4. gc.regs_ok(regs2, ARGS) -> runs(G8[regs2], W, o4) -> (ex s1 e. o4 = exc(s1, e)) && (o4 = exc(W, OVF) || o4 = XT) proof
    fix regs2 o4
    assume hr2 h4
    have rl2 rn2 _ := hr2
    have len2: int_le(seq_len(regs2), 6) by simp(rn2)
    have h5 := mp(all_elim(hG, {regs2}, {W}, {o4}), rl2, len2, hw, h4)
    show := mp(all_elim(xt.xe_q, {S1}, {regs2}, {W}, {c}, {o4}), hw, ths, hc, hS, hr2, h5)
  qed
  have ci := apply(gc.call_inv[Q := o4. (ex s1 e. o4 = exc(s1, e)) && (o4 = exc(W, OVF) || o4 = XT)], ths, rex2, hq, r)
  let GO := (ex s1 e. o = exc(s1, e)) && (o = exc(W, OVF) || o = XT)
  have k1: o = exc(W, OVF) -> GO proof
    assume e
    have xe: ex s2 e2. o = exc(s2, e2) by ex_intro({W}, {OVF}, e)
    show by taut(e, xe)
  qed
  have k2: (ex w4 r. ((ex s1 e. ok(w4, r) = exc(s1, e)) && (ok(w4, r) = exc(W, OVF) || ok(w4, r) = XT)) &&
      (o = ok(gc.back(w4, W), pair(fst(r), snd(r))) || o = exc(gc.back(w4, W), OVF))) -> GO proof
    assume q
    obtain w4 r, qa _ _ from q
    obtain s1 e, e1 from qa
    have f: false by defs(simp(e1), exc, ok, tag)
    show by taut(f)
  qed
  have k3: (ex x e. ((ex s1 e2. exc(x, e) = exc(s1, e2)) && (exc(x, e) = exc(W, OVF) || exc(x, e) = XT)) && o = exc(x, e)) -> GO proof
    assume q
    obtain x e, _ qb e2 from q
    have a: exc(x, e) = exc(W, OVF) -> GO proof
      assume e3
      show := mp(k1, trans(e2, e3))
    qed
    have b: exc(x, e) = XT -> GO proof
      assume e3
      have oe: o = XT := trans(e2, e3)
      have xe: ex s2 e4. o = exc(s2, e4) by ex_intro({W}, {xt.EXIT(bits_sext(32, 64, c))}, oe)
      show by taut(oe, xe)
    qed
    show by taut(qb, a, b)
  qed
  have k4: (ex t2. ((ex s1 e. diverge(t2) = exc(s1, e)) && (diverge(t2) = exc(W, OVF) || diverge(t2) = XT)) && o = diverge(t2)) -> GO proof
    assume q
    obtain t2, qa _ _ from q
    obtain s1 e, e1 from qa
    have f: false by defs(simp(e1), exc, diverge, tag)
    show by taut(f)
  qed
  show by taut(ci, k1, k2, k3, k4)
qed

theorem xt.exit_run: all G1 G2 G3 G4 G5 G6 G7 G8 c s o. s in abi.World -> s in univ(1) -> c in bits(32) ->
  runs(c_src_exit_exit_cfg.exit(c, G1, G2, G3, G4, G5, G6, G7, G8), s, o) -> true
proof
  fix G1 G2 G3 G4 G5 G6 G7 G8 c s o
  assume hw hu hc hr
  step a0 a1, h1 from hr
  obtain r, wl kr from h1
  let BODY(x, y) := loop_body(wl)
  // (label 4: prev 0 -- label 6)
  have t4: all W t y. BODY(xt.ST(W, 4, 0, t), y) -> y = ok(xt.ST(W, 6, 0, t), empty) proof
    fix W t y
    assume hb
    step i1 i2 i3, e1 from hb
    show e1
  qed
  goal
  show by taut()
qed
