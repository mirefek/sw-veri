// exit by its purpose (startup_specs.exit_spec): from a sound thread with
// the lock free and the fini_array's entry the dtors', the process ends
// with the status's low byte (or a stack overflow). The units' CFG forms
// (link_exit.core's) refine their structured ones; exit itself is proven
// on its CFG form (its `undefined` after _Exit: no cut point there).

refines ex_s1_ref c_src_exit__Exit_cfg.__syscall1_fun c_src_exit__Exit.__syscall1_fun
refines ex_xe_ref c_src_exit__Exit_cfg._Exit_fun c_src_exit__Exit._Exit_fun
refines ex_gtp_ref c_src_exit_exit_cfg.__get_tp_fun c_src_exit_exit.__get_tp_fun
refines ex_dm_ref c_src_exit_exit_cfg.dummy_fun c_src_exit_exit.dummy_fun
refines ex_fini_ref c_src_exit_exit_cfg.libc_exit_fini_fun c_src_exit_exit.libc_exit_fini_fun

// ----------------------------------------------------------------------
//  The leaves at a call

// __get_tp (exit.c's copy) at a call, the thread sound: the thread
// pointer returned, the memory as it was
theorem xt.gtp_q: all regs s o2. s in abi.World -> s in univ(1) -> abi.thread_ok(s.vm, s.fs_base) -> gc.regs_ok(regs, empty) ->
  runs(c_src_exit_exit.__get_tp_fun()[regs], s, o2) ->
  abi.ovf_out(s, o2) ||
  (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && fst(r) = s.fs_base)
proof
  fix regs s o2
  assume hw hu ht hr h
  let FS := s.fs_base
  have rl rn := apply(gc.regs0, hr)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, c_src_exit_exit.__get_tp_fun, app_fn_build, ra in h
  have pv pf pd pb := apply(ms.world_parts, hw)
  have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], pf, pd)
  have fsw: FS in bits(64) by simp(expand(hw, abi.World))
  have b := apply(g.runs_elim, h)
  obtain o3, hs3 hk3 from expand(b, bind_rel)
  step x2 x4, e3 from hs3 with ms.tp_det using conj(hw, hu, ht)
  have k1: bind_rel(gimple.result(64, FS), s, x6 x7. any_rel(x8. x8 in bits(64), x8. o2 = ok(x6, pair(x7, x8))), x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))
    by simp(expand(rewrite(e3, hk3), letin), keep(bind_rel, gimple.result))
  obtain o4, hr4 hk4 from expand(k1, bind_rel)
  have ho4 := apply(g.result64_inv, fsw, hr4)
  have k2: any_rel(x8. x8 in bits(64), x8. o2 = ok(s, pair(FS, x8))) by simp(rewrite(ho4, hk4), keep(any_rel))
  have ne: ex y. y in bits(64) by ex_intro({0}, simp())
  obtain y, hy hoy from apply(g.any_e, ne, k2)
  have hoy2: o2 = ok(fn_update(s, "vm", s.vm), pair(FS, y)) by simp(hoy, ss)
  have l: ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && fst(r) = FS by ex_intro({pair(FS, y)}, taut(hoy2, (fst(pair(FS, y)) = FS by simp())))
  show by taut(l)
qed

// the dummy (__funcs_on_exit, __stdio_exit) at a call: the memory as it
// was
theorem xt.dm_q: all regs s o2. s in abi.World -> s in univ(1) -> gc.regs_ok(regs, empty) ->
  runs(c_src_exit_exit.dummy_fun()[regs], s, o2) ->
  abi.ovf_out(s, o2) || (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && fst(r) in bits(64))
proof
  fix regs s o2
  assume hw hu hr h
  have rl rn := apply(gc.regs0, hr)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, c_src_exit_exit.dummy_fun, app_fn_build, ra in h
  have pv pf pd pb := apply(ms.world_parts, hw)
  have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], pf, pd)
  have b := apply(g.runs_elim, h)
  obtain o3, hs3 hk3 from expand(b, bind_rel)
  step e3 from hs3
  have k2: any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o2 = ok(s, pair(x5, x6)))) by simp(rewrite(e3, hk3), keep(any_rel))
  have ne: ex y. y in bits(64) by ex_intro({0}, simp())
  obtain y1, hy1 k3 from apply(g.any_e, ne, k2)
  obtain y2, hy2 hoy from apply(g.any_e, ne, k3)
  have oy: o2 = ok(fn_update(s, "vm", s.vm), pair(y1, y2)) by simp(hoy, ss)
  have fy: fst(pair(y1, y2)) in bits(64) by simp(hy1)
  have l: ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && fst(r) in bits(64) by ex_intro({pair(y1, y2)}, taut(oy, fy))
  show by taut(l)
qed

// ----------------------------------------------------------------------
//  The exit raise: exit_group / exit, through __syscall1 and _Exit

// (a program that only raises, bound: its raise handler, at a raise Q
// holds of)
theorem xt.bind_raise(p, s1 v. k, s1 e. x, t. d, o. Q): all s. (all o. runs(p, s, o) -> (ex s1 e. o = exc(s1, e)) && Q(o)) ->
  bind_rel(p, s, s1 v. k(s1, v), s1 e. x(s1, e), t. d(t)) -> ex s1 e. Q(exc(s1, e)) && x(s1, e)
proof
  fix s
  assume hq hb
  obtain o, hr hd from apply(g.bind_open, hb)
  have ex1 hQ := mp(all_elim(hq, {o}), hr)
  obtain s1 e, eo from ex1
  have c1: (ex s2 v. o = ok(s2, v) && k(s2, v)) -> false proof
    assume q
    obtain s2 v, e2 _ from q
    show by defs(simp(trans(sym(eo), e2)), exc, ok, tag)
  qed
  have c3: (ex t. o = diverge(t) && d(t)) -> false proof
    assume q
    obtain t, e2 _ from q
    show by defs(simp(trans(sym(eo), e2)), exc, diverge, tag)
  qed
  have c2: (ex s2 e2. o = exc(s2, e2) && x(s2, e2)) -> ex s1 e. Q(exc(s1, e)) && x(s1, e) proof
    assume q
    obtain s2 e2, e3 hx from q
    have q2: Q(exc(s2, e2)) := rewrite(e3, hQ)
    show by ex_intro({s2}, {e2}, taut(q2, hx))
  qed
  show by taut(hd, c1, c2, c3)
qed

abbrev xt.EXIT(st0) := exc_val("exit", bits_slice(st0, 7, 0))

// exit / exit_group: the process's exit, a1's low byte its status
theorem xt.sys1x_inv: all n a1 w o. (n = 60 || n = 231) -> runs(gimple.sys_call1(n, a1), w, o) -> (ex s1 e. o = exc(s1, e)) && o = exc(w, xt.EXIT(a1))
proof
  fix n a1 w o
  assume hx h
  have b := apply(g.runs_elim, expand(h, gimple.sys_call1))
  have e: o = exc(w, xt.EXIT(a1)) by simp(b, hx)
  have e2: ex s1 e. o = exc(s1, e) by ex_intro({w}, {xt.EXIT(a1)}, e)
  show by taut(e, e2)
qed

// (the overflow raised from t: abi.ovf_out's)
theorem xt.ovf_self: all t. t in abi.World -> abi.ovf_out(t, exc(t, exc_val("stack_overflow", empty)))
proof
  fix t
  assume hw
  have pv pf pd pb := apply(ms.world_parts, hw)
  have od: "objs" in dom(t) && t.objs in abi.Objs by simp(expand(hw, abi.World))
  have s1: fn_update(t, "vm", t.vm) = t := mp(fn_update_same[f := t, k := "vm"], pf, pd)
  have s2: fn_update(t, "objs", t.objs) = t := mp(fn_update_same[f := t, k := "objs"], pf, taut(od))
  have e: exc(t, exc_val("stack_overflow", empty)) = exc(fn_update(fn_update(t, "vm", t.vm), "objs", t.objs), exc_val("stack_overflow", empty)) by simp(s1, s2, pf, pd, od)
  show by ex_intro({t.vm}, {t.objs}, taut(pv, od, e))
qed

// __syscall1(231, a) (exit_group) at a call: the process's exit
theorem xt.s1x_q: all regs t a o2. a in bits(64) ->
  gc.regs_ok(regs, seq_concat(seq_one(gimple.arg(64, bits_of_int(64, 231))), seq_one(gimple.arg(64, a)))) -> runs(c_src_exit__Exit.__syscall1_fun()[regs], t, o2) ->
  (ex s1 e. o2 = exc(s1, e)) && o2 = exc(t, xt.EXIT(a))
proof
  fix regs t a o2
  assume ha hro h
  let ARGS := seq_concat(seq_one(gimple.arg(64, bits_of_int(64, 231))), seq_one(gimple.arg(64, a)))
  have rl rln _ := hro
  have an: seq_len(ARGS) = 2 by simp()
  have rn: seq_len(regs) = 2 := trans(rln, an)
  have lo: seq_len(regs) in omega by simp(rn)
  have q0 := apply(gc.reg_at[regs := regs, args := ARGS, i := 0, w := 64, x := bits_of_int(64, 231)], hro, simp(), simp(an), at({ARGS[0]}), simp(), simp())
  have q1 := apply(gc.reg_at[regs := regs, args := ARGS, i := 1, w := 64, x := a], hro, simp(), simp(an), at({ARGS[1]}), simp(), ha)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, c_src_exit__Exit.__syscall1_fun, app_fn_build, ra in h
  have o2l: ord_le(2, seq_len(regs)) by defs(simp(rn), ord_le)
  have b := rewrite(q1, rewrite(q0, apply(g.runs_elim, h)))
  let N := bits_of_int(64, 231)
  have b2: bind_rel(c_src_exit__Exit.__syscall1(N, a), t, x3 x4. letin(x4, x5. bind_rel(gimple.result(64, x5), x3, x6 x7. any_rel(x8. x8 in bits(64), x8. o2 = ok(x6, pair(x7, x8))),
      x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))), x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3)) by taut(b, o2l)
  have nx: N = 60 || N = 231 by simp()
  have ne: ex y. y in bits(64) by ex_intro({0}, simp())
  have inner: all o3. runs(c_src_exit__Exit.__syscall1(N, a), t, o3) -> (ex s1 e. o3 = exc(s1, e)) && o3 = exc(t, xt.EXIT(a)) proof
    fix o3
    assume r3
    have c := apply(g.runs_elim, expand(r3, c_src_exit__Exit.__syscall1))
    obtain y1, _ c2 from apply(g.any_e, ne, c)
    have c3 := apply(g.letin_e, c2)
    obtain y2, _ c4 from apply(g.any_e, ne, c3)
    have c5 := apply(g.letin_e, c4)
    have hq: all o. runs(gimple.sys_call1(N, a), t, o) -> (ex s1 e. o = exc(s1, e)) && o = exc(t, xt.EXIT(a)) proof
      fix o
      assume r
      show := mp(all_elim(xt.sys1x_inv, {N}, {a}, {t}, {o}), nx, r)
    qed
    obtain s1 e, hq1 hx1 from apply(xt.bind_raise[Q := o. o = exc(t, xt.EXIT(a))], hq, c5)
    have o3e: o3 = exc(t, xt.EXIT(a)) := trans(hx1, hq1)
    have xe: ex s2 e2. o3 = exc(s2, e2) by ex_intro({s1}, {e}, hx1)
    show by taut(o3e, xe)
  qed
  obtain s1 e, hq1 hx1 from apply(xt.bind_raise[Q := o. o = exc(t, xt.EXIT(a))], inner, b2)
  have o2e: o2 = exc(t, xt.EXIT(a)) := trans(hx1, hq1)
  have xe: ex s2 e2. o2 = exc(s2, e2) by ex_intro({s1}, {e}, hx1)
  show by taut(o2e, xe)
qed

// _Exit(c) at a call, its __syscall1 called as such: an overflow, or the
// process's exit with c's low byte -- from the world it was called at
theorem xt.xe_q: all S1 regs t c o2. t in abi.World -> gc.sound(t) -> c in bits(32) ->
  mp.calls(S1, c_src_exit__Exit.__syscall1_fun()) -> gc.regs_ok(regs, seq_one(gimple.arg(32, c))) ->
  runs(c_src_exit__Exit._Exit_fun(S1)[regs], t, o2) ->
  (ex s1 e. o2 = exc(s1, e)) && (o2 = exc(t, exc_val("stack_overflow", empty)) || o2 = exc(t, xt.EXIT(bits_sext(32, 64, c))))
proof
  fix S1 regs t c o2
  assume hw ths hc hS hro h
  let OVF := exc_val("stack_overflow", empty)
  let A := bits_sext(32, 64, c)
  let XT := exc(t, xt.EXIT(A))
  let Q2(o) := o = exc(t, OVF) || o = XT
  let ARG1 := seq_one(gimple.arg(32, c))
  have rl rln _ := hro
  have an: seq_len(ARG1) = 1 by simp()
  have rn: seq_len(regs) = 1 := trans(rln, an)
  have lo: seq_len(regs) in omega by simp(rn)
  have q0 := apply(gc.reg_at[regs := regs, args := ARG1, i := 0, w := 32, x := c], hro, simp(), simp(an), at({ARG1[0]}), simp(), hc)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, c_src_exit__Exit._Exit_fun, app_fn_build, ra in h
  have o1l: ord_le(1, seq_len(regs)) by defs(simp(rn), ord_le)
  have b := rewrite(q0, apply(g.runs_elim, h))
  have b2: bind_rel(c_src_exit__Exit._Exit(c, S1), t, x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o2 = ok(x3, pair(x5, x6)))),
      x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3)) by taut(b, o1l)
  have ab: A in bits(64) by simp(hc)
  let ARGS := seq_concat(seq_one(gimple.arg(64, bits_of_int(64, 231))), seq_one(gimple.arg(64, A)))
  have rex := apply(gc.regs2_ex, (bits_of_int(64, 231) in bits(64) by simp()), ab)
  have hq: all regs2 o4. gc.regs_ok(regs2, ARGS) -> runs(S1[regs2], t, o4) -> o4 = XT proof
    fix regs2 o4
    assume hr2 h4
    have rl2 rn2 _ := hr2
    have len2: int_le(seq_len(regs2), 6) by simp(rn2)
    have h5 := mp(all_elim(hS, {regs2}, {t}, {o4}), rl2, len2, hw, h4)
    have _ e := mp(all_elim(xt.s1x_q, {regs2}, {t}, {A}, {o4}), ab, hr2, h5)
    show e
  qed
  have hc3: all o. runs(gimple.call(S1, ARGS), t, o) -> (ex s1 e. o = exc(s1, e)) && Q2(o) proof
    fix o
    assume r
    have ci := apply(gc.call_inv[Q := o4. o4 = XT], ths, rex, hq, r)
    have k1: o = exc(t, OVF) -> (ex s1 e. o = exc(s1, e)) && Q2(o) proof
      assume e
      have xe: ex s2 e2. o = exc(s2, e2) by ex_intro({t}, {OVF}, e)
      show by taut(e, xe)
    qed
    have k2: (ex w4 r. ok(w4, r) = XT && (o = ok(gc.back(w4, t), pair(fst(r), snd(r))) || o = exc(gc.back(w4, t), OVF))) -> (ex s1 e. o = exc(s1, e)) && Q2(o) proof
      assume q
      obtain w4 r, e _ from q
      have f: false by defs(simp(e), exc, ok, tag)
      show by taut(f)
    qed
    have k3: (ex x e. exc(x, e) = XT && o = exc(x, e)) -> (ex s1 e. o = exc(s1, e)) && Q2(o) proof
      assume q
      obtain x e, e1 e2 from q
      have oe: o = XT := trans(e2, e1)
      have xe: ex s2 e3. o = exc(s2, e3) by ex_intro({x}, {e}, e2)
      show by taut(oe, xe)
    qed
    have k4: (ex t2. diverge(t2) = XT && o = diverge(t2)) -> (ex s1 e. o = exc(s1, e)) && Q2(o) proof
      assume q
      obtain t2, e _ from q
      have f: false by defs(simp(e), exc, diverge, tag)
      show by taut(f)
    qed
    show by taut(ci, k1, k2, k3, k4)
  qed
  have inner: all o3. runs(c_src_exit__Exit._Exit(c, S1), t, o3) -> (ex s1 e. o3 = exc(s1, e)) && Q2(o3) proof
    fix o3
    assume r3
    have c1 := apply(g.runs_elim, expand(r3, c_src_exit__Exit._Exit))
    have c2 := apply(g.letin_e, c1)
    obtain s1 e, hq1 hx1 from apply(xt.bind_raise[Q := o. Q2(o)], hc3, c2)
    have q3: Q2(o3) := rewrite(sym(hx1), hq1)
    have xe: ex s2 e2. o3 = exc(s2, e2) by ex_intro({s1}, {e}, hx1)
    show by taut(q3, xe)
  qed
  obtain s1 e, hq1 hx1 from apply(xt.bind_raise[Q := o. Q2(o)], inner, b2)
  have q2: Q2(o2) := rewrite(sym(hx1), hq1)
  have xe: ex s2 e2. o2 = exc(s2, e2) by ex_intro({s1}, {e}, hx1)
  show by taut(q2, xe)
qed

// ----------------------------------------------------------------------
//  The fini_array's entry: __do_global_dtors_aux, its
//  deregister_tm_clones (the clone table empty: nothing)

theorem xt.dtm_q: all regs s o2. s in abi.World -> s in univ(1) -> gc.regs_ok(regs, empty) ->
  runs(musl_asm.deregister_tm_clones_fun()[regs], s, o2) ->
  abi.ovf_out(s, o2) || (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && fst(r) in bits(64))
proof
  fix regs s o2
  assume hw hu hr h
  have rl rn := apply(gc.regs0, hr)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, musl_asm.deregister_tm_clones_fun, app_fn_build, ra in h
  have pv pf pd pb := apply(ms.world_parts, hw)
  have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], pf, pd)
  have b := apply(g.runs_elim, h)
  obtain o3, hs3 hk3 from expand(b, bind_rel)
  step x2 x4, e3 from hs3
  have e4: o3 = ok(s, empty) by simp(e3)
  have k2: any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o2 = ok(s, pair(x5, x6)))) by simp(rewrite(e4, hk3), keep(any_rel))
  have ne: ex y. y in bits(64) by ex_intro({0}, simp())
  obtain y1, hy1 k3 from apply(g.any_e, ne, k2)
  obtain y2, hy2 hoy from apply(g.any_e, ne, k3)
  have oy: o2 = ok(fn_update(s, "vm", s.vm), pair(y1, y2)) by simp(hoy, ss)
  have fy: fst(pair(y1, y2)) in bits(64) by simp(hy1)
  have l: ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && fst(r) in bits(64) by ex_intro({pair(y1, y2)}, taut(oy, fy))
  show by taut(l)
qed

// (the completed byte set: the memory after)
abbrev xt.DONE(vm) := fn_update(vm, "bytes", x86_64_linux.store_le(vm.bytes, musl_asm.completed_0, 1, 1))

// __do_global_dtors_aux's run, deregister_tm_clones called as such, the
// __cxa_finalize GOT word 0: an overflow, or nothing done (completed
// already), or the completed byte set
theorem xt.dt_run: all D s o. s in abi.World -> s in univ(1) -> abi.thread_ok(s.vm, s.fs_base) -> mp.calls(D, musl_asm.deregister_tm_clones_fun()) ->
  gimple.usable(s.vm, s.objs, musl_asm.completed_0, 1, true) -> gimple.usable(s.vm, s.objs, musl_asm.completed_0, 1, false) ->
  gimple.usable(s.vm, s.objs, musl_asm.cxa_finalize_got, 8, false) -> gimple.bytes_at(s.vm, musl_asm.cxa_finalize_got, 8) = 0 ->
  runs(musl_asm.__do_global_dtors_aux(D), s, o) ->
  abi.ovf_out(s, o) || o = ok(s, empty) || o = ok(fn_update(s, "vm", xt.DONE(s.vm)), empty)
proof
  fix D s o
  assume hw hu ht hD huw hur hug hg0 hr
  let C0 := musl_asm.completed_0
  let GT := musl_asm.cxa_finalize_got
  have cv: C0 = 4227104 by defs(refl({4227104}), musl_asm.completed_0)
  have gv: GT = 4227040 by defs(refl({4227040}), musl_asm.cxa_finalize_got)
  have pv pf pd pb := apply(ms.world_parts, hw)
  have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], pf, pd)
  have c0b: C0 in bits(64) by simp(cv)
  have g0b: GT in bits(64) by simp(gv)
  have mdc: g.mem_defined(s, C0, 0, 1, false) by simp(cv, rewrite(cv, hur))
  have ldc := mp(all_elim(g.ld8_det, {s}, {C0}, {0}), hu, c0b, simp(), mdc)
  step x2 x4 x9, hif hk from hr with ldc
  let CB := bits_of_int(8, gimple.bytes_at(s.vm, int_add(C0, 0), 1))
  let GO := abi.ovf_out(s, o) || o = ok(s, empty) || o = ok(fn_update(s, "vm", xt.DONE(s.vm)), empty)
  // (completed already: nothing)
  have cN: !(CB = 0) -> GO proof
    assume ne
    have e9: x9 = exc(pair(s, pair(CB, x4)), pair("ret", empty)) by taut(hif, ne)
    have oe: o = ok(s, empty) by simp(rewrite(e9, hk))
    show by taut(oe)
  qed
  // (not yet: the GOT word 0, deregister_tm_clones, the byte set)
  have cZ: CB = 0 -> GO proof
    assume z
    have e9: x9 = ok(pair(s, pair(CB, x4)), empty) by taut(hif, z)
    have k1 := rewrite(e9, hk)
    have mdg: g.mem_defined(s, GT, 0, 8, false) by simp(gv, rewrite(gv, hug))
    have ldg := mp(all_elim(g.ld64_det, {s}, {GT}, {0}), hu, g0b, simp(), mdg)
    have g0e: bits_of_int(64, gimple.bytes_at(s.vm, int_add(GT, 0), 8)) = 0 by simp(hg0)
    have mds: g.mem_defined(fn_update(s, "vm", s.vm), C0, 0, 1, true) by simp(cv, ss, rewrite(cv, huw))
    have su: fn_update(s, "vm", s.vm) in univ(1) := rewrite(sym(ss), hu)
    have sv: fn_update(s, "vm", s.vm).vm in x86_64_linux.Vm := rewrite(sym(ss), pv)
    have sf: is_fun(fn_update(s, "vm", s.vm)) := rewrite(sym(ss), pf)
    have sd: "vm" in dom(fn_update(s, "vm", s.vm)) := rewrite(sym(ss), pd)
    step r1, e5 from k1 with ldg, g0e, xt.dtm_q, g.st8_det using hD, hw, hu, ht, mds, su, sv, sf, sd, c0b
    have z0: int_add(C0, 0) = C0 by simp(cv)
    have e6 _ := rewrite(z0, e5)
    show by taut(e6)
  qed
  show by taut(cN, cZ)
qed

// __do_global_dtors_aux at a call: an overflow, or the memory as it was or
// with the completed byte set
theorem xt.dt_q: all D regs s o2. s in abi.World -> s in univ(1) -> abi.thread_ok(s.vm, s.fs_base) -> mp.calls(D, musl_asm.deregister_tm_clones_fun()) ->
  gimple.usable(s.vm, s.objs, musl_asm.completed_0, 1, true) -> gimple.usable(s.vm, s.objs, musl_asm.completed_0, 1, false) ->
  gimple.usable(s.vm, s.objs, musl_asm.cxa_finalize_got, 8, false) -> gimple.bytes_at(s.vm, musl_asm.cxa_finalize_got, 8) = 0 ->
  gc.regs_ok(regs, empty) -> runs(musl_asm.__do_global_dtors_aux_fun(D)[regs], s, o2) ->
  abi.ovf_out(s, o2) || (ex V r. (V in x86_64_linux.Vm && (V = s.vm || V = xt.DONE(s.vm))) && o2 = ok(fn_update(s, "vm", V), r))
proof
  fix D regs s o2
  assume hw hu ht hD huw hur hug hg0 hr h
  have rl rn := apply(gc.regs0, hr)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, musl_asm.__do_global_dtors_aux_fun, app_fn_build, ra in h
  have pv pf pd pb := apply(ms.world_parts, hw)
  have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], pf, pd)
  have b := apply(g.runs_elim, h)
  obtain o3, hs3 hk3 from expand(b, bind_rel)
  let GO := abi.ovf_out(s, o2) || (ex V r. (V in x86_64_linux.Vm && (V = s.vm || V = xt.DONE(s.vm))) && o2 = ok(fn_update(s, "vm", V), r))
  have ne: ex y. y in bits(64) by ex_intro({0}, simp())
  // (a return with V: o2 its)
  have rt: all V. V in x86_64_linux.Vm -> (V = s.vm || V = xt.DONE(s.vm)) -> o3 = ok(fn_update(s, "vm", V), empty) -> GO proof
    fix V
    assume hv hvv e
    have k2: any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o2 = ok(fn_update(s, "vm", V), pair(x5, x6)))) by simp(rewrite(e, hk3), keep(any_rel))
    obtain y1, hy1 k3 from apply(g.any_e, ne, k2)
    obtain y2, hy2 hoy from apply(g.any_e, ne, k3)
    have l: ex V2 r. (V2 in x86_64_linux.Vm && (V2 = s.vm || V2 = xt.DONE(s.vm))) && o2 = ok(fn_update(s, "vm", V2), r)
      by ex_intro({V}, {pair(y1, y2)}, taut(hv, hvv, hoy))
    show by taut(l)
  qed
  have dr := mp(all_elim(xt.dt_run, {D}, {s}, {o3}), hw, hu, ht, hD, huw, hur, hug, hg0, hs3)
  have c1: abi.ovf_out(s, o3) -> GO proof
    assume q
    obtain v ob, hv hob e from q
    have oe: o2 = exc(fn_update(fn_update(s, "vm", v), "objs", ob), exc_val("stack_overflow", empty)) by simp(rewrite(e, hk3))
    have l: abi.ovf_out(s, o2) by ex_intro({v}, {ob}, taut(hv, hob, oe))
    show by taut(l)
  qed
  have c2: o3 = ok(s, empty) -> GO proof
    assume e
    show := mp(all_elim(rt, {s.vm}), pv, taut(refl({s.vm})), rewrite(sym(ss), e))
  qed
  have vf0: fn_update(s.vm, "bytes", s.vm.bytes) in x86_64_linux.Vm := rewrite(sym(mp(fn_update_same[f := s.vm, k := "bytes"], (is_fun(s.vm) by simp(expand(pv, x86_64_linux.Vm))),
    ("bytes" in dom(s.vm) by simp(expand(pv, x86_64_linux.Vm))))), pv)
  have dv: xt.DONE(s.vm) in x86_64_linux.Vm := apply(mp.vm_st, {s.vm}, {s.vm.bytes}, {musl_asm.completed_0}, {1}, {1}, vf0)
  have c3: o3 = ok(fn_update(s, "vm", xt.DONE(s.vm)), empty) -> GO proof
    assume e
    show := mp(all_elim(rt, {xt.DONE(s.vm)}), dv, taut(refl({xt.DONE(s.vm)})), e)
  qed
  show by taut(dr, c1, c2, c3)
qed

// ----------------------------------------------------------------------
//  __libc_exit_fini: the fini_array's one entry (the dtors, through the
//  code map), then _fini (crti's: nothing)

theorem xt.init_q: all regs s o2. s in abi.World -> s in univ(1) -> gc.regs_ok(regs, empty) ->
  runs(musl_asm._init_fun()[regs], s, o2) ->
  abi.ovf_out(s, o2) || (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && fst(r) in bits(64))
proof
  fix regs s o2
  assume hw hu hr h
  have rl rn := apply(gc.regs0, hr)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, musl_asm._init_fun, app_fn_build, ra in h
  have pv pf pd pb := apply(ms.world_parts, hw)
  have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], pf, pd)
  have b := apply(g.runs_elim, h)
  obtain o3, hs3 hk3 from expand(b, bind_rel)
  step e3 from hs3
  have k2: any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o2 = ok(s, pair(x5, x6)))) by simp(rewrite(e3, hk3), keep(any_rel))
  have ne: ex y. y in bits(64) by ex_intro({0}, simp())
  obtain y1, hy1 k3 from apply(g.any_e, ne, k2)
  obtain y2, hy2 hoy from apply(g.any_e, ne, k3)
  have oy: o2 = ok(fn_update(s, "vm", s.vm), pair(y1, y2)) by simp(hoy, ss)
  have fy: fst(pair(y1, y2)) in bits(64) by simp(hy1)
  have l: ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && fst(r) in bits(64) by ex_intro({pair(y1, y2)}, taut(oy, fy))
  show by taut(l)
qed

abbrev xt.DT(D) := musl_asm.__do_global_dtors_aux_fun(D)

theorem xt.fini_run: all D F s o. s in abi.World -> s in univ(1) -> abi.thread_ok(s.vm, s.fs_base) -> abi.thread_ok(xt.DONE(s.vm), s.fs_base) ->
  mp.calls(D, musl_asm.deregister_tm_clones_fun()) -> mp.calls(F, musl_asm._init_fun()) ->
  gimple.usable(s.vm, s.objs, musl_asm.completed_0, 1, true) -> gimple.usable(s.vm, s.objs, musl_asm.completed_0, 1, false) ->
  gimple.usable(s.vm, s.objs, musl_asm.cxa_finalize_got, 8, false) -> gimple.bytes_at(s.vm, musl_asm.cxa_finalize_got, 8) = 0 ->
  gimple.usable(s.vm, s.objs, c_src_exit_exit.__fini_array_start, 8, false) -> gimple.bytes_at(s.vm, c_src_exit_exit.__fini_array_start, 8) = 4198784 ->
  runs(c_src_exit_exit.libc_exit_fini(lxp.FP(4198784, xt.DT(D)), F), s, o) ->
  abi.ovf_out(s, o) || (ex V. (V in x86_64_linux.Vm && (V = s.vm || V = xt.DONE(s.vm))) && o = ok(fn_update(s, "vm", V), empty))
proof
  fix D F s o
  assume hw hu ht htd hD hF huw hur hug hg0 hfu hfv hr
  step a0, h1 from hr
  obtain r, wl kr from h1
  let BODY(x, y) := loop_body(wl)
  let FE := c_src_exit_exit.__fini_array_end
  let FS := c_src_exit_exit.__fini_array_start
  let OVF := exc_val("stack_overflow", empty)
  have fev: FE = 4227032 by defs(refl({4227032}), c_src_exit_exit.__fini_array_end)
  have fsv: FS = 4227024 by defs(refl({4227024}), c_src_exit_exit.__fini_array_start)
  have pv pf pd pb := apply(ms.world_parts, hw)
  have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], pf, pd)
  // (at the start: the loop's end)
  have tS: all W y. BODY(pair(W, FS), y) -> y = exc(pair(W, FS), pair("brk", empty)) proof
    fix W y
    assume hb
    have le: int_le(FS, FS) by arith()
    step e1 from hb with le
    show e1
  qed
  // (at the end: the entry below it, the dtors' address, called)
  have tE: all y. BODY(pair(s, FE), y) -> (ex v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && y = exc(pair(fn_update(fn_update(s, "vm", v), "objs", ob), FE), pair("raise", OVF))) ||
      (ex V. (V in x86_64_linux.Vm && (V = s.vm || V = xt.DONE(s.vm))) && y = ok(pair(fn_update(s, "vm", V), FS), empty)) proof
    fix y
    assume hb
    have nle: !int_le(FE, FS) by arith(fev, fsv)
    have ae: bits_add(64, FE, bits_neg(64, 8)) = FS by defs(simp(fev, fsv), bits_add, bits_neg, pow2)
    have md: g.mem_defined(s, FS, 0, 8, false) by simp(fsv, rewrite(fsv, hfu))
    have fsb: FS in bits(64) by simp(fsv)
    have ld := mp(all_elim(g.ld64_det, {s}, {FS}, {0}), hu, fsb, simp(), md)
    have lv: bits_of_int(64, gimple.bytes_at(s.vm, int_add(FS, 0), 8)) = 4198784 by simp(hfv)
    have fe: app(fn_build(bits(64), x0. ite(x0 = 4198784, xt.DT(D), mallocng_specs.a_crash_spec_fun())), 4198784) = xt.DT(D) by simp()
    have cs := gc.calls_self[g := xt.DT(D)]
    step c9 V1 r1, e2 from hb with nle, ae, ld, lv, fe, xt.dt_q using cs, hD, hw, hu, ht, huw, hur, hug, hg0
    have l: ex V. (V in x86_64_linux.Vm && (V = s.vm || V = xt.DONE(s.vm))) && y = ok(pair(fn_update(s, "vm", V), FS), empty) by ex_intro({V1}, taut(e2))
    show by taut(l)
  qed
  // the loop: at the end with s, or at the start with the memory as it was
  // or the byte set
  let VD(V) := V in x86_64_linux.Vm && (V = s.vm || V = xt.DONE(s.vm))
  let PI(x) := x = pair(s, FE) || (ex V. VD(V) && x = pair(fn_update(s, "vm", V), FS))
  let M(x) := int_sub(snd(x), FS)
  have p0: PI(pair(s, FE)) by taut(refl({pair(s, FE)}))
  have pm: all x. PI(x) -> M(x) in omega proof
    fix x
    assume hp
    have c1: x = pair(s, FE) -> M(x) in omega proof
      assume e
      show by simp(e, fev, fsv)
    qed
    have c2: (ex V. VD(V) && x = pair(fn_update(s, "vm", V), FS)) -> M(x) in omega proof
      assume q
      obtain V, _ _ e from q
      show by simp(e, fsv)
    qed
    show by taut(hp, c1, c2)
  qed
  have nx: all x x2. PI(x) -> BODY(x, ok(x2, empty)) -> PI(x2) && int_lt(M(x2), M(x)) proof
    fix x x2
    assume hp hbd
    have c1: x = pair(s, FE) -> PI(x2) && int_lt(M(x2), M(x)) proof
      assume e
      have t := mp(all_elim(tE, {ok(x2, empty)}), rewrite(e, hbd))
      have k1: (ex v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && ok(x2, empty) = exc(pair(fn_update(fn_update(s, "vm", v), "objs", ob), FE), pair("raise", OVF))) -> PI(x2) && int_lt(M(x2), M(x)) proof
        assume q
        obtain v ob, _ _ e2 from q
        have f: false by defs(simp(e2), exc, ok, tag)
        show by taut(f)
      qed
      have k2: (ex V. VD(V) && ok(x2, empty) = ok(pair(fn_update(s, "vm", V), FS), empty)) -> PI(x2) && int_lt(M(x2), M(x)) proof
        assume q
        obtain V, hv1 hv2 e2 from q
        have x2e: x2 = pair(fn_update(s, "vm", V), FS) by simp(e2)
        have pe: ex V2. VD(V2) && x2 = pair(fn_update(s, "vm", V2), FS) by ex_intro({V}, taut(hv1, hv2, x2e))
        have pi: PI(x2) by taut(pe)
        have lt: int_lt(M(x2), M(x)) by simp(x2e, e, fev, fsv)
        show by taut(pi, lt)
      qed
      show by taut(t, k1, k2)
    qed
    have c2: (ex V. VD(V) && x = pair(fn_update(s, "vm", V), FS)) -> PI(x2) && int_lt(M(x2), M(x)) proof
      assume q
      obtain V, _ _ e from q
      have t := mp(all_elim(tS, {fn_update(s, "vm", V)}, {ok(x2, empty)}), rewrite(e, hbd))
      have f: false by defs(simp(t), exc, ok, tag)
      show by taut(f)
    qed
    show by taut(hp, c1, c2)
  qed
  have wv := apply(g.loop[b := x y. BODY(x, y), p := x. PI(x), m := x. M(x)], p0, pm, nx, wl)
  obtain l, hp hb hno from wv
  let GO := abi.ovf_out(s, o) || (ex V. VD(V) && o = ok(fn_update(s, "vm", V), empty))
  // (left at the end: by an overflow only)
  have q1: l = pair(s, FE) -> GO proof
    assume e
    have t := mp(all_elim(tE, {r}), rewrite(e, hb))
    have k1: (ex v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && r = exc(pair(fn_update(fn_update(s, "vm", v), "objs", ob), FE), pair("raise", OVF))) -> GO proof
      assume q
      obtain v ob, hv hob e2 from q
      have oe: o = exc(fn_update(fn_update(s, "vm", v), "objs", ob), OVF) by simp(rewrite(e2, kr))
      have ov: abi.ovf_out(s, o) by ex_intro({v}, {ob}, taut(hv, hob, oe))
      show by taut(ov)
    qed
    have k2: (ex V. VD(V) && r = ok(pair(fn_update(s, "vm", V), FS), empty)) -> GO proof
      assume q
      obtain V, _ _ e2 from q
      have f: false by defs(simp(rewrite(e2, hno)), is_ok)
      show by taut(f)
    qed
    show by taut(t, k1, k2)
  qed
  // (left at the start: the break, then _fini)
  have q2: (ex V. VD(V) && l = pair(fn_update(s, "vm", V), FS)) -> GO proof
    assume q
    obtain V, hv1 hv2 e from q
    let W := fn_update(s, "vm", V)
    have t := mp(all_elim(tS, {W}, {r}), rewrite(e, hb))
    have k1 := rewrite(t, kr)
    have wW wu := apply(mp.am_world[s := s, V := V], hw, hu, hv1)
    have tV: abi.thread_ok(V, s.fs_base) proof
      have a: V = s.vm -> abi.thread_ok(V, s.fs_base) proof
        assume e2
        show := rewrite(sym(e2), ht)
      qed
      have b: V = xt.DONE(s.vm) -> abi.thread_ok(V, s.fs_base) proof
        assume e2
        show := rewrite(sym(e2), htd)
      qed
      show by taut(hv2, a, b)
    qed
    have tW: abi.thread_ok(W.vm, W.fs_base) by simp(tV)
    step r2, e3 from k1 with xt.init_q using hF, wW, wu, tW
    have oe _ := e3
    have l: ex V2. VD(V2) && o = ok(fn_update(s, "vm", V2), empty) by ex_intro({V}, taut(hv1, hv2, oe))
    show by taut(l)
  qed
  show by taut(hp, q1, q2)
qed

// __libc_exit_fini at a call
theorem xt.fini_q: all D F regs s o2. s in abi.World -> s in univ(1) -> abi.thread_ok(s.vm, s.fs_base) -> abi.thread_ok(xt.DONE(s.vm), s.fs_base) ->
  mp.calls(D, musl_asm.deregister_tm_clones_fun()) -> mp.calls(F, musl_asm._init_fun()) ->
  gimple.usable(s.vm, s.objs, musl_asm.completed_0, 1, true) -> gimple.usable(s.vm, s.objs, musl_asm.completed_0, 1, false) ->
  gimple.usable(s.vm, s.objs, musl_asm.cxa_finalize_got, 8, false) -> gimple.bytes_at(s.vm, musl_asm.cxa_finalize_got, 8) = 0 ->
  gimple.usable(s.vm, s.objs, c_src_exit_exit.__fini_array_start, 8, false) -> gimple.bytes_at(s.vm, c_src_exit_exit.__fini_array_start, 8) = 4198784 ->
  gc.regs_ok(regs, empty) -> runs(c_src_exit_exit.libc_exit_fini_fun(lxp.FP(4198784, xt.DT(D)), F)[regs], s, o2) ->
  abi.ovf_out(s, o2) || (ex V r. (V in x86_64_linux.Vm && (V = s.vm || V = xt.DONE(s.vm))) && o2 = ok(fn_update(s, "vm", V), r))
proof
  fix D F regs s o2
  assume hw hu ht htd hD hF huw hur hug hg0 hfu hfv hr h
  have rl rn := apply(gc.regs0, hr)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, c_src_exit_exit.libc_exit_fini_fun, app_fn_build, ra in h
  have b := apply(g.runs_elim, h)
  obtain o3, hs3 hk3 from expand(b, bind_rel)
  let GO := abi.ovf_out(s, o2) || (ex V r. (V in x86_64_linux.Vm && (V = s.vm || V = xt.DONE(s.vm))) && o2 = ok(fn_update(s, "vm", V), r))
  have ne: ex y. y in bits(64) by ex_intro({0}, simp())
  have fr := mp(all_elim(xt.fini_run, {D}, {F}, {s}, {o3}), hw, hu, ht, htd, hD, hF, huw, hur, hug, hg0, hfu, hfv, hs3)
  have c1: abi.ovf_out(s, o3) -> GO proof
    assume q
    obtain v ob, hv hob e from q
    have oe: o2 = exc(fn_update(fn_update(s, "vm", v), "objs", ob), exc_val("stack_overflow", empty)) by simp(rewrite(e, hk3))
    have l: abi.ovf_out(s, o2) by ex_intro({v}, {ob}, taut(hv, hob, oe))
    show by taut(l)
  qed
  have c2: (ex V. (V in x86_64_linux.Vm && (V = s.vm || V = xt.DONE(s.vm))) && o3 = ok(fn_update(s, "vm", V), empty)) -> GO proof
    assume q
    obtain V, hv hvv e from q
    have k2: any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o2 = ok(fn_update(s, "vm", V), pair(x5, x6)))) by simp(rewrite(e, hk3), keep(any_rel))
    obtain y1, hy1 k3 from apply(g.any_e, ne, k2)
    obtain y2, hy2 hoy from apply(g.any_e, ne, k3)
    have l: ex V2 r. (V2 in x86_64_linux.Vm && (V2 = s.vm || V2 = xt.DONE(s.vm))) && o2 = ok(fn_update(s, "vm", V2), r)
      by ex_intro({V}, {pair(y1, y2)}, taut(hv, hvv, hoy))
    show by taut(l)
  qed
  show by taut(fr, c1, c2)
qed

// ----------------------------------------------------------------------
//  exit's writes: apart from the thread's word, so the thread kept

theorem xt.th_store: all V fs a n v. abi.thread_ok(V, fs) -> fs in bits(64) -> a in bits(64) -> n in omega ->
  int_le(int_add(fs, 8), 18446744073709551616) -> int_le(int_add(a, n), 18446744073709551616) -> (int_le(int_add(fs, 8), a) || int_le(int_add(a, n), fs)) ->
  abi.thread_ok(fn_update(V, "bytes", x86_64_linux.store_le(V.bytes, a, n, v)), fs)
proof
  fix V fs a n v
  assume ht hf ha hn h1 h2 hd
  have far: all k. k in omega -> int_lt(k, 8) -> !int_lt(bits_sub(64, bits_add(64, fs, bits_of_int(64, k)), a), n) proof
    fix k
    assume hk hkl
    have bk: bits_of_int(64, k) = k := apply(nf.boi_in[n := 64, x := k], eval(), (k in bits(64) by arith(hk, hkl)))
    show by defs(arith(rewrite(bk, refl({bits_add(64, fs, bits_of_int(64, k))})), hk, hkl, hf, ha, hn, h1, h2, hd), bits_sub, bits_add, pow2)
  qed
  have le := apply(x86.le_store_far[b := V.bytes, r := fs, a := a, n := n, v := v], hf, ha, far)
  show := apply(ms.thread_keep, {V}, {x86_64_linux.store_le(V.bytes, a, n, v)}, {fs}, ht, le)
qed

// ----------------------------------------------------------------------
//  exit's run (its CFG form): label 2 -- the tid, the lock taken (it was
//  free: a_cas returns 0, not the tid); label 4 -- 0, no other thread
//  holds it; label 6 -- the dummies, __libc_exit_fini, _Exit's exit

abbrev xt.ST(W, b, p, t) := pair(W, pair(b, pair(p, t)))

// (the call of _Exit: an overflow or the exit, from the caller's world)
theorem xt.xe_call: all G8 S1 W c o. W in abi.World -> gc.sound(W) -> c in bits(32) ->
  mp.calls(G8, c_src_exit__Exit._Exit_fun(S1)) -> mp.calls(S1, c_src_exit__Exit.__syscall1_fun()) ->
  runs(gimple.call(G8, seq_one(gimple.arg(32, c))), W, o) ->
  (ex s1 e. o = exc(s1, e)) && (o = exc(W, exc_val("stack_overflow", empty)) || o = exc(W, xt.EXIT(bits_sext(32, 64, c))))
proof
  fix G8 S1 W c o
  assume hw ths hc hG hS r
  let OVF := exc_val("stack_overflow", empty)
  let XT := exc(W, xt.EXIT(bits_sext(32, 64, c)))
  let ARGS := seq_one(gimple.arg(32, c))
  have rex2 := apply(gc.regs1_32_ex, hc)
  have hq: all regs2 o4. gc.regs_ok(regs2, ARGS) -> runs(G8[regs2], W, o4) -> (ex s1 e. o4 = exc(s1, e)) && (o4 = exc(W, OVF) || o4 = XT) proof
    fix regs2 o4
    assume hr2 h4
    have rl2 rn2 _ := hr2
    have len2: int_le(seq_len(regs2), 6) by simp(rn2)
    have h5 := mp(all_elim(hG, {regs2}, {W}, {o4}), rl2, len2, hw, h4)
    show := mp(all_elim(xt.xe_q, {S1}, {regs2}, {W}, {c}, {o4}), hw, ths, hc, hS, hr2, h5)
  qed
  have ci := apply(gc.call_inv[Q := o4. (ex s1 e. o4 = exc(s1, e)) && (o4 = exc(W, OVF) || o4 = XT)], ths, rex2, hq, r)
  let GO := (ex s1 e. o = exc(s1, e)) && (o = exc(W, OVF) || o = XT)
  have k1: o = exc(W, OVF) -> GO proof
    assume e
    have xe: ex s2 e2. o = exc(s2, e2) by ex_intro({W}, {OVF}, e)
    show by taut(e, xe)
  qed
  have k2: (ex w4 r. ((ex s1 e. ok(w4, r) = exc(s1, e)) && (ok(w4, r) = exc(W, OVF) || ok(w4, r) = XT)) &&
      (o = ok(gc.back(w4, W), pair(fst(r), snd(r))) || o = exc(gc.back(w4, W), OVF))) -> GO proof
    assume q
    obtain w4 r, qa _ _ from q
    obtain s1 e, e1 from qa
    have f: false by defs(simp(e1), exc, ok, tag)
    show by taut(f)
  qed
  have k3: (ex x e. ((ex s1 e2. exc(x, e) = exc(s1, e2)) && (exc(x, e) = exc(W, OVF) || exc(x, e) = XT)) && o = exc(x, e)) -> GO proof
    assume q
    obtain x e, _ qb e2 from q
    have a: exc(x, e) = exc(W, OVF) -> GO proof
      assume e3
      show := mp(k1, trans(e2, e3))
    qed
    have b: exc(x, e) = XT -> GO proof
      assume e3
      have oe: o = XT := trans(e2, e3)
      have xe: ex s2 e4. o = exc(s2, e4) by ex_intro({W}, {xt.EXIT(bits_sext(32, 64, c))}, oe)
      show by taut(oe, xe)
    qed
    show by taut(qb, a, b)
  qed
  have k4: (ex t2. ((ex s1 e. diverge(t2) = exc(s1, e)) && (diverge(t2) = exc(W, OVF) || diverge(t2) = XT)) && o = diverge(t2)) -> GO proof
    assume q
    obtain t2, qa _ _ from q
    obtain s1 e, e1 from qa
    have f: false by defs(simp(e1), exc, diverge, tag)
    show by taut(f)
  qed
  show by taut(ci, k1, k2, k3, k4)
qed

theorem xt.exit_run: all G1 G2 G3 G4 G5 G6 G7 G8 DR FI S1 c s o. s in abi.World -> s in univ(1) -> c in bits(32) ->
  mp.calls(G1, c_src_exit_exit.__get_tp_fun()) -> mp.calls(G2, mallocng_specs.a_cas_spec_fun()) ->
  mp.calls(G5, c_src_exit_exit.dummy_fun()) -> mp.calls(G7, c_src_exit_exit.dummy_fun()) ->
  mp.calls(DR, musl_asm.deregister_tm_clones_fun()) -> mp.calls(FI, musl_asm._init_fun()) ->
  mp.calls(G6, c_src_exit_exit.libc_exit_fini_fun(lxp.FP(4198784, xt.DT(DR)), FI)) ->
  mp.calls(S1, c_src_exit__Exit.__syscall1_fun()) -> mp.calls(G8, c_src_exit__Exit._Exit_fun(S1)) ->
  abi.thread_ok(s.vm, s.fs_base) ->
  gimple.usable(s.vm, s.objs, int_add(s.fs_base, 48), 4, false) -> !(gimple.bytes_at(s.vm, int_add(s.fs_base, 48), 4) = 0) ->
  mallocng_specs.a_cas_pre(s.vm, s.objs, c_src_exit_exit_cfg.exit_lock) -> gimple.bytes_at(s.vm, c_src_exit_exit_cfg.exit_lock, 4) = 0 ->
  (int_le(int_add(s.fs_base, 8), c_src_exit_exit_cfg.exit_lock) || int_le(int_add(c_src_exit_exit_cfg.exit_lock, 4), s.fs_base)) ->
  (int_le(int_add(s.fs_base, 8), musl_asm.completed_0) || int_le(int_add(musl_asm.completed_0, 1), s.fs_base)) ->
  gimple.usable(s.vm, s.objs, musl_asm.completed_0, 1, true) -> gimple.usable(s.vm, s.objs, musl_asm.completed_0, 1, false) ->
  gimple.usable(s.vm, s.objs, musl_asm.cxa_finalize_got, 8, false) -> gimple.bytes_at(s.vm, musl_asm.cxa_finalize_got, 8) = 0 ->
  gimple.usable(s.vm, s.objs, c_src_exit_exit.__fini_array_start, 8, false) -> gimple.bytes_at(s.vm, c_src_exit_exit.__fini_array_start, 8) = 4198784 ->
  runs(c_src_exit_exit_cfg.exit(c, G1, G2, G3, G4, G5, G6, G7, G8), s, o) ->
  abi.ovf_out(s, o) || (ex V. V in x86_64_linux.Vm && o = exc(fn_update(s, "vm", V), xt.EXIT(bits_sext(32, 64, c))))
proof
  fix G1 G2 G3 G4 G5 G6 G7 G8 DR FI S1 c s o
  assume hw hu hc hG1 hG2 hG5 hG7 hD hF hG6 hS1 hG8 ht htu htn hlp hl0 hapl hapc huw hur hug hg0 hfu hfv hr
  have fso: s.fs_base in omega by simp(expand(hw, abi.World))
  have hfsl: int_lt(int_add(int_add(s.fs_base, 48), 3), int_pow(2, 64)) := apply(mp.usable_lt[i := 3], htu, arith(fso), simp(), arith())
  step a0 a1, h1 from hr
  obtain r, wl kr from h1
  let BODY(x, y) := loop_body(wl)
  // (label 4: prev 0 -- label 6)
  have t4: all W t y. BODY(xt.ST(W, 4, 0, t), y) -> y = ok(xt.ST(W, 6, 0, t), empty) proof
    fix W t y
    assume hb
    step i1 i2 i3, e1 from hb
    show e1
  qed
  // (label 2: the thread pointer, its tid, the lock taken)
  let OVF := exc_val("stack_overflow", empty)
  let LK := c_src_exit_exit_cfg.exit_lock
  let TB := gimple.bytes_at(s.vm, int_add(s.fs_base, 48), 4)
  let T := bits_of_int(32, TB)
  let WL := fn_update(s, "vm", mallocng_specs.wr32(s.vm, LK, T))
  have pv pf pd pb := apply(ms.world_parts, hw)
  have t2: all p t y. BODY(xt.ST(s, 2, p, t), y) ->
      (ex v ob L. (v in x86_64_linux.Vm && ob in abi.Objs) && y = exc(pair(fn_update(fn_update(s, "vm", v), "objs", ob), L), pair("raise", OVF))) ||
      y = ok(xt.ST(WL, 4, 0, T), empty) proof
    fix p t y
    assume hb
    have fsb: s.fs_base in bits(64) by simp(expand(hw, abi.World))
    have _ _ _ fsn := expand(ht, abi.thread_ok)
    have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], pf, pd)
    let S0 := fn_update(s, "vm", s.vm)
    have s0w: S0 in abi.World := rewrite(sym(ss), hw)
    have s0u: S0 in univ(1) := rewrite(sym(ss), hu)
    have s0t: abi.thread_ok(S0.vm, S0.fs_base) := rewrite(sym(ss), ht)
    have s0tu: gimple.usable(S0.vm, S0.objs, int_add(S0.fs_base, 48), 4, false) := rewrite(sym(ss), htu)
    have s0lp: mallocng_specs.a_cas_pre(S0.vm, S0.objs, c_src_exit_exit_cfg.exit_lock) := rewrite(sym(ss), hlp)
    have md: g.mem_defined(S0, s.fs_base, 48, 4, false) by simp(fsn, (int_lt(int_add(s.fs_base, 48), pow2(64)) by defs(arith(hfsl), pow2)), s0tu)
    have tbo tbl := apply(g.bytes_bound, {s.vm}, {int_add(s.fs_base, 48)}, {4}, pb, simp())
    have te: T = TB by defs(arith(tbo, tbl), bits_of_int, pow2)
    have tb: T in bits(32) by simp(te, (TB in bits(32) by arith(tbo, tbl)))
    have lkb: LK in bits(64) by defs(simp(), c_src_exit_exit_cfg.exit_lock)
    have nd: !(bits_of_int(32, gimple.bytes_at(s.vm, LK, 4)) = T) by simp(hl0, te, htn)
    have vf0: fn_update(s.vm, "bytes", s.vm.bytes) in x86_64_linux.Vm := rewrite(sym(mp(fn_update_same[f := s.vm, k := "bytes"], (is_fun(s.vm) by simp(expand(pv, x86_64_linux.Vm))),
      ("bytes" in dom(s.vm) by simp(expand(pv, x86_64_linux.Vm))))), pv)
    have vfs: fn_update(S0.vm, "bytes", S0.vm.bytes) in x86_64_linux.Vm := rewrite(sym(ss), vf0)
    let CV := ite(gimple.bytes_at(S0.vm, LK, 4) = bits_of_int(32, 0), T, gimple.bytes_at(S0.vm, LK, 4))
    have wv: mallocng_specs.wr32(S0.vm, LK, CV) in x86_64_linux.Vm by defs(apply(mp.vm_st, {S0.vm}, {S0.vm.bytes}, {LK}, {4}, {CV}, vfs), mallocng_specs.wr32)
    step i1 i2, e1 from hb
    have hA hK2 hK1 := e1
    // (the block's outcome i2: the iteration's)
    have pr: all W b q u e. i2 = exc(xt.ST(W, b, q, u), pair("raise", e)) -> y = exc(xt.ST(W, b, q, u), pair("raise", e)) proof
      fix W b q u e
      assume e3
      have i1e: i1 = exc(xt.ST(W, b, q, u), pair("raise", e)) by simp(rewrite(e3, hK2))
      show by simp(rewrite(i1e, hK1))
    qed
    have prk: all W b q u. i2 = ok(xt.ST(W, b, q, u), empty) -> y = ok(xt.ST(W, b, q, u), empty) proof
      fix W b q u
      assume e3
      have i1e: i1 = ok(xt.ST(W, b, q, u), empty) by simp(rewrite(e3, hK2))
      show by simp(rewrite(i1e, hK1))
    qed
    let PA := bits_of_int(32, gimple.bytes_at(s.vm, LK, 4))
    let WA := fn_update(s, "vm", mallocng_specs.wr32(s.vm, LK, ite(gimple.bytes_at(s.vm, LK, 4) = bits_of_int(32, 0), T, gimple.bytes_at(s.vm, LK, 4))))
    have ci2: (ex v ob b q u. (v in x86_64_linux.Vm && ob in abi.Objs) && i2 = exc(xt.ST(fn_update(fn_update(s, "vm", v), "objs", ob), b, q, u), pair("raise", OVF))) ||
        i2 = ok(xt.ST(WA, 4, PA, T), empty) proof
      step r1, eA from hA with xt.gtp_q, g.ld32_det using hG1, hw, hu, ht, fsb, s0u, md
      have hA1 _ := eA
      step r2, e2 from hA1 with ms.acas_q, nd using hG2, s0w, s0u, s0t, s0lp, lkb, tb, wv
      have e2a _ := e2
      show by taut(e2a)
    qed
    have cve: ite(gimple.bytes_at(s.vm, LK, 4) = bits_of_int(32, 0), T, gimple.bytes_at(s.vm, LK, 4)) = T by simp(hl0)
    have pa0: PA = 0 by simp(hl0)
    have k1: (ex v ob b q u. (v in x86_64_linux.Vm && ob in abi.Objs) && i2 = exc(xt.ST(fn_update(fn_update(s, "vm", v), "objs", ob), b, q, u), pair("raise", OVF))) ->
        ex v ob L. (v in x86_64_linux.Vm && ob in abi.Objs) && y = exc(pair(fn_update(fn_update(s, "vm", v), "objs", ob), L), pair("raise", OVF)) proof
      assume qq
      obtain v ob b q u, hv hob e from qq
      have ye := mp(all_elim(pr, {fn_update(fn_update(s, "vm", v), "objs", ob)}, {b}, {q}, {u}, {OVF}), e)
      show by ex_intro({v}, {ob}, {pair(b, pair(q, u))}, taut(hv, hob, ye))
    qed
    have k2: i2 = ok(xt.ST(WA, 4, PA, T), empty) -> y = ok(xt.ST(WL, 4, 0, T), empty) proof
      assume e
      have ye := mp(all_elim(prk, {WA}, {4}, {PA}, {T}), e)
      show := rewrite(pa0, rewrite(cve, ye))
    qed
    show by taut(ci2, k1, k2)
  qed
  // (label 6: the dummy, __libc_exit_fini, the dummy, _Exit)
  have t6: all W t y. W in abi.World -> W in univ(1) -> abi.thread_ok(W.vm, W.fs_base) -> abi.thread_ok(xt.DONE(W.vm), W.fs_base) ->
      gimple.usable(W.vm, W.objs, musl_asm.completed_0, 1, true) -> gimple.usable(W.vm, W.objs, musl_asm.completed_0, 1, false) ->
      gimple.usable(W.vm, W.objs, musl_asm.cxa_finalize_got, 8, false) -> gimple.bytes_at(W.vm, musl_asm.cxa_finalize_got, 8) = 0 ->
      gimple.usable(W.vm, W.objs, c_src_exit_exit.__fini_array_start, 8, false) -> gimple.bytes_at(W.vm, c_src_exit_exit.__fini_array_start, 8) = 4198784 ->
      BODY(xt.ST(W, 6, 0, t), y) ->
      (ex v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && y = exc(xt.ST(fn_update(fn_update(W, "vm", v), "objs", ob), 6, 0, t), pair("raise", exc_val("stack_overflow", empty)))) ||
      (ex V e. ((V in x86_64_linux.Vm && (V = W.vm || V = xt.DONE(W.vm))) && (e = exc_val("stack_overflow", empty) || e = xt.EXIT(bits_sext(32, 64, c)))) &&
        y = exc(xt.ST(fn_update(W, "vm", V), 6, 0, t), pair("raise", e))) proof
    fix W t y
    assume ww wu wt wtd wuw wur wug wg0 wfu wfv hb
    have pv pf pd pb := apply(ms.world_parts, ww)
    have sw: fn_update(W, "vm", W.vm) = W := mp(fn_update_same[f := W, k := "vm"], pf, pd)
    let W1 := fn_update(W, "vm", W.vm)
    have w1w: W1 in abi.World := rewrite(sym(sw), ww)
    have w1u: W1 in univ(1) := rewrite(sym(sw), wu)
    have w1t: abi.thread_ok(W1.vm, W1.fs_base) := rewrite(sym(sw), wt)
    have w1td: abi.thread_ok(xt.DONE(W1.vm), W1.fs_base) := rewrite(sym(sw), wtd)
    have w1uw: gimple.usable(W1.vm, W1.objs, musl_asm.completed_0, 1, true) := rewrite(sym(sw), wuw)
    have w1ur: gimple.usable(W1.vm, W1.objs, musl_asm.completed_0, 1, false) := rewrite(sym(sw), wur)
    have w1ug: gimple.usable(W1.vm, W1.objs, musl_asm.cxa_finalize_got, 8, false) := rewrite(sym(sw), wug)
    have w1g0: gimple.bytes_at(W1.vm, musl_asm.cxa_finalize_got, 8) = 0 := rewrite(sym(sw), wg0)
    have w1fu: gimple.usable(W1.vm, W1.objs, c_src_exit_exit.__fini_array_start, 8, false) := rewrite(sym(sw), wfu)
    have w1fv: gimple.bytes_at(W1.vm, c_src_exit_exit.__fini_array_start, 8) = 4198784 := rewrite(sym(sw), wfv)
    step i1 i2 i3, e1 from hb
    have hA hK3 hK2 hK1 := e1
    let OVF := exc_val("stack_overflow", empty)
    let XE := xt.EXIT(bits_sext(32, 64, c))
    // (an outcome of the label's calls raised: the same outcome of the iteration)
    have pr: all X e. i3 = exc(xt.ST(X, 6, 0, t), pair("raise", e)) -> y = exc(xt.ST(X, 6, 0, t), pair("raise", e)) proof
      fix X e
      assume e3
      have i2e: i2 = exc(xt.ST(X, 6, 0, t), pair("raise", e)) by simp(rewrite(e3, hK3))
      have i1e: i1 = exc(xt.ST(X, 6, 0, t), pair("raise", e)) by simp(rewrite(i2e, hK2))
      show by simp(rewrite(i1e, hK1))
    qed
    have ci3: (ex v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && i3 = exc(xt.ST(fn_update(fn_update(W, "vm", v), "objs", ob), 6, 0, t), pair("raise", OVF))) ||
        (ex V e. ((V in x86_64_linux.Vm && (V = W.vm || V = xt.DONE(W.vm))) && (e = OVF || e = XE)) && i3 = exc(xt.ST(fn_update(W, "vm", V), 6, 0, t), pair("raise", e))) proof
      step r1, eA from hA with xt.dm_q using hG5, ww, wu, wt
      have hA1 _ := eA
      let LF := c_src_exit_exit.libc_exit_fini_fun(lxp.FP(4198784, xt.DT(DR)), FI)
      have fq: all regs o2. gc.regs_ok(regs, empty) -> runs(LF[regs], W1, o2) ->
          abi.ovf_out(W1, o2) || (ex V r. (V in x86_64_linux.Vm && (V = W1.vm || V = xt.DONE(W1.vm))) && o2 = ok(fn_update(W1, "vm", V), r)) proof
        fix regs o2
        assume hr2 h2
        show := mp(all_elim(xt.fini_q, {DR}, {FI}, {regs}, {W1}, {o2}), w1w, w1u, w1t, w1td, hD, hF, w1uw, w1ur, w1ug, w1g0, w1fu, w1fv, hr2, h2)
      qed
      step V2 r2, e2 from hA1 with fq using hG6, w1w, w1u, w1t
      have hB hv2 hvv := e2
      let W2 := fn_update(W, "vm", V2)
      have w2w w2u := apply(mp.am_world[s := W, V := V2], ww, wu, hv2)
      have tv2: abi.thread_ok(V2, W1.fs_base) proof
        have a: V2 = W1.vm -> abi.thread_ok(V2, W1.fs_base) proof
          assume e
          show := rewrite(sym(e), w1t)
        qed
        have b: V2 = xt.DONE(W1.vm) -> abi.thread_ok(V2, W1.fs_base) proof
          assume e
          show := rewrite(sym(e), w1td)
        qed
        show by taut(hvv, a, b)
      qed
      have w2t: abi.thread_ok(W2.vm, W2.fs_base) by simp(tv2)
      step r3, e3 from hB with xt.dm_q using hG7, w2w, w2u, w2t
      have hC _ := e3
      have w3e: fn_update(fn_update(W, "vm", V2), "vm", app(fn_update(W, "vm", V2), "vm")) = W2 by simp()
      have hC2 := rewrite(w3e, hC)
      have hq: all o3. runs(gimple.call(G8, seq_one(gimple.arg(32, c))), W2, o3) -> (ex s1 e. o3 = exc(s1, e)) && (out_state(o3) = W2 && (out_value(o3) = OVF || out_value(o3) = XE)) proof
        fix o3
        assume r3x
        have xa xb := mp(all_elim(xt.xe_call, {G8}, {S1}, {W2}, {c}, {o3}), w2w, w2t, hc, hG8, hS1, r3x)
        have ca: o3 = exc(W2, OVF) -> out_state(o3) = W2 && (out_value(o3) = OVF || out_value(o3) = XE) proof
          assume e
          show by simp(e)
        qed
        have cb: o3 = exc(W2, XE) -> out_state(o3) = W2 && (out_value(o3) = OVF || out_value(o3) = XE) proof
          assume e
          show by simp(e)
        qed
        show by taut(xa, xb, ca, cb)
      qed
      obtain s1 e, hq1 hq1b hx1 from apply(xt.bind_raise[Q := o. out_state(o) = W2 && (out_value(o) = OVF || out_value(o) = XE)], hq, hC2)
      have sw2: s1 = W2 by simp(hq1)
      have ev: e = OVF || e = XE by simp(hq1b)
      have i3e: i3 = exc(xt.ST(W2, 6, 0, t), pair("raise", e)) by simp(hx1, sw2)
      have l: ex V e2. ((V in x86_64_linux.Vm && (V = W.vm || V = xt.DONE(W.vm))) && (e2 = OVF || e2 = XE)) && i3 = exc(xt.ST(fn_update(W, "vm", V), 6, 0, t), pair("raise", e2))
        by ex_intro({V2}, {e}, taut(hv2, (V2 = W.vm || V2 = xt.DONE(W.vm) by simp(hvv)), ev, i3e))
      show by taut(l)
    qed
    have k1: (ex v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && i3 = exc(xt.ST(fn_update(fn_update(W, "vm", v), "objs", ob), 6, 0, t), pair("raise", OVF))) ->
        ex v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && y = exc(xt.ST(fn_update(fn_update(W, "vm", v), "objs", ob), 6, 0, t), pair("raise", OVF)) proof
      assume q
      obtain v ob, hv hob e from q
      have ye := mp(all_elim(pr, {fn_update(fn_update(W, "vm", v), "objs", ob)}, {OVF}), e)
      show by ex_intro({v}, {ob}, taut(hv, hob, ye))
    qed
    have k2: (ex V e. ((V in x86_64_linux.Vm && (V = W.vm || V = xt.DONE(W.vm))) && (e = OVF || e = XE)) && i3 = exc(xt.ST(fn_update(W, "vm", V), 6, 0, t), pair("raise", e))) ->
        ex V e. ((V in x86_64_linux.Vm && (V = W.vm || V = xt.DONE(W.vm))) && (e = OVF || e = XE)) && y = exc(xt.ST(fn_update(W, "vm", V), 6, 0, t), pair("raise", e)) proof
      assume q
      obtain V e, hv hvv he e3 from q
      have ye := mp(all_elim(pr, {fn_update(W, "vm", V)}, {e}), e3)
      show by ex_intro({V}, {e}, taut(hv, hvv, he, ye))
    qed
    show by taut(ci3, k1, k2)
  qed
  // the world with the lock taken: label 6's facts
  let VL := mallocng_specs.wr32(s.vm, LK, T)
  let C0 := musl_asm.completed_0
  have lkv: LK = 4227120 by defs(refl({4227120}), c_src_exit_exit_cfg.exit_lock)
  have c0v: C0 = 4227104 by defs(refl({4227104}), musl_asm.completed_0)
  have gtv: musl_asm.cxa_finalize_got = 4227040 by defs(refl({4227040}), musl_asm.cxa_finalize_got)
  have fsv: c_src_exit_exit.__fini_array_start = 4227024 by defs(refl({4227024}), c_src_exit_exit.__fini_array_start)
  have fsb: s.fs_base in bits(64) by simp(expand(hw, abi.World))
  have vf0: fn_update(s.vm, "bytes", s.vm.bytes) in x86_64_linux.Vm := rewrite(sym(mp(fn_update_same[f := s.vm, k := "bytes"], (is_fun(s.vm) by simp(expand(pv, x86_64_linux.Vm))),
    ("bytes" in dom(s.vm) by simp(expand(pv, x86_64_linux.Vm))))), pv)
  have vlv: VL in x86_64_linux.Vm by defs(apply(mp.vm_st, {s.vm}, {s.vm.bytes}, {LK}, {4}, {T}, vf0), mallocng_specs.wr32)
  have wlw wlu := apply(mp.am_world[s := s, V := VL], hw, hu, vlv)
  have vlt: abi.thread_ok(VL, s.fs_base) by defs(apply(xt.th_store, {s.vm}, {s.fs_base}, {LK}, {4}, {T}, ht, fsb, (LK in bits(64) by simp(lkv)), simp(),
    arith(hfsl), (int_le(int_add(LK, 4), 18446744073709551616) by simp(lkv)), hapl), mallocng_specs.wr32)
  have vlb: fn_update(VL, "bytes", s.vm.bytes) = s.vm by defs(simp(vf0, mp(fn_update_same[f := s.vm, k := "bytes"], (is_fun(s.vm) by simp(expand(pv, x86_64_linux.Vm))),
    ("bytes" in dom(s.vm) by simp(expand(pv, x86_64_linux.Vm))))), mallocng_specs.wr32)
  have vltd: abi.thread_ok(xt.DONE(VL), s.fs_base) := apply(xt.th_store, {VL}, {s.fs_base}, {C0}, {1}, {1}, vlt, fsb, (C0 in bits(64) by simp(c0v)), simp(),
    arith(hfsl), (int_le(int_add(C0, 1), 18446744073709551616) by simp(c0v)), hapc)
  have luw := apply(mp.usable_bytes[v := s.vm, v2 := VL, objs := s.objs, a := C0, n := 1, w := true], vlb, huw)
  have lur := apply(mp.usable_bytes[v := s.vm, v2 := VL, objs := s.objs, a := C0, n := 1, w := false], vlb, hur)
  have lug := apply(mp.usable_bytes[v := s.vm, v2 := VL, objs := s.objs, a := musl_asm.cxa_finalize_got, n := 8, w := false], vlb, hug)
  have lfu := apply(mp.usable_bytes[v := s.vm, v2 := VL, objs := s.objs, a := c_src_exit_exit.__fini_array_start, n := 8, w := false], vlb, hfu)
  have lg0: gimple.bytes_at(VL, musl_asm.cxa_finalize_got, 8) = 0 by mem(hg0, lkv, gtv)
  have lfv: gimple.bytes_at(VL, c_src_exit_exit.__fini_array_start, 8) = 4198784 by mem(hfv, lkv, fsv)
  have q6: all y. BODY(xt.ST(WL, 6, 0, T), y) ->
      (ex v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && y = exc(xt.ST(fn_update(fn_update(WL, "vm", v), "objs", ob), 6, 0, T), pair("raise", OVF))) ||
      (ex V e. ((V in x86_64_linux.Vm && (V = WL.vm || V = xt.DONE(WL.vm))) && (e = OVF || e = xt.EXIT(bits_sext(32, 64, c)))) &&
        y = exc(xt.ST(fn_update(WL, "vm", V), 6, 0, T), pair("raise", e))) proof
    fix y
    assume hb
    show := mp(all_elim(t6, {WL}, {T}, {y}), wlw, wlu, (abi.thread_ok(WL.vm, WL.fs_base) by simp(vlt)), (abi.thread_ok(xt.DONE(WL.vm), WL.fs_base) by simp(vltd)),
      (gimple.usable(WL.vm, WL.objs, C0, 1, true) by simp(luw)), (gimple.usable(WL.vm, WL.objs, C0, 1, false) by simp(lur)),
      (gimple.usable(WL.vm, WL.objs, musl_asm.cxa_finalize_got, 8, false) by simp(lug)), (gimple.bytes_at(WL.vm, musl_asm.cxa_finalize_got, 8) = 0 by simp(lg0)),
      (gimple.usable(WL.vm, WL.objs, c_src_exit_exit.__fini_array_start, 8, false) by simp(lfu)), (gimple.bytes_at(WL.vm, c_src_exit_exit.__fini_array_start, 8) = 4198784 by simp(lfv)), hb)
  qed
  // the loop: label 2 at the start, then 4 and 6 with the lock taken
  let PI(x) := (ex p t. x = xt.ST(s, 2, p, t)) || x = xt.ST(WL, 4, 0, T) || x = xt.ST(WL, 6, 0, T)
  let M(x) := int_sub(10, fst(snd(x)))
  have e0: ex p t. xt.ST(s, 2, a0, a1) = xt.ST(s, 2, p, t) by ex_intro({a0}, {a1}, refl({xt.ST(s, 2, a0, a1)}))
  have p0: PI(xt.ST(s, 2, a0, a1)) by taut(e0)
  have pm: all x. PI(x) -> M(x) in omega proof
    fix x
    assume hp
    have c2: (ex p t. x = xt.ST(s, 2, p, t)) -> M(x) in omega proof
      assume q
      obtain p t, e from q
      show by simp(e)
    qed
    have c4: x = xt.ST(WL, 4, 0, T) -> M(x) in omega proof
      assume e
      show by simp(e)
    qed
    have c6: x = xt.ST(WL, 6, 0, T) -> M(x) in omega proof
      assume e
      show by simp(e)
    qed
    show by taut(hp, c2, c4, c6)
  qed
  have nx: all x x2. PI(x) -> BODY(x, ok(x2, empty)) -> PI(x2) && int_lt(M(x2), M(x)) proof
    fix x x2
    assume hp hbd
    let GO := PI(x2) && int_lt(M(x2), M(x))
    have c2: (ex p t. x = xt.ST(s, 2, p, t)) -> GO proof
      assume q
      obtain p t, e from q
      have tt := mp(all_elim(t2, {p}, {t}, {ok(x2, empty)}), rewrite(e, hbd))
      have k1: (ex v ob L. (v in x86_64_linux.Vm && ob in abi.Objs) && ok(x2, empty) = exc(pair(fn_update(fn_update(s, "vm", v), "objs", ob), L), pair("raise", OVF))) -> GO proof
        assume qq
        obtain v ob L, _ _ e2 from qq
        have f: false by defs(simp(e2), exc, ok, tag)
        show by taut(f)
      qed
      have k2: ok(x2, empty) = ok(xt.ST(WL, 4, 0, T), empty) -> GO proof
        assume e2
        have x2e: x2 = xt.ST(WL, 4, 0, T) by simp(e2)
        have lt: int_lt(M(x2), M(x)) by simp(x2e, e)
        show by taut(x2e, lt)
      qed
      show by taut(tt, k1, k2)
    qed
    have c4: x = xt.ST(WL, 4, 0, T) -> GO proof
      assume e
      have tt := mp(all_elim(t4, {WL}, {T}, {ok(x2, empty)}), rewrite(e, hbd))
      have x2e: x2 = xt.ST(WL, 6, 0, T) by simp(tt)
      have lt: int_lt(M(x2), M(x)) by simp(x2e, e)
      show by taut(x2e, lt)
    qed
    have c6: x = xt.ST(WL, 6, 0, T) -> GO proof
      assume e
      have tt := mp(all_elim(q6, {ok(x2, empty)}), rewrite(e, hbd))
      have k1: (ex v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && ok(x2, empty) = exc(xt.ST(fn_update(fn_update(WL, "vm", v), "objs", ob), 6, 0, T), pair("raise", OVF))) -> GO proof
        assume qq
        obtain v ob, _ _ e2 from qq
        have f: false by defs(simp(e2), exc, ok, tag)
        show by taut(f)
      qed
      have k2: (ex V e3. ((V in x86_64_linux.Vm && (V = WL.vm || V = xt.DONE(WL.vm))) && (e3 = OVF || e3 = xt.EXIT(bits_sext(32, 64, c)))) &&
          ok(x2, empty) = exc(xt.ST(fn_update(WL, "vm", V), 6, 0, T), pair("raise", e3))) -> GO proof
        assume qq
        obtain V e3, _ _ _ e2 from qq
        have f: false by defs(simp(e2), exc, ok, tag)
        show by taut(f)
      qed
      show by taut(tt, k1, k2)
    qed
    show by taut(hp, c2, c4, c6)
  qed
  have wv := apply(g.loop[b := x y. BODY(x, y), p := x. PI(x), m := x. M(x)], p0, pm, nx, wl)
  obtain l, hp hb hno from wv
  let XE := xt.EXIT(bits_sext(32, 64, c))
  let GO := abi.ovf_out(s, o) || (ex V. V in x86_64_linux.Vm && o = exc(fn_update(s, "vm", V), XE))
  have od: "objs" in dom(s) && s.objs in abi.Objs by simp(expand(hw, abi.World))
  // (left at label 2: an overflow)
  have q2: (ex p t. l = xt.ST(s, 2, p, t)) -> GO proof
    assume q
    obtain p t, e from q
    have tt := mp(all_elim(t2, {p}, {t}, {r}), rewrite(e, hb))
    have k1: (ex v ob L. (v in x86_64_linux.Vm && ob in abi.Objs) && r = exc(pair(fn_update(fn_update(s, "vm", v), "objs", ob), L), pair("raise", OVF))) -> GO proof
      assume qq
      obtain v ob L, hv hob e2 from qq
      have oe: o = exc(fn_update(fn_update(s, "vm", v), "objs", ob), OVF) by simp(rewrite(e2, kr))
      have ov: abi.ovf_out(s, o) by ex_intro({v}, {ob}, taut(hv, hob, oe))
      show by taut(ov)
    qed
    have k2: r = ok(xt.ST(WL, 4, 0, T), empty) -> GO proof
      assume e2
      have f: false by defs(simp(rewrite(e2, hno)), is_ok)
      show by taut(f)
    qed
    show by taut(tt, k1, k2)
  qed
  // (at label 4: no exit)
  have q4: l = xt.ST(WL, 4, 0, T) -> GO proof
    assume e
    have tt := mp(all_elim(t4, {WL}, {T}, {r}), rewrite(e, hb))
    have f: false by defs(simp(rewrite(tt, hno)), is_ok)
    show by taut(f)
  qed
  // (left at label 6: an overflow or the exit)
  have q6x: l = xt.ST(WL, 6, 0, T) -> GO proof
    assume e
    have tt := mp(all_elim(q6, {r}), rewrite(e, hb))
    have k1: (ex v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && r = exc(xt.ST(fn_update(fn_update(WL, "vm", v), "objs", ob), 6, 0, T), pair("raise", OVF))) -> GO proof
      assume qq
      obtain v ob, hv hob e2 from qq
      have oe: o = exc(fn_update(fn_update(s, "vm", v), "objs", ob), OVF) by simp(rewrite(e2, kr))
      have ov: abi.ovf_out(s, o) by ex_intro({v}, {ob}, taut(hv, hob, oe))
      show by taut(ov)
    qed
    have k2: (ex V e3. ((V in x86_64_linux.Vm && (V = WL.vm || V = xt.DONE(WL.vm))) && (e3 = OVF || e3 = XE)) &&
        r = exc(xt.ST(fn_update(WL, "vm", V), 6, 0, T), pair("raise", e3))) -> GO proof
      assume qq
      obtain V e3, hv _ he e2 from qq
      have oe: o = exc(fn_update(s, "vm", V), e3) by simp(rewrite(e2, kr))
      have ka: e3 = OVF -> GO proof
        assume ee
        have so := mp(fn_update_same[f := fn_update(s, "vm", V), k := "objs"],
          mp(fn_update_fun[f := s, k := "vm", v := V], pf), mp(all_elim(tr.dom_keep, {s}, {"objs"}, {"vm"}, {V}), taut(od), simp()))
        have oe2: o = exc(fn_update(fn_update(s, "vm", V), "objs", s.objs), OVF) by simp(oe, ee, so)
        have ov: abi.ovf_out(s, o) by ex_intro({V}, {s.objs}, taut(hv, od, oe2))
        show by taut(ov)
      qed
      have kb: e3 = XE -> GO proof
        assume ee
        have oe2: o = exc(fn_update(s, "vm", V), XE) := rewrite(ee, oe)
        have l2: ex V2. V2 in x86_64_linux.Vm && o = exc(fn_update(s, "vm", V2), XE) by ex_intro({V}, taut(hv, oe2))
        show by taut(l2)
      qed
      show by taut(he, ka, kb)
    qed
    show by taut(tt, k1, k2)
  qed
  show by taut(hp, q2, q4, q6x)
qed

// ----------------------------------------------------------------------
//  exit's C function by its purpose

// (the status: the low byte of the code's sign extension, the code's)
theorem xt.low_sext: all c. c in bits(32) -> bits_slice(bits_sext(32, 64, c), 7, 0) = bits_slice(c, 7, 0)
proof
  fix c
  assume hc
  have co: c in omega && int_lt(c, 4294967296) by simp(hc)
  have s1: bits_of_int(32, c) = c by defs(arith(co), bits_of_int, pow2)
  have a: int_lt(c, 2147483648) -> bits_sext(32, 64, c) = c proof
    assume h
    have sv: sint(32, c) = c by defs(simp(s1, h), sint, letin)
    have d1: bits_sext(32, 64, c) = bits_of_int(64, sint(32, c)) by defs(refl({bits_of_int(64, sint(32, c))}), bits_sext)
    have d2: bits_of_int(64, c) = c by defs(arith(co), bits_of_int, pow2)
    show := trans(rewrite(sv, d1), d2)
  qed
  have b: !int_lt(c, 2147483648) -> bits_sext(32, 64, c) = int_add(c, 18446744069414584320) proof
    assume h
    have sv: sint(32, c) = int_sub(c, 4294967296) by defs(simp(s1, h), sint, letin)
    have d1: bits_sext(32, 64, c) = bits_of_int(64, sint(32, c)) by defs(refl({bits_of_int(64, sint(32, c))}), bits_sext)
    have d2: bits_of_int(64, int_sub(c, 4294967296)) = int_add(c, 18446744069414584320) by defs(arith(co, h), bits_of_int, pow2)
    show := trans(rewrite(sv, d1), d2)
  qed
  have m: all x. bits_slice(x, 7, 0) = int_mod(x, 256) by defs(simp(), bits_slice, pow2)
  have k: int_mod(int_add(c, 18446744069414584320), 256) = int_mod(c, 256) by arith(co)
  have ca: int_lt(c, 2147483648) -> bits_slice(bits_sext(32, 64, c), 7, 0) = bits_slice(c, 7, 0) proof
    assume h
    show := sym(rewrite(mp(a, h), refl({bits_slice(bits_sext(32, 64, c), 7, 0)}), {1}))
  qed
  have cb: !int_lt(c, 2147483648) -> bits_slice(bits_sext(32, 64, c), 7, 0) = bits_slice(c, 7, 0) proof
    assume h
    show by simp(mp(b, h), m, k)
  qed
  show by taut(ca, cb)
qed
