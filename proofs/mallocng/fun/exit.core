// exit by its purpose (startup_specs.exit_spec): from a sound thread with
// the lock free and the fini_array's entry the dtors', the process ends
// with the status's low byte (or a stack overflow). The units' CFG forms
// (link_exit.core's) refine their structured ones; exit itself is proven
// on its CFG form (its `undefined` after _Exit: no cut point there).

refines ex_s1_ref c_src_exit__Exit_cfg.__syscall1_fun c_src_exit__Exit.__syscall1_fun
refines ex_xe_ref c_src_exit__Exit_cfg._Exit_fun c_src_exit__Exit._Exit_fun
refines ex_gtp_ref c_src_exit_exit_cfg.__get_tp_fun c_src_exit_exit.__get_tp_fun
refines ex_dm_ref c_src_exit_exit_cfg.dummy_fun c_src_exit_exit.dummy_fun
refines ex_fini_ref c_src_exit_exit_cfg.libc_exit_fini_fun c_src_exit_exit.libc_exit_fini_fun

// ----------------------------------------------------------------------
//  The leaves at a call

// __get_tp (exit.c's copy) at a call, the thread sound: the thread
// pointer returned, the memory as it was
theorem xt.gtp_q: all regs s o2. s in abi.World -> s in univ(1) -> gc.regs_ok(regs, empty) -> abi.thread_ok(s.vm, s.fs_base) ->
  runs(c_src_exit_exit.__get_tp_fun()[regs], s, o2) ->
  abi.ovf_out(s, o2) ||
  (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && fst(r) = s.fs_base)
proof
  fix regs s o2
  assume hw hu hr ht h
  let FS := s.fs_base
  have rl rn := apply(gc.regs0, hr)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, c_src_exit_exit.__get_tp_fun, app_fn_build, ra in h
  have pv pf pd pb := apply(ms.world_parts, hw)
  have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], pf, pd)
  have fsw: FS in bits(64) by simp(expand(hw, abi.World))
  have b := apply(g.runs_elim, h)
  obtain o3, hs3 hk3 from expand(b, bind_rel)
  step x2 x4, e3 from hs3 with ms.tp_det using conj(hw, hu, ht)
  have k1: bind_rel(gimple.result(64, FS), s, x6 x7. any_rel(x8. x8 in bits(64), x8. o2 = ok(x6, pair(x7, x8))), x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))
    by simp(expand(rewrite(e3, hk3), letin), keep(bind_rel, gimple.result))
  obtain o4, hr4 hk4 from expand(k1, bind_rel)
  have ho4 := apply(g.result64_inv, fsw, hr4)
  have k2: any_rel(x8. x8 in bits(64), x8. o2 = ok(s, pair(FS, x8))) by simp(rewrite(ho4, hk4), keep(any_rel))
  have ne: ex y. y in bits(64) by ex_intro({0}, simp())
  obtain y, hy hoy from apply(g.any_e, ne, k2)
  have hoy2: o2 = ok(fn_update(s, "vm", s.vm), pair(FS, y)) by simp(hoy, ss)
  have l: ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && fst(r) = FS by ex_intro({pair(FS, y)}, taut(hoy2, (fst(pair(FS, y)) = FS by simp())))
  show by taut(l)
qed

// the dummy (__funcs_on_exit, __stdio_exit) at a call: the memory as it
// was
theorem xt.dm_q: all regs s o2. s in abi.World -> s in univ(1) -> gc.regs_ok(regs, empty) ->
  runs(c_src_exit_exit.dummy_fun()[regs], s, o2) ->
  abi.ovf_out(s, o2) || (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && r = r)
proof
  fix regs s o2
  assume hw hu hr h
  have rl rn := apply(gc.regs0, hr)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, c_src_exit_exit.dummy_fun, app_fn_build, ra in h
  have pv pf pd pb := apply(ms.world_parts, hw)
  have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], pf, pd)
  have b := apply(g.runs_elim, h)
  obtain o3, hs3 hk3 from expand(b, bind_rel)
  step e3 from hs3
  have k2: any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o2 = ok(s, pair(x5, x6)))) by simp(rewrite(e3, hk3), keep(any_rel))
  have ne: ex y. y in bits(64) by ex_intro({0}, simp())
  obtain y1, hy1 k3 from apply(g.any_e, ne, k2)
  obtain y2, hy2 hoy from apply(g.any_e, ne, k3)
  have oy: o2 = ok(fn_update(s, "vm", s.vm), pair(y1, y2)) by simp(hoy, ss)
  have l: ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && r = r by ex_intro({pair(y1, y2)}, taut(oy, refl({pair(y1, y2)})))
  show by taut(l)
qed

// ----------------------------------------------------------------------
//  The exit raise: exit_group / exit, through __syscall1 and _Exit

// (a program that only raises, bound: its raise handler, at a raise Q
// holds of)
theorem xt.bind_raise(p, s1 v. k, s1 e. x, t. d, o. Q): all s. (all o. runs(p, s, o) -> (ex s1 e. o = exc(s1, e)) && Q(o)) ->
  bind_rel(p, s, s1 v. k(s1, v), s1 e. x(s1, e), t. d(t)) -> ex s1 e. Q(exc(s1, e)) && x(s1, e)
proof
  fix s
  assume hq hb
  obtain o, hr hd from apply(g.bind_open, hb)
  have ex1 hQ := mp(all_elim(hq, {o}), hr)
  obtain s1 e, eo from ex1
  have c1: (ex s2 v. o = ok(s2, v) && k(s2, v)) -> false proof
    assume q
    obtain s2 v, e2 _ from q
    show by defs(simp(trans(sym(eo), e2)), exc, ok, tag)
  qed
  have c3: (ex t. o = diverge(t) && d(t)) -> false proof
    assume q
    obtain t, e2 _ from q
    show by defs(simp(trans(sym(eo), e2)), exc, diverge, tag)
  qed
  have c2: (ex s2 e2. o = exc(s2, e2) && x(s2, e2)) -> ex s1 e. Q(exc(s1, e)) && x(s1, e) proof
    assume q
    obtain s2 e2, e3 hx from q
    have q2: Q(exc(s2, e2)) := rewrite(e3, hQ)
    show by ex_intro({s2}, {e2}, taut(q2, hx))
  qed
  show by taut(hd, c1, c2, c3)
qed

abbrev xt.EXIT(st0) := exc_val("exit", bits_slice(st0, 7, 0))

// exit / exit_group: the process's exit, a1's low byte its status
theorem xt.sys1x_inv: all n a1 w o. (n = 60 || n = 231) -> runs(gimple.sys_call1(n, a1), w, o) -> (ex s1 e. o = exc(s1, e)) && o = exc(w, xt.EXIT(a1))
proof
  fix n a1 w o
  assume hx h
  have b := apply(g.runs_elim, expand(h, gimple.sys_call1))
  have e: o = exc(w, xt.EXIT(a1)) by simp(b, hx)
  have e2: ex s1 e. o = exc(s1, e) by ex_intro({w}, {xt.EXIT(a1)}, e)
  show by taut(e, e2)
qed

// (the overflow raised from t: abi.ovf_out's)
theorem xt.ovf_self: all t. t in abi.World -> abi.ovf_out(t, exc(t, exc_val("stack_overflow", empty)))
proof
  fix t
  assume hw
  have pv pf pd pb := apply(ms.world_parts, hw)
  have od: "objs" in dom(t) && t.objs in abi.Objs by simp(expand(hw, abi.World))
  have s1: fn_update(t, "vm", t.vm) = t := mp(fn_update_same[f := t, k := "vm"], pf, pd)
  have s2: fn_update(t, "objs", t.objs) = t := mp(fn_update_same[f := t, k := "objs"], pf, taut(od))
  have e: exc(t, exc_val("stack_overflow", empty)) = exc(fn_update(fn_update(t, "vm", t.vm), "objs", t.objs), exc_val("stack_overflow", empty)) by simp(s1, s2, pf, pd, od)
  show by ex_intro({t.vm}, {t.objs}, taut(pv, od, e))
qed

// __syscall1(231, a) (exit_group) at a call: the process's exit
theorem xt.s1x_q: all regs t a o2. a in bits(64) ->
  gc.regs_ok(regs, seq_concat(seq_one(gimple.arg(64, bits_of_int(64, 231))), seq_one(gimple.arg(64, a)))) -> runs(c_src_exit__Exit.__syscall1_fun()[regs], t, o2) ->
  (ex s1 e. o2 = exc(s1, e)) && o2 = exc(t, xt.EXIT(a))
proof
  fix regs t a o2
  assume ha hro h
  let ARGS := seq_concat(seq_one(gimple.arg(64, bits_of_int(64, 231))), seq_one(gimple.arg(64, a)))
  have rl rln _ := hro
  have an: seq_len(ARGS) = 2 by simp()
  have rn: seq_len(regs) = 2 := trans(rln, an)
  have lo: seq_len(regs) in omega by simp(rn)
  have q0 := apply(gc.reg_at[regs := regs, args := ARGS, i := 0, w := 64, x := bits_of_int(64, 231)], hro, simp(), simp(an), at({ARGS[0]}), simp(), simp())
  have q1 := apply(gc.reg_at[regs := regs, args := ARGS, i := 1, w := 64, x := a], hro, simp(), simp(an), at({ARGS[1]}), simp(), ha)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, c_src_exit__Exit.__syscall1_fun, app_fn_build, ra in h
  have o2l: ord_le(2, seq_len(regs)) by defs(simp(rn), ord_le)
  have b := rewrite(q1, rewrite(q0, apply(g.runs_elim, h)))
  let N := bits_of_int(64, 231)
  have b2: bind_rel(c_src_exit__Exit.__syscall1(N, a), t, x3 x4. letin(x4, x5. bind_rel(gimple.result(64, x5), x3, x6 x7. any_rel(x8. x8 in bits(64), x8. o2 = ok(x6, pair(x7, x8))),
      x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))), x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3)) by taut(b, o2l)
  have nx: N = 60 || N = 231 by simp()
  have ne: ex y. y in bits(64) by ex_intro({0}, simp())
  have inner: all o3. runs(c_src_exit__Exit.__syscall1(N, a), t, o3) -> (ex s1 e. o3 = exc(s1, e)) && o3 = exc(t, xt.EXIT(a)) proof
    fix o3
    assume r3
    have c := apply(g.runs_elim, expand(r3, c_src_exit__Exit.__syscall1))
    obtain y1, _ c2 from apply(g.any_e, ne, c)
    have c3 := apply(g.letin_e, c2)
    obtain y2, _ c4 from apply(g.any_e, ne, c3)
    have c5 := apply(g.letin_e, c4)
    have hq: all o. runs(gimple.sys_call1(N, a), t, o) -> (ex s1 e. o = exc(s1, e)) && o = exc(t, xt.EXIT(a)) proof
      fix o
      assume r
      show := mp(all_elim(xt.sys1x_inv, {N}, {a}, {t}, {o}), nx, r)
    qed
    obtain s1 e, hq1 hx1 from apply(xt.bind_raise[Q := o. o = exc(t, xt.EXIT(a))], hq, c5)
    have o3e: o3 = exc(t, xt.EXIT(a)) := trans(hx1, hq1)
    have xe: ex s2 e2. o3 = exc(s2, e2) by ex_intro({s1}, {e}, hx1)
    show by taut(o3e, xe)
  qed
  obtain s1 e, hq1 hx1 from apply(xt.bind_raise[Q := o. o = exc(t, xt.EXIT(a))], inner, b2)
  have o2e: o2 = exc(t, xt.EXIT(a)) := trans(hx1, hq1)
  have xe: ex s2 e2. o2 = exc(s2, e2) by ex_intro({s1}, {e}, hx1)
  show by taut(o2e, xe)
qed

// _Exit(c) at a call, its __syscall1 called as such: an overflow, or the
// process's exit with c's low byte -- from the world it was called at
theorem xt.xe_q: all S1 regs t c o2. t in abi.World -> gc.sound(t) -> c in bits(32) ->
  mp.calls(S1, c_src_exit__Exit.__syscall1_fun()) -> gc.regs_ok(regs, seq_one(gimple.arg(32, c))) ->
  runs(c_src_exit__Exit._Exit_fun(S1)[regs], t, o2) ->
  (ex s1 e. o2 = exc(s1, e)) && (o2 = exc(t, exc_val("stack_overflow", empty)) || o2 = exc(t, xt.EXIT(bits_sext(32, 64, c))))
proof
  fix S1 regs t c o2
  assume hw ths hc hS hro h
  let OVF := exc_val("stack_overflow", empty)
  let A := bits_sext(32, 64, c)
  let XT := exc(t, xt.EXIT(A))
  let Q2(o) := o = exc(t, OVF) || o = XT
  let ARG1 := seq_one(gimple.arg(32, c))
  have rl rln _ := hro
  have an: seq_len(ARG1) = 1 by simp()
  have rn: seq_len(regs) = 1 := trans(rln, an)
  have lo: seq_len(regs) in omega by simp(rn)
  have q0 := apply(gc.reg_at[regs := regs, args := ARG1, i := 0, w := 32, x := c], hro, simp(), simp(an), at({ARG1[0]}), simp(), hc)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, c_src_exit__Exit._Exit_fun, app_fn_build, ra in h
  have o1l: ord_le(1, seq_len(regs)) by defs(simp(rn), ord_le)
  have b := rewrite(q0, apply(g.runs_elim, h))
  have b2: bind_rel(c_src_exit__Exit._Exit(c, S1), t, x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o2 = ok(x3, pair(x5, x6)))),
      x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3)) by taut(b, o1l)
  have ab: A in bits(64) by simp(hc)
  let ARGS := seq_concat(seq_one(gimple.arg(64, bits_of_int(64, 231))), seq_one(gimple.arg(64, A)))
  have rex := apply(gc.regs2_ex, (bits_of_int(64, 231) in bits(64) by simp()), ab)
  have hq: all regs2 o4. gc.regs_ok(regs2, ARGS) -> runs(S1[regs2], t, o4) -> o4 = XT proof
    fix regs2 o4
    assume hr2 h4
    have rl2 rn2 _ := hr2
    have len2: int_le(seq_len(regs2), 6) by simp(rn2)
    have h5 := mp(all_elim(hS, {regs2}, {t}, {o4}), rl2, len2, hw, h4)
    have _ e := mp(all_elim(xt.s1x_q, {regs2}, {t}, {A}, {o4}), ab, hr2, h5)
    show e
  qed
  have hc3: all o. runs(gimple.call(S1, ARGS), t, o) -> (ex s1 e. o = exc(s1, e)) && Q2(o) proof
    fix o
    assume r
    have ci := apply(gc.call_inv[Q := o4. o4 = XT], ths, rex, hq, r)
    have k1: o = exc(t, OVF) -> (ex s1 e. o = exc(s1, e)) && Q2(o) proof
      assume e
      have xe: ex s2 e2. o = exc(s2, e2) by ex_intro({t}, {OVF}, e)
      show by taut(e, xe)
    qed
    have k2: (ex w4 r. ok(w4, r) = XT && (o = ok(gc.back(w4, t), pair(fst(r), snd(r))) || o = exc(gc.back(w4, t), OVF))) -> (ex s1 e. o = exc(s1, e)) && Q2(o) proof
      assume q
      obtain w4 r, e _ from q
      have f: false by defs(simp(e), exc, ok, tag)
      show by taut(f)
    qed
    have k3: (ex x e. exc(x, e) = XT && o = exc(x, e)) -> (ex s1 e. o = exc(s1, e)) && Q2(o) proof
      assume q
      obtain x e, e1 e2 from q
      have oe: o = XT := trans(e2, e1)
      have xe: ex s2 e3. o = exc(s2, e3) by ex_intro({x}, {e}, e2)
      show by taut(oe, xe)
    qed
    have k4: (ex t2. diverge(t2) = XT && o = diverge(t2)) -> (ex s1 e. o = exc(s1, e)) && Q2(o) proof
      assume q
      obtain t2, e _ from q
      have f: false by defs(simp(e), exc, diverge, tag)
      show by taut(f)
    qed
    show by taut(ci, k1, k2, k3, k4)
  qed
  have inner: all o3. runs(c_src_exit__Exit._Exit(c, S1), t, o3) -> (ex s1 e. o3 = exc(s1, e)) && Q2(o3) proof
    fix o3
    assume r3
    have c1 := apply(g.runs_elim, expand(r3, c_src_exit__Exit._Exit))
    have c2 := apply(g.letin_e, c1)
    obtain s1 e, hq1 hx1 from apply(xt.bind_raise[Q := o. Q2(o)], hc3, c2)
    have q3: Q2(o3) := rewrite(sym(hx1), hq1)
    have xe: ex s2 e2. o3 = exc(s2, e2) by ex_intro({s1}, {e}, hx1)
    show by taut(q3, xe)
  qed
  obtain s1 e, hq1 hx1 from apply(xt.bind_raise[Q := o. Q2(o)], inner, b2)
  have q2: Q2(o2) := rewrite(sym(hx1), hq1)
  have xe: ex s2 e2. o2 = exc(s2, e2) by ex_intro({s1}, {e}, hx1)
  show by taut(q2, xe)
qed

// ----------------------------------------------------------------------
//  The fini_array's entry: __do_global_dtors_aux, its
//  deregister_tm_clones (the clone table empty: nothing)

theorem xt.dtm_q: all regs s o2. s in abi.World -> s in univ(1) -> gc.regs_ok(regs, empty) ->
  runs(musl_asm.deregister_tm_clones_fun()[regs], s, o2) ->
  abi.ovf_out(s, o2) || (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && r = r)
proof
  fix regs s o2
  assume hw hu hr h
  have rl rn := apply(gc.regs0, hr)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, musl_asm.deregister_tm_clones_fun, app_fn_build, ra in h
  have pv pf pd pb := apply(ms.world_parts, hw)
  have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], pf, pd)
  have b := apply(g.runs_elim, h)
  obtain o3, hs3 hk3 from expand(b, bind_rel)
  step x2 x4, e3 from hs3
  have e4: o3 = ok(s, empty) by simp(e3)
  have k2: any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o2 = ok(s, pair(x5, x6)))) by simp(rewrite(e4, hk3), keep(any_rel))
  have ne: ex y. y in bits(64) by ex_intro({0}, simp())
  obtain y1, hy1 k3 from apply(g.any_e, ne, k2)
  obtain y2, hy2 hoy from apply(g.any_e, ne, k3)
  have oy: o2 = ok(fn_update(s, "vm", s.vm), pair(y1, y2)) by simp(hoy, ss)
  have l: ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && r = r by ex_intro({pair(y1, y2)}, taut(oy, refl({pair(y1, y2)})))
  show by taut(l)
qed

// (the completed byte set: the memory after)
abbrev xt.DONE(vm) := fn_update(vm, "bytes", x86_64_linux.store_le(vm.bytes, musl_asm.completed_0, 1, 1))

// __do_global_dtors_aux's run, deregister_tm_clones called as such, the
// __cxa_finalize GOT word 0: an overflow, or nothing done (completed
// already), or the completed byte set
theorem xt.dt_run: all D s o. s in abi.World -> s in univ(1) -> abi.thread_ok(s.vm, s.fs_base) -> mp.calls(D, musl_asm.deregister_tm_clones_fun()) ->
  gimple.usable(s.vm, s.objs, musl_asm.completed_0, 1, true) -> gimple.usable(s.vm, s.objs, musl_asm.completed_0, 1, false) ->
  gimple.usable(s.vm, s.objs, musl_asm.cxa_finalize_got, 8, false) -> gimple.bytes_at(s.vm, musl_asm.cxa_finalize_got, 8) = 0 ->
  runs(musl_asm.__do_global_dtors_aux(D), s, o) ->
  abi.ovf_out(s, o) || o = ok(s, empty) || o = ok(fn_update(s, "vm", xt.DONE(s.vm)), empty)
proof
  fix D s o
  assume hw hu ht hD huw hur hug hg0 hr
  let C0 := musl_asm.completed_0
  let GT := musl_asm.cxa_finalize_got
  have cv: C0 = 4227104 by defs(refl({4227104}), musl_asm.completed_0)
  have gv: GT = 4227040 by defs(refl({4227040}), musl_asm.cxa_finalize_got)
  have pv pf pd pb := apply(ms.world_parts, hw)
  have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], pf, pd)
  have c0b: C0 in bits(64) by simp(cv)
  have g0b: GT in bits(64) by simp(gv)
  have mdc: g.mem_defined(s, C0, 0, 1, false) by simp(cv, rewrite(cv, hur))
  have ldc := mp(all_elim(g.ld8_det, {s}, {C0}, {0}), hu, c0b, simp(), mdc)
  step x2 x4 x9, hif hk from hr with ldc
  let CB := bits_of_int(8, gimple.bytes_at(s.vm, int_add(C0, 0), 1))
  let GO := abi.ovf_out(s, o) || o = ok(s, empty) || o = ok(fn_update(s, "vm", xt.DONE(s.vm)), empty)
  // (completed already: nothing)
  have cN: !(CB = 0) -> GO proof
    assume ne
    have e9: x9 = exc(pair(s, pair(CB, x4)), pair("ret", empty)) by taut(hif, ne)
    have oe: o = ok(s, empty) by simp(rewrite(e9, hk))
    show by taut(oe)
  qed
  // (not yet: the GOT word 0, deregister_tm_clones, the byte set)
  have cZ: CB = 0 -> GO proof
    assume z
    have e9: x9 = ok(pair(s, pair(CB, x4)), empty) by taut(hif, z)
    have k1 := rewrite(e9, hk)
    have mdg: g.mem_defined(s, GT, 0, 8, false) by simp(gv, rewrite(gv, hug))
    have ldg := mp(all_elim(g.ld64_det, {s}, {GT}, {0}), hu, g0b, simp(), mdg)
    have g0e: bits_of_int(64, gimple.bytes_at(s.vm, int_add(GT, 0), 8)) = 0 by simp(hg0)
    have mds: g.mem_defined(fn_update(s, "vm", s.vm), C0, 0, 1, true) by simp(cv, ss, rewrite(cv, huw))
    have su: fn_update(s, "vm", s.vm) in univ(1) := rewrite(sym(ss), hu)
    have sv: fn_update(s, "vm", s.vm).vm in x86_64_linux.Vm := rewrite(sym(ss), pv)
    have sf: is_fun(fn_update(s, "vm", s.vm)) := rewrite(sym(ss), pf)
    have sd: "vm" in dom(fn_update(s, "vm", s.vm)) := rewrite(sym(ss), pd)
    step r1, e5 from k1 with ldg, g0e, xt.dtm_q, g.st8_det using hD, hw, hu, ht, mds, su, sv, sf, sd, c0b
    have z0: int_add(C0, 0) = C0 by simp(cv)
    have e6 _ := rewrite(z0, e5)
    show by taut(e6)
  qed
  show by taut(cN, cZ)
qed

// __do_global_dtors_aux at a call: an overflow, or the memory as it was or
// with the completed byte set
theorem xt.dt_q: all D regs s o2. s in abi.World -> s in univ(1) -> abi.thread_ok(s.vm, s.fs_base) -> mp.calls(D, musl_asm.deregister_tm_clones_fun()) ->
  gimple.usable(s.vm, s.objs, musl_asm.completed_0, 1, true) -> gimple.usable(s.vm, s.objs, musl_asm.completed_0, 1, false) ->
  gimple.usable(s.vm, s.objs, musl_asm.cxa_finalize_got, 8, false) -> gimple.bytes_at(s.vm, musl_asm.cxa_finalize_got, 8) = 0 ->
  gc.regs_ok(regs, empty) -> runs(musl_asm.__do_global_dtors_aux_fun(D)[regs], s, o2) ->
  abi.ovf_out(s, o2) || (ex V r. (V in x86_64_linux.Vm && (V = s.vm || V = xt.DONE(s.vm))) && o2 = ok(fn_update(s, "vm", V), r))
proof
  fix D regs s o2
  assume hw hu ht hD huw hur hug hg0 hr h
  have rl rn := apply(gc.regs0, hr)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, musl_asm.__do_global_dtors_aux_fun, app_fn_build, ra in h
  have pv pf pd pb := apply(ms.world_parts, hw)
  have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], pf, pd)
  have b := apply(g.runs_elim, h)
  obtain o3, hs3 hk3 from expand(b, bind_rel)
  let GO := abi.ovf_out(s, o2) || (ex V r. (V in x86_64_linux.Vm && (V = s.vm || V = xt.DONE(s.vm))) && o2 = ok(fn_update(s, "vm", V), r))
  have ne: ex y. y in bits(64) by ex_intro({0}, simp())
  // (a return with V: o2 its)
  have rt: all V. V in x86_64_linux.Vm -> (V = s.vm || V = xt.DONE(s.vm)) -> o3 = ok(fn_update(s, "vm", V), empty) -> GO proof
    fix V
    assume hv hvv e
    have k2: any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o2 = ok(fn_update(s, "vm", V), pair(x5, x6)))) by simp(rewrite(e, hk3), keep(any_rel))
    obtain y1, hy1 k3 from apply(g.any_e, ne, k2)
    obtain y2, hy2 hoy from apply(g.any_e, ne, k3)
    have l: ex V2 r. (V2 in x86_64_linux.Vm && (V2 = s.vm || V2 = xt.DONE(s.vm))) && o2 = ok(fn_update(s, "vm", V2), r)
      by ex_intro({V}, {pair(y1, y2)}, taut(hv, hvv, hoy))
    show by taut(l)
  qed
  have dr := mp(all_elim(xt.dt_run, {D}, {s}, {o3}), hw, hu, ht, hD, huw, hur, hug, hg0, hs3)
  have c1: abi.ovf_out(s, o3) -> GO proof
    assume q
    obtain v ob, hv hob e from q
    have oe: o2 = exc(fn_update(fn_update(s, "vm", v), "objs", ob), exc_val("stack_overflow", empty)) by simp(rewrite(e, hk3))
    have l: abi.ovf_out(s, o2) by ex_intro({v}, {ob}, taut(hv, hob, oe))
    show by taut(l)
  qed
  have c2: o3 = ok(s, empty) -> GO proof
    assume e
    show := mp(all_elim(rt, {s.vm}), pv, taut(refl({s.vm})), rewrite(sym(ss), e))
  qed
  have vf0: fn_update(s.vm, "bytes", s.vm.bytes) in x86_64_linux.Vm := rewrite(sym(mp(fn_update_same[f := s.vm, k := "bytes"], (is_fun(s.vm) by simp(expand(pv, x86_64_linux.Vm))),
    ("bytes" in dom(s.vm) by simp(expand(pv, x86_64_linux.Vm))))), pv)
  have dv: xt.DONE(s.vm) in x86_64_linux.Vm := apply(mp.vm_st, {s.vm}, {s.vm.bytes}, {musl_asm.completed_0}, {1}, {1}, vf0)
  have c3: o3 = ok(fn_update(s, "vm", xt.DONE(s.vm)), empty) -> GO proof
    assume e
    show := mp(all_elim(rt, {xt.DONE(s.vm)}), dv, taut(refl({xt.DONE(s.vm)})), e)
  qed
  show by taut(dr, c1, c2, c3)
qed

// ----------------------------------------------------------------------
//  __libc_exit_fini: the fini_array's one entry (the dtors, through the
//  code map), then _fini (crti's: nothing)

theorem xt.init_q: all regs s o2. s in abi.World -> s in univ(1) -> gc.regs_ok(regs, empty) ->
  runs(musl_asm._init_fun()[regs], s, o2) ->
  abi.ovf_out(s, o2) || (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && r = r)
proof
  fix regs s o2
  assume hw hu hr h
  have rl rn := apply(gc.regs0, hr)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, musl_asm._init_fun, app_fn_build, ra in h
  have pv pf pd pb := apply(ms.world_parts, hw)
  have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], pf, pd)
  have b := apply(g.runs_elim, h)
  obtain o3, hs3 hk3 from expand(b, bind_rel)
  step e3 from hs3
  have k2: any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o2 = ok(s, pair(x5, x6)))) by simp(rewrite(e3, hk3), keep(any_rel))
  have ne: ex y. y in bits(64) by ex_intro({0}, simp())
  obtain y1, hy1 k3 from apply(g.any_e, ne, k2)
  obtain y2, hy2 hoy from apply(g.any_e, ne, k3)
  have oy: o2 = ok(fn_update(s, "vm", s.vm), pair(y1, y2)) by simp(hoy, ss)
  have l: ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && r = r by ex_intro({pair(y1, y2)}, taut(oy, refl({pair(y1, y2)})))
  show by taut(l)
qed

abbrev xt.DT(D) := musl_asm.__do_global_dtors_aux_fun(D)

theorem xt.fini_run: all D F s o. s in abi.World -> s in univ(1) -> abi.thread_ok(s.vm, s.fs_base) -> abi.thread_ok(xt.DONE(s.vm), s.fs_base) ->
  mp.calls(D, musl_asm.deregister_tm_clones_fun()) -> mp.calls(F, musl_asm._init_fun()) ->
  gimple.usable(s.vm, s.objs, musl_asm.completed_0, 1, true) -> gimple.usable(s.vm, s.objs, musl_asm.completed_0, 1, false) ->
  gimple.usable(s.vm, s.objs, musl_asm.cxa_finalize_got, 8, false) -> gimple.bytes_at(s.vm, musl_asm.cxa_finalize_got, 8) = 0 ->
  gimple.usable(s.vm, s.objs, c_src_exit_exit.__fini_array_start, 8, false) -> gimple.bytes_at(s.vm, c_src_exit_exit.__fini_array_start, 8) = 4198784 ->
  runs(c_src_exit_exit.libc_exit_fini(lxp.FP(4198784, xt.DT(D)), F), s, o) ->
  abi.ovf_out(s, o) || (ex V. (V in x86_64_linux.Vm && (V = s.vm || V = xt.DONE(s.vm))) && o = ok(fn_update(s, "vm", V), empty))
proof
  fix D F s o
  assume hw hu ht htd hD hF huw hur hug hg0 hfu hfv hr
  step a0, h1 from hr
  obtain r, wl kr from h1
  let BODY(x, y) := loop_body(wl)
  let FE := c_src_exit_exit.__fini_array_end
  let FS := c_src_exit_exit.__fini_array_start
  let OVF := exc_val("stack_overflow", empty)
  have fev: FE = 4227032 by defs(refl({4227032}), c_src_exit_exit.__fini_array_end)
  have fsv: FS = 4227024 by defs(refl({4227024}), c_src_exit_exit.__fini_array_start)
  have pv pf pd pb := apply(ms.world_parts, hw)
  have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], pf, pd)
  // (at the start: the loop's end)
  have tS: all W y. BODY(pair(W, FS), y) -> y = exc(pair(W, FS), pair("brk", empty)) proof
    fix W y
    assume hb
    have le: int_le(FS, FS) by arith()
    step e1 from hb with le
    show e1
  qed
  // (at the end: the entry below it, the dtors' address, called)
  have tE: all y. BODY(pair(s, FE), y) -> (ex v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && y = exc(pair(fn_update(fn_update(s, "vm", v), "objs", ob), FE), pair("raise", OVF))) ||
      (ex V. (V in x86_64_linux.Vm && (V = s.vm || V = xt.DONE(s.vm))) && y = ok(pair(fn_update(s, "vm", V), FS), empty)) proof
    fix y
    assume hb
    have nle: !int_le(FE, FS) by arith(fev, fsv)
    have ae: bits_add(64, FE, bits_neg(64, 8)) = FS by defs(simp(fev, fsv), bits_add, bits_neg, pow2)
    have md: g.mem_defined(s, FS, 0, 8, false) by simp(fsv, rewrite(fsv, hfu))
    have fsb: FS in bits(64) by simp(fsv)
    have ld := mp(all_elim(g.ld64_det, {s}, {FS}, {0}), hu, fsb, simp(), md)
    have lv: bits_of_int(64, gimple.bytes_at(s.vm, int_add(FS, 0), 8)) = 4198784 by simp(hfv)
    have fe: app(fn_build(bits(64), x0. ite(x0 = 4198784, xt.DT(D), mallocng_specs.a_crash_spec_fun())), 4198784) = xt.DT(D) by simp()
    have cs := gc.calls_self[g := xt.DT(D)]
    step c9 V1 r1, e2 from hb with nle, ae, ld, lv, fe, xt.dt_q using cs, hD, hw, hu, ht, huw, hur, hug, hg0
    have l: ex V. (V in x86_64_linux.Vm && (V = s.vm || V = xt.DONE(s.vm))) && y = ok(pair(fn_update(s, "vm", V), FS), empty) by ex_intro({V1}, taut(e2))
    show by taut(l)
  qed
  // the loop: at the end with s, or at the start with the memory as it was
  // or the byte set
  let VD(V) := V in x86_64_linux.Vm && (V = s.vm || V = xt.DONE(s.vm))
  let PI(x) := x = pair(s, FE) || (ex V. VD(V) && x = pair(fn_update(s, "vm", V), FS))
  let M(x) := int_sub(snd(x), FS)
  have p0: PI(pair(s, FE)) by taut(refl({pair(s, FE)}))
  have pm: all x. PI(x) -> M(x) in omega proof
    fix x
    assume hp
    have c1: x = pair(s, FE) -> M(x) in omega proof
      assume e
      show by simp(e, fev, fsv)
    qed
    have c2: (ex V. VD(V) && x = pair(fn_update(s, "vm", V), FS)) -> M(x) in omega proof
      assume q
      obtain V, _ _ e from q
      show by simp(e, fsv)
    qed
    show by taut(hp, c1, c2)
  qed
  have nx: all x x2. PI(x) -> BODY(x, ok(x2, empty)) -> PI(x2) && int_lt(M(x2), M(x)) proof
    fix x x2
    assume hp hbd
    have c1: x = pair(s, FE) -> PI(x2) && int_lt(M(x2), M(x)) proof
      assume e
      have t := mp(all_elim(tE, {ok(x2, empty)}), rewrite(e, hbd))
      have k1: (ex v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && ok(x2, empty) = exc(pair(fn_update(fn_update(s, "vm", v), "objs", ob), FE), pair("raise", OVF))) -> PI(x2) && int_lt(M(x2), M(x)) proof
        assume q
        obtain v ob, _ _ e2 from q
        have f: false by defs(simp(e2), exc, ok, tag)
        show by taut(f)
      qed
      have k2: (ex V. VD(V) && ok(x2, empty) = ok(pair(fn_update(s, "vm", V), FS), empty)) -> PI(x2) && int_lt(M(x2), M(x)) proof
        assume q
        obtain V, hv1 hv2 e2 from q
        have x2e: x2 = pair(fn_update(s, "vm", V), FS) by simp(e2)
        have pe: ex V2. VD(V2) && x2 = pair(fn_update(s, "vm", V2), FS) by ex_intro({V}, taut(hv1, hv2, x2e))
        have pi: PI(x2) by taut(pe)
        have lt: int_lt(M(x2), M(x)) by simp(x2e, e, fev, fsv)
        show by taut(pi, lt)
      qed
      show by taut(t, k1, k2)
    qed
    have c2: (ex V. VD(V) && x = pair(fn_update(s, "vm", V), FS)) -> PI(x2) && int_lt(M(x2), M(x)) proof
      assume q
      obtain V, _ _ e from q
      have t := mp(all_elim(tS, {fn_update(s, "vm", V)}, {ok(x2, empty)}), rewrite(e, hbd))
      have f: false by defs(simp(t), exc, ok, tag)
      show by taut(f)
    qed
    show by taut(hp, c1, c2)
  qed
  have wv := apply(g.loop[b := x y. BODY(x, y), p := x. PI(x), m := x. M(x)], p0, pm, nx, wl)
  obtain l, hp hb hno from wv
  let GO := abi.ovf_out(s, o) || (ex V. VD(V) && o = ok(fn_update(s, "vm", V), empty))
  // (left at the end: by an overflow only)
  have q1: l = pair(s, FE) -> GO proof
    assume e
    have t := mp(all_elim(tE, {r}), rewrite(e, hb))
    have k1: (ex v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && r = exc(pair(fn_update(fn_update(s, "vm", v), "objs", ob), FE), pair("raise", OVF))) -> GO proof
      assume q
      obtain v ob, hv hob e2 from q
      have oe: o = exc(fn_update(fn_update(s, "vm", v), "objs", ob), OVF) by simp(rewrite(e2, kr))
      have ov: abi.ovf_out(s, o) by ex_intro({v}, {ob}, taut(hv, hob, oe))
      show by taut(ov)
    qed
    have k2: (ex V. VD(V) && r = ok(pair(fn_update(s, "vm", V), FS), empty)) -> GO proof
      assume q
      obtain V, _ _ e2 from q
      have f: false by defs(simp(rewrite(e2, hno)), is_ok)
      show by taut(f)
    qed
    show by taut(t, k1, k2)
  qed
  // (left at the start: the break, then _fini)
  have q2: (ex V. VD(V) && l = pair(fn_update(s, "vm", V), FS)) -> GO proof
    assume q
    obtain V, hv1 hv2 e from q
    let W := fn_update(s, "vm", V)
    have t := mp(all_elim(tS, {W}, {r}), rewrite(e, hb))
    have k1 := rewrite(t, kr)
    have wW wu := apply(mp.am_world[s := s, V := V], hw, hu, hv1)
    have tV: abi.thread_ok(V, s.fs_base) proof
      have a: V = s.vm -> abi.thread_ok(V, s.fs_base) proof
        assume e2
        show := rewrite(sym(e2), ht)
      qed
      have b: V = xt.DONE(s.vm) -> abi.thread_ok(V, s.fs_base) proof
        assume e2
        show := rewrite(sym(e2), htd)
      qed
      show by taut(hv2, a, b)
    qed
    have tW: abi.thread_ok(W.vm, W.fs_base) by simp(tV)
    step r2, e3 from k1 with xt.init_q using hF, wW, wu, tW
    have oe _ := e3
    have l: ex V2. VD(V2) && o = ok(fn_update(s, "vm", V2), empty) by ex_intro({V}, taut(hv1, hv2, oe))
    show by taut(l)
  qed
  show by taut(hp, q1, q2)
qed

// __libc_exit_fini at a call
theorem xt.fini_q: all D F regs s o2. s in abi.World -> s in univ(1) -> abi.thread_ok(s.vm, s.fs_base) -> abi.thread_ok(xt.DONE(s.vm), s.fs_base) ->
