// The startup path to main: __libc_start_init, libc_start_main_stage2,
// __libc_start_main, _start_c refine their specs (layers/startup_specs.sl:
// main entered), and their machine code implements them.

// ----------------------------------------------------------------------
//  A function value refining a spec's: its procedure's outcomes the
//  spec's procedure's (an ok one up to its value: the function's values
//  any)

// (the registers' domain)
abbrev sp.REGS := set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6))

// (the spec's function's ok outcomes: any values)
abbrev sp.anyv(w, o) := any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o = ok(w, pair(x5, x6))))

// a procedure's outcome as the spec's: an ok one at the same world
abbrev sp.as_spec(Q, s, o3) := (ex w v. o3 = ok(w, v) && (ex v2. runs(Q, s, ok(w, v2)))) || (!is_ok(o3) && runs(Q, s, o3))

// (the continuation of an outcome as the spec's)
theorem sp.cont_as(Q, s, o, o3):
  ((ex s1 v. o3 = ok(s1, v) && sp.anyv(s1, o)) || (ex s1 e. o3 = exc(s1, e) && o = exc(s1, e)) || (ex t. o3 = diverge(t) && o = diverge(t))) ->
  sp.as_spec(Q, s, o3) ->
  bind_rel(Q, s, x3 x4. sp.anyv(x3, o), x3 x4. o = exc(x3, x4), x3. o = diverge(x3))
proof
  assume hk hq
  have c1: (ex w v. o3 = ok(w, v) && (ex v2. runs(Q, s, ok(w, v2)))) -> bind_rel(Q, s, x3 x4. sp.anyv(x3, o), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) proof
    assume e
    obtain w v, e3 hv from e
    obtain v2, hq2 from hv
    have d: sp.anyv(w, o) by simp(rewrite(e3, hk), keep(any_rel))
    have k: ex s1 v3. ok(w, v2) = ok(s1, v3) && sp.anyv(s1, o) by ex_intro({w}, {v2}, taut(refl({ok(w, v2)}), d))
    show by defs(ex_intro({ok(w, v2)}, taut(hq2, k)), bind_rel)
  qed
  have c2: (!is_ok(o3) && runs(Q, s, o3)) -> bind_rel(Q, s, x3 x4. sp.anyv(x3, o), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) proof
    assume e
    show by defs(ex_intro({o3}, taut(e, hk)), bind_rel)
  qed
  show by taut(hq, c1, c2)
qed

// a function value with a requirement on its arguments (n of them)
theorem sp.fun_r(n, a. P, a. Q): all regs s o. regs in sp.REGS ->
  (ord_le(n, seq_len(regs)) -> all o3. runs(P(regs), s, o3) -> sp.as_spec(Q(regs), s, o3)) ->
  runs(fn_build(sp.REGS, x0. mkprog(x1 x2. !ord_le(n, seq_len(x0)) || bind_rel(P(x0), x1, x3 x4. sp.anyv(x3, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))))[regs], s, o) ->
  runs(fn_build(sp.REGS, x0. mkprog(x1 x2. !ord_le(n, seq_len(x0)) || bind_rel(Q(x0), x1, x3 x4. sp.anyv(x3, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))))[regs], s, o)
proof
  fix regs s o
  assume hr hp h
  rsimp only, app_fn_build, hr in h
  rsimp only, app_fn_build, hr
  have pu := apply(g.runs_univ, h)
  have b := apply(g.runs_elim, h)
  have c1: ord_le(n, seq_len(regs)) -> bind_rel(Q(regs), s, x3 x4. sp.anyv(x3, o), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) proof
    assume hn
    have b2: bind_rel(P(regs), s, x3 x4. sp.anyv(x3, o), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) by taut(b, hn)
    obtain o3, hs3 hk3 from expand(b2, bind_rel)
    have q := mp(all_elim(mp(hp, hn), {o3}), hs3)
    show := mp(sp.cont_as[Q := Q(regs), s := s, o := o, o3 := o3], hk3, q)
  qed
  show := apply(tr.runs_intro[r := x1 x2. !ord_le(n, seq_len(regs)) || bind_rel(Q(regs), x1, x3 x4. sp.anyv(x3, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))],
    {s}, {o}, pu, taut(b, c1))
qed

// (a run is the spec's outcome)
theorem sp.as_of(Q, s, o3): runs(Q, s, o3) -> sp.as_spec(Q, s, o3)
proof
  assume h
  have c: is_ok(o3) -> ex w v. o3 = ok(w, v) && (ex v2. runs(Q, s, ok(w, v2))) proof
    assume i
    obtain w v, e from expand(i, is_ok)
    have r: ex v2. runs(Q, s, ok(w, v2)) by ex_intro({v}, rewrite(e, h))
    show by ex_intro({w}, {v}, taut(e, r))
  qed
  show by taut(c, h)
qed

// a spec's function called: its procedure's outcome (an ok one with any
// values)
theorem sp.fun_out(n, a. Q): all regs s o2. regs in sp.REGS -> ord_le(n, seq_len(regs)) ->
  runs(fn_build(sp.REGS, x0. mkprog(x1 x2. !ord_le(n, seq_len(x0)) || bind_rel(Q(x0), x1, x3 x4. sp.anyv(x3, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))))[regs], s, o2) ->
  bind_rel(Q(regs), s, x3 x4. sp.anyv(x3, o2), x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3))
proof
  fix regs s o2
  assume hr hn h
  rsimp only, app_fn_build, hr in h
  have b := apply(g.runs_elim, h)
  show by taut(b, hn)
qed

// ----------------------------------------------------------------------
//  Main entered: the specs of __libc_start_main and _start_c (an
//  overflow, or libc set up and main entered: to_main at envp e)

abbrev sp.TM(g, e, x0, x1) := ex x2. (bind_rel(startup_specs.overflow_start, x0, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)),
    x3. x2 = diverge(x3)) ||
  bind_rel(startup_specs.to_main(g, e), x0, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)), x3. x2 = diverge(x3))) &&
  ((fst(x2) = 0 && x1 = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && x1 = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
    ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && x1 = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && x1 = diverge(snd(x2)))))

// one such spec's run another's: both requirements met, the same envp
theorem sp.tm_same(x0. R1, x0. R2, x0. E1, x0. E2, g): all s o. R1(s) -> R2(s) -> E1(s) = E2(s) ->
  runs(mkprog(x0 x1. !R1(x0) || sp.TM(g, E1(x0), x0, x1)), s, o) -> runs(mkprog(x0 x1. !R2(x0) || sp.TM(g, E2(x0), x0, x1)), s, o)
proof
  fix s o
  assume h1 h2 he hr
  have pu := apply(g.runs_univ, hr)
  have b := apply(g.runs_elim, hr)
  have t: sp.TM(g, E1(s), s, o) by taut(b, h1)
  have t2 := rewrite(he, t)
  show := apply(tr.runs_intro[r := x0 x1. !R2(x0) || sp.TM(g, E2(x0), x0, x1)], {s}, {o}, pu, taut(t2))
qed

// (a requirement not met: anything)
theorem sp.req_fail(x0. R, x0 x1. B): all s o. pair(s, o) in univ(1) -> !R(s) -> runs(mkprog(x0 x1. !R(x0) || B(x0, x1)), s, o)
proof
  fix s o
  assume pu hn
  show := apply(tr.runs_intro[r := x0 x1. !R(x0) || B(x0, x1)], {s}, {o}, pu, taut(hn))
qed

// to_main's memory at e: the frame of startup's writes, libc.auxv after
// envp's words, a thread set up
abbrev sp.TMV(g, e, s, V) := V in x86_64_linux.Vm && ((startup_specs.frame(s.vm, V, s.objs, startup_specs.start_writes(g)) &&
  (all n. n in omega -> startup_specs.env_at(s.vm, s.objs, e, n) -> gimple.bytes_at(V, bits_add(64, g.libc, 8), 8) = int_add(e, int_mul(8, int_add(n, 1))))) &&
  (ex fs. fs in bits(64) && startup_specs.thread_set(V, fs)))

abbrev sp.AM := exc_val("at_main", empty)

// the body's outcomes: an overflow, main entered with such a memory and
// thread -- or no such memory (to_main undefined)
theorem sp.tm_cases(g, e, s, o): s in abi.World -> sp.TM(g, e, s, o) ->
  sp.ovf_any(s, o) || (ex V fs. (sp.TMV(g, e, s, V) && fs in bits(64) && startup_specs.thread_set(V, fs)) &&
    o = exc(fn_update(fn_update(s, "vm", V), "fs_base", fs), sp.AM)) || !(ex V. sp.TMV(g, e, s, V))
proof
  assume hw h
  obtain x2, hbr hout from h
  let OVF := exc_val("stack_overflow", empty)
  have k1: case 1 of hbr proof
    assume e1
    rsimp only, startup_specs.overflow_start, abi.overflow in e1
    have pv _ _ _ := apply(ms.world_parts, hw)
    have vv: ex x. x in x86_64_linux.Vm by ex_intro({s.vm}, simp(pv))
    have fv: ex x. x in bits(64) by ex_intro({0}, simp())
    have l: ex f v ob. ((f in bits(64) && v in x86_64_linux.Vm) && ob in abi.Objs) &&
      x2 = exc(pair(fn_update(fn_update(fn_update(s, "fs_base", f), "vm", v), "objs", ob), empty), pair("raise", OVF)) by simp(e1, vv, fv, ct.objs_ne)
    obtain f v ob, hf hv hob hx from l
    have oe: o = exc(fn_update(fn_update(fn_update(s, "fs_base", f), "vm", v), "objs", ob), OVF) by simp(rewrite(hx, hout))
    have x: sp.ovf_any(s, o) by defs(ex_intro({f}, {v}, {ob}, taut(hf, hv, hob, oe)), sp.ovf_any)
    show by taut(x)
  qed
  have k2: case 2 of hbr proof
    assume e2
    have cv: (ex V. sp.TMV(g, e, s, V)) -> ex V fs. (sp.TMV(g, e, s, V) && fs in bits(64) && startup_specs.thread_set(V, fs)) &&
        o = exc(fn_update(fn_update(s, "vm", V), "fs_base", fs), sp.AM) proof
      assume hex
      obtain o5, r5 k5 from apply(g.bind_open, e2)
      have b5 := apply(g.letin_e, apply(g.runs_elim, expand(r5, startup_specs.to_main)))
      rsimp in b5
      obtain V, hV hfr hl8 hfs0 hk from apply(g.any_e, hex, b5)
      have hk1 := apply(g.letin_e, hk)
      rsimp in hk1
      obtain fs, hfb hts hk2 from apply(g.any_e, hfs0, hk1)
      have hk3 := apply(g.letin_e, hk2)
      let S := fn_update(fn_update(s, "vm", V), "fs_base", fs)
      obtain o6, r6 k6 from apply(g.bind_open, hk3)
      have o6e: o6 = exc(S, sp.AM) by simp(apply(g.runs_elim, expand(r6, startup_specs.main_entered)))
      have o5e: o5 = exc(S, sp.AM) by simp(rewrite(o6e, k6))
      have x2e: x2 = exc(pair(S, empty), pair("raise", sp.AM)) by simp(rewrite(o5e, k5))
      have oe: o = exc(S, sp.AM) by simp(rewrite(x2e, hout))
      show by ex_intro({V}, {fs}, taut(hV, hfr, hl8, hfs0, hfb, hts, oe))
    qed
    show by taut(cv)
  qed
  show by taut(hbr, k1, k2)
qed

// (the body's ending: its procedures' outcomes the spec's)
abbrev sp.DS(x2, x1) := (fst(x2) = 0 && x1 = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && x1 = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
    ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && x1 = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && x1 = diverge(snd(x2))))
abbrev sp.BR(p, x0, x2) := bind_rel(p, x0, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)), x3. x2 = diverge(x3))

// a spec's body `either { overflow_start() } or { q }` (TM's with q
// to_main)
abbrev sp.EO(q, x0, x1) := ex x2. (sp.BR(startup_specs.overflow_start, x0, x2) || sp.BR(q, x0, x2)) && sp.DS(x2, x1)

// an overflow: the body's
theorem sp.eo_ovf(q, s, o): pair(s, o) in univ(1) -> sp.ovf_any(s, o) -> sp.EO(q, s, o)
proof
  assume pu ho0
  obtain f v ob, hf hv hob ho from expand(ho0, sp.ovf_any)
  let OVF := exc_val("stack_overflow", empty)
  let WO := fn_update(fn_update(fn_update(s, "fs_base", f), "vm", v), "objs", ob)
  let X2 := exc(pair(WO, empty), pair("raise", OVF))
  have hu: s in univ(1) by simp(pu)
  have r1 := apply(sp.ovs_intro, {s}, {f}, {v}, {ob}, hu, hf, hv, hob, rewrite(ho, pu))
  have cx: ex x3 x4. exc(WO, OVF) = exc(x3, x4) && X2 = exc(pair(x3, empty), pair("raise", x4)) by ex_intro({WO}, {OVF}, taut(refl({exc(WO, OVF)}), refl({X2})))
  have b1: sp.BR(startup_specs.overflow_start, s, X2) by defs(ex_intro({exc(WO, OVF)}, taut(r1, cx)), bind_rel)
  have d1: sp.DS(X2, o) by simp(ho)
  show by ex_intro({X2}, taut(b1, d1))
qed

// (the outcomes the body's ending makes)
abbrev sp.tmo(o) := (ex w. o = ok(w, empty)) || (ex w x. o = exc(w, x)) || (ex t. o = diverge(t))

// no memory to_main's: every such outcome the body's
theorem sp.tm_vac(g, e, s, o): pair(s, o) in univ(1) -> !(ex V. sp.TMV(g, e, s, V)) -> sp.tmo(o) -> sp.TM(g, e, s, o)
proof
  assume pu hn ho
  have r5: runs(startup_specs.to_main(g, e), s, o) proof
    unfold startup_specs.to_main
    refine tr.runs_intro with pu
    rsimp
    show by defs(taut(hn), any_rel)
  qed
  have c1: (ex w. o = ok(w, empty)) -> sp.TM(g, e, s, o) proof
    assume q
    obtain w, ew from q
    let X2 := ok(pair(w, empty), empty)
    have k: ex x3 x4. o = ok(x3, x4) && X2 = ok(pair(x3, empty), empty) by ex_intro({w}, {empty}, taut(ew, refl({X2})))
    have b: sp.BR(startup_specs.to_main(g, e), s, X2) by defs(ex_intro({o}, taut(r5, k)), bind_rel)
    have d: sp.DS(X2, o) by simp(ew)
    show by ex_intro({X2}, taut(b, d))
  qed
  have c2: (ex w x. o = exc(w, x)) -> sp.TM(g, e, s, o) proof
    assume q
    obtain w x, ew from q
    let X2 := exc(pair(w, empty), pair("raise", x))
    have k: ex x3 x4. o = exc(x3, x4) && X2 = exc(pair(x3, empty), pair("raise", x4)) by ex_intro({w}, {x}, taut(ew, refl({X2})))
    have b: sp.BR(startup_specs.to_main(g, e), s, X2) by defs(ex_intro({o}, taut(r5, k)), bind_rel)
    have d: sp.DS(X2, o) by simp(ew)
    show by ex_intro({X2}, taut(b, d))
  qed
  have c3: (ex t. o = diverge(t)) -> sp.TM(g, e, s, o) proof
    assume q
    obtain t, ew from q
    let X2 := diverge(t)
    have k: ex x3. o = diverge(x3) && X2 = diverge(x3) by ex_intro({t}, taut(ew, refl({X2})))
    have b: sp.BR(startup_specs.to_main(g, e), s, X2) by defs(ex_intro({o}, taut(r5, k)), bind_rel)
    have d: sp.DS(X2, o) by simp(ew)
    show by ex_intro({X2}, taut(b, d))
  qed
  show by taut(ho, c1, c2, c3)
qed

// (a spec function's outcome o2 from its procedure's o4: o4 ok, or o2
// the same)
theorem sp.k_cases(o4, o2): ((ex s1 v. o4 = ok(s1, v) && sp.anyv(s1, o2)) || (ex s1 e. o4 = exc(s1, e) && o2 = exc(s1, e)) || (ex t. o4 = diverge(t) && o2 = diverge(t))) ->
  is_ok(o4) || (!is_ok(o4) && o2 = o4)
proof
  assume h
  have c1: (ex s1 v. o4 = ok(s1, v) && sp.anyv(s1, o2)) -> is_ok(o4) proof
    assume q
    obtain s1 v, e1 _ from q
    show by defs(ex_intro({s1}, {v}, e1), is_ok)
  qed
  have c2: (ex s1 e. o4 = exc(s1, e) && o2 = exc(s1, e)) -> !is_ok(o4) && o2 = o4 proof
    assume q
    obtain s1 e, e1 e2 from q
    have n := rewrite(sym(e1), all_elim(g.not_ok_exc, {s1}, {e}))
    show by taut(n, trans(e2, sym(e1)))
  qed
  have c3: (ex t. o4 = diverge(t) && o2 = diverge(t)) -> !is_ok(o4) && o2 = o4 proof
    assume q
    obtain t, e1 e2 from q
    have n := rewrite(sym(e1), all_elim(g.not_ok_div, {t}))
    show by taut(n, trans(e2, sym(e1)))
  qed
  show by taut(h, c1, c2, c3)
qed

// (a procedure's outcome o from its last call's oc, the procedure
// returning nothing after it: o oc's if not ok, of the body's ending's
// forms)
theorem sp.d_cases(oc, o): ((ex s1 v. oc = ok(s1, v) && o = ok(s1, empty)) || (ex s1 e. oc = exc(s1, e) && o = exc(s1, e)) || (ex t. oc = diverge(t) && o = diverge(t))) ->
  (!is_ok(oc) -> o = oc) && sp.tmo(o)
proof
  assume h
  have c1: (ex s1 v. oc = ok(s1, v) && o = ok(s1, empty)) -> (!is_ok(oc) -> o = oc) && sp.tmo(o) proof
    assume q
    obtain s1 v, e1 e2 from q
    have i: is_ok(oc) by defs(ex_intro({s1}, {v}, e1), is_ok)
    have t: ex w. o = ok(w, empty) by ex_intro({s1}, e2)
    show by taut(i, t)
  qed
  have c2: (ex s1 e. oc = exc(s1, e) && o = exc(s1, e)) -> (!is_ok(oc) -> o = oc) && sp.tmo(o) proof
    assume q
    obtain s1 e, e1 e2 from q
    have t: ex w x. o = exc(w, x) by ex_intro({s1}, {e}, e2)
    show by taut(trans(e2, sym(e1)), t)
  qed
  have c3: (ex t. oc = diverge(t) && o = diverge(t)) -> (!is_ok(oc) -> o = oc) && sp.tmo(o) proof
    assume q
    obtain t, e1 e2 from q
    have t2: ex t3. o = diverge(t3) by ex_intro({t}, e2)
    show by taut(trans(e2, sym(e1)), t2)
  qed
  show by taut(h, c1, c2, c3)
qed

// ----------------------------------------------------------------------
//  _start_c(sp): argc's word read, argv after it; __libc_start_main
//  called as its spec says -- its requirement _start_c's, its envp the
//  same

theorem sp.stc_run: all g P LSM p s o. s in abi.World -> p in bits(64) -> P.main = c_crt_crt1.main_at ->
  mp.calls(LSM, startup_specs.start_main_spec_fun(g, P)) -> runs(c_crt_crt1._start_c(p, LSM), s, o) -> sp.as_spec(startup_specs.start_c_spec(g, P, p), s, o)
proof
  fix g P LSM p s o
  assume hw hp hm hL h
  let SC := startup_specs.start_c_spec(g, P, p)
  have pu := apply(g.runs_univ, expand(h, c_crt_crt1._start_c))
  have hu: s in univ(1) by simp(pu)
  let PRE(x0) := ((!(p = 0) && int_lt(int_add(p, 16), int_pow(2, 63))) && gimple.usable(app(x0, "vm"), app(x0, "objs"), p, 8, false)) &&
    startup_specs.start_main_pre(app(x0, "vm"), app(x0, "objs"), g, P, gimple.bytes_at(app(x0, "vm"), p, 8), bits_add(64, p, 8))
  have cN: !PRE(s) -> sp.as_spec(SC, s, o) proof
    assume hn
    have r: runs(SC, s, o) by defs(apply(sp.req_fail[R := x0. PRE(x0), B := x0 x1. sp.TM(g, bits_add(64, p, int_mul(8, int_add(gimple.bytes_at(app(x0, "vm"), p, 8), 2))), x0, x1)],
      {s}, {o}, pu, hn), startup_specs.start_c_spec)
    show := apply(sp.as_of, r)
  qed
  have cP: PRE(s) -> sp.as_spec(SC, s, o) proof
    assume hpre
    have hp1 hp2 hus hsm := hpre
    have b := apply(g.runs_elim, expand(h, c_crt_crt1._start_c))
    have pl: int_lt(int_add(p, 0), pow2(64)) by arith(hp2, hp)
    have p0: int_add(p, 0) = p by arith(hp)
    have md: g.mem_defined(s, p, 0, 8, false) by simp(hp1, hus, pl, p0)
    have sv8: g.sv64(8) = 8 by simp()
    have pl8: int_lt(int_add(p, g.sv64(8)), pow2(64)) by arith(hp2, hp, sv8)
    have pz8: int_le(0, int_add(p, g.sv64(8))) by arith(hp, sv8)
    step a1, h0 from b
    step a2, h1 from h0 with g.ld64_det, g.padd_det using conj(hu, hp, md, pl8, pz8)
    // the call's arguments: main, argc (the word, under 2^31), argv
    let W := gimple.bytes_at(s.vm, p, 8)
    let AV := bits_add(64, p, 8)
    have sa1 _ sa3 _ _ _ := expand(hsm, startup_specs.start_main_pre)
    have _ _ _ sbt := apply(ms.world_parts, hw)
    have wo _ := apply(g.bytes_bound, {s.vm}, {p}, {8}, sbt, simp())
    have eA: bits_of_int(32, bits_of_int(64, W)) = W by defs(arith(wo, sa1), bits_of_int)
    have e8: gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), 8) = 8 by simp()
    have bq: int_add(p, 8) = AV by defs(arith(hp, hp2), bits_add, bits_of_int)
    have h2 := rewrite(bq, rewrite(e8, rewrite(eA, rewrite(p0, h1))))
    obtain oc, hrc hdc from apply(g.bind_open, h2)
    let ARGS := seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(gimple.arg(64, c_crt_crt1.main_at)), seq_one(gimple.arg(32, W))), seq_one(gimple.arg(64, AV))),
      seq_one(gimple.arg(64, c_crt_crt1._init_at))), seq_one(gimple.arg(64, c_crt_crt1._fini_at))), seq_one(gimple.arg(64, bits_of_int(64, 0))))
    let SM := startup_specs.start_main_spec(g, P, c_crt_crt1.main_at, W, AV)
    let QQ(o2) := bind_rel(SM, s, x3 x4. sp.anyv(x3, o2), x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3))
    have mb: c_crt_crt1.main_at in bits(64) by defs(simp(), c_crt_crt1.main_at)
    have ib: c_crt_crt1._init_at in bits(64) by defs(simp(), c_crt_crt1._init_at)
    have fb: c_crt_crt1._fini_at in bits(64) by defs(simp(), c_crt_crt1._fini_at)
    have w32: int_lt(W, pow2(32)) by arith(sa1, wo)
    have wb: W in bits(32) by defs(simp(wo, w32), bits)
    have avb: AV in bits(64) by simp()
    // (registers for the call exist)
    have rg := apply(gc.regs_get, apply(gc.regs_cat, apply(gc.regs_cat, apply(gc.regs_cat, apply(gc.regs_cat, apply(gc.regs_cat,
      apply(gc.regs_one[w := 64, x := c_crt_crt1.main_at], simp(), simp(), mb), apply(gc.regs_one[w := 32, x := W], simp(), simp(), wb)),
      apply(gc.regs_one[w := 64, x := AV], simp(), simp(), avb)), apply(gc.regs_one[w := 64, x := c_crt_crt1._init_at], simp(), simp(), ib)),
      apply(gc.regs_one[w := 64, x := c_crt_crt1._fini_at], simp(), simp(), fb)), apply(gc.regs_one[w := 64, x := bits_of_int(64, 0)], simp(), simp(), simp())))
    // __libc_start_main called: its spec's procedure at main, argc, argv
    have hq: all regs o2. gc.regs_ok(regs, ARGS) -> runs(LSM[regs], s, o2) -> QQ(o2) proof
      fix regs o2
      assume hro hg
      have rl rln _ := hro
      have rn: seq_len(regs) = 6 := trans(rln, (seq_len(ARGS) = 6 by simp()))
      have lo: seq_len(regs) in omega by simp(rn)
      have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
      have ra: regs in sp.REGS by simp(rl, ol, keep(ord_le))
      have l6: int_le(seq_len(regs), 6) by arith(rn)
      have o6: ord_le(6, seq_len(regs)) by defs(simp(rn), ord_le)
      have hs := mp(all_elim(hL, {regs}, {s}, {o2}), rl, l6, hw, hg)
      have q0 := apply(gc.reg_at[regs := regs, args := ARGS, i := 0, w := 64, x := c_crt_crt1.main_at], hro, simp(), simp(), at({ARGS[0]}), simp(), mb)
      have q1 := apply(gc.reg_at[regs := regs, args := ARGS, i := 1, w := 32, x := W], hro, simp(), simp(), at({ARGS[1]}), simp(), wb)
      have q2 := apply(gc.reg_at[regs := regs, args := ARGS, i := 2, w := 64, x := AV], hro, simp(), simp(), at({ARGS[2]}), simp(), avb)
      have b := apply(sp.fun_out[n := 6, Q := a. startup_specs.start_main_spec(g, P, bits_of_int(64, a[0]), bits_of_int(32, a[1]), bits_of_int(64, a[2]))], ra, o6,
        expand(hs, startup_specs.start_main_spec_fun))
      show := rewrite(q0, rewrite(q1, rewrite(q2, b)))
    qed
    have ci := apply(gc.call0_inv[Q := o2. QQ(o2)], {LSM}, {ARGS}, {s}, {oc}, rg, hq, hrc)
    // its spec's runs _start_c's (the same requirement met, the same envp)
    let E2(x0) := bits_add(64, p, int_mul(8, int_add(gimple.bytes_at(app(x0, "vm"), p, 8), 2)))
    have eE: bits_add(64, AV, int_mul(8, int_add(W, 1))) = E2(s) by defs(arith(hp, hp2, wo, bq, sa3), bits_add, bits_of_int)
    have toSC: all o4. runs(SM, s, o4) -> runs(SC, s, o4) proof
      fix o4
      assume r4
      have x := mp(all_elim(sp.tm_same[R1 := x0. c_crt_crt1.main_at = P.main && startup_specs.start_main_pre(app(x0, "vm"), app(x0, "objs"), g, P, W, AV), R2 := x0. PRE(x0),
          E1 := x0. bits_add(64, AV, int_mul(8, int_add(W, 1))), E2 := x0. E2(x0), g := g], {s}, {o4}), taut(sym(hm), hsm), hpre, eE, expand(r4, startup_specs.start_main_spec))
      show by defs(x, startup_specs.start_c_spec)
    qed
    have mkSC: all o5. pair(s, o5) in univ(1) -> sp.TM(g, E2(s), s, o5) -> runs(SC, s, o5) proof
      fix o5
      assume pu5 t
      show by defs(apply(tr.runs_intro[r := x0 x1. !PRE(x0) || sp.TM(g, E2(x0), x0, x1)], {s}, {o5}, pu5, taut(t)), startup_specs.start_c_spec)
    qed
    have dc dt := apply(sp.d_cases, hdc)
    // a callee's outcome o4: _start_c's, or ok (to_main undefined: anything)
    have fin: all o4. runs(SM, s, o4) -> is_ok(o4) || (!is_ok(o4) && o = o4) -> runs(SC, s, o) proof
      fix o4
      assume r4 c
      have rsc := mp(all_elim(toSC, {o4}), r4)
      have c2: !is_ok(o4) && o = o4 -> runs(SC, s, o) proof
        assume q
        have _ e := q
        show := rewrite(sym(e), rsc)
      qed
      have c1: is_ok(o4) -> runs(SC, s, o) proof
        assume io
        have tsc: sp.TM(g, E2(s), s, o4) by taut(apply(g.runs_elim, expand(rsc, startup_specs.start_c_spec)), hpre)
        have cs := apply(sp.tm_cases, hw, tsc)
        have n1: sp.ovf_any(s, o4) -> false proof
          assume q
          obtain f v ob, _ _ _ e from expand(q, sp.ovf_any)
          show by taut(io, rewrite(sym(e), all_elim(g.not_ok_exc, {fn_update(fn_update(fn_update(s, "fs_base", f), "vm", v), "objs", ob)}, {exc_val("stack_overflow", empty)})))
        qed
        have n2: (ex V fs. (sp.TMV(g, E2(s), s, V) && fs in bits(64) && startup_specs.thread_set(V, fs)) &&
            o4 = exc(fn_update(fn_update(s, "vm", V), "fs_base", fs), sp.AM)) -> false proof
          assume q
          obtain V fs, _ _ _ _ _ _ e from q
          show by taut(io, rewrite(sym(e), all_elim(g.not_ok_exc, {fn_update(fn_update(s, "vm", V), "fs_base", fs)}, {sp.AM})))
        qed
        have vac: !(ex V. sp.TMV(g, E2(s), s, V)) by taut(cs, n1, n2)
        show := mp(all_elim(mkSC, {o}), pu, apply(sp.tm_vac, pu, vac, dt))
      qed
      show by taut(c, c1, c2)
    qed
    // the call's outcomes
    let OVF := exc_val("stack_overflow", empty)
    have pf pd := (("fs_base" in dom(s)) && ("objs" in dom(s)) by simp(expand(hw, abi.World)))
    have kA: oc = exc(s, OVF) -> runs(SC, s, o) proof
      assume e
      have oe: o = exc(s, OVF) := trans(mp(dc, rewrite(sym(e), all_elim(g.not_ok_exc, {s}, {OVF}))), e)
      have sv wf wd _ := apply(ms.world_parts, hw)
      have fsb: s.fs_base in bits(64) by simp(expand(hw, abi.World))
      have sob: s.objs in abi.Objs by simp(expand(hw, abi.World))
      have se: fn_update(fn_update(fn_update(s, "fs_base", s.fs_base), "vm", s.vm), "objs", s.objs) = s by simp(wf, wd, pf, pd)
      have ov: sp.ovf_any(s, o) by defs(ex_intro({s.fs_base}, {s.vm}, {s.objs}, taut(fsb, sv, sob, rewrite(sym(se), oe))), sp.ovf_any)
      show := mp(all_elim(mkSC, {o}), pu, apply(sp.eo_ovf[q := startup_specs.to_main(g, E2(s))], pu, ov))
    qed
    have kB: (ex w4 r. QQ(ok(w4, r)) && (oc = ok(gc.back0(w4, s), pair(fst(r), snd(r))) || oc = exc(gc.back0(w4, s), OVF))) -> runs(SC, s, o) proof
      assume q
      obtain w4 r, hq4 _ from q
      obtain o4, r4 k4 from expand(hq4, bind_rel)
      have kc := apply(sp.k_cases, k4)
      have iw: is_ok(ok(w4, r)) by defs(ex_intro({w4}, {r}, refl({ok(w4, r)})), is_ok)
      have c: is_ok(o4) || (!is_ok(o4) && o = o4) proof
        have n: (!is_ok(o4) && ok(w4, r) = o4) -> false proof
          assume q2
          have n4 e4 := q2
          show by taut(n4, rewrite(e4, iw))
        qed
        show by taut(kc, n)
      qed
      show := mp(all_elim(fin, {o4}), r4, c)
    qed
    have kC: (ex x e. QQ(exc(x, e)) && oc = exc(x, e)) -> runs(SC, s, o) proof
      assume q
      obtain x e, hq4 he from q
      obtain o4, r4 k4 from expand(hq4, bind_rel)
      have kc := apply(sp.k_cases, k4)
      have oe: o = exc(x, e) := rewrite(he, mp(dc, rewrite(sym(he), all_elim(g.not_ok_exc, {x}, {e}))))
      have n: (!is_ok(o4) && exc(x, e) = o4) -> !is_ok(o4) && o = o4 proof
        assume q2
        have a1 a2 := q2
        show by taut(a1, trans(oe, a2))
      qed
      have c: is_ok(o4) || (!is_ok(o4) && o = o4) by taut(kc, n)
      show := mp(all_elim(fin, {o4}), r4, c)
    qed
    have kD: (ex t. QQ(diverge(t)) && oc = diverge(t)) -> runs(SC, s, o) proof
      assume q
      obtain t, hq4 he from q
      obtain o4, r4 k4 from expand(hq4, bind_rel)
      have kc := apply(sp.k_cases, k4)
      have oe: o = diverge(t) := rewrite(he, mp(dc, rewrite(sym(he), all_elim(g.not_ok_div, {t}))))
      have n: (!is_ok(o4) && diverge(t) = o4) -> !is_ok(o4) && o = o4 proof
        assume q2
        have a1 a2 := q2
        show by taut(a1, trans(oe, a2))
      qed
      have c: is_ok(o4) || (!is_ok(o4) && o = o4) by taut(kc, n)
      show := mp(all_elim(fin, {o4}), r4, c)
    qed
    have r: runs(SC, s, o) by taut(ci, kA, kB, kC, kD)
    show := apply(sp.as_of, r)
  qed
  show by taut(cN, cP)
qed

// (the registers: the function's domain)
theorem sp.regs_in(regs): regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> regs in sp.REGS
proof
  assume hr hl
  have lo: seq_len(regs) in omega by simp(hr)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(hl, lo), ord_le)
  show by simp(hr, ol, keep(ord_le))
qed

// _start_c's C function refines its spec's
theorem sp.stc_fun: all g P LSM regs s o. P.main = c_crt_crt1.main_at -> mp.calls(LSM, startup_specs.start_main_spec_fun(g, P)) ->
  regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
  runs(c_crt_crt1._start_c_fun(LSM)[regs], s, o) -> runs(startup_specs.start_c_spec_fun(g, P)[regs], s, o)
proof
  fix g P LSM regs s o
  assume hm hL hr hl hw h
  have ra := mp(sp.regs_in[regs := regs], hr, hl)
  have hp: ord_le(1, seq_len(regs)) -> all o3. runs(c_crt_crt1._start_c(bits_of_int(64, regs[0]), LSM), s, o3) ->
      sp.as_spec(startup_specs.start_c_spec(g, P, bits_of_int(64, regs[0])), s, o3) proof
    assume _
    fix o3
    assume r3
    show := mp(all_elim(sp.stc_run, {g}, {P}, {LSM}, {bits_of_int(64, regs[0])}, {s}, {o3}), hw, (bits_of_int(64, regs[0]) in bits(64) by simp()), hm, hL, r3)
  qed
  show by defs(apply(sp.fun_r[n := 1, P := a. c_crt_crt1._start_c(bits_of_int(64, a[0]), LSM), Q := a. startup_specs.start_c_spec(g, P, bits_of_int(64, a[0]))],
    {regs}, {s}, {o}, ra, hp, expand(h, c_crt_crt1._start_c_fun)), startup_specs.start_c_spec_fun)
qed

// ----------------------------------------------------------------------
//  libc_start_main_stage2(main, argc, argv): __libc_start_init called as
//  its spec says (an overflow, or nothing), then main entered

// (a spec function's ok outcome: at its procedure's world)
theorem sp.anyv_ok(w, o2): sp.anyv(w, o2) -> ex v. o2 = ok(w, v)
proof
  assume h
  have nb: ex z. z in bits(64) by ex_intro({0}, simp())
  obtain z1, _ k1 from apply(g.any_e, nb, h)
  obtain z2, _ k2 from apply(g.any_e, nb, k1)
  show by ex_intro({pair(z1, z2)}, k2)
qed

// (a spec function without a requirement called)
theorem sp.fun_out0(a. Q): all regs s o2. regs in sp.REGS ->
  runs(fn_build(sp.REGS, x0. mkprog(x1 x2. bind_rel(Q(x0), x1, x3 x4. sp.anyv(x3, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))))[regs], s, o2) ->
  bind_rel(Q(regs), s, x3 x4. sp.anyv(x3, o2), x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3))
proof
  fix regs s o2
  assume hr h
  rsimp only, app_fn_build, hr in h
  show := apply(g.runs_elim, h)
qed

// (an overflow_start of the body: an overflow)
theorem sp.ovs_case(s, x2, o): s in abi.World -> sp.BR(startup_specs.overflow_start, s, x2) -> sp.DS(x2, o) -> sp.ovf_any(s, o)
proof
  assume hw e1 hout
  let OVF := exc_val("stack_overflow", empty)
  rsimp only, startup_specs.overflow_start, abi.overflow in e1
  have pv _ _ _ := apply(ms.world_parts, hw)
  have vv: ex x. x in x86_64_linux.Vm by ex_intro({s.vm}, simp(pv))
  have fv: ex x. x in bits(64) by ex_intro({0}, simp())
  have l: ex f v ob. ((f in bits(64) && v in x86_64_linux.Vm) && ob in abi.Objs) &&
    x2 = exc(pair(fn_update(fn_update(fn_update(s, "fs_base", f), "vm", v), "objs", ob), empty), pair("raise", OVF)) by simp(e1, vv, fv, ct.objs_ne)
  obtain f v ob, hf hv hob hx from l
  have oe: o = exc(fn_update(fn_update(fn_update(s, "fs_base", f), "vm", v), "objs", ob), OVF) by simp(rewrite(hx, hout))
  show by defs(ex_intro({f}, {v}, {ob}, taut(hf, hv, hob, oe)), sp.ovf_any)
qed

// __libc_start_init's spec called: an overflow, or nothing changed
theorem sp.si_call(P, s, o2): s in abi.World -> startup_specs.ctors_ok(s.vm, s.objs, P, set_select(omega, x2. false)) ->
  bind_rel(startup_specs.start_init_spec(P), s, x3 x4. sp.anyv(x3, o2), x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3)) ->
  sp.ovf_any(s, o2) || (ex v. o2 = ok(s, v))
proof
  assume hw hc h
  obtain o4, r4 k4 from expand(h, bind_rel)
  have b := apply(or_resolve, apply(g.runs_elim, expand(r4, startup_specs.start_init_spec)), hc)
  obtain x2, hbr hd from b
  have c1: sp.BR(startup_specs.overflow_start, s, x2) -> sp.ovf_any(s, o2) || (ex v. o2 = ok(s, v)) proof
    assume e
    have ov := apply(sp.ovs_case, hw, e, hd)
    obtain f v ob, _ _ _ oe from expand(ov, sp.ovf_any)
    have nk: !is_ok(o4) := rewrite(sym(oe), all_elim(g.not_ok_exc, {fn_update(fn_update(fn_update(s, "fs_base", f), "vm", v), "objs", ob)}, {exc_val("stack_overflow", empty)}))
    have kc := apply(sp.k_cases, k4)
    have q: (!is_ok(o4) && o2 = o4) -> sp.ovf_any(s, o2) proof
      assume q2
      have _ e2 := q2
      show := rewrite(sym(e2), ov)
    qed
    show by taut(kc, nk, q)
  qed
  have c2: x2 = ok(pair(s, empty), empty) -> sp.ovf_any(s, o2) || (ex v. o2 = ok(s, v)) proof
    assume e
    have oe: o4 = ok(s, empty) by simp(rewrite(e, hd))
    have a: sp.anyv(s, o2) by simp(rewrite(oe, k4), keep(any_rel))
    show by taut(apply(sp.anyv_ok, a))
  qed
  show by taut(hbr, c1, c2)
qed

// main's spec called: main entered, at the world it is called in
theorem sp.main_call(regs, s, o2): regs in sp.REGS -> runs(startup_specs.main_spec_fun()[regs], s, o2) -> o2 = exc(s, sp.AM)
proof
  assume hr h
  have b := apply(sp.fun_out0[Q := a. startup_specs.main_entered], {regs}, {s}, {o2}, hr, expand(h, startup_specs.main_spec_fun))
  obtain o5, r5 k5 from expand(b, bind_rel)
  have e5: o5 = exc(s, sp.AM) by simp(apply(g.runs_elim, expand(r5, startup_specs.main_entered)))
  show by simp(rewrite(e5, k5))
qed

// main entered: the body's
theorem sp.eo_q(q, s, w, e): runs(q, s, exc(w, e)) -> sp.EO(q, s, exc(w, e))
proof
  assume r
  let X2 := exc(pair(w, empty), pair("raise", e))
  have cx: ex x3 x4. exc(w, e) = exc(x3, x4) && X2 = exc(pair(x3, empty), pair("raise", x4)) by ex_intro({w}, {e}, taut(refl({exc(w, e)}), refl({X2})))
  have b: sp.BR(q, s, X2) by defs(ex_intro({exc(w, e)}, taut(r, cx)), bind_rel)
  have d: sp.DS(X2, exc(w, e)) by simp()
  show by ex_intro({X2}, taut(b, d))
qed

// stage2's procedure refines its spec's
theorem sp.st2_run: all P main argc argv SI FP EX s o. s in abi.World -> main in bits(64) -> argc in bits(32) -> argv in bits(64) ->
  mp.calls(SI, startup_specs.start_init_spec_fun(P)) -> mp.calls(FP[P.main], startup_specs.main_spec_fun()) ->
  runs(c_src_env___libc_start_main.libc_start_main_stage2(main, argc, argv, SI, FP, EX), s, o) ->
  sp.as_spec(startup_specs.stage2_spec(P, main, argc, argv), s, o)
proof
  fix P main argc argv SI FP EX s o
  assume hw hmb hab hvb hSI hFP h
  let S2 := startup_specs.stage2_spec(P, main, argc, argv)
  have pu := apply(g.runs_univ, expand(h, c_src_env___libc_start_main.libc_start_main_stage2))
  have hu: s in univ(1) by simp(pu)
  let PRE(x0) := ((main = P.main && int_lt(argc, int_pow(2, 31))) && int_lt(int_add(argv, int_mul(8, int_add(argc, 1))), int_pow(2, 63))) &&
    startup_specs.ctors_ok(app(x0, "vm"), app(x0, "objs"), P, set_select(omega, x2. false))
  have cN: !PRE(s) -> sp.as_spec(S2, s, o) proof
    assume hn
    have r: runs(S2, s, o) by defs(apply(sp.req_fail[R := x0. PRE(x0), B := x0 x1. sp.EO(startup_specs.main_entered, x0, x1)], {s}, {o}, pu, hn), startup_specs.stage2_spec)
    show := apply(sp.as_of, r)
  qed
  have cP: PRE(s) -> sp.as_spec(S2, s, o) proof
    assume hpre
    have hm h31 hb63 hct := hpre
    let OVF := exc_val("stack_overflow", empty)
    let M := int_mul(8, int_add(argc, 1))
    let TY := fn_update(fn_update(empty, "prec", 64), "signed", true)
    have mkS2: all o5. pair(s, o5) in univ(1) -> sp.EO(startup_specs.main_entered, s, o5) -> runs(S2, s, o5) proof
      fix o5
      assume pu5 t
      show by defs(apply(tr.runs_intro[r := x0 x1. !PRE(x0) || sp.EO(startup_specs.main_entered, x0, x1)], {s}, {o5}, pu5, taut(t)), startup_specs.stage2_spec)
    qed
    have ovS2: sp.ovf_any(s, o) -> sp.as_spec(S2, s, o) proof
      assume ov
      show := apply(sp.as_of, mp(all_elim(mkS2, {o}), pu, apply(sp.eo_ovf[q := startup_specs.main_entered], pu, ov)))
    qed
    // envp: argv + 8 (argc + 1), within the address space
    have ao: argc in omega by simp(hab)
    have vo: argv in omega by simp(hvb)
    have m1: bits_of_int(32, argc) = argc by defs(arith(ao, h31), bits_of_int)
    have m2: bits_of_int(64, argc) = argc by defs(arith(ao, h31), bits_of_int)
    have p31: int_lt(argc, pow2(31)) by arith(h31)
    have eS: bits_sext(32, 64, argc) = argc by defs(simp(m1, m2, p31), bits_sext, sint, letin)
    have eA1: bits_add(64, argc, 1) = int_add(argc, 1) by defs(arith(ao, h31), bits_add)
    have eM: bits_mul(64, int_add(argc, 1), 8) = M by defs(arith(ao, h31), bits_mul)
    have p63: int_pow(2, int_sub(64, 1)) = 9223372036854775808 by simp()
    have nlt: !int_le(int_pow(2, int_sub(64, 1)), M) by arith(ao, h31, p63)
    have eV: gimple.sval(TY, M) = M by defs(simp(nlt), gimple.sval)
    have ml: int_lt(M, pow2(64)) by arith(ao, h31)
    have mb: M in bits(64) by defs(simp(ao, ml), bits)
    have pz: int_le(0, int_add(argv, gimple.sval(TY, M))) by arith(eV, ao, vo)
    have pl: int_lt(int_add(argv, gimple.sval(TY, M)), pow2(64)) by arith(eV, ao, vo, hb63)
    have b := apply(g.runs_elim, expand(h, c_src_env___libc_start_main.libc_start_main_stage2))
    step a1, h0 from b
    have h0r := rewrite(eM, rewrite(eA1, rewrite(eS, h0)))
    step h1 from h0r with g.padd_det using conj(hu, hvb, mb, pz, pl)
    have h1r := rewrite(eV, h1)
    let ENV := int_add(argv, M)
    have sv wf wd _ := apply(ms.world_parts, hw)
    have od: "objs" in dom(s) by simp(expand(hw, abi.World))
    have fd: "fs_base" in dom(s) by simp(expand(hw, abi.World))
    have fsb: s.fs_base in bits(64) by simp(expand(hw, abi.World))
    have sob: s.objs in abi.Objs by simp(expand(hw, abi.World))
    have se: fn_update(fn_update(fn_update(s, "fs_base", s.fs_base), "vm", s.vm), "objs", s.objs) = s by simp(wf, wd, fd, od)
    // an overflow at s: the spec's
    have ovs: o = exc(s, OVF) -> sp.as_spec(S2, s, o) proof
      assume e
      have ov: sp.ovf_any(s, o) by defs(ex_intro({s.fs_base}, {s.vm}, {s.objs}, taut(fsb, sv, sob, rewrite(sym(se), e))), sp.ovf_any)
      show := mp(ovS2, ov)
    qed
    // __libc_start_init called: an overflow, or nothing
    obtain oc, hrc hdc from apply(g.bind_open, h1r)
    let QS(o2) := sp.ovf_any(s, o2) || (ex v. o2 = ok(s, v))
    have rg0 := gc.regs0_ex
    have hqs: all regs o2. gc.regs_ok(regs, empty) -> runs(SI[regs], s, o2) -> QS(o2) proof
      fix regs o2
      assume hro hg
      have rl rn := apply(gc.regs0, hro)
      have l6: int_le(seq_len(regs), 6) by arith(rn)
      have ra := mp(sp.regs_in[regs := regs], rl, l6)
      have hs := mp(all_elim(hSI, {regs}, {s}, {o2}), rl, l6, hw, hg)
      have b2 := apply(sp.fun_out0[Q := a. startup_specs.start_init_spec(P)], {regs}, {s}, {o2}, ra, expand(hs, startup_specs.start_init_spec_fun))
      show := apply(sp.si_call, hw, hct, b2)
    qed
    have ci := apply(gc.call0_inv[Q := o2. QS(o2)], {SI}, {empty}, {s}, {oc}, rg0, hqs, hrc)
    have kA: oc = exc(s, OVF) -> sp.as_spec(S2, s, o) proof
      assume e
      have oe: o = exc(s, OVF) by simp(rewrite(e, hdc))
      show := mp(ovs, oe)
    qed
    have kC: (ex x e. QS(exc(x, e)) && oc = exc(x, e)) -> sp.as_spec(S2, s, o) proof
      assume q
      obtain x e, hq4 he from q
      have nk: !(ex v. exc(x, e) = ok(s, v)) by defs(simp(), ok, exc)
      have ov: sp.ovf_any(s, exc(x, e)) by taut(hq4, nk)
      have oe: o = exc(x, e) by simp(rewrite(he, hdc))
      show := mp(ovS2, rewrite(sym(oe), ov))
    qed
    have kD: (ex t. QS(diverge(t)) && oc = diverge(t)) -> sp.as_spec(S2, s, o) proof
      assume q
      obtain t, hq4 _ from q
      have f: false by defs(simp(expand(hq4, sp.ovf_any)), ok, exc, diverge)
      show by taut(f)
    qed
    // ... nothing: main called at s
    have kB: (ex w4 r. QS(ok(w4, r)) && (oc = ok(gc.back0(w4, s), pair(fst(r), snd(r))) || oc = exc(gc.back0(w4, s), OVF))) -> sp.as_spec(S2, s, o) proof
      assume q
      obtain w4 r, hq4 ho4 from q
      have no: !sp.ovf_any(s, ok(w4, r)) by defs(simp(), sp.ovf_any, ok, exc)
      obtain v, e4 from (ex v. ok(w4, r) = ok(s, v) by taut(hq4, no))
      have w4e: w4 = s by simp(e4)
      have os := apply(gc.objs_same, hw)
      have bk: gc.back0(w4, s) = s by simp(w4e, os, wf, od)
      have k2: oc = exc(gc.back0(w4, s), OVF) -> sp.as_spec(S2, s, o) proof
        assume e
        show := mp(kA, rewrite(bk, e))
      qed
      have k1: oc = ok(gc.back0(w4, s), pair(fst(r), snd(r))) -> sp.as_spec(S2, s, o) proof
        assume e
        step h2 from rewrite(bk, rewrite(e, hdc))
        obtain oc2, hrc2 hdc2 from apply(g.bind_open, h2)
        obtain o3, r3 rel3 from apply(sp.call1_0_e, hrc2)
        let ARGS2 := seq_concat(seq_concat(seq_one(gimple.arg(32, argc)), seq_one(gimple.arg(64, argv))), seq_one(gimple.arg(64, ENV)))
        have el: int_lt(ENV, pow2(64)) by arith(hb63, ao, vo)
        have eo: ENV in omega by simp(ao, vo)
        have envb: ENV in bits(64) by defs(simp(eo, el), bits)
        have rg2 := apply(gc.regs_get, apply(gc.regs_cat, apply(gc.regs_cat, apply(gc.regs_one[w := 32, x := argc], simp(), simp(), hab),
          apply(gc.regs_one[w := 64, x := argv], simp(), simp(), hvb)), apply(gc.regs_one[w := 64, x := ENV], simp(), simp(), envb)))
        have hFm := rewrite(sym(hm), hFP)
        have hq2: all regs o2. gc.regs_ok(regs, ARGS2) -> runs(FP[main][regs], s, o2) -> o2 = exc(s, sp.AM) proof
          fix regs o2
          assume hro hg
          have rl rln _ := hro
          have rn: seq_len(regs) = 3 := trans(rln, (seq_len(ARGS2) = 3 by simp()))
          have l6: int_le(seq_len(regs), 6) by arith(rn)
          have ra := mp(sp.regs_in[regs := regs], rl, l6)
          have hs := mp(all_elim(hFm, {regs}, {s}, {o2}), rl, l6, hw, hg)
          show := apply(sp.main_call, ra, hs)
        qed
        have ci2 := apply(gc.call0_inv[Q := o2. o2 = exc(s, sp.AM)], {FP[main]}, {ARGS2}, {s}, {o3}, rg2, hq2, r3)
        // (the call's exception o3: o's)
        have ox: all X E. o3 = exc(X, E) -> o = exc(X, E) proof
          fix X E
          assume e3
          have e2: oc2 = exc(X, E) by simp(rewrite(e3, rel3))
          show by simp(rewrite(e2, hdc2))
        qed
        have m1: o3 = exc(s, OVF) -> sp.as_spec(S2, s, o) proof
          assume e3
          show := mp(ovs, mp(all_elim(ox, {s}, {OVF}), e3))
        qed
        have m2: (ex w5 r5. ok(w5, r5) = exc(s, sp.AM) && (o3 = ok(gc.back0(w5, s), pair(fst(r5), snd(r5))) || o3 = exc(gc.back0(w5, s), OVF))) -> sp.as_spec(S2, s, o) proof
          assume q2
          obtain w5 r5, f _ from q2
          have ff: false by defs(simp(f), ok, exc)
          show by taut(ff)
        qed
        have m3: (ex x e. exc(x, e) = exc(s, sp.AM) && o3 = exc(x, e)) -> sp.as_spec(S2, s, o) proof
          assume q2
          obtain x e, f e3 from q2
          have e4: o3 = exc(s, sp.AM) := trans(e3, f)
          have oe := mp(all_elim(ox, {s}, {sp.AM}), e4)
          have pu2 := rewrite(oe, pu)
          have rm: runs(startup_specs.main_entered, s, exc(s, sp.AM)) by defs(apply(tr.runs_intro[r := x0 x1. x1 = exc(x0, sp.AM)], {s}, {exc(s, sp.AM)}, pu2, refl({exc(s, sp.AM)})),
            startup_specs.main_entered)
          have r: runs(S2, s, exc(s, sp.AM)) := mp(all_elim(mkS2, {exc(s, sp.AM)}), pu2, apply(sp.eo_q[q := startup_specs.main_entered], rm))
          show := apply(sp.as_of, rewrite(sym(oe), r))
        qed
        have m4: (ex t. diverge(t) = exc(s, sp.AM) && o3 = diverge(t)) -> sp.as_spec(S2, s, o) proof
          assume q2
          obtain t, f _ from q2
          have ff: false by defs(simp(f), exc, diverge)
          show by taut(ff)
        qed
        show by taut(ci2, m1, m2, m3, m4)
      qed
      show by taut(ho4, k1, k2)
    qed
    show by taut(ci, kA, kB, kC, kD)
  qed
  show by taut(cN, cP)
qed

// (an int result of any value: some register at the same world)
theorem sp.res32(w, v, o): runs(gimple.result(32, v), w, o) -> ex u. u in bits(64) && o = ok(w, u)
proof
  assume h
  let I := int_val(v)
  have iv := g.iv_in[a := v]
  have p32: int_pow(2, 32) = 4294967296 by simp()
  have mv: int_mod(v, 4294967296) = int_mod(I, 4294967296) by defs(simp(g.iv_eq[a := v]), int_mod)
  let X := int_mod(I, 4294967296)
  have xo: X in omega by arith(iv)
  have xl: int_lt(X, 4294967296) by arith(iv)
  have xm: int_mod(X, 4294967296) = X by arith(xo, xl)
  have xb: X in bits(64) by defs(simp(xo, (int_lt(X, pow2(64)) by arith(xl))), bits)
  have xr: X in gimple.in_reg(v, fn_update(fn_update(empty, "prec", 32), "signed", false)) by defs(simp(xb, xm, mv, p32), gimple.in_reg)
  have ne: ex x. x in bits(64) && x in gimple.in_reg(v, fn_update(fn_update(empty, "prec", 32), "signed", false)) by ex_intro({X}, conj(xb, xr))
  obtain r, hr1 _ ho from apply(g.any_e, ne, apply(g.runs_elim, h))
  show by ex_intro({r}, conj(hr1, ho))
qed

// (an int function's ending: any values at the procedure's world)
abbrev sp.KC32(x3, x4, x2) := letin(x4, x5. bind_rel(gimple.result(32, x5), x3, x6 x7. any_rel(x8. x8 in bits(64), x8. x2 = ok(x6, pair(x7, x8))),
  x6 x7. x2 = exc(x6, x7), x6. x2 = diverge(x6)))

theorem sp.kc32(w, v, o): sp.KC32(w, v, o) -> sp.anyv(w, o)
proof
  assume h
  obtain o6, r6 k6 from apply(g.bind_open, apply(g.letin_e, h))
  obtain u, hu e6 from apply(sp.res32, r6)
  have k7: any_rel(x8. x8 in bits(64), x8. o = ok(w, pair(u, x8))) by simp(rewrite(e6, k6), keep(any_rel))
  have nb: ex z. z in bits(64) by ex_intro({0}, simp())
  obtain z, hz e from apply(g.any_e, nb, k7)
  have i2: !(ex x6. x6 in bits(64)) || (ex x6. x6 in bits(64) && o = ok(w, pair(u, x6))) by taut((ex x6. x6 in bits(64) && o = ok(w, pair(u, x6)) by ex_intro({z}, conj(hz, e))))
  have i1: ex x5. x5 in bits(64) && (!(ex x6. x6 in bits(64)) || (ex x6. x6 in bits(64) && o = ok(w, pair(x5, x6)))) by ex_intro({u}, conj(hu, i2))
  show by defs(taut(i1), any_rel)
qed

// a function value with a requirement, its ending any whose ok outcomes
// are the spec's
theorem sp.fun_rk(n, a. P, x3 x4 x2. K, a. Q): all regs s o. regs in sp.REGS -> (all x3 x4 x2. K(x3, x4, x2) -> sp.anyv(x3, x2)) ->
  (ord_le(n, seq_len(regs)) -> all o3. runs(P(regs), s, o3) -> sp.as_spec(Q(regs), s, o3)) ->
  runs(fn_build(sp.REGS, x0. mkprog(x1 x2. !ord_le(n, seq_len(x0)) || bind_rel(P(x0), x1, x3 x4. K(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))))[regs], s, o) ->
  runs(fn_build(sp.REGS, x0. mkprog(x1 x2. !ord_le(n, seq_len(x0)) || bind_rel(Q(x0), x1, x3 x4. sp.anyv(x3, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))))[regs], s, o)
proof
  fix regs s o
  assume hr hK hp h
  rsimp only, app_fn_build, hr in h
  rsimp only, app_fn_build, hr
  have pu := apply(g.runs_univ, h)
  have b := apply(g.runs_elim, h)
  have c1: ord_le(n, seq_len(regs)) -> bind_rel(Q(regs), s, x3 x4. sp.anyv(x3, o), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) proof
    assume hn
    have b2: bind_rel(P(regs), s, x3 x4. K(x3, x4, o), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) by taut(b, hn)
    obtain o3, hs3 hk3 from expand(b2, bind_rel)
    have ck: (ex s1 v. o3 = ok(s1, v) && K(s1, v, o)) -> (ex s1 v. o3 = ok(s1, v) && sp.anyv(s1, o)) proof
      assume q
      obtain s1 v, e k from q
      show by ex_intro({s1}, {v}, conj(e, mp(all_elim(hK, {s1}, {v}, {o}), k)))
    qed
    have hk4: (ex s1 v. o3 = ok(s1, v) && sp.anyv(s1, o)) || (ex s1 e. o3 = exc(s1, e) && o = exc(s1, e)) || (ex t. o3 = diverge(t) && o = diverge(t)) by taut(hk3, ck)
    have q := mp(all_elim(mp(hp, hn), {o3}), hs3)
    show := mp(sp.cont_as[Q := Q(regs), s := s, o := o, o3 := o3], hk4, q)
  qed
  show := apply(tr.runs_intro[r := x1 x2. !ord_le(n, seq_len(regs)) || bind_rel(Q(regs), x1, x3 x4. sp.anyv(x3, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))],
    {s}, {o}, pu, taut(b, c1))
qed

// stage2's C function refines its spec's
theorem sp.st2_fun: all P SI FP EX regs s o. mp.calls(SI, startup_specs.start_init_spec_fun(P)) -> mp.calls(FP[P.main], startup_specs.main_spec_fun()) ->
  regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
  runs(c_src_env___libc_start_main.libc_start_main_stage2_fun(SI, FP, EX)[regs], s, o) -> runs(startup_specs.stage2_spec_fun(P)[regs], s, o)
proof
  fix P SI FP EX regs s o
  assume hSI hFP hr hl hw h
  have ra := mp(sp.regs_in[regs := regs], hr, hl)
  have hp: ord_le(3, seq_len(regs)) -> all o3. runs(c_src_env___libc_start_main.libc_start_main_stage2(bits_of_int(64, regs[0]), bits_of_int(32, regs[1]), bits_of_int(64, regs[2]),
      SI, FP, EX), s, o3) -> sp.as_spec(startup_specs.stage2_spec(P, bits_of_int(64, regs[0]), bits_of_int(32, regs[1]), bits_of_int(64, regs[2])), s, o3) proof
    assume _
    fix o3
    assume r3
    show := mp(all_elim(sp.st2_run, {P}, {bits_of_int(64, regs[0])}, {bits_of_int(32, regs[1])}, {bits_of_int(64, regs[2])}, {SI}, {FP}, {EX}, {s}, {o3}), hw,
      (bits_of_int(64, regs[0]) in bits(64) by simp()), (bits_of_int(32, regs[1]) in bits(32) by simp()), (bits_of_int(64, regs[2]) in bits(64) by simp()), hSI, hFP, r3)
  qed
  have hK: all x3 x4 x2. sp.KC32(x3, x4, x2) -> sp.anyv(x3, x2) proof
    fix x3 x4 x2
    show := sp.kc32[w := x3, v := x4, o := x2]
  qed
  show by defs(apply(sp.fun_rk[n := 3, P := a. c_src_env___libc_start_main.libc_start_main_stage2(bits_of_int(64, a[0]), bits_of_int(32, a[1]), bits_of_int(64, a[2]), SI, FP, EX),
      K := x3 x4 x2. sp.KC32(x3, x4, x2), Q := a. startup_specs.stage2_spec(P, bits_of_int(64, a[0]), bits_of_int(32, a[1]), bits_of_int(64, a[2]))],
    {regs}, {s}, {o}, ra, hK, hp, expand(h, c_src_env___libc_start_main.libc_start_main_stage2_fun)), startup_specs.stage2_spec_fun)
qed

// ----------------------------------------------------------------------
//  __libc_start_main(main, argc, argv, ..): envp past argv's words,
//  __init_libc called as its spec says (libc set up), then stage2 through
//  its pointer (the constructors, main entered)

// the constructors' table: kept by a frame of writes apart from it
theorem sp.ctors_keep(b, U, objs, P, W): P.init_array in bits(64) -> startup_specs.ctors_ok(b, objs, P, W) -> startup_specs.frame(b, U, objs, W) ->
  startup_specs.ctors_ok(U, objs, P, set_select(omega, x2. false))
proof
  assume hpb hc hf
  have pio: P.init_array in omega by simp(hpb)
  have hb _ := expand(hf, startup_specs.frame)
  obtain n, hn he hl hall from expand(hc, startup_specs.ctors_ok)
  have each: all i. i in omega -> int_lt(i, n) -> (gimple.usable(U, objs, int_add(P.init_array, int_mul(8, i)), 8, false) &&
      gimple.bytes_at(U, bits_add(64, P.init_array, int_mul(8, i)), 8) = P.ctor) && (all j. j in omega -> int_lt(j, 8) -> !(int_add(int_add(P.init_array, int_mul(8, i)), j) in set_select(omega, x2. false))) proof
    fix i
    assume hi hil
    have u1 b1 w1 := mp(all_elim(hall, {i}), hi, hil)
    let A := int_add(P.init_array, int_mul(8, i))
    have u2 := apply(mp.usable_bytes[v := b, v2 := U, objs := objs, a := A, n := 8, w := false], hb, u1)
    have ao: A in omega by arith(hi, pio)
    have ww: all j. j in omega -> int_lt(j, 8) -> !(int_add(A, j) in W) := w1
    have r := apply(sp.fr_read[b := b, U := U, objs := objs, W := W, a := A, n := 8, wr := false], hf, u1, ww, ao, simp())
    have ab: bits_add(64, P.init_array, int_mul(8, i)) = A by defs(arith(hi, hil, he, hl, ao, pio), bits_add)
    have b2: gimple.bytes_at(U, bits_add(64, P.init_array, int_mul(8, i)), 8) = P.ctor := rewrite(sym(ab), trans(r, rewrite(ab, b1)))
    have nf: all j. j in omega -> int_lt(j, 8) -> !(int_add(A, j) in set_select(omega, x2. false)) proof
      fix j
      assume _ _
      show by simp()
    qed
    show by taut(u2, b2, nf)
  qed
  show by defs(ex_intro({n}, taut(hn, he, hl, each)), startup_specs.ctors_ok)
qed

// an overflow at a later world (its memory and thread pointer set): one
// at the first
theorem sp.ovf_up(s, V, fs, o): sp.ovf_any(fn_update(fn_update(s, "vm", V), "fs_base", fs), o) -> sp.ovf_any(s, o)
proof
  assume h
  obtain f v ob, hf hv hob e from expand(h, sp.ovf_any)
  have n: fn_update(fn_update(fn_update(fn_update(fn_update(s, "vm", V), "fs_base", fs), "fs_base", f), "vm", v), "objs", ob) =
    fn_update(fn_update(fn_update(s, "fs_base", f), "vm", v), "objs", ob) by simp()
  show by defs(ex_intro({f}, {v}, {ob}, taut(hf, hv, hob, rewrite(n, e))), sp.ovf_any)
qed

// stage2's body: an overflow, or main entered at the world it began in
theorem sp.eo_me(s, o): s in abi.World -> sp.EO(startup_specs.main_entered, s, o) -> sp.ovf_any(s, o) || o = exc(s, sp.AM)
proof
  assume hw h
  obtain x2, hbr hd from h
  have c1: sp.BR(startup_specs.overflow_start, s, x2) -> sp.ovf_any(s, o) proof
    assume e
    show := apply(sp.ovs_case, hw, e, hd)
  qed
  have c2: sp.BR(startup_specs.main_entered, s, x2) -> o = exc(s, sp.AM) proof
    assume e
    obtain o5, r5 k5 from apply(g.bind_open, e)
    have e5: o5 = exc(s, sp.AM) by simp(apply(g.runs_elim, expand(r5, startup_specs.main_entered)))
    have x2e: x2 = exc(pair(s, empty), pair("raise", sp.AM)) by simp(rewrite(e5, k5))
    show by simp(rewrite(x2e, hd))
  qed
  show by taut(hbr, c1, c2)
qed

// __init_libc's spec: an overflow, libc set up (to_main's memory, a
// thread), or no such memory (the spec undefined)
theorem sp.il_q(g, e, pn, s, o4): s in abi.World -> startup_specs.init_libc_pre(s.vm, s.objs, g, e, pn) -> runs(startup_specs.init_libc_spec(g, e, pn), s, o4) ->
  sp.ovf_any(s, o4) || (ex V fs. (sp.TMV(g, e, s, V) && fs in bits(64) && startup_specs.thread_set(V, fs)) && o4 = ok(fn_update(fn_update(s, "vm", V), "fs_base", fs), empty)) ||
  !(ex V. sp.TMV(g, e, s, V))
proof
  assume hw hpre r
  have b := apply(or_resolve, apply(g.runs_elim, expand(r, startup_specs.init_libc_spec)), hpre)
  obtain x2, hbr hd from b
  have k1: case 1 of hbr proof
    assume e1
    have ov := apply(sp.ovs_case, hw, e1, hd)
    show by taut(ov)
  qed
  have k2: case 2 of hbr proof
    assume e2
    have cv: (ex V. sp.TMV(g, e, s, V)) -> ex V fs. (sp.TMV(g, e, s, V) && fs in bits(64) && startup_specs.thread_set(V, fs)) &&
        o4 = ok(fn_update(fn_update(s, "vm", V), "fs_base", fs), empty) proof
      assume hex
      have b5 := apply(g.letin_e, e2)
      rsimp in b5
      obtain V, hV hfr hl8 hfs0 hk from apply(g.any_e, hex, b5)
      have hk1 := apply(g.letin_e, hk)
      rsimp in hk1
      obtain fs, hfb hts hk2 from apply(g.any_e, hfs0, hk1)
      have xe := apply(g.letin_e, hk2)
      have oe: o4 = ok(fn_update(fn_update(s, "vm", V), "fs_base", fs), empty) by simp(rewrite(xe, hd))
      show by ex_intro({V}, {fs}, taut(hV, hfr, hl8, hfs0, hfb, hts, oe))
    qed
    show by taut(cv)
  qed
  show by taut(hbr, k1, k2)
qed

// (a choice: by a value in its domain)
theorem sp.any_i(x. d, x. k, a): d(a) -> k(a) -> any_rel(x. d(x), x. k(x))
proof
  assume h1 h2
  have x: ex x. d(x) && k(x) by ex_intro({a}, conj(h1, h2))
  show by defs(taut(x), any_rel)
qed

// libc set up and main entered: the body's
theorem sp.tm_main(g, e, s, V, fs, o): pair(s, o) in univ(1) -> o = exc(fn_update(fn_update(s, "vm", V), "fs_base", fs), sp.AM) -> sp.TMV(g, e, s, V) ->
  fs in bits(64) -> startup_specs.thread_set(V, fs) -> sp.TM(g, e, s, o)
proof
  assume pu ho hv hf hts
  let W1 := fn_update(fn_update(s, "vm", V), "fs_base", fs)
  have ou := apply(g.univ_snd, {s}, {o}, pu)
  have w1u: W1 in univ(1) by simp(rewrite(ho, ou))
  have pw: pair(W1, o) in univ(1) := apply(g.pair_univ, w1u, ou)
  have rm: runs(startup_specs.main_entered, W1, o) by defs(apply(tr.runs_intro[r := x0 x1. x1 = exc(x0, sp.AM)], {W1}, {o}, pw, ho), startup_specs.main_entered)
  have xe: ex x4 x5. o = exc(x4, x5) && o = exc(x4, x5) by ex_intro({W1}, {sp.AM}, conj(ho, ho))
  have bm: bind_rel(startup_specs.main_entered, W1, x4 x5. o = ok(x4, empty), x4 x5. o = exc(x4, x5), x4. o = diverge(x4)) by defs(ex_intro({o}, taut(rm, xe)), bind_rel)
  have dfs: fs in bits(64) && startup_specs.thread_set(app(fn_update(s, "vm", V), "vm"), fs) by simp(hf, hts)
  have kfs: letin(W1, x3. bind_rel(startup_specs.main_entered, x3, x4 x5. o = ok(x4, empty), x4 x5. o = exc(x4, x5), x4. o = diverge(x4))) by defs(bm, letin)
  have k2 := apply(sp.any_i[d := x2. x2 in bits(64) && startup_specs.thread_set(app(fn_update(s, "vm", V), "vm"), x2),
    k := x2. letin(fn_update(fn_update(s, "vm", V), "fs_base", x2), x3. bind_rel(startup_specs.main_entered, x3, x4 x5. o = ok(x4, empty), x4 x5. o = exc(x4, x5), x4. o = diverge(x4))),
    a := fs], dfs, kfs)
  have k1: letin(fn_update(s, "vm", V), x1. any_rel(x2. x2 in bits(64) && startup_specs.thread_set(app(x1, "vm"), x2), x2. letin(fn_update(x1, "fs_base", x2), x3.
    bind_rel(startup_specs.main_entered, x3, x4 x5. o = ok(x4, empty), x4 x5. o = exc(x4, x5), x4. o = diverge(x4))))) := k2
  // (to_main's choices in its own form: the memory V, the thread fs)
  have dV: V in x86_64_linux.Vm && ((startup_specs.frame(app(s, "vm"), app(fn_update(s, "vm", V), "vm"), app(fn_update(s, "vm", V), "objs"), startup_specs.start_writes(g)) &&
      (all x4. x4 in omega -> startup_specs.env_at(app(s, "vm"), app(fn_update(s, "vm", V), "objs"), e, x4) -> gimple.bytes_at(app(fn_update(s, "vm", V), "vm"), bits_add(64, app(g, "libc"), 8), 8) =
        int_add(e, int_mul(8, int_add(x4, 1))))) && (ex x4. x4 in bits(64) && startup_specs.thread_set(app(fn_update(s, "vm", V), "vm"), x4))) by simp(hv)
  have k0 := apply(sp.any_i[d := x3. x3 in x86_64_linux.Vm && ((startup_specs.frame(app(s, "vm"), app(fn_update(s, "vm", x3), "vm"), app(fn_update(s, "vm", x3), "objs"), startup_specs.start_writes(g)) &&
      (all x4. x4 in omega -> startup_specs.env_at(app(s, "vm"), app(fn_update(s, "vm", x3), "objs"), e, x4) -> gimple.bytes_at(app(fn_update(s, "vm", x3), "vm"), bits_add(64, app(g, "libc"), 8), 8) =
        int_add(e, int_mul(8, int_add(x4, 1))))) && (ex x4. x4 in bits(64) && startup_specs.thread_set(app(fn_update(s, "vm", x3), "vm"), x4))),
    k := x3. letin(fn_update(s, "vm", x3), x4. any_rel(x5. x5 in bits(64) && startup_specs.thread_set(app(x4, "vm"), x5), x5. letin(fn_update(x4, "fs_base", x5), x6.
      bind_rel(startup_specs.main_entered, x6, x7 x8. o = ok(x7, empty), x7 x8. o = exc(x7, x8), x7. o = diverge(x7))))), a := V], dV, k1)
  have r5: runs(startup_specs.to_main(g, e), s, o) by defs(apply(tr.runs_intro[r := x0 x1. letin(app(x0, "vm"), x2. any_rel(x3. x3 in x86_64_linux.Vm &&
      ((startup_specs.frame(x2, app(fn_update(x0, "vm", x3), "vm"), app(fn_update(x0, "vm", x3), "objs"), startup_specs.start_writes(g)) &&
      (all x4. x4 in omega -> startup_specs.env_at(x2, app(fn_update(x0, "vm", x3), "objs"), e, x4) -> gimple.bytes_at(app(fn_update(x0, "vm", x3), "vm"), bits_add(64, app(g, "libc"), 8), 8) =
        int_add(e, int_mul(8, int_add(x4, 1))))) && (ex x4. x4 in bits(64) && startup_specs.thread_set(app(fn_update(x0, "vm", x3), "vm"), x4))),
    x3. letin(fn_update(x0, "vm", x3), x4. any_rel(x5. x5 in bits(64) && startup_specs.thread_set(app(x4, "vm"), x5), x5. letin(fn_update(x4, "fs_base", x5), x6.
      bind_rel(startup_specs.main_entered, x6, x7 x8. x1 = ok(x7, empty), x7 x8. x1 = exc(x7, x8), x7. x1 = diverge(x7)))))))], {s}, {o}, pu, k0), startup_specs.to_main)
  let X2 := exc(pair(W1, empty), pair("raise", sp.AM))
  have cx: ex x3 x4. o = exc(x3, x4) && X2 = exc(pair(x3, empty), pair("raise", x4)) by ex_intro({W1}, {sp.AM}, conj(ho, refl({X2})))
  have b: sp.BR(startup_specs.to_main(g, e), s, X2) by defs(ex_intro({o}, taut(r5, cx)), bind_rel)
  have d: sp.DS(X2, o) by simp(ho)
  show by ex_intro({X2}, taut(b, d))
qed

// __libc_start_main's procedure refines its spec's
theorem sp.lsm_run: all g P main argc argv d1 d2 d3 IL FP s o. s in abi.World -> main in bits(64) -> argc in bits(32) -> argv in bits(64) -> P.init_array in bits(64) ->
  mp.calls(IL, startup_specs.init_libc_spec_fun(g)) -> mp.calls(FP[c_src_env___libc_start_main.libc_start_main_stage2_at], startup_specs.stage2_spec_fun(P)) ->
  runs(c_src_env___libc_start_main.__libc_start_main(main, argc, argv, d1, d2, d3, IL, FP), s, o) -> sp.as_spec(startup_specs.start_main_spec(g, P, main, argc, argv), s, o)
proof
  fix g P main argc argv d1 d2 d3 IL FP s o
  assume hw hmb hab hvb hpb hIL hFP h
  let SM := startup_specs.start_main_spec(g, P, main, argc, argv)
  let ENVb := bits_add(64, argv, int_mul(8, int_add(argc, 1)))
  have pu := apply(g.runs_univ, expand(h, c_src_env___libc_start_main.__libc_start_main))
  have hu: s in univ(1) by simp(pu)
  let PRE(x0) := main = P.main && startup_specs.start_main_pre(app(x0, "vm"), app(x0, "objs"), g, P, argc, argv)
  have cN: !PRE(s) -> sp.as_spec(SM, s, o) proof
    assume hn
    have r: runs(SM, s, o) by defs(apply(sp.req_fail[R := x0. PRE(x0), B := x0 x1. sp.TM(g, ENVb, x0, x1)], {s}, {o}, pu, hn), startup_specs.start_main_spec)
    show := apply(sp.as_of, r)
  qed
  have cP: PRE(s) -> sp.as_spec(SM, s, o) proof
    assume hpre
    have hm hsm := hpre
    have sa1 sa2 sa3 sa4 sa5 sa6 := expand(hsm, startup_specs.start_main_pre)
    let OVF := exc_val("stack_overflow", empty)
    let M := int_mul(8, int_add(argc, 1))
    let TY := fn_update(fn_update(empty, "prec", 64), "signed", true)
    have mkSM: all o5. pair(s, o5) in univ(1) -> sp.TM(g, ENVb, s, o5) -> runs(SM, s, o5) proof
      fix o5
      assume pu5 t
      show by defs(apply(tr.runs_intro[r := x0 x1. !PRE(x0) || sp.TM(g, ENVb, x0, x1)], {s}, {o5}, pu5, taut(t)), startup_specs.start_main_spec)
    qed
    // envp: argv + 8 (argc + 1); argv[0] read
    have ao: argc in omega by simp(hab)
    have vo: argv in omega by simp(hvb)
    have m1: bits_of_int(32, argc) = argc by defs(arith(ao, sa1), bits_of_int)
    have m2: bits_of_int(64, argc) = argc by defs(arith(ao, sa1), bits_of_int)
    have p31: int_lt(argc, pow2(31)) by arith(sa1)
    have eS: bits_sext(32, 64, argc) = argc by defs(simp(m1, m2, p31), bits_sext, sint, letin)
    have eA1: bits_add(64, argc, 1) = int_add(argc, 1) by defs(arith(ao, sa1), bits_add)
    have eM: bits_mul(64, int_add(argc, 1), 8) = M by defs(arith(ao, sa1), bits_mul)
    have p63: int_pow(2, int_sub(64, 1)) = 9223372036854775808 by simp()
    have nlt: !int_le(int_pow(2, int_sub(64, 1)), M) by arith(ao, sa1, p63)
    have eV: gimple.sval(TY, M) = M by defs(simp(nlt), gimple.sval)
    have ml: int_lt(M, pow2(64)) by arith(ao, sa1)
    have mb: M in bits(64) by defs(simp(ao, ml), bits)
    have pz: int_le(0, int_add(argv, gimple.sval(TY, M))) by arith(eV, ao, vo)
    have pl: int_lt(int_add(argv, gimple.sval(TY, M)), pow2(64)) by arith(eV, ao, vo, sa3)
    have p0: int_add(argv, 0) = argv by arith(vo)
    have pl0: int_lt(int_add(argv, 0), pow2(64)) by arith(vo, sa3)
    have md: g.mem_defined(s, argv, 0, 8, false) by simp(sa2, sa4, pl0, p0)
    have b := apply(g.runs_elim, expand(h, c_src_env___libc_start_main.__libc_start_main))
    step a1, h0 from b
    step a2, h0b from h0
    step a3, h0c from h0b
    have h0r := rewrite(eM, rewrite(eA1, rewrite(eS, h0c)))
    step h1 from h0r with g.padd_det, g.ld64_det using conj(hu, hvb, mb, pz, pl, md)
    let A0 := bits_of_int(64, gimple.bytes_at(s.vm, argv, 8))
    have eE: int_add(argv, M) = ENVb by defs(arith(ao, vo, sa3), bits_add)
    have h1r := rewrite(eE, rewrite(p0, rewrite(eV, h1)))
    // (no memory to_main's: anything)
    have hvac: !(ex V. sp.TMV(g, ENVb, s, V)) -> ((ex w v. o = ok(w, v)) || (ex w x. o = exc(w, x)) || (ex t. o = diverge(t))) -> sp.as_spec(SM, s, o) proof
      assume nv f
      have c1: (ex w v. o = ok(w, v)) -> sp.as_spec(SM, s, o) proof
        assume q
        obtain w v, e from q
        have po: pair(s, ok(w, empty)) in univ(1) by simp(rewrite(e, pu))
        have tw: ex w2. ok(w, empty) = ok(w2, empty) by ex_intro({w}, refl({ok(w, empty)}))
        have t := apply(sp.tm_vac[g := g, e := ENVb, s := s, o := ok(w, empty)], po, nv, (sp.tmo(ok(w, empty)) by taut(tw)))
        have r := mp(all_elim(mkSM, {ok(w, empty)}), po, t)
        have x: ex w2 v3. o = ok(w2, v3) && (ex v2. runs(SM, s, ok(w2, v2))) by ex_intro({w}, {v}, conj(e, (ex v2. runs(SM, s, ok(w, v2)) by ex_intro({empty}, r))))
        show by taut(x)
      qed
      have c2: (ex w x. o = exc(w, x)) -> sp.as_spec(SM, s, o) proof
        assume q
        have t := apply(sp.tm_vac[g := g, e := ENVb, s := s, o := o], pu, nv, taut(q))
        show := apply(sp.as_of, mp(all_elim(mkSM, {o}), pu, t))
      qed
      have c3: (ex t. o = diverge(t)) -> sp.as_spec(SM, s, o) proof
        assume q
        have t := apply(sp.tm_vac[g := g, e := ENVb, s := s, o := o], pu, nv, taut(q))
        show := apply(sp.as_of, mp(all_elim(mkSM, {o}), pu, t))
      qed
      show by taut(f, c1, c2, c3)
    qed
    // (an overflow from s)
    have hovf: sp.ovf_any(s, o) -> sp.as_spec(SM, s, o) proof
      assume ov
      show := apply(sp.as_of, mp(all_elim(mkSM, {o}), pu, apply(sp.eo_ovf[q := startup_specs.to_main(g, ENVb)], pu, ov)))
    qed
    have sv wf wd _ := apply(ms.world_parts, hw)
    have od: "objs" in dom(s) by simp(expand(hw, abi.World))
    have fd: "fs_base" in dom(s) by simp(expand(hw, abi.World))
    have fsb: s.fs_base in bits(64) by simp(expand(hw, abi.World))
    have sob: s.objs in abi.Objs by simp(expand(hw, abi.World))
    have se: fn_update(fn_update(fn_update(s, "fs_base", s.fs_base), "vm", s.vm), "objs", s.objs) = s by simp(wf, wd, fd, od)
    have ovs: o = exc(s, OVF) -> sp.as_spec(SM, s, o) proof
      assume e
      show := mp(hovf, (sp.ovf_any(s, o) by defs(ex_intro({s.fs_base}, {s.vm}, {s.objs}, taut(fsb, sv, sob, rewrite(sym(se), e))), sp.ovf_any)))
    qed
    // __init_libc called as its spec says
    obtain oc, hrc hdc from apply(g.bind_open, h1r)
    let ARGS1 := seq_concat(seq_one(gimple.arg(64, ENVb)), seq_one(gimple.arg(64, A0)))
    let QI(o2) := sp.ovf_any(s, o2) || (ex V fs v. (sp.TMV(g, ENVb, s, V) && fs in bits(64) && startup_specs.thread_set(V, fs)) &&
      o2 = ok(fn_update(fn_update(s, "vm", V), "fs_base", fs), v)) || !(ex V. sp.TMV(g, ENVb, s, V))
    have eb: ENVb in bits(64) by simp()
    have a0b: A0 in bits(64) by simp()
    have rg := apply(gc.regs_get, apply(gc.regs_cat, apply(gc.regs_one[w := 64, x := ENVb], simp(), simp(), eb), apply(gc.regs_one[w := 64, x := A0], simp(), simp(), a0b)))
    have hqi: all regs o2. gc.regs_ok(regs, ARGS1) -> runs(IL[regs], s, o2) -> QI(o2) proof
      fix regs o2
      assume hro hg
      have rl rln _ := hro
      have rn: seq_len(regs) = 2 := trans(rln, (seq_len(ARGS1) = 2 by simp()))
      have l6: int_le(seq_len(regs), 6) by arith(rn)
      have ra := mp(sp.regs_in[regs := regs], rl, l6)
      have o2l: ord_le(2, seq_len(regs)) by defs(simp(rn), ord_le)
      have hs := mp(all_elim(hIL, {regs}, {s}, {o2}), rl, l6, hw, hg)
      have q0 := apply(gc.reg_at[regs := regs, args := ARGS1, i := 0, w := 64, x := ENVb], hro, simp(), simp(), at({ARGS1[0]}), simp(), eb)
      have q1 := apply(gc.reg_at[regs := regs, args := ARGS1, i := 1, w := 64, x := A0], hro, simp(), simp(), at({ARGS1[1]}), simp(), a0b)
      have b2 := rewrite(q0, rewrite(q1, apply(sp.fun_out[n := 2, Q := a. startup_specs.init_libc_spec(g, bits_of_int(64, a[0]), bits_of_int(64, a[1]))], ra, o2l,
        expand(hs, startup_specs.init_libc_spec_fun))))
      obtain o4, r4 k4 from expand(b2, bind_rel)
      have il := apply(sp.il_q, hw, sa5, r4)
      have kc := apply(sp.k_cases, k4)
      have j1: sp.ovf_any(s, o4) -> QI(o2) proof
        assume ov
        obtain f v ob, _ _ _ e from expand(ov, sp.ovf_any)
        have nk: !is_ok(o4) := rewrite(sym(e), all_elim(g.not_ok_exc, {fn_update(fn_update(fn_update(s, "fs_base", f), "vm", v), "objs", ob)}, {OVF}))
        have j: (!is_ok(o4) && o2 = o4) -> sp.ovf_any(s, o2) proof
          assume q
          have _ e2 := q
          show := rewrite(sym(e2), ov)
        qed
        show by taut(kc, nk, j)
      qed
      have j2: (ex V fs. (sp.TMV(g, ENVb, s, V) && fs in bits(64) && startup_specs.thread_set(V, fs)) && o4 = ok(fn_update(fn_update(s, "vm", V), "fs_base", fs), empty)) -> QI(o2) proof
        assume q
        obtain V fs, hV hfr hl8 hfs0 hfb hts e from q
        have a := (sp.anyv(fn_update(fn_update(s, "vm", V), "fs_base", fs), o2) by simp(rewrite(e, k4), keep(any_rel)))
        obtain v, e2 from apply(sp.anyv_ok, a)
        have x: ex V2 fs2 v2. (sp.TMV(g, ENVb, s, V2) && fs2 in bits(64) && startup_specs.thread_set(V2, fs2)) && o2 = ok(fn_update(fn_update(s, "vm", V2), "fs_base", fs2), v2)
          by ex_intro({V}, {fs}, {v}, taut(hV, hfr, hl8, hfs0, hfb, hts, e2))
        show by taut(x)
      qed
      show by taut(il, j1, j2)
    qed
    have ci := apply(gc.call0_inv[Q := o2. QI(o2)], {IL}, {ARGS1}, {s}, {oc}, rg, hqi, hrc)
    have kA: oc = exc(s, OVF) -> sp.as_spec(SM, s, o) proof
      assume e
      show := mp(ovs, (o = exc(s, OVF) by simp(rewrite(e, hdc))))
    qed
    have kC: (ex x e. QI(exc(x, e)) && oc = exc(x, e)) -> sp.as_spec(SM, s, o) proof
      assume q
      obtain x e, hq4 he from q
      have oe: o = exc(x, e) by simp(rewrite(he, hdc))
      have c1: sp.ovf_any(s, exc(x, e)) -> sp.as_spec(SM, s, o) proof
        assume ov
        show := mp(hovf, rewrite(sym(oe), ov))
      qed
      have c2: (ex V fs v. (sp.TMV(g, ENVb, s, V) && fs in bits(64) && startup_specs.thread_set(V, fs)) && exc(x, e) = ok(fn_update(fn_update(s, "vm", V), "fs_base", fs), v)) ->
          sp.as_spec(SM, s, o) proof
        assume q2
        obtain V fs v, _ _ _ _ _ _ f from q2
        have ff: false by defs(simp(f), ok, exc)
        show by taut(ff)
      qed
      have c3: !(ex V. sp.TMV(g, ENVb, s, V)) -> sp.as_spec(SM, s, o) proof
        assume nv
        show := mp(hvac, nv, taut((ex w x2. o = exc(w, x2) by ex_intro({x}, {e}, oe))))
      qed
      show by taut(hq4, c1, c2, c3)
    qed
    have kD: (ex t. QI(diverge(t)) && oc = diverge(t)) -> sp.as_spec(SM, s, o) proof
      assume q
      obtain t, hq4 he from q
      have oe: o = diverge(t) by simp(rewrite(he, hdc))
      have c1: sp.ovf_any(s, diverge(t)) -> sp.as_spec(SM, s, o) proof
        assume ov
        have ff: false by defs(simp(expand(ov, sp.ovf_any)), exc, diverge)
        show by taut(ff)
      qed
      have c2: (ex V fs v. (sp.TMV(g, ENVb, s, V) && fs in bits(64) && startup_specs.thread_set(V, fs)) && diverge(t) = ok(fn_update(fn_update(s, "vm", V), "fs_base", fs), v)) ->
          sp.as_spec(SM, s, o) proof
        assume q2
        obtain V fs v, _ _ _ _ _ _ f from q2
        have ff: false by defs(simp(f), ok, diverge)
        show by taut(ff)
      qed
      have c3: !(ex V. sp.TMV(g, ENVb, s, V)) -> sp.as_spec(SM, s, o) proof
        assume nv
        show := mp(hvac, nv, taut((ex t2. o = diverge(t2) by ex_intro({t}, oe))))
      qed
      show by taut(hq4, c1, c2, c3)
    qed
    have kB: (ex w4 r. QI(ok(w4, r)) && (oc = ok(gc.back0(w4, s), pair(fst(r), snd(r))) || oc = exc(gc.back0(w4, s), OVF))) -> sp.as_spec(SM, s, o) proof
      assume q
      obtain w4 r, hq4 ho4 from q
      // (after the call ok at W: o of the procedure's forms)
      have forms: all W pr. oc = ok(W, pr) -> (ex w v. o = ok(w, v)) || (ex w x. o = exc(w, x)) || (ex t. o = diverge(t)) proof
        fix W pr
        assume e
        step h2 from rewrite(e, hdc)
        obtain oc2, _ hdc2 from apply(g.bind_open, h2)
        have f1: (ex x4 x5. oc2 = ok(x4, x5) && letin(bits_of_int(32, x5), x6. o = ok(x4, x6))) -> ex w v. o = ok(w, v) proof
          assume q2
          obtain x4 x5, _ l from q2
          show by ex_intro({x4}, {bits_of_int(32, x5)}, apply(g.letin_e, l))
        qed
        have f2: (ex x4 x5. oc2 = exc(x4, x5) && o = exc(x4, x5)) -> ex w x. o = exc(w, x) proof
          assume q2
          obtain x4 x5, _ l from q2
          show by ex_intro({x4}, {x5}, l)
        qed
        have f3: (ex x4. oc2 = diverge(x4) && o = diverge(x4)) -> ex t. o = diverge(t) proof
          assume q2
          obtain x4, _ l from q2
          show by ex_intro({x4}, l)
        qed
        show by taut(hdc2, f1, f2, f3)
      qed
      have formsA: (ex w v. o = ok(w, v)) || (ex w x. o = exc(w, x)) || (ex t. o = diverge(t)) proof
        have g1: oc = ok(gc.back0(w4, s), pair(fst(r), snd(r))) -> (ex w v. o = ok(w, v)) || (ex w x. o = exc(w, x)) || (ex t. o = diverge(t)) proof
          assume e
          show := mp(all_elim(forms, {gc.back0(w4, s)}, {pair(fst(r), snd(r))}), e)
        qed
        have g2: oc = exc(gc.back0(w4, s), OVF) -> ex w x. o = exc(w, x) proof
          assume e
          show by ex_intro({gc.back0(w4, s)}, {OVF}, (o = exc(gc.back0(w4, s), OVF) by simp(rewrite(e, hdc))))
        qed
        show by taut(ho4, g1, g2)
      qed
      have c1: sp.ovf_any(s, ok(w4, r)) -> sp.as_spec(SM, s, o) proof
        assume ov
        have ff: false by defs(simp(expand(ov, sp.ovf_any)), ok, exc)
        show by taut(ff)
      qed
      have c3: !(ex V. sp.TMV(g, ENVb, s, V)) -> sp.as_spec(SM, s, o) proof
        assume nv
        show := mp(hvac, nv, formsA)
      qed
      // libc set up at W1: stage2 called there
      have c2: (ex V fs v. (sp.TMV(g, ENVb, s, V) && fs in bits(64) && startup_specs.thread_set(V, fs)) && ok(w4, r) = ok(fn_update(fn_update(s, "vm", V), "fs_base", fs), v)) ->
          sp.as_spec(SM, s, o) proof
        assume q2
        obtain V fs v, hV hfr hl8 hfs0 hfb hts e4 from q2
        let W1 := fn_update(fn_update(s, "vm", V), "fs_base", fs)
        have w4e: w4 = W1 by simp(e4)
        have wv1 wv2 := apply(mp.am_world, hw, hu, hV)
        have ww1 ww2 := apply(sp.world_fs, wv1, wv2, hfb)
        have sv1 wf1 wd1 _ := apply(ms.world_parts, ww1)
        have od1: "objs" in dom(W1) by simp(expand(ww1, abi.World))
        have fd1: "fs_base" in dom(W1) by simp(expand(ww1, abi.World))
        have fsb1: W1.fs_base in bits(64) by simp(expand(ww1, abi.World))
        have sob1: W1.objs in abi.Objs by simp(expand(ww1, abi.World))
        have os := apply(gc.objs_same, hw)
        have bk: gc.back0(w4, s) = W1 by simp(w4e, os, wf1, od1, wf, od)
        have se1: fn_update(fn_update(fn_update(W1, "fs_base", W1.fs_base), "vm", W1.vm), "objs", W1.objs) = W1 by simp(wf1, wd1, fd1, od1, wf, od)
        have ovW: o = exc(W1, OVF) -> sp.as_spec(SM, s, o) proof
          assume e
          have ov: sp.ovf_any(W1, o) by defs(ex_intro({W1.fs_base}, {W1.vm}, {W1.objs}, taut(fsb1, sv1, sob1, rewrite(sym(se1), e))), sp.ovf_any)
          show := mp(hovf, apply(sp.ovf_up, ov))
        qed
        have k2: oc = exc(gc.back0(w4, s), OVF) -> sp.as_spec(SM, s, o) proof
          assume e
          show := mp(ovW, (o = exc(W1, OVF) by simp(rewrite(bk, rewrite(e, hdc)))))
        qed
        have k1: oc = ok(gc.back0(w4, s), pair(fst(r), snd(r))) -> sp.as_spec(SM, s, o) proof
          assume e
          step h2 from rewrite(bk, rewrite(e, hdc))
          obtain oc2, hrc2 hdc2 from apply(g.bind_open, h2)
          obtain o3, r3 rel3 from apply(sp.call1_0_e, hrc2)
          let ARGS2 := seq_concat(seq_concat(seq_one(gimple.arg(64, main)), seq_one(gimple.arg(32, argc))), seq_one(gimple.arg(64, argv)))
          let Q2(o2) := sp.ovf_any(W1, o2) || o2 = exc(W1, sp.AM)
          have rg2 := apply(gc.regs_get, apply(gc.regs_cat, apply(gc.regs_cat, apply(gc.regs_one[w := 64, x := main], simp(), simp(), hmb),
            apply(gc.regs_one[w := 32, x := argc], simp(), simp(), hab)), apply(gc.regs_one[w := 64, x := argv], simp(), simp(), hvb)))
          // (stage2's requirement at W1: the constructors kept by __init_libc's frame)
          have ck := apply(sp.ctors_keep[b := s.vm, U := V, objs := s.objs, P := P, W := startup_specs.start_writes(g)], hpb, sa6, hfr)
          have pre2: ((main = P.main && int_lt(argc, int_pow(2, 31))) && int_lt(int_add(argv, int_mul(8, int_add(argc, 1))), int_pow(2, 63))) &&
            startup_specs.ctors_ok(app(W1, "vm"), app(W1, "objs"), P, set_select(omega, x2. false)) by simp(hm, sa1, sa3, ck)
          have hq2: all regs o2. gc.regs_ok(regs, ARGS2) -> runs(FP[c_src_env___libc_start_main.libc_start_main_stage2_at][regs], W1, o2) -> Q2(o2) proof
            fix regs o2
            assume hro hg
            have rl rln _ := hro
            have rn: seq_len(regs) = 3 := trans(rln, (seq_len(ARGS2) = 3 by simp()))
            have l6: int_le(seq_len(regs), 6) by arith(rn)
            have ra := mp(sp.regs_in[regs := regs], rl, l6)
            have o3l: ord_le(3, seq_len(regs)) by defs(simp(rn), ord_le)
            have hs := mp(all_elim(hFP, {regs}, {W1}, {o2}), rl, l6, ww1, hg)
            have q0 := apply(gc.reg_at[regs := regs, args := ARGS2, i := 0, w := 64, x := main], hro, simp(), simp(), at({ARGS2[0]}), simp(), hmb)
            have q1 := apply(gc.reg_at[regs := regs, args := ARGS2, i := 1, w := 32, x := argc], hro, simp(), simp(), at({ARGS2[1]}), simp(), hab)
            have q2 := apply(gc.reg_at[regs := regs, args := ARGS2, i := 2, w := 64, x := argv], hro, simp(), simp(), at({ARGS2[2]}), simp(), hvb)
            have b2 := rewrite(q0, rewrite(q1, rewrite(q2, apply(sp.fun_out[n := 3, Q := a. startup_specs.stage2_spec(P, bits_of_int(64, a[0]), bits_of_int(32, a[1]), bits_of_int(64, a[2]))],
              ra, o3l, expand(hs, startup_specs.stage2_spec_fun)))))
            obtain o5, r5 k5 from expand(b2, bind_rel)
            have b5 := apply(or_resolve, apply(g.runs_elim, expand(r5, startup_specs.stage2_spec)), pre2)
            have em := apply(sp.eo_me, ww1, b5)
            have kc := apply(sp.k_cases, k5)
            have j1: sp.ovf_any(W1, o5) -> Q2(o2) proof
              assume ov
              obtain f v2 ob, _ _ _ e5 from expand(ov, sp.ovf_any)
              have nk: !is_ok(o5) := rewrite(sym(e5), all_elim(g.not_ok_exc, {fn_update(fn_update(fn_update(W1, "fs_base", f), "vm", v2), "objs", ob)}, {OVF}))
              have j: (!is_ok(o5) && o2 = o5) -> sp.ovf_any(W1, o2) proof
                assume q3
                have _ e6 := q3
                show := rewrite(sym(e6), ov)
              qed
              show by taut(kc, nk, j)
            qed
            have j2: o5 = exc(W1, sp.AM) -> Q2(o2) proof
              assume e5
              have nk: !is_ok(o5) := rewrite(sym(e5), all_elim(g.not_ok_exc, {W1}, {sp.AM}))
              have j: (!is_ok(o5) && o2 = o5) -> o2 = exc(W1, sp.AM) proof
                assume q3
                have _ e6 := q3
                show := trans(e6, e5)
              qed
              show by taut(kc, nk, j)
            qed
            show by taut(em, j1, j2)
          qed
          have ci2 := apply(gc.call0_inv[Q := o2. Q2(o2)], {FP[c_src_env___libc_start_main.libc_start_main_stage2_at]}, {ARGS2}, {W1}, {o3}, rg2, hq2, r3)
          have ox: all X E. o3 = exc(X, E) -> o = exc(X, E) proof
            fix X E
            assume e3
            have e2: oc2 = exc(X, E) by simp(rewrite(e3, rel3))
            show by simp(rewrite(e2, hdc2))
          qed
          have m1: o3 = exc(W1, OVF) -> sp.as_spec(SM, s, o) proof
            assume e3
            show := mp(ovW, mp(all_elim(ox, {W1}, {OVF}), e3))
          qed
          have m2: (ex w5 r5. Q2(ok(w5, r5)) && (o3 = ok(gc.back0(w5, W1), pair(fst(r5), snd(r5))) || o3 = exc(gc.back0(w5, W1), OVF))) -> sp.as_spec(SM, s, o) proof
            assume q3
            obtain w5 r5, f _ from q3
            have ff: false by defs(simp(expand(f, sp.ovf_any)), ok, exc)
            show by taut(ff)
          qed
          have m3: (ex x e. Q2(exc(x, e)) && o3 = exc(x, e)) -> sp.as_spec(SM, s, o) proof
            assume q3
            obtain x e, f e3 from q3
            have oe := mp(all_elim(ox, {x}, {e}), e3)
            have n1: sp.ovf_any(W1, exc(x, e)) -> sp.as_spec(SM, s, o) proof
              assume ov
              show := mp(hovf, apply(sp.ovf_up, rewrite(sym(oe), ov)))
            qed
            have n2: exc(x, e) = exc(W1, sp.AM) -> sp.as_spec(SM, s, o) proof
              assume ea
              have om: o = exc(W1, sp.AM) := trans(oe, ea)
              have t := apply(sp.tm_main[g := g, e := ENVb, s := s, V := V, fs := fs, o := o], pu, om, conj(hV, conj(conj(hfr, hl8), hfs0)), hfb, hts)
              show := apply(sp.as_of, mp(all_elim(mkSM, {o}), pu, t))
            qed
            show by taut(f, n1, n2)
          qed
          have m4: (ex t. Q2(diverge(t)) && o3 = diverge(t)) -> sp.as_spec(SM, s, o) proof
            assume q3
            obtain t, f _ from q3
            have ff: false by defs(simp(expand(f, sp.ovf_any)), exc, diverge)
            show by taut(ff)
          qed
          show by taut(ci2, m1, m2, m3, m4)
        qed
        show by taut(ho4, k1, k2)
      qed
      show by taut(hq4, c1, c2, c3)
    qed
    show by taut(ci, kA, kB, kC, kD)
  qed
  show by taut(cN, cP)
qed

// __libc_start_main's C function refines its spec's
theorem sp.lsm_fun: all g P IL FP regs s o. P.init_array in bits(64) ->
  mp.calls(IL, startup_specs.init_libc_spec_fun(g)) -> mp.calls(FP[c_src_env___libc_start_main.libc_start_main_stage2_at], startup_specs.stage2_spec_fun(P)) ->
  regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
  runs(c_src_env___libc_start_main.__libc_start_main_fun(IL, FP)[regs], s, o) -> runs(startup_specs.start_main_spec_fun(g, P)[regs], s, o)
proof
  fix g P IL FP regs s o
  assume hpb hIL hFP hr hl hw h
  have ra := mp(sp.regs_in[regs := regs], hr, hl)
  have hp: ord_le(6, seq_len(regs)) -> all o3. runs(c_src_env___libc_start_main.__libc_start_main(bits_of_int(64, regs[0]), bits_of_int(32, regs[1]), bits_of_int(64, regs[2]),
      bits_of_int(64, regs[3]), bits_of_int(64, regs[4]), bits_of_int(64, regs[5]), IL, FP), s, o3) ->
      sp.as_spec(startup_specs.start_main_spec(g, P, bits_of_int(64, regs[0]), bits_of_int(32, regs[1]), bits_of_int(64, regs[2])), s, o3) proof
    assume _
    fix o3
    assume r3
    show := mp(all_elim(sp.lsm_run, {g}, {P}, {bits_of_int(64, regs[0])}, {bits_of_int(32, regs[1])}, {bits_of_int(64, regs[2])}, {bits_of_int(64, regs[3])},
        {bits_of_int(64, regs[4])}, {bits_of_int(64, regs[5])}, {IL}, {FP}, {s}, {o3}), hw,
      (bits_of_int(64, regs[0]) in bits(64) by simp()), (bits_of_int(32, regs[1]) in bits(32) by simp()), (bits_of_int(64, regs[2]) in bits(64) by simp()), hpb, hIL, hFP, r3)
  qed
  have hK: all x3 x4 x2. sp.KC32(x3, x4, x2) -> sp.anyv(x3, x2) proof
    fix x3 x4 x2
    show := sp.kc32[w := x3, v := x4, o := x2]
  qed
  show by defs(apply(sp.fun_rk[n := 6, P := a. c_src_env___libc_start_main.__libc_start_main(bits_of_int(64, a[0]), bits_of_int(32, a[1]), bits_of_int(64, a[2]),
        bits_of_int(64, a[3]), bits_of_int(64, a[4]), bits_of_int(64, a[5]), IL, FP),
      K := x3 x4 x2. sp.KC32(x3, x4, x2), Q := a. startup_specs.start_main_spec(g, P, bits_of_int(64, a[0]), bits_of_int(32, a[1]), bits_of_int(64, a[2]))],
    {regs}, {s}, {o}, ra, hK, hp, expand(h, c_src_env___libc_start_main.__libc_start_main_fun)), startup_specs.start_main_spec_fun)
qed
