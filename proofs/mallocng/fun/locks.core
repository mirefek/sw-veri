    have pu := apply(g.runs_univ, hr)
    have hu: s in univ(1) by simp(pu)
    have vV vfun vdom .. := apply(ms.world_parts, hw)
    have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], vfun, vdom)
    have np: !mallocng_specs.need_locks_off(s.vm, s.objs, LB) -> runs(SPEC, s, o) proof
      assume hn
      show by simp(pu, hn, keep(abi.overflow, mallocng_specs.need_locks_off))
    qed
    have yp: mallocng_specs.need_locks_off(s.vm, s.objs, LB) -> runs(SPEC, s, o) proof
      assume hp
      have lnz lr lu lz := expand(hp, mallocng_specs.need_locks_off)
      have lb: LB in bits(64) by defs(simp(), c_src_malloc_mallocng_malloc.__libc)
      have md: g.mem_defined(s, LB, 3, 1, false) by simp(lnz, lu, lr, lb)
      have z0: bits_of_int(8, gimple.bytes_at(s.vm, int_add(LB, 3), 1)) = 0 by simp(lz, lb)
      step oe from hr with g.ld8_det using conj(hu, lb, md, z0)
      show by simp(oe, pu, hp, ss, keep(abi.overflow, mallocng_specs.need_locks_off))
    qed
    show by taut(np, yp)
  qed
qed

// __unlock: the lock word read, 0 -- not negative, no call
theorem mp.ulk: all l fa wk. l in bits(64) -> refines(c_src_thread___lock.__unlock(l, fa, wk), mallocng_specs.unlock_spec(l), abi.World)
proof
  fix l fa wk
  assume hl
  show proof
    fix s o
    assume hw hr
    let SPEC := mallocng_specs.unlock_spec(l)
    let PRE := mallocng_specs.lock_free(s.vm, s.objs, l) && abi.thread_ok(s.vm, s.fs_base)
    have pu := apply(g.runs_univ, hr)
    have hu: s in univ(1) by simp(pu)
    have vV vfun vdom .. := apply(ms.world_parts, hw)
    have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], vfun, vdom)
    have np: !PRE -> runs(SPEC, s, o) proof
      assume hn
      show by simp(pu, hn, keep(abi.overflow, mallocng_specs.lock_free, abi.thread_ok))
    qed
    have yp: PRE -> runs(SPEC, s, o) proof
      assume hp
      have hf ht := hp
      have lnz lr lu lz := expand(hf, mallocng_specs.lock_free)
      have md: g.mem_defined(s, l, 0, 4, false) by simp(lnz, lu, lr, hl)
      have z0: bits_of_int(32, gimple.bytes_at(s.vm, int_add(l, 0), 4)) = 0 by simp(lz, hl)
      have nl: !int_lt(sint(32, bits_of_int(32, gimple.bytes_at(s.vm, int_add(l, 0), 4))), sint(32, 0)) by simp(z0)
      step oe from hr with g.ld32_det using conj(hu, hl, md, nl)
      show by simp(oe, pu, hp, ss, keep(abi.overflow, mallocng_specs.lock_free, abi.thread_ok))
    qed
    show by taut(np, yp)
  qed
qed

// __unlock's contract at a call (its C function value), the lock free and
// the thread sound: an overflow, or the memory as it was
theorem mp.ulk_q: all t lk regs o2. t in abi.World -> lk in bits(64) -> mallocng_specs.lock_free(t.vm, t.objs, lk) -> abi.thread_ok(t.vm, t.fs_base) ->
  gc.regs_ok(regs, seq_one(gimple.arg(64, lk))) -> runs(mallocng_specs.unlock_arg_spec_fun()[regs], t, o2) ->
  abi.ovf_out(t, o2) || (ex V r. (V in x86_64_linux.Vm && V = t.vm) && o2 = ok(fn_update(t, "vm", V), r))
proof
  fix t lk regs o2
  assume hw hb hf ht hro h
  let OVF := exc_val("stack_overflow", empty)
  have rl rn r0 := apply(gc.regs1, hb, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, mallocng_specs.unlock_arg_spec_fun, app_fn_build, ra in h
  have o1l: ord_le(1, seq_len(regs)) by defs(simp(rn), ord_le)
  have bp: bits_of_int(64, regs[0]) = lk by defs(simp(r0, hb), bits_of_int, pow2)
  have b := apply(g.runs_elim, h)
  have b2: bind_rel(mallocng_specs.unlock_spec(lk), t, x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o2 = ok(x3, pair(x5, x6)))),
      x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3)) by simp(b, o1l, bp, keep(bind_rel, mallocng_specs.unlock_spec))
  obtain o3, hs3 hk3 from expand(b2, bind_rel)
  have vV vfun vdom .. := apply(ms.world_parts, hw)
  have ss: fn_update(t, "vm", t.vm) = t := mp(fn_update_same[f := t, k := "vm"], vfun, vdom)
  have pre: mallocng_specs.lock_free(t.vm, t.objs, lk) && abi.thread_ok(t.vm, t.fs_base) by taut(hf, ht)
  // the spec's run: an overflow, or done at t
  have ci := apply(ct.contract_inv, expand(hs3, mallocng_specs.unlock_spec), pre, vV)
  have c1: abi.ovf_out(t, o3) -> abi.ovf_out(t, o2) proof
    assume hx
    obtain v ob, hv hob ho from hx
    have e2: o2 = exc(fn_update(fn_update(t, "vm", v), "objs", ob), OVF) by simp(rewrite(ho, hk3))
    show by ex_intro({v}, {ob}, taut(hv, hob, e2))
  qed
  have c2: (ex x2. letin(fn_update(t, "vm", t.vm), x3. x2 = ok(pair(x3, empty), empty)) &&
      ((fst(x2) = 0 && o3 = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && o3 = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
        ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && o3 = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && o3 = diverge(snd(x2)))))) ->
      (ex V r. (V in x86_64_linux.Vm && V = t.vm) && o2 = ok(fn_update(t, "vm", V), r)) proof
    assume hx
    obtain x2, hB hout from hx
    have x2e: x2 = ok(pair(t, empty), empty) by simp(expand(hB, letin), ss)
    have ho: o3 = ok(t, empty) by simp(rewrite(x2e, hout))
    have k5: any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o2 = ok(t, pair(x5, x6)))) by simp(rewrite(ho, hk3), keep(any_rel))
    have nb: ex y. y in bits(64) by ex_intro({0}, simp())
    obtain y1, hy1 k6 from apply(g.any_e, nb, k5)
    obtain y2, hy2 k7 from apply(g.any_e, nb, k6)
    have k8: o2 = ok(fn_update(t, "vm", t.vm), pair(y1, y2)) := rewrite(sym(ss), k7, {1})
    show by ex_intro({t.vm}, {pair(y1, y2)}, taut(vV, refl({t.vm}), k8))
  qed
  show by taut(ci, c1, c2)
qed

// unlock: __unlock(__malloc_lock) by its contract
theorem mp.unl: all gu. (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(gu[regs], s, o) ->
    runs(mallocng_specs.unlock_arg_spec_fun()[regs], s, o)) ->
  refines(c_src_malloc_mallocng_malloc.unlock(gu), mallocng_specs.unlock_spec(c_src_malloc_mallocng_malloc.__malloc_lock), abi.World)
proof
  fix gu
  assume hg
  show proof
    fix s o
    assume hw hr
    let LK := c_src_malloc_mallocng_malloc.__malloc_lock
    let SPEC := mallocng_specs.unlock_spec(LK)
    let OVF := exc_val("stack_overflow", empty)
    let PRE := mallocng_specs.lock_free(s.vm, s.objs, LK) && abi.thread_ok(s.vm, s.fs_base)
    have pu := apply(g.runs_univ, hr)
    have hu: s in univ(1) by simp(pu)
    have vV vfun vdom .. := apply(ms.world_parts, hw)
    have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], vfun, vdom)
    have np: !PRE -> runs(SPEC, s, o) proof
      assume hn
      show by simp(pu, hn, keep(abi.overflow, mallocng_specs.lock_free, abi.thread_ok))
    qed
    have yp: PRE -> runs(SPEC, s, o) proof
      assume hp
      have hf ht := hp
      have lb: LK in bits(64) by defs(simp(), c_src_malloc_mallocng_malloc.__malloc_lock)
      have ths: gc.sound(s) by simp(ht)
      have qa: all regs o2. gc.regs_ok(regs, seq_one(gimple.arg(64, LK))) -> runs(mallocng_specs.unlock_arg_spec_fun()[regs], s, o2) ->
          abi.ovf_out(s, o2) || (ex V r. (V in x86_64_linux.Vm && V = s.vm) && o2 = ok(fn_update(s, "vm", V), r)) proof
        fix regs o2
        assume hro h2
        show := apply(mp.ulk_q, {s}, {LK}, {regs}, {o2}, hw, lb, hf, ht, hro, h2)
      qed
      have rex := apply(gc.regs_get, mp(gc.regs_one[w := 64, x := LK], simp(), arith(), lb))
      have b := apply(g.runs_elim, expand(hr, c_src_malloc_mallocng_malloc.unlock))
      have cc := apply(gc.contract_callV[P := v. v = s.vm], ths, hw, rex, arith(), hg, qa, b)
      have c1: abi.ovf_out(s, o) -> runs(SPEC, s, o) proof
        assume h
        obtain v ob, hv hob ho from h
        have vu := apply(x86.vm_univ, hv)
        have eu: OVF in univ(1) by defs(simp(), exc_val)
        have pu2: pair(s, exc(fn_update(fn_update(s, "vm", v), "objs", ob), OVF)) in univ(1) by simp(hu, vu, eu, apply(ct.objs_univ, hob))
        have ov := apply(ct.overflow_intro, {s}, {v}, {ob}, hv, hob, pu2)
        have sp: runs(SPEC, s, exc(fn_update(fn_update(s, "vm", v), "objs", ob), OVF)) by simp(pu2, hp, ov, keep(abi.overflow, mallocng_specs.lock_free, abi.thread_ok))
        show := rewrite(sym(ho), sp)
      qed
      have c2: (ex V r. (V in x86_64_linux.Vm && V = s.vm) && o = ok(fn_update(s, "vm", V), empty)) -> runs(SPEC, s, o) proof
        assume h
        obtain V, h1 from h
        obtain r, hV hE ho from h1
        have e: o = ok(s, empty) by simp(ho, hE, ss)
        have sp: runs(SPEC, s, ok(s, empty)) by simp(pu, hp, ss, e, keep(abi.overflow, mallocng_specs.lock_free, abi.thread_ok))
        show := rewrite(sym(e), sp)
      qed
      show by taut(cc, c1, c2)
    qed
    show by taut(np, yp)
  qed
qed

// their C function values, divergence, machine code: by `contract`
contract rdlock mallocng_specs.lock_spec_fun by mp.rdl
contract wrlock mallocng_specs.lock_spec_fun by mp.wrl
contract __unlock mallocng_specs.unlock_arg_spec_fun by mp.ulk
contract unlock mallocng_specs.unlock_spec_fun by mp.unl

// ----------------------------------------------------------------------
// Linked: the callees never reached (__lock -- need_locks 0 --, __unlock's
// a_fetch_add and __wake -- the lock word 0) any code, as a_crash's spec
// (undefined: any machine code implements it); unlock's __unlock its own.

abbrev mp.UL := c_src_thread___lock_cfg.__unlock_fun(mallocng_specs.a_crash_spec_fun(), mallocng_specs.a_crash_spec_fun())

theorem mp.rdl_linked: all statics. tr.implements_at(4206047, mallocng_specs.lock_spec_fun(c_src_malloc_mallocng_malloc.__libc), 4198400, text.code, statics)
proof
  fix statics
  show := mp(all_elim(mp.rdl_implements, {statics}, {mallocng_specs.a_crash_spec_fun()}), all_elim(mp.undef_implements, {4214680}, {statics}), acr.typed,
    mp.undef_io[n := 1])
qed

theorem mp.wrl_linked: all statics. tr.implements_at(4206083, mallocng_specs.lock_spec_fun(c_src_malloc_mallocng_malloc.__libc), 4198400, text.code, statics)
proof
  fix statics
  show := mp(all_elim(mp.wrl_implements, {statics}, {mallocng_specs.a_crash_spec_fun()}), all_elim(mp.undef_implements, {4214680}, {statics}), acr.typed,
    mp.undef_io[n := 1])
qed

theorem mp.ulk_linked: all statics. tr.implements_at(4214984, mallocng_specs.unlock_arg_spec_fun(), 4198400, text.code, statics)
proof
  fix statics
  let AC := mallocng_specs.a_crash_spec_fun()
  show := mp(all_elim(mp.ulk_implements, {statics}, {AC}, {AC}), all_elim(mp.undef_implements, {4214403}, {statics}), acr.typed, mp.undef_io[n := 2],
    all_elim(mp.undef_implements, {4214434}, {statics}), acr.typed, mp.undef_io[n := 3])
qed

// (__unlock's CFG form, linked, called as its spec)
theorem mp.ulk_calls_linked: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(mp.UL[regs], s, o) ->
  runs(mallocng_specs.unlock_arg_spec_fun()[regs], s, o)
proof
  let AC := mallocng_specs.a_crash_spec_fun()
  fix regs s o
  assume h1 h2 h3 hr
  have r1 := mp(all_elim(__unlock_ref, {AC}, {AC}, {regs}, {s}, {o}), h1, h2, h3, hr)
  show := mp(all_elim(mp.ulk_fun, {AC}, {AC}, {regs}, {s}, {o}), h1, h2, h3, r1)
qed

theorem mp.unl_linked: all statics. tr.implements_at(4206119, mallocng_specs.unlock_spec_fun(c_src_malloc_mallocng_malloc.__malloc_lock), 4198400, text.code, statics)
proof
  fix statics
  let AC := mallocng_specs.a_crash_spec_fun()
  have i := mp(all_elim(ulkc.implements, {statics}, {AC}, {AC}), all_elim(mp.undef_implements, {4214403}, {statics}), acr.typed, mp.undef_io[n := 2],
    all_elim(mp.undef_implements, {4214434}, {statics}), acr.typed, mp.undef_io[n := 3])
  have io := mp(all_elim(ulkc.io, {AC}, {AC}), mp.undef_io[n := 2], mp.undef_io[n := 3])
  show := mp(all_elim(mp.unl_implements, {statics}, {mp.UL}), i, all_elim(ulkc.typed, {AC}, {AC}), io, mp.ulk_calls_linked)
qed
