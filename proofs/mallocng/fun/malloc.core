          have m4: x86_64_linux.mapped(V4, q) by defs(simp(nq, (int_lt(q, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) by arith(ts, mlow, h2, mnp))), x86_64_linux.mapped)
