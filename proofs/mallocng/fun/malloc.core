        have ko04 := apply(mp.unt_trans[c := c, A := A, A1 := A, b := B, V0 := V0, V1 := V2, V2 := V4, e := empty], ko2, ko24, refl({mallocng.footprint(c, A, B)}))
        have un04 := apply(mp.kept_unt[objs := s.objs], apply(mp.unt_wider[c := c, A := A, b := B, V0 := V0, V1 := V4, e := mp.errno(s.fs_base)], ko04))
