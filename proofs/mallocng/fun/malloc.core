        let K := x86_64_linux.pages_for(NN)
        have pg: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
        have pb: bits_of_int(64, P) = P by defs(arith(hpo, mlow, mnp), bits_of_int, pow2)
        have rp: fst(r2) = P := trans(rewrite(pg, hfr2), pb)
        have nn1: !(fst(r2) = bits_neg(64, 1)) by defs(arith(rp, hpo, mlow, mnp), bits_neg, pow2)
        step e3 from conj(hk2, kx2) with nn1
        let W2 := fn_update(s, "vm", V2)
        have w2W w2u := apply(mp.am_world, hw, hu, v2v)
        have hin2 := apply(mp.mm_holds[c := c, A := A, vm := V0, V2 := V2, b := B], hc, au, hat, hin, mpg, mby, hvb, mtop, mlim,
          apply(mp.mm_stack[V3 := V0, V4 := V2, p := p, N := NN, PG := NPG, objs := s.objs], hpo, (NN in omega by arith(no)), hpl, hfr))
        have bk02: mallocng.bounds_kept(V0, V2) by defs(taut(mtop, mlim, mst), mallocng.bounds_kept)
        have ko2 := apply(mp.fresh_kept[c := c, A := A, b := B, V3 := V0, V4 := V2, e := empty], mpg, mby, bk02)
        have ne8: all i. i in omega -> int_lt(i, 8) -> !(int_add(s.fs_base, i) in empty) proof
