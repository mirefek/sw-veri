        have unt5s: mallocng.untouched(c, A, B, V4, V5, s.objs, mp.errno(s.fs_base)) by simp(unt5, keep(mallocng.untouched))
        have u5a u5b := expand(unt5s, mallocng.untouched)
        have ts: int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE) = 34359738367 by defs(simp(), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
        have errm: all a. a in omega -> a in mp.errno(s.fs_base) -> x86_64_linux.mapped(V0, int_div(a, x86_64_linux.PAGE)) proof
          fix a
          assume ao he
          have e1 e2 := (int_le(int_add(s.fs_base, 52), a) && int_lt(a, int_add(s.fs_base, 56)) by simp(he))
          let i := int_sub(a, int_add(s.fs_base, 52))
          have _ m0 := mp(all_elim(expand(hea, mallocng_specs.errno_apart), {i}), arith(e1), arith(e2))
          have ai: int_add(mallocng_specs.errno_at(s.fs_base), i) = a by arith(ea)
