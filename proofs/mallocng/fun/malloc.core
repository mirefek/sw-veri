            have nm: !(int_le(M, y) && int_lt(y, int_add(M, 40))) proof
              assume w
              have w1 w2 := w
              have f := mp(all_elim(mfp, {y}), yo, (int_le(M, y) && int_lt(y, int_add(M, mallocng.META_SIZE)) by arith(w1, w2, cm40)))
              have m4c: x86_64_linux.mapped(app(fn_update(s, "vm", V4), "vm"), int_div(y, x86_64_linux.PAGE)) by simp(m4b)
              show by taut(f, nf, m4c)
            qed
            // (not the context's: the allocator's; not the mapping's: unmapped before)
            have nc: !(int_le(CTX, y) && int_lt(y, int_add(CTX, 928))) proof
              assume w
              have w1 w2 := w
              have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
              show by taut(nf, apply(mp.ctx_fp[c := c, A := A, vm := V0, b := B, a := y], hc, au, hat, hin, yo, arith(w1, hx), arith(w2, hx, ks)))
            qed
            have np: !(int_le(P, y) && int_lt(y, int_add(P, NK))) proof
              assume w
              have w1 w2 := w
              have qo: int_div(y, x86_64_linux.PAGE) in omega by defs(arith(yo), x86_64_linux.PAGE)
              have um _ := mp(all_elim(fq, {int_div(y, x86_64_linux.PAGE)}), qo, arith(w1, hpo, pg), arith(w2, hpo, kom, pg))
              show by taut(um, m0)
