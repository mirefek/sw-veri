      // mapped at p
      have mapd: (ex p. ((((p in omega && mallocng_specs.mmap_place(V0, 0, NN, bits_of_int(32, 34), p)) && gimple.fresh_pages(V0, V2, s.objs, p, x86_64_linux.pages_for(NN), NPG)) &&
          V2.brk = V0.brk) && fst(r2) = bits_of_int(64, int_mul(p, x86_64_linux.PAGE)))) -> mp.mi_out(c, A, n, B, s, o) proof
        assume f
        obtain p, hpo hpl hfr hvb hfr2 from f
        have {mnp = npg, mone = one, mlow = low, mun = unm, mpg = pages, mnew = newpg, mby = bytes, mz = zero, mtop = top, mlim = lim, mst = start} :=
          apply(mp.mm_fresh_n[V3 := V0, V4 := V2, p := p, N := NN, PG := NPG, objs := s.objs], hpo, (NN in omega by arith(no)), (int_lt(0, NN) by arith(no)), hpl, hfr)
