          have rdf _ _ _ := expand(hth, abi.thread_ok)
          have rd4 _ _ _ := expand(th4, abi.thread_ok)
          have fsame: all i. i in omega -> int_lt(i, 8) -> VF.bytes[bits_of_int(64, int_add(s.fs_base, i))] = V5.bytes[bits_of_int(64, int_add(s.fs_base, i))] &&
              VF.pages[int_div(int_add(s.fs_base, i), x86_64_linux.PAGE)] = V5.pages[int_div(int_add(s.fs_base, i), x86_64_linux.PAGE)] proof
            fix i
            assume hi hil
