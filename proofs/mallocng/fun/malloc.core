            have f1b: VF.bytes[y] = V5.bytes[y] by simp(f1)
            have f2: VF.bytes[bits_of_int(64, y)] = V5.bytes[bits_of_int(64, y)] := rewrite(sym(ey), f1b)
            show by taut(f2, (VF.pages[int_div(y, x86_64_linux.PAGE)] = V5.pages[int_div(y, x86_64_linux.PAGE)] by simp()))
          qed
          have thF := apply(mp.th_same[V0 := V5, V1 := VF, fs := s.fs_base], fsb, th5s, fsame)
          // unlock()
          have _ lfF := apply(mp.locks_ok[c := c, A := A2, vm := VF, b := B, objs := s.objs], hc, a2u, a2a, hbt, vfv, hinF, shF, hx, hlk, hlc)
          let WF := fn_update(s, "vm", VF)
          have wFW wFu := apply(mp.am_world, hw, hu, vfv)
          have thsF: gc.sound(WF) by simp(thF)
          have pthF: abi.thread_ok(WF.vm, WF.fs_base) by simp(thF, keep(abi.thread_ok))
          have plfF: mallocng_specs.lock_free(WF.vm, WF.objs, c_src_malloc_mallocng_malloc.__malloc_lock) by simp(rewrite(hlk, lfF))
          step V9 r9, e9 kx9 hR9 from e8 with mp.ul0_q using conj(hul, wFW, thsF, plfF, pthF)
          have v9e: V9 = VF by simp(hR9)
          have ww9: fn_update(WF, "vm", V9) = WF := trans(fn_update_twice[f := s, k := "vm", a := VF, b := V9], rewrite(v9e, refl({fn_update(s, "vm", V9)}), {2}))
          // enframe(M, 0, n, ctr): the group's one slot, reserved, framed
          let H2 := fn_update(h, "A", A2)
          have hg2 := apply(mp.g_upd, {h}, {A2}, hh, a2a, a2u)
          have hA2: H2.A = A2 by simp()
          have hB2: H2.blocks = B by simp()
          have pin2: mallocng.holds_m(c, H2.A, WF.vm, H2.blocks) by simp(hinF, hA2, hB2)
          have psh2: mallocng.shown_in(c, H2.A, WF.objs) by simp(shF, hA2)
          have iuM: mallocng.is_used(A2, M) by taut(apply(mp.bg_used[A := A1, k := KK, T := A.taken, m := M, V := VR, g := M], a1a, kko, kkl, mo), refl({M}))
          have sM: A2.slots[M] = fn_build(1, i. tag(3, empty)) by simp()
          have mM: A2.metas[M] = VR by simp()
          have roM: mallocng.reserved_only(A2, M, 0) proof
            have l1: int_lt(0, seq_len(A2.slots[M])) by defs(simp(sM, fn_build_dom[d := 1, v := i. tag(3, empty)]), seq_len)
            have s0: A2.slots[M][0] = tag(3, empty) := rewrite(sym(sM), mp.res1_at)
            have uq: all x0. all x1. x0 in omega && x1 in omega -> int_lt(x1, seq_len(A2.slots[x0])) && A2.slots[x0][x1] = tag(3, empty) -> x0 = M && x1 = 0 proof
              fix g j
              assume ho h
              have hgo hjo := ho
              have hjl hjs := h
              have c1: !(g = M) -> false proof
                assume ne
                have eo := apply(mp.bg_other[A := A1, k := KK, T := A.taken, m := M, V := VR, p := g], ne)
                have e2 := mp(app_update_other[f := A1.slots, k := M, v := fn_build(1, i. tag(0, empty)), x := g], ne)
                have e1: A2.slots[g] = A1.slots[g] by simp(eo, e2)
                have ns := mp(all_elim(expand(nr1, mallocng.no_reserved), {g}, {j}), conj(hgo, hjo), rewrite(e1, hjl))
                show by taut(ns, rewrite(e1, hjs))
              qed
              have c2: g = M -> g = M && j = 0 proof
                assume eg
                have sl1: seq_len(A2.slots[M]) = 1 by defs(simp(sM, fn_build_dom[d := 1, v := i. tag(3, empty)]), seq_len)
                have jl: int_lt(j, 1) by arith(rewrite(eg, hjl), sl1)
                show by arith(eg, jl, hjo)
              qed
              show by taut(c1, c2)
            qed
            show by defs(taut(l1, s0, uq), mallocng.reserved_only)
          qed
          have pu: mallocng.is_used(H2.A, fst(r5)) by simp(iuM, hA2, rm)
          have pro: mallocng.reserved_only(H2.A, fst(r5), 0) by simp(roM, hA2, rm)
          have {bst = stride} := apply(mp.bg_basic, GP)
          have stv: mallocng.stride(VR) = int_sub(NK, 16) by arith(bst, vml)
          have sst: mallocng.slot_start(VR, 0) = int_add(P, 16) by defs(simp(vmem), mallocng.slot_start, mallocng.storage, mallocng.UNIT)
          have sen: mallocng.slot_end(VR, 0) = int_sub(int_add(P, NK), 4) by defs(arith(sst, stv), mallocng.slot_end, mallocng.IB)
          have ib4: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
          have srw: mallocng.slot_rw(VF, VR, 0) proof
            have q: all x0. x0 in omega -> int_le(int_sub(mallocng.slot_start(VR, 0), mallocng.IB), x0) && int_lt(x0, mallocng.slot_end(VR, 0)) ->
                mallocng.m_rw(mallocng.mview(VF, mallocng.all_bytes()), x0) && !(snd(mallocng.pg(mallocng.mview(VF, mallocng.all_bytes()), x0)).kind = 2) proof
              fix a
              assume hao w
