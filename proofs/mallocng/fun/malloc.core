        have psh2: mallocng.shown_in(c, h.A, W2.objs) by simp(hsh)
        have w2v: W2.vm in x86_64_linux.Vm by simp(v2v)
        step V4 r4, e5 _ hR4 from conj(rewrite(ww3, e4), kx4) with hsq using hh, pin2, psh2, w2W, ths2, w2v
        have v4v co24w := hR4
        have co24: mallocng_specs.ctx_only(c, V2, V4) by simp(co24w)
        have hin4 := apply(mp.co_holds[c := c, A := A, vm := V2, vm2 := V4, b := B], hin2, co24)
        let W4 := fn_update(s, "vm", V4)
        have ww4: fn_update(W2, "vm", V4) = W4 := fn_update_twice[f := s, k := "vm", a := V2, b := V4]
        have w4W w4u := apply(mp.am_world, hw, hu, v4v)
