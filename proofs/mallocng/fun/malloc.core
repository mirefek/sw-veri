        have w5W w5u := apply(mp.am_world, hw, hu, v5v)
        have rg5 := apply(mp.am_rng[c := c, A := A, B := B, s := W4, A2 := A1, m := M], hc, au, hat, (B in fn_space(bits(64), option(omega)) by simp(hbt)), pin4,
          gk1, mb, tk1, grw5, mfp5)
        have {th5 = thread, eo5 = errno, tl5 = tls, ea5 = apart} := apply(mp.agr_side[c := c, A := A, A1 := A1, B := B, s := W4, V := V5], w4W, pth4, ptl4, peo4, pea4,
