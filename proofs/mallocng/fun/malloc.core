        have bs4e: V4.brk_start = V0.brk_start := trans(b24, mst)
        have pbs4: abi.brk_start_ok(W4.vm) by defs(simp(bs4e, expand(hbs, abi.brk_start_ok)), abi.brk_start_ok)
        have peo4: mallocng_specs.errno_ok(W4.vm, W4.objs, W4.fs_base) by simp(eo4, keep(mallocng_specs.errno_ok))
        have pea4: mallocng_specs.errno_apart(c, h.A, W4.vm, W4.fs_base) by simp(ea4, keep(mallocng_specs.errno_apart))
        have w4v: W4.vm in x86_64_linux.Vm by simp(v4v)
        step V5 r5, e6 _ hR5 from conj(rewrite(ww4, e5), kx4) with ham using hh, pin4, psh4, w4W, ths4, pth4, ptl4, pbs4, peo4, pea4, w4v
        have v5v ex5 := hR5
