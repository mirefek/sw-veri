          // (the index: i)
          have tz := rewrite(pw, mp(all_elim(ms.tz_pow2, {i}), io, il))
          have bi: bits_of_int(32, i) = i by defs(arith(io, il), bits_of_int, pow2)
          have ie: bits_of_int(32, fst(r)) = i := trans(rewrite(tz, hR), bi)
          have ib: i in bits(32) by arith(io, il)
          // (slot i of G reserved at A1, the only one; G of class SC, its slots
          // large enough -- with a slot unused, not one mapped on its own)
          have ro1 := apply(mp.res_only, hnr, rs)
          have rac: A1.active = A.active by simp()
          have {Hr = inv} := expand(rh, mallocng.holds_m)
          have {hacr = active} := expand(Hr, mallocng.holds)
          have iu1 sc1 _ := mp(all_elim(expand(hacr, mallocng.active_ok), {SC}, {0}), conj(sco, (0 in omega by simp())), conj(hsc48, (int_lt(0, seq_len(A1.active[SC])) by simp(rac, k0l))))
          have h1g: A1.active[SC][0] = G := trans((A1.active[SC][0] = L[0] by simp(rac)), sym(hmg))
          have iuG := rewrite(h1g, iu1)
          have scG: A1.metas[G].sizeclass = SC := rewrite(h1g, sc1)
          have {fr = ranges, fm = meta, ftk = taken} := apply(mp.reorg_ranges[c := c, A := A, A2 := A1, sc := SC], hat, ro)
          have {go = nat} := apply(mp.used_nat, ra, iuG)
          have sc0 st0 := mp(all_elim(fm, {G}), go)
          have ol0: mallocng.on_list(A.active[SC], G) by defs(ex_intro({0}, taut((0 in omega by simp()), k0l, sym(hmg))), mallocng.on_list)
          have ril riu _ _ _ _ := expand(rs, mallocng.reserves)
          have hu0: mallocng.has_unused(A, G) by defs(ex_intro({i}, taut(io, ril, riu)), mallocng.has_unused)
          have {hru = reuse} := expand(H0, mallocng.holds)
          have nom := mp(all_elim(expand(hru, mallocng.reuse_ok), {SC}, {G}), conj(sco, go), taut(hsc48, ol0, hu0))
          have sz0: A.metas[G].sizeclass = SC := trans(sym(sc0), scG)
          have nm := rewrite(sz0, expand(nom, mallocng.own_mapping))
          have ib4: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
          have un16: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
          have mono: int_le(mallocng.size_classes[S0], mallocng.size_classes[SC]) proof
            have c0: SC = S0 -> int_le(mallocng.size_classes[S0], mallocng.size_classes[SC]) proof
              assume e
              show by simp(e)
            qed
            have c1: SC = int_add(S0, 1) && int_mod(S0, 2) = 0 -> int_le(mallocng.size_classes[S0], mallocng.size_classes[SC]) proof
              assume e
              have e0 _ := e
              show := mp(all_elim(ms.sc_mono, {S0}, {SC}), s0o, sco, arith(e0), hsc48)
            qed
            show by taut(hrel, c0, c1)
          qed
          have fit: int_le(int_add(n, mallocng.IB), mallocng.stride(A1.metas[G])) by arith(nm, st0, jfit, mono, ib4, un16, no)
          // (outside the allocator: kept; the allocator no larger; the slot
          // reserved: unused before, the allocator's)
          have unt1 := apply(mp.kept_unt[objs := s.objs], apply(mp.unt_wider[c := c, A := A, b := B, V0 := V0, V1 := V2, e := mp.errno(s.fs_base)], unt))
          have fsub := apply(mp.fp_sub[c := c, A := A, A2 := A1, b := B], fr, ftk, hnr)
          have grw := apply(mp.grown_sub[c := c, A := A, A2 := A1, b := B, vm := V0], fsub)
          have {rgg = groups} := apply(mp.reorg_geom, hat, ro)
          have {gm1 = mem} := mp(all_elim(rgg, {G}), go)
          have gm2: A1.metas[G].mem = A.metas[G].mem by simp(gm1)
          have rg: mp.rgrown(c, A1, A, B, V0) proof
            fix a
            assume hao hr2
            obtain g2 i2, hg2 hi2 _ hil2 hs2 his2 from expand(hr2, mallocng.in_reserved)
            have _ _ uq := expand(ro1, mallocng.reserved_only)
            have eg ei := mp(all_elim(uq, {g2}, {i2}), conj(hg2, hi2), conj(hil2, hs2))
            have isl := rewrite(ei, rewrite(eg, his2))
            have isl0: mallocng.in_slot(A.metas[G], i, a) by defs(rewrite(st0, rewrite(gm2, expand(isl, mallocng.in_slot, mallocng.slot_start, mallocng.slot_end, mallocng.storage))),
              mallocng.in_slot, mallocng.slot_start, mallocng.slot_end, mallocng.storage)
            have f := apply(mp.unused_fp[c := c, A := A, vm := V0, b := B, g := G, i := i, a := a], hc, au, hat, hbt, hin, hnr, iug, io, ril, riu, hao, isl0)
            show by taut(f)
          qed
          have tk1: seq_len(A1.taken) = 0 := rewrite(sym(ftk), htk)
          // the counter read
          have co: c.ctx in omega by arith(hx, cv)
          have f12: all k. k in omega -> int_lt(k, 4) -> mallocng.ctx_free(c, int_add(int_add(CTX, 12), k)) proof
            fix k
            assume hk hkl
            show by defs(arith(hk, hkl, hx, cv), mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK)
          qed
          have u12r _ := apply(mp.free_usable[c := c, A := A1, vm := V2, b := B, objs := s.objs, a := int_add(CTX, 12), n := 4], hc, ru, ra, rh, hsh1, arith(cv), f12)
          have md12r: g.mem_defined(W2, CTX, 12, 4, false) by simp(u12r, cnz, cv)
          step e14 from rewrite(ie, rewrite(ww2, k13)) with g.ld32_det using conj(w2u, kb, md12r, cv)
          // unlock()
          have _ lf2 := apply(mp.locks_ok[c := c, A := A1, vm := V2, b := B, objs := s.objs], hc, ru, ra, hbt, v2v, rh, hsh1, hx, hlk, hlc)
          have pth2: abi.thread_ok(W2.vm, W2.fs_base) by simp(th2, keep(abi.thread_ok))
          have plf2: mallocng_specs.lock_free(W2.vm, W2.objs, c_src_malloc_mallocng_malloc.__malloc_lock) by simp(rewrite(hlk, lf2))
          step V9 r9, e15 kx15 hR9 from e14 with mp.ul0_q using conj(hul, w2W, ths2, plf2, pth2)
          have v9e: V9 = V2 by simp(hR9)
          have ww9: fn_update(W2, "vm", V9) = W2 := trans(fn_update_twice[f := s, k := "vm", a := V2, b := V9], rewrite(v9e, refl({fn_update(s, "vm", V9)}), {2}))
          // enframe(G, i, n, ctr): slot i framed
          let H2 := fn_update(h, "A", A1)
          have hg2 := apply(mp.g_upd, {h}, {A1}, hh, ra, ru)
          have hA2: H2.A = A1 by simp()
          have hB2: H2.blocks = B by simp(hbt)
          have pin2: mallocng.holds_m(c, H2.A, W2.vm, H2.blocks) by simp(rh, hA2, hB2)
          have psh2: mallocng.shown_in(c, H2.A, W2.objs) by simp(hsh1, hA2)
          have {psrw0 = srw, pspan0 = span, pcb0 = cb, pfs0 = fs} := apply(mp.mi_efpre[c := c, A := A, A1 := A1, B := B, V0 := V0, V1 := V2, fs := s.fs_base, G := G, R := i, SC := SC, S0 := S0, n := n],
            hc, ru, ra, rh, iuG, io, ro1, scG, hsc48, fit, no, s0o, hR2c, hrel, fsb, hth, htl, grw, rg)
          have pu: mallocng.is_used(H2.A, G) by simp(iuG, hA2)
          have pro: mallocng.reserved_only(H2.A, G, i) by simp(ro1, hA2)
          have psrw: mallocng.slot_rw(W2.vm, H2.A.metas[G], i) by simp(psrw0, hA2)
          have pfit: int_le(int_add(n, mallocng.IB), mallocng.stride(H2.A.metas[G])) by simp(fit, hA2)
          have pspan: int_lt(int_sub(int_sub(mallocng.stride(H2.A.metas[G]), n), mallocng.IB), int_pow(2, 31)) by simp(pspan0, hA2)
          have pcb: int_lt(H2.A.metas[G].sizeclass, 48) ->
              int_lt(int_sub(int_sub(mallocng.slot_end(H2.A.metas[G], i), n), mallocng.storage(H2.A.metas[G])),
                int_mul(int_mul(mallocng.UNIT, mallocng.size_classes[H2.A.metas[G].sizeclass]), int_add(i, 1))) ||
              int_le(int_add(int_sub(mallocng.slot_start(H2.A.metas[G], i), mallocng.storage(H2.A.metas[G])), int_mul(256, mallocng.UNIT)),
                int_mul(int_mul(mallocng.UNIT, mallocng.size_classes[H2.A.metas[G].sizeclass]), int_add(i, 1))) by simp(pcb0, hA2)
          have pfs: int_le(int_add(W2.fs_base, 8), int_sub(mallocng.slot_start(H2.A.metas[G], i), mallocng.IB)) || int_le(mallocng.slot_end(H2.A.metas[G], i), W2.fs_base)
            by simp(pfs0, hA2)
          have cb32: bits_of_int(32, gimple.bytes_at(V2, int_add(CTX, 12), 4)) in bits(32) by simp()
          step V10 P10, e16 hR10 from rewrite(ww9, e15) with hef
            using conj(gb, ib, hnb, cb32, hg2, pin2, psh2, w2W, w2u, w2v, ths2, pth2, pu, pro, psrw, pfit, pspan, pcb, pfs)
          // the block: framed in slot i (mp.bfpre)
          have v10v r10c := hR10
          let Q := fst(P10)
          have q10: Q in bits(64) && mallocng_specs.framed(V2, V10, A1.metas[G], i, Q, n) by simp(r10c, hA2, keep(mallocng_specs.framed))
          have qb qfr := q10
          have BP: mp.bfpre(c, A1, V2, V10, B, G, i, Q, n) := conj(hc, ru, ra, hbt, v2v, v10v, rh, iuG, io, ro1, qb, no, qfr)
          have fin := apply(mp.mi_fin[c := c, A := A, A1 := A1, B := B, s := s, V1 := V2, V2 := V10, g := G, i := i, p := Q, n := n], BP, hsh1, tk1, unt1, grw, rg)
          show by disj({3}, ex_intro({mp.blk(A1, G, i, Q)}, {V10}, {Q}, taut(fin, e16)))
        qed
        show by taut(cc, cov, cret)
      qed
      // (the request: in a slot of class SC -- S0's, or a larger one's)
      have cfit: int_le(int_add(n, mallocng.IB), int_mul(mallocng.UNIT, mallocng.size_classes[SC])) proof
        have c0: SC = S0 -> int_le(mallocng.size_classes[S0], mallocng.size_classes[SC]) proof
          assume e
          show by simp(e)
        qed
        have c1: SC = int_add(S0, 1) && int_mod(S0, 2) = 0 -> int_le(mallocng.size_classes[S0], mallocng.size_classes[SC]) proof
          assume e
          have e0 _ := e
          show := mp(all_elim(ms.sc_mono, {S0}, {SC}), s0o, sco, arith(e0), hsc48)
        qed
        have mn: int_le(mallocng.size_classes[S0], mallocng.size_classes[SC]) by taut(hrel, c0, c1)
        show by arith(mn, jfit, (mallocng.IB = 4 by defs(refl({4}), mallocng.IB)), (mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)), no)
      qed
      // no slot free: upgradelock(), alloc_slot(SC, n)
      have slow: FIRST = 0 -> mp.mi_out(c, A, n, B, s, o) proof
        assume hff
        step x12 V11 r11, e12 kx12 hR11 from e11 with hff, mp.ugl_q using conj(hug, hw, ths)
        have _ v11e := hR11
        have ss11: fn_update(s, "vm", V11) = s := trans(rewrite(v11e, refl({fn_update(s, "vm", V11)}), {2}), ss)
        step V12 r12, e13 kx13 hR12 from conj(rewrite(ss11, e12), kx12) with has using conj(hh, hin, hsh, hw, hu, vV, ths, hnr, hth, htl, hbs, heo, hea, hscb, hsc48, cfit, hnb)
        have v12v ex12 := hR12
        obtain A2 R2, a2a a2u tk2 lw2 r2b alt2 hin2 hsh2 unt2 grw2 rgw2 en12 rr2 from ex12
        let W12 := fn_update(s, "vm", V12)
        let EN := mp.errno(s.fs_base)
        have w12W w12u := apply(mp.am_world, hw, hu, v12v)
        have w12v: W12.vm in x86_64_linux.Vm by simp(v12v)
        have fsb: s.fs_base in bits(64) by simp(expand(hw, abi.World))
        have nee: all k. k in omega -> int_lt(k, 8) -> !(int_add(s.fs_base, k) in EN) proof
          fix k
          assume hk hkl
          assume he
          have q1 _ := (int_le(int_add(s.fs_base, 52), int_add(s.fs_base, k)) && int_lt(int_add(s.fs_base, k), int_add(s.fs_base, 56)) by simp(he))
          show by arith(q1, hkl)
        qed
        have th12 := apply(mp.tls_unt[c := c, A := A, b := B, V0 := V0, V1 := V12, fs := s.fs_base, e := EN], fsb, hth, htl, unt2, nee)
        have ths12: gc.sound(W12) by simp(th12)
        have pth12: abi.thread_ok(W12.vm, W12.fs_base) by simp(th12, keep(abi.thread_ok))
        have _ lf12 := apply(mp.locks_ok[c := c, A := A2, vm := V12, b := B, objs := s.objs], hc, a2u, a2a, hbt, v12v, hin2, hsh2, hx, hlk, hlc)
        have plf12: mallocng_specs.lock_free(W12.vm, W12.objs, c_src_malloc_mallocng_malloc.__malloc_lock) by simp(rewrite(hlk, lf12))
        have tk2l: seq_len(A2.taken) = 0 := rewrite(sym(tk2), htk)
        // none: unlock(), 0 (errno ENOMEM)
        have fail: R2 = 4294967295 && mallocng.no_reserved(A2) -> mp.mi_out(c, A, n, B, s, o) proof
          assume hf
          have rf nr2 := hf
          have sneg: int_lt(sint(32, bits_of_int(32, fst(r12))), sint(32, 0)) by defs(simp(rr2, rf), sint)
          step x14 V13 r13, e14 kx14 hR13 from conj(e13, kx13) with sneg, mp.ul0_q using conj(hul, w12W, ths12, plf12, pth12)
          have v13e: V13 = V12 by simp(hR13)
          have r: (A2 in mallocng.Abs && A2 in univ(1)) && mallocng.no_reserved(A2) && seq_len(A2.taken) = 0 by taut(a2a, a2u, nr2, tk2l)
          show by disj({2}, ex_intro({A2}, {V12}, taut(r, v12v, hin2, hsh2, unt2, grw2, mp(en12, rf), rewrite(v13e, e14))))
        qed
        // slot R2 of SC's head G2 reserved: the head read, the counter,
        // unlock(), enframe(G2, R2, n, ctr)
        have got: int_lt(R2, 32) && ord_lt(0, seq_len(A2.active[SC])) && mallocng.reserved_only(A2, A2.active[SC][0], R2) && A2.metas[A2.active[SC][0]].sizeclass = SC &&
            int_le(int_add(n, mallocng.IB), mallocng.stride(A2.metas[A2.active[SC][0]])) -> mp.mi_out(c, A, n, B, s, o) proof
          assume hk
          have r32 olt ro gsc gfit := hk
          let G2 := A2.active[SC][0]
          have r2o: R2 in omega by arith(r2b)
          have rsm := mp(all_elim(ms.sint_small, {R2}), r2o, arith(r32))
          have spos0: !int_lt(sint(32, R2), sint(32, 0)) by arith(rsm, (sint(32, 0) = 0 by defs(simp(), sint)), r2o)
          have spos := rewrite(sym(rr2), spos0)
          // (G2: the head of SC's list, its word in the context)
          have vb12: V12.bytes in fn_space(bits(64), bits(8)) by simp(v12v)
          have la2 := rewrite(ka, rewrite(hx, apply(mp.active_at[c := c, A := A2, vm := V12, b := B, objs := s.objs, sc := SC], hc, a2u, a2a, vb12, hin2, hsh2, cal, sco, hsc48)))
          have {H2i = inv} := expand(hin2, mallocng.holds_m)
          have {cok2 = ctx, hac2 = active} := expand(H2i, mallocng.holds)
          have {na2 = nactive} := expand(cok2, mallocng.ctx_ok)
          have al2: A2.active in list_type(list_type(omega)) by simp(a2a)
          have alj := apply(at_type[l := A2.active, t := list_type(omega), i := SC], al2, sco, (int_lt(SC, seq_len(A2.active)) by arith(na2, hsc48)))
          have {hd2 = head} := apply(mp.list_rd[vm := V12, objs := s.objs, phead := PHS, l := A2.active[SC], i := 0], vb12, phsb, alj, la2)
          have l2o: seq_len(A2.active[SC]) in omega by simp(alj)
          have lnz2: !(seq_len(A2.active[SC]) = 0) by arith(expand(olt, ord_lt), l2o)
          have hdv: gimple.bytes_at(V12, PHS, 8) = G2 by simp(hd2, lnz2)
          have {hw2 = head} := expand(la2, mallocng_specs.list_at)
          have _ _ hrd2 _ := expand(hw2, mallocng_specs.word_ok)
          have mdph: g.mem_defined(W12, PHS, 0, 8, false) by simp(hrd2, (int_add(PHS, 0) = PHS by arith(phsb)), (!(PHS = 0) by arith(cv, sco)), (int_lt(PHS, pow2(64)) by arith(phsb)))
          have sxs := apply(ms.sext_small, hscb, arith(hsc48, sco))
          have bo bl := mp(all_elim(g.bytes_bound, {V12}, {int_add(PHS, 0)}, {8}), vb12, simp())
          have p0e: int_add(PHS, 0) = PHS by arith(phsb)
          have gv0 := mp(bits_of_int_small[n := 64, a := gimple.bytes_at(V12, int_add(PHS, 0), 8)], bo, (int_lt(gimple.bytes_at(V12, int_add(PHS, 0), 8), pow2(64)) by arith(bl, p64)))
          have gv: bits_of_int(64, gimple.bytes_at(V12, int_add(PHS, 0), 8)) = G2 := trans(gv0, rewrite(sym(p0e), hdv, {1}))
          have iu2 _ _ := mp(all_elim(expand(hac2, mallocng.active_ok), {SC}, {0}), conj(sco, (0 in omega by simp())), conj(hsc48, (int_lt(0, seq_len(A2.active[SC])) by arith(lnz2, l2o))))
          have {go2 = nat} := apply(mp.used_nat, a2a, iu2)
          have {gbd = bound} := apply(mp.list_el[vm := V12, objs := s.objs, phead := PHS, l := A2.active[SC], i := 0], alj, la2, simp(), (int_lt(0, seq_len(A2.active[SC])) by arith(lnz2, l2o)))
          have gb2: G2 in bits(64) by arith(go2, gbd)
          // (the counter: a free word of the context)
          have f12: all k. k in omega -> int_lt(k, 4) -> mallocng.ctx_free(c, int_add(int_add(CTX, 12), k)) proof
            fix k
            assume hk2 hkl
            show by defs(arith(hk2, hkl, hx, cv), mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK)
          qed
          have u12r _ := apply(mp.free_usable[c := c, A := A2, vm := V12, b := B, objs := s.objs, a := int_add(CTX, 12), n := 4], hc, a2u, a2a, hin2, hsh2, arith(cv), f12)
          have md12r: g.mem_defined(W12, CTX, 12, 4, false) by simp(u12r, cnz, cv)
          step e15 from conj(e13, kx13) with spos, g.padd_det, s80, g.elem8_det, g.ld64_det, sxs, g.ld32_det, gv
            using conj(w12W, w12u, kb, mdph, phsb, cv, hx, cnz, md12r, sco, hsc48)
          step V14 r14, e16 kx16 hR14 from e15 with mp.ul0_q using conj(hul, w12W, ths12, plf12, pth12)
          have v14e: V14 = V12 by simp(hR14)
          have ww14: fn_update(W12, "vm", V14) = W12 := trans(fn_update_twice[f := s, k := "vm", a := V12, b := V14], rewrite(v14e, refl({fn_update(s, "vm", V14)}), {2}))
          // enframe(G2, R2, n, ctr): slot R2 framed
          let H2 := fn_update(h, "A", A2)
          have hg2 := apply(mp.g_upd, {h}, {A2}, hh, a2a, a2u)
          have hA2: H2.A = A2 by simp()
          have hB2: H2.blocks = B by simp(hbt)
          have pin2: mallocng.holds_m(c, H2.A, W12.vm, H2.blocks) by simp(hin2, hA2, hB2)
          have psh2: mallocng.shown_in(c, H2.A, W12.objs) by simp(hsh2, hA2)
          have {psrw0 = srw, pspan0 = span, pcb0 = cb, pfs0 = fs} := apply(mp.mi_efpre[c := c, A := A, A1 := A2, B := B, V0 := V0, V1 := V12, fs := s.fs_base, G := G2, R := R2, SC := SC, S0 := S0, n := n],
            hc, a2u, a2a, hin2, iu2, r2o, ro, gsc, hsc48, gfit, no, s0o, hR2c, hrel, fsb, hth, htl, grw2, rgw2)
          have pu: mallocng.is_used(H2.A, G2) by simp(iu2, hA2)
          have pro: mallocng.reserved_only(H2.A, G2, R2) by simp(ro, hA2)
          have psrw: mallocng.slot_rw(W12.vm, H2.A.metas[G2], R2) by simp(psrw0, hA2)
          have pfit: int_le(int_add(n, mallocng.IB), mallocng.stride(H2.A.metas[G2])) by simp(gfit, hA2)
          have pspan: int_lt(int_sub(int_sub(mallocng.stride(H2.A.metas[G2]), n), mallocng.IB), int_pow(2, 31)) by simp(pspan0, hA2)
          have pcb: int_lt(H2.A.metas[G2].sizeclass, 48) ->
              int_lt(int_sub(int_sub(mallocng.slot_end(H2.A.metas[G2], R2), n), mallocng.storage(H2.A.metas[G2])),
                int_mul(int_mul(mallocng.UNIT, mallocng.size_classes[H2.A.metas[G2].sizeclass]), int_add(R2, 1))) ||
              int_le(int_add(int_sub(mallocng.slot_start(H2.A.metas[G2], R2), mallocng.storage(H2.A.metas[G2])), int_mul(256, mallocng.UNIT)),
                int_mul(int_mul(mallocng.UNIT, mallocng.size_classes[H2.A.metas[G2].sizeclass]), int_add(R2, 1))) by simp(pcb0, hA2)
          have pfs: int_le(int_add(W12.fs_base, 8), int_sub(mallocng.slot_start(H2.A.metas[G2], R2), mallocng.IB)) || int_le(mallocng.slot_end(H2.A.metas[G2], R2), W12.fs_base)
            by simp(pfs0, hA2)
          have cb32: bits_of_int(32, gimple.bytes_at(V12, int_add(CTX, 12), 4)) in bits(32) by simp()
          step V15 P15, e17 hR15 from conj(rewrite(ww14, e16), kx16) with rr2, hef
            using conj(gb2, r2b, hnb, cb32, hg2, pin2, psh2, w12W, w12u, w12v, ths12, pth12, pu, pro, psrw, pfit, pspan, pcb, pfs)
          // the block: framed in slot R2 (mp.bfpre)
          have v15v r15c := hR15
          let Q := fst(P15)
          have q15: Q in bits(64) && mallocng_specs.framed(V12, V15, A2.metas[G2], R2, Q, n) by simp(r15c, hA2, keep(mallocng_specs.framed))
          have qb qfr := q15
          have BP: mp.bfpre(c, A2, V12, V15, B, G2, R2, Q, n) := conj(hc, a2u, a2a, hbt, v12v, v15v, hin2, iu2, r2o, ro, qb, no, qfr)
          have fin := apply(mp.mi_fin[c := c, A := A, A1 := A2, B := B, s := s, V1 := V12, V2 := V15, g := G2, i := R2, p := Q, n := n], BP, hsh2, tk2l, unt2, grw2, rgw2)
          show by disj({3}, ex_intro({mp.blk(A2, G2, R2, Q)}, {V15}, {Q}, taut(fin, e17)))
        qed
        show by taut(alt2, fail, got)
      qed
      show by taut(fast, slow)
    qed
    show by taut(big, cls)
  qed
  show by taut(toobig, fits)
qed

// ----------------------------------------------------------------------
//  The refinement

// the ghost part's live blocks replaced: a ghost part still
theorem mp.g_updb: all h b2. h in mp.G -> b2 in fn_space(bits(64), option(omega)) -> b2 in univ(1) -> fn_update(h, "blocks", b2) in mp.G
proof
  fix h b2
  assume hh hb2 hu2
  obtain x y, hx hy he from mp(rec_and_elim[a := malloc.Heap.ghost, b := mallocng_specs.MallocAbs.ghost, s := h], hh)
  have xp xf xd _ := (x in powerset(cart(insert("blocks", empty), univ(1))) && is_fun(x) && dom(x) = insert("blocks", empty) && x.blocks in fn_space(bits(64), option(omega))
    by simp(expand(hx, malloc.Heap.ghost)))
  have yf yd := (is_fun(y) && dom(y) = insert("A", empty) by simp(expand(hy, mallocng_specs.MallocAbs.ghost)))
  let X2 := fn_update(x, "blocks", b2)
  have x2f x2d := mp(fn_update_fd[f := x, k := "blocks", v := b2, d := insert("blocks", empty)], xf, xd, simp())
  have xs: subset(x, cart(insert("blocks", empty), univ(1))) by taut(powerset_def[s := cart(insert("blocks", empty), univ(1)), a := x], xp)
  have sub: all z. z in X2 -> z in cart(insert("blocks", empty), univ(1)) proof
    fix z
    assume hz
    have c := fn_update_iff[f := x, k := "blocks", v := b2, z := z]
    have c1: z in x -> z in cart(insert("blocks", empty), univ(1)) proof
      assume h1
      show := mp(subset_elim[a := x, b := cart(insert("blocks", empty), univ(1)), z := z], xs, h1)
    qed
    have c2: z = pair("blocks", b2) -> z in cart(insert("blocks", empty), univ(1)) proof
      assume h2
      show := rewrite(sym(h2), mp(cart_intro[a := insert("blocks", empty), b := univ(1), x := "blocks", y := b2], simp(), hu2))
    qed
    show by taut(c, hz, c1, c2)
  qed
  have pw: X2 in powerset(cart(insert("blocks", empty), univ(1))) by taut(powerset_def[s := cart(insert("blocks", empty), univ(1)), a := X2], (subset(X2, cart(insert("blocks", empty), univ(1))) by defs(sub, subset)))
  have ap: X2.blocks = b2 := app_update_same[f := x, k := "blocks", v := b2]
  have sd := set_select_def[s := powerset(cart(insert("blocks", empty), univ(1))), p := x0. (is_fun(x0) && dom(x0) = insert("blocks", empty)) && x0.blocks in fn_space(bits(64), option(omega)), z := X2]
  have x2t: X2 in malloc.Heap.ghost by defs(taut(sd, pw, x2f, x2d, rewrite(sym(ap), hb2)), malloc.Heap.ghost)
  have ri := mp(rec_and_intro[a := malloc.Heap.ghost, b := mallocng_specs.MallocAbs.ghost, x := X2, y := y], x2t, hy)
  have yk := apply(mp.one_key, yf, yd)
  have nk: all z. z in y -> fst(z) != "blocks" proof
    fix z
    assume hz
    show by simp(mp(all_elim(yk, {z}), hz))
  qed
  have eu := mp(fn_update_union_l[a := x, b := y, k := "blocks", v := b2], nk)
  have e2: fn_update(h, "blocks", b2) = union2(X2, y) := trans(subst({w. fn_update(h, "blocks", b2) = fn_update(w, "blocks", b2)}, he, refl({fn_update(h, "blocks", b2)})), eu)
  show := rewrite(sym(e2), ri)
qed

// a program of malloc's outcome (`mp.mi_out`) wherever malloc's
// precondition holds refines malloc's purpose spec (the ghost part: the
// live blocks and the abstract state its return's)
abbrev mp.mi_runs(c, n, P) := all s h o. s in abi.World -> h in mp.G ->
  mallocng.holds_m(c, h.A, s.vm, h.blocks) -> mallocng.shown_in(c, h.A, s.objs) -> mallocng.no_reserved(h.A) -> seq_len(h.A.taken) = 0 ->
  abi.thread_ok(s.vm, s.fs_base) -> mallocng_specs.tls_apart(c, h.A, s.fs_base) ->
  abi.brk_start_ok(s.vm) -> mallocng_specs.errno_ok(s.vm, s.objs, s.fs_base) -> mallocng_specs.errno_apart(c, h.A, s.vm, s.fs_base) ->
  runs(P, s, o) -> mp.mi_out(c, h.A, n, h.blocks, s, o)

theorem mp.mi_ref(c, n, P): n in bits(64) -> (all s o. runs(P, s, o) -> pair(s, o) in univ(1)) -> mp.mi_runs(c, n, P) ->
  refines_ghost(P, mallocng_specs.malloc_impl_spec(c, n), abi.World, mp.G)
proof
  assume hnb rp hrun
  unfold mallocng_specs.malloc_impl_spec
  refine ct.refines_contract_g with mp.g_world, rp
  fix s h o
  assume hw hh hr hpre
  let S := union2(s, h)
  let A := h.A
  let B := h.blocks
  let V0 := s.vm
  have _ hd _ _ := mp(all_elim(mp.g_rec, {h}), hh)
  have sd: dom(s) = insert("vm", insert("os", insert("fs_base", insert("cpu", insert("objs", empty))))) by simp(expand(hw, abi.World))
  have aS: S.A = A by simp(sd, hd)
  have vS: S.vm = V0 by simp(sd, hd)
  have bS: S.blocks = B by simp(sd, hd)
  have oS: S.objs = s.objs by simp(sd, hd)
  have fS: S.fs_base = s.fs_base by simp(sd, hd)
  have hin0: mallocng.holds_in(c, A, V0, s.objs, B) by simp(hpre, sd, hd)
  have {hin = mem, hsh = shown} := hin0
  have hnr: mallocng.no_reserved(A) by simp(hpre, sd, hd)
  have htk: seq_len(A.taken) = 0 by simp(hpre, sd, hd)
  have hth: abi.thread_ok(V0, s.fs_base) by simp(hpre, sd, hd)
  have htl: mallocng_specs.tls_apart(c, A, s.fs_base) by simp(hpre, sd, hd)
  have hbs: abi.brk_start_ok(V0) by simp(hpre, sd, hd)
  have heo: mallocng_specs.errno_ok(V0, s.objs, s.fs_base) by simp(hpre, sd, hd)
  have hea: mallocng_specs.errno_apart(c, A, V0, s.fs_base) by simp(hpre, sd, hd)
  have run := mp(all_elim(hrun, {s}, {h}, {o}), hw, hh, hin, hsh, hnr, htk, hth, htl, hbs, heo, hea, hr)
  // (the world's part and the ghost part joined: the spec's state)
  have sk := apply(abi.keys_of[f := s, d := insert("vm", insert("os", insert("fs_base", insert("cpu", insert("objs", empty)))))], sd)
  have nab: all z. z in s -> fst(z) != "A" && fst(z) != "blocks" proof
    fix z
    assume hz
    show by simp(mp(all_elim(sk, {z}), hz))
  qed
  have hgu _ _ _ := mp(all_elim(mp.g_rec, {h}), hh)
  have bu := mp(app_univ[u := 1, f := h, k := "blocks"], hgu)
  have bt: B in fn_space(bits(64), option(omega)) := mp(all_elim(mp.g_rec, {h}), hh).3
  have joinS: all BL A2 V2. fn_update(fn_update(h, "blocks", BL), "A", A2) in mp.G ->
      union2(fn_update(s, "vm", V2), fn_update(fn_update(h, "blocks", BL), "A", A2)) = fn_update(fn_update(fn_update(S, "blocks", BL), "A", A2), "vm", V2) proof
    fix BL A2 V2
    assume hg2
    let HB := fn_update(h, "blocks", BL)
    let H2 := fn_update(HB, "A", A2)
    let RHS := fn_update(fn_update(fn_update(S, "blocks", BL), "A", A2), "vm", V2)
    have nb: all z. z in s -> fst(z) != "blocks" proof
      fix z
      assume hz
      have _ q := mp(all_elim(nab, {z}), hz)
      show q
    qed
    have na: all z. z in s -> fst(z) != "A" proof
      fix z
      assume hz
      have q _ := mp(all_elim(nab, {z}), hz)
      show q
    qed
    have _ hk := mp(all_elim(mp.g_world, {H2}), hg2)
    have nv: all z. z in H2 -> fst(z) != "vm" proof
      fix z
      assume hz
      show by simp(mp(all_elim(hk, {z}), hz))
    qed
    have e1 := mp(fn_update_union_r[a := s, b := h, k := "blocks", v := BL], nb)
    have e2 := mp(fn_update_union_r[a := s, b := HB, k := "A", v := A2], na)
    have e3 := mp(fn_update_union_l[a := s, b := H2, k := "vm", v := V2], nv)
    have r1 := subst({y. RHS = fn_update(fn_update(y, "A", A2), "vm", V2)}, e1, refl({RHS}))
    have r2 := subst({y. RHS = fn_update(y, "vm", V2)}, e2, r1)
    show := sym(trans(r2, e3))
  qed
  // 0: the blocks as they were
  have k0: case 2 of run proof
    assume e
    obtain A2 V2, ha2 hu2 hnr2 htk2 hv2 hin2m hsh2 hunt hgr hen ho from e
    have hin2: mallocng.holds_in(c, A2, V2, s.objs, B) by defs(taut(hin2m, hsh2), mallocng.holds_in)
    let BL := ite(!(0 = 0), malloc.set_block(S.blocks, 0, some(n)), S.blocks)
    let H2 := fn_update(fn_update(h, "blocks", BL), "A", A2)
    let s1 := fn_update(s, "vm", V2)
    have b0: BL = B by simp(bS)
    have hgb := apply(mp.g_updb, {h}, {BL}, hh, rewrite(sym(b0), bt), rewrite(sym(b0), bu))
    have hg2 := apply(mp.g_upd, {fn_update(h, "blocks", BL)}, {A2}, hgb, ha2, hu2)
    have eS := mp(all_elim(joinS, {BL}, {A2}, {V2}), hg2)
    show by disj({2}, ex_intro({s1}, {0}, {H2}, spec_ret({0}, {A2}, {V2}, hg2, ho, ha2, hnr2, htk2, aS, vS, bS, oS, fS, hv2, hin2, hunt, hgr, hen, b0, eS)))
  qed
  // p: a new live block of n bytes
  have k1: case 3 of run proof
    assume e
    obtain A3 V3 p, ha3 hu3 hnr3 htk3 hv3 hpb hpnz hpf hin3m hsh3 hunt3 hgr3 hby3 ho from e
    let NB := malloc.set_block(B, p, some(n))
    have hin3: mallocng.holds_in(c, A3, V3, s.objs, NB) by defs(taut(hin3m, hsh3), mallocng.holds_in)
    let BL := ite(!(p = 0), malloc.set_block(S.blocks, p, some(n)), S.blocks)
    let H2 := fn_update(fn_update(h, "blocks", BL), "A", A3)
    let s1 := fn_update(s, "vm", V3)
    have b1: BL = NB by simp(bS, hpnz)
    have vq: all q. q in bits(64) -> ite(q = p, some(n), B[q]) in option(omega) proof
      fix q
      assume hq
      have bq := mp(fn_space_app[a := bits(64), b := option(omega), f := B, x := q], bt, hq)
      have r1: some(n) in set_image(omega, x0. some(x0)) by taut(set_image_def[s := omega, f := x0. some(x0), y := some(n)],
        (ex x0. x0 in omega && some(x0) = some(n) by ex_intro({n}, taut((n in omega by arith(hnb)), refl({some(n)})))))
      have sn: some(n) in option(omega) by defs(simp(r1), option)
      have c1: q = p -> ite(q = p, some(n), B[q]) in option(omega) proof
        assume e
        show by simp(e, sn)
      qed
      have c2: !(q = p) -> ite(q = p, some(n), B[q]) in option(omega) proof
        assume e
        show by simp(e, bq)
      qed
      show by taut(c1, c2)
    qed
    have nbt: NB in fn_space(bits(64), option(omega)) by defs(mp(fn_build_space[d := bits(64), v := q. ite(q = p, some(n), B[q]), b := option(omega)], vq), malloc.set_block)
    have smu: all x. x in omega -> some(x) in univ(1) proof
      fix x
      assume hx
      have xu := mp(mp(univ_trans[u := 1, a := x, b := omega], omega_univ), hx)
      show by defs(simp(xu), some)
    qed
    have imu := mp(mp(univ_image[u := 1, s := omega, f := x. some(x)], omega_univ), smu)
    have nu: single(none) in univ(1) by defs(simp(), single, none)
    have ou: option(omega) in univ(1) by defs(mp(mp(union2_univ[u := 1, a := single(none), b := set_image(omega, x. some(x))], nu), imu), option)
    have nbu: NB in univ(1) := mp(fn_space_univ[u := 1, a := bits(64), b := option(omega), f := NB], bits_univ[n := 64], ou, nbt)
    have hgb := apply(mp.g_updb, {h}, {BL}, hh, rewrite(sym(b1), nbt), rewrite(sym(b1), nbu))
    have hg2 := apply(mp.g_upd, {fn_update(h, "blocks", BL)}, {A3}, hgb, ha3, hu3)
    have eS := mp(all_elim(joinS, {BL}, {A3}, {V3}), hg2)
    have pch: p = 0 || B[p] = none by taut(hpf)
    show by disj({2}, ex_intro({s1}, {p}, {H2}, spec_ret({p}, {A3}, {V3}, hg2, ho, hpb, pch, ha3, hnr3, htk3, aS, vS, bS, oS, fS, hv3, hin3, hunt3, hgr3, hby3, hpnz, b1, eS)))
  qed
  show by taut(run, k0, k1)
qed

// __libc_malloc_impl refines its purpose spec
theorem mp.mi: all c n gso gmm gwl gsq gam gul gmu gs2c grl gac gug gas gef. c in mallocng.Cfg ->
  c.ctx = c_src_malloc_mallocng_malloc.__malloc_context -> c.sct = c_src_malloc_mallocng_malloc.__malloc_size_classes ->
  c.dbj = c_src_malloc_mallocng_malloc.debruijn32 -> c.lock = c_src_malloc_mallocng_malloc.__malloc_lock -> c.libc = c_src_malloc_mallocng_malloc.__libc ->
  n in bits(64) ->
  mp.calls(gso, mallocng_specs.size_overflows_spec_fun) -> mp.calls(gmm, mallocng_specs.mmap_spec_fun()) ->
  mp.calls(gwl, mallocng_specs.lock_spec_fun(c_src_malloc_mallocng_malloc.__libc)) -> mp.sq_call(c, gsq) -> mp.am_call(c, gam) ->
  mp.calls(gul, mallocng_specs.unlock_spec_fun(c_src_malloc_mallocng_malloc.__malloc_lock)) -> mp.calls(gmu, mallocng_specs.munmap_spec_fun()) ->
  mp.calls(gs2c, mallocng_specs.size_to_class_spec_fun(c.sct, c.dbj)) -> mp.calls(grl, mallocng_specs.lock_spec_fun(c_src_malloc_mallocng_malloc.__libc)) ->
  mp.calls(gac, mallocng_specs.a_ctz_32_spec_fun(c_src_malloc_mallocng_malloc.debruijn32)) -> mp.calls(gug, mallocng_specs.upgradelock_spec_fun()) ->
  mp.as_call(c, gas) -> mp.ef_call(c, gef) ->
  refines_ghost(c_src_malloc_mallocng_malloc.__libc_malloc_impl(n, gso, gmm, gwl, gsq, gam, gul, gmu, gs2c, grl, gac, gug, gas, gef),
    mallocng_specs.malloc_impl_spec(c, n), abi.World, mp.G)
proof
  fix c n gso gmm gwl gsq gam gul gmu gs2c grl gac gug gas gef
  assume hc hx hst hdj hlk hlc hnb hso hmm hwl hsq ham hul hmu hs2c hrl hac hug has hef
  let P := c_src_malloc_mallocng_malloc.__libc_malloc_impl(n, gso, gmm, gwl, gsq, gam, gul, gmu, gs2c, grl, gac, gug, gas, gef)
  have rp: all s o. runs(P, s, o) -> pair(s, o) in univ(1) proof
    fix s o
    assume hr
    show := apply(g.runs_univ, expand(hr, c_src_malloc_mallocng_malloc.__libc_malloc_impl))
  qed
  have rn: mp.mi_runs(c, n, P) proof
    fix s h o
    assume hw hh hin hsh hnr htk hth htl hbs heo hea hr
    show := apply(mp.mi_run[c := c, n := n, gso := gso, gmm := gmm, gwl := gwl, gsq := gsq, gam := gam, gul := gul, gmu := gmu, gs2c := gs2c, grl := grl, gac := gac,
      gug := gug, gas := gas, gef := gef, s := s, h := h, o := o], hc, hx, hst, hdj, hlk, hlc, hnb, hso, hmm, hwl, hsq, ham, hul, hmu, hs2c, hrl, hac, hug, has, hef,
      hw, hh, hin, hsh, hnr, htk, hth, htl, hbs, heo, hea, hr)
  qed
  show := apply(mp.mi_ref[c := c, n := n, P := P], hnb, rp, rn)
qed

// ----------------------------------------------------------------------
//  Called as __libc_malloc_impl: one return, 0 or a new block

// 0: errno ENOMEM, the invariant kept, nothing outside the allocator
// touched but errno, the allocator grown only into memory unmapped before
abbrev mp.mi_zero(c, A, B, s, A2, V2) := (((A2 in mallocng.Abs && A2 in univ(1)) && mallocng.no_reserved(A2)) && seq_len(A2.taken) = 0) &&
  V2 in x86_64_linux.Vm && mallocng.holds_m(c, A2, V2, B) && mallocng.shown_in(c, A2, s.objs) &&
  mallocng.untouched(c, A, B, s.vm, V2, s.objs, mp.errno(s.fs_base)) &&
  (all a. a in omega -> a in mallocng.footprint(c, A2, B) -> a in mallocng.footprint(c, A, B) || !x86_64_linux.mapped(s.vm, int_div(a, x86_64_linux.PAGE))) &&
  mallocng_specs.errno_is(V2, s.fs_base, x86_64_linux.ENOMEM)

abbrev mp.mi_ret(c, A, n, B, s, A2, V2, p) := (p = 0 && mp.mi_zero(c, A, B, s, A2, V2)) || (!(p = 0) && mp.mi_blk(c, A, n, B, s, A2, V2, p))

// malloc's outcome with its two returns as one
theorem mp.mi_out2(c, A, n, B, s, o): mp.mi_out(c, A, n, B, s, o) ->
  abi.ovf_out(s, o) || (ex V p. (V in x86_64_linux.Vm && p in bits(64) && (ex A2. mp.mi_ret(c, A, n, B, s, A2, V, p))) && o = ok(fn_update(s, "vm", V), p))
proof
  assume h
  have z: case 2 of h proof
    assume e
    obtain A2 V2, ha hu hnr htk hv hin hsh hun hgr hen ho from e
    have r: mp.mi_ret(c, A, n, B, s, A2, V2, 0) by taut(refl({0}), ha, hu, hnr, htk, hv, hin, hsh, hun, hgr, hen)
    have r2: ex X. mp.mi_ret(c, A, n, B, s, X, V2, 0) by ex_intro({A2}, r)
    show by disj({2}, ex_intro({V2}, {0}, taut(hv, (0 in bits(64) by simp()), r2, ho)))
  qed
  have k: case 3 of h proof
    assume e
    obtain A3 V3 p, ha hu hnr htk hv hpb hpnz hpf hin hsh hun hgr hby ho from e
    have r: mp.mi_ret(c, A, n, B, s, A3, V3, p) by taut(hpnz, ha, hu, hnr, htk, hv, hpb, hpf, hin, hsh, hun, hgr, hby)
    have r2: ex X. mp.mi_ret(c, A, n, B, s, X, V3, p) by ex_intro({A3}, r)
    show by disj({2}, ex_intro({V3}, {p}, taut(hv, hpb, r2, ho)))
  qed
  show by taut(h, z, k)
qed

// what a caller relies on of a callee f called as __libc_malloc_impl: an
// overflow, or the return -- 0 or a new block
abbrev mp.mi_post(c, n, t, h, o2) := abi.ovf_out(t, o2) ||
  (ex V rr. (V in x86_64_linux.Vm && (ex A2. mp.mi_ret(c, h.A, n, h.blocks, t, A2, V, fst(rr)))) && o2 = ok(fn_update(t, "vm", V), rr))

abbrev mp.mi_call(c, f) := all n t h regs o2. n in bits(64) -> t in abi.World -> h in mp.G ->
  mallocng.holds_m(c, h.A, t.vm, h.blocks) -> mallocng.shown_in(c, h.A, t.objs) -> mallocng.no_reserved(h.A) -> seq_len(h.A.taken) = 0 ->
  abi.thread_ok(t.vm, t.fs_base) -> mallocng_specs.tls_apart(c, h.A, t.fs_base) ->
  abi.brk_start_ok(t.vm) -> mallocng_specs.errno_ok(t.vm, t.objs, t.fs_base) -> mallocng_specs.errno_apart(c, h.A, t.vm, t.fs_base) ->
  gc.regs_ok(regs, seq_one(gimple.arg(64, n))) ->
  runs(f[regs], t, o2) -> mp.mi_post(c, n, t, h, o2)

// (the run with its returns as one)
theorem mp.mi_run2(c, n, gso, gmm, gwl, gsq, gam, gul, gmu, gs2c, grl, gac, gug, gas, gef, s, h, o): c in mallocng.Cfg ->
  c.ctx = c_src_malloc_mallocng_malloc.__malloc_context -> c.sct = c_src_malloc_mallocng_malloc.__malloc_size_classes ->
  c.dbj = c_src_malloc_mallocng_malloc.debruijn32 -> c.lock = c_src_malloc_mallocng_malloc.__malloc_lock -> c.libc = c_src_malloc_mallocng_malloc.__libc ->
  n in bits(64) ->
  mp.calls(gso, mallocng_specs.size_overflows_spec_fun) -> mp.calls(gmm, mallocng_specs.mmap_spec_fun()) ->
  mp.calls(gwl, mallocng_specs.lock_spec_fun(c_src_malloc_mallocng_malloc.__libc)) -> mp.sq_call(c, gsq) -> mp.am_call(c, gam) ->
  mp.calls(gul, mallocng_specs.unlock_spec_fun(c_src_malloc_mallocng_malloc.__malloc_lock)) -> mp.calls(gmu, mallocng_specs.munmap_spec_fun()) ->
  mp.calls(gs2c, mallocng_specs.size_to_class_spec_fun(c.sct, c.dbj)) -> mp.calls(grl, mallocng_specs.lock_spec_fun(c_src_malloc_mallocng_malloc.__libc)) ->
  mp.calls(gac, mallocng_specs.a_ctz_32_spec_fun(c_src_malloc_mallocng_malloc.debruijn32)) -> mp.calls(gug, mallocng_specs.upgradelock_spec_fun()) ->
  mp.as_call(c, gas) -> mp.ef_call(c, gef) ->
  s in abi.World -> h in mp.G ->
  mallocng.holds_m(c, h.A, s.vm, h.blocks) -> mallocng.shown_in(c, h.A, s.objs) -> mallocng.no_reserved(h.A) -> seq_len(h.A.taken) = 0 ->
  abi.thread_ok(s.vm, s.fs_base) -> mallocng_specs.tls_apart(c, h.A, s.fs_base) ->
  abi.brk_start_ok(s.vm) -> mallocng_specs.errno_ok(s.vm, s.objs, s.fs_base) -> mallocng_specs.errno_apart(c, h.A, s.vm, s.fs_base) ->
  runs(c_src_malloc_mallocng_malloc.__libc_malloc_impl(n, gso, gmm, gwl, gsq, gam, gul, gmu, gs2c, grl, gac, gug, gas, gef), s, o) ->
  abi.ovf_out(s, o) || (ex V p. (V in x86_64_linux.Vm && p in bits(64) && (ex A2. mp.mi_ret(c, h.A, n, h.blocks, s, A2, V, p))) && o = ok(fn_update(s, "vm", V), p))
proof
  assume hc hx hst hdj hlk hlc hnb hso hmm hwl hsq ham hul hmu hs2c hrl hac hug has hef hw hh hin hsh hnr htk hth htl hbs heo hea hr
  show := apply(mp.mi_out2[c := c, A := h.A, n := n, B := h.blocks, s := s, o := o],
    apply(mp.mi_run[c := c, n := n, gso := gso, gmm := gmm, gwl := gwl, gsq := gsq, gam := gam, gul := gul, gmu := gmu, gs2c := gs2c, grl := grl, gac := gac,
      gug := gug, gas := gas, gef := gef, s := s, h := h, o := o], hc, hx, hst, hdj, hlk, hlc, hnb, hso, hmm, hwl, hsq, ham, hul, hmu, hs2c, hrl, hac, hug, has, hef,
      hw, hh, hin, hsh, hnr, htk, hth, htl, hbs, heo, hea, hr))
qed

// __libc_malloc_impl's code called as __libc_malloc_impl
theorem mp.mi_q: all c gso gmm gwl gsq gam gul gmu gs2c grl gac gug gas gef. c in mallocng.Cfg ->
  c.ctx = c_src_malloc_mallocng_malloc.__malloc_context -> c.sct = c_src_malloc_mallocng_malloc.__malloc_size_classes ->
  c.dbj = c_src_malloc_mallocng_malloc.debruijn32 -> c.lock = c_src_malloc_mallocng_malloc.__malloc_lock -> c.libc = c_src_malloc_mallocng_malloc.__libc ->
  mp.calls(gso, mallocng_specs.size_overflows_spec_fun) -> mp.calls(gmm, mallocng_specs.mmap_spec_fun()) ->
  mp.calls(gwl, mallocng_specs.lock_spec_fun(c_src_malloc_mallocng_malloc.__libc)) -> mp.sq_call(c, gsq) -> mp.am_call(c, gam) ->
  mp.calls(gul, mallocng_specs.unlock_spec_fun(c_src_malloc_mallocng_malloc.__malloc_lock)) -> mp.calls(gmu, mallocng_specs.munmap_spec_fun()) ->
  mp.calls(gs2c, mallocng_specs.size_to_class_spec_fun(c.sct, c.dbj)) -> mp.calls(grl, mallocng_specs.lock_spec_fun(c_src_malloc_mallocng_malloc.__libc)) ->
  mp.calls(gac, mallocng_specs.a_ctz_32_spec_fun(c_src_malloc_mallocng_malloc.debruijn32)) -> mp.calls(gug, mallocng_specs.upgradelock_spec_fun()) ->
  mp.as_call(c, gas) -> mp.ef_call(c, gef) ->
  mp.mi_call(c, c_src_malloc_mallocng_malloc.__libc_malloc_impl_fun(gso, gmm, gwl, gsq, gam, gul, gmu, gs2c, grl, gac, gug, gas, gef))
proof
  fix c gso gmm gwl gsq gam gul gmu gs2c grl gac gug gas gef
  assume hc hx hst hdj hlk hlc hso hmm hwl hsq ham hul hmu hs2c hrl hac hug has hef
  fix n t h regs o2
  assume hnb hw hh hin hsh hnr htk hth htl hbs heo hea hro hr
  have rl rn r0 := apply(gc.regs1, hnb, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  have o1l: ord_le(1, seq_len(regs)) by defs(simp(rn), ord_le)
  have bp: bits_of_int(64, regs[0]) = n by defs(simp(r0, hnb), bits_of_int, pow2)
  step o3 V p, e hs1 from hr with o1l, bp, mp.mi_run2 using ra, hc, hx, hst, hdj, hlk, hlc, hnb, hso, hmm, hwl, hsq, ham, hul, hmu, hs2c, hrl, hac, hug, has, hef,
    hw, hh, hin, hsh, hnr, htk, hth, htl, hbs, heo, hea
  have hv hpb hex := hs1
  step o4 y, e2 from e with g.result64_inv using hpb
  have fp: fst(pair(p, y)) = p by simp()
  have hex2 := subst({z. ex X. mp.mi_ret(c, h.A, n, h.blocks, t, X, V, z)}, sym(fp), hex)
  show by disj({2}, ex_intro({V}, {pair(p, y)}, taut(hv, hex2, e2)))
qed

// its C function value, its divergence, its machine code over any callees
contract __libc_malloc_impl mallocng_specs.malloc_impl_spec_fun by mp.mi call mp.mi_call

// ----------------------------------------------------------------------
//  The `malloc` symbol: lite_malloc.c's default_malloc, calling
//  __libc_malloc_impl -- the same purpose

theorem mp.dm_run(c, n, g, s, h, o): n in bits(64) -> mp.mi_call(c, g) -> s in abi.World -> h in mp.G ->
  mallocng.holds_m(c, h.A, s.vm, h.blocks) -> mallocng.shown_in(c, h.A, s.objs) -> mallocng.no_reserved(h.A) -> seq_len(h.A.taken) = 0 ->
  abi.thread_ok(s.vm, s.fs_base) -> mallocng_specs.tls_apart(c, h.A, s.fs_base) ->
  abi.brk_start_ok(s.vm) -> mallocng_specs.errno_ok(s.vm, s.objs, s.fs_base) -> mallocng_specs.errno_apart(c, h.A, s.vm, s.fs_base) ->
  runs(c_src_malloc_lite_malloc.default_malloc(n, g), s, o) -> mp.mi_out(c, h.A, n, h.blocks, s, o)
proof
  assume hnb hmi hw hh hin hsh hnr htk hth htl hbs heo hea hr
  have pu := apply(g.runs_univ, hr)
  have hu: s in univ(1) by simp(pu)
  have ths: gc.sound(s) by simp(hth)
  step t4 V r, e hR from hr with hmi using conj(hw, hu, ths, hnb, hh, hin, hsh, hnr, htk, hth, htl, hbs, heo, hea)
  have _ hx := hR
  obtain A2, hrt from hx
  have z: fst(r) = 0 && mp.mi_zero(c, h.A, h.blocks, s, A2, V) -> mp.mi_out(c, h.A, n, h.blocks, s, o) proof
    assume q
    have q0 qz := q
    show by disj({2}, ex_intro({A2}, {V}, taut(qz, rewrite(q0, e))))
  qed
  have k: !(fst(r) = 0) && mp.mi_blk(c, h.A, n, h.blocks, s, A2, V, fst(r)) -> mp.mi_out(c, h.A, n, h.blocks, s, o) proof
    assume q
    have _ qb := q
    show by disj({3}, ex_intro({A2}, {V}, {fst(r)}, taut(qb, e)))
  qed
  show by taut(hrt, z, k)
qed

theorem mp.dm: all c n g. n in bits(64) -> mp.mi_call(c, g) ->
  refines_ghost(c_src_malloc_lite_malloc.default_malloc(n, g), mallocng_specs.malloc_impl_spec(c, n), abi.World, mp.G)
proof
  fix c n g
  assume hnb hmi
  let P := c_src_malloc_lite_malloc.default_malloc(n, g)
  have rp: all s o. runs(P, s, o) -> pair(s, o) in univ(1) proof
    fix s o
    assume hr
    show := apply(g.runs_univ, expand(hr, c_src_malloc_lite_malloc.default_malloc))
  qed
  have rn: mp.mi_runs(c, n, P) proof
    fix s h o
    assume hw hh hin hsh hnr htk hth htl hbs heo hea hr
    show := apply(mp.dm_run[c := c, n := n, g := g, s := s, h := h, o := o], hnb, hmi, hw, hh, hin, hsh, hnr, htk, hth, htl, hbs, heo, hea, hr)
  qed
  show := apply(mp.mi_ref[c := c, n := n, P := P], hnb, rp, rn)
qed

// its C function value, its divergence, its machine code over any
// __libc_malloc_impl called as such
contract default_malloc mallocng_specs.malloc_impl_spec_fun by mp.dm
