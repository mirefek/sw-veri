        have th2 := apply(mp.tls_kept[c := c, A := A, b := B, V0 := V0, V1 := V2, fs := s.fs_base, e := empty], fsb, hth, htl, ko2, ne8)
        have ths2: gc.sound(W2) by simp(th2)
        // wrlock()
        have nl2 lf2 := apply(mp.locks_ok[c := c, A := A, vm := V2, b := B, objs := s.objs], hc, au, hat, hbt, v2v, hin2, hsh, hx, hlk, hlc)
        have nlw: mallocng_specs.need_locks_off(W2.vm, W2.objs, c_src_malloc_mallocng_malloc.__libc) by simp(rewrite(hlc, nl2))
        step V3 r3, e4 kx4 hR3 from e3 with mp.lck_q using conj(hwl, w2W, ths2, nlw)
        have v3v v3e0 := hR3
        have v3e: V3 = V2 by simp(v3e0)
        have ww3: fn_update(W2, "vm", V3) = W2 := trans(fn_update_twice[f := s, k := "vm", a := V2, b := V3], rewrite(v3e, refl({fn_update(s, "vm", V3)}), {2}))
        // step_seq(): the context's free bytes only
