        have ths5: gc.sound(W5) by simp(th5)
        have pth5: abi.thread_ok(W5.vm, W5.fs_base) by simp(th5, keep(abi.thread_ok))
        have hsh5s: mallocng.shown_in(c, A1, s.objs) by simp(hsh5)
