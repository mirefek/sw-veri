// __libc_malloc_impl by its purpose: n bytes for the client -- beyond the
// allocator's sizes, 0; a big request: a group of its own, mapped, its one
// slot framed for the block; else a slot of the request's class (an
// available one of its list's head, or alloc_slot's), framed. Its callees
// are parameters, each given by its contract at a call.
//
//   checked after proofs/mallocng/fun/munmap.core

// ----------------------------------------------------------------------
//  The locks' words: the invariant's

// (a data symbol's byte: of the image's, data's and auxv's ranges)
theorem mp.data_front(c, A, i, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> i in omega -> int_lt(i, 3) ->
  mallocng.in_range(a, mallocng.data_ranges(c)[i]) ->
  mallocng.in_ranges(a, seq_concat(seq_concat(mallocng.ro_ranges(c.file), mallocng.data_ranges(c)), mallocng.auxv_ranges(A)))
proof
  assume hc hu ha hi hil h
  have ro := apply(mp.ro_list, (c.file in seq_type(bits(8)) by simp(hc)))
  have cf: c.ctx in omega && c.lock in omega && c.libc in omega by simp(hc)
  have o1 := apply(tr.seq_one_type, (pair(c.ctx, mallocng.CTX_SIZE) in univ(1) by simp(cf)))
  have o2 := apply(tr.seq_one_type, (pair(c.lock, 4) in univ(1) by simp(cf)))
  have o3 := apply(tr.seq_one_type, (pair(c.libc, 16) in univ(1) by simp(cf)))
  have dl: mallocng.data_ranges(c) in list_type(univ(1)) by defs(apply(tr.concat_list, apply(tr.concat_list, o1, o2), o3), mallocng.data_ranges)
  have {xl = auxv} := apply(mp.front_pieces, hc, hu, ha)
  have dlen: seq_len(mallocng.data_ranges(c)) = 3 by defs(simp(), mallocng.data_ranges)
  have dx: ex x0. x0 in omega && (int_lt(x0, seq_len(mallocng.data_ranges(c))) && mallocng.in_range(a, mallocng.data_ranges(c)[x0]))
    by ex_intro({i}, taut(hi, (int_lt(i, seq_len(mallocng.data_ranges(c))) by arith(dlen, hil)), h))
  have d0: mallocng.in_ranges(a, mallocng.data_ranges(c)) by defs(dx, mallocng.in_ranges)
  have c1 := apply(mp.ranges_r, ro, dl, d0)
  show := apply(mp.ranges_l, apply(tr.concat_list, ro, dl), xl, c1)
qed

// (... not a free counter's: the invariant's, accessible -- no client's
// block there, no meta area, nothing reserved)
theorem mp.data_acc(c, A, vm, b, i, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  mallocng.holds_m(c, A, vm, b) -> i in omega -> int_lt(i, 3) -> a in omega -> mallocng.in_range(a, mallocng.data_ranges(c)[i]) -> !mallocng.ctx_free(c, a) ->
  a in mallocng.held(c, A, b) && mallocng.m_rw(mallocng.mview(vm, mallocng.held(c, A, b)), a) &&
  !(snd(mallocng.pg(mallocng.mview(vm, mallocng.held(c, A, b)), a)).kind = 2)
proof
  assume hc hu ha hb hh hi hil hao hr nf
  have {H = inv} := expand(hh, mallocng.holds_m)
  have {huo = used, hga = apart, po = perms} := expand(H, mallocng.holds)
  have pd _ _ := expand(po, mallocng.perms_ok)
  have fr := apply(mp.data_front, hc, hu, ha, hi, hil, hr)
  have nr := apply(mp.fixed_unres, hc, hu, ha, hao, huo, hga, taut(fr))
  have na: all k. k in omega -> int_lt(k, seq_len(A.areas)) -> !(int_le(A.areas[k], a) && int_lt(a, int_add(A.areas[k], 4096))) proof
    fix k
    assume hk hkl
    assume hp
    have {d = data} := apply(mp.area_apart[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, brk := vm.brk, k := k, a := a],
      hc, hu, ha, H, hk, hkl, hao, taut(hp), taut(hp))
    show by taut(mp(all_elim(d, {i}), hi, hil), hr)
  qed
  have nt := apply(mp.untaken_of, hc, hu, ha, H, hao, na)
  have nl: !(a in malloc.live_of(b)) proof
    assume hl
    obtain g, hg hir from apply(mp.live_grp[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, brk := vm.brk, a := a], ha, hb, H, hl)
    obtain k, hk hkl hke from expand(hg, mallocng.is_used)
    have ir: mallocng.in_range(a, mallocng.group_range(A.metas[A.used[k]])) := rewrite(sym(hke), hir)
    have nx := mp(all_elim(expand(hga, mallocng.groups_apart), {k}, {a}), conj(hk, hao), conj(hkl, ir))
    show by taut(nx, apply(mp.fixed_in[c := c, A := A, a := a], hc, hu, ha, taut(fr)))
  qed
  have fp0 := apply(mp.fp_intro, hc, hu, ha, hao, nl, nr, nt, taut(fr))
  have fp := apply(mp.held_intro, fp0, nf)
  have r1 r2 := expand(hr, mallocng.in_range)
  have rw := mp(all_elim(pd, {i}, {a}), conj(hi, hao), (int_lt(i, 3) && int_le(fst(mallocng.data_ranges(c)[i]), a) &&
    int_lt(a, int_add(fst(mallocng.data_ranges(c)[i]), snd(mallocng.data_ranges(c)[i]))) && !mallocng.ctx_free(c, a) by taut(hil, r1, r2, nf)))
  show by taut(fp, rw)
qed

// libc's need_locks byte 0, the lock word 0 (the invariant's image): the
// locks' requirements
theorem mp.locks_ok(c, A, vm, b, objs): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  vm in x86_64_linux.Vm -> mallocng.holds_m(c, A, vm, b) -> mallocng.shown_in(c, A, objs) ->
  c.ctx = c_src_malloc_mallocng_malloc.__malloc_context -> c.lock = c_src_malloc_mallocng_malloc.__malloc_lock -> c.libc = c_src_malloc_mallocng_malloc.__libc ->
  mallocng_specs.need_locks_off(vm, objs, c.libc) && mallocng_specs.lock_free(vm, objs, c.lock)
proof
  assume hc hu ha hb hv hh hsh hcx hlk hlc
  let FP := mallocng.held(c, A, b)
  let M := mallocng.mview(vm, FP)
  have cx: c.ctx = 4227328 by defs(simp(hcx), c_src_malloc_mallocng_malloc.__malloc_context)
  have lk: c.lock = 4227300 by defs(simp(hlk), c_src_malloc_mallocng_malloc.__malloc_lock)
  have lc: c.libc = 4227136 by defs(simp(hlc), c_src_malloc_mallocng_malloc.__libc)
  have {H = inv} := expand(hh, mallocng.holds_m)
  have {himg = image} := expand(H, mallocng.holds)
  have {nlk = need_locks, wlk = lock} := expand(himg, mallocng.image_ok)
  have VS := apply(mp.held_vis[c := c, A := A, objs := objs, b := b], hsh)
  have hvb: vm.bytes in fn_space(bits(64), bits(8)) by simp(hv)
  have d0 d1 d2 := mp.data_at[c := c]
  have lnl: mallocng.L_NEED_LOCKS = 3 by defs(simp(), mallocng.L_NEED_LOCKS)
  // (below the context: no free counter's byte)
  have nf: all a. a in omega -> int_lt(a, c.ctx) -> !mallocng.ctx_free(c, a) proof
    fix a
    assume hao hl
    show by defs(arith(hao, hl), mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK)
  qed
  // libc's need_locks byte
  let NL := int_add(c.libc, 3)
  have nlo: NL in omega by arith(lc)
  have nlr: mallocng.in_range(NL, mallocng.data_ranges(c)[2]) by defs(simp(d2, (int_lt(NL, int_add(c.libc, 16)) by arith(lc))), mallocng.in_range)
  have f2 m2 k2 := apply(mp.data_acc[c := c, A := A, vm := vm, b := b, i := 2, a := NL], hc, hu, ha, hb, hh, simp(), simp(), nlo, nlr,
    mp(all_elim(nf, {NL}), nlo, (int_lt(NL, c.ctx) by arith(lc, cx))))
  have mm2 := expand(m2, mallocng.m_rw)
  have one0: all i. i in omega -> int_lt(i, 1) -> i = 0 proof
    fix i
    assume hi hil
    show by arith(hi, hil)
  qed
  have u1 := apply(mp.view_usable[vm := vm, fp := FP, objs := objs, a := NL, n := 1], nlo,
    (all i. i in omega -> int_lt(i, 1) -> int_add(NL, i) in FP && mallocng.m_mapped(M, int_add(NL, i)) &&
       snd(mallocng.pg(M, int_add(NL, i))).prot.r && !(snd(mallocng.pg(M, int_add(NL, i))).kind = 2) by simp(f2, mm2, k2, one0)), VS)
  have v1 := apply(mp.view_read[vm := vm, fp := FP, a := NL, n := 1], nlo, simp(), simp(), (all i. i in omega -> int_lt(i, 1) -> int_add(NL, i) in FP by simp(f2, one0)))
  have _ bvo := apply(mp.b8_view[vm := vm, fp := FP, a := NL], hvb, nlo, f2)
  have r1: mallocng.rd(M, NL, 1) = mallocng.b8(M, NL) by defs(simp(bvo), mallocng.rd)
  have z1: mallocng.b8(M, NL) = 0 := rewrite(lnl, nlk)
  have ba: bits_add(64, c.libc, 3) = NL by simp(lc)
  have zb: gimple.bytes_at(vm, bits_add(64, c.libc, 3), 1) = 0 := rewrite(sym(ba), trans(v1, trans(r1, z1)))
  // the lock word
  have lw: all i. i in omega -> int_lt(i, 4) -> int_add(c.lock, i) in FP && mallocng.m_rw(M, int_add(c.lock, i)) &&
      !(snd(mallocng.pg(M, int_add(c.lock, i))).kind = 2) proof
    fix i
    assume hi hil
    have ao: int_add(c.lock, i) in omega by arith(lk, hi)
    have inr: mallocng.in_range(int_add(c.lock, i), mallocng.data_ranges(c)[1]) by defs(simp(d1, (int_lt(int_add(c.lock, i), int_add(c.lock, 4)) by arith(lk, hi, hil)), lk, hi), mallocng.in_range)
    show := apply(mp.data_acc[c := c, A := A, vm := vm, b := b, i := 1, a := int_add(c.lock, i)], hc, hu, ha, hb, hh, simp(), simp(), ao, inr,
      mp(all_elim(nf, {int_add(c.lock, i)}), ao, (int_lt(int_add(c.lock, i), c.ctx) by arith(lk, cx, hil, hi))))
  qed
  have lo: c.lock in omega by arith(lk)
  have lr: all i. i in omega -> int_lt(i, 4) -> int_add(c.lock, i) in FP && mallocng.m_mapped(M, int_add(c.lock, i)) &&
      snd(mallocng.pg(M, int_add(c.lock, i))).prot.r && !(snd(mallocng.pg(M, int_add(c.lock, i))).kind = 2) proof
    fix i
    assume hi hil
    have f m k := mp(all_elim(lw, {i}), hi, hil)
    have mm := expand(m, mallocng.m_rw)
    show by taut(f, mm, k)
  qed
  have u4 := apply(mp.view_usable[vm := vm, fp := FP, objs := objs, a := c.lock, n := 4], lo, lr, VS)
  have v4 := apply(mp.view_read[vm := vm, fp := FP, a := c.lock, n := 4], lo, simp(), simp(), (all i. i in omega -> int_lt(i, 4) -> int_add(c.lock, i) in FP by simp(lw)))
  have zl: gimple.bytes_at(vm, c.lock, 4) = 0 := trans(v4, wlk)
  have p1: !(c.libc = 0) && int_le(int_add(c.libc, 4), int_pow(2, 64)) by simp(lc)
  have p2: !(c.lock = 0) && int_le(int_add(c.lock, 4), int_pow(2, 64)) by simp(lk)
  unfold mallocng_specs.need_locks_off mallocng_specs.lock_free
  show by taut(p1, p2, u1, zb, u4, zl)
qed

// ----------------------------------------------------------------------
//  The locks' contracts at a call (single-threaded: nothing done)

// rdlock(), wrlock(): need_locks off -- an overflow, or the memory as it was
theorem mp.lck_q: all t libc regs o2. t in abi.World -> mallocng_specs.need_locks_off(t.vm, t.objs, libc) ->
  gc.regs_ok(regs, empty) -> runs(mallocng_specs.lock_spec_fun(libc)[regs], t, o2) ->
  abi.ovf_out(t, o2) || (ex V r. (V in x86_64_linux.Vm && V = t.vm) && o2 = ok(fn_update(t, "vm", V), r))
proof
  fix t libc regs o2
  assume hw hf hro h
  let OVF := exc_val("stack_overflow", empty)
  have rl rn := apply(gc.regs0, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, mallocng_specs.lock_spec_fun, app_fn_build, ra in h
  have b := apply(g.runs_elim, h)
  obtain o3, hs3 hk3 from expand(b, bind_rel)
  have vV vfun vdom .. := apply(ms.world_parts, hw)
  have ss: fn_update(t, "vm", t.vm) = t := mp(fn_update_same[f := t, k := "vm"], vfun, vdom)
  have ci := apply(ct.contract_inv, expand(hs3, mallocng_specs.lock_spec), hf, vV)
  have c1: abi.ovf_out(t, o3) -> abi.ovf_out(t, o2) proof
    assume hx
    obtain v ob, hv hob ho from hx
    have e2: o2 = exc(fn_update(fn_update(t, "vm", v), "objs", ob), OVF) by simp(rewrite(ho, hk3))
    show by ex_intro({v}, {ob}, taut(hv, hob, e2))
  qed
  have c2: (ex x2. letin(fn_update(t, "vm", t.vm), x3. x2 = ok(pair(x3, empty), empty)) &&
      ((fst(x2) = 0 && o3 = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && o3 = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
        ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && o3 = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && o3 = diverge(snd(x2)))))) ->
      (ex V r. (V in x86_64_linux.Vm && V = t.vm) && o2 = ok(fn_update(t, "vm", V), r)) proof
    assume hx
    obtain x2, hB hout from hx
    have x2e: x2 = ok(pair(t, empty), empty) by simp(expand(hB, letin), ss)
    have ho: o3 = ok(t, empty) by simp(rewrite(x2e, hout))
    have k5: any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o2 = ok(t, pair(x5, x6)))) by simp(rewrite(ho, hk3), keep(any_rel))
    have nb: ex y. y in bits(64) by ex_intro({0}, simp())
    obtain y1, hy1 k6 from apply(g.any_e, nb, k5)
    obtain y2, hy2 k7 from apply(g.any_e, nb, k6)
    have k8: o2 = ok(fn_update(t, "vm", t.vm), pair(y1, y2)) := rewrite(sym(ss), k7, {1})
    show by ex_intro({t.vm}, {pair(y1, y2)}, taut(vV, refl({t.vm}), k8))
  qed
  show by taut(ci, c1, c2)
qed

// unlock(): the lock free, the thread sound -- the same
theorem mp.ul0_q: all t lk regs o2. t in abi.World -> mallocng_specs.lock_free(t.vm, t.objs, lk) -> abi.thread_ok(t.vm, t.fs_base) ->
  gc.regs_ok(regs, empty) -> runs(mallocng_specs.unlock_spec_fun(lk)[regs], t, o2) ->
  abi.ovf_out(t, o2) || (ex V r. (V in x86_64_linux.Vm && V = t.vm) && o2 = ok(fn_update(t, "vm", V), r))
proof
  fix t lk regs o2
  assume hw hf ht hro h
  let OVF := exc_val("stack_overflow", empty)
  have rl rn := apply(gc.regs0, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, mallocng_specs.unlock_spec_fun, app_fn_build, ra in h
  have b := apply(g.runs_elim, h)
  obtain o3, hs3 hk3 from expand(b, bind_rel)
  have vV vfun vdom .. := apply(ms.world_parts, hw)
  have ss: fn_update(t, "vm", t.vm) = t := mp(fn_update_same[f := t, k := "vm"], vfun, vdom)
  have pre: mallocng_specs.lock_free(t.vm, t.objs, lk) && abi.thread_ok(t.vm, t.fs_base) by taut(hf, ht)
  have ci := apply(ct.contract_inv, expand(hs3, mallocng_specs.unlock_spec), pre, vV)
  have c1: abi.ovf_out(t, o3) -> abi.ovf_out(t, o2) proof
    assume hx
    obtain v ob, hv hob ho from hx
    have e2: o2 = exc(fn_update(fn_update(t, "vm", v), "objs", ob), OVF) by simp(rewrite(ho, hk3))
    show by ex_intro({v}, {ob}, taut(hv, hob, e2))
  qed
  have c2: (ex x2. letin(fn_update(t, "vm", t.vm), x3. x2 = ok(pair(x3, empty), empty)) &&
      ((fst(x2) = 0 && o3 = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && o3 = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
        ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && o3 = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && o3 = diverge(snd(x2)))))) ->
      (ex V r. (V in x86_64_linux.Vm && V = t.vm) && o2 = ok(fn_update(t, "vm", V), r)) proof
    assume hx
    obtain x2, hB hout from hx
    have x2e: x2 = ok(pair(t, empty), empty) by simp(expand(hB, letin), ss)
    have ho: o3 = ok(t, empty) by simp(rewrite(x2e, hout))
    have k5: any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o2 = ok(t, pair(x5, x6)))) by simp(rewrite(ho, hk3), keep(any_rel))
    have nb: ex y. y in bits(64) by ex_intro({0}, simp())
    obtain y1, hy1 k6 from apply(g.any_e, nb, k5)
    obtain y2, hy2 k7 from apply(g.any_e, nb, k6)
    have k8: o2 = ok(fn_update(t, "vm", t.vm), pair(y1, y2)) := rewrite(sym(ss), k7, {1})
    show by ex_intro({t.vm}, {pair(y1, y2)}, taut(vV, refl({t.vm}), k8))
  qed
  show by taut(ci, c1, c2)
qed

// upgradelock(): the same, no requirement
theorem mp.ugl_q: all t regs o2. t in abi.World -> gc.regs_ok(regs, empty) -> runs(mallocng_specs.upgradelock_spec_fun()[regs], t, o2) ->
  abi.ovf_out(t, o2) || (ex V r. (V in x86_64_linux.Vm && V = t.vm) && o2 = ok(fn_update(t, "vm", V), r))
proof
  fix t regs o2
  assume hw hro h
  let OVF := exc_val("stack_overflow", empty)
  have rl rn := apply(gc.regs0, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, mallocng_specs.upgradelock_spec_fun, app_fn_build, ra in h
  have b := apply(g.runs_elim, h)
  obtain o3, hs3 hk3 from expand(b, bind_rel)
  have vV vfun vdom .. := apply(ms.world_parts, hw)
  have ss: fn_update(t, "vm", t.vm) = t := mp(fn_update_same[f := t, k := "vm"], vfun, vdom)
  have ci := apply(ct.contract_inv0, expand(hs3, mallocng_specs.upgradelock_spec), vV)
  have c1: abi.ovf_out(t, o3) -> abi.ovf_out(t, o2) proof
    assume hx
    obtain v ob, hv hob ho from hx
    have e2: o2 = exc(fn_update(fn_update(t, "vm", v), "objs", ob), OVF) by simp(rewrite(ho, hk3))
    show by ex_intro({v}, {ob}, taut(hv, hob, e2))
  qed
  have c2: (ex x2. letin(fn_update(t, "vm", t.vm), x3. x2 = ok(pair(x3, empty), empty)) &&
      ((fst(x2) = 0 && o3 = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && o3 = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
        ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && o3 = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && o3 = diverge(snd(x2)))))) ->
      (ex V r. (V in x86_64_linux.Vm && V = t.vm) && o2 = ok(fn_update(t, "vm", V), r)) proof
    assume hx
    obtain x2, hB hout from hx
    have x2e: x2 = ok(pair(t, empty), empty) by simp(expand(hB, letin), ss)
    have ho: o3 = ok(t, empty) by simp(rewrite(x2e, hout))
    have k5: any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o2 = ok(t, pair(x5, x6)))) by simp(rewrite(ho, hk3), keep(any_rel))
    have nb: ex y. y in bits(64) by ex_intro({0}, simp())
    obtain y1, hy1 k6 from apply(g.any_e, nb, k5)
    obtain y2, hy2 k7 from apply(g.any_e, nb, k6)
    have k8: o2 = ok(fn_update(t, "vm", t.vm), pair(y1, y2)) := rewrite(sym(ss), k7, {1})
    show by ex_intro({t.vm}, {pair(y1, y2)}, taut(vV, refl({t.vm}), k8))
  qed
  show by taut(ci, c1, c2)
qed

// ----------------------------------------------------------------------
//  size_overflows' and munmap's contracts at a call

// size_overflows(n): beyond the allocator's sizes, errno ENOMEM, 1; else
// nothing, 0
theorem mp.sov_q: all t n regs o2. t in abi.World -> t in univ(1) -> n in bits(64) -> mallocng_specs.size_overflows_pre(t.vm, t.objs, t.fs_base, n) ->
  gc.regs_ok(regs, seq_one(gimple.arg(64, n))) -> runs(mallocng_specs.size_overflows_spec_fun[regs], t, o2) ->
  abi.ovf_out(t, o2) ||
  (ex V r. (V in x86_64_linux.Vm &&
     ((int_lt(9223372036854771710, n) && V = mallocng_specs.wr32(t.vm, mallocng_specs.errno_at(t.fs_base), 12) && bits_of_int(32, fst(r)) = 1) ||
      (!int_lt(9223372036854771710, n) && V = t.vm && bits_of_int(32, fst(r)) = 0))) && o2 = ok(fn_update(t, "vm", V), r))
proof
  fix t n regs o2
  assume hw htu hnb hpre hro h
  let OVF := exc_val("stack_overflow", empty)
  have rl rn r0 := apply(gc.regs1, hnb, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, mallocng_specs.size_overflows_spec_fun, app_fn_build, ra in h
  have o1l: ord_le(1, seq_len(regs)) by defs(simp(rn), ord_le)
  have bp: bits_of_int(64, regs[0]) = n by defs(simp(r0, hnb), bits_of_int, pow2)
  have b := rewrite(bp, apply(g.runs_elim, h))
  have b2: bind_rel(mallocng_specs.size_overflows_spec(n), t, x0 x1. letin(x1, x2. bind_rel(gimple.result(32, x2), x0, x3 x4. letin(x4, x5. any_rel(x6. x6 in bits(64),
      x6. o2 = ok(x3, pair(x5, x6)))), x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3))), x0 x1. o2 = exc(x0, x1), x0. o2 = diverge(x0)) by taut(b, o1l)
  obtain o3, hs3 hk3 from expand(b2, bind_rel)
  have pv pf pd _ := apply(ms.world_parts, hw)
  have ci0 := apply(ct.contract_inv, expand(hs3, mallocng_specs.size_overflows_spec), hpre, pv)
  let W1 := fn_update(t, "vm", mallocng_specs.wr32(t.vm, mallocng_specs.errno_at(t.fs_base), 12))
  have ci: abi.ovf_out(t, o3) || (int_lt(9223372036854771710, n) && o3 = ok(W1, 1)) || (!int_lt(9223372036854771710, n) && o3 = ok(t, 0))
    by simp(ci0, keep(mallocng_specs.wr32, mallocng_specs.errno_at))
  have ss: fn_update(t, "vm", t.vm) = t := mp(fn_update_same[f := t, k := "vm"], pf, pd)
  have ne: ex z. z in bits(64) by ex_intro({0}, simp())
  // (a 32-bit result v from state W: the call's)
  have res: all W v. v in bits(32) -> o3 = ok(W, v) -> ex r. o2 = ok(W, r) && bits_of_int(32, fst(r)) = v proof
    fix W v
    assume hv hx
    have k1: bind_rel(gimple.result(32, v), W, x3 x4. letin(x4, x5. any_rel(x6. x6 in bits(64), x6. o2 = ok(x3, pair(x5, x6)))), x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3))
      by simp(expand(rewrite(hx, hk3), letin), keep(bind_rel, gimple.result))
    obtain o4, hr4 hk4 from expand(k1, bind_rel)
    obtain u, hu hbu ho4 from apply(g.result32_inv, hv, hr4)
    have k2: any_rel(x6. x6 in bits(64), x6. o2 = ok(W, pair(u, x6))) by simp(expand(rewrite(ho4, hk4), letin), keep(any_rel))
    obtain z, _ hoz from apply(g.any_e, ne, k2)
    show by ex_intro({pair(u, z)}, taut(hoz, (bits_of_int(32, fst(pair(u, z))) = v by simp(hbu))))
  qed
  have c1: abi.ovf_out(t, o3) -> abi.ovf_out(t, o2) proof
    assume x
    obtain v ob, hv hob hx from x
    have oe: o2 = exc(fn_update(fn_update(t, "vm", v), "objs", ob), OVF) by simp(rewrite(hx, hk3))
    show by ex_intro({v}, {ob}, taut(hv, hob, oe))
  qed
  let EW := mallocng_specs.wr32(t.vm, mallocng_specs.errno_at(t.fs_base), 12)
  let G := ex V r. (V in x86_64_linux.Vm &&
    ((int_lt(9223372036854771710, n) && V = EW && bits_of_int(32, fst(r)) = 1) ||
     (!int_lt(9223372036854771710, n) && V = t.vm && bits_of_int(32, fst(r)) = 0))) && o2 = ok(fn_update(t, "vm", V), r)
  have c2: int_lt(9223372036854771710, n) && o3 = ok(W1, 1) -> G proof
    assume x
    have hl hx := x
    obtain r, hor hr from mp(all_elim(res, {W1}, {1}), simp(), hx)
    show by ex_intro({EW}, {r}, taut(apply(mp.w32_vm[V := t.vm, c := mallocng_specs.errno_at(t.fs_base), v := 12], pv), hl, refl({EW}), hr, hor))
  qed
  have c3: !int_lt(9223372036854771710, n) && o3 = ok(t, 0) -> G proof
    assume x
    have hl hx := x
    obtain r, hor hr from mp(all_elim(res, {t}, {0}), simp(), hx)
    have hor2: o2 = ok(fn_update(t, "vm", t.vm), r) := rewrite(sym(ss), hor, {1})
    show by ex_intro({t.vm}, {r}, taut(pv, hl, refl({t.vm}), hr, hor2))
  qed
  show by taut(ci, c1, c2, c3)
qed

// munmap(a, l): an overflow; EINVAL, errno set; else the pages gone
theorem mp.mun_q: all t a l regs o2. t in abi.World -> t in univ(1) -> a in bits(64) -> l in bits(64) ->
  mallocng_specs.errno_ok(t.vm, t.objs, t.fs_base) -> gimple.sys_pages_ok(t.vm, t.objs, x86_64_linux.page_of(a), x86_64_linux.pages_for(l)) ->
  mallocng_specs.tls_off(t.fs_base, x86_64_linux.page_of(a), x86_64_linux.pages_for(l)) ->
  gc.regs_ok(regs, seq_concat(seq_one(gimple.arg(64, a)), seq_one(gimple.arg(64, l)))) ->
  runs(mallocng_specs.munmap_spec_fun()[regs], t, o2) ->
  abi.ovf_out(t, o2) ||
  (ex V r. (V in x86_64_linux.Vm &&
     ((tr.unmap_inval(a, l) && V = mallocng_specs.wr32(t.vm, mallocng_specs.errno_at(t.fs_base), x86_64_linux.EINVAL)) ||
      (!tr.unmap_inval(a, l) && gimple.gone_pages(t.vm, V, x86_64_linux.page_of(a), x86_64_linux.pages_for(l)) && V.brk = t.vm.brk))) &&
     o2 = ok(fn_update(t, "vm", V), r))
proof
  fix t a l regs o2
  assume hw htu ha hl he hsp htf hro h
  let OVF := exc_val("stack_overflow", empty)
  have rl rn r0 r1 := apply(gc.regs2, ha, hl, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, mallocng_specs.munmap_spec_fun, app_fn_build, ra in h
  have o2l: ord_le(2, seq_len(regs)) by defs(simp(rn), ord_le)
  have b0: bits_of_int(64, regs[0]) = a by defs(simp(r0, ha), bits_of_int, pow2)
  have b1: bits_of_int(64, regs[1]) = l by defs(simp(r1, hl), bits_of_int, pow2)
  have b := rewrite(b1, rewrite(b0, apply(g.runs_elim, h)))
  have b2: bind_rel(mallocng_specs.munmap_spec(a, l), t, x0 x1. letin(x1, x2. bind_rel(gimple.result(32, x2), x0, x3 x4. letin(x4, x5. any_rel(x6. x6 in bits(64),
      x6. o2 = ok(x3, pair(x5, x6)))), x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3))), x0 x1. o2 = exc(x0, x1), x0. o2 = diverge(x0)) by taut(b, o2l)
  obtain o3, hs3 hk3 from expand(b2, bind_rel)
  have pv pf pd _ := apply(ms.world_parts, hw)
  have pre: mallocng_specs.errno_ok(t.vm, t.objs, t.fs_base) && gimple.sys_pages_ok(t.vm, t.objs, x86_64_linux.page_of(a), x86_64_linux.pages_for(l)) &&
    mallocng_specs.tls_off(t.fs_base, x86_64_linux.page_of(a), x86_64_linux.pages_for(l)) by taut(he, hsp, htf)
  have ci0 := apply(ct.contract_inv, expand(hs3, mallocng_specs.munmap_spec), pre, pv)
  let WE := fn_update(t, "vm", mallocng_specs.wr32(t.vm, mallocng_specs.errno_at(t.fs_base), x86_64_linux.EINVAL))
  let M1 := bits_of_int(32, int_sub(int_pow(2, 32), 1))
  have gx := apply(g.gone_ex[before := t.vm, p := x86_64_linux.page_of(a), n := x86_64_linux.pages_for(l), br := t.vm.brk], pv, apply(x86.vm_univ, pv),
    (t.vm.brk in bits(64) by simp(pv)))
  have ci: abi.ovf_out(t, o3) || (tr.unmap_inval(a, l) && o3 = ok(WE, M1)) ||
      (ex V. (!tr.unmap_inval(a, l) && V in x86_64_linux.Vm && gimple.gone_pages(t.vm, V, x86_64_linux.page_of(a), x86_64_linux.pages_for(l)) && V.brk = t.vm.brk) &&
         o3 = ok(fn_update(t, "vm", V), 0))
    by simp(ci0, gx, keep(mallocng_specs.wr32, mallocng_specs.errno_at, gimple.gone_pages, x86_64_linux.page_of, x86_64_linux.pages_for, x86_64_linux.PAGE,
      x86_64_linux.TASK_SIZE, x86_64_linux.EINVAL))
  have ne: ex z. z in bits(64) by ex_intro({0}, simp())
  // (a 32-bit result v from state W: the call's)
  have res: all W v. v in bits(32) -> o3 = ok(W, v) -> ex r. o2 = ok(W, r) proof
    fix W v
    assume hv hx
    have k1: bind_rel(gimple.result(32, v), W, x3 x4. letin(x4, x5. any_rel(x6. x6 in bits(64), x6. o2 = ok(x3, pair(x5, x6)))), x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3))
      by simp(expand(rewrite(hx, hk3), letin), keep(bind_rel, gimple.result))
    obtain o4, hr4 hk4 from expand(k1, bind_rel)
    obtain u, hu hbu ho4 from apply(g.result32_inv, hv, hr4)
    have k2: any_rel(x6. x6 in bits(64), x6. o2 = ok(W, pair(u, x6))) by simp(expand(rewrite(ho4, hk4), letin), keep(any_rel))
    obtain z, _ hoz from apply(g.any_e, ne, k2)
    show by ex_intro({pair(u, z)}, hoz)
  qed
  have c1: abi.ovf_out(t, o3) -> abi.ovf_out(t, o2) proof
    assume x
    obtain v ob, hv hob hx from x
    have oe: o2 = exc(fn_update(fn_update(t, "vm", v), "objs", ob), OVF) by simp(rewrite(hx, hk3))
    show by ex_intro({v}, {ob}, taut(hv, hob, oe))
  qed
  let EV := mallocng_specs.wr32(t.vm, mallocng_specs.errno_at(t.fs_base), x86_64_linux.EINVAL)
  let G := ex V r. (V in x86_64_linux.Vm &&
    ((tr.unmap_inval(a, l) && V = EV) ||
     (!tr.unmap_inval(a, l) && gimple.gone_pages(t.vm, V, x86_64_linux.page_of(a), x86_64_linux.pages_for(l)) && V.brk = t.vm.brk))) &&
    o2 = ok(fn_update(t, "vm", V), r)
  have c2: tr.unmap_inval(a, l) && o3 = ok(WE, M1) -> G proof
    assume x
    have hi hx := x
    obtain r, hor from mp(all_elim(res, {WE}, {M1}), simp(), hx)
    show by ex_intro({EV}, {r}, taut(apply(mp.w32_vm[V := t.vm, c := mallocng_specs.errno_at(t.fs_base), v := x86_64_linux.EINVAL], pv), hi, refl({EV}), hor))
  qed
  have c3: (ex V. (!tr.unmap_inval(a, l) && V in x86_64_linux.Vm && gimple.gone_pages(t.vm, V, x86_64_linux.page_of(a), x86_64_linux.pages_for(l)) && V.brk = t.vm.brk) &&
      o3 = ok(fn_update(t, "vm", V), 0)) -> G proof
    assume x
    obtain V, hV1 hV2 hV3 hV4 hx from x
    obtain r, hor from mp(all_elim(res, {fn_update(t, "vm", V)}, {0}), simp(), hx)
    show by ex_intro({V}, {r}, taut(hV1, hV2, hV3, hV4, hor))
  qed
  show by taut(ci, c1, c2, c3)
qed

// ----------------------------------------------------------------------
//  A request's slot within its class's (enframe's requirement)

// slot idx of a group of class s taken for a request of n bytes, of class
// s0 (s = s0, or s0 + 1 for an even s0): the frame's end within the
// class's slot -- or the slot a page or more past its start. A group of
// the class's slots: so; one mapped on its own, shorter than two of the
// class's slots (the invariant's `span`), a page or more -- or one page,
// of a class past 2040 bytes, its request past 2028
theorem mp.cls_bound(V, s0, idx, n): V in mallocng.MetaV -> int_lt(V.sizeclass, 48) ->
  int_lt(mallocng.stride(V), int_mul(2, int_mul(mallocng.UNIT, mallocng.size_classes[V.sizeclass]))) ->
  idx in omega -> int_le(idx, V.last_idx) -> n in omega -> s0 in omega -> mallocng_specs.class_of(n, s0) ->
  (V.sizeclass = s0 || (V.sizeclass = int_add(s0, 1) && int_mod(s0, 2) = 0)) ->
  int_lt(int_sub(int_sub(mallocng.slot_end(V, idx), n), mallocng.storage(V)), int_mul(int_mul(mallocng.UNIT, mallocng.size_classes[V.sizeclass]), int_add(idx, 1))) ||
  int_le(int_add(int_sub(mallocng.slot_start(V, idx), mallocng.storage(V)), int_mul(256, mallocng.UNIT)), int_mul(int_mul(mallocng.UNIT, mallocng.size_classes[V.sizeclass]), int_add(idx, 1)))
proof
  assume hv hs hsp hi hil hn hs0 hcl hrel
  let s := V.sizeclass
  let Z := int_mul(mallocng.UNIT, mallocng.size_classes[s])
  let S := mallocng.stride(V)
  have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
  have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
  have so: s in omega by simp(hv)
  have lo: V.last_idx in omega by simp(hv)
  have mo: V.maplen in omega by simp(hv)
  have zo _ := mp(all_elim(ms.sc_nat, {s}), so, hs)
  have e1: int_sub(int_sub(mallocng.slot_end(V, idx), n), mallocng.storage(V)) = int_sub(int_sub(int_add(int_mul(S, idx), S), 4), n)
    by defs(arith(ci), mallocng.slot_end, mallocng.slot_start)
  have e2: int_sub(mallocng.slot_start(V, idx), mallocng.storage(V)) = int_mul(S, idx) by defs(arith(), mallocng.slot_start)
  // (a group of the class's slots)
  have ca: !(V.last_idx = 0 && int_lt(0, V.maplen)) ->
      int_lt(int_sub(int_sub(int_add(int_mul(S, idx), S), 4), n), int_mul(Z, int_add(idx, 1))) proof
    assume h
    have es: S = Z by defs(simp(h), mallocng.stride)
    show by arith(es, hn, hi)
  qed
  // (one slot mapped on its own)
  have cb: V.last_idx = 0 && int_lt(0, V.maplen) ->
      int_lt(int_sub(int_sub(int_add(int_mul(S, idx), S), 4), n), int_mul(Z, int_add(idx, 1))) || int_le(int_add(int_mul(S, idx), int_mul(256, mallocng.UNIT)), int_mul(Z, int_add(idx, 1))) proof
    assume h
    have h0 hm := h
    have es: S = int_sub(int_mul(V.maplen, 4096), 16) by defs(simp(h0, hm, cu), mallocng.stride)
    have i0: idx = 0 by arith(hi, hil, h0)
    have pg: !int_lt(Z, 4096) -> int_le(int_add(int_mul(S, idx), int_mul(256, mallocng.UNIT)), int_mul(Z, int_add(idx, 1))) proof
      assume hz
      show by arith(i0, hz, cu)
    qed
    have sp: int_lt(Z, 4096) -> int_lt(int_sub(int_sub(int_add(int_mul(S, idx), S), 4), n), int_mul(Z, int_add(idx, 1))) proof
      assume hz
      have s4: S = 4080 by arith(es, hsp, hz, hm, mo, cu, zo)
      have zl: int_lt(127, mallocng.size_classes[s]) by arith(hsp, s4, cu, zo)
      have v23: mallocng.size_classes[23] = 127 by simp(at({mallocng.size_classes[23]}))
      have nsl: int_le(s, 23) -> false proof
        assume hl
        have mn := mp(all_elim(ms.sc_mono, {s}, {23}), so, simp(), hl, simp())
        show by arith(mn, v23, zl)
      qed
      have sl: int_le(24, s) by arith(nsl, so)
      have l23: int_lt(23, s0) by arith(hrel, sl, hs0)
      have _ _ c3 := expand(hcl, mallocng_specs.class_of)
      have nb := mp(all_elim(c3, {23}), simp(), l23)
      show by arith(i0, s4, rewrite(v23, nb), zl, hn, cu)
    qed
    show by taut(pg, sp)
  qed
  have g := (int_lt(int_sub(int_sub(int_add(int_mul(S, idx), S), 4), n), int_mul(Z, int_add(idx, 1))) ||
    int_le(int_add(int_mul(S, idx), int_mul(256, mallocng.UNIT)), int_mul(Z, int_add(idx, 1))) by taut(ca, cb))
  show := rewrite(sym(e2), rewrite(sym(e1), g))
qed

// ----------------------------------------------------------------------
//  A big request's mapping

// (mmap of N bytes at a place p it chose: its K pages unmapped before, in
// user space; the pages mapped before as they were, their bytes too; the
// new bytes 0 -- mp.mm_fresh for any length)
theorem mp.mm_fresh_n(V3, V4, p, N, PG, objs): p in omega -> N in omega -> int_lt(0, N) ->
  mallocng_specs.mmap_place(V3, 0, N, bits_of_int(32, 34), p) -> gimple.fresh_pages(V3, V4, objs, p, x86_64_linux.pages_for(N), PG) ->
  npg: (x86_64_linux.pages_for(N) in omega && int_le(N, int_mul(x86_64_linux.pages_for(N), 4096)) && int_lt(int_mul(x86_64_linux.pages_for(N), 4096), int_add(N, 4096)) &&
    int_le(1, x86_64_linux.pages_for(N))) &&
  one: int_le(1, p) && low: int_le(int_add(int_mul(p, 4096), int_mul(x86_64_linux.pages_for(N), 4096)), 140737488351232) &&
  unm: (all q. q in omega -> int_le(p, q) -> int_lt(q, int_add(p, x86_64_linux.pages_for(N))) -> !x86_64_linux.mapped(V3, q)) &&
  pages: (all q. q in omega -> x86_64_linux.mapped(V3, q) -> V4.pages[q] = V3.pages[q]) &&
  newpg: (all q. q in omega -> int_le(p, q) -> int_lt(q, int_add(p, x86_64_linux.pages_for(N))) -> V4.pages[q] = some(PG)) &&
  bytes: (all y. y in bits(64) -> x86_64_linux.mapped(V3, int_div(y, x86_64_linux.PAGE)) -> V4.bytes[y] = V3.bytes[y]) &&
  zero: (all y. y in bits(64) -> int_le(int_mul(p, 4096), y) -> int_lt(y, int_mul(int_add(p, x86_64_linux.pages_for(N)), 4096)) -> V4.bytes[y] = 0) &&
  top: V4.stack_top = V3.stack_top && lim: V4.stack_limit = V3.stack_limit && start: V4.brk_start = V3.brk_start
proof
  assume hp hn hnz hpl hfr
  have pg: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
  let NP := x86_64_linux.pages_for(N)
  have nf: NP = int_div(int_add(N, 4095), 4096) by defs(arith(hn), x86_64_linux.pages_for, x86_64_linux.PAGE)
  have npo: NP in omega && int_le(N, int_mul(NP, 4096)) && int_lt(int_mul(NP, 4096), int_add(N, 4096)) && int_le(1, NP) by arith(nf, hn, hnz)
  have mc: !(bits_of_int(32, 34) = int_add(int_add(x86_64_linux.MAP_PRIVATE, x86_64_linux.MAP_ANONYMOUS), x86_64_linux.MAP_FIXED)) by defs(simp(), x86_64_linux.MAP_PRIVATE,
    x86_64_linux.MAP_ANONYMOUS, x86_64_linux.MAP_FIXED)
  have pl := expand(hpl, mallocng_specs.mmap_place)
  have p1 pfree := (int_le(1, p) && x86_64_linux.free_range(V3, p, NP) by simp(pl, mc))
  have fr1 fr2 _ := expand(pfree, x86_64_linux.free_range)
  have ts: int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE) = 34359738367 by defs(simp(), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
  have pnb: int_le(int_add(p, NP), 34359738367) := rewrite(ts, fr1)
  have low: int_le(int_add(int_mul(p, 4096), int_mul(NP, 4096)), 140737488351232) by arith(pnb, hp, npo)
  have _ xt xl xs xpg xby := expand(hfr, gimple.fresh_pages)
  have unm: all q. q in omega -> int_le(p, q) -> int_lt(q, int_add(p, NP)) -> !x86_64_linux.mapped(V3, q) proof
    fix q
    assume hq h1 h2
    show := mp(all_elim(fr2, {q}), hq, taut(h1, h2))
  qed
  have xp: all q. q in omega -> x86_64_linux.mapped(V3, q) -> V4.pages[q] = V3.pages[q] proof
    fix q
    assume hq m
    have ml _ := expand(m, x86_64_linux.mapped)
    have nr: !(int_le(p, q) && int_lt(q, int_add(p, NP))) proof
      assume i
      have i1 i2 := i
      show by taut(mp(all_elim(unm, {q}), hq, i1, i2), m)
    qed
    show by simp(mp(all_elim(xpg, {q}), hq, ml), nr)
  qed
  have np: all q. q in omega -> int_le(p, q) -> int_lt(q, int_add(p, NP)) -> V4.pages[q] = some(PG) proof
    fix q
    assume hq h1 h2
    have qt: int_lt(q, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) by arith(ts, pnb, h2)
    show by simp(mp(all_elim(xpg, {q}), hq, qt), h1, h2)
  qed
  have xb: all y. y in bits(64) -> x86_64_linux.mapped(V3, int_div(y, x86_64_linux.PAGE)) -> V4.bytes[y] = V3.bytes[y] proof
    fix y
    assume hy m
    have qo: int_div(y, x86_64_linux.PAGE) in omega by defs(arith(hy), x86_64_linux.PAGE)
    have nr: !(int_le(p, int_div(y, x86_64_linux.PAGE)) && int_lt(int_div(y, x86_64_linux.PAGE), int_add(p, NP))) proof
      assume i
      have i1 i2 := i
      show by taut(mp(all_elim(unm, {int_div(y, x86_64_linux.PAGE)}), qo, i1, i2), m)
    qed
    have nb: !(int_le(int_mul(p, x86_64_linux.PAGE), y) && int_lt(y, int_mul(int_add(p, NP), x86_64_linux.PAGE))) by arith(nr, pg, hy, hp)
    show by simp(mp(all_elim(xby, {y}), hy), nb)
  qed
  have xz: all y. y in bits(64) -> int_le(int_mul(p, 4096), y) -> int_lt(y, int_mul(int_add(p, NP), 4096)) -> V4.bytes[y] = 0 proof
    fix y
    assume hy h1 h2
    have ib: int_le(int_mul(p, x86_64_linux.PAGE), y) && int_lt(y, int_mul(int_add(p, NP), x86_64_linux.PAGE)) by arith(pg, h1, h2)
    show by simp(mp(all_elim(xby, {y}), hy), ib)
  qed
  show by taut(npo, p1, low, unm, xp, np, xb, xz, xt, xl, xs)
qed

// (memory mapped before as it was: every byte outside anything kept)
theorem mp.fresh_kept(c, A, b, V3, V4, e): (all q. q in omega -> x86_64_linux.mapped(V3, q) -> V4.pages[q] = V3.pages[q]) ->
  (all y. y in bits(64) -> x86_64_linux.mapped(V3, int_div(y, x86_64_linux.PAGE)) -> V4.bytes[y] = V3.bytes[y]) -> mallocng.bounds_kept(V3, V4) ->
  mallocng.kept_outside(c, A, b, V3, V4, e)
proof
  assume hpg hby hbs
  have pg: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
  have ts: int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE) = 34359738367 by defs(simp(), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
  have r: all x0. x0 in omega -> (!(x0 in mallocng.footprint(c, A, b)) && !(x0 in e)) && x86_64_linux.mapped(V3, int_div(x0, x86_64_linux.PAGE)) ->
      V4.bytes[bits_of_int(64, x0)] = V3.bytes[bits_of_int(64, x0)] && V4.pages[int_div(x0, x86_64_linux.PAGE)] = V3.pages[int_div(x0, x86_64_linux.PAGE)] proof
    fix a
    assume ha hq
    have _ _ m := hq
    have ml _ := expand(m, x86_64_linux.mapped)
    have ab: bits_of_int(64, a) = a by defs(arith(ha, ml, ts, pg), bits_of_int, pow2)
    have qo: int_div(a, x86_64_linux.PAGE) in omega by defs(arith(ha), x86_64_linux.PAGE)
    have e1 := mp(all_elim(hpg, {int_div(a, x86_64_linux.PAGE)}), qo, m)
    have e2 := mp(all_elim(hby, {a}), (a in bits(64) by arith(ha, ml, ts, pg)), m)
    have e3: V4.bytes[bits_of_int(64, a)] = V3.bytes[bits_of_int(64, a)] := rewrite(sym(ab), e2)
    show by taut(e3, e1)
  qed
  show by defs(taut(r, hbs), mallocng.kept_outside)
qed

// (memory changed only outside the allocator's ranges -- its reserve's
// pages too --, the break and the stack's bounds as before: the invariant
// kept; mp.mm_holds for any change there, an unmapping too)
theorem mp.rng_holds(c, A, vm, V2, b): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_m(c, A, vm, b) ->
  (all a. a in omega -> mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) -> V2.pages[int_div(a, x86_64_linux.PAGE)] = vm.pages[int_div(a, x86_64_linux.PAGE)]) ->
  (all a. a in omega -> mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) -> V2.bytes[bits_of_int(64, a)] = vm.bytes[bits_of_int(64, a)]) ->
  (all q. q in omega -> int_le(int_div(A.reserve, x86_64_linux.PAGE), q) && int_lt(q, int_add(int_div(A.reserve, x86_64_linux.PAGE), A.reserve_cnt)) -> V2.pages[q] = vm.pages[q]) ->
  V2.brk = vm.brk -> V2.stack_top = vm.stack_top -> V2.stack_limit = vm.stack_limit ->
  mallocng.holds_m(c, A, V2, b)
proof
  assume hc hu ha hh hpr hby hrq hbk het hel
  have {H = inv, hm = mapped, hfr = free, hrw = rw, hrs = rsv, hmq = maps} := expand(hh, mallocng.holds_m)
  have rs2 := apply(mp.rsv_keep[A := A, A2 := A, vm := vm, vm2 := V2], hrs, refl({A.reserve}), refl({A.reserve_cnt}), het, hel, hrq)
  // (the mapped groups' pages: in the ranges)
  have {huo0 = used} := expand(H, mallocng.holds)
  have PG: all g q. g in omega -> mallocng.is_used(A, g) -> int_lt(0, A.metas[g].maplen) -> q in omega ->
      int_le(int_div(A.metas[g].mem, x86_64_linux.PAGE), q) && int_lt(q, int_add(int_div(A.metas[g].mem, x86_64_linux.PAGE), A.metas[g].maplen)) -> V2.pages[q] = vm.pages[q] proof
    fix g q
    assume _ iu hl hq hr
    have {ir = in, dq = page} := apply(mp.map_pg_in[A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, g := g, q := q], huo0, iu, hl, hq, hr)
    have ao: int_mul(q, 4096) in omega by arith(hq)
    have rr := apply(mp.used_rng, hc, hu, ha, iu, ir)
    show := rewrite(dq, mp(all_elim(hpr, {int_mul(q, 4096)}), ao, rr))
  qed
  have mq2 := apply(mp.maps_keep[A := A, A2 := A, vm := vm, vm2 := V2], hmq, mp.maps_refl[A := A], het, hel, PG)
  // (the footprint: in the ranges)
  have fr: all a. a in omega -> a in mallocng.footprint(c, A, b) -> mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) proof
    fix a
    assume hao hf
    have s1 := set_select_def[s := omega, p := y. y in mallocng.fp_set(mallocng.fp_ranges(c, A), b) && !mallocng.in_reserved(A, y) && !mallocng.in_taken(A, y), z := a]
    have _ af _ := (a in omega && a in mallocng.fp_set(mallocng.fp_ranges(c, A), b) && !mallocng.in_reserved(A, a) by taut(s1, expand(hf, mallocng.footprint)))
    have s2 := set_select_def[s := omega, p := y. mallocng.in_ranges(y, mallocng.fp_ranges(c, A)) && !(y in malloc.live_of(b)), z := a]
    have _ ir _ := (a in omega && mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) && !(a in malloc.live_of(b)) by taut(s2, expand(af, mallocng.fp_set)))
    show ir
  qed
  // the invariant's view: its bytes the footprint's, in the ranges
  have ag: all a. a in omega -> mallocng.mview(V2, mallocng.held(c, A, b))[a] = mallocng.mview(vm, mallocng.held(c, A, b))[a] proof
    fix a
    assume hao
    have e: a in mallocng.held(c, A, b) -> V2.bytes[bits_of_int(64, a)] = vm.bytes[bits_of_int(64, a)] &&
        V2.pages[int_div(a, x86_64_linux.PAGE)] = vm.pages[int_div(a, x86_64_linux.PAGE)] proof
      assume h
      have {f = fp} := apply(mp.held_fp, h)
      have ir := mp(all_elim(fr, {a}), hao, f)
      show by taut(mp(all_elim(hby, {a}), hao, ir), mp(all_elim(hpr, {a}), hao, ir))
    qed
    show := apply(mp.view_pt[vm := vm, vm2 := V2, fp := mallocng.held(c, A, b), a := a], hao, e)
  qed
  have ve := apply(mp.view_ext[vm := vm, vm2 := V2, fp := mallocng.held(c, A, b)], ag)
  have i2 := rewrite(sym(hbk), rewrite(sym(ve), H))
  // the owned bytes: mapped still
  have mq: all x0. all x1. x0 in omega && x1 in omega -> (((int_lt(x0, seq_len(mallocng.fp_ranges(c, A))) && int_le(fst(mallocng.fp_ranges(c, A)[x0]), x1)) &&
      int_lt(x1, int_add(fst(mallocng.fp_ranges(c, A)[x0]), snd(mallocng.fp_ranges(c, A)[x0])))) && !(x1 in malloc.live_of(b))) && !mallocng.in_ranges(x1, mallocng.auxv_ranges(A)) ->
      x86_64_linux.mapped(V2, int_div(x1, x86_64_linux.PAGE)) && !(snd(V2.pages[int_div(x1, x86_64_linux.PAGE)]).kind = 2) proof
    fix k a
    assume ho h
    have hk hao := ho
    have hkl r1 r2 nl nx := h
    have ir: mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) by defs(ex_intro({k}, taut(hk, hkl, (mallocng.in_range(a, mallocng.fp_ranges(c, A)[k]) by defs(taut(r1, r2), mallocng.in_range)))),
      mallocng.in_ranges)
    have m mk := apply(mp.fpm_use, hm, hk, hao, hkl, r1, r2, nl, nx)
    have e := mp(all_elim(hpr, {a}), hao, ir)
    have ml mn := expand(m, x86_64_linux.mapped)
    have m2: x86_64_linux.mapped(V2, int_div(a, x86_64_linux.PAGE)) by defs(taut(ml, rewrite(sym(e), mn)), x86_64_linux.mapped)
    show by taut(m2, rewrite(sym(e), mk))
  qed
  have m2 := apply(mp.fpm_intro, mq, apply(mp.fpm_low, hm, refl({mallocng.auxv_ranges(A)}), het, hel))
  // the free bytes, the groups' bytes: read-write still
  have fq: all a. a in omega -> mallocng.ctx_free(c, a) -> mallocng.m_rw(mallocng.mview(V2, mallocng.footprint(c, A, b)), a) &&
      !(snd(mallocng.pg(mallocng.mview(V2, mallocng.footprint(c, A, b)), a)).kind = 2) proof
    fix a
    assume hao hfa
    have o1 o2 := mp(all_elim(expand(hfr, mallocng.free_rw), {a}), hao, hfa)
    have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
    have i1 i2 := (int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE))
      by arith(expand(hfa, mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK), ks))
    have f := apply(mp.ctx_fp[c := c, A := A, vm := vm, b := b, a := a], hc, hu, ha, hh, hao, i1, i2)
    have ep := mp(all_elim(hpr, {a}), hao, mp(all_elim(fr, {a}), hao, f))
    have pe := apply(mp.view_pg1[vm := vm, vm2 := V2, fp := mallocng.footprint(c, A, b), a := a], hao, ep)
    have {rw = rw} := apply(mp.pg_same, pe)
    show by taut(rw, o1, rewrite(sym(pe), o2))
  qed
  have f2: mallocng.free_rw(c, mallocng.mview(V2, mallocng.footprint(c, A, b))) by defs(fq, mallocng.free_rw)
  have gq: all x0. all x1. x0 in omega && x1 in omega -> (mallocng.is_used(A, x0) && mallocng.in_range(x1, mallocng.group_range(A.metas[x0]))) &&
      ((x1 in mallocng.footprint(c, A, b) || x1 in malloc.live_of(b)) || mallocng.in_reserved(A, x1)) ->
      mallocng.m_rw(mallocng.mview(V2, mallocng.all_bytes()), x1) && !(snd(mallocng.pg(mallocng.mview(V2, mallocng.all_bytes()), x1)).kind = 2) proof
    fix g a
    assume ho h
    have _ hao := ho
    have iu ir _ := h
    have o1 o2 := mp(all_elim(expand(hrw, mallocng.grp_rw), {g}, {a}), ho, h)
    have {ow = own} := apply(mp.grp_own[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, brk := vm.brk, g := g, a := a], hc, hu, ha, H, iu, hao, ir)
    have ep := mp(all_elim(hpr, {a}), hao, ow)
    have pe := apply(mp.view_pg1[vm := vm, vm2 := V2, fp := mallocng.all_bytes(), a := a], hao, ep)
    have {rw = rw} := apply(mp.pg_same, pe)
    show by taut(rw, o1, rewrite(sym(pe), o2))
  qed
  have g2: mallocng.grp_rw(c, A, V2, b) by defs(gq, mallocng.grp_rw)
  show by defs(taut(i2, m2, f2, g2, rs2, mq2), mallocng.holds_m)
qed

// (the thread's descriptor word: its bytes and pages as before -- sound
// still)
theorem mp.th_same(V0, V1, fs): fs in bits(64) -> abi.thread_ok(V0, fs) ->
  (all i. i in omega -> int_lt(i, 8) -> V1.bytes[bits_of_int(64, int_add(fs, i))] = V0.bytes[bits_of_int(64, int_add(fs, i))] &&
     V1.pages[int_div(int_add(fs, i), x86_64_linux.PAGE)] = V0.pages[int_div(int_add(fs, i), x86_64_linux.PAGE)]) ->
  abi.thread_ok(V1, fs)
proof
  assume hfb ht same
  have r0 ns0 le0 nz0 := expand(ht, abi.thread_ok)
  have r1: all x0. x0 in omega -> int_lt(x0, 8) -> x86_64_linux.mapped(V1, int_div(int_add(fs, x0), x86_64_linux.PAGE)) &&
      snd(V1.pages[int_div(int_add(fs, x0), x86_64_linux.PAGE)]).prot.r proof
    fix i
    assume hi hil
    have m0 p0 := mp(all_elim(expand(r0, x86_64_linux.readable), {i}), hi, hil)
    have _ ep := mp(all_elim(same, {i}), hi, hil)
    have m1: x86_64_linux.mapped(V1, int_div(int_add(fs, i), x86_64_linux.PAGE)) by defs(rewrite(sym(ep), expand(m0, x86_64_linux.mapped)), x86_64_linux.mapped)
    show by taut(m1, rewrite(sym(ep), p0))
  qed
  have ns1: all x0. x0 in omega -> int_lt(x0, 8) -> !abi.stack_page(V1, int_div(int_add(fs, x0), x86_64_linux.PAGE)) proof
    fix i
    assume hi hil
    have n0 := mp(all_elim(ns0, {i}), hi, hil)
    have _ ep := mp(all_elim(same, {i}), hi, hil)
    show by defs(rewrite(sym(ep), expand(n0, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
  qed
  have eb: all i. i in omega -> int_le(0, i) -> int_lt(i, 8) ->
      int_mul(V1.bytes[bits_add(64, fs, bits_of_int(64, i))], int_pow(256, i)) = int_mul(V0.bytes[bits_add(64, fs, bits_of_int(64, i))], int_pow(256, i)) proof
    fix i
    assume hi _ hil
    have m0 _ := mp(all_elim(expand(r0, x86_64_linux.readable), {i}), hi, hil)
    have ml _ := expand(m0, x86_64_linux.mapped)
    have ts: int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE) = 34359738367 by defs(simp(), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
    have pg: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
    have ea: bits_add(64, fs, bits_of_int(64, i)) = bits_of_int(64, int_add(fs, i)) by defs(arith(hfb, hi, hil, ml, ts, pg), bits_add, bits_of_int, pow2)
    have b1 _ := mp(all_elim(same, {i}), hi, hil)
    show by simp(ea, b1)
  qed
  have sx := mp(int_sum_ext[a := 0, b := 8, f := i. int_mul(V1.bytes[bits_add(64, fs, bits_of_int(64, i))], int_pow(256, i)),
    g := i. int_mul(V0.bytes[bits_add(64, fs, bits_of_int(64, i))], int_pow(256, i))], simp(), simp(), eb)
  have l1: x86_64_linux.le(V1.bytes, fs, 8) = fs by defs(simp(sx, expand(le0, x86_64_linux.le)), x86_64_linux.le)
  show by defs(taut(r1, ns1, l1, nz0), abi.thread_ok, x86_64_linux.readable)
qed

// (the eight bytes just stored, read back)
theorem mp.rd_st8(V, B, a, v): a in omega -> int_le(int_add(a, 8), 18446744073709551616) ->
  gimple.bytes_at(fn_update(V, "bytes", x86_64_linux.store_le(B, a, 8, v)), a, 8) = int_mod(v, 18446744073709551616)
proof
  assume ha hl
  show by mem(ha, hl)
qed

// (a byte of the reserve: in the allocator's ranges)
theorem mp.res_rng(c, A, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs ->
  int_le(A.reserve, a) -> int_lt(a, int_add(A.reserve, int_mul(4096, A.reserve_cnt))) -> mallocng.in_ranges(a, mallocng.fp_ranges(c, A))
proof
  assume hc hu ha h1 h2
  have r1 := apply(mp.one_in[a := a, s := A.reserve, n := int_mul(4096, A.reserve_cnt)], h1, h2)
  have fx := apply(mp.fixed_in[c := c, A := A, a := a], hc, hu, ha, taut(r1))
  have {p6 = groups} := apply(mp.fp_pieces, hc, hu, ha)
  have x1: mallocng.fixed_ranges(c, A) in list_type(univ(1)) by defs(apply(mp.pre_list, hc, hu, ha), mallocng.fixed_ranges)
  show by defs(apply(mp.ranges_l, x1, p6, fx), mallocng.fp_ranges)
qed

// (a byte of the allocator's ranges: in the user space -- on a mapped page,
// a client's block's in a group accessible, or the auxiliary vector's on
// the stack's space)
theorem mp.rng_task(c, A, vm, b, a): A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) -> mallocng.holds_m(c, A, vm, b) ->
  a in omega -> mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) -> int_lt(int_div(a, x86_64_linux.PAGE), int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))
proof
  assume ha hb hh hao hr
  have {H = inv, hm = mapped, hrw = rw} := expand(hh, mallocng.holds_m)
  have cl: a in malloc.live_of(b) -> int_lt(int_div(a, x86_64_linux.PAGE), int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) proof
    assume hl
    obtain g, hg hir from apply(mp.live_grp[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, brk := vm.brk, a := a], ha, hb, H, hl)
    have {go = nat} := apply(mp.used_nat, ha, hg)
    have o1 _ := mp(all_elim(expand(hrw, mallocng.grp_rw), {g}, {a}), conj(go, hao), taut(hg, hir, hl))
    have m _ := expand(apply(mp.rw_mapped[vm := vm, a := a], hao, o1), x86_64_linux.mapped)
    show := m
  qed
  have cx: mallocng.in_ranges(a, mallocng.auxv_ranges(A)) -> int_lt(int_div(a, x86_64_linux.PAGE), int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) proof
    assume x
    have {L = low} := expand(hm, mallocng.fp_mapped)
    have _ _ lt := expand(mp(all_elim(L, {a}), hao, x), mallocng.in_stack_space)
    show by arith(expand(lt, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE), hao, (x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)),
      (int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE) = 34359738367 by defs(simp(), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)))
  qed
  have cn: !(a in malloc.live_of(b)) -> !mallocng.in_ranges(a, mallocng.auxv_ranges(A)) ->
      int_lt(int_div(a, x86_64_linux.PAGE), int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) proof
    assume nl nx
    obtain k2, hk hkl hr2 from expand(hr, mallocng.in_ranges)
    have r1 r2 := expand(hr2, mallocng.in_range)
    have m _ := apply(mp.fpm_use, hm, hk, hao, hkl, r1, r2, nl, nx)
    have ml _ := expand(m, x86_64_linux.mapped)
    show := ml
  qed
  show by taut(cl, cx, cn)
qed

// (a byte of the allocator's ranges, not a client's: not on the pages an
// mmap gives -- unmapped before, off the stack's space)
theorem mp.rng_place(c, A, vm, b, a, N, p): mallocng.holds_m(c, A, vm, b) -> a in omega -> mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) ->
  !(a in malloc.live_of(b)) -> p in omega -> N in omega -> mallocng_specs.mmap_place(vm, 0, N, bits_of_int(32, 34), p) ->
  !(int_le(p, int_div(a, x86_64_linux.PAGE)) && int_lt(int_div(a, x86_64_linux.PAGE), int_add(p, x86_64_linux.pages_for(N))))
proof
  assume hh hao hr nl hp hn hpl
  let NP := x86_64_linux.pages_for(N)
  have {hm = mapped} := expand(hh, mallocng.holds_m)
  have pg: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
  have mc: !(bits_of_int(32, 34) = int_add(int_add(x86_64_linux.MAP_PRIVATE, x86_64_linux.MAP_ANONYMOUS), x86_64_linux.MAP_FIXED)) by defs(simp(), x86_64_linux.MAP_PRIVATE,
    x86_64_linux.MAP_ANONYMOUS, x86_64_linux.MAP_FIXED)
  have pl := expand(hpl, mallocng_specs.mmap_place)
  have _ fr off := (int_le(1, p) && x86_64_linux.free_range(vm, p, NP) && x86_64_linux.off_stack_space(vm, p, NP) by simp(pl, mc))
  have no: NP in omega by defs(arith(hn), x86_64_linux.pages_for, x86_64_linux.PAGE)
  have cx: mallocng.in_ranges(a, mallocng.auxv_ranges(A)) -> !(int_le(p, int_div(a, x86_64_linux.PAGE)) && int_lt(int_div(a, x86_64_linux.PAGE), int_add(p, NP))) proof
    assume x
    have {L = low} := expand(hm, mallocng.fp_mapped)
    have s1 s2 _ := expand(mp(all_elim(L, {a}), hao, x), mallocng.in_stack_space, x86_64_linux.stack_floor)
    have gp: x86_64_linux.STACK_GUARD_GAP in omega by defs(simp(), x86_64_linux.STACK_GUARD_GAP)
    show by arith(expand(off, x86_64_linux.off_stack_space, x86_64_linux.stack_floor), s1, s2, gp, pg, hp, no, hao)
  qed
  have cn: !mallocng.in_ranges(a, mallocng.auxv_ranges(A)) -> !(int_le(p, int_div(a, x86_64_linux.PAGE)) && int_lt(int_div(a, x86_64_linux.PAGE), int_add(p, NP))) proof
    assume nx
    obtain k2, hk hkl hr2 from expand(hr, mallocng.in_ranges)
    have r1 r2 := expand(hr2, mallocng.in_range)
    have m _ := apply(mp.fpm_use, hm, hk, hao, hkl, r1, r2, nl, nx)
    have _ fu _ := expand(fr, x86_64_linux.free_range)
    assume w
    have w1 w2 := w
    show by taut(m, mp(all_elim(fu, {int_div(a, x86_64_linux.PAGE)}), (int_div(a, x86_64_linux.PAGE) in omega by arith(hao, pg)), taut(w1, w2)))
  qed
  show by taut(cx, cn)
qed

// (the allocator's byte: on none of the pages an mmap gives)
theorem mp.fp_page(c, A, vm, b, a, N, p): mallocng.holds_m(c, A, vm, b) -> a in mallocng.footprint(c, A, b) -> p in omega -> N in omega ->
  mallocng_specs.mmap_place(vm, 0, N, bits_of_int(32, 34), p) ->
  int_le(p, int_div(a, x86_64_linux.PAGE)) -> int_lt(int_div(a, x86_64_linux.PAGE), int_add(p, x86_64_linux.pages_for(N))) -> false
proof
  assume hh f0 hp hn hpl q1 q2
  have f2 := mp.fp_def[c := c, A := A, b := b, a := a]
  have ao ir nl0 _ _ := (a in omega && mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) && !(a in malloc.live_of(b)) && !mallocng.in_reserved(A, a) && !mallocng.in_taken(A, a)
    by taut(f2, f0))
  show by taut(apply(mp.rng_place[c := c, A := A, vm := vm, b := b, a := a, N := N, p := p], hh, ao, ir, nl0, hp, hn, hpl), q1, q2)
qed

// (pages unmapped before (V0), mapped then (V4): none of the ranges of an
// allocator grown from A only into memory unmapped at V4, nothing reserved
// or taken -- a client's block in A's groups, mapped before)
theorem mp.gone_off(c, A, A1, V0, V4, B, p, k, a, N): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> B in fn_space(bits(64), option(omega)) ->
  mallocng.holds_m(c, A, V0, B) -> mallocng.no_reserved(A1) -> seq_len(A1.taken) = 0 -> mp.grown(c, A1, A, B, V4) ->
  (all q. q in omega -> int_le(p, q) -> int_lt(q, int_add(p, k)) -> !x86_64_linux.mapped(V0, q) && x86_64_linux.mapped(V4, q)) ->
  p in omega -> N in omega -> mallocng_specs.mmap_place(V0, 0, N, bits_of_int(32, 34), p) -> k = x86_64_linux.pages_for(N) ->
  a in omega -> mallocng.in_ranges(a, mallocng.fp_ranges(c, A1)) ->
  !(int_le(p, int_div(a, x86_64_linux.PAGE)) && int_lt(int_div(a, x86_64_linux.PAGE), int_add(p, k)))
proof
  assume hc hu ha hb hh hnr htk hgr hq hp hn hpl ek hao hr
  assume hin
  have h1 h2 := hin
  have qo: int_div(a, x86_64_linux.PAGE) in omega by defs(arith(hao), x86_64_linux.PAGE)
  have um mm := mp(all_elim(hq, {int_div(a, x86_64_linux.PAGE)}), qo, h1, h2)
  have {H = inv, hm = mapped, hrw = rw} := expand(hh, mallocng.holds_m)
  // (a client's byte: in a group of A, accessible before)
  have nl: !(a in malloc.live_of(B)) proof
    assume hl
    obtain g, hg hir from apply(mp.live_grp[c := c, A := A, M := mallocng.mview(V0, mallocng.held(c, A, B)), b := B, brk := V0.brk, a := a], ha, hb, H, hl)
    have {go = nat} := apply(mp.used_nat, ha, hg)
    have o1 _ := mp(all_elim(expand(hrw, mallocng.grp_rw), {g}, {a}), conj(go, hao), taut(hg, hir, hl))
    show by taut(um, apply(mp.rw_mapped[vm := V0, a := a], hao, o1))
  qed
  have nr := apply(mp.nores[A := A1, a := a], hnr)
  have nt: !mallocng.in_taken(A1, a) proof
    assume t
    obtain j, hj hjl from expand(t, mallocng.in_taken)
    show by arith(hjl, htk, hj)
  qed
  have f1 := mp.fp_def[c := c, A := A1, b := B, a := a]
  have fa: a in mallocng.footprint(c, A1, B) by taut(f1, hao, hr, nl, nr, nt)
  have g := mp(all_elim(hgr, {a}), hao, fa)
  // (A's footprint: mapped before)
  have c1: !(a in mallocng.footprint(c, A, B)) proof
    assume f0
    show := apply(mp.fp_page[c := c, A := A, vm := V0, b := B, a := a, N := N, p := p], hh, f0, hp, hn, hpl, h1, rewrite(ek, h2))
  qed
  show by taut(g, c1, mm)
qed

// (memory untouched since V0 to V5, then pages gone that were unmapped at
// V0: untouched since V0)
theorem mp.unt_gone(c, A, B, V0, V5, V7, objs, e, p, k): mallocng.untouched(c, A, B, V0, V5, objs, e) -> gimple.gone_pages(V5, V7, p, k) ->
  (all q. q in omega -> int_le(p, q) -> int_lt(q, int_add(p, k)) -> !x86_64_linux.mapped(V0, q)) -> mallocng.untouched(c, A, B, V0, V7, objs, e)
proof
  assume hu hg hq
  have u1 u2 := expand(hu, mallocng.untouched)
  have gt gl gs gpg gby := expand(hg, gimple.gone_pages)
  have r: all x0. x0 in omega -> (!(x0 in mallocng.footprint(c, A, B)) && !(x0 in e)) && x86_64_linux.mapped(V0, int_div(x0, x86_64_linux.PAGE)) ->
      (!abi.stack_free(V0, objs, x0) -> V7.bytes[bits_of_int(64, x0)] = V0.bytes[bits_of_int(64, x0)]) && V7.pages[int_div(x0, x86_64_linux.PAGE)] = V0.pages[int_div(x0, x86_64_linux.PAGE)] proof
    fix a
    assume ha hx
    have _ _ m0 := hx
    have ml _ := expand(m0, x86_64_linux.mapped)
    have qo: int_div(a, x86_64_linux.PAGE) in omega by defs(arith(ha), x86_64_linux.PAGE)
    have b1 p1 := mp(all_elim(u1, {a}), ha, hx)
    have ng: !(int_le(p, int_div(a, x86_64_linux.PAGE)) && int_lt(int_div(a, x86_64_linux.PAGE), int_add(p, k))) proof
      assume w
      have w1 w2 := w
      show by taut(mp(all_elim(hq, {int_div(a, x86_64_linux.PAGE)}), qo, w1, w2), m0)
    qed
    have pe: V7.pages[int_div(a, x86_64_linux.PAGE)] = V5.pages[int_div(a, x86_64_linux.PAGE)] by simp(mp(all_elim(gpg, {int_div(a, x86_64_linux.PAGE)}), qo, ml), ng)
    have bb: !abi.stack_free(V0, objs, a) -> V7.bytes[bits_of_int(64, a)] = V0.bytes[bits_of_int(64, a)] proof
      assume hs
      show by simp(gby, mp(b1, hs))
    qed
    show by taut(bb, trans(pe, p1))
  qed
  have bk: mallocng.bounds_kept(V5, V7) by defs(taut(gt, gl, gs), mallocng.bounds_kept)
  show by defs(taut(r, apply(mp.bk_trans, u2, bk)), mallocng.untouched)
qed

// ----------------------------------------------------------------------
//  A class's low bit (the coarse class sc | 1 of an even sc)

theorem mp.low_bit(x): x in bits(32) ->
  (bits_and(32, x, 1) = 0 <-> int_mod(x, 2) = 0) && (int_mod(x, 2) = 0 -> bits_or(32, x, 1) = int_add(x, 1))
proof
  assume hx
  have xo: x in omega by arith(hx)
  let Q := int_div(x, 2)
  let R := int_mod(x, 2)
  have qo ro := mp(div_nat[x := x, m := 2], xo, arith())
  have p1: pow2(1) = 2 by simp()
  have rl: int_lt(R, 2) by arith(xo)
  have xe: x = int_add(int_mul(Q, pow2(1)), R) by arith(p1, xo)
  // x's bits: R's at 0, Q's above
  have bx: all i. i in omega -> (bit(x, i) <-> (int_lt(i, 1) && bit(R, i)) || (int_le(1, i) && bit(Q, int_sub(i, 1)))) proof
    fix i
    assume hi
    show := rewrite(sym(xe), mp(bit_addmul[x := Q, k := 1, r := R, i := i], qo, arith(), ro, arith(p1, rl), hi))
  qed
  have ab: bits_and(32, x, 1) in bits(32) := mp(bits_and_in[n := 32, x := x, y := 1], arith())
  have zb: 0 in bits(32) by simp()
  // even: x & 1 = 0
  have ev: R = 0 -> bits_and(32, x, 1) = 0 proof
    assume h0
    have hb: all i. i in omega -> int_lt(i, 32) -> (bit(bits_and(32, x, 1), i) <-> bit(0, i)) proof
      fix i
      assume hi hil
      have a := mp(bit_and[n := 32, x := x, y := 1, i := i], arith(), hi, hil)
      have on := mp(bit_one[i := i], hi)
      have z := mp(bit_zero[i := i], hi)
      have zr: bit(R, i) <-> false := rewrite(sym(h0), z)
      have b := mp(all_elim(bx, {i}), hi)
      have c0: i = 0 -> !bit(x, i) proof
        assume e
        have nl: !int_le(1, i) by arith(e)
        show by taut(b, zr, nl)
      qed
      show by taut(a, on, z, c0)
    qed
    show := mp(all_elim(mp(all_elim(bits_ext, {32}), arith()), {bits_and(32, x, 1)}, {0}), ab, zb, hb)
  qed
  // odd: x & 1 = 1
  have od: !(R = 0) -> !(bits_and(32, x, 1) = 0) proof
    assume h1 he
    have r1: R = 1 by arith(h1, ro, rl)
    have o0 := mp(bit_one[i := 0], simp())
    have rb: bit(R, 0) <-> 0 = 0 := rewrite(sym(r1), o0)
    have bx0 := mp(all_elim(bx, {0}), simp())
    have l01: int_lt(0, 1) by arith()
    have a0 := mp(bit_and[n := 32, x := x, y := 1, i := 0], arith(), simp(), arith())
    have z0 := mp(bit_zero[i := 0], simp())
    show by taut(rewrite(he, a0), o0, rb, bx0, l01, z0, refl({0}))
  qed
  // even: x | 1 = x + 1
  have orr: R = 0 -> bits_or(32, x, 1) = int_add(x, 1) proof
    assume h0
    have x1: int_add(x, 1) = int_add(int_mul(Q, pow2(1)), 1) by arith(xe, h0)
    have x1b: int_add(x, 1) in bits(32) by arith(hx, xe, h0, p1, qo)
    have ob: bits_or(32, x, 1) in bits(32) := mp(bits_or_in[n := 32, x := x, y := 1], arith())
    have hb: all i. i in omega -> int_lt(i, 32) -> (bit(bits_or(32, x, 1), i) <-> bit(int_add(x, 1), i)) proof
      fix i
      assume hi hil
      have a := mp(bit_or[n := 32, x := x, y := 1, i := i], arith(), hi, hil)
      have on := mp(bit_one[i := i], hi)
      have z := mp(bit_zero[i := i], hi)
      have zr: bit(R, i) <-> false := rewrite(sym(h0), z)
      have b := mp(all_elim(bx, {i}), hi)
      have y := rewrite(sym(x1), mp(bit_addmul[x := Q, k := 1, r := 1, i := i], qo, arith(), simp(), arith(p1), hi))
      have c0: i = 0 -> int_lt(i, 1) && !int_le(1, i) proof
        assume e
        show by arith(e)
      qed
      have c1: !(i = 0) -> !int_lt(i, 1) && int_le(1, i) proof
        assume e
        show by arith(e, hi)
      qed
      show by taut(a, on, zr, b, y, c0, c1)
    qed
    show := mp(all_elim(mp(all_elim(bits_ext, {32}), arith()), {bits_or(32, x, 1)}, {int_add(x, 1)}), ob, x1b, hb)
  qed
  show by taut(ev, od, orr)
qed

// ----------------------------------------------------------------------
//  A class's slot framed: malloc's block

// p, a new block of n bytes: the invariant kept (A3: no slot reserved, no
// meta taken), nothing outside the allocator touched but errno, the
// allocator grown only into memory unmapped before, the block too
abbrev mp.mi_blk(c, A, n, B, s, A3, V3, p) := (((A3 in mallocng.Abs && A3 in univ(1)) && mallocng.no_reserved(A3)) && seq_len(A3.taken) = 0) &&
  V3 in x86_64_linux.Vm && ((p in bits(64) && !(p = 0)) && B[p] = none) && mallocng.holds_m(c, A3, V3, malloc.set_block(B, p, some(n))) &&
  mallocng.shown_in(c, A3, s.objs) && mallocng.untouched(c, A, B, s.vm, V3, s.objs, mp.errno(s.fs_base)) &&
  (all a. a in omega -> a in mallocng.footprint(c, A3, malloc.set_block(B, p, some(n))) ->
     a in mallocng.footprint(c, A, B) || !x86_64_linux.mapped(s.vm, int_div(a, x86_64_linux.PAGE))) &&
  (all a. a in omega -> int_le(p, a) -> int_lt(a, int_add(p, n)) ->
     a in mallocng.footprint(c, A, B) || !x86_64_linux.mapped(s.vm, int_div(a, x86_64_linux.PAGE)))

// slot i of g, reserved at A1 (V1: the allocator's steps from A at s,
// nothing else touched but errno, grown only into memory unmapped before,
// the slot too), framed at p for n bytes
theorem mp.mi_fin(c, A, A1, B, s, V1, V2, g, i, p, n): mp.bfpre(c, A1, V1, V2, B, g, i, p, n) -> mallocng.shown_in(c, A1, s.objs) -> seq_len(A1.taken) = 0 ->
  mallocng.untouched(c, A, B, s.vm, V1, s.objs, mp.errno(s.fs_base)) -> mp.grown(c, A1, A, B, s.vm) -> mp.rgrown(c, A1, A, B, s.vm) ->
  mp.mi_blk(c, A, n, B, s, mp.blk(A1, g, i, p), V2, p)
proof
  assume BP hsh htk hun hgr hrg
  have {a1a = abs, hin1 = holds, iug = par, io = slot, ro = res} := BP
  have {go = gnat, il = slen, s0 = sres, qo = pnat, qst = start, qfi = fits, qfree = free, a3a = abs1, a3u = univ1, qout = out, qpg = pages} := apply(mp.bf_basic, BP)
  have {v2v = v1, frm = frm, pb = addr} := BP
  have {hmQ = mem, shQ = shown} := apply(mp.bf_holds_in[c := c, A := A1, vm := V1, V1 := V2, b := B, g := g, i := i, p := p, n := n, objs := s.objs], BP, hsh)
  let A3 := mp.blk(A1, g, i, p)
  let VG := A1.metas[g]
  let V0 := s.vm
  have ib4: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
  have pg: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
  have ts: int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE) = 34359738367 by defs(simp(), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
  // (a byte of the slot: reserved -- the allocator's before, or unmapped)
  have rs: all a. a in omega -> mallocng.in_slot(VG, i, a) -> a in mallocng.footprint(c, A, B) || !x86_64_linux.mapped(V0, int_div(a, x86_64_linux.PAGE)) proof
    fix a
    assume hao w
    have r: mallocng.in_reserved(A1, a) by defs(ex_intro({g}, {i}, taut(go, io, iug, il, s0, w)), mallocng.in_reserved)
    show := mp(all_elim(hrg, {a}), hao, r)
  qed
  // (p: past the group's header)
  have {H1 = inv} := expand(hin1, mallocng.holds_m)
  have {huo = used} := expand(H1, mallocng.holds)
  have gok := apply(mp.used_group, huo, iug)
  have {gm = mem, gst = stride, gss = start} := apply(mp.geo, a1a, go, gok)
  have mr: int_mul(mallocng.stride(VG), i) in omega by simp(gst, io)
  have pnz: !(p = 0) by arith(qst, all_elim(gss, {i}), gm, mr)
  // nothing reserved: the one slot reserved framed
  have nr3: mallocng.no_reserved(A3) proof
    have q: all x0. all x1. x0 in omega && x1 in omega -> int_lt(x1, seq_len(A3.slots[x0])) -> !(A3.slots[x0][x1] = tag(3, empty)) proof
      fix h j
      assume ho hjl e
      have hho hjo := ho
      have ls := apply(mp.su_len[A := A1, g := g, i := i, u := tag(1, p), p := h], a1a, go, io, il, apply(mp.use1, qo))
      have c1: !(A1.slots[h][j] = tag(3, empty)) -> false proof
        assume ne
        have s3 := apply(mp.su_slot[A := A1, g := g, i := i, u := tag(1, p), p := h, j := j, v := A1.slots[h][j]], s0, refl({A1.slots[h][j]}), ne)
        show by taut(ne, rewrite(s3, e))
      qed
      have c2: A1.slots[h][j] = tag(3, empty) -> false proof
        assume e2
        have _ _ uq := expand(ro, mallocng.reserved_only)
        have eh ej := mp(all_elim(uq, {h}, {j}), conj(hho, hjo), conj(rewrite(ls, hjl), e2))
        have s3: A3.slots[g][i] = tag(1, p) by simp()
        have tn: !(tag(1, p) = tag(3, empty)) by simp()
        show by taut(trans(sym(s3), rewrite(ej, rewrite(eh, e))), tn)
      qed
      show by taut(c1, c2)
    qed
    show by defs(q, mallocng.no_reserved)
  qed
  have tk3: seq_len(A3.taken) = 0 by simp(htk)
  // outside the allocator: untouched since s (the slot: the allocator's)
  have u1a u1b := expand(hun, mallocng.untouched)
  have rU: all x0. x0 in omega -> (!(x0 in mallocng.footprint(c, A, B)) && !(x0 in mp.errno(s.fs_base))) && x86_64_linux.mapped(V0, int_div(x0, x86_64_linux.PAGE)) ->
      (!abi.stack_free(V0, s.objs, x0) -> V2.bytes[bits_of_int(64, x0)] = V0.bytes[bits_of_int(64, x0)]) &&
      V2.pages[int_div(x0, x86_64_linux.PAGE)] = V0.pages[int_div(x0, x86_64_linux.PAGE)] proof
    fix a
    assume hao hxa
    have nf ne m0 := hxa
    have ml _ := expand(m0, x86_64_linux.mapped)
    have yb: a in bits(64) by arith(hao, ml, ts, pg)
    have nsl: !mallocng.in_slot(VG, i, a) proof
      assume w
      show by taut(mp(all_elim(rs, {a}), hao, w), nf, m0)
    qed
    have b2 := mp(all_elim(qout, {a}), hao, conj((int_lt(a, int_pow(2, 64)) by arith(yb)), nsl))
    have b1 p1 := mp(all_elim(u1a, {a}), hao, hxa)
    have bb: !abi.stack_free(V0, s.objs, a) -> V2.bytes[bits_of_int(64, a)] = V0.bytes[bits_of_int(64, a)] proof
      assume hs
      show := trans(b2, mp(b1, hs))
    qed
    show by taut(bb, trans(rewrite(qpg, refl({V2.pages[int_div(a, x86_64_linux.PAGE)]}), {2}), p1))
  qed
  have fv0 _ _ := expand(frm, mallocng_specs.framed)
  have bk02 := apply(mp.bk_trans, u1b, apply(mp.bk_only, fv0))
  have un02: mallocng.untouched(c, A, B, V0, V2, s.objs, mp.errno(s.fs_base)) by defs(taut(rU, bk02), mallocng.untouched)
  // the allocator grown: A1's, the slot's rest
  have gr3: all a. a in omega -> a in mallocng.footprint(c, A3, malloc.set_block(B, p, some(n))) ->
      a in mallocng.footprint(c, A, B) || !x86_64_linux.mapped(V0, int_div(a, x86_64_linux.PAGE)) proof
    fix a
    assume hao hf
    have f3 := apply(mp.bf_fp[c := c, A := A1, vm := V1, V1 := V2, b := B, g := g, i := i, p := p, n := n, a := a], BP)
    have c1: a in mallocng.footprint(c, A1, B) -> a in mallocng.footprint(c, A, B) || !x86_64_linux.mapped(V0, int_div(a, x86_64_linux.PAGE)) proof
      assume h1
      show := mp(all_elim(hgr, {a}), hao, h1)
    qed
    have c2: mallocng.in_slot(VG, i, a) -> a in mallocng.footprint(c, A, B) || !x86_64_linux.mapped(V0, int_div(a, x86_64_linux.PAGE)) proof
      assume w
      show := mp(all_elim(rs, {a}), hao, w)
    qed
    show by taut(f3, hf, c1, c2)
  qed
  // the block's bytes: the slot's
  have bl3: all a. a in omega -> int_le(p, a) -> int_lt(a, int_add(p, n)) ->
      a in mallocng.footprint(c, A, B) || !x86_64_linux.mapped(V0, int_div(a, x86_64_linux.PAGE)) proof
    fix a
    assume hao h1 h2
    show := mp(all_elim(rs, {a}), hao, (mallocng.in_slot(VG, i, a) by defs(arith(h1, h2, qst, qfi, ib4), mallocng.in_slot)))
  qed
  show by taut(a3a, a3u, nr3, tk3, v2v, pb, pnz, qfree, hmQ, shQ, un02, gr3, bl3)
qed

// slot R of g reserved at A1, g of class SC: a request's of n bytes (of
// class S0, SC = S0 or its odd neighbour), room in it -- enframe's
// premises: the slot accessible, its slack below 2^31, the frame's end
// within the class's slot (or a page past its start), the thread's block
// apart
theorem mp.mi_efpre(c, A, A1, B, V0, V1, fs, G, R, SC, S0, n): c in mallocng.Cfg -> A1 in univ(1) -> A1 in mallocng.Abs ->
  mallocng.holds_m(c, A1, V1, B) -> mallocng.is_used(A1, G) -> R in omega -> mallocng.reserved_only(A1, G, R) ->
  A1.metas[G].sizeclass = SC -> int_lt(SC, 48) -> int_le(int_add(n, mallocng.IB), mallocng.stride(A1.metas[G])) ->
  n in omega -> S0 in omega -> mallocng_specs.class_of(n, S0) -> (SC = S0 || (SC = int_add(S0, 1) && int_mod(S0, 2) = 0)) ->
  fs in bits(64) -> abi.thread_ok(V0, fs) -> mallocng_specs.tls_apart(c, A, fs) -> mp.grown(c, A1, A, B, V0) -> mp.rgrown(c, A1, A, B, V0) ->
  srw: mallocng.slot_rw(V1, A1.metas[G], R) &&
  span: int_lt(int_sub(int_sub(mallocng.stride(A1.metas[G]), n), mallocng.IB), int_pow(2, 31)) &&
  cb: (int_lt(A1.metas[G].sizeclass, 48) ->
     int_lt(int_sub(int_sub(mallocng.slot_end(A1.metas[G], R), n), mallocng.storage(A1.metas[G])),
       int_mul(int_mul(mallocng.UNIT, mallocng.size_classes[A1.metas[G].sizeclass]), int_add(R, 1))) ||
     int_le(int_add(int_sub(mallocng.slot_start(A1.metas[G], R), mallocng.storage(A1.metas[G])), int_mul(256, mallocng.UNIT)),
       int_mul(int_mul(mallocng.UNIT, mallocng.size_classes[A1.metas[G].sizeclass]), int_add(R, 1)))) &&
  fs: (int_le(int_add(fs, 8), int_sub(mallocng.slot_start(A1.metas[G], R), mallocng.IB)) || int_le(mallocng.slot_end(A1.metas[G], R), fs))
proof
  assume hc a1u a1a hin1 iug ro0 ro gsc s48 hfit no s0o hcl rel fsb hth htl hgr hrg
  let VG := A1.metas[G]
  have il _ _ := expand(ro, mallocng.reserved_only)
  have {H1 = inv} := expand(hin1, mallocng.holds_m)
  have {huo = used} := expand(H1, mallocng.holds)
  have gok := apply(mp.used_group, huo, iug)
  have {go = nat} := apply(mp.used_nat, a1a, iug)
  have {gm = mem, gl = last, gst = stride, gss = start, gse = end, gns = nslots} := apply(mp.geo, a1a, go, gok)
  have sg16 := apply(mp.stride_ge, a1a, go, gok)
  have vgt: VG in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A1.metas, x := G], simp(a1a), go)
  have ib4: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
  have un16: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
  // the slot: accessible
  have srw := apply(mp.slot_rw_of[c := c, A := A1, vm := V1, b := B, g := G, i := R], hc, a1u, a1a, hin1, iug, ro0, il)
  // its stride: under two of the class's slots
  have {spn = span} := expand(gok, mallocng.group_ok)
  have sp2 := mp(spn, (int_lt(VG.sizeclass, 48) by arith(gsc, s48)))
  have sco: SC in omega := rewrite(gsc, (VG.sizeclass in omega by simp(vgt)))
  have zn zl := mp(all_elim(ms.sc_nat, {SC}), sco, s48)
  have zs: mallocng.size_classes[VG.sizeclass] = mallocng.size_classes[SC] by simp(gsc)
  have span: int_lt(int_sub(int_sub(mallocng.stride(VG), n), mallocng.IB), int_pow(2, 31)) by arith(sp2, zs, zl, un16, no, ib4, (int_pow(2, 31) = 2147483648 by simp()))
  // the frame's end: within the class's slot
  have cb: int_lt(VG.sizeclass, 48) ->
      int_lt(int_sub(int_sub(mallocng.slot_end(VG, R), n), mallocng.storage(VG)), int_mul(int_mul(mallocng.UNIT, mallocng.size_classes[VG.sizeclass]), int_add(R, 1))) ||
      int_le(int_add(int_sub(mallocng.slot_start(VG, R), mallocng.storage(VG)), int_mul(256, mallocng.UNIT)), int_mul(int_mul(mallocng.UNIT, mallocng.size_classes[VG.sizeclass]), int_add(R, 1))) proof
    assume hl
    show := apply(mp.cls_bound[V := VG, s0 := S0, idx := R, n := n], vgt, hl, sp2, ro0, (int_le(R, VG.last_idx) by arith(il, gns)), no, s0o, hcl, rewrite(sym(gsc), rel))
  qed
  // the thread's block: apart from the slot
  let SS := int_sub(mallocng.slot_start(VG, R), mallocng.IB)
  have mr: int_mul(mallocng.stride(VG), R) in omega by simp(gst, ro0)
  have sso: SS in omega by arith(all_elim(gss, {R}), gm, mr, ib4)
  have seo: mallocng.slot_end(VG, R) in omega by arith(all_elim(gse, {R}), gm, mr, gst, sg16)
  have slt: int_lt(SS, mallocng.slot_end(VG, R)) by arith(all_elim(gss, {R}), all_elim(gse, {R}), ib4, sg16)
  have nrs: !mallocng.in_reserved(A1, SS) proof
    assume w
    obtain g3 i3, hg3 hi3 _ hil3 hs3 his3 from expand(w, mallocng.in_reserved)
    have _ _ uq := expand(ro, mallocng.reserved_only)
    have eg ei := mp(all_elim(uq, {g3}, {i3}), conj(hg3, hi3), conj(hil3, hs3))
    have q1 _ := expand(rewrite(ei, rewrite(eg, his3)), mallocng.in_slot)
    show by arith(q1)
  qed
  have ch0 _ := apply(mp.chk_fp[c := c, A := A1, vm := V1, b := B, g := G, j := R], hc, a1u, a1a, ro0, hin1, iug, arith(il, gns, gl), nrs)
  have {cfp = fp} := apply(mp.held_fp, ch0)
  have fsl := apply(mp.fs_slot[c := c, A := A, A2 := A1, B := B, vm0 := V0, fs := fs, g := G, i := R], a1a, fsb, hth, htl, hgr, hrg, iug, ro0, ro,
    cfp, sso, seo, slt)
  show by taut(srw, span, cb, fsl)
qed

// ----------------------------------------------------------------------
//  The run

// malloc's outcome: an overflow; or 0, errno ENOMEM; or p, a new block of
// n bytes (p not a live block's start) -- the invariant kept (A2: no slot
// reserved, no meta taken), nothing outside the allocator touched but
// errno, the allocator grown only into memory unmapped before, the block
// too
abbrev mp.mi_out(c, A, n, B, s, o) := abi.ovf_out(s, o) ||
  (ex A2 V2. ((A2 in mallocng.Abs && A2 in univ(1)) && mallocng.no_reserved(A2) && seq_len(A2.taken) = 0) && V2 in x86_64_linux.Vm &&
     mallocng.holds_m(c, A2, V2, B) && mallocng.shown_in(c, A2, s.objs) && mallocng.untouched(c, A, B, s.vm, V2, s.objs, mp.errno(s.fs_base)) &&
     mp.grown(c, A2, A, B, s.vm) && mallocng_specs.errno_is(V2, s.fs_base, x86_64_linux.ENOMEM) && o = ok(fn_update(s, "vm", V2), 0)) ||
  (ex A2 V2 p. ((A2 in mallocng.Abs && A2 in univ(1)) && mallocng.no_reserved(A2) && seq_len(A2.taken) = 0) && V2 in x86_64_linux.Vm &&
     (p in bits(64) && !(p = 0) && B[p] = none) &&
     mallocng.holds_m(c, A2, V2, malloc.set_block(B, p, some(n))) && mallocng.shown_in(c, A2, s.objs) && mallocng.untouched(c, A, B, s.vm, V2, s.objs, mp.errno(s.fs_base)) &&
     (all a. a in omega -> a in mallocng.footprint(c, A2, malloc.set_block(B, p, some(n))) ->
        a in mallocng.footprint(c, A, B) || !x86_64_linux.mapped(s.vm, int_div(a, x86_64_linux.PAGE))) &&
     (all a. a in omega -> int_le(p, a) -> int_lt(a, int_add(p, n)) -> a in mallocng.footprint(c, A, B) || !x86_64_linux.mapped(s.vm, int_div(a, x86_64_linux.PAGE))) &&
     o = ok(fn_update(s, "vm", V2), p))

theorem mp.mi_run(c, n, gso, gmm, gwl, gsq, gam, gul, gmu, gs2c, grl, gac, gug, gas, gef, s, h, o): c in mallocng.Cfg ->
  c.ctx = c_src_malloc_mallocng_malloc.__malloc_context -> c.sct = c_src_malloc_mallocng_malloc.__malloc_size_classes ->
  c.dbj = c_src_malloc_mallocng_malloc.debruijn32 -> c.lock = c_src_malloc_mallocng_malloc.__malloc_lock -> c.libc = c_src_malloc_mallocng_malloc.__libc ->
  n in bits(64) ->
  mp.calls(gso, mallocng_specs.size_overflows_spec_fun) -> mp.calls(gmm, mallocng_specs.mmap_spec_fun()) ->
  mp.calls(gwl, mallocng_specs.lock_spec_fun(c_src_malloc_mallocng_malloc.__libc)) -> mp.sq_call(c, gsq) -> mp.am_call(c, gam) ->
  mp.calls(gul, mallocng_specs.unlock_spec_fun(c_src_malloc_mallocng_malloc.__malloc_lock)) -> mp.calls(gmu, mallocng_specs.munmap_spec_fun()) ->
  mp.calls(gs2c, mallocng_specs.size_to_class_spec_fun(c.sct, c.dbj)) -> mp.calls(grl, mallocng_specs.lock_spec_fun(c_src_malloc_mallocng_malloc.__libc)) ->
  mp.calls(gac, mallocng_specs.a_ctz_32_spec_fun(c_src_malloc_mallocng_malloc.debruijn32)) -> mp.calls(gug, mallocng_specs.upgradelock_spec_fun()) ->
  mp.as_call(c, gas) -> mp.ef_call(c, gef) ->
  s in abi.World -> h in mp.G ->
  mallocng.holds_m(c, h.A, s.vm, h.blocks) -> mallocng.shown_in(c, h.A, s.objs) -> mallocng.no_reserved(h.A) -> seq_len(h.A.taken) = 0 ->
  abi.thread_ok(s.vm, s.fs_base) -> mallocng_specs.tls_apart(c, h.A, s.fs_base) ->
  abi.brk_start_ok(s.vm) -> mallocng_specs.errno_ok(s.vm, s.objs, s.fs_base) -> mallocng_specs.errno_apart(c, h.A, s.vm, s.fs_base) ->
  runs(c_src_malloc_mallocng_malloc.__libc_malloc_impl(n, gso, gmm, gwl, gsq, gam, gul, gmu, gs2c, grl, gac, gug, gas, gef), s, o) ->
  mp.mi_out(c, h.A, n, h.blocks, s, o)
proof
  assume hc hx hst hdj hlk hlc hnb hso hmm hwl hsq ham hul hmu hs2c hrl hac hug has hef hw hh hin hsh hnr htk hth htl hbs heo hea hr
  let A := h.A
  let B := h.blocks
  let V0 := s.vm
  have pu := apply(g.runs_univ, hr)
  have hu: s in univ(1) by simp(pu)
  have hgu _ hbt hat := mp(all_elim(mp.g_rec, {h}), hh)
  have au := mp(app_univ[u := 1, f := h, k := "A"], hgu)
  have vV vfun vdom vb := apply(ms.world_parts, hw)
  have fsb: s.fs_base in bits(64) by simp(expand(hw, abi.World))
  // size_overflows(n)
  have pso: mallocng_specs.size_overflows_pre(s.vm, s.objs, s.fs_base, n) by defs(taut(expand(heo, mallocng_specs.errno_ok)), mallocng_specs.size_overflows_pre)
  have ths: gc.sound(s) by simp(hth)
  step l1 l2 l3 l4 l5 l6 l7 l8 l9 l10 l11 l12 l13 l14 l15 V1 r1, e1 hR1 from hr with mp.sov_q using hso, hw, hu, hnb, pso, ths
  have v1v r1c := hR1
  have efl _ _ _ := expand(heo, mallocng_specs.errno_ok)
  have hfl: int_le(int_add(s.fs_base, 56), int_pow(2, 64)) by arith(efl, fsb)
  have fs0: all a. a in omega -> a in mallocng.footprint(c, A, B) -> a in mallocng.footprint(c, A, B) proof
    fix a
    assume _ x
    show x
  qed
  have grw0 := apply(mp.grown_sub[c := c, A := A, A2 := A, b := B, vm := V0], fs0)
  have eout := apply(mp.errno_out[c := c, A := A, A1 := A, B := B, V0 := V0, fs := s.fs_base], hea, fsb, hfl, grw0)
  // beyond the allocator's sizes: errno ENOMEM, 0
  have toobig: int_lt(9223372036854771710, n) -> mp.mi_out(c, A, n, B, s, o) proof
    assume hK
    have v1e: V1 = mallocng_specs.wr32(V0, mallocng_specs.errno_at(s.fs_base), 12) by taut(r1c, hK)
    have f1: bits_of_int(32, fst(r1)) = 1 by taut(r1c, hK)
    step e2 from e1 with (!(bits_of_int(32, fst(r1)) = 0) by simp(f1))
    have {hin1 = hin, ko1 = unt} := apply(mp.agr_errw[c := c, A := A, B := B, V := V0, fs := s.fs_base, e := 12], hin, vV, fsb, hfl, eout)
    have en0 := apply(mp.errno_wr[V := V0, fs := s.fs_base, e := 12], fsb, hfl, simp(), simp())
    have em: x86_64_linux.ENOMEM = 12 by defs(simp(), x86_64_linux.ENOMEM)
    have en1: mallocng_specs.errno_is(V1, s.fs_base, x86_64_linux.ENOMEM) := rewrite(sym(em), rewrite(sym(v1e), en0))
    have un1 := apply(mp.kept_unt[objs := s.objs], ko1)
    have r: (A in mallocng.Abs && A in univ(1)) && mallocng.no_reserved(A) && seq_len(A.taken) = 0 by taut(hat, au, hnr, htk)
    show by disj({2}, ex_intro({A}, {V1}, taut(r, v1v, rewrite(sym(v1e), hin1), hsh, rewrite(sym(v1e), un1), grw0, en1, e2)))
  qed
  have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], vfun, vdom)
  // within them: nothing done
  have fits: !int_lt(9223372036854771710, n) -> mp.mi_out(c, A, n, B, s, o) proof
    assume hK
    have v1e: V1 = V0 by taut(r1c, hK)
    have f0: bits_of_int(32, fst(r1)) = 0 by taut(r1c, hK)
    have e1s := rewrite(ss, rewrite(v1e, e1))
    have no: n in omega by arith(hnb)
    // a big request: a group of its own, mapped
    have big: int_lt(131051, n) -> mp.mi_out(c, A, n, B, s, o) proof
      assume hb
      let NN := int_add(n, 20)
      have nn: bits_add(64, n, 20) = NN by defs(arith(hK, no), bits_add, pow2)
      have nnb: NN in bits(64) by arith(hK, no)
      step e2 from e1s with f0, hb
      // mmap(0, n + 20, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0)
      let FMM := mallocng_specs.mmap_spec_fun()
      let OVF := exc_val("stack_overflow", empty)
      let ARGM := seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(gimple.arg(64, bits_of_int(64, 0))), seq_one(gimple.arg(64, NN))),
        seq_one(gimple.arg(32, bits_of_int(32, 3)))), seq_one(gimple.arg(32, bits_of_int(32, 34)))), seq_one(gimple.arg(32, bits_of_int(32, int_neg(1))))),
        seq_one(gimple.arg(64, bits_of_int(64, 0))))
      let NPG := fn_update(fn_update(empty, "prot", x86_64_linux.prot_of(bits_of_int(32, 3))), "kind", 0)
      let EA := mallocng_specs.errno_at(s.fs_base)
      let PM(V, r) := (V = mallocng_specs.wr32(V0, EA, x86_64_linux.ENOMEM) && fst(r) = bits_of_int(64, int_sub(int_pow(2, 64), 1))) ||
        (ex p. ((((p in omega && mallocng_specs.mmap_place(V0, 0, NN, bits_of_int(32, 34), p)) && gimple.fresh_pages(V0, V, s.objs, p, x86_64_linux.pages_for(NN), NPG)) &&
          V.brk = V0.brk) && fst(r) = bits_of_int(64, int_mul(p, x86_64_linux.PAGE))))
      have mc2: bits_of_int(32, 34) = int_add(x86_64_linux.MAP_PRIVATE, x86_64_linux.MAP_ANONYMOUS) by defs(simp(), x86_64_linux.MAP_PRIVATE, x86_64_linux.MAP_ANONYMOUS)
      have qmm: all regs o2. gc.regs_ok(regs, ARGM) -> runs(FMM[regs], s, o2) ->
          abi.ovf_out(s, o2) || (ex V r. (V in x86_64_linux.Vm && PM(V, r)) && o2 = ok(fn_update(s, "vm", V), r)) proof
        fix regs o2
        assume hro h2
        have ea: ARGM = seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(gimple.arg(64, bits_of_int(64, 0))), seq_one(gimple.arg(64, NN))),
          seq_one(gimple.arg(32, bits_of_int(32, 3)))), seq_one(gimple.arg(32, bits_of_int(32, 34)))), seq_one(gimple.arg(32, bits_of_int(32, int_neg(1))))),
          seq_one(gimple.arg(64, 0))) by simp()
        have q := apply(mp.mmap_q, hw, hu, (bits_of_int(64, 0) in bits(64) by simp()), nnb, (bits_of_int(32, 3) in bits(32) by simp()), (bits_of_int(32, 34) in bits(32) by simp()),
          (bits_of_int(32, int_neg(1)) in bits(32) by simp()), (bits_of_int(32, 34) = int_add(x86_64_linux.MAP_PRIVATE, x86_64_linux.MAP_ANONYMOUS) ||
            bits_of_int(32, 34) = int_add(int_add(x86_64_linux.MAP_PRIVATE, x86_64_linux.MAP_ANONYMOUS), x86_64_linux.MAP_FIXED) by taut(mc2)),
          (int_lt(bits_of_int(32, 3), 8) by simp()), heo,
          (ite(bits_of_int(32, 34) = int_add(int_add(x86_64_linux.MAP_PRIVATE, x86_64_linux.MAP_ANONYMOUS), x86_64_linux.MAP_FIXED),
            gimple.sys_pages_ok(s.vm, s.objs, x86_64_linux.page_of(bits_of_int(64, 0)), x86_64_linux.pages_for(NN)) &&
            mallocng_specs.tls_off(s.fs_base, x86_64_linux.page_of(bits_of_int(64, 0)), x86_64_linux.pages_for(NN)), bits_of_int(64, 0) = 0) by
            defs(simp(keep(gimple.sys_pages_ok, mallocng_specs.tls_off)), x86_64_linux.MAP_PRIVATE, x86_64_linux.MAP_ANONYMOUS, x86_64_linux.MAP_FIXED)),
          rewrite(ea, hro), h2)
        have b0: bits_of_int(64, 0) = 0 by simp()
        have k2: (ex e r. ((e in omega && mallocng_specs.mmap_err(bits_of_int(64, 0), NN, bits_of_int(32, 34), e)) && o2 = ok(fn_update(s, "vm", mallocng_specs.wr32(s.vm, mallocng_specs.errno_at(s.fs_base), e)), r)) &&
            fst(r) = bits_of_int(64, int_sub(int_pow(2, 64), 1))) ->
            (ex V r. (V in x86_64_linux.Vm && PM(V, r)) && o2 = ok(fn_update(s, "vm", V), r)) proof
          assume e
          obtain e1 r, _ hme ho hf from e
          // (errno ENOMEM: a length, no fixed address)
          have lnz: !(NN = 0) by arith(no)
          have me := apply(tr.ite_imp_f, expand(hme, mallocng_specs.mmap_err, x86_64_linux.MAP_PRIVATE, x86_64_linux.MAP_ANONYMOUS, x86_64_linux.MAP_FIXED), lnz)
          have e1n: e1 = x86_64_linux.ENOMEM by defs(simp(me), x86_64_linux.ENOMEM)
          have ho2: o2 = ok(fn_update(s, "vm", mallocng_specs.wr32(V0, EA, x86_64_linux.ENOMEM)), r) := rewrite(e1n, ho)
          have pm2: PM(mallocng_specs.wr32(V0, EA, x86_64_linux.ENOMEM), r) by taut(refl({mallocng_specs.wr32(V0, EA, x86_64_linux.ENOMEM)}), hf)
          show by ex_intro({mallocng_specs.wr32(V0, EA, x86_64_linux.ENOMEM)}, {r}, taut(apply(mp.w32_vm[V := V0, c := EA, v := x86_64_linux.ENOMEM], vV), pm2, ho2))
        qed
        have k3: (ex Vx p r. ((((((o2 = ok(fn_update(s, "vm", Vx), r) && fst(r) = bits_of_int(64, int_mul(p, x86_64_linux.PAGE))) && Vx in x86_64_linux.Vm) && p in omega) &&
            mallocng_specs.mmap_place(s.vm, bits_of_int(64, 0), NN, bits_of_int(32, 34), p)) &&
            gimple.fresh_pages(s.vm, Vx, s.objs, p, x86_64_linux.pages_for(NN), NPG)) && Vx.brk = s.vm.brk)) ->
            (ex V r. (V in x86_64_linux.Vm && PM(V, r)) && o2 = ok(fn_update(s, "vm", V), r)) proof
          assume e
          obtain Vx p r, ho hf hvx hp hpl hfr hbr from e
          have w: ex p1. (((p1 in omega && mallocng_specs.mmap_place(V0, 0, NN, bits_of_int(32, 34), p1)) && gimple.fresh_pages(V0, Vx, s.objs, p1, x86_64_linux.pages_for(NN), NPG)) &&
              Vx.brk = V0.brk) && fst(r) = bits_of_int(64, int_mul(p1, x86_64_linux.PAGE))
            by ex_intro({p}, taut(hp, rewrite(b0, hpl), hfr, hbr, hf))
          have pm3: PM(Vx, r) by taut(w)
          show by ex_intro({Vx}, {r}, taut(hvx, pm3, ho))
        qed
        show by taut(q, k2, k3)
      qed
      step V2 r2, hk2 kx2 hR2 from rewrite(nn, e2) with qmm using conj(hw, hu, ths, hmm, nnb)
      have v2v pm2 := hR2
      // refused: errno ENOMEM, 0
      have refused: V2 = mallocng_specs.wr32(V0, EA, x86_64_linux.ENOMEM) && fst(r2) = bits_of_int(64, int_sub(int_pow(2, 64), 1)) -> mp.mi_out(c, A, n, B, s, o) proof
        assume f
        have hve hf := f
        have nb1: bits_neg(64, 1) = bits_of_int(64, int_sub(int_pow(2, 64), 1)) by defs(simp(), bits_neg, pow2)
        step e3 from conj(hk2, kx2) with trans(hf, sym(nb1))
        have {hin2 = hin, ko2 = unt} := apply(mp.agr_errw[c := c, A := A, B := B, V := V0, fs := s.fs_base, e := x86_64_linux.ENOMEM], hin, vV, fsb, hfl, eout)
        have en2 := apply(mp.errno_wr[V := V0, fs := s.fs_base, e := x86_64_linux.ENOMEM], fsb, hfl, (x86_64_linux.ENOMEM in omega by defs(simp(), x86_64_linux.ENOMEM)),
          (int_lt(x86_64_linux.ENOMEM, 4294967296) by defs(simp(), x86_64_linux.ENOMEM)))
        have un2 := apply(mp.kept_unt[objs := s.objs], ko2)
        have r: (A in mallocng.Abs && A in univ(1)) && mallocng.no_reserved(A) && seq_len(A.taken) = 0 by taut(hat, au, hnr, htk)
        show by disj({2}, ex_intro({A}, {V2}, taut(r, v2v, rewrite(sym(hve), hin2), hsh, rewrite(sym(hve), un2), grw0, rewrite(sym(hve), en2), e3)))
