          let Z7 := x86_64_linux.store_le(Z6, int_add(fst(r5), 28), 4, bits_of_int(32, 0))
          let Z8 := x86_64_linux.store_le(Z7, int_add(fst(r5), 24), 4, bits_of_int(32, 0))
          let CN := bits_add(32, bits_of_int(32, gimple.bytes_at(fn_update(V5, "bytes", Z8), int_add(CTX, 12), 4)), 1)
          let Z9 := x86_64_linux.store_le(Z8, int_add(CTX, 12), 4, CN)
          let VF := fn_update(V5, "bytes", Z9)
          have t0 := mem_read({gimple.bytes_at(fn_update(V5, "bytes", Z2), M32, 1)}, mbr, r2b, mtopr, mrro, mctx, mpd, r2top, r2o, nkg, cv, pcx)
          have v5b: V5.bytes in fn_space(bits(64), bits(8)) by simp(expand(v5v, x86_64_linux.Vm))
          let B0 := gimple.bytes_at(V5, M32, 1)
          have b0o b0l := apply(g.bytes_bound, {V5}, {M32}, {1}, v5b, simp())
          have p1: int_pow(256, 1) = 256 by simp()
          have pw0: pow2(0) = 1 by simp()
          have pw5: pow2(5) = 32 by simp()
          have pw1: pow2(1) = 2 by simp()
          have pw6: pow2(6) = 64 by simp()
          have pw12: pow2(12) = 4096 by simp()
          have pw52: pow2(52) = 4503599627370496 by simp()
          have pw64: pow2(64) = 18446744073709551616 by simp()
          // (the last index: 0 in the low byte's low 5 bits)
          have lve: LV = int_add(bits_and(128, gimple.b128(B0), bits_not(128, gimple.b128(int_mul(int_pow(2, 0), int_sub(int_pow(2, 5), 1))))),
            int_mul(int_mod(0, int_pow(2, 5)), int_pow(2, 0))) := rewrite(t0, refl({LV}), {2})
          have lv0 := apply(mp.bfv[o := B0, pos := 0, k := 5, v := 0], b0o, arith(b0l, p1, pw64), simp(), simp(), simp())
          have lvv: LV = int_mul(32, int_div(B0, 32)) by arith(lve, lv0, b0o, b0l, p1, pw0, pw5)
          have t1 := mem_read({gimple.bytes_at(fn_update(V5, "bytes", Z3), M32, 1)}, mbr, r2b, mtopr, mrro, mctx, mpd, r2top, r2o, nkg, cv, pcx)
          let D1 := gimple.bytes_at(fn_update(V5, "bytes", Z3), M32, 1)
          have d1e: D1 = int_mod(LV, 256) := rewrite(p1, rewrite(sym(lve), t1))
          have d1v: D1 = LV by arith(d1e, lvv, b0o, b0l, p1)
          have d1o: D1 in omega by arith(d1v, lvv, b0o)
          have d1l: int_lt(D1, 256) by arith(d1v, lvv, b0o, b0l, p1)
          // (freeable: bit 5)
          have fr0 := apply(mp.bfv[o := D1, pos := 5, k := 1, v := 1], d1o, arith(d1l, pw64), simp(), simp(), simp())
          have frv: FRV = int_add(int_add(int_mul(64, int_div(D1, 64)), 32), int_mod(D1, 32)) by arith(fr0, d1o, d1l, pw5, pw1)
          have dm: int_mod(D1, 32) = 0 by arith(d1v, lvv, b0o)
          have fro1: FRV in omega by arith(frv, dm, d1o)
          have frl: int_lt(FRV, 256) by arith(frv, dm, d1o, d1l)
          have fm64: int_mod(FRV, 64) = 32 by arith(frv, dm, d1o)
          // (the class: bits 6 to 11 of the two low bytes)
          let U := gimple.bytes_at(fn_update(V5, "bytes", Z4), M32, 2)
          have m33: bits_add(64, M32, 1) = int_add(M32, 1) by defs(arith(mrro, mtopr), bits_add, pow2)
          have us := rewrite(m33, rewrite((int_add(1, 1) = 2 by simp()), apply(g.bytes_split, {fn_update(V5, "bytes", Z4)}, {M32}, {1}, {1}, arith(mrro, mtopr), simp(), simp())))
          have t3 := mem_read({gimple.bytes_at(fn_update(V5, "bytes", Z4), M32, 1)}, mbr, r2b, mtopr, mrro, mctx, mpd, r2top, r2o, nkg, cv, pcx)
          have t4 := mem_read({gimple.bytes_at(fn_update(V5, "bytes", Z4), int_add(M32, 1), 1)}, mbr, r2b, mtopr, mrro, mctx, mpd, r2top, r2o, nkg, cv, pcx)
          have u0: gimple.bytes_at(fn_update(V5, "bytes", Z4), M32, 1) = int_mod(FRV, 256) := rewrite(p1, rewrite(sym(t1), t3))
          let B1 := gimple.bytes_at(V5, int_add(M32, 1), 1)
          have b1o b1l := apply(g.bytes_bound, {V5}, {int_add(M32, 1)}, {1}, v5b, simp())
          have uv: U = int_add(FRV, int_mul(256, B1)) by arith(us, u0, t4, fro1, frl, p1)
          have uo: U in omega by arith(uv, fro1, b1o)
          have ul: int_lt(U, 65536) by arith(uv, frl, b1l, b1o, p1)
          have um64: int_mod(U, 64) = 32 by arith(uv, fm64, fro1, b1o)
          have sc0 := apply(mp.bfv[o := U, pos := 6, k := 6, v := 63], uo, arith(ul, pw64), simp(), simp(), simp())
          have scv: SCV = int_add(int_add(int_mul(4096, int_div(U, 4096)), 4032), int_mod(U, 64)) by arith(sc0, uo, ul, pw6)
          have scm: int_mod(SCV, 4096) = 4064 by arith(scv, um64, uo)
          have sco: SCV in omega && int_lt(SCV, 65536) by arith(scv, um64, uo, ul)
          have sco1 scl := sco
          // (the word: the class's store's two bytes, six old ones above; the
          // mapping's pages over bits 12 to 63)
          let W := gimple.bytes_at(fn_update(V5, "bytes", Z5), M32, 8)
          have m34: bits_add(64, M32, 2) = int_add(M32, 2) by defs(arith(mrro, mtopr), bits_add, pow2)
          have ws := rewrite(m34, rewrite((int_add(2, 6) = 8 by simp()), apply(g.bytes_split, {fn_update(V5, "bytes", Z5)}, {M32}, {2}, {6}, arith(mrro, mtopr), simp(), simp())))
          have wlo: gimple.bytes_at(fn_update(V5, "bytes", Z5), M32, 2) = int_mod(SCV, 65536) := apply(ms.rd_st2, {V5}, {Z4}, {M32}, {SCV}, arith(mrro), arith(mtopr))
          have z1t := mp(all_elim(x86.store_typed, {V5.bytes}, {int_add(fst(r5), 16)}, {8}, {fst(r2)}), v5b)
          have z2t := mp(all_elim(x86.store_typed, {Z1}, {int_add(fst(r2), 0)}, {8}, {fst(r5)}), z1t)
          have z3t := mp(all_elim(x86.store_typed, {Z2}, {M32}, {1}, {LV}), z2t)
          have z4t := mp(all_elim(x86.store_typed, {Z3}, {M32}, {1}, {FRV}), z3t)
          have z5t := mp(all_elim(x86.store_typed, {Z4}, {M32}, {2}, {SCV}), z4t)
          let H6 := gimple.bytes_at(fn_update(V5, "bytes", Z5), int_add(M32, 2), 6)
          have h6o h6l := apply(g.bytes_bound, {fn_update(V5, "bytes", Z5)}, {int_add(M32, 2)}, {6}, (fn_update(V5, "bytes", Z5).bytes in fn_space(bits(64), bits(8)) by simp(z5t)),
            simp())
          have p6: int_pow(256, 6) = 281474976710656 by simp()
          have p2: int_pow(256, 2) = 65536 by simp()
          have wv: W = int_add(SCV, int_mul(65536, H6)) by arith(ws, wlo, sco1, scl, p2)
          have wo: W in omega by arith(wv, sco1, h6o)
          have wl: int_lt(W, 18446744073709551616) by arith(wv, scl, h6l, h6o, p6)
          have wm: int_mod(W, 4096) = 4064 by arith(wv, scm, sco1, h6o)
          have kk: bits_of_int(52, bits_shr(64, bits_add(64, int_add(n, 20), 4095), 12)) = K by defs(arith(no, hK, kom, kle, klt), bits_of_int, bits_shr, bits_add, pow2,
            x86_64_linux.pages_for, x86_64_linux.PAGE)
          have bf0 := apply(mp.bfv[o := W, pos := 12, k := 52, v := bits_of_int(52, bits_shr(64, bits_add(64, int_add(n, 20), 4095), 12))], wo, arith(wl, pw64), simp(), simp(), simp())
          have bfw: BF = int_add(int_mul(4096, K), 4064) by arith(bf0, kk, wo, wl, wm, kom, kle, klt, mlow, pw12, pw52)
          // ---- the group's record: M's, its place among the groups in use
          have {H5 = inv} := expand(hin5, mallocng.holds_m)
          have {hpt5 = part, hnm5 = normal} := expand(H5, mallocng.holds)
          have {mnu = unused} := apply(mp.ng_taken[A := A1, T := A.taken, m := M], a1a, hpt5, tl0, tkm)
          have ul1: A1.used in list_type(omega) by simp(a1a)
          have {srt = sorted} := expand(hpt5, mallocng.metas_partition)
          have nin: all j. j in omega -> int_lt(j, seq_len(A1.used)) -> !(A1.used[j] = M) proof
            fix j
            assume hj hjl e
            show by taut(mnu, (mallocng.is_used(A1, M) by defs(ex_intro({j}, taut(hj, hjl, e)), mallocng.is_used)))
          qed
          obtain KK, kko kkl klo khi from apply(mp.ins_pos[l := A1.used, x := M], ul1, mo, srt, nin)
          let M0 := A1.metas[M]
          have m0t: M0 in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A1.metas, x := M], (A1.metas in fn_space(omega, mallocng.MetaV) by simp(a1a)), mo)
          have {nu0 = unused} := expand(hnm5, mallocng.normal)
          have m0z _ := mp(all_elim(nu0, {M}), mo, mnu)
          have zp: mallocng.ZERO_META.prev = 0 && mallocng.ZERO_META.next = 0 by defs(simp(), mallocng.ZERO_META)
          have m0p: M0.prev = 0 && M0.next = 0 := rewrite(sym(m0z), zp)
          have m0p1 m0p2 := m0p
          let VR := mp.mset(M0, P, 0, 0, 0, 1, 63, K)
          have vrt := apply(mp.mset_type[V := M0, p := P, av := 0, fr := 0, l := 0, f := 1, s := 63, ml := K], m0t, ppo, simp(), simp(), simp(), simp(), simp(), kom)
          have vmem: VR.mem = P by simp()
          have vml: VR.maplen = K by simp()
          have vpv: VR.prev = 0 by simp(m0p1)
          have vnx: VR.next = 0 by simp(m0p2)
          have vgr: mallocng.group_range(VR) = pair(P, NK) by defs(simp(vml, vmem, (int_lt(0, K) by arith(kge))), mallocng.group_range)
          have inrg: all a. mallocng.in_range(a, mallocng.group_range(VR)) -> int_le(P, a) && int_lt(a, int_add(P, NK)) proof
            fix a
            assume w
            show by simp(expand(rewrite(vgr, w), mallocng.in_range))
          qed
          // (its range: fresh -- none of the allocator's ranges, no client's
          // byte, nothing reserved, not M's record)
          have tm1: A1.taken[seq_len(A.taken)] = M := rewrite(sym(tkm), at({seq_concat(A.taken, seq_one(M))[seq_len(A.taken)]}, tl0))
          have tlen: seq_len(A1.taken) = int_add(seq_len(A.taken), 1) by arith(rewrite(sym(tkm), (seq_len(seq_concat(A.taken, seq_one(M))) = int_add(seq_len(A.taken), 1) by arith(tl0))), tl0)
          have {Hv0 = inv, hrw0 = rw} := expand(hin, mallocng.holds_m)
          have cm40: mallocng.META_SIZE = 40 by defs(refl({40}), mallocng.META_SIZE)
          have vfr: all a. a in omega -> mallocng.in_range(a, mallocng.group_range(VR)) ->
              !mallocng.in_ranges(a, mallocng.fp_ranges(c, A1)) && !(a in malloc.live_of(B)) && !mallocng.in_reserved(A1, a) && !mallocng.in_taken(A1, a) proof
            fix a
            assume hao w
            have w1 w2 := mp(all_elim(inrg, {a}), w)
            have qo: int_div(a, x86_64_linux.PAGE) in omega by defs(arith(hao), x86_64_linux.PAGE)
            have um m4 := mp(all_elim(fq, {int_div(a, x86_64_linux.PAGE)}), qo, arith(w1, hpo, pg), arith(w2, hpo, kom, pg))
            have nl: !(a in malloc.live_of(B)) proof
              assume hl
              obtain g, hg hir from apply(mp.live_grp[c := c, A := A, M := mallocng.mview(V0, mallocng.held(c, A, B)), b := B, brk := V0.brk, a := a], hat, hbt, Hv0, hl)
              have {go = nat} := apply(mp.used_nat, hat, hg)
              have o1 _ := mp(all_elim(expand(hrw0, mallocng.grp_rw), {g}, {a}), conj(go, hao), taut(hg, hir, hl))
              show by taut(um, apply(mp.rw_mapped[vm := V0, a := a], hao, o1))
            qed
            have nr := apply(mp.nores[A := A1, a := a], nr1)
            have nt: !mallocng.in_taken(A1, a) proof
              assume t
              obtain j, hj hjl from expand(t, mallocng.in_taken)
              have je: j = seq_len(A.taken) by arith(hjl, tlen, htk, hj)
              have tmj: A1.taken[j] = M := rewrite(sym(je), tm1)
              show by arith(hjl, tmj, cm40, mpd0, w1, w2, mo)
            qed
            have fa: !mallocng.in_ranges(a, mallocng.fp_ranges(c, A1)) proof
              assume ir
              have f1 := mp.fp_def[c := c, A := A1, b := B, a := a]
              have fa1: a in mallocng.footprint(c, A1, B) by taut(f1, hao, ir, nl, nr, nt)
              have g := mp(all_elim(grw5s, {a}), hao, fa1)
              have c1: !(a in mallocng.footprint(c, A, B)) proof
                assume f0
                show := apply(mp.fp_page[c := c, A := A, vm := V0, b := B, a := a, N := NN, p := p], hin, f0, hpo, (NN in omega by arith(no)), hpl,
                  arith(w1, hpo, pg), arith(w2, hpo, kom, pg))
              qed
              show by taut(g, c1, m4)
            qed
            show by taut(fa, nl, nr, nt)
          qed
          // (its pages, M's record: read-write, not the stack's)
          have vnp: all a. a in omega -> mallocng.in_range(a, mallocng.group_range(VR)) ->
              mallocng.m_rw(mallocng.mview(VF, mallocng.all_bytes()), a) && !(snd(mallocng.pg(mallocng.mview(VF, mallocng.all_bytes()), a)).kind = 2) proof
            fix a
            assume hao w
            have w1 w2 := mp(all_elim(inrg, {a}), w)
            have r5w r5k := apply(mp.fresh_rw[V := V5, p := p, N := NK, a := a], hpo, (NK in omega by arith(kom)), hao, np5, mlow, (int_mod(NK, 4096) = 0 by arith(kom)),
              arith(w1), arith(w2))
            have pe := apply(mp.view_pg[vm := V5, vm2 := VF, fp := mallocng.all_bytes(), a := a], hao, (VF.pages = V5.pages by simp()))
            have {rw = rw} := apply(mp.pg_same, pe)
            show by taut(rw, r5w, rewrite(sym(pe), r5k))
          qed
          have vmr: all a. a in omega -> int_le(M, a) -> int_lt(a, int_add(M, mallocng.META_SIZE)) ->
              mallocng.m_rw(mallocng.mview(VF, mallocng.all_bytes()), a) && !(snd(mallocng.pg(mallocng.mview(VF, mallocng.all_bytes()), a)).kind = 2) proof
            fix a
            assume hao h1 h2
            have _ e1 e2 := mp(all_elim(each, {int_sub(a, M)}), arith(h1), arith(h2, cm40))
            have ea: int_add(M, int_sub(a, M)) = a by arith()
            have pe := apply(mp.view_pg[vm := V5, vm2 := VF, fp := mallocng.all_bytes(), a := a], hao, (VF.pages = V5.pages by simp()))
            have {rw = rw} := apply(mp.pg_same, pe)
            show by taut(rw, rewrite(ea, e1), rewrite(sym(pe), rewrite(ea, e2)))
          qed
          // (the bytes outside the stores -- M's record past its links, the
          // header, the counter -- as before)
          have frb: all y. y in bits(64) -> (int_lt(y, int_add(M, 16)) || int_le(int_add(M, 40), y)) -> (int_lt(y, int_add(CTX, 12)) || int_le(int_add(CTX, 16), y)) ->
              (int_lt(y, P) || int_le(int_add(P, 8), y)) -> Z9[y] = V5.bytes[y] proof
            fix y
            assume hy o1 o2 o3
            have s9 := apply(ms.st_out, {Z8}, {int_add(CTX, 12)}, {4}, {CN}, {y}, hy, arith(cv), simp(), arith(cv), arith(o2))
            have s8 := apply(ms.st_out, {Z7}, {int_add(fst(r5), 24)}, {4}, {bits_of_int(32, 0)}, {y}, hy, arith(mrro), simp(), arith(mtopr), arith(o1, rm))
            have s7 := apply(ms.st_out, {Z6}, {int_add(fst(r5), 28)}, {4}, {bits_of_int(32, 0)}, {y}, hy, arith(mrro), simp(), arith(mtopr), arith(o1, rm))
            have s6 := apply(ms.st_out, {Z5}, {M32}, {8}, {BF}, {y}, hy, arith(mrro), simp(), arith(mtopr), arith(o1, rm))
            have s5 := apply(ms.st_out, {Z4}, {M32}, {2}, {SCV}, {y}, hy, arith(mrro), simp(), arith(mtopr), arith(o1, rm))
            have s4 := apply(ms.st_out, {Z3}, {M32}, {1}, {FRV}, {y}, hy, arith(mrro), simp(), arith(mtopr), arith(o1, rm))
            have s3 := apply(ms.st_out, {Z2}, {M32}, {1}, {LV}, {y}, hy, arith(mrro), simp(), arith(mtopr), arith(o1, rm))
            have s2 := apply(ms.st_out, {Z1}, {int_add(fst(r2), 0)}, {8}, {fst(r5)}, {y}, hy, arith(r2o), simp(), arith(r2top, nkg), arith(o3, rp))
            have s1 := apply(ms.st_out, {V5.bytes}, {int_add(fst(r5), 16)}, {8}, {fst(r2)}, {y}, hy, arith(mrro), simp(), arith(mtopr), arith(o1, rm))
            show := trans(s9, trans(s8, trans(s7, trans(s6, trans(s5, trans(s4, trans(s3, trans(s2, s1))))))))
          qed
          have {hm5 = mapped} := expand(hin5, mallocng.holds_m)
          have vby: all a. a in omega -> a in mallocng.held(c, A1, B) -> VF.bytes[bits_of_int(64, a)] = V5.bytes[bits_of_int(64, a)] proof
            fix a
            assume hao hh1
            have {hf = fp, nf = free} := apply(mp.held_fp, hh1)
            have lo := apply(mp.fp_low[c := c, A := A1, vm := V5, b := B, a := a], hm5, hf)
            have ea: bits_of_int(64, a) = a by defs(arith(hao, lo), bits_of_int, pow2)
            have yb: a in bits(64) by arith(hao, lo)
            have fd := mp.fp_def[c := c, A := A1, b := B, a := a]
            have _ irr _ _ _ := (a in omega && mallocng.in_ranges(a, mallocng.fp_ranges(c, A1)) && !(a in malloc.live_of(B)) && !mallocng.in_reserved(A1, a) &&
              !mallocng.in_taken(A1, a) by taut(fd, hf))
            have nt: !(int_le(M, a) && int_lt(a, int_add(M, 40))) proof
              assume w
              have w1 w2 := w
              have it: mallocng.in_taken(A1, a) by defs(ex_intro({seq_len(A.taken)}, taut((seq_len(A.taken) in omega by arith(tl0)), (int_lt(seq_len(A.taken), seq_len(A1.taken)) by arith(tlen, tl0)),
                rewrite(sym(tm1), w1), (int_lt(a, int_add(A1.taken[seq_len(A.taken)], mallocng.META_SIZE)) by arith(tm1, w2, cm40)))), mallocng.in_taken)
              show by taut(fd, hf, it)
            qed
            have nf2 := expand(nf, mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK)
            have np: !(int_le(P, a) && int_lt(a, int_add(P, 8))) proof
              assume w
              have w1 w2 := w
              have ig: mallocng.in_range(a, mallocng.group_range(VR)) by defs(simp(vgr, w1, (int_lt(a, int_add(P, NK)) by arith(w2, nkg))), mallocng.in_range)
              have nr0 _ _ _ := mp(all_elim(vfr, {a}), hao, ig)
              show by taut(nr0, irr)
            qed
            have f1 := mp(all_elim(frb, {a}), yb, arith(nt), arith(nf2, hx), arith(np))
            show by simp(ea, f1)
          qed
          // (the record, the header: read back)
          have ab: all a. a in omega -> a in mallocng.all_bytes() proof
            fix a
            assume hao
            show by defs(sel(taut(hao)), mallocng.all_bytes)
          qed
          have vr: all W. all a. all k. a in omega -> k in omega -> int_le(int_add(a, k), 18446744073709551616) ->
              gimple.bytes_at(W, a, k) = mallocng.rd(mallocng.mview(W, mallocng.all_bytes()), a, k) proof
            fix W a k
            assume hao hk hl
            have q: all i. i in omega -> int_lt(i, k) -> int_add(a, i) in mallocng.all_bytes() proof
              fix i
              assume hi hil
              show := mp(all_elim(ab, {int_add(a, i)}), arith(hao, hi))
            qed
            show := apply(mp.view_read[vm := W, fp := mallocng.all_bytes(), a := a, n := k], hao, hk, arith(hl, hk), q)
          qed
          have q16: gimple.bytes_at(VF, int_add(fst(r5), 16), 8) = fst(r2) by mem(mbr, r2b, mtopr, mrro, mctx, mpd, r2top, r2o, nkg, cv, pcx)
          have q24: gimple.bytes_at(VF, int_add(fst(r5), 24), 4) = 0 by mem(mbr, r2b, mtopr, mrro, mctx, mpd, r2top, r2o, nkg, cv, pcx)
          have q28: gimple.bytes_at(VF, int_add(fst(r5), 28), 4) = 0 by mem(mbr, r2b, mtopr, mrro, mctx, mpd, r2top, r2o, nkg, cv, pcx)
          have q32a: gimple.bytes_at(VF, M32, 8) = gimple.bytes_at(fn_update(V5, "bytes", Z6), M32, 8) by mem(mbr, r2b, mtopr, mrro, mctx, mpd, r2top, r2o, nkg, cv, pcx)
          have q32b := apply(mp.rd_st8[V := V5, B := Z5, a := M32, v := BF], arith(mrro), arith(mtopr))
          have q32: gimple.bytes_at(VF, M32, 8) = int_add(int_mul(4096, K), 4064) by arith(q32a, q32b, bfw, kom, klt, mlow)
          have qp: gimple.bytes_at(VF, int_add(fst(r2), 0), 8) = fst(r5) by mem(mbr, r2b, mtopr, mrro, mctx, mpd, r2top, r2o, nkg, cv, pcx)
          have ql0: gimple.bytes_at(VF, fst(r5), 8) = gimple.bytes_at(V5, fst(r5), 8) by mem(mbr, r2b, mtopr, mrro, mctx, mpd, r2top, r2o, nkg, cv, pcx)
          have ql8: gimple.bytes_at(VF, int_add(fst(r5), 8), 8) = gimple.bytes_at(V5, int_add(fst(r5), 8), 8) by mem(mbr, r2b, mtopr, mrro, mctx, mpd, r2top, r2o, nkg, cv, pcx)
          // (the final memory: a memory)
          have vf0: fn_update(V5, "bytes", V5.bytes) in x86_64_linux.Vm := rewrite(sym(mp(fn_update_same[f := V5, k := "bytes"], (is_fun(V5) by simp(expand(v5v, x86_64_linux.Vm))),
            ("bytes" in dom(V5) by simp(expand(v5v, x86_64_linux.Vm))))), v5v)
          have vf1 := apply(mp.vm_st, {V5}, {V5.bytes}, {int_add(fst(r5), 16)}, {8}, {fst(r2)}, vf0)
          have vf2 := apply(mp.vm_st, {V5}, {Z1}, {int_add(fst(r2), 0)}, {8}, {fst(r5)}, vf1)
          have vf3 := apply(mp.vm_st, {V5}, {Z2}, {M32}, {1}, {LV}, vf2)
          have vf4 := apply(mp.vm_st, {V5}, {Z3}, {M32}, {1}, {FRV}, vf3)
          have vf5 := apply(mp.vm_st, {V5}, {Z4}, {M32}, {2}, {SCV}, vf4)
          have vf6 := apply(mp.vm_st, {V5}, {Z5}, {M32}, {8}, {BF}, vf5)
          have vf7 := apply(mp.vm_st, {V5}, {Z6}, {int_add(fst(r5), 28)}, {4}, {bits_of_int(32, 0)}, vf6)
          have vf8 := apply(mp.vm_st, {V5}, {Z7}, {int_add(fst(r5), 24)}, {4}, {bits_of_int(32, 0)}, vf7)
          have vfv: VF in x86_64_linux.Vm := apply(mp.vm_st, {V5}, {Z8}, {int_add(CTX, 12)}, {4}, {CN}, vf8)
          have vfb: VF.bytes in fn_space(bits(64), bits(8)) by simp(expand(vfv, x86_64_linux.Vm))
          // (the mapping past the header: 0, as mmap gave it)
          have _ cb24 := expand(co24, mallocng_specs.ctx_only)
          have zr: all a. a in omega -> int_le(int_add(P, 8), a) -> int_lt(a, int_add(P, NK)) -> mallocng.b8(mallocng.mview(VF, mallocng.all_bytes()), a) = 0 proof
            fix a
            assume hao h1 h2
            have yb: a in bits(64) by arith(hao, h2, mlow, hpo)
            have ea: bits_of_int(64, a) = a by defs(arith(yb), bits_of_int, pow2)
            have b0v _ := apply(mp.b8_view[vm := VF, fp := mallocng.all_bytes(), a := a], vfb, hao, mp(all_elim(ab, {a}), hao))
            have f1 := mp(all_elim(frb, {a}), yb, arith(mpd0, h1, h2, mo), arith(pcx0, h1, h2, cv), arith(h1))
            have qo: int_div(a, x86_64_linux.PAGE) in omega by defs(arith(hao), x86_64_linux.PAGE)
            have q1: int_le(p, int_div(a, x86_64_linux.PAGE)) by arith(h1, hpo, pg)
            have q2: int_lt(int_div(a, x86_64_linux.PAGE), int_add(p, K)) by arith(h2, hpo, kom, pg)
            have um m4 := mp(all_elim(fq, {int_div(a, x86_64_linux.PAGE)}), qo, q1, q2)
            have nf: !(a in mallocng.footprint(c, A, B)) proof
              assume f
              show := apply(mp.fp_page[c := c, A := A, vm := V0, b := B, a := a, N := NN, p := p], hin, f, hpo, (NN in omega by arith(no)), hpl, q1, q2)
            qed
            have ne: !(a in mp.errno(s.fs_base)) proof
              assume e
              show by taut(mp(all_elim(errm, {a}), hao, e), um)
            qed
            have nq: V4.pages[int_div(a, x86_64_linux.PAGE)] = some(NPG) := trans(rewrite(ep24, refl({V4.pages[int_div(a, x86_64_linux.PAGE)]}), {2}),
              mp(all_elim(mnew, {int_div(a, x86_64_linux.PAGE)}), qo, q1, q2))
            have nsf: !abi.stack_free(V4, s.objs, a) by defs(simp(nq, m4), abi.stack_free)
            have b45 _ := mp(all_elim(u5a, {a}), hao, taut(nf, ne, m4))
            have e54 := mp(b45, nsf)
            have nfr: !mallocng.ctx_free(c, a) by defs(arith(pcx0, h1, h2, hx, cv), mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK)
            have e42 := mp(all_elim(cb24, {a}), yb, nfr)
            have e20 := mp(all_elim(mz, {a}), yb, arith(h1, hpo), arith(h2, hpo, kom))
            show by simp(b0v, ea, f1, rewrite(ea, e54), e42, e20)
          qed
          // (the record in memory: its links alloc_meta's, 0)
          have _ rq0 rq8 := expand(rdy, mallocng_specs.meta_ready)
          have ql0m: gimple.bytes_at(VF, M, 8) = gimple.bytes_at(V5, M, 8) := rewrite(rm, ql0)
          have ql8m: gimple.bytes_at(VF, int_add(M, 8), 8) = gimple.bytes_at(V5, int_add(M, 8), 8) := rewrite(rm, ql8)
          have q16a: gimple.bytes_at(VF, int_add(fst(r5), 16), 8) = P := rewrite(rp, q16)
          have q16m: gimple.bytes_at(VF, int_add(M, 16), 8) = P := rewrite(rm, q16a)
          have q24m: gimple.bytes_at(VF, int_add(M, 24), 4) = 0 := rewrite(rm, q24)
          have q28m: gimple.bytes_at(VF, int_add(M, 28), 4) = 0 := rewrite(rm, q28)
          have q32m: gimple.bytes_at(VF, int_add(M, 32), 8) = int_add(int_mul(4096, K), 4064) := rewrite(rm, q32)
          have pv0: mallocng.rd(mallocng.mview(VF, mallocng.all_bytes()), M, 8) = 0 := trans(sym(mp(all_elim(vr, {VF}, {M}, {8}), mo, simp(), arith(mtop))),
            trans(ql0m, trans(mp(all_elim(vr, {V5}, {M}, {8}), mo, simp(), arith(mtop)), rq0)))
          have nx0: mallocng.rd(mallocng.mview(VF, mallocng.all_bytes()), int_add(M, 8), 8) = 0 := trans(sym(mp(all_elim(vr, {VF}, {int_add(M, 8)}, {8}), arith(mo), simp(), arith(mtop))),
            trans(ql8m, trans(mp(all_elim(vr, {V5}, {int_add(M, 8)}, {8}), arith(mo), simp(), arith(mtop)), rq8)))
          have mi1: mallocng.rd(mallocng.mview(VF, mallocng.all_bytes()), int_add(M, 16), 8) = VR.mem :=
            trans(sym(mp(all_elim(vr, {VF}, {int_add(M, 16)}, {8}), arith(mo), simp(), arith(mtop))), trans(q16m, sym(vmem)))
          have mi2: mallocng.rd(mallocng.mview(VF, mallocng.all_bytes()), int_add(M, 24), 4) = VR.avail :=
            trans(sym(mp(all_elim(vr, {VF}, {int_add(M, 24)}, {4}), arith(mo), simp(), arith(mtop))), trans(q24m, (0 = VR.avail by simp())))
          have mi3: mallocng.rd(mallocng.mview(VF, mallocng.all_bytes()), int_add(M, 28), 4) = VR.freed :=
            trans(sym(mp(all_elim(vr, {VF}, {int_add(M, 28)}, {4}), arith(mo), simp(), arith(mtop))), trans(q28m, (0 = VR.freed by simp())))
          have vfl: VR.last_idx = 0 && VR.freeable = 1 && VR.sizeclass = 63 by simp()
          have vfl1 vfl2 vfl3 := vfl
          have mi4: mallocng.rd(mallocng.mview(VF, mallocng.all_bytes()), int_add(M, 32), 8) =
              int_add(int_add(int_add(VR.last_idx, int_mul(32, VR.freeable)), int_mul(64, VR.sizeclass)), int_mul(4096, VR.maplen))
            by arith(sym(mp(all_elim(vr, {VF}, {int_add(M, 32)}, {8}), arith(mo), simp(), arith(mtop))), q32m, vfl1, vfl2, vfl3, vml)
          have vrec: mallocng.meta_in_memory(mallocng.mview(VF, mallocng.all_bytes()), M, VR)
            by defs(taut(trans(pv0, sym(vpv)), trans(nx0, sym(vnx)), mi1, mi2, mi3, mi4, (int_lt(VR.last_idx, 32) by arith(vfl1)), vfl2,
              (int_lt(VR.sizeclass, 64) by arith(vfl3))), mallocng.meta_in_memory)
          // (the header: back to M)
          have qpm: gimple.bytes_at(VF, int_add(fst(r2), 0), 8) = M := rewrite(rm, qp)
          have hd1: mallocng.rd(mallocng.mview(VF, mallocng.all_bytes()), VR.mem, 8) = M :=
            subst({y. mallocng.rd(mallocng.mview(VF, mallocng.all_bytes()), y, 8) = M}, trans((int_add(fst(r2), 0) = fst(r2) by arith(r2o)), trans(rp, sym(vmem))),
              trans(sym(mp(all_elim(vr, {VF}, {int_add(fst(r2), 0)}, {8}), arith(r2o), simp(), arith(r2top, nkg))), qpm))
          have vhd: (mallocng.rd(mallocng.mview(VF, mallocng.all_bytes()), VR.mem, 8) = M && int_mod(VR.mem, 4096) = 0) && int_lt(0, VR.mem)
            by taut(hd1, (int_mod(VR.mem, 4096) = 0 by arith(vmem, hpo)), (int_lt(0, VR.mem) by arith(vmem, hpo, mone)))
          have vzr: all a. a in omega -> int_le(int_add(VR.mem, 8), a) -> int_lt(a, int_add(VR.mem, int_mul(VR.maplen, 4096))) ->
              mallocng.b8(mallocng.mview(VF, mallocng.all_bytes()), a) = 0 proof
            fix a
            assume hao h1 h2
            show := mp(all_elim(zr, {a}), hao, arith(h1, vmem), arith(h2, vmem, vml))
          qed
          // ---- the group made: the big group's step (mp.bgpre)
          let BM(x, k) := mallocng.unmap_ok(V5, x, k) && (all q. q in omega -> int_le(x, q) && int_lt(q, int_add(x, k)) -> x86_64_linux.mapped(V5, q))
          have pv: p = int_div(VR.mem, x86_64_linux.PAGE) by defs(arith(vmem), x86_64_linux.PAGE)
          have vm1 := subst({x. BM(x, K)}, pv, bmaps)
          have vmaps := subst({k. BM(int_div(VR.mem, x86_64_linux.PAGE), k)}, sym(vml), vm1)
          have GP: mp.bgpre(c, A1, V5, VF, B, KK, A.taken, M, VR) := conj(hc, a1u, a1a, hbt, v5v, vfv, hin5, tl0, tkm, hnz, vrt, conj(kko, kkl), klo, khi,
            ((((VR.sizeclass = 63 && VR.last_idx = 0) && VR.avail = 0) && VR.freed = 0) by simp()), (int_lt(0, VR.maplen) by arith(vml, kge)),
            vmaps, vfr, vnp, vmr,
            (VF.pages = V5.pages by simp()), (VF.brk = V5.brk by simp()), (VF.stack_top = V5.stack_top && VF.stack_limit = V5.stack_limit by simp()), vby, vrec,
            conj(vpv, vnx), vhd, vzr)
          have hinF := apply(mp.bg_holds_m, GP)
          let A2 := mp.bgrp(A1, KK, A.taken, M, VR)
          have {a2a = abs2, a2u = univ2} := apply(mp.bg_basic, GP)
          // (its bytes the C world's: A1's, the fresh pages')
          have hof2: all a. a in omega -> mallocng.in_range(a, mallocng.group_range(VR)) -> a in s.objs.c_bytes proof
            fix a
            assume hao w
            have w1 w2 := mp(all_elim(inrg, {a}), w)
            show := mp(all_elim(hof, {a}), hao, (int_le(int_mul(p, x86_64_linux.PAGE), a) && int_lt(a, int_mul(int_add(p, int_div(NK, 4096)), x86_64_linux.PAGE))
              by arith(w1, w2, pg, nkd, hpo, kom)))
          qed
          have qsh: all a. a in omega -> mallocng.in_ranges(a, mallocng.fp_ranges(c, A2)) -> mallocng.in_ranges(a, mallocng.fp_ranges(c, A1)) || a in s.objs.c_bytes proof
            fix a
            assume hao hr
            have bf := apply(mp.bg_fpr[c := c, A := A1, vm := V5, V1 := VF, b := B, k := KK, T := A.taken, m := M, V := VR, a := a], GP)
            have c2: mallocng.in_range(a, mallocng.group_range(VR)) -> a in s.objs.c_bytes proof
