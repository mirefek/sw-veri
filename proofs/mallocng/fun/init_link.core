// __init_libc, __init_tls, __init_ssp linked: their CFG forms (as
// proofs/mallocng/machine/link_start.core links them) refine their
// structured ones, and implement their purposes.

// (integer comparisons read their operands as integers -- anything else 0
// -- so flipping one needs no typing: the CFG's `i <= 2` the structured
// form's `!(2 < i)` for a loop's counter of no known type)
theorem g.iv_in(a): int_val(a) in int
proof
  have c1: a in int -> int_val(a) in int proof
    assume h
    show by defs(simp(h), int_val)
  qed
  have c2: !(a in int) -> int_val(a) in int proof
    assume h
    show by defs(simp(h), int_val, int)
  qed
  show by taut(c1, c2)
qed

theorem g.iv_id(x): x in int -> int_val(x) = x
proof
  assume h
  show by defs(simp(h), int_val)
qed

theorem g.iv_eq(a): int_val(int_val(a)) = int_val(a)
proof
  show := mp(g.iv_id[x := int_val(a)], g.iv_in[a := a])
qed

theorem g.add_vl(a, b): int_add(int_val(a), b) = int_add(a, b)
proof
  have e := g.iv_eq[a := a]
  show by defs(simp(e), int_add)
qed

theorem g.neg_v(a): int_neg(int_val(a)) = int_neg(a)
proof
  have e := g.iv_eq[a := a]
  show by defs(simp(e), int_neg)
qed

theorem g.succ_v(a): int_succ(int_val(a)) = int_succ(a)
proof
  have e := g.iv_eq[a := a]
  show by defs(simp(e), int_succ)
qed

theorem g.le_v(a, b): int_le(int_val(a), int_val(b)) = int_le(a, b)
proof
  have n := g.neg_v[a := a]
  have l := g.add_vl[a := b, b := int_neg(a)]
  show by defs(simp(n, l), int_le, int_sub)
qed

theorem g.lt_v(a, b): int_lt(int_val(a), int_val(b)) = int_lt(a, b)
proof
  have sv := g.succ_v[a := a]
  have l := g.add_vl[a := b, b := int_neg(int_succ(a))]
  show by defs(simp(sv, l), int_lt, int_le, int_sub)
qed

theorem g.lt_flip_any(a, b): int_lt(b, a) = (!int_le(a, b))
proof
  have f := g.lt_flip[a := int_val(a), b := int_val(b)]
  have f2 := mp(f, g.iv_in[a := a], g.iv_in[a := b])
  show := trans(sym(g.lt_v[a := b, b := a]), trans(f2, subst({y. (!int_le(int_val(a), int_val(b))) = (!y)}, g.le_v[a := a, b := b], refl({!int_le(int_val(a), int_val(b))}))))
qed

theorem g.le_flip_any(a, b): int_le(b, a) = (!int_lt(a, b))
proof
  have f := g.le_flip[a := int_val(a), b := int_val(b)]
  have f2 := mp(f, g.iv_in[a := a], g.iv_in[a := b])
  show := trans(sym(g.le_v[a := b, b := a]), trans(f2, subst({y. (!int_lt(int_val(a), int_val(b))) = (!y)}, g.lt_v[a := a, b := b], refl({!int_lt(int_val(a), int_val(b))}))))
qed

// (a function value with a guard -- the argument count -- and stack
// objects, as __init_libc's: its procedure's refinement)
theorem g.wrap_ref1_let(x. c, p1, p2, s. a, z s v o. k, z s e o. x, z t o. d): (all s r. runs(p1, s, r) -> runs(p2, s, r)) ->
  all s o. runs(mkprog(x1 x2. c(x1) || letin(a(x1), z. bind_rel(p1, x1, y v. k(z, y, v, x2), y e. x(z, y, e, x2), t. d(z, t, x2)))), s, o) ->
    runs(mkprog(x1 x2. c(x1) || letin(a(x1), z. bind_rel(p2, x1, y v. k(z, y, v, x2), y e. x(z, y, e, x2), t. d(z, t, x2)))), s, o)
proof
  assume h
  fix s o
  assume hr
  have u := apply(g.runs_univ, hr)
  have b := apply(g.runs_elim, hr)
  have c2: letin(a(s), z. bind_rel(p1, s, y v. k(z, y, v, o), y e. x(z, y, e, o), t. d(z, t, o))) -> letin(a(s), z. bind_rel(p2, s, y v. k(z, y, v, o), y e. x(z, y, e, o), t. d(z, t, o))) proof
    assume hb
    obtain r, r1 rc from expand(hb, letin, bind_rel)
    have r2 := mp(all_elim(h, {s}, {r}), r1)
    show by defs(ex_intro({r}, taut(r2, rc)), letin, bind_rel)
  qed
  have g: c(s) || letin(a(s), z. bind_rel(p2, s, y v. k(z, y, v, o), y e. x(z, y, e, o), t. d(z, t, o))) by taut(b, c2)
  show := apply(tr.runs_intro[r := x1 x2. c(x1) || letin(a(x1), z. bind_rel(p2, x1, y v. k(z, y, v, x2), y e. x(z, y, e, x2), t. d(z, t, x2)))], {s}, {o}, u, g)
qed

// (the structured side undefined: every outcome refines it)
theorem g.ref_undef(o. l): all s. g.ref(o. l(o), mkprog(x0 x1. true), s)
proof
  fix s
  have g: all o. l(o) -> pair(s, o) in univ(1) -> runs(mkprog(x0 x1. true), s, o) proof
    fix o
    assume _ hu
    show := apply(tr.runs_intro[r := x0 x1. true], {s}, {o}, hu, taut())
  qed
  show by defs(g, g.ref)
qed

theorem g.ref_undef2(o. l): all s. g.ref(o. l(o), mkprog(x0 x1. ex x2. true && x1 = x2), s)
proof
  fix s
  have g: all o. l(o) -> pair(s, o) in univ(1) -> runs(mkprog(x0 x1. ex x2. true && x1 = x2), s, o) proof
    fix o
    assume _ hu
    have e: ex x2. true && o = x2 by ex_intro({o}, taut(refl({o})))
    show := apply(tr.runs_intro[r := x0 x1. ex x2. true && x1 = x2], {s}, {o}, hu, e)
  qed
  show by defs(g, g.ref)
qed

// (a CFG's loop by its first trip: its ends, or the loop again -- for a
// CFG whose one block only ends or is undefined: the structured side
// undefined wherever the trip goes on)
theorem g.ref_while1(l0, l o. b, l. tr, r o. k, q, s):
  g.ref(o. ex x8. b(l0, x8) && ((ex l2. x8 = ok(l2, empty) && (ex r. while_rel(l0, l. true, l o. b(l, o), l. tr(l), r) && k(r, o))) || (!is_ok(x8) && k(x8, o))), q, s) ->
  g.ref(o. ex r. while_rel(l0, l. true, l o. b(l, o), l. tr(l), r) && k(r, o), q, s)
proof
  assume h
  have g: all o. (ex r. while_rel(l0, l. true, l o. b(l, o), l. tr(l), r) && k(r, o)) -> pair(s, o) in univ(1) -> runs(q, s, o) proof
    fix o
    assume hl hu
    obtain r, hw hk from hl
    have u := mp(while_unroll[l0 := l0, c := l. true, b := l o. b(l, o), tr := l. tr(l), r := r], hw)
    have c2: (true && b(l0, r) && !is_ok(r)) -> ex x8. b(l0, x8) && ((ex l2. x8 = ok(l2, empty) && (ex r. while_rel(l0, l. true, l o. b(l, o), l. tr(l), r) && k(r, o))) || (!is_ok(x8) && k(x8, o))) proof
      assume hc
      show by ex_intro({r}, taut(hc, hk))
    qed
    have c3: (true && (ex l1. b(l0, ok(l1, empty)) && (ex r1. while_rel(l1, l. true, l o. b(l, o), l. tr(l), r1) && fst(r1) = fst(r) && (!(fst(r) = 2) -> r1 = r)))) ->
        ex x8. b(l0, x8) && ((ex l2. x8 = ok(l2, empty) && (ex r. while_rel(l0, l. true, l o. b(l, o), l. tr(l), r) && k(r, o))) || (!is_ok(x8) && k(x8, o))) proof
      assume hc
      have he: ex l1. b(l0, ok(l1, empty)) && (ex r1. while_rel(l1, l. true, l o. b(l, o), l. tr(l), r1) && fst(r1) = fst(r) && (!(fst(r) = 2) -> r1 = r)) by taut(hc)
      obtain l1, hb _ from he
      have again: ex r. while_rel(l0, l. true, l o. b(l, o), l. tr(l), r) && k(r, o) by ex_intro({r}, taut(hw, hk))
      have on: ex l2. ok(l1, empty) = ok(l2, empty) && (ex r. while_rel(l0, l. true, l o. b(l, o), l. tr(l), r) && k(r, o)) by ex_intro({l1}, taut(refl({ok(l1, empty)}), again))
      show by ex_intro({ok(l1, empty)}, taut(hb, on))
    qed
    have e: ex x8. b(l0, x8) && ((ex l2. x8 = ok(l2, empty) && (ex r. while_rel(l0, l. true, l o. b(l, o), l. tr(l), r) && k(r, o))) || (!is_ok(x8) && k(x8, o))) by taut(u, c2, c3)
    show := mp(all_elim(expand(h, g.ref), {o}), e, hu)
  qed
  show by defs(g, g.ref)
qed

refines tls_sy1_ref c_src_env___init_tls_cfg.__syscall1_fun c_src_env___init_tls.__syscall1_fun
refines init_tp_ref c_src_env___init_tls_cfg.__init_tp_fun c_src_env___init_tls.__init_tp_fun
refines copy_tls_ref c_src_env___init_tls_cfg.__copy_tls_fun c_src_env___init_tls.__copy_tls_fun
refines sit_ref c_src_env___init_tls_cfg.static_init_tls_fun c_src_env___init_tls.static_init_tls_fun
refines ssp_gtp_ref c_src_env___stack_chk_fail_cfg.__get_tp_fun c_src_env___stack_chk_fail.__get_tp_fun
refines init_ssp_ref c_src_env___stack_chk_fail_cfg.__init_ssp_fun c_src_env___stack_chk_fail.__init_ssp_fun
refines init_libc_ref c_src_env___libc_start_main_cfg.__init_libc_fun c_src_env___libc_start_main.__init_libc_fun
refines start_init_ref c_src_env___libc_start_main_cfg.libc_start_init_fun c_src_env___libc_start_main.libc_start_init_fun
refines stage2_ref c_src_env___libc_start_main_cfg.libc_start_main_stage2_fun c_src_env___libc_start_main.libc_start_main_stage2_fun
refines start_main_ref c_src_env___libc_start_main_cfg.__libc_start_main_fun c_src_env___libc_start_main.__libc_start_main_fun
refines start_c_ref c_crt_crt1_cfg._start_c_fun c_crt_crt1._start_c_fun

// ----------------------------------------------------------------------
//  The linked CFG forms (link_start.core's) called as their purposes say,
//  and the machine code implementing them

// (memcpy's CFG form called as its contract says)
theorem lk.mcp: mp.calls(musl_asm_cfg.memcpy_fun(), mallocng_specs.memcpy_spec_fun())
proof
  fix regs s o
  assume h1 h2 h3 hr
  show := mp(all_elim(mp.memcpy_fun_c2, {regs}, {s}, {o}), h1, h2, h3, mp(all_elim(memcpy_ref, {regs}, {s}, {o}), h1, h2, h3, hr))
qed

// __init_ssp with memcpy and its unit's __get_tp
theorem lk.ssp_calls: all g. g.stack_chk_guard = c_src_env___stack_chk_fail.__stack_chk_guard -> g.builtin_tls = c_src_env___init_tls.builtin_tls ->
  mp.calls(sspl.F, startup_specs.init_ssp_spec_fun(g))
proof
  fix g
  assume hgG hgB
  let MC := musl_asm_cfg.memcpy_fun()
  let GT := c_src_env___stack_chk_fail_cfg.__get_tp_fun()
  fix regs s o
  assume h1 h2 h3 hr
  have hs := mp(all_elim(init_ssp_ref, {MC}, {GT}, {regs}, {s}, {o}), h1, h2, h3, hr)
  show := mp(all_elim(sp.ss_fun, {g}, {MC}, {GT}, {regs}, {s}, {o}), hgG, hgB, lk.mcp, ssp_gtp_ref, h1, h2, h3, hs)
qed

// __init_tls (static_init_tls) with its unit's __syscall6, __copy_tls
// (memcpy), __init_tp (__set_thread_area, the unit's __syscall1)
theorem lk.tls_calls: all g. g.libc = c_src_env___init_tls.__libc -> g.builtin_tls = c_src_env___init_tls.builtin_tls -> g.sysinfo = c_src_env___init_tls.__sysinfo ->
  g.main_tls = c_src_env___init_tls.main_tls -> g.default_stacksize = c_src_env___init_tls.__default_stacksize ->
  mp.calls(sitl.F, startup_specs.init_tls_spec_fun(g))
proof
  fix g
  assume hgL hgB hgS hgM hgD
  let MC := musl_asm_cfg.memcpy_fun()
  let SA := musl_asm_cfg.__set_thread_area_fun()
  let S1 := c_src_env___init_tls_cfg.__syscall1_fun()
  let S6 := c_src_env___init_tls_cfg.__syscall6_fun()
  let CT := c_src_env___init_tls_cfg.__copy_tls_fun(MC)
  let ITP := c_src_env___init_tls_cfg.__init_tp_fun(SA, S1)
  let AC := mallocng_specs.a_crash_spec_fun()
  have hCT := mp(all_elim(copy_tls_ref, {MC}), mcp.io)
  have hITP := all_elim(init_tp_ref, {SA}, {S1})
  have hr0 := mp(all_elim(sit_ref, {S6}, {CT}, {ITP}, {AC}), c1t6.io, ctll.io, itpl.io, acr.io)
  fix regs s o
  assume h1 h2 h3 hr
  have hs := mp(all_elim(hr0, {regs}, {s}, {o}), h1, h2, h3, hr)
  show := mp(all_elim(sp.sit_fun, {g}, {S6}, {CT}, {ITP}, {AC}, {MC}, {SA}, {S1}, {regs}, {s}, {o}), hgL, hgB, hgS, hgM, hgD, hCT, hITP, sta_ref, tls_sy1_ref,
    h1, h2, h3, hs)
qed

// __init_libc with __init_tls, __init_ssp (linked), its unit's
// __syscall3, __syscall2, a_crash's contract
theorem lk.libc_calls: all g.
  g.environ = c_src_env___libc_start_main.__environ -> g.hwcap = c_src_env___libc_start_main.__hwcap -> g.sysinfo = c_src_env___libc_start_main.__sysinfo ->
  g.libc = c_src_env___libc_start_main.__libc -> g.progname = c_src_env___libc_start_main.__progname -> g.progname_full = c_src_env___libc_start_main.__progname_full ->
  g.empty_str = c_src_env___libc_start_main.str_ -> g.main_tls = c_src_env___init_tls.main_tls -> g.builtin_tls = c_src_env___init_tls.builtin_tls ->
  g.stack_chk_guard = c_src_env___stack_chk_fail.__stack_chk_guard -> g.default_stacksize = c_src_env___init_tls.__default_stacksize ->
  mp.calls(ilcl.F, startup_specs.init_libc_spec_fun(g))
proof
  fix g
  assume hgE hgH hgS hgL hgP hgF hgZ hgM hgB hgG hgD
  // (the units' symbols at the same addresses)
  have eL: c_src_env___libc_start_main.__libc = c_src_env___init_tls.__libc by defs(simp(), c_src_env___libc_start_main.__libc, c_src_env___init_tls.__libc)
  have eS: c_src_env___libc_start_main.__sysinfo = c_src_env___init_tls.__sysinfo by defs(simp(), c_src_env___libc_start_main.__sysinfo, c_src_env___init_tls.__sysinfo)
  have hT := mp(all_elim(lk.tls_calls, {g}), trans(hgL, eL), hgB, trans(hgS, eS), hgM, hgD)
  have hS := mp(all_elim(lk.ssp_calls, {g}), hgG, hgB)
  let S3 := c_src_env___libc_start_main_cfg.__syscall3_fun()
  let S2 := c_src_env___libc_start_main_cfg.__syscall2_fun()
  let AC := mallocng_specs.a_crash_spec_fun()
  have hr0 := mp(all_elim(init_libc_ref, {sitl.F}, {sspl.F}, {S3}, {AC}, {S2}), sitl.io, sspl.io, c1l3.io, acr.io, c1l2.io)
  fix regs s o
  assume h1 h2 h3 hr
  have hs := mp(all_elim(hr0, {regs}, {s}, {o}), h1, h2, h3, hr)
  show := mp(all_elim(sp.il_fun, {g}, {sitl.F}, {sspl.F}, {S3}, {AC}, {S2}, {regs}, {s}, {o}), hgE, hgH, hgS, hgL, hgP, hgF, hgZ, hgM, hgB, hgG, hgD, hT, hS,
    h1, h2, h3, hs)
qed

// __init_libc's machine code (with its callees, linked) implements its
// purpose
theorem lk.libc_impl: all g statics.
  g.environ = c_src_env___libc_start_main.__environ -> g.hwcap = c_src_env___libc_start_main.__hwcap -> g.sysinfo = c_src_env___libc_start_main.__sysinfo ->
  g.libc = c_src_env___libc_start_main.__libc -> g.progname = c_src_env___libc_start_main.__progname -> g.progname_full = c_src_env___libc_start_main.__progname_full ->
  g.empty_str = c_src_env___libc_start_main.str_ -> g.main_tls = c_src_env___init_tls.main_tls -> g.builtin_tls = c_src_env___init_tls.builtin_tls ->
  g.stack_chk_guard = c_src_env___stack_chk_fail.__stack_chk_guard -> g.default_stacksize = c_src_env___init_tls.__default_stacksize ->
  tr.impl_m(false, false, 4199181, startup_specs.init_libc_spec_fun(g), 4198873, false, 4198400, text.code, statics)
proof
  fix g statics
  assume hgE hgH hgS hgL hgP hgF hgZ hgM hgB hgG hgD
  have c := mp(all_elim(lk.libc_calls, {g}), hgE, hgH, hgS, hgL, hgP, hgF, hgZ, hgM, hgB, hgG, hgD)
  show := mp(all_elim(tr.impl_m_refine, {false}, {false}, {4199181}, {ilcl.F}, {startup_specs.init_libc_spec_fun(g)}, {4198873}, {false}, {4198400}, {text.code}, {statics}),
    all_elim(ilcl.linked, {statics}), c)
qed
