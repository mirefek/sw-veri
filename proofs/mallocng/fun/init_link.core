// __init_libc, __init_tls, __init_ssp linked: their CFG forms (as
// proofs/mallocng/machine/link_start.core links them) refine their
// structured ones, and implement their purposes.

// (integer comparisons read their operands as integers -- anything else 0
// -- so flipping one needs no typing: the CFG's `i <= 2` the structured
// form's `!(2 < i)` for a loop's counter of no known type)
theorem g.iv_in(a): int_val(a) in int
proof
  have c1: a in int -> int_val(a) in int proof
    assume h
    show by defs(simp(h), int_val)
  qed
  have c2: !(a in int) -> int_val(a) in int proof
    assume h
    show by defs(simp(h), int_val, int)
  qed
  show by taut(c1, c2)
qed

theorem g.iv_id(x): x in int -> int_val(x) = x
proof
  assume h
  show by defs(simp(h), int_val)
qed

theorem g.iv_eq(a): int_val(int_val(a)) = int_val(a)
proof
  show := mp(g.iv_id[x := int_val(a)], g.iv_in[a := a])
qed

theorem g.add_vl(a, b): int_add(int_val(a), b) = int_add(a, b)
proof
  have e := g.iv_eq[a := a]
  show by defs(simp(e), int_add)
qed

theorem g.neg_v(a): int_neg(int_val(a)) = int_neg(a)
proof
  have e := g.iv_eq[a := a]
  show by defs(simp(e), int_neg)
qed

theorem g.succ_v(a): int_succ(int_val(a)) = int_succ(a)
proof
  have e := g.iv_eq[a := a]
  show by defs(simp(e), int_succ)
qed

theorem g.le_v(a, b): int_le(int_val(a), int_val(b)) = int_le(a, b)
proof
  have n := g.neg_v[a := a]
  have l := g.add_vl[a := b, b := int_neg(a)]
  show by defs(simp(n, l), int_le, int_sub)
qed

theorem g.lt_v(a, b): int_lt(int_val(a), int_val(b)) = int_lt(a, b)
proof
  have sv := g.succ_v[a := a]
  have l := g.add_vl[a := b, b := int_neg(int_succ(a))]
  show by defs(simp(sv, l), int_lt, int_le, int_sub)
qed

theorem g.lt_flip_any(a, b): int_lt(b, a) = (!int_le(a, b))
proof
  have f := g.lt_flip[a := int_val(a), b := int_val(b)]
  have f2 := mp(f, g.iv_in[a := a], g.iv_in[a := b])
  show := trans(sym(g.lt_v[a := b, b := a]), trans(f2, subst({y. (!int_le(int_val(a), int_val(b))) = (!y)}, g.le_v[a := a, b := b], refl({!int_le(int_val(a), int_val(b))}))))
qed

theorem g.le_flip_any(a, b): int_le(b, a) = (!int_lt(a, b))
proof
  have f := g.le_flip[a := int_val(a), b := int_val(b)]
  have f2 := mp(f, g.iv_in[a := a], g.iv_in[a := b])
  show := trans(sym(g.le_v[a := b, b := a]), trans(f2, subst({y. (!int_lt(int_val(a), int_val(b))) = (!y)}, g.lt_v[a := a, b := b], refl({!int_lt(int_val(a), int_val(b))}))))
qed

// (a function value with a guard -- the argument count -- and stack
// objects, as __init_libc's: its procedure's refinement)
theorem g.wrap_ref1_let(x. c, p1, p2, s. a, z s v o. k, z s e o. x, z t o. d): (all s r. runs(p1, s, r) -> runs(p2, s, r)) ->
  all s o. runs(mkprog(x1 x2. c(x1) || letin(a(x1), z. bind_rel(p1, x1, y v. k(z, y, v, x2), y e. x(z, y, e, x2), t. d(z, t, x2)))), s, o) ->
    runs(mkprog(x1 x2. c(x1) || letin(a(x1), z. bind_rel(p2, x1, y v. k(z, y, v, x2), y e. x(z, y, e, x2), t. d(z, t, x2)))), s, o)
proof
  assume h
  fix s o
  assume hr
  have u := apply(g.runs_univ, hr)
  have b := apply(g.runs_elim, hr)
  have c2: letin(a(s), z. bind_rel(p1, s, y v. k(z, y, v, o), y e. x(z, y, e, o), t. d(z, t, o))) -> letin(a(s), z. bind_rel(p2, s, y v. k(z, y, v, o), y e. x(z, y, e, o), t. d(z, t, o))) proof
    assume hb
    obtain r, r1 rc from expand(hb, letin, bind_rel)
    have r2 := mp(all_elim(h, {s}, {r}), r1)
    show by defs(ex_intro({r}, taut(r2, rc)), letin, bind_rel)
  qed
  have g: c(s) || letin(a(s), z. bind_rel(p2, s, y v. k(z, y, v, o), y e. x(z, y, e, o), t. d(z, t, o))) by taut(b, c2)
  show := apply(tr.runs_intro[r := x1 x2. c(x1) || letin(a(x1), z. bind_rel(p2, x1, y v. k(z, y, v, x2), y e. x(z, y, e, x2), t. d(z, t, x2)))], {s}, {o}, u, g)
qed

