// free_group(g) by its purpose: g, all of whose slots are free (one
// reserved: the slot its last block was in), given back -- out of the
// groups in use (proofs/mallocng/model/dropgroup.core), its meta returned
// to the free list (free_meta); a nested group's slot in its container
// reserved and given back in turn (nontrivial_free), a group mapped on its
// own let go (its mapping returned).

// ----------------------------------------------------------------------
//  g's meta: the allocator's bytes, ready to be freed

// (a meta in use: its bytes the allocator's, read by the invariant)
theorem mp.meta_held(c, A, M, b, brk, g, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds(c, A, M, b, brk) ->
  mallocng.is_used(A, g) -> a in omega -> int_le(g, a) -> int_lt(a, int_add(g, 40)) ->
  fp: a in mallocng.footprint(c, A, b) && held: a in mallocng.held(c, A, b)
proof
  assume hc hu ha H hg hao h1 h2
  have {hpt = part, hff = fixed} := expand(H, mallocng.holds)
  have {usl = used_slots} := expand(hpt, mallocng.metas_partition)
  obtain kg, hkg hkgl hkge from expand(hg, mallocng.is_used)
  have gms := rewrite(hkge, mp(all_elim(usl, {kg}), hkg, hkgl))
  have {go = nat, lex = area} := apply(mp.meta_page, ha, gms)
  obtain k, hk hkl l1 l2 _ from lex
  have rl: A.areas in list_type(omega) by simp(ha)
  have al: seq_len(A.areas) in omega by arith(rl)
  have ako := mp(at_type[l := A.areas, t := omega, i := k], rl, hk, hkl)
  have a1: int_le(A.areas[k], a) by arith(l1, h1, ako, go)
  have a2: int_lt(a, int_add(A.areas[k], 4096)) by arith(l2, h2)
  have nt := apply(mp.untaken_meta[c := c, A := A, M := M, b := b, brk := brk, g := g, a := a], hc, hu, ha, H, gms, apply(mp.used_untaken, H, hg), hao, h1, h2)
  have {fa = areas} := expand(hff, mallocng.fixed_free)
  have nl := mp(all_elim(fa, {k}, {a}), conj(hk, hao), taut(hkl, a1, a2))
  have nr := apply(mp.unres_area[c := c, A := A, M := M, b := b, brk := brk, k := k, a := a], hc, hu, ha, H, hao, hk, hkl, a1, a2)
  have rr: mallocng.in_range(a, pair(A.areas[k], 4096)) by defs(simp(a1, a2), mallocng.in_range)
  have ir := apply(mp.ranges_build[r := x. pair(A.areas[x], 4096)], al, hk, hkl, rr)
  have fp := apply(mp.fp_intro, hc, hu, ha, hao, nl, nr, nt, taut(ir))
  have hd := apply(mp.area_held[c := c, A := A, M := M, b := b, brk := brk, k := k, a := a], hc, hu, ha, H, hk, hkl, hao, a1, a2, fp)
  show by taut(fp, hd)
qed

// a meta in use, unlinked: ready to be freed (its bytes accessible, its
// links 0)
theorem mp.used_ready(c, A, vm, b, g): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_m(c, A, vm, b) ->
  mallocng.is_used(A, g) -> A.metas[g].next = 0 -> mallocng_specs.meta_ready(vm, g)
proof
  assume hc hu ha hh hg nx
  let M := mallocng.mview(vm, mallocng.held(c, A, b))
  let MA := mallocng.mview(vm, mallocng.all_bytes())
  have {H = inv} := expand(hh, mallocng.holds_m)
  have {huo = used, har = areas, hpt = part} := expand(H, mallocng.holds)
  have {go = nat} := apply(mp.used_nat, ha, hg)
  // (its bytes: the same through either view)
  have ag: all a. a in omega -> int_le(g, a) -> int_lt(a, int_add(g, 40)) -> MA[a] = M[a] proof
    fix a
    assume hao h1 h2
    have {hd = held} := apply(mp.meta_held[c := c, A := A, M := M, b := b, brk := vm.brk, g := g, a := a], hc, hu, ha, H, hg, hao, h1, h2)
    have ab: a in mallocng.all_bytes() by defs(sel(taut(hao)), mallocng.all_bytes)
    show := apply(mp.view_mem[vm := vm, F1 := mallocng.all_bytes(), F2 := mallocng.held(c, A, b), a := a], hao, taut(ab, hd))
  qed
  // accessible: its meta area's page, no meta taken there
  have {usl = used_slots} := expand(hpt, mallocng.metas_partition)
  obtain kg, hkg hkgl hkge from expand(hg, mallocng.is_used)
  have gms := rewrite(hkge, mp(all_elim(usl, {kg}), hkg, hkgl))
  have {lex = area} := apply(mp.meta_page, ha, gms)
  obtain k, hk hkl l1 l2 _ from lex
  have {ea = each} := expand(har, mallocng.areas_ok)
  have _ _ _ _ _ pr := mp(all_elim(ea, {k}), hk, hkl)
  have rl: A.areas in list_type(omega) by simp(ha)
  have ako := mp(at_type[l := A.areas, t := omega, i := k], rl, hk, hkl)
  have cm: mallocng.META_SIZE = 40 by defs(refl({40}), mallocng.META_SIZE)
  have rw: all a. a in omega -> int_le(g, a) && int_lt(a, int_add(g, mallocng.META_SIZE)) -> mallocng.m_rw(MA, a) && !(snd(mallocng.pg(MA, a)).kind = 2) proof
    fix a
    assume hao h
    have h1 h2 := h
    have h2b: int_lt(a, int_add(g, 40)) by arith(h2, cm)
    have nt := apply(mp.untaken_meta[c := c, A := A, M := M, b := b, brk := vm.brk, g := g, a := a], hc, hu, ha, H, gms, apply(mp.used_untaken, H, hg), hao, h1, h2b)
    have o1 o2 := mp(all_elim(pr, {a}), hao, conj(conj((int_le(A.areas[k], a) by arith(l1, h1, ako, go)), (int_lt(a, int_add(A.areas[k], 4096)) by arith(l2, h2b))), nt))
    have {pe = page} := apply(mp.agree_b8, mp(all_elim(ag, {a}), hao, h1, h2b))
    have {r = rw} := apply(mp.pg_same, pe)
    show by taut(r, o1, rewrite(sym(pe), o2))
  qed
  // its links: 0 (unlinked)
  have {hmg = mim, ulg = unlinked} := expand(apply(mp.used_group, huo, hg), mallocng.group_ok)
  have rp rn _ _ _ _ _ _ _ := expand(hmg, mallocng.meta_in_memory)
  have pz := mp(ulg, nx)
  have a0: all i. i in omega -> int_lt(i, 8) -> MA[int_add(g, i)] = M[int_add(g, i)] proof
    fix i
    assume hi hil
    show := mp(all_elim(ag, {int_add(g, i)}), simp(go, hi), arith(go, hi), arith(go, hi, hil))
  qed
  have a8: all i. i in omega -> int_lt(i, 8) -> MA[int_add(int_add(g, 8), i)] = M[int_add(int_add(g, 8), i)] proof
    fix i
    assume hi hil
    have e: int_add(int_add(g, 8), i) = int_add(g, int_add(8, i)) by arith(go, hi)
    show := rewrite(sym(e), mp(all_elim(ag, {int_add(g, int_add(8, i))}), simp(go, hi), arith(go, hi), arith(go, hi, hil)))
  qed
  have r0 := trans(apply(mp.agree_rd[M := M, M2 := MA, a := g, n := 8], simp(), a0), trans(rp, pz))
  have r8 := trans(apply(mp.agree_rd[M := M, M2 := MA, a := int_add(g, 8), n := 8], simp(), a8), trans(rn, nx))
  show by defs(taut(rw, r0, r8), mallocng_specs.meta_ready)
qed

// ----------------------------------------------------------------------
//  Helpers

// (a memory as another but for its bytes: its pages, its break, its
// stack's bounds the same)
theorem mp.bytes_only(V, vm): fn_update(V, "bytes", vm.bytes) = vm ->
  pages: V.pages = vm.pages && brk: V.brk = vm.brk && top: V.stack_top = vm.stack_top && limit: V.stack_limit = vm.stack_limit
proof
  assume e
  have up := mp(app_update_other[f := V, k := "bytes", v := vm.bytes, x := "pages"], (!("pages" = "bytes") by simp()))
  have ub := mp(app_update_other[f := V, k := "bytes", v := vm.bytes, x := "brk"], (!("brk" = "bytes") by simp()))
  have ut := mp(app_update_other[f := V, k := "bytes", v := vm.bytes, x := "stack_top"], (!("stack_top" = "bytes") by simp()))
  have ul := mp(app_update_other[f := V, k := "bytes", v := vm.bytes, x := "stack_limit"], (!("stack_limit" = "bytes") by simp()))
  show by taut(sym(rewrite(e, up)), sym(rewrite(e, ub)), sym(rewrite(e, ut)), sym(rewrite(e, ul)))
qed

// (a live byte: in a block's slot of a group in use)
theorem mp.live_block(c, A, M, b, brk, a): A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) -> mallocng.holds(c, A, M, b, brk) ->
  a in malloc.live_of(b) -> ex x j. mallocng.is_used(A, x) && j in omega && int_lt(j, seq_len(A.slots[x])) && fst(A.slots[x][j]) = 1 &&
    mallocng.in_range(a, mallocng.group_range(A.metas[x]))
proof
  assume ha hb H hl
  have {huo = used, hbl = in_slots} := expand(H, mallocng.holds)
  have s1 := set_select_def[s := omega, p := y. ex q. q in bits(64) && (!(b[q] = none) && y in malloc.range(q, snd(b[q]))), z := a]
  have ao ex := (a in omega && (ex q. q in bits(64) && (!(b[q] = none) && a in malloc.range(q, snd(b[q])))) by taut(s1, expand(hl, malloc.live_of)))
  obtain p, hp hn hr from ex
  have s2 := set_select_def[s := omega, p := y. int_le(p, y) && int_lt(y, int_add(p, snd(b[p]))), z := a]
  have _ r1 r2 := (a in omega && (int_le(p, a) && int_lt(a, int_add(p, snd(b[p])))) by taut(s2, expand(hr, malloc.range)))
  obtain k j, hk hj hkl hjl hs from mp(all_elim(expand(hbl, mallocng.blocks_ok), {p}), hp, hn)
  let g := A.used[k]
  let V := A.metas[g]
  have ul: A.used in list_type(omega) by simp(ha)
  have go := apply(at_type[l := A.used, t := omega, i := k], ul, hk, hkl)
  have gok := mp(all_elim(expand(huo, mallocng.used_ok), {k}), hk, hkl)
  have {gso = slots} := expand(gok, mallocng.group_ok)
  have so := mp(all_elim(gso, {j}), hj, hjl)
  have po: p in omega by arith(hp)
  have pb: bits_of_int(64, p) = p := mp(bits_of_int_small[n := 64, a := p], po, (int_lt(p, pow2(64)) by arith(hp)))
  have s3: !(b[bits_of_int(64, p)] = none) && mallocng.hdr_free(b, p) && mallocng.frame_ok(M, V, j, p, snd(b[bits_of_int(64, p)]), 0)
    by simp(expand(rewrite(hs, so), mallocng.slot_ok))
  have fo: mallocng.frame_ok(M, V, j, p, snd(b[p]), 0) := rewrite(pb, (mallocng.frame_ok(M, V, j, p, snd(b[bits_of_int(64, p)]), 0) by taut(s3)))
  have {f1 = start, f3 = fits} := expand(fo, mallocng.frame_ok)
  have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
  have isl: mallocng.in_slot(V, j, a) by defs(arith(f1, f3, r1, r2, ci), mallocng.in_slot)
  have inr := apply(mp.slot_in_group[A := A, M := M, b := b, g := g, i := j, a := a], ha, go, hj, ao, gok, hjl, isl)
  have iu: mallocng.is_used(A, g) by defs(ex_intro({k}, taut(hk, hkl, refl({g}))), mallocng.is_used)
  show by ex_intro({g}, {j}, taut(iu, hj, hjl, (fst(A.slots[g][j]) = 1 by simp(hs)), inr))
qed

// (a group all of whose slots are free: none a block's, none nesting)
theorem mp.emp_tags(A, g): mallocng.emptied(A, g) ->
  all j. j in omega -> int_lt(j, seq_len(A.slots[g])) -> !(fst(A.slots[g][j]) = 1) && !(fst(A.slots[g][j]) = 2)
proof
  assume emp
  have em1 _ := expand(emp, mallocng.emptied)
  fix j
  assume hj hjl
  have q := mp(all_elim(em1, {j}), hj, hjl)
  have c1: A.slots[g][j] = tag(0, empty) -> !(fst(A.slots[g][j]) = 1) && !(fst(A.slots[g][j]) = 2) proof
    assume e
    show by simp(e)
  qed
  have c2: A.slots[g][j] = tag(3, empty) -> !(fst(A.slots[g][j]) = 1) && !(fst(A.slots[g][j]) = 2) proof
    assume e
    show by simp(e)
  qed
  show by taut(q, c1, c2)
qed

// (a group mapped on its own, all its slots free: no client's byte in its
// range)
theorem mp.live_off_own(c, A, M, b, brk, g, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  mallocng.holds(c, A, M, b, brk) -> mallocng.is_used(A, g) -> int_lt(0, A.metas[g].maplen) -> mallocng.emptied(A, g) -> a in malloc.live_of(b) ->
  !mallocng.in_range(a, mallocng.group_range(A.metas[g]))
proof
  assume hc hu ha hb H hg mg emp hl
  have ao: a in omega by taut(mp.live_def[b := b, a := a], hl)
  obtain x j, hx hj hjl hf1 hr from apply(mp.live_block[c := c, A := A, M := M, b := b, brk := brk, a := a], ha, hb, H, hl)
  have et := apply(mp.emp_tags[A := A, g := g], emp)
  have xg: !(x = g) proof
    assume e
    have n1 _ := mp(all_elim(et, {j}), hj, rewrite(e, hjl))
    show by taut(n1, rewrite(e, hf1))
  qed
  have gnn: all i. i in omega -> int_lt(i, seq_len(A.slots[g])) -> !(fst(A.slots[g][i]) = 2) proof
    fix i
    assume hi hil
    have _ n2 := mp(all_elim(et, {i}), hi, hil)
    show := n2
  qed
  show := apply(mp.own_disj[c := c, A := A, M := M, b := b, brk := brk, g := g, x := x, a := a], hc, hu, ha, H, hg, mg, gnn, hx, xg, ao, hr)
qed

// (the allocator after a group given back: within it before)
theorem mp.dr_fpsub(c, A, A2, M, b, brk, g, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds(c, A, M, b, brk) ->
  A2 in univ(1) -> A2 in mallocng.Abs -> mp.dropr(A, A2, g) -> mallocng.fixed_ranges(c, A2) = mallocng.fixed_ranges(c, A) ->
  (all x. mallocng.in_taken(A, x) -> mallocng.in_taken(A2, x)) ->
  (all x y. mallocng.is_used(A2, x) -> y in omega -> mallocng.in_range(y, mallocng.group_range(A2.metas[x])) -> !(y in malloc.live_of(b)) ->
     !mallocng.in_reserved(A2, y) -> !mallocng.in_reserved(A, y)) ->
  a in mallocng.footprint(c, A2, b) -> a in mallocng.footprint(c, A, b)
proof
  assume hc hu ha H hu2 ha2 dr fe tk hr3 f2
  have {huo = used, hga = apart} := expand(H, mallocng.holds)
  have ao ir nl nr2 nt := (a in omega && mallocng.in_ranges(a, mallocng.fp_ranges(c, A2)) && !(a in malloc.live_of(b)) && !mallocng.in_reserved(A2, a) &&
    !mallocng.in_taken(A2, a) by taut(apply(mp.fp_def[c := c, A := A2, b := b, a := a]), f2))
  have {g2 = groups} := apply(mp.fp_pieces, hc, hu2, ha2)
  have x2: mallocng.fixed_ranges(c, A2) in list_type(univ(1)) by defs(apply(mp.pre_list, hc, hu2, ha2), mallocng.fixed_ranges)
  let G2 := fn_build(int_sub(seq_len(A2.used), 0), x0. mallocng.group_range(A2.metas[A2.used[int_add(0, x0)]]))
  have c2 := apply(mp.ranges_cat[a := a, xs := mallocng.fixed_ranges(c, A2), ys := G2], x2, g2)
  have r2 := apply(mp.grp_ranges[A := A2, a := a], ha2)
  have i0: mallocng.in_ranges(a, seq_concat(mallocng.fixed_ranges(c, A2), G2)) by defs(ir, mallocng.fp_ranges)
  have d1: mallocng.in_ranges(a, mallocng.fixed_ranges(c, A2)) -> !mallocng.in_reserved(A, a) proof
    assume f
    have f1 := rewrite(fe, f)
    have fc := apply(mp.fixed_cases[c := c, A := A, a := a], hc, hu, ha)
    have o1 := mp.ranges_one[a := a, r := pair(A.reserve, int_mul(4096, A.reserve_cnt))]
    have o2 := mp.ranges_one[a := a, r := pair(c.sct, int_mul(2, 48))]
    have o3 := mp.ranges_one[a := a, r := pair(c.dbj, 32)]
    show := apply(mp.fixed_unres[c := c, A := A, M := M, b := b, a := a], hc, hu, ha, ao, huo, hga, taut(fc, f1, o1, o2, o3))
  qed
  have d2: (ex x. mallocng.is_used(A2, x) && mallocng.in_range(a, mallocng.group_range(A2.metas[x]))) -> !mallocng.in_reserved(A, a) proof
    assume e
    obtain x, iu2 hr from e
    show := mp(all_elim(hr3, {x}, {a}), iu2, ao, hr, nl, nr2)
  qed
  have nr1: !mallocng.in_reserved(A, a) by taut(c2, r2, i0, d1, d2)
  have ir1 := apply(mp.dr_fpr[c := c, A := A, A2 := A2, g := g, a := a], hc, hu, ha, hu2, ha2, dr, fe, ir)
  have nt1: !mallocng.in_taken(A, a) by taut(all_elim(tk, {a}), nt)
  show by taut(apply(mp.fp_def[c := c, A := A, b := b, a := a]), ao, ir1, nl, nr1, nt1)
qed

// ----------------------------------------------------------------------
//  A group mapped on its own given back: its meta freed, its mapping let
//  go

theorem mp.fg_own_out(c, A, s, b, g, k, V1, V2): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  s in abi.World -> mallocng.holds_in(c, A, s.vm, s.objs, b) -> int_mod(c.ctx, 8) = 0 ->
  k in omega -> int_lt(k, seq_len(A.used)) -> A.used[k] = g -> int_lt(0, A.metas[g].maplen) -> mallocng.emptied(A, g) -> A.metas[g].next = 0 ->
  V1 in x86_64_linux.Vm -> mallocng_specs.ctx_only(c, s.vm, V1) -> V2 in x86_64_linux.Vm ->
  mallocng_specs.meta_freed(V1, V2, s.objs, int_add(c.ctx, 16), g) ->
  ex A2. (A2 in mallocng.Abs && A2 in univ(1)) &&
    mallocng_specs.freed_back(c, A, A2, b, s.vm, V2, s.objs, A.metas[g].mem, int_mul(A.metas[g].maplen, 4096))
proof
  assume hc hu ha hb hw hin cal hk hkl hkg mg emp nx v1v co v2v hfd
  let D := mp.drop(A, g, k)
  let E := set_select(omega, x0. mallocng.in_reserved(A, x0))
  let M := mallocng.mview(s.vm, mallocng.held(c, A, b))
  have {hh = mem, hsh = shown} := expand(hin, mallocng.holds_in)
  have {H = inv} := expand(hh, mallocng.holds_m)
  have {huo = used, hnm = normal, hga = apart} := expand(H, mallocng.holds)
  have ul: A.used in list_type(omega) by simp(ha)
  have go: g in omega := rewrite(hkg, apply(at_type[l := A.used, t := omega, i := k], ul, hk, hkl))
  have hg: mallocng.is_used(A, g) by defs(ex_intro({k}, taut(hk, hkl, hkg)), mallocng.is_used)
  have tl: A.taken in list_type(omega) by simp(ha)
  // the counters: the context's free bytes only
  have hh1 := apply(mp.co_holds[c := c, A := A, vm := s.vm, vm2 := V1, b := b], hh, co)
  have hin1: mallocng.holds_in(c, A, V1, s.objs, b) by defs(taut(hh1, hsh), mallocng.holds_in)
  have e1 _ := expand(co, mallocng_specs.ctx_only)
  have {p1 = pages} := apply(mp.bytes_only[V := V1, vm := s.vm], e1)
  // g given back: D, on V1
  have ebt: all a. a in omega -> a in mallocng.held(c, D, b) -> V1.bytes[bits_of_int(64, a)] = V1.bytes[bits_of_int(64, a)] proof
    fix a
    assume _ _
    show := refl({V1.bytes[bits_of_int(64, a)]})
  qed
  have {da = abs, du = univ, dh = holds} := apply(mp.drop_in_own[c := c, A := A, vm := V1, vm2 := V1, objs := s.objs, b := b, g := g, k := k], hc, hu, ha, hb, hin1,
    hk, hkl, hkg, mg, emp, nx, refl({V1.pages}), refl({V1.brk}), refl({V1.stack_top}), refl({V1.stack_limit}), ebt)
  have {dhm = mem, dsh = shown} := expand(dh, mallocng.holds_in)
  have dtk: D.taken = seq_concat(A.taken, seq_one(g)) by simp()
  // (no slot reserved: A's only in g, none of g's left)
  have dnr: mallocng.no_reserved(D) proof
    have _ em2 := expand(emp, mallocng.emptied)
    have r: all x0. all x1. x0 in omega && x1 in omega -> int_lt(x1, seq_len(D.slots[x0])) -> !(D.slots[x0][x1] = tag(3, empty)) proof
      fix x j
      assume ho hjl e
      have hx hj := ho
      have cg: x = g -> false proof
        assume eg
        have l0: seq_len(D.slots[g]) = 0 by defs(simp(expand(fn_build_dom[d := 0, v := i. tag(0, empty)], seq_len)), seq_len)
        show by arith(rewrite(eg, hjl), l0, hj)
      qed
      have co2: !(x = g) -> false proof
        assume ne
        have es: D.slots[x] = A.slots[x] by simp(mp(app_update_other[f := A.slots, k := g, v := mp.nosl(), x := x], ne))
        have xg := mp(all_elim(em2, {x}, {j}), conj(hx, hj), conj(rewrite(es, hjl), rewrite(es, e)))
        show by taut(xg, ne)
      qed
      show by taut(cg, co2)
    qed
    show by defs(r, mallocng.no_reserved)
  qed
  // untouched so far: the context's free bytes the allocator's
  have un01 := apply(mp.kept_unt[c := c, A := A, b := b, vm := s.vm, V := V1, objs := s.objs, e := E],
    apply(mp.unt_wider[c := c, A := A, b := b, V0 := s.vm, V1 := V1, e := E], apply(mp.co_unt, hc, hu, ha, hh, co)))
  // the allocator after: within before
  have fe: mallocng.fixed_ranges(c, D) = mallocng.fixed_ranges(c, A) by defs(simp(), mallocng.fixed_ranges, mallocng.auxv_ranges)
  have dr := apply(mp.dropr_own[c := c, A := A, M := M, b := b, brk := s.vm.brk, g := g, k := k], ha, H, hk, hkl, hkg, mg)
  have {du2 = used, dm2 = metas} := dr
  have tk: all a. mallocng.in_taken(A, a) -> mallocng.in_taken(D, a) proof
    fix a
    assume t
    show := apply(mp.drop_taken[A := A, g := g, k := k, a := a], ha, go, t)
  qed
  have hr3 := apply(mp.drop_res_own[c := c, A := A, M := M, b := b, brk := s.vm.brk, g := g, k := k], hc, hu, ha, H, hk, hkl, hkg, mg, emp)
  have fsub: all a. a in mallocng.footprint(c, D, b) -> a in mallocng.footprint(c, A, b) proof
    fix a
    assume f
    show := apply(mp.dr_fpsub[c := c, A := A, A2 := D, M := M, b := b, brk := s.vm.brk, g := g, a := a], hc, hu, ha, H, du, da, dr, fe, tk, hr3, f)
  qed
  have grw: mp.grown(c, D, A, b, s.vm) proof
    fix a
    assume ho f
    show by taut(mp(all_elim(fsub, {a}), f))
  qed
  // g's meta: the allocator's, ready
  have mfp: mp.am_mfp(c, A, b, s, g) proof
    assume _
    fix a
    assume ho h
    have h1 h2 := h
    have cm: mallocng.META_SIZE = 40 by defs(refl({40}), mallocng.META_SIZE)
    have {f = fp} := apply(mp.meta_held[c := c, A := A, M := M, b := b, brk := s.vm.brk, g := g, a := a], hc, hu, ha, H, hg, ho, h1, arith(h2, cm))
    show by taut(f)
  qed
  have gnz: !(g = 0) proof
    assume e
    have {z = zero} := expand(hnm, mallocng.normal)
    show by taut(z, rewrite(e, hg))
  qed
  have rdy := apply(mp.used_ready[c := c, A := A, vm := V1, b := b, g := g], hc, hu, ha, hh1, hg, nx)
  have mj := apply(mp.fm_join[c := c, A := D, vm := V1, b := b, objs := s.objs, T := A.taken, m := g], hc, du, da, dhm, dsh, tl, dtk, rdy)
  have rwa _ _ := expand(rdy, mallocng_specs.meta_ready)
  have xrw: all a. a in omega -> int_le(g, a) -> int_lt(a, int_add(g, 40)) ->
      mallocng.m_rw(mallocng.mview(V1, mallocng.all_bytes()), a) && !(snd(mallocng.pg(mallocng.mview(V1, mallocng.all_bytes()), a)).kind = 2) proof
    fix a
    assume ho h1 h2
    show := mp(all_elim(rwa, {a}), ho, (int_le(g, a) && int_lt(a, int_add(g, mallocng.META_SIZE)) by defs(arith(h1, h2), mallocng.META_SIZE)))
  qed
  have {ba = abs, bu = univ, bnr = nr, btk = tk, bhin = hin, bunt = unt} :=
    apply(mp.agr_back_g[c := c, A := A, A1 := D, B := b, s := s, V := V1, V2 := V2, M := g, e := E], hc, ha, du, da, hb, cal, v1v, v2v, dhm, dsh, dtk, dnr,
      un01, grw, mfp, gnz, mj, hfd, xrw)
  let A2 := mp.back(D, A.taken, g)
  have P := apply(mp.fb_ms[c := c, A := D, T := A.taken, x := g, vm := V1, V1 := V2, b := b, objs := s.objs], hc, du, da, hb, v1v, v2v, dhm, dsh, cal, tl, dtk, mj, hfd, xrw)
  have {bra = ranges} := apply(mp.ms_basic, P)
  // the C world's bytes: those of D's ranges
  have rr: all a. a in omega -> mallocng.in_ranges(a, mallocng.fp_ranges(c, A2)) -> mallocng.in_ranges(a, mallocng.fp_ranges(c, D)) || a in s.objs.c_bytes proof
    fix a
    assume ho ir
    show by taut(rewrite(bra, ir))
  qed
  have sh2 := apply(mp.shown_ranges2[c := c, A := D, A2 := A2, objs := s.objs], dsh, rr, (A2.reserve = D.reserve by simp()), (A2.reserve_cnt = D.reserve_cnt by simp()))
  have hin2: mallocng.holds_in(c, A2, V2, s.objs, b) by defs(taut(bhin, sh2), mallocng.holds_in)
  // the allocator after: D's bytes and g's meta's
  have fpc: all x0. x0 in omega -> x0 in mallocng.footprint(c, A2, b) -> x0 in mallocng.footprint(c, A, b) || mallocng.in_reserved(A, x0) proof
    fix a
    assume ho f
    have cm: int_le(g, a) && int_lt(a, int_add(g, 40)) -> a in mallocng.footprint(c, A, b) proof
      assume h
      have h1 h2 := h
      have {f2 = fp} := apply(mp.meta_held[c := c, A := A, M := M, b := b, brk := s.vm.brk, g := g, a := a], hc, hu, ha, H, hg, ho, h1, h2)
      show := f2
    qed
    have co3: !(int_le(g, a) && int_lt(a, int_add(g, 40))) -> a in mallocng.footprint(c, A, b) proof
      assume h
      have {f1 = fp} := apply(mp.ms_fp, P, ho, h)
      show := mp(all_elim(fsub, {a}), taut(f1, f))
    qed
    show by taut(cm, co3)
  qed
  // the mapping let go: g's range, the allocator's before, no more
  have {gmp = mapped, ghd = hdr} := expand(apply(mp.used_group, huo, hg), mallocng.group_ok)
  have pg0 _ := mp(gmp, mg)
  have _ _ mpos := ghd
  have gre: mallocng.group_range(A.metas[g]) = pair(A.metas[g].mem, int_mul(A.metas[g].maplen, 4096)) by defs(simp(mg), mallocng.group_range)
  have {gmo = mem, gml = maplen} := apply(mp.used_nat, ha, hg)
  have ml0: !(int_mul(A.metas[g].maplen, 4096) = 0) by arith(mg, gml)
  have mlm: int_mod(int_mul(A.metas[g].maplen, 4096), 4096) = 0 by arith(gml)
  have each: all x0. x0 in omega -> int_le(A.metas[g].mem, x0) && int_lt(x0, int_add(A.metas[g].mem, int_mul(A.metas[g].maplen, 4096))) ->
      (x0 in mallocng.footprint(c, A, b) || mallocng.in_reserved(A, x0)) && !(x0 in mallocng.footprint(c, A2, b)) proof
    fix a
    assume ho h
    have inr: mallocng.in_range(a, mallocng.group_range(A.metas[g])) by defs(simp(gre, h), mallocng.in_range)
    // before: the allocator's, or reserved
    have nl: !(a in malloc.live_of(b)) proof
      assume l
      show by taut(inr, apply(mp.live_off_own[c := c, A := A, M := M, b := b, brk := s.vm.brk, g := g, a := a], hc, hu, ha, hb, H, hg, mg, emp, l))
    qed
    have nt := apply(mp.grp_untaken[c := c, A := A, M := M, b := b, brk := s.vm.brk, g := g, a := a], hc, hu, ha, H, hg, ho, inr)
    have gex: ex x. mallocng.is_used(A, x) && mallocng.in_range(a, mallocng.group_range(A.metas[x])) by ex_intro({g}, taut(hg, inr))
    have gra := apply(mp.grp_ranges[A := A, a := a], ha)
    have bef: a in mallocng.footprint(c, A, b) || mallocng.in_reserved(A, a) proof
      have c1: !mallocng.in_reserved(A, a) -> a in mallocng.footprint(c, A, b) proof
        assume nr
        show := apply(mp.fp_intro, hc, hu, ha, ho, nl, nr, nt, taut(gra, gex))
      qed
      show by taut(c1)
    qed
    // after: in no range of the allocator's
    have aft: !(a in mallocng.footprint(c, A2, b)) proof
      assume f
      // (not g's meta: a meta area's byte, in no group)
      have nm: !(int_le(g, a) && int_lt(a, int_add(g, 40))) proof
        assume h2
        have h21 h22 := h2
        have {hpt = part} := expand(H, mallocng.holds)
        have {usl = used_slots} := expand(hpt, mallocng.metas_partition)
        obtain kg, hkg2 hkgl2 hkge2 from expand(hg, mallocng.is_used)
        have gms := rewrite(hkge2, mp(all_elim(usl, {kg}), hkg2, hkgl2))
        have {lex = area} := apply(mp.meta_page, ha, gms)
        obtain ka, hka hkal l1 l2 _ from lex
        have rl: A.areas in list_type(omega) by simp(ha)
        have ako := mp(at_type[l := A.areas, t := omega, i := ka], rl, hka, hkal)
        have {agr = groups} := apply(mp.area_apart[c := c, A := A, M := M, b := b, brk := s.vm.brk, k := ka, a := a], hc, hu, ha, H, hka, hkal, ho,
          arith(l1, h21, ako, go), arith(l2, h22))
        show by taut(mp(all_elim(agr, {g}), hg), inr)
      qed
      have {f1 = fp} := apply(mp.ms_fp, P, ho, nm)
      have fd: a in mallocng.footprint(c, D, b) by taut(f1, f)
      have ird := (mallocng.in_ranges(a, mallocng.fp_ranges(c, D)) by taut(apply(mp.fp_def[c := c, A := D, b := b, a := a]), fd))
      have {g2 = groups} := apply(mp.fp_pieces, hc, du, da)
      have x2: mallocng.fixed_ranges(c, D) in list_type(univ(1)) by defs(apply(mp.pre_list, hc, du, da), mallocng.fixed_ranges)
      let G2 := fn_build(int_sub(seq_len(D.used), 0), x0. mallocng.group_range(D.metas[D.used[int_add(0, x0)]]))
      have c2 := apply(mp.ranges_cat[a := a, xs := mallocng.fixed_ranges(c, D), ys := G2], x2, g2)
      have r2 := apply(mp.grp_ranges[A := D, a := a], da)
      have i0: mallocng.in_ranges(a, seq_concat(mallocng.fixed_ranges(c, D), G2)) by defs(ird, mallocng.fp_ranges)
      // (a fixed range: g's range apart from them)
      have d1: mallocng.in_ranges(a, mallocng.fixed_ranges(c, D)) -> false proof
        assume fx
        have na := mp(all_elim(expand(hga, mallocng.groups_apart), {k}, {a}), conj(hk, ho), conj(hkl, rewrite(sym(hkg), inr)))
        show by taut(na, rewrite(fe, fx))
      qed
      // (another group's: apart from g's)
      have d2: (ex x. mallocng.is_used(D, x) && mallocng.in_range(a, mallocng.group_range(D.metas[x]))) -> false proof
        assume e
        obtain x, iu2 hr from e
        have iu xg := (mallocng.is_used(A, x) && !(x = g) by taut(all_elim(du2, {x}), iu2))
        have {xo = nat} := apply(mp.used_nat, ha, iu)
        have hr1 := rewrite(mp(all_elim(dm2, {x}), xo, xg), hr)
        have et := apply(mp.emp_tags[A := A, g := g], emp)
        have gnn: all i. i in omega -> int_lt(i, seq_len(A.slots[g])) -> !(fst(A.slots[g][i]) = 2) proof
          fix i
          assume hi hil
          have _ n2 := mp(all_elim(et, {i}), hi, hil)
          show := n2
        qed
        show by taut(inr, apply(mp.own_disj[c := c, A := A, M := M, b := b, brk := s.vm.brk, g := g, x := x, a := a], hc, hu, ha, H, hg, mg, gnn, iu, xg, ho, hr1))
      qed
      show by taut(c2, r2, i0, d1, d2)
    qed
    show by taut(bef, aft)
  qed
  have lg: mallocng_specs.let_go(c, A, A2, b, A.metas[g].mem, int_mul(A.metas[g].maplen, 4096)) by defs(taut(pg0, mlm, mpos, each), mallocng_specs.let_go)
  have fb: mallocng_specs.freed_back(c, A, A2, b, s.vm, V2, s.objs, A.metas[g].mem, int_mul(A.metas[g].maplen, 4096))
    by defs(taut(hin2, bnr, btk, bunt, fpc, lg), mallocng_specs.freed_back)
  show by ex_intro({A2}, taut(ba, bu, fb))
qed

// ----------------------------------------------------------------------
//  A nested group given back: its header's word cleared, its container's
//  slot reserved

// (free_meta's writes: the allocator's bytes, and the freed meta's)
theorem mp.fm_kept(c, X, V, V2, b, objs, M, a): c in mallocng.Cfg -> X in univ(1) -> X in mallocng.Abs -> V in x86_64_linux.Vm ->
  mallocng.holds_m(c, X, V, b) -> mallocng.shown_in(c, X, objs) -> int_mod(c.ctx, 8) = 0 ->
  mallocng_specs.meta_joinable(V, objs, int_add(c.ctx, 16), X.free_metas, M) -> mallocng_specs.meta_freed(V, V2, objs, int_add(c.ctx, 16), M) ->
  a in omega -> int_lt(a, int_pow(2, 64)) -> !(a in mallocng.footprint(c, X, b)) -> !(int_le(M, a) && int_lt(a, int_add(M, 40))) ->
  V2.bytes[bits_of_int(64, a)] = V.bytes[bits_of_int(64, a)]
proof
  assume hc hu ha hv hh hsh cal hj hfd ho alo n1 nm
  let F := X.free_metas
  have kf: mallocng.C_FREE_META = 16 by defs(refl({16}), mallocng.C_FREE_META)
  have la := rewrite(kf, apply(mp.free_metas_at[c := c, A := X, vm := V, b := b, objs := objs], hc, hu, ha, (V.bytes in fn_space(bits(64), bits(8)) by simp(hv)), hh, hsh, cal))
  have fl: F in list_type(omega) by simp(ha)
  have _ _ _ vb := mp(all_elim(expand(hfd, mallocng_specs.meta_freed), {F}), fl, taut(la, hj))
  have {H1 = inv} := expand(hh, mallocng.holds_m)
  have {hpt = part} := expand(H1, mallocng.holds)
  have {fsl = free_slots} := expand(hpt, mallocng.metas_partition)
  have nh: !(int_le(int_add(c.ctx, 16), a) && int_lt(a, int_add(int_add(c.ctx, 16), 8))) proof
    assume w
    have w1 w2 := w
    have f := apply(mp.ctx_fp[c := c, A := X, vm := V, b := b, a := a], hc, hu, ha, hh, ho, arith(w1), (int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE)) by defs(arith(w2), mallocng.CTX_SIZE)))
    show by taut(f, n1)
  qed
  have nl: all i. i in omega -> int_lt(i, seq_len(F)) -> !(int_le(F[i], a) && int_lt(a, int_add(F[i], 16))) proof
    fix i
    assume hi hil w
    have w1 w2 := w
    have fs _ := mp(all_elim(fsl, {i}), hi, hil)
    have nt := apply(mp.free_untaken, H1, hi, hil)
    have {acc = acc} := apply(mp.slot_meta[c := c, A := X, vm := V, b := b, g := F[i]], hc, hu, ha, hh, fs, nt)
    have yh _ _ := mp(all_elim(acc, {a}), ho, w1, arith(w2))
    have {yf = fp} := apply(mp.held_fp, yh)
    show by taut(yf, n1)
  qed
  show := mp(all_elim(vb, {a}), ho, taut(alo, nh, nm, nl))
qed

// (a meta ready, its bytes and the pages as before: ready still)
theorem mp.ready_same(V, V2, m): mallocng_specs.meta_ready(V, m) -> m in omega -> V2.pages = V.pages ->
  (all a. a in omega -> int_le(m, a) -> int_lt(a, int_add(m, 40)) -> V2.bytes[bits_of_int(64, a)] = V.bytes[bits_of_int(64, a)]) ->
  mallocng_specs.meta_ready(V2, m)
proof
  assume hr hm ep eb
  let MA := mallocng.mview(V, mallocng.all_bytes())
  let MA2 := mallocng.mview(V2, mallocng.all_bytes())
  have rw r0 r8 := expand(hr, mallocng_specs.meta_ready)
  have cm: mallocng.META_SIZE = 40 by defs(refl({40}), mallocng.META_SIZE)
  have ag: all a. a in omega -> int_le(m, a) -> int_lt(a, int_add(m, 40)) -> MA2[a] = MA[a] proof
    fix a
    assume hao h1 h2
    have bt: a in mallocng.all_bytes() -> V2.bytes[bits_of_int(64, a)] = V.bytes[bits_of_int(64, a)] proof
      assume _
      show := mp(all_elim(eb, {a}), hao, h1, h2)
    qed
    show := apply(mp.view_agree[vm := V, vm2 := V2, fp := mallocng.all_bytes(), a := a], hao, bt, ep)
  qed
  have rw2: all a. a in omega -> int_le(m, a) && int_lt(a, int_add(m, mallocng.META_SIZE)) -> mallocng.m_rw(MA2, a) && !(snd(mallocng.pg(MA2, a)).kind = 2) proof
    fix a
    assume hao h
    have h1 h2 := h
    have o1 o2 := mp(all_elim(rw, {a}), hao, h)
    have {pe = page} := apply(mp.agree_b8, mp(all_elim(ag, {a}), hao, h1, arith(h2, cm)))
    have {r = rw} := apply(mp.pg_same, pe)
    show by taut(r, o1, rewrite(sym(pe), o2))
  qed
  have a0: all i. i in omega -> int_lt(i, 8) -> MA2[int_add(m, i)] = MA[int_add(m, i)] proof
    fix i
    assume hi hil
    show := mp(all_elim(ag, {int_add(m, i)}), simp(hm, hi), arith(hm, hi), arith(hm, hi, hil))
  qed
  have a8: all i. i in omega -> int_lt(i, 8) -> MA2[int_add(int_add(m, 8), i)] = MA[int_add(int_add(m, 8), i)] proof
    fix i
    assume hi hil
    have e: int_add(int_add(m, 8), i) = int_add(m, int_add(8, i)) by arith(hm, hi)
    show := rewrite(sym(e), mp(all_elim(ag, {int_add(m, int_add(8, i))}), simp(hm, hi), arith(hm, hi), arith(hm, hi, hil)))
  qed
  have q0 := trans(apply(mp.agree_rd[M := MA, M2 := MA2, a := m, n := 8], simp(), a0), r0)
  have q8 := trans(apply(mp.agree_rd[M := MA, M2 := MA2, a := int_add(m, 8), n := 8], simp(), a8), r8)
  show by defs(taut(rw2, q0, q8), mallocng_specs.meta_ready)
qed

// (a group's header word: the allocator's bytes)
theorem mp.hdr_fp(c, A, M, b, brk, g, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds(c, A, M, b, brk) ->
  mallocng.is_used(A, g) -> a in omega -> int_le(A.metas[g].mem, a) -> int_lt(a, int_add(A.metas[g].mem, 8)) ->
  a in mallocng.footprint(c, A, b)
proof
  assume hc hu ha H hg hao h1 h2
  have {huo = used} := expand(H, mallocng.holds)
  have gok := apply(mp.used_group, huo, hg)
  have {go = nat} := apply(mp.used_nat, ha, hg)
  have {gst = stride, gl = last, gse = end} := apply(mp.geo, ha, go, gok)
  have {ho = hdr_own} := expand(gok, mallocng.group_ok)
  have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
  have nl := mp(all_elim(ho, {a}), hao, conj(h1, (int_lt(a, int_add(A.metas[g].mem, mallocng.UNIT)) by arith(h2, cu))))
  have me := all_elim(gse, {A.metas[g].last_idx})
  have mg: int_mul(mallocng.stride(A.metas[g]), A.metas[g].last_idx) in omega by simp(gst, gl)
  have inr := apply(mp.group_bytes[A := A, M := M, b := b, h := g, a := a], ha, go, gok, hao, h1, arith(h2, me, mg, gst))
  have gba: mp.gb(A, g, a) by defs(taut(h1, (int_le(a, mallocng.slot_end(A.metas[g], A.metas[g].last_idx)) by arith(h2, me, mg, gst))), mp.gb)
  have nr: !mallocng.in_reserved(A, a) proof
    assume r
    obtain j, hj hjl hjo from apply(mp.res_nested, hc, hu, ha, H, hg, hao, gba, r)
    have {gss = start} := apply(mp.geo, ha, go, gok)
    have sj := all_elim(gss, {j})
    have mj: int_mul(mallocng.stride(A.metas[g]), j) in omega by simp(gst, hj)
    have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
    have d1: (A.slots[g][j] = tag(3, empty) && mallocng.in_slot(A.metas[g], j, a)) -> false proof
      assume q
      have _ is := q
      have s1 _ := expand(is, mallocng.in_slot)
      show by arith(s1, sj, mj, ci, h2)
    qed
    have d2: (fst(A.slots[g][j]) = 2 && int_le(A.metas[snd(A.slots[g][j])].mem, a) && int_lt(a, mallocng.slot_end(A.metas[g], j))) -> false proof
      assume q
      have f2 q2 _ := q
      have {ns = start} := apply(mp.nest_start, ha, go, gok, hj, hjl, f2)
      show by arith(ns, q2, sj, mj, h2)
    qed
    show by taut(hjo, d1, d2)
  qed
  have nt := apply(mp.grp_untaken[c := c, A := A, M := M, b := b, brk := brk, g := g, a := a], hc, hu, ha, H, hg, hao, inr)
  have gex: ex x. mallocng.is_used(A, x) && mallocng.in_range(a, mallocng.group_range(A.metas[x])) by ex_intro({g}, taut(hg, inr))
  have gra := apply(mp.grp_ranges[A := A, a := a], ha)
  show := apply(mp.fp_intro, hc, hu, ha, hao, nl, nr, nt, taut(gra, gex))
qed

// (the memory with a group's header word cleared)
abbrev mp.hdr0(V, G) := fn_update(V, "bytes", x86_64_linux.store_le(V.bytes, G, 8, 0))

// A nested group given back, before its container's slot is: the state
// without it (its container's slot reserved), on the memory with the
// counters written and its header word cleared -- the invariant, what
// nontrivial_free needs, one group fewer; the allocator then within the
// allocator before and its reserved slots
theorem mp.fg_nest_pre(c, A, s, b, g, k, h, j, V1): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  s in abi.World -> mallocng.holds_in(c, A, s.vm, s.objs, b) -> abi.thread_ok(s.vm, s.fs_base) -> mallocng_specs.tls_apart(c, A, b, s.fs_base) ->
  k in omega -> int_lt(k, seq_len(A.used)) -> A.used[k] = g -> mallocng.is_used(A, h) -> j in omega -> int_lt(j, seq_len(A.slots[h])) -> A.slots[h][j] = tag(2, g) ->
  mallocng.emptied(A, g) -> A.metas[g].next = 0 -> V1 in x86_64_linux.Vm -> mallocng_specs.ctx_only(c, s.vm, V1) ->
  abs: mp.dropn(A, g, k, h, j) in mallocng.Abs && univ: mp.dropn(A, g, k, h, j) in univ(1) &&
  holds: mallocng.holds_in(c, mp.dropn(A, g, k, h, j), mp.hdr0(V1, A.metas[g].mem), s.objs, b) &&
  thread: abi.thread_ok(mp.hdr0(V1, A.metas[g].mem), s.fs_base) && tls: mallocng_specs.tls_apart(c, mp.dropn(A, g, k, h, j), b, s.fs_base) &&
  hused: mallocng.is_used(mp.dropn(A, g, k, h, j), h) && ronly: mallocng.reserved_only(mp.dropn(A, g, k, h, j), h, j) &&
  len: seq_len(mp.dropn(A, g, k, h, j).used) = int_sub(seq_len(A.used), 1) &&
  unt: mallocng.untouched(c, A, b, s.vm, mp.hdr0(V1, A.metas[g].mem), s.objs, set_select(omega, x0. mallocng.in_reserved(A, x0))) &&
  fsub: (all a. a in mallocng.footprint(c, mp.dropn(A, g, k, h, j), b) -> a in mallocng.footprint(c, A, b)) &&
  rsub: (all a. a in omega -> mallocng.in_reserved(mp.dropn(A, g, k, h, j), a) -> a in mallocng.footprint(c, A, b) || mallocng.in_reserved(A, a)) &&
  rdy: mallocng_specs.meta_ready(mp.hdr0(V1, A.metas[g].mem), g)
proof
  assume hc hu ha hb hw hin hth htl hk hkl hkg hh hj hjl ehj emp nx v1v co
  let N := mp.dropn(A, g, k, h, j)
  let G := A.metas[g].mem
  let V2 := mp.hdr0(V1, G)
  let E := set_select(omega, x0. mallocng.in_reserved(A, x0))
  let M := mallocng.mview(s.vm, mallocng.held(c, A, b))
  have {hh2 = mem, hsh = shown} := expand(hin, mallocng.holds_in)
  have {H = inv, hfm = mapped} := expand(hh2, mallocng.holds_m)
  have {huo = used, hga = apart} := expand(H, mallocng.holds)
  have ul: A.used in list_type(omega) by simp(ha)
  have go: g in omega := rewrite(hkg, apply(at_type[l := A.used, t := omega, i := k], ul, hk, hkl))
  have hg: mallocng.is_used(A, g) by defs(ex_intro({k}, taut(hk, hkl, hkg)), mallocng.is_used)
  have {gmo = mem} := apply(mp.used_nat, ha, hg)
  have hh1 := apply(mp.co_holds[c := c, A := A, vm := s.vm, vm2 := V1, b := b], hh2, co)
  have hin1: mallocng.holds_in(c, A, V1, s.objs, b) by defs(taut(hh1, hsh), mallocng.holds_in)
  have {hfm1 = mapped} := expand(hh1, mallocng.holds_m)
  have e1 _ := expand(co, mallocng_specs.ctx_only)
  have {p1 = pages, b1 = brk, t1 = top, l1 = limit} := apply(mp.bytes_only[V := V1, vm := s.vm], e1)
  have {gm = mem, hst = start, hbo = body, hfi = fits, hhd = hdr} := apply(mp.nest_geo[c := c, A := A, M := M, b := b, brk := s.vm.brk, h := h, j := j, g := g], ha, H, hh, hj, hjl, ehj)
  have hgn: !(h = g) proof
    assume e
    show by arith(rewrite(e, hhd), rewrite(e, hst), gm)
  qed
  have {ho = nat} := apply(mp.used_nat, ha, hh)
  have dr := apply(mp.dropr_nest[c := c, A := A, M := M, b := b, brk := s.vm.brk, g := g, k := k, h := h, j := j], hc, hu, ha, H, hk, hkl, hkg, hh, hj, hjl, ehj)
  have {du = used, dm = metas, nsl = slen, nnest = nest, nkeep = keep} := dr
  have hu2: mallocng.is_used(N, h) by taut(all_elim(du, {h}), hh, hgn)
  have l2: int_lt(j, seq_len(N.slots[h])) := rewrite(sym(mp(all_elim(nsl, {h}), ho, hgn)), hjl)
  have s2 := mp(all_elim(nnest, {h}, {j}), conj(ho, hj), hgn, hjl, ehj)
  have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
  // the header word: in h's slot j's interior, reserved in N
  have hres: all a. a in omega -> int_le(G, a) -> int_lt(a, int_add(G, 8)) -> mallocng.in_reserved(N, a) proof
    fix a
    assume hao h1 h2
    have ish: mallocng.in_slot(A.metas[h], j, a) by defs(arith(h1, h2, hst, hbo, hfi, ci), mallocng.in_slot)
    have ish2 := rewrite(sym(mp(all_elim(dm, {h}), ho, hgn)), ish)
    show by defs(ex_intro({h}, {j}, taut(ho, hj, hu2, l2, s2, ish2)), mallocng.in_reserved)
  qed
  // (the header word: within the user space, the allocator's)
  have hfp7 := apply(mp.hdr_fp[c := c, A := A, M := M, b := b, brk := s.vm.brk, g := g, a := int_add(G, 7)], hc, hu, ha, H, hg, arith(gmo), arith(gmo), arith(gmo))
  have g7 := apply(mp.fp_low[c := c, A := A, vm := s.vm, b := b, a := int_add(G, 7)], hfm, hfp7)
  have gb: G in bits(64) by arith(gmo, g7)
  have g8: int_le(int_add(G, 8), 18446744073709551616) by arith(g7)
  // the allocator after: within before
  have fe: mallocng.fixed_ranges(c, N) = mallocng.fixed_ranges(c, A) by defs(simp(), mallocng.fixed_ranges, mallocng.auxv_ranges)
  have tk: all a. mallocng.in_taken(A, a) -> mallocng.in_taken(N, a) proof
    fix a
    assume t
    have t2 := apply(mp.drop_taken[A := A, g := g, k := k, a := a], ha, go, t)
    show by defs(simp(expand(t2, mallocng.in_taken)), mallocng.in_taken)
  qed
  have hr3 := apply(mp.drop_res_nest[c := c, A := A, M := M, b := b, brk := s.vm.brk, g := g, k := k, h := h, j := j], hc, hu, ha, H, hk, hkl, hkg, hh, hj, hjl, ehj, emp)
  have hnorm := expand(H, mallocng.holds)
  have {hnm = normal} := hnorm
  have {na0 = abs, nu0 = univ} := apply(mp.drop_type, ha, hnm, hk, hkl, go)
  let D := mp.drop(A, g, k)
  have r0: tag(3, empty) in set_image(single(empty), x0. tag(3, x0)) by taut(set_image_def[s := single(empty), f := x0. tag(3, x0), y := tag(3, empty)],
    (ex x0. x0 in single(empty) && tag(3, x0) = tag(3, empty) by ex_intro({empty}, taut(single_intro[a := empty], refl({tag(3, empty)})))))
  have r3: tag(3, empty) in mallocng.Use by defs(simp(r0), mallocng.Use)
  have jl2: int_lt(j, seq_len(D.slots[h])) by simp(hjl, mp(app_update_other[f := A.slots, k := g, v := mp.nosl(), x := h], hgn))
  have {na = abs, nu = univ} := apply(mp.setu_type[A := D, h := h, i := j, u := tag(3, empty)], na0, ho, hj, jl2, r3)
  have fsub: all a. a in mallocng.footprint(c, N, b) -> a in mallocng.footprint(c, A, b) proof
    fix a
    assume f
    show := apply(mp.dr_fpsub[c := c, A := A, A2 := N, M := M, b := b, brk := s.vm.brk, g := g, a := a], hc, hu, ha, H, nu, na, dr, fe, tk, hr3, f)
  qed
  // the invariant on V2: N's bytes as V1's (the header word reserved in N)
  have ebt: all a. a in omega -> a in mallocng.held(c, N, b) -> V2.bytes[bits_of_int(64, a)] = V1.bytes[bits_of_int(64, a)] proof
    fix a
    assume hao hd
    have {fN = fp} := apply(mp.held_fp, hd)
    have nrN := (!mallocng.in_reserved(N, a) by taut(apply(mp.fp_def[c := c, A := N, b := b, a := a]), fN))
    have alo := apply(mp.fp_low[c := c, A := A, vm := s.vm, b := b, a := a], hfm, mp(all_elim(fsub, {a}), fN))
    have out: int_le(int_add(G, 8), a) || int_lt(a, G) proof
      have n: int_le(G, a) && int_lt(a, int_add(G, 8)) -> false proof
        assume w
        have w1 w2 := w
        show by taut(nrN, mp(all_elim(hres, {a}), hao, w1, w2))
      qed
      show by arith(n)
    qed
    have ab: bits_of_int(64, a) = a by defs(arith(hao, alo), bits_of_int, pow2)
    have so := apply(mp.st_out[B := V1.bytes, c := G, k := 8, v := 0, x := a], (a in bits(64) by arith(hao, alo)), gb, simp(), g8, out)
    show by simp(ab, so)
  qed
  have {nhh = holds} := apply(mp.drop_in_nest[c := c, A := A, vm := V1, vm2 := V2, objs := s.objs, b := b, g := g, k := k, h := h, j := j], hc, hu, ha, hb, hin1,
    hk, hkl, hkg, hh, hj, hjl, ehj, emp, nx, (V2.pages = V1.pages by simp()), (V2.brk = V1.brk by simp()), (V2.stack_top = V1.stack_top by simp()),
    (V2.stack_limit = V1.stack_limit by simp()), ebt)
  // untouched: the counters, the header word -- the allocator's bytes
  have k01 := apply(mp.co_unt, hc, hu, ha, hh2, co)
  have bk12 := apply(mp.bk_only[v := V1, v2 := V2], (fn_update(V2, "bytes", V1.bytes) = V1 by simp(mp(fn_update_same[f := V1, k := "bytes"], simp(v1v), simp(v1v)))))
  have k12r: all x0. x0 in omega -> (!(x0 in mallocng.footprint(c, A, b)) && !(x0 in empty)) && x86_64_linux.mapped(V1, int_div(x0, x86_64_linux.PAGE)) ->
      V2.bytes[bits_of_int(64, x0)] = V1.bytes[bits_of_int(64, x0)] && V2.pages[int_div(x0, x86_64_linux.PAGE)] = V1.pages[int_div(x0, x86_64_linux.PAGE)] proof
    fix a
    assume hao hq
    have nf _ mm := hq
    have mm1 _ := expand(mm, x86_64_linux.mapped)
    have alo: int_lt(a, int_pow(2, 64)) by arith(hao, expand(mm1, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))
    have out: int_le(int_add(G, 8), a) || int_lt(a, G) proof
      have n: int_le(G, a) && int_lt(a, int_add(G, 8)) -> false proof
        assume w
        have w1 w2 := w
        show by taut(nf, apply(mp.hdr_fp[c := c, A := A, M := M, b := b, brk := s.vm.brk, g := g, a := a], hc, hu, ha, H, hg, hao, w1, w2))
      qed
      show by arith(n)
    qed
    have ab: bits_of_int(64, a) = a by defs(arith(hao, alo), bits_of_int, pow2)
    have so := apply(mp.st_out[B := V1.bytes, c := G, k := 8, v := 0, x := a], (a in bits(64) by arith(hao, alo)), gb, simp(), g8, out)
    show by simp(ab, so)
  qed
  have k12: mallocng.kept_outside(c, A, b, V1, V2, empty) by defs(taut(k12r, bk12), mallocng.kept_outside)
  have k02 := apply(mp.unt_trans[c := c, A := A, A1 := A, b := b, V0 := s.vm, V1 := V1, V2 := V2, e := empty], k01, k12, refl({mallocng.footprint(c, A, b)}))
  have unt := apply(mp.kept_unt[c := c, A := A, b := b, vm := s.vm, V := V2, objs := s.objs, e := E], apply(mp.unt_wider[c := c, A := A, b := b, V0 := s.vm, V1 := V2, e := E], k02))
  have fsb: s.fs_base in bits(64) by simp(expand(hw, abi.World))
  have th2 := apply(mp.tls_kept[c := c, A := A, b := b, V0 := s.vm, V1 := V2, fs := s.fs_base, e := empty], fsb, hth, htl, k02, (all i. i in omega -> int_lt(i, 8) -> !(int_add(s.fs_base, i) in empty) by simp()))
  have t0 := expand(htl, mallocng_specs.tls_apart)
  have tl2r: all x0. x0 in omega -> int_lt(x0, 8) -> !(int_add(s.fs_base, x0) in mallocng.footprint(c, N, b)) proof
    fix i
    assume hi hil f
    show by taut(mp(all_elim(t0, {i}), hi, hil), mp(all_elim(fsub, {int_add(s.fs_base, i)}), f))
  qed
  have tl2: mallocng_specs.tls_apart(c, N, b, s.fs_base) by defs(tl2r, mallocng_specs.tls_apart)
  // N's only reserved slot: h's j
  have _ em2 := expand(emp, mallocng.emptied)
  have uq: all x0. all x1. x0 in omega && x1 in omega -> int_lt(x1, seq_len(N.slots[x0])) && N.slots[x0][x1] = tag(3, empty) -> x0 = h && x1 = j proof
    fix x i
    assume hxi q
    have hx hi := hxi
    have hil e := q
    have cg: x = g -> x = h && i = j proof
      assume eg
      have gh: !(g = h) proof
        assume e2
        show by taut(hgn, sym(e2))
      qed
      have ng := mp(app_update_other[f := fn_update(A.slots, g, mp.nosl()), k := h, v := fn_update(fn_update(A.slots, g, mp.nosl())[h], j, tag(3, empty)), x := g], gh)
      have l0: seq_len(N.slots[g]) = 0 by defs(simp(ng, expand(fn_build_dom[d := 0, v := i0. tag(0, empty)], seq_len)), seq_len)
      have f: false by arith(rewrite(eg, hil), l0, hi)
      show by taut(f)
    qed
    have co2: !(x = g) -> x = h && i = j proof
      assume ne
      have il: int_lt(i, seq_len(A.slots[x])) := rewrite(mp(all_elim(nsl, {x}), hx, ne), hil)
      have d1: A.slots[x][i] = tag(2, g) -> x = h && i = j proof
        assume en
        have {xu = used} := apply(mp.nested_used[c := c, A := A, M := M, b := b, brk := s.vm.brk, x := x, i := i, y := g], ha, H, hx, hi, il, en)
        show := apply(mp.nest_once[c := c, A := A, M := M, b := b, brk := s.vm.brk, x := x, i := i, h := h, j := j, g := g], hc, hu, ha, H, xu, hh, hi, il, hj, hjl, en, ehj)
      qed
      have d2: !(A.slots[x][i] = tag(2, g)) -> x = h && i = j proof
        assume nn
        have ek := mp(all_elim(nkeep, {x}, {i}), conj(hx, hi), ne, il, nn)
        have xg := mp(all_elim(em2, {x}, {i}), conj(hx, hi), conj(il, trans(sym(ek), e)))
        have f: false by taut(xg, ne)
        show by taut(f)
      qed
      show by taut(d1, d2)
    qed
    show by taut(cg, co2)
  qed
  have ro: mallocng.reserved_only(N, h, j) by defs(taut(l2, s2, uq), mallocng.reserved_only)
  // one group fewer
  have {lnu = len} := apply(mp.rm_at_app[l := A.used, k := k, j := 0], ul, hk, hkl)
  have ln: seq_len(N.used) = int_sub(seq_len(A.used), 1) := trans((seq_len(N.used) = seq_len(mallocng_specs.rm_at(A.used, k)) by simp()), lnu)
  // N's reserved slot: A's bytes, or reserved there
  have {nhm = mem} := expand(nhh, mallocng.holds_in)
  have {HN = inv} := expand(nhm, mallocng.holds_m)
  have rsub: all a. a in omega -> mallocng.in_reserved(N, a) -> a in mallocng.footprint(c, A, b) || mallocng.in_reserved(A, a) proof
    fix a
    assume hao ir
    obtain y i, hy hi hyu hil hs his from expand(ir, mallocng.in_reserved)
    have yh ij := mp(all_elim(uq, {y}, {i}), conj(hy, hi), conj(hil, hs))
    have his2 := rewrite(ij, rewrite(yh, his))
    have ish: mallocng.in_slot(A.metas[h], j, a) := rewrite(mp(all_elim(dm, {h}), ho, hgn), his2)
    have inr := apply(mp.slot_in_group[A := A, M := M, b := b, g := h, i := j, a := a], ha, ho, hj, hao, apply(mp.used_group, huo, hh), hjl, ish)
    have nl := apply(mp.res_nolive[c := c, A := N, M := mallocng.mview(V2, mallocng.held(c, N, b)), b := b, brk := V2.brk, a := a], hc, nu, na, hb, HN, ir)
    have nt := apply(mp.grp_untaken[c := c, A := A, M := M, b := b, brk := s.vm.brk, g := h, a := a], hc, hu, ha, H, hh, hao, inr)
    have gex: ex x. mallocng.is_used(A, x) && mallocng.in_range(a, mallocng.group_range(A.metas[x])) by ex_intro({h}, taut(hh, inr))
    have gra := apply(mp.grp_ranges[A := A, a := a], ha)
    have c1: !mallocng.in_reserved(A, a) -> a in mallocng.footprint(c, A, b) proof
      assume nr
      show := apply(mp.fp_intro, hc, hu, ha, hao, nl, nr, nt, taut(gra, gex))
    qed
    show by taut(c1)
  qed
  // g's meta: ready (not the header word: a meta area's bytes)
  have rdy1 := apply(mp.used_ready[c := c, A := A, vm := V1, b := b, g := g], hc, hu, ha, hh1, hg, nx)
  have mb: all a. a in omega -> int_le(g, a) -> int_lt(a, int_add(g, 40)) -> V2.bytes[bits_of_int(64, a)] = V1.bytes[bits_of_int(64, a)] proof
    fix a
    assume hao h1 h2
    have {mf = fp} := apply(mp.meta_held[c := c, A := A, M := M, b := b, brk := s.vm.brk, g := g, a := a], hc, hu, ha, H, hg, hao, h1, h2)
    have alo := apply(mp.fp_low[c := c, A := A, vm := s.vm, b := b, a := a], hfm, mf)
    have out: int_le(int_add(G, 8), a) || int_lt(a, G) proof
      have n: int_le(G, a) && int_lt(a, int_add(G, 8)) -> false proof
        assume w
        have w1 w2 := w
        have {hpt = part} := expand(H, mallocng.holds)
        have {usl = used_slots} := expand(hpt, mallocng.metas_partition)
        have gms := rewrite(hkg, mp(all_elim(usl, {k}), hk, hkl))
        have {lex = area} := apply(mp.meta_page, ha, gms)
        obtain ka, hka hkal la1 la2 _ from lex
        have rl: A.areas in list_type(omega) by simp(ha)
        have ako := mp(at_type[l := A.areas, t := omega, i := ka], rl, hka, hkal)
        have {agr = groups} := apply(mp.area_apart[c := c, A := A, M := M, b := b, brk := s.vm.brk, k := ka, a := a], hc, hu, ha, H, hka, hkal, hao,
          arith(la1, h1, ako, go), arith(la2, h2))
        have hf := apply(mp.hdr_fp[c := c, A := A, M := M, b := b, brk := s.vm.brk, g := g, a := a], hc, hu, ha, H, hg, hao, w1, w2)
        have gok := apply(mp.used_group, huo, hg)
        have {gst = stride, gl = last, gse = end} := apply(mp.geo, ha, go, gok)
        have me := all_elim(gse, {A.metas[g].last_idx})
        have mg: int_mul(mallocng.stride(A.metas[g]), A.metas[g].last_idx) in omega by simp(gst, gl)
        have inr := apply(mp.group_bytes[A := A, M := M, b := b, h := g, a := a], ha, go, gok, hao, w1, arith(w2, me, mg, gst))
        show by taut(mp(all_elim(agr, {g}), hg), inr)
      qed
      show by arith(n)
    qed
    have ab: bits_of_int(64, a) = a by defs(arith(hao, alo), bits_of_int, pow2)
    have so := apply(mp.st_out[B := V1.bytes, c := G, k := 8, v := 0, x := a], (a in bits(64) by arith(hao, alo)), gb, simp(), g8, out)
    show by simp(ab, so)
  qed
  have rdy := apply(mp.ready_same[V := V1, V2 := V2, m := g], rdy1, go, (V2.pages = V1.pages by simp()), mb)
  show by taut(na, nu, nhh, th2, tl2, hu2, ro, ln, unt, fsub, rsub, rdy)
qed
