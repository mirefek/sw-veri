    // index
    let P := A.metas[g].mem
    have vb1: V1.bytes in fn_space(bits(64), bits(8)) by simp(v1V)
    have r16b _ := mp(all_elim(rdx, {V1}), cov)
    have mbe1: bits_of_int(64, gimple.bytes_at(V1, int_add(g, 16), 8)) = P
      by simp(all_elim(tr.le_bytes, {V1}, {int_add(g, 16)}, {8}), mp(all_elim(x86.le8_nat, {V1}, {int_add(g, 16)}), vb1), r16b)
    have pbits: P in bits(64) := rewrite(mbe1, (bits_of_int(64, gimple.bytes_at(V1, int_add(g, 16), 8)) in bits(64) by simp()))
    have hm1n := apply(mp.co_holds[c := c, A := A, vm := V0, vm2 := V1, b := B], hhm, cov)
    have pin1n: mallocng.holds_m(c, h.A, S1.vm, h.blocks) by simp(hm1n)
    have psh1n: mallocng.shown_in(c, h.A, S1.objs) by simp(hsh)
    have th1n: abi.thread_ok(S1.vm, S1.fs_base) by simp(th1v)
    have cbl := apply(mp.emp_clear[c := c, A := A, M := mallocng.mview(V0, FP), b := B, brk := V0.brk, g := g, h := HG], hat, H, hus, hemp)
    have gom: g in omega by arith(go)
    have st3: A.slots[HG][j] = tag(1, P) || (ex h2. h2 in omega && (A.slots[HG][j] = tag(2, h2) && A.metas[h2].mem = P)) by disj({2}, ex_intro({g}, taut(gom, hns, refl({P}))))
    have sta: mallocng.starts_at(A, HG, j, P) by defs(taut(hhu, hjl, st3), mallocng.starts_at)
    have qgm: all regs o2. gc.regs_ok(regs, seq_one(gimple.arg(64, P))) -> runs(gm[regs], S1, o2) ->
        abi.ovf_out(S1, o2) || (ex r. o2 = ok(fn_update(S1, "vm", S1.vm), r) && fst(r) = HG) proof
      fix regs o2
      assume hro h2
      have rl rn _ := hro
      have h3 := mp(all_elim(hgm, {regs}, {S1}, {o2}), rl, (int_le(seq_len(regs), 6) by simp(rn)), w1W, h2)
      have q := apply(mp.gm_q[c := c, regs := regs, s := S1, h := h, p := P, o2 := o2, g := HG, i := j, g0 := g0, g1 := g1], hc, hx, hsct, pbits, w1W, hh, pin1n, psh1n, cbl, th1n, hj, sta, hg1, hro, h3)
      have k: case 2 of q proof
        assume e
        obtain r, e1r e2r e3r from e
        show by disj({2}, ex_intro({r}, taut(e1r, (fst(r) = HG by simp(e2r, e3r)))))
      qed
      show by taut(q, k)
    qed
    have qgsi: all regs o2. gc.regs_ok(regs, seq_one(gimple.arg(64, P))) -> runs(gsi[regs], S1, o2) ->
        abi.ovf_out(S1, o2) || (ex r. o2 = ok(fn_update(S1, "vm", S1.vm), r) && bits_of_int(32, fst(r)) = j) proof
      fix regs o2
      assume hro h2
      have rl rn _ := hro
      have h3 := mp(all_elim(hgsi, {regs}, {S1}, {o2}), rl, (int_le(seq_len(regs), 6) by simp(rn)), w1W, h2)
      show := apply(mp.gsi_q, hc, pbits, w1W, hh, pin1n, psh1n, cbl, hj, sta, hro, h3)
    qed
    have ths1n: gc.sound(S1) by simp(th1v)
    have v1s: S1.vm in x86_64_linux.Vm by simp(v1V)
    step r8, e8 hR8 from rewrite(mbe1, e7) with qgm using conj(w1W, w1u, ths1n, pbits, v1s)
    have ss1: fn_update(S1, "vm", S1.vm) = S1 by simp()
    step r9, e9 hR9 from rewrite(ss1, e8) with qgsi using conj(w1W, w1u, ths1n, pbits, v1s)
    // the group's header word cleared
    have hur huw := apply(mp.hdr_usable[c := c, A := A, vm := V1, b := B, objs := s.objs, g := g], hc, au, hat, hm1n, hsh, hus)
    have {gst = start, ghd = hdr, ghm = hmem} := apply(mp.nest_geo[c := c, A := A, M := mallocng.mview(V0, FP), b := B, brk := V0.brk, h := HG, j := j, g := g], hat, H, hhu, hj, hjl, hns)
    have pnz: !(P = 0) by arith(gst, ghd, ghm)
    have p0: int_add(P, 0) = P by arith(pbits)
    have mdr: g.mem_defined(S1, P, 0, 8, false) by simp(pnz, p0, pbits, hur)
    have mdw: g.mem_defined(S1, P, 0, 8, true) by simp(pnz, p0, pbits, huw)
    step k10 from e9 with g.ld64_det, mbe1, mp.st64w_det using conj(w1W, w1u, hgb, md16b, mdr, mdw, pbits)
    // nontrivial_free(m, idx): the container's slot given back, from the
    // state without g (one group fewer: the induction's)
    have {nab = abs, nun = univ, nho = holds, nth = thread, ntl = tls, nhu = hused, nro = ronly, nlen = len, nunt = unt, nfs = fsub, nrs = rsub, nrd = rdy} :=
      apply(mp.fg_nest_pre[c := c, A := A, s := s, b := B, g := g, k := k, h := HG, j := j, V1 := V1], hc, au, hat, hbt, hs, hin, hth, htl, hk, hkl, hkg, hhu, hj, hjl, hns, hemp, hnx, v1V, cov)
    let N := mp.dropn(A, g, k, HG, j)
    let V4h := mp.hdr0(V1, P)
    let S4 := fn_update(s, "vm", V4h)
    let H2 := fn_update(h, "A", N)
    have hg2 := mp(all_elim(mp.g_upd, {h}, {N}), hh, nab, nun)
    have v4V: V4h in x86_64_linux.Vm := mp(all_elim(ms.wr_any, {V1}, {P}, {8}, {0}), v1V)
    have w4W w4u := apply(mp.am_world, hs, su, v4V)
    have ths4: gc.sound(S4) by simp(nth)
    have hgo _ _ := apply(mp.meta_mem, hc, au, hat, hhm, hhu)
    have htop _ := apply(mp.meta_word, hc, au, hat, hhm, hhu)
    have hgb2: HG in bits(64) by arith(htop, hgo)
    have jb: j in bits(32) := rewrite(hR9, (bits_of_int(32, fst(r9)) in bits(32) by simp()))
    // (the thread pointer's word: in none of N's reserved slots)
    have trn := apply(mp.tls_res_in, hc, nun, nab, nho, fsb, ntl)
    have qnf: all regs o2. gc.regs_ok(regs, seq_concat(seq_one(gimple.arg(64, HG)), seq_one(gimple.arg(32, j)))) -> runs(nf[regs], S4, o2) ->
        abi.ovf_out(S4, o2) ||
        (ex V rr. (V in x86_64_linux.Vm && (ex A2. (A2 in mallocng.Abs && A2 in univ(1)) &&
           mallocng_specs.freed_back(c, N, A2, B, V4h, V, s.objs, fst(rr), snd(rr)))) && o2 = ok(fn_update(S4, "vm", V), rr)) proof
      fix regs o2
      assume hro h2
      have ln: int_le(seq_len(N.used), n) by arith(nlen, hdep, hn)
      have p1: int_le(seq_len(H2.A.used), n) by simp(ln)
      have p2: mallocng.holds_in(c, H2.A, S4.vm, S4.objs, H2.blocks) by simp(nho, keep(mallocng.holds_in))
      have p3: abi.thread_ok(S4.vm, S4.fs_base) by simp(nth, keep(abi.thread_ok))
      have p4: mallocng_specs.tls_apart(c, H2.A, S4.fs_base) by simp(ntl, keep(mallocng_specs.tls_apart))
      have p5: mallocng.is_used(H2.A, HG) by simp(nhu, keep(mallocng.is_used))
      have p6: mallocng.reserved_only(H2.A, HG, j) by simp(nro, keep(mallocng.reserved_only))
      have q := mp(all_elim(hnf, {S4}, {H2}, {HG}, {j}, {regs}, {o2}), w4W, hg2, hgb2, jb, p1, p2, p3, p4, p5, p6, hro, h2)
      show by simp(q, keep(mallocng_specs.freed_back))
    qed
    step V5 rr5, e11 hR11 from rewrite(p0, k10) with qnf using conj(w4W, w4u, ths4, hgb2, jb, v4V)
    have v5V e5x := hR11
    obtain A3, a3a a3u hfb3 from e5x
    have hin5 _ _ unt45 _ _ _ _ := expand(hfb3, mallocng_specs.freed_back)
    have {hm5 = mem, hsh5 = shown} := expand(hin5, mallocng.holds_in)
    // the thread pointer sound still: N's step wrote only N's bytes
    have ne5: all i. i in omega -> int_lt(i, 8) -> !(int_add(s.fs_base, i) in set_select(omega, x0. mallocng.in_reserved(N, x0))) proof
      fix i
      assume hi hil hm
      show by taut(set_select_def[s := omega, p := x0. mallocng.in_reserved(N, x0), z := int_add(s.fs_base, i)], hm, mp(all_elim(trn, {i}), hi, hil))
    qed
    have th5 := apply(mp.tls_unt[c := c, A := N, b := B, V0 := V4h, V1 := V5, objs := s.objs, fs := s.fs_base, e := set_select(omega, x0. mallocng.in_reserved(N, x0))],
      fsb, nth, ntl, unt45, ne5)
    // g's meta joinable to A3's free list
    have drn := apply(mp.dropr_nest[c := c, A := A, M := mallocng.mview(V0, FP), b := B, brk := V0.brk, g := g, k := k, h := HG, j := j], hc, au, hat, H, hk, hkl, hkg, hhu, hj, hjl, hns)
    have htN: N.taken = seq_concat(A.taken, seq_one(g)) by simp()
    have {mj5 = jn} := apply(mp.fg_nest_jn[c := c, A := A, N := N, A3 := A3, b := B, g := g, V2 := V4h, V3 := V5, objs := s.objs, mb := fst(rr5), ml := snd(rr5),
      M := mallocng.mview(V0, FP), brk := V0.brk], hc, au, hat, H, hus, drn, htN, nrd, a3u, a3a, hfb3)
    let S5 := fn_update(s, "vm", V5)
    have w5W w5u := apply(mp.am_world, hs, su, v5V)
    have vb5: V5.bytes in fn_space(bits(64), bits(8)) by simp(v5V)
    // free_meta(g) on V5: g given back, after its container's slot
    have fq5: FQ(V5, fst(rr5), snd(rr5)) proof
      fix regs o2
      assume hro h2
      have la5 := rewrite(kf, apply(mp.free_metas_at[c := c, A := A3, vm := V5, b := B, objs := s.objs], hc, a3u, a3a, vb5, hm5, hsh5, cal))
      have laW: mallocng_specs.list_at(S5.vm, S5.objs, bits_add(64, CTX, 16), A3.free_metas) by simp(rewrite(sym(pb), la5), keep(mallocng_specs.list_at))
      have mjW: mallocng_specs.meta_joinable(S5.vm, S5.objs, bits_add(64, CTX, 16), A3.free_metas, g) by simp(rewrite(sym(pb), mj5), keep(mallocng_specs.meta_joinable))
      have thW: abi.thread_ok(S5.vm, S5.fs_base) by simp(th5, keep(abi.thread_ok))
      have fs8W: int_le(int_add(S5.fs_base, 8), int_pow(2, 64)) by simp(fs8)
      have fsgW: int_le(int_add(S5.fs_base, 8), g) || int_le(int_add(g, 40), S5.fs_base) by simp(fsg)
      have fl: A3.free_metas in list_type(omega) by simp(a3a)
      have q := apply(mp.fm_q, w5W, w5u, kbm, hgb, phl, fl, laW, mjW, thW, fs8W, fsgW, hro, h2)
      have q2: case 2 of q proof
        assume e
        obtain V6 r, hv6 hfd ho from e
        have fd: mallocng_specs.meta_freed(V5, V6, s.objs, int_add(c.ctx, 16), g) by simp(rewrite(pb, hfd), keep(mallocng_specs.meta_freed))
        have out := apply(mp.fg_nest_out[c := c, A := A, N := N, A3 := A3, s := s, b := B, g := g, V2 := V4h, V3 := V5, V4 := V6, mb := fst(rr5), ml := snd(rr5)],
          hc, au, hat, hbt, hs, hin, cal, hus, nun, nab, drn, htN, (N.init_done = A.init_done && N.auxv = A.auxv && N.auxv_at = A.auxv_at by simp()),
          nunt, nfs, nrs, nrd, a3u, a3a, hfb3, v5V, hv6, fd)
        show by disj({2}, ex_intro({V6}, {r}, taut(hv6, out, ho)))
      qed
      show by taut(q, q2)
    qed
    show by disj({2}, ex_intro({V5}, {j}, {HG}, {P}, {fst(rr5)}, {snd(rr5)}, taut(v5V, th5, fq5, e11)))
  qed
  have mc: int_lt(0, A.metas[g].maplen) || A.metas[g].maplen = 0 by arith(vml)
  show := mp(finish, (T2 by taut(mc, own, nest)))
qed
