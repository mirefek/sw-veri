// Prototype: __init_libc's walk of the initial stack (envp, then the
// auxiliary vector into its aux array), the stack's data the callers'
// stack objects.

// (the live objects with the new ones at l, of sizes sz)
abbrev g.live_with(v, l, sz) := set_select(omega, x7. x7 in v || (ex x8. x8 in omega && ((int_lt(x8, seq_len(sz)) && int_le(app(l, x8), x7)) &&
  int_lt(x7, int_add(app(l, x8), fst(app(sz, x8)))))))

// stack objects allocated (as mp.alloc1_inv, for any sizes): no room, an
// overflow; or at l, placed as objs_fit has it, their bytes any
theorem g.alloc_inv: all sz w o. w in abi.World -> runs(gimple.alloc_objs(sz), w, o) ->
  abi.ovf_out(w, o) ||
  (ex l V. ((l in list_type(bits(64)) && gimple.objs_fit(w.vm, w.objs, sz, l)) &&
     (V in x86_64_linux.Vm && (fn_update(V, "bytes", w.vm.bytes) = w.vm &&
      (all x5. x5 in bits(64) -> (all x6. x6 in omega -> int_lt(x6, seq_len(sz)) -> !(int_le(l[x6], x5) && int_lt(x5, int_add(l[x6], fst(sz[x6]))))) ->
        V.bytes[x5] = w.vm.bytes[x5])))) &&
     o = ok(fn_update(fn_update(w, "vm", V), "objs", fn_update(w.objs, "live", g.live_with(w.objs.live, l, sz))), l))
proof
  fix sz w o
  assume hw h
  let OVF := exc_val("stack_overflow", empty)
  have b := apply(g.runs_elim, expand(h, gimple.alloc_objs))
  obtain x0, hg ht from b
  let FIT := ex x1. x1 in list_type(bits(64)) && gimple.objs_fit(w.vm, w.objs, sz, x1)
  have pv pf pd _ := apply(ms.world_parts, hw)
  have ws: fn_update(w, "vm", w.vm) = w := mp(fn_update_same[f := w, k := "vm"], pf, pd)
  have wo: fn_update(fn_update(w, "vm", w.vm), "objs", w.objs) = w := trans(apply(gc.vm_objs, {w}, {w.vm}, hw), ws)
  have oo: w.objs in abi.Objs by simp(expand(hw, abi.World))
  have c1: !FIT -> abi.ovf_out(w, o) proof
    assume nf
    have e: x0 = exc(pair(w, empty), pair("raise", OVF)) by taut(hg, nf)
    have oe: o = exc(w, OVF) by simp(rewrite(e, ht))
    show by ex_intro({w.vm}, {w.objs}, taut(pv, oo, subst({y. o = exc(y, OVF)}, sym(wo), oe)))
  qed
  let PV(l, V) := V in x86_64_linux.Vm && (fn_update(V, "bytes", w.vm.bytes) = w.vm && (all x5. x5 in bits(64) -> (all x6. x6 in omega -> int_lt(x6, seq_len(sz)) ->
    !(int_le(l[x6], x5) && int_lt(x5, int_add(l[x6], fst(sz[x6]))))) -> V.bytes[x5] = w.vm.bytes[x5]))
  have c2: FIT -> ex l V. ((l in list_type(bits(64)) && gimple.objs_fit(w.vm, w.objs, sz, l)) && PV(l, V)) &&
      o = ok(fn_update(fn_update(w, "vm", V), "objs", fn_update(w.objs, "live", g.live_with(w.objs.live, l, sz))), l) proof
    assume f
    have e: x0 = ok(pair(w, empty), empty) by taut(hg, f)
    have t1 := rewrite(e, ht)
    have f0: fst(ok(pair(w, empty), empty)) = 0 by simp()
    have f1: fst(out_state(ok(pair(w, empty), empty))) = w by simp()
    have t2 := rewrite(f1, rewrite(f0, t1))
    have a0: any_rel(x1. x1 in list_type(bits(64)) && gimple.objs_fit(w.vm, w.objs, sz, x1), x1. letin(x1, x2. letin(w.vm, x3. any_rel(x4. x4 in x86_64_linux.Vm &&
        (fn_update(fn_update(w, "vm", x4).vm, "bytes", x3.bytes) = x3 && (all x5. x5 in bits(64) -> (all x6. x6 in omega -> int_lt(x6, seq_len(sz)) ->
          !(int_le(x2[x6], x5) && int_lt(x5, int_add(x2[x6], fst(sz[x6]))))) -> fn_update(w, "vm", x4).vm.bytes[x5] = x3.bytes[x5])),
        x4. letin(fn_update(w, "vm", x4), x5. letin(fn_update(x5, "objs", fn_update(x5.objs, "live", set_select(omega, x6. x6 in x5.objs.live ||
          (ex x7. x7 in omega && ((int_lt(x7, seq_len(sz)) && int_le(x2[x7], x6)) && int_lt(x6, int_add(x2[x7], fst(sz[x7])))))))), x6. o = ok(x6, x2)))))))
      by taut(t2, refl({0}), (!(0 = 1) by simp()), (!(0 = 2) by simp()))
    obtain l, hl1 hl2 hk from apply(g.any_e, f, a0)
    have hl: l in list_type(bits(64)) && gimple.objs_fit(w.vm, w.objs, sz, l) by taut(hl1, hl2)
    have vb: fn_update(w.vm, "bytes", w.vm.bytes) = w.vm := mp(fn_update_same[f := w.vm, k := "bytes"], (is_fun(w.vm) by simp(expand(pv, x86_64_linux.Vm))), ("bytes" in dom(w.vm) by simp(expand(pv, x86_64_linux.Vm))))
    have vx: ex V. PV(l, V) by ex_intro({w.vm}, simp(pv, vb))
    have k2: any_rel(x4. PV(l, x4), x4. o = ok(fn_update(fn_update(w, "vm", x4), "objs", fn_update(w.objs, "live", g.live_with(w.objs.live, l, sz))), l))
      by simp(expand(hk, letin), keep(any_rel))
    obtain V, v1 v23 hoV from apply(g.any_e, vx, k2)
    have pvv: PV(l, V) by taut(v1, v23)
    show by ex_intro({l}, {V}, taut(hl, pvv, hoV))
  qed
  show by taut(c1, c2)
qed

// (an object alloc_objs placed, k-th: usable -- its bytes the new live
// objects', on none of the world's pages; as mp.obj_usable for any sizes)
theorem g.alloc_usable(vm, objs, sz, V, l, k, wr): gimple.objs_fit(vm, objs, sz, l) -> l[k] in omega -> V.pages = vm.pages -> k in omega -> int_lt(k, seq_len(sz)) ->
  gimple.usable(V, fn_update(objs, "live", g.live_with(objs.live, l, sz)), l[k], fst(sz[k]), wr)
proof
  assume hf ho hp hk hkl
  have _ hall _ := expand(hf, gimple.objs_fit)
  have _ _ l8 sf := mp(all_elim(hall, {k}), hk, hkl)
  let N := fst(sz[k])
  let O := fn_update(objs, "live", g.live_with(objs.live, l, sz))
  let P(i) := int_div(int_add(l[k], i), x86_64_linux.PAGE)
  let C(i) := x86_64_linux.mapped(V, P(i)) && !(snd(V.pages[P(i)]).kind = 2)
  have g: all i. i in omega -> int_lt(i, N) -> ite(C(i), ite(wr, snd(V.pages[P(i)]).prot.w, snd(V.pages[P(i)]).prot.r) && int_add(l[k], i) in O.c_bytes,
      int_lt(int_add(l[k], i), int_pow(2, 64)) && int_add(l[k], i) in O.live) proof
    fix i
    assume hi hil
    have s1 := mp(all_elim(sf, {int_add(l[k], i)}), arith(ho, hi), arith(ho, hi, hil))
    have s2 := rewrite(sym(hp), expand(s1, abi.stack_free, x86_64_linux.mapped))
    have nc: !C(i) by defs(taut(s2), x86_64_linux.mapped)
    have lt: int_lt(int_add(l[k], i), int_pow(2, 64)) by arith(l8, hil, ho, hi)
    have ek: ex x8. x8 in omega && ((int_lt(x8, seq_len(sz)) && int_le(app(l, x8), int_add(l[k], i))) &&
        int_lt(int_add(l[k], i), int_add(app(l, x8), fst(app(sz, x8))))) by ex_intro({k},
          taut(hk, hkl, (int_le(l[k], int_add(l[k], i)) by arith(ho, hi)), (int_lt(int_add(l[k], i), int_add(l[k], N)) by arith(ho, hil))))
    have il0: int_add(l[k], i) in g.live_with(objs.live, l, sz) by sel(taut((int_add(l[k], i) in omega by arith(ho, hi)), ek))
    have il: int_add(l[k], i) in O.live by simp(il0)
    show := rewrite(sym(mp(ite_f[c := C(i), a := ite(wr, snd(V.pages[P(i)]).prot.w, snd(V.pages[P(i)]).prot.r) && int_add(l[k], i) in O.c_bytes,
      b := int_lt(int_add(l[k], i), int_pow(2, 64)) && int_add(l[k], i) in O.live], nc)),
      (int_lt(int_add(l[k], i), int_pow(2, 64)) && int_add(l[k], i) in O.live by taut(lt, il)))
  qed
  show by defs(g, gimple.usable)
qed

// (the world after alloc_objs: a world -- as mp.w1_world for any sizes)
theorem g.alloc_world(s, V, l, sz): s in abi.World -> s in univ(1) -> V in x86_64_linux.Vm ->
  fn_update(fn_update(s, "vm", V), "objs", fn_update(s.objs, "live", g.live_with(s.objs.live, l, sz))) in abi.World &&
  fn_update(fn_update(s, "vm", V), "objs", fn_update(s.objs, "live", g.live_with(s.objs.live, l, sz))) in univ(1)
proof
  assume hw hu hv
  let L := g.live_with(s.objs.live, l, sz)
  have vu := apply(x86.vm_univ, hv)
  have ss: subset(L, omega) proof
    have g: all z. z in L -> z in omega proof
      fix z
      assume hz
      have d := set_select_def[s := omega, p := x7. x7 in s.objs.live || (ex x8. x8 in omega && ((int_lt(x8, seq_len(sz)) && int_le(app(l, x8), x7)) &&
        int_lt(x7, int_add(app(l, x8), fst(app(sz, x8)))))), z := z]
      show by taut(d, hz)
    qed
    show by defs(g, subset)
  qed
  have lu := mp(univ_subset[u := 1, a := L, b := omega], omega_univ, ss)
  have lt: L in set_type(omega) by defs(taut(ss, powerset_def[s := omega, a := L]), set_type)
  have wou := mp(app_univ[u := 1, f := s, k := "objs"], hu)
  have ou: fn_update(s.objs, "live", L) in univ(1) by simp(wou, lu)
  have wW: fn_update(fn_update(s, "vm", V), "objs", fn_update(s.objs, "live", L)) in abi.World by defs(simp(expand(hw, abi.World), hu, hv, vu, ss, lu, lt), abi.World)
  show by taut(wW, (fn_update(fn_update(s, "vm", V), "objs", fn_update(s.objs, "live", L)) in univ(1) by simp(hu, vu, ou)))
qed

// (usable bytes: apart from a new object -- its bytes free, theirs not)
theorem g.alloc_apart(vm, objs, sz, l, k, a, n, wr): gimple.objs_fit(vm, objs, sz, l) -> k in omega -> int_lt(k, seq_len(sz)) -> l[k] in omega ->
  int_lt(0, fst(sz[k])) -> gimple.usable(vm, objs, a, n, wr) -> a in omega -> n in omega -> int_lt(0, n) ->
  int_le(int_add(a, n), l[k]) || int_le(int_add(l[k], fst(sz[k])), a)
proof
  assume hf hk hkl ho hs hu ha hn hn0
  have _ hall _ := expand(hf, gimple.objs_fit)
  have _ _ _ sf := mp(all_elim(hall, {k}), hk, hkl)
  let N := fst(sz[k])
  have c1: int_le(l[k], a) -> int_lt(a, int_add(l[k], N)) -> false proof
    assume h1 h2
    have fr := mp(all_elim(sf, {a}), ha, (int_le(l[k], a) && int_lt(a, int_add(l[k], N)) by taut(h1, h2)))
    have nf := apply(mp.nofree[vm := vm, objs := objs, a := a, n := n, w := wr, i := 0], hu, simp(), hn0)
    have z: int_add(a, 0) = a by arith(ha)
    show by taut(fr, rewrite(z, nf))
  qed
  have c2: int_lt(a, l[k]) -> int_lt(l[k], int_add(a, n)) -> false proof
    assume h1 h2
    let J := int_sub(l[k], a)
    have fr := mp(all_elim(sf, {l[k]}), ho, (int_le(l[k], l[k]) && int_lt(l[k], int_add(l[k], N)) by arith(ho, hs)))
    have nf := apply(mp.nofree[vm := vm, objs := objs, a := a, n := n, w := wr, i := J], hu, arith(h1, ha, ho), arith(h2, ha, ho))
    have z: int_add(a, J) = l[k] by arith(ha, ho)
    show by taut(fr, rewrite(z, nf))
  qed
  show by arith(c1, c2, ha, hn, ho, hn0)
qed

// (bytes usable before the allocation: read in the memory after it as
// before)
theorem g.alloc_read(vm, objs, sz, l, V, a, n, wr): gimple.objs_fit(vm, objs, sz, l) ->
  (all x5. x5 in bits(64) -> (all x6. x6 in omega -> int_lt(x6, seq_len(sz)) -> !(int_le(l[x6], x5) && int_lt(x5, int_add(l[x6], fst(sz[x6]))))) ->
    V.bytes[x5] = vm.bytes[x5]) ->
  gimple.usable(vm, objs, a, n, wr) -> a in omega -> n in omega ->
  gimple.bytes_at(V, a, n) = gimple.bytes_at(vm, a, n)
proof
  assume hf hv hu ha hn
  have _ hall _ := expand(hf, gimple.objs_fit)
  have pe: all i. i in omega -> int_lt(i, n) -> V.bytes[bits_add(64, a, bits_of_int(64, i))] = vm.bytes[bits_add(64, a, bits_of_int(64, i))] proof
    fix i
    assume hi hil
    have nf := apply(mp.nofree[vm := vm, objs := objs, a := a, n := n, w := wr, i := i], hu, hi, hil)
    have lt := apply(mp.usable_lt[vm := vm, objs := objs, a := a, n := n, w := wr, i := i], hu, ha, hi, hil)
    have ea: bits_add(64, a, bits_of_int(64, i)) = int_add(a, i) by defs(arith(ha, hi, lt), bits_add, bits_of_int, pow2)
    have ab: int_add(a, i) in bits(64) by arith(ha, hi, lt)
    have out: all x6. x6 in omega -> int_lt(x6, seq_len(sz)) -> !(int_le(l[x6], int_add(a, i)) && int_lt(int_add(a, i), int_add(l[x6], fst(sz[x6])))) proof
      fix x6
      assume h6 h6l
      have _ _ _ sf := mp(all_elim(hall, {x6}), h6, h6l)
      have c: int_le(l[x6], int_add(a, i)) && int_lt(int_add(a, i), int_add(l[x6], fst(sz[x6]))) -> false proof
        assume hin
        have fr := mp(all_elim(sf, {int_add(a, i)}), arith(ha, hi), hin)
        show by taut(fr, nf)
      qed
      show by taut(c)
    qed
    show := rewrite(sym(ea), mp(all_elim(hv, {int_add(a, i)}), ab, out))
  qed
  show := apply(mp.bytes_same[U := V, vm := vm, a := a, n := n], hn, pe)
qed

// (memory defined before stack objects are allocated: defined after -- the
// same pages, the live objects grown, bytes changed only)
theorem g.md_alloc: all w V l sz p off k wr. g.mem_defined(w, p, off, k, wr) -> w in abi.World -> fn_update(V, "bytes", w.vm.bytes) = w.vm ->
  g.mem_defined(fn_update(fn_update(w, "vm", V), "objs", fn_update(w.objs, "live", g.live_with(w.objs.live, l, sz))), p, off, k, wr)
proof
  fix w V l sz p off k wr
  assume hd hw hvb
  have lv: all x. x in w.objs.live -> x in g.live_with(w.objs.live, l, sz) proof
    fix x
    assume hx
    have wob: w.objs in abi.Objs by simp(expand(hw, abi.World))
    have lo _ := apply(abi.objs_parts, wob)
    have sub: subset(w.objs.live, omega) by taut(powerset_def[s := omega, a := w.objs.live], expand(lo, set_type))
    have xo := mp(subset_elim[a := w.objs.live, b := omega, z := x], sub, hx)
    show by sel(taut(hx, xo))
  qed
  have d1 d2 du := hd
  have ul := apply(mp.usable_live[vm := w.vm, objs := w.objs, L := g.live_with(w.objs.live, l, sz), a := int_add(p, off), n := k, w := wr], du, lv)
  have ub := apply(mp.usable_bytes[v := w.vm, v2 := V, objs := fn_update(w.objs, "live", g.live_with(w.objs.live, l, sz)), a := int_add(p, off), n := k, w := wr], hvb, ul)
  show by simp(d1, d2, ub)
qed

mem_closure g.md_alloc
mem_closure g.alloc_world
mem_closure ms.world_parts

// (a world with its objects set, its memory then written: a world, its
// memory's facts -- as ms.sw_st0, ms.md_st0 after an allocation)
theorem g.sw_st_objs: all s V O a n v. fn_update(fn_update(s, "vm", V), "objs", O) in abi.World -> fn_update(fn_update(s, "vm", V), "objs", O) in univ(1) -> a in bits(64) ->
  fn_update(fn_update(fn_update(s, "vm", V), "objs", O), "vm", fn_update(V, "bytes", x86_64_linux.store_le(V.bytes, a, n, v))) in abi.World &&
  fn_update(fn_update(fn_update(s, "vm", V), "objs", O), "vm", fn_update(V, "bytes", x86_64_linux.store_le(V.bytes, a, n, v))) in univ(1)
proof
  fix s V O a n v
  assume hw hu ha
  have w2 u2 := apply(tr.world_store, {fn_update(fn_update(s, "vm", V), "objs", O)}, {a}, {n}, {v}, hw, hu, ha)
  show by simp(w2, u2)
qed

theorem g.md_st_objs: all s V O a n v p off k w. g.mem_defined(fn_update(fn_update(s, "vm", V), "objs", O), p, off, k, w) ->
  g.mem_defined(fn_update(fn_update(fn_update(s, "vm", V), "objs", O), "vm", fn_update(V, "bytes", x86_64_linux.store_le(V.bytes, a, n, v))), p, off, k, w)
proof
  fix s V O a n v p off k w
  assume hd
  have d1 d2 du := hd
  have e := all_elim(ms.f_usable, {V}, {x86_64_linux.store_le(V.bytes, a, n, v)}, {O}, {int_add(p, off)}, {k}, {w})
  show by simp(d1, d2, du, e)
qed

mem_closure g.sw_st_objs
mem_closure g.md_st_objs

// aux[j] after the first k pairs of the auxiliary vector AX: the value of
// a pair with key j among them, else 0
def sp.aux_val(AX, k, j, v) := (ex m. (m in omega && int_lt(m, k)) && fst(AX[m]) = j && snd(AX[m]) = v) ||
  (!(ex m. (m in omega && int_lt(m, k)) && fst(AX[m]) = j) && v = 0)

theorem sp.aux_val0: all AX j. sp.aux_val(AX, 0, j, 0)
proof
  fix AX j
  have n: !(ex m. (m in omega && int_lt(m, 0)) && fst(AX[m]) = j) proof
    assume h
    obtain m, hm hl _ from h
    show by arith(hm, hl)
  qed
  show by defs(taut(n, refl({0})), sp.aux_val)
qed

theorem sp.aux_hit: all AX k j. k in omega -> fst(AX[k]) = j -> sp.aux_val(AX, int_add(k, 1), j, snd(AX[k]))
proof
  fix AX k j
  assume hk he
  have e: ex m. (m in omega && int_lt(m, int_add(k, 1))) && fst(AX[m]) = j && snd(AX[m]) = snd(AX[k])
    by ex_intro({k}, taut(hk, (int_lt(k, int_add(k, 1)) by arith(hk)), he, refl({snd(AX[k])})))
  show by defs(taut(e), sp.aux_val)
qed

theorem sp.aux_miss: all AX k j v. k in omega -> !(fst(AX[k]) = j) -> sp.aux_val(AX, k, j, v) -> sp.aux_val(AX, int_add(k, 1), j, v)
proof
  fix AX k j v
  assume hk hn ha
  have c1: (ex m. (m in omega && int_lt(m, k)) && fst(AX[m]) = j && snd(AX[m]) = v) -> sp.aux_val(AX, int_add(k, 1), j, v) proof
    assume h
    obtain m, hm hl h1 h2 from h
    have e: ex m. (m in omega && int_lt(m, int_add(k, 1))) && fst(AX[m]) = j && snd(AX[m]) = v
      by ex_intro({m}, taut(hm, (int_lt(m, int_add(k, 1)) by arith(hl)), h1, h2))
    show by defs(taut(e), sp.aux_val)
  qed
  have c2: !(ex m. (m in omega && int_lt(m, k)) && fst(AX[m]) = j) -> v = 0 -> sp.aux_val(AX, int_add(k, 1), j, v) proof
    assume hno hv
    have n: !(ex m. (m in omega && int_lt(m, int_add(k, 1))) && fst(AX[m]) = j) proof
      assume h
      obtain m, hm hl h1 from h
      have c: int_lt(m, k) || m = k by arith(hl, hm, hk)
      have d1: int_lt(m, k) -> false proof
        assume lt
        have e: ex m. (m in omega && int_lt(m, k)) && fst(AX[m]) = j by ex_intro({m}, taut(hm, lt, h1))
        show by taut(e, hno)
      qed
      have d2: m = k -> false proof
        assume eq
        show by taut(hn, rewrite(eq, h1))
      qed
      show by taut(c, d1, d2)
    qed
    show by defs(taut(n, hv), sp.aux_val)
  qed
  show by taut(expand(ha, sp.aux_val), c1, c2)
qed

// (defined in a world with memory M: defined with U, M but for bytes)
theorem g.md_bytes: all s M U a off n wr. fn_update(U, "bytes", M.bytes) = M -> g.mem_defined(fn_update(s, "vm", M), a, off, n, wr) ->
  g.mem_defined(fn_update(s, "vm", U), a, off, n, wr)
proof
  fix s M U a off n wr
  assume hb hd
  have h1 h2 h3 := hd
  have u3: gimple.usable(M, s.objs, int_add(a, off), n, wr) by simp(h3)
  have uU := apply(mp.usable_bytes[v := M, v2 := U, objs := s.objs, a := int_add(a, off), n := n, w := wr], hb, u3)
  show by simp(h1, h2, uU)
qed

// (bytes read in a memory U equal to M outside [b, b + m): as in M,
// where they are outside it)
theorem g.read_outside(U, M, b, m, a, n): (all x. x in bits(64) -> !(int_le(b, x) && int_lt(x, int_add(b, m))) -> U.bytes[x] = M.bytes[x]) ->
  int_le(int_add(a, n), b) || int_le(int_add(b, m), a) -> a in omega -> n in omega -> int_le(int_add(a, n), 18446744073709551616) ->
  gimple.bytes_at(U, a, n) = gimple.bytes_at(M, a, n)
proof
  assume hU hap ha hn hl
  have pe: all i. i in omega -> int_lt(i, n) -> U.bytes[bits_add(64, a, bits_of_int(64, i))] = M.bytes[bits_add(64, a, bits_of_int(64, i))] proof
    fix i
    assume hi hil
    have ea: bits_add(64, a, bits_of_int(64, i)) = int_add(a, i) by defs(arith(ha, hi, hil, hl), bits_add, bits_of_int, pow2)
    have ab: int_add(a, i) in bits(64) by arith(ha, hi, hil, hl)
    have out: !(int_le(b, int_add(a, i)) && int_lt(int_add(a, i), int_add(b, m))) by arith(hap, ha, hi, hil)
    show := rewrite(sym(ea), mp(all_elim(hU, {int_add(a, i)}), ab, out))
  qed
  show := apply(mp.bytes_same[U := U, vm := M, a := a, n := n], hn, pe)
qed

theorem sp.il_probe: all envp pn G1 G2 G3 G4 G5 w o. w in abi.World -> runs(c_src_env___libc_start_main.__init_libc(envp, pn, G1, G2, G3, G4, G5), w, o) ->
  envp in bits(64) -> g.mem_defined(w, c_src_env___libc_start_main.__environ, 0, 8, true) -> g.mem_defined(w, c_src_env___libc_start_main.__libc, 8, 8, true) ->
  // envp: N words, nonzero, then a zero word (readable, apart from __environ)
  (all N. N in omega -> !(envp = 0) -> int_lt(int_add(envp, int_mul(8, int_add(N, 2))), int_pow(2, 63)) ->
    (all i. i in omega -> int_le(i, N) -> gimple.usable(w.vm, w.objs, int_add(envp, int_mul(8, i)), 8, false)) ->
    (all i. i in omega -> int_lt(i, N) -> !(gimple.bytes_at(w.vm, int_add(envp, int_mul(8, i)), 8) = 0)) ->
    gimple.bytes_at(w.vm, int_add(envp, int_mul(8, N)), 8) = 0 ->
    int_le(int_add(envp, int_mul(8, int_add(N, 1))), c_src_env___libc_start_main.__environ) || int_le(int_add(c_src_env___libc_start_main.__environ, 8), envp) ->
    // (the globals written: writable, below the initial stack)
    g.mem_defined(w, c_src_env___libc_start_main.__hwcap, 0, 8, true) -> g.mem_defined(w, c_src_env___libc_start_main.__sysinfo, 0, 8, true) ->
    g.mem_defined(w, c_src_env___libc_start_main.__libc, 48, 8, true) -> g.mem_defined(w, c_src_env___libc_start_main.__progname, 0, 8, true) ->
    g.mem_defined(w, c_src_env___libc_start_main.__progname_full, 0, 8, true) -> int_le(4228272, envp) ->
    // auxv: past envp's zero word, its pairs AX up to AT_NULL (apart from
    // __environ and libc.auxv)
    (all AX. AX in list_type(cart(omega, omega)) -> int_le(1, seq_len(AX)) ->
      (all k. k in omega -> int_lt(k, seq_len(AX)) ->
        gimple.usable(w.vm, w.objs, int_add(int_add(envp, int_mul(8, int_add(N, 1))), int_mul(16, k)), 16, false) &&
        gimple.bytes_at(w.vm, int_add(int_add(envp, int_mul(8, int_add(N, 1))), int_mul(16, k)), 8) = fst(AX[k]) &&
        gimple.bytes_at(w.vm, int_add(int_add(int_add(envp, int_mul(8, int_add(N, 1))), int_mul(16, k)), 8), 8) = snd(AX[k])) ->
      fst(AX[int_sub(seq_len(AX), 1)]) = 0 -> (all k. k in omega -> int_lt(int_add(k, 1), seq_len(AX)) -> !(fst(AX[k]) = 0)) ->
      int_lt(int_add(int_add(envp, int_mul(8, int_add(N, 1))), int_mul(16, seq_len(AX))), int_pow(2, 63)) ->
      int_le(int_add(int_add(envp, int_mul(8, int_add(N, 1))), int_mul(16, seq_len(AX))), c_src_env___libc_start_main.__environ) ||
        int_le(int_add(c_src_env___libc_start_main.__environ, 8), int_add(envp, int_mul(8, int_add(N, 1)))) ->
      int_le(int_add(int_add(envp, int_mul(8, int_add(N, 1))), int_mul(16, seq_len(AX))), int_add(c_src_env___libc_start_main.__libc, 8)) ||
        int_le(int_add(c_src_env___libc_start_main.__libc, 16), int_add(envp, int_mul(8, int_add(N, 1)))) ->
  abi.ovf_out(w, o) || true))
proof
  fix envp pn G1 G2 G3 G4 G5 w o
  assume hw hr heb hev hlb
  fix N
  assume hN hen0 hbd hus hnz hz0 hea hhw hsi hps hpg hpf hst
  fix AX
  assume axt ax1 axk axe axn axb axe1 axe2
  have pu := apply(g.runs_univ, hr)
  have hu: w in univ(1) by simp(pu)
  step a1 a2 a3 o1 l V, hk hll hfit hVm hvb hvf from hr with g.alloc_inv using conj(hw, hu)
  let SZ := seq_concat(seq_one(pair(24, 16)), seq_one(pair(304, 16)))
  let O1 := fn_update(w.objs, "live", g.live_with(w.objs.live, l, SZ))
  let W1 := fn_update(fn_update(w, "vm", V), "objs", O1)
  have e2 := mp(app_update_other[f := V, k := "bytes", v := w.vm.bytes, x := "pages"], (!("pages" = "bytes") by simp()))
  have pe: V.pages = w.vm.pages := sym(rewrite(hvb, e2))
  have ln2: seq_len(l) = 2 by simp(expand(hfit, gimple.objs_fit))
  have l1b: l[1] in bits(64) := mp(at_type[l := l, t := bits(64), i := 1], hll, simp(), simp(ln2))
  have us := apply(g.alloc_usable[vm := w.vm, objs := w.objs, sz := SZ, V := V, l := l, k := 1, wr := true], hfit, simp(l1b), pe, simp(), simp())
  have w1W w1u := apply(g.alloc_world[s := w, V := V, l := l, sz := SZ], hw, hu, hVm)
  have t1 := apply(tr.seq_one_type, (pair(24, 16) in univ(1) by simp()))
  have t2 := apply(tr.seq_one_type, (pair(304, 16) in univ(1) by simp()))
  have aS := at({SZ[1]}, t1, t2)
  have sz1: fst(SZ[1]) = 304 by simp(aS)
  have szl: seq_len(SZ) = 2 by simp(t1, t2)
  have _ hall _ := expand(hfit, gimple.objs_fit)
  have _ l1nz l1le _ := mp(all_elim(hall, {1}), simp(), simp(szl))
  have us2 := rewrite(sz1, us)
  have md0: g.mem_defined(W1, l[1], 0, 304, true) by simp(us2, l1nz, rewrite(sz1, l1le), l1b)
  let ENV := c_src_env___libc_start_main.__environ
  have envb: ENV in bits(64) by defs(simp(), c_src_env___libc_start_main.__environ)
  step h6 from hk with g.stzero_det, g.st64_det using conj(hw, hu, hVm, hvb, l1b, md0, envb, hev)
  // the envp scan: i words passed, nonzero (the world W3 as the stores left it)
  obtain r, wl kr from h6
  let BODY(x, y) := loop_body(wl)
  let VM3 := fn_update(V, "bytes", x86_64_linux.store_le(x86_64_linux.store_le(V.bytes, int_add(l[1], 0), 304, 0), int_add(ENV, 0), 8, envp))
  let W3 := fn_update(W1, "vm", VM3)
  let X(i) := pair(W3, pair(pn, pair(a1, pair(i, a3))))
  let T64 := fn_update(fn_update(empty, "prec", 64), "signed", true)
  have l1o: l[1] in omega by simp(l1b)
  have l1r: int_le(int_add(int_add(l[1], 0), 304), 18446744073709551616) by arith(rewrite(sz1, l1le), l1o)
  have w2W w2u := apply(g.sw_st_objs, {w}, {V}, {O1}, {int_add(l[1], 0)}, {304}, {0}, w1W, w1u, arith(l1b))
  have w3W w3u := apply(ms.sw_st, {W1}, {V}, {x86_64_linux.store_le(V.bytes, int_add(l[1], 0), 304, 0)}, {int_add(ENV, 0)}, {8}, {envp}, w2W, w2u, arith(envb))
  have trip: all i y. i in omega -> int_le(i, N) -> BODY(X(i), y) ->
      (int_lt(i, N) && y = ok(X(int_add(i, 1)), empty)) || (i = N && y = exc(X(i), pair("brk", empty))) proof
    fix i y
    assume hi hiN hb
    let A := int_add(envp, int_mul(8, i))
    have de: bits_mul(64, i, 8) = int_mul(8, i) by defs(arith(hi, hiN, hbd, heb), bits_mul, bits_of_int, pow2)
    have sv: gimple.sval(T64, int_mul(8, i)) = int_mul(8, i) by defs(simp((int_lt(int_mul(8, i), 9223372036854775808) by arith(hi, hiN, hbd, heb))), gimple.sval)
    have pe8: int_add(envp, gimple.sval(T64, bits_mul(64, i, 8))) = A by simp(de, sv)
    have ab: A in bits(64) by arith(hi, hiN, hbd, heb)
    have pd := apply(g.padd_det, {W3}, {envp}, {bits_mul(64, i, 8)}, w3u, heb, simp(), arith(pe8, ab), defs(arith(pe8, ab), pow2))
    have ui := mp(all_elim(hus, {i}), hi, hiN)
    have hmA: g.mem_defined(w, A, 0, 8, false) by simp(ui, (!(A = 0) by arith(hi, hen0, heb)), (int_lt(A, pow2(64)) by defs(arith(ab), pow2)))
    have ap1 := apply(g.alloc_apart[vm := w.vm, objs := w.objs, sz := SZ, l := l, k := 1, a := A, n := 8, wr := false], hfit, simp(), simp(szl), l1o, simp(sz1), ui, arith(ab), simp(), simp())
    have rd := apply(g.alloc_read[vm := w.vm, objs := w.objs, sz := SZ, l := l, V := V, a := A, n := 8, wr := false], hfit, hvf, ui, arith(ab), simp())
    // (the word read: the entry's, through the stores and the allocation)
    let P := int_add(envp, gimple.sval(T64, bits_mul(64, i, 8)))
    have pb: P in bits(64) by simp(pe8, ab)
    have hmP: g.mem_defined(w, P, 0, 8, false) := rewrite(sym(pe8), hmA)
    have pr: int_le(int_add(P, 8), 18446744073709551616) by arith(pe8, hi, hiN, hbd, heb)
    have ap2: int_le(int_add(int_add(P, 0), 8), int_add(l[1], 0)) || int_le(int_add(int_add(l[1], 0), 304), int_add(P, 0)) by arith(rewrite(sz1, ap1), pe8, l1o, ab)
    have m1 := apply(g.md_alloc, {w}, {V}, {l}, {SZ}, {P}, {0}, {8}, {false}, hmP, hw, hvb)
    have m2 := apply(g.md_st_objs, {w}, {V}, {O1}, {int_add(l[1], 0)}, {304}, {0}, {P}, {0}, {8}, {false}, m1)
    have mdW3: g.mem_defined(W3, P, 0, 8, false) := apply(ms.md_st, {W1}, {V}, {x86_64_linux.store_le(V.bytes, int_add(l[1], 0), 304, 0)}, {int_add(ENV, 0)}, {8}, {envp}, {P}, {0}, {8}, {false}, m2)
    have rd2: gimple.bytes_at(V, int_add(P, 0), 8) = gimple.bytes_at(w.vm, A, 8) by simp(pe8, rd, ab)
    have hea2: int_le(int_add(int_add(P, 0), 8), int_add(ENV, 0)) || int_le(int_add(int_add(ENV, 0), 8), int_add(P, 0)) by arith(hea, pe8, hi, hiN, heb)
    have rv: gimple.bytes_at(VM3, int_add(P, 0), 8) = gimple.bytes_at(w.vm, A, 8) by mem(pe8, ap2, hea2, rd2, l1o, l1r, ab, pb, pr)
    have _ _ _ svb := apply(ms.world_parts, hw)
    have vo vl := apply(g.bytes_bound, {w.vm}, {A}, {8}, svb, simp())
    have bv: bits_of_int(64, gimple.bytes_at(VM3, int_add(P, 0), 8)) = gimple.bytes_at(w.vm, A, 8) := rewrite(sym(rv), apply(mp.boi[x := gimple.bytes_at(w.vm, A, 8)], vo, simp(vl)))
    have i1: bits_add(64, i, 1) = int_add(i, 1) by defs(arith(hi, hiN, hbd, heb), bits_add, bits_of_int, pow2)
    have c1: int_lt(i, N) -> (int_lt(i, N) && y = ok(X(int_add(i, 1)), empty)) || (i = N && y = exc(X(i), pair("brk", empty))) proof
      assume hlt
      have nz := mp(all_elim(hnz, {i}), hi, hlt)
      have cnz: !(bits_of_int(64, gimple.bytes_at(VM3, int_add(P, 0), 8)) = 0) := rewrite(sym(bv), nz)
      step eT from hb with pd, g.ld64_det using conj(w3u, pb, mdW3, cnz)
      show by taut(hlt, rewrite(i1, eT))
    qed
    have c2: i = N -> (int_lt(i, N) && y = ok(X(int_add(i, 1)), empty)) || (i = N && y = exc(X(i), pair("brk", empty))) proof
      assume heq
      have z: gimple.bytes_at(w.vm, A, 8) = 0 := rewrite(sym(heq), hz0)
      have cz: bits_of_int(64, gimple.bytes_at(VM3, int_add(P, 0), 8)) = 0 := trans(bv, z)
      step eT from hb with pd, g.ld64_det using conj(w3u, pb, mdW3, cz)
      show by taut(heq, eT)
    qed
    show by taut(c1, c2, (int_lt(i, N) || i = N by arith(hiN)))
  qed
  let PI(x) := ex i. (i in omega && int_le(i, N)) && x = X(i)
  let M(x) := int_sub(N, fst(snd(snd(snd(x)))))
  have p0: PI(X(0)) by ex_intro({0}, taut((0 in omega by simp()), (int_le(0, N) by arith(hN)), refl({X(0)})))
  have pm: all x. PI(x) -> M(x) in omega proof
    fix x
    assume hp
    obtain i, hi hiN hx from hp
    show by simp(hx, (int_sub(N, i) in omega by arith(hi, hiN)))
  qed
  have nx: all x x2. PI(x) -> BODY(x, ok(x2, empty)) -> PI(x2) && int_lt(M(x2), M(x)) proof
    fix x x2
    assume hp hb
    obtain i, hi hiN hx from hp
    have t := mp(all_elim(trip, {i}, {ok(x2, empty)}), hi, hiN, rewrite(hx, hb))
    have nb: !(ok(x2, empty) = exc(X(i), pair("brk", empty))) by defs(simp(), ok, exc)
    have lt e2 := (int_lt(i, N) && ok(x2, empty) = ok(X(int_add(i, 1)), empty) by taut(t, nb))
    have xe: x2 = X(int_add(i, 1)) by simp(e2)
    have p2: PI(x2) by ex_intro({int_add(i, 1)}, taut((int_add(i, 1) in omega by arith(hi)), (int_le(int_add(i, 1), N) by arith(lt)), xe))
    have m2: int_lt(M(x2), M(x)) by simp(xe, hx, (int_lt(int_sub(N, int_add(i, 1)), int_sub(N, i)) by arith(hi)))
    show by taut(p2, m2)
  qed
  have wv := apply(g.loop[b := x y. BODY(x, y), p := x. PI(x), m := x. M(x)], p0, pm, nx, wl)
  obtain x, hpl bb nk from wv
  obtain i, hi hiN hx from hpl
  have t := mp(all_elim(trip, {i}, {r}), hi, hiN, rewrite(hx, bb))
  have ok1: !(int_lt(i, N) && r = ok(X(int_add(i, 1)), empty)) proof
    assume h
    have _ e := h
    have io: is_ok(r) by defs(ex_intro({X(int_add(i, 1))}, {empty}, e), is_ok)
    show by taut(io, nk)
  qed
  have ie re := (i = N && r = exc(X(i), pair("brk", empty)) by taut(t, ok1))
  // after the scan: i = N
  step h8 from rewrite(ie, rewrite(re, kr))
  // auxv: past envp's zero word; libc.auxv set
  let AVP := int_add(envp, int_mul(8, int_add(N, 1)))
  have n1: bits_add(64, N, 1) = int_add(N, 1) by defs(arith(hN, hbd, heb), bits_add, bits_of_int, pow2)
  have dA: bits_mul(64, bits_add(64, N, 1), 8) = int_mul(8, int_add(N, 1)) by defs(arith(n1, hN, hbd, heb), bits_mul, bits_of_int, pow2)
  have svA: gimple.sval(T64, int_mul(8, int_add(N, 1))) = int_mul(8, int_add(N, 1)) by defs(simp((int_lt(int_mul(8, int_add(N, 1)), 9223372036854775808) by arith(hN, hbd, heb))), gimple.sval)
  have peA: int_add(envp, gimple.sval(T64, bits_mul(64, bits_add(64, N, 1), 8))) = AVP by simp(dA, svA)
  have avb: AVP in bits(64) by arith(hN, hbd, heb)
  have pdA := apply(g.padd_det, {W3}, {envp}, {bits_mul(64, bits_add(64, N, 1), 8)}, w3u, heb, simp(), arith(peA, avb), defs(arith(peA, avb), pow2))
  let LB := c_src_env___libc_start_main.__libc
  have lbb: LB in bits(64) by defs(simp(), c_src_env___libc_start_main.__libc)
  have ml1 := apply(g.md_alloc, {w}, {V}, {l}, {SZ}, {LB}, {8}, {8}, {true}, hlb, hw, hvb)
  have ml2 := apply(g.md_st_objs, {w}, {V}, {O1}, {int_add(l[1], 0)}, {304}, {0}, {LB}, {8}, {8}, {true}, ml1)
  have mlW3: g.mem_defined(W3, LB, 8, 8, true) := apply(ms.md_st, {W1}, {V}, {x86_64_linux.store_le(V.bytes, int_add(l[1], 0), 304, 0)}, {int_add(ENV, 0)}, {8}, {envp}, {LB}, {8}, {8}, {true}, ml2)
  have w3v w3f w3d _ := apply(ms.world_parts, w3W)
  step h9 from h8 with pdA, g.st64_det using conj(w3u, lbb, mlW3, w3v, w3f, w3d)
  // the auxv copy: aux[j] after k pairs (sp.aux_val), the memory U as
  // after the stores but in the aux object
  obtain r2, wl2 kr2 from h9
  let BODY2(x, y) := loop_body(wl2)
  let AVQ := int_add(envp, gimple.sval(T64, bits_mul(64, bits_add(64, N, 1), 8)))
  let VM4 := fn_update(V, "bytes", x86_64_linux.store_le(x86_64_linux.store_le(x86_64_linux.store_le(V.bytes, int_add(l[1], 0), 304, 0), int_add(ENV, 0), 8, envp), int_add(LB, 8), 8, AVQ))
  let L1 := l[1]
  let INVU(k, U) := (U in x86_64_linux.Vm && fn_update(U, "bytes", VM4.bytes) = VM4) &&
    (all x. x in bits(64) -> !(int_le(L1, x) && int_lt(x, int_add(L1, 304))) -> U.bytes[x] = VM4.bytes[x]) &&
    (all j. j in omega -> int_le(j, 37) -> sp.aux_val(AX, k, j, gimple.bytes_at(U, int_add(L1, int_mul(8, j)), 8)))
  let X2(k, U) := pair(fn_update(W1, "vm", U), pair(pn, pair(AVQ, pair(int_mul(2, k), a3))))
  have axo: seq_len(AX) in omega by arith(axt)
  have trip2: all k U y. k in omega -> int_lt(k, seq_len(AX)) -> INVU(k, U) -> BODY2(X2(k, U), y) ->
      (fst(AX[k]) = 0 && y = exc(X2(k, U), pair("brk", empty))) ||
      (int_lt(int_add(k, 1), seq_len(AX)) && (ex U2. INVU(int_add(k, 1), U2) && y = ok(X2(int_add(k, 1), U2), empty))) proof
    fix k U y
    assume hk hkl hI hb
    have hU hUb hUo hUa := hI
    let WU := fn_update(W1, "vm", U)
    let AVP := int_add(envp, int_mul(8, int_add(N, 1)))
    let A0 := int_add(AVP, int_mul(16, k))
    let D0 := bits_mul(64, int_mul(2, k), 8)
    let D1 := bits_mul(64, bits_add(64, int_mul(2, k), 1), 8)
    let P0 := int_add(AVQ, gimple.sval(T64, D0))
    let P1 := int_add(AVQ, gimple.sval(T64, D1))
    have b2: bits_add(64, int_mul(2, k), 1) = int_add(int_mul(2, k), 1) by defs(arith(hk, hkl, axb, heb), bits_add, bits_of_int, pow2)
    have e0: D0 = int_mul(16, k) by defs(arith(hk, hkl, axb, heb), bits_mul, bits_of_int, pow2)
    have e1: D1 = int_add(int_mul(16, k), 8) by defs(arith(b2, hk, hkl, axb, heb), bits_mul, bits_of_int, pow2)
    have s0: gimple.sval(T64, int_mul(16, k)) = int_mul(16, k) by defs(simp((int_lt(int_mul(16, k), 9223372036854775808) by arith(hk, hkl, axb, heb))), gimple.sval)
    have s1: gimple.sval(T64, int_add(int_mul(16, k), 8)) = int_add(int_mul(16, k), 8) by defs(simp((int_lt(int_add(int_mul(16, k), 8), 9223372036854775808) by arith(hk, hkl, axb, heb))), gimple.sval)
    have p0e: P0 = A0 by simp(peA, e0, s0)
    have p1x: P1 = int_add(AVP, int_add(int_mul(16, k), 8)) by simp(peA, e1, s1)
    have p1e: P1 = int_add(A0, 8) by arith(p1x)
    have a0b: A0 in bits(64) by arith(hk, hkl, axb, heb)
    have wUW wUu := apply(mp.am_world[s := W1, V := U], w1W, w1u, hU)
    have wUv wUf wUd _ := apply(ms.world_parts, wUW)
    // (defined in W1: defined in U's world -- U as VM4 but for bytes)
    have mdU: all a n wr. g.mem_defined(W1, a, 0, n, wr) -> g.mem_defined(WU, a, 0, n, wr) proof
      fix a n wr
      assume h
      have h1 h2 h3 := h
      have e := all_elim(ms.f_usable, {V}, {VM4.bytes}, {O1}, {int_add(a, 0)}, {n}, {wr})
      have u4: gimple.usable(VM4, O1, int_add(a, 0), n, wr) by simp(e, h3)
      have uU := apply(mp.usable_bytes[v := VM4, v2 := U, objs := O1, a := int_add(a, 0), n := n, w := wr], hUb, u4)
      show by simp(h1, h2, uU)
    qed
    have ku kv0 kv1 := mp(all_elim(axk, {k}), hk, hkl)
    have u0 := apply(mp.usable_sub[vm := w.vm, objs := w.objs, a := A0, n := 16, k := 0, m := 8, w := false], simp(), simp(), simp(), ku)
    have u1 := apply(mp.usable_sub[vm := w.vm, objs := w.objs, a := A0, n := 16, k := 8, m := 8, w := false], simp(), simp(), simp(), ku)
    have a0z: int_add(A0, 0) = A0 by arith(a0b)
    have hm0: g.mem_defined(w, P0, 0, 8, false) by simp(p0e, rewrite(a0z, u0), (!(A0 = 0) by arith(hk, hen0, heb)), (int_lt(A0, pow2(64)) by defs(arith(a0b), pow2)))
    have hm1: g.mem_defined(w, P1, 0, 8, false) by simp(p1e, u1, (!(int_add(A0, 8) = 0) by arith(a0b)), (int_lt(int_add(A0, 8), pow2(64)) by defs(arith(hk, hkl, axb, heb), pow2)))
    have md0U := mp(all_elim(mdU, {P0}, {8}, {false}), apply(g.md_alloc, {w}, {V}, {l}, {SZ}, {P0}, {0}, {8}, {false}, hm0, hw, hvb))
    have md1U := mp(all_elim(mdU, {P1}, {8}, {false}), apply(g.md_alloc, {w}, {V}, {l}, {SZ}, {P1}, {0}, {8}, {false}, hm1, hw, hvb))
    // (the pair's words: AX[k]'s, read through U, VM4's stores, V)
    let A1 := int_add(A0, 8)
    have a0o: A0 in omega by arith(a0b)
    have apA := rewrite(sz1, apply(g.alloc_apart[vm := w.vm, objs := w.objs, sz := SZ, l := l, k := 1, a := A0, n := 16, wr := false], hfit, simp(), simp(szl), l1o, simp(sz1), ku, a0o, simp(), simp()))
    have bnd: int_le(int_add(A0, 16), 18446744073709551616) by arith(hk, hkl, axb, heb)
    have rdU: all B. B in omega -> gimple.usable(w.vm, w.objs, B, 8, false) -> int_le(A0, B) -> int_le(int_add(B, 8), int_add(A0, 16)) ->
        gimple.bytes_at(U, int_add(B, 0), 8) = gimple.bytes_at(w.vm, B, 8) proof
      fix B
      assume bo ub hB1 hB2

      have bz: int_add(B, 0) = B by arith(bo)
      have r1 := apply(g.read_outside[U := U, M := VM4, b := L1, m := 304, a := B, n := 8], hUo, arith(apA, hB1, hB2, bo, a0o), bo, simp(), arith(bnd, hB2, bo))
      have rdV := apply(g.alloc_read[vm := w.vm, objs := w.objs, sz := SZ, l := l, V := V, a := B, n := 8, wr := false], hfit, hvf, ub, bo, simp())
      have eB: int_le(int_add(int_add(B, 0), 8), int_add(ENV, 0)) || int_le(int_add(int_add(ENV, 0), 8), int_add(B, 0)) by arith(axe1, hB1, hB2, bo, hk, hkl, a0o)
      have lB: int_le(int_add(int_add(B, 0), 8), int_add(LB, 8)) || int_le(int_add(int_add(LB, 8), 8), int_add(B, 0)) by arith(axe2, hB1, hB2, bo, hk, hkl, a0o)
      have oB: int_le(int_add(int_add(B, 0), 8), int_add(l[1], 0)) || int_le(int_add(int_add(l[1], 0), 304), int_add(B, 0)) by arith(apA, hB1, hB2, bo, a0o, l1o)
      have rB: int_le(int_add(int_add(B, 0), 8), 18446744073709551616) by arith(bnd, hB2, bo)
      have bb: int_add(B, 0) in bits(64) by arith(bnd, hB2, bo, a0o)
      have rdV0: gimple.bytes_at(V, int_add(B, 0), 8) = gimple.bytes_at(w.vm, B, 8) := rewrite(sym(bz), rdV, {1})
      have r2: gimple.bytes_at(VM4, int_add(B, 0), 8) = gimple.bytes_at(w.vm, B, 8) by mem(eB, lB, oB, rB, bb, rdV0, l1o, l1r)
      show := trans(rewrite(sym(bz), r1, {1}), rewrite(bz, r2))
    qed
    have rk := mp(all_elim(rdU, {A0}), a0o, rewrite(a0z, u0), arith(a0o), arith(a0o))
    have rv := mp(all_elim(rdU, {A1}), arith(a0o), u1, arith(a0o), arith(a0o))
    let KVt := bits_of_int(64, gimple.bytes_at(U, int_add(P0, 0), 8))
    let VVt := bits_of_int(64, gimple.bytes_at(U, int_add(P1, 0), 8))
    have _ _ _ svb := apply(ms.world_parts, hw)
    have ko kl := apply(g.bytes_bound, {w.vm}, {A0}, {8}, svb, simp())
    have vo vl := apply(g.bytes_bound, {w.vm}, {A1}, {8}, svb, simp())
    have kk: gimple.bytes_at(U, int_add(P0, 0), 8) = fst(AX[k]) := trans(rewrite(sym(p0e), rk, {1}), kv0)
    have vk: gimple.bytes_at(U, int_add(P1, 0), 8) = snd(AX[k]) := trans(rewrite(sym(p1e), rv, {1}), kv1)
    have kb: KVt = fst(AX[k]) := rewrite(kk, apply(mp.boi[x := gimple.bytes_at(U, int_add(P0, 0), 8)], arith(kk, kv0, ko), arith(kk, kv0, kl)))
    have vb: VVt = snd(AX[k]) := rewrite(vk, apply(mp.boi[x := gimple.bytes_at(U, int_add(P1, 0), 8)], arith(vk, kv1, vo), arith(vk, kv1, vl)))
    have p0b: P0 in bits(64) by simp(p0e, a0b)
    have p1b: P1 in bits(64) by simp(p1e, (int_add(A0, 8) in bits(64) by arith(bnd, a0o)))
    have pd0 := apply(g.padd_det, {WU}, {AVQ}, {D0}, wUu, simp(peA, avb), simp(), arith(p0e, a0o), defs(arith(p0e, a0b), pow2))
    have pd1 := apply(g.padd_det, {WU}, {AVQ}, {D1}, wUu, simp(peA, avb), simp(), arith(p1e, a0o), defs(arith(p1e, bnd, a0o), pow2))
    let GOAL := (fst(AX[k]) = 0 && y = exc(X2(k, U), pair("brk", empty))) ||
      (int_lt(int_add(k, 1), seq_len(AX)) && (ex U2. INVU(int_add(k, 1), U2) && y = ok(X2(int_add(k, 1), U2), empty)))
    have i2: bits_add(64, int_mul(2, k), 2) = int_mul(2, int_add(k, 1)) by defs(arith(hk, hkl, axb, heb), bits_add, bits_of_int, pow2)
    // (not AT_NULL: not the last pair)
    have nl: !(fst(AX[k]) = 0) -> int_lt(int_add(k, 1), seq_len(AX)) proof
      assume hn
      have c: int_add(k, 1) = seq_len(AX) -> false proof
        assume e
        have ek: k = int_sub(seq_len(AX), 1) by arith(e, hk, axo)
        show by taut(hn, rewrite(sym(ek), axe))
      qed
      show by arith(c, hkl, hk, axo)
    qed
    have c0: fst(AX[k]) = 0 -> GOAL proof
      assume h0
      have cz: KVt = 0 := trans(kb, h0)
      step eT from hb with pd0, g.ld64_det using conj(wUu, p0b, md0U, cz)
      show by taut(h0, eT)
    qed
    have c1: !(fst(AX[k]) = 0) -> !int_le(fst(AX[k]), 37) -> GOAL proof
      assume h0 h1
      have cnz: !(KVt = 0) := rewrite(sym(kb), h0)
      have cgt: !int_le(KVt, 37) := rewrite(sym(kb), h1)
      step eT from hb with pd0, g.ld64_det using conj(wUu, p0b, md0U, cnz, cgt)
      have miss: all j. j in omega -> int_le(j, 37) -> sp.aux_val(AX, int_add(k, 1), j, gimple.bytes_at(U, int_add(L1, int_mul(8, j)), 8)) proof
        fix j
        assume hj hj37
        show := apply(sp.aux_miss, {AX}, {k}, {j}, {gimple.bytes_at(U, int_add(L1, int_mul(8, j)), 8)}, hk, (!(fst(AX[k]) = j) by arith(h1, hj37, hj, kv0, ko)), mp(all_elim(hUa, {j}), hj, hj37))
      qed
      have iv: INVU(int_add(k, 1), U) by taut(hU, hUb, hUo, miss)
      have ey: y = ok(X2(int_add(k, 1), U), empty) by simp(rewrite(i2, eT))
      have ex: ex U2. INVU(int_add(k, 1), U2) && y = ok(X2(int_add(k, 1), U2), empty) by ex_intro({U}, taut(iv, ey))
      show by taut(nl, h0, ex)
    qed
    have c2: !(fst(AX[k]) = 0) -> int_le(fst(AX[k]), 37) -> GOAL proof
      assume h0 h1
      have cnz: !(KVt = 0) := rewrite(sym(kb), h0)
      have cle: int_le(KVt, 37) := rewrite(sym(kb), h1)
      have kfo: fst(AX[k]) in omega by arith(kv0, ko)
      have kvo: KVt in omega by arith(kb, kfo)
      have k31: int_lt(KVt, 2147483648) by arith(kb, h1)
      have kel: int_lt(int_add(L1, int_mul(8, KVt)), 18446744073709551616) by arith(kb, h1, kfo, rewrite(sz1, l1le), l1o)
      have eb: int_add(L1, int_mul(8, KVt)) in bits(64) by arith(kel, kb, kfo, l1o)
      // (the aux word at the key: in the aux object, defined)
      have uo := rewrite(sz1, us)
      have us8 := apply(mp.usable_sub[vm := V, objs := O1, a := L1, n := 304, k := int_mul(8, KVt), m := 8, w := true], arith(kvo), simp(), arith(kb, h1, kfo), uo)
      have mdE1: g.mem_defined(W1, int_add(L1, int_mul(8, KVt)), 0, 8, true) by simp(us8, (!(int_add(L1, int_mul(8, KVt)) = 0) by arith(l1nz, l1o, kvo)), kel)
      have mdE := mp(all_elim(mdU, {int_add(L1, int_mul(8, KVt))}, {8}, {true}), mdE1)
      step eT from hb with pd0, pd1, g.ld64_det, g.elem8_det, g.st64_det using conj(wUu, p0b, p1b, md0U, md1U, cnz, cle, l1b, kvo, k31, kel, eb, mdE, wUv, wUf, wUd)
      // the new memory U2: the key's word stored
      let ADR := int_add(int_add(L1, int_mul(8, KVt)), 0)
      let U2 := fn_update(U, "bytes", x86_64_linux.store_le(U.bytes, ADR, 8, VVt))
      have adb: ADR in bits(64) by arith(eb, kvo, l1o)
      have adr: int_le(int_add(ADR, 8), 18446744073709551616) by arith(kvo, l1o, kb, h1, kfo, rewrite(sz1, l1le))
      have su := apply(g.store_univ, {U}, {ADR}, {8}, {VVt}, hU)
      have vu2: U2 in univ(1) by simp(apply(x86.vm_univ, hU), su)
      have v2V := apply(x86.store_vm, {U}, {ADR}, {8}, {VVt}, hU, vu2)
      have b2: fn_update(U2, "bytes", VM4.bytes) = VM4 := trans(fn_update_twice[f := U, k := "bytes", a := x86_64_linux.store_le(U.bytes, ADR, 8, VVt), b := VM4.bytes], hUb)
      have out2: all x. x in bits(64) -> !(int_le(L1, x) && int_lt(x, int_add(L1, 304))) -> U2.bytes[x] = VM4.bytes[x] proof
        fix x
        assume hx hno
        have ne: all i. i in omega -> int_lt(i, 8) -> !(bits_add(64, ADR, bits_of_int(64, i)) = x) proof
          fix i
          assume hi hil
          have ea := apply(ms.add_i, {ADR}, {i}, arith(kvo, l1o), hi, arith(hi, hil, kvo, l1o, kb, h1, kfo, rewrite(sz1, l1le)))
          have inr: int_le(L1, int_add(ADR, i)) && int_lt(int_add(ADR, i), int_add(L1, 304)) by arith(hi, hil, kb, h1, kfo, kvo, l1o)
          have c: bits_add(64, ADR, bits_of_int(64, i)) = x -> false proof
            assume e
            show by taut(hno, rewrite(trans(sym(ea), e), inr))
          qed
          show by taut(c)
        qed
        have so := apply(x86.store_outside, {U.bytes}, {ADR}, {8}, {VVt}, {x}, hx, ne)
        have u2e: U2.bytes[x] = U.bytes[x] by simp(so)
        show := trans(u2e, mp(all_elim(hUo, {x}), hx, hno))
      qed
      have aux2: all j. j in omega -> int_le(j, 37) -> sp.aux_val(AX, int_add(k, 1), j, gimple.bytes_at(U2, int_add(L1, int_mul(8, j)), 8)) proof
        fix j
        assume hj hj37
        have rj: int_le(int_add(int_add(L1, int_mul(8, j)), 8), 18446744073709551616) by arith(hj, hj37, rewrite(sz1, l1le), l1o)
        have hit: fst(AX[k]) = j -> sp.aux_val(AX, int_add(k, 1), j, gimple.bytes_at(U2, int_add(L1, int_mul(8, j)), 8)) proof
          assume e
          have r: gimple.bytes_at(U2, int_add(L1, int_mul(8, j)), 8) = snd(AX[k]) by mem(e, kb, vb, kvo, kfo, hj, rj, kel, l1o, adb, adr)
          show := rewrite(sym(r), apply(sp.aux_hit, {AX}, {k}, {j}, hk, e))
        qed
        have miss: !(fst(AX[k]) = j) -> sp.aux_val(AX, int_add(k, 1), j, gimple.bytes_at(U2, int_add(L1, int_mul(8, j)), 8)) proof
          assume ne
          have r: gimple.bytes_at(U2, int_add(L1, int_mul(8, j)), 8) = gimple.bytes_at(U, int_add(L1, int_mul(8, j)), 8) by mem(ne, kb, kvo, kfo, hj, rj, kel, l1o, adb, adr)
          show := rewrite(sym(r), apply(sp.aux_miss, {AX}, {k}, {j}, {gimple.bytes_at(U, int_add(L1, int_mul(8, j)), 8)}, hk, ne, mp(all_elim(hUa, {j}), hj, hj37)))
        qed
        show by taut(hit, miss)
      qed
      have iv: INVU(int_add(k, 1), U2) by taut(v2V, b2, out2, aux2)
      have ey: y = ok(X2(int_add(k, 1), U2), empty) by simp(rewrite(i2, eT))
      have ex: ex U3. INVU(int_add(k, 1), U3) && y = ok(X2(int_add(k, 1), U3), empty) by ex_intro({U2}, taut(iv, ey))
      show by taut(nl, h0, ex)
    qed
    show by taut(c0, c1, c2)
  qed
  // the loop: from the zeroed aux object, to AT_NULL's pair
  let B3 := x86_64_linux.store_le(x86_64_linux.store_le(V.bytes, int_add(l[1], 0), 304, 0), int_add(ENV, 0), 8, envp)
  have w4W w4u := apply(ms.sw_st, {W1}, {V}, {B3}, {int_add(LB, 8)}, {8}, {AVQ}, w3W, w3u, arith(lbb))
  have w4v _ _ _ := apply(ms.world_parts, w4W)
  have v4V: VM4 in x86_64_linux.Vm by simp(w4v)
  have vf4: is_fun(VM4) && "bytes" in dom(VM4) by simp(v4V)
  have b4: fn_update(VM4, "bytes", VM4.bytes) = VM4 := mp(fn_update_same[f := VM4, k := "bytes"], taut(vf4), taut(vf4))
  have o4: all x. x in bits(64) -> !(int_le(L1, x) && int_lt(x, int_add(L1, 304))) -> VM4.bytes[x] = VM4.bytes[x] proof
    fix x
    assume _ _
    show := refl({VM4.bytes[x]})
  qed
  have _ _ evu := hev
  have _ _ lbu := hlb
  have apE := rewrite(sz1, apply(g.alloc_apart[vm := w.vm, objs := w.objs, sz := SZ, l := l, k := 1, a := int_add(ENV, 0), n := 8, wr := true], hfit, simp(), simp(szl), l1o, simp(sz1), evu, arith(envb), simp(), simp()))
  have apL := rewrite(sz1, apply(g.alloc_apart[vm := w.vm, objs := w.objs, sz := SZ, l := l, k := 1, a := int_add(LB, 8), n := 8, wr := true], hfit, simp(), simp(szl), l1o, simp(sz1), lbu, arith(lbb), simp(), simp()))
  have a4: all j. j in omega -> int_le(j, 37) -> sp.aux_val(AX, 0, j, gimple.bytes_at(VM4, int_add(L1, int_mul(8, j)), 8)) proof
    fix j
    assume hj hj37
    have z: gimple.bytes_at(VM4, int_add(L1, int_mul(8, j)), 8) = 0 by mem(apE, apL, hj, hj37, l1o, l1r, envb, lbb)
    show := rewrite(sym(z), all_elim(sp.aux_val0, {AX}, {j}))
  qed
  have i0: INVU(0, VM4) by taut(v4V, b4, o4, a4)
  let PI2(x) := ex k U. (k in omega && int_lt(k, seq_len(AX))) && INVU(k, U) && x = X2(k, U)
  let M2(x) := int_sub(int_mul(2, seq_len(AX)), fst(snd(snd(snd(x)))))
  have q0: PI2(pair(fn_update(W1, "vm", VM4), pair(pn, pair(AVQ, pair(0, a3))))) by ex_intro({0}, {VM4},
    taut((0 in omega by simp()), (int_lt(0, seq_len(AX)) by arith(ax1)), i0, (pair(fn_update(W1, "vm", VM4), pair(pn, pair(AVQ, pair(0, a3)))) = X2(0, VM4) by simp())))
  have qm: all x. PI2(x) -> M2(x) in omega proof
    fix x
    assume hp
    obtain k U, hk hkl _ hx from hp
    show by simp(hx, (int_sub(int_mul(2, seq_len(AX)), int_mul(2, k)) in omega by arith(hk, hkl)))
  qed
  have qx: all x x2. PI2(x) -> BODY2(x, ok(x2, empty)) -> PI2(x2) && int_lt(M2(x2), M2(x)) proof
    fix x x2
    assume hp hb
    obtain k U, hk hkl hI hx from hp
    have t := mp(all_elim(trip2, {k}, {U}, {ok(x2, empty)}), hk, hkl, hI, rewrite(hx, hb))
    have nb: !(ok(x2, empty) = exc(X2(k, U), pair("brk", empty))) by defs(simp(), ok, exc)
    have lt ee2 := (int_lt(int_add(k, 1), seq_len(AX)) && (ex U2. INVU(int_add(k, 1), U2) && ok(x2, empty) = ok(X2(int_add(k, 1), U2), empty)) by taut(t, nb))
    obtain U2, i1 i2 i3 i4 he2 from ee2
    have hI2: INVU(int_add(k, 1), U2) by taut(i1, i2, i3, i4)
    have xe: x2 = X2(int_add(k, 1), U2) by simp(he2)
    have p2: PI2(x2) by ex_intro({int_add(k, 1)}, {U2}, taut((int_add(k, 1) in omega by arith(hk)), lt, hI2, xe))
    have m2: int_lt(M2(x2), M2(x)) by simp(xe, hx, (int_lt(int_sub(int_mul(2, seq_len(AX)), int_mul(2, int_add(k, 1))), int_sub(int_mul(2, seq_len(AX)), int_mul(2, k))) by arith(hk)))
    show by taut(p2, m2)
  qed
  have wv2 := apply(g.loop[b := x y. BODY2(x, y), p := x. PI2(x), m := x. M2(x)], q0, qm, qx, wl2)
  obtain x2, hpl2 bb2 nk2 from wv2
  obtain kE UE, hkE hkEl hIE hxE from hpl2
  have tE := mp(all_elim(trip2, {kE}, {UE}, {r2}), hkE, hkEl, hIE, rewrite(hxE, bb2))
  have okE: !(int_lt(int_add(kE, 1), seq_len(AX)) && (ex U2. INVU(int_add(kE, 1), U2) && r2 = ok(X2(int_add(kE, 1), U2), empty))) proof
    assume h
    have _ e := h
    obtain U2, _ _ _ _ he from e
    have io: is_ok(r2) by defs(ex_intro({X2(int_add(kE, 1), U2)}, {empty}, he), is_ok)
    show by taut(io, nk2)
  qed
  have kz re2 := (fst(AX[kE]) = 0 && r2 = exc(X2(kE, UE), pair("brk", empty)) by taut(tE, okE))
  // (AT_NULL's pair the last: every aux[j] the vector's value for key j, or 0)
  have kl: int_add(kE, 1) = seq_len(AX) proof
    have c: int_lt(int_add(kE, 1), seq_len(AX)) -> false proof
      assume lt
      show by taut(kz, mp(all_elim(axn, {kE}), hkE, lt))
    qed
    show by arith(c, hkEl, hkE)
  qed
  step h10 from rewrite(re2, kr2)
  // after the copy: the memory UE, aux[j] the vector's value for key j
  have hUE hUEb hUEo hUEa := hIE
  let WE := fn_update(W1, "vm", UE)
  have ms4 := apply(ms.md_st, {W1}, {V}, {B3}, {int_add(LB, 8)}, {8}, {AVQ}, {LB}, {8}, {8}, {true}, mlW3)
  have mdE: all a off n wr. g.mem_defined(w, a, off, n, wr) -> g.mem_defined(WE, a, off, n, wr) proof
    fix a off n wr
    assume h
    have m1 := apply(g.md_alloc, {w}, {V}, {l}, {SZ}, {a}, {off}, {n}, {wr}, h, hw, hvb)
    have m2 := apply(g.md_st_objs, {w}, {V}, {O1}, {int_add(l[1], 0)}, {304}, {0}, {a}, {off}, {n}, {wr}, m1)
    have m3 := apply(ms.md_st, {W1}, {V}, {x86_64_linux.store_le(V.bytes, int_add(l[1], 0), 304, 0)}, {int_add(ENV, 0)}, {8}, {envp}, {a}, {off}, {n}, {wr}, m2)
    have m4 := apply(ms.md_st, {W1}, {V}, {B3}, {int_add(LB, 8)}, {8}, {AVQ}, {a}, {off}, {n}, {wr}, m3)
    show := apply(g.md_bytes, {W1}, {VM4}, {UE}, {a}, {off}, {n}, {wr}, hUEb, m4)
  qed
  // (the aux object: defined in WE, read and written)
  have usr := rewrite(sz1, apply(g.alloc_usable[vm := w.vm, objs := w.objs, sz := SZ, V := V, l := l, k := 1, wr := false], hfit, simp(l1b), pe, simp(), simp()))
  have mdA: all off. off in omega -> int_le(int_add(off, 8), 304) -> g.mem_defined(WE, L1, off, 8, false) proof
    fix off
    assume ho ho8
    have u8 := apply(mp.usable_sub[vm := V, objs := O1, a := L1, n := 304, k := off, m := 8, w := false], ho, simp(), ho8, usr)
    have m1: g.mem_defined(W1, L1, off, 8, false) by simp(u8, l1nz, (int_lt(int_add(L1, off), pow2(64)) by defs(arith(ho, ho8, rewrite(sz1, l1le), l1o), pow2)))
    have m2 := apply(g.md_st_objs, {w}, {V}, {O1}, {int_add(l[1], 0)}, {304}, {0}, {L1}, {off}, {8}, {false}, m1)
    have m3 := apply(ms.md_st, {W1}, {V}, {x86_64_linux.store_le(V.bytes, int_add(l[1], 0), 304, 0)}, {int_add(ENV, 0)}, {8}, {envp}, {L1}, {off}, {8}, {false}, m2)
    have m4 := apply(ms.md_st, {W1}, {V}, {B3}, {int_add(LB, 8)}, {8}, {AVQ}, {L1}, {off}, {8}, {false}, m3)
    show := apply(g.md_bytes, {W1}, {VM4}, {UE}, {L1}, {off}, {8}, {false}, hUEb, m4)
  qed
  have wEW wEu := apply(mp.am_world[s := W1, V := UE], w1W, w1u, hUE)
  have wEv wEf wEd _ := apply(ms.world_parts, wEW)
  have hwb: c_src_env___libc_start_main.__hwcap in bits(64) by defs(simp(), c_src_env___libc_start_main.__hwcap)
  have mA16 := mp(all_elim(mdA, {128}), simp(), simp())
  have mhw := mp(all_elim(mdE, {c_src_env___libc_start_main.__hwcap}, {0}, {8}, {true}), hhw)
  step h11 from h10 with g.ld64_det, g.st64_det using conj(wEu, l1b, mA16, hwb, mhw, wEv, wEf, wEd)
  // __sysinfo: stored if aux[AT_SYSINFO] is set -- the rest proven once
  // (J) for either memory
  let HW := c_src_env___libc_start_main.__hwcap
  let SI := c_src_env___libc_start_main.__sysinfo
  let U5 := fn_update(UE, "bytes", x86_64_linux.store_le(UE.bytes, int_add(HW, 0), 8, bits_of_int(64, gimple.bytes_at(UE, int_add(l[1], 128), 8))))
  let W5 := fn_update(W1, "vm", U5)
  have w5W w5u := apply(ms.sw_st0, {W1}, {UE}, {int_add(HW, 0)}, {8}, {bits_of_int(64, gimple.bytes_at(UE, int_add(l[1], 128), 8))}, wEW, wEu, arith(hwb))
  have mA32 := apply(ms.md_st0, {W1}, {UE}, {int_add(HW, 0)}, {8}, {bits_of_int(64, gimple.bytes_at(UE, int_add(l[1], 128), 8))}, {L1}, {256}, {8}, {false},
    mp(all_elim(mdA, {256}), simp(), simp()))
  step h12 from h11 with g.ld64_det using conj(w5u, l1b, mA32)
  let K12(x) := rest(h12)
  obtain x12, hif hK from h12
  let ST(U) := pair(fn_update(W1, "vm", U), pair(pn, pair(AVQ, pair(int_mul(2, kE), a3))))
  let P6(U) := (U in x86_64_linux.Vm && fn_update(U, "bytes", VM4.bytes) = VM4) &&
    (all x. x in bits(64) -> !(int_le(SI, x) && int_lt(x, int_add(SI, 8))) -> U.bytes[x] = U5.bytes[x])
  have J: all U6. P6(U6) -> K12(ok(ST(U6), empty)) -> abi.ovf_out(w, o) || true proof
    fix U6
    assume hP hk6
    show by taut()
  qed
  have w5v _ _ _ := apply(ms.world_parts, w5W)
  have u5V: U5 in x86_64_linux.Vm by simp(w5v)
  have b5: fn_update(U5, "bytes", VM4.bytes) = VM4 := trans(fn_update_twice[f := UE, k := "bytes", a := x86_64_linux.store_le(UE.bytes, int_add(HW, 0), 8, bits_of_int(64, gimple.bytes_at(UE, int_add(l[1], 128), 8))), b := VM4.bytes], hUEb)
  have p5: P6(U5) proof
    have o5: all x. x in bits(64) -> !(int_le(SI, x) && int_lt(x, int_add(SI, 8))) -> U5.bytes[x] = U5.bytes[x] proof
      fix x
      assume _ _
      show := refl({U5.bytes[x]})
    qed
    show by taut(u5V, b5, o5)
  qed
  let C32 := bits_of_int(64, gimple.bytes_at(U5, int_add(l[1], 256), 8))
  have cz: C32 = 0 -> abi.ovf_out(w, o) || true proof
    assume h0
    step xe from hif using conj(h0)
    show := mp(all_elim(J, {U5}), p5, rewrite(xe, hK))
  qed
  have cn: !(C32 = 0) -> abi.ovf_out(w, o) || true proof
    assume h0
    have sib: SI in bits(64) by defs(simp(), c_src_env___libc_start_main.__sysinfo)
    have msi := apply(ms.md_st0, {W1}, {UE}, {int_add(HW, 0)}, {8}, {bits_of_int(64, gimple.bytes_at(UE, int_add(l[1], 128), 8))}, {SI}, {0}, {8}, {true},
      mp(all_elim(mdE, {SI}, {0}, {8}, {true}), hsi))
    have w5f w5d := (is_fun(W5) && "vm" in dom(W5) by simp(w5W))
    step xe from hif with g.ld64_det, g.st64_det using conj(h0, w5u, l1b, mA32, sib, msi, u5V, w5f, w5d)
    let U6 := fn_update(U5, "bytes", x86_64_linux.store_le(U5.bytes, int_add(SI, 0), 8, C32))
    have u6e: U6 = fn_update(UE, "bytes", x86_64_linux.store_le(x86_64_linux.store_le(UE.bytes, int_add(HW, 0), 8, bits_of_int(64, gimple.bytes_at(UE, int_add(l[1], 128), 8))), int_add(SI, 0), 8, C32)) by simp()
    have xe6: x12 = ok(ST(U6), empty) := rewrite(sym(u6e), xe)
    have su := apply(g.store_univ, {U5}, {int_add(SI, 0)}, {8}, {C32}, u5V)
    have vu6: U6 in univ(1) by simp(apply(x86.vm_univ, u5V), apply(x86.vm_univ, hUE), su)
    have v6V := apply(x86.store_vm, {U5}, {int_add(SI, 0)}, {8}, {C32}, u5V, vu6)
    have b6: fn_update(U6, "bytes", VM4.bytes) = VM4 := trans(fn_update_twice[f := U5, k := "bytes", a := x86_64_linux.store_le(U5.bytes, int_add(SI, 0), 8, C32), b := VM4.bytes], b5)
    have o6: all x. x in bits(64) -> !(int_le(SI, x) && int_lt(x, int_add(SI, 8))) -> U6.bytes[x] = U5.bytes[x] proof
      fix x
      assume hx hno
      have ne: all i. i in omega -> int_lt(i, 8) -> !(bits_add(64, int_add(SI, 0), bits_of_int(64, i)) = x) proof
        fix i
        assume hi hil
        have ea := apply(ms.add_i, {int_add(SI, 0)}, {i}, arith(sib), hi, arith(sib, hi, hil))
        show by arith(ea, hno, hi, hil, sib)
      qed
      have so := apply(x86.store_outside, {U5.bytes}, {int_add(SI, 0)}, {8}, {C32}, {x}, hx, ne)
      show by simp(so)
    qed
    have p6: P6(U6) by taut(v6V, b6, o6)
    show := mp(all_elim(J, {U6}), p6, rewrite(xe6, hK))
  qed
  show by taut(cz, cn)
qed
