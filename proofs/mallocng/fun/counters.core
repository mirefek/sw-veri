// (the specs diverge nowhere they do not also raise: the counters' body
// ends, or nothing; is_bouncing's returns)
theorem mp.co_div(c, w, h, t): w in abi.World -> w in univ(1) -> h in mp.G ->
  runs(mallocng_specs.counters_spec(c), union2(w, h), diverge(t)) -> runs(mallocng_specs.counters_spec(c), union2(w, h), exc(union2(w, h), empty))
proof
  assume hw hwu hh hr
  let S := union2(w, h)
  have {su = univ, sv = vm} := apply(mp.gS, hw, hwu, hh)
  have bp: all x x2. letin(S.vm, x3. any_rel(x4. x4 in x86_64_linux.Vm && mallocng_specs.ctx_only(c, x3, fn_update(S, "vm", x4).vm),
        x4. letin(fn_update(S, "vm", x4), x5. x = ok(pair(x5, empty), empty)))) -> fst(x) = 2 ->
      letin(S.vm, x3. any_rel(x4. x4 in x86_64_linux.Vm && mallocng_specs.ctx_only(c, x3, fn_update(S, "vm", x4).vm),
        x4. letin(fn_update(S, "vm", x4), x5. x2 = ok(pair(x5, empty), empty)))) proof
    fix x x2
    assume h1 h2
    have k: all y. y in x86_64_linux.Vm && mallocng_specs.ctx_only(c, S.vm, fn_update(S, "vm", y).vm) ->
        x = ok(pair(fn_update(S, "vm", y), empty), empty) -> fst(x) = 2 -> x2 = ok(pair(fn_update(S, "vm", y), empty), empty) proof
      fix y
      assume _ he hf
      have f0: fst(x) = 0 by defs(simp(he), ok, tag)
      have no: false by arith(f0, hf)
      show by taut(no)
    qed
    show by defs(apply(ct.dv_any[d := y. y in x86_64_linux.Vm && mallocng_specs.ctx_only(c, S.vm, fn_update(S, "vm", y).vm),
      k := y x. x = ok(pair(fn_update(S, "vm", y), empty), empty), x := x, x2 := x2], k, expand(h1, letin), h2), letin)
  qed
  have r2 := apply(ct.contract_div, su, sv, expand(hr, mallocng_specs.counters_spec), bp)
  show by defs(r2, mallocng_specs.counters_spec)
qed

theorem mp.co_divg0: all c. tr.div_raises_g(mp.G, mallocng_specs.counters_spec_fun0(c))
proof
  fix c
  have qd: all w h t. w in abi.World -> w in univ(1) -> h in mp.G -> runs(mallocng_specs.counters_spec(c), union2(w, h), diverge(t)) ->
      runs(mallocng_specs.counters_spec(c), union2(w, h), exc(union2(w, h), empty)) proof
    fix w h t
    assume hw hwu hh hr
    show := apply(mp.co_div[c := c, w := w, h := h, t := t], hw, hwu, hh, hr)
  qed
  show by defs(apply(ct.fun_divg_v0[G := mp.G, q := mallocng_specs.counters_spec(c)], mp.g_univ, qd), mallocng_specs.counters_spec_fun0)
qed

theorem mp.co_divg1: all c. tr.div_raises_g(mp.G, mallocng_specs.counters_spec_fun1(c))
proof
  fix c
  have qd: all regs w h t. regs in abi.ARGS -> w in abi.World -> w in univ(1) -> h in mp.G -> runs(mallocng_specs.counters_spec(c), union2(w, h), diverge(t)) ->
      runs(mallocng_specs.counters_spec(c), union2(w, h), exc(union2(w, h), empty)) proof
