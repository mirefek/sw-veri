  qed
  show by defs(apply(ct.fun_divg_v[G := mp.G, q := x0. mallocng_specs.counters_spec(c), n := 1], mp.g_univ, qd), mallocng_specs.counters_spec_fun1)
qed

theorem mp.ib_divg: all c. tr.div_raises_g(mp.G, mallocng_specs.is_bouncing_spec_fun(c))
proof
  fix c
  have qu: all regs s o. runs(mallocng_specs.is_bouncing_spec(c, bits_of_int(32, regs[0])), s, o) -> pair(s, o) in univ(1) proof
    fix regs s o
    assume hr
    show := apply(g.runs_univ, expand(hr, mallocng_specs.is_bouncing_spec))
  qed
  have qd: all regs w h t. regs in abi.ARGS -> w in abi.World -> w in univ(1) -> h in mp.G ->
      runs(mallocng_specs.is_bouncing_spec(c, bits_of_int(32, regs[0])), union2(w, h), diverge(t)) ->
      runs(mallocng_specs.is_bouncing_spec(c, bits_of_int(32, regs[0])), union2(w, h), exc(union2(w, h), empty)) proof
    fix regs w h t
    assume _ hw hwu hh hr
    let S := union2(w, h)
    have {su = univ, sv = vm} := apply(mp.gS, hw, hwu, hh)
    have bp: all x x2. any_rel(x3. x3 in bits(32), x3. x = exc(pair(S, empty), pair("ret", x3))) -> fst(x) = 2 ->
        any_rel(x3. x3 in bits(32), x3. x2 = exc(pair(S, empty), pair("ret", x3))) proof
      fix x x2
      assume h1 h2
      show by apply(ct.dv_ret, h1, h2)
    qed
    have r2 := apply(ct.contract_div, su, sv, expand(hr, mallocng_specs.is_bouncing_spec), bp)
    show by defs(r2, mallocng_specs.is_bouncing_spec)
  qed
  show by defs(apply(ct.fun_divg, mp.g_univ, qu, qd), mallocng_specs.is_bouncing_spec_fun)
qed

