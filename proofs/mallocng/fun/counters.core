// is_bouncing's code by its purpose: its answer some 32-bit word, the world
// unchanged
theorem mp.ib: all c sc. c in mallocng.Cfg -> c.ctx = c_src_malloc_mallocng_malloc.__malloc_context -> sc in bits(32) ->
  refines_ghost(c_src_malloc_mallocng_malloc.is_bouncing(sc), mallocng_specs.is_bouncing_spec(c, sc), abi.World, mp.G)
proof
  fix c sc
  assume hc hx hsc
  have rp: all s o. runs(c_src_malloc_mallocng_malloc.is_bouncing(sc), s, o) -> pair(s, o) in univ(1) proof
    fix s o
    assume hr
    show := apply(g.runs_univ, expand(hr, c_src_malloc_mallocng_malloc.is_bouncing))
  qed
  have body: all s h o. s in abi.World -> h in mp.G -> runs(c_src_malloc_mallocng_malloc.is_bouncing(sc), s, o) ->
      mallocng.holds_in(c, union2(s, h).A, union2(s, h).vm, union2(s, h).blocks) ->
      (ex v. v in x86_64_linux.Vm && o = exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty))) ||
      (ex s1 v. o = ok(s1, v) && any_rel(x3. x3 in bits(32), x3. exc(pair(union2(s1, h), empty), pair("ret", v)) = exc(pair(union2(s, h), empty), pair("ret", x3)))) proof
    fix s h o
    assume hs hh hr hpre
    have hu hd _ hat := mp(all_elim(mp.g_rec, {h}), hh)
    have sd: dom(s) = insert("vm", insert("os", insert("fs_base", insert("cpu", insert("objs", empty))))) by simp(expand(hs, abi.World))
    have hin: mallocng.holds_in(c, h.A, s.vm, h.blocks) by simp(hpre, sd, hd)
    have pre := apply(mp.bp_pre[c := c, A := h.A, vm := s.vm, b := h.blocks, objs := s.objs, sc := sc, w := false], hc, (h.A in univ(1) by simp(hu)), hat, hx, hsc, hin)
    have oe := mp(all_elim(ms.ib_run, {sc}, {s}, {o}), hsc, hs, pre, hr)
    let R := ite(mallocng_specs.bouncing_class(sc) && int_lt(99, gimple.bytes_at(s.vm, mallocng_specs.bounce_at(c_src_malloc_mallocng_malloc.__malloc_context, sc), 1)), 1, 0)
    have rb: R in bits(32) by simp()
    have a3: ex x3. x3 in bits(32) && exc(pair(union2(s, h), empty), pair("ret", R)) = exc(pair(union2(s, h), empty), pair("ret", x3))
      by ex_intro({R}, taut(rb, refl({exc(pair(union2(s, h), empty), pair("ret", R))})))
    have ar: any_rel(x3. x3 in bits(32), x3. exc(pair(union2(s, h), empty), pair("ret", R)) = exc(pair(union2(s, h), empty), pair("ret", x3))) by defs(taut(a3), any_rel)
    have fin: ex s1 v. o = ok(s1, v) && any_rel(x3. x3 in bits(32), x3. exc(pair(union2(s1, h), empty), pair("ret", v)) = exc(pair(union2(s, h), empty), pair("ret", x3)))
      by ex_intro({s}, {R}, taut(oe, ar))
    show by taut(fin)
  qed
  show by defs(apply(ct.refines_contract, mp.g_world, rp, body), mallocng_specs.is_bouncing_spec)
qed

