    have bo28 bl28 := mp(all_elim(g.bytes_bound, {V2a}, {int_add(G, 28)}, {4}), vb2, simp())
    have p4: int_pow(256, 4) = 4294967296 by simp()
    have eAv: bits_of_int(32, gimple.bytes_at(V2a, int_add(G, 24), 4)) = A1.metas[G].avail by defs(arith(v24, mav1, bo24, bl24, p4), bits_of_int, pow2)
    have eFr: bits_of_int(32, gimple.bytes_at(V2a, int_add(G, 28), 4)) = A1.metas[G].freed by defs(arith(v28, mfr1, bo28, bl28, p4), bits_of_int, pow2)
    have g24b: int_lt(int_add(G, 24), pow2(64)) by defs(arith(top), pow2)
    have g28b: int_lt(int_add(G, 28), pow2(64)) by defs(arith(top), pow2)
    have md24: g.mem_defined(S2, G, 24, 4, false) by simp(gnz, g24b, mp(all_elim(um1, {int_add(G, 24)}, {4}), arith(go), simp(), arith(), arith()))
    have md28: g.mem_defined(S2, G, 28, 4, false) by simp(gnz, g28b, mp(all_elim(um1, {int_add(G, 28)}, {4}), arith(go), simp(), arith(), arith()))
    have {sin, each, clr, high, il, lt} := apply(mp.nf_masks[A := A1, M := mallocng.mview(V2a, FP1), b := B1, g := G, i := i], a1a, Go, gok1, hi, hil1, hrs1)
    have nlk lkf := apply(mp.locks_ok[c := c, A := A1, vm := V2a, b := B1, objs := s.objs], hc, a1u, a1a, b1t, v2v, hm1, sh1, hx, hlk, hlc)
    have hwl0 kw := c13
    let BODY(l, o) := loop_body(hwl0)
    let L0 := pair(S2, LOC(BS, LN))
    let MASK := bits_or(32, A.metas[G].freed, A.metas[G].avail)
    let BRK := A.metas[G].freed = 0 || ALL = bits_add(32, MASK, SELF)
    let L1 := pair(ALL, pair(A.metas[G].avail, pair(BS, pair(l4, pair(E, pair(A.metas[G].freed, pair(G, pair(i, pair(LN, pair(MASK, pair(l11, pair(l12, pair(SELF,
      pair(ST0, S))))))))))))))
    let V3f := fn_update(V0, "bytes", x86_64_linux.store_le(x86_64_linux.store_le(x86_64_linux.store_le(V0.bytes, int_add(int_sub(p, 3), 0), 1, bits_neg(8, 1)),
      int_add(int_sub(p, 2), 0), 2, 0), int_add(G, 28), 4, bits_add(32, A.metas[G].freed, SELF)))
    have bdt: all o. BODY(L0, o) -> (BRK && o = exc(pair(S2, L1), pair("brk", empty))) || (!BRK && o = exc(pair(fn_update(s, "vm", V3f), L1), pair("ret", empty))) proof
      fix o
      assume hb
      step q1 from hb with g.ld32_det, eFr, eAv using conj(w2W, w2u, gb, md28, md24)
      have s1e := mp(mp.shl1[i := i], hi, i32)
      have az: bits_and(32, bits_or(32, A1.metas[G].freed, A1.metas[G].avail), SELF) = 0 := rewrite(sym(s1e), apply(mp.and_bit0, sin, hi, i32, clr))
      have az2: bits_and(32, bits_or(32, A.metas[G].freed, A.metas[G].avail), SELF) = 0 by simp(az)
      step q2 from q1 with az2
      obtain y0, hby kby from q2
      have f1: case 1 of hby proof
        assume e
        have _ ye := e
        step oe from rewrite(ye, kby)
        have hb2 _ := e
        show by disj({1}, taut(hb2, oe))
      qed
      have f2: case 2 of hby proof
        assume e
        have nb2 ye := e
        // libc's need_locks: 0 -- the freed bit stored at once
        have nlz nlb nlu nlv := expand(nlk, mallocng_specs.need_locks_off)
        have lce: c_src_malloc_mallocng_free.__libc = c.libc by defs(simp(hlc), c_src_malloc_mallocng_free.__libc, c_src_malloc_mallocng_malloc.__libc)
        have lco: c.libc in omega by simp(hc)
        have lcb: c.libc in bits(64) by arith(lco, nlb)
        have l3e: bits_add(64, c.libc, 3) = int_add(c.libc, 3) by defs(arith(lco, nlb), bits_add, pow2)
        have mdl: g.mem_defined(S2, c_src_malloc_mallocng_free.__libc, 3, 1, false) by simp(lce, nlz, (int_lt(int_add(c.libc, 3), pow2(64)) by defs(arith(nlb), pow2)), nlu)
        have ez: bits_of_int(8, gimple.bytes_at(V2a, int_add(c_src_malloc_mallocng_free.__libc, 3), 1)) = 0 by simp(lce, rewrite(l3e, nlv))
        have uw28: gimple.usable(V2a, s.objs, int_add(G, 28), 4, true) proof
          have bj: all j. j in omega -> int_lt(j, 4) -> int_add(int_add(G, 28), j) in FP1 && mallocng.m_mapped(mallocng.mview(V2a, FP1), int_add(int_add(G, 28), j)) &&
              snd(mallocng.pg(mallocng.mview(V2a, FP1), int_add(int_add(G, 28), j))).prot.w && !(snd(mallocng.pg(mallocng.mview(V2a, FP1), int_add(int_add(G, 28), j))).kind = 2) proof
            fix j
            assume hj hjl
            have r1 r2 r3 := mp(all_elim(inr1, {int_add(int_add(G, 28), j)}), arith(go, hj), arith(go, hj), arith(go, hj, hjl))
            have m1 _ m3 := expand(r2, mallocng.m_rw)
            show by taut(r1, m1, m3, r3)
          qed
          show := apply(mp.view_usable_w[vm := V2a, fp := FP1, objs := s.objs, a := int_add(G, 28), n := 4], arith(go), bj, VS1)
        qed
        have mdw28: g.mem_defined(S2, G, 28, 4, true) by simp(gnz, g28b, uw28)
        have lfb: c_src_malloc_mallocng_free.__libc in bits(64) by simp(lce, lcb)
        step q3 from rewrite(ye, kby) with g.ld8_det, ez, ms.st32_det using conj(w2W, w2u, lfb, mdl, gb, mdw28)
        show by disj({2}, taut(nb2, q3))
      qed
      show by taut(hby, f1, f2)
    qed
    // the loop: its body never ends normally (a break or a return at once),
    // so it ends where it started -- the locals L0 its invariant
    have pm0: all l. l = L0 -> 0 in omega proof
      fix l
      assume _
      show by simp()
    qed
    have nx: all l l2. l = L0 -> BODY(l, ok(l2, empty)) -> l2 = L0 && int_lt(0, 0) proof
      fix l l2
      assume le hb
      have d := mp(all_elim(bdt, {ok(l2, empty)}), rewrite(le, hb))
      have n1: !(ok(l2, empty) = exc(pair(S2, L1), pair("brk", empty))) by defs(simp(), ok, exc)
      have n2: !(ok(l2, empty) = exc(pair(fn_update(s, "vm", V3f), L1), pair("ret", empty))) by defs(simp(), ok, exc)
      have f: false by taut(d, n1, n2)
      show by taut(f)
    qed
    have wv := apply(g.loop[b := l o. BODY(l, o), p := l. l = L0, m := l. 0], refl({L0}), pm0, nx, hwl0)
    obtain lw, hlw hbw _ from wv
    have dw := mp(all_elim(bdt, {w0}), rewrite(hlw, hbw))
    // the bit into the freed mask at once: slot i unused, the block given
    // back (g not mapped on its own: another of its slots freed)
    have fast: case 2 of dw proof
      assume e
      have nbk we := e
      step oe from rewrite(we, kw)
      have fnz: !(A.metas[G].freed = 0) by taut(nbk)
      have hno: !mallocng.own_mapping(A1.metas[G]) proof
        assume om
        have l0 := apply(mp.own_one, gok1, om)
        have mz: bits_or(32, A1.metas[G].freed, A1.metas[G].avail) = 0 proof
          have z0: 0 in bits(32) by simp()
          have bt: all j. j in omega -> int_lt(j, 32) -> (bit(bits_or(32, A1.metas[G].freed, A1.metas[G].avail), j) <-> bit(0, j)) proof
            fix j
            assume hj hjl
            have b3 := mp(bit_zero[i := j], hj)
            have c0: j = i -> !bit(bits_or(32, A1.metas[G].freed, A1.metas[G].avail), j) by simp(clr)
            have c1: !(j = i) -> !bit(bits_or(32, A1.metas[G].freed, A1.metas[G].avail), j) proof
              assume ne
              show := mp(all_elim(high, {j}), hj, (int_lt(A1.metas[G].last_idx, j) by arith(l0, il, ne, hj, hi)))
            qed
            show by taut(b3, c0, c1)
          qed
          show := mp(all_elim(bits_ext, {32}), simp(), {bits_or(32, A1.metas[G].freed, A1.metas[G].avail)}, {0}, sin, z0, bt)
        qed
        have fb32: A1.metas[G].freed in bits(32) := rewrite(eFr, (bits_of_int(32, gimple.bytes_at(V2a, int_add(G, 28), 4)) in bits(32) by simp()))
        have ab32: A1.metas[G].avail in bits(32) := rewrite(eAv, (bits_of_int(32, gimple.bytes_at(V2a, int_add(G, 24), 4)) in bits(32) by simp()))
        have fz _ := apply(mp.or_zero, fb32, ab32, mz)
        show by taut(fnz, (A.metas[G].freed = 0 by simp(fz)))
      qed
      have uo := apply(mp.unres_out[c := c, A := A1, vm := V2a, objs := s.objs, b := B1, g := G, i := i], hc, a1u, a1a, b1t, v2v, hin1, iu1, hi, ro1, hno)
      obtain A2, a2a a2u fb2 from uo
      // (the word stored: the freed mask with i's bit added)
      have s1e := mp(mp.shl1[i := i], hi, i32)
      have fb32: A1.metas[G].freed in bits(32) := rewrite(eFr, (bits_of_int(32, gimple.bytes_at(V2a, int_add(G, 28), 4)) in bits(32) by simp()))
      have bfi := mp(all_elim(each, {i}), hi, i32)
      have nfi: !bit(A1.metas[G].freed, i) by taut(bfi, clr)
      have ad := mp(mp.add_bit[S := A1.metas[G].freed, i := i], fb32, hi, i32, nfi)
      have orb := mp(bits_or_in[n := 32, x := A1.metas[G].freed, y := pow2(i)], simp())
      have adl: int_lt(int_add(A1.metas[G].freed, pow2(i)), pow2(32)) by simp(ad, orb, keep(pow2))
      have fo: A1.metas[G].freed in omega by simp(fb32)
      have po2 := mp(pow2_pos[k := i], hi)
      have vadd: bits_add(32, A.metas[G].freed, SELF) = int_add(A1.metas[G].freed, pow2(i)) by simp(s1e, (bits_add(32, A1.metas[G].freed, pow2(i)) = int_add(A1.metas[G].freed, pow2(i))
        by defs(arith(adl, fo, po2), bits_add)))
      have wv: mallocng_specs.wr32(V2a, int_add(G, 28), int_add(A1.metas[G].freed, pow2(i))) = V3f by defs(simp(vadd), mallocng_specs.wr32)
      have fb3 := rewrite(wv, fb2)
      have {cnr = nores, ctk = taken, chin = holds, cunt = unt, cfp = fp} := apply(mp.lf_comp[c := c, A := A, A2 := A2, B := B, V0 := V0, V2 := V2a, V3 := V3f, objs := s.objs,
        g := G, i := i, p := p, mb := 0, ml := 0], hc, au, hat, hbt, hhm, hnr, htk, iug, hi, hil, hsl, hp, k02, hm1, fps1, fb3)
      have v3v: V3f in x86_64_linux.Vm by simp(mp(all_elim(ms.wr_any, {V2a}, {int_add(G, 28)}, {4}, {bits_add(32, A.metas[G].freed, SELF)}), v2v))
      have post: mp.lf_post(c, A, B, p, s, V3f) by ex_intro({A2}, taut(a2a, a2u, cnr, ctk, chin, cunt, cfp))
      have ex3: ex V. (V in x86_64_linux.Vm && mp.lf_post(c, A, B, p, s, V)) && o = ok(fn_update(s, "vm", V), empty) by ex_intro({V3f}, taut(v3v, post, oe))
      show by disj({3}, taut(pnz, ex3))
    qed
    // the break: the group may be freed whole -- nontrivial_free under the
    // lock, then its mapping (if let go) unmapped, errno kept
    have slow: case 1 of dw proof
      assume e
      have hbk we := e
      have fsb: s.fs_base in bits(64) by simp(expand(hs, abi.World))
      have th2 := apply(mp.tls_kept[c := c, A := A, b := B, V0 := V0, V1 := V2a, fs := s.fs_base, e := empty], fsb, hth, htl, k02,
        (all i2. i2 in omega -> int_lt(i2, 8) -> !(int_add(s.fs_base, i2) in empty) by simp()))
      have ths2: gc.sound(S2) by simp(th2)
      have nlw: mallocng_specs.need_locks_off(S2.vm, S2.objs, c_src_malloc_mallocng_malloc.__libc) by simp(rewrite(hlc, nlk))
      step V3 r3, e8 hR3 from rewrite(we, kw) with mp.lck_q using conj(hwl, w2W, ths2, nlw)
      have v3e: V3 = V2a by simp(hR3)
      have ss3: fn_update(S2, "vm", V3) = S2 by simp(v3e)
      // nontrivial_free(g, i): the slot given back (its group maybe whole),
      // from the state with the block unframed -- the ghost part A1, B1
      let H1 := fn_update(fn_update(h, "A", A1), "blocks", B1)
      have hg1a := mp(all_elim(mp.g_upd, {h}, {A1}), hh, a1a, a1u)
      have hgH := mp(all_elim(mp.g_updb, {fn_update(h, "A", A1)}, {B1}), hg1a, b1t, apply(mp.uf_bu[b := B, p := p], hbt))
      have tl1 := apply(mp.tls_eq, er1, htl)
      have qnf: all regs o2. gc.regs_ok(regs, seq_concat(seq_one(gimple.arg(64, G)), seq_one(gimple.arg(32, i)))) -> runs(nf[regs], S2, o2) ->
          abi.ovf_out(S2, o2) ||
          (ex V rr. (V in x86_64_linux.Vm && (ex A2. (A2 in mallocng.Abs && A2 in univ(1)) &&
             mallocng_specs.freed_back(c, A1, A2, B1, V2a, V, s.objs, fst(rr), snd(rr)))) && o2 = ok(fn_update(S2, "vm", V), rr)) proof
        fix regs o2
        assume hro h2
        have q := mp(all_elim(hnf, {S2}, {H1}, {G}, {i}, {regs}, {o2}), w2W, hgH, gb, ib, (int_le(seq_len(H1.A.used), seq_len(h.A.used)) by simp()),
          (mallocng.holds_in(c, H1.A, S2.vm, S2.objs, H1.blocks) by simp(hin1, keep(mallocng.holds_in))),
          (abi.thread_ok(S2.vm, S2.fs_base) by simp(th2, keep(abi.thread_ok))),
          (mallocng_specs.tls_apart(c, H1.A, S2.fs_base) by simp(tl1, keep(mallocng_specs.tls_apart))),
          (mallocng.is_used(H1.A, G) by simp(iu1, keep(mallocng.is_used))), (mallocng.reserved_only(H1.A, G, i) by simp(ro1, keep(mallocng.reserved_only))), hro, h2)
        show by simp(q, keep(mallocng_specs.freed_back))
      qed
      step V4 rr4, e9 hR4 from rewrite(ss3, e8) with qnf using conj(w2W, w2u, ths2, gb, ib, v2v)
      have v4v ex4 := hR4
      obtain A2, a2a a2u fb4 from ex4
      have hin4 nr4 tk4 u24 fg4 lg4 um4 := expand(fb4, mallocng_specs.freed_back)
      have {hm4 = mem, hsh4 = shown} := expand(hin4, mallocng.holds_in)
      // unlock(): the lock free, the thread pointer sound (its word in no
      // reserved slot: nontrivial_free's writes elsewhere)
      have nlk4 lkf4 := apply(mp.locks_ok[c := c, A := A2, vm := V4, b := B1, objs := s.objs], hc, a2u, a2a, b1t, v4v, hm4, hsh4, hx, hlk, hlc)
      have trn := apply(mp.tls_res_in, hc, a1u, a1a, hin1, fsb, tl1)
      have ne5: all i2. i2 in omega -> int_lt(i2, 8) -> !(int_add(s.fs_base, i2) in set_select(omega, x0. mallocng.in_reserved(A1, x0))) proof
        fix i2
        assume hi2 hil2 hm
        show by taut(set_select_def[s := omega, p := x0. mallocng.in_reserved(A1, x0), z := int_add(s.fs_base, i2)], hm, mp(all_elim(trn, {i2}), hi2, hil2))
      qed
      have th4 := apply(mp.tls_unt[c := c, A := A1, b := B1, V0 := V2a, V1 := V4, objs := s.objs, fs := s.fs_base, e := set_select(omega, x0. mallocng.in_reserved(A1, x0))],
        fsb, th2, tl1, u24, ne5)
      let S4 := fn_update(s, "vm", V4)
      have w4W w4u := apply(mp.am_world, hs, su, v4v)
      have ths4: gc.sound(S4) by simp(th4)
      have plf4: mallocng_specs.lock_free(S4.vm, S4.objs, c_src_malloc_mallocng_malloc.__malloc_lock) by simp(rewrite(hlk, lkf4))
      have pth4: abi.thread_ok(S4.vm, S4.fs_base) by simp(th4)
      have s24: fn_update(S2, "vm", V4) = S4 := fn_update_twice[f := s, k := "vm", a := V2a, b := V4]
      step V5 r5, e10 hR5 from rewrite(s24, e9) with mp.ul0_q using conj(hul, w4W, ths4, plf4, pth4)
      have v5e: V5 = V4 by simp(hR5)
      have ss5: fn_update(fn_update(s, "vm", V4), "vm", V5) = S4 := trans(fn_update_twice[f := s, k := "vm", a := V4, b := V5], rewrite(v5e, refl({fn_update(s, "vm", V5)}), {2}))
      have e11 := rewrite(ss5, e10)
      have {cnr = nores, ctk = taken, chin = holds, cunt = unt, cfp = fp} := apply(mp.lf_comp[c := c, A := A, A2 := A2, B := B, V0 := V0, V2 := V2a, V3 := V4, objs := s.objs,
        g := G, i := i, p := p, mb := fst(rr4), ml := snd(rr4)], hc, au, hat, hbt, hhm, hnr, htk, iug, hi, hil, hsl, hp, k02, hm1, fps1, fb4)
      // nothing let go: the block given back
      have none: snd(rr4) = 0 -> mp.lf_out(c, A, B, p, s, o) proof
        assume mz
        step oe from e11 with mz
        have post: mp.lf_post(c, A, B, p, s, V4) by ex_intro({A2}, taut(a2a, a2u, cnr, ctk, chin, cunt, cfp))
        show by ex_intro({V4}, taut(v4v, post, oe))
      qed
      // a group's mapping let go: unmapped, errno kept
      have some: !(snd(rr4) = 0) -> abi.ovf_out(s, o) || mp.lf_out(c, A, B, p, s, o) proof
        assume mnz
        step e12 from e11 with mnz
        have efl eus _ eur := expand(heo, mallocng_specs.errno_ok)
        have hfl: int_le(int_add(s.fs_base, 56), int_pow(2, 64)) by arith(efl, fsb)
        have p56: int_le(int_add(S4.fs_base, 56), int_pow(2, 64)) by simp(hfl)
        step V6 r6, e13 k13 hR6 from e12 with mp.el_q2 using conj(hel, w4W, w4u, p56, pth4)
        have v6v v6e f6 := hR6
        have ss6: fn_update(S4, "vm", V6) = S4 := trans(fn_update_twice[f := s, k := "vm", a := V4, b := V6], rewrite((V6 = V4 by simp(v6e)), refl({fn_update(s, "vm", V6)}), {2}))
        let E := mallocng_specs.errno_at(s.fs_base)
        have fe: fst(r6) = E by simp(f6)
        have eb: E in bits(64) by defs(simp(), mallocng_specs.errno_at)
        have ee: E = int_add(s.fs_base, 52) by defs(arith(fsb, hfl), mallocng_specs.errno_at, bits_add, pow2)
        // errno's pages: as at the start (outside the allocator, in no
        // reserved slot)
        have u02 := apply(mp.kept_unt[c := c, A := A, b := B, vm := V0, V := V2a, objs := s.objs, e := empty], k02)
        have pe02 := apply(mp.err_pg[c := c, A := A, B := B, V0 := V0, V1 := V2a, objs := s.objs, fs := s.fs_base, e := empty], hea, u02,
          (all i. i in omega -> int_lt(i, 4) -> !(int_add(E, i) in empty) by simp()))
        have ef0 := apply(mp.err_fp[c := c, A := A, b := B, vm := V0, fs := s.fs_base], hea)
        have m2: all i. i in omega -> int_lt(i, 4) -> x86_64_linux.mapped(V2a, int_div(int_add(E, i), x86_64_linux.PAGE)) proof
          fix i
          assume hi hil
          have _ m := mp(all_elim(ef0, {i}), hi, hil)
          show by defs(simp(expand(m, x86_64_linux.mapped), mp(all_elim(pe02, {i}), hi, hil)), x86_64_linux.mapped)
        qed
        have rg1: mp.rng_grown(c, A1, A, V0) proof
          fix a
          assume _ r
          show by taut(rewrite(er1, r))
        qed
        have hea1 := apply(mp.err_grow[c := c, A := A, A2 := A1, vm := V0, vm2 := V2a, fs := s.fs_base], hea, rg1, m2, (E in omega by arith(eb)))
        have {H1x = inv} := expand(hm1, mallocng.holds_m)
        have ner: all i. i in omega -> int_lt(i, 4) -> !(int_add(E, i) in set_select(omega, x0. mallocng.in_reserved(A1, x0))) proof
          fix i
          assume hi hil hm
          have r: mallocng.in_reserved(A1, int_add(E, i)) by taut(set_select_def[s := omega, p := x0. mallocng.in_reserved(A1, x0), z := int_add(E, i)], hm)
          have ir := apply(mp.resv_rng[c := c, A := A1, M := mallocng.mview(V2a, mallocng.held(c, A1, B1)), b := B1, brk := V2a.brk, a := int_add(E, i)], hc, a1u, a1a, H1x,
            (int_add(E, i) in omega by arith(eb, hi)), r)
          have na _ := mp(all_elim(expand(hea1, mallocng_specs.errno_apart), {i}), hi, hil)
          show by taut(na, ir)
        qed
        have pe24 := apply(mp.err_pg[c := c, A := A1, B := B1, V0 := V2a, V1 := V4, objs := s.objs, fs := s.fs_base, e := set_select(omega, x0. mallocng.in_reserved(A1, x0))],
          hea1, u24, ner)
        have pe04: all i. i in omega -> int_lt(i, 4) -> V4.pages[int_div(int_add(E, i), x86_64_linux.PAGE)] = V0.pages[int_div(int_add(E, i), x86_64_linux.PAGE)] proof
          fix i
          assume hi hil
          show := trans(mp(all_elim(pe24, {i}), hi, hil), mp(all_elim(pe02, {i}), hi, hil))
        qed
        have ur4 := apply(mp.usable_pg[vm := V0, vm2 := V4, objs := s.objs, a := E, n := 4, w := false], pe04, eur)
        have uw4 := apply(mp.usable_pg[vm := V0, vm2 := V4, objs := s.objs, a := E, n := 4, w := true], pe04, eus)
        // int e = errno
        have enz: !(E = 0) by arith(ee, fsb)
        have elt: int_lt(int_add(E, 0), pow2(64)) by defs(arith(ee, hfl, fsb), pow2)
        have e0: int_add(E, 0) = E by arith(eb)
        have md: g.mem_defined(S4, E, 0, 4, false) by simp(enz, elt, rewrite(sym(e0), ur4))
        // munmap(mi.base, mi.len): its pages ones the kernel may unmap,
        // valid (the allocator's bytes, the C world's), neither the thread
        // pointer's nor errno's
        have u4 mm4 ty4 := mp(um4, mnz)
        obtain mbv mlv, mbb mlb emb eml from ty4
        have mb64: fst(rr4) in bits(64) := rewrite(emb, mbb)
        have ml64: snd(rr4) in bits(64) := rewrite(eml, mlb)
        have {cg = gone} := apply(mp.lf_comp[c := c, A := A, A2 := A2, B := B, V0 := V0, V2 := V2a, V3 := V4, objs := s.objs,
          g := G, i := i, p := p, mb := fst(rr4), ml := snd(rr4)], hc, au, hat, hbt, hhm, hnr, htk, iug, hi, hil, hsl, hp, k02, hm1, fps1, fb4)
        have gn := mp(cg, mnz)
        have {H0x = inv} := expand(hhm, mallocng.holds_m)
        have {hsh0 = shown} := expand(hin, mallocng.holds_in)
        have {fsh = fp} := expand(hsh0, mallocng.shown_in)
        have hlvp := mp(hlv, pnz)
        have kp4: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
        let PQ := x86_64_linux.page_of(fst(rr4))
        let NQ := x86_64_linux.pages_for(snd(rr4))
        // (a byte on those pages: in the allocator's ranges)
        have gr: all a. a in omega -> int_le(PQ, int_div(a, x86_64_linux.PAGE)) -> int_lt(int_div(a, x86_64_linux.PAGE), int_add(PQ, NQ)) ->
            mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) proof
          fix a
          assume ao h1 h2
          have w _ := mp(all_elim(gn, {a}), ao, h1, h2)
          show := apply(mp.lf_inr[c := c, A := A, M := mallocng.mview(V0, mallocng.held(c, A, B)), B := B, brk := V0.brk, p := p, a := a], hc, au, hat, hbt, H0x, hp, hlvp, ao, w)
        qed
        have uos unx := expand(u4, mallocng.unmap_ok)
        have pvd: all q. q in omega -> int_le(PQ, q) && int_lt(q, int_add(PQ, NQ)) -> x86_64_linux.mapped(V4, q) -> gimple.page_valid(V4, s.objs, q) proof
          fix q
          assume hq hr hm
          have hr1 hr2 := hr
          have cb: all j. j in omega -> int_lt(j, x86_64_linux.PAGE) -> int_add(int_mul(q, x86_64_linux.PAGE), j) in s.objs.c_bytes proof
            fix j
            assume hj hjl
            have ao: int_add(int_mul(q, x86_64_linux.PAGE), j) in omega by arith(hq, hj, kp4)
            have aq: int_div(int_add(int_mul(q, x86_64_linux.PAGE), j), x86_64_linux.PAGE) = q by arith(hj, hjl, kp4, hq)
            have ir := mp(all_elim(gr, {int_add(int_mul(q, x86_64_linux.PAGE), j)}), ao, rewrite(sym(aq), hr1), rewrite(sym(aq), hr2))
            show := mp(all_elim(expand(fsh, mallocng.fp_shown), {int_add(int_mul(q, x86_64_linux.PAGE), j)}), ao, ir)
          qed
          show by defs(taut(hm, cb), gimple.page_valid)
        qed
        have pmu0: gimple.sys_pages_ok(V4, s.objs, PQ, NQ) by defs(taut(uos, unx, pvd), gimple.sys_pages_ok)
        have pmu: gimple.sys_pages_ok(S4.vm, S4.objs, x86_64_linux.page_of(fst(rr4)), x86_64_linux.pages_for(snd(rr4))) by simp(pmu0, keep(gimple.sys_pages_ok))
        have tla := expand(htl, mallocng_specs.tls_apart)
        have t1: all j. j in omega -> int_lt(j, 8) ->
            !(int_le(PQ, int_div(int_add(s.fs_base, j), x86_64_linux.PAGE)) && int_lt(int_div(int_add(s.fs_base, j), x86_64_linux.PAGE), int_add(PQ, NQ))) proof
          fix j
          assume hj hjl w
          have w1 w2 := w
          have ir := mp(all_elim(gr, {int_add(s.fs_base, j)}), (int_add(s.fs_base, j) in omega by arith(fsb, hj)), w1, w2)
          show by taut(ir, mp(all_elim(tla, {j}), hj, hjl))
        qed
        have t2: all j. j in omega -> int_lt(j, 4) ->
            !(int_le(PQ, int_div(int_add(E, j), x86_64_linux.PAGE)) && int_lt(int_div(int_add(E, j), x86_64_linux.PAGE), int_add(PQ, NQ))) proof
          fix j
          assume hj hjl w
          have w1 w2 := w
          have ir := mp(all_elim(gr, {int_add(E, j)}), (int_add(E, j) in omega by arith(eb, hj)), w1, w2)
          have na _ := mp(all_elim(expand(hea, mallocng_specs.errno_apart), {j}), hj, hjl)
          show by taut(ir, na)
        qed
        have pto0: mallocng_specs.tls_off(s.fs_base, PQ, NQ) by defs(taut(t1, t2), mallocng_specs.tls_off)
        have pto: mallocng_specs.tls_off(S4.fs_base, x86_64_linux.page_of(fst(rr4)), x86_64_linux.pages_for(snd(rr4))) by simp(pto0, keep(mallocng_specs.tls_off))
        have eo4: mallocng_specs.errno_ok(V4, s.objs, s.fs_base) by defs(taut(efl, uw4, th4, ur4), mallocng_specs.errno_ok)
        have peo4: mallocng_specs.errno_ok(S4.vm, S4.objs, S4.fs_base) by simp(eo4, keep(mallocng_specs.errno_ok))
        step V7 r7, e15 k15 hR7 from conj(rewrite(fe, rewrite(ss6, e13)), k13) with g.ld32_det, mp.mun_q using conj(w4u, eb, md, hmu, w4W, ths4, mb64, ml64, peo4, pmu, pto)
        // (not EINVAL: whole pages, below the task's end -- the last one mapped)
        have l0 := expand(lg4, mallocng_specs.let_go)
        have q1 _ _ _ := (((int_mod(fst(rr4), 4096) = 0 && int_mod(snd(rr4), 4096) = 0) && int_lt(0, fst(rr4))) &&
          (all x0. x0 in omega -> int_le(fst(rr4), x0) && int_lt(x0, int_add(fst(rr4), snd(rr4))) -> (x0 in mallocng.footprint(c, A1, B1) || mallocng.in_reserved(A1, x0)) &&
             !(x0 in mallocng.footprint(c, A2, B1))) by taut(l0, mnz))
        have nq1: int_le(1, NQ) by defs(arith(ml64, mnz), x86_64_linux.pages_for, x86_64_linux.PAGE)
        have pqo: PQ in omega by defs(arith(mb64), x86_64_linux.page_of, x86_64_linux.PAGE)
        have lmq := mp(all_elim(mm4, {int_sub(int_add(PQ, NQ), 1)}), (int_sub(int_add(PQ, NQ), 1) in omega by arith(pqo, nq1)),
          (int_le(PQ, int_sub(int_add(PQ, NQ), 1)) && int_lt(int_sub(int_add(PQ, NQ), 1), int_add(PQ, NQ)) by arith(nq1)))
        have tlq _ := expand(lmq, x86_64_linux.mapped)
        have nin: !tr.unmap_inval(fst(rr4), snd(rr4)) by defs(arith(tlq, q1, mnz, nq1), x86_64_linux.PAGE)
        have v7v r7c := hR7
        have gp7 gb7 := (gimple.gone_pages(V4, V7, PQ, NQ) && V7.brk = V4.brk by simp(r7c, nin, keep(gimple.gone_pages)))
        // the invariant and nothing else touched: the pages the allocator's
        // before, none of its ranges after
        have {hm4b = mem, hsh4b = shown} := expand(chin, mallocng.holds_in)
        have {lgh = holds, lgu = unt} := apply(mp.lf_gone[c := c, A := A, A2 := A2, B := B, B1 := B1, V0 := V0, V4 := V4, V7 := V7, objs := s.objs,
          R := malloc.range(p, snd(B[p])), q0 := PQ, k := NQ], hc, a2u, a2a, b1t, hm4b, cunt, gp7, gb7, gn)
        // errno = e: the thread pointer still sound (its pages not unmapped)
        let S7 := fn_update(s, "vm", V7)
        have s47: fn_update(S4, "vm", V7) = S7 := fn_update_twice[f := s, k := "vm", a := V4, b := V7]
        have w7W w7u := apply(mp.am_world, hs, su, v7v)
        have gt7 gl7 gs7 gpg7 gby7 := expand(gp7, gimple.gone_pages)
        have rd4 _ _ _ := expand(th4, abi.thread_ok)
        have same7: all j. j in omega -> int_lt(j, 8) -> V7.bytes[bits_of_int(64, int_add(s.fs_base, j))] = V4.bytes[bits_of_int(64, int_add(s.fs_base, j))] &&
            V7.pages[int_div(int_add(s.fs_base, j), x86_64_linux.PAGE)] = V4.pages[int_div(int_add(s.fs_base, j), x86_64_linux.PAGE)] proof
          fix j
          assume hj hjl
          have m _ := mp(all_elim(expand(rd4, x86_64_linux.readable), {j}), hj, hjl)
          have ml _ := expand(m, x86_64_linux.mapped)
          have qo: int_div(int_add(s.fs_base, j), x86_64_linux.PAGE) in omega by arith(fsb, hj, kp4)
          show by simp(gby7, mp(all_elim(gpg7, {int_div(int_add(s.fs_base, j), x86_64_linux.PAGE)}), qo, ml), mp(all_elim(t1, {j}), hj, hjl))
        qed
        have th7 := apply(mp.th_same[V0 := V4, V1 := V7, fs := s.fs_base], fsb, th4, same7)
        have pth7: abi.thread_ok(S7.vm, S7.fs_base) by simp(th7)
        have p57: int_le(int_add(S7.fs_base, 56), int_pow(2, 64)) by simp(hfl)
        step V8 r8, e16 k16 hR8 from conj(rewrite(s47, e15), k15) with mp.el_q2 using conj(hel, w7W, w7u, p57, pth7)
        have v8v v8e f8 := hR8
        have ss8: fn_update(S7, "vm", V8) = S7 := trans(fn_update_twice[f := s, k := "vm", a := V7, b := V8], rewrite((V8 = V7 by simp(v8e)), refl({fn_update(s, "vm", V8)}), {2}))
        have fe8: fst(r8) = E by simp(f8)
        // (errno's pages: not unmapped)
        have pe47: all j. j in omega -> int_lt(j, 4) -> V7.pages[int_div(int_add(E, j), x86_64_linux.PAGE)] = V4.pages[int_div(int_add(E, j), x86_64_linux.PAGE)] proof
          fix j
          assume hj hjl
          have _ m0 := mp(all_elim(ef0, {j}), hj, hjl)
          have m4: x86_64_linux.mapped(V4, int_div(int_add(E, j), x86_64_linux.PAGE)) by defs(simp(expand(m0, x86_64_linux.mapped), mp(all_elim(pe04, {j}), hj, hjl)), x86_64_linux.mapped)
          have ml _ := expand(m4, x86_64_linux.mapped)
          have qo: int_div(int_add(E, j), x86_64_linux.PAGE) in omega by arith(eb, hj, kp4)
          show by simp(mp(all_elim(gpg7, {int_div(int_add(E, j), x86_64_linux.PAGE)}), qo, ml), mp(all_elim(t2, {j}), hj, hjl))
        qed
        have uw7 := apply(mp.usable_pg[vm := V4, vm2 := V7, objs := s.objs, a := E, n := 4, w := true], pe47, uw4)
        have md7: g.mem_defined(S7, E, 0, 4, true) by simp(enz, elt, rewrite(sym(e0), uw7))
        step oe from conj(rewrite(fe8, rewrite(ss8, e16)), k16) with ms.st32_det using conj(w7W, w7u, eb, md7)
        // (errno's bytes stored back as read: the memory V7, munmap's)
        have {b7 = bytes} := apply(ms.world_parts, w7W)
        have sb := apply(mp.st_back4[b := V7.bytes, a := E], (V7.bytes in fn_space(bits(64), bits(8)) by simp(b7)), eb)
        have ba: gimple.bytes_at(V7, E, 4) = gimple.bytes_at(V4, int_add(E, 0), 4) by defs(simp(gby7, e0), gimple.bytes_at)
        have lb: x86_64_linux.le(V7.bytes, E, 4) = bits_of_int(32, gimple.bytes_at(V4, int_add(E, 0), 4)) by simp(all_elim(tr.le_bytes, {V7}, {E}, {4}), ba)
        let ST := x86_64_linux.store_le(V7.bytes, int_add(E, 0), 4, bits_of_int(32, gimple.bytes_at(V4, int_add(E, 0), 4)))
        have sb2: ST = V7.bytes := subst({x. x86_64_linux.store_le(V7.bytes, x, 4, bits_of_int(32, gimple.bytes_at(V4, int_add(E, 0), 4))) = V7.bytes}, sym(e0), rewrite(lb, sb))
        have uf := mp(fn_update_same[f := V7, k := "bytes"], (is_fun(V7) by simp(expand(v7v, x86_64_linux.Vm))), ("bytes" in dom(V7) by simp(expand(v7v, x86_64_linux.Vm))))
        have v8f: fn_update(V7, "bytes", ST) = V7 := rewrite(sym(sb2), uf)
        have oe2: o = ok(fn_update(s, "vm", V7), empty) := rewrite(v8f, oe)
        have hin7: mallocng.holds_in(c, A2, V7, s.objs, B1) by defs(taut(lgh, hsh4b), mallocng.holds_in)
        have post: mp.lf_post(c, A, B, p, s, V7) by ex_intro({A2}, taut(a2a, a2u, cnr, ctk, hin7, lgu, cfp))
        show by disj({2}, ex_intro({V7}, taut(v7v, post, oe2)))
      qed
      have lo: abi.ovf_out(s, o) || mp.lf_out(c, A, B, p, s, o) by taut(none, some)
      have r1: case 1 of lo proof
        assume e
        show by disj({1}, e)
      qed
      have r2: case 2 of lo proof
        assume e
        show by disj({3}, taut(pnz, e))
      qed
      show by taut(lo, r1, r2)
    qed
    show by taut(dw, fast, slow)
  qed
  show by taut(tb1, z, nz)
qed

// __libc_free's code by its purpose: its run (`mp.lf_run`), the ghost
// part's blocks without p's, its A the state after
theorem mp.lf: all c p gm gsi gst gns ac acas wl nf ul el mu g0 g1 g2. c in mallocng.Cfg ->
  c.ctx = c_src_malloc_mallocng_malloc.__malloc_context -> c.sct = c_src_malloc_mallocng_malloc.__malloc_size_classes ->
  c.lock = c_src_malloc_mallocng_malloc.__malloc_lock -> c.libc = c_src_malloc_mallocng_malloc.__libc -> p in bits(64) ->
  mp.calls(gm, c_src_malloc_mallocng_malloc.get_meta_fun(g0, g1)) -> mp.calls(g1, c_src_malloc_mallocng_malloc.get_slot_index_fun()) ->
  mp.calls(gsi, c_src_malloc_mallocng_malloc.get_slot_index_fun()) -> mp.calls(gst, c_src_malloc_mallocng_malloc.get_stride_fun()) ->
  mp.calls(gns, c_src_malloc_mallocng_free.get_nominal_size_fun(g2)) -> mp.calls(wl, mallocng_specs.lock_spec_fun(c_src_malloc_mallocng_malloc.__libc)) ->
  (all n. n in omega -> mp.nf_call(c, nf, n)) -> mp.calls(ul, mallocng_specs.unlock_spec_fun(c_src_malloc_mallocng_malloc.__malloc_lock)) ->
  mp.calls(el, mallocng_specs.errno_location_spec_fun) -> mp.calls(mu, mallocng_specs.munmap_spec_fun()) ->
  refines_ghost(c_src_malloc_mallocng_free.__libc_free(p, gm, gsi, gst, gns, ac, acas, wl, nf, ul, el, mu), mallocng_specs.libc_free_spec(c, p), abi.World, mp.G)
proof
  fix c p gm gsi gst gns ac acas wl nf ul el mu g0 g1 g2
  assume hc hx hsct hlk hlc hp hgm hg1 hgsi hgst hgns hwl hnf hul hel hmu
  have rp: all s o. runs(c_src_malloc_mallocng_free.__libc_free(p, gm, gsi, gst, gns, ac, acas, wl, nf, ul, el, mu), s, o) -> pair(s, o) in univ(1) proof
    fix s o
    assume hr
    show := apply(g.runs_univ, expand(hr, c_src_malloc_mallocng_free.__libc_free))
  qed
  unfold mallocng_specs.libc_free_spec
  refine ct.refines_contract_ge with mp.g_world, rp
  fix s h o
  assume hs hh hr hpre
  let S := union2(s, h)
  let A := h.A
  let B := h.blocks
  have _ hd hbt hat := mp(all_elim(mp.g_rec, {h}), hh)
  have sd: dom(s) = insert("vm", insert("os", insert("fs_base", insert("cpu", insert("objs", empty))))) by simp(expand(hs, abi.World))
  have aS: S.A = A by simp(sd, hd)
  have vS: S.vm = s.vm by simp(sd, hd)
  have bS: S.blocks = B by simp(sd, hd)
  have oS: S.objs = s.objs by simp(sd, hd)
  have hin0: mallocng.holds_in(c, A, s.vm, s.objs, B) by simp(hpre, sd, hd)
  have hnr0: mallocng.no_reserved(A) by simp(hpre, sd, hd)
  have htk0: seq_len(A.taken) = 0 by simp(hpre, sd, hd)
  have hth0: abi.thread_ok(s.vm, s.fs_base) by simp(hpre, sd, hd)
  have htl0: mallocng_specs.tls_apart(c, A, s.fs_base) by simp(hpre, sd, hd)
  have heo0: mallocng_specs.errno_ok(s.vm, s.objs, s.fs_base) by simp(hpre, sd, hd)
  have hea0: mallocng_specs.errno_apart(c, A, s.vm, s.fs_base) by simp(hpre, sd, hd)
  have hlv0: !(p = 0) -> !(B[p] = none) by simp(hpre, sd, hd)
  have ul: A.used in list_type(omega) by simp(hat)
  have nfn := mp(all_elim(hnf, {seq_len(A.used)}), (seq_len(A.used) in omega by arith(ul)))
  have run := apply(mp.lf_run[c := c, gm := gm, gsi := gsi, gst := gst, gns := gns, ac := ac, acas := acas, wl := wl, nf := nf, ul := ul, el := el, mu := mu,
    g0 := g0, g1 := g1, g2 := g2, p := p, s := s, h := h, o := o], hc, hx, hsct, hlk, hlc, hp, hs, hh, hin0, hnr0, htk0, hth0, htl0, heo0, hea0, hlv0,
    hgm, hg1, hgsi, hgst, hgns, hwl, nfn, hul, hel, hmu, hr)
  // the null pointer: nothing done
  have k0: case 2 of run proof
    assume e
    have pz ho := e
    show by disj({3}, spec_ret({s}, {h}, {ok(pair(S, empty), empty)}, hh, ho, pz, refl({ok(pair(S, empty), empty)}), refl({S})))
  qed
  // a block: given back -- the ghost part's blocks without it, its A the
  // state after, the memory after
  have k1: case 3 of run proof
    assume e
    have pnz lo := e
    obtain V, v4 post ho from lo
    obtain A2, a2a a2u nr2 tk2 hin2 unt2 fp2 from post
    let B1 := malloc.set_block(B, p, none)
    let H2 := fn_update(fn_update(h, "blocks", B1), "A", A2)
    let s1 := fn_update(s, "vm", V)
    let SB := fn_update(fn_update(fn_update(S, "blocks", malloc.set_block(S.blocks, p, none)), "A", A2), "vm", V)
    have hgb := mp(all_elim(mp.g_updb, {h}, {B1}), hh, apply(mp.uf_btype[b := B, p := p], hbt), apply(mp.uf_bu[b := B, p := p], hbt))
    have hg2 := mp(all_elim(mp.g_upd, {fn_update(h, "blocks", B1)}, {A2}), hgb, a2a, a2u)
    // the world's part and the ghost part joined: the spec's state
    have sk := apply(abi.keys_of[f := s, d := insert("vm", insert("os", insert("fs_base", insert("cpu", insert("objs", empty)))))], sd)
    have na: all z. z in s -> fst(z) != "A" proof
      fix z
      assume hz
      show by simp(mp(all_elim(sk, {z}), hz))
    qed
    have nb: all z. z in s -> fst(z) != "blocks" proof
      fix z
      assume hz
      show by simp(mp(all_elim(sk, {z}), hz))
    qed
    have _ hk := mp(all_elim(mp.g_world, {H2}), hg2)
    have nv: all z. z in H2 -> fst(z) != "vm" proof
      fix z
      assume hz
      show by simp(mp(all_elim(hk, {z}), hz))
    qed
    have e1 := mp(fn_update_union_r[a := s, b := h, k := "blocks", v := B1], nb)
    have e2 := mp(fn_update_union_r[a := s, b := fn_update(h, "blocks", B1), k := "A", v := A2], na)
    have e3 := mp(fn_update_union_l[a := s, b := H2, k := "vm", v := V], nv)
    have eS: union2(s1, H2) = SB by simp(e1, e2, e3, bS)
    show by disj({3}, spec_ret({s1}, {H2}, {ok(pair(SB, empty), empty)}, {A2}, {V}, hg2, ho, pnz, a2a, nr2, tk2, v4, hin2, unt2, fp2, aS, vS, bS, oS, eS,
      refl({ok(pair(SB, empty), empty)})))
  qed
  show by taut(run, k0, k1)
qed

// free(p)'s outcome, the memory V after: nothing done (p null), or the
// block given back
abbrev mp.lf_res(c, A, B, p, s, V) := (p = 0 && V = s.vm) || (!(p = 0) && mp.lf_post(c, A, B, p, s, V))

// (the run, its two returns as one)
theorem mp.lf_run2(c, gm, gsi, gst, gns, ac, acas, wl, nf, ul, el, mu, g0, g1, g2, p, s, h, o): c in mallocng.Cfg ->
  c.ctx = c_src_malloc_mallocng_malloc.__malloc_context -> c.sct = c_src_malloc_mallocng_malloc.__malloc_size_classes ->
  c.lock = c_src_malloc_mallocng_malloc.__malloc_lock -> c.libc = c_src_malloc_mallocng_malloc.__libc -> p in bits(64) ->
  mp.calls(gm, c_src_malloc_mallocng_malloc.get_meta_fun(g0, g1)) -> mp.calls(g1, c_src_malloc_mallocng_malloc.get_slot_index_fun()) ->
  mp.calls(gsi, c_src_malloc_mallocng_malloc.get_slot_index_fun()) -> mp.calls(gst, c_src_malloc_mallocng_malloc.get_stride_fun()) ->
  mp.calls(gns, c_src_malloc_mallocng_free.get_nominal_size_fun(g2)) -> mp.calls(wl, mallocng_specs.lock_spec_fun(c_src_malloc_mallocng_malloc.__libc)) ->
  (all n. n in omega -> mp.nf_call(c, nf, n)) -> mp.calls(ul, mallocng_specs.unlock_spec_fun(c_src_malloc_mallocng_malloc.__malloc_lock)) ->
  mp.calls(el, mallocng_specs.errno_location_spec_fun) -> mp.calls(mu, mallocng_specs.munmap_spec_fun()) ->
  s in abi.World -> h in mp.G ->
  mallocng.holds_in(c, h.A, s.vm, s.objs, h.blocks) -> mallocng.no_reserved(h.A) -> seq_len(h.A.taken) = 0 -> abi.thread_ok(s.vm, s.fs_base) ->
  mallocng_specs.tls_apart(c, h.A, s.fs_base) -> mallocng_specs.errno_ok(s.vm, s.objs, s.fs_base) -> mallocng_specs.errno_apart(c, h.A, s.vm, s.fs_base) ->
  (!(p = 0) -> !(h.blocks[p] = none)) ->
  runs(c_src_malloc_mallocng_free.__libc_free(p, gm, gsi, gst, gns, ac, acas, wl, nf, ul, el, mu), s, o) ->
  abi.ovf_out(s, o) || (ex V. (V in x86_64_linux.Vm && mp.lf_res(c, h.A, h.blocks, p, s, V)) && o = ok(fn_update(s, "vm", V), empty))
proof
  assume hc hx hsct hlk hlc hp hgm hg1 hgsi hgst hgns hwl hnf hul hel hmu hs hh hin hnr htk hth htl heo hea hlv hr
  have _ _ _ hat := mp(all_elim(mp.g_rec, {h}), hh)
  have ul: h.A.used in list_type(omega) by simp(hat)
  have nfn := mp(all_elim(hnf, {seq_len(h.A.used)}), (seq_len(h.A.used) in omega by arith(ul)))
  have run := apply(mp.lf_run[c := c, gm := gm, gsi := gsi, gst := gst, gns := gns, ac := ac, acas := acas, wl := wl, nf := nf, ul := ul, el := el, mu := mu,
    g0 := g0, g1 := g1, g2 := g2, p := p, s := s, h := h, o := o], hc, hx, hsct, hlk, hlc, hp, hs, hh, hin, hnr, htk, hth, htl, heo, hea, hlv,
    hgm, hg1, hgsi, hgst, hgns, hwl, nfn, hul, hel, hmu, hr)
  have {wv = mem, wf = record, wd = has_vm} := apply(ms.world_parts, hs)
  have k0: case 2 of run proof
    assume e
    have pz ho := e
    have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], wf, wd)
    have ho2: o = ok(fn_update(s, "vm", s.vm), empty) := rewrite(sym(ss), ho, {1})
    show by disj({2}, ex_intro({s.vm}, taut(wv, pz, refl({s.vm}), ho2)))
  qed
  have k1: case 3 of run proof
    assume e
    have pnz lo := e
    obtain V, v4 post ho from lo
    show by disj({2}, ex_intro({V}, taut(v4, pnz, post, ho)))
  qed
  show by taut(run, k0, k1)
qed

// what a caller relies on of a callee f called as __libc_free: an
// overflow, or the return -- nothing done (p null), or p's block given back
abbrev mp.lf_call(c, f) := all p t h regs o2. p in bits(64) -> t in abi.World -> h in mp.G ->
  mallocng.holds_in(c, h.A, t.vm, t.objs, h.blocks) -> mallocng.no_reserved(h.A) -> seq_len(h.A.taken) = 0 -> abi.thread_ok(t.vm, t.fs_base) ->
  mallocng_specs.tls_apart(c, h.A, t.fs_base) -> mallocng_specs.errno_ok(t.vm, t.objs, t.fs_base) -> mallocng_specs.errno_apart(c, h.A, t.vm, t.fs_base) ->
  (!(p = 0) -> !(h.blocks[p] = none)) ->
  gc.regs_ok(regs, seq_one(gimple.arg(64, p))) -> runs(f[regs], t, o2) ->
  abi.ovf_out(t, o2) || (ex V r. (V in x86_64_linux.Vm && mp.lf_res(c, h.A, h.blocks, p, t, V)) && o2 = ok(fn_update(t, "vm", V), r))

// __libc_free's code called as __libc_free
theorem mp.lf_q: all c gm gsi gst gns ac acas wl nf ul el mu g0 g1 g2. c in mallocng.Cfg ->
  c.ctx = c_src_malloc_mallocng_malloc.__malloc_context -> c.sct = c_src_malloc_mallocng_malloc.__malloc_size_classes ->
  c.lock = c_src_malloc_mallocng_malloc.__malloc_lock -> c.libc = c_src_malloc_mallocng_malloc.__libc ->
  mp.calls(gm, c_src_malloc_mallocng_malloc.get_meta_fun(g0, g1)) -> mp.calls(g1, c_src_malloc_mallocng_malloc.get_slot_index_fun()) ->
  mp.calls(gsi, c_src_malloc_mallocng_malloc.get_slot_index_fun()) -> mp.calls(gst, c_src_malloc_mallocng_malloc.get_stride_fun()) ->
  mp.calls(gns, c_src_malloc_mallocng_free.get_nominal_size_fun(g2)) -> mp.calls(wl, mallocng_specs.lock_spec_fun(c_src_malloc_mallocng_malloc.__libc)) ->
  (all n. n in omega -> mp.nf_call(c, nf, n)) -> mp.calls(ul, mallocng_specs.unlock_spec_fun(c_src_malloc_mallocng_malloc.__malloc_lock)) ->
  mp.calls(el, mallocng_specs.errno_location_spec_fun) -> mp.calls(mu, mallocng_specs.munmap_spec_fun()) ->
  mp.lf_call(c, c_src_malloc_mallocng_free.__libc_free_fun(gm, gsi, gst, gns, ac, acas, wl, nf, ul, el, mu))
proof
  fix c gm gsi gst gns ac acas wl nf ul el mu g0 g1 g2
  assume hc hx hsct hlk hlc hgm hg1 hgsi hgst hgns hwl hnf hul hel hmu
  fix p t h regs o2
  assume hpb hw hh hin hnr htk hth htl heo hea hlv hro hr
  have rl rn r0 := apply(gc.regs1, hpb, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  have o1l: ord_le(1, seq_len(regs)) by defs(simp(rn), ord_le)
  have bp: bits_of_int(64, regs[0]) = p by defs(simp(r0, hpb), bits_of_int, pow2)
  step o3 V, e hs1 from hr with o1l, bp, mp.lf_run2 using ra, hc, hx, hsct, hlk, hlc, hpb, hgm, hg1, hgsi, hgst, hgns, hwl, hnf, hul, hel, hmu,
    hw, hh, hin, hnr, htk, hth, htl, heo, hea, hlv
  // (the result: any two words)
  have ne: ex x0. x0 in bits(64) by ex_intro({0}, simp())
  have e1: ex x0. x0 in bits(64) && any_rel(x1. x1 in bits(64), x1. o2 = ok(fn_update(t, "vm", V), pair(x0, x1))) by defs(taut(expand(e, any_rel), ne), any_rel)
  obtain y0, _ e2 from e1
  have e3: ex x1. x1 in bits(64) && o2 = ok(fn_update(t, "vm", V), pair(y0, x1)) by taut(expand(e2, any_rel), ne)
  obtain y1, _ ho from e3
  show by disj({2}, ex_intro({V}, {pair(y0, y1)}, taut(hs1, ho)))
qed

// (the purpose spec diverges nowhere it does not also raise)
theorem mp.lf_divg: all c. tr.div_raises_g(mp.G, mallocng_specs.libc_free_spec_fun(c))
proof
  fix c
  have body: all regs w h t. regs in abi.ARGS -> w in abi.World -> w in univ(1) -> h in mp.G ->
      runs(mallocng_specs.libc_free_spec(c, bits_of_int(64, regs[0])), union2(w, h), diverge(t)) ->
      runs(mallocng_specs.libc_free_spec(c, bits_of_int(64, regs[0])), union2(w, h), exc(union2(w, h), empty)) proof
    fix regs w h t
    assume _ hw hwu hh hr
    have {su = univ, sv = vm} := apply(mp.gS, hw, hwu, hh)
    have hr2 := expand(hr, mallocng_specs.libc_free_spec)
    show := apply(ct.contract_div_r, su, sv, hr2, defs(ct.dv_ifb_a, letin))
  qed
  show by defs(apply(ct.fun_divg_v, mp.g_univ, body), mallocng_specs.libc_free_spec_fun)
qed

// its C function value, its divergence, its machine code over any callees
contract __libc_free mallocng_specs.libc_free_spec_fun by mp.lf call mp.lf_call
