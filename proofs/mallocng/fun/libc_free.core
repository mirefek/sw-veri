    have md32b: g.mem_defined(S2, G, 32, 1, false) by simp(gnz, g32b, u32)
    have sn1: gimple.sval(SVT, bits_neg(64, 1)) = int_neg(1) by defs(simp(), gimple.sval, bits_neg, pow2)
    have pm1: int_add(ST0, gimple.sval(SVT, bits_neg(64, 1))) = int_sub(ST0, 1) by arith(sn1)
    have nn4: int_le(0, int_add(ST0, gimple.sval(SVT, bits_neg(64, 1)))) := rewrite(sym(pm1), (int_le(0, int_sub(ST0, 1)) by arith(gm, hi, gsto)))
    have lt4: int_lt(int_add(ST0, gimple.sval(SVT, bits_neg(64, 1))), pow2(64)) := rewrite(sym(pm1), (int_lt(int_sub(ST0, 1), pow2(64)) by defs(arith(stb), pow2)))
    step k10 from k9 with g.padd_det, pm1 using conj(w2W, w2u, stb, nn4, lt4, gb, md32b)
