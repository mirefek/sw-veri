// __libc_free by its purpose: the block p given back -- its slot reserved
// (the header marked freed), then unused again (its bit into the freed
// mask) or, all its group's slots then free, nontrivial_free's (the group
// given back, its own mapping returned to the kernel: unmapped, errno
// kept).

// ----------------------------------------------------------------------
//  get_nominal_size at a call

// (a live block's size: below 2^64 -- its slot's bytes mapped)
theorem mp.blk_size(c, A, vm, b, g, i, p): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  mallocng.holds_m(c, A, vm, b) -> mallocng.is_used(A, g) -> i in omega -> int_lt(i, seq_len(A.slots[g])) -> A.slots[g][i] = tag(1, p) -> p in bits(64) ->
  snd(b[p]) in bits(64)
proof
  assume hc hu ha hb hh hg hi hil hs hp
  have {H = inv} := expand(hh, mallocng.holds_m)
  have {huo = used, hwf = wf} := expand(H, mallocng.holds)
  have gl := apply(mp.grp_low_of, hc, hu, ha, hh)
  have po: p in omega by arith(hp)
  have pb: bits_of_int(64, p) = p := mp(bits_of_int_small[n := 64, a := p], po, (int_lt(p, pow2(64)) by arith(hp)))
  have {s1 = start, e1 = fits, n1 = size, bl = live} := apply(mp.blk_frame, ha, hb, H, hg, hi, hil, hs, po)
  have pz _ _ := expand(mp(all_elim(expand(hwf, malloc.blocks_wf), {p}), hp, rewrite(pb, bl)), malloc.block_wf)
  have e1p := rewrite(pb, e1)
  have n1p := rewrite(pb, n1)
  have _ xn := apply(mp.ext_ge, n1p)
  have {go = nat} := apply(mp.used_nat, ha, hg)
  have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
  have c0: snd(b[p]) = 0 -> snd(b[p]) in bits(64) by arith()
  have c1: int_lt(0, snd(b[p])) -> snd(b[p]) in bits(64) proof
    assume nz
    let a := int_sub(int_add(p, snd(b[p])), 1)
    have ao: a in omega by arith(po, n1p, nz)
    have is: mallocng.in_slot(A.metas[g], i, a) by defs(arith(s1, e1p, xn, ci, nz, po), mallocng.in_slot)
    have ir := apply(mp.slot_in_group[A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, g := g, i := i, a := a], ha, go, hi, ao,
      apply(mp.used_group, huo, hg), hil, is)
    have lt := mp(all_elim(gl, {g}, {a}), hg, ao, ir)
    have pw: pow2(64) = 18446744073709551616 by defs(simp(), pow2)
    show by arith(lt, pw, po, n1p, nz, pz)
  qed
  show by taut(c0, c1, (snd(b[p]) = 0 || int_lt(0, snd(b[p])) by arith(n1p)))
qed

// get_nominal_size(p, end), p a block in slot i of g, end the slot's end:
// the block's size returned, nothing changed
theorem mp.gns_q(c, regs, s, h, p, e, o2, g, i, g0): c in mallocng.Cfg -> p in bits(64) -> e in bits(64) -> s in abi.World -> h in mp.G ->
  mallocng.holds_m(c, h.A, s.vm, h.blocks) -> mallocng.shown_in(c, h.A, s.objs) -> mallocng.no_reserved(h.A) ->
  mallocng.is_used(h.A, g) -> i in omega -> int_lt(i, seq_len(h.A.slots[g])) -> h.A.slots[g][i] = tag(1, p) -> e = mallocng.slot_end(h.A.metas[g], i) ->
  gc.regs_ok(regs, seq_concat(seq_one(gimple.arg(64, p)), seq_one(gimple.arg(64, e)))) -> runs(c_src_malloc_mallocng_free.get_nominal_size_fun(g0)[regs], s, o2) ->
  abi.ovf_out(s, o2) || (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && bits_of_int(64, fst(r)) = snd(h.blocks[p]) && fst(r) in bits(64))
proof
  assume hc hp he hs hh hin hsh hnr hg hi hil hsl hse hro h2
  have hu _ hbt hat := mp(all_elim(mp.g_rec, {h}), hh)
  have rl rn r0 r1 := apply(gc.regs2, hp, he, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  have o2l: ord_le(2, seq_len(regs)) by defs(simp(rn), ord_le)
  have bp: bits_of_int(64, regs[0]) = p by defs(simp(r0, hp), bits_of_int, pow2)
  have be: bits_of_int(64, regs[1]) = e by defs(simp(r1, he), bits_of_int, pow2)
  have nb := apply(mp.blk_size[c := c, A := h.A, vm := s.vm, b := h.blocks, g := g, i := i, p := p], hc, (h.A in univ(1) by simp(hu)), hat, hbt, hin, hg, hi, hil, hsl, hp)
  have pc: all o. runs(c_src_malloc_mallocng_free.get_nominal_size(bits_of_int(64, regs[0]), bits_of_int(64, regs[1]), g0), s, o) ->
      abi.ovf_out(s, o) || o = ok(s, snd(h.blocks[p])) proof
    fix o
    assume hr
    have e1 _ := apply(mp.gns_run[c := c, p := p, e := e, s := s, h := h, o := o, g := g, i := i, g0 := g0], hc, hp, he, hs, hh, hin, hsh, hnr, hg, hi, hil, hsl, hse,
      rewrite(be, rewrite(bp, hr)))
    show by taut(e1)
  qed
  have res: all o. runs(gimple.result(64, snd(h.blocks[p])), s, o) -> ex u. u in bits(64) && bits_of_int(64, u) = snd(h.blocks[p]) && o = ok(s, u) proof
    fix o
    assume hr
    have e1 := mp(all_elim(g.result64_inv, {s}, {snd(h.blocks[p])}, {o}), nb, hr)
    show by ex_intro({snd(h.blocks[p])}, taut(nb, (bits_of_int(64, snd(h.blocks[p])) = snd(h.blocks[p]) by simp(nb)), e1))
  qed
  have hf := expand(h2, c_src_malloc_mallocng_free.get_nominal_size_fun)
  show := apply(g.fun_q[p := x0. c_src_malloc_mallocng_free.get_nominal_size(bits_of_int(64, x0[0]), bits_of_int(64, x0[1]), g0), w := 64, n := 2, regs := regs, s := s,
    o2 := o2, v := snd(h.blocks[p])], ra, o2l, hs, pc, res, hf)
qed

// ----------------------------------------------------------------------
//  Arithmetic of the page test

// (the low 12 bits: below 4096)
theorem mp.and_low(x): bits_and(64, x, 4095) in bits(12)
proof
  have a1 := mp(bits_and_in[n := 64, x := x, y := 4095], simp())
  have a2 := mp(bits_and_in[n := 64, x := 4095, y := x], simp())
  have bt: all i. i in omega -> int_lt(i, 64) -> (bit(bits_and(64, x, 4095), i) <-> bit(bits_and(64, 4095, x), i)) proof
    fix i
    assume hi hl
    show by taut(mp(bit_and[n := 64, x := x, y := 4095, i := i], simp(), hi, hl), mp(bit_and[n := 64, x := 4095, y := x, i := i], simp(), hi, hl))
  qed
  have ec := mp(all_elim(bits_ext, {64}), simp(), {bits_and(64, x, 4095)}, {bits_and(64, 4095, x)}, a1, a2, bt)
  have en := mp(bits_and_narrow[m := 12, n := 64, x := 4095, y := x], simp(), simp(), simp(), simp())
  show := rewrite(sym(trans(ec, en)), mp(bits_and_in[n := 12, x := 4095, y := x], simp()))
qed

// (a bit clear: S and it 0)
theorem mp.and_bit0(S, i): S in bits(32) -> i in omega -> int_lt(i, 32) -> !bit(S, i) -> bits_and(32, S, pow2(i)) = 0
proof
  assume hs hi hil hn
  have a1 := mp(bits_and_in[n := 32, x := S, y := pow2(i)], simp())
  have z0: 0 in bits(32) by simp()
  have bt: all j. j in omega -> int_lt(j, 32) -> (bit(bits_and(32, S, pow2(i)), j) <-> bit(0, j)) proof
    fix j
    assume hj hjl
    have b1 := mp(bit_and[n := 32, x := S, y := pow2(i), i := j], simp(), hj, hjl)
    have b2 := mp(bit_pow2[k := i, i := j], hi, hj)
    have b3 := mp(bit_zero[i := j], hj)
    have c1: j = i -> !bit(S, j) by simp(hn)
    show by taut(b1, b2, b3, c1)
  qed
  show := mp(all_elim(bits_ext, {32}), simp(), {bits_and(32, S, pow2(i))}, {0}, a1, z0, bt)
qed

theorem mp.sint_small(x): x in omega -> int_lt(x, 9223372036854775808) -> sint(64, x) = x
proof
  assume ho hl
  have bx: bits_of_int(64, x) = x := mp(bits_of_int_small[n := 64, a := x], ho, (int_lt(x, pow2(64)) by defs(arith(hl), pow2)))
  have l63: int_lt(x, pow2(63)) by defs(arith(hl), pow2)
  show by defs(simp(bx, l63), sint, letin)
qed

theorem mp.s64_fits_of(x): int_le(int_neg(9223372036854775808), x) -> int_lt(x, 9223372036854775808) -> tr.s64_fits(x)
proof
  assume h1 h2
  show by defs(simp(h1, h2), gimple.fits)
qed

// ----------------------------------------------------------------------
//  The slot's place

// (a slot's end -- the next slot's check byte, or the group's last byte:
// its group's)
theorem mp.end_in_group(A, M, b, g, i): A in mallocng.Abs -> g in omega -> i in omega -> mallocng.group_ok(A, M, b, g) -> int_lt(i, seq_len(A.slots[g])) ->
  mallocng.in_range(mallocng.slot_end(A.metas[g], i), mallocng.group_range(A.metas[g]))
proof
  assume ha hg hi hok hil
  let V := A.metas[g]
  let S := mallocng.stride(V)
  let a := mallocng.slot_end(V, i)
  have vt: V in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A.metas, x := g], simp(ha), hg)
  have vo: V.mem in omega && V.maplen in omega && V.last_idx in omega by simp(vt)
  have {gl = nslots, gmp = mapped} := expand(hok, mallocng.group_ok)
  have so := apply(mp.stride_nat, ha, hg, hok)
  have sg := apply(mp.stride_ge, ha, hg, hok)
  have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
  have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
  have ea: a = int_sub(int_add(int_add(int_add(V.mem, 16), int_mul(S, i)), S), 4) by defs(simp(cu, ci), mallocng.slot_end, mallocng.slot_start, mallocng.storage)
  have il: int_le(int_add(i, 1), int_add(V.last_idx, 1)) by arith(gl, hil)
  have mle := mp(all_elim(ms.mul_le, {S}, {int_add(i, 1)}, {S}, {int_add(V.last_idx, 1)}), so, (int_add(i, 1) in omega by simp(hi)), simp(so), simp(vo), arith(so), il)
  have d1: int_mul(S, int_add(i, 1)) = int_add(int_mul(S, i), S) by simp(so, hi)
  have m0: int_mul(S, i) in omega by simp(so, hi)
  have up: int_le(a, int_add(int_add(V.mem, 16), int_sub(int_mul(S, int_add(V.last_idx, 1)), 4))) by arith(ea, d1, mle)
  have lo: int_le(V.mem, a) by arith(ea, m0, sg)
  have c1: int_lt(0, V.maplen) -> mallocng.in_range(a, mallocng.group_range(V)) proof
    assume k
    have _ big := mp(gmp, k)
    have e := mp(ite_t[c := int_lt(0, V.maplen), a := pair(V.mem, int_mul(V.maplen, 4096)), b := pair(V.mem, int_add(int_sub(int_add(mallocng.UNIT, int_mul(S, int_add(V.last_idx, 1))), mallocng.IB), 1))], k)
    have r: int_le(V.mem, a) && int_lt(a, int_add(V.mem, int_mul(V.maplen, 4096))) by arith(lo, up, big, cu)
    show by defs(simp(e, r), mallocng.group_range, mallocng.in_range)
  qed
  have c2: !int_lt(0, V.maplen) -> mallocng.in_range(a, mallocng.group_range(V)) proof
    assume k
    have e := mp(ite_f[c := int_lt(0, V.maplen), a := pair(V.mem, int_mul(V.maplen, 4096)), b := pair(V.mem, int_add(int_sub(int_add(mallocng.UNIT, int_mul(S, int_add(V.last_idx, 1))), mallocng.IB), 1))], k)
    have r: int_le(V.mem, a) && int_lt(a, int_add(V.mem, int_add(int_sub(int_add(mallocng.UNIT, int_mul(S, int_add(V.last_idx, 1))), mallocng.IB), 1))) by arith(lo, up, cu, ci)
    show by defs(simp(e, r), mallocng.group_range, mallocng.in_range)
  qed
  show by taut(c1, c2)
qed

// (a block's in-band header, its bytes p-3 to p-1: the allocator's, in its
// group)
theorem mp.bhdr_fp(c, A, vm, b, g, i, p, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  mallocng.holds_m(c, A, vm, b) -> mallocng.no_reserved(A) -> seq_len(A.taken) = 0 ->
  mallocng.is_used(A, g) -> i in omega -> int_lt(i, seq_len(A.slots[g])) -> A.slots[g][i] = tag(1, p) -> p in bits(64) ->
  a in omega -> int_le(int_sub(p, 3), a) -> int_lt(a, p) ->
  grp: mallocng.in_range(a, mallocng.group_range(A.metas[g])) && fp: a in mallocng.footprint(c, A, b)
proof
  assume hc hu ha hb hh hnr htk hg hi hil hs hp hao l1 l2
  have {H = inv} := expand(hh, mallocng.holds_m)
  have {huo = used} := expand(H, mallocng.holds)
  have gok := apply(mp.used_group, huo, hg)
  have {go = nat} := apply(mp.used_nat, ha, hg)
  have po: p in omega by arith(hp)
  have {s1 = start, e1 = fits, n1 = size, hf = hdr} := apply(mp.blk_frame, ha, hb, H, hg, hi, hil, hs, po)
  have x1 _ := apply(mp.ext_ge, n1)
  have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
  have hf0 := expand(hf, mallocng.hdr_free)
  have is: mallocng.in_slot(A.metas[g], i, a) by defs(arith(s1, e1, x1, ci, l1, l2, hao), mallocng.in_slot)
  have ir := apply(mp.slot_in_group[A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, g := g, i := i, a := a], ha, go, hi, hao, gok, hil, is)
  have rr := apply(mp.used_rng, hc, hu, ha, hg, ir)
  have nl := mp(all_elim(hf0, {a}), hao, (int_le(int_sub(p, mallocng.IB), a) && int_lt(a, p) by arith(ci, l1, l2, hao)))
  have nr := apply(mp.nores[A := A, a := a], hnr)
  have nt: !mallocng.in_taken(A, a) proof
    assume w
    obtain k, hk hkl _ _ from expand(w, mallocng.in_taken)
    show by arith(hk, hkl, htk)
  qed
  show by taut(ir, apply(mp.fp_def[c := c, A := A, b := b, a := a]), hao, rr, nl, nr, nt)
qed

// (... writable -- the marks free writes there)
theorem mp.bhdr_usable(c, A, vm, b, objs, g, i, p, a, n): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  mallocng.holds_m(c, A, vm, b) -> mallocng.shown_in(c, A, objs) -> mallocng.no_reserved(A) -> seq_len(A.taken) = 0 ->
  mallocng.is_used(A, g) -> i in omega -> int_lt(i, seq_len(A.slots[g])) -> A.slots[g][i] = tag(1, p) -> p in bits(64) ->
  a in omega -> n in omega -> int_le(int_sub(p, 3), a) -> int_le(int_add(a, n), p) -> gimple.usable(vm, objs, a, n, true)
proof
  assume hc hu ha hb hh hsh hnr htk hg hi hil hs hp hao hn l1 l2
  have {H = inv, hrw = rw} := expand(hh, mallocng.holds_m)
  have {huo = used} := expand(H, mallocng.holds)
  have gok := apply(mp.used_group, huo, hg)
  have {go = nat} := apply(mp.used_nat, ha, hg)
  have po: p in omega by arith(hp)
  have {s1 = start, e1 = fits, n1 = size, hf = hdr} := apply(mp.blk_frame, ha, hb, H, hg, hi, hil, hs, po)
  have x1 _ := apply(mp.ext_ge, n1)
  have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
  have hf0 := expand(hf, mallocng.hdr_free)
  have fv := apply(mp.fp_vis[c := c, A := A, objs := objs, b := b], hsh)
  have each0: all j. j in omega -> int_lt(j, n) -> mallocng.in_range(int_add(a, j), mallocng.group_range(A.metas[g])) &&
      int_add(a, j) in mallocng.footprint(c, A, b) proof
    fix j
    assume hj hjl
    show := apply(mp.bhdr_fp[c := c, A := A, vm := vm, b := b, g := g, i := i, p := p, a := int_add(a, j)], hc, hu, ha, hb, hh, hnr, htk, hg, hi, hil, hs, hp,
      arith(hao, hj), arith(l1, hj, hao), arith(l2, hjl, hj, hao))
  qed
  have each: all j. j in omega -> int_lt(j, n) -> int_add(a, j) in mallocng.all_bytes() &&
      mallocng.m_rw(mallocng.mview(vm, mallocng.all_bytes()), int_add(a, j)) &&
      !(snd(mallocng.pg(mallocng.mview(vm, mallocng.all_bytes()), int_add(a, j))).kind = 2) proof
    fix j
    assume hj hjl
    have xo: int_add(a, j) in omega by arith(hao, hj)
    have ir fp := mp(all_elim(each0, {j}), hj, hjl)
    have o1 o2 := mp(all_elim(expand(hrw, mallocng.grp_rw), {g}, {int_add(a, j)}), conj(go, xo), taut(hg, ir, fp))
    show by taut((int_add(a, j) in mallocng.all_bytes() by defs(sel(taut(xo)), mallocng.all_bytes)), o1, o2)
  qed
  have vis: all j. j in omega -> int_lt(j, n) -> int_add(a, j) in objs.c_bytes proof
    fix j
    assume hj hjl
    have _ fp := mp(all_elim(each0, {j}), hj, hjl)
    show := mp(all_elim(fv, {int_add(a, j)}), fp)
  qed
  have _ w := apply(mp.rw_usable_at[vm := vm, F := mallocng.all_bytes(), objs := objs, a := a, n := n], hao, each, vis)
  show := w
qed

// (the groups' bytes mapped: below the task size)
abbrev mp.grp_tsz(A) := all x a. mallocng.is_used(A, x) -> a in omega -> mallocng.in_range(a, mallocng.group_range(A.metas[x])) -> int_lt(a, 140737488351232)

theorem mp.grp_tsz_of(c, A, vm, b): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_m(c, A, vm, b) -> mp.grp_tsz(A)
proof
  assume hc hu ha hh
  have ga := apply(mp.grp_all_of, hc, hu, ha, hh)
  have ts: int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE) = 34359738367 by defs(simp(), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
  have pg: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
  fix x a
  assume iu ao ir
  have {xo = nat} := apply(mp.used_nat, ha, iu)
  have rw _ := mp(all_elim(ga, {x}, {a}), conj(xo, ao), conj(iu, ir))
  have mm _ _ := expand(rw, mallocng.m_rw)
  have ml _ := expand(mm, mallocng.m_mapped)
  show by arith(ml, ts, pg, ao)
qed

// (the blocks without p: a set of the universe -- a ghost part)
theorem mp.uf_bu(b, p): b in fn_space(bits(64), option(omega)) -> malloc.set_block(b, p, none) in univ(1)
proof
  assume hb
  have smu: all x. x in omega -> some(x) in univ(1) proof
    fix x
    assume hx
    have xu := mp(mp(univ_trans[u := 1, a := x, b := omega], omega_univ), hx)
    show by defs(simp(xu), some)
  qed
  have imu := mp(mp(univ_image[u := 1, s := omega, f := x. some(x)], omega_univ), smu)
  have nu: single(none) in univ(1) by defs(simp(), single, none)
  have ou: option(omega) in univ(1) by defs(mp(mp(union2_univ[u := 1, a := single(none), b := set_image(omega, x. some(x))], nu), imu), option)
  show := mp(fn_space_univ[u := 1, a := bits(64), b := option(omega), f := malloc.set_block(b, p, none)], bits_univ[n := 64], ou, apply(mp.uf_btype[b := b, p := p], hb))
qed

// ----------------------------------------------------------------------
//  free's steps composed

// the block unframed (on memory V2: only the allocator's bytes written),
// then given back (freed_back, to V3): free's purpose -- the invariant
// without the block, nothing outside the allocator and the block touched,
// the allocator grown only by the block
// four bytes' little-endian value, and its bytes again
theorem mp.digits4(y0, y1, y2, y3): y0 in bits(8) -> y1 in bits(8) -> y2 in bits(8) -> y3 in bits(8) ->
  bits_add(32, int_add(int_add(int_add(y0, int_mul(y1, 256)), int_mul(y2, 65536)), int_mul(y3, 16777216)), 0) =
    int_add(int_add(int_add(y0, int_mul(y1, 256)), int_mul(y2, 65536)), int_mul(y3, 16777216)) &&
  bits_of_int(8, int_add(int_add(int_add(y0, int_mul(y1, 256)), int_mul(y2, 65536)), int_mul(y3, 16777216))) = y0 &&
  bits_of_int(8, int_div(int_add(int_add(int_add(y0, int_mul(y1, 256)), int_mul(y2, 65536)), int_mul(y3, 16777216)), 256)) = y1 &&
  bits_of_int(8, int_div(int_add(int_add(int_add(y0, int_mul(y1, 256)), int_mul(y2, 65536)), int_mul(y3, 16777216)), 65536)) = y2 &&
  bits_of_int(8, int_div(int_add(int_add(int_add(y0, int_mul(y1, 256)), int_mul(y2, 65536)), int_mul(y3, 16777216)), 16777216)) = y3
proof
  assume h0 h1 h2 h3
  have e0: bits_add(32, int_add(int_add(int_add(y0, int_mul(y1, 256)), int_mul(y2, 65536)), int_mul(y3, 16777216)), 0) =
    int_add(int_add(int_add(y0, int_mul(y1, 256)), int_mul(y2, 65536)), int_mul(y3, 16777216)) by defs(arith(h0, h1, h2, h3), bits_add, pow2)
  have e1: bits_of_int(8, int_add(int_add(int_add(y0, int_mul(y1, 256)), int_mul(y2, 65536)), int_mul(y3, 16777216))) = y0 by defs(arith(h0, h1, h2, h3), bits_of_int, pow2)
  have e2: bits_of_int(8, int_div(int_add(int_add(int_add(y0, int_mul(y1, 256)), int_mul(y2, 65536)), int_mul(y3, 16777216)), 256)) = y1 by defs(arith(h0, h1, h2, h3), bits_of_int, pow2)
  have e3: bits_of_int(8, int_div(int_add(int_add(int_add(y0, int_mul(y1, 256)), int_mul(y2, 65536)), int_mul(y3, 16777216)), 65536)) = y2 by defs(arith(h0, h1, h2, h3), bits_of_int, pow2)
  have e4: bits_of_int(8, int_div(int_add(int_add(int_add(y0, int_mul(y1, 256)), int_mul(y2, 65536)), int_mul(y3, 16777216)), 16777216)) = y3 by defs(arith(h0, h1, h2, h3), bits_of_int, pow2)
  show by taut(e0, e1, e2, e3, e4)
qed

// four bytes stored back as read: the memory as it was
theorem mp.st_back4(b, a): b in fn_space(bits(64), bits(8)) -> a in bits(64) ->
  x86_64_linux.store_le(b, a, 4, x86_64_linux.le(b, a, 4)) = b
proof
  assume hb ha
  have y0: b[a] in bits(8) by simp(hb, ha)
  have y1: b[bits_add(64, a, 1)] in bits(8) by simp(hb)
  have y2: b[bits_add(64, a, 2)] in bits(8) by simp(hb)
  have y3: b[bits_add(64, a, 3)] in bits(8) by simp(hb)
  let S := int_add(int_add(int_add(b[a], int_mul(b[bits_add(64, a, 1)], 256)), int_mul(b[bits_add(64, a, 2)], 65536)), int_mul(b[bits_add(64, a, 3)], 16777216))
  have sv0: x86_64_linux.le(b, a, 4) = bits_add(32, S, 0) by defs(simp(hb, ha), x86_64_linux.le)
  have sv1 d0 d1 d2 d3 := apply(mp.digits4[y0 := b[a], y1 := b[bits_add(64, a, 1)], y2 := b[bits_add(64, a, 2)], y3 := b[bits_add(64, a, 3)]], y0, y1, y2, y3)
  have sv := trans(sv0, sv1)
  have bf: is_fun(b) by simp(hb)
  have bd: dom(b) = bits(64) by simp(hb)
  have s4 := apply(x86.store4, {b}, {a}, {S}, bf, bd, ha, (S in omega by arith(y0, y1, y2, y3)))
  have s5 := rewrite(d3, rewrite(d2, rewrite(d1, rewrite(d0, s4))))
  have u0 := mp(fn_update_same[f := b, k := a], bf, (a in dom(b) by simp(bd, ha)))
  have u1 := mp(fn_update_same[f := b, k := bits_add(64, a, 1)], bf, (bits_add(64, a, 1) in dom(b) by simp(bd)))
  have u2 := mp(fn_update_same[f := b, k := bits_add(64, a, 2)], bf, (bits_add(64, a, 2) in dom(b) by simp(bd)))
  have u3 := mp(fn_update_same[f := b, k := bits_add(64, a, 3)], bf, (bits_add(64, a, 3) in dom(b) by simp(bd)))
  have s6 := rewrite(u3, rewrite(u2, rewrite(u1, rewrite(u0, s5))))
  show := rewrite(sym(sv), s6)
qed

theorem mp.lf_comp(c, A, A2, B, V0, V2, V3, objs, g, i, p, mb, ml): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs ->
  B in fn_space(bits(64), option(omega)) -> mallocng.holds_m(c, A, V0, B) -> mallocng.no_reserved(A) -> seq_len(A.taken) = 0 ->
  mallocng.is_used(A, g) -> i in omega -> int_lt(i, seq_len(A.slots[g])) -> A.slots[g][i] = tag(1, p) -> p in bits(64) ->
  mallocng.kept_outside(c, A, B, V0, V2, empty) -> mallocng.holds_m(c, mp.unfr(A, g, i), V2, malloc.set_block(B, p, none)) ->
  (all a. a in mallocng.footprint(c, mp.unfr(A, g, i), malloc.set_block(B, p, none)) -> a in mallocng.footprint(c, A, B)) ->
  mallocng_specs.freed_back(c, mp.unfr(A, g, i), A2, malloc.set_block(B, p, none), V2, V3, objs, mb, ml) ->
  nores: mallocng.no_reserved(A2) && taken: seq_len(A2.taken) = 0 && holds: mallocng.holds_in(c, A2, V3, objs, malloc.set_block(B, p, none)) &&
  unt: mallocng.untouched(c, A, B, V0, V3, objs, malloc.range(p, snd(B[p]))) &&
  fp: (all a. a in mallocng.footprint(c, A2, malloc.set_block(B, p, none)) -> a in mallocng.footprint(c, A, B) || a in malloc.range(p, snd(B[p]))) &&
  gone: (!(ml = 0) -> (all a. a in omega -> int_le(x86_64_linux.page_of(mb), int_div(a, x86_64_linux.PAGE)) ->
     int_lt(int_div(a, x86_64_linux.PAGE), int_add(x86_64_linux.page_of(mb), x86_64_linux.pages_for(ml))) ->
     (a in mallocng.footprint(c, A, B) || a in malloc.range(p, snd(B[p]))) && !mallocng.in_ranges(a, mallocng.fp_ranges(c, A2))))
proof
  assume hc hu ha hb hh hnr htk hg hi hil hs hp k02 hm1 fps fb
  let A1 := mp.unfr(A, g, i)
  let B1 := malloc.set_block(B, p, none)
  have hin3 nr3 tk3 u23 fg3 lg3 _ := expand(fb, mallocng_specs.freed_back)
  have {go = nat} := apply(mp.used_nat, ha, hg)
  have {a1a = abs, a1u = univ} := apply(mp.setu_type[A := A, h := g, i := i, u := tag(3, empty)], ha, go, hi, hil, mp.use3)
  have b1t := apply(mp.uf_btype[b := B, p := p], hb)
  have {H = inv} := expand(hh, mallocng.holds_m)
  have {huo = used} := expand(H, mallocng.holds)
  have {H1 = inv} := expand(hm1, mallocng.holds_m)
  // a byte reserved after: the allocator's before, or the block's
  have rsv: all a. a in omega -> mallocng.in_reserved(A1, a) -> a in mallocng.footprint(c, A, B) || a in malloc.range(p, snd(B[p])) proof
    fix a
    assume hao r
    obtain h2 j, hh2 hj iu2 hjl2 hs2 his from expand(r, mallocng.in_reserved)
    // (only slot i of g reserved in A1: A had none)
    have d: !(g = h2 && i = j) -> false proof
      assume ne
      have q1: h2 = g -> A1.slots[h2][j] = A.slots[h2][j] proof
        assume e
        have ji: !(j = i) by taut(ne, sym(e))
        show by simp(e, mp(app_update_other[f := A.slots[g], k := i, v := tag(3, empty), x := j], ji))
      qed
      have q2: !(h2 = g) -> A1.slots[h2][j] = A.slots[h2][j] proof
        assume e
        show by simp(mp(app_update_other[f := A.slots, k := g, v := fn_update(A.slots[g], i, tag(3, empty)), x := h2], e))
      qed
      have s4: A1.slots[h2][j] = A.slots[h2][j] by taut(q1, q2)
      have r4: A.slots[h2][j] = tag(3, empty) := trans(sym(s4), hs2)
      have ln4 := apply(mp.su_len[A := A, g := g, i := i, u := tag(3, empty), p := h2], ha, go, hi, hil, mp.use3)
      have nr4 := mp(all_elim(expand(hnr, mallocng.no_reserved), {h2}, {j}), conj(hh2, hj), rewrite(ln4, hjl2))
      show by taut(nr4, r4)
    qed
    have e1 e2 := (g = h2 && i = j by taut(d))
    have is: mallocng.in_slot(A.metas[g], i, a) by simp(e1, e2, his)
    have nl1 := apply(mp.res_nolive[c := c, A := A1, M := mallocng.mview(V2, mallocng.held(c, A1, B1)), b := B1, brk := V2.brk, a := a], hc, a1u, a1a, b1t, H1, r)
    have c1: a in malloc.live_of(B) -> a in malloc.range(p, snd(B[p])) proof
      assume l
      show := apply(mp.uf_live2[b := B, p := p, a := a], l, nl1)
    qed
    have c2: !(a in malloc.live_of(B)) -> a in mallocng.footprint(c, A, B) proof
      assume nl
      have ir := apply(mp.slot_in_group[A := A, M := mallocng.mview(V0, mallocng.held(c, A, B)), b := B, g := g, i := i, a := a], ha, go, hi, hao,
        apply(mp.used_group, huo, hg), hil, is)
      have rr := apply(mp.used_rng, hc, hu, ha, hg, ir)
      have nr := apply(mp.nores[A := A, a := a], hnr)
      have nt: !mallocng.in_taken(A, a) proof
        assume w
        obtain kk, hk hkl _ _ from expand(w, mallocng.in_taken)
        show by arith(hk, hkl, htk)
      qed
      show by taut(apply(mp.fp_def[c := c, A := A, b := B, a := a]), hao, rr, nl, nr, nt)
    qed
    show by taut(c1, c2)
  qed
  // nothing outside the allocator and the block touched
  have k1 kb := expand(k02, mallocng.kept_outside)
  have u1 ub := expand(u23, mallocng.untouched)
  have ur: all x0. x0 in omega -> (!(x0 in mallocng.footprint(c, A, B)) && !(x0 in malloc.range(p, snd(B[p])))) && x86_64_linux.mapped(V0, int_div(x0, x86_64_linux.PAGE)) ->
      (!abi.stack_free(V0, objs, x0) -> V3.bytes[bits_of_int(64, x0)] = V0.bytes[bits_of_int(64, x0)]) &&
      V3.pages[int_div(x0, x86_64_linux.PAGE)] = V0.pages[int_div(x0, x86_64_linux.PAGE)] proof
    fix a
    assume hao w
    have w1 w2 w3 := w
    have kb2 kp2 := mp(all_elim(k1, {a}), hao, taut(w1, (!(a in empty) by simp()), w3))
    have m2: x86_64_linux.mapped(V2, int_div(a, x86_64_linux.PAGE)) by defs(simp(kp2, expand(w3, x86_64_linux.mapped)), x86_64_linux.mapped)
    have nf1: !(a in mallocng.footprint(c, A1, B1)) proof
      assume f
      show by taut(w1, mp(all_elim(fps, {a}), f))
    qed
    have nr1: !(a in set_select(omega, x0. mallocng.in_reserved(A1, x0))) proof
      assume rr0
      have r: mallocng.in_reserved(A1, a) by taut(set_select_def[s := omega, p := x0. mallocng.in_reserved(A1, x0), z := a], rr0)
      show by taut(mp(all_elim(rsv, {a}), hao, r), w1, w2)
    qed
    have q1 q2 := mp(all_elim(u1, {a}), hao, taut(nf1, nr1, m2))
    have sf: abi.stack_free(V2, objs, a) <-> abi.stack_free(V0, objs, a) by defs(simp(kp2), abi.stack_free, x86_64_linux.mapped)
    have bb: !abi.stack_free(V0, objs, a) -> V3.bytes[bits_of_int(64, a)] = V0.bytes[bits_of_int(64, a)] proof
      assume ns
      show := trans(mp(q1, (!abi.stack_free(V2, objs, a) by taut(sf, ns))), kb2)
    qed
    show by taut(bb, trans(q2, kp2))
  qed
  have bk: mallocng.bounds_kept(V0, V3) by defs(simp(expand(kb, mallocng.bounds_kept), expand(ub, mallocng.bounds_kept)), mallocng.bounds_kept)
  have unt: mallocng.untouched(c, A, B, V0, V3, objs, malloc.range(p, snd(B[p]))) by defs(taut(ur, bk), mallocng.untouched)
  // the allocator's bytes after: its own before, or the block's
  have fpg: all a. a in mallocng.footprint(c, A2, B1) -> a in mallocng.footprint(c, A, B) || a in malloc.range(p, snd(B[p])) proof
    fix a
    assume f
    have ao := (a in omega by taut(apply(mp.fp_def[c := c, A := A2, b := B1, a := a]), f))
    show by taut(mp(all_elim(fg3, {a}), ao, f), all_elim(fps, {a}), mp(all_elim(rsv, {a}), ao))
  qed
  have tk2: seq_len(A2.taken) = 0 by simp(tk3, htk)
  // what is let go: the allocator's before (or the block's), in none of
  // its ranges after
  have gone: !(ml = 0) -> (all a. a in omega -> int_le(x86_64_linux.page_of(mb), int_div(a, x86_64_linux.PAGE)) ->
      int_lt(int_div(a, x86_64_linux.PAGE), int_add(x86_64_linux.page_of(mb), x86_64_linux.pages_for(ml))) ->
      (a in mallocng.footprint(c, A, B) || a in malloc.range(p, snd(B[p]))) && !mallocng.in_ranges(a, mallocng.fp_ranges(c, A2))) proof
    assume nz
    have l0 := expand(lg3, mallocng_specs.let_go)
    have q1 q2 q3 qa := (((int_mod(mb, 4096) = 0 && int_mod(ml, 4096) = 0) && int_lt(0, mb)) &&
      (all x0. x0 in omega -> int_le(mb, x0) && int_lt(x0, int_add(mb, ml)) -> (x0 in mallocng.footprint(c, A1, B1) || mallocng.in_reserved(A1, x0)) &&
         !(x0 in mallocng.footprint(c, A2, B1))) by taut(l0, nz))
    have kp: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
    have pof: x86_64_linux.page_of(mb) = int_div(mb, x86_64_linux.PAGE) by defs(simp(), x86_64_linux.page_of)
    have pfr: x86_64_linux.pages_for(ml) = int_div(ml, x86_64_linux.PAGE) by defs(arith(q2), x86_64_linux.pages_for, x86_64_linux.PAGE)
    fix a
    assume hao h1 h2
    have r1: int_le(mb, a) && int_lt(a, int_add(mb, ml)) by arith(rewrite(pof, h1), rewrite(pfr, rewrite(pof, h2)), q1, q2, kp, hao)
    have w1 w2 := mp(all_elim(qa, {a}), hao, r1)
    have bef: a in mallocng.footprint(c, A, B) || a in malloc.range(p, snd(B[p])) by taut(w1, all_elim(fps, {a}), mp(all_elim(rsv, {a}), hao))
    have aft: !mallocng.in_ranges(a, mallocng.fp_ranges(c, A2)) proof
      assume ir
      have nl1: mallocng.in_reserved(A1, a) -> !(a in malloc.live_of(B1)) proof
        assume r
        show := apply(mp.res_nolive[c := c, A := A1, M := mallocng.mview(V2, mallocng.held(c, A1, B1)), b := B1, brk := V2.brk, a := a], hc, a1u, a1a, b1t, H1, r)
      qed
      have nl: !(a in malloc.live_of(B1)) by taut(w1, nl1, apply(mp.fp_def[c := c, A := A1, b := B1, a := a]))
      have nr := apply(mp.nores[A := A2, a := a], nr3)
      have nt: !mallocng.in_taken(A2, a) proof
        assume w
        obtain kk, hk hkl _ _ from expand(w, mallocng.in_taken)
        show by arith(hk, hkl, tk2)
      qed
      show by taut(apply(mp.fp_def[c := c, A := A2, b := B1, a := a]), hao, ir, nl, nr, nt, w2)
    qed
    show by taut(bef, aft)
  qed
  show by taut(nr3, tk2, hin3, unt, fpg, gone)
qed

// pages q0 .. q0+k-1 unmapped, whose bytes were the allocator's (A's, or
// R's) and are none of A2's ranges: the invariant still holds, nothing
// else touched
theorem mp.lf_gone(c, A, A2, B, B1, V0, V4, V7, objs, R, q0, k): c in mallocng.Cfg -> A2 in univ(1) -> A2 in mallocng.Abs ->
  B1 in fn_space(bits(64), option(omega)) -> mallocng.holds_m(c, A2, V4, B1) -> mallocng.untouched(c, A, B, V0, V4, objs, R) ->
  gimple.gone_pages(V4, V7, q0, k) -> V7.brk = V4.brk ->
  (all a. a in omega -> int_le(q0, int_div(a, x86_64_linux.PAGE)) -> int_lt(int_div(a, x86_64_linux.PAGE), int_add(q0, k)) ->
     (a in mallocng.footprint(c, A, B) || a in R) && !mallocng.in_ranges(a, mallocng.fp_ranges(c, A2))) ->
  holds: mallocng.holds_m(c, A2, V7, B1) && unt: mallocng.untouched(c, A, B, V0, V7, objs, R)
proof
  assume hc hu ha hb hh hun hg hbk off
  have kp: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
  have u1 u2 := expand(hun, mallocng.untouched)
  have gt gl gs gpg gby := expand(hg, gimple.gone_pages)
  // the invariant: A2's pages none of those gone
  have hpr: all a. a in omega -> mallocng.in_ranges(a, mallocng.fp_ranges(c, A2)) -> V7.pages[int_div(a, x86_64_linux.PAGE)] = V4.pages[int_div(a, x86_64_linux.PAGE)] proof
    fix a
    assume hao hr
    have qo: int_div(a, x86_64_linux.PAGE) in omega by arith(hao, kp)
    have ml _ := expand(apply(mp.rng_mapped[c := c, A := A2, vm := V4, b := B1, a := a], ha, hb, hh, hao, hr), x86_64_linux.mapped)
    have ng: !(int_le(q0, int_div(a, x86_64_linux.PAGE)) && int_lt(int_div(a, x86_64_linux.PAGE), int_add(q0, k))) proof
      assume w
      have w1 w2 := w
      have _ n := mp(all_elim(off, {a}), hao, w1, w2)
      show by taut(n, hr)
    qed
    show by simp(mp(all_elim(gpg, {int_div(a, x86_64_linux.PAGE)}), qo, ml), ng)
  qed
  have hby: all a. a in omega -> mallocng.in_ranges(a, mallocng.fp_ranges(c, A2)) -> V7.bytes[bits_of_int(64, a)] = V4.bytes[bits_of_int(64, a)] proof
    fix a
    assume _ _
    show by simp(gby)
  qed
  // (the reserve's pages: on its bytes' pages)
  have {hrs4 = rsv} := expand(hh, mallocng.holds_m)
  have hrq: all q. q in omega -> int_le(int_div(A2.reserve, x86_64_linux.PAGE), q) && int_lt(q, int_add(int_div(A2.reserve, x86_64_linux.PAGE), A2.reserve_cnt)) ->
      V7.pages[q] = V4.pages[q] proof
    fix q
    assume hq hr
    have r1 r2 := hr
    have rso: A2.reserve in omega && A2.reserve_cnt in omega by simp(ha)
    have ro rco := rso
    let a := ite(int_le(A2.reserve, int_mul(q, 4096)), int_mul(q, 4096), A2.reserve)
    have ca: int_le(A2.reserve, int_mul(q, 4096)) -> a = int_mul(q, 4096) by simp()
    have cb: !int_le(A2.reserve, int_mul(q, 4096)) -> a = A2.reserve by simp()
    let AQ(x) := x in omega && int_le(A2.reserve, x) && int_lt(x, int_add(A2.reserve, int_mul(4096, A2.reserve_cnt))) && int_div(x, x86_64_linux.PAGE) = q
    have qa: int_le(A2.reserve, int_mul(q, 4096)) -> AQ(a) proof
      assume h
      have f: AQ(int_mul(q, 4096)) by arith(h, r1, r2, hq, ro, rco, kp)
      show := subst({x. AQ(x)}, sym(mp(ca, h)), f)
    qed
    have qb: !int_le(A2.reserve, int_mul(q, 4096)) -> AQ(a) proof
      assume h
      have f: AQ(A2.reserve) by arith(h, r1, r2, hq, ro, rco, kp)
      show := subst({x. AQ(x)}, sym(mp(cb, h)), f)
    qed
    have aq: AQ(a) by taut(qa, qb)
    have ao a1 a2 aqe := aq
    have ir := apply(mp.res_rng[c := c, A := A2, a := a], hc, hu, ha, a1, a2)
    have nq: !(int_le(q0, q) && int_lt(q, int_add(q0, k))) proof
      assume w
      have w1 w2 := w
      have _ n := mp(all_elim(off, {a}), ao, rewrite(sym(aqe), w1), rewrite(sym(aqe), w2))
      show by taut(n, ir)
    qed
    have c0: int_lt(0, A2.reserve_cnt) by arith(r1, r2)
    have _ px := mp(hrs4, c0)
    have mq _ := mp(all_elim(px, {q}), hq, hr)
    have ml _ := expand(mq, x86_64_linux.mapped)
    show by simp(mp(all_elim(gpg, {q}), hq, ml), nq)
  qed
  have hin7 := apply(mp.rng_holds[c := c, A := A2, vm := V4, V2 := V7, b := B1], hc, hu, ha, hh, hpr, hby, hrq, hbk, gt, gl)
  // outside the allocator: no page gone (theirs the allocator's)
  have r: all x0. x0 in omega -> (!(x0 in mallocng.footprint(c, A, B)) && !(x0 in R)) && x86_64_linux.mapped(V0, int_div(x0, x86_64_linux.PAGE)) ->
      (!abi.stack_free(V0, objs, x0) -> V7.bytes[bits_of_int(64, x0)] = V0.bytes[bits_of_int(64, x0)]) && V7.pages[int_div(x0, x86_64_linux.PAGE)] = V0.pages[int_div(x0, x86_64_linux.PAGE)] proof
    fix a
    assume hao hx
    have n1 n2 m0 := hx
    have b1 p1 := mp(all_elim(u1, {a}), hao, hx)
    have qo: int_div(a, x86_64_linux.PAGE) in omega by arith(hao, kp)
    have ng: !(int_le(q0, int_div(a, x86_64_linux.PAGE)) && int_lt(int_div(a, x86_64_linux.PAGE), int_add(q0, k))) proof
      assume w
      have w1 w2 := w
      have f _ := mp(all_elim(off, {a}), hao, w1, w2)
      show by taut(f, n1, n2)
    qed
    have m4: x86_64_linux.mapped(V4, int_div(a, x86_64_linux.PAGE)) by defs(simp(expand(m0, x86_64_linux.mapped), p1), x86_64_linux.mapped)
    have ml _ := expand(m4, x86_64_linux.mapped)
    have pe: V7.pages[int_div(a, x86_64_linux.PAGE)] = V4.pages[int_div(a, x86_64_linux.PAGE)] by simp(mp(all_elim(gpg, {int_div(a, x86_64_linux.PAGE)}), qo, ml), ng)
    have bb: !abi.stack_free(V0, objs, a) -> V7.bytes[bits_of_int(64, a)] = V0.bytes[bits_of_int(64, a)] proof
      assume hs
      show by simp(gby, mp(b1, hs))
    qed
    show by taut(bb, trans(pe, p1))
  qed
  have bk: mallocng.bounds_kept(V4, V7) by defs(taut(gt, gl, gs), mallocng.bounds_kept)
  have unt: mallocng.untouched(c, A, B, V0, V7, objs, R) by defs(taut(r, apply(mp.bk_trans, u2, bk)), mallocng.untouched)
  show by taut(hin7, unt)
qed

// ----------------------------------------------------------------------
//  __libc_free's run

// free's purpose (`libc_free_spec`) for p, the memory V after: the block
// given back -- the invariant on V without it (A2: no slot reserved, no
// meta taken), nothing outside the allocator and the block touched, the
// allocator grown only by the block
abbrev mp.lf_post(c, A, B, p, s, V) := ex A2. (A2 in mallocng.Abs && A2 in univ(1)) && (mallocng.no_reserved(A2) && seq_len(A2.taken) = 0) &&
  mallocng.holds_in(c, A2, V, s.objs, malloc.set_block(B, p, none)) && mallocng.untouched(c, A, B, s.vm, V, s.objs, malloc.range(p, snd(B[p]))) &&
  (all a. a in mallocng.footprint(c, A2, malloc.set_block(B, p, none)) -> a in mallocng.footprint(c, A, B) || a in malloc.range(p, snd(B[p])))

// a byte of the allocator's, or of a live block: in its ranges
theorem mp.lf_inr(c, A, M, B, brk, p, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> B in fn_space(bits(64), option(omega)) ->
  mallocng.holds(c, A, M, B, brk) -> p in bits(64) -> !(B[p] = none) -> a in omega ->
  (a in mallocng.footprint(c, A, B) || a in malloc.range(p, snd(B[p]))) -> mallocng.in_ranges(a, mallocng.fp_ranges(c, A))
proof
  assume hc hu ha hb H hp hn ho w
  have c1: a in mallocng.footprint(c, A, B) -> mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) by taut(apply(mp.fp_def[c := c, A := A, b := B, a := a]))
  have c2: a in malloc.range(p, snd(B[p])) -> mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) proof
    assume r
    have ex: ex q. q in bits(64) && (!(B[q] = none) && a in malloc.range(q, snd(B[q]))) by ex_intro({p}, taut(hp, hn, r))
    have l: a in malloc.live_of(B) by taut(apply(mp.live_def[b := B, a := a]), ho, ex)
    show := apply(mp.live_rng[c := c, A := A, M := M, b := B, brk := brk, a := a], hc, hu, ha, hb, H, l)
  qed
  show by taut(w, c1, c2)
qed

// errno's pages: kept by a step leaving all but the allocator's (and e's)
// untouched
theorem mp.err_pg(c, A, B, V0, V1, objs, fs, e): mallocng_specs.errno_apart(c, A, V0, fs) -> mallocng.untouched(c, A, B, V0, V1, objs, e) ->
  (all i. i in omega -> int_lt(i, 4) -> !(int_add(mallocng_specs.errno_at(fs), i) in e)) ->
  all i. i in omega -> int_lt(i, 4) ->
    V1.pages[int_div(int_add(mallocng_specs.errno_at(fs), i), x86_64_linux.PAGE)] = V0.pages[int_div(int_add(mallocng_specs.errno_at(fs), i), x86_64_linux.PAGE)]
proof
  assume hea hu he
  have ef := apply(mp.err_fp[c := c, A := A, b := B, vm := V0, fs := fs], hea)
  have u1 _ := expand(hu, mallocng.untouched)
  have eb: mallocng_specs.errno_at(fs) in bits(64) by defs(simp(), mallocng_specs.errno_at)
  fix i
  assume hi hil
  have nf m := mp(all_elim(ef, {i}), hi, hil)
  have _ pp := mp(all_elim(u1, {int_add(mallocng_specs.errno_at(fs), i)}), (int_add(mallocng_specs.errno_at(fs), i) in omega by arith(eb, hi)),
    taut(nf, mp(all_elim(he, {i}), hi, hil), m))
  show := pp
qed

// errno's location (a call's form: the memory as it was)
theorem mp.el_q2: all t regs o2. t in abi.World -> t in univ(1) -> int_le(int_add(t.fs_base, 56), int_pow(2, 64)) -> abi.thread_ok(t.vm, t.fs_base) ->
  gc.regs_ok(regs, empty) -> runs(mallocng_specs.errno_location_spec_fun[regs], t, o2) ->
  abi.ovf_out(t, o2) || (ex V r. (V in x86_64_linux.Vm && (V = t.vm && fst(r) = mallocng_specs.errno_at(t.fs_base))) && o2 = ok(fn_update(t, "vm", V), r))
proof
  fix t regs o2
  assume hw hu hf ht hr h
  have q := apply(ms.el_q, hw, hu, hr, conj(hf, ht), h)
  have {tv = mem} := apply(ms.world_parts, hw)
  have c2: (ex r. o2 = ok(fn_update(t, "vm", t.vm), r) && fst(r) = mallocng_specs.errno_at(t.fs_base)) ->
      (ex V r. (V in x86_64_linux.Vm && (V = t.vm && fst(r) = mallocng_specs.errno_at(t.fs_base))) && o2 = ok(fn_update(t, "vm", V), r)) proof
    assume e
    obtain r, ho he from e
    show by ex_intro({t.vm}, {r}, taut(tv, refl({t.vm}), he, ho))
  qed
  show by taut(q, c2)
qed

abbrev mp.lf_out(c, A, B, p, s, o) := ex V. (V in x86_64_linux.Vm && mp.lf_post(c, A, B, p, s, V)) && o = ok(fn_update(s, "vm", V), empty)

theorem mp.lf_run(c, gm, gsi, gst, gns, ac, acas, wl, nf, ul, el, mu, g0, g1, g2, p, s, h, o): c in mallocng.Cfg ->
  c.ctx = c_src_malloc_mallocng_malloc.__malloc_context -> c.sct = c_src_malloc_mallocng_malloc.__malloc_size_classes ->
  c.lock = c_src_malloc_mallocng_malloc.__malloc_lock -> c.libc = c_src_malloc_mallocng_malloc.__libc -> p in bits(64) ->
  s in abi.World -> h in mp.G ->
  mallocng.holds_in(c, h.A, s.vm, s.objs, h.blocks) -> mallocng.no_reserved(h.A) -> seq_len(h.A.taken) = 0 -> abi.thread_ok(s.vm, s.fs_base) ->
  mallocng_specs.tls_apart(c, h.A, s.fs_base) -> mallocng_specs.errno_ok(s.vm, s.objs, s.fs_base) -> mallocng_specs.errno_apart(c, h.A, s.vm, s.fs_base) ->
  (!(p = 0) -> !(h.blocks[p] = none)) ->
  mp.calls(gm, c_src_malloc_mallocng_malloc.get_meta_fun(g0, g1)) -> mp.calls(g1, c_src_malloc_mallocng_malloc.get_slot_index_fun()) ->
  mp.calls(gsi, c_src_malloc_mallocng_malloc.get_slot_index_fun()) -> mp.calls(gst, c_src_malloc_mallocng_malloc.get_stride_fun()) ->
  mp.calls(gns, c_src_malloc_mallocng_free.get_nominal_size_fun(g2)) -> mp.calls(wl, mallocng_specs.lock_spec_fun(c_src_malloc_mallocng_malloc.__libc)) ->
  mp.nf_call(c, nf, seq_len(h.A.used)) -> mp.calls(ul, mallocng_specs.unlock_spec_fun(c_src_malloc_mallocng_malloc.__malloc_lock)) ->
  mp.calls(el, mallocng_specs.errno_location_spec_fun) -> mp.calls(mu, mallocng_specs.munmap_spec_fun()) ->
  runs(c_src_malloc_mallocng_free.__libc_free(p, gm, gsi, gst, gns, ac, acas, wl, nf, ul, el, mu), s, o) ->
  abi.ovf_out(s, o) || (p = 0 && o = ok(s, empty)) ||
  (!(p = 0) && (ex V. V in x86_64_linux.Vm && mp.lf_post(c, h.A, h.blocks, p, s, V) && o = ok(fn_update(s, "vm", V), empty)))
proof
  assume hc hx hsct hlk hlc hp hs hh hin hnr htk hth htl heo hea hlv hgm hg1 hgsi hgst hgns hwl hnf hul hel hmu hr
  let A := h.A
  let B := h.blocks
  let V0 := s.vm
  let FP := mallocng.held(c, A, B)
  have ths: gc.sound(s) by simp(hth)
  have {hhm = mem, hsh = shown} := expand(hin, mallocng.holds_in)
  have hu0 _ hbt hat := mp(all_elim(mp.g_rec, {h}), hh)
  have au: A in univ(1) by simp(hu0)
  have su: s in univ(1) by simp(apply(g.runs_univ, expand(hr, c_src_malloc_mallocng_free.__libc_free)))
  have vV vfun vdom vb := apply(ms.world_parts, hs)
  step l1 l2 l3 l4 l5 l6 l7 l8 l9 l10 l11 l12 l13 l14 l15 x1, c1 from hr using conj(su, hp)
  have tb1 kx1 := c1
  // p = 0: nothing
  have z: case 1 of tb1 proof
    assume e
    have pz xe := e
    step oe from rewrite(xe, kx1)
    show by disj({2}, taut(pz, oe))
  qed
  have nz: case 2 of tb1 proof
    assume e
    have pnz xe := e
    have hbp := mp(hlv, pnz)
    have {H = inv} := expand(hhm, mallocng.holds_m)
    have {huo = used, hbl = in_slots} := expand(H, mallocng.holds)
    obtain k i, hk hi hkl hil hsl from mp(all_elim(expand(hbl, mallocng.blocks_ok), {p}), hp, hbp)
    let G := A.used[k]
    have iug: mallocng.is_used(A, G) by defs(ex_intro({k}, taut(hk, hkl, refl({G}))), mallocng.is_used)
    have sta: mallocng.starts_at(A, G, i, p) by defs(taut(iug, hil, (A.slots[G][i] = tag(1, p) || (ex h2. h2 in omega && (A.slots[G][i] = tag(2, h2) && A.metas[h2].mem = p))
      by disj({1}, hsl))), mallocng.starts_at)
    have cb0: all x0. x0 in omega -> int_le(A.metas[G].mem, x0) && int_lt(x0, p) -> !mallocng.in_reserved(A, x0) proof
      fix a
      assume _ _
      show := apply(mp.nores[A := A, a := a], hnr)
    qed
    have cbl: mallocng.clear_below(A, G, p) by defs(cb0, mallocng.clear_below)
    // get_meta(p), get_slot_index(p): p's slot's group and index
    have qgm: all regs o2. gc.regs_ok(regs, seq_one(gimple.arg(64, p))) -> runs(gm[regs], s, o2) ->
        abi.ovf_out(s, o2) || (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && fst(r) = G) proof
      fix regs o2
      assume hro h2
      have rl rn _ := hro
      have h3 := mp(all_elim(hgm, {regs}, {s}, {o2}), rl, (int_le(seq_len(regs), 6) by simp(rn)), hs, h2)
      have q := apply(mp.gm_q[c := c, regs := regs, s := s, h := h, p := p, o2 := o2, g := G, i := i, g0 := g0, g1 := g1], hc, hx, hsct, hp, hs, hh, hhm, hsh, cbl, hth, hi,
        sta, hg1, hro, h3)
      have k2: case 2 of q proof
        assume e2
        obtain r, e1r e2r e3r from e2
        show by disj({2}, ex_intro({r}, taut(e1r, (fst(r) = G by simp(e2r, e3r)))))
      qed
      show by taut(q, k2)
    qed
    have qgsi: all regs o2. gc.regs_ok(regs, seq_one(gimple.arg(64, p))) -> runs(gsi[regs], s, o2) ->
        abi.ovf_out(s, o2) || (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && bits_of_int(32, fst(r)) = i) proof
      fix regs o2
      assume hro h2
      have rl rn _ := hro
      have h3 := mp(all_elim(hgsi, {regs}, {s}, {o2}), rl, (int_le(seq_len(regs), 6) by simp(rn)), hs, h2)
      show := apply(mp.gsi_q, hc, hp, hs, hh, hhm, hsh, cbl, hi, sta, hro, h3)
    qed
    have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], vfun, vdom)
    step r1, e2 hR1 from rewrite(xe, kx1) with qgm using conj(hs, su, ths, hp, vV)
    step r2, e3 hR2 from rewrite(ss, e2) with qgsi using conj(hs, su, ths, hp, vV)
    // get_stride(g): the group's slot size
    have go g24 inr := apply(mp.meta_mem, hc, au, hat, hhm, iug)
    have top _ := apply(mp.meta_word, hc, au, hat, hhm, iug)
    have gb: G in bits(64) by arith(top, go)
    let ST := bits_of_int(64, mallocng.stride(A.metas[G]))
    have qgst: all regs o2. gc.regs_ok(regs, seq_one(gimple.arg(64, G))) -> runs(gst[regs], s, o2) ->
        abi.ovf_out(s, o2) || (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && fst(r) = ST) proof
      fix regs o2
      assume hro h2
      have rl rn _ := hro
      have h3 := mp(all_elim(hgst, {regs}, {s}, {o2}), rl, (int_le(seq_len(regs), 6) by simp(rn)), hs, h2)
      have q := apply(mp.gst_q[c := c, regs := regs, s := s, h := h, g := G, o2 := o2], hc, hsct, gb, hs, hh, hhm, hsh, iug, hro, h3)
      have k2: case 2 of q proof
        assume e2
        obtain r, e1r e2r e3r from e2
        show by disj({2}, ex_intro({r}, taut(e1r, (fst(r) = ST by simp(e2r, e3r)))))
      qed
      show by taut(q, k2)
    qed
    step r3, e4 hR3 from rewrite(ss, e3) with qgst using conj(hs, su, ths, gb, vV)
    // the meta's bytes: accessible
    have VSf := apply(mp.held_vis[c := c, A := A, objs := s.objs, b := B], hsh)
    have um: all x n2. x in omega -> n2 in omega -> int_le(G, x) -> int_le(int_add(x, n2), int_add(G, 40)) -> gimple.usable(V0, s.objs, x, n2, false) proof
      fix x n2
      assume hx0 hn2 hl hu
      have bj: all j. j in omega -> int_lt(j, n2) -> int_add(x, j) in FP && mallocng.m_mapped(mallocng.mview(V0, FP), int_add(x, j)) &&
          snd(mallocng.pg(mallocng.mview(V0, FP), int_add(x, j))).prot.r && !(snd(mallocng.pg(mallocng.mview(V0, FP), int_add(x, j))).kind = 2) proof
        fix j
        assume hj hjl
        have q1 q2 q3 := mp(all_elim(inr, {int_add(x, j)}), arith(hx0, hj), arith(hl, hj), arith(hu, hjl, hj))
        show by taut(q1, expand(q2, mallocng.m_rw), q3)
      qed
      show := apply(mp.view_usable[vm := V0, fp := FP, objs := s.objs, a := x, n := n2], hx0, bj, VSf)
    qed
    have gnz: !(G = 0) by arith(g24)
    have g16b: int_lt(int_add(G, 16), pow2(64)) by defs(arith(top), pow2)
    have md16: g.mem_defined(s, G, 16, 8, false) by simp(gnz, g16b, mp(all_elim(um, {int_add(G, 16)}, {8}), arith(go), simp(), arith(), arith()))
    step k5 from rewrite(ss, e4) with g.ld64_det using conj(su, gb, md16)
    // the slot's start and end: the code's arithmetic exact (the group's
    // bytes below the task size)
    have gok := apply(mp.used_group, huo, iug)
    have Go: G in omega by arith(go)
    have {gm = mem, gsto = stride, gss = start, gse = end, gnsl = nslots} := apply(mp.geo, hat, Go, gok)
    have {mim} := expand(gok, mallocng.group_ok)
    have {mmem = mem, mlast = last} := expand(mim, mallocng.meta_in_memory)
    have inm16: all j. j in omega -> int_lt(j, 8) -> int_add(int_add(G, 16), j) in FP proof
      fix j
      assume hj hjl
      have q1 _ _ := mp(all_elim(inr, {int_add(int_add(G, 16), j)}), arith(go, hj), arith(go, hj), arith(go, hj, hjl))
      show := q1
    qed
    have v16 := apply(mp.view_read[vm := V0, fp := FP, a := int_add(G, 16), n := 8], arith(go), simp(), arith(), inm16)
    have bo16 bl16 := mp(all_elim(g.bytes_bound, {V0}, {int_add(G, 16)}, {8}), vb, simp())
    have p8: int_pow(256, 8) = 18446744073709551616 by simp()
    have p64: int_pow(2, 64) = 18446744073709551616 by simp()
    have eMem: bits_of_int(64, gimple.bytes_at(V0, int_add(G, 16), 8)) = A.metas[G].mem by defs(arith(v16, mmem, bo16, bl16, p8, p64), bits_of_int, pow2)
    let S := mallocng.stride(A.metas[G])
    let E := mallocng.slot_end(A.metas[G], i)
    have sg := apply(mp.stride_ge, hat, Go, gok)
    have ie := apply(mp.end_in_group, hat, Go, hi, gok, hil)
    have tsz := apply(mp.grp_tsz_of, hc, au, hat, hhm)
    have ee := all_elim(gse, {i})
    have eo: E in omega by arith(ee, gm, gsto, hi, sg)
    have eb := mp(all_elim(tsz, {G}, {E}), iug, eo, ie)
    have i32: int_lt(i, 32) by arith(hil, gnsl, mlast)
    have ib: i in bits(32) by arith(hi, i32)
    have sx := apply(ms.sext_small, ib, arith(i32))
    have stv: ST = S := mp(bits_of_int_small[n := 64, a := S], gsto, (int_lt(S, pow2(64)) by defs(arith(ee, eb, gm, hi, sg), pow2)))
    have bm: bits_mul(64, S, i) = int_mul(S, i) by defs(arith(ee, eb, gm, hi, sg, gsto), bits_mul, pow2)
    have sm4: bits_add(64, S, bits_neg(64, 4)) = int_sub(S, 4) by defs(arith(sg, ee, eb, gm, hi), bits_add, bits_neg, pow2)
    have mb16: int_add(A.metas[G].mem, 16) in bits(64) by arith(ee, eb, gm, hi, sg, gsto)
    have smi: int_mul(S, i) in bits(64) by arith(ee, eb, gm, hi, sg, gsto)
    have sb4: int_sub(S, 4) in bits(64) by arith(ee, eb, gm, hi, sg, gsto)
    have stb: int_add(int_add(A.metas[G].mem, 16), int_mul(S, i)) in bits(64) by arith(ee, eb, gm, hi, sg, gsto)
    have meb: A.metas[G].mem in bits(64) by arith(ee, eb, gm, hi, sg, gsto)
    have sv16 := mp(all_elim(g.sval64_lit, {16}), simp(), simp())
    have svmi := mp(all_elim(g.sval64_lit, {int_mul(S, i)}), arith(smi), arith(ee, eb, gm, hi, sg, gsto))
    have svs4 := mp(all_elim(g.sval64_lit, {int_sub(S, 4)}), arith(sb4), arith(ee, eb, gm, hi, sg, gsto))
    have enb: E in bits(64) by arith(ee, eb, gm, hi, sg, gsto)
    have ee2: int_add(int_add(int_add(A.metas[G].mem, 16), int_mul(S, i)), int_sub(S, 4)) = E by arith(ee)
    let SVT := fn_update(fn_update(empty, "prec", 64), "signed", true)
    let ST0 := int_add(int_add(A.metas[G].mem, 16), int_mul(S, i))
    have nn1: int_le(0, int_add(int_add(A.metas[G].mem, 16), gimple.sval(SVT, int_mul(S, i)))) := rewrite(sym(svmi), (int_le(0, ST0) by arith(gm, hi, gsto)))
    have lt1: int_lt(int_add(int_add(A.metas[G].mem, 16), gimple.sval(SVT, int_mul(S, i))), pow2(64)) :=
      rewrite(sym(svmi), (int_lt(ST0, pow2(64)) by defs(arith(ee, eb, gm, hi, sg, gsto), pow2)))
    have nn2: int_le(0, int_add(ST0, gimple.sval(SVT, int_sub(S, 4)))) := rewrite(sym(svs4), (int_le(0, int_add(ST0, int_sub(S, 4))) by arith(gm, hi, gsto, sg)))
    have lt2: int_lt(int_add(ST0, gimple.sval(SVT, int_sub(S, 4))), pow2(64)) :=
      rewrite(sym(svs4), (int_lt(int_add(ST0, int_sub(S, 4)), pow2(64)) by defs(arith(ee, eb, gm, hi, sg, gsto), pow2)))
    step k6 from rewrite(eMem, k5) with g.padd_det, sx, stv, bm, sm4, sv16, svmi, svs4, ee2 using conj(su, meb, mb16, smi, sb4, stb, enb, nn1, lt1, nn2, lt2)
    // get_nominal_size(p, end): the block's size (its checks passed)
    have qgns: all regs o2. gc.regs_ok(regs, seq_concat(seq_one(gimple.arg(64, p)), seq_one(gimple.arg(64, E)))) -> runs(gns[regs], s, o2) ->
        abi.ovf_out(s, o2) || (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && fst(r) in bits(64)) proof
      fix regs o2
      assume hro h2
      have rl rn _ _ := apply(gc.regs2, hp, enb, hro)
      have h3 := mp(all_elim(hgns, {regs}, {s}, {o2}), rl, (int_le(seq_len(regs), 6) by simp(rn)), hs, h2)
      have q := apply(mp.gns_q[c := c, regs := regs, s := s, h := h, p := p, e := E, o2 := o2, g := G, i := i, g0 := g2], hc, hp, enb, hs, hh, hhm, hsh, hnr, iug, hi,
        hil, hsl, refl({E}), hro, h3)
