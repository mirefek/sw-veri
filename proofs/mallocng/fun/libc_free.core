    step r4, e7 hR4 from k6 with qgns using conj(hs, su, ths, hp, enb, vV)
    // the self bit, the last index (the meta's word), the header marks
    have o32: bits_of_int(32, 1) in bits(32) by simp()
    have g32b: int_lt(int_add(G, 32), pow2(64)) by defs(arith(top), pow2)
    have md32: g.mem_defined(s, G, 32, 1, false) by simp(gnz, g32b, mp(all_elim(um, {int_add(G, 32)}, {1}), arith(go), simp(), arith(), arith()))
    have {s1 = start, e1 = fits, n1 = size} := apply(mp.blk_frame, hat, hbt, H, iug, hi, hil, hsl, (p in omega by arith(hp)))
    have ss1 := all_elim(gss, {i})
    have p16: int_le(16, p) by arith(ss1, s1, gm, gsto, hi)
