    have lt3: int_lt(int_add(p, gimple.sval(SVT, bits_neg(64, 3))), pow2(64)) := rewrite(sym(pm3), (int_lt(int_sub(p, 3), pow2(64)) by defs(arith(hp), pow2)))
    have nn2: int_le(0, int_add(p, gimple.sval(SVT, bits_neg(64, 2)))) := rewrite(sym(pm2), (int_le(0, int_sub(p, 2)) by arith(p16)))
    have lt2: int_lt(int_add(p, gimple.sval(SVT, bits_neg(64, 2))), pow2(64)) := rewrite(sym(pm2), (int_lt(int_sub(p, 2), pow2(64)) by defs(arith(hp), pow2)))
    have uw3 := apply(mp.bhdr_usable[c := c, A := A, vm := V0, b := B, objs := s.objs, g := G, i := i, p := p, a := int_sub(p, 3), n := 1], hc, au, hat, hbt, hhm, hsh,
