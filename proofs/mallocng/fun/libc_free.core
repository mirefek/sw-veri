    have pg4: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
    have k02r: all x0. x0 in omega -> (!(x0 in mallocng.footprint(c, A, B)) && !(x0 in empty)) && x86_64_linux.mapped(V0, int_div(x0, x86_64_linux.PAGE)) ->
