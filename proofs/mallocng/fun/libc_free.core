    let ALL := bits_add(32, bits_shl(32, bits_of_int(32, 2), bits_of_int(5, int_mod(int_div(gimple.bytes_at(V0, int_add(G, 32), 1), int_pow(2, 0)), int_pow(2, 5)))),
