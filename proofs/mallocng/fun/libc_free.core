    let V2a := fn_update(V0, "bytes", x86_64_linux.store_le(x86_64_linux.store_le(V0.bytes, int_add(int_sub(p, 3), 0), 1, bits_neg(8, 1)), int_add(int_sub(p, 2), 0), 2, 0))
    let S2 := fn_update(s, "vm", V2a)
    have v1v: V1a in x86_64_linux.Vm := mp(all_elim(ms.wr_any, {V0}, {int_add(int_sub(p, 3), 0)}, {1}, {bits_neg(8, 1)}), vV)
    have v2v: V2a in x86_64_linux.Vm by simp(mp(all_elim(ms.wr_any, {V1a}, {int_add(int_sub(p, 2), 0)}, {2}, {0}), v1v))
    have w1W w1u := apply(mp.am_world, hs, su, v1v)
    have b10: fn_update(V1a, "bytes", V0.bytes) = V0 by simp(mp(fn_update_same[f := V0, k := "bytes"], simp(vV), simp(vV)))
    have b20: fn_update(V2a, "bytes", V0.bytes) = V0 by simp(mp(fn_update_same[f := V0, k := "bytes"], simp(vV), simp(vV)))
    have uw2 := apply(mp.bhdr_usable[c := c, A := A, vm := V0, b := B, objs := s.objs, g := G, i := i, p := p, a := int_sub(p, 2), n := 2], hc, au, hat, hbt, hhm, hsh,
