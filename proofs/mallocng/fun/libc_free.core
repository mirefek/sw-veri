    step k8 from rewrite(ss, e7) with ms.shl32_det, g.ldbf_det, g.padd_det, pm3, pm2, ms.st8_det using conj(hs, su, o32, hi, i32, gb, md32, hp, nn3, lt3, nn2, lt2, p3b, md3w)
    // (the memory after the first mark, after the second)
