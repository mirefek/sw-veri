    let FP1 := mallocng.held(c, A1, B1)
    have b1t := apply(mp.uf_btype[b := B, p := p], hbt)
    have _ _ inr1 := apply(mp.meta_mem, hc, a1u, a1a, hm1, iu1)
    have VS1 := apply(mp.held_vis[c := c, A := A1, objs := s.objs, b := B1], sh1)
    have _ _ _ vb2s := apply(ms.world_parts, w2W)
    have vb2: V2a.bytes in fn_space(bits(64), bits(8)) by simp(vb2s)
    have um1: all x n2. x in omega -> n2 in omega -> int_le(G, x) -> int_le(int_add(x, n2), int_add(G, 40)) -> gimple.usable(V2a, s.objs, x, n2, false) proof
