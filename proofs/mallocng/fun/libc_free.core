          have lt5: int_lt(int_add(ST0, gimple.sval(SVT, X8)), pow2(64)) := rewrite(sym(svx), (int_lt(BASE, pow2(64)) by defs(arith(ee, eb, gm, hi, sg, gsto, x8l), pow2)))
          have x8bb: X8 in bits(64) by arith(x8o, x8l)
          have bsb: BASE in bits(64) by arith(ee, eb, gm, hi, sg, gsto, x8l, x8o)
