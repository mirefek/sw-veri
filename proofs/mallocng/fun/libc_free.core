    have v24 := apply(mp.view_read[vm := V2a, fp := FP1, a := int_add(G, 24), n := 4], arith(go), simp(), arith(), mp(all_elim(inm1, {24}, {4}), simp(), simp(), simp()))
    have v28 := apply(mp.view_read[vm := V2a, fp := FP1, a := int_add(G, 28), n := 4], arith(go), simp(), arith(), mp(all_elim(inm1, {28}, {4}), simp(), simp(), simp()))
