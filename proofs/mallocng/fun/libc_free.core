    have uw2b := apply(mp.usable_bytes[v := V0, v2 := V1a, objs := s.objs, a := int_sub(p, 2), n := 2, w := true], b10, uw2)
    have p2b: int_sub(p, 2) in bits(64) by arith(hp, p16)
    have md2w: g.mem_defined(S1, int_sub(p, 2), 0, 2, true) by simp((!(int_sub(p, 2) = 0) by arith(p16)), (int_lt(int_sub(p, 2), pow2(64)) by defs(arith(hp), pow2)), uw2b)
    step k9 from k8 with ms.st16_det using conj(w1W, w1u, p2b, md2w)
