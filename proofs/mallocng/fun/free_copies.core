// free.c's copies of malloc.c's static functions (meta.h's, one per
// translation unit): each copy's code implementing the same purpose spec,
// from the same proof, by its own C1 (`c1 P`: `THM_implements_P`).

contract get_meta mallocng_specs.get_meta_spec_fun by mp.gm c1 fgmtc
contract dequeue mallocng_specs.dequeue_spec_fun by mp.dq c1 fdqtc
contract queue mallocng_specs.queue_spec_fun by mp.qu c1 fqutc
contract free_meta mallocng_specs.free_meta_spec_fun by mp.fm c1 ffmtc
contract activate_group mallocng_specs.activate_group_spec_fun by mp.ag c1 fagtc call mp.ag_call
contract get_stride mallocng_specs.get_stride_spec_fun by mp.gst c1 fgstc
contract step_seq mallocng_specs.counters_spec_fun0 by mp.sq c1 fsstc call mp.sq_call
contract is_bouncing mallocng_specs.is_bouncing_spec_fun by mp.ib c1 fibtc call mp.ib_call
contract wrlock mallocng_specs.lock_spec_fun by mp.wrl c1 fwrlc
contract unlock mallocng_specs.unlock_spec_fun by mp.unl c1 funlc
