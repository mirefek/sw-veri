// __init_ssp by its purpose (startup_specs.init_ssp_spec): the stack
// protector's guard from AT_RANDOM's bytes (memcpy) or, without them, from
// its own address; its low byte zeroed; the guard into the thread's
// descriptor (the canary at fs + 40). Nothing changed but the guard and
// the static TLS area; the thread kept set up.

// ----------------------------------------------------------------------
//  The calls

// __get_tp (this unit's copy) at a call, the thread sound: the thread
// pointer returned, the memory as it was
theorem sp.gtp_q: all regs s o2. s in abi.World -> s in univ(1) -> gc.regs_ok(regs, empty) -> abi.thread_ok(s.vm, s.fs_base) ->
  runs(c_src_env___stack_chk_fail.__get_tp_fun()[regs], s, o2) ->
  abi.ovf_out(s, o2) ||
  (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && fst(r) = s.fs_base)
proof
  fix regs s o2
  assume hw hu hr ht h
  let FS := s.fs_base
  have rl rn := apply(gc.regs0, hr)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, c_src_env___stack_chk_fail.__get_tp_fun, app_fn_build, ra in h
  have pv pf pd pb := apply(ms.world_parts, hw)
  have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], pf, pd)
  have fsw: FS in bits(64) by simp(expand(hw, abi.World))
  have b := apply(g.runs_elim, h)
  obtain o3, hs3 hk3 from expand(b, bind_rel)
  step x2 x4, e3 from hs3 with ms.tp_det using conj(hw, hu, ht)
  have k1: bind_rel(gimple.result(64, FS), s, x6 x7. any_rel(x8. x8 in bits(64), x8. o2 = ok(x6, pair(x7, x8))), x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))
    by simp(expand(rewrite(e3, hk3), letin), keep(bind_rel, gimple.result))
  obtain o4, hr4 hk4 from expand(k1, bind_rel)
  have ho4 := apply(g.result64_inv, fsw, hr4)
  have k2: any_rel(x8. x8 in bits(64), x8. o2 = ok(s, pair(FS, x8))) by simp(rewrite(ho4, hk4), keep(any_rel))
  have ne: ex y. y in bits(64) by ex_intro({0}, simp())
  obtain y, hy hoy from apply(g.any_e, ne, k2)
  have hoy2: o2 = ok(fn_update(s, "vm", s.vm), pair(FS, y)) by simp(hoy, ss)
  have l: ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && fst(r) = FS by ex_intro({pair(FS, y)}, taut(hoy2, (fst(pair(FS, y)) = FS by simp())))
  show by taut(l)
qed

// (a call of one result before main: call0's, its first register)
theorem sp.call1_0_e: all g args w o. runs(gimple.call1_0(g, args), w, o) ->
  ex o2. runs(gimple.call0(g, args), w, o2) &&
    ((ex w2 r. o2 = ok(w2, r) && o = ok(w2, fst(r))) || (ex x e. o2 = exc(x, e) && o = exc(x, e)) || (ex t. o2 = diverge(t) && o = diverge(t)))
proof
  fix g args w o
  assume h
  rsimp only, gimple.call1_0 in h
  have b := apply(g.runs_elim, h)
  show := expand(b, bind_rel, letin)
qed

// ----------------------------------------------------------------------
//  __init_ssp's run

// its outcomes: an overflow, or the memory within the frame (the guard,
// the static TLS area), the thread still set up
abbrev sp.ssp_out(g, s, o) := abi.ovf_out(s, o) ||
  (ex V. ((V in x86_64_linux.Vm && startup_specs.frame(s.vm, V, s.objs, startup_specs.ssp_writes(g))) && startup_specs.thread_set(V, s.fs_base)) &&
    o = ok(fn_update(s, "vm", V), empty))

// (the thread kept set up: its first word and its id unchanged)
theorem sp.ts_keep: all vm X fs. startup_specs.thread_set(vm, fs) -> x86_64_linux.le(X, fs, 8) = x86_64_linux.le(vm.bytes, fs, 8) ->
  fs in bits(64) -> int_lt(int_add(fs, 48), 18446744073709551616) ->
  gimple.bytes_at(fn_update(vm, "bytes", X), int_add(fs, 48), 4) = gimple.bytes_at(vm, int_add(fs, 48), 4) ->
  startup_specs.thread_set(fn_update(vm, "bytes", X), fs)
proof
  fix vm X fs
  assume h he hfb hfl hid
  have e48: bits_add(64, fs, 48) = int_add(fs, 48) by defs(arith(hfb, hfl), bits_add, bits_of_int, pow2)
  have tok cok tid0 := expand(h, startup_specs.thread_set)
  have tid: !(gimple.bytes_at(vm, int_add(fs, 48), 4) = 0) by simp(e48, tid0)
  have t2 := apply(ms.thread_keep, {vm}, {X}, {fs}, tok, he)
  have hx := expand(cok, abi.canary_ok, x86_64_linux.readable, abi.stack_page, x86_64_linux.mapped)
  have c2: abi.canary_ok(fn_update(vm, "bytes", X), fs) by defs(simp(hx), abi.canary_ok, x86_64_linux.readable, abi.stack_page, x86_64_linux.mapped)
  have i2: !(gimple.bytes_at(fn_update(vm, "bytes", X), bits_add(64, fs, 48), 4) = 0) by simp(e48, hid, tid)
  show by defs(taut(t2, c2, i2), startup_specs.thread_set)
qed

// (a byte of the guard or of the descriptor's area: startup's, and
// __init_ssp's)
theorem sp.ssw_g: all g x. x in omega -> int_le(g.stack_chk_guard, x) -> int_lt(x, int_add(g.stack_chk_guard, 8)) ->
  x in startup_specs.start_writes(g) && x in startup_specs.ssp_writes(g)
proof
  fix g x
  assume xo h1 h2
  have s1 := apply(sp.in_span, {g.stack_chk_guard}, {8}, {x}, xo, h1, h2)
  have a: x in startup_specs.start_writes(g) by defs(sel(taut(xo, s1)), startup_specs.start_writes)
  have b: x in startup_specs.ssp_writes(g) by defs(sel(taut(xo, s1)), startup_specs.ssp_writes)
  show by taut(a, b)
qed

theorem sp.ssw_b: all g x. x in omega -> int_le(g.builtin_tls, x) -> int_lt(x, int_add(g.builtin_tls, 336)) ->
  x in startup_specs.start_writes(g) && x in startup_specs.ssp_writes(g)
proof
  fix g x
  assume xo h1 h2
  have s1 := apply(sp.in_span, {g.builtin_tls}, {336}, {x}, xo, h1, h2)
  have a: x in startup_specs.start_writes(g) by defs(sel(taut(xo, s1)), startup_specs.start_writes)
  have b: x in startup_specs.ssp_writes(g) by defs(sel(taut(xo, s1)), startup_specs.ssp_writes)
  show by taut(a, b)
qed

// (n bytes at a among startup's writes: usable, by globals_ok)
theorem sp.glob_usable: all g vm o a n. startup_specs.globals_ok(vm, o, g) -> a in omega ->
  (all x. x in omega -> int_le(a, x) -> int_lt(x, int_add(a, n)) -> x in startup_specs.start_writes(g)) -> gimple.usable(vm, o, a, n, true) && gimple.usable(vm, o, a, n, false)
proof
  fix g vm o a n
  assume hg ha hs
  have hall _ _ _ := expand(hg, startup_specs.globals_ok)
  have ut: all i. i in omega -> int_lt(i, n) -> gimple.usable(vm, o, int_add(a, i), 1, true) proof
    fix i
    assume hi hil
    have u1 _ _ _ _ _ := mp(all_elim(hall, {int_add(a, i)}), arith(ha, hi), mp(all_elim(hs, {int_add(a, i)}), arith(ha, hi), arith(ha, hi), arith(hil)))
    show := u1
  qed
  have uf: all i. i in omega -> int_lt(i, n) -> gimple.usable(vm, o, int_add(a, i), 1, false) proof
    fix i
    assume hi hil
    have _ u2 _ _ _ _ := mp(all_elim(hall, {int_add(a, i)}), arith(ha, hi), mp(all_elim(hs, {int_add(a, i)}), arith(ha, hi), arith(ha, hi), arith(hil)))
    show := u2
  qed
  show by taut(apply(sp.usable_of_bytes[vm := vm, o := o, a := a, n := n, wr := true], ha, ut), apply(sp.usable_of_bytes[vm := vm, o := o, a := a, n := n, wr := false], ha, uf))
qed

// (a memory as itself: within any frame)
theorem sp.fr_self(b, objs, W): b in x86_64_linux.Vm -> startup_specs.frame(b, b, objs, W)
proof
  assume hb
  have vf: is_fun(b) && "bytes" in dom(b) by simp(hb)
  have f1 := mp(fn_update_same[f := b, k := "bytes"], taut(vf), taut(vf))
  show by defs(taut(f1, (all x. x in bits(64) -> !(x in W) -> !abi.stack_free(b, objs, x) -> b.bytes[x] = b.bytes[x] by simp())), startup_specs.frame)
qed

// ----------------------------------------------------------------------
//  The common tail: the guard's low byte zeroed, the thread pointer, the
//  canary stored

theorem sp.ssp_tail(s1. K, s1 e. X, t. D): all g GT s U. s in abi.World -> s in univ(1) -> U in x86_64_linux.Vm -> fn_update(U, "bytes", s.vm.bytes) = s.vm ->
  g.stack_chk_guard = c_src_env___stack_chk_fail.__stack_chk_guard -> g.builtin_tls = c_src_env___init_tls.builtin_tls ->
  startup_specs.frame(s.vm, U, s.objs, startup_specs.ssp_writes(g)) -> startup_specs.thread_set(U, s.fs_base) -> startup_specs.in_tls(g, s.fs_base) ->
  startup_specs.globals_ok(s.vm, s.objs, g) -> mp.calls(GT, c_src_env___stack_chk_fail.__get_tp_fun()) ->
  bind_rel(gimple.padd(c_src_env___stack_chk_fail.__stack_chk_guard, 1), fn_update(s, "vm", U), x3 x4. letin(x4, x5. bind_rel(gimple.st8(x5, 0, 0), x3,
    x6 x7. bind_rel(gimple.call1_0(GT, empty), x6, x8 x9. letin(x9, x10. letin(x10, x11. bind_rel(gimple.ld64(c_src_env___stack_chk_fail.__stack_chk_guard, 0), x8,
    x12 x13. letin(x13, x14. bind_rel(c_src_env___stack_chk_fail.set___pthread_canary(x11, x14), x12, x15 x16. K(x15), x15 x16. X(x15, x16), x15. D(x15))),
    x12 x13. X(x12, x13), x12. D(x12)))), x8 x9. X(x8, x9), x8. D(x8)), x6 x7. X(x6, x7), x6. D(x6))), x3 x4. X(x3, x4), x3. D(x3)) ->
  (ex v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && X(fn_update(fn_update(s, "vm", v), "objs", ob), exc_val("stack_overflow", empty))) ||
  (ex V. ((V in x86_64_linux.Vm && startup_specs.frame(s.vm, V, s.objs, startup_specs.ssp_writes(g))) && startup_specs.thread_set(V, s.fs_base)) && K(fn_update(s, "vm", V)))
proof
  fix g GT s U
  assume hw hu hU hUb hgG hgB hfr hts hit hglob hGT h
  let GD := c_src_env___stack_chk_fail.__stack_chk_guard
  let FS := s.fs_base
  let SSW := startup_specs.ssp_writes(g)
  let OVF := exc_val("stack_overflow", empty)
  let W := fn_update(s, "vm", U)
  let T64 := fn_update(fn_update(empty, "prec", 64), "signed", true)
  have wW wu := apply(mp.am_world[s := s, V := U], hw, hu, hU)
  have _ wf wd wb := apply(ms.world_parts, wW)
  have gdb: GD in bits(64) by defs(simp(), c_src_env___stack_chk_fail.__stack_chk_guard)
  have gdv: GD = 4227112 by defs(refl({4227112}), c_src_env___stack_chk_fail.__stack_chk_guard)
  have btv: c_src_env___init_tls.builtin_tls = 4228288 by defs(refl({4228288}), c_src_env___init_tls.builtin_tls)
  have fsb: FS in bits(64) by simp(expand(hw, abi.World))
  have it1 it2 := expand(hit, startup_specs.in_tls)
  have fsr: int_le(4228288, FS) && int_le(int_add(FS, 200), 4228624) by arith(it1, it2, hgB, btv)
  have tok _ _ := expand(hts, startup_specs.thread_set)
  have _ _ _ fnz := expand(tok, abi.thread_ok)
  // (what was usable at the entry: usable in a memory as the entry's but
  // for bytes)
  have uK: all M a n wr. fn_update(M, "bytes", s.vm.bytes) = s.vm -> gimple.usable(s.vm, s.objs, a, n, wr) -> gimple.usable(M, s.objs, a, n, wr) proof
    fix M a n wr
    assume hm h0
    show := apply(mp.usable_bytes[v := s.vm, v2 := M, objs := s.objs, a := a, n := n, w := wr], hm, h0)
  qed
  // the guard's low byte: GD + 1
  have sv1: gimple.sval(T64, 1) = 1 by defs(simp(), gimple.sval)
  have pd := apply(g.padd_det, {W}, {GD}, {1}, wu, gdb, simp(), arith(sv1, gdv), defs(arith(sv1, gdv), pow2))
  let P1 := int_add(GD, gimple.sval(T64, 1))
  have p1e: P1 = int_add(GD, 1) by simp(sv1)
  have p1b: P1 in bits(64) by arith(p1e, gdv)
  // (the guard's bytes, the descriptor's: startup's and __init_ssp's writes)
  have rG: all x. x in omega -> int_le(GD, x) -> int_lt(x, int_add(GD, 8)) -> x in startup_specs.start_writes(g) && x in SSW proof
    fix x
    assume xo h1 h2
    show := apply(sp.ssw_g, {g}, {x}, xo, arith(hgG, h1), arith(hgG, h2))
  qed
  have rB: all x. x in omega -> int_le(FS, x) -> int_lt(x, int_add(FS, 200)) -> x in startup_specs.start_writes(g) && x in SSW proof
    fix x
    assume xo h1 h2
    show := apply(sp.ssw_b, {g}, {x}, xo, arith(hgB, btv, fsr, h1), arith(hgB, btv, fsr, h2))
  qed
  have rG1: all x. x in omega -> int_le(int_add(GD, 1), x) -> int_lt(x, int_add(int_add(GD, 1), 1)) -> x in startup_specs.start_writes(g) proof
    fix x
    assume xo h1 h2
    have a _ := mp(all_elim(rG, {x}), xo, arith(h1), arith(h2))
    show := a
  qed
  have ug1 _ := apply(sp.glob_usable, {g}, {s.vm}, {s.objs}, {int_add(GD, 1)}, {1}, hglob, arith(gdv), rG1)
  have u1 := mp(all_elim(uK, {U}, {int_add(GD, 1)}, {1}, {true}), hUb, ug1)
  have md1: g.mem_defined(W, P1, 0, 1, true) by simp(p1e, gdv, u1)
  have wv: W.vm in x86_64_linux.Vm by simp(hU)
  step h1 from h with pd, g.st8_det using conj(wu, p1b, md1, wv, wf, wd)
  // the thread pointer (__get_tp's)
  let U5 := fn_update(U, "bytes", x86_64_linux.store_le(U.bytes, int_add(P1, 0), 1, 0))
  let W5 := fn_update(s, "vm", U5)
  have u5V := apply(ms.wr_any, {U}, {int_add(P1, 0)}, {1}, {0}, hU)
  have w5W w5u := apply(mp.am_world[s := s, V := U5], hw, hu, u5V)
  have _ w5f w5d _ := apply(ms.world_parts, w5W)
  have u5b: fn_update(U5, "bytes", s.vm.bytes) = s.vm := trans(fn_update_twice[f := U, k := "bytes", a := x86_64_linux.store_le(U.bytes, int_add(P1, 0), 1, 0), b := s.vm.bytes], hUb)
  // (the thread: its first word apart from the guard's)
  have ub: U.bytes in fn_space(bits(64), bits(8)) by simp(wb)
  have u5t: U5.bytes in fn_space(bits(64), bits(8)) by simp(apply(x86.store_typed, {U.bytes}, {int_add(P1, 0)}, {1}, {0}, ub))
  have l1 := apply(x86.le8_nat, {U5}, {FS}, u5t)
  have l2 := apply(x86.le8_nat, {U}, {FS}, ub)
  have bq: gimple.bytes_at(U5, FS, 8) = gimple.bytes_at(U, FS, 8) by mem(p1e, gdv, fsr, fsb)
  have leq: x86_64_linux.le(x86_64_linux.store_le(U.bytes, int_add(P1, 0), 1, 0), FS, 8) = x86_64_linux.le(U.bytes, FS, 8) by simp(l1, l2, bq)
  have bi5: gimple.bytes_at(U5, int_add(FS, 48), 4) = gimple.bytes_at(U, int_add(FS, 48), 4) by mem(p1e, gdv, fsr, fsb)
  have ts5 := apply(sp.ts_keep, {U}, {x86_64_linux.store_le(U.bytes, int_add(P1, 0), 1, 0)}, {FS}, hts, leq, fsb, arith(fsr), bi5)
  have tok5 _ _ := expand(ts5, startup_specs.thread_set)
  have tw5: abi.thread_ok(W5.vm, W5.fs_base) by simp(tok5)
  obtain oc, hrc hdc from apply(g.bind_open, h1)
  obtain o2c, hc0 hrel from apply(sp.call1_0_e, hrc)
  let QG(o2) := abi.ovf_out(W5, o2) || (ex r. o2 = ok(fn_update(W5, "vm", W5.vm), r) && fst(r) = FS)
  have hq: all regs o2. gc.regs_ok(regs, empty) -> runs(GT[regs], W5, o2) -> QG(o2) proof
    fix regs o2
    assume hro hg
    have rl rn := apply(gc.regs0, hro)
    have lo: seq_len(regs) in omega by simp(rl)
    have hs := mp(all_elim(hGT, {regs}, {W5}, {o2}), rl, arith(rn, lo), w5W, hg)
    have r := apply(sp.gtp_q, {regs}, {W5}, {o2}, w5W, w5u, hro, tw5, hs)
    show by simp(r)
  qed
  have ci := apply(gc.call0_inv[Q := o2. QG(o2)], {GT}, {empty}, {W5}, {o2c}, gc.regs0_ex, hq, hc0)
  // (an exception of the call: the tail's)
  have hX: all Y E. oc = exc(Y, E) -> X(Y, E) proof
    fix Y E
    assume he
    have c1: (ex s1 v. oc = ok(s1, v) && true) -> false proof
      assume e1
      obtain s1 v, e2 _ from e1
      have ne: !(ok(s1, v) = exc(Y, E)) by defs(simp(), ok, exc)
      show by taut(ne, trans(sym(e2), he))
    qed
    have c3: (ex t. oc = diverge(t)) -> false proof
      assume e1
      obtain t, e2 from e1
      have ne: !(diverge(t) = exc(Y, E)) by defs(simp(), diverge, exc)
      show by taut(ne, trans(sym(e2), he))
    qed
    have hd2 := rewrite(he, hdc)
    show by simp(hd2, c1, c3)
  qed
  let G := (ex v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && X(fn_update(fn_update(s, "vm", v), "objs", ob), OVF)) ||
    (ex V. ((V in x86_64_linux.Vm && startup_specs.frame(s.vm, V, s.objs, SSW)) && startup_specs.thread_set(V, FS)) && K(fn_update(s, "vm", V)))
  have _ pf _ _ := apply(ms.world_parts, hw)
  have od: "objs" in dom(s) by simp(expand(hw, abi.World))
  have sob: s.objs in abi.Objs by simp(expand(hw, abi.World))
  have w5e: W5 = fn_update(fn_update(s, "vm", U5), "objs", s.objs) by simp(pf, od)
  have oW5: X(W5, OVF) -> G proof
    assume xw
    show by taut((ex v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && X(fn_update(fn_update(s, "vm", v), "objs", ob), OVF) by ex_intro({U5}, {s.objs}, taut(u5V, sob, rewrite(w5e, xw)))))
  qed
  // an overflow at the call
  have ca: o2c = exc(W5, OVF) -> G proof
    assume e
    have oe: oc = exc(W5, OVF) by simp(rewrite(e, hrel))
    show := mp(oW5, mp(all_elim(hX, {W5}, {OVF}), oe))
  qed
  // an overflow in the callee
  have cc: (ex x e. QG(exc(x, e)) && o2c = exc(x, e)) -> G proof
    assume q
    obtain x e, hq2 he from q
    have nk: !(ex r. exc(x, e) = ok(fn_update(W5, "vm", W5.vm), r) && fst(r) = FS) by defs(simp(), ok, exc)
    have ov: abi.ovf_out(W5, exc(x, e)) by taut(hq2, nk)
    obtain v ob, hv hob hxe from ov
    have oe: oc = exc(x, e) by simp(rewrite(he, hrel))
    have xx := mp(all_elim(hX, {x}, {e}), oe)
    have xe: x = fn_update(fn_update(s, "vm", v), "objs", ob) by simp(hxe)
    have ee: e = OVF by simp(hxe)
    have x2: X(fn_update(fn_update(s, "vm", v), "objs", ob), OVF) := rewrite(ee, rewrite(xe, xx))
    show by taut((ex v2 ob2. (v2 in x86_64_linux.Vm && ob2 in abi.Objs) && X(fn_update(fn_update(s, "vm", v2), "objs", ob2), OVF) by ex_intro({v}, {ob}, taut(hv, hob, x2))))
  qed
  // (no divergence)
  have cd: (ex t. QG(diverge(t)) && o2c = diverge(t)) -> G proof
    assume q
    obtain t, hq2 _ from q
    show by defs(simp(hq2), ok, exc, diverge)
  qed
  // the thread pointer returned
  have cb: (ex w4 r. QG(ok(w4, r)) && (o2c = ok(gc.back0(w4, W5), pair(fst(r), snd(r))) || o2c = exc(gc.back0(w4, W5), OVF))) -> G proof
    assume q
    obtain w4 r, hq4 ho4 from q
    have no: !abi.ovf_out(W5, ok(w4, r)) by defs(simp(), ok, exc)
    have q2: ex r2. ok(w4, r) = ok(fn_update(W5, "vm", W5.vm), r2) && fst(r2) = FS by taut(hq4, no)
    obtain r2, e42 f2 from q2
    have ss5: fn_update(W5, "vm", W5.vm) = W5 := mp(fn_update_same[f := W5, k := "vm"], w5f, w5d)
    have w4e: w4 = W5 by simp(e42, ss5)
    have re: fst(r) = FS by simp(e42, f2)
    have os5 := apply(gc.objs_same, w5W)
    have od5: "objs" in dom(W5) by simp(expand(w5W, abi.World))
    have fo5 := mp(fn_update_same[f := W5, k := "objs"], w5f, od5)
    have bk: gc.back0(w4, W5) = W5 by simp(w4e, os5, fo5, pf, od)
    have k2: o2c = exc(gc.back0(w4, W5), OVF) -> G proof
      assume e
      have oe: oc = exc(W5, OVF) by simp(bk, rewrite(e, hrel))
      show := mp(oW5, mp(all_elim(hX, {W5}, {OVF}), oe))
    qed
    have k1: o2c = ok(gc.back0(w4, W5), pair(fst(r), snd(r))) -> G proof
      assume e
      have oe: oc = ok(W5, FS) by simp(bk, re, rewrite(e, hrel))
      // the guard read (its bytes startup's)
      have rG0: all x. x in omega -> int_le(GD, x) -> int_lt(x, int_add(GD, 8)) -> x in startup_specs.start_writes(g) proof
        fix x
        assume xo h1 h2
        have a _ := mp(all_elim(rG, {x}), xo, h1, h2)
        show := a
      qed
      have _ ug8 := apply(sp.glob_usable, {g}, {s.vm}, {s.objs}, {GD}, {8}, hglob, arith(gdv), rG0)
      have u8 := mp(all_elim(uK, {U5}, {GD}, {8}, {false}), u5b, ug8)
      have md2: g.mem_defined(W5, GD, 0, 8, false) by simp(gdv, u8)
      step h2 from rewrite(oe, hdc) with g.ld64_det using conj(w5u, gdb, md2)
      // the canary: the guard at fs + 40, in the static TLS area
      unfold c_src_env___stack_chk_fail.set___pthread_canary in h2
      let VAL := bits_of_int(64, gimple.bytes_at(U5, int_add(GD, 0), 8))
      have rB0: all x. x in omega -> int_le(int_add(FS, 40), x) -> int_lt(x, int_add(int_add(FS, 40), 8)) -> x in startup_specs.start_writes(g) proof
        fix x
        assume xo h1 h2
        have a _ := mp(all_elim(rB, {x}), xo, arith(fsb, h1), arith(h2))
        show := a
      qed
      have ub8 _ := apply(sp.glob_usable, {g}, {s.vm}, {s.objs}, {int_add(FS, 40)}, {8}, hglob, arith(fsb), rB0)
      have u40 := mp(all_elim(uK, {U5}, {int_add(FS, 40)}, {8}, {true}), u5b, ub8)
      have md3: g.mem_defined(W5, FS, 40, 8, true) by simp(fnz, u40, (int_lt(int_add(FS, 40), pow2(64)) by defs(arith(fsr), pow2)))
      have w5v: W5.vm in x86_64_linux.Vm by simp(u5V)
      step h3 from h2 with g.st64_det using conj(w5u, fsb, md3, w5v, w5f, w5d)
      // the memory: within the frame, the thread's first word kept
      let U6 := fn_update(U5, "bytes", x86_64_linux.store_le(U5.bytes, int_add(FS, 40), 8, VAL))
      let V := fn_update(U, "bytes", x86_64_linux.store_le(x86_64_linux.store_le(U.bytes, int_add(P1, 0), 1, 0), int_add(FS, 40), 8, VAL))
      have v6e: U6 = V by simp()
      have vV := rewrite(v6e, apply(ms.wr_any, {U5}, {int_add(FS, 40)}, {8}, {VAL}, u5V))
      have og1: all i. i in omega -> int_lt(i, 1) -> int_add(int_add(P1, 0), i) in SSW || abi.stack_free(s.vm, s.objs, int_add(int_add(P1, 0), i)) proof
        fix i
        assume hi hil
        have _ b := mp(all_elim(rG, {int_add(int_add(P1, 0), i)}), arith(p1e, gdv, hi), arith(p1e, gdv, hi), arith(p1e, gdv, hi, hil))
        show by taut(b)
      qed
      have F1 := apply(sp.fr_store[b := s.vm, U := U, objs := s.objs, W := SSW, a := int_add(P1, 0), n := 1, v := 0], hfr, arith(p1e, gdv), simp(), arith(p1e, gdv), og1)
      have og2: all i. i in omega -> int_lt(i, 8) -> int_add(int_add(FS, 40), i) in SSW || abi.stack_free(s.vm, s.objs, int_add(int_add(FS, 40), i)) proof
        fix i
        assume hi hil
        have _ b := mp(all_elim(rB, {int_add(int_add(FS, 40), i)}), arith(fsb, hi), arith(fsb, hi), arith(fsb, hi, hil))
        show by taut(b)
      qed
      have F2 := apply(sp.fr_store[b := s.vm, U := U5, objs := s.objs, W := SSW, a := int_add(FS, 40), n := 8, v := VAL], F1, arith(fsb, fsr), simp(), arith(fsb, fsr), og2)
      have fr := rewrite(v6e, F2)
      have u6t: U6.bytes in fn_space(bits(64), bits(8)) by simp(apply(x86.store_typed, {U5.bytes}, {int_add(FS, 40)}, {8}, {VAL}, u5t))
      have l3 := apply(x86.le8_nat, {U6}, {FS}, u6t)
      have bq2: gimple.bytes_at(U6, FS, 8) = gimple.bytes_at(U5, FS, 8) by mem(fsb, fsr)
      have leq2: x86_64_linux.le(x86_64_linux.store_le(U5.bytes, int_add(FS, 40), 8, VAL), FS, 8) = x86_64_linux.le(U5.bytes, FS, 8) by simp(l3, l1, bq2)
      have bi6: gimple.bytes_at(U6, int_add(FS, 48), 4) = gimple.bytes_at(U5, int_add(FS, 48), 4) by mem(fsb, fsr)
      have ts6 := rewrite(v6e, apply(sp.ts_keep, {U5}, {x86_64_linux.store_le(U5.bytes, int_add(FS, 40), 8, VAL)}, {FS}, ts5, leq2, fsb, arith(fsr), bi6))
      show by taut((ex V2. ((V2 in x86_64_linux.Vm && startup_specs.frame(s.vm, V2, s.objs, SSW)) && startup_specs.thread_set(V2, FS)) && K(fn_update(s, "vm", V2))
        by ex_intro({V}, taut(vV, fr, ts6, h3))))
    qed
    show by taut(ho4, k1, k2)
  qed
  show by taut(ci, ca, cb, cc, cd)
qed

// ----------------------------------------------------------------------
//  __init_ssp's run

// (the guard's 8 bytes written: within the frame, the thread kept)
theorem sp.ssp_guard: all g s a v. s in abi.World -> g.stack_chk_guard = c_src_env___stack_chk_fail.__stack_chk_guard -> g.builtin_tls = c_src_env___init_tls.builtin_tls ->
  a = c_src_env___stack_chk_fail.__stack_chk_guard -> startup_specs.thread_set(s.vm, s.fs_base) -> startup_specs.in_tls(g, s.fs_base) ->
  (fn_update(s.vm, "bytes", x86_64_linux.store_le(s.vm.bytes, a, 8, v)) in x86_64_linux.Vm &&
   fn_update(fn_update(s.vm, "bytes", x86_64_linux.store_le(s.vm.bytes, a, 8, v)), "bytes", s.vm.bytes) = s.vm) &&
  startup_specs.frame(s.vm, fn_update(s.vm, "bytes", x86_64_linux.store_le(s.vm.bytes, a, 8, v)), s.objs, startup_specs.ssp_writes(g)) &&
  startup_specs.thread_set(fn_update(s.vm, "bytes", x86_64_linux.store_le(s.vm.bytes, a, 8, v)), s.fs_base)
proof
  fix g s a v
  assume hw hgG hgB ha hts hit
  let FS := s.fs_base
  let U := fn_update(s.vm, "bytes", x86_64_linux.store_le(s.vm.bytes, a, 8, v))
  have gdv: c_src_env___stack_chk_fail.__stack_chk_guard = 4227112 by defs(refl({4227112}), c_src_env___stack_chk_fail.__stack_chk_guard)
  have btv: c_src_env___init_tls.builtin_tls = 4228288 by defs(refl({4228288}), c_src_env___init_tls.builtin_tls)
  have fsb: FS in bits(64) by simp(expand(hw, abi.World))
  have it1 it2 := expand(hit, startup_specs.in_tls)
  have fsr: int_le(4228288, FS) && int_le(int_add(FS, 200), 4228624) by arith(it1, it2, hgB, btv)
  have sv _ _ sb := apply(ms.world_parts, hw)
  have uV := apply(ms.wr_any, {s.vm}, {a}, {8}, {v}, sv)
  have vf: is_fun(s.vm) && "bytes" in dom(s.vm) by simp(sv)
  have ub: fn_update(U, "bytes", s.vm.bytes) = s.vm := trans(fn_update_twice[f := s.vm, k := "bytes", a := x86_64_linux.store_le(s.vm.bytes, a, 8, v), b := s.vm.bytes],
    mp(fn_update_same[f := s.vm, k := "bytes"], taut(vf), taut(vf)))
  have og: all i. i in omega -> int_lt(i, 8) -> int_add(a, i) in startup_specs.ssp_writes(g) || abi.stack_free(s.vm, s.objs, int_add(a, i)) proof
    fix i
    assume hi hil
    have _ b := apply(sp.ssw_g, {g}, {int_add(a, i)}, arith(ha, gdv, hi), arith(hgG, ha, hi), arith(hgG, ha, hi, hil))
    show by taut(b)
  qed
  have fr := apply(sp.fr_store[b := s.vm, U := s.vm, objs := s.objs, W := startup_specs.ssp_writes(g), a := a, n := 8, v := v], apply(sp.fr_self[b := s.vm, objs := s.objs, W := startup_specs.ssp_writes(g)], sv),
    arith(ha, gdv), simp(), arith(ha, gdv), og)
  have ut: U.bytes in fn_space(bits(64), bits(8)) by simp(apply(x86.store_typed, {s.vm.bytes}, {a}, {8}, {v}, sb))
  have l1 := apply(x86.le8_nat, {U}, {FS}, ut)
  have l2 := apply(x86.le8_nat, {s.vm}, {FS}, sb)
  have bq: gimple.bytes_at(U, FS, 8) = gimple.bytes_at(s.vm, FS, 8) by mem(ha, gdv, fsr, fsb)
  have leq: x86_64_linux.le(x86_64_linux.store_le(s.vm.bytes, a, 8, v), FS, 8) = x86_64_linux.le(s.vm.bytes, FS, 8) by simp(l1, l2, bq)
  have bi: gimple.bytes_at(U, int_add(FS, 48), 4) = gimple.bytes_at(s.vm, int_add(FS, 48), 4) by mem(ha, gdv, fsr, fsb)
  have ts := apply(sp.ts_keep, {s.vm}, {x86_64_linux.store_le(s.vm.bytes, a, 8, v)}, {FS}, hts, leq, fsb, arith(fsr), bi)
  show by taut(uV, ub, fr, ts)
qed

theorem sp.ssp_run: all g entropy MC GT s o. s in abi.World -> runs(c_src_env___stack_chk_fail.__init_ssp(entropy, MC, GT), s, o) -> entropy in bits(64) ->
  g.stack_chk_guard = c_src_env___stack_chk_fail.__stack_chk_guard -> g.builtin_tls = c_src_env___init_tls.builtin_tls ->
  mp.calls(MC, mallocng_specs.memcpy_spec_fun()) -> mp.calls(GT, c_src_env___stack_chk_fail.__get_tp_fun()) ->
  startup_specs.init_ssp_pre(s.vm, s.objs, g, s.fs_base, entropy) -> sp.ssp_out(g, s, o)
proof
  fix g entropy MC GT s o
  assume hw hr heb hgG hgB hMC hGT hpre
  let GD := c_src_env___stack_chk_fail.__stack_chk_guard
  have pu := apply(g.runs_univ, expand(hr, c_src_env___stack_chk_fail.__init_ssp))
  have hu: s in univ(1) by simp(pu)
  have b := apply(g.runs_elim, expand(hr, c_src_env___stack_chk_fail.__init_ssp))
  obtain x2, hif hK from b
  have hts hit hglob hent := expand(hpre, startup_specs.init_ssp_pre)
  have sv pf pd _ := apply(ms.world_parts, hw)
  have gdb: GD in bits(64) by defs(simp(), c_src_env___stack_chk_fail.__stack_chk_guard)
  have gdv: GD = 4227112 by defs(refl({4227112}), c_src_env___stack_chk_fail.__stack_chk_guard)
  have rG0: all x. x in omega -> int_le(GD, x) -> int_lt(x, int_add(GD, 8)) -> x in startup_specs.start_writes(g) proof
    fix x
    assume xo h1 h2
    have a _ := apply(sp.ssw_g, {g}, {x}, xo, arith(hgG, h1), arith(hgG, h2))
    show := a
  qed
  have ugt ugf := apply(sp.glob_usable, {g}, {s.vm}, {s.objs}, {GD}, {8}, hglob, arith(gdv), rG0)
  // no entropy: the guard from its own address
  have cZ: entropy = 0 -> sp.ssp_out(g, s, o) proof
    assume hz
    have x2e: x2 = ok(pair(s, empty), empty) by taut(hif, hz)
    have mdG: g.mem_defined(s, GD, 0, 8, true) by simp(gdv, ugt)
    step h1 from rewrite(x2e, hK) with g.st64_det using conj(hu, gdb, mdG, sv, pf, pd)
    let U := fn_update(s.vm, "bytes", x86_64_linux.store_le(s.vm.bytes, int_add(GD, 0), 8, bits_mul(64, GD, 1103515245)))
    have gu1 gu2 gfr gts := apply(sp.ssp_guard, {g}, {s}, {int_add(GD, 0)}, {bits_mul(64, GD, 1103515245)}, hw, hgG, hgB, simp(), hts, hit)
    have r := apply(sp.ssp_tail, {g}, {GT}, {s}, {U}, hw, hu, gu1, gu2, hgG, hgB, gfr, gts, hit, hglob, hGT, h1)
    show by taut(r)
  qed
  // AT_RANDOM's bytes: the guard copied from them
  have cN: !(entropy = 0) -> sp.ssp_out(g, s, o) proof
    assume hn
    step h0 from hif using conj(hn)
    obtain oc, hrc hdc from apply(g.bind_open, h0)
    let OVF := exc_val("stack_overflow", empty)
    let N8 := bits_of_int(64, 8)
    let ARGS := seq_concat(seq_concat(seq_one(gimple.arg(64, GD)), seq_one(gimple.arg(64, entropy))), seq_one(gimple.arg(64, N8)))
    let UM := fn_update(s.vm, "bytes", x86_64_linux.store_le(s.vm.bytes, GD, N8, gimple.bytes_at(s.vm, entropy, N8)))
    let QM(o2) := abi.ovf_out(s, o2) || (ex r. o2 = ok(fn_update(s, "vm", UM), r) && fst(r) = GD)
    have n8: N8 = 8 by simp()
    // (AT_RANDOM's bytes: readable, apart from the guard)
    have eu ebd ens := mp(hent, hn)
    have eo: entropy in omega by arith(heb)
    have hA: all x. x in omega -> int_le(entropy, x) && int_lt(x, int_add(entropy, 8)) -> !(x in startup_specs.start_writes(g)) proof
      fix x
      assume xo h
      have h1 h2 := h
      have e: int_add(entropy, int_sub(x, entropy)) = x by arith(eo, xo)
      show := rewrite(e, mp(all_elim(ens, {int_sub(x, entropy)}), arith(h1, xo, eo), arith(h2)))
    qed
    have ap := apply(sp.apart[W := startup_specs.start_writes(g), a := entropy, c := int_add(entropy, 8), b := GD, m := 8], hA, rG0, eo, arith(gdv), arith(eo), arith())
    have hap: int_le(int_add(GD, N8), entropy) || int_le(int_add(entropy, N8), GD) by arith(ap, n8)
    have eu8: gimple.usable(s.vm, s.objs, entropy, N8, false) := rewrite(sym(n8), eu)
    have gu8: gimple.usable(s.vm, s.objs, GD, N8, true) := rewrite(sym(n8), ugt)
    // the call of memcpy (its spec's outcomes)
    have hq: all regs o2. gc.regs_ok(regs, ARGS) -> runs(MC[regs], s, o2) -> QM(o2) proof
      fix regs o2
      assume hro hg
      have rl rln _ := hro
      have l6: int_le(seq_len(regs), 6) by arith(rln, (seq_len(ARGS) = 3 by simp()))
      have hs := mp(all_elim(hMC, {regs}, {s}, {o2}), rl, l6, hw, hg)
      show := apply(mp.mc_q, {s}, {GD}, {entropy}, {N8}, {regs}, {o2}, hw, hu, gdb, heb, simp(), eu8, gu8, hap, hro, hs)
    qed
    have rg := apply(gc.regs_get, apply(gc.regs_cat, apply(gc.regs_cat, apply(gc.regs_one[w := 64, x := GD], simp(), simp(), gdb),
      apply(gc.regs_one[w := 64, x := entropy], simp(), simp(), heb)), apply(gc.regs_one[w := 64, x := N8], simp(), simp(), simp())))
    have ci := apply(gc.call0_inv[Q := o2. QM(o2)], {MC}, {ARGS}, {s}, {oc}, rg, hq, hrc)
    // (an exception of the call: the function's, an overflow)
    have hX: all Y E. oc = exc(Y, E) -> x2 = exc(pair(Y, empty), pair("raise", E)) proof
      fix Y E
      assume he
      have c1: (ex s1 v. oc = ok(s1, v) && true) -> false proof
        assume e1
        obtain s1 v, e2 _ from e1
        have ne: !(ok(s1, v) = exc(Y, E)) by defs(simp(), ok, exc)
        show by taut(ne, trans(sym(e2), he))
      qed
      have c3: (ex t. oc = diverge(t)) -> false proof
        assume e1
        obtain t, e2 from e1
        have ne: !(diverge(t) = exc(Y, E)) by defs(simp(), diverge, exc)
        show by taut(ne, trans(sym(e2), he))
      qed
      have hd2 := rewrite(he, hdc)
      show by simp(hd2, c1, c3)
    qed
    have ovG: all v ob. v in x86_64_linux.Vm -> ob in abi.Objs -> oc = exc(fn_update(fn_update(s, "vm", v), "objs", ob), OVF) -> sp.ssp_out(g, s, o) proof
      fix v ob
      assume hv hob e
      have xe := mp(all_elim(hX, {fn_update(fn_update(s, "vm", v), "objs", ob)}, {OVF}), e)
      have oe: o = exc(fn_update(fn_update(s, "vm", v), "objs", ob), OVF) by simp(rewrite(xe, hK))
      show by taut((abi.ovf_out(s, o) by ex_intro({v}, {ob}, taut(hv, hob, oe))))
    qed
    have od: "objs" in dom(s) by simp(expand(hw, abi.World))
    have sob: s.objs in abi.Objs by simp(expand(hw, abi.World))
    have ca: oc = exc(s, OVF) -> sp.ssp_out(g, s, o) proof
      assume e
      have se: fn_update(fn_update(s, "vm", s.vm), "objs", s.objs) = s by simp(pf, pd, od)
      show := mp(all_elim(ovG, {s.vm}, {s.objs}), sv, sob, rewrite(sym(se), e))
    qed
    have cc: (ex x e. QM(exc(x, e)) && oc = exc(x, e)) -> sp.ssp_out(g, s, o) proof
      assume q
      obtain x e, hq2 he from q
      have nk: !(ex r. exc(x, e) = ok(fn_update(s, "vm", UM), r) && fst(r) = GD) by defs(simp(), ok, exc)
      have ov: abi.ovf_out(s, exc(x, e)) by taut(hq2, nk)
      obtain v ob, hv hob hxe from ov
      have oe: oc = exc(fn_update(fn_update(s, "vm", v), "objs", ob), OVF) by simp(he, hxe)
      show := mp(all_elim(ovG, {v}, {ob}), hv, hob, oe)
    qed
    have cd: (ex t. QM(diverge(t)) && oc = diverge(t)) -> sp.ssp_out(g, s, o) proof
      assume q
      obtain t, hq2 _ from q
      show by defs(simp(hq2), ok, exc, diverge)
    qed
    have cb: (ex w4 r. QM(ok(w4, r)) && (oc = ok(gc.back0(w4, s), pair(fst(r), snd(r))) || oc = exc(gc.back0(w4, s), OVF))) -> sp.ssp_out(g, s, o) proof
      assume q
      obtain w4 r, hq4 ho4 from q
      have no: !abi.ovf_out(s, ok(w4, r)) by defs(simp(), ok, exc)
      have q2: ex r2. ok(w4, r) = ok(fn_update(s, "vm", UM), r2) && fst(r2) = GD by taut(hq4, no)
      obtain r2, e42 _ from q2
      have w4e: w4 = fn_update(s, "vm", UM) by simp(e42)
      have os := apply(gc.objs_same, hw)
      have bk: gc.back0(w4, s) = fn_update(s, "vm", UM) by simp(w4e, os, pf, od)
      have uMV := apply(ms.wr_any, {s.vm}, {GD}, {N8}, {gimple.bytes_at(s.vm, entropy, N8)}, sv)
      have k2: oc = exc(gc.back0(w4, s), OVF) -> sp.ssp_out(g, s, o) proof
        assume e
        have se: fn_update(fn_update(s, "vm", UM), "objs", s.objs) = fn_update(s, "vm", UM) by simp(pf, od)
        show := mp(all_elim(ovG, {UM}, {s.objs}), uMV, sob, rewrite(sym(se), rewrite(bk, e)))
      qed
      have k1: oc = ok(gc.back0(w4, s), pair(fst(r), snd(r))) -> sp.ssp_out(g, s, o) proof
        assume e
        step h1 from rewrite(bk, rewrite(e, hdc))
        // the guard: AT_RANDOM's 8 bytes; then the common tail
        let VE := gimple.bytes_at(s.vm, entropy, 8)
        let U := fn_update(s.vm, "bytes", x86_64_linux.store_le(s.vm.bytes, GD, 8, VE))
        have gu1 gu2 gfr gts := apply(sp.ssp_guard, {g}, {s}, {GD}, {VE}, hw, hgG, hgB, refl({GD}), hts, hit)
        have r := apply(sp.ssp_tail, {g}, {GT}, {s}, {U}, hw, hu, gu1, gu2, hgG, hgB, gfr, gts, hit, hglob, hGT, rewrite(n8, h1))
        have r1: (ex v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && x2 = exc(pair(fn_update(fn_update(s, "vm", v), "objs", ob), empty), pair("raise", OVF))) ->
            sp.ssp_out(g, s, o) proof
          assume q2
          obtain v ob, hv hob xe from q2
          have oe: o = exc(fn_update(fn_update(s, "vm", v), "objs", ob), OVF) by simp(rewrite(xe, hK))
          show by taut((abi.ovf_out(s, o) by ex_intro({v}, {ob}, taut(hv, hob, oe))))
        qed
        have r2: (ex V. ((V in x86_64_linux.Vm && startup_specs.frame(s.vm, V, s.objs, startup_specs.ssp_writes(g))) && startup_specs.thread_set(V, s.fs_base)) &&
            x2 = exc(pair(fn_update(s, "vm", V), empty), pair("ret", empty))) -> sp.ssp_out(g, s, o) proof
          assume q2
          obtain V, hV hfr hts2 xe from q2
          have oe: o = ok(fn_update(s, "vm", V), empty) by simp(rewrite(xe, hK))
          have x: ex V2. ((V2 in x86_64_linux.Vm && startup_specs.frame(s.vm, V2, s.objs, startup_specs.ssp_writes(g))) && startup_specs.thread_set(V2, s.fs_base)) &&
            o = ok(fn_update(s, "vm", V2), empty) by ex_intro({V}, taut(hV, hfr, hts2, oe))
          show by taut(x)
        qed
        show by taut(r, r1, r2)
      qed
      show by taut(ho4, k1, k2)
    qed
    show by taut(ci, ca, cb, cc, cd)
  qed
  show by taut(cZ, cN)
qed

// ----------------------------------------------------------------------
//  The spec's runs

// (its requirement not met: anything; else an overflow, or the memory
// within the frame, the thread still set up)
theorem sp.sss_run(g, entropy, s, o): s in abi.World -> pair(s, o) in univ(1) ->
  (!startup_specs.init_ssp_pre(s.vm, s.objs, g, s.fs_base, entropy) || sp.ovf_any(s, o) ||
   (ex V. ((V in x86_64_linux.Vm && startup_specs.frame(s.vm, V, s.objs, startup_specs.ssp_writes(g))) && startup_specs.thread_set(V, s.fs_base)) &&
      o = ok(fn_update(s, "vm", V), empty))) ->
  runs(startup_specs.init_ssp_spec(g, entropy), s, o)
proof
  assume hw pu h
  let OVF := exc_val("stack_overflow", empty)
  let SSW := startup_specs.ssp_writes(g)
  let PRE(x0) := startup_specs.init_ssp_pre(app(x0, "vm"), app(x0, "objs"), g, app(x0, "fs_base"), entropy)
  let BR1(x0, x2) := bind_rel(startup_specs.overflow_start, x0, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)), x3. x2 = diverge(x3))
  let BR2(x0, x2) := letin(app(x0, "vm"), x3. any_rel(x4. x4 in x86_64_linux.Vm && (startup_specs.frame(x3, app(fn_update(x0, "vm", x4), "vm"), app(fn_update(x0, "vm", x4), "objs"), SSW) &&
    startup_specs.thread_set(app(fn_update(x0, "vm", x4), "vm"), app(fn_update(x0, "vm", x4), "fs_base"))), x4. letin(fn_update(x0, "vm", x4), x5. x2 = ok(pair(x5, empty), empty))))
  let DS(x2, x1) := (fst(x2) = 0 && x1 = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && x1 = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
    ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && x1 = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && x1 = diverge(snd(x2))))
  let SB(x0, x1) := !PRE(x0) || (ex x2. (BR1(x0, x2) || BR2(x0, x2)) && DS(x2, x1))
  have hu: s in univ(1) by simp(pu)
  have g0: SB(s, o) proof
    have c1: !PRE(s) -> SB(s, o) proof
      assume hn
      show by taut(hn)
    qed
    have c2: sp.ovf_any(s, o) -> SB(s, o) proof
      assume e
      obtain f v ob, hf hv hob ho from expand(e, sp.ovf_any)
      let WO := fn_update(fn_update(fn_update(s, "fs_base", f), "vm", v), "objs", ob)
      let X2 := exc(pair(WO, empty), pair("raise", OVF))
      have pu1 := rewrite(ho, pu)
      have r1 := apply(sp.ovs_intro, {s}, {f}, {v}, {ob}, hu, hf, hv, hob, pu1)
      have cx: ex x3 x4. exc(WO, OVF) = exc(x3, x4) && X2 = exc(pair(x3, empty), pair("raise", x4)) by ex_intro({WO}, {OVF}, taut(refl({exc(WO, OVF)}), refl({X2})))
      have b1: BR1(s, X2) by defs(ex_intro({exc(WO, OVF)}, taut(r1, cx)), bind_rel)
      have d1: DS(X2, o) by simp(ho)
      show by taut((ex x2. (BR1(s, x2) || BR2(s, x2)) && DS(x2, o) by ex_intro({X2}, taut(b1, d1))))
    qed
    have c3: (ex V. ((V in x86_64_linux.Vm && startup_specs.frame(s.vm, V, s.objs, SSW)) && startup_specs.thread_set(V, s.fs_base)) &&
        o = ok(fn_update(s, "vm", V), empty)) -> SB(s, o) proof
      assume e
      obtain V, hV hfr hts ho from e
      let X2 := ok(pair(fn_update(s, "vm", V), empty), empty)
      have ev: ex x4. (x4 in x86_64_linux.Vm && (startup_specs.frame(s.vm, app(fn_update(s, "vm", x4), "vm"), app(fn_update(s, "vm", x4), "objs"), SSW) &&
          startup_specs.thread_set(app(fn_update(s, "vm", x4), "vm"), app(fn_update(s, "vm", x4), "fs_base")))) && letin(fn_update(s, "vm", x4), x5. X2 = ok(pair(x5, empty), empty))
        by ex_intro({V}, defs(simp(hV, hfr, hts, keep(startup_specs.frame, startup_specs.thread_set)), letin))
      have b2: BR2(s, X2) by defs(taut(expand(ev, any_rel, letin)), any_rel, letin)
      have d2: DS(X2, o) by simp(ho)
      show by taut((ex x2. (BR1(s, x2) || BR2(s, x2)) && DS(x2, o) by ex_intro({X2}, taut(b2, d2))))
    qed
    show by taut(h, c1, c2, c3)
  qed
  show by defs(apply(tr.runs_intro[r := x0 x1. SB(x0, x1)], {s}, {o}, pu, g0), startup_specs.init_ssp_spec)
qed

// (the spec's C function value: its procedure's outcome o3, any result
// registers then)
theorem sp.ssf_intro(g, regs, s, o, o3): regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) -> pair(s, o) in univ(1) ->
  runs(startup_specs.init_ssp_spec(g, bits_of_int(64, regs[0])), s, o3) ->
  ((ex w r. o3 = ok(w, r) && any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o = ok(w, pair(x5, x6))))) ||
   (ex w e. o3 = exc(w, e) && o = exc(w, e)) || (ex t. o3 = diverge(t) && o = diverge(t))) ->
  runs(startup_specs.init_ssp_spec_fun(g)[regs], s, o)
proof
  assume ra pu hs hd
  let SP := startup_specs.init_ssp_spec(g, bits_of_int(64, regs[0]))
  have bb: bind_rel(SP, s, x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o = ok(x3, pair(x5, x6)))), x3 x4. o = exc(x3, x4), x3. o = diverge(x3))
    by defs(ex_intro({o3}, taut(hs, hd)), bind_rel)
  rsimp only, startup_specs.init_ssp_spec_fun, app_fn_build, ra
  show := apply(tr.runs_intro[r := x1 x2. !ord_le(1, seq_len(regs)) || bind_rel(SP, x1, x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. x2 = ok(x3, pair(x5, x6)))),
    x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))], {s}, {o}, pu, taut(bb))
qed

// ----------------------------------------------------------------------
//  __init_ssp's C function by its purpose

theorem sp.ss_fun: all g MC GT regs s o.
  g.stack_chk_guard = c_src_env___stack_chk_fail.__stack_chk_guard -> g.builtin_tls = c_src_env___init_tls.builtin_tls ->
  mp.calls(MC, mallocng_specs.memcpy_spec_fun()) -> mp.calls(GT, c_src_env___stack_chk_fail.__get_tp_fun()) ->
  regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
  runs(c_src_env___stack_chk_fail.__init_ssp_fun(MC, GT)[regs], s, o) ->
  runs(startup_specs.init_ssp_spec_fun(g)[regs], s, o)
proof
  fix g MC GT regs s o
  assume hgG hgB hMC hGT hr hl hw h
  have lo: seq_len(regs) in omega by simp(hr)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(hl, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(hr, ol, keep(ord_le))
  rsimp only, c_src_env___stack_chk_fail.__init_ssp_fun, app_fn_build, ra in h
  have pu := apply(g.runs_univ, h)
  have b := apply(g.runs_elim, h)
  let EN := bits_of_int(64, regs[0])
  let SP := startup_specs.init_ssp_spec(g, EN)
  let SF := startup_specs.init_ssp_spec_fun(g)
  let K(w) := any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o = ok(w, pair(x5, x6))))
  let GO := runs(SF[regs], s, o)
  have hu: s in univ(1) by simp(pu)
  // no register: the spec's anything
  have cS: !ord_le(1, seq_len(regs)) -> GO proof
    assume hn
    rsimp only, startup_specs.init_ssp_spec_fun, app_fn_build, ra
    show := apply(tr.runs_intro[r := x1 x2. !ord_le(1, seq_len(regs)) || bind_rel(SP, x1, x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. x2 = ok(x3, pair(x5, x6)))),
      x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))], {s}, {o}, pu, taut(hn))
  qed
  have cT: ord_le(1, seq_len(regs)) -> GO proof
    assume h1
    have b2: bind_rel(c_src_env___stack_chk_fail.__init_ssp(EN, MC, GT), s, x3 x4. K(x3), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) by taut(b, h1)
    obtain o3, hs3 hk3 from expand(b2, bind_rel)
    have psu := apply(g.runs_univ, expand(hs3, c_src_env___stack_chk_fail.__init_ssp))
    have via: all o3x. runs(SP, s, o3x) ->
        ((ex w r. o3x = ok(w, r) && K(w)) || (ex w e. o3x = exc(w, e) && o = exc(w, e)) || (ex t. o3x = diverge(t) && o = diverge(t))) -> GO proof
      fix o3x
      assume r1 r2
      show := apply(sp.ssf_intro[g := g, regs := regs, s := s, o := o, o3 := o3x], ra, pu, r1, r2)
    qed
    have cok: all w r. o3 = ok(w, r) -> K(w) proof
      fix w r
      assume e
      show by simp(rewrite(e, hk3), keep(any_rel))
    qed
    have cexc: all w e. o3 = exc(w, e) -> o = exc(w, e) proof
      fix w e
      assume h3
      show by simp(rewrite(h3, hk3), keep(any_rel))
    qed
    have cdv: all t. o3 = diverge(t) -> o = diverge(t) proof
      fix t
      assume h3
      show by simp(rewrite(h3, hk3), keep(any_rel))
    qed
    let D3(x) := ((ex w r. x = ok(w, r) && K(w)) || (ex w e. x = exc(w, e) && o = exc(w, e))) || (ex t. x = diverge(t) && o = diverge(t))
    let PRE := startup_specs.init_ssp_pre(s.vm, s.objs, g, s.fs_base, EN)
    // the requirement not met: the spec's anything, its procedure's
    // outcome the code's
    have caseN: !PRE -> GO proof
      assume hn
      have k1: (ex w r. o3 = ok(w, r)) -> GO proof
        assume e
        obtain w r, e3 from e
        have rs := apply(sp.sss_run[g := g, entropy := EN, s := s, o := o3], hw, psu, taut(hn))
        have d := mp(all_elim(cok, {w}, {r}), e3)
        have x1: ex w2 r2. o3 = ok(w2, r2) && K(w2) by ex_intro({w}, {r}, taut(e3, d))
        show by taut(mp(all_elim(via, {o3}), rs, (D3(o3) by taut(x1))))
      qed
      have k2: (ex w e. o3 = exc(w, e)) -> GO proof
        assume e
        obtain w x, e3 from e
        have rs := apply(sp.sss_run[g := g, entropy := EN, s := s, o := o3], hw, psu, taut(hn))
        have oe := mp(all_elim(cexc, {w}, {x}), e3)
        have x1: ex w2 e2. o3 = exc(w2, e2) && o = exc(w2, e2) by ex_intro({w}, {x}, taut(e3, oe))
        show by taut(mp(all_elim(via, {o3}), rs, (D3(o3) by taut(x1))))
      qed
      have k3: (ex t. o3 = diverge(t)) -> GO proof
        assume e
        obtain t, e3 from e
        have rs := apply(sp.sss_run[g := g, entropy := EN, s := s, o := o3], hw, psu, taut(hn))
        have oe := mp(all_elim(cdv, {t}), e3)
        have x1: ex t2. o3 = diverge(t2) && o = diverge(t2) by ex_intro({t}, taut(e3, oe))
        show by taut(mp(all_elim(via, {o3}), rs, (D3(o3) by taut(x1))))
      qed
      have ot: (ex w r. o3 = ok(w, r)) || (ex w e. o3 = exc(w, e)) || (ex t. o3 = diverge(t)) proof
        have c1: (ex x3 x4. o3 = ok(x3, x4) && K(x3)) -> ex w r. o3 = ok(w, r) proof
          assume q
          obtain w r, q1 _ from q
          show by ex_intro({w}, {r}, q1)
        qed
        have c2: (ex x3 x4. o3 = exc(x3, x4) && o = exc(x3, x4)) -> ex w e. o3 = exc(w, e) proof
          assume q
          obtain w e, q1 _ from q
          show by ex_intro({w}, {e}, q1)
        qed
        have c3: (ex x3. o3 = diverge(x3) && o = diverge(x3)) -> ex t. o3 = diverge(t) proof
          assume q
          obtain t, q1 _ from q
          show by ex_intro({t}, q1)
        qed
        show by taut(hk3, c1, c2, c3)
      qed
      show by taut(ot, k1, k2, k3)
    qed
    // the requirement met: the run's outcomes
    have caseP: PRE -> GO proof
      assume hp
      have eb: EN in bits(64) by simp()
      have go := mp(all_elim(sp.ssp_run, {g}, {EN}, {MC}, {GT}, {s}, {o3}), hw, hs3, eb, hgG, hgB, hMC, hGT, hp)
      have p1: abi.ovf_out(s, o3) -> GO proof
        assume e
        have e2 := apply(sp.ovf_out_any, hw, e)
        obtain f v ob, _ _ _ e3 from expand(e2, sp.ovf_any)
        let WO := fn_update(fn_update(fn_update(s, "fs_base", f), "vm", v), "objs", ob)
        let OVF := exc_val("stack_overflow", empty)
        have rs := apply(sp.sss_run[g := g, entropy := EN, s := s, o := o3], hw, psu, taut(e2))
        have oe := mp(all_elim(cexc, {WO}, {OVF}), e3)
        have x1: ex w2 e4. o3 = exc(w2, e4) && o = exc(w2, e4) by ex_intro({WO}, {OVF}, taut(e3, oe))
        show by taut(mp(all_elim(via, {o3}), rs, (D3(o3) by taut(x1))))
      qed
      have p2: (ex V. ((V in x86_64_linux.Vm && startup_specs.frame(s.vm, V, s.objs, startup_specs.ssp_writes(g))) && startup_specs.thread_set(V, s.fs_base)) &&
          o3 = ok(fn_update(s, "vm", V), empty)) -> GO proof
        assume e
        obtain V, _ _ _ e3 from e
        have rs := apply(sp.sss_run[g := g, entropy := EN, s := s, o := o3], hw, psu, taut(e))
        have d := mp(all_elim(cok, {fn_update(s, "vm", V)}, {empty}), e3)
        have x1: ex w2 r2. o3 = ok(w2, r2) && K(w2) by ex_intro({fn_update(s, "vm", V)}, {empty}, taut(e3, d))
        show by taut(mp(all_elim(via, {o3}), rs, (D3(o3) by taut(x1))))
      qed
      show by taut(go, p1, p2)
    qed
    show by taut(caseN, caseP)
  qed
  show by taut(cS, cT)
qed
