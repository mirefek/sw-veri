// record_seq by its purpose: a counter, as malloc.c's (`counters_spec`):
// only the context's free bytes changed -- a bouncing size class's unmap
// sequence byte set to the sequence byte.

// its run: the class's unmap sequence byte written (a free byte), or
// nothing
theorem mp.rq_eff(c, sc, s, h, o): c in mallocng.Cfg -> c.ctx = c_src_malloc_mallocng_malloc.__malloc_context -> sc in bits(32) ->
  s in abi.World -> h in mp.G -> mallocng.holds_m(c, h.A, s.vm, h.blocks) -> mallocng.shown_in(c, h.A, s.objs) ->
  runs(c_src_malloc_mallocng_free.record_seq(sc), s, o) ->
  ex V2. V2 in x86_64_linux.Vm && mallocng_specs.ctx_only(c, s.vm, V2) && o = ok(fn_update(s, "vm", V2), empty)
proof
  assume hc hx hsc hs hh hin hsh hr
  let CTX := c_src_malloc_mallocng_malloc.__malloc_context
  let CF := c_src_malloc_mallocng_free.__malloc_context
  let V0 := s.vm
  let T64 := fn_update(fn_update(empty, "prec", 64), "signed", true)
  have hu0 _ _ hat := mp(all_elim(mp.g_rec, {h}), hh)
  have au: h.A in univ(1) by simp(hu0)
  have pu := apply(g.runs_univ, expand(hr, c_src_malloc_mallocng_free.record_seq))
  have su: s in univ(1) by simp(pu)
  have vV vfun vdom vb := apply(ms.world_parts, hs)
  have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], vfun, vdom)
  have cv: CTX = 4227328 by defs(simp(), c_src_malloc_mallocng_malloc.__malloc_context)
  have cf: CF = 4227328 by defs(simp(), c_src_malloc_mallocng_free.__malloc_context)
  have bi1 bi2 := apply(ms.bounce_idx, hsc)
  // not a bouncing class: nothing written
  have out: !mallocng_specs.bouncing_class(sc) -> ex V2. V2 in x86_64_linux.Vm && mallocng_specs.ctx_only(c, V0, V2) && o = ok(fn_update(s, "vm", V2), empty) proof
    assume h0
    have nl := mp(bi2, h0)
    step oe from hr with nl
    have e1: o = ok(fn_update(s, "vm", V0), empty) by simp(oe, ss)
    show by ex_intro({V0}, taut(vV, apply(mp.co_refl[c := c, vm := V0], vV), e1))
  qed
  // a bouncing class: its unmap sequence byte (a free byte, as the code
  // addresses it: UA) set to the sequence byte (at CF + 912)
  have inr: mallocng_specs.bouncing_class(sc) -> ex V2. V2 in x86_64_linux.Vm && mallocng_specs.ctx_only(c, V0, V2) && o = ok(fn_update(s, "vm", V2), empty) proof
    assume h0
    have be _ bf bsx := mp(bi1, h0)
    have lo hi := expand(h0, mallocng_specs.bouncing_class)
    have {uat = uat, ufree = ufree} := apply(mp.bounce_free[c := c, sc := sc], hx, hsc, h0)
    have co: c.ctx in omega by arith(hx, cv)
    have f912 := apply(mp.free_off[c := c, a := int_add(CTX, 912), n := 1], co, arith(cv), arith(hx, cv), arith(hx, cv))
    have u1 _ := apply(mp.free_usable[c := c, A := h.A, vm := V0, b := h.blocks, objs := s.objs, a := int_add(CTX, 912), n := 1], hc, au, hat, hin, hsh, arith(cv), f912)
    have _ u2 := apply(mp.free_usable[c := c, A := h.A, vm := V0, b := h.blocks, objs := s.objs, a := mallocng_specs.unmap_seq_at(CTX, sc), n := 1], hc, au, hat, hin, hsh, uat, apply(mp.free1, uat, ufree))
    have sv: gimple.sval(T64, 848) = 848 by defs(simp(), gimple.sval)
    have bsx2: bits_sext(32, 64, bits_add(32, sc, bits_neg(32, 7))) = int_sub(sc, 7) := rewrite(sym(be), bsx, {1})
    let UA := int_add(int_add(int_add(CF, gimple.sval(T64, 848)), bits_sext(32, 64, bits_add(32, sc, bits_neg(32, 7)))), 0)
    have p64: pow2(64) = 18446744073709551616 by simp()
    have ua: mallocng_specs.unmap_seq_at(CTX, sc) = UA by defs(arith(sv, bsx2, cv, cf, lo, hi, p64), mallocng_specs.unmap_seq_at, bits_of_int)
    have uw := rewrite(ua, u2)
    have ur: gimple.usable(V0, s.objs, int_add(CF, 912), 1, false) by simp(u1, cv, cf)
    have F := conj(su, hs, hsc, cf, sv, bsx2, be, lo, hi, uw, ur, p64, bf)
    step x1, oe from hr with g.sadd32_det, g.padd_det, g.elem1_det, g.ld8_det, ms.st8_det using F
    let X := bits_of_int(8, gimple.bytes_at(V0, int_add(CF, 912), 1))
    have ul: int_lt(mallocng_specs.unmap_seq_at(CTX, sc), 18446744073709551615) by arith(ua, sv, bsx2, cf, hi)
    have w := apply(mp.co_wr8[c := c, vm := V0, a := mallocng_specs.unmap_seq_at(CTX, sc), v := X], vV, uat, ul, ufree)
    have w2 := rewrite(ua, rewrite(all_elim(ms.v_wr8, {V0}, {mallocng_specs.unmap_seq_at(CTX, sc)}, {X}), w))
    show by ex_intro({fn_update(V0, "bytes", x86_64_linux.store_le(V0.bytes, UA, 1, X))}, taut(w2, oe))
  qed
  show by taut(out, inr)
qed

// its code by its purpose
theorem mp.rq: all c sc. c in mallocng.Cfg -> c.ctx = c_src_malloc_mallocng_malloc.__malloc_context -> sc in bits(32) ->
  refines_ghost(c_src_malloc_mallocng_free.record_seq(sc), mallocng_specs.counters_spec(c), abi.World, mp.G)
proof
  fix c sc
  assume hc hx hsc
  have rp: all s o. runs(c_src_malloc_mallocng_free.record_seq(sc), s, o) -> pair(s, o) in univ(1) proof
    fix s o
    assume hr
    show := apply(g.runs_univ, expand(hr, c_src_malloc_mallocng_free.record_seq))
  qed
  have eff: all s h o. s in abi.World -> h in mp.G -> mallocng.holds_m(c, h.A, s.vm, h.blocks) -> mallocng.shown_in(c, h.A, s.objs) -> runs(c_src_malloc_mallocng_free.record_seq(sc), s, o) ->
      ex V2. V2 in x86_64_linux.Vm && mallocng_specs.ctx_only(c, s.vm, V2) && o = ok(fn_update(s, "vm", V2), empty) proof
    fix s h o
    assume hs hh hin hsh hr
    show := apply(mp.rq_eff, hc, hx, hsc, hs, hh, hin, hsh, hr)
  qed
  show := apply(mp.counters_ref[c := c, p := c_src_malloc_mallocng_free.record_seq(sc)], rp, eff)
qed

// its code called as decay_bounces is (the class's counters, context bytes
// only)
theorem mp.rq_q: all c. c in mallocng.Cfg -> c.ctx = c_src_malloc_mallocng_malloc.__malloc_context ->
  mp.db_call(c, c_src_malloc_mallocng_free.record_seq_fun())
proof
  fix c
  assume hc hx
  fix x t h regs o2
  assume hxb hw hh hin hsh hro hr
  have rl rn r0 := apply(gc.regs1_32, hxb, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  have o1l: ord_le(1, seq_len(regs)) by defs(simp(rn), ord_le)
  step o3 V u y, e from hr with o1l, r0, mp.rq_eff using ra, hxb, hw, hc, hx, hh, hin, hsh
  show by disj({2}, ex_intro({V}, {pair(u, y)}, taut(e)))
qed

// its C function value, its divergence, its machine code, called as its
// contract says: mp.rq_fun, mp.rq_divg, mp.rq_implements, mp.rq_call_ref,
// mp.rq_call_linked
contract record_seq mallocng_specs.counters_spec_fun1 by mp.rq call mp.db_call
