    have cph: ex C. ex I. (((C in omega && int_le(1, C)) && int_le(C, 32)) && int_le(int_mul(SZ, C), 1048575)) && I in omega && x9 = ok(TC(C, I), empty) proof
      have d1: int_le(sc, 8) -> ex C. ex I. (((C in omega && int_le(1, C)) && int_le(C, 32)) && int_le(int_mul(SZ, C), 1048575)) && I in omega && x9 = ok(TC(C, I), empty) proof
