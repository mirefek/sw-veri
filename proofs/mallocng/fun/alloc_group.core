// alloc_group(sc, req) by its purpose (`alloc_group_spec`): a new group of
// class sc for requests of up to req bytes, or 0. Its callees at a call
// first, then the run.

// every size up to the largest class's has a class: the least one big enough
theorem mp.class_ex: all n. n in omega -> int_le(n, 131052) -> ex c. c in bits(32) && mallocng_specs.class_of(n, c)
proof
  fix n
  assume hn hl
  let U := int_div(int_add(n, 19), 16)
  have s47: mallocng.size_classes[47] = 8191 by simp(ms.sc_vals)
  have p47: 47 in omega && int_lt(47, 48) && int_le(U, mallocng.size_classes[47]) by arith(s47, hn, hl)
  have e47: ex a. a in omega && (a in omega && int_lt(a, 48) && int_le(U, mallocng.size_classes[a])) by ex_intro({47}, taut(p47))
  obtain m, hm hp hmin from mp(nat_least[p := x. x in omega && int_lt(x, 48) && int_le(U, mallocng.size_classes[x])], e47)
  have _ hm48 hmu := hp
  have prev: m = 0 || int_lt(mallocng.size_classes[int_sub(m, 1)], U) proof
    have c1: !(m = 0) -> int_lt(mallocng.size_classes[int_sub(m, 1)], U) proof
      assume hz
      have m1: int_sub(m, 1) in omega by arith(hm, hz)
      have nl: !(int_sub(m, 1) in omega && int_lt(int_sub(m, 1), 48) && int_le(U, mallocng.size_classes[int_sub(m, 1)])) proof
        assume e
        have le := mp(all_elim(hmin, {int_sub(m, 1)}), m1, e)
        show by arith(le, hz, hm)
      qed
      have sv _ := apply(ms.sc_nat, m1, (int_lt(int_sub(m, 1), 48) by arith(hm48, hm)))
      show by arith(nl, m1, hm48, hm, sv)
    qed
    show by taut(c1)
  qed
  have co := apply(ms.class_from, hn, hm, hm48, hmu, prev)
  show by ex_intro({m}, taut((m in bits(32) by arith(hm, hm48)), co))
qed

// what a caller relies on of a callee f called as enframe(g, idx, n, ctr),
// the ghost part h read: an overflow, or the slot framed for n bytes at P,
// P in the result register
abbrev mp.ef_call(c, f) := all g idx n ctr t h regs o2. g in bits(64) -> idx in bits(32) -> n in bits(64) -> ctr in bits(32) -> t in abi.World -> h in mp.G ->
  mallocng.holds_in(c, h.A, t.vm, h.blocks) -> abi.thread_ok(t.vm, t.fs_base) ->
  mallocng.is_used(h.A, g) -> mallocng.reserved_only(h.A, g, idx) ->
  mallocng.slot_rw(t.vm, h.A.metas[g], idx) ->
  int_le(int_add(n, mallocng.IB), mallocng.stride(h.A.metas[g])) -> int_lt(mallocng.stride(h.A.metas[g]), int_pow(2, 31)) ->
  (int_lt(h.A.metas[g].sizeclass, 48) ->
     int_lt(int_sub(int_sub(mallocng.slot_end(h.A.metas[g], idx), n), mallocng.storage(h.A.metas[g])),
       int_mul(int_mul(mallocng.UNIT, mallocng.size_classes[h.A.metas[g].sizeclass]), int_add(idx, 1)))) ->
  (int_le(int_add(t.fs_base, 8), int_sub(mallocng.slot_start(h.A.metas[g], idx), mallocng.IB)) ||
     int_le(mallocng.slot_end(h.A.metas[g], idx), t.fs_base)) ->
  gc.regs_ok(regs, seq_concat(seq_concat(seq_concat(seq_one(gimple.arg(64, g)), seq_one(gimple.arg(32, idx))), seq_one(gimple.arg(64, n))), seq_one(gimple.arg(32, ctr)))) ->
  runs(f[regs], t, o2) ->
  (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex W rr. (W in x86_64_linux.Vm && (fst(rr) in bits(64) && ((int_le(mallocng.slot_start(h.A.metas[g], idx), fst(rr)) &&
        int_mod(int_sub(fst(rr), mallocng.slot_start(h.A.metas[g], idx)), mallocng.UNIT) = 0) &&
        int_lt(fst(rr), int_add(mallocng.slot_start(h.A.metas[g], idx), int_mul(256, mallocng.UNIT)))) &&
        int_le(int_add(fst(rr), n), mallocng.slot_end(h.A.metas[g], idx)) &&
      mallocng_specs.framed(t.vm, W, h.A.metas[g], idx, fst(rr), n))) && o2 = ok(fn_update(t, "vm", W), rr))

// enframe's code called as enframe
theorem mp.ef_q: all c g0 g1 g2. c in mallocng.Cfg -> c.sct = c_src_malloc_mallocng_malloc.__malloc_size_classes ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(g0[regs], s, o) -> runs(c_src_malloc_mallocng_malloc.get_stride_fun()[regs], s, o)) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(g2[regs], s, o) -> runs(mallocng_specs.set_size_spec_fun()[regs], s, o)) ->
  mp.ef_call(c, c_src_malloc_mallocng_malloc.enframe_fun(g0, g1, g2))
proof
  fix c g0 g1 g2
  assume hc hsct hg0 hg2
  fix g idx n ctr t h regs o2
  assume hgb hib hnb hcb hw hh hin hth hus hro hrw hns hs31 hcls hfs hrg hr
  step o3 P W, e hs1 from hr with mp.ef_run using hrg, hc, hsct, hgb, hib, hnb, hcb, hw, hh, hin, hth, hus, hro, hrw, hns, hs31, hcls, hfs, hg0, hg2
  have pb: P in bits(64) by taut(hs1)
  step o4 y, e2 from e with g.result64_inv using pb
  show by disj({2}, ex_intro({W}, {pair(P, y)}, simp(hs1, e2)))
qed

// size_to_class's spec at a call (the class table readable): an overflow,
// or the class of n returned, the memory as it was
theorem mp.s2c_q: all t sct tbl n regs o2. t in abi.World -> t in univ(1) -> n in bits(64) -> int_le(n, 131052) ->
  mallocng_specs.table_ok(t.vm, t.objs, sct, 2, mallocng.size_classes) -> mallocng_specs.table_ok(t.vm, t.objs, tbl, 1, mallocng.debruijn32_tab) ->
  abi.thread_ok(t.vm, t.fs_base) ->
  gc.regs_ok(regs, seq_one(gimple.arg(64, n))) ->
  runs(mallocng_specs.size_to_class_spec_fun(sct, tbl)[regs], t, o2) ->
  (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex r. o2 = ok(fn_update(t, "vm", t.vm), r) && mallocng_specs.class_of(n, bits_of_int(32, fst(r))))
proof
  fix t sct tbl n regs o2
  assume hw htu hnb hnl hts htb hth hro h
  have _ _ r0 := apply(gc.regs1, hnb, hro)
  have bp: bits_of_int(64, regs[0]) = n by defs(simp(r0, hnb), bits_of_int, pow2)
  have pv pf pd _ := apply(ms.world_parts, hw)
  have cex := mp(all_elim(mp.class_ex, {n}), (n in omega by simp(hnb)), hnl)
  step o3 cl k, e hk from h with bp, rewrite(sym(bp), cex) using hro, hw, htu, hnb, hnl, hts, htb, hth, pv
  have kb kc := hk
  step u y z, e2 hy from e with g.result32_inv using kb
  have _ yk := hy
  have ss: fn_update(t, "vm", t.vm) = t := mp(fn_update_same[f := t, k := "vm"], pf, pd)
  have cy: mallocng_specs.class_of(n, bits_of_int(32, fst(pair(y, z)))) by simp(rewrite(bp, kc), yk)
  have ret: ex r. o2 = ok(fn_update(t, "vm", t.vm), r) && mallocng_specs.class_of(n, bits_of_int(32, fst(r))) by ex_intro({pair(y, z)}, taut(rewrite(sym(ss), e2), cy))
  show by disj({2}, ret)
qed

// ----------------------------------------------------------------------
//  The run

// (the slot counts' entries: from 4 to 32)
theorem mp.scnt_vals: all j. j in omega -> int_lt(j, 27) ->
  mallocng.small_cnt_tab[j] in omega && int_le(4, mallocng.small_cnt_tab[j]) && int_le(mallocng.small_cnt_tab[j], 31)
proof
  fix j
  assume hj hl
  have k0: int_lt(j, 7) -> mallocng.small_cnt_tab[j] in omega && int_le(4, mallocng.small_cnt_tab[j]) && int_le(mallocng.small_cnt_tab[j], 31) proof
    assume hc
    have d: j = 0 || j = 1 || j = 2 || j = 3 || j = 4 || j = 5 || j = 6 by arith(hj, hc)
    show by simp(d, at({mallocng.small_cnt_tab[0]}), at({mallocng.small_cnt_tab[1]}), at({mallocng.small_cnt_tab[2]}), at({mallocng.small_cnt_tab[3]}),
      at({mallocng.small_cnt_tab[4]}), at({mallocng.small_cnt_tab[5]}), at({mallocng.small_cnt_tab[6]}))
  qed
  have k7: int_le(7, j) && int_lt(j, 14) -> mallocng.small_cnt_tab[j] in omega && int_le(4, mallocng.small_cnt_tab[j]) && int_le(mallocng.small_cnt_tab[j], 31) proof
    assume hc
    have d: j = 7 || j = 8 || j = 9 || j = 10 || j = 11 || j = 12 || j = 13 by arith(hj, hc)
    show by simp(d, at({mallocng.small_cnt_tab[7]}), at({mallocng.small_cnt_tab[8]}), at({mallocng.small_cnt_tab[9]}), at({mallocng.small_cnt_tab[10]}),
      at({mallocng.small_cnt_tab[11]}), at({mallocng.small_cnt_tab[12]}), at({mallocng.small_cnt_tab[13]}))
  qed
  have k14: int_le(14, j) && int_lt(j, 21) -> mallocng.small_cnt_tab[j] in omega && int_le(4, mallocng.small_cnt_tab[j]) && int_le(mallocng.small_cnt_tab[j], 31) proof
    assume hc
    have d: j = 14 || j = 15 || j = 16 || j = 17 || j = 18 || j = 19 || j = 20 by arith(hj, hc)
    show by simp(d, at({mallocng.small_cnt_tab[14]}), at({mallocng.small_cnt_tab[15]}), at({mallocng.small_cnt_tab[16]}), at({mallocng.small_cnt_tab[17]}),
      at({mallocng.small_cnt_tab[18]}), at({mallocng.small_cnt_tab[19]}), at({mallocng.small_cnt_tab[20]}))
  qed
  have k21: int_le(21, j) -> mallocng.small_cnt_tab[j] in omega && int_le(4, mallocng.small_cnt_tab[j]) && int_le(mallocng.small_cnt_tab[j], 31) proof
    assume hc
    have d: j = 21 || j = 22 || j = 23 || j = 24 || j = 25 || j = 26 by arith(hj, hl, hc)
    show by simp(d, at({mallocng.small_cnt_tab[21]}), at({mallocng.small_cnt_tab[22]}), at({mallocng.small_cnt_tab[23]}), at({mallocng.small_cnt_tab[24]}),
      at({mallocng.small_cnt_tab[25]}), at({mallocng.small_cnt_tab[26]}))
  qed
  show by taut(k0, k7, k14, k21, (int_lt(j, 7) || (int_le(7, j) && int_lt(j, 14)) || (int_le(14, j) && int_lt(j, 21)) || int_le(21, j) by arith(hj)))
qed

theorem mp.mcnt_vals: all j. j in omega -> int_lt(j, 4) ->
  mallocng.med_cnt_tab[j] in omega && int_le(20, mallocng.med_cnt_tab[j]) && int_le(mallocng.med_cnt_tab[j], 32)
proof
  fix j
  assume hj hl
  have d: j = 0 || j = 1 || j = 2 || j = 3 by arith(hj, hl)
  show by simp(d, at({mallocng.med_cnt_tab[0]}), at({mallocng.med_cnt_tab[1]}), at({mallocng.med_cnt_tab[2]}), at({mallocng.med_cnt_tab[3]}))
qed

// (multiplying by 2: GIMPLE's signed product's low half, the unsigned one)
theorem ms.imul_2: tr.imul_by(2)
proof
  have g: all y. y in bits(32) -> bits_add(32, int_mul(sint(32, y), sint(32, 2)), 0) = bits_mul(32, y, 2) proof
    fix y
    assume hy: y in bits(32)
    have c1: int_lt(y, 2147483648) -> bits_add(32, int_mul(sint(32, y), 2), 0) = bits_mul(32, y, 2) proof
      assume hl: int_lt(y, 2147483648)
      show by defs(simp(hy, hl), bits_add, bits_mul, sint)
    qed
    have c2: !int_lt(y, 2147483648) -> bits_add(32, int_mul(sint(32, y), 2), 0) = bits_mul(32, y, 2) proof
      assume hl: !int_lt(y, 2147483648)
      have e: int_mod(int_mul(int_sub(y, 4294967296), 2), 4294967296) = int_mod(int_mul(y, 2), 4294967296) by arith(hy)
      show by defs(simp(hy, hl, e), bits_add, bits_mul, sint)
    qed
    have e: bits_add(32, int_mul(sint(32, y), 2), 0) = bits_mul(32, y, 2) by taut(c1, c2)
    show by simp(e)
  qed
  show by defs(g, tr.imul_by)
qed

// (GIMPLE's unsigned 64-bit division by a nonzero word: the quotient)
theorem g.udiv64_det: all s a b. s in univ(1) -> a in bits(64) -> b in bits(64) -> !(b = 0) ->
  g.det(gimple.cdiv(64, a, b, false), s, ok(s, int_div(a, b)))
proof
  fix s a b
  assume hs ha hb hnz
  have a0: !int_lt(a, 0) by arith(ha)
  have b0: !int_lt(b, 0) by arith(hb)
  have ab: int_lt(a, 0) = int_lt(b, 0) by simp(a0, b0)
  have q: x86_64_linux.tdiv(a, b) = int_div(a, b) by defs(simp(ha, hb, a0, b0, ab), x86_64_linux.tdiv, int_abs)
  have bp: int_lt(0, b) by arith(hb, hnz)
  have qo _ := apply(div_nat[x := a, m := b], arith(ha), bp)
  have u: int_mul(int_sub(b, 1), int_div(a, b)) = int_mul(int_sub(b, 1), int_div(a, b)) := refl({int_mul(int_sub(b, 1), int_div(a, b))})
  have ql: int_le(int_div(a, b), a) by arith(ha, bp, qo, u)
  have w: bits_of_int(64, int_mod(int_div(a, b), pow2(64))) = int_div(a, b) by defs(arith(ha, qo, ql), bits_of_int, pow2)
  show proof
    fix o
    assume hr
    show by simp(expand(hr, gimple.cdiv, gimple.binop, gimple.arith, gimple.wrap, gimple.sval, runs, mkprog, bind_rel), hs, ha, hb, hnz, q, w)
  qed
qed

// (GIMPLE's bitfield store in a world: as ms.stbf_det, its memory's
// record facts from the world)
theorem ms.stbfw_det: all s p off size pos k v. s in abi.World -> s in univ(1) -> p in bits(64) -> off in bits(32) -> size in omega ->
  int_lt(size, 18446744073709551616) -> g.mem_defined(s, p, off, size, true) ->
  g.det(gimple.stbf(p, off, size, pos, k, v), s, ok(fn_update(s, "vm", fn_update(s.vm, "bytes", x86_64_linux.store_le(s.vm.bytes, int_add(p, off), size,
    int_add(bits_and(128, gimple.b128(gimple.bytes_at(s.vm, int_add(p, off), size)), bits_not(128, gimple.b128(int_mul(int_pow(2, pos), int_sub(int_pow(2, k), 1))))),
      int_mul(int_mod(v, int_pow(2, k)), int_pow(2, pos)))))), empty))
proof
  fix s p off size pos k v
  assume hw hs hp ho hn hn2 hd
  have pv pf pd _ := apply(ms.world_parts, hw)
  show := apply(ms.stbf_det, {s}, {p}, {off}, {size}, {pos}, {k}, {v}, hs, hp, ho, hn, hn2, hd, pv, pf, pd)
qed

// (a bitfield store's word: the old word o, its k bits at pos replaced by v's)
theorem mp.bfv(o, pos, k, v): o in omega -> int_lt(o, pow2(64)) -> pos in omega -> k in omega -> int_le(int_add(pos, k), 64) ->
  int_add(bits_and(128, gimple.b128(o), bits_not(128, gimple.b128(int_mul(int_pow(2, pos), int_sub(int_pow(2, k), 1))))), int_mul(int_mod(v, int_pow(2, k)), int_pow(2, pos))) =
  int_add(int_add(int_mul(int_mul(int_div(int_div(o, pow2(pos)), pow2(k)), pow2(k)), pow2(pos)), int_mul(int_mod(v, pow2(k)), pow2(pos))), int_mod(o, pow2(pos)))
proof
  assume ho hl hp hk hpk
  let X := int_add(int_add(int_mul(int_mul(int_div(int_div(o, pow2(pos)), pow2(k)), pow2(k)), pow2(pos)), int_mul(int_mod(v, pow2(k)), pow2(pos))), int_mod(o, pow2(pos)))
  have hx: X = int_add(int_mul(int_add(int_mul(int_div(int_div(o, pow2(pos)), pow2(k)), pow2(k)), int_mod(v, pow2(k))), pow2(pos)), int_mod(o, pow2(pos)))
    by arith(refl({int_mul(int_mul(int_div(int_div(o, pow2(pos)), pow2(k)), pow2(k)), pow2(pos))}), refl({int_mul(int_mod(v, pow2(k)), pow2(pos))}))
  show := sym(apply(tr.bf_val, {o}, {pos}, {k}, {v}, {v}, {X}, ho, hl, hp, hk, hpk, refl({int_mod(v, pow2(k))}), hx))
qed

// (the available mask: the slots up to the active index x)
theorem mp.av_val(x): x in omega -> int_lt(x, 32) ->
  bits_add(32, bits_shl(32, bits_of_int(32, 2), x), bits_neg(32, 1)) = int_sub(pow2(int_add(x, 1)), 1)
proof
  assume hx hl
  have pa := rewrite((pow2(1) = 2 by simp()), mp(all_elim(mp(all_elim(pow2_add, {x}), hx), {1}), simp()))
  have pp := mp(pow2_pos[k := int_add(x, 1)], arith(hx))
  have pl := apply(pow2_le[a := int_add(x, 1), b := 32], arith(hx), simp(), arith(hl))
  have p32: pow2(32) = 4294967296 by simp()
  have e2: int_mul(bits_of_int(32, 2), pow2(x)) = pow2(int_add(x, 1)) by arith(pa, (bits_of_int(32, 2) = 2 by defs(simp(), bits_of_int, pow2)))
  have sh: bits_shl(32, bits_of_int(32, 2), x) = int_mod(pow2(int_add(x, 1)), 4294967296) by defs(simp(e2, p32), bits_shl)
  have n1: bits_neg(32, 1) = 4294967295 by defs(simp(), bits_neg, pow2)
  show by defs(simp(sh, n1, p32, (int_mod(int_add(int_mod(pow2(int_add(x, 1)), 4294967296), 4294967295), 4294967296) = int_sub(pow2(int_add(x, 1)), 1)
    by arith(pp, rewrite(p32, pl)))), bits_add)
qed

// (the freed mask: the slots past x up to k)
theorem mp.fr_val(x, k): x in omega -> k in omega -> int_le(int_add(x, 1), k) -> int_le(k, 32) ->
  bits_add(32, bits_sub(32, bits_shl(32, bits_of_int(32, 2), int_sub(k, 1)), int_sub(pow2(int_add(x, 1)), 1)), bits_neg(32, 1)) =
  int_sub(pow2(k), pow2(int_add(x, 1)))
proof
  assume hx hk hxk hk32
  have k1: int_sub(k, 1) in omega by arith(hx, hxk)
  have ek: int_add(int_sub(k, 1), 1) = k by arith()
  have pa := rewrite(ek, rewrite((pow2(1) = 2 by simp()), mp(all_elim(mp(all_elim(pow2_add, {int_sub(k, 1)}), k1), {1}), simp())))
  have pk := apply(pow2_le[a := k, b := 32], hk, simp(), hk32)
  have px := apply(pow2_le[a := int_add(x, 1), b := k], arith(hx), hk, hxk)
  have pp := mp(pow2_pos[k := int_add(x, 1)], arith(hx))
  have p32: pow2(32) = 4294967296 by simp()
  have e2: int_mul(bits_of_int(32, 2), pow2(int_sub(k, 1))) = pow2(k) by arith(pa, (bits_of_int(32, 2) = 2 by defs(simp(), bits_of_int, pow2)))
  have sh: bits_shl(32, bits_of_int(32, 2), int_sub(k, 1)) = int_mod(pow2(k), 4294967296) by defs(simp(e2, p32), bits_shl)
  have n1: bits_neg(32, 1) = 4294967295 by defs(simp(), bits_neg, pow2)
  have q: int_mod(int_add(int_mod(int_sub(int_mod(pow2(k), 4294967296), int_sub(pow2(int_add(x, 1)), 1)), 4294967296), 4294967295), 4294967296) =
      int_sub(pow2(k), pow2(int_add(x, 1))) by arith(pp, px, rewrite(p32, pk))
  show by defs(simp(sh, n1, p32, q), bits_add, bits_sub)
qed

// (GIMPLE's element address in a table of 3-byte rows)
theorem g.elem3_det: all s p i. s in univ(1) -> p in bits(64) -> i in omega -> int_lt(i, 2147483648) ->
  int_lt(int_add(p, int_mul(3, i)), 18446744073709551616) ->
  g.det(gimple.elem(p, i, 3), s, ok(s, int_add(p, int_mul(3, i))))
proof
  fix s p i
  assume hs hp hi hl hpl
  let T64 := fn_update(fn_update(empty, "prec", 64), "signed", true)
  have ib: i in bits(64) by arith(hi, hl)
  have bi: bits_of_int(64, i) = i by defs(arith(hi, hl), bits_of_int, pow2)
  have si: sint(64, i) = i by defs(simp(bi, hi, hl), sint, pow2)
  have s3: sint(64, bits_of_int(64, 3)) = 3 by defs(simp(), sint, bits_of_int, pow2)
  have f: gimple.fits(T64, int_mul(i, 3)) by defs(simp(hi, hl), gimple.fits)
  have w: bits_of_int(64, gimple.wrap(T64, int_mul(i, 3))) = int_mul(3, i) by defs(simp(hi, hl), gimple.wrap, bits_of_int, pow2)
  have md: g.det(gimple.smul(64, i, bits_of_int(64, 3)), s, ok(s, int_mul(3, i))) proof
    fix o
    assume hr
    show by simp(expand(hr, gimple.smul, gimple.arith, runs, mkprog, bind_rel), hs, si, s3, ib, f, w)
  qed
  have db: int_mul(3, i) in bits(64) by arith(hi, hl)
  have sv: gimple.sval(T64, int_mul(3, i)) = int_mul(3, i) by defs(simp(hi, hl), gimple.sval)
  have p64: pow2(64) = 18446744073709551616 by simp()
  have pd := apply(g.padd_det, {s}, {p}, {int_mul(3, i)}, hs, hp, db, (int_le(0, int_add(p, gimple.sval(T64, int_mul(3, i)))) by simp(sv, hp, hi)),
    (int_lt(int_add(p, gimple.sval(T64, int_mul(3, i))), pow2(64)) by simp(sv, hpl, p64)))
  show proof
    fix o
    assume hr
    have b1 := apply(g.bind_inv, apply(g.runs_elim, expand(hr, gimple.elem)), md)
    show := apply(g.bind_inv, b1, rewrite(sv, pd))
  qed
qed

// (from A on s's memory to A1 on V, as alloc_meta's outcome -- nothing
// outside the allocator touched but errno, grown only into memory unmapped
// before, errno's pages kept: the thread pointer sound, errno usable and
// apart, the thread's block apart)
theorem mp.agr_side(c, A, A1, B, s, V): s in abi.World -> abi.thread_ok(s.vm, s.fs_base) ->
  mallocng_specs.tls_apart(c, A, B, s.fs_base) -> mallocng_specs.errno_ok(s.vm, s.objs, s.fs_base) -> mallocng_specs.errno_apart(c, A, B, s.vm, s.fs_base) ->
  mallocng.untouched(c, A, B, s.vm, V, mp.errno(s.fs_base)) -> mp.grown(c, A1, A, B, s.vm) -> mp.am_epg(s, V) ->
  thread: abi.thread_ok(V, s.fs_base) && errno: mallocng_specs.errno_ok(V, s.objs, s.fs_base) &&
  tls: mallocng_specs.tls_apart(c, A1, B, s.fs_base) && apart: mallocng_specs.errno_apart(c, A1, B, V, s.fs_base)
proof
  assume hw ht htl heo hea su sgr sep
  have fsb: s.fs_base in bits(64) by simp(expand(hw, abi.World))
  have efl eus _ := expand(heo, mallocng_specs.errno_ok)
  have hfl: int_le(int_add(s.fs_base, 56), int_pow(2, 64)) by arith(efl, fsb)
  have ne: all i. i in omega -> int_lt(i, 8) -> !(int_add(s.fs_base, i) in mp.errno(s.fs_base)) proof
    fix i
    assume hi hil
    assume he
    have e1 _ := (int_le(int_add(s.fs_base, 52), int_add(s.fs_base, i)) && int_lt(int_add(s.fs_base, i), int_add(s.fs_base, 56)) by simp(he))
    show by arith(e1, hil)
  qed
  have th := apply(mp.tls_kept[c := c, A := A, b := B, V0 := s.vm, V1 := V, fs := s.fs_base, e := mp.errno(s.fs_base)], fsb, ht, htl, su, ne)
  have tl := apply(mp.tls_grown[c := c, A := A, A2 := A1, b := B, vm := s.vm, fs := s.fs_base], fsb, ht, htl, sgr)
  have ea: mallocng_specs.errno_at(s.fs_base) = int_add(s.fs_base, 52) by defs(arith(fsb, hfl), mallocng_specs.errno_at, bits_add, pow2)
  have pe: all i. i in omega -> int_lt(i, 4) ->
      V.pages[int_div(int_add(mallocng_specs.errno_at(s.fs_base), i), x86_64_linux.PAGE)] = s.vm.pages[int_div(int_add(mallocng_specs.errno_at(s.fs_base), i), x86_64_linux.PAGE)] proof
    fix i
    assume hi hil
    show := rewrite(sym(ea), mp(all_elim(sep, {i}), hi, hil))
  qed
  have us := apply(mp.usable_pg[vm := s.vm, vm2 := V, objs := s.objs, a := mallocng_specs.errno_at(s.fs_base), n := 4, w := true], pe, eus)
  have eo: mallocng_specs.errno_ok(V, s.objs, s.fs_base) by defs(taut(efl, us, th), mallocng_specs.errno_ok)
  have eout := apply(mp.errno_out[c := c, A := A, A1 := A1, B := B, V0 := s.vm, fs := s.fs_base], hea, fsb, hfl, sgr)
  have ap: all i. i in omega -> int_lt(i, 4) -> !(int_add(mallocng_specs.errno_at(s.fs_base), i) in mallocng.footprint(c, A1, B)) &&
      x86_64_linux.mapped(V, int_div(int_add(mallocng_specs.errno_at(s.fs_base), i), x86_64_linux.PAGE)) proof
    fix i
    assume hi hil
    let a := int_add(mallocng_specs.errno_at(s.fs_base), i)
    have ao: a in omega by arith(ea, hi, fsb)
    have he: a in mp.errno(s.fs_base) by simp((a in omega && int_le(int_add(s.fs_base, 52), a) && int_lt(a, int_add(s.fs_base, 56)) by arith(ea, hi, hil, fsb)))
    have nf: !(a in mallocng.footprint(c, A1, B)) proof
      assume f
      show by taut(mp(all_elim(eout, {a}), ao, f), he)
    qed
    have _ m0 := mp(all_elim(expand(hea, mallocng_specs.errno_apart), {i}), hi, hil)
    have ml mn := expand(m0, x86_64_linux.mapped)
    have p := mp(all_elim(pe, {i}), hi, hil)
    show by taut(nf, (x86_64_linux.mapped(V, int_div(a, x86_64_linux.PAGE)) by defs(taut(ml, rewrite(sym(p), mn)), x86_64_linux.mapped)))
  qed
  show by taut(th, eo, tl, (mallocng_specs.errno_apart(c, A1, B, V, s.fs_base) by defs(ap, mallocng_specs.errno_apart)))
qed

// (the context's free bytes changed only: errno usable as before)
theorem mp.co_errno(c, vm, vm2, objs, fs): mallocng_specs.ctx_only(c, vm, vm2) -> mallocng_specs.errno_ok(vm, objs, fs) -> abi.thread_ok(vm2, fs) ->
  mallocng_specs.errno_ok(vm2, objs, fs)
proof
  assume hco heo ht
  have er _ := expand(hco, mallocng_specs.ctx_only)
  have up := mp(app_update_other[f := vm2, k := "bytes", v := vm.bytes, x := "pages"], (!("pages" = "bytes") by simp()))
  have ep: vm2.pages = vm.pages := sym(rewrite(er, up))
  have efl eus _ := expand(heo, mallocng_specs.errno_ok)
  have pe: all i. i in omega -> int_lt(i, 4) ->
      vm2.pages[int_div(int_add(mallocng_specs.errno_at(fs), i), x86_64_linux.PAGE)] = vm.pages[int_div(int_add(mallocng_specs.errno_at(fs), i), x86_64_linux.PAGE)] proof
    fix i
    assume _ _
    show by simp(ep)
  qed
  have us := apply(mp.usable_pg[vm := vm, vm2 := vm2, objs := objs, a := mallocng_specs.errno_at(fs), n := 4, w := true], pe, eus)
  show by defs(taut(efl, us, ht), mallocng_specs.errno_ok)
qed

// (errno written, apart from A's footprint: the invariant kept, nothing
// else touched, the pages as before)
theorem mp.agr_errw(c, A, B, V, fs, e): mallocng.holds_in(c, A, V, B) -> V in x86_64_linux.Vm -> fs in bits(64) -> int_le(int_add(fs, 56), int_pow(2, 64)) ->
  (all a. a in omega -> a in mallocng.footprint(c, A, B) -> !(a in mp.errno(fs))) ->
  hin: mallocng.holds_in(c, A, mallocng_specs.wr32(V, mallocng_specs.errno_at(fs), e), B) &&
  unt: mallocng.untouched(c, A, B, V, mallocng_specs.wr32(V, mallocng_specs.errno_at(fs), e), mp.errno(fs)) &&
  pages: mallocng_specs.wr32(V, mallocng_specs.errno_at(fs), e).pages = V.pages && vm: mallocng_specs.wr32(V, mallocng_specs.errno_at(fs), e) in x86_64_linux.Vm
proof
  assume hh hv fsb hfl eo
  let V2 := mallocng_specs.wr32(V, mallocng_specs.errno_at(fs), e)
  have ea: mallocng_specs.errno_at(fs) = int_add(fs, 52) by defs(arith(fsb, hfl), mallocng_specs.errno_at, bits_add, pow2)
  have eab: int_add(fs, 52) in bits(64) by arith(fsb, hfl)
  have out: all x. x in bits(64) -> !(x in mp.errno(fs)) -> V2.bytes[x] = V.bytes[x] proof
    fix x
    assume hx hn
    have o: int_le(int_add(int_add(fs, 52), 4), x) || int_lt(x, int_add(fs, 52)) proof
      have k: !(int_le(int_add(fs, 52), x) && int_lt(x, int_add(fs, 56))) proof
        assume q
        have q1 q2 := q
        show by taut(hn, (x in mp.errno(fs) by simp(q1, q2, (x in omega by arith(hx)))))
      qed
      show by arith(k, hx)
    qed
    show := rewrite(sym(ea), apply(mp.wr32_out[V := V, c := int_add(fs, 52), v := e, x := x], hx, eab, arith(fsb, hfl), o))
  qed
  have rest: fn_update(V2, "bytes", V.bytes) = V by simp(mp(fn_update_same[f := V, k := "bytes"], simp(expand(hv, x86_64_linux.Vm)), simp(expand(hv, x86_64_linux.Vm))), keep(mallocng_specs.errno_at), all_elim(ms.v_wr32, {V}, {mallocng_specs.errno_at(fs)}, {e}))
  have v2V := apply(mp.w32_vm[V := V, c := mallocng_specs.errno_at(fs), v := e], hv)
  have hfp: all x. x in bits(64) -> x in mallocng.footprint(c, A, B) -> V2.bytes[x] = V.bytes[x] proof
    fix x
    assume hx hf
    have xo: x in omega by arith(hx)
    show := mp(all_elim(out, {x}), hx, mp(all_elim(eo, {x}), xo, hf))
  qed
  have hh2 := apply(mp.out_holds[c := c, A := A, vm := V, vm2 := V2, b := B], hh, rest, hfp)
  have u1 := mp(app_update_other[f := V2, k := "bytes", v := V.bytes, x := "pages"], (!("pages" = "bytes") by simp()))
  have u2 := mp(app_update_other[f := V2, k := "bytes", v := V.bytes, x := "brk_start"], (!("brk_start" = "bytes") by simp()))
  have ep: V2.pages = V.pages := sym(rewrite(rest, u1))
  have eb: V2.brk_start = V.brk_start := sym(rewrite(rest, u2))
  have r: all x0. x0 in omega -> (!(x0 in mallocng.footprint(c, A, B)) && !(x0 in mp.errno(fs))) && x86_64_linux.mapped(V, int_div(x0, x86_64_linux.PAGE)) ->
      V2.bytes[bits_of_int(64, x0)] = V.bytes[bits_of_int(64, x0)] && V2.pages[int_div(x0, x86_64_linux.PAGE)] = V.pages[int_div(x0, x86_64_linux.PAGE)] proof
    fix a
    assume ho hq
    have _ n2 m0 := hq
    have ml _ := expand(m0, x86_64_linux.mapped)
    have ab: bits_of_int(64, a) = a by defs(arith(ho, expand(ml, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)), bits_of_int, pow2)
    have bb := rewrite(sym(ab), mp(all_elim(out, {a}), (a in bits(64) by arith(ho, expand(ml, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))), n2))
    show by taut(bb, (V2.pages[int_div(a, x86_64_linux.PAGE)] = V.pages[int_div(a, x86_64_linux.PAGE)] by simp(ep)))
  qed
  have un: mallocng.untouched(c, A, B, V, V2, mp.errno(fs)) by defs(taut(r, eb), mallocng.untouched)
  show by taut(hh2, un, ep, v2V)
qed

// (memory with the same pages: a meta as joinable, its bytes as accessible)
theorem mp.mj_pages(vm, vm2, objs, ph, l, m): vm2.pages = vm.pages -> mallocng_specs.meta_joinable(vm, objs, ph, l, m) ->
  mallocng_specs.meta_joinable(vm2, objs, ph, l, m)
proof
  assume ep hj
  have j1 j2 j3 j4 j5 j6 j7 := expand(hj, mallocng_specs.meta_joinable)
  have pe: all i. i in omega -> int_lt(i, 40) -> vm2.pages[int_div(int_add(m, i), x86_64_linux.PAGE)] = vm.pages[int_div(int_add(m, i), x86_64_linux.PAGE)] proof
    fix i
    assume _ _
    show by simp(ep)
  qed
  have r := apply(mp.usable_pg[vm := vm, vm2 := vm2, objs := objs, a := m, n := 40, w := false], pe, j4)
  have w := apply(mp.usable_pg[vm := vm, vm2 := vm2, objs := objs, a := m, n := 40, w := true], pe, j5)
  show by defs(taut(j1, j2, j3, r, w, j6, j7), mallocng_specs.meta_joinable)
qed

theorem mp.rw40_pages(vm, vm2, m): vm2.pages = vm.pages ->
  (all a. a in omega -> int_le(m, a) -> int_lt(a, int_add(m, 40)) ->
     mallocng.m_rw(mallocng.mview(vm, mallocng.all_bytes()), a) && !(snd(mallocng.pg(mallocng.mview(vm, mallocng.all_bytes()), a)).kind = 2)) ->
  (all a. a in omega -> int_le(m, a) -> int_lt(a, int_add(m, 40)) ->
     mallocng.m_rw(mallocng.mview(vm2, mallocng.all_bytes()), a) && !(snd(mallocng.pg(mallocng.mview(vm2, mallocng.all_bytes()), a)).kind = 2))
proof
  assume ep h
  fix a
  assume ho h1 h2
  have r k := mp(all_elim(h, {a}), ho, h1, h2)
  have e: mallocng.pg(mallocng.mview(vm2, mallocng.all_bytes()), a) = mallocng.pg(mallocng.mview(vm, mallocng.all_bytes()), a) by defs(simp(ep, ho), mallocng.pg, mallocng.mview, mallocng.all_bytes)
  have {rw = rw} := apply(mp.pg_same, e)
  show by taut(rw, r, rewrite(sym(e), k))
qed

// (mmap of N bytes, a multiple of pages, at a place p it chose: its pages
// unmapped before, in user space; the pages mapped before as they were,
// their bytes too; the new bytes 0)
theorem mp.mm_fresh(V3, V4, p, N, PG): p in omega -> N in omega -> int_mod(N, 4096) = 0 -> int_lt(0, N) ->
  mallocng_specs.mmap_place(V3, 0, N, bits_of_int(32, 34), p) -> mallocng_specs.fresh_pages(V3, V4, p, x86_64_linux.pages_for(N), PG) ->
  npg: x86_64_linux.pages_for(N) = int_div(N, 4096) && one: int_le(1, p) && low: int_le(int_add(int_mul(p, 4096), N), 140737488351232) &&
  unm: (all q. q in omega -> int_le(p, q) -> int_lt(q, int_add(p, int_div(N, 4096))) -> !x86_64_linux.mapped(V3, q)) &&
  pages: (all q. q in omega -> x86_64_linux.mapped(V3, q) -> V4.pages[q] = V3.pages[q]) &&
  newpg: (all q. q in omega -> int_le(p, q) -> int_lt(q, int_add(p, int_div(N, 4096))) -> V4.pages[q] = some(PG)) &&
  bytes: (all y. y in bits(64) -> x86_64_linux.mapped(V3, int_div(y, x86_64_linux.PAGE)) -> V4.bytes[y] = V3.bytes[y]) &&
  zero: (all y. y in bits(64) -> int_le(int_mul(p, 4096), y) -> int_lt(y, int_add(int_mul(p, 4096), N)) -> V4.bytes[y] = 0) &&
  top: V4.stack_top = V3.stack_top && lim: V4.stack_limit = V3.stack_limit && start: V4.brk_start = V3.brk_start
proof
  assume hp hn hal hnz hpl hfr
  have pg: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
  have nf: x86_64_linux.pages_for(N) = int_div(N, 4096) by defs(arith(hn, hal, hnz), x86_64_linux.pages_for, x86_64_linux.PAGE)
  let NP := int_div(N, 4096)
  have mc: !(bits_of_int(32, 34) = int_add(int_add(x86_64_linux.MAP_PRIVATE, x86_64_linux.MAP_ANONYMOUS), x86_64_linux.MAP_FIXED)) by defs(simp(), x86_64_linux.MAP_PRIVATE,
    x86_64_linux.MAP_ANONYMOUS, x86_64_linux.MAP_FIXED)
  have pl := expand(hpl, mallocng_specs.mmap_place)
  have p1 pfree := (int_le(1, p) && x86_64_linux.free_range(V3, p, x86_64_linux.pages_for(N)) by simp(pl, mc))
  have fr1 fr2 _ := expand(rewrite(nf, pfree), x86_64_linux.free_range)
  have ts: int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE) = 34359738367 by defs(simp(), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
  have pnb: int_le(int_add(p, NP), 34359738367) := rewrite(ts, fr1)
  have low: int_le(int_add(int_mul(p, 4096), N), 140737488351232) by arith(pnb, hp, hn, hal)
  have xt xl xs xpg xby := expand(rewrite(nf, hfr), mallocng_specs.fresh_pages)
  have unm: all q. q in omega -> int_le(p, q) -> int_lt(q, int_add(p, NP)) -> !x86_64_linux.mapped(V3, q) proof
    fix q
    assume hq h1 h2
    show := mp(all_elim(fr2, {q}), hq, taut(h1, h2))
  qed
  have xp: all q. q in omega -> x86_64_linux.mapped(V3, q) -> V4.pages[q] = V3.pages[q] proof
    fix q
    assume hq m
    have ml _ := expand(m, x86_64_linux.mapped)
    have nr: !(int_le(p, q) && int_lt(q, int_add(p, NP))) proof
      assume i
      have i1 i2 := i
      show by taut(mp(all_elim(unm, {q}), hq, i1, i2), m)
    qed
    show by simp(mp(all_elim(xpg, {q}), hq, ml), nr)
  qed
  have np: all q. q in omega -> int_le(p, q) -> int_lt(q, int_add(p, NP)) -> V4.pages[q] = some(PG) proof
    fix q
    assume hq h1 h2
    have qt: int_lt(q, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) by arith(ts, pnb, h2)
    show by simp(mp(all_elim(xpg, {q}), hq, qt), h1, h2)
  qed
  have xb: all y. y in bits(64) -> x86_64_linux.mapped(V3, int_div(y, x86_64_linux.PAGE)) -> V4.bytes[y] = V3.bytes[y] proof
    fix y
    assume hy m
    have qo: int_div(y, x86_64_linux.PAGE) in omega by defs(arith(hy), x86_64_linux.PAGE)
    have nr: !(int_le(p, int_div(y, x86_64_linux.PAGE)) && int_lt(int_div(y, x86_64_linux.PAGE), int_add(p, NP))) proof
      assume i
      have i1 i2 := i
      show by taut(mp(all_elim(unm, {int_div(y, x86_64_linux.PAGE)}), qo, i1, i2), m)
    qed
    have nb: !(int_le(int_mul(p, x86_64_linux.PAGE), y) && int_lt(y, int_mul(int_add(p, NP), x86_64_linux.PAGE))) by arith(nr, pg, hy, hp)
    show by simp(mp(all_elim(xby, {y}), hy), nb)
  qed
  have xz: all y. y in bits(64) -> int_le(int_mul(p, 4096), y) -> int_lt(y, int_add(int_mul(p, 4096), N)) -> V4.bytes[y] = 0 proof
    fix y
    assume hy h1 h2
    have ib: int_le(int_mul(p, x86_64_linux.PAGE), y) && int_lt(y, int_mul(int_add(p, NP), x86_64_linux.PAGE)) by arith(pg, h1, h2, hal, hn)
    show by simp(mp(all_elim(xby, {y}), hy), ib)
  qed
  show by taut(nf, p1, low, unm, xp, np, xb, xz, xt, xl, xs)
qed

// (two memories agreeing at a's byte and page, if a is seen: their views
// at a)
theorem mp.view_pt(vm, vm2, fp, a): a in omega ->
  (a in fp -> vm2.bytes[bits_of_int(64, a)] = vm.bytes[bits_of_int(64, a)] && vm2.pages[int_div(a, x86_64_linux.PAGE)] = vm.pages[int_div(a, x86_64_linux.PAGE)]) ->
  mallocng.mview(vm2, fp)[a] = mallocng.mview(vm, fp)[a]
proof
  assume hao eb
  have a2 := mp(app_fn_build[d := omega, v := x. ite(x in fp, some(pair(vm2.bytes[bits_of_int(64, x)], vm2.pages[int_div(x, x86_64_linux.PAGE)])), none), a := a], hao)
  have a1 := mp(app_fn_build[d := omega, v := x. ite(x in fp, some(pair(vm.bytes[bits_of_int(64, x)], vm.pages[int_div(x, x86_64_linux.PAGE)])), none), a := a], hao)
  have c1: a in fp -> mallocng.mview(vm2, fp)[a] = mallocng.mview(vm, fp)[a] proof
    assume h
    have e1 e2 := mp(eb, h)
    show by defs(simp(a2, a1, e1, e2, h), mallocng.mview)
  qed
  have c2: !(a in fp) -> mallocng.mview(vm2, fp)[a] = mallocng.mview(vm, fp)[a] proof
    assume h
    show by defs(simp(a2, a1, h), mallocng.mview)
  qed
  show by taut(c1, c2)
qed

// (a byte read-write in memory's view: on a mapped page)
theorem mp.rw_mapped(vm, a): a in omega -> mallocng.m_rw(mallocng.mview(vm, mallocng.all_bytes()), a) -> x86_64_linux.mapped(vm, int_div(a, x86_64_linux.PAGE))
proof
  assume hao r
  have mm0 _ _ := expand(r, mallocng.m_rw)
  have mb mn := expand(mm0, mallocng.m_mapped)
  have p0 := apply(mp.pg_view[vm := vm, fp := mallocng.all_bytes(), a := a], hao, (a in mallocng.all_bytes() by defs(sel(taut(hao)), mallocng.all_bytes)))
  show by defs(taut(mb, rewrite(p0, mn)), x86_64_linux.mapped)
qed

// (memory changed only on pages unmapped before -- an mmap's fresh pages --,
// the break as before: the invariant kept)
theorem mp.mm_holds(c, A, vm, V2, b): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_in(c, A, vm, b) ->
  (all q. q in omega -> x86_64_linux.mapped(vm, q) -> V2.pages[q] = vm.pages[q]) ->
  (all y. y in bits(64) -> x86_64_linux.mapped(vm, int_div(y, x86_64_linux.PAGE)) -> V2.bytes[y] = vm.bytes[y]) -> V2.brk = vm.brk ->
  mallocng.holds_in(c, A, V2, b)
proof
  assume hc hu ha hh hpg hby hbk
  have {H = inv, hm = mapped, hfr = free, hrw = rw} := expand(hh, mallocng.holds_in)
  have kp: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
  // (a page mapped: as before, so mapped still)
  have pq: all a. a in omega -> x86_64_linux.mapped(vm, int_div(a, x86_64_linux.PAGE)) -> V2.pages[int_div(a, x86_64_linux.PAGE)] = vm.pages[int_div(a, x86_64_linux.PAGE)] proof
    fix a
    assume hao m
    show := mp(all_elim(hpg, {int_div(a, x86_64_linux.PAGE)}), (int_div(a, x86_64_linux.PAGE) in omega by arith(kp, hao)), m)
  qed
  have mm: all a. a in omega -> x86_64_linux.mapped(vm, int_div(a, x86_64_linux.PAGE)) -> x86_64_linux.mapped(V2, int_div(a, x86_64_linux.PAGE)) proof
    fix a
    assume hao m
    have ml mn := expand(m, x86_64_linux.mapped)
    show by defs(taut(ml, rewrite(sym(mp(all_elim(pq, {a}), hao, m)), mn)), x86_64_linux.mapped)
  qed
  // (a byte read-write in a view: on a mapped page)
  have rwm: all a. a in omega -> mallocng.m_rw(mallocng.mview(vm, mallocng.all_bytes()), a) -> x86_64_linux.mapped(vm, int_div(a, x86_64_linux.PAGE)) proof
    fix a
    assume hao r
    show := apply(mp.rw_mapped[vm := vm, a := a], hao, r)
  qed
  // (the footprint: mapped)
  have fm: all a. a in omega -> a in mallocng.footprint(c, A, b) -> x86_64_linux.mapped(vm, int_div(a, x86_64_linux.PAGE)) proof
    fix a
    assume hao hf
    have s1 := set_select_def[s := omega, p := y. y in mallocng.fp_set(mallocng.fp_ranges(c, A), b) && !mallocng.in_reserved(A, y) && !mallocng.in_taken(A, y), z := a]
    have _ af _ := (a in omega && a in mallocng.fp_set(mallocng.fp_ranges(c, A), b) && !mallocng.in_reserved(A, a) by taut(s1, expand(hf, mallocng.footprint)))
    have s2 := set_select_def[s := omega, p := y. mallocng.in_ranges(y, mallocng.fp_ranges(c, A)) && !(y in malloc.live_of(b)), z := a]
    have _ ir nl := (a in omega && mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) && !(a in malloc.live_of(b)) by taut(s2, expand(af, mallocng.fp_set)))
    obtain k, hk hkl hr from expand(ir, mallocng.in_ranges)
    have r1 r2 := expand(hr, mallocng.in_range)
    show := mp(all_elim(expand(hm, mallocng.fp_mapped), {k}, {a}), taut(hk, hao), taut(hkl, r1, r2, nl))
  qed
  // the invariant's view: its bytes the footprint's, on pages mapped
  have ag: all a. a in omega -> mallocng.mview(V2, mallocng.held(c, A, b))[a] = mallocng.mview(vm, mallocng.held(c, A, b))[a] proof
    fix a
    assume hao
    have e: a in mallocng.held(c, A, b) -> V2.bytes[bits_of_int(64, a)] = vm.bytes[bits_of_int(64, a)] &&
        V2.pages[int_div(a, x86_64_linux.PAGE)] = vm.pages[int_div(a, x86_64_linux.PAGE)] proof
      assume h
      have {f = fp} := apply(mp.held_fp, h)
      have m := mp(all_elim(fm, {a}), hao, f)
      have lo := apply(mp.fp_low[c := c, A := A, vm := vm, b := b, a := a], hm, f)
      have ab: bits_of_int(64, a) = a by defs(arith(hao, lo), bits_of_int, pow2)
      have b0 := mp(all_elim(hby, {a}), (a in bits(64) by arith(hao, lo)), m)
      show by taut(rewrite(sym(ab), b0), mp(all_elim(pq, {a}), hao, m))
    qed
    show := apply(mp.view_pt[vm := vm, vm2 := V2, fp := mallocng.held(c, A, b), a := a], hao, e)
  qed
  have ve := apply(mp.view_ext[vm := vm, vm2 := V2, fp := mallocng.held(c, A, b)], ag)
  have i2 := rewrite(sym(hbk), rewrite(sym(ve), H))
  // the owned bytes: mapped still
  have mq: all x0. all x1. x0 in omega && x1 in omega -> ((int_lt(x0, seq_len(mallocng.fp_ranges(c, A))) && int_le(fst(mallocng.fp_ranges(c, A)[x0]), x1)) &&
      int_lt(x1, int_add(fst(mallocng.fp_ranges(c, A)[x0]), snd(mallocng.fp_ranges(c, A)[x0])))) && !(x1 in malloc.live_of(b)) ->
      x86_64_linux.mapped(V2, int_div(x1, x86_64_linux.PAGE)) proof
    fix k a
    assume ho h
    have _ hao := ho
    have m := mp(all_elim(expand(hm, mallocng.fp_mapped), {k}, {a}), ho, h)
    show := mp(all_elim(mm, {a}), hao, m)
  qed
  have m2: mallocng.fp_mapped(mallocng.fp_ranges(c, A), b, V2) by defs(mq, mallocng.fp_mapped)
  // the free bytes, the groups' bytes: read-write still
  have fq: all a. a in omega -> mallocng.ctx_free(c, a) -> mallocng.m_rw(mallocng.mview(V2, mallocng.footprint(c, A, b)), a) &&
      !(snd(mallocng.pg(mallocng.mview(V2, mallocng.footprint(c, A, b)), a)).kind = 2) proof
    fix a
    assume hao hfa
    have o1 o2 := mp(all_elim(expand(hfr, mallocng.free_rw), {a}), hao, hfa)
    have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
    have i1 i2 := (int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE))
      by arith(expand(hfa, mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK), ks))
    have f := apply(mp.ctx_fp[c := c, A := A, vm := vm, b := b, a := a], hc, hu, ha, hh, hao, i1, i2)
    have ep := mp(all_elim(pq, {a}), hao, mp(all_elim(fm, {a}), hao, f))
    have pe := apply(mp.view_pg1[vm := vm, vm2 := V2, fp := mallocng.footprint(c, A, b), a := a], hao, ep)
    have {rw = rw} := apply(mp.pg_same, pe)
    show by taut(rw, o1, rewrite(sym(pe), o2))
  qed
  have f2: mallocng.free_rw(c, mallocng.mview(V2, mallocng.footprint(c, A, b))) by defs(fq, mallocng.free_rw)
  have gq: all x0. all x1. x0 in omega && x1 in omega -> (mallocng.is_used(A, x0) && mallocng.in_range(x1, mallocng.group_range(A.metas[x0]))) &&
      ((x1 in mallocng.footprint(c, A, b) || x1 in malloc.live_of(b)) || mallocng.in_reserved(A, x1)) ->
      mallocng.m_rw(mallocng.mview(V2, mallocng.all_bytes()), x1) && !(snd(mallocng.pg(mallocng.mview(V2, mallocng.all_bytes()), x1)).kind = 2) proof
    fix g a
    assume ho h
    have _ hao := ho
    have o1 o2 := mp(all_elim(expand(hrw, mallocng.grp_rw), {g}, {a}), ho, h)
    have ep := mp(all_elim(pq, {a}), hao, mp(all_elim(rwm, {a}), hao, o1))
    have pe := apply(mp.view_pg1[vm := vm, vm2 := V2, fp := mallocng.all_bytes(), a := a], hao, ep)
    have {rw = rw} := apply(mp.pg_same, pe)
    show by taut(rw, o1, rewrite(sym(pe), o2))
  qed
  have g2: mallocng.grp_rw(c, A, V2, b) by defs(gq, mallocng.grp_rw)
  show by defs(taut(i2, m2, f2, g2), mallocng.holds_in)
qed

// (bytes on pages mmap gave read-write: usable)
theorem mp.fresh_usable(V, objs, p, N, a, n, w): p in omega -> N in omega -> a in omega -> n in omega ->
  (all q. q in omega -> int_le(p, q) -> int_lt(q, int_add(p, int_div(N, 4096))) ->
     V.pages[q] = some(fn_update(fn_update(empty, "prot", x86_64_linux.prot_of(bits_of_int(32, 3))), "kind", 0))) ->
  int_le(int_add(int_mul(p, 4096), N), 140737488351232) -> int_mod(N, 4096) = 0 ->
  int_le(int_mul(p, 4096), a) -> int_le(int_add(a, n), int_add(int_mul(p, 4096), N)) -> gimple.usable(V, objs, a, n, w)
proof
  assume hp hn ha hnn np low al h1 h2
  have pg: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
  have ts: int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE) = 34359738367 by defs(simp(), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
  have pr: x86_64_linux.prot_of(bits_of_int(32, 3)).r && x86_64_linux.prot_of(bits_of_int(32, 3)).w by defs(simp(), x86_64_linux.prot_of)
  have pr1 pr2 := pr
  have each: all i. i in omega -> int_lt(i, n) ->
      ite(x86_64_linux.mapped(V, int_div(int_add(a, i), x86_64_linux.PAGE)) && !(snd(V.pages[int_div(int_add(a, i), x86_64_linux.PAGE)]).kind = 2),
        ite(w, snd(V.pages[int_div(int_add(a, i), x86_64_linux.PAGE)]).prot.w, snd(V.pages[int_div(int_add(a, i), x86_64_linux.PAGE)]).prot.r),
        int_lt(int_add(a, i), int_pow(2, 64)) && int_add(a, i) in objs) proof
    fix i
    assume hi hil
    let q := int_div(int_add(a, i), x86_64_linux.PAGE)
    have qo: q in omega by arith(pg, ha, hi)
    have q1: int_le(p, q) by arith(pg, h1, ha, hi)
    have q2: int_lt(q, int_add(p, int_div(N, 4096))) by arith(pg, h2, hil, hi, ha, al, hn)
    have e := mp(all_elim(np, {q}), qo, q1, q2)
    have qt: int_lt(q, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) by arith(ts, q2, low, pg, hp, hn, al)
    have m: x86_64_linux.mapped(V, q) by defs(simp(e, qt), x86_64_linux.mapped)
    show by simp(m, e, pr1, pr2)
  qed
  show by defs(each, gimple.usable)
qed

// (a byte of fresh pages: read-write, not the stack)
theorem mp.fresh_rw(V, p, N, a): p in omega -> N in omega -> a in omega ->
  (all q. q in omega -> int_le(p, q) -> int_lt(q, int_add(p, int_div(N, 4096))) ->
     V.pages[q] = some(fn_update(fn_update(empty, "prot", x86_64_linux.prot_of(bits_of_int(32, 3))), "kind", 0))) ->
  int_le(int_add(int_mul(p, 4096), N), 140737488351232) -> int_mod(N, 4096) = 0 ->
  int_le(int_mul(p, 4096), a) -> int_lt(a, int_add(int_mul(p, 4096), N)) ->
  mallocng.m_rw(mallocng.mview(V, mallocng.all_bytes()), a) && !(snd(mallocng.pg(mallocng.mview(V, mallocng.all_bytes()), a)).kind = 2)
proof
  assume hp hn ha np low al h1 h2
  have pg: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
  have ts: int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE) = 34359738367 by defs(simp(), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
  have pr: x86_64_linux.prot_of(bits_of_int(32, 3)).r && x86_64_linux.prot_of(bits_of_int(32, 3)).w by defs(simp(), x86_64_linux.prot_of)
  have pr1 pr2 := pr
  let q := int_div(a, x86_64_linux.PAGE)
  have q1: int_le(p, q) by arith(pg, h1, ha)
  have q2: int_lt(q, int_add(p, int_div(N, 4096))) by arith(pg, h2, ha, al, hn)
  have e := mp(all_elim(np, {q}), arith(pg, ha), q1, q2)
  have qt: int_lt(q, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) by arith(ts, q2, low, pg, hp, hn, al)
  have p0 := apply(mp.pg_view[vm := V, fp := mallocng.all_bytes(), a := a], ha, (a in mallocng.all_bytes() by defs(sel(taut(ha)), mallocng.all_bytes)))
  show by defs(simp(p0, e, qt, pr1, pr2), mallocng.m_rw, mallocng.m_mapped)
qed

// (the thread pointer's word, mapped at the entry and not the allocator's:
// apart from the meta alloc_meta took)
theorem mp.fs_meta(c, A, B, s, M): s.fs_base in bits(64) -> M in omega -> !(M = 0) -> abi.thread_ok(s.vm, s.fs_base) ->
  mallocng_specs.tls_apart(c, A, B, s.fs_base) -> mp.am_mfp(c, A, B, s, M) ->
  int_le(int_add(s.fs_base, 8), M) || int_le(int_add(M, 40), s.fs_base)
proof
  assume fsb mo mnz ht htl mf
  have r0 _ _ := expand(ht, abi.thread_ok)
  have t0 := expand(htl, mallocng_specs.tls_apart)
  have nm: all i. i in omega -> int_lt(i, 8) -> !(int_le(M, int_add(s.fs_base, i)) && int_lt(int_add(s.fs_base, i), int_add(M, 40))) proof
    fix i
    assume hi hil w
    have m0 _ := mp(all_elim(expand(r0, x86_64_linux.readable), {i}), hi, hil)
    have nf := mp(all_elim(t0, {i}), hi, hil)
    have o := mp(all_elim(mp(mf, mnz), {int_add(s.fs_base, i)}), (int_add(s.fs_base, i) in omega by arith(fsb, hi)),
      (int_le(M, int_add(s.fs_base, i)) && int_lt(int_add(s.fs_base, i), int_add(M, mallocng.META_SIZE)) by defs(arith(w), mallocng.META_SIZE)))
    show by taut(o, nf, m0)
  qed
  have n0 := mp(all_elim(nm, {0}), simp(), simp())
  have n7 := mp(all_elim(nm, {7}), simp(), simp())
  show by arith(n0, n7, fsb, mo)
qed

// (the meta M alloc_meta took given back on V, free_meta's outcome V2:
// alloc_group's outcome for 0 -- M among the free metas again, the groups
// A's, nothing outside the allocator touched but errno, grown only into
// memory unmapped before)
theorem mp.agr_back(c, A, A1, B, s, V, V2, M): c in mallocng.Cfg -> A in mallocng.Abs -> A1 in univ(1) -> A1 in mallocng.Abs ->
  B in fn_space(bits(64), option(omega)) -> int_mod(c.ctx, 8) = 0 -> V in x86_64_linux.Vm -> V2 in x86_64_linux.Vm ->
  mallocng.holds_in(c, A1, V, B) -> mallocng_specs.groups_kept(A, A1) -> A1.taken = seq_concat(A.taken, seq_one(M)) -> mallocng.no_reserved(A) ->
  mallocng.untouched(c, A, B, s.vm, V, mp.errno(s.fs_base)) -> mp.grown(c, A1, A, B, s.vm) -> mp.am_mfp(c, A, B, s, M) -> !(M = 0) ->
  mallocng_specs.meta_joinable(V, s.objs, int_add(c.ctx, 16), A1.free_metas, M) -> mallocng_specs.meta_freed(V, V2, s.objs, int_add(c.ctx, 16), M) ->
  (all a. a in omega -> int_le(M, a) -> int_lt(a, int_add(M, 40)) ->
     mallocng.m_rw(mallocng.mview(V, mallocng.all_bytes()), a) && !(snd(mallocng.pg(mallocng.mview(V, mallocng.all_bytes()), a)).kind = 2)) ->
  abs: mp.back(A1, A.taken, M) in mallocng.Abs && univ: mp.back(A1, A.taken, M) in univ(1) && nr: mallocng.no_reserved(mp.back(A1, A.taken, M)) &&
  act: mp.back(A1, A.taken, M).active = A.active && tk: mp.back(A1, A.taken, M).taken = A.taken &&
  hin: mallocng.holds_in(c, mp.back(A1, A.taken, M), V2, B) && unt: mallocng.untouched(c, A, B, s.vm, V2, mp.errno(s.fs_base)) &&
  grw: mp.grown(c, mp.back(A1, A.taken, M), A, B, s.vm)
proof
  assume hc ha hu1 ha1 hb cal hv hv2 hh gk tk nr un gr mf mnz hj hfd xrw
  let A2 := mp.back(A1, A.taken, M)
  let F := A1.free_metas
  have tl: A.taken in list_type(omega) by simp(ha)
  have P := apply(mp.fb_ms[c := c, A := A1, T := A.taken, x := M, vm := V, V1 := V2, b := B, objs := s.objs], hc, hu1, ha1, hb, hv, hv2, hh, cal, tl, tk, hj, hfd, xrw)
  have {ba = abs, bu = univ, bsl = slots, bac = active, btk = taken, bx = nat} := apply(mp.ms_basic, P)
  have hin := apply(mp.fb_holds_in, hc, hu1, ha1, hb, hv, hv2, hh, cal, tl, tk, hj, hfd, xrw)
  have gu gs ga _ := expand(gk, mallocng_specs.groups_kept)
  have nr2: mallocng.no_reserved(A2) by defs(rewrite(sym(trans(bsl, gs)), expand(nr, mallocng.no_reserved)), mallocng.no_reserved)
  // (grown: M's bytes the entry's or unmapped then, the others A1's)
  have grw: mp.grown(c, A2, A, B, s.vm) proof
    fix a
    assume ho hf
    have inm: int_le(M, a) && int_lt(a, int_add(M, 40)) -> a in mallocng.footprint(c, A, B) || !x86_64_linux.mapped(s.vm, int_div(a, x86_64_linux.PAGE)) proof
      assume h
      show := mp(all_elim(mp(mf, mnz), {a}), ho, (int_le(M, a) && int_lt(a, int_add(M, mallocng.META_SIZE)) by defs(arith(h), mallocng.META_SIZE)))
    qed
    have out: !(int_le(M, a) && int_lt(a, int_add(M, 40))) -> a in mallocng.footprint(c, A, B) || !x86_64_linux.mapped(s.vm, int_div(a, x86_64_linux.PAGE)) proof
      assume h
      have {f1 = fp} := apply(mp.ms_fp, P, ho, h)
      show := mp(all_elim(gr, {a}), ho, taut(f1, hf))
    qed
    show by taut(inm, out)
  qed
  // (untouched: free_meta wrote the head's word, M's bytes and the free
  // metas' links -- the allocator's then, or unmapped)
  have kf: mallocng.C_FREE_META = 16 by defs(refl({16}), mallocng.C_FREE_META)
  have la := rewrite(kf, apply(mp.free_metas_at[c := c, A := A1, vm := V, b := B, objs := s.objs], hc, hu1, ha1, (V.bytes in fn_space(bits(64), bits(8)) by simp(hv)), hh, cal))
  have fl: F in list_type(omega) by simp(ha1)
  have _ _ vr vb := mp(all_elim(expand(hfd, mallocng_specs.meta_freed), {F}), fl, taut(la, hj))
  have up := mp(app_update_other[f := V2, k := "bytes", v := V.bytes, x := "pages"], (!("pages" = "bytes") by simp()))
  have ep: V2.pages = V.pages := sym(rewrite(vr, up))
  have us := mp(app_update_other[f := V2, k := "bytes", v := V.bytes, x := "brk_start"], (!("brk_start" = "bytes") by simp()))
  have es: V2.brk_start = V.brk_start := sym(rewrite(vr, us))
  have u1 u2 := expand(un, mallocng.untouched)
  have co: c.ctx in omega by simp(hc)
  have {H1 = inv} := expand(hh, mallocng.holds_in)
  have {hpt = part} := expand(H1, mallocng.holds)
  have {fsl = free_slots} := expand(hpt, mallocng.metas_partition)
  have nfp: all a. a in omega -> a in mallocng.footprint(c, A1, B) -> !(a in mallocng.footprint(c, A, B)) -> !x86_64_linux.mapped(s.vm, int_div(a, x86_64_linux.PAGE)) proof
    fix a
    assume ho hf hn
    show by taut(mp(all_elim(gr, {a}), ho, hf), hn)
  qed
  have r: all a. a in omega -> (!(a in mallocng.footprint(c, A, B)) && !(a in mp.errno(s.fs_base))) && x86_64_linux.mapped(s.vm, int_div(a, x86_64_linux.PAGE)) ->
      V2.bytes[bits_of_int(64, a)] = s.vm.bytes[bits_of_int(64, a)] && V2.pages[int_div(a, x86_64_linux.PAGE)] = s.vm.pages[int_div(a, x86_64_linux.PAGE)] proof
    fix a
    assume ho hq
    have n1 n2 m0 := hq
    have ml _ := expand(m0, x86_64_linux.mapped)
    have alo: int_lt(a, int_pow(2, 64)) by arith(ho, expand(ml, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))
    // the head's word: the context's, A1's
    have nh: !(int_le(int_add(c.ctx, 16), a) && int_lt(a, int_add(int_add(c.ctx, 16), 8))) proof
      assume w
      have w1 w2 := w
      have f := apply(mp.ctx_fp[c := c, A := A1, vm := V, b := B, a := a], hc, hu1, ha1, hh, ho, arith(w1), (int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE)) by defs(arith(w2), mallocng.CTX_SIZE)))
      show by taut(mp(all_elim(nfp, {a}), ho, f, n1), m0)
    qed
    have nm: !(int_le(M, a) && int_lt(a, int_add(M, 40))) proof
      assume w
      show by taut(mp(all_elim(mp(mf, mnz), {a}), ho, (int_le(M, a) && int_lt(a, int_add(M, mallocng.META_SIZE)) by defs(arith(w), mallocng.META_SIZE))), n1, m0)
    qed
    have nl: all i. i in omega -> int_lt(i, seq_len(F)) -> !(int_le(F[i], a) && int_lt(a, int_add(F[i], 16))) proof
      fix i
      assume hi hil w
      have w1 w2 := w
      have fs _ := mp(all_elim(fsl, {i}), hi, hil)
      have nt := apply(mp.free_untaken, H1, hi, hil)
      have {acc = acc} := apply(mp.slot_meta[c := c, A := A1, vm := V, b := B, g := F[i]], hc, hu1, ha1, hh, fs, nt)
      have yh _ _ := mp(all_elim(acc, {a}), ho, w1, arith(w2))
      have {yf = fp} := apply(mp.held_fp, yh)
      show by taut(mp(all_elim(nfp, {a}), ho, yf, n1), m0)
    qed
    have b2 := mp(all_elim(vb, {a}), ho, taut(alo, nh, nm, nl))
    have b1 p1 := mp(all_elim(u1, {a}), ho, taut(n1, n2, m0))
    show by taut(trans(b2, b1), trans((V2.pages[int_div(a, x86_64_linux.PAGE)] = V.pages[int_div(a, x86_64_linux.PAGE)] by simp(ep)), p1))
  qed
  have unt: mallocng.untouched(c, A, B, s.vm, V2, mp.errno(s.fs_base)) by defs(taut(r, trans(es, u2)), mallocng.untouched)
  show by taut(ba, bu, nr2, trans(bac, ga), btk, hin, unt, grw)
qed

// alloc_group's purpose (`alloc_group_spec`), from A on s's memory: an
// overflow, or the return -- a new group of class sc for requests of up to
// req bytes, or 0 --, class sc's list as before, no slot reserved, the
// invariant kept, nothing outside the allocator touched but errno, the
// allocator grown only into memory unmapped before
abbrev mp.agr_out(c, A, sc, req, B, s, o) := (ex v. v in x86_64_linux.Vm && o = exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex V g. (V in x86_64_linux.Vm && (ex A2. ((A2 in mallocng.Abs && A2 in univ(1)) && mallocng.no_reserved(A2) && A2.active[sc] = A.active[sc] && A2.taken = A.taken) &&
     (g = 0 || mallocng_specs.fresh_group(A2, g, sc, req)) &&
     mallocng.holds_in(c, A2, V, B) && mallocng.untouched(c, A, B, s.vm, V, mp.errno(s.fs_base)) && mp.grown(c, A2, A, B, s.vm) &&
     (!(g = 0) -> int_lt(mallocng_specs.active_idx(V, A2.metas[g]), A2.metas[g].last_idx) ->
        int_lt(4096, int_add(mallocng.UNIT, int_mul(mallocng.stride(A2.metas[g]), int_add(A2.metas[g].last_idx, 1))))))) &&
     o = ok(fn_update(s, "vm", V), g))

theorem mp.agr_run(c, sc, req, galm, gib, gab, gss, gmm, gfm, gs2c, gas, gef, s, h, o): c in mallocng.Cfg -> c.ctx = c_src_malloc_mallocng_malloc.__malloc_context ->
  c.sct = c_src_malloc_mallocng_malloc.__malloc_size_classes -> c.dbj = c_src_malloc_mallocng_malloc.debruijn32 ->
  c.scnt = c_src_malloc_mallocng_malloc.small_cnt_tab -> c.mcnt = c_src_malloc_mallocng_malloc.med_cnt_tab ->
  sc in bits(32) -> int_lt(sc, 48) -> req in bits(64) ->
  int_le(int_add(req, mallocng.IB), int_mul(mallocng.UNIT, mallocng.size_classes[sc])) ->
  mp.am_call(c, galm) -> mp.ib_call(c, gib) -> mp.db_call(c, gab) -> mp.sq_call(c, gss) ->
  mp.calls(gmm, mallocng_specs.mmap_spec_fun()) -> mp.calls(gfm, mallocng_specs.free_meta_spec_fun(c.ctx)) ->
  mp.calls(gs2c, mallocng_specs.size_to_class_spec_fun(c.sct, c.dbj)) -> mp.as_call(c, gas) -> mp.ef_call(c, gef) ->
  s in abi.World -> h in mp.G ->
  mallocng.holds_in(c, h.A, s.vm, h.blocks) -> mallocng.no_reserved(h.A) -> abi.thread_ok(s.vm, s.fs_base) -> mallocng_specs.tls_apart(c, h.A, h.blocks, s.fs_base) ->
  abi.brk_start_ok(s.vm) -> mallocng_specs.errno_ok(s.vm, s.objs, s.fs_base) -> mallocng_specs.errno_apart(c, h.A, h.blocks, s.vm, s.fs_base) ->
  runs(c_src_malloc_mallocng_malloc.alloc_group(sc, req, galm, gib, gab, gss, gmm, gfm, gs2c, gas, gef), s, o) ->
  mp.agr_out(c, h.A, sc, req, h.blocks, s, o)
proof
  assume hc hx hst hdj hscn hmcn hsb hsl hrb hfit halm hib hab hsq hmm hfm hs2c has hef hw hh hin hnr hth htl hbs heo hea hr
  let A := h.A
  let B := h.blocks
  let V0 := s.vm
  have pu := apply(g.runs_univ, hr)
  have hu: s in univ(1) by simp(pu)
  have hgu _ hbt hat := mp(all_elim(mp.g_rec, {h}), hh)
  have au := mp(app_univ[u := 1, f := h, k := "A"], hgu)
  have vV vfun vdom vb := apply(ms.world_parts, hw)
  have hs: sc in omega by arith(hsb)
  // the class's slot size: its table entry, times 16
  let SCT := c_src_malloc_mallocng_malloc.__malloc_size_classes
  have sctb: SCT in bits(64) by defs(simp(), c_src_malloc_mallocng_malloc.__malloc_size_classes)
  have sctnz: !(SCT = 0) by defs(simp(), c_src_malloc_mallocng_malloc.__malloc_size_classes)
  have tok0 := apply(mp.classes_table[c := c, A := A, vm := V0, b := B, objs := s.objs], hc, au, hat, hin)
  have tok: mallocng_specs.table_ok(s.vm, s.objs, SCT, 2, mallocng.size_classes) := rewrite(hst, tok0)
  have ssc := mp(all_elim(ms.sint_small, {sc}), hs, arith(hsl))
  have td tl := apply(ms.tab_rd, {s}, {SCT}, {sc}, {mallocng.size_classes}, hu, sctb, sctnz, hsb, (int_le(0, sint(32, sc)) by arith(ssc, hs)),
    (int_lt(sint(32, sc), seq_len(mallocng.size_classes)) by arith(ssc, ms.sc_len, hsl)), tok)
  step l1 l2 l3 l4 l5 l6 l7 l8 l9 l10 l11 l12 l13 l14 l15 l16 l17 l18, e1 from hr with td, tl
  let ZC := mallocng.size_classes[sc]
  have zco zcl := mp(all_elim(ms.sc_nat, {sc}), hs, hsl)
  have z16: bits_of_int(16, ZC) = ZC by defs(arith(zco, zcl), bits_of_int, pow2)
  have e2 := rewrite(z16, rewrite(ssc, e1))
  have zcb: ZC in bits(32) by arith(zco, zcl)
  have sz := mp(all_elim(ms.sint_small, {ZC}), zco, arith(zcl))
  have s16: sint(32, 16) = 16 by defs(simp(), sint)
  have fm1: tr.s32_fits(int_mul(sint(32, ZC), sint(32, 16))) by defs(simp(sz, s16, zco, zcl), gimple.fits)
  have md1 := apply(g.smul32_det, {s}, {ZC}, {16}, hu, zcb, simp(), ms.imul_16, fm1)
  step e3 from e2 with md1
  let SZ := int_mul(16, ZC)
  have ze: bits_mul(32, ZC, 16) = SZ by defs(arith(zco, zcl), bits_mul, pow2)
  have sxz := apply(ms.sext_small, (SZ in bits(32) by arith(zco, zcl)), (int_lt(SZ, 2147483648) by arith(zco, zcl)))
  have e4 := rewrite(sxz, rewrite(ze, e3))
  // the meta: alloc_meta()
  have amself: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(galm[regs], s, o) -> runs(galm[regs], s, o) proof
    fix regs s o
    assume _ _ _ r
    show r
  qed
  step V1 rr, e5 hR1 from e4 with halm using amself, hw, hh, hin, hth, htl, hbs, heo, hea
  have v1v ex1 := hR1
  obtain A1 M, a1a a1u gk1 mb tk1 _ hin1 unt1 grw1 rdy1 epg1 mfp1 rm from ex1
  // no meta: 0, nothing done
  have none: M = 0 -> mp.agr_out(c, A, sc, req, B, s, o) proof
    assume h0
    have z: fst(rr) = 0 := trans(rm, h0)
    step e8 from e5 with z
    have gu gs ga _ := expand(gk1, mallocng_specs.groups_kept)
    have nr1: mallocng.no_reserved(A1) by defs(rewrite(sym(gs), expand(hnr, mallocng.no_reserved)), mallocng.no_reserved)
    have ac1: A1.active[sc] = A.active[sc] by simp(ga)
    have tk: A1.taken = A.taken by taut(tk1, h0)
    have vac: !(0 = 0) -> int_lt(mallocng_specs.active_idx(V1, A1.metas[0]), A1.metas[0].last_idx) ->
        int_lt(4096, int_add(mallocng.UNIT, int_mul(mallocng.stride(A1.metas[0]), int_add(A1.metas[0].last_idx, 1)))) by simp()
    have inner: ex A2. ((A2 in mallocng.Abs && A2 in univ(1)) && mallocng.no_reserved(A2) && A2.active[sc] = A.active[sc] && A2.taken = A.taken) &&
        (0 = 0 || mallocng_specs.fresh_group(A2, 0, sc, req)) &&
        mallocng.holds_in(c, A2, V1, B) && mallocng.untouched(c, A, B, s.vm, V1, mp.errno(s.fs_base)) && mp.grown(c, A2, A, B, s.vm) &&
        (!(0 = 0) -> int_lt(mallocng_specs.active_idx(V1, A2.metas[0]), A2.metas[0].last_idx) ->
           int_lt(4096, int_add(mallocng.UNIT, int_mul(mallocng.stride(A2.metas[0]), int_add(A2.metas[0].last_idx, 1)))))
      by ex_intro({A1}, taut(a1a, a1u, nr1, ac1, tk, refl({0}), hin1, unt1, grw1, vac))
    show by disj({2}, ex_intro({V1}, {0}, taut(v1v, inner, e8)))
  qed
  // a meta M: on
  have some: !(M = 0) -> mp.agr_out(c, A, sc, req, B, s, o) proof
    assume hnz
    have z: !(fst(rr) = 0) := rewrite(sym(rm), hnz)
    step e8 from e5 with z
    // usage: the class's count (a free counter)
    let W1 := fn_update(s, "vm", V1)
    let CTX := c_src_malloc_mallocng_malloc.__malloc_context
    have w1W w1u := apply(mp.am_world, hw, hu, v1v)
    have cv: CTX = 4227328 by defs(simp(), c_src_malloc_mallocng_malloc.__malloc_context)
    have kb: CTX in bits(64) by simp(cv)
    have cnz: !(CTX = 0) by simp(cv)
    have co: c.ctx in omega by arith(hx, cv)
    let UA := int_add(int_add(CTX, 464), int_mul(8, sc))
    have fu := apply(mp.free_off[c := c, a := UA, n := 8], co, arith(cv, hs), arith(hx, cv, hs), arith(hx, cv, hs, hsl))
    have uu _ := apply(mp.free_usable[c := c, A := A1, vm := V1, b := B, objs := s.objs, a := UA, n := 8], hc, a1u, a1a, hin1, arith(cv, hs), fu)
    have sx := apply(ms.sext_small, hsb, arith(hsl, hs))
    have sv: gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), 464) = 464 by defs(simp(), gimple.sval)
    have uab: UA in bits(64) by arith(cv, hs, hsl)
    have umd: g.mem_defined(W1, UA, 0, 8, false) by simp(uu, (int_add(UA, 0) = UA by arith(uab)), (!(UA = 0) by arith(cv, hs)), (int_lt(UA, pow2(64)) by arith(uab)))
    step x9, e9 from e8 with sx, g.padd_det, sv, g.elem8_det, g.ld64_det using conj(w1u, kb, umd, uab, cv, hx, cnz, hs, hsl)
    let U := bits_of_int(64, gimple.bytes_at(V1, int_add(UA, 0), 8))
    have tb9 kx9 := e9
    // the slot count: by the class and the usage
    let SCT3 := c_src_malloc_mallocng_malloc.small_cnt_tab
    have {tsm = small, tmd = med} := apply(mp.counts_tables[c := c, A := A1, vm := V1, b := B, objs := s.objs], hc, a1u, a1a, hbt, v1v, hin1)
    have s8: sint(32, 8) = 8 by defs(simp(), sint)
    have small: int_le(sc, 8) -> (ex k. (k in omega && int_le(k, 2)) && x9 = ok(pair(W1, pair(req, pair(l1, pair(mallocng.small_cnt_tab[int_add(int_mul(3, sc), k)], pair(l3,
        pair(k, pair(l5, pair(l6, pair(fst(rr), pair(l8, pair(l9, pair(l10, pair(4096, pair(SZ, pair(l13, pair(l14, pair(l15, pair(l16, pair(l17, U))))))))))))))))))), empty)) proof
      assume h8
      step e10 from tb9 with h8
      obtain r, wl c10 from e10
      let BODY(l, o) := loop_body(wl)
      let TUP(k) := pair(W1, pair(req, pair(l1, pair(l2, pair(l3, pair(k, pair(l5, pair(l6, pair(fst(rr), pair(l8, pair(l9, pair(l10, pair(4096, pair(SZ, pair(l13, pair(l14, pair(l15, pair(l16, pair(l17, U)))))))))))))))))))
      let TE(k) := int_add(int_mul(3, sc), k)
      // (a row entry: readable, its value the table's)
      have rd: all k. k in omega -> int_le(k, 2) -> g.det(gimple.elem(SCT3, sc, 3), W1, ok(W1, int_add(SCT3, int_mul(3, sc)))) &&
          g.det(gimple.elem(int_add(SCT3, int_mul(3, sc)), bits_sext(32, 64, k), 1), W1, ok(W1, int_add(SCT3, TE(k)))) &&
          g.det(gimple.ld8(int_add(SCT3, TE(k)), 0), W1, ok(W1, bits_of_int(8, mallocng.small_cnt_tab[TE(k)]))) proof
        fix k
        assume hk hk2
        have tv: SCT3 = 4219008 by defs(simp(), c_src_malloc_mallocng_malloc.small_cnt_tab)
        have tb3: SCT3 in bits(64) by simp(tv)
        have d1 := apply(g.elem3_det, {W1}, {SCT3}, {sc}, w1u, tb3, hs, arith(hsl, hs), arith(tv, hsl, hs))
        have kb32: k in bits(32) by arith(hk, hk2)
        have sxk := apply(ms.sext_small, kb32, arith(hk, hk2))
        have d2 := apply(g.elem1_det, {W1}, {int_add(SCT3, int_mul(3, sc))}, {k}, w1u, arith(tv, hsl, hs), arith(hk, hk2), arith(hk, hk2), arith(tv, hsl, hs, hk, hk2))
        have te: int_add(int_add(SCT3, int_mul(3, sc)), k) = int_add(SCT3, TE(k)) by arith(hs, hk)
        have tel: int_lt(TE(k), seq_len(mallocng.small_cnt_tab)) by defs(arith(h8, hs, hk, hk2), mallocng.small_cnt_tab)
        have u1 v1 := mp(all_elim(expand(tsm, mallocng_specs.table_ok), {TE(k)}), arith(hs, hk), tel)
        have ad: int_add(c.scnt, int_mul(1, TE(k))) = int_add(SCT3, TE(k)) by arith(hscn, hs, hk)
        have md: g.mem_defined(W1, int_add(SCT3, TE(k)), 0, 1, false) by simp(rewrite(ad, u1), (int_add(int_add(SCT3, TE(k)), 0) = int_add(SCT3, TE(k)) by arith(hs, hk)),
          (!(int_add(SCT3, TE(k)) = 0) by arith(tv, hs, hk)), (int_lt(int_add(SCT3, TE(k)), pow2(64)) by arith(tv, hsl, hs, hk, hk2)))
        have d3 := apply(g.ld8_det, {W1}, {int_add(SCT3, TE(k))}, {0}, w1u, arith(tv, hsl, hs, hk, hk2), simp(), md)
        have bv: gimple.bytes_at(W1.vm, int_add(int_add(SCT3, TE(k)), 0), 1) = mallocng.small_cnt_tab[TE(k)] by simp(rewrite(ad, v1),
          (int_add(int_add(SCT3, TE(k)), 0) = int_add(SCT3, TE(k)) by arith(hs, hk)), (bits_of_int(64, int_add(SCT3, TE(k))) = int_add(SCT3, TE(k)) by defs(arith(tv, hsl, hs, hk, hk2), bits_of_int, pow2)))
        have d2k := subst({y. g.det(gimple.elem(int_add(SCT3, int_mul(3, sc)), y, 1), W1, ok(W1, int_add(SCT3, TE(k))))}, sym(sxk), rewrite(te, d2))
        show by taut(d1, d2k, rewrite(bv, d3))
      qed
      // the loop's step: i up while the usage is below 4 times its entry
      let MORE(k) := int_le(k, 1) && int_lt(U, int_mul(4, mallocng.small_cnt_tab[TE(k)]))
      have run: all k. k in omega -> int_le(k, 2) -> all o. BODY(TUP(k), o) ->
          (MORE(k) && o = ok(TUP(int_add(k, 1)), empty)) || (!MORE(k) && o = exc(TUP(k), pair("brk", empty))) proof
        fix k
        assume ko kl2
        fix o
        assume hb
        have r1 r2 r3 := mp(all_elim(rd, {k}), ko, kl2)
        have sk := mp(all_elim(ms.sint_small, {k}), ko, arith(kl2))
        have s1: sint(32, 1) = 1 by defs(simp(), sint)
        let TV := mallocng.small_cnt_tab[TE(k)]
        have tvo _ tvl := mp(all_elim(mp.scnt_vals, {TE(k)}), arith(hs, ko), arith(h8, hs, ko, kl2))
        have tv8: bits_of_int(8, TV) = TV by defs(arith(tvo, tvl), bits_of_int, pow2)
        have stv := mp(all_elim(ms.sint_small, {TV}), tvo, arith(tvl))
        have s4: sint(32, 4) = 4 by defs(simp(), sint)
        have fm: tr.s32_fits(int_mul(sint(32, TV), sint(32, 4))) by defs(simp(stv, s4, tvo, tvl), gimple.fits)
        have m4 := apply(g.smul32_det, {W1}, {TV}, {4}, w1u, (TV in bits(32) by arith(tvo, tvl)), simp(), ms.imul_4, fm)
        have e4: bits_mul(32, TV, 4) = int_mul(4, TV) by defs(arith(tvo, tvl), bits_mul, pow2)
        have x4 := apply(ms.sext_small, (int_mul(4, TV) in bits(32) by arith(tvo, tvl)), (int_lt(int_mul(4, TV), 2147483648) by arith(tvo, tvl)))
        have ca: int_le(k, 1) -> int_lt(U, int_mul(4, TV)) -> o = ok(TUP(int_add(k, 1)), empty) proof
          assume hk1 hu4
          have fa: tr.s32_fits(int_add(sint(32, k), sint(32, 1))) by defs(simp(sk, s1, ko, kl2), gimple.fits)
          have ad := apply(g.sadd32_det, {W1}, {k}, {1}, w1u, (k in bits(32) by arith(ko, kl2)), simp(), fa)
          have ka: bits_add(32, k, 1) = int_add(k, 1) by defs(arith(ko, kl2), bits_add, pow2)
          step e from hb with sk, hk1, r1, r2, r3, tv8, m4, e4, x4, hu4, ad, ka
          show e
        qed
        have cb: int_le(k, 1) -> !int_lt(U, int_mul(4, TV)) -> o = exc(TUP(k), pair("brk", empty)) proof
          assume hk1 hu4
          step e from hb with sk, hk1, r1, r2, r3, tv8, m4, e4, x4, hu4
          show e
        qed
        have cc: !int_le(k, 1) -> o = exc(TUP(k), pair("brk", empty)) proof
          assume hk1
          step e from hb with sk, hk1
          show e
        qed
        show by taut(ca, cb, cc)
      qed
      // the invariant: i at most 2; the variant: 3 - i
      let P(l) := ex k. (k in omega && int_le(k, 2)) && l = TUP(k)
      let MS(l) := int_sub(3, fst(snd(snd(snd(snd(snd(l)))))))
      have p0: P(TUP(0)) by ex_intro({0}, taut((0 in omega by simp()), (int_le(0, 2) by simp()), refl({TUP(0)})))
      have pmv: all l. P(l) -> MS(l) in omega proof
        fix l
        assume hp
        obtain k, ko kl le from hp
        have m: MS(l) = int_sub(3, k) by simp(le)
        show by arith(m, ko, kl)
      qed
      have nx: all l l2. P(l) -> BODY(l, ok(l2, empty)) -> P(l2) && int_lt(MS(l2), MS(l)) proof
        fix l l2
        assume hp hb
        obtain k, ko kl le from hp
        have rk := mp(all_elim(mp(all_elim(run, {k}), ko, kl), {ok(l2, empty)}), rewrite(le, hb))
        have more: MORE(k) && ok(l2, empty) = ok(TUP(int_add(k, 1)), empty) -> P(l2) && int_lt(MS(l2), MS(l)) proof
          assume hm
          have k1 _ eo := hm
          have l2e: l2 = TUP(int_add(k, 1)) by simp(eo)
          have pl2: P(l2) by ex_intro({int_add(k, 1)}, taut((int_add(k, 1) in omega by arith(ko)), (int_le(int_add(k, 1), 2) by arith(k1)), l2e))
          have m1: MS(l) = int_sub(3, k) by simp(le)
          have m2: MS(l2) = int_sub(3, int_add(k, 1)) by simp(l2e)
          show by taut(pl2, (int_lt(MS(l2), MS(l)) by arith(m1, m2)))
        qed
        have stop: !MORE(k) && ok(l2, empty) = exc(TUP(k), pair("brk", empty)) -> P(l2) && int_lt(MS(l2), MS(l)) proof
          assume hm
          have _ eo := hm
          have f: false by defs(simp(eo), ok, exc)
          show by taut(f)
        qed
        show by taut(rk, more, stop)
      qed
      have wv := apply(g.loop[b := l o. BODY(l, o), p := l. P(l), m := l. MS(l)], p0, pmv, nx, wl)
      obtain l, hpl bb nk from wv
      obtain k, ko kl le from hpl
      have rk := mp(all_elim(mp(all_elim(run, {k}), ko, kl), {r}), rewrite(le, bb))
      have ok1: !(MORE(k) && r = ok(TUP(int_add(k, 1)), empty)) proof
        assume hm
        have _ _ eo := hm
        have k1: is_ok(r) by defs(simp(eo), is_ok)
        show by taut(k1, nk)
      qed
      have _ re := (!MORE(k) && r = exc(TUP(k), pair("brk", empty)) by taut(rk, ok1))
      // after: cnt the row's entry at i
      have r1 r2 r3 := mp(all_elim(rd, {k}), ko, kl)
      have tvo _ tvl := mp(all_elim(mp.scnt_vals, {TE(k)}), arith(hs, ko), arith(h8, hs, ko, kl))
      have tv8: bits_of_int(8, mallocng.small_cnt_tab[TE(k)]) = mallocng.small_cnt_tab[TE(k)] by defs(arith(tvo, tvl), bits_of_int, pow2)
      step e11 from rewrite(re, c10) with r1, r2, r3, tv8
      show by ex_intro({k}, taut(ko, kl, e11))
    qed
    let MCT := c_src_malloc_mallocng_malloc.med_cnt_tab
    have med: !int_le(sc, 8) -> (ex C. ((C in omega && int_le(1, C)) && int_le(C, 32) && int_le(int_mul(SZ, C), 1048575)) &&
        x9 = ok(pair(W1, pair(req, pair(l1, pair(C, pair(l3, pair(0, pair(l5, pair(l6, pair(fst(rr), pair(l8, pair(l9, pair(l10, pair(4096, pair(SZ, pair(l13, pair(l14, pair(l15, pair(l16, pair(l17, U))))))))))))))))))), empty)) proof
      assume h8
      have mv: MCT = 4219035 by defs(simp(), c_src_malloc_mallocng_malloc.med_cnt_tab)
      have p2: pow2(2) = 4 by simp()
