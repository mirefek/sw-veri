    have {th1 = thread, eo1 = errno, tl1 = tls, ea1 = apart} := apply(mp.agr_side[c := c, A := A, A1 := A1, B := B, s := s, V := V1], hw, hth, htl, heo, hea, unt1, grw1, epg1)
    have ths1: gc.sound(W1) by simp(th1)
