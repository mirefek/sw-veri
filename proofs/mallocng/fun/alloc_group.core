        have lak: all k. k in omega -> int_le(k, C2) -> LA(k) in omega && int_le(SS, LA(k)) && int_le(LA(k), mallocng.slot_end(VG, R2)) proof
          fix k
          assume ko kl
          have mk := mp(all_elim(ms.mul_le, {SZ}, {k}, {SZ}, {C2}), szo, ko, arith(szo), arith(c2o), arith(), kl)
          show by arith(mk, szo, ko, sso, pst, ib4, pfi, nfit, un16)
        qed
        have lup: all j k. j in omega -> k in omega -> int_lt(j, k) -> int_lt(LA(j), LA(k)) proof
          fix j k
          assume jo ko jk
          have mk := mp(all_elim(ms.mul_le, {SZ}, {int_add(j, 1)}, {SZ}, {k}), szo, arith(jo), arith(szo), arith(ko), arith(), arith(jk))
          have d: int_mul(SZ, int_add(j, 1)) = int_add(int_mul(SZ, j), SZ) by simp(szo, jo)
          show by arith(mk, d, zc1)
        qed
        have mdk: all k. k in omega -> int_le(k, C2) -> g.mem_defined(W20, LA(k), 0, 1, true) && int_lt(LA(k), 18446744073709551616) proof
          fix k
          assume ko kl
          have lo l1 l2 := mp(all_elim(lak, {k}), ko, kl)
          have ak: all i. i in omega -> int_lt(i, 1) -> int_add(LA(k), i) in mallocng.all_bytes() &&
              mallocng.m_rw(mallocng.mview(V20, mallocng.all_bytes()), int_add(LA(k), i)) &&
              !(snd(mallocng.pg(mallocng.mview(V20, mallocng.all_bytes()), int_add(LA(k), i))).kind = 2) proof
            fix i
            assume hi hil
            show := mp(all_elim(sacc2, {int_add(LA(k), i)}), arith(lo, hi), arith(l1, hi), arith(l2, hi, hil))
          qed
          have _ uw := apply(mp.rw_usable[vm := V20, F := mallocng.all_bytes(), objs := s.objs, a := LA(k), n := 1], lo, ak)
          have _ rw0 _ := mp(all_elim(sacc2, {LA(k)}), lo, l1, l2)
          have lt := apply(mp.rw_top, lo, rw0)
          have md: g.mem_defined(W20, LA(k), 0, 1, true) by simp(uw, (int_add(LA(k), 0) = LA(k) by arith(lo)), (!(LA(k) = 0) by arith(l1, sso, ib4, pst)),
            (int_lt(LA(k), pow2(64)) by arith(lt, (pow2(64) = 18446744073709551616 by simp()))))
          show by taut(md, lt)
        qed
        // the loop's step: slot k's check byte zeroed while k is at most cnt
        let MORE(k) := int_le(k, C2)
        have c2s := mp(all_elim(ms.sint_small, {C2}), c2o, arith(c232))
        have pbo: P in omega by arith(pb)
        have run: all k z. k in omega -> int_le(k, int_add(C2, 1)) -> ZF(k, z) -> all o. BODY(TL(WZ(z), k), o) ->
            (MORE(k) && o = ok(TL(WZ(x86_64_linux.store_le(z, LA(k), 1, 0)), int_add(k, 1)), empty)) || (!MORE(k) && o = exc(TL(WZ(z), k), pair("brk", empty))) proof
          fix k z
          assume ko kl hz
          fix o
          assume hb
          have zw zu _ _ := hz
          have sk := mp(all_elim(ms.sint_small, {k}), ko, arith(kl, c232))
          have ca: MORE(k) -> o = ok(TL(WZ(x86_64_linux.store_le(z, LA(k), 1, 0)), int_add(k, 1)), empty) proof
            assume hm
            have nl: !int_lt(C2, k) by arith(hm)
            have sxk := apply(ms.sext_small, (k in bits(32) by arith(ko, kl, c232)), (int_lt(k, 2147483648) by arith(ko, kl, c232)))
            have mk := mp(all_elim(ms.mul_le, {SZ}, {k}, {131056}, {32}), szo, ko, simp(), simp(), szl, arith(hm, c232))
            have bmk: bits_mul(64, SZ, k) = int_mul(SZ, k) by defs(arith(szo, ko, mk), bits_mul, pow2)
            have bak: bits_add(64, int_mul(SZ, k), 12) = int_add(int_mul(SZ, k), 12) by defs(arith(szo, ko, mk), bits_add, pow2)
            have svk := apply(g.sval64_lit, (int_add(int_mul(SZ, k), 12) in omega by arith(szo, ko)), (int_lt(int_add(int_mul(SZ, k), 12), 9223372036854775808) by arith(mk)))
            have mdl := mp(all_elim(mdk, {k}), ko, hm)
            have md: g.mem_defined(W20, LA(k), 0, 1, true) by taut(mdl)
            have lt: int_lt(LA(k), 18446744073709551616) by taut(mdl)
            have mdz := apply(mp.md_bytes[s := s, V := V20, z := z, p := LA(k), off := 0, k := 1, w := true], md)
            have lo: LA(k) in omega by arith(pbo, szo, ko)
            have dk: int_add(int_mul(SZ, k), 12) in bits(64) by arith(szo, ko, mk)
            have l0: int_le(0, int_add(P, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), int_add(int_mul(SZ, k), 12)))) by arith(svk, lo)
            have l64: int_lt(int_add(P, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), int_add(int_mul(SZ, k), 12))), pow2(64))
              by arith(svk, lt, (pow2(64) = 18446744073709551616 by simp()))
            have lb: LA(k) in bits(64) by arith(lo, lt)
            have la0: int_add(LA(k), 0) = LA(k) by arith(lo)
            have fa: tr.s32_fits(int_add(sint(32, k), sint(32, 1))) by defs(simp(sk, (sint(32, 1) = 1 by defs(simp(), sint)), ko, kl, c232), gimple.fits)
            have _ sw2 := apply(ms.sw_st, {s}, {V20}, {z}, {LA(k)}, {1}, {0}, zw, zu, lb)
            have ad := apply(g.sadd32_det, {WZ(x86_64_linux.store_le(z, LA(k), 1, 0))}, {k}, {1}, sw2, (k in bits(32) by arith(ko, kl, c232)), simp(), fa)
            have ka: bits_add(32, k, 1) = int_add(k, 1) by defs(arith(ko, kl, c232), bits_add, pow2)
            step e from hb with sk, c2s, nl, sxk, bmk, bak, g.padd_det, svk, ms.st8_det, la0, ad, ka using conj(zw, zu, pb, dk, l0, l64, mdz, lb)
            show e
          qed
          have cb: !MORE(k) -> o = exc(TL(WZ(z), k), pair("brk", empty)) proof
            assume hm
            have nl: int_lt(C2, k) by arith(hm)
            step e from hb with sk, c2s, nl
            show e
          qed
          show by taut(ca, cb)
        qed
        // (a check byte zeroed: the invariant one further)
        have zst: all k z. k in omega -> int_le(k, C2) -> ZF(k, z) -> ZF(int_add(k, 1), x86_64_linux.store_le(z, LA(k), 1, 0)) proof
          fix k z
          assume ko kl hz
          have zw zu z0 zr := hz
          have mdl := mp(all_elim(mdk, {k}), ko, kl)
          have lt: int_lt(LA(k), 18446744073709551616) by taut(mdl)
          have lo _ _ := mp(all_elim(lak, {k}), ko, kl)
          have lb: LA(k) in bits(64) by arith(lo, lt)
          have nw nu := apply(ms.sw_st, {s}, {V20}, {z}, {LA(k)}, {1}, {0}, zw, zu, lb)
          have zz: all j. j in omega -> int_lt(j, int_add(k, 1)) -> x86_64_linux.store_le(z, LA(k), 1, 0)[LA(j)] = 0 proof
            fix j
            assume jo jl
            have c1: j = k -> x86_64_linux.store_le(z, LA(k), 1, 0)[LA(j)] = 0 proof
              assume e
              have a := apply(mp.st1_at[z := z, a := LA(k), v := 0], lb)
              show by simp(e, a)
            qed
            have c2: int_lt(j, k) -> x86_64_linux.store_le(z, LA(k), 1, 0)[LA(j)] = 0 proof
              assume l
              have u := mp(all_elim(lup, {j}, {k}), jo, ko, l)
              have ljo _ _ := mp(all_elim(lak, {j}), jo, arith(l, kl))
              have so := mp(all_elim(ms.st_out, {z}, {LA(k)}, {1}, {0}, {LA(j)}), (LA(j) in bits(64) by arith(ljo, u, lt)), lo, simp(), arith(lt), disj({1}, u))
              show by simp(so, mp(all_elim(z0, {j}), jo, l))
            qed
            show by taut(c1, c2, (j = k || int_lt(j, k) by arith(jl, jo, ko)))
          qed
          have zf: all a. a in bits(64) -> (all j. j in omega -> int_lt(j, int_add(k, 1)) -> !(a = LA(j))) -> x86_64_linux.store_le(z, LA(k), 1, 0)[a] = Z0[a] proof
            fix a
            assume ha hn
            have nk := mp(all_elim(hn, {k}), ko, arith(ko))
            have so := mp(all_elim(ms.st_out, {z}, {LA(k)}, {1}, {0}, {a}), ha, lo, simp(), arith(lt), arith(ha, nk))
            have hn2: all j. j in omega -> int_lt(j, k) -> !(a = LA(j)) proof
              fix j
              assume jo jl
              show := mp(all_elim(hn, {j}), jo, arith(jl))
            qed
            show by simp(so, mp(all_elim(zr, {a}), ha, hn2))
          qed
          show by taut(nw, nu, zz, zf)
        qed
        // the invariant: k at most cnt + 1, the check bytes below k zeroed,
        // the other bytes as before; the variant: cnt + 2 - k
        let INV(l) := ex k z. ((k in omega && int_le(k, int_add(C2, 1))) && ZF(k, z)) && l = TL(WZ(z), k)
        let MS(l) := int_sub(int_add(C2, 2), fst(snd(snd(snd(snd(snd(l)))))))
        have w0 w0u := apply(ms.sw_st, {s}, {V20}, {x86_64_linux.store_le(V20.bytes, int_add(fst(rr), 32), 8, BF0)}, {A3x}, {1}, {HB}, w21W, w21u,
          (A3x in bits(64) by arith(sv3, p3o, pb)))
        have z00: all j. j in omega -> int_lt(j, 0) -> Z0[LA(j)] = 0 proof
          fix j
          assume jo jl
          have f: false by arith(jo, jl)
          show by taut(f)
        qed
        have z0r: all a. a in bits(64) -> (all j. j in omega -> int_lt(j, 0) -> !(a = LA(j))) -> Z0[a] = Z0[a] proof
          fix a
          assume _ _
          show refl({Z0[a]})
        qed
        have p0: INV(TL(WZ(Z0), 0)) by ex_intro({0}, {Z0}, taut((0 in omega by simp()), (int_le(0, int_add(C2, 1)) by arith(c2o)), w0, w0u, z00, z0r, refl({TL(WZ(Z0), 0)})))
        have pmv: all l. INV(l) -> MS(l) in omega proof
          fix l
          assume hp
          obtain k z, ko kl _ _ _ _ le from hp
          have m: MS(l) = int_sub(int_add(C2, 2), k) by simp(le)
          show by arith(m, ko, kl)
        qed
        have nx: all l l2. INV(l) -> BODY(l, ok(l2, empty)) -> INV(l2) && int_lt(MS(l2), MS(l)) proof
          fix l l2
          assume hp hb
          obtain k z, ko kl zw zu z0 zr le from hp
          have hz: ZF(k, z) by taut(zw, zu, z0, zr)
          have rk := mp(all_elim(mp(all_elim(run, {k}, {z}), ko, kl, hz), {ok(l2, empty)}), rewrite(le, hb))
          have more: MORE(k) && ok(l2, empty) = ok(TL(WZ(x86_64_linux.store_le(z, LA(k), 1, 0)), int_add(k, 1)), empty) -> INV(l2) && int_lt(MS(l2), MS(l)) proof
            assume hm
            have k1 eo := hm
            have l2e: l2 = TL(WZ(x86_64_linux.store_le(z, LA(k), 1, 0)), int_add(k, 1)) by simp(eo)
            have zn := mp(all_elim(zst, {k}, {z}), ko, k1, hz)
            have pl2: INV(l2) by ex_intro({int_add(k, 1)}, {x86_64_linux.store_le(z, LA(k), 1, 0)},
              taut((int_add(k, 1) in omega by arith(ko)), (int_le(int_add(k, 1), int_add(C2, 1)) by arith(k1)), zn, l2e))
            have m1: MS(l) = int_sub(int_add(C2, 2), k) by simp(le)
            have m2: MS(l2) = int_sub(int_add(C2, 2), int_add(k, 1)) by simp(l2e)
            show by taut(pl2, (int_lt(MS(l2), MS(l)) by arith(m1, m2)))
          qed
          have stop: !MORE(k) && ok(l2, empty) = exc(TL(WZ(z), k), pair("brk", empty)) -> INV(l2) && int_lt(MS(l2), MS(l)) proof
            assume hm
            have _ eo := hm
            have f: false by defs(simp(eo), ok, exc)
            show by taut(f)
          qed
          show by taut(rk, more, stop)
        qed
        have wv := apply(g.loop[b := l o. BODY(l, o), p := l. INV(l), m := l. MS(l)], p0, pmv, nx, wl24)
        obtain l, hpl bb nk from wv
        obtain k z, ko kl zw zu z0 zr le from hpl
        have hz: ZF(k, z) by taut(zw, zu, z0, zr)
        have rk := mp(all_elim(mp(all_elim(run, {k}, {z}), ko, kl, hz), {r24}), rewrite(le, bb))
        have ok1: !(MORE(k) && r24 = ok(TL(WZ(x86_64_linux.store_le(z, LA(k), 1, 0)), int_add(k, 1)), empty)) proof
          assume hm
          have _ eo := hm
          have k1: is_ok(r24) by defs(simp(eo), is_ok)
          show by taut(k1, nk)
        qed
        have nm re := (!MORE(k) && r24 = exc(TL(WZ(z), k), pair("brk", empty)) by taut(rk, ok1))
        have kc: k = int_add(C2, 1) by arith(nm, kl, ko)
        // ---- the class's usage, the masks, the group's place, its header,
        // the record's word (as for a mapped group)
        let WE := WZ(z)
        have fuu := apply(mp.free_off[c := c, a := UA, n := 8], (c.ctx in omega by arith(hx, cv)), arith(cv, hs), arith(hx, cv, hs), arith(hx, cv, hs, hsl))
        have uur uuw := apply(mp.free_usable[c := c, A := A2, vm := V17, b := B, objs := s.objs, a := UA, n := 8], hc, a2u, a2a, hin17, arith(cv, hs), fuu)
        have uur2 := apply(mp.usable_bytes[v := V17, v2 := V20, objs := s.objs, a := UA, n := 8, w := false], fv1, uur)
        have uuw2 := apply(mp.usable_bytes[v := V17, v2 := V20, objs := s.objs, a := UA, n := 8, w := true], fv1, uuw)
        have mdur := apply(mp.md_bytes[s := s, V := V20, z := z, p := UA, off := 0, k := 8, w := false],
          (g.mem_defined(W20, UA, 0, 8, false) by simp(uur2, (int_add(UA, 0) = UA by arith(uab)), (!(UA = 0) by arith(cv, hs)), (int_lt(UA, pow2(64)) by arith(uab)))))
        have mduw := apply(mp.md_bytes[s := s, V := V20, z := z, p := UA, off := 0, k := 8, w := true],
          (g.mem_defined(W20, UA, 0, 8, true) by simp(uuw2, (int_add(UA, 0) = UA by arith(uab)), (!(UA = 0) by arith(cv, hs)), (int_lt(UA, pow2(64)) by arith(uab)))))
        let MWE(off, n) := g.mem_defined(WE, fst(rr), off, n, true)
        let MRE(off, n) := g.mem_defined(WE, fst(rr), off, n, false)
        have mwe: all off n. off in omega -> n in omega -> int_lt(0, n) -> int_le(int_add(off, n), 40) -> MWE(off, n) && MRE(off, n) proof
          fix off n
          assume ho hn hnp hl
          have uw := apply(mp.usable_sub[vm := V20, objs := s.objs, a := M, n := 40, k := off, m := n, w := true], ho, hn, hl, muw)
          have ur := apply(mp.usable_sub[vm := V20, objs := s.objs, a := M, n := 40, k := off, m := n, w := false], ho, hn, hl, mur)
          have w20: g.mem_defined(W20, fst(rr), off, n, true) && g.mem_defined(W20, fst(rr), off, n, false) by simp(rewrite(sym(rm), conj(uw, ur)), rm, hnz,
            (int_lt(int_add(M, off), pow2(64)) by arith(mtop, hl, ho, hn, hnp, mo, (pow2(64) = 18446744073709551616 by simp()))), keep(gimple.usable))
          have a1: g.mem_defined(W20, fst(rr), off, n, true) by taut(w20)
          have a2: g.mem_defined(W20, fst(rr), off, n, false) by taut(w20)
          show by taut(apply(mp.md_bytes[s := s, V := V20, z := z, p := fst(rr), off := off, k := n, w := true], a1),
            apply(mp.md_bytes[s := s, V := V20, z := z, p := fst(rr), off := off, k := n, w := false], a2))
        qed
        have m24 := mp(all_elim(mwe, {24}, {4}), simp(), simp(), simp(), simp())
        have m28 := mp(all_elim(mwe, {28}, {4}), simp(), simp(), simp(), simp())
        have m16 := mp(all_elim(mwe, {16}, {8}), simp(), simp(), simp(), simp())
        have m321a := mp(all_elim(mwe, {32}, {1}), simp(), simp(), simp(), simp())
        have m322a := mp(all_elim(mwe, {32}, {2}), simp(), simp(), simp(), simp())
        have m24w: g.mem_defined(WE, fst(rr), 24, 4, true) by taut(m24)
        have m24r: g.mem_defined(WE, fst(rr), 24, 4, false) by taut(m24)
        have m28w: g.mem_defined(WE, fst(rr), 28, 4, true) by taut(m28)
        have m16w: g.mem_defined(WE, fst(rr), 16, 8, true) by taut(m16)
        have m16r: g.mem_defined(WE, fst(rr), 16, 8, false) by taut(m16)
        have m321: g.mem_defined(WE, fst(rr), 32, 1, true) by taut(m321a)
        have m322: g.mem_defined(WE, fst(rr), 32, 2, true) by taut(m322a)
        // (p's header word and active byte: in the slot)
        have pacc: all i. i in omega -> int_lt(i, 9) -> int_add(P, i) in mallocng.all_bytes() &&
            mallocng.m_rw(mallocng.mview(V20, mallocng.all_bytes()), int_add(P, i)) && !(snd(mallocng.pg(mallocng.mview(V20, mallocng.all_bytes()), int_add(P, i))).kind = 2) proof
          fix i
          assume hi hil
          show := mp(all_elim(sacc2, {int_add(P, i)}), arith(po, hi), arith(pst, ib4, hi), arith(pfi, hi, hil, zj1))
        qed
        have pur puw := apply(mp.rw_usable[vm := V20, F := mallocng.all_bytes(), objs := s.objs, a := P, n := 9], po, pacc)
        have _ p8rw _ := mp(all_elim(pacc, {8}), simp(), simp())
        have p8t := apply(mp.rw_top, arith(po), p8rw)
        have pnz: !(P = 0) by arith(pst, all_elim(gss, {R2}), gm, mr)
        have pu8 := apply(mp.usable_sub[vm := V20, objs := s.objs, a := P, n := 9, k := 0, m := 8, w := true], simp(), simp(), simp(), puw)
        have pu1 := apply(mp.usable_sub[vm := V20, objs := s.objs, a := P, n := 9, k := 8, m := 1, w := true], simp(), simp(), simp(), puw)
        have mdp0 := apply(mp.md_bytes[s := s, V := V20, z := z, p := P, off := 0, k := 8, w := true],
          (g.mem_defined(W20, P, 0, 8, true) by simp(pu8, (int_lt(int_add(P, 0), pow2(64)) by arith(p8t, po)), pnz, keep(gimple.usable))))
        have mdp8 := apply(mp.md_bytes[s := s, V := V20, z := z, p := P, off := 8, k := 1, w := true],
          (g.mem_defined(W20, P, 8, 1, true) by simp(pu1, (int_lt(int_add(P, 8), pow2(64)) by arith(p8t, po)), pnz, keep(gimple.usable))))
        // (M's record apart from the context's words, and from p's header)
        have mctx0 := apply(mp.meta_noctx[c := c, A := A1, vm := V1, b := B, T := A.taken, m := M], hc, a1u, a1a, hin1, tl0, tkm)
        have mctx: int_le(int_add(CTX, 928), fst(rr)) || int_le(int_add(fst(rr), 40), CTX) := rewrite(sym(rm), rewrite(hx, mctx0))
        have hga17n := expand(H17, mallocng.holds)
        have pcx0: all a. a in omega -> int_le(int_add(P, int_neg(3)), a) -> int_lt(a, int_add(P, 9)) -> !mallocng.in_range(a, pair(c.ctx, mallocng.CTX_SIZE)) proof
          fix a
          assume hao h1 h2
          have isl: mallocng.in_slot(VG, R2, a) by defs(arith(h1, h2, pst, pfi, ib4, jsn, zj1), mallocng.in_slot)
          have gr := apply(mp.slot_in_group[A := A2, M := mallocng.mview(V17, mallocng.held(c, A2, B)), b := B, g := G, i := R2, a := a], a2a, go, r2o, hao, gok, ril, isl)
          show := apply(mp.not_ctx[c := c, A := A2, M := mallocng.mview(V17, mallocng.held(c, A2, B)), b := B, brk := V17.brk, a := a], hc, a2u, a2a, H17, hao,
            disj({4}, ex_intro({G}, taut(iuG, gr))))
        qed
        have pcx: int_le(int_add(P, 9), CTX) || int_le(int_add(CTX, 928), int_add(P, int_neg(3))) proof
          have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
          have ov: all a. a in omega -> int_le(int_add(P, int_neg(3)), a) -> int_lt(a, int_add(P, 9)) -> int_le(CTX, a) -> int_lt(a, int_add(CTX, 928)) -> false proof
            fix a
            assume hao h1 h2 h3 h4
            have n := mp(all_elim(pcx0, {a}), hao, h1, h2)
            have f1: int_le(c.ctx, a) by arith(h3, hx)
            have f2: int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE)) by arith(h4, hx, ks)
            have r: mallocng.in_range(a, pair(c.ctx, mallocng.CTX_SIZE)) by defs(simp(f1, f2), mallocng.in_range)
            show by taut(n, r)
          qed
