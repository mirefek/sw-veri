        have e4: bits_mul(32, k, 4) = int_mul(4, k) by defs(arith(ko, k32), bits_mul, pow2)
        have x4 := apply(ms.sext_small, (int_mul(4, k) in bits(32) by arith(ko, k32)), (int_lt(int_mul(4, k), 2147483648) by arith(ko, k32)))
        have h2: bits_sar(32, k, 1) = int_div(k, 2) by defs(simp(sk, p1, (bits_of_int(32, int_div(k, 2)) = int_div(k, 2) by defs(arith(ko, k32), bits_of_int, pow2))), bits_sar)
        show by taut(a1, sk, rewrite(e4, m4), x4, h2)
      qed
      // the loop's step: halved while even and four times it above the usage
      let MORE(k) := int_mod(k, 2) = 0 && int_lt(U, int_mul(4, k))
      have run: all k. k in omega -> int_le(1, k) -> int_le(k, 32) -> all o. BODY(TM(k), o) ->
          (MORE(k) && o = ok(TM(int_div(k, 2)), empty)) || (!MORE(k) && o = exc(TM(k), pair("brk", empty))) proof
