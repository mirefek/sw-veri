    have sx2 := apply(ms.sext_small, (C2 in bits(32) by arith(c2o, c232)), arith(c2o, c232))
    have mc2 := mp(all_elim(ms.mul_le, {SZ}, {C2}, {131056}, {32}), szo, c2o, simp(), simp(), szl, c232)
