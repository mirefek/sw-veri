        // (the words written: read back)
        have q16: gimple.bytes_at(VF, int_add(fst(rr), 16), 8) = fst(r4) by mem(r4b, mtopr, mrro, mctx, uatop, uao, cv, mpd, r4top, r4o, n4g, hs, hsl, pcx)
        have q24: gimple.bytes_at(VF, int_add(fst(rr), 24), 4) = AVV by mem(r4b, mtopr, mrro, mctx, uatop, uao, cv, mpd, r4top, r4o, n4g, hs, hsl, pcx)
        have q28: gimple.bytes_at(VF, int_add(fst(rr), 28), 4) = FVV by mem(r4b, mtopr, mrro, mctx, uatop, uao, cv, mpd, r4top, r4o, n4g, hs, hsl, pcx)
        have qp: gimple.bytes_at(VF, int_add(fst(r4), 0), 8) = fst(rr) by mem(r4b, mtopr, mrro, mctx, uatop, uao, cv, mpd, r4top, r4o, n4g, hs, hsl, mbr)
        // the record's word: the last index, freeable, the class, the
        // mapping's pages -- the old word's low bits all replaced
        let O0 := gimple.bytes_at(V4, int_add(fst(rr), 32), 8)
        let QN := int_div(N4, 4096)
        have v4b: V4.bytes in fn_space(bits(64), bits(8)) by simp(expand(v4v, x86_64_linux.Vm))
        have o0o o0l := apply(g.bytes_bound, {V4}, {int_add(fst(rr), 32)}, {8}, v4b, simp())
        have p8: int_pow(256, 8) = 18446744073709551616 by simp()
        have mlv: bits_of_int(52, bits_shr(64, N4, 12)) = QN by defs(arith(n4o, n4l), bits_of_int, bits_shr, pow2)
        have bf1 := apply(mp.bfv[o := O0, pos := 12, k := 52, v := bits_of_int(52, bits_shr(64, N4, 12))], o0o, arith(o0l, p8), simp(), simp(), simp())
        have bv: BF1 = int_add(int_mul(4096, QN), int_mod(O0, 4096)) by arith(bf1, mlv, o0o, o0l, p8, n4o, n4l, (pow2(12) = 4096 by simp()), (pow2(52) = 4503599627370496 by simp()))
        // (the last index's store: the old low byte, its low 5 bits replaced)
        let D0 := gimple.bytes_at(fn_update(V4, "bytes", Y8), int_add(fst(rr), 32), 1)
        have t1 := mem_read({D0}, r4b, mtopr, mrro, mctx, uatop, uao, cv, mpd, r4top, r4o, n4g, hs, hsl, pcx)
        have z0: int_sub(int_add(fst(rr), 32), int_add(fst(rr), 32)) = 0 by arith()
        have z1: int_sub(int_add(int_add(fst(rr), 32), 1), int_add(fst(rr), 32)) = 1 by arith()
        have z2: int_sub(int_add(int_add(fst(rr), 32), 2), int_add(fst(rr), 32)) = 2 by arith()
        have e0: int_pow(256, 0) = 1 by simp()
        have e1: int_pow(256, 1) = 256 by simp()
        have e2: int_pow(256, 2) = 65536 by simp()
        have e6: int_pow(256, 6) = 281474976710656 by simp()
        have d0f: D0 = int_mod(int_div(BF1, 1), 256) := rewrite(e1, rewrite(e0, rewrite(z0, t1)))
        have d0e: D0 = int_mod(BF1, 256) by arith(d0f)
        have d0o: D0 in omega by arith(d0e, bv, o0o, n4o)
        have d0l: int_lt(D0, 256) by arith(d0e, bv, o0o, n4o)
        have l5: bits_of_int(5, bits_add(8, bits_of_int(8, K4), bits_neg(8, 1))) = int_sub(K4, 1) by defs(arith(k4o, k41, k432), bits_of_int, bits_add, bits_neg, pow2)
        have lv0 := apply(mp.bfv[o := D0, pos := 0, k := 5, v := bits_of_int(5, bits_add(8, bits_of_int(8, K4), bits_neg(8, 1)))], d0o, arith(d0l), simp(), simp(), simp())
        have lvv: LV = int_add(int_mul(32, int_div(D0, 32)), int_sub(K4, 1)) by arith(lv0, l5, d0o, d0l, k4o, k41, k432, (pow2(0) = 1 by simp()), (pow2(5) = 32 by simp()))
        // (freeable's store: bit 5)
        let D1 := gimple.bytes_at(fn_update(V4, "bytes", Y9), int_add(fst(rr), 32), 1)
        have t2 := mem_read({D1}, r4b, mtopr, mrro, mctx, uatop, uao, cv, mpd, r4top, r4o, n4g, hs, hsl, pcx)
        have d1e: D1 = int_mod(LV, 256) := rewrite(sym(d0f), rewrite(e1, rewrite(e0, rewrite(z0, t2))))
        have dq0: int_div(D0, 32) in omega by arith(d0o)
        have dq7: int_le(int_div(D0, 32), 7) by arith(d0o, d0l)
        have lvo: LV in omega by arith(lvv, dq0, k41)
        have lvl: int_lt(LV, 256) by arith(lvv, dq7, k432)
        have d1v: D1 = LV by arith(d1e, lvo, lvl)
        have d1o: D1 in omega by arith(d1v, lvo)
        have d1l: int_lt(D1, 256) by arith(d1v, lvl)
        have fr0 := apply(mp.bfv[o := D1, pos := 5, k := 1, v := 1], d1o, arith(d1l), simp(), simp(), simp())
        have frv: FRV = int_add(int_add(int_mul(64, int_div(D1, 64)), 32), int_mod(D1, 32)) by arith(fr0, d1o, d1l, (pow2(5) = 32 by simp()), (pow2(1) = 2 by simp()))
        have fr32: int_mod(D1, 32) = int_sub(K4, 1) by arith(d1v, lvv, dq0, k41, k432)
        have dq64: int_div(D1, 64) in omega && int_le(int_div(D1, 64), 3) by arith(d1o, d1l)
        have frl: int_lt(FRV, 256) by arith(frv, fr32, dq64, k432)
        have fro: FRV in omega by arith(frv, fr32, dq64, k41)
        // (the class's store: bits 6 to 11 of the two low bytes)
        let U := gimple.bytes_at(fn_update(V4, "bytes", Y10), int_add(fst(rr), 32), 2)
        have m33: bits_add(64, int_add(fst(rr), 32), 1) = int_add(int_add(fst(rr), 32), 1) by defs(arith(mrro, mtopr), bits_add, pow2)
        have us := rewrite(m33, rewrite((int_add(1, 1) = 2 by simp()), apply(g.bytes_split, {fn_update(V4, "bytes", Y10)}, {int_add(fst(rr), 32)}, {1}, {1},
          arith(mrro, mtopr), simp(), simp())))
        have t3 := mem_read({gimple.bytes_at(fn_update(V4, "bytes", Y10), int_add(fst(rr), 32), 1)}, r4b, mtopr, mrro, mctx, uatop, uao, cv, mpd, r4top, r4o, n4g, hs, hsl, pcx)
        have u0: gimple.bytes_at(fn_update(V4, "bytes", Y10), int_add(fst(rr), 32), 1) = int_mod(FRV, 256) :=
          rewrite(sym(d1e), rewrite(sym(d0f), rewrite(e1, rewrite(e0, rewrite(z0, t3)))))
        have t4 := mem_read({gimple.bytes_at(fn_update(V4, "bytes", Y10), int_add(int_add(fst(rr), 32), 1), 1)}, r4b, mtopr, mrro, mctx, uatop, uao, cv, mpd, r4top, r4o, n4g, hs, hsl, pcx)
        have u1: gimple.bytes_at(fn_update(V4, "bytes", Y10), int_add(int_add(fst(rr), 32), 1), 1) = int_mod(int_div(BF1, 256), 256) := rewrite(e1, rewrite(z1, t4))
        have uv: U = int_add(FRV, int_mul(256, int_mod(int_div(BF1, 256), 256))) by arith(us, u0, u1, fro, frl)
        have r0o: int_mod(O0, 4096) in omega by arith(o0o)
        have q1: int_mod(int_div(BF1, 256), 256) = int_add(int_mul(16, int_mod(QN, 16)), int_div(int_mod(O0, 4096), 256)) by arith(bv, r0o, o0o, n4o)
        have uo: U in omega by arith(uv, fro, q1, n4o, r0o)
        have ul: int_lt(U, 65536) by arith(uv, frl, q1, n4o, r0o)
        have sc0 := apply(mp.bfv[o := U, pos := 6, k := 6, v := bits_of_int(6, sc)], uo, arith(ul), simp(), simp(), simp())
        have s6: bits_of_int(6, sc) = sc by defs(arith(hs, hsl), bits_of_int, pow2)
        have scv: SCV = int_add(int_add(int_mul(4096, int_div(U, 4096)), int_mul(64, sc)), int_mod(U, 64)) by arith(sc0, s6, uo, ul, hs, hsl, (pow2(6) = 64 by simp()))
        have rq: int_div(int_mod(O0, 4096), 256) in omega && int_lt(int_div(int_mod(O0, 4096), 256), 16) by arith(r0o, o0o)
        have qm: int_mod(QN, 16) in omega && int_lt(int_mod(QN, 16), 16) by arith(n4o)
        have xo: int_mod(int_div(BF1, 256), 256) in omega by arith(q1, rq, qm)
        have u64: int_mod(U, 64) = int_add(32, int_sub(K4, 1)) by arith(uv, frv, fr32, dq64, xo, k41, k432)
        have u4096: int_div(U, 4096) = int_mod(QN, 16) by arith(uv, fro, frl, q1, rq, qm)
        have scw: SCV = int_add(int_add(int_add(int_mul(4096, int_mod(QN, 16)), int_mul(64, sc)), 32), int_sub(K4, 1)) by arith(scv, u64, u4096)
        // (the word: the class's store's two bytes, the mapping's six above)
        have m34: bits_add(64, int_add(fst(rr), 32), 2) = int_add(int_add(fst(rr), 32), 2) by defs(arith(mrro, mtopr), bits_add, pow2)
        have ws := rewrite(m34, rewrite((int_add(2, 6) = 8 by simp()), apply(g.bytes_split, {VF}, {int_add(fst(rr), 32)}, {2}, {6}, arith(mrro, mtopr), simp(), simp())))
        have wlo: gimple.bytes_at(VF, int_add(fst(rr), 32), 2) = int_mod(SCV, 65536) := apply(ms.rd_st2, {V4}, {Y10}, {int_add(fst(rr), 32)}, {SCV}, arith(mrro), arith(mtopr))
        have t6: gimple.bytes_at(VF, int_add(int_add(fst(rr), 32), 2), 6) =
            int_mod(int_div(BF1, int_pow(256, int_sub(int_add(int_add(fst(rr), 32), 2), int_add(fst(rr), 32)))), int_pow(256, 6))
          by mem(r4b, mtopr, mrro, mctx, uatop, uao, cv, mpd, r4top, r4o, n4g, hs, hsl, pcx)
        have whi: gimple.bytes_at(VF, int_add(int_add(fst(rr), 32), 2), 6) = int_mod(int_div(BF1, 65536), 281474976710656) := rewrite(e6, rewrite(e2, rewrite(z2, t6)))
        have q2: int_mod(int_div(BF1, 65536), 281474976710656) = int_div(QN, 16) by arith(bv, r0o, o0o, n4o, n4l)
        have scb: int_le(0, SCV) && int_lt(SCV, 65536) by arith(scw, qm, hs, hsl, k41, k432)
        have sm: int_mod(SCV, 65536) = SCV by arith(scb)
        have qd: QN = int_add(int_mul(16, int_div(QN, 16)), int_mod(QN, 16)) by arith(n4o)
        have q32: gimple.bytes_at(VF, int_add(fst(rr), 32), 8) = int_add(int_add(int_add(int_sub(K4, 1), 32), int_mul(64, sc)), int_mul(4096, QN))
          by arith(ws, wlo, whi, q2, sm, qd, scw)
        // the record's links: as alloc_meta left them, 0 (on pages mapped
        // before, not the context's, not stored to)
        have mrv: all i. i in omega -> int_lt(i, 40) -> x86_64_linux.mapped(V3, int_div(int_add(M, i), x86_64_linux.PAGE)) proof
          fix i
          assume hi hil
          have ao: int_add(M, i) in omega by arith(mo, hi)
          have r1 _ := mp(all_elim(rwa, {int_add(M, i)}), ao,
            (int_le(M, int_add(M, i)) && int_lt(int_add(M, i), int_add(M, mallocng.META_SIZE)) by defs(arith(hi, hil), mallocng.META_SIZE)))
          have m1 := apply(mp.rw_mapped[vm := V1, a := int_add(M, i)], ao, r1)
          show by defs(simp(expand(m1, x86_64_linux.mapped), ep31), x86_64_linux.mapped)
        qed
        have _ cb12 := expand(co12, mallocng_specs.ctx_only)
        have _ cb23 := expand(co23, mallocng_specs.ctx_only)
        have l16: all a. a in omega -> int_le(M, a) -> int_lt(a, int_add(M, 16)) -> Y11[a] = V1.bytes[a] proof
          fix a
          assume hao h1 h2
          have yb: a in bits(64) by arith(hao, h2, mtop)
          have nf: !mallocng.ctx_free(c, a) by defs(arith(mctx0, h1, h2, co), mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK)
          have f1 := mp(all_elim(frb, {a}), yb, arith(h2), arith(mctx0, hx, h1, h2), arith(mctx0, hx, cv, hs, hsl, h1, h2), arith(mpd0, n4g, h1, h2, hpo))
          have f2 := mp(all_elim(mby, {a}), yb, rewrite((int_add(M, int_sub(a, M)) = a by arith()), mp(all_elim(mrv, {int_sub(a, M)}), arith(h1), arith(h2))))
          have f3 := mp(all_elim(cb23, {a}), yb, nf)
          have f4 := mp(all_elim(cb12, {a}), yb, nf)
          show := trans(f1, trans(f2, trans(f3, f4)))
        qed
        have lkb: all j. j in omega -> int_le(int_add(j, 8), 16) -> gimple.bytes_at(VF, int_add(M, j), 8) = gimple.bytes_at(V1, int_add(M, j), 8) proof
          fix j
          assume hj hj8
          have q: all i. i in omega -> int_lt(i, 8) -> VF.bytes[bits_add(64, int_add(M, j), bits_of_int(64, i))] = V1.bytes[bits_add(64, int_add(M, j), bits_of_int(64, i))] proof
            fix i
            assume hi hil
            have ae := apply(ms.add_i, {int_add(M, j)}, {i}, arith(mo, hj), hi, arith(mtop, hil, hj8))
            have e := mp(all_elim(l16, {int_add(int_add(M, j), i)}), arith(mo, hj, hi), arith(hj, hi), arith(hil, hj8))
            show by simp(rewrite(sym(ae), e))
          qed
          show := apply(ms.bytes_agree, {V1}, {VF}, {int_add(M, j)}, {8}, simp(), q)
        qed
        have rwa1 rq0 rq8 := expand(mp(rdy1, hnz), mallocng_specs.meta_ready)
        have ab: all a. a in omega -> a in mallocng.all_bytes() proof
          fix a
          assume hao
          show by defs(sel(taut(hao)), mallocng.all_bytes)
        qed
        have vr: all W. all a. all n. a in omega -> n in omega -> int_le(int_add(a, n), 18446744073709551616) ->
            gimple.bytes_at(W, a, n) = mallocng.rd(mallocng.mview(W, mallocng.all_bytes()), a, n) proof
          fix W a n
          assume hao hn hl
          have q: all i. i in omega -> int_lt(i, n) -> int_add(a, i) in mallocng.all_bytes() proof
            fix i
            assume hi hil
            show := mp(all_elim(ab, {int_add(a, i)}), arith(hao, hi))
          qed
          show := apply(mp.view_read[vm := W, fp := mallocng.all_bytes(), a := a, n := n], hao, hn, arith(hl, hn), q)
        qed
        have pv0: mallocng.rd(mallocng.mview(VF, mallocng.all_bytes()), M, 8) = 0 := trans(sym(mp(all_elim(vr, {VF}, {M}, {8}), mo, simp(), arith(mtop))),
          trans(rewrite((int_add(M, 0) = M by arith()), mp(all_elim(lkb, {0}), simp(), simp())), trans(mp(all_elim(vr, {V1}, {M}, {8}), mo, simp(), arith(mtop)), rq0)))
        have nx0: mallocng.rd(mallocng.mview(VF, mallocng.all_bytes()), int_add(M, 8), 8) = 0 := trans(sym(mp(all_elim(vr, {VF}, {int_add(M, 8)}, {8}), arith(mo), simp(), arith(mtop))),
          trans(mp(all_elim(lkb, {8}), simp(), simp()), trans(mp(all_elim(vr, {V1}, {int_add(M, 8)}, {8}), arith(mo), simp(), arith(mtop)), rq8)))
        // the final memory: a memory
        have vf1 := apply(mp.vm_st, {V4}, {V4.bytes}, {int_add(fst(rr), 32)}, {8}, {BF1},
          rewrite(sym(mp(fn_update_same[f := V4, k := "bytes"], (is_fun(V4) by simp(expand(v4v, x86_64_linux.Vm))), ("bytes" in dom(V4) by simp(expand(v4v, x86_64_linux.Vm))))), v4v))
        have vf2 := apply(mp.vm_st, {V4}, {x86_64_linux.store_le(V4.bytes, int_add(fst(rr), 32), 8, BF1)}, {int_add(CTX, 12)}, {4}, {CN}, vf1)
        have vf3 := apply(mp.vm_st, {V4}, {B6}, {int_add(UA, 0)}, {8}, {CV}, vf2)
        have vf4 := apply(mp.vm_st, {V4}, {Y3}, {int_add(fst(rr), 24)}, {4}, {AVV}, vf3)
        have vf5 := apply(mp.vm_st, {V4}, {Y4}, {int_add(fst(rr), 28)}, {4}, {FVV}, vf4)
        have vf6 := apply(mp.vm_st, {V4}, {Y5}, {int_add(fst(rr), 16)}, {8}, {fst(r4)}, vf5)
        have vf7 := apply(mp.vm_st, {V4}, {Y6}, {int_add(fst(r4), 0)}, {8}, {fst(rr)}, vf6)
        have vf8 := apply(mp.vm_st, {V4}, {Y7}, {int_add(fst(r4), 8)}, {1}, {HV}, vf7)
        have vf9 := apply(mp.vm_st, {V4}, {Y8}, {int_add(fst(rr), 32)}, {1}, {LV}, vf8)
        have vf10 := apply(mp.vm_st, {V4}, {Y9}, {int_add(fst(rr), 32)}, {1}, {FRV}, vf9)
        have vfv: VF in x86_64_linux.Vm := apply(mp.vm_st, {V4}, {Y10}, {int_add(fst(rr), 32)}, {2}, {SCV}, vf10)
        have vfb: VF.bytes in fn_space(bits(64), bits(8)) by simp(expand(vfv, x86_64_linux.Vm))
        // the header: the active index, stored into a fresh byte 0
        have v4z: all a. a in omega -> int_le(P, a) -> int_lt(a, int_add(P, N4)) -> V4.bytes[a] = 0 proof
          fix a
          assume hao h1 h2
          show := mp(all_elim(mz, {a}), arith(hao, h2, mlow, hpo), arith(h1), arith(h2))
        qed
        have p8b: int_add(fst(r4), 8) in bits(64) by arith(r4o, r4top, n4g)
        have r7a: gimple.bytes_at(fn_update(V4, "bytes", Y7), int_add(fst(r4), 8), 1) = gimple.bytes_at(V4, int_add(fst(r4), 8), 1)
          by mem(r4b, mtopr, mrro, mctx, uatop, uao, cv, mpd, r4top, r4o, n4g, hs, hsl, pcx)
        have r70: gimple.bytes_at(fn_update(V4, "bytes", Y7), int_add(fst(r4), 8), 1) = 0 := trans(r7a, trans(apply(ms.bytes1, {V4}, {int_add(fst(r4), 8)}, v4b, p8b),
          rewrite(sym(rp), mp(all_elim(v4z, {int_add(P, 8)}), arith(hpo), arith(), arith(n4g)))))
        have hv0 := apply(mp.bfv[o := gimple.bytes_at(fn_update(V4, "bytes", Y7), int_add(fst(r4), 8), 1), pos := 0, k := 5, v := bits_of_int(5, AI)],
          arith(r70), arith(r70), simp(), simp(), simp())
        have a5: bits_of_int(5, AI) = AI by defs(arith(aio, a31), bits_of_int, pow2)
        let R7 := gimple.bytes_at(fn_update(V4, "bytes", Y7), int_add(fst(r4), 8), 1)
        have rr0: int_add(int_add(int_mul(int_mul(int_div(int_div(R7, pow2(0)), pow2(5)), pow2(5)), pow2(0)), int_mul(int_mod(bits_of_int(5, AI), pow2(5)), pow2(0))),
            int_mod(R7, pow2(0))) = AI by simp(r70, a5, (int_mod(AI, 32) = AI by arith(aio, a31)))
        have hvv: HV = AI := trans(hv0, rr0)
        have hb8: gimple.bytes_at(VF, int_add(fst(r4), 8), 1) = int_mod(HV, 256) by mem(r4b, mtopr, mrro, mctx, uatop, uao, cv, mpd, r4top, r4o, n4g, hs, hsl, pcx)
        have b8v _ := apply(mp.b8_view[vm := VF, fp := mallocng.all_bytes(), a := int_add(fst(r4), 8)], vfb, arith(r4o), mp(all_elim(ab, {int_add(fst(r4), 8)}), arith(r4o)))
        have be8: bits_of_int(64, int_add(fst(r4), 8)) = int_add(fst(r4), 8) by defs(arith(p8b), bits_of_int, pow2)
        have xb: mallocng.b8(mallocng.mview(VF, mallocng.all_bytes()), int_add(fst(r4), 8)) = int_mod(AI, 256) :=
          rewrite(hvv, trans(trans(rewrite(be8, b8v), sym(apply(ms.bytes1, {VF}, {int_add(fst(r4), 8)}, vfb, p8b))), hb8))
        have xai: int_mod(mallocng.b8(mallocng.mview(VF, mallocng.all_bytes()), int_add(fst(r4), 8)), 32) = AI
          by arith(xb, aio, a31, (int_mod(AI, 256) = AI by arith(aio, a31)))
        // (the pages' other bytes: 0)
        have zr: all a. a in omega -> int_le(int_add(P, 9), a) -> int_lt(a, int_add(P, N4)) -> mallocng.b8(mallocng.mview(VF, mallocng.all_bytes()), a) = 0 proof
          fix a
          assume hao h1 h2
          have yb: a in bits(64) by arith(hao, h2, ptop)
          have b0v _ := apply(mp.b8_view[vm := VF, fp := mallocng.all_bytes(), a := a], vfb, hao, mp(all_elim(ab, {a}), hao))
          have ea: bits_of_int(64, a) = a by defs(arith(yb), bits_of_int, pow2)
          have f1 := mp(all_elim(frb, {a}), yb, arith(mpd0, h1, h2, hpo), arith(pcx0, hx, h1, h2), arith(pcx0, cv, hs, hsl, h1, h2), arith(h1))
          have z := mp(all_elim(v4z, {a}), hao, arith(h1), h2)
          show by simp(rewrite(ea, b0v), f1, z)
        qed
        // ---- the state with the group made: M in use at its place, its
        // record the one in memory
        have {H4 = inv, hm4 = mapped} := expand(hin4, mallocng.holds_in)
        have {hpt4 = part, hnm4 = normal} := expand(H4, mallocng.holds)
        have {mnu = unused} := apply(mp.ng_taken[A := A1, T := A.taken, m := M], a1a, hpt4, tl0, tkm)
        have ul1: A1.used in list_type(omega) by simp(a1a)
        have {srt = sorted} := expand(hpt4, mallocng.metas_partition)
        have nin: all j. j in omega -> int_lt(j, seq_len(A1.used)) -> !(A1.used[j] = M) proof
          fix j
          assume hj hjl e
          show by taut(mnu, (mallocng.is_used(A1, M) by defs(ex_intro({j}, taut(hj, hjl, e)), mallocng.is_used)))
        qed
        obtain KK, kko kkl klo khi from apply(mp.ins_pos[l := A1.used, x := M], ul1, mo, srt, nin)
        let M0 := A1.metas[M]
        have m0t: M0 in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A1.metas, x := M], (A1.metas in fn_space(omega, mallocng.MetaV) by simp(a1a)), mo)
        have {nu0 = unused} := expand(hnm4, mallocng.normal)
        have m0z _ := mp(all_elim(nu0, {M}), mo, mnu)
        have zp: mallocng.ZERO_META.prev = 0 && mallocng.ZERO_META.next = 0 by defs(simp(), mallocng.ZERO_META)
        have m0p: M0.prev = 0 && M0.next = 0 := rewrite(sym(m0z), zp)
        have m0p1 m0p2 := m0p
        let LI := int_sub(K4, 1)
        let AVN := int_sub(pow2(int_add(AI, 1)), 1)
        let FVN := int_sub(pow2(K4), pow2(int_add(AI, 1)))
        let VR := mp.mset(M0, P, AVN, FVN, LI, 1, sc, QN)
        have ppa := mp(pow2_pos[k := int_add(AI, 1)], arith(aio))
        have pak := apply(pow2_le[a := int_add(AI, 1), b := K4], arith(aio), k4o, arith(aik))
        have vrt := apply(mp.mset_type[V := M0, p := P, av := AVN, fr := FVN, l := LI, f := 1, s := sc, ml := QN], m0t, ppo, arith(ppa), arith(pak), arith(k41), simp(), hs, arith(n4o))
        have vmem: VR.mem = P by simp()
        have vav: VR.avail = AVN by simp()
        have vfd: VR.freed = FVN by simp()
        have vli: VR.last_idx = LI by simp()
        have vfb: VR.freeable = 1 by simp()
        have vsc: VR.sizeclass = sc by simp()
        have vml: VR.maplen = QN by simp()
        have vpv: VR.prev = 0 by simp(m0p1)
        have vnx: VR.next = 0 by simp(m0p2)
        have qnp: int_lt(0, QN) by arith(n4g)
        have qn4: int_mul(QN, 4096) = N4 by arith(n4a, n4o)
        have vgr: mallocng.group_range(VR) = pair(P, N4) by defs(simp(vml, vmem, qnp, qn4), mallocng.group_range)
        // (its stride: the mapping's, one slot; else the class's)
        have str1: K4 = 1 -> mallocng.stride(VR) = int_sub(N4, 16) proof
          assume e
          have l0: VR.last_idx = 0 by simp(vli, e)
          show by defs(simp(l0, vml, qnp, qn4), mallocng.stride, mallocng.UNIT)
        qed
        have str2: !(K4 = 1) -> mallocng.stride(VR) = SZ proof
          assume ne
          have l0: !(VR.last_idx = 0) by arith(vli, ne, k41)
          show by defs(simp(l0, vsc), mallocng.stride, mallocng.UNIT)
        qed
        have k1c: K4 = 1 || !(K4 = 1) by taut()
        have sno1: K4 = 1 -> mallocng.stride(VR) in omega proof
          assume e
          show := rewrite(sym(mp(str1, e)), (int_sub(N4, 16) in omega by arith(n4g)))
        qed
        have sno2: !(K4 = 1) -> mallocng.stride(VR) in omega proof
          assume ne
          show := rewrite(sym(mp(str2, ne)), szo)
        qed
        have sno: mallocng.stride(VR) in omega by taut(k1c, sno1, sno2)
        have sk1: int_mul(mallocng.stride(VR), K4) = int_mul(mallocng.stride(VR), K4) := refl({int_mul(mallocng.stride(VR), K4)})
        have fits: int_le(int_add(mallocng.UNIT, int_mul(mallocng.stride(VR), K4)), int_mul(VR.maplen, 4096)) proof
          have c1: K4 = 1 -> int_le(int_add(mallocng.UNIT, int_mul(mallocng.stride(VR), K4)), int_mul(VR.maplen, 4096)) proof
            assume e
            have m1: int_mul(mallocng.stride(VR), K4) = mallocng.stride(VR) := subst({y. int_mul(mallocng.stride(VR), y) = mallocng.stride(VR)}, sym(e),
              (int_mul(mallocng.stride(VR), 1) = mallocng.stride(VR) by arith(sno)))
            show by defs(arith(m1, mp(str1, e), vml, qn4), mallocng.UNIT)
          qed
          have c2: !(K4 = 1) -> int_le(int_add(mallocng.UNIT, int_mul(mallocng.stride(VR), K4)), int_mul(VR.maplen, 4096)) proof
            assume ne
            have k16: int_le(int_add(int_mul(SZ, K4), 16), N4) by taut(n4f, ne)
            show by defs(arith(subst({y. int_mul(mallocng.stride(VR), K4) = int_mul(y, K4)}, mp(str2, ne), sk1), k16, vml, qn4), mallocng.UNIT)
          qed
          show by taut(k1c, c1, c2)
        qed
        have offs: int_lt(0, VR.last_idx) -> int_le(int_mul(mallocng.stride(VR), K4), int_mul(int_pow(2, 16), mallocng.UNIT)) proof
          assume h
          have ne: !(K4 = 1) by arith(h, vli)
          show by defs(arith(subst({y. int_mul(mallocng.stride(VR), K4) = int_mul(y, K4)}, mp(str2, ne), sk1), k4sz), mallocng.UNIT)
        qed
        have small: mallocng.stride(VR) = mallocng.UNIT -> int_mod(mallocng.b8(mallocng.mview(VF, mallocng.all_bytes()), int_add(VR.mem, 8)), 32) = VR.last_idx proof
          assume h16
          have ne: !(K4 = 1) proof
            assume e
            show by defs(arith(rewrite(mp(str1, e), h16), n4g), mallocng.UNIT)
          qed
          have sz16: SZ = 16 by defs(arith(rewrite(mp(str2, ne), h16)), mallocng.UNIT)
          have sk32 := mp(all_elim(ms.mul_le, {SZ}, {K4}, {16}, {32}), szo, k4o, simp(), simp(), arith(sz16), k432)
          have eq: AI = int_sub(K4, 1) by arith(aik, aip, sk32)
          have xv := subst({y. int_mod(mallocng.b8(mallocng.mview(VF, mallocng.all_bytes()), int_add(y, 8)), 32) = AI}, trans(rp, sym(vmem)), xai)
          show := trans(trans(xv, eq), sym(vli))
        qed
        let XA := int_mod(mallocng.b8(mallocng.mview(VF, mallocng.all_bytes()), int_add(VR.mem, 8)), 32)
        have xv: XA = AI := subst({y. int_mod(mallocng.b8(mallocng.mview(VF, mallocng.all_bytes()), int_add(y, 8)), 32) = AI}, trans(rp, sym(vmem)), xai)
        // ---- the step's precondition (mp.gxpre)
        have inrg: all a. mallocng.in_range(a, mallocng.group_range(VR)) -> int_le(P, a) && int_lt(a, int_add(P, N4)) proof
          fix a
          assume w
          show by simp(expand(rewrite(vgr, w), mallocng.in_range))
        qed
        have vfr: all a. a in omega -> mallocng.in_range(a, mallocng.group_range(VR)) ->
            !mallocng.in_ranges(a, mallocng.fp_ranges(c, A1)) && !(a in malloc.live_of(B)) && !mallocng.in_reserved(A1, a) && !mallocng.in_taken(A1, a) proof
          fix a
          assume hao w
          have w1 w2 := mp(all_elim(inrg, {a}), w)
          have um := rewrite(sym(pg), mp(all_elim(pfr, {a}), hao, w1, w2))
          have {o = owned, l = live, r = res, t = taken} := apply(mp.fresh_out[c := c, A := A1, vm := V3, b := B, a := a], hc, a1u, a1a, hbt, hin3, hao, um)
          show by taut(o, l, r, t)
        qed
        have vnp: all a. a in omega -> mallocng.in_range(a, mallocng.group_range(VR)) ->
            mallocng.m_rw(mallocng.mview(VF, mallocng.all_bytes()), a) && !(snd(mallocng.pg(mallocng.mview(VF, mallocng.all_bytes()), a)).kind = 2) proof
          fix a
          assume hao w
          have w1 w2 := mp(all_elim(inrg, {a}), w)
          have r4w r4k := apply(mp.fresh_rw[V := V4, p := p, N := N4, a := a], hpo, n4o, hao, mnew, mlow, n4a, arith(w1), arith(w2))
          have pe := apply(mp.view_pg[vm := V4, vm2 := VF, fp := mallocng.all_bytes(), a := a], hao, (VF.pages = V4.pages by simp()))
          have {rw = rw} := apply(mp.pg_same, pe)
          show by taut(rw, r4w, rewrite(sym(pe), r4k))
        qed
        have vmr: all a. a in omega -> int_le(M, a) -> int_lt(a, int_add(M, mallocng.META_SIZE)) ->
            mallocng.m_rw(mallocng.mview(VF, mallocng.all_bytes()), a) && !(snd(mallocng.pg(mallocng.mview(VF, mallocng.all_bytes()), a)).kind = 2) proof
          fix a
          assume hao h1 h2
          have cm: mallocng.META_SIZE = 40 by defs(refl({40}), mallocng.META_SIZE)
          have _ e1 e2 := mp(all_elim(each, {int_sub(a, M)}), arith(h1), arith(h2, cm))
          have ea: int_add(M, int_sub(a, M)) = a by arith()
          have pe := apply(mp.view_pg[vm := V4, vm2 := VF, fp := mallocng.all_bytes(), a := a], hao, (VF.pages = V4.pages by simp()))
          have {rw = rw} := apply(mp.pg_same, pe)
          show by taut(rw, rewrite(ea, e1), rewrite(sym(pe), rewrite(ea, e2)))
        qed
        // (the bytes held before: as before -- not m's record, the counters,
        // the new pages)
        have tm1: A1.taken[seq_len(A.taken)] = M := rewrite(sym(tkm), at({seq_concat(A.taken, seq_one(M))[seq_len(A.taken)]}, tl0))
        have vby: all a. a in omega -> a in mallocng.held(c, A1, B) -> VF.bytes[bits_of_int(64, a)] = V4.bytes[bits_of_int(64, a)] proof
          fix a
          assume hao hh1
          have {hf = fp, nf = free} := apply(mp.held_fp, hh1)
          have lo := apply(mp.fp_low[c := c, A := A1, vm := V4, b := B, a := a], hm4, hf)
          have ea: bits_of_int(64, a) = a by defs(arith(hao, lo), bits_of_int, pow2)
          have yb: a in bits(64) by arith(hao, lo)
          have fd := apply(mp.fp_def[c := c, A := A1, b := B, a := a])
          have nt: !(int_le(M, a) && int_lt(a, int_add(M, 40))) proof
            assume w
            have w1 w2 := w
            have it: mallocng.in_taken(A1, a) by defs(ex_intro({seq_len(A.taken)}, taut((seq_len(A.taken) in omega by arith(tl0)),
              (int_lt(seq_len(A.taken), seq_len(A1.taken)) by arith(rewrite(sym(tkm), (seq_len(seq_concat(A.taken, seq_one(M))) = int_add(seq_len(A.taken), 1) by arith(tl0))), tl0)),
              rewrite(sym(tm1), w1), (int_lt(a, int_add(A1.taken[seq_len(A.taken)], mallocng.META_SIZE)) by defs(arith(tm1, w2), mallocng.META_SIZE)))), mallocng.in_taken)
            show by taut(fd, hf, it)
          qed
          have nf2 := expand(nf, mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK)
          have _ ir := apply(mp.fp_owned, hf)
          have m3 := rewrite(pg, apply(mp.owned_mapped, a1a, hbt, hin3, hao, ir))
          have np: !(int_le(P, a) && int_lt(a, int_add(P, 9))) proof
            assume w
            have w1 w2 := w
            show by taut(m3, mp(all_elim(pfr, {a}), hao, w1, arith(w2, n4g)))
          qed
          have f1 := mp(all_elim(frb, {a}), yb, arith(nt), arith(nf2, hx), arith(nf2, hx, cv, hs, hsl), arith(np))
          show by simp(ea, f1)
        qed
        // (the record in memory)
        have vrm: all a. all n. a in omega -> n in omega -> int_le(int_add(a, n), 18446744073709551616) ->
            gimple.bytes_at(VF, a, n) = mallocng.rd(mallocng.mview(VF, mallocng.all_bytes()), a, n) proof
          fix a n
          assume hao hn hl
          show := mp(all_elim(vr, {VF}, {a}, {n}), hao, hn, hl)
        qed
        have avv := apply(mp.av_val[x := AI], aio, a31)
        have frv0 := apply(mp.fr_val[x := AI, k := K4], aio, k4o, arith(aik), k432)
        have fvv: FVV = FVN := subst({y. bits_add(32, bits_sub(32, bits_shl(32, bits_of_int(32, 2), int_sub(K4, 1)), y), bits_neg(32, 1)) = FVN}, sym(avv), frv0)
        have rm16 := subst({y. gimple.bytes_at(VF, int_add(y, 16), 8) = fst(r4)}, rm, q16)
        have rm24 := subst({y. gimple.bytes_at(VF, int_add(y, 24), 4) = AVV}, rm, q24)
        have rm28 := subst({y. gimple.bytes_at(VF, int_add(y, 28), 4) = FVV}, rm, q28)
        have rm32 := subst({y. gimple.bytes_at(VF, int_add(y, 32), 8) = int_add(int_add(int_add(int_sub(K4, 1), 32), int_mul(64, sc)), int_mul(4096, QN))}, rm, q32)
        have mi1: mallocng.rd(mallocng.mview(VF, mallocng.all_bytes()), int_add(M, 16), 8) = VR.mem :=
          trans(sym(mp(all_elim(vrm, {int_add(M, 16)}, {8}), arith(mo), simp(), arith(mtop))), trans(rm16, trans(rp, sym(vmem))))
        have mi2: mallocng.rd(mallocng.mview(VF, mallocng.all_bytes()), int_add(M, 24), 4) = VR.avail :=
          trans(sym(mp(all_elim(vrm, {int_add(M, 24)}, {4}), arith(mo), simp(), arith(mtop))), trans(rm24, trans(avv, sym(vav))))
        have mi3: mallocng.rd(mallocng.mview(VF, mallocng.all_bytes()), int_add(M, 28), 4) = VR.freed :=
          trans(sym(mp(all_elim(vrm, {int_add(M, 28)}, {4}), arith(mo), simp(), arith(mtop))), trans(rm28, trans(fvv, sym(vfd))))
        have mi4: mallocng.rd(mallocng.mview(VF, mallocng.all_bytes()), int_add(M, 32), 8) =
            int_add(int_add(int_add(VR.last_idx, int_mul(32, VR.freeable)), int_mul(64, VR.sizeclass)), int_mul(4096, VR.maplen))
          by arith(sym(mp(all_elim(vrm, {int_add(M, 32)}, {8}), arith(mo), simp(), arith(mtop))), rm32, vli, vfb, vsc, vml)
        have vrec: mallocng.meta_in_memory(mallocng.mview(VF, mallocng.all_bytes()), M, VR)
          by defs(taut(trans(pv0, sym(vpv)), trans(nx0, sym(vnx)), mi1, mi2, mi3, mi4, (int_lt(VR.last_idx, 32) by arith(vli, k432)), (int_lt(VR.freeable, 2) by arith(vfb)),
            (int_lt(VR.sizeclass, 64) by arith(vsc, hsl))), mallocng.meta_in_memory)
        // (the header: back to M; the masks by its active index)
        have hd1: mallocng.rd(mallocng.mview(VF, mallocng.all_bytes()), VR.mem, 8) = M :=
          subst({y. mallocng.rd(mallocng.mview(VF, mallocng.all_bytes()), y, 8) = M}, trans((int_add(fst(r4), 0) = fst(r4) by arith(r4o)), trans(rp, sym(vmem))),
            trans(sym(mp(all_elim(vrm, {int_add(fst(r4), 0)}, {8}), arith(r4o), simp(), arith(r4top, n4g))), trans(qp, rm)))
        have vhd: (mallocng.rd(mallocng.mview(VF, mallocng.all_bytes()), VR.mem, 8) = M && int_mod(VR.mem, 4096) = 0) && int_lt(0, VR.mem)
          by taut(hd1, (int_mod(VR.mem, 4096) = 0 by arith(vmem, hpo)), (int_lt(0, VR.mem) by arith(vmem, hpo, mone)))
        have vact: int_le(XA, VR.last_idx) by arith(xv, vli, aik)
        have vavl: VR.avail = int_sub(pow2(int_add(XA, 1)), 1) := subst({y. VR.avail = int_sub(pow2(int_add(y, 1)), 1)}, sym(xv), vav)
        have l1k: int_add(VR.last_idx, 1) = K4 by arith(vli)
        have vfr1: VR.freed = int_sub(pow2(int_add(VR.last_idx, 1)), pow2(int_add(AI, 1))) := subst({y. VR.freed = int_sub(pow2(y), pow2(int_add(AI, 1)))}, sym(l1k), vfd)
        have vfrd: VR.freed = int_sub(pow2(int_add(VR.last_idx, 1)), pow2(int_add(XA, 1))) :=
          subst({y. VR.freed = int_sub(pow2(int_add(VR.last_idx, 1)), pow2(int_add(y, 1)))}, sym(xv), vfr1)
        have vzr: all a. a in omega -> int_le(int_add(VR.mem, 9), a) -> int_lt(a, int_add(VR.mem, int_mul(VR.maplen, 4096))) ->
            mallocng.b8(mallocng.mview(VF, mallocng.all_bytes()), a) = 0 proof
          fix a
          assume hao h1 h2
          show := mp(all_elim(zr, {a}), hao, arith(h1, vmem), arith(h2, vmem, vml, qn4))
        qed
        have vsm: mallocng.stride(VR) = mallocng.UNIT -> int_le(int_mod(mallocng.b8(mallocng.mview(VF, mallocng.all_bytes()), int_add(VR.mem, 8)), 32), VR.last_idx) by taut(vact)
        have GP: mp.gxpre(c, A1, V4, VF, B, KK, A.taken, M, VR, K4) := conj(hc, a1u, a1a, hbt, v4v, vfv, hin4, tl0, tkm, hnz, vrt, (K4 = int_add(VR.last_idx, 1) by arith(vli)),
          conj(kko, kkl), klo, khi, (int_lt(0, VR.maplen) by arith(vml, qnp)), vfr, vnp, vmr, (VF.pages = V4.pages by simp()), (VF.brk = V4.brk by simp()), vby, vrec,
          conj(vpv, vnx), (int_lt(VR.sizeclass, 48) by arith(vsc, hsl)), vhd, vact, vavl, vfrd, small, vzr, sno, fits, offs)
        have hinF := apply(mp.gx_holds_in, GP)
        // ---- the outcome: M's group, fresh; no slot reserved, the class's
        // list as before; memory outside the allocator untouched, the
        // allocator grown only into memory unmapped before
        let A2 := mp.ngrp(A1, KK, A.taken, M, VR, K4)
        have {au2 = abs2, uu2 = univ2} := apply(mp.gx_basic, GP)
        have gu gs ga _ := expand(gk1, mallocng_specs.groups_kept)
        have nr2: mallocng.no_reserved(A2) proof
          have r: all x0. all x1. x0 in omega && x1 in omega -> int_lt(x1, seq_len(A2.slots[x0])) -> !(A2.slots[x0][x1] = tag(3, empty)) proof
            fix g i
            assume ho hil e
            have hg hi := ho
            have c1: g = M -> false proof
              assume eg
              have s0: A2.slots[g] = fn_build(K4, x0. tag(0, empty)) by simp(eg)
              have dn: seq_len(fn_build(K4, x0. tag(0, empty))) = K4 by defs(fn_build_dom[d := K4, v := x0. tag(0, empty)], seq_len)
              have il := mp(nat_lt_mem[k := i, n := K4], hi, k4o, rewrite(dn, rewrite(s0, hil)))
              have u0 := rewrite(sym(s0), mp(app_fn_build[d := K4, v := x0. tag(0, empty), a := i], il))
              show by defs(simp(trans(sym(e), u0)), tag)
            qed
            have c2: !(g = M) -> false proof
              assume ne
              have es: A2.slots[g] = A.slots[g] := trans((A2.slots[g] = A1.slots[g] by simp(mp(app_update_other[f := A1.slots, k := M, v := fn_build(K4, x0. tag(0, empty)), x := g], ne))),
                (A1.slots[g] = A.slots[g] by simp(gs)))
              have q := mp(all_elim(expand(hnr, mallocng.no_reserved), {g}, {i}), ho, rewrite(es, hil))
              show by taut(q, rewrite(es, e))
            qed
            show by taut(c1, c2)
          qed
          show by defs(r, mallocng.no_reserved)
        qed
        have ac2: A2.active[sc] = A.active[sc] by simp(ga)
        have tk2: A2.taken = A.taken by simp()
        // (M's group fresh: in use, unlinked, its slots unused, the first
        // available, its slots fitting the request; one slot if mapped short)
        have em2: A2.metas[M] = VR by simp()
        have iu2: mallocng.is_used(A2, M) by taut(apply(mp.ng_used[A := A1, k := KK, T := A.taken, m := M, V := VR, n := K4, g := M], a1a, kko, kkl, mo), refl({M}))
        have b0: int_mod(int_div(VR.avail, 1), 2) = 1 proof
          have pa := rewrite((pow2(1) = 2 by simp()), mp(all_elim(mp(all_elim(pow2_add, {AI}), aio), {1}), simp()))
          have pp := mp(pow2_pos[k := AI], aio)
          show by arith(vav, pa, pp)
        qed
        have bit0: mallocng.bit(VR.avail, 0) = 1 by defs(subst({y. int_mod(int_div(VR.avail, y), 2) = 1}, sym((int_pow(2, 0) = 1 by simp())), b0), mallocng.bit)
        have ib4: mallocng.IB = 4 by defs(simp(), mallocng.IB)
        have rqf: int_le(int_add(req, mallocng.IB), mallocng.stride(VR)) proof
          have c1: K4 = 1 -> int_le(int_add(req, mallocng.IB), mallocng.stride(VR)) proof
            assume e
            have sk: int_mul(SZ, K4) = SZ := subst({y. int_mul(SZ, y) = SZ}, sym(e), (int_mul(SZ, 1) = SZ by arith(szo)))
            show by arith(mp(str1, e), n4f, sk, rqs, ib4)
          qed
          have c2: !(K4 = 1) -> int_le(int_add(req, mallocng.IB), mallocng.stride(VR)) proof
            assume ne
            show by arith(mp(str2, ne), rqs, ib4)
          qed
          show by taut(k1c, c1, c2)
        qed
        have own: mallocng.own_mapping(VR) -> VR.last_idx = 0 proof
          assume w
          have w0 := expand(w, mallocng.own_mapping)
          have ne: !(!(K4 = 1)) proof
            assume ne
            show by defs(arith(w0, vsc, hsl, mp(str2, ne)), mallocng.UNIT)
          qed
          show by arith(vli, ne)
        qed
        have sl0: all x0. x0 in omega -> int_lt(x0, seq_len(A2.slots[M])) -> A2.slots[M][x0] = tag(0, empty) proof
          fix i
          assume hi hil
          have s0: A2.slots[M] = fn_build(K4, x0. tag(0, empty)) by simp()
          have dn: seq_len(fn_build(K4, x0. tag(0, empty))) = K4 by defs(fn_build_dom[d := K4, v := x0. tag(0, empty)], seq_len)
          have il := mp(nat_lt_mem[k := i, n := K4], hi, k4o, rewrite(dn, rewrite(s0, hil)))
          show := rewrite(sym(s0), mp(app_fn_build[d := K4, v := x0. tag(0, empty), a := i], il))
        qed
        have fgM: mallocng_specs.fresh_group(A2, M, sc, req) by defs(taut(iu2, rewrite(sym(em2), vsc), rewrite(sym(em2), vpv), rewrite(sym(em2), vnx), sl0,
          rewrite(sym(em2), bit0), rewrite(sym(em2), rqf), rewrite(sym(em2), own)), mallocng_specs.fresh_group)
        have fgr: fst(rr) = 0 || mallocng_specs.fresh_group(A2, fst(rr), sc, req) by taut(subst({y. mallocng_specs.fresh_group(A2, y, sc, req)}, sym(rm), fgM))
        // (untouched: the meta's bytes the allocator's or unmapped, the
        // counters the allocator's, the new pages unmapped before)
        have un13 := apply(mp.unt_trans[c := c, A := A1, A1 := A1, b := B, V0 := V1, V1 := V2, V2 := V3, e := mp.errno(s.fs_base)],
          apply(mp.unt_wider[c := c, A := A1, b := B, V0 := V1, V1 := V2, e := mp.errno(s.fs_base)], un12),
          apply(mp.unt_wider[c := c, A := A1, b := B, V0 := V2, V1 := V3, e := mp.errno(s.fs_base)], un23), refl({mallocng.footprint(c, A1, B)}))
        have un03 := apply(mp.unt_grow[c := c, A := A, A1 := A1, b := B, V0 := s.vm, V1 := V1, V2 := V3, e := mp.errno(s.fs_base)], unt1, un13, grw1)
        have u31 u32 := expand(un03, mallocng.untouched)
        have mf := mp(mfp1, hnz)
        have ts: int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE) = 34359738367 by defs(simp(), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
        have ur: all a. a in omega -> (!(a in mallocng.footprint(c, A, B)) && !(a in mp.errno(s.fs_base))) && x86_64_linux.mapped(s.vm, int_div(a, x86_64_linux.PAGE)) ->
            VF.bytes[bits_of_int(64, a)] = s.vm.bytes[bits_of_int(64, a)] && VF.pages[int_div(a, x86_64_linux.PAGE)] = s.vm.pages[int_div(a, x86_64_linux.PAGE)] proof
          fix a
          assume hao hq
          have n1 n2 m0 := hq
          have b3 p3 := mp(all_elim(u31, {a}), hao, hq)
          have ml _ := expand(m0, x86_64_linux.mapped)
          have lo: int_lt(a, 18446744073709551616) by arith(ml, ts, pg, hao)
          have ea: bits_of_int(64, a) = a by defs(arith(hao, lo), bits_of_int, pow2)
          have yb: a in bits(64) by arith(hao, lo)
          have m3: x86_64_linux.mapped(V3, int_div(a, x86_64_linux.PAGE)) by defs(simp(expand(m0, x86_64_linux.mapped), p3), x86_64_linux.mapped)
          have b4 := mp(all_elim(mby, {a}), yb, m3)
          have p4 := mp(all_elim(mpg, {int_div(a, x86_64_linux.PAGE)}), arith(hao, pg), m3)
          have nt: !(int_le(M, a) && int_lt(a, int_add(M, 40))) proof
            assume w
            have w1 w2 := w
            have q := mp(all_elim(mf, {a}), hao, (int_le(M, a) && int_lt(a, int_add(M, mallocng.META_SIZE)) by defs(arith(w1, w2), mallocng.META_SIZE)))
            show by taut(q, n1, m0)
          qed
          have nc: !(int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE))) proof
            assume w
            have w1 w2 := w
            show by taut(n1, apply(mp.ctx_fp[c := c, A := A, vm := s.vm, b := B, a := a], hc, au, hat, hin, hao, w1, w2))
          qed
          have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
          have np: !(int_le(P, a) && int_lt(a, int_add(P, 9))) proof
            assume w
            have w1 w2 := w
            show by taut(rewrite(pg, m3), mp(all_elim(pfr, {a}), hao, w1, arith(w2, n4g)))
          qed
          have f1 := mp(all_elim(frb, {a}), yb, arith(nt), arith(nc, hx, ks), arith(nc, hx, ks, cv, hs, hsl), arith(np))
          have eb: VF.bytes[a] = s.vm.bytes[a] := trans((VF.bytes[a] = Y11[a] by simp()), trans(f1, trans(b4, rewrite(ea, b3))))
          show by taut(rewrite(sym(ea), eb), trans((VF.pages[int_div(a, x86_64_linux.PAGE)] = V4.pages[int_div(a, x86_64_linux.PAGE)] by simp()), trans(p4, p3)))
        qed
        have {mst = start} := apply(mp.mm_fresh[V3 := V3, V4 := V4, p := p, N := N4, PG := NPG], hpo, n4o, n4a, n4p, hpl, hfr)
        have untF: mallocng.untouched(c, A, B, s.vm, VF, mp.errno(s.fs_base)) by defs(taut(ur, trans((VF.brk_start = V4.brk_start by simp()), trans(mst, u32))), mallocng.untouched)
        // (grown: by the meta, unmapped before or the allocator's; by the
        // pages, unmapped before -- errno's mapped)
        have fsb2: s.fs_base in bits(64) by simp(expand(hw, abi.World))
        have grF: all a. a in omega -> a in mallocng.footprint(c, A2, B) -> a in mallocng.footprint(c, A, B) || !x86_64_linux.mapped(s.vm, int_div(a, x86_64_linux.PAGE)) proof
          fix a
          assume hao hf
          have fe := apply(mp.gx_fp[c := c, A := A1, vm := V4, V1 := VF, b := B, k := KK, T := A.taken, m := M, V := VR, n := K4, a := a], GP)
          have d1: a in mallocng.footprint(c, A1, B) -> a in mallocng.footprint(c, A, B) || !x86_64_linux.mapped(s.vm, int_div(a, x86_64_linux.PAGE)) proof
            assume h
            show := mp(all_elim(grw1, {a}), hao, h)
          qed
          have d2: int_le(M, a) && int_lt(a, int_add(M, mallocng.META_SIZE)) -> a in mallocng.footprint(c, A, B) || !x86_64_linux.mapped(s.vm, int_div(a, x86_64_linux.PAGE)) proof
            assume h
            show := mp(all_elim(mf, {a}), hao, h)
          qed
          have d3: mallocng.in_range(a, mallocng.group_range(VR)) -> a in mallocng.footprint(c, A, B) || !x86_64_linux.mapped(s.vm, int_div(a, x86_64_linux.PAGE)) proof
            assume w
            have w1 w2 := mp(all_elim(inrg, {a}), w)
            have um := mp(all_elim(pfr, {a}), hao, w1, w2)
            have ne: !(a in mp.errno(s.fs_base)) proof
              assume he
              have ao e1 e2 := (a in omega && int_le(int_add(s.fs_base, 52), a) && int_lt(a, int_add(s.fs_base, 56)) by simp(he))
              have eb: bits_add(64, s.fs_base, 52) = int_add(s.fs_base, 52) by defs(arith(fsb2, hfl), bits_add, pow2)
              have _ me := mp(all_elim(expand(ea1, mallocng_specs.errno_apart, mallocng_specs.errno_at), {int_sub(a, int_add(s.fs_base, 52))}), arith(e1, ao, fsb2), arith(e2))
              have me2 := rewrite((int_add(int_add(s.fs_base, 52), int_sub(a, int_add(s.fs_base, 52))) = a by arith()), rewrite(eb, me))
              have m3: x86_64_linux.mapped(V3, int_div(a, x86_64_linux.PAGE)) by defs(simp(expand(me2, x86_64_linux.mapped), ep31), x86_64_linux.mapped)
              show by taut(rewrite(pg, m3), um)
            qed
            have c1: !(a in mallocng.footprint(c, A, B)) -> !x86_64_linux.mapped(s.vm, int_div(a, x86_64_linux.PAGE)) proof
              assume nf
              assume m0
              have _ p3 := mp(all_elim(u31, {a}), hao, taut(nf, ne, m0))
              have m3: x86_64_linux.mapped(V3, int_div(a, x86_64_linux.PAGE)) by defs(simp(expand(m0, x86_64_linux.mapped), p3), x86_64_linux.mapped)
              show by taut(rewrite(pg, m3), um)
            qed
            show by taut(c1)
          qed
          show by taut(fe, hf, d1, d2, d3)
        qed
        // (partially active only if its slots reach past its first page)
        have actF: !(fst(rr) = 0) -> int_lt(mallocng_specs.active_idx(VF, A2.metas[fst(rr)]), A2.metas[fst(rr)].last_idx) ->
            int_lt(4096, int_add(mallocng.UNIT, int_mul(mallocng.stride(A2.metas[fst(rr)]), int_add(A2.metas[fst(rr)].last_idx, 1)))) proof
          assume _ hl
          have em: A2.metas[fst(rr)] = VR := subst({y. A2.metas[y] = VR}, sym(rm), em2)
          have ai: mallocng_specs.active_idx(VF, VR) = AI by defs(xv, mallocng_specs.active_idx)
          have hl2: int_lt(AI, int_sub(K4, 1)) by arith(rewrite(em, hl), ai, vli)
          have ne: !(K4 = 1) by arith(hl2, aio)
          have big := mp(aip, hl2)
          have sk := subst({y. int_mul(mallocng.stride(VR), int_add(VR.last_idx, 1)) = int_mul(y, int_add(VR.last_idx, 1))}, mp(str2, ne),
            refl({int_mul(mallocng.stride(VR), int_add(VR.last_idx, 1))}))
          have kk: int_add(VR.last_idx, 1) = K4 by arith(vli)
          have sk2 := subst({y. int_mul(mallocng.stride(VR), int_add(VR.last_idx, 1)) = int_mul(SZ, y)}, kk, sk)
          show := rewrite(sym(em), (int_lt(4096, int_add(mallocng.UNIT, int_mul(mallocng.stride(VR), int_add(VR.last_idx, 1)))) by defs(arith(sk2, big), mallocng.UNIT)))
        qed
        have inner: ex A3. ((A3 in mallocng.Abs && A3 in univ(1)) && mallocng.no_reserved(A3) && A3.active[sc] = A.active[sc] && A3.taken = A.taken) &&
            (fst(rr) = 0 || mallocng_specs.fresh_group(A3, fst(rr), sc, req)) &&
            mallocng.holds_in(c, A3, VF, B) && mallocng.untouched(c, A, B, s.vm, VF, mp.errno(s.fs_base)) && mp.grown(c, A3, A, B, s.vm) &&
            (!(fst(rr) = 0) -> int_lt(mallocng_specs.active_idx(VF, A3.metas[fst(rr)]), A3.metas[fst(rr)].last_idx) ->
               int_lt(4096, int_add(mallocng.UNIT, int_mul(mallocng.stride(A3.metas[fst(rr)]), int_add(A3.metas[fst(rr)].last_idx, 1)))))
          by ex_intro({A2}, taut(au2, uu2, nr2, ac2, tk2, fgr, hinF, untF, grF, actF))
        show by disj({2}, ex_intro({VF}, {fst(rr)}, taut(vfv, inner, of)))
      qed
      show by taut(pm4, refused, mapd)
    qed
  qed
  goal 1
qed
