        have d1o: D1 in omega by arith(d1v, lvo)
        have d1l: int_lt(D1, 256) by arith(d1v, lvl)
        have fr0 := apply(mp.bfv[o := D1, pos := 5, k := 1, v := 1], d1o, arith(d1l), simp(), simp(), simp())
        have frv: FRV = int_add(int_add(int_mul(64, int_div(D1, 64)), 32), int_mod(D1, 32)) by arith(fr0, d1o, d1l, (pow2(5) = 32 by simp()), (pow2(1) = 2 by simp()))
        have fr32: int_mod(D1, 32) = int_sub(C2, 1) by arith(d1v, lvv, dq0, c21, c232)
        have dq64: int_div(D1, 64) in omega && int_le(int_div(D1, 64), 3) by arith(d1o, d1l)
        have frl: int_lt(FRV, 256) by arith(frv, fr32, dq64, c232)
        have fro: FRV in omega by arith(frv, fr32, dq64, c21)
        // (the class's store: bits 6 to 11 of the two low bytes)
        let U := gimple.bytes_at(fn_update(V20, "bytes", Z8), int_add(fst(rr), 32), 2)
        have m33: bits_add(64, int_add(fst(rr), 32), 1) = int_add(int_add(fst(rr), 32), 1) by defs(arith(mrro, mtopr), bits_add, pow2)
        have us := rewrite(m33, rewrite((int_add(1, 1) = 2 by simp()), apply(g.bytes_split, {fn_update(V20, "bytes", Z8)}, {int_add(fst(rr), 32)}, {1}, {1},
          arith(mrro, mtopr), simp(), simp())))
        have t3 := mem_read({gimple.bytes_at(fn_update(V20, "bytes", Z8), int_add(fst(rr), 32), 1)}, pb, mtopr, mrro, mctx, uatop, uao, cv, mpd, ptop, po, hs, hsl, pcx)
        have u0: gimple.bytes_at(fn_update(V20, "bytes", Z8), int_add(fst(rr), 32), 1) = int_mod(FRV, 256) := rewrite(sym(d1e), rewrite(sym(d0a), rewrite(e1, t3)))
        have a33: int_add(fst(rr), 33) = int_add(int_add(fst(rr), 32), 1) by arith()
        have a34: int_add(fst(rr), 34) = int_add(int_add(fst(rr), 32), 2) by arith()
        have t4a: gimple.bytes_at(fn_update(V20, "bytes", Z8), int_add(int_add(fst(rr), 32), 1), 1) = gimple.bytes_at(fn_update(V20, "bytes", z), int_add(int_add(fst(rr), 32), 1), 1)
          by mem(pb, mtopr, mrro, mctx, uatop, uao, cv, mpd, ptop, po, hs, hsl, pcx)
        have t4b := rewrite(a33, mp(all_elim(mrd, {33}, {1}), simp(), simp(), simp()))
        have t4 := mem_read({gimple.bytes_at(fn_update(V20, "bytes", Z0), int_add(int_add(fst(rr), 32), 1), 1)}, pb, mtopr, mrro, mctx, uatop, uao, cv, mpd, ptop, po, hs, hsl, pcx, sv3, p3o)
        have u1: gimple.bytes_at(fn_update(V20, "bytes", Z8), int_add(int_add(fst(rr), 32), 1), 1) = int_mod(int_div(BF0, 256), 256) := trans(trans(t4a, t4b), rewrite(e1, rewrite(z1, t4)))
        have uv: U = int_add(FRV, int_mul(256, int_mod(int_div(BF0, 256), 256))) by arith(us, u0, u1, fro, frl)
        have r0o: int_mod(O0, 4096) in omega by arith(o0o)
        have q1: int_mod(int_div(BF0, 256), 256) = int_div(int_mod(O0, 4096), 256) by arith(bv, r0o, o0o)
        have rq: int_div(int_mod(O0, 4096), 256) in omega && int_lt(int_div(int_mod(O0, 4096), 256), 16) by arith(r0o, o0o)
        have uo: U in omega by arith(uv, fro, q1, rq)
        have ul: int_lt(U, 4096) by arith(uv, frl, q1, rq)
        have sc0 := apply(mp.bfv[o := U, pos := 6, k := 6, v := bits_of_int(6, sc)], uo, arith(ul), simp(), simp(), simp())
        have s6: bits_of_int(6, sc) = sc by defs(arith(hs, hsl), bits_of_int, pow2)
        have scv: SCV = int_add(int_add(int_mul(4096, int_div(U, 4096)), int_mul(64, sc)), int_mod(U, 64)) by arith(sc0, s6, uo, ul, hs, hsl, (pow2(6) = 64 by simp()))
        have xo: int_mod(int_div(BF0, 256), 256) in omega by arith(q1, rq)
        have fm0 := apply(mp.fr_mod[d := D1, c := C2], d1o, d1l, c2o, c21, c232, fr32)
        have fm64: int_mod(FRV, 64) = int_add(32, int_sub(C2, 1)) := rewrite(sym(frv), fm0)
        have um64: int_mod(U, 64) = int_mod(FRV, 64) by arith(uv, xo, fro)
        have u64: int_mod(U, 64) = int_add(32, int_sub(C2, 1)) := trans(um64, fm64)
        have u4096: int_div(U, 4096) = 0 by arith(uo, ul)
        have scw: SCV = int_add(int_add(int_mul(64, sc), 32), int_sub(C2, 1)) by arith(scv, u64, u4096)
        // (the word: the class's store's two bytes, the old word's six above, 0)
        have m34: bits_add(64, int_add(fst(rr), 32), 2) = int_add(int_add(fst(rr), 32), 2) by defs(arith(mrro, mtopr), bits_add, pow2)
        have ws := rewrite(m34, rewrite((int_add(2, 6) = 8 by simp()), apply(g.bytes_split, {VF}, {int_add(fst(rr), 32)}, {2}, {6}, arith(mrro, mtopr), simp(), simp())))
        have wlo: gimple.bytes_at(VF, int_add(fst(rr), 32), 2) = int_mod(SCV, 65536) := apply(ms.rd_st2, {V20}, {Z8}, {int_add(fst(rr), 32)}, {SCV}, arith(mrro), arith(mtopr))
        have t6a: gimple.bytes_at(VF, int_add(int_add(fst(rr), 32), 2), 6) = gimple.bytes_at(fn_update(V20, "bytes", z), int_add(int_add(fst(rr), 32), 2), 6)
          by mem(pb, mtopr, mrro, mctx, uatop, uao, cv, mpd, ptop, po, hs, hsl, pcx)
        have t6b := rewrite(a34, mp(all_elim(mrd, {34}, {6}), simp(), simp(), simp()))
        have t6 := mem_read({gimple.bytes_at(fn_update(V20, "bytes", Z0), int_add(int_add(fst(rr), 32), 2), 6)}, pb, mtopr, mrro, mctx, uatop, uao, cv, mpd, ptop, po, hs, hsl, pcx, sv3, p3o)
        have whi: gimple.bytes_at(VF, int_add(int_add(fst(rr), 32), 2), 6) = int_mod(int_div(BF0, 65536), 281474976710656) :=
          trans(trans(t6a, t6b), rewrite(e6, rewrite(e2, rewrite(z2, t6))))
        have q2: int_mod(int_div(BF0, 65536), 281474976710656) = 0 by arith(bv, r0o, o0o)
        have scb: int_le(0, SCV) && int_lt(SCV, 65536) by arith(scw, hs, hsl, c21, c232)
        have sm: int_mod(SCV, 65536) = SCV by arith(scb)
        have q32: gimple.bytes_at(VF, int_add(fst(rr), 32), 8) = int_add(int_add(int_sub(C2, 1), 32), int_mul(64, sc)) := apply(mp.wsum0, ws, wlo, whi, q2, sm, scw)
        // (V20's bytes out of the slot: V17's)
        have v2017: all a n. a in omega -> n in omega -> int_le(int_add(a, n), 18446744073709551616) ->
            (all i. i in omega -> int_lt(i, n) -> !mallocng.in_slot(VG, R2, int_add(a, i))) -> gimple.bytes_at(V20, a, n) = gimple.bytes_at(V17, a, n) proof
          fix a n
          assume hao hn hl hq
          have q: all i. i in omega -> int_lt(i, n) -> V20.bytes[bits_add(64, a, bits_of_int(64, i))] = V17.bytes[bits_add(64, a, bits_of_int(64, i))] proof
            fix i
            assume hi hil
            have ae := apply(ms.add_i, {a}, {i}, hao, hi, arith(hl, hil))
            have ns := mp(all_elim(hq, {i}), hi, hil)
            have f := mp(all_elim(fout, {int_add(a, i)}), arith(hao, hi), taut((int_lt(int_add(a, i), int_pow(2, 64)) by arith(hl, hil, (int_pow(2, 64) = 18446744073709551616 by simp()))), ns))
            have eb: bits_of_int(64, int_add(a, i)) = int_add(a, i) by defs(arith(hao, hi, hil, hl), bits_of_int, pow2)
            show by simp(rewrite(sym(ae), rewrite(eb, f)))
          qed
          show := apply(ms.bytes_agree, {V17}, {V20}, {a}, {n}, hn, q)
        qed
        // (the record's links: V17's, 0)
        have ab: all a. a in omega -> a in mallocng.all_bytes() proof
          fix a
          assume hao
          show by defs(sel(taut(hao)), mallocng.all_bytes)
        qed
        have vr: all W. all a. all n. a in omega -> n in omega -> int_le(int_add(a, n), 18446744073709551616) ->
            gimple.bytes_at(W, a, n) = mallocng.rd(mallocng.mview(W, mallocng.all_bytes()), a, n) proof
          fix W a n
          assume hao hn hl
          have q: all i. i in omega -> int_lt(i, n) -> int_add(a, i) in mallocng.all_bytes() proof
            fix i
            assume hi hil
            show := mp(all_elim(ab, {int_add(a, i)}), arith(hao, hi))
          qed
          show := apply(mp.view_read[vm := W, fp := mallocng.all_bytes(), a := a, n := n], hao, hn, arith(hl, hn), q)
        qed
        have mns8: all j. j in omega -> int_le(int_add(j, 8), 16) -> all i. i in omega -> int_lt(i, 8) -> !mallocng.in_slot(VG, R2, int_add(int_add(fst(rr), j), i)) proof
          fix j
          assume hj hj8
          fix i
          assume hi hil
          have n1 _ := mp(all_elim(mse, {int_add(int_add(fst(rr), j), i)}), arith(mrro, hj, hi), arith(rm, hj, hi), arith(rm, hj, hi, hil, hj8))
          show n1
        qed
        have l0a: gimple.bytes_at(VF, int_add(fst(rr), 0), 8) = gimple.bytes_at(fn_update(V20, "bytes", z), int_add(fst(rr), 0), 8) by mem(pb, mtopr, mrro, mctx, uatop, uao, cv, mpd, ptop, po, hs, hsl, pcx)
        have l0b := mp(all_elim(mrd, {0}, {8}), simp(), simp(), simp())
        have l0c: gimple.bytes_at(fn_update(V20, "bytes", Z0), int_add(fst(rr), 0), 8) = gimple.bytes_at(V20, int_add(fst(rr), 0), 8) by mem(pb, mtopr, mrro, mctx, uatop, uao, cv, mpd, ptop, po, hs, hsl, pcx, sv3, p3o)
        have l0d := mp(all_elim(v2017, {int_add(fst(rr), 0)}, {8}), arith(mrro), simp(), arith(mtopr), mp(all_elim(mns8, {0}), simp(), simp()))
        have l8a: gimple.bytes_at(VF, int_add(fst(rr), 8), 8) = gimple.bytes_at(fn_update(V20, "bytes", z), int_add(fst(rr), 8), 8) by mem(pb, mtopr, mrro, mctx, uatop, uao, cv, mpd, ptop, po, hs, hsl, pcx)
        have l8b := mp(all_elim(mrd, {8}, {8}), simp(), simp(), simp())
        have l8c: gimple.bytes_at(fn_update(V20, "bytes", Z0), int_add(fst(rr), 8), 8) = gimple.bytes_at(V20, int_add(fst(rr), 8), 8) by mem(pb, mtopr, mrro, mctx, uatop, uao, cv, mpd, ptop, po, hs, hsl, pcx, sv3, p3o)
        have l8d := mp(all_elim(v2017, {int_add(fst(rr), 8)}, {8}), arith(mrro), simp(), arith(mtopr), mp(all_elim(mns8, {8}), simp(), simp()))
        have _ rq0 rq8 := expand(rdy17, mallocng_specs.meta_ready)
        have m0e: int_add(fst(rr), 0) = M by arith(rm)
        have m8e: int_add(fst(rr), 8) = int_add(M, 8) by arith(rm)
        have pv0: mallocng.rd(mallocng.mview(VF, mallocng.all_bytes()), M, 8) = 0 := trans(sym(mp(all_elim(vr, {VF}, {M}, {8}), mo, simp(), arith(mtop))),
          trans(rewrite(m0e, trans(l0a, trans(l0b, trans(l0c, l0d)))), trans(mp(all_elim(vr, {V17}, {M}, {8}), mo, simp(), arith(mtop)), rq0)))
        have nx0: mallocng.rd(mallocng.mview(VF, mallocng.all_bytes()), int_add(M, 8), 8) = 0 := trans(sym(mp(all_elim(vr, {VF}, {int_add(M, 8)}, {8}), arith(mo), simp(), arith(mtop))),
          trans(rewrite(m8e, trans(l8a, trans(l8b, trans(l8c, l8d)))), trans(mp(all_elim(vr, {V17}, {int_add(M, 8)}, {8}), arith(mo), simp(), arith(mtop)), rq8)))
        // (the record in memory)
        have avv := apply(mp.av_val[x := LI], aio, a31)
        have frv0 := apply(mp.fr_val[x := LI, k := C2], aio, c2o, arith(c2o), c232)
        have fvv: FVV = FVN := subst({y. bits_add(32, bits_sub(32, bits_shl(32, bits_of_int(32, 2), int_sub(C2, 1)), y), bits_neg(32, 1)) = FVN}, sym(avv), frv0)
        have rm16 := subst({y. gimple.bytes_at(VF, int_add(y, 16), 8) = P}, rm, q16)
        have rm24 := subst({y. gimple.bytes_at(VF, int_add(y, 24), 4) = AVV}, rm, q24)
        have rm28 := subst({y. gimple.bytes_at(VF, int_add(y, 28), 4) = FVV}, rm, q28)
        have rm32 := subst({y. gimple.bytes_at(VF, int_add(y, 32), 8) = int_add(int_add(int_sub(C2, 1), 32), int_mul(64, sc))}, rm, q32)
        have mi1: mallocng.rd(mallocng.mview(VF, mallocng.all_bytes()), int_add(M, 16), 8) = VR.mem :=
          trans(sym(mp(all_elim(vr, {VF}, {int_add(M, 16)}, {8}), arith(mo), simp(), arith(mtop))), trans(rm16, sym(vmem)))
        have mi2: mallocng.rd(mallocng.mview(VF, mallocng.all_bytes()), int_add(M, 24), 4) = VR.avail :=
          trans(sym(mp(all_elim(vr, {VF}, {int_add(M, 24)}, {4}), arith(mo), simp(), arith(mtop))), trans(rm24, trans(avv, sym(vav))))
        have mi3: mallocng.rd(mallocng.mview(VF, mallocng.all_bytes()), int_add(M, 28), 4) = VR.freed :=
          trans(sym(mp(all_elim(vr, {VF}, {int_add(M, 28)}, {4}), arith(mo), simp(), arith(mtop))), trans(rm28, trans(fvv, sym(vfd))))
        have tg: int_add(int_add(int_sub(C2, 1), 32), int_mul(64, sc)) =
            int_add(int_add(int_add(VR.last_idx, int_mul(32, VR.freeable)), int_mul(64, VR.sizeclass)), int_mul(4096, VR.maplen)) by arith(vli, vfb, vsc, vml)
        have mi4: mallocng.rd(mallocng.mview(VF, mallocng.all_bytes()), int_add(M, 32), 8) =
            int_add(int_add(int_add(VR.last_idx, int_mul(32, VR.freeable)), int_mul(64, VR.sizeclass)), int_mul(4096, VR.maplen)) :=
          trans(sym(mp(all_elim(vr, {VF}, {int_add(M, 32)}, {8}), arith(mo), simp(), arith(mtop))), trans(rm32, tg))
        have vrec: mallocng.meta_in_memory(mallocng.mview(VF, mallocng.all_bytes()), M, VR)
          by defs(taut(trans(pv0, sym(vpv)), trans(nx0, sym(vnx)), mi1, mi2, mi3, mi4, (int_lt(VR.last_idx, 32) by arith(vli, c232)), (int_lt(VR.freeable, 2) by arith(vfb)),
            (int_lt(VR.sizeclass, 64) by arith(vsc, hsl))), mallocng.meta_in_memory)
        // (the header: back to M; its active index the last)
        have hd1: mallocng.rd(mallocng.mview(VF, mallocng.all_bytes()), VR.mem, 8) = M :=
          subst({y. mallocng.rd(mallocng.mview(VF, mallocng.all_bytes()), y, 8) = M}, trans((int_add(P, 0) = P by arith(po)), sym(vmem)),
            trans(sym(mp(all_elim(vr, {VF}, {int_add(P, 0)}, {8}), arith(po), simp(), arith(ptop))), trans(qp, rm)))
        let R7 := gimple.bytes_at(fn_update(V20, "bytes", Z5), int_add(P, 8), 1)
        have r7a: R7 = gimple.bytes_at(fn_update(V20, "bytes", z), int_add(P, 8), 1) by mem(pb, mtopr, mrro, mctx, uatop, uao, cv, mpd, ptop, po, hs, hsl, pcx)
        have r7o0 r7l0 := apply(g.bytes_bound, {fn_update(V20, "bytes", z)}, {int_add(P, 8)}, {1}, (fn_update(V20, "bytes", z).bytes in fn_space(bits(64), bits(8)) by simp(zb)), simp())
        have r7o: R7 in omega by arith(r7a, r7o0)
        have r7l: int_lt(R7, 256) by arith(r7a, r7l0, e1)
        have hv0 := apply(mp.bfv[o := R7, pos := 0, k := 5, v := bits_of_int(5, int_sub(C2, 1))], r7o, arith(r7l), simp(), simp(), simp())
        have a5: bits_of_int(5, int_sub(C2, 1)) = int_sub(C2, 1) by defs(arith(aio, a31), bits_of_int, pow2)
        have hvv: HV = int_add(int_mul(32, int_div(R7, 32)), int_sub(C2, 1)) by arith(hv0, a5, r7o, r7l, aio, a31, (pow2(0) = 1 by simp()), (pow2(5) = 32 by simp()))
        have hb8: gimple.bytes_at(VF, int_add(P, 8), 1) = int_mod(HV, 256) by mem(pb, mtopr, mrro, mctx, uatop, uao, cv, mpd, ptop, po, hs, hsl, pcx)
        // the final memory: a memory
        have vf1 := apply(mp.vm_st, {V20}, {z}, {UAX}, {8}, {CVZ}, vzv)
        have vf2 := apply(mp.vm_st, {V20}, {Z1}, {int_add(fst(rr), 24)}, {4}, {AVV}, vf1)
        have vf3 := apply(mp.vm_st, {V20}, {Z2}, {int_add(fst(rr), 28)}, {4}, {FVV}, vf2)
        have vf4 := apply(mp.vm_st, {V20}, {Z3}, {int_add(fst(rr), 16)}, {8}, {P}, vf3)
        have vf5 := apply(mp.vm_st, {V20}, {Z4}, {int_add(P, 0)}, {8}, {fst(rr)}, vf4)
        have vf6 := apply(mp.vm_st, {V20}, {Z5}, {int_add(P, 8)}, {1}, {HV}, vf5)
        have vf7 := apply(mp.vm_st, {V20}, {Z6}, {int_add(fst(rr), 32)}, {1}, {LV}, vf6)
        have vf8 := apply(mp.vm_st, {V20}, {Z7}, {int_add(fst(rr), 32)}, {1}, {FRV}, vf7)
        have vfv: VF in x86_64_linux.Vm := apply(mp.vm_st, {V20}, {Z8}, {int_add(fst(rr), 32)}, {2}, {SCV}, vf8)
        have vfb: VF.bytes in fn_space(bits(64), bits(8)) by simp(expand(vfv, x86_64_linux.Vm))
        // (its active index: the last)
        have p8b: int_add(P, 8) in bits(64) by arith(po, ptop)
        have b8v _ := apply(mp.b8_view[vm := VF, fp := mallocng.all_bytes(), a := int_add(P, 8)], vfb, arith(po), mp(all_elim(ab, {int_add(P, 8)}), arith(po)))
        have be8: bits_of_int(64, int_add(P, 8)) = int_add(P, 8) by defs(arith(p8b), bits_of_int, pow2)
        have xb: mallocng.b8(mallocng.mview(VF, mallocng.all_bytes()), int_add(P, 8)) = int_mod(HV, 256) :=
          trans(trans(rewrite(be8, b8v), sym(apply(ms.bytes1, {VF}, {int_add(P, 8)}, vfb, p8b))), hb8)
        have xai := apply(mp.hv_mod, xb, hvv, r7o, r7l, c2o, c21, c232)
        let XA := int_mod(mallocng.b8(mallocng.mview(VF, mallocng.all_bytes()), int_add(VR.mem, 8)), 32)
        have xv: XA = LI := subst({y. int_mod(mallocng.b8(mallocng.mview(VF, mallocng.all_bytes()), int_add(y, 8)), 32) = LI}, sym(vmem), xai)
        // ---- the step's precondition (mp.gnpre)
        // (the slot's bytes: in g's range -- apart from m's record and the
        // context)
        have ile: int_le(R2, VG.last_idx) by arith(ril, gns, gl)
        have ml := mp(all_elim(ms.mul_le, {SG}, {R2}, {SG}, {VG.last_idx}), gst, r2o, simp(gst), simp(gl), arith(gst), ile)
        have grp: all a. a in omega -> int_le(SS, a) -> int_le(a, mallocng.slot_end(VG, R2)) -> mallocng.in_range(a, mallocng.group_range(VG)) proof
          fix a
          assume hao h1 h2
          show := apply(mp.group_bytes[A := A2, M := mallocng.mview(V17, mallocng.held(c, A2, B)), b := B, h := G, a := a], a2a, go, gok, hao,
            (int_le(VG.mem, a) by arith(h1, all_elim(gss, {R2}), gm, mr, ib4)), (int_le(a, mallocng.slot_end(VG, VG.last_idx)) by arith(h2, sen, all_elim(gse, {VG.last_idx}), ml)))
        qed
        have sfar: all a. a in omega -> int_le(SS, a) -> int_le(a, mallocng.slot_end(VG, R2)) ->
            !(int_le(M, a) && int_lt(a, int_add(M, 40))) && !(int_le(UA, a) && int_lt(a, int_add(UA, 8))) proof
          fix a
          assume hao h1 h2
          have gr := mp(all_elim(grp, {a}), hao, h1, h2)
          have nm: !(int_le(M, a) && int_lt(a, int_add(M, 40))) proof
            assume w
            have x1 x2 := w
            have {fx = fixed} := apply(mp.trec[c := c, A := A2, vm := V17, b := B, T := A.taken, m := M, A2 := A, a := a], hc, a2u, a2a, hin17, tl0, tk17, refl({A.taken}),
              hao, x1, arith(x2, cm))
            have nf := mp(all_elim(expand(hga17, mallocng.groups_apart), {lg}, {a}), conj(hlg, hao), conj(hlgl, rewrite(sym(hlge), gr)))
            show by taut(nf, fx)
          qed
          have nc := apply(mp.not_ctx[c := c, A := A2, M := mallocng.mview(V17, mallocng.held(c, A2, B)), b := B, brk := V17.brk, a := a], hc, a2u, a2a, H17, hao,
            disj({4}, ex_intro({G}, taut(iuG, gr))))
