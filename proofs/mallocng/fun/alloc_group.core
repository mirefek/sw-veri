      qed
      have d2: C = 1 -> !int_le(int_add(int_mul(SZ, C), 16), 2048) -> ex C2. (((C2 in omega && int_le(1, C2)) && int_le(C2, 32)) && int_le(int_mul(SZ, C2), 1048575)) && y = ok(TC(C2, I), empty) proof
