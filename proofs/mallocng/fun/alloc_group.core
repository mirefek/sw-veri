      have un23 := apply(mp.co_unt[c := c, A := A1, vm := V2, vm2 := V3, b := B], hc, a1u, a1a, hin2, co23)
      have th3 := apply(mp.tls_kept[c := c, A := A1, b := B, V0 := V2, V1 := V3, fs := s.fs_base, e := empty], fsb, th2, tl1, un23, ne8)
