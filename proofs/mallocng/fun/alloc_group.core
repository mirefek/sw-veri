    have ba2: bits_add(64, int_mul(SZ, C2), 16) = int_add(int_mul(SZ, C2), 16) by defs(arith(szo, c2o, mc2), bits_add, pow2)
    // the ghost part A1 at the callees
    let H1 := fn_update(h, "A", A1)
