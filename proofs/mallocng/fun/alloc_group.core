      let MS(l) := fst(snd(snd(snd(l))))
      have p0: P(TM(C0)) by ex_intro({C0}, taut(c0o, (int_le(1, C0) by arith(c0l)), c0h, refl({TM(C0)})))
      have pmv: all l. P(l) -> MS(l) in omega proof
