            have c2: !(g = M) -> g = G -> false proof
              assume ne eg
              have s1: A3.slots[g] = fn_update(A2.slots[G], R2, tag(2, M)) by simp(mp(app_update_other[f := mp.nest(A2, G, R2, M).slots, k := M, v := fn_build(C2, x0. tag(0, empty)), x := g], ne), eg)
              have d1: i = R2 -> false proof
                assume ei
                have u := rewrite(s1, e)
                have t: fn_update(A2.slots[G], R2, tag(2, M))[i] = tag(2, M) by simp(ei)
                show by defs(simp(trans(sym(u), t)), tag)
              qed
              have d2: !(i = R2) -> false proof
                assume ni
                have t: fn_update(A2.slots[G], R2, tag(2, M))[i] = A2.slots[G][i] := mp(app_update_other[f := A2.slots[G], k := R2, v := tag(2, M), x := i], ni)
                have u := trans(sym(t), rewrite(s1, e))
                have slt: A2.slots[G] in list_type(mallocng.Use) := mp(fn_space_app[a := omega, b := list_type(mallocng.Use), f := A2.slots, x := G], simp(a2a), go)
                have r2: tag(2, M) in set_image(omega, x0. tag(2, x0)) by taut(set_image_def[s := omega, f := x0. tag(2, x0), y := tag(2, M)],
                  (ex x0. x0 in omega && tag(2, x0) = tag(2, M) by ex_intro({M}, taut(mo, refl({tag(2, M)})))))
                have u2: tag(2, M) in mallocng.Use by defs(simp(r2), mallocng.Use)
                have {lu = len} := apply(mp.list_upd[l := A2.slots[G], t := mallocng.Use, i := R2, v := tag(2, M)], slt, r2o, ril, u2)
                have ln: int_lt(i, seq_len(A2.slots[G])) := rewrite(lu, rewrite(s1, hil))
                have q := mp(all_elim(uq, {G}, {i}), conj(go, hi), conj(ln, u))
                show by taut(ni, q)
              qed
              show by taut(d1, d2)
            qed
            have c3: !(g = M) -> !(g = G) -> false proof
              assume ne ng
              have es: A3.slots[g] = A2.slots[g] by simp(mp(app_update_other[f := mp.nest(A2, G, R2, M).slots, k := M, v := fn_build(C2, x0. tag(0, empty)), x := g], ne),
                mp(app_update_other[f := A2.slots, k := G, v := fn_update(A2.slots[G], R2, tag(2, M)), x := g], ng))
              have q := mp(all_elim(uq, {g}, {i}), conj(hg, hi), conj(rewrite(es, hil), rewrite(es, e)))
              show by taut(ng, q)
            qed
            show by taut(c1, c2, c3)
          qed
          show by defs(r, mallocng.no_reserved)
        qed
        have ac3: mp.upto(A3, A, sc) proof
          fix s2
          assume hs2 hl2
          show by simp(mp(all_elim(lw17, {s2}), hs2, hl2))
        qed
        have tk3: A3.taken = A.taken by simp()
        // (M's group fresh: in use, unlinked, its slots unused, the first
        // available, its slots fitting the request)
        have em3: A3.metas[M] = VR by simp()
        have nl2: int_le(KK, seq_len(mp.nest(A2, G, R2, M).used)) by simp(kkl)
        have iu3: mallocng.is_used(A3, M) by taut(apply(mp.ng_used[A := mp.nest(A2, G, R2, M), k := KK, T := A.taken, m := M, V := VR, n := C2, g := M], ab1, kko, nl2, mo), refl({M}))
        have b0: int_mod(int_div(VR.avail, 1), 2) = 1 proof
          have pa := rewrite((pow2(1) = 2 by simp()), mp(all_elim(mp(all_elim(pow2_add, {LI}), aio), {1}), simp()))
          have pp := mp(pow2_pos[k := LI], aio)
          show by arith(vav, pa, pp)
        qed
        have bit0: mallocng.bit(VR.avail, 0) = 1 by defs(subst({y. int_mod(int_div(VR.avail, y), 2) = 1}, sym((int_pow(2, 0) = 1 by simp())), b0), mallocng.bit)
        have rqf: int_le(int_add(req, mallocng.IB), mallocng.stride(VR)) by arith(strv, hfit, un16)
        have own: mallocng.own_mapping(VR) -> VR.last_idx = 0 proof
          assume w
          have w0 := expand(w, mallocng.own_mapping)
          have f: false by arith(w0, vsc, hsl, strv, un16)
          show by taut(f)
        qed
        have sl0: all x0. x0 in omega -> int_lt(x0, seq_len(A3.slots[M])) -> A3.slots[M][x0] = tag(0, empty) proof
          fix i
          assume hi hil
          have s0: A3.slots[M] = fn_build(C2, x0. tag(0, empty)) by simp()
          have dn: seq_len(fn_build(C2, x0. tag(0, empty))) = C2 by defs(fn_build_dom[d := C2, v := x0. tag(0, empty)], seq_len)
          have il := mp(nat_lt_mem[k := i, n := C2], hi, c2o, rewrite(dn, rewrite(s0, hil)))
          show := rewrite(sym(s0), mp(app_fn_build[d := C2, v := x0. tag(0, empty), a := i], il))
        qed
        have fgM: mallocng_specs.fresh_group(A3, M, sc, req) by defs(taut(iu3, rewrite(sym(em3), vsc), rewrite(sym(em3), vpv), rewrite(sym(em3), vnx), sl0,
          rewrite(sym(em3), bit0), rewrite(sym(em3), rqf), rewrite(sym(em3), own)), mallocng_specs.fresh_group)
        have fgr: fst(rr) = 0 || mallocng_specs.fresh_group(A3, fst(rr), sc, req) by taut(subst({y. mallocng_specs.fresh_group(A3, y, sc, req)}, sym(rm), fgM))
        // (untouched: the slot's bytes the allocator's or unmapped, its end
        // and the meta's the allocator's (grown), the counter the allocator's)
        have u31 u32 := expand(un017, mallocng.untouched)
        have mf := mp(mfp1, hnz)
        have ts: int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE) = 34359738367 by defs(simp(), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
        have ur: all a. a in omega -> (!(a in mallocng.footprint(c, A, B)) && !(a in EN)) && x86_64_linux.mapped(s.vm, int_div(a, x86_64_linux.PAGE)) ->
            VF.bytes[bits_of_int(64, a)] = s.vm.bytes[bits_of_int(64, a)] && VF.pages[int_div(a, x86_64_linux.PAGE)] = s.vm.pages[int_div(a, x86_64_linux.PAGE)] proof
          fix a
          assume hao hq
          have n1 n2 m0 := hq
          have b3 p3 := mp(all_elim(u31, {a}), hao, hq)
          have ml _ := expand(m0, x86_64_linux.mapped)
          have lo: int_lt(a, 18446744073709551616) by arith(ml, ts, hao)
          have ea: bits_of_int(64, a) = a by defs(arith(hao, lo), bits_of_int, pow2)
          have yb: a in bits(64) by arith(hao, lo)
          have ns: !mallocng.in_slot(VG, R2, a) proof
            assume isl
            have ir: mallocng.in_reserved(A2, a) by defs(ex_intro({G}, {R2}, taut(go, r2o, iuG, ril, rrs, isl)), mallocng.in_reserved)
            have q := mp(all_elim(rg17, {a}), hao, ir)
            show by taut(q, n1, m0)
          qed
          have ne: !(a = SE) proof
            assume e
            have {hf = fp} := apply(mp.held_fp, rewrite(sym(e), seh))
            have q := mp(all_elim(gr017, {a}), hao, hf)
            show by taut(q, n1, m0)
          qed
          have nt: !(int_le(M, a) && int_lt(a, int_add(M, 40))) proof
            assume w
            have w1 w2 := w
            have q := mp(all_elim(mf, {a}), hao, (int_le(M, a) && int_lt(a, int_add(M, mallocng.META_SIZE)) by defs(arith(w1, w2), mallocng.META_SIZE)))
            show by taut(q, n1, m0)
          qed
          have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
          have nu: !(int_le(UA, a) && int_lt(a, int_add(UA, 8))) proof
            assume w
            have w1 w2 := w
            show by taut(n1, apply(mp.ctx_fp[c := c, A := A, vm := s.vm, b := B, a := a], hc, au, hat, hin, hao, (int_le(c.ctx, a) by arith(w1, hx, cv)),
              (int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE)) by arith(w2, hx, cv, ks, hs, hsl))))
          qed
          have ns2 := expand(ns, mallocng.in_slot)
          have f1 := mp(all_elim(vfz, {a}), hao, lo, nt, nu, (int_lt(a, P) || int_le(int_add(P, 9), a) by arith(ns2, pst, ib4, pfi, zj1)))
          have nl: all j. j in omega -> int_lt(j, k) -> !(a = LA(j)) proof
            fix j
            assume jo jl e
            have l0 l1 l2 := mp(all_elim(lak, {j}), jo, arith(jl, kc))
            have mj: int_mul(SZ, j) in omega by simp(szo, jo)
            show by arith(ns2, e, l2, ne, mj, pst, ib4, po)
          qed
          have f2 := mp(all_elim(zr, {a}), yb, nl)
          have f3 := mp(all_elim(z0o, {a}), yb, arith(nt), (!(a = int_add(P, int_neg(3))) by arith(ns2, pst, ib4, pfi, zj1, hao, po)))
          have f4 := mp(all_elim(fout, {a}), hao, taut((int_lt(a, int_pow(2, 64)) by arith(lo, (int_pow(2, 64) = 18446744073709551616 by simp()))), ns))
          have eb: VF.bytes[a] = s.vm.bytes[a] := trans(f1, trans(f2, trans(f3, trans(rewrite(ea, f4), rewrite(ea, b3)))))
          have ep: VF.pages[int_div(a, x86_64_linux.PAGE)] = V17.pages[int_div(a, x86_64_linux.PAGE)] := subst({y. VF.pages[int_div(a, x86_64_linux.PAGE)] = y[int_div(a, x86_64_linux.PAGE)]},
            pgs, refl({VF.pages[int_div(a, x86_64_linux.PAGE)]}))
          show by taut(rewrite(sym(ea), eb), trans(ep, p3))
        qed
        have ebs: V20.brk_start = V17.brk_start := sym(rewrite(fv1, mp(app_update_other[f := V20, k := "bytes", v := V17.bytes, x := "brk_start"], (!("brk_start" = "bytes") by simp()))))
        have untF: mallocng.untouched(c, A, B, s.vm, VF, mp.errno(s.fs_base)) by defs(taut(ur, trans((VF.brk_start = V20.brk_start by simp()), trans(ebs, u32))), mallocng.untouched)
        // (grown: by the slot, the allocator's or unmapped; by the meta, the
        // same)
        have grF: all a. a in omega -> a in mallocng.footprint(c, A3, B) -> a in mallocng.footprint(c, A, B) || !x86_64_linux.mapped(s.vm, int_div(a, x86_64_linux.PAGE)) proof
          fix a
          assume hao hf
          have fe := apply(mp.gn_fp[c := c, A := A2, vm := V17, V1 := VF, b := B, g := G, i := R2, k := KK, T := A.taken, m := M, V := VR, n := C2, a := a], GP)
          have d1: a in mallocng.footprint(c, A2, B) -> a in mallocng.footprint(c, A, B) || !x86_64_linux.mapped(s.vm, int_div(a, x86_64_linux.PAGE)) proof
            assume h
            show := mp(all_elim(gr017, {a}), hao, h)
          qed
          have d2: a in omega && mallocng.in_slot(A2.metas[G], R2, a) -> a in mallocng.footprint(c, A, B) || !x86_64_linux.mapped(s.vm, int_div(a, x86_64_linux.PAGE)) proof
            assume h
            have _ isl := h
            have ir: mallocng.in_reserved(A2, a) by defs(ex_intro({G}, {R2}, taut(go, r2o, iuG, ril, rrs, isl)), mallocng.in_reserved)
            show := mp(all_elim(rg17, {a}), hao, ir)
          qed
          have d3: a in omega && int_le(M, a) && int_lt(a, int_add(M, mallocng.META_SIZE)) -> a in mallocng.footprint(c, A, B) || !x86_64_linux.mapped(s.vm, int_div(a, x86_64_linux.PAGE)) proof
            assume h
            have _ h1 h2 := h
            show := mp(all_elim(mf, {a}), hao, conj(h1, h2))
          qed
          show by taut(fe, hf, d1, d2, d3)
        qed
        // (all its slots active: never partially)
        have actF: !(fst(rr) = 0) -> int_lt(mallocng_specs.active_idx(VF, A3.metas[fst(rr)]), A3.metas[fst(rr)].last_idx) ->
            int_lt(4096, int_add(mallocng.UNIT, int_mul(mallocng.stride(A3.metas[fst(rr)]), int_add(A3.metas[fst(rr)].last_idx, 1)))) proof
          assume _ hl
          have em: A3.metas[fst(rr)] = VR := subst({y. A3.metas[y] = VR}, sym(rm), em3)
          have ai: mallocng_specs.active_idx(VF, VR) = LI by defs(xv, mallocng_specs.active_idx)
          have f: false by arith(rewrite(em, hl), ai, vli)
          show by taut(f)
        qed
        have inner: ex A4. ((A4 in mallocng.Abs && A4 in univ(1)) && mallocng.no_reserved(A4) && mp.upto(A4, A, sc) && A4.taken = A.taken) &&
            (fst(rr) = 0 || mallocng_specs.fresh_group(A4, fst(rr), sc, req)) &&
            mallocng.holds_in(c, A4, VF, B) && mallocng.untouched(c, A, B, s.vm, VF, mp.errno(s.fs_base)) && mp.grown(c, A4, A, B, s.vm) &&
            (!(fst(rr) = 0) -> int_lt(mallocng_specs.active_idx(VF, A4.metas[fst(rr)]), A4.metas[fst(rr)].last_idx) ->
               int_lt(4096, int_add(mallocng.UNIT, int_mul(mallocng.stride(A4.metas[fst(rr)]), int_add(A4.metas[fst(rr)].last_idx, 1)))))
          by ex_intro({A3}, taut(au3, uu3, nr3, ac3, tk3, fgr, hinF, untF, grF, actF))
        show by disj({2}, ex_intro({VF}, {fst(rr)}, taut(vfv, mbr, inner, of)))
      qed
      show by taut(alt2, nfail, nok)
    qed
    show by taut(mapped, nested)
  qed
  show by taut(none, some)
qed

// alloc_group's code by its purpose: its contract (`mp.agr_run`), the ghost
// part's A the state after
theorem mp.agp: all c sc req galm gib gab gss gmm gfm gs2c gas gef. c in mallocng.Cfg -> c.ctx = c_src_malloc_mallocng_malloc.__malloc_context ->
  c.sct = c_src_malloc_mallocng_malloc.__malloc_size_classes -> c.dbj = c_src_malloc_mallocng_malloc.debruijn32 ->
  c.scnt = c_src_malloc_mallocng_malloc.small_cnt_tab -> c.mcnt = c_src_malloc_mallocng_malloc.med_cnt_tab ->
  sc in bits(32) -> req in bits(64) ->
  mp.am_call(c, galm) -> mp.ib_call(c, gib) -> mp.db_call(c, gab) -> mp.sq_call(c, gss) ->
  mp.calls(gmm, mallocng_specs.mmap_spec_fun()) -> mp.calls(gfm, mallocng_specs.free_meta_spec_fun(c.ctx)) ->
  mp.calls(gs2c, mallocng_specs.size_to_class_spec_fun(c.sct, c.dbj)) -> mp.as_call(c, gas) -> mp.ef_call(c, gef) ->
  refines_ghost(c_src_malloc_mallocng_malloc.alloc_group(sc, req, galm, gib, gab, gss, gmm, gfm, gs2c, gas, gef), mallocng_specs.alloc_group_spec(c, sc, req), abi.World, mp.G)
proof
  fix c sc req galm gib gab gss gmm gfm gs2c gas gef
  assume hc hx hst hdj hscn hmcn hsb hrb halm hib hab hsq hmm hfm hs2c has hef
  let P := c_src_malloc_mallocng_malloc.alloc_group(sc, req, galm, gib, gab, gss, gmm, gfm, gs2c, gas, gef)
  have rp: all s o. runs(P, s, o) -> pair(s, o) in univ(1) proof
    fix s o
    assume hr
    show := apply(g.runs_univ, expand(hr, c_src_malloc_mallocng_malloc.alloc_group))
  qed
  unfold mallocng_specs.alloc_group_spec
  refine ct.refines_contract_g with mp.g_world, rp
  fix s h o
  assume hw hh hr hpre
  let S := union2(s, h)
  let A := h.A
  let B := h.blocks
  let V0 := s.vm
  have _ hd _ _ := mp(all_elim(mp.g_rec, {h}), hh)
  have sd: dom(s) = insert("vm", insert("os", insert("fs_base", insert("cpu", insert("objs", empty))))) by simp(expand(hw, abi.World))
  have aS: S.A = A by simp(sd, hd)
  have vS: S.vm = V0 by simp(sd, hd)
  have bS: S.blocks = B by simp(sd, hd)
  have fS: S.fs_base = s.fs_base by simp(sd, hd)
  have hin: mallocng.holds_in(c, A, V0, B) by simp(hpre, sd, hd)
  have hnr: mallocng.no_reserved(A) by simp(hpre, sd, hd)
  have hth: abi.thread_ok(V0, s.fs_base) by simp(hpre, sd, hd)
  have htl: mallocng_specs.tls_apart(c, A, B, s.fs_base) by simp(hpre, sd, hd)
  have hbs: abi.brk_start_ok(V0) by simp(hpre, sd, hd)
  have heo: mallocng_specs.errno_ok(V0, s.objs, s.fs_base) by simp(hpre, sd, hd)
  have hea: mallocng_specs.errno_apart(c, A, B, V0, s.fs_base) by simp(hpre, sd, hd)
  have hsl: int_lt(sc, 48) by simp(hpre, sd, hd)
  have hfit: int_le(int_add(req, mallocng.IB), int_mul(mallocng.UNIT, mallocng.size_classes[sc])) by simp(hpre, sd, hd)
  have run := apply(mp.agr_run[c := c, sc := sc, req := req, galm := galm, gib := gib, gab := gab, gss := gss, gmm := gmm, gfm := gfm, gs2c := gs2c, gas := gas, gef := gef,
    s := s, h := h, o := o], hc, hx, hst, hdj, hscn, hmcn, hsb, hsl, hrb, hfit, halm, hib, hab, hsq, hmm, hfm, hs2c,
    apply(mp.as_call_ge_of[c := c, f := gas, k := int_add(sc, 1)], has), hef, hw, hh, hin, hnr, hth, htl, hbs, heo, hea, hr)
  // a return: the ghost part's A the new state
  have k: case 2 of run proof
    assume e
    obtain V2 g, hv2 hgb ex2 ho from e
    obtain A2, ha2 hu2 hnr2 hup htk hfg hin2 hunt hgr hact from ex2
    let S1 := fn_update(fn_update(S, "A", A2), "vm", V2)
    let H2 := fn_update(h, "A", A2)
    let s1 := fn_update(s, "vm", V2)
    have hg2 := apply(mp.g_upd, {h}, {A2}, hh, ha2, hu2)
    // the world's part and the ghost part joined: the spec's state
    have sk := apply(abi.keys_of[f := s, d := insert("vm", insert("os", insert("fs_base", insert("cpu", insert("objs", empty)))))], sd)
    have na: all z. z in s -> fst(z) != "A" proof
      fix z
      assume hz
      show by simp(mp(all_elim(sk, {z}), hz))
    qed
    have _ hk := mp(all_elim(mp.g_world, {H2}), hg2)
    have nv: all z. z in H2 -> fst(z) != "vm" proof
      fix z
      assume hz
      show by simp(mp(all_elim(hk, {z}), hz))
    qed
    have e1 := mp(fn_update_union_r[a := s, b := h, k := "A", v := A2], na)
    have e2 := mp(fn_update_union_l[a := s, b := H2, k := "vm", v := V2], nv)
    have eS: union2(s1, H2) = S1 := sym(trans(subst({y. S1 = fn_update(y, "vm", V2)}, e1, refl({S1})), e2))
    show by disj({2}, ex_intro({s1}, {g}, {H2}, spec_ret({A2}, {g}, {V2}, hg2, ho, ha2, hnr2, hup, htk, hgb, hfg, aS, vS, bS, fS, hv2, hin2, hunt, hgr, hact, eS)))
  qed
  show by taut(run, k)
qed

theorem mp.agp_fun: all c regs galm gib gab gss gmm gfm gs2c gas gef. c in mallocng.Cfg -> c.ctx = c_src_malloc_mallocng_malloc.__malloc_context ->
  c.sct = c_src_malloc_mallocng_malloc.__malloc_size_classes -> c.dbj = c_src_malloc_mallocng_malloc.debruijn32 ->
  c.scnt = c_src_malloc_mallocng_malloc.small_cnt_tab -> c.mcnt = c_src_malloc_mallocng_malloc.med_cnt_tab ->
  mp.am_call(c, galm) -> mp.ib_call(c, gib) -> mp.db_call(c, gab) -> mp.sq_call(c, gss) ->
  mp.calls(gmm, mallocng_specs.mmap_spec_fun()) -> mp.calls(gfm, mallocng_specs.free_meta_spec_fun(c.ctx)) ->
  mp.calls(gs2c, mallocng_specs.size_to_class_spec_fun(c.sct, c.dbj)) -> mp.as_call(c, gas) -> mp.ef_call(c, gef) ->
  regs in abi.ARGS ->
  refines_ghost(c_src_malloc_mallocng_malloc.alloc_group_fun(galm, gib, gab, gss, gmm, gfm, gs2c, gas, gef)[regs], mallocng_specs.alloc_group_spec_fun(c)[regs], abi.World, mp.G)
proof
  fix c regs galm gib gab gss gmm gfm gs2c gas gef
  assume hc hx hst hdj hscn hmcn halm hib hab hsq hmm hfm hs2c has hef hr
  have hm: all regs. refines_ghost(c_src_malloc_mallocng_malloc.alloc_group(bits_of_int(32, regs[0]), bits_of_int(64, regs[1]), galm, gib, gab, gss, gmm, gfm, gs2c, gas, gef),
      mallocng_specs.alloc_group_spec(c, bits_of_int(32, regs[0]), bits_of_int(64, regs[1])), abi.World, mp.G) proof
    fix regs
    show := mp(all_elim(mp.agp, {c}, {bits_of_int(32, regs[0])}, {bits_of_int(64, regs[1])}, {galm}, {gib}, {gab}, {gss}, {gmm}, {gfm}, {gs2c}, {gas}, {gef}),
      hc, hx, hst, hdj, hscn, hmcn, simp(), simp(), halm, hib, hab, hsq, hmm, hfm, hs2c, has, hef)
  qed
  have w := mp(g.fun_res_ghost[p := x0. c_src_malloc_mallocng_malloc.alloc_group(bits_of_int(32, x0[0]), bits_of_int(64, x0[1]), galm, gib, gab, gss, gmm, gfm, gs2c, gas, gef),
    q := x0. mallocng_specs.alloc_group_spec(c, bits_of_int(32, x0[0]), bits_of_int(64, x0[1])), w := 64, n := 2, G := mp.G],
    mp.g_univ, hm)
  show by defs(mp(all_elim(w, {regs}), hr), c_src_malloc_mallocng_malloc.alloc_group_fun, mallocng_specs.alloc_group_spec_fun, letin)
qed

// (the purpose spec diverges nowhere it does not also raise)
theorem mp.agp_divg: all c. tr.div_raises_g(mp.G, mallocng_specs.alloc_group_spec_fun(c))
proof
  fix c
  show by divergence(mp.g_univ, mp.gS)
qed

// alloc_group's code called as alloc_group
theorem mp.agr_q: all c k galm gib gab gss gmm gfm gs2c gas gef. c in mallocng.Cfg -> c.ctx = c_src_malloc_mallocng_malloc.__malloc_context ->
  c.sct = c_src_malloc_mallocng_malloc.__malloc_size_classes -> c.dbj = c_src_malloc_mallocng_malloc.debruijn32 ->
  c.scnt = c_src_malloc_mallocng_malloc.small_cnt_tab -> c.mcnt = c_src_malloc_mallocng_malloc.med_cnt_tab ->
  k in omega -> mp.am_call(c, galm) -> mp.ib_call(c, gib) -> mp.db_call(c, gab) -> mp.sq_call(c, gss) ->
  mp.calls(gmm, mallocng_specs.mmap_spec_fun()) -> mp.calls(gfm, mallocng_specs.free_meta_spec_fun(c.ctx)) ->
  mp.calls(gs2c, mallocng_specs.size_to_class_spec_fun(c.sct, c.dbj)) -> mp.as_call_ge(c, gas, int_add(k, 1)) -> mp.ef_call(c, gef) ->
  mp.agr_call_ge(c, c_src_malloc_mallocng_malloc.alloc_group_fun(galm, gib, gab, gss, gmm, gfm, gs2c, gas, gef), k)
proof
  fix c k galm gib gab gss gmm gfm gs2c gas gef
  assume hc hx hst hdj hscn hmcn ko halm hib hab hsq hmm hfm hs2c hask hef
  fix sc req t h regs o2
  assume hsb hrb hsl hge hfit hw hh hin hnr hth htl hbs heo hea hro hr
  have has := apply(mp.as_call_ge_mono[c := c, f := gas, k := int_add(k, 1), k2 := int_add(sc, 1)], (int_add(k, 1) in omega by arith(ko)),
    (int_le(int_add(k, 1), int_add(sc, 1)) by arith(ko, hge, hsb)), hask)
  have rl rn r0 r1 := apply(gc.regs_32_64, hsb, hrb, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  have o2l: ord_le(2, seq_len(regs)) by defs(simp(rn), ord_le)
  have bp: bits_of_int(64, regs[1]) = req by defs(simp(r1, hrb), bits_of_int, pow2)
  step o3 V2 g, e hs1 from hr with o2l, r0, bp, mp.agr_run using ra, hc, hx, hst, hdj, hscn, hmcn, hsb, hsl, hrb, hfit, halm, hib, hab, hsq, hmm, hfm, hs2c, has, hef,
    hw, hh, hin, hnr, hth, htl, hbs, heo, hea
  have hv2 hgb ex2 := hs1
  step o4 y, e2 from e with g.result64_inv using hgb
  show by disj({2}, ex_intro({V2}, {pair(g, y)}, simp(hv2, ex2, e2)))
qed
