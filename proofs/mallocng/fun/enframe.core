// enframe by its purpose: slot i of a group framed for n bytes.

// (a slot of a group in use: its bytes the world's -- in the group's, of
// the allocator's ranges)
theorem mp.slot_vis(c, A, vm, b, objs, g, i): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_m(c, A, vm, b) -> mallocng.shown_in(c, A, objs) ->
  mallocng.is_used(A, g) -> i in omega -> int_lt(i, seq_len(A.slots[g])) ->
  all a. a in omega -> int_le(int_sub(mallocng.slot_start(A.metas[g], i), mallocng.IB), a) && int_lt(a, mallocng.slot_end(A.metas[g], i)) -> a in objs.c_bytes
proof
  assume hc hu ha hh hsh hg hi hil
  let V := A.metas[g]
  let S := mallocng.stride(V)
  have {H = inv, hrw = rw} := expand(hh, mallocng.holds_m)
  have {huo = used} := expand(H, mallocng.holds)
  have {go = nat} := apply(mp.used_nat, ha, hg)
  have gok := apply(mp.used_group, huo, hg)
  have vt: V in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A.metas, x := g], simp(ha), go)
  have vo: V.mem in omega && V.maplen in omega && V.last_idx in omega by simp(vt)
  have {gl = nslots, gmp = mapped} := expand(gok, mallocng.group_ok)
  have so := apply(mp.stride_nat, ha, go, gok)
  have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
  have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
  have il: int_le(int_add(i, 1), int_add(V.last_idx, 1)) by arith(gl, hil)
  have mle := mp(all_elim(ms.mul_le, {S}, {int_add(i, 1)}, {S}, {int_add(V.last_idx, 1)}), so, (int_add(i, 1) in omega by simp(hi)), simp(so), simp(vo), arith(so), il)
  have d1: int_mul(S, int_add(i, 1)) = int_add(int_mul(S, i), S) by simp(so, hi)
  have m0: int_mul(S, i) in omega by simp(so, hi)
  have w: all a. a in omega -> int_le(int_sub(mallocng.slot_start(V, i), mallocng.IB), a) && int_lt(a, mallocng.slot_end(V, i)) -> a in objs.c_bytes proof
    fix a
    assume hao hr
    have s1 s2 := expand(hr, mallocng.slot_end, mallocng.slot_start, mallocng.storage)
    have up: int_lt(a, int_add(int_add(V.mem, 16), int_sub(int_mul(S, int_add(V.last_idx, 1)), 4))) by arith(s2, cu, ci, d1, mle)
    have lo: int_le(V.mem, a) by arith(s1, cu, ci, m0, vo)
    have c1: int_lt(0, V.maplen) -> mallocng.in_range(a, mallocng.group_range(V)) proof
      assume k
      have _ big := mp(gmp, k)
      have e := mp(ite_t[c := int_lt(0, V.maplen), a := pair(V.mem, int_mul(V.maplen, 4096)), b := pair(V.mem, int_add(int_sub(int_add(mallocng.UNIT, int_mul(S, int_add(V.last_idx, 1))), mallocng.IB), 1))], k)
      have r: int_le(V.mem, a) && int_lt(a, int_add(V.mem, int_mul(V.maplen, 4096))) by arith(lo, up, big, cu)
      show by defs(simp(e, r), mallocng.group_range, mallocng.in_range)
    qed
    have c2: !int_lt(0, V.maplen) -> mallocng.in_range(a, mallocng.group_range(V)) proof
      assume k
      have e := mp(ite_f[c := int_lt(0, V.maplen), a := pair(V.mem, int_mul(V.maplen, 4096)), b := pair(V.mem, int_add(int_sub(int_add(mallocng.UNIT, int_mul(S, int_add(V.last_idx, 1))), mallocng.IB), 1))], k)
      have r: int_le(V.mem, a) && int_lt(a, int_add(V.mem, int_add(int_sub(int_add(mallocng.UNIT, int_mul(S, int_add(V.last_idx, 1))), mallocng.IB), 1))) by arith(lo, up, cu, ci)
      show by defs(simp(e, r), mallocng.group_range, mallocng.in_range)
    qed
    have inr: mallocng.in_range(a, mallocng.group_range(V)) by taut(c1, c2)
    have {ow = own} := apply(mp.grp_own[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, brk := vm.brk, g := g, a := a], hc, hu, ha, H, hg, hao, inr)
    show := apply(mp.ranges_vis[c := c, A := A, objs := objs, a := a], hsh, hao, ow)
  qed
  show := w
qed

// ----------------------------------------------------------------------
//  enframe's conditions: slot i of the group g, the one reserved, its bytes
//  accessible (`slot_rw`), room for n bytes: they hold; the stride, the
//  slot's start, the mem word the group's; its check byte and end byte 0
theorem mp.ef_pre(c, A, vm, b, objs, fs, g, i, n): c in mallocng.Cfg -> c.sct = c_src_malloc_mallocng_malloc.__malloc_size_classes ->
  A in univ(1) -> A in mallocng.Abs -> vm.bytes in fn_space(bits(64), bits(8)) -> g in bits(64) -> i in omega -> n in bits(64) ->
  mallocng.holds_m(c, A, vm, b) -> mallocng.shown_in(c, A, objs) -> abi.thread_ok(vm, fs) -> mallocng.is_used(A, g) -> mallocng.reserved_only(A, g, i) ->
  mallocng.slot_rw(vm, A.metas[g], i) ->
  int_le(int_add(n, mallocng.IB), mallocng.stride(A.metas[g])) -> int_lt(mallocng.stride(A.metas[g]), int_pow(2, 31)) ->
  (int_le(int_add(fs, 8), int_sub(mallocng.slot_start(A.metas[g], i), mallocng.IB)) || int_le(mallocng.slot_end(A.metas[g], i), fs)) ->
  mallocng_specs.enframe_pre(vm, objs, fs, c_src_malloc_mallocng_malloc.__malloc_size_classes, g, i, n) &&
  mallocng_specs.stride_w(vm, g) = mallocng.stride(A.metas[g]) &&
  mallocng_specs.eslot(vm, g, i) = mallocng.slot_start(A.metas[g], i) &&
  mallocng_specs.rd64(vm, bits_add(64, g, 16)) = A.metas[g].mem &&
  int_lt(i, 32) && int_le(i, A.metas[g].last_idx) &&
  vm.bytes[bits_of_int(64, int_sub(mallocng.slot_start(A.metas[g], i), mallocng.IB))] = 0 &&
  vm.bytes[bits_of_int(64, mallocng.slot_end(A.metas[g], i))] = 0
proof
  assume hc hsct hu ha hvb hg hi hn hh hsh hth hus hro hrw hns hs31 hfs
  have VS := apply(mp.held_vis[c := c, A := A, objs := objs, b := b], hsh)
  let V := A.metas[g]
  let FP := mallocng.held(c, A, b)
  let M := mallocng.mview(vm, FP)
  let S := mallocng.stride(V)
  let SCT := c_src_malloc_mallocng_malloc.__malloc_size_classes
  have {H = inv} := expand(hh, mallocng.holds_m)
  have {uo = used} := expand(H, mallocng.holds)
  have gok := apply(mp.used_group, uo, hus)
  have {mim, hd = hdr, gl = nslots} := expand(gok, mallocng.group_ok)
  have go: g in omega by simp(hg)
  have vt: V in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A.metas, x := g], simp(ha), go)
  have vo: V.mem in omega && V.maplen in omega && V.last_idx in omega by simp(vt)
  have vme vml vli := vo
  have sn := apply(mp.stride_nat, ha, go, gok)
  have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
  have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
  have il _ _ := expand(hro, mallocng.reserved_only)
  have ile: int_le(i, V.last_idx) by arith(gl, il)
  have lt32: int_lt(V.last_idx, 32) by simp(expand(mim, mallocng.meta_in_memory))
  have i32: int_lt(i, 32) by arith(ile, lt32)
  have ss: mallocng.slot_start(V, i) = int_add(int_add(V.mem, 16), int_mul(S, i)) by defs(arith(cu), mallocng.slot_start, mallocng.storage)
  have se: mallocng.slot_end(V, i) = int_sub(int_add(mallocng.slot_start(V, i), S), 4) by defs(arith(ci), mallocng.slot_end)
  have m0: int_mul(S, i) in omega by simp(sn, hi)
  // get_stride's conditions; the stride the group's
  have gsp sw _ := apply(mp.gs_pre[c := c, A := A, vm := vm, b := b, objs := objs, g := g], hc, hu, ha, hg, hh, hsh, hus)
  have gsp2 := rewrite(hsct, gsp)
  have gnz g40 _ _ := expand(gsp, mallocng_specs.get_stride_pre)
  // the meta's bytes; its mem word
  have _ g24 inr := apply(mp.meta_mem, hc, hu, ha, hh, hus)
  have m16: all j. j in omega -> int_lt(j, 8) -> int_add(int_add(g, 16), j) in FP && mallocng.m_mapped(M, int_add(int_add(g, 16), j)) &&
      snd(mallocng.pg(M, int_add(int_add(g, 16), j))).prot.r && !(snd(mallocng.pg(M, int_add(int_add(g, 16), j))).kind = 2) proof
    fix j
    assume hj hjl
    have f rw k := mp(all_elim(inr, {int_add(int_add(g, 16), j)}), (int_add(int_add(g, 16), j) in omega by simp(go, hj)), arith(hj), arith(hj, hjl))
    show by taut(f, expand(rw, mallocng.m_rw), k)
  qed
  have u16 := apply(mp.view_usable[vm := vm, fp := FP, objs := objs, a := int_add(g, 16), n := 8], (int_add(g, 16) in omega by simp(go)), m16, VS)
  have in16: all j. j in omega -> int_lt(j, 8) -> int_add(int_add(g, 16), j) in FP proof
    fix j
    assume hj hjl
    have f _ _ _ := mp(all_elim(m16, {j}), hj, hjl)
    show f
  qed
  have vr := apply(mp.view_read[vm := vm, fp := FP, a := int_add(g, 16), n := 8], (int_add(g, 16) in omega by simp(go)), simp(), simp(), in16)
  have _ _ mi3 .. := expand(mim, mallocng.meta_in_memory)
  have memv: gimple.bytes_at(vm, int_add(g, 16), 8) = V.mem := trans(vr, mi3)
  have b16: bits_add(64, g, 16) = int_add(g, 16) by defs(arith(go, g40), bits_add, pow2)
  have bbo bbl := mp(all_elim(g.bytes_bound, {vm}, {int_add(g, 16)}, {8}), hvb, simp())
  have p8: int_pow(256, 8) = 18446744073709551616 by simp()
  have mb: int_lt(V.mem, 18446744073709551616) by arith(memv, bbl, p8)
  have r1 := all_elim(ms.v_rd64, {vm}, {bits_add(64, g, 16)})
  have bm: bits_add(64, V.mem, 0) = V.mem by defs(arith(vme, mb), bits_add, pow2)
  have rdm: mallocng_specs.rd64(vm, bits_add(64, g, 16)) = V.mem by simp(r1, b16, memv, bm)
  have esl: mallocng_specs.eslot(vm, g, i) = mallocng.slot_start(V, i) by defs(simp(rdm, sw, cu), mallocng_specs.eslot, mallocng.slot_start, mallocng.storage)
  let E := mallocng_specs.eslot(vm, g, i)
  let SW := mallocng_specs.stride_w(vm, g)
  have _ _ mpos := hd
  have c3: int_lt(i, int_pow(2, 31)) by simp(i32)
  have c4: int_le(int_add(n, mallocng.IB), SW) := rewrite(sym(sw), hns)
  have c5: int_lt(SW, int_pow(2, 31)) := rewrite(sym(sw), hs31)
  have c6: int_lt(mallocng.IB, E) by arith(esl, ss, ci, mpos, m0)
  // the slot's bytes: accessible, below the task size
  have chunk: all a. a in omega -> int_le(int_sub(mallocng.slot_start(V, i), mallocng.IB), a) -> int_lt(a, mallocng.slot_end(V, i)) ->
      mallocng.m_rw(mallocng.mview(vm, mallocng.all_bytes), a) && !(snd(mallocng.pg(mallocng.mview(vm, mallocng.all_bytes), a)).kind = 2) proof
    fix a
    assume ha2 h1 h2
    show := mp(all_elim(expand(hrw, mallocng.slot_rw), {a}), ha2, conj(h1, h2))
  qed
  have s4: int_le(4, S) by arith(hns, ci, (n in omega by simp(hn)))
  have lst: int_sub(mallocng.slot_end(V, i), 1) in omega by arith(se, ss, vme, m0, s4)
  have lrw _ := mp(all_elim(chunk, {int_sub(mallocng.slot_end(V, i), 1)}), lst, arith(se, ci, s4), arith())
  have lmp _ _ := expand(lrw, mallocng.m_rw)
  have ltk _ := expand(lmp, mallocng.m_mapped)
  have tk: int_lt(int_div(int_sub(mallocng.slot_end(V, i), 1), 4096), 34359738367) by simp(expand(ltk, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))
  have c7: int_lt(int_add(E, SW), int_pow(2, 63)) by arith(esl, sw, se, ss, vme, m0, sn, tk, (int_pow(2, 63) = 9223372036854775808 by simp()))
  have sso: mallocng.slot_start(V, i) in omega by arith(ss, vme, m0)
  // the meta's mem word apart from the slot: the meta's bytes are the
  // allocator's, the slot's interior is not
  have c8: int_le(int_add(g, 24), int_sub(E, mallocng.IB)) || int_le(int_add(int_sub(E, mallocng.IB), SW), int_add(g, 16)) proof
    // (a byte both the meta's and the slot interior's: none)
    have none: all X. X in omega -> int_le(g, X) -> int_lt(X, int_add(g, 40)) -> int_lt(int_sub(mallocng.slot_start(V, i), mallocng.IB), X) -> int_lt(X, mallocng.slot_end(V, i)) -> false proof
      fix X
      assume x1 x2 x3 x4 x5
      have fh _ _ := mp(all_elim(inr, {X}), x1, x2, x3)
      have {f = fp} := apply(mp.held_fp, fh)
      have isl: mallocng.in_slot(V, i, X) by defs(taut(x4, x5), mallocng.in_slot)
      have nf := apply(mp.int_nfp[c := c, A := A, b := b, g := g, i := i, a := X], go, hi, hus, hro, isl)
      show by taut(f, nf)
    qed
    have k: !int_le(int_add(g, 24), int_sub(E, mallocng.IB)) -> !int_le(int_add(int_sub(E, mallocng.IB), SW), int_add(g, 16)) -> false proof
      assume k1 k2
      have ka: int_le(int_add(g, 16), int_sub(mallocng.slot_start(V, i), 3)) -> false proof
        assume h
        let X := int_sub(mallocng.slot_start(V, i), 3)
        show := mp(all_elim(none, {X}), arith(h, go), arith(h, go), arith(k1, esl, ci, sso), arith(ci, sso), arith(se, s4, sso, sn))
      qed
      have kb: !int_le(int_add(g, 16), int_sub(mallocng.slot_start(V, i), 3)) -> false proof
        assume h
        let X := int_add(g, 16)
        show := mp(all_elim(none, {X}), simp(go), arith(go), arith(go), arith(h, ci, sso, go), arith(k2, esl, sw, se, ci, sso, sn, go))
      qed
      show by taut(ka, kb)
    qed
    show by taut(k)
  qed
  have c9: int_le(int_add(fs, 8), int_sub(E, mallocng.IB)) || int_le(int_add(int_sub(E, mallocng.IB), SW), fs) by arith(hfs, esl, sw, se, ci, sso, sn)
  // GIMPLE may read and write the slot's bytes
  have cb: all j. j in omega -> int_lt(j, SW) -> int_add(int_sub(E, mallocng.IB), j) in mallocng.all_bytes &&
      mallocng.m_rw(mallocng.mview(vm, mallocng.all_bytes), int_add(int_sub(E, mallocng.IB), j)) &&
      !(snd(mallocng.pg(mallocng.mview(vm, mallocng.all_bytes), int_add(int_sub(E, mallocng.IB), j))).kind = 2) proof
    fix j
    assume hj hjl
    have ao: int_add(int_sub(E, mallocng.IB), j) in omega by arith(c6, hj)
    have r k := mp(all_elim(chunk, {int_add(int_sub(E, mallocng.IB), j)}), ao, arith(esl, hj, sso), arith(esl, sw, se, ci, hjl, sso, sn))
    show by taut(r, k, (int_add(int_sub(E, mallocng.IB), j) in mallocng.all_bytes by defs(simp(ao), mallocng.all_bytes)))
  qed
  have cbr: all j. j in omega -> int_lt(j, SW) -> int_add(int_sub(E, mallocng.IB), j) in mallocng.all_bytes && mallocng.m_mapped(mallocng.mview(vm, mallocng.all_bytes), int_add(int_sub(E, mallocng.IB), j)) &&
      snd(mallocng.pg(mallocng.mview(vm, mallocng.all_bytes), int_add(int_sub(E, mallocng.IB), j))).prot.r && !(snd(mallocng.pg(mallocng.mview(vm, mallocng.all_bytes), int_add(int_sub(E, mallocng.IB), j))).kind = 2) proof
    fix j
    assume hj hjl
    have a r k := mp(all_elim(cb, {j}), hj, hjl)
    show by taut(a, expand(r, mallocng.m_rw), k)
  qed
  have cbw: all j. j in omega -> int_lt(j, SW) -> int_add(int_sub(E, mallocng.IB), j) in mallocng.all_bytes && mallocng.m_mapped(mallocng.mview(vm, mallocng.all_bytes), int_add(int_sub(E, mallocng.IB), j)) &&
      snd(mallocng.pg(mallocng.mview(vm, mallocng.all_bytes), int_add(int_sub(E, mallocng.IB), j))).prot.w && !(snd(mallocng.pg(mallocng.mview(vm, mallocng.all_bytes), int_add(int_sub(E, mallocng.IB), j))).kind = 2) proof
    fix j
    assume hj hjl
    have a r k := mp(all_elim(cb, {j}), hj, hjl)
    show by taut(a, expand(r, mallocng.m_rw), k)
  qed
  have eo4: int_sub(E, mallocng.IB) in omega by arith(c6)
  // (... in g's range: none of the ABI's)
  have sv := apply(mp.slot_vis[c := c, A := A, vm := vm, b := b, objs := objs, g := g, i := i], hc, hu, ha, hh, hsh, hus, hi, il)
  have nhb: all j. j in omega -> int_lt(j, SW) -> int_add(int_sub(E, mallocng.IB), j) in objs.c_bytes proof
    fix j
    assume hj hjl
    have ao: int_add(int_sub(E, mallocng.IB), j) in omega by arith(c6, hj)
    have l1: int_le(int_sub(mallocng.slot_start(V, i), mallocng.IB), int_add(int_sub(E, mallocng.IB), j)) by arith(esl, hj, sso)
    have l2: int_lt(int_add(int_sub(E, mallocng.IB), j), mallocng.slot_end(V, i)) by arith(esl, sw, se, ci, hjl, sso, sn)
    show := mp(all_elim(sv, {int_add(int_sub(E, mallocng.IB), j)}), ao, conj(l1, l2))
  qed
  have c10 := apply(mp.view_usable_at[vm := vm, fp := mallocng.all_bytes, objs := objs, a := int_sub(E, mallocng.IB), n := SW], eo4, cbr, nhb)
  have c11 := apply(mp.view_usable_w_at[vm := vm, fp := mallocng.all_bytes, objs := objs, a := int_sub(E, mallocng.IB), n := SW], eo4, cbw, nhb)
  // the check byte, the end byte: the allocator's, 0
  have nr0 := apply(mp.ronly_out[A := A, g := g, i := i, a := int_sub(mallocng.slot_start(V, i), mallocng.IB)], hro, (!mallocng.in_slot(V, i, int_sub(mallocng.slot_start(V, i), mallocng.IB)) by defs(arith(), mallocng.in_slot)))
  have k0f k0z := apply(mp.chk_fp[c := c, A := A, vm := vm, b := b, g := g, j := i], hc, hu, ha, hi, hh, hus, arith(ile), nr0)
  have x0o: int_sub(mallocng.slot_start(V, i), mallocng.IB) in omega by arith(ss, ci, vme, m0)
  have k0v _ := apply(mp.b8_view[vm := vm, fp := FP, a := int_sub(mallocng.slot_start(V, i), mallocng.IB)], hvb, x0o, k0f)
  have chk0: vm.bytes[bits_of_int(64, int_sub(mallocng.slot_start(V, i), mallocng.IB))] = 0 := trans(sym(k0v), k0z)
  have c12: gimple.bytes_at(vm, bits_of_int(64, int_sub(E, mallocng.IB)), 1) = 0 by defs(simp(esl, chk0), gimple.bytes_at)
  have sn1: mallocng.slot_start(V, int_add(i, 1)) = int_add(mallocng.slot_start(V, i), S) by defs(simp(sn, hi), mallocng.slot_start, mallocng.storage)
  have ee: int_sub(mallocng.slot_start(V, int_add(i, 1)), mallocng.IB) = mallocng.slot_end(V, i) by arith(sn1, se, ci)
  have nr1 := apply(mp.ronly_out[A := A, g := g, i := i, a := int_sub(mallocng.slot_start(V, int_add(i, 1)), mallocng.IB)], hro,
    (!mallocng.in_slot(V, i, int_sub(mallocng.slot_start(V, int_add(i, 1)), mallocng.IB)) by defs(arith(ee), mallocng.in_slot)))
  have k1f k1z := apply(mp.chk_fp[c := c, A := A, vm := vm, b := b, g := g, j := int_add(i, 1)], hc, hu, ha, simp(hi), hh, hus, arith(ile), nr1)
  have x1o: int_sub(mallocng.slot_start(V, int_add(i, 1)), mallocng.IB) in omega by arith(ee, lst)
  have k1v _ := apply(mp.b8_view[vm := vm, fp := FP, a := int_sub(mallocng.slot_start(V, int_add(i, 1)), mallocng.IB)], hvb, x1o, k1f)
  have end0 := rewrite(ee, trans(sym(k1v), k1z))
  have pre: mallocng_specs.enframe_pre(vm, objs, fs, SCT, g, i, n)
    by defs(taut(gsp2, u16, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, hth), mallocng_specs.enframe_pre)
  show by taut(pre, sw, esl, rdm, i32, ile, chk0, end0)
qed

// ----------------------------------------------------------------------
//  enframe's frame: its header writes (`enframe_hdr`), then set_size's
// the header writes for p in slot i (start SS), the group's storage ST:
// below SS - 3 and from p on the old bytes; p's index at p - 3, its offset
// from the storage at p - 2; past the slot's start the slot's offset record
// at SS - 2, its tag at SS - 3 and p's check byte at p - 4
theorem mp.ef_hdr(vm, g, i, P, SS, ST): vm.bytes in fn_space(bits(64), bits(8)) -> g in bits(64) -> i in omega -> int_lt(i, 32) -> P in bits(64) ->
  mallocng_specs.eslot(vm, g, i) = SS -> int_add(mallocng_specs.rd64(vm, bits_add(64, g, 16)), mallocng.UNIT) = ST -> ST in omega ->
  int_le(16, SS) -> int_le(SS, P) -> int_mod(int_sub(P, SS), 16) = 0 -> int_lt(P, int_add(SS, 4096)) -> int_lt(P, 9223372036854775808) ->
  int_le(ST, P) -> int_lt(int_div(int_sub(P, ST), 16), 65536) ->
  (all x. x in omega -> int_lt(x, 18446744073709551616) -> (int_lt(x, int_sub(SS, 3)) || int_le(P, x)) ->
     mallocng_specs.enframe_hdr(vm, g, i, P).bytes[x] = vm.bytes[x]) &&
  mallocng_specs.enframe_hdr(vm, g, i, P).bytes[int_sub(P, 3)] = i &&
  gimple.bytes_at(mallocng_specs.enframe_hdr(vm, g, i, P), int_sub(P, 2), 2) = int_div(int_sub(P, ST), 16) &&
  (int_lt(SS, P) -> gimple.bytes_at(mallocng_specs.enframe_hdr(vm, g, i, P), int_sub(SS, 2), 2) = int_div(int_sub(P, SS), 16) &&
     mallocng_specs.enframe_hdr(vm, g, i, P).bytes[int_sub(SS, 3)] = 224 &&
     mallocng_specs.enframe_hdr(vm, g, i, P).bytes[int_sub(P, 4)] = 0) &&
  (all X. fn_update(mallocng_specs.enframe_hdr(vm, g, i, P), "bytes", X) = fn_update(vm, "bytes", X))
proof
  assume hb hg hi i32 hP esl est sto s16 hsp hal h4k p63 hst o16
  let E := mallocng_specs.eslot(vm, g, i)
  let Z := mallocng_specs.wr16(vm, bits_of_int(64, int_sub(E, 2)), int_div(int_sub(P, E), mallocng.UNIT))
  let Y := mallocng_specs.wr8(Z, bits_of_int(64, int_sub(E, 3)), int_mul(7, 32))
  let V1 := ite(int_lt(E, P), mallocng_specs.wr8(Y, bits_sub(64, P, 4), 0), vm)
  let WO := int_mod(int_div(int_sub(P, int_add(mallocng_specs.rd64(vm, bits_add(64, g, 16)), mallocng.UNIT)), mallocng.UNIT), int_pow(2, 16))
  let X1 := mallocng_specs.wr16(V1, bits_sub(64, P, 2), WO)
  let H := mallocng_specs.wr8(X1, bits_sub(64, P, 3), int_mod(i, 256))
  have eh: mallocng_specs.enframe_hdr(vm, g, i, P) = H by defs(simp(), mallocng_specs.enframe_hdr)
  have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
  have pb: int_le(0, P) && int_lt(P, 18446744073709551616) by simp(hP)
  // the addresses
  have p3: bits_sub(64, P, 3) = int_sub(P, 3) by defs(arith(pb, s16, hsp), bits_sub, pow2)
  have p2: bits_sub(64, P, 2) = int_sub(P, 2) by defs(arith(pb, s16, hsp), bits_sub, pow2)
  have p4: bits_sub(64, P, 4) = int_sub(P, 4) by defs(arith(pb, s16, hsp), bits_sub, pow2)
  have s2: bits_of_int(64, int_sub(E, 2)) = int_sub(SS, 2) by defs(arith(esl, s16, hsp, p63), bits_of_int, pow2)
  have s3: bits_of_int(64, int_sub(E, 3)) = int_sub(SS, 3) by defs(arith(esl, s16, hsp, p63), bits_of_int, pow2)
  have p3b: int_sub(P, 3) in bits(64) by simp(pb, s16, hsp)
  have p2b: int_sub(P, 2) in bits(64) by simp(pb, s16, hsp)
  have p4b: int_sub(P, 4) in bits(64) by simp(pb, s16, hsp)
  have s2b: int_sub(SS, 2) in bits(64) by simp(pb, s16, hsp)
  have s3b: int_sub(SS, 3) in bits(64) by simp(pb, s16, hsp)
  have zb := apply(mp.wr16_typed[V := vm, c := bits_of_int(64, int_sub(E, 2)), v := int_div(int_sub(P, E), mallocng.UNIT)], hb)
  have yb := apply(mp.wr8_typed[V := Z, c := bits_of_int(64, int_sub(E, 3)), v := int_mul(7, 32)], zb)
  have v1b: V1.bytes in fn_space(bits(64), bits(8)) by simp(hb, apply(mp.wr8_typed[V := Y, c := bits_sub(64, P, 4), v := 0], yb))
  have x1b := apply(mp.wr16_typed[V := V1, c := bits_sub(64, P, 2), v := WO], v1b)
  // the old bytes, outside [SS - 3, P)
  have h1: all x. x in omega -> int_lt(x, 18446744073709551616) -> (int_lt(x, int_sub(SS, 3)) || int_le(P, x)) ->
      H.bytes[x] = vm.bytes[x] proof
    fix x
    assume hx hxl ho
    have xb: x in bits(64) by simp(hx, hxl)
    have a1 := apply(mp.wr8_out[V := X1, c := bits_sub(64, P, 3), v := int_mod(i, 256), x := x], xb, rewrite(sym(p3), p3b), (int_le(int_add(bits_sub(64, P, 3), 1), x) || int_lt(x, bits_sub(64, P, 3)) by arith(p3, ho, hsp, s16, hx)))
    have a2 := apply(mp.wr16_out[V := V1, c := bits_sub(64, P, 2), v := WO, x := x], xb, rewrite(sym(p2), p2b), arith(p2, pb, hsp, s16), (int_le(int_add(bits_sub(64, P, 2), 2), x) || int_lt(x, bits_sub(64, P, 2)) by arith(p2, ho, hsp, s16, hx)))
    have c0: !int_lt(E, P) -> V1.bytes[x] = vm.bytes[x] by simp()
    have c1: int_lt(E, P) -> V1.bytes[x] = vm.bytes[x] proof
      assume k
      have v1e: V1 = mallocng_specs.wr8(Y, bits_sub(64, P, 4), 0) by simp(k)
      have pg: int_le(int_add(SS, 16), P) by arith(k, esl, hal, hsp)
      have b1 := apply(mp.wr8_out[V := Y, c := bits_sub(64, P, 4), v := 0, x := x], xb, rewrite(sym(p4), p4b), (int_le(int_add(bits_sub(64, P, 4), 1), x) || int_lt(x, bits_sub(64, P, 4)) by arith(p4, ho, pg, hx)))
      have b2 := apply(mp.wr8_out[V := Z, c := bits_of_int(64, int_sub(E, 3)), v := int_mul(7, 32), x := x], xb, rewrite(sym(s3), s3b), (int_le(int_add(bits_of_int(64, int_sub(E, 3)), 1), x) || int_lt(x, bits_of_int(64, int_sub(E, 3))) by arith(s3, ho, pg, hx)))
      have b3 := apply(mp.wr16_out[V := vm, c := bits_of_int(64, int_sub(E, 2)), v := int_div(int_sub(P, E), mallocng.UNIT), x := x], xb, rewrite(sym(s2), s2b), arith(s2, pg, pb), (int_le(int_add(bits_of_int(64, int_sub(E, 2)), 2), x) || int_lt(x, bits_of_int(64, int_sub(E, 2))) by arith(s2, ho, pg, hx)))
      show by simp(v1e, b1, b2, b3)
    qed
    show by simp(a1, a2, c0, c1)
  qed
  have ib: int_mod(int_mod(i, 256), 256) = i by arith(hi, i32)
  // p's index
  have hp3: H.bytes[int_sub(P, 3)] = i :=
    trans(subst({y. H.bytes[y] = int_mod(int_mod(i, 256), 256)}, p3, apply(mp.wr8_at[V := X1, c := bits_sub(64, P, 3), v := int_mod(i, 256)], rewrite(sym(p3), p3b), simp(hi))), ib)
  // p's offset from the storage
  have po: int_sub(P, 2) in omega by arith(pb, s16, hsp)
  have r1 := apply(mp.wr8_rd[V := X1, c := bits_sub(64, P, 3), v := int_mod(i, 256), a := int_sub(P, 2), n := 2], po, simp(), rewrite(sym(p3), p3b), arith(pb), arith(p3))
  have r2 := subst({y. gimple.bytes_at(X1, y, 2) = int_mod(WO, 65536)}, p2, apply(mp.rd_at2[vm := V1, c := bits_sub(64, P, 2), v := WO], v1b, rewrite(sym(p2), p2b), simp()))
  have wo: WO = int_div(int_sub(P, ST), 16) by defs(arith(est, cu, sto, hst, o16), pow2)
  have hp2: gimple.bytes_at(H, int_sub(P, 2), 2) = int_div(int_sub(P, ST), 16) := trans(r1, trans(r2, (int_mod(WO, 65536) = int_div(int_sub(P, ST), 16) by arith(wo, sto, hst, o16))))
  // past the slot's start: its offset record, its tag, p's check byte
  have hlo: int_lt(SS, P) -> gimple.bytes_at(H, int_sub(SS, 2), 2) = int_div(int_sub(P, SS), 16) &&
      H.bytes[int_sub(SS, 3)] = 224 && H.bytes[int_sub(P, 4)] = 0 proof
    assume k
    have ke: int_lt(E, P) := rewrite(sym(esl), k)
    have v1e: V1 = mallocng_specs.wr8(Y, bits_sub(64, P, 4), 0) by simp(ke)
    have pg: int_le(int_add(SS, 16), P) by arith(k, hal, hsp)
    have so: int_sub(SS, 2) in omega by arith(s16)
    have q1 := apply(mp.wr8_rd[V := X1, c := bits_sub(64, P, 3), v := int_mod(i, 256), a := int_sub(SS, 2), n := 2], so, simp(), rewrite(sym(p3), p3b), arith(pb, pg), arith(p3, pg))
    have q2 := apply(mp.wr16_rd[V := V1, c := bits_sub(64, P, 2), v := WO, a := int_sub(SS, 2), n := 2], so, simp(), rewrite(sym(p2), p2b), arith(pb, pg), arith(p2, pb, pg), arith(p2, pg))
    have q3 := apply(mp.wr8_rd[V := Y, c := bits_sub(64, P, 4), v := 0, a := int_sub(SS, 2), n := 2], so, simp(), rewrite(sym(p4), p4b), arith(pb, pg), arith(p4, pg))
    have q4 := apply(mp.wr8_rd[V := Z, c := bits_of_int(64, int_sub(E, 3)), v := int_mul(7, 32), a := int_sub(SS, 2), n := 2], so, simp(), rewrite(sym(s3), s3b), arith(pb, pg), arith(s3))
    have q5 := subst({y. gimple.bytes_at(Z, y, 2) = int_mod(int_div(int_sub(P, E), mallocng.UNIT), 65536)}, s2,
      apply(mp.rd_at2[vm := vm, c := bits_of_int(64, int_sub(E, 2)), v := int_div(int_sub(P, E), mallocng.UNIT)], hb, rewrite(sym(s2), s2b), arith(ke, esl, hsp, cu, pb, s16)))
    have qv: int_mod(int_div(int_sub(P, E), mallocng.UNIT), 65536) = int_div(int_sub(P, SS), 16) by arith(esl, cu, hsp, h4k)
    have rlo: gimple.bytes_at(H, int_sub(SS, 2), 2) = int_div(int_sub(P, SS), 16) := trans(q1, trans(q2, trans(rewrite(sym(v1e), q3), trans(q4, trans(q5, qv)))))
    have xs3: int_sub(SS, 3) in bits(64) := s3b
    have t1 := apply(mp.wr8_out[V := X1, c := bits_sub(64, P, 3), v := int_mod(i, 256), x := int_sub(SS, 3)], xs3, rewrite(sym(p3), p3b), arith(p3, pg))
    have t2 := apply(mp.wr16_out[V := V1, c := bits_sub(64, P, 2), v := WO, x := int_sub(SS, 3)], xs3, rewrite(sym(p2), p2b), arith(p2, pb, pg), arith(p2, pg))
    have t3 := apply(mp.wr8_out[V := Y, c := bits_sub(64, P, 4), v := 0, x := int_sub(SS, 3)], xs3, rewrite(sym(p4), p4b), arith(p4, pg))
    have t4 := subst({y. Y.bytes[y] = int_mod(int_mul(7, 32), 256)}, s3, apply(mp.wr8_at[V := Z, c := bits_of_int(64, int_sub(E, 3)), v := int_mul(7, 32)], rewrite(sym(s3), s3b), simp()))
    have rtg: H.bytes[int_sub(SS, 3)] = 224 := trans(t1, trans(t2, trans(rewrite(sym(v1e), t3), trans(t4, (int_mod(int_mul(7, 32), 256) = 224 by simp())))))
    have xp4: int_sub(P, 4) in bits(64) := p4b
    have u1 := apply(mp.wr8_out[V := X1, c := bits_sub(64, P, 3), v := int_mod(i, 256), x := int_sub(P, 4)], xp4, rewrite(sym(p3), p3b), arith(p3))
    have u2 := apply(mp.wr16_out[V := V1, c := bits_sub(64, P, 2), v := WO, x := int_sub(P, 4)], xp4, rewrite(sym(p2), p2b), arith(p2, pb, pg), arith(p2))
    have u3 := subst({y. mallocng_specs.wr8(Y, bits_sub(64, P, 4), 0).bytes[y] = int_mod(0, 256)}, p4, apply(mp.wr8_at[V := Y, c := bits_sub(64, P, 4), v := 0], rewrite(sym(p4), p4b), simp()))
    have rck: H.bytes[int_sub(P, 4)] = 0 := trans(u1, trans(u2, trans(rewrite(sym(v1e), u3), (int_mod(0, 256) = 0 by simp()))))
    show by taut(rlo, rtg, rck)
  qed
  // nothing but the bytes written
  have fx: all X. fn_update(H, "bytes", X) = fn_update(vm, "bytes", X) proof
    fix X
    have c0: !int_lt(E, P) -> fn_update(H, "bytes", X) = fn_update(vm, "bytes", X) by defs(simp(fn_update_twice), mallocng_specs.wr8, mallocng_specs.wr16)
    have c1: int_lt(E, P) -> fn_update(H, "bytes", X) = fn_update(vm, "bytes", X) by defs(simp(fn_update_twice), mallocng_specs.wr8, mallocng_specs.wr16)
    show by taut(c0, c1)
  qed
  show by simp(eh, h1, hp3, hp2, hlo, fx)
qed

// enframe's memory (`ms.ef_run`: set_size's, `size_set`, on the header
// writes): the slot framed (`framed`) -- the frame read back byte by byte,
// the slot's check and end bytes the invariant's 0, the class's bound the
// caller's
theorem mp.ef_frame(vm, W, v, g, i, n, P): vm in x86_64_linux.Vm -> vm.bytes in fn_space(bits(64), bits(8)) -> W in x86_64_linux.Vm ->
  g in bits(64) -> i in omega -> int_lt(i, 32) -> n in bits(64) -> P in bits(64) ->
  mallocng_specs.eslot(vm, g, i) = mallocng.slot_start(v, i) -> mallocng_specs.stride_w(vm, g) = mallocng.stride(v) ->
  mallocng_specs.rd64(vm, bits_add(64, g, 16)) = v.mem -> mallocng.stride(v) in omega -> v.mem in omega ->
  int_le(mallocng.slot_start(v, i), P) -> int_mod(int_sub(P, mallocng.slot_start(v, i)), 16) = 0 -> int_le(int_add(P, n), mallocng.slot_end(v, i)) ->
  int_lt(P, int_add(mallocng.slot_start(v, i), 4096)) -> int_lt(mallocng.slot_end(v, i), 9223372036854775808) ->
  int_lt(int_div(int_sub(P, mallocng.storage(v)), 16), 65536) ->
  (int_lt(v.sizeclass, 48) -> int_lt(int_sub(int_sub(mallocng.slot_end(v, i), n), mallocng.storage(v)), int_mul(int_mul(mallocng.UNIT, mallocng.size_classes[v.sizeclass]), int_add(i, 1))) ||
     int_le(int_add(int_sub(mallocng.slot_start(v, i), mallocng.storage(v)), int_mul(256, mallocng.UNIT)), int_mul(int_mul(mallocng.UNIT, mallocng.size_classes[v.sizeclass]), int_add(i, 1)))) ->
  vm.bytes[bits_of_int(64, int_sub(mallocng.slot_start(v, i), mallocng.IB))] = 0 ->
  vm.bytes[bits_of_int(64, mallocng.slot_end(v, i))] = 0 ->
  mallocng_specs.size_set(mallocng_specs.enframe_hdr(vm, g, i, P), W, P, mallocng_specs.eend(vm, g, i), n) ->
  mallocng_specs.framed(vm, W, v, i, P, n)
proof
  assume hvm hb hW hg hi i32 hn hP esl sw rdm sn vme hsp hal hpl h4k se63 o16 hcls chk0 end0 hss
  let SS := mallocng.slot_start(v, i)
  let SE := mallocng.slot_end(v, i)
  let ST := mallocng.storage(v)
  let H := mallocng_specs.enframe_hdr(vm, g, i, P)
  let M := mallocng.mview(W, mallocng.all_bytes)
  have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
  have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
  have pb: int_le(0, P) && int_lt(P, 18446744073709551616) by simp(hP)
  have nb: int_le(0, n) && int_lt(n, 18446744073709551616) by simp(hn)
  have m0: int_mul(mallocng.stride(v), i) in omega by simp(sn, hi)
  have ss: SS = int_add(int_add(v.mem, 16), int_mul(mallocng.stride(v), i)) by defs(arith(cu), mallocng.slot_start, mallocng.storage)
  have stv: ST = int_add(v.mem, 16) by defs(arith(cu), mallocng.storage)
  have se: SE = int_sub(int_add(SS, mallocng.stride(v)), 4) by defs(arith(ci), mallocng.slot_end)
  have s16: int_le(16, SS) by arith(ss, vme, m0)
  have sto: ST in omega by arith(stv, vme)
  have est: int_add(mallocng_specs.rd64(vm, bits_add(64, g, 16)), mallocng.UNIT) = ST by arith(rdm, stv, cu)
  have p63: int_lt(P, 9223372036854775808) by arith(hpl, se63, nb)
  have hst: int_le(ST, P) by arith(stv, ss, m0, hsp)
  have hh1 hp3 hp2 hlo fx := apply(mp.ef_hdr[vm := vm, g := g, i := i, P := P, SS := SS, ST := ST], hb, hg, hi, i32, hP, esl, est, sto, s16, hsp, hal, h4k, p63, hst, o16)
  // set_size's part: the slack recorded; the header byte's low bits, the
  // bytes outside the header byte and the slack: as it found them
  have eend: mallocng_specs.eend(vm, g, i) = SE by defs(arith(esl, sw, se, ci, se63, ss, vme, m0, sn), mallocng_specs.eend, bits_of_int, pow2)
  have hss2 := rewrite(eend, hss)
  have fu so hk un := expand(hss2, mallocng_specs.size_set)
  have bx: all x. x in omega -> int_lt(x, 18446744073709551616) -> bits_of_int(64, x) = x proof
    fix x
    assume hx hxl
    show by defs(arith(hx, hxl), bits_of_int, pow2)
  qed
  have wu: all x. x in omega -> int_lt(x, 18446744073709551616) -> !(x = int_sub(P, 3)) -> (int_lt(x, int_add(P, n)) || int_le(SE, x)) ->
      W.bytes[x] = H.bytes[x] proof
    fix x
    assume hx hxl hx3 hxs
    have u := mp(all_elim(un, {x}), hx, (((int_lt(x, int_pow(2, 64)) && !(x = int_sub(P, 3))) && !(int_le(int_add(P, n), x) && int_lt(x, SE))) by arith(hxl, hx3, hxs, hx)))
    show by simp(u, mp(all_elim(bx, {x}), hx, hxl))
  qed
  // reading the view of W
  have bW: all x. x in omega -> int_lt(x, 18446744073709551616) -> mallocng.b8(M, x) = W.bytes[x] proof
    fix x
    assume hx hxl
    have wb: W.bytes in fn_space(bits(64), bits(8)) by simp(hW)
    have r _ := apply(mp.b8_view[vm := W, fp := mallocng.all_bytes, a := x], wb, hx, (x in mallocng.all_bytes by defs(simp(hx), mallocng.all_bytes)))
    show by simp(r, mp(all_elim(bx, {x}), hx, hxl))
  qed
  have wb: W.bytes in fn_space(bits(64), bits(8)) by simp(hW)
  have pl2: int_lt(int_add(P, n), 18446744073709551616) by arith(hpl, se63)
  // p's check byte: written 0 past the slot's start, else the slot's own
  have f4: mallocng.b8(M, int_sub(P, 4)) = 0 proof
    have xo: int_sub(P, 4) in omega by arith(hsp, s16)
    have xl: int_lt(int_sub(P, 4), 18446744073709551616) by arith(pb)
    have w4 := mp(all_elim(wu, {int_sub(P, 4)}), xo, xl, (!(int_sub(P, 4) = int_sub(P, 3)) by arith()), (int_lt(int_sub(P, 4), int_add(P, n)) || int_le(SE, int_sub(P, 4)) by arith(nb)))
    have c1: int_lt(SS, P) -> H.bytes[int_sub(P, 4)] = 0 proof
      assume k
      have _ _ z := mp(hlo, k)
      show z
    qed
    have c2: !int_lt(SS, P) -> H.bytes[int_sub(P, 4)] = 0 proof
      assume k
      have pe: P = SS by arith(k, hsp, (P in omega by simp(hP)), ss, vme, m0)
      have h0 := mp(all_elim(hh1, {int_sub(P, 4)}), xo, xl, (int_lt(int_sub(P, 4), int_sub(SS, 3)) || int_le(P, int_sub(P, 4)) by arith(pe)))
      have c0: bits_of_int(64, int_sub(SS, mallocng.IB)) = int_sub(P, 4) by defs(arith(pe, ci, s16, pb), bits_of_int, pow2)
      show := trans(h0, rewrite(c0, chk0))
    qed
    show := trans(mp(all_elim(bW, {int_sub(P, 4)}), xo, xl), trans(w4, (H.bytes[int_sub(P, 4)] = 0 by taut(c1, c2))))
  qed
  // p's index: set_size keeps its low 5 bits
  have p3: bits_sub(64, P, 3) = int_sub(P, 3) by defs(arith(pb, s16, hsp), bits_sub, pow2)
  have p3o: int_sub(P, 3) in omega by arith(hsp, s16)
  have p3l: int_lt(int_sub(P, 3), 18446744073709551616) by arith(pb)
  have p3b: int_sub(P, 3) in bits(64) by simp(p3o, p3l)
  have wbo := mp(fn_space_app[a := bits(64), b := bits(8), f := W.bytes, x := int_sub(P, 3)], wb, p3b)
  have bw3: gimple.bytes_at(W, bits_sub(64, P, 3), 1) = W.bytes[int_sub(P, 3)] by defs(simp(p3, p3o, p3l, wbo), gimple.bytes_at)
  have bh3: gimple.bytes_at(H, bits_sub(64, P, 3), 1) = i by defs(simp(p3, p3o, p3l, hp3, hi), gimple.bytes_at)
  have im: int_mod(i, 32) = i by arith(hi, i32)
  have f5: int_mod(mallocng.b8(M, int_sub(P, 3)), 32) = i := trans(subst({y. int_mod(mallocng.b8(M, int_sub(P, 3)), 32) = int_mod(y, 32)}, mp(all_elim(bW, {int_sub(P, 3)}), p3o, p3l), refl({int_mod(mallocng.b8(M, int_sub(P, 3)), 32)})),
    trans(rewrite(bh3, rewrite(bw3, hk)), im))
  // the 2-byte reads, through set_size's untouched bytes
  have rdw: all a. a in omega -> int_le(int_add(a, 2), int_add(P, n)) -> !(a = int_sub(P, 3)) -> !(int_add(a, 1) = int_sub(P, 3)) ->
      mallocng.rd(M, a, 2) = gimple.bytes_at(H, a, 2) proof
    fix a
    assume ha hl h0 h1
    have inn: all j. j in omega -> int_lt(j, 2) -> int_add(a, j) in mallocng.all_bytes proof
      fix j
      assume hj _
      show by defs(simp(ha, hj), mallocng.all_bytes)
    qed
    have vr := apply(mp.view_read[vm := W, fp := mallocng.all_bytes, a := a, n := 2], ha, simp(), simp(), inn)
    have same: all j. j in omega -> int_lt(j, 2) -> W.bytes[int_add(a, j)] = H.bytes[int_add(a, j)] proof
      fix j
      assume hj hjl
      have aj: int_add(a, j) in omega by arith(ha, hj)
      have nj: !(int_add(a, j) = int_sub(P, 3)) proof
        have k: int_add(a, j) = int_sub(P, 3) -> false proof
          assume e
          have c: j = 0 || j = 1 by arith(hj, hjl)
          show by taut(c, (j = 0 -> false by arith(e, h0, ha, hj, pb)), (j = 1 -> false by arith(e, h1, ha, hj, pb)))
        qed
        show by taut(k)
      qed
      show := mp(all_elim(wu, {int_add(a, j)}), aj, arith(hl, pl2, hj, hjl), nj, (int_lt(int_add(a, j), int_add(P, n)) || int_le(SE, int_add(a, j)) by arith(hl, hjl, hj)))
    qed
    have sm := apply(mp.rd_same[v1 := W, v2 := H, a := a, n := 2], ha, simp(), arith(hl, pl2), same)
    show := trans(sym(vr), sm)
  qed
  // p's offset from the storage
  have p2o: int_sub(P, 2) in omega by arith(hsp, s16)
  have f6: mallocng.rd(M, int_sub(P, 2), 2) = int_div(int_sub(P, ST), mallocng.UNIT) :=
    trans(mp(all_elim(rdw, {int_sub(P, 2)}), p2o, arith(nb), arith(), arith()), trans(hp2, (int_div(int_sub(P, ST), 16) = int_div(int_sub(P, ST), mallocng.UNIT) by simp(cu))))
  // past the slot's start: its offset record, its tag
  have f7: int_lt(SS, P) -> mallocng.rd(M, int_sub(SS, 2), 2) = int_div(int_sub(P, SS), mallocng.UNIT) && mallocng.b8(M, int_sub(SS, 3)) = int_mul(7, 32) proof
    assume k
    have lo tg _ := mp(hlo, k)
    have pg: int_le(int_add(SS, 16), P) by arith(k, hal, hsp, (P in omega by simp(hP)), ss, vme, m0)
    have s2o: int_sub(SS, 2) in omega by arith(s16)
    have r1 := trans(mp(all_elim(rdw, {int_sub(SS, 2)}), s2o, arith(pg, nb), arith(pg), arith(pg)), trans(lo, (int_div(int_sub(P, SS), 16) = int_div(int_sub(P, SS), mallocng.UNIT) by simp(cu))))
    have s3o: int_sub(SS, 3) in omega by arith(s16)
    have s3l: int_lt(int_sub(SS, 3), 18446744073709551616) by arith(pg, pb)
    have w3 := mp(all_elim(wu, {int_sub(SS, 3)}), s3o, s3l, (!(int_sub(SS, 3) = int_sub(P, 3)) by arith(pg)), (int_lt(int_sub(SS, 3), int_add(P, n)) || int_le(SE, int_sub(SS, 3)) by arith(pg, nb)))
    have r2: mallocng.b8(M, int_sub(SS, 3)) = int_mul(7, 32) := trans(mp(all_elim(bW, {int_sub(SS, 3)}), s3o, s3l), trans(w3, trans(tg, (224 = int_mul(7, 32) by simp()))))
    show by taut(r1, r2)
  qed
  // the slack recorded; the slot's end byte, as it was: 0
  have seo: SE in omega by arith(se, ss, vme, m0, sn, hpl, nb)
  have sel: int_lt(SE, 18446744073709551616) by arith(se63)
  have we := mp(all_elim(wu, {SE}), seo, sel, (!(SE = int_sub(P, 3)) by arith(hpl, nb, seo, pb)), (int_lt(SE, int_add(P, n)) || int_le(SE, SE) by arith(seo)))
  have he := mp(all_elim(hh1, {SE}), seo, sel, (int_lt(SE, int_sub(SS, 3)) || int_le(P, SE) by arith(hpl, nb, seo, pb)))
  have f9b: mallocng.b8(M, SE) = 0 := trans(mp(all_elim(bW, {SE}), seo, sel), trans(we, trans(he, rewrite(mp(all_elim(bx, {SE}), seo, sel), end0))))
  // within the class's slot: by the caller's bound (the slack under the
  // class's slot, or the offset's 256 units)
  have f10: int_lt(v.sizeclass, 48) -> int_lt(int_sub(P, ST), int_mul(int_mul(mallocng.UNIT, mallocng.size_classes[v.sizeclass]), int_add(i, 1))) proof
    assume k
    have b := mp(hcls, k)
    have b1: int_lt(int_sub(int_sub(SE, n), ST), int_mul(int_mul(mallocng.UNIT, mallocng.size_classes[v.sizeclass]), int_add(i, 1))) ->
        int_lt(int_sub(P, ST), int_mul(int_mul(mallocng.UNIT, mallocng.size_classes[v.sizeclass]), int_add(i, 1))) proof
      assume b0
      show by arith(b0, hpl, nb)
    qed
    have b2: int_le(int_add(int_sub(SS, ST), int_mul(256, mallocng.UNIT)), int_mul(int_mul(mallocng.UNIT, mallocng.size_classes[v.sizeclass]), int_add(i, 1))) ->
        int_lt(int_sub(P, ST), int_mul(int_mul(mallocng.UNIT, mallocng.size_classes[v.sizeclass]), int_add(i, 1))) proof
      assume b0
      show by arith(b0, h4k, cu)
    qed
    show by taut(b, b1, b2)
  qed
  have six: !(0 = 6) by simp()
  have halu: int_mod(int_sub(P, SS), mallocng.UNIT) = 0 by simp(hal, cu)
  have fok: mallocng.frame_ok(M, v, i, P, n, 0) by defs(taut(hsp, halu, hpl, f4, f5, f6, f7, six, so, f9b, f10), mallocng.frame_ok)
  // only the bytes changed, of them only the slot interior's
  have vs := apply(fn_update_same[f := vm, k := "bytes"], simp(hvm), simp(hvm))
  have c1: fn_update(W, "bytes", vm.bytes) = vm := trans(sym(fn_update_twice[f := W, k := "bytes", a := H.bytes, b := vm.bytes]),
    trans(subst({y. fn_update(fn_update(W, "bytes", H.bytes), "bytes", vm.bytes) = fn_update(y, "bytes", vm.bytes)}, fu, refl({fn_update(fn_update(W, "bytes", H.bytes), "bytes", vm.bytes)})),
      trans(all_elim(fx, {vm.bytes}), vs)))
  have c3: all x. x in omega -> int_lt(x, int_pow(2, 64)) && !mallocng.in_slot(v, i, x) -> W.bytes[bits_of_int(64, x)] = vm.bytes[bits_of_int(64, x)] proof
    fix x
    assume hx hc
    have hl hn2 := hc
    have xl: int_lt(x, 18446744073709551616) by simp(hl)
    have hn3: !(int_lt(int_sub(SS, mallocng.IB), x) && int_lt(x, SE)) by defs(hn2, mallocng.in_slot)
    have out: int_le(x, int_sub(SS, 4)) || int_le(SE, x) by arith(hn3, hx, ci, seo, s16)
    have w := mp(all_elim(wu, {x}), hx, xl, (!(x = int_sub(P, 3)) by arith(out, hsp, hpl, nb, hx)), (int_lt(x, int_add(P, n)) || int_le(SE, x) by arith(out, hsp, nb, hx)))
    have h := mp(all_elim(hh1, {x}), hx, xl, (int_lt(x, int_sub(SS, 3)) || int_le(P, x) by arith(out, hpl, nb, hx)))
    show by simp(mp(all_elim(bx, {x}), hx, xl), trans(w, h))
  qed
  show by defs(taut(c1, fok, c3), mallocng_specs.framed)
qed

// ----------------------------------------------------------------------
//  enframe: its code refines its purpose
// enframe's contract, the ghost part h read: slot idx of g the one
// reserved, the code frames it for n bytes at some P and returns P -- its
// run its effect (`ms.ef_run`) under its callees' contracts (get_stride's
// `mp.gst_q`, set_size's `mp.ss_q`), the invariant read as its memory-level
// conditions (`mp.ef_pre`), the effect read as the frame (`mp.ef_frame`)
theorem mp.ef_run(c, g, idx, n, ctr, s, h, o, g0, g1, g2): c in mallocng.Cfg -> c.sct = c_src_malloc_mallocng_malloc.__malloc_size_classes ->
  g in bits(64) -> idx in bits(32) -> n in bits(64) -> ctr in bits(32) -> s in abi.World -> h in mp.G ->
  mallocng.holds_m(c, h.A, s.vm, h.blocks) -> mallocng.shown_in(c, h.A, s.objs) -> abi.thread_ok(s.vm, s.fs_base) ->
  mallocng.is_used(h.A, g) -> mallocng.reserved_only(h.A, g, idx) ->
  mallocng.slot_rw(s.vm, h.A.metas[g], idx) ->
  int_le(int_add(n, mallocng.IB), mallocng.stride(h.A.metas[g])) -> int_lt(mallocng.stride(h.A.metas[g]), int_pow(2, 31)) ->
  (int_lt(h.A.metas[g].sizeclass, 48) ->
     int_lt(int_sub(int_sub(mallocng.slot_end(h.A.metas[g], idx), n), mallocng.storage(h.A.metas[g])),
       int_mul(int_mul(mallocng.UNIT, mallocng.size_classes[h.A.metas[g].sizeclass]), int_add(idx, 1))) ||
     int_le(int_add(int_sub(mallocng.slot_start(h.A.metas[g], idx), mallocng.storage(h.A.metas[g])), int_mul(256, mallocng.UNIT)),
       int_mul(int_mul(mallocng.UNIT, mallocng.size_classes[h.A.metas[g].sizeclass]), int_add(idx, 1)))) ->
  (int_le(int_add(s.fs_base, 8), int_sub(mallocng.slot_start(h.A.metas[g], idx), mallocng.IB)) ||
     int_le(mallocng.slot_end(h.A.metas[g], idx), s.fs_base)) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(g0[regs], s, o) -> runs(c_src_malloc_mallocng_malloc.get_stride_fun()[regs], s, o)) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(g2[regs], s, o) -> runs(mallocng_specs.set_size_spec_fun()[regs], s, o)) ->
  runs(c_src_malloc_mallocng_malloc.enframe(g, idx, n, ctr, g0, g1, g2), s, o) ->
  abi.ovf_out(s, o) ||
  (ex P W. (((P in bits(64) && ((int_le(mallocng.slot_start(h.A.metas[g], idx), P) &&
        int_mod(int_sub(P, mallocng.slot_start(h.A.metas[g], idx)), mallocng.UNIT) = 0) &&
        int_lt(P, int_add(mallocng.slot_start(h.A.metas[g], idx), int_mul(256, mallocng.UNIT))))) &&
        int_le(int_add(P, n), mallocng.slot_end(h.A.metas[g], idx))) &&
      (W in x86_64_linux.Vm && mallocng_specs.framed(s.vm, W, h.A.metas[g], idx, P, n))) &&
    o = ok(fn_update(s, "vm", W), P))
proof
  assume hc hsct hg hi hn hctr hs hh hin hsh hth hus hro hrw hns hs31 hcls hfs hg0 hg2 hr
  let OVF := exc_val("stack_overflow", empty)
  let V0 := s.vm
  let A := h.A
  let V := A.metas[g]
  let SS := mallocng.slot_start(V, idx)
  let SE := mallocng.slot_end(V, idx)
  have hu hd hbt hat := mp(all_elim(mp.g_rec, {h}), hh)
  have au: A in univ(1) by simp(hu)
  have pv pf pd pb := apply(ms.world_parts, hs)
  have io: idx in omega by simp(hi)
  have epre sw esl rdm i32 ile chk0 end0 := apply(mp.ef_pre[c := c, A := A, vm := V0, b := h.blocks, objs := s.objs, fs := s.fs_base, g := g, i := idx, n := n],
    hc, hsct, au, hat, pb, hg, io, hn, hin, hsh, hth, hus, hro, hrw, hns, hs31, hfs)
  // the callees: get_stride the group's stride, set_size what it is for
  have hq0: all regs o2. gc.regs_ok(regs, seq_one(gimple.arg(64, g))) -> runs(c_src_malloc_mallocng_malloc.get_stride_fun()[regs], s, o2) ->
      abi.ovf_out(s, o2) ||
      (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && fst(r) = bits_of_int(64, mallocng_specs.stride_w(s.vm, g))) proof
    fix regs o2
    assume hro2 h2
    have q := apply(mp.gst_q[c := c, regs := regs, s := s, h := h, g := g, o2 := o2], hc, hsct, hg, hs, hh, hin, hsh, hus, hro2, h2)
    have k: (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && bits_of_int(64, fst(r)) = bits_of_int(64, mallocng.stride(V)) && fst(r) in bits(64)) ->
        (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && fst(r) = bits_of_int(64, mallocng_specs.stride_w(s.vm, g))) proof
      assume e
      obtain r, h1 h2 h3 from e
      have f: fst(r) = bits_of_int(64, mallocng_specs.stride_w(s.vm, g)) by simp(h2, h3, sw)
      show by ex_intro({r}, taut(h1, f))
    qed
    show by taut(q, k)
  qed
  have hq2: all t p e regs o2. t in abi.World -> p in bits(64) -> e in bits(64) -> mallocng_specs.set_size_pre(t.vm, t.objs, p, e, n) ->
      gc.regs_ok(regs, seq_concat(seq_concat(seq_one(gimple.arg(64, p)), seq_one(gimple.arg(64, e))), seq_one(gimple.arg(64, n)))) ->
      runs(mallocng_specs.set_size_spec_fun()[regs], t, o2) ->
      abi.ovf_out(t, o2) ||
      (ex V r. (V in x86_64_linux.Vm && mallocng_specs.size_set(t.vm, V, p, e, n)) && o2 = ok(fn_update(t, "vm", V), r)) proof
    fix t p e regs o2
    assume ht hp he hpre hro2 h2
    show := mp(all_elim(mp.ss_q, {t}, {p}, {e}, {n}, {regs}, {o2}), ht, hp, he, hn, hpre, hro2, h2)
  qed
  // the run: its effect
  have eff := apply(ms.ef_run[Q := x y p e m. mallocng_specs.size_set(x, y, p, e, m)], {g}, {idx}, {n}, {ctr}, {g0}, {g1}, {g2},
    {c_src_malloc_mallocng_malloc.get_stride_fun()}, {mallocng_specs.set_size_spec_fun()}, {s}, {o}, hg, hi, hn, hctr, hs, epre, hg0, hq0, hg2, hq2, hr)
  // the group's facts: its stride, its offsets within 16 bits
  have {H = inv} := expand(hin, mallocng.holds_m)
  have {uo = used} := expand(H, mallocng.holds)
  have gok := apply(mp.used_group, uo, hus)
  have {gl = nslots, offs} := expand(gok, mallocng.group_ok)
  have go: g in omega by simp(hg)
  have vt: V in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A.metas, x := g], simp(hat), go)
  have vo: V.mem in omega && V.last_idx in omega by simp(vt)
  have vme vli := vo
  have sn := apply(mp.stride_nat, hat, go, gok)
  have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
  have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
  have ss: SS = int_add(int_add(V.mem, 16), int_mul(mallocng.stride(V), idx)) by defs(arith(cu), mallocng.slot_start, mallocng.storage)
  have stv: mallocng.storage(V) = int_add(V.mem, 16) by defs(arith(cu), mallocng.storage)
  have se: SE = int_sub(int_add(SS, mallocng.stride(V)), 4) by defs(arith(ci), mallocng.slot_end)
  have m0: int_mul(mallocng.stride(V), idx) in omega by simp(sn, io)
  have _ _ _ _ _ _ c7 .. := expand(epre, mallocng_specs.enframe_pre)
  // the effect read as the frame
  have k: (ex P W. ((P in bits(64) && mallocng_specs.enframe_at(V0, g, idx, n, P) && int_lt(P, int_add(mallocng_specs.eslot(V0, g, idx), 4096))) &&
        (W in x86_64_linux.Vm && mallocng_specs.size_set(mallocng_specs.enframe_hdr(V0, g, idx, P), W, P, mallocng_specs.eend(V0, g, idx), n))) && o = ok(fn_update(s, "vm", W), P)) ->
      (ex P W. (((P in bits(64) && ((int_le(SS, P) && int_mod(int_sub(P, SS), mallocng.UNIT) = 0) && int_lt(P, int_add(SS, int_mul(256, mallocng.UNIT))))) && int_le(int_add(P, n), SE)) &&
        (W in x86_64_linux.Vm && mallocng_specs.framed(V0, W, V, idx, P, n))) && o = ok(fn_update(s, "vm", W), P)) proof
    assume e
    obtain P W, hpb hat2 hp4k hWv hss ho from e
    have a1 a2 a3 := expand(hat2, mallocng_specs.enframe_at)
    have po: P in omega by simp(hpb)
    have nb: n in omega by simp(hn)
    have hsp: int_le(SS, P) := rewrite(esl, a1)
    have halu: int_mod(int_sub(P, SS), mallocng.UNIT) = 0 := rewrite(esl, a2)
    have hal: int_mod(int_sub(P, SS), 16) = 0 by simp(halu, cu)
    have hpl: int_le(int_add(P, n), SE) by arith(a3, esl, sw, se, ci, ss, vme, m0, sn)
    have h4k: int_lt(P, int_add(SS, 4096)) := rewrite(esl, hp4k)
    have se63: int_lt(SE, 9223372036854775808) by arith(c7, esl, sw, se, ss, vme, m0, sn, (int_pow(2, 63) = 9223372036854775808 by simp()))
    // p's offset from the storage in units: within 16 bits
    have o16: int_lt(int_div(int_sub(P, mallocng.storage(V)), 16), 65536) proof
      have l0: int_lt(0, V.last_idx) -> int_lt(int_div(int_sub(P, mallocng.storage(V)), 16), 65536) proof
        assume k1
        have ob := mp(offs, k1)
        have mle := mp(all_elim(ms.mul_le, {mallocng.stride(V)}, {int_add(idx, 1)}, {mallocng.stride(V)}, {int_add(V.last_idx, 1)}), sn, simp(io), simp(sn), simp(vli), arith(sn), arith(ile))
        have d: int_mul(mallocng.stride(V), int_add(idx, 1)) = int_add(int_mul(mallocng.stride(V), idx), mallocng.stride(V)) by simp(sn, io)
        show by arith(ob, mle, d, hpl, se, ss, stv, cu, nb, po, vme, m0, sn, (int_pow(2, 16) = 65536 by simp()))
      qed
      have l1: !int_lt(0, V.last_idx) -> int_lt(int_div(int_sub(P, mallocng.storage(V)), 16), 65536) proof
        assume k1
        have i0: idx = 0 by arith(k1, ile, io, vli)
        have z: int_mul(mallocng.stride(V), idx) = 0 by simp(i0, sn)
        show by arith(z, h4k, ss, stv, po, vme)
      qed
      show by taut(l0, l1)
    qed
    have fr := apply(mp.ef_frame[vm := V0, W := W, v := V, g := g, i := idx, n := n, P := P], pv, pb, hWv, hg, io, i32, hn, hpb, esl, sw, rdm, sn, vme,
      hsp, hal, hpl, h4k, se63, o16, hcls, chk0, end0, hss)
    show by ex_intro({P}, {W}, taut(hpb, hsp, halu, (int_lt(P, int_add(SS, int_mul(256, mallocng.UNIT))) by arith(h4k, cu)), hpl, hWv, fr, ho))
  qed
  show by taut(eff, k)
qed

// enframe's code by its purpose: its contract, the ghost part kept
theorem mp.ef: all c g idx n ctr g0 g1 g2. c in mallocng.Cfg -> c.sct = c_src_malloc_mallocng_malloc.__malloc_size_classes ->
  g in bits(64) -> idx in bits(32) -> n in bits(64) -> ctr in bits(32) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(g0[regs], s, o) -> runs(c_src_malloc_mallocng_malloc.get_stride_fun()[regs], s, o)) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(g2[regs], s, o) -> runs(mallocng_specs.set_size_spec_fun()[regs], s, o)) ->
  refines_ghost(c_src_malloc_mallocng_malloc.enframe(g, idx, n, ctr, g0, g1, g2), mallocng_specs.enframe_spec(c, g, idx, n), abi.World, mp.G)
proof
  fix c g idx n ctr g0 g1 g2
  assume hc hsct hg hi hn hctr hg0 hg2
  have rp: all s o. runs(c_src_malloc_mallocng_malloc.enframe(g, idx, n, ctr, g0, g1, g2), s, o) -> pair(s, o) in univ(1) proof
    fix s o
    assume hr
    show := apply(g.runs_univ, expand(hr, c_src_malloc_mallocng_malloc.enframe))
  qed
  have body: all s h o. s in abi.World -> h in mp.G -> runs(c_src_malloc_mallocng_malloc.enframe(g, idx, n, ctr, g0, g1, g2), s, o) ->
      ((((((((mallocng.holds_in(c, union2(s, h).A, union2(s, h).vm, union2(s, h).objs, union2(s, h).blocks) && abi.thread_ok(union2(s, h).vm, union2(s, h).fs_base)) &&
        mallocng.is_used(union2(s, h).A, g)) && mallocng.reserved_only(union2(s, h).A, g, idx)) &&
        mallocng.slot_rw(union2(s, h).vm, union2(s, h).A.metas[g], idx)) &&
        int_le(int_add(n, mallocng.IB), mallocng.stride(union2(s, h).A.metas[g]))) &&
        int_lt(mallocng.stride(union2(s, h).A.metas[g]), int_pow(2, 31))) &&
        (int_lt(union2(s, h).A.metas[g].sizeclass, 48) ->
           int_lt(int_sub(int_sub(mallocng.slot_end(union2(s, h).A.metas[g], idx), n), mallocng.storage(union2(s, h).A.metas[g])),
             int_mul(int_mul(mallocng.UNIT, mallocng.size_classes[union2(s, h).A.metas[g].sizeclass]), int_add(idx, 1))) ||
           int_le(int_add(int_sub(mallocng.slot_start(union2(s, h).A.metas[g], idx), mallocng.storage(union2(s, h).A.metas[g])), int_mul(256, mallocng.UNIT)),
             int_mul(int_mul(mallocng.UNIT, mallocng.size_classes[union2(s, h).A.metas[g].sizeclass]), int_add(idx, 1))))) &&
        (int_le(int_add(union2(s, h).fs_base, 8), int_sub(mallocng.slot_start(union2(s, h).A.metas[g], idx), mallocng.IB)) ||
           int_le(mallocng.slot_end(union2(s, h).A.metas[g], idx), union2(s, h).fs_base))) ->
      abi.ovf_out(s, o) ||
      (ex s1 v. o = ok(s1, v) &&
        letin(union2(s, h).vm, x3. any_rel(x4. x4 in bits(64) &&
          (((int_le(mallocng.slot_start(union2(s, h).A.metas[g], idx), x4) &&
             int_mod(int_sub(x4, mallocng.slot_start(union2(s, h).A.metas[g], idx)), mallocng.UNIT) = 0) &&
             int_lt(x4, int_add(mallocng.slot_start(union2(s, h).A.metas[g], idx), int_mul(256, mallocng.UNIT)))) &&
             int_le(int_add(x4, n), mallocng.slot_end(union2(s, h).A.metas[g], idx))),
          x4. letin(x4, x5. any_rel(x6. x6 in x86_64_linux.Vm &&
            mallocng_specs.framed(x3, fn_update(union2(s, h), "vm", x6).vm, fn_update(union2(s, h), "vm", x6).A.metas[g], idx, x5, n),
          x6. letin(fn_update(union2(s, h), "vm", x6), x7. exc(pair(union2(s1, h), empty), pair("ret", v)) = exc(pair(x7, empty), pair("ret", x5)))))))) proof
    fix s h o
    assume hs hh hr hpre
    let U := union2(s, h)
    have _ hd _ _ := mp(all_elim(mp.g_rec, {h}), hh)
    have _ hk := mp(all_elim(mp.g_world, {h}), hh)
    have sd: dom(s) = insert("vm", insert("os", insert("fs_base", insert("cpu", insert("objs", empty))))) by simp(expand(hs, abi.World))
    let V := h.A.metas[g]
    have hin0: mallocng.holds_in(c, h.A, s.vm, s.objs, h.blocks) by simp(hpre, sd, hd)
    have {hin = mem, hsh = shown} := hin0
    have hth: abi.thread_ok(s.vm, s.fs_base) by simp(hpre, sd, hd)
    have hus: mallocng.is_used(h.A, g) by simp(hpre, sd, hd)
    have hro: mallocng.reserved_only(h.A, g, idx) by simp(hpre, sd, hd)
    have hrw: mallocng.slot_rw(s.vm, V, idx) by simp(hpre, sd, hd)
    have hns: int_le(int_add(n, mallocng.IB), mallocng.stride(V)) by simp(hpre, sd, hd)
    have hs31: int_lt(mallocng.stride(V), int_pow(2, 31)) by simp(hpre, sd, hd)
    have hcls: int_lt(V.sizeclass, 48) -> int_lt(int_sub(int_sub(mallocng.slot_end(V, idx), n), mallocng.storage(V)), int_mul(int_mul(mallocng.UNIT, mallocng.size_classes[V.sizeclass]), int_add(idx, 1))) ||
        int_le(int_add(int_sub(mallocng.slot_start(V, idx), mallocng.storage(V)), int_mul(256, mallocng.UNIT)), int_mul(int_mul(mallocng.UNIT, mallocng.size_classes[V.sizeclass]), int_add(idx, 1)))
      by simp(hpre, sd, hd)
    have hfs: int_le(int_add(s.fs_base, 8), int_sub(mallocng.slot_start(V, idx), mallocng.IB)) || int_le(mallocng.slot_end(V, idx), s.fs_base) by simp(hpre, sd, hd)
    have oc := apply(mp.ef_run[c := c, g := g, idx := idx, n := n, ctr := ctr, s := s, h := h, o := o, g0 := g0, g1 := g1, g2 := g2],
      hc, hsct, hg, hi, hn, hctr, hs, hh, hin, hsh, hth, hus, hro, hrw, hns, hs31, hcls, hfs, hg0, hg2, hr)
    have lv: all z. z in h -> fst(z) != "vm" proof
      fix z
      assume hz
      show by simp(mp(all_elim(hk, {z}), hz))
    qed
    have k: (ex P W. (((P in bits(64) && ((int_le(mallocng.slot_start(V, idx), P) && int_mod(int_sub(P, mallocng.slot_start(V, idx)), mallocng.UNIT) = 0) &&
          int_lt(P, int_add(mallocng.slot_start(V, idx), int_mul(256, mallocng.UNIT))))) && int_le(int_add(P, n), mallocng.slot_end(V, idx))) &&
          (W in x86_64_linux.Vm && mallocng_specs.framed(s.vm, W, V, idx, P, n))) && o = ok(fn_update(s, "vm", W), P)) ->
        (ex s1 v. o = ok(s1, v) &&
          letin(U.vm, x3. any_rel(x4. x4 in bits(64) &&
            (((int_le(mallocng.slot_start(U.A.metas[g], idx), x4) &&
               int_mod(int_sub(x4, mallocng.slot_start(U.A.metas[g], idx)), mallocng.UNIT) = 0) &&
               int_lt(x4, int_add(mallocng.slot_start(U.A.metas[g], idx), int_mul(256, mallocng.UNIT)))) &&
               int_le(int_add(x4, n), mallocng.slot_end(U.A.metas[g], idx))),
            x4. letin(x4, x5. any_rel(x6. x6 in x86_64_linux.Vm &&
              mallocng_specs.framed(x3, fn_update(U, "vm", x6).vm, fn_update(U, "vm", x6).A.metas[g], idx, x5, n),
            x6. letin(fn_update(U, "vm", x6), x7. exc(pair(union2(s1, h), empty), pair("ret", v)) = exc(pair(x7, empty), pair("ret", x5)))))))) proof
      assume e
      obtain P W, hpb hsp hal h4k hpl hWv hfr ho from e
      let S1 := fn_update(s, "vm", W)
      have eu := mp(fn_update_union_l[a := s, b := h, k := "vm", v := W], lv)
      have fr2: mallocng_specs.framed(U.vm, fn_update(U, "vm", W).vm, fn_update(U, "vm", W).A.metas[g], idx, P, n) by simp(hfr, sd, hd)
      have xq: exc(pair(union2(S1, h), empty), pair("ret", P)) = exc(pair(fn_update(U, "vm", W), empty), pair("ret", P)) by simp(eu)
      have e6: ex x6. (x6 in x86_64_linux.Vm &&
          mallocng_specs.framed(U.vm, fn_update(U, "vm", x6).vm, fn_update(U, "vm", x6).A.metas[g], idx, P, n)) &&
          exc(pair(union2(S1, h), empty), pair("ret", P)) = exc(pair(fn_update(U, "vm", x6), empty), pair("ret", P))
        by ex_intro({W}, taut(hWv, fr2, xq))
      have g4: (((int_le(mallocng.slot_start(U.A.metas[g], idx), P) &&
          int_mod(int_sub(P, mallocng.slot_start(U.A.metas[g], idx)), mallocng.UNIT) = 0) &&
          int_lt(P, int_add(mallocng.slot_start(U.A.metas[g], idx), int_mul(256, mallocng.UNIT)))) &&
          int_le(int_add(P, n), mallocng.slot_end(U.A.metas[g], idx))) by simp(hsp, hal, h4k, hpl, sd, hd)
      have e4: ex x4. (x4 in bits(64) && (((int_le(mallocng.slot_start(U.A.metas[g], idx), x4) &&
          int_mod(int_sub(x4, mallocng.slot_start(U.A.metas[g], idx)), mallocng.UNIT) = 0) &&
          int_lt(x4, int_add(mallocng.slot_start(U.A.metas[g], idx), int_mul(256, mallocng.UNIT)))) &&
          int_le(int_add(x4, n), mallocng.slot_end(U.A.metas[g], idx)))) &&
          (!(ex x6. x6 in x86_64_linux.Vm &&
              mallocng_specs.framed(U.vm, fn_update(U, "vm", x6).vm, fn_update(U, "vm", x6).A.metas[g], idx, x4, n)) ||
           (ex x6. (x6 in x86_64_linux.Vm &&
              mallocng_specs.framed(U.vm, fn_update(U, "vm", x6).vm, fn_update(U, "vm", x6).A.metas[g], idx, x4, n)) &&
              exc(pair(union2(S1, h), empty), pair("ret", P)) = exc(pair(fn_update(U, "vm", x6), empty), pair("ret", x4))))
        by ex_intro({P}, taut(hpb, g4, e6))
      have bB: letin(U.vm, x3. any_rel(x4. x4 in bits(64) &&
            (((int_le(mallocng.slot_start(U.A.metas[g], idx), x4) &&
               int_mod(int_sub(x4, mallocng.slot_start(U.A.metas[g], idx)), mallocng.UNIT) = 0) &&
               int_lt(x4, int_add(mallocng.slot_start(U.A.metas[g], idx), int_mul(256, mallocng.UNIT)))) &&
               int_le(int_add(x4, n), mallocng.slot_end(U.A.metas[g], idx))),
            x4. letin(x4, x5. any_rel(x6. x6 in x86_64_linux.Vm &&
              mallocng_specs.framed(x3, fn_update(U, "vm", x6).vm, fn_update(U, "vm", x6).A.metas[g], idx, x5, n),
            x6. letin(fn_update(U, "vm", x6), x7. exc(pair(union2(S1, h), empty), pair("ret", P)) = exc(pair(x7, empty), pair("ret", x5)))))))
        by defs(taut(e4), letin, any_rel)
      show by ex_intro({S1}, {P}, taut(ho, bB))
    qed
    show by taut(oc, k)
  qed
  show by defs(apply(ct.refines_contract, mp.g_world, rp, body), mallocng_specs.enframe_spec)
qed

// (its C function value, divergence, machine code: by `contract enframe`,
// proofs/mallocng/fun/alloc_group.core, after its contract at a call)
