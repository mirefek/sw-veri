theorem mp.acas_divw: tr.div_raises(mallocng_specs.a_cas_spec_fun())
proof
  let Q(regs) := mallocng_specs.a_cas_spec(bits_of_int(64, regs[0]), bits_of_int(32, regs[1]), bits_of_int(32, regs[2]))
  have qu: all regs s o. runs(Q(regs), s, o) -> pair(s, o) in univ(1) proof
    fix regs s o
    assume hr
    show := apply(g.runs_univ, expand(hr, mallocng_specs.a_cas_spec))
  qed
  have qd: all regs w h t. regs in abi.ARGS -> w in abi.World -> w in univ(1) -> h in single(empty) ->
      runs(Q(regs), union2(w, h), diverge(t)) -> runs(Q(regs), union2(w, h), exc(union2(w, h), empty)) proof
    fix regs w h t
    assume _ hw hwu hh hr
    have {su = univ, sv = vm} := apply(ct.w_single, hw, hwu, hh)
    have r2 := apply(ct.contract_div, su, sv, expand(hr, mallocng_specs.a_cas_spec), defs(ct.dv_exc_a, letin))
    show by defs(r2, mallocng_specs.a_cas_spec)
  qed
  have dg := apply(ct.fun_divg[G := single(empty), q := x0. Q(x0), n := 3, w := 32], ct.single_univ, qu, qd)
  show := apply(ct.div_of_g, (tr.div_raises_g(single(empty), mallocng_specs.a_cas_spec_fun()) by defs(dg, mallocng_specs.a_cas_spec_fun)))
qed

theorem mp.ugl_divw: tr.div_raises(mallocng_specs.upgradelock_spec_fun())
proof
  have qd: all w h t. w in abi.World -> w in univ(1) -> h in single(empty) ->
      runs(mallocng_specs.upgradelock_spec, union2(w, h), diverge(t)) -> runs(mallocng_specs.upgradelock_spec, union2(w, h), exc(union2(w, h), empty)) proof
    fix w h t
    assume hw hwu hh hr
    have {su = univ, sv = vm} := apply(ct.w_single, hw, hwu, hh)
    have r2 := apply(ct.contract_div0, su, sv, expand(hr, mallocng_specs.upgradelock_spec), defs(ct.dv_ok_a, letin))
    show by defs(r2, mallocng_specs.upgradelock_spec)
  qed
  have dg := apply(ct.fun_divg_v0[G := single(empty), q := mallocng_specs.upgradelock_spec], ct.single_univ, qd)
  show := apply(ct.div_of_g, (tr.div_raises_g(single(empty), mallocng_specs.upgradelock_spec_fun()) by defs(dg, mallocng_specs.upgradelock_spec_fun)))
qed

