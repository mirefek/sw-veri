// The leaf specs (the atomics, the bit counts, the lock's) at the ABI
// level: they diverge nowhere they do not raise (`ct.div_of_g`), so their
// machine code (proofs/mallocng/machine/cfg.core) implements them there.

theorem mp.actz_divw: all tbl. tr.div_raises(mallocng_specs.a_ctz_32_spec_fun(tbl))
proof
  fix tbl
  let Q(regs) := mallocng_specs.a_ctz_32_spec(tbl, bits_of_int(32, regs[0]))
  have qu: all regs s o. runs(Q(regs), s, o) -> pair(s, o) in univ(1) proof
    fix regs s o
    assume hr
    show := apply(g.runs_univ, expand(hr, mallocng_specs.a_ctz_32_spec))
  qed
  have qd: all regs w h t. regs in abi.ARGS -> w in abi.World -> w in univ(1) -> h in single(empty) ->
      runs(Q(regs), union2(w, h), diverge(t)) -> runs(Q(regs), union2(w, h), exc(union2(w, h), empty)) proof
    fix regs w h t
    assume _ hw hwu hh hr
    have {su = univ, sv = vm} := apply(ct.w_single, hw, hwu, hh)
    have r2 := apply(ct.contract_div, su, sv, expand(hr, mallocng_specs.a_ctz_32_spec), defs(ct.dv_exc_a, letin))
    show by defs(r2, mallocng_specs.a_ctz_32_spec)
  qed
  have dg := apply(ct.fun_divg[G := single(empty), q := x0. Q(x0), n := 1, w := 32], ct.single_univ, qu, qd)
  show := apply(ct.div_of_g, (tr.div_raises_g(single(empty), mallocng_specs.a_ctz_32_spec_fun(tbl)) by defs(dg, mallocng_specs.a_ctz_32_spec_fun)))
qed

