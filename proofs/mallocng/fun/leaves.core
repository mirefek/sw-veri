theorem mp.rsl_abi: all statics. abi.implements2_at(single(empty), 4206146, mallocng_specs.resetlock_spec_fun(c_src_malloc_mallocng_malloc.__malloc_lock), 4198400, text.code, statics)
proof
  fix statics
  show := apply(tr.implements_abi, all_elim(mp.rsl_divw, {c_src_malloc_mallocng_malloc.__malloc_lock}), all_elim(rltc.composed, {statics}))
qed

theorem mp.acr_abi: all statics. abi.implements2_at(single(empty), 4205678, mallocng_specs.a_crash_spec_fun(), 4198400, text.code, statics)
proof
  fix statics
  show := apply(tr.implements_abi, acr.div_raises, all_elim(acr.implements, {statics}))
qed
