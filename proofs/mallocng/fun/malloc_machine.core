// __libc_malloc_impl at machine level: its callees' machine code linked
// (as alloc_slot's and alloc_group's, proofs/mallocng/fun/alloc_pair.core),
// its contract (the ghost part the live blocks and the allocator's abstract
// state) from the configuration alone

// the allocator's configuration, its lock too
abbrev mp.mi_cfg(c) := mp.ap_cfg(c) && c.lock = c_src_malloc_mallocng_malloc.__malloc_lock

// the never reached __lock (need_locks 0): any code, as a_crash's spec
abbrev mp.LK := c_src_malloc_mallocng_malloc_cfg.rdlock_fun(mallocng_specs.a_crash_spec_fun())
abbrev mp.WLK := c_src_malloc_mallocng_malloc_cfg.wrlock_fun(mallocng_specs.a_crash_spec_fun())
abbrev mp.ULK := c_src_malloc_mallocng_malloc_cfg.unlock_fun(mp.UL)
abbrev mp.SO := c_src_malloc_mallocng_malloc_cfg.size_overflows_fun(mp.EL)

// (the callees with no ghost part: linked, typed, their io, called as their
// specs)
theorem mp.mi_rdl: all statics. tr.implements_at(4206047, mp.LK, 4198400, text.code, statics) && mp.LK in fn_space(abi.ARGS, powerset(univ(1))) &&
  tr.callee_io(mp.LK, 0) && mp.calls(mp.LK, mallocng_specs.lock_spec_fun(c_src_malloc_mallocng_malloc.__libc))
proof
  fix statics
  let AC := mallocng_specs.a_crash_spec_fun()
  have i := mp(all_elim(rdlc.implements, {statics}, {AC}), all_elim(mp.undef_implements, {4214680}, {statics}), acr.typed, mp.undef_io[n := 1])
  have io := mp(all_elim(rdlc.io, {AC}), mp.undef_io[n := 1])
  have cl: mp.calls(mp.LK, mallocng_specs.lock_spec_fun(c_src_malloc_mallocng_malloc.__libc)) proof
    fix regs s o
    assume h1 h2 h3 hr
    have r1 := mp(all_elim(rdlock_ref, {AC}, {regs}, {s}, {o}), h1, h2, h3, hr)
    show := mp(all_elim(mp.rdl_fun, {AC}, {regs}, {s}, {o}), h1, h2, h3, r1)
  qed
  show by taut(i, all_elim(rdlc.typed, {AC}), io, cl)
qed

theorem mp.mi_wrl: all statics. tr.implements_at(4206083, mp.WLK, 4198400, text.code, statics) && mp.WLK in fn_space(abi.ARGS, powerset(univ(1))) &&
  tr.callee_io(mp.WLK, 0) && mp.calls(mp.WLK, mallocng_specs.lock_spec_fun(c_src_malloc_mallocng_malloc.__libc))
proof
  fix statics
  let AC := mallocng_specs.a_crash_spec_fun()
  have i := mp(all_elim(wrlc.implements, {statics}, {AC}), all_elim(mp.undef_implements, {4214680}, {statics}), acr.typed, mp.undef_io[n := 1])
  have io := mp(all_elim(wrlc.io, {AC}), mp.undef_io[n := 1])
  have cl: mp.calls(mp.WLK, mallocng_specs.lock_spec_fun(c_src_malloc_mallocng_malloc.__libc)) proof
    fix regs s o
    assume h1 h2 h3 hr
    have r1 := mp(all_elim(wrlock_ref, {AC}, {regs}, {s}, {o}), h1, h2, h3, hr)
    show := mp(all_elim(mp.wrl_fun, {AC}, {regs}, {s}, {o}), h1, h2, h3, r1)
  qed
  show by taut(i, all_elim(wrlc.typed, {AC}), io, cl)
qed

theorem mp.mi_unl: all statics. tr.implements_at(4206119, mp.ULK, 4198400, text.code, statics) && mp.ULK in fn_space(abi.ARGS, powerset(univ(1))) &&
  tr.callee_io(mp.ULK, 0) && mp.calls(mp.ULK, mallocng_specs.unlock_spec_fun(c_src_malloc_mallocng_malloc.__malloc_lock))
proof
  fix statics
  let AC := mallocng_specs.a_crash_spec_fun()
  have iu := mp(all_elim(ulkc.implements, {statics}, {AC}, {AC}), all_elim(mp.undef_implements, {4214403}, {statics}), acr.typed, mp.undef_io[n := 2],
    all_elim(mp.undef_implements, {4214434}, {statics}), acr.typed, mp.undef_io[n := 3])
  have iou := mp(all_elim(ulkc.io, {AC}, {AC}), mp.undef_io[n := 2], mp.undef_io[n := 3])
  have i := mp(all_elim(unlc.implements, {statics}, {mp.UL}), iu, all_elim(ulkc.typed, {AC}, {AC}), iou)
  have io := mp(all_elim(unlc.io, {mp.UL}), iou)
  have cl: mp.calls(mp.ULK, mallocng_specs.unlock_spec_fun(c_src_malloc_mallocng_malloc.__malloc_lock)) proof
    fix regs s o
    assume h1 h2 h3 hr
    have r1 := mp(all_elim(unlock_ref, {mp.UL}, {regs}, {s}, {o}), h1, h2, h3, hr)
    show := mp(all_elim(mp.unl_fun, {mp.UL}, {regs}, {s}, {o}), mp.ulk_calls_linked, h1, h2, h3, r1)
  qed
  show by taut(i, all_elim(unlc.typed, {mp.UL}), io, cl)
qed

theorem mp.mi_mun: all statics. tr.implements_at(4213949, mp.MUN, 4198400, text.code, statics) && mp.MUN in fn_space(abi.ARGS, powerset(univ(1))) &&
  tr.callee_io(mp.MUN, 2) && mp.calls(mp.MUN, mallocng_specs.munmap_spec_fun())
proof
  fix statics
  let VW := c_src_mman_mmap_cfg.dummy_fun()
  let SY2 := c_src_mman_munmap_cfg.__syscall2_fun()
  have i := mp(all_elim(mnmc.implements, {statics}, {VW}, {SY2}, {mp.MSR}), all_elim(vwc.implements, {statics}), vwc.typed, vwc.io,
    all_elim(sy2c.implements, {statics}), sy2c.typed, sy2c.io, all_elim(srtc.linked, {statics}), srtc.typed_linked, srtc.io_linked)
  have io := mp(all_elim(mnmc.io, {VW}, {SY2}, {mp.MSR}), vwc.io, sy2c.io, srtc.io_linked)
  show by taut(i, all_elim(mnmc.typed, {VW}, {SY2}, {mp.MSR}), io, mp.mun_calls_linked)
qed

theorem mp.mi_so: all statics. tr.implements_at(4208340, mp.SO, 4198400, text.code, statics) && mp.SO in fn_space(abi.ARGS, powerset(univ(1))) &&
  tr.callee_io(mp.SO, 1) && mp.calls(mp.SO, mallocng_specs.size_overflows_spec_fun)
proof
  fix statics
  have i := mp(all_elim(sotc.implements, {statics}, {mp.EL}), all_elim(elc.linked, {statics}), elc.typed_linked, elc.io_linked)
  have io := mp(all_elim(sotc.io, {mp.EL}), elc.io_linked)
  have cl: mp.calls(mp.SO, mallocng_specs.size_overflows_spec_fun) proof
    fix regs s o
    assume h1 h2 h3 hr
    have c2 := mp(all_elim(ms.size_overflows_fun_c2, {mp.EL}), cc.errno_location)
    show := mp(all_elim(c2, {regs}, {s}, {o}), h1, h2, h3, mp(all_elim(size_overflows_ref, {mp.EL}, {regs}, {s}, {o}), h1, h2, h3, hr))
  qed
  show by taut(i, all_elim(sotc.typed, {mp.EL}), io, cl)
qed

theorem mp.mi_ug: mp.calls(c_src_malloc_mallocng_malloc_cfg.upgradelock_fun(), mallocng_specs.upgradelock_spec_fun())
proof
  fix regs s o
  assume h1 h2 h3 hr
  show := mp(all_elim(ms.upgradelock_fun_c2, {regs}, {s}, {o}), h1, h2, h3, mp(all_elim(upgradelock_ref, {regs}, {s}, {o}), h1, h2, h3, hr))
qed

// ---------------------------------------------------------------------
// malloc over alloc_meta's leaves (as alloc_slot's and alloc_group's)

theorem mp.mi_over_leaves: all c statics G1 G3 G4 G5 G6. mp.mi_cfg(c) -> mp.ap_leaves(c, statics, G1, G3, G4, G5, G6) ->
  abi.implements2_at(mp.G, 4212278, mallocng_specs.malloc_impl_spec_fun(c), 4198400, text.code, statics)
proof
  fix c statics G1 G3 G4 G5 G6
  assume hmc hl
  have hcf: mp.ap_cfg(c) by taut(hmc)
  have hlk: c.lock = c_src_malloc_mallocng_malloc.__malloc_lock by taut(hmc)
  have hc hx hst hdj _ _ hlc := hcf
  // alloc_slot known from class 0 on: called as alloc_slot everywhere
  obtain gs, hk0 from mp(all_elim(mp.ap_all, {c}, {statics}, {G1}, {G3}, {G4}, {G5}, {G6}), hcf, hl, {48}, simp(), arith())
  have e0: int_sub(48, 48) = 0 by arith()
  have ias tas oas qas := rewrite(e0, hk0)
  have asc := apply(mp.as_call_of_ge0[c := c, f := gs], qas)
  let AM := mp.ap_am(G1, G3, G4, G5, G6)
  let SQ := c_src_malloc_mallocng_malloc_cfg.step_seq_fun()
  let AC := c_src_malloc_mallocng_malloc_cfg.a_ctz_32_fun()
  let UG := c_src_malloc_mallocng_malloc_cfg.upgradelock_fun()
  have iso tso oso qso := all_elim(mp.mi_so, {statics})
  have imm tmm omm qmm := all_elim(mp.ap_mm, {statics})
  have iwl twl owl qwl := all_elim(mp.mi_wrl, {statics})
  have iam tam oam qam := mp(all_elim(mp.ap_am_ok, {c}, {statics}, {G1}, {G3}, {G4}, {G5}, {G6}), hc, hx, hl)
  have iul tul oul qul := all_elim(mp.mi_unl, {statics})
  have imu tmu omu qmu := all_elim(mp.mi_mun, {statics})
  have is2 ts2 os2 qs2 := mp(all_elim(mp.ap_s2c_ok, {c}, {statics}), hst, hdj)
  have irl trl orl qrl := all_elim(mp.mi_rdl, {statics})
  have ief tef oef qef := mp(all_elim(mp.ap_ef_ok, {c}, {statics}), hc, hst)
  have qsq := mp(all_elim(mp.sq_call_linked, {c}), hc, hx)
  let LOW := c_src_malloc_mallocng_malloc.__libc_malloc_impl_fun(mp.SO, mp.MM, mp.WLK, SQ, AM, mp.ULK, mp.MUN, mp.ap_s2c, mp.LK, AC, UG, gs, mp.ap_ef)
  let CFG := c_src_malloc_mallocng_malloc_cfg.__libc_malloc_impl_fun(mp.SO, mp.MM, mp.WLK, SQ, AM, mp.ULK, mp.MUN, mp.ap_s2c, mp.LK, AC, UG, gs, mp.ap_ef)
  have r: all args. args in abi.ARGS -> refines_ghost(LOW[args], mallocng_specs.malloc_impl_spec_fun(c)[args], abi.World, mp.G) proof
    fix args
    assume ha
    show := mp(all_elim(mp.mi_fun, {c}, {mp.SO}, {mp.MM}, {mp.WLK}, {SQ}, {AM}, {mp.ULK}, {mp.MUN}, {mp.ap_s2c}, {mp.LK}, {AC}, {UG}, {gs}, {mp.ap_ef}, {args}),
      hc, hx, hst, hdj, hlk, hlc, qso, qmm, qwl, qsq, qam, qul, qmu, qs2, qrl, cc.a_ctz_32, mp.mi_ug, asc, qef, ha)
  qed
  have ln := mp(all_elim(mitc.implements, {statics}, {mp.SO}, {mp.MM}, {mp.WLK}, {SQ}, {AM}, {mp.ULK}, {mp.MUN}, {mp.ap_s2c}, {mp.LK}, {AC}, {UG}, {gs}, {mp.ap_ef}),
    iso, tso, oso, imm, tmm, omm, iwl, twl, owl, all_elim(sstc.implements, {statics}), sstc.typed, sstc.io, iam, tam, oam, iul, tul, oul, imu, tmu, omu,
    is2, ts2, os2, irl, trl, orl, all_elim(actc.implements, {statics}), actc.typed, actc.io, all_elim(ugtc.implements, {statics}), ugtc.typed, ugtc.io,
    ias, tas, oas, ief, tef, oef)
  have st := mp(all_elim(tr.implements_refine, {4212278}, {CFG}, {LOW}, {4198400}, {text.code}, {statics}), ln,
    all_elim(__libc_malloc_impl_ref, {mp.SO}, {mp.MM}, {mp.WLK}, {SQ}, {AM}, {mp.ULK}, {mp.MUN}, {mp.ap_s2c}, {mp.LK}, {AC}, {UG}, {gs}, {mp.ap_ef}))
  show := mp(all_elim(tr.implements_abi_g, {mp.G}, {4212278}, {LOW}, {mallocng_specs.malloc_impl_spec_fun(c)}, {4198400}, {text.code}, {statics}),
    mp.g_ok, all_elim(mp.mi_divg, {c}), st, r)
qed

// ... and from the configuration alone
theorem mp.mi_machine: all c statics. mp.mi_cfg(c) ->
  abi.implements2_at(mp.G, 4212278, mallocng_specs.malloc_impl_spec_fun(c), 4198400, text.code, statics)
proof
  fix c statics
  assume hmc
  have hcf: mp.ap_cfg(c) by taut(hmc)
  show := mp(all_elim(mp.mi_over_leaves, {c}, {statics}, {mp.GRS}, {c_src_malloc_mallocng_malloc_cfg.__syscall1_fun()}, {mp.MM}, {mp.MPR}, {mp.EL}), hmc,
    mp(all_elim(mp.ap_leaves_ok, {c}, {statics}), hcf))
qed
