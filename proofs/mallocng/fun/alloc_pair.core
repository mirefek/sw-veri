theorem mp.ap_ef_ok: all c statics. c in mallocng.Cfg -> c.sct = c_src_malloc_mallocng_malloc.__malloc_size_classes ->
  tr.implements_at(4207700, mp.ap_ef, 4198400, text.code, statics) && mp.ap_ef in fn_space(abi.ARGS, powerset(univ(1))) && tr.callee_io(mp.ap_ef, 4) &&
  mp.ef_call(c, mp.ap_ef)
proof
  fix c statics
