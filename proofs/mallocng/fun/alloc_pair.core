  let GS := c_src_malloc_mallocng_malloc_cfg.get_stride_fun()
  let AC := mallocng_specs.a_crash_spec_fun()
  let SZ := c_src_malloc_mallocng_malloc_cfg.set_size_fun()
  have hss: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(SZ[regs], s, o) ->
      runs(mallocng_specs.set_size_spec_fun()[regs], s, o) proof
    fix regs s o
    assume h1 h2 h3 hr
    show := mp(all_elim(mp.ss_fun, {regs}, {s}, {o}), h1, h2, h3, mp(all_elim(set_size_ref, {regs}, {s}, {o}), h1, h2, h3, hr))
  qed
  have eq := mp(all_elim(mp.ef_q, {c}, {GS}, {AC}, {SZ}), hc, hst, gst_ref, hss)
  have rf := all_elim(enframe_ref, {GS}, {AC}, {SZ})
  have ec := apply(mp.ef_call_ref[c := c, f := mp.ap_ef, f2 := c_src_malloc_mallocng_malloc.enframe_fun(GS, AC, SZ)], rf, eq)
  have ty: mp.ap_ef in fn_space(abi.ARGS, powerset(univ(1))) by defs(tr.fun_typed, c_src_malloc_mallocng_malloc_cfg.enframe_fun)
  have io := mp(all_elim(eftc.io, {GS}, {AC}, {SZ}), gstc.io, acr.io, sszc.io)
  show by taut(all_elim(eftc.linked, {statics}), ty, io, ec)
qed

// a_crash's spec as a callee of any arity: undefined wherever it returns
theorem mp.undef_io(n): tr.callee_io(mallocng_specs.a_crash_spec_fun(), n)
proof
  have g: all args w w2 r. ord_le(n, seq_len(args)) -> runs(mallocng_specs.a_crash_spec_fun()[args], w, ok(w2, r)) ->
      tr.returns_valid(w, w2) || tr.may_raise(mallocng_specs.a_crash_spec_fun(), args, w) proof
    fix args w w2 r
    assume _ h
    have ha hp := apply(runs_fn_build, expand(h, mallocng_specs.a_crash_spec_fun))
    have wu: w in univ(1) by simp(apply(g.runs_univ, hp))
    have m: all x e. x in univ(1) -> e in univ(1) -> runs(mallocng_specs.a_crash_spec_fun()[args], w, exc(x, e)) proof
      fix x e
      assume hx he
      have pu: pair(w, exc(x, e)) in univ(1) by simp(wu, hx, he)
      show by defs(simp(ha, pu), mallocng_specs.a_crash_spec_fun)
    qed
    have d: all t. t in univ(1) -> runs(mallocng_specs.a_crash_spec_fun()[args], w, diverge(t)) proof
      fix t
      assume ht
      have pu: pair(w, diverge(t)) in univ(1) by simp(wu, ht)
      show by defs(simp(ha, pu), mallocng_specs.a_crash_spec_fun)
    qed
    have mr: tr.may_raise(mallocng_specs.a_crash_spec_fun(), args, w) by defs(taut(m, d), tr.may_raise, tr.undef)
    show by taut(mr)
  qed
  show by defs(g, tr.callee_io)
qed

// ---------------------------------------------------------------------
// The induction.

// the allocator's configuration (its tables and libc's struct at their
// statics)
abbrev mp.ap_cfg(c) := c in mallocng.Cfg && c.ctx = c_src_malloc_mallocng_malloc.__malloc_context &&
  c.sct = c_src_malloc_mallocng_malloc.__malloc_size_classes && c.dbj = c_src_malloc_mallocng_malloc.debruijn32 &&
  c.scnt = c_src_malloc_mallocng_malloc.small_cnt_tab && c.mcnt = c_src_malloc_mallocng_malloc.med_cnt_tab &&
  c.libc = c_src_malloc_mallocng_malloc.__libc

// alloc_group's CFG form over its callees and alloc_slot's gs; alloc_slot's
// over its callees and alloc_group's ga
abbrev mp.ap_agr(G1, G3, G4, G5, G6, gs) := c_src_malloc_mallocng_malloc_cfg.alloc_group_fun(mp.ap_am(G1, G3, G4, G5, G6),
  c_src_malloc_mallocng_malloc_cfg.is_bouncing_fun(), c_src_malloc_mallocng_malloc_cfg.account_bounce_fun(), c_src_malloc_mallocng_malloc_cfg.step_seq_fun(),
  G4, mp.ap_fm, mp.ap_s2c, gs, mp.ap_ef)
abbrev mp.ap_as(ga) := c_src_malloc_mallocng_malloc_cfg.alloc_slot_fun(mp.ap_ta, c_src_malloc_mallocng_malloc_cfg.a_ctz_32_fun(), ga, mp.ap_q)

// alloc_slot's code gs known from class k on: implemented, typed, its io,
// called as alloc_slot from k on
abbrev mp.ap_known(c, statics, k, gs) := tr.implements_at(4212095, gs, 4198400, text.code, statics) && gs in fn_space(abi.ARGS, powerset(univ(1))) &&
  tr.callee_io(gs, 2) && mp.as_call_ge(c, gs, k)

// alloc_group's callees but alloc_slot: called as each
abbrev mp.ap_agr_cc(c, G1, G3, G4, G5, G6) := mp.am_call(c, mp.ap_am(G1, G3, G4, G5, G6)) &&
  mp.ib_call(c, c_src_malloc_mallocng_malloc_cfg.is_bouncing_fun()) && mp.db_call(c, c_src_malloc_mallocng_malloc_cfg.account_bounce_fun()) &&
  mp.sq_call(c, c_src_malloc_mallocng_malloc_cfg.step_seq_fun()) && mp.calls(G4, mallocng_specs.mmap_spec_fun()) &&
  mp.calls(mp.ap_fm, mallocng_specs.free_meta_spec_fun(c.ctx)) && mp.calls(mp.ap_s2c, mallocng_specs.size_to_class_spec_fun(c.sct, c.dbj)) &&
  mp.ef_call(c, mp.ap_ef)

theorem mp.ap_agr_cc_ok: all c statics G1 G3 G4 G5 G6. mp.ap_cfg(c) -> mp.ap_leaves(c, statics, G1, G3, G4, G5, G6) -> mp.ap_agr_cc(c, G1, G3, G4, G5, G6)
proof
  fix c statics G1 G3 G4 G5 G6
  assume hcf hl
  have hc hx hst hdj _ _ _ := hcf
  have _ _ _ q1 _ _ _ q3 _ _ _ q4 _ _ _ q5 _ _ _ q6 := hl
  have _ _ _ am := mp(all_elim(mp.ap_am_ok, {c}, {statics}, {G1}, {G3}, {G4}, {G5}, {G6}), hc, hx, hl)
  have ib := apply(mp.ib_call_ref[c := c, f := c_src_malloc_mallocng_malloc_cfg.is_bouncing_fun(), f2 := c_src_malloc_mallocng_malloc.is_bouncing_fun()],
    is_bouncing_ref, mp(all_elim(mp.ib_q, {c}), hc, hx))
  have ab := apply(mp.db_call_ref[c := c, f := c_src_malloc_mallocng_malloc_cfg.account_bounce_fun(), f2 := c_src_malloc_mallocng_malloc.account_bounce_fun()],
    account_bounce_ref, mp(all_elim(mp.ab_q, {c}), hc, hx))
  have sq := apply(mp.sq_call_ref[c := c, f := c_src_malloc_mallocng_malloc_cfg.step_seq_fun(), f2 := c_src_malloc_mallocng_malloc.step_seq_fun()],
    step_seq_ref, mp(all_elim(mp.sq_q, {c}), hc, hx))
  have _ _ _ fm := mp(all_elim(mp.ap_fm_ok, {c}, {statics}), hx)
  have _ _ _ s2 := mp(all_elim(mp.ap_s2c_ok, {c}, {statics}), hst, hdj)
  have _ _ _ ef := mp(all_elim(mp.ap_ef_ok, {c}, {statics}), hc, hst)
  show by taut(am, ib, ab, sq, q4, fm, s2, ef)
qed

// alloc_group over alloc_slot's code known from k + 1 on: implemented,
// typed, its io, called as alloc_group from k on
theorem mp.ap_agr_ok: all c statics G1 G3 G4 G5 G6 k gs. mp.ap_cfg(c) -> mp.ap_leaves(c, statics, G1, G3, G4, G5, G6) -> k in omega ->
  mp.ap_known(c, statics, int_add(k, 1), gs) ->
  tr.implements_at(4210406, mp.ap_agr(G1, G3, G4, G5, G6, gs), 4198400, text.code, statics) &&
  mp.ap_agr(G1, G3, G4, G5, G6, gs) in fn_space(abi.ARGS, powerset(univ(1))) && tr.callee_io(mp.ap_agr(G1, G3, G4, G5, G6, gs), 2) &&
  mp.agr_call_ge(c, mp.ap_agr(G1, G3, G4, G5, G6, gs), k)
proof
  fix c statics G1 G3 G4 G5 G6 k gs
  assume hcf hl ko hk
  have hc hx hst hdj hscn hmcn _ := hcf
  have _ _ _ _ _ _ _ _ i4 t4 o4 _ _ _ _ _ _ _ _ _ := hl
  have ik tk ok qk := hk
  let AM := mp.ap_am(G1, G3, G4, G5, G6)
  let IB := c_src_malloc_mallocng_malloc_cfg.is_bouncing_fun()
  let AB := c_src_malloc_mallocng_malloc_cfg.account_bounce_fun()
  let SS := c_src_malloc_mallocng_malloc_cfg.step_seq_fun()
  have iam tam oam _ := mp(all_elim(mp.ap_am_ok, {c}, {statics}, {G1}, {G3}, {G4}, {G5}, {G6}), hc, hx, hl)
  have ifm tfm ofm _ := mp(all_elim(mp.ap_fm_ok, {c}, {statics}), hx)
  have is2 ts2 os2 _ := mp(all_elim(mp.ap_s2c_ok, {c}, {statics}), hst, hdj)
  have ief tef oef _ := mp(all_elim(mp.ap_ef_ok, {c}, {statics}), hc, hst)
  have ln := mp(all_elim(agrc.implements, {statics}, {AM}, {IB}, {AB}, {SS}, {G4}, {mp.ap_fm}, {mp.ap_s2c}, {gs}, {mp.ap_ef}),
    iam, tam, oam, all_elim(ibtc.implements, {statics}), ibtc.typed, ibtc.io, all_elim(acbtc.implements, {statics}), acbtc.typed, acbtc.io,
    all_elim(sstc.implements, {statics}), sstc.typed, sstc.io, i4, t4, o4, ifm, tfm, ofm, is2, ts2, os2, ik, tk, ok, ief, tef, oef)
  have ty: mp.ap_agr(G1, G3, G4, G5, G6, gs) in fn_space(abi.ARGS, powerset(univ(1))) by defs(tr.fun_typed, c_src_malloc_mallocng_malloc_cfg.alloc_group_fun)
  have io := mp(all_elim(agrc.io, {AM}, {IB}, {AB}, {SS}, {G4}, {mp.ap_fm}, {mp.ap_s2c}, {gs}, {mp.ap_ef}), oam, ibtc.io, acbtc.io, sstc.io, o4, ofm, os2, ok, oef)
  // (called as alloc_group from k on: its structured form's, alloc_slot
  // known from k + 1 on)
  have cam cib cab css cmm cfm cs2 cef := mp(all_elim(mp.ap_agr_cc_ok, {c}, {statics}, {G1}, {G3}, {G4}, {G5}, {G6}), hcf, hl)
  have aq := mp(all_elim(mp.agr_q, {c}, {k}, {AM}, {IB}, {AB}, {SS}, {G4}, {mp.ap_fm}, {mp.ap_s2c}, {gs}, {mp.ap_ef}), hc, hx, hst, hdj, hscn, hmcn, ko,
    cam, cib, cab, css, cmm, cfm, cs2, qk, cef)
  have rf := mp(all_elim(alloc_group_ref, {AM}, {IB}, {AB}, {SS}, {G4}, {mp.ap_fm}, {mp.ap_s2c}, {gs}, {mp.ap_ef}),
    oam, ibtc.io, acbtc.io, sstc.io, o4, ofm, os2, ok, oef)
  have ac := apply(mp.agr_call_ge_ref[c := c, f := mp.ap_agr(G1, G3, G4, G5, G6, gs),
    f2 := c_src_malloc_mallocng_malloc.alloc_group_fun(AM, IB, AB, SS, G4, mp.ap_fm, mp.ap_s2c, gs, mp.ap_ef), k := k], rf, aq)
  show by taut(ln, ty, io, ac)
qed

// alloc_slot over alloc_group's code known from k on: known from k on
theorem mp.ap_as_ok: all c statics k ga. mp.ap_cfg(c) -> k in omega ->
  tr.implements_at(4210406, ga, 4198400, text.code, statics) -> ga in fn_space(abi.ARGS, powerset(univ(1))) -> tr.callee_io(ga, 2) -> mp.agr_call_ge(c, ga, k) ->
  mp.ap_known(c, statics, k, mp.ap_as(ga))
proof
  fix c statics k ga
  assume hcf ko iga tga oga qga
  have hc hx hst hdj _ _ _ := hcf
  let AC := c_src_malloc_mallocng_malloc_cfg.a_ctz_32_fun()
  have ita tta ota qta := mp(all_elim(mp.ap_ta_ok, {c}, {statics}), hc, hx, hst)
  have iq tq oq qq := all_elim(mp.ap_q_ok, {statics})
  have ln := mp(all_elim(astc.implements, {statics}, {mp.ap_ta}, {AC}, {ga}, {mp.ap_q}), ita, tta, ota, all_elim(actc.implements, {statics}), actc.typed, actc.io,
    iga, tga, oga, iq, tq, oq)
  have ty: mp.ap_as(ga) in fn_space(abi.ARGS, powerset(univ(1))) by defs(tr.fun_typed, c_src_malloc_mallocng_malloc_cfg.alloc_slot_fun)
  have io := mp(all_elim(astc.io, {mp.ap_ta}, {AC}, {ga}, {mp.ap_q}), ota, actc.io, oga, oq)
  have aq := mp(all_elim(mp.as_q, {c}, {k}, {mp.ap_ta}, {AC}, {ga}, {mp.ap_q}), hc, hx, hst, hdj, ko, qta, cc.a_ctz_32, qga, qq)
  have rf := all_elim(alloc_slot_ref, {mp.ap_ta}, {AC}, {ga}, {mp.ap_q})
  have ac := apply(mp.as_call_ge_ref[c := c, f := mp.ap_as(ga), f2 := c_src_malloc_mallocng_malloc.alloc_slot_fun(mp.ap_ta, AC, ga, mp.ap_q), k := k], rf, aq)
  show by taut(ln, ty, io, ac)
qed

// one class down: alloc_slot known from k + 1 on gives it from k on
theorem mp.ap_step: all c statics G1 G3 G4 G5 G6 k gs. mp.ap_cfg(c) -> mp.ap_leaves(c, statics, G1, G3, G4, G5, G6) -> k in omega ->
  mp.ap_known(c, statics, int_add(k, 1), gs) -> mp.ap_known(c, statics, k, mp.ap_as(mp.ap_agr(G1, G3, G4, G5, G6, gs)))
proof
  fix c statics G1 G3 G4 G5 G6 k gs
  assume hcf hl ko hk
  have i t o q := mp(all_elim(mp.ap_agr_ok, {c}, {statics}, {G1}, {G3}, {G4}, {G5}, {G6}, {k}, {gs}), hcf, hl, ko, hk)
  show := mp(all_elim(mp.ap_as_ok, {c}, {statics}, {k}, {mp.ap_agr(G1, G3, G4, G5, G6, gs)}), hcf, ko, i, t, o, q)
qed

// down from class 48 (nothing known: a_crash's spec) to n classes below it
theorem mp.ap_all: all c statics G1 G3 G4 G5 G6. mp.ap_cfg(c) -> mp.ap_leaves(c, statics, G1, G3, G4, G5, G6) ->
  all n. n in omega -> int_le(n, 48) -> ex gs. mp.ap_known(c, statics, int_sub(48, n), gs)
proof
  fix c statics G1 G3 G4 G5 G6
  assume hcf hl
  let P(n) := int_le(n, 48) -> ex gs. mp.ap_known(c, statics, int_sub(48, n), gs)
  have b: P(0) proof
    assume _
    let AC := mallocng_specs.a_crash_spec_fun()
    have e: int_sub(48, 0) = 48 by arith()
    have k48: mp.ap_known(c, statics, 48, AC) by taut(all_elim(mp.undef_implements, {4212095}, {statics}), acr.typed, mp.undef_io[n := 2],
      mp.as_call_48[c := c, f := AC])
    show by ex_intro({AC}, rewrite(sym(e), k48))
  qed
  have s: all n. n in omega -> P(n) -> P(int_add(n, 1)) proof
    fix n
    assume no hp hle
    obtain gs, hk from mp(hp, (int_le(n, 48) by arith(hle)))
    let K := int_sub(48, int_add(n, 1))
    have ko: K in omega by arith(no, hle)
    have e: int_add(K, 1) = int_sub(48, n) by arith(no, hle)
    have k1 := mp(all_elim(mp.ap_step, {c}, {statics}, {G1}, {G3}, {G4}, {G5}, {G6}, {K}, {gs}), hcf, hl, ko, rewrite(sym(e), hk))
    show by ex_intro({mp.ap_as(mp.ap_agr(G1, G3, G4, G5, G6, gs))}, k1)
  qed
  show := mp(nat_ind[p := n. P(n)], b, s)
qed

// ---------------------------------------------------------------------
// The two at machine level: their contracts (the ghost part the allocator's
// abstract state), their leaves' machine code by hypothesis.

theorem mp.as_implements: all c statics G1 G3 G4 G5 G6. mp.ap_cfg(c) -> mp.ap_leaves(c, statics, G1, G3, G4, G5, G6) ->
  abi.implements2_at(mp.G, 4212095, mallocng_specs.alloc_slot_spec_fun(c), 4198400, text.code, statics)
proof
  fix c statics G1 G3 G4 G5 G6
  assume hcf hl
  have hc hx hst hdj _ _ _ := hcf
  // alloc_slot known from class 0 on: its alloc_group over it, called as
  // alloc_group everywhere
  obtain gs, hk0 from mp(all_elim(mp.ap_all, {c}, {statics}, {G1}, {G3}, {G4}, {G5}, {G6}), hcf, hl, {48}, simp(), arith())
  have e0: int_sub(48, 48) = 0 by arith()
  have i0 t0 o0 q0 := rewrite(e0, hk0)
  have q1 := apply(mp.as_call_ge_mono[c := c, f := gs, k := 0, k2 := int_add(0, 1)], simp(), arith(), q0)
  have ia ta oa qa := mp(all_elim(mp.ap_agr_ok, {c}, {statics}, {G1}, {G3}, {G4}, {G5}, {G6}, {0}, {gs}), hcf, hl, simp(), (mp.ap_known(c, statics, int_add(0, 1), gs) by taut(i0, t0, o0, q1)))
  let GA := mp.ap_agr(G1, G3, G4, G5, G6, gs)
  have agr := apply(mp.agr_call_of_ge0[c := c, f := GA], qa)
  let AC := c_src_malloc_mallocng_malloc_cfg.a_ctz_32_fun()
  let LOW := c_src_malloc_mallocng_malloc.alloc_slot_fun(mp.ap_ta, AC, GA, mp.ap_q)
  have _ _ _ qta := mp(all_elim(mp.ap_ta_ok, {c}, {statics}), hc, hx, hst)
  have _ _ _ qq := all_elim(mp.ap_q_ok, {statics})
  have r: all args. args in abi.ARGS -> refines_ghost(LOW[args], mallocng_specs.alloc_slot_spec_fun(c)[args], abi.World, mp.G) proof
    fix args
    assume ha
    show := mp(all_elim(mp.as_fun, {c}, {args}, {mp.ap_ta}, {AC}, {GA}, {mp.ap_q}), hc, hx, hst, hdj, qta, cc.a_ctz_32, agr, qq, ha)
  qed
  have ik _ _ _ := mp(all_elim(mp.ap_as_ok, {c}, {statics}, {0}, {GA}), hcf, simp(), ia, ta, oa, qa)
  have st := mp(all_elim(tr.implements_refine, {4212095}, {mp.ap_as(GA)}, {LOW}, {4198400}, {text.code}, {statics}), ik,
    all_elim(alloc_slot_ref, {mp.ap_ta}, {AC}, {GA}, {mp.ap_q}))
  show := mp(all_elim(tr.implements_abi_g, {mp.G}, {4212095}, {LOW}, {mallocng_specs.alloc_slot_spec_fun(c)}, {4198400}, {text.code}, {statics}),
    mp.g_ok, all_elim(mp.as_divg, {c}), st, r)
qed

theorem mp.agr_implements: all c statics G1 G3 G4 G5 G6. mp.ap_cfg(c) -> mp.ap_leaves(c, statics, G1, G3, G4, G5, G6) ->
  abi.implements2_at(mp.G, 4210406, mallocng_specs.alloc_group_spec_fun(c), 4198400, text.code, statics)
proof
  fix c statics G1 G3 G4 G5 G6
  assume hcf hl
  have hc hx hst hdj hscn hmcn _ := hcf
  // alloc_slot known from class 0 on: called as alloc_slot everywhere
  obtain gs, hk0 from mp(all_elim(mp.ap_all, {c}, {statics}, {G1}, {G3}, {G4}, {G5}, {G6}), hcf, hl, {48}, simp(), arith())
  have e0: int_sub(48, 48) = 0 by arith()
  have i0 t0 o0 q0 := rewrite(e0, hk0)
  have q1 := apply(mp.as_call_ge_mono[c := c, f := gs, k := 0, k2 := int_add(0, 1)], simp(), arith(), q0)
  have ia _ _ _ := mp(all_elim(mp.ap_agr_ok, {c}, {statics}, {G1}, {G3}, {G4}, {G5}, {G6}, {0}, {gs}), hcf, hl, simp(), (mp.ap_known(c, statics, int_add(0, 1), gs) by taut(i0, t0, o0, q1)))
  have asc := apply(mp.as_call_of_ge0[c := c, f := gs], q0)
  let AM := mp.ap_am(G1, G3, G4, G5, G6)
  let IB := c_src_malloc_mallocng_malloc_cfg.is_bouncing_fun()
  let AB := c_src_malloc_mallocng_malloc_cfg.account_bounce_fun()
  let SS := c_src_malloc_mallocng_malloc_cfg.step_seq_fun()
  let LOW := c_src_malloc_mallocng_malloc.alloc_group_fun(AM, IB, AB, SS, G4, mp.ap_fm, mp.ap_s2c, gs, mp.ap_ef)
  have cam cib cab css cmm cfm cs2 cef := mp(all_elim(mp.ap_agr_cc_ok, {c}, {statics}, {G1}, {G3}, {G4}, {G5}, {G6}), hcf, hl)
  have r: all args. args in abi.ARGS -> refines_ghost(LOW[args], mallocng_specs.alloc_group_spec_fun(c)[args], abi.World, mp.G) proof
    fix args
    assume ha
    show := mp(all_elim(mp.agp_fun, {c}, {args}, {AM}, {IB}, {AB}, {SS}, {G4}, {mp.ap_fm}, {mp.ap_s2c}, {gs}, {mp.ap_ef}), hc, hx, hst, hdj, hscn, hmcn,
      cam, cib, cab, css, cmm, cfm, cs2, asc, cef, ha)
  qed
  have _ _ _ _ _ _ _ _ _ _ o4 _ _ _ _ _ _ _ _ _ := hl
  have _ _ oam _ := mp(all_elim(mp.ap_am_ok, {c}, {statics}, {G1}, {G3}, {G4}, {G5}, {G6}), hc, hx, hl)
  have _ _ ofm _ := mp(all_elim(mp.ap_fm_ok, {c}, {statics}), hx)
  have _ _ os2 _ := mp(all_elim(mp.ap_s2c_ok, {c}, {statics}), hst, hdj)
  have _ _ oef _ := mp(all_elim(mp.ap_ef_ok, {c}, {statics}), hc, hst)
  have st := mp(all_elim(tr.implements_refine, {4210406}, {mp.ap_agr(G1, G3, G4, G5, G6, gs)}, {LOW}, {4198400}, {text.code}, {statics}), ia,
    mp(all_elim(alloc_group_ref, {AM}, {IB}, {AB}, {SS}, {G4}, {mp.ap_fm}, {mp.ap_s2c}, {gs}, {mp.ap_ef}), oam, ibtc.io, acbtc.io, sstc.io, o4, ofm, os2, o0, oef))
  show := mp(all_elim(tr.implements_abi_g, {mp.G}, {4210406}, {LOW}, {mallocng_specs.alloc_group_spec_fun(c)}, {4198400}, {text.code}, {statics}),
    mp.g_ok, all_elim(mp.agp_divg, {c}), st, r)
qed

// ---------------------------------------------------------------------
// The leaves' machine code linked: alloc_meta, alloc_slot and alloc_group
// at machine level from the configuration alone

theorem mp.ap_leaves_ok: all c statics. mp.ap_cfg(c) ->
  mp.ap_leaves(c, statics, mp.GRS, c_src_malloc_mallocng_malloc_cfg.__syscall1_fun(), mp.MM, mp.MPR, mp.EL)
proof
  fix c statics
  assume hcf
  have _ _ _ _ _ _ hlb := hcf
  have g := rewrite(sym(hlb), all_elim(mp.ap_grs, {statics}))
  show by taut(g, all_elim(mp.ap_sy1, {statics}), all_elim(mp.ap_mm, {statics}), all_elim(mp.ap_mpr, {statics}), all_elim(mp.ap_el, {statics}))
qed

theorem mp.am_machine: all c statics. mp.ap_cfg(c) ->
  abi.implements2_at(mp.G, 4208782, mallocng_specs.alloc_meta_spec_fun(c), 4198400, text.code, statics)
proof
  fix c statics
  assume hcf
  have hc hx _ _ _ _ _ := hcf
  have i1 t1 o1 q1 i3 t3 o3 q3 i4 t4 o4 q4 i5 t5 o5 q5 i6 t6 o6 q6 := mp(all_elim(mp.ap_leaves_ok, {c}, {statics}), hcf)
  show := mp(all_elim(mp.am_implements, {c}, {statics}, {mp.GRS}, {c_src_malloc_mallocng_malloc_cfg.__syscall1_fun()}, {mp.MM}, {mp.MPR}, {mp.EL}), hc, hx,
    i1, t1, o1, q1, i3, t3, o3, q3, i4, t4, o4, q4, i5, t5, o5, q5, i6, t6, o6, q6)
qed

theorem mp.as_machine: all c statics. mp.ap_cfg(c) ->
  abi.implements2_at(mp.G, 4212095, mallocng_specs.alloc_slot_spec_fun(c), 4198400, text.code, statics)
proof
  fix c statics
  assume hcf
  show := mp(all_elim(mp.as_implements, {c}, {statics}, {mp.GRS}, {c_src_malloc_mallocng_malloc_cfg.__syscall1_fun()}, {mp.MM}, {mp.MPR}, {mp.EL}), hcf,
    mp(all_elim(mp.ap_leaves_ok, {c}, {statics}), hcf))
qed

theorem mp.agr_machine: all c statics. mp.ap_cfg(c) ->
  abi.implements2_at(mp.G, 4210406, mallocng_specs.alloc_group_spec_fun(c), 4198400, text.code, statics)
proof
  fix c statics
  assume hcf
  show := mp(all_elim(mp.agr_implements, {c}, {statics}, {mp.GRS}, {c_src_malloc_mallocng_malloc_cfg.__syscall1_fun()}, {mp.MM}, {mp.MPR}, {mp.EL}), hcf,
    mp(all_elim(mp.ap_leaves_ok, {c}, {statics}), hcf))
qed
