theorem mp.ap_q_ok: all statics. tr.implements_at(4206220, mp.ap_q, 4198400, text.code, statics) && mp.ap_q in fn_space(abi.ARGS, powerset(univ(1))) &&
  tr.callee_io(mp.ap_q, 2) && (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(mp.ap_q[regs], s, o) ->
    runs(mallocng_specs.queue_spec_fun()[regs], s, o))
proof
