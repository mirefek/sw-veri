theorem mp.ap_am_ok: all c statics G1 G3 G4 G5 G6. c in mallocng.Cfg -> c.ctx = c_src_malloc_mallocng_malloc.__malloc_context ->
  mp.ap_leaves(c, statics, G1, G3, G4, G5, G6) ->
  tr.implements_at(4208782, mp.ap_am(G1, G3, G4, G5, G6), 4198400, text.code, statics) && mp.ap_am(G1, G3, G4, G5, G6) in fn_space(abi.ARGS, powerset(univ(1))) &&
  tr.callee_io(mp.ap_am(G1, G3, G4, G5, G6), 0) && mp.am_call(c, mp.ap_am(G1, G3, G4, G5, G6))
proof
  fix c statics G1 G3 G4 G5 G6
  assume hc hx hl
  have i1 t1 o1 q1 i3 t3 o3 q3 i4 t4 o4 q4 i5 t5 o5 q5 i6 t6 o6 q6 := hl
  let DQ := c_src_malloc_mallocng_malloc_cfg.dequeue_fun
  let DH := c_src_malloc_mallocng_malloc_cfg.dequeue_head_fun(DQ)
  have hdq: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(DQ[regs], s, o) ->
      runs(mallocng_specs.dequeue_spec_fun()[regs], s, o) proof
    fix regs s o
    assume h1 h2 h3 hr
    show := mp(all_elim(mp.dq_fun, {regs}, {s}, {o}), h1, h2, h3, mp(all_elim(dequeue_ref, {regs}, {s}, {o}), h1, h2, h3, hr))
  qed
  have c2 := mp(all_elim(mp.dqh_fun, {DQ}), hdq)
  have qdh: mp.calls(DH, mallocng_specs.dequeue_head_spec_fun()) proof
    fix regs s o
    assume h1 h2 h3 hr
    show := mp(all_elim(c2, {regs}, {s}, {o}), h1, h2, h3, mp(all_elim(dequeue_head_ref, {DQ}, {regs}, {s}, {o}), h1, h2, h3, hr))
  qed
  have tdh: DH in fn_space(abi.ARGS, powerset(univ(1))) by defs(tr.fun_typed, c_src_malloc_mallocng_malloc_cfg.dequeue_head_fun)
  have odh := mp(all_elim(dqhtc.io, {DQ}), dqtc.io)
  have ln := mp(all_elim(amtc.implements, {statics}, {G1}, {DH}, {G3}, {G4}, {G5}, {G6}), i1, t1, o1, all_elim(dqhtc.linked, {statics}), tdh, odh, i3, t3, o3,
    i4, t4, o4, i5, t5, o5, i6, t6, o6)
  have ty: mp.ap_am(G1, G3, G4, G5, G6) in fn_space(abi.ARGS, powerset(univ(1))) by defs(tr.fun_typed, c_src_malloc_mallocng_malloc_cfg.__malloc_alloc_meta_fun)
  have io := mp(all_elim(amtc.io, {G1}, {DH}, {G3}, {G4}, {G5}, {G6}), o1, odh, o3, o4, o5, o6)
  have rf := all_elim(__malloc_alloc_meta_ref, {G1}, {DH}, {G3}, {G4}, {G5}, {G6})
  have aq := mp(all_elim(mp.am_q, {c}, {G1}, {DH}, {G3}, {G4}, {G5}, {G6}), hc, hx, q1, qdh, q3, q4, q5, q6)
  have ac := apply(mp.am_call_ref[c := c, f := mp.ap_am(G1, G3, G4, G5, G6), f2 := c_src_malloc_mallocng_malloc.__malloc_alloc_meta_fun(G1, DH, G3, G4, G5, G6)], rf, aq)
  show by taut(ln, ty, io, ac)
qed

