// alloc_slot and alloc_group at machine level: they call each other (a
// nested group's slot of a larger class), so their contracts are composed
// by induction on the class, down from 48. At class k alloc_slot's callee
// is alloc_group's code over alloc_slot's from class k + 1 on: called as
// alloc_group from k on (`mp.agr_q`), so alloc_slot over it from k on
// (`mp.as_q`); at 48, a_crash's spec (undefined) -- no class.

// the base: nothing known (a_crash's spec, undefined), implemented by any
// code
theorem mp.undef_implements: all f statics. tr.implements_at(f, mallocng_specs.a_crash_spec_fun(), 4198400, text.code, statics)
proof
  fix f statics
  have g: all args objs mem s o. args in abi.ARGS -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) ->
      abi.loaded(s.vm, 4198400, text.code, statics) -> s.rip = f -> tr.entry_ok_u(s, args) -> tr.objs_ok(s, objs) -> abi.view_ok(s, objs, mem) ->
      tr.run_d(s, s, o) -> tr.matches_t(mallocng_specs.a_crash_spec_fun(), args, objs, mem, s, o) proof
    fix args objs mem s o
    assume hA ho hm hs hu _ _ _ _ _ _
    let V := abi.view(s, objs, mem)
    have ou := apply(abi.objs_univ, ho)
    have mu := apply(x86.vm_univ, hm)
    have ocu := mp(all_elim(abi.objs_at_univ, {objs}, {s.fs_base}), ou)
    have vu: V in univ(1) by simp(hu, ou, mu, ocu)
    have vW := apply(abi.world_typed, hs, ho, hm, vu)
    have rst: abi.raise_state(V) by defs(apply(tr.world_and, vW), abi.raise_state)
    have eu: empty in univ(1) by simp()
    have eno: !(empty = exc_val("stack_overflow", empty)) by defs(all_elim(tr.pair_ne, {"stack_overflow"}, {empty}), exc_val)
    have pu: pair(V, exc(V, empty)) in univ(1) by simp(vu)
    have rf: runs(mallocng_specs.a_crash_spec_fun()[args], V, exc(V, empty)) by defs(simp(hA, pu), mallocng_specs.a_crash_spec_fun)
    have ra: abi.raises_at(mallocng_specs.a_crash_spec_fun(), args, objs, mem, s) by defs(ex_intro({empty}, {V}, taut(eu, eno, rst, rf)), abi.raises_at)
    show by defs(taut(ra), tr.matches_t)
  qed
  show := apply(tr.implements_u, (tr.implements_at_u(f, mallocng_specs.a_crash_spec_fun(), 4198400, text.code, statics) by defs(g, tr.implements_at_u)))
qed

// (at class 48 on: no class -- any callee's contract)
theorem mp.as_call_48(c, f): mp.as_call_ge(c, f, 48)
proof
  fix sc req t h regs o2
  assume _ _ hsl hge
  have no: false by arith(hsl, hge)
  show by taut(no)
qed

theorem mp.agr_call_48(c, f): mp.agr_call_ge(c, f, 48)
proof
  fix sc req t h regs o2
  assume _ _ hsl hge
  have no: false by arith(hsl, hge)
  show by taut(no)
qed

// (a callee refining one called as step_seq / enframe: called as it too)
theorem mp.sq_call_ref(c, f, f2): (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(f[regs], s, o) -> runs(f2[regs], s, o)) ->
  mp.sq_call(c, f2) -> mp.sq_call(c, f)
proof
  assume hf q
  fix t h regs o2
  assume hw hh hin hsh hro hr
  have rl rn := apply(gc.regs0, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have r2 := mp(all_elim(hf, {regs}, {t}, {o2}), rl, (int_le(seq_len(regs), 6) by arith(rn, lo)), hw, hr)
  show := mp(all_elim(q, {t}, {h}, {regs}, {o2}), hw, hh, hin, hsh, hro, r2)
qed

theorem mp.ef_call_ref(c, f, f2): (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(f[regs], s, o) -> runs(f2[regs], s, o)) ->
  mp.ef_call(c, f2) -> mp.ef_call(c, f)
proof
  assume hf q
  fix g idx n ctr t h regs o2
  assume hg hi hn hct hw hh hin hsh hth hu hro2 hsr hfit hst hlt hfs hro hr
  have rl rn _ := hro
  have l4: seq_len(regs) = 4 by simp(rn)
  have lo: seq_len(regs) in omega by simp(rl)
  have r2 := mp(all_elim(hf, {regs}, {t}, {o2}), rl, (int_le(seq_len(regs), 6) by arith(l4, lo)), hw, hr)
  show := mp(all_elim(q, {g}, {idx}, {n}, {ctr}, {t}, {h}, {regs}, {o2}), hg, hi, hn, hct, hw, hh, hin, hsh, hth, hu, hro2, hsr, hfit, hst, hlt, hfs, hro, r2)
qed

// ---------------------------------------------------------------------
// The callees of the two besides each other: their machine code linked,
// typed, their io, their contracts at a call.

// try_avail's CFG form linked (with dequeue, activate_group, a_crash's
// contract, decay_bounces)
abbrev mp.ap_ta := c_src_malloc_mallocng_malloc_cfg.try_avail_fun(c_src_malloc_mallocng_malloc_cfg.dequeue_fun,
  c_src_malloc_mallocng_malloc_cfg.activate_group_fun(mallocng_specs.a_crash_spec_fun(), c_src_malloc_mallocng_malloc_cfg.a_cas_fun()),
  mallocng_specs.a_crash_spec_fun(), c_src_malloc_mallocng_malloc_cfg.decay_bounces_fun())

theorem mp.ap_ta_ok: all c statics. c in mallocng.Cfg -> c.ctx = c_src_malloc_mallocng_malloc.__malloc_context -> c.sct = c_src_malloc_mallocng_malloc.__malloc_size_classes ->
  tr.implements_at(4209736, mp.ap_ta, 4198400, text.code, statics) && mp.ap_ta in fn_space(abi.ARGS, powerset(univ(1))) && tr.callee_io(mp.ap_ta, 1) && mp.ta_call(c, mp.ap_ta)
proof
  fix c statics
  assume hc hx hst
  let AC := mallocng_specs.a_crash_spec_fun()
  let DQ := c_src_malloc_mallocng_malloc_cfg.dequeue_fun
  let AG := c_src_malloc_mallocng_malloc_cfg.activate_group_fun(AC, c_src_malloc_mallocng_malloc_cfg.a_cas_fun())
  let DB := c_src_malloc_mallocng_malloc_cfg.decay_bounces_fun()
  have hgq: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
      runs(DQ[regs], s, o) -> runs(mallocng_specs.dequeue_spec_fun()[regs], s, o) proof
    fix regs s o
    assume h1 h2 h3 hr
    show := mp(all_elim(mp.dq_fun, {regs}, {s}, {o}), h1, h2, h3, mp(all_elim(dequeue_ref, {regs}, {s}, {o}), h1, h2, h3, hr))
  qed
  have agr := mp(all_elim(activate_group_ref, {AC}, {c_src_malloc_mallocng_malloc_cfg.a_cas_fun()}), acr.io, acstc.io)
  have hag := apply(mp.ag_call_ref[c := c, f := AG, f2 := c_src_malloc_mallocng_malloc.activate_group_fun(AC, c_src_malloc_mallocng_malloc_cfg.a_cas_fun())], agr,
    mp(all_elim(mp.ag_q, {c}, {AC}, {c_src_malloc_mallocng_malloc_cfg.a_cas_fun()}), hc, cc.a_cas))
  have hdb := apply(mp.db_call_ref[c := c, f := DB, f2 := c_src_malloc_mallocng_malloc.decay_bounces_fun()], decay_bounces_ref, mp(all_elim(mp.db_q, {c}), hc, hx))
  have tq := mp(all_elim(mp.ta_q, {c}, {DQ}, {AG}, {AC}, {DB}), hc, hx, hst, hgq, hag, hdb)
  have rf := mp(all_elim(try_avail_ref, {DQ}, {AG}, {AC}, {DB}), dqtc.io, agtc.io_linked, acr.io, dbtc.io)
  have ta := apply(mp.ta_call_ref[c := c, f := mp.ap_ta, f2 := c_src_malloc_mallocng_malloc.try_avail_fun(DQ, AG, AC, DB)], rf, tq)
  have ty: mp.ap_ta in fn_space(abi.ARGS, powerset(univ(1))) by defs(tr.fun_typed, c_src_malloc_mallocng_malloc_cfg.try_avail_fun)
  have io := mp(all_elim(tatc.io, {DQ}, {AG}, {AC}, {DB}), dqtc.io, agtc.io_linked, acr.io, dbtc.io)
  show by taut(all_elim(tatc.linked, {statics}), ty, io, ta)
qed

