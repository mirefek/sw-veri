// dequeue, dequeue_head, queue, free_meta by their purpose: their
// effect on the lists at a head word.

// dequeue's effect on the list at *phead holding m, of 2 or more: m out
// of it, its neighbours linked, the head moved past it; m's links cleared;
// no byte but the head word and the links written
theorem mp.dq_list2(vm, objs, phead, m, l, k): vm in x86_64_linux.Vm -> vm.bytes in fn_space(bits(64), bits(8)) -> phead in bits(64) -> m in bits(64) ->
  l in list_type(omega) -> k in omega -> int_lt(k, seq_len(l)) -> int_le(2, seq_len(l)) -> l[k] = m ->
  mallocng_specs.list_at(vm, objs, phead, l) ->
  ((mallocng_specs.list_at(mallocng_specs.dequeue_vm(vm, phead, m), objs, phead, mallocng_specs.rm_at(l, k)) &&
     mallocng_specs.rd64(mallocng_specs.dequeue_vm(vm, phead, m), m) = 0) && mallocng_specs.rd64(mallocng_specs.dequeue_vm(vm, phead, m), bits_add(64, m, 8)) = 0) &&
  mallocng_specs.links_only(vm, mallocng_specs.dequeue_vm(vm, phead, m), phead, l)
proof
  assume hvm hb hp hm hl hk hkl h2 hlk H
  let L := seq_len(l)
  let IP := int_mod(int_sub(int_add(k, L), 1), L)
  let IN := int_mod(int_add(k, 1), L)
  let P := l[IP]
  let N := l[IN]
  have {hok = head, hal = head_al, el = elems, ap = apart} := expand(H, mallocng_specs.list_at)
  have lo: L in omega by arith(hl)
  have ipk ink in0 := apply(mp.nb_idx[L := L, k := k], lo, hk, h2, hkl)
  have ipo: IP in omega by arith(hk, lo, h2)
  have ipl: int_lt(IP, L) by arith(hk, lo, h2)
  have ino: IN in omega by arith(hk, lo, h2)
  have inl: int_lt(IN, L) by arith(hk, lo, h2)
  have pho: phead in omega by simp(hp)
  have {phl0 = bound} := expand(hok, mallocng_specs.word_ok)
  have phl: int_le(int_add(phead, 8), 18446744073709551616) by arith(phl0, pho)

  // l's elements: naturals, apart from the head word and from each other
  have ef: all i. i in omega -> int_lt(i, L) -> (l[i] in omega && int_le(int_add(l[i], 16), 18446744073709551616)) &&
      (int_le(int_add(phead, 8), l[i]) || int_le(int_add(l[i], 16), phead)) proof
    fix i
    assume hi hil
    have lo2 := apply(at_type[l := l, t := omega, i := i], hl, hi, hil)
    have {lb = bound, lp = off_head} := mp(all_elim(el, {i}), hi, hil)
    have lb2: int_le(int_add(l[i], 16), 18446744073709551616) by arith(lb)
    show by taut(lo2, lb2, lp)
  qed
  have ea: all i. all j. i in omega -> j in omega -> int_lt(i, L) -> int_lt(j, L) -> !(i = j) ->
      int_le(int_add(l[i], 16), l[j]) || int_le(int_add(l[j], 16), l[i]) proof
    fix i j
    assume hi hj hil hjl hne
    show := mp(all_elim(ap, {i}, {j}), taut(hi, hj), taut(hil, hjl, hne))
  qed
  have po pb pa := mp(all_elim(ef, {IP}), ipo, ipl)
  have no nb na := mp(all_elim(ef, {IN}), ino, inl)
  have mo0 mb0 ma0 := mp(all_elim(ef, {k}), hk, hkl)
  have mo := rewrite(hlk, mo0)
  have mb := rewrite(hlk, mb0)
  have ma := rewrite(hlk, ma0)
  have pm := rewrite(hlk, mp(all_elim(ea, {IP}, {k}), ipo, hk, ipl, hkl, ipk))
  have nm := rewrite(hlk, mp(all_elim(ea, {IN}, {k}), ino, hk, inl, hkl, ink))

  // the words read: m's links its neighbours, the head word the first
  have hd0 ws0 := apply(mp.list_rd[vm := vm, objs := objs, phead := phead, l := l, i := k], hb, hp, hl, H)
  have rn0 rp0 := mp(ws0, hk, hkl)
  have rn := rewrite(hlk, rn0)
  have rp := rewrite(hlk, rp0)
  have h0: gimple.bytes_at(vm, phead, 8) = l[0] by simp(hd0, (!(L = 0) by arith(h2, lo)))
  have z0 := apply(at_type[l := l, t := omega, i := 0], hl, simp(), (int_lt(0, L) by arith(h2, lo)))
  have zo zb za := mp(all_elim(ef, {0}), simp(), (int_lt(0, L) by arith(h2, lo)))
  have bm8: bits_add(64, m, 8) = int_add(m, 8) by defs(arith(mo, mb), bits_add, bits_of_int, pow2)
  have bp8: bits_add(64, P, 8) = int_add(P, 8) by defs(arith(po, pb), bits_add, bits_of_int, pow2)
  have nlt: int_lt(N, 18446744073709551616) by arith(nb)
  have plt: int_lt(P, 18446744073709551616) by arith(pb)
  have eN: mallocng_specs.mnext(vm, m) = N by defs(simp(bm8, rn, no, nlt), mallocng_specs.mnext, mallocng_specs.rd64, bits_of_int, pow2)
  have eP: mallocng_specs.mprev(vm, m) = P by defs(simp(rp, po, plt), mallocng_specs.mprev, mallocng_specs.rd64, bits_of_int, pow2)
  have nnm: !(N = m) by arith(nm, mo, no)
  have nbits: N in bits(64) by simp(no, nlt)
  have pbits: P in bits(64) by simp(po, plt)
  have p8b: int_add(P, 8) in bits(64) by simp(po, (int_lt(int_add(P, 8), 18446744073709551616) by arith(pb)))
  have m8b: int_add(m, 8) in bits(64) by simp(mo, (int_lt(int_add(m, 8), 18446744073709551616) by arith(mb)))
  have zbits: 0 in bits(64) by simp()

  // the writes: m's neighbours linked, the head moved (m the first), m's links cleared
  let V1 := mallocng_specs.wr64(vm, int_add(P, 8), N)
  let V2 := mallocng_specs.wr64(V1, N, P)
  have e2: mallocng_specs.dq_links(vm, phead, m) = V2 by defs(simp(eN, eP, nnm, bp8), mallocng_specs.dq_links)
  have tb1 := apply(mp.wr64_typed[V := vm, c := int_add(P, 8), v := N], hb)
  have tb2 := apply(mp.wr64_typed[V := V1, c := N, v := P], tb1)
  have v2h: gimple.bytes_at(V2, phead, 8) = l[0] :=
    trans(apply(mp.w64_out[V := V1, c := N, v := P, w := phead], nbits, pho, phl, arith(nb), arith(na, no, pho)),
      trans(apply(mp.w64_out[V := vm, c := int_add(P, 8), v := N, w := phead], p8b, pho, phl, arith(pb), arith(pa, po, pho)), h0))
  have rv2: mallocng_specs.rd64(V2, phead) = l[0] by defs(simp(v2h, zo, (int_lt(l[0], 18446744073709551616) by arith(zb))), mallocng_specs.rd64, bits_of_int, pow2)
  let V3 := mallocng_specs.dq_head(V2, vm, phead, m)
  have c0: k = 0 -> V3 = mallocng_specs.wr64(V2, phead, N) proof
    assume h
    have e0: l[0] = m := rewrite(h, hlk)
    show by defs(simp(eN, nnm, rv2, e0), mallocng_specs.dq_head)
  qed
  have c1: !(k = 0) -> V3 = V2 proof
    assume h
    have a := rewrite(hlk, mp(all_elim(ea, {0}, {k}), simp(), hk, (int_lt(0, L) by arith(h2, lo)), hkl, (!(0 = k) by taut(h))))
    have ne: !(l[0] = m) by arith(a, zo, mo)
    show by defs(simp(rv2, ne), mallocng_specs.dq_head)
  qed
  have tb3: V3.bytes in fn_space(bits(64), bits(8)) proof
    have q0: k = 0 -> V3.bytes in fn_space(bits(64), bits(8)) proof
      assume h
      show := subst({y. y.bytes in fn_space(bits(64), bits(8))}, sym(mp(c0, h)), apply(mp.wr64_typed[V := V2, c := phead, v := N], tb2))
    qed
    have q1: !(k = 0) -> V3.bytes in fn_space(bits(64), bits(8)) proof
      assume h
      show := subst({y. y.bytes in fn_space(bits(64), bits(8))}, sym(mp(c1, h)), tb2)
    qed
    show by taut(q0, q1)
  qed
  // (V3: V2 but for the head word)
  have r3: all w. w in omega -> int_le(int_add(w, 8), 18446744073709551616) -> (int_le(int_add(phead, 8), w) || int_le(int_add(w, 8), phead)) ->
      gimple.bytes_at(V3, w, 8) = gimple.bytes_at(V2, w, 8) proof
    fix w
    assume hw hwl ho
    have q0: k = 0 -> gimple.bytes_at(V3, w, 8) = gimple.bytes_at(V2, w, 8) proof
      assume h
      have o := apply(mp.w64_out[V := V2, c := phead, v := N, w := w], hp, hw, hwl, phl, ho)
      show := subst({y. gimple.bytes_at(y, w, 8) = gimple.bytes_at(V2, w, 8)}, sym(mp(c0, h)), o)
    qed
    have q1: !(k = 0) -> gimple.bytes_at(V3, w, 8) = gimple.bytes_at(V2, w, 8) proof
      assume h
      show := subst({y. gimple.bytes_at(y, w, 8) = gimple.bytes_at(V2, w, 8)}, sym(mp(c1, h)), refl({gimple.bytes_at(V2, w, 8)}))
    qed
    show by taut(q0, q1)
  qed
  have r3b: all x. x in bits(64) -> (int_le(int_add(phead, 8), x) || int_lt(x, phead)) -> V3.bytes[x] = V2.bytes[x] proof
    fix x
    assume hx ho
    have q0: k = 0 -> V3.bytes[x] = V2.bytes[x] proof
      assume h
      have o := apply(mp.wb_out[V := V2, c := phead, v := N, x := x], hx, hp, phl, ho)
      show := subst({y. y.bytes[x] = V2.bytes[x]}, sym(mp(c0, h)), o)
    qed
    have q1: !(k = 0) -> V3.bytes[x] = V2.bytes[x] proof
      assume h
      show := subst({y. y.bytes[x] = V2.bytes[x]}, sym(mp(c1, h)), refl({V2.bytes[x]}))
    qed
    show by taut(q0, q1)
  qed
  have r3h0: k = 0 -> gimple.bytes_at(V3, phead, 8) = N proof
    assume h
    show := subst({y. gimple.bytes_at(y, phead, 8) = N}, sym(mp(c0, h)), apply(mp.rd_at8[vm := V2, c := phead, v := N], tb2, hp, nbits))
  qed
  have r3h1: !(k = 0) -> gimple.bytes_at(V3, phead, 8) = l[0] proof
    assume h
    show := subst({y. gimple.bytes_at(y, phead, 8) = l[0]}, sym(mp(c1, h)), v2h)
  qed
  // only the bytes changed
  have vf: is_fun(vm) by simp(hvm)
  have vd: "bytes" in dom(vm) by simp(hvm)
  have vs := apply(fn_update_same[f := vm, k := "bytes"], vf, vd)
  have fu2 := apply(mp.wr64_only[V := V1, c := N, v := P, W := vm], apply(mp.wr64_only[V := vm, c := int_add(P, 8), v := N, W := vm], vs))
  have fu3: fn_update(V3, "bytes", vm.bytes) = vm proof
    have q0: k = 0 -> fn_update(V3, "bytes", vm.bytes) = vm proof
      assume h
      have f := apply(mp.wr64_only[V := V2, c := phead, v := N, W := vm], fu2)
      show := subst({y. fn_update(y, "bytes", vm.bytes) = vm}, sym(mp(c0, h)), f)
    qed
    have q1: !(k = 0) -> fn_update(V3, "bytes", vm.bytes) = vm proof
      assume h
      show := subst({y. fn_update(y, "bytes", vm.bytes) = vm}, sym(mp(c1, h)), fu2)
    qed
    show by taut(q0, q1)
  qed
  let V4 := mallocng_specs.wr64(V3, int_add(m, 8), 0)
  let V5 := mallocng_specs.wr64(V4, m, 0)
  have e5: mallocng_specs.dequeue_vm(vm, phead, m) = V5 by defs(simp(e2, bm8), mallocng_specs.dequeue_vm)
  have tb4 := apply(mp.wr64_typed[V := V3, c := int_add(m, 8), v := 0], tb3)
  have tb5 := apply(mp.wr64_typed[V := V4, c := m, v := 0], tb4)
  have fu5 := apply(mp.wr64_only[V := V4, c := m, v := 0, W := vm], apply(mp.wr64_only[V := V3, c := int_add(m, 8), v := 0, W := vm], fu3))
  have r5: all w. w in omega -> int_le(int_add(w, 8), 18446744073709551616) -> (int_le(int_add(m, 16), w) || int_le(int_add(w, 8), m)) ->
      gimple.bytes_at(V5, w, 8) = gimple.bytes_at(V3, w, 8) proof
    fix w
    assume hw hwl ho
    show := trans(apply(mp.w64_out[V := V4, c := m, v := 0, w := w], hm, hw, hwl, arith(mb), arith(ho, hw, mo)),
      apply(mp.w64_out[V := V3, c := int_add(m, 8), v := 0, w := w], m8b, hw, hwl, arith(mb), arith(ho, hw, mo)))
  qed
  have z5: gimple.bytes_at(V5, m, 8) = 0 := apply(mp.rd_at8[vm := V4, c := m, v := 0], tb4, hm, zbits)
  have z58: gimple.bytes_at(V5, int_add(m, 8), 8) = 0 :=
    trans(apply(mp.w64_out[V := V4, c := m, v := 0, w := int_add(m, 8)], hm, simp(mo), arith(mb), arith(mb), arith(mo)),
      apply(mp.rd_at8[vm := V3, c := int_add(m, 8), v := 0], tb3, m8b, zbits))
  have q5: mallocng_specs.rd64(V5, m) = 0 by defs(simp(z5), mallocng_specs.rd64, bits_of_int, pow2)
  have q58: mallocng_specs.rd64(V5, bits_add(64, m, 8)) = 0 by defs(simp(bm8, z58), mallocng_specs.rd64, bits_of_int, pow2)

  // the others' links: as before, but for m's neighbours' links to m
  have wn: all i. i in omega -> int_lt(i, L) -> !(i = k) ->
      ((!(i = IP) -> gimple.bytes_at(V5, int_add(l[i], 8), 8) = gimple.bytes_at(vm, int_add(l[i], 8), 8)) &&
       (i = IP -> gimple.bytes_at(V5, int_add(l[i], 8), 8) = N)) &&
      ((!(i = IN) -> gimple.bytes_at(V5, l[i], 8) = gimple.bytes_at(vm, l[i], 8)) &&
       (i = IN -> gimple.bytes_at(V5, l[i], 8) = P)) proof
    fix i
    assume hi hil hik
    have lo2 lb la := mp(all_elim(ef, {i}), hi, hil)
    have am := rewrite(hlk, mp(all_elim(ea, {i}, {k}), hi, hk, hil, hkl, hik))
    have l8o: int_add(l[i], 8) in omega by simp(lo2)
    // through m's links and the head word
    have s1 := trans(mp(all_elim(r5, {int_add(l[i], 8)}), l8o, arith(lb), arith(am, lo2, mo)),
      mp(all_elim(r3, {int_add(l[i], 8)}), l8o, arith(lb), arith(la, lo2, pho)))
    have s2 := trans(mp(all_elim(r5, {l[i]}), lo2, arith(lb), arith(am, lo2, mo)),
      mp(all_elim(r3, {l[i]}), lo2, arith(lb), arith(la, lo2, pho)))
    // l_i: P, or apart from it; N likewise
    have qp: l[i] = P || int_le(int_add(l[i], 16), P) || int_le(int_add(P, 16), l[i]) proof
      have a1: i = IP -> l[i] = P by simp()
      have a2: !(i = IP) -> int_le(int_add(l[i], 16), P) || int_le(int_add(P, 16), l[i]) proof
        assume h
        show := mp(all_elim(ea, {i}, {IP}), hi, ipo, hil, ipl, h)
      qed
      show by taut(a1, a2)
    qed
    have qn: l[i] = N || int_le(int_add(l[i], 16), N) || int_le(int_add(N, 16), l[i]) proof
      have a1: i = IN -> l[i] = N by simp()
      have a2: !(i = IN) -> int_le(int_add(l[i], 16), N) || int_le(int_add(N, 16), l[i]) proof
        assume h
        show := mp(all_elim(ea, {i}, {IN}), hi, ino, hil, inl, h)
      qed
      show by taut(a1, a2)
    qed
    // the next link: through N's prev, then P's next
    have u1 := apply(mp.w64_out[V := V1, c := N, v := P, w := int_add(l[i], 8)], nbits, l8o, arith(lb), arith(nb), arith(qn, lo2, no))
    have n1: !(i = IP) -> gimple.bytes_at(V5, int_add(l[i], 8), 8) = gimple.bytes_at(vm, int_add(l[i], 8), 8) proof
      assume h
      have a := mp(all_elim(ea, {i}, {IP}), hi, ipo, hil, ipl, h)
      show := trans(s1, trans(u1, apply(mp.w64_out[V := vm, c := int_add(P, 8), v := N, w := int_add(l[i], 8)], p8b, l8o, arith(lb), arith(pb), arith(a, lo2, po))))
    qed
    have n2: i = IP -> gimple.bytes_at(V5, int_add(l[i], 8), 8) = N proof
      assume h
      have e: l[i] = P by simp(h)
      have r := subst({y. gimple.bytes_at(V1, int_add(y, 8), 8) = N}, sym(e), apply(mp.rd_at8[vm := vm, c := int_add(P, 8), v := N], hb, p8b, nbits))
      show := trans(s1, trans(u1, r))
    qed
    // the prev link: through N's prev
    have v1 := apply(mp.w64_out[V := vm, c := int_add(P, 8), v := N, w := l[i]], p8b, lo2, arith(lb), arith(pb), arith(qp, lo2, po))
    have p1: !(i = IN) -> gimple.bytes_at(V5, l[i], 8) = gimple.bytes_at(vm, l[i], 8) proof
      assume h
      have a := mp(all_elim(ea, {i}, {IN}), hi, ino, hil, inl, h)
      show := trans(s2, trans(apply(mp.w64_out[V := V1, c := N, v := P, w := l[i]], nbits, lo2, arith(lb), arith(nb), arith(a, lo2, no)), v1))
    qed
    have p2: i = IN -> gimple.bytes_at(V5, l[i], 8) = P proof
      assume h
      have e: l[i] = N by simp(h)
      have r := subst({y. gimple.bytes_at(V2, y, 8) = P}, sym(e), apply(mp.rd_at8[vm := V1, c := N, v := P], tb1, nbits, pbits))
      show := trans(s2, r)
    qed
    show by taut(n1, n2, p1, p2)
  qed

  // the list without m
  let R := mallocng_specs.rm_at(l, k)
  have {dl2 = len, rl = type} := apply(mp.rm_at_app[l := l, k := k, j := 0], hl, hk, hkl)
  have wo: all p. all off. mallocng_specs.word_ok(V5, objs, p, off) = mallocng_specs.word_ok(vm, objs, p, off) proof
    fix p off
    have f := all_elim(ms.f_word_ok, {V5}, {vm.bytes}, {objs}, {p}, {off})
    show := sym(rewrite(fu5, f))
  qed
  // R's j-th: l's G-th (G = j below k, j + 1 from k on), not m
  have gi: all j. j in omega -> int_lt(j, int_sub(L, 1)) ->
      (nat: ite(int_lt(j, k), j, int_add(j, 1)) in omega && below: int_lt(ite(int_lt(j, k), j, int_add(j, 1)), L)) &&
      not_k: !(ite(int_lt(j, k), j, int_add(j, 1)) = k) && elem: R[j] = l[ite(int_lt(j, k), j, int_add(j, 1))] proof
    fix j
    assume hj hjl
    have {ra = elem} := apply(mp.rm_at_app[l := l, k := k, j := j], hl, hk, hkl)
    have rj := mp(ra, hj, hjl)
    have a1: int_lt(j, k) -> (ite(int_lt(j, k), j, int_add(j, 1)) in omega && int_lt(ite(int_lt(j, k), j, int_add(j, 1)), L)) &&
        !(ite(int_lt(j, k), j, int_add(j, 1)) = k) proof
      assume h
      have jl: int_lt(j, L) by arith(hj, hjl, lo)
      have jk: !(j = k) by arith(h, hj, hk)
      have kj: !(k = j) by arith(h, hj, hk)
      show by simp(h, hj, jl, jk, kj)
    qed
    have a2: !int_lt(j, k) -> (ite(int_lt(j, k), j, int_add(j, 1)) in omega && int_lt(ite(int_lt(j, k), j, int_add(j, 1)), L)) &&
        !(ite(int_lt(j, k), j, int_add(j, 1)) = k) proof
      assume h
      have j1o: int_add(j, 1) in omega by simp(hj)
      have jl: int_lt(int_add(j, 1), L) by arith(hj, hjl, lo)
      have jk: !(int_add(j, 1) = k) by arith(h, hj, hk)
      have kj: !(k = int_add(j, 1)) by arith(h, hj, hk)
      show by simp(h, j1o, jl, jk, kj)
    qed
    show by taut(a1, a2, rj)
  qed
  have el5: all x0. x0 in omega -> int_lt(x0, seq_len(R)) ->
      ((((int_le(int_add(R[x0], 16), int_pow(2, 64)) && mallocng_specs.word_ok(V5, objs, bits_of_int(64, R[x0]), 0)) &&
        mallocng_specs.word_ok(V5, objs, bits_of_int(64, R[x0]), 8)) && int_mod(R[x0], 8) = 0) &&
       (int_le(int_add(phead, 8), R[x0]) || int_le(int_add(R[x0], 16), phead))) proof
    fix x0
    assume hx hxl
    have {go = nat, gl = below, ge = elem} := mp(all_elim(gi, {x0}), hx, simp(hxl, dl2))
    have e := mp(all_elim(el, {ite(int_lt(x0, k), x0, int_add(x0, 1))}), go, gl)
    have w0 := all_elim(wo, {bits_of_int(64, l[ite(int_lt(x0, k), x0, int_add(x0, 1))])}, {0})
    have w8 := all_elim(wo, {bits_of_int(64, l[ite(int_lt(x0, k), x0, int_add(x0, 1))])}, {8})
    show by simp(ge, w0, w8, e)
  qed
  have ap5: all x0. all x1. x0 in omega && x1 in omega -> (int_lt(x0, seq_len(R)) && int_lt(x1, seq_len(R))) && !(x0 = x1) ->
      int_le(int_add(R[x0], 16), R[x1]) || int_le(int_add(R[x1], 16), R[x0]) proof
    fix x0 x1
    assume ho hq
    have x0o: x0 in omega by taut(ho)
    have x1o: x1 in omega by taut(ho)
    have x0l: int_lt(x0, int_sub(L, 1)) by simp(hq, dl2)
    have x1l: int_lt(x1, int_sub(L, 1)) by simp(hq, dl2)
    have ne: !(x0 = x1) by taut(hq)
    have {g0o = nat, g0l = below, g0e = elem} := mp(all_elim(gi, {x0}), x0o, x0l)
    have {g1o = nat, g1l = below, g1e = elem} := mp(all_elim(gi, {x1}), x1o, x1l)
    // G is one-to-one
    have gne: !(ite(int_lt(x0, k), x0, int_add(x0, 1)) = ite(int_lt(x1, k), x1, int_add(x1, 1))) proof
      have c00: int_lt(x0, k) -> int_lt(x1, k) -> !(ite(int_lt(x0, k), x0, int_add(x0, 1)) = ite(int_lt(x1, k), x1, int_add(x1, 1))) proof
        assume a b
        show by simp(a, b, ne)
      qed
      have c01: int_lt(x0, k) -> !int_lt(x1, k) -> !(ite(int_lt(x0, k), x0, int_add(x0, 1)) = ite(int_lt(x1, k), x1, int_add(x1, 1))) proof
        assume a b
        have d: !(x0 = int_add(x1, 1)) by arith(a, b, x0o, x1o)
        show by simp(a, b, d)
      qed
      have c10: !int_lt(x0, k) -> int_lt(x1, k) -> !(ite(int_lt(x0, k), x0, int_add(x0, 1)) = ite(int_lt(x1, k), x1, int_add(x1, 1))) proof
        assume a b
        have d: !(int_add(x0, 1) = x1) by arith(a, b, x0o, x1o)
        show by simp(a, b, d)
      qed
      have c11: !int_lt(x0, k) -> !int_lt(x1, k) -> !(ite(int_lt(x0, k), x0, int_add(x0, 1)) = ite(int_lt(x1, k), x1, int_add(x1, 1))) proof
        assume a b
        have d: !(int_add(x0, 1) = int_add(x1, 1)) by arith(ne, x0o, x1o)
        show by simp(a, b, d)
      qed
      show by taut(c00, c01, c10, c11)
    qed
    have a := mp(all_elim(ea, {ite(int_lt(x0, k), x0, int_add(x0, 1))}, {ite(int_lt(x1, k), x1, int_add(x1, 1))}), g0o, g1o, g0l, g1l, gne)
    show by simp(g0e, g1e, a)
  qed
  // the head word: R's first (l's second if m was the first)
  have hd5: gimple.bytes_at(V5, phead, 8) = ite(seq_len(R) = 0, 0, R[0]) proof
    have s := trans(mp(all_elim(r5, {phead}), pho, phl, arith(ma, pho, mo)), refl({gimple.bytes_at(V3, phead, 8)}))
    have nz: !(seq_len(R) = 0) by arith(dl2, h2)
    have {r0 = elem} := mp(all_elim(gi, {0}), simp(), (int_lt(0, int_sub(L, 1)) by arith(h2, lo)))
    have q0: k = 0 -> gimple.bytes_at(V5, phead, 8) = ite(seq_len(R) = 0, 0, R[0]) proof
      assume h
      have i1 := mp(in0, h)
      have a: R[0] = N by simp(r0, h, i1)
      show by simp(s, mp(r3h0, h), nz, a)
    qed
    have q1: !(k = 0) -> gimple.bytes_at(V5, phead, 8) = ite(seq_len(R) = 0, 0, R[0]) proof
      assume h
      have kp: int_lt(0, k) by arith(h, hk)
      have a: R[0] = l[0] by simp(r0, kp)
      show by simp(s, mp(r3h1, h), nz, a)
    qed
    show by taut(q0, q1)
  qed
  // the links: l's, but around m
  have ws5: all i. i in omega -> int_lt(i, seq_len(R)) ->
      gimple.bytes_at(V5, int_add(R[i], 8), 8) = R[int_mod(int_add(i, 1), seq_len(R))] &&
      gimple.bytes_at(V5, R[i], 8) = R[int_mod(int_sub(int_add(i, seq_len(R)), 1), seq_len(R))] proof
    fix j
    assume hj hjl0
    have hjl: int_lt(j, int_sub(L, 1)) by simp(hjl0, dl2)
    let G := ite(int_lt(j, k), j, int_add(j, 1))
    have go gl gk ge := mp(all_elim(gi, {j}), hj, hjl)
    have wl0 wl1 := apply(mp.rm_next[L := L, k := k, j := j], lo, hk, hj, h2, hkl, hjl)
    have wp0 wp1 := apply(mp.rm_prev[L := L, k := k, j := j], lo, hk, hj, h2, hkl, hjl)
    let J1 := int_mod(int_add(j, 1), int_sub(L, 1))
    let J2 := int_mod(int_sub(int_add(j, int_sub(L, 1)), 1), int_sub(L, 1))
    have j1o: J1 in omega by arith(lo, h2, hj)
    have j1l: int_lt(J1, int_sub(L, 1)) by arith(lo, h2, hj)
    have j2o: J2 in omega by arith(lo, h2, hj)
    have j2l: int_lt(J2, int_sub(L, 1)) by arith(lo, h2, hj)
    have {r1 = elem} := mp(all_elim(gi, {J1}), j1o, j1l)
    have {r2 = elem} := mp(all_elim(gi, {J2}), j2o, j2l)
    have {lw = links} := apply(mp.list_rd[vm := vm, objs := objs, phead := phead, l := l, i := G], hb, hp, hl, H)
    have ln lp := mp(lw, go, gl)
    have wg := mp(all_elim(wn, {G}), go, gl, gk)
    have wa wb wc wd := wg
    // the next link
    have nx0: !(G = IP) -> gimple.bytes_at(V5, int_add(l[G], 8), 8) = R[J1] proof
      assume h
      show by simp(r1, mp(wl0, h), mp(wa, h), ln)
    qed
    have nx1: G = IP -> gimple.bytes_at(V5, int_add(l[G], 8), 8) = R[J1] proof
      assume h
      show by simp(r1, mp(wl1, h), mp(wb, h))
    qed
    // the prev link
    have pv0: !(G = IN) -> gimple.bytes_at(V5, l[G], 8) = R[J2] proof
      assume h
      show by simp(r2, mp(wp0, h), mp(wc, h), lp)
    qed
    have pv1: G = IN -> gimple.bytes_at(V5, l[G], 8) = R[J2] proof
      assume h
      show by simp(r2, mp(wp1, h), mp(wd, h))
    qed
    have nx: gimple.bytes_at(V5, int_add(l[G], 8), 8) = R[J1] by taut(nx0, nx1)
    have pv: gimple.bytes_at(V5, l[G], 8) = R[J2] by taut(pv0, pv1)
    show by simp(ge, dl2, nx, pv)
  qed
  have hal5: mallocng_specs.al8(phead) := hal
  have hok5: mallocng_specs.word_ok(V5, objs, phead, 0) by simp(all_elim(wo, {phead}, {0}), hok)
  have la := apply(mp.list_mk[vm := V5, objs := objs, phead := phead, l := R], tb5, hp, rl, hok5, hal5, el5, ap5, hd5, ws5)

  // no byte but the links and the head word written
  have lo5: all x0. x0 in omega -> (int_lt(x0, int_pow(2, 64)) && !(int_le(phead, x0) && int_lt(x0, int_add(phead, 8)))) &&
      (all x1. x1 in omega -> int_lt(x1, L) -> !(int_le(l[x1], x0) && int_lt(x0, int_add(l[x1], 16)))) ->
      V5.bytes[bits_of_int(64, x0)] = vm.bytes[bits_of_int(64, x0)] proof
    fix x0
    assume hx hq
    have xl: int_lt(x0, 18446744073709551616) by arith(hq)
    have xp: !(int_le(phead, x0) && int_lt(x0, int_add(phead, 8))) by taut(hq)
    have xa: all x1. x1 in omega -> int_lt(x1, L) -> !(int_le(l[x1], x0) && int_lt(x0, int_add(l[x1], 16))) by taut(hq)
    have xb: x0 in bits(64) by simp(hx, xl)
    have bx: bits_of_int(64, x0) = x0 by defs(simp(hx, xl), bits_of_int, pow2)
    have om := rewrite(hlk, mp(all_elim(xa, {k}), hk, hkl))
    have op := mp(all_elim(xa, {IP}), ipo, ipl)
    have on := mp(all_elim(xa, {IN}), ino, inl)
    have b5 := apply(mp.wb_out[V := V4, c := m, v := 0, x := x0], xb, hm, arith(mb), arith(om, hx, mo))
    have b4 := apply(mp.wb_out[V := V3, c := int_add(m, 8), v := 0, x := x0], xb, m8b, arith(mb), arith(om, hx, mo))
    have b3 := mp(all_elim(r3b, {x0}), xb, arith(xp, hx, pho))
    have b2 := apply(mp.wb_out[V := V1, c := N, v := P, x := x0], xb, nbits, arith(nb), arith(on, hx, no))
    have b1 := apply(mp.wb_out[V := vm, c := int_add(P, 8), v := N, x := x0], xb, p8b, arith(pb), arith(op, hx, po))
    show by simp(bx, trans(b5, trans(b4, trans(b3, trans(b2, b1)))))
  qed
  have lk: mallocng_specs.links_only(vm, V5, phead, l) by defs(taut(fu5, lo5), mallocng_specs.links_only)
  have all5: ((mallocng_specs.list_at(V5, objs, phead, R) && mallocng_specs.rd64(V5, m) = 0) && mallocng_specs.rd64(V5, bits_add(64, m, 8)) = 0) &&
    mallocng_specs.links_only(vm, V5, phead, l) by taut(la, q5, q58, lk)
  show := subst({y. ((mallocng_specs.list_at(y, objs, phead, R) && mallocng_specs.rd64(y, m) = 0) && mallocng_specs.rd64(y, bits_add(64, m, 8)) = 0) &&
    mallocng_specs.links_only(vm, y, phead, l)}, sym(e5), all5)
qed

// m in the list at *phead: dequeue's precondition holds (the words it
// writes usable, aligned, apart); m is its own successor just when alone
theorem mp.dq_pre(vm, objs, phead, m, l, k): vm.bytes in fn_space(bits(64), bits(8)) -> phead in bits(64) -> m in bits(64) ->
  l in list_type(omega) -> k in omega -> int_lt(k, seq_len(l)) -> l[k] = m -> mallocng_specs.list_at(vm, objs, phead, l) ->
  pre: mallocng_specs.dequeue_pre(vm, objs, phead, m) && alone: (seq_len(l) = 1 <-> mallocng_specs.mnext(vm, m) = m)
proof
  assume hb hp hm hl hk hkl hlk H
  let L := seq_len(l)
  let IP := int_mod(int_sub(int_add(k, L), 1), L)
  let IN := int_mod(int_add(k, 1), L)
  let P := l[IP]
  let N := l[IN]
  have {hok = head, hal = head_al, el = elems, ap = apart} := expand(H, mallocng_specs.list_at)
  have lo: L in omega by arith(hl)
  have mo: m in omega by simp(hm)
  have pho: phead in omega by simp(hp)
  have mb0 mw0 mw8 mm ma := rewrite(hlk, mp(all_elim(el, {k}), hk, hkl))
  have bm: bits_of_int(64, m) = m by defs(simp(hm), bits_of_int, pow2)
  have mwa := rewrite(bm, mw0)
  have mwb := rewrite(bm, mw8)
  have bm8: bits_add(64, m, 8) = int_add(m, 8) by defs(arith(mo, mb0), bits_add, bits_of_int, pow2)
  have {ws0 = links} := apply(mp.list_rd[vm := vm, objs := objs, phead := phead, l := l, i := k], hb, hp, hl, H)
  have rn0 rp0 := mp(ws0, hk, hkl)
  have rn := rewrite(hlk, rn0)
  have rp := rewrite(hlk, rp0)
  have ino: IN in omega by arith(hk, lo, hkl)
  have inl: int_lt(IN, L) by arith(hk, lo, hkl)
  have no := apply(at_type[l := l, t := omega, i := IN], hl, ino, inl)
  have {nb = bound, nw0 = prev_ok, nm = al, na = off_head} := mp(all_elim(el, {IN}), ino, inl)
  have nlt: int_lt(N, 18446744073709551616) by arith(nb)
  have eN: mallocng_specs.mnext(vm, m) = N by defs(simp(bm8, rn, no, nlt), mallocng_specs.mnext, mallocng_specs.rd64, bits_of_int, pow2)
  have al8m: mallocng_specs.al8(m) by defs(mm, mallocng_specs.al8)
  have pm1: !(phead = m) by arith(ma, mo, pho)
  have pm2: !(phead = int_add(m, 8)) by arith(ma, mo, pho)
  // alone: its own successor
  have a1: L = 1 -> mallocng_specs.mnext(vm, m) = m proof
    assume h
    have k0: k = 0 by arith(h, hk, hkl, lo)
    have i0: IN = 0 by arith(h, hk, lo)
    have e: N = m by simp(i0, rewrite(k0, hlk))
    show := trans(eN, e)
  qed
  // with others: its neighbours' links apart from its own and the head word
  have a2: !(L = 1) -> !(mallocng_specs.mnext(vm, m) = m) &&
      ((((((((mallocng_specs.word_ok(vm, objs, mallocng_specs.mprev(vm, m), 8) && mallocng_specs.word_ok(vm, objs, mallocng_specs.mnext(vm, m), 0)) &&
        mallocng_specs.al8(mallocng_specs.mprev(vm, m))) && mallocng_specs.al8(mallocng_specs.mnext(vm, m))) && !(mallocng_specs.mprev(vm, m) = m)) &&
        !(int_add(mallocng_specs.mprev(vm, m), 8) = m)) && !(mallocng_specs.mnext(vm, m) = int_add(m, 8))) && !(int_add(mallocng_specs.mprev(vm, m), 8) = phead)) &&
        !(mallocng_specs.mnext(vm, m) = phead)) && !(int_add(mallocng_specs.mprev(vm, m), 8) = mallocng_specs.mnext(vm, m)) proof
    assume h
    have h2: int_le(2, L) by arith(h, hk, hkl, lo)
    have {ipk = pred_ne, ink = succ_ne} := apply(mp.nb_idx[L := L, k := k], lo, hk, h2, hkl)
    have ipo: IP in omega by arith(hk, lo, h2)
    have ipl: int_lt(IP, L) by arith(hk, lo, h2)
    have po := apply(at_type[l := l, t := omega, i := IP], hl, ipo, ipl)
    have {pb = bound, pw8 = next_ok, pm = al, pa = off_head} := mp(all_elim(el, {IP}), ipo, ipl)
    have plt: int_lt(P, 18446744073709551616) by arith(pb)
    have eP: mallocng_specs.mprev(vm, m) = P by defs(simp(rp, po, plt), mallocng_specs.mprev, mallocng_specs.rd64, bits_of_int, pow2)
    have bp: bits_of_int(64, P) = P by defs(simp(po, plt), bits_of_int, pow2)
    have bn: bits_of_int(64, N) = N by defs(simp(no, nlt), bits_of_int, pow2)
    have pw := rewrite(bp, pw8)
    have nw := rewrite(bn, nw0)
    have pmd := rewrite(hlk, mp(all_elim(ap, {IP}, {k}), taut(ipo, hk), taut(ipl, hkl, ipk)))
    have nmd := rewrite(hlk, mp(all_elim(ap, {IN}, {k}), taut(ino, hk), taut(inl, hkl, ink)))
    // P and N: the same element, or apart
    have qpn: P = N || int_le(int_add(P, 16), N) || int_le(int_add(N, 16), P) proof
      have b1: IP = IN -> P = N by simp()
      have b2: !(IP = IN) -> int_le(int_add(P, 16), N) || int_le(int_add(N, 16), P) proof
        assume hne
        show := mp(all_elim(ap, {IP}, {IN}), taut(ipo, ino), taut(ipl, inl, hne))
      qed
      show by taut(b1, b2)
    qed
    have f1: mallocng_specs.al8(P) by defs(pm, mallocng_specs.al8)
    have f2: mallocng_specs.al8(N) by defs(nm, mallocng_specs.al8)
    have f3: !(P = m) by arith(pmd, po, mo)
    have f4: !(int_add(P, 8) = m) by arith(pmd, po, mo)
    have f5: !(N = int_add(m, 8)) by arith(nmd, no, mo)
    have f6: !(int_add(P, 8) = phead) by arith(pa, po, pho)
    have f7: !(N = phead) by arith(na, no, pho)
    have f8: !(int_add(P, 8) = N) by arith(qpn, po, no)
    have f9: !(N = m) by arith(nmd, no, mo)
    show by simp(eN, eP, pw, nw, f1, f2, f3, f4, f5, f6, f7, f8, f9)
  qed
  have tl: !(mallocng_specs.mnext(vm, m) = m) ->
      ((((((((mallocng_specs.word_ok(vm, objs, mallocng_specs.mprev(vm, m), 8) && mallocng_specs.word_ok(vm, objs, mallocng_specs.mnext(vm, m), 0)) &&
        mallocng_specs.al8(mallocng_specs.mprev(vm, m))) && mallocng_specs.al8(mallocng_specs.mnext(vm, m))) && !(mallocng_specs.mprev(vm, m) = m)) &&
        !(int_add(mallocng_specs.mprev(vm, m), 8) = m)) && !(mallocng_specs.mnext(vm, m) = int_add(m, 8))) && !(int_add(mallocng_specs.mprev(vm, m), 8) = phead)) &&
        !(mallocng_specs.mnext(vm, m) = phead)) && !(int_add(mallocng_specs.mprev(vm, m), 8) = mallocng_specs.mnext(vm, m)) by taut(a1, a2)
  have dp: mallocng_specs.dequeue_pre(vm, objs, phead, m) by defs(taut(hok, mwa, mwb, hal, al8m, pm1, pm2, tl), mallocng_specs.dequeue_pre)
  have io: seq_len(l) = 1 <-> mallocng_specs.mnext(vm, m) = m by taut(a1, a2)
  show by taut(dp, io)
qed

// dequeue's effect on the list at *phead holding only m: the list empty,
// m's links cleared, nothing else written
theorem mp.dq_list1(vm, objs, phead, m, l, k): vm in x86_64_linux.Vm -> vm.bytes in fn_space(bits(64), bits(8)) -> phead in bits(64) -> m in bits(64) ->
  l in list_type(omega) -> k in omega -> int_lt(k, seq_len(l)) -> seq_len(l) = 1 -> l[k] = m ->
  mallocng_specs.list_at(vm, objs, phead, l) ->
  ((mallocng_specs.list_at(mallocng_specs.dequeue_vm(vm, phead, m), objs, phead, mallocng_specs.rm_at(l, k)) &&
     mallocng_specs.rd64(mallocng_specs.dequeue_vm(vm, phead, m), m) = 0) && mallocng_specs.rd64(mallocng_specs.dequeue_vm(vm, phead, m), bits_add(64, m, 8)) = 0) &&
  mallocng_specs.links_only(vm, mallocng_specs.dequeue_vm(vm, phead, m), phead, l)
proof
  assume hvm hb hp hm hl hk hkl h1 hlk H
  let L := seq_len(l)
  let N := mallocng_specs.mnext(vm, m)
  have {hok = head, hal = head_al, el = elems, ap = apart} := expand(H, mallocng_specs.list_at)
  have lo: L in omega by arith(hl)
  have mo: m in omega by simp(hm)
  have pho: phead in omega by simp(hp)
  have {phl0 = bound} := expand(hok, mallocng_specs.word_ok)
  have phl: int_le(int_add(phead, 8), 18446744073709551616) by arith(phl0, pho)
  have {mb0 = bound, ma = off_head} := rewrite(hlk, mp(all_elim(el, {k}), hk, hkl))
  have mb: int_le(int_add(m, 16), 18446744073709551616) by arith(mb0)
  have bm8: bits_add(64, m, 8) = int_add(m, 8) by defs(arith(mo, mb), bits_add, bits_of_int, pow2)
  have m8b: int_add(m, 8) in bits(64) by simp(mo, (int_lt(int_add(m, 8), 18446744073709551616) by arith(mb)))
  have zbits: 0 in bits(64) by simp()
  have {io = alone} := apply(mp.dq_pre[vm := vm, objs := objs, phead := phead, m := m, l := l, k := k], hb, hp, hm, hl, hk, hkl, hlk, H)
  have nm: N = m by taut(io, h1)
  // dequeue_vm of m alone: the head word cleared, then m's links
  have nn: !!(N = m) by taut(nm)
  have nc: !(!(N = m) && mallocng_specs.rd64(mallocng_specs.wr64(vm, phead, 0), phead) = m) by taut(nn)
  have dl: mallocng_specs.dq_links(vm, phead, m) = mallocng_specs.wr64(vm, phead, 0)
    by defs(mp(tr.ite_f[c := !(N = m), a := mallocng_specs.wr64(mallocng_specs.wr64(vm, bits_add(64, mallocng_specs.mprev(vm, m), 8), N), N, mallocng_specs.mprev(vm, m)),
      b := mallocng_specs.wr64(vm, phead, 0)], nn), mallocng_specs.dq_links)
  have dh: mallocng_specs.dq_head(mallocng_specs.wr64(vm, phead, 0), vm, phead, m) = mallocng_specs.wr64(vm, phead, 0)
    by defs(mp(tr.ite_f[c := !(N = m) && mallocng_specs.rd64(mallocng_specs.wr64(vm, phead, 0), phead) = m, a := mallocng_specs.wr64(mallocng_specs.wr64(vm, phead, 0), phead, N),
      b := mallocng_specs.wr64(vm, phead, 0)], nc), mallocng_specs.dq_head)
  let V1 := mallocng_specs.wr64(vm, phead, 0)
  let V2 := mallocng_specs.wr64(V1, int_add(m, 8), 0)
  let V3 := mallocng_specs.wr64(V2, m, 0)
  have d0: mallocng_specs.dequeue_vm(vm, phead, m) = mallocng_specs.wr64(mallocng_specs.wr64(mallocng_specs.dq_head(mallocng_specs.dq_links(vm, phead, m), vm, phead, m), bits_add(64, m, 8), 0), m, 0)
    by defs(refl({mallocng_specs.wr64(mallocng_specs.wr64(mallocng_specs.dq_head(mallocng_specs.dq_links(vm, phead, m), vm, phead, m), bits_add(64, m, 8), 0), m, 0)}), mallocng_specs.dequeue_vm)
  have e3: mallocng_specs.dequeue_vm(vm, phead, m) = V3 := rewrite(bm8, rewrite(dh, rewrite(dl, d0)))
  have tb1 := apply(mp.wr64_typed[V := vm, c := phead, v := 0], hb)
  have tb2 := apply(mp.wr64_typed[V := V1, c := int_add(m, 8), v := 0], tb1)
  have tb3 := apply(mp.wr64_typed[V := V2, c := m, v := 0], tb2)
  have vf: is_fun(vm) by simp(hvm)
  have vd: "bytes" in dom(vm) by simp(hvm)
  have vs := apply(fn_update_same[f := vm, k := "bytes"], vf, vd)
  have fu3 := apply(mp.wr64_only[V := V2, c := m, v := 0, W := vm], apply(mp.wr64_only[V := V1, c := int_add(m, 8), v := 0, W := vm],
    apply(mp.wr64_only[V := vm, c := phead, v := 0, W := vm], vs)))
  // the words: all three cleared
  have hd: gimple.bytes_at(V3, phead, 8) = 0 :=
    trans(apply(mp.w64_out[V := V2, c := m, v := 0, w := phead], hm, pho, phl, arith(mb), arith(ma, mo, pho)),
      trans(apply(mp.w64_out[V := V1, c := int_add(m, 8), v := 0, w := phead], m8b, pho, phl, arith(mb), arith(ma, mo, pho)),
        apply(mp.rd_at8[vm := vm, c := phead, v := 0], hb, hp, zbits)))
  have z0: gimple.bytes_at(V3, m, 8) = 0 := apply(mp.rd_at8[vm := V2, c := m, v := 0], tb2, hm, zbits)
  have z8: gimple.bytes_at(V3, int_add(m, 8), 8) = 0 :=
    trans(apply(mp.w64_out[V := V2, c := m, v := 0, w := int_add(m, 8)], hm, simp(mo), arith(mb), arith(mb), arith(mo)),
      apply(mp.rd_at8[vm := V1, c := int_add(m, 8), v := 0], tb1, m8b, zbits))
  have q0: mallocng_specs.rd64(V3, m) = 0 by defs(simp(z0), mallocng_specs.rd64, bits_of_int, pow2)
  have q8: mallocng_specs.rd64(V3, bits_add(64, m, 8)) = 0 by defs(simp(bm8, z8), mallocng_specs.rd64, bits_of_int, pow2)
  // the list: empty
  let R := mallocng_specs.rm_at(l, k)
  have {dl2 = len, rl = type} := apply(mp.rm_at_app[l := l, k := k, j := 0], hl, hk, hkl)
  have r0: seq_len(R) = 0 by arith(dl2, h1)
  have wo: all p. all off. mallocng_specs.word_ok(V3, objs, p, off) = mallocng_specs.word_ok(vm, objs, p, off) proof
    fix p off
    have f := all_elim(ms.f_word_ok, {V3}, {vm.bytes}, {objs}, {p}, {off})
    show := sym(rewrite(fu3, f))
  qed
  have hok3: mallocng_specs.word_ok(V3, objs, phead, 0) by simp(all_elim(wo, {phead}, {0}), hok)
  have el3: all x0. x0 in omega -> int_lt(x0, seq_len(R)) ->
      ((((int_le(int_add(R[x0], 16), int_pow(2, 64)) && mallocng_specs.word_ok(V3, objs, bits_of_int(64, R[x0]), 0)) &&
        mallocng_specs.word_ok(V3, objs, bits_of_int(64, R[x0]), 8)) && int_mod(R[x0], 8) = 0) &&
       (int_le(int_add(phead, 8), R[x0]) || int_le(int_add(R[x0], 16), phead))) proof
    fix x0
    assume hx hxl
    have f: false by arith(hx, hxl, r0)
    show by taut(f)
  qed
  have ap3: all x0. all x1. x0 in omega && x1 in omega -> (int_lt(x0, seq_len(R)) && int_lt(x1, seq_len(R))) && !(x0 = x1) ->
      int_le(int_add(R[x0], 16), R[x1]) || int_le(int_add(R[x1], 16), R[x0]) proof
    fix x0 x1
    assume ho hq
    have x0o: x0 in omega by taut(ho)
    have x0l: int_lt(x0, seq_len(R)) by taut(hq)
    have f: false by arith(x0o, x0l, r0)
    show by taut(f)
  qed
  have hd3: gimple.bytes_at(V3, phead, 8) = ite(seq_len(R) = 0, 0, R[0]) by simp(hd, r0)
  have ws3: all i. i in omega -> int_lt(i, seq_len(R)) ->
      gimple.bytes_at(V3, int_add(R[i], 8), 8) = R[int_mod(int_add(i, 1), seq_len(R))] &&
      gimple.bytes_at(V3, R[i], 8) = R[int_mod(int_sub(int_add(i, seq_len(R)), 1), seq_len(R))] proof
    fix i
    assume hi hil
    have f: false by arith(hi, hil, r0)
    show by taut(f)
  qed
  have la := apply(mp.list_mk[vm := V3, objs := objs, phead := phead, l := R], tb3, hp, rl, hok3, hal, el3, ap3, hd3, ws3)
  // no byte but the head word and m's links written
  have lo3: all x0. x0 in omega -> (int_lt(x0, int_pow(2, 64)) && !(int_le(phead, x0) && int_lt(x0, int_add(phead, 8)))) &&
      (all x1. x1 in omega -> int_lt(x1, L) -> !(int_le(l[x1], x0) && int_lt(x0, int_add(l[x1], 16)))) ->
      V3.bytes[bits_of_int(64, x0)] = vm.bytes[bits_of_int(64, x0)] proof
    fix x0
    assume hx hq
    have xl: int_lt(x0, 18446744073709551616) by arith(hq)
    have xp: !(int_le(phead, x0) && int_lt(x0, int_add(phead, 8))) by taut(hq)
    have xa: all x1. x1 in omega -> int_lt(x1, L) -> !(int_le(l[x1], x0) && int_lt(x0, int_add(l[x1], 16))) by taut(hq)
    have xb: x0 in bits(64) by simp(hx, xl)
    have bx: bits_of_int(64, x0) = x0 by defs(simp(hx, xl), bits_of_int, pow2)
    have om := rewrite(hlk, mp(all_elim(xa, {k}), hk, hkl))
    have b3 := apply(mp.wb_out[V := V2, c := m, v := 0, x := x0], xb, hm, arith(mb), arith(om, hx, mo))
    have b2 := apply(mp.wb_out[V := V1, c := int_add(m, 8), v := 0, x := x0], xb, m8b, arith(mb), arith(om, hx, mo))
    have b1 := apply(mp.wb_out[V := vm, c := phead, v := 0, x := x0], xb, hp, phl, arith(xp, hx, pho))
    show by simp(bx, trans(b3, trans(b2, b1)))
  qed
  have lk: mallocng_specs.links_only(vm, V3, phead, l) by defs(taut(fu3, lo3), mallocng_specs.links_only)
  have all3: ((mallocng_specs.list_at(V3, objs, phead, R) && mallocng_specs.rd64(V3, m) = 0) && mallocng_specs.rd64(V3, bits_add(64, m, 8)) = 0) &&
    mallocng_specs.links_only(vm, V3, phead, l) by taut(la, q0, q8, lk)
  show := subst({y. ((mallocng_specs.list_at(y, objs, phead, R) && mallocng_specs.rd64(y, m) = 0) && mallocng_specs.rd64(y, bits_add(64, m, 8)) = 0) &&
    mallocng_specs.links_only(vm, y, phead, l)}, sym(e3), all3)
qed

// dequeue's effect is what it is for: for any list at *phead holding m
theorem mp.dq_done(vm, objs, phead, m): vm in x86_64_linux.Vm -> vm.bytes in fn_space(bits(64), bits(8)) -> phead in bits(64) -> m in bits(64) ->
  mallocng_specs.dequeued(vm, mallocng_specs.dequeue_vm(vm, phead, m), objs, phead, m)
proof
  assume hvm hb hp hm
  have a: all x0. all x1. x0 in list_type(omega) && x1 in omega -> (mallocng_specs.list_at(vm, objs, phead, x0) && int_lt(x1, seq_len(x0))) && x0[x1] = m ->
      ((mallocng_specs.list_at(mallocng_specs.dequeue_vm(vm, phead, m), objs, phead, mallocng_specs.rm_at(x0, x1)) &&
        mallocng_specs.rd64(mallocng_specs.dequeue_vm(vm, phead, m), m) = 0) && mallocng_specs.rd64(mallocng_specs.dequeue_vm(vm, phead, m), bits_add(64, m, 8)) = 0) &&
      mallocng_specs.links_only(vm, mallocng_specs.dequeue_vm(vm, phead, m), phead, x0) proof
    fix l k
    assume ht hq
    have hl: l in list_type(omega) by taut(ht)
    have hk: k in omega by taut(ht)
    have H: mallocng_specs.list_at(vm, objs, phead, l) by taut(hq)
    have hkl: int_lt(k, seq_len(l)) by taut(hq)
    have hlk: l[k] = m by taut(hq)
    have lo: seq_len(l) in omega by arith(hl)
    have c1: seq_len(l) = 1 -> ((mallocng_specs.list_at(mallocng_specs.dequeue_vm(vm, phead, m), objs, phead, mallocng_specs.rm_at(l, k)) &&
        mallocng_specs.rd64(mallocng_specs.dequeue_vm(vm, phead, m), m) = 0) && mallocng_specs.rd64(mallocng_specs.dequeue_vm(vm, phead, m), bits_add(64, m, 8)) = 0) &&
        mallocng_specs.links_only(vm, mallocng_specs.dequeue_vm(vm, phead, m), phead, l) proof
      assume h
      show := apply(mp.dq_list1[vm := vm, objs := objs, phead := phead, m := m, l := l, k := k], hvm, hb, hp, hm, hl, hk, hkl, h, hlk, H)
    qed
    have c2: !(seq_len(l) = 1) -> ((mallocng_specs.list_at(mallocng_specs.dequeue_vm(vm, phead, m), objs, phead, mallocng_specs.rm_at(l, k)) &&
        mallocng_specs.rd64(mallocng_specs.dequeue_vm(vm, phead, m), m) = 0) && mallocng_specs.rd64(mallocng_specs.dequeue_vm(vm, phead, m), bits_add(64, m, 8)) = 0) &&
        mallocng_specs.links_only(vm, mallocng_specs.dequeue_vm(vm, phead, m), phead, l) proof
      assume h
      have h2: int_le(2, seq_len(l)) by arith(h, hk, hkl, lo)
      show := apply(mp.dq_list2[vm := vm, objs := objs, phead := phead, m := m, l := l, k := k], hvm, hb, hp, hm, hl, hk, hkl, h2, hlk, H)
    qed
    show by taut(c1, c2)
  qed
  show by defs(a, mallocng_specs.dequeued)
qed

// ----------------------------------------------------------------------
//  queue's effect on a list: m appended (`l ++ [m]`); free_meta's: m's
//  meta zeroed, then appended
// l with x appended: its length, its type, its elements
theorem mp.snoc(l, x, j): l in list_type(omega) -> x in omega ->
  (len: seq_len(seq_concat(l, seq_one(x))) = int_add(seq_len(l), 1) && type: seq_concat(l, seq_one(x)) in list_type(omega)) &&
  elem: (j in omega -> int_lt(j, seq_len(l)) -> seq_concat(l, seq_one(x))[j] = l[j]) && last: seq_concat(l, seq_one(x))[seq_len(l)] = x
proof
  assume hl hx
  have ln: seq_len(seq_concat(l, seq_one(x))) = int_add(seq_len(l), 1) by arith(hl)
  have one := apply(tr.seq_one_type, hx)
  have ty := apply(tr.concat_list, hl, one)
  have a1: j in omega -> int_lt(j, seq_len(l)) -> seq_concat(l, seq_one(x))[j] = l[j] proof
    assume hj hjl
    show := at({seq_concat(l, seq_one(x))[j]}, hl, hj, hjl)
  qed
  have lo: seq_len(l) in omega by arith(hl)
  have a2 := at({seq_concat(l, seq_one(x))[seq_len(l)]}, hl, lo)
  show by taut(ln, ty, a1, simp(a2))
qed

// an element of the list at *phead: a natural, its links accessible,
// aligned, apart from the head word
theorem mp.list_el(vm, objs, phead, l, i): l in list_type(omega) -> mallocng_specs.list_at(vm, objs, phead, l) -> i in omega -> int_lt(i, seq_len(l)) ->
  ((((nat: l[i] in omega && bound: int_le(int_add(l[i], 16), 18446744073709551616)) && prev_ok: mallocng_specs.word_ok(vm, objs, l[i], 0)) &&
    next_ok: mallocng_specs.word_ok(vm, objs, l[i], 8)) && al: int_mod(l[i], 8) = 0) &&
  off_head: (int_le(int_add(phead, 8), l[i]) || int_le(int_add(l[i], 16), phead))
proof
  assume hl H hi hil
  have {el = elems} := expand(H, mallocng_specs.list_at)
  have lo := apply(at_type[l := l, t := omega, i := i], hl, hi, hil)
  have lb w0 w8 lm la := mp(all_elim(el, {i}), hi, hil)
  have lb2: int_le(int_add(l[i], 16), 18446744073709551616) by arith(lb)
  have bl: bits_of_int(64, l[i]) = l[i] by defs(simp(lo, (int_lt(l[i], 18446744073709551616) by arith(lb))), bits_of_int, pow2)
  show by taut(lo, lb2, rewrite(bl, w0), rewrite(bl, w8), lm, la)
qed

// l ++ [m], m joinable: its elements' facts and apartness, on any memory V
// differing from vm in bytes only (as `list_at` states them)
theorem mp.snoc_ok(vm, V, objs, phead, l, m): m in bits(64) -> l in list_type(omega) -> mallocng_specs.list_at(vm, objs, phead, l) ->
  mallocng_specs.joinable(vm, objs, phead, l, m) -> fn_update(V, "bytes", vm.bytes) = vm ->
  (all x0. x0 in omega -> int_lt(x0, seq_len(seq_concat(l, seq_one(m)))) ->
     ((((int_le(int_add(seq_concat(l, seq_one(m))[x0], 16), int_pow(2, 64)) && mallocng_specs.word_ok(V, objs, bits_of_int(64, seq_concat(l, seq_one(m))[x0]), 0)) &&
       mallocng_specs.word_ok(V, objs, bits_of_int(64, seq_concat(l, seq_one(m))[x0]), 8)) && int_mod(seq_concat(l, seq_one(m))[x0], 8) = 0) &&
      (int_le(int_add(phead, 8), seq_concat(l, seq_one(m))[x0]) || int_le(int_add(seq_concat(l, seq_one(m))[x0], 16), phead)))) &&
  (all x0. all x1. x0 in omega && x1 in omega -> (int_lt(x0, seq_len(seq_concat(l, seq_one(m)))) && int_lt(x1, seq_len(seq_concat(l, seq_one(m))))) && !(x0 = x1) ->
     int_le(int_add(seq_concat(l, seq_one(m))[x0], 16), seq_concat(l, seq_one(m))[x1]) || int_le(int_add(seq_concat(l, seq_one(m))[x1], 16), seq_concat(l, seq_one(m))[x0]))
proof
  assume hm hl H J fu
  let R := seq_concat(l, seq_one(m))
  let L := seq_len(l)
  have mo: m in omega by simp(hm)
  have lo: L in omega by arith(hl)
  have {rl = len, rL = last} := apply(mp.snoc[l := l, x := m, j := 0], hl, mo)
  have {el = elems, ap = apart} := expand(H, mallocng_specs.list_at)
  have {jb = bound, jw0 = prev_ok, jw8 = next_ok, jm = al, ja = off_head, jl = off_list} := expand(J, mallocng_specs.joinable)
  have wo: all p. all off. mallocng_specs.word_ok(V, objs, p, off) = mallocng_specs.word_ok(vm, objs, p, off) proof
    fix p off
    have f := all_elim(ms.f_word_ok, {V}, {vm.bytes}, {objs}, {p}, {off})
    show := sym(rewrite(fu, f))
  qed
  have bm: bits_of_int(64, m) = m by defs(simp(hm), bits_of_int, pow2)
  have e: all x0. x0 in omega -> int_lt(x0, seq_len(R)) ->
      ((((int_le(int_add(R[x0], 16), int_pow(2, 64)) && mallocng_specs.word_ok(V, objs, bits_of_int(64, R[x0]), 0)) &&
        mallocng_specs.word_ok(V, objs, bits_of_int(64, R[x0]), 8)) && int_mod(R[x0], 8) = 0) &&
       (int_le(int_add(phead, 8), R[x0]) || int_le(int_add(R[x0], 16), phead))) proof
    fix x0
    assume hx hxl
    have c1: int_lt(x0, L) -> ((((int_le(int_add(R[x0], 16), int_pow(2, 64)) && mallocng_specs.word_ok(V, objs, bits_of_int(64, R[x0]), 0)) &&
        mallocng_specs.word_ok(V, objs, bits_of_int(64, R[x0]), 8)) && int_mod(R[x0], 8) = 0) &&
       (int_le(int_add(phead, 8), R[x0]) || int_le(int_add(R[x0], 16), phead))) proof
      assume h
      have {ra = elem} := apply(mp.snoc[l := l, x := m, j := x0], hl, mo)
      have r := mp(ra, hx, h)
      have q := mp(all_elim(el, {x0}), hx, h)
      have w0 := all_elim(wo, {bits_of_int(64, l[x0])}, {0})
      have w8 := all_elim(wo, {bits_of_int(64, l[x0])}, {8})
      show by simp(r, w0, w8, q)
    qed
    have c2: !int_lt(x0, L) -> ((((int_le(int_add(R[x0], 16), int_pow(2, 64)) && mallocng_specs.word_ok(V, objs, bits_of_int(64, R[x0]), 0)) &&
        mallocng_specs.word_ok(V, objs, bits_of_int(64, R[x0]), 8)) && int_mod(R[x0], 8) = 0) &&
       (int_le(int_add(phead, 8), R[x0]) || int_le(int_add(R[x0], 16), phead))) proof
      assume h
      have xe: x0 = L by arith(h, hx, hxl, rl, lo)
      have w0 := all_elim(wo, {m}, {0})
      have w8 := all_elim(wo, {m}, {8})
      have r: R[x0] = m by simp(xe, rL)
      show by simp(r, bm, w0, w8, jb, jw0, jw8, jm, ja)
    qed
    show by taut(c1, c2)
  qed
  have a: all x0. all x1. x0 in omega && x1 in omega -> (int_lt(x0, seq_len(R)) && int_lt(x1, seq_len(R))) && !(x0 = x1) ->
      int_le(int_add(R[x0], 16), R[x1]) || int_le(int_add(R[x1], 16), R[x0]) proof
    fix x0 x1
    assume ho hq
    have x0o: x0 in omega by taut(ho)
    have x1o: x1 in omega by taut(ho)
    have x0l: int_lt(x0, int_add(L, 1)) by simp(hq, rl)
    have x1l: int_lt(x1, int_add(L, 1)) by simp(hq, rl)
    have ne: !(x0 = x1) by taut(hq)
    have {r0 = elem} := apply(mp.snoc[l := l, x := m, j := x0], hl, mo)
    have {r1 = elem} := apply(mp.snoc[l := l, x := m, j := x1], hl, mo)
    // both l's; one of them m
    have c00: int_lt(x0, L) -> int_lt(x1, L) -> int_le(int_add(R[x0], 16), R[x1]) || int_le(int_add(R[x1], 16), R[x0]) proof
      assume a b
      have q := mp(all_elim(ap, {x0}, {x1}), taut(x0o, x1o), taut(a, b, ne))
      show by simp(mp(r0, x0o, a), mp(r1, x1o, b), q)
    qed
    have c01: int_lt(x0, L) -> !int_lt(x1, L) -> int_le(int_add(R[x0], 16), R[x1]) || int_le(int_add(R[x1], 16), R[x0]) proof
      assume a b
      have xe: x1 = L by arith(b, x1o, x1l, lo)
      have q := mp(all_elim(jl, {x0}), x0o, a)
      show by simp(mp(r0, x0o, a), xe, rL, q)
    qed
    have c10: !int_lt(x0, L) -> int_lt(x1, L) -> int_le(int_add(R[x0], 16), R[x1]) || int_le(int_add(R[x1], 16), R[x0]) proof
      assume a b
      have xe: x0 = L by arith(a, x0o, x0l, lo)
      have q := mp(all_elim(jl, {x1}), x1o, b)
      show by simp(mp(r1, x1o, b), xe, rL, q)
    qed
    have c11: !int_lt(x0, L) -> !int_lt(x1, L) -> int_le(int_add(R[x0], 16), R[x1]) || int_le(int_add(R[x1], 16), R[x0]) proof
      assume a b
      have f: false by arith(a, b, ne, x0o, x1o, x0l, x1l, lo)
      show by taut(f)
    qed
    show by taut(c00, c01, c10, c11)
  qed
  show by taut(e, a)
qed

// m joinable to the list at *phead: queue's precondition holds (its links
// 0, the words it writes usable and aligned)
theorem mp.qu_pre(vm, objs, phead, m, l): vm.bytes in fn_space(bits(64), bits(8)) -> phead in bits(64) -> m in bits(64) ->
  l in list_type(omega) -> mallocng_specs.list_at(vm, objs, phead, l) -> mallocng_specs.joinable(vm, objs, phead, l, m) ->
  mallocng_specs.queue_pre(vm, objs, phead, m)
proof
  assume hb hp hm hl H J
  let L := seq_len(l)
  let IP := int_mod(int_sub(int_add(0, L), 1), L)
  have {hok = head, hal = head_al} := expand(H, mallocng_specs.list_at)
  have {jw0 = prev_ok, jw8 = next_ok, jm = al, jl = off_list, jz0 = prev0, jz8 = next0} := expand(J, mallocng_specs.joinable)
  have mo: m in omega by simp(hm)
  have lo: L in omega by arith(hl)
  have al8m: mallocng_specs.al8(m) by defs(jm, mallocng_specs.al8)
  have enx: mallocng_specs.mnext(vm, m) = 0 by defs(jz8, mallocng_specs.mnext)
  have epv: mallocng_specs.mprev(vm, m) = 0 by defs(jz0, mallocng_specs.mprev)
  have {mh = value} := apply(mp.head_is[vm := vm, objs := objs, phead := phead, l := l], hb, hp, hl, H)
  have tl: !(mallocng_specs.rd64(vm, phead) = 0) ->
      ((((mallocng_specs.word_ok(vm, objs, mallocng_specs.rd64(vm, phead), 0) && mallocng_specs.al8(mallocng_specs.rd64(vm, phead))) &&
        mallocng_specs.word_ok(vm, objs, mallocng_specs.mprev(vm, mallocng_specs.rd64(vm, phead)), 8)) && mallocng_specs.al8(mallocng_specs.mprev(vm, mallocng_specs.rd64(vm, phead)))) &&
        !(mallocng_specs.rd64(vm, phead) = int_add(m, 8))) && !(mallocng_specs.mprev(vm, mallocng_specs.rd64(vm, phead)) = m) proof
    assume hn
    have l0z: L = 0 -> mallocng_specs.rd64(vm, phead) = 0 proof
      assume h0
      show by simp(mh, h0)
    qed
    have ln: !(L = 0) by taut(l0z, hn)
    have eH: mallocng_specs.rd64(vm, phead) = l[0] by simp(mh, ln)
    have l0: int_lt(0, L) by arith(ln, lo)
    have ipo: IP in omega by arith(lo, l0)
    have ipl: int_lt(IP, L) by arith(lo, l0)
    have {ho = nat, hb16 = bound, hw0 = prev_ok, hmod = al} := apply(mp.list_el[vm := vm, objs := objs, phead := phead, l := l, i := 0], hl, H, simp(), l0)
    have {po = nat, pb16 = bound, pw8 = next_ok, pmod = al} := apply(mp.list_el[vm := vm, objs := objs, phead := phead, l := l, i := IP], hl, H, ipo, ipl)
    have {ws = links} := apply(mp.list_rd[vm := vm, objs := objs, phead := phead, l := l, i := 0], hb, hp, hl, H)
    have {rp = prev} := mp(ws, simp(), l0)
    have eP: mallocng_specs.mprev(vm, l[0]) = l[IP]
      by defs(simp(rp, po, (int_lt(l[IP], 18446744073709551616) by arith(pb16))), mallocng_specs.mprev, mallocng_specs.rd64, bits_of_int, pow2)
    have a0: mallocng_specs.al8(l[0]) by defs(hmod, mallocng_specs.al8)
    have ap: mallocng_specs.al8(l[IP]) by defs(pmod, mallocng_specs.al8)
    have d0 := mp(all_elim(jl, {0}), simp(), l0)
    have dp := mp(all_elim(jl, {IP}), ipo, ipl)
    have n1: !(l[0] = int_add(m, 8)) by arith(d0, ho, mo)
    have n2: !(l[IP] = m) by arith(dp, po, mo)
    show by simp(eH, eP, hw0, a0, pw8, ap, n1, n2)
  qed
  show by defs(taut(hok, jw0, jw8, hal, al8m, enx, epv, tl), mallocng_specs.queue_pre)
qed

// queue's effect on an empty list at *phead: m alone in it, linked to
// itself, the head
theorem mp.qu_list0(vm, objs, phead, m, l): vm in x86_64_linux.Vm -> vm.bytes in fn_space(bits(64), bits(8)) -> phead in bits(64) -> m in bits(64) ->
  l in list_type(omega) -> seq_len(l) = 0 -> mallocng_specs.list_at(vm, objs, phead, l) -> mallocng_specs.joinable(vm, objs, phead, l, m) ->
  mallocng_specs.list_at(mallocng_specs.queue_vm(vm, phead, m), objs, phead, seq_concat(l, seq_one(m))) &&
  mallocng_specs.links_only(vm, mallocng_specs.queue_vm(vm, phead, m), phead, seq_concat(l, seq_one(m)))
proof
  assume hvm hb hp hm hl h0 H J
  let R := seq_concat(l, seq_one(m))
  have {hok = head, hal = head_al} := expand(H, mallocng_specs.list_at)
  have {jb = bound, ja = off_head} := expand(J, mallocng_specs.joinable)
  have mo: m in omega by simp(hm)
  have pho: phead in omega by simp(hp)
  have {phl0 = bound} := expand(hok, mallocng_specs.word_ok)
  have phl: int_le(int_add(phead, 8), 18446744073709551616) by arith(phl0, pho)
  have mb: int_le(int_add(m, 16), 18446744073709551616) by arith(jb)
  have bm8: bits_add(64, m, 8) = int_add(m, 8) by defs(arith(mo, mb), bits_add, bits_of_int, pow2)
  have m8b: int_add(m, 8) in bits(64) by simp(mo, (int_lt(int_add(m, 8), 18446744073709551616) by arith(mb)))
  have {mh = value} := apply(mp.head_is[vm := vm, objs := objs, phead := phead, l := l], hb, hp, hl, H)
  have e0: mallocng_specs.rd64(vm, phead) = 0 by simp(mh, h0)
  let W1 := mallocng_specs.wr64(vm, int_add(m, 8), m)
  let W2 := mallocng_specs.wr64(W1, m, m)
  let W3 := mallocng_specs.wr64(W2, phead, m)
  have e3: mallocng_specs.queue_vm(vm, phead, m) = W3 by defs(simp(e0, bm8), mallocng_specs.queue_vm)
  have tb1 := apply(mp.wr64_typed[V := vm, c := int_add(m, 8), v := m], hb)
  have tb2 := apply(mp.wr64_typed[V := W1, c := m, v := m], tb1)
  have tb3 := apply(mp.wr64_typed[V := W2, c := phead, v := m], tb2)
  have vf: is_fun(vm) by simp(hvm)
  have vd: "bytes" in dom(vm) by simp(hvm)
  have vs := apply(fn_update_same[f := vm, k := "bytes"], vf, vd)
  have fu3 := apply(mp.wr64_only[V := W2, c := phead, v := m, W := vm], apply(mp.wr64_only[V := W1, c := m, v := m, W := vm],
    apply(mp.wr64_only[V := vm, c := int_add(m, 8), v := m, W := vm], vs)))
  // the words: the head word, m's links all m
  have rh: gimple.bytes_at(W3, phead, 8) = m := apply(mp.rd_at8[vm := W2, c := phead, v := m], tb2, hp, hm)
  have rm8: gimple.bytes_at(W3, int_add(m, 8), 8) = m :=
    trans(apply(mp.w64_out[V := W2, c := phead, v := m, w := int_add(m, 8)], hp, simp(mo), arith(mb), phl, arith(ja, mo, pho)),
      trans(apply(mp.w64_out[V := W1, c := m, v := m, w := int_add(m, 8)], hm, simp(mo), arith(mb), arith(mb), arith(mo)),
        apply(mp.rd_at8[vm := vm, c := int_add(m, 8), v := m], hb, m8b, hm)))
  have rm: gimple.bytes_at(W3, m, 8) = m :=
    trans(apply(mp.w64_out[V := W2, c := phead, v := m, w := m], hp, mo, arith(mb), phl, arith(ja, mo, pho)),
      apply(mp.rd_at8[vm := W1, c := m, v := m], tb1, hm, hm))
  // the list [m]
  have {rl = len, rty = type, rL = last} := apply(mp.snoc[l := l, x := m, j := 0], hl, mo)
  have r1: seq_len(R) = 1 by simp(rl, h0)
  have r0: R[0] = m by simp(rL, h0)
  have wo := all_elim(ms.f_word_ok, {W3}, {vm.bytes}, {objs}, {phead}, {0})
  have hok3: mallocng_specs.word_ok(W3, objs, phead, 0) by simp(rewrite(fu3, wo), hok)
  have el3 ap3 := apply(mp.snoc_ok[vm := vm, V := W3, objs := objs, phead := phead, l := l, m := m], hm, hl, H, J, fu3)
  have hd3: gimple.bytes_at(W3, phead, 8) = ite(seq_len(R) = 0, 0, R[0]) by simp(rh, r1, r0)
  have ws3: all i. i in omega -> int_lt(i, seq_len(R)) ->
      gimple.bytes_at(W3, int_add(R[i], 8), 8) = R[int_mod(int_add(i, 1), seq_len(R))] &&
      gimple.bytes_at(W3, R[i], 8) = R[int_mod(int_sub(int_add(i, seq_len(R)), 1), seq_len(R))] proof
    fix i
    assume hi hil
    have iz: i = 0 by arith(hi, hil, r1)
    have m1: int_mod(int_add(i, 1), seq_len(R)) = 0 by arith(iz, r1)
    have m2: int_mod(int_sub(int_add(i, seq_len(R)), 1), seq_len(R)) = 0 by arith(iz, r1)
    show by simp(iz, m1, m2, r0, rm8, rm)
  qed
  have la := apply(mp.list_mk[vm := W3, objs := objs, phead := phead, l := R], tb3, hp, rty, hok3, hal, el3, ap3, hd3, ws3)
  // no byte but the head word and m's links written
  have lo3: all x0. x0 in omega -> (int_lt(x0, int_pow(2, 64)) && !(int_le(phead, x0) && int_lt(x0, int_add(phead, 8)))) &&
      (all x1. x1 in omega -> int_lt(x1, seq_len(R)) -> !(int_le(R[x1], x0) && int_lt(x0, int_add(R[x1], 16)))) ->
      W3.bytes[bits_of_int(64, x0)] = vm.bytes[bits_of_int(64, x0)] proof
    fix x0
    assume hx hq
    have xl: int_lt(x0, 18446744073709551616) by arith(hq)
    have xp: !(int_le(phead, x0) && int_lt(x0, int_add(phead, 8))) by taut(hq)
    have xa: all x1. x1 in omega -> int_lt(x1, seq_len(R)) -> !(int_le(R[x1], x0) && int_lt(x0, int_add(R[x1], 16))) by taut(hq)
    have xb: x0 in bits(64) by simp(hx, xl)
    have bx: bits_of_int(64, x0) = x0 by defs(simp(hx, xl), bits_of_int, pow2)
    have om := rewrite(r0, mp(all_elim(xa, {0}), simp(), (int_lt(0, seq_len(R)) by arith(r1))))
    have b3 := apply(mp.wb_out[V := W2, c := phead, v := m, x := x0], xb, hp, phl, arith(xp, hx, pho))
    have b2 := apply(mp.wb_out[V := W1, c := m, v := m, x := x0], xb, hm, arith(mb), arith(om, hx, mo))
    have b1 := apply(mp.wb_out[V := vm, c := int_add(m, 8), v := m, x := x0], xb, m8b, arith(mb), arith(om, hx, mo))
    show by simp(bx, trans(b3, trans(b2, b1)))
  qed
  have lk: mallocng_specs.links_only(vm, W3, phead, R) by defs(taut(fu3, lo3), mallocng_specs.links_only)
  have all3: mallocng_specs.list_at(W3, objs, phead, R) && mallocng_specs.links_only(vm, W3, phead, R) by taut(la, lk)
  show := subst({y. mallocng_specs.list_at(y, objs, phead, R) && mallocng_specs.links_only(vm, y, phead, R)}, sym(e3), all3)
qed

// queue's effect on a list at *phead of 1 or more: m at its end, between
// its last element P and its first H
theorem mp.qu_list1(vm, objs, phead, m, l): vm in x86_64_linux.Vm -> vm.bytes in fn_space(bits(64), bits(8)) -> phead in bits(64) -> m in bits(64) ->
  l in list_type(omega) -> int_lt(0, seq_len(l)) -> mallocng_specs.list_at(vm, objs, phead, l) -> mallocng_specs.joinable(vm, objs, phead, l, m) ->
  mallocng_specs.list_at(mallocng_specs.queue_vm(vm, phead, m), objs, phead, seq_concat(l, seq_one(m))) &&
  mallocng_specs.links_only(vm, mallocng_specs.queue_vm(vm, phead, m), phead, seq_concat(l, seq_one(m)))
proof
  assume hvm hb hp hm hl hl0 H J
  let L := seq_len(l)
  let L1 := int_add(L, 1)
  let IP := int_mod(int_sub(int_add(0, L), 1), L)
  let H0 := l[0]
  let P := l[IP]
  let R := seq_concat(l, seq_one(m))
  have {hok = head, hal = head_al, ap = apart} := expand(H, mallocng_specs.list_at)
  have {jb = bound, ja = off_head, jl = off_list} := expand(J, mallocng_specs.joinable)
  have mo: m in omega by simp(hm)
  have lo: L in omega by arith(hl)
  have l1o: L1 in omega by simp(lo)
  have pho: phead in omega by simp(hp)
  have {phl0 = bound} := expand(hok, mallocng_specs.word_ok)
  have phl: int_le(int_add(phead, 8), 18446744073709551616) by arith(phl0, pho)
  have mb: int_le(int_add(m, 16), 18446744073709551616) by arith(jb)
  have bm8: bits_add(64, m, 8) = int_add(m, 8) by defs(arith(mo, mb), bits_add, bits_of_int, pow2)
  have m8b: int_add(m, 8) in bits(64) by simp(mo, (int_lt(int_add(m, 8), 18446744073709551616) by arith(mb)))
  have pe0 := apply(mp.mod_pred[x := 0, L := L], simp(), lo, hl0)
  have ipe: IP = int_sub(L, 1) by simp(pe0)
  have ipo: IP in omega by arith(ipe, lo, hl0)
  have ipl: int_lt(IP, L) by arith(ipe, lo, hl0)
  have {ho = nat, hb16 = bound, hw0 = prev_ok, hpa = off_head} := apply(mp.list_el[vm := vm, objs := objs, phead := phead, l := l, i := 0], hl, H, simp(), hl0)
  have {po = nat, pb16 = bound, ppa = off_head} := apply(mp.list_el[vm := vm, objs := objs, phead := phead, l := l, i := IP], hl, H, ipo, ipl)
  have d0 := mp(all_elim(jl, {0}), simp(), hl0)
  have dp := mp(all_elim(jl, {IP}), ipo, ipl)
  have {hz0 = nonnull} := expand(hw0, mallocng_specs.word_ok)
  have h0b: H0 in bits(64) by simp(ho, (int_lt(H0, 18446744073709551616) by arith(hb16)))
  have pbits: P in bits(64) by simp(po, (int_lt(P, 18446744073709551616) by arith(pb16)))
  have p8b: int_add(P, 8) in bits(64) by simp(po, (int_lt(int_add(P, 8), 18446744073709551616) by arith(pb16)))
  have bP8: bits_add(64, P, 8) = int_add(P, 8) by defs(arith(po, pb16), bits_add, bits_of_int, pow2)
  // the words read: the head word H, H's prev P
  have {mh = value} := apply(mp.head_is[vm := vm, objs := objs, phead := phead, l := l], hb, hp, hl, H)
  have ln: !(L = 0) by arith(hl0, lo)
  have eH: mallocng_specs.rd64(vm, phead) = H0 by simp(mh, ln)
  have hd0 ws0 := apply(mp.list_rd[vm := vm, objs := objs, phead := phead, l := l, i := 0], hb, hp, hl, H)
  have eHb: gimple.bytes_at(vm, phead, 8) = H0 by simp(hd0, ln)
  have {rp0 = prev} := mp(ws0, simp(), hl0)
  have eP: mallocng_specs.mprev(vm, H0) = P
    by defs(simp(rp0, po, (int_lt(P, 18446744073709551616) by arith(pb16))), mallocng_specs.mprev, mallocng_specs.rd64, bits_of_int, pow2)
  // the writes: m's links H and P, P's next and H's prev m
  let V1 := mallocng_specs.wr64(vm, int_add(m, 8), H0)
  let V2 := mallocng_specs.wr64(V1, m, P)
  let V3 := mallocng_specs.wr64(V2, int_add(P, 8), m)
  let V4 := mallocng_specs.wr64(V3, H0, m)
  have e4: mallocng_specs.queue_vm(vm, phead, m) = V4 by defs(simp(eH, eP, hz0, bm8, bP8), mallocng_specs.queue_vm)
  have tb1 := apply(mp.wr64_typed[V := vm, c := int_add(m, 8), v := H0], hb)
  have tb2 := apply(mp.wr64_typed[V := V1, c := m, v := P], tb1)
  have tb3 := apply(mp.wr64_typed[V := V2, c := int_add(P, 8), v := m], tb2)
  have tb4 := apply(mp.wr64_typed[V := V3, c := H0, v := m], tb3)
  have vf: is_fun(vm) by simp(hvm)
  have vd: "bytes" in dom(vm) by simp(hvm)
  have vs := apply(fn_update_same[f := vm, k := "bytes"], vf, vd)
  have fu4 := apply(mp.wr64_only[V := V3, c := H0, v := m, W := vm], apply(mp.wr64_only[V := V2, c := int_add(P, 8), v := m, W := vm],
    apply(mp.wr64_only[V := V1, c := m, v := P, W := vm], apply(mp.wr64_only[V := vm, c := int_add(m, 8), v := H0, W := vm], vs))))
  // m's links, the head word
  have rm8: gimple.bytes_at(V4, int_add(m, 8), 8) = H0 :=
    trans(apply(mp.w64_out[V := V3, c := H0, v := m, w := int_add(m, 8)], h0b, simp(mo), arith(mb), arith(hb16), arith(d0, ho, mo)),
      trans(apply(mp.w64_out[V := V2, c := int_add(P, 8), v := m, w := int_add(m, 8)], p8b, simp(mo), arith(mb), arith(pb16), arith(dp, po, mo)),
        trans(apply(mp.w64_out[V := V1, c := m, v := P, w := int_add(m, 8)], hm, simp(mo), arith(mb), arith(mb), arith(mo)),
          apply(mp.rd_at8[vm := vm, c := int_add(m, 8), v := H0], hb, m8b, h0b))))
  have rm: gimple.bytes_at(V4, m, 8) = P :=
    trans(apply(mp.w64_out[V := V3, c := H0, v := m, w := m], h0b, mo, arith(mb), arith(hb16), arith(d0, ho, mo)),
      trans(apply(mp.w64_out[V := V2, c := int_add(P, 8), v := m, w := m], p8b, mo, arith(mb), arith(pb16), arith(dp, po, mo)),
        apply(mp.rd_at8[vm := V1, c := m, v := P], tb1, hm, pbits)))
  have rph: gimple.bytes_at(V4, phead, 8) = H0 :=
    trans(apply(mp.w64_out[V := V3, c := H0, v := m, w := phead], h0b, pho, phl, arith(hb16), arith(hpa, ho, pho)),
      trans(apply(mp.w64_out[V := V2, c := int_add(P, 8), v := m, w := phead], p8b, pho, phl, arith(pb16), arith(ppa, po, pho)),
        trans(apply(mp.w64_out[V := V1, c := m, v := P, w := phead], hm, pho, phl, arith(mb), arith(ja, mo, pho)),
          trans(apply(mp.w64_out[V := vm, c := int_add(m, 8), v := H0, w := phead], m8b, pho, phl, arith(mb), arith(ja, mo, pho)), eHb))))
  // l's links: as before, but P's next and H's prev
  have wn: all j. j in omega -> int_lt(j, L) ->
      ((j = IP -> gimple.bytes_at(V4, int_add(l[j], 8), 8) = m) &&
       (!(j = IP) -> gimple.bytes_at(V4, int_add(l[j], 8), 8) = gimple.bytes_at(vm, int_add(l[j], 8), 8))) &&
      ((j = 0 -> gimple.bytes_at(V4, l[j], 8) = m) &&
       (!(j = 0) -> gimple.bytes_at(V4, l[j], 8) = gimple.bytes_at(vm, l[j], 8))) proof
    fix j
    assume hj hjl
    have {jo = nat, jb16 = bound} := apply(mp.list_el[vm := vm, objs := objs, phead := phead, l := l, i := j], hl, H, hj, hjl)
    have dm := mp(all_elim(jl, {j}), hj, hjl)
    have l8o: int_add(l[j], 8) in omega by simp(jo)
    have qH: l[j] = H0 || int_le(int_add(l[j], 16), H0) || int_le(int_add(H0, 16), l[j]) proof
      have a1: j = 0 -> l[j] = H0 by simp()
      have a2: !(j = 0) -> int_le(int_add(l[j], 16), H0) || int_le(int_add(H0, 16), l[j]) proof
        assume h
        show := mp(all_elim(ap, {j}, {0}), taut(hj, (0 in omega by simp())), taut(hjl, hl0, h))
      qed
      show by taut(a1, a2)
    qed
    have qP: l[j] = P || int_le(int_add(l[j], 16), P) || int_le(int_add(P, 16), l[j]) proof
      have a1: j = IP -> l[j] = P by simp()
      have a2: !(j = IP) -> int_le(int_add(l[j], 16), P) || int_le(int_add(P, 16), l[j]) proof
        assume h
        show := mp(all_elim(ap, {j}, {IP}), taut(hj, ipo), taut(hjl, ipl, h))
      qed
      show by taut(a1, a2)
    qed
    // the next link
    have s4 := apply(mp.w64_out[V := V3, c := H0, v := m, w := int_add(l[j], 8)], h0b, l8o, arith(jb16), arith(hb16), arith(qH, jo, ho))
    have n1: j = IP -> gimple.bytes_at(V4, int_add(l[j], 8), 8) = m proof
      assume h
      have e: l[j] = P by simp(h)
      have r := subst({y. gimple.bytes_at(V3, int_add(y, 8), 8) = m}, sym(e), apply(mp.rd_at8[vm := V2, c := int_add(P, 8), v := m], tb2, p8b, hm))
      show := trans(s4, r)
    qed
    have n2: !(j = IP) -> gimple.bytes_at(V4, int_add(l[j], 8), 8) = gimple.bytes_at(vm, int_add(l[j], 8), 8) proof
      assume h
      have a := mp(all_elim(ap, {j}, {IP}), taut(hj, ipo), taut(hjl, ipl, h))
      show := trans(s4, trans(apply(mp.w64_out[V := V2, c := int_add(P, 8), v := m, w := int_add(l[j], 8)], p8b, l8o, arith(jb16), arith(pb16), arith(a, jo, po)),
        trans(apply(mp.w64_out[V := V1, c := m, v := P, w := int_add(l[j], 8)], hm, l8o, arith(jb16), arith(mb), arith(dm, jo, mo)),
          apply(mp.w64_out[V := vm, c := int_add(m, 8), v := H0, w := int_add(l[j], 8)], m8b, l8o, arith(jb16), arith(mb), arith(dm, jo, mo)))))
    qed
    // the prev link
    have p1: j = 0 -> gimple.bytes_at(V4, l[j], 8) = m proof
      assume h
      have e: l[j] = H0 by simp(h)
      show := subst({y. gimple.bytes_at(V4, y, 8) = m}, sym(e), apply(mp.rd_at8[vm := V3, c := H0, v := m], tb3, h0b, hm))
    qed
    have p2: !(j = 0) -> gimple.bytes_at(V4, l[j], 8) = gimple.bytes_at(vm, l[j], 8) proof
      assume h
      have a := mp(all_elim(ap, {j}, {0}), taut(hj, (0 in omega by simp())), taut(hjl, hl0, h))
      show := trans(apply(mp.w64_out[V := V3, c := H0, v := m, w := l[j]], h0b, jo, arith(jb16), arith(hb16), arith(a, jo, ho)),
        trans(apply(mp.w64_out[V := V2, c := int_add(P, 8), v := m, w := l[j]], p8b, jo, arith(jb16), arith(pb16), arith(qP, jo, po)),
          trans(apply(mp.w64_out[V := V1, c := m, v := P, w := l[j]], hm, jo, arith(jb16), arith(mb), arith(dm, jo, mo)),
            apply(mp.w64_out[V := vm, c := int_add(m, 8), v := H0, w := l[j]], m8b, jo, arith(jb16), arith(mb), arith(dm, jo, mo)))))
    qed
    show by taut(n1, n2, p1, p2)
  qed

  // the list l ++ [m]
  have {rl = len, rty = type, rL = last} := apply(mp.snoc[l := l, x := m, j := 0], hl, mo)
  have wo := all_elim(ms.f_word_ok, {V4}, {vm.bytes}, {objs}, {phead}, {0})
  have hok4: mallocng_specs.word_ok(V4, objs, phead, 0) by simp(rewrite(fu4, wo), hok)
  have el4 ap4 := apply(mp.snoc_ok[vm := vm, V := V4, objs := objs, phead := phead, l := l, m := m], hm, hl, H, J, fu4)
  have {ra0 = elem} := apply(mp.snoc[l := l, x := m, j := 0], hl, mo)
  have r0: R[0] = H0 := mp(ra0, simp(), hl0)
  have hd4: gimple.bytes_at(V4, phead, 8) = ite(seq_len(R) = 0, 0, R[0]) by simp(rph, rl, lo, r0)
  have ws4: all i. i in omega -> int_lt(i, seq_len(R)) ->
      gimple.bytes_at(V4, int_add(R[i], 8), 8) = R[int_mod(int_add(i, 1), seq_len(R))] &&
      gimple.bytes_at(V4, R[i], 8) = R[int_mod(int_sub(int_add(i, seq_len(R)), 1), seq_len(R))] proof
    fix j
    assume hj hjl0
    have hjl: int_lt(j, L1) by simp(hjl0, rl)
    have ms1 := apply(mp.mod_succ[x := j, L := L1], hj, l1o, hjl)
    have mp1 := apply(mp.mod_pred[x := j, L := L1], hj, l1o, hjl)
    let N1 := int_mod(int_add(j, 1), L1)
    let P1 := int_mod(int_sub(int_add(j, L1), 1), L1)
    have {raj = elem} := apply(mp.snoc[l := l, x := m, j := j], hl, mo)
    // m, the last: its next H (the first), its prev P
    have cm: j = L -> gimple.bytes_at(V4, int_add(R[j], 8), 8) = R[N1] && gimple.bytes_at(V4, R[j], 8) = R[P1] proof
      assume h
      have rj: R[j] = m by simp(h, rL)
      have n1: N1 = 0 by simp(ms1, h)
      have p1: P1 = int_sub(L, 1) by simp(mp1, h, ln)
      have {rp = elem} := apply(mp.snoc[l := l, x := m, j := int_sub(L, 1)], hl, mo)
      have rP: R[int_sub(L, 1)] = P by simp(mp(rp, (int_sub(L, 1) in omega by arith(lo, hl0)), (int_lt(int_sub(L, 1), L) by arith(lo))), ipe)
      show by simp(rj, n1, p1, r0, rP, rm8, rm)
    qed
    // one of l's
    have cl: int_lt(j, L) -> gimple.bytes_at(V4, int_add(R[j], 8), 8) = R[N1] && gimple.bytes_at(V4, R[j], 8) = R[P1] proof
      assume h
      have rj: R[j] = l[j] := mp(raj, hj, h)
      have w1 w2 w3 w4 := mp(all_elim(wn, {j}), hj, h)
      have {lw = links} := apply(mp.list_rd[vm := vm, objs := objs, phead := phead, l := l, i := j], hb, hp, hl, H)
      have ln1 lp1 := mp(lw, hj, h)
      have j1: int_lt(int_add(j, 1), L1) by arith(h)
      have n1: N1 = int_add(j, 1) by simp(ms1, j1)
      // the next link: m for the last, else the next's
      have nx1: j = IP -> gimple.bytes_at(V4, int_add(R[j], 8), 8) = R[N1] proof
        assume e
        have jl: int_add(j, 1) = L by arith(e, ipe, lo, hj)
        show by simp(rj, mp(w1, e), n1, jl, rL)
      qed
      have nx2: !(j = IP) -> gimple.bytes_at(V4, int_add(R[j], 8), 8) = R[N1] proof
        assume e
        have jl: int_lt(int_add(j, 1), L) by arith(e, ipe, h, hj)
        have sl := apply(mp.mod_succ[x := j, L := L], hj, lo, h)
        have s2: int_mod(int_add(j, 1), L) = int_add(j, 1) by simp(sl, jl)
        have {rj1 = elem} := apply(mp.snoc[l := l, x := m, j := int_add(j, 1)], hl, mo)
        have r1: R[int_add(j, 1)] = l[int_add(j, 1)] := mp(rj1, simp(hj), jl)
        show by simp(rj, mp(w2, e), ln1, s2, n1, r1)
      qed
      // the prev link: m for the first, else the previous'
      have pv1: j = 0 -> gimple.bytes_at(V4, R[j], 8) = R[P1] proof
        assume e
        have m0 := trans(mp1, mp(all_elim(tr.ite_t, {j = 0}, {int_sub(L1, 1)}, {int_sub(j, 1)}), e))
        have p1: P1 = L by arith(m0, lo)
        show by simp(rj, mp(w3, e), p1, rL)
      qed
      have pv2: !(j = 0) -> gimple.bytes_at(V4, R[j], 8) = R[P1] proof
        assume e
        have p1: P1 = int_sub(j, 1) by simp(mp1, e)
        have pl := apply(mp.mod_pred[x := j, L := L], hj, lo, h)
        have p2: int_mod(int_sub(int_add(j, L), 1), L) = int_sub(j, 1) by simp(pl, e)
        have {rj1 = elem} := apply(mp.snoc[l := l, x := m, j := int_sub(j, 1)], hl, mo)
        have r1: R[int_sub(j, 1)] = l[int_sub(j, 1)] := mp(rj1, (int_sub(j, 1) in omega by arith(e, hj)), (int_lt(int_sub(j, 1), L) by arith(h, hj)))
        show by simp(rj, mp(w4, e), lp1, p2, p1, r1)
      qed
      show by taut(nx1, nx2, pv1, pv2)
    qed
    have c: int_lt(j, L) || j = L by arith(hjl, hj, lo)
    have r: gimple.bytes_at(V4, int_add(R[j], 8), 8) = R[N1] && gimple.bytes_at(V4, R[j], 8) = R[P1] by taut(c, cm, cl)
    show by simp(r, rl)
  qed
  have la := apply(mp.list_mk[vm := V4, objs := objs, phead := phead, l := R], tb4, hp, rty, hok4, hal, el4, ap4, hd4, ws4)
  // no byte but the links written
  have lo4: all x0. x0 in omega -> (int_lt(x0, int_pow(2, 64)) && !(int_le(phead, x0) && int_lt(x0, int_add(phead, 8)))) &&
      (all x1. x1 in omega -> int_lt(x1, seq_len(R)) -> !(int_le(R[x1], x0) && int_lt(x0, int_add(R[x1], 16)))) ->
      V4.bytes[bits_of_int(64, x0)] = vm.bytes[bits_of_int(64, x0)] proof
    fix x0
    assume hx hq
    have xl: int_lt(x0, 18446744073709551616) by arith(hq)
    have xa: all x1. x1 in omega -> int_lt(x1, seq_len(R)) -> !(int_le(R[x1], x0) && int_lt(x0, int_add(R[x1], 16))) by taut(hq)
    have xb: x0 in bits(64) by simp(hx, xl)
    have bx: bits_of_int(64, x0) = x0 by defs(simp(hx, xl), bits_of_int, pow2)
    have om := rewrite(rL, mp(all_elim(xa, {L}), lo, (int_lt(L, seq_len(R)) by arith(rl))))
    have oh := rewrite(r0, mp(all_elim(xa, {0}), simp(), (int_lt(0, seq_len(R)) by arith(rl, lo))))
    have {rpi = elem} := apply(mp.snoc[l := l, x := m, j := IP], hl, mo)
    have op := rewrite(mp(rpi, ipo, ipl), mp(all_elim(xa, {IP}), ipo, (int_lt(IP, seq_len(R)) by arith(rl, ipl))))
    have b4 := apply(mp.wb_out[V := V3, c := H0, v := m, x := x0], xb, h0b, arith(hb16), arith(oh, hx, ho))
    have b3 := apply(mp.wb_out[V := V2, c := int_add(P, 8), v := m, x := x0], xb, p8b, arith(pb16), arith(op, hx, po))
    have b2 := apply(mp.wb_out[V := V1, c := m, v := P, x := x0], xb, hm, arith(mb), arith(om, hx, mo))
    have b1 := apply(mp.wb_out[V := vm, c := int_add(m, 8), v := H0, x := x0], xb, m8b, arith(mb), arith(om, hx, mo))
    show by simp(bx, trans(b4, trans(b3, trans(b2, b1))))
  qed
  have lk: mallocng_specs.links_only(vm, V4, phead, R) by defs(taut(fu4, lo4), mallocng_specs.links_only)
  have all4: mallocng_specs.list_at(V4, objs, phead, R) && mallocng_specs.links_only(vm, V4, phead, R) by taut(la, lk)
  show := subst({y. mallocng_specs.list_at(y, objs, phead, R) && mallocng_specs.links_only(vm, y, phead, R)}, sym(e4), all4)
qed

// queue's effect is what it is for: for any list at *phead m is joinable to
theorem mp.qu_done(vm, objs, phead, m): vm in x86_64_linux.Vm -> vm.bytes in fn_space(bits(64), bits(8)) -> phead in bits(64) -> m in bits(64) ->
  mallocng_specs.queued(vm, mallocng_specs.queue_vm(vm, phead, m), objs, phead, m)
proof
  assume hvm hb hp hm
  have a: all x0. x0 in list_type(omega) -> mallocng_specs.list_at(vm, objs, phead, x0) && mallocng_specs.joinable(vm, objs, phead, x0, m) ->
      mallocng_specs.list_at(mallocng_specs.queue_vm(vm, phead, m), objs, phead, seq_concat(x0, seq_one(m))) &&
      mallocng_specs.links_only(vm, mallocng_specs.queue_vm(vm, phead, m), phead, seq_concat(x0, seq_one(m))) proof
    fix l
    assume hl hq
    have H: mallocng_specs.list_at(vm, objs, phead, l) by taut(hq)
    have J: mallocng_specs.joinable(vm, objs, phead, l, m) by taut(hq)
    have lo: seq_len(l) in omega by arith(hl)
    have c0: seq_len(l) = 0 -> mallocng_specs.list_at(mallocng_specs.queue_vm(vm, phead, m), objs, phead, seq_concat(l, seq_one(m))) &&
        mallocng_specs.links_only(vm, mallocng_specs.queue_vm(vm, phead, m), phead, seq_concat(l, seq_one(m))) proof
      assume h
      show := apply(mp.qu_list0[vm := vm, objs := objs, phead := phead, m := m, l := l], hvm, hb, hp, hm, hl, h, H, J)
    qed
    have c1: !(seq_len(l) = 0) -> mallocng_specs.list_at(mallocng_specs.queue_vm(vm, phead, m), objs, phead, seq_concat(l, seq_one(m))) &&
        mallocng_specs.links_only(vm, mallocng_specs.queue_vm(vm, phead, m), phead, seq_concat(l, seq_one(m))) proof
      assume h
      show := apply(mp.qu_list1[vm := vm, objs := objs, phead := phead, m := m, l := l], hvm, hb, hp, hm, hl, (int_lt(0, seq_len(l)) by arith(h, lo)), H, J)
    qed
    show by taut(c0, c1)
  qed
  show by defs(a, mallocng_specs.queued)
qed

// m's meta zeroed: each of its bytes 0, so each of its words
theorem mp.zero_b(vm, m, j): m in bits(64) -> j in omega -> int_lt(j, 40) -> int_le(int_add(m, 40), 18446744073709551616) ->
  mallocng_specs.zero_meta(vm, m).bytes[int_add(m, j)] = 0
proof
  assume hm hj hjl hml
  have s := apply(mp.st_at[B := vm.bytes, c := m, k := 40, v := 0, j := j], hm, hj, hjl, hml)
  have pp := mp(all_elim(pow256_pos, {j}), hj)
  have {d0 = quot} := apply(div_unique[x := 0, m := int_pow(256, j), q := 0, r := 0], simp(), simp(), simp(), pp, pp, arith())
  have z: bits_of_int(8, int_div(0, int_pow(256, j))) = 0 by defs(simp(d0), bits_of_int, pow2)
  show by defs(simp(s, z, app_update_same[f := vm, k := "bytes", v := x86_64_linux.store_le(vm.bytes, m, 40, 0)]), mallocng_specs.zero_meta)
qed

theorem mp.zero_w(vm, m, o): vm.bytes in fn_space(bits(64), bits(8)) -> m in bits(64) -> o in omega -> int_le(int_add(o, 8), 40) ->
  int_le(int_add(m, 40), 18446744073709551616) -> gimple.bytes_at(mallocng_specs.zero_meta(vm, m), int_add(m, o), 8) = 0
proof
  assume hb hm ho hol hml
  let X := mallocng_specs.wr64(vm, int_add(m, o), 0)
  have mo: m in omega by simp(hm)
  have cb: int_add(m, o) in bits(64) by simp(mo, ho, (int_lt(int_add(m, o), 18446744073709551616) by arith(mo, ho, hol, hml)))
  have x0 := apply(mp.rd_at8[vm := vm, c := int_add(m, o), v := 0], hb, cb, simp())
  have eq: all j. j in omega -> int_lt(j, 8) -> mallocng_specs.zero_meta(vm, m).bytes[int_add(int_add(m, o), j)] = X.bytes[int_add(int_add(m, o), j)] proof
    fix j
    assume hj hjl
    have a: int_add(int_add(m, o), j) = int_add(m, int_add(o, j)) by arith(mo, ho, hj)
    have z1 := apply(mp.zero_b[vm := vm, m := m, j := int_add(o, j)], hm, simp(ho, hj), arith(hol, ho, hj, hjl), hml)
    have s2 := apply(mp.st_at[B := vm.bytes, c := int_add(m, o), k := 8, v := 0, j := j], cb, hj, hjl, arith(mo, ho, hol, hml))
    have pp := mp(all_elim(pow256_pos, {j}), hj)
    have {d0 = quot} := apply(div_unique[x := 0, m := int_pow(256, j), q := 0, r := 0], simp(), simp(), simp(), pp, pp, arith())
    have z: bits_of_int(8, int_div(0, int_pow(256, j))) = 0 by defs(simp(d0), bits_of_int, pow2)
    have z2: X.bytes[int_add(int_add(m, o), j)] = 0
      by defs(simp(s2, z, app_update_same[f := vm, k := "bytes", v := x86_64_linux.store_le(vm.bytes, int_add(m, o), 8, 0)]), mallocng_specs.wr64)
    show by simp(a, z1, rewrite(a, z2))
  qed
  have rs := apply(mp.rd_same[v1 := mallocng_specs.zero_meta(vm, m), v2 := X, a := int_add(m, o), n := 8], simp(mo, ho), simp(), arith(mo, ho, hol, hml), eq)
  show := trans(rs, x0)
qed

// the list at *phead on a memory V, its words and the bytes' type the
// same, and V differing from vm in bytes only: the list there too
theorem mp.list_keep(vm, V, objs, phead, l): vm.bytes in fn_space(bits(64), bits(8)) -> V.bytes in fn_space(bits(64), bits(8)) ->
  phead in bits(64) -> l in list_type(omega) -> fn_update(V, "bytes", vm.bytes) = vm -> mallocng_specs.list_at(vm, objs, phead, l) ->
  gimple.bytes_at(V, phead, 8) = gimple.bytes_at(vm, phead, 8) ->
  (all i. i in omega -> int_lt(i, seq_len(l)) ->
     gimple.bytes_at(V, int_add(l[i], 8), 8) = gimple.bytes_at(vm, int_add(l[i], 8), 8) && gimple.bytes_at(V, l[i], 8) = gimple.bytes_at(vm, l[i], 8)) ->
  mallocng_specs.list_at(V, objs, phead, l)
proof
  assume hb hbV hp hl fu H eh ew
  have {hok = head, hal = head_al, el = elems, ap = apart} := expand(H, mallocng_specs.list_at)
  have wo: all p. all off. mallocng_specs.word_ok(V, objs, p, off) = mallocng_specs.word_ok(vm, objs, p, off) proof
    fix p off
    have f := all_elim(ms.f_word_ok, {V}, {vm.bytes}, {objs}, {p}, {off})
    show := sym(rewrite(fu, f))
  qed
  have hokV: mallocng_specs.word_ok(V, objs, phead, 0) by simp(all_elim(wo, {phead}, {0}), hok)
  have elV: all x0. x0 in omega -> int_lt(x0, seq_len(l)) -> ((((int_le(int_add(l[x0], 16), int_pow(2, 64)) && mallocng_specs.word_ok(V, objs, bits_of_int(64, l[x0]), 0)) &&
      mallocng_specs.word_ok(V, objs, bits_of_int(64, l[x0]), 8)) && int_mod(l[x0], 8) = 0) && (int_le(int_add(phead, 8), l[x0]) || int_le(int_add(l[x0], 16), phead))) proof
    fix x0
    assume hx hxl
    have q := mp(all_elim(el, {x0}), hx, hxl)
    have w0 := all_elim(wo, {bits_of_int(64, l[x0])}, {0})
    have w8 := all_elim(wo, {bits_of_int(64, l[x0])}, {8})
    show by simp(w0, w8, q)
  qed
  have {hd = head} := apply(mp.list_rd[vm := vm, objs := objs, phead := phead, l := l, i := 0], hb, hp, hl, H)
  have hdV := trans(eh, hd)
  have wsV: all i. i in omega -> int_lt(i, seq_len(l)) ->
      gimple.bytes_at(V, int_add(l[i], 8), 8) = l[int_mod(int_add(i, 1), seq_len(l))] &&
      gimple.bytes_at(V, l[i], 8) = l[int_mod(int_sub(int_add(i, seq_len(l)), 1), seq_len(l))] proof
    fix i
    assume hi hil
    have {ws = links} := apply(mp.list_rd[vm := vm, objs := objs, phead := phead, l := l, i := i], hb, hp, hl, H)
    have rn rp := mp(ws, hi, hil)
    have en ep := mp(all_elim(ew, {i}), hi, hil)
    show by taut(trans(en, rn), trans(ep, rp))
  qed
  show := apply(mp.list_mk[vm := V, objs := objs, phead := phead, l := l], hbV, hp, hl, hokV, hal, elV, ap, hdV, wsV)
qed

// m's meta zeroed: the list at *phead (apart from it) kept, m joinable to it
theorem mp.fm_pre(vm, objs, phead, m, l): vm in x86_64_linux.Vm -> vm.bytes in fn_space(bits(64), bits(8)) -> phead in bits(64) -> m in bits(64) ->
  l in list_type(omega) -> mallocng_specs.list_at(vm, objs, phead, l) -> mallocng_specs.meta_joinable(vm, objs, phead, l, m) ->
  mallocng_specs.list_at(mallocng_specs.zero_meta(vm, m), objs, phead, l) && mallocng_specs.joinable(mallocng_specs.zero_meta(vm, m), objs, phead, l, m)
proof
  assume hvm hb hp hm hl H J
  let ZV := mallocng_specs.zero_meta(vm, m)
  have {hok = head} := expand(H, mallocng_specs.list_at)
  have mz ml mm ur uw ma mlst := expand(J, mallocng_specs.joinable)
  have mo: m in omega by simp(hm)
  have pho: phead in omega by simp(hp)
  have {phl0 = bound} := expand(hok, mallocng_specs.word_ok)
  have phl: int_le(int_add(phead, 8), 18446744073709551616) by arith(phl0, pho)
  have mlt: int_le(int_add(m, 40), 18446744073709551616) by arith(ml)
  have tbZ: ZV.bytes in fn_space(bits(64), bits(8)) by defs(simp(mp(all_elim(x86.store_typed, {vm.bytes}, {m}, {40}, {0}), hb)), mallocng_specs.zero_meta)
  have vf: is_fun(vm) by simp(hvm)
  have vd: "bytes" in dom(vm) by simp(hvm)
  have vs := apply(fn_update_same[f := vm, k := "bytes"], vf, vd)
  have fu: fn_update(ZV, "bytes", vm.bytes) = vm
    by defs(trans(fn_update_twice[f := vm, k := "bytes", a := x86_64_linux.store_le(vm.bytes, m, 40, 0), b := vm.bytes], vs), mallocng_specs.zero_meta)
  // words apart from m's meta: as before
  have ro: all w. w in omega -> int_le(int_add(w, 8), 18446744073709551616) -> (int_le(int_add(m, 40), w) || int_le(int_add(w, 8), m)) ->
      gimple.bytes_at(ZV, w, 8) = gimple.bytes_at(vm, w, 8) proof
    fix w
    assume hw hwl hap
    show by defs(apply(mp.rd_out[vm := vm, c := m, k := 40, v := 0, a := w, n := 8], hw, simp(), hm, simp(), hwl, mlt, hap), mallocng_specs.zero_meta)
  qed
  have eh := mp(all_elim(ro, {phead}), pho, phl, arith(ma, mo, pho))
  have ew: all i. i in omega -> int_lt(i, seq_len(l)) ->
      gimple.bytes_at(ZV, int_add(l[i], 8), 8) = gimple.bytes_at(vm, int_add(l[i], 8), 8) && gimple.bytes_at(ZV, l[i], 8) = gimple.bytes_at(vm, l[i], 8) proof
    fix i
    assume hi hil
    have lo lb .. := apply(mp.list_el[vm := vm, objs := objs, phead := phead, l := l, i := i], hl, H, hi, hil)
    have d := mp(all_elim(mlst, {i}), hi, hil)
    have e1 := mp(all_elim(ro, {int_add(l[i], 8)}), simp(lo), arith(lb), arith(d, lo, mo))
    have e2 := mp(all_elim(ro, {l[i]}), lo, arith(lb), arith(d, lo, mo))
    show by taut(e1, e2)
  qed
  have lz := apply(mp.list_keep[vm := vm, V := ZV, objs := objs, phead := phead, l := l], hb, tbZ, hp, hl, fu, H, eh, ew)
  // m joinable: its words usable, its links 0
  have urZ: gimple.usable(ZV, objs, m, 40, false) by defs(simp(all_elim(ms.f_usable, {vm}, {x86_64_linux.store_le(vm.bytes, m, 40, 0)}, {objs}, {m}, {40}, {false}), ur), mallocng_specs.zero_meta)
  have uwZ: gimple.usable(ZV, objs, m, 40, true) by defs(simp(all_elim(ms.f_usable, {vm}, {x86_64_linux.store_le(vm.bytes, m, 40, 0)}, {objs}, {m}, {40}, {true}), uw), mallocng_specs.zero_meta)
  have mi: m in int by simp(mo)
  have u0r := mp(all_elim(ms.usable_part, {ZV}, {objs}, {m}, {40}, {int_add(m, 0)}, {8}, {false}), mi, simp(mo), arith(mo), arith(mo), urZ)
  have u0w := mp(all_elim(ms.usable_part, {ZV}, {objs}, {m}, {40}, {int_add(m, 0)}, {8}, {true}), mi, simp(mo), arith(mo), arith(mo), uwZ)
  have u8r := mp(all_elim(ms.usable_part, {ZV}, {objs}, {m}, {40}, {int_add(m, 8)}, {8}, {false}), mi, simp(mo), arith(mo), arith(mo), urZ)
  have u8w := mp(all_elim(ms.usable_part, {ZV}, {objs}, {m}, {40}, {int_add(m, 8)}, {8}, {true}), mi, simp(mo), arith(mo), arith(mo), uwZ)
  have w0: mallocng_specs.word_ok(ZV, objs, m, 0) by defs(taut(mz, (int_le(int_add(int_add(m, 0), 8), int_pow(2, 64)) by arith(ml)), u0r, u0w), mallocng_specs.word_ok)
  have w8: mallocng_specs.word_ok(ZV, objs, m, 8) by defs(taut(mz, (int_le(int_add(int_add(m, 8), 8), int_pow(2, 64)) by arith(ml)), u8r, u8w), mallocng_specs.word_ok)
  have z0 := apply(mp.zero_w[vm := vm, m := m, o := 0], hb, hm, simp(), simp(), mlt)
  have z8 := apply(mp.zero_w[vm := vm, m := m, o := 8], hb, hm, simp(), simp(), mlt)
  have bm8: bits_add(64, m, 8) = int_add(m, 8) by defs(arith(mo, ml), bits_add, bits_of_int, pow2)
  have z0m := rewrite((int_add(m, 0) = m by arith(mo)), z0)
  have r0: mallocng_specs.rd64(ZV, m) = 0 by defs(simp(z0m), mallocng_specs.rd64, bits_of_int, pow2)
  have r8: mallocng_specs.rd64(ZV, bits_add(64, m, 8)) = 0 by defs(simp(z8, bm8), mallocng_specs.rd64, bits_of_int, pow2)
  have m16: int_le(int_add(m, 16), int_pow(2, 64)) by arith(ml)
  have ma2: int_le(int_add(phead, 8), m) || int_le(int_add(m, 16), phead) by arith(ma, mo, pho)
  have ml2: all x0. x0 in omega -> int_lt(x0, seq_len(l)) -> int_le(int_add(l[x0], 16), m) || int_le(int_add(m, 16), l[x0]) proof
    fix x0
    assume hx hxl
    have lo := apply(at_type[l := l, t := omega, i := x0], hl, hx, hxl)
    have d := mp(all_elim(mlst, {x0}), hx, hxl)
    show by arith(d, lo, mo)
  qed
  have jz: mallocng_specs.joinable(ZV, objs, phead, l, m) by defs(taut(m16, w0, w8, mm, ma2, ml2, r0, r8), mallocng_specs.joinable)
  show by taut(lz, jz)
qed

// m's meta zeroed, then m queued: m's meta freed (its links the list's,
// its other bytes 0, nothing else written)
theorem mp.fm_done(vm, V, objs, phead, m): vm in x86_64_linux.Vm -> vm.bytes in fn_space(bits(64), bits(8)) -> phead in bits(64) -> m in bits(64) ->
  mallocng_specs.queued(mallocng_specs.zero_meta(vm, m), V, objs, phead, m) -> mallocng_specs.meta_freed(vm, V, objs, phead, m)
proof
  assume hvm hb hp hm Q
  let ZV := mallocng_specs.zero_meta(vm, m)
  have a: all x0. x0 in list_type(omega) -> mallocng_specs.list_at(vm, objs, phead, x0) && mallocng_specs.meta_joinable(vm, objs, phead, x0, m) ->
      ((mallocng_specs.list_at(V, objs, phead, seq_concat(x0, seq_one(m))) &&
        (all x1. x1 in omega -> int_le(int_add(m, 16), x1) && int_lt(x1, int_add(m, 40)) -> V.bytes[bits_of_int(64, x1)] = 0)) &&
        fn_update(V, "bytes", vm.bytes) = vm) &&
      (all x1. x1 in omega -> ((int_lt(x1, int_pow(2, 64)) && !(int_le(phead, x1) && int_lt(x1, int_add(phead, 8)))) && !(int_le(m, x1) && int_lt(x1, int_add(m, 40)))) &&
        (all x2. x2 in omega -> int_lt(x2, seq_len(x0)) -> !(int_le(x0[x2], x1) && int_lt(x1, int_add(x0[x2], 16)))) ->
        V.bytes[bits_of_int(64, x1)] = vm.bytes[bits_of_int(64, x1)]) proof
    fix l
    assume hl hq
    have H: mallocng_specs.list_at(vm, objs, phead, l) by taut(hq)
    have J: mallocng_specs.meta_joinable(vm, objs, phead, l, m) by taut(hq)
    have {ml = bound, ma = off_head, mlst = off_list} := expand(J, mallocng_specs.meta_joinable)
    have mo: m in omega by simp(hm)
    have pho: phead in omega by simp(hp)
    have lo: seq_len(l) in omega by arith(hl)
    have mlt: int_le(int_add(m, 40), 18446744073709551616) by arith(ml)
    have lz jz := apply(mp.fm_pre[vm := vm, objs := objs, phead := phead, m := m, l := l], hvm, hb, hp, hm, hl, H, J)
    have la lk := mp(all_elim(expand(Q, mallocng_specs.queued), {l}), hl, taut(lz, jz))
    have fuZ lkb := expand(lk, mallocng_specs.links_only)
    let R := seq_concat(l, seq_one(m))
    have {rl = len, rL = last} := apply(mp.snoc[l := l, x := m, j := 0], hl, mo)
    // a byte outside the list's links and the head word: V's the zeroed one
    have kz: all x1. x1 in omega -> int_lt(x1, 18446744073709551616) -> !(int_le(phead, x1) && int_lt(x1, int_add(phead, 8))) ->
        !(int_le(m, x1) && int_lt(x1, int_add(m, 16))) ->
        (all x2. x2 in omega -> int_lt(x2, seq_len(l)) -> !(int_le(l[x2], x1) && int_lt(x1, int_add(l[x2], 16)))) ->
        V.bytes[bits_of_int(64, x1)] = ZV.bytes[bits_of_int(64, x1)] proof
      fix x1
      assume hx hxl hxp hxm hxa
      have xa: all x2. x2 in omega -> int_lt(x2, seq_len(R)) -> !(int_le(R[x2], x1) && int_lt(x1, int_add(R[x2], 16))) proof
        fix x2
        assume h2 h2l
        have c1: int_lt(x2, seq_len(l)) -> !(int_le(R[x2], x1) && int_lt(x1, int_add(R[x2], 16))) proof
          assume h
          have {r2 = elem} := apply(mp.snoc[l := l, x := m, j := x2], hl, mo)
          show by simp(mp(r2, h2, h), mp(all_elim(hxa, {x2}), h2, h))
        qed
        have c2: !int_lt(x2, seq_len(l)) -> !(int_le(R[x2], x1) && int_lt(x1, int_add(R[x2], 16))) proof
          assume h
          have xe: x2 = seq_len(l) by arith(h, h2, h2l, rl, lo)
          show by simp(xe, rL, hxm)
        qed
        show by taut(c1, c2)
      qed
      show := mp(all_elim(lkb, {x1}), hx, taut((int_lt(x1, int_pow(2, 64)) by arith(hxl)), hxp, xa))
    qed
    // m's other bytes: 0
    have zr: all x1. x1 in omega -> int_le(int_add(m, 16), x1) && int_lt(x1, int_add(m, 40)) -> V.bytes[bits_of_int(64, x1)] = 0 proof
      fix x1
      assume hx hr
      have xl: int_lt(x1, 18446744073709551616) by arith(hr, mlt)
      have bx: bits_of_int(64, x1) = x1 by defs(simp(hx, xl), bits_of_int, pow2)
      have xa: all x2. x2 in omega -> int_lt(x2, seq_len(l)) -> !(int_le(l[x2], x1) && int_lt(x1, int_add(l[x2], 16))) proof
        fix x2
        assume h2 h2l
        have l2 := apply(at_type[l := l, t := omega, i := x2], hl, h2, h2l)
        have d := mp(all_elim(mlst, {x2}), h2, h2l)
        show by arith(d, l2, hr, mo, hx)
      qed
      have k := mp(all_elim(kz, {x1}), hx, xl, arith(ma, hr, mo, pho, hx), arith(hr, mo, hx), xa)
      have e: x1 = int_add(m, int_sub(x1, m)) by arith(hx, mo)
      have z := apply(mp.zero_b[vm := vm, m := m, j := int_sub(x1, m)], hm, arith(hr, mo, hx), arith(hr, mo, hx), mlt)
      have z2: ZV.bytes[x1] = 0 := rewrite(sym(e), z)
      show by simp(k, bx, z2)
    qed
    // V differs from vm in bytes only
    have vf: is_fun(vm) by simp(hvm)
    have vd: "bytes" in dom(vm) by simp(hvm)
    have vs := apply(fn_update_same[f := vm, k := "bytes"], vf, vd)
    have fZ: fn_update(ZV, "bytes", vm.bytes) = vm
      by defs(trans(fn_update_twice[f := vm, k := "bytes", a := x86_64_linux.store_le(vm.bytes, m, 40, 0), b := vm.bytes], vs), mallocng_specs.zero_meta)
    have t1 := fn_update_twice[f := V, k := "bytes", a := ZV.bytes, b := vm.bytes]
    have fu: fn_update(V, "bytes", vm.bytes) = vm := trans(sym(t1), trans(subst({y. fn_update(fn_update(V, "bytes", ZV.bytes), "bytes", vm.bytes) = fn_update(y, "bytes", vm.bytes)}, fuZ, refl({fn_update(fn_update(V, "bytes", ZV.bytes), "bytes", vm.bytes)})), fZ))
    // the frame
    have fr: all x1. x1 in omega -> ((int_lt(x1, int_pow(2, 64)) && !(int_le(phead, x1) && int_lt(x1, int_add(phead, 8)))) && !(int_le(m, x1) && int_lt(x1, int_add(m, 40)))) &&
        (all x2. x2 in omega -> int_lt(x2, seq_len(l)) -> !(int_le(l[x2], x1) && int_lt(x1, int_add(l[x2], 16)))) ->
        V.bytes[bits_of_int(64, x1)] = vm.bytes[bits_of_int(64, x1)] proof
      fix x1
      assume hx hq2
      have xl: int_lt(x1, 18446744073709551616) by arith(hq2)
      have xp: !(int_le(phead, x1) && int_lt(x1, int_add(phead, 8))) by taut(hq2)
      have xm: !(int_le(m, x1) && int_lt(x1, int_add(m, 40))) by taut(hq2)
      have xa: all x2. x2 in omega -> int_lt(x2, seq_len(l)) -> !(int_le(l[x2], x1) && int_lt(x1, int_add(l[x2], 16))) by taut(hq2)
      have bx: bits_of_int(64, x1) = x1 by defs(simp(hx, xl), bits_of_int, pow2)
      have xb: x1 in bits(64) by simp(hx, xl)
      have k := mp(all_elim(kz, {x1}), hx, xl, xp, arith(xm, hx, mo), xa)
      have so := apply(mp.st_out[B := vm.bytes, c := m, k := 40, v := 0, x := x1], xb, hm, simp(), mlt, arith(xm, hx, mo))
      have zo: ZV.bytes[x1] = vm.bytes[x1]
        by defs(simp(so, app_update_same[f := vm, k := "bytes", v := x86_64_linux.store_le(vm.bytes, m, 40, 0)]), mallocng_specs.zero_meta)
      show by simp(k, bx, zo)
    qed
    show by taut(la, zr, fu, fr)
  qed
  show by defs(a, mallocng_specs.meta_freed)
qed

// ----------------------------------------------------------------------
//  dequeue, dequeue_head: their code refines their purpose
// dequeue's code by its purpose: m out of the list at *phead holding it,
// the others' order kept, m's links cleared, nothing else written -- its
// effect (`ms.dq_run`) is that (`mp.dq_done`); the list gives its
// precondition (`mp.dq_pre`)
theorem mp.dq: all phead m. phead in bits(64) -> m in bits(64) ->
  refines(c_src_malloc_mallocng_malloc.dequeue(phead, m), mallocng_specs.dequeue_spec(phead, m), abi.World)
proof
  fix phead m
  assume hp hm
  have g: all s o. s in abi.World -> runs(c_src_malloc_mallocng_malloc.dequeue(phead, m), s, o) -> runs(mallocng_specs.dequeue_spec(phead, m), s, o) proof
    fix s o
    assume hw hr
    let V0 := s.vm
    let OB := s.objs
    have pu := apply(g.runs_univ, hr)
    have hu: s in univ(1) by simp(pu)
    let PRE := ex x2. ex x3. (x2 in list_type(omega) && x3 in omega) && ((mallocng_specs.list_at(V0, OB, phead, x2) && int_lt(x3, seq_len(x2))) && x2[x3] = m)
    have np: !PRE -> runs(mallocng_specs.dequeue_spec(phead, m), s, o) proof
      assume hn0
      show by simp(pu, hn0, keep(abi.overflow, mallocng_specs.list_at, mallocng_specs.dequeued))
    qed
    have yp: PRE -> runs(mallocng_specs.dequeue_spec(phead, m), s, o) proof
      assume hpre
      obtain l, hl0 from hpre
      obtain k, hl hk hq from hl0
      have H: mallocng_specs.list_at(V0, OB, phead, l) by taut(hq)
      have hkl: int_lt(k, seq_len(l)) by taut(hq)
      have hlk: l[k] = m by taut(hq)
      have {pv = mem, pb = bytes} := apply(ms.world_parts, hw)
      have {dp = pre} := apply(mp.dq_pre[vm := V0, objs := OB, phead := phead, m := m, l := l, k := k], pb, hp, hm, hl, hk, hkl, hlk, H)
      have oe := apply(ms.dq_run, {phead}, {m}, {s}, {o}, hp, hm, hw, hu, dp, hr)
      let V1 := mallocng_specs.dequeue_vm(V0, phead, m)
      let S1 := fn_update(s, "vm", V1)
      have {vt = mem} := apply(ms.dqvm_vm, {V0}, {phead}, {m}, pv, simp(hu), hp, hm)
      have q := apply(mp.dq_done[vm := V0, objs := OB, phead := phead, m := m], pv, pb, hp, hm)
      let X2 := ok(pair(S1, empty), empty)
      have ex: ex x4. (x4 in x86_64_linux.Vm && mallocng_specs.dequeued(V0, fn_update(s, "vm", x4).vm, fn_update(s, "vm", x4).objs, phead, m)) &&
          X2 = ok(pair(fn_update(s, "vm", x4), empty), empty)
        by ex_intro({V1}, taut(vt, (mallocng_specs.dequeued(V0, S1.vm, S1.objs, phead, m) by simp(q)), refl({X2})))
      have b: letin(s.vm, x3. any_rel(x4. x4 in x86_64_linux.Vm && mallocng_specs.dequeued(x3, fn_update(s, "vm", x4).vm, fn_update(s, "vm", x4).objs, phead, m),
          x4. letin(fn_update(s, "vm", x4), x5. X2 = ok(pair(x5, empty), empty))))
        by defs(taut(ex), letin, any_rel)
      have pu1: pair(s, ok(S1, empty)) in univ(1) by simp(rewrite(oe, pu))
      have c := apply(ct.contract_done[P := x0. ex x2. ex x3. (x2 in list_type(omega) && x3 in omega) &&
          ((mallocng_specs.list_at(x0.vm, x0.objs, phead, x2) && int_lt(x3, seq_len(x2))) && x2[x3] = m),
        B := x0 x2. letin(x0.vm, x3. any_rel(x4. x4 in x86_64_linux.Vm && mallocng_specs.dequeued(x3, fn_update(x0, "vm", x4).vm, fn_update(x0, "vm", x4).objs, phead, m),
          x4. letin(fn_update(x0, "vm", x4), x5. x2 = ok(pair(x5, empty), empty)))),
        s := s, s1 := S1], hpre, b, pu1)
      show by defs(rewrite(sym(oe), c), mallocng_specs.dequeue_spec)
    qed
    show by taut(np, yp)
  qed
  show g
qed

// dequeue as a C function value
theorem mp.dq_fun: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
  runs(c_src_malloc_mallocng_malloc.dequeue_fun[regs], s, o) -> runs(mallocng_specs.dequeue_spec_fun()[regs], s, o)
proof
  have hm: all regs. refines(c_src_malloc_mallocng_malloc.dequeue(bits_of_int(64, regs[0]), bits_of_int(64, regs[1])), mallocng_specs.dequeue_spec(bits_of_int(64, regs[0]), bits_of_int(64, regs[1])), abi.World) proof
    fix regs
    show := mp(all_elim(mp.dq, {bits_of_int(64, regs[0])}, {bits_of_int(64, regs[1])}), simp(), simp())
  qed
  show by defs(apply(g.fun_void[n := 2], hm), c_src_malloc_mallocng_malloc.dequeue_fun, mallocng_specs.dequeue_spec_fun)
qed

// dequeue's contract at a call (its C function value), m in the list l at
// *phead: an overflow, or the memory some V it is for (`dequeued`)
theorem mp.dq_q: all t phead m l k regs o2. t in abi.World -> t in univ(1) -> phead in bits(64) -> m in bits(64) ->
  l in list_type(omega) -> k in omega -> int_lt(k, seq_len(l)) -> l[k] = m -> mallocng_specs.list_at(t.vm, t.objs, phead, l) ->
  gc.regs_ok(regs, seq_concat(seq_one(gimple.arg(64, phead)), seq_one(gimple.arg(64, m)))) ->
  runs(mallocng_specs.dequeue_spec_fun()[regs], t, o2) ->
  (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex V r. (V in x86_64_linux.Vm && mallocng_specs.dequeued(t.vm, V, t.objs, phead, m)) && o2 = ok(fn_update(t, "vm", V), r))
proof
  fix t phead m l k regs o2
  assume hw htu hp hm hl hk hkl hlk H hro h
  let T0 := t.vm
  have hpre: ex x2. ex x3. (x2 in list_type(omega) && x3 in omega) && ((mallocng_specs.list_at(t.vm, t.objs, phead, x2) && int_lt(x3, seq_len(x2))) && x2[x3] = m)
    by ex_intro({l}, {k}, taut(hl, hk, H, hkl, hlk))
  have rl rn r0 r1 := apply(gc.regs2, hp, hm, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  have o2l: ord_le(2, seq_len(regs)) by defs(simp(rn), ord_le)
  have bp: bits_of_int(64, regs[0]) = phead && bits_of_int(64, regs[1]) = m by defs(simp(r0, r1, hp, hm), bits_of_int, pow2)
  have {pv = mem, pb = bytes} := apply(ms.world_parts, hw)
  have q := apply(mp.dq_done[vm := T0, objs := t.objs, phead := phead, m := m], pv, pb, hp, hm)
  have {vt = mem} := apply(ms.dqvm_vm, {T0}, {phead}, {m}, pv, simp(htu), hp, hm)
  have ne: ex x4. x4 in x86_64_linux.Vm && mallocng_specs.dequeued(T0, x4, t.objs, phead, m)
    by ex_intro({mallocng_specs.dequeue_vm(T0, phead, m)}, taut(vt, q))
  step o3 x2 V y1 y2, e hd from h with o2l, bp, hpre, ne using ra, pv
  have hv hq := (V in x86_64_linux.Vm && mallocng_specs.dequeued(T0, V, t.objs, phead, m) by simp(hd))
  have oe: o2 = ok(fn_update(t, "vm", V), pair(y1, y2)) by taut(e)
  have r: ex V2 r. (V2 in x86_64_linux.Vm && mallocng_specs.dequeued(t.vm, V2, t.objs, phead, m)) && o2 = ok(fn_update(t, "vm", V2), r)
    by ex_intro({V}, {pair(y1, y2)}, taut(hv, hq, oe))
  show by taut(r)
qed

// dequeue_head's code by its purpose: the list's first element (0 if
// empty) out of it and returned -- the head word read (`mp.head_is`), then
// dequeue's contract (`mp.dq_q`), for every callee refining it
theorem mp.dqh: all phead g. phead in bits(64) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(g[regs], s, o) -> runs(mallocng_specs.dequeue_spec_fun()[regs], s, o)) ->
  refines(c_src_malloc_mallocng_malloc.dequeue_head(phead, g), mallocng_specs.dequeue_head_spec(phead), abi.World)
proof
  fix phead g
  assume hph hg
  show proof
    fix s o
    assume hw hr
    let V0 := s.vm
    let OB := s.objs
    let SPEC := mallocng_specs.dequeue_head_spec(phead)
    let M := mallocng_specs.rd64(V0, phead)
    let OVF := exc_val("stack_overflow", empty)
    have pu := apply(g.runs_univ, hr)
    have hu: s in univ(1) by simp(pu)
    have vV vfun vdom vb := apply(ms.world_parts, hw)
    have ss: fn_update(s, "vm", V0) = s := mp(fn_update_same[f := s, k := "vm"], vfun, vdom)
    have np: !((ex x2. x2 in list_type(omega) && mallocng_specs.list_at(V0, OB, phead, x2)) && abi.thread_ok(V0, s.fs_base)) -> runs(SPEC, s, o) proof
      assume hn
      show by simp(pu, hn, keep(abi.overflow, mallocng_specs.list_at, mallocng_specs.is_head, mallocng_specs.head_taken, abi.thread_ok))
    qed
    have yp: (ex x2. x2 in list_type(omega) && mallocng_specs.list_at(V0, OB, phead, x2)) && abi.thread_ok(V0, s.fs_base) -> runs(SPEC, s, o) proof
      assume hp
      have hex ths := hp
      obtain l, hl H from hex
      have kh .. := expand(H, mallocng_specs.list_at)
      have mh mi := apply(mp.head_is[vm := V0, objs := OB, phead := phead, l := l], vb, hph, hl, H)
      have mb: M in bits(64) by defs(simp(), mallocng_specs.rd64)
      // (the spec's outcomes: an overflow, any memory; the head returned, taken)
      have sov: all v. v in x86_64_linux.Vm -> runs(SPEC, s, exc(fn_update(s, "vm", v), OVF)) proof
        fix v
        assume hv
        have vu := apply(x86.vm_univ, hv)
        have eu: OVF in univ(1) by defs(simp(), exc_val)
        have pu2: pair(s, exc(fn_update(s, "vm", v), OVF)) in univ(1) by simp(hu, vu, eu)
        have c := apply(ct.contract_ovf[P := x0. (ex x2. x2 in list_type(omega) && mallocng_specs.list_at(x0.vm, x0.objs, phead, x2)) && abi.thread_ok(x0.vm, x0.fs_base),
          B := x0 x2. letin(x0.vm, x3. any_rel(x4. x4 in bits(64) && mallocng_specs.is_head(x3, x0.objs, phead, x4), x4. letin(x4, x5.
            any_rel(x6. x6 in x86_64_linux.Vm && mallocng_specs.head_taken(x3, fn_update(x0, "vm", x6).vm, fn_update(x0, "vm", x6).objs, phead, x5),
              x6. letin(fn_update(x0, "vm", x6), x7. x2 = exc(pair(x7, empty), pair("ret", x5))))))),
          s := s, v := v], hp, hv, pu2)
        show by defs(c, mallocng_specs.dequeue_head_spec)
      qed
      have sret: all V. V in x86_64_linux.Vm -> mallocng_specs.head_taken(V0, V, OB, phead, M) -> runs(SPEC, s, ok(fn_update(s, "vm", V), M)) proof
        fix V
        assume hV ht
        let X := exc(pair(fn_update(s, "vm", V), empty), pair("ret", M))
        have i6: ex x6. (x6 in x86_64_linux.Vm && mallocng_specs.head_taken(V0, fn_update(s, "vm", x6).vm, fn_update(s, "vm", x6).objs, phead, M)) &&
            X = exc(pair(fn_update(s, "vm", x6), empty), pair("ret", M))
          by ex_intro({V}, taut(hV, (mallocng_specs.head_taken(V0, fn_update(s, "vm", V).vm, fn_update(s, "vm", V).objs, phead, M) by simp(ht)), refl({X})))
        have i4: ex x4. (x4 in bits(64) && mallocng_specs.is_head(V0, OB, phead, x4)) &&
            (!(ex x6. x6 in x86_64_linux.Vm && mallocng_specs.head_taken(V0, fn_update(s, "vm", x6).vm, fn_update(s, "vm", x6).objs, phead, x4)) ||
             (ex x6. (x6 in x86_64_linux.Vm && mallocng_specs.head_taken(V0, fn_update(s, "vm", x6).vm, fn_update(s, "vm", x6).objs, phead, x4)) &&
               X = exc(pair(fn_update(s, "vm", x6), empty), pair("ret", x4))))
          by ex_intro({M}, taut(mb, mi, i6))
        have b: letin(s.vm, x3. any_rel(x4. x4 in bits(64) && mallocng_specs.is_head(x3, s.objs, phead, x4), x4. letin(x4, x5.
            any_rel(x6. x6 in x86_64_linux.Vm && mallocng_specs.head_taken(x3, fn_update(s, "vm", x6).vm, fn_update(s, "vm", x6).objs, phead, x5),
              x6. letin(fn_update(s, "vm", x6), x7. X = exc(pair(x7, empty), pair("ret", x5)))))))
          by defs(taut(i4), letin, any_rel)
        have vu := apply(x86.vm_univ, hV)
        have pu2: pair(s, ok(fn_update(s, "vm", V), M)) in univ(1) by simp(hu, vu, mb)
        have c := apply(ct.contract_ret[P := x0. (ex x2. x2 in list_type(omega) && mallocng_specs.list_at(x0.vm, x0.objs, phead, x2)) && abi.thread_ok(x0.vm, x0.fs_base),
          B := x0 x2. letin(x0.vm, x3. any_rel(x4. x4 in bits(64) && mallocng_specs.is_head(x3, x0.objs, phead, x4), x4. letin(x4, x5.
            any_rel(x6. x6 in x86_64_linux.Vm && mallocng_specs.head_taken(x3, fn_update(x0, "vm", x6).vm, fn_update(x0, "vm", x6).objs, phead, x5),
              x6. letin(fn_update(x0, "vm", x6), x7. x2 = exc(pair(x7, empty), pair("ret", x5))))))),
          s := s, s1 := fn_update(s, "vm", V), v := M], hp, b, pu2)
        show by defs(c, mallocng_specs.dequeue_head_spec)
      qed
      // the run: the locals' choices, then *phead loaded
      have ne64: ex x. x in bits(64) by ex_intro({0}, simp())
      obtain x2, h2b h2l from apply(g.any_e, ne64, apply(g.runs_elim, hr))
      have l2 := apply(g.letin_e, h2l)
      obtain x4, h4b h4l from apply(g.any_e, ne64, l2)
      have l4 := apply(g.letin_e, h4l)
      have zp: bits_add(64, phead, 0) = phead by simp(hph)
      have ld := rewrite(zp, apply(ms.ld_det, {s}, {phead}, {0}, hu, hph, simp(), kh))
      have l6 := apply(g.bind_inv, l4, ld)
      obtain x9, hd he from apply(g.letin_e, l6)
      // an empty list: nothing done, 0 returned
      have z: M = 0 -> runs(SPEC, s, o) proof
        assume e0
        have x9e: x9 = ok(pair(s, pair(M, x4)), empty) by simp(hd, e0)
        have oe: o = ok(s, M) by simp(rewrite(x9e, he))
        have ht: mallocng_specs.head_taken(V0, V0, OB, phead, M) by defs(taut(e0, refl({V0})), mallocng_specs.head_taken)
        have r := mp(all_elim(sret, {V0}), vV, ht)
        show := rewrite(sym(oe), rewrite(ss, r))
      qed
      // a first element: dequeued by the call (its contract: dequeue's), returned
      have nz: !(M = 0) -> runs(SPEC, s, o) proof
        assume hn
        have b := apply(g.pick, hd, hn, (!!!(M = 0) by taut(hn)))
        have lo: seq_len(l) in omega by arith(hl)
        have l0z: seq_len(l) = 0 -> M = 0 proof
          assume h0
          show by simp(mh, h0)
        qed
        have ln: !(seq_len(l) = 0) by taut(l0z, hn)
        have l0: l[0] = M by simp(mh, ln)
        have qa: all regs o2. gc.regs_ok(regs, seq_concat(seq_one(gimple.arg(64, phead)), seq_one(gimple.arg(64, M)))) -> runs(mallocng_specs.dequeue_spec_fun()[regs], s, o2) ->
            (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(s, "vm", v), OVF)) ||
            (ex V r. (V in x86_64_linux.Vm && mallocng_specs.dequeued(V0, V, OB, phead, M)) && o2 = ok(fn_update(s, "vm", V), r)) proof
          fix regs o2
          assume hro h2
          show := apply(mp.dq_q, {s}, {phead}, {M}, {l}, {0}, {regs}, {o2}, hw, hu, hph, mb, hl, simp(), arith(lo, ln), l0, H, hro, h2)
        qed
        have cc := apply(gc.contract_callV[P := v. mallocng_specs.dequeued(V0, v, OB, phead, M)], ths, hw, apply(gc.regs2_ex, hph, mb), arith(), hg, qa, b)
        have c1: (ex v. v in x86_64_linux.Vm && x9 = exc(pair(fn_update(s, "vm", v), pair(M, x4)), pair("raise", OVF))) -> runs(SPEC, s, o) proof
          assume h
          obtain v, hv hx from h
          have oe: o = exc(fn_update(s, "vm", v), OVF) by simp(rewrite(hx, he))
          show := rewrite(sym(oe), mp(all_elim(sov, {v}), hv))
        qed
        have c2: (ex V r. (V in x86_64_linux.Vm && mallocng_specs.dequeued(V0, V, OB, phead, M)) && x9 = ok(pair(fn_update(s, "vm", V), pair(M, x4)), empty)) -> runs(SPEC, s, o) proof
          assume h
          obtain V, h1 from h
          obtain r, hV hq hx from h1
          have oe: o = ok(fn_update(s, "vm", V), M) by simp(rewrite(hx, he))
          have ht: mallocng_specs.head_taken(V0, V, OB, phead, M) by defs(taut(hn, hq), mallocng_specs.head_taken)
          show := rewrite(sym(oe), mp(all_elim(sret, {V}), hV, ht))
        qed
        show by taut(cc, c1, c2)
      qed
      show by taut(z, nz)
    qed
    show by taut(np, yp)
  qed
qed

// dequeue's machine code implements its purpose
theorem mp.dq_implements: all statics. tr.implements_at(4206409, mallocng_specs.dequeue_spec_fun(), 4198400, text.code, statics)
proof
  fix statics
  have st := mp(all_elim(tr.implements_refine, {4206409}, {c_src_malloc_mallocng_malloc_cfg.dequeue_fun}, {c_src_malloc_mallocng_malloc.dequeue_fun},
    {4198400}, {text.code}, {statics}), all_elim(dqtc.implements, {statics}), dequeue_ref)
  show := mp(all_elim(tr.implements_refine, {4206409}, {c_src_malloc_mallocng_malloc.dequeue_fun}, {mallocng_specs.dequeue_spec_fun()},
    {4198400}, {text.code}, {statics}), st, mp.dq_fun)
qed

// dequeue_head as a C function value, for every callee refining dequeue's
// purpose
theorem mp.dqh_fun: all g. (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(g[regs], s, o) -> runs(mallocng_specs.dequeue_spec_fun()[regs], s, o)) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
    runs(c_src_malloc_mallocng_malloc.dequeue_head_fun(g)[regs], s, o) -> runs(mallocng_specs.dequeue_head_spec_fun()[regs], s, o))
proof
  fix g
  assume hg
  have hm: all regs. refines(c_src_malloc_mallocng_malloc.dequeue_head(bits_of_int(64, regs[0]), g), mallocng_specs.dequeue_head_spec(bits_of_int(64, regs[0])), abi.World) proof
    fix regs
    show := mp(all_elim(mp.dqh, {bits_of_int(64, regs[0])}, {g}), simp(), hg)
  qed
  show by defs(apply(g.fun_res[n := 1, w := 64], hm), c_src_malloc_mallocng_malloc.dequeue_head_fun, mallocng_specs.dequeue_head_spec_fun, letin)
qed

// dequeue_head's machine code (linked with dequeue's) implements its purpose
theorem mp.dqh_implements: all statics. tr.implements_at(4206554, mallocng_specs.dequeue_head_spec_fun(), 4198400, text.code, statics)
proof
  fix statics
  let G := c_src_malloc_mallocng_malloc_cfg.dequeue_fun
  // dequeue's machine-level callee: its CFG form refines its code, its code its purpose
  have h: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(G[regs], s, o) ->
      runs(mallocng_specs.dequeue_spec_fun()[regs], s, o) proof
    fix regs s o
    assume h1 hl hs hr
    show := mp(all_elim(mp.dq_fun, {regs}, {s}, {o}), h1, hl, hs, mp(all_elim(dequeue_ref, {regs}, {s}, {o}), h1, hl, hs, hr))
  qed
  have c2 := mp(all_elim(mp.dqh_fun, {G}), h)
  have r: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
      runs(c_src_malloc_mallocng_malloc_cfg.dequeue_head_fun(G)[regs], s, o) -> runs(mallocng_specs.dequeue_head_spec_fun()[regs], s, o) proof
    fix regs s o
    assume h1 hl hs hr
    show := mp(all_elim(c2, {regs}, {s}, {o}), h1, hl, hs, mp(all_elim(dequeue_head_ref, {G}, {regs}, {s}, {o}), h1, hl, hs, hr))
  qed
  show := mp(all_elim(tr.implements_refine, {4206554}, {c_src_malloc_mallocng_malloc_cfg.dequeue_head_fun(G)}, {mallocng_specs.dequeue_head_spec_fun()},
    {4198400}, {text.code}, {statics}), all_elim(dqhtc.linked, {statics}), r)
qed

// ----------------------------------------------------------------------
//  queue, free_meta: their code refines their purpose
// queue's code by its purpose: m joins the list at *phead at its end,
// nothing but the links and the head word written -- its effect
// (`ms.qu_run`) is that (`mp.qu_done`); the list and m's joinability give
// its precondition (`mp.qu_pre`). Its a_crash calls unreached: any callee.
theorem mp.qu: all phead m g. phead in bits(64) -> m in bits(64) ->
  refines(c_src_malloc_mallocng_malloc.queue(phead, m, g), mallocng_specs.queue_spec(phead, m), abi.World)
proof
  fix phead m g
  assume hp hm
  have gg: all s o. s in abi.World -> runs(c_src_malloc_mallocng_malloc.queue(phead, m, g), s, o) -> runs(mallocng_specs.queue_spec(phead, m), s, o) proof
    fix s o
    assume hw hr
    let V0 := s.vm
    let OB := s.objs
    have pu := apply(g.runs_univ, hr)
    have hu: s in univ(1) by simp(pu)
    let PRE := ex x2. x2 in list_type(omega) && (mallocng_specs.list_at(V0, OB, phead, x2) && mallocng_specs.joinable(V0, OB, phead, x2, m))
    have np: !PRE -> runs(mallocng_specs.queue_spec(phead, m), s, o) proof
      assume hn0
      show by simp(pu, hn0, keep(abi.overflow, mallocng_specs.list_at, mallocng_specs.joinable, mallocng_specs.queued))
    qed
    have yp: PRE -> runs(mallocng_specs.queue_spec(phead, m), s, o) proof
      assume hpre
      obtain l, hl hq from hpre
      have H: mallocng_specs.list_at(V0, OB, phead, l) by taut(hq)
      have J: mallocng_specs.joinable(V0, OB, phead, l, m) by taut(hq)
      have {pv = mem, pb = bytes} := apply(ms.world_parts, hw)
      have qp := apply(mp.qu_pre[vm := V0, objs := OB, phead := phead, m := m, l := l], pb, hp, hm, hl, H, J)
      have oe := apply(ms.qu_run, {phead}, {m}, {g}, {s}, {o}, hp, hm, hw, hu, qp, hr)
      let V1 := mallocng_specs.queue_vm(V0, phead, m)
      let S1 := fn_update(s, "vm", V1)
      have {vt = mem} := apply(ms.quvm_vm, {V0}, {phead}, {m}, pv, simp(hu), hp, hm)
      have q := apply(mp.qu_done[vm := V0, objs := OB, phead := phead, m := m], pv, pb, hp, hm)
      let X2 := ok(pair(S1, empty), empty)
      have ex: ex x4. (x4 in x86_64_linux.Vm && mallocng_specs.queued(V0, fn_update(s, "vm", x4).vm, fn_update(s, "vm", x4).objs, phead, m)) &&
          X2 = ok(pair(fn_update(s, "vm", x4), empty), empty)
        by ex_intro({V1}, taut(vt, (mallocng_specs.queued(V0, S1.vm, S1.objs, phead, m) by simp(q)), refl({X2})))
      have b: letin(s.vm, x3. any_rel(x4. x4 in x86_64_linux.Vm && mallocng_specs.queued(x3, fn_update(s, "vm", x4).vm, fn_update(s, "vm", x4).objs, phead, m),
          x4. letin(fn_update(s, "vm", x4), x5. X2 = ok(pair(x5, empty), empty))))
        by defs(taut(ex), letin, any_rel)
      have pu1: pair(s, ok(S1, empty)) in univ(1) by simp(rewrite(oe, pu))
      have c := apply(ct.contract_done[P := x0. ex x2. x2 in list_type(omega) &&
          (mallocng_specs.list_at(x0.vm, x0.objs, phead, x2) && mallocng_specs.joinable(x0.vm, x0.objs, phead, x2, m)),
        B := x0 x2. letin(x0.vm, x3. any_rel(x4. x4 in x86_64_linux.Vm && mallocng_specs.queued(x3, fn_update(x0, "vm", x4).vm, fn_update(x0, "vm", x4).objs, phead, m),
          x4. letin(fn_update(x0, "vm", x4), x5. x2 = ok(pair(x5, empty), empty)))),
        s := s, s1 := S1], hpre, b, pu1)
      show by defs(rewrite(sym(oe), c), mallocng_specs.queue_spec)
    qed
    show by taut(np, yp)
  qed
  show gg
qed

// queue as a C function value (any a_crash)
theorem mp.qu_fun: all g regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
  runs(c_src_malloc_mallocng_malloc.queue_fun(g)[regs], s, o) -> runs(mallocng_specs.queue_spec_fun()[regs], s, o)
proof
  fix g
  have hm: all regs. refines(c_src_malloc_mallocng_malloc.queue(bits_of_int(64, regs[0]), bits_of_int(64, regs[1]), g), mallocng_specs.queue_spec(bits_of_int(64, regs[0]), bits_of_int(64, regs[1])), abi.World) proof
    fix regs
    show := mp(all_elim(mp.qu, {bits_of_int(64, regs[0])}, {bits_of_int(64, regs[1])}, {g}), simp(), simp())
  qed
  show by defs(apply(g.fun_void[n := 2], hm), c_src_malloc_mallocng_malloc.queue_fun, mallocng_specs.queue_spec_fun)
qed

// queue's contract at a call (its C function value), m joinable to the
// list l at *phead: an overflow, or the memory some V it is for (`queued`)
theorem mp.qu_q: all t phead m l regs o2. t in abi.World -> t in univ(1) -> phead in bits(64) -> m in bits(64) ->
  l in list_type(omega) -> mallocng_specs.list_at(t.vm, t.objs, phead, l) -> mallocng_specs.joinable(t.vm, t.objs, phead, l, m) ->
  gc.regs_ok(regs, seq_concat(seq_one(gimple.arg(64, phead)), seq_one(gimple.arg(64, m)))) ->
  runs(mallocng_specs.queue_spec_fun()[regs], t, o2) ->
  (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex V r. (V in x86_64_linux.Vm && mallocng_specs.queued(t.vm, V, t.objs, phead, m)) && o2 = ok(fn_update(t, "vm", V), r))
proof
  fix t phead m l regs o2
  assume hw htu hp hm hl H J hro h
  let OVF := exc_val("stack_overflow", empty)
  let T0 := t.vm
  have hpre: ex x2. x2 in list_type(omega) && (mallocng_specs.list_at(t.vm, t.objs, phead, x2) && mallocng_specs.joinable(t.vm, t.objs, phead, x2, m))
    by ex_intro({l}, taut(hl, H, J))
  have rl rn r0 r1 := apply(gc.regs2, hp, hm, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, mallocng_specs.queue_spec_fun, app_fn_build, ra in h
  have o2l: ord_le(2, seq_len(regs)) by defs(simp(rn), ord_le)
  have bp: bits_of_int(64, regs[0]) = phead && bits_of_int(64, regs[1]) = m by defs(simp(r0, r1, hp, hm), bits_of_int, pow2)
  have b := apply(g.runs_elim, h)
  have b2: bind_rel(mallocng_specs.queue_spec(phead, m), t, x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o2 = ok(x3, pair(x5, x6)))),
      x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3)) by simp(b, o2l, bp, keep(bind_rel, mallocng_specs.queue_spec))
  obtain o3, hs3 hk3 from expand(b2, bind_rel)
  have {pv = mem, pb = bytes} := apply(ms.world_parts, hw)
  have ci := apply(ct.contract_inv[P := x0. ex x2. x2 in list_type(omega) &&
      (mallocng_specs.list_at(x0.vm, x0.objs, phead, x2) && mallocng_specs.joinable(x0.vm, x0.objs, phead, x2, m)),
    B := x0 x2. letin(x0.vm, x3. any_rel(x4. x4 in x86_64_linux.Vm && mallocng_specs.queued(x3, fn_update(x0, "vm", x4).vm, fn_update(x0, "vm", x4).objs, phead, m),
      x4. letin(fn_update(x0, "vm", x4), x5. x2 = ok(pair(x5, empty), empty)))), s := t, o := o3],
    hpre, pv, expand(hs3, mallocng_specs.queue_spec))
  // an overflow: the call's
  have c1: (ex v. v in x86_64_linux.Vm && o3 = exc(fn_update(t, "vm", v), OVF)) ->
      (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), OVF)) proof
    assume hx
    obtain v, hv ho from hx
    have e2: o2 = exc(fn_update(t, "vm", v), OVF) by simp(rewrite(ho, hk3))
    show by ex_intro({v}, taut(hv, e2))
  qed
  // queue's memory: one it is for (one exists: its code's, `mp.qu_done`)
  have c2: (ex x2. letin(T0, x3. any_rel(x4. x4 in x86_64_linux.Vm && mallocng_specs.queued(x3, fn_update(t, "vm", x4).vm, fn_update(t, "vm", x4).objs, phead, m),
        x4. letin(fn_update(t, "vm", x4), x5. x2 = ok(pair(x5, empty), empty)))) &&
      ((fst(x2) = 0 && o3 = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && o3 = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
        ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && o3 = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && o3 = diverge(snd(x2)))))) ->
      (ex V r. (V in x86_64_linux.Vm && mallocng_specs.queued(T0, V, t.objs, phead, m)) && o2 = ok(fn_update(t, "vm", V), r)) proof
    assume hx
    obtain x2, hB hout from hx
    have q := apply(mp.qu_done[vm := T0, objs := t.objs, phead := phead, m := m], pv, pb, hp, hm)
    have {vt = mem} := apply(ms.quvm_vm, {T0}, {phead}, {m}, pv, simp(htu), hp, hm)
    have ne: ex x4. x4 in x86_64_linux.Vm && mallocng_specs.queued(T0, fn_update(t, "vm", x4).vm, fn_update(t, "vm", x4).objs, phead, m)
      by ex_intro({mallocng_specs.queue_vm(T0, phead, m)}, taut(vt,
        (mallocng_specs.queued(T0, fn_update(t, "vm", mallocng_specs.queue_vm(T0, phead, m)).vm, fn_update(t, "vm", mallocng_specs.queue_vm(T0, phead, m)).objs, phead, m) by simp(q))))
    obtain V, hV hS hk from apply(g.any_e, ne, expand(hB, letin))
    have x2e: x2 = ok(pair(fn_update(t, "vm", V), empty), empty) by simp(expand(hk, letin))
    have o3e: o3 = ok(fn_update(t, "vm", V), empty) by simp(rewrite(x2e, hout))
    have k4 := rewrite(o3e, hk3)
    have k5: any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o2 = ok(fn_update(t, "vm", V), pair(x5, x6)))) by simp(k4, keep(any_rel))
    have nb: ex y. y in bits(64) by ex_intro({0}, simp())
    obtain y1, hy1 k6 from apply(g.any_e, nb, k5)
    obtain y2, hy2 k7 from apply(g.any_e, nb, k6)
    have hS2: mallocng_specs.queued(T0, V, t.objs, phead, m) by simp(hS)
    show by ex_intro({V}, {pair(y1, y2)}, taut(hV, hS2, k7))
  qed
  show by taut(ci, c1, c2)
qed

// free_meta's code by its purpose: m's meta cleared and m appended to the
// free metas' list -- its zero store keeps the list and makes m joinable
// (`mp.fm_pre`), then queue's contract (`mp.qu_q`) appends it
// (`mp.fm_done`); for every callee refining queue's purpose
theorem mp.fm: all m g. m in bits(64) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(g[regs], s, o) -> runs(mallocng_specs.queue_spec_fun()[regs], s, o)) ->
  refines(c_src_malloc_mallocng_malloc.free_meta(m, g), mallocng_specs.free_meta_spec(c_src_malloc_mallocng_malloc.__malloc_context, m), abi.World)
proof
  fix m g
  assume hm hg
  show proof
    fix s o
    assume hw hr
    let V0 := s.vm
    let OB := s.objs
    let FS := s.fs_base
    let CTX := c_src_malloc_mallocng_malloc.__malloc_context
    let PH := bits_add(64, CTX, 16)
    let ZV := mallocng_specs.zero_meta(V0, m)
    let W1 := fn_update(s, "vm", ZV)
    let SPEC := mallocng_specs.free_meta_spec(CTX, m)
    let OVF := exc_val("stack_overflow", empty)
    let Z := seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(0), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0)), seq_one(0))
    let PRE := (((int_lt(int_add(CTX, 16), int_pow(2, 64)) &&
        (ex x2. x2 in list_type(omega) && (mallocng_specs.list_at(V0, OB, PH, x2) && mallocng_specs.meta_joinable(V0, OB, PH, x2, m)))) &&
        abi.thread_ok(V0, FS)) && int_le(int_add(FS, 8), int_pow(2, 64))) && (int_le(int_add(FS, 8), m) || int_le(int_add(m, 40), FS))
    have pu := apply(g.runs_univ, hr)
    have hu: s in univ(1) by simp(pu)
    have vV vfun vdom vb := apply(ms.world_parts, hw)
    have np: !PRE -> runs(SPEC, s, o) proof
      assume hn
      show by simp(pu, hn, keep(abi.overflow, mallocng_specs.list_at, mallocng_specs.meta_joinable, mallocng_specs.meta_freed, abi.thread_ok))
    qed
    have yp: PRE -> runs(SPEC, s, o) proof
      assume hp
      have hctx hex ths hfs hap := hp
      obtain l, hl hq from hex
      have H: mallocng_specs.list_at(V0, OB, PH, l) by taut(hq)
      have J: mallocng_specs.meta_joinable(V0, OB, PH, l, m) by taut(hq)
      have {hnz = nonnull, hus = write} := expand(J, mallocng_specs.meta_joinable)
      // (the spec's outcomes: an overflow, any memory; m's meta freed)
      have sov: all v. v in x86_64_linux.Vm -> runs(SPEC, s, exc(fn_update(s, "vm", v), OVF)) proof
        fix v
        assume hv
        have vu := apply(x86.vm_univ, hv)
        have eu: OVF in univ(1) by defs(simp(), exc_val)
        have pu2: pair(s, exc(fn_update(s, "vm", v), OVF)) in univ(1) by simp(hu, vu, eu)
        have c := apply(ct.contract_ovf[P := x0. (((int_lt(int_add(CTX, 16), int_pow(2, 64)) &&
            (ex x2. x2 in list_type(omega) && (mallocng_specs.list_at(x0.vm, x0.objs, PH, x2) && mallocng_specs.meta_joinable(x0.vm, x0.objs, PH, x2, m)))) &&
            abi.thread_ok(x0.vm, x0.fs_base)) && int_le(int_add(x0.fs_base, 8), int_pow(2, 64))) &&
            (int_le(int_add(x0.fs_base, 8), m) || int_le(int_add(m, 40), x0.fs_base)),
          B := x0 x2. letin(x0.vm, x3. any_rel(x4. x4 in x86_64_linux.Vm && mallocng_specs.meta_freed(x3, fn_update(x0, "vm", x4).vm, fn_update(x0, "vm", x4).objs, PH, m),
            x4. letin(fn_update(x0, "vm", x4), x5. x2 = ok(pair(x5, empty), empty)))),
          s := s, v := v], hp, hv, pu2)
        show by defs(c, mallocng_specs.free_meta_spec)
      qed
      have sdone: all V. V in x86_64_linux.Vm -> mallocng_specs.meta_freed(V0, V, OB, PH, m) -> runs(SPEC, s, ok(fn_update(s, "vm", V), empty)) proof
        fix V
        assume hV hf
        let S1 := fn_update(s, "vm", V)
        let X2 := ok(pair(S1, empty), empty)
        have ex: ex x4. (x4 in x86_64_linux.Vm && mallocng_specs.meta_freed(V0, fn_update(s, "vm", x4).vm, fn_update(s, "vm", x4).objs, PH, m)) &&
            X2 = ok(pair(fn_update(s, "vm", x4), empty), empty)
          by ex_intro({V}, taut(hV, (mallocng_specs.meta_freed(V0, S1.vm, S1.objs, PH, m) by simp(hf)), refl({X2})))
        have b: letin(s.vm, x3. any_rel(x4. x4 in x86_64_linux.Vm && mallocng_specs.meta_freed(x3, fn_update(s, "vm", x4).vm, fn_update(s, "vm", x4).objs, PH, m),
            x4. letin(fn_update(s, "vm", x4), x5. X2 = ok(pair(x5, empty), empty))))
          by defs(taut(ex), letin, any_rel)
        have vu := apply(x86.vm_univ, hV)
        have pu1: pair(s, ok(S1, empty)) in univ(1) by simp(hu, vu)
        have c := apply(ct.contract_done[P := x0. (((int_lt(int_add(CTX, 16), int_pow(2, 64)) &&
            (ex x2. x2 in list_type(omega) && (mallocng_specs.list_at(x0.vm, x0.objs, PH, x2) && mallocng_specs.meta_joinable(x0.vm, x0.objs, PH, x2, m)))) &&
            abi.thread_ok(x0.vm, x0.fs_base)) && int_le(int_add(x0.fs_base, 8), int_pow(2, 64))) &&
            (int_le(int_add(x0.fs_base, 8), m) || int_le(int_add(m, 40), x0.fs_base)),
          B := x0 x2. letin(x0.vm, x3. any_rel(x4. x4 in x86_64_linux.Vm && mallocng_specs.meta_freed(x3, fn_update(x0, "vm", x4).vm, fn_update(x0, "vm", x4).objs, PH, m),
            x4. letin(fn_update(x0, "vm", x4), x5. x2 = ok(pair(x5, empty), empty)))),
          s := s, s1 := S1], hp, b, pu1)
        show by defs(c, mallocng_specs.free_meta_spec)
      qed
      // m's 40 bytes zeroed: the world W1
      have zl := apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, apply(tr.zeros_snoc, tr.zeros_one)))))))))))))))))))))))))))))))))))))))
      have ln: seq_len(Z) = 40 by arith()
      have md: g.mem_defined(s, m, 0, seq_len(Z), true) by simp(ln, hnz, hus, hm)
      have sd := apply(g.stz_det, {s}, {m}, {0}, {Z}, hu, hm, simp(), zl, md, vV, vfun, vdom)
      have ez: fn_update(s, "vm", fn_update(V0, "bytes", x86_64_linux.store_le(V0.bytes, int_add(m, 0), seq_len(Z), 0))) = W1 by defs(simp(ln, hm), mallocng_specs.zero_meta)
      have b1 := apply(g.bind_inv, apply(g.runs_elim, expand(hr, c_src_malloc_mallocng_malloc.free_meta)), rewrite(ez, sd))
      have w1W w1u := apply(tr.world_store, {s}, {m}, {40}, {0}, hw, hu, hm)
      have zw: fn_update(s, "vm", fn_update(V0, "bytes", x86_64_linux.store_le(V0.bytes, m, 40, 0))) = W1 by defs(simp(), mallocng_specs.zero_meta)
      have hw1 := rewrite(zw, w1W)
      have hu1 := rewrite(zw, w1u)
      // ctx + 16
      have cb: CTX in bits(64) by defs(simp(), c_src_malloc_mallocng_malloc.__malloc_context)
      have sv: gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), 16) = 16 by defs(simp(), gimple.sval)
      have pd := rewrite(sv, apply(g.padd_det, {W1}, {CTX}, {16}, hu1, cb, simp(), simp(sv, cb), simp(sv, hctx)))
      have ep: int_add(CTX, 16) = PH by simp(hctx, cb)
      have b2 := apply(g.bind_inv, b1, rewrite(ep, pd))
      have phb: PH in bits(64) by simp()
      // the list kept, m joinable; the thread pointer's word not m's
      have lz jz := apply(mp.fm_pre[vm := V0, objs := OB, phead := PH, m := m, l := l], vV, vb, phb, hm, hl, H, J)
      have fsb: FS in bits(64) by simp(expand(hw, abi.World))
      have fso: FS in omega by simp(fsb)
      have mo: m in omega by simp(hm)
      have ml: int_le(int_add(m, 40), 18446744073709551616) by arith(expand(J, mallocng_specs.meta_joinable))
      have le8: all j. j in omega -> int_lt(j, 8) ->
          x86_64_linux.store_le(V0.bytes, m, 40, 0)[bits_add(64, FS, bits_of_int(64, j))] = V0.bytes[bits_add(64, FS, bits_of_int(64, j))] proof
        fix j
        assume hj hjl
        have ba: bits_add(64, FS, bits_of_int(64, j)) = int_add(FS, j) by defs(arith(fso, hj, hjl, hfs), bits_add, bits_of_int, pow2)
        have xb: int_add(FS, j) in bits(64) by simp(fso, hj, (int_lt(int_add(FS, j), 18446744073709551616) by arith(fso, hj, hjl, hfs)))
        have so := apply(mp.st_out[B := V0.bytes, c := m, k := 40, v := 0, x := int_add(FS, j)], xb, hm, simp(), ml, arith(hap, fso, hj, hjl, mo))
        show by simp(ba, so)
      qed
      have leq := apply(tr.le_eq8, {x86_64_linux.store_le(V0.bytes, m, 40, 0)}, {V0.bytes}, {FS}, le8)
      have tk := apply(ms.thread_keep, {V0}, {x86_64_linux.store_le(V0.bytes, m, 40, 0)}, {FS}, ths, leq)
      have ths1: gc.sound(W1) by defs(simp(tk), mallocng_specs.zero_meta)
      // the call: queue's contract on W1 -- an overflow, or m queued
      have H1: mallocng_specs.list_at(W1.vm, W1.objs, PH, l) by simp(lz)
      have J1: mallocng_specs.joinable(W1.vm, W1.objs, PH, l, m) by simp(jz)
      have qa: all regs o2. gc.regs_ok(regs, seq_concat(seq_one(gimple.arg(64, PH)), seq_one(gimple.arg(64, m)))) -> runs(mallocng_specs.queue_spec_fun()[regs], W1, o2) ->
          (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(W1, "vm", v), OVF)) ||
          (ex V r. (V in x86_64_linux.Vm && mallocng_specs.queued(W1.vm, V, W1.objs, PH, m)) && o2 = ok(fn_update(W1, "vm", V), r)) proof
        fix regs o2
        assume hro h2
        show := apply(mp.qu_q, {W1}, {PH}, {m}, {l}, {regs}, {o2}, hw1, hu1, phb, hm, hl, H1, J1, hro, h2)
      qed
      have cc := apply(gc.contract_callV[P := v. mallocng_specs.queued(W1.vm, v, W1.objs, PH, m)], ths1, hw1, apply(gc.regs2_ex, phb, hm), arith(), hg, qa, b2)
      have c1: (ex v. v in x86_64_linux.Vm && o = exc(fn_update(W1, "vm", v), OVF)) -> runs(SPEC, s, o) proof
        assume h
        obtain v, hv ho from h
        have e: o = exc(fn_update(s, "vm", v), OVF) by simp(ho)
        show := rewrite(sym(e), mp(all_elim(sov, {v}), hv))
      qed
      have c2: (ex V r. (V in x86_64_linux.Vm && mallocng_specs.queued(W1.vm, V, W1.objs, PH, m)) && o = ok(fn_update(W1, "vm", V), empty)) -> runs(SPEC, s, o) proof
        assume h
        obtain V, h1 from h
        obtain r, hV hQ ho from h1
        have e: o = ok(fn_update(s, "vm", V), empty) by simp(ho)
        have q2: mallocng_specs.queued(ZV, V, OB, PH, m) by simp(hQ)
        have f := apply(mp.fm_done[vm := V0, V := V, objs := OB, phead := PH, m := m], vV, vb, phb, hm, q2)
        show := rewrite(sym(e), mp(all_elim(sdone, {V}), hV, f))
      qed
      show by taut(cc, c1, c2)
    qed
    show by taut(np, yp)
  qed
qed

// free_meta as a C function value, for every callee refining queue's purpose
theorem mp.fm_fun: all g. (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(g[regs], s, o) -> runs(mallocng_specs.queue_spec_fun()[regs], s, o)) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
    runs(c_src_malloc_mallocng_malloc.free_meta_fun(g)[regs], s, o) -> runs(mallocng_specs.free_meta_spec_fun(c_src_malloc_mallocng_malloc.__malloc_context)[regs], s, o))
proof
  fix g
  assume hg
  have hm: all regs. refines(c_src_malloc_mallocng_malloc.free_meta(bits_of_int(64, regs[0]), g), mallocng_specs.free_meta_spec(c_src_malloc_mallocng_malloc.__malloc_context, bits_of_int(64, regs[0])), abi.World) proof
    fix regs
    show := mp(all_elim(mp.fm, {bits_of_int(64, regs[0])}, {g}), simp(), hg)
  qed
  show by defs(apply(g.fun_void[n := 1], hm), c_src_malloc_mallocng_malloc.free_meta_fun, mallocng_specs.free_meta_spec_fun)
qed

// queue's machine code (with a_crash's contract) implements its purpose
theorem mp.qu_implements: all statics. tr.implements_at(4206220, mallocng_specs.queue_spec_fun(), 4198400, text.code, statics)
proof
  fix statics
  let A := mallocng_specs.a_crash_spec_fun()
  have r: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
      runs(c_src_malloc_mallocng_malloc_cfg.queue_fun(A)[regs], s, o) -> runs(mallocng_specs.queue_spec_fun()[regs], s, o) proof
    fix regs s o
    assume h1 hl hs hr
    show := mp(all_elim(mp.qu_fun, {A}, {regs}, {s}, {o}), h1, hl, hs, mp(all_elim(queue_ref, {A}, {regs}, {s}, {o}), h1, hl, hs, hr))
  qed
  show := mp(all_elim(tr.implements_refine, {4206220}, {c_src_malloc_mallocng_malloc_cfg.queue_fun(A)}, {mallocng_specs.queue_spec_fun()},
    {4198400}, {text.code}, {statics}), all_elim(qutc.linked, {statics}), r)
qed

// free_meta's machine code (linked with queue's) implements its purpose
theorem mp.fm_implements: all statics. tr.implements_at(4206612, mallocng_specs.free_meta_spec_fun(c_src_malloc_mallocng_malloc.__malloc_context), 4198400, text.code, statics)
proof
  fix statics
  let G := c_src_malloc_mallocng_malloc_cfg.queue_fun(mallocng_specs.a_crash_spec_fun())
  // queue's machine-level callee: its CFG form refines its code, its code its purpose
  have h: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(G[regs], s, o) ->
      runs(mallocng_specs.queue_spec_fun()[regs], s, o) proof
    fix regs s o
    assume h1 hl hs hr
    show := mp(all_elim(mp.qu_fun, {mallocng_specs.a_crash_spec_fun()}, {regs}, {s}, {o}), h1, hl, hs,
      mp(all_elim(queue_ref, {mallocng_specs.a_crash_spec_fun()}, {regs}, {s}, {o}), h1, hl, hs, hr))
  qed
  have c2 := mp(all_elim(mp.fm_fun, {G}), h)
  have r: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
      runs(c_src_malloc_mallocng_malloc_cfg.free_meta_fun(G)[regs], s, o) ->
      runs(mallocng_specs.free_meta_spec_fun(c_src_malloc_mallocng_malloc.__malloc_context)[regs], s, o) proof
    fix regs s o
    assume h1 hl hs hr
    show := mp(all_elim(c2, {regs}, {s}, {o}), h1, hl, hs, mp(all_elim(free_meta_ref, {G}, {regs}, {s}, {o}), h1, hl, hs, hr))
  qed
  show := mp(all_elim(tr.implements_refine, {4206612}, {c_src_malloc_mallocng_malloc_cfg.free_meta_fun(G)},
    {mallocng_specs.free_meta_spec_fun(c_src_malloc_mallocng_malloc.__malloc_context)}, {4198400}, {text.code}, {statics}), all_elim(fmtc.linked, {statics}), r)
qed

// dequeue_head's contract at a call (its C function value): an overflow,
// or the list's head h returned and taken out (`head_taken`) -- for its
// caller `__malloc_alloc_meta`
theorem mp.dqh_q: all t phead l regs o2. t in abi.World -> t in univ(1) -> phead in bits(64) ->
  l in list_type(omega) -> mallocng_specs.list_at(t.vm, t.objs, phead, l) -> abi.thread_ok(t.vm, t.fs_base) ->
  gc.regs_ok(regs, seq_one(gimple.arg(64, phead))) ->
  runs(mallocng_specs.dequeue_head_spec_fun()[regs], t, o2) ->
  (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex V h r. ((V in x86_64_linux.Vm && mallocng_specs.is_head(t.vm, t.objs, phead, h)) &&
     mallocng_specs.head_taken(t.vm, V, t.objs, phead, h)) && o2 = ok(fn_update(t, "vm", V), pair(h, r)))
proof
  fix t phead l regs o2
  assume hw htu hp hl H hth hro h
  let OVF := exc_val("stack_overflow", empty)
  let T0 := t.vm
  let O := t.objs
  have hpre: (ex x2. x2 in list_type(omega) && mallocng_specs.list_at(t.vm, t.objs, phead, x2)) && abi.thread_ok(t.vm, t.fs_base)
    by taut((ex x2. x2 in list_type(omega) && mallocng_specs.list_at(t.vm, t.objs, phead, x2) by ex_intro({l}, taut(hl, H))), hth)
  have rl rn r0 := apply(gc.regs1, hp, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, mallocng_specs.dequeue_head_spec_fun, app_fn_build, ra in h
  have o1l: ord_le(1, seq_len(regs)) by defs(simp(rn), ord_le)
  have bp: bits_of_int(64, regs[0]) = phead by defs(simp(r0, hp), bits_of_int, pow2)
  have b := apply(g.runs_elim, h)
  let K(s3, v, o) := letin(v, x5. bind_rel(gimple.result(64, x5), s3, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. o = ok(x6, pair(x8, x9)))), x6 x7. o = exc(x6, x7), x6. o = diverge(x6)))
  have b1: bind_rel(mallocng_specs.dequeue_head_spec(bits_of_int(64, regs[0])), t, x3 x4. K(x3, x4, o2), x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3))
    by taut(b, o1l)
  have b2 := rewrite(bp, b1)
  obtain o3, hs3 hk3 from expand(b2, bind_rel)
  have {pv = mem, pb = bytes} := apply(ms.world_parts, hw)
  have ci := apply(ct.contract_inv[P := x0. (ex x2. x2 in list_type(omega) && mallocng_specs.list_at(x0.vm, x0.objs, phead, x2)) && abi.thread_ok(x0.vm, x0.fs_base),
    B := x0 x2. letin(x0.vm, x3. any_rel(x4. x4 in bits(64) && mallocng_specs.is_head(x3, x0.objs, phead, x4),
      x4. letin(x4, x5. any_rel(x6. x6 in x86_64_linux.Vm && mallocng_specs.head_taken(x3, fn_update(x0, "vm", x6).vm, fn_update(x0, "vm", x6).objs, phead, x5),
        x6. letin(fn_update(x0, "vm", x6), x7. x2 = exc(pair(x7, empty), pair("ret", x5))))))), s := t, o := o3],
    hpre, pv, expand(hs3, mallocng_specs.dequeue_head_spec))
  // an overflow: the call's
  have c1: (ex v. v in x86_64_linux.Vm && o3 = exc(fn_update(t, "vm", v), OVF)) ->
      (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), OVF)) proof
    assume hx
    obtain v, hv ho from hx
    have e2: o2 = exc(fn_update(t, "vm", v), OVF) by simp(rewrite(ho, hk3))
    show by ex_intro({v}, taut(hv, e2))
  qed
  // the head chosen (one exists: the head word's, `mp.head_is`), then a
  // memory with it taken (one exists: as before for none, else dequeue's
  // code's, `mp.dq_done`); its value returned
  have c2: (ex x2. letin(T0, x3. any_rel(x4. x4 in bits(64) && mallocng_specs.is_head(x3, O, phead, x4),
        x4. letin(x4, x5. any_rel(x6. x6 in x86_64_linux.Vm && mallocng_specs.head_taken(x3, fn_update(t, "vm", x6).vm, fn_update(t, "vm", x6).objs, phead, x5),
          x6. letin(fn_update(t, "vm", x6), x7. x2 = exc(pair(x7, empty), pair("ret", x5))))))) &&
      ((fst(x2) = 0 && o3 = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && o3 = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
        ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && o3 = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && o3 = diverge(snd(x2)))))) ->
      (ex V h r. ((V in x86_64_linux.Vm && mallocng_specs.is_head(T0, O, phead, h)) && mallocng_specs.head_taken(T0, V, O, phead, h)) && o2 = ok(fn_update(t, "vm", V), pair(h, r))) proof
    assume hx
    obtain x2, hB hout from hx
    have {ih = is_head} := apply(mp.head_is[vm := T0, objs := O, phead := phead, l := l], pb, hp, hl, H)
    have rb: mallocng_specs.rd64(T0, phead) in bits(64) by defs(simp(), mallocng_specs.rd64)
    have ne1: ex x4. x4 in bits(64) && mallocng_specs.is_head(T0, O, phead, x4) by ex_intro({mallocng_specs.rd64(T0, phead)}, taut(rb, ih))
    obtain hd, hhb hhi hk from apply(g.any_e, ne1, expand(hB, letin))
    // a memory with hd taken
    have wt: ex x6. x6 in x86_64_linux.Vm && mallocng_specs.head_taken(T0, fn_update(t, "vm", x6).vm, fn_update(t, "vm", x6).objs, phead, hd) proof
      have z: hd = 0 -> ex x6. x6 in x86_64_linux.Vm && mallocng_specs.head_taken(T0, fn_update(t, "vm", x6).vm, fn_update(t, "vm", x6).objs, phead, hd) proof
        assume hz
        have ht: mallocng_specs.head_taken(T0, fn_update(t, "vm", T0).vm, fn_update(t, "vm", T0).objs, phead, hd)
          by defs(simp(hz), mallocng_specs.head_taken)
        show by ex_intro({T0}, taut(pv, ht))
      qed
      have nz: !(hd = 0) -> ex x6. x6 in x86_64_linux.Vm && mallocng_specs.head_taken(T0, fn_update(t, "vm", x6).vm, fn_update(t, "vm", x6).objs, phead, hd) proof
        assume hz
        let DV := mallocng_specs.dequeue_vm(T0, phead, hd)
        have q := apply(mp.dq_done[vm := T0, objs := O, phead := phead, m := hd], pv, pb, hp, hhb)
        have {vt = mem} := apply(ms.dqvm_vm, {T0}, {phead}, {hd}, pv, simp(htu), hp, hhb)
        have ht: mallocng_specs.head_taken(T0, fn_update(t, "vm", DV).vm, fn_update(t, "vm", DV).objs, phead, hd)
          by defs(simp(hz, q, keep(mallocng_specs.dequeued)), mallocng_specs.head_taken)
        show by ex_intro({DV}, taut(vt, ht))
      qed
      show by taut(z, nz)
    qed
    obtain V, hV hT hk2 from apply(g.any_e, wt, hk)
    have o3e: o3 = ok(fn_update(t, "vm", V), hd) by simp(rewrite(hk2, hout))
    have k4 := rewrite(o3e, hk3)
    have k5: bind_rel(gimple.result(64, hd), fn_update(t, "vm", V), x6 x7. any_rel(x9. x9 in bits(64), x9. o2 = ok(x6, pair(x7, x9))), x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))
      by simp(expand(k4, letin), keep(bind_rel, any_rel, gimple.result))
    obtain o4, hr4 hc4 from expand(k5, bind_rel)
    have e4 := mp(all_elim(g.result64_inv, {fn_update(t, "vm", V)}, {hd}, {o4}), hhb, hr4)
    have k6: any_rel(x9. x9 in bits(64), x9. o2 = ok(fn_update(t, "vm", V), pair(hd, x9))) by simp(rewrite(e4, hc4), keep(any_rel))
    have nb: ex y. y in bits(64) by ex_intro({0}, simp())
    obtain y, hy k7 from apply(g.any_e, nb, k6)
    have hT2: mallocng_specs.head_taken(T0, V, O, phead, hd) by simp(hT)
    show by ex_intro({V}, {hd}, {y}, taut(hV, hhi, hT2, k7))
  qed
  show by taut(ci, c1, c2)
qed

// free_meta's contract at a call (its C function value, the context at
// ctx): an overflow, or m's meta freed onto the list at ctx + 16 -- for its
// callers (`__malloc_alloc_meta`'s caller alloc_group, free_group)
theorem mp.fm_q: all t ctx m l regs o2. t in abi.World -> t in univ(1) -> ctx in bits(64) -> m in bits(64) -> int_lt(int_add(ctx, 16), int_pow(2, 64)) ->
  l in list_type(omega) -> mallocng_specs.list_at(t.vm, t.objs, bits_add(64, ctx, 16), l) ->
  mallocng_specs.meta_joinable(t.vm, t.objs, bits_add(64, ctx, 16), l, m) ->
  abi.thread_ok(t.vm, t.fs_base) -> int_le(int_add(t.fs_base, 8), int_pow(2, 64)) ->
  (int_le(int_add(t.fs_base, 8), m) || int_le(int_add(m, 40), t.fs_base)) ->
  gc.regs_ok(regs, seq_one(gimple.arg(64, m))) ->
  runs(mallocng_specs.free_meta_spec_fun(ctx)[regs], t, o2) ->
  (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex V r. (V in x86_64_linux.Vm && mallocng_specs.meta_freed(t.vm, V, t.objs, bits_add(64, ctx, 16), m)) && o2 = ok(fn_update(t, "vm", V), r))
proof
  fix t ctx m l regs o2
  assume hw htu hc hm hcl hl H J hth hfb hfm hro h
  let OVF := exc_val("stack_overflow", empty)
  let T0 := t.vm
  let PH := bits_add(64, ctx, 16)
  have hpre: (((int_lt(int_add(ctx, 16), int_pow(2, 64)) && (ex x2. x2 in list_type(omega) && (mallocng_specs.list_at(t.vm, t.objs, PH, x2) &&
      mallocng_specs.meta_joinable(t.vm, t.objs, PH, x2, m)))) && abi.thread_ok(t.vm, t.fs_base)) &&
      int_le(int_add(t.fs_base, 8), int_pow(2, 64))) && (int_le(int_add(t.fs_base, 8), m) || int_le(int_add(m, 40), t.fs_base))
    by taut(hcl, (ex x2. x2 in list_type(omega) && (mallocng_specs.list_at(t.vm, t.objs, PH, x2) && mallocng_specs.meta_joinable(t.vm, t.objs, PH, x2, m))
      by ex_intro({l}, taut(hl, H, J))), hth, hfb, hfm)
  have rl rn r0 := apply(gc.regs1, hm, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, mallocng_specs.free_meta_spec_fun, app_fn_build, ra in h
  have o1l: ord_le(1, seq_len(regs)) by defs(simp(rn), ord_le)
  have bp: bits_of_int(64, regs[0]) = m by defs(simp(r0, hm), bits_of_int, pow2)
  have b := apply(g.runs_elim, h)
  have b2: bind_rel(mallocng_specs.free_meta_spec(ctx, m), t, x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o2 = ok(x3, pair(x5, x6)))),
      x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3)) by simp(b, o1l, bp, keep(bind_rel, mallocng_specs.free_meta_spec))
  obtain o3, hs3 hk3 from expand(b2, bind_rel)
  have {pv = mem, pb = bytes} := apply(ms.world_parts, hw)
  have ci := apply(ct.contract_inv[P := x0. (((int_lt(int_add(ctx, 16), int_pow(2, 64)) && (ex x2. x2 in list_type(omega) && (mallocng_specs.list_at(x0.vm, x0.objs, PH, x2) &&
      mallocng_specs.meta_joinable(x0.vm, x0.objs, PH, x2, m)))) && abi.thread_ok(x0.vm, x0.fs_base)) &&
      int_le(int_add(x0.fs_base, 8), int_pow(2, 64))) && (int_le(int_add(x0.fs_base, 8), m) || int_le(int_add(m, 40), x0.fs_base)),
    B := x0 x2. letin(x0.vm, x3. any_rel(x4. x4 in x86_64_linux.Vm && mallocng_specs.meta_freed(x3, fn_update(x0, "vm", x4).vm, fn_update(x0, "vm", x4).objs, PH, m),
      x4. letin(fn_update(x0, "vm", x4), x5. x2 = ok(pair(x5, empty), empty)))), s := t, o := o3],
    hpre, pv, expand(hs3, mallocng_specs.free_meta_spec))
  // an overflow: the call's
  have c1: (ex v. v in x86_64_linux.Vm && o3 = exc(fn_update(t, "vm", v), OVF)) ->
      (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), OVF)) proof
    assume hx
    obtain v, hv ho from hx
    have e2: o2 = exc(fn_update(t, "vm", v), OVF) by simp(rewrite(ho, hk3))
    show by ex_intro({v}, taut(hv, e2))
  qed
  // free_meta's memory: one it is for (one exists: its code's -- the meta
  // zeroed, then queued: `mp.qu_done`, `mp.fm_done`)
  have c2: (ex x2. letin(T0, x3. any_rel(x4. x4 in x86_64_linux.Vm && mallocng_specs.meta_freed(x3, fn_update(t, "vm", x4).vm, fn_update(t, "vm", x4).objs, PH, m),
        x4. letin(fn_update(t, "vm", x4), x5. x2 = ok(pair(x5, empty), empty)))) &&
      ((fst(x2) = 0 && o3 = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && o3 = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
        ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && o3 = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && o3 = diverge(snd(x2)))))) ->
      (ex V r. (V in x86_64_linux.Vm && mallocng_specs.meta_freed(T0, V, t.objs, PH, m)) && o2 = ok(fn_update(t, "vm", V), r)) proof
    assume hx
    obtain x2, hB hout from hx
    let ZV := mallocng_specs.zero_meta(T0, m)
    have phb: PH in bits(64) by defs(simp(), bits_add)
    have zv: ZV in x86_64_linux.Vm by defs(mp(all_elim(ms.wr_any, {T0}, {m}, {40}, {0}), pv), mallocng_specs.zero_meta)
    have zb: ZV.bytes in fn_space(bits(64), bits(8)) by defs(simp(mp(all_elim(x86.store_typed, {T0.bytes}, {m}, {40}, {0}), pb)), mallocng_specs.zero_meta)
    have zu: ZV in univ(1) by defs(simp(htu, apply(g.store_univ, {T0}, {m}, {40}, {0}, pv)), mallocng_specs.zero_meta)
    have qd := apply(mp.qu_done[vm := ZV, objs := t.objs, phead := PH, m := m], zv, zb, phb, hm)
    have fd := apply(mp.fm_done[vm := T0, V := mallocng_specs.queue_vm(ZV, PH, m), objs := t.objs, phead := PH, m := m], pv, pb, phb, hm, qd)
    have {vt = mem} := apply(ms.quvm_vm, {ZV}, {PH}, {m}, zv, zu, phb, hm)
    have ne: ex x4. x4 in x86_64_linux.Vm && mallocng_specs.meta_freed(T0, fn_update(t, "vm", x4).vm, fn_update(t, "vm", x4).objs, PH, m)
      by ex_intro({mallocng_specs.queue_vm(ZV, PH, m)}, taut(vt,
        (mallocng_specs.meta_freed(T0, fn_update(t, "vm", mallocng_specs.queue_vm(ZV, PH, m)).vm, fn_update(t, "vm", mallocng_specs.queue_vm(ZV, PH, m)).objs, PH, m) by simp(fd))))
    obtain V, hV hS hk from apply(g.any_e, ne, expand(hB, letin))
    have x2e: x2 = ok(pair(fn_update(t, "vm", V), empty), empty) by simp(expand(hk, letin))
    have o3e: o3 = ok(fn_update(t, "vm", V), empty) by simp(rewrite(x2e, hout))
    have k4 := rewrite(o3e, hk3)
    have k5: any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o2 = ok(fn_update(t, "vm", V), pair(x5, x6)))) by simp(k4, keep(any_rel))
    have nb: ex y. y in bits(64) by ex_intro({0}, simp())
    obtain y1, hy1 k6 from apply(g.any_e, nb, k5)
    obtain y2, hy2 k7 from apply(g.any_e, nb, k6)
    have hS2: mallocng_specs.meta_freed(T0, V, t.objs, PH, m) by simp(hS)
    show by ex_intro({V}, {pair(y1, y2)}, taut(hV, hS2, k7))
  qed
  show by taut(ci, c1, c2)
qed

// the World specs diverge nowhere they do not also raise (no state
// leaves them diverging), so at the ABI level as well
theorem mp.dq_divw: tr.div_raises(mallocng_specs.dequeue_spec_fun())
proof
  let Q(regs) := mallocng_specs.dequeue_spec(bits_of_int(64, regs[0]), bits_of_int(64, regs[1]))
  have qd: all regs w h t. regs in abi.ARGS -> w in abi.World -> w in univ(1) -> h in single(empty) ->
      runs(Q(regs), union2(w, h), diverge(t)) -> runs(Q(regs), union2(w, h), exc(union2(w, h), empty)) proof
    fix regs w h t
    assume _ hw hwu hh hr
    have {su = univ, sv = vm} := apply(ct.w_single, hw, hwu, hh)
    have r2 := apply(ct.contract_div, su, sv, expand(hr, mallocng_specs.dequeue_spec), defs(ct.dv_havoc, letin))
    show by defs(r2, mallocng_specs.dequeue_spec)
  qed
  have dg := apply(ct.fun_divg_v[G := single(empty), q := x0. Q(x0), n := 2], ct.single_univ, qd)
  show := apply(ct.div_of_g, (tr.div_raises_g(single(empty), mallocng_specs.dequeue_spec_fun()) by defs(dg, mallocng_specs.dequeue_spec_fun)))
qed

// the other World specs: so too; their machine code at the ABI level

theorem mp.qu_divw: tr.div_raises(mallocng_specs.queue_spec_fun())
proof
  let Q(regs) := mallocng_specs.queue_spec(bits_of_int(64, regs[0]), bits_of_int(64, regs[1]))
  have qd: all regs w h t. regs in abi.ARGS -> w in abi.World -> w in univ(1) -> h in single(empty) ->
      runs(Q(regs), union2(w, h), diverge(t)) -> runs(Q(regs), union2(w, h), exc(union2(w, h), empty)) proof
    fix regs w h t
    assume _ hw hwu hh hr
    have {su = univ, sv = vm} := apply(ct.w_single, hw, hwu, hh)
    have r2 := apply(ct.contract_div, su, sv, expand(hr, mallocng_specs.queue_spec), defs(ct.dv_havoc, letin))
    show by defs(r2, mallocng_specs.queue_spec)
  qed
  have dg := apply(ct.fun_divg_v[G := single(empty), q := x0. Q(x0), n := 2], ct.single_univ, qd)
  show := apply(ct.div_of_g, (tr.div_raises_g(single(empty), mallocng_specs.queue_spec_fun()) by defs(dg, mallocng_specs.queue_spec_fun)))
qed

theorem mp.fm_divw: all ctx. tr.div_raises(mallocng_specs.free_meta_spec_fun(ctx))
proof
  fix ctx
  let Q(regs) := mallocng_specs.free_meta_spec(ctx, bits_of_int(64, regs[0]))
  have qd: all regs w h t. regs in abi.ARGS -> w in abi.World -> w in univ(1) -> h in single(empty) ->
      runs(Q(regs), union2(w, h), diverge(t)) -> runs(Q(regs), union2(w, h), exc(union2(w, h), empty)) proof
    fix regs w h t
    assume _ hw hwu hh hr
    have {su = univ, sv = vm} := apply(ct.w_single, hw, hwu, hh)
    have r2 := apply(ct.contract_div, su, sv, expand(hr, mallocng_specs.free_meta_spec), defs(ct.dv_havoc, letin))
    show by defs(r2, mallocng_specs.free_meta_spec)
  qed
  have dg := apply(ct.fun_divg_v[G := single(empty), q := x0. Q(x0), n := 1], ct.single_univ, qd)
  show := apply(ct.div_of_g, (tr.div_raises_g(single(empty), mallocng_specs.free_meta_spec_fun(ctx)) by defs(dg, mallocng_specs.free_meta_spec_fun)))
qed

theorem mp.dqh_divw: tr.div_raises(mallocng_specs.dequeue_head_spec_fun())
proof
  let Q(regs) := mallocng_specs.dequeue_head_spec(bits_of_int(64, regs[0]))
  have qu: all regs s o. runs(Q(regs), s, o) -> pair(s, o) in univ(1) proof
    fix regs s o
    assume hr
    show := apply(g.runs_univ, expand(hr, mallocng_specs.dequeue_head_spec))
  qed
  have qd: all regs w h t. regs in abi.ARGS -> w in abi.World -> w in univ(1) -> h in single(empty) ->
      runs(Q(regs), union2(w, h), diverge(t)) -> runs(Q(regs), union2(w, h), exc(union2(w, h), empty)) proof
    fix regs w h t
    assume _ hw hwu hh hr
    have {su = univ, sv = vm} := apply(ct.w_single, hw, hwu, hh)
    have r2 := apply(ct.contract_div, su, sv, expand(hr, mallocng_specs.dequeue_head_spec), defs(ct.dv_ret2_a, letin))
    show by defs(r2, mallocng_specs.dequeue_head_spec)
  qed
  have dg := apply(ct.fun_divg[G := single(empty), q := x0. Q(x0), n := 1, w := 64], ct.single_univ, qu, qd)
  show := apply(ct.div_of_g, (tr.div_raises_g(single(empty), mallocng_specs.dequeue_head_spec_fun()) by defs(dg, mallocng_specs.dequeue_head_spec_fun)))
qed

theorem mp.dq_abi: all statics. abi.implements2_at(single(empty), 4206409, mallocng_specs.dequeue_spec_fun(), 4198400, text.code, statics)
proof
  fix statics
  show := apply(tr.implements_abi, mp.dq_divw, all_elim(mp.dq_implements, {statics}))
qed

theorem mp.dqh_abi: all statics. abi.implements2_at(single(empty), 4206554, mallocng_specs.dequeue_head_spec_fun(), 4198400, text.code, statics)
proof
