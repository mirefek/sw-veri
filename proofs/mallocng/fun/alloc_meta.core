// alloc_meta by its purpose: a meta for a new group -- the free metas'
// head, or the last area's next one (the allocator initialized first, an
// area added from the reserve if none is left, the reserve refilled from
// brk or mmap if it is empty) -- or 0, none to be had.

// ----------------------------------------------------------------------
//  The memory calls' memories exist: pages fresh, gone, reprotected (so
//  their specs' havocs have a choice, the calls their returns)

// (a protection, a page, typed)
theorem mp.prot_typed(r, w, x): r in bool -> w in bool -> x in bool ->
  fn_update(fn_update(fn_update(empty, "r", r), "w", w), "x", x) in x86_64_linux.Prot
proof
  assume hr hw hx
  let P := fn_update(fn_update(fn_update(empty, "r", r), "w", w), "x", x)
  let K := insert("r", insert("w", insert("x", empty)))
  have bu: bool in univ(1) by defs(simp(), bool)
  have ru := mp(mp(univ_trans[u := 1, a := r, b := bool], bu), hr)
  have wu := mp(mp(univ_trans[u := 1, a := w, b := bool], bu), hw)
  have xu := mp(mp(univ_trans[u := 1, a := x, b := bool], bu), hx)
  have pu: P in univ(1) by simp(ru, wu, xu)
  have f1 := mp(fn_update_fun[f := empty, k := "r", v := r], dom_empty.1)
  have f2 := mp(fn_update_fun[f := fn_update(empty, "r", r), k := "w", v := w], f1)
  have pf: is_fun(P) := mp(fn_update_fun[f := fn_update(fn_update(empty, "r", r), "w", w), k := "x", v := x], f2)
  have d1 := mp(dom_update[f := empty, k := "r", v := r], dom_empty.1)
  have d2 := mp(dom_update[f := fn_update(empty, "r", r), k := "w", v := w], f1)
  have d3 := mp(dom_update[f := fn_update(fn_update(empty, "r", r), "w", w), k := "x", v := x], f2)
  have ds: all z. z in insert("x", insert("w", insert("r", empty))) <-> z in K proof
    fix z
    have l: z in insert("x", insert("w", insert("r", empty))) -> z in K proof
      assume h
      show by simp(h)
    qed
    have q: z in K -> z in insert("x", insert("w", insert("r", empty))) proof
      assume h
      show by simp(h)
    qed
    show by taut(l, q)
  qed
  have deq := mp(set_ext[a := insert("x", insert("w", insert("r", empty))), b := K], ds)
  have pd: dom(P) = K by simp(d3, d2, d1, dom_empty.2, deq)
  have pp: ((is_fun(P) && dom(P) = K) && P.r in bool) && P.w in bool && P.x in bool by simp(hr, hw, hx, pf, pd)
  show by defs(apply(rec_type_intro[u := 1, k := K, p := x0. (((is_fun(x0) && dom(x0) = K) && x0.r in bool) && x0.w in bool) && x0.x in bool, r := P], pu, pf, pd, pp),
    x86_64_linux.Prot)
qed

theorem mp.page_typed(p, k): p in x86_64_linux.Prot -> k in x86_64_linux.Kind -> fn_update(fn_update(empty, "prot", p), "kind", k) in x86_64_linux.Page
proof
  assume hp hk
  let Q := fn_update(fn_update(empty, "prot", p), "kind", k)
  let K := insert("prot", insert("kind", empty))
  let KP := insert("r", insert("w", insert("x", empty)))
  have pp pf pd := (p in powerset(cart(KP, univ(1))) && is_fun(p) && dom(p) = KP by simp(expand(hp, x86_64_linux.Prot)))
  have pu := mp(rec_univ[u := 1, k := KP, r := p], simp(x86.insert_univ), pp, pf, pd)
  have ko: k in omega by simp(expand(hk, x86_64_linux.Kind))
  have ku := mp(mp(univ_trans[u := 1, a := k, b := omega], omega_univ), ko)
  have qu: Q in univ(1) by simp(pu, ku)
  have f1 := mp(fn_update_fun[f := empty, k := "prot", v := p], dom_empty.1)
  have qf: is_fun(Q) := mp(fn_update_fun[f := fn_update(empty, "prot", p), k := "kind", v := k], f1)
  have d1 := mp(dom_update[f := empty, k := "prot", v := p], dom_empty.1)
  have d2 := mp(dom_update[f := fn_update(empty, "prot", p), k := "kind", v := k], f1)
  have ds: all z. z in insert("kind", insert("prot", empty)) <-> z in K proof
    fix z
    have l: z in insert("kind", insert("prot", empty)) -> z in K proof
      assume h
      show by simp(h)
    qed
    have q: z in K -> z in insert("kind", insert("prot", empty)) proof
      assume h
      show by simp(h)
    qed
    show by taut(l, q)
  qed
  have deq := mp(set_ext[a := insert("kind", insert("prot", empty)), b := K], ds)
  have qd: dom(Q) = K by simp(d2, d1, dom_empty.2, deq)
  have qq: ((is_fun(Q) && dom(Q) = K) && Q.prot in x86_64_linux.Prot) && Q.kind in x86_64_linux.Kind by simp(hp, hk, qf, qd, keep(x86_64_linux.Prot, x86_64_linux.Kind))
  show by defs(apply(rec_type_intro[u := 1, k := K, p := x0. ((is_fun(x0) && dom(x0) = K) && x0.prot in x86_64_linux.Prot) && x0.kind in x86_64_linux.Kind, r := Q], qu, qf, qd, qq),
    x86_64_linux.Page)
qed

// (an option of a page)
theorem mp.some_page(p): p in x86_64_linux.Page -> some(p) in option(x86_64_linux.Page)
proof
  assume hp
  have si: some(p) in set_image(x86_64_linux.Page, y. some(y))
    by taut(set_image_def[s := x86_64_linux.Page, f := y. some(y), y := some(p)], (ex x. x in x86_64_linux.Page && some(x) = some(p) by ex_intro({p}, taut(hp, refl({some(p)})))))
  show by defs(taut(union2_iff[a := single(none), b := set_image(x86_64_linux.Page, y. some(y)), z := some(p)], si), option)
qed

// (a memory with its pages, bytes and break replaced)
theorem mp.vm_set(vm, pg, b, br): vm in x86_64_linux.Vm -> vm in univ(1) ->
  pg in fn_space(set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))), option(x86_64_linux.Page)) ->
  b in fn_space(bits(64), bits(8)) -> br in bits(64) ->
  fn_update(fn_update(fn_update(vm, "pages", pg), "bytes", b), "brk", br) in x86_64_linux.Vm
proof
  assume h hu hp hb hbr
  let K6 := insert("pages", insert("bytes", insert("stack_top", insert("stack_limit", insert("brk_start", insert("brk", empty))))))
  let V1 := fn_update(vm, "pages", pg)
  let V2 := fn_update(V1, "bytes", b)
  let V := fn_update(V2, "brk", br)
  have ht: is_fun(vm) && dom(vm) = K6 by simp(expand(h, x86_64_linux.Vm))
  have hf: is_fun(vm) by taut(ht)
  have dv: dom(vm) = K6 by taut(ht)
  have pgu := apply(x86.fn_space_univ, x86.pn_univ, x86.opt_page_univ)
  have pu := mp(mp(univ_trans[u := 1, a := pg, b := fn_space(set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))), option(x86_64_linux.Page))], pgu), hp)
  have bsu := apply(x86.fn_space_univ, bits_univ[n := 64], bits_univ[n := 8])
  have bu := mp(mp(univ_trans[u := 1, a := b, b := fn_space(bits(64), bits(8))], bsu), hb)
  have bru := mp(mp(univ_trans[u := 1, a := br, b := bits(64)], bits_univ[n := 64]), hbr)
  have nu: V in univ(1) by simp(hu, pu, bu, bru)
  have f1 := mp(fn_update_fun[f := vm, k := "pages", v := pg], hf)
  have e1 := mp(mp(fn_update_dom[f := vm, k := "pages", v := pg], hf), (("pages" in dom(vm)) by simp(dv)))
  have f2 := mp(fn_update_fun[f := V1, k := "bytes", v := b], f1)
  have e2 := mp(mp(fn_update_dom[f := V1, k := "bytes", v := b], f1), (("bytes" in dom(V1)) by simp(e1, dv)))
  have f3 := mp(fn_update_fun[f := V2, k := "brk", v := br], f2)
  have e3 := mp(mp(fn_update_dom[f := V2, k := "brk", v := br], f2), (("brk" in dom(V2)) by simp(e2, e1, dv)))
  have d3: dom(V) = K6 by simp(e3, e2, e1, dv)
  have pv: ((((((is_fun(V) && dom(V) = K6) && V.pages in fn_space(set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))), option(x86_64_linux.Page))) &&
      V.bytes in fn_space(bits(64), bits(8))) && V.stack_top in bits(64)) && V.stack_limit in omega) && V.brk_start in bits(64)) && V.brk in bits(64)
    by simp(expand(h, x86_64_linux.Vm), hp, hb, hbr, f3, d3)
  have r := apply(rec_type_intro[u := 1, k := K6, p := x0. ((((((is_fun(x0) && dom(x0) = K6) &&
      x0.pages in fn_space(set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))), option(x86_64_linux.Page))) &&
      x0.bytes in fn_space(bits(64), bits(8))) && x0.stack_top in bits(64)) && x0.stack_limit in omega) && x0.brk_start in bits(64)) && x0.brk in bits(64), r := V], nu, f3, d3, pv)
  show by defs(r, x86_64_linux.Vm)
qed

// pages p .. p+n-1 fresh pages pg (their bytes 0), the break br: such a
// memory exists
theorem mp.fresh_ex(before, p, n, pg, br): before in x86_64_linux.Vm -> before in univ(1) -> p in omega -> n in omega -> pg in x86_64_linux.Page -> br in bits(64) ->
  ex V. (V in x86_64_linux.Vm && mallocng_specs.fresh_pages(before, V, p, n, pg)) && V.brk = br
proof
  assume hv hu hp hn hpg hbr
  let PN := set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)))
  let PGS := fn_build(PN, q. ite(int_le(p, q) && int_lt(q, int_add(p, n)), some(pg), before.pages[q]))
  let BS := fn_build(bits(64), a. ite(int_le(int_mul(p, x86_64_linux.PAGE), a) && int_lt(a, int_mul(int_add(p, n), x86_64_linux.PAGE)), bits_of_int(8, 0), before.bytes[a]))
  let V := fn_update(fn_update(fn_update(before, "pages", PGS), "bytes", BS), "brk", br)
  have sp := apply(mp.some_page, hpg)
  have pgv: all q. q in PN -> ite(int_le(p, q) && int_lt(q, int_add(p, n)), some(pg), before.pages[q]) in option(x86_64_linux.Page) proof
    fix q
    assume hq
    have pq := apply(x86.vm_page_at, hv, hq)
    show by simp(sp, pq)
  qed
  have pgs := apply(fn_build_space[d := PN, v := q. ite(int_le(p, q) && int_lt(q, int_add(p, n)), some(pg), before.pages[q]), b := option(x86_64_linux.Page)], pgv)
  have bt: before.bytes in fn_space(bits(64), bits(8)) by simp(expand(hv, x86_64_linux.Vm))
  have bsv: all a. a in bits(64) -> ite(int_le(int_mul(p, x86_64_linux.PAGE), a) && int_lt(a, int_mul(int_add(p, n), x86_64_linux.PAGE)), bits_of_int(8, 0), before.bytes[a]) in bits(8) proof
    fix a
    assume ha
    have ba := mp(fn_space_app[a := bits(64), b := bits(8), f := before.bytes, x := a], bt, ha)
    show by simp(ba)
  qed
  have bss := apply(fn_build_space[d := bits(64), v := a. ite(int_le(int_mul(p, x86_64_linux.PAGE), a) && int_lt(a, int_mul(int_add(p, n), x86_64_linux.PAGE)), bits_of_int(8, 0), before.bytes[a]), b := bits(8)], bsv)
  have vt := apply(mp.vm_set, hv, hu, pgs, bss, hbr)
  have pq: all q. q in omega -> int_lt(q, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) -> V.pages[q] = ite(int_le(p, q) && int_lt(q, int_add(p, n)), some(pg), before.pages[q]) proof
    fix q
    assume h1 h2
    have qp: q in PN by simp(h1, h2)
    show by simp(app_fn_build[d := PN, v := q. ite(int_le(p, q) && int_lt(q, int_add(p, n)), some(pg), before.pages[q]), a := q], qp)
  qed
  have bq: all a. a in bits(64) -> V.bytes[a] = ite(int_le(int_mul(p, x86_64_linux.PAGE), a) && int_lt(a, int_mul(int_add(p, n), x86_64_linux.PAGE)), bits_of_int(8, 0), before.bytes[a]) proof
    fix a
    assume ha
    show by simp(app_fn_build[d := bits(64), v := a. ite(int_le(int_mul(p, x86_64_linux.PAGE), a) && int_lt(a, int_mul(int_add(p, n), x86_64_linux.PAGE)), bits_of_int(8, 0), before.bytes[a]), a := a], ha)
  qed
  have fp: mallocng_specs.fresh_pages(before, V, p, n, pg) by defs(simp(pq, bq), mallocng_specs.fresh_pages)
  show by ex_intro({V}, taut(vt, fp, (V.brk = br by simp())))
qed

// pages p .. p+n-1 gone, the break br: such a memory exists
theorem mp.gone_ex(before, p, n, br): before in x86_64_linux.Vm -> before in univ(1) -> br in bits(64) ->
  ex V. (V in x86_64_linux.Vm && mallocng_specs.gone_pages(before, V, p, n)) && V.brk = br
proof
  assume hv hu hbr
  let PN := set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)))
  let PGS := fn_build(PN, q. ite(int_le(p, q) && int_lt(q, int_add(p, n)), none, before.pages[q]))
  let V := fn_update(fn_update(fn_update(before, "pages", PGS), "bytes", before.bytes), "brk", br)
  have no: none in option(x86_64_linux.Page) by defs(taut(union2_iff[a := single(none), b := set_image(x86_64_linux.Page, y. some(y)), z := none], single_intro[a := none]), option)
  have pgv: all q. q in PN -> ite(int_le(p, q) && int_lt(q, int_add(p, n)), none, before.pages[q]) in option(x86_64_linux.Page) proof
    fix q
    assume hq
    have pq := apply(x86.vm_page_at, hv, hq)
    show by simp(no, pq)
  qed
  have pgs := apply(fn_build_space[d := PN, v := q. ite(int_le(p, q) && int_lt(q, int_add(p, n)), none, before.pages[q]), b := option(x86_64_linux.Page)], pgv)
  have bt: before.bytes in fn_space(bits(64), bits(8)) by simp(expand(hv, x86_64_linux.Vm))
  have vt := apply(mp.vm_set, hv, hu, pgs, bt, hbr)
  have pq: all q. q in omega -> int_lt(q, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) -> V.pages[q] = ite(int_le(p, q) && int_lt(q, int_add(p, n)), none, before.pages[q]) proof
    fix q
    assume h1 h2
    have qp: q in PN by simp(h1, h2)
    show by simp(app_fn_build[d := PN, v := q. ite(int_le(p, q) && int_lt(q, int_add(p, n)), none, before.pages[q]), a := q], qp)
  qed
  have gp: mallocng_specs.gone_pages(before, V, p, n) by defs(simp(pq), mallocng_specs.gone_pages)
  show by ex_intro({V}, taut(vt, gp, (V.brk = br by simp())))
qed

// (the heap's pages: readable, writable)
theorem mp.heap_page: fn_update(fn_update(empty, "prot", fn_update(fn_update(fn_update(empty, "r", true), "w", true), "x", false)), "kind", 1) in x86_64_linux.Page
proof
  have pr := apply(mp.prot_typed, (true in bool by simp()), (true in bool by simp()), (false in bool by simp()))
  show := apply(mp.page_typed, pr, (1 in x86_64_linux.Kind by defs(simp(), x86_64_linux.Kind)))
qed

// ----------------------------------------------------------------------
//  The callees' contracts at a call (their C function values)

// get_random_secret's (libc's auxiliary vector readable): an overflow, or
// a secret returned -- any 64-bit value --, the memory as it was
theorem mp.rs_q: all t libc regs o2. t in abi.World -> t in univ(1) -> mallocng_specs.auxv_ok(t.vm, t.objs, libc) -> gc.regs_ok(regs, empty) ->
  runs(mallocng_specs.random_secret_spec_fun(libc)[regs], t, o2) ->
  (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex r. o2 = ok(fn_update(t, "vm", t.vm), r) && fst(r) in bits(64))
proof
  fix t libc regs o2
  assume hw htu hax hro h
  let OVF := exc_val("stack_overflow", empty)
  have rl rn := apply(gc.regs0, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, mallocng_specs.random_secret_spec_fun, app_fn_build, ra in h
  have pv pf pd pb := apply(ms.world_parts, hw)
  have ss: fn_update(t, "vm", t.vm) = t := mp(fn_update_same[f := t, k := "vm"], pf, pd)
  let G := (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), OVF)) || (ex r. o2 = ok(fn_update(t, "vm", t.vm), r) && fst(r) in bits(64))
  have b := apply(g.runs_elim, h)
  obtain o3, hs3 hk3 from expand(b, bind_rel)
  have vv: ex x. x in x86_64_linux.Vm by ex_intro({t.vm}, simp(pv))
  have ci: (ex v. v in x86_64_linux.Vm && o3 = exc(fn_update(t, "vm", v), OVF)) || (ex y. y in bits(64) && o3 = ok(t, y))
    by simp(hs3, hax, vv, keep(mallocng_specs.auxv_ok))
  have c1: (ex v. v in x86_64_linux.Vm && o3 = exc(fn_update(t, "vm", v), OVF)) -> G proof
    assume e
    obtain v, hv he from e
    have oe: o2 = exc(fn_update(t, "vm", v), OVF) by simp(rewrite(he, hk3))
    have l: ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), OVF) by ex_intro({v}, taut(hv, oe))
    show by taut(l)
  qed
  have c2: (ex y. y in bits(64) && o3 = ok(t, y)) -> G proof
    assume e
    obtain y, hy he from e
    have k1: bind_rel(gimple.result(64, y), t, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. o2 = ok(x6, pair(x8, x9)))), x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))
      by simp(expand(rewrite(he, hk3), letin), keep(bind_rel, gimple.result))
    obtain o4, hr4 hk4 from expand(k1, bind_rel)
    have ho4 := apply(g.result64_inv, hy, hr4)
    have k2: any_rel(x9. x9 in bits(64), x9. o2 = ok(t, pair(y, x9))) by simp(expand(rewrite(ho4, hk4), letin), keep(any_rel))
    have ne: ex z. z in bits(64) by ex_intro({0}, simp())
    obtain z, hz hoz from apply(g.any_e, ne, k2)
    have l: ex r. o2 = ok(fn_update(t, "vm", t.vm), r) && fst(r) in bits(64) by ex_intro({pair(y, z)}, taut(rewrite(sym(ss), hoz), (fst(pair(y, z)) in bits(64) by simp(hy))))
    show by taut(l)
  qed
  show by taut(ci, c1, c2)
qed

// brk(new) (`__syscall1(SYS_brk, new)`): an overflow, or a return -- the
// break as it was, the memory too; or the break new, its pages fresh
// readable, writable heap (they were free, off the stack's space) or the
// pages above it gone, new not below the break's start
theorem mp.brk_q: all t new regs o2. t in abi.World -> t in univ(1) -> new in bits(64) ->
  gc.regs_ok(regs, seq_concat(seq_one(gimple.arg(64, 12)), seq_one(gimple.arg(64, new)))) ->
  runs(mallocng_specs.syscall1_spec_fun()[regs], t, o2) ->
  (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex r. o2 = ok(fn_update(t, "vm", t.vm), r) && fst(r) = t.vm.brk) ||
  (ex V r. o2 = ok(fn_update(t, "vm", V), r) && fst(r) = new && V in x86_64_linux.Vm && V.brk = new && !int_lt(new, t.vm.brk_start) &&
     ((int_lt(x86_64_linux.pages_for(t.vm.brk), x86_64_linux.pages_for(new)) &&
       x86_64_linux.free_range(t.vm, x86_64_linux.pages_for(t.vm.brk), int_sub(x86_64_linux.pages_for(new), x86_64_linux.pages_for(t.vm.brk))) &&
       x86_64_linux.off_stack_space(t.vm, x86_64_linux.pages_for(t.vm.brk), int_sub(x86_64_linux.pages_for(new), x86_64_linux.pages_for(t.vm.brk))) &&
       mallocng_specs.fresh_pages(t.vm, V, x86_64_linux.pages_for(t.vm.brk), int_sub(x86_64_linux.pages_for(new), x86_64_linux.pages_for(t.vm.brk)),
         fn_update(fn_update(empty, "prot", fn_update(fn_update(fn_update(empty, "r", true), "w", true), "x", false)), "kind", 1))) ||
      (!int_lt(x86_64_linux.pages_for(t.vm.brk), x86_64_linux.pages_for(new)) &&
       mallocng_specs.gone_pages(t.vm, V, x86_64_linux.pages_for(new), int_sub(x86_64_linux.pages_for(t.vm.brk), x86_64_linux.pages_for(new))))))
proof
  fix t new regs o2
  assume hw htu hn hro h
  let OVF := exc_val("stack_overflow", empty)
  have rl rn r0 r1 := apply(gc.regs2, (12 in bits(64) by simp()), hn, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, mallocng_specs.syscall1_spec_fun, app_fn_build, ra in h
  have o12: ord_le(2, seq_len(regs)) && regs[0] = 12 by defs(simp(rn, r0), ord_le)
  have b := rewrite(r1, apply(g.runs_elim, h))
  have b2: bind_rel(mallocng_specs.brk_spec(new), t, x3 x4. letin(x4, x5. any_rel(x6. x6 in bits(64), x6. o2 = ok(x3, pair(x5, x6)))), x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3))
    by taut(b, o12)
  obtain o3, hs3 hk3 from expand(b2, bind_rel)
  have pv pf pd pb := apply(ms.world_parts, hw)
  have ss: fn_update(t, "vm", t.vm) = t := mp(fn_update_same[f := t, k := "vm"], pf, pd)
  let PO := x86_64_linux.pages_for(t.vm.brk)
  let PN := x86_64_linux.pages_for(new)
  let HP := fn_update(fn_update(empty, "prot", fn_update(fn_update(fn_update(empty, "r", true), "w", true), "x", false)), "kind", 1)
  let GROW(V) := (int_lt(PO, PN) && x86_64_linux.free_range(t.vm, PO, int_sub(PN, PO)) && x86_64_linux.off_stack_space(t.vm, PO, int_sub(PN, PO)) &&
      mallocng_specs.fresh_pages(t.vm, V, PO, int_sub(PN, PO), HP)) ||
    (!int_lt(PO, PN) && mallocng_specs.gone_pages(t.vm, V, PN, int_sub(PO, PN)))
  let G := (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), OVF)) || (ex r. o2 = ok(fn_update(t, "vm", t.vm), r) && fst(r) = t.vm.brk) ||
    (ex V r. o2 = ok(fn_update(t, "vm", V), r) && fst(r) = new && V in x86_64_linux.Vm && V.brk = new && !int_lt(new, t.vm.brk_start) && GROW(V))
  have vv: ex x. x in x86_64_linux.Vm by ex_intro({t.vm}, simp(pv))
  have vu := apply(x86.vm_univ, pv)
  have bko: t.vm.brk in bits(64) by simp(expand(pv, x86_64_linux.Vm))
  have poo: PO in omega by defs(arith(bko), x86_64_linux.pages_for, x86_64_linux.PAGE)
  have pno: PN in omega by defs(arith(hn), x86_64_linux.pages_for, x86_64_linux.PAGE)
  have fx: int_lt(PO, PN) -> ex V. V in x86_64_linux.Vm && (mallocng_specs.fresh_pages(t.vm, V, PO, int_sub(PN, PO), HP) && new = V.brk) proof
    assume hl
    obtain V, h1 h2 h3 from apply(mp.fresh_ex[before := t.vm, p := PO, n := int_sub(PN, PO), pg := HP, br := new], pv, vu, poo, (int_sub(PN, PO) in omega by arith(hl, poo, pno)), mp.heap_page, hn)
    show by ex_intro({V}, taut(h1, h2, sym(h3)))
  qed
  have gx: !int_lt(PO, PN) -> ex V. V in x86_64_linux.Vm && (mallocng_specs.gone_pages(t.vm, V, PN, int_sub(PO, PN)) && new = V.brk) proof
    assume _
    obtain V, h1 h2 h3 from apply(mp.gone_ex[before := t.vm, p := PN, n := int_sub(PO, PN), br := new], pv, vu, hn)
    show by ex_intro({V}, taut(h1, h2, sym(h3)))
  qed
  have ci: (ex v. v in x86_64_linux.Vm && o3 = exc(fn_update(t, "vm", v), OVF)) || o3 = ok(t, t.vm.brk) ||
      (ex V. (V in x86_64_linux.Vm && V.brk = new && !int_lt(new, t.vm.brk_start) && GROW(V)) && o3 = ok(fn_update(t, "vm", V), new))
    by simp(hs3, vv, fx, gx, keep(mallocng_specs.fresh_pages, mallocng_specs.gone_pages, x86_64_linux.free_range, x86_64_linux.off_stack_space, x86_64_linux.pages_for))
  have ne: ex z. z in bits(64) by ex_intro({0}, simp())
  have c1: (ex v. v in x86_64_linux.Vm && o3 = exc(fn_update(t, "vm", v), OVF)) -> G proof
    assume e
    obtain v, hv he from e
    have oe: o2 = exc(fn_update(t, "vm", v), OVF) by simp(rewrite(he, hk3))
    have l: ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), OVF) by ex_intro({v}, taut(hv, oe))
    show by taut(l)
  qed
  have c2: o3 = ok(t, t.vm.brk) -> G proof
    assume he
    have k: any_rel(x3. x3 in bits(64), x3. o2 = ok(t, pair(t.vm.brk, x3))) by simp(rewrite(he, hk3), keep(any_rel))
    obtain z, _ hoz from apply(g.any_e, ne, k)
    have ho: o2 = ok(fn_update(t, "vm", t.vm), pair(t.vm.brk, z)) := subst({y. o2 = ok(y, pair(t.vm.brk, z))}, sym(ss), hoz)
    have l: ex r. o2 = ok(fn_update(t, "vm", t.vm), r) && fst(r) = t.vm.brk by ex_intro({pair(t.vm.brk, z)}, taut(ho, (fst(pair(t.vm.brk, z)) = t.vm.brk by simp())))
    show by taut(l)
  qed
  have c3: (ex V. (V in x86_64_linux.Vm && V.brk = new && !int_lt(new, t.vm.brk_start) && GROW(V)) && o3 = ok(fn_update(t, "vm", V), new)) -> G proof
    assume e
    obtain V, hV hb hs hg he from e
    have k: any_rel(x3. x3 in bits(64), x3. o2 = ok(fn_update(t, "vm", V), pair(new, x3))) by simp(rewrite(he, hk3), keep(any_rel))
    obtain z, _ hoz from apply(g.any_e, ne, k)
    have l: ex V r. o2 = ok(fn_update(t, "vm", V), r) && fst(r) = new && V in x86_64_linux.Vm && V.brk = new && !int_lt(new, t.vm.brk_start) && GROW(V)
      by ex_intro({V}, {pair(new, z)}, taut(hoz, (fst(pair(new, z)) = new by simp()), hV, hb, hs, hg))
    show by taut(l)
  qed
  show by taut(ci, c1, c2, c3)
qed

// mmap(addr, len, prot, flags, fd, 0) (anonymous private memory, at addr
// if MAP_FIXED): an overflow, or a return -- -1, errno ENOMEM or EINVAL
// written; or a place p for len's pages (`mmap_place`), its pages fresh of
// protection prot, p's address returned
theorem mp.mmap_q: all t addr len prot flags fd regs o2. t in abi.World -> t in univ(1) -> addr in bits(64) -> len in bits(64) -> prot in bits(32) ->
  flags in bits(32) -> fd in bits(32) ->
  (flags = int_add(x86_64_linux.MAP_PRIVATE, x86_64_linux.MAP_ANONYMOUS) || flags = int_add(int_add(x86_64_linux.MAP_PRIVATE, x86_64_linux.MAP_ANONYMOUS), x86_64_linux.MAP_FIXED)) ->
  int_lt(prot, 8) -> mallocng_specs.errno_ok(t.vm, t.objs, t.fs_base) ->
  gc.regs_ok(regs, seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(gimple.arg(64, addr)), seq_one(gimple.arg(64, len))), seq_one(gimple.arg(32, prot))),
    seq_one(gimple.arg(32, flags))), seq_one(gimple.arg(32, fd))), seq_one(gimple.arg(64, 0)))) ->
  runs(mallocng_specs.mmap_spec_fun()[regs], t, o2) ->
  (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex e r. (e = x86_64_linux.ENOMEM || e = x86_64_linux.EINVAL) && o2 = ok(fn_update(t, "vm", mallocng_specs.wr32(t.vm, mallocng_specs.errno_at(t.fs_base), e)), r) &&
     fst(r) = bits_of_int(64, int_sub(int_pow(2, 64), 1))) ||
  (ex V p r. o2 = ok(fn_update(t, "vm", V), r) && fst(r) = bits_of_int(64, int_mul(p, x86_64_linux.PAGE)) && V in x86_64_linux.Vm && p in omega &&
     mallocng_specs.mmap_place(t.vm, addr, len, flags, p) &&
     mallocng_specs.fresh_pages(t.vm, V, p, x86_64_linux.pages_for(len), fn_update(fn_update(empty, "prot", x86_64_linux.prot_of(prot)), "kind", 0)) &&
     V.brk = t.vm.brk)
proof
  fix t addr len prot flags fd regs o2
  assume hw htu ha hl hp hf hfd hfl hpl he hro h
  let OVF := exc_val("stack_overflow", empty)
  let ARGS := seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(gimple.arg(64, addr)), seq_one(gimple.arg(64, len))), seq_one(gimple.arg(32, prot))),
    seq_one(gimple.arg(32, flags))), seq_one(gimple.arg(32, fd))), seq_one(gimple.arg(64, 0)))
  have rl rln _ := hro
  have an: seq_len(ARGS) = 6 by simp()
  have rn: seq_len(regs) = 6 := trans(rln, an)
  have lo: seq_len(regs) in omega by simp(rn)
  have q0 := apply(gc.reg_at[regs := regs, args := ARGS, i := 0, w := 64, x := addr], hro, simp(), simp(an), at({ARGS[0]}), simp(), ha)
  have q1 := apply(gc.reg_at[regs := regs, args := ARGS, i := 1, w := 64, x := len], hro, simp(), simp(an), at({ARGS[1]}), simp(), hl)
  have q2 := apply(gc.reg_at[regs := regs, args := ARGS, i := 2, w := 32, x := prot], hro, simp(), simp(an), at({ARGS[2]}), simp(), hp)
  have q3 := apply(gc.reg_at[regs := regs, args := ARGS, i := 3, w := 32, x := flags], hro, simp(), simp(an), at({ARGS[3]}), simp(), hf)
  have q5 := apply(gc.reg_at[regs := regs, args := ARGS, i := 5, w := 64, x := 0], hro, simp(), simp(an), at({ARGS[5]}), simp(), simp())
  have t0 := apply(at_type[l := regs, t := bits(64), i := 0], rl, simp(), simp(rn))
  have t1 := apply(at_type[l := regs, t := bits(64), i := 1], rl, simp(), simp(rn))
  have t5 := apply(at_type[l := regs, t := bits(64), i := 5], rl, simp(), simp(rn))
  have e0: regs[0] = addr by simp(q0, t0)
  have e1: regs[1] = len by simp(q1, t1)
  have e5: regs[5] = 0 by simp(q5, t5)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, mallocng_specs.mmap_spec_fun, app_fn_build, ra in h
  have o6: ord_le(6, seq_len(regs)) by defs(simp(rn), ord_le)
  have b := rewrite(e5, rewrite(q3, rewrite(q2, rewrite(e1, rewrite(e0, apply(g.runs_elim, h))))))
  have b2: bind_rel(mallocng_specs.mmap_spec(addr, len, prot, flags, 0), t, x3 x4. letin(x4, x5. any_rel(x6. x6 in bits(64), x6. o2 = ok(x3, pair(x5, x6)))), x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3))
    by taut(b, o6)
  obtain o3, hs3 hk3 from expand(b2, bind_rel)
  have pv pf pd pb := apply(ms.world_parts, hw)
  have vv: ex x. x in x86_64_linux.Vm by ex_intro({t.vm}, simp(pv))
  have ee: int_lt(prot, 8) -> ex x2. x2 in omega && (x2 = 12 || x2 = 22) proof
    assume _
    show by ex_intro({12}, simp())
  qed
  let PG := fn_update(fn_update(empty, "prot", x86_64_linux.prot_of(prot)), "kind", 0)
  have bp: bits_of_int(64, prot) = prot by defs(arith(hp), bits_of_int, pow2)
  let FR(p) := ex V. V in x86_64_linux.Vm && (mallocng_specs.fresh_pages(t.vm, V, p, x86_64_linux.pages_for(len), PG) && V.brk = t.vm.brk)
  have ci: (ex v. v in x86_64_linux.Vm && o3 = exc(fn_update(t, "vm", v), OVF)) ||
      (ex e. (e = x86_64_linux.ENOMEM || e = x86_64_linux.EINVAL) && o3 = ok(fn_update(t, "vm", mallocng_specs.wr32(t.vm, mallocng_specs.errno_at(t.fs_base), e)), bits_of_int(64, int_sub(int_pow(2, 64), 1)))) ||
      (ex V p. (V in x86_64_linux.Vm && p in omega && mallocng_specs.mmap_place(t.vm, addr, len, flags, p) &&
         mallocng_specs.fresh_pages(t.vm, V, p, x86_64_linux.pages_for(len), PG) && V.brk = t.vm.brk) && o3 = ok(fn_update(t, "vm", V), bits_of_int(64, int_mul(p, x86_64_linux.PAGE)))) ||
      (ex p. (p in omega && mallocng_specs.mmap_place(t.vm, addr, len, flags, p)) && !FR(p))
    by simp(hs3, vv, ee, hfl, hpl, he, bp, keep(mallocng_specs.fresh_pages, mallocng_specs.mmap_place, mallocng_specs.errno_ok, mallocng_specs.wr32, mallocng_specs.errno_at))
  let G := (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), OVF)) ||
    (ex e r. (e = x86_64_linux.ENOMEM || e = x86_64_linux.EINVAL) && o2 = ok(fn_update(t, "vm", mallocng_specs.wr32(t.vm, mallocng_specs.errno_at(t.fs_base), e)), r) &&
       fst(r) = bits_of_int(64, int_sub(int_pow(2, 64), 1))) ||
    (ex V p r. o2 = ok(fn_update(t, "vm", V), r) && fst(r) = bits_of_int(64, int_mul(p, x86_64_linux.PAGE)) && V in x86_64_linux.Vm && p in omega &&
       mallocng_specs.mmap_place(t.vm, addr, len, flags, p) && mallocng_specs.fresh_pages(t.vm, V, p, x86_64_linux.pages_for(len), PG) && V.brk = t.vm.brk)
  have ne: ex z. z in bits(64) by ex_intro({0}, simp())
  have c1: (ex v. v in x86_64_linux.Vm && o3 = exc(fn_update(t, "vm", v), OVF)) -> G proof
    assume e
    obtain v, hv hx from e
    have oe: o2 = exc(fn_update(t, "vm", v), OVF) by simp(rewrite(hx, hk3))
    have l: ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), OVF) by ex_intro({v}, taut(hv, oe))
    show by taut(l)
  qed
  have c2: (ex e. (e = x86_64_linux.ENOMEM || e = x86_64_linux.EINVAL) &&
      o3 = ok(fn_update(t, "vm", mallocng_specs.wr32(t.vm, mallocng_specs.errno_at(t.fs_base), e)), bits_of_int(64, int_sub(int_pow(2, 64), 1)))) -> G proof
    assume x
    obtain e, he1 hx from x
    let W := fn_update(t, "vm", mallocng_specs.wr32(t.vm, mallocng_specs.errno_at(t.fs_base), e))
    let M1 := bits_of_int(64, int_sub(int_pow(2, 64), 1))
    have k: any_rel(x3. x3 in bits(64), x3. o2 = ok(W, pair(M1, x3))) by simp(rewrite(hx, hk3), keep(any_rel, mallocng_specs.wr32, mallocng_specs.errno_at))
    obtain z, _ hoz from apply(g.any_e, ne, k)
    have l: ex e r. (e = x86_64_linux.ENOMEM || e = x86_64_linux.EINVAL) && o2 = ok(fn_update(t, "vm", mallocng_specs.wr32(t.vm, mallocng_specs.errno_at(t.fs_base), e)), r) &&
        fst(r) = M1 by ex_intro({e}, {pair(M1, z)}, taut(he1, hoz, (fst(pair(M1, z)) = M1 by simp())))
    show by taut(l)
  qed
  have c3: (ex V p. (V in x86_64_linux.Vm && p in omega && mallocng_specs.mmap_place(t.vm, addr, len, flags, p) &&
      mallocng_specs.fresh_pages(t.vm, V, p, x86_64_linux.pages_for(len), PG) && V.brk = t.vm.brk) && o3 = ok(fn_update(t, "vm", V), bits_of_int(64, int_mul(p, x86_64_linux.PAGE)))) -> G proof
    assume x
    obtain V p, hV hpo hpl2 hfp hbk hx from x
    let R := bits_of_int(64, int_mul(p, x86_64_linux.PAGE))
    have k: any_rel(x3. x3 in bits(64), x3. o2 = ok(fn_update(t, "vm", V), pair(R, x3))) by simp(rewrite(hx, hk3), keep(any_rel))
    obtain z, _ hoz from apply(g.any_e, ne, k)
    have l: ex V p r. o2 = ok(fn_update(t, "vm", V), r) && fst(r) = bits_of_int(64, int_mul(p, x86_64_linux.PAGE)) && V in x86_64_linux.Vm && p in omega &&
        mallocng_specs.mmap_place(t.vm, addr, len, flags, p) && mallocng_specs.fresh_pages(t.vm, V, p, x86_64_linux.pages_for(len), PG) && V.brk = t.vm.brk
      by ex_intro({V}, {p}, {pair(R, z)}, taut(hoz, (fst(pair(R, z)) = R by simp()), hV, hpo, hpl2, hfp, hbk))
    show by taut(l)
  qed
  // (a place: such a memory exists)
  have pr := apply(mp.prot_typed, eq_bool[a := int_mod(int_div(prot, pow2(0)), 2), b := 1], eq_bool[a := int_mod(int_div(prot, pow2(1)), 2), b := 1],
    eq_bool[a := int_mod(int_div(prot, pow2(2)), 2), b := 1])
  have pt: x86_64_linux.prot_of(prot) in x86_64_linux.Prot by defs(simp(pr, keep(x86_64_linux.Prot)), x86_64_linux.prot_of, bit)
  have pg := apply(mp.page_typed, pt, (0 in x86_64_linux.Kind by defs(simp(), x86_64_linux.Kind)))
  have vu := apply(x86.vm_univ, pv)
  have bkb: t.vm.brk in bits(64) by simp(expand(pv, x86_64_linux.Vm))
  have c4: (ex p. (p in omega && mallocng_specs.mmap_place(t.vm, addr, len, flags, p)) && !FR(p)) -> G proof
    assume x
    obtain p, hpo _ hn from x
    obtain V, h1 h2 h3 from apply(mp.fresh_ex[before := t.vm, p := p, n := x86_64_linux.pages_for(len), pg := PG, br := t.vm.brk], pv, vu, hpo,
      (x86_64_linux.pages_for(len) in omega by defs(arith(hl), x86_64_linux.pages_for, x86_64_linux.PAGE)), pg, bkb)
    have f: FR(p) by ex_intro({V}, taut(h1, h2, h3))
    show by taut(f, hn)
  qed
  show by taut(ci, c1, c2, c3, c4)
qed

// (a page with another protection: a page)
theorem mp.prot_upd(P, pr): P in x86_64_linux.Page -> pr in x86_64_linux.Prot -> fn_update(P, "prot", pr) in x86_64_linux.Page
proof
  assume hp hr
  let K := insert("prot", insert("kind", empty))
  let KP := insert("r", insert("w", insert("x", empty)))
  have pp pf pd ppr pk := (P in powerset(cart(K, univ(1))) && is_fun(P) && dom(P) = K && P.prot in x86_64_linux.Prot && P.kind in x86_64_linux.Kind
    by simp(expand(hp, x86_64_linux.Page)))
  have pu := mp(rec_univ[u := 1, k := K, r := P], simp(x86.insert_univ), pp, pf, pd)
  have rp rf rd := (pr in powerset(cart(KP, univ(1))) && is_fun(pr) && dom(pr) = KP by simp(expand(hr, x86_64_linux.Prot)))
  have ru := mp(rec_univ[u := 1, k := KP, r := pr], simp(x86.insert_univ), rp, rf, rd)
  have qu: fn_update(P, "prot", pr) in univ(1) by simp(pu, ru)
  have qf := mp(fn_update_fun[f := P, k := "prot", v := pr], pf)
  have qd: dom(fn_update(P, "prot", pr)) = K := trans(mp(mp(fn_update_dom[f := P, k := "prot", v := pr], pf), (("prot" in dom(P)) by simp(pd))), pd)
  have qq: ((is_fun(fn_update(P, "prot", pr)) && dom(fn_update(P, "prot", pr)) = K) && fn_update(P, "prot", pr).prot in x86_64_linux.Prot) &&
      fn_update(P, "prot", pr).kind in x86_64_linux.Kind by simp(qf, qd, hr, pk, keep(x86_64_linux.Prot, x86_64_linux.Kind))
  show by defs(apply(rec_type_intro[u := 1, k := K, p := x0. ((is_fun(x0) && dom(x0) = K) && x0.prot in x86_64_linux.Prot) && x0.kind in x86_64_linux.Kind,
    r := fn_update(P, "prot", pr)], qu, qf, qd, qq), x86_64_linux.Page)
qed

// pages p .. p+n-1, all mapped, of protection pr: such a memory exists
theorem mp.reprot_ex(before, p, n, pr): before in x86_64_linux.Vm -> before in univ(1) -> pr in x86_64_linux.Prot ->
  (all q. q in omega -> int_le(p, q) -> int_lt(q, int_add(p, n)) -> x86_64_linux.mapped(before, q)) ->
  ex V. V in x86_64_linux.Vm && mallocng_specs.reprot(before, V, p, n, pr)
proof
  assume hv hu hr hm
  let PN := set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)))
  let PGS := fn_build(PN, q. ite(int_le(p, q) && int_lt(q, int_add(p, n)), some(fn_update(snd(before.pages[q]), "prot", pr)), before.pages[q]))
  let V := fn_update(before, "pages", PGS)
  have pgv: all q. q in PN -> ite(int_le(p, q) && int_lt(q, int_add(p, n)), some(fn_update(snd(before.pages[q]), "prot", pr)), before.pages[q]) in option(x86_64_linux.Page) proof
    fix q
    assume hq
    have pq := apply(x86.vm_page_at, hv, hq)
    have qo ql := (q in omega && int_lt(q, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) by simp(hq))
    have inr: int_le(p, q) && int_lt(q, int_add(p, n)) -> some(fn_update(snd(before.pages[q]), "prot", pr)) in option(x86_64_linux.Page) proof
      assume h12
      have h1 h2 := h12
      have mq := mp(all_elim(hm, {q}), qo, h1, h2)
      have nn: !(before.pages[q] = none) by taut(expand(mq, x86_64_linux.mapped))
      have sv := apply(some_val, pq, nn)
      show := apply(mp.some_page, apply(mp.prot_upd, sv, hr))
    qed
    show by simp(inr, pq)
  qed
  have pgs := apply(fn_build_space[d := PN, v := q. ite(int_le(p, q) && int_lt(q, int_add(p, n)), some(fn_update(snd(before.pages[q]), "prot", pr)), before.pages[q]),
    b := option(x86_64_linux.Page)], pgv)
  have pgu := apply(x86.fn_space_univ, x86.pn_univ, x86.opt_page_univ)
  have pu := mp(mp(univ_trans[u := 1, a := PGS, b := fn_space(PN, option(x86_64_linux.Page))], pgu), pgs)
  have vt _ := apply(x86.vm_pages_put, hv, hu, pgs, pu)
  have bf bd := (is_fun(before) && "pages" in dom(before) by simp(expand(hv, x86_64_linux.Vm)))
  have back: fn_update(V, "pages", before.pages) = before := trans(fn_update_twice[f := before, k := "pages", a := PGS, b := before.pages], mp(fn_update_same[f := before, k := "pages"], bf, bd))
  have pq: all q. q in omega -> int_lt(q, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) ->
      V.pages[q] = ite(int_le(p, q) && int_lt(q, int_add(p, n)), some(fn_update(snd(before.pages[q]), "prot", pr)), before.pages[q]) proof
    fix q
    assume h1 h2
    have qp: q in PN by simp(h1, h2)
    show by simp(app_fn_build[d := PN, v := q. ite(int_le(p, q) && int_lt(q, int_add(p, n)), some(fn_update(snd(before.pages[q]), "prot", pr)), before.pages[q]), a := q], qp)
  qed
  have rp: mallocng_specs.reprot(before, V, p, n, pr) by defs(taut(back, pq), mallocng_specs.reprot)
  show by ex_intro({V}, taut(vt, rp))
qed

// mprotect(addr, len, prot): an overflow, or a return -- the pages from
// addr's to addr + len's (all mapped) of protection prot, 0; or, at the
// first of them unmapped, k, the ones before it of protection prot and
// errno ENOMEM written, -1
theorem mp.mprotect_q: all t addr len prot regs o2. t in abi.World -> t in univ(1) -> addr in bits(64) -> len in bits(64) -> prot in bits(32) ->
  int_lt(prot, 8) -> int_le(int_add(int_add(addr, len), x86_64_linux.PAGE), int_pow(2, 64)) -> mallocng_specs.errno_ok(t.vm, t.objs, t.fs_base) ->
  gc.regs_ok(regs, seq_concat(seq_concat(seq_one(gimple.arg(64, addr)), seq_one(gimple.arg(64, len))), seq_one(gimple.arg(32, prot)))) ->
  runs(mallocng_specs.mprotect_spec_fun()[regs], t, o2) ->
  (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex V r. o2 = ok(fn_update(t, "vm", V), r) && bits_of_int(32, fst(r)) = 0 && V in x86_64_linux.Vm &&
     (all q. q in omega -> int_le(int_div(addr, x86_64_linux.PAGE), q) && int_lt(q, int_div(int_sub(int_add(int_add(addr, len), x86_64_linux.PAGE), 1), x86_64_linux.PAGE)) ->
        x86_64_linux.mapped(t.vm, q)) &&
     mallocng_specs.reprot(t.vm, V, int_div(addr, x86_64_linux.PAGE),
       int_sub(int_div(int_sub(int_add(int_add(addr, len), x86_64_linux.PAGE), 1), x86_64_linux.PAGE), int_div(addr, x86_64_linux.PAGE)), x86_64_linux.prot_of(bits_of_int(64, prot)))) ||
  (ex V k r. o2 = ok(fn_update(t, "vm", mallocng_specs.wr32(V, mallocng_specs.errno_at(t.fs_base), x86_64_linux.ENOMEM)), r) &&
     bits_of_int(32, fst(r)) = bits_of_int(32, int_sub(int_pow(2, 32), 1)) && V in x86_64_linux.Vm && k in omega &&
     int_le(int_div(addr, x86_64_linux.PAGE), k) && int_lt(k, int_div(int_sub(int_add(int_add(addr, len), x86_64_linux.PAGE), 1), x86_64_linux.PAGE)) &&
     !x86_64_linux.mapped(t.vm, k) && (all q. q in omega -> int_le(int_div(addr, x86_64_linux.PAGE), q) && int_lt(q, k) -> x86_64_linux.mapped(t.vm, q)) &&
     mallocng_specs.reprot(t.vm, V, int_div(addr, x86_64_linux.PAGE), int_sub(k, int_div(addr, x86_64_linux.PAGE)), x86_64_linux.prot_of(bits_of_int(64, prot))))
proof
  fix t addr len prot regs o2
  assume hw htu ha hl hp hpl hsz he hro h
  let OVF := exc_val("stack_overflow", empty)
  let ARGS := seq_concat(seq_concat(seq_one(gimple.arg(64, addr)), seq_one(gimple.arg(64, len))), seq_one(gimple.arg(32, prot)))
  let S := int_div(addr, x86_64_linux.PAGE)
  let E := int_div(int_sub(int_add(int_add(addr, len), x86_64_linux.PAGE), 1), x86_64_linux.PAGE)
  let PR := x86_64_linux.prot_of(bits_of_int(64, prot))
  let ALL := all q. q in omega -> int_le(S, q) && int_lt(q, E) -> x86_64_linux.mapped(t.vm, q)
  let LEAST(k) := k in omega && (((int_le(S, k) && int_lt(k, E)) && !x86_64_linux.mapped(t.vm, k)) && (all q. q in omega -> int_le(S, q) && int_lt(q, k) -> x86_64_linux.mapped(t.vm, q)))
  have rl rln _ := hro
  have an: seq_len(ARGS) = 3 by simp()
  have rn: seq_len(regs) = 3 := trans(rln, an)
  have lo: seq_len(regs) in omega by simp(rn)
  have q0 := apply(gc.reg_at[regs := regs, args := ARGS, i := 0, w := 64, x := addr], hro, simp(), simp(an), at({ARGS[0]}), simp(), ha)
  have q1 := apply(gc.reg_at[regs := regs, args := ARGS, i := 1, w := 64, x := len], hro, simp(), simp(an), at({ARGS[1]}), simp(), hl)
  have q2 := apply(gc.reg_at[regs := regs, args := ARGS, i := 2, w := 32, x := prot], hro, simp(), simp(an), at({ARGS[2]}), simp(), hp)
  have t0 := apply(at_type[l := regs, t := bits(64), i := 0], rl, simp(), simp(rn))
  have t1 := apply(at_type[l := regs, t := bits(64), i := 1], rl, simp(), simp(rn))
  have e0: regs[0] = addr by simp(q0, t0)
  have e1: regs[1] = len by simp(q1, t1)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, mallocng_specs.mprotect_spec_fun, app_fn_build, ra in h
  have o3l: ord_le(3, seq_len(regs)) by defs(simp(rn), ord_le)
  have b := rewrite(q2, rewrite(e1, rewrite(e0, apply(g.runs_elim, h))))
  have b2: bind_rel(mallocng_specs.mprotect_spec(addr, len, prot), t, x3 x4. letin(x4, x5. bind_rel(gimple.result(32, x5), x3, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. o2 = ok(x6, pair(x8, x9)))),
      x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))), x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3)) by taut(b, o3l)
  obtain o3, hs3 hk3 from expand(b2, bind_rel)
  have pv pf pd pb := apply(ms.world_parts, hw)
  have vu := apply(x86.vm_univ, pv)
  have vv: ex x. x in x86_64_linux.Vm by ex_intro({t.vm}, simp(pv))
  have bp: bits_of_int(64, prot) = prot by defs(arith(hp), bits_of_int, pow2)
  let BP := bits_of_int(64, prot)
  have pr := apply(mp.prot_typed, eq_bool[a := int_mod(int_div(BP, pow2(0)), 2), b := 1], eq_bool[a := int_mod(int_div(BP, pow2(1)), 2), b := 1],
    eq_bool[a := int_mod(int_div(BP, pow2(2)), 2), b := 1])
  have pt: PR in x86_64_linux.Prot by defs(taut(pr), x86_64_linux.prot_of, bit)
  // (all mapped: such a memory; not all: a first unmapped page)
  have ax: ALL -> ex V. V in x86_64_linux.Vm && mallocng_specs.reprot(t.vm, V, S, int_sub(E, S), PR) proof
    assume hall
    have m: all q. q in omega -> int_le(S, q) -> int_lt(q, int_add(S, int_sub(E, S))) -> x86_64_linux.mapped(t.vm, q) proof
      fix q
      assume h1 h2 h3
      show := mp(all_elim(hall, {q}), h1, conj(h2, (int_lt(q, E) by arith(h3))))
    qed
    show := apply(mp.reprot_ex[before := t.vm, p := S, n := int_sub(E, S), pr := PR], pv, vu, pt, m)
  qed
  have kx: !ALL -> ex k. LEAST(k) proof
    assume hn
    have sx: !(ex q. q in omega && int_le(S, q) && int_lt(q, E) && !x86_64_linux.mapped(t.vm, q)) -> ALL proof
      assume hne
      fix q
      assume g1 g23
      have g2 g3 := g23
      have c: !x86_64_linux.mapped(t.vm, q) -> false proof
        assume hm
        have ex1: ex q. q in omega && int_le(S, q) && int_lt(q, E) && !x86_64_linux.mapped(t.vm, q) by ex_intro({q}, taut(g1, g2, g3, hm))
        show by taut(hne, ex1)
      qed
      show by taut(c)
    qed
    obtain q, hq h1 h2 hu from ((ex q. q in omega && int_le(S, q) && int_lt(q, E) && !x86_64_linux.mapped(t.vm, q)) by taut(hn, sx))
    obtain k, hk hp2 hmin from apply(nat_least[p := y. int_le(S, y) && int_lt(y, E) && !x86_64_linux.mapped(t.vm, y)], (ex a. a in omega && (int_le(S, a) && int_lt(a, E) && !x86_64_linux.mapped(t.vm, a)) by ex_intro({q}, taut(hq, h1, h2, hu))))
    have below: all y. y in omega -> int_le(S, y) && int_lt(y, k) -> x86_64_linux.mapped(t.vm, y) proof
      fix y
      assume hy hr
      have r1 r2 := hr
      have c: !x86_64_linux.mapped(t.vm, y) -> false proof
        assume hny
        have le := mp(all_elim(hmin, {y}), hy, taut(r1, (int_lt(y, E) by arith(r2, hp2)), hny))
        show by arith(le, r2)
      qed
      show by taut(c)
    qed
    show by ex_intro({k}, taut(hk, hp2, below))
  qed
  let RX(k) := ex V. V in x86_64_linux.Vm && mallocng_specs.reprot(t.vm, V, S, int_sub(k, S), PR)
  have ci: (ex v. v in x86_64_linux.Vm && o3 = exc(fn_update(t, "vm", v), OVF)) ||
      (ex V. (V in x86_64_linux.Vm && ALL && mallocng_specs.reprot(t.vm, V, S, int_sub(E, S), PR)) && o3 = ok(fn_update(t, "vm", V), 0)) ||
      (ex V k. (V in x86_64_linux.Vm && LEAST(k) && mallocng_specs.reprot(t.vm, V, S, int_sub(k, S), PR)) &&
         o3 = ok(fn_update(t, "vm", mallocng_specs.wr32(V, mallocng_specs.errno_at(t.fs_base), x86_64_linux.ENOMEM)), bits_of_int(32, int_sub(int_pow(2, 32), 1)))) ||
      (ex k. LEAST(k) && !RX(k))
    by simp(hs3, vv, ax, kx, hpl, hsz, he, keep(mallocng_specs.reprot, mallocng_specs.errno_ok, mallocng_specs.wr32, mallocng_specs.errno_at, x86_64_linux.mapped))
  let G1(V) := V in x86_64_linux.Vm && ALL && mallocng_specs.reprot(t.vm, V, S, int_sub(E, S), PR)
  let G2(V, k) := V in x86_64_linux.Vm && LEAST(k) && mallocng_specs.reprot(t.vm, V, S, int_sub(k, S), PR)
  let G := (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), OVF)) ||
    (ex V r. o2 = ok(fn_update(t, "vm", V), r) && bits_of_int(32, fst(r)) = 0 && V in x86_64_linux.Vm && ALL && mallocng_specs.reprot(t.vm, V, S, int_sub(E, S), PR)) ||
    (ex V k r. o2 = ok(fn_update(t, "vm", mallocng_specs.wr32(V, mallocng_specs.errno_at(t.fs_base), x86_64_linux.ENOMEM)), r) &&
       bits_of_int(32, fst(r)) = bits_of_int(32, int_sub(int_pow(2, 32), 1)) && V in x86_64_linux.Vm && k in omega && int_le(S, k) && int_lt(k, E) &&
       !x86_64_linux.mapped(t.vm, k) && (all q. q in omega -> int_le(S, q) && int_lt(q, k) -> x86_64_linux.mapped(t.vm, q)) &&
       mallocng_specs.reprot(t.vm, V, S, int_sub(k, S), PR))
  have ne: ex z. z in bits(64) by ex_intro({0}, simp())
  // (a 32-bit result from state W: as GIMPLE's wrapper returns it)
  have res: all W v. v in bits(32) -> o3 = ok(W, v) -> ex r. o2 = ok(W, r) && bits_of_int(32, fst(r)) = v proof
    fix W v
    assume hv hx
    have k1: bind_rel(gimple.result(32, v), W, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. o2 = ok(x6, pair(x8, x9)))), x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))
      by simp(expand(rewrite(hx, hk3), letin), keep(bind_rel, gimple.result))
    obtain o4, hr4 hk4 from expand(k1, bind_rel)
    obtain u, hu64 hlow ho4 from apply(g.result32_inv, hv, hr4)
    have k2: any_rel(x9. x9 in bits(64), x9. o2 = ok(W, pair(u, x9))) by simp(expand(rewrite(ho4, hk4), letin), keep(any_rel))
    obtain z, _ hoz from apply(g.any_e, ne, k2)
    show by ex_intro({pair(u, z)}, taut(hoz, (bits_of_int(32, fst(pair(u, z))) = v by simp(hlow))))
  qed
  have c1: (ex v. v in x86_64_linux.Vm && o3 = exc(fn_update(t, "vm", v), OVF)) -> G proof
    assume x
    obtain v, hv hx from x
    have oe: o2 = exc(fn_update(t, "vm", v), OVF) by simp(rewrite(hx, hk3))
    have l: ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), OVF) by ex_intro({v}, taut(hv, oe))
    show by taut(l)
  qed
  have c2: (ex V. G1(V) && o3 = ok(fn_update(t, "vm", V), 0)) -> G proof
    assume x
    obtain V, hV hall hrp hx from x
    obtain r, hor hr from mp(all_elim(res, {fn_update(t, "vm", V)}, {0}), simp(), hx)
    have l: ex V r. o2 = ok(fn_update(t, "vm", V), r) && bits_of_int(32, fst(r)) = 0 && V in x86_64_linux.Vm && ALL && mallocng_specs.reprot(t.vm, V, S, int_sub(E, S), PR)
      by ex_intro({V}, {r}, taut(hor, hr, hV, hall, hrp))
    show by taut(l)
  qed
  have c3: (ex V k. G2(V, k) && o3 = ok(fn_update(t, "vm", mallocng_specs.wr32(V, mallocng_specs.errno_at(t.fs_base), x86_64_linux.ENOMEM)), bits_of_int(32, int_sub(int_pow(2, 32), 1)))) -> G proof
    assume x
    obtain V k, hV hk hrp hx from x
    obtain r, hor hr from mp(all_elim(res, {fn_update(t, "vm", mallocng_specs.wr32(V, mallocng_specs.errno_at(t.fs_base), x86_64_linux.ENOMEM))}, {bits_of_int(32, int_sub(int_pow(2, 32), 1))}), simp(), hx)
    have l: ex V k r. o2 = ok(fn_update(t, "vm", mallocng_specs.wr32(V, mallocng_specs.errno_at(t.fs_base), x86_64_linux.ENOMEM)), r) &&
        bits_of_int(32, fst(r)) = bits_of_int(32, int_sub(int_pow(2, 32), 1)) && V in x86_64_linux.Vm && k in omega && int_le(S, k) && int_lt(k, E) &&
        !x86_64_linux.mapped(t.vm, k) && (all q. q in omega -> int_le(S, q) && int_lt(q, k) -> x86_64_linux.mapped(t.vm, q)) &&
        mallocng_specs.reprot(t.vm, V, S, int_sub(k, S), PR) by ex_intro({V}, {k}, {r}, taut(hor, hr, hV, hk, hrp))
    show by taut(l)
  qed
  have c4: (ex k. LEAST(k) && !RX(k)) -> G proof
    assume x
    obtain k, ko hkr hn from x
    have _ _ _ hbelow := hkr
    have m: all q. q in omega -> int_le(S, q) -> int_lt(q, int_add(S, int_sub(k, S))) -> x86_64_linux.mapped(t.vm, q) proof
      fix q
      assume h1 h2 h3
      show := mp(all_elim(hbelow, {q}), h1, conj(h2, (int_lt(q, k) by arith(h3))))
    qed
    have f: RX(k) := apply(mp.reprot_ex[before := t.vm, p := S, n := int_sub(k, S), pr := PR], pv, vu, pt, m)
    show by taut(f, hn)
  qed
  show by taut(ci, c1, c2, c3, c4)
qed

// ----------------------------------------------------------------------
//  The context's words: the invariant's usable

// (n bytes of the context from off, none a free one: usable, for reading
// and writing)
theorem mp.ctx_usable(c, A, vm, b, objs, off, n): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_in(c, A, vm, b) ->
  off in omega -> n in omega -> int_le(int_add(off, n), mallocng.CTX_SIZE) -> (all i. i in omega -> int_lt(i, n) -> !mallocng.ctx_free(c, int_add(int_add(c.ctx, off), i))) ->
  gimple.usable(vm, objs, int_add(c.ctx, off), n, false) && gimple.usable(vm, objs, int_add(c.ctx, off), n, true)
proof
  assume hc hu ha hh ho hn hl hf
  let F := mallocng.held(c, A, b)
  have cx: c.ctx in omega by simp(expand(hc, mallocng.Cfg))
  have each: all i. i in omega -> int_lt(i, n) -> int_add(int_add(c.ctx, off), i) in F && mallocng.m_rw(mallocng.mview(vm, F), int_add(int_add(c.ctx, off), i)) &&
      !(snd(mallocng.pg(mallocng.mview(vm, F), int_add(int_add(c.ctx, off), i))).kind = 2) proof
    fix i
    assume hi hil
    show := apply(mp.ctx_acc[c := c, A := A, vm := vm, b := b, a := int_add(int_add(c.ctx, off), i)], hc, hu, ha, hh, arith(cx, ho, hi), arith(ho, hi), arith(hl, hil, ho, hi),
      mp(all_elim(hf, {i}), hi, hil))
  qed
  show := apply(mp.rw_usable[vm := vm, F := F, objs := objs, a := int_add(c.ctx, off), n := n], arith(cx, ho), each)
qed

// (... read: the view's)
theorem mp.ctx_read(c, A, vm, b, off, n): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_in(c, A, vm, b) ->
  off in omega -> n in omega -> int_le(int_add(off, n), mallocng.CTX_SIZE) -> (all i. i in omega -> int_lt(i, n) -> !mallocng.ctx_free(c, int_add(int_add(c.ctx, off), i))) ->
  gimple.bytes_at(vm, int_add(c.ctx, off), n) = mallocng.rd(mallocng.mview(vm, mallocng.held(c, A, b)), int_add(c.ctx, off), n)
proof
  assume hc hu ha hh ho hn hl hf
  have cx: c.ctx in omega by simp(expand(hc, mallocng.Cfg))
  have cs: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  have each: all i. i in omega -> int_lt(i, n) -> int_add(int_add(c.ctx, off), i) in mallocng.held(c, A, b) proof
    fix i
    assume hi hil
    have r := apply(mp.ctx_acc[c := c, A := A, vm := vm, b := b, a := int_add(int_add(c.ctx, off), i)], hc, hu, ha, hh, arith(cx, ho, hi), arith(ho, hi), arith(hl, hil, ho, hi),
      mp(all_elim(hf, {i}), hi, hil))
    show by taut(r)
  qed
  show := apply(mp.view_read[vm := vm, fp := mallocng.held(c, A, b), a := int_add(c.ctx, off), n := n], arith(cx, ho), hn, arith(hl, cs, ho), each)
qed

// ----------------------------------------------------------------------
//  Before the first call: the image's, the data's and the auxiliary
//  vector's bytes the invariant's

// (a byte of those ranges, not a free counter's: held -- no group, no
// area yet)
theorem mp.fresh_held(c, A, vm, b, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  mallocng.holds_in(c, A, vm, b) -> A.init_done = 0 -> a in omega ->
  mallocng.in_ranges(a, seq_concat(seq_concat(mallocng.ro_ranges(c.file), mallocng.data_ranges(c)), mallocng.auxv_ranges(A))) -> !mallocng.ctx_free(c, a) ->
  a in mallocng.held(c, A, b)
proof
  assume hc hu ha hb hh h0 hao hr hnf
  let M := mallocng.mview(vm, mallocng.held(c, A, b))
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {huo = used, hga = apart, hfr = fresh} := expand(H, mallocng.holds)
  have {z1 = areas, z4 = used} := mp(expand(hfr, mallocng.fresh_ok), h0)
  have nl: !(a in malloc.live_of(b)) proof
    assume hl
    obtain g, hg _ from apply(mp.live_grp[c := c, A := A, M := M, b := b, brk := vm.brk, a := a], ha, hb, H, hl)
    obtain k, hk hkl _ from expand(hg, mallocng.is_used)
    show by arith(hkl, z4, hk)
  qed
  have nr := apply(mp.fixed_unres[c := c, A := A, M := M, b := b, a := a], hc, hu, ha, hao, huo, hga, taut(hr))
  have na: all k. k in omega -> int_lt(k, seq_len(A.areas)) -> !(int_le(A.areas[k], a) && int_lt(a, int_add(A.areas[k], 4096))) proof
    fix k
    assume hk hkl
    show by arith(hkl, z1, hk)
  qed
  have nt := apply(mp.untaken_of[c := c, A := A, M := M, b := b, brk := vm.brk, a := a], hc, hu, ha, H, hao, na)
  have fp := apply(mp.fp_intro[c := c, A := A, b := b, a := a], hc, hu, ha, hao, nl, nr, nt, taut(hr))
  show := apply(mp.held_intro, fp, hnf)
qed

// (libc's auxv word -- libc + 8, a data symbol's bytes: usable, the
// auxiliary vector's address)
theorem mp.libc_auxv(c, A, vm, b, objs): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  mallocng.holds_in(c, A, vm, b) -> A.init_done = 0 ->
  gimple.usable(vm, objs, int_add(c.libc, 8), 8, false) && gimple.bytes_at(vm, int_add(c.libc, 8), 8) = A.auxv_at &&
  int_lt(int_add(c.libc, 16), int_pow(2, 64))
proof
  assume hc hu ha hb hh h0
  let M := mallocng.mview(vm, mallocng.held(c, A, b))
  let F := mallocng.held(c, A, b)
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {hpo = perms, hsp = sep, hfr = fresh} := expand(H, mallocng.holds)
  have {fat = auxv_at} := mp(expand(hfr, mallocng.fresh_ok), h0)
  have {pd = data} := expand(hpo, mallocng.perms_ok)
  have {rd = rodata, xl = auxv} := apply(mp.front_pieces, hc, hu, ha)
  have ro := apply(mp.ro_list, (c.file in seq_type(bits(8)) by simp(hc)))
  have cf1 cf2 cf3 := (c.ctx in omega && c.lock in omega && c.libc in omega by simp(hc))
  have o1 := apply(tr.seq_one_type, (pair(c.ctx, mallocng.CTX_SIZE) in univ(1) by simp(cf1)))
  have o2 := apply(tr.seq_one_type, (pair(c.lock, 4) in univ(1) by simp(cf2)))
  have o3 := apply(tr.seq_one_type, (pair(c.libc, 16) in univ(1) by simp(cf3)))
  have dl: mallocng.data_ranges(c) in list_type(univ(1)) by defs(apply(tr.concat_list, apply(tr.concat_list, o1, o2), o3), mallocng.data_ranges)
  have dll: seq_len(mallocng.data_ranges(c)) = 3 by defs(arith(), mallocng.data_ranges)
  have d0 _ d2 := mp.data_at[c := c]
  have {rg0 = data} := apply(mp.reg_at[c := c, A := A, i := 0], hc, hu, ha, simp())
  have {rg2 = data} := apply(mp.reg_at[c := c, A := A, i := 2], hc, hu, ha, simp())
  have {rgl = len} := apply(mp.reg_at[c := c, A := A, i := 0], hc, hu, ha, simp())
  have fs: c.file in seq_type(bits(8)) by simp(hc)
  have pn: x86_64_linux.phnum(c.file) in omega by defs(mp(x86.le_at_nat[f := c.file, off := 56, n := 2], fs, simp()), x86_64_linux.phnum)
  have al: seq_len(A.areas) in omega by arith((A.areas in list_type(omega) by simp(ha)))
  have ap := mp(all_elim(expand(hsp, mallocng.separate), {2}, {0}), conj((2 in omega by simp()), (0 in omega by simp())),
    ((int_lt(2, seq_len(mallocng.regions(c, A))) && int_lt(0, seq_len(mallocng.regions(c, A)))) && !(2 = 0) by arith(rgl, pn, al)))
  have ap2: mallocng.apart(pair(c.libc, 16), pair(c.ctx, mallocng.CTX_SIZE)) := rewrite(d0, rewrite(d2, rewrite(mp(rg0, simp()), rewrite(mp(rg2, simp()), ap))))
  have cs: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  have each: all i. i in omega -> int_lt(i, 8) -> int_add(int_add(c.libc, 8), i) in F && mallocng.m_mapped(M, int_add(int_add(c.libc, 8), i)) &&
      snd(mallocng.pg(M, int_add(int_add(c.libc, 8), i))).prot.r && !(snd(mallocng.pg(M, int_add(int_add(c.libc, 8), i))).kind = 2) proof
    fix i
    assume hi hil
    let x := int_add(int_add(c.libc, 8), i)
    have xo: x in omega by arith(cf3, hi)
    have xr: mallocng.in_range(x, pair(c.libc, 16)) by defs(simp((int_le(c.libc, x) && int_lt(x, int_add(c.libc, 16)) by arith(hi, hil, cf3))), mallocng.in_range)
    have nx := apply(mp.apart_not[r := pair(c.libc, 16), q := pair(c.ctx, mallocng.CTX_SIZE), a := x], mp(cart_intro[a := omega, b := omega, x := c.libc, y := 16], cf3, simp()),
      mp(cart_intro[a := omega, b := omega, x := c.ctx, y := mallocng.CTX_SIZE], cf1, (mallocng.CTX_SIZE in omega by simp(cs))), ap2, xr)
    have ncf: !mallocng.ctx_free(c, x) proof
      assume hf
      have ic0: int_le(c.ctx, x) && int_lt(x, int_add(c.ctx, 928)) by arith(expand(hf, mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK))
      have ic: mallocng.in_range(x, pair(c.ctx, mallocng.CTX_SIZE)) by defs(simp(ic0, cs), mallocng.in_range)
      show by taut(ic, nx)
    qed
    have ir: mallocng.in_ranges(x, mallocng.data_ranges(c)) by defs(ex_intro({2}, taut((2 in omega by simp()), (int_lt(2, seq_len(mallocng.data_ranges(c))) by arith(dll)), rewrite(sym(d2), xr))), mallocng.in_ranges)
    have q := apply(mp.ranges_l, rd, xl, apply(mp.ranges_r, ro, dl, ir))
    have xh := apply(mp.fresh_held[c := c, A := A, vm := vm, b := b, a := x], hc, hu, ha, hb, hh, h0, xo, q, ncf)
    have rw ns := mp(all_elim(pd, {2}, {x}), conj((2 in omega by simp()), xo), taut((int_lt(2, 3) by simp()), expand(rewrite(sym(d2), xr), mallocng.in_range), ncf))
    show by taut(xh, expand(rw, mallocng.m_rw), ns)
  qed
  have us := apply(mp.view_usable[vm := vm, fp := F, objs := objs, a := int_add(c.libc, 8), n := 8], arith(cf3), each)
  have inF: all i. i in omega -> int_lt(i, 8) -> int_add(int_add(c.libc, 8), i) in F proof
    fix i
    assume hi hil
    have e1 _ _ _ := mp(all_elim(each, {i}), hi, hil)
    show := e1
  qed
  have er := apply(mp.view_read[vm := vm, fp := F, a := int_add(c.libc, 8), n := 8], arith(cf3), simp(), simp(), inF)
  have la: mallocng.L_AUXV = 8 by defs(refl({8}), mallocng.L_AUXV)
  have _ m7 _ _ := mp(all_elim(each, {7}), simp(), simp())
  have lt: int_lt(int_add(c.libc, 16), int_pow(2, 64)) by arith(expand(m7, mallocng.m_mapped, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE), cf3)
  show by taut(us, trans(er, rewrite(la, fat)), lt)
qed

// (a byte of the auxiliary vector's ranges: held, readable, below the user
// space's end, not the stack's)
theorem mp.auxv_byte(c, A, vm, b, j, x): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  mallocng.holds_in(c, A, vm, b) -> A.init_done = 0 -> j in omega -> int_lt(j, seq_len(mallocng.auxv_ranges(A))) -> x in omega ->
  mallocng.in_range(x, mallocng.auxv_ranges(A)[j]) ->
  x in mallocng.held(c, A, b) && mallocng.m_mapped(mallocng.mview(vm, mallocng.held(c, A, b)), x) &&
  snd(mallocng.pg(mallocng.mview(vm, mallocng.held(c, A, b)), x)).prot.r && !(snd(mallocng.pg(mallocng.mview(vm, mallocng.held(c, A, b)), x)).kind = 2)
proof
  assume hc hu ha hb hh h0 hj hjl hx hr
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {hpo = perms, hfr = fresh} := expand(H, mallocng.holds)
  have {fac = auxv_ctx} := mp(expand(hfr, mallocng.fresh_ok), h0)
  have {pa = auxv} := expand(hpo, mallocng.perms_ok)
  have {rd = rodata, xl = auxv} := apply(mp.front_pieces, hc, hu, ha)
  have r1 r2 := expand(hr, mallocng.in_range)
  have nc := mp(all_elim(fac, {j}, {x}), conj(hj, hx), taut(hjl, r1, r2))
  have ncf: !mallocng.ctx_free(c, x) proof
    assume hf
    have ic: int_le(c.ctx, x) && int_lt(x, int_add(c.ctx, mallocng.CTX_SIZE))
      by defs(arith(expand(hf, mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK)), mallocng.CTX_SIZE)
    show by taut(ic, nc)
  qed
  have ir: mallocng.in_ranges(x, mallocng.auxv_ranges(A)) by defs(ex_intro({j}, taut(hj, hjl, hr)), mallocng.in_ranges)
  have q := apply(mp.ranges_r, rd, xl, ir)
  have xh := apply(mp.fresh_held[c := c, A := A, vm := vm, b := b, a := x], hc, hu, ha, hb, hh, h0, hx, q, ncf)
  have m1 m2 m3 := mp(all_elim(pa, {j}, {x}), conj(hj, hx), taut(hjl, r1, r2))
  show by taut(xh, m1, m2, m3)
qed

// libc's auxiliary vector readable, as get_random_secret reads it (the
// allocator not yet initialized)
theorem mp.am_auxv(c, A, vm, b, objs): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  mallocng.holds_in(c, A, vm, b) -> A.init_done = 0 -> vm.bytes in fn_space(bits(64), bits(8)) ->
  mallocng_specs.auxv_ok(vm, objs, c.libc)
proof
  assume hc hu ha hb hh h0 hvb
  let M := mallocng.mview(vm, mallocng.held(c, A, b))
  let F := mallocng.held(c, A, b)
  let L := A.auxv
  let AT := A.auxv_at
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {hfr = fresh} := expand(H, mallocng.holds)
  have {fal = auxv_len, fav = auxv, fae = auxv_end, fan = auxv_null} := mp(expand(hfr, mallocng.fresh_ok), h0)
  have lu le lb := apply(mp.libc_auxv[c := c, A := A, vm := vm, b := b, objs := objs], hc, hu, ha, hb, hh, h0)
  have cf3: c.libc in omega by simp(hc)
  have bl: bits_add(64, c.libc, 8) = int_add(c.libc, 8) by defs(arith(cf3, lb), bits_add, pow2)
  have ll: L in list_type(cart(omega, omega)) by simp(ha)
  have lo: seq_len(L) in omega by arith(ll)
  have ato: AT in omega by simp(ha)
  // (the ranges: the vector's 16-byte pairs, then each entry's AT_RANDOM bytes)
  let FB := fn_build(int_sub(seq_len(L), 0), x0. ite(fst(L[int_add(0, x0)]) = x86_64_linux.AT_RANDOM, pair(int_add(snd(L[int_add(0, x0)]), 8), 8), pair(0, 0)))
  have fbv: all x0. x0 in int_sub(seq_len(L), 0) -> ite(fst(L[int_add(0, x0)]) = x86_64_linux.AT_RANDOM, pair(int_add(snd(L[int_add(0, x0)]), 8), 8), pair(0, 0)) in univ(1) proof
    fix x0
    assume _
    show by simp(hu)
  qed
  have fbl := apply(build_list, (int_sub(seq_len(L), 0) in omega by arith(lo)), fbv)
  have ar: mallocng.auxv_ranges(A) = seq_concat(seq_one(pair(AT, int_mul(16, seq_len(L)))), FB) by defs(refl({mallocng.auxv_ranges(A)}), mallocng.auxv_ranges)
  have dd := fn_build_dom[d := int_sub(seq_len(L), 0), v := x0. ite(fst(L[int_add(0, x0)]) = x86_64_linux.AT_RANDOM, pair(int_add(snd(L[int_add(0, x0)]), 8), 8), pair(0, 0))]
  have fbn: seq_len(FB) = seq_len(L) by defs(arith(expand(dd, seq_len), expand(lo, seq_len)), seq_len)
  have arl: seq_len(mallocng.auxv_ranges(A)) = int_add(1, seq_len(L)) := rewrite(sym(ar), (seq_len(seq_concat(seq_one(pair(AT, int_mul(16, seq_len(L)))), FB)) = int_add(1, seq_len(L)) by arith(fbl, fbn)))
  have ar0: mallocng.auxv_ranges(A)[0] = pair(AT, int_mul(16, seq_len(L))) := rewrite(sym(ar), at({seq_concat(seq_one(pair(AT, int_mul(16, seq_len(L)))), FB)[0]}, fbl))
  have ba: gimple.bytes_at(vm, bits_add(64, c.libc, 8), 8) = AT := rewrite(sym(bl), le)
  let LA := gimple.bytes_at(vm, bits_add(64, c.libc, 8), 8)
  // (n bytes from p, all in the auxiliary vector's range j: usable, read as the view has them)
  have rng: all j p n. j in omega -> int_lt(j, seq_len(mallocng.auxv_ranges(A))) -> p in omega -> n in omega -> int_lt(0, n) -> int_le(n, 16) ->
      (all i. i in omega -> int_lt(i, n) -> mallocng.in_range(int_add(p, i), mallocng.auxv_ranges(A)[j])) ->
      gimple.usable(vm, objs, p, n, false) && gimple.bytes_at(vm, p, n) = mallocng.rd(M, p, n) && int_lt(int_add(p, n), int_pow(2, 64)) proof
    fix j p n
    assume hj hjl hp hn hn0 hn16 hin
    have each: all i. i in omega -> int_lt(i, n) -> int_add(p, i) in F && mallocng.m_mapped(M, int_add(p, i)) &&
        snd(mallocng.pg(M, int_add(p, i))).prot.r && !(snd(mallocng.pg(M, int_add(p, i))).kind = 2) proof
      fix i
      assume hi hil
      show := apply(mp.auxv_byte[c := c, A := A, vm := vm, b := b, j := j, x := int_add(p, i)], hc, hu, ha, hb, hh, h0, hj, hjl, arith(hp, hi), mp(all_elim(hin, {i}), hi, hil))
    qed
    have inF: all i. i in omega -> int_lt(i, n) -> int_add(p, i) in F proof
      fix i
      assume hi hil
      have e1 _ _ _ := mp(all_elim(each, {i}), hi, hil)
      show := e1
    qed
    have us := apply(mp.view_usable[vm := vm, fp := F, objs := objs, a := p, n := n], hp, each)
    have er := apply(mp.view_read[vm := vm, fp := F, a := p, n := n], hp, hn, arith(hn16), inF)
    have _ ml _ _ := mp(all_elim(each, {int_sub(n, 1)}), arith(hn0, hn), arith(hn0))
    have nb: int_lt(int_add(p, n), int_pow(2, 64)) by arith(expand(ml, mallocng.m_mapped, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE), hp, hn, hn0)
    show by taut(us, er, nb)
  qed
  have a0l: int_lt(0, seq_len(mallocng.auxv_ranges(A))) by arith(arl, lo)
  // each entry: its pair readable, as the view has it; AT_RANDOM's 8 bytes readable
  have ent: all x1. x1 in omega -> int_lt(x1, seq_len(L)) ->
      ((gimple.usable(vm, objs, int_add(AT, int_mul(16, x1)), 16, false) && gimple.bytes_at(vm, bits_of_int(64, int_add(AT, int_mul(16, x1))), 8) = fst(L[x1])) &&
        gimple.bytes_at(vm, bits_of_int(64, int_add(int_add(AT, int_mul(16, x1)), 8)), 8) = snd(L[x1])) &&
      (fst(L[x1]) = x86_64_linux.AT_RANDOM -> gimple.usable(vm, objs, int_add(snd(L[x1]), 8), 8, false)) proof
    fix k
    assume hk hkl
    let P := int_add(AT, int_mul(16, k))
    have po: P in omega by arith(ato, hk)
    have r0: all i. i in omega -> int_lt(i, 16) -> mallocng.in_range(int_add(P, i), mallocng.auxv_ranges(A)[0]) proof
      fix i
      assume hi hil
      show by defs(simp(ar0, (int_le(AT, int_add(P, i)) && int_lt(int_add(P, i), int_add(AT, int_mul(16, seq_len(L)))) by arith(hi, hil, hk, hkl, ato))), mallocng.in_range)
    qed
    have r8: all i. i in omega -> int_lt(i, 8) -> mallocng.in_range(int_add(int_add(P, 8), i), mallocng.auxv_ranges(A)[0]) proof
      fix i
      assume hi hil
      show by defs(simp(ar0, (int_le(AT, int_add(int_add(P, 8), i)) && int_lt(int_add(int_add(P, 8), i), int_add(AT, int_mul(16, seq_len(L)))) by arith(hi, hil, hk, hkl, ato))), mallocng.in_range)
    qed
    have r08: all i. i in omega -> int_lt(i, 8) -> mallocng.in_range(int_add(P, i), mallocng.auxv_ranges(A)[0]) proof
      fix i
      assume hi hil
      show := mp(all_elim(r0, {i}), hi, (int_lt(i, 16) by arith(hil)))
    qed
    have u16 _ n16 := mp(all_elim(rng, {0}, {P}, {16}), simp(), a0l, po, simp(), simp(), simp(), r0)
    have _ e0 _ := mp(all_elim(rng, {0}, {P}, {8}), simp(), a0l, po, simp(), simp(), simp(), r08)
    have _ e8 _ := mp(all_elim(rng, {0}, {int_add(P, 8)}, {8}), simp(), a0l, arith(po), simp(), simp(), simp(), r8)
    have bp: bits_of_int(64, P) = P by defs(arith(po, n16), bits_of_int, pow2)
    have bp8: bits_of_int(64, int_add(P, 8)) = int_add(P, 8) by defs(arith(po, n16), bits_of_int, pow2)
    have v0 v1 := mp(all_elim(fav, {k}), hk, hkl)
    have w0: gimple.bytes_at(vm, bits_of_int(64, P), 8) = fst(L[k]) := rewrite(sym(bp), trans(e0, v0))
    have w1: gimple.bytes_at(vm, bits_of_int(64, int_add(P, 8)), 8) = snd(L[k]) := rewrite(sym(bp8), trans(e8, v1))
    // (AT_RANDOM's: the range 1 + k)
    have rnd: fst(L[k]) = x86_64_linux.AT_RANDOM -> gimple.usable(vm, objs, int_add(snd(L[k]), 8), 8, false) proof
      assume hr
      let Q := int_add(snd(L[k]), 8)
      have lk := apply(at_type[l := L, t := cart(omega, omega), i := k], ll, hk, hkl)
      have _ s0 := apply(mp.cart_nat, lk)
      have qo: Q in omega by arith(s0)
      have kd: k in int_sub(seq_len(L), 0) by simp(hk, hkl, lo)
      have fk := app_fn_build[d := int_sub(seq_len(L), 0), v := x0. ite(fst(L[int_add(0, x0)]) = x86_64_linux.AT_RANDOM, pair(int_add(snd(L[int_add(0, x0)]), 8), 8), pair(0, 0)), a := k]
      have z0: int_add(0, k) = k by arith(hk)
      have fbk: FB[k] = pair(Q, 8) by simp(mp(fk, kd), hr, z0)
      have a1 := at({seq_concat(seq_one(pair(AT, int_mul(16, seq_len(L)))), FB)[int_add(1, k)]}, fbl, hk, (int_lt(int_add(1, k), int_add(1, seq_len(FB))) by arith(fbn, hkl)))
      have k1: int_sub(int_add(1, k), 1) = k by arith(hk)
      have ark: mallocng.auxv_ranges(A)[int_add(1, k)] = pair(Q, 8) := rewrite(sym(ar), trans(a1, (FB[int_sub(int_add(1, k), 1)] = pair(Q, 8) by simp(fbk, k1))))
      have rq: all i. i in omega -> int_lt(i, 8) -> mallocng.in_range(int_add(Q, i), mallocng.auxv_ranges(A)[int_add(1, k)]) proof
        fix i
        assume hi hil
        show by defs(simp(ark, (int_le(Q, int_add(Q, i)) && int_lt(int_add(Q, i), int_add(Q, 8)) by arith(hi, hil, qo))), mallocng.in_range)
      qed
      have uq _ _ := mp(all_elim(rng, {int_add(1, k)}, {Q}, {8}), arith(hk), arith(arl, hkl), qo, simp(), simp(), simp(), rq)
      show := uq
    qed
    show by taut(u16, w0, w1, rnd)
  qed
  have ent2 := rewrite(sym(ba), ent)
  have o1: ord_le(1, seq_len(L)) := fal
  show by defs(taut(lu, (ex x0. x0 in list_type(cart(omega, omega)) && (((ord_le(1, seq_len(x0)) && (all x1. x1 in omega -> int_lt(x1, seq_len(x0)) ->
      ((gimple.usable(vm, objs, int_add(LA, int_mul(16, x1)), 16, false) && gimple.bytes_at(vm, bits_of_int(64, int_add(LA, int_mul(16, x1))), 8) = fst(x0[x1])) &&
        gimple.bytes_at(vm, bits_of_int(64, int_add(int_add(LA, int_mul(16, x1)), 8)), 8) = snd(x0[x1])) &&
      (fst(x0[x1]) = x86_64_linux.AT_RANDOM -> gimple.usable(vm, objs, int_add(snd(x0[x1]), 8), 8, false)))) &&
      fst(x0[int_sub(seq_len(x0), 1)]) = x86_64_linux.AT_NULL) && (all x1. x1 in omega -> int_lt(int_add(x1, 1), seq_len(x0)) -> !(fst(x0[x1]) = x86_64_linux.AT_NULL)))
    by ex_intro({L}, taut(ll, o1, ent2, fae, fan)))), mallocng_specs.auxv_ok)
qed

// ----------------------------------------------------------------------
//  Steps in a row: memory untouched outside the allocator, its footprint
//  grown only by memory unmapped before

// (errno: the thread's word at fs_base + 0x34)
abbrev mp.errno(fs) := set_select(omega, x. int_le(int_add(fs, 52), x) && int_lt(x, int_add(fs, 56)))

// (the allocator grown only into memory unmapped before)
abbrev mp.grown(c, A2, A, b, vm) := all a. a in omega -> a in mallocng.footprint(c, A2, b) ->
  a in mallocng.footprint(c, A, b) || !x86_64_linux.mapped(vm, int_div(a, x86_64_linux.PAGE))

// (memory untouched outside the allocator twice, the allocator grown
// between only into memory unmapped before: untouched)
theorem mp.unt_grow(c, A, A1, b, V0, V1, V2, e): mallocng.untouched(c, A, b, V0, V1, e) -> mallocng.untouched(c, A1, b, V1, V2, e) ->
  mp.grown(c, A1, A, b, V0) -> mallocng.untouched(c, A, b, V0, V2, e)
proof
  assume u1 u2 fg
  have a1 b1 := expand(u1, mallocng.untouched)
  have a2 b2 := expand(u2, mallocng.untouched)
  have r: all x0. x0 in omega -> (!(x0 in mallocng.footprint(c, A, b)) && !(x0 in e)) && x86_64_linux.mapped(V0, int_div(x0, x86_64_linux.PAGE)) ->
      V2.bytes[bits_of_int(64, x0)] = V0.bytes[bits_of_int(64, x0)] && V2.pages[int_div(x0, x86_64_linux.PAGE)] = V0.pages[int_div(x0, x86_64_linux.PAGE)] proof
    fix a
    assume ha hq
    have q1 q2 q3 := hq
    have p1 pp1 := mp(all_elim(a1, {a}), ha, hq)
    have m1: x86_64_linux.mapped(V1, int_div(a, x86_64_linux.PAGE)) by defs(rewrite(sym(pp1), expand(q3, x86_64_linux.mapped)), x86_64_linux.mapped)
    have n1: !(a in mallocng.footprint(c, A1, b)) proof
      assume h1
      show by taut(mp(all_elim(fg, {a}), ha, h1), q1, q3)
    qed
    have p2 pp2 := mp(all_elim(a2, {a}), ha, conj(conj(n1, q2), m1))
    show by taut(trans(p2, p1), trans(pp2, pp1))
  qed
  show by defs(taut(r, trans(b2, b1)), mallocng.untouched)
qed

// (... the footprint grown so twice: so)
theorem mp.fp_grow(c, A, A1, A2, b, V0, V1, e): mallocng.untouched(c, A, b, V0, V1, e) -> mp.grown(c, A1, A, b, V0) -> mp.grown(c, A2, A1, b, V1) ->
  (all a. a in omega -> a in mallocng.footprint(c, A2, b) -> !(a in e)) -> mp.grown(c, A2, A, b, V0)
proof
  assume u1 f1 f2 ne
  have a1 _ := expand(u1, mallocng.untouched)
  fix a
  assume ha h2
  have c1: a in mallocng.footprint(c, A1, b) -> a in mallocng.footprint(c, A, b) || !x86_64_linux.mapped(V0, int_div(a, x86_64_linux.PAGE)) proof
    assume h
    show := mp(all_elim(f1, {a}), ha, h)
  qed
  have c2: !x86_64_linux.mapped(V1, int_div(a, x86_64_linux.PAGE)) -> a in mallocng.footprint(c, A, b) || !x86_64_linux.mapped(V0, int_div(a, x86_64_linux.PAGE)) proof
    assume hn
    have k: !(a in mallocng.footprint(c, A, b)) -> x86_64_linux.mapped(V0, int_div(a, x86_64_linux.PAGE)) -> false proof
      assume n0 m0
      have _ pp := mp(all_elim(a1, {a}), ha, conj(conj(n0, mp(all_elim(ne, {a}), ha, h2)), m0))
      have m1: x86_64_linux.mapped(V1, int_div(a, x86_64_linux.PAGE)) by defs(rewrite(sym(pp), expand(m0, x86_64_linux.mapped)), x86_64_linux.mapped)
      show by taut(m1, hn)
    qed
    show by taut(k)
  qed
  show by taut(mp(all_elim(f2, {a}), ha, h2), c1, c2)
qed

// (bytes outside the footprint changed, nothing else: the invariant kept --
// its view the same, the pages the same)
theorem mp.out_holds(c, A, vm, vm2, b): mallocng.holds_in(c, A, vm, b) -> fn_update(vm2, "bytes", vm.bytes) = vm ->
  (all x. x in bits(64) -> x in mallocng.footprint(c, A, b) -> vm2.bytes[x] = vm.bytes[x]) -> mallocng.holds_in(c, A, vm2, b)
proof
  assume hh er eb
  have {H = inv, hm = mapped, hfr = free, hrw = rw} := expand(hh, mallocng.holds_in)
  have up := mp(app_update_other[f := vm2, k := "bytes", v := vm.bytes, x := "pages"], (!("pages" = "bytes") by simp()))
  have ep: vm2.pages = vm.pages := sym(rewrite(er, up))
  have uk := mp(app_update_other[f := vm2, k := "bytes", v := vm.bytes, x := "brk"], (!("brk" = "bytes") by simp()))
  have ek: vm2.brk = vm.brk := sym(rewrite(er, uk))
  let FP := mallocng.held(c, A, b)
  have ag: all a. a in omega -> mallocng.mview(vm2, FP)[a] = mallocng.mview(vm, FP)[a] proof
    fix a
    assume hao
    have bt: a in FP -> vm2.bytes[bits_of_int(64, a)] = vm.bytes[bits_of_int(64, a)] proof
      assume hf
      have {hff = fp} := apply(mp.held_fp, hf)
      have lo := apply(mp.fp_low[c := c, A := A, vm := vm, b := b, a := a], hm, hff)
      have e: bits_of_int(64, a) = a by defs(arith(hao, lo), bits_of_int, pow2)
      have ab: a in bits(64) by arith(hao, lo)
      show := rewrite(sym(e), mp(all_elim(eb, {a}), ab, hff))
    qed
    show := apply(mp.view_agree[vm := vm, vm2 := vm2, fp := FP, a := a], hao, bt, ep)
  qed
  have ve := apply(mp.view_ext[vm := vm, vm2 := vm2, fp := FP], ag)
  have i2 := rewrite(sym(ek), rewrite(sym(ve), H))
  have m2 := apply(mp.fpm_pages, hm, ep)
  have fr2 := apply(mp.free_rw_pages[c := c, vm := vm, vm2 := vm2, F := mallocng.footprint(c, A, b)], hfr, ep)
  have rw2 := apply(mp.grp_rw_pg[c := c, A := A, vm := vm, vm2 := vm2, b := b], hrw, ep)
  show by defs(taut(i2, m2, fr2, rw2), mallocng.holds_in)
qed

// ----------------------------------------------------------------------
//  The run's states: the invariant for A1 on V, the groups and the taken
//  metas as at the entry (A, s), memory outside the allocator untouched
//  but errno, the footprint grown only by memory unmapped before, errno's
//  pages as they were

theorem mp.gk_refl(A): mallocng_specs.groups_kept(A, A)
proof
  have g: all g. g in omega -> mallocng.is_used(A, g) -> A.metas[g] = A.metas[g] proof
    fix g
    assume _ _
    show := refl({A.metas[g]})
  qed
  show by defs(taut(refl({A.used}), refl({A.slots}), refl({A.active}), g), mallocng_specs.groups_kept)
qed

theorem mp.gk_trans(A, A1, A2): mallocng_specs.groups_kept(A, A1) -> mallocng_specs.groups_kept(A1, A2) -> mallocng_specs.groups_kept(A, A2)
proof
  assume h1 h2
  have u1 s1 a1 m1 := expand(h1, mallocng_specs.groups_kept)
  have u2 s2 a2 m2 := expand(h2, mallocng_specs.groups_kept)
  have g: all g. g in omega -> mallocng.is_used(A, g) -> A2.metas[g] = A.metas[g] proof
    fix g
    assume go hu
    have hu1: mallocng.is_used(A1, g) by defs(rewrite(sym(u1), expand(hu, mallocng.is_used)), mallocng.is_used)
    show := trans(mp(all_elim(m2, {g}), go, hu1), mp(all_elim(m1, {g}), go, hu))
  qed
  show by defs(taut(trans(u2, u1), trans(s2, s1), trans(a2, a1), g), mallocng_specs.groups_kept)
qed

// errno's pages as at the entry
abbrev mp.am_epg(s, V) := all i. i in omega -> int_lt(i, 4) ->
  V.pages[int_div(int_add(int_add(s.fs_base, 52), i), x86_64_linux.PAGE)] = s.vm.pages[int_div(int_add(int_add(s.fs_base, 52), i), x86_64_linux.PAGE)]

abbrev mp.am_st(c, A, B, s, V, A1) := ((V in x86_64_linux.Vm && A1 in mallocng.Abs && A1 in univ(1)) && mallocng.holds_in(c, A1, V, B)) &&
  mallocng_specs.groups_kept(A, A1) && A1.taken = A.taken && mallocng.untouched(c, A, B, s.vm, V, mp.errno(s.fs_base)) &&
  (all a. a in omega -> a in mallocng.footprint(c, A1, B) -> a in mallocng.footprint(c, A, B) || !x86_64_linux.mapped(s.vm, int_div(a, x86_64_linux.PAGE))) &&
  mp.am_epg(s, V)

// (the entry's state)
theorem mp.am_st0(c, A, B, s): s.vm in x86_64_linux.Vm -> A in mallocng.Abs -> A in univ(1) -> mallocng.holds_in(c, A, s.vm, B) -> mp.am_st(c, A, B, s, s.vm, A)
proof
  assume hv ha hu hh
  have fg: all a. a in omega -> a in mallocng.footprint(c, A, B) -> a in mallocng.footprint(c, A, B) || !x86_64_linux.mapped(s.vm, int_div(a, x86_64_linux.PAGE)) proof
    fix a
    assume _ h
    show by taut(h)
  qed
  have ep: mp.am_epg(s, s.vm) proof
    fix i
    assume _ _
    show := refl({s.vm.pages[int_div(int_add(int_add(s.fs_base, 52), i), x86_64_linux.PAGE)]})
  qed
  show by taut(hv, ha, hu, hh, mp.gk_refl[A := A], refl({A.taken}), mp.unt_refl[c := c, A := A, b := B, vm := s.vm, e := mp.errno(s.fs_base)], fg, ep)
qed

// (a step from A1 on V to A2 on V2: the invariant, the groups and the
// taken metas as before, memory untouched outside A1's footprint but
// errno, the footprint A1's or unmapped before, errno's pages as before)
theorem mp.am_st_step(c, A, B, s, V, A1, V2, A2): mp.am_st(c, A, B, s, V, A1) ->
  (V2 in x86_64_linux.Vm && A2 in mallocng.Abs && A2 in univ(1)) -> mallocng.holds_in(c, A2, V2, B) ->
  mallocng_specs.groups_kept(A1, A2) -> A2.taken = A1.taken -> mallocng.untouched(c, A1, B, V, V2, mp.errno(s.fs_base)) ->
  (all a. a in omega -> a in mallocng.footprint(c, A2, B) -> a in mallocng.footprint(c, A1, B) || !x86_64_linux.mapped(V, int_div(a, x86_64_linux.PAGE))) ->
  (all a. a in omega -> a in mallocng.footprint(c, A2, B) -> !(a in mp.errno(s.fs_base))) ->
  mp.am_epg(s, V2) || (all i. i in omega -> int_lt(i, 4) ->
    V2.pages[int_div(int_add(int_add(s.fs_base, 52), i), x86_64_linux.PAGE)] = V.pages[int_div(int_add(int_add(s.fs_base, 52), i), x86_64_linux.PAGE)]) ->
  mp.am_st(c, A, B, s, V2, A2)
proof
  assume S ht hh hg hk hun hfp hne hep
  have _ _ _ _ sg sk su sf se := S
  have un := apply(mp.unt_grow[c := c, A := A, A1 := A1, b := B, V0 := s.vm, V1 := V, V2 := V2, e := mp.errno(s.fs_base)], su, hun, sf)
  have fg := apply(mp.fp_grow[c := c, A := A, A1 := A1, A2 := A2, b := B, V0 := s.vm, V1 := V, e := mp.errno(s.fs_base)], su, sf, hfp, hne)
  have ep: mp.am_epg(s, V2) proof
    have e2: (all i. i in omega -> int_lt(i, 4) ->
        V2.pages[int_div(int_add(int_add(s.fs_base, 52), i), x86_64_linux.PAGE)] = V.pages[int_div(int_add(int_add(s.fs_base, 52), i), x86_64_linux.PAGE)]) -> mp.am_epg(s, V2) proof
      assume he
      fix i
      assume hi hil
      show := trans(mp(all_elim(he, {i}), hi, hil), mp(all_elim(se, {i}), hi, hil))
    qed
    show by taut(hep, e2)
  qed
  show by taut(ht, hh, apply(mp.gk_trans, sg, hg), trans(hk, sk), un, fg, ep)
qed

// (a callee g refining F)
abbrev mp.calls(g, F) := all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(g[regs], s, o) -> runs(F[regs], s, o)

// alloc_meta's purpose (`alloc_meta_spec`): a meta taken (the state's
// taken metas grown by it) and ready, or 0; the groups as before, the
// invariant kept, nothing outside the allocator touched but errno, the
// footprint grown only by memory unmapped before -- or an overflow
abbrev mp.am_out(c, A, b, s, o) := (ex v. v in x86_64_linux.Vm && o = exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex A2 V2 m. ((A2 in mallocng.Abs && A2 in univ(1)) && mallocng_specs.groups_kept(A, A2)) && m in bits(64) &&
     ((m = 0 && A2.taken = A.taken) || (!(m = 0) && A2.taken = seq_concat(A.taken, seq_one(m)))) &&
     V2 in x86_64_linux.Vm && mallocng.holds_in(c, A2, V2, b) &&
     mallocng.untouched(c, A, b, s.vm, V2, mp.errno(s.fs_base)) &&
     (all a. a in omega -> a in mallocng.footprint(c, A2, b) -> a in mallocng.footprint(c, A, b) || !x86_64_linux.mapped(s.vm, int_div(a, x86_64_linux.PAGE))) &&
     (!(m = 0) -> mallocng_specs.meta_ready(V2, m)) &&
     o = ok(fn_update(s, "vm", V2), m))

// (open: its proof in progress)
lemma mp.am_run(c, grs, gdh, gsy, gmm, gmp, gel, s, h, o): c in mallocng.Cfg -> c.ctx = c_src_malloc_mallocng_malloc.__malloc_context ->
  mp.calls(grs, mallocng_specs.random_secret_spec_fun(c.libc)) -> mp.calls(gdh, mallocng_specs.dequeue_head_spec_fun()) -> mp.calls(gsy, mallocng_specs.syscall1_spec_fun()) ->
  mp.calls(gmm, mallocng_specs.mmap_spec_fun()) -> mp.calls(gmp, mallocng_specs.mprotect_spec_fun()) -> mp.calls(gel, mallocng_specs.errno_location_spec_fun) ->
  s in abi.World -> h in mp.G ->
  mallocng.holds_in(c, h.A, s.vm, h.blocks) -> abi.thread_ok(s.vm, s.fs_base) -> mallocng_specs.tls_apart(c, h.A, h.blocks, s.fs_base) -> abi.brk_start_ok(s.vm) ->
  mallocng_specs.errno_ok(s.vm, s.objs, s.fs_base) -> mallocng_specs.errno_apart(c, h.A, h.blocks, s.fs_base) ->
  runs(c_src_malloc_mallocng_malloc.__malloc_alloc_meta(grs, gdh, gsy, gmm, gmp, gel), s, o) ->
  mp.am_out(c, h.A, h.blocks, s, o)
