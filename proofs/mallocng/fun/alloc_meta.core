    have ea: mallocng_specs.errno_at(s.fs_base) = int_add(s.fs_base, 52) by defs(arith(fsb, hfl), mallocng_specs.errno_at, bits_add, pow2)
    have eab: int_add(s.fs_base, 52) in bits(64) by arith(fsb, hfl)
    let EA := mallocng_specs.errno_at(s.fs_base)
    have kp := mp(mp.w32_keep[V := V, c := EA, v := e, k := "pages"], (!("pages" = "bytes") by simp()))
    have kt := mp(mp.w32_keep[V := V, c := EA, v := e, k := "stack_top"], (!("stack_top" = "bytes") by simp()))
    have kl := mp(mp.w32_keep[V := V, c := EA, v := e, k := "stack_limit"], (!("stack_limit" = "bytes") by simp()))
    have ks := mp(mp.w32_keep[V := V, c := EA, v := e, k := "brk_start"], (!("brk_start" = "bytes") by simp()))
    have kb := mp(mp.w32_keep[V := V, c := EA, v := e, k := "brk"], (!("brk" = "bytes") by simp()))
    have kp1 := mp(mp.w32_keep[V := V1, c := EA, v := e, k := "pages"], (!("pages" = "bytes") by simp()))
    have vmp: Vm.pages = V.pages := rewrite(sym(qm), kp)
    // (outside errno: the bytes before)
    have oe: all y. y in bits(64) -> !(y in mp.errno(s.fs_base)) -> int_le(int_add(int_add(s.fs_base, 52), 4), y) || int_lt(y, int_add(s.fs_base, 52)) proof
      fix y
      assume hy hn
      have k: !(int_le(int_add(s.fs_base, 52), y) && int_lt(y, int_add(s.fs_base, 56))) proof
        assume w
        have w1 w2 := w
        show by taut(hn, (y in mp.errno(s.fs_base) by simp(w1, w2, (y in omega by arith(hy)))))
      qed
      show by arith(k, hy)
