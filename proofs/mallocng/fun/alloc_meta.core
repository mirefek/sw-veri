  have vfp: VF.pages = Vm.pages by simp()
  have vfk: VF.brk = nw by simp(gmk, hvb)
  have vfbb: VF.bytes in fn_space(bits(64), bits(8)) by simp(expand(vfV, x86_64_linux.Vm))
  have vrp: VF.pages[RP] = some(HP) by simp(vfp, gmr, vr)
