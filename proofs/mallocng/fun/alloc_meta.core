  let HP := fn_update(fn_update(empty, "prot", fn_update(fn_update(fn_update(empty, "r", true), "w", true), "x", false)), "kind", 1)
  let VB1 := fn_update(Vm, "bytes", x86_64_linux.store_le(Vm.bytes, int_add(c.ctx, 920), 8, nw))
  let VB2 := fn_update(Vm, "bytes", x86_64_linux.store_le(x86_64_linux.store_le(Vm.bytes, int_add(c.ctx, 920), 8, nw), int_add(c.ctx, 72), 8, bits_sub(64, nw, 4096)))
  have vb1V := mp(all_elim(ms.wr_any, {Vm}, {int_add(c.ctx, 920)}, {8}, {nw}), hmv)
  have vb2V: VB2 in x86_64_linux.Vm by simp(mp(all_elim(ms.wr_any, {VB1}, {int_add(c.ctx, 72)}, {8}, {bits_sub(64, nw, 4096)}), vb1V))
  have vfV: VF in x86_64_linux.Vm by simp(mp(all_elim(ms.wr_any, {VB2}, {int_add(c.ctx, 40)}, {8}, {bits_shr(64, 4096, 12)}), vb2V))
  have cm: all y. y in omega -> int_le(c.ctx, y) -> int_lt(y, int_add(c.ctx, 928)) -> !mallocng.ctx_free(c, y) -> x86_64_linux.mapped(V1, int_div(y, x86_64_linux.PAGE)) proof
    fix y
    assume h1 h2 h3 h4
    show := apply(mp.ctx_mapped[c := c, A := A1, vm := V1, b := B, a := y], hc, s3, s2, s4, h1, h2, (int_lt(y, int_add(c.ctx, mallocng.CTX_SIZE)) by arith(h3)), h4)
  qed
  have nfw: all y. y in omega -> (int_le(int_add(c.ctx, 920), y) && int_lt(y, int_add(c.ctx, 928))) || (int_le(int_add(c.ctx, 40), y) && int_lt(y, int_add(c.ctx, 80))) ->
