    show by defs(taut(a1, a2, a3, a4, a5, gt1, gl1, gs1, qb, (Ve in x86_64_linux.Vm by simp(q2, s1)), subst({y. fn_update(y, "bytes", V1.bytes) = V1}, sym(q2), v1rest),
      (Ve.pages = V1.pages by simp(q2))), mp.gd_ok)
  qed
  // the guard page refused: errno written
  have k2: g = 1 && (ex e. Vm = mallocng_specs.wr32(V, mallocng_specs.errno_at(s.fs_base), e) && Ve = mallocng_specs.wr32(V1, mallocng_specs.errno_at(s.fs_base), e)) ->
      mp.gd_ok(c, s, V1, V, Vm, Ve, R2) proof
    assume q
    have _ qx := q
