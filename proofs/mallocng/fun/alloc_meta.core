                have UK := conj(u64r, u64w, u0r, u32w, u24w, ur0w, ur16w)
                step e25 from e20 with mp.st64w_det, g.ld64_det, rsec, ms.st32_det, g.padd_det, r24 using conj(w5bW, w5bu, kb, UK, rbb, secb, cv, hx, cnz, qpos, ro4, rlt5, rcx,
                  lno, lnl, lnc, lnb3, pb1, pb2)
                // the new area, its metas available
                have hln2: (seq_len(A4.areas) = 0 && ln = int_add(c.ctx, 56)) || (int_lt(0, seq_len(A4.areas)) && ln = int_add(L, 8)) := rewrite(sym(hx), hln)
                have fsb: s.fs_base in bits(64) by simp(expand(hw, abi.World))
                have hfl: int_le(int_add(s.fs_base, 56), int_pow(2, 64)) by arith(expand(heo, mallocng_specs.errno_ok), fsb)
                have {nst = st, nav = avail, nin = init} := apply(mp.am_na[c := c, A := A, B := B, s := s, V4 := V4, A4 := A4, V5 := V5, ln := ln], hst4, hc, hw, hbt, hea, hfl, kcb,
                  k11, k13, conj(p1, p2), p3, p4, p5, hln2)
                let VD := fn_update(V5, "bytes", mp.am_nachain(c, A4, V5.bytes, ln))
                have e26: x4 = ok(pair(fn_update(s, "vm", VD), LP), empty) := rewrite(sym(hx), e25)
                show by disj({3}, ex_intro({mp.narea(A4)}, {VD}, {LP}, conj(conj(conj(nst, nin), nav), e26)))
            qed
            show by taut(tm, tmo, tmr, tmk)
        qed
        show by taut(apply(finish, (T2 by taut(skip, big))))
      qed
      show by taut(taken, none, (int_lt(0, seq_len(F)) || seq_len(F) = 0 by arith(flo)))


qed

// alloc_meta's code by its purpose: its contract (`mp.am_run`), the ghost
// part's A the new state
theorem mp.am: all c grs gdh gsy gmm gmp gel. c in mallocng.Cfg -> c.ctx = c_src_malloc_mallocng_malloc.__malloc_context ->
  mp.calls(grs, mallocng_specs.random_secret_spec_fun(c.libc)) -> mp.calls(gdh, mallocng_specs.dequeue_head_spec_fun()) -> mp.calls(gsy, mallocng_specs.syscall1_spec_fun()) ->
  mp.calls(gmm, mallocng_specs.mmap_spec_fun()) -> mp.calls(gmp, mallocng_specs.mprotect_spec_fun()) -> mp.calls(gel, mallocng_specs.errno_location_spec_fun) ->
  refines_ghost(c_src_malloc_mallocng_malloc.__malloc_alloc_meta(grs, gdh, gsy, gmm, gmp, gel), mallocng_specs.alloc_meta_spec(c), abi.World, mp.G)
proof
  fix c grs gdh gsy gmm gmp gel
  assume hc hx hrs hdh hsy hmm hmp hel
  let P := c_src_malloc_mallocng_malloc.__malloc_alloc_meta(grs, gdh, gsy, gmm, gmp, gel)
  have rp: all s o. runs(P, s, o) -> pair(s, o) in univ(1) proof
    fix s o
    assume hr
    show := apply(g.runs_univ, expand(hr, c_src_malloc_mallocng_malloc.__malloc_alloc_meta))
  qed
  unfold mallocng_specs.alloc_meta_spec
  refine ct.refines_contract_g with mp.g_world, rp
  fix s h o
  assume hw hh hr hpre
  let S := union2(s, h)
  let A := h.A
  let B := h.blocks
  let V0 := s.vm
  have _ hd _ _ := mp(all_elim(mp.g_rec, {h}), hh)
  have sd: dom(s) = insert("vm", insert("os", insert("fs_base", insert("cpu", insert("objs", empty))))) by simp(expand(hw, abi.World))
  have aS: S.A = A by simp(sd, hd)
  have vS: S.vm = V0 by simp(sd, hd)
  have bS: S.blocks = B by simp(sd, hd)
  have fS: S.fs_base = s.fs_base by simp(sd, hd)
  have oS: S.objs = s.objs by simp(sd, hd)
  have hin: mallocng.holds_in(c, A, V0, B) by simp(hpre, sd, hd)
  have hth: abi.thread_ok(V0, s.fs_base) by simp(hpre, sd, hd)
  have htl: mallocng_specs.tls_apart(c, A, B, s.fs_base) by simp(hpre, sd, hd)
  have hbs: abi.brk_start_ok(V0) by simp(hpre, sd, hd)
  have heo: mallocng_specs.errno_ok(V0, s.objs, s.fs_base) by simp(hpre, sd, hd)
  have hea: mallocng_specs.errno_apart(c, A, B, V0, s.fs_base) by simp(hpre, sd, hd)
  have run := apply(mp.am_run[c := c, grs := grs, gdh := gdh, gsy := gsy, gmm := gmm, gmp := gmp, gel := gel, s := s, h := h, o := o],
    hc, hx, hrs, hdh, hsy, hmm, hmp, hel, hw, hh, hin, hth, htl, hbs, heo, hea, hr)
  // a return: the ghost part's A the new state
  have k: case 2 of run proof
    assume e
    obtain A2 V2 m, ha2 hu2 hgk hm htk hv2 hin2 hunt hgr hrd _ hmf ho from e
    let S1 := fn_update(fn_update(S, "A", A2), "vm", V2)
    let H2 := fn_update(h, "A", A2)
    let s1 := fn_update(s, "vm", V2)
    have hg2 := apply(mp.g_upd, {h}, {A2}, hh, ha2, hu2)
    // the world's part and the ghost part joined: the spec's state
    have sk := apply(abi.keys_of[f := s, d := insert("vm", insert("os", insert("fs_base", insert("cpu", insert("objs", empty)))))], sd)
    have na: all z. z in s -> fst(z) != "A" proof
      fix z
      assume hz
      show by simp(mp(all_elim(sk, {z}), hz))
    qed
    have _ hk := mp(all_elim(mp.g_world, {H2}), hg2)
    have nv: all z. z in H2 -> fst(z) != "vm" proof
      fix z
      assume hz
      show by simp(mp(all_elim(hk, {z}), hz))
    qed
    have e1 := mp(fn_update_union_r[a := s, b := h, k := "A", v := A2], na)
    have e2 := mp(fn_update_union_l[a := s, b := H2, k := "vm", v := V2], nv)
    have eS: union2(s1, H2) = S1 := sym(trans(subst({y. S1 = fn_update(y, "vm", V2)}, e1, refl({S1})), e2))
    show by disj({2}, ex_intro({s1}, {m}, {H2}, spec_ret({A2}, {m}, {V2}, hg2, ho, ha2, hgk, hm, htk, aS, vS, bS, fS, oS, hv2, hin2, hunt, hgr, hrd, hmf, eS)))
  qed
  show by taut(run, k)
qed

theorem mp.am_fun: all c regs grs gdh gsy gmm gmp gel. c in mallocng.Cfg -> c.ctx = c_src_malloc_mallocng_malloc.__malloc_context ->
  mp.calls(grs, mallocng_specs.random_secret_spec_fun(c.libc)) -> mp.calls(gdh, mallocng_specs.dequeue_head_spec_fun()) -> mp.calls(gsy, mallocng_specs.syscall1_spec_fun()) ->
  mp.calls(gmm, mallocng_specs.mmap_spec_fun()) -> mp.calls(gmp, mallocng_specs.mprotect_spec_fun()) -> mp.calls(gel, mallocng_specs.errno_location_spec_fun) ->
  regs in abi.ARGS ->
  refines_ghost(c_src_malloc_mallocng_malloc.__malloc_alloc_meta_fun(grs, gdh, gsy, gmm, gmp, gel)[regs], mallocng_specs.alloc_meta_spec_fun(c)[regs], abi.World, mp.G)
proof
  fix c regs grs gdh gsy gmm gmp gel
  assume hc hx hrs hdh hsy hmm hmp hel hr
  have hm := mp(all_elim(mp.am, {c}, {grs}, {gdh}, {gsy}, {gmm}, {gmp}, {gel}), hc, hx, hrs, hdh, hsy, hmm, hmp, hel)
  have w := mp(g.fun_res_ghost0[p := c_src_malloc_mallocng_malloc.__malloc_alloc_meta(grs, gdh, gsy, gmm, gmp, gel), q := mallocng_specs.alloc_meta_spec(c), w := 64, G := mp.G],
    mp.g_univ, hm)
  show by defs(mp(all_elim(w, {regs}), hr), c_src_malloc_mallocng_malloc.__malloc_alloc_meta_fun, mallocng_specs.alloc_meta_spec_fun)
qed

// (the purpose spec diverges nowhere it does not also raise)
theorem mp.am_divg: all c. tr.div_raises_g(mp.G, mallocng_specs.alloc_meta_spec_fun(c))
proof
  fix c
  show by divergence(mp.g_univ, mp.gS)
qed

// alloc_meta's machine code (linked with dequeue_head's and dequeue's)
// implements its purpose, given its other callees -- leaves not yet at
// machine level (get_random_secret, __syscall1, __mmap, __mprotect,
// __errno_location) -- each implemented at its address and meeting its spec
theorem mp.am_implements: all c statics G1 G3 G4 G5 G6. c in mallocng.Cfg -> c.ctx = c_src_malloc_mallocng_malloc.__malloc_context ->
  tr.implements_at(4205853, G1, 4198400, text.code, statics) -> G1 in fn_space(abi.ARGS, powerset(univ(1))) -> tr.callee_io(G1, 0) ->
  mp.calls(G1, mallocng_specs.random_secret_spec_fun(c.libc)) ->
  tr.implements_at(4205817, G3, 4198400, text.code, statics) -> G3 in fn_space(abi.ARGS, powerset(univ(1))) -> tr.callee_io(G3, 2) ->
  mp.calls(G3, mallocng_specs.syscall1_spec_fun()) ->
  tr.implements_at(4213468, G4, 4198400, text.code, statics) -> G4 in fn_space(abi.ARGS, powerset(univ(1))) -> tr.callee_io(G4, 6) ->
  mp.calls(G4, mallocng_specs.mmap_spec_fun()) ->
  tr.implements_at(4213779, G5, 4198400, text.code, statics) -> G5 in fn_space(abi.ARGS, powerset(univ(1))) -> tr.callee_io(G5, 3) ->
  mp.calls(G5, mallocng_specs.mprotect_spec_fun()) ->
  tr.implements_at(4216494, G6, 4198400, text.code, statics) -> G6 in fn_space(abi.ARGS, powerset(univ(1))) -> tr.callee_io(G6, 0) ->
  mp.calls(G6, mallocng_specs.errno_location_spec_fun) ->
  abi.implements2_at(mp.G, 4208782, mallocng_specs.alloc_meta_spec_fun(c), 4198400, text.code, statics)
proof
  fix c statics G1 G3 G4 G5 G6
  assume hc hx i1 t1 o1 q1 i3 t3 o3 q3 i4 t4 o4 q4 i5 t5 o5 q5 i6 t6 o6 q6
  let DQ := c_src_malloc_mallocng_malloc_cfg.dequeue_fun
  let DH := c_src_malloc_mallocng_malloc_cfg.dequeue_head_fun(DQ)
  let LOW := c_src_malloc_mallocng_malloc.__malloc_alloc_meta_fun(G1, DH, G3, G4, G5, G6)
  // dequeue_head: its CFG form over dequeue's, by its purpose
  have hdq: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(DQ[regs], s, o) ->
      runs(mallocng_specs.dequeue_spec_fun()[regs], s, o) proof
    fix regs s o
    assume h1 hl hs hr
    show := mp(all_elim(mp.dq_fun, {regs}, {s}, {o}), h1, hl, hs, mp(all_elim(dequeue_ref, {regs}, {s}, {o}), h1, hl, hs, hr))
  qed
  have c2 := mp(all_elim(mp.dqh_fun, {DQ}), hdq)
  have qdh: mp.calls(DH, mallocng_specs.dequeue_head_spec_fun()) proof
    fix regs s o
    assume h1 hl hs hr
    show := mp(all_elim(c2, {regs}, {s}, {o}), h1, hl, hs, mp(all_elim(dequeue_head_ref, {DQ}, {regs}, {s}, {o}), h1, hl, hs, hr))
  qed
  have tdh: DH in fn_space(abi.ARGS, powerset(univ(1))) by defs(tr.fun_typed, c_src_malloc_mallocng_malloc_cfg.dequeue_head_fun)
  have odh := mp(all_elim(dqhtc.io, {DQ}), dqtc.io)
  have hdr := all_elim(mp.am_divg, {c})
  have r: all args. args in abi.ARGS -> refines_ghost(LOW[args], mallocng_specs.alloc_meta_spec_fun(c)[args], abi.World, mp.G) proof
    fix args
    assume ha
    show := mp(all_elim(mp.am_fun, {c}, {args}, {G1}, {DH}, {G3}, {G4}, {G5}, {G6}), hc, hx, q1, qdh, q3, q4, q5, q6, ha)
  qed
  // the machine code: alloc_meta's CFG form linked, refining the structured one
  have ln := mp(all_elim(amtc.implements, {statics}, {G1}, {DH}, {G3}, {G4}, {G5}, {G6}), i1, t1, o1, all_elim(dqhtc.linked, {statics}), tdh, odh, i3, t3, o3,
    i4, t4, o4, i5, t5, o5, i6, t6, o6)
  have rf := all_elim(__malloc_alloc_meta_ref, {G1}, {DH}, {G3}, {G4}, {G5}, {G6})
  have st := mp(all_elim(tr.implements_refine, {4208782}, {c_src_malloc_mallocng_malloc_cfg.__malloc_alloc_meta_fun(G1, DH, G3, G4, G5, G6)}, {LOW},
    {4198400}, {text.code}, {statics}), ln, rf)
  show := mp(all_elim(tr.implements_abi_g, {mp.G}, {4208782}, {LOW}, {mallocng_specs.alloc_meta_spec_fun(c)}, {4198400}, {text.code}, {statics}),
    mp.g_ok, hdr, st, r)
qed

// what a caller relies on of a callee f called as alloc_meta (its C
// function value), the ghost part h read: an overflow, or the return -- its
// state A2 on the memory V2, the meta m (0 for none) in the result register
// (`mp.am_post`: alloc_meta_spec's)
abbrev mp.am_call(c, f) := all t h regs o2. t in abi.World -> h in mp.G ->
  mallocng.holds_in(c, h.A, t.vm, h.blocks) -> abi.thread_ok(t.vm, t.fs_base) -> mallocng_specs.tls_apart(c, h.A, h.blocks, t.fs_base) -> abi.brk_start_ok(t.vm) ->
  mallocng_specs.errno_ok(t.vm, t.objs, t.fs_base) -> mallocng_specs.errno_apart(c, h.A, h.blocks, t.vm, t.fs_base) ->
  gc.regs_ok(regs, empty) ->
  runs(f[regs], t, o2) ->
  (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex V2 rr. (V2 in x86_64_linux.Vm && (ex A2 m. mp.am_post(c, h.A, h.blocks, t, A2, V2, m) && fst(rr) = m)) && o2 = ok(fn_update(t, "vm", V2), rr))

// (a callee refining one called as alloc_meta: called as it too)
theorem mp.am_call_ref(c, f, f2): mp.calls(f, f2) -> mp.am_call(c, f2) -> mp.am_call(c, f)
proof
  assume hf q
  fix t h regs o2
  assume hw hh hin hth htl hbs heo hea hro hr
  have rl rn := apply(gc.regs0, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have r2 := mp(all_elim(hf, {regs}, {t}, {o2}), rl, (int_le(seq_len(regs), 6) by arith(rn, lo)), hw, hr)
  show := mp(all_elim(q, {t}, {h}, {regs}, {o2}), hw, hh, hin, hth, htl, hbs, heo, hea, hro, r2)
qed

// alloc_meta's code called as alloc_meta
theorem mp.am_q: all c grs gdh gsy gmm gmp gel. c in mallocng.Cfg -> c.ctx = c_src_malloc_mallocng_malloc.__malloc_context ->
  mp.calls(grs, mallocng_specs.random_secret_spec_fun(c.libc)) -> mp.calls(gdh, mallocng_specs.dequeue_head_spec_fun()) -> mp.calls(gsy, mallocng_specs.syscall1_spec_fun()) ->
  mp.calls(gmm, mallocng_specs.mmap_spec_fun()) -> mp.calls(gmp, mallocng_specs.mprotect_spec_fun()) -> mp.calls(gel, mallocng_specs.errno_location_spec_fun) ->
  mp.am_call(c, c_src_malloc_mallocng_malloc.__malloc_alloc_meta_fun(grs, gdh, gsy, gmm, gmp, gel))
proof
  fix c grs gdh gsy gmm gmp gel
  assume hc hx hrs hdh hsy hmm hmp hel
  fix t h regs o2
  assume hw hh hin hth htl hbs heo hea hro hr
  step o3 A2 V2 m, e hs1 from hr with mp.am_run using hro, hc, hx, hrs, hdh, hsy, hmm, hmp, hel, hw, hh, hin, hth, htl, hbs, heo, hea
  have ha2 hu2 hgk hm htk hv2 hin2 hunt hgr hrd hep hmf := hs1
  step o4 y, e2 from e with g.result64_inv using hm
  have post: mp.am_post(c, h.A, h.blocks, t, A2, V2, m) by taut(ha2, hu2, hgk, hm, htk, hv2, hin2, hunt, hgr, hrd, hep, hmf)
  have inner: ex A3 m3. mp.am_post(c, h.A, h.blocks, t, A3, V2, m3) && fst(pair(m, y)) = m3 by ex_intro({A2}, {m}, taut(post, (fst(pair(m, y)) = m by simp())))
  show by disj({2}, ex_intro({V2}, {pair(m, y)}, taut(hv2, inner, e2)))
qed
