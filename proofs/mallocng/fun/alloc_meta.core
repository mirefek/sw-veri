  have npg: all a. a in omega -> int_le(R2, a) -> int_lt(a, int_add(R2, int_mul(4096, 1))) ->
      (mallocng.m_mapped(mallocng.mview(VF, mallocng.all_bytes()), a) && !(snd(mallocng.pg(mallocng.mview(VF, mallocng.all_bytes()), a)).kind = 2)) &&
