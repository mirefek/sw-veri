// alloc_meta by its purpose: a meta for a new group -- the free metas'
// head, or the last area's next one (the allocator initialized first, an
// area added from the reserve if none is left, the reserve refilled from
// brk or mmap if it is empty) -- or 0, none to be had.

// ----------------------------------------------------------------------
//  The memory calls' memories exist: pages fresh, gone, reprotected (so
//  their specs' havocs have a choice, the calls their returns)

// (a protection, a page, typed)
theorem mp.prot_typed(r, w, x): r in bool -> w in bool -> x in bool ->
  fn_update(fn_update(fn_update(empty, "r", r), "w", w), "x", x) in x86_64_linux.Prot
proof
  assume hr hw hx
  let P := fn_update(fn_update(fn_update(empty, "r", r), "w", w), "x", x)
  let K := insert("r", insert("w", insert("x", empty)))
  have bu: bool in univ(1) by defs(simp(), bool)
  have ru := mp(mp(univ_trans[u := 1, a := r, b := bool], bu), hr)
  have wu := mp(mp(univ_trans[u := 1, a := w, b := bool], bu), hw)
  have xu := mp(mp(univ_trans[u := 1, a := x, b := bool], bu), hx)
  have pu: P in univ(1) by simp(ru, wu, xu)
  have f1 := mp(fn_update_fun[f := empty, k := "r", v := r], dom_empty.1)
  have f2 := mp(fn_update_fun[f := fn_update(empty, "r", r), k := "w", v := w], f1)
  have pf: is_fun(P) := mp(fn_update_fun[f := fn_update(fn_update(empty, "r", r), "w", w), k := "x", v := x], f2)
  have d1 := mp(dom_update[f := empty, k := "r", v := r], dom_empty.1)
  have d2 := mp(dom_update[f := fn_update(empty, "r", r), k := "w", v := w], f1)
  have d3 := mp(dom_update[f := fn_update(fn_update(empty, "r", r), "w", w), k := "x", v := x], f2)
  have ds: all z. z in insert("x", insert("w", insert("r", empty))) <-> z in K proof
    fix z
    have l: z in insert("x", insert("w", insert("r", empty))) -> z in K proof
      assume h
      show by simp(h)
    qed
    have q: z in K -> z in insert("x", insert("w", insert("r", empty))) proof
      assume h
      show by simp(h)
    qed
    show by taut(l, q)
  qed
  have deq := mp(set_ext[a := insert("x", insert("w", insert("r", empty))), b := K], ds)
  have pd: dom(P) = K by simp(d3, d2, d1, dom_empty.2, deq)
  have pp: ((is_fun(P) && dom(P) = K) && P.r in bool) && P.w in bool && P.x in bool by simp(hr, hw, hx, pf, pd)
  show by defs(apply(rec_type_intro[u := 1, k := K, p := x0. (((is_fun(x0) && dom(x0) = K) && x0.r in bool) && x0.w in bool) && x0.x in bool, r := P], pu, pf, pd, pp),
    x86_64_linux.Prot)
qed

theorem mp.page_typed(p, k): p in x86_64_linux.Prot -> k in x86_64_linux.Kind -> fn_update(fn_update(empty, "prot", p), "kind", k) in x86_64_linux.Page
proof
  assume hp hk
  let Q := fn_update(fn_update(empty, "prot", p), "kind", k)
  let K := insert("prot", insert("kind", empty))
  let KP := insert("r", insert("w", insert("x", empty)))
  have pp pf pd := (p in powerset(cart(KP, univ(1))) && is_fun(p) && dom(p) = KP by simp(expand(hp, x86_64_linux.Prot)))
  have pu := mp(rec_univ[u := 1, k := KP, r := p], simp(x86.insert_univ), pp, pf, pd)
  have ko: k in omega by simp(expand(hk, x86_64_linux.Kind))
  have ku := mp(mp(univ_trans[u := 1, a := k, b := omega], omega_univ), ko)
  have qu: Q in univ(1) by simp(pu, ku)
  have f1 := mp(fn_update_fun[f := empty, k := "prot", v := p], dom_empty.1)
  have qf: is_fun(Q) := mp(fn_update_fun[f := fn_update(empty, "prot", p), k := "kind", v := k], f1)
  have d1 := mp(dom_update[f := empty, k := "prot", v := p], dom_empty.1)
  have d2 := mp(dom_update[f := fn_update(empty, "prot", p), k := "kind", v := k], f1)
  have ds: all z. z in insert("kind", insert("prot", empty)) <-> z in K proof
    fix z
    have l: z in insert("kind", insert("prot", empty)) -> z in K proof
      assume h
      show by simp(h)
    qed
    have q: z in K -> z in insert("kind", insert("prot", empty)) proof
      assume h
      show by simp(h)
    qed
    show by taut(l, q)
  qed
  have deq := mp(set_ext[a := insert("kind", insert("prot", empty)), b := K], ds)
  have qd: dom(Q) = K by simp(d2, d1, dom_empty.2, deq)
  have qq: ((is_fun(Q) && dom(Q) = K) && Q.prot in x86_64_linux.Prot) && Q.kind in x86_64_linux.Kind by simp(hp, hk, qf, qd, keep(x86_64_linux.Prot, x86_64_linux.Kind))
  show by defs(apply(rec_type_intro[u := 1, k := K, p := x0. ((is_fun(x0) && dom(x0) = K) && x0.prot in x86_64_linux.Prot) && x0.kind in x86_64_linux.Kind, r := Q], qu, qf, qd, qq),
    x86_64_linux.Page)
qed

// (an option of a page)
theorem mp.some_page(p): p in x86_64_linux.Page -> some(p) in option(x86_64_linux.Page)
proof
  assume hp
  have si: some(p) in set_image(x86_64_linux.Page, y. some(y))
    by taut(set_image_def[s := x86_64_linux.Page, f := y. some(y), y := some(p)], (ex x. x in x86_64_linux.Page && some(x) = some(p) by ex_intro({p}, taut(hp, refl({some(p)})))))
  show by defs(taut(union2_iff[a := single(none), b := set_image(x86_64_linux.Page, y. some(y)), z := some(p)], si), option)
qed

// (a memory with its pages, bytes and break replaced)
theorem mp.vm_set(vm, pg, b, br): vm in x86_64_linux.Vm -> vm in univ(1) ->
  pg in fn_space(set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))), option(x86_64_linux.Page)) ->
  b in fn_space(bits(64), bits(8)) -> br in bits(64) ->
  fn_update(fn_update(fn_update(vm, "pages", pg), "bytes", b), "brk", br) in x86_64_linux.Vm
proof
  assume h hu hp hb hbr
  let K6 := insert("pages", insert("bytes", insert("stack_top", insert("stack_limit", insert("brk_start", insert("brk", empty))))))
  let V1 := fn_update(vm, "pages", pg)
  let V2 := fn_update(V1, "bytes", b)
  let V := fn_update(V2, "brk", br)
  have ht: is_fun(vm) && dom(vm) = K6 by simp(expand(h, x86_64_linux.Vm))
  have hf: is_fun(vm) by taut(ht)
  have dv: dom(vm) = K6 by taut(ht)
  have pgu := apply(x86.fn_space_univ, x86.pn_univ, x86.opt_page_univ)
  have pu := mp(mp(univ_trans[u := 1, a := pg, b := fn_space(set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))), option(x86_64_linux.Page))], pgu), hp)
  have bsu := apply(x86.fn_space_univ, bits_univ[n := 64], bits_univ[n := 8])
  have bu := mp(mp(univ_trans[u := 1, a := b, b := fn_space(bits(64), bits(8))], bsu), hb)
  have bru := mp(mp(univ_trans[u := 1, a := br, b := bits(64)], bits_univ[n := 64]), hbr)
  have nu: V in univ(1) by simp(hu, pu, bu, bru)
  have f1 := mp(fn_update_fun[f := vm, k := "pages", v := pg], hf)
  have e1 := mp(mp(fn_update_dom[f := vm, k := "pages", v := pg], hf), (("pages" in dom(vm)) by simp(dv)))
  have f2 := mp(fn_update_fun[f := V1, k := "bytes", v := b], f1)
  have e2 := mp(mp(fn_update_dom[f := V1, k := "bytes", v := b], f1), (("bytes" in dom(V1)) by simp(e1, dv)))
  have f3 := mp(fn_update_fun[f := V2, k := "brk", v := br], f2)
  have e3 := mp(mp(fn_update_dom[f := V2, k := "brk", v := br], f2), (("brk" in dom(V2)) by simp(e2, e1, dv)))
  have d3: dom(V) = K6 by simp(e3, e2, e1, dv)
  have pv: ((((((is_fun(V) && dom(V) = K6) && V.pages in fn_space(set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))), option(x86_64_linux.Page))) &&
      V.bytes in fn_space(bits(64), bits(8))) && V.stack_top in bits(64)) && V.stack_limit in omega) && V.brk_start in bits(64)) && V.brk in bits(64)
    by simp(expand(h, x86_64_linux.Vm), hp, hb, hbr, f3, d3)
  have r := apply(rec_type_intro[u := 1, k := K6, p := x0. ((((((is_fun(x0) && dom(x0) = K6) &&
      x0.pages in fn_space(set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))), option(x86_64_linux.Page))) &&
      x0.bytes in fn_space(bits(64), bits(8))) && x0.stack_top in bits(64)) && x0.stack_limit in omega) && x0.brk_start in bits(64)) && x0.brk in bits(64), r := V], nu, f3, d3, pv)
  show by defs(r, x86_64_linux.Vm)
qed

// pages p .. p+n-1 fresh pages pg (their bytes 0), the break br: such a
// memory exists
theorem mp.fresh_ex(before, p, n, pg, br): before in x86_64_linux.Vm -> before in univ(1) -> p in omega -> n in omega -> pg in x86_64_linux.Page -> br in bits(64) ->
  ex V. (V in x86_64_linux.Vm && mallocng_specs.fresh_pages(before, V, p, n, pg)) && V.brk = br
proof
  assume hv hu hp hn hpg hbr
  let PN := set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)))
  let PGS := fn_build(PN, q. ite(int_le(p, q) && int_lt(q, int_add(p, n)), some(pg), before.pages[q]))
  let BS := fn_build(bits(64), a. ite(int_le(int_mul(p, x86_64_linux.PAGE), a) && int_lt(a, int_mul(int_add(p, n), x86_64_linux.PAGE)), bits_of_int(8, 0), before.bytes[a]))
  let V := fn_update(fn_update(fn_update(before, "pages", PGS), "bytes", BS), "brk", br)
  have sp := apply(mp.some_page, hpg)
  have pgv: all q. q in PN -> ite(int_le(p, q) && int_lt(q, int_add(p, n)), some(pg), before.pages[q]) in option(x86_64_linux.Page) proof
    fix q
    assume hq
    have pq := apply(x86.vm_page_at, hv, hq)
    show by simp(sp, pq)
  qed
  have pgs := apply(fn_build_space[d := PN, v := q. ite(int_le(p, q) && int_lt(q, int_add(p, n)), some(pg), before.pages[q]), b := option(x86_64_linux.Page)], pgv)
  have bt: before.bytes in fn_space(bits(64), bits(8)) by simp(expand(hv, x86_64_linux.Vm))
  have bsv: all a. a in bits(64) -> ite(int_le(int_mul(p, x86_64_linux.PAGE), a) && int_lt(a, int_mul(int_add(p, n), x86_64_linux.PAGE)), bits_of_int(8, 0), before.bytes[a]) in bits(8) proof
    fix a
    assume ha
    have ba := mp(fn_space_app[a := bits(64), b := bits(8), f := before.bytes, x := a], bt, ha)
    show by simp(ba)
  qed
  have bss := apply(fn_build_space[d := bits(64), v := a. ite(int_le(int_mul(p, x86_64_linux.PAGE), a) && int_lt(a, int_mul(int_add(p, n), x86_64_linux.PAGE)), bits_of_int(8, 0), before.bytes[a]), b := bits(8)], bsv)
  have vt := apply(mp.vm_set, hv, hu, pgs, bss, hbr)
  have pq: all q. q in omega -> int_lt(q, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) -> V.pages[q] = ite(int_le(p, q) && int_lt(q, int_add(p, n)), some(pg), before.pages[q]) proof
    fix q
    assume h1 h2
    have qp: q in PN by simp(h1, h2)
    show by simp(app_fn_build[d := PN, v := q. ite(int_le(p, q) && int_lt(q, int_add(p, n)), some(pg), before.pages[q]), a := q], qp)
  qed
  have bq: all a. a in bits(64) -> V.bytes[a] = ite(int_le(int_mul(p, x86_64_linux.PAGE), a) && int_lt(a, int_mul(int_add(p, n), x86_64_linux.PAGE)), bits_of_int(8, 0), before.bytes[a]) proof
    fix a
    assume ha
    show by simp(app_fn_build[d := bits(64), v := a. ite(int_le(int_mul(p, x86_64_linux.PAGE), a) && int_lt(a, int_mul(int_add(p, n), x86_64_linux.PAGE)), bits_of_int(8, 0), before.bytes[a]), a := a], ha)
  qed
  have fp: mallocng_specs.fresh_pages(before, V, p, n, pg) by defs(simp(pq, bq), mallocng_specs.fresh_pages)
  show by ex_intro({V}, taut(vt, fp, (V.brk = br by simp())))
qed

// pages p .. p+n-1 gone, the break br: such a memory exists
theorem mp.gone_ex(before, p, n, br): before in x86_64_linux.Vm -> before in univ(1) -> br in bits(64) ->
  ex V. (V in x86_64_linux.Vm && mallocng_specs.gone_pages(before, V, p, n)) && V.brk = br
proof
  assume hv hu hbr
  let PN := set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)))
  let PGS := fn_build(PN, q. ite(int_le(p, q) && int_lt(q, int_add(p, n)), none, before.pages[q]))
  let V := fn_update(fn_update(fn_update(before, "pages", PGS), "bytes", before.bytes), "brk", br)
  have no: none in option(x86_64_linux.Page) by defs(taut(union2_iff[a := single(none), b := set_image(x86_64_linux.Page, y. some(y)), z := none], single_intro[a := none]), option)
  have pgv: all q. q in PN -> ite(int_le(p, q) && int_lt(q, int_add(p, n)), none, before.pages[q]) in option(x86_64_linux.Page) proof
    fix q
    assume hq
    have pq := apply(x86.vm_page_at, hv, hq)
    show by simp(no, pq)
  qed
  have pgs := apply(fn_build_space[d := PN, v := q. ite(int_le(p, q) && int_lt(q, int_add(p, n)), none, before.pages[q]), b := option(x86_64_linux.Page)], pgv)
  have bt: before.bytes in fn_space(bits(64), bits(8)) by simp(expand(hv, x86_64_linux.Vm))
  have vt := apply(mp.vm_set, hv, hu, pgs, bt, hbr)
  have pq: all q. q in omega -> int_lt(q, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) -> V.pages[q] = ite(int_le(p, q) && int_lt(q, int_add(p, n)), none, before.pages[q]) proof
    fix q
    assume h1 h2
    have qp: q in PN by simp(h1, h2)
    show by simp(app_fn_build[d := PN, v := q. ite(int_le(p, q) && int_lt(q, int_add(p, n)), none, before.pages[q]), a := q], qp)
  qed
  have gp: mallocng_specs.gone_pages(before, V, p, n) by defs(simp(pq), mallocng_specs.gone_pages)
  show by ex_intro({V}, taut(vt, gp, (V.brk = br by simp())))
qed

// (the heap's pages: readable, writable)
theorem mp.heap_page: fn_update(fn_update(empty, "prot", fn_update(fn_update(fn_update(empty, "r", true), "w", true), "x", false)), "kind", 1) in x86_64_linux.Page
proof
  have pr := apply(mp.prot_typed, (true in bool by simp()), (true in bool by simp()), (false in bool by simp()))
  show := apply(mp.page_typed, pr, (1 in x86_64_linux.Kind by defs(simp(), x86_64_linux.Kind)))
qed

// ----------------------------------------------------------------------
//  The callees' contracts at a call (their C function values)

// get_random_secret's (libc's auxiliary vector readable): an overflow, or
// a secret returned -- any 64-bit value --, the memory as it was
theorem mp.rs_q: all t libc regs o2. t in abi.World -> t in univ(1) -> mallocng_specs.auxv_ok(t.vm, t.objs, libc) -> gc.regs_ok(regs, empty) ->
  runs(mallocng_specs.random_secret_spec_fun(libc)[regs], t, o2) ->
  (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex r. o2 = ok(fn_update(t, "vm", t.vm), r) && fst(r) in bits(64))
proof
  fix t libc regs o2
  assume hw htu hax hro h
  let OVF := exc_val("stack_overflow", empty)
  have rl rn := apply(gc.regs0, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, mallocng_specs.random_secret_spec_fun, app_fn_build, ra in h
  have pv pf pd pb := apply(ms.world_parts, hw)
  have ss: fn_update(t, "vm", t.vm) = t := mp(fn_update_same[f := t, k := "vm"], pf, pd)
  let G := (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), OVF)) || (ex r. o2 = ok(fn_update(t, "vm", t.vm), r) && fst(r) in bits(64))
  have b := apply(g.runs_elim, h)
  obtain o3, hs3 hk3 from expand(b, bind_rel)
  have vv: ex x. x in x86_64_linux.Vm by ex_intro({t.vm}, simp(pv))
  have ci: (ex v. v in x86_64_linux.Vm && o3 = exc(fn_update(t, "vm", v), OVF)) || (ex y. y in bits(64) && o3 = ok(t, y))
    by simp(hs3, hax, vv, keep(mallocng_specs.auxv_ok))
  have c1: (ex v. v in x86_64_linux.Vm && o3 = exc(fn_update(t, "vm", v), OVF)) -> G proof
    assume e
    obtain v, hv he from e
    have oe: o2 = exc(fn_update(t, "vm", v), OVF) by simp(rewrite(he, hk3))
    have l: ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), OVF) by ex_intro({v}, taut(hv, oe))
    show by taut(l)
  qed
  have c2: (ex y. y in bits(64) && o3 = ok(t, y)) -> G proof
    assume e
    obtain y, hy he from e
    have k1: bind_rel(gimple.result(64, y), t, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. o2 = ok(x6, pair(x8, x9)))), x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))
      by simp(expand(rewrite(he, hk3), letin), keep(bind_rel, gimple.result))
    obtain o4, hr4 hk4 from expand(k1, bind_rel)
    have ho4 := apply(g.result64_inv, hy, hr4)
    have k2: any_rel(x9. x9 in bits(64), x9. o2 = ok(t, pair(y, x9))) by simp(expand(rewrite(ho4, hk4), letin), keep(any_rel))
    have ne: ex z. z in bits(64) by ex_intro({0}, simp())
    obtain z, hz hoz from apply(g.any_e, ne, k2)
    have l: ex r. o2 = ok(fn_update(t, "vm", t.vm), r) && fst(r) in bits(64) by ex_intro({pair(y, z)}, taut(rewrite(sym(ss), hoz), (fst(pair(y, z)) in bits(64) by simp(hy))))
    show by taut(l)
  qed
  show by taut(ci, c1, c2)
qed

// brk(new) (`__syscall1(SYS_brk, new)`): an overflow, or a return -- the
// break as it was, the memory too; or the break new, its pages fresh
// readable, writable heap (they were free, off the stack's space) or the
// pages above it gone, new not below the break's start
theorem mp.brk_q: all t new regs o2. t in abi.World -> t in univ(1) -> new in bits(64) ->
  gc.regs_ok(regs, seq_concat(seq_one(gimple.arg(64, 12)), seq_one(gimple.arg(64, new)))) ->
  runs(mallocng_specs.syscall1_spec_fun()[regs], t, o2) ->
  (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex r. o2 = ok(fn_update(t, "vm", t.vm), r) && fst(r) = t.vm.brk) ||
  (ex V r. o2 = ok(fn_update(t, "vm", V), r) && fst(r) = new && V in x86_64_linux.Vm && V.brk = new && !int_lt(new, t.vm.brk_start) &&
     ((int_lt(x86_64_linux.pages_for(t.vm.brk), x86_64_linux.pages_for(new)) &&
       x86_64_linux.free_range(t.vm, x86_64_linux.pages_for(t.vm.brk), int_sub(x86_64_linux.pages_for(new), x86_64_linux.pages_for(t.vm.brk))) &&
       x86_64_linux.off_stack_space(t.vm, x86_64_linux.pages_for(t.vm.brk), int_sub(x86_64_linux.pages_for(new), x86_64_linux.pages_for(t.vm.brk))) &&
       mallocng_specs.fresh_pages(t.vm, V, x86_64_linux.pages_for(t.vm.brk), int_sub(x86_64_linux.pages_for(new), x86_64_linux.pages_for(t.vm.brk)),
         fn_update(fn_update(empty, "prot", fn_update(fn_update(fn_update(empty, "r", true), "w", true), "x", false)), "kind", 1))) ||
      (!int_lt(x86_64_linux.pages_for(t.vm.brk), x86_64_linux.pages_for(new)) &&
       mallocng_specs.gone_pages(t.vm, V, x86_64_linux.pages_for(new), int_sub(x86_64_linux.pages_for(t.vm.brk), x86_64_linux.pages_for(new))))))
proof
  fix t new regs o2
  assume hw htu hn hro h
  let OVF := exc_val("stack_overflow", empty)
  have rl rn r0 r1 := apply(gc.regs2, (12 in bits(64) by simp()), hn, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, mallocng_specs.syscall1_spec_fun, app_fn_build, ra in h
  have o12: ord_le(2, seq_len(regs)) && regs[0] = 12 by defs(simp(rn, r0), ord_le)
  have b := rewrite(r1, apply(g.runs_elim, h))
  have b2: bind_rel(mallocng_specs.brk_spec(new), t, x3 x4. letin(x4, x5. any_rel(x6. x6 in bits(64), x6. o2 = ok(x3, pair(x5, x6)))), x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3))
    by taut(b, o12)
  obtain o3, hs3 hk3 from expand(b2, bind_rel)
  have pv pf pd pb := apply(ms.world_parts, hw)
  have ss: fn_update(t, "vm", t.vm) = t := mp(fn_update_same[f := t, k := "vm"], pf, pd)
  let PO := x86_64_linux.pages_for(t.vm.brk)
  let PN := x86_64_linux.pages_for(new)
  let HP := fn_update(fn_update(empty, "prot", fn_update(fn_update(fn_update(empty, "r", true), "w", true), "x", false)), "kind", 1)
  let GROW(V) := (int_lt(PO, PN) && x86_64_linux.free_range(t.vm, PO, int_sub(PN, PO)) && x86_64_linux.off_stack_space(t.vm, PO, int_sub(PN, PO)) &&
      mallocng_specs.fresh_pages(t.vm, V, PO, int_sub(PN, PO), HP)) ||
    (!int_lt(PO, PN) && mallocng_specs.gone_pages(t.vm, V, PN, int_sub(PO, PN)))
  let G := (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), OVF)) || (ex r. o2 = ok(fn_update(t, "vm", t.vm), r) && fst(r) = t.vm.brk) ||
    (ex V r. o2 = ok(fn_update(t, "vm", V), r) && fst(r) = new && V in x86_64_linux.Vm && V.brk = new && !int_lt(new, t.vm.brk_start) && GROW(V))
  have vv: ex x. x in x86_64_linux.Vm by ex_intro({t.vm}, simp(pv))
  have vu := apply(x86.vm_univ, pv)
  have bko: t.vm.brk in bits(64) by simp(expand(pv, x86_64_linux.Vm))
  have poo: PO in omega by defs(arith(bko), x86_64_linux.pages_for, x86_64_linux.PAGE)
  have pno: PN in omega by defs(arith(hn), x86_64_linux.pages_for, x86_64_linux.PAGE)
  have fx: int_lt(PO, PN) -> ex V. V in x86_64_linux.Vm && (mallocng_specs.fresh_pages(t.vm, V, PO, int_sub(PN, PO), HP) && new = V.brk) proof
    assume hl
    obtain V, h1 h2 h3 from apply(mp.fresh_ex[before := t.vm, p := PO, n := int_sub(PN, PO), pg := HP, br := new], pv, vu, poo, (int_sub(PN, PO) in omega by arith(hl, poo, pno)), mp.heap_page, hn)
    show by ex_intro({V}, taut(h1, h2, sym(h3)))
  qed
  have gx: !int_lt(PO, PN) -> ex V. V in x86_64_linux.Vm && (mallocng_specs.gone_pages(t.vm, V, PN, int_sub(PO, PN)) && new = V.brk) proof
    assume _
    obtain V, h1 h2 h3 from apply(mp.gone_ex[before := t.vm, p := PN, n := int_sub(PO, PN), br := new], pv, vu, hn)
    show by ex_intro({V}, taut(h1, h2, sym(h3)))
  qed
  have ci: (ex v. v in x86_64_linux.Vm && o3 = exc(fn_update(t, "vm", v), OVF)) || o3 = ok(t, t.vm.brk) ||
      (ex V. (V in x86_64_linux.Vm && V.brk = new && !int_lt(new, t.vm.brk_start) && GROW(V)) && o3 = ok(fn_update(t, "vm", V), new))
    by simp(hs3, vv, fx, gx, keep(mallocng_specs.fresh_pages, mallocng_specs.gone_pages, x86_64_linux.free_range, x86_64_linux.off_stack_space, x86_64_linux.pages_for))
  have ne: ex z. z in bits(64) by ex_intro({0}, simp())
  have c1: (ex v. v in x86_64_linux.Vm && o3 = exc(fn_update(t, "vm", v), OVF)) -> G proof
    assume e
    obtain v, hv he from e
    have oe: o2 = exc(fn_update(t, "vm", v), OVF) by simp(rewrite(he, hk3))
    have l: ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), OVF) by ex_intro({v}, taut(hv, oe))
    show by taut(l)
  qed
  have c2: o3 = ok(t, t.vm.brk) -> G proof
    assume he
    have k: any_rel(x3. x3 in bits(64), x3. o2 = ok(t, pair(t.vm.brk, x3))) by simp(rewrite(he, hk3), keep(any_rel))
    obtain z, _ hoz from apply(g.any_e, ne, k)
    have ho: o2 = ok(fn_update(t, "vm", t.vm), pair(t.vm.brk, z)) := subst({y. o2 = ok(y, pair(t.vm.brk, z))}, sym(ss), hoz)
    have l: ex r. o2 = ok(fn_update(t, "vm", t.vm), r) && fst(r) = t.vm.brk by ex_intro({pair(t.vm.brk, z)}, taut(ho, (fst(pair(t.vm.brk, z)) = t.vm.brk by simp())))
    show by taut(l)
  qed
  have c3: (ex V. (V in x86_64_linux.Vm && V.brk = new && !int_lt(new, t.vm.brk_start) && GROW(V)) && o3 = ok(fn_update(t, "vm", V), new)) -> G proof
    assume e
    obtain V, hV hb hs hg he from e
    have k: any_rel(x3. x3 in bits(64), x3. o2 = ok(fn_update(t, "vm", V), pair(new, x3))) by simp(rewrite(he, hk3), keep(any_rel))
    obtain z, _ hoz from apply(g.any_e, ne, k)
    have l: ex V r. o2 = ok(fn_update(t, "vm", V), r) && fst(r) = new && V in x86_64_linux.Vm && V.brk = new && !int_lt(new, t.vm.brk_start) && GROW(V)
      by ex_intro({V}, {pair(new, z)}, taut(hoz, (fst(pair(new, z)) = new by simp()), hV, hb, hs, hg))
    show by taut(l)
  qed
  show by taut(ci, c1, c2, c3)
qed

// (the same, the return in `step`'s call shape: refused, nothing changed,
// or granted, the pages grown or shrunk)
abbrev mp.brk_grow(t, V, new) := (int_lt(x86_64_linux.pages_for(t.vm.brk), x86_64_linux.pages_for(new)) &&
    x86_64_linux.free_range(t.vm, x86_64_linux.pages_for(t.vm.brk), int_sub(x86_64_linux.pages_for(new), x86_64_linux.pages_for(t.vm.brk))) &&
    x86_64_linux.off_stack_space(t.vm, x86_64_linux.pages_for(t.vm.brk), int_sub(x86_64_linux.pages_for(new), x86_64_linux.pages_for(t.vm.brk))) &&
    mallocng_specs.fresh_pages(t.vm, V, x86_64_linux.pages_for(t.vm.brk), int_sub(x86_64_linux.pages_for(new), x86_64_linux.pages_for(t.vm.brk)),
      fn_update(fn_update(empty, "prot", fn_update(fn_update(fn_update(empty, "r", true), "w", true), "x", false)), "kind", 1))) ||
  (!int_lt(x86_64_linux.pages_for(t.vm.brk), x86_64_linux.pages_for(new)) &&
    mallocng_specs.gone_pages(t.vm, V, x86_64_linux.pages_for(new), int_sub(x86_64_linux.pages_for(t.vm.brk), x86_64_linux.pages_for(new))))
abbrev mp.brk_ret(t, V, r, new) := (V = t.vm && fst(r) = t.vm.brk) || (fst(r) = new && V.brk = new && !int_lt(new, t.vm.brk_start) && mp.brk_grow(t, V, new))
theorem mp.brk_qr: all t new regs o2. t in abi.World -> t in univ(1) -> new in bits(64) ->
  gc.regs_ok(regs, seq_concat(seq_one(gimple.arg(64, bits_of_int(64, 12))), seq_one(gimple.arg(64, new)))) ->
  runs(mallocng_specs.syscall1_spec_fun()[regs], t, o2) ->
  (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex V r. (V in x86_64_linux.Vm && mp.brk_ret(t, V, r, new)) && o2 = ok(fn_update(t, "vm", V), r))
proof
  fix t new regs o2
  assume hw hu hn hro h2
  have ea: bits_of_int(64, 12) = 12 by simp()
  have q := apply(mp.brk_q, hw, hu, hn, rewrite(ea, hro), h2)
  have wv vf vd vb := apply(ms.world_parts, hw)
  have k2: case 2 of q proof
    assume e
    obtain r, h1 h3 from e
    show by disj({2}, ex_intro({t.vm}, {r}, taut(wv, refl({t.vm}), h3, h1)))
  qed
  have k3: case 3 of q proof
    assume e
    obtain V r, h1 h3 h4 h5 h6 h7 from e
    show by disj({2}, ex_intro({V}, {r}, taut(h4, h3, h5, h6, h7, h1)))
  qed
  show by taut(q, k2, k3)
qed

// brk(0) (its arguments as the code passes them), the break starting at a
// page or above: an overflow, or the break returned, nothing changed
theorem mp.brk0_q: all t regs o2. t in abi.World -> t in univ(1) -> abi.brk_start_ok(t.vm) ->
  gc.regs_ok(regs, seq_concat(seq_one(gimple.arg(64, bits_of_int(64, 12))), seq_one(gimple.arg(64, bits_of_int(64, 0))))) ->
  runs(mallocng_specs.syscall1_spec_fun()[regs], t, o2) ->
  (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex r. o2 = ok(fn_update(t, "vm", t.vm), r) && fst(r) = t.vm.brk)
proof
  fix t regs o2
  assume hw htu hbs hro h
  have ea: seq_concat(seq_one(gimple.arg(64, bits_of_int(64, 12))), seq_one(gimple.arg(64, bits_of_int(64, 0)))) =
    seq_concat(seq_one(gimple.arg(64, 12)), seq_one(gimple.arg(64, 0))) by simp()
  have q := apply(mp.brk_q, hw, htu, (0 in bits(64) by simp()), rewrite(ea, hro), h)
  have pv _ _ _ := apply(ms.world_parts, hw)
  have bs: t.vm.brk_start in bits(64) by simp(expand(pv, x86_64_linux.Vm))
  have hb1: int_le(x86_64_linux.PAGE, t.vm.brk_start) by simp(expand(hbs, abi.brk_start_ok), bs)
  have b0: int_lt(0, t.vm.brk_start) by arith(hb1)
  have c3: !(ex V r. o2 = ok(fn_update(t, "vm", V), r) && fst(r) = 0 && V in x86_64_linux.Vm && V.brk = 0 && !int_lt(0, t.vm.brk_start) &&
      ((int_lt(x86_64_linux.pages_for(t.vm.brk), x86_64_linux.pages_for(0)) &&
        x86_64_linux.free_range(t.vm, x86_64_linux.pages_for(t.vm.brk), int_sub(x86_64_linux.pages_for(0), x86_64_linux.pages_for(t.vm.brk))) &&
        x86_64_linux.off_stack_space(t.vm, x86_64_linux.pages_for(t.vm.brk), int_sub(x86_64_linux.pages_for(0), x86_64_linux.pages_for(t.vm.brk))) &&
        mallocng_specs.fresh_pages(t.vm, V, x86_64_linux.pages_for(t.vm.brk), int_sub(x86_64_linux.pages_for(0), x86_64_linux.pages_for(t.vm.brk)),
          fn_update(fn_update(empty, "prot", fn_update(fn_update(fn_update(empty, "r", true), "w", true), "x", false)), "kind", 1))) ||
       (!int_lt(x86_64_linux.pages_for(t.vm.brk), x86_64_linux.pages_for(0)) &&
        mallocng_specs.gone_pages(t.vm, V, x86_64_linux.pages_for(0), int_sub(x86_64_linux.pages_for(t.vm.brk), x86_64_linux.pages_for(0)))))) proof
    assume e
    obtain V r, _ _ _ _ hs _ from e
    show by taut(hs, b0)
  qed
  show by taut(q, c3)
qed

// mmap(addr, len, prot, flags, fd, 0) (anonymous private memory, at addr
// if MAP_FIXED): an overflow, or a return -- -1, errno ENOMEM or EINVAL
// written; or a place p for len's pages (`mmap_place`), its pages fresh of
// protection prot, p's address returned
theorem mp.mmap_q: all t addr len prot flags fd regs o2. t in abi.World -> t in univ(1) -> addr in bits(64) -> len in bits(64) -> prot in bits(32) ->
  flags in bits(32) -> fd in bits(32) ->
  (flags = int_add(x86_64_linux.MAP_PRIVATE, x86_64_linux.MAP_ANONYMOUS) || flags = int_add(int_add(x86_64_linux.MAP_PRIVATE, x86_64_linux.MAP_ANONYMOUS), x86_64_linux.MAP_FIXED)) ->
  int_lt(prot, 8) -> mallocng_specs.errno_ok(t.vm, t.objs, t.fs_base) ->
  gc.regs_ok(regs, seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(gimple.arg(64, addr)), seq_one(gimple.arg(64, len))), seq_one(gimple.arg(32, prot))),
    seq_one(gimple.arg(32, flags))), seq_one(gimple.arg(32, fd))), seq_one(gimple.arg(64, 0)))) ->
  runs(mallocng_specs.mmap_spec_fun()[regs], t, o2) ->
  (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex e r. (e = x86_64_linux.ENOMEM || e = x86_64_linux.EINVAL) && o2 = ok(fn_update(t, "vm", mallocng_specs.wr32(t.vm, mallocng_specs.errno_at(t.fs_base), e)), r) &&
     fst(r) = bits_of_int(64, int_sub(int_pow(2, 64), 1))) ||
  (ex V p r. o2 = ok(fn_update(t, "vm", V), r) && fst(r) = bits_of_int(64, int_mul(p, x86_64_linux.PAGE)) && V in x86_64_linux.Vm && p in omega &&
     mallocng_specs.mmap_place(t.vm, addr, len, flags, p) &&
     mallocng_specs.fresh_pages(t.vm, V, p, x86_64_linux.pages_for(len), fn_update(fn_update(empty, "prot", x86_64_linux.prot_of(prot)), "kind", 0)) &&
     V.brk = t.vm.brk)
proof
  fix t addr len prot flags fd regs o2
  assume hw htu ha hl hp hf hfd hfl hpl he hro h
  let OVF := exc_val("stack_overflow", empty)
  let ARGS := seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(gimple.arg(64, addr)), seq_one(gimple.arg(64, len))), seq_one(gimple.arg(32, prot))),
    seq_one(gimple.arg(32, flags))), seq_one(gimple.arg(32, fd))), seq_one(gimple.arg(64, 0)))
  have rl rln _ := hro
  have an: seq_len(ARGS) = 6 by simp()
  have rn: seq_len(regs) = 6 := trans(rln, an)
  have lo: seq_len(regs) in omega by simp(rn)
  have q0 := apply(gc.reg_at[regs := regs, args := ARGS, i := 0, w := 64, x := addr], hro, simp(), simp(an), at({ARGS[0]}), simp(), ha)
  have q1 := apply(gc.reg_at[regs := regs, args := ARGS, i := 1, w := 64, x := len], hro, simp(), simp(an), at({ARGS[1]}), simp(), hl)
  have q2 := apply(gc.reg_at[regs := regs, args := ARGS, i := 2, w := 32, x := prot], hro, simp(), simp(an), at({ARGS[2]}), simp(), hp)
  have q3 := apply(gc.reg_at[regs := regs, args := ARGS, i := 3, w := 32, x := flags], hro, simp(), simp(an), at({ARGS[3]}), simp(), hf)
  have q5 := apply(gc.reg_at[regs := regs, args := ARGS, i := 5, w := 64, x := 0], hro, simp(), simp(an), at({ARGS[5]}), simp(), simp())
  have t0 := apply(at_type[l := regs, t := bits(64), i := 0], rl, simp(), simp(rn))
  have t1 := apply(at_type[l := regs, t := bits(64), i := 1], rl, simp(), simp(rn))
  have t5 := apply(at_type[l := regs, t := bits(64), i := 5], rl, simp(), simp(rn))
  have e0: regs[0] = addr by simp(q0, t0)
  have e1: regs[1] = len by simp(q1, t1)
  have e5: regs[5] = 0 by simp(q5, t5)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, mallocng_specs.mmap_spec_fun, app_fn_build, ra in h
  have o6: ord_le(6, seq_len(regs)) by defs(simp(rn), ord_le)
  have b := rewrite(e5, rewrite(q3, rewrite(q2, rewrite(e1, rewrite(e0, apply(g.runs_elim, h))))))
  have b2: bind_rel(mallocng_specs.mmap_spec(addr, len, prot, flags, 0), t, x3 x4. letin(x4, x5. any_rel(x6. x6 in bits(64), x6. o2 = ok(x3, pair(x5, x6)))), x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3))
    by taut(b, o6)
  obtain o3, hs3 hk3 from expand(b2, bind_rel)
  have pv pf pd pb := apply(ms.world_parts, hw)
  have vv: ex x. x in x86_64_linux.Vm by ex_intro({t.vm}, simp(pv))
  have ee: int_lt(prot, 8) -> ex x2. x2 in omega && (x2 = 12 || x2 = 22) proof
    assume _
    show by ex_intro({12}, simp())
  qed
  let PG := fn_update(fn_update(empty, "prot", x86_64_linux.prot_of(prot)), "kind", 0)
  have bp: bits_of_int(64, prot) = prot by defs(arith(hp), bits_of_int, pow2)
  let FR(p) := ex V. V in x86_64_linux.Vm && (mallocng_specs.fresh_pages(t.vm, V, p, x86_64_linux.pages_for(len), PG) && V.brk = t.vm.brk)
  have ci: (ex v. v in x86_64_linux.Vm && o3 = exc(fn_update(t, "vm", v), OVF)) ||
      (ex e. (e = x86_64_linux.ENOMEM || e = x86_64_linux.EINVAL) && o3 = ok(fn_update(t, "vm", mallocng_specs.wr32(t.vm, mallocng_specs.errno_at(t.fs_base), e)), bits_of_int(64, int_sub(int_pow(2, 64), 1)))) ||
      (ex V p. (V in x86_64_linux.Vm && p in omega && mallocng_specs.mmap_place(t.vm, addr, len, flags, p) &&
         mallocng_specs.fresh_pages(t.vm, V, p, x86_64_linux.pages_for(len), PG) && V.brk = t.vm.brk) && o3 = ok(fn_update(t, "vm", V), bits_of_int(64, int_mul(p, x86_64_linux.PAGE)))) ||
      (ex p. (p in omega && mallocng_specs.mmap_place(t.vm, addr, len, flags, p)) && !FR(p))
    by simp(hs3, vv, ee, hfl, hpl, he, bp, keep(mallocng_specs.fresh_pages, mallocng_specs.mmap_place, mallocng_specs.errno_ok, mallocng_specs.wr32, mallocng_specs.errno_at))
  let G := (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), OVF)) ||
    (ex e r. (e = x86_64_linux.ENOMEM || e = x86_64_linux.EINVAL) && o2 = ok(fn_update(t, "vm", mallocng_specs.wr32(t.vm, mallocng_specs.errno_at(t.fs_base), e)), r) &&
       fst(r) = bits_of_int(64, int_sub(int_pow(2, 64), 1))) ||
    (ex V p r. o2 = ok(fn_update(t, "vm", V), r) && fst(r) = bits_of_int(64, int_mul(p, x86_64_linux.PAGE)) && V in x86_64_linux.Vm && p in omega &&
       mallocng_specs.mmap_place(t.vm, addr, len, flags, p) && mallocng_specs.fresh_pages(t.vm, V, p, x86_64_linux.pages_for(len), PG) && V.brk = t.vm.brk)
  have ne: ex z. z in bits(64) by ex_intro({0}, simp())
  have c1: (ex v. v in x86_64_linux.Vm && o3 = exc(fn_update(t, "vm", v), OVF)) -> G proof
    assume e
    obtain v, hv hx from e
    have oe: o2 = exc(fn_update(t, "vm", v), OVF) by simp(rewrite(hx, hk3))
    have l: ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), OVF) by ex_intro({v}, taut(hv, oe))
    show by taut(l)
  qed
  have c2: (ex e. (e = x86_64_linux.ENOMEM || e = x86_64_linux.EINVAL) &&
      o3 = ok(fn_update(t, "vm", mallocng_specs.wr32(t.vm, mallocng_specs.errno_at(t.fs_base), e)), bits_of_int(64, int_sub(int_pow(2, 64), 1)))) -> G proof
    assume x
    obtain e, he1 hx from x
    let W := fn_update(t, "vm", mallocng_specs.wr32(t.vm, mallocng_specs.errno_at(t.fs_base), e))
    let M1 := bits_of_int(64, int_sub(int_pow(2, 64), 1))
    have k: any_rel(x3. x3 in bits(64), x3. o2 = ok(W, pair(M1, x3))) by simp(rewrite(hx, hk3), keep(any_rel, mallocng_specs.wr32, mallocng_specs.errno_at))
    obtain z, _ hoz from apply(g.any_e, ne, k)
    have l: ex e r. (e = x86_64_linux.ENOMEM || e = x86_64_linux.EINVAL) && o2 = ok(fn_update(t, "vm", mallocng_specs.wr32(t.vm, mallocng_specs.errno_at(t.fs_base), e)), r) &&
        fst(r) = M1 by ex_intro({e}, {pair(M1, z)}, taut(he1, hoz, (fst(pair(M1, z)) = M1 by simp())))
    show by taut(l)
  qed
  have c3: (ex V p. (V in x86_64_linux.Vm && p in omega && mallocng_specs.mmap_place(t.vm, addr, len, flags, p) &&
      mallocng_specs.fresh_pages(t.vm, V, p, x86_64_linux.pages_for(len), PG) && V.brk = t.vm.brk) && o3 = ok(fn_update(t, "vm", V), bits_of_int(64, int_mul(p, x86_64_linux.PAGE)))) -> G proof
    assume x
    obtain V p, hV hpo hpl2 hfp hbk hx from x
    let R := bits_of_int(64, int_mul(p, x86_64_linux.PAGE))
    have k: any_rel(x3. x3 in bits(64), x3. o2 = ok(fn_update(t, "vm", V), pair(R, x3))) by simp(rewrite(hx, hk3), keep(any_rel))
    obtain z, _ hoz from apply(g.any_e, ne, k)
    have l: ex V p r. o2 = ok(fn_update(t, "vm", V), r) && fst(r) = bits_of_int(64, int_mul(p, x86_64_linux.PAGE)) && V in x86_64_linux.Vm && p in omega &&
        mallocng_specs.mmap_place(t.vm, addr, len, flags, p) && mallocng_specs.fresh_pages(t.vm, V, p, x86_64_linux.pages_for(len), PG) && V.brk = t.vm.brk
      by ex_intro({V}, {p}, {pair(R, z)}, taut(hoz, (fst(pair(R, z)) = R by simp()), hV, hpo, hpl2, hfp, hbk))
    show by taut(l)
  qed
  // (a place: such a memory exists)
  have pr := apply(mp.prot_typed, eq_bool[a := int_mod(int_div(prot, pow2(0)), 2), b := 1], eq_bool[a := int_mod(int_div(prot, pow2(1)), 2), b := 1],
    eq_bool[a := int_mod(int_div(prot, pow2(2)), 2), b := 1])
  have pt: x86_64_linux.prot_of(prot) in x86_64_linux.Prot by defs(simp(pr, keep(x86_64_linux.Prot)), x86_64_linux.prot_of, bit)
  have pg := apply(mp.page_typed, pt, (0 in x86_64_linux.Kind by defs(simp(), x86_64_linux.Kind)))
  have vu := apply(x86.vm_univ, pv)
  have bkb: t.vm.brk in bits(64) by simp(expand(pv, x86_64_linux.Vm))
  have c4: (ex p. (p in omega && mallocng_specs.mmap_place(t.vm, addr, len, flags, p)) && !FR(p)) -> G proof
    assume x
    obtain p, hpo _ hn from x
    obtain V, h1 h2 h3 from apply(mp.fresh_ex[before := t.vm, p := p, n := x86_64_linux.pages_for(len), pg := PG, br := t.vm.brk], pv, vu, hpo,
      (x86_64_linux.pages_for(len) in omega by defs(arith(hl), x86_64_linux.pages_for, x86_64_linux.PAGE)), pg, bkb)
    have f: FR(p) by ex_intro({V}, taut(h1, h2, h3))
    show by taut(f, hn)
  qed
  show by taut(ci, c1, c2, c3, c4)
qed

// (a page with another protection: a page)
theorem mp.prot_upd(P, pr): P in x86_64_linux.Page -> pr in x86_64_linux.Prot -> fn_update(P, "prot", pr) in x86_64_linux.Page
proof
  assume hp hr
  let K := insert("prot", insert("kind", empty))
  let KP := insert("r", insert("w", insert("x", empty)))
  have pp pf pd ppr pk := (P in powerset(cart(K, univ(1))) && is_fun(P) && dom(P) = K && P.prot in x86_64_linux.Prot && P.kind in x86_64_linux.Kind
    by simp(expand(hp, x86_64_linux.Page)))
  have pu := mp(rec_univ[u := 1, k := K, r := P], simp(x86.insert_univ), pp, pf, pd)
  have rp rf rd := (pr in powerset(cart(KP, univ(1))) && is_fun(pr) && dom(pr) = KP by simp(expand(hr, x86_64_linux.Prot)))
  have ru := mp(rec_univ[u := 1, k := KP, r := pr], simp(x86.insert_univ), rp, rf, rd)
  have qu: fn_update(P, "prot", pr) in univ(1) by simp(pu, ru)
  have qf := mp(fn_update_fun[f := P, k := "prot", v := pr], pf)
  have qd: dom(fn_update(P, "prot", pr)) = K := trans(mp(mp(fn_update_dom[f := P, k := "prot", v := pr], pf), (("prot" in dom(P)) by simp(pd))), pd)
  have qq: ((is_fun(fn_update(P, "prot", pr)) && dom(fn_update(P, "prot", pr)) = K) && fn_update(P, "prot", pr).prot in x86_64_linux.Prot) &&
      fn_update(P, "prot", pr).kind in x86_64_linux.Kind by simp(qf, qd, hr, pk, keep(x86_64_linux.Prot, x86_64_linux.Kind))
  show by defs(apply(rec_type_intro[u := 1, k := K, p := x0. ((is_fun(x0) && dom(x0) = K) && x0.prot in x86_64_linux.Prot) && x0.kind in x86_64_linux.Kind,
    r := fn_update(P, "prot", pr)], qu, qf, qd, qq), x86_64_linux.Page)
qed

// pages p .. p+n-1, all mapped, of protection pr: such a memory exists
theorem mp.reprot_ex(before, p, n, pr): before in x86_64_linux.Vm -> before in univ(1) -> pr in x86_64_linux.Prot ->
  (all q. q in omega -> int_le(p, q) -> int_lt(q, int_add(p, n)) -> x86_64_linux.mapped(before, q)) ->
  ex V. V in x86_64_linux.Vm && mallocng_specs.reprot(before, V, p, n, pr)
proof
  assume hv hu hr hm
  let PN := set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)))
  let PGS := fn_build(PN, q. ite(int_le(p, q) && int_lt(q, int_add(p, n)), some(fn_update(snd(before.pages[q]), "prot", pr)), before.pages[q]))
  let V := fn_update(before, "pages", PGS)
  have pgv: all q. q in PN -> ite(int_le(p, q) && int_lt(q, int_add(p, n)), some(fn_update(snd(before.pages[q]), "prot", pr)), before.pages[q]) in option(x86_64_linux.Page) proof
    fix q
    assume hq
    have pq := apply(x86.vm_page_at, hv, hq)
    have qo ql := (q in omega && int_lt(q, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) by simp(hq))
    have inr: int_le(p, q) && int_lt(q, int_add(p, n)) -> some(fn_update(snd(before.pages[q]), "prot", pr)) in option(x86_64_linux.Page) proof
      assume h12
      have h1 h2 := h12
      have mq := mp(all_elim(hm, {q}), qo, h1, h2)
      have nn: !(before.pages[q] = none) by taut(expand(mq, x86_64_linux.mapped))
      have sv := apply(some_val, pq, nn)
      show := apply(mp.some_page, apply(mp.prot_upd, sv, hr))
    qed
    show by simp(inr, pq)
  qed
  have pgs := apply(fn_build_space[d := PN, v := q. ite(int_le(p, q) && int_lt(q, int_add(p, n)), some(fn_update(snd(before.pages[q]), "prot", pr)), before.pages[q]),
    b := option(x86_64_linux.Page)], pgv)
  have pgu := apply(x86.fn_space_univ, x86.pn_univ, x86.opt_page_univ)
  have pu := mp(mp(univ_trans[u := 1, a := PGS, b := fn_space(PN, option(x86_64_linux.Page))], pgu), pgs)
  have vt _ := apply(x86.vm_pages_put, hv, hu, pgs, pu)
  have bf bd := (is_fun(before) && "pages" in dom(before) by simp(expand(hv, x86_64_linux.Vm)))
  have back: fn_update(V, "pages", before.pages) = before := trans(fn_update_twice[f := before, k := "pages", a := PGS, b := before.pages], mp(fn_update_same[f := before, k := "pages"], bf, bd))
  have pq: all q. q in omega -> int_lt(q, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) ->
      V.pages[q] = ite(int_le(p, q) && int_lt(q, int_add(p, n)), some(fn_update(snd(before.pages[q]), "prot", pr)), before.pages[q]) proof
    fix q
    assume h1 h2
    have qp: q in PN by simp(h1, h2)
    show by simp(app_fn_build[d := PN, v := q. ite(int_le(p, q) && int_lt(q, int_add(p, n)), some(fn_update(snd(before.pages[q]), "prot", pr)), before.pages[q]), a := q], qp)
  qed
  have rp: mallocng_specs.reprot(before, V, p, n, pr) by defs(taut(back, pq), mallocng_specs.reprot)
  show by ex_intro({V}, taut(vt, rp))
qed

// mprotect(addr, len, prot): an overflow, or a return -- the pages from
// addr's to addr + len's (all mapped) of protection prot, 0; or, at the
// first of them unmapped, k, the ones before it of protection prot and
// errno ENOMEM written, -1
theorem mp.mprotect_q: all t addr len prot regs o2. t in abi.World -> t in univ(1) -> addr in bits(64) -> len in bits(64) -> prot in bits(32) ->
  int_lt(prot, 8) -> int_le(int_add(int_add(addr, len), x86_64_linux.PAGE), int_pow(2, 64)) -> mallocng_specs.errno_ok(t.vm, t.objs, t.fs_base) ->
  gc.regs_ok(regs, seq_concat(seq_concat(seq_one(gimple.arg(64, addr)), seq_one(gimple.arg(64, len))), seq_one(gimple.arg(32, prot)))) ->
  runs(mallocng_specs.mprotect_spec_fun()[regs], t, o2) ->
  (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex V r. o2 = ok(fn_update(t, "vm", V), r) && bits_of_int(32, fst(r)) = 0 && V in x86_64_linux.Vm &&
     (all q. q in omega -> int_le(int_div(addr, x86_64_linux.PAGE), q) && int_lt(q, int_div(int_sub(int_add(int_add(addr, len), x86_64_linux.PAGE), 1), x86_64_linux.PAGE)) ->
        x86_64_linux.mapped(t.vm, q)) &&
     mallocng_specs.reprot(t.vm, V, int_div(addr, x86_64_linux.PAGE),
       int_sub(int_div(int_sub(int_add(int_add(addr, len), x86_64_linux.PAGE), 1), x86_64_linux.PAGE), int_div(addr, x86_64_linux.PAGE)), x86_64_linux.prot_of(bits_of_int(64, prot)))) ||
  (ex V k r. o2 = ok(fn_update(t, "vm", mallocng_specs.wr32(V, mallocng_specs.errno_at(t.fs_base), x86_64_linux.ENOMEM)), r) &&
     bits_of_int(32, fst(r)) = bits_of_int(32, int_sub(int_pow(2, 32), 1)) && V in x86_64_linux.Vm && k in omega &&
     int_le(int_div(addr, x86_64_linux.PAGE), k) && int_lt(k, int_div(int_sub(int_add(int_add(addr, len), x86_64_linux.PAGE), 1), x86_64_linux.PAGE)) &&
     !x86_64_linux.mapped(t.vm, k) && (all q. q in omega -> int_le(int_div(addr, x86_64_linux.PAGE), q) && int_lt(q, k) -> x86_64_linux.mapped(t.vm, q)) &&
     mallocng_specs.reprot(t.vm, V, int_div(addr, x86_64_linux.PAGE), int_sub(k, int_div(addr, x86_64_linux.PAGE)), x86_64_linux.prot_of(bits_of_int(64, prot))))
proof
  fix t addr len prot regs o2
  assume hw htu ha hl hp hpl hsz he hro h
  let OVF := exc_val("stack_overflow", empty)
  let ARGS := seq_concat(seq_concat(seq_one(gimple.arg(64, addr)), seq_one(gimple.arg(64, len))), seq_one(gimple.arg(32, prot)))
  let S := int_div(addr, x86_64_linux.PAGE)
  let E := int_div(int_sub(int_add(int_add(addr, len), x86_64_linux.PAGE), 1), x86_64_linux.PAGE)
  let PR := x86_64_linux.prot_of(bits_of_int(64, prot))
  let ALL := all q. q in omega -> int_le(S, q) && int_lt(q, E) -> x86_64_linux.mapped(t.vm, q)
  let LEAST(k) := k in omega && (((int_le(S, k) && int_lt(k, E)) && !x86_64_linux.mapped(t.vm, k)) && (all q. q in omega -> int_le(S, q) && int_lt(q, k) -> x86_64_linux.mapped(t.vm, q)))
  have rl rln _ := hro
  have an: seq_len(ARGS) = 3 by simp()
  have rn: seq_len(regs) = 3 := trans(rln, an)
  have lo: seq_len(regs) in omega by simp(rn)
  have q0 := apply(gc.reg_at[regs := regs, args := ARGS, i := 0, w := 64, x := addr], hro, simp(), simp(an), at({ARGS[0]}), simp(), ha)
  have q1 := apply(gc.reg_at[regs := regs, args := ARGS, i := 1, w := 64, x := len], hro, simp(), simp(an), at({ARGS[1]}), simp(), hl)
  have q2 := apply(gc.reg_at[regs := regs, args := ARGS, i := 2, w := 32, x := prot], hro, simp(), simp(an), at({ARGS[2]}), simp(), hp)
  have t0 := apply(at_type[l := regs, t := bits(64), i := 0], rl, simp(), simp(rn))
  have t1 := apply(at_type[l := regs, t := bits(64), i := 1], rl, simp(), simp(rn))
  have e0: regs[0] = addr by simp(q0, t0)
  have e1: regs[1] = len by simp(q1, t1)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, mallocng_specs.mprotect_spec_fun, app_fn_build, ra in h
  have o3l: ord_le(3, seq_len(regs)) by defs(simp(rn), ord_le)
  have b := rewrite(q2, rewrite(e1, rewrite(e0, apply(g.runs_elim, h))))
  have b2: bind_rel(mallocng_specs.mprotect_spec(addr, len, prot), t, x3 x4. letin(x4, x5. bind_rel(gimple.result(32, x5), x3, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. o2 = ok(x6, pair(x8, x9)))),
      x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))), x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3)) by taut(b, o3l)
  obtain o3, hs3 hk3 from expand(b2, bind_rel)
  have pv pf pd pb := apply(ms.world_parts, hw)
  have vu := apply(x86.vm_univ, pv)
  have vv: ex x. x in x86_64_linux.Vm by ex_intro({t.vm}, simp(pv))
  have bp: bits_of_int(64, prot) = prot by defs(arith(hp), bits_of_int, pow2)
  let BP := bits_of_int(64, prot)
  have pr := apply(mp.prot_typed, eq_bool[a := int_mod(int_div(BP, pow2(0)), 2), b := 1], eq_bool[a := int_mod(int_div(BP, pow2(1)), 2), b := 1],
    eq_bool[a := int_mod(int_div(BP, pow2(2)), 2), b := 1])
  have pt: PR in x86_64_linux.Prot by defs(taut(pr), x86_64_linux.prot_of, bit)
  // (all mapped: such a memory; not all: a first unmapped page)
  have ax: ALL -> ex V. V in x86_64_linux.Vm && mallocng_specs.reprot(t.vm, V, S, int_sub(E, S), PR) proof
    assume hall
    have m: all q. q in omega -> int_le(S, q) -> int_lt(q, int_add(S, int_sub(E, S))) -> x86_64_linux.mapped(t.vm, q) proof
      fix q
      assume h1 h2 h3
      show := mp(all_elim(hall, {q}), h1, conj(h2, (int_lt(q, E) by arith(h3))))
    qed
    show := apply(mp.reprot_ex[before := t.vm, p := S, n := int_sub(E, S), pr := PR], pv, vu, pt, m)
  qed
  have kx: !ALL -> ex k. LEAST(k) proof
    assume hn
    have sx: !(ex q. q in omega && int_le(S, q) && int_lt(q, E) && !x86_64_linux.mapped(t.vm, q)) -> ALL proof
      assume hne
      fix q
      assume g1 g23
      have g2 g3 := g23
      have c: !x86_64_linux.mapped(t.vm, q) -> false proof
        assume hm
        have ex1: ex q. q in omega && int_le(S, q) && int_lt(q, E) && !x86_64_linux.mapped(t.vm, q) by ex_intro({q}, taut(g1, g2, g3, hm))
        show by taut(hne, ex1)
      qed
      show by taut(c)
    qed
    obtain q, hq h1 h2 hu from ((ex q. q in omega && int_le(S, q) && int_lt(q, E) && !x86_64_linux.mapped(t.vm, q)) by taut(hn, sx))
    obtain k, hk hp2 hmin from apply(nat_least[p := y. int_le(S, y) && int_lt(y, E) && !x86_64_linux.mapped(t.vm, y)], (ex a. a in omega && (int_le(S, a) && int_lt(a, E) && !x86_64_linux.mapped(t.vm, a)) by ex_intro({q}, taut(hq, h1, h2, hu))))
    have below: all y. y in omega -> int_le(S, y) && int_lt(y, k) -> x86_64_linux.mapped(t.vm, y) proof
      fix y
      assume hy hr
      have r1 r2 := hr
      have c: !x86_64_linux.mapped(t.vm, y) -> false proof
        assume hny
        have le := mp(all_elim(hmin, {y}), hy, taut(r1, (int_lt(y, E) by arith(r2, hp2)), hny))
        show by arith(le, r2)
      qed
      show by taut(c)
    qed
    show by ex_intro({k}, taut(hk, hp2, below))
  qed
  let RX(k) := ex V. V in x86_64_linux.Vm && mallocng_specs.reprot(t.vm, V, S, int_sub(k, S), PR)
  have ci: (ex v. v in x86_64_linux.Vm && o3 = exc(fn_update(t, "vm", v), OVF)) ||
      (ex V. (V in x86_64_linux.Vm && ALL && mallocng_specs.reprot(t.vm, V, S, int_sub(E, S), PR)) && o3 = ok(fn_update(t, "vm", V), 0)) ||
      (ex V k. (V in x86_64_linux.Vm && LEAST(k) && mallocng_specs.reprot(t.vm, V, S, int_sub(k, S), PR)) &&
         o3 = ok(fn_update(t, "vm", mallocng_specs.wr32(V, mallocng_specs.errno_at(t.fs_base), x86_64_linux.ENOMEM)), bits_of_int(32, int_sub(int_pow(2, 32), 1)))) ||
      (ex k. LEAST(k) && !RX(k))
    by simp(hs3, vv, ax, kx, hpl, hsz, he, keep(mallocng_specs.reprot, mallocng_specs.errno_ok, mallocng_specs.wr32, mallocng_specs.errno_at, x86_64_linux.mapped))
  let G1(V) := V in x86_64_linux.Vm && ALL && mallocng_specs.reprot(t.vm, V, S, int_sub(E, S), PR)
  let G2(V, k) := V in x86_64_linux.Vm && LEAST(k) && mallocng_specs.reprot(t.vm, V, S, int_sub(k, S), PR)
  let G := (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), OVF)) ||
    (ex V r. o2 = ok(fn_update(t, "vm", V), r) && bits_of_int(32, fst(r)) = 0 && V in x86_64_linux.Vm && ALL && mallocng_specs.reprot(t.vm, V, S, int_sub(E, S), PR)) ||
    (ex V k r. o2 = ok(fn_update(t, "vm", mallocng_specs.wr32(V, mallocng_specs.errno_at(t.fs_base), x86_64_linux.ENOMEM)), r) &&
       bits_of_int(32, fst(r)) = bits_of_int(32, int_sub(int_pow(2, 32), 1)) && V in x86_64_linux.Vm && k in omega && int_le(S, k) && int_lt(k, E) &&
       !x86_64_linux.mapped(t.vm, k) && (all q. q in omega -> int_le(S, q) && int_lt(q, k) -> x86_64_linux.mapped(t.vm, q)) &&
       mallocng_specs.reprot(t.vm, V, S, int_sub(k, S), PR))
  have ne: ex z. z in bits(64) by ex_intro({0}, simp())
  // (a 32-bit result from state W: as GIMPLE's wrapper returns it)
  have res: all W v. v in bits(32) -> o3 = ok(W, v) -> ex r. o2 = ok(W, r) && bits_of_int(32, fst(r)) = v proof
    fix W v
    assume hv hx
    have k1: bind_rel(gimple.result(32, v), W, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. o2 = ok(x6, pair(x8, x9)))), x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))
      by simp(expand(rewrite(hx, hk3), letin), keep(bind_rel, gimple.result))
    obtain o4, hr4 hk4 from expand(k1, bind_rel)
    obtain u, hu64 hlow ho4 from apply(g.result32_inv, hv, hr4)
    have k2: any_rel(x9. x9 in bits(64), x9. o2 = ok(W, pair(u, x9))) by simp(expand(rewrite(ho4, hk4), letin), keep(any_rel))
    obtain z, _ hoz from apply(g.any_e, ne, k2)
    show by ex_intro({pair(u, z)}, taut(hoz, (bits_of_int(32, fst(pair(u, z))) = v by simp(hlow))))
  qed
  have c1: (ex v. v in x86_64_linux.Vm && o3 = exc(fn_update(t, "vm", v), OVF)) -> G proof
    assume x
    obtain v, hv hx from x
    have oe: o2 = exc(fn_update(t, "vm", v), OVF) by simp(rewrite(hx, hk3))
    have l: ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(t, "vm", v), OVF) by ex_intro({v}, taut(hv, oe))
    show by taut(l)
  qed
  have c2: (ex V. G1(V) && o3 = ok(fn_update(t, "vm", V), 0)) -> G proof
    assume x
    obtain V, hV hall hrp hx from x
    obtain r, hor hr from mp(all_elim(res, {fn_update(t, "vm", V)}, {0}), simp(), hx)
    have l: ex V r. o2 = ok(fn_update(t, "vm", V), r) && bits_of_int(32, fst(r)) = 0 && V in x86_64_linux.Vm && ALL && mallocng_specs.reprot(t.vm, V, S, int_sub(E, S), PR)
      by ex_intro({V}, {r}, taut(hor, hr, hV, hall, hrp))
    show by taut(l)
  qed
  have c3: (ex V k. G2(V, k) && o3 = ok(fn_update(t, "vm", mallocng_specs.wr32(V, mallocng_specs.errno_at(t.fs_base), x86_64_linux.ENOMEM)), bits_of_int(32, int_sub(int_pow(2, 32), 1)))) -> G proof
    assume x
    obtain V k, hV hk hrp hx from x
    obtain r, hor hr from mp(all_elim(res, {fn_update(t, "vm", mallocng_specs.wr32(V, mallocng_specs.errno_at(t.fs_base), x86_64_linux.ENOMEM))}, {bits_of_int(32, int_sub(int_pow(2, 32), 1))}), simp(), hx)
    have l: ex V k r. o2 = ok(fn_update(t, "vm", mallocng_specs.wr32(V, mallocng_specs.errno_at(t.fs_base), x86_64_linux.ENOMEM)), r) &&
        bits_of_int(32, fst(r)) = bits_of_int(32, int_sub(int_pow(2, 32), 1)) && V in x86_64_linux.Vm && k in omega && int_le(S, k) && int_lt(k, E) &&
        !x86_64_linux.mapped(t.vm, k) && (all q. q in omega -> int_le(S, q) && int_lt(q, k) -> x86_64_linux.mapped(t.vm, q)) &&
        mallocng_specs.reprot(t.vm, V, S, int_sub(k, S), PR) by ex_intro({V}, {k}, {r}, taut(hor, hr, hV, hk, hrp))
    show by taut(l)
  qed
  have c4: (ex k. LEAST(k) && !RX(k)) -> G proof
    assume x
    obtain k, ko hkr hn from x
    have _ _ _ hbelow := hkr
    have m: all q. q in omega -> int_le(S, q) -> int_lt(q, int_add(S, int_sub(k, S))) -> x86_64_linux.mapped(t.vm, q) proof
      fix q
      assume h1 h2 h3
      show := mp(all_elim(hbelow, {q}), h1, conj(h2, (int_lt(q, k) by arith(h3))))
    qed
    have f: RX(k) := apply(mp.reprot_ex[before := t.vm, p := S, n := int_sub(k, S), pr := PR], pv, vu, pt, m)
    show by taut(f, hn)
  qed
  show by taut(ci, c1, c2, c3, c4)
qed

// ----------------------------------------------------------------------
//  The context's words: the invariant's usable

// (n bytes of the context from off, none a free one: usable, for reading
// and writing)
theorem mp.ctx_usable(c, A, vm, b, objs, off, n): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_in(c, A, vm, b) ->
  off in omega -> n in omega -> int_le(int_add(off, n), mallocng.CTX_SIZE) -> (all i. i in omega -> int_lt(i, n) -> !mallocng.ctx_free(c, int_add(int_add(c.ctx, off), i))) ->
  gimple.usable(vm, objs, int_add(c.ctx, off), n, false) && gimple.usable(vm, objs, int_add(c.ctx, off), n, true)
proof
  assume hc hu ha hh ho hn hl hf
  let F := mallocng.held(c, A, b)
  have cx: c.ctx in omega by simp(expand(hc, mallocng.Cfg))
  have each: all i. i in omega -> int_lt(i, n) -> int_add(int_add(c.ctx, off), i) in F && mallocng.m_rw(mallocng.mview(vm, F), int_add(int_add(c.ctx, off), i)) &&
      !(snd(mallocng.pg(mallocng.mview(vm, F), int_add(int_add(c.ctx, off), i))).kind = 2) proof
    fix i
    assume hi hil
    show := apply(mp.ctx_acc[c := c, A := A, vm := vm, b := b, a := int_add(int_add(c.ctx, off), i)], hc, hu, ha, hh, arith(cx, ho, hi), arith(ho, hi), arith(hl, hil, ho, hi),
      mp(all_elim(hf, {i}), hi, hil))
  qed
  show := apply(mp.rw_usable[vm := vm, F := F, objs := objs, a := int_add(c.ctx, off), n := n], arith(cx, ho), each)
qed

// (... read: the view's)
theorem mp.ctx_read(c, A, vm, b, off, n): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_in(c, A, vm, b) ->
  off in omega -> n in omega -> int_le(int_add(off, n), mallocng.CTX_SIZE) -> (all i. i in omega -> int_lt(i, n) -> !mallocng.ctx_free(c, int_add(int_add(c.ctx, off), i))) ->
  gimple.bytes_at(vm, int_add(c.ctx, off), n) = mallocng.rd(mallocng.mview(vm, mallocng.held(c, A, b)), int_add(c.ctx, off), n)
proof
  assume hc hu ha hh ho hn hl hf
  have cx: c.ctx in omega by simp(expand(hc, mallocng.Cfg))
  have each: all i. i in omega -> int_lt(i, n) -> int_add(int_add(c.ctx, off), i) in mallocng.held(c, A, b) proof
    fix i
    assume hi hil
    have r := apply(mp.ctx_acc[c := c, A := A, vm := vm, b := b, a := int_add(int_add(c.ctx, off), i)], hc, hu, ha, hh, arith(cx, ho, hi), arith(ho, hi), arith(hl, hil, ho, hi),
      mp(all_elim(hf, {i}), hi, hil))
    show by taut(r)
  qed
  show := apply(mp.view_read[vm := vm, fp := mallocng.held(c, A, b), a := int_add(c.ctx, off), n := n], arith(cx, ho), hn, arith(hl, ho), each)
qed

// ----------------------------------------------------------------------
//  Before the first call: the image's, the data's and the auxiliary
//  vector's bytes the invariant's

// (a byte of those ranges, not a free counter's: held -- no group, no
// area yet)
theorem mp.fresh_held(c, A, vm, b, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  mallocng.holds_in(c, A, vm, b) -> A.init_done = 0 -> a in omega ->
  mallocng.in_ranges(a, seq_concat(seq_concat(mallocng.ro_ranges(c.file), mallocng.data_ranges(c)), mallocng.auxv_ranges(A))) -> !mallocng.ctx_free(c, a) ->
  a in mallocng.held(c, A, b)
proof
  assume hc hu ha hb hh h0 hao hr hnf
  let M := mallocng.mview(vm, mallocng.held(c, A, b))
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {huo = used, hga = apart, hfr = fresh} := expand(H, mallocng.holds)
  have {z1 = areas, z4 = used} := mp(expand(hfr, mallocng.fresh_ok), h0)
  have nl: !(a in malloc.live_of(b)) proof
    assume hl
    obtain g, hg _ from apply(mp.live_grp[c := c, A := A, M := M, b := b, brk := vm.brk, a := a], ha, hb, H, hl)
    obtain k, hk hkl _ from expand(hg, mallocng.is_used)
    show by arith(hkl, z4, hk)
  qed
  have nr := apply(mp.fixed_unres[c := c, A := A, M := M, b := b, a := a], hc, hu, ha, hao, huo, hga, taut(hr))
  have na: all k. k in omega -> int_lt(k, seq_len(A.areas)) -> !(int_le(A.areas[k], a) && int_lt(a, int_add(A.areas[k], 4096))) proof
    fix k
    assume hk hkl
    show by arith(hkl, z1, hk)
  qed
  have nt := apply(mp.untaken_of[c := c, A := A, M := M, b := b, brk := vm.brk, a := a], hc, hu, ha, H, hao, na)
  have fp := apply(mp.fp_intro[c := c, A := A, b := b, a := a], hc, hu, ha, hao, nl, nr, nt, taut(hr))
  show := apply(mp.held_intro, fp, hnf)
qed

// (libc's auxv word -- libc + 8, a data symbol's bytes: usable, the
// auxiliary vector's address)
theorem mp.libc_auxv(c, A, vm, b, objs): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  mallocng.holds_in(c, A, vm, b) -> A.init_done = 0 ->
  gimple.usable(vm, objs, int_add(c.libc, 8), 8, false) && gimple.bytes_at(vm, int_add(c.libc, 8), 8) = A.auxv_at &&
  int_lt(int_add(c.libc, 16), int_pow(2, 64))
proof
  assume hc hu ha hb hh h0
  let M := mallocng.mview(vm, mallocng.held(c, A, b))
  let F := mallocng.held(c, A, b)
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {hpo = perms, hsp = sep, hfr = fresh} := expand(H, mallocng.holds)
  have {fat = auxv_at} := mp(expand(hfr, mallocng.fresh_ok), h0)
  have {pd = data} := expand(hpo, mallocng.perms_ok)
  have {rd = rodata, xl = auxv} := apply(mp.front_pieces, hc, hu, ha)
  have ro := apply(mp.ro_list, (c.file in seq_type(bits(8)) by simp(hc)))
  have cf1 cf2 cf3 := (c.ctx in omega && c.lock in omega && c.libc in omega by simp(hc))
  have o1 := apply(tr.seq_one_type, (pair(c.ctx, mallocng.CTX_SIZE) in univ(1) by simp(cf1)))
  have o2 := apply(tr.seq_one_type, (pair(c.lock, 4) in univ(1) by simp(cf2)))
  have o3 := apply(tr.seq_one_type, (pair(c.libc, 16) in univ(1) by simp(cf3)))
  have dl: mallocng.data_ranges(c) in list_type(univ(1)) by defs(apply(tr.concat_list, apply(tr.concat_list, o1, o2), o3), mallocng.data_ranges)
  have dll: seq_len(mallocng.data_ranges(c)) = 3 by defs(arith(), mallocng.data_ranges)
  have d0 _ d2 := mp.data_at[c := c]
  have {rg0 = data} := apply(mp.reg_at[c := c, A := A, i := 0], hc, hu, ha, simp())
  have {rg2 = data} := apply(mp.reg_at[c := c, A := A, i := 2], hc, hu, ha, simp())
  have {rgl = len} := apply(mp.reg_at[c := c, A := A, i := 0], hc, hu, ha, simp())
  have fs: c.file in seq_type(bits(8)) by simp(hc)
  have pn: x86_64_linux.phnum(c.file) in omega by defs(mp(x86.le_at_nat[f := c.file, off := 56, n := 2], fs, simp()), x86_64_linux.phnum)
  have al: seq_len(A.areas) in omega by arith((A.areas in list_type(omega) by simp(ha)))
  have ap := mp(all_elim(expand(hsp, mallocng.separate), {2}, {0}), conj((2 in omega by simp()), (0 in omega by simp())),
    ((int_lt(2, seq_len(mallocng.regions(c, A))) && int_lt(0, seq_len(mallocng.regions(c, A)))) && !(2 = 0) by arith(rgl, pn, al)))
  have ap2: mallocng.apart(pair(c.libc, 16), pair(c.ctx, mallocng.CTX_SIZE)) := rewrite(d0, rewrite(d2, rewrite(mp(rg0, simp()), rewrite(mp(rg2, simp()), ap))))
  have each: all i. i in omega -> int_lt(i, 8) -> int_add(int_add(c.libc, 8), i) in F && mallocng.m_mapped(M, int_add(int_add(c.libc, 8), i)) &&
      snd(mallocng.pg(M, int_add(int_add(c.libc, 8), i))).prot.r && !(snd(mallocng.pg(M, int_add(int_add(c.libc, 8), i))).kind = 2) proof
    fix i
    assume hi hil
    let x := int_add(int_add(c.libc, 8), i)
    have xo: x in omega by arith(cf3, hi)
    have xr: mallocng.in_range(x, pair(c.libc, 16)) by defs(simp((int_le(c.libc, x) && int_lt(x, int_add(c.libc, 16)) by arith(hi, hil, cf3))), mallocng.in_range)
    have nx := apply(mp.apart_not[r := pair(c.libc, 16), q := pair(c.ctx, mallocng.CTX_SIZE), a := x], mp(cart_intro[a := omega, b := omega, x := c.libc, y := 16], cf3, simp()),
      mp(cart_intro[a := omega, b := omega, x := c.ctx, y := mallocng.CTX_SIZE], cf1, (mallocng.CTX_SIZE in omega by simp())), ap2, xr)
    have ncf: !mallocng.ctx_free(c, x) proof
      assume hf
      have ic0: int_le(c.ctx, x) && int_lt(x, int_add(c.ctx, 928)) by arith(expand(hf, mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK))
      have ic: mallocng.in_range(x, pair(c.ctx, mallocng.CTX_SIZE)) by defs(simp(ic0), mallocng.in_range)
      show by taut(ic, nx)
    qed
    have ir: mallocng.in_ranges(x, mallocng.data_ranges(c)) by defs(ex_intro({2}, taut((2 in omega by simp()), (int_lt(2, seq_len(mallocng.data_ranges(c))) by arith(dll)), rewrite(sym(d2), xr))), mallocng.in_ranges)
    have q := apply(mp.ranges_l, rd, xl, apply(mp.ranges_r, ro, dl, ir))
    have xh := apply(mp.fresh_held[c := c, A := A, vm := vm, b := b, a := x], hc, hu, ha, hb, hh, h0, xo, q, ncf)
    have rw ns := mp(all_elim(pd, {2}, {x}), conj((2 in omega by simp()), xo), taut((int_lt(2, 3) by simp()), expand(rewrite(sym(d2), xr), mallocng.in_range), ncf))
    show by taut(xh, expand(rw, mallocng.m_rw), ns)
  qed
  have us := apply(mp.view_usable[vm := vm, fp := F, objs := objs, a := int_add(c.libc, 8), n := 8], arith(cf3), each)
  have inF: all i. i in omega -> int_lt(i, 8) -> int_add(int_add(c.libc, 8), i) in F proof
    fix i
    assume hi hil
    have e1 _ _ _ := mp(all_elim(each, {i}), hi, hil)
    show := e1
  qed
  have er := apply(mp.view_read[vm := vm, fp := F, a := int_add(c.libc, 8), n := 8], arith(cf3), simp(), simp(), inF)
  have la: mallocng.L_AUXV = 8 by defs(refl({8}), mallocng.L_AUXV)
  have _ m7 _ _ := mp(all_elim(each, {7}), simp(), simp())
  have lt: int_lt(int_add(c.libc, 16), int_pow(2, 64)) by arith(expand(m7, mallocng.m_mapped, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE), cf3)
  show by taut(us, trans(er, rewrite(la, fat)), lt)
qed

// (a byte of the auxiliary vector's ranges: held, readable, below the user
// space's end, not the stack's)
theorem mp.auxv_byte(c, A, vm, b, j, x): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  mallocng.holds_in(c, A, vm, b) -> A.init_done = 0 -> j in omega -> int_lt(j, seq_len(mallocng.auxv_ranges(A))) -> x in omega ->
  mallocng.in_range(x, mallocng.auxv_ranges(A)[j]) ->
  x in mallocng.held(c, A, b) && mallocng.m_mapped(mallocng.mview(vm, mallocng.held(c, A, b)), x) &&
  snd(mallocng.pg(mallocng.mview(vm, mallocng.held(c, A, b)), x)).prot.r && !(snd(mallocng.pg(mallocng.mview(vm, mallocng.held(c, A, b)), x)).kind = 2)
proof
  assume hc hu ha hb hh h0 hj hjl hx hr
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {hpo = perms, hfr = fresh} := expand(H, mallocng.holds)
  have {fac = auxv_ctx} := mp(expand(hfr, mallocng.fresh_ok), h0)
  have {pa = auxv} := expand(hpo, mallocng.perms_ok)
  have {rd = rodata, xl = auxv} := apply(mp.front_pieces, hc, hu, ha)
  have r1 r2 := expand(hr, mallocng.in_range)
  have nc := mp(all_elim(fac, {j}, {x}), conj(hj, hx), taut(hjl, r1, r2))
  have ncf: !mallocng.ctx_free(c, x) proof
    assume hf
    have ic: int_le(c.ctx, x) && int_lt(x, int_add(c.ctx, mallocng.CTX_SIZE))
      by defs(arith(expand(hf, mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK)), mallocng.CTX_SIZE)
    show by taut(ic, nc)
  qed
  have ir: mallocng.in_ranges(x, mallocng.auxv_ranges(A)) by defs(ex_intro({j}, taut(hj, hjl, hr)), mallocng.in_ranges)
  have q := apply(mp.ranges_r, rd, xl, ir)
  have xh := apply(mp.fresh_held[c := c, A := A, vm := vm, b := b, a := x], hc, hu, ha, hb, hh, h0, hx, q, ncf)
  have m1 m2 m3 := mp(all_elim(pa, {j}, {x}), conj(hj, hx), taut(hjl, r1, r2))
  show by taut(xh, m1, m2, m3)
qed

// libc's auxiliary vector readable, as get_random_secret reads it (the
// allocator not yet initialized)
theorem mp.am_auxv(c, A, vm, b, objs): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  mallocng.holds_in(c, A, vm, b) -> A.init_done = 0 -> vm.bytes in fn_space(bits(64), bits(8)) ->
  mallocng_specs.auxv_ok(vm, objs, c.libc)
proof
  assume hc hu ha hb hh h0 hvb
  let M := mallocng.mview(vm, mallocng.held(c, A, b))
  let F := mallocng.held(c, A, b)
  let L := A.auxv
  let AT := A.auxv_at
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {hfr = fresh} := expand(H, mallocng.holds)
  have {fal = auxv_len, fav = auxv, fae = auxv_end, fan = auxv_null} := mp(expand(hfr, mallocng.fresh_ok), h0)
  have lu le lb := apply(mp.libc_auxv[c := c, A := A, vm := vm, b := b, objs := objs], hc, hu, ha, hb, hh, h0)
  have cf3: c.libc in omega by simp(hc)
  have bl: bits_add(64, c.libc, 8) = int_add(c.libc, 8) by defs(arith(cf3, lb), bits_add, pow2)
  have ll: L in list_type(cart(omega, omega)) by simp(ha)
  have lo: seq_len(L) in omega by arith(ll)
  have ato: AT in omega by simp(ha)
  // (the ranges: the vector's 16-byte pairs, then each entry's AT_RANDOM bytes)
  let FB := fn_build(int_sub(seq_len(L), 0), x0. ite(fst(L[int_add(0, x0)]) = x86_64_linux.AT_RANDOM, pair(int_add(snd(L[int_add(0, x0)]), 8), 8), pair(0, 0)))
  have fbv: all x0. x0 in int_sub(seq_len(L), 0) -> ite(fst(L[int_add(0, x0)]) = x86_64_linux.AT_RANDOM, pair(int_add(snd(L[int_add(0, x0)]), 8), 8), pair(0, 0)) in univ(1) proof
    fix x0
    assume _
    show by simp(hu)
  qed
  have fbl := apply(build_list, (int_sub(seq_len(L), 0) in omega by arith(lo)), fbv)
  have ar: mallocng.auxv_ranges(A) = seq_concat(seq_one(pair(AT, int_mul(16, seq_len(L)))), FB) by defs(refl({mallocng.auxv_ranges(A)}), mallocng.auxv_ranges)
  have dd := fn_build_dom[d := int_sub(seq_len(L), 0), v := x0. ite(fst(L[int_add(0, x0)]) = x86_64_linux.AT_RANDOM, pair(int_add(snd(L[int_add(0, x0)]), 8), 8), pair(0, 0))]
  have fbn: seq_len(FB) = seq_len(L) by defs(arith(expand(dd, seq_len), expand(lo, seq_len)), seq_len)
  have arl: seq_len(mallocng.auxv_ranges(A)) = int_add(1, seq_len(L)) := rewrite(sym(ar), (seq_len(seq_concat(seq_one(pair(AT, int_mul(16, seq_len(L)))), FB)) = int_add(1, seq_len(L)) by arith(fbl, fbn)))
  have ar0: mallocng.auxv_ranges(A)[0] = pair(AT, int_mul(16, seq_len(L))) := rewrite(sym(ar), at({seq_concat(seq_one(pair(AT, int_mul(16, seq_len(L)))), FB)[0]}, fbl))
  have ba: gimple.bytes_at(vm, bits_add(64, c.libc, 8), 8) = AT := rewrite(sym(bl), le)
  let LA := gimple.bytes_at(vm, bits_add(64, c.libc, 8), 8)
  // (n bytes from p, all in the auxiliary vector's range j: usable, read as the view has them)
  have rng: all j p n. j in omega -> int_lt(j, seq_len(mallocng.auxv_ranges(A))) -> p in omega -> n in omega -> int_lt(0, n) -> int_le(n, 16) ->
      (all i. i in omega -> int_lt(i, n) -> mallocng.in_range(int_add(p, i), mallocng.auxv_ranges(A)[j])) ->
      gimple.usable(vm, objs, p, n, false) && gimple.bytes_at(vm, p, n) = mallocng.rd(M, p, n) && int_lt(int_add(p, n), int_pow(2, 64)) proof
    fix j p n
    assume hj hjl hp hn hn0 hn16 hin
    have each: all i. i in omega -> int_lt(i, n) -> int_add(p, i) in F && mallocng.m_mapped(M, int_add(p, i)) &&
        snd(mallocng.pg(M, int_add(p, i))).prot.r && !(snd(mallocng.pg(M, int_add(p, i))).kind = 2) proof
      fix i
      assume hi hil
      show := apply(mp.auxv_byte[c := c, A := A, vm := vm, b := b, j := j, x := int_add(p, i)], hc, hu, ha, hb, hh, h0, hj, hjl, arith(hp, hi), mp(all_elim(hin, {i}), hi, hil))
    qed
    have inF: all i. i in omega -> int_lt(i, n) -> int_add(p, i) in F proof
      fix i
      assume hi hil
      have e1 _ _ _ := mp(all_elim(each, {i}), hi, hil)
      show := e1
    qed
    have us := apply(mp.view_usable[vm := vm, fp := F, objs := objs, a := p, n := n], hp, each)
    have er := apply(mp.view_read[vm := vm, fp := F, a := p, n := n], hp, hn, arith(hn16), inF)
    have _ ml _ _ := mp(all_elim(each, {int_sub(n, 1)}), arith(hn0, hn), arith(hn0))
    have nb: int_lt(int_add(p, n), int_pow(2, 64)) by arith(expand(ml, mallocng.m_mapped, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE), hp, hn, hn0)
    show by taut(us, er, nb)
  qed
  have a0l: int_lt(0, seq_len(mallocng.auxv_ranges(A))) by arith(arl, lo)
  // each entry: its pair readable, as the view has it; AT_RANDOM's 8 bytes readable
  have ent: all x1. x1 in omega -> int_lt(x1, seq_len(L)) ->
      ((gimple.usable(vm, objs, int_add(AT, int_mul(16, x1)), 16, false) && gimple.bytes_at(vm, bits_of_int(64, int_add(AT, int_mul(16, x1))), 8) = fst(L[x1])) &&
        gimple.bytes_at(vm, bits_of_int(64, int_add(int_add(AT, int_mul(16, x1)), 8)), 8) = snd(L[x1])) &&
      (fst(L[x1]) = x86_64_linux.AT_RANDOM -> gimple.usable(vm, objs, int_add(snd(L[x1]), 8), 8, false)) proof
    fix k
    assume hk hkl
    let P := int_add(AT, int_mul(16, k))
    have po: P in omega by arith(ato, hk)
    have r0: all i. i in omega -> int_lt(i, 16) -> mallocng.in_range(int_add(P, i), mallocng.auxv_ranges(A)[0]) proof
      fix i
      assume hi hil
      show by defs(simp(ar0, (int_le(AT, int_add(P, i)) && int_lt(int_add(P, i), int_add(AT, int_mul(16, seq_len(L)))) by arith(hi, hil, hk, hkl, ato))), mallocng.in_range)
    qed
    have r8: all i. i in omega -> int_lt(i, 8) -> mallocng.in_range(int_add(int_add(P, 8), i), mallocng.auxv_ranges(A)[0]) proof
      fix i
      assume hi hil
      show by defs(simp(ar0, (int_le(AT, int_add(int_add(P, 8), i)) && int_lt(int_add(int_add(P, 8), i), int_add(AT, int_mul(16, seq_len(L)))) by arith(hi, hil, hk, hkl, ato))), mallocng.in_range)
    qed
    have r08: all i. i in omega -> int_lt(i, 8) -> mallocng.in_range(int_add(P, i), mallocng.auxv_ranges(A)[0]) proof
      fix i
      assume hi hil
      show := mp(all_elim(r0, {i}), hi, (int_lt(i, 16) by arith(hil)))
    qed
    have u16 _ n16 := mp(all_elim(rng, {0}, {P}, {16}), simp(), a0l, po, simp(), simp(), simp(), r0)
    have _ e0 _ := mp(all_elim(rng, {0}, {P}, {8}), simp(), a0l, po, simp(), simp(), simp(), r08)
    have _ e8 _ := mp(all_elim(rng, {0}, {int_add(P, 8)}, {8}), simp(), a0l, arith(po), simp(), simp(), simp(), r8)
    have bp: bits_of_int(64, P) = P by defs(arith(po, n16), bits_of_int, pow2)
    have bp8: bits_of_int(64, int_add(P, 8)) = int_add(P, 8) by defs(arith(po, n16), bits_of_int, pow2)
    have v0 v1 := mp(all_elim(fav, {k}), hk, hkl)
    have w0: gimple.bytes_at(vm, bits_of_int(64, P), 8) = fst(L[k]) := rewrite(sym(bp), trans(e0, v0))
    have w1: gimple.bytes_at(vm, bits_of_int(64, int_add(P, 8)), 8) = snd(L[k]) := rewrite(sym(bp8), trans(e8, v1))
    // (AT_RANDOM's: the range 1 + k)
    have rnd: fst(L[k]) = x86_64_linux.AT_RANDOM -> gimple.usable(vm, objs, int_add(snd(L[k]), 8), 8, false) proof
      assume hr
      let Q := int_add(snd(L[k]), 8)
      have lk := apply(at_type[l := L, t := cart(omega, omega), i := k], ll, hk, hkl)
      have _ s0 := apply(mp.cart_nat, lk)
      have qo: Q in omega by arith(s0)
      have kd: k in int_sub(seq_len(L), 0) by simp(hk, hkl, lo)
      have fk := app_fn_build[d := int_sub(seq_len(L), 0), v := x0. ite(fst(L[int_add(0, x0)]) = x86_64_linux.AT_RANDOM, pair(int_add(snd(L[int_add(0, x0)]), 8), 8), pair(0, 0)), a := k]
      have z0: int_add(0, k) = k by arith(hk)
      have fbk: FB[k] = pair(Q, 8) by simp(mp(fk, kd), hr, z0)
      have a1 := at({seq_concat(seq_one(pair(AT, int_mul(16, seq_len(L)))), FB)[int_add(1, k)]}, fbl, hk, (int_lt(int_add(1, k), int_add(1, seq_len(FB))) by arith(fbn, hkl)))
      have k1: int_sub(int_add(1, k), 1) = k by arith(hk)
      have ark: mallocng.auxv_ranges(A)[int_add(1, k)] = pair(Q, 8) := rewrite(sym(ar), trans(a1, (FB[int_sub(int_add(1, k), 1)] = pair(Q, 8) by simp(fbk, k1))))
      have rq: all i. i in omega -> int_lt(i, 8) -> mallocng.in_range(int_add(Q, i), mallocng.auxv_ranges(A)[int_add(1, k)]) proof
        fix i
        assume hi hil
        show by defs(simp(ark, (int_le(Q, int_add(Q, i)) && int_lt(int_add(Q, i), int_add(Q, 8)) by arith(hi, hil, qo))), mallocng.in_range)
      qed
      have uq _ _ := mp(all_elim(rng, {int_add(1, k)}, {Q}, {8}), arith(hk), arith(arl, hkl), qo, simp(), simp(), simp(), rq)
      show := uq
    qed
    show by taut(u16, w0, w1, rnd)
  qed
  have ent2 := rewrite(sym(ba), ent)
  have o1: ord_le(1, seq_len(L)) := fal
  show by defs(taut(lu, (ex x0. x0 in list_type(cart(omega, omega)) && (((ord_le(1, seq_len(x0)) && (all x1. x1 in omega -> int_lt(x1, seq_len(x0)) ->
      ((gimple.usable(vm, objs, int_add(LA, int_mul(16, x1)), 16, false) && gimple.bytes_at(vm, bits_of_int(64, int_add(LA, int_mul(16, x1))), 8) = fst(x0[x1])) &&
        gimple.bytes_at(vm, bits_of_int(64, int_add(int_add(LA, int_mul(16, x1)), 8)), 8) = snd(x0[x1])) &&
      (fst(x0[x1]) = x86_64_linux.AT_RANDOM -> gimple.usable(vm, objs, int_add(snd(x0[x1]), 8), 8, false)))) &&
      fst(x0[int_sub(seq_len(x0), 1)]) = x86_64_linux.AT_NULL) && (all x1. x1 in omega -> int_lt(int_add(x1, 1), seq_len(x0)) -> !(fst(x0[x1]) = x86_64_linux.AT_NULL)))
    by ex_intro({L}, taut(ll, o1, ent2, fae, fan)))), mallocng_specs.auxv_ok)
qed

// ----------------------------------------------------------------------
//  Steps in a row: memory untouched outside the allocator, its footprint
//  grown only by memory unmapped before

// (errno: the thread's word at fs_base + 0x34)
abbrev mp.errno(fs) := set_select(omega, x. int_le(int_add(fs, 52), x) && int_lt(x, int_add(fs, 56)))

// (the allocator grown only into memory unmapped before)
abbrev mp.grown(c, A2, A, b, vm) := all a. a in omega -> a in mallocng.footprint(c, A2, b) ->
  a in mallocng.footprint(c, A, b) || !x86_64_linux.mapped(vm, int_div(a, x86_64_linux.PAGE))

// (memory untouched outside the allocator twice, the allocator grown
// between only into memory unmapped before: untouched)
theorem mp.unt_grow(c, A, A1, b, V0, V1, V2, e): mallocng.untouched(c, A, b, V0, V1, e) -> mallocng.untouched(c, A1, b, V1, V2, e) ->
  mp.grown(c, A1, A, b, V0) -> mallocng.untouched(c, A, b, V0, V2, e)
proof
  assume u1 u2 fg
  have a1 b1 := expand(u1, mallocng.untouched)
  have a2 b2 := expand(u2, mallocng.untouched)
  have r: all x0. x0 in omega -> (!(x0 in mallocng.footprint(c, A, b)) && !(x0 in e)) && x86_64_linux.mapped(V0, int_div(x0, x86_64_linux.PAGE)) ->
      V2.bytes[bits_of_int(64, x0)] = V0.bytes[bits_of_int(64, x0)] && V2.pages[int_div(x0, x86_64_linux.PAGE)] = V0.pages[int_div(x0, x86_64_linux.PAGE)] proof
    fix a
    assume ha hq
    have q1 q2 q3 := hq
    have p1 pp1 := mp(all_elim(a1, {a}), ha, hq)
    have m1: x86_64_linux.mapped(V1, int_div(a, x86_64_linux.PAGE)) by defs(rewrite(sym(pp1), expand(q3, x86_64_linux.mapped)), x86_64_linux.mapped)
    have n1: !(a in mallocng.footprint(c, A1, b)) proof
      assume h1
      show by taut(mp(all_elim(fg, {a}), ha, h1), q1, q3)
    qed
    have p2 pp2 := mp(all_elim(a2, {a}), ha, conj(conj(n1, q2), m1))
    show by taut(trans(p2, p1), trans(pp2, pp1))
  qed
  show by defs(taut(r, trans(b2, b1)), mallocng.untouched)
qed

// (... the footprint grown so twice: so)
theorem mp.fp_grow(c, A, A1, A2, b, V0, V1, e): mallocng.untouched(c, A, b, V0, V1, e) -> mp.grown(c, A1, A, b, V0) -> mp.grown(c, A2, A1, b, V1) ->
  (all a. a in omega -> a in mallocng.footprint(c, A2, b) -> !(a in e)) -> mp.grown(c, A2, A, b, V0)
proof
  assume u1 f1 f2 ne
  have a1 _ := expand(u1, mallocng.untouched)
  fix a
  assume ha h2
  have c1: a in mallocng.footprint(c, A1, b) -> a in mallocng.footprint(c, A, b) || !x86_64_linux.mapped(V0, int_div(a, x86_64_linux.PAGE)) proof
    assume h
    show := mp(all_elim(f1, {a}), ha, h)
  qed
  have c2: !x86_64_linux.mapped(V1, int_div(a, x86_64_linux.PAGE)) -> a in mallocng.footprint(c, A, b) || !x86_64_linux.mapped(V0, int_div(a, x86_64_linux.PAGE)) proof
    assume hn
    have k: !(a in mallocng.footprint(c, A, b)) -> x86_64_linux.mapped(V0, int_div(a, x86_64_linux.PAGE)) -> false proof
      assume n0 m0
      have _ pp := mp(all_elim(a1, {a}), ha, conj(conj(n0, mp(all_elim(ne, {a}), ha, h2)), m0))
      have m1: x86_64_linux.mapped(V1, int_div(a, x86_64_linux.PAGE)) by defs(rewrite(sym(pp), expand(m0, x86_64_linux.mapped)), x86_64_linux.mapped)
      show by taut(m1, hn)
    qed
    show by taut(k)
  qed
  show by taut(mp(all_elim(f2, {a}), ha, h2), c1, c2)
qed

// (bytes outside the footprint changed, nothing else: the invariant kept --
// its view the same, the pages the same)
theorem mp.out_holds(c, A, vm, vm2, b): mallocng.holds_in(c, A, vm, b) -> fn_update(vm2, "bytes", vm.bytes) = vm ->
  (all x. x in bits(64) -> x in mallocng.footprint(c, A, b) -> vm2.bytes[x] = vm.bytes[x]) -> mallocng.holds_in(c, A, vm2, b)
proof
  assume hh er eb
  have {H = inv, hm = mapped, hfr = free, hrw = rw} := expand(hh, mallocng.holds_in)
  have up := mp(app_update_other[f := vm2, k := "bytes", v := vm.bytes, x := "pages"], (!("pages" = "bytes") by simp()))
  have ep: vm2.pages = vm.pages := sym(rewrite(er, up))
  have uk := mp(app_update_other[f := vm2, k := "bytes", v := vm.bytes, x := "brk"], (!("brk" = "bytes") by simp()))
  have ek: vm2.brk = vm.brk := sym(rewrite(er, uk))
  let FP := mallocng.held(c, A, b)
  have ag: all a. a in omega -> mallocng.mview(vm2, FP)[a] = mallocng.mview(vm, FP)[a] proof
    fix a
    assume hao
    have bt: a in FP -> vm2.bytes[bits_of_int(64, a)] = vm.bytes[bits_of_int(64, a)] proof
      assume hf
      have {hff = fp} := apply(mp.held_fp, hf)
      have lo := apply(mp.fp_low[c := c, A := A, vm := vm, b := b, a := a], hm, hff)
      have e: bits_of_int(64, a) = a by defs(arith(hao, lo), bits_of_int, pow2)
      have ab: a in bits(64) by arith(hao, lo)
      show := rewrite(sym(e), mp(all_elim(eb, {a}), ab, hff))
    qed
    show := apply(mp.view_agree[vm := vm, vm2 := vm2, fp := FP, a := a], hao, bt, ep)
  qed
  have ve := apply(mp.view_ext[vm := vm, vm2 := vm2, fp := FP], ag)
  have i2 := rewrite(sym(ek), rewrite(sym(ve), H))
  have m2 := apply(mp.fpm_pages, hm, ep)
  have fr2 := apply(mp.free_rw_pages[c := c, vm := vm, vm2 := vm2, F := mallocng.footprint(c, A, b)], hfr, ep)
  have rw2 := apply(mp.grp_rw_pg[c := c, A := A, vm := vm, vm2 := vm2, b := b], hrw, ep)
  show by defs(taut(i2, m2, fr2, rw2), mallocng.holds_in)
qed

// ----------------------------------------------------------------------
//  The run's states: the invariant for A1 on V, the groups and the taken
//  metas as at the entry (A, s), memory outside the allocator untouched
//  but errno, the footprint grown only by memory unmapped before, errno's
//  pages as they were

theorem mp.gk_refl(A): mallocng_specs.groups_kept(A, A)
proof
  have g: all g. g in omega -> mallocng.is_used(A, g) -> A.metas[g] = A.metas[g] proof
    fix g
    assume _ _
    show := refl({A.metas[g]})
  qed
  show by defs(taut(refl({A.used}), refl({A.slots}), refl({A.active}), g), mallocng_specs.groups_kept)
qed

theorem mp.gk_trans(A, A1, A2): mallocng_specs.groups_kept(A, A1) -> mallocng_specs.groups_kept(A1, A2) -> mallocng_specs.groups_kept(A, A2)
proof
  assume h1 h2
  have u1 s1 a1 m1 := expand(h1, mallocng_specs.groups_kept)
  have u2 s2 a2 m2 := expand(h2, mallocng_specs.groups_kept)
  have g: all g. g in omega -> mallocng.is_used(A, g) -> A2.metas[g] = A.metas[g] proof
    fix g
    assume go hu
    have hu1: mallocng.is_used(A1, g) by defs(rewrite(sym(u1), expand(hu, mallocng.is_used)), mallocng.is_used)
    show := trans(mp(all_elim(m2, {g}), go, hu1), mp(all_elim(m1, {g}), go, hu))
  qed
  show by defs(taut(trans(u2, u1), trans(s2, s1), trans(a2, a1), g), mallocng_specs.groups_kept)
qed

// errno's pages as at the entry
abbrev mp.am_epg(s, V) := all i. i in omega -> int_lt(i, 4) ->
  V.pages[int_div(int_add(int_add(s.fs_base, 52), i), x86_64_linux.PAGE)] = s.vm.pages[int_div(int_add(int_add(s.fs_base, 52), i), x86_64_linux.PAGE)]

abbrev mp.am_st(c, A, B, s, V, A1) := ((V in x86_64_linux.Vm && A1 in mallocng.Abs && A1 in univ(1)) && mallocng.holds_in(c, A1, V, B)) &&
  mallocng_specs.groups_kept(A, A1) && A1.taken = A.taken && mallocng.untouched(c, A, B, s.vm, V, mp.errno(s.fs_base)) &&
  (all a. a in omega -> a in mallocng.footprint(c, A1, B) -> a in mallocng.footprint(c, A, B) || !x86_64_linux.mapped(s.vm, int_div(a, x86_64_linux.PAGE))) &&
  mp.am_epg(s, V)

// (the entry's state)
theorem mp.am_st0(c, A, B, s): s.vm in x86_64_linux.Vm -> A in mallocng.Abs -> A in univ(1) -> mallocng.holds_in(c, A, s.vm, B) -> mp.am_st(c, A, B, s, s.vm, A)
proof
  assume hv ha hu hh
  have fg: all a. a in omega -> a in mallocng.footprint(c, A, B) -> a in mallocng.footprint(c, A, B) || !x86_64_linux.mapped(s.vm, int_div(a, x86_64_linux.PAGE)) proof
    fix a
    assume _ h
    show by taut(h)
  qed
  have ep: mp.am_epg(s, s.vm) proof
    fix i
    assume _ _
    show := refl({s.vm.pages[int_div(int_add(int_add(s.fs_base, 52), i), x86_64_linux.PAGE)]})
  qed
  show by taut(hv, ha, hu, hh, mp.gk_refl[A := A], refl({A.taken}), mp.unt_refl[c := c, A := A, b := B, vm := s.vm, e := mp.errno(s.fs_base)], fg, ep)
qed

// (errno apart from the entry's allocator, mapped: apart from a state's
// grown only into memory unmapped)
theorem mp.errno_out(c, A, A1, B, V0, fs): mallocng_specs.errno_apart(c, A, B, V0, fs) -> fs in bits(64) -> int_le(int_add(fs, 56), int_pow(2, 64)) ->
  mp.grown(c, A1, A, B, V0) -> all a. a in omega -> a in mallocng.footprint(c, A1, B) -> !(a in mp.errno(fs))
proof
  assume hea hfb hfl hg
  fix a
  assume ho hf
  assume he
  have e1 e2 := (int_le(int_add(fs, 52), a) && int_lt(a, int_add(fs, 56)) by simp(he))
  have eb: bits_add(64, fs, 52) = int_add(fs, 52) by defs(arith(hfb, hfl), bits_add, pow2)
  let i := int_sub(a, int_add(fs, 52))
  have io: i in omega by arith(e1, ho, hfb)
  have nf mp0 := mp(all_elim(expand(hea, mallocng_specs.errno_apart, mallocng_specs.errno_at), {i}), io, (int_lt(i, 4) by arith(e2)))
  have ai: int_add(bits_add(64, fs, 52), i) = a by arith(eb, hfb)
  have nf2 := rewrite(ai, nf)
  have mp2 := rewrite(ai, mp0)
  show by taut(mp(all_elim(hg, {a}), ho, hf), nf2, mp2)
qed

// (the entry's world with a run state's memory: a world)
theorem mp.am_world(s, V): s in abi.World -> s in univ(1) -> V in x86_64_linux.Vm -> fn_update(s, "vm", V) in abi.World && fn_update(s, "vm", V) in univ(1)
proof
  assume hw hu hv
  have vu := apply(x86.vm_univ, hv)
  have wW: fn_update(s, "vm", V) in abi.World by defs(simp(expand(hw, abi.World), hu, hv, vu), abi.World)
  show by taut(wW, (fn_update(s, "vm", V) in univ(1) by simp(hu, vu)))
qed

// (a run state's memory: the thread pointer sound)
theorem mp.am_thread(c, A, B, s, V, A1): mp.am_st(c, A, B, s, V, A1) -> s in abi.World -> abi.thread_ok(s.vm, s.fs_base) ->
  mallocng_specs.tls_apart(c, A, B, s.fs_base) -> abi.thread_ok(V, s.fs_base)
proof
  assume S hw ht htl
  have _ _ _ _ _ _ su _ _ := S
  have fsb: s.fs_base in bits(64) by simp(expand(hw, abi.World))
  have ne: all i. i in omega -> int_lt(i, 8) -> !(int_add(s.fs_base, i) in mp.errno(s.fs_base)) proof
    fix i
    assume hi hil
    assume he
    have e1 _ := (int_le(int_add(s.fs_base, 52), int_add(s.fs_base, i)) && int_lt(int_add(s.fs_base, i), int_add(s.fs_base, 56)) by simp(he))
    show by arith(e1, hil)
  qed
  show := apply(mp.tls_kept[c := c, A := A, b := B, V0 := s.vm, V1 := V, fs := s.fs_base, e := mp.errno(s.fs_base)], fsb, ht, htl, su, ne)
qed

// (a step from A1 on V to A2 on V2: the invariant, the groups and the
// taken metas as before, memory untouched outside A1's footprint but
// errno, the footprint A1's or unmapped before, errno's pages as before)
theorem mp.am_st_step(c, A, B, s, V, A1, V2, A2): mp.am_st(c, A, B, s, V, A1) ->
  (V2 in x86_64_linux.Vm && A2 in mallocng.Abs && A2 in univ(1)) -> mallocng.holds_in(c, A2, V2, B) ->
  mallocng_specs.groups_kept(A1, A2) -> A2.taken = A1.taken -> mallocng.untouched(c, A1, B, V, V2, mp.errno(s.fs_base)) ->
  (all a. a in omega -> a in mallocng.footprint(c, A2, B) -> a in mallocng.footprint(c, A1, B) || !x86_64_linux.mapped(V, int_div(a, x86_64_linux.PAGE))) ->
  (all a. a in omega -> a in mallocng.footprint(c, A2, B) -> !(a in mp.errno(s.fs_base))) ->
  mp.am_epg(s, V2) || (all i. i in omega -> int_lt(i, 4) ->
    V2.pages[int_div(int_add(int_add(s.fs_base, 52), i), x86_64_linux.PAGE)] = V.pages[int_div(int_add(int_add(s.fs_base, 52), i), x86_64_linux.PAGE)]) ->
  mp.am_st(c, A, B, s, V2, A2)
proof
  assume S ht hh hg hk hun hfp hne hep
  have _ _ _ _ sg sk su sf se := S
  have un := apply(mp.unt_grow[c := c, A := A, A1 := A1, b := B, V0 := s.vm, V1 := V, V2 := V2, e := mp.errno(s.fs_base)], su, hun, sf)
  have fg := apply(mp.fp_grow[c := c, A := A, A1 := A1, A2 := A2, b := B, V0 := s.vm, V1 := V, e := mp.errno(s.fs_base)], su, sf, hfp, hne)
  have ep: mp.am_epg(s, V2) proof
    have e2: (all i. i in omega -> int_lt(i, 4) ->
        V2.pages[int_div(int_add(int_add(s.fs_base, 52), i), x86_64_linux.PAGE)] = V.pages[int_div(int_add(int_add(s.fs_base, 52), i), x86_64_linux.PAGE)]) -> mp.am_epg(s, V2) proof
      assume he
      fix i
      assume hi hil
      show := trans(mp(all_elim(he, {i}), hi, hil), mp(all_elim(se, {i}), hi, hil))
    qed
    show by taut(hep, e2)
  qed
  show by taut(ht, hh, apply(mp.gk_trans, sg, hg), trans(hk, sk), un, fg, ep)
qed

// ----------------------------------------------------------------------
//  The first call: the secret and the init word written

// (the initialized state's footprint: the old one's, the auxiliary vector
// out)
theorem mp.fs_fp(c, A, vm, V1, b, s, a): mp.fspre(c, A, vm, V1, b, s) -> a in mallocng.footprint(c, mp.first(A, s), b) -> a in mallocng.footprint(c, A, b)
proof
  assume P h
  have f1 f2 f3 f4 f5 := (mallocng.in_ranges(a, mallocng.fp_ranges(c, mp.first(A, s))) && !(a in malloc.live_of(b)) && a in omega &&
      !mallocng.in_reserved(mp.first(A, s), a) && !mallocng.in_taken(mp.first(A, s), a) by simp(expand(h, mallocng.footprint, mallocng.fp_set),
      keep(mallocng.in_ranges, mallocng.fp_ranges, malloc.live_of, mallocng.in_reserved, mallocng.in_taken)))
  have q := apply(mp.fs_fpr[c := c, A := A, vm := vm, V1 := V1, b := b, s := s, a := a], P, f1)
  have r2: !mallocng.in_reserved(A, a) by defs(simp(expand(f4, mallocng.in_reserved)), mallocng.in_reserved)
  have t2: !mallocng.in_taken(A, a) by defs(simp(expand(f5, mallocng.in_taken)), mallocng.in_taken)
  show by defs(simp(q, f2, f3, r2, t2, keep(mallocng.in_ranges, mallocng.fp_ranges, malloc.live_of, mallocng.in_reserved, mallocng.in_taken)), mallocng.footprint, mallocng.fp_set)
qed

// the first call's state: the secret sec at the context's word 0, its
// init word 1 -- the initialized state, a run state from the entry's
theorem mp.am_init_st(c, A, B, s, sec): c in mallocng.Cfg -> s in abi.World -> s in univ(1) -> A in mallocng.Abs -> A in univ(1) ->
  B in fn_space(bits(64), option(omega)) -> mallocng.holds_in(c, A, s.vm, B) -> A.init_done = 0 -> sec in bits(64) ->
  mallocng_specs.errno_apart(c, A, B, s.vm, s.fs_base) -> int_le(int_add(s.fs_base, 56), int_pow(2, 64)) -> int_le(int_add(c.ctx, 928), 18446744073709551616) ->
  mp.am_st(c, A, B, s, fn_update(s.vm, "bytes", x86_64_linux.store_le(x86_64_linux.store_le(s.vm.bytes, int_add(c.ctx, 0), 8, sec), int_add(c.ctx, 8), 4, 1)),
    mp.first(A, sec)) && !(mp.first(A, sec).init_done = 0)
proof
  assume hc hw hu ha hau hb hh h0 hsb hea hfl hcb
  let V0 := s.vm
  let Va := fn_update(V0, "bytes", x86_64_linux.store_le(V0.bytes, int_add(c.ctx, 0), 8, sec))
  let V1 := fn_update(V0, "bytes", x86_64_linux.store_le(x86_64_linux.store_le(V0.bytes, int_add(c.ctx, 0), 8, sec), int_add(c.ctx, 8), 4, 1))
  have vV vfun vdom vb := apply(ms.world_parts, hw)
  have cx: c.ctx in omega by simp(expand(hc, mallocng.Cfg))
  have c0: int_add(c.ctx, 0) = c.ctx by arith(cx)
  have cb: c.ctx in bits(64) by arith(cx, hcb)
  have c8b: int_add(c.ctx, 8) in bits(64) by arith(cx, hcb)
  have e1: V1 = fn_update(Va, "bytes", x86_64_linux.store_le(Va.bytes, int_add(c.ctx, 8), 4, 1)) by simp()
  // (V1: a memory)
  have w1W w1u := apply(tr.world_store, {s}, {int_add(c.ctx, 0)}, {8}, {sec}, hw, hu, (int_add(c.ctx, 0) in bits(64) by arith(cx, hcb)))
  have w2W w2u := apply(tr.world_store, {fn_update(s, "vm", Va)}, {int_add(c.ctx, 8)}, {4}, {1}, w1W, w1u, c8b)
  have {v1v = mem} := apply(ms.world_parts, w2W)
  have v1V: V1 in x86_64_linux.Vm by simp(v1v, e1)
  // (its bytes: V0's but the context's first 12)
  have vab: Va.bytes in fn_space(bits(64), bits(8)) by simp(apply(x86.store_typed, {V0.bytes}, {int_add(c.ctx, 0)}, {8}, {sec}, vb))
  have by1: all y. y in bits(64) -> !(int_le(c.ctx, y) && int_lt(y, int_add(c.ctx, 12))) -> V1.bytes[y] = V0.bytes[y] proof
    fix y
    assume hy hn
    have o2 := apply(mp.st_out[B := Va.bytes, c := int_add(c.ctx, 8), k := 4, v := 1, x := y], hy, c8b, simp(), arith(cx, hcb), arith(hn, hy, cx))
    have o1 := apply(mp.st_out[B := V0.bytes, c := int_add(c.ctx, 0), k := 8, v := sec, x := y], hy, arith(cx, hcb), simp(), arith(cx, hcb), arith(hn, hy, cx))
    show by simp(o2, o1)
  qed
  have rest: fn_update(V1, "bytes", V0.bytes) = V0 by simp(mp(fn_update_same[f := V0, k := "bytes"], (is_fun(V0) by simp(expand(vV, x86_64_linux.Vm))), ("bytes" in dom(V0) by simp(expand(vV, x86_64_linux.Vm)))))
  // (the words written)
  have r8 := apply(mp.rd_out[vm := Va, c := int_add(c.ctx, 8), k := 4, v := 1, a := c.ctx, n := 8], cx, simp(), c8b, simp(), arith(cx, hcb), arith(cx, hcb), arith(cx))
  have r0 := apply(mp.rd_at8[vm := V0, c := c.ctx, v := sec], vb, cb, hsb)
  have ba0: bits_add(64, c.ctx, 0) = c.ctx by defs(arith(cb), bits_add, pow2)
  have ea: Va = mallocng_specs.wr64(V0, c.ctx, sec) by simp(all_elim(ms.v_wr64, {V0}, {c.ctx}, {sec}), c0, ba0)
  have w0: gimple.bytes_at(V1, c.ctx, 8) = sec := trans(rewrite(sym(e1), r8), rewrite(sym(ea), r0))
  have r4 := apply(mp.rd_at4[vm := Va, c := int_add(c.ctx, 8), v := 1], vab, c8b, simp())
  have w8: gimple.bytes_at(V1, int_add(c.ctx, 8), 4) = 1 := rewrite(sym(e1), (gimple.bytes_at(fn_update(Va, "bytes", x86_64_linux.store_le(Va.bytes, int_add(c.ctx, 8), 4, 1)), int_add(c.ctx, 8), 4) = 1 by simp(r4)))
  // the initialized state
  have so: sec in omega by arith(hsb)
  have P: mp.fspre(c, A, V0, V1, B, sec) by taut(hc, hau, ha, hb, vV, v1V, hh, h0, so, by1, rest, w0, w8)
  have hh1 := apply(mp.fs_holds_in, P)
  have {ta = abs, tu = univ} := apply(mp.first_type, ha, so)
  have gk: mallocng_specs.groups_kept(A, mp.first(A, sec)) by defs(simp(), mallocng_specs.groups_kept)
  have tk: mp.first(A, sec).taken = A.taken by simp()
  have ep: V1.pages = V0.pages by simp()
  have un: mallocng.untouched(c, A, B, V0, V1, mp.errno(s.fs_base)) proof
    have r: all x0. x0 in omega -> (!(x0 in mallocng.footprint(c, A, B)) && !(x0 in mp.errno(s.fs_base))) && x86_64_linux.mapped(V0, int_div(x0, x86_64_linux.PAGE)) ->
        V1.bytes[bits_of_int(64, x0)] = V0.bytes[bits_of_int(64, x0)] && V1.pages[int_div(x0, x86_64_linux.PAGE)] = V0.pages[int_div(x0, x86_64_linux.PAGE)] proof
      fix a
      assume ho hq
      have n1 _ m0 := hq
      have ml _ := expand(m0, x86_64_linux.mapped)
      have ab: bits_of_int(64, a) = a by defs(arith(ho, expand(ml, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)), bits_of_int, pow2)
      have nc: !(int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, 12))) proof
        assume hin2
        have i1 i2 := hin2
        have fp := apply(mp.ctx_fp[c := c, A := A, vm := V0, b := B, a := a], hc, hau, ha, hh, ho, i1, (int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE)) by defs(arith(i2), mallocng.CTX_SIZE)))
        show by taut(fp, n1)
      qed
      have bb := mp(all_elim(by1, {bits_of_int(64, a)}), (bits_of_int(64, a) in bits(64) by simp()), rewrite(sym(ab), nc))
      show by taut(bb, (V1.pages[int_div(a, x86_64_linux.PAGE)] = V0.pages[int_div(a, x86_64_linux.PAGE)] by simp(ep)))
    qed
    show by defs(taut(r, (V1.brk_start = V0.brk_start by simp())), mallocng.untouched)
  qed
  have gr: mp.grown(c, mp.first(A, sec), A, B, V0) proof
    fix a
    assume ho hf
    show by taut(apply(mp.fs_fp[c := c, A := A, vm := V0, V1 := V1, b := B, s := sec, a := a], P, hf))
  qed
  have fsb: s.fs_base in bits(64) by simp(expand(hw, abi.World))
  have st0 := apply(mp.am_st0[c := c, A := A, B := B, s := s], vV, ha, hau, hh)
  have eo := apply(mp.errno_out[c := c, A := A, A1 := mp.first(A, sec), B := B, V0 := V0, fs := s.fs_base], hea, fsb, hfl, gr)
  have epg: all i. i in omega -> int_lt(i, 4) ->
      V1.pages[int_div(int_add(int_add(s.fs_base, 52), i), x86_64_linux.PAGE)] = V0.pages[int_div(int_add(int_add(s.fs_base, 52), i), x86_64_linux.PAGE)] proof
    fix i
    assume _ _
    show by simp(ep)
  qed
  have st1 := apply(mp.am_st_step[c := c, A := A, B := B, s := s, V := V0, A1 := A, V2 := V1, A2 := mp.first(A, sec)], st0, taut(v1V, ta, tu), hh1, gk, tk, un, gr, eo, taut(epg))
  show by taut(st1, (!(mp.first(A, sec).init_done = 0) by simp()))
qed

// (only errno's bytes changed in a run state: a run state)
theorem mp.am_errb(c, A, B, s, V, A1, V2): mp.am_st(c, A, B, s, V, A1) -> s in abi.World ->
  mallocng_specs.errno_apart(c, A, B, s.vm, s.fs_base) -> int_le(int_add(s.fs_base, 56), int_pow(2, 64)) ->
  V2 in x86_64_linux.Vm -> fn_update(V2, "bytes", V.bytes) = V -> (all x. x in bits(64) -> !(x in mp.errno(s.fs_base)) -> V2.bytes[x] = V.bytes[x]) ->
  mp.am_st(c, A, B, s, V2, A1)
proof
  assume S hw hea hfl v2V rest out
  have s1 s2 s3 s4 _ _ _ sgr _ := S
  have fsb: s.fs_base in bits(64) by simp(expand(hw, abi.World))
  have eo := apply(mp.errno_out[c := c, A := A, A1 := A1, B := B, V0 := s.vm, fs := s.fs_base], hea, fsb, hfl, sgr)
  have hfp: all x. x in bits(64) -> x in mallocng.footprint(c, A1, B) -> V2.bytes[x] = V.bytes[x] proof
    fix x
    assume hx hf
    have xo: x in omega by arith(hx)
    show := mp(all_elim(out, {x}), hx, mp(all_elim(eo, {x}), xo, hf))
  qed
  have hh2 := apply(mp.out_holds[c := c, A := A1, vm := V, vm2 := V2, b := B], s4, rest, hfp)
  have u1 := mp(app_update_other[f := V2, k := "bytes", v := V.bytes, x := "pages"], (!("pages" = "bytes") by simp()))
  have u2 := mp(app_update_other[f := V2, k := "bytes", v := V.bytes, x := "brk_start"], (!("brk_start" = "bytes") by simp()))
  have ep: V2.pages = V.pages := sym(rewrite(rest, u1))
  have eb: V2.brk_start = V.brk_start := sym(rewrite(rest, u2))
  have un: mallocng.untouched(c, A1, B, V, V2, mp.errno(s.fs_base)) proof
    have r: all x0. x0 in omega -> (!(x0 in mallocng.footprint(c, A1, B)) && !(x0 in mp.errno(s.fs_base))) && x86_64_linux.mapped(V, int_div(x0, x86_64_linux.PAGE)) ->
        V2.bytes[bits_of_int(64, x0)] = V.bytes[bits_of_int(64, x0)] && V2.pages[int_div(x0, x86_64_linux.PAGE)] = V.pages[int_div(x0, x86_64_linux.PAGE)] proof
      fix a
      assume ho hq
      have _ n2 m0 := hq
      have ml _ := expand(m0, x86_64_linux.mapped)
      have ab: bits_of_int(64, a) = a by defs(arith(ho, expand(ml, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)), bits_of_int, pow2)
      have bb := rewrite(sym(ab), mp(all_elim(out, {a}), (a in bits(64) by arith(ho, expand(ml, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))), n2))
      show by taut(bb, (V2.pages[int_div(a, x86_64_linux.PAGE)] = V.pages[int_div(a, x86_64_linux.PAGE)] by simp(ep)))
    qed
    show by defs(taut(r, eb), mallocng.untouched)
  qed
  have fg: all a. a in omega -> a in mallocng.footprint(c, A1, B) -> a in mallocng.footprint(c, A1, B) || !x86_64_linux.mapped(V, int_div(a, x86_64_linux.PAGE)) proof
    fix a
    assume _ h
    show by taut(h)
  qed
  have epg: all i. i in omega -> int_lt(i, 4) ->
      V2.pages[int_div(int_add(int_add(s.fs_base, 52), i), x86_64_linux.PAGE)] = V.pages[int_div(int_add(int_add(s.fs_base, 52), i), x86_64_linux.PAGE)] proof
    fix i
    assume _ _
    show by simp(ep)
  qed
  show := apply(mp.am_st_step[c := c, A := A, B := B, s := s, V := V, A1 := A1, V2 := V2, A2 := A1], S, taut(v2V, s2, s3), hh2, mp.gk_refl[A := A1], refl({A1.taken}), un, fg, eo, taut(epg))
qed

// (errno written in a run state: a run state)
theorem mp.am_errw(c, A, B, s, V, A1, e): mp.am_st(c, A, B, s, V, A1) -> s in abi.World ->
  mallocng_specs.errno_apart(c, A, B, s.vm, s.fs_base) -> int_le(int_add(s.fs_base, 56), int_pow(2, 64)) ->
  mp.am_st(c, A, B, s, mallocng_specs.wr32(V, mallocng_specs.errno_at(s.fs_base), e), A1)
proof
  assume S hw hea hfl
  have s1 _ _ _ _ _ _ _ _ := S
  let V2 := mallocng_specs.wr32(V, mallocng_specs.errno_at(s.fs_base), e)
  have fsb: s.fs_base in bits(64) by simp(expand(hw, abi.World))
  have ea: mallocng_specs.errno_at(s.fs_base) = int_add(s.fs_base, 52) by defs(arith(fsb, hfl), mallocng_specs.errno_at, bits_add, pow2)
  have eab: int_add(s.fs_base, 52) in bits(64) by arith(fsb, hfl)
  // (bytes outside errno: V's)
  have out: all x. x in bits(64) -> !(x in mp.errno(s.fs_base)) -> V2.bytes[x] = V.bytes[x] proof
    fix x
    assume hx hn
    have o: int_le(int_add(int_add(s.fs_base, 52), 4), x) || int_lt(x, int_add(s.fs_base, 52)) proof
      have k: !(int_le(int_add(s.fs_base, 52), x) && int_lt(x, int_add(s.fs_base, 56))) proof
        assume q
        have q1 q2 := q
        show by taut(hn, (x in mp.errno(s.fs_base) by simp(q1, q2, (x in omega by arith(hx)))))
      qed
      show by arith(k, hx)
    qed
    show := rewrite(sym(ea), apply(mp.wr32_out[V := V, c := int_add(s.fs_base, 52), v := e, x := x], hx, eab, arith(fsb, hfl), o))
  qed
  have rest: fn_update(V2, "bytes", V.bytes) = V by simp(mp(fn_update_same[f := V, k := "bytes"], simp(expand(s1, x86_64_linux.Vm)), simp(expand(s1, x86_64_linux.Vm))), keep(mallocng_specs.errno_at), all_elim(ms.v_wr32, {V}, {mallocng_specs.errno_at(s.fs_base)}, {e}))
  have v2V := apply(mp.w32_vm[V := V, c := mallocng_specs.errno_at(s.fs_base), v := e], s1)
  show := apply(mp.am_errb, S, hw, hea, hfl, v2V, rest, out)
qed

// (memory usable through the same pages: usable)
theorem mp.usable_pg(vm, vm2, objs, a, n, w): (all i. i in omega -> int_lt(i, n) ->
    vm2.pages[int_div(int_add(a, i), x86_64_linux.PAGE)] = vm.pages[int_div(int_add(a, i), x86_64_linux.PAGE)]) ->
  gimple.usable(vm, objs, a, n, w) -> gimple.usable(vm2, objs, a, n, w)
proof
  assume he hu
  have hu2 := expand(hu, gimple.usable)
  have each: all i. i in omega -> int_lt(i, n) ->
      ite(x86_64_linux.mapped(vm2, int_div(int_add(a, i), x86_64_linux.PAGE)) && !(snd(vm2.pages[int_div(int_add(a, i), x86_64_linux.PAGE)]).kind = 2),
        ite(w, snd(vm2.pages[int_div(int_add(a, i), x86_64_linux.PAGE)]).prot.w, snd(vm2.pages[int_div(int_add(a, i), x86_64_linux.PAGE)]).prot.r),
        int_lt(int_add(a, i), int_pow(2, 64)) && int_add(a, i) in objs) proof
    fix i
    assume hi hil
    have e := mp(all_elim(he, {i}), hi, hil)
    have b := mp(all_elim(hu2, {i}), hi, hil)
    show by defs(simp(expand(b, x86_64_linux.mapped), e), x86_64_linux.mapped)
  qed
  show by defs(each, gimple.usable)
qed

// (errno in a run state: mapped)
theorem mp.am_emapped(c, A, B, s, V, A1, a): mp.am_st(c, A, B, s, V, A1) -> mallocng_specs.errno_apart(c, A, B, s.vm, s.fs_base) -> s.fs_base in bits(64) ->
  int_le(int_add(s.fs_base, 56), int_pow(2, 64)) -> a in mp.errno(s.fs_base) -> x86_64_linux.mapped(V, int_div(a, x86_64_linux.PAGE))
proof
  assume S hea hfb hfl he
  have _ _ _ _ _ _ _ _ sep := S
  have ao e1 e2 := (a in omega && int_le(int_add(s.fs_base, 52), a) && int_lt(a, int_add(s.fs_base, 56)) by simp(he))
  have eb: bits_add(64, s.fs_base, 52) = int_add(s.fs_base, 52) by defs(arith(hfb, hfl), bits_add, pow2)
  let i := int_sub(a, int_add(s.fs_base, 52))
  have io: i in omega by arith(e1, ao, hfb)
  have _ mp0 := mp(all_elim(expand(hea, mallocng_specs.errno_apart, mallocng_specs.errno_at), {i}), io, (int_lt(i, 4) by arith(e2)))
  have ai: int_add(bits_add(64, s.fs_base, 52), i) = a by arith(eb, hfb)
  have ai2: int_add(int_add(s.fs_base, 52), i) = a by arith(hfb)
  have m0 := rewrite(ai, mp0)
  have pe := rewrite(ai2, mp(all_elim(sep, {i}), io, (int_lt(i, 4) by arith(e2))))
  have ml mn := expand(m0, x86_64_linux.mapped)
  show by defs(taut(ml, rewrite(sym(pe), mn)), x86_64_linux.mapped)
qed

// (memory of a run state touched outside the allocator only at errno, its
// mapped pages as they were: the thread pointer sound, errno usable)
theorem mp.am_side(c, A, B, s, V1, A1, V): mp.am_st(c, A, B, s, V1, A1) -> s in abi.World -> abi.thread_ok(s.vm, s.fs_base) ->
  mallocng_specs.tls_apart(c, A, B, s.fs_base) -> mallocng_specs.errno_ok(s.vm, s.objs, s.fs_base) -> mallocng_specs.errno_apart(c, A, B, s.vm, s.fs_base) ->
  mallocng.untouched(c, A1, B, V1, V, mp.errno(s.fs_base)) -> (all q. q in omega -> x86_64_linux.mapped(V1, q) -> V.pages[q] = V1.pages[q]) ->
  thread: abi.thread_ok(V, s.fs_base) && errno: mallocng_specs.errno_ok(V, s.objs, s.fs_base)
proof
  assume S hw ht htl heo hea hun hpg
  have _ _ _ _ _ _ su sgr sep := S
  have fsb: s.fs_base in bits(64) by simp(expand(hw, abi.World))
  have efl eus _ := expand(heo, mallocng_specs.errno_ok)
  have hfl: int_le(int_add(s.fs_base, 56), int_pow(2, 64)) by arith(efl, fsb)
  have un := apply(mp.unt_grow[c := c, A := A, A1 := A1, b := B, V0 := s.vm, V1 := V1, V2 := V, e := mp.errno(s.fs_base)], su, hun, sgr)
  have ne: all i. i in omega -> int_lt(i, 8) -> !(int_add(s.fs_base, i) in mp.errno(s.fs_base)) proof
    fix i
    assume hi hil
    assume he
    have e1 _ := (int_le(int_add(s.fs_base, 52), int_add(s.fs_base, i)) && int_lt(int_add(s.fs_base, i), int_add(s.fs_base, 56)) by simp(he))
    show by arith(e1, hil)
  qed
  have th := apply(mp.tls_kept[c := c, A := A, b := B, V0 := s.vm, V1 := V, fs := s.fs_base, e := mp.errno(s.fs_base)], fsb, ht, htl, un, ne)
  have ea: mallocng_specs.errno_at(s.fs_base) = int_add(s.fs_base, 52) by defs(arith(fsb, hfl), mallocng_specs.errno_at, bits_add, pow2)
  have pe: all i. i in omega -> int_lt(i, 4) ->
      V.pages[int_div(int_add(mallocng_specs.errno_at(s.fs_base), i), x86_64_linux.PAGE)] = s.vm.pages[int_div(int_add(mallocng_specs.errno_at(s.fs_base), i), x86_64_linux.PAGE)] proof
    fix i
    assume hi hil
    let a := int_add(int_add(s.fs_base, 52), i)
    have he: a in mp.errno(s.fs_base) by simp((a in omega && int_le(int_add(s.fs_base, 52), a) && int_lt(a, int_add(s.fs_base, 56)) by arith(hi, hil, fsb)))
    have mm := apply(mp.am_emapped[c := c, A := A, B := B, s := s, V := V1, A1 := A1, a := a], S, hea, fsb, hfl, he)
    have p1 := mp(all_elim(hpg, {int_div(a, x86_64_linux.PAGE)}), (int_div(a, x86_64_linux.PAGE) in omega by defs(arith(hi, fsb), x86_64_linux.PAGE)), mm)
    have p2 := mp(all_elim(sep, {i}), hi, hil)
    show := rewrite(sym(ea), trans(p1, p2))
  qed
  have us := apply(mp.usable_pg[vm := s.vm, vm2 := V, objs := s.objs, a := mallocng_specs.errno_at(s.fs_base), n := 4, w := true], pe, eus)
  show by taut(th, (mallocng_specs.errno_ok(V, s.objs, s.fs_base) by defs(taut(efl, us, th), mallocng_specs.errno_ok)))
qed

// (a run state: the thread pointer sound, errno usable)
theorem mp.am_eok(c, A, B, s, V, A1): mp.am_st(c, A, B, s, V, A1) -> s in abi.World -> abi.thread_ok(s.vm, s.fs_base) ->
  mallocng_specs.tls_apart(c, A, B, s.fs_base) -> mallocng_specs.errno_ok(s.vm, s.objs, s.fs_base) -> mallocng_specs.errno_apart(c, A, B, s.vm, s.fs_base) ->
  thread: abi.thread_ok(V, s.fs_base) && errno: mallocng_specs.errno_ok(V, s.objs, s.fs_base)
proof
  assume S hw ht htl heo hea
  have pq: all q. q in omega -> x86_64_linux.mapped(V, q) -> V.pages[q] = V.pages[q] proof
    fix q
    assume _ _
    show := refl({V.pages[q]})
  qed
  show := apply(mp.am_side[c := c, A := A, B := B, s := s, V1 := V, A1 := A1, V := V], S, hw, ht, htl, heo, hea,
    mp.unt_refl[c := c, A := A1, b := B, vm := V, e := mp.errno(s.fs_base)], pq)
qed

// (the meta m's bytes: the allocator's at the entry, or unmapped then)
abbrev mp.am_mfp(c, A, B, s, m) := !(m = 0) ->
  (all a. a in omega -> int_le(m, a) && int_lt(a, int_add(m, mallocng.META_SIZE)) -> a in mallocng.footprint(c, A, B) || !x86_64_linux.mapped(s.vm, int_div(a, x86_64_linux.PAGE)))

// alloc_meta's outcome from a state A2 on V2, the meta m returned (0 for
// none), as its spec has it
abbrev mp.am_post(c, A, B, s, A2, V2, m) := ((A2 in mallocng.Abs && A2 in univ(1)) && mallocng_specs.groups_kept(A, A2)) && m in bits(64) &&
  ((m = 0 && A2.taken = A.taken) || (!(m = 0) && A2.taken = seq_concat(A.taken, seq_one(m)))) &&
  V2 in x86_64_linux.Vm && mallocng.holds_in(c, A2, V2, B) && mallocng.untouched(c, A, B, s.vm, V2, mp.errno(s.fs_base)) &&
  mp.grown(c, A2, A, B, s.vm) && (!(m = 0) -> mallocng_specs.meta_ready(V2, m)) && mp.am_epg(s, V2) && mp.am_mfp(c, A, B, s, m)

// ----------------------------------------------------------------------
//  The free metas' head taken (dequeue_head): nothing outside touched

// (a run state: the outcome returning 0)
theorem mp.am_ret0(c, A, B, s, V, A1): mp.am_st(c, A, B, s, V, A1) -> mp.am_post(c, A, B, s, A1, V, 0)
proof
  assume S
  have s1 s2 s3 s4 s5 s6 s7 s8 s9 := S
  have nz: !(0 = 0) -> mallocng_specs.meta_ready(V, 0) proof
    assume h
    show by taut(h, refl({0}))
  qed
  have nf: mp.am_mfp(c, A, B, s, 0) proof
    assume h
    show by taut(h, refl({0}))
  qed
  show by taut(s1, s2, s3, s4, s5, s6, s7, s8, s9, (0 in bits(64) by simp()), refl({0}), nz, nf)
qed

// (GIMPLE's 8-byte store in a world: as ms.st32_det, its memory's record
// facts from the world)
theorem mp.st64w_det: all s p off v. s in abi.World -> s in univ(1) -> p in bits(64) -> off in bits(32) -> g.mem_defined(s, p, off, 8, true) ->
  g.det(gimple.st64(p, off, v), s, ok(fn_update(s, "vm", fn_update(s.vm, "bytes", x86_64_linux.store_le(s.vm.bytes, int_add(p, off), 8, v))), empty))
proof
  fix s p off v
  assume hw hs hp ho hd
  have pv pf pd .. := apply(ms.world_parts, hw)
  show := apply(g.st64_det, {s}, {p}, {off}, {v}, hs, hp, ho, hd, pv, pf, pd)
qed

// (a memory with bytes B, B then written: a memory -- a closure for the
// memory procedure, as ms.sw_st for worlds)
theorem mp.vm_st: all V B a n v. fn_update(V, "bytes", B) in x86_64_linux.Vm -> fn_update(V, "bytes", x86_64_linux.store_le(B, a, n, v)) in x86_64_linux.Vm
proof
  fix V B a n v
  assume h
  show by simp(mp(all_elim(ms.wr_any, {fn_update(V, "bytes", B)}, {a}, {n}, {v}), h))
qed

mem_closure mp.vm_st

// (two memories alike but for their bytes, pages and break)
theorem mp.vm_rest(V, W): V in x86_64_linux.Vm -> W in x86_64_linux.Vm -> V.stack_top = W.stack_top -> V.stack_limit = W.stack_limit -> V.brk_start = W.brk_start ->
  fn_update(fn_update(fn_update(V, "bytes", W.bytes), "pages", W.pages), "brk", W.brk) = W
proof
  assume hv hw e1 e2 e3
  let K6 := insert("pages", insert("bytes", insert("stack_top", insert("stack_limit", insert("brk_start", insert("brk", empty))))))
  have vf vd := (is_fun(V) && dom(V) = K6 by simp(expand(hv, x86_64_linux.Vm)))
  have wf wd := (is_fun(W) && dom(W) = K6 by simp(expand(hw, x86_64_linux.Vm)))
  let U1 := fn_update(V, "bytes", W.bytes)
  let U2 := fn_update(U1, "pages", W.pages)
  let U := fn_update(U2, "brk", W.brk)
  have f1 d1 := mp(fn_update_fd[f := V, k := "bytes", v := W.bytes, d := K6], vf, vd, simp())
  have f2 d2 := mp(fn_update_fd[f := U1, k := "pages", v := W.pages, d := K6], f1, d1, simp())
  have f3 d3 := mp(fn_update_fd[f := U2, k := "brk", v := W.brk, d := K6], f2, d2, simp())
  have ag: all k. k in dom(U) -> U[k] = W[k] proof
    fix k
    assume hk
    have kk: k = "pages" || k = "bytes" || k = "stack_top" || k = "stack_limit" || k = "brk_start" || k = "brk" by simp(rewrite(d3, hk))
    have c1: k = "pages" -> U[k] = W[k] proof
      assume e
      show by simp(e)
    qed
    have c2: k = "bytes" -> U[k] = W[k] proof
      assume e
      show by simp(e)
    qed
    have c3: k = "stack_top" -> U[k] = W[k] proof
      assume e
      show by simp(e, e1)
    qed
    have c4: k = "stack_limit" -> U[k] = W[k] proof
      assume e
      show by simp(e, e2)
    qed
    have c5: k = "brk_start" -> U[k] = W[k] proof
      assume e
      show by simp(e, e3)
    qed
    have c6: k = "brk" -> U[k] = W[k] proof
      assume e
      show by simp(e)
    qed
    show by taut(kk, c1, c2, c3, c4, c5, c6)
  qed
  show := mp(rec_ext[a := U, b := W], f3, wf, trans(d3, sym(wd)), ag)
qed

// (a refill from a run state: a run state)
theorem mp.am_rf(c, A, B, s, V, A1, V2, R2, Kc, Bk): mp.am_st(c, A, B, s, V, A1) -> s in abi.World ->
  mallocng_specs.errno_apart(c, A, B, s.vm, s.fs_base) -> int_le(int_add(s.fs_base, 56), int_pow(2, 64)) ->
  mp.rfpre(c, A1, V, V2, B, R2, Kc, Bk) -> mp.am_st(c, A, B, s, V2, mp.refill(A1, R2, Kc, Bk))
proof
  assume S hw hea hfl P
  have {hc = cfg, hu = univ, ha = abs, hvv = vm, hv2 = v1, hh = holds, hn = nat, hfr = fresh, hpg = pages, hby = bytes, hre = rest} := P
  have hr2 hk hb := hn
  let A2 := mp.refill(A1, R2, Kc, Bk)
  have {ta = abs, tu = univ} := apply(mp.refill_type, ha, hr2, hk, hb)
  have hh2 := apply(mp.rf_holds_in, P)
  have gk: mallocng_specs.groups_kept(A1, A2) by defs(simp(), mallocng_specs.groups_kept)
  have tk: A2.taken = A1.taken by simp()
  have cx: c.ctx in omega by simp(expand(hc, mallocng.Cfg))
  have fsb: s.fs_base in bits(64) by simp(expand(hw, abi.World))
  have q0: fn_update(fn_update(fn_update(V2, "bytes", V.bytes), "pages", V.pages), "brk", V.brk).brk_start = V.brk_start := rewrite(sym(hre), refl({V.brk_start}), {1})
  have ebs: V2.brk_start = V.brk_start by simp(q0)
  have un: mallocng.untouched(c, A1, B, V, V2, mp.errno(s.fs_base)) proof
    have r: all x0. x0 in omega -> (!(x0 in mallocng.footprint(c, A1, B)) && !(x0 in mp.errno(s.fs_base))) && x86_64_linux.mapped(V, int_div(x0, x86_64_linux.PAGE)) ->
        V2.bytes[bits_of_int(64, x0)] = V.bytes[bits_of_int(64, x0)] && V2.pages[int_div(x0, x86_64_linux.PAGE)] = V.pages[int_div(x0, x86_64_linux.PAGE)] proof
      fix a
      assume ho hq
      have n1 _ m0 := hq
      have ml _ := expand(m0, x86_64_linux.mapped)
      have ab: bits_of_int(64, a) = a by defs(arith(ho, expand(ml, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)), bits_of_int, pow2)
      have nr: !mp.rfbyte(c, a) proof
        assume hr
        have i1 i2 := (int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, 928)) by arith(expand(hr, mp.rfbyte), cx))
        have fp := apply(mp.ctx_fp[c := c, A := A1, vm := V, b := B, a := a], hc, hu, ha, hh, ho, i1, (int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE)) by arith(i2)))
        show by taut(fp, n1)
      qed
      have m1: x86_64_linux.mapped(V, int_div(bits_of_int(64, a), x86_64_linux.PAGE)) := rewrite(sym(ab), m0)
      have bb := mp(all_elim(hby, {bits_of_int(64, a)}), (bits_of_int(64, a) in bits(64) by simp()), m1, rewrite(sym(ab), nr))
      have pp := mp(all_elim(hpg, {int_div(a, x86_64_linux.PAGE)}), (int_div(a, x86_64_linux.PAGE) in omega by defs(arith(ho), x86_64_linux.PAGE)), m0)
      show by taut(bb, pp)
    qed
    show by defs(taut(r, ebs), mallocng.untouched)
  qed
  have hfp: all a. a in omega -> a in mallocng.footprint(c, A2, B) -> a in mallocng.footprint(c, A1, B) || !x86_64_linux.mapped(V, int_div(a, x86_64_linux.PAGE)) proof
    fix a
    assume ho hf
    have {f2 = fp} := apply(mp.rf_held[c := c, A := A1, vm := V, V1 := V2, b := B, R2 := R2, K := Kc, B := Bk, a := a], P)
    have nw: a in omega && int_le(R2, a) && int_lt(a, int_add(R2, int_mul(4096, Kc))) -> !x86_64_linux.mapped(V, int_div(a, x86_64_linux.PAGE)) proof
      assume e
      have _ e1 e2 := e
      show := mp(all_elim(hfr, {a}), ho, e1, e2)
    qed
    show by taut(f2, hf, nw)
  qed
  have _ _ _ _ _ _ _ sgr _ := S
  have ne: all a. a in omega -> a in mallocng.footprint(c, A2, B) -> !(a in mp.errno(s.fs_base)) proof
    fix a
    assume ho hf
    have eo := apply(mp.errno_out[c := c, A := A, A1 := A1, B := B, V0 := s.vm, fs := s.fs_base], hea, fsb, hfl, sgr)
    have old: a in mallocng.footprint(c, A1, B) -> !(a in mp.errno(s.fs_base)) proof
      assume h1
      show := mp(all_elim(eo, {a}), ho, h1)
    qed
    have nm: !x86_64_linux.mapped(V, int_div(a, x86_64_linux.PAGE)) -> !(a in mp.errno(s.fs_base)) proof
      assume hn
      assume he
      show by taut(hn, apply(mp.am_emapped[c := c, A := A, B := B, s := s, V := V, A1 := A1, a := a], S, hea, fsb, hfl, he))
    qed
    show by taut(mp(all_elim(hfp, {a}), ho, hf), old, nm)
  qed
  have ep: all i. i in omega -> int_lt(i, 4) ->
      V2.pages[int_div(int_add(int_add(s.fs_base, 52), i), x86_64_linux.PAGE)] = V.pages[int_div(int_add(int_add(s.fs_base, 52), i), x86_64_linux.PAGE)] proof
    fix i
    assume hi hil
    let a := int_add(int_add(s.fs_base, 52), i)
    have he: a in mp.errno(s.fs_base) by simp((a in omega && int_le(int_add(s.fs_base, 52), a) && int_lt(a, int_add(s.fs_base, 56)) by arith(hi, hil, fsb)))
    have mm := apply(mp.am_emapped[c := c, A := A, B := B, s := s, V := V, A1 := A1, a := a], S, hea, fsb, hfl, he)
    show := mp(all_elim(hpg, {int_div(a, x86_64_linux.PAGE)}), (int_div(a, x86_64_linux.PAGE) in omega by defs(arith(hi, fsb), x86_64_linux.PAGE)), mm)
  qed
  show := apply(mp.am_st_step[c := c, A := A, B := B, s := s, V := V, A1 := A1, V2 := V2, A2 := A2], S, taut(hv2, ta, tu), hh2, gk, tk, un, hfp, ne, taut(ep))
qed

// (the list's links written: the head word in the context, the free metas'
// records -- the allocator's)
theorem mp.fr_unt(c, A, vm, V, b, objs, e): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> vm.bytes in fn_space(bits(64), bits(8)) ->
  mallocng.holds_in(c, A, vm, b) -> int_mod(c.ctx, 8) = 0 -> int_lt(0, seq_len(A.free_metas)) ->
  mallocng_specs.dequeued(vm, V, objs, int_add(c.ctx, 16), A.free_metas[0]) ->
  mallocng.untouched(c, A, b, vm, V, e) && fn_update(V, "bytes", vm.bytes) = vm && mallocng_specs.list_at(V, objs, int_add(c.ctx, 16), mallocng_specs.rm_at(A.free_metas, 0)) &&
  mallocng_specs.rd64(V, A.free_metas[0]) = 0 && mallocng_specs.rd64(V, bits_add(64, A.free_metas[0], 8)) = 0
proof
  assume hc hu ha hvb hh cal hn hdq
  let F := A.free_metas
  let FP := mallocng.footprint(c, A, b)
  let PH := int_add(c.ctx, 16)
  have kf: mallocng.C_FREE_META = 16 by defs(refl({16}), mallocng.C_FREE_META)
  have la := rewrite(kf, apply(mp.free_metas_at[c := c, A := A, vm := vm, b := b, objs := objs], hc, hu, ha, hvb, hh, cal))
  have fl: F in list_type(omega) by simp(ha)
  have lat r0 r8 lo := mp(all_elim(expand(hdq, mallocng_specs.dequeued), {F}, {0}), conj(fl, (0 in omega by simp())), taut(la, hn, refl({F[0]})))
  have fo lb := expand(lo, mallocng_specs.links_only)
  have {H0 = inv} := expand(hh, mallocng.holds_in)
  have {mpart = part} := expand(H0, mallocng.holds)
  have {fs = free_slots} := expand(mpart, mallocng.metas_partition)
  have co: c.ctx in omega by simp(hc)
  have up := mp(app_update_other[f := V, k := "bytes", v := vm.bytes, x := "pages"], (!("pages" = "bytes") by simp()))
  have ep: V.pages = vm.pages := sym(rewrite(fo, up))
  have ut: all x0. x0 in omega -> (!(x0 in FP) && !(x0 in e)) && x86_64_linux.mapped(vm, int_div(x0, x86_64_linux.PAGE)) ->
      V.bytes[bits_of_int(64, x0)] = vm.bytes[bits_of_int(64, x0)] && V.pages[int_div(x0, x86_64_linux.PAGE)] = vm.pages[int_div(x0, x86_64_linux.PAGE)] proof
    fix a
    assume hao hx
    have nf _ hmp := hx
    have lt _ := expand(hmp, x86_64_linux.mapped)
    have al2: int_lt(a, int_pow(2, 64)) by arith(lt, hao)
    // (the head word: the context's)
    have oh: !(int_le(PH, a) && int_lt(a, int_add(PH, 8))) proof
      assume w
      have w1 w2 := w
      have f := apply(mp.ctx_fp[c := c, A := A, vm := vm, b := b, a := a], hc, hu, ha, hh, hao, arith(w1, co), arith(w2))
      show by taut(f, nf)
    qed
    // (a free meta's links: its record's)
    have on: all x1. x1 in omega -> int_lt(x1, seq_len(F)) -> !(int_le(F[x1], a) && int_lt(a, int_add(F[x1], 16))) proof
      fix k
      assume hk hkl
      assume w
      have w1 w2 := w
      have ms _ := mp(all_elim(fs, {k}), hk, hkl)
      have {go = nat, acc = acc} := apply(mp.slot_meta[c := c, A := A, vm := vm, b := b, g := F[k]], hc, hu, ha, hh, ms, apply(mp.free_untaken, H0, hk, hkl))
      have inh _ _ := mp(all_elim(acc, {a}), hao, w1, arith(w2, go))
      have {inf = fp} := apply(mp.held_fp, inh)
      show by taut(inf, nf)
    qed
    have bb := mp(all_elim(lb, {a}), hao, taut(al2, oh, on))
    show by taut(bb, (V.pages[int_div(a, x86_64_linux.PAGE)] = vm.pages[int_div(a, x86_64_linux.PAGE)] by simp(ep)))
  qed
  have e1 := mp(app_update_other[f := V, k := "bytes", v := vm.bytes, x := "brk_start"], simp())
  have es: V.brk_start = vm.brk_start := sym(rewrite(fo, e1))
  have un: mallocng.untouched(c, A, b, vm, V, e) by defs(taut(ut, es), mallocng.untouched)
  show by taut(un, fo, lat, r0, r8)
qed


// (a meta slot, untaken, its links cleared, the pages as before: ready)
theorem mp.ready_of(c, A, V, V2, b, m): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_in(c, A, V, b) ->
  mallocng.meta_slot(A, m) -> mp.untaken(A, m) -> V2.pages = V.pages -> V2.bytes in fn_space(bits(64), bits(8)) ->
  mallocng_specs.rd64(V2, m) = 0 -> mallocng_specs.rd64(V2, bits_add(64, m, 8)) = 0 -> mallocng_specs.meta_ready(V2, m)
proof
  assume hc hu ha hh hms hnt ep hvb r0 r8
  have {go = nat, gbd = bound, acc = acc} := apply(mp.slot_meta[c := c, A := A, vm := V, b := b, g := m], hc, hu, ha, hh, hms, hnt)
  have ms: mallocng.META_SIZE = 40 by defs(refl({40}), mallocng.META_SIZE)
  have rw: all x0. x0 in omega -> int_le(m, x0) && int_lt(x0, int_add(m, mallocng.META_SIZE)) ->
      mallocng.m_rw(mallocng.mview(V2, mallocng.all_bytes), x0) && !(snd(mallocng.pg(mallocng.mview(V2, mallocng.all_bytes), x0)).kind = 2) proof
    fix a
    assume ho hr
    have r1 r2 := hr
    have xh xrw xns := mp(all_elim(acc, {a}), ho, r1, rewrite(ms, r2))
    have p1 := apply(mp.view_pg_at[vm := V, F := mallocng.held(c, A, b), a := a], xh, ho)
    have p2 := apply(mp.view_pg_at[vm := V2, F := mallocng.all_bytes, a := a], (a in mallocng.all_bytes by defs(simp(ho), mallocng.all_bytes)), ho)
    have pe: mallocng.pg(mallocng.mview(V2, mallocng.all_bytes), a) = mallocng.pg(mallocng.mview(V, mallocng.held(c, A, b)), a) by simp(p1, p2, ep)
    have m2: mallocng.m_rw(mallocng.mview(V2, mallocng.all_bytes), a) by defs(rewrite(sym(pe), expand(xrw, mallocng.m_rw, mallocng.m_mapped)), mallocng.m_rw, mallocng.m_mapped)
    show by taut(m2, rewrite(sym(pe), xns))
  qed
  have allin: all i. i in omega -> int_lt(i, 8) -> int_add(m, i) in mallocng.all_bytes proof
    fix i
    assume hi _
    show by defs(simp((int_add(m, i) in omega by arith(go, hi))), mallocng.all_bytes)
  qed
  have allin8: all i. i in omega -> int_lt(i, 8) -> int_add(int_add(m, 8), i) in mallocng.all_bytes proof
    fix i
    assume hi _
    show by defs(simp((int_add(int_add(m, 8), i) in omega by arith(go, hi))), mallocng.all_bytes)
  qed
  have v0 := apply(mp.view_read[vm := V2, fp := mallocng.all_bytes, a := m, n := 8], go, simp(), simp(), allin)
  have v8 := apply(mp.view_read[vm := V2, fp := mallocng.all_bytes, a := int_add(m, 8), n := 8], arith(go), simp(), simp(), allin8)
  have bo bl := mp(all_elim(g.bytes_bound, {V2}, {m}, {8}), hvb, simp())
  have b8o b8l := apply(g.bytes_bound, {V2}, {int_add(m, 8)}, {8}, hvb, simp())
  have m8: bits_add(64, m, 8) = int_add(m, 8) by defs(arith(go, gbd), bits_add, pow2)
  have z0: gimple.bytes_at(V2, m, 8) = 0 by defs(arith(expand(r0, mallocng_specs.rd64, bits_of_int, pow2), bo, bl), pow2)
  have z8: gimple.bytes_at(V2, int_add(m, 8), 8) = 0 by defs(arith(expand(rewrite(m8, r8), mallocng_specs.rd64, bits_of_int, pow2), b8o, b8l), pow2)
  show by defs(taut(rw, trans(sym(v0), z0), trans(sym(v8), z8)), mallocng_specs.meta_ready)
qed

// (x taken, the groups and ranges as before: the footprint one of the old)
theorem mp.take_sub(c, A, A2, b, x, a): A.taken in list_type(omega) -> x in omega ->
  mallocng.fp_ranges(c, A2) = mallocng.fp_ranges(c, A) -> A2.metas = A.metas -> A2.slots = A.slots -> A2.used = A.used ->
  A2.taken = seq_concat(A.taken, seq_one(x)) -> a in mallocng.footprint(c, A2, b) -> a in mallocng.footprint(c, A, b)
proof
  assume tl xo fpr em es eu etk h
  have inr: int_le(x, a) && int_lt(a, int_add(x, 40)) -> a in mallocng.footprint(c, A, b) proof
    assume hr
    have r1 r2 := hr
    have tln: seq_len(A.taken) in omega by arith(tl)
    have xl := apply(tr.seq_one_type, (x in univ(1) by simp(xo)))
    have e := at({seq_concat(A.taken, seq_one(x))[seq_len(A.taken)]}, tl, xl, tln)
    have it: mallocng.in_taken(A2, a) by defs(ex_intro({seq_len(A.taken)}, taut(tln, (int_lt(seq_len(A.taken), seq_len(A2.taken)) by arith(rewrite(sym(etk), (seq_len(seq_concat(A.taken, seq_one(x))) = int_add(seq_len(A.taken), 1) by arith(tl, xl))))),
      rewrite(sym(etk), (int_le(seq_concat(A.taken, seq_one(x))[seq_len(A.taken)], a) && int_lt(a, int_add(seq_concat(A.taken, seq_one(x))[seq_len(A.taken)], mallocng.META_SIZE)) by defs(simp(e, r1, r2), mallocng.META_SIZE))))), mallocng.in_taken)
    have nt: !mallocng.in_taken(A2, a) by simp(expand(h, mallocng.footprint), keep(mallocng.in_taken))
    show by taut(it, nt)
  qed
  have out: !(int_le(x, a) && int_lt(a, int_add(x, 40))) -> a in mallocng.footprint(c, A, b) proof
    assume hn
    have q := apply(mp.take_fp[c := c, A := A, A2 := A2, b := b, x := x, a := a], tl, xo, fpr, em, es, eu, etk, hn)
    show by taut(q, h)
  qed
  show by taut(inr, out)
qed

// (n bytes usable: the ones from k on too)
theorem mp.usable_sub(vm, objs, a, n, k, m, w): k in omega -> m in omega -> int_le(int_add(k, m), n) ->
  gimple.usable(vm, objs, a, n, w) -> gimple.usable(vm, objs, int_add(a, k), m, w)
proof
  assume hk hm hl hu
  have u := expand(hu, gimple.usable)
  have g: all i. i in omega -> int_lt(i, m) -> ite(x86_64_linux.mapped(vm, int_div(int_add(int_add(a, k), i), x86_64_linux.PAGE)) &&
      !(snd(vm.pages[int_div(int_add(int_add(a, k), i), x86_64_linux.PAGE)]).kind = 2),
      ite(w, snd(vm.pages[int_div(int_add(int_add(a, k), i), x86_64_linux.PAGE)]).prot.w, snd(vm.pages[int_div(int_add(int_add(a, k), i), x86_64_linux.PAGE)]).prot.r),
      int_lt(int_add(int_add(a, k), i), int_pow(2, 64)) && int_add(int_add(a, k), i) in objs) proof
    fix i
    assume hi hil
    have ui := mp(all_elim(u, {int_add(k, i)}), arith(hk, hi), arith(hil, hl))
    have ea: int_add(a, int_add(k, i)) = int_add(int_add(a, k), i) by arith()
    show := rewrite(ea, ui)
  qed
  show by defs(g, gimple.usable)
qed

// ----------------------------------------------------------------------
//  The area's next meta taken (`m = ctx.avail_meta++`, the count less one,
//  m's links cleared)

// (the words read -- the count, the next meta --, the next meta's place,
// its links' bytes usable)
theorem mp.am_tak1(c, A, V, b, objs): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_in(c, A, V, b) -> int_lt(0, A.avail_cnt) ->
  r32: gimple.bytes_at(V, int_add(c.ctx, 32), 8) = A.avail_cnt && r24: gimple.bytes_at(V, int_add(c.ctx, 24), 8) = mp.anext(A) &&
  nat: mp.anext(A) in omega && low: int_le(24, mp.anext(A)) && bound: int_le(int_add(mp.anext(A), 40), 18446744073709551616) &&
  use: (gimple.usable(V, objs, mp.anext(A), 16, false) && gimple.usable(V, objs, mp.anext(A), 16, true)) &&
  lt: int_lt(int_add(mp.anext(A), 40), 18446744073709551616)
proof
  assume hc hu ha hh hk
  have cx: c.ctx in omega by simp(expand(hc, mallocng.Cfg))
  have nf: all off. off in omega -> int_le(16, off) -> int_le(int_add(off, 8), 464) -> (all i. i in omega -> int_lt(i, 8) -> !mallocng.ctx_free(c, int_add(int_add(c.ctx, off), i))) proof
    fix off
    assume ho hl hl2
    fix i
    assume hi hil
    show by defs(arith(ho, hi, hil, hl, hl2, cx), mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK)
  qed
  have rd32 := apply(mp.ctx_read[c := c, A := A, vm := V, b := b, off := 32, n := 8], hc, hu, ha, hh, simp(), simp(), arith(), mp(all_elim(nf, {32}), simp(), simp(), simp()))
  have rd24 := apply(mp.ctx_read[c := c, A := A, vm := V, b := b, off := 24, n := 8], hc, hu, ha, hh, simp(), simp(), arith(), mp(all_elim(nf, {24}), simp(), simp(), simp()))
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {cok = ctx} := expand(H, mallocng.holds)
  have {cav = avail_cnt} := expand(cok, mallocng.ctx_ok)
  have kac: mallocng.C_AVAIL_CNT = 32 by defs(refl({32}), mallocng.C_AVAIL_CNT)
  have kam: mallocng.C_AVAIL_META = 24 by defs(refl({24}), mallocng.C_AVAIL_META)
  have {xo = nat, cw = word, xs = slot, xnt = untaken} := apply(mp.anext_at, ha, hh, hk)
  have e32 := trans(rd32, expand(rewrite(kac, cav), mallocng.ctx_word))
  have e24 := trans(rd24, expand(rewrite(kam, cw), mallocng.ctx_word))
  have {go = nat, glo = low, gbd = bound, acc = acc} := apply(mp.slot_meta[c := c, A := A, vm := V, b := b, g := mp.anext(A)], hc, hu, ha, hh, xs, xnt)
  have each: all i. i in omega -> int_lt(i, 16) -> int_add(mp.anext(A), i) in mallocng.held(c, A, b) &&
      mallocng.m_rw(mallocng.mview(V, mallocng.held(c, A, b)), int_add(mp.anext(A), i)) && !(snd(mallocng.pg(mallocng.mview(V, mallocng.held(c, A, b)), int_add(mp.anext(A), i))).kind = 2) proof
    fix i
    assume hi hil
    show := mp(all_elim(acc, {int_add(mp.anext(A), i)}), arith(go, hi), arith(go, hi), arith(go, hi, hil))
  qed
  have us := apply(mp.rw_usable[vm := V, F := mallocng.held(c, A, b), objs := objs, a := mp.anext(A), n := 16], go, each)
  have _ m39 _ := mp(all_elim(acc, {int_add(mp.anext(A), 39)}), arith(go), arith(go), arith(go))
  have lt: int_lt(int_add(mp.anext(A), 40), 18446744073709551616) by arith(expand(m39, mallocng.m_rw, mallocng.m_mapped, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE), go)
  show by taut(e32, e24, go, glo, gbd, us, lt)
qed

// (the context's words for a new area: the reserve's page count -- its
// pages below the user space's end --, the break, the mapping size's
// shift)
theorem mp.am_words(c, A, V, b): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_in(c, A, V, b) -> V in x86_64_linux.Vm ->
  cnt: bits_of_int(64, gimple.bytes_at(V, int_add(c.ctx, 40), 8)) = A.reserve_cnt && cnt_end: int_le(int_mul(4096, A.reserve_cnt), 140737488351232) &&
  brk: gimple.bytes_at(V, int_add(c.ctx, 920), 8) = A.brk && shift: int_le(gimple.bytes_at(V, int_add(c.ctx, 48), 8), 34) &&
  brkv: bits_of_int(64, gimple.bytes_at(V, int_add(c.ctx, 920), 8)) = A.brk &&
  brk_ok: ((A.brk = 0 && int_le(V.brk, x86_64_linux.TASK_SIZE)) || A.brk = 18446744073709551615 || (A.brk = V.brk && int_mod(A.brk, 4096) = 0)) &&
  cnt_raw: gimple.bytes_at(V, int_add(c.ctx, 40), 8) = A.reserve_cnt
proof
  assume hc hu ha hh hv
  have cx: c.ctx in omega by simp(expand(hc, mallocng.Cfg))
  have nf: all off. off in omega -> int_le(16, off) -> int_le(int_add(off, 8), 464) -> (all i. i in omega -> int_lt(i, 8) -> !mallocng.ctx_free(c, int_add(int_add(c.ctx, off), i))) proof
    fix off
    assume ho hl hl2
    fix i
    assume hi hil
    show by defs(arith(ho, hi, hil, hl, hl2, cx), mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK)
  qed
  have nfb: all i. i in omega -> int_lt(i, 8) -> !mallocng.ctx_free(c, int_add(int_add(c.ctx, 920), i)) proof
    fix i
    assume hi hil
    show by defs(arith(hi, hil, cx), mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK)
  qed
  have rd40 := apply(mp.ctx_read[c := c, A := A, vm := V, b := b, off := 40, n := 8], hc, hu, ha, hh, simp(), simp(), arith(), mp(all_elim(nf, {40}), simp(), simp(), simp()))
  have rd48 := apply(mp.ctx_read[c := c, A := A, vm := V, b := b, off := 48, n := 8], hc, hu, ha, hh, simp(), simp(), arith(), mp(all_elim(nf, {48}), simp(), simp(), simp()))
  have rd920 := apply(mp.ctx_read[c := c, A := A, vm := V, b := b, off := 920, n := 8], hc, hu, ha, hh, simp(), simp(), arith(), nfb)
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {cok = ctx, har = areas} := expand(H, mallocng.holds)
  have {cac = area_cnt, cbk = brk, csh = shift} := expand(cok, mallocng.ctx_ok)
  have k40: mallocng.C_AREA_CNT = 40 by defs(refl({40}), mallocng.C_AREA_CNT)
  have k48: mallocng.C_META_SHIFT = 48 by defs(refl({48}), mallocng.C_META_SHIFT)
  have k920: mallocng.C_BRK = 920 by defs(refl({920}), mallocng.C_BRK)
  have e40 := trans(rd40, expand(rewrite(k40, cac), mallocng.ctx_word))
  have e48: gimple.bytes_at(V, int_add(c.ctx, 48), 8) = mallocng.ctx_word(c, mallocng.mview(V, mallocng.held(c, A, b)), 48) by defs(simp(rd48), mallocng.ctx_word)
  have s48: int_le(gimple.bytes_at(V, int_add(c.ctx, 48), 8), 34) := rewrite(sym(e48), rewrite(k48, csh))
  have e920 := trans(rd920, expand(rewrite(k920, cbk), mallocng.ctx_word))
  have co: A.reserve_cnt in omega by simp(ha)
  have ro: A.reserve in omega by simp(ha)
  have bd: int_le(int_mul(4096, A.reserve_cnt), 140737488351232) proof
    have z: A.reserve_cnt = 0 -> int_le(int_mul(4096, A.reserve_cnt), 140737488351232) proof
      assume e
      show by arith(e)
    qed
    have p: int_lt(0, A.reserve_cnt) -> int_le(int_mul(4096, A.reserve_cnt), 140737488351232) proof
      assume hr
      have {ar = reserve} := expand(har, mallocng.areas_ok)
      let L := int_sub(int_add(A.reserve, int_mul(4096, A.reserve_cnt)), 1)
      have mm _ _ := mp(all_elim(ar, {L}), arith(ro, co, hr), arith(ro, co, hr))
      have lt _ := expand(mm, mallocng.m_mapped)
      show by arith(lt, ro, co, hr)
    qed
    show by taut(z, p, (A.reserve_cnt = 0 || int_lt(0, A.reserve_cnt) by arith(co)))
  qed
  have b40: bits_of_int(64, gimple.bytes_at(V, int_add(c.ctx, 40), 8)) = A.reserve_cnt by defs(arith(e40, bd, co), bits_of_int, pow2)
  have {hbk = brk} := expand(H, mallocng.holds)
  have bko: (A.brk = 0 && int_le(V.brk, x86_64_linux.TASK_SIZE)) || A.brk = 18446744073709551615 || (A.brk = V.brk && int_mod(A.brk, 4096) = 0) by simp(expand(hbk, mallocng.brk_ok))
  have vbb: V.brk in bits(64) by simp(expand(hv, x86_64_linux.Vm))
  have bko2: A.brk in omega by simp(ha)
  have blt: int_lt(A.brk, 18446744073709551616) by taut(bko, (A.brk = 0 -> int_lt(A.brk, 18446744073709551616) by arith()),
    (A.brk = 18446744073709551615 -> int_lt(A.brk, 18446744073709551616) by arith()), (A.brk = V.brk -> int_lt(A.brk, 18446744073709551616) by arith(vbb)))
  have b920: bits_of_int(64, gimple.bytes_at(V, int_add(c.ctx, 920), 8)) = A.brk by defs(arith(e920, blt, bko2), bits_of_int, pow2)
  show by taut(b40, bd, e920, s48, b920, bko, e40)
qed

// the area's next meta taken from a run state: the count and the next meta
// written, the meta's links cleared -- the outcome
theorem mp.am_take(c, A, B, s, V3, A3): mp.am_st(c, A, B, s, V3, A3) -> c in mallocng.Cfg -> s in abi.World -> s in univ(1) -> B in fn_space(bits(64), option(omega)) ->
  int_lt(0, A3.avail_cnt) -> int_le(int_add(c.ctx, 928), 18446744073709551616) ->
  mp.am_post(c, A, B, s, mp.tav(A3), fn_update(V3, "bytes", x86_64_linux.store_le(x86_64_linux.store_le(x86_64_linux.store_le(x86_64_linux.store_le(V3.bytes,
    int_add(c.ctx, 32), 8, int_sub(A3.avail_cnt, 1)), int_add(c.ctx, 24), 8, int_add(mp.anext(A3), 40)), int_add(mp.anext(A3), 8), 8, 0), int_add(mp.anext(A3), 0), 8, 0)), mp.anext(A3))
proof
  assume S hc hw hu hb hk hcb
  let M := mp.anext(A3)
  let B1 := x86_64_linux.store_le(V3.bytes, int_add(c.ctx, 32), 8, int_sub(A3.avail_cnt, 1))
  let B2 := x86_64_linux.store_le(B1, int_add(c.ctx, 24), 8, int_add(M, 40))
  let B3 := x86_64_linux.store_le(B2, int_add(M, 8), 8, 0)
  let VB := fn_update(V3, "bytes", B2)
  let VD := fn_update(V3, "bytes", x86_64_linux.store_le(B3, int_add(M, 0), 8, 0))
  have s1 s2 s3 s4 sg sk su sf se := S
  have {r32 = r32, r24 = r24, mo = nat, mlo = low, mbd = bound, mlt = lt} := apply(mp.am_tak1[c := c, A := A3, V := V3, b := B, objs := s.objs], hc, s3, s2, s4, hk)
  have {xle = le, xs = slot, xnt = untaken} := apply(mp.anext_at, s2, s4, hk)
  have cx: c.ctx in omega by simp(expand(hc, mallocng.Cfg))
  have v3b: V3.bytes in fn_space(bits(64), bits(8)) by simp(expand(s1, x86_64_linux.Vm))
  have ko: A3.avail_cnt in omega by simp(s2)
  have c32b: int_add(c.ctx, 32) in bits(64) by arith(cx, hcb)
  have c24b: int_add(c.ctx, 24) in bits(64) by arith(cx, hcb)
  have m8b: int_add(M, 8) in bits(64) by arith(mo, mlt)
  have m0b: int_add(M, 0) in bits(64) by arith(mo, mlt)
  have mb: M in bits(64) by arith(mo, mlt)
  have cm1: int_sub(A3.avail_cnt, 1) in bits(64) by arith(ko, hk, xle)
  have m40: int_add(M, 40) in bits(64) by arith(mo, mlt)
  // (the memory with the count and the next meta written: a memory)
  have w3W w3u := apply(mp.am_world, hw, hu, s1)
  have waW wau := apply(tr.world_store, {fn_update(s, "vm", V3)}, {int_add(c.ctx, 32)}, {8}, {int_sub(A3.avail_cnt, 1)}, w3W, w3u, c32b)
  have wbW wbu := apply(tr.world_store, {fn_update(s, "vm", fn_update(V3, "bytes", B1))}, {int_add(c.ctx, 24)}, {8}, {int_add(M, 40)}, simp(waW, keep(abi.World)), simp(wau), c24b)
  have {vbv = mem} := apply(ms.world_parts, wbW)
  have vbV: VB in x86_64_linux.Vm by simp(vbv)
  have vab: fn_update(V3, "bytes", B1).bytes in fn_space(bits(64), bits(8)) by simp(apply(x86.store_typed, {V3.bytes}, {int_add(c.ctx, 32)}, {8}, {int_sub(A3.avail_cnt, 1)}, v3b))
  // (its bytes: V3's but the two words)
  have by1: all y. y in bits(64) -> !(int_le(int_add(c.ctx, 24), y) && int_lt(y, int_add(c.ctx, 40))) -> VB.bytes[y] = V3.bytes[y] proof
    fix y
    assume hy hn
    have o2 := apply(mp.st_out[B := B1, c := int_add(c.ctx, 24), k := 8, v := int_add(M, 40), x := y], hy, c24b, simp(), arith(cx, hcb), arith(hn, hy, cx))
    have o1 := apply(mp.st_out[B := V3.bytes, c := int_add(c.ctx, 32), k := 8, v := int_sub(A3.avail_cnt, 1), x := y], hy, c32b, simp(), arith(cx, hcb), arith(hn, hy, cx))
    show by simp(o2, o1)
  qed
  have rest: fn_update(VB, "bytes", V3.bytes) = V3 by simp(mp(fn_update_same[f := V3, k := "bytes"], (is_fun(V3) by simp(expand(s1, x86_64_linux.Vm))), ("bytes" in dom(V3) by simp(expand(s1, x86_64_linux.Vm)))))
  have ro := apply(mp.rd_out[vm := fn_update(V3, "bytes", B1), c := int_add(c.ctx, 24), k := 8, v := int_add(M, 40), a := int_add(c.ctx, 32), n := 8], arith(cx), simp(), c24b, simp(), arith(cx, hcb), arith(cx, hcb), arith(cx))
  have ra := apply(mp.rd_at8[vm := V3, c := int_add(c.ctx, 32), v := int_sub(A3.avail_cnt, 1)], v3b, c32b, cm1)
  have rb := apply(mp.rd_at8[vm := fn_update(V3, "bytes", B1), c := int_add(c.ctx, 24), v := int_add(M, 40)], vab, c24b, m40)
  have w32: gimple.bytes_at(VB, int_add(c.ctx, 32), 8) = int_sub(A3.avail_cnt, 1) by simp(ro, ra, ms.v_wr64)
  have w24: gimple.bytes_at(VB, int_add(c.ctx, 24), 8) = int_add(M, 40) by simp(rb, ms.v_wr64)
  have P: mp.tavpre(c, A3, V3, VB, B) by taut(hc, s3, s2, hb, s1, vbV, s4, hk, by1, (VB.pages = V3.pages by simp()), rest, w32, w24)
  have hh2 := apply(mp.tav_holds_in, P)
  have {ta = abs, tu = univ, tm = metas, ts = slots, tus = used, tac = active, ttk = taken, tr = ranges, tl = tl} := apply(mp.tav_basic, P)
  // (the links written: M's record, taken now -- out of the footprint)
  have vdb: all y. y in bits(64) -> (int_le(int_add(M, 16), y) || int_lt(y, M)) -> VD.bytes[y] = VB.bytes[y] proof
    fix y
    assume hy hn
    have o2 := apply(mp.st_out[B := B3, c := int_add(M, 0), k := 8, v := 0, x := y], hy, m0b, simp(), arith(mo, mlt), arith(hn, hy, mo))
    have o1 := apply(mp.st_out[B := B2, c := int_add(M, 8), k := 8, v := 0, x := y], hy, m8b, simp(), arith(mo, mlt), arith(hn, hy, mo))
    show by simp(o2, o1)
  qed
  have tkm: all y. y in omega -> int_le(M, y) -> int_lt(y, int_add(M, 40)) -> !(y in mallocng.footprint(c, mp.tav(A3), B)) proof
    fix y
    assume ho h1 h2
    assume hf
    have tln: seq_len(A3.taken) in omega by arith(tl)
    have xl := apply(tr.seq_one_type, (M in univ(1) by simp(mo)))
    have e := at({seq_concat(A3.taken, seq_one(M))[seq_len(A3.taken)]}, tl, xl, tln)
    have it: mallocng.in_taken(mp.tav(A3), y) by defs(ex_intro({seq_len(A3.taken)}, taut(tln,
      (int_lt(seq_len(A3.taken), seq_len(mp.tav(A3).taken)) by arith(rewrite(sym(ttk), (seq_len(seq_concat(A3.taken, seq_one(M))) = int_add(seq_len(A3.taken), 1) by arith(tl, xl))))),
      rewrite(sym(ttk), (int_le(seq_concat(A3.taken, seq_one(M))[seq_len(A3.taken)], y) && int_lt(y, int_add(seq_concat(A3.taken, seq_one(M))[seq_len(A3.taken)], mallocng.META_SIZE))
        by defs(simp(e, h1, h2), mallocng.META_SIZE))))), mallocng.in_taken)
    have nt: !mallocng.in_taken(mp.tav(A3), y) by simp(expand(hf, mallocng.footprint), keep(mallocng.in_taken))
    show by taut(it, nt)
  qed
  have rest2: fn_update(VD, "bytes", VB.bytes) = VB by simp()
  have fb: all x. x in bits(64) -> x in mallocng.footprint(c, mp.tav(A3), B) -> VD.bytes[x] = VB.bytes[x] proof
    fix x
    assume hx hf
    have xo: x in omega by arith(hx)
    have out: int_le(int_add(M, 16), x) || int_lt(x, M) proof
      have c: int_le(M, x) && int_lt(x, int_add(M, 16)) -> false proof
        assume h
        have h1 h2 := h
        show by taut(hf, mp(all_elim(tkm, {x}), xo, h1, (int_lt(x, int_add(M, 40)) by arith(h2))))
      qed
      show by arith(c, xo, mo)
    qed
    show := mp(all_elim(vdb, {x}), hx, out)
  qed
  have hh3 := apply(mp.out_holds[c := c, A := mp.tav(A3), vm := VB, vm2 := VD, b := B], hh2, rest2, fb)
  // (untouched: the words the context's, the links M's record -- A3's)
  have mf: all y. y in omega -> int_le(M, y) -> int_lt(y, int_add(M, 16)) -> y in mallocng.footprint(c, A3, B) proof
    fix y
    assume ho h1 h2
    have {acc = acc} := apply(mp.slot_meta[c := c, A := A3, vm := V3, b := B, g := M], hc, s3, s2, s4, xs, xnt)
    have yh _ _ := mp(all_elim(acc, {y}), ho, h1, arith(h2))
    have {yf = fp} := apply(mp.held_fp, yh)
    show := yf
  qed
  have un3: mallocng.untouched(c, A3, B, V3, VD, mp.errno(s.fs_base)) proof
    have r: all x0. x0 in omega -> (!(x0 in mallocng.footprint(c, A3, B)) && !(x0 in mp.errno(s.fs_base))) && x86_64_linux.mapped(V3, int_div(x0, x86_64_linux.PAGE)) ->
        VD.bytes[bits_of_int(64, x0)] = V3.bytes[bits_of_int(64, x0)] && VD.pages[int_div(x0, x86_64_linux.PAGE)] = V3.pages[int_div(x0, x86_64_linux.PAGE)] proof
      fix a
      assume ho hq
      have n1 _ m0 := hq
      have ml _ := expand(m0, x86_64_linux.mapped)
      have ab: bits_of_int(64, a) = a by defs(arith(ho, expand(ml, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)), bits_of_int, pow2)
      have abb: bits_of_int(64, a) in bits(64) by simp()
      have nc: !(int_le(int_add(c.ctx, 24), a) && int_lt(a, int_add(c.ctx, 40))) proof
        assume w
        have w1 w2 := w
        have f := apply(mp.ctx_fp[c := c, A := A3, vm := V3, b := B, a := a], hc, s3, s2, s4, ho, arith(w1), (int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE)) by defs(arith(w2), mallocng.CTX_SIZE)))
        show by taut(f, n1)
      qed
      have nm: int_le(int_add(M, 16), a) || int_lt(a, M) proof
        have c: int_le(M, a) && int_lt(a, int_add(M, 16)) -> false proof
          assume h
          have h1 h2 := h
          show by taut(n1, mp(all_elim(mf, {a}), ho, h1, h2))
        qed
        show by arith(c, ho, mo)
      qed
      have bd := mp(all_elim(vdb, {bits_of_int(64, a)}), abb, rewrite(sym(ab), nm))
      have bv := mp(all_elim(by1, {bits_of_int(64, a)}), abb, rewrite(sym(ab), nc))
      show by taut(trans(bd, bv), (VD.pages[int_div(a, x86_64_linux.PAGE)] = V3.pages[int_div(a, x86_64_linux.PAGE)] by simp()))
    qed
    show by defs(taut(r, (VD.brk_start = V3.brk_start by simp())), mallocng.untouched)
  qed
  have un := apply(mp.unt_grow[c := c, A := A, A1 := A3, b := B, V0 := s.vm, V1 := V3, V2 := VD, e := mp.errno(s.fs_base)], su, un3, sf)
  have gr: mp.grown(c, mp.tav(A3), A, B, s.vm) proof
    fix a
    assume ho hf
    have f1 := apply(mp.take_sub[c := c, A := A3, A2 := mp.tav(A3), b := B, x := M, a := a], tl, mo, tr, tm, ts, tus, ttk, hf)
    show := mp(all_elim(sf, {a}), ho, f1)
  qed
  // (M ready: its links 0, its bytes accessible)
  have vdb2: VD.bytes in fn_space(bits(64), bits(8)) by simp(apply(x86.store_typed, {B3}, {int_add(M, 0)}, {8}, {0},
    apply(x86.store_typed, {B2}, {int_add(M, 8)}, {8}, {0}, apply(x86.store_typed, {B1}, {int_add(c.ctx, 24)}, {8}, {int_add(M, 40)}, simp(vab)))))
  have v3c: fn_update(V3, "bytes", B3).bytes in fn_space(bits(64), bits(8)) by simp(apply(x86.store_typed, {B2}, {int_add(M, 8)}, {8}, {0},
    apply(x86.store_typed, {B1}, {int_add(c.ctx, 24)}, {8}, {int_add(M, 40)}, simp(vab))))
  have rz0 := apply(mp.rd_at8[vm := fn_update(V3, "bytes", B3), c := int_add(M, 0), v := 0], v3c, m0b, simp())
  have rz8 := apply(mp.rd_out[vm := fn_update(V3, "bytes", B3), c := int_add(M, 0), k := 8, v := 0, a := int_add(M, 8), n := 8], arith(mo), simp(), m0b, simp(), arith(mo, mlt), arith(mo, mlt), arith(mo))
  have v3bb: fn_update(V3, "bytes", B2).bytes in fn_space(bits(64), bits(8)) by simp(apply(x86.store_typed, {B1}, {int_add(c.ctx, 24)}, {8}, {int_add(M, 40)}, simp(vab)))
  have rz8b := apply(mp.rd_at8[vm := fn_update(V3, "bytes", B2), c := int_add(M, 8), v := 0], v3bb, m8b, simp())
  have m00: int_add(M, 0) = M by arith(mo)
  have mb8: bits_add(64, M, 8) = int_add(M, 8) by defs(arith(mo, mlt), bits_add, pow2)
  have d0: mallocng_specs.rd64(VD, M) = 0 by defs(simp(rewrite(m00, rz0), ms.v_wr64), mallocng_specs.rd64)
  have d8: mallocng_specs.rd64(VD, bits_add(64, M, 8)) = 0 by defs(simp(mb8, rz8, rz8b, ms.v_wr64), mallocng_specs.rd64)
  have rdy := apply(mp.ready_of[c := c, A := A3, V := V3, V2 := VD, b := B, m := M], hc, s3, s2, s4, xs, xnt, (VD.pages = V3.pages by simp()), vdb2, d0, d8)
  have gk3: mallocng_specs.groups_kept(A3, mp.tav(A3)) by defs(simp(tm, ts, tus, tac), mallocng_specs.groups_kept)
  have wcW wcu := apply(tr.world_store, {fn_update(s, "vm", VB)}, {int_add(M, 8)}, {8}, {0}, simp(wbW, keep(abi.World)), simp(wbu), m8b)
  have wdW _ := apply(tr.world_store, {fn_update(s, "vm", fn_update(V3, "bytes", B3))}, {int_add(M, 0)}, {8}, {0}, simp(wcW, keep(abi.World)), simp(wcu), m0b)
  have {vdv = mem} := apply(ms.world_parts, wdW)
  have vdV: VD in x86_64_linux.Vm by simp(vdv)
  have tk2: mp.tav(A3).taken = seq_concat(A.taken, seq_one(M)) := trans(ttk, (seq_concat(A3.taken, seq_one(M)) = seq_concat(A.taken, seq_one(M)) by simp(sk)))
  have epg: mp.am_epg(s, VD) by simp(se)
  // (M's bytes: A3's, so the entry's or unmapped then)
  have mfp: mp.am_mfp(c, A, B, s, M) proof
    assume _
    fix a
    assume ho hr
    have h1 h2 := hr
    have {acc = acc} := apply(mp.slot_meta[c := c, A := A3, vm := V3, b := B, g := M], hc, s3, s2, s4, xs, xnt)
    have yh _ _ := mp(all_elim(acc, {a}), ho, h1, (int_lt(a, int_add(M, 40)) by defs(arith(h2), mallocng.META_SIZE)))
    have {yf = fp} := apply(mp.held_fp, yh)
    show := mp(all_elim(sf, {a}), ho, yf)
  qed
  show by taut(ta, tu, apply(mp.gk_trans, sg, gk3), mb, (!(M = 0) by arith(mlo)), tk2, vdV, hh3, un, gr, rdy, epg, mfp)
qed

// the free metas' head taken from a run state: the outcome
theorem mp.am_deq(c, A, B, s, V1, A1, V2): mp.am_st(c, A, B, s, V1, A1) -> c in mallocng.Cfg -> int_mod(c.ctx, 8) = 0 -> B in fn_space(bits(64), option(omega)) ->
  int_lt(0, seq_len(A1.free_metas)) -> V2 in x86_64_linux.Vm -> mallocng_specs.dequeued(V1, V2, s.objs, int_add(c.ctx, 16), A1.free_metas[0]) ->
  mp.am_post(c, A, B, s, mp.take(A1, mallocng_specs.rm_at(A1.free_metas, 0), A1.avail_cnt, A1.free_metas[0]), V2, A1.free_metas[0])
proof
  assume S hc cal hb hn hv2 hdq
  let F := A1.free_metas
  let A2 := mp.take(A1, mallocng_specs.rm_at(A1.free_metas, 0), A1.avail_cnt, A1.free_metas[0])
  have s1 s2 s3 s4 sg sk su sf se := S
  have v1b: V1.bytes in fn_space(bits(64), bits(8)) by simp(expand(s1, x86_64_linux.Vm))
  have v2b: V2.bytes in fn_space(bits(64), bits(8)) by simp(expand(hv2, x86_64_linux.Vm))
  have P := apply(mp.tfr_tk, hc, s3, s2, hb, s1, hv2, s4, cal, hn, hdq)
  have {ta = abs, tu = univ, tm = metas, ts = slots, tus = used, tac = active, ttk = taken, tr = ranges, tl = tl, tx = nat} := apply(mp.tk_basic, P)
  have hh2 := apply(mp.tfr_holds_in, hc, s3, s2, hb, s1, hv2, s4, cal, hn, hdq)
  have un1 fo _ r0 r8 := apply(mp.fr_unt[c := c, A := A1, vm := V1, V := V2, b := B, objs := s.objs, e := mp.errno(s.fs_base)], hc, s3, s2, v1b, s4, cal, hn, hdq)
  have {H1 = inv} := expand(s4, mallocng.holds_in)
  have {mpart = part} := expand(H1, mallocng.holds)
  have {fs = free_slots} := expand(mpart, mallocng.metas_partition)
  have ms0 _ := mp(all_elim(fs, {0}), simp(), hn)
  have nt0 := apply(mp.free_untaken, H1, (0 in omega by simp()), hn)
  have {go = nat, glo = low, gbd = bound} := apply(mp.slot_meta[c := c, A := A1, vm := V1, b := B, g := F[0]], hc, s3, s2, s4, ms0, nt0)
  have gk12: mallocng_specs.groups_kept(A1, A2) by defs(simp(tm, ts, tus, tac), mallocng_specs.groups_kept)
  have mb: F[0] in bits(64) by arith(go, gbd)
  have mz: !(F[0] = 0) by arith(glo)
  have tk2: A2.taken = seq_concat(A.taken, seq_one(F[0])) := rewrite(sk, ttk)
  have un := apply(mp.unt_grow[c := c, A := A, A1 := A1, b := B, V0 := s.vm, V1 := V1, V2 := V2, e := mp.errno(s.fs_base)], su, un1, sf)
  have gr: mp.grown(c, A2, A, B, s.vm) proof
    fix a
    assume ho hf
    have f1 := apply(mp.take_sub[c := c, A := A1, A2 := A2, b := B, x := F[0], a := a], tl, tx, tr, tm, ts, tus, ttk, hf)
    show := mp(all_elim(sf, {a}), ho, f1)
  qed
  have up := mp(app_update_other[f := V2, k := "bytes", v := V1.bytes, x := "pages"], (!("pages" = "bytes") by simp()))
  have ep: V2.pages = V1.pages := sym(rewrite(fo, up))
  have rd := apply(mp.ready_of[c := c, A := A1, V := V1, V2 := V2, b := B, m := F[0]], hc, s3, s2, s4, ms0, nt0, ep, v2b, r0, r8)
  have epg: mp.am_epg(s, V2) by simp(se, ep)
  // (the head's bytes: A1's, so the entry's or unmapped then)
  have mfp: mp.am_mfp(c, A, B, s, F[0]) proof
    assume _
    fix a
    assume ho hr
    have h1 h2 := hr
    have {acc = acc} := apply(mp.slot_meta[c := c, A := A1, vm := V1, b := B, g := F[0]], hc, s3, s2, s4, ms0, nt0)
    have yh _ _ := mp(all_elim(acc, {a}), ho, h1, (int_lt(a, int_add(F[0], 40)) by defs(arith(h2), mallocng.META_SIZE)))
    have {yf = fp} := apply(mp.held_fp, yh)
    show := mp(all_elim(sf, {a}), ho, yf)
  qed
  show by taut(ta, tu, apply(mp.gk_trans, sg, gk12), mb, mz, tk2, hv2, hh2, un, gr, rd, epg, mfp)
qed

// ----------------------------------------------------------------------
//  alloc_meta's run

// (a callee g refining F)
// (the break rounded up to a page, as malloc does: b + (-b & 4095))
theorem mp.brk_round(b): b in bits(64) -> int_le(b, 140737488351232) ->
  nat: bits_add(64, b, bits_and(64, bits_sub(64, 0, b), bits_add(64, 4096, bits_neg(64, 1)))) in omega &&
  al: int_mod(bits_add(64, b, bits_and(64, bits_sub(64, 0, b), bits_add(64, 4096, bits_neg(64, 1)))), 4096) = 0 &&
  ge: int_le(b, bits_add(64, b, bits_and(64, bits_sub(64, 0, b), bits_add(64, 4096, bits_neg(64, 1))))) &&
  lt: int_lt(bits_add(64, b, bits_and(64, bits_sub(64, 0, b), bits_add(64, 4096, bits_neg(64, 1)))), int_add(b, 4096)) &&
  le: int_le(bits_add(64, b, bits_and(64, bits_sub(64, 0, b), bits_add(64, 4096, bits_neg(64, 1)))), 140737488351232)
proof
  assume hb hl
  have m: bits_add(64, 4096, bits_neg(64, 1)) = int_sub(pow2(12), 1) by defs(simp(), bits_add, bits_neg, pow2)
  let Y := bits_sub(64, 0, b)
  have yb: Y in bits(64) by defs(arith(), pow2)
  have mb: int_mod(Y, pow2(12)) in bits(64) by arith(yb)
  have an: bits_and(64, Y, int_sub(pow2(12), 1)) = int_mod(Y, pow2(12)) by bitwise({64}, yb, mb)
  let R := int_mod(Y, 4096)
  have rv: bits_and(64, Y, bits_add(64, 4096, bits_neg(64, 1))) = R := rewrite(sym(m), (bits_and(64, Y, int_sub(pow2(12), 1)) = R by simp(an)))
  have r0: int_le(0, R) && int_lt(R, 4096) && int_mod(int_add(b, R), 4096) = 0 by arith(hb)
  have ad: bits_add(64, b, R) = int_add(b, R) by defs(arith(r0, hb, hl), bits_add, pow2)
  have e: bits_add(64, b, bits_and(64, Y, bits_add(64, 4096, bits_neg(64, 1)))) = int_add(b, R) := rewrite(sym(rv), ad)
  have t: int_le(int_add(b, R), 140737488351232) by arith(r0, hl)
  show by simp(e, r0, t, hb)
qed

// (where the ways meet before the break is moved: the break's word bb
// written, nothing else; the guard page needed (g = 1, the first time:
// the break rounded up) or not, the new break nw)
abbrev mp.am_jg(c, A1, V1, VG, g, nw, bb) := VG in x86_64_linux.Vm && fn_update(VG, "bytes", V1.bytes) = V1 &&
  (all y. y in bits(64) -> !(int_le(int_add(c.ctx, 920), y) && int_lt(y, int_add(c.ctx, 928))) -> VG.bytes[y] = V1.bytes[y]) &&
  bits_of_int(64, gimple.bytes_at(VG, int_add(c.ctx, 920), 8)) = bb && nw in bits(64) &&
  ((g = 0 && A1.brk = V1.brk && int_mod(V1.brk, 4096) = 0 && !(V1.brk = 0) && nw = bits_add(64, 4096, A1.brk) && bb = V1.brk) ||
   (g = 1 && A1.brk = 0 && int_mod(bb, 4096) = 0 && int_le(V1.brk, bb) && int_lt(bb, int_add(V1.brk, 4096)) && int_le(bb, 140737488351232) &&
    nw = int_add(bb, 8192)))

// (memory as before but for the break's word: its other fields as before,
// the context's words below the break's)
theorem mp.jg_parts(c, A1, V1, VG, g, nw, bb): mp.am_jg(c, A1, V1, VG, g, nw, bb) -> c.ctx in omega -> int_le(int_add(c.ctx, 928), 18446744073709551616) ->
  pages: VG.pages = V1.pages && top: VG.stack_top = V1.stack_top && lim: VG.stack_limit = V1.stack_limit && start: VG.brk_start = V1.brk_start &&
  brk: VG.brk = V1.brk &&
  words: (all off. off in omega -> int_le(int_add(off, 8), 920) -> gimple.bytes_at(VG, int_add(c.ctx, off), 8) = gimple.bytes_at(V1, int_add(c.ctx, off), 8))
proof
  assume J cx hcb
  have _ jr jo _ _ _ := J
  have u1 := mp(app_update_other[f := VG, k := "bytes", v := V1.bytes, x := "pages"], (!("pages" = "bytes") by simp()))
  have u2 := mp(app_update_other[f := VG, k := "bytes", v := V1.bytes, x := "stack_top"], (!("stack_top" = "bytes") by simp()))
  have u3 := mp(app_update_other[f := VG, k := "bytes", v := V1.bytes, x := "stack_limit"], (!("stack_limit" = "bytes") by simp()))
  have u4 := mp(app_update_other[f := VG, k := "bytes", v := V1.bytes, x := "brk_start"], (!("brk_start" = "bytes") by simp()))
  have u5 := mp(app_update_other[f := VG, k := "bytes", v := V1.bytes, x := "brk"], (!("brk" = "bytes") by simp()))
  have wd: all off. off in omega -> int_le(int_add(off, 8), 920) -> gimple.bytes_at(VG, int_add(c.ctx, off), 8) = gimple.bytes_at(V1, int_add(c.ctx, off), 8) proof
    fix off
    assume ho hl
    have eb: all j. j in omega -> int_lt(j, 8) -> VG.bytes[int_add(int_add(c.ctx, off), j)] = V1.bytes[int_add(int_add(c.ctx, off), j)] proof
      fix j
      assume hj hjl
      show := mp(all_elim(jo, {int_add(int_add(c.ctx, off), j)}), (int_add(int_add(c.ctx, off), j) in bits(64) by arith(cx, ho, hj, hjl, hl, hcb)), (!(int_le(int_add(c.ctx, 920), int_add(int_add(c.ctx, off), j)) && int_lt(int_add(int_add(c.ctx, off), j), int_add(c.ctx, 928))) by arith(hjl, hl)))
    qed
    show := apply(mp.rd_same[v1 := VG, v2 := V1, a := int_add(c.ctx, off), n := 8], arith(cx, ho), simp(), arith(cx, ho, hl, hcb), eb)
  qed
  show by taut(sym(rewrite(jr, u1)), sym(rewrite(jr, u2)), sym(rewrite(jr, u3)), sym(rewrite(jr, u4)), sym(rewrite(jr, u5)), wd)
qed

// (the break moved to nw, not below where it started: the reserve's page
// R2 = nw - 4096 the last new one; the first new one the old break's page,
// the guard page's if there is one)
def mp.brk_pg(V1, g, nw, bb) := (nw in omega && int_sub(nw, 4096) in omega) && nw in bits(64) && int_lt(0, int_sub(nw, 4096)) && int_mod(int_sub(nw, 4096), 4096) = 0 &&
  bits_sub(64, nw, 4096) = int_sub(nw, 4096) &&
  int_le(x86_64_linux.pages_for(V1.brk), int_div(int_sub(nw, 4096), 4096)) && x86_64_linux.pages_for(nw) = int_add(int_div(int_sub(nw, 4096), 4096), 1) &&
  (g = 1 -> int_mod(bb, 4096) = 0 && int_add(int_div(bb, 4096), 1) = int_div(int_sub(nw, 4096), 4096) && x86_64_linux.pages_for(V1.brk) = int_div(bb, 4096) && bb in bits(64))

theorem mp.brk_pages(c, A1, V1, VG, g, nw, bb): mp.am_jg(c, A1, V1, VG, g, nw, bb) -> V1 in x86_64_linux.Vm -> int_le(4096, V1.brk_start) ->
  !int_lt(nw, V1.brk_start) ->
  nat: (nw in omega && int_sub(nw, 4096) in omega) && nwb: nw in bits(64) && pos: int_lt(0, int_sub(nw, 4096)) && al: int_mod(int_sub(nw, 4096), 4096) = 0 &&
  sub: bits_sub(64, nw, 4096) = int_sub(nw, 4096) &&
  po: int_le(x86_64_linux.pages_for(V1.brk), int_div(int_sub(nw, 4096), 4096)) && pn: x86_64_linux.pages_for(nw) = int_add(int_div(int_sub(nw, 4096), 4096), 1) &&
  guard: (g = 1 -> int_mod(bb, 4096) = 0 && int_add(int_div(bb, 4096), 1) = int_div(int_sub(nw, 4096), 4096) && x86_64_linux.pages_for(V1.brk) = int_div(bb, 4096) &&
    bb in bits(64))
proof
  assume J hv hs hn
  have _ _ _ jbb _ jc := J
  have bbb: bb in bits(64) := rewrite(jbb, (bits_of_int(64, gimple.bytes_at(VG, int_add(c.ctx, 920), 8)) in bits(64) by simp()))
  have vb: V1.brk in bits(64) by simp(expand(hv, x86_64_linux.Vm))
  have vs: V1.brk_start in bits(64) by simp(expand(hv, x86_64_linux.Vm))
  have pf: all x. x86_64_linux.pages_for(x) = int_div(int_add(x, 4095), 4096) proof
    fix x
    show by defs(simp(), x86_64_linux.pages_for)
  qed
  have c0: g = 0 && A1.brk = V1.brk && int_mod(V1.brk, 4096) = 0 && !(V1.brk = 0) && nw = bits_add(64, 4096, A1.brk) && bb = V1.brk -> mp.brk_pg(V1, g, nw, bb) proof
    assume q
    have q0 q1 q2 q3 q4 _ := q
    have nv: nw = int_mod(int_add(4096, V1.brk), pow2(64)) by defs(simp(rewrite(q1, q4)), bits_add)
    have nl: int_lt(int_add(V1.brk, 4096), 18446744073709551616) by arith(nv, vb, vs, hs, hn, q2)
    have ne: nw = int_add(V1.brk, 4096) by arith(nv, nl, vb)
    have sb: bits_sub(64, nw, 4096) = int_sub(nw, 4096) by defs(arith(ne, nl, vb), bits_sub, pow2)
    have r: int_lt(0, int_sub(nw, 4096)) && int_mod(int_sub(nw, 4096), 4096) = 0 && int_le(int_div(int_add(V1.brk, 4095), 4096), int_div(int_sub(nw, 4096), 4096)) &&
        int_div(int_add(nw, 4095), 4096) = int_add(int_div(int_sub(nw, 4096), 4096), 1) by arith(ne, vb, q2, q3)
    have r1 r2 r3 r4 := r
    have g1: g = 1 -> int_mod(bb, 4096) = 0 && int_add(int_div(bb, 4096), 1) = int_div(int_sub(nw, 4096), 4096) && x86_64_linux.pages_for(V1.brk) = int_div(bb, 4096) && bb in bits(64) proof
      assume h1
      show by arith(h1, q0)
    qed
    show by defs(taut((nw in omega && int_sub(nw, 4096) in omega by arith(ne, vb)), (nw in bits(64) by arith(ne, nl, vb)), r1, r2, sb,
      rewrite(sym(all_elim(pf, {V1.brk})), r3), rewrite(sym(all_elim(pf, {nw})), r4), g1), mp.brk_pg)
  qed
  have c1: g = 1 && A1.brk = 0 && int_mod(bb, 4096) = 0 && int_le(V1.brk, bb) && int_lt(bb, int_add(V1.brk, 4096)) && int_le(bb, 140737488351232) && nw = int_add(bb, 8192) ->
      mp.brk_pg(V1, g, nw, bb) proof
    assume q
    have _ _ q2 q3 q4 q5 q6 := q
    have sb: bits_sub(64, nw, 4096) = int_sub(nw, 4096) by defs(arith(q6, q3, q5, vb), bits_sub, pow2)
    have r: int_lt(0, int_sub(nw, 4096)) && int_mod(int_sub(nw, 4096), 4096) = 0 && int_le(int_div(int_add(V1.brk, 4095), 4096), int_div(int_sub(nw, 4096), 4096)) &&
        int_div(int_add(nw, 4095), 4096) = int_add(int_div(int_sub(nw, 4096), 4096), 1) &&
        int_add(int_div(bb, 4096), 1) = int_div(int_sub(nw, 4096), 4096) && int_div(int_add(V1.brk, 4095), 4096) = int_div(bb, 4096) by arith(q6, q2, q3, q4, q5, vb)
    have r1 r2 r3 r4 r5 r6 := r
    have g1: g = 1 -> int_mod(bb, 4096) = 0 && int_add(int_div(bb, 4096), 1) = int_div(int_sub(nw, 4096), 4096) && x86_64_linux.pages_for(V1.brk) = int_div(bb, 4096) && bb in bits(64) proof
      assume _
      show by taut(q2, r5, rewrite(sym(all_elim(pf, {V1.brk})), r6), bbb)
    qed
    show by defs(taut((nw in omega && int_sub(nw, 4096) in omega by arith(q6, q3, vb, bbb)), (nw in bits(64) by arith(q6, q5, q3, vb, bbb)), r1, r2, sb,
      rewrite(sym(all_elim(pf, {V1.brk})), r3), rewrite(sym(all_elim(pf, {nw})), r4), g1), mp.brk_pg)
  qed
  have q: mp.brk_pg(V1, g, nw, bb) by taut(jc, c0, c1)
  show := expand(q, mp.brk_pg)
qed

// (... the break's word the allocator's: memory outside it untouched)
theorem mp.jg_unt(c, A1, V1, VG, g, nw, bb, B, e): mp.am_jg(c, A1, V1, VG, g, nw, bb) -> c in mallocng.Cfg -> A1 in univ(1) -> A1 in mallocng.Abs ->
  mallocng.holds_in(c, A1, V1, B) -> int_le(int_add(c.ctx, 928), 18446744073709551616) -> mallocng.untouched(c, A1, B, V1, VG, e)
proof
  assume J hc hu ha hh hcb
  have _ _ jo _ _ _ := J
  have cx: c.ctx in omega by simp(expand(hc, mallocng.Cfg))
  have {gp = pages, gs = start} := apply(mp.jg_parts, J, cx, hcb)
  have r: all x0. x0 in omega -> (!(x0 in mallocng.footprint(c, A1, B)) && !(x0 in e)) && x86_64_linux.mapped(V1, int_div(x0, x86_64_linux.PAGE)) ->
      VG.bytes[bits_of_int(64, x0)] = V1.bytes[bits_of_int(64, x0)] && VG.pages[int_div(x0, x86_64_linux.PAGE)] = V1.pages[int_div(x0, x86_64_linux.PAGE)] proof
    fix a
    assume ho hq
    have n1 _ m0 := hq
    have ml _ := expand(m0, x86_64_linux.mapped)
    have ab: bits_of_int(64, a) = a by defs(arith(ho, expand(ml, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)), bits_of_int, pow2)
    have nc: !(int_le(int_add(c.ctx, 920), a) && int_lt(a, int_add(c.ctx, 928))) proof
      assume q
      have q1 q2 := q
      have fp := apply(mp.ctx_fp[c := c, A := A1, vm := V1, b := B, a := a], hc, hu, ha, hh, ho, arith(q1, cx), (int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE)) by arith(q2)))
      show by taut(fp, n1)
    qed
    have bb := mp(all_elim(jo, {bits_of_int(64, a)}), (bits_of_int(64, a) in bits(64) by simp()), rewrite(sym(ab), nc))
    show by taut(bb, (VG.pages[int_div(a, x86_64_linux.PAGE)] = V1.pages[int_div(a, x86_64_linux.PAGE)] by simp(gp)))
  qed
  show by defs(taut(r, gs), mallocng.untouched)
qed

// (the break asked for: not the one there is)
theorem mp.jg_ne(c, A1, V1, VG, g, nw, bb): mp.am_jg(c, A1, V1, VG, g, nw, bb) -> V1 in x86_64_linux.Vm -> !(V1.brk = nw)
proof
