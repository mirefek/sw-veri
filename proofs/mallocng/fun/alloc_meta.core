      c := int_add(c.ctx, 40), k := 8, v := bits_shr(64, 4096, 12), x := y], hy, c40, simp(), arith(cx, hcb), arith(n3, hy))
    have q2 := apply(mp.st_out[B := x86_64_linux.store_le(Vm.bytes, int_add(c.ctx, 920), 8, nw), c := int_add(c.ctx, 72), k := 8, v := bits_sub(64, nw, 4096), x := y],
      hy, c72, simp(), arith(cx, hcb), arith(n2, hy))
    have q1 := apply(mp.st_out[B := Vm.bytes, c := int_add(c.ctx, 920), k := 8, v := nw, x := y], hy, c920, simp(), arith(hcb), arith(n1, hy))
    show by simp(q3, q2, q1)
