    have a1: all q. q in omega -> x86_64_linux.mapped(V1, q) -> Vm.pages[q] = V.pages[q] proof
      fix q
      assume _ _
      show by simp(vmp)
    qed
    have a3: all a. a in bits(64) -> int_le(R2, a) -> int_lt(a, int_add(R2, 4096)) -> Vm.bytes[a] = V.bytes[a] proof
      fix a
      assume ha h1 h2
      have ne: !(a in mp.errno(s.fs_base)) proof
        assume he
        have m := apply(mp.am_emapped[c := c, A := A, B := B, s := s, V := V1, A1 := A1, a := a], S, hea, fsb, hfl, he)
        have dq: int_div(a, x86_64_linux.PAGE) = RP by arith(pg, r2v, h1, h2, rpo, ha)
