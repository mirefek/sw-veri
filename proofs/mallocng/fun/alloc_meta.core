  have c0: g = 0 && A1.brk = V1.brk && int_mod(V1.brk, 4096) = 0 && !(V1.brk = 0) && nw = bits_add(64, 4096, A1.brk) && bb = V1.brk -> !(V1.brk = nw) proof
    assume q
    have _ q1 _ _ q4 _ := q
    have nv: nw = int_mod(int_add(4096, V1.brk), pow2(64)) by defs(simp(rewrite(q1, q4)), bits_add)
    show by arith(nv, vb)
  qed
  have c1: g = 1 && A1.brk = 0 && int_mod(bb, 4096) = 0 && int_le(V1.brk, bb) && int_lt(bb, int_add(V1.brk, 4096)) && int_le(bb, 140737488351232) && nw = int_add(bb, 8192) ->
      !(V1.brk = nw) proof
    assume q
    have _ _ _ q3 _ _ q6 := q
    show by arith(q3, q6, vb)
  qed
  show by taut(jc, c0, c1)
qed

// the break refused: given up (its word -1), the reserve still empty
theorem mp.am_brkfail(c, A, B, s, V1, A1, VG, g, nw, bb): mp.am_st(c, A, B, s, V1, A1) -> c in mallocng.Cfg -> s in abi.World ->
  B in fn_space(bits(64), option(omega)) -> mallocng_specs.errno_apart(c, A, B, s.vm, s.fs_base) -> int_le(int_add(s.fs_base, 56), int_pow(2, 64)) ->
  int_le(int_add(c.ctx, 928), 18446744073709551616) -> !(A1.init_done = 0) -> A1.reserve_cnt = 0 -> mp.am_jg(c, A1, V1, VG, g, nw, bb) ->
  mp.am_st(c, A, B, s, fn_update(VG, "bytes", x86_64_linux.store_le(VG.bytes, int_add(c.ctx, 920), 8, bits_neg(64, 1))), mp.refill(A1, 0, 0, 18446744073709551615))
proof
  assume S hc hw hbt hea hfl hcb hid h0 J
  have s1 s2 s3 s4 _ _ _ _ _ := S
  have jv _ jo _ _ _ := J
  let M := 18446744073709551615
  let VF := fn_update(VG, "bytes", x86_64_linux.store_le(VG.bytes, int_add(c.ctx, 920), 8, bits_neg(64, 1)))
  have cx: c.ctx in omega by simp(expand(hc, mallocng.Cfg))
  have c920: int_add(c.ctx, 920) in bits(64) by arith(cx, hcb)
  have {gp = pages, gt = top, gl = lim, gs = start, gw = words} := apply(mp.jg_parts, J, cx, hcb)
  have vfV: VF in x86_64_linux.Vm := mp(all_elim(ms.wr_any, {VG}, {int_add(c.ctx, 920)}, {8}, {bits_neg(64, 1)}), jv)
  have {w40 = cnt_raw, w48 = shift} := apply(mp.am_words[c := c, A := A1, V := V1, b := B], hc, s3, s2, s4, s1)
  // (the words below the break's: V1's)
  have kw: all off. off in omega -> int_le(int_add(off, 8), 920) -> gimple.bytes_at(VF, int_add(c.ctx, off), 8) = gimple.bytes_at(V1, int_add(c.ctx, off), 8) proof
    fix off
    assume ho hl
    have r: gimple.bytes_at(VF, int_add(c.ctx, off), 8) = gimple.bytes_at(VG, int_add(c.ctx, off), 8) by mem(conj(cx, hcb, ho, hl))
    show := trans(r, mp(all_elim(gw, {off}), ho, hl))
  qed
  have f40: gimple.bytes_at(VF, int_add(c.ctx, 40), 8) = 0 := trans(trans(mp(all_elim(kw, {40}), simp(), simp()), w40), h0)
  have f48: int_le(gimple.bytes_at(VF, int_add(c.ctx, 48), 8), 34) := rewrite(sym(mp(all_elim(kw, {48}), simp(), simp())), w48)
  have f920: gimple.bytes_at(VF, int_add(c.ctx, 920), 8) = M by mem(conj(cx, hcb))
  have by: all y. y in bits(64) -> x86_64_linux.mapped(V1, int_div(y, x86_64_linux.PAGE)) -> !mp.rfbyte(c, y) -> VF.bytes[y] = V1.bytes[y] proof
    fix y
    assume hy _ hn
    have n9: !(int_le(int_add(c.ctx, 920), y) && int_lt(y, int_add(c.ctx, 928))) proof
      assume q
      show by taut(hn, (mp.rfbyte(c, y) by defs(taut(q), mp.rfbyte)))
    qed
    have o1: int_le(int_add(int_add(c.ctx, 920), 8), y) || int_lt(y, int_add(c.ctx, 920)) by arith(n9, hy)
    have q1 := apply(mp.st_out[B := VG.bytes, c := int_add(c.ctx, 920), k := 8, v := bits_neg(64, 1), x := y], hy, c920, simp(), arith(hcb), o1)
    show by simp(q1, mp(all_elim(jo, {y}), hy, n9))
  qed
  have pg: all q. q in omega -> x86_64_linux.mapped(V1, q) -> VF.pages[q] = V1.pages[q] proof
    fix q
    assume _ _
    show by simp(gp)
  qed
  have rest := apply(mp.vm_rest[V := VF, W := V1], vfV, s1, (VF.stack_top = V1.stack_top by simp(gt)), (VF.stack_limit = V1.stack_limit by simp(gl)), (VF.brk_start = V1.brk_start by simp(gs)))
  have bo: mallocng.brk_ok(mp.refill(A1, 0, 0, M), VF.brk) by defs(simp(), mallocng.brk_ok)
  have fr: all a. a in omega -> int_le(0, a) -> int_lt(a, int_add(0, int_mul(4096, 0))) -> !x86_64_linux.mapped(V1, int_div(a, x86_64_linux.PAGE)) proof
    fix a
    assume _ _ hl
    show by arith(hl)
  qed
  have np: all a. a in omega -> int_le(0, a) -> int_lt(a, int_add(0, int_mul(4096, 0))) ->
      (mallocng.m_mapped(mallocng.mview(VF, mallocng.all_bytes()), a) && !(snd(mallocng.pg(mallocng.mview(VF, mallocng.all_bytes()), a)).kind = 2)) &&
      mallocng.b8(mallocng.mview(VF, mallocng.all_bytes()), a) = 0 proof
    fix a
    assume _ _ hl
    show by arith(hl)
  qed
  have w72: int_lt(0, 0) -> gimple.bytes_at(VF, int_add(c.ctx, 72), 8) = 0 proof
    assume hl
    show by arith(hl)
  qed
  have P: mp.rfpre(c, A1, V1, VF, B, 0, 0, M) by taut(hc, s3, s2, hbt, s1, vfV, s4, hid, h0, (0 in omega && 0 in omega && M in omega by simp()),
    (0 = 0 && 0 = 0 by simp()), (int_mod(0, 4096) = 0 by simp()), fr, np, pg, by, rest, bo, f40, f48, w72, f920)
  show := apply(mp.am_rf, S, hw, hea, hfl, P)
qed

// (a byte of the reserve: held)
theorem mp.res_held(c, A, vm, b, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_in(c, A, vm, b) -> a in omega ->
  int_le(A.reserve, a) -> int_lt(a, int_add(A.reserve, int_mul(4096, A.reserve_cnt))) -> a in mallocng.held(c, A, b)
proof
  assume hc hu ha hh hao h1 h2
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {huo = used, hga = apart, hff = fixed} := expand(H, mallocng.holds)
  have {fr = reserve} := expand(hff, mallocng.fixed_free)
  have nl := mp(all_elim(fr, {a}), hao, conj(h1, h2))
  have inr: mallocng.in_range(a, pair(A.reserve, int_mul(4096, A.reserve_cnt))) by defs(simp(h1, h2), mallocng.in_range)
  have o := apply(mp.ranges_one[a := a, r := pair(A.reserve, int_mul(4096, A.reserve_cnt))])
  have ir: mallocng.in_ranges(a, seq_one(pair(A.reserve, int_mul(4096, A.reserve_cnt)))) by taut(o, inr)
  have nres := apply(mp.fixed_unres[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, a := a], hc, hu, ha, hao, huo, hga, taut(ir))
  have na: all k. k in omega -> int_lt(k, seq_len(A.areas)) -> !(int_le(A.areas[k], a) && int_lt(a, int_add(A.areas[k], 4096))) proof
    fix k
    assume hk hkl
    assume w
    have w1 w2 := w
    have {rs = reserve} := apply(mp.area_apart[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, brk := vm.brk, k := k, a := a],
      hc, hu, ha, H, hk, hkl, hao, w1, w2)
    show by taut(rs, inr)
  qed
  have nt := apply(mp.untaken_of[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, brk := vm.brk, a := a], hc, hu, ha, H, hao, na)
  have fp := apply(mp.fp_intro[c := c, A := A, b := b, a := a], hc, hu, ha, hao, nl, nres, nt, taut(ir))
  have ex: (ex i. i in omega && int_lt(i, 3) && mallocng.in_range(a, mallocng.data_ranges(c)[i])) -> false proof
    assume e
    show by taut(apply(mp.not_res[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, brk := vm.brk, a := a], hc, hu, ha, H, taut(e)), inr)
  qed
  have d0 _ _ := mp.data_at[c := c]
  have nc: !(int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, 928))) proof
    assume w
    have i0: mallocng.in_range(a, mallocng.data_ranges(c)[0]) by defs(simp(d0, w), mallocng.in_range)
    show by taut(ex, (ex i. i in omega && int_lt(i, 3) && mallocng.in_range(a, mallocng.data_ranges(c)[i]) by ex_intro({0}, taut((0 in omega by simp()), (int_lt(0, 3) by simp()), i0))))
  qed
  have co: c.ctx in omega by simp(hc)
  have nf: !mallocng.ctx_free(c, a) by defs(arith(nc, co), mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK)
  show := apply(mp.held_intro, fp, nf)
qed

// (the reserve, pages in it: its word in the context; page aligned, not
// 0, below the user space's end; its pages mapped, not the stack)
theorem mp.am_rword(c, A, V, b): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_in(c, A, V, b) -> int_lt(0, A.reserve_cnt) ->
  raw: gimple.bytes_at(V, int_add(c.ctx, 72), 8) = A.reserve && bv: bits_of_int(64, gimple.bytes_at(V, int_add(c.ctx, 72), 8)) = A.reserve &&
  al: int_mod(A.reserve, 4096) = 0 && pos: int_lt(0, A.reserve) && end: int_le(int_add(A.reserve, int_mul(4096, A.reserve_cnt)), 140737488351232) &&
  pg: (all a. a in omega -> int_le(A.reserve, a) -> int_lt(a, int_add(A.reserve, int_mul(4096, A.reserve_cnt))) ->
    x86_64_linux.mapped(V, int_div(a, x86_64_linux.PAGE)) && !(snd(V.pages[int_div(a, x86_64_linux.PAGE)]).kind = 2))
proof
  assume hc hu ha hh hr
  have cx: c.ctx in omega by simp(expand(hc, mallocng.Cfg))
  have nf: all i. i in omega -> int_lt(i, 8) -> !mallocng.ctx_free(c, int_add(int_add(c.ctx, 72), i)) proof
    fix i
    assume hi hil
    show by defs(arith(hi, hil, cx), mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK)
  qed
  have rd72 := apply(mp.ctx_read[c := c, A := A, vm := V, b := b, off := 72, n := 8], hc, hu, ha, hh, simp(), simp(), arith(), nf)
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {cok = ctx, har = areas, hnm = normal} := expand(H, mallocng.holds)
  have {k7 = avail_areas} := expand(cok, mallocng.ctx_ok)
  have kaa: mallocng.C_AVAIL_AREAS = 72 by defs(refl({72}), mallocng.C_AVAIL_AREAS)
  have cw ral := mp(rewrite(kaa, k7), hr)
  have e72 := trans(rd72, expand(cw, mallocng.ctx_word))
  have ro: A.reserve in omega by simp(ha)
  have co: A.reserve_cnt in omega by simp(ha)
  have _ _ n3 _ := expand(hnm, mallocng.normal)
  have rnz: !(A.reserve = 0) by taut(n3, (!(A.reserve_cnt = 0) by arith(hr)))
  have {ar = reserve} := expand(har, mallocng.areas_ok)
  let L := int_sub(int_add(A.reserve, int_mul(4096, A.reserve_cnt)), 1)
  have mm _ _ := mp(all_elim(ar, {L}), arith(ro, co, hr), arith(ro, co, hr))
  have lt _ := expand(mm, mallocng.m_mapped)
  have en: int_le(int_add(A.reserve, int_mul(4096, A.reserve_cnt)), 140737488351232) by arith(lt, ro, co, hr)
  have bv: bits_of_int(64, gimple.bytes_at(V, int_add(c.ctx, 72), 8)) = A.reserve by defs(arith(e72, en, ro), bits_of_int, pow2)
  have pq: all a. a in omega -> int_le(A.reserve, a) -> int_lt(a, int_add(A.reserve, int_mul(4096, A.reserve_cnt))) ->
      x86_64_linux.mapped(V, int_div(a, x86_64_linux.PAGE)) && !(snd(V.pages[int_div(a, x86_64_linux.PAGE)]).kind = 2) proof
    fix a
    assume hao h1 h2
    have hd := apply(mp.res_held[c := c, A := A, vm := V, b := b, a := a], hc, hu, ha, hh, hao, h1, h2)
    have m1 k1 _ := mp(all_elim(ar, {a}), hao, conj(h1, h2))
    have ml mn := expand(m1, mallocng.m_mapped)
    have pv := apply(mp.pg_view[vm := V, fp := mallocng.held(c, A, b), a := a], hao, hd)
    show by taut((x86_64_linux.mapped(V, int_div(a, x86_64_linux.PAGE)) by defs(taut(ml, rewrite(pv, mn)), x86_64_linux.mapped)), rewrite(pv, k1))
  qed
  show by taut(e72, bv, ral, (int_lt(0, A.reserve) by arith(ro, rnz)), en, pq)
qed

// (two memories' pages past the user space: alike -- none)
theorem mp.pages_out(V, W, q): V in x86_64_linux.Vm -> W in x86_64_linux.Vm -> !int_lt(q, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) -> V.pages[q] = W.pages[q]
proof
  assume hv hw hq
  let PN := set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)))
  have vp: V.pages in fn_space(PN, option(x86_64_linux.Page)) by simp(expand(hv, x86_64_linux.Vm))
  have wp: W.pages in fn_space(PN, option(x86_64_linux.Page)) by simp(expand(hw, x86_64_linux.Vm))
  have _ vd := (is_fun(V.pages) && dom(V.pages) = PN by simp(expand(vp, fn_space)))
  have _ wd := (is_fun(W.pages) && dom(W.pages) = PN by simp(expand(wp, fn_space)))
  have nq: !(q in PN) by simp(hq)
  have both: all y. (pair(q, y) in V.pages <-> pair(q, y) in W.pages) proof
    fix y
    have n1: !(pair(q, y) in V.pages) proof
      assume h
      show by taut(nq, rewrite(vd, apply(dom_intro[f := V.pages, k := q, v := y], h)))
    qed
    have n2: !(pair(q, y) in W.pages) proof
      assume h
      show by taut(nq, rewrite(wd, apply(dom_intro[f := W.pages, k := q, v := y], h)))
    qed
    show by taut(n1, n2)
  qed
  show := apply(app_ext[f := V.pages, g := W.pages, x := q], both)
qed

// the reserve's first page a new area (accessible: from brk, or made so):
// its count and the reserve moved on, the area linked in (after the last
// one -- ln its next link -- or as the first: ln the head word), its
// check and slot count, the context's metas its own; a run state, metas
// available
abbrev mp.am_nachain(c, A4, X, ln) := x86_64_linux.store_le(x86_64_linux.store_le(x86_64_linux.store_le(x86_64_linux.store_le(x86_64_linux.store_le(
  x86_64_linux.store_le(x86_64_linux.store_le(x86_64_linux.store_le(X, int_add(c.ctx, 40), 8, int_sub(A4.reserve_cnt, 1)), int_add(c.ctx, 72), 8, int_add(A4.reserve, 4096)),
  ln, 8, A4.reserve), int_add(c.ctx, 64), 8, A4.reserve), int_add(A4.reserve, 0), 8, A4.secret), int_add(A4.reserve, 16), 4, 101), int_add(c.ctx, 32), 8, 101),
  int_add(c.ctx, 24), 8, int_add(A4.reserve, 24))

// (the last area's next link: usable)
theorem mp.hdr_use(c, A, vm, b, objs): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_in(c, A, vm, b) -> int_lt(0, seq_len(A.areas)) ->
  gimple.usable(vm, objs, int_add(A.areas[int_sub(seq_len(A.areas), 1)], 8), 8, false) && gimple.usable(vm, objs, int_add(A.areas[int_sub(seq_len(A.areas), 1)], 8), 8, true)
proof
  assume hc hu ha hh hn
  let L := A.areas[int_sub(seq_len(A.areas), 1)]
  have aln: A.areas in list_type(omega) by simp(ha)
  have nao: seq_len(A.areas) in omega by arith(aln)
  let k := int_sub(seq_len(A.areas), 1)
  have ko: k in omega by arith(hn, nao)
  have kl: int_lt(k, seq_len(A.areas)) by arith(hn, nao)
  have lo: L in omega := apply(at_type[l := A.areas, t := omega, i := k], aln, ko, kl)
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {har = areas} := expand(H, mallocng.holds)
  have {each = each} := expand(har, mallocng.areas_ok)
  have _ _ _ _ _ acc := mp(all_elim(each, {k}), ko, kl)
  have ea: all i. i in omega -> int_lt(i, 8) -> int_add(int_add(L, 8), i) in mallocng.held(c, A, b) &&
      mallocng.m_rw(mallocng.mview(vm, mallocng.held(c, A, b)), int_add(int_add(L, 8), i)) &&
      !(snd(mallocng.pg(mallocng.mview(vm, mallocng.held(c, A, b)), int_add(int_add(L, 8), i))).kind = 2) proof
    fix i
    assume hi hil
    let a := int_add(int_add(L, 8), i)
    have ao: a in omega by arith(lo, hi)
    have hd := apply(mp.hdr_held[c := c, A := A, vm := vm, b := b, k := k, a := a], hc, hu, ha, hh, ko, kl, ao, arith(lo, hi), arith(hil, lo))
    have {hf = fp} := apply(mp.held_fp, hd)
    have nt: !mallocng.in_taken(A, a) by simp(expand(hf, mallocng.footprint))
    have rw kd := mp(all_elim(acc, {a}), ao, conj(conj((int_le(L, a) by arith(lo, hi)), (int_lt(a, int_add(L, 4096)) by arith(hil, lo))), nt))
    show by taut(hd, rw, kd)
  qed
  show := apply(mp.rw_usable[vm := vm, F := mallocng.held(c, A, b), objs := objs, a := int_add(L, 8), n := 8], arith(lo), ea)
qed

// (two ranges no byte of which is in both: one below the other)
theorem mp.apart_rng(x, n, y, m): x in omega -> y in omega -> int_lt(0, n) -> int_lt(0, m) ->
  (all a. a in omega -> int_le(x, a) -> int_lt(a, int_add(x, n)) -> !(int_le(y, a) && int_lt(a, int_add(y, m)))) ->
  int_le(int_add(x, n), y) || int_le(int_add(y, m), x)
proof
  assume hx hy hn hm h
  have c1: int_le(y, x) -> int_le(int_add(y, m), x) proof
    assume l
    have q := mp(all_elim(h, {x}), hx, arith(hx), arith(hn))
    show by arith(q, l, hx, hy)
  qed
  have c2: int_lt(x, y) -> int_le(int_add(x, n), y) proof
    assume l
    have q: int_lt(y, int_add(x, n)) -> false proof
      assume l2
      have q0 := mp(all_elim(h, {y}), hy, arith(l), l2)
      show by arith(q0, hm, hy)
    qed
    show by arith(q, hx, hy)
  qed
  show by taut(c1, c2, (int_le(y, x) || int_lt(x, y) by arith(hx, hy)))
qed

// (the last area's page: apart from the context's, from the reserve's)
theorem mp.last_pg(c, A, vm, b): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_in(c, A, vm, b) -> int_lt(0, seq_len(A.areas)) ->
  int_lt(0, A.reserve_cnt) ->
  nat: A.areas[int_sub(seq_len(A.areas), 1)] in omega && pos: int_lt(0, A.areas[int_sub(seq_len(A.areas), 1)]) &&
  al: int_mod(A.areas[int_sub(seq_len(A.areas), 1)], 4096) = 0 &&
  ctx: (int_le(int_add(A.areas[int_sub(seq_len(A.areas), 1)], 4096), c.ctx) || int_le(int_add(c.ctx, 928), A.areas[int_sub(seq_len(A.areas), 1)])) &&
  res: (int_le(int_add(A.areas[int_sub(seq_len(A.areas), 1)], 4096), A.reserve) || int_le(int_add(A.reserve, 4096), A.areas[int_sub(seq_len(A.areas), 1)])) &&
  lt: int_lt(int_add(A.areas[int_sub(seq_len(A.areas), 1)], 23), 18446744073709551616)
proof
  assume hc hu ha hh hn hr
  have cx: c.ctx in omega by simp(expand(hc, mallocng.Cfg))
  have ro: A.reserve in omega by simp(ha)
  have co: A.reserve_cnt in omega by simp(ha)
  have {H = inv} := expand(hh, mallocng.holds_in)
  have d0 _ _ := mp.data_at[c := c]
  let L := A.areas[int_sub(seq_len(A.areas), 1)]
  have aln: A.areas in list_type(omega) by simp(ha)
  have nao: seq_len(A.areas) in omega by arith(aln)
  let k := int_sub(seq_len(A.areas), 1)
  have ko: k in omega by arith(hn, nao)
  have kl: int_lt(k, seq_len(A.areas)) by arith(hn, nao)
  have {har = areas} := expand(H, mallocng.holds)
  have {each = each} := expand(har, mallocng.areas_ok)
  have lal lpos _ _ _ _ := mp(all_elim(each, {k}), ko, kl)
  have lo: L in omega := apply(at_type[l := A.areas, t := omega, i := k], aln, ko, kl)
  have nb1: all a. a in omega -> int_le(L, a) -> int_lt(a, int_add(L, 4096)) -> !(int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, 928))) proof
    fix a
    assume hao h1 h2
    have {dt = data} := apply(mp.area_apart[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, brk := vm.brk, k := k, a := a], hc, hu, ha, H, ko, kl, hao, h1, h2)
    have n0 := mp(all_elim(dt, {0}), simp(), simp())
    assume w
    show by taut(n0, (mallocng.in_range(a, mallocng.data_ranges(c)[0]) by defs(simp(d0, w), mallocng.in_range)))
  qed
  have nb2: all a. a in omega -> int_le(L, a) -> int_lt(a, int_add(L, 4096)) -> !(int_le(A.reserve, a) && int_lt(a, int_add(A.reserve, 4096))) proof
    fix a
    assume hao h1 h2
    have {rs = reserve} := apply(mp.area_apart[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, brk := vm.brk, k := k, a := a], hc, hu, ha, H, ko, kl, hao, h1, h2)
    assume w
    have w1 w2 := w
    show by taut(rs, (mallocng.in_range(a, pair(A.reserve, int_mul(4096, A.reserve_cnt))) by defs(simp(w1, (int_lt(a, int_add(A.reserve, int_mul(4096, A.reserve_cnt))) by arith(w2, hr, co, ro))), mallocng.in_range)))
  qed
  have a1 := apply(mp.apart_rng[x := L, n := 4096, y := c.ctx, m := 928], lo, cx, simp(), simp(), nb1)
  have a2 := apply(mp.apart_rng[x := L, n := 4096, y := A.reserve, m := 4096], lo, ro, simp(), simp(), nb2)
  have hd := apply(mp.hdr_held[c := c, A := A, vm := vm, b := b, k := k, a := int_add(L, 23)], hc, hu, ha, hh, ko, kl, arith(lo), arith(lo), arith(lo))
  have {hf = fp} := apply(mp.held_fp, hd)
  have {hm = mapped} := expand(hh, mallocng.holds_in)
  have l23 := apply(mp.fp_low[c := c, A := A, vm := vm, b := b, a := int_add(L, 23)], hm, hf)
  show by taut(lo, (int_lt(0, L) by arith(lpos, lo)), lal, a1, a2, l23)
qed

// (the reserve's page apart from the context)
theorem mp.res_ctx(c, A, vm, b): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_in(c, A, vm, b) -> int_lt(0, A.reserve_cnt) ->
  int_le(int_add(A.reserve, 4096), c.ctx) || int_le(int_add(c.ctx, 928), A.reserve)
proof
  assume hc hu ha hh hr
  have cx: c.ctx in omega by simp(expand(hc, mallocng.Cfg))
  have ro: A.reserve in omega by simp(ha)
  have co: A.reserve_cnt in omega by simp(ha)
  have {H = inv} := expand(hh, mallocng.holds_in)
  have d0 _ _ := mp.data_at[c := c]
  have nb: all a. a in omega -> int_le(A.reserve, a) -> int_lt(a, int_add(A.reserve, 4096)) -> !(int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, 928))) proof
    fix a
    assume hao h1 h2
    assume w
    have i0: mallocng.in_range(a, mallocng.data_ranges(c)[0]) by defs(simp(d0, w), mallocng.in_range)
    have ex0: ex i. i in omega && int_lt(i, 3) && mallocng.in_range(a, mallocng.data_ranges(c)[i]) by ex_intro({0}, taut((0 in omega by simp()), (int_lt(0, 3) by simp()), i0))
    have nr := apply(mp.not_res[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, brk := vm.brk, a := a], hc, hu, ha, H, taut(ex0))
    show by taut(nr, (mallocng.in_range(a, pair(A.reserve, int_mul(4096, A.reserve_cnt))) by defs(simp(h1, (int_lt(a, int_add(A.reserve, int_mul(4096, A.reserve_cnt))) by arith(h2, hr, co, ro))), mallocng.in_range)))
  qed
  show := apply(mp.apart_rng[x := A.reserve, n := 4096, y := c.ctx, m := 928], ro, cx, simp(), simp(), nb)
qed

theorem mp.am_na(c, A, B, s, V4, A4, V5, ln): mp.am_st(c, A, B, s, V4, A4) -> c in mallocng.Cfg -> s in abi.World ->
  B in fn_space(bits(64), option(omega)) -> mallocng_specs.errno_apart(c, A, B, s.vm, s.fs_base) -> int_le(int_add(s.fs_base, 56), int_pow(2, 64)) ->
  int_le(int_add(c.ctx, 928), 18446744073709551616) -> A4.avail_cnt = 0 -> int_lt(0, A4.reserve_cnt) ->
  (V5 in x86_64_linux.Vm && fn_update(V5, "pages", V4.pages) = V4) -> (all q. q in omega -> !(q = int_div(A4.reserve, 4096)) -> V5.pages[q] = V4.pages[q]) ->
  mallocng.m_rw(mallocng.mview(V5, mallocng.all_bytes()), A4.reserve) -> !(snd(mallocng.pg(mallocng.mview(V5, mallocng.all_bytes()), A4.reserve)).kind = 2) ->
  ((seq_len(A4.areas) = 0 && ln = int_add(c.ctx, 56)) || (int_lt(0, seq_len(A4.areas)) && ln = int_add(A4.areas[int_sub(seq_len(A4.areas), 1)], 8))) ->
  st: mp.am_st(c, A, B, s, fn_update(V5, "bytes", mp.am_nachain(c, A4, V5.bytes, ln)), mp.narea(A4)) &&
  avail: int_lt(0, mp.narea(A4).avail_cnt) && init: !(mp.narea(A4).init_done = 0)
proof
  assume S hc hw hbt hea hfl hcb h0 hr hv5 hpq hrw hkd hln
  have v5V v5r := hv5
  have s1 s2 s3 s4 _ _ _ sgr _ := S
  have cx: c.ctx in omega by simp(expand(hc, mallocng.Cfg))
  let R := A4.reserve
  have {qal = al, qpos = pos, qend = end} := apply(mp.am_rword[c := c, A := A4, V := V4, b := B], hc, s3, s2, s4, hr)
  have ro: R in omega by simp(s2)
  have co: A4.reserve_cnt in omega by simp(s2)
  have {H = inv} := expand(s4, mallocng.holds_in)
  // (the reserve's page apart from the context)
  have d0 _ _ := mp.data_at[c := c]
  have rcx: int_le(int_add(R, 4096), c.ctx) || int_le(int_add(c.ctx, 928), R) proof
    have nb: all a. a in omega -> int_le(R, a) -> int_lt(a, int_add(R, 4096)) -> !(int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, 928))) proof
      fix a
      assume hao h1 h2
      assume w
      have i0: mallocng.in_range(a, mallocng.data_ranges(c)[0]) by defs(simp(d0, w), mallocng.in_range)
      have ex0: ex i. i in omega && int_lt(i, 3) && mallocng.in_range(a, mallocng.data_ranges(c)[i]) by ex_intro({0}, taut((0 in omega by simp()), (int_lt(0, 3) by simp()), i0))
      have nr := apply(mp.not_res[c := c, A := A4, M := mallocng.mview(V4, mallocng.held(c, A4, B)), b := B, brk := V4.brk, a := a], hc, s3, s2, H, taut(ex0))
      show by taut(nr, (mallocng.in_range(a, pair(A4.reserve, int_mul(4096, A4.reserve_cnt))) by defs(simp(h1, (int_lt(a, int_add(A4.reserve, int_mul(4096, A4.reserve_cnt))) by arith(h2, hr, co, ro))), mallocng.in_range)))
    qed
    show := apply(mp.apart_rng[x := R, n := 4096, y := c.ctx, m := 928], ro, cx, simp(), simp(), nb)
  qed
  // (the last area's page apart from both)
  let NA := seq_len(A4.areas)
  let L := A4.areas[int_sub(NA, 1)]
  have lpg: int_lt(0, NA) -> (L in omega && int_lt(0, L)) && (int_le(int_add(L, 4096), c.ctx) || int_le(int_add(c.ctx, 928), L)) &&
      (int_le(int_add(L, 4096), R) || int_le(int_add(R, 4096), L)) && int_lt(int_add(L, 23), 18446744073709551616) proof
    assume hn
    have aln: A4.areas in list_type(omega) by simp(s2)
    have nao: NA in omega by arith(aln)
    let k := int_sub(NA, 1)
    have ko: k in omega by arith(hn, nao)
    have kl: int_lt(k, NA) by arith(hn, nao)
    have {har = areas} := expand(H, mallocng.holds)
    have {each = each} := expand(har, mallocng.areas_ok)
    have _ lpos _ _ _ _ := mp(all_elim(each, {k}), ko, kl)
    have lo: L in omega := apply(at_type[l := A4.areas, t := omega, i := k], aln, ko, kl)
    have nb1: all a. a in omega -> int_le(L, a) -> int_lt(a, int_add(L, 4096)) -> !(int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, 928))) proof
      fix a
      assume hao h1 h2
      have {dt = data} := apply(mp.area_apart[c := c, A := A4, M := mallocng.mview(V4, mallocng.held(c, A4, B)), b := B, brk := V4.brk, k := k, a := a], hc, s3, s2, H, ko, kl, hao, h1, h2)
      have n0 := mp(all_elim(dt, {0}), simp(), simp())
      assume w
      show by taut(n0, (mallocng.in_range(a, mallocng.data_ranges(c)[0]) by defs(simp(d0, w), mallocng.in_range)))
    qed
    have nb2: all a. a in omega -> int_le(L, a) -> int_lt(a, int_add(L, 4096)) -> !(int_le(R, a) && int_lt(a, int_add(R, 4096))) proof
      fix a
      assume hao h1 h2
      have {rs = reserve} := apply(mp.area_apart[c := c, A := A4, M := mallocng.mview(V4, mallocng.held(c, A4, B)), b := B, brk := V4.brk, k := k, a := a], hc, s3, s2, H, ko, kl, hao, h1, h2)
      assume w
      have w1 w2 := w
      show by taut(rs, (mallocng.in_range(a, pair(A4.reserve, int_mul(4096, A4.reserve_cnt))) by defs(simp(w1, (int_lt(a, int_add(A4.reserve, int_mul(4096, A4.reserve_cnt))) by arith(w2, hr, co, ro))), mallocng.in_range)))
    qed
    have a1 := apply(mp.apart_rng[x := L, n := 4096, y := c.ctx, m := 928], lo, cx, simp(), simp(), nb1)
    have a2 := apply(mp.apart_rng[x := L, n := 4096, y := R, m := 4096], lo, ro, simp(), simp(), nb2)
    have hd := apply(mp.hdr_held[c := c, A := A4, vm := V4, b := B, k := k, a := int_add(L, 23)], hc, s3, s2, s4, ko, kl, arith(lo), arith(lo), arith(lo))
    have {hf = fp} := apply(mp.held_fp, hd)
    have {hm = mapped} := expand(s4, mallocng.holds_in)
    have l23 := apply(mp.fp_low[c := c, A := A4, vm := V4, b := B, a := int_add(L, 23)], hm, hf)
    show by taut(lo, (int_lt(0, L) by arith(lpos, lo)), a1, a2, l23)
  qed
  // (the link word: apart from the other words written)
  have lnd: ln in omega && int_le(int_add(ln, 8), 18446744073709551616) &&
      (int_le(int_add(ln, 8), int_add(c.ctx, 24)) || (int_le(int_add(c.ctx, 48), ln) && int_le(int_add(ln, 8), int_add(c.ctx, 64))) || int_le(int_add(c.ctx, 80), ln)) &&
      (int_le(int_add(ln, 8), R) || int_le(int_add(R, 20), ln)) proof
    have h1: seq_len(A4.areas) = 0 && ln = int_add(c.ctx, 56) -> ln in omega && int_le(int_add(ln, 8), 18446744073709551616) &&
        (int_le(int_add(ln, 8), int_add(c.ctx, 24)) || (int_le(int_add(c.ctx, 48), ln) && int_le(int_add(ln, 8), int_add(c.ctx, 64))) || int_le(int_add(c.ctx, 80), ln)) &&
        (int_le(int_add(ln, 8), R) || int_le(int_add(R, 20), ln)) proof
      assume q
      have _ q2 := q
      show by arith(q2, cx, hcb, rcx, ro)
    qed
    have h2: int_lt(0, seq_len(A4.areas)) && ln = int_add(A4.areas[int_sub(seq_len(A4.areas), 1)], 8) -> ln in omega && int_le(int_add(ln, 8), 18446744073709551616) &&
        (int_le(int_add(ln, 8), int_add(c.ctx, 24)) || (int_le(int_add(c.ctx, 48), ln) && int_le(int_add(ln, 8), int_add(c.ctx, 64))) || int_le(int_add(c.ctx, 80), ln)) &&
        (int_le(int_add(ln, 8), R) || int_le(int_add(R, 20), ln)) proof
      assume q
      have q1 q2 := q
      have lo _ lc lr l23 := mp(lpg, q1)
      show by arith(q2, lo, lc, lr, l23, cx, hcb, qend, ro, co, hr)
    qed
    show by taut(hln, h1, h2)
  qed
  have lno lnb lnc lnr := lnd
  have rb: R in bits(64) by arith(qend, ro, co, hr)
  have rlt: int_le(int_add(R, 4096), 140737488351232) by arith(qend, ro, co, hr)
  let CN := A4.reserve_cnt
  let X0 := V5.bytes
  let X1 := x86_64_linux.store_le(X0, int_add(c.ctx, 40), 8, int_sub(CN, 1))
  let X2 := x86_64_linux.store_le(X1, int_add(c.ctx, 72), 8, int_add(R, 4096))
  let X3 := x86_64_linux.store_le(X2, ln, 8, R)
  let X4 := x86_64_linux.store_le(X3, int_add(c.ctx, 64), 8, R)
  let X5 := x86_64_linux.store_le(X4, int_add(R, 0), 8, A4.secret)
  let X6 := x86_64_linux.store_le(X5, int_add(R, 16), 4, 101)
  let X7 := x86_64_linux.store_le(X6, int_add(c.ctx, 32), 8, 101)
  let X8 := x86_64_linux.store_le(X7, int_add(c.ctx, 24), 8, int_add(R, 24))
  let VD := fn_update(V5, "bytes", X8)
  have ub := mp(app_update_other[f := V5, k := "pages", v := V4.pages, x := "bytes"], (!("bytes" = "pages") by simp()))
  have eb: V5.bytes = V4.bytes := sym(rewrite(v5r, ub))
  have bc: all off. off in omega -> int_le(int_add(off, 8), 928) -> int_add(c.ctx, off) in bits(64) proof
    fix off
    assume ho hl
    show by arith(cx, ho, hl, hcb)
  qed
  // (bytes but the area's words: V4's)
  have byd: all y. y in bits(64) -> !mp.nabyte(c, A4, y) -> VD.bytes[y] = V4.bytes[y] proof
    fix y
    assume hy hn
    have nb := expand(hn, mp.nabyte)
    have ln1: !(int_le(ln, y) && int_lt(y, int_add(ln, 8))) proof
      have g1: seq_len(A4.areas) = 0 && ln = int_add(c.ctx, 56) -> !(int_le(ln, y) && int_lt(y, int_add(ln, 8))) proof
        assume q
        have q1 q2 := q
        show by arith(nb, q1, q2)
      qed
      have g2: int_lt(0, seq_len(A4.areas)) && ln = int_add(A4.areas[int_sub(seq_len(A4.areas), 1)], 8) -> !(int_le(ln, y) && int_lt(y, int_add(ln, 8))) proof
        assume q
        have q1 q2 := q
        show by arith(nb, q1, q2)
      qed
      show by taut(hln, g1, g2)
    qed
    have o8 := apply(mp.st_out[B := X7, c := int_add(c.ctx, 24), k := 8, v := int_add(R, 24), x := y], hy, mp(all_elim(bc, {24}), simp(), simp()), simp(), arith(cx, hcb), arith(nb, hy))
    have o7 := apply(mp.st_out[B := X6, c := int_add(c.ctx, 32), k := 8, v := 101, x := y], hy, mp(all_elim(bc, {32}), simp(), simp()), simp(), arith(cx, hcb), arith(nb, hy))
    have o6 := apply(mp.st_out[B := X5, c := int_add(R, 16), k := 4, v := 101, x := y], hy, arith(rb, rlt), simp(), arith(rlt, ro), arith(nb, hy))
    have o5 := apply(mp.st_out[B := X4, c := int_add(R, 0), k := 8, v := A4.secret, x := y], hy, arith(rb), simp(), arith(rlt, ro), arith(nb, hy))
    have o4 := apply(mp.st_out[B := X3, c := int_add(c.ctx, 64), k := 8, v := R, x := y], hy, mp(all_elim(bc, {64}), simp(), simp()), simp(), arith(cx, hcb), arith(nb, hy))
    have o3 := apply(mp.st_out[B := X2, c := ln, k := 8, v := R, x := y], hy, arith(lno, lnb), simp(), lnb, arith(ln1, hy))
    have o2 := apply(mp.st_out[B := X1, c := int_add(c.ctx, 72), k := 8, v := int_add(R, 4096), x := y], hy, mp(all_elim(bc, {72}), simp(), simp()), simp(), arith(cx, hcb), arith(nb, hy))
    have o1 := apply(mp.st_out[B := X0, c := int_add(c.ctx, 40), k := 8, v := int_sub(CN, 1), x := y], hy, mp(all_elim(bc, {40}), simp(), simp()), simp(), arith(cx, hcb), arith(nb, hy))
    show by simp(o8, o7, o6, o5, o4, o3, o2, o1, eb)
  qed
  // (the words read back)
  have nf0: all i. i in omega -> int_lt(i, 8) -> !mallocng.ctx_free(c, int_add(int_add(c.ctx, 0), i)) proof
    fix i
    assume hi hil
    show by defs(arith(hi, hil, cx), mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK)
  qed
  have rd0 := apply(mp.ctx_read[c := c, A := A4, vm := V4, b := B, off := 0, n := 8], hc, s3, s2, s4, simp(), simp(), arith(), nf0)
  have {cok = ctx} := expand(H, mallocng.holds)
  have {csec = secret} := expand(cok, mallocng.ctx_ok)
  have ksec: mallocng.C_SECRET = 0 by defs(refl({0}), mallocng.C_SECRET)
  have esec := trans(rd0, expand(rewrite(ksec, csec), mallocng.ctx_word))
  have v4b: V4.bytes in fn_space(bits(64), bits(8)) by simp(expand(s1, x86_64_linux.Vm))
  have sbd _ := mp(all_elim(g.bytes_bound, {V4}, {int_add(c.ctx, 0)}, {8}), v4b, simp())
  have sbl: int_lt(gimple.bytes_at(V4, int_add(c.ctx, 0), 8), 18446744073709551616) by simp(mp(all_elim(g.bytes_bound, {V4}, {int_add(c.ctx, 0)}, {8}), v4b, simp()))
  have secb: A4.secret in bits(64) by arith(rewrite(esec, sbd), rewrite(esec, sbl))
  let M1 := fn_update(V5, "bytes", X1)
  let M2 := fn_update(V5, "bytes", X2)
  let M3 := fn_update(V5, "bytes", X3)
  let M4 := fn_update(V5, "bytes", X4)
  let M5 := fn_update(V5, "bytes", X5)
  let M6 := fn_update(V5, "bytes", X6)
  let M7 := fn_update(V5, "bytes", X7)
  have w24: gimple.bytes_at(VD, int_add(c.ctx, 24), 8) = int_add(R, 24) by mem(conj(cx, hcb, ro, rlt, rcx, lno, lnb, lnc, lnr))
  have w32: gimple.bytes_at(VD, int_add(c.ctx, 32), 8) = 101 by mem(conj(cx, hcb, ro, rlt, rcx, lno, lnb, lnc, lnr))
  have wns: gimple.bytes_at(VD, int_add(R, 16), 4) = 101 by mem(conj(cx, hcb, ro, rlt, rcx, lno, lnb, lnc, lnr))
  have wck: gimple.bytes_at(VD, R, 8) = A4.secret by mem(conj(cx, hcb, ro, rlt, rcx, lno, lnb, lnc, lnr, secb))
  have w64: gimple.bytes_at(VD, int_add(c.ctx, 64), 8) = R by mem(conj(cx, hcb, ro, rlt, rcx, lno, lnb, lnc, lnr))
  have wln: gimple.bytes_at(VD, ln, 8) = R by mem(conj(cx, hcb, ro, rlt, rcx, lno, lnb, lnc, lnr))
  have w72: gimple.bytes_at(VD, int_add(c.ctx, 72), 8) = int_add(R, 4096) by mem(conj(cx, hcb, ro, rlt, rcx, lno, lnb, lnc, lnr))
  have w40: gimple.bytes_at(VD, int_add(c.ctx, 40), 8) = int_sub(CN, 1) by mem(conj(cx, hcb, ro, rlt, rcx, lno, lnb, lnc, lnr, co, hr, qend))
  // (the step's precondition)
  have m1V := mp(all_elim(ms.wr_any, {V5}, {int_add(c.ctx, 40)}, {8}, {int_sub(CN, 1)}), v5V)
  have m2V: M2 in x86_64_linux.Vm by simp(mp(all_elim(ms.wr_any, {M1}, {int_add(c.ctx, 72)}, {8}, {int_add(R, 4096)}), m1V))
  have m3V: M3 in x86_64_linux.Vm by simp(mp(all_elim(ms.wr_any, {M2}, {ln}, {8}, {R}), m2V))
  have m4V: M4 in x86_64_linux.Vm by simp(mp(all_elim(ms.wr_any, {M3}, {int_add(c.ctx, 64)}, {8}, {R}), m3V))
  have m5V: M5 in x86_64_linux.Vm by simp(mp(all_elim(ms.wr_any, {M4}, {int_add(R, 0)}, {8}, {A4.secret}), m4V))
  have m6V: M6 in x86_64_linux.Vm by simp(mp(all_elim(ms.wr_any, {M5}, {int_add(R, 16)}, {4}, {101}), m5V))
  have m7V: M7 in x86_64_linux.Vm by simp(mp(all_elim(ms.wr_any, {M6}, {int_add(c.ctx, 32)}, {8}, {101}), m6V))
  have vdV: VD in x86_64_linux.Vm by simp(mp(all_elim(ms.wr_any, {M7}, {int_add(c.ctx, 24)}, {8}, {int_add(R, 24)}), m7V))
  have vdp: VD.pages = V5.pages by simp()
  have pgs: all q. q in omega -> !(q = int_div(A4.reserve, 4096)) -> VD.pages[q] = V4.pages[q] proof
    fix q
    assume hq hn
    show by simp(vdp, mp(all_elim(hpq, {q}), hq, hn))
  qed
  have pge := apply(mp.view_pg[vm := V5, vm2 := VD, fp := mallocng.all_bytes(), a := R], ro, vdp)
  have rwe := rewrite(sym(pge), expand(hrw, mallocng.m_rw, mallocng.m_mapped))
  have rwd: mallocng.m_rw(mallocng.mview(VD, mallocng.all_bytes()), R) by defs(taut(rwe), mallocng.m_rw, mallocng.m_mapped)
  have kdd: !(snd(mallocng.pg(mallocng.mview(VD, mallocng.all_bytes()), R)).kind = 2) := rewrite(sym(pge), hkd)
  have v5s: fn_update(V5, "bytes", V5.bytes) = V5 := mp(fn_update_same[f := V5, k := "bytes"], simp(expand(v5V, x86_64_linux.Vm)), simp(expand(v5V, x86_64_linux.Vm)))
  have rst0: fn_update(fn_update(VD, "bytes", V4.bytes), "pages", V4.pages) = fn_update(fn_update(V5, "bytes", V5.bytes), "pages", V4.pages) by simp(eb)
  have rst: fn_update(fn_update(VD, "bytes", V4.bytes), "pages", V4.pages) = V4 := trans(rst0, rewrite(sym(v5s), v5r, {1}))
  have ns: mallocng.NSLOTS = 101 by defs(refl({101}), mallocng.NSLOTS)
  have aln4: A4.areas in list_type(omega) by simp(s2)
  have nao4: seq_len(A4.areas) in omega by arith(aln4)
  have w56: seq_len(A4.areas) = 0 -> gimple.bytes_at(VD, int_add(c.ctx, 56), 8) = R proof
    assume hz
    have l56: ln = int_add(c.ctx, 56) by taut(hln, hz, (!int_lt(0, seq_len(A4.areas)) by arith(hz, nao4)))
    show := rewrite(l56, wln)
  qed
  have wnx: int_lt(0, seq_len(A4.areas)) -> gimple.bytes_at(VD, int_add(A4.areas[int_sub(seq_len(A4.areas), 1)], 8), 8) = R proof
    assume hp
    have lnx: ln = int_add(A4.areas[int_sub(seq_len(A4.areas), 1)], 8) by taut(hln, hp, (!(seq_len(A4.areas) = 0) by arith(hp, nao4)))
    show := rewrite(lnx, wln)
  qed
  have w32n := subst({z. gimple.bytes_at(VD, int_add(c.ctx, 32), 8) = z}, sym(ns), w32)
  have wnsn := subst({z. gimple.bytes_at(VD, int_add(R, 16), 4) = z}, sym(ns), wns)
  have P: mp.napre(c, A4, V4, VD, B) by taut(hc, s3, s2, hbt, s1, vdV, s4, h0, hr, byd, pgs, rwd, kdd, rst, w24, w32n, w40, w56, w64,
    (int_lt(1, A4.reserve_cnt) -> gimple.bytes_at(VD, int_add(c.ctx, 72), 8) = int_add(A4.reserve, 4096) by taut(w72)), wnx, wck, wnsn)
  // the new state: a run state
  let A5 := mp.narea(A4)
  have hh2 := apply(mp.na_holds_in, P)
  have {ninit = init} := apply(mp.na_res, P)
  have {nta = abs, ntu = univ} := apply(mp.narea_type, s2, hr)
  have gk: mallocng_specs.groups_kept(A4, A5) by defs(simp(), mallocng_specs.groups_kept)
  have tk: A5.taken = A4.taken by simp()
  have fpe: all a. a in mallocng.footprint(c, A5, B) <-> a in mallocng.footprint(c, A4, B) proof
    fix a
    have r := apply(mp.na_fpr[c := c, A := A4, a := a], hc, s3, s2, hr)
    have {f = fp} := apply(mp.fp_like[c := c, A := A4, A2 := A5, b := B, a := a], r, (A5.metas = A4.metas by simp()), (A5.slots = A4.slots by simp()), (A5.used = A4.used by simp()), tk)
    show := f
  qed
  // (the reserve's bytes, the area's words: the allocator's)
  have rfp: all a. a in omega -> int_le(R, a) -> int_lt(a, int_add(R, 4096)) -> a in mallocng.footprint(c, A4, B) proof
    fix a
    assume hao h1 h2
    have hd := apply(mp.res_held[c := c, A := A4, vm := V4, b := B, a := a], hc, s3, s2, s4, hao, h1, arith(h2, hr, co, ro))
    have {f = fp} := apply(mp.held_fp, hd)
    show := f
  qed
  have nfp: all a. a in omega -> mp.nabyte(c, A4, a) -> a in mallocng.footprint(c, A4, B) proof
    fix a
    assume hao hn
    have nb := expand(hn, mp.nabyte)
    have cc: int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, 928)) -> a in mallocng.footprint(c, A4, B) proof
      assume w
      have w1 w2 := w
      show := apply(mp.ctx_fp[c := c, A := A4, vm := V4, b := B, a := a], hc, s3, s2, s4, hao, w1, (int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE)) by arith(w2)))
    qed
    have ca: int_lt(0, seq_len(A4.areas)) && (int_le(int_add(A4.areas[int_sub(seq_len(A4.areas), 1)], 8), a) && int_lt(a, int_add(A4.areas[int_sub(seq_len(A4.areas), 1)], 16))) ->
        a in mallocng.footprint(c, A4, B) proof
      assume w
      have w0 w1 w2 := w
      have hd := apply(mp.hdr_held[c := c, A := A4, vm := V4, b := B, k := int_sub(seq_len(A4.areas), 1), a := a], hc, s3, s2, s4, arith(w0, nao4), arith(w0, nao4), hao, arith(w1), arith(w2))
      have {f = fp} := apply(mp.held_fp, hd)
      show := f
    qed
    have cr: int_le(R, a) && int_lt(a, int_add(R, 20)) -> a in mallocng.footprint(c, A4, B) proof
      assume w
      have w1 w2 := w
      show := mp(all_elim(rfp, {a}), hao, w1, arith(w2))
    qed
    have sp: (int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, 928))) ||
        (int_lt(0, seq_len(A4.areas)) && (int_le(int_add(A4.areas[int_sub(seq_len(A4.areas), 1)], 8), a) && int_lt(a, int_add(A4.areas[int_sub(seq_len(A4.areas), 1)], 16)))) ||
        (int_le(R, a) && int_lt(a, int_add(R, 20))) by arith(nb, cx)
    show by taut(sp, cc, ca, cr)
  qed
  have fsb: s.fs_base in bits(64) by simp(expand(hw, abi.World))
  have eo := apply(mp.errno_out[c := c, A := A, A1 := A4, B := B, V0 := s.vm, fs := s.fs_base], hea, fsb, hfl, sgr)
  have ub2 := mp(app_update_other[f := V5, k := "pages", v := V4.pages, x := "brk_start"], (!("brk_start" = "pages") by simp()))
  have ebs: VD.brk_start = V4.brk_start by simp(sym(rewrite(v5r, ub2)))
  have pg: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
  // (a page other than the reserve's first: as it was)
  have opg: all a. a in omega -> !(a in mallocng.footprint(c, A4, B)) -> !(int_div(a, x86_64_linux.PAGE) = int_div(A4.reserve, 4096)) proof
    fix a
    assume hao hn
    assume e
    have e2 := rewrite(pg, e)
    show by taut(hn, mp(all_elim(rfp, {a}), hao, arith(e2, qal, ro, hao), arith(e2, qal, ro, hao)))
  qed
  have un: mallocng.untouched(c, A4, B, V4, VD, mp.errno(s.fs_base)) proof
    have r: all x0. x0 in omega -> (!(x0 in mallocng.footprint(c, A4, B)) && !(x0 in mp.errno(s.fs_base))) && x86_64_linux.mapped(V4, int_div(x0, x86_64_linux.PAGE)) ->
        VD.bytes[bits_of_int(64, x0)] = V4.bytes[bits_of_int(64, x0)] && VD.pages[int_div(x0, x86_64_linux.PAGE)] = V4.pages[int_div(x0, x86_64_linux.PAGE)] proof
      fix a
      assume hao hq
      have n1 _ m0 := hq
      have ml _ := expand(m0, x86_64_linux.mapped)
      have ab: bits_of_int(64, a) = a by defs(arith(hao, expand(ml, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)), bits_of_int, pow2)
      have nn: !mp.nabyte(c, A4, a) proof
        assume w
        show by taut(n1, mp(all_elim(nfp, {a}), hao, w))
      qed
      have bb := mp(all_elim(byd, {bits_of_int(64, a)}), (bits_of_int(64, a) in bits(64) by simp()), rewrite(sym(ab), nn))
      have pp := mp(all_elim(pgs, {int_div(a, x86_64_linux.PAGE)}), (int_div(a, x86_64_linux.PAGE) in omega by defs(arith(hao), x86_64_linux.PAGE)), mp(all_elim(opg, {a}), hao, n1))
      show by taut(bb, pp)
    qed
    show by defs(taut(r, ebs), mallocng.untouched)
  qed
  have hfp: all a. a in omega -> a in mallocng.footprint(c, A5, B) -> a in mallocng.footprint(c, A4, B) || !x86_64_linux.mapped(V4, int_div(a, x86_64_linux.PAGE)) proof
    fix a
    assume _ h
    show by taut(all_elim(fpe, {a}), h)
  qed
  have ne: all a. a in omega -> a in mallocng.footprint(c, A5, B) -> !(a in mp.errno(s.fs_base)) proof
    fix a
    assume hao h
    show := mp(all_elim(eo, {a}), hao, (a in mallocng.footprint(c, A4, B) by taut(all_elim(fpe, {a}), h)))
  qed
  have ep: all i. i in omega -> int_lt(i, 4) ->
      VD.pages[int_div(int_add(int_add(s.fs_base, 52), i), x86_64_linux.PAGE)] = V4.pages[int_div(int_add(int_add(s.fs_base, 52), i), x86_64_linux.PAGE)] proof
    fix i
    assume hi hil
    let a := int_add(int_add(s.fs_base, 52), i)
    have ao: a in omega by arith(hi, fsb)
    have he: a in mp.errno(s.fs_base) by simp((a in omega && int_le(int_add(s.fs_base, 52), a) && int_lt(a, int_add(s.fs_base, 56)) by arith(hi, hil, fsb)))
    have nf: !(a in mallocng.footprint(c, A4, B)) proof
      assume w
      show by taut(mp(all_elim(eo, {a}), ao, w), he)
    qed
    show := mp(all_elim(pgs, {int_div(a, x86_64_linux.PAGE)}), (int_div(a, x86_64_linux.PAGE) in omega by defs(arith(ao), x86_64_linux.PAGE)), mp(all_elim(opg, {a}), ao, nf))
  qed
  have st := apply(mp.am_st_step[c := c, A := A, B := B, s := s, V := V4, A1 := A4, V2 := VD, A2 := A5], S, taut(vdV, nta, ntu), hh2, gk, tk, un, hfp, ne, taut(ep))
  show by taut(st, (int_lt(0, A5.avail_cnt) by simp(ns)), (!(A5.init_done = 0) by simp(ninit)))
qed

// (the reserve's first page made readable and writable: its other pages,
// all else as before; that page accessible, not the stack)
theorem mp.mpr_pp(c, A4, V4, B, V5): c in mallocng.Cfg -> A4 in univ(1) -> A4 in mallocng.Abs -> mallocng.holds_in(c, A4, V4, B) -> int_lt(0, A4.reserve_cnt) ->
  V4 in x86_64_linux.Vm -> V5 in x86_64_linux.Vm ->
  mallocng_specs.reprot(V4, V5, int_div(A4.reserve, x86_64_linux.PAGE),
    int_sub(int_div(int_sub(int_add(int_add(A4.reserve, 4096), x86_64_linux.PAGE), 1), x86_64_linux.PAGE), int_div(A4.reserve, x86_64_linux.PAGE)),
    x86_64_linux.prot_of(bits_of_int(64, bits_of_int(32, 3)))) ->
  rest: fn_update(V5, "pages", V4.pages) = V4 && pages: (all q. q in omega -> !(q = int_div(A4.reserve, 4096)) -> V5.pages[q] = V4.pages[q]) &&
  rw: mallocng.m_rw(mallocng.mview(V5, mallocng.all_bytes()), A4.reserve) && kind: !(snd(mallocng.pg(mallocng.mview(V5, mallocng.all_bytes()), A4.reserve)).kind = 2)
proof
  assume hc hu ha hh hr hv4 hv5 hrp
  have rrest rpg := expand(hrp, mallocng_specs.reprot)
  have {qal = al, qpos = pos, qend = end, qpg = pg} := apply(mp.am_rword[c := c, A := A4, V := V4, b := B], hc, hu, ha, hh, hr)
  have pg: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
  have ro: A4.reserve in omega by simp(ha)
  have co: A4.reserve_cnt in omega by simp(ha)
  let RP := int_div(A4.reserve, 4096)
  have rpe: int_div(A4.reserve, x86_64_linux.PAGE) = RP by simp(pg)
  have n1: int_sub(int_div(int_sub(int_add(int_add(A4.reserve, 4096), x86_64_linux.PAGE), 1), x86_64_linux.PAGE), int_div(A4.reserve, x86_64_linux.PAGE)) = 1 by arith(pg, qal, ro)
  have rpo: RP in omega by arith(ro)
  have rpt: int_lt(RP, 34359738367) by arith(qend, ro, co, hr)
  have pq: all q. q in omega -> !(q = RP) -> V5.pages[q] = V4.pages[q] proof
    fix q
    assume hq hn
    have inside: int_lt(q, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) -> V5.pages[q] = V4.pages[q] proof
      assume hl
      have e := mp(all_elim(rpg, {q}), hq, hl)
      show by simp(e, n1, rpe, (!(int_le(RP, q) && int_lt(q, int_add(RP, 1))) by arith(hn, hq, rpo)))
    qed
    have outside: !int_lt(q, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) -> V5.pages[q] = V4.pages[q] proof
      assume hl
      show := apply(mp.pages_out[V := V5, W := V4, q := q], hv5, hv4, hl)
    qed
    show by taut(inside, outside)
  qed
  have m0 k0 := mp(all_elim(qpg, {A4.reserve}), ro, arith(ro), arith(hr, ro, co))
  have e0 := mp(all_elim(rpg, {RP}), rpo, (int_lt(RP, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) by arith(rpt)))
  have p5: V5.pages[RP] = some(fn_update(snd(V4.pages[RP]), "prot", x86_64_linux.prot_of(bits_of_int(64, bits_of_int(32, 3))))) by simp(e0, n1, rpe)
  have aa: A4.reserve in mallocng.all_bytes() by defs(simp(ro), mallocng.all_bytes)
  have pv := apply(mp.pg_view[vm := V5, fp := mallocng.all_bytes(), a := A4.reserve], ro, aa)
  have pr: mallocng.pg(mallocng.mview(V5, mallocng.all_bytes()), A4.reserve) = some(fn_update(snd(V4.pages[RP]), "prot", x86_64_linux.prot_of(bits_of_int(64, bits_of_int(32, 3))))) :=
    trans(pv, rewrite(sym(rpe), p5))
  have k1: !(snd(V4.pages[RP]).kind = 2) := rewrite(rpe, k0)
  have prw: x86_64_linux.prot_of(bits_of_int(64, bits_of_int(32, 3))).r && x86_64_linux.prot_of(bits_of_int(64, bits_of_int(32, 3))).w by defs(simp(), x86_64_linux.prot_of)
  have rw: mallocng.m_rw(mallocng.mview(V5, mallocng.all_bytes()), A4.reserve) by defs(simp(pr, rpe, rpt, pg, prw), mallocng.m_rw, mallocng.m_mapped)
  have kd: !(snd(mallocng.pg(mallocng.mview(V5, mallocng.all_bytes()), A4.reserve)).kind = 2) by simp(pr, k1)
  show by taut(rrest, pq, rw, kd)
qed

// (a 64-bit shift left below the width: one outcome)
theorem mp.shl64_det: all s a k. s in univ(1) -> a in bits(64) -> k in omega -> int_lt(k, 64) ->
  g.det(gimple.shl(64, a, k), s, ok(s, bits_shl(64, a, k)))
proof
  fix s a k
  assume hs ha hk hl
  show proof
    fix o
    assume hr
    show by simp(expand(hr, gimple.shl, runs, mkprog), hs, ha, hk, hl)
  qed
qed

// (a state where the ways meet after the break moved: none available; the
// reserve's page accessible -- from brk -- unless it is to be made so)
abbrev mp.am_j1(c, A, B, s, V, A1, nu) := mp.am_st(c, A, B, s, V, A1) && !(A1.init_done = 0) && A1.avail_cnt = 0 &&
  (nu = 1 || (nu = 0 && int_lt(0, A1.reserve_cnt) && mallocng.m_rw(mallocng.mview(V, mallocng.all_bytes()), A1.reserve) &&
     !(snd(mallocng.pg(mallocng.mview(V, mallocng.all_bytes()), A1.reserve)).kind = 2)))

// (a context byte the invariant's: on a mapped page)
theorem mp.ctx_mapped(c, A, vm, b, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_in(c, A, vm, b) ->
  a in omega -> int_le(c.ctx, a) -> int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE)) -> !mallocng.ctx_free(c, a) -> x86_64_linux.mapped(vm, int_div(a, x86_64_linux.PAGE))
proof
  assume hc hu ha hh ho h1 h2 hf
  have hd rw _ := apply(mp.ctx_acc[c := c, A := A, vm := vm, b := b, a := a], hc, hu, ha, hh, ho, h1, h2, hf)
  have mm _ _ := expand(rw, mallocng.m_rw)
  have ml mn := expand(mm, mallocng.m_mapped)
  have pv := apply(mp.pg_view[vm := vm, fp := mallocng.held(c, A, b), a := a], ho, hd)
  show by defs(taut(ml, rewrite(pv, mn)), x86_64_linux.mapped)
qed

// the reserve empty, mmap's 2 << shift fresh pages at p: all but the first
// the reserve; its words and the shift (one more) written
theorem mp.am_mmok(c, A, B, s, V3, A3, Vx, sh, p): mp.am_st(c, A, B, s, V3, A3) -> c in mallocng.Cfg -> s in abi.World ->
  B in fn_space(bits(64), option(omega)) -> mallocng_specs.errno_apart(c, A, B, s.vm, s.fs_base) -> int_le(int_add(s.fs_base, 56), int_pow(2, 64)) ->
  int_le(int_add(c.ctx, 928), 18446744073709551616) -> !(A3.init_done = 0) -> A3.reserve_cnt = 0 -> A3.avail_cnt = 0 ->
  gimple.bytes_at(V3, int_add(c.ctx, 48), 8) = sh ->
  Vx in x86_64_linux.Vm -> p in omega -> mallocng_specs.mmap_place(V3, 0, int_mul(pow2(int_add(sh, 1)), 4096), bits_of_int(32, 34), p) ->
  mallocng_specs.fresh_pages(V3, Vx, p, x86_64_linux.pages_for(int_mul(pow2(int_add(sh, 1)), 4096)),
    fn_update(fn_update(empty, "prot", x86_64_linux.prot_of(bits_of_int(32, 0))), "kind", 0)) -> Vx.brk = V3.brk ->
  st: mp.am_j1(c, A, B, s, fn_update(Vx, "bytes", x86_64_linux.store_le(x86_64_linux.store_le(x86_64_linux.store_le(Vx.bytes,
      int_add(c.ctx, 72), 8, int_add(int_mul(p, 4096), 4096)), int_add(c.ctx, 40), 8, int_sub(pow2(int_add(sh, 1)), 1)), int_add(c.ctx, 48), 8, int_add(sh, 1))),
    mp.refill(A3, int_add(int_mul(p, 4096), 4096), int_sub(pow2(int_add(sh, 1)), 1), A3.brk), 1) &&
  pos: int_lt(0, int_sub(pow2(int_add(sh, 1)), 1)) && shift: int_le(sh, 33) &&
  pages: (all q. q in omega -> x86_64_linux.mapped(V3, q) -> Vx.pages[q] = V3.pages[q]) &&
  low: int_le(int_add(int_mul(p, 4096), int_mul(4096, pow2(int_add(sh, 1)))), 140737488351232) &&
  w48: gimple.bytes_at(Vx, int_add(c.ctx, 48), 8) = sh
proof
  assume S hc hw hbt hea hfl hcb hid hz0 ha0 hsh hxv hp hpl hfr hxb
  have s1 s2 s3 s4 _ _ _ _ _ := S
  have cx: c.ctx in omega by simp(expand(hc, mallocng.Cfg))
  have pg: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
  have {wsh = shift, wbk = brk, wbo = brk_ok} := apply(mp.am_words[c := c, A := A3, V := V3, b := B], hc, s3, s2, s4, s1)
  have sh34: int_le(sh, 34) := rewrite(hsh, wsh)
  have v3b: V3.bytes in fn_space(bits(64), bits(8)) by simp(expand(s1, x86_64_linux.Vm))
  have sbo _ := mp(all_elim(g.bytes_bound, {V3}, {int_add(c.ctx, 48)}, {8}), v3b, simp())
  have sho: sh in omega := rewrite(hsh, sbo)
  let PN := pow2(int_add(sh, 1))
  have pnp: int_le(2, PN) proof
    have q := apply(pow2_le[a := 1, b := int_add(sh, 1)], (1 in omega by simp()), arith(sho), arith(sho))
    show by simp(q)
  qed
  have pnf: x86_64_linux.pages_for(int_mul(PN, 4096)) = PN by defs(arith(pnp), x86_64_linux.pages_for, x86_64_linux.PAGE)
  // (not fixed: a free place, not page 0)
  have mc: !(bits_of_int(32, 34) = int_add(int_add(x86_64_linux.MAP_PRIVATE, x86_64_linux.MAP_ANONYMOUS), x86_64_linux.MAP_FIXED)) by defs(simp(), x86_64_linux.MAP_PRIVATE,
    x86_64_linux.MAP_ANONYMOUS, x86_64_linux.MAP_FIXED)
  have pl := expand(hpl, mallocng_specs.mmap_place)
  have p1 pfree := (int_le(1, p) && x86_64_linux.free_range(V3, p, x86_64_linux.pages_for(int_mul(PN, 4096))) by simp(pl, mc))
  have fr1 fr2 _ := expand(rewrite(pnf, pfree), x86_64_linux.free_range)
  have sh33: int_le(sh, 33) proof
    have c34: int_le(34, sh) -> false proof
      assume h
      have q := apply(pow2_le[a := 35, b := int_add(sh, 1)], (35 in omega by simp()), arith(sho), arith(h))
      show by arith(q, fr1, p1)
    qed
    show by arith(c34, sho)
  qed
  let R2 := int_add(int_mul(p, 4096), 4096)
  let KN := int_sub(PN, 1)
  let NPG := fn_update(fn_update(empty, "prot", x86_64_linux.prot_of(bits_of_int(32, 0))), "kind", 0)
  have xt xl xs xpg xby := expand(rewrite(pnf, hfr), mallocng_specs.fresh_pages)
  have pnb: int_le(int_add(p, PN), 34359738367) by arith(fr1)
  have pno: PN in omega by simp(sho)
  have lw: all x y. x in omega -> y in omega -> int_le(int_add(x, y), 34359738367) -> int_le(int_add(int_mul(x, 4096), int_mul(4096, y)), 140737488351232) proof
    fix x y
    assume hx hy hl
    show by arith(hx, hy, hl)
  qed
  have low := mp(all_elim(lw, {p}, {PN}), hp, pno, pnb)
  // (pages mapped before: as they were, their bytes too)
  have xp: all q. q in omega -> x86_64_linux.mapped(V3, q) -> Vx.pages[q] = V3.pages[q] proof
    fix q
    assume hq m
    have ml _ := expand(m, x86_64_linux.mapped)
    have nr: !(int_le(p, q) && int_lt(q, int_add(p, PN))) proof
      assume i
      show by taut(mp(all_elim(fr2, {q}), hq, i), m)
    qed
    show by simp(mp(all_elim(xpg, {q}), hq, ml), nr)
  qed
  have xb: all y. y in bits(64) -> x86_64_linux.mapped(V3, int_div(y, x86_64_linux.PAGE)) -> Vx.bytes[y] = V3.bytes[y] proof
    fix y
    assume hy m
    have qo: int_div(y, x86_64_linux.PAGE) in omega by defs(arith(hy), x86_64_linux.PAGE)
    have nr: !(int_le(p, int_div(y, x86_64_linux.PAGE)) && int_lt(int_div(y, x86_64_linux.PAGE), int_add(p, PN))) proof
      assume i
      show by taut(mp(all_elim(fr2, {int_div(y, x86_64_linux.PAGE)}), qo, i), m)
    qed
    have nb: !(int_le(int_mul(p, x86_64_linux.PAGE), y) && int_lt(y, int_mul(int_add(p, PN), x86_64_linux.PAGE))) by arith(nr, pg, hy, hp)
    show by simp(mp(all_elim(xby, {y}), hy), nb)
  qed
  let VF := fn_update(Vx, "bytes", x86_64_linux.store_le(x86_64_linux.store_le(x86_64_linux.store_le(Vx.bytes,
      int_add(c.ctx, 72), 8, R2), int_add(c.ctx, 40), 8, KN), int_add(c.ctx, 48), 8, int_add(sh, 1)))
  let VB1 := fn_update(Vx, "bytes", x86_64_linux.store_le(Vx.bytes, int_add(c.ctx, 72), 8, R2))
  let VB2 := fn_update(Vx, "bytes", x86_64_linux.store_le(x86_64_linux.store_le(Vx.bytes, int_add(c.ctx, 72), 8, R2), int_add(c.ctx, 40), 8, KN))
  have vb1V := mp(all_elim(ms.wr_any, {Vx}, {int_add(c.ctx, 72)}, {8}, {R2}), hxv)
  have vb2V: VB2 in x86_64_linux.Vm by simp(mp(all_elim(ms.wr_any, {VB1}, {int_add(c.ctx, 40)}, {8}, {KN}), vb1V))
  have vfV: VF in x86_64_linux.Vm by simp(mp(all_elim(ms.wr_any, {VB2}, {int_add(c.ctx, 48)}, {8}, {int_add(sh, 1)}), vb2V))
  have c72: int_add(c.ctx, 72) in bits(64) by arith(cx, hcb)
  have c40: int_add(c.ctx, 40) in bits(64) by arith(cx, hcb)
  have c48: int_add(c.ctx, 48) in bits(64) by arith(cx, hcb)
  have r2b: R2 in bits(64) by arith(low, hp, pnp)
  have knb: KN in bits(64) by arith(pnb, pnp)
  have s1b: int_add(sh, 1) in bits(64) by arith(sho, sh33)
  have fo: all y. y in bits(64) -> !(int_le(int_add(c.ctx, 72), y) && int_lt(y, int_add(c.ctx, 80))) -> !(int_le(int_add(c.ctx, 40), y) && int_lt(y, int_add(c.ctx, 56))) ->
      VF.bytes[y] = Vx.bytes[y] proof
    fix y
    assume hy n1 n2
    have q3 := apply(mp.st_out[B := x86_64_linux.store_le(x86_64_linux.store_le(Vx.bytes, int_add(c.ctx, 72), 8, R2), int_add(c.ctx, 40), 8, KN),
      c := int_add(c.ctx, 48), k := 8, v := int_add(sh, 1), x := y], hy, c48, simp(), arith(cx, hcb), arith(n2, hy))
    have q2 := apply(mp.st_out[B := x86_64_linux.store_le(Vx.bytes, int_add(c.ctx, 72), 8, R2), c := int_add(c.ctx, 40), k := 8, v := KN, x := y],
      hy, c40, simp(), arith(cx, hcb), arith(n2, hy))
    have q1 := apply(mp.st_out[B := Vx.bytes, c := int_add(c.ctx, 72), k := 8, v := R2, x := y], hy, c72, simp(), arith(cx, hcb), arith(n1, hy))
    show by simp(q3, q2, q1)
  qed
  have cm: all y. y in omega -> int_le(c.ctx, y) -> int_lt(y, int_add(c.ctx, 928)) -> !mallocng.ctx_free(c, y) -> x86_64_linux.mapped(V3, int_div(y, x86_64_linux.PAGE)) proof
    fix y
    assume h1 h2 h3 h4
    show := apply(mp.ctx_mapped[c := c, A := A3, vm := V3, b := B, a := y], hc, s3, s2, s4, h1, h2, (int_lt(y, int_add(c.ctx, mallocng.CTX_SIZE)) by arith(h3)), h4)
  qed
  have vfp: VF.pages = Vx.pages by simp()
  have vfbb: VF.bytes in fn_space(bits(64), bits(8)) by simp(expand(vfV, x86_64_linux.Vm))
  // (the reserve: fresh, PROT_NONE, zero, unmapped before)
  have npg: all a. a in omega -> int_le(R2, a) -> int_lt(a, int_add(R2, int_mul(4096, KN))) ->
      (mallocng.m_mapped(mallocng.mview(VF, mallocng.all_bytes()), a) && !(snd(mallocng.pg(mallocng.mview(VF, mallocng.all_bytes()), a)).kind = 2)) &&
      mallocng.b8(mallocng.mview(VF, mallocng.all_bytes()), a) = 0 proof
    fix a
    assume ho h1 h2
    have ab: a in bits(64) by arith(ho, h2, low, pnp)
    have aa: a in mallocng.all_bytes() by defs(simp(ho), mallocng.all_bytes)
    let Q := int_div(a, x86_64_linux.PAGE)
    have qo: Q in omega by defs(arith(ho), x86_64_linux.PAGE)
    have qr: int_le(p, Q) && int_lt(Q, int_add(p, PN)) by arith(pg, h1, h2, ho, hp, pnp)
    have qt: int_lt(Q, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) by arith(qr, pnb)
    have qp: Vx.pages[Q] = some(NPG) by simp(mp(all_elim(xpg, {Q}), qo, qt), qr)
    have qu: !x86_64_linux.mapped(V3, Q) := mp(all_elim(fr2, {Q}), qo, qr)
    have nc: !(int_le(int_add(c.ctx, 72), a) && int_lt(a, int_add(c.ctx, 80))) && !(int_le(int_add(c.ctx, 40), a) && int_lt(a, int_add(c.ctx, 56))) proof
      have w: !((int_le(int_add(c.ctx, 72), a) && int_lt(a, int_add(c.ctx, 80))) || (int_le(int_add(c.ctx, 40), a) && int_lt(a, int_add(c.ctx, 56)))) proof
        assume w0
        have nf: !mallocng.ctx_free(c, a) by defs(arith(ho, w0, cx), mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK)
        have m := mp(all_elim(cm, {a}), ho, (int_le(c.ctx, a) by arith(w0, cx)), (int_lt(a, int_add(c.ctx, 928)) by arith(w0, cx)), nf)
        show by taut(qu, m)
      qed
      show by arith(w)
    qed
    have n1 n2 := nc
    have fb := mp(all_elim(fo, {a}), ab, n1, n2)
    have xz: Vx.bytes[a] = bits_of_int(8, 0) by simp(mp(all_elim(xby, {a}), ab), (int_le(int_mul(p, x86_64_linux.PAGE), a) && int_lt(a, int_mul(int_add(p, PN), x86_64_linux.PAGE)) by arith(pg, h1, h2, hp, pnp)))
    have pv := apply(mp.pg_view[vm := VF, fp := mallocng.all_bytes(), a := a], ho, aa)
    have bv _ := apply(mp.b8_view[vm := VF, fp := mallocng.all_bytes(), a := a], vfbb, ho, aa)
    have ea: bits_of_int(64, a) = a by defs(arith(ab), bits_of_int, pow2)
    have pr: mallocng.pg(mallocng.mview(VF, mallocng.all_bytes()), a) = some(NPG) := trans(pv, trans((VF.pages[Q] = Vx.pages[Q] by simp(vfp)), qp))
    have mm: mallocng.m_mapped(mallocng.mview(VF, mallocng.all_bytes()), a) by defs(simp(pr, pg, qt), mallocng.m_mapped)
    show by taut(mm, (!(snd(mallocng.pg(mallocng.mview(VF, mallocng.all_bytes()), a)).kind = 2) by simp(pr)),
      (mallocng.b8(mallocng.mview(VF, mallocng.all_bytes()), a) = 0 by simp(bv, ea, fb, xz)))
  qed
  have frs: all a. a in omega -> int_le(R2, a) -> int_lt(a, int_add(R2, int_mul(4096, KN))) -> !x86_64_linux.mapped(V3, int_div(a, x86_64_linux.PAGE)) proof
    fix a
    assume ho h1 h2
    show := mp(all_elim(fr2, {int_div(a, x86_64_linux.PAGE)}), (int_div(a, x86_64_linux.PAGE) in omega by defs(arith(ho), x86_64_linux.PAGE)), (int_le(p, int_div(a, x86_64_linux.PAGE)) &&
      int_lt(int_div(a, x86_64_linux.PAGE), int_add(p, PN)) by arith(pg, h1, h2, ho, hp, pnp)))
  qed
  have pgs: all q. q in omega -> x86_64_linux.mapped(V3, q) -> VF.pages[q] = V3.pages[q] proof
    fix q
    assume hq m
    show by simp(vfp, mp(all_elim(xp, {q}), hq, m))
  qed
  have bys: all y. y in bits(64) -> x86_64_linux.mapped(V3, int_div(y, x86_64_linux.PAGE)) -> !mp.rfbyte(c, y) -> VF.bytes[y] = V3.bytes[y] proof
    fix y
    assume hy m hn
    have nr: !(int_le(int_add(c.ctx, 72), y) && int_lt(y, int_add(c.ctx, 80))) && !(int_le(int_add(c.ctx, 40), y) && int_lt(y, int_add(c.ctx, 56))) proof
      have r := expand(hn, mp.rfbyte)
      show by arith(r)
    qed
    have n1 n2 := nr
    show := trans(mp(all_elim(fo, {y}), hy, n1, n2), mp(all_elim(xb, {y}), hy, m))
  qed
  have rest := apply(mp.vm_rest[V := VF, W := V3], vfV, s1, (VF.stack_top = V3.stack_top by simp(xt)), (VF.stack_limit = V3.stack_limit by simp(xl)),
    (VF.brk_start = V3.brk_start by simp(xs)))
  have bo: mallocng.brk_ok(mp.refill(A3, R2, KN, A3.brk), VF.brk) by defs(simp(wbo, hxb), mallocng.brk_ok)
  // (the words: the count, the shift one more, the reserve; the break V3's)
  have r48: gimple.bytes_at(VF, int_add(c.ctx, 48), 8) = int_add(sh, 1) by mem(conj(cx, hcb, s1b))
  have w48: int_le(gimple.bytes_at(VF, int_add(c.ctx, 48), 8), 34) by simp(r48, (int_le(int_add(sh, 1), 34) by arith(sh33)))
  have w40: gimple.bytes_at(VF, int_add(c.ctx, 40), 8) = KN by mem(conj(cx, hcb, knb))
  have w72: gimple.bytes_at(VF, int_add(c.ctx, 72), 8) = R2 by mem(conj(cx, hcb, r2b))
  have o9: gimple.bytes_at(VF, int_add(c.ctx, 920), 8) = gimple.bytes_at(Vx, int_add(c.ctx, 920), 8) by mem(conj(cx, hcb))
  have b9: all j. j in omega -> int_lt(j, 8) -> Vx.bytes[int_add(int_add(c.ctx, 920), j)] = V3.bytes[int_add(int_add(c.ctx, 920), j)] proof
    fix j
    assume hj hjl
    let y := int_add(int_add(c.ctx, 920), j)
    have yo: y in omega by arith(cx, hj)
    have m := mp(all_elim(cm, {y}), yo, arith(cx, hj), arith(hjl), (!mallocng.ctx_free(c, y) by defs(arith(yo, hj, hjl, cx), mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK)))
    show := mp(all_elim(xb, {y}), arith(cx, hj, hjl, hcb), m)
  qed
  have s9 := apply(mp.rd_same[v1 := Vx, v2 := V3, a := int_add(c.ctx, 920), n := 8], arith(cx), simp(), arith(cx, hcb), b9)
  have w920: gimple.bytes_at(VF, int_add(c.ctx, 920), 8) = A3.brk := trans(o9, trans(s9, wbk))
  have hn3: (R2 in omega && KN in omega && A3.brk in omega) by taut((R2 in omega by arith(hp)), (KN in omega by arith(pnp, pno)), (A3.brk in omega by simp(s2)))
  have P: mp.rfpre(c, A3, V3, VF, B, R2, KN, A3.brk) by taut(hc, s3, s2, hbt, s1, vfV, s4, hid, hz0, hn3,
    (int_lt(0, KN) && int_lt(0, R2) by arith(pnp, hp)), (int_mod(R2, 4096) = 0 by arith(hp)), frs, npg, pgs, bys, rest, bo, w40, w48,
    (int_lt(0, KN) -> gimple.bytes_at(VF, int_add(c.ctx, 72), 8) = R2 by taut(w72)), w920)
  have st := apply(mp.am_rf[c := c, A := A, B := B, s := s, V := V3, A1 := A3, V2 := VF, R2 := R2, Kc := KN, Bk := A3.brk], S, hw, hea, hfl, P)
  have aj: mp.am_j1(c, A, B, s, VF, mp.refill(A3, R2, KN, A3.brk), 1) by taut(st, (!(mp.refill(A3, R2, KN, A3.brk).init_done = 0) by simp(hid)),
    (mp.refill(A3, R2, KN, A3.brk).avail_cnt = 0 by simp(ha0)), refl({1}))
  have b48: all j. j in omega -> int_lt(j, 8) -> Vx.bytes[int_add(int_add(c.ctx, 48), j)] = V3.bytes[int_add(int_add(c.ctx, 48), j)] proof
    fix j
    assume hj hjl
    let y := int_add(int_add(c.ctx, 48), j)
    have yo: y in omega by arith(cx, hj)
    have m := mp(all_elim(cm, {y}), yo, arith(cx, hj), arith(hjl), (!mallocng.ctx_free(c, y) by defs(arith(yo, hj, hjl, cx), mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK)))
    show := mp(all_elim(xb, {y}), arith(cx, hj, hjl, hcb), m)
  qed
  have s48 := apply(mp.rd_same[v1 := Vx, v2 := V3, a := int_add(c.ctx, 48), n := 8], arith(cx), simp(), arith(cx, hcb), b48)
  show by taut(aj, (int_lt(0, KN) by arith(pnp)), sh33, xp, low, trans(s48, hsh))
qed

// (the break moved: the pages mapped before as they were, their bytes but
// the break's word; outside the allocator untouched; the guard page, if
// any, unmapped before)
theorem mp.brk_frame(c, A1, V1, VG, g, nw, bb, V, B, e): mp.am_jg(c, A1, V1, VG, g, nw, bb) -> c in mallocng.Cfg -> A1 in univ(1) -> A1 in mallocng.Abs ->
  mallocng.holds_in(c, A1, V1, B) -> V1 in x86_64_linux.Vm -> int_le(int_add(c.ctx, 928), 18446744073709551616) -> int_le(4096, V1.brk_start) -> !int_lt(nw, VG.brk_start) ->
  ((int_lt(x86_64_linux.pages_for(VG.brk), x86_64_linux.pages_for(nw)) &&
     x86_64_linux.free_range(VG, x86_64_linux.pages_for(VG.brk), int_sub(x86_64_linux.pages_for(nw), x86_64_linux.pages_for(VG.brk))) &&
     x86_64_linux.off_stack_space(VG, x86_64_linux.pages_for(VG.brk), int_sub(x86_64_linux.pages_for(nw), x86_64_linux.pages_for(VG.brk))) &&
     mallocng_specs.fresh_pages(VG, V, x86_64_linux.pages_for(VG.brk), int_sub(x86_64_linux.pages_for(nw), x86_64_linux.pages_for(VG.brk)),
       fn_update(fn_update(empty, "prot", fn_update(fn_update(fn_update(empty, "r", true), "w", true), "x", false)), "kind", 1))) ||
   (!int_lt(x86_64_linux.pages_for(VG.brk), x86_64_linux.pages_for(nw)) &&
     mallocng_specs.gone_pages(VG, V, x86_64_linux.pages_for(nw), int_sub(x86_64_linux.pages_for(VG.brk), x86_64_linux.pages_for(nw))))) ->
  pages: (all q. q in omega -> x86_64_linux.mapped(V1, q) -> V.pages[q] = V1.pages[q]) &&
  bytes: (all y. y in bits(64) -> x86_64_linux.mapped(V1, int_div(y, x86_64_linux.PAGE)) -> !(int_le(int_add(c.ctx, 920), y) && int_lt(y, int_add(c.ctx, 928))) ->
     V.bytes[y] = V1.bytes[y]) &&
  unt: mallocng.untouched(c, A1, B, V1, V, e) && w920: gimple.bytes_at(V, int_add(c.ctx, 920), 8) = gimple.bytes_at(VG, int_add(c.ctx, 920), 8) &&
  guard: (g = 1 -> !x86_64_linux.mapped(V1, int_div(bb, 4096)))
proof
  assume J hc hu ha hh s1 hcb bs0 hns hgr
  have cx: c.ctx in omega by simp(expand(hc, mallocng.Cfg))
  have {gp = pages, gs = start, gbk = brk} := apply(mp.jg_parts, J, cx, hcb)
  have {bno = nat, bpo2 = po, bpn = pn, bgu = guard} := apply(mp.brk_pages, J, s1, bs0, rewrite(gs, hns))
  let PO := x86_64_linux.pages_for(VG.brk)
  let PN := x86_64_linux.pages_for(nw)
  have pof: PO = x86_64_linux.pages_for(V1.brk) := rewrite(gbk, refl({PO}), {2})
  have plt: int_lt(PO, PN) by arith(rewrite(sym(pof), bpo2), bpn)
  have _ gfree _ gfr := (int_lt(PO, PN) && x86_64_linux.free_range(VG, PO, int_sub(PN, PO)) && x86_64_linux.off_stack_space(VG, PO, int_sub(PN, PO)) &&
      mallocng_specs.fresh_pages(VG, V, PO, int_sub(PN, PO), fn_update(fn_update(empty, "prot", fn_update(fn_update(fn_update(empty, "r", true), "w", true), "x", false)), "kind", 1))
    by taut(hgr, plt))
  have _ _ fs fpg fby := expand(gfr, mallocng_specs.fresh_pages)
  have _ fr2 _ := expand(gfree, x86_64_linux.free_range)
  have _ _ jo _ _ _ := J
  have vgb: VG.brk in bits(64) by simp(gbk, expand(s1, x86_64_linux.Vm))
  have pon: PO in omega by defs(arith(vgb), x86_64_linux.pages_for, x86_64_linux.PAGE)
  have mvg: all q. x86_64_linux.mapped(V1, q) -> x86_64_linux.mapped(VG, q) proof
    fix q
    assume m
    show by defs(simp(expand(m, x86_64_linux.mapped), gp), x86_64_linux.mapped)
  qed
  have vvp: all q. q in omega -> x86_64_linux.mapped(V1, q) -> V.pages[q] = V1.pages[q] proof
    fix q
    assume hq m
    have ml _ := expand(m, x86_64_linux.mapped)
    have nr: !(int_le(PO, q) && int_lt(q, int_add(PO, int_sub(PN, PO)))) proof
      assume i
      show by taut(mp(all_elim(fr2, {q}), hq, i), mp(all_elim(mvg, {q}), m))
    qed
    have e1 := mp(all_elim(fpg, {q}), hq, ml)
    show by simp(e1, nr, gp)
  qed
  have vv: all y. y in bits(64) -> x86_64_linux.mapped(V1, int_div(y, x86_64_linux.PAGE)) -> !(int_le(int_add(c.ctx, 920), y) && int_lt(y, int_add(c.ctx, 928))) ->
      V.bytes[y] = V1.bytes[y] proof
    fix y
    assume hy m hn
    have qo: int_div(y, x86_64_linux.PAGE) in omega by defs(arith(hy), x86_64_linux.PAGE)
    have nr: !(int_le(PO, int_div(y, x86_64_linux.PAGE)) && int_lt(int_div(y, x86_64_linux.PAGE), int_add(PO, int_sub(PN, PO)))) proof
      assume i
      show by taut(mp(all_elim(fr2, {int_div(y, x86_64_linux.PAGE)}), qo, i), mp(all_elim(mvg, {int_div(y, x86_64_linux.PAGE)}), m))
    qed
    have nb: !(int_le(int_mul(PO, x86_64_linux.PAGE), y) && int_lt(y, int_mul(int_add(PO, int_sub(PN, PO)), x86_64_linux.PAGE))) by arith(nr, hy, pon)
    have e1 := mp(all_elim(fby, {y}), hy)
    show by simp(e1, nb, mp(all_elim(jo, {y}), hy, hn))
  qed
  // (the break's word: on a mapped page, VG's)
  have vw: all y. y in bits(64) -> int_le(int_add(c.ctx, 920), y) -> int_lt(y, int_add(c.ctx, 928)) -> V.bytes[y] = VG.bytes[y] proof
    fix y
    assume hy h1 h2
    have yo: y in omega by arith(hy)
    have m := apply(mp.ctx_mapped[c := c, A := A1, vm := V1, b := B, a := y], hc, hu, ha, hh, yo, arith(h1, cx), (int_lt(y, int_add(c.ctx, mallocng.CTX_SIZE)) by arith(h2)),
      (!mallocng.ctx_free(c, y) by defs(arith(yo, h1, h2, cx), mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK)))
    have qo: int_div(y, x86_64_linux.PAGE) in omega by defs(arith(hy), x86_64_linux.PAGE)
    have nr: !(int_le(PO, int_div(y, x86_64_linux.PAGE)) && int_lt(int_div(y, x86_64_linux.PAGE), int_add(PO, int_sub(PN, PO)))) proof
      assume i
      show by taut(mp(all_elim(fr2, {int_div(y, x86_64_linux.PAGE)}), qo, i), mp(all_elim(mvg, {int_div(y, x86_64_linux.PAGE)}), m))
    qed
    have nb: !(int_le(int_mul(PO, x86_64_linux.PAGE), y) && int_lt(y, int_mul(int_add(PO, int_sub(PN, PO)), x86_64_linux.PAGE))) by arith(nr, hy, pon)
    show by simp(mp(all_elim(fby, {y}), hy), nb)
  qed
  have w9e: all j. j in omega -> int_lt(j, 8) -> V.bytes[int_add(int_add(c.ctx, 920), j)] = VG.bytes[int_add(int_add(c.ctx, 920), j)] proof
    fix j
    assume hj hjl
    show := mp(all_elim(vw, {int_add(int_add(c.ctx, 920), j)}), arith(cx, hj, hjl, hcb), arith(hj), arith(hjl))
  qed
  have w9 := apply(mp.rd_same[v1 := V, v2 := VG, a := int_add(c.ctx, 920), n := 8], arith(cx), simp(), arith(cx, hcb), w9e)
  have un: mallocng.untouched(c, A1, B, V1, V, e) proof
    have r: all x0. x0 in omega -> (!(x0 in mallocng.footprint(c, A1, B)) && !(x0 in e)) && x86_64_linux.mapped(V1, int_div(x0, x86_64_linux.PAGE)) ->
        V.bytes[bits_of_int(64, x0)] = V1.bytes[bits_of_int(64, x0)] && V.pages[int_div(x0, x86_64_linux.PAGE)] = V1.pages[int_div(x0, x86_64_linux.PAGE)] proof
      fix a
      assume ho hq
      have n1 _ m0 := hq
      have ml _ := expand(m0, x86_64_linux.mapped)
      have ab: bits_of_int(64, a) = a by defs(arith(ho, expand(ml, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)), bits_of_int, pow2)
      have nc: !(int_le(int_add(c.ctx, 920), a) && int_lt(a, int_add(c.ctx, 928))) proof
        assume q
        have q1 q2 := q
        have fp := apply(mp.ctx_fp[c := c, A := A1, vm := V1, b := B, a := a], hc, hu, ha, hh, ho, arith(q1, cx), (int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE)) by arith(q2)))
        show by taut(fp, n1)
      qed
      have bb1 := mp(all_elim(vv, {bits_of_int(64, a)}), (bits_of_int(64, a) in bits(64) by simp()), rewrite(sym(ab), m0), rewrite(sym(ab), nc))
      have pp := mp(all_elim(vvp, {int_div(a, x86_64_linux.PAGE)}), (int_div(a, x86_64_linux.PAGE) in omega by defs(arith(ho), x86_64_linux.PAGE)), m0)
      show by taut(bb1, pp)
    qed
    show by defs(taut(r, trans(fs, gs)), mallocng.untouched)
  qed
  have gd: g = 1 -> !x86_64_linux.mapped(V1, int_div(bb, 4096)) proof
    assume h1
    have _ _ b3 b4 := mp(bgu, h1)
    have gpo: int_div(bb, 4096) = PO := trans(sym(b3), sym(pof))
    assume m
    have gpn: int_div(bb, 4096) in omega by arith(b4)
    show by taut(mp(all_elim(fr2, {int_div(bb, 4096)}), gpn, (int_le(PO, int_div(bb, 4096)) && int_lt(int_div(bb, 4096), int_add(PO, int_sub(PN, PO))) by arith(gpo, plt, pon))),
      mp(all_elim(mvg, {int_div(bb, 4096)}), m))
  qed
  show by taut(vvp, vv, un, w9, gd)
qed

// (after the guard page: memory as after the break moved but for that page
// -- below the reserve's, unmapped before -- or errno; Ve: the memory
// before the break moved with errno so written)
def mp.gd_ok(c, s, V1, V, Vm, Ve, R2) := (all q. q in omega -> x86_64_linux.mapped(V1, q) -> Vm.pages[q] = V.pages[q]) &&
  Vm.pages[int_div(R2, 4096)] = V.pages[int_div(R2, 4096)] &&
  (all a. a in bits(64) -> int_le(R2, a) -> int_lt(a, int_add(R2, 4096)) -> Vm.bytes[a] = V.bytes[a]) &&
  (all y. y in bits(64) -> x86_64_linux.mapped(V1, int_div(y, x86_64_linux.PAGE)) -> !(int_le(int_add(c.ctx, 920), y) && int_lt(y, int_add(c.ctx, 928))) ->
     Vm.bytes[y] = Ve.bytes[y]) &&
  (all y. y in bits(64) -> !(y in mp.errno(s.fs_base)) -> Ve.bytes[y] = V1.bytes[y]) &&
  Vm.stack_top = V.stack_top && Vm.stack_limit = V.stack_limit && Vm.brk_start = V.brk_start && Vm.brk = V.brk &&
  Ve in x86_64_linux.Vm && fn_update(Ve, "bytes", V1.bytes) = V1 && Ve.pages = V1.pages

// the break moved (nw): its last new page the reserve, a guard page below
// it the first time -- mapped over by mmap, or errno written --; the break,
// the reserve and its page count written
theorem mp.am_brkok(c, A, B, s, V1, A1, VG, g, nw, bb, V, Vm, Ve): mp.am_st(c, A, B, s, V1, A1) -> c in mallocng.Cfg -> s in abi.World ->
  B in fn_space(bits(64), option(omega)) -> mallocng_specs.errno_apart(c, A, B, s.vm, s.fs_base) -> int_le(int_add(s.fs_base, 56), int_pow(2, 64)) ->
  int_le(int_add(c.ctx, 928), 18446744073709551616) -> !(A1.init_done = 0) -> A1.reserve_cnt = 0 -> A1.avail_cnt = 0 -> abi.brk_start_ok(s.vm) ->
  mp.am_jg(c, A1, V1, VG, g, nw, bb) -> V in x86_64_linux.Vm -> V.brk = nw -> !int_lt(nw, VG.brk_start) ->
  ((int_lt(x86_64_linux.pages_for(VG.brk), x86_64_linux.pages_for(nw)) &&
     x86_64_linux.free_range(VG, x86_64_linux.pages_for(VG.brk), int_sub(x86_64_linux.pages_for(nw), x86_64_linux.pages_for(VG.brk))) &&
     x86_64_linux.off_stack_space(VG, x86_64_linux.pages_for(VG.brk), int_sub(x86_64_linux.pages_for(nw), x86_64_linux.pages_for(VG.brk))) &&
     mallocng_specs.fresh_pages(VG, V, x86_64_linux.pages_for(VG.brk), int_sub(x86_64_linux.pages_for(nw), x86_64_linux.pages_for(VG.brk)),
       fn_update(fn_update(empty, "prot", fn_update(fn_update(fn_update(empty, "r", true), "w", true), "x", false)), "kind", 1))) ||
   (!int_lt(x86_64_linux.pages_for(VG.brk), x86_64_linux.pages_for(nw)) &&
     mallocng_specs.gone_pages(VG, V, x86_64_linux.pages_for(nw), int_sub(x86_64_linux.pages_for(VG.brk), x86_64_linux.pages_for(nw))))) ->
  Vm in x86_64_linux.Vm ->
  ((g = 0 && Vm = V && Ve = V1) ||
   (g = 1 && (ex pg. mallocng_specs.fresh_pages(V, Vm, int_div(bb, 4096), 1, pg) && Vm.brk = V.brk) && Ve = V1) ||
   (g = 1 && (ex e. Vm = mallocng_specs.wr32(V, mallocng_specs.errno_at(s.fs_base), e) && Ve = mallocng_specs.wr32(V1, mallocng_specs.errno_at(s.fs_base), e)))) ->
  st: mp.am_j1(c, A, B, s, fn_update(Vm, "bytes", x86_64_linux.store_le(x86_64_linux.store_le(x86_64_linux.store_le(Vm.bytes,
    int_add(c.ctx, 920), 8, nw), int_add(c.ctx, 72), 8, bits_sub(64, nw, 4096)), int_add(c.ctx, 40), 8, bits_shr(64, 4096, 12))),
    mp.refill(A1, int_sub(nw, 4096), 1, nw), 0) &&
  pages: (all q. q in omega -> x86_64_linux.mapped(V1, q) -> Vm.pages[q] = V1.pages[q])
proof
  assume S hc hw hbt hea hfl hcb hid h0 ha0 hbs J hv hvb hns hgr hmv hgd
  have s1 s2 s3 s4 _ _ su _ _ := S
  have cx: c.ctx in omega by simp(expand(hc, mallocng.Cfg))
  have {gp = pages, gt = top, gl = lim, gs = start, gbk = brk} := apply(mp.jg_parts, J, cx, hcb)
  have _ ubs := expand(su, mallocng.untouched)
  have pg: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
  have bs0: int_le(4096, V1.brk_start) by defs(simp(expand(hbs, abi.brk_start_ok), ubs, pg), x86_64_linux.PAGE)
  have {bno = nat, bnb = nwb, bpo = pos, bal = al, bsu = sub, bpo2 = po, bpn = pn, bgu = guard} := apply(mp.brk_pages, J, s1, bs0, rewrite(gs, hns))
  let PO := x86_64_linux.pages_for(VG.brk)
  let PN := x86_64_linux.pages_for(nw)
  let R2 := int_sub(nw, 4096)
  let RP := int_div(R2, 4096)
  have pof: PO = x86_64_linux.pages_for(V1.brk) := rewrite(gbk, refl({PO}), {2})
  have plt: int_lt(PO, PN) by arith(rewrite(sym(pof), bpo2), bpn)
  have _ gfree _ gfr := (int_lt(PO, PN) && x86_64_linux.free_range(VG, PO, int_sub(PN, PO)) && x86_64_linux.off_stack_space(VG, PO, int_sub(PN, PO)) &&
      mallocng_specs.fresh_pages(VG, V, PO, int_sub(PN, PO), fn_update(fn_update(empty, "prot", fn_update(fn_update(fn_update(empty, "r", true), "w", true), "x", false)), "kind", 1))
    by taut(hgr, plt))
  have ft fl fs fpg fby := expand(gfr, mallocng_specs.fresh_pages)
  have fr1 fr2 _ := expand(gfree, x86_64_linux.free_range)
  have _ _ jo _ _ _ := J
  have vgb: VG.brk in bits(64) by simp(gbk, expand(s1, x86_64_linux.Vm))
  have pon: PO in omega by defs(arith(vgb), x86_64_linux.pages_for, x86_64_linux.PAGE)
  have pnv: PN = int_add(RP, 1) := bpn
  have rpo: RP in omega by arith(bno)
  have r2v: R2 = int_mul(RP, 4096) by arith(bal, bno)
  have prp: int_le(PO, RP) := rewrite(sym(pof), bpo2)
  have pnt: int_le(PN, 34359738367) by arith(fr1, plt)
  // (pages mapped before: as they were; their bytes but the break's word)
  have mvg: all q. x86_64_linux.mapped(V1, q) -> x86_64_linux.mapped(VG, q) proof
    fix q
    assume m
    show by defs(simp(expand(m, x86_64_linux.mapped), gp), x86_64_linux.mapped)
  qed
  have vvp: all q. q in omega -> x86_64_linux.mapped(V1, q) -> V.pages[q] = V1.pages[q] proof
    fix q
    assume hq m
    have ml _ := expand(m, x86_64_linux.mapped)
    have nr: !(int_le(PO, q) && int_lt(q, int_add(PO, int_sub(PN, PO)))) proof
      assume i
      show by taut(mp(all_elim(fr2, {q}), hq, i), mp(all_elim(mvg, {q}), m))
    qed
    have e := mp(all_elim(fpg, {q}), hq, ml)
    show by simp(e, nr, gp)
  qed
  have vv: all y. y in bits(64) -> x86_64_linux.mapped(V1, int_div(y, x86_64_linux.PAGE)) -> !(int_le(int_add(c.ctx, 920), y) && int_lt(y, int_add(c.ctx, 928))) ->
      V.bytes[y] = V1.bytes[y] proof
    fix y
    assume hy m hn
    have qo: int_div(y, x86_64_linux.PAGE) in omega by defs(arith(hy), x86_64_linux.PAGE)
    have nr: !(int_le(PO, int_div(y, x86_64_linux.PAGE)) && int_lt(int_div(y, x86_64_linux.PAGE), int_add(PO, int_sub(PN, PO)))) proof
      assume i
      show by taut(mp(all_elim(fr2, {int_div(y, x86_64_linux.PAGE)}), qo, i), mp(all_elim(mvg, {int_div(y, x86_64_linux.PAGE)}), m))
    qed
    have nb: !(int_le(int_mul(PO, x86_64_linux.PAGE), y) && int_lt(y, int_mul(int_add(PO, int_sub(PN, PO)), x86_64_linux.PAGE))) by arith(nr, pg, hy, pon)
    have e := mp(all_elim(fby, {y}), hy)
    show by simp(e, nb, mp(all_elim(jo, {y}), hy, hn))
  qed
  // (the reserve's page: fresh heap, zero, unmapped before)
  have vr: V.pages[RP] = some(fn_update(fn_update(empty, "prot", fn_update(fn_update(fn_update(empty, "r", true), "w", true), "x", false)), "kind", 1)) proof
    have e := mp(all_elim(fpg, {RP}), rpo, (int_lt(RP, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) by arith(pnt, pnv)))
    show by simp(e, (int_le(PO, RP) && int_lt(RP, int_add(PO, int_sub(PN, PO))) by arith(prp, pnv, pon)))
  qed
  have vrb: all a. a in bits(64) -> int_le(R2, a) -> int_lt(a, int_add(R2, 4096)) -> V.bytes[a] = bits_of_int(8, 0) proof
    fix a
    assume ha h1 h2
    have e := mp(all_elim(fby, {a}), ha)
    show by simp(e, (int_le(int_mul(PO, x86_64_linux.PAGE), a) && int_lt(a, int_mul(int_add(PO, int_sub(PN, PO)), x86_64_linux.PAGE)) by arith(pg, prp, pnv, r2v, h1, h2, pon)))
  qed
  have vnu: !x86_64_linux.mapped(V1, RP) proof
    assume m
    show by taut(mp(all_elim(fr2, {RP}), rpo, (int_le(PO, RP) && int_lt(RP, int_add(PO, int_sub(PN, PO))) by arith(prp, pnv, pon))), mp(all_elim(mvg, {RP}), m))
  qed
  have v1rest: fn_update(V1, "bytes", V1.bytes) = V1 := mp(fn_update_same[f := V1, k := "bytes"], simp(expand(s1, x86_64_linux.Vm)), simp(expand(s1, x86_64_linux.Vm)))
  have fsb: s.fs_base in bits(64) by simp(expand(hw, abi.World))
  // no guard page: V
  have k0: g = 0 && Vm = V && Ve = V1 -> mp.gd_ok(c, s, V1, V, Vm, Ve, R2) proof
    assume q
    have _ q1 q2 := q
    have a1: all q. q in omega -> x86_64_linux.mapped(V1, q) -> Vm.pages[q] = V.pages[q] proof
      fix q
      assume _ _
      show by simp(q1)
    qed
    have a3: all a. a in bits(64) -> int_le(R2, a) -> int_lt(a, int_add(R2, 4096)) -> Vm.bytes[a] = V.bytes[a] proof
      fix a
      assume _ _ _
      show by simp(q1)
    qed
    have a4: all y. y in bits(64) -> x86_64_linux.mapped(V1, int_div(y, x86_64_linux.PAGE)) -> !(int_le(int_add(c.ctx, 920), y) && int_lt(y, int_add(c.ctx, 928))) ->
        Vm.bytes[y] = Ve.bytes[y] proof
      fix y
      assume hy m hn
      show by simp(q1, q2, mp(all_elim(vv, {y}), hy, m, hn))
    qed
    have a5: all y. y in bits(64) -> !(y in mp.errno(s.fs_base)) -> Ve.bytes[y] = V1.bytes[y] proof
      fix y
      assume _ _
      show by simp(q2)
    qed
    show by defs(taut(a1, (Vm.pages[RP] = V.pages[RP] by simp(q1)), a3, a4, a5, (Vm.stack_top = V.stack_top by simp(q1)), (Vm.stack_limit = V.stack_limit by simp(q1)),
      (Vm.brk_start = V.brk_start by simp(q1)), (Vm.brk = V.brk by simp(q1)), (Ve in x86_64_linux.Vm by simp(q2, s1)),
      subst({y. fn_update(y, "bytes", V1.bytes) = V1}, sym(q2), v1rest),
      (Ve.pages = V1.pages by simp(q2))), mp.gd_ok)
  qed
  // the guard page mapped over: its page alone changed
  have k1: g = 1 && (ex pg. mallocng_specs.fresh_pages(V, Vm, int_div(bb, 4096), 1, pg) && Vm.brk = V.brk) && Ve = V1 -> mp.gd_ok(c, s, V1, V, Vm, Ve, R2) proof
    assume q
    have q0 qx q2 := q
    obtain pgg, qf qb from qx
    have gt1 gl1 gs1 gpg gby := expand(qf, mallocng_specs.fresh_pages)
    have b1 b2 b3 b4 := mp(bgu, q0)
    let GP := int_div(bb, 4096)
    have gpo: GP = PO := trans(sym(b3), sym(pof))
    have gpn: GP in omega by arith(b4)
    have gnu: !x86_64_linux.mapped(V1, GP) proof
      assume m
      show by taut(mp(all_elim(fr2, {GP}), gpn, (int_le(PO, GP) && int_lt(GP, int_add(PO, int_sub(PN, PO))) by arith(gpo, plt, pon))), mp(all_elim(mvg, {GP}), m))
    qed
    have a1: all q. q in omega -> x86_64_linux.mapped(V1, q) -> Vm.pages[q] = V.pages[q] proof
      fix q
      assume hq m
      have ml _ := expand(m, x86_64_linux.mapped)
      have ne: !(q = GP) proof
        assume e
        show by taut(gnu, rewrite(e, m))
      qed
      have e := mp(all_elim(gpg, {q}), hq, ml)
      show by simp(e, (!(int_le(GP, q) && int_lt(q, int_add(GP, 1))) by arith(ne, hq, gpn)))
    qed
    have a2: Vm.pages[RP] = V.pages[RP] proof
      have e := mp(all_elim(gpg, {RP}), rpo, (int_lt(RP, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) by arith(pnt, pnv)))
      show by simp(e, (!(int_le(GP, RP) && int_lt(RP, int_add(GP, 1))) by arith(b2, gpn)))
    qed
    have a3: all a. a in bits(64) -> int_le(R2, a) -> int_lt(a, int_add(R2, 4096)) -> Vm.bytes[a] = V.bytes[a] proof
      fix a
      assume ha h1 _
      have e := mp(all_elim(gby, {a}), ha)
      show by simp(e, (!(int_le(int_mul(GP, x86_64_linux.PAGE), a) && int_lt(a, int_mul(int_add(GP, 1), x86_64_linux.PAGE))) by arith(pg, b2, r2v, h1, gpn)))
    qed
    have a4: all y. y in bits(64) -> x86_64_linux.mapped(V1, int_div(y, x86_64_linux.PAGE)) -> !(int_le(int_add(c.ctx, 920), y) && int_lt(y, int_add(c.ctx, 928))) ->
        Vm.bytes[y] = Ve.bytes[y] proof
