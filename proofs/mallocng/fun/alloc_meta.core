    qed
    have a4: all y. y in bits(64) -> x86_64_linux.mapped(V1, int_div(y, x86_64_linux.PAGE)) -> !(int_le(int_add(c.ctx, 920), y) && int_lt(y, int_add(c.ctx, 928))) ->
        Vm.bytes[y] = Ve.bytes[y] proof
      fix y
      assume hy m hn
      have ag := all_elim(tr.store_le_agree, {V.bytes}, {V1.bytes}, {EA}, {4}, {e}, {y})
      have q3 := mp(ag, hy, mp(all_elim(vv, {y}), hy, m, hn))
      show by simp(qm, qe, all_elim(ms.v_wr32, {V}, {EA}, {e}), all_elim(ms.v_wr32, {V1}, {EA}, {e}), q3, keep(mallocng_specs.errno_at))
    qed
    have a5: all y. y in bits(64) -> !(y in mp.errno(s.fs_base)) -> Ve.bytes[y] = V1.bytes[y] proof
      fix y
      assume hy hn
      show := rewrite(sym(qe), rewrite(sym(ea), apply(mp.wr32_out[V := V1, c := int_add(s.fs_base, 52), v := e, x := y], hy, eab, arith(fsb, hfl), mp(all_elim(oe, {y}), hy, hn))))
    qed
    have ver: fn_update(Ve, "bytes", V1.bytes) = V1 by simp(qe, v1rest, keep(mallocng_specs.errno_at), all_elim(ms.v_wr32, {V1}, {EA}, {e}))
    show by defs(taut(a1, (Vm.pages[RP] = V.pages[RP] by simp(vmp)), a3, a4, a5, rewrite(sym(qm), kt), rewrite(sym(qm), kl), rewrite(sym(qm), ks), rewrite(sym(qm), kb),
      rewrite(sym(qe), apply(mp.w32_vm[V := V1, c := EA, v := e], s1)), ver, rewrite(sym(qe), kp1)), mp.gd_ok)
  qed
  have gd0: mp.gd_ok(c, s, V1, V, Vm, Ve, R2) by taut(hgd, k0, k1, k2)
  have gmp gmr gmb gme gev gmt gml gms gmk gvv gvr gvp := expand(gd0, mp.gd_ok)
  // the memory before, errno as after: a run state
  have sve := apply(mp.am_errb[c := c, A := A, B := B, s := s, V := V1, A1 := A1, V2 := Ve], S, hw, hea, hfl, gvv, gvr, gev)
  let VF := fn_update(Vm, "bytes", x86_64_linux.store_le(x86_64_linux.store_le(x86_64_linux.store_le(Vm.bytes,
    int_add(c.ctx, 920), 8, nw), int_add(c.ctx, 72), 8, bits_sub(64, nw, 4096)), int_add(c.ctx, 40), 8, bits_shr(64, 4096, 12)))
  have c920: int_add(c.ctx, 920) in bits(64) by arith(cx, hcb)
  have c72: int_add(c.ctx, 72) in bits(64) by arith(cx, hcb)
  have c40: int_add(c.ctx, 40) in bits(64) by arith(cx, hcb)
  // (VF's bytes outside the three words: Vm's)
  have fo: all y. y in bits(64) -> !(int_le(int_add(c.ctx, 920), y) && int_lt(y, int_add(c.ctx, 928))) -> !(int_le(int_add(c.ctx, 72), y) && int_lt(y, int_add(c.ctx, 80))) ->
      !(int_le(int_add(c.ctx, 40), y) && int_lt(y, int_add(c.ctx, 48))) -> VF.bytes[y] = Vm.bytes[y] proof
