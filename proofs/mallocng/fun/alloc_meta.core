  have hve := (mallocng.holds_in(c, A1, Ve, B) by taut(sve))
  have P: mp.rfpre(c, A1, Ve, VF, B, R2, 1, nw) by taut(hc, s3, s2, hbt, gvv, vfV, hve, hid, h0, (R2 in omega && 1 in omega && nw in omega by taut(bno, (1 in omega by simp()))),
    (int_lt(0, 1) && int_lt(0, R2) by taut((int_lt(0, 1) by arith()), bpo)), bal, frs, npg, pgs, bys, rest, bo, w40, w48, (int_lt(0, 1) -> gimple.bytes_at(VF, int_add(c.ctx, 72), 8) = R2 by taut(w72)), w920)
  have st := apply(mp.am_rf[c := c, A := A, B := B, s := s, V := Ve, A1 := A1, V2 := VF, R2 := R2, Kc := 1, Bk := nw], sve, hw, hea, hfl, P)
  have np0 := mp(all_elim(npg, {R2}), arith(bno), arith(bno), arith(bno))
  have rw: mallocng.m_rw(mallocng.mview(VF, mallocng.all_bytes()), R2) proof
    have aa: R2 in mallocng.all_bytes() by defs(simp(bno), mallocng.all_bytes)
    have pv := apply(mp.pg_view[vm := VF, fp := mallocng.all_bytes(), a := R2], arith(bno), aa)
    have dq: int_div(R2, x86_64_linux.PAGE) = RP by simp(pg)
    have pr: mallocng.pg(mallocng.mview(VF, mallocng.all_bytes()), R2) = some(HP) := trans(pv, rewrite(sym(dq), vrp))
    have mm _ _ := np0
    show by defs(taut(mm, (snd(mallocng.pg(mallocng.mview(VF, mallocng.all_bytes()), R2)).prot.r by simp(pr)),
      (snd(mallocng.pg(mallocng.mview(VF, mallocng.all_bytes()), R2)).prot.w by simp(pr))), mallocng.m_rw)
  qed
  have _ nk _ := np0
  have er: mp.refill(A1, R2, 1, nw).reserve = R2 by simp()
  have aj: mp.am_j1(c, A, B, s, VF, mp.refill(A1, R2, 1, nw), 0) by taut(st, (!(mp.refill(A1, R2, 1, nw).init_done = 0) by simp(hid)), (mp.refill(A1, R2, 1, nw).avail_cnt = 0 by simp(ha0)),
    refl({0}), (int_lt(0, mp.refill(A1, R2, 1, nw).reserve_cnt) by simp()), rewrite(sym(er), rw), rewrite(sym(er), nk))
  have pq: all q. q in omega -> x86_64_linux.mapped(V1, q) -> Vm.pages[q] = V1.pages[q] proof
    fix q
    assume hq m
    show := trans(mp(all_elim(gmp, {q}), hq, m), mp(all_elim(vvp, {q}), hq, m))
  qed
  show by taut(aj, pq)
qed

abbrev mp.calls(g, F) := all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(g[regs], s, o) -> runs(F[regs], s, o)

// alloc_meta's purpose (`alloc_meta_spec`): a meta taken (the state's
// taken metas grown by it) and ready, or 0; the groups as before, the
// invariant kept, nothing outside the allocator touched but errno, the
// footprint grown only by memory unmapped before -- or an overflow
abbrev mp.am_out(c, A, b, s, o) := (ex v. v in x86_64_linux.Vm && o = exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex A2 V2 m. mp.am_post(c, A, b, s, A2, V2, m) && o = ok(fn_update(s, "vm", V2), m))

theorem mp.am_run(c, grs, gdh, gsy, gmm, gmp, gel, s, h, o): c in mallocng.Cfg -> c.ctx = c_src_malloc_mallocng_malloc.__malloc_context ->
  mp.calls(grs, mallocng_specs.random_secret_spec_fun(c.libc)) -> mp.calls(gdh, mallocng_specs.dequeue_head_spec_fun()) -> mp.calls(gsy, mallocng_specs.syscall1_spec_fun()) ->
  mp.calls(gmm, mallocng_specs.mmap_spec_fun()) -> mp.calls(gmp, mallocng_specs.mprotect_spec_fun()) -> mp.calls(gel, mallocng_specs.errno_location_spec_fun) ->
  s in abi.World -> h in mp.G ->
  mallocng.holds_in(c, h.A, s.vm, h.blocks) -> abi.thread_ok(s.vm, s.fs_base) -> mallocng_specs.tls_apart(c, h.A, h.blocks, s.fs_base) -> abi.brk_start_ok(s.vm) ->
  mallocng_specs.errno_ok(s.vm, s.objs, s.fs_base) -> mallocng_specs.errno_apart(c, h.A, h.blocks, s.vm, s.fs_base) ->
  runs(c_src_malloc_mallocng_malloc.__malloc_alloc_meta(grs, gdh, gsy, gmm, gmp, gel), s, o) ->
  mp.am_out(c, h.A, h.blocks, s, o)
proof
  assume hc hx hrs hdh hsy hmm hmp hel hw hh hin hth htl hbs heo hea hr
  let A := h.A
  let B := h.blocks
  let V0 := s.vm
  have pu := apply(g.runs_univ, hr)
  have hu: s in univ(1) by simp(pu)
  have hgu _ hbt hat := mp(all_elim(mp.g_rec, {h}), hh)
  have au := mp(app_univ[u := 1, f := h, k := "A"], hgu)
  have vV vfun vdom vb := apply(ms.world_parts, hw)
  have cx: c.ctx in omega by simp(expand(hc, mallocng.Cfg))
  have cnz: !(c.ctx = 0) by defs(simp(hx), c_src_malloc_mallocng_malloc.__malloc_context)
  // (the context's bytes up to 12: the invariant's, none a free counter)
  have NF: all off n. off in omega -> n in omega -> int_le(int_add(off, n), 12) -> (all i. i in omega -> int_lt(i, n) -> !mallocng.ctx_free(c, int_add(int_add(c.ctx, off), i))) proof
    fix off n
    assume ho hn hl
    fix i
    assume hi hil
    show by defs(arith(ho, hi, hil, hl, cx), mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK)
  qed
  // (... from 16 to the counters, and the break's word)
  have NF2: all off n. off in omega -> n in omega -> int_le(16, off) -> int_le(int_add(off, n), 464) ->
      (all i. i in omega -> int_lt(i, n) -> !mallocng.ctx_free(c, int_add(int_add(c.ctx, off), i))) proof
    fix off n
    assume ho hn hl hl2
    fix i
    assume hi hil
    show by defs(arith(ho, hi, hil, hl, hl2, cx), mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK)
  qed
  have NFB: all i. i in omega -> int_lt(i, 8) -> !mallocng.ctx_free(c, int_add(int_add(c.ctx, 920), i)) proof
    fix i
    assume hi hil
    show by defs(arith(hi, hil, cx), mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK)
  qed
  have u8 u8w := apply(mp.ctx_usable[c := c, A := A, vm := V0, b := B, objs := s.objs, off := 8, n := 4], hc, au, hat, hin, simp(), simp(), arith(),
    mp(all_elim(NF, {8}, {4}), simp(), simp(), simp()))
  have cv: c.ctx = 4227328 by defs(simp(hx), c_src_malloc_mallocng_malloc.__malloc_context)
  have cb: c.ctx in bits(64) by simp(cv)
  let K := c_src_malloc_mallocng_malloc.__malloc_context
  have kb: K in bits(64) := rewrite(hx, cb)
  step a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 x1, c1 from hr with g.ld32_det using conj(hu, kb, u8, cv, hx, cnz)
  // the init word: A's
  have rd8 := apply(mp.ctx_read[c := c, A := A, vm := V0, b := B, off := 8, n := 4], hc, au, hat, hin, simp(), simp(), arith(), mp(all_elim(NF, {8}, {4}), simp(), simp(), simp()))
  have {H0 = inv} := expand(hin, mallocng.holds_in)
  have {cok = ctx} := expand(H0, mallocng.holds)
  have {ci0 = init, cil = init_lt} := expand(cok, mallocng.ctx_ok)
  have cid: mallocng.C_INIT_DONE = 8 by defs(refl({8}), mallocng.C_INIT_DONE)
  have b8w: gimple.bytes_at(V0, int_add(K, 8), 4) = A.init_done := rewrite(hx, trans(rd8, rewrite(cid, ci0)))
  have ino: A.init_done in omega by simp(hat)
  have i0: bits_of_int(32, gimple.bytes_at(V0, int_add(K, 8), 4)) = A.init_done by defs(arith(b8w, cil, ino), bits_of_int, pow2)
  have tb kx := c1
  have ths: gc.sound(s) by simp(hth)
  let LOC := pair(a1, pair(a2, pair(a3, pair(a4, pair(a5, pair(a6, pair(a7, pair(a8, pair(a9, pair(a10, pair(a11, a12)))))))))))
  let OVF := exc_val("stack_overflow", empty)
  let T1 := (ex v. v in x86_64_linux.Vm && x1 = exc(pair(fn_update(s, "vm", v), LOC), pair("raise", OVF))) ||
    (ex V1 A1. (mp.am_st(c, A, B, s, V1, A1) && !(A1.init_done = 0)) && x1 = ok(pair(fn_update(s, "vm", V1), LOC), empty))
  // the first call: the secret read, the allocator initialized
  have first: A.init_done = 0 -> T1 proof
    assume h0
    have z: bits_of_int(32, gimple.bytes_at(V0, int_add(K, 8), 4)) = 0 := trans(i0, h0)
    have ax := apply(mp.am_auxv[c := c, A := A, vm := V0, b := B, objs := s.objs], hc, au, hat, hbt, hin, h0, vb)
    have ss: fn_update(s, "vm", V0) = s := mp(fn_update_same[f := s, k := "vm"], vfun, vdom)
    have _ u0w := apply(mp.ctx_usable[c := c, A := A, vm := V0, b := B, objs := s.objs, off := 0, n := 8], hc, au, hat, hin, simp(), simp(), arith(),
      mp(all_elim(NF, {0}, {8}), simp(), simp(), simp()))
    // (the secret read, written, the init word set)
    step e0 from tb with z
    step r, e3 hrb from e0 with mp.rs_q, ss, mp.st64w_det, ms.st32_det using conj(hw, hu, vV, ax, ths, hrs, kb, u0w, u8w, cv, hx, cnz)
    have fsl _ _ := expand(heo, mallocng_specs.errno_ok)
    have st := apply(mp.am_init_st[c := c, A := A, B := B, s := s, sec := fst(r)], hc, hw, hu, hat, au, hbt, hin, h0, hrb, hea, fsl, arith(cv))
    let V1 := fn_update(V0, "bytes", x86_64_linux.store_le(x86_64_linux.store_le(V0.bytes, int_add(c.ctx, 0), 8, fst(r)), int_add(c.ctx, 8), 4, 1))
    have e4: x1 = ok(pair(fn_update(s, "vm", V1), LOC), empty) := rewrite(sym(hx), e3)
    show by disj({2}, ex_intro({V1}, {mp.first(A, fst(r))}, taut(st, e4)))
  qed
  // initialized before: nothing changed
  have notfirst: !(A.init_done = 0) -> T1 proof
    assume hn
    have z: !(bits_of_int(32, gimple.bytes_at(V0, int_add(K, 8), 4)) = 0) := rewrite(sym(i0), hn)
    have e: x1 = ok(pair(s, LOC), empty) by taut(tb, z)
    have ss: fn_update(s, "vm", V0) = s := mp(fn_update_same[f := s, k := "vm"], vfun, vdom)
    have st0 := apply(mp.am_st0[c := c, A := A, B := B, s := s], vV, hat, au, hin)
    show by disj({2}, ex_intro({V0}, {A}, taut(st0, hn, rewrite(sym(ss), e, {1}))))
  qed
  have t1: T1 by taut(first, notfirst)
  // an overflow at the first call: the run's
  // (after the first call or none: an overflow, the run's; else on)
  step V1 A1, k1 hP from kx with t1
    have s1 s2 s3 s4 s5 s6 s7 s8 s9 hid := hP
    have hst: mp.am_st(c, A, B, s, V1, A1) by taut(s1, s2, s3, s4, s5, s6, s7, s8, s9)
    let W1 := fn_update(s, "vm", V1)
    have w1W w1u := apply(mp.am_world, hw, hu, s1)
    have th1 := apply(mp.am_thread[c := c, A := A, B := B, s := s, V := V1, A1 := A1], hst, hw, hth, htl)
    have ths1: gc.sound(W1) by simp(th1)
    have v1b: V1.bytes in fn_space(bits(64), bits(8)) by simp(expand(s1, x86_64_linux.Vm))
    have cal: int_mod(c.ctx, 8) = 0 by simp(cv)
    have la1 := apply(mp.free_metas_at[c := c, A := A1, vm := V1, b := B, objs := s.objs], hc, s3, s2, v1b, s4, cal)
    have fl: A1.free_metas in list_type(omega) by simp(s2)
    step x2, k2 from k1
    let SV := gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), 16)
    have sv: SV = 16 by defs(simp(), gimple.sval)
    have pa1: int_le(0, int_add(K, SV)) by simp(sv, kb)
    have pa2: int_lt(int_add(K, SV), pow2(64)) by simp(sv, cv, hx)
    step k3 from k2 with g.padd_det using conj(w1u, kb, pa1, pa2, cv, hx, cnz)
    have kf: mallocng.C_FREE_META = 16 by defs(refl({16}), mallocng.C_FREE_META)
    let PH := int_add(K, 16)
    have phb: PH in bits(64) by simp(cv, hx)
    have laW: mallocng_specs.list_at(W1.vm, W1.objs, PH, A1.free_metas) by simp(rewrite(hx, rewrite(kf, la1)), keep(mallocng_specs.list_at))
    have thW: abi.thread_ok(W1.vm, W1.fs_base) by simp(th1, keep(abi.thread_ok))
    // (the head dequeued: dequeue_head's contract)
    step V2 r, hk4 hR from rewrite(sv, k3) with mp.dqh_qr using conj(w1W, w1u, ths1, phb, fl, laW, thW, hdh)
    have hV2 hih hht := hR
      let F := A1.free_metas
      let HD := ite(seq_len(F) = 0, 0, F[0])
      have hd: fst(r) = HD by simp(mp(all_elim(expand(hih, mallocng_specs.is_head), {F}), fl, laW))
      have flo: seq_len(F) in omega by arith(fl)
      // a free meta: taken, returned
      have taken: int_lt(0, seq_len(F)) -> mp.am_out(c, A, B, s, o) proof
        assume hn
        have {H1 = inv} := expand(s4, mallocng.holds_in)
        have {mpart = part} := expand(H1, mallocng.holds)
        have {fs = free_slots} := expand(mpart, mallocng.metas_partition)
        have ms0 _ := mp(all_elim(fs, {0}), simp(), hn)
        have {go = nat, glo = low} := apply(mp.slot_meta[c := c, A := A1, vm := V1, b := B, g := F[0]], hc, s3, s2, s4, ms0, apply(mp.free_untaken, H1, (0 in omega by simp()), hn))
        have h0: fst(r) = F[0] by simp(hd, hn, flo)
        have nz: !(fst(r) = 0) by arith(h0, glo)
        step x3, k5 from hk4 with nz
        have _ ht := expand(hht, mallocng_specs.head_taken)
        have dq0 := mp(ht, nz)
        have dq: mallocng_specs.dequeued(V1, V2, s.objs, int_add(c.ctx, 16), F[0]) := rewrite(sym(hx), rewrite(h0, (mallocng_specs.dequeued(V1, V2, s.objs, PH, fst(r)) by simp(dq0, keep(mallocng_specs.dequeued)))))
        have post := apply(mp.am_deq[c := c, A := A, B := B, s := s, V1 := V1, A1 := A1, V2 := V2], hst, hc, cal, hbt, hn, hV2, dq)
        show by disj({2}, ex_intro({mp.take(A1, mallocng_specs.rm_at(F, 0), A1.avail_cnt, F[0])}, {V2}, {F[0]}, taut(post, rewrite(h0, k5))))
      qed
      // none free: nothing changed, on
      have none: seq_len(F) = 0 -> mp.am_out(c, A, B, s, o) proof
        assume h0
        have z: fst(r) = 0 by simp(hd, h0)
        have e2 _ := expand(hht, mallocng_specs.head_taken)
        have ev: V2 = V1 by simp(mp(e2, z))
        have k5 := rewrite(ev, hk4)
        step x3, k6 from rewrite(z, k5) with (!!(0 = 0) by simp())
        // the available metas' count: A1's
        have u32 _ := apply(mp.ctx_usable[c := c, A := A1, vm := V1, b := B, objs := s.objs, off := 32, n := 8], hc, s3, s2, s4, simp(), simp(), arith(),
          mp(all_elim(NF2, {32}, {8}), simp(), simp(), simp(), simp()))
        step x4, k7 from k6 with g.ld64_det using conj(w1u, kb, u32, cv, hx, cnz)
        have rd32 := apply(mp.ctx_read[c := c, A := A1, vm := V1, b := B, off := 32, n := 8], hc, s3, s2, s4, simp(), simp(), arith(),
          mp(all_elim(NF2, {32}, {8}), simp(), simp(), simp(), simp()))
        have {H1 = inv} := expand(s4, mallocng.holds_in)
        have {cok1 = ctx} := expand(H1, mallocng.holds)
        have {cav = avail_cnt, cavl = avail_le} := expand(cok1, mallocng.ctx_ok)
        have kac: mallocng.C_AVAIL_CNT = 32 by defs(refl({32}), mallocng.C_AVAIL_CNT)
        have b32: gimple.bytes_at(V1, int_add(K, 32), 8) = A1.avail_cnt := rewrite(hx, trans(rd32, expand(rewrite(kac, cav), mallocng.ctx_word)))
        have avo: A1.avail_cnt in omega by simp(s2)
        have i32: bits_of_int(64, gimple.bytes_at(V1, int_add(K, 32), 8)) = A1.avail_cnt by defs(arith(b32, cavl, avo, (mallocng.NSLOTS = 101 by defs(refl({101}), mallocng.NSLOTS))), bits_of_int, pow2)
        have tb2 kx2 := k7
        let T2 := (ex v L. v in x86_64_linux.Vm && x4 = exc(pair(fn_update(s, "vm", v), L), pair("raise", OVF))) ||
          (ex A3 V3 L. mp.am_post(c, A, B, s, A3, V3, 0) && x4 = exc(pair(fn_update(s, "vm", V3), L), pair("ret", 0))) ||
          (ex A3 V3 L. (mp.am_st(c, A, B, s, V3, A3) && !(A3.init_done = 0) && int_lt(0, A3.avail_cnt)) && x4 = ok(pair(fn_update(s, "vm", V3), L), empty))
        // the area's next meta taken, from where the ways meet
        have finish: T2 -> mp.am_out(c, A, B, s, o) proof
          assume ht2
          have f1: case 1 of ht2 proof
            assume e
            obtain v L, hv hx4 from e
            step oe from rewrite(hx4, kx2)
            show by disj({1}, ex_intro({v}, taut(hv, oe)))
          qed
          have f2: case 2 of ht2 proof
            assume e
            obtain A3 V3 L, p1 p2 p3 p4 p5 p6 p7 p8 p9 p10 p11 p12 hx4 from e
            step oe from rewrite(hx4, kx2)
            show by disj({2}, ex_intro({A3}, {V3}, {0}, taut(p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12, oe)))
          qed
          have f3: case 3 of ht2 proof
            assume e
            obtain A3 V3 L, t1 t2 t3 t4 t5 t6 t7 t8 t9 hid3 hav3 hx4 from e
            step k8 from rewrite(hx4, kx2)
            let W3 := fn_update(s, "vm", V3)
            have w3W w3u := apply(mp.am_world, hw, hu, t1)
            have v3V v3f v3d v3b := apply(ms.world_parts, w3W)
            have q32r q32w := apply(mp.ctx_usable[c := c, A := A3, vm := V3, b := B, objs := s.objs, off := 32, n := 8], hc, t3, t2, t4, simp(), simp(), arith(),
              mp(all_elim(NF2, {32}, {8}), simp(), simp(), simp(), simp()))
            have q24r q24w := apply(mp.ctx_usable[c := c, A := A3, vm := V3, b := B, objs := s.objs, off := 24, n := 8], hc, t3, t2, t4, simp(), simp(), arith(),
              mp(all_elim(NF2, {24}, {8}), simp(), simp(), simp(), simp()))
            have {r32 = r32, r24 = r24, mo = nat, mlo = low, mbd = bound, mu = use, mlt = lt} := apply(mp.am_tak1[c := c, A := A3, V := V3, b := B, objs := s.objs], hc, t3, t2, t4, hav3)
            have mur muw := mu
            let M := mp.anext(A3)
            have cnto: A3.avail_cnt in omega by simp(t2)
            have ec: bits_of_int(64, gimple.bytes_at(V3, int_add(K, 32), 8)) = A3.avail_cnt by defs(arith(r32, cnto, (int_le(A3.avail_cnt, 101) by arith(apply(mp.anext_at, t2, t4, hav3).le, (mallocng.NSLOTS = 101 by defs(refl({101}), mallocng.NSLOTS)))), hx), bits_of_int, pow2)
            have em: bits_of_int(64, gimple.bytes_at(V3, int_add(K, 24), 8)) = M by defs(arith(r24, mo, mbd, hx), bits_of_int, pow2)
            have cm1: bits_add(64, A3.avail_cnt, bits_neg(64, 1)) = int_sub(A3.avail_cnt, 1) by defs(arith(cnto, hav3, (int_le(A3.avail_cnt, 101) by arith(apply(mp.anext_at, t2, t4, hav3).le, (mallocng.NSLOTS = 101 by defs(refl({101}), mallocng.NSLOTS))))), bits_add, bits_neg, pow2)
            let SV40 := gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), 40)
            have sv40: SV40 = 40 by defs(simp(), gimple.sval)
            have mb: M in bits(64) by arith(mo, mbd)
            have pm1: int_le(0, int_add(M, SV40)) by simp(sv40, mo)
            have pm2: int_lt(int_add(M, SV40), pow2(64)) by simp(sv40, mlt)
            have mnz: !(M = 0) by arith(mlo)
            have u8w := apply(mp.usable_sub[vm := V3, objs := s.objs, a := M, n := 16, k := 8, m := 8, w := true], simp(), simp(), simp(), muw)
            have u8r := apply(mp.usable_sub[vm := V3, objs := s.objs, a := M, n := 16, k := 8, m := 8, w := false], simp(), simp(), simp(), mur)
            have u0w := apply(mp.usable_sub[vm := V3, objs := s.objs, a := M, n := 16, k := 0, m := 8, w := true], simp(), simp(), simp(), muw)
            have ro24: gimple.bytes_at(fn_update(V3, "bytes", x86_64_linux.store_le(V3.bytes, int_add(K, 32), 8, int_sub(A3.avail_cnt, 1))), int_add(K, 24), 8) = gimple.bytes_at(V3, int_add(K, 24), 8)
              by mem(conj(cv, hx))
