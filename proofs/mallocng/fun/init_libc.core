                have r1 := apply(sp.fr_read[b := V10, U := V11, objs := O1, W := startup_specs.ssp_writes(g), a := A8, n := 8, wr := false], fr11, mp(all_elim(uA, {V10}, {O1}), gk10), nS, arith(lbo), simp())
                have r2 := apply(sp.fr_read[b := U9, U := V10, objs := O1, W := startup_specs.tls_writes(g), a := A8, n := 8, wr := false], fr10, mp(all_elim(uA, {U9}, {O1}), tD), nT, arith(lbo), simp())
                have a8b: int_le(int_add(A8, 8), 18446744073709551616) by arith(vL)
                have q1 := apply(g.read_outside[U := U9, M := U8, b := PG, m := 8, a := A8, n := 8], k3, arith(vL, vP), arith(lbo), simp(), a8b)
                have q2: gimple.bytes_at(U8, A8, 8) = gimple.bytes_at(U6, A8, 8) by mem(vL, vP, vF, lbb, pfb, pgb)
                have q3 := apply(g.read_outside[U := U6, M := U5, b := SI, m := 8, a := A8, n := 8], hU6o, arith(vL, vS), arith(lbo), simp(), a8b)
                have q4: gimple.bytes_at(U5, A8, 8) = gimple.bytes_at(UE, A8, 8) by mem(vL, vH, hwb)
                have q5 := apply(g.read_outside[U := UE, M := VM4, b := L1, m := 304, a := A8, n := 8], hUEo, arith(apL, l1o), arith(lbo), simp(), a8b)
                have avl: int_lt(AVQ, 18446744073709551616) by arith(peA, hN, hbd, heb)
                have q6a: gimple.bytes_at(VM4, A8, 8) = int_mod(AVQ, int_pow(256, 8)) by mem(vL, avl, peA, heb, lbb, l1o, l1r, apL, envb, apE)
                have avo: AVQ in omega by arith(peA, heb, hN)
                have avm: int_mod(AVQ, int_pow(256, 8)) = AVQ by arith(avo, avl)
                have q6 := trans(q6a, avm)
                have rv: gimple.bytes_at(V11, bits_add(64, g.libc, 8), 8) = int_add(envp, int_mul(8, int_add(N, 1))) by simp(bl8, r1, r2, q1, q2, q3, q4, q5, q6, peA)
                have aux8: all n. n in omega -> startup_specs.env_at(w.vm, w.objs, envp, n) -> gimple.bytes_at(V11, bits_add(64, g.libc, 8), 8) = int_add(envp, int_mul(8, int_add(n, 1))) proof
                  fix n
                  assume hn he
                  have nN := apply(sp.env_unique[vm := w.vm, o := w.objs, e := envp, n1 := N, n2 := n], hN, hn, henv, he)
                  show := rewrite(nN, rv)
                qed
                have x: ex V fs L. ((V in x86_64_linux.Vm && startup_specs.frame(w.vm, V, w.objs, startup_specs.start_writes(g))) &&
                    (all n. n in omega -> startup_specs.env_at(w.vm, w.objs, envp, n) -> gimple.bytes_at(V, bits_add(64, g.libc, 8), 8) = int_add(envp, int_mul(8, int_add(n, 1)))) &&
                    fs in bits(64) && startup_specs.thread_set(V, fs)) &&
                  o = ok(fn_update(fn_update(fn_update(w, "vm", V), "objs", fn_update(w.objs, "live", L)), "fs_base", fs), empty)
                  by ex_intro({V11}, {fs10}, {LV}, taut(hV11, ft11, aux8, fs10b, ts11, oe))
                show by taut(x)
              qed
              show by taut(hoc2, eB, eO)
            qed
            show by taut(ci2, dA, dB, dC, dD)
          qed
          show by taut(hoc, bE, bO)
        qed
        show by taut(ci, cA, cB, cC, cD)
      qed
      have z: p1 = 0 -> sp.il_out(g, w, envp, o) proof
        assume h0
        step xe from hif3 using conj(h0)
        show := mp(all_elim(J3, {STR}), hstr, rewrite(xe, hK3))
      qed
      have nz: !(p1 = 0) -> sp.il_out(g, w, envp, o) proof
        assume h0
        step xe from hif3 using conj(h0)
        show := mp(all_elim(J3, {p1}), taut(hp1, h0), rewrite(xe, hK3))
      qed
      show by taut(z, nz)
    qed
    have z: pn = 0 -> sp.il_out(g, w, envp, o) proof
      assume h0
      step xe from hif2 with g.ld64_det using conj(h0, w7u, l1b, mA31)
      // (aux[AT_EXECFN] as the copy left it: AT_EXECFN's value, or 0)
      have r1: gimple.bytes_at(U7, int_add(l[1], 248), 8) = gimple.bytes_at(U6, int_add(l[1], 248), 8) by mem(l1o, l1r, lbb, apP)
      have r2 := apply(g.read_outside[U := U6, M := U5, b := SI, m := 8, a := int_add(l[1], 248), n := 8], hU6o, arith(l1o, l1r, apS), arith(l1o), simp(), arith(l1o, l1r))
      have r3: gimple.bytes_at(U5, int_add(l[1], 248), 8) = gimple.bytes_at(UE, int_add(L1, int_mul(8, 31)), 8) by mem(l1o, l1r, hwb, apH)
      have av := rewrite(sym(trans(r1, trans(r2, r3))), mp(all_elim(hUEa, {31}), simp(), simp()))
      have _ _ _ svb := apply(ms.world_parts, hw)
      have A31c: A31 = 0 || (ex L. sp.cstr(w.vm, w.objs, A31, L, startup_specs.start_writes(g))) proof
        let VA := gimple.bytes_at(U7, int_add(l[1], 248), 8)
        have c1: (ex m. (m in omega && int_lt(m, kE)) && fst(AX[m]) = 31 && snd(AX[m]) = VA) -> A31 = 0 || (ex L. sp.cstr(w.vm, w.objs, A31, L, startup_specs.start_writes(g))) proof
          assume h
          obtain m, hm hml hk31 hv from h
          have mo := apply(at_type[l := AX, t := cart(omega, omega), i := m], axt, hm, arith(hml, kl))
          have _ _ kv1 := mp(all_elim(axk, {m}), hm, arith(hml, kl))
          have vo vl := apply(g.bytes_bound, {w.vm}, {int_add(int_add(int_add(envp, int_mul(8, int_add(N, 1))), int_mul(16, m)), 8)}, {8}, svb, simp())
          have ab: A31 = VA := apply(mp.boi[x := VA], arith(hv, kv1, vo), arith(hv, kv1, vl))
          have cz: VA = 0 -> A31 = 0 || (ex L. sp.cstr(w.vm, w.objs, A31, L, startup_specs.start_writes(g))) proof
            assume h0
            show by taut(trans(ab, h0))
          qed
          have cn: !(VA = 0) -> A31 = 0 || (ex L. sp.cstr(w.vm, w.objs, A31, L, startup_specs.start_writes(g))) proof
            assume hn
            have cs := mp(all_elim(hex, {m}), hm, arith(hml, kl), hk31, rewrite(sym(hv), hn))
            show by taut(rewrite(trans(hv, sym(ab)), cs))
          qed
          show by taut(cz, cn)
        qed
        have c2: !(ex m. (m in omega && int_lt(m, kE)) && fst(AX[m]) = 31) && VA = 0 -> A31 = 0 || (ex L. sp.cstr(w.vm, w.objs, A31, L, startup_specs.start_writes(g))) proof
          assume h
          have _ h0 := h
          have a0: A31 = 0 by simp(h0)
          show by taut(a0)
        qed
        show by taut(expand(av, sp.aux_val), c1, c2)
      qed
      show := mp(all_elim(J2, {A31}), A31c, rewrite(xe, hK2))
    qed
    have nz: !(pn = 0) -> sp.il_out(g, w, envp, o) proof
      assume h0
      step xe from hif2 using conj(h0)
      show := mp(all_elim(J2, {pn}), taut(mp(hpn, h0)), rewrite(xe, hK2))
    qed
    show by taut(z, nz)
  qed
  have w5v _ _ _ := apply(ms.world_parts, w5W)
  have u5V: U5 in x86_64_linux.Vm by simp(w5v)
  have b5: fn_update(U5, "bytes", VM4.bytes) = VM4 := trans(fn_update_twice[f := UE, k := "bytes", a := x86_64_linux.store_le(UE.bytes, int_add(HW, 0), 8, bits_of_int(64, gimple.bytes_at(UE, int_add(l[1], 128), 8))), b := VM4.bytes], hUEb)
  have p5: P6(U5) proof
    have o5: all x. x in bits(64) -> !(int_le(SI, x) && int_lt(x, int_add(SI, 8))) -> U5.bytes[x] = U5.bytes[x] proof
      fix x
      assume _ _
      show := refl({U5.bytes[x]})
    qed
    show by taut(u5V, b5, o5)
  qed
  let C32 := bits_of_int(64, gimple.bytes_at(U5, int_add(l[1], 256), 8))
  have cz: C32 = 0 -> sp.il_out(g, w, envp, o) proof
    assume h0
    step xe from hif using conj(h0)
    show := mp(all_elim(J, {U5}), p5, rewrite(xe, hK))
  qed
  have cn: !(C32 = 0) -> sp.il_out(g, w, envp, o) proof
    assume h0
    have sib: SI in bits(64) by defs(simp(), c_src_env___libc_start_main.__sysinfo)
    have msi := apply(ms.md_st0, {W1}, {UE}, {int_add(HW, 0)}, {8}, {bits_of_int(64, gimple.bytes_at(UE, int_add(l[1], 128), 8))}, {SI}, {0}, {8}, {true},
      mp(all_elim(mdE, {SI}, {0}, {8}, {true}), hsi))
    have w5f w5d := (is_fun(W5) && "vm" in dom(W5) by simp(w5W))
    step xe from hif with g.ld64_det, g.st64_det using conj(h0, w5u, l1b, mA32, sib, msi, u5V, w5f, w5d)
    let U6 := fn_update(U5, "bytes", x86_64_linux.store_le(U5.bytes, int_add(SI, 0), 8, C32))
    have u6e: U6 = fn_update(UE, "bytes", x86_64_linux.store_le(x86_64_linux.store_le(UE.bytes, int_add(HW, 0), 8, bits_of_int(64, gimple.bytes_at(UE, int_add(l[1], 128), 8))), int_add(SI, 0), 8, C32)) by simp()
    have xe6: x12 = ok(ST(U6), empty) := rewrite(sym(u6e), xe)
    have su := apply(g.store_univ, {U5}, {int_add(SI, 0)}, {8}, {C32}, u5V)
    have vu6: U6 in univ(1) by simp(apply(x86.vm_univ, u5V), apply(x86.vm_univ, hUE), su)
    have v6V := apply(x86.store_vm, {U5}, {int_add(SI, 0)}, {8}, {C32}, u5V, vu6)
    have b6: fn_update(U6, "bytes", VM4.bytes) = VM4 := trans(fn_update_twice[f := U5, k := "bytes", a := x86_64_linux.store_le(U5.bytes, int_add(SI, 0), 8, C32), b := VM4.bytes], b5)
    have o6: all x. x in bits(64) -> !(int_le(SI, x) && int_lt(x, int_add(SI, 8))) -> U6.bytes[x] = U5.bytes[x] proof
      fix x
      assume hx hno
      have ne: all i. i in omega -> int_lt(i, 8) -> !(bits_add(64, int_add(SI, 0), bits_of_int(64, i)) = x) proof
        fix i
        assume hi hil
        have ea := apply(ms.add_i, {int_add(SI, 0)}, {i}, arith(sib), hi, arith(sib, hi, hil))
        show by arith(ea, hno, hi, hil, sib)
      qed
      have so := apply(x86.store_outside, {U5.bytes}, {int_add(SI, 0)}, {8}, {C32}, {x}, hx, ne)
      show by simp(so)
    qed
    have p6: P6(U6) by taut(v6V, b6, o6)
    show := mp(all_elim(J, {U6}), p6, rewrite(xe6, hK))
  qed
  show by taut(cz, cn)
qed

// ----------------------------------------------------------------------
//  The probe's hypotheses from init_libc_pre

// (a byte of a global __init_libc writes: among startup's writes)
theorem sp.sw_rng: all g x. x in omega -> x in startup_specs.span(g.environ, 8) || x in startup_specs.span(g.hwcap, 8) || x in startup_specs.span(g.sysinfo, 8) ||
  x in startup_specs.span(g.libc, 56) || x in startup_specs.span(g.progname, 8) || x in startup_specs.span(g.progname_full, 8) -> x in startup_specs.start_writes(g)
proof
  fix g x
  assume hx h
  show by defs(sel(taut(hx, h)), startup_specs.start_writes)
qed

theorem sp.in_span: all a n x. x in omega -> int_le(a, x) -> int_lt(x, int_add(a, n)) -> x in startup_specs.span(a, n)
proof
  fix a n x
  assume hx h1 h2
  show by defs(sel(taut(hx, h1, h2)), startup_specs.span)
qed

// (n bytes at c = a + off among startup's writes: defined for reads and
// writes, by globals_ok)
theorem sp.md_glob: all g w a off c n. startup_specs.globals_ok(w.vm, w.objs, g) -> c in omega -> c = int_add(a, off) -> !(a = 0) -> int_lt(c, pow2(64)) ->
  (all x. x in omega -> int_le(c, x) -> int_lt(x, int_add(c, n)) -> x in startup_specs.start_writes(g)) ->
  g.mem_defined(w, a, off, n, true) && g.mem_defined(w, a, off, n, false)
proof
  fix g w a off c n
  assume hg hc he hz hl hs
  have hall _ _ _ := expand(hg, startup_specs.globals_ok)
  have ut: all i. i in omega -> int_lt(i, n) -> gimple.usable(w.vm, w.objs, int_add(c, i), 1, true) proof
    fix i
    assume hi hil
    have u1 _ _ _ _ _ := mp(all_elim(hall, {int_add(c, i)}), arith(hc, hi), mp(all_elim(hs, {int_add(c, i)}), arith(hc, hi), arith(hc, hi), arith(hil)))
    show := u1
  qed
  have uf: all i. i in omega -> int_lt(i, n) -> gimple.usable(w.vm, w.objs, int_add(c, i), 1, false) proof
    fix i
    assume hi hil
    have _ u2 _ _ _ _ := mp(all_elim(hall, {int_add(c, i)}), arith(hc, hi), mp(all_elim(hs, {int_add(c, i)}), arith(hc, hi), arith(hc, hi), arith(hil)))
    show := u2
  qed
  have Ut := apply(sp.usable_of_bytes[vm := w.vm, o := w.objs, a := c, n := n, wr := true], hc, ut)
  have Uf := apply(sp.usable_of_bytes[vm := w.vm, o := w.objs, a := c, n := n, wr := false], hc, uf)
  show by taut(hz, rewrite(he, hl), rewrite(he, Ut), rewrite(he, Uf))
qed

// (a range none of whose bytes are in W, a range all of whose are: apart)
theorem sp.apart(W, a, c, b, m): (all x. x in omega -> int_le(a, x) && int_lt(x, c) -> !(x in W)) ->
  (all x. x in omega -> int_le(b, x) -> int_lt(x, int_add(b, m)) -> x in W) -> a in omega -> b in omega -> int_lt(a, c) -> int_lt(0, m) ->
  int_le(c, b) || int_le(int_add(b, m), a)
proof
  assume hA hB ha hb hac hm
  have c1: int_le(a, b) && int_lt(b, c) -> false proof
    assume h
    show by taut(mp(all_elim(hA, {b}), hb, h), mp(all_elim(hB, {b}), hb, (int_le(b, b) by arith(hb)), (int_lt(b, int_add(b, m)) by arith(hb, hm))))
  qed
  have c2: int_lt(b, a) && int_lt(a, int_add(b, m)) -> false proof
    assume h
    have h1 h2 := h
    show by taut(mp(all_elim(hA, {a}), ha, taut((int_le(a, a) by arith(ha)), hac)), mp(all_elim(hB, {a}), ha, (int_le(b, a) by arith(h1)), h2))
  qed
  show by arith(c1, c2, ha, hb, hac)
qed

// (the spec's C string: the probe's, its length a witness)
theorem sp.cstr_of(vm, o, p, W): p in omega -> startup_specs.cstr(vm, o, p, W) -> ex L. sp.cstr(vm, o, p, L, W)
proof
  assume hp hc
  have ec := expand(hc, startup_specs.cstr)
  obtain L, hL nz bd us nzs zr ap from ec
  have nzs2: all i. i in omega -> int_lt(i, L) -> !(gimple.bytes_at(vm, int_add(p, i), 1) = 0) proof
    fix i
    assume hi hil
    have e := mp(mp.boi[x := int_add(p, i)], arith(hp, hi), arith(bd, hi, hil, hp, hL))
    show := rewrite(e, mp(all_elim(nzs, {i}), hi, hil))
  qed
  have e0 := mp(mp.boi[x := int_add(p, L)], arith(hp, hL), arith(bd, hp, hL))
  have zr2 := rewrite(e0, zr)
  show by ex_intro({L}, defs(taut(hp, hL, nz, us, nzs2, zr2, ap, bd), sp.cstr))
qed

// __init_libc's run from the spec's precondition: its outcomes sp.il_out
theorem sp.il_run: all g envp pn G1 G2 G3 G4 G5 w o. w in abi.World -> runs(c_src_env___libc_start_main.__init_libc(envp, pn, G1, G2, G3, G4, G5), w, o) ->
  envp in bits(64) -> pn in bits(64) ->
  g.environ = c_src_env___libc_start_main.__environ -> g.hwcap = c_src_env___libc_start_main.__hwcap -> g.sysinfo = c_src_env___libc_start_main.__sysinfo ->
  g.libc = c_src_env___libc_start_main.__libc -> g.progname = c_src_env___libc_start_main.__progname -> g.progname_full = c_src_env___libc_start_main.__progname_full ->
  g.empty_str = c_src_env___libc_start_main.str_ -> g.main_tls = c_src_env___init_tls.main_tls -> g.builtin_tls = c_src_env___init_tls.builtin_tls ->
  g.stack_chk_guard = c_src_env___stack_chk_fail.__stack_chk_guard -> g.default_stacksize = c_src_env___init_tls.__default_stacksize ->
  mp.calls(G1, startup_specs.init_tls_spec_fun(g)) -> mp.calls(G2, startup_specs.init_ssp_spec_fun(g)) ->
  startup_specs.init_libc_pre(w.vm, w.objs, g, envp, pn) -> sp.il_out(g, w, envp, o)
proof
  fix g envp pn G1 G2 G3 G4 G5 w o
  assume hw hr heb hpb hgE hgH hgS hgL hgP hgF hgZ hgM hgB hgG hgD hG1 hG2 hpre
  let SW := startup_specs.start_writes(g)
  let ENV := c_src_env___libc_start_main.__environ
  let HW := c_src_env___libc_start_main.__hwcap
  let SI := c_src_env___libc_start_main.__sysinfo
  let LB := c_src_env___libc_start_main.__libc
  let PG := c_src_env___libc_start_main.__progname
  let PF := c_src_env___libc_start_main.__progname_full
  let STR := c_src_env___libc_start_main.str_
  have pre := expand(hpre, startup_specs.init_libc_pre)
  obtain N AX, hN axt henv hal hsa hglob htf hpn0 hex0 hstr0 hph0 hrnd0 huid0 hsec0 from pre
  have e0 e1 e2 e3 e4 := expand(henv, startup_specs.env_at)
  have a1 a2 a3 a4 a5 a6 := expand(hal, startup_specs.auxv_list)
  have axo: seq_len(AX) in omega by arith(axt)
  // envp's words
  have hnz: all i. i in omega -> int_lt(i, N) -> !(gimple.bytes_at(w.vm, int_add(envp, int_mul(8, i)), 8) = 0) proof
    fix i
    assume hi hil
    have e := mp(mp.boi[x := int_add(envp, int_mul(8, i))], arith(heb, hi), arith(e1, hi, hil, hN, heb))
    show := rewrite(e, mp(all_elim(e3, {i}), hi, hil))
  qed
  have ez := mp(mp.boi[x := int_add(envp, int_mul(8, N))], arith(heb, hN), arith(e1, hN, heb))
  have hz0 := rewrite(ez, e4)
  // the vector's pairs
  let A := int_add(envp, int_mul(8, int_add(N, 1)))
  have ax1: int_le(1, seq_len(AX)) proof
    have c := expand(a1, ord_le)
    have c1: 1 in seq_len(AX) -> int_le(1, seq_len(AX)) proof
      assume h
      show by arith(mp(nat_mem_lt[k := seq_len(AX), i := 1], axo, h))
    qed
    have c2: 1 = seq_len(AX) -> int_le(1, seq_len(AX)) proof
      assume h
      show by arith(h)
    qed
    show by taut(c, c1, c2)
  qed
  have axk: all k. k in omega -> int_lt(k, seq_len(AX)) -> gimple.usable(w.vm, w.objs, int_add(A, int_mul(16, k)), 16, false) &&
      gimple.bytes_at(w.vm, int_add(A, int_mul(16, k)), 8) = fst(AX[k]) && gimple.bytes_at(w.vm, int_add(int_add(A, int_mul(16, k)), 8), 8) = snd(AX[k]) proof
    fix k
    assume hk hkl
    have u b1 b2 := mp(all_elim(a3, {k}), hk, hkl)
    have q1 := mp(mp.boi[x := int_add(A, int_mul(16, k))], arith(heb, hN, hk), arith(a2, hk, hkl, hN, heb))
    have q2 := mp(mp.boi[x := int_add(int_add(A, int_mul(16, k)), 8)], arith(heb, hN, hk), arith(a2, hk, hkl, hN, heb))
    show by taut(u, rewrite(q1, b1), rewrite(q2, b2))
  qed
  have enull: x86_64_linux.AT_NULL = 0 by defs(refl({0}), x86_64_linux.AT_NULL)
  have axe := rewrite(enull, a4)
  have axn := rewrite(enull, a5)
  have huniq: all a b. a in omega -> b in omega -> int_lt(a, seq_len(AX)) -> int_lt(b, seq_len(AX)) -> fst(AX[a]) = fst(AX[b]) -> a = b proof
    fix a b
    assume ha hb hla hlb he
    show := mp(all_elim(a6, {a}, {b}), taut(ha, hb), taut(hla, hlb, he))
  qed
  // the globals' bytes: among startup's writes
  have envb: ENV in bits(64) by defs(simp(), c_src_env___libc_start_main.__environ)
  have hwb: HW in bits(64) by defs(simp(), c_src_env___libc_start_main.__hwcap)
  have sib: SI in bits(64) by defs(simp(), c_src_env___libc_start_main.__sysinfo)
  have lbb: LB in bits(64) by defs(simp(), c_src_env___libc_start_main.__libc)
  have pgb: PG in bits(64) by defs(simp(), c_src_env___libc_start_main.__progname)
  have pfb: PF in bits(64) by defs(simp(), c_src_env___libc_start_main.__progname_full)
  have RE: all x. x in omega -> int_le(ENV, x) -> int_lt(x, int_add(ENV, 8)) -> x in SW proof
    fix x
    assume xo h1 h2
    show := apply(sp.sw_rng, {g}, {x}, xo, taut(apply(sp.in_span, {g.environ}, {8}, {x}, xo, arith(hgE, h1), arith(hgE, h2))))
  qed
  have RH: all x. x in omega -> int_le(HW, x) -> int_lt(x, int_add(HW, 8)) -> x in SW proof
    fix x
    assume xo h1 h2
    show := apply(sp.sw_rng, {g}, {x}, xo, taut(apply(sp.in_span, {g.hwcap}, {8}, {x}, xo, arith(hgH, h1), arith(hgH, h2))))
  qed
  have RS: all x. x in omega -> int_le(SI, x) -> int_lt(x, int_add(SI, 8)) -> x in SW proof
    fix x
    assume xo h1 h2
    show := apply(sp.sw_rng, {g}, {x}, xo, taut(apply(sp.in_span, {g.sysinfo}, {8}, {x}, xo, arith(hgS, h1), arith(hgS, h2))))
  qed
  have RL8: all x. x in omega -> int_le(int_add(LB, 8), x) -> int_lt(x, int_add(int_add(LB, 8), 8)) -> x in SW proof
    fix x
    assume xo h1 h2
    show := apply(sp.sw_rng, {g}, {x}, xo, taut(apply(sp.in_span, {g.libc}, {56}, {x}, xo, arith(hgL, h1), arith(hgL, h2))))
  qed
  have RL48: all x. x in omega -> int_le(int_add(LB, 48), x) -> int_lt(x, int_add(int_add(LB, 48), 8)) -> x in SW proof
    fix x
    assume xo h1 h2
    show := apply(sp.sw_rng, {g}, {x}, xo, taut(apply(sp.in_span, {g.libc}, {56}, {x}, xo, arith(hgL, h1), arith(hgL, h2))))
  qed
  have RP: all x. x in omega -> int_le(PG, x) -> int_lt(x, int_add(PG, 8)) -> x in SW proof
    fix x
    assume xo h1 h2
    show := apply(sp.sw_rng, {g}, {x}, xo, taut(apply(sp.in_span, {g.progname}, {8}, {x}, xo, arith(hgP, h1), arith(hgP, h2))))
  qed
  have RF: all x. x in omega -> int_le(PF, x) -> int_lt(x, int_add(PF, 8)) -> x in SW proof
    fix x
    assume xo h1 h2
    show := apply(sp.sw_rng, {g}, {x}, xo, taut(apply(sp.in_span, {g.progname_full}, {8}, {x}, xo, arith(hgF, h1), arith(hgF, h2))))
  qed
  have mE := apply(sp.md_glob, {g}, {w}, {ENV}, {0}, {ENV}, {8}, hglob, arith(envb), arith(envb), defs(simp(), c_src_env___libc_start_main.__environ),
    defs(arith(envb), pow2), RE)
  have mH := apply(sp.md_glob, {g}, {w}, {HW}, {0}, {HW}, {8}, hglob, arith(hwb), arith(hwb), defs(simp(), c_src_env___libc_start_main.__hwcap),
    defs(arith(hwb), pow2), RH)
  have mS := apply(sp.md_glob, {g}, {w}, {SI}, {0}, {SI}, {8}, hglob, arith(sib), arith(sib), defs(simp(), c_src_env___libc_start_main.__sysinfo),
    defs(arith(sib), pow2), RS)
  have mL8 := apply(sp.md_glob, {g}, {w}, {LB}, {8}, {int_add(LB, 8)}, {8}, hglob, arith(lbb), arith(lbb), defs(simp(), c_src_env___libc_start_main.__libc),
    defs(simp(), c_src_env___libc_start_main.__libc, pow2), RL8)
  have mL48 := apply(sp.md_glob, {g}, {w}, {LB}, {48}, {int_add(LB, 48)}, {8}, hglob, arith(lbb), arith(lbb), defs(simp(), c_src_env___libc_start_main.__libc),
    defs(simp(), c_src_env___libc_start_main.__libc, pow2), RL48)
  have mP := apply(sp.md_glob, {g}, {w}, {PG}, {0}, {PG}, {8}, hglob, arith(pgb), arith(pgb), defs(simp(), c_src_env___libc_start_main.__progname),
    defs(arith(pgb), pow2), RP)
  have mF := apply(sp.md_glob, {g}, {w}, {PF}, {0}, {PF}, {8}, hglob, arith(pfb), arith(pfb), defs(simp(), c_src_env___libc_start_main.__progname_full),
    defs(arith(pfb), pow2), RF)
  // the initial stack's data apart from __environ and libc.auxv
  let END := int_add(A, int_mul(16, seq_len(AX)))
  have hac: int_lt(envp, END) by arith(heb, hN, axo)
  have apE := apply(sp.apart[W := SW, a := envp, c := END, b := ENV, m := 8], hsa, RE, arith(heb), arith(envb), hac, arith())
  have apL := apply(sp.apart[W := SW, a := envp, c := END, b := int_add(LB, 8), m := 8], hsa, RL8, arith(heb), arith(lbb), hac, arith())
  have hea: int_le(A, ENV) || int_le(int_add(ENV, 8), envp) by arith(apE, hN, axo, heb)
  have axe1: int_le(END, ENV) || int_le(int_add(ENV, 8), A) by arith(apE, hN, axo, heb)
  have axe2: int_le(END, int_add(LB, 8)) || int_le(int_add(LB, 16), A) by arith(apL, hN, axo, heb)
  // the C strings
  have hpn: !(pn = 0) -> (ex L. sp.cstr(w.vm, w.objs, pn, L, SW)) proof
    assume h
    show := apply(sp.cstr_of[vm := w.vm, o := w.objs, p := pn, W := SW], arith(hpb), mp(hpn0, h))
  qed
  have e31: x86_64_linux.AT_EXECFN = 31 by defs(refl({31}), x86_64_linux.AT_EXECFN)
  have hex: all m. m in omega -> int_lt(m, seq_len(AX)) -> fst(AX[m]) = 31 -> !(snd(AX[m]) = 0) -> (ex L. sp.cstr(w.vm, w.objs, snd(AX[m]), L, SW)) proof
    fix m
    assume hm hml hk hv
    have pt := apply(at_type[l := AX, t := cart(omega, omega), i := m], axt, hm, hml)
    have ce := mp(cart_elim[a := omega, b := omega, z := AX[m]], pt)
    obtain v1 v2, _ hv2 hz from ce
    have vo: snd(AX[m]) in omega by simp(hz, hv2)
    have ew: ex k. k in omega && ((int_lt(k, seq_len(AX)) && fst(AX[k]) = x86_64_linux.AT_EXECFN) && snd(AX[k]) = snd(AX[m])) by ex_intro({m}, taut(hm, hml, rewrite(sym(e31), hk), refl({snd(AX[m])})))
    have ai: startup_specs.aux_is(AX, x86_64_linux.AT_EXECFN, snd(AX[m])) by defs(taut(ew), startup_specs.aux_is)
    show := apply(sp.cstr_of[vm := w.vm, o := w.objs, p := snd(AX[m]), W := SW], vo, mp(all_elim(hex0, {snd(AX[m])}), vo, ai, hv))
  qed
  have hstr := apply(sp.cstr_of[vm := w.vm, o := w.objs, p := STR, W := SW], defs(simp(), c_src_env___libc_start_main.str_), rewrite(hgZ, hstr0))
  // the vector's entries as the probe names them
  have e3: x86_64_linux.AT_PHDR = 3 by defs(refl({3}), x86_64_linux.AT_PHDR)
  have e4: x86_64_linux.AT_PHENT = 4 by defs(refl({4}), x86_64_linux.AT_PHENT)
  have e5: x86_64_linux.AT_PHNUM = 5 by defs(refl({5}), x86_64_linux.AT_PHNUM)
  obtain ph pe phn, p1 p2 p3 q1 q2 q3 q4 from hph0
  have hph: ex x y z. ((x in omega && y in omega) && z in omega) && ((startup_specs.aux_is(AX, 3, x) && startup_specs.aux_is(AX, 4, y)) && startup_specs.aux_is(AX, 5, z)) &&
      startup_specs.phdrs_ok(w.vm, w.objs, x, y, z, SW) by ex_intro({ph}, {pe}, {phn}, taut(p1, p2, p3, rewrite(e3, q1), rewrite(e4, q2), rewrite(e5, q3), q4))
  have e25: x86_64_linux.AT_RANDOM = 25 by defs(refl({25}), x86_64_linux.AT_RANDOM)
  have hrnd := rewrite(e25, hrnd0)
  have e11: x86_64_linux.AT_UID = 11 by defs(refl({11}), x86_64_linux.AT_UID)
  have e12: x86_64_linux.AT_EUID = 12 by defs(refl({12}), x86_64_linux.AT_EUID)
  have e13: x86_64_linux.AT_GID = 13 by defs(refl({13}), x86_64_linux.AT_GID)
  have e14: x86_64_linux.AT_EGID = 14 by defs(refl({14}), x86_64_linux.AT_EGID)
  obtain u gr, uo go c1 c2 c3 c4 from huid0
  have huid: ex x y. (x in omega && y in omega) && ((startup_specs.aux_is(AX, 11, x) && startup_specs.aux_is(AX, 12, x)) && startup_specs.aux_is(AX, 13, y)) &&
      startup_specs.aux_is(AX, 14, y) by ex_intro({u}, {gr}, taut(uo, go, rewrite(e11, c1), rewrite(e12, c2), rewrite(e13, c3), rewrite(e14, c4)))
  have e23: x86_64_linux.AT_SECURE = 23 by defs(refl({23}), x86_64_linux.AT_SECURE)
  have hsec := rewrite(e23, hsec0)
  have r1 := mp(all_elim(sp.il_probe, {g}, {envp}, {pn}, {G1}, {G2}, {G3}, {G4}, {G5}, {w}, {o}), hw, hr, heb, taut(mE), taut(mL8),
    hgE, hgH, hgS, hgL, hgP, hgF, hgZ, hgM, hgB, hgG, hgD, hG1, hG2)
  have r2 := mp(all_elim(r1, {N}), hN, e0, e1, e2, hnz, hz0, hea, taut(mH), taut(mS), taut(mL48), taut(mP), taut(mF), taut(mF))
  show := mp(all_elim(r2, {AX}), axt, ax1, axk, axe, axn, a2, axe1, axe2, hpn, hex, hstr, hglob, htf, hph, hrnd, huid, hsec, huniq, henv)
qed

// ----------------------------------------------------------------------
//  The spec's runs

// (an overflow with the thread pointer f: overflow_start's)
theorem sp.ovs_intro: all s f v ob. s in univ(1) -> f in bits(64) -> v in x86_64_linux.Vm -> ob in abi.Objs ->
  pair(s, exc(fn_update(fn_update(fn_update(s, "fs_base", f), "vm", v), "objs", ob), exc_val("stack_overflow", empty))) in univ(1) ->
  runs(startup_specs.overflow_start, s, exc(fn_update(fn_update(fn_update(s, "fs_base", f), "vm", v), "objs", ob), exc_val("stack_overflow", empty)))
proof
  fix s f v ob
  assume hu hf hv hob pu
  let S1 := fn_update(s, "fs_base", f)
  let O := exc(fn_update(fn_update(S1, "vm", v), "objs", ob), exc_val("stack_overflow", empty))
  have fu: f in univ(1) by simp(hf)
  have pu1: pair(S1, O) in univ(1) by simp(pu, hu, fu)
  have r1 := apply(ct.overflow_intro, hv, hob, pu1)
  have bo: bind_rel(abi.overflow, S1, x4 x5. O = ok(x4, empty), x4 x5. O = exc(x4, x5), x4. O = diverge(x4)) by defs(ex_intro({O}, simp(r1, pu1)), bind_rel)
  have b: any_rel(x2. x2 in bits(64), x2. letin(fn_update(s, "fs_base", x2), x3. bind_rel(abi.overflow, x3, x4 x5. O = ok(x4, empty), x4 x5. O = exc(x4, x5), x4. O = diverge(x4))))
    by defs(taut((ex x2. x2 in bits(64) && bind_rel(abi.overflow, fn_update(s, "fs_base", x2), x4 x5. O = ok(x4, empty), x4 x5. O = exc(x4, x5), x4. O = diverge(x4)) by ex_intro({f}, taut(hf, bo)))), any_rel, letin)
  show by defs(apply(tr.runs_intro[r := x0 x1. any_rel(x2. x2 in bits(64), x2. letin(fn_update(x0, "fs_base", x2), x3. bind_rel(abi.overflow, x3, x4 x5. x1 = ok(x4, empty),
    x4 x5. x1 = exc(x4, x5), x4. x1 = diverge(x4))))], {s}, {O}, pu, b), startup_specs.overflow_start)
qed

// (abi's overflow: one with the thread pointer as it was)
theorem sp.ovf_out_any(s, o): s in abi.World -> abi.ovf_out(s, o) -> sp.ovf_any(s, o)
proof
  assume hw h
  obtain v ob, hv hob ho from h
  have _ pf _ _ := apply(ms.world_parts, hw)
  have fd: "fs_base" in dom(s) by simp(expand(hw, abi.World))
  have fb: s.fs_base in bits(64) by simp(expand(hw, abi.World))
  have e := mp(fn_update_same[f := s, k := "fs_base"], pf, fd)
  have ho2 := subst({y. o = exc(fn_update(fn_update(y, "vm", v), "objs", ob), exc_val("stack_overflow", empty))}, sym(e), ho)
  show by defs(ex_intro({s.fs_base}, {v}, {ob}, taut(fb, hv, hob, ho2)), sp.ovf_any)
qed

// (its requirement not met: anything; else an overflow, or the memory
// within the frame, libc.auxv set, the thread set up)
theorem sp.ils_run(g, envp, pn, s, o): s in abi.World -> pair(s, o) in univ(1) ->
  (!startup_specs.init_libc_pre(s.vm, s.objs, g, envp, pn) || sp.ovf_any(s, o) ||
   (ex V fs. ((V in x86_64_linux.Vm && startup_specs.frame(s.vm, V, s.objs, startup_specs.start_writes(g))) &&
      (all n. n in omega -> startup_specs.env_at(s.vm, s.objs, envp, n) -> gimple.bytes_at(V, bits_add(64, g.libc, 8), 8) = int_add(envp, int_mul(8, int_add(n, 1)))) &&
      fs in bits(64) && startup_specs.thread_set(V, fs)) && o = ok(fn_update(fn_update(s, "vm", V), "fs_base", fs), empty))) ->
  runs(startup_specs.init_libc_spec(g, envp, pn), s, o)
proof
  assume hw pu h
  let OVF := exc_val("stack_overflow", empty)
  let SW := startup_specs.start_writes(g)
  let PRE(x0) := startup_specs.init_libc_pre(app(x0, "vm"), app(x0, "objs"), g, envp, pn)
  let BR1(x0, x2) := bind_rel(startup_specs.overflow_start, x0, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)), x3. x2 = diverge(x3))
  let BR2(x0, x2) := letin(app(x0, "vm"), x3. any_rel(x4. x4 in x86_64_linux.Vm && ((startup_specs.frame(x3, app(fn_update(x0, "vm", x4), "vm"), app(fn_update(x0, "vm", x4), "objs"), SW) &&
    (all x5. x5 in omega -> startup_specs.env_at(x3, app(fn_update(x0, "vm", x4), "objs"), envp, x5) -> gimple.bytes_at(app(fn_update(x0, "vm", x4), "vm"), bits_add(64, g.libc, 8), 8) =
      int_add(envp, int_mul(8, int_add(x5, 1))))) && (ex x5. x5 in bits(64) && startup_specs.thread_set(app(fn_update(x0, "vm", x4), "vm"), x5))),
    x4. letin(fn_update(x0, "vm", x4), x5. any_rel(x6. x6 in bits(64) && startup_specs.thread_set(app(x5, "vm"), x6), x6. letin(fn_update(x5, "fs_base", x6), x7. x2 = ok(pair(x7, empty), empty))))))
  let DS(x2, x1) := (fst(x2) = 0 && x1 = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && x1 = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
    ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && x1 = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && x1 = diverge(snd(x2))))
  let SB(x0, x1) := !PRE(x0) || (ex x2. (BR1(x0, x2) || BR2(x0, x2)) && DS(x2, x1))
  have hu: s in univ(1) by simp(pu)
  have g0: SB(s, o) proof
    have c1: !PRE(s) -> SB(s, o) proof
      assume hn
      show by taut(hn)
    qed
    have c2: sp.ovf_any(s, o) -> SB(s, o) proof
      assume e
      obtain f v ob, hf hv hob ho from expand(e, sp.ovf_any)
      let WO := fn_update(fn_update(fn_update(s, "fs_base", f), "vm", v), "objs", ob)
      let X2 := exc(pair(WO, empty), pair("raise", OVF))
      have pu1 := rewrite(ho, pu)
      have r1 := apply(sp.ovs_intro, {s}, {f}, {v}, {ob}, hu, hf, hv, hob, pu1)
      have cx: ex x3 x4. exc(WO, OVF) = exc(x3, x4) && X2 = exc(pair(x3, empty), pair("raise", x4)) by ex_intro({WO}, {OVF}, taut(refl({exc(WO, OVF)}), refl({X2})))
      have b1: BR1(s, X2) by defs(ex_intro({exc(WO, OVF)}, taut(r1, cx)), bind_rel)
      have d1: DS(X2, o) by simp(ho)
      show by taut((ex x2. (BR1(s, x2) || BR2(s, x2)) && DS(x2, o) by ex_intro({X2}, taut(b1, d1))))
    qed
    have c3: (ex V fs. ((V in x86_64_linux.Vm && startup_specs.frame(s.vm, V, s.objs, SW)) &&
        (all n. n in omega -> startup_specs.env_at(s.vm, s.objs, envp, n) -> gimple.bytes_at(V, bits_add(64, g.libc, 8), 8) = int_add(envp, int_mul(8, int_add(n, 1)))) &&
        fs in bits(64) && startup_specs.thread_set(V, fs)) && o = ok(fn_update(fn_update(s, "vm", V), "fs_base", fs), empty)) -> SB(s, o) proof
      assume e
      obtain V fs, hV hfr hl8 hfs hts ho from e
      let WV := fn_update(s, "vm", V)
      let X2 := ok(pair(fn_update(WV, "fs_base", fs), empty), empty)
      have ar: any_rel(x6. x6 in bits(64) && startup_specs.thread_set(V, x6), x6. X2 = ok(pair(fn_update(WV, "fs_base", x6), empty), empty))
        by defs(taut((ex x6. (x6 in bits(64) && startup_specs.thread_set(V, x6)) && X2 = ok(pair(fn_update(WV, "fs_base", x6), empty), empty) by ex_intro({fs}, taut(hfs, hts, refl({X2}))))), any_rel)
      have et: ex x5. x5 in bits(64) && startup_specs.thread_set(V, x5) by ex_intro({fs}, taut(hfs, hts))
      have ev: ex x4. (x4 in x86_64_linux.Vm && ((startup_specs.frame(s.vm, app(fn_update(s, "vm", x4), "vm"), app(fn_update(s, "vm", x4), "objs"), SW) &&
          (all x5. x5 in omega -> startup_specs.env_at(s.vm, app(fn_update(s, "vm", x4), "objs"), envp, x5) -> gimple.bytes_at(app(fn_update(s, "vm", x4), "vm"), bits_add(64, g.libc, 8), 8) =
            int_add(envp, int_mul(8, int_add(x5, 1))))) && (ex x5. x5 in bits(64) && startup_specs.thread_set(app(fn_update(s, "vm", x4), "vm"), x5)))) &&
          letin(fn_update(s, "vm", x4), x5. any_rel(x6. x6 in bits(64) && startup_specs.thread_set(app(x5, "vm"), x6), x6. letin(fn_update(x5, "fs_base", x6), x7. X2 = ok(pair(x7, empty), empty))))
        by ex_intro({V}, defs(simp(hV, hfr, hl8, et, ar, keep(startup_specs.frame, startup_specs.env_at, startup_specs.thread_set, any_rel)), letin))
      have b2: BR2(s, X2) by defs(taut(expand(ev, any_rel, letin)), any_rel, letin)
      have d2: DS(X2, o) by simp(ho)
      show by taut((ex x2. (BR1(s, x2) || BR2(s, x2)) && DS(x2, o) by ex_intro({X2}, taut(b2, d2))))
    qed
    show by taut(h, c1, c2, c3)
  qed
  show by defs(apply(tr.runs_intro[r := x0 x1. SB(x0, x1)], {s}, {o}, pu, g0), startup_specs.init_libc_spec)
qed

// (the spec's C function value: its procedure's outcome o3, any result
// registers then)
theorem sp.ilf_intro(g, regs, s, o, o3): regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) -> pair(s, o) in univ(1) ->
  runs(startup_specs.init_libc_spec(g, bits_of_int(64, regs[0]), bits_of_int(64, regs[1])), s, o3) ->
  ((ex w r. o3 = ok(w, r) && any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o = ok(w, pair(x5, x6))))) ||
   (ex w e. o3 = exc(w, e) && o = exc(w, e)) || (ex t. o3 = diverge(t) && o = diverge(t))) ->
  runs(startup_specs.init_libc_spec_fun(g)[regs], s, o)
proof
  assume ra pu hs hd
  let SP := startup_specs.init_libc_spec(g, bits_of_int(64, regs[0]), bits_of_int(64, regs[1]))
  have bb: bind_rel(SP, s, x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o = ok(x3, pair(x5, x6)))), x3 x4. o = exc(x3, x4), x3. o = diverge(x3))
    by defs(ex_intro({o3}, taut(hs, hd)), bind_rel)
  rsimp only, startup_specs.init_libc_spec_fun, app_fn_build, ra
  show := apply(tr.runs_intro[r := x1 x2. !ord_le(2, seq_len(regs)) || bind_rel(SP, x1, x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. x2 = ok(x3, pair(x5, x6)))),
    x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))], {s}, {o}, pu, taut(bb))
qed

// ----------------------------------------------------------------------
//  __init_libc's C function by its purpose

theorem sp.il_fun: all g G1 G2 G3 G4 G5 regs s o.
  g.environ = c_src_env___libc_start_main.__environ -> g.hwcap = c_src_env___libc_start_main.__hwcap -> g.sysinfo = c_src_env___libc_start_main.__sysinfo ->
  g.libc = c_src_env___libc_start_main.__libc -> g.progname = c_src_env___libc_start_main.__progname -> g.progname_full = c_src_env___libc_start_main.__progname_full ->
  g.empty_str = c_src_env___libc_start_main.str_ -> g.main_tls = c_src_env___init_tls.main_tls -> g.builtin_tls = c_src_env___init_tls.builtin_tls ->
  g.stack_chk_guard = c_src_env___stack_chk_fail.__stack_chk_guard -> g.default_stacksize = c_src_env___init_tls.__default_stacksize ->
  mp.calls(G1, startup_specs.init_tls_spec_fun(g)) -> mp.calls(G2, startup_specs.init_ssp_spec_fun(g)) ->
  regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
  runs(c_src_env___libc_start_main.__init_libc_fun(G1, G2, G3, G4, G5)[regs], s, o) ->
  runs(startup_specs.init_libc_spec_fun(g)[regs], s, o)
proof
  fix g G1 G2 G3 G4 G5 regs s o
  assume hgE hgH hgS hgL hgP hgF hgZ hgM hgB hgG hgD hG1 hG2 hr hl hw h
  have lo: seq_len(regs) in omega by simp(hr)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(hl, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(hr, ol, keep(ord_le))
  rsimp only, c_src_env___libc_start_main.__init_libc_fun, app_fn_build, ra in h
  have pu := apply(g.runs_univ, h)
  have b := apply(g.runs_elim, h)
  let ENVP := bits_of_int(64, regs[0])
  let PN := bits_of_int(64, regs[1])
  let SP := startup_specs.init_libc_spec(g, ENVP, PN)
  let SF := startup_specs.init_libc_spec_fun(g)
  let OVF := exc_val("stack_overflow", empty)
  let LV := s.objs.live
  let WL(w) := fn_update(w, "objs", fn_update(w.objs, "live", LV))
  let K(w) := any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o = ok(w, pair(x5, x6))))
  let GO := runs(SF[regs], s, o)
  have hu: s in univ(1) by simp(pu)
  // fewer than two registers: the spec's anything
  have cS: !ord_le(2, seq_len(regs)) -> GO proof
    assume hn
    rsimp only, startup_specs.init_libc_spec_fun, app_fn_build, ra
    show := apply(tr.runs_intro[r := x1 x2. !ord_le(2, seq_len(regs)) || bind_rel(SP, x1, x3 x4. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. x2 = ok(x3, pair(x5, x6)))),
      x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))], {s}, {o}, pu, taut(hn))
  qed
  have cT: ord_le(2, seq_len(regs)) -> GO proof
    assume h2
    have b2: letin(app(app(s, "objs"), "live"), x3. bind_rel(c_src_env___libc_start_main.__init_libc(ENVP, PN, G1, G2, G3, G4, G5), s,
        x4 x5. letin(fn_update(x4, "objs", fn_update(app(x4, "objs"), "live", x3)), x6. any_rel(x7. x7 in bits(64), x7. any_rel(x8. x8 in bits(64), x8. o = ok(x6, pair(x7, x8))))),
        x4 x5. o = exc(x4, x5), x4. o = diverge(x4))) by taut(b, h2)
    obtain o3, hs3 hk3 from expand(b2, letin, bind_rel)
    have psu := apply(g.runs_univ, expand(hs3, c_src_env___libc_start_main.__init_libc))
    // (the code's procedure's outcome o3, the spec's -- the objects
    // restored --, the same rest)
    have via: all o3x. runs(SP, s, o3x) ->
        ((ex w r. o3x = ok(w, r) && K(w)) || (ex w e. o3x = exc(w, e) && o = exc(w, e)) || (ex t. o3x = diverge(t) && o = diverge(t))) -> GO proof
      fix o3x
      assume r1 r2
      show := apply(sp.ilf_intro[g := g, regs := regs, s := s, o := o, o3 := o3x], ra, pu, r1, r2)
    qed
    have cok: all w r. o3 = ok(w, r) -> K(WL(w)) proof
      fix w r
      assume e
      show by simp(rewrite(e, hk3), keep(any_rel))
    qed
    have cexc: all w e. o3 = exc(w, e) -> o = exc(w, e) proof
      fix w e
      assume h3
      show by simp(rewrite(h3, hk3), keep(any_rel))
    qed
    have cdv: all t. o3 = diverge(t) -> o = diverge(t) proof
      fix t
      assume h3
      show by simp(rewrite(h3, hk3), keep(any_rel))
    qed
    have pv pf pd _ := apply(ms.world_parts, hw)
    let D3(x) := ((ex w r. x = ok(w, r) && K(w)) || (ex w e. x = exc(w, e) && o = exc(w, e))) || (ex t. x = diverge(t) && o = diverge(t))
    let PRE := startup_specs.init_libc_pre(s.vm, s.objs, g, ENVP, PN)
    // the requirement not met: the spec's anything, its procedure's
    // outcome the code's, the objects restored
    have caseN: !PRE -> GO proof
      assume hn
      have k1: (ex w r. o3 = ok(w, r)) -> GO proof
        assume e
        obtain w r, e3 from e
        have wu: pair(w, r) in univ(1) by simp(rewrite(e3, psu))
        have wou := mp(app_univ[u := 1, f := w, k := "objs"], (w in univ(1) by simp(wu)))
        have lvu := mp(app_univ[u := 1, f := s.objs, k := "live"], mp(app_univ[u := 1, f := s, k := "objs"], hu))
        have pu3: pair(s, ok(WL(w), r)) in univ(1) by simp(hu, wu, wou, lvu)
        have rs := apply(sp.ils_run[g := g, envp := ENVP, pn := PN, s := s, o := ok(WL(w), r)], hw, pu3, taut(hn))
        have d := mp(all_elim(cok, {w}, {r}), e3)
        have x1: ex w2 r2. ok(WL(w), r) = ok(w2, r2) && K(w2) by ex_intro({WL(w)}, {r}, taut(refl({ok(WL(w), r)}), d))
        show by taut(mp(all_elim(via, {ok(WL(w), r)}), rs, (D3(ok(WL(w), r)) by taut(x1))))
      qed
      have k2: (ex w e. o3 = exc(w, e)) -> GO proof
        assume e
        obtain w x, e3 from e
        have rs := apply(sp.ils_run[g := g, envp := ENVP, pn := PN, s := s, o := o3], hw, psu, taut(hn))
        have oe := mp(all_elim(cexc, {w}, {x}), e3)
        have x1: ex w2 e2. o3 = exc(w2, e2) && o = exc(w2, e2) by ex_intro({w}, {x}, taut(e3, oe))
        show by taut(mp(all_elim(via, {o3}), rs, (D3(o3) by taut(x1))))
      qed
      have k3: (ex t. o3 = diverge(t)) -> GO proof
        assume e
        obtain t, e3 from e
        have rs := apply(sp.ils_run[g := g, envp := ENVP, pn := PN, s := s, o := o3], hw, psu, taut(hn))
        have oe := mp(all_elim(cdv, {t}), e3)
        have x1: ex t2. o3 = diverge(t2) && o = diverge(t2) by ex_intro({t}, taut(e3, oe))
        show by taut(mp(all_elim(via, {o3}), rs, (D3(o3) by taut(x1))))
      qed
      have ot: (ex w r. o3 = ok(w, r)) || (ex w e. o3 = exc(w, e)) || (ex t. o3 = diverge(t)) proof
        have c1: (ex x4 x5. o3 = ok(x4, x5) && K(WL(x4))) -> ex w r. o3 = ok(w, r) proof
          assume q
          obtain w r, q1 _ from q
          show by ex_intro({w}, {r}, q1)
        qed
        have c2: (ex x4 x5. o3 = exc(x4, x5) && o = exc(x4, x5)) -> ex w e. o3 = exc(w, e) proof
          assume q
          obtain w e, q1 _ from q
          show by ex_intro({w}, {e}, q1)
        qed
        have c3: (ex x4. o3 = diverge(x4) && o = diverge(x4)) -> ex t. o3 = diverge(t) proof
          assume q
          obtain t, q1 _ from q
          show by ex_intro({t}, q1)
        qed
        show by taut(hk3, c1, c2, c3)
      qed
      show by taut(ot, k1, k2, k3)
    qed
    // the requirement met: the run's outcomes
    have caseP: PRE -> GO proof
      assume hp
      have eb: ENVP in bits(64) by simp()
      have pb: PN in bits(64) by simp()
      have go := mp(all_elim(sp.il_run, {g}, {ENVP}, {PN}, {G1}, {G2}, {G3}, {G4}, {G5}, {s}, {o3}), hw, hs3, eb, pb,
        hgE, hgH, hgS, hgL, hgP, hgF, hgZ, hgM, hgB, hgG, hgD, hG1, hG2, hp)
      // (an overflow: the spec's)
      have p2: sp.ovf_any(s, o3) -> GO proof
        assume e
        obtain f v ob, hf hv hob e3 from expand(e, sp.ovf_any)
        let WO := fn_update(fn_update(fn_update(s, "fs_base", f), "vm", v), "objs", ob)
        have rs := apply(sp.ils_run[g := g, envp := ENVP, pn := PN, s := s, o := o3], hw, psu, taut(e))
        have oe := mp(all_elim(cexc, {WO}, {OVF}), e3)
        have x1: ex w2 e2. o3 = exc(w2, e2) && o = exc(w2, e2) by ex_intro({WO}, {OVF}, taut(e3, oe))
        show by taut(mp(all_elim(via, {o3}), rs, (D3(o3) by taut(x1))))
      qed
      have p1: abi.ovf_out(s, o3) -> GO proof
        assume e
        show := mp(p2, apply(sp.ovf_out_any, hw, e))
      qed
      // (the frame, libc.auxv, the thread: the objects restored, the
      // spec's state)
      have p3: (ex V fs L. ((V in x86_64_linux.Vm && startup_specs.frame(s.vm, V, s.objs, startup_specs.start_writes(g))) &&
          (all n. n in omega -> startup_specs.env_at(s.vm, s.objs, ENVP, n) -> gimple.bytes_at(V, bits_add(64, g.libc, 8), 8) = int_add(ENVP, int_mul(8, int_add(n, 1)))) &&
          fs in bits(64) && startup_specs.thread_set(V, fs)) &&
          o3 = ok(fn_update(fn_update(fn_update(s, "vm", V), "objs", fn_update(s.objs, "live", L)), "fs_base", fs), empty)) -> GO proof
        assume e
        obtain V fs L, hV hfr hl8 hfs hts e3 from e
        let W3 := fn_update(fn_update(fn_update(s, "vm", V), "objs", fn_update(s.objs, "live", L)), "fs_base", fs)
        let F := fn_update(fn_update(s, "vm", V), "fs_base", fs)
        have d := mp(all_elim(cok, {W3}, {empty}), e3)
        have of ol0 := (is_fun(s.objs) && "live" in dom(s.objs) by simp(expand(hw, abi.World, abi.Objs)))
        have e2: fn_update(fn_update(s.objs, "live", L), "live", LV) = s.objs := trans(fn_update_twice[f := s.objs, k := "live", a := L, b := LV], mp(fn_update_same[f := s.objs, k := "live"], of, ol0))
        have f1: is_fun(fn_update(s, "vm", V)) := mp(fn_update_fun[f := s, k := "vm", v := V], pf)
        have f2: "objs" in dom(fn_update(s, "vm", V)) by simp(mp(fn_update_dom[f := s, k := "vm", v := V], pf, pd), expand(hw, abi.World))
        have e4 := mp(fn_update_same[f := fn_update(s, "vm", V), k := "objs"], f1, f2)
        have od: "objs" in dom(s) by simp(expand(hw, abi.World))
        have eqW: WL(W3) = F by simp(e2, e4, pf, od)
        have vu := apply(x86.vm_univ, hV)
        have fsu: fs in univ(1) by simp(hfs)
        have pu3: pair(s, ok(F, empty)) in univ(1) by simp(hu, vu, fsu)
        have rv: ex V2 fs2. ((V2 in x86_64_linux.Vm && startup_specs.frame(s.vm, V2, s.objs, startup_specs.start_writes(g))) &&
            (all n. n in omega -> startup_specs.env_at(s.vm, s.objs, ENVP, n) -> gimple.bytes_at(V2, bits_add(64, g.libc, 8), 8) = int_add(ENVP, int_mul(8, int_add(n, 1)))) &&
            fs2 in bits(64) && startup_specs.thread_set(V2, fs2)) && ok(F, empty) = ok(fn_update(fn_update(s, "vm", V2), "fs_base", fs2), empty)
          by ex_intro({V}, {fs}, taut(hV, hfr, hl8, hfs, hts, refl({ok(F, empty)})))
        have rs := apply(sp.ils_run[g := g, envp := ENVP, pn := PN, s := s, o := ok(F, empty)], hw, pu3, taut(rv))
        have x1: ex w2 r2. ok(F, empty) = ok(w2, r2) && K(w2) by ex_intro({F}, {empty}, taut(refl({ok(F, empty)}), rewrite(eqW, d)))
        show by taut(mp(all_elim(via, {ok(F, empty)}), rs, (D3(ok(F, empty)) by taut(x1))))
      qed
      show by taut(go, p1, p2, p3)
    qed
    show by taut(caseN, caseP)
  qed
  show by taut(cS, cT)
qed
