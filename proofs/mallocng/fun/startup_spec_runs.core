// The startup specs' runs (layers/startup_specs.sl): a spec function run
// with its precondition met -- an overflow, or its frame and guarantees.
// What a caller's call of it gives (gc.call0_inv's Q).

// (the static TLS area's bytes: startup writes them)
theorem sp.tls_w: all g i. g.builtin_tls in bits(64) -> i in omega -> int_lt(i, 336) -> int_add(g.builtin_tls, i) in startup_specs.start_writes(g)
proof
  fix g i
  assume hb hi hil
  have io: int_add(g.builtin_tls, i) in omega by arith(hb, hi)
  have sp: int_add(g.builtin_tls, i) in startup_specs.span(g.builtin_tls, 336) by defs(sel(taut(io, (int_le(g.builtin_tls, int_add(g.builtin_tls, i)) && int_lt(int_add(g.builtin_tls, i), int_add(g.builtin_tls, 336)) by arith(hb, hi, hil)))), startup_specs.span)
  show by defs(sel(taut(io, sp)), startup_specs.start_writes)
qed

// (a memory as the spec's: the descriptor's self pointer stored at
// builtin_tls -- init_tls_spec's choice is possible)
theorem sp.tls_exists: all g t. t in abi.World -> g.builtin_tls in bits(64) -> startup_specs.globals_ok(t.vm, t.objs, g) ->
  ex V. V in x86_64_linux.Vm && (startup_specs.frame(t.vm, V, t.objs, startup_specs.start_writes(g)) &&
    (ex fs. fs in bits(64) && (startup_specs.thread_set(V, fs) && startup_specs.in_tls(g, fs))))
proof
  fix g t
  assume hw hb hg
  let FS := g.builtin_tls
  let V := fn_update(t.vm, "bytes", x86_64_linux.store_le(t.vm.bytes, FS, 8, FS))
  have hall _ hnz hbd := expand(hg, startup_specs.globals_ok)
  have tv _ _ tb := apply(ms.world_parts, hw)
  have su := apply(g.store_univ, {t.vm}, {FS}, {8}, {FS}, tv)
  have vu: V in univ(1) by simp(apply(x86.vm_univ, tv), su)
  have vV := apply(x86.store_vm, {t.vm}, {FS}, {8}, {FS}, tv, vu)
  // (the bytes of the area: data pages)
  have pg: all i. i in omega -> int_lt(i, 336) -> x86_64_linux.mapped(t.vm, int_div(int_add(FS, i), x86_64_linux.PAGE)) &&
      snd(t.vm.pages[int_div(int_add(FS, i), x86_64_linux.PAGE)]).prot.r && snd(t.vm.pages[int_div(int_add(FS, i), x86_64_linux.PAGE)]).prot.w &&
      !abi.stack_page(t.vm, int_div(int_add(FS, i), x86_64_linux.PAGE)) proof
    fix i
    assume hi hil
    have x := mp(all_elim(hall, {int_add(FS, i)}), arith(hb, hi), apply(sp.tls_w, {g}, {i}, hb, hi, hil))
    show by taut(x)
  qed
  let W := startup_specs.start_writes(g)
  // (the frame: only the descriptor's first word written, in the area)
  have vf: is_fun(t.vm) && "bytes" in dom(t.vm) by simp(tv)
  have f1: fn_update(V, "bytes", t.vm.bytes) = t.vm := trans(fn_update_twice[f := t.vm, k := "bytes", a := x86_64_linux.store_le(t.vm.bytes, FS, 8, FS), b := t.vm.bytes],
    mp(fn_update_same[f := t.vm, k := "bytes"], taut(vf), taut(vf)))
  have f2: all x. x in bits(64) -> !(x in W) -> !abi.stack_free(t.vm, t.objs, x) -> V.bytes[x] = t.vm.bytes[x] proof
    fix x
    assume hx hn _
    have ne: all i. i in omega -> int_lt(i, 8) -> !(bits_add(64, FS, bits_of_int(64, i)) = x) proof
      fix i
      assume hi hil
      have ea := apply(ms.add_i, {FS}, {i}, simp(hb), hi, arith(hb, hi, hil, hbd))
      have iw := apply(sp.tls_w, {g}, {i}, hb, hi, arith(hil))
      have c: bits_add(64, FS, bits_of_int(64, i)) = x -> false proof
        assume e
        show by taut(hn, rewrite(trans(sym(ea), e), iw))
      qed
      show by taut(c)
    qed
    have so := apply(x86.store_outside, {t.vm.bytes}, {FS}, {8}, {FS}, {x}, hx, ne)
    show by simp(so)
  qed
  have fr: startup_specs.frame(t.vm, V, t.objs, W) by defs(taut(f1, f2), startup_specs.frame)
  // (the descriptor at FS: its own address in its first word, the canary's
  // word on data pages)
  have vp: V.pages = t.vm.pages by simp()
  have rd: all k. k in omega -> int_le(int_add(k, 8), 336) -> x86_64_linux.readable(V, int_add(FS, k), 8) &&
      (all i. i in omega -> int_lt(i, 8) -> snd(V.pages[int_div(int_add(int_add(FS, k), i), x86_64_linux.PAGE)]).prot.w &&
        !abi.stack_page(V, int_div(int_add(int_add(FS, k), i), x86_64_linux.PAGE))) proof
    fix k
    assume hk hk8
    have each: all i. i in omega -> int_lt(i, 8) -> (x86_64_linux.mapped(V, int_div(int_add(int_add(FS, k), i), x86_64_linux.PAGE)) &&
        snd(V.pages[int_div(int_add(int_add(FS, k), i), x86_64_linux.PAGE)]).prot.r) &&
        snd(V.pages[int_div(int_add(int_add(FS, k), i), x86_64_linux.PAGE)]).prot.w && !abi.stack_page(V, int_div(int_add(int_add(FS, k), i), x86_64_linux.PAGE)) proof
      fix i
      assume hi hil
      have e: int_add(int_add(FS, k), i) = int_add(FS, int_add(k, i)) by arith(hb, hk, hi)
      have pi := mp(all_elim(pg, {int_add(k, i)}), arith(hk, hi), arith(hk8, hil))
      show by defs(simp(e, vp, expand(pi, x86_64_linux.mapped, abi.stack_page)), x86_64_linux.mapped, abi.stack_page)
    qed
    have r1: all i. i in omega -> int_lt(i, 8) -> x86_64_linux.mapped(V, int_div(int_add(int_add(FS, k), i), x86_64_linux.PAGE)) &&
        snd(V.pages[int_div(int_add(int_add(FS, k), i), x86_64_linux.PAGE)]).prot.r proof
      fix i
      assume hi hil
      have x := mp(all_elim(each, {i}), hi, hil)
      show by taut(x)
    qed
    have r2: all i. i in omega -> int_lt(i, 8) -> snd(V.pages[int_div(int_add(int_add(FS, k), i), x86_64_linux.PAGE)]).prot.w &&
        !abi.stack_page(V, int_div(int_add(int_add(FS, k), i), x86_64_linux.PAGE)) proof
      fix i
      assume hi hil
      have x := mp(all_elim(each, {i}), hi, hil)
      show by taut(x)
    qed
    have r3: x86_64_linux.readable(V, int_add(FS, k), 8) by defs(r1, x86_64_linux.readable)
    show by taut(r3, r2)
  qed
  have r0 r0w := mp(all_elim(rd, {0}), simp(), simp())
  have r40 r40w := mp(all_elim(rd, {40}), simp(), simp())
  have z0: int_add(FS, 0) = FS by arith(hb)
  have vb: V.bytes in fn_space(bits(64), bits(8)) by simp(apply(x86.store_typed, {t.vm.bytes}, {FS}, {8}, {FS}, tb))
  have le0: x86_64_linux.le(V.bytes, FS, 8) = gimple.bytes_at(V, FS, 8) := apply(x86.le8_nat, {V}, {FS}, vb)
  have b8: gimple.bytes_at(V, FS, 8) = FS by mem(hb, hbd)
  have tok: abi.thread_ok(V, FS) proof
    have st: all i. i in omega -> int_lt(i, 8) -> !abi.stack_page(V, int_div(int_add(FS, i), x86_64_linux.PAGE)) proof
      fix i
      assume hi hil
      have x := rewrite(z0, mp(all_elim(r0w, {i}), hi, hil))
      show by taut(x)
    qed
    show by defs(taut(rewrite(z0, r0), st, trans(le0, b8), hnz), abi.thread_ok)
  qed
  have cok: abi.canary_ok(V, FS) by defs(taut(r40, r40w), abi.canary_ok)
  have it: startup_specs.in_tls(g, FS) by defs(arith(hb), startup_specs.in_tls)
  have ts: startup_specs.thread_set(V, FS) by defs(taut(tok, cok), startup_specs.thread_set)
  have efs: ex fs. fs in bits(64) && (startup_specs.thread_set(V, fs) && startup_specs.in_tls(g, fs)) by ex_intro({FS}, taut(hb, ts, it))
  show by ex_intro({V}, taut(vV, fr, efs))
qed

theorem sp.tls_q: all g t aux regs o2. t in abi.World -> t in univ(1) -> g.builtin_tls in bits(64) -> aux in bits(64) -> startup_specs.init_tls_pre(t.vm, t.objs, g, aux) ->
  gc.regs_ok(regs, seq_one(gimple.arg(64, aux))) -> runs(startup_specs.init_tls_spec_fun(g)[regs], t, o2) ->
  abi.ovf_out(t, o2) || (ex V fs r. ((V in x86_64_linux.Vm && startup_specs.frame(t.vm, V, t.objs, startup_specs.start_writes(g))) &&
    (startup_specs.thread_set(V, fs) && startup_specs.in_tls(g, fs))) && o2 = ok(fn_update(fn_update(t, "vm", V), "fs_base", fs), r))
proof
  fix g t aux regs o2
  assume hw htu hb ha hpre hro h
  have rl rln _ := hro
  have rn: seq_len(regs) = 1 := trans(rln, (seq_len(seq_one(gimple.arg(64, aux))) = 1 by simp()))
  have lo: seq_len(regs) in omega by simp(rn)
  have q0 := apply(gc.reg_at[regs := regs, args := seq_one(gimple.arg(64, aux)), i := 0, w := 64, x := aux], hro, simp(), simp(), simp(), simp(), ha)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, startup_specs.init_tls_spec_fun, app_fn_build, ra in h
  have o1l: ord_le(1, seq_len(regs)) by defs(simp(rn), ord_le)
  have b := rewrite(q0, apply(g.runs_elim, h))
  have b2: bind_rel(startup_specs.init_tls_spec(g, aux), t, x0 x1. any_rel(x2. x2 in bits(64), x2. any_rel(x3. x3 in bits(64), x3. o2 = ok(x0, pair(x2, x3)))),
    x0 x1. o2 = exc(x0, x1), x0. o2 = diverge(x0)) by taut(b, o1l)
  obtain o3, hs3 hk3 from expand(b2, bind_rel)
  rsimp only, startup_specs.init_tls_spec in hs3
  obtain x0, hbr hout from apply(or_resolve, apply(g.runs_elim, hs3), hpre)
  let OVF := exc_val("stack_overflow", empty)
  have k1: case 1 of hbr proof
    assume e
    rsimp only, abi.overflow in e
    have pv _ _ _ := apply(ms.world_parts, hw)
    have vv: ex x. x in x86_64_linux.Vm by ex_intro({t.vm}, simp(pv))
    have l: ex v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && x0 = exc(pair(fn_update(fn_update(t, "vm", v), "objs", ob), empty), pair("raise", OVF)) by simp(e, vv, ct.objs_ne)
    obtain v ob, hv hob hx from l
    have oe: o3 = exc(fn_update(fn_update(t, "vm", v), "objs", ob), OVF) by simp(rewrite(hx, hout))
    have o2e: o2 = exc(fn_update(fn_update(t, "vm", v), "objs", ob), OVF) by simp(rewrite(oe, hk3))
    have x: abi.ovf_out(t, o2) by ex_intro({v}, {ob}, taut(hv, hob, o2e))
    show by taut(x)
  qed
  have k2: case 2 of hbr proof
    assume e
    rsimp in e
    have _ _ _ hg _ _ := expand(hpre, startup_specs.init_tls_pre)
    obtain V, hV hfr hfs0 hk from apply(g.any_e, apply(sp.tls_exists, {g}, {t}, hw, hb, hg), e)
    have hk1 := apply(g.letin_e, hk)
    rsimp in hk1
    obtain fs, hfb hts hit hk2 from apply(g.any_e, hfs0, hk1)
    have xe := apply(g.letin_e, hk2)
    let S := fn_update(fn_update(t, "vm", V), "fs_base", fs)
    have oe: o3 = ok(S, empty) by simp(rewrite(xe, hout))
    have k4: any_rel(x2. x2 in bits(64), x2. any_rel(x3. x3 in bits(64), x3. o2 = ok(S, pair(x2, x3)))) by simp(rewrite(oe, hk3), keep(any_rel))
    have nb: ex z. z in bits(64) by ex_intro({0}, simp())
    obtain z1, _ k5 from apply(g.any_e, nb, k4)
    obtain z2, _ k6 from apply(g.any_e, nb, k5)
    have x: ex V fs r. ((V in x86_64_linux.Vm && startup_specs.frame(t.vm, V, t.objs, startup_specs.start_writes(g))) &&
      (startup_specs.thread_set(V, fs) && startup_specs.in_tls(g, fs))) && o2 = ok(fn_update(fn_update(t, "vm", V), "fs_base", fs), r)
      by ex_intro({V}, {fs}, {pair(z1, z2)}, taut(hV, hfr, hts, hit, k6))
    show by taut(x)
  qed
  show by taut(hbr, k1, k2)
qed

// (__init_ssp's choice: the memory as it was is one -- its frame empty,
// the thread as the precondition has it)
theorem sp.ssp_q: all g t e regs o2. t in abi.World -> t in univ(1) -> e in bits(64) -> startup_specs.init_ssp_pre(t.vm, t.objs, g, t.fs_base, e) ->
  gc.regs_ok(regs, seq_one(gimple.arg(64, e))) -> runs(startup_specs.init_ssp_spec_fun(g)[regs], t, o2) ->
  abi.ovf_out(t, o2) || (ex V r. ((V in x86_64_linux.Vm && startup_specs.frame(t.vm, V, t.objs, startup_specs.start_writes(g))) &&
    startup_specs.thread_set(V, t.fs_base)) && o2 = ok(fn_update(t, "vm", V), r))
proof
  fix g t e regs o2
  assume hw htu he hpre hro h
  have rl rln _ := hro
  have rn: seq_len(regs) = 1 := trans(rln, (seq_len(seq_one(gimple.arg(64, e))) = 1 by simp()))
  have lo: seq_len(regs) in omega by simp(rn)
  have q0 := apply(gc.reg_at[regs := regs, args := seq_one(gimple.arg(64, e)), i := 0, w := 64, x := e], hro, simp(), simp(), simp(), simp(), he)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, startup_specs.init_ssp_spec_fun, app_fn_build, ra in h
  have o1l: ord_le(1, seq_len(regs)) by defs(simp(rn), ord_le)
  have b := rewrite(q0, apply(g.runs_elim, h))
  have b2: bind_rel(startup_specs.init_ssp_spec(g, e), t, x0 x1. any_rel(x2. x2 in bits(64), x2. any_rel(x3. x3 in bits(64), x3. o2 = ok(x0, pair(x2, x3)))),
    x0 x1. o2 = exc(x0, x1), x0. o2 = diverge(x0)) by taut(b, o1l)
  obtain o3, hs3 hk3 from expand(b2, bind_rel)
  rsimp only, startup_specs.init_ssp_spec in hs3
  obtain x0, hbr hout from apply(or_resolve, apply(g.runs_elim, hs3), hpre)
  let OVF := exc_val("stack_overflow", empty)
  have k1: case 1 of hbr proof
    assume e1
    rsimp only, abi.overflow in e1
    have pv _ _ _ := apply(ms.world_parts, hw)
    have vv: ex x. x in x86_64_linux.Vm by ex_intro({t.vm}, simp(pv))
    have l: ex v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && x0 = exc(pair(fn_update(fn_update(t, "vm", v), "objs", ob), empty), pair("raise", OVF)) by simp(e1, vv, ct.objs_ne)
    obtain v ob, hv hob hx from l
    have oe: o3 = exc(fn_update(fn_update(t, "vm", v), "objs", ob), OVF) by simp(rewrite(hx, hout))
    have o2e: o2 = exc(fn_update(fn_update(t, "vm", v), "objs", ob), OVF) by simp(rewrite(oe, hk3))
    have x: abi.ovf_out(t, o2) by ex_intro({v}, {ob}, taut(hv, hob, o2e))
    show by taut(x)
  qed
  have k2: case 2 of hbr proof
    assume e1
    rsimp in e1
    have tv _ _ _ := apply(ms.world_parts, hw)
    have vf: is_fun(t.vm) && "bytes" in dom(t.vm) by simp(tv)
    have f1: fn_update(t.vm, "bytes", t.vm.bytes) = t.vm := mp(fn_update_same[f := t.vm, k := "bytes"], taut(vf), taut(vf))
    have f2: all x. x in bits(64) -> !(x in startup_specs.start_writes(g)) -> !abi.stack_free(t.vm, t.objs, x) -> t.vm.bytes[x] = t.vm.bytes[x] proof
      fix x
      assume _ _ _
      show := refl({t.vm.bytes[x]})
    qed
    have fr: startup_specs.frame(t.vm, t.vm, t.objs, startup_specs.start_writes(g)) by defs(taut(f1, f2), startup_specs.frame)
    have ts _ _ _ := expand(hpre, startup_specs.init_ssp_pre)
    have wx: ex x. x in x86_64_linux.Vm && (startup_specs.frame(t.vm, x, t.objs, startup_specs.start_writes(g)) && startup_specs.thread_set(x, t.fs_base))
      by ex_intro({t.vm}, taut(tv, fr, ts))
    obtain V, hV hfr hts hk from apply(g.any_e, wx, e1)
    have xe := apply(g.letin_e, hk)
    let S := fn_update(t, "vm", V)
    have oe: o3 = ok(S, empty) by simp(rewrite(xe, hout))
    have k4: any_rel(x2. x2 in bits(64), x2. any_rel(x3. x3 in bits(64), x3. o2 = ok(S, pair(x2, x3)))) by simp(rewrite(oe, hk3), keep(any_rel))
    have nb: ex z. z in bits(64) by ex_intro({0}, simp())
    obtain z1, _ k5 from apply(g.any_e, nb, k4)
    obtain z2, _ k6 from apply(g.any_e, nb, k5)
    have x: ex V r. ((V in x86_64_linux.Vm && startup_specs.frame(t.vm, V, t.objs, startup_specs.start_writes(g))) &&
      startup_specs.thread_set(V, t.fs_base)) && o2 = ok(fn_update(t, "vm", V), r) by ex_intro({V}, {pair(z1, z2)}, taut(hV, hfr, hts, k6))
    show by taut(x)
  qed
  show by taut(hbr, k1, k2)
qed

// ----------------------------------------------------------------------
//  Frames (startup_specs.frame): built step by step -- an allocation, a
//  store of bytes the frame allows, a memory as another but in a region the
//  frame allows -- and read: bytes usable at the start and not written read
//  as at the start

theorem sp.fr_alloc(b, V, objs, sz, l, W): gimple.objs_fit(b, objs, sz, l) -> fn_update(V, "bytes", b.bytes) = b ->
  (all x5. x5 in bits(64) -> (all x6. x6 in omega -> int_lt(x6, seq_len(sz)) -> !(int_le(l[x6], x5) && int_lt(x5, int_add(l[x6], fst(sz[x6]))))) ->
    V.bytes[x5] = b.bytes[x5]) ->
  startup_specs.frame(b, V, objs, W)
proof
  assume hf hb hv
  have _ hall _ := expand(hf, gimple.objs_fit)
  have f2: all x. x in bits(64) -> !(x in W) -> !abi.stack_free(b, objs, x) -> V.bytes[x] = b.bytes[x] proof
    fix x
    assume hx _ hn
    have out: all x6. x6 in omega -> int_lt(x6, seq_len(sz)) -> !(int_le(l[x6], x) && int_lt(x, int_add(l[x6], fst(sz[x6])))) proof
      fix x6
      assume h6 h6l
      have _ _ _ sf := mp(all_elim(hall, {x6}), h6, h6l)
      have c: int_le(l[x6], x) && int_lt(x, int_add(l[x6], fst(sz[x6]))) -> false proof
        assume hin
        show by taut(hn, mp(all_elim(sf, {x}), (x in omega by simp(hx)), hin))
      qed
      show by taut(c)
    qed
    show := mp(all_elim(hv, {x}), hx, out)
  qed
  show by defs(taut(hb, f2), startup_specs.frame)
qed

theorem sp.fr_store(b, U, objs, W, a, n, v): startup_specs.frame(b, U, objs, W) -> a in bits(64) -> n in omega -> int_le(int_add(a, n), 18446744073709551616) ->
  (all i. i in omega -> int_lt(i, n) -> int_add(a, i) in W || abi.stack_free(b, objs, int_add(a, i))) ->
  startup_specs.frame(b, fn_update(U, "bytes", x86_64_linux.store_le(U.bytes, a, n, v)), objs, W)
proof
  assume hf ha hn hl hw
  have f1 f2 := expand(hf, startup_specs.frame)
  have g1: fn_update(fn_update(U, "bytes", x86_64_linux.store_le(U.bytes, a, n, v)), "bytes", b.bytes) = b :=
    trans(fn_update_twice[f := U, k := "bytes", a := x86_64_linux.store_le(U.bytes, a, n, v), b := b.bytes], f1)
  have g2: all x. x in bits(64) -> !(x in W) -> !abi.stack_free(b, objs, x) -> fn_update(U, "bytes", x86_64_linux.store_le(U.bytes, a, n, v)).bytes[x] = b.bytes[x] proof
    fix x
    assume hx hnw hns
    have ne: all i. i in omega -> int_lt(i, n) -> !(bits_add(64, a, bits_of_int(64, i)) = x) proof
      fix i
      assume hi hil
      have ea := apply(ms.add_i, {a}, {i}, simp(ha), hi, arith(ha, hi, hil, hl))
      have c: bits_add(64, a, bits_of_int(64, i)) = x -> false proof
        assume e
        have e2: int_add(a, i) = x := trans(sym(ea), e)
        show by taut(hnw, hns, rewrite(e2, mp(all_elim(hw, {i}), hi, hil)))
      qed
      show by taut(c)
    qed
    have so := apply(x86.store_outside, {U.bytes}, {a}, {n}, {v}, {x}, hx, ne)
    have e1: fn_update(U, "bytes", x86_64_linux.store_le(U.bytes, a, n, v)).bytes[x] = U.bytes[x] by simp(so)
    show := trans(e1, mp(all_elim(f2, {x}), hx, hnw, hns))
  qed
  show by defs(taut(g1, g2), startup_specs.frame)
qed

theorem sp.fr_out(b, M, U, objs, W, c, m): startup_specs.frame(b, M, objs, W) -> fn_update(U, "bytes", M.bytes) = M ->
  (all x. x in bits(64) -> !(int_le(c, x) && int_lt(x, int_add(c, m))) -> U.bytes[x] = M.bytes[x]) ->
  (all x. x in omega -> int_le(c, x) -> int_lt(x, int_add(c, m)) -> x in W || abi.stack_free(b, objs, x)) ->
  startup_specs.frame(b, U, objs, W)
proof
  assume hf hu ho hw
  have f1 f2 := expand(hf, startup_specs.frame)
  have t1 := fn_update_twice[f := U, k := "bytes", a := M.bytes, b := b.bytes]
  have g1: fn_update(U, "bytes", b.bytes) = b := trans(sym(t1), trans(subst({y. fn_update(fn_update(U, "bytes", M.bytes), "bytes", b.bytes) = fn_update(y, "bytes", b.bytes)}, hu,
    refl({fn_update(fn_update(U, "bytes", M.bytes), "bytes", b.bytes)})), f1))
  have g2: all x. x in bits(64) -> !(x in W) -> !abi.stack_free(b, objs, x) -> U.bytes[x] = b.bytes[x] proof
    fix x
    assume hx hnw hns
    have c: int_le(c, x) && int_lt(x, int_add(c, m)) -> false proof
      assume hin
      have _ _ := hin
      show by taut(hnw, hns, mp(all_elim(hw, {x}), (x in omega by simp(hx)), hin.1, hin.2))
    qed
    have uo := mp(all_elim(ho, {x}), hx, (!(int_le(c, x) && int_lt(x, int_add(c, m))) by taut(c)))
    show := trans(uo, mp(all_elim(f2, {x}), hx, hnw, hns))
  qed
  show by defs(taut(g1, g2), startup_specs.frame)
qed

theorem sp.fr_read(b, U, objs, W, a, n, wr): startup_specs.frame(b, U, objs, W) -> gimple.usable(b, objs, a, n, wr) ->
  (all i. i in omega -> int_lt(i, n) -> !(int_add(a, i) in W)) -> a in omega -> n in omega ->
  gimple.bytes_at(U, a, n) = gimple.bytes_at(b, a, n)
proof
  assume hf hu hw ha hn
  have _ f2 := expand(hf, startup_specs.frame)
  have pe: all i. i in omega -> int_lt(i, n) -> U.bytes[bits_add(64, a, bits_of_int(64, i))] = b.bytes[bits_add(64, a, bits_of_int(64, i))] proof
    fix i
    assume hi hil
    have nf := apply(mp.nofree[vm := b, objs := objs, a := a, n := n, w := wr, i := i], hu, hi, hil)
    have lt := apply(mp.usable_lt[vm := b, objs := objs, a := a, n := n, w := wr, i := i], hu, ha, hi, hil)
    have ea: bits_add(64, a, bits_of_int(64, i)) = int_add(a, i) by defs(arith(ha, hi, lt), bits_add, bits_of_int, pow2)
    have ab: int_add(a, i) in bits(64) by arith(ha, hi, lt)
    show := rewrite(sym(ea), mp(all_elim(f2, {int_add(a, i)}), ab, mp(all_elim(hw, {i}), hi, hil), nf))
  qed
  show := apply(mp.bytes_same[U := U, vm := b, a := a, n := n], hn, pe)
qed
