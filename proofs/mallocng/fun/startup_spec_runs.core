// The startup specs' runs (layers/startup_specs.sl): a spec function run
// with its precondition met -- an overflow, or its frame and guarantees.
// What a caller's call of it gives (gc.call0_inv's Q).

// (the static TLS area's bytes: startup writes them)
theorem sp.tls_w: all g i. g.builtin_tls in bits(64) -> i in omega -> int_lt(i, 336) -> int_add(g.builtin_tls, i) in startup_specs.start_writes(g)
proof
  fix g i
  assume hb hi hil
  have io: int_add(g.builtin_tls, i) in omega by arith(hb, hi)
  have sp: int_add(g.builtin_tls, i) in startup_specs.span(g.builtin_tls, 336) by defs(sel(taut(io, (int_le(g.builtin_tls, int_add(g.builtin_tls, i)) && int_lt(int_add(g.builtin_tls, i), int_add(g.builtin_tls, 336)) by arith(hb, hi, hil)))), startup_specs.span)
  show by defs(sel(taut(io, sp)), startup_specs.start_writes)
qed

theorem sp.tls_w2: all g i. g.builtin_tls in bits(64) -> i in omega -> int_lt(i, 336) -> int_add(g.builtin_tls, i) in startup_specs.tls_writes(g)
proof
  fix g i
  assume hb hi hil
  have io: int_add(g.builtin_tls, i) in omega by arith(hb, hi)
  have sp: int_add(g.builtin_tls, i) in startup_specs.span(g.builtin_tls, 336) by defs(sel(taut(io, (int_le(g.builtin_tls, int_add(g.builtin_tls, i)) && int_lt(int_add(g.builtin_tls, i), int_add(g.builtin_tls, 336)) by arith(hb, hi, hil)))), startup_specs.span)
  show by defs(sel(taut(io, sp)), startup_specs.tls_writes)
qed

// (a memory as the spec's: the descriptor's self pointer stored at
// builtin_tls -- init_tls_spec's choice is possible)
theorem sp.tls_exists: all g t. t in abi.World -> g.builtin_tls in bits(64) -> startup_specs.globals_ok(t.vm, t.objs, g) ->
  ex V. V in x86_64_linux.Vm && (startup_specs.frame(t.vm, V, t.objs, startup_specs.tls_writes(g)) &&
    (ex fs. fs in bits(64) && (startup_specs.thread_set(V, fs) && startup_specs.in_tls(g, fs))))
proof
  fix g t
  assume hw hb hg
  let FS := g.builtin_tls
  let V := fn_update(t.vm, "bytes", x86_64_linux.store_le(t.vm.bytes, FS, 8, FS))
  have hall _ hnz hbd := expand(hg, startup_specs.globals_ok)
  have tv _ _ tb := apply(ms.world_parts, hw)
  have su := apply(g.store_univ, {t.vm}, {FS}, {8}, {FS}, tv)
  have vu: V in univ(1) by simp(apply(x86.vm_univ, tv), su)
  have vV := apply(x86.store_vm, {t.vm}, {FS}, {8}, {FS}, tv, vu)
  // (the bytes of the area: data pages)
  have pg: all i. i in omega -> int_lt(i, 336) -> x86_64_linux.mapped(t.vm, int_div(int_add(FS, i), x86_64_linux.PAGE)) &&
      snd(t.vm.pages[int_div(int_add(FS, i), x86_64_linux.PAGE)]).prot.r && snd(t.vm.pages[int_div(int_add(FS, i), x86_64_linux.PAGE)]).prot.w &&
      !abi.stack_page(t.vm, int_div(int_add(FS, i), x86_64_linux.PAGE)) proof
    fix i
    assume hi hil
    have x := mp(all_elim(hall, {int_add(FS, i)}), arith(hb, hi), apply(sp.tls_w, {g}, {i}, hb, hi, hil))
    show by taut(x)
  qed
  let W := startup_specs.tls_writes(g)
  // (the frame: only the descriptor's first word written, in the area)
  have vf: is_fun(t.vm) && "bytes" in dom(t.vm) by simp(tv)
  have f1: fn_update(V, "bytes", t.vm.bytes) = t.vm := trans(fn_update_twice[f := t.vm, k := "bytes", a := x86_64_linux.store_le(t.vm.bytes, FS, 8, FS), b := t.vm.bytes],
    mp(fn_update_same[f := t.vm, k := "bytes"], taut(vf), taut(vf)))
  have f2: all x. x in bits(64) -> !(x in W) -> !abi.stack_free(t.vm, t.objs, x) -> V.bytes[x] = t.vm.bytes[x] proof
    fix x
    assume hx hn _
    have ne: all i. i in omega -> int_lt(i, 8) -> !(bits_add(64, FS, bits_of_int(64, i)) = x) proof
      fix i
      assume hi hil
      have ea := apply(ms.add_i, {FS}, {i}, simp(hb), hi, arith(hb, hi, hil, hbd))
      have iw := apply(sp.tls_w2, {g}, {i}, hb, hi, arith(hil))
      have c: bits_add(64, FS, bits_of_int(64, i)) = x -> false proof
        assume e
        show by taut(hn, rewrite(trans(sym(ea), e), iw))
      qed
      show by taut(c)
    qed
    have so := apply(x86.store_outside, {t.vm.bytes}, {FS}, {8}, {FS}, {x}, hx, ne)
    show by simp(so)
  qed
  have fr: startup_specs.frame(t.vm, V, t.objs, W) by defs(taut(f1, f2), startup_specs.frame)
  // (the descriptor at FS: its own address in its first word, the canary's
  // word on data pages)
  have vp: V.pages = t.vm.pages by simp()
  have rd: all k. k in omega -> int_le(int_add(k, 8), 336) -> x86_64_linux.readable(V, int_add(FS, k), 8) &&
      (all i. i in omega -> int_lt(i, 8) -> snd(V.pages[int_div(int_add(int_add(FS, k), i), x86_64_linux.PAGE)]).prot.w &&
        !abi.stack_page(V, int_div(int_add(int_add(FS, k), i), x86_64_linux.PAGE))) proof
    fix k
    assume hk hk8
    have each: all i. i in omega -> int_lt(i, 8) -> (x86_64_linux.mapped(V, int_div(int_add(int_add(FS, k), i), x86_64_linux.PAGE)) &&
        snd(V.pages[int_div(int_add(int_add(FS, k), i), x86_64_linux.PAGE)]).prot.r) &&
        snd(V.pages[int_div(int_add(int_add(FS, k), i), x86_64_linux.PAGE)]).prot.w && !abi.stack_page(V, int_div(int_add(int_add(FS, k), i), x86_64_linux.PAGE)) proof
      fix i
      assume hi hil
      have e: int_add(int_add(FS, k), i) = int_add(FS, int_add(k, i)) by arith(hb, hk, hi)
      have pi := mp(all_elim(pg, {int_add(k, i)}), arith(hk, hi), arith(hk8, hil))
      show by defs(simp(e, vp, expand(pi, x86_64_linux.mapped, abi.stack_page)), x86_64_linux.mapped, abi.stack_page)
    qed
    have r1: all i. i in omega -> int_lt(i, 8) -> x86_64_linux.mapped(V, int_div(int_add(int_add(FS, k), i), x86_64_linux.PAGE)) &&
        snd(V.pages[int_div(int_add(int_add(FS, k), i), x86_64_linux.PAGE)]).prot.r proof
      fix i
      assume hi hil
      have x := mp(all_elim(each, {i}), hi, hil)
      show by taut(x)
    qed
    have r2: all i. i in omega -> int_lt(i, 8) -> snd(V.pages[int_div(int_add(int_add(FS, k), i), x86_64_linux.PAGE)]).prot.w &&
        !abi.stack_page(V, int_div(int_add(int_add(FS, k), i), x86_64_linux.PAGE)) proof
      fix i
      assume hi hil
      have x := mp(all_elim(each, {i}), hi, hil)
      show by taut(x)
    qed
    have r3: x86_64_linux.readable(V, int_add(FS, k), 8) by defs(r1, x86_64_linux.readable)
    show by taut(r3, r2)
  qed
  have r0 r0w := mp(all_elim(rd, {0}), simp(), simp())
  have r40 r40w := mp(all_elim(rd, {40}), simp(), simp())
  have z0: int_add(FS, 0) = FS by arith(hb)
  have vb: V.bytes in fn_space(bits(64), bits(8)) by simp(apply(x86.store_typed, {t.vm.bytes}, {FS}, {8}, {FS}, tb))
  have le0: x86_64_linux.le(V.bytes, FS, 8) = gimple.bytes_at(V, FS, 8) := apply(x86.le8_nat, {V}, {FS}, vb)
  have b8: gimple.bytes_at(V, FS, 8) = FS by mem(hb, hbd)
  have tok: abi.thread_ok(V, FS) proof
    have st: all i. i in omega -> int_lt(i, 8) -> !abi.stack_page(V, int_div(int_add(FS, i), x86_64_linux.PAGE)) proof
      fix i
      assume hi hil
      have x := rewrite(z0, mp(all_elim(r0w, {i}), hi, hil))
      show by taut(x)
    qed
    show by defs(taut(rewrite(z0, r0), st, trans(le0, b8), hnz), abi.thread_ok)
  qed
  have cok: abi.canary_ok(V, FS) by defs(taut(r40, r40w), abi.canary_ok)
  have it: startup_specs.in_tls(g, FS) by defs(arith(hb), startup_specs.in_tls)
  have ts: startup_specs.thread_set(V, FS) by defs(taut(tok, cok), startup_specs.thread_set)
  have efs: ex fs. fs in bits(64) && (startup_specs.thread_set(V, fs) && startup_specs.in_tls(g, fs)) by ex_intro({FS}, taut(hb, ts, it))
  show by ex_intro({V}, taut(vV, fr, efs))
qed

// (a stack overflow during startup: any memory, objects, thread pointer)
def sp.ovf_any(t, o) := ex f v ob. ((f in bits(64) && v in x86_64_linux.Vm) && ob in abi.Objs) &&
  o = exc(fn_update(fn_update(fn_update(t, "fs_base", f), "vm", v), "objs", ob), exc_val("stack_overflow", empty))

theorem sp.tls_q: all g t aux regs o2. t in abi.World -> t in univ(1) -> g.builtin_tls in bits(64) -> aux in bits(64) -> startup_specs.init_tls_pre(t.vm, t.objs, g, aux) ->
  gc.regs_ok(regs, seq_one(gimple.arg(64, aux))) -> runs(startup_specs.init_tls_spec_fun(g)[regs], t, o2) ->
  sp.ovf_any(t, o2) || (ex V fs r. ((V in x86_64_linux.Vm && startup_specs.frame(t.vm, V, t.objs, startup_specs.tls_writes(g))) &&
    (startup_specs.thread_set(V, fs) && startup_specs.in_tls(g, fs))) && o2 = ok(fn_update(fn_update(t, "vm", V), "fs_base", fs), r))
proof
  fix g t aux regs o2
  assume hw htu hb ha hpre hro h
  have rl rln _ := hro
  have rn: seq_len(regs) = 1 := trans(rln, (seq_len(seq_one(gimple.arg(64, aux))) = 1 by simp()))
  have lo: seq_len(regs) in omega by simp(rn)
  have q0 := apply(gc.reg_at[regs := regs, args := seq_one(gimple.arg(64, aux)), i := 0, w := 64, x := aux], hro, simp(), simp(), simp(), simp(), ha)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, startup_specs.init_tls_spec_fun, app_fn_build, ra in h
  have o1l: ord_le(1, seq_len(regs)) by defs(simp(rn), ord_le)
  have b := rewrite(q0, apply(g.runs_elim, h))
  have b2: bind_rel(startup_specs.init_tls_spec(g, aux), t, x0 x1. any_rel(x2. x2 in bits(64), x2. any_rel(x3. x3 in bits(64), x3. o2 = ok(x0, pair(x2, x3)))),
    x0 x1. o2 = exc(x0, x1), x0. o2 = diverge(x0)) by taut(b, o1l)
  obtain o3, hs3 hk3 from expand(b2, bind_rel)
  rsimp only, startup_specs.init_tls_spec in hs3
  obtain x0, hbr hout from apply(or_resolve, apply(g.runs_elim, hs3), hpre)
  let OVF := exc_val("stack_overflow", empty)
  have k1: case 1 of hbr proof
    assume e
    rsimp only, startup_specs.overflow_start, abi.overflow in e
    have pv _ _ _ := apply(ms.world_parts, hw)
    have vv: ex x. x in x86_64_linux.Vm by ex_intro({t.vm}, simp(pv))
    have fv: ex x. x in bits(64) by ex_intro({0}, simp())
    have l: ex f v ob. ((f in bits(64) && v in x86_64_linux.Vm) && ob in abi.Objs) &&
      x0 = exc(pair(fn_update(fn_update(fn_update(t, "fs_base", f), "vm", v), "objs", ob), empty), pair("raise", OVF)) by simp(e, vv, fv, ct.objs_ne)
    obtain f v ob, hf hv hob hx from l
    let T := fn_update(fn_update(fn_update(t, "fs_base", f), "vm", v), "objs", ob)
    have oe: o3 = exc(T, OVF) by simp(rewrite(hx, hout))
    have o2e: o2 = exc(T, OVF) by simp(rewrite(oe, hk3))
    have x: sp.ovf_any(t, o2) by defs(ex_intro({f}, {v}, {ob}, taut(hf, hv, hob, o2e)), sp.ovf_any)
    show by taut(x)
  qed
  have k2: case 2 of hbr proof
    assume e
    rsimp in e
    have _ _ _ _ hg _ _ := expand(hpre, startup_specs.init_tls_pre)
    obtain V, hV hfr hfs0 hk from apply(g.any_e, apply(sp.tls_exists, {g}, {t}, hw, hb, hg), e)
    have hk1 := apply(g.letin_e, hk)
    rsimp in hk1
    obtain fs, hfb hts hit hk2 from apply(g.any_e, hfs0, hk1)
    have xe := apply(g.letin_e, hk2)
    let S := fn_update(fn_update(t, "vm", V), "fs_base", fs)
    have oe: o3 = ok(S, empty) by simp(rewrite(xe, hout))
    have k4: any_rel(x2. x2 in bits(64), x2. any_rel(x3. x3 in bits(64), x3. o2 = ok(S, pair(x2, x3)))) by simp(rewrite(oe, hk3), keep(any_rel))
    have nb: ex z. z in bits(64) by ex_intro({0}, simp())
    obtain z1, _ k5 from apply(g.any_e, nb, k4)
    obtain z2, _ k6 from apply(g.any_e, nb, k5)
    have x: ex V fs r. ((V in x86_64_linux.Vm && startup_specs.frame(t.vm, V, t.objs, startup_specs.tls_writes(g))) &&
      (startup_specs.thread_set(V, fs) && startup_specs.in_tls(g, fs))) && o2 = ok(fn_update(fn_update(t, "vm", V), "fs_base", fs), r)
      by ex_intro({V}, {fs}, {pair(z1, z2)}, taut(hV, hfr, hts, hit, k6))
    show by taut(x)
  qed
  show by taut(hbr, k1, k2)
qed

// (__init_ssp's choice: the memory as it was is one -- its frame empty,
// the thread as the precondition has it)
theorem sp.ssp_q: all g t e regs o2. t in abi.World -> t in univ(1) -> e in bits(64) -> startup_specs.init_ssp_pre(t.vm, t.objs, g, t.fs_base, e) ->
  gc.regs_ok(regs, seq_one(gimple.arg(64, e))) -> runs(startup_specs.init_ssp_spec_fun(g)[regs], t, o2) ->
  sp.ovf_any(t, o2) || (ex V r. ((V in x86_64_linux.Vm && startup_specs.frame(t.vm, V, t.objs, startup_specs.ssp_writes(g))) &&
    startup_specs.thread_set(V, t.fs_base)) && o2 = ok(fn_update(t, "vm", V), r))
proof
  fix g t e regs o2
  assume hw htu he hpre hro h
  have rl rln _ := hro
  have rn: seq_len(regs) = 1 := trans(rln, (seq_len(seq_one(gimple.arg(64, e))) = 1 by simp()))
  have lo: seq_len(regs) in omega by simp(rn)
  have q0 := apply(gc.reg_at[regs := regs, args := seq_one(gimple.arg(64, e)), i := 0, w := 64, x := e], hro, simp(), simp(), simp(), simp(), he)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, startup_specs.init_ssp_spec_fun, app_fn_build, ra in h
  have o1l: ord_le(1, seq_len(regs)) by defs(simp(rn), ord_le)
  have b := rewrite(q0, apply(g.runs_elim, h))
  have b2: bind_rel(startup_specs.init_ssp_spec(g, e), t, x0 x1. any_rel(x2. x2 in bits(64), x2. any_rel(x3. x3 in bits(64), x3. o2 = ok(x0, pair(x2, x3)))),
    x0 x1. o2 = exc(x0, x1), x0. o2 = diverge(x0)) by taut(b, o1l)
  obtain o3, hs3 hk3 from expand(b2, bind_rel)
  rsimp only, startup_specs.init_ssp_spec in hs3
  obtain x0, hbr hout from apply(or_resolve, apply(g.runs_elim, hs3), hpre)
  let OVF := exc_val("stack_overflow", empty)
  have k1: case 1 of hbr proof
    assume e1
    rsimp only, startup_specs.overflow_start, abi.overflow in e1
    have pv _ _ _ := apply(ms.world_parts, hw)
    have vv: ex x. x in x86_64_linux.Vm by ex_intro({t.vm}, simp(pv))
    have fv: ex x. x in bits(64) by ex_intro({0}, simp())
    have l: ex f v ob. ((f in bits(64) && v in x86_64_linux.Vm) && ob in abi.Objs) &&
      x0 = exc(pair(fn_update(fn_update(fn_update(t, "fs_base", f), "vm", v), "objs", ob), empty), pair("raise", OVF)) by simp(e1, vv, fv, ct.objs_ne)
    obtain f v ob, hf hv hob hx from l
    let T := fn_update(fn_update(fn_update(t, "fs_base", f), "vm", v), "objs", ob)
    have oe: o3 = exc(T, OVF) by simp(rewrite(hx, hout))
    have o2e: o2 = exc(T, OVF) by simp(rewrite(oe, hk3))
    have x: sp.ovf_any(t, o2) by defs(ex_intro({f}, {v}, {ob}, taut(hf, hv, hob, o2e)), sp.ovf_any)
    show by taut(x)
  qed
  have k2: case 2 of hbr proof
    assume e1
    rsimp in e1
    have tv _ _ _ := apply(ms.world_parts, hw)
    have vf: is_fun(t.vm) && "bytes" in dom(t.vm) by simp(tv)
    have f1: fn_update(t.vm, "bytes", t.vm.bytes) = t.vm := mp(fn_update_same[f := t.vm, k := "bytes"], taut(vf), taut(vf))
    have f2: all x. x in bits(64) -> !(x in startup_specs.ssp_writes(g)) -> !abi.stack_free(t.vm, t.objs, x) -> t.vm.bytes[x] = t.vm.bytes[x] proof
      fix x
      assume _ _ _
      show := refl({t.vm.bytes[x]})
    qed
    have fr: startup_specs.frame(t.vm, t.vm, t.objs, startup_specs.ssp_writes(g)) by defs(taut(f1, f2), startup_specs.frame)
    have ts _ _ _ := expand(hpre, startup_specs.init_ssp_pre)
    have wx: ex x. x in x86_64_linux.Vm && (startup_specs.frame(t.vm, x, t.objs, startup_specs.ssp_writes(g)) && startup_specs.thread_set(x, t.fs_base))
      by ex_intro({t.vm}, taut(tv, fr, ts))
    obtain V, hV hfr hts hk from apply(g.any_e, wx, e1)
    have xe := apply(g.letin_e, hk)
    let S := fn_update(t, "vm", V)
    have oe: o3 = ok(S, empty) by simp(rewrite(xe, hout))
    have k4: any_rel(x2. x2 in bits(64), x2. any_rel(x3. x3 in bits(64), x3. o2 = ok(S, pair(x2, x3)))) by simp(rewrite(oe, hk3), keep(any_rel))
    have nb: ex z. z in bits(64) by ex_intro({0}, simp())
    obtain z1, _ k5 from apply(g.any_e, nb, k4)
    obtain z2, _ k6 from apply(g.any_e, nb, k5)
    have x: ex V r. ((V in x86_64_linux.Vm && startup_specs.frame(t.vm, V, t.objs, startup_specs.ssp_writes(g))) &&
      startup_specs.thread_set(V, t.fs_base)) && o2 = ok(fn_update(t, "vm", V), r) by ex_intro({V}, {pair(z1, z2)}, taut(hV, hfr, hts, k6))
    show by taut(x)
  qed
  show by taut(hbr, k1, k2)
qed

// ----------------------------------------------------------------------
//  Frames (startup_specs.frame): built step by step -- an allocation, a
//  store of bytes the frame allows, a memory as another but in a region the
//  frame allows -- and read: bytes usable at the start and not written read
//  as at the start

theorem sp.fr_alloc(b, V, objs, sz, l, W): gimple.objs_fit(b, objs, sz, l) -> fn_update(V, "bytes", b.bytes) = b ->
  (all x5. x5 in bits(64) -> (all x6. x6 in omega -> int_lt(x6, seq_len(sz)) -> !(int_le(l[x6], x5) && int_lt(x5, int_add(l[x6], fst(sz[x6]))))) ->
    V.bytes[x5] = b.bytes[x5]) ->
  startup_specs.frame(b, V, objs, W)
proof
  assume hf hb hv
  have _ hall _ := expand(hf, gimple.objs_fit)
  have f2: all x. x in bits(64) -> !(x in W) -> !abi.stack_free(b, objs, x) -> V.bytes[x] = b.bytes[x] proof
    fix x
    assume hx _ hn
    have out: all x6. x6 in omega -> int_lt(x6, seq_len(sz)) -> !(int_le(l[x6], x) && int_lt(x, int_add(l[x6], fst(sz[x6])))) proof
      fix x6
      assume h6 h6l
      have _ _ _ sf := mp(all_elim(hall, {x6}), h6, h6l)
      have c: int_le(l[x6], x) && int_lt(x, int_add(l[x6], fst(sz[x6]))) -> false proof
        assume hin
        show by taut(hn, mp(all_elim(sf, {x}), (x in omega by simp(hx)), hin))
      qed
      show by taut(c)
    qed
    show := mp(all_elim(hv, {x}), hx, out)
  qed
  show by defs(taut(hb, f2), startup_specs.frame)
qed

theorem sp.fr_store(b, U, objs, W, a, n, v): startup_specs.frame(b, U, objs, W) -> a in bits(64) -> n in omega -> int_le(int_add(a, n), 18446744073709551616) ->
  (all i. i in omega -> int_lt(i, n) -> int_add(a, i) in W || abi.stack_free(b, objs, int_add(a, i))) ->
  startup_specs.frame(b, fn_update(U, "bytes", x86_64_linux.store_le(U.bytes, a, n, v)), objs, W)
proof
  assume hf ha hn hl hw
  have f1 f2 := expand(hf, startup_specs.frame)
  have g1: fn_update(fn_update(U, "bytes", x86_64_linux.store_le(U.bytes, a, n, v)), "bytes", b.bytes) = b :=
    trans(fn_update_twice[f := U, k := "bytes", a := x86_64_linux.store_le(U.bytes, a, n, v), b := b.bytes], f1)
  have g2: all x. x in bits(64) -> !(x in W) -> !abi.stack_free(b, objs, x) -> fn_update(U, "bytes", x86_64_linux.store_le(U.bytes, a, n, v)).bytes[x] = b.bytes[x] proof
    fix x
    assume hx hnw hns
    have ne: all i. i in omega -> int_lt(i, n) -> !(bits_add(64, a, bits_of_int(64, i)) = x) proof
      fix i
      assume hi hil
      have ea := apply(ms.add_i, {a}, {i}, simp(ha), hi, arith(ha, hi, hil, hl))
      have c: bits_add(64, a, bits_of_int(64, i)) = x -> false proof
        assume e
        have e2: int_add(a, i) = x := trans(sym(ea), e)
        show by taut(hnw, hns, rewrite(e2, mp(all_elim(hw, {i}), hi, hil)))
      qed
      show by taut(c)
    qed
    have so := apply(x86.store_outside, {U.bytes}, {a}, {n}, {v}, {x}, hx, ne)
    have e1: fn_update(U, "bytes", x86_64_linux.store_le(U.bytes, a, n, v)).bytes[x] = U.bytes[x] by simp(so)
    show := trans(e1, mp(all_elim(f2, {x}), hx, hnw, hns))
  qed
  show by defs(taut(g1, g2), startup_specs.frame)
qed

theorem sp.fr_out(b, M, U, objs, W, c, m): startup_specs.frame(b, M, objs, W) -> fn_update(U, "bytes", M.bytes) = M ->
  (all x. x in bits(64) -> !(int_le(c, x) && int_lt(x, int_add(c, m))) -> U.bytes[x] = M.bytes[x]) ->
  (all x. x in omega -> int_le(c, x) -> int_lt(x, int_add(c, m)) -> x in W || abi.stack_free(b, objs, x)) ->
  startup_specs.frame(b, U, objs, W)
proof
  assume hf hu ho hw
  have f1 f2 := expand(hf, startup_specs.frame)
  have t1 := fn_update_twice[f := U, k := "bytes", a := M.bytes, b := b.bytes]
  have g1: fn_update(U, "bytes", b.bytes) = b := trans(sym(t1), trans(subst({y. fn_update(fn_update(U, "bytes", M.bytes), "bytes", b.bytes) = fn_update(y, "bytes", b.bytes)}, hu,
    refl({fn_update(fn_update(U, "bytes", M.bytes), "bytes", b.bytes)})), f1))
  have g2: all x. x in bits(64) -> !(x in W) -> !abi.stack_free(b, objs, x) -> U.bytes[x] = b.bytes[x] proof
    fix x
    assume hx hnw hns
    have c: int_le(c, x) && int_lt(x, int_add(c, m)) -> false proof
      assume hin
      have _ _ := hin
      show by taut(hnw, hns, mp(all_elim(hw, {x}), (x in omega by simp(hx)), hin.1, hin.2))
    qed
    have uo := mp(all_elim(ho, {x}), hx, (!(int_le(c, x) && int_lt(x, int_add(c, m))) by taut(c)))
    show := trans(uo, mp(all_elim(f2, {x}), hx, hnw, hns))
  qed
  show by defs(taut(g1, g2), startup_specs.frame)
qed

theorem sp.fr_read(b, U, objs, W, a, n, wr): startup_specs.frame(b, U, objs, W) -> gimple.usable(b, objs, a, n, wr) ->
  (all i. i in omega -> int_lt(i, n) -> !(int_add(a, i) in W)) -> a in omega -> n in omega ->
  gimple.bytes_at(U, a, n) = gimple.bytes_at(b, a, n)
proof
  assume hf hu hw ha hn
  have _ f2 := expand(hf, startup_specs.frame)
  have pe: all i. i in omega -> int_lt(i, n) -> U.bytes[bits_add(64, a, bits_of_int(64, i))] = b.bytes[bits_add(64, a, bits_of_int(64, i))] proof
    fix i
    assume hi hil
    have nf := apply(mp.nofree[vm := b, objs := objs, a := a, n := n, w := wr, i := i], hu, hi, hil)
    have lt := apply(mp.usable_lt[vm := b, objs := objs, a := a, n := n, w := wr, i := i], hu, ha, hi, hil)
    have ea: bits_add(64, a, bits_of_int(64, i)) = int_add(a, i) by defs(arith(ha, hi, lt), bits_add, bits_of_int, pow2)
    have ab: int_add(a, i) in bits(64) by arith(ha, hi, lt)
    show := rewrite(sym(ea), mp(all_elim(f2, {int_add(a, i)}), ab, mp(all_elim(hw, {i}), hi, hil), nf))
  qed
  show := apply(mp.bytes_same[U := U, vm := b, a := a, n := n], hn, pe)
qed

// ----------------------------------------------------------------------
//  __init_libc's outcomes (what its run gives, init_libc_spec's): an
//  overflow, or its frame, libc.auxv past envp's zero word, the thread set
//  up -- its stack objects still live (L), as a function's are at its end

abbrev sp.il_out(g, w, envp, o) := abi.ovf_out(w, o) || sp.ovf_any(w, o) ||
  (ex V fs L. ((V in x86_64_linux.Vm && startup_specs.frame(w.vm, V, w.objs, startup_specs.start_writes(g))) &&
     (all n. n in omega -> startup_specs.env_at(w.vm, w.objs, envp, n) -> gimple.bytes_at(V, bits_add(64, g.libc, 8), 8) = int_add(envp, int_mul(8, int_add(n, 1)))) &&
     fs in bits(64) && startup_specs.thread_at(g, V, fs)) &&
   o = ok(fn_update(fn_update(fn_update(w, "vm", V), "objs", fn_update(w.objs, "live", L)), "fs_base", fs), empty))

// (two frames, the second a callee's -- the same pages, its objects the
// first's or more: one frame)
theorem sp.fr_trans(b1, b2, b3, o1, o2, W): startup_specs.frame(b1, b2, o1, W) -> startup_specs.frame(b2, b3, o2, W) -> b2.pages = b1.pages ->
  (all x. x in o1.live -> x in o2.live) -> startup_specs.frame(b1, b3, o1, W)
proof
  assume f12 f23 hp hl
  have a1 a2 := expand(f12, startup_specs.frame)
  have c1 c2 := expand(f23, startup_specs.frame)
  have t1 := fn_update_twice[f := b3, k := "bytes", a := b2.bytes, b := b1.bytes]
  have g1: fn_update(b3, "bytes", b1.bytes) = b1 := trans(sym(t1), trans(subst({y. fn_update(fn_update(b3, "bytes", b2.bytes), "bytes", b1.bytes) = fn_update(y, "bytes", b1.bytes)}, c1,
    refl({fn_update(fn_update(b3, "bytes", b2.bytes), "bytes", b1.bytes)})), a1))
  have g2: all x. x in bits(64) -> !(x in W) -> !abi.stack_free(b1, o1, x) -> b3.bytes[x] = b1.bytes[x] proof
    fix x
    assume hx hnw hns
    have ns2: !abi.stack_free(b2, o2, x) proof
      have e1 := expand(hns, abi.stack_free)
      have c: (x86_64_linux.mapped(b1, int_div(x, x86_64_linux.PAGE)) && !(snd(b1.pages[int_div(x, x86_64_linux.PAGE)]).kind = 2)) || x in o1.live by taut(e1)
      have d1: x86_64_linux.mapped(b1, int_div(x, x86_64_linux.PAGE)) && !(snd(b1.pages[int_div(x, x86_64_linux.PAGE)]).kind = 2) -> !abi.stack_free(b2, o2, x) proof
        assume h
        show by defs(simp(hp, expand(h, x86_64_linux.mapped)), abi.stack_free, x86_64_linux.mapped)
      qed
      have d2: x in o1.live -> !abi.stack_free(b2, o2, x) proof
        assume h
        have l2 := mp(all_elim(hl, {x}), h)
        show by defs(taut(l2), abi.stack_free)
      qed
      show by taut(c, d1, d2)
    qed
    show := trans(mp(all_elim(c2, {x}), hx, hnw, ns2), mp(all_elim(a2, {x}), hx, hnw, hns))
  qed
  show by defs(taut(g1, g2), startup_specs.frame)
qed

// (a frame within a larger write set)
theorem sp.fr_mono(b, U, o, W1, W2): startup_specs.frame(b, U, o, W1) -> (all x. x in W1 -> x in W2) -> startup_specs.frame(b, U, o, W2)
proof
  assume hf hs
  have a1 a2 := expand(hf, startup_specs.frame)
  have g2: all x. x in bits(64) -> !(x in W2) -> !abi.stack_free(b, o, x) -> U.bytes[x] = b.bytes[x] proof
    fix x
    assume hx hn hns
    have n1: !(x in W1) proof
      assume h
      show by taut(hn, mp(all_elim(hs, {x}), h))
    qed
    show := mp(all_elim(a2, {x}), hx, n1, hns)
  qed
  show by defs(taut(a1, g2), startup_specs.frame)
qed

// (envp's words up to its first zero: their number one)
theorem sp.env_unique(vm, o, e, n1, n2): n1 in omega -> n2 in omega -> startup_specs.env_at(vm, o, e, n1) -> startup_specs.env_at(vm, o, e, n2) -> n1 = n2
proof
  assume h1 h2 e1 e2
  have _ _ _ nz1 z1 := expand(e1, startup_specs.env_at)
  have _ _ _ nz2 z2 := expand(e2, startup_specs.env_at)
  have c1: int_lt(n1, n2) -> false proof
    assume lt
    show by taut(z1, mp(all_elim(nz2, {n1}), h1, lt))
  qed
  have c2: int_lt(n2, n1) -> false proof
    assume lt
    show by taut(z2, mp(all_elim(nz1, {n2}), h2, lt))
  qed
  show by arith(c1, c2, h1, h2)
qed

// ----------------------------------------------------------------------
//  __init_libc's own writes (before its calls): __environ, __hwcap,
//  __sysinfo, libc.auxv, libc.page_size, __progname, __progname_full

def sp.il_writes(g) := set_select(omega, x. x in startup_specs.span(g.environ, 8) || x in startup_specs.span(g.hwcap, 8) ||
  x in startup_specs.span(g.sysinfo, 8) || x in startup_specs.span(bits_add(64, g.libc, 8), 8) || x in startup_specs.span(bits_add(64, g.libc, 48), 8) ||
  x in startup_specs.span(g.progname, 8) || x in startup_specs.span(g.progname_full, 8))

// (a byte in one of the spans: in the set)
theorem sp.il_in: all g x. x in omega -> x in startup_specs.span(g.environ, 8) || x in startup_specs.span(g.hwcap, 8) ||
  x in startup_specs.span(g.sysinfo, 8) || x in startup_specs.span(bits_add(64, g.libc, 8), 8) || x in startup_specs.span(bits_add(64, g.libc, 48), 8) ||
  x in startup_specs.span(g.progname, 8) || x in startup_specs.span(g.progname_full, 8) -> x in sp.il_writes(g)
proof
  fix g x
  assume hx h
  show by defs(sel(taut(hx, h)), sp.il_writes)
qed

theorem sp.il_sub: all g x. g.libc in bits(64) -> int_lt(int_add(g.libc, 56), 18446744073709551616) -> x in sp.il_writes(g) -> x in startup_specs.start_writes(g)
proof
  fix g x
  assume hl hl56 hx
  have xo h := unsel(expand(hx, sp.il_writes))
  have b8: bits_add(64, g.libc, 8) = int_add(g.libc, 8) by defs(arith(hl, hl56), bits_add, bits_of_int, pow2)
  have b48: bits_add(64, g.libc, 48) = int_add(g.libc, 48) by defs(arith(hl, hl56), bits_add, bits_of_int, pow2)
  have s4: x in startup_specs.span(bits_add(64, g.libc, 8), 8) -> x in startup_specs.span(bits_add(64, g.libc, 8), 48) proof
    assume h0
    have a1 a2 := unsel(expand(rewrite(b8, h0), startup_specs.span))
    show by defs(sel(taut(xo, (int_le(bits_add(64, g.libc, 8), x) && int_lt(x, int_add(bits_add(64, g.libc, 8), 48)) by arith(a1, a2, b8, hl)))), startup_specs.span)
  qed
  have s5: x in startup_specs.span(bits_add(64, g.libc, 48), 8) -> x in startup_specs.span(bits_add(64, g.libc, 8), 48) proof
    assume h0
    have a1 a2 := unsel(expand(rewrite(b48, h0), startup_specs.span))
    show by defs(sel(taut(xo, (int_le(bits_add(64, g.libc, 8), x) && int_lt(x, int_add(bits_add(64, g.libc, 8), 48)) by arith(a1, a2, b8, hl)))), startup_specs.span)
  qed
  show by defs(sel(taut(xo, h, s4, s5)), startup_specs.start_writes)
qed

// (the i-th byte of a span: in it)
theorem sp.span_i: all a n i. a in omega -> i in omega -> int_lt(i, n) -> int_add(a, i) in startup_specs.span(a, n)
proof
  fix a n i
  assume ha hi hil
  show by defs(sel(taut((int_add(a, i) in omega by arith(ha, hi)), (int_le(a, int_add(a, i)) && int_lt(int_add(a, i), int_add(a, n)) by arith(ha, hi, hil)))), startup_specs.span)
qed

// (two memories as X but for bytes: each as the other but for bytes)
theorem sp.bytes_rel(U, M, X): fn_update(U, "bytes", X.bytes) = X -> fn_update(M, "bytes", X.bytes) = X -> M in x86_64_linux.Vm ->
  fn_update(U, "bytes", M.bytes) = M
proof
  assume hu hm hv
  have vf: is_fun(M) && "bytes" in dom(M) by simp(hv)
  have t1 := fn_update_twice[f := U, k := "bytes", a := X.bytes, b := M.bytes]
  have t2 := fn_update_twice[f := M, k := "bytes", a := X.bytes, b := M.bytes]
  have e1: fn_update(fn_update(U, "bytes", X.bytes), "bytes", M.bytes) = fn_update(X, "bytes", M.bytes) := subst({y. fn_update(fn_update(U, "bytes", X.bytes), "bytes", M.bytes) = fn_update(y, "bytes", M.bytes)}, hu,
    refl({fn_update(fn_update(U, "bytes", X.bytes), "bytes", M.bytes)}))
  have e2: fn_update(fn_update(M, "bytes", X.bytes), "bytes", M.bytes) = fn_update(X, "bytes", M.bytes) := subst({y. fn_update(fn_update(M, "bytes", X.bytes), "bytes", M.bytes) = fn_update(y, "bytes", M.bytes)}, hm,
    refl({fn_update(fn_update(M, "bytes", X.bytes), "bytes", M.bytes)}))
  have s := mp(fn_update_same[f := M, k := "bytes"], taut(vf), taut(vf))
  show := trans(sym(t1), trans(e1, trans(sym(e2), trans(t2, s))))
qed

// ----------------------------------------------------------------------
//  Preconditions carried across a function's own steps (its memory as the
//  entry's but for bytes, more objects live)

theorem sp.usable_keep(b, U, o, L, a, n, wr): gimple.usable(b, o, a, n, wr) -> fn_update(U, "bytes", b.bytes) = b -> (all x. x in o.live -> x in L) ->
  gimple.usable(U, fn_update(o, "live", L), a, n, wr)
proof
  assume hu hb hl
  have ul := apply(mp.usable_live[vm := b, objs := o, L := L, a := a, n := n, w := wr], hu, hl)
  show := apply(mp.usable_bytes[v := b, v2 := U, objs := fn_update(o, "live", L), a := a, n := n, w := wr], hb, ul)
qed

theorem sp.globals_keep(b, U, o, L, g): startup_specs.globals_ok(b, o, g) -> fn_update(U, "bytes", b.bytes) = b -> (all x. x in o.live -> x in L) ->
  startup_specs.globals_ok(U, fn_update(o, "live", L), g)
proof
  assume hg hb hl
  have hall h1 h2 h3 := expand(hg, startup_specs.globals_ok)
  have e2 := mp(app_update_other[f := U, k := "bytes", v := b.bytes, x := "pages"], (!("pages" = "bytes") by simp()))
  have pe: U.pages = b.pages := sym(rewrite(hb, e2))
  have each: all x. x in omega -> x in startup_specs.start_writes(g) -> ((((gimple.usable(U, fn_update(o, "live", L), x, 1, true) && gimple.usable(U, fn_update(o, "live", L), x, 1, false)) &&
      x86_64_linux.mapped(U, int_div(x, x86_64_linux.PAGE))) && snd(U.pages[int_div(x, x86_64_linux.PAGE)]).prot.r) && snd(U.pages[int_div(x, x86_64_linux.PAGE)]).prot.w) &&
      !abi.stack_page(U, int_div(x, x86_64_linux.PAGE)) proof
    fix x
    assume hx hw
    have u1 u2 m r w2 ns := mp(all_elim(hall, {x}), hx, hw)
    have v1 := apply(sp.usable_keep[b := b, U := U, o := o, L := L, a := x, n := 1, wr := true], u1, hb, hl)
    have v2 := apply(sp.usable_keep[b := b, U := U, o := o, L := L, a := x, n := 1, wr := false], u2, hb, hl)
    have m2: x86_64_linux.mapped(U, int_div(x, x86_64_linux.PAGE)) by defs(simp(pe, expand(m, x86_64_linux.mapped)), x86_64_linux.mapped)
    have ns2: !abi.stack_page(U, int_div(x, x86_64_linux.PAGE)) by defs(simp(pe, expand(ns, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
    have r2: snd(U.pages[int_div(x, x86_64_linux.PAGE)]).prot.r by simp(pe, r)
    have w3: snd(U.pages[int_div(x, x86_64_linux.PAGE)]).prot.w by simp(pe, w2)
    show by taut(v1, v2, m2, r2, w3, ns2)
  qed
  show by defs(taut(each, h1, h2, h3), startup_specs.globals_ok)
qed

// (each byte usable: the bytes usable)
theorem sp.usable_of_bytes(vm, o, a, n, wr): a in omega -> (all i. i in omega -> int_lt(i, n) -> gimple.usable(vm, o, int_add(a, i), 1, wr)) -> gimple.usable(vm, o, a, n, wr)
proof
  assume ha h
  let P(i) := int_div(int_add(a, i), x86_64_linux.PAGE)
  have each: all i. i in omega -> int_lt(i, n) -> ite(x86_64_linux.mapped(vm, P(i)) && !(snd(vm.pages[P(i)]).kind = 2),
      ite(wr, snd(vm.pages[P(i)]).prot.w, snd(vm.pages[P(i)]).prot.r) && int_add(a, i) in o.c_bytes, int_lt(int_add(a, i), int_pow(2, 64)) && int_add(a, i) in o.live) proof
    fix i
    assume hi hil
    have u := mp(all_elim(expand(mp(all_elim(h, {i}), hi, hil), gimple.usable), {0}), simp(), simp())
    have z: int_add(int_add(a, i), 0) = int_add(a, i) by arith(ha, hi)
    show := rewrite(z, u)
  qed
  show by defs(each, gimple.usable)
qed

// aux[j] after the first k pairs of the auxiliary vector AX: the value of
// a pair with key j among them, else 0
def sp.aux_val(AX, k, j, v) := (ex m. (m in omega && int_lt(m, k)) && fst(AX[m]) = j && snd(AX[m]) = v) ||
  (!(ex m. (m in omega && int_lt(m, k)) && fst(AX[m]) = j) && v = 0)

theorem sp.aux_val0: all AX j. sp.aux_val(AX, 0, j, 0)
proof
  fix AX j
  have n: !(ex m. (m in omega && int_lt(m, 0)) && fst(AX[m]) = j) proof
    assume h
    obtain m, hm hl _ from h
    show by arith(hm, hl)
  qed
  show by defs(taut(n, refl({0})), sp.aux_val)
qed

theorem sp.aux_hit: all AX k j. k in omega -> fst(AX[k]) = j -> sp.aux_val(AX, int_add(k, 1), j, snd(AX[k]))
proof
  fix AX k j
  assume hk he
  have e: ex m. (m in omega && int_lt(m, int_add(k, 1))) && fst(AX[m]) = j && snd(AX[m]) = snd(AX[k])
    by ex_intro({k}, taut(hk, (int_lt(k, int_add(k, 1)) by arith(hk)), he, refl({snd(AX[k])})))
  show by defs(taut(e), sp.aux_val)
qed

theorem sp.aux_miss: all AX k j v. k in omega -> !(fst(AX[k]) = j) -> sp.aux_val(AX, k, j, v) -> sp.aux_val(AX, int_add(k, 1), j, v)
proof
  fix AX k j v
  assume hk hn ha
  have c1: (ex m. (m in omega && int_lt(m, k)) && fst(AX[m]) = j && snd(AX[m]) = v) -> sp.aux_val(AX, int_add(k, 1), j, v) proof
    assume h
    obtain m, hm hl h1 h2 from h
    have e: ex m. (m in omega && int_lt(m, int_add(k, 1))) && fst(AX[m]) = j && snd(AX[m]) = v
      by ex_intro({m}, taut(hm, (int_lt(m, int_add(k, 1)) by arith(hl)), h1, h2))
    show by defs(taut(e), sp.aux_val)
  qed
  have c2: !(ex m. (m in omega && int_lt(m, k)) && fst(AX[m]) = j) -> v = 0 -> sp.aux_val(AX, int_add(k, 1), j, v) proof
    assume hno hv
    have n: !(ex m. (m in omega && int_lt(m, int_add(k, 1))) && fst(AX[m]) = j) proof
      assume h
      obtain m, hm hl h1 from h
      have c: int_lt(m, k) || m = k by arith(hl, hm, hk)
      have d1: int_lt(m, k) -> false proof
        assume lt
        have e: ex m. (m in omega && int_lt(m, k)) && fst(AX[m]) = j by ex_intro({m}, taut(hm, lt, h1))
        show by taut(e, hno)
      qed
      have d2: m = k -> false proof
        assume eq
        show by taut(hn, rewrite(eq, h1))
      qed
      show by taut(c, d1, d2)
    qed
    show by defs(taut(n, hv), sp.aux_val)
  qed
  show by taut(expand(ha, sp.aux_val), c1, c2)
qed

// (the copy's aux[key], key not AT_NULL's: the vector's value for it, or 0
// -- aux_is's, the keys each once)
theorem sp.aux_val_is(AX, k, key, v, v2): int_add(k, 1) = seq_len(AX) -> k in omega ->
  (all a b. a in omega -> b in omega -> int_lt(a, seq_len(AX)) -> int_lt(b, seq_len(AX)) -> fst(AX[a]) = fst(AX[b]) -> a = b) ->
  !(key = 0) -> fst(AX[k]) = 0 -> sp.aux_val(AX, k, key, v) -> startup_specs.aux_is(AX, key, v2) -> v = v2
proof
  assume hk ho hu hn hz hv hi
  have c1: (ex m. (m in omega && int_lt(m, k)) && fst(AX[m]) = key && snd(AX[m]) = v) -> v = v2 proof
    assume e
    obtain m, hm hml hmk hmv from e
    have d1: (ex x0. x0 in omega && ((int_lt(x0, seq_len(AX)) && fst(AX[x0]) = key) && snd(AX[x0]) = v2)) -> v = v2 proof
      assume e2
      obtain j, hj hjl hjk hjv from e2
      have mj: m = j := mp(all_elim(hu, {m}, {j}), hm, hj, arith(hml, hk, ho), hjl, trans(hmk, sym(hjk)))
      show := trans(sym(hmv), rewrite(sym(mj), hjv))
    qed
    have d2: !(ex x0. x0 in omega && (int_lt(x0, seq_len(AX)) && fst(AX[x0]) = key)) -> v = v2 proof
      assume n2
      have e3: ex x0. x0 in omega && (int_lt(x0, seq_len(AX)) && fst(AX[x0]) = key) by ex_intro({m}, taut(hm, (int_lt(m, seq_len(AX)) by arith(hml, hk, ho)), hmk))
      show by taut(n2, e3)
    qed
    show by taut(expand(hi, startup_specs.aux_is), d1, d2)
  qed
  have c2: !(ex m. (m in omega && int_lt(m, k)) && fst(AX[m]) = key) && v = 0 -> v = v2 proof
    assume e
    have nm v0 := e
    have d1: (ex x0. x0 in omega && ((int_lt(x0, seq_len(AX)) && fst(AX[x0]) = key) && snd(AX[x0]) = v2)) -> v = v2 proof
      assume e2
      obtain j, hj hjl hjk _ from e2
      have jk: !(j = k) proof
        assume e3
        show by taut(hn, trans(sym(hjk), rewrite(sym(e3), hz)))
      qed
      have e4: ex m. (m in omega && int_lt(m, k)) && fst(AX[m]) = key by ex_intro({j}, taut(hj, (int_lt(j, k) by arith(hjl, hk, jk, hj, ho)), hjk))
      show by taut(nm, e4)
    qed
    have d2: (!(ex x0. x0 in omega && (int_lt(x0, seq_len(AX)) && fst(AX[x0]) = key)) && v2 = 0) -> v = v2 proof
      assume e2
      have _ z2 := e2
      show := trans(v0, sym(z2))
    qed
    show by taut(expand(hi, startup_specs.aux_is), d1, d2)
  qed
  show by taut(expand(hv, sp.aux_val), c1, c2)
qed

// (the program headers: as at the entry -- none of their bytes written)
theorem sp.phdrs_keep(b, U, o, L, ph, pe, pn, W, IW): startup_specs.phdrs_ok(b, o, ph, pe, pn, W) -> startup_specs.frame(b, U, o, IW) ->
  (all x. x in IW -> x in W) -> (all x. x in o.live -> x in L) -> ph in omega -> pe in omega -> pn in omega ->
  startup_specs.phdrs_ok(U, fn_update(o, "live", L), ph, pe, pn, W)
proof
  assume hp hf hs hl hph hpe hpn
  have hb _ := expand(hf, startup_specs.frame)
  have bd hall := expand(hp, startup_specs.phdrs_ok)
  have each: all i. i in omega -> int_lt(i, pn) -> ((!(int_add(ph, int_mul(pe, i)) = 0) && gimple.usable(U, fn_update(o, "live", L), int_add(ph, int_mul(pe, i)), 56, false)) &&
      !(gimple.bytes_at(U, bits_of_int(64, int_add(ph, int_mul(pe, i))), 4) = startup_specs.PT_TLS)) &&
      (all j. j in omega -> int_lt(j, 56) -> !(int_add(int_add(ph, int_mul(pe, i)), j) in W)) proof
    fix i
    assume hi hil
    have anz u nt nw := mp(all_elim(hall, {i}), hi, hil)
    let A := int_add(ph, int_mul(pe, i))
    have ao: A in omega by arith(hph, hpe, hi)
    have ml := apply(ms.mul_le, {pe}, {i}, {pe}, {pn}, hpe, hi, simp(hpe), simp(hpn), arith(hpe), arith(hil))
    have al: int_lt(A, 18446744073709551616) by arith(bd, hph, hpe, hi, ml)
    have ab: bits_of_int(64, A) = A := apply(mp.boi[x := A], ao, al)
    have u2 := apply(sp.usable_keep[b := b, U := U, o := o, L := L, a := A, n := 56, wr := false], u, hb, hl)
    have u4 := apply(mp.usable_sub[vm := b, objs := o, a := A, n := 56, k := 0, m := 4, w := false], simp(), simp(), simp(), u)
    have z: int_add(A, 0) = A by arith(ao)
    have niw: all j. j in omega -> int_lt(j, 4) -> !(int_add(A, j) in IW) proof
      fix j
      assume hj hjl
      have n := mp(all_elim(nw, {j}), hj, arith(hjl))
      have c: int_add(A, j) in IW -> false proof
        assume h
        show by taut(n, mp(all_elim(hs, {int_add(A, j)}), h))
      qed
      show by taut(c)
    qed
    have rd := apply(sp.fr_read[b := b, U := U, objs := o, W := IW, a := A, n := 4, wr := false], hf, rewrite(z, u4), niw, ao, simp())
    have nt2: !(gimple.bytes_at(U, bits_of_int(64, A), 4) = startup_specs.PT_TLS) := rewrite(sym(ab), rewrite(sym(rd), rewrite(ab, nt)))
    show by taut(anz, u2, nt2, nw)
  qed
  show by defs(taut(bd, each), startup_specs.phdrs_ok)
qed

// (libc's bytes from 8 on -- auxv, the TLS fields, the page size -- and
// main_tls's: startup writes them)
theorem sp.sw_libc8: all g x. g.libc in bits(64) -> int_lt(int_add(g.libc, 56), 18446744073709551616) -> x in omega ->
  int_le(int_add(g.libc, 8), x) -> int_lt(x, int_add(g.libc, 56)) -> x in startup_specs.start_writes(g)
proof
  fix g x
  assume hl hl56 hx h1 h2
  have b8: bits_add(64, g.libc, 8) = int_add(g.libc, 8) by defs(arith(hl, hl56), bits_add, bits_of_int, pow2)
  have sp: x in startup_specs.span(bits_add(64, g.libc, 8), 48) by defs(sel(taut(hx, rewrite(sym(b8), h1), (int_lt(x, int_add(bits_add(64, g.libc, 8), 48)) by arith(b8, h2)))),
    startup_specs.span)
  show by defs(sel(taut(hx, sp)), startup_specs.start_writes)
qed

theorem sp.sw_libc: all g i. g.libc in bits(64) -> int_lt(int_add(g.libc, 56), 18446744073709551616) -> i in omega -> int_le(8, i) -> int_lt(i, 56) ->
  int_add(g.libc, i) in startup_specs.start_writes(g)
proof
  fix g i
  assume hl hl56 hi h8 hil
  show := apply(sp.sw_libc8, {g}, {int_add(g.libc, i)}, hl, hl56, arith(hl, hi), arith(h8), arith(hil))
qed

theorem sp.sw_main: all g i. g.main_tls in omega -> i in omega -> int_lt(i, 48) -> int_add(g.main_tls, i) in startup_specs.start_writes(g)
proof
  fix g i
  assume hb hi hil
  have sp := apply(sp.span_i, {g.main_tls}, {48}, {i}, hb, hi, hil)
  show by defs(sel(taut((int_add(g.main_tls, i) in omega by arith(hb, hi)), sp)), startup_specs.start_writes)
qed

// (a byte of a span: within it)
theorem sp.span_e: all a n x. x in startup_specs.span(a, n) -> int_le(a, x) && int_lt(x, int_add(a, n))
proof
  fix a n x
  assume h
  have _ e := unsel(expand(h, startup_specs.span))
  show := e
qed

// (a byte before or after a span: not in it)
theorem sp.span_out: all a n x. int_lt(x, a) || int_le(int_add(a, n), x) -> !(x in startup_specs.span(a, n))
proof
  fix a n x
  assume h
  have c: x in startup_specs.span(a, n) -> false proof
    assume hin
    have e := apply(sp.span_e, {a}, {n}, {x}, hin)
    show by arith(e, h)
  qed
  show by taut(c)
qed

// (a byte in none of __init_libc's seven spans: not its write)
theorem sp.il_not: all g x. !(x in startup_specs.span(g.environ, 8)) -> !(x in startup_specs.span(g.hwcap, 8)) -> !(x in startup_specs.span(g.sysinfo, 8)) ->
  !(x in startup_specs.span(bits_add(64, g.libc, 8), 8)) -> !(x in startup_specs.span(bits_add(64, g.libc, 48), 8)) ->
  !(x in startup_specs.span(g.progname, 8)) -> !(x in startup_specs.span(g.progname_full, 8)) -> !(x in sp.il_writes(g))
proof
  fix g x
  assume n1 n2 n3 n4 n5 n6 n7
  have c: x in sp.il_writes(g) -> false proof
    assume hx
    have _ h := unsel(expand(hx, sp.il_writes))
    show by taut(h, n1, n2, n3, n4, n5, n6, n7)
  qed
  show by taut(c)
qed

// (a call from a function with stack objects: the call's outcomes)
theorem sp.call0_objs_e: all objs g args s o. runs(gimple.call0_objs(objs, g, args), s, o) -> runs(gimple.call0(g, args), s, o)
proof
  fix objs g args s o
  assume h
  have b := apply(g.runs_elim, expand(h, gimple.call0_objs))
  obtain o3, hr hd from expand(b, bind_rel)
  have c1: (ex x0 x1. o3 = ok(x0, x1) && o = ok(x0, x1)) -> o3 = o proof
    assume e
    obtain x0 x1, e1 e2 from e
    show := trans(e1, sym(e2))
  qed
  have c2: (ex x0 x1. o3 = exc(x0, x1) && o = exc(x0, x1)) -> o3 = o proof
    assume e
    obtain x0 x1, e1 e2 from e
    show := trans(e1, sym(e2))
  qed
  have c3: (ex x0. o3 = diverge(x0) && o = diverge(x0)) -> o3 = o proof
    assume e
    obtain x0, e1 e2 from e
    show := trans(e1, sym(e2))
  qed
  have eo: o3 = o by taut(hd, c1, c2, c3)
  show := rewrite(eo, hr)
qed

// (a world as another but for its memory and objects: their overflows'
// worlds the same)
theorem sp.ovf_norm: all s A B f v ob. fn_update(fn_update(fn_update(fn_update(fn_update(s, "vm", A), "objs", B), "fs_base", f), "vm", v), "objs", ob) =
  fn_update(fn_update(fn_update(s, "fs_base", f), "vm", v), "objs", ob)
proof
  fix s A B f v ob
  show by simp()
qed

// (the callees' writes: startup's)
theorem sp.tls_sub: all g x. g.libc in bits(64) -> int_lt(int_add(g.libc, 56), 18446744073709551616) -> x in startup_specs.tls_writes(g) -> x in startup_specs.start_writes(g)
proof
  fix g x
  assume hl hl56 hx
  have xo h := unsel(expand(hx, startup_specs.tls_writes))
  have b16: bits_add(64, g.libc, 16) = int_add(g.libc, 16) by defs(arith(hl, hl56), bits_add, bits_of_int, pow2)
  have b8: bits_add(64, g.libc, 8) = int_add(g.libc, 8) by defs(arith(hl, hl56), bits_add, bits_of_int, pow2)
  have s2: x in startup_specs.span(bits_add(64, g.libc, 16), 32) -> x in startup_specs.span(bits_add(64, g.libc, 8), 48) proof
    assume h0
    have a1 := apply(sp.span_e, {bits_add(64, g.libc, 16)}, {32}, {x}, h0)
    show by defs(sel(taut(xo, (int_le(bits_add(64, g.libc, 8), x) && int_lt(x, int_add(bits_add(64, g.libc, 8), 48)) by arith(a1, b16, b8, hl)))), startup_specs.span)
  qed
  show by defs(sel(taut(xo, h, s2)), startup_specs.start_writes)
qed

theorem sp.ssp_sub: all g x. x in startup_specs.ssp_writes(g) -> x in startup_specs.start_writes(g)
proof
  fix g x
  assume hx
  have xo h := unsel(expand(hx, startup_specs.ssp_writes))
  show by defs(sel(taut(xo, h)), startup_specs.start_writes)
qed

// (as B but for bytes, B as C but for bytes: as C but for bytes)
theorem sp.bytes_trans(A, B, C): fn_update(A, "bytes", B.bytes) = B -> fn_update(B, "bytes", C.bytes) = C -> fn_update(A, "bytes", C.bytes) = C
proof
  assume h1 h2
  have t := fn_update_twice[f := A, k := "bytes", a := B.bytes, b := C.bytes]
  have e := subst({y. fn_update(fn_update(A, "bytes", B.bytes), "bytes", C.bytes) = fn_update(y, "bytes", C.bytes)}, h1, refl({fn_update(fn_update(A, "bytes", B.bytes), "bytes", C.bytes)}))
  show := trans(sym(t), trans(e, h2))
qed

// (a world with another thread pointer, other objects: a world)
theorem sp.world_fs(s, f): s in abi.World -> s in univ(1) -> f in bits(64) -> fn_update(s, "fs_base", f) in abi.World && fn_update(s, "fs_base", f) in univ(1)
proof
  assume hw hu hf
  have fu: f in univ(1) by simp(hf)
  have wW: fn_update(s, "fs_base", f) in abi.World by defs(simp(expand(hw, abi.World), hu, hf, fu), abi.World)
  show by taut(wW, (fn_update(s, "fs_base", f) in univ(1) by simp(hu, fu)))
qed

theorem sp.world_objs(s, ob): s in abi.World -> s in univ(1) -> ob in abi.Objs -> fn_update(s, "objs", ob) in abi.World && fn_update(s, "objs", ob) in univ(1)
proof
  assume hw hu ho
  have ou := apply(ct.objs_univ, ho)
  have wW: fn_update(s, "objs", ob) in abi.World by defs(simp(expand(hw, abi.World), hu, ho, ou), abi.World)
  show by taut(wW, (fn_update(s, "objs", ob) in univ(1) by simp(hu, ou)))
qed

// (the copy's aux[key]: aux_is's value for key -- key not AT_NULL's)
theorem sp.aux_val_to_is(AX, k, key, v): int_add(k, 1) = seq_len(AX) -> k in omega -> !(key = 0) -> fst(AX[k]) = 0 -> sp.aux_val(AX, k, key, v) ->
  startup_specs.aux_is(AX, key, v)
proof
  assume hk ho hn hz hv
  have c1: (ex m. (m in omega && int_lt(m, k)) && fst(AX[m]) = key && snd(AX[m]) = v) -> startup_specs.aux_is(AX, key, v) proof
    assume e
    obtain m, hm hml hmk hmv from e
    have x: ex x0. x0 in omega && ((int_lt(x0, seq_len(AX)) && fst(AX[x0]) = key) && snd(AX[x0]) = v) by ex_intro({m}, taut(hm, (int_lt(m, seq_len(AX)) by arith(hml, hk, ho)), hmk, hmv))
    show by defs(taut(x), startup_specs.aux_is)
  qed
  have c2: !(ex m. (m in omega && int_lt(m, k)) && fst(AX[m]) = key) && v = 0 -> startup_specs.aux_is(AX, key, v) proof
    assume e
    have nm v0 := e
    have n2: !(ex x0. x0 in omega && (int_lt(x0, seq_len(AX)) && fst(AX[x0]) = key)) proof
      assume e2
      obtain j, hj hjl hjk from e2
      have jk: !(j = k) proof
        assume e3
        show by taut(hn, trans(sym(hjk), rewrite(sym(e3), hz)))
      qed
      have e4: ex m. (m in omega && int_lt(m, k)) && fst(AX[m]) = key by ex_intro({j}, taut(hj, (int_lt(j, k) by arith(hjl, hk, jk, hj, ho)), hjk))
      show by taut(nm, e4)
    qed
    show by defs(taut(n2, v0), startup_specs.aux_is)
  qed
  show by taut(expand(hv, sp.aux_val), c1, c2)
qed

// (aux_is: one value per key, the keys each once)
theorem sp.aux_is_fun(AX, key, a, b): (all x y. x in omega -> y in omega -> int_lt(x, seq_len(AX)) -> int_lt(y, seq_len(AX)) -> fst(AX[x]) = fst(AX[y]) -> x = y) ->
  startup_specs.aux_is(AX, key, a) -> startup_specs.aux_is(AX, key, b) -> a = b
proof
  assume hu ha hb
  have c11: (ex x0. x0 in omega && ((int_lt(x0, seq_len(AX)) && fst(AX[x0]) = key) && snd(AX[x0]) = a)) ->
      (ex x0. x0 in omega && ((int_lt(x0, seq_len(AX)) && fst(AX[x0]) = key) && snd(AX[x0]) = b)) -> a = b proof
    assume e1 e2
    obtain i, hi hil hik hia from e1
    obtain j, hj hjl hjk hjb from e2
    have ij := mp(all_elim(hu, {i}, {j}), hi, hj, hil, hjl, trans(hik, sym(hjk)))
    show := trans(sym(hia), rewrite(sym(ij), hjb))
  qed
  have n1: (ex x0. x0 in omega && ((int_lt(x0, seq_len(AX)) && fst(AX[x0]) = key) && snd(AX[x0]) = a)) ->
      !(ex x0. x0 in omega && (int_lt(x0, seq_len(AX)) && fst(AX[x0]) = key)) -> false proof
    assume e1 n
    obtain i, hi hil hik _ from e1
    have e3: ex x0. x0 in omega && (int_lt(x0, seq_len(AX)) && fst(AX[x0]) = key) by ex_intro({i}, taut(hi, hil, hik))
    show by taut(n, e3)
  qed
  have n2: (ex x0. x0 in omega && ((int_lt(x0, seq_len(AX)) && fst(AX[x0]) = key) && snd(AX[x0]) = b)) ->
      !(ex x0. x0 in omega && (int_lt(x0, seq_len(AX)) && fst(AX[x0]) = key)) -> false proof
    assume e1 n
    obtain i, hi hil hik _ from e1
    have e3: ex x0. x0 in omega && (int_lt(x0, seq_len(AX)) && fst(AX[x0]) = key) by ex_intro({i}, taut(hi, hil, hik))
    show by taut(n, e3)
  qed
  have c22: (!(ex x0. x0 in omega && (int_lt(x0, seq_len(AX)) && fst(AX[x0]) = key)) && a = 0) ->
      (!(ex x0. x0 in omega && (int_lt(x0, seq_len(AX)) && fst(AX[x0]) = key)) && b = 0) -> a = b proof
    assume e1 e2
    show := trans(e1.2, sym(e2.2))
  qed
  show by taut(expand(ha, startup_specs.aux_is), expand(hb, startup_specs.aux_is), c11, n1, n2, c22)
qed
