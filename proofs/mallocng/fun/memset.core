                  have c9 := apply(mz.st_lit[Q := t. P8(t)], {B8}, {w.vm.bytes}, {d}, {n}, {k}, {15}, {8}, {V}, c8, hd, simp(), simp(), (int_le(int_add(15, 8), n) by arith(h31)), nb, dg8, l15)
