  int_le(0, int_add(p, g.sv64(off))) -> int_lt(int_add(p, g.sv64(off)), pow2(64)) -> gimple.usable(s.vm, s.objs, bits_add(64, p, off), 8, true) ->
  g.det(gimple.st64(p, off, v), s, ok(fn_update(s, "vm", fn_update(s.vm, "bytes", x86_64_linux.store_le(s.vm.bytes, bits_add(64, p, off), 8, v))), empty))
