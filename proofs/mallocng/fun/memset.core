              have c6 := apply(mz.st_sub[Q := t. P5(t)], {B5}, {w.vm.bytes}, {d}, {n}, {k}, {7}, {4}, {bits_of_int(32, V)}, c5, hd, hn, simp(), simp(), simp(), h7, dg4)
              // (7 to 14: two more, of 4 bytes)
