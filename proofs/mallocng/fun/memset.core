            have c4 := apply(mz.st_sub[Q := t. P3(t)], {B3}, {w.vm.bytes}, {d}, {n}, {k}, {3}, {2}, {bits_of_int(16, V)}, c3, hd, hn, simp(), simp(), simp(), h3, dg2)
