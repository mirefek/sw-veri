// (at a computed offset: the definedness's parts premises of their own --
// not null, in range, usable -- each discharged where step meets them)
theorem mz.st8_s_det: all s p off v. s in abi.World -> s in univ(1) -> p in bits(64) -> off in bits(64) -> !(p = 0) ->
  int_le(0, int_add(p, g.sv64(off))) -> int_lt(int_add(p, g.sv64(off)), pow2(64)) -> gimple.usable(s.vm, s.objs, bits_add(64, p, off), 1, true) ->
  g.det(gimple.st8(p, off, v), s, ok(fn_update(s, "vm", fn_update(s.vm, "bytes", x86_64_linux.store_le(s.vm.bytes, bits_add(64, p, off), 1, v))), empty))
proof
  fix s p off v
  assume hW hs hp ho h0 h1 h2 h3
  have a b c _ := apply(ms.world_parts, hW)
  show := apply(g.st8_s_det, {s}, {p}, {off}, {v}, hs, hp, ho, taut(h0, h1, h2, h3), a, b, c)
qed

