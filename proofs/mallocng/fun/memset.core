// (a store within the n usable bytes at d (no wrap): at the literal
// offset o -- in range, usable; at n - j -- its signed offset, usable)
theorem mz.lit_ok: all vm objs d n o m. d in bits(64) -> gimple.usable(vm, objs, d, n, true) -> int_le(int_add(d, n), 18446744073709551616) ->
  o in omega -> m in omega -> int_le(1, m) -> int_le(int_add(o, m), n) ->
  int_lt(int_add(d, o), pow2(64)) && gimple.usable(vm, objs, int_add(d, o), m, true)
proof
  fix vm objs d n o m
  assume hd hu hdn ho hm h1 hl
  have u := mp(mp.usable_sub[vm := vm, objs := objs, a := d, n := n, k := o, m := m, w := true], ho, hm, hl, hu)
  have l: int_lt(int_add(d, o), pow2(64)) by arith(hdn, hl, h1, (pow2(64) = 18446744073709551616 by simp()))
  show by taut(l, u)
qed

theorem mz.sub_ok: all vm objs d n j m. d in bits(64) -> n in bits(64) -> gimple.usable(vm, objs, d, n, true) -> int_le(int_add(d, n), 18446744073709551616) -> int_lt(n, 9223372036854775808) ->
  j in omega -> m in omega -> int_le(1, m) -> int_le(m, j) -> int_le(j, n) ->
  int_le(0, int_add(d, g.sv64(bits_sub(64, n, j)))) && int_lt(int_add(d, g.sv64(bits_sub(64, n, j))), pow2(64)) &&
  gimple.usable(vm, objs, bits_add(64, d, bits_sub(64, n, j)), m, true)
proof
  fix vm objs d n j m
  assume hd hn hu hdn hn63 hj hm h1 hmj hjn
  have n0: n in omega by simp(hn)
  have d0: d in omega by simp(hd)
  have sj: bits_sub(64, n, j) = int_sub(n, j) := apply(x86.bsub_nowrap, {n}, {j}, n0, hj, hjn, (int_lt(n, 18446744073709551616) by arith(hn63)))
  have nj: int_sub(n, j) in omega by arith(hjn)
  have sv: gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), bits_sub(64, n, j)) = int_sub(n, j) by simp(sj, apply(g.sval64_lit, {int_sub(n, j)}, nj, (int_lt(int_sub(n, j), 9223372036854775808) by arith(hn63, hj))))
  have ua := mp(mp.usable_sub[vm := vm, objs := objs, a := d, n := n, k := int_sub(n, j), m := m, w := true], nj, hm, (int_le(int_add(int_sub(n, j), m), n) by arith(hmj)), hu)
  have ad: bits_add(64, d, bits_sub(64, n, j)) = int_add(d, int_sub(n, j)) by simp(sj, apply(x86.add_nowrap, {d}, {int_sub(n, j)}, d0, nj, (int_lt(int_add(d, int_sub(n, j)), 18446744073709551616) by arith(hdn, hmj, hj, h1, hjn))))
  have us: gimple.usable(vm, objs, bits_add(64, d, bits_sub(64, n, j)), m, true) by simp(ad, ua)
  have r0: int_le(0, int_add(d, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), bits_sub(64, n, j)))) := rewrite(sym(sv), (int_le(0, int_add(d, int_sub(n, j))) by arith(d0, hjn)))
  have r1: int_lt(int_add(d, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), bits_sub(64, n, j))), pow2(64)) :=
    rewrite(sym(sv), (int_lt(int_add(d, int_sub(n, j)), pow2(64)) by arith(hdn, hmj, h1, (pow2(64) = 18446744073709551616 by simp()))))
  show by taut(r0, r1, us)
qed

// (the bytes covered: fewer offsets, still covered)
theorem mz.cov_mono(t. P, t. Q): all b B d n k. mz.cov(b, B, d, n, k, t. P(t)) -> (all t. t in omega -> int_lt(t, n) -> Q(t) -> P(t)) -> mz.cov(b, B, d, n, k, t. Q(t))
proof
  fix b B d n k
  assume hc hq
  have hb hout hin := expand(hc, mz.cov)
  have inn: all x. x in bits(64) -> int_lt(bits_sub(64, x, d), n) -> Q(bits_sub(64, x, d)) -> b[x] = k proof
    fix x
    assume hx hl hqx
    have to: bits_sub(64, x, d) in omega by defs(simp(), bits_sub)
    show := mp(all_elim(hin, {x}), hx, hl, mp(all_elim(hq, {bits_sub(64, x, d)}), to, hl, hqx))
  qed
  show by defs(taut(hb, hout, inn), mz.cov)
qed

// (a store at d + o, o literal, and at d + (n - j): the bytes covered)
theorem mz.st_lit(t. Q): all b B d n k o m v. mz.cov(b, B, d, n, k, t. Q(t)) -> d in bits(64) -> o in omega -> m in omega -> int_le(int_add(o, m), n) ->
  int_le(n, 18446744073709551616) -> mz.digs(v, m, k) -> int_lt(int_add(d, o), pow2(64)) ->
  mz.cov(x86_64_linux.store_le(b, int_add(d, o), m, v), B, d, n, k, t. Q(t) || (int_le(o, t) && int_lt(t, int_add(o, m))))
proof
  fix b B d n k o m v
  assume hc hd ho hm hl hn hv hlt
  have d0: d in omega by simp(hd)
  have a: int_add(d, o) = bits_add(64, d, o) := sym(apply(x86.add_nowrap, {d}, {o}, d0, ho, (int_lt(int_add(d, o), 18446744073709551616) by arith(hlt, (pow2(64) = 18446744073709551616 by simp())))))
  show := apply(mz.cov_store[P := t. Q(t)], {b}, {B}, {d}, {n}, {k}, {o}, {m}, {v}, {int_add(d, o)}, hc, hd, ho, hm, hl, hn, hv, a)
qed

theorem mz.st_sub(t. Q): all b B d n k j m v. mz.cov(b, B, d, n, k, t. Q(t)) -> d in bits(64) -> n in bits(64) -> j in omega -> m in omega -> int_le(m, j) -> int_le(j, n) ->
  mz.digs(v, m, k) ->
  mz.cov(x86_64_linux.store_le(b, bits_add(64, d, bits_sub(64, n, j)), m, v), B, d, n, k, t. Q(t) || (int_le(int_sub(n, j), t) && int_lt(t, int_add(int_sub(n, j), m))))
proof
  fix b B d n k j m v
  assume hc hd hn hj hm hmj hjn hv
  have n0: n in omega by simp(hn)
  have sj: bits_sub(64, n, j) = int_sub(n, j) := apply(x86.bsub_nowrap, {n}, {j}, n0, hj, hjn, (int_lt(n, 18446744073709551616) by simp(hn)))
  have so: int_sub(n, j) in omega by arith(hjn)
  have c := apply(mz.cov_store[P := t. Q(t)], {b}, {B}, {d}, {n}, {k}, {int_sub(n, j)}, {m}, {v}, {bits_add(64, d, bits_sub(64, n, j))}, hc, hd, so, hm,
    (int_le(int_add(int_sub(n, j), m), n) by arith(hmj)), (int_le(n, 18446744073709551616) by simp(hn)), hv, (bits_add(64, d, bits_sub(64, n, j)) = bits_add(64, d, int_sub(n, j)) by simp(sj)))
  show := c
qed

// (a dword's low 4 bits: it mod 16)
theorem mz.low4: all y. y in bits(32) -> bits_and(32, y, 15) = int_mod(y, 16)
proof
  fix y
  assume hy
  have y0: y in omega by simp(hy)
  have p4: pow2(4) = 16 by simp()
  have m15: int_sub(pow2(4), 1) = 15 by simp()
  have mb: int_mod(y, pow2(4)) in bits(32) by arith(y0, p4)
  have e0: bits_and(32, bits_of_int(32, y), int_sub(pow2(4), 1)) = int_mod(y, pow2(4)) by bitwise({32}, y0, mb)
  have b32: bits_of_int(32, y) = y by defs(simp(hy), bits_of_int)
  show := rewrite(b32, rewrite(p4, rewrite(m15, e0)))
qed

// ----------------------------------------------------------------------
//  memset by its purpose

// the world the spec makes: each of the n bytes at d c's low byte
abbrev mz.fw(w, d, n, c) := fn_update(w, "vm", fn_update(w.vm, "bytes", fn_build(bits(64), x. ite(int_lt(bits_sub(64, x, d), n), bits_of_int(8, c), w.vm.bytes[x]))))

theorem mz.memset_spec_ok: all w d c n. w in abi.World -> w in univ(1) -> d in bits(64) -> c in bits(64) -> n in bits(64) ->
  !(d = 0) -> int_lt(n, 9223372036854775808) -> gimple.usable(w.vm, w.objs, d, n, true) ->
  runs(mallocng_specs.memset_spec(d, c, n), w, ok(mz.fw(w, d, n, c), d))
proof
  fix w d c n
  assume hW hu hd hc hn hnz hn63 hus
  have _ _ _ bm := apply(ms.world_parts, hW)
  have fb := mp(fn_build_space[d := bits(64), v := x. ite(int_lt(bits_sub(64, x, d), n), bits_of_int(8, c), w.vm.bytes[x]), b := bits(8)],
    (all x. x in bits(64) -> ite(int_lt(bits_sub(64, x, d), n), bits_of_int(8, c), w.vm.bytes[x]) in bits(8) by simp(bm)))
  have ws wu := apply(tr.world_store, {w}, {d}, {0}, {0}, hW, hu, hd)
  have vu: w.vm in univ(1) by simp(hu)
  have fu := apply(fn_space_univ, bits_univ[n := 64], bits_univ[n := 8], fb)
  have nu: fn_update(w.vm, "bytes", fn_build(bits(64), x. ite(int_lt(bits_sub(64, x, d), n), bits_of_int(8, c), w.vm.bytes[x]))) in univ(1) by simp(vu, fu)
  have pu: pair(w, ok(mz.fw(w, d, n, c), d)) in univ(1) by simp(hu, nu, hd)
  show by simp(pu, hnz, hn63, hus, keep(abi.overflow, gimple.usable))
qed

theorem mz.memset_c2: all d c n. d in bits(64) -> c in bits(64) -> n in bits(64) ->
  refines(musl_asm.memset(d, c, n), mallocng_specs.memset_spec(d, c, n), abi.World)
proof
  fix d c n
  assume hd hc hn
  show proof
    fix w o
    assume hw hr
    let SPEC := mallocng_specs.memset_spec(d, c, n)
    have pu := apply(g.runs_univ, expand(hr, musl_asm.memset))
    let PRE := !(d = 0) && int_lt(n, 9223372036854775808) && gimple.usable(w.vm, w.objs, d, n, true)
    // (the requirement not met: anything)
    have np: !PRE -> runs(SPEC, w, o) proof
      assume hn2
      show by simp(pu, hn2, keep(abi.overflow, gimple.usable))
    qed
    have yp: PRE -> runs(SPEC, w, o) proof
      assume hp
      have hnz hn63 hus := hp
      have hu: w in univ(1) by simp(pu)
      have n0: n in omega by simp(hn)
      have d0: d in omega by simp(hd)
      have hdn := apply(mp.usable_end, {w.vm}, {w.objs}, {d}, {n}, {true}, hus, hd, n0)
      step z1 z2 z3 z4 z5 z6 z7 x20, e from hr
      have e1 e2 := e
      // more than 126 bytes
      have big: int_lt(126, n) -> runs(SPEC, w, o) proof
        assume h126
        // (the last word: at n - 8, its signed offset n - 8, usable)
        have s8: bits_sub(64, n, 8) = int_sub(n, 8) := apply(x86.bsub_nowrap, {n}, {8}, n0, simp(), (int_le(8, n) by arith(h126)), (int_lt(n, 18446744073709551616) by arith(hn63)))
        have v8: gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), bits_sub(64, n, 8)) = int_sub(n, 8) by simp(s8, apply(g.sval64_lit, {int_sub(n, 8)}, (int_sub(n, 8) in omega by arith(h126)), (int_lt(int_sub(n, 8), 9223372036854775808) by arith(hn63))))
        have u8a := mp(mp.usable_sub[vm := w.vm, objs := w.objs, a := d, n := n, k := int_sub(n, 8), m := 8, w := true], (int_sub(n, 8) in omega by arith(h126)), simp(), (int_le(int_add(int_sub(n, 8), 8), n) by arith()), hus)
        have a8: bits_add(64, d, bits_sub(64, n, 8)) = int_add(d, int_sub(n, 8)) by simp(s8, apply(x86.add_nowrap, {d}, {int_sub(n, 8)}, d0, (int_sub(n, 8) in omega by arith(h126)), (int_lt(int_add(d, int_sub(n, 8)), 18446744073709551616) by arith(hdn, h126))))
        have u8: gimple.usable(w.vm, w.objs, bits_add(64, d, bits_sub(64, n, 8)), 8, true) by simp(a8, u8a)
        have wvm wfn wdm bm := apply(ms.world_parts, hw)
        step g1 from e1 with g.st64_s_det using conj(h126), hu, hd, hnz, v8, u8, hdn, hw, wvm, wfn, wdm
        // (the world after it: a world)
        let V := bits_mul(64, bits_of_int(64, bits_of_int(8, c)), 72340172838076673)
        let W1 := fn_update(w, "vm", fn_update(w.vm, "bytes", x86_64_linux.store_le(w.vm.bytes, bits_add(64, d, bits_sub(64, n, 8)), 8, V)))
        have w1W w1u := apply(tr.world_store, {w}, {bits_add(64, d, bits_sub(64, n, 8))}, {8}, {V}, hw, hu, simp())
        have w1vm0 w1fn w1dm _ := apply(ms.world_parts, w1W)
        have w1vm: fn_update(w.vm, "bytes", x86_64_linux.store_le(w.vm.bytes, bits_add(64, d, bits_sub(64, n, 8)), 8, V)) in x86_64_linux.Vm by simp(w1vm0)
        // (d 16-aligned: the n / 8 words from d)
        have alg: bits_and(32, bits_of_int(32, d), 15) = 0 -> runs(SPEC, w, o) proof
          assume al
          let Q := bits_shr(64, n, 3)
          have qe := apply(mp.shr3, {n}, hn)
          have q0 r0 := mp(div_nat[x := n, m := 8], n0, simp())
          have ne: n = int_add(int_mul(8, int_div(n, 8)), int_mod(n, 8)) by arith(n0)
          have q8: int_le(int_mul(8, Q), n) by arith(qe, ne, r0)
          have qb: Q in bits(64) by simp(qe, q0, (int_lt(int_div(n, 8), 18446744073709551616) by arith(ne, r0, hn63)))
          have uq0 := mp(mp.usable_sub[vm := w.vm, objs := w.objs, a := d, n := n, k := 0, m := int_mul(8, Q), w := true], simp(), (int_mul(8, Q) in omega by simp(qb)), (int_le(int_add(0, int_mul(8, Q)), n) by arith(q8)), hus)
          have uq: gimple.usable(w.vm, w.objs, d, int_mul(8, Q), true) by simp(uq0, d0)
          have qn: !int_le(int_pow(2, 64), int_mul(8, Q)) by arith(q8, hn63, (int_pow(2, 64) = 18446744073709551616 by simp()))
          step g2 from g1 with g.fill_det using conj(al), uq, qn, hd, w1u, w1vm, w1fn, w1dm, w1W
          step g3 from conj(g2, e2)
          // (the bytes: the last word and the words, covering the n)
          let k := bits_of_int(8, c)
          have dg1 dg8 _ _ vb := apply(mz.v_digs, hc)
          have c0 := apply(mz.cov0, {w.vm.bytes}, {d}, {n}, {k}, bm)
          have o8: bits_sub(64, n, 8) in omega by simp(s8, (int_sub(n, 8) in omega by arith(h126)))
          have nb: int_le(n, 18446744073709551616) by arith(hn63)
          have c1 := apply(mz.cov_store[P := t. false], {w.vm.bytes}, {w.vm.bytes}, {d}, {n}, {k}, {bits_sub(64, n, 8)}, {8}, {V}, {bits_add(64, d, bits_sub(64, n, 8))},
            c0, hd, o8, simp(), (int_le(int_add(bits_sub(64, n, 8), 8), n) by arith(s8)), nb, dg8, refl({bits_add(64, d, bits_sub(64, n, 8))}))
          have vo: V in omega by simp(vb)
          have vl: int_lt(V, 18446744073709551616) by simp(vb)
          have qo: Q in omega by simp(qb)
          have df := apply(mz.digs_fillv, {V}, {k}, {Q}, vo, vl, dg8, qo)
          have c2 := apply(mz.cov_store[P := t. false || (int_le(bits_sub(64, n, 8), t) && int_lt(t, int_add(bits_sub(64, n, 8), 8)))],
            {x86_64_linux.store_le(w.vm.bytes, bits_add(64, d, bits_sub(64, n, 8)), 8, V)}, {w.vm.bytes}, {d}, {n}, {k}, {0}, {int_mul(8, Q)}, {x86.fillv(V, Q)}, {d},
            c1, hd, simp(), (int_mul(8, Q) in omega by simp(qo)), (int_le(int_add(0, int_mul(8, Q)), n) by arith(q8)), nb, df, (d = bits_add(64, d, 0) by defs(simp(hd), bits_add)))
          have all: all t. t in omega -> int_lt(t, n) -> false || (int_le(bits_sub(64, n, 8), t) && int_lt(t, int_add(bits_sub(64, n, 8), 8))) || (int_le(0, t) && int_lt(t, int_add(0, int_mul(8, Q)))) proof
            fix t
            assume ht htn
            show by arith(ht, htn, s8, qe, ne, r0)
          qed
          have bw := apply(mz.cov_fin[P := t. false || (int_le(bits_sub(64, n, 8), t) && int_lt(t, int_add(bits_sub(64, n, 8), 8))) || (int_le(0, t) && int_lt(t, int_add(0, int_mul(8, Q))))],
            {x86_64_linux.store_le(x86_64_linux.store_le(w.vm.bytes, bits_add(64, d, bits_sub(64, n, 8)), 8, V), d, int_mul(8, Q), x86.fillv(V, Q))}, {w.vm.bytes}, {d}, {n}, {k}, c2, all)
          have sp := apply(mz.memset_spec_ok, {w}, {d}, {c}, {n}, hw, hu, hd, hc, hn, hnz, hn63, hus)
          have e3: o = ok(mz.fw(w, d, n, c), d) by simp(g3, bw)
          show := rewrite(sym(e3), sp)
        qed
        // (not aligned: d's first 16 bytes, then the words from d + e, e
        // below 16 its distance to the boundary)
        have nal: !(bits_and(32, bits_of_int(32, d), 15) = 0) -> runs(SPEC, w, o) proof
          assume na
          have u0a := mp(mp.usable_sub[vm := w.vm, objs := w.objs, a := d, n := n, k := 0, m := 8, w := true], simp(), simp(), (int_le(int_add(0, 8), n) by arith(h126)), hus)
          have u8a := mp(mp.usable_sub[vm := w.vm, objs := w.objs, a := d, n := n, k := 8, m := 8, w := true], simp(), simp(), (int_le(int_add(8, 8), n) by arith(h126)), hus)
          have dl0: int_lt(int_add(d, 0), pow2(64)) by arith(hdn, h126, (pow2(64) = 18446744073709551616 by simp()))
          have dl8: int_lt(int_add(d, 8), pow2(64)) by arith(hdn, h126, (pow2(64) = 18446744073709551616 by simp()))
          // (the worlds after the two: worlds)
          let B2 := x86_64_linux.store_le(x86_64_linux.store_le(w.vm.bytes, bits_add(64, d, bits_sub(64, n, 8)), 8, V), int_add(d, 0), 8, V)
          let B3 := x86_64_linux.store_le(B2, int_add(d, 8), 8, V)
          have w2W w2u := apply(tr.world_store, {W1}, {int_add(d, 0)}, {8}, {V}, w1W, w1u, (int_add(d, 0) in bits(64) by arith(d0, dl0, (pow2(64) = 18446744073709551616 by simp()))))
          have w2vm0 w2fn0 w2dm0 _ := apply(ms.world_parts, w2W)
          have w2W2: fn_update(w, "vm", fn_update(w.vm, "bytes", B2)) in abi.World by simp(w2W)
          have w2u2: fn_update(w, "vm", fn_update(w.vm, "bytes", B2)) in univ(1) by simp(w2u)
          have w2vm: fn_update(w.vm, "bytes", B2) in x86_64_linux.Vm by simp(w2vm0)
          have w2fn: is_fun(fn_update(w, "vm", fn_update(w.vm, "bytes", B2))) by simp(w2fn0)
          have w2dm: "vm" in dom(fn_update(w, "vm", fn_update(w.vm, "bytes", B2))) by simp(w2dm0)
          have w3W w3u := apply(tr.world_store, {fn_update(w, "vm", fn_update(w.vm, "bytes", B2))}, {int_add(d, 8)}, {8}, {V}, w2W2, w2u2, (int_add(d, 8) in bits(64) by arith(d0, dl8, (pow2(64) = 18446744073709551616 by simp()))))
          have w3vm0 w3fn0 w3dm0 _ := apply(ms.world_parts, w3W)
          have w3W2: fn_update(w, "vm", fn_update(w.vm, "bytes", B3)) in abi.World by simp(w3W)
          have w3u2: fn_update(w, "vm", fn_update(w.vm, "bytes", B3)) in univ(1) by simp(w3u)
          have w3vm: fn_update(w.vm, "bytes", B3) in x86_64_linux.Vm by simp(w3vm0)
          have w3fn: is_fun(fn_update(w, "vm", fn_update(w.vm, "bytes", B3))) by simp(w3fn0)
          have w3dm: "vm" in dom(fn_update(w, "vm", fn_update(w.vm, "bytes", B3))) by simp(w3dm0)
          // (e: d's distance to the boundary, below 16; the words from d + e)
          let Y := bits_sub(32, 0, bits_of_int(32, d))
          let E := bits_and(32, Y, 15)
          have ee := apply(mz.low4, {Y}, simp())
          have eo: E in omega && int_lt(E, 16) by simp(ee, (int_mod(Y, 16) in omega && int_lt(int_mod(Y, 16), 16) by arith((Y in bits(32) by simp()))))
          have eo1 eo2 := eo
          have e64: bits_of_int(64, E) = E by defs(simp(eo1, eo2), bits_of_int, pow2)
          have ce: bits_sub(64, n, bits_of_int(64, E)) = int_sub(n, E) := trans(rewrite(e64, refl({bits_sub(64, n, bits_of_int(64, E))}), {2}),
            apply(x86.bsub_nowrap, {n}, {E}, n0, eo1, (int_le(E, n) by arith(eo2, h126)), (int_lt(n, 18446744073709551616) by arith(hn63))))
          have de: bits_add(64, d, bits_of_int(64, E)) = int_add(d, E) := trans(rewrite(e64, refl({bits_add(64, d, bits_of_int(64, E))}), {2}),
            apply(x86.add_nowrap, {d}, {E}, d0, eo1, (int_lt(int_add(d, E), 18446744073709551616) by arith(hdn, eo2, h126))))
          let Q := bits_shr(64, bits_sub(64, n, bits_of_int(64, E)), 3)
          have nb2: bits_sub(64, n, bits_of_int(64, E)) in bits(64) by simp()
          have qe := apply(mp.shr3, {bits_sub(64, n, bits_of_int(64, E))}, nb2)
          have ne0: int_sub(n, E) in omega by arith(eo2, h126)
          have q0 r0 := mp(div_nat[x := int_sub(n, E), m := 8], ne0, simp())
          have nde: int_sub(n, E) = int_add(int_mul(8, int_div(int_sub(n, E), 8)), int_mod(int_sub(n, E), 8)) by arith(ne0)
          have q8: int_le(int_add(E, int_mul(8, Q)), n) by arith(qe, ce, nde, r0)
          have qb: Q in bits(64) by simp(qe, ce, q0, (int_lt(int_div(int_sub(n, E), 8), 18446744073709551616) by arith(nde, r0, hn63)))
          have qo: Q in omega by simp(qb)
          have uqa := mp(mp.usable_sub[vm := w.vm, objs := w.objs, a := d, n := n, k := E, m := int_mul(8, Q), w := true], eo1, (int_mul(8, Q) in omega by simp(qo)), q8, hus)
          have uq: gimple.usable(w.vm, w.objs, bits_add(64, d, bits_of_int(64, E)), int_mul(8, Q), true) by simp(de, uqa)
          have qn: !int_le(int_pow(2, 64), int_mul(8, Q)) by arith(q8, hn63, (int_pow(2, 64) = 18446744073709551616 by simp()))
          have dEb: bits_add(64, d, bits_of_int(64, E)) in bits(64) by simp()
          step g2 from g1 with g.st64_det, g.fill_det using conj(na), u0a, u8a, dl0, dl8, hnz, hd, w1u, w1vm, w1fn, w1dm, w1W, w2u2, w2vm, w2fn, w2dm, w2W2,
            uq, qn, dEb, w3u2, w3vm, w3fn, w3dm, w3W2
          step g3 from conj(g2, e2)
          // (the bytes: the last word, the first two, the words from d + e)
          let k := bits_of_int(8, c)
          have dg1 dg8 _ _ vb := apply(mz.v_digs, hc)
          have vo: V in omega by simp(vb)
          have vl: int_lt(V, 18446744073709551616) by simp(vb)
          have nb: int_le(n, 18446744073709551616) by arith(hn63)
          have o8: bits_sub(64, n, 8) in omega by simp(s8, (int_sub(n, 8) in omega by arith(h126)))
          let P1(t) := false || (int_le(bits_sub(64, n, 8), t) && int_lt(t, int_add(bits_sub(64, n, 8), 8)))
          let P2(t) := P1(t) || (int_le(0, t) && int_lt(t, int_add(0, 8)))
          let P3(t) := P2(t) || (int_le(8, t) && int_lt(t, int_add(8, 8)))
          let P4(t) := P3(t) || (int_le(E, t) && int_lt(t, int_add(E, int_mul(8, Q))))
          have c0 := apply(mz.cov0, {w.vm.bytes}, {d}, {n}, {k}, bm)
          have c1 := apply(mz.cov_store[P := t. false], {w.vm.bytes}, {w.vm.bytes}, {d}, {n}, {k}, {bits_sub(64, n, 8)}, {8}, {V}, {bits_add(64, d, bits_sub(64, n, 8))},
            c0, hd, o8, simp(), (int_le(int_add(bits_sub(64, n, 8), 8), n) by arith(s8)), nb, dg8, refl({bits_add(64, d, bits_sub(64, n, 8))}))
          have a0: int_add(d, 0) = bits_add(64, d, 0) by defs(simp(hd, d0), bits_add)
          have c2 := apply(mz.cov_store[P := t. P1(t)], {x86_64_linux.store_le(w.vm.bytes, bits_add(64, d, bits_sub(64, n, 8)), 8, V)}, {w.vm.bytes}, {d}, {n}, {k}, {0}, {8}, {V}, {int_add(d, 0)},
            c1, hd, simp(), simp(), (int_le(int_add(0, 8), n) by arith(h126)), nb, dg8, a0)
          have a8b: int_add(d, 8) = bits_add(64, d, 8) := sym(apply(x86.add_nowrap, {d}, {8}, d0, simp(), (int_lt(int_add(d, 8), 18446744073709551616) by arith(hdn, h126))))
          have c3 := apply(mz.cov_store[P := t. P2(t)], {B2}, {w.vm.bytes}, {d}, {n}, {k}, {8}, {8}, {V}, {int_add(d, 8)},
            c2, hd, simp(), simp(), (int_le(int_add(8, 8), n) by arith(h126)), nb, dg8, a8b)
          have df := apply(mz.digs_fillv, {V}, {k}, {Q}, vo, vl, dg8, qo)
          have aE: bits_add(64, d, bits_of_int(64, E)) = bits_add(64, d, E) := rewrite(e64, refl({bits_add(64, d, bits_of_int(64, E))}), {2})
          have c4 := apply(mz.cov_store[P := t. P3(t)], {B3}, {w.vm.bytes}, {d}, {n}, {k}, {E}, {int_mul(8, Q)}, {x86.fillv(V, Q)}, {bits_add(64, d, bits_of_int(64, E))},
            c3, hd, eo1, (int_mul(8, Q) in omega by simp(qo)), q8, nb, df, aE)
          have all: all t. t in omega -> int_lt(t, n) -> P4(t) proof
            fix t
            assume ht htn
