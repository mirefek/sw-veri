          have bw := apply(mz.cov_fin[P := t. P4(t)], {x86_64_linux.store_le(B3, bits_add(64, d, bits_of_int(64, E)), int_mul(8, Q), x86.fillv(V, Q))}, {w.vm.bytes}, {d}, {n}, {k}, c4, all)
          have sp := apply(mz.memset_spec_ok, {w}, {d}, {c}, {n}, hw, hu, hd, hc, hn, hnz, hn63, hus)
          have e3: o = ok(mz.fw(w, d, n, c), d) by simp(g3, bw)
          show := rewrite(sym(e3), sp)
        qed
        show by taut(alg, nal)
      qed
      // up to 126 bytes: from both ends
      have small: !int_lt(126, n) -> runs(SPEC, w, o) proof
        assume hsm
        have wvm0 wfn0 wdm0 bm := apply(ms.world_parts, hw)
        have b32: bits_of_int(32, n) = n by defs(simp(n0, (int_lt(n, 4294967296) by arith(hsm))), bits_of_int, pow2)
        step g1 from e1 using conj(hsm)
        have z0: n = 0 -> runs(SPEC, w, o) proof
          assume h0
          have b0: bits_of_int(32, n) = 0 by simp(b32, h0)
          step g2 from conj(g1, e2) using b0
          have c0 := apply(mz.cov0, {w.vm.bytes}, {d}, {n}, {bits_of_int(8, c)}, bm)
          have none: all t. t in omega -> int_lt(t, n) -> false proof
            fix t
            assume ht htn
            show by arith(ht, htn, h0)
          qed
          have bw := apply(mz.cov_fin[P := t. false], {w.vm.bytes}, {w.vm.bytes}, {d}, {n}, {bits_of_int(8, c)}, c0, none)
          have vf: is_fun(w.vm) && "bytes" in dom(w.vm) by simp(expand(wvm0, x86_64_linux.Vm))
          have vs := mp(fn_update_same[f := w.vm, k := "bytes"], taut(vf), taut(vf))
          have ws := mp(fn_update_same[f := w, k := "vm"], wfn0, wdm0)
          have sp := apply(mz.memset_spec_ok, {w}, {d}, {c}, {n}, hw, hu, hd, hc, hn, hnz, hn63, hus)
          have e3: o = ok(mz.fw(w, d, n, c), d) by simp(g2, sym(bw), vs, ws)
          show := rewrite(sym(e3), sp)
        qed
        // (the shared facts of the stores: c's byte in the values, the
        // worlds' parts)
        let k := bits_of_int(8, c)
        let V := bits_mul(64, bits_of_int(64, bits_of_int(8, c)), 72340172838076673)
        have dg1 dg8 dg2 dg4 vb := apply(mz.v_digs, hc)
        have nz: !(n = 0) -> !(bits_of_int(32, n) = 0) by simp(b32)
        have c0 := apply(mz.cov0, {w.vm.bytes}, {d}, {n}, {k}, bm)
        have sp := apply(mz.memset_spec_ok, {w}, {d}, {c}, {n}, hw, hu, hd, hc, hn, hnz, hn63, hus)
        have nb: int_le(n, 18446744073709551616) by arith(hn63)
        // (from both ends: each size range's stores those of the smaller
        // ones and two -- or four, eight -- more, the bytes covered so far
        // kept from range to range)
        have r1: int_le(1, n) -> runs(SPEC, w, o) proof
          assume h1
          have l0 l0u := apply(mz.lit_ok, {w.vm}, {w.objs}, {d}, {n}, {0}, {1}, hd, hus, hdn, simp(), simp(), simp(), (int_le(int_add(0, 1), n) by arith(h1)))
