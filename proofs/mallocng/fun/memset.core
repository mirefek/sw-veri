          let B2 := x86_64_linux.store_le(B1, bits_add(64, d, bits_sub(64, n, 1)), 1, k)
          let P1(t) := false || (int_le(0, t) && int_lt(t, int_add(0, 1)))
          let P2(t) := P1(t) || (int_le(int_sub(n, 1), t) && int_lt(t, int_add(int_sub(n, 1), 1)))
          have c1 := apply(mz.st_lit[Q := t. false], {w.vm.bytes}, {w.vm.bytes}, {d}, {n}, {k}, {0}, {1}, {k}, c0, hd, simp(), simp(), (int_le(int_add(0, 1), n) by arith(h1)), nb, dg1, l0)
          have c2 := apply(mz.st_sub[Q := t. P1(t)], {B1}, {w.vm.bytes}, {d}, {n}, {k}, {1}, {1}, {k}, c1, hd, hn, simp(), simp(), simp(), h1, dg1)
          // (1 or 2 bytes: one at each end)
          have z1: int_le(n, 2) -> runs(SPEC, w, o) proof
            assume h2
            have le2: int_le(bits_of_int(32, n), 2) by simp(b32, h2)
            step g2 from conj(g1, e2) with mz.st8_det, mz.st8_s_det using nz1, le2, hnz, hd, hu, hw, l0, l0u, s1a, s1b, s1u
            have all: all t. t in omega -> int_lt(t, n) -> P2(t) proof
