// (fill_words defined: its one outcome, the c words v stored at d)
theorem g.fill_det: all s d v c. s in univ(1) -> d in bits(64) -> v in bits(64) -> c in bits(64) -> g.fill_ok(s, d, c) ->
  s.vm in x86_64_linux.Vm -> is_fun(s) -> "vm" in dom(s) ->
  g.det(musl_asm.fill_words(d, v, c), s, ok(fn_update(s, "vm", fn_update(s.vm, "bytes", x86_64_linux.store_le(s.vm.bytes, d, int_mul(8, c), x86.fillv(v, c)))), empty))
proof
  fix s d v c
  assume hs hd hv hc hk hvm hf hdm
  have hus hnb := hk
  have n8: int_mul(8, c) in omega by simp(hc)
  have hn64: int_lt(int_mul(8, c), 18446744073709551616) by arith(hnb, n8, (int_pow(2, 64) = 18446744073709551616 by simp()))
  have bd: bits_of_int(64, d) = d by defs(simp(hd), bits_of_int)
  have wd := apply(g.write_det, {s}, {d}, {int_mul(8, c)}, {x86.fillv(v, c)}, hd, n8, hn64, hvm, hf, hdm)
  have wd2 := rewrite(sym(bd), expand(wd, x86.fillv), {1})
  have hus2: gimple.usable(s.vm, s.objs, bits_of_int(64, d), int_mul(8, c), true) := rewrite(sym(bd), hus)
  have nd: !(!gimple.usable(s.vm, s.objs, bits_of_int(64, d), int_mul(8, c), true) || int_le(int_pow(2, 64), int_mul(8, c))) by taut(hus2, hnb)
  show proof
    fix o
    assume hr
    step x3, h from hr with wd2, nd
    show by defs(simp(h, bd), x86.fillv)
  qed
qed

// (the stores' one outcomes in a world: its parts from it -- for written
// worlds, which step knows worlds)
theorem mz.st8_det: all s p off v. s in abi.World -> s in univ(1) -> p in bits(64) -> off in bits(32) -> g.mem_defined(s, p, off, 1, true) ->
  g.det(gimple.st8(p, off, v), s, ok(fn_update(s, "vm", fn_update(s.vm, "bytes", x86_64_linux.store_le(s.vm.bytes, int_add(p, off), 1, v))), empty))
proof
  fix s p off v
  assume hW hs hp ho hd
  have a b c _ := apply(ms.world_parts, hW)
  show := apply(g.st8_det, {s}, {p}, {off}, {v}, hs, hp, ho, hd, a, b, c)
qed

