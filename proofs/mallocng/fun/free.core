// ----------------------------------------------------------------------
//  The `free` symbol: free.c's free, calling __libc_free -- the same
//  purpose (`libc_free_spec`)

// free(p)'s run: __libc_free(p) called as such
theorem mp.fr_run(c, p, g, s, h, o): p in bits(64) -> mp.lf_call(c, g) -> s in abi.World -> h in mp.G ->
  mallocng.holds_in(c, h.A, s.vm, s.objs, h.blocks) -> mallocng.no_reserved(h.A) -> seq_len(h.A.taken) = 0 -> abi.thread_ok(s.vm, s.fs_base) ->
  mallocng_specs.tls_apart(c, h.A, s.fs_base) -> mallocng_specs.errno_ok(s.vm, s.objs, s.fs_base) -> mallocng_specs.errno_apart(c, h.A, s.vm, s.fs_base) ->
  (!(p = 0) -> !(h.blocks[p] = none)) -> runs(c_src_malloc_free.free(p, g), s, o) ->
  abi.ovf_out(s, o) || (ex V. (V in x86_64_linux.Vm && mp.lf_res(c, h.A, h.blocks, p, s, V)) && o = ok(fn_update(s, "vm", V), empty))
proof
  assume hp hg hw hh hin hnr htk hth htl heo hea hlv hr
  have pu := apply(g.runs_univ, hr)
  have hu: s in univ(1) by simp(pu)
  have ths: gc.sound(s) by simp(hth)
  step V r, ho hR from hr with hg using conj(hw, hu, ths, hp, hh, hin, hnr, htk, hth, htl, heo, hea, hlv)
  show by disj({2}, ex_intro({V}, taut(hR, ho)))
qed

// free's code by its purpose
theorem mp.fr: all c p g. p in bits(64) -> mp.lf_call(c, g) ->
  refines_ghost(c_src_malloc_free.free(p, g), mallocng_specs.libc_free_spec(c, p), abi.World, mp.G)
proof
  fix c p g
  assume hp hg
  let P := c_src_malloc_free.free(p, g)
  have rp: all s o. runs(P, s, o) -> pair(s, o) in univ(1) proof
    fix s o
    assume hr
    show := apply(g.runs_univ, expand(hr, c_src_malloc_free.free))
  qed
  have rn: mp.lf_runs(c, p, P) proof
    fix s h o
    assume hw hh hin hnr htk hth htl heo hea hlv hr
    show := apply(mp.fr_run[c := c, p := p, g := g, s := s, h := h, o := o], hp, hg, hw, hh, hin, hnr, htk, hth, htl, heo, hea, hlv, hr)
  qed
  show := apply(mp.lf_ref[c := c, p := p, P := P], rp, rn)
qed

// its C function value, its divergence, its machine code over any
// __libc_free called as such
contract free mallocng_specs.libc_free_spec_fun by mp.fr
