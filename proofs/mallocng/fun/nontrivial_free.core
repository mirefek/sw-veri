// nontrivial_free(g, i) by its purpose: slot i of g, the only reserved one
// (its block just freed), given back -- with its group, all of whose
// slots are then free (free_group, g off its class's list first), or
// into g's freed mask (g queued on its class's list if it was full).

// ----------------------------------------------------------------------
//  The masks' test: all g's slots free but i

// (a bit added where clear: the bits or'ed)
theorem mp.add_bit(S, i): S in bits(32) -> i in omega -> int_lt(i, 32) -> !bit(S, i) -> int_add(S, pow2(i)) = bits_or(32, S, pow2(i))
proof
  assume hs hi hil hn
  have so sl := (S in omega && int_lt(S, pow2(32)) by simp(hs, keep(pow2)))
  have p31 := mp(pow2_le[a := i, b := 31], hi, simp(), arith(hil))
  have p32: pow2(32) = 4294967296 by defs(simp(), pow2)
  have p33: pow2(33) = 8589934592 by defs(simp(), pow2)
  have p31v: pow2(31) = 2147483648 by defs(simp(), pow2)
  have pp := mp(pow2_pos[k := i], hi)
  have x33: int_add(S, pow2(i)) in bits(33) by defs(sel(arith(so, sl, p31, p32, p33, p31v, pp)), bits)
  have yb := mp(bits_or_in[n := 32, x := S, y := pow2(i)], simp())
  have y33: bits_or(32, S, pow2(i)) in bits(33) by defs(sel(arith(expand(yb, bits), p32, p33)), bits)
  have po: pow2(i) in omega by arith(pp)
  have eb: all j. j in omega -> int_lt(j, 33) -> (bit(int_add(S, pow2(i)), j) <-> bit(bits_or(32, S, pow2(i)), j)) proof
    fix j
    assume hj hjl
    have l := mp(bit_set[x := S, k := i, i := j], so, hi, hj, hn)
    have pj := mp(bit_pow2[k := i, i := j], hi, hj)
    have lo: int_lt(j, 32) -> (bit(bits_or(32, S, pow2(i)), j) <-> bit(S, j) || bit(pow2(i), j)) := mp(bit_or[n := 32, x := S, y := pow2(i), i := j], simp(), hj)
    have hi32: j = 32 -> !bit(S, j) && !bit(bits_or(32, S, pow2(i)), j) proof
      assume e
      have b1 := mp(bit_high[x := S, n := 32, i := j], so, simp(), hj, sl, arith(e))
      have yo yl := (bits_or(32, S, pow2(i)) in omega && int_lt(bits_or(32, S, pow2(i)), pow2(32)) by simp(yb, keep(pow2)))
      have b2 := mp(bit_high[x := bits_or(32, S, pow2(i)), n := 32, i := j], yo, simp(), hj, yl, arith(e))
      show by taut(b1, b2)
    qed
    have c: int_lt(j, 32) || j = 32 by arith(hjl, hj)
    have ne: j = 32 -> !(j = i) by arith(hil)
    show by taut(l, pj, lo, hi32, c, ne)
  qed
  show := mp(all_elim(bits_ext, {33}), simp(), {int_add(S, pow2(i))}, {bits_or(32, S, pow2(i))}, x33, y33, eb)
qed

// (the bits up to L but i set, i clear, none above L: S with bit i added
// all ones up to L -- and only then)
theorem mp.mask_eq(S, i, L): S in bits(32) -> i in omega -> L in omega -> int_le(i, L) -> int_lt(L, 32) -> !bit(S, i) ->
  (all j. j in omega -> int_lt(L, j) -> !bit(S, j)) ->
  (int_add(S, pow2(i)) = int_sub(pow2(int_add(L, 1)), 1) <-> (all j. j in omega -> int_le(j, L) -> !(j = i) -> bit(S, j)))
proof
  assume hs hi hL hiL hL32 hn hhi
  have so sl := (S in omega && int_lt(S, pow2(32)) by simp(hs, keep(pow2)))
  have L1: int_add(L, 1) in omega by arith(hL)
  have bm: all j. j in omega -> (bit(int_sub(pow2(int_add(L, 1)), 1), j) <-> int_lt(j, int_add(L, 1))) proof
    fix j
    assume hj
    show := mp(bit_mask[k := int_add(L, 1), i := j], L1, hj)
  qed
  have bs: all j. j in omega -> (bit(int_add(S, pow2(i)), j) <-> j = i || bit(S, j)) proof
    fix j
    assume hj
    show := mp(bit_set[x := S, k := i, i := j], so, hi, hj, hn)
  qed
  have fw: int_add(S, pow2(i)) = int_sub(pow2(int_add(L, 1)), 1) -> (all j. j in omega -> int_le(j, L) -> !(j = i) -> bit(S, j)) proof
    assume e
    fix j
    assume hj hjl hne
    have b1 := rewrite(e, all_elim(bs, {j}))
    show by taut(mp(b1, hj), mp(all_elim(bm, {j}), hj), (int_lt(j, int_add(L, 1)) by arith(hjl)), hne)
  qed
  have bw: (all j. j in omega -> int_le(j, L) -> !(j = i) -> bit(S, j)) -> int_add(S, pow2(i)) = int_sub(pow2(int_add(L, 1)), 1) proof
    assume hall
    have pp := mp(pow2_pos[k := i], hi)
    have p31 := mp(pow2_le[a := i, b := 31], hi, simp(), arith(hiL, hL32))
    have q31 := mp(pow2_le[a := int_add(L, 1), b := 32], L1, simp(), arith(hL32))
    have qp := mp(pow2_pos[k := int_add(L, 1)], L1)
    have p32: pow2(32) = 4294967296 by defs(simp(), pow2)
    have p33: pow2(33) = 8589934592 by defs(simp(), pow2)
    have p31v: pow2(31) = 2147483648 by defs(simp(), pow2)
    have x33: int_add(S, pow2(i)) in bits(33) by defs(sel(arith(so, sl, p31, p32, p33, p31v, pp)), bits)
    have y33: int_sub(pow2(int_add(L, 1)), 1) in bits(33) by defs(sel(arith(q31, qp, p32, p33)), bits)
    have eb: all j. j in omega -> int_lt(j, 33) -> (bit(int_add(S, pow2(i)), j) <-> bit(int_sub(pow2(int_add(L, 1)), 1), j)) proof
      fix j
      assume hj hjl
      have c1: int_le(j, L) -> (bit(int_add(S, pow2(i)), j) <-> bit(int_sub(pow2(int_add(L, 1)), 1), j)) proof
        assume le
        have k := all_elim(hall, {j})
        show by taut(mp(all_elim(bs, {j}), hj), mp(all_elim(bm, {j}), hj), (int_lt(j, int_add(L, 1)) by arith(le)), k, hj, le)
      qed
      have c2: int_lt(L, j) -> (bit(int_add(S, pow2(i)), j) <-> bit(int_sub(pow2(int_add(L, 1)), 1), j)) proof
        assume gt
        have nb := mp(all_elim(hhi, {j}), hj, gt)
        show by taut(mp(all_elim(bs, {j}), hj), mp(all_elim(bm, {j}), hj), (!int_lt(j, int_add(L, 1)) by arith(gt)), (!(j = i) by arith(gt, hiL)), nb)
      qed
      show by taut(c1, c2, (int_le(j, L) || int_lt(L, j) by arith(hj, hL)))
    qed
    show := mp(all_elim(bits_ext, {33}), simp(), {int_add(S, pow2(i))}, {int_sub(pow2(int_add(L, 1)), 1)}, x33, y33, eb)
  qed
  show by taut(fw, bw)
qed

// (1 << i, in 32 bits)
theorem mp.shl1(i): i in omega -> int_lt(i, 32) -> bits_shl(32, bits_of_int(32, 1), i) = pow2(i)
proof
  assume hi hil
  have e1: bits_of_int(32, 1) = 1 by defs(simp(), bits_of_int, pow2)
  have pp := mp(pow2_pos[k := i], hi)
  have p31 := mp(pow2_le[a := i, b := 31], hi, simp(), arith(hil))
  have p31v: pow2(31) = 2147483648 by defs(simp(), pow2)
  have p32: pow2(32) = 4294967296 by defs(simp(), pow2)
  show by defs(arith(e1, pp, p31, p31v, p32), bits_shl)
qed

// (two masks or'ed: 0 only if both are)
theorem mp.or_zero(x, y): x in bits(32) -> y in bits(32) -> bits_or(32, x, y) = 0 -> x = 0 && y = 0
proof
  assume hx hy hz
  have z32: 0 in bits(32) by simp()
  have bz: all j. j in omega -> int_lt(j, 32) -> !bit(x, j) && !bit(y, j) proof
    fix j
    assume hj hjl
    have o := mp(bit_or[n := 32, x := x, y := y, i := j], simp(), hj, hjl)
    have z := rewrite(hz, o)
    show by taut(z, mp(bit_zero_none[j := j], hj))
  qed
  have ex: all j. j in omega -> int_lt(j, 32) -> (bit(x, j) <-> bit(0, j)) proof
    fix j
    assume hj hjl
    show by taut(mp(all_elim(bz, {j}), hj, hjl), mp(bit_zero_none[j := j], hj))
  qed
  have ey: all j. j in omega -> int_lt(j, 32) -> (bit(y, j) <-> bit(0, j)) proof
    fix j
    assume hj hjl
    show by taut(mp(all_elim(bz, {j}), hj, hjl), mp(bit_zero_none[j := j], hj))
  qed
  have x0 := mp(all_elim(bits_ext, {32}), simp(), {x}, {0}, hx, z32, ex)
  have y0 := mp(all_elim(bits_ext, {32}), simp(), {y}, {0}, hy, z32, ey)
  show by taut(x0, y0)
qed

// (the code's test: (mask + self) = (2 << last) - 1, in 32 bits)
theorem mp.full_test(S, i, L): S in bits(32) -> i in omega -> L in omega -> int_le(i, L) -> int_lt(L, 32) -> !bit(S, i) ->
  (all j. j in omega -> int_lt(L, j) -> !bit(S, j)) ->
  (bits_add(32, S, bits_shl(32, bits_of_int(32, 1), i)) = bits_add(32, bits_shl(32, bits_of_int(32, 2), L), bits_neg(32, 1)) <->
   (all j. j in omega -> int_le(j, L) -> !(j = i) -> bit(S, j)))
proof
  assume hs hi hL hiL hL32 hn hhi
  have so sl := (S in omega && int_lt(S, pow2(32)) by simp(hs, keep(pow2)))
  have p32: pow2(32) = 4294967296 by defs(simp(), pow2)
  have pp := mp(pow2_pos[k := i], hi)
  have p31 := mp(pow2_le[a := i, b := 31], hi, simp(), arith(hiL, hL32))
  have p31v: pow2(31) = 2147483648 by defs(simp(), pow2)
  have qp := mp(pow2_pos[k := L], hL)
  have q31 := mp(pow2_le[a := L, b := 31], hL, simp(), arith(hL32))
  have e1: bits_of_int(32, 1) = 1 by defs(simp(), bits_of_int, pow2)
  have e2: bits_of_int(32, 2) = 2 by defs(simp(), bits_of_int, pow2)
  have ad := mp(mp.add_bit[S := S, i := i], hs, hi, arith(hiL, hL32), hn)
  have yb := mp(bits_or_in[n := 32, x := S, y := pow2(i)], simp())
  have yl: int_lt(int_add(S, pow2(i)), pow2(32)) := rewrite(sym(ad), (int_lt(bits_or(32, S, pow2(i)), pow2(32)) by simp(yb, keep(pow2))))
  have lhs: bits_add(32, S, bits_shl(32, bits_of_int(32, 1), i)) = int_add(S, pow2(i)) by defs(arith(e1, so, yl, pp, p31, p31v, p32), bits_add, bits_shl)
  have pa := mp(all_elim(mp(all_elim(pow2_add, {L}), hL), {1}), simp())
  have p1: pow2(1) = 2 by defs(simp(), pow2)
  have rhs: bits_add(32, bits_shl(32, bits_of_int(32, 2), L), bits_neg(32, 1)) = int_sub(pow2(int_add(L, 1)), 1)
    by defs(arith(e2, pa, p1, qp, q31, p31v, p32), bits_add, bits_shl, bits_neg)
  have me := mp(mp.mask_eq[S := S, i := i, L := L], hs, hi, hL, hiL, hL32, hn, hhi)
  show := rewrite(sym(lhs), rewrite(sym(rhs), me))
qed

// (a slot in neither mask: its bits clear)
theorem mp.nbit0(x, y, j): x in omega -> y in omega -> j in omega -> !int_lt(0, int_add(mallocng.bit(x, j), mallocng.bit(y, j))) ->
  !bit(x, j) && !bit(y, j)
proof
  assume hx hy hj hz
  have n1 := mp(mp.nbit[x := x, i := j], hx, hj)
  have n2 := mp(mp.nbit[x := y, i := j], hy, hj)
  have z1: int_le(0, mallocng.bit(x, j)) by defs(arith(hx), mallocng.bit)
  have z2: int_le(0, mallocng.bit(y, j)) by defs(arith(hy), mallocng.bit)
  have c1: bit(x, j) -> false proof
    assume b
    show by arith(n1, (ite(bit(x, j), 1, 0) = 1 by simp(b)), z2, hz)
  qed
  have c2: bit(y, j) -> false proof
    assume b
    show by arith(n2, (ite(bit(y, j), 1, 0) = 1 by simp(b)), z1, hz)
  qed
  show by taut(c1, c2)
qed

// (g's masks or'ed, i a reserved slot of g: i's bit clear, none past the
// last slot; its bits the masks')
theorem mp.nf_masks(A, M, b, g, i): A in mallocng.Abs -> g in omega -> mallocng.group_ok(A, M, b, g) -> i in omega ->
  int_lt(i, seq_len(A.slots[g])) -> A.slots[g][i] = tag(3, empty) ->
  sin: bits_or(32, A.metas[g].freed, A.metas[g].avail) in bits(32) &&
  each: (all j. j in omega -> int_lt(j, 32) -> (bit(bits_or(32, A.metas[g].freed, A.metas[g].avail), j) <-> bit(A.metas[g].freed, j) || bit(A.metas[g].avail, j))) &&
  clr: !bit(bits_or(32, A.metas[g].freed, A.metas[g].avail), i) &&
  high: (all j. j in omega -> int_lt(A.metas[g].last_idx, j) -> !bit(bits_or(32, A.metas[g].freed, A.metas[g].avail), j)) &&
  il: int_le(i, A.metas[g].last_idx) && lt: int_lt(A.metas[g].last_idx, 32)
proof
  assume ha hg gok hi hil hrs
  let F := A.metas[g].freed
  let Av := A.metas[g].avail
  let S := bits_or(32, F, Av)
  have {mim = mim, hmk = masks, hns = nslots} := expand(gok, mallocng.group_ok)
  have {ml = last} := expand(mim, mallocng.meta_in_memory)
  have vt: A.metas[g] in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A.metas, x := g], simp(ha), hg)
  have avo: Av in omega by simp(vt)
  have fro: F in omega by simp(vt)
  have lo: A.metas[g].last_idx in omega by simp(vt)
  have sb := mp(bits_or_in[n := 32, x := F, y := Av], simp())
  have so sl := (S in omega && int_lt(S, pow2(32)) by simp(sb, keep(pow2)))
  have each: all j. j in omega -> int_lt(j, 32) -> (bit(S, j) <-> bit(F, j) || bit(Av, j)) proof
    fix j
    assume hj hjl
    show := mp(bit_or[n := 32, x := F, y := Av, i := j], simp(), hj, hjl)
  qed
  have mk := expand(hmk, mallocng.masks_ok)
  have il: int_le(i, A.metas[g].last_idx) by arith(hil, hns)
  have clr: !bit(S, i) proof
    have _ _ m3 _ := mp(all_elim(mk, {i}), hi, arith(il, ml))
    have q _ := mp(m3, il)
    have nu: !(A.slots[g][i] = tag(0, empty)) by simp(hrs)
    have n0 := mp(mp.nbit0[x := Av, y := F, j := i], avo, fro, hi, taut(q, nu))
    show by taut(mp(all_elim(each, {i}), hi, arith(il, ml)), n0)
  qed
  have high: all j. j in omega -> int_lt(A.metas[g].last_idx, j) -> !bit(S, j) proof
    fix j
    assume hj hgt
    have c1: int_lt(j, 32) -> !bit(S, j) proof
      assume j32
      have _ m2 _ _ := mp(all_elim(mk, {j}), hj, j32)
      have nz: !int_lt(0, int_add(mallocng.bit(Av, j), mallocng.bit(F, j))) by taut(m2, (!int_le(j, A.metas[g].last_idx) by arith(hgt)))
      have n0 := mp(mp.nbit0[x := Av, y := F, j := j], avo, fro, hj, nz)
      show by taut(mp(all_elim(each, {j}), hj, j32), n0)
    qed
    have c2: !int_lt(j, 32) -> !bit(S, j) proof
      assume j32
      show := mp(bit_high[x := S, n := 32, i := j], so, simp(), hj, sl, arith(j32))
    qed
    show by taut(c1, c2)
  qed
  show by taut(sb, each, clr, high, il, ml)
qed

// (a group mapped on its own: one slot)
theorem mp.own_one(A, M, b, g): mallocng.group_ok(A, M, b, g) -> mallocng.own_mapping(A.metas[g]) -> A.metas[g].last_idx = 0
proof
  assume gok hown
  have {hcls = cls, hbig = big} := expand(gok, mallocng.group_ok)
  have c63: A.metas[g].sizeclass = 63 -> A.metas[g].last_idx = 0 proof
    assume e
    have l _ _ _ := mp(expand(hbig, mallocng.big_ok), e)
    show := l
  qed
  have c48: int_lt(A.metas[g].sizeclass, 48) -> A.metas[g].last_idx = 0 proof
    assume lt
    have st: !(A.metas[g].last_idx = 0) -> mallocng.stride(A.metas[g]) = int_mul(mallocng.UNIT, mallocng.size_classes[A.metas[g].sizeclass]) proof
      assume ne
      show by defs(simp(ne), mallocng.stride)
    qed
    have o := expand(hown, mallocng.own_mapping)
    have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
    have k: !(A.metas[g].last_idx = 0) -> false proof
      assume ne
      show by arith(o, lt, mp(st, ne), cu)
    qed
    show by taut(k)
  qed
  show by taut(hcls, c63, c48)
qed

// (g's slots but i all in a mask, i its only reserved slot: g emptied)
theorem mp.emp_masks(A, M, b, g, i): A in mallocng.Abs -> g in omega -> mallocng.group_ok(A, M, b, g) -> mallocng.reserved_only(A, g, i) ->
  (all j. j in omega -> int_le(j, A.metas[g].last_idx) -> !(j = i) -> bit(A.metas[g].avail, j) || bit(A.metas[g].freed, j)) ->
  mallocng.emptied(A, g)
proof
  assume ha hg gok hro hall
  have {mim = mim, hmk = masks, hns = nslots} := expand(gok, mallocng.group_ok)
  have {ml = last} := expand(mim, mallocng.meta_in_memory)
  have hil hrs huq := expand(hro, mallocng.reserved_only)
  have vt: A.metas[g] in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A.metas, x := g], simp(ha), hg)
  have avo: A.metas[g].avail in omega by simp(vt)
  have fro: A.metas[g].freed in omega by simp(vt)
  have e1: all j. j in omega -> int_lt(j, seq_len(A.slots[g])) -> A.slots[g][j] = tag(0, empty) || A.slots[g][j] = tag(3, empty) proof
    fix j
    assume hj hjl
    have c1: j = i -> A.slots[g][j] = tag(3, empty) proof
      assume e
      show := rewrite(sym(e), hrs)
    qed
    have c2: !(j = i) -> A.slots[g][j] = tag(0, empty) proof
      assume ne
      have il: int_le(j, A.metas[g].last_idx) by arith(hjl, hns)
      have _ _ m3 _ := mp(all_elim(expand(hmk, mallocng.masks_ok), {j}), hj, arith(il, ml))
      have q _ := mp(m3, il)
      have bb := mp(all_elim(hall, {j}), hj, il, ne)
      have n1 := mp(mp.nbit[x := A.metas[g].avail, i := j], avo, hj)
      have n2 := mp(mp.nbit[x := A.metas[g].freed, i := j], fro, hj)
      have k1: bit(A.metas[g].avail, j) -> int_lt(0, int_add(mallocng.bit(A.metas[g].avail, j), mallocng.bit(A.metas[g].freed, j))) proof
        assume x
        have z: int_le(0, mallocng.bit(A.metas[g].freed, j)) by defs(arith(fro), mallocng.bit)
        show by arith(n1, (ite(bit(A.metas[g].avail, j), 1, 0) = 1 by simp(x)), z)
      qed
      have k2: bit(A.metas[g].freed, j) -> int_lt(0, int_add(mallocng.bit(A.metas[g].avail, j), mallocng.bit(A.metas[g].freed, j))) proof
        assume x
        have z: int_le(0, mallocng.bit(A.metas[g].avail, j)) by defs(arith(avo), mallocng.bit)
        show by arith(n2, (ite(bit(A.metas[g].freed, j), 1, 0) = 1 by simp(x)), z)
      qed
      show by taut(q, bb, k1, k2)
    qed
    show by taut(c1, c2)
  qed
  have e2: all h2 j. h2 in omega && j in omega -> int_lt(j, seq_len(A.slots[h2])) && A.slots[h2][j] = tag(3, empty) -> h2 = g proof
    fix h2 j
    assume h1 h3
    have a _ := mp(all_elim(huq, {h2}, {j}), h1, h3)
    show := a
  qed
  show by defs(taut(e1, e2), mallocng.emptied)
qed

// (a meta's byte: in a meta area -- not the context's, in no group)
theorem mp.meta_apart(c, A, M, b, brk, g, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds(c, A, M, b, brk) ->
  mallocng.meta_slot(A, g) -> a in omega -> int_le(g, a) -> int_lt(a, int_add(g, 40)) ->
  ctx: !mallocng.in_range(a, pair(c.ctx, mallocng.CTX_SIZE)) && groups: (all h. mallocng.is_used(A, h) -> !mallocng.in_range(a, mallocng.group_range(A.metas[h])))
proof
  assume hc hu ha H hms hao h1 h2
  have {lex = area} := apply(mp.meta_page, ha, hms)
  obtain k, hk hkl la1 la2 _ from lex
  have {agr = groups} := apply(mp.area_apart[c := c, A := A, M := M, b := b, brk := brk, k := k, a := a], hc, hu, ha, H, hk, hkl, hao, arith(la1, h1), arith(la2, h2))
  have nc: !mallocng.in_range(a, pair(c.ctx, mallocng.CTX_SIZE)) proof
    assume ic
    have na := apply(mp.ctx_noarea[c := c, A := A, M := M, b := b, brk := brk, a := a], hc, hu, ha, H, hao, ic)
    show by taut(mp(all_elim(na, {k}), hk, hkl), (int_le(A.areas[k], a) && int_lt(a, int_add(A.areas[k], 4096)) by arith(la1, la2, h1, h2)))
  qed
  show by taut(nc, agr)
qed

// (a group's active-index byte in its header: the allocator's)
theorem mp.hdr8_held(c, A, M, b, brk, g): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds(c, A, M, b, brk) ->
  mallocng.is_used(A, g) -> held: int_add(A.metas[g].mem, 8) in mallocng.held(c, A, b) &&
  grp: mallocng.in_range(int_add(A.metas[g].mem, 8), mallocng.group_range(A.metas[g]))
proof
  assume hc hu ha H hg
  let V := A.metas[g]
  have {huo = used} := expand(H, mallocng.holds)
  have gok := apply(mp.used_group, huo, hg)
  have {go = nat} := apply(mp.used_nat, ha, hg)
  have {hown = hdr_own} := expand(gok, mallocng.group_ok)
  have vt: V in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A.metas, x := g], simp(ha), go)
  have vmem: V.mem in omega by simp(vt)
  have vlast: V.last_idx in omega by simp(vt)
  have sn := apply(mp.stride_nat, ha, go, gok)
  have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
  have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
  have sel: mallocng.slot_end(V, V.last_idx) = int_sub(int_add(int_add(int_add(V.mem, 16), int_mul(mallocng.stride(V), V.last_idx)), mallocng.stride(V)), 4)
    by defs(arith(cu, ci), mallocng.slot_end, mallocng.slot_start, mallocng.storage)
  have ml: int_mul(mallocng.stride(V), V.last_idx) in omega by simp(sn, vlast)
  let H8 := int_add(V.mem, 8)
  have h8o: H8 in omega by simp(vmem)
  have grh := apply(mp.group_bytes[A := A, M := M, b := b, h := g, a := H8], ha, go, gok, h8o, arith(vmem), arith(sel, ml, vmem, sn))
  obtain kg, hkg hkgr from expand(hg, mallocng.is_used)
  have hkgl hkge := hkgr
  have nl := mp(all_elim(hown, {H8}), h8o, (int_le(V.mem, H8) && int_lt(H8, int_add(V.mem, mallocng.UNIT)) by arith(vmem, cu)))
  have nr := apply(mp.hdr_nores[c := c, A := A, M := M, b := b, brk := brk, g := g, a := H8], hc, hu, ha, H, hg, h8o, arith(vmem), arith(vmem))
  have gr2 := subst({y. mallocng.in_range(H8, mallocng.group_range(A.metas[y]))}, sym(hkge), grh)
  have nt8 := apply(mp.grp_untaken, hc, hu, ha, H, hg, h8o, grh)
  have h8fp0 := apply(mp.group_fp[c := c, A := A, b := b, k := kg, a := H8], hc, hu, ha, hkg, hkgl, h8o, gr2, nl, nr, nt8)
  have hd := apply(mp.group_held[c := c, A := A, M := M, b := b, brk := brk, h := g, a := H8], hc, hu, ha, H, hg, h8o, grh, h8fp0)
  show by taut(hd, grh)
qed

// ----------------------------------------------------------------------
//  The slot given back into g's freed mask (no own mapping): the state
//  with slot i unused (`mp.unres_abs`), on the memory with g's freed word
//  written (a_or's) -- the invariant, what freed_back asks of the step

theorem mp.unres_mem(c, A, vm, objs, b, g, i): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  vm in x86_64_linux.Vm -> mallocng.holds_in(c, A, vm, objs, b) -> mallocng.is_used(A, g) -> i in omega -> mallocng.reserved_only(A, g, i) ->
  !mallocng.own_mapping(A.metas[g]) ->
  abs: mp.unres_abs(A, g, i) in mallocng.Abs && univ: mp.unres_abs(A, g, i) in univ(1) && nores: mallocng.no_reserved(mp.unres_abs(A, g, i)) &&
  hin: mallocng.holds_in(c, mp.unres_abs(A, g, i), mallocng_specs.wr32(vm, int_add(g, 28), int_add(A.metas[g].freed, pow2(i))), objs, b) &&
  unt: mallocng.untouched(c, A, b, vm, mallocng_specs.wr32(vm, int_add(g, 28), int_add(A.metas[g].freed, pow2(i))), objs,
    set_select(omega, x0. mallocng.in_reserved(A, x0))) &&
  fp: (all a. a in omega -> a in mallocng.footprint(c, mp.unres_abs(A, g, i), b) -> a in mallocng.footprint(c, A, b) || mallocng.in_reserved(A, a)) &&
  tk: mp.unres_abs(A, g, i).taken = A.taken &&
  bitf: !bit(A.metas[g].freed, i) && fword: int_add(A.metas[g].freed, pow2(i)) = bits_or(32, A.metas[g].freed, pow2(i))
proof
  assume hc hu ha hb hv hin hg hi hro hno
  let F := A.metas[g].freed
  let X := int_add(F, pow2(i))
  let V2 := mallocng_specs.wr32(vm, int_add(g, 28), X)
  let A2 := mp.unres_abs(A, g, i)
  let FP := mallocng.held(c, A, b)
  let M := mallocng.mview(vm, FP)
  have {hh = mem, hsh = shown} := expand(hin, mallocng.holds_in)
  have {H = inv} := expand(hh, mallocng.holds_m)
  have {huo = used} := expand(H, mallocng.holds)
  have gok := apply(mp.used_group, huo, hg)
  have {go = nat} := apply(mp.used_nat, ha, hg)
  have hil hrs _ := expand(hro, mallocng.reserved_only)
  have {mim} := expand(gok, mallocng.group_ok)
  have {mav = avail, mfr = freed} := expand(mim, mallocng.meta_in_memory)
  have {fb0 = bit} := apply(mp.res_freed0[c := c, A := A, M := M, b := b, brk := vm.brk, g := g, i := i], ha, H, hg, hi, hil, hrs)
  have {sin, each, clr, il, lt} := apply(mp.nf_masks[A := A, M := M, b := b, g := g, i := i], ha, go, gok, hi, hil, hrs)
  have nfi: !bit(F, i) by taut(mp(all_elim(each, {i}), hi, arith(il, lt)), clr)
  have top _ := apply(mp.meta_word, hc, hu, ha, hh, hg)
  have _ g24 inr := apply(mp.meta_mem, hc, hu, ha, hh, hg)
  have vb: vm.bytes in fn_space(bits(64), bits(8)) by simp(hv)
  have inm: all o n2. o in omega -> n2 in omega -> int_le(int_add(o, n2), 40) -> (all j. j in omega -> int_lt(j, n2) -> int_add(int_add(g, o), j) in FP) proof
    fix o n2
    assume ho hn2 hl
    fix j
    assume hj hjl
    have r1 _ _ := mp(all_elim(inr, {int_add(int_add(g, o), j)}), arith(go, ho, hj), arith(go, ho, hj), arith(go, ho, hj, hjl, hl))
    show := r1
  qed
  // (F: the freed word, 32 bits; X its bit i set)
  have v28 := apply(mp.view_read[vm := vm, fp := FP, a := int_add(g, 28), n := 4], arith(go), simp(), arith(), mp(all_elim(inm, {28}, {4}), simp(), simp(), simp()))
  have bh28 := mp(all_elim(g.bytes_bound, {vm}, {int_add(g, 28)}, {4}), vb, simp())
  have p4: int_pow(256, 4) = 4294967296 by simp()
  have Fb: F in bits(32) by defs(sel(arith(v28, mfr, bh28, p4)), bits, pow2)
  have ad := mp(mp.add_bit[S := F, i := i], Fb, hi, arith(il, lt), nfi)
  have xb := mp(bits_or_in[n := 32, x := F, y := pow2(i)], simp())
  have Xo Xl0 := (X in omega && int_lt(X, pow2(32)) by simp(rewrite(sym(ad), xb), keep(pow2)))
  have p32: pow2(32) = 4294967296 by defs(simp(), pow2)
  have Xl: int_lt(X, 4294967296) by arith(Xl0, p32)
  // holds_m_unres's premises: only the freed word written, the avail word read back
  have gb: int_add(g, 28) in bits(64) by arith(go, top)
  have eb: all x. x in bits(64) -> !(int_le(int_add(g, 24), x) && int_lt(x, int_add(g, 32))) -> V2.bytes[x] = vm.bytes[x] proof
    fix x
    assume hx hn
    show := apply(mp.wr32_out[V := vm, c := int_add(g, 28), v := X, x := x], hx, gb, arith(top), arith(hn))
  qed
  have ep: V2.pages = vm.pages := mp(mp.w32_keep[V := vm, c := int_add(g, 28), v := X, k := "pages"], simp())
  have ek: V2.brk = vm.brk := mp(mp.w32_keep[V := vm, c := int_add(g, 28), v := X, k := "brk"], simp())
  have et: V2.stack_top = vm.stack_top := mp(mp.w32_keep[V := vm, c := int_add(g, 28), v := X, k := "stack_top"], simp())
  have el: V2.stack_limit = vm.stack_limit := mp(mp.w32_keep[V := vm, c := int_add(g, 28), v := X, k := "stack_limit"], simp())
  // (A2's view: A's bytes and the slot's)
  have mo := apply(mp.unres_state, ha, go, hi, hil, hrs, fb0).mo
  have fpr: mallocng.fp_ranges(c, A2) = mallocng.fp_ranges(c, A) := trans((mallocng.fp_ranges(c, A2) = mallocng.fp_ranges(c, mp.unres_m(A, g, i)) by defs(simp(), mallocng.fp_ranges,
    mallocng.fixed_ranges, mallocng.auxv_ranges)), apply(mp.mo_ranges[c := c, A := A, A2 := mp.unres_m(A, g, i)], ha, mo))
  have tk: A2.taken = A.taken by simp()
  have nr2 := apply(mp.unres_nores, ha, go, hi, hro, fb0)
  have heldA2: all a. a in FP -> a in mallocng.held(c, A2, b) proof
    fix a
    assume h1
    have {f1 = fp} := apply(mp.held_fp, h1)
    have ao nr1 := (a in omega && !mallocng.in_reserved(A, a) by taut(apply(mp.fp_def[c := c, A := A, b := b, a := a]), f1))
    have {hld = held} := apply(mp.fp_same[c := c, A := A, A2 := A2, b := b, a := a], ao, fpr, tk, nr1, apply(mp.nores[A := A2, a := a], nr2))
    show by taut(hld, h1)
  qed
  have in2: all o n2. o in omega -> n2 in omega -> int_le(int_add(o, n2), 40) -> (all j. j in omega -> int_lt(j, n2) -> int_add(int_add(g, o), j) in mallocng.held(c, A2, b)) proof
    fix o n2
    assume ho hn2 hl
    fix j
    assume hj hjl
    show := mp(all_elim(heldA2, {int_add(int_add(g, o), j)}), mp(all_elim(inm, {o}, {n2}), ho, hn2, hl, {j}, hj, hjl))
  qed
  have m24: all j. j in omega -> int_lt(j, 4) -> V2.bytes[int_add(int_add(g, 24), j)] = vm.bytes[int_add(int_add(g, 24), j)] proof
    fix j
    assume hj hjl
    show := apply(mp.wr32_out[V := vm, c := int_add(g, 28), v := X, x := int_add(int_add(g, 24), j)], arith(go, top, hj, hjl), gb, arith(top), arith(hjl, hj))
  qed
  have r24 := apply(mp.rd_same[v1 := V2, v2 := vm, a := int_add(g, 24), n := 4], arith(go), simp(), arith(top), m24)
  have v24 := apply(mp.view_read[vm := vm, fp := FP, a := int_add(g, 24), n := 4], arith(go), simp(), arith(), mp(all_elim(inm, {24}, {4}), simp(), simp(), simp()))
  have w24 := apply(mp.view_read[vm := V2, fp := mallocng.held(c, A2, b), a := int_add(g, 24), n := 4], arith(go), simp(), arith(), mp(all_elim(in2, {24}, {4}), simp(), simp(), simp()))
  have rav: mallocng.rd(mallocng.mview(V2, mallocng.held(c, A2, b)), int_add(g, 24), 4) = A.metas[g].avail := trans(sym(w24), trans(r24, trans(v24, mav)))
  have w28 := apply(mp.view_read[vm := V2, fp := mallocng.held(c, A2, b), a := int_add(g, 28), n := 4], arith(go), simp(), arith(), mp(all_elim(in2, {28}, {4}), simp(), simp(), simp()))
  have r28 := apply(mp.rd_at4[vm := vm, c := int_add(g, 28), v := X], vb, gb, Xo)
  have wq: V2 = fn_update(vm, "bytes", x86_64_linux.store_le(vm.bytes, int_add(g, 28), 4, X)) := all_elim(ms.v_wr32, {vm}, {int_add(g, 28)}, {X})
  have mX: int_mod(X, 4294967296) = X by arith(Xo, Xl)
  have rfr: mallocng.rd(mallocng.mview(V2, mallocng.held(c, A2, b)), int_add(g, 28), 4) = X := trans(sym(w28), trans(rewrite(sym(wq), r28), mX))
  have {a2 = abs, u2 = univ, hm2 = holds} := apply(mp.holds_m_unres[c := c, A := A, vm := vm, vm2 := V2, b := b, g := g, i := i], hc, hu, ha, hb, hh, hg, hi, hro, hno,
    eb, ep, ek, et, el, rav, rfr)
  have sh2 := apply(mp.shown_same[c := c, A := A, A2 := A2, objs := objs], hsh, fpr, (A2.reserve = A.reserve by simp()), (A2.reserve_cnt = A.reserve_cnt by simp()))
  have hin2: mallocng.holds_in(c, A2, V2, objs, b) by defs(taut(hm2, sh2), mallocng.holds_in)
  // untouched: only g's freed word written, the allocator's
  have ss := mp(fn_update_same[f := vm, k := "bytes"], simp(expand(hv, x86_64_linux.Vm)), simp(expand(hv, x86_64_linux.Vm)))
  have t2 := fn_update_twice[f := vm, k := "bytes", a := x86_64_linux.store_le(vm.bytes, int_add(g, 28), 4, X), b := vm.bytes]
  have vr: fn_update(V2, "bytes", vm.bytes) = vm := rewrite(sym(wq), trans(t2, ss))
  have bk := apply(mp.bk_only[v := vm, v2 := V2], vr)
  let E := set_select(omega, x0. mallocng.in_reserved(A, x0))
  have r0: all x0. x0 in omega -> (!(x0 in mallocng.footprint(c, A, b)) && !(x0 in E)) && x86_64_linux.mapped(vm, int_div(x0, x86_64_linux.PAGE)) ->
      (!abi.stack_free(vm, objs, x0) -> V2.bytes[bits_of_int(64, x0)] = vm.bytes[bits_of_int(64, x0)]) &&
      V2.pages[int_div(x0, x86_64_linux.PAGE)] = vm.pages[int_div(x0, x86_64_linux.PAGE)] proof
    fix a
    assume ho hq
    have n1 _ mm := hq
    have mm1 _ := expand(mm, x86_64_linux.mapped)
    have alo: int_lt(a, int_pow(2, 64)) by arith(ho, expand(mm1, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))
    have nm: !(int_le(int_add(g, 28), a) && int_lt(a, int_add(g, 32))) proof
      assume w
      have w1 w2 := w
      have {mf = fp} := apply(mp.meta_held[c := c, A := A, M := M, b := b, brk := vm.brk, g := g, a := a], hc, hu, ha, H, hg, ho, arith(w1), arith(w2))
      show by taut(mf, n1)
    qed
    have ab: bits_of_int(64, a) = a by defs(arith(ho, alo), bits_of_int, pow2)
    have bb := apply(mp.wr32_out[V := vm, c := int_add(g, 28), v := X, x := a], (a in bits(64) by defs(sel(arith(ho, alo)), bits, pow2)), gb, arith(top), arith(nm))
    have bb2 := subst({y. V2.bytes[y] = vm.bytes[y]}, sym(ab), bb)
    show by taut(bb2, (V2.pages[int_div(a, x86_64_linux.PAGE)] = vm.pages[int_div(a, x86_64_linux.PAGE)] by simp(ep)))
  qed
  have unt: mallocng.untouched(c, A, b, vm, V2, objs, E) by defs(taut(r0, bk), mallocng.untouched)
  // the allocator after: A's, and the slot given back
  have fpc: all a. a in omega -> a in mallocng.footprint(c, A2, b) -> a in mallocng.footprint(c, A, b) || mallocng.in_reserved(A, a) proof
    fix a
    assume ho f
    have c1: !mallocng.in_reserved(A, a) -> a in mallocng.footprint(c, A, b) proof
      assume nr1
      have {fe = fp} := apply(mp.fp_same[c := c, A := A, A2 := A2, b := b, a := a], ho, fpr, tk, nr1, apply(mp.nores[A := A2, a := a], nr2))
      show by taut(fe, f)
    qed
    show by taut(c1)
  qed
  show by taut(a2, u2, nr2, hin2, unt, fpc, tk, nfi, ad)
qed

// The slot given back, g as it is on the lists (a_or alone): freed_back
theorem mp.unres_out(c, A, vm, objs, b, g, i): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  vm in x86_64_linux.Vm -> mallocng.holds_in(c, A, vm, objs, b) -> mallocng.is_used(A, g) -> i in omega -> mallocng.reserved_only(A, g, i) ->
  !mallocng.own_mapping(A.metas[g]) ->
  ex A2. (A2 in mallocng.Abs && A2 in univ(1)) &&
    mallocng_specs.freed_back(c, A, A2, b, vm, mallocng_specs.wr32(vm, int_add(g, 28), int_add(A.metas[g].freed, pow2(i))), objs, 0, 0)
proof
  assume hc hu ha hb hv hin hg hi hro hno
  have {a2 = abs, u2 = univ, nr2 = nores, hin2 = hin, unt1 = unt, fp1 = fp, tk2 = tk} :=
    apply(mp.unres_mem[c := c, A := A, vm := vm, objs := objs, b := b, g := g, i := i], hc, hu, ha, hb, hv, hin, hg, hi, hro, hno)
  have lg: mallocng_specs.let_go(c, A, mp.unres_abs(A, g, i), b, 0, 0) by defs(simp(), mallocng_specs.let_go)
  have fb: mallocng_specs.freed_back(c, A, mp.unres_abs(A, g, i), b, vm, mallocng_specs.wr32(vm, int_add(g, 28), int_add(A.metas[g].freed, pow2(i))), objs, 0, 0)
    by defs(taut(hin2, nr2, tk2, unt1, fp1, lg), mallocng_specs.freed_back)
  show by ex_intro({mp.unres_abs(A, g, i)}, taut(a2, u2, fb))
qed

// The slot given back with g, full and on no list, queued on its class's
// list (free's queue, then a_or): abstractly the freed bit first -- on the
// memory with only that word written --, then the queue (`mp.qu_step_g`:
// g, now with a slot freed, may join the list past its head)
theorem mp.unres_queue(c, A, vm, V1, objs, b, g, i): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  vm in x86_64_linux.Vm -> V1 in x86_64_linux.Vm -> mallocng.holds_in(c, A, vm, objs, b) -> mallocng.is_used(A, g) -> i in omega -> mallocng.reserved_only(A, g, i) ->
  !mallocng.own_mapping(A.metas[g]) -> int_mod(c.ctx, 8) = 0 -> int_lt(A.metas[g].sizeclass, 48) ->
  !mallocng.on_list(A.active[A.metas[g].sizeclass], g) -> A.metas[g].prev = 0 -> A.metas[g].next = 0 -> A.metas[g].avail = 0 -> A.metas[g].freed = 0 ->
  mallocng_specs.queued(vm, V1, objs, int_add(int_add(c.ctx, mallocng.C_ACTIVE), int_mul(8, A.metas[g].sizeclass)), g) ->
  rd28: gimple.bytes_at(V1, int_add(g, 28), 4) = gimple.bytes_at(vm, int_add(g, 28), 4) &&
  kq: mallocng.kept_outside(c, A, b, vm, V1, empty) &&
  out: (ex A3. (A3 in mallocng.Abs && A3 in univ(1)) &&
    mallocng_specs.freed_back(c, A, A3, b, vm, mallocng_specs.wr32(V1, int_add(g, 28), int_add(A.metas[g].freed, pow2(i))), objs, 0, 0))
proof
  assume hc hu ha hb hv hV1 hin hg hi hro hno cal hsl hnl hp0 hn0 hav0 hfr0 hq
  let sc := A.metas[g].sizeclass
  let X := int_add(A.metas[g].freed, pow2(i))
  let V0w := mallocng_specs.wr32(vm, int_add(g, 28), X)
  let V2 := mallocng_specs.wr32(V1, int_add(g, 28), X)
  let A2 := mp.unres_abs(A, g, i)
  let PH := int_add(int_add(c.ctx, mallocng.C_ACTIVE), int_mul(8, sc))
  let L := A.active[sc]
  let l2 := seq_concat(L, seq_one(g))
  let M := mallocng.mview(vm, mallocng.held(c, A, b))
  have {a2 = abs, u2 = univ, nr2 = nores, hin2 = hin, unt1 = unt, fp1 = fp, tk2 = tk} :=
    apply(mp.unres_mem[c := c, A := A, vm := vm, objs := objs, b := b, g := g, i := i], hc, hu, ha, hb, hv, hin, hg, hi, hro, hno)
  have {hh = mem, hsh = shown} := expand(hin, mallocng.holds_in)
  have {H = inv} := expand(hh, mallocng.holds_m)
  have vb: vm.bytes in fn_space(bits(64), bits(8)) by simp(hv)
  have vb1: V1.bytes in fn_space(bits(64), bits(8)) by simp(hV1)
  have {go = nat} := apply(mp.used_nat, ha, hg)
  have vt: A.metas[g] in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A.metas, x := g], simp(ha), go)
  have hs: sc in omega by simp(vt)
  have la := apply(mp.active_at[c := c, A := A, vm := vm, b := b, objs := objs, sc := sc], hc, hu, ha, vb, hh, hsh, cal, hs, hsl)
  have jn := apply(mp.join_any[c := c, A := A, vm := vm, b := b, objs := objs, sc := sc, g := g], hc, hu, ha, vb, hh, hsh, hs, hsl, hnl, hg, hp0, hn0)
  have {cok = ctx} := expand(H, mallocng.holds)
  have {c11 = nactive} := expand(cok, mallocng.ctx_ok)
  have al: A.active in list_type(list_type(omega)) by simp(ha)
  have lt := mp(at_type[l := A.active, t := list_type(omega), i := sc], al, hs, (int_lt(sc, seq_len(A.active)) by arith(c11, hsl)))
  have at1 only1 := mp(all_elim(expand(hq, mallocng_specs.queued), {L}), lt, conj(la, jn))
  // g's freed word: apart from the list's head word and its links
  have hms := apply(mp.used_slot[c := c, A := A, M := M, b := b, brk := vm.brk, g := g], H, hg)
  have {hac = active} := expand(H, mallocng.holds)
  have {sl_len = len, sl_old = old, sl_new = new} := apply(mp.snoc_at[L := L, g := g, k := 0], lt, go, simp())
  have lo: seq_len(L) in omega by arith(lt)
  have away: all a. a in omega -> int_le(int_add(g, 28), a) -> int_lt(a, int_add(g, 32)) ->
      !(int_le(PH, a) && int_lt(a, int_add(PH, 8))) &&
      (all k. k in omega -> int_lt(k, seq_len(l2)) -> !(int_le(l2[k], a) && int_lt(a, int_add(l2[k], 16)))) proof
    fix a
    assume ho h1 h2
    have {nc = ctx} := apply(mp.meta_apart[c := c, A := A, M := M, b := b, brk := vm.brk, g := g, a := a], hc, hu, ha, H, hms, ho, arith(h1), arith(h2))
    have cs: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
    have ca: mallocng.C_ACTIVE = 80 by defs(refl({80}), mallocng.C_ACTIVE)
    have co: c.ctx in omega by simp(hc)
    have p1: !(int_le(PH, a) && int_lt(a, int_add(PH, 8))) proof
      assume w
      have w1 w2 := w
      have ir1: int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, 928)) by arith(w1, w2, ca, hsl, hs, co)
      show by taut(nc, (mallocng.in_range(a, pair(c.ctx, mallocng.CTX_SIZE)) by defs(simp(ir1, cs), mallocng.in_range)))
    qed
    have p2: all k. k in omega -> int_lt(k, seq_len(l2)) -> !(int_le(l2[k], a) && int_lt(a, int_add(l2[k], 16))) proof
      fix k
      assume hk hkl
      have {sk_old = old} := apply(mp.snoc_at[L := L, g := g, k := k], lt, go, hk)
      have c1: int_lt(k, seq_len(L)) -> !(int_le(l2[k], a) && int_lt(a, int_add(l2[k], 16))) proof
        assume kl
        have ek := mp(sk_old, kl)
        have xu _ _ := mp(all_elim(expand(hac, mallocng.active_ok), {sc}, {k}), conj(hs, hk), conj(hsl, kl))
        have xne: !(L[k] = g) proof
          assume e
          show by taut(hnl, (mallocng.on_list(L, g) by defs(ex_intro({k}, taut(hk, kl, e)), mallocng.on_list)))
        qed
        have xms := apply(mp.used_slot[c := c, A := A, M := M, b := b, brk := vm.brk, g := L[k]], H, xu)
        have xo: L[k] in omega := mp(at_type[l := L, t := omega, i := k], lt, hk, kl)
        assume w
        have w1 w2 := rewrite(ek, w)
        have d := apply(mp.meta_disj[c := c, A := A, M := M, b := b, brk := vm.brk, g := g, l := L[k], a := a], hc, hu, ha, H, hms, xms, xne, ho, w1, arith(w2))
        show by taut(d, (int_le(g, a) && int_lt(a, int_add(g, 40)) by arith(h1, h2)))
      qed
      have c2: !int_lt(k, seq_len(L)) -> !(int_le(l2[k], a) && int_lt(a, int_add(l2[k], 16))) proof
        assume kg
        have ek: k = seq_len(L) by arith(kg, hkl, sl_len, lo, hk)
        have eg: l2[k] = g := rewrite(sym(ek), sl_new)
        show by arith(eg, h1)
      qed
      show by taut(c1, c2)
    qed
    show by taut(p1, p2)
  qed
  // the list on the memory with the freed word written after the queue
  have top _ := apply(mp.meta_word, hc, hu, ha, hh, hg)
  have gb: int_add(g, 28) in bits(64) by arith(go, top)
  have vb2: V2.bytes in fn_space(bits(64), bits(8)) := apply(mp.wr32_typed[V := V1, c := int_add(g, 28), v := X], vb1)
  have xo: all x. x in omega -> int_lt(x, 18446744073709551616) -> !(int_le(int_add(g, 28), x) && int_lt(x, int_add(g, 32))) -> V2.bytes[x] = V1.bytes[x] proof
    fix x
    assume ho hl hn
    show := apply(mp.wr32_out[V := V1, c := int_add(g, 28), v := X, x := x], (x in bits(64) by defs(sel(arith(ho, hl)), bits, pow2)), gb, arith(top), arith(hn))
  qed
  have {hok = head} := expand(la, mallocng_specs.list_at)
  have _ pb _ _ := expand(hok, mallocng_specs.word_ok)
  have co: c.ctx in omega by simp(hc)
  have ca: mallocng.C_ACTIVE = 80 by defs(refl({80}), mallocng.C_ACTIVE)
  have pho: PH in omega by arith(co, hs, ca)
  have phb: PH in bits(64) by defs(sel(arith(pb, pho)), bits, pow2)
  have xl := mp(all_elim(tr.seq_one_type, {g}, {omega}), go)
  have l2t: l2 in list_type(omega) := mp(all_elim(tr.concat_list, {L}, {seq_one(g)}, {omega}), lt, xl)
  have mh: all j. j in omega -> int_lt(j, 8) -> V2.bytes[int_add(PH, j)] = V1.bytes[int_add(PH, j)] proof
    fix j
    assume hj hjl
    have n: !(int_le(int_add(g, 28), int_add(PH, j)) && int_lt(int_add(PH, j), int_add(g, 32))) proof
      assume w
      have w1 w2 := w
      have p1 _ := mp(all_elim(away, {int_add(PH, j)}), arith(pho, hj), w1, w2)
      show by taut(p1, (int_le(PH, int_add(PH, j)) && int_lt(int_add(PH, j), int_add(PH, 8)) by arith(hj, hjl)))
    qed
    show := mp(all_elim(xo, {int_add(PH, j)}), arith(pho, hj), arith(pb, hjl), n)
  qed
  have ehead := apply(mp.rd_same[v1 := V2, v2 := V1, a := PH, n := 8], pho, simp(), arith(pb), mh)
  have {el1 = elems} := expand(at1, mallocng_specs.list_at)
  have eel: all k. k in omega -> int_lt(k, seq_len(l2)) ->
      gimple.bytes_at(V2, int_add(l2[k], 8), 8) = gimple.bytes_at(V1, int_add(l2[k], 8), 8) && gimple.bytes_at(V2, l2[k], 8) = gimple.bytes_at(V1, l2[k], 8) proof
    fix k
    assume hk hkl
    have bd _ _ _ _ := mp(all_elim(el1, {k}), hk, hkl)
    have ko: l2[k] in omega := mp(at_type[l := l2, t := omega, i := k], l2t, hk, hkl)
    have mb: all j. j in omega -> int_lt(j, 16) -> V2.bytes[int_add(l2[k], j)] = V1.bytes[int_add(l2[k], j)] proof
      fix j
      assume hj hjl
      have n: !(int_le(int_add(g, 28), int_add(l2[k], j)) && int_lt(int_add(l2[k], j), int_add(g, 32))) proof
        assume w
        have w1 w2 := w
        have _ p2 := mp(all_elim(away, {int_add(l2[k], j)}), arith(ko, hj), w1, w2)
        show by taut(mp(all_elim(p2, {k}), hk, hkl), (int_le(l2[k], int_add(l2[k], j)) && int_lt(int_add(l2[k], j), int_add(l2[k], 16)) by arith(hj, hjl)))
      qed
      show := mp(all_elim(xo, {int_add(l2[k], j)}), arith(ko, hj), arith(bd, hjl), n)
    qed
    have m8: all j. j in omega -> int_lt(j, 8) -> V2.bytes[int_add(int_add(l2[k], 8), j)] = V1.bytes[int_add(int_add(l2[k], 8), j)] proof
      fix j
      assume hj hjl
      have e: int_add(int_add(l2[k], 8), j) = int_add(l2[k], int_add(8, j)) by arith(ko, hj)
      show := rewrite(sym(e), mp(all_elim(mb, {int_add(8, j)}), simp(hj), arith(hj, hjl)))
    qed
    have m0: all j. j in omega -> int_lt(j, 8) -> V2.bytes[int_add(l2[k], j)] = V1.bytes[int_add(l2[k], j)] proof
      fix j
      assume hj hjl
      show := mp(all_elim(mb, {j}), hj, arith(hjl))
    qed
    have r8 := apply(mp.rd_same[v1 := V2, v2 := V1, a := int_add(l2[k], 8), n := 8], arith(ko), simp(), arith(bd), m8)
    have r0 := apply(mp.rd_same[v1 := V2, v2 := V1, a := l2[k], n := 8], ko, simp(), arith(bd), m0)
    show by taut(r8, r0)
  qed
  have wq1: V2 = fn_update(V1, "bytes", x86_64_linux.store_le(V1.bytes, int_add(g, 28), 4, X)) := all_elim(ms.v_wr32, {V1}, {int_add(g, 28)}, {X})
  have wq0: V0w = fn_update(vm, "bytes", x86_64_linux.store_le(vm.bytes, int_add(g, 28), 4, X)) := all_elim(ms.v_wr32, {vm}, {int_add(g, 28)}, {X})
  have ss1 := mp(fn_update_same[f := V1, k := "bytes"], simp(expand(hV1, x86_64_linux.Vm)), simp(expand(hV1, x86_64_linux.Vm)))
  have fu1: fn_update(V2, "bytes", V1.bytes) = V1 :=
    rewrite(sym(wq1), trans(fn_update_twice[f := V1, k := "bytes", a := x86_64_linux.store_le(V1.bytes, int_add(g, 28), 4, X), b := V1.bytes], ss1))
  have at2 := apply(mp.list_keep[vm := V1, V := V2, objs := objs, phead := PH, l := l2], vb1, vb2, phb, l2t, fu1, at1, ehead, eel)
  // only links written from V0w to V2: the queue's writes
  have ob1 ob2 := expand(only1, mallocng_specs.links_only)
  let SL0 := x86_64_linux.store_le(vm.bytes, int_add(g, 28), 4, X)
  let SL1 := x86_64_linux.store_le(V1.bytes, int_add(g, 28), 4, X)
  have e1 := fn_update_twice[f := V1, k := "bytes", a := SL1, b := SL0]
  have e2 := rewrite(ob1, fn_update_twice[f := V1, k := "bytes", a := vm.bytes, b := SL0])
  have o1: fn_update(fn_update(V1, "bytes", SL1), "bytes", SL0) = fn_update(vm, "bytes", SL0) := trans(e1, sym(e2))
  have ob0: V0w.bytes = SL0 by simp(wq0)
  have lo1: fn_update(V2, "bytes", V0w.bytes) = V0w := rewrite(sym(ob0), rewrite(sym(wq1), rewrite(sym(wq0), o1)))
  have lo2: all a. a in omega -> int_lt(a, int_pow(2, 64)) && !(int_le(PH, a) && int_lt(a, int_add(PH, 8))) &&
      (all k. k in omega -> int_lt(k, seq_len(l2)) -> !(int_le(l2[k], a) && int_lt(a, int_add(l2[k], 16)))) ->
      V2.bytes[bits_of_int(64, a)] = V0w.bytes[bits_of_int(64, a)] proof
    fix a
    assume ho h
    have q := mp(all_elim(ob2, {a}), ho, h)
    have zb: bits_of_int(64, a) in bits(64) by simp()
    have s := mp(all_elim(tr.store_le_agree, {V1.bytes}, {vm.bytes}, {int_add(g, 28)}, {4}, {X}, {bits_of_int(64, a)}), zb, q)
    have s1 := rewrite(sym(ob0), s)
    show := rewrite(sym(wq1), (fn_update(V1, "bytes", SL1).bytes[bits_of_int(64, a)] = V0w.bytes[bits_of_int(64, a)] by simp(s1)))
  qed
  have lo: mallocng_specs.links_only(V0w, V2, PH, l2) by defs(taut(lo1, lo2), mallocng_specs.links_only)
  // g not partially active: no slot freed before, so its active index at
  // its last slot (the index's byte not g's meta's)
  have {huo = used} := expand(H, mallocng.holds)
  have gok := apply(mp.used_group, huo, hg)
  have {mim, hmk = masks} := expand(gok, mallocng.group_ok)
  have {ml = last} := expand(mim, mallocng.meta_in_memory)
  have vl: A.metas[g].last_idx in omega by simp(vt)
  let H8 := int_add(A.metas[g].mem, 8)
  have _ _ _ m4 := mp(all_elim(expand(hmk, mallocng.masks_ok), {A.metas[g].last_idx}), vl, ml)
  have np: !int_lt(int_mod(mallocng.b8(M, H8), 32), A.metas[g].last_idx) proof
    assume p
    have b1 := mp(m4, conj(p, (int_le(A.metas[g].last_idx, A.metas[g].last_idx) by arith(vl))))
    have b00: mallocng.bit(0, A.metas[g].last_idx) = 0 by simp(mp(mp.nbit[x := 0, i := A.metas[g].last_idx], simp(), vl), mp(bit_zero_none[j := A.metas[g].last_idx], vl))
    have b0 := subst({y. mallocng.bit(y, A.metas[g].last_idx) = 0}, sym(hfr0), b00)
    show by arith(b1, b0)
  qed
  have {hh8 = held, gr8 = grp} := apply(mp.hdr8_held[c := c, A := A, M := M, b := b, brk := vm.brk, g := g], hc, hu, ha, H, hg)
  have {f8 = fp} := apply(mp.held_fp, hh8)
  have h8o nr8 := (H8 in omega && !mallocng.in_reserved(A, H8) by taut(apply(mp.fp_def[c := c, A := A, b := b, a := H8]), f8))
  have fpr: mallocng.fp_ranges(c, A2) = mallocng.fp_ranges(c, A) proof
    have hil hrs _ := expand(hro, mallocng.reserved_only)
    have {fb0 = bit} := apply(mp.res_freed0[c := c, A := A, M := M, b := b, brk := vm.brk, g := g, i := i], ha, H, hg, hi, hil, hrs)
    have mo := apply(mp.unres_state, ha, go, hi, hil, hrs, fb0).mo
    show := trans((mallocng.fp_ranges(c, A2) = mallocng.fp_ranges(c, mp.unres_m(A, g, i)) by defs(simp(), mallocng.fp_ranges,
      mallocng.fixed_ranges, mallocng.auxv_ranges)), apply(mp.mo_ranges[c := c, A := A, A2 := mp.unres_m(A, g, i)], ha, mo))
  qed
  have {hd2 = held} := apply(mp.fp_same[c := c, A := A, A2 := A2, b := b, a := H8], h8o, fpr, tk2, nr8, apply(mp.nores[A := A2, a := H8], nr2))
  have hh82: H8 in mallocng.held(c, A2, b) by taut(hd2, hh8)
  have bv1 _ := apply(mp.b8_view[vm := vm, fp := mallocng.held(c, A, b), a := H8], vb, h8o, hh8)
  have vb0: V0w.bytes in fn_space(bits(64), bits(8)) := apply(mp.wr32_typed[V := vm, c := int_add(g, 28), v := X], vb)
  have bv2 _ := apply(mp.b8_view[vm := V0w, fp := mallocng.held(c, A2, b), a := H8], vb0, h8o, hh82)
  have {hmp = mapped} := expand(hh, mallocng.holds_m)
  have h8b := apply(mp.fp_low[c := c, A := A, vm := vm, b := b, a := H8], hmp, f8)
  have n8: !(int_le(int_add(g, 28), H8) && int_lt(H8, int_add(g, 32))) proof
    assume w
    have w1 w2 := w
    have {ng = groups} := apply(mp.meta_apart[c := c, A := A, M := M, b := b, brk := vm.brk, g := g, a := H8], hc, hu, ha, H, hms, h8o, arith(w1), arith(w2))
    show by taut(mp(all_elim(ng, {g}), hg), gr8)
  qed
  have ab8: bits_of_int(64, H8) = H8 by defs(arith(h8o, h8b), bits_of_int, pow2)
  have e8 := apply(mp.wr32_out[V := vm, c := int_add(g, 28), v := X, x := H8], (H8 in bits(64) by defs(sel(arith(h8o, h8b)), bits, pow2)), gb, arith(top), arith(n8))
  have e8b := subst({y. V0w.bytes[y] = vm.bytes[y]}, sym(ab8), e8)
  have eqb: mallocng.b8(mallocng.mview(V0w, mallocng.held(c, A2, b)), H8) = mallocng.b8(M, H8) := trans(bv2, trans(e8b, sym(bv1)))
  have np2 := rewrite(sym(eqb), np)
  have npw: !mallocng.partial(mallocng.mview(V0w, mallocng.held(c, A2, b)), A2, g) by defs(simp(np2), mallocng.partial)
  // the queue, on the state with the slot given back
  have {hm2 = mem, sh2 = shown} := expand(hin2, mallocng.holds_in)
  have v0V := apply(mp.w32_vm[V := vm, c := int_add(g, 28), v := X], hv)
  have v2V := apply(mp.w32_vm[V := V1, c := int_add(g, 28), v := X], hV1)
  have nl2: !mallocng.on_list(A2.active[sc], g) by simp(hnl)
  have hg2: mallocng.is_used(A2, g) by defs(simp(expand(hg, mallocng.is_used)), mallocng.is_used)
  have sc2: A2.metas[g].sizeclass = sc by simp()
  have pz: A2.metas[g].prev = 0 by simp(hp0)
  have nz: A2.metas[g].next = 0 by simp(hn0)
  have htl2: int_lt(0, seq_len(A2.active[sc])) -> A2.metas[g].avail = 0 && !(A2.metas[g].freed = 0) proof
    assume _
    have pp := mp(pow2_pos[k := i], hi)
    have f2: A2.metas[g].freed = int_add(A.metas[g].freed, pow2(i)) by simp()
    show by taut((A2.metas[g].avail = 0 by simp(hav0)), (!(A2.metas[g].freed = 0) by arith(f2, hfr0, pp)))
  qed
  have hreu: mallocng.has_unused(A2, g) -> !mallocng.own_mapping(A2.metas[g]) proof
    assume _
    have eo: mallocng.own_mapping(A2.metas[g]) <-> mallocng.own_mapping(A.metas[g]) by defs(simp(), mallocng.own_mapping, mallocng.stride)
    show by taut(eo, hno)
  qed
  have at2b: mallocng_specs.list_at(V2, objs, PH, seq_concat(A2.active[sc], seq_one(g))) by simp(at2, keep(mallocng_specs.list_at))
  have lob: mallocng_specs.links_only(V0w, V2, PH, seq_concat(A2.active[sc], seq_one(g))) by simp(lo, keep(mallocng_specs.links_only))
  have {a3 = abs, u3 = univ, hm3 = holds, kp3 = unt, sl3 = slots, gm3 = geom} :=
    apply(mp.qu_step_g[c := c, A := A2, vm := V0w, V := V2, b := b, objs := objs, sc := sc, g := g], hc, u2, a2, hb, v0V, v2V, hm2, sh2, cal, hs, hsl,
      nl2, hg2, sc2, pz, nz, npw, htl2, hreu, at2b, lob)
  let A3 := mp.enlist(A2, sc, seq_concat(A2.active[sc], seq_one(g)), V2)
  // freed_back: the invariant, none reserved, the taken metas, untouched
  // outside, the allocator A's or the slot's
  have sh3 := apply(mp.shown_geom[c := c, A := A2, A2 := A3, objs := objs], a2, gm3, sh2)
  have hin3: mallocng.holds_in(c, A3, V2, objs, b) by defs(taut(hm3, sh3), mallocng.holds_in)
  have nr3: mallocng.no_reserved(A3) by defs(rewrite(sym(sl3), expand(nr2, mallocng.no_reserved)), mallocng.no_reserved)
  have gs3 := apply(mp.geoms_of[A := A2, A2 := A3], a2, gm3)
  have tk3: A3.taken = A2.taken := apply(mp.gs_field[A := A2, A2 := A3, k := "taken"], gs3, simp(), simp(), simp(), simp())
  have tk: A3.taken = A.taken := trans(tk3, tk2)
  let E := set_select(omega, x0. mallocng.in_reserved(A, x0))
  have k3e := apply(mp.kept_unt[c := c, A := A2, b := b, vm := V0w, V := V2, objs := objs, e := empty], kp3)
  have sub: all a. a in omega -> !(a in mallocng.footprint(c, A, b)) -> !(a in E) -> !(a in mallocng.footprint(c, A2, b)) && !(a in empty) proof
    fix a
    assume ho n1 n2
    have m1: !(a in mallocng.footprint(c, A2, b)) proof
      assume f
      show by taut(mp(all_elim(fp1, {a}), ho, f), n1, n2, set_select_def[s := omega, p := x0. mallocng.in_reserved(A, x0), z := a], ho)
    qed
    show by taut(m1, (!(a in empty) by simp()))
  qed
  have shr := apply(mp.unt_shrink[c := c, A := A, A1 := A2, b := b, V0 := V0w, V1 := V2, objs := objs, e := E, e1 := empty], k3e, sub)
  have triv: all a. a in omega -> a in mallocng.footprint(c, A, b) -> a in mallocng.footprint(c, A, b) || !x86_64_linux.mapped(vm, int_div(a, x86_64_linux.PAGE)) proof
    fix a
    assume _ f
    show by taut(f)
  qed
  have unt3 := apply(mp.unt_seq[c := c, A := A, A1 := A, b := b, V0 := vm, V1 := V0w, V2 := V2, objs := objs, e := E], unt1, shr, triv)
  have gr3 := apply(mp.gm_ranges[c := c, A := A2, A2 := A3], a2, gm3)
  have nr3a := expand(nr3, mallocng.no_reserved)
  have fpc: all a. a in omega -> a in mallocng.footprint(c, A3, b) -> a in mallocng.footprint(c, A, b) || mallocng.in_reserved(A, a) proof
    fix a
    assume ho f
    have {fe = fp} := apply(mp.fp_same[c := c, A := A2, A2 := A3, b := b, a := a], ho, gr3, tk3, apply(mp.nores[A := A2, a := a], nr2), apply(mp.nores[A := A3, a := a], nr3))
    show := mp(all_elim(fp1, {a}), ho, taut(fe, f))
  qed
  have lg: mallocng_specs.let_go(c, A, A3, b, 0, 0) by defs(simp(), mallocng_specs.let_go)
  have fb: mallocng_specs.freed_back(c, A, A3, b, vm, V2, objs, 0, 0) by defs(taut(hin3, nr3, tk, unt3, fpc, lg), mallocng_specs.freed_back)
  have ex3: ex A3. (A3 in mallocng.Abs && A3 in univ(1)) && mallocng_specs.freed_back(c, A, A3, b, vm, V2, objs, 0, 0) by ex_intro({A3}, taut(a3, u3, fb))
  // g's freed word: not the queue's
  have m28: all j. j in omega -> int_lt(j, 4) -> V1.bytes[int_add(int_add(g, 28), j)] = vm.bytes[int_add(int_add(g, 28), j)] proof
    fix j
    assume hj hjl
    let a := int_add(int_add(g, 28), j)
    have ao: a in omega by arith(go, hj)
    have al: int_lt(a, int_pow(2, 64)) by arith(top, hjl)
    have p1 p2 := mp(all_elim(away, {a}), ao, arith(hj), arith(hjl))
    have q := mp(all_elim(ob2, {a}), ao, taut(al, p1, p2))
    have ab: bits_of_int(64, a) = a by defs(arith(ao, al), bits_of_int, pow2)
    show := subst({y. V1.bytes[y] = vm.bytes[y]}, ab, q)
  qed
  have r28 := apply(mp.rd_same[v1 := V1, v2 := vm, a := int_add(g, 28), n := 4], arith(go), simp(), arith(top), m28)
  // the queue: only links written (the allocator's bytes)
  have onl: all x. mallocng.on_list(l2, x) <-> mallocng.on_list(L, x) || x = g proof
    fix x
    show := apply(mp.snoc_on[L := L, g := g, x := x], lt, go)
  qed
  have kold: all x. mallocng.on_list(L, x) -> mallocng.on_list(l2, x) proof
    fix x
    assume h
    show by taut(h, all_elim(onl, {x}))
  qed
  have knew: all x. mallocng.on_list(l2, x) -> !mallocng.on_list(L, x) -> mallocng.is_used(A, x) && A.metas[x].sizeclass = sc proof
    fix x
    assume h1 h2
    have e: x = g by taut(h1, h2, all_elim(onl, {x}))
    show := subst({y. mallocng.is_used(A, y) && A.metas[y].sizeclass = sc}, sym(e), conj(hg, refl({sc})))
  qed
  have sub: all x. mallocng.on_list(l2, x) -> mallocng.on_list(l2, x) proof
    fix x
    assume h
    show h
  qed
  have gone: all x. mallocng.on_list(l2, x) -> !mallocng.on_list(l2, x) -> gimple.bytes_at(V1, x, 8) = 0 && gimple.bytes_at(V1, int_add(x, 8), 8) = 0 proof
    fix x
    assume h1 h2
    show by taut(h1, h2)
  qed
  have P: mp.rlpre(c, A, vm, V1, b, objs, sc, l2, l2) by taut(hc, hu, ha, hb, vb, vb1, hh, hs, hsl, only1, at1, l2t, kold, knew, sub, gone)
  have kq := apply(mp.rl_unt, P)
  show by taut(r28, kq, ex3)
qed

// ----------------------------------------------------------------------
//  g off its class's list (free's dequeue, g anywhere on it): the state
//  relisted holds; only links written

theorem mp.dq_any(c, A, vm, V, b, objs, sc, k): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  vm in x86_64_linux.Vm -> V in x86_64_linux.Vm -> mallocng.holds_m(c, A, vm, b) -> mallocng.shown_in(c, A, objs) -> int_mod(c.ctx, 8) = 0 -> sc in omega -> int_lt(sc, 48) ->
  k in omega -> int_lt(k, seq_len(A.active[sc])) ->
  mallocng_specs.dequeued(vm, V, objs, int_add(int_add(c.ctx, mallocng.C_ACTIVE), int_mul(8, sc)), A.active[sc][k]) ->
  abs: mp.relist(A, sc, mallocng_specs.rm_at(A.active[sc], k), V) in mallocng.Abs && univ: mp.relist(A, sc, mallocng_specs.rm_at(A.active[sc], k), V) in univ(1) &&
  holds: mallocng.holds_m(c, mp.relist(A, sc, mallocng_specs.rm_at(A.active[sc], k), V), V, b) &&
  unt: mallocng.kept_outside(c, A, b, vm, V, empty) &&
  slots: mp.relist(A, sc, mallocng_specs.rm_at(A.active[sc], k), V).slots = A.slots &&
  list: mp.relist(A, sc, mallocng_specs.rm_at(A.active[sc], k), V).active[sc] = mallocng_specs.rm_at(A.active[sc], k) &&
  geom: mp.geom(A, mp.relist(A, sc, mallocng_specs.rm_at(A.active[sc], k), V)) &&
  at: mallocng_specs.list_at(V, objs, int_add(int_add(c.ctx, mallocng.C_ACTIVE), int_mul(8, sc)), mallocng_specs.rm_at(A.active[sc], k)) &&
  z0: gimple.bytes_at(V, A.active[sc][k], 8) = 0 && z8: gimple.bytes_at(V, int_add(A.active[sc][k], 8), 8) = 0
proof
  assume hc hu ha hb hv hV hh hsh cal hs hsl hk hkl hdq
  let PH := int_add(int_add(c.ctx, mallocng.C_ACTIVE), int_mul(8, sc))
  let L := A.active[sc]
  let n := seq_len(L)
  let RM := mallocng_specs.rm_at(L, k)
  have vb: vm.bytes in fn_space(bits(64), bits(8)) by simp(hv)
  have vb2: V.bytes in fn_space(bits(64), bits(8)) by simp(hV)
  have la := apply(mp.active_at[c := c, A := A, vm := vm, b := b, objs := objs, sc := sc], hc, hu, ha, vb, hh, hsh, cal, hs, hsl)
  have {H0 = inv} := expand(hh, mallocng.holds_m)
  have {cok = ctx, hac = active} := expand(H0, mallocng.holds)
  have {c11 = nactive} := expand(cok, mallocng.ctx_ok)
  have al0: A.active in list_type(list_type(omega)) by simp(ha)
  have ll := mp(at_type[l := A.active, t := list_type(omega), i := sc], al0, hs, (int_lt(sc, seq_len(A.active)) by arith(c11, hsl)))
  have no: n in omega by simp(ll)
  have r1 r2 r3 only := mp(all_elim(expand(hdq, mallocng_specs.dequeued), {L}, {k}), conj(ll, hk), taut(la, hkl, refl({L[k]})))
  have {rml = len, rmt = type} := apply(mp.rm_at_app[l := L, k := k, j := 0], ll, hk, hkl)
  have el: all j. j in omega -> int_lt(j, seq_len(RM)) -> RM[j] = L[ite(int_lt(j, k), j, int_add(j, 1))] proof
    fix j
    assume hj hjl
    have {re = elem} := apply(mp.rm_at_app[l := L, k := k, j := j], ll, hk, hkl)
    show := mp(re, hj, rewrite(rml, hjl))
  qed
  // (RM's groups: L's; the one only on L: L[k])
  have sub: all g. mallocng.on_list(RM, g) -> mallocng.on_list(L, g) proof
    fix g
    assume ol
    obtain j, hj hjl hje from expand(ol, mallocng.on_list)
    have e := trans(sym(mp(all_elim(el, {j}), hj, hjl)), hje)
    have c1: int_lt(j, k) -> mallocng.on_list(L, g) proof
      assume lt
      have e2: L[j] = g := rewrite(mp(ite_t[c := int_lt(j, k), a := j, b := int_add(j, 1)], lt), e)
      show by defs(ex_intro({j}, taut(hj, (int_lt(j, n) by arith(hjl, rml, no, hk, hkl)), e2)), mallocng.on_list)
    qed
    have c2: !int_lt(j, k) -> mallocng.on_list(L, g) proof
      assume ge
      have e2: L[int_add(j, 1)] = g := rewrite(mp(ite_f[c := int_lt(j, k), a := j, b := int_add(j, 1)], ge), e)
      show by defs(ex_intro({int_add(j, 1)}, taut((int_add(j, 1) in omega by simp(hj)), (int_lt(int_add(j, 1), n) by arith(hjl, rml, no, hj)), e2)), mallocng.on_list)
    qed
    show by taut(c1, c2)
  qed
  have onlyk: all g. mallocng.on_list(L, g) -> !mallocng.on_list(RM, g) -> g = L[k] proof
    fix g
    assume ol nl
    obtain j, hj hjl hje from expand(ol, mallocng.on_list)
    have c0: j = k -> g = L[k] proof
      assume jk
      show := trans(sym(hje), subst({y. L[j] = L[y]}, jk, refl({L[j]})))
    qed
    have c1: int_lt(j, k) -> g = L[k] proof
      assume lt
      have e := mp(all_elim(el, {j}), hj, arith(hjl, rml, lt, hkl, no))
      have e2: RM[j] = g := trans(rewrite(mp(ite_t[c := int_lt(j, k), a := j, b := int_add(j, 1)], lt), e), hje)
      have o2: mallocng.on_list(RM, g) by defs(ex_intro({j}, taut(hj, (int_lt(j, seq_len(RM)) by arith(hjl, rml, lt, hkl, no)), e2)), mallocng.on_list)
      show by taut(o2, nl)
    qed
    have c2: int_lt(k, j) -> g = L[k] proof
      assume gt
      have j1: int_sub(j, 1) in omega by arith(hj, gt, hk)
      have e := mp(all_elim(el, {int_sub(j, 1)}), j1, arith(hjl, rml, gt, hk, no))
      have nlt: !int_lt(int_sub(j, 1), k) by arith(gt)
      have i1 := mp(ite_f[c := int_lt(int_sub(j, 1), k), a := int_sub(j, 1), b := int_add(int_sub(j, 1), 1)], nlt)
      have i2: int_add(int_sub(j, 1), 1) = j by arith(hj)
      have e2: RM[int_sub(j, 1)] = g := trans(rewrite(i2, rewrite(i1, e)), hje)
      have o2: mallocng.on_list(RM, g) by defs(ex_intro({int_sub(j, 1)}, taut(j1, (int_lt(int_sub(j, 1), seq_len(RM)) by arith(hjl, rml, gt, hk, no)), e2)), mallocng.on_list)
      show by taut(o2, nl)
    qed
    show by taut(c0, c1, c2, (j = k || int_lt(j, k) || int_lt(k, j) by arith(hj, hk)))
  qed
  // its links cleared
  have mko := apply(at_type[l := L, t := omega, i := k], ll, hk, hkl)
  have {mel = elems} := expand(la, mallocng_specs.list_at)
  have mb _ _ _ _ := mp(all_elim(mel, {k}), hk, hkl)
  have z0: gimple.bytes_at(V, L[k], 8) = 0 proof
    have bo bl := mp(all_elim(g.bytes_bound, {V}, {L[k]}, {8}), vb2, simp())
    show by arith(expand(r2, mallocng_specs.rd64, bits_of_int, pow2), bo, bl)
  qed
  have z8: gimple.bytes_at(V, int_add(L[k], 8), 8) = 0 proof
    have ba: bits_add(64, L[k], 8) = int_add(L[k], 8) by defs(arith(mko, mb), bits_add, pow2)
    have bo bl := mp(all_elim(g.bytes_bound, {V}, {int_add(L[k], 8)}, {8}), vb2, simp())
    show by arith(expand(rewrite(ba, r3), mallocng_specs.rd64, bits_of_int, pow2), bo, bl)
  qed
  have gone: all g. mallocng.on_list(L, g) -> !mallocng.on_list(RM, g) -> gimple.bytes_at(V, g, 8) = 0 && gimple.bytes_at(V, int_add(g, 8), 8) = 0 proof
    fix g
    assume ol nl
    have e := mp(all_elim(onlyk, {g}), ol, nl)
    show := rewrite(sym(e), conj(z0, z8))
  qed
  have kold: all g. mallocng.on_list(L, g) -> mallocng.on_list(L, g) proof
    fix g
    assume h
    show h
  qed
  have knew: all g. mallocng.on_list(L, g) -> !mallocng.on_list(L, g) -> mallocng.is_used(A, g) && A.metas[g].sizeclass = sc proof
    fix g
    assume h1 h2
    show by taut(h1, h2)
  qed
  have P: mp.rlpre(c, A, vm, V, b, objs, sc, RM, L) by taut(hc, hu, ha, hb, vb, vb2, hh, hs, hsl, only, r1, rmt, kold, knew, sub, gone)
  // past RM's head: past L's head (full, some freed)
  have htail: all j. j in omega -> int_lt(0, j) -> int_lt(j, seq_len(RM)) -> A.metas[RM[j]].avail = 0 && !(A.metas[RM[j]].freed = 0) proof
    fix j
    assume hj hj0 hjl
    have e := mp(all_elim(el, {j}), hj, hjl)
    let J := ite(int_lt(j, k), j, int_add(j, 1))
    have jt: int_lt(j, k) -> J in omega && int_lt(0, J) && int_lt(J, n) proof
      assume x
      have ij := mp(ite_t[c := int_lt(j, k), a := j, b := int_add(j, 1)], x)
      show := subst({y. y in omega && int_lt(0, y) && int_lt(y, n)}, sym(ij), (j in omega && int_lt(0, j) && int_lt(j, n) by arith(hj, hj0, x, hkl)))
    qed
    have jf: !int_lt(j, k) -> J in omega && int_lt(0, J) && int_lt(J, n) proof
      assume x
      have ij := mp(ite_f[c := int_lt(j, k), a := j, b := int_add(j, 1)], x)
      show := subst({y. y in omega && int_lt(0, y) && int_lt(y, n)}, sym(ij), (int_add(j, 1) in omega && int_lt(0, int_add(j, 1)) && int_lt(int_add(j, 1), n) by arith(hj, hjl, rml, no)))
    qed
    have jo jp jl := (J in omega && int_lt(0, J) && int_lt(J, n) by taut(jt, jf))
    have _ _ t3 := mp(all_elim(expand(hac, mallocng.active_ok), {sc}, {J}), conj(hs, jo), conj(hsl, jl))
    show := rewrite(sym(e), mp(t3, jp))
  qed
  have nz := apply(mp.init_of_list, H0, hs, hsl, (int_lt(0, n) by arith(hkl, hk)))
  have hr := apply(mp.holds_relist, P, htail, nz)
  have {a2 = abs, u2 = univ} := apply(mp.relist_abs[A := A, sc := sc, l2 := RM, vm := V], ha, rmt, vb2)
  have ut := apply(mp.rl_unt, P)
  have rsl: mp.relist(A, sc, RM, V).slots = A.slots by defs(simp(), mp.relink)
  have {lt = list} := apply(mp.relist_at[A := A, sc := sc, l2 := RM, vm := V], ha)
  have rs: mp.relist(A, sc, RM, V).active[sc] = RM := trans(mp(all_elim(lt, {sc}), hs, (int_lt(sc, seq_len(A.active)) by arith(c11, hsl))), mp(ite_t[c := sc = sc, a := RM, b := A.active[sc]], refl({sc})))
  have {gm = geom} := apply(mp.relist_geom[A := A, sc := sc, l2 := RM, vm := V], ha)
  show by taut(a2, u2, hr, ut, rsl, rs, gm, r1, z0, z8)
qed

// (a step keeping the groups' geometry -- a list or masks changed --,
// only the allocator's bytes written, then a step giving back: given back
// from the first state)
theorem mp.fb_geom(c, A, A1, A3, b, V0, V1, V3, objs, mb, ml): A in mallocng.Abs -> mp.geom(A, A1) -> mallocng.kept_outside(c, A, b, V0, V1, empty) ->
  mallocng_specs.freed_back(c, A1, A3, b, V1, V3, objs, mb, ml) -> mallocng_specs.freed_back(c, A, A3, b, V0, V3, objs, mb, ml)
proof
  assume ha gm kp fb
  have hin3 nr3 tk3 unt13 fp3 lg3 := expand(fb, mallocng_specs.freed_back)
  have efp := apply(mp.gm_fp[c := c, A := A, A2 := A1, b := b], ha, gm)
  have gs := apply(mp.geoms_of[A := A, A2 := A1], ha, gm)
  have tk1: A1.taken = A.taken := apply(mp.gs_field[A := A, A2 := A1, k := "taken"], gs, simp(), simp(), simp(), simp())
  have tk: A3.taken = A.taken := trans(tk3, tk1)
  let E := set_select(omega, x0. mallocng.in_reserved(A, x0))
  let E1 := set_select(omega, x0. mallocng.in_reserved(A1, x0))
  have ir: all a. mallocng.in_reserved(A1, a) <-> mallocng.in_reserved(A, a) proof
    fix a
    show := apply(mp.gm_inres[A := A, A2 := A1, a := a], ha, gm)
  qed
  have sub: all a. a in omega -> !(a in mallocng.footprint(c, A, b)) -> !(a in E) -> !(a in mallocng.footprint(c, A1, b)) && !(a in E1) proof
    fix a
    assume ho n1 n2
    have m1: !(a in mallocng.footprint(c, A1, b)) := rewrite(sym(efp), n1)
    have m2: !(a in E1) by taut(n2, all_elim(ir, {a}), set_select_def[s := omega, p := x0. mallocng.in_reserved(A, x0), z := a],
      set_select_def[s := omega, p := x0. mallocng.in_reserved(A1, x0), z := a])
    show by taut(m1, m2)
  qed
  have u01 := apply(mp.kept_unt[c := c, A := A, b := b, vm := V0, V := V1, objs := objs, e := E], apply(mp.unt_wider[c := c, A := A, b := b, V0 := V0, V1 := V1, e := E], kp))
  have u13 := apply(mp.unt_shrink[c := c, A := A, A1 := A1, b := b, V0 := V1, V1 := V3, objs := objs, e := E, e1 := E1], unt13, sub)
  have triv: all a. a in omega -> a in mallocng.footprint(c, A, b) -> a in mallocng.footprint(c, A, b) || !x86_64_linux.mapped(V0, int_div(a, x86_64_linux.PAGE)) proof
    fix a
    assume _ f
    show by taut(f)
  qed
  have unt03 := apply(mp.unt_seq[c := c, A := A, A1 := A, b := b, V0 := V0, V1 := V1, V2 := V3, objs := objs, e := E], u01, u13, triv)
  have fpc: all a. a in omega -> a in mallocng.footprint(c, A3, b) -> a in mallocng.footprint(c, A, b) || mallocng.in_reserved(A, a) proof
    fix a
    assume ho f
    have q := rewrite(efp, mp(all_elim(fp3, {a}), ho, f))
    show by taut(q, all_elim(ir, {a}))
  qed
  have lg: mallocng_specs.let_go(c, A, A3, b, mb, ml) proof
    have l := expand(lg3, mallocng_specs.let_go)
    have c1: ml = 0 -> mallocng_specs.let_go(c, A, A3, b, mb, ml) proof
      assume z
      show by defs(taut(z), mallocng_specs.let_go)
    qed
    have c2: ((int_mod(mb, 4096) = 0 && int_mod(ml, 4096) = 0) && int_lt(0, mb)) &&
        (all x0. x0 in omega -> int_le(mb, x0) && int_lt(x0, int_add(mb, ml)) -> (x0 in mallocng.footprint(c, A1, b) || mallocng.in_reserved(A1, x0)) &&
           !(x0 in mallocng.footprint(c, A3, b))) -> mallocng_specs.let_go(c, A, A3, b, mb, ml) proof
      assume q
      have qa qb qc q2 := q
      have q3: all x0. x0 in omega -> int_le(mb, x0) && int_lt(x0, int_add(mb, ml)) -> (x0 in mallocng.footprint(c, A, b) || mallocng.in_reserved(A, x0)) &&
          !(x0 in mallocng.footprint(c, A3, b)) proof
        fix a
        assume ho hr
        have w := rewrite(efp, mp(all_elim(q2, {a}), ho, hr))
        show by taut(w, all_elim(ir, {a}))
      qed
      show by defs(taut(qa, qb, qc, q3), mallocng_specs.let_go)
    qed
    show by taut(l, c1, c2)
  qed
  show by defs(taut(hin3, nr3, tk, unt03, fpc, lg), mallocng_specs.freed_back)
qed

// (free_group's premises over such a step: the invariant on the new
// memory given, the rest carried)
theorem mp.fg_pre_geom(c, A, A1, b, vm, V1, objs, fs, g): c in mallocng.Cfg -> A in mallocng.Abs -> mp.geom(A, A1) ->
  mallocng.holds_m(c, A1, V1, b) -> mallocng.kept_outside(c, A, b, vm, V1, empty) -> fs in bits(64) ->
  mallocng.holds_in(c, A, vm, objs, b) -> abi.thread_ok(vm, fs) -> mallocng_specs.tls_apart(c, A, b, fs) -> mallocng_specs.tls_unres(A, fs) ->
  mallocng.is_used(A, g) -> mallocng.emptied(A, g) ->
  hin: mallocng.holds_in(c, A1, V1, objs, b) && thread: abi.thread_ok(V1, fs) && tls: mallocng_specs.tls_apart(c, A1, b, fs) &&
  unres: mallocng_specs.tls_unres(A1, fs) && used: mallocng.is_used(A1, g) && emp: mallocng.emptied(A1, g) && len: seq_len(A1.used) = seq_len(A.used)
proof
  assume hc ha gm hh1 kp fsb hin hth htl htr hg hemp
  have {hsh = shown} := expand(hin, mallocng.holds_in)
  have sh1 := apply(mp.shown_geom[c := c, A := A, A2 := A1, objs := objs], ha, gm, hsh)
  have hin1: mallocng.holds_in(c, A1, V1, objs, b) by defs(taut(hh1, sh1), mallocng.holds_in)
  have th1 := apply(mp.tls_kept[c := c, A := A, b := b, V0 := vm, V1 := V1, fs := fs, e := empty], fsb, hth, htl, kp,
    (all j. j in omega -> int_lt(j, 8) -> !(int_add(fs, j) in empty) by simp()))
  have efp := apply(mp.gm_fp[c := c, A := A, A2 := A1, b := b], ha, gm)
  have tl1: mallocng_specs.tls_apart(c, A1, b, fs) by defs(rewrite(sym(efp), expand(htl, mallocng_specs.tls_apart)), mallocng_specs.tls_apart)
  have tr0 := expand(htr, mallocng_specs.tls_unres)
  have tr1: all j. j in omega -> int_lt(j, 8) -> !mallocng.in_reserved(A1, int_add(fs, j)) proof
    fix j
    assume hj hjl
    have e := apply(mp.gm_inres[A := A, A2 := A1, a := int_add(fs, j)], ha, gm)
    show by taut(e, (!mallocng.in_reserved(A, int_add(fs, j)) by simp(mp(all_elim(tr0, {j}), hj, hjl))))
  qed
  have tu1: mallocng_specs.tls_unres(A1, fs) by defs(simp(tr1), mallocng_specs.tls_unres)
  have gs := apply(mp.geoms_of[A := A, A2 := A1], ha, gm)
  have eu: A1.used = A.used := apply(mp.gs_field[A := A, A2 := A1, k := "used"], gs, simp(), simp(), simp(), simp())
  have {oth = others} := gm
  have es0 := subst({y. app(y, "slots") = A.slots}, sym(oth), refl({A.slots}))
  have es: A1.slots = A.slots by simp(es0)
  have hg1: mallocng.is_used(A1, g) by defs(rewrite(sym(eu), expand(hg, mallocng.is_used)), mallocng.is_used)
  have he1: mallocng.emptied(A1, g) by defs(rewrite(sym(es), expand(hemp, mallocng.emptied)), mallocng.emptied)
  have el: seq_len(A1.used) = seq_len(A.used) by simp(eu)
  show by taut(hin1, th1, tl1, tu1, hg1, he1, el)
qed

// ----------------------------------------------------------------------
//  okay_to_free at a call: an overflow, or an answer, not 0 for a group
//  mapped on its own

// (its run, the memory as before as a memory written)
theorem mp.otf_run2(c, g, s, h, o, gst, gib): c in mallocng.Cfg -> c.ctx = c_src_malloc_mallocng_malloc.__malloc_context ->
  c.sct = c_src_malloc_mallocng_malloc.__malloc_size_classes -> g in bits(64) ->
  s in abi.World -> h in mp.G -> mallocng.holds_m(c, h.A, s.vm, h.blocks) -> mallocng.shown_in(c, h.A, s.objs) -> abi.thread_ok(s.vm, s.fs_base) ->
  mallocng.is_used(h.A, g) -> mp.calls(gst, c_src_malloc_mallocng_malloc.get_stride_fun()) -> mp.ib_call(c, gib) ->
  runs(c_src_malloc_mallocng_free.okay_to_free(g, gst, gib), s, o) ->
  abi.ovf_out(s, o) || (ex V r. (V = s.vm && (mallocng.own_mapping(h.A.metas[g]) -> !(bits_of_int(32, r) = 0))) && o = ok(fn_update(s, "vm", V), bits_of_int(32, r)))
proof
  assume hc hx hsct hg hs hh hin hsh hth hu hgst hib hr
  have run := apply(mp.otf_run[c := c, g := g, s := s, h := h, o := o, gst := gst, gib := gib], hc, hx, hsct, hg, hs, hh, hin, hsh, hth, hu, hgst, hib, hr)
  have _ vf vd _ := apply(ms.world_parts, hs)
  have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], vf, vd)
  have k: case 2 of run proof
    assume e
    obtain r, ho hb hy from e
    have ro rl := (r in omega && int_lt(r, pow2(32)) by simp(hb, keep(pow2)))
    have br: bits_of_int(32, r) = r by defs(arith(ro, rl), bits_of_int)
    have ho2 := rewrite(sym(br), rewrite(sym(ss), ho, {1}))
    show by disj({2}, ex_intro({s.vm}, {r}, taut(refl({s.vm}), rewrite(sym(br), hy), ho2)))
  qed
  show by taut(run, k)
qed

theorem mp.otf_q(c, gst, gib, g, t, h, regs, o2): c in mallocng.Cfg -> c.ctx = c_src_malloc_mallocng_malloc.__malloc_context ->
  c.sct = c_src_malloc_mallocng_malloc.__malloc_size_classes -> g in bits(64) -> t in abi.World -> h in mp.G ->
  mallocng.holds_m(c, h.A, t.vm, h.blocks) -> mallocng.shown_in(c, h.A, t.objs) -> abi.thread_ok(t.vm, t.fs_base) -> mallocng.is_used(h.A, g) ->
  mp.calls(gst, c_src_malloc_mallocng_malloc.get_stride_fun()) -> mp.ib_call(c, gib) ->
  gc.regs_ok(regs, seq_one(gimple.arg(64, g))) -> runs(c_src_malloc_mallocng_free.okay_to_free_fun(gst, gib)[regs], t, o2) ->
  abi.ovf_out(t, o2) || (ex r. o2 = ok(fn_update(t, "vm", t.vm), r) && (mallocng.own_mapping(h.A.metas[g]) -> !(bits_of_int(32, fst(r)) = 0)))
proof
  assume hc hx hsct hg hw hh hin hsh hth hu hgst hib hro hr
  have rl rn r0 := apply(gc.regs1, hg, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  have o1l: ord_le(1, seq_len(regs)) by defs(simp(rn), ord_le)
  have bp: bits_of_int(64, regs[0]) = g by defs(simp(r0, hg), bits_of_int, pow2)
  step o3 V r u y, e hs1 hs2 from hr with o1l, bp, mp.otf_run2, g.result32_inv using ra, hc, hx, hsct, hg, hw, hh, hin, hsh, hth, hu, hgst, hib
  have nb: ex x0. x0 in bits(64) by ex_intro({0}, (0 in bits(64) by simp()))
  have e2: ex x0. x0 in bits(64) && o2 = ok(fn_update(t, "vm", V), pair(y, x0)) by taut(expand(e, any_rel), nb)
  obtain z, _ he from e2
  have hv hy := hs1
  have _ hyr := hs2
  have k1: mallocng.own_mapping(h.A.metas[g]) -> !(bits_of_int(32, fst(pair(y, z))) = 0) proof
    assume ow
    have n := mp(hy, ow)
    show by simp(rewrite(sym(hyr), n))
  qed
  show by disj({2}, ex_intro({pair(y, z)}, taut(rewrite(hv, he), k1)))
qed

// ----------------------------------------------------------------------
//  nontrivial_free's run

theorem mp.nf_dev(c, n, otf, gst, gib, ac, dq, ag, fg, qu, ao, g, i, s, h, o): c in mallocng.Cfg -> c.ctx = c_src_malloc_mallocng_malloc.__malloc_context ->
  c.sct = c_src_malloc_mallocng_malloc.__malloc_size_classes -> n in omega -> g in bits(64) -> i in bits(32) ->
  s in abi.World -> h in mp.G -> int_le(seq_len(h.A.used), n) ->
  mallocng.holds_in(c, h.A, s.vm, s.objs, h.blocks) -> abi.thread_ok(s.vm, s.fs_base) -> mallocng_specs.tls_apart(c, h.A, h.blocks, s.fs_base) ->
  mallocng_specs.tls_unres(h.A, s.fs_base) -> mallocng.is_used(h.A, g) -> mallocng.reserved_only(h.A, g, i) ->
  mp.calls(otf, c_src_malloc_mallocng_free.okay_to_free_fun(gst, gib)) -> mp.calls(gst, c_src_malloc_mallocng_malloc.get_stride_fun()) -> mp.ib_call(c, gib) ->
  mp.calls(ac, c_src_malloc_mallocng_free.a_crash_fun()) -> mp.calls(dq, mallocng_specs.dequeue_spec_fun()) -> mp.ag_call(c, ag) -> mp.fg_call(c, fg, n) ->
  mp.calls(qu, mallocng_specs.queue_spec_fun()) -> mp.aor_call(ao) ->
  runs(c_src_malloc_mallocng_free.nontrivial_free(g, i, otf, ac, dq, ag, fg, qu, ao), s, o) -> true
proof
  assume hc hx hsct hn hgb hib hs hh hdep hin hth htl htr hus hro hotf hgst hgib hac hdq hag hfg hqu hao hr
  have ths: gc.sound(s) by simp(hth)
  let A := h.A
  let B := h.blocks
  let V0 := s.vm
  let FP := mallocng.held(c, A, B)
  have {hhm = mem, hsh = shown} := expand(hin, mallocng.holds_in)
  have hu0 _ hbt hat := mp(all_elim(mp.g_rec, {h}), hh)
  have au: A in univ(1) by simp(hu0)
  have su: s in univ(1) by simp(apply(g.runs_univ, expand(hr, c_src_malloc_mallocng_free.nontrivial_free)))
  have vV vfun vdom vb := apply(ms.world_parts, hs)
  have VS := apply(mp.held_vis[c := c, A := A, objs := s.objs, b := B], hsh)
  // the meta's 40 bytes: accessible
  have go g24 inr := apply(mp.meta_mem, hc, au, hat, hhm, hus)
  have top _ := apply(mp.meta_word, hc, au, hat, hhm, hus)
  have um: all x n2. x in omega -> n2 in omega -> int_le(g, x) -> int_le(int_add(x, n2), int_add(g, 40)) -> gimple.usable(V0, s.objs, x, n2, false) proof
    fix x n2
    assume hx0 hn2 hl hu
    have bj: all j. j in omega -> int_lt(j, n2) -> int_add(x, j) in FP && mallocng.m_mapped(mallocng.mview(V0, FP), int_add(x, j)) &&
        snd(mallocng.pg(mallocng.mview(V0, FP), int_add(x, j))).prot.r && !(snd(mallocng.pg(mallocng.mview(V0, FP), int_add(x, j))).kind = 2) proof
      fix j
      assume hj hjl
      have r1 r2 r3 := mp(all_elim(inr, {int_add(x, j)}), arith(hx0, hj), arith(hl, hj), arith(hu, hjl, hj))
      show by taut(r1, expand(r2, mallocng.m_rw), r3)
    qed
    show := apply(mp.view_usable[vm := V0, fp := FP, objs := s.objs, a := x, n := n2], hx0, bj, VS)
  qed
  have gnz: !(g = 0) by arith(g24)
  have g24b: int_lt(int_add(g, 24), pow2(64)) by defs(arith(top), pow2)
  have g28b: int_lt(int_add(g, 28), pow2(64)) by defs(arith(top), pow2)
  have g32: int_lt(int_add(g, 32), pow2(64)) by defs(arith(top), pow2)
  have md2: g.mem_defined(s, g, 32, 2, false) by simp(gnz, g32, mp(all_elim(um, {int_add(g, 32)}, {2}), arith(go), simp(), arith(), arith()))
  have md1: g.mem_defined(s, g, 32, 1, false) by simp(gnz, g32, mp(all_elim(um, {int_add(g, 32)}, {1}), arith(go), simp(), arith(), arith()))
  have mdav: g.mem_defined(s, g, 24, 4, false) by simp(gnz, g24b, mp(all_elim(um, {int_add(g, 24)}, {4}), arith(go), simp(), arith(), arith()))
  have mdfr: g.mem_defined(s, g, 28, 4, false) by simp(gnz, g28b, mp(all_elim(um, {int_add(g, 28)}, {4}), arith(go), simp(), arith(), arith()))
  // (i a slot of g: below 32)
  have {H = inv} := expand(hhm, mallocng.holds_m)
  have {uo = used} := expand(H, mallocng.holds)
  have gok := apply(mp.used_group, uo, hus)
  have {mim, hns = nslots} := expand(gok, mallocng.group_ok)
  have _ _ _ _ _ _ bl bf bs := expand(mim, mallocng.meta_in_memory)
  have hil hrs _ := expand(hro, mallocng.reserved_only)
  have io: i in omega by simp(hib)
  have il32: int_lt(i, 32) by arith(hil, hns, bl)
  have o32: bits_of_int(32, 1) in bits(32) by simp()
  step l1 l2 l3 l4 l5 l6 x7, c1 from hr with ms.shl32_det, g.ldbf_det, g.ld32_det using conj(su, hgb, hib, io, il32, o32, md2, md1, mdav, mdfr)
  // the masks, the last index, the class read: g's meta's
  have {mav = avail, mfr = freed} := expand(mim, mallocng.meta_in_memory)
  have inm: all o n2. o in omega -> n2 in omega -> int_le(int_add(o, n2), 40) -> (all j. j in omega -> int_lt(j, n2) -> int_add(int_add(g, o), j) in FP) proof
    fix o n2
    assume ho hn2 hl
    fix j
    assume hj hjl
    have r1 _ _ := mp(all_elim(inr, {int_add(int_add(g, o), j)}), arith(go, ho, hj), arith(go, ho, hj), arith(go, ho, hj, hjl, hl))
    show := r1
  qed
  have v24 := apply(mp.view_read[vm := V0, fp := FP, a := int_add(g, 24), n := 4], arith(go), simp(), arith(), mp(all_elim(inm, {24}, {4}), simp(), simp(), simp()))
  have v28 := apply(mp.view_read[vm := V0, fp := FP, a := int_add(g, 28), n := 4], arith(go), simp(), arith(), mp(all_elim(inm, {28}, {4}), simp(), simp(), simp()))
  have bb24 _ := mp(all_elim(g.bytes_bound, {V0}, {int_add(g, 24)}, {4}), vb, simp())
  have bb28 _ := mp(all_elim(g.bytes_bound, {V0}, {int_add(g, 28)}, {4}), vb, simp())
  have bh24 := mp(all_elim(g.bytes_bound, {V0}, {int_add(g, 24)}, {4}), vb, simp())
  have bh28 := mp(all_elim(g.bytes_bound, {V0}, {int_add(g, 28)}, {4}), vb, simp())
  have p4: int_pow(256, 4) = 4294967296 by simp()
  have eAv: bits_of_int(32, gimple.bytes_at(V0, int_add(g, 24), 4)) = A.metas[g].avail by defs(arith(v24, mav, bh24, p4), bits_of_int, pow2)
  have eFr: bits_of_int(32, gimple.bytes_at(V0, int_add(g, 28), 4)) = A.metas[g].freed by defs(arith(v28, mfr, bh28, p4), bits_of_int, pow2)
  let W := gimple.bytes_at(V0, int_add(g, 32), 8)
  have _ mw := apply(mp.meta_word, hc, au, hat, hhm, hus)
  have vt: A.metas[g] in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A.metas, x := g], simp(hat), go)
  have vl: A.metas[g].last_idx in omega by simp(vt)
  have vsc: A.metas[g].sizeclass in omega by simp(vt)
  have vml: A.metas[g].maplen in omega by simp(vt)
  have gsw := mp(all_elim(ms.gs_word, {V0}, {g}), vb, hgb, top)
  have a32 .. := gsw
  have _ wb _ _ _ g4 := gsw
  have mwd: mallocng_specs.mword(V0, g) = W by defs(simp(a32), mallocng_specs.mword)
  have wv: W = int_add(int_add(int_add(A.metas[g].last_idx, int_mul(32, A.metas[g].freeable)), int_mul(64, A.metas[g].sizeclass)), int_mul(4096, A.metas[g].maplen))
    := rewrite(mwd, mw)
  have gl5 _ _ _ := mp(all_elim(ms.gm_word, {V0}, {g}), vb, hgb, top)
  have eLI := trans(gl5, (int_mod(W, 32) = A.metas[g].last_idx by arith(wv, bl, bf, bs, vl, vsc, vml)))
  let SC6 := bits_of_int(6, int_mod(int_div(gimple.bytes_at(V0, int_add(g, 32), 2), int_pow(2, 6)), int_pow(2, 6)))
  have csc: int_mod(int_div(W, 64), 64) = A.metas[g].sizeclass by arith(wv, bl, bf, bs, vl, vsc, vml)
  have e6: SC6 = A.metas[g].sizeclass := trans((SC6 = int_mod(int_div(W, 64), 64) by simp(g4)), csc)
  have c1r := rewrite(eLI, rewrite(eFr, rewrite(eAv, c1)))
  // the test: all g's slots but i free
  have gom: g in omega by arith(go)
  have {sin, each, clr, high, il, lt} := apply(mp.nf_masks[A := A, M := mallocng.mview(V0, FP), b := B, g := g, i := i], hat, gom, gok, io, hil, hrs)
  have ft := mp(mp.full_test[S := bits_or(32, A.metas[g].freed, A.metas[g].avail), i := i, L := A.metas[g].last_idx], sin, io, vl, il, lt, clr, high)
  have tb1 kx1 := c1r
  // where the test's ways meet: an overflow, g given back whole (returned),
  // or on to the freed mask (g then no own mapping)
  let MASK := bits_or(32, A.metas[g].freed, A.metas[g].avail)
  let SELF := bits_shl(32, bits_of_int(32, 1), i)
  let LOCv := pair(l1, pair(l2, pair(l3, pair(MASK, pair(SC6, SELF)))))
  let OVF := exc_val("stack_overflow", empty)
  let FB(V, rr) := V in x86_64_linux.Vm && (ex A2. (A2 in mallocng.Abs && A2 in univ(1)) && mallocng_specs.freed_back(c, A, A2, B, V0, V, s.objs, fst(rr), snd(rr)))
  let GOAL := abi.ovf_out(s, o) || (ex V rr. FB(V, rr) && o = ok(fn_update(s, "vm", V), rr))
  let T2 := (ex v ob L. (v in x86_64_linux.Vm && ob in abi.Objs) && x7 = exc(pair(fn_update(fn_update(s, "vm", v), "objs", ob), L), pair("raise", OVF))) ||
    (ex V L rr. FB(V, rr) && x7 = exc(pair(fn_update(s, "vm", V), L), pair("ret", rr))) ||
    (x7 = ok(pair(s, LOCv), empty) && !mallocng.own_mapping(A.metas[g]))
  // (a_or's word: g's freed mask, accessible)
  have uw28: gimple.usable(V0, s.objs, int_add(g, 28), 4, true) proof
    have bj: all j. j in omega -> int_lt(j, 4) -> int_add(int_add(g, 28), j) in FP && mallocng.m_mapped(mallocng.mview(V0, FP), int_add(int_add(g, 28), j)) &&
        snd(mallocng.pg(mallocng.mview(V0, FP), int_add(int_add(g, 28), j))).prot.w && !(snd(mallocng.pg(mallocng.mview(V0, FP), int_add(int_add(g, 28), j))).kind = 2) proof
      fix j
      assume hj hjl
      have r1 r2 r3 := mp(all_elim(inr, {int_add(int_add(g, 28), j)}), arith(go, hj), arith(go, hj), arith(go, hj, hjl))
      have m1 _ m3 := expand(r2, mallocng.m_rw)
      show by taut(r1, m1, m3, r3)
    qed
    show := apply(mp.view_usable_w[vm := V0, fp := FP, objs := s.objs, a := int_add(g, 28), n := 4], arith(go), bj, VS)
  qed
  have ur28 := mp(all_elim(um, {int_add(g, 28)}, {4}), arith(go), simp(), arith(), arith())
  have finish: T2 -> GOAL proof
    assume ht2
    have f1: case 1 of ht2 proof
      assume e
      obtain v ob L, hv hob hx from e
      step oe from rewrite(hx, kx1)
      show by disj({1}, ex_intro({v}, {ob}, taut(hv, hob, oe)))
    qed
    have f2: case 2 of ht2 proof
      assume e
      obtain V L rr, hv hfb hx from e
      step oe from rewrite(hx, kx1)
      show by disj({2}, ex_intro({V}, {rr}, taut(hv, hfb, oe)))
    qed
    have f3: case 3 of ht2 proof
      assume e
      have hx7 hno := e
      step k1 from rewrite(hx7, kx1)
      // (a_or: the freed word or'ed with g's bit)
      have p28: bits_add(64, g, 28) = int_add(g, 28) by defs(arith(go, top), bits_add, pow2)
      have g4b: int_le(int_add(int_add(g, 28), 4), int_pow(2, 64)) by arith(top)
      have acp: mallocng_specs.a_cas_pre(V0, s.objs, int_add(g, 28)) by defs(simp(g4b, ur28, uw28, (!(int_add(g, 28) = 0) by arith(go))), mallocng_specs.a_cas_pre)
      have s1 := mp(mp.shl1[i := i], io, il32)
      have sb: SELF in bits(32) by simp(s1)
      // (the word written: g's freed mask with i's bit added)
      have nfi: !bit(A.metas[g].freed, i) by taut(mp(all_elim(each, {i}), io, arith(il, lt)), clr)
      have fbits: A.metas[g].freed in bits(32) := rewrite(eFr, (bits_of_int(32, gimple.bytes_at(V0, int_add(g, 28), 4)) in bits(32) by simp()))
      have ad := mp(mp.add_bit[S := A.metas[g].freed, i := i], fbits, io, il32, nfi)
      have xval: bits_or(32, A.metas[g].freed, SELF) = int_add(A.metas[g].freed, pow2(i)) :=
        subst({y. bits_or(32, A.metas[g].freed, y) = int_add(A.metas[g].freed, pow2(i))}, sym(s1), sym(ad))
      have mn: !(MASK = 0) -> GOAL proof
        assume hm
        step k2 from k1 with hm
        have g28c: int_add(g, 28) in bits(64) by arith(go, top)
        have sv28: gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), 28) = 28 by defs(simp(), gimple.sval)
        step V2 r2, oe hR from k2 with g.padd_det, hao using conj(hs, su, ths, hgb, g28c, sb, acp)
        have v2V ev2 := rewrite(sv28, hR)
        have ex2 := rewrite(xval, rewrite(eFr, ev2))
        have uo := apply(mp.unres_out[c := c, A := A, vm := V0, objs := s.objs, b := B, g := g, i := i], hc, au, hat, hbt, vV, hin, hus, io, hro, hno)
        have fb: ex A2. (A2 in mallocng.Abs && A2 in univ(1)) && mallocng_specs.freed_back(c, A, A2, B, V0, V2, s.objs, fst(pair(0, 0)), snd(pair(0, 0)))
          by simp(rewrite(sym(ex2), uo), keep(mallocng_specs.freed_back))
        show by disj({2}, ex_intro({V2}, {pair(0, 0)}, taut(v2V, fb, oe)))
      qed
      // g full (no slot free but i): queued if not its list's head
      have mz: MASK = 0 -> GOAL proof
        assume hm
        have abits: A.metas[g].avail in bits(32) := rewrite(eAv, (bits_of_int(32, gimple.bytes_at(V0, int_add(g, 24), 4)) in bits(32) by simp()))
        have f0 a0 := apply(mp.or_zero[x := A.metas[g].freed, y := A.metas[g].avail], fbits, abits, hm)
        have s48: int_lt(A.metas[g].sizeclass, 48) proof
          have k: int_le(48, A.metas[g].sizeclass) -> mallocng.own_mapping(A.metas[g]) proof
            assume x
            show by defs(taut(x), mallocng.own_mapping)
          qed
          show by arith(vsc, (!int_le(48, A.metas[g].sizeclass) by taut(k, hno)))
        qed
        have sC := apply(ms.sint_small, vsc, (int_lt(A.metas[g].sizeclass, 2147483648) by arith(s48)))
        have sI: sint(32, SC6) = A.metas[g].sizeclass by simp(e6, sC)
        have s47: sint(32, 47) = 47 by defs(simp(), sint, pow2)
        have scs: !int_lt(sint(32, 47), sint(32, SC6)) by arith(sI, s47, s48)
        // (the list's head word)
        let CF := c_src_malloc_mallocng_free.__malloc_context
        have cf: CF = 4227328 by defs(simp(), c_src_malloc_mallocng_free.__malloc_context)
        have cv: c_src_malloc_mallocng_malloc.__malloc_context = 4227328 by defs(simp(), c_src_malloc_mallocng_malloc.__malloc_context)
        have ca: mallocng.C_ACTIVE = 80 by defs(refl({80}), mallocng.C_ACTIVE)
        have kb: CF in bits(64) by simp(cf)
        have cnz: !(CF = 0) by simp(cf)
        have sc1 sc2 := (SC6 in omega && int_lt(SC6, 48) by arith(e6, vsc, s48))
        have sx := apply(ms.sext_small, (SC6 in bits(32) by arith(sc1, sc2)), arith(sc1, sc2))
        have sv80: gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), 80) = 80 by defs(simp(), gimple.sval)
        let UA := int_add(int_add(CF, 80), int_mul(8, SC6))
        let PH := int_add(int_add(c.ctx, mallocng.C_ACTIVE), int_mul(8, A.metas[g].sizeclass))
        have uph: UA = PH by arith(cf, hx, cv, e6, ca)
        have cal: int_mod(c.ctx, 8) = 0 by arith(hx, cv)
        have la := apply(mp.active_at[c := c, A := A, vm := V0, b := B, objs := s.objs, sc := A.metas[g].sizeclass], hc, au, hat, vb, hhm, hsh, cal, vsc, s48)
        have {hok = head} := expand(la, mallocng_specs.list_at)
        have _ pb ur8 _ := expand(hok, mallocng_specs.word_ok)
        have uab: UA in bits(64) by arith(cf, sc1, sc2)
        have u0: int_add(UA, 0) = UA by arith(uab)
        have uu: gimple.usable(V0, s.objs, UA, 8, false) by simp(rewrite(sym(uph), ur8), u0)
        have umd: g.mem_defined(s, UA, 0, 8, false) by simp(uu, u0, (!(UA = 0) by arith(cf, sc1)), (int_lt(UA, pow2(64)) by arith(uab)))
        step k3 from k1 with hm, scs, sx, g.padd_det, sv80, g.elem8_det, g.ld64_det using conj(hs, su, kb, umd, uab, cf, cnz, sc1, sc2)
        let HV := bits_of_int(64, gimple.bytes_at(V0, int_add(UA, 0), 8))
        let L := A.active[A.metas[g].sizeclass]
        have {H0 = inv} := expand(hhm, mallocng.holds_m)
        have {cok = ctx, hac = active} := expand(H0, mallocng.holds)
        have {c11 = nactive} := expand(cok, mallocng.ctx_ok)
        have al0: A.active in list_type(list_type(omega)) by simp(hat)
        have lt0 := mp(at_type[l := A.active, t := list_type(omega), i := A.metas[g].sizeclass], al0, vsc, (int_lt(A.metas[g].sizeclass, seq_len(A.active)) by arith(c11, s48)))
        have phb: PH in bits(64) by defs(sel(arith(pb, hx, cv, ca, vsc)), bits, pow2)
        have {hv0 = value} := apply(mp.head_is[vm := V0, objs := s.objs, phead := PH, l := L], vb, phb, lt0, la)
        have r1 := all_elim(ms.v_rd64, {V0}, {PH})
        have ehv: HV = ite(seq_len(L) = 0, 0, L[0]) := rewrite(sym(u0), rewrite(sym(uph), trans(sym(r1), hv0)))
        // g the head: on to a_or
        have ch: g = HV -> GOAL proof
          assume he
          step k4 from k3 with he
          have g28c: int_add(g, 28) in bits(64) by arith(go, top)
          have sv28: gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), 28) = 28 by defs(simp(), gimple.sval)
          step V2 r2, oe hR from k4 with g.padd_det, hao using conj(hs, su, ths, hgb, g28c, sb, acp)
          have v2V ev2 := rewrite(sv28, hR)
          have ex2 := rewrite(xval, rewrite(eFr, ev2))
          have uo := apply(mp.unres_out[c := c, A := A, vm := V0, objs := s.objs, b := B, g := g, i := i], hc, au, hat, hbt, vV, hin, hus, io, hro, hno)
          have fb: ex A2. (A2 in mallocng.Abs && A2 in univ(1)) && mallocng_specs.freed_back(c, A, A2, B, V0, V2, s.objs, fst(pair(0, 0)), snd(pair(0, 0)))
            by simp(rewrite(sym(ex2), uo), keep(mallocng_specs.freed_back))
          show by disj({2}, ex_intro({V2}, {pair(0, 0)}, taut(v2V, fb, oe)))
        qed
        // g not the head: on no list (full, no slot freed), queued
        have cq: !(g = HV) -> GOAL proof
          assume hne
          have nl: !mallocng.on_list(L, g) proof
            assume ol
            obtain k, hk hkl hke from expand(ol, mallocng.on_list)
            have c0: k = 0 -> false proof
              assume kz
              have l0: L[0] = g := subst({y. L[y] = g}, kz, hke)
              have nz: !(seq_len(L) = 0) by arith(hkl, hk, kz, (seq_len(L) in omega by arith(lt0)))
              have e := rewrite(mp(ite_f[c := seq_len(L) = 0, a := 0, b := L[0]], nz), ehv)
              show by taut(hne, trans(e, l0), (HV = g -> g = HV by taut()))
            qed
            have c1: !(k = 0) -> false proof
              assume kn
              have _ _ t3 := mp(all_elim(expand(hac, mallocng.active_ok), {A.metas[g].sizeclass}, {k}), conj(vsc, hk), conj(s48, hkl))
              have _ fr := mp(t3, (int_lt(0, k) by arith(hk, kn)))
              show by taut(rewrite(hke, fr), f0)
            qed
            show by taut(c0, c1)
          qed
          have {glk = linked, gul = unlinked} := expand(gok, mallocng.group_ok)
          have hn0: A.metas[g].next = 0 proof
            have q: !(A.metas[g].next = 0) -> false proof
              assume nz
              have _ ex := (int_lt(A.metas[g].sizeclass, 48) && (ex x0. x0 in omega && (int_lt(x0, seq_len(L)) && L[x0] = g)) by taut(glk, nz))
              show by taut(nl, (mallocng.on_list(L, g) by defs(taut(ex), mallocng.on_list)))
            qed
            show by taut(q)
          qed
          have hp0 := mp(gul, hn0)
          have jn := apply(mp.join_any[c := c, A := A, vm := V0, b := B, objs := s.objs, sc := A.metas[g].sizeclass, g := g], hc, au, hat, vb, hhm, hsh, vsc, s48, nl, hus, hp0, hn0)
          have qq: all regs o2. gc.regs_ok(regs, seq_concat(seq_one(gimple.arg(64, UA)), seq_one(gimple.arg(64, g)))) -> runs(qu[regs], s, o2) ->
              abi.ovf_out(s, o2) || (ex V r. (V in x86_64_linux.Vm && mallocng_specs.queued(s.vm, V, s.objs, UA, g)) && o2 = ok(fn_update(s, "vm", V), r)) proof
            fix regs o2
            assume hro h2
            have rl rn _ := hro
            have h3 := mp(all_elim(hqu, {regs}, {s}, {o2}), rl, (int_le(seq_len(regs), 6) by simp(rn)), hs, h2)
            show := apply(mp.qu_q, hs, su, uab, hgb, lt0, rewrite(sym(uph), la), rewrite(sym(uph), jn), hro, h3)
          qed
          step y5 V1 r1, k5 hR1 from k3 with hne, g.padd_det, sv80, g.elem8_det, qq using conj(hs, su, ths, kb, uab, cf, cnz, sc1, sc2, sx, hgb)
          have v1V hq := hR1
          have hqP := rewrite(uph, hq)
          have {rd28 = rd28, kq = kq, out = out} := apply(mp.unres_queue[c := c, A := A, vm := V0, V1 := V1, objs := s.objs, b := B, g := g, i := i],
            hc, au, hat, hbt, vV, v1V, hin, hus, io, hro, hno, cal, s48, nl, hp0, hn0, a0, f0, hqP)
          // a_or on the queue's memory: the thread pointer sound still, g's word accessible
          have w1W w1u := apply(mp.am_world, hs, su, v1V)
          have fsb: s.fs_base in bits(64) by simp(expand(hs, abi.World))
          have th1 := apply(mp.tls_kept[c := c, A := A, b := B, V0 := V0, V1 := V1, fs := s.fs_base, e := empty], fsb, hth, htl, kq,
            (all j. j in omega -> int_lt(j, 8) -> !(int_add(s.fs_base, j) in empty) by simp()))
          have ths1: gc.sound(fn_update(s, "vm", V1)) by simp(th1)
          have _ lo1 := mp(all_elim(expand(hqP, mallocng_specs.queued), {L}), lt0, conj(la, jn))
          have lb1 _ := expand(lo1, mallocng_specs.links_only)
          have ur1 := apply(mp.usable_bytes[v := V0, v2 := V1, objs := s.objs, a := int_add(g, 28), n := 4, w := false], lb1, ur28)
          have uw1 := apply(mp.usable_bytes[v := V0, v2 := V1, objs := s.objs, a := int_add(g, 28), n := 4, w := true], lb1, uw28)
          have acp1: mallocng_specs.a_cas_pre(V1, s.objs, int_add(g, 28)) by defs(simp(g4b, ur1, uw1, (!(int_add(g, 28) = 0) by arith(go))), mallocng_specs.a_cas_pre)
          have g28c: int_add(g, 28) in bits(64) by arith(go, top)
          have sv28: gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), 28) = 28 by defs(simp(), gimple.sval)
          step V2 r2, oe hR from k5 with g.padd_det, hao using conj(w1W, w1u, ths1, hgb, g28c, sb, acp1)
          have v2V ev2 := rewrite(sv28, hR)
          have ev2b: V2 = mallocng_specs.wr32(V1, int_add(g, 28), bits_or(32, bits_of_int(32, gimple.bytes_at(V1, int_add(g, 28), 4)), SELF))
            by simp(ev2, keep(mallocng_specs.wr32))
          have ex2 := rewrite(xval, rewrite(eFr, rewrite(rd28, ev2b)))
          have fb: ex A2. (A2 in mallocng.Abs && A2 in univ(1)) && mallocng_specs.freed_back(c, A, A2, B, V0, V2, s.objs, fst(pair(0, 0)), snd(pair(0, 0)))
            by simp(rewrite(sym(ex2), out), keep(mallocng_specs.freed_back))
          show by disj({2}, ex_intro({V2}, {pair(0, 0)}, taut(v2V, fb, oe)))
        qed
        show by taut(ch, cq)
      qed
      show by taut(mn, mz)
    qed
    show by taut(ht2, f1, f2, f3)
  qed
  // the test: a group mapped on its own (one slot) passes it
  let TEST := bits_add(32, MASK, SELF) = bits_add(32, bits_shl(32, bits_of_int(32, 2), A.metas[g].last_idx), bits_neg(32, 1))
  have ownT: mallocng.own_mapping(A.metas[g]) -> TEST proof
    assume ow
    have l0 := apply(mp.own_one[A := A, M := mallocng.mview(V0, FP), b := B, g := g], gok, ow)
    have all: all j. j in omega -> int_le(j, A.metas[g].last_idx) -> !(j = i) -> bit(MASK, j) proof
      fix j
      assume hj hjl hne
      have i0: i = 0 by arith(il, l0, io)
      have j0: j = 0 by arith(hjl, l0, hj)
      show by taut(hne, trans(j0, sym(i0)))
    qed
    show by taut(ft, all)
  qed
  have cfT: !TEST -> T2 proof
    assume nt
    have e: x7 = ok(pair(s, LOCv), empty) by taut(tb1, nt)
    show by disj({3}, taut(e, (!mallocng.own_mapping(A.metas[g]) by taut(ownT, nt))))
  qed
  // the test passed: okay_to_free asked
  have ctT: TEST -> T2 proof
    assume t
    have qotf: all regs o2. gc.regs_ok(regs, seq_one(gimple.arg(64, g))) -> runs(otf[regs], s, o2) ->
        abi.ovf_out(s, o2) || (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && (mallocng.own_mapping(A.metas[g]) -> !(bits_of_int(32, fst(r)) = 0))) proof
      fix regs o2
      assume hro h2
      have rl rn _ := hro
      have h3 := mp(all_elim(hotf, {regs}, {s}, {o2}), rl, (int_le(seq_len(regs), 6) by simp(rn)), hs, h2)
      show := apply(mp.otf_q[c := c, gst := gst, gib := gib, g := g, t := s, h := h, regs := regs, o2 := o2], hc, hx, hsct, hgb, hs, hh, hhm, hsh, hth, hus, hgst, hgib, hro, h3)
    qed
    step r8, k8 hR8 from tb1 with t, qotf using conj(hs, su, ths, hgb, vV)
    have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], vfun, vdom)
    // not to be freed now: on to the freed mask (no own mapping, so)
    have cz: bits_of_int(32, fst(r8)) = 0 -> T2 proof
      assume z
      step k9 from k8 with z
      show by disj({3}, taut(rewrite(ss, k9), (!mallocng.own_mapping(A.metas[g]) by taut(hR8, z))))
    qed
    // to be freed: g off its list, given back whole
    have cn: !(bits_of_int(32, fst(r8)) = 0) -> T2 proof
      assume nz
      step k9 from k8 with nz
      goal 3
      show by simp()
    qed
    show by taut(cz, cn)
  qed
  show := mp(finish, (T2 by taut(cfT, ctT)))
qed
