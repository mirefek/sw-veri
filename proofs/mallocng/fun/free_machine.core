// free at machine level: its translation unit's callees linked (as
// malloc_machine.core's for malloc), free_group and nontrivial_free -- which
// call each other -- unrolled up to n groups in use (as alloc_pair.core's
// alloc_slot and alloc_group, by class): at 0, free_group's code any (never
// called); nontrivial_free's at n its CFG form over free_group's at n,
// free_group's at n + 1 over nontrivial_free's at n.

// ----------------------------------------------------------------------
//  __libc_free and free called with up to n groups in use

// (a code called as nontrivial_free up to n groups: so up to fewer)
theorem mp.nf_call_mono(c, f, n, m): mp.nf_call(c, f, n) -> int_le(m, n) -> mp.nf_call(c, f, m)
proof
  assume hq hle
  fix t h g i regs o2
  assume hw hh hg hi hdep hin hth htl hus hro hregs hr
  show := mp(all_elim(hq, {t}, {h}, {g}, {i}, {regs}, {o2}), hw, hh, hg, hi, (int_le(seq_len(h.A.used), n) by arith(hdep, hle)), hin, hth, htl, hus, hro, hregs, hr)
qed

// __libc_free(p) called as such, up to n groups in use
abbrev mp.lf_call_n(c, f, n) := all p t h regs o2. p in bits(64) -> t in abi.World -> h in mp.G -> int_le(seq_len(h.A.used), n) ->
  mallocng.holds_in(c, h.A, t.vm, t.objs, h.blocks) -> mallocng.no_reserved(h.A) -> seq_len(h.A.taken) = 0 -> abi.thread_ok(t.vm, t.fs_base) ->
  mallocng_specs.tls_apart(c, h.A, t.fs_base) -> mallocng_specs.errno_ok(t.vm, t.objs, t.fs_base) -> mallocng_specs.errno_apart(c, h.A, t.vm, t.fs_base) ->
  (!(p = 0) -> !(h.blocks[p] = none)) ->
  gc.regs_ok(regs, seq_one(gimple.arg(64, p))) -> runs(f[regs], t, o2) ->
  abi.ovf_out(t, o2) || (ex V r. (V in x86_64_linux.Vm && mp.lf_res(c, h.A, h.blocks, p, t, V)) && o2 = ok(fn_update(t, "vm", V), r))

// __libc_free's run (its returns as one), nontrivial_free called as such up
// to n groups
theorem mp.lf_run2n(c, n, gm, gsi, gst, gns, ac, acas, wl, nf, ul, el, mu, g0, g1, g2, p, s, h, o): c in mallocng.Cfg ->
  c.ctx = c_src_malloc_mallocng_malloc.__malloc_context -> c.sct = c_src_malloc_mallocng_malloc.__malloc_size_classes ->
  c.lock = c_src_malloc_mallocng_malloc.__malloc_lock -> c.libc = c_src_malloc_mallocng_malloc.__libc -> p in bits(64) ->
  mp.calls(gm, c_src_malloc_mallocng_malloc.get_meta_fun(g0, g1)) -> mp.calls(g1, c_src_malloc_mallocng_malloc.get_slot_index_fun()) ->
  mp.calls(gsi, c_src_malloc_mallocng_malloc.get_slot_index_fun()) -> mp.calls(gst, c_src_malloc_mallocng_malloc.get_stride_fun()) ->
  mp.calls(gns, c_src_malloc_mallocng_free.get_nominal_size_fun(g2)) -> mp.calls(wl, mallocng_specs.lock_spec_fun(c_src_malloc_mallocng_malloc.__libc)) ->
  mp.nf_call(c, nf, n) -> mp.calls(ul, mallocng_specs.unlock_spec_fun(c_src_malloc_mallocng_malloc.__malloc_lock)) ->
  mp.calls(el, mallocng_specs.errno_location_spec_fun) -> mp.calls(mu, mallocng_specs.munmap_spec_fun()) ->
  s in abi.World -> h in mp.G -> int_le(seq_len(h.A.used), n) ->
  mallocng.holds_in(c, h.A, s.vm, s.objs, h.blocks) -> mallocng.no_reserved(h.A) -> seq_len(h.A.taken) = 0 -> abi.thread_ok(s.vm, s.fs_base) ->
  mallocng_specs.tls_apart(c, h.A, s.fs_base) -> mallocng_specs.errno_ok(s.vm, s.objs, s.fs_base) -> mallocng_specs.errno_apart(c, h.A, s.vm, s.fs_base) ->
  (!(p = 0) -> !(h.blocks[p] = none)) ->
  runs(c_src_malloc_mallocng_free.__libc_free(p, gm, gsi, gst, gns, ac, acas, wl, nf, ul, el, mu), s, o) ->
  abi.ovf_out(s, o) || (ex V. (V in x86_64_linux.Vm && mp.lf_res(c, h.A, h.blocks, p, s, V)) && o = ok(fn_update(s, "vm", V), empty))
proof
  assume hc hx hsct hlk hlc hp hgm hg1 hgsi hgst hgns hwl hnf hul hel hmu hs hh hdep hin hnr htk hth htl heo hea hlv hr
  have nfn := apply(mp.nf_call_mono[c := c, f := nf, n := n, m := seq_len(h.A.used)], hnf, hdep)
  have run := apply(mp.lf_run[c := c, gm := gm, gsi := gsi, gst := gst, gns := gns, ac := ac, acas := acas, wl := wl, nf := nf, ul := ul, el := el, mu := mu,
    g0 := g0, g1 := g1, g2 := g2, p := p, s := s, h := h, o := o], hc, hx, hsct, hlk, hlc, hp, hs, hh, hin, hnr, htk, hth, htl, heo, hea, hlv,
    hgm, hg1, hgsi, hgst, hgns, hwl, nfn, hul, hel, hmu, hr)
  have {wv = mem, wf = record, wd = has_vm} := apply(ms.world_parts, hs)
  have k0: case 2 of run proof
    assume e
    have pz ho := e
    have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], wf, wd)
    have ho2: o = ok(fn_update(s, "vm", s.vm), empty) := rewrite(sym(ss), ho, {1})
    show by disj({2}, ex_intro({s.vm}, taut(wv, pz, refl({s.vm}), ho2)))
  qed
  have k1: case 3 of run proof
    assume e
    have pnz lo := e
    obtain V, v4 post ho from lo
    show by disj({2}, ex_intro({V}, taut(v4, pnz, post, ho)))
  qed
  show by taut(run, k0, k1)
qed

// __libc_free's code called as such up to n groups
theorem mp.lf_q_n: all c n gm gsi gst gns ac acas wl nf ul el mu g0 g1 g2. c in mallocng.Cfg ->
  c.ctx = c_src_malloc_mallocng_malloc.__malloc_context -> c.sct = c_src_malloc_mallocng_malloc.__malloc_size_classes ->
  c.lock = c_src_malloc_mallocng_malloc.__malloc_lock -> c.libc = c_src_malloc_mallocng_malloc.__libc ->
  mp.calls(gm, c_src_malloc_mallocng_malloc.get_meta_fun(g0, g1)) -> mp.calls(g1, c_src_malloc_mallocng_malloc.get_slot_index_fun()) ->
  mp.calls(gsi, c_src_malloc_mallocng_malloc.get_slot_index_fun()) -> mp.calls(gst, c_src_malloc_mallocng_malloc.get_stride_fun()) ->
  mp.calls(gns, c_src_malloc_mallocng_free.get_nominal_size_fun(g2)) -> mp.calls(wl, mallocng_specs.lock_spec_fun(c_src_malloc_mallocng_malloc.__libc)) ->
  mp.nf_call(c, nf, n) -> mp.calls(ul, mallocng_specs.unlock_spec_fun(c_src_malloc_mallocng_malloc.__malloc_lock)) ->
  mp.calls(el, mallocng_specs.errno_location_spec_fun) -> mp.calls(mu, mallocng_specs.munmap_spec_fun()) ->
  mp.lf_call_n(c, c_src_malloc_mallocng_free.__libc_free_fun(gm, gsi, gst, gns, ac, acas, wl, nf, ul, el, mu), n)
proof
  fix c n gm gsi gst gns ac acas wl nf ul el mu g0 g1 g2
  assume hc hx hsct hlk hlc hgm hg1 hgsi hgst hgns hwl hnf hul hel hmu
  fix p t h regs o2
  assume hpb hw hh hdep hin hnr htk hth htl heo hea hlv hro hr
  have rl rn r0 := apply(gc.regs1, hpb, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  have o1l: ord_le(1, seq_len(regs)) by defs(simp(rn), ord_le)
  have bp: bits_of_int(64, regs[0]) = p by defs(simp(r0, hpb), bits_of_int, pow2)
  step o3 V, e hs1 from hr with o1l, bp, mp.lf_run2n using ra, hc, hx, hsct, hlk, hlc, hpb, hgm, hg1, hgsi, hgst, hgns, hwl, hnf, hul, hel, hmu,
    hw, hh, hdep, hin, hnr, htk, hth, htl, heo, hea, hlv
  // (the result: any two words)
  have ne: ex x0. x0 in bits(64) by ex_intro({0}, simp())
  have e1: ex x0. x0 in bits(64) && any_rel(x1. x1 in bits(64), x1. o2 = ok(fn_update(t, "vm", V), pair(x0, x1))) by defs(taut(expand(e, any_rel), ne), any_rel)
  obtain y0, _ e2 from e1
  have e3: ex x1. x1 in bits(64) && o2 = ok(fn_update(t, "vm", V), pair(y0, x1)) by taut(expand(e2, any_rel), ne)
  obtain y1, _ ho from e3
  show by disj({2}, ex_intro({V}, {pair(y0, y1)}, taut(hs1, ho)))
qed

// free(p)'s run: __libc_free(p) called as such up to n groups
theorem mp.fr_run_n(c, n, p, g, s, h, o): p in bits(64) -> mp.lf_call_n(c, g, n) -> s in abi.World -> h in mp.G -> int_le(seq_len(h.A.used), n) ->
  mallocng.holds_in(c, h.A, s.vm, s.objs, h.blocks) -> mallocng.no_reserved(h.A) -> seq_len(h.A.taken) = 0 -> abi.thread_ok(s.vm, s.fs_base) ->
  mallocng_specs.tls_apart(c, h.A, s.fs_base) -> mallocng_specs.errno_ok(s.vm, s.objs, s.fs_base) -> mallocng_specs.errno_apart(c, h.A, s.vm, s.fs_base) ->
  (!(p = 0) -> !(h.blocks[p] = none)) -> runs(c_src_malloc_free.free(p, g), s, o) ->
  abi.ovf_out(s, o) || (ex V. (V in x86_64_linux.Vm && mp.lf_res(c, h.A, h.blocks, p, s, V)) && o = ok(fn_update(s, "vm", V), empty))
proof
  assume hp hg hw hh hdep hin hnr htk hth htl heo hea hlv hr
  have pu := apply(g.runs_univ, hr)
  have hu: s in univ(1) by simp(pu)
  have ths: gc.sound(s) by simp(hth)
  step V r, ho hR from hr with hg using conj(hw, hu, ths, hp, hh, hdep, hin, hnr, htk, hth, htl, heo, hea, hlv)
  show by disj({2}, ex_intro({V}, taut(hR, ho)))
qed

// (codes refining others: their call facts)
theorem mp.calls_refl(F): mp.calls(F, F)
proof
  fix regs s o
  assume _ _ _ hr
  show hr
qed

theorem mp.aor_calls(F, G): mp.aor_call(G) -> mp.calls(F, G) -> mp.aor_call(F)
proof
  assume hq hcl
  fix t p v regs o2
  assume hw htu hp hv hpre hro hr
  have rl rln _ := hro
  have rn: seq_len(regs) = 2 := trans(rln, (seq_len(seq_concat(seq_one(gimple.arg(64, p)), seq_one(gimple.arg(32, v)))) = 2 by simp()))
  have h2 := mp(all_elim(hcl, {regs}, {t}, {o2}), rl, (int_le(seq_len(regs), 6) by simp(rn)), hw, hr)
  show := mp(all_elim(hq, {t}, {p}, {v}, {regs}, {o2}), hw, htu, hp, hv, hpre, hro, h2)
qed

theorem mp.lf_calls_n(c, n, F, G): mp.lf_call_n(c, G, n) -> mp.calls(F, G) -> mp.lf_call_n(c, F, n)
proof
  assume hq hcl
  fix p t h regs o2
  assume hpb hw hh hdep hin hnr htk hth htl heo hea hlv hro hr
  have rl rn _ := apply(gc.regs1, hpb, hro)
  have h2 := mp(all_elim(hcl, {regs}, {t}, {o2}), rl, (int_le(seq_len(regs), 6) by simp(rn)), hw, hr)
  show := mp(all_elim(hq, {p}, {t}, {h}, {regs}, {o2}), hpb, hw, hh, hdep, hin, hnr, htk, hth, htl, heo, hea, hlv, hro, h2)
qed

// a_crash's spec (undefined) at an unaligned entry too: any code
theorem mp.undef_implements_u: all f statics. tr.implements_at_u(f, mallocng_specs.a_crash_spec_fun(), 4198400, text.code, statics)
proof
  fix f statics
  have g: all args objs mem s o. args in abi.ARGS -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) ->
      abi.loaded(s.vm, 4198400, text.code, statics) -> s.rip = f -> tr.entry_ok_u(s, args) -> tr.objs_ok(s, objs) -> abi.view_ok(s, objs, mem) ->
      tr.run_d(s, s, o) -> tr.matches_t(mallocng_specs.a_crash_spec_fun(), args, objs, mem, s, o) proof
    fix args objs mem s o
    assume hA ho hm hs hu _ _ _ _ _ _
    let V := abi.view(s, objs, mem)
    have ou := apply(abi.objs_univ, ho)
    have mu := apply(x86.vm_univ, hm)
    have ocu := mp(all_elim(abi.objs_at_univ, {objs}, {s.fs_base}), ou)
    have vu: V in univ(1) by simp(hu, ou, mu, ocu)
    have vW := apply(abi.world_typed, hs, ho, hm, vu)
    have rst: abi.raise_state(V) by defs(apply(tr.world_and, vW), abi.raise_state)
    have eu: empty in univ(1) by simp()
    have eno: !(empty = exc_val("stack_overflow", empty)) by defs(all_elim(tr.pair_ne, {"stack_overflow"}, {empty}), exc_val)
    have pu: pair(V, exc(V, empty)) in univ(1) by simp(vu)
    have rf: runs(mallocng_specs.a_crash_spec_fun()[args], V, exc(V, empty)) by defs(simp(hA, pu), mallocng_specs.a_crash_spec_fun)
    have ra: abi.raises_at(mallocng_specs.a_crash_spec_fun(), args, objs, mem, s) by defs(ex_intro({empty}, {V}, taut(eu, eno, rst, rf)), abi.raises_at)
    show by defs(taut(ra), tr.matches_t)
  qed
  show by defs(g, tr.implements_at_u)
qed

// ----------------------------------------------------------------------
//  free.c's callees but the two, linked (free.c's copies of malloc.c's
//  functions the same CFG forms as malloc.c's)

abbrev mp.FAC := mallocng_specs.a_crash_spec_fun()
abbrev mp.FGSI := c_src_malloc_mallocng_malloc_cfg.get_slot_index_fun()
abbrev mp.FGM := c_src_malloc_mallocng_malloc_cfg.get_meta_fun(mp.FAC, mp.FGSI)
abbrev mp.FGST := c_src_malloc_mallocng_malloc_cfg.get_stride_fun()
abbrev mp.FGNS := c_src_malloc_mallocng_free_cfg.get_nominal_size_fun(mp.FAC)
abbrev mp.FCAS := c_src_malloc_mallocng_malloc_cfg.a_cas_fun()
abbrev mp.FIB := c_src_malloc_mallocng_malloc_cfg.is_bouncing_fun()
abbrev mp.FOTF := c_src_malloc_mallocng_free_cfg.okay_to_free_fun(mp.FGST, mp.FIB)
abbrev mp.FDQ := c_src_malloc_mallocng_malloc_cfg.dequeue_fun()
abbrev mp.FAG := c_src_malloc_mallocng_malloc_cfg.activate_group_fun(mp.FAC, mp.FCAS)
abbrev mp.FAOR := c_src_malloc_mallocng_free_cfg.a_or_fun()
abbrev mp.FSQ := c_src_malloc_mallocng_malloc_cfg.step_seq_fun()
abbrev mp.FRQ := c_src_malloc_mallocng_free_cfg.record_seq_fun()

// nontrivial_free's CFG form over free_group's code fg; free_group's over
// nontrivial_free's nf; __libc_free's over nontrivial_free's
abbrev mp.FNF(fg) := c_src_malloc_mallocng_free_cfg.nontrivial_free_fun(mp.FOTF, mp.FAC, mp.FDQ, mp.FAG, fg, mp.ap_q, mp.FAOR)
abbrev mp.FFG(nf) := c_src_malloc_mallocng_free_cfg.free_group_fun(mp.FSQ, mp.FRQ, mp.FGM, mp.FGSI, nf, mp.ap_fm)
abbrev mp.FLF(nf) := c_src_malloc_mallocng_free_cfg.__libc_free_fun(mp.FGM, mp.FGSI, mp.FGST, mp.FGNS, mp.FAC, mp.FCAS, mp.WLK, nf, mp.ULK, mp.EL, mp.MUN)

// free_group's code fg known up to n groups: implemented, typed, its io,
// called as free_group up to n; nontrivial_free's nf likewise
abbrev mp.fg_known(c, statics, n, fg) := tr.implements_at(4203895, fg, 4198400, text.code, statics) && fg in fn_space(abi.ARGS, powerset(univ(1))) &&
  tr.callee_io(fg, 1) && mp.fg_call(c, fg, n)
abbrev mp.nf_known(c, statics, n, nf) := tr.implements_at(4204530, nf, 4198400, text.code, statics) && nf in fn_space(abi.ARGS, powerset(univ(1))) &&
  tr.callee_io(nf, 2) && mp.nf_call(c, nf, n)

// the allocator's configuration as free's code has it
abbrev mp.fr_cfg(c) := c in mallocng.Cfg && c.ctx = c_src_malloc_mallocng_malloc.__malloc_context && c.sct = c_src_malloc_mallocng_malloc.__malloc_size_classes &&
  c.lock = c_src_malloc_mallocng_malloc.__malloc_lock && c.libc = c_src_malloc_mallocng_malloc.__libc

// nontrivial_free over free_group known up to n: known up to n
theorem mp.fl_nf: all c statics n fg. mp.fr_cfg(c) -> n in omega -> mp.fg_known(c, statics, n, fg) -> mp.nf_known(c, statics, n, mp.FNF(fg))
proof
  fix c statics n fg
  assume hcf hn hk
  have hc hx hst _ _ := hcf
  have ifg tfg ofg qfg := hk
  // the callees: okay_to_free (over get_stride, is_bouncing), a_crash,
  // dequeue, activate_group, queue, a_or
  have iotf := mp(all_elim(otfc.implements, {statics}, {mp.FGST}, {mp.FIB}), all_elim(fgstc.implements, {statics}), fgstc.typed, fgstc.io,
    all_elim(fibtc.implements, {statics}), fibtc.typed, fibtc.io)
  have totf: mp.FOTF in fn_space(abi.ARGS, powerset(univ(1))) by defs(tr.fun_typed, c_src_malloc_mallocng_free_cfg.okay_to_free_fun)
  have ootf := mp(all_elim(otfc.io, {mp.FGST}, {mp.FIB}), fgstc.io, fibtc.io)
  have iag := mp(all_elim(fagtc.implements, {statics}, {mp.FAC}, {mp.FCAS}), all_elim(mp.undef_implements, {4202156}, {statics}), acr.typed, mp.undef_io[n := 0],
    all_elim(facsc.implements, {statics}), facsc.typed, facsc.io)
  have tag: mp.FAG in fn_space(abi.ARGS, powerset(univ(1))) by defs(tr.fun_typed, c_src_malloc_mallocng_malloc_cfg.activate_group_fun)
  have oag := mp(all_elim(fagtc.io, {mp.FAC}, {mp.FCAS}), mp.undef_io[n := 0], facsc.io)
  have iq := mp(all_elim(fqutc.implements, {statics}, {mp.FAC}), all_elim(mp.undef_implements_u, {4202156}, {statics}), acr.typed, mp.undef_io[n := 0])
  have _ tq oq qq := all_elim(mp.ap_q_ok, {statics})
  have ln := mp(all_elim(ntfc.implements, {statics}, {mp.FOTF}, {mp.FAC}, {mp.FDQ}, {mp.FAG}, {fg}, {mp.ap_q}, {mp.FAOR}),
    iotf, totf, ootf, all_elim(mp.undef_implements, {4202156}, {statics}), acr.typed, mp.undef_io[n := 0],
    all_elim(fdqtc.implements, {statics}), fdqtc.typed, fdqtc.io, iag, tag, oag, ifg, tfg, ofg, iq, tq, oq,
    all_elim(aorc.implements, {statics}), aorc.typed, aorc.io)
  have ty: mp.FNF(fg) in fn_space(abi.ARGS, powerset(univ(1))) by defs(tr.fun_typed, c_src_malloc_mallocng_free_cfg.nontrivial_free_fun)
  have io := mp(all_elim(ntfc.io, {mp.FOTF}, {mp.FAC}, {mp.FDQ}, {mp.FAG}, {fg}, {mp.ap_q}, {mp.FAOR}), ootf, mp.undef_io[n := 0], fdqtc.io, oag, ofg, oq, aorc.io)
  // called as nontrivial_free up to n: its structured form's
  have cotf := all_elim(okay_to_free_ref, {mp.FGST}, {mp.FIB})
  have cgst := gst_ref
  have cib := mp(all_elim(mp.ib_call_linked, {c}), hc, hx)
  have cag := mp(all_elim(mp.ag_call_linked, {c}), hc)
  have cao := apply(mp.aor_calls[F := mp.FAOR, G := c_src_malloc_mallocng_free.a_or_fun()], mp.aor_q, a_or_ref)
  have q := apply(mp.nf_q[c := c, n := n, otf := mp.FOTF, gst := mp.FGST, gib := mp.FIB, ac := mp.FAC, dq := mp.FDQ, ag := mp.FAG, fg := fg, qu := mp.ap_q, ao := mp.FAOR],
    hc, hx, hst, hn, cotf, cgst, cib, mp.calls_refl[F := mp.FAC], mp.dq_calls_linked, cag, qfg, qq, cao)
  have nq := apply(mp.nf_calls[c := c, n := n, F := mp.FNF(fg), G := c_src_malloc_mallocng_free.nontrivial_free_fun(mp.FOTF, mp.FAC, mp.FDQ, mp.FAG, fg, mp.ap_q, mp.FAOR)],
    q, all_elim(nontrivial_free_ref, {mp.FOTF}, {mp.FAC}, {mp.FDQ}, {mp.FAG}, {fg}, {mp.ap_q}, {mp.FAOR}))
  show by taut(ln, ty, io, nq)
qed

// (get_meta's CFG form linked: implemented, typed, its io)
theorem mp.fl_gm: all statics. tr.implements_at(4202779, mp.FGM, 4198400, text.code, statics) && mp.FGM in fn_space(abi.ARGS, powerset(univ(1))) &&
  tr.callee_io(mp.FGM, 1)
proof
  fix statics
  have i := mp(all_elim(fgmtc.implements, {statics}, {mp.FAC}, {mp.FGSI}), all_elim(mp.undef_implements, {4202156}, {statics}), acr.typed, mp.undef_io[n := 0],
    all_elim(fgsitc.implements, {statics}), fgsitc.typed, fgsitc.io)
  have t: mp.FGM in fn_space(abi.ARGS, powerset(univ(1))) by defs(tr.fun_typed, c_src_malloc_mallocng_malloc_cfg.get_meta_fun)
  have o := mp(all_elim(fgmtc.io, {mp.FAC}, {mp.FGSI}), mp.undef_io[n := 0], fgsitc.io)
  show by taut(i, t, o)
qed

// free_group over nontrivial_free known up to n: known up to n + 1
theorem mp.fl_fg: all c statics n nf. mp.fr_cfg(c) -> n in omega -> mp.nf_known(c, statics, n, nf) -> mp.fg_known(c, statics, int_add(n, 1), mp.FFG(nf))
proof
  fix c statics n nf
  assume hcf hn hk
  have hc hx hst _ _ := hcf
  have inf tnf onf qnf := hk
  have igm tgm ogm := all_elim(mp.fl_gm, {statics})
  have ifm := mp(all_elim(ffmtc.implements, {statics}, {mp.ap_q}), mp(all_elim(fqutc.implements, {statics}, {mp.FAC}), all_elim(mp.undef_implements_u, {4202156}, {statics}),
    acr.typed, mp.undef_io[n := 0]), qutc.typed_linked, qutc.io_linked)
  have _ tfm ofm _ := mp(all_elim(mp.ap_fm_ok, {c}, {statics}), hx)
  have ln := mp(all_elim(fgrc.implements, {statics}, {mp.FSQ}, {mp.FRQ}, {mp.FGM}, {mp.FGSI}, {nf}, {mp.ap_fm}),
    all_elim(fsstc.implements, {statics}), fsstc.typed, fsstc.io, all_elim(rsqc.implements, {statics}), rsqc.typed, rsqc.io, igm, tgm, ogm,
    all_elim(fgsitc.implements, {statics}), fgsitc.typed, fgsitc.io, inf, tnf, onf, ifm, tfm, ofm)
  have ty: mp.FFG(nf) in fn_space(abi.ARGS, powerset(univ(1))) by defs(tr.fun_typed, c_src_malloc_mallocng_free_cfg.free_group_fun)
  have io := mp(all_elim(fgrc.io, {mp.FSQ}, {mp.FRQ}, {mp.FGM}, {mp.FGSI}, {nf}, {mp.ap_fm}), fsstc.io, rsqc.io, ogm, fgsitc.io, onf, ofm)
  // called as free_group up to n + 1: its structured form's
  have csq := mp(all_elim(mp.sq_call_linked, {c}), hc, hx)
  have crq := mp(all_elim(mp.rq_call_linked, {c}), hc, hx)
  have q := apply(mp.fg_q[c := c, n := n, sq := mp.FSQ, rq := mp.FRQ, gm := mp.FGM, g0 := mp.FAC, g1 := mp.FGSI, gsi := mp.FGSI, nf := nf, fm := mp.ap_fm],
    hc, hx, hst, hn, csq, crq, all_elim(get_meta_ref, {mp.FAC}, {mp.FGSI}), get_slot_index_ref, get_slot_index_ref, qnf, mp.fm_calls_linked)
  have fq := apply(mp.fg_calls[c := c, n := int_add(n, 1), F := mp.FFG(nf), G := c_src_malloc_mallocng_free.free_group_fun(mp.FSQ, mp.FRQ, mp.FGM, mp.FGSI, nf, mp.ap_fm)],
    q, all_elim(free_group_ref, {mp.FSQ}, {mp.FRQ}, {mp.FGM}, {mp.FGSI}, {nf}, {mp.ap_fm}))
  show by taut(ln, ty, io, fq)
qed

// up to n groups: some nontrivial_free's code known (free_group's at 0 any:
// never called)
theorem mp.fl_all: all c statics. mp.fr_cfg(c) -> all n. n in omega -> ex nf. mp.nf_known(c, statics, n, mp.FNF(nf)) && mp.fg_known(c, statics, n, nf)
proof
  fix c statics
  assume hcf
  let P(n) := ex fg. mp.fg_known(c, statics, n, fg)
  have b: P(0) by ex_intro({mp.FAC}, taut(all_elim(mp.undef_implements, {4203895}, {statics}), acr.typed, mp.undef_io[n := 1], mp.fg_call0[c := c, F := mp.FAC]))
  have s: all n. n in omega -> P(n) -> P(int_add(n, 1)) proof
    fix n
    assume hn hp
    obtain fg, hk from hp
    have nk := mp(all_elim(mp.fl_nf, {c}, {statics}, {n}, {fg}), hcf, hn, hk)
    show by ex_intro({mp.FFG(mp.FNF(fg))}, mp(all_elim(mp.fl_fg, {c}, {statics}, {n}, {mp.FNF(fg)}), hcf, hn, nk))
  qed
  have all := mp(nat_ind[p := n. P(n)], b, s)
  fix n
  assume hn
  obtain fg, hk from mp(all_elim(all, {n}), hn)
  show by ex_intro({fg}, taut(mp(all_elim(mp.fl_nf, {c}, {statics}, {n}, {fg}), hcf, hn, hk), hk))
qed

// __libc_free over nontrivial_free known up to n: implemented, typed, its
// io, called as __libc_free up to n
theorem mp.fl_lf: all c statics n nf. mp.fr_cfg(c) -> mp.nf_known(c, statics, n, nf) ->
  tr.implements_at(4205038, mp.FLF(nf), 4198400, text.code, statics) && mp.FLF(nf) in fn_space(abi.ARGS, powerset(univ(1))) &&
  tr.callee_io(mp.FLF(nf), 1) && mp.lf_call_n(c, mp.FLF(nf), n)
proof
  fix c statics n nf
  assume hcf hk
  have hc hx hst hlk hlc := hcf
  have inf tnf onf qnf := hk
  let AC := mp.FAC
  have igm tgm ogm := all_elim(mp.fl_gm, {statics})
  have igns := mp(all_elim(gnsc.implements, {statics}, {AC}), all_elim(mp.undef_implements_u, {4202156}, {statics}), acr.typed, mp.undef_io[n := 0])
  have tgns: mp.FGNS in fn_space(abi.ARGS, powerset(univ(1))) by defs(tr.fun_typed, c_src_malloc_mallocng_free_cfg.get_nominal_size_fun)
  have ogns := mp(all_elim(gnsc.io, {AC}), mp.undef_io[n := 0])
  have iwl := mp(all_elim(fwrlc.implements, {statics}, {AC}), all_elim(mp.undef_implements, {4214680}, {statics}), acr.typed, mp.undef_io[n := 1])
  have _ twl owl cwl := all_elim(mp.mi_wrl, {statics})
  have iu := mp(all_elim(ulkc.implements, {statics}, {AC}, {AC}), all_elim(mp.undef_implements, {4214403}, {statics}), acr.typed, mp.undef_io[n := 2],
    all_elim(mp.undef_implements, {4214434}, {statics}), acr.typed, mp.undef_io[n := 3])
  have iou := mp(all_elim(ulkc.io, {AC}, {AC}), mp.undef_io[n := 2], mp.undef_io[n := 3])
  have iul := mp(all_elim(funlc.implements, {statics}, {mp.UL}), iu, all_elim(ulkc.typed, {AC}, {AC}), iou)
  have _ tul oul cul := all_elim(mp.mi_unl, {statics})
  have iel tel oel cel := all_elim(mp.ap_el, {statics})
  have imu tmu omu cmu := all_elim(mp.mi_mun, {statics})
  have ln := mp(all_elim(lfrc.implements, {statics}, {mp.FGM}, {mp.FGSI}, {mp.FGST}, {mp.FGNS}, {AC}, {mp.FCAS}, {mp.WLK}, {nf}, {mp.ULK}, {mp.EL}, {mp.MUN}),
    igm, tgm, ogm, all_elim(fgsitc.implements, {statics}), fgsitc.typed, fgsitc.io, all_elim(fgstc.implements, {statics}), fgstc.typed, fgstc.io,
    igns, tgns, ogns, all_elim(mp.undef_implements, {4202156}, {statics}), acr.typed, mp.undef_io[n := 0], all_elim(facsc.implements, {statics}), facsc.typed, facsc.io,
    iwl, twl, owl, inf, tnf, onf, iul, tul, oul, iel, tel, oel, imu, tmu, omu)
  have ty: mp.FLF(nf) in fn_space(abi.ARGS, powerset(univ(1))) by defs(tr.fun_typed, c_src_malloc_mallocng_free_cfg.__libc_free_fun)
  have io := mp(all_elim(lfrc.io, {mp.FGM}, {mp.FGSI}, {mp.FGST}, {mp.FGNS}, {AC}, {mp.FCAS}, {mp.WLK}, {nf}, {mp.ULK}, {mp.EL}, {mp.MUN}),
    ogm, fgsitc.io, fgstc.io, ogns, mp.undef_io[n := 0], facsc.io, owl, onf, oul, oel, omu)
  // called as __libc_free up to n: its structured form's
  have q := mp(all_elim(mp.lf_q_n, {c}, {n}, {mp.FGM}, {mp.FGSI}, {mp.FGST}, {mp.FGNS}, {AC}, {mp.FCAS}, {mp.WLK}, {nf}, {mp.ULK}, {mp.EL}, {mp.MUN},
    {AC}, {mp.FGSI}, {AC}), hc, hx, hst, hlk, hlc, all_elim(get_meta_ref, {AC}, {mp.FGSI}), get_slot_index_ref, get_slot_index_ref, gst_ref,
    all_elim(get_nominal_size_ref, {AC}), cwl, qnf, cul, cel, cmu)
  have lq := apply(mp.lf_calls_n[c := c, n := n, F := mp.FLF(nf),
    G := c_src_malloc_mallocng_free.__libc_free_fun(mp.FGM, mp.FGSI, mp.FGST, mp.FGNS, AC, mp.FCAS, mp.WLK, nf, mp.ULK, mp.EL, mp.MUN)], q,
    mp(all_elim(__libc_free_ref, {mp.FGM}, {mp.FGSI}, {mp.FGST}, {mp.FGNS}, {AC}, {mp.FCAS}, {mp.WLK}, {nf}, {mp.ULK}, {mp.EL}, {mp.MUN}),
      ogm, fgsitc.io, fgstc.io, ogns, mp.undef_io[n := 0], facsc.io, owl, onf, oul, oel, omu))
  show by taut(ln, ty, io, lq)
qed
