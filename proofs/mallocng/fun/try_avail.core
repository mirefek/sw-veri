// try_avail's code by its purpose: its contract (`mp.ta_run`), the ghost
// part's A the reorganised state
theorem mp.ta: all c sc pm gq gag ga gdb. c in mallocng.Cfg -> c.ctx = c_src_malloc_mallocng_malloc.__malloc_context ->
  c.sct = c_src_malloc_mallocng_malloc.__malloc_size_classes -> sc in int -> pm in bits(64) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(gq[regs], s, o) -> runs(mallocng_specs.dequeue_spec_fun()[regs], s, o)) ->
  mp.ag_call(c, gag) -> mp.db_call(c, gdb) ->
  refines_ghost(c_src_malloc_mallocng_malloc.try_avail(pm, gq, gag, ga, gdb), mallocng_specs.try_avail_spec(c, sc, pm), abi.World, mp.G)
proof
  fix c sc pm gq gag ga gdb
  assume hc hx hst hsi hpb hgq hag hdb
  let P := c_src_malloc_mallocng_malloc.try_avail(pm, gq, gag, ga, gdb)
  have rp: all s o. runs(P, s, o) -> pair(s, o) in univ(1) proof
    fix s o
    assume hr
    show := apply(g.runs_univ, expand(hr, c_src_malloc_mallocng_malloc.try_avail))
  qed
  unfold mallocng_specs.try_avail_spec
  refine ct.refines_contract_g with mp.g_world, rp
  fix s h o
  assume hw hh hr hpre
  let S := union2(s, h)
  let A := h.A
  let B := h.blocks
  let V0 := s.vm
  have _ hd _ _ := mp(all_elim(mp.g_rec, {h}), hh)
  have sd: dom(s) = insert("vm", insert("os", insert("fs_base", insert("cpu", insert("objs", empty))))) by simp(expand(hw, abi.World))
  have aS: S.A = A by simp(sd, hd)
  have vS: S.vm = V0 by simp(sd, hd)
  have bS: S.blocks = B by simp(sd, hd)
  have oS: S.objs = s.objs by simp(sd, hd)
  have hin0: mallocng.holds_in(c, A, V0, s.objs, B) by simp(hpre, sd, hd)
  have {hin = mem, hsh = shown} := hin0
  have hnr: mallocng.no_reserved(A) by simp(hpre, sd, hd)
  have hth: abi.thread_ok(V0, s.fs_base) by simp(hpre, sd, hd)
  have htl: mallocng_specs.tls_apart(c, A, B, s.fs_base) by simp(hpre, sd, hd)
  have hsl: int_lt(sc, 48) by simp(hpre, sd, hd)
  have hpe: pm = int_add(int_add(c.ctx, mallocng.C_ACTIVE), int_mul(8, sc)) by simp(hpre, sd, hd)
  have hpl: int_le(int_add(c.ctx, mallocng.C_ACTIVE), pm) by simp(hpre, sd, hd)
  have hs: sc in omega by arith(hpl, hpe, hsi)
  have run := apply(mp.ta_run[c := c, sc := sc, pm := pm, gq := gq, gag := gag, ga := ga, gdb := gdb, s := s, h := h, o := o],
    hc, hx, hst, hs, hsl, hpb, hpe, hgq, hag, hdb, hw, hh, hin, hsh, hnr, hth, htl, hr)
  // a return: the ghost part's A the new state
  have k: case 2 of run proof
    assume e
    obtain A2 V2 r, ha2 hu2 hro hrb hrc hv2 hin2m hkept ho from e
    have hunt := apply(mp.kept_unt[objs := s.objs], hkept)
    // (reorganised: the allocator's bytes the world's as before)
    have _ _ _ hAa := mp(all_elim(mp.g_rec, {h}), hh)
    have hsh2 := apply(mp.shown_reorg[c := c, A := A, A2 := A2, sc := sc, objs := s.objs], hAa, hro, hsh)
    have hin2: mallocng.holds_in(c, A2, V2, s.objs, B) by defs(taut(hin2m, hsh2), mallocng.holds_in)
    let S1 := fn_update(fn_update(S, "A", A2), "vm", V2)
    let H2 := fn_update(h, "A", A2)
    let s1 := fn_update(s, "vm", V2)
    have hg2 := apply(mp.g_upd, {h}, {A2}, hh, ha2, hu2)
    // the world's part and the ghost part joined: the spec's state
    have sk := apply(abi.keys_of[f := s, d := insert("vm", insert("os", insert("fs_base", insert("cpu", insert("objs", empty)))))], sd)
    have na: all z. z in s -> fst(z) != "A" proof
      fix z
      assume hz
      show by simp(mp(all_elim(sk, {z}), hz))
    qed
    have _ hk := mp(all_elim(mp.g_world, {H2}), hg2)
    have nv: all z. z in H2 -> fst(z) != "vm" proof
      fix z
      assume hz
      show by simp(mp(all_elim(hk, {z}), hz))
    qed
    have e1 := mp(fn_update_union_r[a := s, b := h, k := "A", v := A2], na)
    have e2 := mp(fn_update_union_l[a := s, b := H2, k := "vm", v := V2], nv)
    have eS: union2(s1, H2) = S1 := sym(trans(subst({y. S1 = fn_update(y, "vm", V2)}, e1, refl({S1})), e2))
    show by disj({2}, ex_intro({s1}, {r}, {H2}, spec_ret({A2}, {r}, {V2}, hg2, ho, ha2, hro, hrb, hrc, aS, vS, bS, oS, hv2, hin2, hunt, eS)))
  qed
  show by taut(run, k)
qed

theorem mp.ta_fun: all c regs gq gag ga gdb. c in mallocng.Cfg -> c.ctx = c_src_malloc_mallocng_malloc.__malloc_context ->
  c.sct = c_src_malloc_mallocng_malloc.__malloc_size_classes ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(gq[regs], s, o) -> runs(mallocng_specs.dequeue_spec_fun()[regs], s, o)) ->
  mp.ag_call(c, gag) -> mp.db_call(c, gdb) -> regs in abi.ARGS ->
  refines_ghost(c_src_malloc_mallocng_malloc.try_avail_fun(gq, gag, ga, gdb)[regs], mallocng_specs.try_avail_spec_fun(c)[regs], abi.World, mp.G)
proof
  fix c regs gq gag ga gdb
  assume hc hx hst hgq hag hdb hr
  have cto: c.ctx in omega by simp(hc)
  have hm: all regs. refines_ghost(c_src_malloc_mallocng_malloc.try_avail(bits_of_int(64, regs[0]), gq, gag, ga, gdb),
      mallocng_specs.try_avail_spec(c, int_div(int_sub(int_sub(bits_of_int(64, regs[0]), c.ctx), mallocng.C_ACTIVE), 8), bits_of_int(64, regs[0])), abi.World, mp.G) proof
    fix regs
    have pb: bits_of_int(64, regs[0]) in bits(64) by simp()
    have ka: mallocng.C_ACTIVE = 80 by defs(simp(), mallocng.C_ACTIVE)
    have si: int_div(int_sub(int_sub(bits_of_int(64, regs[0]), c.ctx), mallocng.C_ACTIVE), 8) in int by arith(pb, cto, ka)
    show := mp(all_elim(mp.ta, {c}, {int_div(int_sub(int_sub(bits_of_int(64, regs[0]), c.ctx), mallocng.C_ACTIVE), 8)}, {bits_of_int(64, regs[0])}, {gq}, {gag}, {ga}, {gdb}),
      hc, hx, hst, si, pb, hgq, hag, hdb)
  qed
  have w := mp(g.fun_res_ghost[p := x0. c_src_malloc_mallocng_malloc.try_avail(bits_of_int(64, x0[0]), gq, gag, ga, gdb),
    q := x0. mallocng_specs.try_avail_spec(c, int_div(int_sub(int_sub(bits_of_int(64, x0[0]), c.ctx), mallocng.C_ACTIVE), 8), bits_of_int(64, x0[0])), w := 32, n := 1, G := mp.G],
    mp.g_univ, hm)
  show by defs(mp(all_elim(w, {regs}), hr), c_src_malloc_mallocng_malloc.try_avail_fun, mallocng_specs.try_avail_spec_fun, letin)
qed

// (the purpose spec diverges nowhere it does not also raise: only where
// it allows anything -- no reorganised state, no result, no memory)
theorem mp.ta_divg: all c. tr.div_raises_g(mp.G, mallocng_specs.try_avail_spec_fun(c))
proof
  fix c
  show by divergence(mp.g_univ, mp.gS)
qed

// try_avail's machine code (linked with dequeue's, activate_group's and
// decay_bounces' code and a_crash's spec) implements its purpose: its
// callees' CFG forms called as their contracts say (`mp.ag_call_ref`,
// `mp.db_call_ref`)
theorem mp.ta_implements: all c statics. c in mallocng.Cfg -> c.ctx = c_src_malloc_mallocng_malloc.__malloc_context ->
  c.sct = c_src_malloc_mallocng_malloc.__malloc_size_classes ->
  abi.implements2_at(mp.G, 4209736, mallocng_specs.try_avail_spec_fun(c), 4198400, text.code, statics)
proof
  fix c statics
  assume hc hx hst
  let AC := mallocng_specs.a_crash_spec_fun()
  let DQ := c_src_malloc_mallocng_malloc_cfg.dequeue_fun
  let AG := c_src_malloc_mallocng_malloc_cfg.activate_group_fun(AC, c_src_malloc_mallocng_malloc_cfg.a_cas_fun())
  let DB := c_src_malloc_mallocng_malloc_cfg.decay_bounces_fun()
  let LOW := c_src_malloc_mallocng_malloc.try_avail_fun(DQ, AG, AC, DB)
  have hdr := all_elim(mp.ta_divg, {c})
  // the callees: dequeue by its spec, activate_group and decay_bounces by
  // their contracts at a call
  have hgq: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
      runs(DQ[regs], s, o) -> runs(mallocng_specs.dequeue_spec_fun()[regs], s, o) proof
    fix regs s o
    assume h1 h2 h3 hr
    show := mp(all_elim(mp.dq_fun, {regs}, {s}, {o}), h1, h2, h3, mp(all_elim(dequeue_ref, {regs}, {s}, {o}), h1, h2, h3, hr))
  qed
  have agr := mp(all_elim(activate_group_ref, {AC}, {c_src_malloc_mallocng_malloc_cfg.a_cas_fun()}), acr.io, acstc.io)
  have hag := apply(mp.ag_call_ref[c := c, f := AG, f2 := c_src_malloc_mallocng_malloc.activate_group_fun(AC, c_src_malloc_mallocng_malloc_cfg.a_cas_fun())], agr,
    mp(all_elim(mp.ag_q, {c}, {AC}, {c_src_malloc_mallocng_malloc_cfg.a_cas_fun()}), hc, cc.a_cas))
  have hdb := apply(mp.db_call_ref[c := c, f := DB, f2 := c_src_malloc_mallocng_malloc.decay_bounces_fun()], decay_bounces_ref, mp(all_elim(mp.db_q, {c}), hc, hx))
  have r: all args. args in abi.ARGS -> refines_ghost(LOW[args], mallocng_specs.try_avail_spec_fun(c)[args], abi.World, mp.G) proof
    fix args
    assume ha
    show := mp(all_elim(mp.ta_fun, {c}, {args}, {DQ}, {AG}, {AC}, {DB}), hc, hx, hst, hgq, hag, hdb, ha)
  qed
  // the machine code: try_avail's CFG form linked, refining the structured one
  have rf := mp(all_elim(try_avail_ref, {DQ}, {AG}, {AC}, {DB}), dqtc.io, agtc.io_linked, acr.io, dbtc.io)
  have st := mp(all_elim(tr.implements_refine, {4209736}, {c_src_malloc_mallocng_malloc_cfg.try_avail_fun(DQ, AG, AC, DB)}, {LOW},
    {4198400}, {text.code}, {statics}), all_elim(tatc.linked, {statics}), rf)
  show := mp(all_elim(tr.implements_abi_g, {mp.G}, {4209736}, {LOW}, {mallocng_specs.try_avail_spec_fun(c)}, {4198400}, {text.code}, {statics}),
    mp.g_ok, hdr, st, r)
qed

// what a caller relies on of a callee f called as try_avail (its C function
// value) on class sc's list, the ghost part h read: an overflow, or the
// return -- the list reorganised, a slot of its head reserved and its bit
// in the result register's low 32 bits, or 0 and the list empty
abbrev mp.ta_call(c, f) := all sc pm t h regs o2. sc in omega -> int_lt(sc, 48) -> pm in bits(64) -> pm = int_add(int_add(c.ctx, mallocng.C_ACTIVE), int_mul(8, sc)) ->
  t in abi.World -> h in mp.G ->
  mallocng.holds_m(c, h.A, t.vm, h.blocks) -> mallocng.shown_in(c, h.A, t.objs) -> mallocng.no_reserved(h.A) -> abi.thread_ok(t.vm, t.fs_base) -> mallocng_specs.tls_apart(c, h.A, h.blocks, t.fs_base) ->
  gc.regs_ok(regs, seq_one(gimple.arg(64, pm))) ->
  runs(f[regs], t, o2) ->
  abi.ovf_out(t, o2) ||
  (ex V2 rr. (V2 in x86_64_linux.Vm && (ex A2 r. ((A2 in mallocng.Abs && A2 in univ(1)) && mallocng.reorganised(h.A, A2, sc)) && r in bits(32) &&
     ((r = 0 && seq_len(A2.active[sc]) = 0 && (all g. g in omega -> mallocng.on_list(h.A.active[sc], g) -> !mallocng.has_unused(h.A, g)) && A2.slots = h.A.slots) ||
      (ex i. i in omega && ((int_lt(i, 32) && r = int_pow(2, i)) && ord_lt(0, seq_len(A2.active[sc]))) && mallocng.reserves(h.A, A2, A2.active[sc][0], i))) &&
     mallocng.holds_m(c, A2, V2, h.blocks) && mallocng.kept_outside(c, h.A, h.blocks, t.vm, V2, empty) && bits_of_int(32, fst(rr)) = r)) &&
     o2 = ok(fn_update(t, "vm", V2), rr))

// (a callee refining one called as try_avail: called as it too)
theorem mp.ta_call_ref(c, f, f2): (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(f[regs], s, o) -> runs(f2[regs], s, o)) ->
  mp.ta_call(c, f2) -> mp.ta_call(c, f)
proof
  assume hf q
  fix sc pm t h regs o2
  assume hs hsl hpb hpe hw hh hin hsh hnr hth htl hro hr
  have rl rn _ := apply(gc.regs1, hpb, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have r2 := mp(all_elim(hf, {regs}, {t}, {o2}), rl, (int_le(seq_len(regs), 6) by arith(rn, lo)), hw, hr)
  show := mp(all_elim(q, {sc}, {pm}, {t}, {h}, {regs}, {o2}), hs, hsl, hpb, hpe, hw, hh, hin, hsh, hnr, hth, htl, hro, r2)
qed

// try_avail's code called as try_avail
theorem mp.ta_q: all c gq gag ga gdb. c in mallocng.Cfg -> c.ctx = c_src_malloc_mallocng_malloc.__malloc_context ->
  c.sct = c_src_malloc_mallocng_malloc.__malloc_size_classes ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(gq[regs], s, o) -> runs(mallocng_specs.dequeue_spec_fun()[regs], s, o)) ->
  mp.ag_call(c, gag) -> mp.db_call(c, gdb) ->
  mp.ta_call(c, c_src_malloc_mallocng_malloc.try_avail_fun(gq, gag, ga, gdb))
proof
  fix c gq gag ga gdb
  assume hc hx hst hgq hag hdb
  fix sc pm t h regs o2
  assume hs hsl hpb hpe hw hh hin hsh hnr hth htl hro hr
  have rl rn r0 := apply(gc.regs1, hpb, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  have o1l: ord_le(1, seq_len(regs)) by defs(simp(rn), ord_le)
  have bp: bits_of_int(64, regs[0]) = pm by defs(simp(r0, hpb), bits_of_int, pow2)
  step o3 A2 V2 r, e hs1 from hr with o1l, bp, mp.ta_run using ra, hc, hx, hst, hs, hsl, hpb, hpe, hgq, hag, hdb, hw, hh, hin, hsh, hnr, hth, htl
  have ha2 hu2 hro hrb hrc hv2 hin2 hunt := hs1
  step o4 u y, e2 from e with g.result32_inv using hrb
  have oe _ ur := e2
  have fr: bits_of_int(32, fst(pair(u, y))) = r by simp(ur)
  have inner: ex A3 r3. ((A3 in mallocng.Abs && A3 in univ(1)) && mallocng.reorganised(h.A, A3, sc)) && r3 in bits(32) &&
      ((r3 = 0 && seq_len(A3.active[sc]) = 0 && (all g. g in omega -> mallocng.on_list(h.A.active[sc], g) -> !mallocng.has_unused(h.A, g)) && A3.slots = h.A.slots) ||
       (ex i. i in omega && ((int_lt(i, 32) && r3 = int_pow(2, i)) && ord_lt(0, seq_len(A3.active[sc]))) && mallocng.reserves(h.A, A3, A3.active[sc][0], i))) &&
      mallocng.holds_m(c, A3, V2, h.blocks) && mallocng.kept_outside(c, h.A, h.blocks, t.vm, V2, empty) && bits_of_int(32, fst(pair(u, y))) = r3
    by ex_intro({A2}, {r}, taut(ha2, hu2, hro, hrb, hrc, hin2, hunt, fr))
  have ret: ex V3 rr. (V3 in x86_64_linux.Vm && (ex A3 r3. ((A3 in mallocng.Abs && A3 in univ(1)) && mallocng.reorganised(h.A, A3, sc)) && r3 in bits(32) &&
      ((r3 = 0 && seq_len(A3.active[sc]) = 0 && (all g. g in omega -> mallocng.on_list(h.A.active[sc], g) -> !mallocng.has_unused(h.A, g)) && A3.slots = h.A.slots) ||
       (ex i. i in omega && ((int_lt(i, 32) && r3 = int_pow(2, i)) && ord_lt(0, seq_len(A3.active[sc]))) && mallocng.reserves(h.A, A3, A3.active[sc][0], i))) &&
      mallocng.holds_m(c, A3, V3, h.blocks) && mallocng.kept_outside(c, h.A, h.blocks, t.vm, V3, empty) && bits_of_int(32, fst(rr)) = r3)) &&
      o2 = ok(fn_update(t, "vm", V3), rr)
    by ex_intro({V2}, {pair(u, y)}, taut(hv2, inner, oe))
  show by disj({2}, ret)
qed
