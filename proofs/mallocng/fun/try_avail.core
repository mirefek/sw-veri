// try_avail by its purpose: a slot of the head taken; else the head
// dequeued or rotated past, the next head's slots activated (more of
// them if needed) and one taken.

// ----------------------------------------------------------------------
//  try_avail: its code refines its purpose
// (the thread pointer sound, its word not the allocator's: so after the
// allocator's memory changed only, nothing outside it but the stack's free
// bytes -- the word is off the stack)
theorem mp.tls_unt(c, A, b, V0, V1, objs, fs, e): fs in bits(64) -> abi.thread_ok(V0, fs) -> mallocng_specs.tls_apart(c, A, b, fs) ->
  mallocng.untouched(c, A, b, V0, V1, objs, e) -> (all i. i in omega -> int_lt(i, 8) -> !(int_add(fs, i) in e)) -> abi.thread_ok(V1, fs)
proof
  assume hfb ht hap hun he
  have r0 ns0 le0 nz0 := expand(ht, abi.thread_ok)
  have u1 _ := expand(hun, mallocng.untouched)
  have same: all i. i in omega -> int_lt(i, 8) -> V1.bytes[bits_of_int(64, int_add(fs, i))] = V0.bytes[bits_of_int(64, int_add(fs, i))] &&
      V1.pages[int_div(int_add(fs, i), x86_64_linux.PAGE)] = V0.pages[int_div(int_add(fs, i), x86_64_linux.PAGE)] proof
    fix i
    assume hi hil
    have mp1 _ := mp(all_elim(expand(r0, x86_64_linux.readable), {i}), hi, hil)
    have nf := mp(all_elim(expand(hap, mallocng_specs.tls_apart), {i}), hi, hil)
    have ns := mp(all_elim(ns0, {i}), hi, hil)
    have nfr: !abi.stack_free(V0, objs, int_add(fs, i)) by defs(taut(expand(ns, abi.stack_page), mp1), abi.stack_free)
    have bt pt := mp(all_elim(u1, {int_add(fs, i)}), (int_add(fs, i) in omega by arith(hfb, hi)), taut(nf, mp(all_elim(he, {i}), hi, hil), mp1))
    show by taut(mp(bt, nfr), pt)
  qed
  have r1: all x0. x0 in omega -> int_lt(x0, 8) -> x86_64_linux.mapped(V1, int_div(int_add(fs, x0), x86_64_linux.PAGE)) &&
      snd(V1.pages[int_div(int_add(fs, x0), x86_64_linux.PAGE)]).prot.r proof
    fix i
    assume hi hil
    have m0 p0 := mp(all_elim(expand(r0, x86_64_linux.readable), {i}), hi, hil)
    have _ ep := mp(all_elim(same, {i}), hi, hil)
    have m1: x86_64_linux.mapped(V1, int_div(int_add(fs, i), x86_64_linux.PAGE)) by defs(rewrite(sym(ep), expand(m0, x86_64_linux.mapped)), x86_64_linux.mapped)
    show by taut(m1, rewrite(sym(ep), p0))
  qed
  have ns1: all x0. x0 in omega -> int_lt(x0, 8) -> !abi.stack_page(V1, int_div(int_add(fs, x0), x86_64_linux.PAGE)) proof
    fix i
    assume hi hil
    have n0 := mp(all_elim(ns0, {i}), hi, hil)
    have _ ep := mp(all_elim(same, {i}), hi, hil)
    show by defs(rewrite(sym(ep), expand(n0, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
  qed
  // the word itself: its bytes as before
  have eb: all i. i in omega -> int_le(0, i) -> int_lt(i, 8) ->
      int_mul(V1.bytes[bits_add(64, fs, bits_of_int(64, i))], int_pow(256, i)) = int_mul(V0.bytes[bits_add(64, fs, bits_of_int(64, i))], int_pow(256, i)) proof
    fix i
    assume hi _ hil
    have m0 _ := mp(all_elim(expand(r0, x86_64_linux.readable), {i}), hi, hil)
    have ml _ := expand(m0, x86_64_linux.mapped)
    have ts: int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE) = 34359738367 by defs(simp(), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
    have pg: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
    have ea: bits_add(64, fs, bits_of_int(64, i)) = bits_of_int(64, int_add(fs, i)) by defs(arith(hfb, hi, hil, ml, ts, pg), bits_add, bits_of_int, pow2)
    have b1 _ := mp(all_elim(same, {i}), hi, hil)
    show by simp(ea, b1)
  qed
  have sx := mp(int_sum_ext[a := 0, b := 8, f := i. int_mul(V1.bytes[bits_add(64, fs, bits_of_int(64, i))], int_pow(256, i)),
    g := i. int_mul(V0.bytes[bits_add(64, fs, bits_of_int(64, i))], int_pow(256, i))], simp(), simp(), eb)
  have l1: x86_64_linux.le(V1.bytes, fs, 8) = fs by defs(simp(sx, expand(le0, x86_64_linux.le)), x86_64_linux.le)
  show by defs(taut(r1, ns1, l1, nz0), abi.thread_ok, x86_64_linux.readable)
qed

// (... every byte outside kept: so)
theorem mp.tls_kept(c, A, b, V0, V1, fs, e): fs in bits(64) -> abi.thread_ok(V0, fs) -> mallocng_specs.tls_apart(c, A, b, fs) ->
  mallocng.kept_outside(c, A, b, V0, V1, e) -> (all i. i in omega -> int_lt(i, 8) -> !(int_add(fs, i) in e)) -> abi.thread_ok(V1, fs)
proof
  assume hfb ht hap hun he
  show := apply(mp.tls_unt[objs := empty], hfb, ht, hap, apply(mp.kept_unt[objs := empty], hun), he)
qed

// try_avail's purpose (`try_avail_spec`): the list reorganised, a slot of
// its head reserved and its bit returned, or 0 and the list empty, none of
// its groups having had a free slot; the invariant kept, nothing outside
// the allocator touched -- or an overflow
abbrev mp.ta_out(c, A, sc, b, s, o) := abi.ovf_out(s, o) ||
  (ex A2 V2 r. ((A2 in mallocng.Abs && A2 in univ(1)) && mallocng.reorganised(A, A2, sc)) && r in bits(32) &&
     ((r = 0 && seq_len(A2.active[sc]) = 0 && (all g. g in omega -> mallocng.on_list(A.active[sc], g) -> !mallocng.has_unused(A, g)) && A2.slots = A.slots) ||
      (ex i. i in omega && ((int_lt(i, 32) && r = int_pow(2, i)) && ord_lt(0, seq_len(A2.active[sc]))) && mallocng.reserves(A, A2, A2.active[sc][0], i))) &&
     V2 in x86_64_linux.Vm && mallocng.holds_m(c, A2, V2, b) && mallocng.kept_outside(c, A, b, s.vm, V2, empty) &&
     o = ok(fn_update(s, "vm", V2), r))

// try_avail's state where its two ways meet (the head dequeued or rotated
// past): memory V1, abstract state A1 -- the invariant, a reorganisation
// so far, the list's new head with no slot available but some freed
abbrev mp.ta_jst(c, A, sc, B, s, pm, V1, A1) := (V1 in x86_64_linux.Vm && A1 in mallocng.Abs && A1 in univ(1)) &&
  mallocng.holds_m(c, A1, V1, B) && mallocng.no_reserved(A1) && abi.thread_ok(V1, s.fs_base) && mallocng_specs.tls_apart(c, A1, B, s.fs_base) &&
  mallocng_specs.list_at(V1, s.objs, pm, A1.active[sc]) && int_lt(0, seq_len(A1.active[sc])) &&
  A1.metas[A1.active[sc][0]].avail = 0 && !(A1.metas[A1.active[sc][0]].freed = 0) &&
  mallocng.reorganised(A, A1, sc) && mallocng.kept_outside(c, A, B, s.vm, V1, empty) && A1.slots = A.slots &&
  mallocng.footprint(c, A1, B) = mallocng.footprint(c, A, B)

// (A2 of A's reorganisation, with A's slots: of A's geometry)
theorem mp.reorg_geom(A, A2, sc): A in mallocng.Abs -> mallocng.reorganised(A, A2, sc) -> mp.geom(A, fn_update(A2, "slots", A.slots))
proof
  assume ha r
  have e m _ _ _ _ := expand(r, mallocng.reorganised)
  let MA := A.metas
  let AC := A.active
  let SA := A.slots
  let FM := A.free_metas
  let A3 := fn_update(A2, "slots", SA)
  let L := fn_update(fn_update(fn_update(A3, "metas", MA), "active", AC), "free_metas", FM)
  have e1 := mp(fn_update_swap[f := A2, k := "slots", a := SA, j := "metas", b := MA], simp())
  have e2 := mp(fn_update_swap[f := fn_update(A2, "metas", MA), k := "slots", a := SA, j := "active", b := AC], simp())
  have t1 := subst({y. L = fn_update(fn_update(y, "active", AC), "free_metas", FM)}, e1, refl({L}))
  have t2 := subst({y. L = fn_update(y, "free_metas", FM)}, e2, t1)
  have t3 := subst({y. L = fn_update(y, "free_metas", FM)}, e, t2)
  have oth: L = A := trans(t3, mp(fn_update_same[f := A, k := "free_metas"], simp(ha), simp(ha)))
  have em := mp(app_update_other[f := A2, k := "slots", v := SA, x := "metas"], simp())
  have gr: all x. x in omega -> A3.metas[x].mem = A.metas[x].mem && A3.metas[x].maplen = A.metas[x].maplen &&
      A3.metas[x].last_idx = A.metas[x].last_idx && A3.metas[x].sizeclass = A.metas[x].sizeclass && A3.metas[x].freeable = A.metas[x].freeable proof
    fix x
    assume hx
    let RA := fn_update(fn_update(fn_update(fn_update(A.metas[x], "prev", 0), "next", 0), "avail", 0), "freed", 0)
    have mx := sym(mp(all_elim(m, {x}), hx))
    have q1 := subst({y. y.mem = A.metas[x].mem}, mx, (RA.mem = A.metas[x].mem by simp()))
    have q2 := subst({y. y.maplen = A.metas[x].maplen}, mx, (RA.maplen = A.metas[x].maplen by simp()))
    have q3 := subst({y. y.last_idx = A.metas[x].last_idx}, mx, (RA.last_idx = A.metas[x].last_idx by simp()))
    have q4 := subst({y. y.sizeclass = A.metas[x].sizeclass}, mx, (RA.sizeclass = A.metas[x].sizeclass by simp()))
    have q5 := subst({y. y.freeable = A.metas[x].freeable}, mx, (RA.freeable = A.metas[x].freeable by simp()))
    show by simp(em, q1, q2, q3, q4, q5)
  qed
  show by taut(oth, gr)
qed

// (... its groups' places, classes and slot sizes as before)
theorem mp.reorg_ranges(c, A, A2, sc): A in mallocng.Abs -> mallocng.reorganised(A, A2, sc) ->
  ranges: mallocng.fp_ranges(c, A2) = mallocng.fp_ranges(c, A) &&
  meta: (all x. x in omega -> A2.metas[x].sizeclass = A.metas[x].sizeclass && mallocng.stride(A2.metas[x]) = mallocng.stride(A.metas[x])) &&
  taken: A2.taken = A.taken
proof
  assume ha r
  have e0 _ _ _ _ _ := expand(r, mallocng.reorganised)
  have tk: A2.taken = A.taken := subst({y. A2.taken = y.taken}, e0,
    (A2.taken = fn_update(fn_update(fn_update(A2, "metas", A.metas), "active", A.active), "slots", A.slots).taken by simp()))
  let A3 := fn_update(A2, "slots", A.slots)
  have g := apply(mp.reorg_geom, ha, r)
  have r3 := apply(mp.gm_ranges[c := c, A := A, A2 := A3], ha, g)
  have s3: mallocng.fp_ranges(c, A3) = mallocng.fp_ranges(c, A2) by defs(simp(), mallocng.fp_ranges, mallocng.fixed_ranges, mallocng.auxv_ranges)
  have mt: all x. x in omega -> A2.metas[x].sizeclass = A.metas[x].sizeclass && mallocng.stride(A2.metas[x]) = mallocng.stride(A.metas[x]) proof
    fix x
    assume hx
    have {s1 = sclass, s2 = stride} := apply(mp.gm_geom[A := A, A2 := A3, x := x], g, hx)
    have em := mp(app_update_other[f := A2, k := "slots", v := A.slots, x := "metas"], simp())
    show := rewrite(em, conj(s1, s2))
  qed
  show by taut(trans(sym(s3), r3), mt, tk)
qed

// (... the allocator's bytes the world's as before: its ranges and
// reserve A's)
theorem mp.shown_reorg(c, A, A2, sc, objs): A in mallocng.Abs -> mallocng.reorganised(A, A2, sc) -> mallocng.shown_in(c, A, objs) -> mallocng.shown_in(c, A2, objs)
proof
  assume ha r hs
  have {rg = ranges} := apply(mp.reorg_ranges[c := c, A := A, A2 := A2, sc := sc], ha, r)
  have g := apply(mp.reorg_geom, ha, r)
  have r1 := apply(mp.gm_field[A := A, A2 := fn_update(A2, "slots", A.slots), k := "reserve"], g, simp(), simp(), simp())
  have r2 := apply(mp.gm_field[A := A, A2 := fn_update(A2, "slots", A.slots), k := "reserve_cnt"], g, simp(), simp(), simp())
  show := apply(mp.shown_same[c := c, A := A, A2 := A2, objs := objs], hs, rg, simp(r1), simp(r2))
qed

// (reorganisations in a row, the slots as before: a reorganisation)
theorem mp.reorg_trans(A, A1, A2, sc): mallocng.reorganised(A, A1, sc) -> mallocng.reorganised(A1, A2, sc) -> A1.slots = A.slots ->
  mallocng.reorganised(A, A2, sc)
proof
  assume r1 r2 sl
  have e1 m1 l1 o1 s1 d1 := expand(r1, mallocng.reorganised)
  have e2 m2 l2 o2 s2 d2 := expand(r2, mallocng.reorganised)
  have e: fn_update(fn_update(fn_update(A2, "metas", A.metas), "active", A.active), "slots", A.slots) = A proof
    have f := rewrite(sym(e2), e1)
    show by simp(f)
  qed
  have m: all x. x in omega -> fn_update(fn_update(fn_update(fn_update(A2.metas[x], "prev", 0), "next", 0), "avail", 0), "freed", 0) =
      fn_update(fn_update(fn_update(fn_update(A.metas[x], "prev", 0), "next", 0), "avail", 0), "freed", 0) proof
    fix x
    assume hx
    show := trans(mp(all_elim(m2, {x}), hx), mp(all_elim(m1, {x}), hx))
  qed
  have l: seq_len(A2.active) = seq_len(A.active) := trans(l2, l1)
  have o: all x. x in omega -> !(x = sc) -> A2.active[x] = A.active[x] proof
    fix x
    assume hx hn
    show := trans(mp(all_elim(o2, {x}), hx, hn), mp(all_elim(o1, {x}), hx, hn))
  qed
  have sb: all x. x in omega -> mallocng.on_list(A2.active[sc], x) -> mallocng.on_list(A.active[sc], x) proof
    fix x
    assume hx h
    show := mp(all_elim(s1, {x}), hx, mp(all_elim(s2, {x}), hx, h))
  qed
  have hue: all x. mallocng.has_unused(A1, x) = mallocng.has_unused(A, x) proof
    fix x
    show by defs(simp(sl), mallocng.has_unused)
  qed
  have d: all x. x in omega -> mallocng.on_list(A.active[sc], x) && !mallocng.on_list(A2.active[sc], x) -> !mallocng.has_unused(A, x) proof
    fix x
    assume hx h
    have h1 h2 := h
    have c1: mallocng.on_list(A1.active[sc], x) -> !mallocng.has_unused(A, x) proof
      assume ol
      show := rewrite(all_elim(hue, {x}), mp(all_elim(d2, {x}), hx, conj(ol, h2)))
    qed
    have c2: !mallocng.on_list(A1.active[sc], x) -> !mallocng.has_unused(A, x) proof
      assume nl
      show := mp(all_elim(d1, {x}), hx, conj(h1, nl))
    qed
    show by taut(c1, c2)
  qed
  show by defs(taut(e, m, l, o, sb, d), mallocng.reorganised)
qed

// (memory untouched outside the allocator twice, its footprint as before:
// untouched)
theorem mp.unt_trans(c, A, A1, b, V0, V1, V2, e): mallocng.kept_outside(c, A, b, V0, V1, e) -> mallocng.kept_outside(c, A1, b, V1, V2, e) ->
  mallocng.footprint(c, A1, b) = mallocng.footprint(c, A, b) -> mallocng.kept_outside(c, A, b, V0, V2, e)
proof
  assume u1 u2 fe
  have a1 b1 := expand(u1, mallocng.kept_outside)
  have a2 b2 := rewrite(fe, expand(u2, mallocng.kept_outside))
  have r: all x0. x0 in omega -> (!(x0 in mallocng.footprint(c, A, b)) && !(x0 in e)) && x86_64_linux.mapped(V0, int_div(x0, x86_64_linux.PAGE)) ->
      V2.bytes[bits_of_int(64, x0)] = V0.bytes[bits_of_int(64, x0)] && V2.pages[int_div(x0, x86_64_linux.PAGE)] = V0.pages[int_div(x0, x86_64_linux.PAGE)] proof
    fix a
    assume ha hq
    have q1 q2 q3 := hq
    have p1 pp1 := mp(all_elim(a1, {a}), ha, hq)
    have m1: x86_64_linux.mapped(V1, int_div(a, x86_64_linux.PAGE)) by defs(rewrite(sym(pp1), expand(q3, x86_64_linux.mapped)), x86_64_linux.mapped)
    have p2 pp2 := mp(all_elim(a2, {a}), ha, conj(conj(q1, q2), m1))
    show by taut(trans(p2, p1), trans(pp2, pp1))
  qed
  show by defs(taut(r, trans(b2, b1)), mallocng.kept_outside)
qed

// (a meta's freeable bit, as the code tests it: bit 5 of its word's first
// byte)
theorem mp.free_bit(vm, g): vm.bytes in fn_space(bits(64), bits(8)) -> g in bits(64) -> int_le(int_add(g, 40), int_pow(2, 64)) ->
  bits_and(8, bits_of_int(8, int_mod(int_div(gimple.bytes_at(vm, int_add(g, 32), 1), int_pow(2, 0)), int_pow(2, 8))), 32) =
    int_mul(32, int_mod(int_div(gimple.bytes_at(vm, int_add(g, 32), 8), 32), 2))
proof
  assume hb hg h40
  let A := int_add(g, 32)
  let W := gimple.bytes_at(vm, A, 8)
  let B1 := gimple.bytes_at(vm, A, 1)
  let B7 := gimple.bytes_at(vm, int_add(g, 33), 7)
  have ab: A in bits(64) by arith(hg, h40)
  have a33: bits_add(64, A, 1) = int_add(g, 33) by defs(arith(hg, h40), bits_add, pow2)
  have s17 := mp(all_elim(g.bytes_split, {vm}, {A}, {1}, {7}), ab, simp(), simp())
  have w17: W = int_add(B1, int_mul(256, B7)) by simp(s17, a33)
  have b1o b1l := mp(all_elim(g.bytes_bound, {vm}, {A}, {1}), hb, simp())
  have b7o b7l := mp(all_elim(g.bytes_bound, {vm}, {int_add(g, 33)}, {7}), hb, simp())
  have b1v: int_lt(B1, 256) by simp(b1l)
  have pw: int_pow(2, 0) = 1 && int_pow(2, 8) = 256 by simp()
  have bb1: B1 in bits(8) by arith(b1o, b1v)
  have e1L: int_mod(int_div(B1, 1), 256) = B1 by arith(b1o, b1v)
  have e1: bits_of_int(8, int_mod(int_div(B1, int_pow(2, 0)), int_pow(2, 8))) = B1 by simp(pw, e1L, bb1)
  have m1: bits_and(8, B1, 32) = int_mul(32, int_mod(int_div(B1, 32), 2)) by bitwise({8}, bb1)
  have m1w: int_mod(int_div(B1, 32), 2) = int_mod(int_div(W, 32), 2) by arith(w17, b1o, b1v, b7o)
  show by simp(e1, m1, m1w)
qed

// (from such a state the list rotated once more: such a state again, the
// second group the head)
theorem mp.jst_rot(c, A, sc, B, s, pm, V1, A1): c in mallocng.Cfg -> int_mod(c.ctx, 8) = 0 -> sc in omega -> int_lt(sc, 48) -> pm in bits(64) ->
  pm = int_add(int_add(c.ctx, mallocng.C_ACTIVE), int_mul(8, sc)) -> B in fn_space(bits(64), option(omega)) -> s.fs_base in bits(64) ->
  A in mallocng.Abs -> mallocng.shown_in(c, A, s.objs) -> mp.ta_jst(c, A, sc, B, s, pm, V1, A1) ->
  mp.ta_jst(c, A, sc, B, s, pm, mallocng_specs.wr64(V1, pm, A1.active[sc][int_mod(1, seq_len(A1.active[sc]))]),
    mp.relist(A1, sc, mp.rot(A1.active[sc]), mallocng_specs.wr64(V1, pm, A1.active[sc][int_mod(1, seq_len(A1.active[sc]))]))) &&
  mp.relist(A1, sc, mp.rot(A1.active[sc]), mallocng_specs.wr64(V1, pm, A1.active[sc][int_mod(1, seq_len(A1.active[sc]))])).active[sc][0] =
    A1.active[sc][int_mod(1, seq_len(A1.active[sc]))]
proof
  assume hc cal hs hsl hpb hpe hbt hfb hAa hsh0 J
  have v1v a1a a1u hin1 nr1 th1 tl1 la1 ln1 av1 fr1 ro1 un1 sl1 fp1 := J
  have hsh := apply(mp.shown_reorg[c := c, A := A, A2 := A1, sc := sc, objs := s.objs], hAa, ro1, hsh0)
  let L := A1.active[sc]
  let n := seq_len(L)
  let X1 := L[int_mod(1, n)]
  let V2 := mallocng_specs.wr64(V1, pm, X1)
  let A2 := mp.relist(A1, sc, mp.rot(L), V2)
  have vb: V1.bytes in fn_space(bits(64), bits(8)) by simp(v1v)
  have {H1 = inv} := expand(hin1, mallocng.holds_m)
  have {cok = ctx, hac = active} := expand(H1, mallocng.holds)
  have {c11 = nactive} := expand(cok, mallocng.ctx_ok)
  have al0: A1.active in list_type(list_type(omega)) by simp(a1a)
  have ll := mp(at_type[l := A1.active, t := list_type(omega), i := sc], al0, hs, (int_lt(sc, seq_len(A1.active)) by arith(c11, hsl)))
  have lo: n in omega by simp(ll)
  have st := apply(mp.rot_step[c := c, A := A1, vm := V1, b := B, sc := sc], hc, a1u, a1a, hbt, v1v, hin1, hsh, cal, hs, hsl, ln1, av1, fr1)
  have {sa = abs, su = univ, sh = holds, sr = reorg, sn = unt, ss = slots, sl = list, sv = vm} := rewrite(sym(hpe), st)
  // the new head: none available, some freed (the old one if alone)
  have {rg = geom, rm = masks} := apply(mp.relist_geom[A := A1, sc := sc, l2 := mp.rot(L), vm := V2], a1a)
  have x1o := apply(at_type[l := L, t := omega, i := int_mod(1, n)], ll, arith(ln1, lo), arith(ln1, lo))
  have avf: A1.metas[X1].avail = 0 && !(A1.metas[X1].freed = 0) proof
    have one: int_mod(1, n) = 0 -> A1.metas[X1].avail = 0 && !(A1.metas[X1].freed = 0) proof
      assume z
      have e0x: X1 = L[0] := subst({y. L[int_mod(1, n)] = L[y]}, z, refl({X1}))
      show := rewrite(sym(e0x), conj(av1, fr1))
    qed
    have more: !(int_mod(1, n) = 0) -> A1.metas[X1].avail = 0 && !(A1.metas[X1].freed = 0) proof
      assume nz
      have m1o: int_mod(1, n) in omega by arith(ln1, lo)
      have m1l: int_lt(int_mod(1, n), seq_len(L)) by arith(ln1, lo)
      have _ _ t3 := mp(all_elim(expand(hac, mallocng.active_ok), {sc}, {int_mod(1, n)}), conj(hs, m1o), conj(hsl, m1l))
      show := mp(t3, arith(nz, ln1, lo))
    qed
    show by taut(one, more)
  qed
  have {r0 = elem} := apply(mp.rot_app[l := L, j := 0], ll, ln1)
  have h0: A2.active[sc][0] = X1 by simp(sl, mp(r0, simp(), ln1))
  have ma1 mf1 := mp(all_elim(rm, {X1}), x1o)
  have av2: A2.metas[A2.active[sc][0]].avail = 0 := subst({y. A2.metas[y].avail = 0}, sym(h0), trans(ma1, avf.1))
  have fr2: !(A2.metas[A2.active[sc][0]].freed = 0) := subst({y. !(A2.metas[y].freed = 0)}, sym(h0), rewrite(sym(mf1), avf.2))
  have nr2: mallocng.no_reserved(A2) by defs(rewrite(sym(ss), expand(nr1, mallocng.no_reserved)), mallocng.no_reserved)
  have fpe := apply(mp.gm_fp[c := c, A := A1, A2 := A2, b := B], a1a, rg)
  have tl2: mallocng_specs.tls_apart(c, A2, B, s.fs_base) by defs(rewrite(sym(fpe), expand(tl1, mallocng_specs.tls_apart)), mallocng_specs.tls_apart)
  have th2 := apply(mp.tls_kept[c := c, A := A1, b := B, V0 := V1, V1 := V2, fs := s.fs_base, e := empty], hfb, th1, tl1, sn,
    (all i. i in omega -> int_lt(i, 8) -> !(int_add(s.fs_base, i) in empty) by simp()))
  have la2 := rewrite(sym(sl), apply(mp.rot_list[vm := V1, objs := s.objs, phead := pm, l := L], v1v, vb, hpb, ll, la1, ln1))
  have ln2: int_lt(0, seq_len(A2.active[sc])) by simp(sl, ln1, apply(mp.rot_app[l := L, j := 0], ll, ln1).1)
  have ro2 := apply(mp.reorg_trans[A := A, A1 := A1, A2 := A2, sc := sc], ro1, sr, sl1)
  have un2 := apply(mp.unt_trans[c := c, A := A, A1 := A1, b := B, V0 := s.vm, V1 := V1, V2 := V2, e := empty], un1, sn, fp1)
  have sl2: A2.slots = A.slots := trans(ss, sl1)
  have fp2 := trans(fpe, fp1)
  have J2: mp.ta_jst(c, A, sc, B, s, pm, V2, A2) by taut(sv, sa, su, sh, nr2, th2, tl2, la2, ln2, av2, fr2, ro2, un2, sl2, fp2)
  show by taut(J2, h0)
qed

// (the code's active slots mask, (2 << k) - 1 for k < 32: 2^(k+1) - 1)
theorem mp.low_mask(k): k in omega -> int_lt(k, 32) ->
  bits_add(32, bits_shl(32, bits_of_int(32, 2), k), bits_neg(32, 1)) = int_sub(pow2(int_add(k, 1)), 1)
proof
  assume hk hl
  have two: bits_of_int(32, 2) = 2 by defs(simp(), bits_of_int, pow2)
  have p32: pow2(32) = 4294967296 by simp()
  have lo: int_lt(k, 31) -> bits_add(32, bits_shl(32, bits_of_int(32, 2), k), bits_neg(32, 1)) = int_sub(pow2(int_add(k, 1)), 1) proof
    assume h
    have s := mp(shl_two[n := 32, k := k], simp(), hk, arith(h, hk))
    have pp := mp(pow2_pos[k := int_add(k, 1)], arith(hk))
    have pl := mp(pow2_le[a := int_add(k, 1), b := 31], arith(hk), simp(), arith(h, hk))
    have p31: pow2(31) = 2147483648 by simp()
    have d := mp(all_elim(ms.dec32, {pow2(int_add(k, 1))}), arith(pp), arith(pp), arith(pl, p31))
    show by simp(two, s, d)
  qed
  have top: k = 31 -> bits_add(32, bits_shl(32, bits_of_int(32, 2), k), bits_neg(32, 1)) = int_sub(pow2(int_add(k, 1)), 1) proof
    assume h
    have z: bits_shl(32, 2, 31) = 0 by bitwise({32})
    have n: bits_add(32, 0, bits_neg(32, 1)) = 4294967295 by defs(simp(), bits_add, bits_neg, pow2)
    show by simp(h, two, z, n, p32)
  qed
  show by taut(lo, top, (int_lt(k, 31) || k = 31 by arith(hk, hl)))
qed

// (a 32-bit word's bits up to k: some set exactly when the word masked to
// them is not 0)
theorem mp.low_nz(F, k): F in bits(32) -> k in omega -> int_lt(k, 32) ->
  (!(bits_and(32, F, int_sub(pow2(int_add(k, 1)), 1)) = 0) <-> (ex i. i in omega && int_le(i, k) && bit(F, i)))
proof
  assume hf hk hl
  have fw: (ex i. i in omega && int_le(i, k) && bit(F, i)) -> !(bits_and(32, F, int_sub(pow2(int_add(k, 1)), 1)) = 0) proof
    assume ex
    obtain i, io il hb from ex
    have bz: bit(bits_and(32, F, int_sub(pow2(int_add(k, 1)), 1)), i) by bitwise(hf, hk, hl, io, il, hb)
    have n0 := mp(bit_zero_none[j := i], io)
    show proof
      assume z
      show by taut(rewrite(z, bz), n0)
    qed
  qed
  have bw: !(ex i. i in omega && int_le(i, k) && bit(F, i)) -> bits_and(32, F, int_sub(pow2(int_add(k, 1)), 1)) = 0 proof
    assume nx
    have na: all i. i in omega -> int_le(i, k) -> !bit(F, i) proof
      fix i
      assume io il
      have c: bit(F, i) -> false proof
        assume hb
        have e: ex i. i in omega && int_le(i, k) && bit(F, i) by ex_intro({i}, taut(io, il, hb))
        show by taut(nx, e)
      qed
      show by taut(c)
    qed
    show by bitwise({32}, hf, hk, hl, na)
  qed
  show by taut(fw, bw)
qed

// (a group's active index, its header byte not written: as before)
theorem mp.aidx_wr64(V, p, w, v): V.bytes in fn_space(bits(64), bits(8)) -> mallocng_specs.wr64(V, p, w).bytes in fn_space(bits(64), bits(8)) ->
  p in bits(64) -> int_le(int_add(p, 8), 18446744073709551616) -> int_add(v.mem, 8) in bits(64) ->
  (int_le(int_add(p, 8), int_add(v.mem, 8)) || int_lt(int_add(v.mem, 8), p)) ->
  mallocng_specs.active_idx(mallocng_specs.wr64(V, p, w), v) = mallocng_specs.active_idx(V, v)
proof
  assume hb wb hp hpl ha ho
  let a := int_add(v.mem, 8)
  have ao: a in omega by arith(ha)
  have ab: a in mallocng.all_bytes by defs(simp(ao), mallocng.all_bytes)
  have e1 _ := apply(mp.b8_view[vm := mallocng_specs.wr64(V, p, w), fp := mallocng.all_bytes, a := a], wb, ao, ab)
  have e0 _ := apply(mp.b8_view[vm := V, fp := mallocng.all_bytes, a := a], hb, ao, ab)
  have ea: bits_of_int(64, a) = a by defs(arith(ha), bits_of_int, pow2)
  have s := apply(mp.wb_out[V := V, c := p, v := w, x := bits_of_int(64, a)], rewrite(sym(ea), ha), hp, hpl, rewrite(sym(ea), ho))
  show by defs(simp(e1, e0, s), mallocng_specs.active_idx)
qed

// (GIMPLE's bitfield store, its one outcome: the size bytes at p + off
// with the field's k bits at pos replaced by v's)
theorem ms.stbf_det: all s p off size pos k v. s in univ(1) -> p in bits(64) -> off in bits(32) -> size in omega -> int_lt(size, 18446744073709551616) ->
  g.mem_defined(s, p, off, size, true) -> s.vm in x86_64_linux.Vm -> is_fun(s) -> "vm" in dom(s) ->
  g.det(gimple.stbf(p, off, size, pos, k, v), s, ok(fn_update(s, "vm", fn_update(s.vm, "bytes", x86_64_linux.store_le(s.vm.bytes, int_add(p, off), size,
    int_add(bits_and(128, gimple.b128(gimple.bytes_at(s.vm, int_add(p, off), size)), bits_not(128, gimple.b128(int_mul(int_pow(2, pos), int_sub(int_pow(2, k), 1))))),
      int_mul(int_mod(v, int_pow(2, k)), int_pow(2, pos)))))), empty))
proof
  fix s p off size pos k v
  assume hs hp ho hn hn2 hd hvm hf hdm
  let VAL := int_add(bits_and(128, gimple.b128(gimple.bytes_at(s.vm, int_add(p, off), size)), bits_not(128, gimple.b128(int_mul(int_pow(2, pos), int_sub(int_pow(2, k), 1))))),
    int_mul(int_mod(v, int_pow(2, k)), int_pow(2, pos)))
  have md := apply(g.mem_det, {s}, {p}, {off}, {size}, {true}, hs, hp, ho, hd)
  have ab: int_add(p, off) in bits(64) by simp(hd, hp, ho)
  have wd := apply(g.write_det, {s}, {int_add(p, off)}, {size}, {VAL}, ab, hn, hn2, hvm, hf, hdm)
  show proof
    fix o
    assume hr
    have b := apply(g.runs_elim, hr)
    have b2 := apply(g.bind_inv, b, md)
    show := apply(g.bind_inv, b2, wd)
  qed
qed

// (16 is no multiple of a number above it)
theorem mp.mul_16(Z, u): Z in omega -> u in int -> int_lt(16, Z) -> !(int_mul(Z, u) = 16)
proof
  assume hz hu hl
  show by arith(hz, hu, hl, refl({int_mul(Z, int_sub(u, 1))}), refl({int_mul(Z, int_neg(u))}))
qed

// The span loop's exit: the span 16 + Z cnt grows by Z while its next slot
// stays within one page (4096 bytes); it reaches a new page only landing
// on the page's start exactly. That twice, a page apart, would make Z
// divide 4096 and 4096 (q0 + 1) - 16, so 16 -- not for Z above 16. So the
// span stays within its first page or, past an exact landing, the next.
abbrev mp.hq(x, Z, q0) := int_div(x, 4096) = q0 ||
  (int_div(x, 4096) = int_add(q0, 1) && (ex j. j in omega && int_mul(4096, int_add(q0, 1)) = int_add(16, int_mul(Z, j))))

theorem mp.span_next(Z, c, q0): Z in omega -> int_lt(16, Z) -> c in omega -> q0 in omega ->
  mp.hq(int_add(16, int_mul(Z, c)), Z, q0) ->
  int_div(int_add(16, int_mul(Z, c)), 4096) = int_div(int_add(int_add(16, int_mul(Z, c)), int_sub(Z, 1)), 4096) ->
  mp.hq(int_add(16, int_mul(Z, int_add(c, 1))), Z, q0)
proof
  assume hz hl hc hq H same
  let x := int_add(16, int_mul(Z, c))
  let x1 := int_add(16, int_mul(Z, int_add(c, 1)))
  let q := int_div(x, 4096)
  have xo: x in omega by arith(hz, hc)
  have ex1: x1 = int_add(x, Z) by arith(refl({int_mul(Z, int_add(c, 1))}))
  // within the page: the same page
  have inp: int_lt(x1, int_mul(4096, int_add(q, 1))) -> mp.hq(x1, Z, q0) proof
    assume h
    have dq: int_div(x1, 4096) = q by arith(h, ex1, xo, hz)
    show := rewrite(sym(dq), H)
  qed
  // at the next page's start: past the first page once
  have at: x1 = int_mul(4096, int_add(q, 1)) -> mp.hq(x1, Z, q0) proof
    assume h
    have dq: int_div(x1, 4096) = int_add(q, 1) by arith(h, xo)
    have first: q = q0 -> mp.hq(x1, Z, q0) proof
      assume e
      have w: ex j. j in omega && int_mul(4096, int_add(q0, 1)) = int_add(16, int_mul(Z, j)) by ex_intro({int_add(c, 1)}, taut((int_add(c, 1) in omega by arith(hc)), rewrite(e, sym(h))))
      show by taut(rewrite(e, dq), w)
    qed
    have second: q = int_add(q0, 1) -> (ex j. j in omega && int_mul(4096, int_add(q0, 1)) = int_add(16, int_mul(Z, j))) -> false proof
      assume e ex
      obtain j, jo hj from ex
      let t := int_sub(int_add(c, 1), j)
      have zt: int_mul(Z, t) = 4096 by arith(h, e, hj, refl({int_mul(Z, t)}), refl({int_mul(Z, int_add(c, 1))}))
      have m: int_mul(int_mul(Z, t), int_add(q0, 1)) = int_mul(4096, int_add(q0, 1)) :=
        subst({y. int_mul(int_mul(Z, t), int_add(q0, 1)) = int_mul(y, int_add(q0, 1))}, zt, refl({int_mul(int_mul(Z, t), int_add(q0, 1))}))
      let u := int_sub(int_mul(t, int_add(q0, 1)), j)
      have zu: int_mul(Z, u) = 16 by arith(m, hj, refl({int_mul(Z, u)}))
      show by taut(mp(mp.mul_16[Z := Z, u := u], hz, arith(hc, jo, hq), hl), zu)
    qed
    show by taut(H, first, second, dq)
  qed
  show by arith(inp, at, same, ex1, xo, hz)
qed

// (two words below 2^31: their xor too)
theorem mp.xor_small(a, b): a in bits(31) -> b in bits(31) -> int_lt(bits_xor(32, a, b), 2147483648)
proof
  assume ha hb
  have xb := apply(bits_xor_in[n := 32, x := a, y := b], simp())
  have hi: all i. i in omega -> int_le(31, i) -> int_lt(i, 32) -> !bit(bits_xor(32, a, b), i) proof
    fix i
    assume io l1 l2
    show by bitwise(ha, hb, io, l1, l2)
  qed
  have lt := apply(bits_below[n := 32, z := bits_xor(32, a, b), k := 31], simp(), simp(), simp(), xb, hi)
  show by simp(lt)
qed

// (a header byte's low 5 bits, as the code reads the active index)
theorem mp.idx5(x): x in omega -> bits_of_int(5, int_mod(int_div(x, int_pow(2, 0)), int_pow(2, 5))) = int_mod(x, 32)
proof
  assume hx
  show by defs(arith(hx), bits_of_int, pow2)
qed

// (a group with no slot available but some freed: a freed one, at most its
// last)
theorem mp.freed_some(c, A, vm, b, g): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> vm.bytes in fn_space(bits(64), bits(8)) ->
  mallocng.holds_m(c, A, vm, b) -> mallocng.no_reserved(A) -> mallocng.is_used(A, g) -> A.metas[g].avail = 0 -> !(A.metas[g].freed = 0) ->
  fb: A.metas[g].freed in bits(32) && some: (ex i. i in omega && int_le(i, A.metas[g].last_idx) && bit(A.metas[g].freed, i))
proof
  assume hc hu ha hvb hin hnr iu avx fx
  let F := A.metas[g].freed
  have {H = inv} := expand(hin, mallocng.holds_m)
  have {huo = used} := expand(H, mallocng.holds)
  have {gmasks = masks} := expand(apply(mp.used_group, huo, iu), mallocng.group_ok)
  have {gfr = freed} := apply(mp.grp_acc[c := c, A := A, vm := vm, b := b, objs := mp.no_objs, g := g], hc, hu, ha, hvb, hin, all_elim(mp.shown_none, {c}, {A}), hnr, iu)
  have fbo fbl := mp(all_elim(g.bytes_bound, {vm}, {int_add(g, 28)}, {4}), hvb, simp())
  have fb: F in bits(32) by arith(rewrite(gfr, fbo), rewrite(gfr, fbl), (int_pow(256, 4) = 4294967296 by simp()))
  have fa: bits_and(32, F, int_sub(pow2(int_add(31, 1)), 1)) = F by bitwise({32}, fb)
  have lz := apply(mp.low_nz[F := F, k := 31], fb, simp(), simp())
  have ex: ex i. i in omega && int_le(i, 31) && bit(F, i) by taut(lz, rewrite(sym(fa), fx))
  obtain i, io il hb from ex
  have _ m2 _ _ := mp(all_elim(expand(gmasks, mallocng.masks_ok), {i}), io, arith(il))
  have fo: F in omega by arith(fb)
  have nf: mallocng.bit(F, i) = 1 by simp(apply(mp.nbit[x := F, i := i], fo, io), hb)
  have n0: mallocng.bit(0, i) = 0 by simp(apply(mp.nbit[x := 0, i := i], simp(), io), mp(bit_zero_none[j := i], io))
  have na: mallocng.bit(A.metas[g].avail, i) = 0 := subst({y. mallocng.bit(y, i) = 0}, sym(avx), n0)
  have ile: int_le(i, A.metas[g].last_idx) := mp(m2, (int_lt(0, int_add(mallocng.bit(A.metas[g].avail, i), mallocng.bit(F, i))) by simp(nf, na)))
  have some: ex i. i in omega && int_le(i, A.metas[g].last_idx) && bit(F, i) by ex_intro({i}, taut(io, ile, hb))
  show by taut(fb, some)
qed

// try_avail's state at the activation: where the ways meet, the head with a
// freed slot among its active ones
abbrev mp.ta_act(c, A, sc, B, s, pm, V1, A1) := mp.ta_jst(c, A, sc, B, s, pm, V1, A1) &&
  (ex i. i in omega && int_le(i, mallocng_specs.active_idx(V1, A1.metas[A1.active[sc][0]])) && bit(A1.metas[A1.active[sc][0]].freed, i))

// (from where the ways meet, the head partially active and not alone: the
// list rotated once, the new head -- not partially active, `partial_ok` --
// has its freed slots among its active ones)
theorem mp.act_rot(c, A, sc, B, s, pm, V1, A1): c in mallocng.Cfg -> int_mod(c.ctx, 8) = 0 -> sc in omega -> int_lt(sc, 48) -> pm in bits(64) ->
  pm = int_add(int_add(c.ctx, mallocng.C_ACTIVE), int_mul(8, sc)) -> B in fn_space(bits(64), option(omega)) -> s.fs_base in bits(64) -> A in mallocng.Abs -> mallocng.shown_in(c, A, s.objs) -> 
  mp.ta_jst(c, A, sc, B, s, pm, V1, A1) -> int_lt(1, seq_len(A1.active[sc])) ->
  mallocng.partial(mallocng.mview(V1, mallocng.held(c, A1, B)), A1, A1.active[sc][0]) ->
  mp.ta_act(c, A, sc, B, s, pm, mallocng_specs.wr64(V1, pm, A1.active[sc][int_mod(1, seq_len(A1.active[sc]))]),
    mp.relist(A1, sc, mp.rot(A1.active[sc]), mallocng_specs.wr64(V1, pm, A1.active[sc][int_mod(1, seq_len(A1.active[sc]))]))) &&
  mp.relist(A1, sc, mp.rot(A1.active[sc]), mallocng_specs.wr64(V1, pm, A1.active[sc][int_mod(1, seq_len(A1.active[sc]))])).active[sc][0] =
    A1.active[sc][int_mod(1, seq_len(A1.active[sc]))]
proof
  assume hc cal hs hsl hpb hpe hbt hfb hAa hsh0 J n2 hp
  have v1v a1a a1u hin1 nr1 th1 tl1 la1 ln1 av1 fr1 ro1 un1 sl1 fp1 := J
  have hsh := apply(mp.shown_reorg[c := c, A := A, A2 := A1, sc := sc, objs := s.objs], hAa, ro1, hsh0)
  let L := A1.active[sc]
  let n := seq_len(L)
  let X1 := L[int_mod(1, n)]
  let V2 := mallocng_specs.wr64(V1, pm, X1)
  let A2 := mp.relist(A1, sc, mp.rot(L), V2)
  let MV := mallocng.mview(V1, mallocng.held(c, A1, B))
  have q1 q2 q3 q4 q5 q6 q7 q8 q9 q10 q11 q12 q13 q14 q15 h02 :=
    apply(mp.jst_rot[c := c, A := A, sc := sc, B := B, s := s, pm := pm, V1 := V1, A1 := A1], hc, cal, hs, hsl, hpb, hpe, hbt, hfb, hAa, hsh0, J)
  have J2: mp.ta_jst(c, A, sc, B, s, pm, V2, A2) by taut(q1, q2, q3, q4, q5, q6, q7, q8, q9, q10, q11, q12, q13, q14, q15)
  have vb: V1.bytes in fn_space(bits(64), bits(8)) by simp(v1v)
  have vb2: V2.bytes in fn_space(bits(64), bits(8)) by simp(q1)
  have {H1 = inv} := expand(hin1, mallocng.holds_m)
  have {cok = ctx, hac = active, huo = used, hpo = partial} := expand(H1, mallocng.holds)
  have {c11 = nactive} := expand(cok, mallocng.ctx_ok)
  have al0: A1.active in list_type(list_type(omega)) by simp(a1a)
  have ll := mp(at_type[l := A1.active, t := list_type(omega), i := sc], al0, hs, (int_lt(sc, seq_len(A1.active)) by arith(c11, hsl)))
  have lo: n in omega by simp(ll)
  have m1e: int_mod(1, n) = 1 by arith(n2, lo)
  have e1: X1 = L[1] := subst({y. L[int_mod(1, n)] = L[y]}, m1e, refl({X1}))
  // X1: on the list after the head, so full, in use
  have iu1 _ t3 := mp(all_elim(expand(hac, mallocng.active_ok), {sc}, {1}), conj(hs, (1 in omega by simp())), conj(hsl, n2))
  have avx fx := mp(t3, (int_lt(0, 1) by simp()))
  have l0o := apply(at_type[l := L, t := omega, i := 0], ll, simp(), arith(n2))
  have l1o := apply(at_type[l := L, t := omega, i := 1], ll, simp(), n2)
  have ol0: mallocng.on_list(L, L[0]) by defs(ex_intro({0}, taut((0 in omega by simp()), (int_lt(0, n) by arith(n2)), refl({L[0]}))), mallocng.on_list)
  have ol1: mallocng.on_list(L, L[1]) by defs(ex_intro({1}, taut((1 in omega by simp()), n2, refl({L[1]}))), mallocng.on_list)
  // not partially active: the head is, and it is not the head
  have p0 _ := expand(hpo, mallocng.partial_ok)
  have np: mallocng.partial(MV, A1, L[1]) -> false proof
    assume pp
    have e := mp(all_elim(p0, {sc}, {L[0]}, {L[1]}), conj(hs, l0o, l1o), taut(hsl, ol0, ol1, hp, pp))
    have _ k := apply(mp.list_once[c := c, A := A1, M := MV, b := B, brk := V1.brk, s1 := sc, k1 := 1, s2 := sc, k2 := 0],
      H1, hs, (1 in omega by simp()), hs, (0 in omega by simp()), hsl, hsl, n2, (int_lt(0, n) by arith(n2)), sym(e))
    show by arith(k)
  qed
  have gok := apply(mp.used_group, huo, iu1)
  have {gact = act, gmasks = masks} := expand(gok, mallocng.group_ok)
  have vt: A1.metas[L[1]] in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A1.metas, x := L[1]], simp(a1a), l1o)
  have lso: A1.metas[L[1]].last_idx in omega by simp(vt)
  let IH := int_mod(mallocng.b8(MV, int_add(A1.metas[L[1]].mem, 8)), 32)
  have iho: IH in omega by simp(vt)
  have lle: int_le(A1.metas[L[1]].last_idx, IH) proof
    have c: int_lt(IH, A1.metas[L[1]].last_idx) -> false proof
      assume l
      show := mp(np, (mallocng.partial(MV, A1, L[1]) by defs(l, mallocng.partial)))
    qed
    show by arith(c, lso, iho)
  qed
  // a freed slot, so at most the last
  have {gxo = nat, gxt = top} := apply(mp.grp_acc[c := c, A := A1, vm := V1, b := B, objs := s.objs, g := L[1]], hc, a1u, a1a, vb, hin1, hsh, nr1, iu1)
  have {fs = some} := apply(mp.freed_some[c := c, A := A1, vm := V1, b := B, g := L[1]], hc, a1u, a1a, vb, hin1, nr1, iu1, avx, fx)
  obtain i, io ile hb from fs
  // its active index as read after the head's word written
  have ihead := apply(mp.ag_pre[c := c, A := A1, vm := V1, b := B, objs := s.objs, fs := s.fs_base, g := L[1]],
    hc, a1u, a1a, hbt, vb, (L[1] in bits(64) by arith(gxo, gxt)), hin1, hsh, nr1, th1, iu1, avx)
  have {eidx = idx} := ihead
  // (its header byte: in its group, so not in the context, apart from the
  // head's word)
  let HB := int_add(A1.metas[L[1]].mem, 8)
  have memo: A1.metas[L[1]].mem in omega by simp(vt)
  have {gx = hdr} := apply(mp.hdr_bytes, a1a, l1o, gok)
  have g1 g2 := expand(gx, mp.gb)
  have inr := apply(mp.group_bytes[A := A1, M := MV, b := B, h := L[1], a := HB], a1a, l1o, gok, arith(memo), g1, g2)
  have exg: ex hh. mallocng.is_used(A1, hh) && mallocng.in_range(HB, mallocng.group_range(A1.metas[hh])) by ex_intro({L[1]}, taut(iu1, inr))
  have nc := apply(mp.not_ctx[c := c, A := A1, M := MV, b := B, brk := V1.brk, a := HB], hc, a1u, a1a, H1, arith(memo), taut(exg))
  have cs: mallocng.CTX_SIZE = 928 && mallocng.C_ACTIVE = 80 by defs(simp(), mallocng.CTX_SIZE, mallocng.C_ACTIVE)
  have ic: int_le(c.ctx, HB) && int_lt(HB, int_add(c.ctx, 928)) -> false proof
    assume r
    have ir: mallocng.in_range(HB, pair(c.ctx, mallocng.CTX_SIZE)) by defs(simp(r, cs), mallocng.in_range)
    show by taut(nc, ir)
  qed
  have cto: c.ctx in omega by simp(hc)
  have cs1 cs2 := cs
  have dj: int_le(int_add(pm, 8), HB) || int_lt(HB, pm) by arith(ic, hpe, cs2, hs, hsl, cto, memo)
  have {wh = head} := expand(la1, mallocng_specs.list_at)
  have _ bd _ _ := expand(wh, mallocng_specs.word_ok)
  have {ght = htop} := apply(mp.grp_acc[c := c, A := A1, vm := V1, b := B, objs := s.objs, g := L[1]], hc, a1u, a1a, vb, hin1, hsh, nr1, iu1)
  have ai := apply(mp.aidx_wr64[V := V1, p := pm, w := X1, v := A1.metas[L[1]]], vb, vb2, hpb, (int_le(int_add(pm, 8), 18446744073709551616) by simp(bd, hpb)),
    (HB in bits(64) by arith(ght, memo)), dj)
  // in the new state: the same group, the same masks
  have h1: A2.active[sc][0] = L[1] := trans(h02, e1)
  have {rg = geom, rm = masks} := apply(mp.relist_geom[A := A1, sc := sc, l2 := mp.rot(L), vm := V2], a1a)
  have {em = mem} := apply(mp.gm_geom[A := A1, A2 := A2, x := L[1]], rg, l1o)
  have _ mf := mp(all_elim(rm, {L[1]}), l1o)
  have ia: mallocng_specs.active_idx(V2, A2.metas[L[1]]) = mallocng_specs.active_idx(V2, A1.metas[L[1]]) by defs(simp(em), mallocng_specs.active_idx)
  have le2: int_le(i, mallocng_specs.active_idx(V2, A2.metas[L[1]])) by arith(ia, ai, eidx, ile, lle)
  have bf2: bit(A2.metas[L[1]].freed, i) := rewrite(sym(mf), hb)
  have ex2: ex i. i in omega && int_le(i, mallocng_specs.active_idx(V2, A2.metas[A2.active[sc][0]])) && bit(A2.metas[A2.active[sc][0]].freed, i)
    by ex_intro({i}, taut(io, subst({y. int_le(i, mallocng_specs.active_idx(V2, A2.metas[y]))}, sym(h1), le2), subst({y. bit(A2.metas[y].freed, i)}, sym(h1), bf2)))
  show by taut(J2, ex2, h02)
qed

// (a meta's masks and links cleared, in either order)
theorem mp.clear_perm(V): fn_update(fn_update(fn_update(fn_update(V, "avail", 0), "freed", 0), "prev", 0), "next", 0) =
  fn_update(fn_update(fn_update(fn_update(V, "prev", 0), "next", 0), "avail", 0), "freed", 0)
proof
  have s1 := mp(fn_update_swap[f := fn_update(V, "avail", 0), k := "freed", a := 0, j := "prev", b := 0], simp())
  have s2 := mp(fn_update_swap[f := V, k := "avail", a := 0, j := "prev", b := 0], simp())
  have s3 := mp(fn_update_swap[f := fn_update(fn_update(V, "prev", 0), "avail", 0), k := "freed", a := 0, j := "next", b := 0], simp())
  have s4 := mp(fn_update_swap[f := fn_update(V, "prev", 0), k := "avail", a := 0, j := "next", b := 0], simp())
  show by rsimp(s1, s2, s3, s4, only)
qed

// (a slot reserved from a state with the same slots)
theorem mp.res_slots(A, A1, A2, g, i): A1.slots = A.slots -> mallocng.reserves(A1, A2, g, i) -> mallocng.reserves(A, A2, g, i)
proof
  assume sl r
  show by defs(rewrite(sl, expand(r, mallocng.reserves)), mallocng.reserves)
qed

// (masks changed only: a reorganisation, the slots as before)
theorem mp.mo_reorg(A, A2, sc): A in mallocng.Abs -> mallocng_specs.masks_only(A, A2) -> mallocng.reorganised(A, A2, sc) && A2.slots = A.slots
proof
  assume ha mo
  have {eo = others, eg = groups} := expand(mo, mallocng_specs.masks_only)
  have ea := apply(mp.mo_field[A := A, A2 := A2, k := "active"], mo, simp())
  have es := apply(mp.mo_field[A := A, A2 := A2, k := "slots"], mo, simp())
  have af: ((is_fun(A) && "slots" in dom(A)) && "active" in dom(A)) && "metas" in dom(A) by simp(ha)
  have s2 := mp(fn_update_same[f := A, k := "active"], simp(ha), simp(ha))
  have s3 := mp(fn_update_same[f := A, k := "slots"], simp(ha), simp(ha))
  have e: fn_update(fn_update(fn_update(A2, "metas", A.metas), "active", A.active), "slots", A.slots) = A by simp(eo, s2, s3, af)
  have mq: all x. x in omega -> fn_update(fn_update(fn_update(fn_update(A2.metas[x], "prev", 0), "next", 0), "avail", 0), "freed", 0) =
      fn_update(fn_update(fn_update(fn_update(A.metas[x], "prev", 0), "next", 0), "avail", 0), "freed", 0) proof
    fix x
    assume hx
    have g := mp(all_elim(eg, {x}), hx)
    have g2 := subst({y. fn_update(fn_update(y, "prev", 0), "next", 0) =
        fn_update(fn_update(fn_update(fn_update(A.metas[x], "avail", 0), "freed", 0), "prev", 0), "next", 0)}, sym(g),
      refl({fn_update(fn_update(fn_update(fn_update(A.metas[x], "avail", 0), "freed", 0), "prev", 0), "next", 0)}))
    show := trans(sym(mp.clear_perm[V := A2.metas[x]]), trans(g2, mp.clear_perm[V := A.metas[x]]))
  qed
  have q1: all x. x in omega -> mallocng.on_list(A2.active[sc], x) -> mallocng.on_list(A.active[sc], x) proof
    fix x
    assume _ h
    show := rewrite(ea, h)
  qed
  have q2: all x. x in omega -> mallocng.on_list(A.active[sc], x) && !mallocng.on_list(A2.active[sc], x) -> !mallocng.has_unused(A, x) proof
    fix x
    assume _ h
    have h1 h2 := h
    show by taut(h1, rewrite(ea, h2))
  qed
  have r: mallocng.reorganised(A, A2, sc) by defs(simp(e, mq, ea, q1, q2), mallocng.reorganised)
  show by taut(r, es)
qed

// (the context's free bytes changed only: nothing outside the allocator
// touched)
theorem mp.co_unt(c, A, vm, vm2, b): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_m(c, A, vm, b) ->
  mallocng_specs.ctx_only(c, vm, vm2) -> mallocng.kept_outside(c, A, b, vm, vm2, empty)
proof
  assume hc hu ha hin co
  have er eb := expand(co, mallocng_specs.ctx_only)
  let VB := fn_update(vm2, "bytes", vm.bytes)
  have ep0: VB.pages = vm2.pages by simp()
  have es0: VB.brk_start = vm2.brk_start by simp()
  have ep: vm2.pages = vm.pages := trans(sym(ep0), subst({y. VB.pages = y.pages}, er, refl({VB.pages})))
  have es: vm2.brk_start = vm.brk_start := trans(sym(es0), subst({y. VB.brk_start = y.brk_start}, er, refl({VB.brk_start})))
  have cto: c.ctx in omega by simp(hc)
  have ut: all x0. x0 in omega -> (!(x0 in mallocng.footprint(c, A, b)) && !(x0 in empty)) && x86_64_linux.mapped(vm, int_div(x0, x86_64_linux.PAGE)) ->
      vm2.bytes[bits_of_int(64, x0)] = vm.bytes[bits_of_int(64, x0)] &&
      vm2.pages[int_div(x0, x86_64_linux.PAGE)] = vm.pages[int_div(x0, x86_64_linux.PAGE)] proof
    fix a
    assume hao hx
    have nf _ hmp := hx
    have lt _ := expand(hmp, x86_64_linux.mapped)
    have ts: int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE) = 34359738367 by defs(simp(), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
    have pg: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
    have al: int_lt(a, 18446744073709551616) by arith(lt, ts, pg, hao)
    have e: bits_of_int(64, a) = a by defs(arith(hao, al), bits_of_int, pow2)
    // (a free byte of the context: in the footprint)
    have nfree: !mallocng.ctx_free(c, a) proof
      assume hf
      have cs: mallocng.CTX_SIZE = 928 by defs(simp(), mallocng.CTX_SIZE)
      have ko: mallocng.C_MMAP_CNT = 12 && mallocng.C_META_SHIFT = 48 && mallocng.C_USAGE = 464 && mallocng.C_BRK = 920
        by defs(simp(), mallocng.C_MMAP_CNT, mallocng.C_META_SHIFT, mallocng.C_USAGE, mallocng.C_BRK)
      have k1 k2 k3 k4 := ko
      have rg: int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE)) by arith(expand(hf, mallocng.ctx_free), k1, k2, k3, k4, cs, cto, hao)
      have r1 r2 := rg
      show by taut(nf, apply(mp.ctx_fp[c := c, A := A, vm := vm, b := b, a := a], hc, hu, ha, hin, hao, r1, r2))
    qed
    have ab: a in bits(64) by arith(hao, al)
    have bb := rewrite(sym(e), mp(all_elim(eb, {a}), ab, nfree))
    have pp: vm2.pages[int_div(a, x86_64_linux.PAGE)] = vm.pages[int_div(a, x86_64_linux.PAGE)] by simp(ep)
    show by taut(bb, pp)
  qed
  show by defs(taut(ut, es), mallocng.kept_outside)
qed

// (a header byte with its active index -- the low 5 bits -- replaced by n,
// as the code's bitfield store writes it)
theorem mp.hdr_new(O, n): O in omega -> int_lt(O, 256) -> n in omega -> int_lt(n, 32) ->
  int_add(bits_and(128, gimple.b128(O), bits_not(128, gimple.b128(int_mul(int_pow(2, 0), int_sub(int_pow(2, 5), 1))))), int_mul(int_mod(n, int_pow(2, 5)), int_pow(2, 0))) =
    int_add(int_mul(int_div(O, 32), 32), n)
proof
  assume ho hl hn hnl
  have p: int_mul(int_pow(2, 0), int_sub(int_pow(2, 5), 1)) = 31 by simp()
  have bo: gimple.b128(O) = O by defs(arith(ho, hl, (int_lt(256, int_pow(2, 128)) by simp())), gimple.b128, bits_of_int, pow2)
  have b31: gimple.b128(31) = 31 by defs(simp(), gimple.b128, bits_of_int, pow2)
  have ob: O in bits(8) by arith(ho, hl)
  have nw := apply(bits_and_narrow[m := 8, n := 128, x := O, y := bits_not(128, 31)], simp(), simp(), simp(), ob)
  have h8: bits_and(8, O, bits_not(128, 31)) = int_mul(int_div(O, 32), 32) by bitwise({8}, ob)
  have h: bits_and(128, O, bits_not(128, 31)) = int_mul(int_div(O, 32), 32) := trans(nw, h8)
  have m: int_mul(int_mod(n, int_pow(2, 5)), int_pow(2, 0)) = n by arith(hn, hnl, (int_pow(2, 5) = 32 by simp()), (int_pow(2, 0) = 1 by simp()))
  show by rsimp(p, b31, bo, h, m, only)
qed

// (from where the ways meet, the head's active index raised -- its header
// byte written, the index above the old one, at most the last slot: the
// state at the activation, the slot above the old index freed)
theorem mp.act_raise(c, A, sc, B, s, pm, V2, A2, NB): c in mallocng.Cfg -> int_mod(c.ctx, 8) = 0 -> sc in omega -> int_lt(sc, 48) -> pm in bits(64) ->
  pm = int_add(int_add(c.ctx, mallocng.C_ACTIVE), int_mul(8, sc)) -> B in fn_space(bits(64), option(omega)) -> s.fs_base in bits(64) -> A in mallocng.Abs -> mallocng.shown_in(c, A, s.objs) -> 
  mp.ta_jst(c, A, sc, B, s, pm, V2, A2) -> NB in omega -> int_lt(NB, 256) ->
  int_lt(mallocng_specs.active_idx(V2, A2.metas[A2.active[sc][0]]), int_mod(NB, 32)) -> int_le(int_mod(NB, 32), A2.metas[A2.active[sc][0]].last_idx) ->
  mp.ta_act(c, A, sc, B, s, pm, mallocng_specs.wr8(V2, int_add(A2.metas[A2.active[sc][0]].mem, 8), NB), A2)
proof
  assume hc cal hs hsl hpb hpe hbt hfb hAa hsh0 J nbo nbl rise le
  have v2v a2a a2u hin2 nr2 th2 tl2 la2 ln2 av2 fr2 ro2 un2 sl2 fp2 := J
  have hsh := apply(mp.shown_reorg[c := c, A := A, A2 := A2, sc := sc, objs := s.objs], hAa, ro2, hsh0)
  let M2 := A2.active[sc][0]
  let HB := int_add(A2.metas[M2].mem, 8)
  let V3 := mallocng_specs.wr8(V2, HB, NB)
  let HP := mallocng.held(c, A2, B)
  let FP := mallocng.footprint(c, A2, B)
  let I := mallocng_specs.active_idx(V2, A2.metas[M2])
  have vb2: V2.bytes in fn_space(bits(64), bits(8)) by simp(v2v)
  have vb3 := apply(mp.wr8_typed[V := V2, c := HB, v := NB], vb2)
  have v3v: V3 in x86_64_linux.Vm by defs(mp(all_elim(ms.wr_any, {V2}, {HB}, {1}, {NB}), v2v), mallocng_specs.wr8)
  have {H2 = inv} := expand(hin2, mallocng.holds_m)
  have {hac2 = active, huo2 = used} := expand(H2, mallocng.holds)
  have iu2 _ _ := mp(all_elim(expand(hac2, mallocng.active_ok), {sc}, {0}), conj(hs, (0 in omega by simp())), conj(hsl, ln2))
  have {m2o = nat, m2t = top, ght = htop, ghh = hheld} := apply(mp.grp_acc[c := c, A := A2, vm := V2, b := B, objs := s.objs, g := M2], hc, a2u, a2a, vb2, hin2, hsh, nr2, iu2)
  have vt: A2.metas[M2] in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A2.metas, x := M2], simp(a2a), m2o)
  have go: A2.metas[M2].mem in omega by simp(vt)
  have lso: A2.metas[M2].last_idx in omega by simp(vt)
  have hbb: HB in bits(64) by arith(ght, go)
  have hbo: HB in omega by arith(go)
  have ehb: bits_of_int(64, HB) = HB by defs(arith(hbb), bits_of_int, pow2)
  // the byte written: NB; the others as before
  have at3 := apply(mp.wr8_at[V := V2, c := HB, v := NB], hbb, nbo)
  have nbm: int_mod(NB, 256) = NB by arith(nbo, nbl)
  have eb: all x. x in bits(64) -> !(x = HB) -> V3.bytes[x] = V2.bytes[x] proof
    fix x
    assume hx hn
    show := apply(mp.wr8_out[V := V2, c := HB, v := NB, x := x], hx, hbb, arith(hx, hn, hbb))
  qed
  have ep: V3.pages = V2.pages by defs(simp(), mallocng_specs.wr8)
  have ek: V3.brk = V2.brk by defs(simp(), mallocng_specs.wr8)
  have es: V3.brk_start = V2.brk_start by defs(simp(), mallocng_specs.wr8)
  have et: V3.stack_top = V2.stack_top by defs(simp(), mallocng_specs.wr8)
  have el: V3.stack_limit = V2.stack_limit by defs(simp(), mallocng_specs.wr8)
  // the index through the view: before, the active index; after, NB's low bits
  have {i2 = idx} := apply(mp.ag_pre[c := c, A := A2, vm := V2, b := B, objs := s.objs, fs := s.fs_base, g := M2],
    hc, a2u, a2a, hbt, vb2, (M2 in bits(64) by arith(m2o, m2t)), hin2, hsh, nr2, th2, iu2, av2)
  have r3 _ := apply(mp.b8_view[vm := V3, fp := HP, a := HB], vb3, hbo, ghh)
  have r3e: mallocng.b8(mallocng.mview(V3, HP), HB) = NB := trans(rewrite(ehb, r3), trans(at3, nbm))
  have rise2: int_le(int_mod(mallocng.b8(mallocng.mview(V2, HP), HB), 32), int_mod(mallocng.b8(mallocng.mview(V3, HP), HB), 32)) by arith(i2, rise, r3e)
  have le2: int_le(int_mod(mallocng.b8(mallocng.mview(V3, HP), HB), 32), A2.metas[M2].last_idx) by arith(r3e, le)
  have hin3 := apply(mp.holds_in_hdr[c := c, A := A2, vm := V2, vm2 := V3, b := B, g := M2], hc, a2u, a2a, hbt, hin2, iu2, eb, ep, ek, et, el, rise2, le2)
  // outside the allocator: untouched (the header byte the allocator's)
  have {hbf = fp} := apply(mp.held_fp, ghh)
  have ut: all x0. x0 in omega -> (!(x0 in FP) && !(x0 in empty)) && x86_64_linux.mapped(V2, int_div(x0, x86_64_linux.PAGE)) ->
      V3.bytes[bits_of_int(64, x0)] = V2.bytes[bits_of_int(64, x0)] &&
      V3.pages[int_div(x0, x86_64_linux.PAGE)] = V2.pages[int_div(x0, x86_64_linux.PAGE)] proof
    fix a
    assume hao hx
    have nf _ hmp := hx
    have lt _ := expand(hmp, x86_64_linux.mapped)
    have ts: int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE) = 34359738367 by defs(simp(), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
    have pg: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
    have al: int_lt(a, 18446744073709551616) by arith(lt, ts, pg, hao)
    have e: bits_of_int(64, a) = a by defs(arith(hao, al), bits_of_int, pow2)
    have out: !(a = HB) proof
      assume ea
      show by taut(rewrite(sym(ea), hbf), nf)
    qed
    have bb := rewrite(sym(e), mp(all_elim(eb, {a}), (a in bits(64) by arith(hao, al)), out))
    have pp: V3.pages[int_div(a, x86_64_linux.PAGE)] = V2.pages[int_div(a, x86_64_linux.PAGE)] by simp(ep)
    show by taut(bb, pp)
  qed
  have unt23: mallocng.kept_outside(c, A2, B, V2, V3, empty) by defs(taut(ut, es), mallocng.kept_outside)
  have th3 := apply(mp.tls_kept[c := c, A := A2, b := B, V0 := V2, V1 := V3, fs := s.fs_base, e := empty], hfb, th2, tl2, unt23,
    (all i. i in omega -> int_lt(i, 8) -> !(int_add(s.fs_base, i) in empty) by simp()))
  have la3 := rewrite(sym(hpe), apply(mp.active_at[c := c, A := A2, vm := V3, b := B, objs := s.objs, sc := sc], hc, a2u, a2a, vb3, hin3, hsh, cal, hs, hsl))
  have un3 := apply(mp.unt_trans[c := c, A := A, A1 := A2, b := B, V0 := s.vm, V1 := V2, V2 := V3, e := empty], un2, unt23, fp2)
  // a freed slot among the active ones: the one above the old index
  have {gm = masks} := expand(apply(mp.used_group, huo2, iu2), mallocng.group_ok)
  have {f2b = fb} := apply(mp.freed_some[c := c, A := A2, vm := V2, b := B, g := M2], hc, a2u, a2a, vb2, hin2, nr2, iu2, av2, fr2)
  let F := A2.metas[M2].freed
  have io: int_add(I, 1) in omega by arith(i2)
  have _ _ _ m4 := mp(all_elim(expand(gm, mallocng.masks_ok), {int_add(I, 1)}), io, arith(rise, le, nbo))
  have fb1 := mp(m4, conj((int_lt(int_mod(mallocng.b8(mallocng.mview(V2, HP), HB), 32), int_add(I, 1)) by arith(i2)),
    (int_le(int_add(I, 1), A2.metas[M2].last_idx) by arith(rise, le, i2, lso))))
  have nb := apply(mp.nbit[x := F, i := int_add(I, 1)], arith(f2b), io)
  have bt: bit(F, int_add(I, 1)) proof
    have c0: !bit(F, int_add(I, 1)) -> false proof
      assume n0
      have z: mallocng.bit(F, int_add(I, 1)) = 0 by simp(nb, n0)
      show by arith(z, fb1)
    qed
    show by taut(c0)
  qed
  // the new index
  have e1 _ := apply(mp.b8_view[vm := V3, fp := mallocng.all_bytes, a := HB], vb3, hbo, (HB in mallocng.all_bytes by defs(simp(hbo), mallocng.all_bytes)))
  have ai3: mallocng_specs.active_idx(V3, A2.metas[M2]) = int_mod(NB, 32) by defs(simp(e1, ehb, at3, nbm), mallocng_specs.active_idx)
  have ex: ex i. i in omega && int_le(i, mallocng_specs.active_idx(V3, A2.metas[M2])) && bit(A2.metas[M2].freed, i)
    by ex_intro({int_add(I, 1)}, taut(io, (int_le(int_add(I, 1), mallocng_specs.active_idx(V3, A2.metas[M2])) by arith(ai3, rise, i2)), bt))
  show by taut(v3v, a2a, a2u, hin3, nr2, th3, tl2, la3, ln2, av2, fr2, ro2, un3, sl2, fp2, ex)
qed

theorem mp.ta_run(c, sc, pm, gq, gag, ga, gdb, s, h, o): c in mallocng.Cfg -> c.ctx = c_src_malloc_mallocng_malloc.__malloc_context ->
  c.sct = c_src_malloc_mallocng_malloc.__malloc_size_classes -> sc in omega -> int_lt(sc, 48) -> pm in bits(64) -> pm = int_add(int_add(c.ctx, mallocng.C_ACTIVE), int_mul(8, sc)) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(gq[regs], s, o) -> runs(mallocng_specs.dequeue_spec_fun()[regs], s, o)) ->
  mp.ag_call(c, gag) -> mp.db_call(c, gdb) ->
  s in abi.World -> h in mp.G ->
  mallocng.holds_m(c, h.A, s.vm, h.blocks) -> mallocng.shown_in(c, h.A, s.objs) -> mallocng.no_reserved(h.A) -> abi.thread_ok(s.vm, s.fs_base) -> mallocng_specs.tls_apart(c, h.A, h.blocks, s.fs_base) ->
  runs(c_src_malloc_mallocng_malloc.try_avail(pm, gq, gag, ga, gdb), s, o) ->
  mp.ta_out(c, h.A, sc, h.blocks, s, o)
proof
  assume hc hx hst hs hsl hpb hpe hgq hag hdb hw hh hin hsh hnr hth htl hr
  let A := h.A
  have _ _ _ hAa := mp(all_elim(mp.g_rec, {h}), hh)
  have hsh0 := hsh
  let B := h.blocks
  let V0 := s.vm
  have pu := apply(g.runs_univ, hr)
  have hu: s in univ(1) by simp(pu)
  have hgu _ hbt hat := mp(all_elim(mp.g_rec, {h}), hh)
  have au := mp(app_univ[u := 1, f := h, k := "A"], hgu)
  have vV vfun vdom vb := apply(ms.world_parts, hw)
  have p64: pow2(64) = 18446744073709551616 by simp()
  // the list at pm: class sc's active list
  have cal: int_mod(c.ctx, 8) = 0 by defs(simp(hx), c_src_malloc_mallocng_malloc.__malloc_context)
  have la0 := apply(mp.active_at[c := c, A := A, vm := V0, b := B, objs := s.objs, sc := sc], hc, au, hat, vb, hin, hsh, cal, hs, hsl)
  have la := rewrite(sym(hpe), la0)
  have {wh = head} := expand(la, mallocng_specs.list_at)
  have nn bd rd wr := expand(wh, mallocng_specs.word_ok)
  have md0: g.mem_defined(s, pm, 0, 8, false) by simp(nn, rd, bd, hpb, p64)
  let L := A.active[sc]
  have {H0 = inv} := expand(hin, mallocng.holds_m)
  have {cok = ctx} := expand(H0, mallocng.holds)
  have {c11 = nactive} := expand(cok, mallocng.ctx_ok)
  have al0: A.active in list_type(list_type(omega)) by simp(hat)
  have ll := mp(at_type[l := A.active, t := list_type(omega), i := sc], al0, hs, (int_lt(sc, seq_len(A.active)) by arith(c11, hsl)))
  have hv _ := apply(mp.head_is[vm := V0, objs := s.objs, phead := pm, l := L], vb, hpb, ll, la)
  have ap0: int_add(pm, 0) = pm by arith(hpb)
  have hd: bits_of_int(64, gimple.bytes_at(V0, int_add(pm, 0), 8)) = ite(seq_len(L) = 0, 0, L[0]) := rewrite(sym(ap0), expand(hv, mallocng_specs.rd64))
  // the list empty: 0, nothing changed
  have emp: seq_len(L) = 0 -> mp.ta_out(c, A, sc, B, s, o) proof
    assume e0
    have h0: bits_of_int(64, gimple.bytes_at(V0, int_add(pm, 0), 8)) = 0 by simp(hd, e0)
    step a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 x24, oe from hr with g.ld64_det, h0 using conj(hu, hpb, md0)
    have ss: fn_update(s, "vm", V0) = s := mp(fn_update_same[f := s, k := "vm"], vfun, vdom)
    have o2: o = ok(fn_update(s, "vm", V0), 0) := subst({y. o = ok(y, 0)}, sym(ss), oe)
    have nl: all g. g in omega -> mallocng.on_list(L, g) -> !mallocng.has_unused(A, g) proof
      fix g
      assume _ ol
      obtain k, hk hkl _ from expand(ol, mallocng.on_list)
      have f: false by arith(hkl, e0, hk)
      show by taut(f)
    qed
    show by disj({2}, ex_intro({A}, {V0}, {0}, taut(hat, au, mp(mp.reorg_refl[A := A, sc := sc], hat), (0 in bits(32) by simp()), refl({0}), e0, nl, refl({A.slots}), vV, hin,
      mp.unt_refl[c := c, A := A, b := B, vm := V0, e := empty], o2)))
  qed
  // the list not empty: its head M
  have ne: !(seq_len(L) = 0) -> mp.ta_out(c, A, sc, B, s, o) proof
    assume hne
    let M := L[0]
    have lo: seq_len(L) in omega by simp(ll)
    have k0l: int_lt(0, seq_len(L)) by arith(hne, lo)
    have {hac = active} := expand(H0, mallocng.holds)
    have iu _ _ := mp(all_elim(expand(hac, mallocng.active_ok), {sc}, {0}), conj(hs, (0 in omega by simp())), conj(hsl, k0l))
    have ie: ite(seq_len(L) = 0, 0, L[0]) = M by simp(hne)
    have hm0 := trans(hd, ie)
    have {mo = nat, mtop = top, mnz = nz, mmeta = meta, mav = avail, mfr = freed} := apply(mp.grp_acc[c := c, A := A, vm := V0, b := B, objs := s.objs, g := M],
      hc, au, hat, vb, hin, hsh, hnr, iu)
    have mb: M in bits(64) by arith(mo, mtop)
    have u24 _ := mp(all_elim(mmeta, {24}, {4}), simp(), simp(), simp())
    have md24: g.mem_defined(s, M, 24, 4, false) by simp(mnz, u24, mtop, mo, p64)
    have md24x := rewrite(sym(hm0), md24)
    step a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 x24 x29, c20 from hr with g.ld64_det, hm0, g.ld32_det using conj(hu, hpb, md0, mb, md24x)
    have c2 := rewrite(hm0, c20)
    // M on no list but as this one's head
    have hnh: all x0. all x1. x0 in omega && x1 in omega -> int_lt(x0, 48) && int_lt(x1, seq_len(A.active[x0])) -> int_lt(0, x1) -> A.active[x0][x1] = M -> false proof
      fix x0 x1
      assume hn hl hk he
      have hn0 hn1 := hn
      have hl0 hl1 := hl
      have _ k1 := apply(mp.list_once[c := c, A := A, M := mallocng.mview(V0, mallocng.held(c, A, B)), b := B, brk := V0.brk, s1 := x0, k1 := x1, s2 := sc, k2 := 0],
        H0, hn0, hn1, hs, (0 in omega by simp()), hl0, hsl, hl1, k0l, he)
      show by arith(k1, hk)
    qed
    let X := bits_of_int(32, gimple.bytes_at(V0, int_add(M, 24), 4))
    have bo bl := mp(all_elim(g.bytes_bound, {V0}, {int_add(M, 24)}, {4}), vb, simp())
    have xe: X = A.metas[M].avail := trans((X = gimple.bytes_at(V0, int_add(M, 24), 4) by defs(arith(bo, bl), bits_of_int, pow2)), mav)
    // a slot available: the lowest taken
    have take: !(A.metas[M].avail = 0) -> mp.ta_out(c, A, sc, B, s, o) proof
      assume hav
      obtain i, io il e1 e2 ra ru rs ro v2v rh unt from apply(mp.take_slot[c := c, A := A, V := V0, b := B, sc := sc, m := M], hc, au, hat, vV, hbt, hin, hnr, iu, hnh, hav)
      have xnz: !(X = 0) := rewrite(sym(xe), hav)
      have u24w := mp(all_elim(mmeta, {24}, {4}), simp(), simp(), simp())
      have md24w: g.mem_defined(s, M, 24, 4, true) by simp(mnz, u24w, mtop, mo, p64)
      step oe from c2 with xnz, ms.st32_det using conj(hw, hu, mb, md24w)
      let R := mp.res_abs(A, M, i)
      let NV := int_sub(A.metas[M].avail, pow2(i))
      let V2 := mallocng_specs.wr32(V0, int_add(M, 24), NV)
      have wv := all_elim(ms.v_wr32, {V0}, {int_add(M, 24)}, {NV})
      have o3: o = ok(fn_update(s, "vm", V2), int_pow(2, i)) := rewrite(sym(wv), rewrite(e2, rewrite(e1, oe)))
      have pw: pow2(i) = int_pow(2, i) by defs(simp(), pow2)
      have pl := mp(pow2_le[a := i, b := 31], io, simp(), arith(il, io))
      have p31: pow2(31) = 2147483648 by simp()
      have rb: int_pow(2, i) in bits(32) by arith(pl, pw, p31, mp(pow2_pos[k := i], io))
      have rac: R.active = A.active by simp()
      have olt: ord_lt(0, seq_len(R.active[sc])) by defs(simp(rac, k0l, lo), ord_lt)
      have rh0: R.active[sc][0] = M by simp(rac)
      have rc: ex x3. (x3 in omega && ((int_lt(x3, 32) && int_pow(2, i) = int_pow(2, x3)) && ord_lt(0, seq_len(R.active[sc])))) &&
          mallocng.reserves(A, R, R.active[sc][0], x3)
        by ex_intro({i}, taut(io, il, refl({int_pow(2, i)}), olt, subst({y. mallocng.reserves(A, R, y, i)}, sym(rh0), rs)))
      show by disj({2}, ex_intro({R}, {V2}, {int_pow(2, i)}, taut(ra, ru, ro, rb, rc, v2v, rh, unt, o3)))
    qed
    // none available: M's freed mask read; dequeued if none freed, else
    // rotated past
    have none: A.metas[M].avail = 0 -> mp.ta_out(c, A, sc, B, s, o) proof
      assume hav
      have x0: X = 0 := trans(xe, hav)
      have mz: !(M = 0) := mnz
      have u28 _ := mp(all_elim(mmeta, {28}, {4}), simp(), simp(), simp())
      have md28: g.mem_defined(s, M, 28, 4, false) by simp(mnz, u28, mtop, mo, p64)
      step x30 x31, c3 from c2 with x0, mz, g.ld32_det using conj(hu, mb, md28)
      have tb kx := c3
      let Y := bits_of_int(32, gimple.bytes_at(V0, int_add(M, 28), 4))
      have bfo bfl := mp(all_elim(g.bytes_bound, {V0}, {int_add(M, 28)}, {4}), vb, simp())
      have ye: Y = A.metas[M].freed := trans((Y = gimple.bytes_at(V0, int_add(M, 28), 4) by defs(arith(bfo, bfl), bits_of_int, pow2)), mfr)
      // some freed: the list rotated past M
      have rot: !(A.metas[M].freed = 0) -> ex V1 A1. mp.ta_jst(c, A, sc, B, s, pm, V1, A1) &&
          x31 = ok(pair(fn_update(s, "vm", V1), pair(a1, pair(a2, pair(A1.active[sc][0], pair(X, pair(a5, pair(a6, pair(a7, pair(a8, pair(a9, pair(a10, a11))))))))))), empty) proof
        assume hfr
        have y0: !(Y = 0) := rewrite(sym(ye), hfr)
        have u8 _ := mp(all_elim(mmeta, {8}, {8}), simp(), simp(), simp())
        have md8: g.mem_defined(s, M, 8, 8, false) by simp(mnz, u8, mtop, mo, p64)
        have _ _ _ wrh := expand(wh, mallocng_specs.word_ok)
        have md0w: g.mem_defined(s, pm, 0, 8, true) by simp(nn, wrh, bd, hpb, p64)
        step e0 from tb with y0
        step e from e0 with g.ld64_det, g.st64_det using conj(hu, mb, md8, hpb, md0w, vV, vfun, vdom)
        // the state: the list rotated (`rot_step`)
        let n := seq_len(L)
        let X1 := L[int_mod(1, n)]
        let V1 := mallocng_specs.wr64(V0, pm, X1)
        let A1 := mp.relist(A, sc, mp.rot(L), V1)
        have st := apply(mp.rot_step[c := c, A := A, vm := V0, b := B, sc := sc], hc, au, hat, hbt, vV, hin, hsh, cal, hs, hsl, k0l, hav, hfr)
        have {sa = abs, su = univ, sh = holds, sr = reorg, sn = unt, ss = slots, sl = list, sv = vm} := rewrite(sym(hpe), st)
        // (M's next: the list's second element)
        have {lk = links} := apply(mp.list_rd[vm := V0, objs := s.objs, phead := pm, l := L, i := 0], vb, hpb, ll, la)
        have nx _ := mp(lk, simp(), k0l)
        have {lel = elems} := expand(la, mallocng_specs.list_at)
        have x1b _ _ _ _ := mp(all_elim(lel, {int_mod(1, n)}), arith(k0l, lo), arith(k0l, lo))
        have x1o := apply(at_type[l := L, t := omega, i := int_mod(1, n)], ll, arith(k0l, lo), arith(k0l, lo))
        have ex1: bits_of_int(64, gimple.bytes_at(V0, int_add(M, 8), 8)) = X1 by defs(simp(nx, x1o, x1b), bits_of_int, pow2)
        have ev: fn_update(V0, "bytes", x86_64_linux.store_le(V0.bytes, int_add(pm, 0), 8, X1)) = V1 :=
          subst({y. fn_update(V0, "bytes", x86_64_linux.store_le(V0.bytes, y, 8, X1)) = V1}, sym(ap0), sym(all_elim(ms.v_wr64, {V0}, {pm}, {X1})))
        have {r0 = elem} := apply(mp.rot_app[l := L, j := 0], ll, k0l)
        have h0: A1.active[sc][0] = X1 by simp(sl, mp(r0, simp(), k0l))
        have e2 := rewrite(ev, rewrite(ex1, e))
        // the new head: none available, some freed (M itself if alone)
        have {rg = geom, rm = masks} := apply(mp.relist_geom[A := A, sc := sc, l2 := mp.rot(L), vm := V1], hat)
        have avf: A.metas[X1].avail = 0 && !(A.metas[X1].freed = 0) proof
          have one: int_mod(1, n) = 0 -> A.metas[X1].avail = 0 && !(A.metas[X1].freed = 0) proof
            assume z
            have e0x: X1 = M := subst({y. L[int_mod(1, n)] = L[y]}, z, refl({X1}))
            show := rewrite(sym(e0x), conj(hav, hfr))
          qed
          have more: !(int_mod(1, n) = 0) -> A.metas[X1].avail = 0 && !(A.metas[X1].freed = 0) proof
            assume nz
            have m1o: int_mod(1, n) in omega by arith(k0l, lo)
            have m1l: int_lt(int_mod(1, n), seq_len(L)) by arith(k0l, lo)
            have _ _ t3 := mp(all_elim(expand(hac, mallocng.active_ok), {sc}, {int_mod(1, n)}), conj(hs, m1o), conj(hsl, m1l))
            show := mp(t3, arith(nz, k0l, lo))
          qed
          show by taut(one, more)
        qed
        have ma1 mf1 := mp(all_elim(rm, {X1}), x1o)
        have av1: A1.metas[A1.active[sc][0]].avail = 0 := subst({y. A1.metas[y].avail = 0}, sym(h0), trans(ma1, avf.1))
        have fr1: !(A1.metas[A1.active[sc][0]].freed = 0) := subst({y. !(A1.metas[y].freed = 0)}, sym(h0), rewrite(sym(mf1), avf.2))
        // the rest: the slots, the footprint as before; the thread word apart
        have nr1: mallocng.no_reserved(A1) by defs(rewrite(sym(ss), expand(hnr, mallocng.no_reserved)), mallocng.no_reserved)
        have fpe := apply(mp.gm_fp[c := c, A := A, A2 := A1, b := B], hat, rg)
        have tl1: mallocng_specs.tls_apart(c, A1, B, s.fs_base) by defs(rewrite(sym(fpe), expand(htl, mallocng_specs.tls_apart)), mallocng_specs.tls_apart)
        have th1 := apply(mp.tls_kept[c := c, A := A, b := B, V0 := V0, V1 := V1, fs := s.fs_base, e := empty], simp(vV, hw), hth, htl, sn,
          (all i. i in omega -> int_lt(i, 8) -> !(int_add(s.fs_base, i) in empty) by simp()))
        have la1 := apply(mp.rot_list[vm := V0, objs := s.objs, phead := pm, l := L], vV, vb, hpb, ll, la, k0l)
        have la2 := rewrite(sym(sl), la1)
        have ln1: int_lt(0, seq_len(A1.active[sc])) by simp(sl, k0l, apply(mp.rot_app[l := L, j := 0], ll, k0l).1)
        have J: mp.ta_jst(c, A, sc, B, s, pm, V1, A1) by taut(sv, sa, su, sh, nr1, th1, tl1, la2, ln1, av1, fr1, sr, sn, ss, fpe)
        have e3 := subst({y. x31 = ok(pair(fn_update(s, "vm", V1), pair(a1, pair(a2, pair(y, pair(X, pair(a5, pair(a6, pair(a7, pair(a8, pair(a9, pair(a10, a11))))))))))), empty)},
          sym(h0), e2)
        show by ex_intro({V1}, {A1}, taut(J, e3))
      qed
      // none freed: M dequeued
      have deq: A.metas[M].freed = 0 ->
          (ex v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && x31 = exc(pair(fn_update(fn_update(s, "vm", v), "objs", ob), pair(a1, pair(a2, pair(M, pair(X, pair(a5, pair(a6, pair(a7, pair(a8, pair(a9, pair(a10, a11))))))))))),
            pair("raise", exc_val("stack_overflow", empty)))) ||
          mp.ta_out(c, A, sc, B, s, o) || (ex V1 A1. mp.ta_jst(c, A, sc, B, s, pm, V1, A1) &&
          x31 = ok(pair(fn_update(s, "vm", V1), pair(a1, pair(a2, pair(A1.active[sc][0], pair(X, pair(a5, pair(a6, pair(a7, pair(a8, pair(a9, pair(a10, a11))))))))))), empty)) proof
        assume hfz
        have yz: Y = 0 := trans(ye, hfz)
        step e0 from tb with yz
        have ths: gc.sound(s) by simp(hth)
        step V r, e3 hR from e0 with mp.dq_q using hw, hu, ths, hpb, mb, ll, (0 in omega by simp()), k0l, refl({M}), la, hgq
        have vVV hdq := hR
        // the state: M dequeued (`dq_step`)
        let RM := mallocng_specs.rm_at(L, 0)
        let A1 := mp.relist(A, sc, RM, V)
        have dqs := apply(mp.dq_step[c := c, A := A, vm := V0, V := V, b := B, objs := s.objs, sc := sc], hc, au, hat, hbt, vV, vVV, hin, hsh, cal, hs, hsl, k0l, hav, hfz,
          rewrite(hpe, hdq))
        have {da = abs, du = univ, dh = holds, dr = reorg, dn = unt, ds = slots, dl = list, dat0 = at} := dqs
        have dat := rewrite(sym(hpe), dat0)
        have {rml = len, rmt = type} := apply(mp.rm_at_app[l := L, k := 0, j := 0], ll, simp(), k0l)
        have vbV: V.bytes in fn_space(bits(64), bits(8)) by simp(vVV)
        have hv1 _ := apply(mp.head_is[vm := V, objs := s.objs, phead := pm, l := RM], vbV, hpb, rmt, dat)
        have hd1: bits_of_int(64, gimple.bytes_at(V, int_add(pm, 0), 8)) = ite(seq_len(RM) = 0, 0, RM[0]) := rewrite(sym(ap0), expand(hv1, mallocng_specs.rd64))
        have {wh1 = head} := expand(dat, mallocng_specs.list_at)
        have nn1 bd1 rd1 _ := expand(wh1, mallocng_specs.word_ok)
        have md1: g.mem_defined(fn_update(s, "vm", V), pm, 0, 8, false) by simp(nn1, rd1, bd1, hpb, p64)
        have wU: fn_update(s, "vm", V) in univ(1) by simp(hu, apply(x86.vm_univ, vVV))
        step x5, e4 from e3 with g.ld64_det using conj(wU, hpb, md1)
        // M alone: the list now empty -- 0, M without a free slot
        have one: seq_len(L) = 1 -> mp.ta_out(c, A, sc, B, s, o) proof
          assume n1
          have r0: seq_len(RM) = 0 by arith(rml, n1)
          have hz: bits_of_int(64, gimple.bytes_at(V, int_add(pm, 0), 8)) = 0 by simp(hd1, r0)
          step e5 from e4 with hz
          step oe from rewrite(e5, kx)
          have l0: seq_len(A1.active[sc]) = 0 by simp(dl, r0)
          have {huo = used} := expand(H0, mallocng.holds)
          have nu := apply(mp.full_no_unused[A := A, M := mallocng.mview(V0, mallocng.held(c, A, B)), b := B, g := M], hat, mo, apply(mp.used_group, huo, iu), hav, hfz)
          have all1: all g. g in omega -> mallocng.on_list(L, g) -> !mallocng.has_unused(A, g) proof
            fix g
            assume _ ol
            obtain j, hj hjl hje from expand(ol, mallocng.on_list)
            have j0: j = 0 by arith(hj, hjl, n1)
            have gm: g = M := trans(sym(hje), subst({y. L[j] = L[y]}, j0, refl({L[j]})))
            show := rewrite(sym(gm), nu)
          qed
          show by disj({2}, ex_intro({A1}, {V}, {0}, taut(da, du, dr, (0 in bits(32) by simp()), refl({0}), l0, all1, ds, vVV, dh, dn, oe)))
        qed
        // more: the next group the head -- where the ways meet
        have more: !(seq_len(L) = 1) -> ex V1 A1. mp.ta_jst(c, A, sc, B, s, pm, V1, A1) &&
            x31 = ok(pair(fn_update(s, "vm", V1), pair(a1, pair(a2, pair(A1.active[sc][0], pair(X, pair(a5, pair(a6, pair(a7, pair(a8, pair(a9, pair(a10, a11))))))))))), empty) proof
          assume n1
          have r0: !(seq_len(RM) = 0) by arith(rml, n1, k0l)
          have {re0 = elem} := apply(mp.rm_at_app[l := L, k := 0, j := 0], ll, simp(), k0l)
          have e10: RM[0] = L[1] by simp(mp(re0, simp(), arith(rml, n1, k0l)))
          have lh: bits_of_int(64, gimple.bytes_at(V, int_add(pm, 0), 8)) = L[1] := trans(trans(hd1, mp(ite_f[c := seq_len(RM) = 0, a := 0, b := RM[0]], r0)), e10)
          have hnz: !(bits_of_int(64, gimple.bytes_at(V, int_add(pm, 0), 8)) = 0) proof
            assume z
            have iu1 _ _ := mp(all_elim(expand(hac, mallocng.active_ok), {sc}, {1}), conj(hs, (1 in omega by simp())), conj(hsl, (int_lt(1, seq_len(L)) by arith(n1, k0l))))
            have z2: L[1] = 0 := trans(sym(lh), z)
            have {hn0 = normal} := expand(H0, mallocng.holds)
            have _ _ _ n4 := expand(hn0, mallocng.normal)
            show by taut(rewrite(z2, iu1), n4)
          qed
          step e5 from e4 with hnz
          have h0: A1.active[sc][0] = L[1] := trans((A1.active[sc][0] = RM[0] by simp(dl)), e10)
          have e6 := subst({y. x31 = ok(pair(fn_update(s, "vm", V), pair(a1, pair(a2, pair(y, pair(X, pair(a5, pair(a6, pair(a7, pair(a8, pair(a9, pair(a10, a11))))))))))), empty)},
            trans(lh, sym(h0)), e5)
          // the new head: L's second, full
          have {rg = geom, rm = masks} := apply(mp.relist_geom[A := A, sc := sc, l2 := RM, vm := V], hat)
          have l1o := apply(at_type[l := L, t := omega, i := 1], ll, simp(), arith(n1, k0l))
          have _ _ t3 := mp(all_elim(expand(hac, mallocng.active_ok), {sc}, {1}), conj(hs, (1 in omega by simp())), conj(hsl, (int_lt(1, seq_len(L)) by arith(n1, k0l))))
          have af1 ff1 := mp(t3, (int_lt(0, 1) by simp()))
          have ma1 mf1 := mp(all_elim(rm, {L[1]}), l1o)
          have av1: A1.metas[A1.active[sc][0]].avail = 0 := subst({y. A1.metas[y].avail = 0}, sym(h0), trans(ma1, af1))
          have fr1: !(A1.metas[A1.active[sc][0]].freed = 0) := subst({y. !(A1.metas[y].freed = 0)}, sym(h0), rewrite(sym(mf1), ff1))
          have nr1: mallocng.no_reserved(A1) by defs(rewrite(sym(ds), expand(hnr, mallocng.no_reserved)), mallocng.no_reserved)
          have fpe := apply(mp.gm_fp[c := c, A := A, A2 := A1, b := B], hat, rg)
          have tl1: mallocng_specs.tls_apart(c, A1, B, s.fs_base) by defs(rewrite(sym(fpe), expand(htl, mallocng_specs.tls_apart)), mallocng_specs.tls_apart)
          have th1 := apply(mp.tls_kept[c := c, A := A, b := B, V0 := V0, V1 := V, fs := s.fs_base, e := empty], simp(vV, hw), hth, htl, dn,
            (all i. i in omega -> int_lt(i, 8) -> !(int_add(s.fs_base, i) in empty) by simp()))
          have la2 := rewrite(sym(dl), dat)
          have ln1: int_lt(0, seq_len(A1.active[sc])) by simp(dl, rml, n1, k0l, lo)
          have J: mp.ta_jst(c, A, sc, B, s, pm, V, A1) by taut(vVV, da, du, dh, nr1, th1, tl1, la2, ln1, av1, fr1, dr, dn, ds, fpe)
          show by ex_intro({V}, {A1}, taut(J, e6))
        qed
        show by taut(one, more)
      qed
      have jj := (
        (ex v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && x31 = exc(pair(fn_update(fn_update(s, "vm", v), "objs", ob), pair(a1, pair(a2, pair(M, pair(X, pair(a5, pair(a6, pair(a7, pair(a8, pair(a9, pair(a10, a11))))))))))),
          pair("raise", exc_val("stack_overflow", empty)))) ||
        mp.ta_out(c, A, sc, B, s, o) ||
        (ex V1 A1. mp.ta_jst(c, A, sc, B, s, pm, V1, A1) &&
          x31 = ok(pair(fn_update(s, "vm", V1), pair(a1, pair(a2, pair(A1.active[sc][0], pair(X, pair(a5, pair(a6, pair(a7, pair(a8, pair(a9, pair(a10, a11))))))))))), empty))
        by taut(rot, deq, (A.metas[M].freed = 0 || !(A.metas[M].freed = 0) by taut())))
      // the dequeue overflowing: try_avail's overflow
      have ov: (ex v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && x31 = exc(pair(fn_update(fn_update(s, "vm", v), "objs", ob), pair(a1, pair(a2, pair(M, pair(X, pair(a5, pair(a6, pair(a7, pair(a8, pair(a9, pair(a10, a11))))))))))),
          pair("raise", exc_val("stack_overflow", empty)))) -> mp.ta_out(c, A, sc, B, s, o) proof
        assume ex
        obtain v ob, hv hob hx from ex
        step oe from rewrite(hx, kx)
        show by disj({1}, ex_intro({v}, {ob}, taut(hv, hob, oe)))
      qed
      // where the ways meet: the rest of try_avail
      have tail: (ex V1 A1. mp.ta_jst(c, A, sc, B, s, pm, V1, A1) &&
          x31 = ok(pair(fn_update(s, "vm", V1), pair(a1, pair(a2, pair(A1.active[sc][0], pair(X, pair(a5, pair(a6, pair(a7, pair(a8, pair(a9, pair(a10, a11))))))))))), empty)) ->
          mp.ta_out(c, A, sc, B, s, o) proof
        assume ex
        obtain V1 A1, j1 j2 j3 j4 j5 j6 j7 j8 j9 j10 j11 j12 j13 j14 j15 hx31 from ex
        have J: mp.ta_jst(c, A, sc, B, s, pm, V1, A1) by taut(j1, j2, j3, j4, j5, j6, j7, j8, j9, j10, j11, j12, j13, j14, j15)
        have hsh1 := apply(mp.shown_reorg[c := c, A := A, A2 := A1, sc := sc, objs := s.objs], hAa, j12, hsh0)
        have k1 := rewrite(hx31, kx)
        let W1 := fn_update(s, "vm", V1)
        let M1 := A1.active[sc][0]
        have vb1: V1.bytes in fn_space(bits(64), bits(8)) by simp(j1)
        have wU1: W1 in univ(1) by simp(hu, apply(x86.vm_univ, j1))
        have {H1 = inv} := expand(j4, mallocng.holds_m)
        have {hac1 = active} := expand(H1, mallocng.holds)
        have iu1 _ _ := mp(all_elim(expand(hac1, mallocng.active_ok), {sc}, {0}), conj(hs, (0 in omega by simp())), conj(hsl, j9))
        have {m1o = nat, m1top = top, m1nz = nz, m1meta = meta, m1av = avail, m1fr = freed, m1wd = word, m1hnz = hnz, m1htop = htop, m1hrd = hrd, m1hwr = hwr, m1hb = hbyte} :=
          apply(mp.grp_acc[c := c, A := A1, vm := V1, b := B, objs := s.objs, g := M1], hc, j3, j2, vb1, j4, hsh1, j5, iu1)
        have m1b: M1 in bits(64) by arith(m1o, m1top)
        have u28 _ := mp(all_elim(m1meta, {28}, {4}), simp(), simp(), simp())
        have md28: g.mem_defined(W1, M1, 28, 4, false) by simp(m1nz, u28, m1top, m1o, p64)
        have u32 _ := mp(all_elim(m1meta, {32}, {1}), simp(), simp(), simp())
        have md32: g.mem_defined(W1, M1, 32, 1, false) by simp(m1nz, u32, m1top, m1o, p64)
        step x12, k2 from k1 with g.ld32_det, g.ldbf_det, ms.shl32_det using conj(wU1, m1b, md28, md32)
        have tb2 kx2 := k2
        let F1 := bits_of_int(32, gimple.bytes_at(V1, int_add(M1, 28), 4))
        let FULL := bits_add(32, bits_shl(32, bits_of_int(32, 2), bits_of_int(5, int_mod(int_div(gimple.bytes_at(V1, int_add(M1, 32), 1), int_pow(2, 0)), int_pow(2, 5)))),
          bits_neg(32, 1))
        // the head skipped if fully free and freeable: either way, such a
        // state, its head's freed mask in `mask`
        have j2: ex V2 A2. mp.ta_jst(c, A, sc, B, s, pm, V2, A2) &&
            x12 = ok(pair(fn_update(s, "vm", V2), pair(a1, pair(a2, pair(A2.active[sc][0], pair(bits_of_int(32, gimple.bytes_at(V2, int_add(A2.active[sc][0], 28), 4)),
              pair(a5, pair(a6, pair(a7, pair(a8, pair(a9, pair(a10, a11))))))))))), empty) proof
          have nf: !(F1 = FULL) -> ex V2 A2. mp.ta_jst(c, A, sc, B, s, pm, V2, A2) &&
              x12 = ok(pair(fn_update(s, "vm", V2), pair(a1, pair(a2, pair(A2.active[sc][0], pair(bits_of_int(32, gimple.bytes_at(V2, int_add(A2.active[sc][0], 28), 4)),
                pair(a5, pair(a6, pair(a7, pair(a8, pair(a9, pair(a10, a11))))))))))), empty) proof
            assume h
            step e from tb2 with h
            show by ex_intro({V1}, {A1}, taut(J, e))
          qed
          have fu: F1 = FULL -> ex V2 A2. mp.ta_jst(c, A, sc, B, s, pm, V2, A2) &&
              x12 = ok(pair(fn_update(s, "vm", V2), pair(a1, pair(a2, pair(A2.active[sc][0], pair(bits_of_int(32, gimple.bytes_at(V2, int_add(A2.active[sc][0], 28), 4)),
                pair(a5, pair(a6, pair(a7, pair(a8, pair(a9, pair(a10, a11))))))))))), empty) proof
            assume h
            step e0 from tb2 with h
            step x4, e2 from e0 with g.ldbf_det using conj(wU1, m1b, md32)
            let TST := bits_and(8, bits_of_int(8, int_mod(int_div(gimple.bytes_at(V1, int_add(M1, 32), 1), int_pow(2, 0)), int_pow(2, 8))), 32)
            have nfb: TST = 0 -> ex V2 A2. mp.ta_jst(c, A, sc, B, s, pm, V2, A2) &&
                x12 = ok(pair(fn_update(s, "vm", V2), pair(a1, pair(a2, pair(A2.active[sc][0], pair(bits_of_int(32, gimple.bytes_at(V2, int_add(A2.active[sc][0], 28), 4)),
                  pair(a5, pair(a6, pair(a7, pair(a8, pair(a9, pair(a10, a11))))))))))), empty) proof
              assume t0
              step e from e2 with t0
              show by ex_intro({V1}, {A1}, taut(J, e))
            qed
            have fb: !(TST = 0) -> ex V2 A2. mp.ta_jst(c, A, sc, B, s, pm, V2, A2) &&
                x12 = ok(pair(fn_update(s, "vm", V2), pair(a1, pair(a2, pair(A2.active[sc][0], pair(bits_of_int(32, gimple.bytes_at(V2, int_add(A2.active[sc][0], 28), 4)),
                  pair(a5, pair(a6, pair(a7, pair(a8, pair(a9, pair(a10, a11))))))))))), empty) proof
              assume t1
              step e3 from e2 with t1
              have e4 k4 := e3
              have u8 _ := mp(all_elim(m1meta, {8}, {8}), simp(), simp(), simp())
              have md8: g.mem_defined(W1, M1, 8, 8, false) by simp(m1nz, u8, m1top, m1o, p64)
              have {wh1 = head} := expand(j8, mallocng_specs.list_at)
              have nn1 bd1 _ wr1 := expand(wh1, mallocng_specs.word_ok)
              have md0w: g.mem_defined(W1, pm, 0, 8, true) by simp(nn1, wr1, bd1, hpb, p64)
              have fd1 fd2 := mp(fn_update_fd[f := s, k := "vm", v := V1, d := dom(s)], vfun, refl({dom(s)}), vdom)
              have wf1: is_fun(W1) && "vm" in dom(W1) && W1.vm in x86_64_linux.Vm by taut(fd1, rewrite(sym(fd2), vdom), (W1.vm in x86_64_linux.Vm by simp(j1)))
              step e5 from e4 with g.ld64_det, g.st64_det using conj(wU1, m1b, md8, hpb, md0w, wf1)
              // the state: rotated once more (`jst_rot`)
              let L1 := A1.active[sc]
              let n1 := seq_len(L1)
              let X1 := L1[int_mod(1, n1)]
              let V2 := mallocng_specs.wr64(V1, pm, X1)
              let A2 := mp.relist(A1, sc, mp.rot(L1), V2)
              have fsb: s.fs_base in bits(64) by simp(hw)
              have q1 q2 q3 q4 q5 q6 q7 q8 q9 q10 q11 q12 q13 q14 q15 h02 :=
                apply(mp.jst_rot[c := c, A := A, sc := sc, B := B, s := s, pm := pm, V1 := V1, A1 := A1], hc, cal, hs, hsl, hpb, hpe, hbt, fsb, hAa, hsh0, J)
              have J2: mp.ta_jst(c, A, sc, B, s, pm, V2, A2) by taut(q1, q2, q3, q4, q5, q6, q7, q8, q9, q10, q11, q12, q13, q14, q15)
              have al1: A1.active in list_type(list_type(omega)) by simp(j2)
              have {H1c = inv} := expand(j4, mallocng.holds_m)
              have {cok1 = ctx} := expand(H1c, mallocng.holds)
              have {c111 = nactive} := expand(cok1, mallocng.ctx_ok)
              have ll1 := mp(at_type[l := A1.active, t := list_type(omega), i := sc], al1, hs, (int_lt(sc, seq_len(A1.active)) by arith(c111, hsl)))
              have {lk1 = links} := apply(mp.list_rd[vm := V1, objs := s.objs, phead := pm, l := L1, i := 0], vb1, hpb, ll1, j8)
              have nx1 _ := mp(lk1, simp(), j9)
              have {lel1 = elems} := expand(j8, mallocng_specs.list_at)
              have x1b _ _ _ _ := mp(all_elim(lel1, {int_mod(1, n1)}), arith(j9, ll1), arith(j9, ll1))
              have x1o := apply(at_type[l := L1, t := omega, i := int_mod(1, n1)], ll1, arith(j9, ll1), arith(j9, ll1))
              have ex1: bits_of_int(64, gimple.bytes_at(V1, int_add(M1, 8), 8)) = X1 by defs(simp(nx1, x1o, x1b), bits_of_int, pow2)
              have ev2: fn_update(V1, "bytes", x86_64_linux.store_le(V1.bytes, int_add(pm, 0), 8, X1)) = V2 :=
                subst({y. fn_update(V1, "bytes", x86_64_linux.store_le(V1.bytes, y, 8, X1)) = V2}, sym(ap0), sym(all_elim(ms.v_wr64, {V1}, {pm}, {X1})))
              have e6 := rewrite(ev2, rewrite(ex1, e5))
              // the new head's freed mask read
              have v2v := q1
              have a2a := q2
              have a2u := q3
              have hin2 := q4
              have nr2 := q5
              have hsh2 := apply(mp.shown_reorg[c := c, A := A, A2 := A2, sc := sc, objs := s.objs], hAa, q12, hsh0)
              have ln2 := q9
              have {H2 = inv} := expand(hin2, mallocng.holds_m)
              have {hac2 = active} := expand(H2, mallocng.holds)
              have iu2 _ _ := mp(all_elim(expand(hac2, mallocng.active_ok), {sc}, {0}), conj(hs, (0 in omega by simp())), conj(hsl, ln2))
              have vb2: V2.bytes in fn_space(bits(64), bits(8)) by simp(v2v)
              have {m2o = nat, m2top = top, m2nz = nz, m2meta = meta} := apply(mp.grp_acc[c := c, A := A2, vm := V2, b := B, objs := s.objs, g := A2.active[sc][0]], hc, a2u, a2a, vb2, hin2, hsh2, nr2, iu2)
              have x1n: X1 in bits(64) by arith(rewrite(h02, m2o), rewrite(h02, m2top))
              have u28b _ := mp(all_elim(m2meta, {28}, {4}), simp(), simp(), simp())
              have md28b: g.mem_defined(fn_update(s, "vm", V2), X1, 28, 4, false) by simp(rewrite(h02, m2nz), rewrite(h02, u28b), rewrite(h02, m2top), x1o, p64)
              have wU2: fn_update(s, "vm", V2) in univ(1) by simp(hu, apply(x86.vm_univ, v2v))
              step e7 from e6 with g.ld32_det using conj(wU2, x1n, md28b)
              step e8 from rewrite(e7, k4)
              have e9 := subst({y. x12 = ok(pair(fn_update(s, "vm", V2), pair(a1, pair(a2, pair(y, pair(bits_of_int(32, gimple.bytes_at(V2, int_add(y, 28), 4)),
                pair(a5, pair(a6, pair(a7, pair(a8, pair(a9, pair(a10, a11))))))))))), empty)}, sym(h02), e8)
              show by ex_intro({V2}, {A2}, taut(J2, e9))
            qed
            show by taut(nfb, fb)
          qed
          show by taut(nf, fu)
        qed
        obtain V2 A2, i1 i2 i3 i4 i5 i6 i7 i8 i9 i10 i11 i12 i13 i14 i15 hx12 from j2
        have J2: mp.ta_jst(c, A, sc, B, s, pm, V2, A2) by taut(i1, i2, i3, i4, i5, i6, i7, i8, i9, i10, i11, i12, i13, i14, i15)
        have k3 := rewrite(hx12, kx2)
        let W2 := fn_update(s, "vm", V2)
        let M2 := A2.active[sc][0]
        have vb2: V2.bytes in fn_space(bits(64), bits(8)) by simp(i1)
        have wU2: W2 in univ(1) by simp(hu, apply(x86.vm_univ, i1))
        have {H2 = inv} := expand(i4, mallocng.holds_m)
        have hsh2 := apply(mp.shown_reorg[c := c, A := A, A2 := A2, sc := sc, objs := s.objs], hAa, i12, hsh0)
        have {hac2 = active} := expand(H2, mallocng.holds)
        have iu2 _ _ := mp(all_elim(expand(hac2, mallocng.active_ok), {sc}, {0}), conj(hs, (0 in omega by simp())), conj(hsl, i9))
        have {m2o = nat, m2top = top, m2nz = nz, m2meta = meta, m2mem = mem, m2hnz = hnz, m2htop = htop, m2hrd = hrd, m2hwr = hwr, m2hb = hbyte} :=
          apply(mp.grp_acc[c := c, A := A2, vm := V2, b := B, objs := s.objs, g := M2], hc, i3, i2, vb2, i4, hsh2, i5, iu2)
        have m2b: M2 in bits(64) by arith(m2o, m2top)
        have u16 _ := mp(all_elim(m2meta, {16}, {8}), simp(), simp(), simp())
        have md16: g.mem_defined(W2, M2, 16, 8, false) by simp(m2nz, u16, m2top, m2o, p64)
        // (the group's header: its active index byte)
        let G2 := A2.metas[M2].mem
        have bo16 bl16 := mp(all_elim(g.bytes_bound, {V2}, {int_add(M2, 16)}, {8}), vb2, simp())
        have eg2: bits_of_int(64, gimple.bytes_at(V2, int_add(M2, 16), 8)) = G2 := trans((bits_of_int(64, gimple.bytes_at(V2, int_add(M2, 16), 8)) = gimple.bytes_at(V2, int_add(M2, 16), 8)
          by defs(arith(bo16, bl16), bits_of_int, pow2)), m2mem)
        have g2b: G2 in bits(64) by arith(m2htop, rewrite(m2mem, bo16))
        have mdh: g.mem_defined(W2, G2, 8, 1, false) by simp(m2hnz, m2hrd, m2htop, p64, g2b)
        have mdhx := rewrite(sym(eg2), mdh)
        have g2bx := rewrite(sym(eg2), g2b)
