              let X := bits_xor(32, SP(k), E1)
              have xs := apply(mp.xor_small[a := SP(k), b := E1], arith(spl, q0b, spo), arith(spl, q0b, spo, zo, zcl, z16))
              have xo: X in omega by simp(apply(bits_xor_in[n := 32, x := SP(k), y := E1], simp()))
              have sX := mp(all_elim(ms.sint_small, {X}), xo, arith(xs))
              have s4095: sint(32, 4095) = 4095 by defs(simp(), sint)
              have xb := apply(xor_block[n := 32, x := SP(k), y := E1, k := 12], simp(), simp(), simp(), spb, arith(spl, q0b, spo, zo, zcl, z16))
              have p12: pow2(12) = 4096 by simp()
              have same: SAME(k) -> (SAME(k) && o = ok(TUP(int_add(k, 1)), empty)) || (!SAME(k) && o = exc(TUP(k), pair("brk", empty))) proof
                assume hs1
                have nc: !int_lt(sint(32, 4095), sint(32, X)) by arith(sX, s4095, rewrite(p12, xb), hs1, xo)
                step k5 from e3 with nc
                // cnt + 1, span + Z
                let CK := int_add(C0, k)
                have cko: CK in omega by arith(c0o, ko)
                have ckl: int_lt(CK, 1000000) by arith(spl, q0b, z16, refl({int_mul(int_sub(Z, 17), CK)}), cko)
                have sck := mp(all_elim(ms.sint_small, {CK}), cko, arith(ckl))
                have s1: sint(32, 1) = 1 by defs(simp(), sint)
                have fc: tr.s32_fits(int_add(sint(32, CK), sint(32, 1))) by defs(simp(sck, s1, ckl, cko), gimple.fits)
                have a3 := apply(g.sadd32_det, {W2}, {CK}, {1}, wU2, arith(ckl, cko), simp(), fc)
                step e5 from k5 with a3, a1
                have ec: bits_add(32, CK, 1) = int_add(C0, int_add(k, 1)) by defs(arith(ckl, cko), bits_add, pow2)
                have es: S1 = SP(int_add(k, 1)) by arith(refl({int_mul(Z, int_add(C0, int_add(k, 1)))}), refl({int_mul(Z, CK)}))
                have e6 := rewrite(es, rewrite(ec, rewrite(ea1, e5)))
                show by taut(hs1, e6)
              qed
              have brk: !SAME(k) -> (SAME(k) && o = ok(TUP(int_add(k, 1)), empty)) || (!SAME(k) && o = exc(TUP(k), pair("brk", empty))) proof
                assume hs1
                have nc: int_lt(sint(32, 4095), sint(32, X)) by arith(sX, s4095, rewrite(p12, xb), hs1, xo)
                step e5 from e3 with nc
                show by taut(hs1, e5)
              qed
              show by taut(same, brk)
            qed
            // the invariant: span within its first page or, past an exact
            // landing, the next (`span_next`); the variant: the room left
            let P(l) := ex k. k in omega && mp.hq(SP(k), Z, q0) && l = TUP(k)
            let MS(l) := int_sub(int_mul(4096, int_add(q0, 2)), fst(snd(snd(snd(snd(snd(snd(l))))))))
            have sp0: int_add(16, int_mul(Z, C0)) = int_add(P0, 16) by arith(p0o)
            have z0: int_add(C0, 0) = C0 by arith(c0o)
            have t0: TUP(0) = pair(W2, pair(C0, pair(a2, pair(M2, pair(FC, pair(Z, pair(int_add(P0, 16), pair(a7, pair(a8, pair(a9, pair(a10, a11)))))))))))
              by rsimp(z0, sp0, only)
            have spe0: SP(0) = int_add(P0, 16) by rsimp(z0, sp0, only)
            have h0: int_div(SP(0), 4096) = q0 := subst({y. int_div(y, 4096) = q0}, sym(spe0), refl({q0}))
            let L0 := pair(W2, pair(C0, pair(a2, pair(M2, pair(FC, pair(Z, pair(int_add(P0, 16), pair(a7, pair(a8, pair(a9, pair(a10, a11)))))))))))
            have p0: P(L0) by ex_intro({0}, taut((0 in omega by simp()), h0, sym(t0)))
            have pmv: all l. P(l) -> MS(l) in omega proof
              fix l
              assume hp
              obtain k, ko hk le from hp
              have spo: SP(k) in omega by arith(zo, c0o, ko, refl({int_mul(Z, int_add(C0, k))}))
              have spl: int_lt(SP(k), int_mul(4096, int_add(q0, 2))) by arith(hk, spo)
              have ms: MS(l) = int_sub(int_mul(4096, int_add(q0, 2)), SP(k)) by simp(le)
              show by arith(ms, spl, spo)
            qed
            have nx: all l l2. P(l) -> BODY(l, ok(l2, empty)) -> P(l2) && int_lt(MS(l2), MS(l)) proof
              fix l l2
              assume hp hb
              obtain k, ko hk le from hp
              have rk := mp(all_elim(mp(all_elim(run, {k}), ko, hk), {ok(l2, empty)}), rewrite(le, hb))
              have more: SAME(k) && ok(l2, empty) = ok(TUP(int_add(k, 1)), empty) -> P(l2) && int_lt(MS(l2), MS(l)) proof
                assume hm
                have hs1 eo := hm
                have l2e: l2 = TUP(int_add(k, 1)) by simp(eo)
                have hn := apply(mp.span_next[Z := Z, c := int_add(C0, k), q0 := q0], zo, z16, arith(c0o, ko), arith(p0o), hk, hs1)
                have ck1: int_add(int_add(C0, k), 1) = int_add(C0, int_add(k, 1)) by arith(c0o, ko)
                have hn2 := rewrite(ck1, hn)
                have pl2: P(l2) by ex_intro({int_add(k, 1)}, taut((int_add(k, 1) in omega by arith(ko)), hn2, l2e))
                have m1: MS(l) = int_sub(int_mul(4096, int_add(q0, 2)), SP(k)) by simp(le)
                have m2: MS(l2) = int_sub(int_mul(4096, int_add(q0, 2)), SP(int_add(k, 1))) by simp(l2e)
                have lt: int_lt(MS(l2), MS(l)) by arith(m1, m2, z16, refl({int_mul(Z, int_add(C0, k))}), refl({int_mul(Z, int_add(C0, int_add(k, 1)))}))
                show by taut(pl2, lt)
              qed
              have stop: !SAME(k) && ok(l2, empty) = exc(TUP(k), pair("brk", empty)) -> P(l2) && int_lt(MS(l2), MS(l)) proof
                assume hm
                have _ eo := hm
                have f: false by defs(simp(eo), ok, exc)
                show by taut(f)
              qed
              show by taut(rk, more, stop)
            qed
            have wv := apply(g.loop[b := l o. BODY(l, o), p := l. P(l), m := l. MS(l)], p0, pmv, nx, wl)
            obtain l, hpl bb nk from wv
            obtain k, ko hk le from hpl
            have rk := mp(all_elim(mp(all_elim(run, {k}), ko, hk), {r}), rewrite(le, bb))
            have ok1: !(SAME(k) && r = ok(TUP(int_add(k, 1)), empty)) proof
              assume hm
              have _ eo := hm
              have k1: is_ok(r) by defs(simp(eo), is_ok)
              show by taut(k1, nk)
            qed
            have nsame re := (!SAME(k) && r = exc(TUP(k), pair("brk", empty)) by taut(rk, ok1))
            // after: cnt at most the last slot + 1
            have u321 _ := mp(all_elim(m2meta, {32}, {1}), simp(), simp(), simp())
            have md321: g.mem_defined(W2, M2, 32, 1, false) by simp(m2nz, u321, m2top, m2o, p64)
            step e21 from rewrite(re, c19) with g.ldbf_det using conj(wU2, m2b, md321)
            // (the last slot: the word's low 5 bits)
            let A32 := int_add(M2, 32)
            let B1 := gimple.bytes_at(V2, A32, 1)
            let B7 := gimple.bytes_at(V2, int_add(M2, 33), 7)
            have a32b: A32 in bits(64) by arith(m2o, m2top)
            have a33: bits_add(64, A32, 1) = int_add(M2, 33) by defs(arith(m2o, m2top), bits_add, pow2)
            have s17 := mp(all_elim(g.bytes_split, {V2}, {A32}, {1}, {7}), a32b, simp(), simp())
            have w17: W32 = int_add(B1, int_mul(256, B7)) by simp(s17, a33)
            have b1o b1l := mp(all_elim(g.bytes_bound, {V2}, {A32}, {1}), vb2, simp())
            have b7o _ := mp(all_elim(g.bytes_bound, {V2}, {int_add(M2, 33)}, {7}), vb2, simp())
            have lc: int_mod(B1, 32) = LAST by arith(w17, m2wd, ml2, mf2, vf1, vf2, vf3, vf4, b1o, b7o)
            have lce := trans(apply(mp.idx5[x := B1], b1o), lc)
            have e22 := rewrite(lce, e21)
            have lso: LAST in omega by simp(vf1)
            have sL := mp(all_elim(ms.sint_small, {LAST}), lso, arith(ml2))
            have fl: tr.s32_fits(int_add(sint(32, LAST), sint(32, 1))) by defs(simp(sL, ml2, lso), gimple.fits)
            have s1: sint(32, 1) = 1 by defs(simp(), sint)
            have sd3 := apply(g.sadd32_det, {W2}, {LAST}, {1}, wU2, arith(ml2, lso), simp(), fl)
            have el1: bits_add(32, LAST, 1) = int_add(LAST, 1) by defs(arith(ml2, lso), bits_add, pow2)
            step e23 from e22 with sd3
            have e24 := rewrite(el1, e23)
            obtain y, tb6 kx6 from e24
            let CK := int_add(C0, k)
            let REST := pair(a2, pair(M2, pair(FC, pair(Z, pair(SP(k), pair(a7, pair(a8, pair(a9, pair(a10, a11)))))))))
            have cko: CK in omega by arith(c0o, ko)
            have spo: SP(k) in omega by arith(zo, c0o, ko, refl({int_mul(Z, CK)}))
            have spl: int_lt(SP(k), int_mul(4096, int_add(q0, 2))) by arith(hk, spo)
            have ckl: int_lt(CK, 1000000) by arith(spl, q0b, z16, refl({int_mul(int_sub(Z, 17), CK)}), cko)
            have sck := mp(all_elim(ms.sint_small, {CK}), cko, arith(ckl))
            have sL1 := mp(all_elim(ms.sint_small, {int_add(LAST, 1)}), arith(lso), arith(ml2))
            have cf: ex CF. (CF in omega && int_le(int_add(I2, 2), CF) && int_le(CF, int_add(LAST, 1))) && y = ok(pair(W2, pair(CF, REST)), empty) proof
              have cap: int_lt(int_add(LAST, 1), CK) -> ex CF. (CF in omega && int_le(int_add(I2, 2), CF) && int_le(CF, int_add(LAST, 1))) && y = ok(pair(W2, pair(CF, REST)), empty) proof
                assume hl
                have ltc: int_lt(sint(32, int_add(LAST, 1)), sint(32, CK)) by arith(hl, sck, sL1)
                step f0 from tb6 with ltc
                step f1 from f0 with g.ldbf_det using conj(wU2, m2b, md321)
                step f3 from rewrite(lce, f1) with sd3
                have f4 := rewrite(el1, f3)
                show by ex_intro({int_add(LAST, 1)}, taut((int_add(LAST, 1) in omega by arith(lso)), (int_le(int_add(I2, 2), int_add(LAST, 1)) by arith(lpos, i2o, lso)),
                  (int_le(int_add(LAST, 1), int_add(LAST, 1)) by arith(lso)), f4))
              qed
              have keep: !int_lt(int_add(LAST, 1), CK) -> ex CF. (CF in omega && int_le(int_add(I2, 2), CF) && int_le(CF, int_add(LAST, 1))) && y = ok(pair(W2, pair(CF, REST)), empty) proof
                assume hl
                have ngc: !int_lt(sint(32, int_add(LAST, 1)), sint(32, CK)) by arith(hl, sck, sL1)
                step f1 from tb6 with ngc
                show by ex_intro({CK}, taut(cko, (int_le(int_add(I2, 2), CK) by arith(i2o, ko)), (int_le(CK, int_add(LAST, 1)) by arith(hl, cko, lso)), f1))
              qed
              show by taut(cap, keep)
            qed
            obtain CF, cfo cfl cfh ye from cf
            have k25 := rewrite(ye, kx6)
            // the new active index CF - 1 stored
            let NI := int_sub(CF, 1)
            have b8c: bits_of_int(8, CF) = CF by defs(arith(cfh, ml2, cfo), bits_of_int, pow2)
            have b8d: bits_add(8, CF, bits_neg(8, 1)) = NI by defs(arith(cfl, cfh, ml2, cfo, i2o), bits_add, bits_neg, pow2)
            have b5: bits_of_int(5, NI) = NI by defs(arith(cfl, cfh, ml2, cfo, i2o), bits_of_int, pow2)
            step f5 from k25 with g.ld64_det using conj(wU2, m2b, md16)
            have f6 := rewrite(b5, rewrite(b8d, rewrite(b8c, rewrite(eg2, f5))))
            have mdhw: g.mem_defined(W2, G2, 8, 1, true) by simp(m2hnz, m2hwr, m2htop, p64, g2b)
            have fd1 fd2 := mp(fn_update_fd[f := s, k := "vm", v := V2, d := dom(s)], vfun, refl({dom(s)}), vdom)
            have sb := apply(ms.stbf_det, {W2}, {G2}, {8}, {1}, {0}, {5}, {NI}, wU2, g2b, simp(), simp(), simp(), mdhw, (W2.vm in x86_64_linux.Vm by simp(i1)),
              fd1, rewrite(sym(fd2), vdom))
            step f7 from f6 with sb
            // the state: the header byte written (`act_raise`)
            let OB := gimple.bytes_at(V2, int_add(G2, 8), 1)
            have nio: NI in omega by arith(cfl, i2o, cfo)
            have nil: int_lt(NI, 32) by arith(cfh, ml2, cfo)
            have hn := apply(mp.hdr_new[O := OB, n := NI], bo8, (int_lt(OB, 256) by arith(bl8)), nio, nil)
            let NB := int_add(int_mul(int_div(OB, 32), 32), NI)
            have ew: mallocng_specs.wr8(V2, int_add(G2, 8), NB) = fn_update(V2, "bytes", x86_64_linux.store_le(V2.bytes, int_add(G2, 8), 1, NB))
              by defs(refl({fn_update(V2, "bytes", x86_64_linux.store_le(V2.bytes, int_add(G2, 8), 1, NB))}), mallocng_specs.wr8)
            have f8 := rewrite(sym(ew), rewrite(hn, f7))
            step f9 from rewrite(f8, kx5)
            have nbo: NB in omega by arith(bo8, nio)
            have nbl: int_lt(NB, 256) by arith(bo8, bl8, nio, nil)
            have nbm: int_mod(NB, 32) = NI by arith(bo8, nio, nil)
            have fsb: s.fs_base in bits(64) by simp(hw)
            have Ja := apply(mp.act_raise[c := c, A := A, sc := sc, B := B, s := s, pm := pm, V2 := V2, A2 := A2, NB := NB], hc, cal, hs, hsl, hpb, hpe, hbt, fsb, hAa, hsh0, J2,
              nbo, nbl, (int_lt(I2, int_mod(NB, 32)) by arith(nbm, cfl)), (int_le(int_mod(NB, 32), LAST) by arith(nbm, cfh)))
            show by ex_intro({mallocng_specs.wr8(V2, int_add(G2, 8), NB)}, {A2}, {CF}, {Z}, {SP(k)}, {FC}, taut(Ja, f9))
          qed
          show by taut(rt, ra, (n2 = 1 || !(n2 = 1) by taut()))
        qed
        have j3: ex V3 A3 n3 z3 p3 k3. mp.ta_act(c, A, sc, B, s, pm, V3, A3) &&
            x16 = ok(pair(fn_update(s, "vm", V3), pair(n3, pair(a2, pair(A3.active[sc][0], pair(k3, pair(z3, pair(p3, pair(a7, pair(a8, pair(a9, pair(a10, a11))))))))))), empty)
          by taut(ca, cb, (TEST = 0 || !(TEST = 0) by taut()))
        // the head activated (`ag_q`, the ghost part's A that state)
        obtain V3 A3 n3 z3 p3 k3, l1 l2 l3 l4 l5 l6 l7 l8 l9 l10 l11 l12 l13 l14 l15 l16 hx16 from j3
        have k6 := rewrite(hx16, kx4)
        let W3 := fn_update(s, "vm", V3)
        let M3 := A3.active[sc][0]
        let H3 := fn_update(h, "A", A3)
        have hg3 := apply(mp.g_upd, {h}, {A3}, hh, l2, l3)
        have v3u := apply(x86.vm_univ, l1)
        have wW3: W3 in abi.World by defs(simp(expand(hw, abi.World), hu, l1, v3u), abi.World)
        have wU3: W3 in univ(1) by simp(hu, v3u)
        have ths3: gc.sound(W3) by simp(l6)
        have vb3: V3.bytes in fn_space(bits(64), bits(8)) by simp(l1)
        have {H3i = inv} := expand(l4, mallocng.holds_m)
        have {hac3 = active} := expand(H3i, mallocng.holds)
        have iu3 _ _ := mp(all_elim(expand(hac3, mallocng.active_ok), {sc}, {0}), conj(hs, (0 in omega by simp())), conj(hsl, l9))
        have psh0 := apply(mp.shown_reorg[c := c, A := A, A2 := A3, sc := sc, objs := s.objs], hAa, l12, hsh)
        have {m3o = nat, m3t = top} := apply(mp.grp_acc[c := c, A := A3, vm := V3, b := B, objs := s.objs, g := M3], hc, l3, l2, vb3, l4, psh0, l5, iu3)
        have m3b: M3 in bits(64) by arith(m3o, m3t)
        have once3: all x2. all x3. x2 in omega && x3 in omega -> (int_lt(x2, 48) && int_lt(x3, seq_len(A3.active[x2]))) && A3.active[x2][x3] = M3 -> x3 = 0 proof
          fix x2 x3
          assume hn hl
          have hn0 hn1 := hn
          have hl0 hl1 he := hl
          have _ k := apply(mp.list_once[c := c, A := A3, M := mallocng.mview(V3, mallocng.held(c, A3, B)), b := B, brk := V3.brk, s1 := x2, k1 := x3, s2 := sc, k2 := 0],
            H3i, hn0, hn1, hs, (0 in omega by simp()), hl0, hsl, hl1, l9, he)
          show := k
        qed
        have hA3: H3.A = A3 by simp()
        have hB3: H3.blocks = B by simp(hbt)
        have pin: mallocng.holds_m(c, H3.A, W3.vm, H3.blocks) by simp(l4, hA3, hB3)
        have psh: mallocng.shown_in(c, H3.A, W3.objs) by simp(psh0, hA3)
        have pnr: mallocng.no_reserved(H3.A) by simp(l5, hA3)
        have pth: abi.thread_ok(W3.vm, W3.fs_base) by simp(l6)
        have piu: mallocng.is_used(H3.A, M3) by simp(iu3, hA3)
        have pav: H3.A.metas[M3].avail = 0 by simp(l10, hA3)
        have pon: all x2. all x3. x2 in omega && x3 in omega -> (int_lt(x2, 48) && int_lt(x3, seq_len(H3.A.active[x2]))) && H3.A.active[x2][x3] = M3 -> x3 = 0 by simp(once3, hA3)
        have agself: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
            runs(gag[regs], s, o) -> runs(gag[regs], s, o) proof
          fix regs s o
          assume _ _ _ r
          show r
        qed
        step V4 r4, e30 hR4 from k6 with hag using agself, m3b, wW3, wU3, ths3, hg3, pin, psh, pnr, pth, piu, pav, pon
        have v4v ex4 := hR4
        obtain A4, a4a a4u act4 hin4 unt4 rv from ex4
        have mo4 oth4 avl4 frl4 bits4 := expand(rewrite(hA3, act4), mallocng_specs.activated)
        have ro34 sl34 := apply(mp.mo_reorg[A := A3, A2 := A4, sc := sc], l2, mo4)
        // the mask: A4's available slots, among them the freed one active
        let IX := mallocng_specs.active_idx(V3, A3.metas[M3])
        have {ixo = inat, ixl = ilt} := apply(mp.ag_pre[c := c, A := A3, vm := V3, b := B, objs := s.objs, fs := s.fs_base, g := M3],
          hc, l3, l2, hbt, vb3, m3b, l4, psh0, l5, l6, iu3, l10)
        obtain i, io il ib from l16
        have b4a _ := mp(all_elim(bits4, {i}), io, arith(il, ixl))
        have {f3b = fb} := apply(mp.freed_some[c := c, A := A3, vm := V3, b := B, g := M3], hc, l3, l2, vb3, l4, l5, iu3, l10, l11)
        have nf3: mallocng.bit(A3.metas[M3].freed, i) = 1 by simp(apply(mp.nbit[x := A3.metas[M3].freed, i := i], arith(f3b), io), ib)
        have na4: mallocng.bit(A4.metas[M3].avail, i) = 1 by simp(b4a, il, nf3)
        have n0: mallocng.bit(0, i) = 0 by simp(apply(mp.nbit[x := 0, i := i], simp(), io), mp(bit_zero_none[j := i], io))
        have nz4: !(A4.metas[M3].avail = 0) proof
          assume z
          show by arith(rewrite(z, na4), n0)
        qed
        have vt4: A4.metas[M3] in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A4.metas, x := M3], simp(a4a), m3o)
        let MK := bits_of_int(32, fst(r4))
        have av4o: A4.metas[M3].avail in omega by simp(vt4)
        have mk: MK = A4.metas[M3].avail := trans(rv, (bits_of_int(32, A4.metas[M3].avail) = A4.metas[M3].avail by defs(arith(avl4, av4o), bits_of_int, pow2)))
        have mnz: !(MK = 0) := rewrite(sym(mk), nz4)
        obtain y7, tb7 kx7 from e30
        step e31 from tb7 with mnz
        have k8 := rewrite(e31, kx7)
        // the activated state A4 in V4: the invariant, the head still in use
        let W4 := fn_update(s, "vm", V4)
        have v4u := apply(x86.vm_univ, v4v)
        have wW4: W4 in abi.World by defs(simp(expand(hw, abi.World), hu, v4v, v4u), abi.World)
        have wU4: W4 in univ(1) by simp(hu, v4u)
        have vb4: V4.bytes in fn_space(bits(64), bits(8)) by simp(v4v)
        have hin4b: mallocng.holds_m(c, A4, V4, B) := rewrite(hB3, hin4)
        have hsh4 := apply(mp.shown_mo[c := c, A := A3, A2 := A4, objs := s.objs], l2, mo4, psh0)
