// okay_to_free by its purpose: some answer (whether to free a group now),
// the world unchanged -- its reads (the meta's words, the class's table
// entry, the class's usage counter) all accessible, its callees
// (get_stride, is_bouncing) called as their contracts allow.

// ----------------------------------------------------------------------
//  okay_to_free: its run
theorem mp.otf_run(c, g, s, h, o, gst, gib): c in mallocng.Cfg -> c.ctx = c_src_malloc_mallocng_malloc.__malloc_context ->
  c.sct = c_src_malloc_mallocng_malloc.__malloc_size_classes -> g in bits(64) ->
  s in abi.World -> h in mp.G -> mallocng.holds_m(c, h.A, s.vm, h.blocks) -> mallocng.shown_in(c, h.A, s.objs) -> abi.thread_ok(s.vm, s.fs_base) ->
  mallocng.is_used(h.A, g) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(gst[regs], s, o) -> runs(c_src_malloc_mallocng_malloc.get_stride_fun()[regs], s, o)) ->
  mp.ib_call(c, gib) ->
  runs(c_src_malloc_mallocng_free.okay_to_free(g, gst, gib), s, o) ->
  abi.ovf_out(s, o) || (ex r. o = ok(s, r) && r in bits(32) && (mallocng.own_mapping(h.A.metas[g]) -> !(r = 0)))
proof
  assume hc hx hsct hg hs hh hin hsh hth hus hgst hib hr
  have ths: gc.sound(s) by simp(hth)
  let A := h.A
  let B := h.blocks
  let V0 := s.vm
  let FP := mallocng.held(c, A, B)
  have hu0 _ hbt hat := mp(all_elim(mp.g_rec, {h}), hh)
  have au: A in univ(1) by simp(hu0)
  have su: s in univ(1) by simp(apply(g.runs_univ, expand(hr, c_src_malloc_mallocng_free.okay_to_free)))
  have vV vfun vdom vb := apply(ms.world_parts, hs)
  have VS := apply(mp.held_vis[c := c, A := A, objs := s.objs, b := B], hsh)
  // the meta's 40 bytes: accessible
  have go g24 inr := apply(mp.meta_mem, hc, au, hat, hin, hus)
  have top _ := apply(mp.meta_word, hc, au, hat, hin, hus)
  have um: all x n. x in omega -> n in omega -> int_le(g, x) -> int_le(int_add(x, n), int_add(g, 40)) -> gimple.usable(V0, s.objs, x, n, false) proof
    fix x n
    assume hx0 hn hl hu
    have bj: all j. j in omega -> int_lt(j, n) -> int_add(x, j) in FP && mallocng.m_mapped(mallocng.mview(V0, FP), int_add(x, j)) &&
        snd(mallocng.pg(mallocng.mview(V0, FP), int_add(x, j))).prot.r && !(snd(mallocng.pg(mallocng.mview(V0, FP), int_add(x, j))).kind = 2) proof
      fix j
      assume hj hjl
      have r1 r2 r3 := mp(all_elim(inr, {int_add(x, j)}), arith(hx0, hj), arith(hl, hj), arith(hu, hjl, hj))
      show by taut(r1, expand(r2, mallocng.m_rw), r3)
    qed
    show := apply(mp.view_usable[vm := V0, fp := FP, objs := s.objs, a := x, n := n], hx0, bj, VS)
  qed
  have gnz: !(g = 0) by arith(g24)
  have g32: int_lt(int_add(g, 32), pow2(64)) by defs(arith(top), pow2)
  have g8: int_lt(int_add(g, 8), pow2(64)) by defs(arith(top), pow2)
  have md1: g.mem_defined(s, g, 32, 1, false) by simp(gnz, g32, mp(all_elim(um, {int_add(g, 32)}, {1}), arith(go), simp(), arith(), arith()))
  have md2: g.mem_defined(s, g, 32, 2, false) by simp(gnz, g32, mp(all_elim(um, {int_add(g, 32)}, {2}), arith(go), simp(), arith(), arith()))
  have md8: g.mem_defined(s, g, 32, 8, false) by simp(gnz, g32, mp(all_elim(um, {int_add(g, 32)}, {8}), arith(go), simp(), arith(), arith()))
  have mn8: g.mem_defined(s, g, 8, 8, false) by simp(gnz, g8, mp(all_elim(um, {int_add(g, 8)}, {8}), arith(go), simp(), arith(), arith()))
  step l1 l2 l3 l4 l5 l6 l7 l8 l9 l10 l11, k1 from hr with g.ldbf_det using conj(su, hg, md1, md2, md8, mn8)
  // (an answer: some word, yes for a group mapped on its own)
  let OWN := mallocng.own_mapping(A.metas[g])
  let OK := abi.ovf_out(s, o) || (ex r. o = ok(s, r) && r in bits(32) && (OWN -> !(r = 0)))
  have fin: all r. r in bits(32) -> (OWN -> !(r = 0)) -> o = ok(s, r) -> OK proof
    fix r
    assume hb hy he
    show by disj({2}, ex_intro({r}, taut(he, hb, hy)))
  qed
  have yes: OWN -> !(1 = 0) by simp()
  // the meta's word: its fields (freeable set), its class
  have {H = inv} := expand(hin, mallocng.holds_m)
  have {uo = used} := expand(H, mallocng.holds)
  have gok := apply(mp.used_group, uo, hus)
  have {mim} := expand(gok, mallocng.group_ok)
  have _ _ _ _ _ _ bl bf bs := expand(mim, mallocng.meta_in_memory)
  have _ mw := apply(mp.meta_word, hc, au, hat, hin, hus)
  have vt: A.metas[g] in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A.metas, x := g], simp(hat), go)
  have vl: A.metas[g].last_idx in omega by simp(vt)
  have vs: A.metas[g].sizeclass in omega by simp(vt)
  have vm2: A.metas[g].maplen in omega by simp(vt)
  have a32 .. := mp(all_elim(ms.gs_word, {V0}, {g}), vb, hg, top)
  have mwd: mallocng_specs.mword(V0, g) = gimple.bytes_at(V0, int_add(g, 32), 8) by defs(simp(a32), mallocng_specs.mword)
  // not freeable: no -- never
  let F0 := bits_and(8, bits_of_int(8, int_mod(int_div(gimple.bytes_at(V0, int_add(g, 32), 1), int_pow(2, 0)), int_pow(2, 8))), 32) = 0
  have fb := apply(mp.free_bit[vm := V0, g := g], vb, hg, top)
  have w32: int_mod(int_div(gimple.bytes_at(V0, int_add(g, 32), 8), 32), 2) = 1 by arith(rewrite(mwd, mw), bl, bf, vl, vs, vm2)
  have nF0: !F0 by simp(fb, w32)
  have r0: F0 -> OK proof
    assume h0
    show by taut(h0, nF0)
  qed
  have n0: !F0 -> OK proof
    assume h0
    step k2 from k1 with h0
    // the size class: above 47, yes
    let SC6 := bits_of_int(6, int_mod(int_div(gimple.bytes_at(V0, int_add(g, 32), 2), int_pow(2, 6)), int_pow(2, 6)))
    let W := gimple.bytes_at(V0, int_add(g, 32), 8)
    let C := int_mod(int_div(W, 64), 64)
    have _ wb _ _ _ g4 := mp(all_elim(ms.gs_word, {V0}, {g}), vb, hg, top)
    have co: C in omega && int_lt(C, 64) by arith(wb)
    have e6: SC6 = C by simp(g4)
    have sC := apply(ms.sint_small, co, (int_lt(C, 2147483648) by arith(co)))
    have sI: sint(32, SC6) = C by simp(e6, sC)
    have s47: sint(32, 47) = 47 by defs(simp(), sint, pow2)
    have r1: int_lt(47, C) -> OK proof
      assume h1
      have c1: int_lt(sint(32, 47), sint(32, SC6)) by simp(sI, s47, h1)
      step e from k2 with c1
      show := mp(all_elim(fin, {1}), simp(), yes, e)
    qed
    have n1: !int_lt(47, C) -> OK proof
      assume h1
      have c1: !int_lt(sint(32, 47), sint(32, SC6)) by simp(sI, s47, h1)
      have gq: all regs o2. gc.regs_ok(regs, seq_one(gimple.arg(64, g))) -> runs(c_src_malloc_mallocng_malloc.get_stride_fun()[regs], s, o2) ->
          abi.ovf_out(s, o2) ||
          (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && (bits_of_int(64, fst(r)) = bits_of_int(64, mallocng.stride(h.A.metas[g])) && fst(r) in bits(64))) proof
        fix regs o2
        assume hro h2
        have q := apply(mp.gst_q[c := c, regs := regs, s := s, h := h, g := g, o2 := o2], hc, hsct, hg, hs, hh, hin, hsh, hus, hro, h2)
        have k: (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && bits_of_int(64, fst(r)) = bits_of_int(64, mallocng.stride(h.A.metas[g])) && fst(r) in bits(64)) ->
            (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && (bits_of_int(64, fst(r)) = bits_of_int(64, mallocng.stride(h.A.metas[g])) && fst(r) in bits(64))) proof
          assume e
          obtain r, x from e
          show by ex_intro({r}, taut(x))
        qed
        show by taut(q, k)
      qed
      step r2 r3, k3 hR3 from k2 with c1, gq using conj(hs, hgst, ths, hg, vV)
      // the class's table entry (C at most 47), times a unit
      have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], vfun, vdom)
      let SCT := c_src_malloc_mallocng_free.__malloc_size_classes
      have sctb: SCT in bits(64) by defs(simp(), c_src_malloc_mallocng_free.__malloc_size_classes)
      have sctnz: !(SCT = 0) by defs(simp(), c_src_malloc_mallocng_free.__malloc_size_classes)
      have esct: c.sct = SCT by defs(simp(hsct), c_src_malloc_mallocng_malloc.__malloc_size_classes, c_src_malloc_mallocng_free.__malloc_size_classes)
      have tok := rewrite(esct, apply(mp.classes_table[c := c, A := A, vm := V0, b := B, objs := s.objs], hc, au, hat, hin, hsh))
      have c48: int_lt(C, 48) by arith(h1, co)
      have I32: SC6 in bits(32) by simp(e6, co, c48)
      have rd ld := apply(ms.tab_rd, {s}, {SCT}, {SC6}, {mallocng.size_classes}, su, sctb, sctnz, I32, (int_le(0, sint(32, SC6)) by simp(sI, co)),
        (int_lt(sint(32, SC6), seq_len(mallocng.size_classes)) by simp(sI, c48, ms.sc_len)), tok)
      let A16 := bits_of_int(16, mallocng.size_classes[sint(32, SC6)])
      have eo el := apply(ms.sc_nat, co, c48)
      have a16: A16 = mallocng.size_classes[C] by defs(simp(sI, eo, el), bits_of_int, pow2)
      have a32b: A16 in bits(32) by simp(a16, eo, el)
      have sA := apply(ms.sint_small, (A16 in omega by simp(a16, eo)), (int_lt(A16, 2147483648) by simp(a16, eo, el)))
      have f16: tr.s32_fits(int_mul(sint(32, A16), sint(32, 16))) by defs(simp(sA, a16, eo, el), gimple.fits)
      have sm := apply(g.smul32_det, {s}, {A16}, {16}, su, a32b, simp(), ms.imul_16, f16)
      step k4 from rewrite(ss, k3) with rd, ld, sm
      // a smaller stride than the class's: yes
      let L2 := int_lt(fst(r3), bits_sext(32, 64, bits_mul(32, A16, 16)))
      have r2c: L2 -> OK proof
        assume h2
        step e from k4 with h2
        show := mp(all_elim(fin, {1}), simp(), yes, e)
      qed
      have n2c: !L2 -> OK proof
        assume h2
        step k5 from k4 with h2, g.ldbf_det using conj(su, hg, md8)
        // (so not a group mapped on its own: its class below 48, its
        // stride the class's at least)
        let V := A.metas[g]
        let E := mallocng.size_classes[C]
        have vc0 := mp(all_elim(ms.sext_mul16, {E}), eo, el)
        have vc: bits_sext(32, 64, bits_mul(32, A16, 16)) = int_mul(16, E) := rewrite(sym(a16), vc0, {1})
        have r3b r3i := hR3
        have sno := apply(mp.stride_nat, hat, go, gok)
        have f3: bits_of_int(64, fst(r3)) = fst(r3) by simp(r3i)
        have sle: int_le(bits_of_int(64, mallocng.stride(V)), mallocng.stride(V)) by defs(arith(sno), bits_of_int, pow2)
        have csc: C = V.sizeclass by arith(rewrite(mwd, mw), bl, bf, bs, vl, vs, vm2)
        have esc: E = mallocng.size_classes[V.sizeclass] by simp(csc)
        have st16: !int_lt(mallocng.stride(V), int_mul(16, mallocng.size_classes[V.sizeclass])) by arith(rewrite(vc, h2), f3, r3b, sle, esc)
        have s48: int_lt(V.sizeclass, 48) by arith(csc, c48)
        have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
        have nown: !OWN by defs(simp(st16, s48, cu), mallocng.own_mapping)
        // not mapped (maplen 0): yes
        let L3 := bits_and(64, bits_of_int(64, int_mod(int_div(W, int_pow(2, 0)), int_pow(2, 64))), bits_neg(64, 4096)) = 0
        have r3c: L3 -> OK proof
          assume h3
          step e from k5 with h3
          show := mp(all_elim(fin, {1}), simp(), yes, e)
        qed
        have n3c: !L3 -> OK proof
          assume h3
          step k6 from k5 with h3, g.ld64_det using conj(su, hg, mn8)
          // not the only active group of its class: yes
          let L4 := g = bits_of_int(64, gimple.bytes_at(V0, int_add(g, 8), 8))
          have r4c: !L4 -> OK proof
            assume h4
            step e from k6 with h4
            show := mp(all_elim(fin, {1}), simp(), yes, e)
          qed
          have n4c: L4 -> OK proof
            assume h4
            // is_bouncing called on the class
            have iq: all regs o2. gc.regs_ok(regs, seq_one(gimple.arg(32, SC6))) -> runs(gib[regs], s, o2) ->
                abi.ovf_out(s, o2) || (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && fst(r) in bits(64)) proof
              fix regs o2
              assume hro h2
              show := mp(all_elim(hib, {SC6}, {s}, {h}, {regs}, {o2}), I32, hs, hh, hin, hsh, hro, h2)
            qed
            step r4 r5, k7 hR5 from k6 with h4, iq using conj(hs, ths, I32, vV)
            // not bouncing: yes
            let L5 := bits_of_int(32, fst(r5)) = 0
            have r5c: L5 -> OK proof
              assume h5
              step e from rewrite(ss, k7) with h5
              show := mp(all_elim(fin, {1}), simp(), yes, e)
            qed
            have n5c: !L5 -> OK proof
              assume h5
              // the slots' count: last_idx + 1
              let LI := bits_of_int(5, int_mod(int_div(gimple.bytes_at(V0, int_add(g, 32), 1), int_pow(2, 0)), int_pow(2, 5)))
              have lio: LI in omega && int_lt(LI, 32) by defs(arith(), bits_of_int, pow2)
              have sLI := apply(ms.sint_small, lio, (int_lt(LI, 2147483648) by arith(lio)))
              have s1: sint(32, 1) = 1 by defs(simp(), sint, pow2)
              have lib: LI in bits(32) by simp(lio)
              have fLI: tr.s32_fits(int_add(sint(32, LI), sint(32, 1))) by defs(simp(sLI, s1, lio), gimple.fits)
              step k8 from rewrite(ss, k7) with h5, g.ldbf_det, g.sadd32_det using conj(su, hg, md1, lib, fLI)
              // the class's usage counter: a context word (free bytes)
              let CTX := c_src_malloc_mallocng_malloc.__malloc_context
              let CF := c_src_malloc_mallocng_free.__malloc_context
              let T64 := fn_update(fn_update(empty, "prec", 64), "signed", true)
              have cv: CTX = 4227328 by defs(simp(), c_src_malloc_mallocng_malloc.__malloc_context)
              have cf: CF = 4227328 by defs(simp(), c_src_malloc_mallocng_free.__malloc_context)
              have sv: gimple.sval(T64, 464) = 464 by defs(simp(), gimple.sval)
              have p64: pow2(64) = 18446744073709551616 by simp()
              have cfb: CF in bits(64) by simp(cf)
              let P := int_add(CF, gimple.sval(T64, 464))
              have pv: P = 4227792 by simp(sv, cf)
              have pb: P in bits(64) by simp(pv)
              have sx: bits_sext(32, 64, SC6) = C by defs(simp(sI), bits_sext, bits_of_int, pow2)
              let U := int_add(P, int_mul(8, C))
              have co2: c.ctx in omega by arith(hx, cv)
              have fu := apply(mp.free_off[c := c, a := int_add(int_add(CTX, 464), int_mul(8, C)), n := 8], co2, arith(cv, co), arith(hx, co), arith(hx, c48, co))
              have uu _ := apply(mp.free_usable[c := c, A := A, vm := V0, b := B, objs := s.objs, a := int_add(int_add(CTX, 464), int_mul(8, C)), n := 8], hc, au, hat, hin, hsh, arith(cv, co), fu)
              have u8: gimple.usable(V0, s.objs, int_add(U, 0), 8, false) by simp(uu, cv, pv, co)
              have unz: !(U = 0) by arith(pv, co)
              have ul: int_lt(int_add(U, 0), pow2(64)) by arith(pv, co, c48, p64)
              have ub: U in bits(64) by simp(pv, co, c48)
              step k9 from k8 with g.padd_det, sx, g.elem8_det, g.ld64_det using conj(su, cfb, pv, pb, p64, co, c48, unz, ul, ub, u8)
              // used enough, few slots: yes; else no
              let CN := bits_sext(32, 64, bits_add(32, LI, 1))
              let L6 := int_le(bits_mul(64, CN, 9), bits_of_int(64, gimple.bytes_at(V0, int_add(U, 0), 8))) && int_le(CN, 19)
              have r6c: L6 -> OK proof
                assume h6
                step e from k9 with h6
                show := mp(all_elim(fin, {1}), simp(), yes, e)
              qed
              have n6c: !L6 -> OK proof
                assume h6
                step e from k9 with h6
                show := mp(all_elim(fin, {0}), simp(), (OWN -> !(0 = 0) by taut(nown)), e)
              qed
              show by taut(r6c, n6c)
            qed
            show by taut(r5c, n5c)
          qed
          show by taut(r4c, n4c)
        qed
        show by taut(r3c, n3c)
      qed
      show by taut(r2c, n2c)
    qed
    show by taut(r1, n1)
  qed
  show by taut(r0, n0)
qed

// ----------------------------------------------------------------------
//  okay_to_free's code by its purpose: its contract, the ghost part kept
theorem mp.otf: all c g gst gib. c in mallocng.Cfg -> c.ctx = c_src_malloc_mallocng_malloc.__malloc_context ->
  c.sct = c_src_malloc_mallocng_malloc.__malloc_size_classes -> g in bits(64) ->
  mp.calls(gst, c_src_malloc_mallocng_malloc.get_stride_fun()) -> mp.ib_call(c, gib) ->
  refines_ghost(c_src_malloc_mallocng_free.okay_to_free(g, gst, gib), mallocng_specs.okay_to_free_spec(c, g), abi.World, mp.G)
proof
  fix c g gst gib
  assume hc hx hsct hg hgst hib
  let P := c_src_malloc_mallocng_free.okay_to_free(g, gst, gib)
  have rp: all s o. runs(P, s, o) -> pair(s, o) in univ(1) proof
    fix s o
    assume hr
    show := apply(g.runs_univ, expand(hr, c_src_malloc_mallocng_free.okay_to_free))
  qed
  unfold mallocng_specs.okay_to_free_spec
  refine ct.refines_contract with mp.g_world, rp
  fix s h o
  assume hw hh hr hpre
  have _ hd _ _ := mp(all_elim(mp.g_rec, {h}), hh)
  have sd: dom(s) = insert("vm", insert("os", insert("fs_base", insert("cpu", insert("objs", empty))))) by simp(expand(hw, abi.World))
  have hin0: mallocng.holds_in(c, h.A, s.vm, s.objs, h.blocks) by simp(hpre, sd, hd)
  have {hin = mem, hsh = shown} := hin0
  have hus: mallocng.is_used(h.A, g) by simp(hpre, sd, hd)
  have hth: abi.thread_ok(s.vm, s.fs_base) by simp(hpre, sd, hd)
  have run := apply(mp.otf_run[c := c, g := g, s := s, h := h, o := o, gst := gst, gib := gib], hc, hx, hsct, hg, hw, hh, hin, hsh, hth, hus, hgst, hib, hr)
  let OWN := mallocng.own_mapping(union2(s, h).A.metas[g])
  have eA: union2(s, h).A = h.A by simp(sd, hd)
  have k: (ex r. o = ok(s, r) && r in bits(32) && (mallocng.own_mapping(h.A.metas[g]) -> !(r = 0))) ->
      (ex s1 v. o = ok(s1, v) && any_rel(x. x in bits(32) && (OWN -> !(x = 0)), x. exc(pair(union2(s1, h), empty), pair("ret", v)) = exc(pair(union2(s, h), empty), pair("ret", x)))) proof
    assume e
    obtain r, ho hb hy from e
    have hy2: OWN -> !(r = 0) by simp(hy, eA)
    have e1: ex x. (x in bits(32) && (OWN -> !(x = 0))) && exc(pair(union2(s, h), empty), pair("ret", r)) = exc(pair(union2(s, h), empty), pair("ret", x))
      by ex_intro({r}, taut(hb, hy2, refl({exc(pair(union2(s, h), empty), pair("ret", r))})))
    have a: any_rel(x. x in bits(32) && (OWN -> !(x = 0)), x. exc(pair(union2(s, h), empty), pair("ret", r)) = exc(pair(union2(s, h), empty), pair("ret", x)))
      by defs(taut(e1), any_rel)
    show by ex_intro({s}, {r}, taut(ho, a))
  qed
  show by taut(run, k)
qed

// its C function value, its divergence, its machine code over any callees:
// mp.otf_fun, mp.otf_divg, mp.otf_implements
contract okay_to_free mallocng_specs.okay_to_free_spec_fun by mp.otf
