        have sD4: gimple.sval(T64, D4) = int_sub(SW, 4) by simp(ad4, sv4)
        have pd3 := apply(g.padd_det, {s}, {E}, {D4}, hu, eo, simp(), arith(sD4, eb, hns4, hn), arith(sD4, eb, p64, swo))
        have pd4 := apply(g.padd_det, {s}, {E}, {bits_neg(64, 3)}, hu, eo, simp(), arith(svm3, eb), arith(svm3, eb, p64, swo))
        let P3 := int_add(E, gimple.sval(T64, bits_neg(64, 3)))
