        have F := conj(hu, hw, hg, hi, hn, memb, swo, mulo, eb, sym(ee), sv16, svD, ad4, sv4, svm2, svm3, svm4, md16, svD2, a1, db, eP, sx, mx, p64)
        have pd1 := apply(g.padd_det, {s}, {MEM}, {16}, hu, memb, simp(), arith(sv16, memb), arith(sv16, a1, p64))
