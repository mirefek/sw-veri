          have tb: gimple.bytes_at(V3, FS, 8) = gimple.bytes_at(V0, FS, 8) by mem(conj(F3, hdf4, fsb, htb))
          have l1 := all_elim(tr.le_bytes, {V3}, {FS}, {8})
          have l2 := all_elim(tr.le_bytes, {V0}, {FS}, {8})
          have ab3: V3.bytes = B3 by simp()
          have e1 := rewrite(ab3, l1)
          have e2 := rewrite(tb, e1)
          have leq: x86_64_linux.le(B3, FS, 8) = x86_64_linux.le(V0.bytes, FS, 8) := trans(e2, sym(l2))
          have ths3: gc.sound(S3) by simp(apply(ms.thread_keep, {V0}, {B3}, {FS}, hth, leq))
          // set_size's precondition there: p, the slot's end ENDP; the bytes as usable as before
