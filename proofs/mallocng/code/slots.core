          let W16 := bits_of_int(16, bits_shr(64, bits_sub(64, P, A), 4))
          let B2 := x86_64_linux.store_le(B, int_add(Q2, 0), 2, W16)
          let B3 := x86_64_linux.store_le(B2, int_add(Q3, 0), 1, bits_of_int(8, idx))
          let V3 := fn_update(V0, "bytes", B3)
          let S3 := fn_update(s, "vm", V3)
          have q2bb: int_add(Q2, 0) in bits(64) by arith(q2e, hpe, eb, pl63)
          have q3bb: int_add(Q3, 0) in bits(64) by arith(q3e, hpe, eb, pl63)
          have w2W w2u := apply(ms.sw_st, {s}, {V0}, {B}, {int_add(Q2, 0)}, {2}, {W16}, hbw, hbu, q2bb)
          have w3W w3u := apply(ms.sw_st, {s}, {V0}, {B2}, {int_add(Q3, 0)}, {1}, {bits_of_int(8, idx)}, w2W, w2u, q3bb)
          have hdf4: int_le(int_add(FS, 8), int_sub(E, 4)) || int_le(int_add(int_sub(E, 4), SW), FS) by defs(simp(hdf), mallocng.IB)
          have fsw: FS in bits(64) by simp(expand(hw, abi.World))
