          have sP: sint(64, P) = P by defs(simp(hpb, pl63), sint)
          have al: int_le(A, E) && int_lt(A, 9223372036854775808) by arith(ae, ee, mulo, eb, swo)
          have ab: A in bits(64) by arith(ae, al, memb)
          have sA: sint(64, A) = A by defs(simp(ab, al), sint)
          have fs: tr.s64_fits(int_sub(sint(64, P), sint(64, A))) by defs(simp(sP, sA, al, hpe, pl63, ab, hpb), gimple.fits)
          // (p's header at P - 2, P - 3)
