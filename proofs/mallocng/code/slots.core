        have huw4: gimple.usable(V0, s.objs, int_sub(E, 4), SW, true) by defs(simp(huw), mallocng.IB)
        have ur3 := mp(all_elim(ms.usable_part, {V0}, {s.objs}, {int_sub(E, 4)}, {SW}, {int_add(P3, 0)}, {1}, {false}), arith(eo), arith(p3e, eo), arith(p3e), arith(p3e, hns4, hn), hur4)
        have md3: g.mem_defined(s, P3, 0, 1, false) by simp(ur3, p3e, eb, p64, eo)
