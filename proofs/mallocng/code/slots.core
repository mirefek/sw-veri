          let Q3 := int_add(P, gimple.sval(T64, bits_neg(64, 3)))
          have q2e: Q2 = int_sub(P, 2) by arith(svm2)
          have q3e: Q3 = int_sub(P, 3) by arith(svm3)
          have uq2 := mp(all_elim(ms.usable_part, {V0}, {s.objs}, {int_sub(E, 4)}, {SW}, {int_add(Q2, 0)}, {2}, {true}), arith(eo), arith(q2e, hpb), arith(q2e, hpe), arith(q2e, hpl, hn), huw4)
          have uq3 := mp(all_elim(ms.usable_part, {V0}, {s.objs}, {int_sub(E, 4)}, {SW}, {int_add(Q3, 0)}, {1}, {true}), arith(eo), arith(q3e, hpb), arith(q3e, hpe), arith(q3e, hpl, hn), huw4)
          have F3 := conj(F, md16b, hbw, hbu, hrd, m1e, ae, sP, sA, al, ab, fs, hpb, hpe, hpl, pl63, q2e, q3e, uq2, uq3)
          step c15 from c14 with g.ld64_det, g.padd_det, g.ssub64_det, ms.st16_det, ms.st8_det using F3
          // the call: set_size's contract on S3, the memory with p's header
