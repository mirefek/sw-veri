// The size classes and the bit functions: a_ctz_32, a_clz_32,
// size_to_class (their code by their memory-level specs), the size
// classes' table and values; word arithmetic without wrapping.

// ----------------------------------------------------------------------
//  size_to_class: from a_clz_32's contract (a_clz_32's own C2:
//  proofs/mallocng/code/classes.core)
// (a word not 0 has a leading-zero count: the least k with x < 2^k, then r = 32 - k)
theorem ms.clz_exists: all x. x in bits(32) -> !(x = 0) -> ex r. r in bits(32) && mallocng_specs.clz_of(x, r)
proof
  fix x
  assume hx hnz
  have p32: int_lt(x, pow2(32)) by simp(hx)
  have ex0: ex k. k in omega && int_lt(x, pow2(k)) by ex_intro({32}, taut((32 in omega by simp()), p32))
  obtain k, ko kl kmin from mp(nat_least[p := k. int_lt(x, pow2(k))], ex0)
  have k32: int_le(k, 32) := mp(all_elim(kmin, {32}), simp(), p32)
  have k1: int_le(1, k) proof
    have c: k = 0 -> false proof
      assume e
      have l := rewrite(e, kl)
      have p0: pow2(0) = 1 by simp()
      show by arith(rewrite(p0, l), hx, hnz)
    qed
    show by arith(c, ko)
  qed
  let j := int_sub(k, 1)
  have jo: j in omega by arith(ko, k1)
  have nj: !int_lt(x, pow2(j)) proof
    have c: int_lt(x, pow2(j)) -> false proof
      assume h
      have le := mp(all_elim(kmin, {j}), jo, h)
      show by arith(le, k1)
    qed
    show by taut(c)
  qed
  let r := int_sub(32, k)
  have e1: int_sub(31, r) = j by arith(ko)
  have e2: int_sub(32, r) = k by arith(ko)
  have rb: r in bits(32) by arith(ko, k1, k32)
  have g1: int_lt(r, 32) by arith(k1, ko)
  have g2: int_le(int_pow(2, int_sub(k, 1)), x) by arith(expand(nj, pow2))
  have g3: int_lt(x, int_pow(2, k)) := expand(kl, pow2)
  have c: mallocng_specs.clz_of(x, r) by defs(simp(e1, e2, g1, g2, g3), mallocng_specs.clz_of)
  show by ex_intro({r}, taut(rb, c))
qed

// a_clz_32's spec, its precondition holding: an overflow, or x's leading
// zeros returned, the world as it was
theorem ms.clz_spec_inv: all tbl x s o. x in bits(32) -> s in abi.World -> !(x = 0) ->
  mallocng_specs.table_ok(s.vm, s.objs, tbl, 1, mallocng.debruijn32_tab) -> abi.thread_ok(s.vm, s.fs_base) ->
  runs(mallocng_specs.a_clz_32_spec(tbl, x), s, o) ->
  (ex v. v in x86_64_linux.Vm && o = exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty))) || (ex r. r in bits(32) && mallocng_specs.clz_of(x, r) && o = ok(s, r))
proof
  fix tbl x s o
  assume hx hw hnz htb hth h
  have ce := apply(ms.clz_exists, hx, hnz)
  have vv: ex y. y in x86_64_linux.Vm by ex_intro({s.vm}, simp(expand(hw, abi.World)))
  show by simp(h, hnz, htb, hth, ce, vv, keep(mallocng_specs.table_ok, mallocng_specs.clz_of, abi.thread_ok))
qed

// a_clz_32's contract at a call a_clz_32(x) (its spec's register wrapper,
// on a world where its precondition holds): an overflow (the memory any),
// or the return, the memory as it was, the first register's low half x's
// leading zeros
theorem ms.clzs_q: all regs s tbl x o2. x in bits(32) -> s in abi.World -> s in univ(1) ->
  !(x = 0) -> mallocng_specs.table_ok(s.vm, s.objs, tbl, 1, mallocng.debruijn32_tab) -> abi.thread_ok(s.vm, s.fs_base) ->
  gc.regs_ok(regs, seq_one(gimple.arg(32, x))) ->
  runs(mallocng_specs.a_clz_32_spec_fun(tbl)[regs], s, o2) ->
  (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && mallocng_specs.clz_of(x, bits_of_int(32, fst(r))))
proof
  fix regs s tbl x o2
  assume hx hw hu hnz htb hth hr h
  let OVF := exc_val("stack_overflow", empty)
  have rl rn r0 := apply(gc.regs1_32, hx, hr)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, mallocng_specs.a_clz_32_spec_fun, app_fn_build, ra in h
  have vfun: is_fun(s) by simp(expand(hw, abi.World))
  have vdom: "vm" in dom(s) by simp(expand(hw, abi.World))
  have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], vfun, vdom)
  let G := (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(s, "vm", v), OVF)) || (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && mallocng_specs.clz_of(x, bits_of_int(32, fst(r))))
  // (one argument: the spec's run)
  have o1: ord_le(1, seq_len(regs)) by defs(simp(rn), ord_le)
  have b := rewrite(r0, apply(g.runs_elim, h))
  have b2: bind_rel(mallocng_specs.a_clz_32_spec(tbl, x), s, x3 x4. letin(x4, x5. bind_rel(gimple.result(32, x5), x3, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. o2 = ok(x6, pair(x8, x9)))),
      x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))), x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3)) by taut(b, o1)
  obtain o3, hs3 hk3 from expand(b2, bind_rel)
  have ci := apply(ms.clz_spec_inv, hx, hw, hnz, htb, hth, hs3)
  have c1: (ex v. v in x86_64_linux.Vm && o3 = exc(fn_update(s, "vm", v), OVF)) -> G proof
    assume e
    obtain v, hv he from e
    have oe: o2 = exc(fn_update(s, "vm", v), OVF) by simp(rewrite(he, hk3))
    have l: ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(s, "vm", v), OVF) by ex_intro({v}, taut(hv, oe))
    show by taut(l)
  qed
  have c2: (ex r. r in bits(32) && mallocng_specs.clz_of(x, r) && o3 = ok(s, r)) -> G proof
    assume e
    obtain r, hr32 hc he from e
    have k1: bind_rel(gimple.result(32, r), s, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. o2 = ok(x6, pair(x8, x9)))), x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))
      by simp(expand(rewrite(he, hk3), letin), keep(bind_rel, gimple.result))
    obtain o4, hr4 hk4 from expand(k1, bind_rel)
    obtain u, hu64 hlow ho4 from apply(g.result32_inv, hr32, hr4)
    have k2: any_rel(x9. x9 in bits(64), x9. o2 = ok(s, pair(u, x9))) by simp(expand(rewrite(ho4, hk4), letin), keep(any_rel))
    have ne: ex y. y in bits(64) by ex_intro({0}, simp())
    obtain y, hy hoy from apply(g.any_e, ne, k2)
    have cl: mallocng_specs.clz_of(x, bits_of_int(32, fst(pair(u, y)))) by simp(hlow, hc)
    have l: ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && mallocng_specs.clz_of(x, bits_of_int(32, fst(r))) by ex_intro({pair(u, y)}, taut(rewrite(sym(ss), hoy), cl))
    show by taut(l)
  qed
  show by taut(ci, c1, c2)
qed

// ----------------------------------------------------------------------
//  A table's entry i (2 bytes each, at t; table_ok): its address
//  (GIMPLE's elem with the index sign-extended) and the load's one
//  outcome, the list's entry
theorem ms.tab_rd: all s t I tab. s in univ(1) -> t in bits(64) -> !(t = 0) -> I in bits(32) -> int_le(0, sint(32, I)) -> int_lt(sint(32, I), seq_len(tab)) ->
  mallocng_specs.table_ok(s.vm, s.objs, t, 2, tab) ->
  g.det(gimple.elem(t, bits_sext(32, 64, I), 2), s, ok(s, bits_add(64, t, bits_add(64, bits_sext(32, 64, I), bits_sext(32, 64, I))))) &&
  g.det(gimple.ld16(bits_add(64, t, bits_add(64, bits_sext(32, 64, I), bits_sext(32, 64, I))), 0), s, ok(s, bits_of_int(16, tab[sint(32, I)])))
proof
  fix s t I tab
  assume hs ht hnz hI h0 hl htab
  let i := sint(32, I)
  let A := bits_add(64, t, bits_add(64, bits_sext(32, 64, I), bits_sext(32, 64, I)))
  have io: i in omega by arith(h0)
  have tu tb := mp(all_elim(expand(htab, mallocng_specs.table_ok), {i}), io, hl)
  // (the entry's address: in range, t + 2i)
  have t0: int_le(0, t) by simp(ht)
  have ud := apply(tr.usable_dom, {s.vm}, {s.objs}, {int_add(t, int_mul(2, i))}, {2}, {false}, {1}, tu, arith(t0, h0), simp(), simp())
  have rng: int_lt(int_add(int_add(t, int_mul(2, i)), 1), 18446744073709551616) by taut(ud)
  have sv := mp(tr.sext_vals, {I}, hI)
  have xd: bits_sext(32, 64, I) = int_mod(i, 18446744073709551616) by defs(simp(), bits_sext, bits_of_int, pow2)
  have ea: A = int_add(t, int_mul(2, i)) by defs(arith(xd, rng, h0, t0, ht), bits_add, pow2)
  have def: tr.elem2_sx_def(t, I) by arith(rng, h0, t0)
  have ed := apply(g.elem2_sx_det, {s}, {t}, {I}, hs, ht, hI, def)
  // (the load: its bytes the entry's)
  have ab: A in bits(64) by simp()
  have e0: int_add(A, 0) = int_add(t, int_mul(2, i)) by arith(ea)
  have md: g.mem_defined(s, A, 0, 2, false) by simp(e0, tu, rng, hnz, ea, t0, h0, ht)
  have ld := apply(g.ld16_det, {s}, {A}, {0}, hs, ab, simp(), md)
  have be: bits_of_int(64, int_add(t, int_mul(2, i))) = int_add(A, 0) by defs(arith(e0, rng, h0, t0), bits_of_int, pow2)
  have tb2 := rewrite(be, tb)
  have ld2 := rewrite(tb2, ld)
  show by taut(ed, ld2)
qed

// ----------------------------------------------------------------------
//  The size classes (layers/mallocng.sl's size_classes): their values,
//  increasing
theorem ms.sc_lit: mallocng.size_classes = seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(1), seq_one(2)), seq_one(3)), seq_one(4)), seq_one(5)), seq_one(6)), seq_one(7)), seq_one(8)), seq_one(9)), seq_one(10)), seq_one(12)), seq_one(15)), seq_one(18)), seq_one(20)), seq_one(25)), seq_one(31)), seq_one(36)), seq_one(42)), seq_one(50)), seq_one(63)), seq_one(72)), seq_one(84)), seq_one(102)), seq_one(127)), seq_one(146)), seq_one(170)), seq_one(204)), seq_one(255)), seq_one(292)), seq_one(340)), seq_one(409)), seq_one(511)), seq_one(584)), seq_one(682)), seq_one(818)), seq_one(1023)), seq_one(1169)), seq_one(1364)), seq_one(1637)), seq_one(2047)), seq_one(2340)), seq_one(2730)), seq_one(3276)), seq_one(4095)), seq_one(4680)), seq_one(5460)), seq_one(6552)), seq_one(8191))
proof
  show by defs(refl({seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(1), seq_one(2)), seq_one(3)), seq_one(4)), seq_one(5)), seq_one(6)), seq_one(7)), seq_one(8)), seq_one(9)), seq_one(10)), seq_one(12)), seq_one(15)), seq_one(18)), seq_one(20)), seq_one(25)), seq_one(31)), seq_one(36)), seq_one(42)), seq_one(50)), seq_one(63)), seq_one(72)), seq_one(84)), seq_one(102)), seq_one(127)), seq_one(146)), seq_one(170)), seq_one(204)), seq_one(255)), seq_one(292)), seq_one(340)), seq_one(409)), seq_one(511)), seq_one(584)), seq_one(682)), seq_one(818)), seq_one(1023)), seq_one(1169)), seq_one(1364)), seq_one(1637)), seq_one(2047)), seq_one(2340)), seq_one(2730)), seq_one(3276)), seq_one(4095)), seq_one(4680)), seq_one(5460)), seq_one(6552)), seq_one(8191))}), mallocng.size_classes)
qed

theorem ms.sc_vals: mallocng.size_classes[0] = 1 && mallocng.size_classes[1] = 2 && mallocng.size_classes[2] = 3 && mallocng.size_classes[3] = 4 && mallocng.size_classes[4] = 5 && mallocng.size_classes[5] = 6 && mallocng.size_classes[6] = 7 && mallocng.size_classes[7] = 8 && mallocng.size_classes[8] = 9 && mallocng.size_classes[9] = 10 && mallocng.size_classes[10] = 12 && mallocng.size_classes[11] = 15 && mallocng.size_classes[12] = 18 && mallocng.size_classes[13] = 20 && mallocng.size_classes[14] = 25 && mallocng.size_classes[15] = 31 && mallocng.size_classes[16] = 36 && mallocng.size_classes[17] = 42 && mallocng.size_classes[18] = 50 && mallocng.size_classes[19] = 63 && mallocng.size_classes[20] = 72 && mallocng.size_classes[21] = 84 && mallocng.size_classes[22] = 102 && mallocng.size_classes[23] = 127 && mallocng.size_classes[24] = 146 && mallocng.size_classes[25] = 170 && mallocng.size_classes[26] = 204 && mallocng.size_classes[27] = 255 && mallocng.size_classes[28] = 292 && mallocng.size_classes[29] = 340 && mallocng.size_classes[30] = 409 && mallocng.size_classes[31] = 511 && mallocng.size_classes[32] = 584 && mallocng.size_classes[33] = 682 && mallocng.size_classes[34] = 818 && mallocng.size_classes[35] = 1023 && mallocng.size_classes[36] = 1169 && mallocng.size_classes[37] = 1364 && mallocng.size_classes[38] = 1637 && mallocng.size_classes[39] = 2047 && mallocng.size_classes[40] = 2340 && mallocng.size_classes[41] = 2730 && mallocng.size_classes[42] = 3276 && mallocng.size_classes[43] = 4095 && mallocng.size_classes[44] = 4680 && mallocng.size_classes[45] = 5460 && mallocng.size_classes[46] = 6552 && mallocng.size_classes[47] = 8191
proof
  have a0 := rewrite(sym(ms.sc_lit), at({seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(1), seq_one(2)), seq_one(3)), seq_one(4)), seq_one(5)), seq_one(6)), seq_one(7)), seq_one(8)), seq_one(9)), seq_one(10)), seq_one(12)), seq_one(15)), seq_one(18)), seq_one(20)), seq_one(25)), seq_one(31)), seq_one(36)), seq_one(42)), seq_one(50)), seq_one(63)), seq_one(72)), seq_one(84)), seq_one(102)), seq_one(127)), seq_one(146)), seq_one(170)), seq_one(204)), seq_one(255)), seq_one(292)), seq_one(340)), seq_one(409)), seq_one(511)), seq_one(584)), seq_one(682)), seq_one(818)), seq_one(1023)), seq_one(1169)), seq_one(1364)), seq_one(1637)), seq_one(2047)), seq_one(2340)), seq_one(2730)), seq_one(3276)), seq_one(4095)), seq_one(4680)), seq_one(5460)), seq_one(6552)), seq_one(8191))[0]}))
  have a1 := rewrite(sym(ms.sc_lit), at({seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(1), seq_one(2)), seq_one(3)), seq_one(4)), seq_one(5)), seq_one(6)), seq_one(7)), seq_one(8)), seq_one(9)), seq_one(10)), seq_one(12)), seq_one(15)), seq_one(18)), seq_one(20)), seq_one(25)), seq_one(31)), seq_one(36)), seq_one(42)), seq_one(50)), seq_one(63)), seq_one(72)), seq_one(84)), seq_one(102)), seq_one(127)), seq_one(146)), seq_one(170)), seq_one(204)), seq_one(255)), seq_one(292)), seq_one(340)), seq_one(409)), seq_one(511)), seq_one(584)), seq_one(682)), seq_one(818)), seq_one(1023)), seq_one(1169)), seq_one(1364)), seq_one(1637)), seq_one(2047)), seq_one(2340)), seq_one(2730)), seq_one(3276)), seq_one(4095)), seq_one(4680)), seq_one(5460)), seq_one(6552)), seq_one(8191))[1]}))
