// (ms.stc_big with the code's choices as outcomes: the first i1, the
// class K)
theorem ms.stc_fin: all n c i1 k. n in omega -> int_le(n, 131052) -> !int_le(int_div(int_add(n, 3), 16), 9) -> c in omega ->
  mallocng_specs.clz_of(int_add(int_div(int_add(n, 3), 16), 1), c) ->
  (i1 = int_add(int_mul(4, int_sub(30, c)), 2) && int_lt(mallocng.size_classes[int_add(int_mul(4, int_sub(30, c)), 1)], int_add(int_div(int_add(n, 3), 16), 1))) ||
  (i1 = int_mul(4, int_sub(30, c)) && !int_lt(mallocng.size_classes[int_add(int_mul(4, int_sub(30, c)), 1)], int_add(int_div(int_add(n, 3), 16), 1))) ->
  (k = int_add(i1, 1) && int_lt(mallocng.size_classes[i1], int_add(int_div(int_add(n, 3), 16), 1))) ||
  (k = i1 && !int_lt(mallocng.size_classes[i1], int_add(int_div(int_add(n, 3), 16), 1))) ->
  mallocng_specs.class_of(n, k)
proof
  fix n c i1 k
  assume hn h131 hbig hc hz h1 h2
  have a1: int_lt(mallocng.size_classes[int_add(int_mul(4, int_sub(30, c)), 1)], int_add(int_div(int_add(n, 3), 16), 1)) -> i1 = int_add(int_mul(4, int_sub(30, c)), 2) by taut(h1)
  have a2: !int_lt(mallocng.size_classes[int_add(int_mul(4, int_sub(30, c)), 1)], int_add(int_div(int_add(n, 3), 16), 1)) -> i1 = int_mul(4, int_sub(30, c)) by taut(h1)
  have b1: int_lt(mallocng.size_classes[i1], int_add(int_div(int_add(n, 3), 16), 1)) -> k = int_add(i1, 1) by taut(h2)
  have b2: !int_lt(mallocng.size_classes[i1], int_add(int_div(int_add(n, 3), 16), 1)) -> k = i1 by taut(h2)
  show := apply(ms.stc_big, hn, h131, hbig, hc, hz, a1, a2, b1, b2)
qed

// (multiplying by 4: GIMPLE's signed product's low half, the unsigned one)
theorem ms.imul_4: tr.imul_by(4)
proof
  have g: all y. y in bits(32) -> bits_add(32, int_mul(sint(32, y), sint(32, 4)), 0) = bits_mul(32, y, 4) proof
    fix y
    assume hy: y in bits(32)
    have c1: int_lt(y, 2147483648) -> bits_add(32, int_mul(sint(32, y), 4), 0) = bits_mul(32, y, 4) proof
      assume hl: int_lt(y, 2147483648)
      show by defs(simp(hy, hl), bits_add, bits_mul, sint)
    qed
    have c2: !int_lt(y, 2147483648) -> bits_add(32, int_mul(sint(32, y), 4), 0) = bits_mul(32, y, 4) proof
      assume hl: !int_lt(y, 2147483648)
      have e: int_mod(int_mul(int_sub(y, 4294967296), 4), 4294967296) = int_mod(int_mul(y, 4), 4294967296) by arith(hy)
      show by defs(simp(hy, hl, e), bits_add, bits_mul, sint)
    qed
    have e: bits_add(32, int_mul(sint(32, y), 4), 0) = bits_mul(32, y, 4) by taut(c1, c2)
    show by simp(e)
  qed
  show by defs(g, tr.imul_by)
qed

// (a small non-negative word: its signed value itself)
theorem ms.sint_small: all v. v in omega -> int_lt(v, 2147483648) -> sint(32, v) = v
proof
  fix v
  assume hv hl
  have b: bits_of_int(32, v) = v by defs(arith(hv, hl), bits_of_int, pow2)
  show by defs(simp(b, hv, hl), sint, pow2)
qed

// size_to_class's contract from a_clz_32's: for every callee refining
// a_clz_32's spec (as a C function value), size_to_class's readable GIMPLE
// refines its spec
theorem ms.size_to_class_c2: all n g tbl. n in bits(64) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(g[regs], s, o) -> runs(mallocng_specs.a_clz_32_spec_fun(tbl)[regs], s, o)) ->
  refines(c_src_malloc_mallocng_malloc.size_to_class(n, g), mallocng_specs.size_to_class_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, tbl, n), abi.World)
proof
  fix n g tbl
  assume hn hg
  show proof
    fix s o
    assume hw hr
    let SCT := c_src_malloc_mallocng_malloc.__malloc_size_classes
    let SC := mallocng.size_classes
    let SPEC := mallocng_specs.size_to_class_spec(SCT, tbl, n)
    let OVF := exc_val("stack_overflow", empty)
    have pu := apply(g.runs_univ, hr)
    have hu: s in univ(1) by simp(pu)
    have vV vfun vdom .. := apply(ms.world_parts, hw)
    have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], vfun, vdom)
    have no: n in omega by simp(hn)
    let PRE := ((int_le(n, 131052) && mallocng_specs.table_ok(s.vm, s.objs, SCT, 2, SC)) && mallocng_specs.table_ok(s.vm, s.objs, tbl, 1, mallocng.debruijn32_tab)) &&
      abi.thread_ok(s.vm, s.fs_base)
    have np: !PRE -> runs(SPEC, s, o) proof
      assume hn2
      show by simp(pu, hn2, keep(abi.overflow, mallocng_specs.table_ok, mallocng_specs.class_of, abi.thread_ok))
    qed
    have yp: PRE -> runs(SPEC, s, o) proof
      assume hp
      have h131 hsct htbl hth := hp
      // (the spec's outcomes: an overflow, any memory; a class of n)
      have sov: all v. v in x86_64_linux.Vm -> runs(SPEC, s, exc(fn_update(s, "vm", v), OVF)) proof
        fix v
        assume hv
        have vu := apply(x86.vm_univ, hv)
        have eu: OVF in univ(1) by defs(simp(), exc_val)
        have pu2: pair(s, exc(fn_update(s, "vm", v), OVF)) in univ(1) by simp(hu, vu, eu)
        have ovi := apply(ct.overflow_intro, hv, pu2)
        show by simp(hp, ovi, pu2, keep(abi.overflow, mallocng_specs.table_ok, mallocng_specs.class_of, abi.thread_ok))
      qed
      have sret: all c. c in bits(32) -> mallocng_specs.class_of(n, c) -> runs(SPEC, s, ok(s, c)) proof
        fix c
        assume hc hcl
        have pu2: pair(s, ok(s, c)) in univ(1) by simp(hu, hc)
        show by simp(hp, hc, hcl, pu2, keep(abi.overflow, mallocng_specs.table_ok, mallocng_specs.class_of, abi.thread_ok))
      qed
      // the locals' choices, then n's units Q
      // n's units Q
      let Q := bits_shr(64, bits_add(64, n, 3), 4)
      have p64: pow2(64) = 18446744073709551616 by simp()
      have p4: pow2(4) = 16 by simp()
      have m3: int_mod(int_add(n, 3), 18446744073709551616) = int_add(n, 3) by arith(no, h131)
      have ba: bits_add(64, n, 3) = int_add(n, 3) by defs(rewrite(sym(p64), m3), bits_add)
      have bo: bits_of_int(64, int_add(n, 3)) = int_add(n, 3) by defs(rewrite(sym(p64), m3), bits_of_int)
      have qe: Q = int_div(int_add(n, 3), 16) by defs(simp(ba, bo, p4), bits_shr)
      have qo: Q in omega by arith(qe, no)
      // at most 10 units: the class Q
      have small: int_le(Q, 9) -> runs(SPEC, s, o) proof
        assume hq
        step a3 a5 a7 a9 x13, oe from hr with hq
        have bq: bits_of_int(32, Q) = Q by defs(arith(qo, hq), bits_of_int, pow2)
        have cl := apply(ms.stc_small, no, rewrite(qe, hq))
        have r := mp(all_elim(sret, {Q}), arith(qo, hq), rewrite(sym(qe), cl))
        show := rewrite(sym(rewrite(bq, oe)), r)
      qed
      // more: a_clz_32 of the units N = Q + 1, the bucket's classes
      have big: !int_le(Q, 9) -> runs(SPEC, s, o) proof
        assume hq
        step a3 a5 a7 a9 x13, b from hr with hq
        let N := bits_add(64, Q, 1)
        have q131: int_le(Q, 8190) by arith(qe, no, h131)
        have mq: int_mod(int_add(Q, 1), 18446744073709551616) = int_add(Q, 1) by arith(qo, q131)
        have nq: N = int_add(Q, 1) by defs(rewrite(sym(p64), mq), bits_add)
        let X := bits_of_int(32, N)
        have p32: pow2(32) = 4294967296 by simp()
        have mx: int_mod(N, 4294967296) = N by arith(nq, qo, q131)
        have xn: X = N by defs(rewrite(sym(p32), mx), bits_of_int)
        have xb: X in bits(32) by simp()
        have xo: X in omega by simp()
        have x11: int_le(11, X) by arith(xn, nq, hq)
        have x8k: int_le(X, 8191) by arith(xn, nq, q131)
        have xnz: !(X = 0) by arith(x11, xo)
        // the call: a_clz_32's contract
        have qa: all regs o2. gc.regs_ok(regs, seq_one(gimple.arg(32, X))) -> runs(mallocng_specs.a_clz_32_spec_fun(tbl)[regs], s, o2) ->
            (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(s, "vm", v), OVF)) || (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && mallocng_specs.clz_of(X, bits_of_int(32, fst(r)))) proof
          fix regs o2
          assume hro h2
          show := apply(ms.clzs_q, xb, hw, hu, xnz, htbl, hth, hro, h2)
        qed
        have ths: gc.sound(s) by simp(hth)
        have cc := apply(gc.contract_call1[R := r. mallocng_specs.clz_of(X, bits_of_int(32, fst(r)))], {g}, {mallocng_specs.a_clz_32_spec_fun(tbl)}, {seq_one(gimple.arg(32, X))}, {s}, {s.vm},
          ths, hw, vV, apply(gc.regs1_32_ex, xb), (int_le(seq_len(seq_one(gimple.arg(32, X))), 6) by simp()), hg, qa, b)
        have cov: (ex v. v in x86_64_linux.Vm && o = exc(fn_update(s, "vm", v), OVF)) -> runs(SPEC, s, o) proof
          assume h
          obtain v, hv ho from h
          show := rewrite(sym(ho), mp(all_elim(sov, {v}), hv))
        qed
        // the count C returned: the bucket's index I, its two lookups
        have cok: case 2 of cc proof
          assume h
          obtain r, hR hk from h
          let C := bits_of_int(32, fst(r))
          let I0 := int_mul(4, int_sub(30, C))
          let U := int_add(int_div(int_add(n, 3), 16), 1)
          have hk2 := rewrite(ss, hk)
          have cb: C in bits(32) by simp()
          have co: C in omega by simp()
          have c19 c28 := apply(ms.stc_bounds, xo, x11, x8k, co, hR)
          have ue: N = U by simp(nq, qe)
          have hRU: mallocng_specs.clz_of(U, C) := rewrite(ue, rewrite(xn, hR))
          have sctb: SCT in bits(64) by defs(simp(), c_src_malloc_mallocng_malloc.__malloc_size_classes)
          have sctnz: !(SCT = 0) by defs(simp(), c_src_malloc_mallocng_malloc.__malloc_size_classes)
          // 30 - C
          have b30: bits_of_int(32, 30) = 30 by simp()
          have sC := apply(ms.sint_small, co, (int_lt(C, 2147483648) by arith(c28, co)))
          have f1: tr.s32_fits(int_sub(sint(32, bits_of_int(32, 30)), sint(32, C))) by defs(simp(b30, sC, c19, c28, co), gimple.fits)
          have sd := apply(g.ssub32_det, {s}, {bits_of_int(32, 30)}, {C}, hu, simp(), cb, f1)
          let T4 := bits_sub(32, bits_of_int(32, 30), C)
          have m4: int_mod(int_sub(30, C), 4294967296) = int_sub(30, C) by arith(c28, co)
          have t4e: T4 = int_sub(30, C) by defs(simp(b30, rewrite(sym(p32), m4)), bits_sub)
          have t4b: T4 in bits(32) by simp()
          have sT0 := apply(ms.sint_small, (int_sub(30, C) in omega by arith(c28, co)), (int_lt(int_sub(30, C), 2147483648) by arith(co)))
          have sT: sint(32, T4) = int_sub(30, C) by simp(t4e, sT0)
          // I = 4 (30 - C)
          have f2: tr.s32_fits(int_mul(sint(32, T4), sint(32, 4))) by defs(simp(sT, c19, c28, co), gimple.fits)
          have md := apply(g.smul32_det, {s}, {T4}, {4}, hu, t4b, simp(), ms.imul_4, f2)
          let I := bits_mul(32, T4, 4)
          have mI: int_mod(int_mul(int_sub(30, C), 4), 4294967296) = I0 by arith(c19, c28, co)
          have ie: I = I0 by defs(simp(t4e, rewrite(sym(p32), mI)), bits_mul)
          have ib: I in bits(32) by simp()
          have sI0 := apply(ms.sint_small, (I0 in omega by arith(c28, co)), (int_lt(I0, 2147483648) by arith(co)))
          have sI: sint(32, I) = I0 by simp(ie, sI0)
          // I + 1, the first lookup
          have f3: tr.s32_fits(int_add(sint(32, I), sint(32, 1))) by defs(simp(sI, c19, c28, co), gimple.fits)
          have ad := apply(g.sadd32_det, {s}, {I}, {1}, hu, ib, simp(), f3)
          let I1 := bits_add(32, I, 1)
          have m1: int_mod(int_add(I0, 1), 4294967296) = int_add(I0, 1) by arith(c19, c28, co)
          have i1e: I1 = int_add(I0, 1) by defs(simp(ie, rewrite(sym(p32), m1)), bits_add)
          have i1b: I1 in bits(32) by simp()
          have sI10 := apply(ms.sint_small, (int_add(I0, 1) in omega by arith(c28, co)), (int_lt(int_add(I0, 1), 2147483648) by arith(co)))
          have sI1: sint(32, I1) = int_add(I0, 1) by simp(i1e, sI10)
          have rd1 ld1 := apply(ms.tab_rd, {s}, {SCT}, {I1}, {SC}, hu, sctb, sctnz, i1b, (int_le(0, sint(32, I1)) by arith(sI1, co, c28)),
            (int_lt(sint(32, I1), seq_len(SC)) by arith(sI1, ms.sc_len, c19, co)), hsct)
          step x17, hx17 hk17 from hk2 with sd, md, ad, rd1, ld1
          // (a table entry: a 16-bit value, itself)
          have p16: pow2(16) = 65536 by simp()
          have ent: all j. j in omega -> int_lt(j, 48) -> bits_of_int(16, SC[j]) = SC[j] proof
            fix j
            assume hj hj48
            have so sl := apply(ms.sc_nat, hj, hj48)
            have m: int_mod(SC[j], 65536) = SC[j] by arith(so, sl)
            show by defs(rewrite(sym(p16), m), bits_of_int)
          qed
          // the second lookup at J, and the class: J + 1 or J
          have fin: all J. J in bits(32) -> int_le(0, sint(32, J)) -> int_lt(sint(32, J), 48) -> x17 = ok(pair(s, pair(N, pair(J, pair(a5, pair(a7, a9))))), empty) ->
              (int_lt(SC[sint(32, J)], U) && o = ok(s, bits_add(32, J, 1))) || (!int_lt(SC[sint(32, J)], U) && o = ok(s, J)) proof
            fix J
            assume hJ hJ0 hJ48 hx
            let P := pair(s, pair(N, pair(J, pair(a5, pair(a7, a9)))))
            have os2 := all_elim(g.ok_state, {P}, {empty})
            have rd2 ld2 := apply(ms.tab_rd, {s}, {SCT}, {J}, {SC}, hu, sctb, sctnz, hJ, hJ0, (int_lt(sint(32, J), seq_len(SC)) by arith(hJ48, ms.sc_len)), hsct)
            step x24, hx24 hk24 from rewrite(hx, hk17) with rd2, ld2
            have ve := mp(all_elim(ent, {sint(32, J)}), (sint(32, J) in omega by arith(hJ0)), hJ48)
            have ve2: bits_of_int(16, SC[sint(32, J)]) = SC[sint(32, J)] := ve
            have bB: int_lt(SC[sint(32, J)], U) -> o = ok(s, bits_add(32, J, 1)) proof
              assume hb
              have hb2: int_lt(bits_of_int(16, SC[sint(32, J)]), N) by simp(hb, ve2, ue)
              have p1 := apply(g.pick, hx24, hb2, (!!int_lt(bits_of_int(16, SC[sint(32, J)]), N) by taut(hb2)))
              have f4: tr.s32_fits(int_add(sint(32, J), sint(32, 1))) by defs(simp(hJ0, hJ48), gimple.fits)
              have ad2 := apply(g.sadd32_det, {s}, {J}, {1}, hu, hJ, simp(), f4)
              have e24 := apply(g.letin_e, apply(g.bind_inv, p1, ad2))
              show by simp(rewrite(e24, hk24))
            qed
            have bb: !int_lt(SC[sint(32, J)], U) -> o = ok(s, J) proof
              assume hb
              have hb2: !int_lt(bits_of_int(16, SC[sint(32, J)]), N) by simp(hb, ve2, ue)
              have e24 := apply(g.pick2, hx24, hb2, hb2)
              show by simp(rewrite(e24, hk24))
            qed
            have cs: int_lt(SC[sint(32, J)], U) || !int_lt(SC[sint(32, J)], U) by taut()
            show by taut(cs, bB, bb)
          qed
          // the first comparison: J = I + 2 or I
          have v1: bits_of_int(16, SC[sint(32, I1)]) = SC[int_add(I0, 1)] by simp(sI1, mp(all_elim(ent, {int_add(I0, 1)}), arith(co, c28), arith(co, c19)))
          have os := all_elim(g.ok_state, {pair(s, pair(Q, pair(a3, pair(a5, pair(a7, a9)))))}, {empty})
          // (the class K: J's outcome, a class of n)
          have done: all J. J in bits(32) -> int_le(0, sint(32, J)) -> int_lt(sint(32, J), 48) ->
              ((sint(32, J) = int_add(I0, 2) && int_lt(SC[int_add(I0, 1)], U)) || (sint(32, J) = I0 && !int_lt(SC[int_add(I0, 1)], U))) ->
              x17 = ok(pair(s, pair(N, pair(J, pair(a5, pair(a7, a9))))), empty) -> runs(SPEC, s, o) proof
            fix J
            assume hJ hJ0 hJ48 hj hx
            have fr := apply(fin, hJ, hJ0, hJ48, hx)
            have kA: int_lt(SC[sint(32, J)], U) && o = ok(s, bits_add(32, J, 1)) -> runs(SPEC, s, o) proof
              assume hc
              have hl ho := hc
              have mk: int_mod(int_add(sint(32, J), 1), 4294967296) = int_add(sint(32, J), 1) by arith(hJ0, hJ48)
              have sv: sint(32, J) = J || sint(32, J) = int_sub(J, 4294967296) by defs(simp(hJ), sint)
              have sJ: sint(32, J) = J by arith(sv, hJ0, hJ)
              have kv: bits_add(32, J, 1) = int_add(sint(32, J), 1) by defs(simp(sJ, rewrite(sym(p32), mk)), bits_add)
              have cl := apply(ms.stc_fin, {n}, {C}, {sint(32, J)}, {int_add(sint(32, J), 1)}, no, h131, rewrite(qe, hq), co, hRU, hj, (int_add(sint(32, J), 1) = int_add(sint(32, J), 1) && int_lt(SC[sint(32, J)], U) || (int_add(sint(32, J), 1) = sint(32, J) && !int_lt(SC[sint(32, J)], U)) by taut(hl, refl({int_add(sint(32, J), 1)}))))
              have r2 := mp(all_elim(sret, {bits_add(32, J, 1)}), simp(), rewrite(sym(kv), cl))
              show := rewrite(sym(ho), r2)
            qed
            have kB: !int_lt(SC[sint(32, J)], U) && o = ok(s, J) -> runs(SPEC, s, o) proof
              assume hc
              have hl ho := hc
              have sv: sint(32, J) = J || sint(32, J) = int_sub(J, 4294967296) by defs(simp(hJ), sint)
              have sJ: sint(32, J) = J by arith(sv, hJ0, hJ)
              have cl := apply(ms.stc_fin, {n}, {C}, {sint(32, J)}, {sint(32, J)}, no, h131, rewrite(qe, hq), co, hRU, hj, (sint(32, J) = int_add(sint(32, J), 1) && int_lt(SC[sint(32, J)], U) || (sint(32, J) = sint(32, J) && !int_lt(SC[sint(32, J)], U)) by taut(hl, refl({sint(32, J)}))))
              have r2 := mp(all_elim(sret, {J}), hJ, rewrite(sJ, cl))
              show := rewrite(sym(ho), r2)
            qed
            show by taut(fr, kA, kB)
          qed
          have bA: int_lt(SC[int_add(I0, 1)], U) -> runs(SPEC, s, o) proof
            assume hA
            have hA2: int_lt(bits_of_int(16, SC[sint(32, I1)]), N) by simp(hA, v1, ue)
            have p1 := apply(g.pick, hx17, hA2, (!!int_lt(bits_of_int(16, SC[sint(32, I1)]), N) by taut(hA2)))
            have f5: tr.s32_fits(int_add(sint(32, I), sint(32, 2))) by defs(simp(sI, c19, c28, co), gimple.fits)
            have ad3 := apply(g.sadd32_det, {s}, {I}, {2}, hu, ib, simp(), f5)
            let I2 := bits_add(32, I, 2)
            have e17 := apply(g.letin_e, apply(g.bind_inv, p1, ad3))
            have e17b: x17 = ok(pair(s, pair(N, pair(I2, pair(a5, pair(a7, a9))))), empty) by simp(e17, os)
            have m2: int_mod(int_add(I0, 2), 4294967296) = int_add(I0, 2) by arith(c19, c28, co)
            have i2e: I2 = int_add(I0, 2) by defs(simp(ie, rewrite(sym(p32), m2)), bits_add)
            have sI20 := apply(ms.sint_small, (int_add(I0, 2) in omega by arith(c28, co)), (int_lt(int_add(I0, 2), 2147483648) by arith(co)))
            have sI2: sint(32, I2) = int_add(I0, 2) by simp(i2e, sI20)
            show := apply(done, {I2}, simp(), arith(sI2, co, c28), arith(sI2, co, c19), (sint(32, I2) = int_add(I0, 2) && int_lt(SC[int_add(I0, 1)], U) || (sint(32, I2) = I0 && !int_lt(SC[int_add(I0, 1)], U)) by taut(sI2, hA)), e17b)
          qed
          have ba: !int_lt(SC[int_add(I0, 1)], U) -> runs(SPEC, s, o) proof
            assume ha
            have ha2: !int_lt(bits_of_int(16, SC[sint(32, I1)]), N) by simp(ha, v1, ue)
            have e17 := apply(g.pick2, hx17, ha2, ha2)
            have e17b: x17 = ok(pair(s, pair(N, pair(I, pair(a5, pair(a7, a9))))), empty) by simp(e17, os)
            show := apply(done, {I}, ib, arith(sI, co, c28), arith(sI, co, c19), (sint(32, I) = int_add(I0, 2) && int_lt(SC[int_add(I0, 1)], U) || (sint(32, I) = I0 && !int_lt(SC[int_add(I0, 1)], U)) by taut(sI, ha)), e17b)
          qed
          have cA: int_lt(SC[int_add(I0, 1)], U) || !int_lt(SC[int_add(I0, 1)], U) by taut()
          show by taut(cA, bA, ba)
        qed
        show by taut(cc, cov, cok)
      qed
      have cq: int_le(Q, 9) || !int_le(Q, 9) by taut()
      show by taut(cq, small, big)
    qed
    show by taut(np, yp)
  qed
qed

// size_to_class as a C function value: its register wrapper refines the
// spec's (for every callee refining a_clz_32's)
theorem ms.size_to_class_fun_c2: all g tbl. (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(g[regs], s, o) -> runs(mallocng_specs.a_clz_32_spec_fun(tbl)[regs], s, o)) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
    runs(c_src_malloc_mallocng_malloc.size_to_class_fun(g)[regs], s, o) -> runs(mallocng_specs.size_to_class_spec_fun(c_src_malloc_mallocng_malloc.__malloc_size_classes, tbl)[regs], s, o))
proof
  fix g tbl
  assume hg
  have hm: all regs. refines(c_src_malloc_mallocng_malloc.size_to_class(bits_of_int(64, regs[0]), g), mallocng_specs.size_to_class_spec(c_src_malloc_mallocng_malloc.__malloc_size_classes, tbl, bits_of_int(64, regs[0])), abi.World) proof
    fix regs
    show := mp(all_elim(ms.size_to_class_c2, {bits_of_int(64, regs[0])}, {g}, {tbl}), simp(), hg)
  qed
  show by defs(apply(g.fun_res[n := 1, w := 32], hm), c_src_malloc_mallocng_malloc.size_to_class_fun, mallocng_specs.size_to_class_spec_fun, letin)
qed

// ----------------------------------------------------------------------
//  Trailing zeros
// tz(x), x != 0 an n-bit word: below n, x's lowest set bit
theorem ms.tz_low: all x n. n in omega -> int_le(n, 128) -> x in bits(n) -> !(x = 0) ->
  gimple.tz(x) in omega && int_lt(gimple.tz(x), n) && bit(x, gimple.tz(x)) && (all j. j in omega -> int_lt(j, gimple.tz(x)) -> !bit(x, j))
proof
  fix x n
  assume hn h128 hx hnz
  have xo: x in omega by arith(hx, hn)
  // some bit of x below n is set (else x = 0)
  have some: ex a. a in omega && int_lt(a, n) && bit(x, a) proof
    have nb: !(ex a. a in omega && int_lt(a, n) && bit(x, a)) -> false proof
      assume h
      have none: all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(0, i)) proof
        fix i
        assume hi hl
        have nb: !bit(x, i) proof
          assume b
          have e: ex a. a in omega && int_lt(a, n) && bit(x, a) by ex_intro({i}, conj(hi, hl, b))
          show by taut(e, h)
        qed
        show by taut(nb, mp(bit_zero_none[j := i], hi))
      qed
      have z0: 0 in bits(n) by arith(hn)
      have z := mp(all_elim(mp(all_elim(bits_ext, {n}), hn), {x}, {0}), hx, z0, none)
      show by taut(z, hnz)
    qed
    show by taut(nb)
  qed
  obtain a, ha hal hab from some
  have a128: int_lt(a, 128) by arith(hal, h128)
  have pa: int_lt(a, 128) && int_mod(int_div(x, int_pow(2, a)), 2) = 1 by defs(conj(a128, hab), bit, pow2)
  have m := mp(int_min_spec[p := k. int_lt(k, 128) && int_mod(int_div(x, int_pow(2, k)), 2) = 1, a := a], ha, pa)
  have mo mp1 mle := m
  have tzd: gimple.tz(x) = int_min(set_select(omega, k. int_lt(k, 128) && int_mod(int_div(x, int_pow(2, k)), 2) = 1)) by defs(refl({int_min(set_select(omega, k. int_lt(k, 128) && int_mod(int_div(x, int_pow(2, k)), 2) = 1))}), gimple.tz)
  let T := gimple.tz(x)
  have to := rewrite(sym(tzd), mo)
  have tp := rewrite(sym(tzd), mp1)
  have tl := rewrite(sym(tzd), mle)
  have _ tp2 := tp
  have tb: bit(x, T) by defs(tp2, bit, pow2)
  have tn: int_le(T, a) := mp(all_elim(tl, {a}), ha, pa)
  have below: all j. j in omega -> int_lt(j, T) -> !bit(x, j) proof
    fix j
    assume hj hjt
    have nb: bit(x, j) -> false proof
      assume b
      have j128: int_lt(j, 128) by arith(hjt, tn, hal, h128)
      have pj: int_lt(j, 128) && int_mod(int_div(x, int_pow(2, j)), 2) = 1 by defs(conj(j128, b), bit, pow2)
      have le := mp(all_elim(tl, {j}), hj, pj)
      show by arith(le, hjt)
    qed
    show by taut(nb)
  qed
  show conj(to, (int_lt(T, n) by arith(tn, hal)), tb, below)
qed

// the de Bruijn sequence's index of 2^t, looked up: t
theorem ms.debruijn: all t. t in omega -> int_lt(t, 32) ->
  int_lt(int_div(int_mod(int_mul(pow2(t), 124511785), 4294967296), 134217728), 32) &&
  mallocng.debruijn32_tab[int_div(int_mod(int_mul(pow2(t), 124511785), 4294967296), 134217728)] = t
proof
  fix t
  assume ht hl
  show by cases({t}, {0}, {32}, simp(at({mallocng.debruijn32_tab[int_div(int_mod(int_mul(pow2(t), 124511785), 4294967296), 134217728)]})), ht, hl)
qed

// ----------------------------------------------------------------------
//  A byte table's entry: its address, its load
// (an index i of 1-byte elements, below 2^31: the address p + i)
theorem g.elem1_det: all s p i. s in univ(1) -> p in bits(64) -> i in bits(64) -> int_lt(i, 2147483648) -> int_lt(int_add(p, i), pow2(64)) ->
  g.det(gimple.elem(p, i, 1), s, ok(s, int_add(p, i)))
proof
  fix s p i
  assume hs hp hi hl hr
  let TY := fn_update(fn_update(empty, "prec", 64), "signed", true)
  have si: sint(64, i) = i by arith(hi, hl)
  have s1: sint(64, bits_of_int(64, 1)) = 1 by arith()
  have f: gimple.fits(TY, sint(64, i)) by defs(simp(si, hi, hl), gimple.fits)
  have w: bits_add(64, gimple.wrap(fn_update(empty, "prec", 64), sint(64, i)), 0) = i by defs(simp(si, hi), gimple.wrap, bits_add, pow2)
  have sd: g.det(gimple.smul(64, i, bits_of_int(64, 1)), s, ok(s, i)) proof
    fix o
    assume h
    show by simp(expand(h, gimple.smul, gimple.arith, runs, mkprog, bind_rel), hs, s1, f, w)
  qed
  have sv: gimple.sval(TY, i) = i by defs(simp(hi, hl), gimple.sval)
  have pd := rewrite(sv, apply(g.padd_det, {s}, {p}, {i}, hs, hp, hi, simp(sv, hp, hi), simp(sv, hr)))
  show proof
    fix o
    assume h
    have b1 := apply(g.bind_inv, apply(g.runs_elim, expand(h, gimple.elem)), sd)
    show := apply(g.bind_inv, b1, pd)
  qed
qed

// a byte table's entry I (table_ok): its address t + I, its byte
theorem ms.tab1_rd: all s t I tab. s in univ(1) -> t in bits(64) -> !(t = 0) -> I in bits(64) -> int_lt(I, seq_len(tab)) -> int_lt(I, 2147483648) ->
  mallocng_specs.table_ok(s.vm, s.objs, t, 1, tab) ->
  g.det(gimple.elem(t, I, 1), s, ok(s, int_add(t, I))) && g.det(gimple.ld8(int_add(t, I), 0), s, ok(s, bits_of_int(8, tab[I])))
proof
  fix s t I tab
  assume hs ht hnz hI hl h31 htab
  have io: I in omega by simp(hI)
  have tu tb := mp(all_elim(expand(htab, mallocng_specs.table_ok), {I}), io, hl)
  have t0: int_le(0, t) by simp(ht)
  have ud := apply(tr.usable_dom, {s.vm}, {s.objs}, {int_add(t, int_mul(1, I))}, {1}, {false}, {0}, tu, arith(t0, io), simp(), simp())
  have rng: int_lt(int_add(int_add(t, int_mul(1, I)), 0), 18446744073709551616) by taut(ud)
  have ed := apply(g.elem1_det, {s}, {t}, {I}, hs, ht, hI, h31, arith(rng, io, t0))
  have ab: int_add(t, I) in bits(64) by arith(rng, io, t0)
  have e1: int_add(t, int_mul(1, I)) = int_add(t, I) by arith()
  have tu2 := rewrite(e1, tu)
  have e0: int_add(int_add(t, I), 0) = int_add(t, I) by arith()
  have md: g.mem_defined(s, int_add(t, I), 0, 1, false) by simp(e0, tu2, rng, hnz, t0, io, ht)
  have ld := apply(g.ld8_det, {s}, {int_add(t, I)}, {0}, hs, ab, simp(), md)
  have be: bits_of_int(64, int_add(t, I)) = int_add(int_add(t, I), 0) by arith(rng, io, t0)
  have tb2 := rewrite(be, rewrite(e1, tb))
  have ld2 := rewrite(tb2, ld)
  show conj(ed, ld2)
qed

// ----------------------------------------------------------------------
//  a_ctz_32
// the code's index into the table: 2^tz(x)'s de Bruijn index, whose entry is tz(x)
theorem ms.ctz_idx: all x. x in bits(32) -> !(x = 0) ->
  bits_shr(32, bits_mul(32, bits_and(32, x, bits_sub(32, 0, x)), 124511785), 27) in bits(64) &&
  int_lt(bits_shr(32, bits_mul(32, bits_and(32, x, bits_sub(32, 0, x)), 124511785), 27), 32) &&
  mallocng.debruijn32_tab[bits_shr(32, bits_mul(32, bits_and(32, x, bits_sub(32, 0, x)), 124511785), 27)] = gimple.tz(x)
proof
  fix x
  assume hx hnz
  let T := gimple.tz(x)
  have to tl tb tz := mp(all_elim(ms.tz_low, {x}, {32}), arith(), arith(), hx, hnz)
  have ng: bits_sub(32, 0, x) = bits_neg(32, x) by defs(arith(hx), bits_sub, bits_neg)
  have lb := mp(lowest_bit[n := 32, x := x, t := T], arith(), hx, to, tl, tb, tz)
  have e1: bits_and(32, x, bits_sub(32, 0, x)) = pow2(T) := rewrite(sym(ng), lb)
  have ib idx := mp(all_elim(ms.debruijn, {T}), to, tl)
  have pt := mp(pow2_pos[k := T], to)
  have pl := mp(pow2_le[a := T, b := 31], to, arith(), arith(tl))
  have e2: bits_shr(32, bits_mul(32, pow2(T), 124511785), 27) = int_div(int_mod(int_mul(pow2(T), 124511785), 4294967296), 134217728)
    by defs(arith(pt, pl, to), bits_shr, bits_mul, bits_of_int)
  have e3 := rewrite(sym(e1), e2, {1})
  have i64: int_div(int_mod(int_mul(pow2(T), 124511785), 4294967296), 134217728) in bits(64) by arith(ib, pt)
  show rewrite(sym(e3), conj(i64, ib, idx))
qed

// a_ctz_32's readable GIMPLE refines its spec (the table: malloc.c's debruijn32)
theorem ms.a_ctz_32_c2: all x. x in bits(32) ->
  refines(c_src_malloc_mallocng_malloc.a_ctz_32(x), mallocng_specs.a_ctz_32_spec(c_src_malloc_mallocng_malloc.debruijn32, x), abi.World)
proof
  fix x
  assume hx
  show proof
    fix s o
    assume hw hr
    let TB := c_src_malloc_mallocng_malloc.debruijn32
    let SPEC := mallocng_specs.a_ctz_32_spec(TB, x)
    have pu := apply(g.runs_univ, hr)
    have hu: s in univ(1) by simp(pu)
    let PRE := !(x = 0) && mallocng_specs.table_ok(s.vm, s.objs, TB, 1, mallocng.debruijn32_tab)
    have np: !PRE -> runs(SPEC, s, o) proof
      assume hn
      show by simp(pu, hn, keep(abi.overflow, mallocng_specs.table_ok))
    qed
    have yp: PRE -> runs(SPEC, s, o) proof
      assume hp
      have hnz htb := hp
      let I := bits_shr(32, bits_mul(32, bits_and(32, x, bits_sub(32, 0, x)), 124511785), 27)
      have ib il ie := mp(all_elim(ms.ctz_idx, {x}), hx, hnz)
      have tbb: TB in bits(64) by defs(simp(), c_src_malloc_mallocng_malloc.debruijn32)
      have tbz: !(TB = 0) by defs(simp(), c_src_malloc_mallocng_malloc.debruijn32)
      have ln: seq_len(mallocng.debruijn32_tab) = 32 by defs(simp(), mallocng.debruijn32_tab)
      have ed ld := mp(all_elim(ms.tab1_rd, {s}, {TB}, {I}, {mallocng.debruijn32_tab}), hu, tbb, tbz, ib, arith(il, ln), arith(il), htb)
      step t8, oe from hr with ed, ld
      // the result: tz(x), below 32
      have to tl .. := mp(all_elim(ms.tz_low, {x}, {32}), arith(), arith(), hx, hnz)
      have v: bits_sext(8, 32, bits_of_int(8, mallocng.debruijn32_tab[I])) = bits_of_int(32, gimple.tz(x)) by defs(arith(ie, to, tl), bits_sext)
      have pu2: pair(s, ok(s, bits_of_int(32, gimple.tz(x)))) in univ(1) by simp(hu)
      show by simp(rewrite(v, oe), hp, pu2, keep(abi.overflow, mallocng_specs.table_ok))
    qed
    show by taut(np, yp)
  qed
qed

// ----------------------------------------------------------------------
//  a_clz_32
// (one smearing step of the code: y | y >> m)
abbrev ms.sm(y, m) := bits_or(32, y, bits_shr(32, y, m))

// x's top bit p; x >> 1 smeared, plus 1: 2^p
theorem ms.clz_smear: all x. x in bits(32) -> !(x = 0) ->
  ex p. p in omega && int_lt(p, 32) && int_le(pow2(p), x) && int_lt(x, pow2(int_add(p, 1))) &&
    bits_add(32, ms.sm(ms.sm(ms.sm(ms.sm(ms.sm(bits_shr(32, x, 1), 1), 2), 4), 8), 16), 1) = pow2(p)
proof
  fix x
  assume hx hnz
  have xo: x in omega by arith(hx)
  // p: the least with x < 2^(p+1)
  have w31: int_lt(x, pow2(int_add(31, 1))) by arith(hx)
  have mo ml mle := mp(int_min_spec[p := k. int_lt(x, pow2(int_add(k, 1))), a := 31], arith(), w31)
  let P := int_min(set_select(omega, k. int_lt(x, pow2(int_add(k, 1)))))
  have p31: int_le(P, 31) := mp(all_elim(mle, {31}), arith(), w31)
  have zero: P = 0 -> (ex p. p in omega && int_lt(p, 32) && int_le(pow2(p), x) && int_lt(x, pow2(int_add(p, 1))) &&
      bits_add(32, ms.sm(ms.sm(ms.sm(ms.sm(ms.sm(bits_shr(32, x, 1), 1), 2), 4), 8), 16), 1) = pow2(p)) proof
    assume h0
    have x1: x = 1 by arith(rewrite(h0, ml), xo, hnz)
    have z: ms.sm(ms.sm(ms.sm(ms.sm(ms.sm(bits_shr(32, 1, 1), 1), 2), 4), 8), 16) = 0 by bitwise({32})
    have zx := subst({w. ms.sm(ms.sm(ms.sm(ms.sm(ms.sm(bits_shr(32, w, 1), 1), 2), 4), 8), 16) = 0}, sym(x1), z)
    have r: bits_add(32, ms.sm(ms.sm(ms.sm(ms.sm(ms.sm(bits_shr(32, x, 1), 1), 2), 4), 8), 16), 1) = pow2(0) by arith(zx)
    have l: int_le(pow2(0), x) by arith(x1)
    have u: int_lt(x, pow2(int_add(0, 1))) by arith(x1)
    have z0: 0 in omega by arith()
    have z32: int_lt(0, 32) by arith()
    show by ex_intro({0}, conj(z0, z32, l, u, r))
  qed
  have pos: !(P = 0) -> (ex p. p in omega && int_lt(p, 32) && int_le(pow2(p), x) && int_lt(x, pow2(int_add(p, 1))) &&
      bits_add(32, ms.sm(ms.sm(ms.sm(ms.sm(ms.sm(bits_shr(32, x, 1), 1), 2), 4), 8), 16), 1) = pow2(p)) proof
    assume h0
    let k := int_sub(P, 1)
    have hk: k in omega by arith(mo, h0)
    have ek: int_add(k, 1) = P by arith(mo)
    // 2^P <= x: else P - 1 had x < 2^P
    have lt: int_lt(x, pow2(int_add(k, 1))) -> int_le(P, k) := mp(all_elim(mle, {k}), hk)
    have lo: int_le(pow2(P), x) by arith(rewrite(ek, lt), mo, h0)
    have pp := mp(pow2_pos[k := P], mo)
    // x's bits: P set, none above
    have bp: bit(x, P) by defs(arith(lo, ml, mo, xo, pp), bit)
    have pl1 := mp(pow2_le[a := int_add(P, 1), b := 32], arith(mo), arith(), arith(p31))
    have hiq: all j. j in omega -> int_lt(P, j) -> !bit(x, j) proof
      fix j
      assume hj hpj
      show mp(bit_high[x := x, n := int_add(P, 1), i := j], xo, arith(mo), hj, ml, arith(hpj, hj, mo))
    qed
    // x >> 1: bit k set, none above
    let Y0 := bits_shr(32, x, 1)
    have y0b: Y0 in bits(32) by arith(hx)
    have s0: all j. j in omega -> int_le(j, k) -> int_lt(k, int_add(j, 1)) -> bit(Y0, j) proof
      fix j
      assume hj h1 h2
      show by bitwise(hx, bp, hj, h1, h2, mo, h0)
    qed
    have c0: all j. j in omega -> int_lt(k, j) -> int_lt(j, 32) -> !bit(Y0, j) proof
      fix j
      assume hj h1 h2
      show by bitwise(hx, hiq, hj, h1, h2, mo, h0)
    qed
    have k32: int_lt(k, 32) by arith(p31, mo)
    // the five steps
    have s1 c1 := mp(smear_step[n := 32, y := Y0, k := k, m := 1, m2 := 2], arith(), y0b, hk, k32, arith(), arith(), s0, c0)
    let Y1 := ms.sm(Y0, 1)
    have s2 c2 := mp(smear_step[n := 32, y := Y1, k := k, m := 2, m2 := 4], arith(), mp(bits_or_in[n := 32, x := Y0, y := bits_shr(32, Y0, 1)], arith()), hk, k32, arith(), arith(), s1, c1)
    let Y2 := ms.sm(Y1, 2)
    have s3 c3 := mp(smear_step[n := 32, y := Y2, k := k, m := 4, m2 := 8], arith(), mp(bits_or_in[n := 32, x := Y1, y := bits_shr(32, Y1, 2)], arith()), hk, k32, arith(), arith(), s2, c2)
    let Y3 := ms.sm(Y2, 4)
    have s4 c4 := mp(smear_step[n := 32, y := Y3, k := k, m := 8, m2 := 16], arith(), mp(bits_or_in[n := 32, x := Y2, y := bits_shr(32, Y2, 4)], arith()), hk, k32, arith(), arith(), s3, c3)
    let Y4 := ms.sm(Y3, 8)
    have s5 c5 := mp(smear_step[n := 32, y := Y4, k := k, m := 16, m2 := 32], arith(), mp(bits_or_in[n := 32, x := Y3, y := bits_shr(32, Y3, 8)], arith()), hk, k32, arith(), arith(), s4, c4)
    let Y5 := ms.sm(Y4, 16)
    have all5: all j. j in omega -> int_le(j, k) -> bit(Y5, j) proof
      fix j
      assume hj h1
      show mp(all_elim(s5, {j}), hj, h1, arith(hj, h1, k32))
    qed
    have y5b := mp(bits_or_in[n := 32, x := Y4, y := bits_shr(32, Y4, 16)], arith())
    have d := rewrite(ek, mp(smear_done[n := 32, y := Y5, k := k], arith(), y5b, hk, k32, all5, c5))
    have pl := mp(pow2_le[a := P, b := 31], mo, arith(), p31)
    have r: bits_add(32, Y5, 1) = pow2(P) by arith(d, pl, pp)
    have p32: int_lt(P, 32) by arith(p31, mo)
    show by ex_intro({P}, conj(mo, p32, lo, ml, r))
  qed
  show by taut(zero, pos)
qed

// tz(2^p) = p
theorem ms.tz_pow2: all p. p in omega -> int_lt(p, 32) -> gimple.tz(pow2(p)) = p
proof
  fix p
  assume hp hl
  have pl := mp(pow2_le[a := int_add(p, 1), b := 32], arith(hp), arith(), arith(hl))
  have pp := mp(pow2_pos[k := p], hp)
  have pb: pow2(p) in bits(32) by arith(hp, pl, pp)
  have pz: !(pow2(p) = 0) by arith(pp)
  have to tl tb .. := mp(all_elim(ms.tz_low, {pow2(p)}, {32}), arith(), arith(), pb, pz)
  have e := mp(bit_pow2[k := p, i := gimple.tz(pow2(p))], hp, to)
  show by taut(tb, e)
qed

// a_ctz_32's spec, its precondition holding: an overflow, or tz(x) returned
theorem ms.ctz_spec_inv: all tbl x s o. x in bits(32) -> s in abi.World -> !(x = 0) ->
  mallocng_specs.table_ok(s.vm, s.objs, tbl, 1, mallocng.debruijn32_tab) ->
  runs(mallocng_specs.a_ctz_32_spec(tbl, x), s, o) ->
  (ex v. v in x86_64_linux.Vm && o = exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty))) || o = ok(s, bits_of_int(32, gimple.tz(x)))
proof
  fix tbl x s o
  assume hx hw hnz htb h
  have vv: ex y. y in x86_64_linux.Vm by ex_intro({s.vm}, simp(expand(hw, abi.World)))
  show by simp(h, hnz, htb, vv, keep(mallocng_specs.table_ok))
qed

// a_ctz_32's contract at a call a_ctz_32(x): an overflow, or the return,
// the memory as it was, the first register's low half tz(x)
theorem ms.ctzs_q: all regs s tbl x o2. x in bits(32) -> s in abi.World -> s in univ(1) ->
  !(x = 0) -> mallocng_specs.table_ok(s.vm, s.objs, tbl, 1, mallocng.debruijn32_tab) ->
  gc.regs_ok(regs, seq_one(gimple.arg(32, x))) ->
  runs(mallocng_specs.a_ctz_32_spec_fun(tbl)[regs], s, o2) ->
  (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && bits_of_int(32, fst(r)) = bits_of_int(32, gimple.tz(x)))
proof
  fix regs s tbl x o2
  assume hx hw hu hnz htb hr h
  let OVF := exc_val("stack_overflow", empty)
  let T := bits_of_int(32, gimple.tz(x))
  have rl rn r0 := apply(gc.regs1_32, hx, hr)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, mallocng_specs.a_ctz_32_spec_fun, app_fn_build, ra in h
  have vfun: is_fun(s) by simp(expand(hw, abi.World))
  have vdom: "vm" in dom(s) by simp(expand(hw, abi.World))
  have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], vfun, vdom)
  let G := (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(s, "vm", v), OVF)) || (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && bits_of_int(32, fst(r)) = T)
  have o1: ord_le(1, seq_len(regs)) by defs(simp(rn), ord_le)
  have b := rewrite(r0, apply(g.runs_elim, h))
  have b2: bind_rel(mallocng_specs.a_ctz_32_spec(tbl, x), s, x3 x4. letin(x4, x5. bind_rel(gimple.result(32, x5), x3, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. o2 = ok(x6, pair(x8, x9)))),
      x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))), x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3)) by taut(b, o1)
  obtain o3, hs3 hk3 from expand(b2, bind_rel)
  have ci := apply(ms.ctz_spec_inv, hx, hw, hnz, htb, hs3)
  have c1: (ex v. v in x86_64_linux.Vm && o3 = exc(fn_update(s, "vm", v), OVF)) -> G proof
    assume e
    obtain v, hv he from e
    have oe: o2 = exc(fn_update(s, "vm", v), OVF) by simp(rewrite(he, hk3))
    have l: ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(s, "vm", v), OVF) by ex_intro({v}, taut(hv, oe))
    show by taut(l)
  qed
  have c2: o3 = ok(s, T) -> G proof
    assume he
    have hr32: T in bits(32) by simp()
    have k1: bind_rel(gimple.result(32, T), s, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. o2 = ok(x6, pair(x8, x9)))), x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))
      by simp(expand(rewrite(he, hk3), letin), keep(bind_rel, gimple.result))
    obtain o4, hr4 hk4 from expand(k1, bind_rel)
    obtain u, hu64 hlow ho4 from apply(g.result32_inv, hr32, hr4)
    have k2: any_rel(x9. x9 in bits(64), x9. o2 = ok(s, pair(u, x9))) by simp(expand(rewrite(ho4, hk4), letin), keep(any_rel))
    have ne: ex y. y in bits(64) by ex_intro({0}, simp())
    obtain y, hy hoy from apply(g.any_e, ne, k2)
    have cl: bits_of_int(32, fst(pair(u, y))) = T by simp(hlow)
    have l: ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && bits_of_int(32, fst(r)) = T by ex_intro({pair(u, y)}, taut(rewrite(sym(ss), hoy), cl))
    show by taut(l)
  qed
  show by taut(ci, c1, c2)
qed

// a_clz_32's readable GIMPLE refines its spec, for any callee refining
// a_ctz_32's spec (as a C function value)
theorem ms.a_clz_32_c2: all x g tbl. x in bits(32) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(g[regs], s, o) -> runs(mallocng_specs.a_ctz_32_spec_fun(tbl)[regs], s, o)) ->
  refines(c_src_malloc_mallocng_malloc.a_clz_32(x, g), mallocng_specs.a_clz_32_spec(tbl, x), abi.World)
proof
  fix x g tbl
  assume hx hg
  show proof
    fix s o
    assume hw hr
    let SPEC := mallocng_specs.a_clz_32_spec(tbl, x)
    let OVF := exc_val("stack_overflow", empty)
    have pu := apply(g.runs_univ, hr)
    have hu: s in univ(1) by simp(pu)
    have vV vfun vdom .. := apply(ms.world_parts, hw)
    have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], vfun, vdom)
    let PRE := (!(x = 0) && mallocng_specs.table_ok(s.vm, s.objs, tbl, 1, mallocng.debruijn32_tab)) && abi.thread_ok(s.vm, s.fs_base)
    have np: !PRE -> runs(SPEC, s, o) proof
      assume hn
      show by simp(pu, hn, keep(abi.overflow, mallocng_specs.table_ok, mallocng_specs.clz_of, abi.thread_ok))
    qed
    have yp: PRE -> runs(SPEC, s, o) proof
      assume hp
      have hnz htb hth := hp
      // (the spec's outcomes: an overflow, any memory; x's leading zeros)
      have sov: all v. v in x86_64_linux.Vm -> runs(SPEC, s, exc(fn_update(s, "vm", v), OVF)) proof
        fix v
        assume hv
        have vu := apply(x86.vm_univ, hv)
        have eu: OVF in univ(1) by defs(simp(), exc_val)
        have pu2: pair(s, exc(fn_update(s, "vm", v), OVF)) in univ(1) by simp(hu, vu, eu)
        have ovi := apply(ct.overflow_intro, hv, pu2)
        show by simp(hp, ovi, pu2, keep(abi.overflow, mallocng_specs.table_ok, mallocng_specs.clz_of, abi.thread_ok))
      qed
      have sret: all c. c in bits(32) -> mallocng_specs.clz_of(x, c) -> runs(SPEC, s, ok(s, c)) proof
        fix c
        assume hc hcl
        have pu2: pair(s, ok(s, c)) in univ(1) by simp(hu, hc)
        show by simp(hp, hc, hcl, pu2, keep(abi.overflow, mallocng_specs.table_ok, mallocng_specs.clz_of, abi.thread_ok))
      qed
      // x >> 1 smeared, plus 1: 2^P, P x's top bit
      obtain P, hpo hp32 hlo hhi hsm from apply(ms.clz_smear, hx, hnz)
      let X := bits_add(32, ms.sm(ms.sm(ms.sm(ms.sm(ms.sm(bits_shr(32, x, 1), 1), 2), 4), 8), 16), 1)
      have pp := mp(pow2_pos[k := P], hpo)
      have xb: X in bits(32) by simp()
      have xnz: !(X = 0) by arith(hsm, pp)
      step t17, b from hr
      // the call: a_ctz_32's contract
      have qa: all regs o2. gc.regs_ok(regs, seq_one(gimple.arg(32, X))) -> runs(mallocng_specs.a_ctz_32_spec_fun(tbl)[regs], s, o2) ->
          (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(s, "vm", v), OVF)) || (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && bits_of_int(32, fst(r)) = bits_of_int(32, gimple.tz(X))) proof
        fix regs o2
        assume hro h2
        show := apply(ms.ctzs_q, xb, hw, hu, xnz, htb, hro, h2)
      qed
      have ths: gc.sound(s) by simp(hth)
      have cc := apply(gc.contract_call1[R := r. bits_of_int(32, fst(r)) = bits_of_int(32, gimple.tz(X))], {g}, {mallocng_specs.a_ctz_32_spec_fun(tbl)}, {seq_one(gimple.arg(32, X))}, {s}, {s.vm},
        ths, hw, vV, apply(gc.regs1_32_ex, xb), (int_le(seq_len(seq_one(gimple.arg(32, X))), 6) by simp()), hg, qa, b)
      have cov: (ex v. v in x86_64_linux.Vm && o = exc(fn_update(s, "vm", v), OVF)) -> runs(SPEC, s, o) proof
        assume h
        obtain v, hv ho from h
        show := rewrite(sym(ho), mp(all_elim(sov, {v}), hv))
      qed
      // the count returned: P; 31 - P
      have cok: case 2 of cc proof
        assume h
        obtain r, hR hk from h
        let C := bits_of_int(32, fst(r))
        have hk2 := rewrite(ss, hk)
        have tp := mp(all_elim(ms.tz_pow2, {P}), hpo, hp32)
        have ce: C = P by arith(rewrite(tp, rewrite(hsm, hR)), hpo, hp32)
        have cb: C in bits(32) by simp()
        have b31: bits_of_int(32, 31) = 31 by arith()
        have sC: sint(32, C) = P by arith(ce, hpo, hp32)
        have s31: sint(32, bits_of_int(32, 31)) = 31 by arith()
        have f: tr.s32_fits(int_sub(sint(32, bits_of_int(32, 31)), sint(32, C))) by defs(simp(sC, s31, hpo, hp32), gimple.fits)
        have sd := apply(g.ssub32_det, {s}, {bits_of_int(32, 31)}, {C}, hu, simp(), cb, f)
        step d from hk2 with sd
        let R0 := bits_sub(32, bits_of_int(32, 31), C)
        have rb: R0 in bits(32) by simp()
        have q1: int_sub(31, R0) = P by arith(ce, hpo, hp32)
        have q2: int_sub(32, R0) = int_add(P, 1) by arith(ce, hpo, hp32)
        have r32: int_lt(R0, 32) by arith(ce, hpo, hp32)
        have c0: int_lt(R0, 32) && int_le(int_pow(2, P), x) && int_lt(x, int_pow(2, int_add(P, 1))) by defs(conj(r32, hlo, hhi), pow2)
        have c1 := subst({w. int_lt(R0, 32) && int_le(int_pow(2, w), x) && int_lt(x, int_pow(2, int_add(P, 1)))}, sym(q1), c0)
        have c2 := subst({w. int_lt(R0, 32) && int_le(int_pow(2, int_sub(31, R0)), x) && int_lt(x, int_pow(2, w))}, sym(q2), c1)
        have cl: mallocng_specs.clz_of(x, R0) by defs(c2, mallocng_specs.clz_of)
        show := rewrite(sym(d), mp(all_elim(sret, {R0}), rb, cl))
      qed
      show by taut(cc, cov, cok)
    qed
    show by taut(np, yp)
  qed
qed

// ----------------------------------------------------------------------
//  enframe's offset: the smeared slack's mask; words without wrapping
// (one smearing step of enframe's code, 64-bit: y | y >> m)
abbrev ms.sm64(y, m) := bits_or(64, y, bits_shr(64, y, m))

// enframe's mask: slack smeared by 1, 2, 4 -- for a slack below 256, all its
// bits up to its top one, 2^(K+1) - 1 with 2^K <= slack; an offset masked
// by it: at most 2 slack + 1
theorem ms.ef_mask: all x y. x in bits(64) -> int_lt(x, 256) -> y in bits(32) ->
  int_le(bits_and(32, bits_of_int(32, ms.sm64(ms.sm64(ms.sm64(x, 1), 2), 4)), y), int_add(int_mul(2, x), 1))
proof
  fix x y
  assume hx h256 hy
  have xo: x in omega by arith(hx)
  have zero: x = 0 -> int_le(bits_and(32, bits_of_int(32, ms.sm64(ms.sm64(ms.sm64(x, 1), 2), 4)), y), int_add(int_mul(2, x), 1)) proof
    assume h0
    have z: bits_and(32, bits_of_int(32, ms.sm64(ms.sm64(ms.sm64(0, 1), 2), 4)), y) = 0 by bitwise({64}, hy)
    have zx := subst({w. bits_and(32, bits_of_int(32, ms.sm64(ms.sm64(ms.sm64(w, 1), 2), 4)), y) = 0}, sym(h0), z)
    show by arith(zx, h0)
  qed
  have pos: !(x = 0) -> int_le(bits_and(32, bits_of_int(32, ms.sm64(ms.sm64(ms.sm64(x, 1), 2), 4)), y), int_add(int_mul(2, x), 1)) proof
    assume hnz
    // K: x's top bit, the least with x < 2^(K+1)
    have w7: int_lt(x, pow2(int_add(7, 1))) by arith(h256)
    have mo ml mle := mp(int_min_spec[p := k. int_lt(x, pow2(int_add(k, 1))), a := 7], arith(), w7)
    let K := int_min(set_select(omega, k. int_lt(x, pow2(int_add(k, 1)))))
    have k7: int_le(K, 7) := mp(all_elim(mle, {7}), arith(), w7)
    // 2^K <= x (else K - 1 had x < 2^K; for K = 0, x >= 1)
    have lo: int_le(pow2(K), x) proof
      have c0: K = 0 -> int_le(pow2(K), x) proof
        assume e
        show by arith(e, xo, hnz)
      qed
      have c1: !(K = 0) -> int_le(pow2(K), x) proof
        assume hk0
        let J := int_sub(K, 1)
        have hj: J in omega by arith(mo, hk0)
        have ej: int_add(J, 1) = K by arith(mo)
        have lt: int_lt(x, pow2(int_add(J, 1))) -> int_le(K, J) := mp(all_elim(mle, {J}), hj)
        show by arith(rewrite(ej, lt), mo, hk0)
      qed
      show by taut(c0, c1)
    qed
    have pp := mp(pow2_pos[k := K], mo)
    have bk: bit(x, K) by defs(arith(lo, ml, mo, xo, pp), bit)
    have hiq: all j. j in omega -> int_lt(K, j) -> !bit(x, j) proof
      fix j
      assume hj hkj
      show mp(bit_high[x := x, n := int_add(K, 1), i := j], xo, arith(mo), hj, ml, arith(hkj, hj, mo))
    qed
    have k64: int_lt(K, 64) by arith(k7, mo)
    have s0: all j. j in omega -> int_le(j, K) -> int_lt(K, int_add(j, 1)) -> bit(x, j) proof
      fix j
      assume hj h1 h2
      have e: j = K by arith(hj, h1, h2, mo)
      show := subst({i. bit(x, i)}, sym(e), bk)
    qed
    have c0: all j. j in omega -> int_lt(K, j) -> int_lt(j, 64) -> !bit(x, j) proof
      fix j
      assume hj h1 h2
      show mp(all_elim(hiq, {j}), hj, h1)
    qed
    // the three steps: bits K - 7 .. K set, none above
    have s1 c1 := mp(smear_step[n := 64, y := x, k := K, m := 1, m2 := 2], arith(), hx, mo, k64, arith(), arith(), s0, c0)
    let Y1 := ms.sm64(x, 1)
    have s2 c2 := mp(smear_step[n := 64, y := Y1, k := K, m := 2, m2 := 4], arith(), mp(bits_or_in[n := 64, x := x, y := bits_shr(64, x, 1)], arith()), mo, k64, arith(), arith(), s1, c1)
    let Y2 := ms.sm64(Y1, 2)
    have s3 c3 := mp(smear_step[n := 64, y := Y2, k := K, m := 4, m2 := 8], arith(), mp(bits_or_in[n := 64, x := Y1, y := bits_shr(64, Y1, 2)], arith()), mo, k64, arith(), arith(), s2, c2)
    let Y3 := ms.sm64(Y2, 4)
    have all3: all j. j in omega -> int_le(j, K) -> bit(Y3, j) proof
      fix j
      assume hj h1
      show mp(all_elim(s3, {j}), hj, h1, arith(hj, h1, k7, mo))
    qed
    have y3b := mp(bits_or_in[n := 64, x := Y2, y := bits_shr(64, Y2, 4)], arith())
    have d := mp(smear_done[n := 64, y := Y3, k := K], arith(), y3b, mo, k64, all3, c3)
    // 2^(K+1) - 1 <= 2x + 1
    have pa := mp(all_elim(mp(all_elim(pow2_add, {K}), mo), {1}), arith())
    have p1: pow2(1) = 2 by simp()
    // the mask keeps y's bits below K + 1: y mod 2^(K+1)
    have p8 := mp(pow2_le[a := int_add(K, 1), b := 8], arith(mo), arith(), arith(k7, mo))
    have p8v: pow2(8) = 256 by simp()
    have pk1 := mp(pow2_pos[k := int_add(K, 1)], arith(mo))
    have mb: int_mod(y, pow2(int_add(K, 1))) in bits(32) by arith(hy, pk1, p8, p8v)
    have em: bits_and(32, bits_of_int(32, int_sub(pow2(int_add(K, 1)), 1)), y) = int_mod(y, pow2(int_add(K, 1))) by bitwise({32}, mo, hy, mb)
    have ed := subst({w. bits_and(32, bits_of_int(32, w), y) = int_mod(y, pow2(int_add(K, 1)))}, sym(d), em)
    show by arith(ed, pa, p1, lo, hy, pk1)
  qed
  show by taut(zero, pos)
qed

// a 32-bit word's low byte (& 255): below 256
theorem ms.and255: all y. y in bits(32) -> bits_and(32, y, 255) in bits(32) && int_lt(bits_and(32, y, 255), 256)
proof
  fix y
  assume hy
  have p8: pow2(8) = 256 by simp()
  have m8: int_sub(pow2(8), 1) = 255 by simp()
  have mb: int_mod(y, pow2(8)) in bits(32) by arith(hy, p8)
  have e0: bits_and(32, y, int_sub(pow2(8), 1)) = int_mod(y, pow2(8)) by bitwise({32}, hy, mb)
  have e := rewrite(m8, e0)
  have i := mp(bits_and_in[n := 32, x := y, y := 255], simp())
  show by arith(e, i, hy, p8)
qed

// (32-bit a - b, a + -1 without wrapping)
theorem ms.sub32: all a b. a in bits(32) -> b in omega -> int_le(b, a) -> bits_sub(32, a, b) = int_sub(a, b)
proof
  fix a b
  assume ha hb hl
  have p32: pow2(32) = 4294967296 by simp()
  show by defs(arith(ha, hb, hl, p32), bits_sub, pow2)
qed

theorem ms.dec32: all x. x in omega -> int_le(1, x) -> int_lt(x, 4294967296) -> bits_add(32, x, bits_neg(32, 1)) = int_sub(x, 1)
proof
  fix x
  assume hx h1 h2
  show by defs(simp(hx, h1, h2), bits_add, bits_neg)
qed

theorem ms.sext_small: all x. x in bits(32) -> int_lt(x, 2147483648) -> bits_sext(32, 64, x) = x
proof
  fix x
  assume hx hl
  show by defs(simp(hx, hl), bits_sext, sint)
qed

// (64-bit a - b without wrapping; x >> 4)
theorem ms.sub64: all a b. a in bits(64) -> b in omega -> int_le(b, a) -> bits_sub(64, a, b) = int_sub(a, b)
proof
  fix a b
  assume ha hb hl
  have p64: pow2(64) = 18446744073709551616 by simp()
  show by defs(arith(ha, hb, hl, p64), bits_sub, pow2)
qed

theorem ms.shr4: all x. x in bits(64) -> bits_shr(64, x, 4) = int_div(x, 16)
proof
  fix x
  assume hx
  have p4: pow2(4) = 16 by simp()
  have p64: pow2(64) = 18446744073709551616 by simp()
  have m: int_mod(x, 18446744073709551616) = x by arith(hx)
  show by defs(simp(p4, rewrite(sym(p64), m), hx), bits_shr, bits_of_int)
qed

// ----------------------------------------------------------------------
//  As C function values; linked
theorem ms.a_ctz_32_fun_c2: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
  runs(c_src_malloc_mallocng_malloc.a_ctz_32_fun()[regs], s, o) -> runs(mallocng_specs.a_ctz_32_spec_fun(c_src_malloc_mallocng_malloc.debruijn32)[regs], s, o)
proof
  have hm: all regs. refines(c_src_malloc_mallocng_malloc.a_ctz_32(bits_of_int(32, regs[0])), mallocng_specs.a_ctz_32_spec(c_src_malloc_mallocng_malloc.debruijn32, bits_of_int(32, regs[0])), abi.World) proof
    fix regs
    show := mp(all_elim(ms.a_ctz_32_c2, {bits_of_int(32, regs[0])}), simp())
  qed
  show by defs(apply(g.fun_res[n := 1, w := 32], hm), c_src_malloc_mallocng_malloc.a_ctz_32_fun, mallocng_specs.a_ctz_32_spec_fun, letin)
qed

theorem ms.a_clz_32_fun_c2: all g tbl. (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(g[regs], s, o) -> runs(mallocng_specs.a_ctz_32_spec_fun(tbl)[regs], s, o)) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
    runs(c_src_malloc_mallocng_malloc.a_clz_32_fun(g)[regs], s, o) -> runs(mallocng_specs.a_clz_32_spec_fun(tbl)[regs], s, o))
proof
  fix g tbl
  assume hg
  have hm: all regs. refines(c_src_malloc_mallocng_malloc.a_clz_32(bits_of_int(32, regs[0]), g), mallocng_specs.a_clz_32_spec(tbl, bits_of_int(32, regs[0])), abi.World) proof
    fix regs
    show := mp(all_elim(ms.a_clz_32_c2, {bits_of_int(32, regs[0])}, {g}, {tbl}), simp(), hg)
  qed
  show by defs(apply(g.fun_res[n := 1, w := 32], hm), c_src_malloc_mallocng_malloc.a_clz_32_fun, mallocng_specs.a_clz_32_spec_fun, letin)
qed

// size_to_class with musl's a_clz_32 and a_ctz_32: its contract (the
// de Bruijn table malloc.c's)
theorem ms.size_to_class_c2_linked: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
  runs(c_src_malloc_mallocng_malloc.size_to_class_fun(c_src_malloc_mallocng_malloc.a_clz_32_fun(c_src_malloc_mallocng_malloc.a_ctz_32_fun()))[regs], s, o) ->
  runs(mallocng_specs.size_to_class_spec_fun(c_src_malloc_mallocng_malloc.__malloc_size_classes, c_src_malloc_mallocng_malloc.debruijn32)[regs], s, o)
proof
  have clz := mp(all_elim(ms.a_clz_32_fun_c2, {c_src_malloc_mallocng_malloc.a_ctz_32_fun()}, {c_src_malloc_mallocng_malloc.debruijn32}), ms.a_ctz_32_fun_c2)
  show mp(all_elim(ms.size_to_class_fun_c2, {c_src_malloc_mallocng_malloc.a_clz_32_fun(c_src_malloc_mallocng_malloc.a_ctz_32_fun())}, {c_src_malloc_mallocng_malloc.debruijn32}), clz)
qed
