  have a45 := rewrite(sym(ms.sc_lit), at({seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(1), seq_one(2)), seq_one(3)), seq_one(4)), seq_one(5)), seq_one(6)), seq_one(7)), seq_one(8)), seq_one(9)), seq_one(10)), seq_one(12)), seq_one(15)), seq_one(18)), seq_one(20)), seq_one(25)), seq_one(31)), seq_one(36)), seq_one(42)), seq_one(50)), seq_one(63)), seq_one(72)), seq_one(84)), seq_one(102)), seq_one(127)), seq_one(146)), seq_one(170)), seq_one(204)), seq_one(255)), seq_one(292)), seq_one(340)), seq_one(409)), seq_one(511)), seq_one(584)), seq_one(682)), seq_one(818)), seq_one(1023)), seq_one(1169)), seq_one(1364)), seq_one(1637)), seq_one(2047)), seq_one(2340)), seq_one(2730)), seq_one(3276)), seq_one(4095)), seq_one(4680)), seq_one(5460)), seq_one(6552)), seq_one(8191))[45]}))
