// __mmap's code (its own translation unit): musl's checks, the kernel's
// mmap through __syscall6 (its seventh argument on the stack), errno
// through __syscall_ret.

// ----------------------------------------------------------------------
//  mmap's spec: its two returns

// (the spec's precondition, a place p for len's pages, a memory with them
// fresh: p's address)
theorem ms.mmap_ok: all addr len prot flags s V p. s in abi.World -> s in univ(1) -> V in x86_64_linux.Vm ->
  (flags = int_add(x86_64_linux.MAP_PRIVATE, x86_64_linux.MAP_ANONYMOUS) || flags = int_add(int_add(x86_64_linux.MAP_PRIVATE, x86_64_linux.MAP_ANONYMOUS), x86_64_linux.MAP_FIXED)) ->
  int_lt(prot, 8) -> mallocng_specs.errno_ok(s.vm, s.objs, s.fs_base) ->
  ite(flags = int_add(int_add(x86_64_linux.MAP_PRIVATE, x86_64_linux.MAP_ANONYMOUS), x86_64_linux.MAP_FIXED),
    gimple.sys_pages_ok(s.vm, s.objs, x86_64_linux.page_of(addr), x86_64_linux.pages_for(len)) && mallocng_specs.tls_off(s.fs_base, x86_64_linux.page_of(addr), x86_64_linux.pages_for(len)),
    addr = 0) ->
  p in omega -> mallocng_specs.mmap_place(s.vm, addr, len, flags, p) ->
  gimple.fresh_pages(s.vm, V, s.objs, p, x86_64_linux.pages_for(len), fn_update(fn_update(empty, "prot", x86_64_linux.prot_of(bits_of_int(64, prot))), "kind", 0)) -> V.brk = s.vm.brk ->
  runs(mallocng_specs.mmap_spec(addr, len, prot, flags, 0), s, ok(fn_update(s, "vm", V), bits_of_int(64, int_mul(p, x86_64_linux.PAGE))))
proof
  fix addr len prot flags s V p
  assume hw hu hV hfl hp8 he hfx hpo hpl hfp hbk
  have vu := apply(x86.vm_univ, hV)
  let N := x86_64_linux.pages_for(len)
  let PGS := fn_update(fn_update(empty, "prot", x86_64_linux.prot_of(bits_of_int(64, prot))), "kind", 0)
  let W := fn_update(s, "vm", V)
  let R := bits_of_int(64, int_mul(p, x86_64_linux.PAGE))
  let O := ok(W, R)
  let X := exc(pair(W, empty), pair("ret", R))
  let PL(x) := x in omega && mallocng_specs.mmap_place(s.vm, addr, len, flags, x)
  let EXP := ex x5. PL(x5)
  // (the spec's choices: the place, then the memory)
  let D9(n, y, x9) := x9 in x86_64_linux.Vm && (gimple.fresh_pages(s.vm, app(fn_update(s, "vm", x9), "vm"), app(fn_update(s, "vm", x9), "objs"),y, n, PGS) && app(app(fn_update(s, "vm", x9), "vm"), "brk") = app(s.vm, "brk"))
  let WE := fn_update(s, "vm", mallocng_specs.wr32(app(s, "vm"), mallocng_specs.errno_at(app(s, "fs_base")), x86_64_linux.ENOMEM))
  let H9(n, y, x9) := ((ex x10. D9(n, y, x10)) && any_rel(x10. D9(n, y, x10), x10. letin(fn_update(s, "vm", x10), x11. x9 = ok(pair(x11, empty), empty)))) ||
    (!(ex x10. D9(n, y, x10)) && letin(WE, x10. x9 = exc(pair(x10, empty), pair("ret", bits_of_int(64, int_sub(int_pow(2, 64), 1))))))
  let K9(y, x5, x9) := lx.blk(x9, x5 = exc(pair(fst(out_state(x9)), empty), pair("ret", bits_of_int(64, int_mul(y, x86_64_linux.PAGE)))), x5)
  let A7(n, x5) := any_rel(x7. PL(x7), x7. letin(x7, x8. ex x9. H9(n, x8, x9) && K9(x8, x5, x9)))
  let C5(x4, x5) := (fst(x5) = 0 && x4 = ok(pair(fst(out_state(x5)), empty), empty)) || ((((fst(x5) = 1 && fst(out_value(x5)) = "ret") && x4 = exc(pair(fst(out_state(x5)), empty), pair("ret", snd(out_value(x5))))) ||
    ((fst(x5) = 1 && fst(out_value(x5)) = "raise") && x4 = exc(pair(fst(out_state(x5)), empty), pair("raise", snd(out_value(x5)))))) || (fst(x5) = 2 && x4 = diverge(snd(x5))))
  let REL2(x0, x1) := (ex x2. (bind_rel(abi.overflow, x0, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)), x3. x2 = diverge(x3)) ||
      letin(app(x0, "vm"), x3. ex x4. (((ex x5. x5 in omega && mallocng_specs.mmap_place(x3, addr, len, flags, x5)) && (ex x5. (x5 = ok(pair(x0, empty), empty) ||
        letin(x86_64_linux.pages_for(len), x6. any_rel(x7. x7 in omega && mallocng_specs.mmap_place(x3, addr, len, flags, x7), x7. letin(x7, x8. ex x9. (((ex x10. x10 in x86_64_linux.Vm &&
          (gimple.fresh_pages(x3, app(fn_update(x0, "vm", x10), "vm"), app(fn_update(x0, "vm", x10), "objs"), x8, x6, PGS) && app(app(fn_update(x0, "vm", x10), "vm"), "brk") = app(x3, "brk"))) &&
          any_rel(x10. x10 in x86_64_linux.Vm &&
          (gimple.fresh_pages(x3, app(fn_update(x0, "vm", x10), "vm"), app(fn_update(x0, "vm", x10), "objs"), x8, x6, PGS) && app(app(fn_update(x0, "vm", x10), "vm"), "brk") = app(x3, "brk")),
          x10. letin(fn_update(x0, "vm", x10), x11. x9 = ok(pair(x11, empty), empty)))) ||
          (!(ex x10. x10 in x86_64_linux.Vm &&
          (gimple.fresh_pages(x3, app(fn_update(x0, "vm", x10), "vm"), app(fn_update(x0, "vm", x10), "objs"), x8, x6, PGS) && app(app(fn_update(x0, "vm", x10), "vm"), "brk") = app(x3, "brk"))) &&
          letin(fn_update(x0, "vm", mallocng_specs.wr32(app(x0, "vm"), mallocng_specs.errno_at(app(x0, "fs_base")), x86_64_linux.ENOMEM)), x10. x9 = exc(pair(x10, empty), pair("ret", bits_of_int(64, int_sub(int_pow(2, 64), 1))))))) &&
          lx.blk(x9, x5 = exc(pair(fst(out_state(x9)), empty), pair("ret", bits_of_int(64, int_mul(x8, x86_64_linux.PAGE)))), x5))))) &&
        ((fst(x5) = 0 && x4 = ok(pair(fst(out_state(x5)), empty), empty)) || ((((fst(x5) = 1 && fst(out_value(x5)) = "ret") && x4 = exc(pair(fst(out_state(x5)), empty), pair("ret", snd(out_value(x5))))) ||
          ((fst(x5) = 1 && fst(out_value(x5)) = "raise") && x4 = exc(pair(fst(out_state(x5)), empty), pair("raise", snd(out_value(x5)))))) || (fst(x5) = 2 && x4 = diverge(snd(x5))))))) ||
        (!(ex x5. x5 in omega && mallocng_specs.mmap_place(x3, addr, len, flags, x5)) && x4 = ok(pair(x0, empty), empty))) &&
        ((fst(x4) = 0 && any_rel(x5. x5 in omega && (x5 = x86_64_linux.ENOMEM || x5 = x86_64_linux.EINVAL), x5. letin(fn_update(fst(out_state(x4)), "vm",
          mallocng_specs.wr32(app(fst(out_state(x4)), "vm"), mallocng_specs.errno_at(app(fst(out_state(x4)), "fs_base")), x5)), x6. x2 = exc(pair(x6, empty), pair("ret", bits_of_int(64, int_sub(int_pow(2, 64), 1))))))) ||
         ((((fst(x4) = 1 && fst(out_value(x4)) = "ret") && x2 = exc(pair(fst(out_state(x4)), empty), pair("ret", snd(out_value(x4))))) ||
           ((fst(x4) = 1 && fst(out_value(x4)) = "raise") && x2 = exc(pair(fst(out_state(x4)), empty), pair("raise", snd(out_value(x4)))))) || (fst(x4) = 2 && x2 = diverge(snd(x4))))))) &&
      ((fst(x2) = 0 && x1 = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && x1 = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
        ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && x1 = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && x1 = diverge(snd(x2))))))
  let REL(x0, x1) := !(((((flags = int_add(x86_64_linux.MAP_PRIVATE, x86_64_linux.MAP_ANONYMOUS) || flags = int_add(int_add(x86_64_linux.MAP_PRIVATE, x86_64_linux.MAP_ANONYMOUS), x86_64_linux.MAP_FIXED)) &&
      int_lt(prot, 8)) && 0 = 0) && mallocng_specs.errno_ok(app(x0, "vm"), app(x0, "objs"), app(x0, "fs_base"))) &&
      ite(flags = int_add(int_add(x86_64_linux.MAP_PRIVATE, x86_64_linux.MAP_ANONYMOUS), x86_64_linux.MAP_FIXED), gimple.sys_pages_ok(app(x0, "vm"), app(x0, "objs"), x86_64_linux.page_of(addr), x86_64_linux.pages_for(len)) &&
        mallocng_specs.tls_off(app(x0, "fs_base"), x86_64_linux.page_of(addr), x86_64_linux.pages_for(len)), addr = 0)) ||
    REL2(x0, x1)
  let ER(x2, x4) := any_rel(x5. x5 in omega && (x5 = x86_64_linux.ENOMEM || x5 = x86_64_linux.EINVAL), x5. letin(fn_update(fst(out_state(x4)), "vm",
    mallocng_specs.wr32(app(fst(out_state(x4)), "vm"), mallocng_specs.errno_at(app(fst(out_state(x4)), "fs_base")), x5)), x6. x2 = exc(pair(x6, empty), pair("ret", bits_of_int(64, int_sub(int_pow(2, 64), 1))))))
  let C4(x2, x4) := (fst(x4) = 0 && ER(x2, x4)) || ((((fst(x4) = 1 && fst(out_value(x4)) = "ret") && x2 = exc(pair(fst(out_state(x4)), empty), pair("ret", snd(out_value(x4))))) ||
    ((fst(x4) = 1 && fst(out_value(x4)) = "raise") && x2 = exc(pair(fst(out_state(x4)), empty), pair("raise", snd(out_value(x4)))))) || (fst(x4) = 2 && x2 = diverge(snd(x4))))
  // (the memory V: such a memory there is, the havoc's)
  let X9 := ok(pair(W, empty), empty)
  have d9: D9(N, p, V) by simp(hV, hfp, hbk)
  have e9: ex x10. D9(N, p, x10) by ex_intro({V}, d9)
  have a9 := apply(ms.any_i[d := x10. D9(N, p, x10), k := x10. letin(fn_update(s, "vm", x10), x11. X9 = ok(pair(x11, empty), empty)), a := V], d9,
    (letin(W, x11. X9 = ok(pair(x11, empty), empty)) by defs(refl({X9}), letin)))
  have h9: H9(N, p, X9) by taut(e9, a9)
  have k9: K9(p, X, X9) by simp()
  have b9: ex x9. H9(N, p, x9) && K9(p, X, x9) by ex_intro({X9}, taut(h9, k9))
  have pl: PL(p) by taut(hpo, hpl)
  have a7 := apply(ms.any_i[d := x7. PL(x7), k := x7. letin(x7, x8. ex x9. H9(N, x8, x9) && K9(x8, X, x9)), a := p], pl,
    (letin(p, x8. ex x9. H9(N, x8, x9) && K9(x8, X, x9)) by defs(b9, letin)))
  have b5: X = ok(pair(s, empty), empty) || letin(N, x6. A7(x6, X)) by taut((letin(N, x6. A7(x6, X)) by defs(a7, letin)))
  have c5: C5(X, X) by simp()
  have e5: ex x5. (x5 = ok(pair(s, empty), empty) || letin(N, x6. A7(x6, x5))) && C5(X, x5) by ex_intro({X}, taut(b5, c5))
  have exp: EXP by ex_intro({p}, pl)
  have c4: C4(X, X) by simp(keep(any_rel))
  have e4: ex x4. ((EXP && (ex x5. (x5 = ok(pair(s, empty), empty) || letin(N, x6. A7(x6, x5))) && C5(x4, x5))) || (!EXP && x4 = ok(pair(s, empty), empty))) && C4(X, x4)
    by ex_intro({X}, taut(exp, e5, c4))
  have d2: (fst(X) = 0 && O = ok(fst(out_state(X)), empty)) || ((((fst(X) = 1 && fst(out_value(X)) = "ret") && O = ok(fst(out_state(X)), snd(out_value(X)))) ||
      ((fst(X) = 1 && fst(out_value(X)) = "raise") && O = exc(fst(out_state(X)), snd(out_value(X))))) || (fst(X) = 2 && O = diverge(snd(X)))) by simp()
  have rel2: REL2(s, O) by defs(ex_intro({X}, taut(expand(e4, letin), d2)), letin)
  have rel: REL(s, O) by taut(rel2)
  have pu: pair(s, O) in univ(1) by simp(hu, vu)
  show by defs(apply(tr.runs_intro[r := x0 x1. REL(x0, x1)], {s}, {O}, pu, rel), mallocng_specs.mmap_spec)
qed

// (... errno e -- ENOMEM or EINVAL -- written, -1: whether there is a place
