// The context's code: the lock, a_cas, the bounce counters, the
// sequence byte, errno, activate_group's run.

// ----------------------------------------------------------------------
//  The lock
// C2 of upgradelock: nothing done
theorem ms.upgradelock_c2: refines(c_src_malloc_mallocng_malloc.upgradelock(), mallocng_specs.upgradelock_spec(), abi.World)
proof
  show proof
    fix s o
    assume hw hr
    have pu := apply(g.runs_univ, hr)
    have vV vfun vdom .. := apply(ms.world_parts, hw)
    have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], vfun, vdom)
    step oe from hr
    show by simp(oe, pu, ss, keep(abi.overflow))
  qed
qed

// upgradelock as a C function value: its register wrapper refines the spec's
theorem ms.upgradelock_fun_c2: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
  runs(c_src_malloc_mallocng_malloc.upgradelock_fun()[regs], s, o) -> runs(mallocng_specs.upgradelock_spec_fun()[regs], s, o)
proof
  show by defs(apply(g.fun_void0, ms.upgradelock_c2), c_src_malloc_mallocng_malloc.upgradelock_fun, mallocng_specs.upgradelock_spec_fun)
qed

// C2 of resetlock: the lock word 0
theorem ms.resetlock_c2: refines(c_src_malloc_mallocng_malloc.resetlock(), mallocng_specs.resetlock_spec(c_src_malloc_mallocng_malloc.__malloc_lock), abi.World)
proof
  show proof
    fix s o
    assume hw hr
    let LK := c_src_malloc_mallocng_malloc.__malloc_lock
    let SPEC := mallocng_specs.resetlock_spec(LK)
    let V0 := s.vm
    have pu := apply(g.runs_univ, hr)
    have hu: s in univ(1) by simp(pu)
    have np: !mallocng_specs.resetlock_pre(V0, s.objs, LK) -> runs(SPEC, s, o) proof
      assume hn
      show by simp(pu, hn, keep(abi.overflow, mallocng_specs.resetlock_pre))
    qed
    have yp: mallocng_specs.resetlock_pre(V0, s.objs, LK) -> runs(SPEC, s, o) proof
      assume hp
      have lnz lr lu := expand(hp, mallocng_specs.resetlock_pre)
      have lb: LK in bits(64) by defs(simp(), c_src_malloc_mallocng_malloc.__malloc_lock)
      have md: g.mem_defined(s, LK, 0, 4, true) by simp(lnz, lu, lr, lb)
      step oe from hr with ms.st32_det using conj(hw, hu, lb, md)
      show by simp(oe, pu, hp, ms.v_wr32, keep(abi.overflow, mallocng_specs.resetlock_pre))
    qed
    show by taut(np, yp)
  qed
qed

// resetlock as a C function value: its register wrapper refines the spec's
theorem ms.resetlock_fun_c2: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
  runs(c_src_malloc_mallocng_malloc.resetlock_fun()[regs], s, o) -> runs(mallocng_specs.resetlock_spec_fun(c_src_malloc_mallocng_malloc.__malloc_lock)[regs], s, o)
proof
  show by defs(apply(g.fun_void0, ms.resetlock_c2), c_src_malloc_mallocng_malloc.resetlock_fun, mallocng_specs.resetlock_spec_fun)
qed

// ----------------------------------------------------------------------
//  The compare-and-swap
// cas32's one outcome: the word read, written back (x if it held t), its
// old value
theorem ms.cas32_det: all s p t x. s in abi.World -> s in univ(1) -> p in bits(64) -> g.mem_defined(s, p, 0, 4, false) -> g.mem_defined(s, p, 0, 4, true) ->
  g.det(gimple.cas32(p, t, x), s, ok(fn_update(s, "vm", fn_update(s.vm, "bytes", x86_64_linux.store_le(s.vm.bytes, int_add(p, 0), 4,
    ite(bits_of_int(32, gimple.bytes_at(s.vm, int_add(p, 0), 4)) = t, x, bits_of_int(32, gimple.bytes_at(s.vm, int_add(p, 0), 4)))))),
    bits_of_int(32, gimple.bytes_at(s.vm, int_add(p, 0), 4))))
proof
  fix s p t x
  assume hw hs hp hr hwr
  let OLD := bits_of_int(32, gimple.bytes_at(s.vm, int_add(p, 0), 4))
  have z: 0 in bits(32) by simp()
  have ld := apply(g.ld32_det, {s}, {p}, {0}, hs, hp, z, hr)
  have st := apply(ms.st32_det, {s}, {p}, {0}, {ite(OLD = t, x, OLD)}, hw, hs, hp, z, hwr)
  show proof
    fix o
    assume h
    have b1 := apply(g.bind_inv, apply(g.runs_elim, expand(h, gimple.cas32)), ld)
    show := apply(g.bind_inv, expand(b1, letin), st)
  qed
qed

// C2 of a_cas: the word read, written (s if it held t, else itself), its
// old value returned
theorem ms.a_cas_c2: all p t x. p in bits(64) -> t in bits(32) -> x in bits(32) ->
  refines(c_src_malloc_mallocng_malloc.a_cas(p, t, x), mallocng_specs.a_cas_spec(p, t, x), abi.World)
proof
  fix p t x
  assume hp ht hx
  show proof
    fix s o
    assume hw hr
    let SPEC := mallocng_specs.a_cas_spec(p, t, x)
    let V0 := s.vm
    have pu := apply(g.runs_univ, hr)
    have hu: s in univ(1) by simp(pu)
    have np: !mallocng_specs.a_cas_pre(V0, s.objs, p) -> runs(SPEC, s, o) proof
      assume hn
      show by simp(pu, hn, keep(abi.overflow, mallocng_specs.a_cas_pre))
    qed
    have yp: mallocng_specs.a_cas_pre(V0, s.objs, p) -> runs(SPEC, s, o) proof
      assume hpre
      have pnz p4 ur uw := expand(hpre, mallocng_specs.a_cas_pre)
      have p64: pow2(64) = 18446744073709551616 by simp()
      have mr: g.mem_defined(s, p, 0, 4, false) by simp(pnz, p4, ur, p64, hp)
      have mw: g.mem_defined(s, p, 0, 4, true) by simp(pnz, p4, uw, p64, hp)
      have _ _ _ pb := apply(ms.world_parts, hw)
      have bo bl := mp(all_elim(g.bytes_bound, {V0}, {int_add(p, 0)}, {4}), pb, arith())
      let B := gimple.bytes_at(V0, int_add(p, 0), 4)
      have xb: bits_of_int(32, B) = B by defs(arith(bo, bl), bits_of_int, pow2)
      step x1, oe from hr with ms.cas32_det using conj(hw, hu, hp, ht, hx, mr, mw)
      // (the address p + 0, the word its bytes)
      have e1: bits_add(64, p, 0) = p by defs(arith(hp), bits_add, pow2)
      have co cl := mp(all_elim(g.bytes_bound, {V0}, {p}, {4}), pb, arith())
      have e2g: all b. b in omega -> int_lt(b, int_pow(256, 4)) -> bits_add(32, b, 0) = b proof
        fix b
        assume h1 h2
        have p32: int_pow(2, 32) = 4294967296 by simp()
        have p4: int_pow(256, 4) = 4294967296 by simp()
        show by defs(arith(h1, h2, p32, p4), bits_add, pow2)
      qed
      have e2 := mp(all_elim(e2g, {gimple.bytes_at(V0, p, 4)}), co, cl)
      show by simp(oe, pu, hpre, xb, e1, e2, ms.v_wr32, keep(abi.overflow, mallocng_specs.a_cas_pre))
    qed
    show by taut(np, yp)
  qed
qed

// a_cas as a C function value: its register wrapper refines the spec's
theorem ms.a_cas_fun_c2: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
  runs(c_src_malloc_mallocng_malloc.a_cas_fun()[regs], s, o) -> runs(mallocng_specs.a_cas_spec_fun()[regs], s, o)
proof
  have hm: all regs. refines(c_src_malloc_mallocng_malloc.a_cas(bits_of_int(64, regs[0]), bits_of_int(32, regs[1]), bits_of_int(32, regs[2])),
      mallocng_specs.a_cas_spec(bits_of_int(64, regs[0]), bits_of_int(32, regs[1]), bits_of_int(32, regs[2])), abi.World) proof
    fix regs
    show := mp(all_elim(ms.a_cas_c2, {bits_of_int(64, regs[0])}, {bits_of_int(32, regs[1])}, {bits_of_int(32, regs[2])}), simp(), simp(), simp())
  qed
  show by defs(apply(g.fun_res[n := 3, w := 32], hm), c_src_malloc_mallocng_malloc.a_cas_fun, mallocng_specs.a_cas_spec_fun, letin)
qed

// ----------------------------------------------------------------------
//  The bounce counters
// (size class sc's bounce counter: sc - 7 in 32 bits, its address)
theorem ms.bounce_idx: all sc. sc in bits(32) ->
  (mallocng_specs.bouncing_class(sc) -> bits_add(32, sc, bits_neg(32, 7)) = int_sub(sc, 7) && int_le(bits_add(32, sc, bits_neg(32, 7)), 31) &&
     tr.s32_fits(int_add(sint(32, sc), sint(32, bits_neg(32, 7)))) && bits_sext(32, 64, int_sub(sc, 7)) = int_sub(sc, 7)) &&
  (!mallocng_specs.bouncing_class(sc) -> !int_le(bits_add(32, sc, bits_neg(32, 7)), 31))
proof
  fix sc
  assume hsc
  have p32: pow2(32) = 4294967296 by simp()
  have bn: bits_neg(32, 7) = 4294967289 by defs(simp(), bits_neg)
  have ba: bits_add(32, sc, bits_neg(32, 7)) = int_mod(int_add(sc, 4294967289), 4294967296) by defs(simp(bn, p32), bits_add)
  have c1: mallocng_specs.bouncing_class(sc) -> bits_add(32, sc, bits_neg(32, 7)) = int_sub(sc, 7) && int_le(bits_add(32, sc, bits_neg(32, 7)), 31) &&
      tr.s32_fits(int_add(sint(32, sc), sint(32, bits_neg(32, 7)))) && bits_sext(32, 64, int_sub(sc, 7)) = int_sub(sc, 7) proof
    assume h
    have lo hi := expand(h, mallocng_specs.bouncing_class)
    have e: bits_add(32, sc, bits_neg(32, 7)) = int_sub(sc, 7) by arith(ba, lo, hi, hsc)
    have ssc: sint(32, sc) = sc by defs(simp(hsc, hi), sint)
    have s7: sint(32, bits_neg(32, 7)) = int_neg(7) by defs(simp(bn), sint)
    have f: tr.s32_fits(int_add(sint(32, sc), sint(32, bits_neg(32, 7)))) by defs(simp(ssc, s7, lo, hi), gimple.fits)
    have xb: int_sub(sc, 7) in bits(32) by arith(lo, hi, hsc)
    have x := apply(ms.sext_small, xb, arith(lo, hi))
    show by taut(e, (int_le(bits_add(32, sc, bits_neg(32, 7)), 31) by arith(e, hi)), f, x)
  qed
  have c2: !mallocng_specs.bouncing_class(sc) -> !int_le(bits_add(32, sc, bits_neg(32, 7)), 31) proof
    assume h
    have h2: !(int_le(7, sc) && int_le(sc, 38)) by defs(h, mallocng_specs.bouncing_class)
    show by arith(ba, h2, hsc)
  qed
  show conj(c1, c2)
qed

// is_bouncing's run, its precondition holding: a class out of 7 .. 38, 0;
// else whether its counter (read at the address the code forms, A) is
// above 99
theorem ms.ib_run: all sc s o. sc in bits(32) -> s in abi.World -> mallocng_specs.bounce_pre(s.vm, s.objs, c_src_malloc_mallocng_malloc.__malloc_context, sc, false) ->
  runs(c_src_malloc_mallocng_malloc.is_bouncing(sc), s, o) ->
  o = ok(s, ite(mallocng_specs.bouncing_class(sc) && int_lt(99, gimple.bytes_at(s.vm, mallocng_specs.bounce_at(c_src_malloc_mallocng_malloc.__malloc_context, sc), 1)), 1, 0))
proof
  fix sc s o
  assume hsc hw hp hr
  let CTX := c_src_malloc_mallocng_malloc.__malloc_context
  let V0 := s.vm
  let GOAL := o = ok(s, ite(mallocng_specs.bouncing_class(sc) && int_lt(99, gimple.bytes_at(V0, mallocng_specs.bounce_at(CTX, sc), 1)), 1, 0))
  let T64 := fn_update(fn_update(empty, "prec", 64), "signed", true)
  have pu := apply(g.runs_univ, hr)
  have hu: s in univ(1) by simp(pu)
  have cnz c913 cu := expand(hp, mallocng_specs.bounce_pre)
  have cv: CTX = 4227328 by defs(simp(), c_src_malloc_mallocng_malloc.__malloc_context)
  have bi1 bi2 := apply(ms.bounce_idx, hsc)
  // no counter: 0
  have out: !mallocng_specs.bouncing_class(sc) -> GOAL proof
    assume h
    have nl := mp(bi2, h)
    step x1 x2 x3, oe from hr with nl
    show by simp(oe, pu, hp, h, keep(abi.overflow, mallocng_specs.bounce_pre, mallocng_specs.bouncing_class, mallocng_specs.bounce_at))
  qed
  // a counter: its byte, as the code addresses it (A)
  have inr: mallocng_specs.bouncing_class(sc) -> GOAL proof
    assume h
    have be _ bf bsx := mp(bi1, h)
    have lo hi := expand(h, mallocng_specs.bouncing_class)
    have ur := mp(cu, h)
    have sv: gimple.sval(T64, 880) = 880 by defs(simp(), gimple.sval)
    have bsx2: bits_sext(32, 64, bits_add(32, sc, bits_neg(32, 7))) = int_sub(sc, 7) := rewrite(sym(be), bsx, {1})
    let A := int_add(int_add(int_add(CTX, gimple.sval(T64, 880)), bits_sext(32, 64, bits_add(32, sc, bits_neg(32, 7)))), 0)
    have p64: pow2(64) = 18446744073709551616 by simp()
    have ab: mallocng_specs.bounce_at(CTX, sc) = A by defs(arith(sv, bsx2, cv, lo, hi, p64), mallocng_specs.bounce_at, bits_of_int)
    have ur1 _ := ur
    have ua := rewrite(ab, ur1)
    have _ _ _ pb := apply(ms.world_parts, hw)
    have bo bl := mp(all_elim(g.bytes_bound, {V0}, {A}, {1}), pb, arith())
    let B := gimple.bytes_at(V0, A, 1)
    have xb: bits_of_int(8, B) = B by defs(arith(bo, bl), bits_of_int, pow2)
    let X := bits_of_int(8, B)
    have F := conj(hu, hsc, cv, sv, bsx2, be, lo, hi, ua, p64, bf)
    // (the counter's branch: sc - 7 <= 31, from the facts)
    have big: int_lt(99, X) -> GOAL proof
      assume hb
      step x1 x2 x3 x4, oe from hr with g.sadd32_det, g.padd_det, g.elem1_det, g.ld8_det, hb using F
      show by simp(oe, pu, hp, h, ab, xb, hb, keep(abi.overflow, mallocng_specs.bounce_pre, mallocng_specs.bouncing_class, mallocng_specs.bounce_at))
    qed
    have small: !int_lt(99, X) -> GOAL proof
      assume hb
      step x1 x2 x3 x4, oe from hr with g.sadd32_det, g.padd_det, g.elem1_det, g.ld8_det, hb using F
      show by simp(oe, pu, hp, h, ab, xb, hb, keep(abi.overflow, mallocng_specs.bounce_pre, mallocng_specs.bouncing_class, mallocng_specs.bounce_at))
    qed
    show by taut(big, small)
  qed
  show by taut(out, inr)
qed

// decay_bounces' run, its precondition holding: the counter less 1 unless
// 0 (or no counter: `decay_vm`)
theorem ms.db_run: all sc s o. sc in bits(32) -> s in abi.World -> mallocng_specs.bounce_pre(s.vm, s.objs, c_src_malloc_mallocng_malloc.__malloc_context, sc, true) ->
  runs(c_src_malloc_mallocng_malloc.decay_bounces(sc), s, o) ->
  o = ok(fn_update(s, "vm", mallocng_specs.decay_vm(s.vm, c_src_malloc_mallocng_malloc.__malloc_context, sc)), empty)
proof
  fix sc s o
  assume hsc hw hp hr
  let CTX := c_src_malloc_mallocng_malloc.__malloc_context
  let V0 := s.vm
  let GOAL := o = ok(fn_update(s, "vm", mallocng_specs.decay_vm(V0, CTX, sc)), empty)
  let T64 := fn_update(fn_update(empty, "prec", 64), "signed", true)
  have pu := apply(g.runs_univ, hr)
  have hu: s in univ(1) by simp(pu)
  have vV vfun vdom .. := apply(ms.world_parts, hw)
  have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], vfun, vdom)
  have cnz c913 cu := expand(hp, mallocng_specs.bounce_pre)
  have cv: CTX = 4227328 by defs(simp(), c_src_malloc_mallocng_malloc.__malloc_context)
  have bi1 bi2 := apply(ms.bounce_idx, hsc)
  // no counter: nothing
  have out: !mallocng_specs.bouncing_class(sc) -> GOAL proof
    assume h
    have nl := mp(bi2, h)
    step x1, oe from hr with nl
    have dv: mallocng_specs.decay_vm(V0, CTX, sc) = V0 by defs(simp(h, keep(mallocng_specs.bouncing_class)), mallocng_specs.decay_vm)
    show by simp(oe, pu, hp, h, ss, dv, keep(abi.overflow, mallocng_specs.bounce_pre, mallocng_specs.bouncing_class, mallocng_specs.bounce_at, mallocng_specs.decay_vm))
  qed
  // a counter: its byte, as the code addresses it (A); decremented unless 0
  have inr: mallocng_specs.bouncing_class(sc) -> GOAL proof
    assume h
    have be _ bf bsx := mp(bi1, h)
    have lo hi := expand(h, mallocng_specs.bouncing_class)
    have ur := mp(cu, h)
    have sv: gimple.sval(T64, 880) = 880 by defs(simp(), gimple.sval)
    have bsx2: bits_sext(32, 64, bits_add(32, sc, bits_neg(32, 7))) = int_sub(sc, 7) := rewrite(sym(be), bsx, {1})
    let A := int_add(int_add(int_add(CTX, gimple.sval(T64, 880)), bits_sext(32, 64, bits_add(32, sc, bits_neg(32, 7)))), 0)
    have p64: pow2(64) = 18446744073709551616 by simp()
    have ab: mallocng_specs.bounce_at(CTX, sc) = A by defs(arith(sv, bsx2, cv, lo, hi, p64), mallocng_specs.bounce_at, bits_of_int)
    have ur1 ur2 := ur
    have ua := rewrite(ab, ur1)
    have uw := rewrite(ab, mp(ur2, taut()))
    have _ _ _ pb := apply(ms.world_parts, hw)
    have bo bl := mp(all_elim(g.bytes_bound, {V0}, {A}, {1}), pb, arith())
    let B := gimple.bytes_at(V0, A, 1)
    have xb: bits_of_int(8, B) = B by defs(arith(bo, bl), bits_of_int, pow2)
    let X := bits_of_int(8, B)
    have F := conj(hu, hw, hsc, cv, sv, bsx2, be, lo, hi, ua, uw, p64, bf)
    have nz: !(X = 0) -> GOAL proof
      assume hz
      step x1 x2, oe from hr with g.sadd32_det, g.padd_det, g.elem1_det, g.ld8_det, ms.st8_det, hz using F
      have b1: int_le(1, B) by arith(hz, xb, bo)
      have dec: bits_add(8, X, bits_neg(8, 1)) = int_sub(B, 1) by defs(simp(xb, b1, bl), bits_add, bits_neg)
      have dv: mallocng_specs.decay_vm(V0, CTX, sc) = mallocng_specs.wr8(V0, A, int_sub(B, 1)) by defs(simp(h, ab, xb, hz, keep(mallocng_specs.bouncing_class, mallocng_specs.wr8)), mallocng_specs.decay_vm)
      show by simp(oe, pu, hp, h, ab, xb, hz, dec, dv, ms.v_wr8, keep(abi.overflow, mallocng_specs.bounce_pre, mallocng_specs.bouncing_class, mallocng_specs.bounce_at, mallocng_specs.decay_vm))
    qed
    have zr: X = 0 -> GOAL proof
      assume hz
      step x1 x2, oe from hr with g.sadd32_det, g.padd_det, g.elem1_det, g.ld8_det, hz using F
      have bz: gimple.bytes_at(V0, mallocng_specs.bounce_at(CTX, sc), 1) = 0 by simp(rewrite(sym(ab), rewrite(xb, hz)))
      have dv: mallocng_specs.decay_vm(V0, CTX, sc) = V0 by defs(simp(bz, keep(mallocng_specs.bouncing_class, mallocng_specs.bounce_at, mallocng_specs.wr8)), mallocng_specs.decay_vm)
      show by simp(oe, pu, hp, h, ab, xb, hz, ss, dv, keep(abi.overflow, mallocng_specs.bounce_pre, mallocng_specs.bouncing_class, mallocng_specs.bounce_at, mallocng_specs.decay_vm))
    qed
    have cz: X = 0 || !(X = 0) by taut()
    show by taut(cz, zr, nz)
  qed
  show by taut(out, inr)
qed

// (two bytes' difference, as a signed word: the integers')
theorem ms.sint_sub_small: all a b. a in omega -> b in omega -> int_lt(a, 256) -> int_lt(b, 256) -> sint(32, bits_sub(32, a, b)) = int_sub(a, b)
proof
  fix a b
  assume ha hb la lb
  let X := bits_sub(32, a, b)
  have xe: X = int_mod(int_sub(a, b), 4294967296) by defs(simp(), bits_sub, pow2)
  have xb: X in bits(32) := mp(all_elim(nf.sub_in, {32}, {a}, {b}), simp())
  have sx: (int_lt(X, 2147483648) && sint(32, X) = X) || (!int_lt(X, 2147483648) && sint(32, X) = int_sub(X, 4294967296)) by defs(simp(xb), sint, letin, pow2)
  have c1: int_lt(X, 2147483648) && sint(32, X) = X -> sint(32, X) = int_sub(a, b) proof
    assume h
    have e: sint(32, X) = X by taut(h)
    have v: X = int_sub(a, b) by arith(xe, ha, hb, la, lb, h)
    show := trans(e, v)
  qed
  have c2: !int_lt(X, 2147483648) && sint(32, X) = int_sub(X, 4294967296) -> sint(32, X) = int_sub(a, b) proof
    assume h
    have e: sint(32, X) = int_sub(X, 4294967296) by taut(h)
    have v: int_sub(X, 4294967296) = int_sub(a, b) by arith(xe, ha, hb, la, lb, h)
    show := trans(e, v)
  qed
  show by taut(sx, c1, c2)
qed

// account_bounce's run, its precondition holding: a counter whose class
// was unmapped lately (its unmap sequence byte U not 0, the sequence byte
// S at most U + 9) up by 1 below 99, else 150; otherwise nothing
// (`account_vm`)
theorem ms.ab_run: all sc s o. sc in bits(32) -> s in abi.World -> mallocng_specs.account_bounce_pre(s.vm, s.objs, c_src_malloc_mallocng_malloc.__malloc_context, sc) ->
  runs(c_src_malloc_mallocng_malloc.account_bounce(sc), s, o) ->
  o = ok(fn_update(s, "vm", mallocng_specs.account_vm(s.vm, c_src_malloc_mallocng_malloc.__malloc_context, sc)), empty)
proof
  fix sc s o
  assume hsc hw hp hr
  let CTX := c_src_malloc_mallocng_malloc.__malloc_context
  let V0 := s.vm
  let GOAL := o = ok(fn_update(s, "vm", mallocng_specs.account_vm(V0, CTX, sc)), empty)
  let T64 := fn_update(fn_update(empty, "prec", 64), "signed", true)
  have pu := apply(g.runs_univ, hr)
  have hu: s in univ(1) by simp(pu)
  have vV vfun vdom .. := apply(ms.world_parts, hw)
  have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], vfun, vdom)
  // (not bounced: nothing)
  have same: !mallocng_specs.bounced(V0, CTX, sc) -> mallocng_specs.account_vm(V0, CTX, sc) = V0 proof
    assume nb
    show by defs(simp(nb, keep(mallocng_specs.bounced, mallocng_specs.wr8, mallocng_specs.bounce_at)), mallocng_specs.account_vm)
  qed
  have hb0 hb1 := expand(hp, mallocng_specs.account_bounce_pre)
  have cnz c913 cu := expand(hb0, mallocng_specs.bounce_pre)
  have cv: CTX = 4227328 by defs(simp(), c_src_malloc_mallocng_malloc.__malloc_context)
  have cb: CTX in bits(64) by defs(simp(), c_src_malloc_mallocng_malloc.__malloc_context)
  have p64: pow2(64) = 18446744073709551616 by simp()
  have bi1 bi2 := apply(ms.bounce_idx, hsc)
  // no counter: nothing
  have out: !mallocng_specs.bouncing_class(sc) -> GOAL proof
    assume h
    have nl := mp(bi2, h)
    have nb: !mallocng_specs.bounced(V0, CTX, sc) by defs(taut(h), mallocng_specs.bounced)
    step x0 x1, oe from hr with nl
    show by simp(oe, ss, mp(same, nb))
  qed
  // a counter: the unmap sequence byte U, the sequence byte S, the
  // counter B -- each as the code addresses it
  have inr: mallocng_specs.bouncing_class(sc) -> GOAL proof
    assume h
    have be _ bf bsx := mp(bi1, h)
    have lo hi := expand(h, mallocng_specs.bouncing_class)
    have ur1 ur2 := mp(cu, h)
    have uu1 us1 := mp(hb1, h)
    have sv: gimple.sval(T64, 880) = 880 by defs(simp(), gimple.sval)
    have svu: gimple.sval(T64, 848) = 848 by defs(simp(), gimple.sval)
    have bsx2: bits_sext(32, 64, bits_add(32, sc, bits_neg(32, 7))) = int_sub(sc, 7) := rewrite(sym(be), bsx, {1})
    let A := int_add(int_add(int_add(CTX, gimple.sval(T64, 880)), bits_sext(32, 64, bits_add(32, sc, bits_neg(32, 7)))), 0)
    let AU := int_add(int_add(int_add(CTX, gimple.sval(T64, 848)), bits_sext(32, 64, bits_add(32, sc, bits_neg(32, 7)))), 0)
    have ab: mallocng_specs.bounce_at(CTX, sc) = A by defs(arith(sv, bsx2, cv, lo, hi, p64), mallocng_specs.bounce_at, bits_of_int)
    have au: mallocng_specs.unmap_seq_at(CTX, sc) = AU by defs(arith(svu, bsx2, cv, lo, hi, p64), mallocng_specs.unmap_seq_at, bits_of_int)
    have ua := rewrite(ab, ur1)
    have uw := rewrite(ab, mp(ur2, taut()))
    have uu := rewrite(au, uu1)
    have mr: g.mem_defined(s, CTX, 912, 1, false) by simp(cnz, c913, us1, p64)
    have _ _ _ pb := apply(ms.world_parts, hw)
    have bo bl := mp(all_elim(g.bytes_bound, {V0}, {A}, {1}), pb, arith())
    have uo ul := mp(all_elim(g.bytes_bound, {V0}, {AU}, {1}), pb, arith())
    have so sl := mp(all_elim(g.bytes_bound, {V0}, {int_add(CTX, 912)}, {1}), pb, arith())
    let B := gimple.bytes_at(V0, A, 1)
    let U := gimple.bytes_at(V0, AU, 1)
    let S := gimple.bytes_at(V0, int_add(CTX, 912), 1)
    have xb: bits_of_int(8, B) = B by defs(arith(bo, bl), bits_of_int, pow2)
    have xu: bits_of_int(8, U) = U by defs(arith(uo, ul), bits_of_int, pow2)
    have xs: bits_of_int(8, S) = S by defs(arith(so, sl), bits_of_int, pow2)
    have sq: mallocng_specs.seq_at(CTX) = int_add(CTX, 912) by defs(arith(cv, p64), mallocng_specs.seq_at, bits_add, pow2)
    // (S - U as the code computes it: a signed word, fitting)
    let SX := bits_of_int(8, S)
    let UX := bits_of_int(8, U)
    have sxo: SX in omega by arith(xs, so)
    have uxo: UX in omega by arith(xu, uo)
    have sxl: int_lt(SX, 256) by arith(xs, so, sl)
    have uxl: int_lt(UX, 256) by arith(xu, uo, ul)
    have sd := mp(all_elim(ms.sint_sub_small, {SX}, {UX}), sxo, uxo, sxl, uxl)
    have s9: sint(32, 9) = 9 by defs(simp(), sint)
    have ssx: sint(32, SX) = SX by defs(simp(sxo, sxl), sint)
    have sux: sint(32, UX) = UX by defs(simp(uxo, uxl), sint)
    have fs: tr.s32_fits(int_sub(sint(32, SX), sint(32, UX))) by defs(simp(ssx, sux, sxo, sxl, uxo, uxl), gimple.fits)
    have F := conj(hu, hw, hsc, cv, cb, sv, svu, bsx2, be, lo, hi, ua, uw, uu, mr, p64, bf, xb, xu, xs, fs)
    // U 0: nothing
    have z0: U = 0 -> GOAL proof
      assume hz
      have nb: !mallocng_specs.bounced(V0, CTX, sc) by defs(simp(au, hz), mallocng_specs.bounced)
      step x0 x1 x2, oe from hr with g.sadd32_det, g.padd_det, g.elem1_det, g.ld8_det, hz using F
      show by simp(oe, ss, mp(same, nb))
    qed
    // S past U + 9: nothing
    have far: !(U = 0) -> !int_le(S, int_add(U, 9)) -> GOAL proof
      assume hz hf
      have nb: !mallocng_specs.bounced(V0, CTX, sc) by defs(simp(au, sq, hf), mallocng_specs.bounced)
      have hc: !int_le(sint(32, bits_sub(32, SX, UX)), sint(32, 9)) by arith(sd, s9, hf, xs, xu)
      step x0 x1 x2 x3, oe from hr with g.sadd32_det, g.padd_det, g.elem1_det, g.ld8_det, g.ssub32_det, hz, hc using F
      show by simp(oe, ss, mp(same, nb))
    qed
    // bounced: the counter up by 1 below 99, else 150
    have near: !(U = 0) -> int_le(S, int_add(U, 9)) -> GOAL proof
      assume hz hn
      have yb: mallocng_specs.bounced(V0, CTX, sc) by defs(simp(au, sq, h, hz, hn), mallocng_specs.bounced)
      have hc: int_le(sint(32, bits_sub(32, SX, UX)), sint(32, 9)) by arith(sd, s9, hn, xs, xu)
      have up: int_le(B, 98) -> GOAL proof
        assume hb
        step x0 x1 x2 x3 x4, oe from hr with g.sadd32_det, g.padd_det, g.elem1_det, g.ld8_det, g.ssub32_det, ms.st8_det, hz, hc, hb using F
        have incg: all b. b in omega -> int_le(b, 98) -> bits_add(8, b, 1) = int_add(b, 1) proof
          fix b
          assume h1 h2
          have p8: int_pow(2, 8) = 256 by simp()
          show by defs(arith(h1, h2, p8), bits_add, pow2)
        qed
        have inc := mp(all_elim(incg, {B}), bo, hb)
        have av: mallocng_specs.account_vm(V0, CTX, sc) = mallocng_specs.wr8(V0, mallocng_specs.bounce_at(CTX, sc), int_add(B, 1))
          by defs(simp(yb, ab, hb, keep(mallocng_specs.bounced, mallocng_specs.wr8, mallocng_specs.bounce_at)), mallocng_specs.account_vm)
        show by simp(oe, ab, inc, av, ms.v_wr8, keep(mallocng_specs.bounce_at))
      qed
      have top: !int_le(B, 98) -> GOAL proof
        assume hb
        step x0 x1 x2 x3 x4, oe from hr with g.sadd32_det, g.padd_det, g.elem1_det, g.ld8_det, g.ssub32_det, ms.st8_det, hz, hc, hb using F
        have n106: bits_neg(8, 106) = 150 by defs(simp(), bits_neg)
        have av: mallocng_specs.account_vm(V0, CTX, sc) = mallocng_specs.wr8(V0, mallocng_specs.bounce_at(CTX, sc), 150)
          by defs(simp(yb, ab, hb, keep(mallocng_specs.bounced, mallocng_specs.wr8, mallocng_specs.bounce_at)), mallocng_specs.account_vm)
        show by simp(oe, ab, n106, av, ms.v_wr8, keep(mallocng_specs.bounce_at))
      qed
      show by taut(up, top)
    qed
    show by taut(z0, far, near)
  qed
  show by taut(out, inr)
qed

// ----------------------------------------------------------------------
//  The sequence byte
// zeroing i bytes at a, then the byte at a + i: zeroing i + 1 bytes
theorem ms.zero_grow: all b a i. a in bits(64) -> i in omega -> int_le(int_add(int_add(a, i), 1), pow2(64)) ->
  x86_64_linux.store_le(x86_64_linux.store_le(b, a, i, 0), int_add(a, i), 1, 0) = x86_64_linux.store_le(b, a, int_add(i, 1), 0)
proof
  fix b a i
  assume ha hi hl
  have p64: pow2(64) = 18446744073709551616 by simp()
  let IN := x86_64_linux.store_le(b, a, i, 0)
  have pt: all x. x in bits(64) ->
      ite(int_lt(bits_sub(64, x, int_add(a, i)), 1), bits_of_int(8, int_div(0, int_pow(256, bits_sub(64, x, int_add(a, i))))), IN[x]) =
      ite(int_lt(bits_sub(64, x, a), int_add(i, 1)), bits_of_int(8, int_div(0, int_pow(256, bits_sub(64, x, a)))), b[x]) proof
    fix x
    assume hx
    have ai: IN[x] = ite(int_lt(bits_sub(64, x, a), i), bits_of_int(8, int_div(0, int_pow(256, bits_sub(64, x, a)))), b[x])
      by defs(simp(hx), x86_64_linux.store_le)
    have y1: bits_sub(64, x, int_add(a, i)) in omega by defs(arith(p64), bits_sub)
    have y2: bits_sub(64, x, a) in omega by defs(arith(p64), bits_sub)
    have q1 := mp(all_elim(pow256_pos, {bits_sub(64, x, int_add(a, i))}), y1)
    have q2 := mp(all_elim(pow256_pos, {bits_sub(64, x, a)}), y2)
    have d1: int_div(0, int_pow(256, bits_sub(64, x, int_add(a, i)))) = 0 by arith(q1)
    have d2: int_div(0, int_pow(256, bits_sub(64, x, a))) = 0 by arith(q2)
    have b0: bits_of_int(8, 0) = 0 by simp()
    have z1: bits_of_int(8, int_div(0, int_pow(256, bits_sub(64, x, int_add(a, i))))) = 0 := rewrite(sym(d1), b0, {1})
    have z2: bits_of_int(8, int_div(0, int_pow(256, bits_sub(64, x, a)))) = 0 := rewrite(sym(d2), b0, {1})
    have s1: bits_sub(64, x, int_add(a, i)) = int_mod(int_sub(x, int_add(a, i)), 18446744073709551616) by defs(simp(p64), bits_sub)
    have s2: bits_sub(64, x, a) = int_mod(int_sub(x, a), 18446744073709551616) by defs(simp(p64), bits_sub)
    have at: x = int_add(a, i) -> int_lt(bits_sub(64, x, int_add(a, i)), 1) && int_lt(bits_sub(64, x, a), int_add(i, 1)) by arith(s1, s2, hx, ha, hi, hl, p64)
    have nt: !(x = int_add(a, i)) -> !int_lt(bits_sub(64, x, int_add(a, i)), 1) && (int_lt(bits_sub(64, x, a), int_add(i, 1)) <-> int_lt(bits_sub(64, x, a), i)) by arith(s1, s2, hx, ha, hi, hl, p64)
    have c1: x = int_add(a, i) -> ite(int_lt(bits_sub(64, x, int_add(a, i)), 1), bits_of_int(8, int_div(0, int_pow(256, bits_sub(64, x, int_add(a, i))))), IN[x]) =
        ite(int_lt(bits_sub(64, x, a), int_add(i, 1)), bits_of_int(8, int_div(0, int_pow(256, bits_sub(64, x, a)))), b[x]) proof
      assume e
      have t1 t2 := mp(at, e)
      show by simp(t1, t2, z1, z2)
    qed
    have c2: !(x = int_add(a, i)) -> ite(int_lt(bits_sub(64, x, int_add(a, i)), 1), bits_of_int(8, int_div(0, int_pow(256, bits_sub(64, x, int_add(a, i))))), IN[x]) =
        ite(int_lt(bits_sub(64, x, a), int_add(i, 1)), bits_of_int(8, int_div(0, int_pow(256, bits_sub(64, x, a)))), b[x]) proof
      assume e
      have t1 t2 := mp(nt, e)
      have cs: int_lt(bits_sub(64, x, a), i) || !int_lt(bits_sub(64, x, a), i) by taut()
      have k1: int_lt(bits_sub(64, x, a), i) -> ite(int_lt(bits_sub(64, x, int_add(a, i)), 1), bits_of_int(8, int_div(0, int_pow(256, bits_sub(64, x, int_add(a, i))))), IN[x]) =
          ite(int_lt(bits_sub(64, x, a), int_add(i, 1)), bits_of_int(8, int_div(0, int_pow(256, bits_sub(64, x, a)))), b[x]) proof
        assume h
        have h2: int_lt(bits_sub(64, x, a), int_add(i, 1)) by taut(t2, h)
        show by simp(t1, h, h2, ai, z2)
      qed
      have k2: !int_lt(bits_sub(64, x, a), i) -> ite(int_lt(bits_sub(64, x, int_add(a, i)), 1), bits_of_int(8, int_div(0, int_pow(256, bits_sub(64, x, int_add(a, i))))), IN[x]) =
          ite(int_lt(bits_sub(64, x, a), int_add(i, 1)), bits_of_int(8, int_div(0, int_pow(256, bits_sub(64, x, a)))), b[x]) proof
        assume h
        have h2: !int_lt(bits_sub(64, x, a), int_add(i, 1)) by taut(t2, h)
        show by simp(t1, h, h2, ai)
      qed
      show by taut(cs, k1, k2)
    qed
    have cx: x = int_add(a, i) || !(x = int_add(a, i)) by taut()
    show by taut(cx, c1, c2)
  qed
  have fe := mp(fn_build_ext[d := bits(64), f := x. ite(int_lt(bits_sub(64, x, int_add(a, i)), 1), bits_of_int(8, int_div(0, int_pow(256, bits_sub(64, x, int_add(a, i))))), IN[x]),
    g := x. ite(int_lt(bits_sub(64, x, a), int_add(i, 1)), bits_of_int(8, int_div(0, int_pow(256, bits_sub(64, x, a)))), b[x])], pt)
  show by defs(fe, x86_64_linux.store_le)
qed

// step_seq's run, its precondition holding: below 255 the byte counted
// up; at 255 the loop over i = 0 .. 32 (invariant: the first i unmap
// sequence bytes zeroed; variant 32 - i; it leaves by the break at 32),
// then the byte 1 (`step_seq_vm`)
theorem ms.sq_run: all s o. s in abi.World -> mallocng_specs.step_seq_pre(s.vm, s.objs, c_src_malloc_mallocng_malloc.__malloc_context) ->
  runs(c_src_malloc_mallocng_malloc.step_seq(), s, o) ->
  o = ok(fn_update(s, "vm", mallocng_specs.step_seq_vm(s.vm, c_src_malloc_mallocng_malloc.__malloc_context)), empty)
proof
  fix s o
  assume hw hp hr
  let CTX := c_src_malloc_mallocng_malloc.__malloc_context
  let V0 := s.vm
  let GOAL := o = ok(fn_update(s, "vm", mallocng_specs.step_seq_vm(V0, CTX)), empty)
  have pu := apply(g.runs_univ, hr)
  have hu: s in univ(1) by simp(pu)
  have cb: CTX in bits(64) by defs(simp(), c_src_malloc_mallocng_malloc.__malloc_context)
  have cnz c913 ur uw u848 := expand(hp, mallocng_specs.step_seq_pre)
  have p64: pow2(64) = 18446744073709551616 by simp()
  have mr: g.mem_defined(s, CTX, 912, 1, false) by simp(cnz, c913, ur, p64)
  have mw: g.mem_defined(s, CTX, 912, 1, true) by simp(cnz, c913, uw, p64)
  let B := gimple.bytes_at(V0, int_add(CTX, 912), 1)
  let X := bits_of_int(8, B)
  have _ _ _ pb := apply(ms.world_parts, hw)
  have bo bb := mp(all_elim(g.bytes_bound, {V0}, {int_add(CTX, 912)}, {1}), pb, arith())
  have xb: X = B by defs(arith(bo, bb), bits_of_int, pow2)
  have n255: bits_neg(8, 1) = 255 by defs(simp(), bits_neg)
  have a912: bits_add(64, CTX, 912) = int_add(CTX, 912) by defs(arith(cb, c913, p64), bits_add, pow2)
  have F := conj(hw, hu, cb, mr, mw)
  // counted up
  have up: !(X = bits_neg(8, 1)) -> GOAL proof
    assume hx
    step x1 x2, oe from hr with g.ld8_det, ms.st8_det, hx using F
    have bl: int_lt(B, 255) by arith(hx, xb, bo, bb, n255)
    have inc: bits_add(8, X, 1) = int_add(B, 1) by defs(arith(xb, bl, bo), bits_add, pow2)
    have ev: mallocng_specs.step_seq_vm(V0, CTX) = fn_update(V0, "bytes", x86_64_linux.store_le(V0.bytes, int_add(CTX, 912), 1, bits_add(8, X, 1)))
      by defs(simp(a912, xb, bl, inc, ms.v_wr8), mallocng_specs.step_seq_vm, mallocng_specs.seq_at)
    show := rewrite(sym(ev), oe)
  qed
  // at 255: the loop zeroing the unmap sequence bytes, then 1
  have wrap: X = bits_neg(8, 1) -> GOAL proof
    assume hx
    step x1 x2 x3, c from hr with g.ld8_det, hx using F
    have wl c2 := c
    let T64 := fn_update(fn_update(empty, "prec", 64), "signed", true)
    let A := int_add(CTX, gimple.sval(T64, 848))
    let B0 := V0.bytes
    let ST(i) := fn_update(s, "vm", fn_update(V0, "bytes", x86_64_linux.store_le(B0, A, i, 0)))
    let P(l) := ex i. i in omega && int_le(i, 32) && l = pair(ST(i), i)
    let M(l) := int_sub(32, snd(l))
    let BODY(l, o) := loop_body(wl)
    have sv: gimple.sval(T64, 848) = 848 by defs(simp(), gimple.sval)
    have ae: A = int_add(CTX, 848) by simp(sv)
    have ab: A in bits(64) by arith(ae, cb, c913, p64)
    have vV vf vd .. := apply(ms.world_parts, hw)
    have bf: is_fun(B0) && dom(B0) = bits(64) by simp(vV)
    have z := apply(x86.store_zero, {B0}, {A}, {0}, taut(bf), taut(bf), ab)
    have e0v := mp(fn_update_same[f := V0, k := "bytes"], simp(vV), simp(vV))
    have e0s := mp(fn_update_same[f := s, k := "vm"], vf, vd)
    have s0: ST(0) = s by simp(z, e0v, e0s)
    have p0: P(pair(s, 0)) by ex_intro({0}, simp(s0))
    have pm: all l. P(l) -> M(l) in omega proof
      fix l
      assume hp2
      obtain i, hi from hp2
      show by simp(hi)
    qed
    // (the bytes zeroed: usable, as the sequence byte is 255)
    have b255: gimple.bytes_at(V0, mallocng_specs.seq_at(CTX), 1) = 255 by defs(simp(a912, hx, xb, n255), mallocng_specs.seq_at)
    have u32 := mp(u848, b255)
    have s31: sint(32, 31) = 31 by defs(simp(), sint)
    // the body at i: up to 31 the byte zeroed, i + 1 next; past 31 the break
    have run: all i. i in omega -> int_le(i, 31) -> all o. BODY(pair(ST(i), i), o) -> o = ok(pair(ST(int_add(i, 1)), int_add(i, 1)), empty) proof
      fix i
      assume io hl
      fix o
      assume hb
      have ib: i in bits(32) by arith(io, hl)
      have si: sint(32, i) = i by defs(simp(io, hl), sint)
      have wW wU := apply(tr.world_store, {s}, {A}, {i}, {0}, hw, hu, ab)
      have sx := apply(ms.sext_small, ib, arith(hl, io))
      have ui := mp(all_elim(ms.usable_part, {V0}, {s.objs}, {int_add(CTX, 848)}, {32}, {int_add(int_add(A, bits_sext(32, 64, i)), 0)}, {1}, {true}),
        arith(cb), arith(ae, sx, cb, io), arith(ae, sx), arith(ae, sx, hl), u32)
      have fi: tr.s32_fits(int_add(sint(32, i), sint(32, 1))) by defs(simp(si, hl, io), gimple.fits, sint)
      step x2, e from hb with g.padd_det, g.elem1_det, ms.st8_det, g.sadd32_det using conj(hu, wW, wU, ab, sv, ae, sx, ui, ib, fi, cb, c913, p64, io, hl, si, s31)
      have ad: int_add(int_add(A, bits_sext(32, 64, i)), 0) = int_add(A, i) by simp(sx)
      have zg := mp(all_elim(ms.zero_grow, {B0}, {A}, {i}), ab, io, arith(ae, c913, cb, p64, hl, io))
      have inc: bits_add(32, i, 1) = int_add(i, 1) by defs(arith(io, hl), bits_add, pow2)
      show by simp(e, ad, zg, inc)
    qed
    have brk: all i. i in omega -> int_le(i, 32) -> !int_le(i, 31) -> all o. BODY(pair(ST(i), i), o) -> o = exc(pair(ST(i), i), pair("brk", empty)) proof
      fix i
      assume io il hl
      fix o
      assume hb
      have si: sint(32, i) = i by defs(simp(io, il), sint)
      step x2, e from hb using conj(si, s31, hl, io)
      show by simp(e)
    qed
    // a step from the invariant: the next byte zeroed, the invariant again, closer to 32
    have nx: all l l2. P(l) -> BODY(l, ok(l2, empty)) -> P(l2) && int_lt(M(l2), M(l)) proof
      fix l l2
      assume hp2 hb
      obtain i, io il le from hp2
      have hb2 := rewrite(le, hb)
      have more: int_le(i, 31) -> P(l2) && int_lt(M(l2), M(l)) proof
        assume hl
        have e2: l2 = pair(ST(int_add(i, 1)), int_add(i, 1)) by simp(mp(all_elim(mp(all_elim(run, {i}), io, hl), {ok(l2, empty)}), hb2))
        have p2: P(l2) by ex_intro({int_add(i, 1)}, simp(io, hl, e2))
        have m2: int_lt(M(l2), M(l)) by simp(e2, le, io)
        show by taut(p2, m2)
      qed
      have stop: !int_le(i, 31) -> P(l2) && int_lt(M(l2), M(l)) proof
        assume hl
        have e := mp(all_elim(mp(all_elim(brk, {i}), io, il, hl), {ok(l2, empty)}), hb2)
        have f: false by defs(simp(e), ok, exc)
        show by taut(f)
      qed
      show by taut(more, stop)
    qed
    // (the loop left from the invariant by a step not ok: the break at 32)
    have wv := apply(g.loop[b := l o. BODY(l, o), p := l. P(l), m := l. M(l)], p0, pm, nx, wl)
    obtain l, hpl bb nk from wv
    obtain i, io il le from hpl
    have bb2 := rewrite(le, bb)
    have i32: i = 32 proof
      have c1: int_le(i, 31) -> false proof
        assume hl
        have e := mp(all_elim(mp(all_elim(run, {i}), io, hl), {x3}), bb2)
        have k: is_ok(x3) by defs(simp(e), is_ok)
        show by taut(k, nk)
      qed
      show by arith(c1, il, io)
    qed
    have re := rewrite(i32, mp(all_elim(mp(all_elim(brk, {i}), io, il, arith(i32)), {x3}), bb2))
    // then the sequence byte 1
    have wW wU := apply(tr.world_store, {s}, {A}, {32}, {0}, hw, hu, ab)
    step oe from rewrite(re, c2) with ms.st8_det using conj(wW, wU, cb, cnz, c913, uw, p64)
    have bB: B = 255 by simp(hx, xb, n255)
    have a848: bits_add(64, CTX, 848) = A by defs(arith(ae, cb, c913, p64), bits_add, pow2)
    have ev: mallocng_specs.step_seq_vm(V0, CTX) = fn_update(V0, "bytes", x86_64_linux.store_le(x86_64_linux.store_le(B0, A, 32, 0), int_add(CTX, 912), 1, 1))
      by defs(simp(bB, a912, a848, sv, ms.v_wr8), mallocng_specs.step_seq_vm, mallocng_specs.seq_at, mallocng_specs.unmap_seqs_at)
    show by simp(oe, ev)
  qed
  have cw: X = bits_neg(8, 1) || !(X = bits_neg(8, 1)) by taut()
  show by taut(cw, wrap, up)
qed

// ___errno_location's contract at a call: an overflow, or errno's address
// returned, the memory as it was
theorem ms.el_q: all regs s o2. s in abi.World -> s in univ(1) -> gc.regs_ok(regs, empty) ->
  runs(mallocng_specs.errno_location_spec_fun[regs], s, o2) ->
  (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && fst(r) = mallocng_specs.errno_at(s.fs_base))
proof
  fix regs s o2
  assume hw hu hr h
  let OVF := exc_val("stack_overflow", empty)
  let V := mallocng_specs.errno_at(s.fs_base)
  have rl rn := apply(gc.regs0, hr)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, mallocng_specs.errno_location_spec_fun, app_fn_build, ra in h
  have pv pf pd pb := apply(ms.world_parts, hw)
  have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], pf, pd)
  let G := (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(s, "vm", v), OVF)) || (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && fst(r) = V)
  have b := apply(g.runs_elim, h)
  obtain o3, hs3 hk3 from expand(b, bind_rel)
  have vv: ex x. x in x86_64_linux.Vm by ex_intro({s.vm}, simp(pv))
  have ci: (ex v. v in x86_64_linux.Vm && o3 = exc(fn_update(s, "vm", v), OVF)) || o3 = ok(s, V) by simp(hs3, vv, ss, keep(mallocng_specs.errno_at))
  have c1: (ex v. v in x86_64_linux.Vm && o3 = exc(fn_update(s, "vm", v), OVF)) -> G proof
    assume e
    obtain v, hv he from e
    have oe: o2 = exc(fn_update(s, "vm", v), OVF) by simp(rewrite(he, hk3))
    have l: ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(s, "vm", v), OVF) by ex_intro({v}, taut(hv, oe))
    show by taut(l)
  qed
  have vb: V in bits(64) by defs(simp(), mallocng_specs.errno_at)
  have c2: o3 = ok(s, V) -> G proof
    assume he
    have k1: bind_rel(gimple.result(64, V), s, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. o2 = ok(x6, pair(x8, x9)))), x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))
      by simp(expand(rewrite(he, hk3), letin), keep(bind_rel, gimple.result, mallocng_specs.errno_at))
    obtain o4, hr4 hk4 from expand(k1, bind_rel)
    have ho4 := apply(g.result64_inv, vb, hr4)
    have k2: any_rel(x9. x9 in bits(64), x9. o2 = ok(s, pair(V, x9))) by simp(expand(rewrite(ho4, hk4), letin), keep(any_rel, mallocng_specs.errno_at))
    have ne: ex y. y in bits(64) by ex_intro({0}, simp())
    obtain y, hy hoy from apply(g.any_e, ne, k2)
    have hoy2: o2 = ok(fn_update(s, "vm", s.vm), pair(V, y)) by simp(hoy, ss)
    have l: ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && fst(r) = V by ex_intro({pair(V, y)}, taut(hoy2, (fst(pair(V, y)) = V by simp())))
    show by taut(l)
  qed
  show by taut(ci, c1, c2)
qed

// size_overflows' contract from ___errno_location's: for every callee
// refining errno_location's spec (as a C function value), size_overflows'
// readable GIMPLE refines its spec
theorem ms.size_overflows_c2: all n g. n in bits(64) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(g[regs], s, o) -> runs(mallocng_specs.errno_location_spec_fun[regs], s, o)) ->
  refines(c_src_malloc_mallocng_malloc.size_overflows(n, g), mallocng_specs.size_overflows_spec(n), abi.World)
proof
  fix n g
  assume hn hg
  show proof
    fix s o
    assume hw hr
    let SPEC := mallocng_specs.size_overflows_spec(n)
    let V0 := s.vm
    let FS := s.fs_base
    let E := mallocng_specs.errno_at(FS)
    let OVF := exc_val("stack_overflow", empty)
    have pu := apply(g.runs_univ, hr)
    have hu: s in univ(1) by simp(pu)
    have vV vfun vdom .. := apply(ms.world_parts, hw)
    have ss: fn_update(s, "vm", V0) = s := mp(fn_update_same[f := s, k := "vm"], vfun, vdom)
    let PRE := mallocng_specs.size_overflows_pre(V0, s.objs, FS, n)
    have np: !PRE -> runs(SPEC, s, o) proof
      assume hn2
      show by simp(pu, hn2, keep(abi.overflow, mallocng_specs.size_overflows_pre, mallocng_specs.errno_at, mallocng_specs.wr32))
    qed
    have yp: PRE -> runs(SPEC, s, o) proof
      assume hp
      // small: 0
      have small: !int_lt(9223372036854771710, n) -> runs(SPEC, s, o) proof
        assume hc
        step x2 x4 x6 x8, oe from hr with hc
        show by simp(oe, pu, hp, hc, keep(abi.overflow, mallocng_specs.size_overflows_pre, mallocng_specs.errno_at, mallocng_specs.wr32))
      qed
      // too big: errno's address by the call, ENOMEM stored there, 1
      have big: int_lt(9223372036854771710, n) -> runs(SPEC, s, o) proof
        assume hc
        have fsb ue hth := mp(expand(hp, mallocng_specs.size_overflows_pre), hc)
        have sov: all v. v in x86_64_linux.Vm -> runs(SPEC, s, exc(fn_update(s, "vm", v), OVF)) proof
          fix v
          assume hv
          have vu := apply(x86.vm_univ, hv)
          have eu: OVF in univ(1) by defs(simp(), exc_val)
          have pu2: pair(s, exc(fn_update(s, "vm", v), OVF)) in univ(1) by simp(hu, vu, eu)
          have ovi := apply(ct.overflow_intro, hv, pu2)
          show by simp(hp, ovi, pu2, keep(abi.overflow, mallocng_specs.size_overflows_pre, mallocng_specs.errno_at, mallocng_specs.wr32))
        qed
        step x2 x4 x6 x8, c1 ck from hr with hc
        have qa: all regs o2. gc.regs_ok(regs, empty) -> runs(mallocng_specs.errno_location_spec_fun[regs], s, o2) ->
            (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(s, "vm", v), OVF)) ||
            (ex r. o2 = ok(fn_update(s, "vm", V0), r) && fst(r) = E) proof
          fix regs o2
          assume hro h2
          show := apply(ms.el_q, hw, hu, hro, h2)
        qed
        have ths: gc.sound(s) by simp(hth)
        have cc := apply(gc.contract_call1[R := r. fst(r) = E], {g}, {mallocng_specs.errno_location_spec_fun}, {empty}, {s}, {V0},
          ths, hw, vV, gc.regs0_ex, (int_le(seq_len(empty), 6) by arith()), hg, qa, c1)
        have cov: case 1 of cc proof
          assume h
          obtain v, hv hx from h
          have ho: o = exc(fn_update(s, "vm", v), OVF) by simp(rewrite(hx, ck))
          show := rewrite(sym(ho), mp(all_elim(sov, {v}), hv))
        qed
        have cok: case 2 of cc proof
          assume h
          obtain r, hR hk from h
          have hk2 := rewrite(hR, rewrite(ss, hk))
          // (errno's cell: fs + 0x34, writable)
          have fsw: FS in bits(64) by simp(expand(hw, abi.World))
          have p64: pow2(64) = 18446744073709551616 by simp()
          have ee: E = int_add(FS, 52) by defs(arith(fsw, fsb, p64), mallocng_specs.errno_at, bits_add, pow2)
          have eb: E in bits(64) by defs(simp(), mallocng_specs.errno_at)
          have ue2 := rewrite(ee, ue)
          have md: g.mem_defined(s, E, 0, 4, true) by simp(ee, ue2, fsw, fsb, p64)
          step oe from conj(hk2, ck) with ms.st32_det using conj(hu, hw, eb, md)
          have e0: bits_add(64, E, 0) = E by simp(eb)
          have oe2: o = ok(fn_update(s, "vm", mallocng_specs.wr32(V0, E, 12)), 1) by simp(oe, e0, eb, ms.v_wr32)
          show by simp(oe2, pu, hp, hc, keep(abi.overflow, mallocng_specs.size_overflows_pre, mallocng_specs.errno_at, mallocng_specs.wr32))
        qed
        show by taut(cc, cov, cok)
      qed
      show by taut(small, big)
    qed
    show by taut(np, yp)
  qed
qed

// size_overflows as a C function value, for every such callee
theorem ms.size_overflows_fun_c2: all g.
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(g[regs], s, o) -> runs(mallocng_specs.errno_location_spec_fun[regs], s, o)) ->
  all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
  runs(c_src_malloc_mallocng_malloc.size_overflows_fun(g)[regs], s, o) -> runs(mallocng_specs.size_overflows_spec_fun[regs], s, o)
proof
  fix g
  assume hg
  have hm: all regs. refines(c_src_malloc_mallocng_malloc.size_overflows(bits_of_int(64, regs[0]), g), mallocng_specs.size_overflows_spec(bits_of_int(64, regs[0])), abi.World) proof
    fix regs
    show := mp(all_elim(ms.size_overflows_c2, {bits_of_int(64, regs[0])}, {g}), simp(), hg)
  qed
  show by defs(apply(g.fun_res[n := 1, w := 32], hm), c_src_malloc_mallocng_malloc.size_overflows_fun, mallocng_specs.size_overflows_spec_fun, letin)
qed

// a_cas's contract at a call a_cas(p, t, x): an overflow, or the word at
// p written (x if it held t), its old value returned
theorem ms.acas_q: all regs s p t x o2. p in bits(64) -> t in bits(32) -> x in bits(32) -> s in abi.World -> s in univ(1) ->
  mallocng_specs.a_cas_pre(s.vm, s.objs, p) ->
  gc.regs_ok(regs, seq_concat(seq_concat(seq_one(gimple.arg(64, p)), seq_one(gimple.arg(32, t))), seq_one(gimple.arg(32, x)))) ->
  runs(mallocng_specs.a_cas_spec_fun()[regs], s, o2) ->
  (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty))) ||
  (ex r. o2 = ok(fn_update(s, "vm", mallocng_specs.wr32(s.vm, p, ite(gimple.bytes_at(s.vm, p, 4) = t, x, gimple.bytes_at(s.vm, p, 4)))), r) &&
     bits_of_int(32, fst(r)) = bits_of_int(32, gimple.bytes_at(s.vm, p, 4)))
proof
  fix regs s p t x o2
  assume hp ht hx hw hu hpre hr h
  let OVF := exc_val("stack_overflow", empty)
  let B := gimple.bytes_at(s.vm, p, 4)
  let W1 := fn_update(s, "vm", mallocng_specs.wr32(s.vm, p, ite(B = t, x, B)))
  let V := bits_of_int(32, B)
  have rl rn r0 r1 r2 := apply(gc.regs3w, hp, ht, hx, hr)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, mallocng_specs.a_cas_spec_fun, app_fn_build, ra in h
  let G := (ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(s, "vm", v), OVF)) || (ex r. o2 = ok(W1, r) && bits_of_int(32, fst(r)) = V)
  have o1: ord_le(3, seq_len(regs)) by defs(simp(rn), ord_le)
  have bp: bits_of_int(64, p) = p by defs(arith(hp), bits_of_int, pow2)
  have b := rewrite(r2, rewrite(r1, rewrite(bp, rewrite(r0, apply(g.runs_elim, h)))))
  have b2: bind_rel(mallocng_specs.a_cas_spec(p, t, x), s, x3 x4. letin(x4, x5. bind_rel(gimple.result(32, x5), x3, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. o2 = ok(x6, pair(x8, x9)))),
      x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))), x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3)) by taut(b, o1)
  obtain o3, hs3 hk3 from expand(b2, bind_rel)
  have pv pf pd pb := apply(ms.world_parts, hw)
  have vv: ex y. y in x86_64_linux.Vm by ex_intro({s.vm}, simp(pv))
  have ci: (ex v. v in x86_64_linux.Vm && o3 = exc(fn_update(s, "vm", v), OVF)) || o3 = ok(W1, V) by simp(hs3, hpre, vv, keep(mallocng_specs.a_cas_pre, mallocng_specs.wr32))
  have c1: (ex v. v in x86_64_linux.Vm && o3 = exc(fn_update(s, "vm", v), OVF)) -> G proof
    assume e
    obtain v, hv he from e
    have oe: o2 = exc(fn_update(s, "vm", v), OVF) by simp(rewrite(he, hk3))
    have l: ex v. v in x86_64_linux.Vm && o2 = exc(fn_update(s, "vm", v), OVF) by ex_intro({v}, taut(hv, oe))
    show by taut(l)
  qed
  have c2: o3 = ok(W1, V) -> G proof
    assume he
    have k1: bind_rel(gimple.result(32, V), W1, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. o2 = ok(x6, pair(x8, x9)))), x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))
      by simp(expand(rewrite(he, hk3), letin), keep(bind_rel, gimple.result, mallocng_specs.wr32))
    obtain o4, hr4 hk4 from expand(k1, bind_rel)
    obtain u, hu64 hlow ho4 from apply(g.result32_inv, (V in bits(32) by simp()), hr4)
    have k2: any_rel(x9. x9 in bits(64), x9. o2 = ok(W1, pair(u, x9))) by simp(expand(rewrite(ho4, hk4), letin), keep(any_rel, mallocng_specs.wr32))
    have ne: ex y. y in bits(64) by ex_intro({0}, simp())
    obtain y, hy hoy from apply(g.any_e, ne, k2)
    have cl: bits_of_int(32, fst(pair(u, y))) = V by simp(hlow)
    have l: ex r. o2 = ok(W1, r) && bits_of_int(32, fst(r)) = V by ex_intro({pair(u, y)}, taut(hoy, cl))
    show by taut(l)
  qed
  show by taut(ci, c1, c2)
qed

// (a 32-bit shift left below the width: one outcome)
theorem ms.shl32_det: all s a k. s in univ(1) -> a in bits(32) -> k in omega -> int_lt(k, 32) ->
  g.det(gimple.shl(32, a, k), s, ok(s, bits_shl(32, a, k)))
proof
  fix s a k
  assume hs ha hk hl
  show proof
    fix o
    assume hr
    show by simp(expand(hr, gimple.shl, runs, mkprog), hs, ha, hk, hl)
  qed
qed

// (the code's act, (2 << idx) - 1 in 32 bits, idx the low 5 bits of b:
// the spec's 2 * 2^idx - 1)
theorem ms.act_eq: all b. b in omega ->
  bits_add(32, bits_shl(32, bits_of_int(32, 2), bits_of_int(5, int_mod(int_div(b, int_pow(2, 0)), int_pow(2, 5)))), bits_neg(32, 1)) =
  bits_of_int(32, int_sub(int_mul(2, int_pow(2, int_mod(b, 32))), 1))
proof
  fix b
  assume hb
  let k := int_mod(b, 32)
  have pw: int_pow(2, 0) = 1 && int_pow(2, 5) = 32 by simp()
  have kb: k in bits(5) by arith(hb)
  have e5: bits_of_int(5, int_mod(int_div(b, int_pow(2, 0)), int_pow(2, 5))) = k by simp(pw, kb, (int_mod(int_div(b, 1), 32) = k by arith(hb)))
  have e2: bits_of_int(32, 2) = 2 by simp()
  have ko: k in omega by arith(hb)
  have pe: pow2(k) = int_pow(2, k) by defs(simp(), pow2)
  have sh: bits_shl(32, 2, k) = int_mod(int_mul(2, int_pow(2, k)), 4294967296) by defs(simp(pe), bits_shl, pow2)
  have pp0 := mp(pow2_pos[k := k], ko)
  have pp: int_le(1, int_pow(2, k)) by arith(rewrite(pe, pp0))
  have sb: int_mod(int_mul(2, int_pow(2, k)), 4294967296) in bits(32) by arith(pp)
  have ad: bits_add(32, int_mod(int_mul(2, int_pow(2, k)), 4294967296), bits_neg(32, 1)) = int_mod(int_add(int_mod(int_mul(2, int_pow(2, k)), 4294967296), 4294967295), 4294967296)
    by defs(simp(sb), bits_add, bits_neg, pow2)
  have md: int_mod(int_add(int_mod(int_mul(2, int_pow(2, k)), 4294967296), 4294967295), 4294967296) = int_mod(int_sub(int_mul(2, int_pow(2, k)), 1), 4294967296) by arith(pp)
  have rb: bits_of_int(32, int_sub(int_mul(2, int_pow(2, k)), 1)) = int_mod(int_sub(int_mul(2, int_pow(2, k)), 1), 4294967296) by defs(simp(), bits_of_int, pow2)
  show by simp(e5, e2, sh, ad, md, rb)
qed

// activate_group's run, its precondition holding: an overflow, or its
// effect (`activate_group_vm`: the freed slots up to the active index
// made available), the new available mask returned -- for any a_crash
// (not reached: the available mask 0) and any callee refining a_cas's spec
theorem ms.ag_run: all m g0 g1 s o. m in bits(64) ->
  (all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(g1[regs], s, o) -> runs(mallocng_specs.a_cas_spec_fun()[regs], s, o)) ->
  s in abi.World -> mallocng_specs.activate_group_pre(s.vm, s.objs, s.fs_base, m) ->
  runs(c_src_malloc_mallocng_malloc.activate_group(m, g0, g1), s, o) ->
  (ex v. v in x86_64_linux.Vm && o = exc(fn_update(s, "vm", v), exc_val("stack_overflow", empty))) ||
  o = ok(fn_update(s, "vm", mallocng_specs.activate_group_vm(s.vm, m)), bits_and(32, mallocng_specs.ag_freed(s.vm, m), mallocng_specs.ag_act(s.vm, m)))
proof
  fix m g0 g1 s o
  assume hm hg1 hw hpre hr
  let V0 := s.vm
  let O := s.objs
  let OVF := exc_val("stack_overflow", empty)
  have pu := apply(g.runs_univ, hr)
  have hu: s in univ(1) by simp(pu)
  have vV vfun vdom vb := apply(ms.world_parts, hw)
  have mnz m32 ur16 uw24 a0 gnz g9 ug hth := expand(hpre, mallocng_specs.activate_group_pre)
  have p64: pow2(64) = 18446744073709551616 by simp()
  // (the available mask 0; the mem word G; its header's active index IX)
  have a24: bits_add(64, m, 24) = int_add(m, 24) by defs(arith(hm, m32), bits_add, pow2)
  have a16: bits_add(64, m, 16) = int_add(m, 16) by defs(arith(hm, m32), bits_add, pow2)
  have u24 := mp(all_elim(ms.usable_part, {V0}, {O}, {int_add(m, 16)}, {16}, {int_add(m, 24)}, {4}, {false}), arith(hm), arith(hm), arith(), arith(), ur16)
  have u16 := mp(all_elim(ms.usable_part, {V0}, {O}, {int_add(m, 16)}, {16}, {int_add(m, 16)}, {8}, {false}), arith(hm), arith(hm), arith(), arith(), ur16)
  have md24: g.mem_defined(s, m, 24, 4, false) by simp(mnz, u24, m32, p64)
  have md16: g.mem_defined(s, m, 16, 8, false) by simp(mnz, u16, m32, p64)
  have ld24 := apply(g.ld32_det, {s}, {m}, {24}, hu, hm, simp(), md24)
  have c0: bits_of_int(32, gimple.bytes_at(V0, int_add(m, 24), 4)) = 0 by simp(rewrite(a24, a0))
  let G := mallocng_specs.rd64(V0, bits_add(64, m, 16))
  have eg: bits_of_int(64, gimple.bytes_at(V0, int_add(m, 16), 8)) = G by defs(simp(a16), mallocng_specs.rd64)
  have ld16 := rewrite(eg, apply(g.ld64_det, {s}, {m}, {16}, hu, hm, simp(), md16))
  have gb: G in bits(64) by defs(simp(), mallocng_specs.rd64)
  have md8: g.mem_defined(s, G, 8, 1, false) by simp(gnz, ug, g9, p64)
  have ldx := apply(g.ldbf_det, {s}, {G}, {8}, {1}, {0}, {5}, hu, gb, simp(), md8)
  let K5 := bits_of_int(5, int_mod(int_div(gimple.bytes_at(V0, int_add(G, 8), 1), int_pow(2, 0)), int_pow(2, 5)))
  have k5o: K5 in omega by simp()
  have k5l: int_lt(K5, 32) by simp()
  have shd := apply(ms.shl32_det, {s}, {bits_of_int(32, 2)}, {K5}, hu, simp(), k5o, k5l)
  step x2 x4 x6 x11 x23, wl c2 from hr with ld24, c0, ld16, ldx, shd
  // the loop: the freed mask F read, a_cas(m + 28, F, F & ~ACT) -- F
  // returned, the break (one thread)
  let ACT := bits_add(32, bits_shl(32, bits_of_int(32, 2), K5), bits_neg(32, 1))
  let FB := gimple.bytes_at(V0, int_add(m, 28), 4)
  let F := bits_of_int(32, FB)
  let T64 := fn_update(fn_update(empty, "prec", 64), "signed", true)
  let P28 := int_add(m, gimple.sval(T64, 28))
  let NX := bits_and(32, F, bits_not(32, ACT))
  let V1 := mallocng_specs.wr32(V0, P28, ite(gimple.bytes_at(V0, P28, 4) = F, NX, gimple.bytes_at(V0, P28, 4)))
  let W1 := fn_update(s, "vm", V1)
  have sv28: gimple.sval(T64, 28) = 28 by defs(simp(), gimple.sval)
  have e28: P28 = int_add(m, 28) by simp(sv28)
  have u28 := mp(all_elim(ms.usable_part, {V0}, {O}, {int_add(m, 16)}, {16}, {int_add(m, 28)}, {4}, {false}), arith(hm), arith(hm), arith(), arith(), ur16)
  have u28w := mp(all_elim(ms.usable_part, {V0}, {O}, {int_add(m, 24)}, {8}, {int_add(m, 28)}, {4}, {true}), arith(hm), arith(hm), arith(), arith(), uw24)
  have md28: g.mem_defined(s, m, 28, 4, false) by simp(mnz, u28, m32, p64)
  have ldF := apply(g.ld32_det, {s}, {m}, {28}, hu, hm, simp(), md28)
  have pd28 := apply(g.padd_det, {s}, {m}, {28}, hu, hm, simp(), arith(sv28, hm), arith(sv28, hm, m32, p64))
  have fo fl := mp(all_elim(g.bytes_bound, {V0}, {int_add(m, 28)}, {4}), vb, arith())
  have fb: F = FB by defs(arith(fo, fl), bits_of_int, pow2)
  have Fb: F in bits(32) by simp()
  have NXb: NX in bits(32) by simp()
  have p28b: P28 in bits(64) by arith(e28, hm, m32)
  have acp: mallocng_specs.a_cas_pre(V0, O, P28) by defs(simp(e28, u28, u28w, m32, p64, (!(int_add(m, 28) = 0) by arith(hm))), mallocng_specs.a_cas_pre)
  have bF: bits_of_int(32, gimple.bytes_at(V0, P28, 4)) = F by simp(e28)
  have ths: gc.sound(s) by simp(hth)
  have wW wU := apply(tr.world_store, {s}, {P28}, {4}, {ite(gimple.bytes_at(V0, P28, 4) = F, NX, gimple.bytes_at(V0, P28, 4))}, hw, hu, p28b)
  have ew1: W1 = fn_update(s, "vm", fn_update(V0, "bytes", x86_64_linux.store_le(V0.bytes, P28, 4, ite(gimple.bytes_at(V0, P28, 4) = F, NX, gimple.bytes_at(V0, P28, 4))))) by simp(ms.v_wr32)
  have w1W: W1 in abi.World := rewrite(sym(ew1), wW)
  have w1U: W1 in univ(1) := rewrite(sym(ew1), wU)
  have {v1V = mem} := apply(ms.world_parts, w1W)
  have v1: V1 in x86_64_linux.Vm by simp(v1V)
  // the body from a state of the loop: an overflow, or the break at W1
  let BODY(l, o) := loop_body(wl)
  have run: all a b o. BODY(pair(s, pair(ACT, pair(a, b))), o) ->
      (ex v. v in x86_64_linux.Vm && o = exc(pair(fn_update(s, "vm", v), pair(ACT, pair(F, b))), pair("raise", OVF))) ||
      o = exc(pair(W1, pair(ACT, pair(F, b))), pair("brk", empty)) proof
    fix a b o
    assume hb
    step r x17, oe hR from hb with ldF, pd28, ms.acas_q, bF using ths, hw, hu, v1, hg1, p28b, Fb, NXb, acp
    show by simp(oe, bF)
  qed
  // (the invariant: the world s, act ACT; the body never goes on)
  let P(l) := ex a b. l = pair(s, pair(ACT, pair(a, b)))
  have p0: P(pair(s, pair(ACT, pair(x4, x6)))) by ex_intro({x4}, {x6}, simp())
  have pm: all l. P(l) -> 0 in omega by simp()
  have nx: all l l2. P(l) -> BODY(l, ok(l2, empty)) -> P(l2) && int_lt(0, 0) proof
    fix l l2
    assume hp2 hb
    obtain a b, le from hp2
    have r := mp(all_elim(run, {a}, {b}, {ok(l2, empty)}), rewrite(le, hb))
    have f: false by defs(simp(r), ok, exc)
    show by taut(f)
  qed
  have wv := apply(g.loop[b := l o. BODY(l, o), p := l. P(l), m := l. 0], p0, pm, nx, wl)
  obtain l, hpl bb nk from wv
  obtain a b, le from hpl
  have rr := mp(all_elim(run, {a}, {b}, {x23}), rewrite(le, bb))
  // an overflow in the call
  have r1: case 1 of rr proof
    assume h
    obtain v, hv xe from h
    have ho: o = exc(fn_update(s, "vm", v), OVF) by simp(rewrite(xe, c2))
    have l: ex v. v in x86_64_linux.Vm && o = exc(fn_update(s, "vm", v), OVF) by ex_intro({v}, taut(hv, ho))
    show by taut(l)
  qed
  // the break: the available mask F & ACT stored, returned
  have r2: case 2 of rr proof
    assume xe
    have md24w: g.mem_defined(W1, m, 24, 4, true) by simp(mnz, m32, p64, ms.v_wr32, ms.f_usable, (gimple.usable(V0, O, int_add(m, 24), 4, true) by simp(mp(all_elim(ms.usable_part, {V0}, {O}, {int_add(m, 24)}, {8}, {int_add(m, 24)}, {4}, {true}), arith(hm), arith(hm), arith(), arith(), uw24))))
    have st := apply(ms.st32_det, {W1}, {m}, {24}, {bits_and(32, F, ACT)}, w1W, w1U, hm, simp(), md24w)
    step oe from rewrite(xe, c2) with st
    // (the spec's F and act; the word a_cas wrote: F & ~act)
    have a28: bits_add(64, m, 28) = int_add(m, 28) by defs(arith(hm, m32), bits_add, pow2)
    have eF: mallocng_specs.ag_freed(V0, m) = F by defs(simp(a28), mallocng_specs.ag_freed)
    have g8g: all x. x in bits(64) -> int_le(int_add(x, 9), int_pow(2, 64)) -> bits_add(64, x, 8) = int_add(x, 8) proof
      fix x
      assume h1 h2
      show by defs(arith(h1, h2), bits_add, pow2)
    qed
    have g8 := mp(all_elim(g8g, {G}), gb, g9)
    have bo bl := mp(all_elim(g.bytes_bound, {V0}, {int_add(G, 8)}, {1}), vb, arith())
    have ae := mp(all_elim(ms.act_eq, {gimple.bytes_at(V0, int_add(G, 8), 1)}), bo)
    have eA: mallocng_specs.ag_act(V0, m) = ACT by defs(simp(g8, ae), mallocng_specs.ag_act)
    have ei: ite(gimple.bytes_at(V0, P28, 4) = F, NX, gimple.bytes_at(V0, P28, 4)) = NX by simp(e28, fb)
    let V2 := mallocng_specs.wr32(mallocng_specs.wr32(V0, int_add(m, 28), NX), int_add(m, 24), bits_and(32, F, ACT))
    have ev0: mallocng_specs.activate_group_vm(V0, m) = mallocng_specs.wr32(mallocng_specs.wr32(V0, bits_add(64, m, 28), bits_and(32, mallocng_specs.ag_freed(V0, m), bits_not(32, mallocng_specs.ag_act(V0, m)))), bits_add(64, m, 24), bits_and(32, mallocng_specs.ag_freed(V0, m), mallocng_specs.ag_act(V0, m)))
      by defs(refl({mallocng_specs.wr32(mallocng_specs.wr32(V0, bits_add(64, m, 28), bits_and(32, mallocng_specs.ag_freed(V0, m), bits_not(32, mallocng_specs.ag_act(V0, m)))), bits_add(64, m, 24), bits_and(32, mallocng_specs.ag_freed(V0, m), mallocng_specs.ag_act(V0, m)))}), mallocng_specs.activate_group_vm)
    have ev: mallocng_specs.activate_group_vm(V0, m) = V2 := rewrite(a24, rewrite(a28, rewrite(eA, rewrite(eF, ev0))))
    have vw := all_elim(ms.v_wr32, {mallocng_specs.wr32(V0, int_add(m, 28), NX)}, {int_add(m, 24)}, {bits_and(32, F, ACT)})
    have oe1 := rewrite(e28, rewrite(ei, oe))
    have oe2 := rewrite(sym(ev), rewrite(sym(vw), oe1))
    show by simp(oe2, eF, eA)
  qed
  show by taut(rr, r1, r2)
qed

// ----------------------------------------------------------------------
//  brk (`__syscall1(SYS_brk, new)`)
// (the call's outcomes, `gimple.brk_post`: the spec's, its requirement
// met -- the break as it was; grown, the pages fresh; or shrunk)
theorem ms.brk_post_spec: all s V n a. s in abi.World -> s in univ(1) -> V in x86_64_linux.Vm -> n = 12 -> tr.req1(s, a) ->
  gimple.brk_post(s.vm, V, a) -> runs(mallocng_specs.syscall1_spec(n, a), s, ok(fn_update(s, "vm", V), V.brk))
proof
  fix s V n a
  assume hw hu hV hn hq hp
  have pv pf pd pb := apply(ms.world_parts, hw)
  have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], pf, pd)
  have vu := apply(x86.vm_univ, hV)
  let PO := x86_64_linux.pages_for(s.vm.brk)
  let PN := x86_64_linux.pages_for(a)
  let HP := fn_update(fn_update(empty, "prot", fn_update(fn_update(fn_update(empty, "r", true), "w", true), "x", false)), "kind", 1)
  have c1: V = s.vm && (int_lt(a, s.vm.brk_start) || int_lt(PO, PN)) -> runs(mallocng_specs.syscall1_spec(n, a), s, ok(fn_update(s, "vm", V), V.brk)) proof
    assume h
    have hv hc := h
    have r0: runs(mallocng_specs.syscall1_spec(n, a), s, ok(fn_update(s, "vm", s.vm), s.vm.brk))
      by simp(hc, ss, hn, hq, hu, keep(x86_64_linux.free_range, x86_64_linux.off_stack_space, x86_64_linux.pages_for, gimple.sys_pages_ok))
    show := rewrite(sym(hv), r0)
  qed
  have c2: int_le(s.vm.brk_start, a) && int_lt(PO, PN) && x86_64_linux.free_range(s.vm, PO, int_sub(PN, PO)) &&
      x86_64_linux.off_stack_space(s.vm, PO, int_sub(PN, PO)) && gimple.fresh_pages(s.vm, V, PO, int_sub(PN, PO), HP) && V.brk = a ->
      runs(mallocng_specs.syscall1_spec(n, a), s, ok(fn_update(s, "vm", V), V.brk)) proof
    assume h
    have h1 h2 h3 h4 h5 h6 := h
    show by simp(h1, h2, h3, h4, h5, h6, hV, hn, hq, hu, vu,
      keep(x86_64_linux.free_range, x86_64_linux.off_stack_space, x86_64_linux.pages_for, gimple.sys_pages_ok, gimple.fresh_pages))
  qed
  have c3: int_le(s.vm.brk_start, a) && int_le(PN, PO) && gimple.gone_pages(s.vm, V, PN, int_sub(PO, PN)) && V.brk = a ->
      runs(mallocng_specs.syscall1_spec(n, a), s, ok(fn_update(s, "vm", V), V.brk)) proof
    assume h
    have h1 h2 h3 h4 := h
    show by simp(h1, h2, h3, h4, hV, hn, hq, hu, vu,
      keep(x86_64_linux.free_range, x86_64_linux.off_stack_space, x86_64_linux.pages_for, gimple.sys_pages_ok, gimple.gone_pages))
  qed
  show by taut(expand(hp, gimple.brk_post), c1, c2, c3)
qed

// (the call has an outcome: the break as it was, or shrunk)
theorem ms.brk_post_ex(v, a): v in x86_64_linux.Vm -> a in bits(64) -> ex V. V in x86_64_linux.Vm && gimple.brk_post(v, V, a)
proof
  assume hv ha
  have vu := apply(x86.vm_univ, hv)
  let PO := x86_64_linux.pages_for(v.brk)
  let PN := x86_64_linux.pages_for(a)
  have c1: int_lt(a, v.brk_start) || int_lt(PO, PN) -> ex V. V in x86_64_linux.Vm && gimple.brk_post(v, V, a) proof
    assume h
    show by ex_intro({v}, defs(taut(hv, h, refl({v})), gimple.brk_post))
  qed
  have c2: !(int_lt(a, v.brk_start) || int_lt(PO, PN)) -> ex V. V in x86_64_linux.Vm && gimple.brk_post(v, V, a) proof
    assume h
    have bs: v.brk_start in bits(64) by simp(expand(hv, x86_64_linux.Vm))
    have bb: v.brk in bits(64) by simp(expand(hv, x86_64_linux.Vm))
    have l1: int_le(v.brk_start, a) by arith(h, bs, ha)
    have poo: PO in omega by defs(arith(bb), x86_64_linux.pages_for, x86_64_linux.PAGE)
    have pno: PN in omega by defs(arith(ha), x86_64_linux.pages_for, x86_64_linux.PAGE)
    have l2: int_le(PN, PO) by arith(h, poo, pno)
    obtain V, h1 h2 h3 from apply(g.gone_ex[before := v, p := PN, n := int_sub(PO, PN), br := a], hv, vu, ha)
    show by ex_intro({V}, defs(taut(h1, h2, h3, l1, l2), gimple.brk_post))
  qed
  show by taut(c1, c2)
qed

// __syscall1 (its two locals, the call, the call's result returned)
// refines the spec: not brk or its requirement not met, anything;
// else brk's outcome -- one there is -- the spec's
theorem ms.syscall1_c2: all n a. a in bits(64) -> refines(c_src_malloc_mallocng_malloc.__syscall1(n, a), mallocng_specs.syscall1_spec(n, a), abi.World)
proof
  fix n a
  assume ha
  show proof
    fix s o
    assume hw hr
    let SPEC := mallocng_specs.syscall1_spec(n, a)
    have pu := apply(g.runs_univ, hr)
    have hu: s in univ(1) by simp(pu)
    have nq: !(n = 12 && tr.req1(s, a)) -> runs(SPEC, s, o) proof
      assume h
      show by simp(pu, h)
    qed
    have yq: n = 12 && tr.req1(s, a) -> runs(SPEC, s, o) proof
      assume h
      have hn hq := h
      have pv _ _ _ := apply(ms.world_parts, hw)
      have ne: ex z. z in bits(64) by ex_intro({0}, simp())
      have bx := apply(ms.brk_post_ex, pv, ha)
      rsimp only, c_src_malloc_mallocng_malloc.__syscall1 in hr
      have b3 := apply(g.runs_elim, hr)
      obtain z1, _ k1 from apply(g.any_e, ne, b3)
      obtain z2, _ k2 from apply(g.any_e, ne, expand(k1, letin))
      obtain o4, r4 c4 from expand(expand(k2, letin), bind_rel)
      rsimp only, gimple.sys_call1 in r4
      have b4: bind_rel(gimple.os_brk(a), s, x2 x3. o4 = ok(x2, x3), x2 x3. o4 = exc(x2, x3), x2. o4 = diverge(x2))
        by taut(apply(g.runs_elim, r4), hn, hq)
      obtain o5, r5 c5 from expand(b4, bind_rel)
      rsimp gimple.os_brk in r5
      have b5 := apply(g.runs_elim, r5)
      obtain V, hV hp ho5 from apply(g.any_e, bx, b5)
      have e4: o4 = ok(fn_update(s, "vm", V), V.brk) by simp(rewrite(expand(ho5, letin), c5))
      have e2: o = ok(fn_update(s, "vm", V), V.brk) by simp(rewrite(e4, c4))
      show := rewrite(sym(e2), apply(ms.brk_post_spec, hw, hu, hV, hn, hq, hp))
    qed
    show by taut(nq, yq)
  qed
qed

// __syscall1 as a C function value: its register wrapper refines the
// spec's
theorem ms.syscall1_fun_c2: all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World ->
  runs(c_src_malloc_mallocng_malloc.__syscall1_fun()[regs], s, o) -> runs(mallocng_specs.syscall1_spec_fun()[regs], s, o)
proof
  have hm: all regs. refines(c_src_malloc_mallocng_malloc.__syscall1(bits_of_int(64, regs[0]), bits_of_int(64, regs[1])),
      mallocng_specs.syscall1_spec(bits_of_int(64, regs[0]), bits_of_int(64, regs[1])), abi.World) proof
    fix regs
    show := mp(all_elim(ms.syscall1_c2, {bits_of_int(64, regs[0])}, {bits_of_int(64, regs[1])}), simp())
  qed
  show by defs(apply(g.fun_res[n := 2, w := 64], hm), c_src_malloc_mallocng_malloc.__syscall1_fun, mallocng_specs.syscall1_spec_fun, letin)
qed

