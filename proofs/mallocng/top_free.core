// The top level for free: the `free` symbol's machine code implements the
// malloc layer's free (layers/malloc.sl), from __libc_free's purpose
// (`mp.lf_res`) -- as top.core's for malloc. free_group and nontrivial_free
// call each other: each entry its code unrolled as deep as its groups in
// use (`abi.bridge_implements_lf`, proofs/mallocng/fun/free_machine.core).

// ----------------------------------------------------------------------
//  The layer's free: its runs

// free(0): nothing (the process as at any call)
theorem mp.tf_f0(I, O, eo, b, cd, st, S): malloc.world_ok(b, cd, st, S) -> pair(S, ok(S, empty)) in univ(1) -> runs(malloc.free(I, O, eo, b, cd, st, 0), S, ok(S, empty))
proof
  assume hw pu
  show by spec_ret({exc(pair(S, empty), pair("ret", empty))}, hw, pu)
qed

// ... anything where the process is not as at a call
theorem mp.tf_fanyw(I, O, eo, b, cd, st, S, p, o): pair(S, o) in univ(1) -> !malloc.world_ok(b, cd, st, S) -> runs(malloc.free(I, O, eo, b, cd, st, p), S, o)
proof
  assume pu hn
  show by spec_ret(hn, pu)
qed

// free(p) of a live block: the block no longer live, an allocator step
// (the block's bytes extra)
theorem mp.tf_fok(I, O, eo, b, cd, st, S, p, V): !(p = 0) -> S in I -> malloc.errno_ok(eo, S) -> malloc.world_ok(b, cd, st, S) -> !(S.blocks[p] = none) ->
  S.blocks in fn_space(bits(64), option(omega)) -> V in x86_64_linux.Vm ->
  malloc.step_ok(I, O, S, fn_update(fn_update(S, "blocks", malloc.set_block(S.blocks, p, none)), "vm", V), malloc.range(p, snd(S.blocks[p]))) ->
  malloc.world_ok(b, cd, st, fn_update(fn_update(S, "blocks", malloc.set_block(S.blocks, p, none)), "vm", V)) ->
  malloc.errno_ok(eo, fn_update(fn_update(S, "blocks", malloc.set_block(S.blocks, p, none)), "vm", V)) ->
  pair(fn_update(S, "blocks", malloc.set_block(S.blocks, p, none)), ok(fn_update(fn_update(S, "blocks", malloc.set_block(S.blocks, p, none)), "vm", V), empty)) in univ(1) ->
  pair(S, ok(fn_update(fn_update(S, "blocks", malloc.set_block(S.blocks, p, none)), "vm", V), empty)) in univ(1) ->
  runs(malloc.free(I, O, eo, b, cd, st, p), S, ok(fn_update(fn_update(S, "blocks", malloc.set_block(S.blocks, p, none)), "vm", V), empty))
proof
  assume hp0 hi he hw hbl hbt hv hst hwk hek pux pu
  have bu := apply(mp.uf_bu[b := S.blocks, p := p], hbt)
  let X := fn_update(S, "blocks", malloc.set_block(S.blocks, p, none))
  let T := fn_update(X, "vm", V)
  let R := malloc.range(p, snd(S.blocks[p]))
  have hwk2: malloc.world_ok(b, cd, st, fn_update(X, "vm", V)) := hwk
  have hek2: malloc.errno_ok(eo, fn_update(X, "vm", V)) := hek
  have as: runs(malloc.allocator_step(I, O, eo, b, cd, st, S, R), X, ok(T, empty)) by spec_ret({V}, hv, hst, hwk2, hek2, pux)
  have br := mp(all_elim(gc.bind_ok[p := malloc.allocator_step(I, O, eo, b, cd, st, S, R), k := x6 x7. ok(T, empty) = ok(x6, empty), x := x6 x7. ok(T, empty) = exc(x6, x7),
    d := x6. ok(T, empty) = diverge(x6)], {X}, {T}, {empty}), as, refl({ok(T, empty)}))
  show by spec_ret({ok(pair(S, empty), empty)}, hp0, hi, he, hw, hbl, br, bu, pu)
qed

// ... anything where undefined (its precondition failing, p no live block)
theorem mp.tf_fany(I, O, eo, b, cd, st, S, p, o): !(p = 0) -> pair(S, o) in univ(1) ->
  !((S in I && malloc.errno_ok(eo, S)) && !(S.blocks[p] = none)) ->
  runs(malloc.free(I, O, eo, b, cd, st, p), S, o)
proof
  assume hp0 pu hn
  show by spec_ret({ok(pair(S, empty), empty)}, hp0, hn, pu)
qed

// ----------------------------------------------------------------------
//  ... as a C function value (any result), widened

abbrev mp.UFF(c, eo, b, cd, st) := malloc.free_fun(mallocng.inv(c), mallocng.owned(c), eo, b, cd, st)
// the layer's free defined: a list of arguments, p 0 or a live block in a
// state of the layer's precondition
abbrev mp.FPRE(c, eo, b, cd, st, regs, S) := ord_le(1, seq_len(regs)) && malloc.world_ok(b, cd, st, S) &&
  (regs[0] = 0 || (mp.MPRE(c, eo, b, cd, st, S) && !(S.blocks[regs[0]] = none)))

abbrev mp.FREL(I, O, eo, b, cd, st, regs, x1, x2) := !ord_le(1, seq_len(regs)) || bind_rel(malloc.free(I, O, eo, b, cd, st, regs[0]), x1,
  x3 x4. any_rel(x5. x5 in bits(64), x5. x2 = ok(x3, x5)), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))

theorem mp.tf_fun(I, O, eo, b, cd, st, regs, S, o): regs in abi.ARGS -> pair(S, o) in univ(1) -> mp.FREL(I, O, eo, b, cd, st, regs, S, o) ->
  runs(malloc.free_fun(I, O, eo, b, cd, st)[regs], S, o)
proof
  assume hr pu br
  have r := mp(all_elim(tr.runs_intro[r := x1 x2. mp.FREL(I, O, eo, b, cd, st, regs, x1, x2)], {S}, {o}), pu, br)
  show by defs(rewrite(sym(mp(app_fn_build[d := abi.ARGS, v := x0. mkprog(x1 x2. mp.FREL(I, O, eo, b, cd, st, x0, x1, x2)), a := regs], hr)), r), malloc.free_fun)
qed

theorem mp.tf_rel_ok(I, O, eo, b, cd, st, regs, S, x, v): v in bits(64) -> runs(malloc.free(I, O, eo, b, cd, st, regs[0]), S, ok(x, empty)) ->
  mp.FREL(I, O, eo, b, cd, st, regs, S, ok(x, v))
proof
  assume hv hr
  have k: any_rel(x5. x5 in bits(64), x5. ok(x, v) = ok(x, x5)) by spec_ret({v}, hv)
  have br := mp(all_elim(gc.bind_ok[p := malloc.free(I, O, eo, b, cd, st, regs[0]), k := x3 x4. any_rel(x5. x5 in bits(64), x5. ok(x, v) = ok(x3, x5)),
    x := x3 x4. ok(x, v) = exc(x3, x4), d := x3. ok(x, v) = diverge(x3)], {S}, {x}, {empty}), hr, k)
  show by taut(br)
qed

theorem mp.tf_rel_exc(I, O, eo, b, cd, st, regs, S, x, e): runs(malloc.free(I, O, eo, b, cd, st, regs[0]), S, exc(x, e)) ->
  mp.FREL(I, O, eo, b, cd, st, regs, S, exc(x, e))
proof
  assume hr
  have br := mp(all_elim(gc.bind_exc[p := malloc.free(I, O, eo, b, cd, st, regs[0]), k := x3 x4. any_rel(x5. x5 in bits(64), x5. exc(x, e) = ok(x3, x5)),
    x := x3 x4. exc(x, e) = exc(x3, x4), d := x3. exc(x, e) = diverge(x3)], {S}, {x}, {e}), hr, refl({exc(x, e)}))
  show by taut(br)
qed

theorem mp.tf_rel_div(I, O, eo, b, cd, st, regs, S, t): runs(malloc.free(I, O, eo, b, cd, st, regs[0]), S, diverge(t)) ->
  mp.FREL(I, O, eo, b, cd, st, regs, S, diverge(t))
proof
  assume hr
  have br := mp(all_elim(gc.bind_div[p := malloc.free(I, O, eo, b, cd, st, regs[0]), k := x3 x4. any_rel(x5. x5 in bits(64), x5. diverge(t) = ok(x3, x5)),
    x := x3 x4. diverge(t) = exc(x3, x4), d := x3. diverge(t) = diverge(x3)], {S}, {t}), hr, refl({diverge(t)}))
  show by taut(br)
qed

// the layer's free widened: anything where undefined
theorem mp.tf_any(c, eo, b, cd, st, regs, S, o): regs in abi.ARGS -> pair(S, o) in univ(1) -> abi.outcome(o) ->
  (all x v. o = ok(x, v) -> v in cart(bits(64), bits(64))) -> !mp.FPRE(c, eo, b, cd, st, regs, S) ->
  runs(abi.wide(malloc.Heap.ghost, mp.UFF(c, eo, b, cd, st))[regs], S, o)
proof
  assume hra pu hsh hv hn
  let I := mallocng.inv(c)
  let O := mallocng.owned(c)
  // (the layer's free from S: anything)
  have fa: all o1. pair(S, o1) in univ(1) -> ord_le(1, seq_len(regs)) -> runs(malloc.free(I, O, eo, b, cd, st, regs[0]), S, o1) proof
    fix o1
    assume pu1 o1l
    have cw: !malloc.world_ok(b, cd, st, S) -> runs(malloc.free(I, O, eo, b, cd, st, regs[0]), S, o1) proof
      assume nw
      show := apply(mp.tf_fanyw[I := I, O := O, eo := eo, b := b, cd := cd, st := st, S := S, p := regs[0], o := o1], pu1, nw)
    qed
    have cd2: malloc.world_ok(b, cd, st, S) -> runs(malloc.free(I, O, eo, b, cd, st, regs[0]), S, o1) proof
      assume wk
      have p0: !(regs[0] = 0) by taut(hn, o1l, wk)
      have nd: !((S in I && malloc.errno_ok(eo, S)) && !(S.blocks[regs[0]] = none)) by taut(hn, o1l, wk)
      show := apply(mp.tf_fany[I := I, O := O, eo := eo, b := b, cd := cd, st := st, S := S, p := regs[0], o := o1], p0, pu1, nd)
    qed
    show by taut(cw, cd2)
  qed
  have k1: (ex m1 e. o = ok(m1, e)) -> runs(abi.wide(malloc.Heap.ghost, mp.UFF(c, eo, b, cd, st))[regs], S, o) proof
    assume e
    obtain x v, eo1 from e
    obtain r y, hr0 hy ev from apply(cart_elim, mp(all_elim(hv, {x}, {v}), eo1))
    have pu2: pair(S, ok(x, pair(r, y))) in univ(1) := rewrite(ev, rewrite(eo1, pu))
    have pu1: pair(S, ok(x, r)) in univ(1) by simp(pu2)
    have pu0: pair(S, ok(x, empty)) in univ(1) by simp(pu2)
    have fr: mp.FREL(I, O, eo, b, cd, st, regs, S, ok(x, r)) proof
      have c0: !ord_le(1, seq_len(regs)) -> mp.FREL(I, O, eo, b, cd, st, regs, S, ok(x, r)) proof
        assume n0
        show by taut(n0)
      qed
      have c1: ord_le(1, seq_len(regs)) -> mp.FREL(I, O, eo, b, cd, st, regs, S, ok(x, r)) proof
        assume o1l
        show := apply(mp.tf_rel_ok[I := I, O := O, eo := eo, b := b, cd := cd, st := st, regs := regs, S := S, x := x, v := r], hr0,
          mp(all_elim(fa, {ok(x, empty)}), pu0, o1l))
      qed
      show by taut(c0, c1)
    qed
    have fv := apply(mp.tf_fun[I := I, O := O, eo := eo, b := b, cd := cd, st := st, regs := regs, S := S, o := ok(x, r)], hra, pu1, fr)
    have w := apply(mp.top_wide[G := malloc.Heap.ghost, F := mp.UFF(c, eo, b, cd, st), regs := regs, S := S, o2 := ok(x, pair(r, y))], hra, pu2,
      apply(mp.wr_ok, hy, fv))
    show := rewrite(sym(eo1), rewrite(sym(ev), w))
  qed
  have k2: (ex m1 e. o = exc(m1, e)) -> runs(abi.wide(malloc.Heap.ghost, mp.UFF(c, eo, b, cd, st))[regs], S, o) proof
    assume e
    obtain x ee, eo1 from e
    have pu1 := rewrite(eo1, pu)
    have fr: mp.FREL(I, O, eo, b, cd, st, regs, S, exc(x, ee)) proof
      have c0: !ord_le(1, seq_len(regs)) -> mp.FREL(I, O, eo, b, cd, st, regs, S, exc(x, ee)) proof
        assume n0
        show by taut(n0)
      qed
      have c1: ord_le(1, seq_len(regs)) -> mp.FREL(I, O, eo, b, cd, st, regs, S, exc(x, ee)) proof
        assume o1l
        show := apply(mp.tf_rel_exc, mp(all_elim(fa, {exc(x, ee)}), pu1, o1l))
      qed
      show by taut(c0, c1)
    qed
    have fv := apply(mp.tf_fun[I := I, O := O, eo := eo, b := b, cd := cd, st := st, regs := regs, S := S, o := exc(x, ee)], hra, pu1, fr)
    have w := apply(mp.top_wide[G := malloc.Heap.ghost, F := mp.UFF(c, eo, b, cd, st), regs := regs, S := S, o2 := exc(x, ee)], hra, pu1, apply(mp.wr_exc, fv))
    show := rewrite(sym(eo1), w)
  qed
  have k3: (ex t. o = diverge(t)) -> runs(abi.wide(malloc.Heap.ghost, mp.UFF(c, eo, b, cd, st))[regs], S, o) proof
    assume e
    obtain t, eo1 from e
    have pu1 := rewrite(eo1, pu)
    have fr: mp.FREL(I, O, eo, b, cd, st, regs, S, diverge(t)) proof
      have c0: !ord_le(1, seq_len(regs)) -> mp.FREL(I, O, eo, b, cd, st, regs, S, diverge(t)) proof
        assume n0
        show by taut(n0)
      qed
      have c1: ord_le(1, seq_len(regs)) -> mp.FREL(I, O, eo, b, cd, st, regs, S, diverge(t)) proof
        assume o1l
        show := apply(mp.tf_rel_div, mp(all_elim(fa, {diverge(t)}), pu1, o1l))
      qed
      show by taut(c0, c1)
    qed
    have fv := apply(mp.tf_fun[I := I, O := O, eo := eo, b := b, cd := cd, st := st, regs := regs, S := S, o := diverge(t)], hra, pu1, fr)
    have w := apply(mp.top_wide[G := malloc.Heap.ghost, F := mp.UFF(c, eo, b, cd, st), regs := regs, S := S, o2 := diverge(t)], hra, pu1, apply(mp.wr_div, fv))
    show := rewrite(sym(eo1), w)
  qed
  show by taut(hsh, k1, k2, k3)
qed

// ----------------------------------------------------------------------
//  After __libc_free(p): the new state's representation, the allocator's
//  step

// (a block's byte: live)
theorem mp.blk_live(b, p, a): p in bits(64) -> !(b[p] = none) -> a in omega -> a in malloc.range(p, snd(b[p])) -> a in malloc.live_of(b)
proof
  assume hp hn ao ar
  show by taut(apply(mp.live_def[b := b, a := a]), ao, (ex q. q in bits(64) && (!(b[q] = none) && a in malloc.range(q, snd(b[q]))) by ex_intro({p}, taut(hp, hn, ar))))
qed

// (a live block: neither the thread's word nor the stack protector's --
// those none of the allocator's ranges, the block in them)
theorem mp.blk_off(c, A, S, p): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> S.blocks in fn_space(bits(64), option(omega)) -> S.fs_base in bits(64) ->
  mallocng.rep(c, A, S) -> p in bits(64) -> !(S.blocks[p] = none) ->
  all i. i in omega -> int_lt(i, 8) -> !(int_add(S.fs_base, i) in malloc.range(p, snd(S.blocks[p]))) && !(int_add(int_add(S.fs_base, 40), i) in malloc.range(p, snd(S.blocks[p])))
proof
  assume hc hu ha hb fsb hr hp hn
  have {hm = mem, rtl = tls, rca = canary} := expand(hr, mallocng.rep)
  have {l = live} := apply(mp.has_rng, hc, hu, ha, hb, hm)
  fix i
  assume hi hil
  have c1: !(int_add(S.fs_base, i) in malloc.range(p, snd(S.blocks[p]))) proof
    assume w
    have lv := apply(mp.blk_live[b := S.blocks, p := p, a := int_add(S.fs_base, i)], hp, hn, (int_add(S.fs_base, i) in omega by arith(fsb, hi)), w)
    show by taut(mp(all_elim(l, {int_add(S.fs_base, i)}), lv), mp(all_elim(rtl, {i}), hi, hil))
  qed
  have c2: !(int_add(int_add(S.fs_base, 40), i) in malloc.range(p, snd(S.blocks[p]))) proof
    assume w
    have lv := apply(mp.blk_live[b := S.blocks, p := p, a := int_add(int_add(S.fs_base, 40), i)], hp, hn, (int_add(int_add(S.fs_base, 40), i) in omega by arith(fsb, hi)), w)
    have ic: int_add(int_add(S.fs_base, 40), i) in abi.canary(S.fs_base) by defs(sel(arith(fsb, hi, hil)), abi.canary)
    have nr _ := mp(all_elim(rca, {int_add(int_add(S.fs_base, 40), i)}), (int_add(int_add(S.fs_base, 40), i) in omega by arith(fsb, hi)), ic)
    show by taut(mp(all_elim(l, {int_add(int_add(S.fs_base, 40), i)}), lv), nr)
  qed
  show by taut(c1, c2)
qed

// errno usable after a step freeing block p: its bytes neither the
// allocator's nor the block's (rep's errno clause), mapped -- their pages kept
theorem mp.eok_free(c, eo, A, S, T, p): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> S in rec_and(abi.World, malloc.Heap.ghost) ->
  S.blocks in fn_space(bits(64), option(omega)) -> S.fs_base in bits(64) -> app(eo, empty) = 52 -> abi.thread_ok(S.vm, S.fs_base) -> mallocng.rep(c, A, S) ->
  p in bits(64) -> !(S.blocks[p] = none) -> malloc.alloc_frame(mallocng.owned(c), S, T.vm, malloc.range(p, snd(S.blocks[p]))) -> T.fs_base = S.fs_base ->
  malloc.errno_ok(eo, S) -> malloc.errno_ok(eo, T)
proof
  assume hc hu ha hs hb fsb he hth hr hp hn haf tf heo
  have {fsl = fsl} := apply(mp.top_fsl, fsb, hth)
  have {hm = mem, rer = errno} := expand(hr, mallocng.rep)
  have {f1 = fp, l = live} := apply(mp.has_rng, hc, hu, ha, hb, hm)
  have k1 _ _ _ _ := expand(haf, malloc.alloc_frame)
  have ep: mp.am_epg(S, T.vm) proof
    fix i
    assume hi hil
    let a := int_add(int_add(S.fs_base, 52), i)
    have ao: a in omega by arith(fsb, hi)
    have nr := mp(all_elim(rer, {i}), hi, hil)
    have no: !(a in mallocng.owned(c)[S]) proof
      assume w
      obtain B, hb2 hbr hbf from apply(mallocng.owned_mem[c := c, s := S, a := a], hs, w)
      have eq := apply(mallocng.abs_unique[c := c, s := S, A := B, B := A], hc, hs, hb2, ha, hbr, hr)
      show by taut(mp(all_elim(f1, {a}), rewrite(eq, hbf)), nr)
    qed
    have nx: !(a in malloc.range(p, snd(S.blocks[p]))) proof
      assume w
      have lv := apply(mp.blk_live[b := S.blocks, p := p, a := a], hp, hn, ao, w)
      show by taut(mp(all_elim(l, {a}), lv), nr)
    qed
    have rw := mp(all_elim(expand(heo, malloc.errno_ok), {a}), ao, apply(mp.top_ebyte[eo := eo, S := S, i := i], fsb, fsl, he, hi, hil))
    have mq _ _ := expand(rw, malloc.rw_mapped)
    have _ pe := mp(all_elim(k1, {a}), ao, conj(conj(no, nx), mq))
    show pe
  qed
  show := apply(mp.eok_T[eo := eo, S := S, T := T], fsb, fsl, he, tf, heo, ep)
qed

// (the blocks with p dropped: live bytes only the old ones)
theorem mp.live_drop(b, p, a): p in bits(64) -> a in malloc.live_of(malloc.set_block(b, p, none)) -> a in malloc.live_of(b)
proof
  assume hp h
  have ao ex := (a in omega && (ex q. q in bits(64) && (!(malloc.set_block(b, p, none)[q] = none) && a in malloc.range(q, snd(malloc.set_block(b, p, none)[q]))))
    by taut(apply(mp.live_def[b := malloc.set_block(b, p, none), a := a]), h))
  obtain q, hq hqn hqr from ex
  have qp: !(q = p) proof
    assume e
    have z: malloc.set_block(b, p, none)[q] = none by defs(simp(e, hp), malloc.set_block)
    show by taut(hqn, z)
  qed
  have bq: malloc.set_block(b, p, none)[q] = b[q] by defs(simp(hq, qp), malloc.set_block)
  show by taut(apply(mp.live_def[b := b, a := a]), ao, (ex q2. q2 in bits(64) && (!(b[q2] = none) && a in malloc.range(q2, snd(b[q2])))
    by ex_intro({q}, taut(hq, rewrite(bq, hqn), rewrite(bq, hqr)))))
qed

// From A at S to A2 at T, the memory outside the allocator's untouched but
// X, the allocator grown only into X or memory unmapped before: a step of
// the layer's allocator with X extra
theorem mp.top_stepx(c, A, S, T, A2, X, b, cd, st): c in mallocng.Cfg -> A in mallocng.Abs -> A2 in mallocng.Abs ->
  S in rec_and(abi.World, malloc.Heap.ghost) -> T in rec_and(abi.World, malloc.Heap.ghost) ->
  mallocng.rep(c, A, S) -> mallocng.rep(c, A2, T) -> malloc.world_ok(b, cd, st, S) ->
  mallocng.untouched(c, A, S.blocks, S.vm, T.vm, S.objs, X) ->
  (all a. a in omega -> a in mallocng.footprint(c, A2, T.blocks) ->
     (a in mallocng.footprint(c, A, S.blocks) || a in X) || (!x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) && !mallocng.in_stack_space(S.vm, a))) ->
  malloc.step_ok(mallocng.inv(c), mallocng.owned(c), S, T, X)
proof
  assume hcf ha ha2 hs ht hr hr2 hw hun hg
  have nst _ _ _ _ _ lst _ := expand(hw, malloc.world_ok)
  have uk uo bk := expand(hun, mallocng.untouched)
  have fr: all a. a in omega -> (!(a in mallocng.owned(c)[S]) && !(a in X)) && x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) ->
      T.vm.bytes[bits_of_int(64, a)] = S.vm.bytes[bits_of_int(64, a)] && T.vm.pages[int_div(a, x86_64_linux.PAGE)] = S.vm.pages[int_div(a, x86_64_linux.PAGE)] proof
    fix a
    assume ao h
    have no nx hm := h
    have nf: !(a in mallocng.footprint(c, A, S.blocks)) proof
      assume w
      show by taut(no, apply(mallocng.owned_intro[c := c, s := S, A := A, a := a], hs, ha, hr, ao, w))
    qed
    have ml mn := expand(hm, x86_64_linux.mapped)
    have kp: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
    have qs: int_div(a, x86_64_linux.PAGE) in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) by sel(taut((int_div(a, x86_64_linux.PAGE) in omega by arith(ao, kp)), ml))
    have nk := mp(all_elim(nst, {int_div(a, x86_64_linux.PAGE)}), qs, mn)
    have nsf: !abi.stack_free(S.vm, S.objs, a) by defs(taut(hm, nk), abi.stack_free)
    have u1 u2 := mp(all_elim(uk, {a}), ao, conj(conj(nf, nx), hm))
    show by taut(mp(u1, nsf), u2)
  qed
  // the callers' objects: on mapped pages as above, or in the stack's
  // space (the world's), on no page -- untouched
  have fo: all a. a in omega -> ((!(a in mallocng.owned(c)[S]) && !(a in X)) && a in S.objs.live) && int_lt(a, x86_64_linux.TASK_SIZE) ->
      T.vm.bytes[bits_of_int(64, a)] = S.vm.bytes[bits_of_int(64, a)] && T.vm.pages[int_div(a, x86_64_linux.PAGE)] = S.vm.pages[int_div(a, x86_64_linux.PAGE)] proof
    fix a
    assume ao h
    have no nx hl ht2 := h
    have cm: x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) ->
        T.vm.bytes[bits_of_int(64, a)] = S.vm.bytes[bits_of_int(64, a)] && T.vm.pages[int_div(a, x86_64_linux.PAGE)] = S.vm.pages[int_div(a, x86_64_linux.PAGE)] proof
      assume hm
      show := mp(all_elim(fr, {a}), ao, conj(conj(no, nx), hm))
    qed
    have cu: !x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) ->
        T.vm.bytes[bits_of_int(64, a)] = S.vm.bytes[bits_of_int(64, a)] && T.vm.pages[int_div(a, x86_64_linux.PAGE)] = S.vm.pages[int_div(a, x86_64_linux.PAGE)] proof
      assume nm
      have nf: !(a in mallocng.footprint(c, A, S.blocks)) proof
        assume w
        show by taut(no, apply(mallocng.owned_intro[c := c, s := S, A := A, a := a], hs, ha, hr, ao, w))
      qed
      have l1 l2 _ := mp(all_elim(lst, {a}), ao, hl)
      have is: mallocng.in_stack_space(S.vm, a) by defs(taut(l1, l2, ht2), mallocng.in_stack_space)
      show := mp(all_elim(uo, {a}), ao, conj(conj(conj(conj(nf, nx), hl), is), nm))
    qed
    show by taut(cm, cu)
  qed
  have b1 b2 b3 _ := expand(bk, mallocng.bounds_kept)
  have af: malloc.alloc_frame(mallocng.owned(c), S, T.vm, X) by defs(taut(fr, fo, b1, b2, b3), malloc.alloc_frame)
  have ti := apply(mallocng.inv_intro[c := c, s := T, A := A2], ht, ha2, hr2)
  have ow: all a. a in omega -> a in mallocng.owned(c)[T] ->
      (a in mallocng.owned(c)[S] || a in X) || (!x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) && !(a in S.objs.live)) proof
    fix a
    assume ao h
    obtain B, hb hbr hbf from apply(mallocng.owned_mem[c := c, s := T, a := a], ht, h)
    have eq := apply(mallocng.abs_unique[c := c, s := T, A := B, B := A2], hcf, ht, hb, ha2, hbr, hr2)
    have g1 := mp(all_elim(hg, {a}), ao, rewrite(eq, hbf))
    have c1: a in mallocng.footprint(c, A, S.blocks) -> a in mallocng.owned(c)[S] proof
      assume w
      show := apply(mallocng.owned_intro[c := c, s := S, A := A, a := a], hs, ha, hr, ao, w)
    qed
    have c2: !mallocng.in_stack_space(S.vm, a) -> !(a in S.objs.live) proof
      assume nn
      assume hl
      show by taut(nn, apply(mp.live_iss[b := b, cd := cd, st := st, S := S, a := a], hw, ao, hl))
    qed
    show by taut(g1, c1, c2)
  qed
  show by defs(taut(af, ti, ow), malloc.step_ok)
qed

// After __libc_free(p) (`mp.lf_post`'s parts, from A at S): the new state
// (the block not live, the memory V) represented by A2
theorem mp.top_ffree(c, A, S, A2, V, p): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> S.blocks in fn_space(bits(64), option(omega)) ->
  S.fs_base in bits(64) -> p in bits(64) -> mallocng.rep(c, A, S) -> abi.thread_ok(S.vm, S.fs_base) -> abi.canary_ok(S.vm, S.fs_base) ->
  mallocng_specs.errno_apart(c, A, S.vm, S.fs_base) -> !(S.blocks[p] = none) ->
  A2 in mallocng.Abs -> A2 in univ(1) -> mallocng.no_reserved(A2) -> seq_len(A2.taken) = 0 ->
  mallocng.holds_m(c, A2, V, malloc.set_block(S.blocks, p, none)) -> mallocng.shown_in(c, A2, S.objs) ->
  (all a. a in mallocng.footprint(c, A2, malloc.set_block(S.blocks, p, none)) -> a in mallocng.footprint(c, A, S.blocks) || a in malloc.range(p, snd(S.blocks[p]))) ->
  mallocng.rep(c, A2, fn_update(fn_update(S, "blocks", malloc.set_block(S.blocks, p, none)), "vm", V))
proof
  assume hc hu ha hb fsb hp hr hth hcn hea hbl a2a a2u nr2 tk2 hm2 hsh2 hfp
  let B := S.blocks
  let B2 := malloc.set_block(B, p, none)
  have {hm = mem, rtl = tls, rca = canary} := expand(hr, mallocng.rep)
  have b2t := apply(mp.uf_btype[b := B, p := p], hb)
  have {fsl = fsl, ea = ea} := apply(mp.top_fsl, fsb, hth)
  have {f = fp, l = live} := apply(mp.has_rng, hc, hu, ha, hb, hm)
  have gfp: all a. a in omega -> a in mallocng.footprint(c, A2, B2) ->
      mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) || (!x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) && !mallocng.in_stack_space(S.vm, a)) proof
    fix a
    assume ao h
    have c1: a in malloc.range(p, snd(B[p])) -> mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) proof
      assume w
      show := mp(all_elim(l, {a}), apply(mp.blk_live, hp, hbl, ao, w))
    qed
    show by taut(mp(all_elim(hfp, {a}), h), all_elim(f, {a}), c1)
  qed
  have grs: all a. a in omega -> mallocng.in_reserved(A2, a) ->
      mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) || (!x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) && !mallocng.in_stack_space(S.vm, a)) proof
    fix a
    assume _ h
    show by taut(h, apply(mp.nores[A := A2, a := a], nr2))
  qed
  have gtk: all a. a in omega -> mallocng.in_taken(A2, a) ->
      mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) || (!x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) && !mallocng.in_stack_space(S.vm, a)) proof
    fix a
    assume _ w
    obtain kk, hkk hkkl _ _ from expand(w, mallocng.in_taken)
    have f0: false by arith(hkk, hkkl, tk2)
    show by taut(f0)
  qed
  have glv: all a. a in omega -> a in malloc.live_of(B2) ->
      mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) || (!x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) && !mallocng.in_stack_space(S.vm, a)) proof
    fix a
    assume _ h
    show by taut(mp(all_elim(l, {a}), apply(mp.live_drop, hp, h)))
  qed
  have grown := apply(mp.rng_grow[c := c, A := A, A2 := A2, b2 := B2, vm := S.vm], gfp, grs, gtk, glv)
  have tl2 := apply(mp.tls_grow[c := c, A := A, A2 := A2, vm := S.vm, fs := S.fs_base], fsb, hth, (mallocng_specs.tls_apart(c, A, S.fs_base) by defs(rtl, mallocng_specs.tls_apart)), grown)
  have er2: all x0. x0 in omega -> int_lt(x0, 4) -> !mallocng.in_ranges(int_add(int_add(S.fs_base, 52), x0), mallocng.fp_ranges(c, A2)) proof
    fix i
    assume hi hil
    have n0 m0 := rewrite(ea, mp(all_elim(expand(hea, mallocng_specs.errno_apart), {i}), hi, hil))
    assume ir
    show by taut(mp(all_elim(grown, {int_add(int_add(S.fs_base, 52), i)}), (int_add(int_add(S.fs_base, 52), i) in omega by arith(fsb, hi)), ir), n0, m0)
  qed
  have ca2 := apply(mp.top_can[c := c, A := A, A2 := A2, V2 := V, b2 := B2, vm := S.vm, fs := S.fs_base], hc, a2u, a2a, hm2, fsb, hcn, grown, rca)
  have lv2 := apply(mp.top_live[c := c, A := A2, V := V, b := B2], a2a, b2t, hm2)
  let T := fn_update(fn_update(S, "blocks", B2), "vm", V)
  have tm: mallocng.holds_m(c, A2, T.vm, T.blocks) by simp(hm2, keep(mallocng.holds_m))
  have tl: malloc.live_rw(T) by defs(simp(lv2), malloc.live_rw)
  have tt: all x0. x0 in omega -> int_lt(x0, 8) -> !mallocng.in_ranges(int_add(T.fs_base, x0), mallocng.fp_ranges(c, A2)) by simp(expand(tl2, mallocng_specs.tls_apart))
  have te: all x0. x0 in omega -> int_lt(x0, 4) -> !mallocng.in_ranges(int_add(int_add(T.fs_base, 52), x0), mallocng.fp_ranges(c, A2)) by simp(er2)
  have tc: all x0. x0 in omega -> x0 in abi.canary(T.fs_base) -> !mallocng.in_ranges(x0, mallocng.fp_ranges(c, A2)) &&
      !((int_lt(0, A2.reserve_cnt) && int_le(int_div(A2.reserve, x86_64_linux.PAGE), int_div(x0, x86_64_linux.PAGE))) &&
        int_lt(int_div(x0, x86_64_linux.PAGE), int_add(int_div(A2.reserve, x86_64_linux.PAGE), A2.reserve_cnt))) by simp(ca2)
  have {ax2 = aux} := expand(hsh2, mallocng.shown_in)
  have tx: mallocng.aux_live(A2, T.objs) by simp(ax2, keep(mallocng.aux_live))
  show by defs(taut(tm, nr2, tk2, tl, tt, te, tc, tx), mallocng.rep)
qed

// ----------------------------------------------------------------------
//  The `free` symbol's returns as the layer's free's

// a live block p given back (`mp.lf_post`, from A at the layer's state):
// the layer's free's, the block no longer live
theorem mp.tf_blk(c, eo, b, cd, st, regs, s, h, A, V, y0, y1, k): c in mallocng.Cfg -> app(eo, empty) = 52 -> regs in abi.ARGS -> ord_le(1, seq_len(regs)) ->
  s in abi.World -> s in univ(1) -> h in malloc.Heap.ghost -> !(regs[0] = 0) -> mp.MPRE(c, eo, b, cd, st, union2(s, h)) -> !(union2(s, h).blocks[regs[0]] = none) ->
  A in mallocng.Abs -> mallocng.rep(c, A, union2(s, h)) -> regs[0] in bits(64) ->
  V in x86_64_linux.Vm -> y0 in bits(64) -> y1 in bits(64) -> mp.lf_post(c, A, h.blocks, regs[0], s, V) -> mp.code_img(c, app(b, empty), app(cd, empty), k) ->
  ex h2. h2 in malloc.Heap.ghost && runs(abi.wide(malloc.Heap.ghost, mp.UFF(c, eo, b, cd, st))[regs], union2(s, h), with_ghost(ok(fn_update(s, "vm", V), pair(y0, y1)), h2))
proof
  assume hc he hra o1l hs su hh hp0 hpre hbl ha hrep hpb hv hy0 hy1 hpost hci
  let S := union2(s, h)
  let p := regs[0]
  have hinv heo hwo := hpre
  have au := apply(mallocng.abs_univ, ha)
  have sd: dom(s) = abi.WKEYS by simp(expand(hs, abi.World))
  have hd: dom(h) = insert("blocks", empty) by simp(expand(hh, malloc.Heap.ghost))
  have vS: S.vm = s.vm by simp(sd, hd)
  have oS: S.objs = s.objs by simp(sd, hd)
  have fS: S.fs_base = s.fs_base by simp(sd, hd)
  have bS: S.blocks = h.blocks by simp(sd, hd)
  have fsb: S.fs_base in bits(64) := rewrite(sym(fS), (s.fs_base in bits(64) by simp(hs)))
  have bt: S.blocks in fn_space(bits(64), option(omega)) := rewrite(sym(bS), (h.blocks in fn_space(bits(64), option(omega)) by simp(expand(hh, malloc.Heap.ghost))))
  // the purpose's outcome, as of S
  obtain A2, a2a a2u nrt hin2 hun0 hfp0 from rewrite(sym(bS), rewrite(sym(oS), rewrite(sym(vS), hpost)))
  have nr2 tk2 := nrt
  have {hm2 = mem, hsh2 = shown} := hin2
  have _ _ th cn _ _ _ _ := expand(hwo, malloc.world_ok)
  have {eap = apart} := apply(mp.top_pre[c := c, A := A, S := S, eo := eo, b := b, cd := cd, st := st], fsb, hrep, he, heo, hwo)
  have rep2 := apply(mp.top_ffree[c := c, A := A, S := S, A2 := A2, V := V, p := p], hc, au, ha, bt, fsb, hpb, hrep, th, cn, eap, hbl, a2a, a2u, nr2, tk2, hm2, hsh2, hfp0)
  // the new state T: the block not live, the memory V
  let B2 := malloc.set_block(S.blocks, p, none)
  let R := malloc.range(p, snd(S.blocks[p]))
  let H2 := fn_update(h, "blocks", B2)
  let T := fn_update(fn_update(S, "blocks", B2), "vm", V)
  have b2u := apply(mp.uf_bu[b := S.blocks, p := p], bt)
  have hg2 := apply(mp.hg_updb[h := h, b2 := B2], hh, apply(mp.uf_btype[b := S.blocks, p := p], bt), b2u)
  have {typ = typ, eq = eq, uv = uv} := apply(mp.top_rec[s := s, h := h, h2 := H2, V := V], hs, su, hh, hg2, hv, disj({2}, ex_intro({B2}, refl({H2}))))
  have hb2: H2.blocks = B2 := app_update_same[f := h, k := "blocks", v := B2]
  have te: union2(fn_update(s, "vm", V), H2) = T := rewrite(hb2, eq)
  have tg := rewrite(te, typ)
  have tu := rewrite(te, uv)
  have tv: T.vm = V by simp()
  have tb: T.blocks = B2 by simp()
  have sg := apply(rec_and_intro, hs, hh)
  have grw: all a. a in omega -> a in mallocng.footprint(c, A2, T.blocks) ->
      (a in mallocng.footprint(c, A, S.blocks) || a in R) || (!x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) && !mallocng.in_stack_space(S.vm, a)) proof
    fix a
    assume _ w
    show by taut(mp(all_elim(hfp0, {a}), rewrite(tb, w)))
  qed
  have stp := apply(mp.top_stepx[c := c, A := A, S := S, T := T, A2 := A2, X := R, b := b, cd := cd, st := st], hc, ha, a2a, sg, tg, hrep, rep2, hwo,
    rewrite(sym(tv), hun0), grw)
  // the layer's free giving the block back, as a C function value, widened
  have Su: S in univ(1) := mp(union2_univ[u := 1, a := s, b := h], su, (h in univ(1) by taut(mp(all_elim(mp.hg_ok, {h}), hh))))
  have pux: pair(fn_update(S, "blocks", B2), ok(T, empty)) in univ(1) by simp(Su, b2u, tu)
  have pu: pair(S, ok(T, empty)) in univ(1) by simp(Su, tu)
  // (the world after: as any call needs it)
  have svm: S.vm in x86_64_linux.Vm := rewrite(sym(vS), (s.vm in x86_64_linux.Vm by simp(expand(hs, abi.World))))
  have wk := apply(mp.wok_kept[c := c, A := A, A2 := A2, S := S, T := T, objs := S.objs, E := R, b := b, cd := cd, st := st, k := k],
    hc, au, ha, a2u, a2a, bt, svm, rewrite(sym(tb), apply(mp.uf_btype[b := S.blocks, p := p], bt)), rewrite(sym(tv), hv), fsb, hrep, rep2, hwo, rewrite(sym(tv), hun0),
    apply(mp.blk_off[c := c, A := A, S := S, p := p], hc, au, ha, bt, fsb, hrep, hpb, hbl), (T.objs = S.objs by simp()), (T.fs_base = S.fs_base by simp()), hci)
  have af _ _ := expand(stp, malloc.step_ok)
  have ek := apply(mp.eok_free[c := c, eo := eo, A := A, S := S, T := T, p := p], hc, au, ha, sg, bt, fsb, he, th, hrep, hpb, hbl, af, (T.fs_base = S.fs_base by simp()), heo)
  have fk := apply(mp.tf_fok[I := mallocng.inv(c), O := mallocng.owned(c), eo := eo, b := b, cd := cd, st := st, S := S, p := p, V := V],
    hp0, hinv, heo, hwo, hbl, bt, hv, stp, wk, ek, pux, pu)
  have pu1: pair(S, ok(T, y0)) in univ(1) by simp(Su, tu, hy0)
  have fv := apply(mp.tf_fun[I := mallocng.inv(c), O := mallocng.owned(c), eo := eo, b := b, cd := cd, st := st, regs := regs, S := S, o := ok(T, y0)], hra, pu1,
    apply(mp.tf_rel_ok[I := mallocng.inv(c), O := mallocng.owned(c), eo := eo, b := b, cd := cd, st := st, regs := regs, S := S, x := T, v := y0], hy0, fk))
  have pu2: pair(S, ok(T, pair(y0, y1))) in univ(1) by simp(Su, tu, hy0, hy1)
  have w := apply(mp.top_wide[G := malloc.Heap.ghost, F := mp.UFF(c, eo, b, cd, st), regs := regs, S := S, o2 := ok(T, pair(y0, y1))], hra, pu2,
    apply(mp.wr_ok[F := mp.UFF(c, eo, b, cd, st), regs := regs, S := S, x := T, r := y0, y := y1], hy1, fv))
  have r := rewrite(sym(all_elim(abi.wg_ok, {fn_update(s, "vm", V)}, {pair(y0, y1)}, {H2})), rewrite(sym(te), w))
  show by ex_intro({H2}, taut(hg2, r))
qed

// free(0): the layer's free's, the state as it was
theorem mp.tf_zero(c, eo, b, cd, st, regs, s, h, y0, y1): regs in abi.ARGS -> ord_le(1, seq_len(regs)) -> regs[0] = 0 ->
  s in abi.World -> s in univ(1) -> h in malloc.Heap.ghost -> malloc.world_ok(b, cd, st, union2(s, h)) -> y0 in bits(64) -> y1 in bits(64) ->
  runs(abi.wide(malloc.Heap.ghost, mp.UFF(c, eo, b, cd, st))[regs], union2(s, h), with_ghost(ok(fn_update(s, "vm", s.vm), pair(y0, y1)), h))
proof
  assume hra o1l r0 hs su hh hwk hy0 hy1
  let S := union2(s, h)
  have {wf = record, wd = has_vm} := apply(ms.world_parts, hs)
  have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], wf, wd)
  have hu _ _ := mp(all_elim(mp.hg_ok, {h}), hh)
  have Su: S in univ(1) := mp(union2_univ[u := 1, a := s, b := h], su, hu)
  have pu: pair(S, ok(S, empty)) in univ(1) by simp(Su)
  have f0 := rewrite(sym(r0), apply(mp.tf_f0[I := mallocng.inv(c), O := mallocng.owned(c), eo := eo, b := b, cd := cd, st := st, S := S], hwk, pu))
  have pu1: pair(S, ok(S, y0)) in univ(1) by simp(Su, hy0)
  have fv := apply(mp.tf_fun[I := mallocng.inv(c), O := mallocng.owned(c), eo := eo, b := b, cd := cd, st := st, regs := regs, S := S, o := ok(S, y0)], hra, pu1,
    apply(mp.tf_rel_ok[I := mallocng.inv(c), O := mallocng.owned(c), eo := eo, b := b, cd := cd, st := st, regs := regs, S := S, x := S, v := y0], hy0, f0))
  have pu2: pair(S, ok(S, pair(y0, y1))) in univ(1) by simp(Su, hy0, hy1)
  have w := apply(mp.top_wide[G := malloc.Heap.ghost, F := mp.UFF(c, eo, b, cd, st), regs := regs, S := S, o2 := ok(S, pair(y0, y1))], hra, pu2,
    apply(mp.wr_ok[F := mp.UFF(c, eo, b, cd, st), regs := regs, S := S, x := S, r := y0, y := y1], hy1, fv))
  have wg := all_elim(abi.wg_ok, {s}, {pair(y0, y1)}, {h})
  have r1 := rewrite(sym(wg), w)
  show := subst({z. runs(abi.wide(malloc.Heap.ghost, mp.UFF(c, eo, b, cd, st))[regs], S, with_ghost(ok(z, pair(y0, y1)), h))}, sym(ss), r1)
qed

// the `free` symbol from the world s with the layer's ghost part h, where
// the layer's free is undefined: its outcome the layer's (the live blocks
// as they were)
theorem mp.tf_undef(c, eo, b, cd, st, regs, s, h, o): regs in abi.ARGS -> s in abi.World -> h in malloc.Heap.ghost -> pair(s, o) in univ(1) -> abi.outcome(o) ->
  (all x v. o = ok(x, v) -> v in cart(bits(64), bits(64))) -> !mp.FPRE(c, eo, b, cd, st, regs, union2(s, h)) ->
  ex h2. h2 in malloc.Heap.ghost && runs(abi.wide(malloc.Heap.ghost, mp.UFF(c, eo, b, cd, st))[regs], union2(s, h), with_ghost(o, h2))
proof
  assume hra hs hh pu hsh hv hn
  have hu _ _ := mp(all_elim(mp.hg_ok, {h}), hh)
  have pu0 ou0 := apply(abi.wg_univ, pu, hu, hsh)
  have wt: all x v. with_ghost(o, h) = ok(x, v) -> v in cart(bits(64), bits(64)) proof
    fix x v
    assume e
    have k1: (ex m1 e1. o = ok(m1, e1)) -> v in cart(bits(64), bits(64)) proof
      assume w
      obtain m1 e1, eo1 from w
      have e2: ok(union2(m1, h), e1) = ok(x, v) := trans(sym(all_elim(abi.wg_ok, {m1}, {e1}, {h})), rewrite(eo1, e))
      have ve: e1 = v by simp(e2)
      show := rewrite(ve, mp(all_elim(hv, {m1}, {e1}), eo1))
    qed
    have k2: (ex m1 e1. o = exc(m1, e1)) -> v in cart(bits(64), bits(64)) proof
      assume w
      obtain m1 e1, eo1 from w
      have e2: exc(union2(m1, h), e1) = ok(x, v) := trans(sym(all_elim(abi.wg_exc, {m1}, {e1}, {h})), rewrite(eo1, e))
      show by simp(e2)
    qed
    have k3: (ex t. o = diverge(t)) -> v in cart(bits(64), bits(64)) proof
      assume w
      obtain t, eo1 from w
      have e2: diverge(t) = ok(x, v) := trans(sym(all_elim(abi.wg_div, {t}, {h})), rewrite(eo1, e))
      show by simp(e2)
    qed
    show by taut(hsh, k1, k2, k3)
  qed
  have r := apply(mp.tf_any[c := c, eo := eo, b := b, cd := cd, st := st, regs := regs, S := union2(s, h), o := with_ghost(o, h)], hra, pu0, ou0, wt, hn)
  show by ex_intro({h}, taut(hh, r))
qed

// ... where it frees a live block: from A (rep), the purpose spec's ghost
// part union2(h, {A}); __libc_free called as such up to n >= A's groups in
// use: the code's outcome __libc_free's (`mp.lf_res`)
theorem mp.tf_post(c, eo, b, cd, st, n, g, regs, s, h, A, o): app(eo, empty) = 52 -> mp.lf_call_n(c, g, n) -> regs in abi.ARGS -> ord_le(1, seq_len(regs)) ->
  s in abi.World -> h in malloc.Heap.ghost -> mp.MPRE(c, eo, b, cd, st, union2(s, h)) -> !(union2(s, h).blocks[regs[0]] = none) ->
  A in mallocng.Abs -> mallocng.rep(c, A, union2(s, h)) -> int_le(seq_len(A.used), n) ->
  runs(c_src_malloc_free.free_fun(g)[regs], s, o) ->
  abi.ovf_out(s, o) || (ex V r. (V in x86_64_linux.Vm && mp.lf_res(c, A, h.blocks, regs[0], s, V)) && o = ok(fn_update(s, "vm", V), r))
proof
  assume he hg hra o1l hs hh hpre hbl ha hrep hdep hr
  let S := union2(s, h)
  have hinv heo hwo := hpre
  let HA := union2(h, fn_update(empty, "A", A))
  have au := apply(mallocng.abs_univ, ha)
  have hag := apply(rec_and_intro, hh, apply(mp.abs_rec, ha, au))
  have sd: dom(s) = insert("vm", insert("os", insert("fs_base", insert("cpu", insert("objs", empty))))) by simp(expand(hs, abi.World))
  have hd: dom(h) = insert("blocks", empty) by simp(expand(hh, malloc.Heap.ghost))
  have vS: S.vm = s.vm by simp(sd, hd)
  have oS: S.objs = s.objs by simp(sd, hd)
  have fS: S.fs_base = s.fs_base by simp(sd, hd)
  have bS: S.blocks = h.blocks by simp(sd, hd)
  have aA: HA.A = A by simp(hd)
  have bA: HA.blocks = h.blocks by simp(hd)
  have fsb: s.fs_base in bits(64) by simp(hs)
  have {hin = hin, th = thread, tl = tls, bk = brk, eok = errno, eap = apart} := apply(mp.top_pre[c := c, A := A, S := S, eo := eo, b := b, cd := cd, st := st],
    rewrite(sym(fS), fsb), hrep, he, heo, hwo)
  have {hm = mem, hsh = shown} := hin
  have {nr = unres, tk = untaken} := expand(hrep, mallocng.rep)
  have q1: mallocng.holds_m(c, HA.A, s.vm, HA.blocks) := rewrite(sym(bA), rewrite(sym(aA), rewrite(bS, rewrite(vS, hm))))
  have q2: mallocng.shown_in(c, HA.A, s.objs) := rewrite(sym(aA), rewrite(oS, hsh))
  have q3: mallocng.no_reserved(HA.A) := rewrite(sym(aA), nr)
  have q4: seq_len(HA.A.taken) = 0 := rewrite(sym(aA), tk)
  have q5: abi.thread_ok(s.vm, s.fs_base) := rewrite(fS, rewrite(vS, th))
  have q6: mallocng_specs.tls_apart(c, HA.A, s.fs_base) := rewrite(sym(aA), rewrite(fS, tl))
  have q8: mallocng_specs.errno_ok(s.vm, s.objs, s.fs_base) := rewrite(fS, rewrite(oS, rewrite(vS, eok)))
  have q9: mallocng_specs.errno_apart(c, HA.A, s.vm, s.fs_base) := rewrite(sym(aA), rewrite(fS, rewrite(vS, eap)))
  have qin: mallocng.holds_in(c, HA.A, s.vm, s.objs, HA.blocks) by defs(taut(q1, q2), mallocng.holds_in)
  have qd: int_le(seq_len(HA.A.used), n) := rewrite(sym(aA), hdep)
  have qb: !(regs[0] = 0) -> !(HA.blocks[regs[0]] = none) proof
    assume _
    show := rewrite(sym(bA), rewrite(bS, hbl))
  qed
  have post := apply(mp.fr_post[c := c, n := n, g := g, regs := regs, t := s, h := HA, o2 := o], hg, hra, o1l, hs, hag, qd, qin, q3, q4, q5, q6, q8, q9, qb, hr)
  show := rewrite(bA, rewrite(aA, post))
qed

// (an argument list's first: a word)
theorem mp.arg0_bits(regs): regs in abi.ARGS -> ord_le(1, seq_len(regs)) -> regs[0] in bits(64)
proof
  assume ra o1l
  have rl _ := (regs in list_type(bits(64)) && ord_le(seq_len(regs), 6) by simp(ra))
  have lo: seq_len(regs) in omega by simp(rl)
  have l1: int_le(1, seq_len(regs)) proof
    have c1: 1 in seq_len(regs) -> int_le(1, seq_len(regs)) proof
      assume m
      show by arith(apply(nat_mem_lt[k := seq_len(regs), i := 1], lo, m))
    qed
    have c2: 1 = seq_len(regs) -> int_le(1, seq_len(regs)) proof
      assume e
      show by arith(e)
    qed
    show by taut(expand(o1l, ord_le), c1, c2)
  qed
  show := apply(at_type[l := regs, t := bits(64), i := 0], rl, simp(), (int_lt(0, seq_len(regs)) by arith(l1)))
qed

// The `free` symbol's code over nontrivial_free's known up to n, from the
// world w with the layer's ghost part h (n at least the groups in use where
// it frees a live block): it refines the layer's free (but for overflows)
// and diverges only where that is undefined
theorem mp.tf_low_s(c, statics, eo, b, cd, st, regs, w, h, n, nf, k): mp.fr_cfg(c) -> app(eo, empty) = 52 -> mp.nf_known(c, statics, n, nf) ->
  regs in abi.ARGS -> w in abi.World -> w in univ(1) -> h in malloc.Heap.ghost -> abi.thread_ok(w.vm, w.fs_base) ->
  (ord_le(1, seq_len(regs)) && !(regs[0] = 0) && mp.MPRE(c, eo, b, cd, st, union2(w, h)) && !(union2(w, h).blocks[regs[0]] = none) ->
     ex A. A in mallocng.Abs && mallocng.rep(c, A, union2(w, h)) && int_le(seq_len(A.used), n)) -> mp.code_img(c, app(b, empty), app(cd, empty), k) ->
  mp.ref_s(c_src_malloc_free.free_fun(mp.FLF(nf))[regs], abi.wide(malloc.Heap.ghost, mp.UFF(c, eo, b, cd, st))[regs], malloc.Heap.ghost, w, h) &&
  tr.div_low_at(c_src_malloc_free.free_fun(mp.FLF(nf))[regs], abi.wide(malloc.Heap.ghost, mp.UFF(c, eo, b, cd, st))[regs], malloc.Heap.ghost, w, h)
proof
  assume hcf he hk hra hw hwu hh hth hna hci
  have hc _ _ _ _ := hcf
  let S := union2(w, h)
  let LOW := c_src_malloc_free.free_fun(mp.FLF(nf))
  let W := abi.wide(malloc.Heap.ghost, mp.UFF(c, eo, b, cd, st))
  have _ _ onf _ := hk
  have _ lfn := mp(all_elim(mp.fl_free, {c}, {statics}, {n}, {nf}), hcf, hk)
  have lf0 := apply(mp.fl_lf0, onf)
  have ty: LOW in fn_space(abi.ARGS, powerset(univ(1))) by defs(tr.fun_typed, c_src_malloc_free.free_fun)
  // the code's outcome from w: overflow, nothing (p 0) or __libc_free's
  // (a live block), where the layer's free is defined
  have run0: all o. ord_le(1, seq_len(regs)) -> regs[0] = 0 -> runs(LOW[regs], w, o) ->
      abi.ovf_out(w, o) || (ex V r. (V in x86_64_linux.Vm && V = w.vm) && o = ok(fn_update(w, "vm", V), r)) proof
    fix o
    assume o1l r0 hr
    show := apply(mp.fr_post0[g := mp.FLF(nf), regs := regs, t := w, o2 := o], lf0, hra, o1l, r0, hw, hth, hr)
  qed
  have runb: all o. ord_le(1, seq_len(regs)) -> !(regs[0] = 0) -> mp.MPRE(c, eo, b, cd, st, S) -> !(S.blocks[regs[0]] = none) -> runs(LOW[regs], w, o) ->
      ex A. A in mallocng.Abs && mallocng.rep(c, A, S) &&
      (abi.ovf_out(w, o) || (ex V r. (V in x86_64_linux.Vm && mp.lf_res(c, A, h.blocks, regs[0], w, V)) && o = ok(fn_update(w, "vm", V), r))) proof
    fix o
    assume o1l hp0 hpre hbl hr
    obtain A, ha hrep hdep from mp(hna, taut(o1l, hp0, hpre, hbl))
    have post := apply(mp.tf_post[c := c, eo := eo, b := b, cd := cd, st := st, n := n, g := mp.FLF(nf), regs := regs, s := w, h := h, A := A, o := o],
      he, lfn, hra, o1l, hw, hh, hpre, hbl, ha, hrep, hdep, hr)
    show by ex_intro({A}, taut(ha, hrep, post))
  qed
  // refinement
  have rf: mp.ref_s(LOW[regs], W[regs], malloc.Heap.ghost, w, h) proof
    fix o
    assume hr hsh hv
    let GOAL := (ex h2. h2 in malloc.Heap.ghost && runs(W[regs], S, with_ghost(o, h2))) || abi.ovf_out(w, o)
    have pu := apply(mp.fv_univ, ty, hra, hr)
    have ovf: abi.ovf_out(w, o) -> GOAL proof
      assume q
      show by disj({2}, q)
    qed
    have cu: !mp.FPRE(c, eo, b, cd, st, regs, S) -> GOAL proof
      assume hn
      show by disj({1}, apply(mp.tf_undef[c := c, eo := eo, b := b, cd := cd, st := st, regs := regs, s := w, h := h, o := o], hra, hw, hh, pu, hsh, hv, hn))
    qed
    have cz: ord_le(1, seq_len(regs)) && malloc.world_ok(b, cd, st, S) && regs[0] = 0 -> GOAL proof
      assume q
      have o1l wk r0 := q
      have k2: (ex V r. (V in x86_64_linux.Vm && V = w.vm) && o = ok(fn_update(w, "vm", V), r)) -> GOAL proof
        assume e
        obtain V rr, _ ev eo1 from e
        obtain y0 y1, hy0 hy1 er from apply(cart_elim, mp(all_elim(hv, {fn_update(w, "vm", V)}, {rr}), eo1))
        have oe: o = ok(fn_update(w, "vm", w.vm), pair(y0, y1)) := rewrite(ev, rewrite(er, eo1))
        have r := apply(mp.tf_zero[c := c, eo := eo, b := b, cd := cd, st := st, regs := regs, s := w, h := h, y0 := y0, y1 := y1], hra, o1l, r0, hw, hwu, hh, wk, hy0, hy1)
        show by disj({1}, ex_intro({h}, taut(hh, rewrite(sym(oe), r))))
      qed
      show by taut(mp(all_elim(run0, {o}), o1l, r0, hr), ovf, k2)
    qed
    have cb: ord_le(1, seq_len(regs)) && !(regs[0] = 0) && mp.MPRE(c, eo, b, cd, st, S) && !(S.blocks[regs[0]] = none) -> GOAL proof
      assume q
      have o1l hp0 hpre hbl := q
      obtain A, ha hrep post from mp(all_elim(runb, {o}), o1l, hp0, hpre, hbl, hr)
      have k2: (ex V r. (V in x86_64_linux.Vm && mp.lf_res(c, A, h.blocks, regs[0], w, V)) && o = ok(fn_update(w, "vm", V), r)) -> GOAL proof
        assume e
        obtain V rr, hV hres eo1 from e
        obtain y0 y1, hy0 hy1 er from apply(cart_elim, mp(all_elim(hv, {fn_update(w, "vm", V)}, {rr}), eo1))
        have lp: mp.lf_post(c, A, h.blocks, regs[0], w, V) by taut(hres, hp0)
        obtain h2, hh2 r from apply(mp.tf_blk[c := c, eo := eo, b := b, cd := cd, st := st, regs := regs, s := w, h := h, A := A, V := V, y0 := y0, y1 := y1, k := k],
          hc, he, hra, o1l, hw, hwu, hh, hp0, hpre, hbl, ha, hrep, apply(mp.arg0_bits, hra, o1l), hV, hy0, hy1, lp, hci)
        show by disj({1}, ex_intro({h2}, taut(hh2, rewrite(sym(rewrite(er, eo1)), r))))
      qed
      show by taut(post, ovf, k2)
    qed
    show by taut(cu, cz, cb)
  qed
  // divergence: only where undefined
  have dv: tr.div_low_at(LOW[regs], W[regs], malloc.Heap.ghost, w, h) proof
    fix t
    assume hr
    have hu _ _ := mp(all_elim(mp.hg_ok, {h}), hh)
    have Su := mp(union2_univ[u := 1, a := w, b := h], hwu, hu)
    have sg := apply(rec_and_intro, hw, hh)
    have dn: !mp.FPRE(c, eo, b, cd, st, regs, S) proof
      assume q
      have o1l _ alt := q
      have z: regs[0] = 0 -> false proof
        assume r0
        have k1: abi.ovf_out(w, diverge(t)) -> false proof
          assume e
          obtain v ob, _ _ e1 from e
          show by simp(e1)
        qed
        have k2: (ex V r. (V in x86_64_linux.Vm && V = w.vm) && diverge(t) = ok(fn_update(w, "vm", V), r)) -> false proof
          assume e
          obtain V rr, _ _ e1 from e
          show by simp(e1)
        qed
        show by taut(mp(all_elim(run0, {diverge(t)}), o1l, r0, hr), k1, k2)
      qed
      have nz: !(regs[0] = 0) -> false proof
        assume hp0
        have hpre: mp.MPRE(c, eo, b, cd, st, S) by taut(alt, hp0)
        have hbl: !(S.blocks[regs[0]] = none) by taut(alt, hp0)
        obtain A, _ _ post from mp(all_elim(runb, {diverge(t)}), o1l, hp0, hpre, hbl, hr)
        have k1: abi.ovf_out(w, diverge(t)) -> false proof
          assume e
          obtain v ob, _ _ e1 from e
          show by simp(e1)
        qed
        have k2: (ex V r. (V in x86_64_linux.Vm && mp.lf_res(c, A, h.blocks, regs[0], w, V)) && diverge(t) = ok(fn_update(w, "vm", V), r)) -> false proof
          assume e
          obtain V rr, _ _ e1 from e
          show by simp(e1)
        qed
        show by taut(post, k1, k2)
      qed
      show by taut(z, nz)
    qed
    have eu: mp.UB in univ(1) by defs(simp(), exc_val)
    have pu: pair(S, exc(S, mp.UB)) in univ(1) by simp(Su, eu)
    have sh: abi.outcome(exc(S, mp.UB)) by disj({2}, ex_intro({S}, {mp.UB}, refl({exc(S, mp.UB)})))
    have vt: all x v. exc(S, mp.UB) = ok(x, v) -> v in cart(bits(64), bits(64)) proof
      fix x v
      assume e
      show by simp(e)
    qed
    have r := apply(mp.tf_any[c := c, eo := eo, b := b, cd := cd, st := st, regs := regs, S := S, o := exc(S, mp.UB)], hra, pu, sh, vt, dn)
    have ne: !(mp.UB = exc_val("stack_overflow", empty)) by defs(simp(), exc_val)
    have na: !(mp.UB = exc_val("at_main", empty)) by defs(simp(), exc_val)
    show by ex_intro({mp.UB}, {S}, taut(eu, ne, na, sg, r))
  qed
  show by taut(rf, dv)
qed


theorem mp.tf_low(c, statics, eo, b, cd, st, regs, w, h, n, nf, k): mp.fr_cfg(c) -> app(eo, empty) = 52 -> mp.nf_known(c, statics, n, nf) ->
  regs in abi.ARGS -> w in abi.World -> w in univ(1) -> h in malloc.Heap.ghost -> abi.thread_ok(w.vm, w.fs_base) ->
  (ord_le(1, seq_len(regs)) && !(regs[0] = 0) && mp.MPRE(c, eo, b, cd, st, union2(w, h)) && !(union2(w, h).blocks[regs[0]] = none) ->
     ex A. A in mallocng.Abs && mallocng.rep(c, A, union2(w, h)) && int_le(seq_len(A.used), n)) -> mp.code_img(c, app(b, empty), app(cd, empty), k) ->
  abi.refines_ovf_at(c_src_malloc_free.free_fun(mp.FLF(nf))[regs], abi.wide(malloc.Heap.ghost, mp.UFF(c, eo, b, cd, st))[regs], malloc.Heap.ghost, w, h) &&
  tr.div_low_at(c_src_malloc_free.free_fun(mp.FLF(nf))[regs], abi.wide(malloc.Heap.ghost, mp.UFF(c, eo, b, cd, st))[regs], malloc.Heap.ghost, w, h)
proof
  assume hcf he hk hra hw hwu hh hth hna hci
  have rs dv := apply(mp.tf_low_s[c := c, statics := statics, eo := eo, b := b, cd := cd, st := st, regs := regs, w := w, h := h, n := n, nf := nf, k := k],
    hcf, he, hk, hra, hw, hwu, hh, hth, hna, hci)
  show by taut(apply(mp.ref_s_ovf, rs), dv)
qed

// ----------------------------------------------------------------------
//  free end to end

// The `free` symbol's machine code implements the malloc layer's free
// (layers/malloc.sl), its allocator invariant mallocng's, errno at the
// thread pointer's 0x34, the program loaded as C1 has it. Each entry's
// code unrolls free_group <-> nontrivial_free as deep as the groups in use
// there (of an A the state represents).
theorem mp.top_free: all c statics eo b cd st. mp.fr_cfg(c) -> app(eo, empty) = 52 ->
  app(b, empty) = 4198400 -> app(cd, empty) = text.code -> app(st, empty) = statics -> mp.code_img(c, app(b, empty), app(cd, empty), 1) ->
  abi.implements(malloc.Heap.ghost, 4201081, malloc.free_fun(mallocng.inv(c), mallocng.owned(c), eo, b, cd, st))
proof
  fix c statics eo b cd st
  assume hcf he hb hcd hst hci
  let W := abi.wide(malloc.Heap.ghost, mp.UFF(c, eo, b, cd, st))
  have fam: all args w h. args in abi.ARGS -> w in abi.World -> w in univ(1) -> h in malloc.Heap.ghost -> abi.thread_ok(w.vm, w.fs_base) ->
      ex low. tr.implements_at(4201081, low, 4198400, text.code, statics) && abi.refines_ovf_at(low[args], W[args], malloc.Heap.ghost, w, h) &&
        tr.div_low_at(low[args], W[args], malloc.Heap.ghost, w, h) proof
    fix args w h
    assume hA hw hwu hh hth
    let S := union2(w, h)
    let D := ord_le(1, seq_len(args)) && !(args[0] = 0) && mp.MPRE(c, eo, b, cd, st, S) && !(S.blocks[args[0]] = none)
    let NA(n) := D -> ex A. A in mallocng.Abs && mallocng.rep(c, A, S) && int_le(seq_len(A.used), n)
    // the depth: the groups in use of an A the state represents
    have pick: ex n. n in omega && NA(n) proof
      have c1: D -> ex n. n in omega && NA(n) proof
        assume d
        have _ _ hpre _ := d
        have hinv _ _ := hpre
        obtain A, ha hrep from apply(mallocng.inv_rep, hinv)
        have ul: A.used in list_type(omega) by simp(ha)
        have lo: seq_len(A.used) in omega by simp(ul)
        have na: NA(seq_len(A.used)) proof
          assume _
          show by ex_intro({A}, taut(ha, hrep, (int_le(seq_len(A.used), seq_len(A.used)) by arith(lo))))
        qed
        show by ex_intro({seq_len(A.used)}, taut(lo, na))
      qed
      have c2: !D -> ex n. n in omega && NA(n) proof
        assume nd
        have na: NA(0) proof
          assume d
          show by taut(nd, d)
        qed
        show by ex_intro({0}, taut((0 in omega by simp()), na))
      qed
      show by taut(c1, c2)
    qed
    obtain n, hn hna from pick
    obtain nf, hk2 from mp(all_elim(mp(all_elim(mp.fl_all, {c}, {statics}), hcf), {n}), hn)
    let NF := mp.FNF(nf)
    have hnk: mp.nf_known(c, statics, n, NF) by taut(hk2)
    have im _ := mp(all_elim(mp.fl_free, {c}, {statics}, {n}, {NF}), hcf, hnk)
    have rf dv := apply(mp.tf_low[c := c, statics := statics, eo := eo, b := b, cd := cd, st := st, regs := args, w := w, h := h, n := n, nf := NF, k := 1],
      hcf, he, hnk, hA, hw, hwu, hh, hth, hna, hci)
    show by ex_intro({c_src_malloc_free.free_fun(mp.FLF(NF))}, taut(im, rf, dv))
  qed
  // the program not loaded (or the stack protector's word not writable):
  // the layer's free undefined
  have nl: all args w. args in abi.ARGS -> w in rec_and(abi.World, malloc.Heap.ghost) -> w in univ(1) ->
      !(abi.loaded(w.vm, 4198400, text.code, statics) && abi.canary_ok(w.vm, w.fs_base)) -> abi.spec_raises(rec_and(abi.World, malloc.Heap.ghost), w, W, args) proof
    fix args w
    assume hA hw wu hn
    have hn2 := rewrite(sym(hst), rewrite(sym(hcd), rewrite(sym(hb), hn)))
    have dn: !mp.FPRE(c, eo, b, cd, st, args, w) proof
      assume q
      have _ hwo _ := q
      have _ _ _ cn _ ld _ _ := expand(hwo, malloc.world_ok)
      show by taut(hn2, cn, ld)
    qed
    have eu: mp.UB in univ(1) by defs(simp(), exc_val)
    have pu: pair(w, exc(w, mp.UB)) in univ(1) by simp(wu, eu)
    have sh: abi.outcome(exc(w, mp.UB)) by disj({2}, ex_intro({w}, {mp.UB}, refl({exc(w, mp.UB)})))
    have vt: all x v. exc(w, mp.UB) = ok(x, v) -> v in cart(bits(64), bits(64)) proof
      fix x v
      assume e
      show by simp(e)
    qed
    have r := apply(mp.tf_any[c := c, eo := eo, b := b, cd := cd, st := st, regs := args, S := w, o := exc(w, mp.UB)], hA, pu, sh, vt, dn)
    show := apply(abi.raises_intro_g, {malloc.Heap.ghost}, {w}, {w}, {W}, {args}, {mp.UB}, hw, eu, (!(mp.UB = exc_val("stack_overflow", empty)) by defs(simp(), exc_val)), r)
  qed
  show by defs(apply(abi.bridge_implements_lf, mp.hg_ok, fam, nl), abi.implements)
qed

// free's code at a call (a caller's call rule): where the layer's free is
// defined, an overflow (the ABI's), or a return to the world with its
// memory changed -- the ABI's free from it, joined with h, to that world
// joined with some ghost part
theorem mp.tf_call(c, statics, eo, b, cd, st, regs, w, h, n, nf, k, o): mp.fr_cfg(c) -> app(eo, empty) = 52 -> mp.nf_known(c, statics, n, nf) ->
  regs in abi.ARGS -> w in abi.World -> w in univ(1) -> h in malloc.Heap.ghost -> abi.thread_ok(w.vm, w.fs_base) ->
  (ord_le(1, seq_len(regs)) && !(regs[0] = 0) && mp.MPRE(c, eo, b, cd, st, union2(w, h)) && !(union2(w, h).blocks[regs[0]] = none) ->
     ex A. A in mallocng.Abs && mallocng.rep(c, A, union2(w, h)) && int_le(seq_len(A.used), n)) -> mp.code_img(c, app(b, empty), app(cd, empty), k) ->
  runs(c_src_malloc_free.free_fun(mp.FLF(nf))[regs], w, o) -> ord_le(1, seq_len(regs)) -> malloc.world_ok(b, cd, st, union2(w, h)) ->
  (!(regs[0] = 0) -> mp.MPRE(c, eo, b, cd, st, union2(w, h)) && !(union2(w, h).blocks[regs[0]] = none)) ->
  abi.ovf_out(w, o) ||
  (ex V rr h2. (V in x86_64_linux.Vm && h2 in malloc.Heap.ghost &&
     runs(abi.wide(malloc.Heap.ghost, mp.UFF(c, eo, b, cd, st))[regs], union2(w, h), ok(union2(fn_update(w, "vm", V), h2), pair(0, 0)))) &&
   o = ok(fn_update(w, "vm", V), rr))
proof
  assume hcf he hk hra hw hwu hh hth hna hci hr o1l hwk hpre
  have hc _ _ _ _ := hcf
  let S := union2(w, h)
  let W := abi.wide(malloc.Heap.ghost, mp.UFF(c, eo, b, cd, st))
  let GOAL := abi.ovf_out(w, o) ||
    (ex V rr h2. (V in x86_64_linux.Vm && h2 in malloc.Heap.ghost && runs(W[regs], S, ok(union2(fn_update(w, "vm", V), h2), pair(0, 0)))) &&
     o = ok(fn_update(w, "vm", V), rr))
  have _ _ onf _ := hk
  have _ lfn := mp(all_elim(mp.fl_free, {c}, {statics}, {n}, {nf}), hcf, hk)
  have lf0 := apply(mp.fl_lf0, onf)
  have y0: 0 in bits(64) by simp()
  have k1: abi.ovf_out(w, o) -> GOAL proof
    assume q
    show by disj({1}, q)
  qed
  have cz: regs[0] = 0 -> GOAL proof
    assume r0
    have post := apply(mp.fr_post0[g := mp.FLF(nf), regs := regs, t := w, o2 := o], lf0, hra, o1l, r0, hw, hth, hr)
    have k2: (ex V r. (V in x86_64_linux.Vm && V = w.vm) && o = ok(fn_update(w, "vm", V), r)) -> GOAL proof
      assume e
      obtain V rr, hv ev eo1 from e
      have r := apply(mp.tf_zero[c := c, eo := eo, b := b, cd := cd, st := st, regs := regs, s := w, h := h, y0 := 0, y1 := 0], hra, o1l, r0, hw, hwu, hh, hwk, y0, y0)
      have r2 := rewrite(sym(ev), rewrite(all_elim(abi.wg_ok, {fn_update(w, "vm", w.vm)}, {pair(0, 0)}, {h}), r))
      show by disj({2}, ex_intro({V}, {rr}, {h}, taut(hv, hh, r2, eo1)))
    qed
    show by taut(post, k1, k2)
  qed
  have cb: !(regs[0] = 0) -> GOAL proof
    assume hp0
    have hq := mp(hpre, hp0)
    have hpre2: mp.MPRE(c, eo, b, cd, st, S) by taut(hq)
    have hbl: !(S.blocks[regs[0]] = none) by taut(hq)
    obtain A, ha hrep hdep from mp(hna, taut(o1l, hp0, hpre2, hbl))
    have post := apply(mp.tf_post[c := c, eo := eo, b := b, cd := cd, st := st, n := n, g := mp.FLF(nf), regs := regs, s := w, h := h, A := A, o := o],
      he, lfn, hra, o1l, hw, hh, hpre2, hbl, ha, hrep, hdep, hr)
    have k2: (ex V r. (V in x86_64_linux.Vm && mp.lf_res(c, A, h.blocks, regs[0], w, V)) && o = ok(fn_update(w, "vm", V), r)) -> GOAL proof
      assume e
      obtain V rr, hV hres eo1 from e
      have lp: mp.lf_post(c, A, h.blocks, regs[0], w, V) by taut(hres, hp0)
      obtain h2, hh2 r from apply(mp.tf_blk[c := c, eo := eo, b := b, cd := cd, st := st, regs := regs, s := w, h := h, A := A, V := V, y0 := 0, y1 := 0, k := k],
        hc, he, hra, o1l, hw, hwu, hh, hp0, hpre2, hbl, ha, hrep, apply(mp.arg0_bits, hra, o1l), hV, y0, y0, lp, hci)
      have r2 := rewrite(all_elim(abi.wg_ok, {fn_update(w, "vm", V)}, {pair(0, 0)}, {h2}), r)
      show by disj({2}, ex_intro({V}, {rr}, {h2}, taut(hV, hh2, r2, eo1)))
    qed
    show by taut(post, k1, k2)
  qed
  show by taut(cz, cb)
qed

// ----------------------------------------------------------------------
//  One GIMPLE value of free for every state (a client's callee)

// (the groups in use: at most 2^64 -- their metas sorted, each below 2^64)
theorem mp.used_bound(c, A, vm, b): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_m(c, A, vm, b) ->
  int_le(seq_len(A.used), 18446744073709551616)
proof
  assume hc hu ha hh
  have {H = inv} := expand(hh, mallocng.holds_m)
  have {pt = part} := expand(H, mallocng.holds)
  have {so = sorted, us = used_slots, tk = taken} := expand(pt, mallocng.metas_partition)
  have ul: A.used in list_type(omega) by simp(ha)
  have lo: seq_len(A.used) in omega by simp(ul)
  // (the k-th at least k)
  let P(k) := int_lt(k, seq_len(A.used)) -> int_le(k, A.used[k])
  have b0: P(0) proof
    assume h
    have t := mp(at_type[l := A.used, t := omega, i := 0], ul, (0 in omega by simp()), h)
    show by arith(t)
  qed
  have st: all k. k in omega -> P(k) -> P(int_add(k, 1)) proof
    fix k
    assume hk hp h1
    have s := mp(all_elim(so, {k}), hk, h1)
    have pk := mp(hp, (int_lt(k, seq_len(A.used)) by arith(h1)))
    show by arith(s, pk)
  qed
  have all := mp(nat_ind[p := k. P(k)], b0, st)
  have c1: int_lt(0, seq_len(A.used)) -> int_le(seq_len(A.used), 18446744073709551616) proof
    assume hn
    let K := int_sub(seq_len(A.used), 1)
    have ko: K in omega by arith(hn, lo)
    have kl: int_lt(K, seq_len(A.used)) by arith(lo)
    have ge := mp(mp(all_elim(all, {K}), ko), kl)
    have ms := mp(all_elim(us, {K}), ko, kl)
    have ut: mp.untaken(A, A.used[K]) proof
      fix i
      assume hi hil
      assume e
      have _ nu _ _ _ := mp(all_elim(tk, {i}), hi, hil)
      have iu: mallocng.is_used(A, A.taken[i]) by defs(ex_intro({K}, taut(ko, kl, sym(e))), mallocng.is_used)
      show by taut(nu, iu)
    qed
    have {bd = bound} := apply(mp.slot_meta, hc, hu, ha, hh, ms, ut)
    show by arith(ge, bd)
  qed
  have c0: !int_lt(0, seq_len(A.used)) -> int_le(seq_len(A.used), 18446744073709551616) proof
    assume hn
    show by arith(hn, lo)
  qed
  show by taut(c0, c1)
qed

// free's code at its address: one GIMPLE value (nontrivial_free's and
// free_group's recursion unfolded 2^64 deep, past any state's groups)
// implemented there, refining the layer's free from every state
theorem mp.free_low_all: all c statics eo b cd st. mp.fr_cfg(c) -> app(eo, empty) = 52 -> mp.code_img(c, app(b, empty), app(cd, empty), 1) ->
  ex nf. tr.implements_at(4201081, c_src_malloc_free.free_fun(mp.FLF(nf)), 4198400, text.code, statics) &&
    (all args w h. args in abi.ARGS -> w in abi.World -> w in univ(1) -> h in malloc.Heap.ghost -> abi.thread_ok(w.vm, w.fs_base) ->
       mp.ref_s(c_src_malloc_free.free_fun(mp.FLF(nf))[args], abi.wide(malloc.Heap.ghost, mp.UFF(c, eo, b, cd, st))[args], malloc.Heap.ghost, w, h) &&
       tr.div_low_at(c_src_malloc_free.free_fun(mp.FLF(nf))[args], abi.wide(malloc.Heap.ghost, mp.UFF(c, eo, b, cd, st))[args], malloc.Heap.ghost, w, h) &&
       (all o. runs(c_src_malloc_free.free_fun(mp.FLF(nf))[args], w, o) -> ord_le(1, seq_len(args)) -> malloc.world_ok(b, cd, st, union2(w, h)) ->
          (!(args[0] = 0) -> mp.MPRE(c, eo, b, cd, st, union2(w, h)) && !(union2(w, h).blocks[args[0]] = none)) ->
          abi.ovf_out(w, o) ||
          (ex V rr h2. (V in x86_64_linux.Vm && h2 in malloc.Heap.ghost &&
             runs(abi.wide(malloc.Heap.ghost, mp.UFF(c, eo, b, cd, st))[args], union2(w, h), ok(union2(fn_update(w, "vm", V), h2), pair(0, 0)))) &&
           o = ok(fn_update(w, "vm", V), rr))))
proof
  fix c statics eo b cd st
  assume hcf he hci
  have hc _ _ _ _ := hcf
  let N := 18446744073709551616
  obtain nf0, hk2 from mp(all_elim(mp(all_elim(mp.fl_all, {c}, {statics}), hcf), {N}), (N in omega by simp()))
  let NF := mp.FNF(nf0)
  have hnk: mp.nf_known(c, statics, N, NF) by taut(hk2)
  have im _ := mp(all_elim(mp.fl_free, {c}, {statics}, {N}, {NF}), hcf, hnk)
  have rf: all args w h. args in abi.ARGS -> w in abi.World -> w in univ(1) -> h in malloc.Heap.ghost -> abi.thread_ok(w.vm, w.fs_base) ->
      mp.ref_s(c_src_malloc_free.free_fun(mp.FLF(NF))[args], abi.wide(malloc.Heap.ghost, mp.UFF(c, eo, b, cd, st))[args], malloc.Heap.ghost, w, h) &&
      tr.div_low_at(c_src_malloc_free.free_fun(mp.FLF(NF))[args], abi.wide(malloc.Heap.ghost, mp.UFF(c, eo, b, cd, st))[args], malloc.Heap.ghost, w, h) &&
      (all o. runs(c_src_malloc_free.free_fun(mp.FLF(NF))[args], w, o) -> ord_le(1, seq_len(args)) -> malloc.world_ok(b, cd, st, union2(w, h)) ->
         (!(args[0] = 0) -> mp.MPRE(c, eo, b, cd, st, union2(w, h)) && !(union2(w, h).blocks[args[0]] = none)) ->
         abi.ovf_out(w, o) ||
         (ex V rr h2. (V in x86_64_linux.Vm && h2 in malloc.Heap.ghost &&
            runs(abi.wide(malloc.Heap.ghost, mp.UFF(c, eo, b, cd, st))[args], union2(w, h), ok(union2(fn_update(w, "vm", V), h2), pair(0, 0)))) &&
          o = ok(fn_update(w, "vm", V), rr))) proof
    fix args w h
    assume hA hw hwu hh hth
    let S := union2(w, h)
    // (any state the invariant holds in: its groups within N)
    have na: ord_le(1, seq_len(args)) && !(args[0] = 0) && mp.MPRE(c, eo, b, cd, st, S) && !(S.blocks[args[0]] = none) ->
        ex A. A in mallocng.Abs && mallocng.rep(c, A, S) && int_le(seq_len(A.used), N) proof
      assume d
      have _ _ hpre _ := d
      have hinv _ _ := hpre
      obtain A, ha hrep from apply(mallocng.inv_rep, hinv)
      have {hm = mem} := expand(hrep, mallocng.rep)
      have ub := apply(mp.used_bound, hc, apply(mallocng.abs_univ, ha), ha, hm)
      show by ex_intro({A}, taut(ha, hrep, ub))
    qed
    have rs dv := apply(mp.tf_low_s[c := c, statics := statics, eo := eo, b := b, cd := cd, st := st, regs := args, w := w, h := h, n := N, nf := NF, k := 1],
      hcf, he, hnk, hA, hw, hwu, hh, hth, na, hci)
    have cl: all o. runs(c_src_malloc_free.free_fun(mp.FLF(NF))[args], w, o) -> ord_le(1, seq_len(args)) -> malloc.world_ok(b, cd, st, union2(w, h)) ->
        (!(args[0] = 0) -> mp.MPRE(c, eo, b, cd, st, union2(w, h)) && !(union2(w, h).blocks[args[0]] = none)) ->
        abi.ovf_out(w, o) ||
        (ex V rr h2. (V in x86_64_linux.Vm && h2 in malloc.Heap.ghost &&
           runs(abi.wide(malloc.Heap.ghost, mp.UFF(c, eo, b, cd, st))[args], union2(w, h), ok(union2(fn_update(w, "vm", V), h2), pair(0, 0)))) &&
         o = ok(fn_update(w, "vm", V), rr)) proof
      fix o
      assume hr ol hwk hp
      show := apply(mp.tf_call[c := c, statics := statics, eo := eo, b := b, cd := cd, st := st, regs := args, w := w, h := h, n := N, nf := NF, k := 1, o := o],
        hcf, he, hnk, hA, hw, hwu, hh, hth, na, hci, hr, ol, hwk, hp)
    qed
    show by taut(rs, dv, cl)
  qed
  show by ex_intro({NF}, taut(im, rf))
qed
