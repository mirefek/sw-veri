// The invariant kept by list operations (`mp.lframe`): the lists'
// head words and the metas' links written.

// ----------------------------------------------------------------------
//  The invariant kept by list operations: the lists rewritten (their
//  head words in the context, the metas' links), A2 the same geometry
// (a byte of a region but the context: not the context's)
theorem mp.sep_ctx(c, A, M, b, brk, j, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds(c, A, M, b, brk) ->
  j in omega -> int_lt(0, j) -> int_lt(j, seq_len(mallocng.regions(c, A))) -> mallocng.in_range(a, mallocng.regions(c, A)[j]) ->
  !mallocng.in_range(a, pair(c.ctx, mallocng.CTX_SIZE))
proof
  assume hc hu ha H hj hj0 hjl hr
  have {sep = sep} := expand(H, mallocng.holds)
  let RG := mallocng.regions(c, A)
  have {ed = data} := apply(mp.reg_at[c := c, A := A, i := 0], hc, hu, ha, simp())
  have s := mp(all_elim(expand(sep, mallocng.separate), {j}, {0}), conj(hj, (0 in omega by simp())),
    conj(conj(hjl, (int_lt(0, seq_len(RG)) by arith(hj, hj0, hjl))), (!(j = 0) by arith(hj, hj0))))
  have rn := apply(mp.regions_nat, hc, hu, ha)
  have tk := apply(at_type[l := RG, t := cart(omega, omega), i := j], rn, hj, hjl)
  have t0 := apply(at_type[l := RG, t := cart(omega, omega), i := 0], rn, simp(), arith(hj, hj0, hjl))
  have o := apply(mp.apart_not, tk, t0, s, hr)
  have e0 _ _ := mp.data_at[c := c]
  show := rewrite(e0, rewrite(mp(ed, (int_lt(0, 3) by simp())), o))
qed

// a byte of the lock, libc, the image's constants, the reserve or a group:
// not the context's
theorem mp.not_ctx(c, A, M, b, brk, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds(c, A, M, b, brk) -> a in omega ->
  ((((ex i. i in omega && (int_lt(0, i) && int_lt(i, 3)) && mallocng.in_range(a, mallocng.data_ranges(c)[i])) ||
    (ex i. i in omega && int_lt(i, x86_64_linux.phnum(c.file)) && mallocng.in_range(a, mallocng.ro_ranges(c.file)[i]))) ||
    mallocng.in_range(a, pair(A.reserve, int_mul(4096, A.reserve_cnt)))) ||
    (ex h. mallocng.is_used(A, h) && mallocng.in_range(a, mallocng.group_range(A.metas[h])))) ->
  !mallocng.in_range(a, pair(c.ctx, mallocng.CTX_SIZE))
proof
  assume hc hu ha H hao hr
  have {ap = apart} := expand(H, mallocng.holds)
  let FL := c.file
  let PN := x86_64_linux.phnum(FL)
  have fs: FL in seq_type(bits(8)) by simp(hc)
  have pn: PN in omega by defs(mp(x86.le_at_nat[f := FL, off := 56, n := 2], fs, simp()), x86_64_linux.phnum)
  have rl: A.areas in list_type(omega) by simp(ha)
  have lo: seq_len(A.areas) in omega by arith(rl)
  have {rres = reserve, rlen = len} := apply(mp.reg_at[c := c, A := A, i := 0], hc, hu, ha, simp())
  have c1: (ex i. i in omega && (int_lt(0, i) && int_lt(i, 3)) && mallocng.in_range(a, mallocng.data_ranges(c)[i])) ->
      !mallocng.in_range(a, pair(c.ctx, mallocng.CTX_SIZE)) proof
    assume e
    obtain i, hi hq hir from e
    have hi0 hi3 := hq
    have {ed = data} := apply(mp.reg_at[c := c, A := A, i := i], hc, hu, ha, hi)
    show := apply(mp.sep_ctx[c := c, A := A, M := M, b := b, brk := brk, j := i, a := a], hc, hu, ha, H, hi, hi0, arith(rlen, hi3, pn, lo), rewrite(sym(mp(ed, hi3)), hir))
  qed
  have c2: (ex i. i in omega && int_lt(i, PN) && mallocng.in_range(a, mallocng.ro_ranges(FL)[i])) ->
      !mallocng.in_range(a, pair(c.ctx, mallocng.CTX_SIZE)) proof
    assume e
    obtain i, hi hil hir from e
    have {er = ro} := apply(mp.reg_at[c := c, A := A, i := i], hc, hu, ha, hi)
    show := apply(mp.sep_ctx[c := c, A := A, M := M, b := b, brk := brk, j := int_add(3, i), a := a], hc, hu, ha, H, simp(hi), arith(hi),
      arith(rlen, hil, pn, hi, lo), rewrite(sym(mp(er, hil)), hir))
  qed
  have c3: mallocng.in_range(a, pair(A.reserve, int_mul(4096, A.reserve_cnt))) -> !mallocng.in_range(a, pair(c.ctx, mallocng.CTX_SIZE)) proof
    assume hir
    show := apply(mp.sep_ctx[c := c, A := A, M := M, b := b, brk := brk, j := int_add(int_add(3, PN), seq_len(A.areas)), a := a], hc, hu, ha, H,
      arith(pn, lo), arith(pn, lo), arith(rlen, pn, lo), rewrite(sym(rres), hir))
  qed
  have c4: (ex h. mallocng.is_used(A, h) && mallocng.in_range(a, mallocng.group_range(A.metas[h]))) -> !mallocng.in_range(a, pair(c.ctx, mallocng.CTX_SIZE)) proof
    assume e
    obtain h, hh hir from e
    obtain k, hk hkl hke from expand(hh, mallocng.is_used)
    have na := mp(all_elim(expand(ap, mallocng.groups_apart), {k}, {a}), conj(hk, hao), conj(hkl, rewrite(sym(hke), hir)))
    have n: mallocng.in_range(a, pair(c.ctx, mallocng.CTX_SIZE)) -> false proof
      assume hin
      have cf := apply(mp.ctx_front[c := c, A := A, a := a], hc, hu, ha, hin)
      have fi := apply(mp.fixed_in[c := c, A := A, a := a], hc, hu, ha, taut(cf))
      show by taut(fi, na)
    qed
    show by taut(n)
  qed
  show by taut(hr, c1, c2, c3, c4)
qed

// the bytes a list operation may write: the lists' head words in the
// context (the free metas', the active lists'), the metas' links
def mp.lbyte(c, A, a) := ((int_le(int_add(c.ctx, 16), a) && int_lt(a, int_add(c.ctx, 24))) ||
  (int_le(int_add(c.ctx, 80), a) && int_lt(a, int_add(c.ctx, 464)))) ||
  (ex l. mallocng.meta_slot(A, l) && (int_le(l, a) && int_lt(a, int_add(l, 16))))

// the frame: A2 of the same geometry and masks, the view M2 from M in
// those bytes only (the pages the same)
abbrev mp.lframe(c, A, A2, M, M2, b, brk) := cfg: c in mallocng.Cfg && univ: A in univ(1) && abs: A in mallocng.Abs && abs2: A2 in mallocng.Abs &&
  blocks: b in fn_space(bits(64), option(omega)) && holds: mallocng.holds(c, A, M, b, brk) && geom: mp.geom(A, A2) &&
  masks: (all x. x in omega -> avail: A2.metas[x].avail = A.metas[x].avail &&
     freed: A2.metas[x].freed = A.metas[x].freed) &&
  bytes: (all a. a in omega -> !mp.lbyte(c, A, a) -> M2[a] = M[a]) &&
  pages: (all a. a in omega -> mallocng.pg(M2, a) = mallocng.pg(M, a))

// a byte outside the context and every meta area's page: as before
theorem mp.lf_far(c, A, A2, M, M2, b, brk, a): mp.lframe(c, A, A2, M, M2, b, brk) -> a in omega ->
  !mallocng.in_range(a, pair(c.ctx, mallocng.CTX_SIZE)) ->
  (all k. k in omega -> int_lt(k, seq_len(A.areas)) -> !(int_le(A.areas[k], a) && int_lt(a, int_add(A.areas[k], 4096)))) ->
  M2[a] = M[a]
proof
  assume F hao hnc hn
  have {ha = abs, agw = bytes} := F
  have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  have h2: !(int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE))) by simp(expand(hnc, mallocng.in_range))
  have nc: !(int_le(int_add(c.ctx, 16), a) && int_lt(a, int_add(c.ctx, 24))) && !(int_le(int_add(c.ctx, 80), a) && int_lt(a, int_add(c.ctx, 464)))
    by arith(h2, ks)
  have nm: !(ex l. mallocng.meta_slot(A, l) && (int_le(l, a) && int_lt(a, int_add(l, 16)))) proof
    assume e
    obtain l, hl hin from e
    have {lex = area} := apply(mp.meta_page, ha, hl)
    obtain k, hk hkl l1 l2 _ from lex
    have i1 i2 := hin
    show by taut(mp(all_elim(hn, {k}), hk, hkl), (int_le(A.areas[k], a) && int_lt(a, int_add(A.areas[k], 4096)) by arith(l1, l2, i1, i2)))
  qed
  have nl: !mp.lbyte(c, A, a) by defs(taut(nc, nm), mp.lbyte)
  show := mp(all_elim(agw, {a}), hao, nl)
qed

// (a byte of the lock, libc, the image's constants, the reserve or a group: as before)
theorem mp.lf_region(c, A, A2, M, M2, b, brk, a): mp.lframe(c, A, A2, M, M2, b, brk) -> a in omega ->
  ((((ex i. i in omega && (int_lt(0, i) && int_lt(i, 3)) && mallocng.in_range(a, mallocng.data_ranges(c)[i])) ||
    (ex i. i in omega && int_lt(i, x86_64_linux.phnum(c.file)) && mallocng.in_range(a, mallocng.ro_ranges(c.file)[i]))) ||
    mallocng.in_range(a, pair(A.reserve, int_mul(4096, A.reserve_cnt)))) ||
    (ex h. mallocng.is_used(A, h) && mallocng.in_range(a, mallocng.group_range(A.metas[h])))) ->
  M2[a] = M[a]
proof
  assume F hao hr
  have {hc = cfg, hu = univ, ha = abs, H = holds} := F
  have nc := apply(mp.not_ctx[c := c, A := A, M := M, b := b, brk := brk, a := a], hc, hu, ha, H, hao, hr)
  have dd: (ex i. i in omega && (int_lt(0, i) && int_lt(i, 3)) && mallocng.in_range(a, mallocng.data_ranges(c)[i])) ->
      (ex i. i in omega && int_lt(i, 3) && mallocng.in_range(a, mallocng.data_ranges(c)[i])) proof
    assume e
    obtain i, hi hq hir from e
    have _ hi3 := hq
    show by ex_intro({i}, taut(hi, hi3, hir))
  qed
  have na := apply(mp.noarea[c := c, A := A, M := M, b := b, brk := brk, a := a], hc, hu, ha, H, hao, taut(hr, dd))
  show := apply(mp.lf_far[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, a := a], F, hao, nc, na)
qed

// (a byte of the context but the lists' head words: as before)
theorem mp.lf_ctxb(c, A, A2, M, M2, b, brk, a): mp.lframe(c, A, A2, M, M2, b, brk) -> a in omega ->
  int_le(c.ctx, a) -> int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE)) ->
  !(int_le(int_add(c.ctx, 16), a) && int_lt(a, int_add(c.ctx, 24))) -> !(int_le(int_add(c.ctx, 80), a) && int_lt(a, int_add(c.ctx, 464))) ->
  M2[a] = M[a]
proof
  assume F hao h1 h2 n1 n2
  have {hc = cfg, hu = univ, ha = abs, H = holds, agw = bytes} := F
  have hin: mallocng.in_range(a, pair(c.ctx, mallocng.CTX_SIZE)) by defs(simp(h1, h2), mallocng.in_range)
  have hn := apply(mp.ctx_noarea[c := c, A := A, M := M, b := b, brk := brk, a := a], hc, hu, ha, H, hao, hin)
  have nm: !(ex l. mallocng.meta_slot(A, l) && (int_le(l, a) && int_lt(a, int_add(l, 16)))) proof
    assume e
    obtain l, hl hil from e
    have {lex = area} := apply(mp.meta_page, ha, hl)
    obtain k, hk hkl l1 l2 _ from lex
    have i1 i2 := hil
    show by taut(mp(all_elim(hn, {k}), hk, hkl), (int_le(A.areas[k], a) && int_lt(a, int_add(A.areas[k], 4096)) by arith(l1, l2, i1, i2)))
  qed
  have nl: !mp.lbyte(c, A, a) by defs(taut(n1, n2, nm), mp.lbyte)
  show := mp(all_elim(agw, {a}), hao, nl)
qed

// (the context's words but the lists' head words: as before)
theorem mp.lf_cw(c, A, A2, M, M2, b, brk, off, n): mp.lframe(c, A, A2, M, M2, b, brk) -> off in omega -> n in omega ->
  int_le(int_add(off, n), mallocng.CTX_SIZE) -> (int_le(int_add(off, n), 16) || (int_le(24, off) && int_le(int_add(off, n), 80)) || int_le(464, off)) ->
  mallocng.rd(M2, int_add(c.ctx, off), n) = mallocng.rd(M, int_add(c.ctx, off), n)
proof
  assume F ho hn hl hw
  have {hc = cfg} := F
  have co: c.ctx in omega by simp(hc)
  have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  have ai: all j. j in omega -> int_lt(j, n) -> M2[int_add(int_add(c.ctx, off), j)] = M[int_add(int_add(c.ctx, off), j)] proof
    fix j
    assume hj hjl
    show := apply(mp.lf_ctxb[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, a := int_add(int_add(c.ctx, off), j)], F,
      simp(co, ho, hj), arith(co, ho, hj), arith(co, ho, hj, hjl, hl), arith(hw, hj, hjl, ho, co), arith(hw, hj, hjl, ho, co))
  qed
  show := apply(mp.agree_rd, hn, ai)
qed

// (a byte of a meta area's header: as before -- the metas past it)
theorem mp.lf_hdr(c, A, A2, M, M2, b, brk, k, a): mp.lframe(c, A, A2, M, M2, b, brk) -> k in omega -> int_lt(k, seq_len(A.areas)) -> a in omega ->
  int_le(A.areas[k], a) -> int_lt(a, int_add(A.areas[k], 24)) -> M2[a] = M[a]
proof
  assume F hk hkl hao h1 h2
  have {hc = cfg, hu = univ, ha = abs, H = holds, agw = bytes} := F
  have rl: A.areas in list_type(omega) by simp(ha)
  have ako := mp(at_type[l := A.areas, t := omega, i := k], rl, hk, hkl)
  have {d = data, ar = areas} := apply(mp.area_apart[c := c, A := A, M := M, b := b, brk := brk, k := k, a := a], hc, hu, ha, H, hk, hkl, hao, h1, arith(h2, ako, hao))
  have e0 _ _ := mp.data_at[c := c]
  have nc0 := rewrite(e0, mp(all_elim(d, {0}), simp(), simp()))
  have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  have h3: !(int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE))) by simp(expand(nc0, mallocng.in_range))
  have nc: !(int_le(int_add(c.ctx, 16), a) && int_lt(a, int_add(c.ctx, 24))) && !(int_le(int_add(c.ctx, 80), a) && int_lt(a, int_add(c.ctx, 464)))
    by arith(h3, ks)
  have nm: !(ex l. mallocng.meta_slot(A, l) && (int_le(l, a) && int_lt(a, int_add(l, 16)))) proof
    assume e
    obtain l, hl hil from e
    have {lex = area} := apply(mp.meta_page, ha, hl)
    obtain k2, hk2 hk2l l1 l2 _ from lex
    have i1 i2 := hil
    have same: k2 = k -> false proof
      assume ek
      have l1e := rewrite(ek, l1)
      show by arith(l1e, i1, h2)
    qed
    have diff: !(k2 = k) -> false proof
      assume ne
      have o := mp(all_elim(ar, {k2}), hk2, hk2l, ne)
      show by taut(o, (int_le(A.areas[k2], a) && int_lt(a, int_add(A.areas[k2], 4096)) by arith(l1, l2, i1, i2)))
    qed
    show by taut(same, diff)
  qed
  have nl: !mp.lbyte(c, A, a) by defs(taut(nc, nm), mp.lbyte)
  show := mp(all_elim(agw, {a}), hao, nl)
qed

// (a meta's bytes past its links: as before)
theorem mp.lf_meta(c, A, A2, M, M2, b, brk, l, a): mp.lframe(c, A, A2, M, M2, b, brk) -> mallocng.meta_slot(A, l) -> a in omega ->
  int_le(int_add(l, 16), a) -> int_lt(a, int_add(l, 40)) -> M2[a] = M[a]
proof
  assume F hl hao h1 h2
  have {hc = cfg, hu = univ, ha = abs, H = holds, agw = bytes} := F
  have {lo = nat, lex = area} := apply(mp.meta_page, ha, hl)
  obtain k, hk hkl l1 l2 _ from lex
  have inp: int_le(A.areas[k], a) && int_lt(a, int_add(A.areas[k], 4096)) by arith(l1, l2, h1, h2, lo)
  have {d = data} := apply(mp.area_apart[c := c, A := A, M := M, b := b, brk := brk, k := k, a := a], hc, hu, ha, H, hk, hkl, hao, taut(inp), taut(inp))
  have e0 _ _ := mp.data_at[c := c]
  have nc0 := rewrite(e0, mp(all_elim(d, {0}), simp(), simp()))
  have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  have h3: !(int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE))) by simp(expand(nc0, mallocng.in_range))
  have nc: !(int_le(int_add(c.ctx, 16), a) && int_lt(a, int_add(c.ctx, 24))) && !(int_le(int_add(c.ctx, 80), a) && int_lt(a, int_add(c.ctx, 464)))
    by arith(h3, ks)
  have nm: !(ex l2. mallocng.meta_slot(A, l2) && (int_le(l2, a) && int_lt(a, int_add(l2, 16)))) proof
    assume e
    obtain l2, hl2 hil from e
    have i1 i2 := hil
    have same: l2 = l -> false proof
      assume el
      show by arith(rewrite(el, i2), h1)
    qed
    have diff: !(l2 = l) -> false proof
      assume ne
      have dj := apply(mp.meta_disj[c := c, A := A, M := M, b := b, brk := brk, g := l2, l := l, a := a], hc, hu, ha, H, hl2, hl, (!(l = l2) by taut(ne)), hao, arith(h1, lo), h2)
      show by arith(dj, i1, i2, lo, h1)
    qed
    show by taut(same, diff)
  qed
  have nl: !mp.lbyte(c, A, a) by defs(taut(nc, nm), mp.lbyte)
  show := mp(all_elim(agw, {a}), hao, nl)
qed

// the image intact: its bytes and pages no link bytes
theorem mp.lf_image(c, A, A2, M, M2, b, brk): mp.lframe(c, A, A2, M, M2, b, brk) -> mallocng.image_ok(c, M2)
proof
  assume F
  have {hc = cfg, H = holds} := F
  have {himg = image} := expand(H, mallocng.holds)
  have i1 i2 i3 := expand(himg, mallocng.image_ok)
  let FL := c.file
  have fs: FL in seq_type(bits(8)) by simp(hc)
  have pn: x86_64_linux.phnum(FL) in omega by defs(mp(x86.le_at_nat[f := FL, off := 56, n := 2], fs, simp()), x86_64_linux.phnum)
  have cl1 cl2 cl3 := (c.ctx in omega && c.lock in omega && c.libc in omega by simp(hc))
  have d0 d1 d2 := apply(mp.data_at[c := c])
  // the read-only segments
  have ro2: all x0. x0 in omega -> int_lt(x0, x86_64_linux.phnum(FL)) && x86_64_linux.is_load(FL, x0) -> mallocng.ro_segment_ok(FL, x0, x86_64_linux.segment(FL, x0), M2) proof
    fix i
    assume hi hq
    let SG := x86_64_linux.segment(FL, i)
    have rs := mp(all_elim(i1, {i}), hi, hq)
    have hil hld := hq
    have r: !bit(SG.flags, 1) ->
        (all x0. x0 in omega -> int_le(SG.vaddr, x0) && int_lt(x0, int_add(SG.vaddr, SG.memsz)) ->
           mallocng.b8(M2, x0) = ite(int_lt(x0, int_add(SG.vaddr, SG.filesz)), FL[int_add(SG.offset, int_sub(x0, SG.vaddr))], 0)) &&
        (all x0. x0 in omega -> (int_le(SG.vaddr, x0) && int_lt(x0, int_add(SG.vaddr, SG.memsz))) && x86_64_linux.last_on_page(FL, i, int_div(x0, x86_64_linux.PAGE)) ->
           mallocng.pg(M2, x0) = some(fn_update(fn_update(empty, "prot", x86_64_linux.seg_prot(SG)), "kind", 0))) proof
      assume hw
      have b1 b2 := mp(expand(rs, mallocng.ro_segment_ok), hw)
      have iin := mp(nat_lt_mem[k := i, n := int_sub(x86_64_linux.phnum(FL), 0)], hi, arith(pn), arith(hil, pn, hi))
      have ab := mp(app_fn_build[d := int_sub(x86_64_linux.phnum(FL), 0), v := x0. ite(x86_64_linux.is_load(FL, int_add(0, x0)) && !bit(x86_64_linux.segment(FL, int_add(0, x0)).flags, 1),
        pair(x86_64_linux.segment(FL, int_add(0, x0)).vaddr, x86_64_linux.segment(FL, int_add(0, x0)).memsz), pair(0, 0)), a := i], iin)
      have ri: mallocng.ro_ranges(FL)[i] = pair(SG.vaddr, SG.memsz) by defs(simp(ab, (int_add(0, i) = i by arith(hi)), hld, hw), mallocng.ro_ranges)
      have ag: all x0. x0 in omega -> int_le(SG.vaddr, x0) && int_lt(x0, int_add(SG.vaddr, SG.memsz)) -> M2[x0] = M[x0] proof
        fix x
        assume hx hxr
        have inr: mallocng.in_range(x, mallocng.ro_ranges(FL)[i]) by defs(simp(ri, hxr), mallocng.in_range)
        have ex: ex j. j in omega && int_lt(j, x86_64_linux.phnum(FL)) && mallocng.in_range(x, mallocng.ro_ranges(FL)[j]) by ex_intro({i}, taut(hi, hil, inr))
        show := apply(mp.lf_region[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, a := x], F, hx, taut(ex))
      qed
      have bt: all x0. x0 in omega -> int_le(SG.vaddr, x0) && int_lt(x0, int_add(SG.vaddr, SG.memsz)) ->
          mallocng.b8(M2, x0) = ite(int_lt(x0, int_add(SG.vaddr, SG.filesz)), FL[int_add(SG.offset, int_sub(x0, SG.vaddr))], 0) proof
        fix x
        assume hx hxr
        have {eb = byte} := apply(mp.agree_b8, mp(all_elim(ag, {x}), hx, hxr))
        show := trans(eb, mp(all_elim(b1, {x}), hx, hxr))
      qed
      have pt: all x0. x0 in omega -> (int_le(SG.vaddr, x0) && int_lt(x0, int_add(SG.vaddr, SG.memsz))) && x86_64_linux.last_on_page(FL, i, int_div(x0, x86_64_linux.PAGE)) ->
          mallocng.pg(M2, x0) = some(fn_update(fn_update(empty, "prot", x86_64_linux.seg_prot(SG)), "kind", 0)) proof
        fix x
        assume hx hxr
        have r1 r2 _ := hxr
        have {ep = page} := apply(mp.agree_b8, mp(all_elim(ag, {x}), hx, conj(r1, r2)))
        show := trans(ep, mp(all_elim(b2, {x}), hx, hxr))
      qed
      show by taut(bt, pt)
    qed
    show by defs(r, mallocng.ro_segment_ok)
  qed
  // libc's need-locks byte, the lock word
  have lnl: mallocng.L_NEED_LOCKS = 3 by defs(simp(), mallocng.L_NEED_LOCKS)
  have lr: int_le(c.libc, int_add(c.libc, 3)) && int_lt(int_add(c.libc, 3), int_add(c.libc, 16)) by arith(cl3)
  have lb: mallocng.in_range(int_add(c.libc, mallocng.L_NEED_LOCKS), mallocng.data_ranges(c)[2]) by defs(simp(d2, lnl, lr), mallocng.in_range)
  have lbx: ex i. i in omega && (int_lt(0, i) && int_lt(i, 3)) && mallocng.in_range(int_add(c.libc, mallocng.L_NEED_LOCKS), mallocng.data_ranges(c)[i]) by ex_intro({2}, taut((2 in omega by simp()), (int_lt(0, 2) && int_lt(2, 3) by simp()), lb))
  have el := apply(mp.lf_region[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, a := int_add(c.libc, mallocng.L_NEED_LOCKS)], F, simp(cl3, lnl), taut(lbx))
  have {elb = byte} := apply(mp.agree_b8, el)
  have lk: all i. i in omega -> int_lt(i, 4) -> M2[int_add(c.lock, i)] = M[int_add(c.lock, i)] proof
    fix i
    assume hi hil
    have lr: int_le(c.lock, int_add(c.lock, i)) && int_lt(int_add(c.lock, i), int_add(c.lock, 4)) by arith(cl2, hi, hil)
    have inr: mallocng.in_range(int_add(c.lock, i), mallocng.data_ranges(c)[1]) by defs(simp(d1, lr), mallocng.in_range)
    have ex: ex j. j in omega && (int_lt(0, j) && int_lt(j, 3)) && mallocng.in_range(int_add(c.lock, i), mallocng.data_ranges(c)[j]) by ex_intro({1}, taut((1 in omega by simp()), (int_lt(0, 1) && int_lt(1, 3) by simp()), inr))
    show := apply(mp.lf_region[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, a := int_add(c.lock, i)], F, simp(cl2, hi), taut(ex))
  qed
  have rl := apply(mp.agree_rd[M := M, M2 := M2, a := c.lock, n := 4], simp(), lk)
  show by defs(taut(ro2, rewrite(sym(elb), i2), rewrite(sym(rl), i3)), mallocng.image_ok)
qed

// the class table intact: in the image's constants
theorem mp.lf_classes(c, A, A2, M, M2, b, brk): mp.lframe(c, A, A2, M, M2, b, brk) -> mallocng.classes_ok(c, M2)
proof
  assume F
  have {hc = cfg, H = holds, pgs = pages} := F
  have {hcls = classes} := expand(H, mallocng.holds)
  have k1 k2 k3 := expand(hcls, mallocng.classes_ok)
  obtain i, hi hil hlo hhi from k3
  have so: c.sct in omega by simp(hc)
  let RI := mallocng.ro_ranges(c.file)[i]
  have fs: c.file in seq_type(bits(8)) by simp(hc)
  have rn := apply(mp.ro_nat[f := c.file, i := i], fs, hi, hil)
  have rs rz := apply(mp.cart_nat, rn)
  have tb: all a. a in omega -> int_le(c.sct, a) -> int_lt(a, int_add(c.sct, int_mul(2, 48))) -> M2[a] = M[a] proof
    fix a
    assume hao h1 h2
    have inr: mallocng.in_range(a, RI) by defs(arith(h1, h2, hlo, hhi, rs, rz, so, hao), mallocng.in_range)
    have ex: ex j. j in omega && int_lt(j, x86_64_linux.phnum(c.file)) && mallocng.in_range(a, mallocng.ro_ranges(c.file)[j]) by ex_intro({i}, taut(hi, hil, inr))
    show := apply(mp.lf_region[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, a := a], F, hao, taut(ex))
  qed
  have k1b: all x0. x0 in omega -> int_lt(x0, 48) -> mallocng.rd(M2, int_add(c.sct, int_mul(2, x0)), 2) = mallocng.size_classes[x0] proof
    fix x
    assume hx hxl
    have ai: all j. j in omega -> int_lt(j, 2) -> M2[int_add(int_add(c.sct, int_mul(2, x)), j)] = M[int_add(int_add(c.sct, int_mul(2, x)), j)] proof
      fix j
      assume hj hjl
      show := mp(all_elim(tb, {int_add(int_add(c.sct, int_mul(2, x)), j)}), simp(so, hx, hj), arith(so, hx, hj), arith(so, hx, hxl, hj, hjl))
    qed
    have e := apply(mp.agree_rd[M := M, M2 := M2, a := int_add(c.sct, int_mul(2, x)), n := 2], simp(), ai)
    show := trans(e, mp(all_elim(k1, {x}), hx, hxl))
  qed
  have k2b: all x0. x0 in omega -> int_le(c.sct, x0) && int_lt(x0, int_add(c.sct, int_mul(2, 48))) ->
      (mallocng.m_mapped(M2, x0) && snd(mallocng.pg(M2, x0)).prot.r) && !(snd(mallocng.pg(M2, x0)).kind = 2) proof
    fix x
    assume hx hxr
    have pe := mp(all_elim(pgs, {x}), hx)
    have o := mp(all_elim(k2, {x}), hx, hxr)
    show by defs(simp(pe, o, expand(o, mallocng.m_mapped)), mallocng.m_mapped)
  qed
  show by defs(taut(k1b, k2b, k3), mallocng.classes_ok)
qed

// a_ctz_32's table intact: the same
theorem mp.lf_debruijn(c, A, A2, M, M2, b, brk): mp.lframe(c, A, A2, M, M2, b, brk) -> mallocng.debruijn_ok(c, M2)
proof
  assume F
  have {hc = cfg, H = holds, pgs = pages} := F
  have {hdb = debruijn} := expand(H, mallocng.holds)
  have k1 k2 k3 := expand(hdb, mallocng.debruijn_ok)
  obtain i, hi hil hlo hhi from k3
  have so: c.dbj in omega by simp(hc)
  let RI := mallocng.ro_ranges(c.file)[i]
  have fs: c.file in seq_type(bits(8)) by simp(hc)
  have rn := apply(mp.ro_nat[f := c.file, i := i], fs, hi, hil)
  have rs rz := apply(mp.cart_nat, rn)
  have tb: all a. a in omega -> int_le(c.dbj, a) -> int_lt(a, int_add(c.dbj, 32)) -> M2[a] = M[a] proof
    fix a
    assume hao h1 h2
    have inr: mallocng.in_range(a, RI) by defs(arith(h1, h2, hlo, hhi, rs, rz, so, hao), mallocng.in_range)
    have ex: ex j. j in omega && int_lt(j, x86_64_linux.phnum(c.file)) && mallocng.in_range(a, mallocng.ro_ranges(c.file)[j]) by ex_intro({i}, taut(hi, hil, inr))
    show := apply(mp.lf_region[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, a := a], F, hao, taut(ex))
  qed
  have k1b: all x0. x0 in omega -> int_lt(x0, 32) -> mallocng.rd(M2, int_add(c.dbj, x0), 1) = mallocng.debruijn32_tab[x0] proof
    fix x
    assume hx hxl
    have ai: all j. j in omega -> int_lt(j, 1) -> M2[int_add(int_add(c.dbj, x), j)] = M[int_add(int_add(c.dbj, x), j)] proof
      fix j
      assume hj hjl
      show := mp(all_elim(tb, {int_add(int_add(c.dbj, x), j)}), simp(so, hx, hj), arith(so, hx, hj), arith(so, hx, hxl, hj, hjl))
    qed
    have e := apply(mp.agree_rd[M := M, M2 := M2, a := int_add(c.dbj, x), n := 1], simp(), ai)
    show := trans(e, mp(all_elim(k1, {x}), hx, hxl))
  qed
  have k2b: all x0. x0 in omega -> int_le(c.dbj, x0) && int_lt(x0, int_add(c.dbj, 32)) ->
      (mallocng.m_mapped(M2, x0) && snd(mallocng.pg(M2, x0)).prot.r) && !(snd(mallocng.pg(M2, x0)).kind = 2) proof
    fix x
    assume hx hxr
    have pe := mp(all_elim(pgs, {x}), hx)
    have o := mp(all_elim(k2, {x}), hx, hxr)
    show by defs(simp(pe, o, expand(o, mallocng.m_mapped)), mallocng.m_mapped)
  qed
  show by defs(taut(k1b, k2b, k3), mallocng.debruijn_ok)
qed

// the meta areas intact: their headers, pages and the reserve's bytes
theorem mp.lf_areas(c, A, A2, M, M2, b, brk): mp.lframe(c, A, A2, M, M2, b, brk) -> mallocng.areas_ok(c, A2, M2)
proof
  assume F
  have {ha = abs, H = holds, hg = geom, pgs = pages} := F
  have {har = areas} := expand(H, mallocng.holds)
  have {ah = head, at = tail, ae = each, ad = distinct, ar = reserve} := expand(har, mallocng.areas_ok)
  have cv: mallocng.C_AREA_HEAD = 56 && mallocng.C_AREA_TAIL = 64 && mallocng.CTX_SIZE = 928 by defs(simp(), mallocng.C_AREA_HEAD, mallocng.C_AREA_TAIL, mallocng.CTX_SIZE)
  have vh vt vs := cv
  have wh: mallocng.ctx_word(c, M2, mallocng.C_AREA_HEAD) = mallocng.ctx_word(c, M, mallocng.C_AREA_HEAD)
    by defs(apply(mp.lf_cw[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, off := mallocng.C_AREA_HEAD, n := 8], F, simp(vh), simp(), arith(vh, vs), arith(vh)), mallocng.ctx_word)
  have wt: mallocng.ctx_word(c, M2, mallocng.C_AREA_TAIL) = mallocng.ctx_word(c, M, mallocng.C_AREA_TAIL)
    by defs(apply(mp.lf_cw[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, off := mallocng.C_AREA_TAIL, n := 8], F, simp(vt), simp(), arith(vt, vs), arith(vt)), mallocng.ctx_word)
  have rl: A.areas in list_type(omega) by simp(ha)
  have ae2: all x0. x0 in omega -> int_lt(x0, seq_len(A.areas)) ->
      ((((((int_mod(A.areas[x0], 4096) = 0 && int_lt(0, A.areas[x0])) && mallocng.rd(M2, A.areas[x0], 8) = A.secret) &&
        mallocng.rd(M2, int_add(A.areas[x0], 8), 8) = ite(int_lt(int_add(x0, 1), seq_len(A.areas)), A.areas[int_add(x0, 1)], 0)) &&
        mallocng.rd(M2, int_add(A.areas[x0], 16), 4) = mallocng.NSLOTS) &&
        (all x1. x1 in omega -> (int_le(A.areas[x0], x1) && int_lt(x1, int_add(A.areas[x0], 4096))) && !mallocng.in_taken(A, x1) -> mallocng.m_rw(M2, x1) && !(snd(mallocng.pg(M2, x1)).kind = 2)))) proof
    fix k
    assume hk hkl
    have e1 e2 e3 e4 e5 e6 := mp(all_elim(ae, {k}), hk, hkl)
    have ako := mp(at_type[l := A.areas, t := omega, i := k], rl, hk, hkl)
    have hb: all o. all n. o in omega -> n in omega -> int_le(int_add(o, n), 24) ->
        mallocng.rd(M2, int_add(A.areas[k], o), n) = mallocng.rd(M, int_add(A.areas[k], o), n) proof
      fix o n
      assume ho hn hl
      have ai: all j. j in omega -> int_lt(j, n) -> M2[int_add(int_add(A.areas[k], o), j)] = M[int_add(int_add(A.areas[k], o), j)] proof
        fix j
        assume hj hjl
        show := apply(mp.lf_hdr[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, k := k, a := int_add(int_add(A.areas[k], o), j)],
          F, hk, hkl, simp(ako, ho, hj), arith(ako, ho, hj), arith(ako, ho, hj, hjl, hl))
      qed
      show := apply(mp.agree_rd, hn, ai)
    qed
    have r0 := rewrite((int_add(A.areas[k], 0) = A.areas[k] by arith(ako)), mp(all_elim(hb, {0}, {8}), simp(), simp(), simp()))
    have r8 := mp(all_elim(hb, {8}, {8}), simp(), simp(), simp())
    have r16 := mp(all_elim(hb, {16}, {4}), simp(), simp(), simp())
    have p6: all x1. x1 in omega -> (int_le(A.areas[k], x1) && int_lt(x1, int_add(A.areas[k], 4096))) && !mallocng.in_taken(A, x1) ->
        mallocng.m_rw(M2, x1) && !(snd(mallocng.pg(M2, x1)).kind = 2) proof
      fix x
      assume hx hxr
      have pe := mp(all_elim(pgs, {x}), hx)
      have {rw = rw} := apply(mp.pg_same, pe)
      have o1 o2 := mp(all_elim(e6, {x}), hx, hxr)
      show by taut(rw, o1, rewrite(sym(pe), o2))
    qed
    show by taut(e1, e2, rewrite(sym(r0), e3), rewrite(sym(r8), e4), rewrite(sym(r16), e5), p6)
  qed
  have ar2: all x0. x0 in omega -> int_le(A.reserve, x0) && int_lt(x0, int_add(A.reserve, int_mul(4096, A.reserve_cnt))) ->
      mallocng.m_mapped(M2, x0) && !(snd(mallocng.pg(M2, x0)).kind = 2) && mallocng.b8(M2, x0) = 0 proof
    fix x
    assume hx hxr
    have inr: mallocng.in_range(x, pair(A.reserve, int_mul(4096, A.reserve_cnt))) by defs(simp(hxr), mallocng.in_range)
    have e := apply(mp.lf_region[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, a := x], F, hx, taut(inr))
    have {eb = byte, ep = page} := apply(mp.agree_b8, e)
    have {mm = mapped} := apply(mp.pg_same, ep)
    have o1 ok1 o2 := mp(all_elim(ar, {x}), hx, hxr)
    show by taut(mm, o1, rewrite(sym(ep), ok1), rewrite(sym(eb), o2))
  qed
  have ok: mallocng.areas_ok(c, A, M2) by defs(taut(rewrite(sym(wh), ah), rewrite(sym(wt), at), ae2, ad, ar2), mallocng.areas_ok)
  have {ea = areas} := apply(mp.gm_used[c := c, A := A, A2 := A2, M := M2, x := empty], hg)
  show := rewrite(sym(ea), ok)
qed

// the permissions: as before (the pages the same, the groups' bytes too)
theorem mp.lf_perms(c, A, A2, M, M2, b, brk): mp.lframe(c, A, A2, M, M2, b, brk) -> mallocng.perms_ok(c, A2, M2, b)
proof
  assume F
  have {ha = abs, H = holds, hg = geom, pgs = pages} := F
  have {hp = perms} := expand(H, mallocng.holds)
  have p1 p2 p3 := expand(hp, mallocng.perms_ok)
  have eus := apply(mp.gm_field[A := A, A2 := A2, k := "used"], hg, simp(), simp(), simp())
  have {eax = auxv} := apply(mp.gm_same[c := c, A := A, A2 := A2, b := b, brk := brk], hg)
  have ul: A.used in list_type(omega) by simp(ha)
  // (a page as before: access the same)
  have pq: all x. x in omega -> mallocng.m_rw(M, x) && !(snd(mallocng.pg(M, x)).kind = 2) -> mallocng.m_rw(M2, x) && !(snd(mallocng.pg(M2, x)).kind = 2) proof
    fix x
    assume hx h
    have pe := mp(all_elim(pgs, {x}), hx)
    have {rw = rw} := apply(mp.pg_same, pe)
    have o1 o2 := h
    show by taut(rw, o1, rewrite(sym(pe), o2))
  qed
  have q1: all x0. all x1. x0 in omega && x1 in omega -> ((int_lt(x0, 3) && int_le(fst(mallocng.data_ranges(c)[x0]), x1)) && int_lt(x1, int_add(fst(mallocng.data_ranges(c)[x0]), snd(mallocng.data_ranges(c)[x0])))) && !mallocng.ctx_free(c, x1) ->
      mallocng.m_rw(M2, x1) && !(snd(mallocng.pg(M2, x1)).kind = 2) proof
    fix k x
    assume ho hq
    have hk hx := ho
    show := mp(all_elim(pq, {x}), hx, mp(all_elim(p1, {k}, {x}), ho, hq))
  qed
  have q2: all x0. all x1. x0 in omega && x1 in omega -> (((int_lt(x0, seq_len(A2.used)) && int_le(fst(mallocng.group_range(A2.metas[A2.used[x0]])), x1)) &&
      int_lt(x1, int_add(fst(mallocng.group_range(A2.metas[A2.used[x0]])), snd(mallocng.group_range(A2.metas[A2.used[x0]]))))) &&
      !(x1 in malloc.live_of(b))) && !mallocng.in_reserved(A2, x1) -> mallocng.m_rw(M2, x1) && !(snd(mallocng.pg(M2, x1)).kind = 2) proof
    fix k x
    assume ho hq
    have hk hx := ho
    have hkl0 lo hi nl nr := hq
    have hkl: int_lt(k, seq_len(A.used)) := rewrite(eus, hkl0)
    have uo := apply(at_type[l := A.used, t := omega, i := k], ul, hk, hkl)
    have {gr = range} := apply(mp.gm_geom[A := A, A2 := A2, x := A.used[k]], hg, uo)
    have ir := apply(mp.gm_inres[A := A, A2 := A2, a := x], ha, hg)
    have lo2 := rewrite(gr, rewrite(eus, lo))
    have hi2 := rewrite(gr, rewrite(eus, hi))
    have nr2: !mallocng.in_reserved(A, x) by taut(ir, nr)
    show := mp(all_elim(pq, {x}), hx, mp(all_elim(p2, {k}, {x}), ho, taut(hkl, lo2, hi2, nl, nr2)))
  qed
  have q3: all x0. all x1. x0 in omega && x1 in omega -> (int_lt(x0, seq_len(mallocng.auxv_ranges(A2))) && int_le(fst(mallocng.auxv_ranges(A2)[x0]), x1)) &&
      int_lt(x1, int_add(fst(mallocng.auxv_ranges(A2)[x0]), snd(mallocng.auxv_ranges(A2)[x0]))) -> mallocng.m_mapped(M2, x1) && snd(mallocng.pg(M2, x1)).prot.r proof
    fix k x
    assume ho hq
    have hk hx := ho
    have o1 o2 := mp(all_elim(p3, {k}, {x}), ho, rewrite(eax, hq))
    have pe := mp(all_elim(pgs, {x}), hx)
    have {mm = mapped} := apply(mp.pg_same, pe)
    show by taut(mm, o1, rewrite(sym(pe), o2))
  qed
  show by defs(taut(q1, q2, q3), mallocng.perms_ok)
qed

// the groups apart from the fixed regions: as before
theorem mp.lf_apart(c, A, A2, M, M2, b, brk): mp.lframe(c, A, A2, M, M2, b, brk) -> mallocng.groups_apart(c, A2)
proof
  assume F
  have {ha = abs, H = holds, hg = geom} := F
  have {hap = apart} := expand(H, mallocng.holds)
  have eus := apply(mp.gm_field[A := A, A2 := A2, k := "used"], hg, simp(), simp(), simp())
  have {efr = franges} := apply(mp.gm_same[c := c, A := A, A2 := A2, b := b, brk := brk], hg)
  have ul: A.used in list_type(omega) by simp(ha)
  have r: all x0. all x1. x0 in omega && x1 in omega -> int_lt(x0, seq_len(A2.used)) && mallocng.in_range(x1, mallocng.group_range(A2.metas[A2.used[x0]])) ->
      !mallocng.in_ranges(x1, mallocng.fixed_ranges(c, A2)) proof
    fix k x
    assume ho hq
    have hk hx := ho
    have hkl0 hr := hq
    have hkl: int_lt(k, seq_len(A.used)) := rewrite(eus, hkl0)
    have uo := apply(at_type[l := A.used, t := omega, i := k], ul, hk, hkl)
    have {gr = range} := apply(mp.gm_geom[A := A, A2 := A2, x := A.used[k]], hg, uo)
    have o := mp(all_elim(expand(hap, mallocng.groups_apart), {k}, {x}), ho, taut(hkl, rewrite(gr, rewrite(eus, hr))))
    show := rewrite(sym(efr), o)
  qed
  show by defs(r, mallocng.groups_apart)
qed

// the context: its words as before, its lists as given
theorem mp.lf_ctx(c, A, A2, M, M2, b, brk): mp.lframe(c, A, A2, M, M2, b, brk) ->
  mallocng.cyclic(M2, mallocng.ctx_word(c, M2, mallocng.C_FREE_META), A2.free_metas) -> seq_len(A2.active) = 48 ->
  (all x0. x0 in omega -> int_lt(x0, 48) -> mallocng.cyclic(M2, mallocng.ctx_word(c, M2, int_add(mallocng.C_ACTIVE, int_mul(8, x0))), A2.active[x0])) ->
  mallocng.ctx_ok(c, A2, M2)
proof
  assume F o10 o11 o12
  have {H = holds, hg = geom} := F
  have {hctx = ctx} := expand(H, mallocng.holds)
  have c1 c2 c3 c4 c5 c6 c7 c8 c9 _ _ _ c13 := expand(hctx, mallocng.ctx_ok)
  have cv: (((((((mallocng.C_SECRET = 0 && mallocng.C_INIT_DONE = 8) && mallocng.C_FREE_META = 16) && mallocng.C_AVAIL_META = 24) && mallocng.C_AVAIL_CNT = 32) &&
    mallocng.C_AREA_CNT = 40) && mallocng.C_AVAIL_AREAS = 72) && mallocng.C_ACTIVE = 80) && mallocng.C_BRK = 920 && mallocng.CTX_SIZE = 928
    by defs(simp(), mallocng.C_SECRET, mallocng.C_INIT_DONE, mallocng.C_FREE_META, mallocng.C_AVAIL_META, mallocng.C_AVAIL_CNT, mallocng.C_AREA_CNT,
      mallocng.C_AVAIL_AREAS, mallocng.C_ACTIVE, mallocng.C_BRK, mallocng.CTX_SIZE)
  have v0 v8 v16 v24 v32 v40 v72 v80 v920 vs := cv
  have cw: all off. off in omega -> int_le(int_add(off, 8), mallocng.CTX_SIZE) ->
      (int_le(int_add(off, 8), 16) || (int_le(24, off) && int_le(int_add(off, 8), 80)) || int_le(464, off)) ->
      mallocng.ctx_word(c, M2, off) = mallocng.ctx_word(c, M, off) proof
    fix off
    assume ho hl hw
    show by defs(apply(mp.lf_cw[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, off := off, n := 8], F, ho, simp(), hl, hw), mallocng.ctx_word)
  qed
  have w0 := mp(all_elim(cw, {mallocng.C_SECRET}), simp(v0), arith(v0, vs), arith(v0))
  have w24 := mp(all_elim(cw, {mallocng.C_AVAIL_META}), simp(v24), arith(v24, vs), arith(v24))
  have w32 := mp(all_elim(cw, {mallocng.C_AVAIL_CNT}), simp(v32), arith(v32, vs), arith(v32))
  have w40 := mp(all_elim(cw, {mallocng.C_AREA_CNT}), simp(v40), arith(v40, vs), arith(v40))
  have w72 := mp(all_elim(cw, {mallocng.C_AVAIL_AREAS}), simp(v72), arith(v72, vs), arith(v72))
  have w920 := mp(all_elim(cw, {mallocng.C_BRK}), simp(v920), arith(v920, vs), arith(v920))
  have v48: mallocng.C_META_SHIFT = 48 by defs(refl({48}), mallocng.C_META_SHIFT)
  have w48 := mp(all_elim(cw, {mallocng.C_META_SHIFT}), simp(v48), arith(v48, vs), arith(v48))
  have r4 := apply(mp.lf_cw[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, off := mallocng.C_INIT_DONE, n := 4], F, simp(v8), simp(), arith(v8, vs), arith(v8))
  have es := apply(mp.gm_field[A := A, A2 := A2, k := "secret"], hg, simp(), simp(), simp())
  have ei := apply(mp.gm_field[A := A, A2 := A2, k := "init_done"], hg, simp(), simp(), simp())
  have eav := apply(mp.gm_field[A := A, A2 := A2, k := "avail_cnt"], hg, simp(), simp(), simp())
  have ear := apply(mp.gm_field[A := A, A2 := A2, k := "areas"], hg, simp(), simp(), simp())
  have erc := apply(mp.gm_field[A := A, A2 := A2, k := "reserve_cnt"], hg, simp(), simp(), simp())
  have ere := apply(mp.gm_field[A := A, A2 := A2, k := "reserve"], hg, simp(), simp(), simp())
  have ebk := apply(mp.gm_field[A := A, A2 := A2, k := "brk"], hg, simp(), simp(), simp())
  show by defs(taut(rewrite(sym(es), rewrite(sym(w0), c1)), rewrite(sym(ei), rewrite(sym(r4), c2)), rewrite(sym(ei), c3), rewrite(sym(eav), rewrite(sym(w32), c4)),
    rewrite(sym(eav), c5), rewrite(sym(eav), rewrite(sym(ear), rewrite(sym(w24), c6))), rewrite(sym(erc), rewrite(sym(w40), c7)),
    rewrite(sym(erc), rewrite(sym(ere), rewrite(sym(w72), c8))), rewrite(sym(ebk), rewrite(sym(w920), c9)), o10, o11, o12, rewrite(sym(w48), c13)), mallocng.ctx_ok)
qed

// (a group's masks the same in A2, its geometry too: its masks' conditions)
theorem mp.masks_tr(A, A2, M, h): mp.geom(A, A2) -> h in omega ->
  A2.metas[h].avail = A.metas[h].avail -> A2.metas[h].freed = A.metas[h].freed ->
  mallocng.masks_ok(A, M, h) -> mallocng.masks_ok(A2, M, h)
proof
  assume hg hh eav efr hm
  have esl := apply(mp.gm_field[A := A, A2 := A2, k := "slots"], hg, simp(), simp(), simp())
  have {fm = mem, fl = last, ss = slots} := apply(mp.gm_geom[A := A, A2 := A2, x := h], hg, hh)
  have mk := expand(hm, mallocng.masks_ok)
  have r: all x0. x0 in omega -> int_lt(x0, 32) -> (((mallocng.bit(A2.metas[h].avail, x0) = 1 -> int_le(x0, int_mod(mallocng.b8(M, int_add(A2.metas[h].mem, 8)), 32)) && mallocng.bit(A2.metas[h].freed, x0) = 0) &&
      (int_lt(0, int_add(mallocng.bit(A2.metas[h].avail, x0), mallocng.bit(A2.metas[h].freed, x0))) -> int_le(x0, A2.metas[h].last_idx))) &&
      (int_le(x0, A2.metas[h].last_idx) -> (A2.slots[h][x0] = tag(0, empty) <-> int_lt(0, int_add(mallocng.bit(A2.metas[h].avail, x0), mallocng.bit(A2.metas[h].freed, x0)))) &&
        mallocng.b8(M, int_sub(mallocng.slot_start(A2.metas[h], x0), 4)) = 0)) &&
      (int_lt(int_mod(mallocng.b8(M, int_add(A2.metas[h].mem, 8)), 32), x0) && int_le(x0, A2.metas[h].last_idx) -> mallocng.bit(A2.metas[h].freed, x0) = 1) proof
    fix i
    assume hi hil
    have q := mp(all_elim(mk, {i}), hi, hil)
    have {s1 = start} := all_elim(ss, {i})
    show by simp(q, eav, efr, fm, fl, s1, esl)
  qed
  show by defs(r, mallocng.masks_ok)
qed

// the groups in use: their bytes and meta words past the links as before,
// their links and link conditions as given
theorem mp.lf_used(c, A, A2, M, M2, b, brk): mp.lframe(c, A, A2, M, M2, b, brk) ->
  (all h. mallocng.is_used(A, h) -> mallocng.rd(M2, h, 8) = A2.metas[h].prev && mallocng.rd(M2, int_add(h, 8), 8) = A2.metas[h].next) ->
  (all h. mallocng.is_used(A, h) -> mp.links_ok(A2, h)) ->
  mallocng.used_ok(A2, M2, b)
proof
  assume F hlnk hlok
  have {ha = abs, hb = blocks, H = holds, hg = geom, hmk = masks} := F
  have {huo = used} := expand(H, mallocng.holds)
  have eus := apply(mp.gm_field[A := A, A2 := A2, k := "used"], hg, simp(), simp(), simp())
  have ul: A.used in list_type(omega) by simp(ha)
  have r: all x0. x0 in omega -> int_lt(x0, seq_len(A2.used)) -> mallocng.group_ok(A2, M2, b, A2.used[x0]) proof
    fix k
    assume hk hkl0
    have hkl: int_lt(k, seq_len(A.used)) := rewrite(eus, hkl0)
    let h := A.used[k]
    let V := A.metas[h]
    let V2 := A2.metas[h]
    have ho := apply(at_type[l := A.used, t := omega, i := k], ul, hk, hkl)
    have iu: mallocng.is_used(A, h) by defs(ex_intro({k}, taut(hk, hkl, refl({h}))), mallocng.is_used)
    have gok := apply(mp.used_group, huo, iu)
    have {hm = mim, hmk2 = masks, hbg = big} := expand(gok, mallocng.group_ok)
    // its bytes: as before
    have agh: all a. a in omega -> int_le(V.mem, a) -> int_le(a, mallocng.slot_end(V, V.last_idx)) -> M2[a] = M[a] proof
      fix a
      assume hao h1 h2
      have inr := apply(mp.group_bytes[A := A, M := M, b := b, h := h, a := a], ha, ho, gok, hao, h1, h2)
      have ex: ex hh. mallocng.is_used(A, hh) && mallocng.in_range(a, mallocng.group_range(A.metas[hh])) by ex_intro({h}, taut(iu, inr))
      show := apply(mp.lf_region[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, a := a], F, hao, taut(ex))
    qed
    // its meta words: past the links as before, the links as given
    have hs := apply(mp.used_slot, H, iu)
    have rw: all o. all n. o in omega -> n in omega -> int_le(16, o) -> int_le(int_add(o, n), 40) -> mallocng.rd(M2, int_add(h, o), n) = mallocng.rd(M, int_add(h, o), n) proof
      fix o n
      assume ho2 hn h16 hl
      have ai: all i. i in omega -> int_lt(i, n) -> M2[int_add(int_add(h, o), i)] = M[int_add(int_add(h, o), i)] proof
        fix i
        assume hi hil
        show := apply(mp.lf_meta[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, l := h, a := int_add(int_add(h, o), i)], F, hs, simp(ho, ho2, hi),
          arith(ho, ho2, hi, h16), arith(ho, ho2, hi, hil, hl))
      qed
      show := apply(mp.agree_rd, hn, ai)
    qed
    have r16 := mp(all_elim(rw, {16}, {8}), simp(), simp(), simp(), simp())
    have r24 := mp(all_elim(rw, {24}, {4}), simp(), simp(), simp(), simp())
    have r28 := mp(all_elim(rw, {28}, {4}), simp(), simp(), simp(), simp())
    have r32 := mp(all_elim(rw, {32}, {8}), simp(), simp(), simp(), simp())
    have _ _ m3 m4 m5 m6 m7 m8 m9 := expand(hm, mallocng.meta_in_memory)
    have ln1 ln2 := mp(all_elim(hlnk, {h}), iu)
    have {fm = mem, fp = maplen, fl = last, fs = sclass, ff = freeable} := apply(mp.gm_geom[A := A, A2 := A2, x := h], hg, ho)
    have ea ef := mp(all_elim(hmk, {h}), ho)
    have mim2: mallocng.meta_in_memory(M2, h, V2) by defs(taut(ln1, ln2, rewrite(sym(fm), rewrite(sym(r16), m3)), rewrite(sym(ea), rewrite(sym(r24), m4)),
      rewrite(sym(ef), rewrite(sym(r28), m5)), rewrite(sym(fl), rewrite(sym(ff), rewrite(sym(fs), rewrite(sym(fp), rewrite(sym(r32), m6))))),
      rewrite(sym(fl), m7), rewrite(sym(ff), m8), rewrite(sym(fs), m9)), mallocng.meta_in_memory)
    // its masks: as before
    have vt: V in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A.metas, x := h], simp(ha), ho)
    have vmem: V.mem in omega by simp(vt)
    have vlast: V.last_idx in omega by simp(vt)
    have sn := apply(mp.stride_nat, ha, ho, gok)
    have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
    have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
    have ss: all i. mallocng.slot_start(V, i) = int_add(int_add(V.mem, 16), int_mul(mallocng.stride(V), i)) proof
      fix i
      show by defs(arith(cu), mallocng.slot_start, mallocng.storage)
    qed
    have sel: mallocng.slot_end(V, V.last_idx) = int_sub(int_add(int_add(int_add(V.mem, 16), int_mul(mallocng.stride(V), V.last_idx)), mallocng.stride(V)), 4)
      by defs(simp(all_elim(ss, {V.last_idx}), ci), mallocng.slot_end)
    have ml: int_mul(mallocng.stride(V), V.last_idx) in omega by simp(sn, vlast)
    have {bxb = byte} := apply(mp.agree_b8, mp(all_elim(agh, {int_add(V.mem, 8)}), simp(vmem), arith(vmem), arith(sel, ml, vmem, sn)))
    have es: all i. i in omega -> int_le(i, V.last_idx) ->
        mallocng.b8(M2, int_sub(mallocng.slot_start(V, i), 4)) = mallocng.b8(M, int_sub(mallocng.slot_start(V, i), 4)) proof
      fix i
      assume hi hil
      have mi := mp(all_elim(ms.mul_le, {mallocng.stride(V)}, {i}, {mallocng.stride(V)}, {V.last_idx}), sn, hi, simp(sn), simp(vlast), arith(sn), hil)
      have si := all_elim(ss, {i})
      have mo: int_mul(mallocng.stride(V), i) in omega by simp(sn, hi)
      have a := mp(all_elim(agh, {int_sub(mallocng.slot_start(V, i), 4)}), arith(si, vmem, mo), arith(si, vmem, mo), arith(si, sel, mi, vmem, mo, ml, sn))
      have {ab = byte} := apply(mp.agree_b8, a)
      show := ab
    qed
    have mk := apply(mp.masks_mem[A := A, M := M, M2 := M2, h := h], hmk2, bxb, es)
    have msk2 := apply(mp.masks_tr[A := A, A2 := A2, M := M2, h := h], hg, ho, ea, ef, mk)
    have big2: mallocng.big_ok(A2, h) by defs(rewrite(sym(fs), rewrite(sym(fl), rewrite(sym(fp), rewrite(sym(ea), rewrite(sym(ef), expand(hbg, mallocng.big_ok)))))), mallocng.big_ok)
    have gk := apply(mp.group_tr_ga[A := A, A2 := A2, M := M, M2 := M2, b := b, h := h], ha, hb, ho, hg, huo, gok, agh, mim2, msk2, big2, mp(all_elim(hlok, {h}), iu))
    show := rewrite(sym(eus), gk)
  qed
  show by defs(r, mallocng.used_ok)
qed

// (a group partial on a new list: on the list before, partial before -- its
// header byte as before)
// (a group in use partially active after: so before, its slot size and
// last slot as before -- its header byte not a list operation's)
theorem mp.lf_part1(c, A, A2, M, M2, b, brk, g): mp.lframe(c, A, A2, M, M2, b, brk) -> mallocng.is_used(A, g) -> mallocng.partial(M2, A2, g) ->
  part: mallocng.partial(M, A, g) && stride: mallocng.stride(A2.metas[g]) = mallocng.stride(A.metas[g]) && last: A2.metas[g].last_idx = A.metas[g].last_idx
proof
  assume F iu p2
  have {ha = abs, H = holds, hg = geom} := F
  have {huo = used} := expand(H, mallocng.holds)
  have {ho = nat, hmo = mem} := apply(mp.used_nat, ha, iu)
  have gok := apply(mp.used_group, huo, iu)
  have {gx = hdr} := apply(mp.hdr_bytes, ha, ho, gok)
  have g1 g2 := expand(gx, mp.gb)
  have inr := apply(mp.group_bytes[A := A, M := M, b := b, h := g, a := int_add(A.metas[g].mem, 8)], ha, ho, gok, arith(hmo), g1, g2)
  have ex: ex hh. mallocng.is_used(A, hh) && mallocng.in_range(int_add(A.metas[g].mem, 8), mallocng.group_range(A.metas[hh])) by ex_intro({g}, taut(iu, inr))
  have {eb = byte} := apply(mp.agree_b8, apply(mp.lf_region[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, a := int_add(A.metas[g].mem, 8)], F, arith(hmo), taut(ex)))
  have {em = mem, el = last, es = stride} := apply(mp.gm_geom[A := A, A2 := A2, x := g], hg, ho)
  have q: mallocng.partial(M, A, g) by defs(arith(rewrite(em, rewrite(el, expand(p2, mallocng.partial))), eb), mallocng.partial)
  show by taut(q, es, el)
qed

theorem mp.lf_partial(c, A, A2, M, M2, b, brk): mp.lframe(c, A, A2, M, M2, b, brk) ->
  (all s g. s in omega && g in omega -> int_lt(s, 48) -> mallocng.on_list(A2.active[s], g) -> mallocng.on_list(A.active[s], g)) ->
  mp.partial_kept(A, A2, M, M2)
proof
  assume F sub
  have {H = holds} := F
  have {hac = active} := expand(H, mallocng.holds)
  fix sc g
  assume hn hs ol p2
  have hs0 _ := hn
  have ol1 := mp(all_elim(sub, {sc}, {g}), hn, hs, ol)
  obtain k, hk hkl hke from expand(ol1, mallocng.on_list)
  have iu0 _ _ := mp(all_elim(expand(hac, mallocng.active_ok), {sc}, {k}), taut(hs0, hk), taut(hs, hkl))
  have iu := rewrite(hke, iu0)
  have q es el := apply(mp.lf_part1[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, g := g], F, iu, p2)
  show by taut(ol1, q, es, el)
qed

// The invariant kept by a list operation: the lists given anew (cyclic in
// the context, their metas' links, each group linked exactly when on its
// list, the active lists' conditions), the metas' partition and the
// normal form for A2; the rest as before
theorem mp.holds_links_pr(c, A, A2, M, M2, b, brk): mp.lframe(c, A, A2, M, M2, b, brk) ->
  mallocng.cyclic(M2, mallocng.ctx_word(c, M2, mallocng.C_FREE_META), A2.free_metas) -> seq_len(A2.active) = 48 ->
  (all x0. x0 in omega -> int_lt(x0, 48) -> mallocng.cyclic(M2, mallocng.ctx_word(c, M2, int_add(mallocng.C_ACTIVE, int_mul(8, x0))), A2.active[x0])) ->
  (all h. mallocng.is_used(A, h) -> mallocng.rd(M2, h, 8) = A2.metas[h].prev && mallocng.rd(M2, int_add(h, 8), 8) = A2.metas[h].next) ->
  (all h. mallocng.is_used(A, h) -> mp.links_ok(A2, h)) ->
  mallocng.active_ok(A2) -> mallocng.metas_partition(A2) -> mallocng.normal(A2) -> !(A.init_done = 0) ->
  mallocng.partial_ok(A2, M2) -> mallocng.reuse_ok(A2) ->
  mallocng.holds(c, A2, M2, b, brk)
proof
  assume F o10 o11 o12 hlnk hlok hac hpt hnm nz po ru
  have {ha = abs, H = holds, hg = geom} := F
  have {hin = in_slots, hbrk = brk, hsep = sep, hwf = wf, hfix = fixed} := expand(H, mallocng.holds)
  have {ein = in_slots, ebrk = brk, efx = fixed} := apply(mp.gm_same[c := c, A := A, A2 := A2, b := b, brk := brk], hg)
  have er := apply(mp.gm_regions[c := c, A := A, A2 := A2], ha, hg)
  have im := apply(mp.lf_image[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk], F)
  have cx := apply(mp.lf_ctx[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk], F, o10, o11, o12)
  have ar := apply(mp.lf_areas[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk], F)
  have us := apply(mp.lf_used[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk], F, hlnk, hlok)
  have pm := apply(mp.lf_perms[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk], F)
  have cl := apply(mp.lf_classes[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk], F)
  have db := apply(mp.lf_debruijn[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk], F)
  have gp := apply(mp.lf_apart[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk], F)
  have ei := apply(mp.gm_field[A := A, A2 := A2, k := "init_done"], hg, simp(), simp(), simp())
  have fr: mallocng.fresh_ok(c, A2, M2) by defs(taut(rewrite(sym(ei), nz)), mallocng.fresh_ok)
  show by defs(taut(im, cx, fr, ar, hpt, us, hac, po, ru, rewrite(sym(ein), hin), hnm, rewrite(sym(ebrk), hbrk), pm, rewrite(sym(er), hsep), hwf, cl, db,
    rewrite(sym(efx), hfix), gp), mallocng.holds)
qed
// ... the lists shrunk (a group on one before on it): the active groups'
// conditions kept
theorem mp.holds_links(c, A, A2, M, M2, b, brk): mp.lframe(c, A, A2, M, M2, b, brk) ->
  mallocng.cyclic(M2, mallocng.ctx_word(c, M2, mallocng.C_FREE_META), A2.free_metas) -> seq_len(A2.active) = 48 ->
  (all x0. x0 in omega -> int_lt(x0, 48) -> mallocng.cyclic(M2, mallocng.ctx_word(c, M2, int_add(mallocng.C_ACTIVE, int_mul(8, x0))), A2.active[x0])) ->
  (all h. mallocng.is_used(A, h) -> mallocng.rd(M2, h, 8) = A2.metas[h].prev && mallocng.rd(M2, int_add(h, 8), 8) = A2.metas[h].next) ->
  (all h. mallocng.is_used(A, h) -> mp.links_ok(A2, h)) ->
  mallocng.active_ok(A2) -> mallocng.metas_partition(A2) -> mallocng.normal(A2) -> !(A.init_done = 0) ->
  (all s g. s in omega && g in omega -> int_lt(s, 48) -> mallocng.on_list(A2.active[s], g) -> mallocng.on_list(A.active[s], g)) ->
  mallocng.holds(c, A2, M2, b, brk)
proof
  assume F o10 o11 o12 hlnk hlok hac hpt hnm nz hsub
  have {hg = geom, H = holds} := F
  have {hpo = partial, hru = reuse} := expand(H, mallocng.holds)
  have po := apply(mp.partial_mono[A := A, A2 := A2, M := M, M2 := M2], hpo, apply(mp.lf_partial[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk], F, hsub))
  have ru := apply(mp.reuse_gm[A := A, A2 := A2], hg, hsub, hru)
  show := apply(mp.holds_links_pr[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk], F, o10, o11, o12, hlnk, hlok, hac, hpt, hnm, nz, po, ru)
qed

