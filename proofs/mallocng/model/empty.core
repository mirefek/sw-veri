// The allocator before its first call -- the empty heap at main: the
// abstract state of nothing allocated, libc's auxiliary vector at AT with
// entries L; the invariant from what memory holds then

theorem mp.zero_meta_typed: mallocng.ZERO_META in mallocng.MetaV
proof
  let K := insert("prev", insert("next", insert("mem", insert("avail", insert("freed", insert("last_idx", insert("freeable", insert("sizeclass", insert("maplen", empty)))))))))
  have u: mallocng.ZERO_META in univ(1) by eval()
  let Z1 := fn_update(empty, "prev", 0)
  let Z2 := fn_update(Z1, "next", 0)
  let Z3 := fn_update(Z2, "mem", 0)
  let Z4 := fn_update(Z3, "avail", 0)
  let Z5 := fn_update(Z4, "freed", 0)
  let Z6 := fn_update(Z5, "last_idx", 0)
  let Z7 := fn_update(Z6, "freeable", 0)
  let Z8 := fn_update(Z7, "sizeclass", 0)
  have f1 := mp(fn_update_fun[f := empty, k := "prev", v := 0], dom_empty.1)
  have f2 := mp(fn_update_fun[f := Z1, k := "next", v := 0], f1)
  have f3 := mp(fn_update_fun[f := Z2, k := "mem", v := 0], f2)
  have f4 := mp(fn_update_fun[f := Z3, k := "avail", v := 0], f3)
  have f5 := mp(fn_update_fun[f := Z4, k := "freed", v := 0], f4)
  have f6 := mp(fn_update_fun[f := Z5, k := "last_idx", v := 0], f5)
  have f7 := mp(fn_update_fun[f := Z6, k := "freeable", v := 0], f6)
  have f8 := mp(fn_update_fun[f := Z7, k := "sizeclass", v := 0], f7)
  have f9 := mp(fn_update_fun[f := Z8, k := "maplen", v := 0], f8)
  have f: is_fun(mallocng.ZERO_META) by defs(f9, mallocng.ZERO_META)
  have d1 := mp(dom_update[f := empty, k := "prev", v := 0], dom_empty.1)
  have d2 := mp(dom_update[f := Z1, k := "next", v := 0], f1)
  have d3 := mp(dom_update[f := Z2, k := "mem", v := 0], f2)
  have d4 := mp(dom_update[f := Z3, k := "avail", v := 0], f3)
  have d5 := mp(dom_update[f := Z4, k := "freed", v := 0], f4)
  have d6 := mp(dom_update[f := Z5, k := "last_idx", v := 0], f5)
  have d7 := mp(dom_update[f := Z6, k := "freeable", v := 0], f6)
  have d8 := mp(dom_update[f := Z7, k := "sizeclass", v := 0], f7)
  have d9 := mp(dom_update[f := Z8, k := "maplen", v := 0], f8)
  let KR := insert("maplen", insert("sizeclass", insert("freeable", insert("last_idx", insert("freed", insert("avail", insert("mem", insert("next", insert("prev", empty)))))))))
  have ds: all z. z in KR <-> z in K proof
    fix z
    have l: z in KR -> z in K proof
      assume h
      show by simp(h)
    qed
    have q: z in K -> z in KR proof
      assume h
      show by simp(h)
    qed
    show by taut(l, q)
  qed
  have deq := mp(set_ext[a := KR, b := K], ds)
  have d: dom(mallocng.ZERO_META) = K by defs(simp(d9, d8, d7, d6, d5, d4, d3, d2, d1, dom_empty.2, deq), mallocng.ZERO_META)
  have p: (((((((((is_fun(mallocng.ZERO_META) && dom(mallocng.ZERO_META) = K) && mallocng.ZERO_META.prev in omega) && mallocng.ZERO_META.next in omega) &&
    mallocng.ZERO_META.mem in omega) && mallocng.ZERO_META.avail in omega) && mallocng.ZERO_META.freed in omega) && mallocng.ZERO_META.last_idx in omega) &&
    mallocng.ZERO_META.freeable in omega) && mallocng.ZERO_META.sizeclass in omega) && mallocng.ZERO_META.maplen in omega by simp(f, d, unfold(mallocng.ZERO_META))
  show by defs(apply(rec_type_intro[u := 1, k := K, p := x0. (((((((((is_fun(x0) && dom(x0) = K) && x0.prev in omega) && x0.next in omega) && x0.mem in omega) &&
    x0.avail in omega) && x0.freed in omega) && x0.last_idx in omega) && x0.freeable in omega) && x0.sizeclass in omega) && x0.maplen in omega,
    r := mallocng.ZERO_META], u, f, d, p), mallocng.MetaV)
qed

// (the empty list: of any type)
theorem mp.nil_list(t): empty in list_type(t)
proof
  have vz: all x. x in 0 -> empty in t proof
    fix x
    assume hx
    show by taut(empty_mem[x := x], rewrite(lit_zero, hx))
  qed
  have b0 := apply(build_list[d := 0, v := x. empty, t := t], simp(), vz)
  have e0: fn_build(0, x. empty) = empty proof
    have q: all z. !(z in fn_build(0, x. empty)) proof
      fix z
      assume hz
      obtain x, hx _ from ((ex x0. x0 in 0 && pair(x0, empty) = z) by taut(set_image_def[s := 0, f := x0. pair(x0, empty), y := z], expand(hz, fn_build)))
      show by taut(empty_mem[x := x], rewrite(lit_zero, hx))
    qed
    show := apply(empty_ext, q)
  qed
  show := rewrite(e0, b0)
qed

// the abstract state before the first allocation: nothing allocated, libc's
// auxiliary vector at AT, its entries L
abbrev mp.a0(AT, L) := fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(
  fn_update(fn_update(empty, "secret", 0), "init_done", 0), "auxv_at", AT), "auxv", L), "areas", empty), "avail_cnt", 0), "reserve", 0), "reserve_cnt", 0),
  "free_metas", empty), "used", empty), "metas", fn_build(omega, x. mallocng.ZERO_META)), "active", fn_build(48, x. empty)),
  "slots", fn_build(omega, x. empty)), "brk", 0), "taken", empty)

theorem mp.a0_type(AT, L): AT in omega -> L in list_type(cart(omega, omega)) -> abs: mp.a0(AT, L) in mallocng.Abs && univ: mp.a0(AT, L) in univ(1)
proof
  assume ha hl
  let K := insert("secret", insert("init_done", insert("auxv_at", insert("auxv", insert("areas", insert("avail_cnt", insert("reserve", insert("reserve_cnt",
    insert("free_metas", insert("used", insert("metas", insert("active", insert("slots", insert("brk", insert("taken", empty)))))))))))))))
  let MT := fn_build(omega, x. mallocng.ZERO_META)
  let AC := fn_build(48, x. empty)
  let SL := fn_build(omega, x. empty)
  let R1 := fn_update(empty, "secret", 0)
  let R2 := fn_update(R1, "init_done", 0)
  let R3 := fn_update(R2, "auxv_at", AT)
  let R4 := fn_update(R3, "auxv", L)
  let R5 := fn_update(R4, "areas", empty)
  let R6 := fn_update(R5, "avail_cnt", 0)
  let R7 := fn_update(R6, "reserve", 0)
  let R8 := fn_update(R7, "reserve_cnt", 0)
  let R9 := fn_update(R8, "free_metas", empty)
  let R10 := fn_update(R9, "used", empty)
  let R11 := fn_update(R10, "metas", MT)
  let R12 := fn_update(R11, "active", AC)
  let R13 := fn_update(R12, "slots", SL)
  let R14 := fn_update(R13, "brk", 0)
  let R := fn_update(R14, "taken", empty)
  have f1 := mp(fn_update_fun[f := empty, k := "secret", v := 0], dom_empty.1)
  have f2 := mp(fn_update_fun[f := R1, k := "init_done", v := 0], f1)
  have f3 := mp(fn_update_fun[f := R2, k := "auxv_at", v := AT], f2)
  have f4 := mp(fn_update_fun[f := R3, k := "auxv", v := L], f3)
  have f5 := mp(fn_update_fun[f := R4, k := "areas", v := empty], f4)
  have f6 := mp(fn_update_fun[f := R5, k := "avail_cnt", v := 0], f5)
  have f7 := mp(fn_update_fun[f := R6, k := "reserve", v := 0], f6)
  have f8 := mp(fn_update_fun[f := R7, k := "reserve_cnt", v := 0], f7)
  have f9 := mp(fn_update_fun[f := R8, k := "free_metas", v := empty], f8)
  have f10 := mp(fn_update_fun[f := R9, k := "used", v := empty], f9)
  have f11 := mp(fn_update_fun[f := R10, k := "metas", v := MT], f10)
  have f12 := mp(fn_update_fun[f := R11, k := "active", v := AC], f11)
  have f13 := mp(fn_update_fun[f := R12, k := "slots", v := SL], f12)
  have f14 := mp(fn_update_fun[f := R13, k := "brk", v := 0], f13)
  have rf: is_fun(R) := mp(fn_update_fun[f := R14, k := "taken", v := empty], f14)
  have d1 := mp(dom_update[f := empty, k := "secret", v := 0], dom_empty.1)
  have d2 := mp(dom_update[f := R1, k := "init_done", v := 0], f1)
  have d3 := mp(dom_update[f := R2, k := "auxv_at", v := AT], f2)
  have d4 := mp(dom_update[f := R3, k := "auxv", v := L], f3)
  have d5 := mp(dom_update[f := R4, k := "areas", v := empty], f4)
  have d6 := mp(dom_update[f := R5, k := "avail_cnt", v := 0], f5)
  have d7 := mp(dom_update[f := R6, k := "reserve", v := 0], f6)
  have d8 := mp(dom_update[f := R7, k := "reserve_cnt", v := 0], f7)
  have d9 := mp(dom_update[f := R8, k := "free_metas", v := empty], f8)
  have d10 := mp(dom_update[f := R9, k := "used", v := empty], f9)
  have d11 := mp(dom_update[f := R10, k := "metas", v := MT], f10)
  have d12 := mp(dom_update[f := R11, k := "active", v := AC], f11)
  have d13 := mp(dom_update[f := R12, k := "slots", v := SL], f12)
  have d14 := mp(dom_update[f := R13, k := "brk", v := 0], f13)
  have d15 := mp(dom_update[f := R14, k := "taken", v := empty], f14)
  let KR := insert("taken", insert("brk", insert("slots", insert("active", insert("metas", insert("used", insert("free_metas", insert("reserve_cnt",
    insert("reserve", insert("avail_cnt", insert("areas", insert("auxv", insert("auxv_at", insert("init_done", insert("secret", empty)))))))))))))))
  have ds: all z. z in KR <-> z in K proof
    fix z
    have l: z in KR -> z in K proof
      assume h
      show by simp(h)
    qed
    have q: z in K -> z in KR proof
      assume h
      show by simp(h)
    qed
    show by taut(l, q)
  qed
  have deq := mp(set_ext[a := KR, b := K], ds)
  have rd: dom(R) = K by simp(d15, d14, d13, d12, d11, d10, d9, d8, d7, d6, d5, d4, d3, d2, d1, dom_empty.2, deq)
  // the fields' types
  have zm := mp.zero_meta_typed
  have mtv: all x. x in omega -> mallocng.ZERO_META in mallocng.MetaV proof
    fix x
    assume _
    show := zm
  qed
  have mt: MT in fn_space(omega, mallocng.MetaV) := apply(fn_build_space[d := omega, v := x. mallocng.ZERO_META, b := mallocng.MetaV], mtv)
  have el := mp.nil_list[t := omega]
  have acv: all x. x in 48 -> empty in list_type(omega) proof
    fix x
    assume _
    show := el
  qed
  have ac: AC in list_type(list_type(omega)) := apply(build_list[d := 48, v := x. empty, t := list_type(omega)], simp(), acv)
  have slv: all x. x in omega -> empty in list_type(mallocng.Use) proof
    fix x
    assume _
    show := mp.nil_list[t := mallocng.Use]
  qed
  have sl: SL in fn_space(omega, list_type(mallocng.Use)) := apply(fn_build_space[d := omega, v := x. empty, b := list_type(mallocng.Use)], slv)
  have zu: 0 in univ(1) := mp(mp(univ_trans[u := 1, a := 0, b := omega], omega_univ), (0 in omega by simp()))
  have atu: AT in univ(1) := mp(mp(univ_trans[u := 1, a := AT, b := omega], omega_univ), ha)
  have lcu := apply(mp.list_univ, apply(cart_univ[u := 1, a := omega, b := omega], omega_univ, omega_univ))
  have lu: L in univ(1) := mp(mp(univ_trans[u := 1, a := L, b := list_type(cart(omega, omega))], lcu), hl)
  have eu: empty in univ(1) := mp(mp(univ_trans[u := 1, a := empty, b := list_type(omega)], apply(mp.list_univ, omega_univ)), el)
  have zmu: mallocng.ZERO_META in univ(1) by eval()
  have smu: single(mallocng.ZERO_META) in univ(1) by defs(simp(zmu), single)
  have seu: single(empty) in univ(1) by defs(simp(eu), single)
  have u48: 48 in univ(1) := mp(mp(univ_trans[u := 1, a := 48, b := omega], omega_univ), (48 in omega by simp()))
  have mts := apply(fn_build_space[d := omega, v := x. mallocng.ZERO_META, b := single(mallocng.ZERO_META)], (all x. x in omega -> mallocng.ZERO_META in single(mallocng.ZERO_META)
    by simp(single_intro[a := mallocng.ZERO_META])))
  have acs := apply(fn_build_space[d := 48, v := x. empty, b := single(empty)], (all x. x in 48 -> empty in single(empty) by simp(single_intro[a := empty])))
  have sls := apply(fn_build_space[d := omega, v := x. empty, b := single(empty)], (all x. x in omega -> empty in single(empty) by simp(single_intro[a := empty])))
  have mtu := apply(fn_space_univ[u := 1, a := omega, b := single(mallocng.ZERO_META), f := MT], omega_univ, smu, mts)
  have acu := apply(fn_space_univ[u := 1, a := 48, b := single(empty), f := AC], u48, seu, acs)
  have slu := apply(fn_space_univ[u := 1, a := omega, b := single(empty), f := SL], omega_univ, seu, sls)
  have ru: R in univ(1) by simp(zu, atu, lu, eu, mtu, acu, slu)
  have rp: (((((((((((((((is_fun(R) && dom(R) = K) && R.secret in omega) && R.init_done in omega) && R.auxv_at in omega) && R.auxv in list_type(cart(omega, omega))) &&
    R.areas in list_type(omega)) && R.avail_cnt in omega) && R.reserve in omega) && R.reserve_cnt in omega) && R.free_metas in list_type(omega)) &&
    R.used in list_type(omega)) && R.metas in fn_space(omega, mallocng.MetaV)) && R.active in list_type(list_type(omega))) &&
    R.slots in fn_space(omega, list_type(mallocng.Use))) && R.brk in omega) && R.taken in list_type(omega) by simp(rf, rd, ha, hl, el, mt, ac, sl)
  have ra := apply(rec_type_intro[u := 1, k := K, p := x0. (((((((((((((((is_fun(x0) && dom(x0) = K) && x0.secret in omega) && x0.init_done in omega) &&
    x0.auxv_at in omega) && x0.auxv in list_type(cart(omega, omega))) && x0.areas in list_type(omega)) && x0.avail_cnt in omega) && x0.reserve in omega) &&
    x0.reserve_cnt in omega) && x0.free_metas in list_type(omega)) && x0.used in list_type(omega)) && x0.metas in fn_space(omega, mallocng.MetaV)) &&
    x0.active in list_type(list_type(omega))) && x0.slots in fn_space(omega, list_type(mallocng.Use))) && x0.brk in omega) && x0.taken in list_type(omega),
    r := R], ru, rf, rd, rp)
  show by taut((R in mallocng.Abs by defs(ra, mallocng.Abs)), ru)
qed

// ----------------------------------------------------------------------
//  The empty state's bytes: those of its ranges (no block live, nothing
//  reserved or taken), held but the context's free ones

// (no block: no byte live)
theorem mp.e_nolive(b, a): (all p. p in bits(64) -> b[p] = none) -> !(a in malloc.live_of(b))
proof
  assume hb hl
  have _ e := unsel(expand(hl, malloc.live_of))
  obtain p, hp hn _ from e
  show by taut(hn, mp(all_elim(hb, {p}), hp))
qed

theorem mp.e_held(c, AT, L, b, a): (all p. p in bits(64) -> b[p] = none) -> a in omega ->
  mallocng.in_ranges(a, mallocng.fp_ranges(c, mp.a0(AT, L))) -> !mallocng.ctx_free(c, a) ->
  fp: a in mallocng.footprint(c, mp.a0(AT, L), b) && held: a in mallocng.held(c, mp.a0(AT, L), b)
proof
  assume hb hao hr hnf
  let A := mp.a0(AT, L)
  have nl := apply(mp.e_nolive[b := b, a := a], hb)
  have nr: !mallocng.in_reserved(A, a) proof
    assume h
    obtain g i, _ _ iu _ _ _ from expand(h, mallocng.in_reserved)
    obtain k, hk hkl _ from expand(iu, mallocng.is_used)
    show by arith(hk, (int_lt(k, 0) by simp(hkl)))
  qed
  have nt: !mallocng.in_taken(A, a) proof
    assume h
    obtain k, hk hkl _ _ from expand(h, mallocng.in_taken)
    show by arith(hk, (int_lt(k, 0) by simp(hkl)))
  qed
  have fp: a in mallocng.footprint(c, A, b) by taut(mp.fp_def[c := c, A := A, b := b, a := a], hao, hr, nl, nr, nt)
  show by taut(fp, apply(mp.held_intro, fp, hnf))
qed

// ... seen the same in the invariant's view as in memory's
theorem mp.e_view(c, AT, L, vm, b, a): (all p. p in bits(64) -> b[p] = none) -> a in omega ->
  mallocng.in_ranges(a, mallocng.fp_ranges(c, mp.a0(AT, L))) -> !mallocng.ctx_free(c, a) ->
  mallocng.mview(vm, mallocng.held(c, mp.a0(AT, L), b))[a] = mallocng.mview(vm, mallocng.all_bytes())[a]
proof
  assume hb hao hr hnf
  have {h = held} := apply(mp.e_held[c := c, AT := AT, L := L, b := b, a := a], hb, hao, hr, hnf)
  have ab: a in mallocng.all_bytes() by defs(sel(taut(hao)), mallocng.all_bytes)
  show := apply(mp.view_mem[vm := vm, F1 := mallocng.held(c, mp.a0(AT, L), b), F2 := mallocng.all_bytes(), a := a], hao, taut(h, ab))
qed

// ... a byte of a region: but the context's free ones (the regions apart,
// the context the first)
theorem mp.e_regview(c, AT, L, vm, b, k, a): c in mallocng.Cfg -> AT in omega -> L in list_type(cart(omega, omega)) ->
  (all p. p in bits(64) -> b[p] = none) -> mallocng.separate(mallocng.regions(c, mp.a0(AT, L))) ->
  k in omega -> int_lt(k, seq_len(mallocng.regions(c, mp.a0(AT, L)))) -> !(k = 0) || !mallocng.ctx_free(c, a) -> a in omega ->
  mallocng.in_range(a, mallocng.regions(c, mp.a0(AT, L))[k]) ->
  mallocng.mview(vm, mallocng.held(c, mp.a0(AT, L), b))[a] = mallocng.mview(vm, mallocng.all_bytes())[a]
proof
  assume hc hat hl hb hsep hk hkl hk0 hao hr
  let A := mp.a0(AT, L)
  have {ha = abs, hu = univ} := apply(mp.a0_type, hat, hl)
  have rn := apply(mp.regions_nat, hc, hu, ha)
  have ir: mallocng.in_ranges(a, mallocng.regions(c, A)) by defs(ex_intro({k}, taut(hk, hkl, hr)), mallocng.in_ranges)
  have fr := apply(mp.regions_fp, hc, hu, ha, ir)
  have {rg0 = data} := apply(mp.reg_at[c := c, A := A, i := 0], hc, hu, ha, simp())
  have d0 _ _ := apply(mp.data_at[c := c])
  have r0: mallocng.regions(c, A)[0] = pair(c.ctx, mallocng.CTX_SIZE) := trans(mp(rg0, simp()), d0)
  have nf: !mallocng.ctx_free(c, a) proof
    assume hf
    have nk: !(k = 0) by taut(hk0, hf)
    have l0: int_lt(0, seq_len(mallocng.regions(c, A))) by arith(hkl, hk)
    have ap := mp(all_elim(expand(hsep, mallocng.separate), {k}, {0}), conj(hk, (0 in omega by simp())), taut(hkl, l0, nk))
    have tk := apply(at_type[l := mallocng.regions(c, A), t := cart(omega, omega), i := k], rn, hk, hkl)
    have t0 := apply(at_type[l := mallocng.regions(c, A), t := cart(omega, omega), i := 0], rn, simp(), l0)
    have n0 := apply(mp.apart_not[r := mallocng.regions(c, A)[k], q := mallocng.regions(c, A)[0], a := a], tk, t0, ap, hr)
    have co: c.ctx in omega by simp(hc)
    have w: int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, 928)) by arith(expand(hf, mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK), co)
    have ic: mallocng.in_range(a, mallocng.regions(c, A)[0]) := rewrite(sym(r0), (mallocng.in_range(a, pair(c.ctx, mallocng.CTX_SIZE))
      by defs(simp(w), mallocng.in_range, mallocng.CTX_SIZE)))
    show by taut(n0, ic)
  qed
  show := apply(mp.e_view[c := c, AT := AT, L := L, vm := vm, b := b, a := a], hb, hao, fr, nf)
qed

// ... a byte of the image's read-only segments
theorem mp.e_ro(c, AT, L, vm, b, i, a): c in mallocng.Cfg -> AT in omega -> L in list_type(cart(omega, omega)) ->
  (all p. p in bits(64) -> b[p] = none) -> mallocng.separate(mallocng.regions(c, mp.a0(AT, L))) ->
  i in omega -> int_lt(i, x86_64_linux.phnum(c.file)) -> a in omega -> mallocng.in_range(a, mallocng.ro_ranges(c.file)[i]) ->
  mallocng.mview(vm, mallocng.held(c, mp.a0(AT, L), b))[a] = mallocng.mview(vm, mallocng.all_bytes())[a]
proof
  assume hc hat hl hb hsep hi hil hao hr
  let A := mp.a0(AT, L)
  have {ha = abs, hu = univ} := apply(mp.a0_type, hat, hl)
  have {rro = ro, rlen = len} := apply(mp.reg_at[c := c, A := A, i := i], hc, hu, ha, hi)
  have e := mp(rro, hil)
  have kl: int_lt(int_add(3, i), seq_len(mallocng.regions(c, A))) by arith(rlen, hil, hi, (seq_len(A.areas) = 0 by simp()))
  show := apply(mp.e_regview[c := c, AT := AT, L := L, vm := vm, b := b, k := int_add(3, i), a := a], hc, hat, hl, hb, hsep, arith(hi), kl,
    taut((!(int_add(3, i) = 0) by arith(hi))), hao, rewrite(sym(e), hr))
qed

// ... a byte of the data symbols: the context's not free
theorem mp.e_data(c, AT, L, vm, b, i, a): c in mallocng.Cfg -> AT in omega -> L in list_type(cart(omega, omega)) ->
  (all p. p in bits(64) -> b[p] = none) -> mallocng.separate(mallocng.regions(c, mp.a0(AT, L))) ->
  i in omega -> int_lt(i, 3) -> !(i = 0) || !mallocng.ctx_free(c, a) -> a in omega -> mallocng.in_range(a, mallocng.data_ranges(c)[i]) ->
  mallocng.mview(vm, mallocng.held(c, mp.a0(AT, L), b))[a] = mallocng.mview(vm, mallocng.all_bytes())[a]
proof
  assume hc hat hl hb hsep hi hil hnf hao hr
  let A := mp.a0(AT, L)
  have {ha = abs, hu = univ} := apply(mp.a0_type, hat, hl)
  have {rd = data, rlen = len} := apply(mp.reg_at[c := c, A := A, i := i], hc, hu, ha, hi)
  have e := mp(rd, hil)
  have fs: c.file in seq_type(bits(8)) by simp(hc)
  have pn: x86_64_linux.phnum(c.file) in omega by defs(mp(x86.le_at_nat[f := c.file, off := 56, n := 2], fs, simp()), x86_64_linux.phnum)
  have kl: int_lt(i, seq_len(mallocng.regions(c, A))) by arith(rlen, hil, hi, pn, (seq_len(A.areas) = 0 by simp()))
  show := apply(mp.e_regview[c := c, AT := AT, L := L, vm := vm, b := b, k := i, a := a], hc, hat, hl, hb, hsep, hi, kl, hnf, hao, rewrite(sym(e), hr))
qed

// The image, the size classes and the de Bruijn table: on the held view as
// on all bytes
theorem mp.e_image(c, AT, L, vm, b): c in mallocng.Cfg -> AT in omega -> L in list_type(cart(omega, omega)) ->
  (all p. p in bits(64) -> b[p] = none) -> mallocng.separate(mallocng.regions(c, mp.a0(AT, L))) ->
  mallocng.image_ok(c, mallocng.mview(vm, mallocng.all_bytes())) ->
  mallocng.image_ok(c, mallocng.mview(vm, mallocng.held(c, mp.a0(AT, L), b)))
proof
  assume hc hat hl hb hsep himg
  let M := mallocng.mview(vm, mallocng.all_bytes())
  let M2 := mallocng.mview(vm, mallocng.held(c, mp.a0(AT, L), b))
  have cl2 cl3 := (c.lock in omega && c.libc in omega by simp(hc))
  have d0 d1 d2 := apply(mp.data_at[c := c])
  have ro: all i. all a. i in omega -> a in omega -> int_lt(i, x86_64_linux.phnum(c.file)) -> mallocng.in_range(a, mallocng.ro_ranges(c.file)[i]) -> M2[a] = M[a] proof
    fix i a
    assume hi hao hil inr
    show := apply(mp.e_ro[c := c, AT := AT, L := L, vm := vm, b := b, i := i, a := a], hc, hat, hl, hb, hsep, hi, hil, hao, inr)
  qed
  have lnl: mallocng.L_NEED_LOCKS = 3 by defs(simp(), mallocng.L_NEED_LOCKS)
  have lr: int_le(c.libc, int_add(c.libc, 3)) && int_lt(int_add(c.libc, 3), int_add(c.libc, 16)) by arith(cl3)
  have lb: mallocng.in_range(int_add(c.libc, mallocng.L_NEED_LOCKS), mallocng.data_ranges(c)[2]) by defs(simp(d2, lnl, lr), mallocng.in_range)
  have el := apply(mp.e_data[c := c, AT := AT, L := L, vm := vm, b := b, i := 2, a := int_add(c.libc, mallocng.L_NEED_LOCKS)], hc, hat, hl, hb, hsep,
    simp(), simp(), taut((!(2 = 0) by simp())), simp(cl3, lnl), lb)
  have lk: all i. i in omega -> int_lt(i, 4) -> M2[int_add(c.lock, i)] = M[int_add(c.lock, i)] proof
    fix i
    assume hi hil
    have lr: int_le(c.lock, int_add(c.lock, i)) && int_lt(int_add(c.lock, i), int_add(c.lock, 4)) by arith(cl2, hi, hil)
    have inr: mallocng.in_range(int_add(c.lock, i), mallocng.data_ranges(c)[1]) by defs(simp(d1, lr), mallocng.in_range)
    show := apply(mp.e_data[c := c, AT := AT, L := L, vm := vm, b := b, i := 1, a := int_add(c.lock, i)], hc, hat, hl, hb, hsep,
      simp(), simp(), taut((!(1 = 0) by simp())), simp(cl2, hi), inr)
  qed
  show := apply(mp.image_tr[c := c, M := M, M2 := M2], hc, himg, ro, el, lk)
qed

theorem mp.e_classes(c, AT, L, vm, b): c in mallocng.Cfg -> AT in omega -> L in list_type(cart(omega, omega)) ->
  (all p. p in bits(64) -> b[p] = none) -> mallocng.separate(mallocng.regions(c, mp.a0(AT, L))) ->
  mallocng.classes_ok(c, mallocng.mview(vm, mallocng.all_bytes())) ->
  mallocng.classes_ok(c, mallocng.mview(vm, mallocng.held(c, mp.a0(AT, L), b)))
proof
  assume hc hat hl hb hsep hcls
  let M := mallocng.mview(vm, mallocng.all_bytes())
  let M2 := mallocng.mview(vm, mallocng.held(c, mp.a0(AT, L), b))
  have ro: all i. all a. i in omega -> a in omega -> int_lt(i, x86_64_linux.phnum(c.file)) -> mallocng.in_range(a, mallocng.ro_ranges(c.file)[i]) -> M2[a] = M[a] proof
    fix i a
    assume hi hao hil inr
    show := apply(mp.e_ro[c := c, AT := AT, L := L, vm := vm, b := b, i := i, a := a], hc, hat, hl, hb, hsep, hi, hil, hao, inr)
  qed
  show := apply(mp.classes_tr[c := c, M := M, M2 := M2], hc, hcls, ro)
qed

theorem mp.e_debruijn(c, AT, L, vm, b): c in mallocng.Cfg -> AT in omega -> L in list_type(cart(omega, omega)) ->
  (all p. p in bits(64) -> b[p] = none) -> mallocng.separate(mallocng.regions(c, mp.a0(AT, L))) ->
  mallocng.debruijn_ok(c, mallocng.mview(vm, mallocng.all_bytes())) ->
  mallocng.debruijn_ok(c, mallocng.mview(vm, mallocng.held(c, mp.a0(AT, L), b)))
proof
  assume hc hat hl hb hsep hdb
  let M := mallocng.mview(vm, mallocng.all_bytes())
  let M2 := mallocng.mview(vm, mallocng.held(c, mp.a0(AT, L), b))
  have _ _ k3 := expand(hdb, mallocng.debruijn_ok)
  obtain i, hi hil hlo hhi from k3
  have so: c.dbj in omega by simp(hc)
  have fs: c.file in seq_type(bits(8)) by simp(hc)
  have rn := apply(mp.ro_nat[f := c.file, i := i], fs, hi, hil)
  have rs rz := apply(mp.cart_nat, rn)
  have tb: all a. a in omega -> int_le(c.dbj, a) -> int_lt(a, int_add(c.dbj, 32)) -> M2[a] = M[a] proof
    fix a
    assume hao h1 h2
    have inr: mallocng.in_range(a, mallocng.ro_ranges(c.file)[i]) by defs(arith(h1, h2, hlo, hhi, rs, rz, so, hao), mallocng.in_range)
    show := apply(mp.e_ro[c := c, AT := AT, L := L, vm := vm, b := b, i := i, a := a], hc, hat, hl, hb, hsep, hi, hil, hao, inr)
  qed
  show := apply(mp.debruijn_tr[c := c, M := M, M2 := M2], hc, hdb, tb)
qed

// (n context bytes from off, none a free counter's, all zero: read as 0
// on the held view)
theorem mp.e_cz(c, AT, L, vm, b, off, n): c in mallocng.Cfg -> AT in omega -> L in list_type(cart(omega, omega)) ->
  (all p. p in bits(64) -> b[p] = none) -> mallocng.separate(mallocng.regions(c, mp.a0(AT, L))) ->
  (all a. a in omega -> int_le(c.ctx, a) -> int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE)) -> mallocng.b8(mallocng.mview(vm, mallocng.all_bytes()), a) = 0) ->
  off in omega -> n in omega ->
  (int_le(int_add(off, n), 12) || (int_le(16, off) && int_le(int_add(off, n), 464)) || (int_le(920, off) && int_le(int_add(off, n), 928))) ->
  mallocng.rd(mallocng.mview(vm, mallocng.held(c, mp.a0(AT, L), b)), int_add(c.ctx, off), n) = 0
proof
  assume hc hat hl hb hsep hz ho hn hw
  let M := mallocng.mview(vm, mallocng.all_bytes())
  let M2 := mallocng.mview(vm, mallocng.held(c, mp.a0(AT, L), b))
  have co: c.ctx in omega by simp(hc)
  have ks: mallocng.CTX_SIZE = 928 by defs(simp(), mallocng.CTX_SIZE)
  have d0 _ _ := apply(mp.data_at[c := c])
  have bz: all i. i in omega -> int_lt(i, n) -> mallocng.b8(M2, int_add(int_add(c.ctx, off), i)) = 0 proof
    fix i
    assume hi hil
    let a := int_add(int_add(c.ctx, off), i)
    have ao: a in omega by arith(co, ho, hi)
    have lr: int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, 928)) by arith(co, ho, hi, hil, hw)
    have inr: mallocng.in_range(a, mallocng.data_ranges(c)[0]) by defs(simp(d0, lr, ks), mallocng.in_range)
    have nf: !mallocng.ctx_free(c, a) by defs(arith(hi, hil, co, ho, hw), mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK)
    have e := apply(mp.e_data[c := c, AT := AT, L := L, vm := vm, b := b, i := 0, a := a], hc, hat, hl, hb, hsep, simp(), simp(), taut(nf), ao, inr)
    have z := mp(all_elim(hz, {a}), ao, taut(lr), arith(lr, ks))
    have q: mallocng.b8(M2, a) = mallocng.b8(M, a) by defs(simp(e), mallocng.b8)
    show := trans(q, z)
  qed
  show := apply(mp.rd_zero, hn, bz)
qed

// (a list empty: cyclic from 0)
theorem mp.cyc_nil(M): mallocng.cyclic(M, 0, empty)
proof
  have ln: seq_len(empty) = 0 by simp()
  have k1: all i j. i in omega && j in omega -> int_lt(i, 0) && int_lt(j, 0) -> i = j proof
    fix i j
    assume hij hl
    have i1 _ := hij
    have l1 _ := hl
    show by taut((false by arith(i1, l1)))
  qed
  have k2: all i. i in omega -> int_lt(i, 0) -> mallocng.rd(M, 8, 8) = empty && mallocng.rd(M, empty, 8) = empty proof
    fix i
    assume hi hl
    show by taut((false by arith(hi, hl)))
  qed
  show by defs(simp(ln, k1, k2), mallocng.cyclic)
qed

// the context: all its words zero, its lists empty
theorem mp.e_ctx(c, AT, L, vm, b): c in mallocng.Cfg -> AT in omega -> L in list_type(cart(omega, omega)) ->
  (all p. p in bits(64) -> b[p] = none) -> mallocng.separate(mallocng.regions(c, mp.a0(AT, L))) ->
  (all a. a in omega -> int_le(c.ctx, a) -> int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE)) -> mallocng.b8(mallocng.mview(vm, mallocng.all_bytes()), a) = 0) ->
  mallocng.ctx_ok(c, mp.a0(AT, L), mallocng.mview(vm, mallocng.held(c, mp.a0(AT, L), b)))
proof
  assume hc hat hl hb hsep hz
  let A := mp.a0(AT, L)
  let M2 := mallocng.mview(vm, mallocng.held(c, A, b))
  have co: c.ctx in omega by simp(hc)
  have cw: all off. off in omega ->
      (int_le(int_add(off, 8), 12) || (int_le(16, off) && int_le(int_add(off, 8), 464)) || (int_le(920, off) && int_le(int_add(off, 8), 928))) ->
      mallocng.ctx_word(c, M2, off) = 0 proof
    fix off
    assume ho hw
    show by defs(apply(mp.e_cz[c := c, AT := AT, L := L, vm := vm, b := b, off := off, n := 8], hc, hat, hl, hb, hsep, hz, ho, simp(), hw), mallocng.ctx_word)
  qed
  have cv: ((((mallocng.C_SECRET = 0 && mallocng.C_INIT_DONE = 8) && mallocng.C_FREE_META = 16) && mallocng.C_ACTIVE = 80) && mallocng.C_AVAIL_CNT = 32) && mallocng.C_AREA_CNT = 40
    by defs(simp(), mallocng.C_SECRET, mallocng.C_INIT_DONE, mallocng.C_FREE_META, mallocng.C_ACTIVE, mallocng.C_AVAIL_CNT, mallocng.C_AREA_CNT)
  have v0 v8 v16 v80 v32 v40 := cv
  have cw2: mallocng.C_BRK = 920 && mallocng.C_META_SHIFT = 48 by defs(simp(), mallocng.C_BRK, mallocng.C_META_SHIFT)
  have v920 v48 := cw2
  have k1: mallocng.ctx_word(c, M2, mallocng.C_SECRET) = A.secret by simp(mp(all_elim(cw, {0}), simp(), arith()), v0)
  have k2: mallocng.rd(M2, int_add(c.ctx, mallocng.C_INIT_DONE), 4) = A.init_done
    by simp(apply(mp.e_cz[c := c, AT := AT, L := L, vm := vm, b := b, off := 8, n := 4], hc, hat, hl, hb, hsep, hz, simp(), simp(), arith()), v8)
  have k3: int_lt(A.init_done, 2) by simp()
  have k4: mallocng.ctx_word(c, M2, mallocng.C_AVAIL_CNT) = A.avail_cnt by simp(mp(all_elim(cw, {32}), simp(), arith()), v32)
  have k5: int_le(A.avail_cnt, mallocng.NSLOTS) by defs(simp(), mallocng.NSLOTS)
  have k6: int_lt(0, A.avail_cnt) -> ord_lt(0, seq_len(A.areas)) &&
      mallocng.ctx_word(c, M2, mallocng.C_AVAIL_META) = mallocng.meta_at(A.areas[int_sub(seq_len(A.areas), 1)], int_sub(mallocng.NSLOTS, A.avail_cnt)) proof
    assume h
    show by taut((false by arith(h, (A.avail_cnt = 0 by simp()))))
  qed
  have k7: mallocng.ctx_word(c, M2, mallocng.C_AREA_CNT) = A.reserve_cnt by simp(mp(all_elim(cw, {40}), simp(), arith()), v40)
  have k8: int_lt(0, A.reserve_cnt) -> mallocng.ctx_word(c, M2, mallocng.C_AVAIL_AREAS) = A.reserve && int_mod(A.reserve, 4096) = 0 proof
    assume h
    show by taut((false by arith(h, (A.reserve_cnt = 0 by simp()))))
  qed
  have k9: mallocng.ctx_word(c, M2, mallocng.C_BRK) = A.brk by simp(mp(all_elim(cw, {920}), simp(), arith()), v920)
  have k10: mallocng.cyclic(M2, mallocng.ctx_word(c, M2, mallocng.C_FREE_META), A.free_metas)
    by simp(mp(all_elim(cw, {16}), simp(), arith()), v16, mp.cyc_nil[M := M2])
  have k11: seq_len(A.active) = 48 by defs(simp(fn_build_dom[d := 48, v := x. empty]), seq_len)
  have k12: all x0. x0 in omega -> int_lt(x0, 48) -> mallocng.cyclic(M2, mallocng.ctx_word(c, M2, int_add(mallocng.C_ACTIVE, int_mul(8, x0))), A.active[x0]) proof
    fix sc
    assume hs hsl
    have w := mp(all_elim(cw, {int_add(80, int_mul(8, sc))}), arith(hs), arith(hs, hsl))
    have e: A.active[sc] = empty by simp(mp(app_fn_build[d := 48, v := x. empty, a := sc], mp(nat_lt_mem[k := sc, n := 48], hs, simp(), hsl)))
    show by simp(w, v80, e, mp.cyc_nil[M := M2])
  qed
  have k13: int_le(mallocng.ctx_word(c, M2, mallocng.C_META_SHIFT), 34) by simp(mp(all_elim(cw, {48}), simp(), arith()), v48)
  show by defs(taut(k1, k2, k3, k4, k5, k6, k7, k8, k9, k10, k11, k12, k13), mallocng.ctx_ok)
qed

