// The reserve refilled (alloc_meta's `!ctx.avail_meta_area_count`
// branches): fresh pages from brk or mmap made the reserve. Fresh pages
// were unmapped; everything the invariant owns is mapped -- so the new
// reserve is apart from every region. The invariant kept.

// ----------------------------------------------------------------------
//  The owned bytes mapped: the regions' too

// a client's byte: in a slot of a group in use
theorem mp.live_grp(c, A, M, b, brk, a): A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) -> mallocng.holds(c, A, M, b, brk) ->
  a in malloc.live_of(b) -> ex g. mallocng.is_used(A, g) && mallocng.in_range(a, mallocng.group_range(A.metas[g]))
proof
  assume ha hb H hl
  have {huo = used, hbl = in_slots} := expand(H, mallocng.holds)
  have s1 := set_select_def[s := omega, p := y. ex q. q in bits(64) && (!(b[q] = none) && y in malloc.range(q, snd(b[q]))), z := a]
  have ao ex := (a in omega && (ex q. q in bits(64) && (!(b[q] = none) && a in malloc.range(q, snd(b[q])))) by taut(s1, expand(hl, malloc.live_of)))
  obtain p, hp hn hr from ex
  have s2 := set_select_def[s := omega, p := y. int_le(p, y) && int_lt(y, int_add(p, snd(b[p]))), z := a]
  have _ r1 r2 := (a in omega && (int_le(p, a) && int_lt(a, int_add(p, snd(b[p])))) by taut(s2, expand(hr, malloc.range)))
  obtain k j, hk hj hkl hjl hs from mp(all_elim(expand(hbl, mallocng.blocks_ok), {p}), hp, hn)
  let g := A.used[k]
  let V := A.metas[g]
  have ul: A.used in list_type(omega) by simp(ha)
  have go := apply(at_type[l := A.used, t := omega, i := k], ul, hk, hkl)
  have gok := mp(all_elim(expand(huo, mallocng.used_ok), {k}), hk, hkl)
  have {gso = slots} := expand(gok, mallocng.group_ok)
  have so := mp(all_elim(gso, {j}), hj, hjl)
  have po: p in omega by arith(hp)
  have pb: bits_of_int(64, p) = p := mp(bits_of_int_small[n := 64, a := p], po, (int_lt(p, pow2(64)) by arith(hp)))
  have s3: !(b[bits_of_int(64, p)] = none) && mallocng.hdr_free(b, p) && mallocng.frame_ok(M, V, j, p, snd(b[bits_of_int(64, p)]), 0)
    by simp(expand(rewrite(hs, so), mallocng.slot_ok))
  have fo: mallocng.frame_ok(M, V, j, p, snd(b[p]), 0) := rewrite(pb, (mallocng.frame_ok(M, V, j, p, snd(b[bits_of_int(64, p)]), 0) by taut(s3)))
  have {f1 = start, f3 = fits} := expand(fo, mallocng.frame_ok)
  have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
  have isl: mallocng.in_slot(V, j, a) by defs(arith(f1, f3, r1, r2, ci), mallocng.in_slot)
  have inr := apply(mp.slot_in_group[A := A, M := M, b := b, g := g, i := j, a := a], ha, go, hj, ao, gok, hjl, isl)
  have iu: mallocng.is_used(A, g) by defs(ex_intro({k}, taut(hk, hkl, refl({g}))), mallocng.is_used)
  show by ex_intro({g}, taut(iu, inr))
qed

// ... so in no fixed range
theorem mp.live_nofix(c, A, M, b, brk, a): A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) -> mallocng.holds(c, A, M, b, brk) ->
  a in malloc.live_of(b) -> !mallocng.in_ranges(a, mallocng.fixed_ranges(c, A))
proof
  assume ha hb H hl
  have {hga = apart} := expand(H, mallocng.holds)
  obtain g, iu inr from apply(mp.live_grp, ha, hb, H, hl)
  obtain k, hk hkl hke from expand(iu, mallocng.is_used)
  have ao: a in omega by taut(expand(hl, malloc.live_of), set_select_def[s := omega, p := y. ex q. q in bits(64) && (!(b[q] = none) && y in malloc.range(q, snd(b[q]))), z := a])
  show := mp(all_elim(expand(hga, mallocng.groups_apart), {k}, {a}), conj(hk, ao), conj(hkl, rewrite(sym(hke), inr)))
qed

// (a byte of a region: of the ranges the allocator owns)
theorem mp.regions_fp(c, A, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.in_ranges(a, mallocng.regions(c, A)) ->
  mallocng.in_ranges(a, mallocng.fp_ranges(c, A))
proof
  assume hc hu ha h
  have {fr = front, ar = areas, rdl = rodata, rp = reserve, gr = groups, er = eq} := apply(mp.regions_parts, hc, hu, ha)
  have cs: subset(cart(omega, omega), univ(1)) proof
    have cu := apply(cart_univ[u := 1, a := omega, b := omega], omega_univ, omega_univ)
    have q: all x. x in cart(omega, omega) -> x in univ(1) proof
      fix x
      assume hx
      show := mp(mp(univ_trans[u := 1, a := x, b := cart(omega, omega)], cu), hx)
    qed
    show by defs(q, subset)
  qed
  let DR := mallocng.data_ranges(c)
  let RO := mallocng.ro_ranges(c.file)
  let AR := fn_build(int_sub(seq_len(A.areas), 0), x0. pair(A.areas[int_add(0, x0)], 4096))
  let RS := seq_one(pair(A.reserve, int_mul(4096, A.reserve_cnt)))
  let GR := fn_build(int_sub(seq_len(A.used), 0), x0. ite(int_lt(0, A.metas[A.used[int_add(0, x0)]].maplen), mallocng.group_range(A.metas[A.used[int_add(0, x0)]]), pair(0, 0)))
  have uf := apply(tr.list_mono, fr, cs)
  have ua := apply(tr.list_mono, ar, cs)
  have ug := apply(tr.list_mono, gr, cs)
  have urs := apply(tr.list_mono, apply(tr.seq_one_type, rp), cs)
  have ro := apply(mp.ro_list, (c.file in seq_type(bits(8)) by simp(hc)))
  have cf: c.ctx in omega && c.lock in omega && c.libc in omega by simp(hc)
  have o1 := apply(tr.seq_one_type, (pair(c.ctx, mallocng.CTX_SIZE) in univ(1) by simp(cf)))
  have o2 := apply(tr.seq_one_type, (pair(c.lock, 4) in univ(1) by simp(cf)))
  have o3 := apply(tr.seq_one_type, (pair(c.libc, 16) in univ(1) by simp(cf)))
  have dl: DR in list_type(univ(1)) by defs(apply(tr.concat_list, apply(tr.concat_list, o1, o2), o3), mallocng.data_ranges)
  have udr := apply(tr.concat_list, dl, ro)
  have e1 := apply(mp.ranges_cat[a := a, xs := seq_concat(seq_concat(seq_concat(DR, RO), AR), RS), ys := GR], apply(tr.concat_list, uf, urs), ug)
  have e2 := apply(mp.ranges_cat[a := a, xs := seq_concat(seq_concat(DR, RO), AR), ys := RS], uf, urs)
  have e3 := apply(mp.ranges_cat[a := a, xs := seq_concat(DR, RO), ys := AR], udr, ua)
  have e4 := apply(mp.ranges_cat[a := a, xs := DR, ys := RO], dl, ro)
  have hr := rewrite(er, h)
  // the fixed pieces
  have {p1 = front, p6 = groups} := apply(mp.fp_pieces, hc, hu, ha)
  have rd2 := apply(tr.concat_list, ro, dl)
  have ax := apply(mp.front_pieces, hc, hu, ha)
  have {xa = auxv} := ax
  have f1: mallocng.in_ranges(a, DR) || mallocng.in_ranges(a, RO) ->
      mallocng.in_ranges(a, seq_concat(seq_concat(mallocng.ro_ranges(c.file), mallocng.data_ranges(c)), mallocng.auxv_ranges(A))) proof
    assume w
    have c1 := apply(mp.ranges_cat[a := a, xs := RO, ys := DR], ro, dl)
    have q: mallocng.in_ranges(a, seq_concat(RO, DR)) by taut(c1, w)
    show := apply(mp.ranges_l, rd2, xa, q)
  qed
  have fx: (mallocng.in_ranges(a, DR) || mallocng.in_ranges(a, RO)) || mallocng.in_ranges(a, AR) || mallocng.in_ranges(a, RS) ->
      mallocng.in_ranges(a, mallocng.fixed_ranges(c, A)) proof
    assume w
    show := apply(mp.fixed_in[c := c, A := A, a := a], hc, hu, ha, taut(w, f1))
  qed
  // the groups: one mapped on its own
  have fg: mallocng.in_ranges(a, GR) -> mallocng.in_ranges(a, fn_build(int_sub(seq_len(A.used), 0), x0. mallocng.group_range(A.metas[A.used[int_add(0, x0)]]))) proof
    assume w
    have ul: A.used in list_type(omega) by simp(ha)
    have uo: seq_len(A.used) in omega by arith(ul)
    obtain k, hk hkl hrk from apply(mp.ranges_build_inv[a := a, n := seq_len(A.used), r := x. ite(int_lt(0, A.metas[A.used[x]].maplen), mallocng.group_range(A.metas[A.used[x]]), pair(0, 0))], uo, w)
    have d1: int_lt(0, A.metas[A.used[k]].maplen) -> mallocng.in_range(a, mallocng.group_range(A.metas[A.used[k]])) proof
      assume m
      show := rewrite(mp(ite_t[c := int_lt(0, A.metas[A.used[k]].maplen), a := mallocng.group_range(A.metas[A.used[k]]), b := pair(0, 0)], m), hrk)
    qed
    have d2: !int_lt(0, A.metas[A.used[k]].maplen) -> false proof
      assume m
      have z := rewrite(mp(ite_f[c := int_lt(0, A.metas[A.used[k]].maplen), a := mallocng.group_range(A.metas[A.used[k]]), b := pair(0, 0)], m), hrk)
      have zz: int_le(0, a) && int_lt(a, int_add(0, 0)) by simp(expand(z, mallocng.in_range))
      show by arith(zz)
    qed
    show := apply(mp.ranges_build[r := x. mallocng.group_range(A.metas[A.used[x]])], uo, hk, hkl, (mallocng.in_range(a, mallocng.group_range(A.metas[A.used[k]])) by taut(d1, d2)))
  qed
  have x1: mallocng.fixed_ranges(c, A) in list_type(univ(1)) by defs(apply(mp.pre_list, hc, hu, ha), mallocng.fixed_ranges)
  have c5 := apply(mp.ranges_cat[a := a, xs := mallocng.fixed_ranges(c, A), ys := fn_build(int_sub(seq_len(A.used), 0), x0. mallocng.group_range(A.metas[A.used[int_add(0, x0)]]))], x1, p6)
  have q: mallocng.in_ranges(a, seq_concat(mallocng.fixed_ranges(c, A), fn_build(int_sub(seq_len(A.used), 0), x0. mallocng.group_range(A.metas[A.used[int_add(0, x0)]]))))
    by taut(e1, e2, e3, e4, hr, fx, fg, c5)
  show by defs(q, mallocng.fp_ranges)
qed

// a byte of the ranges the allocator owns: mapped (the allocator's, or a
// client's in a group)
theorem mp.owned_mapped(c, A, vm, b, a): A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  mallocng.holds_in(c, A, vm, b) -> a in omega -> mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) -> x86_64_linux.mapped(vm, int_div(a, x86_64_linux.PAGE))
proof
  assume ha hb hh hao irf
  have {H = inv, hm = mapped, hrw = rw} := expand(hh, mallocng.holds_in)
  obtain k1, hk1 hk1l hr1 from expand(irf, mallocng.in_ranges)
  have g1 g2 := expand(hr1, mallocng.in_range)
  have c1: !(a in malloc.live_of(b)) -> x86_64_linux.mapped(vm, int_div(a, x86_64_linux.PAGE)) proof
    assume nl
    show := mp(all_elim(expand(hm, mallocng.fp_mapped), {k1}, {a}), conj(hk1, hao), taut(hk1l, g1, g2, nl))
  qed
  have c2: a in malloc.live_of(b) -> x86_64_linux.mapped(vm, int_div(a, x86_64_linux.PAGE)) proof
    assume hl
    obtain g, iu inr from apply(mp.live_grp, ha, hb, H, hl)
    have {go = nat} := apply(mp.used_nat, ha, iu)
    have o1 _ := mp(all_elim(expand(hrw, mallocng.grp_rw), {g}, {a}), conj(go, hao), taut(iu, inr, hl))
    have m0 _ _ := expand(o1, mallocng.m_rw)
    have mb mn := expand(m0, mallocng.m_mapped)
    have p0 := apply(mp.pg_view[vm := vm, fp := mallocng.all_bytes(), a := a], hao, (a in mallocng.all_bytes() by defs(sel(taut(hao)), mallocng.all_bytes)))
    show by defs(taut(mb, rewrite(p0, mn)), x86_64_linux.mapped)
  qed
  show by taut(c1, c2)
qed

// ... a byte of a region too
theorem mp.regions_mapped(c, A, vm, b, k, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  mallocng.holds_in(c, A, vm, b) -> k in omega -> int_lt(k, seq_len(mallocng.regions(c, A))) -> a in omega ->
  mallocng.in_range(a, mallocng.regions(c, A)[k]) -> x86_64_linux.mapped(vm, int_div(a, x86_64_linux.PAGE))
proof
  assume hc hu ha hb hh hk hkl hao hr
  have ir: mallocng.in_ranges(a, mallocng.regions(c, A)) by defs(ex_intro({k}, taut(hk, hkl, hr)), mallocng.in_ranges)
  show := apply(mp.owned_mapped, ha, hb, hh, hao, apply(mp.regions_fp, hc, hu, ha, ir))
qed

// a byte of an unmapped page: none of the allocator's -- in no range it
// owns, no client's, no reserved slot's, no taken meta's
theorem mp.fresh_out(c, A, vm, b, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  mallocng.holds_in(c, A, vm, b) -> a in omega -> !x86_64_linux.mapped(vm, int_div(a, x86_64_linux.PAGE)) ->
  owned: !mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) && live: !(a in malloc.live_of(b)) && res: !mallocng.in_reserved(A, a) && taken: !mallocng.in_taken(A, a)
proof
  assume hc hu ha hb hh hao hn
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {huo = used, hpt = part} := expand(H, mallocng.holds)
  have no: !mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) proof
    assume h
    show by taut(hn, apply(mp.owned_mapped, ha, hb, hh, hao, h))
  qed
  have {p6 = groups} := apply(mp.fp_pieces, hc, hu, ha)
  have x1: mallocng.fixed_ranges(c, A) in list_type(univ(1)) by defs(apply(mp.pre_list, hc, hu, ha), mallocng.fixed_ranges)
  // (a group's byte: owned)
  have go: all g. mallocng.is_used(A, g) -> !mallocng.in_range(a, mallocng.group_range(A.metas[g])) proof
    fix g
    assume iu
    assume ir
    obtain k, hk hkl hke from expand(iu, mallocng.is_used)
    have ul: A.used in list_type(omega) by simp(ha)
    have ir2: mallocng.in_ranges(a, fn_build(int_sub(seq_len(A.used), 0), x0. mallocng.group_range(A.metas[A.used[int_add(0, x0)]])))
      := apply(mp.ranges_build[r := x. mallocng.group_range(A.metas[A.used[x]])], (seq_len(A.used) in omega by arith(ul)), hk, hkl, rewrite(sym(hke), ir))
    have f := apply(mp.ranges_r, x1, p6, ir2)
    show by taut(no, (mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) by defs(f, mallocng.fp_ranges)))
  qed
  have nl: !(a in malloc.live_of(b)) proof
    assume hl
    obtain g, iu inr from apply(mp.live_grp, ha, hb, H, hl)
    show by taut(mp(all_elim(go, {g}), iu), inr)
  qed
  have nr: !mallocng.in_reserved(A, a) proof
    assume hr
    obtain g i, gn hio iu hil hs his from expand(hr, mallocng.in_reserved)
    have gok := apply(mp.used_group, huo, iu)
    have inr := apply(mp.slot_in_group[A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, g := g, i := i, a := a], ha, gn, hio, hao, gok, hil, his)
    show by taut(mp(all_elim(go, {g}), iu), inr)
  qed
  have nt: !mallocng.in_taken(A, a) proof
    assume ht
    obtain k, hk hkl h1 h2 from expand(ht, mallocng.in_taken)
    have {tk = taken} := expand(hpt, mallocng.metas_partition)
    have ms _ _ _ _ := mp(all_elim(tk, {k}), hk, hkl)
    have {gex = area} := apply(mp.meta_page, ha, ms)
    obtain j, hj hjl g1 g2 _ from gex
    have rl: A.areas in list_type(omega) by simp(ha)
    have ajo := apply(at_type[l := A.areas, t := omega, i := j], rl, hj, hjl)
    have cm: mallocng.META_SIZE = 40 by defs(refl({40}), mallocng.META_SIZE)
    have fx := apply(mp.area_fixed[c := c, A := A, k := j, a := a], hc, hu, ha, hj, hjl, arith(g1, h1, ajo), arith(g2, h2, cm))
    show by taut(no, (mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) by defs(apply(mp.ranges_l, x1, p6, fx), mallocng.fp_ranges)))
  qed
  show by taut(no, nl, nr, nt)
qed

// (two ranges sharing no byte: apart)
theorem mp.apart_of(r, q): r in cart(omega, omega) -> q in cart(omega, omega) ->
  (all a. a in omega -> mallocng.in_range(a, r) -> !mallocng.in_range(a, q)) -> mallocng.apart(r, q)
proof
  assume hr hq h
  have a1 a2 := apply(mp.cart_nat, hr)
  have b1 b2 := apply(mp.cart_nat, hq)
  have n: !mallocng.apart(r, q) -> false proof
    assume na
    have w := expand(na, mallocng.apart)
    have d1: int_le(fst(r), fst(q)) -> false proof
      assume l
      have i1: mallocng.in_range(fst(q), r) by defs(arith(w, l, a1, a2, b1, b2), mallocng.in_range)
      have i2: mallocng.in_range(fst(q), q) by defs(arith(w, b1, b2), mallocng.in_range)
      show by taut(mp(all_elim(h, {fst(q)}), b1, i1), i2)
    qed
    have d2: !int_le(fst(r), fst(q)) -> false proof
      assume l
      have i1: mallocng.in_range(fst(r), r) by defs(arith(w, a1, a2), mallocng.in_range)
      have i2: mallocng.in_range(fst(r), q) by defs(arith(w, l, a1, a2, b1, b2), mallocng.in_range)
      show by taut(mp(all_elim(h, {fst(r)}), a1, i1), i2)
    qed
    show by taut(d1, d2)
  qed
  show by taut(n)
qed

// a region replaced by one apart from all the others: the regions
// separate still
theorem mp.sep_replace(X, r, Q, r2): X in list_type(cart(omega, omega)) -> Q in list_type(cart(omega, omega)) -> r in cart(omega, omega) -> r2 in cart(omega, omega) ->
  mallocng.separate(seq_concat(seq_concat(X, seq_one(r)), Q)) ->
  (all i. i in omega -> int_lt(i, seq_len(X)) -> mallocng.apart(r2, X[i])) -> (all i. i in omega -> int_lt(i, seq_len(Q)) -> mallocng.apart(r2, Q[i])) ->
  mallocng.separate(seq_concat(seq_concat(X, seq_one(r2)), Q))
proof
  assume hx hq hr hr2 hs ax aq
  let C := cart(omega, omega)
  let OL := seq_concat(seq_concat(X, seq_one(r)), Q)
  let NL := seq_concat(seq_concat(X, seq_one(r2)), Q)
  let n := seq_len(X)
  have nx: n in omega by arith(hx)
  have mq: seq_len(Q) in omega by arith(hq)
  have rl := mp(all_elim(tr.seq_one_type, {r}, {C}), hr)
  have r2l := mp(all_elim(tr.seq_one_type, {r2}, {C}), hr2)
  have lO: seq_len(OL) = int_add(int_add(n, 1), seq_len(Q)) by arith(hx, rl, hq)
  have lN: seq_len(NL) = int_add(int_add(n, 1), seq_len(Q)) by arith(hx, r2l, hq)
  // (the k-th of the new list: the old one's, r2 at n; apart from r2 but at n)
  have same: all k. k in omega -> int_lt(k, seq_len(NL)) -> !(k = n) -> NL[k] = OL[k] proof
    fix k
    assume hk hkl hne
    have c1: int_lt(k, n) -> NL[k] = OL[k] proof
      assume h
      show := trans(at({NL[k]}, hx, hq, hk, h), sym(at({OL[k]}, hx, hq, hk, h)))
    qed
    have c2: int_lt(n, k) -> NL[k] = OL[k] proof
      assume h
      show := trans(at({NL[k]}, hx, hq, hk, h, hkl, lN), sym(at({OL[k]}, hx, hq, hk, h, hkl, lN, lO)))
    qed
    show by taut(c1, c2, (int_lt(k, n) || int_lt(n, k) by arith(hk, nx, hne)))
  qed
  have e2: NL[n] = r2 := at({NL[n]}, hx, hq, nx)
  have ap: all k. k in omega -> int_lt(k, seq_len(NL)) -> !(k = n) -> mallocng.apart(r2, NL[k]) proof
    fix k
    assume hk hkl hne
    have c1: int_lt(k, n) -> mallocng.apart(r2, NL[k]) proof
      assume h
      show := rewrite(sym(at({NL[k]}, hx, hq, hk, h)), mp(all_elim(ax, {k}), hk, h))
    qed
    have c2: int_lt(n, k) -> mallocng.apart(r2, NL[k]) proof
      assume h
      have e := at({NL[k]}, hx, hq, hk, h, hkl, lN)
      have q := mp(all_elim(aq, {int_sub(k, int_add(1, seq_len(X)))}), (int_sub(k, int_add(1, seq_len(X))) in omega by arith(hk, h, nx)),
        (int_lt(int_sub(k, int_add(1, seq_len(X))), seq_len(Q)) by arith(hkl, lN, h, nx)))
      show := rewrite(sym(e), q)
    qed
    show by taut(c1, c2, (int_lt(k, n) || int_lt(n, k) by arith(hk, nx, hne)))
  qed
  have tN := mp(all_elim(tr.concat_list, {seq_concat(X, seq_one(r2))}, {Q}, {C}), mp(all_elim(tr.concat_list, {X}, {seq_one(r2)}, {C}), hx, r2l), hq)
  have ss: all k. all l. k in omega && l in omega -> (int_lt(k, seq_len(NL)) && int_lt(l, seq_len(NL))) && !(k = l) -> mallocng.apart(NL[k], NL[l]) proof
    fix k l
    assume hkl2 hb
    have hk hl := hkl2
    have kb lb ne := hb
    have b1: k = n -> mallocng.apart(NL[k], NL[l]) proof
      assume e
      have q := mp(all_elim(ap, {l}), hl, lb, (!(l = n) by arith(e, ne, hk, hl, nx)))
      show := subst({y. mallocng.apart(NL[y], NL[l])}, sym(e), subst({y. mallocng.apart(y, NL[l])}, sym(e2), q))
    qed
    have b2: l = n -> mallocng.apart(NL[k], NL[l]) proof
      assume e
      have q := mp(all_elim(ap, {k}), hk, kb, (!(k = n) by arith(e, ne, hk, hl, nx)))
      show := subst({y. mallocng.apart(NL[k], NL[y])}, sym(e), subst({y. mallocng.apart(NL[k], y)}, sym(e2), apply(mp.apart_sym, q)))
    qed
    have b3: !(k = n) && !(l = n) -> mallocng.apart(NL[k], NL[l]) proof
      assume h
      have n1 n2 := h
      have s := mp(all_elim(expand(hs, mallocng.separate), {k}, {l}), conj(hk, hl), conj(conj((int_lt(k, seq_len(OL)) by arith(kb, lN, lO)), (int_lt(l, seq_len(OL)) by arith(lb, lN, lO))), ne))
      show := rewrite(sym(mp(all_elim(same, {l}), hl, lb, n2)), rewrite(sym(mp(all_elim(same, {k}), hk, kb, n1)), s))
    qed
    show by taut(b1, b2, b3)
  qed
  show by defs(ss, mallocng.separate)
qed

// ----------------------------------------------------------------------
//  The step: the reserve K fresh pages at R2, the break B

abbrev mp.refill(A, R2, K, B) := fn_update(fn_update(fn_update(A, "reserve", R2), "reserve_cnt", K), "brk", B)

theorem mp.refill_type(A, R2, K, B): A in mallocng.Abs -> R2 in omega -> K in omega -> B in omega ->
  abs: mp.refill(A, R2, K, B) in mallocng.Abs && univ: mp.refill(A, R2, K, B) in univ(1)
proof
  assume ha hr hk hb
  let K0 := insert("secret", insert("init_done", insert("auxv_at", insert("auxv", insert("areas", insert("avail_cnt", insert("reserve", insert("reserve_cnt", insert("free_metas", insert("used", insert("metas", insert("active", insert("slots", insert("brk", insert("taken", empty)))))))))))))))
  let A1 := fn_update(A, "reserve", R2)
  let A2 := fn_update(A1, "reserve_cnt", K)
  have ap af ad := (A in powerset(cart(K0, univ(1))) && is_fun(A) && dom(A) = K0 by simp(expand(ha, mallocng.Abs)))
  have ru: R2 in univ(1) := mp(mp(univ_trans[u := 1, a := R2, b := omega], omega_univ), hr)
  have ku: K in univ(1) := mp(mp(univ_trans[u := 1, a := K, b := omega], omega_univ), hk)
  have bu: B in univ(1) := mp(mp(univ_trans[u := 1, a := B, b := omega], omega_univ), hb)
  have p1 := apply(mp.pow_upd[K := K0, B := univ(1), r := A, k := "reserve", v := R2], ap, simp(), ru)
  have f1 d1 := mp(fn_update_fd[f := A, k := "reserve", v := R2, d := K0], af, ad, simp())
  have p2 := apply(mp.pow_upd[K := K0, B := univ(1), r := A1, k := "reserve_cnt", v := K], p1, simp(), ku)
  have f2 d2 := mp(fn_update_fd[f := A1, k := "reserve_cnt", v := K, d := K0], f1, d1, simp())
  have p3 := apply(mp.pow_upd[K := K0, B := univ(1), r := A2, k := "brk", v := B], p2, simp(), bu)
  have f3 d3 := mp(fn_update_fd[f := A2, k := "brk", v := B, d := K0], f2, d2, simp())
  have au := mp(rec_univ[u := 1, k := K0, r := A], simp(x86.insert_univ), ap, af, ad)
  have a3: mp.refill(A, R2, K, B) in mallocng.Abs by defs(simp(p3, f3, d3, hr, hk, hb, ru, ku, bu, au, expand(ha, mallocng.Abs)), mallocng.Abs)
  have u3 := mp(rec_univ[u := 1, k := K0, r := mp.refill(A, R2, K, B)], simp(x86.insert_univ), p3, f3, d3)
  show by taut(a3, u3)
qed

// (the bytes such a step writes: the context's area count, shift, reserve
// and break words)
def mp.rfbyte(c, a) := (int_le(int_add(c.ctx, 40), a) && int_lt(a, int_add(c.ctx, 56))) ||
  (int_le(int_add(c.ctx, 72), a) && int_lt(a, int_add(c.ctx, 80))) || (int_le(int_add(c.ctx, 920), a) && int_lt(a, int_add(c.ctx, 928)))

// the step: the reserve empty; K pages at R2 unmapped before, mapped
// after (not the stack, zero); the pages mapped before as they were, their
// bytes too but the context words written
abbrev mp.rfpre(c, A, vm, V1, b, R2, K, B) := cfg: c in mallocng.Cfg && univ: A in univ(1) && abs: A in mallocng.Abs &&
  blocks: b in fn_space(bits(64), option(omega)) && vm: vm in x86_64_linux.Vm && v1: V1 in x86_64_linux.Vm &&
  holds: mallocng.holds_in(c, A, vm, b) && init: !(A.init_done = 0) && empty: A.reserve_cnt = 0 &&
  nat: (R2 in omega && K in omega && B in omega) && kpos: int_lt(0, K) && al: int_mod(R2, 4096) = 0 && pos: int_lt(0, R2) &&
  fresh: (all a. a in omega -> int_le(R2, a) -> int_lt(a, int_add(R2, int_mul(4096, K))) -> !x86_64_linux.mapped(vm, int_div(a, x86_64_linux.PAGE))) &&
  newpg: (all a. a in omega -> int_le(R2, a) -> int_lt(a, int_add(R2, int_mul(4096, K))) ->
     (mallocng.m_mapped(mallocng.mview(V1, mallocng.all_bytes()), a) && !(snd(mallocng.pg(mallocng.mview(V1, mallocng.all_bytes()), a)).kind = 2)) &&
     mallocng.b8(mallocng.mview(V1, mallocng.all_bytes()), a) = 0) &&
  pages: (all q. q in omega -> x86_64_linux.mapped(vm, q) -> V1.pages[q] = vm.pages[q]) &&
  bytes: (all y. y in bits(64) -> x86_64_linux.mapped(vm, int_div(y, x86_64_linux.PAGE)) -> !mp.rfbyte(c, y) -> V1.bytes[y] = vm.bytes[y]) &&
  rest: fn_update(fn_update(fn_update(V1, "bytes", vm.bytes), "pages", vm.pages), "brk", vm.brk) = vm &&
  brk: mallocng.brk_ok(mp.refill(A, R2, K, B), V1.brk) &&
  w40: gimple.bytes_at(V1, int_add(c.ctx, 40), 8) = K &&
  w48: int_le(gimple.bytes_at(V1, int_add(c.ctx, 48), 8), 34) &&
  w72: gimple.bytes_at(V1, int_add(c.ctx, 72), 8) = R2 &&
  w920: gimple.bytes_at(V1, int_add(c.ctx, 920), 8) = B

// (the new state's fixed ranges: the old ones and the new reserve)
theorem mp.rf_fixed(c, A, R2, K, B, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> A.reserve_cnt = 0 ->
  R2 in omega -> K in omega -> B in omega ->
  (mallocng.in_ranges(a, mallocng.fixed_ranges(c, mp.refill(A, R2, K, B))) <->
   mallocng.in_ranges(a, mallocng.fixed_ranges(c, A)) || mallocng.in_range(a, pair(R2, int_mul(4096, K))))
proof
  assume hc hu ha h0 hr hk hb
  have {ta = abs, tu = univ} := apply(mp.refill_type, ha, hr, hk, hb)
  have f1 := apply(mp.fixed_cases[c := c, A := A, a := a], hc, hu, ha)
  have f2 := apply(mp.fixed_cases[c := c, A := mp.refill(A, R2, K, B), a := a], hc, tu, ta)
  have ea: mallocng.auxv_ranges(mp.refill(A, R2, K, B)) = mallocng.auxv_ranges(A) by defs(simp(), mallocng.auxv_ranges)
  have ear: mp.refill(A, R2, K, B).areas = A.areas by simp()
  have er: mp.refill(A, R2, K, B).reserve = R2 by simp()
  have ek: mp.refill(A, R2, K, B).reserve_cnt = K by simp()
  have z: !mallocng.in_range(a, pair(A.reserve, int_mul(4096, A.reserve_cnt))) proof
    assume w
    have w1 w2 := (int_le(A.reserve, a) && int_lt(a, int_add(A.reserve, int_mul(4096, A.reserve_cnt))) by simp(expand(w, mallocng.in_range)))
    show by arith(w1, w2, h0)
  qed
  show by taut(f1, rewrite(ek, rewrite(er, rewrite(ear, rewrite(ea, f2)))), z)
qed

// (... its owned ranges too)
theorem mp.rf_fpr(c, A, R2, K, B, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> A.reserve_cnt = 0 ->
  R2 in omega -> K in omega -> B in omega ->
  (mallocng.in_ranges(a, mallocng.fp_ranges(c, mp.refill(A, R2, K, B))) <->
   mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) || mallocng.in_range(a, pair(R2, int_mul(4096, K))))
proof
  assume hc hu ha h0 hr hk hb
  have {ta = abs, tu = univ} := apply(mp.refill_type, ha, hr, hk, hb)
  have {g1 = groups} := apply(mp.fp_pieces, hc, hu, ha)
  have x1: mallocng.fixed_ranges(c, A) in list_type(univ(1)) by defs(apply(mp.pre_list, hc, hu, ha), mallocng.fixed_ranges)
  have x2: mallocng.fixed_ranges(c, mp.refill(A, R2, K, B)) in list_type(univ(1)) by defs(apply(mp.pre_list, hc, tu, ta), mallocng.fixed_ranges)
  let G := fn_build(int_sub(seq_len(A.used), 0), x0. mallocng.group_range(A.metas[A.used[int_add(0, x0)]]))
  let G2 := fn_build(int_sub(seq_len(mp.refill(A, R2, K, B).used), 0), x0. mallocng.group_range(mp.refill(A, R2, K, B).metas[mp.refill(A, R2, K, B).used[int_add(0, x0)]]))
  have eg: G2 = G by simp()
  have g2: G2 in list_type(univ(1)) := rewrite(sym(eg), g1)
  have gg := subst({y. mallocng.in_ranges(a, y) <-> mallocng.in_ranges(a, G)}, sym(eg), (mallocng.in_ranges(a, G) <-> mallocng.in_ranges(a, G) by taut()))
  have c1 := apply(mp.ranges_cat[a := a, xs := mallocng.fixed_ranges(c, A), ys := G], x1, g1)
  have c2 := apply(mp.ranges_cat[a := a, xs := mallocng.fixed_ranges(c, mp.refill(A, R2, K, B)), ys := G2], x2, g2)
  have fx := apply(mp.rf_fixed[c := c, A := A, R2 := R2, K := K, B := B, a := a], hc, hu, ha, h0, hr, hk, hb)
  have q: mallocng.in_ranges(a, seq_concat(mallocng.fixed_ranges(c, mp.refill(A, R2, K, B)), G2)) <->
      mallocng.in_ranges(a, seq_concat(mallocng.fixed_ranges(c, A), G)) || mallocng.in_range(a, pair(R2, int_mul(4096, K)))
    by taut(c1, c2, fx, gg)
  show by defs(q, mallocng.fp_ranges)
qed

// (the new state's owned and held bytes: the old ones and the new reserve)
theorem mp.rf_held(c, A, vm, V1, b, R2, K, B, a): mp.rfpre(c, A, vm, V1, b, R2, K, B) ->
  fp: (a in mallocng.footprint(c, mp.refill(A, R2, K, B), b) <-> a in mallocng.footprint(c, A, b) || (a in omega && int_le(R2, a) && int_lt(a, int_add(R2, int_mul(4096, K))))) &&
  held: (a in mallocng.held(c, mp.refill(A, R2, K, B), b) <-> a in mallocng.held(c, A, b) || (a in omega && int_le(R2, a) && int_lt(a, int_add(R2, int_mul(4096, K)))))
proof
  assume P
  let A2 := mp.refill(A, R2, K, B)
  have {hc = cfg, hu = univ, ha = abs, hb = blocks, hh = holds, h0 = empty, hn = nat, hfr = fresh} := P
  have hro hko hbo := hn
  have fpr := apply(mp.rf_fpr[c := c, A := A, R2 := R2, K := K, B := B, a := a], hc, hu, ha, h0, hro, hko, hbo)
  have em: A2.metas = A.metas by simp()
  have es: A2.slots = A.slots by simp()
  have eu: A2.used = A.used by simp()
  have et: A2.taken = A.taken by simp()
  have re := apply(mp.inres_fields[A := A, A2 := A2, a := a], em, es, eu)
  have te := apply(mp.taken_eq[A := A, A2 := A2, a := a], et)
  // (a byte of the new reserve: unmapped before, so no client's, reserved or taken one)
  have nw: a in omega && int_le(R2, a) && int_lt(a, int_add(R2, int_mul(4096, K))) ->
      !(a in malloc.live_of(b)) && !mallocng.in_reserved(A, a) && !mallocng.in_taken(A, a) && !mallocng.ctx_free(c, a) proof
    assume w
    have wo w1 w2 := w
    have um := mp(all_elim(hfr, {a}), wo, w1, w2)
    have {nl = live, nr = res, nt = taken, no = owned} := apply(mp.fresh_out[c := c, A := A, vm := vm, b := b, a := a], hc, hu, ha, hb, hh, wo, um)
    have nf: !mallocng.ctx_free(c, a) proof
      assume f
      have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
      have inc: int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE))
        by arith(expand(f, mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK), ks)
      have i1 i2 := inc
      have cf := apply(mp.ctx_fp[c := c, A := A, vm := vm, b := b, a := a], hc, hu, ha, hh, wo, i1, i2)
      have s1 := set_select_def[s := omega, p := y. y in mallocng.fp_set(mallocng.fp_ranges(c, A), b) && !mallocng.in_reserved(A, y) && !mallocng.in_taken(A, y), z := a]
      have s0 := set_select_def[s := omega, p := y. mallocng.in_ranges(y, mallocng.fp_ranges(c, A)) && !(y in malloc.live_of(b)), z := a]
      have q: mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) by taut(s1, s0, expand(cf, mallocng.footprint), (a in mallocng.fp_set(mallocng.fp_ranges(c, A), b) <-> a in omega && (mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) && !(a in malloc.live_of(b))) by defs(s0, mallocng.fp_set)))
      show by taut(no, q)
    qed
    show by taut(nl, nr, nt, nf)
  qed
  have s1 := set_select_def[s := omega, p := y. mallocng.in_ranges(y, mallocng.fp_ranges(c, A)) && !(y in malloc.live_of(b)), z := a]
  have s2 := set_select_def[s := omega, p := y. mallocng.in_ranges(y, mallocng.fp_ranges(c, A2)) && !(y in malloc.live_of(b)), z := a]
  have fs1: a in mallocng.fp_set(mallocng.fp_ranges(c, A), b) <-> a in omega && (mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) && !(a in malloc.live_of(b)))
    by defs(s1, mallocng.fp_set)
  have fs2: a in mallocng.fp_set(mallocng.fp_ranges(c, A2), b) <-> a in omega && (mallocng.in_ranges(a, mallocng.fp_ranges(c, A2)) && !(a in malloc.live_of(b)))
    by defs(s2, mallocng.fp_set)
  have f1 := set_select_def[s := omega, p := y. y in mallocng.fp_set(mallocng.fp_ranges(c, A), b) && !mallocng.in_reserved(A, y) && !mallocng.in_taken(A, y), z := a]
  have f2 := set_select_def[s := omega, p := y. y in mallocng.fp_set(mallocng.fp_ranges(c, A2), b) && !mallocng.in_reserved(A2, y) && !mallocng.in_taken(A2, y), z := a]
  have ir: mallocng.in_range(a, pair(R2, int_mul(4096, K))) <-> int_le(R2, a) && int_lt(a, int_add(R2, int_mul(4096, K))) by defs(simp(), mallocng.in_range)
  have fpe: a in mallocng.footprint(c, A2, b) <-> a in mallocng.footprint(c, A, b) || (a in omega && int_le(R2, a) && int_lt(a, int_add(R2, int_mul(4096, K))))
    by defs(taut(f1, f2, fs1, fs2, fpr, re, te, ir, nw), mallocng.footprint)
  have h1 := set_select_def[s := omega, p := y. y in mallocng.footprint(c, A, b) && !mallocng.ctx_free(c, y), z := a]
  have h2 := set_select_def[s := omega, p := y. y in mallocng.footprint(c, A2, b) && !mallocng.ctx_free(c, y), z := a]
  have he: a in mallocng.held(c, A2, b) <-> a in mallocng.held(c, A, b) || (a in omega && int_le(R2, a) && int_lt(a, int_add(R2, int_mul(4096, K))))
    by defs(taut(h1, h2, fpe, nw), mallocng.held)
  show by taut(fpe, he)
qed

// (a byte of the footprint: in the owned ranges)
theorem mp.fp_owned(c, A, b, a): a in mallocng.footprint(c, A, b) -> a in omega && mallocng.in_ranges(a, mallocng.fp_ranges(c, A))
proof
  assume h
  have f1 := set_select_def[s := omega, p := y. y in mallocng.fp_set(mallocng.fp_ranges(c, A), b) && !mallocng.in_reserved(A, y) && !mallocng.in_taken(A, y), z := a]
  have s1 := set_select_def[s := omega, p := y. mallocng.in_ranges(y, mallocng.fp_ranges(c, A)) && !(y in malloc.live_of(b)), z := a]
  have fs: a in mallocng.fp_set(mallocng.fp_ranges(c, A), b) <-> a in omega && (mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) && !(a in malloc.live_of(b)))
    by defs(s1, mallocng.fp_set)
  show by taut(f1, fs, expand(h, mallocng.footprint))
qed

// (an owned byte: not the new reserve's, mapped before)
theorem mp.rf_old(c, A, vm, V1, b, R2, K, B, a): mp.rfpre(c, A, vm, V1, b, R2, K, B) -> a in omega -> mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) ->
  mapped: x86_64_linux.mapped(vm, int_div(a, x86_64_linux.PAGE)) && old: !(int_le(R2, a) && int_lt(a, int_add(R2, int_mul(4096, K))))
proof
  assume P hao ir
  have {ha = abs, hb = blocks, hh = holds, hfr = fresh} := P
  have m := apply(mp.owned_mapped, ha, hb, hh, hao, ir)
  have n: !(int_le(R2, a) && int_lt(a, int_add(R2, int_mul(4096, K)))) proof
    assume w
    have w1 w2 := w
    show by taut(m, mp(all_elim(hfr, {a}), hao, w1, w2))
  qed
  show by taut(m, n)
qed

// (two views of memories at a: the same if a's byte and page are, when a is in the view)
theorem mp.view_agree2(vm, vm2, fp, a): a in omega -> (a in fp -> vm2.bytes[bits_of_int(64, a)] = vm.bytes[bits_of_int(64, a)]) ->
  (a in fp -> vm2.pages[int_div(a, x86_64_linux.PAGE)] = vm.pages[int_div(a, x86_64_linux.PAGE)]) -> mallocng.mview(vm2, fp)[a] = mallocng.mview(vm, fp)[a]
proof
  assume hao eb ep
  have a2 := mp(app_fn_build[d := omega, v := x. ite(x in fp, some(pair(vm2.bytes[bits_of_int(64, x)], vm2.pages[int_div(x, x86_64_linux.PAGE)])), none), a := a], hao)
  have a1 := mp(app_fn_build[d := omega, v := x. ite(x in fp, some(pair(vm.bytes[bits_of_int(64, x)], vm.pages[int_div(x, x86_64_linux.PAGE)])), none), a := a], hao)
  have c1: a in fp -> mallocng.mview(vm2, fp)[a] = mallocng.mview(vm, fp)[a] proof
    assume h
    show by defs(simp(a2, a1, mp(eb, h), mp(ep, h), h), mallocng.mview)
  qed
  have c2: !(a in fp) -> mallocng.mview(vm2, fp)[a] = mallocng.mview(vm, fp)[a] proof
    assume h
    show by defs(simp(a2, a1, h), mallocng.mview)
  qed
  show by taut(c1, c2)
qed

// a byte not of the new reserve, not written: as before in the view
theorem mp.rf_view(c, A, vm, V1, b, R2, K, B, a): mp.rfpre(c, A, vm, V1, b, R2, K, B) -> a in omega ->
  !(int_le(R2, a) && int_lt(a, int_add(R2, int_mul(4096, K)))) -> !mp.rfbyte(c, a) ->
  mallocng.mview(V1, mallocng.held(c, mp.refill(A, R2, K, B), b))[a] = mallocng.mview(vm, mallocng.held(c, A, b))[a]
proof
  assume P hao nn nw
  have {hh = holds, hpg = pages, hby = bytes} := P
  have {hm = mapped} := expand(hh, mallocng.holds_in)
  have {hl = held} := apply(mp.rf_held[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, a := a], P)
  have hs: a in mallocng.held(c, mp.refill(A, R2, K, B), b) <-> a in mallocng.held(c, A, b) by taut(hl, nn)
  have e1 := apply(mp.view_mem[vm := V1, F1 := mallocng.held(c, mp.refill(A, R2, K, B), b), F2 := mallocng.held(c, A, b), a := a], hao, hs)
  have mp1: a in mallocng.held(c, A, b) -> x86_64_linux.mapped(vm, int_div(a, x86_64_linux.PAGE)) proof
    assume hf
    have {hff = fp} := apply(mp.held_fp, hf)
    have _ ir := apply(mp.fp_owned, hff)
    have {m = mapped} := apply(mp.rf_old[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, a := a], P, hao, ir)
    show := m
  qed
  have bt: a in mallocng.held(c, A, b) -> V1.bytes[bits_of_int(64, a)] = vm.bytes[bits_of_int(64, a)] proof
    assume hf
    have {hff = fp} := apply(mp.held_fp, hf)
    have lo := apply(mp.fp_low[c := c, A := A, vm := vm, b := b, a := a], hm, hff)
    have e: bits_of_int(64, a) = a by defs(arith(hao, lo), bits_of_int, pow2)
    have ab: a in bits(64) by arith(hao, lo)
    show := rewrite(sym(e), mp(all_elim(hby, {a}), ab, mp(mp1, hf), nw))
  qed
  have kp: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
  have pt: a in mallocng.held(c, A, b) -> V1.pages[int_div(a, x86_64_linux.PAGE)] = vm.pages[int_div(a, x86_64_linux.PAGE)] proof
    assume hf
    show := mp(all_elim(hpg, {int_div(a, x86_64_linux.PAGE)}), (int_div(a, x86_64_linux.PAGE) in omega by arith(kp, hao)), mp(mp1, hf))
  qed
  have e2 := apply(mp.view_agree2[vm := vm, vm2 := V1, fp := mallocng.held(c, A, b), a := a], hao, bt, pt)
  show := trans(e1, e2)
qed

// an owned byte: its page as before in the view
theorem mp.rf_pgeq(c, A, vm, V1, b, R2, K, B, a): mp.rfpre(c, A, vm, V1, b, R2, K, B) -> a in omega -> mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) ->
  mallocng.pg(mallocng.mview(V1, mallocng.held(c, mp.refill(A, R2, K, B), b)), a) = mallocng.pg(mallocng.mview(vm, mallocng.held(c, A, b)), a)
proof
  assume P hao ir
  have {hpg = pages} := P
  have {m = mapped, nn = old} := apply(mp.rf_old[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, a := a], P, hao, ir)
  have {hl = held} := apply(mp.rf_held[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, a := a], P)
  have hs: a in mallocng.held(c, mp.refill(A, R2, K, B), b) <-> a in mallocng.held(c, A, b) by taut(hl, nn)
  have e1 := apply(mp.view_mem[vm := V1, F1 := mallocng.held(c, mp.refill(A, R2, K, B), b), F2 := mallocng.held(c, A, b), a := a], hao, hs)
  have kp: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
  have ep := mp(all_elim(hpg, {int_div(a, x86_64_linux.PAGE)}), (int_div(a, x86_64_linux.PAGE) in omega by arith(kp, hao)), m)
  have e2 := apply(mp.view_pg1[vm := vm, vm2 := V1, fp := mallocng.held(c, A, b), a := a], hao, ep)
  have e1p: mallocng.pg(mallocng.mview(V1, mallocng.held(c, mp.refill(A, R2, K, B), b)), a) = mallocng.pg(mallocng.mview(V1, mallocng.held(c, A, b)), a)
    by defs(simp(e1), mallocng.pg)
  show := trans(e1p, e2)
qed

// (a context byte: owned)
theorem mp.rf_ctxown(c, A, vm, V1, b, R2, K, B, a): mp.rfpre(c, A, vm, V1, b, R2, K, B) -> a in omega -> int_le(c.ctx, a) -> int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE)) ->
  mallocng.in_ranges(a, mallocng.fp_ranges(c, A))
proof
  assume P hao h1 h2
  have {hc = cfg, hu = univ, ha = abs, hh = holds} := P
  have cf := apply(mp.ctx_fp[c := c, A := A, vm := vm, b := b, a := a], hc, hu, ha, hh, hao, h1, h2)
  have _ ir := apply(mp.fp_owned, cf)
  show := ir
qed

// (a context word not written: as before)
theorem mp.rf_cw(c, A, vm, V1, b, R2, K, B, off): mp.rfpre(c, A, vm, V1, b, R2, K, B) -> off in omega -> int_le(int_add(off, 8), mallocng.CTX_SIZE) ->
  (int_le(int_add(off, 8), 40) || (int_le(56, off) && int_le(int_add(off, 8), 72)) || (int_le(80, off) && int_le(int_add(off, 8), 920))) ->
  mallocng.ctx_word(c, mallocng.mview(V1, mallocng.held(c, mp.refill(A, R2, K, B), b)), off) = mallocng.ctx_word(c, mallocng.mview(vm, mallocng.held(c, A, b)), off)
proof
  assume P ho hl hw
  have {hc = cfg} := P
  have co: c.ctx in omega by simp(hc)
  have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  have ai: all i. i in omega -> int_lt(i, 8) -> mallocng.mview(V1, mallocng.held(c, mp.refill(A, R2, K, B), b))[int_add(int_add(c.ctx, off), i)] =
      mallocng.mview(vm, mallocng.held(c, A, b))[int_add(int_add(c.ctx, off), i)] proof
    fix i
    assume hi hil
    let a := int_add(int_add(c.ctx, off), i)
    have ao: a in omega by arith(co, ho, hi)
    have ir := apply(mp.rf_ctxown[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, a := a], P, ao, arith(co, ho, hi), arith(co, ho, hi, hil, hl))
    have {nn = old} := apply(mp.rf_old[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, a := a], P, ao, ir)
    have nw: !mp.rfbyte(c, a) by defs(arith(hw, hi, hil, ho, co), mp.rfbyte)
    show := apply(mp.rf_view[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, a := a], P, ao, nn, nw)
  qed
  show by defs(apply(mp.agree_rd, simp(), ai), mallocng.ctx_word)
qed

// (a context word written: its value in the new view)
theorem mp.rf_cwr(c, A, vm, V1, b, R2, K, B, off): mp.rfpre(c, A, vm, V1, b, R2, K, B) -> off in omega ->
  ((int_le(16, off) && int_le(int_add(off, 8), 464)) || off = 920) ->
  gimple.bytes_at(V1, int_add(c.ctx, off), 8) = mallocng.rd(mallocng.mview(V1, mallocng.held(c, mp.refill(A, R2, K, B), b)), int_add(c.ctx, off), 8)
proof
  assume P ho hr
  have {hc = cfg, hu = univ, ha = abs, hh = holds} := P
  have co: c.ctx in omega by simp(hc)
  have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  have hd: all i. i in omega -> int_lt(i, 8) -> int_add(int_add(c.ctx, off), i) in mallocng.held(c, mp.refill(A, R2, K, B), b) proof
    fix i
    assume hi hil
    let a := int_add(int_add(c.ctx, off), i)
    have nf: !mallocng.ctx_free(c, a) by defs(arith(hi, hil, co, ho, hr), mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK)
    have q _ _ := apply(mp.ctx_acc[c := c, A := A, vm := vm, b := b, a := a], hc, hu, ha, hh, arith(co, ho, hi), arith(co, ho, hi), arith(co, ks, ho, hi, hil, hr), nf)
    have {hl = held} := apply(mp.rf_held[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, a := a], P)
    show by taut(hl, q)
  qed
  show := apply(mp.view_read[vm := V1, fp := mallocng.held(c, mp.refill(A, R2, K, B), b), a := int_add(c.ctx, off), n := 8], arith(co, ho), simp(), simp(), hd)
qed

// (a byte of a meta slot not taken: as before)
theorem mp.rf_meta(c, A, vm, V1, b, R2, K, B, g, a): mp.rfpre(c, A, vm, V1, b, R2, K, B) -> mallocng.meta_slot(A, g) -> mp.untaken(A, g) ->
  a in omega -> int_le(g, a) -> int_lt(a, int_add(g, 40)) ->
  mallocng.mview(V1, mallocng.held(c, mp.refill(A, R2, K, B), b))[a] = mallocng.mview(vm, mallocng.held(c, A, b))[a]
proof
  assume P hg hnt hao h1 h2
  have {hc = cfg, hu = univ, ha = abs, hh = holds} := P
  have {go = nat, acc = acc, out = out} := apply(mp.slot_meta[c := c, A := A, vm := vm, b := b, g := g], hc, hu, ha, hh, hg, hnt)
  have hd _ _ := mp(all_elim(acc, {a}), hao, h1, h2)
  have {hff = fp} := apply(mp.held_fp, hd)
  have _ ir := apply(mp.fp_owned, hff)
  have {nn = old} := apply(mp.rf_old[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, a := a], P, hao, ir)
  have co: c.ctx in omega by simp(hc)
  have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  have nw: !mp.rfbyte(c, a) by defs(arith(out, ks, h1, h2, co), mp.rfbyte)
  show := apply(mp.rf_view[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, a := a], P, hao, nn, nw)
qed

// (a byte of a meta area: owned, not the context's)
theorem mp.rf_area(c, A, vm, V1, b, R2, K, B, k, a): mp.rfpre(c, A, vm, V1, b, R2, K, B) -> k in omega -> int_lt(k, seq_len(A.areas)) -> a in omega ->
  int_le(A.areas[k], a) -> int_lt(a, int_add(A.areas[k], 4096)) ->
  own: mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) &&
  view: mallocng.mview(V1, mallocng.held(c, mp.refill(A, R2, K, B), b))[a] = mallocng.mview(vm, mallocng.held(c, A, b))[a]
proof
  assume P hk hkl hao h1 h2
  have {hc = cfg, hu = univ, ha = abs, hh = holds} := P
  have {H = inv} := expand(hh, mallocng.holds_in)
  have fx := apply(mp.area_fixed[c := c, A := A, k := k, a := a], hc, hu, ha, hk, hkl, h1, h2)
  have {p6 = groups} := apply(mp.fp_pieces, hc, hu, ha)
  have x1: mallocng.fixed_ranges(c, A) in list_type(univ(1)) by defs(apply(mp.pre_list, hc, hu, ha), mallocng.fixed_ranges)
  have ir: mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) by defs(apply(mp.ranges_l, x1, p6, fx), mallocng.fp_ranges)
  have {nn = old} := apply(mp.rf_old[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, a := a], P, hao, ir)
  have {d = data} := apply(mp.area_apart[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, brk := vm.brk, k := k, a := a], hc, hu, ha, H, hk, hkl, hao, h1, h2)
  have d0 _ _ := mp.data_at[c := c]
  have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  have nc: !(int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, 928))) by simp(expand(rewrite(d0, mp(all_elim(d, {0}), simp(), simp())), mallocng.in_range), ks)
  have co: c.ctx in omega by simp(hc)
  have nw: !mp.rfbyte(c, a) by defs(arith(nc, co), mp.rfbyte)
  show by taut(ir, apply(mp.rf_view[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, a := a], P, hao, nn, nw))
qed

// (a byte of the new reserve: held, mapped, not the stack, zero)
theorem mp.rf_newb(c, A, vm, V1, b, R2, K, B, a): mp.rfpre(c, A, vm, V1, b, R2, K, B) -> a in omega -> int_le(R2, a) -> int_lt(a, int_add(R2, int_mul(4096, K))) ->
  mallocng.m_mapped(mallocng.mview(V1, mallocng.held(c, mp.refill(A, R2, K, B), b)), a) &&
  !(snd(mallocng.pg(mallocng.mview(V1, mallocng.held(c, mp.refill(A, R2, K, B), b)), a)).kind = 2) &&
  mallocng.b8(mallocng.mview(V1, mallocng.held(c, mp.refill(A, R2, K, B), b)), a) = 0
proof
  assume P hao h1 h2
  have {hv1 = v1, hnp = newpg} := P
  have {hl = held} := apply(mp.rf_held[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, a := a], P)
  have hn: a in mallocng.held(c, mp.refill(A, R2, K, B), b) by taut(hl, hao, h1, h2)
  have ab: a in mallocng.all_bytes() by defs(sel(taut(hao)), mallocng.all_bytes)
  have p1 := apply(mp.pg_view[vm := V1, fp := mallocng.held(c, mp.refill(A, R2, K, B), b), a := a], hao, hn)
  have p0 := apply(mp.pg_view[vm := V1, fp := mallocng.all_bytes(), a := a], hao, ab)
  have ep: mallocng.pg(mallocng.mview(V1, mallocng.held(c, mp.refill(A, R2, K, B), b)), a) = mallocng.pg(mallocng.mview(V1, mallocng.all_bytes()), a) := trans(p1, sym(p0))
  have vb: V1.bytes in fn_space(bits(64), bits(8)) by simp(hv1)
  have b1 _ := apply(mp.b8_view[vm := V1, fp := mallocng.held(c, mp.refill(A, R2, K, B), b), a := a], vb, hao, hn)
  have b0 _ := apply(mp.b8_view[vm := V1, fp := mallocng.all_bytes(), a := a], vb, hao, ab)
  have m0 k0 z0 := mp(all_elim(hnp, {a}), hao, h1, h2)
  have {mm = mapped} := apply(mp.pg_same, ep)
  show by taut(mm, m0, rewrite(sym(ep), k0), trans(trans(b1, sym(b0)), z0))
qed

// the context for the new state: the area count, reserve and break words
// as given, the shift within bounds, the others as before
theorem mp.rf_ctx(c, A, vm, V1, b, R2, K, B): mp.rfpre(c, A, vm, V1, b, R2, K, B) ->
  mallocng.ctx_ok(c, mp.refill(A, R2, K, B), mallocng.mview(V1, mallocng.held(c, mp.refill(A, R2, K, B), b)))
proof
  assume P
  let A2 := mp.refill(A, R2, K, B)
  let M := mallocng.mview(vm, mallocng.held(c, A, b))
  let M2 := mallocng.mview(V1, mallocng.held(c, A2, b))
  have {hc = cfg, hu = univ, ha = abs, hh = holds, ral = al, x40 = w40, x48 = w48, x72 = w72, x920 = w920} := P
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {cok = ctx, hpt = part, hac = active} := expand(H, mallocng.holds)
  have {c1 = secret, c2 = init, c3 = init_lt, c4 = avail_cnt, c5 = avail_le, c6 = avail_meta, c10 = free_metas, c11 = nactive, c12 = active} := expand(cok, mallocng.ctx_ok)
  have {fs = free_slots} := expand(hpt, mallocng.metas_partition)
  have co: c.ctx in omega by simp(hc)
  have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  have cv: (((((mallocng.C_SECRET = 0 && mallocng.C_INIT_DONE = 8) && mallocng.C_FREE_META = 16) && mallocng.C_ACTIVE = 80) && mallocng.C_AVAIL_META = 24) &&
    mallocng.C_AVAIL_CNT = 32)
    by defs(simp(), mallocng.C_SECRET, mallocng.C_INIT_DONE, mallocng.C_FREE_META, mallocng.C_ACTIVE, mallocng.C_AVAIL_META, mallocng.C_AVAIL_CNT)
  have v0 v8 v16 v80 v24 v32 := cv
  have cw: ((mallocng.C_AREA_CNT = 40 && mallocng.C_AVAIL_AREAS = 72) && mallocng.C_BRK = 920) && mallocng.C_META_SHIFT = 48
    by defs(simp(), mallocng.C_AREA_CNT, mallocng.C_AVAIL_AREAS, mallocng.C_BRK, mallocng.C_META_SHIFT)
  have v40 v72 v920 v48 := cw
  have w0 := apply(mp.rf_cw[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, off := mallocng.C_SECRET], P, simp(v0), arith(v0, ks), arith(v0))
  have w16 := apply(mp.rf_cw[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, off := mallocng.C_FREE_META], P, simp(v16), arith(v16, ks), arith(v16))
  have w24 := apply(mp.rf_cw[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, off := mallocng.C_AVAIL_META], P, simp(v24), arith(v24, ks), arith(v24))
  have w32 := apply(mp.rf_cw[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, off := mallocng.C_AVAIL_CNT], P, simp(v32), arith(v32, ks), arith(v32))
  have i4: all i. i in omega -> int_lt(i, 4) -> M2[int_add(int_add(c.ctx, mallocng.C_INIT_DONE), i)] = M[int_add(int_add(c.ctx, mallocng.C_INIT_DONE), i)] proof
    fix i
    assume hi hil
    let a := int_add(int_add(c.ctx, mallocng.C_INIT_DONE), i)
    have ao: a in omega by arith(co, v8, hi)
    have ir := apply(mp.rf_ctxown[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, a := a], P, ao, arith(co, v8, hi), arith(co, v8, hi, hil, ks))
    have {nn = old} := apply(mp.rf_old[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, a := a], P, ao, ir)
    have nw: !mp.rfbyte(c, a) by defs(arith(co, v8, hi, hil), mp.rfbyte)
    show := apply(mp.rf_view[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, a := a], P, ao, nn, nw)
  qed
  have r4 := apply(mp.agree_rd, simp(), i4)
  have k1: mallocng.ctx_word(c, M2, mallocng.C_SECRET) = A2.secret := trans(trans(w0, c1), (A.secret = A2.secret by simp()))
  have k2: mallocng.rd(M2, int_add(c.ctx, mallocng.C_INIT_DONE), 4) = A2.init_done := trans(trans(r4, c2), (A.init_done = A2.init_done by simp()))
  have k3: int_lt(A2.init_done, 2) by simp(c3)
  have k4: mallocng.ctx_word(c, M2, mallocng.C_AVAIL_CNT) = A2.avail_cnt := trans(trans(w32, c4), (A.avail_cnt = A2.avail_cnt by simp()))
  have k5: int_le(A2.avail_cnt, mallocng.NSLOTS) by simp(c5)
  have k6: int_lt(0, A2.avail_cnt) -> ord_lt(0, seq_len(A2.areas)) &&
      mallocng.ctx_word(c, M2, mallocng.C_AVAIL_META) = mallocng.meta_at(A2.areas[int_sub(seq_len(A2.areas), 1)], int_sub(mallocng.NSLOTS, A2.avail_cnt))
    by simp(rewrite(sym(w24), c6))
  // the words written
  have q40 := apply(mp.rf_cwr[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, off := 40], P, simp(), arith())
  have q72 := apply(mp.rf_cwr[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, off := 72], P, simp(), arith())
  have q920 := apply(mp.rf_cwr[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, off := 920], P, simp(), arith())
  have q48 := apply(mp.rf_cwr[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, off := 48], P, simp(), arith())
  have k7: mallocng.ctx_word(c, M2, mallocng.C_AREA_CNT) = A2.reserve_cnt by defs(simp(trans(sym(q40), x40)), mallocng.ctx_word, mallocng.C_AREA_CNT)
  have k8: int_lt(0, A2.reserve_cnt) -> mallocng.ctx_word(c, M2, mallocng.C_AVAIL_AREAS) = A2.reserve && int_mod(A2.reserve, 4096) = 0 proof
    assume _
    have e: mallocng.ctx_word(c, M2, mallocng.C_AVAIL_AREAS) = A2.reserve by defs(simp(trans(sym(q72), x72)), mallocng.ctx_word, mallocng.C_AVAIL_AREAS)
    show by taut(e, (int_mod(A2.reserve, 4096) = 0 by simp(ral)))
  qed
  have k9: mallocng.ctx_word(c, M2, mallocng.C_BRK) = A2.brk by defs(simp(trans(sym(q920), x920)), mallocng.ctx_word, mallocng.C_BRK)
  // the free metas' list: its metas' links as before
  have fl: all i. i in omega -> int_lt(i, seq_len(A.free_metas)) ->
      mallocng.rd(M2, int_add(A.free_metas[i], 8), 8) = mallocng.rd(M, int_add(A.free_metas[i], 8), 8) &&
      mallocng.rd(M2, A.free_metas[i], 8) = mallocng.rd(M, A.free_metas[i], 8) proof
    fix i
    assume hi hil
    have ms _ := mp(all_elim(fs, {i}), hi, hil)
    have nt := apply(mp.free_untaken, H, hi, hil)
    have {go = nat} := apply(mp.meta_page, ha, ms)
    have a8: all j. j in omega -> int_lt(j, 8) -> M2[int_add(int_add(A.free_metas[i], 8), j)] = M[int_add(int_add(A.free_metas[i], 8), j)] proof
      fix j
      assume hj hjl
      show := apply(mp.rf_meta[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, g := A.free_metas[i], a := int_add(int_add(A.free_metas[i], 8), j)],
        P, ms, nt, arith(go, hj), arith(go, hj), arith(go, hj, hjl))
    qed
    have a0: all j. j in omega -> int_lt(j, 8) -> M2[int_add(A.free_metas[i], j)] = M[int_add(A.free_metas[i], j)] proof
      fix j
      assume hj hjl
      show := apply(mp.rf_meta[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, g := A.free_metas[i], a := int_add(A.free_metas[i], j)],
        P, ms, nt, arith(go, hj), arith(go, hj), arith(go, hj, hjl))
    qed
    show by taut(apply(mp.agree_rd, simp(), a8), apply(mp.agree_rd[M := M, M2 := M2, a := A.free_metas[i], n := 8], simp(), a0))
  qed
  have cf := apply(mp.cyclic_agree[M := M, M2 := M2, hd := mallocng.ctx_word(c, M2, mallocng.C_FREE_META), l := A.free_metas], rewrite(sym(w16), c10), fl)
  have k10: mallocng.cyclic(M2, mallocng.ctx_word(c, M2, mallocng.C_FREE_META), A2.free_metas) by simp(cf)
  have k11: seq_len(A2.active) = 48 by simp(c11)
  have k12: all x0. x0 in omega -> int_lt(x0, 48) -> mallocng.cyclic(M2, mallocng.ctx_word(c, M2, int_add(mallocng.C_ACTIVE, int_mul(8, x0))), A2.active[x0]) proof
    fix sc
    assume hs hsl
    have wa := apply(mp.rf_cw[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, off := int_add(mallocng.C_ACTIVE, int_mul(8, sc))], P, simp(v80, hs),
      arith(v80, ks, hs, hsl), arith(v80, hs, hsl))
    have al2: all i. i in omega -> int_lt(i, seq_len(A.active[sc])) ->
        mallocng.rd(M2, int_add(A.active[sc][i], 8), 8) = mallocng.rd(M, int_add(A.active[sc][i], 8), 8) &&
        mallocng.rd(M2, A.active[sc][i], 8) = mallocng.rd(M, A.active[sc][i], 8) proof
      fix i
      assume hi hil
      have iu _ _ := mp(all_elim(expand(hac, mallocng.active_ok), {sc}, {i}), conj(hs, hi), conj(hsl, hil))
      have ms := apply(mp.used_slot, H, iu)
      have nt := apply(mp.used_untaken, H, iu)
      have {go = nat} := apply(mp.used_nat, ha, iu)
      have a8: all j. j in omega -> int_lt(j, 8) -> M2[int_add(int_add(A.active[sc][i], 8), j)] = M[int_add(int_add(A.active[sc][i], 8), j)] proof
        fix j
        assume hj hjl
        show := apply(mp.rf_meta[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, g := A.active[sc][i], a := int_add(int_add(A.active[sc][i], 8), j)],
          P, ms, nt, arith(go, hj), arith(go, hj), arith(go, hj, hjl))
      qed
      have a0: all j. j in omega -> int_lt(j, 8) -> M2[int_add(A.active[sc][i], j)] = M[int_add(A.active[sc][i], j)] proof
        fix j
        assume hj hjl
        show := apply(mp.rf_meta[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, g := A.active[sc][i], a := int_add(A.active[sc][i], j)],
          P, ms, nt, arith(go, hj), arith(go, hj), arith(go, hj, hjl))
      qed
      show by taut(apply(mp.agree_rd, simp(), a8), apply(mp.agree_rd[M := M, M2 := M2, a := A.active[sc][i], n := 8], simp(), a0))
    qed
    have cy := apply(mp.cyclic_agree[M := M, M2 := M2, hd := mallocng.ctx_word(c, M2, int_add(mallocng.C_ACTIVE, int_mul(8, sc))), l := A.active[sc]],
      rewrite(sym(wa), mp(all_elim(c12, {sc}), hs, hsl)), al2)
    show by simp(cy)
  qed
  have k13: int_le(mallocng.ctx_word(c, M2, mallocng.C_META_SHIFT), 34) by defs(simp(rewrite(q48, x48)), mallocng.ctx_word, mallocng.C_META_SHIFT)
  show by defs(taut(k1, k2, k3, k4, k5, k6, k7, k8, k9, k10, k11, k12, k13), mallocng.ctx_ok)
qed

// the meta areas for the new state: as before; the new reserve mapped,
// not the stack, zero
theorem mp.rf_areas(c, A, vm, V1, b, R2, K, B): mp.rfpre(c, A, vm, V1, b, R2, K, B) ->
  mallocng.areas_ok(c, mp.refill(A, R2, K, B), mallocng.mview(V1, mallocng.held(c, mp.refill(A, R2, K, B), b)))
proof
  assume P
  let A2 := mp.refill(A, R2, K, B)
  let M := mallocng.mview(vm, mallocng.held(c, A, b))
  let M2 := mallocng.mview(V1, mallocng.held(c, A2, b))
  have {hc = cfg, hu = univ, ha = abs, hh = holds} := P
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {har = areas} := expand(H, mallocng.holds)
  have {ah = head, at = tail, ae = each, ad = distinct} := expand(har, mallocng.areas_ok)
  have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  have vh vt := (mallocng.C_AREA_HEAD = 56 && mallocng.C_AREA_TAIL = 64 by defs(simp(), mallocng.C_AREA_HEAD, mallocng.C_AREA_TAIL))
  have wh := rewrite(sym(vh), apply(mp.rf_cw[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, off := 56], P, simp(), arith(ks), arith()))
  have wt := rewrite(sym(vt), apply(mp.rf_cw[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, off := 64], P, simp(), arith(ks), arith()))
  have rl: A.areas in list_type(omega) by simp(ha)
  have et: A2.taken = A.taken by simp()
  have ae2: all x0. x0 in omega -> int_lt(x0, seq_len(A.areas)) ->
      ((((((int_mod(A.areas[x0], 4096) = 0 && int_lt(0, A.areas[x0])) && mallocng.rd(M2, A.areas[x0], 8) = A.secret) &&
        mallocng.rd(M2, int_add(A.areas[x0], 8), 8) = ite(int_lt(int_add(x0, 1), seq_len(A.areas)), A.areas[int_add(x0, 1)], 0)) &&
        mallocng.rd(M2, int_add(A.areas[x0], 16), 4) = mallocng.NSLOTS) &&
        (all x1. x1 in omega -> (int_le(A.areas[x0], x1) && int_lt(x1, int_add(A.areas[x0], 4096))) && !mallocng.in_taken(A2, x1) ->
           mallocng.m_rw(M2, x1) && !(snd(mallocng.pg(M2, x1)).kind = 2)))) proof
    fix k
    assume hk hkl
    have e1 e2 e3 e4 e5 e6 := mp(all_elim(ae, {k}), hk, hkl)
    have ako := mp(at_type[l := A.areas, t := omega, i := k], rl, hk, hkl)
    have hb: all o. all m. o in omega -> m in omega -> int_le(int_add(o, m), 24) ->
        mallocng.rd(M2, int_add(A.areas[k], o), m) = mallocng.rd(M, int_add(A.areas[k], o), m) proof
      fix o m
      assume ho hm hl
      have ai: all j. j in omega -> int_lt(j, m) -> M2[int_add(int_add(A.areas[k], o), j)] = M[int_add(int_add(A.areas[k], o), j)] proof
        fix j
        assume hj hjl
        have {v = view} := apply(mp.rf_area[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, k := k, a := int_add(int_add(A.areas[k], o), j)],
          P, hk, hkl, simp(ako, ho, hj), arith(ako, ho, hj), arith(ako, ho, hj, hjl, hl))
        show := v
      qed
      show := apply(mp.agree_rd, hm, ai)
    qed
    have r0 := rewrite((int_add(A.areas[k], 0) = A.areas[k] by arith(ako)), mp(all_elim(hb, {0}, {8}), simp(), simp(), simp()))
    have r8 := mp(all_elim(hb, {8}, {8}), simp(), simp(), simp())
    have r16 := mp(all_elim(hb, {16}, {4}), simp(), simp(), simp())
    have p6: all x1. x1 in omega -> (int_le(A.areas[k], x1) && int_lt(x1, int_add(A.areas[k], 4096))) && !mallocng.in_taken(A2, x1) ->
        mallocng.m_rw(M2, x1) && !(snd(mallocng.pg(M2, x1)).kind = 2) proof
      fix y
      assume hy hyr
      have yr1 yr2 nt := hyr
      have nt1: !mallocng.in_taken(A, y) by taut(apply(mp.taken_eq[A := A, A2 := A2, a := y], et), nt)
      have {own = own} := apply(mp.rf_area[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, k := k, a := y], P, hk, hkl, hy, yr1, yr2)
      have pe := apply(mp.rf_pgeq[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, a := y], P, hy, own)
      have {rw = rw} := apply(mp.pg_same, pe)
      have o1 o2 := mp(all_elim(e6, {y}), hy, conj(conj(yr1, yr2), nt1))
      show by taut(rw, o1, rewrite(sym(pe), o2))
    qed
    show by taut(e1, e2, rewrite(sym(r0), e3), rewrite(sym(r8), e4), rewrite(sym(r16), e5), p6)
  qed
  have ar2: all x0. x0 in omega -> int_le(A2.reserve, x0) && int_lt(x0, int_add(A2.reserve, int_mul(4096, A2.reserve_cnt))) ->
      mallocng.m_mapped(M2, x0) && !(snd(mallocng.pg(M2, x0)).kind = 2) && mallocng.b8(M2, x0) = 0 proof
    fix y
    assume hy hyr
    have y1 y2 := (int_le(R2, y) && int_lt(y, int_add(R2, int_mul(4096, K))) by simp(hyr))
    show := apply(mp.rf_newb[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, a := y], P, hy, y1, y2)
  qed
  show by defs(simp(rewrite(sym(wh), ah), rewrite(sym(wt), at), ae2, ad, ar2), mallocng.areas_ok)
qed

// (a byte of a page mapped before: its page as before in the view)
theorem mp.rf_pgm(c, A, vm, V1, b, R2, K, B, a): mp.rfpre(c, A, vm, V1, b, R2, K, B) -> a in omega -> x86_64_linux.mapped(vm, int_div(a, x86_64_linux.PAGE)) ->
  mallocng.pg(mallocng.mview(V1, mallocng.held(c, mp.refill(A, R2, K, B), b)), a) = mallocng.pg(mallocng.mview(vm, mallocng.held(c, A, b)), a)
proof
  assume P hao m
  have {hpg = pages, hfr = fresh} := P
  have nn: !(int_le(R2, a) && int_lt(a, int_add(R2, int_mul(4096, K)))) proof
    assume w
    have w1 w2 := w
    show by taut(m, mp(all_elim(hfr, {a}), hao, w1, w2))
  qed
  have {hl = held} := apply(mp.rf_held[c := c, A := A, vm := vm, V1 := V1, b := b, R2 := R2, K := K, B := B, a := a], P)
  have hs: a in mallocng.held(c, mp.refill(A, R2, K, B), b) <-> a in mallocng.held(c, A, b) by taut(hl, nn)
  have e1 := apply(mp.view_mem[vm := V1, F1 := mallocng.held(c, mp.refill(A, R2, K, B), b), F2 := mallocng.held(c, A, b), a := a], hao, hs)
  have kp: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
  have ep := mp(all_elim(hpg, {int_div(a, x86_64_linux.PAGE)}), (int_div(a, x86_64_linux.PAGE) in omega by arith(kp, hao)), m)
  have e2 := apply(mp.view_pg1[vm := vm, vm2 := V1, fp := mallocng.held(c, A, b), a := a], hao, ep)
  have e1p: mallocng.pg(mallocng.mview(V1, mallocng.held(c, mp.refill(A, R2, K, B), b)), a) = mallocng.pg(mallocng.mview(V1, mallocng.held(c, A, b)), a)
    by defs(simp(e1), mallocng.pg)
  show := trans(e1p, e2)
qed

// (a byte of region k: owned)
theorem mp.reg_own(c, A, k, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> k in omega -> int_lt(k, seq_len(mallocng.regions(c, A))) ->
  mallocng.in_range(a, mallocng.regions(c, A)[k]) -> mallocng.in_ranges(a, mallocng.fp_ranges(c, A))
proof
  assume hc hu ha hk hkl hr
  have ir: mallocng.in_ranges(a, mallocng.regions(c, A)) by defs(ex_intro({k}, taut(hk, hkl, hr)), mallocng.in_ranges)
  show := apply(mp.regions_fp, hc, hu, ha, ir)
qed

// (a group's byte: owned, not the context's)
theorem mp.grp_own(c, A, M, b, brk, g, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds(c, A, M, b, brk) ->
  mallocng.is_used(A, g) -> a in omega -> mallocng.in_range(a, mallocng.group_range(A.metas[g])) ->
  own: mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) && nctx: !(int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, 928)))
proof
  assume hc hu ha H iu hao hr
  have {p6 = groups} := apply(mp.fp_pieces, hc, hu, ha)
  have x1: mallocng.fixed_ranges(c, A) in list_type(univ(1)) by defs(apply(mp.pre_list, hc, hu, ha), mallocng.fixed_ranges)
  obtain k, hk hkl hke from expand(iu, mallocng.is_used)
  have ul: A.used in list_type(omega) by simp(ha)
  have ir2 := apply(mp.ranges_build[r := x. mallocng.group_range(A.metas[A.used[x]])], (seq_len(A.used) in omega by arith(ul)), hk, hkl, rewrite(sym(hke), hr))
  have ow: mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) by defs(apply(mp.ranges_r, x1, p6, ir2), mallocng.fp_ranges)
  have g := (ex h. mallocng.is_used(A, h) && mallocng.in_range(a, mallocng.group_range(A.metas[h])) by ex_intro({g}, taut(iu, hr)))
  have nc := apply(mp.not_ctx[c := c, A := A, M := M, b := b, brk := brk, a := a], hc, hu, ha, H, hao, taut(g))
  have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  show by taut(ow, (!(int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, 928))) by simp(expand(nc, mallocng.in_range), ks)))
qed

// (the list X, r, Q: X's elements and Q's)
theorem mp.at_front(X, r, Q, t, i): X in list_type(t) -> Q in list_type(t) -> i in omega -> int_lt(i, seq_len(X)) ->
  seq_concat(seq_concat(X, seq_one(r)), Q)[i] = X[i]
proof
  assume hx hq hi hil
  show := at({seq_concat(seq_concat(X, seq_one(r)), Q)[i]}, hx, hq, hi, hil)
qed

theorem mp.at_back(X, r, Q, t, i): X in list_type(t) -> Q in list_type(t) -> i in omega -> int_lt(i, seq_len(Q)) ->
  seq_concat(seq_concat(X, seq_one(r)), Q)[int_add(int_add(1, seq_len(X)), i)] = Q[i]
proof
  assume hx hq hi hil
  have xo: seq_len(X) in omega by arith(hx)
  have e := at({seq_concat(seq_concat(X, seq_one(r)), Q)[int_add(int_add(1, seq_len(X)), i)]}, hx, hq, (int_add(int_add(1, seq_len(X)), i) in omega by arith(hi, xo)), hi, hil, xo)
  have ix: int_sub(int_add(int_add(1, seq_len(X)), i), int_add(1, seq_len(X))) = i by arith(hi, xo)
  show := rewrite(ix, e)
qed

// the regions for the new state: the empty reserve's replaced by the new
// one, apart from all others (theirs mapped before, its pages not)
theorem mp.rf_sep(c, A, vm, V1, b, R2, K, B): mp.rfpre(c, A, vm, V1, b, R2, K, B) -> mallocng.separate(mallocng.regions(c, mp.refill(A, R2, K, B)))
proof
  assume P
  let A2 := mp.refill(A, R2, K, B)
  have {hc = cfg, hu = univ, ha = abs, hb = blocks, hh = holds, hn = nat, hfr = fresh} := P
  have hro hko hbo := hn
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {sp = sep} := expand(H, mallocng.holds)
  have {ta = abs, tu = univ} := apply(mp.refill_type, ha, hro, hko, hbo)
  have {fr = front, far = areas, frd = rodata, rp = reserve, gr = groups, er = eq} := apply(mp.regions_parts[c := c, A := A], hc, hu, ha)
  have {rp2 = reserve, er2 = eq} := apply(mp.regions_parts[c := c, A := A2], hc, tu, ta)
  let X := seq_concat(seq_concat(mallocng.data_ranges(c), mallocng.ro_ranges(c.file)), fn_build(int_sub(seq_len(A.areas), 0), x0. pair(A.areas[int_add(0, x0)], 4096)))
  let GR := fn_build(int_sub(seq_len(A.used), 0), x0. ite(int_lt(0, A.metas[A.used[int_add(0, x0)]].maplen), mallocng.group_range(A.metas[A.used[int_add(0, x0)]]), pair(0, 0)))
  let r := pair(A.reserve, int_mul(4096, A.reserve_cnt))
  let r2 := pair(A2.reserve, int_mul(4096, A2.reserve_cnt))
  have e2: mallocng.regions(c, A2) = seq_concat(seq_concat(X, seq_one(r2)), GR) by simp(er2)
  have rs := rewrite(er, sp)
  have rn := apply(mp.regions_nat, hc, hu, ha)
  have rl := mp(all_elim(tr.seq_one_type, {r}, {cart(omega, omega)}), rp)
  have ro := apply(mp.ro_list, (c.file in seq_type(bits(8)) by simp(hc)))
  have cf: c.ctx in omega && c.lock in omega && c.libc in omega by simp(hc)
  have o1 := apply(tr.seq_one_type, (pair(c.ctx, mallocng.CTX_SIZE) in univ(1) by simp(cf)))
  have o2 := apply(tr.seq_one_type, (pair(c.lock, 4) in univ(1) by simp(cf)))
  have o3 := apply(tr.seq_one_type, (pair(c.libc, 16) in univ(1) by simp(cf)))
  have dl: mallocng.data_ranges(c) in list_type(univ(1)) by defs(apply(tr.concat_list, apply(tr.concat_list, o1, o2), o3), mallocng.data_ranges)
  have lc: seq_len(seq_concat(seq_concat(X, seq_one(r)), GR)) = int_add(int_add(seq_len(X), 1), seq_len(GR)) by arith(dl, ro, far, rl, gr)
  have lR: seq_len(mallocng.regions(c, A)) = int_add(int_add(seq_len(X), 1), seq_len(GR)) := rewrite(sym(er), lc)
  have gl: seq_len(GR) in omega by arith(gr)
  have xl: seq_len(X) in omega by arith(dl, ro, far)
  have f2: all a. a in omega -> mallocng.in_range(a, r2) -> !x86_64_linux.mapped(vm, int_div(a, x86_64_linux.PAGE)) proof
    fix a
    assume hao hr2
    have w1 w2 := (int_le(R2, a) && int_lt(a, int_add(R2, int_mul(4096, K))) by simp(expand(hr2, mallocng.in_range)))
    show := mp(all_elim(hfr, {a}), hao, w1, w2)
  qed
  have ax: all i. i in omega -> int_lt(i, seq_len(X)) -> mallocng.apart(r2, X[i]) proof
    fix i
    assume hi hil
    have e := apply(mp.at_front[X := X, r := r, Q := GR, t := cart(omega, omega), i := i], fr, gr, hi, hil)
    have tx := apply(at_type[l := X, t := cart(omega, omega), i := i], fr, hi, hil)
    have q: all a. a in omega -> mallocng.in_range(a, r2) -> !mallocng.in_range(a, X[i]) proof
      fix a
      assume hao hr2
      assume hx
      have hx2: mallocng.in_range(a, mallocng.regions(c, A)[i]) := rewrite(sym(er), rewrite(sym(e), hx))
      have m := apply(mp.regions_mapped[c := c, A := A, vm := vm, b := b, k := i, a := a], hc, hu, ha, hb, hh, hi, arith(hil, lR, gl, xl), hao, hx2)
      show by taut(m, mp(all_elim(f2, {a}), hao, hr2))
    qed
    show := apply(mp.apart_of, rp2, tx, q)
  qed
  have aq: all i. i in omega -> int_lt(i, seq_len(GR)) -> mallocng.apart(r2, GR[i]) proof
    fix i
    assume hi hil
    have xo: seq_len(X) in omega by arith(fr)
    have e := apply(mp.at_back[X := X, r := r, Q := GR, t := cart(omega, omega), i := i], fr, gr, hi, hil)
    have tq := apply(at_type[l := GR, t := cart(omega, omega), i := i], gr, hi, hil)
    have q: all a. a in omega -> mallocng.in_range(a, r2) -> !mallocng.in_range(a, GR[i]) proof
      fix a
      assume hao hr2
      assume hx
      have hx2: mallocng.in_range(a, mallocng.regions(c, A)[int_add(int_add(1, seq_len(X)), i)]) := rewrite(sym(er), rewrite(sym(e), hx))
      have m := apply(mp.regions_mapped[c := c, A := A, vm := vm, b := b, k := int_add(int_add(1, seq_len(X)), i), a := a], hc, hu, ha, hb, hh, arith(hi, xo),
        arith(hil, lR, xo, hi, gl), hao, hx2)
      show by taut(m, mp(all_elim(f2, {a}), hao, hr2))
    qed
    show := apply(mp.apart_of, rp2, tq, q)
  qed
  have s := apply(mp.sep_replace[X := X, r := r, Q := GR, r2 := r2], fr, gr, rp, rp2, rs, ax, aq)
  show := rewrite(sym(e2), s)
qed
