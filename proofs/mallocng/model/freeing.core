// Freeing a slot (free's nontrivial_free): a reserved slot -- its block
// just freed -- made unused, its bit added to its group's freed mask; the
// invariant kept.

// ----------------------------------------------------------------------
//  The abstract step: slot i of g, reserved, unused; its freed bit set
abbrev mp.unres_meta(V, i) := fn_update(fn_update(V, "avail", V.avail), "freed", int_add(V.freed, pow2(i)))

abbrev mp.unres_m(A, g, i) := fn_update(A, "metas", fn_update(A.metas, g, mp.unres_meta(A.metas[g], i)))

abbrev mp.unres_sl(A, g, i) := fn_update(A.slots, g, fn_update(A.slots[g], i, tag(0, empty)))

abbrev mp.unres_abs(A, g, i) := fn_update(mp.unres_m(A, g, i), "slots", mp.unres_sl(A, g, i))

theorem mp.unres_state(A, g, i): A in mallocng.Abs -> g in omega -> i in omega -> int_lt(i, seq_len(A.slots[g])) -> A.slots[g][i] = tag(3, empty) ->
  mallocng.bit(A.metas[g].freed, i) = 0 ->
  abs1: mp.unres_m(A, g, i) in mallocng.Abs && univ1: mp.unres_m(A, g, i) in univ(1) && mo: mallocng_specs.masks_only(A, mp.unres_m(A, g, i)) &&
  geoms: mp.geoms(A, mp.unres_abs(A, g, i)) && metas: mp.unres_abs(A, g, i).metas = mp.unres_m(A, g, i).metas &&
  atg: mp.unres_m(A, g, i).metas[g] = mp.unres_meta(A.metas[g], i) &&
  others: (all h. h in omega -> !(h = g) -> mp.unres_m(A, g, i).metas[h] = A.metas[h]) &&
  sg: mp.unres_abs(A, g, i).slots[g][i] = tag(0, empty) &&
  sj: (all j. !(j = i) -> mp.unres_abs(A, g, i).slots[g][j] = A.slots[g][j]) &&
  sh: (all h. !(h = g) -> mp.unres_abs(A, g, i).slots[h] = A.slots[h]) &&
  slen: seq_len(mp.unres_abs(A, g, i).slots[g]) = seq_len(A.slots[g]) &&
  bits: (all j. j in omega -> mallocng.bit(mp.unres_meta(A.metas[g], i).freed, j) = ite(j = i, 1, mallocng.bit(A.metas[g].freed, j))) &&
  back: fn_update(mp.unres_abs(A, g, i), "slots", A.slots) = mp.unres_m(A, g, i) &&
  freed: int_add(A.metas[g].freed, pow2(i)) in omega
proof
  assume ha hg hi hil hrs hb
  let W := mp.unres_meta(A.metas[g], i)
  let A1 := mp.unres_m(A, g, i)
  let S2 := mp.unres_sl(A, g, i)
  let A2 := mp.unres_abs(A, g, i)
  have vt: A.metas[g] in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A.metas, x := g], simp(ha), hg)
  have avo: A.metas[g].avail in omega by simp(vt)
  have fo: A.metas[g].freed in omega by simp(vt)
  have pp := mp(pow2_pos[k := i], hi)
  have nb := apply(mp.nbit[x := A.metas[g].freed, i := i], fo, hi)
  have ncb: bit(A.metas[g].freed, i) -> false proof
    assume n
    have z: ite(bit(A.metas[g].freed, i), 1, 0) = 1 by simp(n)
    show by arith(trans(sym(nb), hb), z)
  qed
  have cb: !bit(A.metas[g].freed, i) by taut(ncb)
  have nfo: int_add(A.metas[g].freed, pow2(i)) in omega by arith(fo, pp)
  have wt := apply(mp.meta_upd[V := A.metas[g], av := A.metas[g].avail, fr := int_add(A.metas[g].freed, pow2(i))], vt, avo, nfo)
  have {a1 = abs, u1 = univ} := apply(mp.abs_upd[A := A, g := g, W := W], ha, hg, wt)
  // A1's metas: W at g, the others A's
  have em: A1.metas = fn_update(A.metas, g, W) := app_update_same[f := A, k := "metas", v := fn_update(A.metas, g, W)]
  have eg: A1.metas[g] = W := trans(subst({y. A1.metas[g] = y[g]}, em, refl({A1.metas[g]})), app_update_same[f := A.metas, k := g, v := W])
  have eo: all x0. x0 in omega -> !(x0 = g) -> A1.metas[x0] = A.metas[x0] proof
    fix x
    assume hx hne
    show := trans(subst({y. A1.metas[x] = y[x]}, em, refl({A1.metas[x]})), mp(app_update_other[f := A.metas, k := g, v := W, x := x], hne))
  qed
  // masks only
  have af ad := (is_fun(A) && "metas" in dom(A) by simp(expand(ha, mallocng.Abs)))
  have ot: fn_update(A1, "metas", A.metas) = A :=
    trans(fn_update_twice[f := A, k := "metas", a := fn_update(A.metas, g, W), b := A.metas], mp(fn_update_same[f := A, k := "metas"], af, ad))
  have gr: all x0. x0 in omega -> fn_update(fn_update(A1.metas[x0], "avail", 0), "freed", 0) = fn_update(fn_update(A.metas[x0], "avail", 0), "freed", 0) proof
    fix x
    assume hx
    have c1: x = g -> fn_update(fn_update(A1.metas[x], "avail", 0), "freed", 0) = fn_update(fn_update(A.metas[x], "avail", 0), "freed", 0) proof
      assume e
      have cm := mp.clear_masks[V := A.metas[g], a := A.metas[g].avail, f := int_add(A.metas[g].freed, pow2(i))]
      have k1 := subst({y. fn_update(fn_update(A1.metas[g], "avail", 0), "freed", 0) = fn_update(fn_update(y, "avail", 0), "freed", 0)}, eg,
        refl({fn_update(fn_update(A1.metas[g], "avail", 0), "freed", 0)}))
      have k2 := trans(k1, cm)
      show := subst({y. fn_update(fn_update(A1.metas[y], "avail", 0), "freed", 0) = fn_update(fn_update(A.metas[y], "avail", 0), "freed", 0)}, sym(e), k2)
    qed
    have c2: !(x = g) -> fn_update(fn_update(A1.metas[x], "avail", 0), "freed", 0) = fn_update(fn_update(A.metas[x], "avail", 0), "freed", 0) proof
      assume ne
      have e := mp(all_elim(eo, {x}), hx, ne)
      show := subst({y. fn_update(fn_update(A1.metas[x], "avail", 0), "freed", 0) = fn_update(fn_update(y, "avail", 0), "freed", 0)}, e,
        refl({fn_update(fn_update(A1.metas[x], "avail", 0), "freed", 0)}))
    qed
    show by taut(c1, c2)
  qed
  have mo: mallocng_specs.masks_only(A, A1) by defs(taut(ot, gr), mallocng_specs.masks_only)
  // the slots
  have es2: A2.slots = S2 := app_update_same[f := A1, k := "slots", v := S2]
  have em2 := mp(app_update_other[f := A1, k := "slots", v := S2, x := "metas"], simp())
  have sgl: S2[g] = fn_update(A.slots[g], i, tag(0, empty)) := app_update_same[f := A.slots, k := g, v := fn_update(A.slots[g], i, tag(0, empty))]
  have sg: A2.slots[g][i] = tag(0, empty) by simp(es2, sgl)
  have sj: all j. !(j = i) -> A2.slots[g][j] = A.slots[g][j] proof
    fix j
    assume ne
    show by simp(es2, sgl, mp(app_update_other[f := A.slots[g], k := i, v := tag(0, empty), x := j], ne))
  qed
  have sh: all h. !(h = g) -> A2.slots[h] = A.slots[h] proof
    fix h
    assume ne
    show by simp(es2, mp(app_update_other[f := A.slots, k := g, v := fn_update(A.slots[g], i, tag(0, empty)), x := h], ne))
  qed
  have slt: A.slots[g] in list_type(mallocng.Use) := mp(fn_space_app[a := omega, b := list_type(mallocng.Use), f := A.slots, x := g], simp(ha), hg)
  have r0: tag(0, empty) in set_image(single(empty), x0. tag(0, x0)) by taut(set_image_def[s := single(empty), f := x0. tag(0, x0), y := tag(0, empty)],
    (ex x0. x0 in single(empty) && tag(0, x0) = tag(0, empty) by ex_intro({empty}, taut(single_intro[a := empty], refl({tag(0, empty)})))))
  have u0: tag(0, empty) in mallocng.Use by defs(simp(r0), mallocng.Use)
  have {ln = len} := apply(mp.list_upd[l := A.slots[g], t := mallocng.Use, i := i, v := tag(0, empty)], slt, hi, hil, u0)
  have slen: seq_len(A2.slots[g]) = seq_len(A.slots[g]) by simp(es2, sgl, ln)
  // the bits: bit i set
  have bits: all j. j in omega -> mallocng.bit(W.freed, j) = ite(j = i, 1, mallocng.bit(A.metas[g].freed, j)) proof
    fix j
    assume hj
    have wf: W.freed = int_add(A.metas[g].freed, pow2(i)) by simp()
    have n1 := apply(mp.nbit[x := int_add(A.metas[g].freed, pow2(i)), i := j], nfo, hj)
    have n2 := apply(mp.nbit[x := A.metas[g].freed, i := j], fo, hj)
    have bs := apply(bit_set[x := A.metas[g].freed, k := i, i := j], fo, hi, hj, cb)
    have c1: j = i -> mallocng.bit(W.freed, j) = ite(j = i, 1, mallocng.bit(A.metas[g].freed, j)) proof
      assume e
      have yy: bit(int_add(A.metas[g].freed, pow2(i)), j) by taut(bs, e)
      have z: ite(bit(int_add(A.metas[g].freed, pow2(i)), j), 1, 0) = 1 by simp(yy)
      have g1: mallocng.bit(W.freed, j) = 1 := rewrite(sym(wf), trans(n1, z))
      have g2: ite(j = i, 1, mallocng.bit(A.metas[g].freed, j)) = 1 by simp(e)
      show := trans(g1, sym(g2))
    qed
    have c2: !(j = i) -> mallocng.bit(W.freed, j) = ite(j = i, 1, mallocng.bit(A.metas[g].freed, j)) proof
      assume ne
      have q: bit(int_add(A.metas[g].freed, pow2(i)), j) <-> bit(A.metas[g].freed, j) by taut(bs, ne)
      show by simp(wf, n1, n2, q, ne)
    qed
    show by taut(c1, c2)
  qed
  // back: A1 the slots restored
  have ea1 := mp(app_update_other[f := A, k := "metas", v := fn_update(A.metas, g, W), x := "slots"], simp())
  have s1 := mp(fn_update_same[f := A1, k := "slots"], simp(a1), simp(a1))
  have back: fn_update(A2, "slots", A.slots) = A1 := trans(fn_update_twice[f := A1, k := "slots", a := S2, b := A.slots], rewrite(ea1, s1))
  // the geometry
  have gl: all x. x in omega -> seq_len(S2[x]) = seq_len(A.slots[x]) proof
    fix x
    assume hx
    have c1: x = g -> seq_len(S2[x]) = seq_len(A.slots[x]) proof
      assume e
      show := subst({y. seq_len(S2[y]) = seq_len(A.slots[y])}, sym(e), (seq_len(S2[g]) = seq_len(A.slots[g]) by simp(sgl, ln)))
    qed
    have c2: !(x = g) -> seq_len(S2[x]) = seq_len(A.slots[x]) proof
      assume ne
      show by simp(mp(app_update_other[f := A.slots, k := g, v := fn_update(A.slots[g], i, tag(0, empty)), x := x], ne))
    qed
    show by taut(c1, c2)
  qed
  have gs: all x j. x in omega && j in omega -> S2[x][j] = A.slots[x][j] ||
      (A.slots[x][j] = tag(0, empty) && S2[x][j] = tag(3, empty)) ||
      (A.slots[x][j] = tag(3, empty) && S2[x][j] = tag(0, empty)) proof
    fix x j
    assume hxj
    have c2: !(x = g) -> S2[x][j] = A.slots[x][j] proof
      assume ne
      show by simp(mp(app_update_other[f := A.slots, k := g, v := fn_update(A.slots[g], i, tag(0, empty)), x := x], ne))
    qed
    have c1: x = g -> S2[x][j] = A.slots[x][j] ||
        (A.slots[x][j] = tag(3, empty) && S2[x][j] = tag(0, empty)) proof
      assume e
      have d1: !(j = i) -> S2[g][j] = A.slots[g][j] proof
        assume ne
        show by simp(sgl, mp(app_update_other[f := A.slots[g], k := i, v := tag(0, empty), x := j], ne))
      qed
      have d2: j = i -> A.slots[g][j] = tag(3, empty) && S2[g][j] = tag(0, empty) proof
        assume ej
        show by simp(ej, hrs, sgl)
      qed
      have dg: S2[g][j] = A.slots[g][j] || (A.slots[g][j] = tag(3, empty) && S2[g][j] = tag(0, empty)) by taut(d1, d2)
      show := subst({y. S2[y][j] = A.slots[y][j] || (A.slots[y][j] = tag(3, empty) && S2[y][j] = tag(0, empty))}, sym(e), dg)
    qed
    show by taut(c1, c2)
  qed
  have geo := apply(mp.geoms_upd[A := A, A1 := A1, S := S2], ha, apply(mp.mo_geom_of, ha, mo), gl, gs)
  show by taut(a1, u1, mo, geo, em2, eg, eo, sg, sj, sh, slen, bits, back, nfo)
qed

// (g's masks with a slot freed: its bit added to the freed mask; the slot,
// reserved, in neither mask before)
theorem mp.masks_unres(A, A2, M, M2, g, i): mallocng.masks_ok(A, M, g) -> A.metas[g].avail in omega -> A.metas[g].freed in omega ->
  i in omega -> int_le(i, A.metas[g].last_idx) ->
  A.slots[g][i] = tag(3, empty) -> A2.slots[g][i] = tag(0, empty) -> (all j. !(j = i) -> A2.slots[g][j] = A.slots[g][j]) ->
  A2.metas[g].mem = A.metas[g].mem -> A2.metas[g].last_idx = A.metas[g].last_idx -> A2.metas[g].avail = A.metas[g].avail ->
  (all j. j in omega -> mallocng.bit(A2.metas[g].freed, j) = ite(j = i, 1, mallocng.bit(A.metas[g].freed, j))) ->
  (all j. mallocng.slot_start(A2.metas[g], j) = mallocng.slot_start(A.metas[g], j)) ->
  mallocng.b8(M2, int_add(A.metas[g].mem, 8)) = mallocng.b8(M, int_add(A.metas[g].mem, 8)) ->
  (all j. j in omega -> int_le(j, A.metas[g].last_idx) -> mallocng.b8(M2, int_sub(mallocng.slot_start(A.metas[g], j), 4)) = mallocng.b8(M, int_sub(mallocng.slot_start(A.metas[g], j), 4))) ->
  mallocng.masks_ok(A2, M2, g)
proof
  assume hm av fv hi hil hrs sg sj em el ea bits ss hx es
  have mk := expand(hm, mallocng.masks_ok)
  have eh: int_mod(mallocng.b8(M2, int_add(A2.metas[g].mem, 8)), 32) = int_mod(mallocng.b8(M, int_add(A.metas[g].mem, 8)), 32) by simp(em, hx)
  have eab: all j. mallocng.bit(A2.metas[g].avail, j) = mallocng.bit(A.metas[g].avail, j) proof
    fix j
    show by simp(ea)
  qed
  have r: all x0. x0 in omega -> int_lt(x0, 32) -> (((mallocng.bit(A2.metas[g].avail, x0) = 1 -> int_le(x0, int_mod(mallocng.b8(M2, int_add(A2.metas[g].mem, 8)), 32)) && mallocng.bit(A2.metas[g].freed, x0) = 0) && (int_lt(0, int_add(mallocng.bit(A2.metas[g].avail, x0), mallocng.bit(A2.metas[g].freed, x0))) -> int_le(x0, A2.metas[g].last_idx))) && (int_le(x0, A2.metas[g].last_idx) -> (A2.slots[g][x0] = tag(0, empty) <-> int_lt(0, int_add(mallocng.bit(A2.metas[g].avail, x0), mallocng.bit(A2.metas[g].freed, x0)))) && mallocng.b8(M2, int_sub(mallocng.slot_start(A2.metas[g], x0), 4)) = 0)) && (int_lt(int_mod(mallocng.b8(M2, int_add(A2.metas[g].mem, 8)), 32), x0) && int_le(x0, A2.metas[g].last_idx) -> mallocng.bit(A2.metas[g].freed, x0) = 1) proof
    fix j
    assume hj hjl
    have a b cc d := mp(all_elim(mk, {j}), hj, hjl)
    have ef := mp(all_elim(bits, {j}), hj)
    have eb2 := all_elim(eab, {j})
    have hd3: int_le(j, A2.metas[g].last_idx) -> mallocng.b8(M2, int_sub(mallocng.slot_start(A2.metas[g], j), 4)) = 0 proof
      assume l2
      have l := rewrite(el, l2)
      have _ y := mp(cc, l)
      have s2: mallocng.b8(M2, int_sub(mallocng.slot_start(A2.metas[g], j), 4)) = mallocng.b8(M, int_sub(mallocng.slot_start(A.metas[g], j), 4)) by simp(all_elim(ss, {j}), mp(all_elim(es, {j}), hj, l))
      show := trans(s2, y)
    qed
    have ci: j = i -> (((mallocng.bit(A2.metas[g].avail, j) = 1 -> int_le(j, int_mod(mallocng.b8(M2, int_add(A2.metas[g].mem, 8)), 32)) && mallocng.bit(A2.metas[g].freed, j) = 0) && (int_lt(0, int_add(mallocng.bit(A2.metas[g].avail, j), mallocng.bit(A2.metas[g].freed, j))) -> int_le(j, A2.metas[g].last_idx))) && (int_le(j, A2.metas[g].last_idx) -> (A2.slots[g][j] = tag(0, empty) <-> int_lt(0, int_add(mallocng.bit(A2.metas[g].avail, j), mallocng.bit(A2.metas[g].freed, j)))) && mallocng.b8(M2, int_sub(mallocng.slot_start(A2.metas[g], j), 4)) = 0)) && (int_lt(int_mod(mallocng.b8(M2, int_add(A2.metas[g].mem, 8)), 32), j) && int_le(j, A2.metas[g].last_idx) -> mallocng.bit(A2.metas[g].freed, j) = 1) proof
      assume e
      // (the slot reserved: in neither mask -- so its avail bit 0)
      have li: int_le(j, A.metas[g].last_idx) := subst({y. int_le(y, A.metas[g].last_idx)}, sym(e), hil)
      have x _ := mp(cc, li)
      have t3: A.slots[g][j] = tag(3, empty) := subst({y. A.slots[g][y] = tag(3, empty)}, sym(e), hrs)
      have n0: !(A.slots[g][j] = tag(0, empty)) by defs(simp(t3), tag)
      have z0: !int_lt(0, int_add(mallocng.bit(A.metas[g].avail, j), mallocng.bit(A.metas[g].freed, j))) by taut(x, n0)
      have ab0: mallocng.bit(A.metas[g].avail, j) in omega by simp(apply(mp.nbit[x := A.metas[g].avail, i := j], av, hj))
      have fb0: mallocng.bit(A.metas[g].freed, j) in omega by simp(apply(mp.nbit[x := A.metas[g].freed, i := j], fv, hj))
      have za: mallocng.bit(A2.metas[g].avail, j) = 0 by arith(eb2, z0, ab0, fb0)
      have o1: mallocng.bit(A2.metas[g].freed, j) = 1 by simp(ef, e)
      have c1: (mallocng.bit(A2.metas[g].avail, j) = 1 -> int_le(j, int_mod(mallocng.b8(M2, int_add(A2.metas[g].mem, 8)), 32)) && mallocng.bit(A2.metas[g].freed, j) = 0) proof
        assume h
        have f: false by arith(za, h)
        show by taut(f)
      qed
      have c2: (int_lt(0, int_add(mallocng.bit(A2.metas[g].avail, j), mallocng.bit(A2.metas[g].freed, j))) -> int_le(j, A2.metas[g].last_idx)) proof
        assume _
        show := rewrite(sym(el), li)
      qed
      have u0: A2.slots[g][j] = tag(0, empty) := subst({y. A2.slots[g][y] = tag(0, empty)}, sym(e), sg)
      have c3: (int_le(j, A2.metas[g].last_idx) -> (A2.slots[g][j] = tag(0, empty) <-> int_lt(0, int_add(mallocng.bit(A2.metas[g].avail, j), mallocng.bit(A2.metas[g].freed, j)))) && mallocng.b8(M2, int_sub(mallocng.slot_start(A2.metas[g], j), 4)) = 0) proof
        assume l2
        show by taut(u0, (int_lt(0, int_add(mallocng.bit(A2.metas[g].avail, j), mallocng.bit(A2.metas[g].freed, j))) by arith(za, o1)), mp(hd3, l2))
      qed
      have c4: (int_lt(int_mod(mallocng.b8(M2, int_add(A2.metas[g].mem, 8)), 32), j) && int_le(j, A2.metas[g].last_idx) -> mallocng.bit(A2.metas[g].freed, j) = 1) proof
        assume _
        show := o1
      qed
      show by taut(c1, c2, c3, c4)
    qed
    have cn: !(j = i) -> (((mallocng.bit(A2.metas[g].avail, j) = 1 -> int_le(j, int_mod(mallocng.b8(M2, int_add(A2.metas[g].mem, 8)), 32)) && mallocng.bit(A2.metas[g].freed, j) = 0) && (int_lt(0, int_add(mallocng.bit(A2.metas[g].avail, j), mallocng.bit(A2.metas[g].freed, j))) -> int_le(j, A2.metas[g].last_idx))) && (int_le(j, A2.metas[g].last_idx) -> (A2.slots[g][j] = tag(0, empty) <-> int_lt(0, int_add(mallocng.bit(A2.metas[g].avail, j), mallocng.bit(A2.metas[g].freed, j)))) && mallocng.b8(M2, int_sub(mallocng.slot_start(A2.metas[g], j), 4)) = 0)) && (int_lt(int_mod(mallocng.b8(M2, int_add(A2.metas[g].mem, 8)), 32), j) && int_le(j, A2.metas[g].last_idx) -> mallocng.bit(A2.metas[g].freed, j) = 1) proof
      assume ne
      have efb: mallocng.bit(A2.metas[g].freed, j) = mallocng.bit(A.metas[g].freed, j) by simp(ef, ne)
      have esl := mp(all_elim(sj, {j}), ne)
      have c1: (mallocng.bit(A2.metas[g].avail, j) = 1 -> int_le(j, int_mod(mallocng.b8(M2, int_add(A2.metas[g].mem, 8)), 32)) && mallocng.bit(A2.metas[g].freed, j) = 0) proof
        assume h
        have p q := mp(a, trans(sym(eb2), h))
        show by taut(rewrite(sym(eh), p), trans(efb, q))
      qed
      have c2: (int_lt(0, int_add(mallocng.bit(A2.metas[g].avail, j), mallocng.bit(A2.metas[g].freed, j))) -> int_le(j, A2.metas[g].last_idx)) proof
        assume h
        have l := mp(b, (int_lt(0, int_add(mallocng.bit(A.metas[g].avail, j), mallocng.bit(A.metas[g].freed, j))) by arith(h, eb2, efb)))
        show := rewrite(sym(el), l)
      qed
      have c3: (int_le(j, A2.metas[g].last_idx) -> (A2.slots[g][j] = tag(0, empty) <-> int_lt(0, int_add(mallocng.bit(A2.metas[g].avail, j), mallocng.bit(A2.metas[g].freed, j)))) && mallocng.b8(M2, int_sub(mallocng.slot_start(A2.metas[g], j), 4)) = 0) proof
        assume l2
        have x _ := mp(cc, rewrite(el, l2))
        show by taut(rewrite(sym(esl), rewrite(sym(eb2), rewrite(sym(efb), x))), mp(hd3, l2))
      qed
      have c4: (int_lt(int_mod(mallocng.b8(M2, int_add(A2.metas[g].mem, 8)), 32), j) && int_le(j, A2.metas[g].last_idx) -> mallocng.bit(A2.metas[g].freed, j) = 1) proof
        assume h
        have h1 h2 := h
        show := trans(efb, mp(d, conj(rewrite(eh, h1), rewrite(el, h2))))
      qed
      show by taut(c1, c2, c3, c4)
    qed
    show by taut(ci, cn)
  qed
  show by defs(r, mallocng.masks_ok)
qed

// (the slots replaced, some reserved ones no longer: their bytes
// accessible -- the permissions kept)
theorem mp.perms_unsl(c, X, S, M, b): mallocng.perms_ok(c, X, M, b) ->
  (all x. x in omega -> mallocng.in_reserved(X, x) -> !mallocng.in_reserved(fn_update(X, "slots", S), x) -> mallocng.m_rw(M, x) && !(snd(mallocng.pg(M, x)).kind = 2)) ->
  mallocng.perms_ok(c, fn_update(X, "slots", S), M, b)
proof
  assume hp hr
  have p1 p2 p3 := expand(hp, mallocng.perms_ok)
  have q2: all x0. all x1. x0 in omega && x1 in omega -> (((int_lt(x0, seq_len(fn_update(X, "slots", S).used)) && int_le(fst(mallocng.group_range(fn_update(X, "slots", S).metas[fn_update(X, "slots", S).used[x0]])), x1)) &&
      int_lt(x1, int_add(fst(mallocng.group_range(fn_update(X, "slots", S).metas[fn_update(X, "slots", S).used[x0]])), snd(mallocng.group_range(fn_update(X, "slots", S).metas[fn_update(X, "slots", S).used[x0]]))))) && !(x1 in malloc.live_of(b))) && !mallocng.in_reserved(fn_update(X, "slots", S), x1) -> mallocng.m_rw(M, x1) && !(snd(mallocng.pg(M, x1)).kind = 2) proof
    fix k x
    assume ho hq
    have hkl lo hi nl nr := hq
    have _ xo := ho
    have cr: mallocng.in_reserved(X, x) -> mallocng.m_rw(M, x) && !(snd(mallocng.pg(M, x)).kind = 2) proof
      assume r
      show := mp(all_elim(hr, {x}), xo, r, nr)
    qed
    have cn: !mallocng.in_reserved(X, x) -> mallocng.m_rw(M, x) && !(snd(mallocng.pg(M, x)).kind = 2) proof
      assume nr1
      have hkl1: int_lt(k, seq_len(X.used)) by simp(hkl)
      have lo1: int_le(fst(mallocng.group_range(X.metas[X.used[k]])), x) by simp(lo)
      have hi1: int_lt(x, int_add(fst(mallocng.group_range(X.metas[X.used[k]])), snd(mallocng.group_range(X.metas[X.used[k]])))) by simp(hi)
      show := mp(all_elim(p2, {k}, {x}), ho, taut(hkl1, lo1, hi1, nl, nr1))
    qed
    show by taut(cr, cn)
  qed
  have ea: mallocng.auxv_ranges(fn_update(X, "slots", S)) = mallocng.auxv_ranges(X) by defs(simp(), mallocng.auxv_ranges)
  show by defs(taut(p1, q2, rewrite(sym(ea), p3)), mallocng.perms_ok)
qed

// (the listed groups fitting their class: the lists as before or smaller,
// each group with an unused slot had one before or is no own mapping)
theorem mp.reuse_mono_g(A, A2): mallocng.reuse_ok(A) ->
  (all sc g. sc in omega && g in omega -> int_lt(sc, 48) -> mallocng.on_list(A2.active[sc], g) -> mallocng.on_list(A.active[sc], g)) ->
  (all g. mallocng.has_unused(A2, g) -> mallocng.has_unused(A, g) || !mallocng.own_mapping(A2.metas[g])) ->
  (all g. g in omega -> A2.metas[g].sizeclass = A.metas[g].sizeclass && mallocng.stride(A2.metas[g]) = mallocng.stride(A.metas[g])) ->
  mallocng.reuse_ok(A2)
proof
  assume R hl hu hm
  have r0 := expand(R, mallocng.reuse_ok)
  have u: all sc g. sc in omega && g in omega -> int_lt(sc, 48) && mallocng.on_list(A2.active[sc], g) && mallocng.has_unused(A2, g) ->
      !mallocng.own_mapping(A2.metas[g]) proof
    fix sc g
    assume hn hp
    have l0 o2 u2 := hp
    have _ go := hn
    have o0 := mp(all_elim(hl, {sc}, {g}), hn, l0, o2)
    have es ed := mp(all_elim(hm, {g}), go)
    have back: mallocng.own_mapping(A2.metas[g]) -> mallocng.own_mapping(A.metas[g]) proof
      assume o
      show by defs(rewrite(es, rewrite(ed, expand(o, mallocng.own_mapping))), mallocng.own_mapping)
    qed
    have old: mallocng.has_unused(A, g) -> !mallocng.own_mapping(A2.metas[g]) proof
      assume u0
      have nm := mp(all_elim(r0, {sc}, {g}), hn, taut(l0, o0, u0))
      show by taut(nm, back)
    qed
    show by taut(mp(all_elim(hu, {g}), u2), old)
  qed
  show by defs(taut(u), mallocng.reuse_ok)
qed

// ----------------------------------------------------------------------
//  The invariant kept by a slot freed: slot i of g, reserved, unused; its
//  bit added to g's freed mask (written in memory, the available mask as
//  before). g no group mapped on its own (such a group free gives back
//  whole). The view the one where the slot's interior is the allocator's
//  again: its bytes accessible.
theorem mp.holds_unreserve(c, A, M, M2, b, brk, g, i): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  mallocng.holds(c, A, M, b, brk) -> mallocng.is_used(A, g) -> i in omega -> int_lt(i, seq_len(A.slots[g])) -> A.slots[g][i] = tag(3, empty) ->
  !mallocng.own_mapping(A.metas[g]) ->
  (all a. a in omega -> !(int_le(int_add(g, 24), a) && int_lt(a, int_add(g, 32))) -> M2[a] = M[a]) -> (all a. a in omega -> mallocng.pg(M2, a) = mallocng.pg(M, a)) ->
  mallocng.rd(M2, int_add(g, 24), 4) = A.metas[g].avail -> mallocng.rd(M2, int_add(g, 28), 4) = int_add(A.metas[g].freed, pow2(i)) ->
  (all a. a in omega -> mallocng.in_slot(A.metas[g], i, a) -> mallocng.m_rw(M2, a) && !(snd(mallocng.pg(M2, a)).kind = 2)) ->
  mallocng.holds(c, mp.unres_abs(A, g, i), M2, b, brk)
proof
  assume hc hu ha hb H hg hi hil hrs hno hby hpg rav rfr hrw
  let A1 := mp.unres_m(A, g, i)
  let A2 := mp.unres_abs(A, g, i)
  have {huo = used, hpart = part, hin = in_slots, hbrk = brk, hsep = sep, hwf = wf, hfix = fixed, hac0 = active, hpo = partial} := expand(H, mallocng.holds)
  have {usl = used_slots} := expand(hpart, mallocng.metas_partition)
  have {go = nat} := apply(mp.used_nat, ha, hg)
  // g: its slot i reserved, so in neither mask
  have gokg := apply(mp.used_group, huo, hg)
  have {hmg = mim, hmkg = masks, hbgg = big, hactg = act, hsmg = small, lkg = linked, ulg = unlinked, gl = nslots} := expand(gokg, mallocng.group_ok)
  have vt: A.metas[g] in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A.metas, x := g], simp(ha), go)
  have avo: A.metas[g].avail in omega by simp(vt)
  have fo: A.metas[g].freed in omega by simp(vt)
  have vlo: A.metas[g].last_idx in omega by simp(vt)
  have {ml = last} := expand(hmg, mallocng.meta_in_memory)
  have ile: int_le(i, A.metas[g].last_idx) by arith(gl, hil, hi, vlo)
  have i32: int_lt(i, 32) by arith(ile, ml)
  have _ _ cc _ := mp(all_elim(expand(hmkg, mallocng.masks_ok), {i}), hi, i32)
  have x _ := mp(cc, ile)
  have n0: !(A.slots[g][i] = tag(0, empty)) by defs(simp(hrs), tag)
  have ab0: mallocng.bit(A.metas[g].avail, i) in omega by simp(apply(mp.nbit[x := A.metas[g].avail, i := i], avo, hi))
  have fb0: mallocng.bit(A.metas[g].freed, i) in omega by simp(apply(mp.nbit[x := A.metas[g].freed, i := i], fo, hi))
  have z0: !int_lt(0, int_add(mallocng.bit(A.metas[g].avail, i), mallocng.bit(A.metas[g].freed, i))) by taut(x, n0)
  have hfb: mallocng.bit(A.metas[g].freed, i) = 0 by arith(z0, ab0, fb0)
  have {a1 = abs1, mo = mo, gs = geoms, em2 = metas, atg = atg, eo = others, sg = sg, sj = sj, sh = sh, slen = slen, bits = bits} := apply(mp.unres_state, ha, go, hi, hil, hrs, hfb)
  have byt: all a. a in omega -> !(int_le(int_add(g, 24), a) && int_lt(a, int_add(g, 32))) -> !mp.ingrp(A, a) -> M2[a] = M[a] proof
    fix a
    assume hao hw hng
    show := mp(all_elim(hby, {a}), hao, hw)
  qed
  have hpw: all a. a in omega -> !mallocng.in_reserved(A, a) -> mallocng.pg(M2, a) = mallocng.pg(M, a) proof
    fix a
    assume hao hn
    show := mp(all_elim(hpg, {a}), hao)
  qed
  have F: mp.mframe(c, A, A1, M, M2, b, brk, g) by taut(hc, hu, ha, a1, hb, H, mo, eo, hg, byt, hpw)
  // (g past a list's head: no slot available, some freed -- now one more)
  have atg1: A1.metas[g] = mp.unres_meta(A.metas[g], i) := atg
  have pp := mp(pow2_pos[k := i], hi)
  have hac2: all sc. all k. sc in omega && k in omega -> int_lt(sc, 48) && int_lt(k, seq_len(A.active[sc])) -> int_lt(0, k) ->
      A.active[sc][k] = g -> A1.metas[g].avail = 0 && !(A1.metas[g].freed = 0) proof
    fix sc k
    assume h1 h2 h3 h4
    have _ _ k0 := mp(all_elim(expand(hac0, mallocng.active_ok), {sc}, {k}), h1, h2)
    have a0 _ := rewrite(h4, mp(k0, h3))
    have av1: A1.metas[g].avail = 0 by simp(atg1, a0)
    have fpp: !(int_add(A.metas[g].freed, pow2(i)) = 0) by arith(fo, pp)
    have fr1: !(A1.metas[g].freed = 0) by simp(atg1, fpp)
    show by taut(av1, fr1)
  qed
  // what reads no slot: as with the masks only, then the slots replaced
  have im := apply(mp.mf_image[c := c, A := A, A2 := A1, M := M, M2 := M2, b := b, brk := brk, g := g], F)
  have cx := apply(mp.mf_ctx[c := c, A := A, A2 := A1, M := M, M2 := M2, b := b, brk := brk, g := g], F)
  have fr := apply(mp.mf_fresh[c := c, A := A, A2 := A1, M := M, M2 := M2, b := b, brk := brk, g := g], F)
  have ar := apply(mp.mf_areas[c := c, A := A, A2 := A1, M := M, M2 := M2, b := b, brk := brk, g := g], F)
  have ac := apply(mp.mf_active[c := c, A := A, A2 := A1, M := M, M2 := M2, b := b, brk := brk, g := g], F, hac2)
  have nm := apply(mp.mf_normal[c := c, A := A, A2 := A1, M := M, M2 := M2, b := b, brk := brk, g := g], F)
  have pm := apply(mp.mf_perms[c := c, A := A, A2 := A1, M := M, M2 := M2, b := b, brk := brk, g := g], F)
  have cl := apply(mp.mf_classes[c := c, A := A, A2 := A1, M := M, M2 := M2, b := b, brk := brk, g := g], F)
  have db := apply(mp.mf_debruijn[c := c, A := A, A2 := A1, M := M, M2 := M2, b := b, brk := brk, g := g], F)
  have gp := apply(mp.mf_apart[c := c, A := A, A2 := A1, M := M, M2 := M2, b := b, brk := brk, g := g], F)
  have {ep = part, ebrk = brk, efx = fixed} := apply(mp.mo_same[c := c, A := A, A2 := A1, M := M, b := b, brk := brk], mo)
  have er := apply(mp.mo_regions[c := c, A := A, A2 := A1], ha, mo)
  have {sp = part, sc2 = ctx, sf = fresh, sa = areas, sac = active, sb = brk, sx = fixed, sap = apart, sr = regions} := mp.sl_same[c := c, X := A1, S := mp.unres_sl(A, g, i), M := M2, b := b, brk := brk]
  // the groups' bytes: as before
  have gbe: all a. a in omega -> mp.ingrp(A, a) -> M2[a] = M[a] proof
    fix a
    assume hao ig
    show := mp(all_elim(hby, {a}), hao, apply(mp.mf_nomask[c := c, A := A, A2 := A1, M := M, M2 := M2, b := b, brk := brk, g := g, a := a], F, hao, ig))
  qed
  have eus := apply(mp.gs_field[A := A, A2 := A2, k := "used"], gs, simp(), simp(), simp(), simp())
  have eac: A2.active = A.active by simp()
  // g: its slot freed, its mask
  have {hxg = hdr, hsg = slots} := apply(mp.hdr_bytes, ha, go, gokg)
  have atg2: A2.metas[g] = mp.unres_meta(A.metas[g], i) := trans(subst({y. A2.metas[g] = y[g]}, em2, refl({A2.metas[g]})), atg)
  have fmem: A2.metas[g].mem = A.metas[g].mem by simp(atg2)
  have flast: A2.metas[g].last_idx = A.metas[g].last_idx by simp(atg2)
  have ffr: A2.metas[g].freed = int_add(A.metas[g].freed, pow2(i)) by simp(atg2)
  have fav: A2.metas[g].avail = A.metas[g].avail by simp(atg2)
  have fprev: A2.metas[g].prev = A.metas[g].prev by simp(atg2)
  have fnext: A2.metas[g].next = A.metas[g].next by simp(atg2)
  have fsc: A2.metas[g].sizeclass = A.metas[g].sizeclass by simp(atg2)
  have ffa: A2.metas[g].freeable = A.metas[g].freeable by simp(atg2)
  have fml: A2.metas[g].maplen = A.metas[g].maplen by simp(atg2)
  have {gst = stride, gsls = slots} := apply(mp.gs_geom[A := A, A2 := A2, x := g], gs, go)
  have ingr: all h a. mallocng.is_used(A, h) -> mp.gb(A, h, a) -> mp.ingrp(A, a) proof
    fix h a
    assume iu gh
    show by defs(ex_intro({h}, taut(iu, gh)), mp.ingrp)
  qed
  have bxg := apply(mp.agree_b8, mp(all_elim(gbe, {int_add(A.metas[g].mem, 8)}), simp(go, (A.metas[g].mem in omega by simp(vt))), mp(all_elim(ingr, {g}, {int_add(A.metas[g].mem, 8)}), hg, hxg)))
  have {bxgb = byte} := bxg
  have esg: all j. j in omega -> int_le(j, A.metas[g].last_idx) -> mallocng.b8(M2, int_sub(mallocng.slot_start(A.metas[g], j), 4)) = mallocng.b8(M, int_sub(mallocng.slot_start(A.metas[g], j), 4)) proof
    fix j
    assume hj hjl
    have gj := mp(all_elim(hsg, {j}), hj, hjl)
    have {gm = mem, gsn = stride} := apply(mp.geo, ha, go, gokg)
    have mo2: int_mul(mallocng.stride(A.metas[g]), j) in omega by simp(gsn, hj)
    have si: mallocng.slot_start(A.metas[g], j) = int_add(int_add(A.metas[g].mem, 16), int_mul(mallocng.stride(A.metas[g]), j)) by defs(arith(), mallocng.slot_start, mallocng.storage, mallocng.UNIT)
    have {ab = byte} := apply(mp.agree_b8, mp(all_elim(gbe, {int_sub(mallocng.slot_start(A.metas[g], j), 4)}), arith(si, gm, mo2), mp(all_elim(ingr, {g}, {int_sub(mallocng.slot_start(A.metas[g], j), 4)}), hg, gj)))
    show := ab
  qed
  have agg: all a. a in omega -> int_le(A.metas[g].mem, a) -> int_le(a, mallocng.slot_end(A.metas[g], A.metas[g].last_idx)) -> !(a = int_add(A.metas[g].mem, 8)) ->
       (all j. j in omega -> int_lt(j, seq_len(A.slots[g])) ->
          ((A.slots[g][j] = tag(0, empty) || A.slots[g][j] = tag(3, empty)) -> !mallocng.in_slot(A.metas[g], j, a)) &&
          (fst(A.slots[g][j]) = 2 -> !(int_le(A.metas[snd(A.slots[g][j])].mem, a) && int_lt(a, mallocng.slot_end(A.metas[g], j))))) ->
       M2[a] = M[a] proof
    fix a
    assume hao a1x a2 ne ex
    show := mp(all_elim(gbe, {a}), hao, mp(all_elim(ingr, {g}, {a}), hg, (mp.gb(A, g, a) by defs(taut(a1x, a2), mp.gb))))
  qed
  have a40: all j. j in omega -> int_lt(j, 40) -> !(int_le(24, j) && int_lt(j, 32)) -> M2[int_add(g, j)] = M[int_add(g, j)] proof
    fix j
    assume hj hjl hjo
    show := mp(all_elim(hby, {int_add(g, j)}), simp(go, hj), arith(hjo, go, hj))
  qed
  have mimg := apply(mp.mim_masks[M := M, M2 := M2, g := g, V := A.metas[g], V2 := A2.metas[g]], go, hmg, a40, trans(rav, sym(fav)), trans(rfr, sym(ffr)),
    fprev, fnext, fmem, flast, ffa, fsc, fml)
  have ss2: all j. mallocng.slot_start(A2.metas[g], j) = mallocng.slot_start(A.metas[g], j) proof
    fix j
    have s1 _ := all_elim(gsls, {j})
    show := s1
  qed
  have mskg := apply(mp.masks_unres[A := A, A2 := A2, M := M, M2 := M2, g := g, i := i], hmkg, avo, fo, hi, ile, hrs, sg, sj, fmem, flast, fav,
    rewrite(sym(atg2), bits), ss2, bxgb, esg)
  // (g no big group: such a group is mapped on its own)
  have nb63: !(A.metas[g].sizeclass = 63) proof
    assume e
    have o: mallocng.own_mapping(A.metas[g]) by defs(simp(e), mallocng.own_mapping)
    show by taut(o, hno)
  qed
  have big2: mallocng.big_ok(A2, g) by defs(taut(rewrite(sym(fsc), nb63)), mallocng.big_ok)
  have hlg: mp.links_ok(A2, g) by defs(taut(rewrite(sym(eac), rewrite(sym(fsc), rewrite(sym(fnext), lkg))), rewrite(sym(fprev), rewrite(sym(fnext), ulg))), mp.links_ok)
  have actg := rewrite(sym(fmem), rewrite(sym(flast), rewrite(sym(bxgb), hactg)))
  have smg := rewrite(sym(gst), rewrite(sym(fmem), rewrite(sym(flast), rewrite(sym(bxgb), hsmg))))
  have gog := apply(mp.group_tr_s[A := A, A2 := A2, M := M, M2 := M2, b := b, h := g], ha, hb, go, gs, huo, gokg, agg, mimg, mskg, big2, hlg, actg, smg)
  // another group: as before
  have ul: A.used in list_type(omega) by simp(ha)
  have r: all x0. x0 in omega -> int_lt(x0, seq_len(A2.used)) -> mallocng.group_ok(A2, M2, b, A2.used[x0]) proof
    fix k
    assume hk hkl0
    have hkl: int_lt(k, seq_len(A.used)) := rewrite(eus, hkl0)
    let h := A.used[k]
    have iu: mallocng.is_used(A, h) by defs(ex_intro({k}, taut(hk, hkl, refl({h}))), mallocng.is_used)
    have cg: h = g -> mallocng.group_ok(A2, M2, b, h) proof
      assume e
      show := subst({y. mallocng.group_ok(A2, M2, b, y)}, sym(e), gog)
    qed
    have co: !(h = g) -> mallocng.group_ok(A2, M2, b, h) proof
      assume ne
      have ho := apply(at_type[l := A.used, t := omega, i := k], ul, hk, hkl)
      have hms := mp(all_elim(usl, {k}), hk, hkl)
      have ev: A2.metas[h] = A.metas[h] := trans(subst({y. A2.metas[h] = y[h]}, em2, refl({A2.metas[h]})), mp(all_elim(eo, {h}), ho, ne))
      have esl := mp(all_elim(sh, {h}), ne)
      have a40h: all j. j in omega -> int_lt(j, 40) -> M2[int_add(h, j)] = M[int_add(h, j)] proof
        fix j
        assume hj hjl
        show := apply(mp.mf_meta[c := c, A := A, A2 := A1, M := M, M2 := M2, b := b, brk := brk, g := g, l := h, a := int_add(h, j)], F, hms, simp(ho, hj),
          arith(ho, hj), arith(ho, hj, hjl), (!(h = g) || int_lt(int_add(h, j), int_add(g, 24)) || int_le(int_add(g, 32), int_add(h, j)) by taut(ne)))
      qed
      have own: all a. a in omega -> mp.gb(A, h, a) -> mp.own(A, h, a) -> M2[a] = M[a] proof
        fix a
        assume hao gba _
        show := mp(all_elim(gbe, {a}), hao, mp(all_elim(ingr, {h}, {a}), iu, gba))
      qed
      show := apply(mp.group_kept[A := A, A2 := A2, M := M, M2 := M2, b := b, h := h], ha, hb, ho, gs, huo, apply(mp.used_group, huo, iu),
        ev, esl, eac, a40h, own)
    qed
    have gk: mallocng.group_ok(A2, M2, b, h) by taut(cg, co)
    show := rewrite(sym(eus), gk)
  qed
  have us: mallocng.used_ok(A2, M2, b) by defs(r, mallocng.used_ok)
  // the slot-reading conjuncts
  have bl := apply(mp.blocks_res[A := A, A2 := A2, b := b], ha, gs, hin)
  have eiu: all h. mallocng.is_used(A1, h) = mallocng.is_used(A, h) proof
    fix h
    show by defs(simp(), mallocng.is_used)
  qed
  have hlen: all h. h in omega -> !mallocng.is_used(A1, h) -> seq_len(mp.unres_sl(A, g, i)[h]) = seq_len(A1.slots[h]) proof
    fix h
    assume hh nu
    have nu0 := rewrite(all_elim(eiu, {h}), nu)
    have ne: !(h = g) proof
      assume e
      show by taut(nu0, rewrite(sym(e), hg))
    qed
    show by simp(mp(app_update_other[f := A.slots, k := g, v := fn_update(A.slots[g], i, tag(0, empty)), x := h], ne))
  qed
  have nm2 := apply(mp.normal_sl[X := A1, S := mp.unres_sl(A, g, i)], nm, hlen)
  // the freed slot's interior: no longer reserved, accessible
  have hrr: all x. x in omega -> mallocng.in_reserved(A1, x) -> !mallocng.in_reserved(A2, x) -> mallocng.m_rw(M2, x) && !(snd(mallocng.pg(M2, x)).kind = 2) proof
    fix x
    assume xo r1 nr2
    obtain h j, hh hj hu1 hjl hs his from expand(r1, mallocng.in_reserved)
    have es1: A1.slots[h] = A.slots[h] by simp()
    have hs0 := rewrite(es1, hs)
    // (any other reserved slot: still reserved)
    have other: !(h = g && j = i) -> false proof
      assume ne
      have s2: A2.slots[h][j] = tag(3, empty) proof
        have c1: !(h = g) -> A2.slots[h][j] = tag(3, empty) proof
          assume nh
          show by simp(mp(all_elim(sh, {h}), nh), hs0)
        qed
        have c2: h = g && !(j = i) -> A2.slots[h][j] = tag(3, empty) proof
          assume q
          have qh qj := q
          have z := trans(mp(all_elim(sj, {j}), qj), rewrite(qh, hs0))
          show := subst({y. A2.slots[y][j] = tag(3, empty)}, sym(qh), z)
        qed
        show by taut(c1, c2, ne)
      qed
      have {gsl = slen} := gs
      have l2: int_lt(j, seq_len(A2.slots[h])) := rewrite(sym(mp(all_elim(gsl, {h}), hh)), rewrite(es1, hjl))
      have iu2: mallocng.is_used(A2, h) by defs(simp(expand(hu1, mallocng.is_used)), mallocng.is_used)
      have is2: mallocng.in_slot(A2.metas[h], j, x) by simp(em2, his)
      have ex: ex x0. ex x1. (x0 in omega && x1 in omega) && (((mallocng.is_used(A2, x0) && int_lt(x1, seq_len(A2.slots[x0]))) &&
          A2.slots[x0][x1] = tag(3, empty)) && mallocng.in_slot(A2.metas[x0], x1, x))
        by ex_intro({h}, {j}, taut(hh, hj, iu2, l2, s2, is2))
      have r2: mallocng.in_reserved(A2, x) by defs(ex, mallocng.in_reserved)
      show by taut(r2, nr2)
    qed
    have eq: h = g && j = i by taut(other)
    have eh ej := eq
    have his1 := rewrite(ej, rewrite(eh, his))
    have s1 s2 := all_elim(gsls, {i})
    have is0: mallocng.in_slot(A.metas[g], i, x) by defs(simp(s1, s2, em2, expand(his1, mallocng.in_slot)), mallocng.in_slot)
    show := mp(all_elim(hrw, {x}), xo, is0)
  qed
  have pm2 := apply(mp.perms_unsl[c := c, X := A1, S := mp.unres_sl(A, g, i), M := M2, b := b], pm, hrr)
  // the partially active groups: the lists and header bytes as before
  have pk: mp.partial_kept(A, A2, M, M2) proof
    fix sc h
    assume hn hs ol p2
    have hs0 _ := hn
    obtain k, hk hkl hke from expand(rewrite(eac, ol), mallocng.on_list)
    have iu0 _ _ := mp(all_elim(expand(hac0, mallocng.active_ok), {sc}, {k}), taut(hs0, hk), taut(hs, hkl))
    have iu := rewrite(hke, iu0)
    have {ho = nat, hmo = mem} := apply(mp.used_nat, ha, iu)
    have {gxh = hdr} := apply(mp.hdr_bytes, ha, ho, apply(mp.used_group, huo, iu))
    have {eb = byte} := apply(mp.agree_b8, mp(all_elim(gbe, {int_add(A.metas[h].mem, 8)}), arith(hmo), mp(all_elim(ingr, {h}, {int_add(A.metas[h].mem, 8)}), iu, gxh)))
    have {em = mem, el = last, es = stride} := apply(mp.gs_geom[A := A, A2 := A2, x := h], gs, ho)
    have q: mallocng.partial(M, A, h) by defs(arith(rewrite(em, rewrite(el, expand(p2, mallocng.partial))), eb), mallocng.partial)
    show by taut(rewrite(eac, ol), q, es, el)
  qed
  have po := apply(mp.partial_mono[A := A, A2 := A2, M := M, M2 := M2], hpo, pk)
  // the listed groups fitting their class: the lists as before; g with one
  // unused slot more, no own mapping
  have {hru = reuse} := expand(H, mallocng.holds)
  have rl: all sc x. sc in omega && x in omega -> int_lt(sc, 48) -> mallocng.on_list(A2.active[sc], x) -> mallocng.on_list(A.active[sc], x) proof
    fix sc x
    assume _ _ ol
    show := rewrite(eac, ol)
  qed
  have nog: !mallocng.own_mapping(A2.metas[g]) proof
    assume o
    have o2: mallocng.own_mapping(A.metas[g]) by defs(rewrite(fsc, rewrite(gst, expand(o, mallocng.own_mapping))), mallocng.own_mapping)
    show by taut(o2, hno)
  qed
  have ru0: all x. mallocng.has_unused(A2, x) -> mallocng.has_unused(A, x) || !mallocng.own_mapping(A2.metas[x]) proof
    fix x
    assume hx
    have cg: x = g -> !mallocng.own_mapping(A2.metas[x]) proof
      assume e
      show := subst({y. !mallocng.own_mapping(A2.metas[y])}, sym(e), nog)
    qed
    have co: !(x = g) -> mallocng.has_unused(A, x) proof
      assume ne
      have es := mp(all_elim(sh, {x}), ne)
      show by defs(rewrite(es, expand(hx, mallocng.has_unused)), mallocng.has_unused)
    qed
    show by taut(cg, co)
  qed
  have rm: all x. x in omega -> A2.metas[x].sizeclass = A.metas[x].sizeclass && mallocng.stride(A2.metas[x]) = mallocng.stride(A.metas[x]) proof
    fix x
    assume xo
    have {s1 = sclass, s2 = stride} := apply(mp.gs_geom[A := A, A2 := A2, x := x], gs, xo)
    show by taut(s1, s2)
  qed
  have ru := apply(mp.reuse_mono_g[A := A, A2 := A2], hru, rl, ru0, rm)
  show by defs(taut(im, rewrite(sym(sc2), cx), rewrite(sym(sf), fr), rewrite(sym(sa), ar), rewrite(sym(sp), rewrite(sym(ep), hpart)), us, rewrite(sym(sac), ac), po, ru,
    bl, nm2, rewrite(sym(sb), rewrite(sym(ebrk), hbrk)), pm2, rewrite(sym(sr), rewrite(sym(er), hsep)), hwf, cl, db, rewrite(sym(sx), rewrite(sym(efx), hfix)),
    rewrite(sym(sap), gp)), mallocng.holds)
qed

// (the state after: an abstract state)
theorem mp.unres_type(A, g, i): A in mallocng.Abs -> g in omega -> i in omega -> int_lt(i, seq_len(A.slots[g])) -> A.slots[g][i] = tag(3, empty) ->
  mallocng.bit(A.metas[g].freed, i) = 0 ->
  abs: mp.unres_abs(A, g, i) in mallocng.Abs && univ: mp.unres_abs(A, g, i) in univ(1)
proof
  assume ha hg hi hil hrs hbit
  let K := insert("secret", insert("init_done", insert("auxv_at", insert("auxv", insert("areas", insert("avail_cnt", insert("reserve", insert("reserve_cnt", insert("free_metas", insert("used", insert("metas", insert("active", insert("slots", insert("brk", insert("taken", empty)))))))))))))))
  let X := mp.unres_sl(A, g, i)
  have {a1 = abs1} := apply(mp.unres_state, ha, hg, hi, hil, hrs, hbit)
  have ap af ad := (mp.unres_m(A, g, i) in powerset(cart(K, univ(1))) && is_fun(mp.unres_m(A, g, i)) && dom(mp.unres_m(A, g, i)) = K by simp(expand(a1, mallocng.Abs)))
  have slt: A.slots[g] in list_type(mallocng.Use) := mp(fn_space_app[a := omega, b := list_type(mallocng.Use), f := A.slots, x := g], simp(ha), hg)
  have r0: tag(0, empty) in set_image(single(empty), x0. tag(0, x0)) by taut(set_image_def[s := single(empty), f := x0. tag(0, x0), y := tag(0, empty)],
    (ex x0. x0 in single(empty) && tag(0, x0) = tag(0, empty) by ex_intro({empty}, taut(single_intro[a := empty], refl({tag(0, empty)})))))
  have u0: tag(0, empty) in mallocng.Use by defs(simp(r0), mallocng.Use)
  have {l2 = list} := apply(mp.list_upd[l := A.slots[g], t := mallocng.Use, i := i, v := tag(0, empty)], slt, hi, hil, u0)
  have ss: A.slots in fn_space(omega, list_type(mallocng.Use)) by simp(ha)
  have xs := apply(mp.space_upd[a := omega, b := list_type(mallocng.Use), f := A.slots, k := g, v := fn_update(A.slots[g], i, tag(0, empty))], ss, hg, l2)
  have luu := mp(mp.list_univ[t := mallocng.Use], mp.use_univ)
  have xu := mp(fn_space_univ[u := 1, a := omega, b := list_type(mallocng.Use), f := X], omega_univ, luu, xs)
  have p2 := apply(mp.pow_upd[K := K, B := univ(1), r := mp.unres_m(A, g, i), k := "slots", v := X], ap, simp(), xu)
  have f2 d2 := mp(fn_update_fd[f := mp.unres_m(A, g, i), k := "slots", v := X, d := K], af, ad, simp())
  have au := mp(rec_univ[u := 1, k := K, r := mp.unres_m(A, g, i)], simp(x86.insert_univ), ap, af, ad)
  have a2: fn_update(mp.unres_m(A, g, i), "slots", X) in mallocng.Abs by defs(simp(p2, f2, d2, xs, au, xu, expand(a1, mallocng.Abs), expand(ha, mallocng.Abs)), mallocng.Abs)
  have u2 := mp(rec_univ[u := 1, k := K, r := fn_update(mp.unres_m(A, g, i), "slots", X)], simp(x86.insert_univ), p2, f2, d2)
  show by taut(a2, u2)
qed

// (the only reserved slot freed: its interior the allocator's again, in
// the view after)
theorem mp.unres_held(c, A, M, b, brk, g, i, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  mallocng.holds(c, A, M, b, brk) -> mallocng.is_used(A, g) -> i in omega -> mallocng.reserved_only(A, g, i) -> mallocng.bit(A.metas[g].freed, i) = 0 ->
  a in omega -> mallocng.in_slot(A.metas[g], i, a) -> a in mallocng.held(c, mp.unres_abs(A, g, i), b)
proof
  assume hc hu ha hb H hg hi hro hbit hao his
  let A2 := mp.unres_abs(A, g, i)
  have hil hrs ro := expand(hro, mallocng.reserved_only)
  have {huo = used, hga = apart} := expand(H, mallocng.holds)
  have {go = nat} := apply(mp.used_nat, ha, hg)
  have gok := apply(mp.used_group, huo, hg)
  have ir := apply(mp.slot_in_group, ha, go, hi, hao, gok, hil, his)
  // no client's: the slot reserved
  have iu: mallocng.is_used(A, g) := hg
  have ex: ex x0. ex x1. (x0 in omega && x1 in omega) && (((mallocng.is_used(A, x0) && int_lt(x1, seq_len(A.slots[x0]))) &&
      A.slots[x0][x1] = tag(3, empty)) && mallocng.in_slot(A.metas[x0], x1, a))
    by ex_intro({g}, {i}, taut(go, hi, iu, hil, hrs, his))
  have inr: mallocng.in_reserved(A, a) by defs(ex, mallocng.in_reserved)
  have nl := apply(mp.res_nolive[c := c, A := A, M := M, b := b, brk := brk, a := a], hc, hu, ha, hb, H, inr)
  // no slot reserved after: the only one freed
  have {a2 = abs, u2 = univ} := apply(mp.unres_type, ha, go, hi, hil, hrs, hbit)
  have {gs = geoms, em2 = metas, sg = sg, sj = sj, sh = sh} := apply(mp.unres_state, ha, go, hi, hil, hrs, hbit)
  have {gsl = slen} := gs
  have nr2: !mallocng.in_reserved(A2, a) proof
    assume r2
    obtain h j, hh hj _ hjl hs _ from expand(r2, mallocng.in_reserved)
    have c1: !(h = g) -> false proof
      assume nh
      have s0: A.slots[h][j] = tag(3, empty) by simp(mp(all_elim(sh, {h}), nh), hs)
      have jl0: int_lt(j, seq_len(A.slots[h])) by simp(mp(all_elim(sh, {h}), nh), hjl)
      have eh _ := mp(all_elim(ro, {h}, {j}), conj(hh, hj), conj(jl0, s0))
      show by taut(eh, nh)
    qed
    have c2: h = g && !(j = i) -> false proof
      assume q
      have qh qj := q
      have s0: A.slots[g][j] = tag(3, empty) := trans(sym(mp(all_elim(sj, {j}), qj)), rewrite(qh, hs))
      have jl0: int_lt(j, seq_len(A.slots[g])) := rewrite(mp(all_elim(gsl, {g}), go), rewrite(qh, hjl))
      have _ ej := mp(all_elim(ro, {g}, {j}), conj(go, hj), conj(jl0, s0))
      show by taut(ej, qj)
    qed
    have c3: h = g && j = i -> false proof
      assume q
      have qh qj := q
      have z := rewrite(qj, rewrite(qh, hs))
      show by defs(simp(trans(sym(z), sg)), tag)
    qed
    show by taut(c1, c2, c3)
  qed
  // not taken: a group's byte
  have nt := apply(mp.grp_untaken[c := c, A := A, M := M, b := b, brk := brk, g := g, a := a], hc, hu, ha, H, hg, hao, ir)
  have nt2: !mallocng.in_taken(A2, a) by defs(simp(expand(nt, mallocng.in_taken)), mallocng.in_taken)
  obtain k, hk hkl hke from expand(hg, mallocng.is_used)
  have eus := apply(mp.gs_field[A := A, A2 := A2, k := "used"], gs, simp(), simp(), simp(), simp())
  have {gr = range} := apply(mp.gs_geom[A := A, A2 := A2, x := g], gs, go)
  have ir2: mallocng.in_range(a, mallocng.group_range(A2.metas[A2.used[k]])) by simp(eus, hke, gr, ir)
  have kl2: int_lt(k, seq_len(A2.used)) by simp(eus, hkl)
  have fp2 := apply(mp.group_fp[c := c, A := A2, b := b, k := k, a := a], hc, u2, a2, hk, kl2, hao, ir2, nl, nr2, nt2)
  // not the context's: a group apart from the fixed regions
  have na := mp(all_elim(expand(hga, mallocng.groups_apart), {k}, {a}), conj(hk, hao), conj(hkl, rewrite(sym(hke), ir)))
  have nc: !mallocng.in_range(a, pair(c.ctx, mallocng.CTX_SIZE)) proof
    assume hin
    have cf := apply(mp.ctx_front[c := c, A := A, a := a], hc, hu, ha, hin)
    have fi := apply(mp.fixed_in[c := c, A := A, a := a], hc, hu, ha, taut(cf))
    show by taut(fi, na)
  qed
  show := apply(mp.held_out, fp2, nc)
qed

// (a reserved slot: its freed bit clear -- in neither mask)
theorem mp.res_freed0(c, A, M, b, brk, g, i): A in mallocng.Abs -> mallocng.holds(c, A, M, b, brk) -> mallocng.is_used(A, g) -> i in omega ->
  int_lt(i, seq_len(A.slots[g])) -> A.slots[g][i] = tag(3, empty) ->
  bit: mallocng.bit(A.metas[g].freed, i) = 0 && last: int_le(i, A.metas[g].last_idx)
proof
  assume ha H hg hi hil hrs
  have {huo = used} := expand(H, mallocng.holds)
  have {go = nat} := apply(mp.used_nat, ha, hg)
  have gokg := apply(mp.used_group, huo, hg)
  have {hmg = mim, hmkg = masks, gl = nslots} := expand(gokg, mallocng.group_ok)
  have vt: A.metas[g] in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A.metas, x := g], simp(ha), go)
  have avo: A.metas[g].avail in omega by simp(vt)
  have fo: A.metas[g].freed in omega by simp(vt)
  have vlo: A.metas[g].last_idx in omega by simp(vt)
  have {ml = last} := expand(hmg, mallocng.meta_in_memory)
  have ile: int_le(i, A.metas[g].last_idx) by arith(gl, hil, hi, vlo)
  have i32: int_lt(i, 32) by arith(ile, ml)
  have _ _ cc _ := mp(all_elim(expand(hmkg, mallocng.masks_ok), {i}), hi, i32)
  have x _ := mp(cc, ile)
  have n0: !(A.slots[g][i] = tag(0, empty)) by defs(simp(hrs), tag)
  have ab0: mallocng.bit(A.metas[g].avail, i) in omega by simp(apply(mp.nbit[x := A.metas[g].avail, i := i], avo, hi))
  have fb0: mallocng.bit(A.metas[g].freed, i) in omega by simp(apply(mp.nbit[x := A.metas[g].freed, i := i], fo, hi))
  have z0: !int_lt(0, int_add(mallocng.bit(A.metas[g].avail, i), mallocng.bit(A.metas[g].freed, i))) by taut(x, n0)
  have hfb: mallocng.bit(A.metas[g].freed, i) = 0 by arith(z0, ab0, fb0)
  show by taut(hfb, ile)
qed

// (the only reserved slot freed: none reserved after)
theorem mp.unres_nores(A, g, i): A in mallocng.Abs -> g in omega -> i in omega -> mallocng.reserved_only(A, g, i) -> mallocng.bit(A.metas[g].freed, i) = 0 ->
  mallocng.no_reserved(mp.unres_abs(A, g, i))
proof
  assume ha go hi hro hbit
  let A2 := mp.unres_abs(A, g, i)
  have hil hrs ro := expand(hro, mallocng.reserved_only)
  have {gs = geoms, sg = sg, sj = sj, sh = sh} := apply(mp.unres_state, ha, go, hi, hil, hrs, hbit)
  have {gsl = slen} := gs
  have k: all h j. h in omega && j in omega -> int_lt(j, seq_len(A2.slots[h])) -> !(A2.slots[h][j] = tag(3, empty)) proof
    fix h j
    assume hhj hjl hs
    have hh hj := hhj
    have c1: !(h = g) -> false proof
      assume nh
      have s0: A.slots[h][j] = tag(3, empty) by simp(mp(all_elim(sh, {h}), nh), hs)
      have jl0: int_lt(j, seq_len(A.slots[h])) by simp(mp(all_elim(sh, {h}), nh), hjl)
      have eh _ := mp(all_elim(ro, {h}, {j}), conj(hh, hj), conj(jl0, s0))
      show by taut(eh, nh)
    qed
    have c2: h = g && !(j = i) -> false proof
      assume q
      have qh qj := q
      have s0: A.slots[g][j] = tag(3, empty) := trans(sym(mp(all_elim(sj, {j}), qj)), rewrite(qh, hs))
      have jl0: int_lt(j, seq_len(A.slots[g])) := rewrite(mp(all_elim(gsl, {g}), go), rewrite(qh, hjl))
      have _ ej := mp(all_elim(ro, {g}, {j}), conj(go, hj), conj(jl0, s0))
      show by taut(ej, qj)
    qed
    have c3: h = g && j = i -> false proof
      assume q
      have qh qj := q
      have z := rewrite(qj, rewrite(qh, hs))
      show by defs(simp(trans(sym(z), sg)), tag)
    qed
    show by taut(c1, c2, c3)
  qed
  show by defs(k, mallocng.no_reserved)
qed

// ----------------------------------------------------------------------
//  The invariant in memory kept by the only reserved slot freed: its bit
//  written to g's freed mask (no other byte, nothing but bytes); g no
//  group mapped on its own. The slot's interior the allocator's again.
theorem mp.holds_m_unres(c, A, vm, vm2, b, g, i): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  mallocng.holds_m(c, A, vm, b) -> mallocng.is_used(A, g) -> i in omega -> mallocng.reserved_only(A, g, i) -> !mallocng.own_mapping(A.metas[g]) ->
  (all x. x in bits(64) -> !(int_le(int_add(g, 24), x) && int_lt(x, int_add(g, 32))) -> vm2.bytes[x] = vm.bytes[x]) ->
  vm2.pages = vm.pages -> vm2.brk = vm.brk -> vm2.stack_top = vm.stack_top -> vm2.stack_limit = vm.stack_limit ->
  mallocng.rd(mallocng.mview(vm2, mallocng.held(c, mp.unres_abs(A, g, i), b)), int_add(g, 24), 4) = A.metas[g].avail ->
  mallocng.rd(mallocng.mview(vm2, mallocng.held(c, mp.unres_abs(A, g, i), b)), int_add(g, 28), 4) = int_add(A.metas[g].freed, pow2(i)) ->
  abs: mp.unres_abs(A, g, i) in mallocng.Abs && univ: mp.unres_abs(A, g, i) in univ(1) && nores: mallocng.no_reserved(mp.unres_abs(A, g, i)) &&
  holds: mallocng.holds_m(c, mp.unres_abs(A, g, i), vm2, b)
proof
  assume hc hu ha hb hh hg hi hro hno eb ep ek et el rav rfr
  let A2 := mp.unres_abs(A, g, i)
  let FP := mallocng.held(c, A, b)
  let M := mallocng.mview(vm, FP)
  let FP2 := mallocng.held(c, A2, b)
  let M1 := mallocng.mview(vm, FP2)
  let M2 := mallocng.mview(vm2, FP2)
  have {H = inv, hm = mapped, hfr = free, hrs = rsv, hmq = maps} := expand(hh, mallocng.holds_m)
  have hil hrs0 _ := expand(hro, mallocng.reserved_only)
  have {go = nat} := apply(mp.used_nat, ha, hg)
  have {hfb = bit} := apply(mp.res_freed0[c := c, A := A, M := M, b := b, brk := vm.brk, g := g, i := i], ha, H, hg, hi, hil, hrs0)
  have {a2 = abs, u2 = univ} := apply(mp.unres_type, ha, go, hi, hil, hrs0, hfb)
  have {mo = mo, gs = geoms} := apply(mp.unres_state, ha, go, hi, hil, hrs0, hfb)
  have nr2 := apply(mp.unres_nores, ha, go, hi, hro, hfb)
  have rs2 := apply(mp.rsv_pages[A := A, A2 := A2, vm := vm, vm2 := vm2], hrs, (A2.reserve = A.reserve by simp()), (A2.reserve_cnt = A.reserve_cnt by simp()), ep, et, el)
  have fpr: mallocng.fp_ranges(c, A2) = mallocng.fp_ranges(c, A) := trans((mallocng.fp_ranges(c, A2) = mallocng.fp_ranges(c, mp.unres_m(A, g, i)) by defs(simp(), mallocng.fp_ranges,
    mallocng.fixed_ranges, mallocng.auxv_ranges)), apply(mp.mo_ranges[c := c, A := A, A2 := mp.unres_m(A, g, i)], ha, mo))
  // (1) the view widened: the same but at the reserved slot
  have restr: all a. a in omega -> !mallocng.in_reserved(A, a) -> M1[a] = M[a] proof
    fix a
    assume hao nr1
    have n2 := apply(mp.nores[A := A2, a := a], nr2)
    have {hmem = held} := apply(mp.fp_same[c := c, A := A, A2 := A2, b := b, a := a], hao, fpr, simp(), nr1, n2)
    show := apply(mp.view_mem[vm := vm, F1 := FP2, F2 := FP, a := a], hao, hmem)
  qed
  have h1 := apply(mp.holds_restrict[c := c, A := A, M := M, M2 := M1, b := b, brk := vm.brk, g := g], hc, hu, ha, hb, H, hg, restr)
  // (2) the freed mask written
  have ear: mallocng.auxv_ranges(A2) = mallocng.auxv_ranges(A) by defs(simp(), mallocng.auxv_ranges)
  have mp2 := rewrite(sym(ear), rewrite(sym(fpr), apply(mp.fpm_pages, hm, ep, et, el)))
  have mp1 := rewrite(sym(ear), rewrite(sym(fpr), hm))
  have ag: all a. a in omega -> !(int_le(int_add(g, 24), a) && int_lt(a, int_add(g, 32))) -> M2[a] = M1[a] proof
    fix a
    assume hao hw
    have bt: a in FP2 -> vm2.bytes[bits_of_int(64, a)] = vm.bytes[bits_of_int(64, a)] proof
      assume hf
      have {hff = fp} := apply(mp.held_fp, hf)
      have lo := apply(mp.fp_low[c := c, A := A2, vm := vm, b := b, a := a], mp1, hff)
      have e: bits_of_int(64, a) = a by defs(arith(hao, lo), bits_of_int, pow2)
      have ab: a in bits(64) by arith(hao, lo)
      show := rewrite(sym(e), mp(all_elim(eb, {a}), ab, hw))
    qed
    show := apply(mp.view_agree[vm := vm, vm2 := vm2, fp := FP2, a := a], hao, bt, ep)
  qed
  have pg: all a. a in omega -> mallocng.pg(M2, a) = mallocng.pg(M1, a) proof
    fix a
    assume hao
    show := apply(mp.view_pg[vm := vm, vm2 := vm2, fp := FP2, a := a], hao, ep)
  qed
  // (the slot's interior: a group's bytes, accessible)
  have ga := apply(mp.grp_all_of, hc, hu, ha, hh)
  have {huo = used} := expand(H, mallocng.holds)
  have gok := apply(mp.used_group, huo, hg)
  have hrw: all a. a in omega -> mallocng.in_slot(A.metas[g], i, a) -> mallocng.m_rw(M2, a) && !(snd(mallocng.pg(M2, a)).kind = 2) proof
    fix a
    assume hao his
    have ir := apply(mp.slot_in_group, ha, go, hi, hao, gok, hil, his)
    have rwa ka := mp(all_elim(ga, {g}, {a}), conj(go, hao), conj(hg, ir))
    have hf := apply(mp.unres_held[c := c, A := A, M := M, b := b, brk := vm.brk, g := g, i := i, a := a], hc, hu, ha, hb, H, hg, hi, hro, hfb, hao, his)
    have p2 := apply(mp.pg_view[vm := vm2, fp := FP2, a := a], hao, hf)
    have pa := apply(mp.pg_view[vm := vm, fp := mallocng.all_bytes, a := a], hao, (a in mallocng.all_bytes by defs(simp(hao), mallocng.all_bytes)))
    have pe: mallocng.pg(M2, a) = mallocng.pg(mallocng.mview(vm, mallocng.all_bytes), a) by simp(p2, pa, ep)
    have r2: mallocng.m_rw(M2, a) by defs(simp(pe, expand(expand(rwa, mallocng.m_rw), mallocng.m_mapped)), mallocng.m_rw, mallocng.m_mapped)
    have k2: !(snd(mallocng.pg(M2, a)).kind = 2) := rewrite(sym(pe), ka)
    show by taut(r2, k2)
  qed
  have h2 := apply(mp.holds_unreserve[c := c, A := A, M := M1, M2 := M2, b := b, brk := vm.brk, g := g, i := i], hc, hu, ha, hb, h1, hg, hi, hil, hrs0, hno,
    ag, pg, rav, rfr, hrw)
  have i2 := rewrite(sym(ek), h2)
  // the context's free bytes: in neither state's reserved slots
  have d0 _ _ := apply(mp.data_at[c := c])
  have fr1 := apply(mp.free_rw_pages[c := c, vm := vm, vm2 := vm2, F := mallocng.footprint(c, A, b)], hfr, ep)
  have fm: all a. a in omega -> mallocng.ctx_free(c, a) -> (a in mallocng.footprint(c, A, b) <-> a in mallocng.footprint(c, A2, b)) proof
    fix a
    assume hao cf
    have k1: mallocng.C_MMAP_CNT = 12 by defs(refl({12}), mallocng.C_MMAP_CNT)
    have k2: mallocng.C_META_SHIFT = 48 by defs(refl({48}), mallocng.C_META_SHIFT)
    have k3: mallocng.C_USAGE = 464 by defs(refl({464}), mallocng.C_USAGE)
    have k4: mallocng.C_BRK = 920 by defs(refl({920}), mallocng.C_BRK)
    have cco: c.ctx in omega by simp(hc)
    have cr1 cr2 := (int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, 928)) by arith(expand(cf, mallocng.ctx_free), k1, k2, k3, k4, cco, hao))
    have ic: mallocng.in_range(a, mallocng.data_ranges(c)[0]) by defs(simp(d0, cr1, cr2), mallocng.in_range, mallocng.CTX_SIZE)
    have nr1 := apply(mp.unres_data[c := c, A := A, M := M, b := b, brk := vm.brk, k := 0, a := a], hc, hu, ha, H, hao, simp(), simp(), ic)
    have n2 := apply(mp.nores[A := A2, a := a], nr2)
    have {ff = fp} := apply(mp.fp_same[c := c, A := A, A2 := A2, b := b, a := a], hao, fpr, simp(), nr1, n2)
    show by taut(ff)
  qed
  have fr2 := apply(mp.free_rw_mem[c := c, vm := vm2, F1 := mallocng.footprint(c, A, b), F2 := mallocng.footprint(c, A2, b)], fr1, fm)
  have rw2 := apply(mp.grp_rw_of_all[c := c, A := A2, vm := vm2, b := b], apply(mp.grp_rw_gs[A := A, A2 := A2, vm := vm, vm2 := vm2], gs, ga, ep))
  have mq2 := apply(mp.maps_pages[A := A, A2 := A2, vm := vm, vm2 := vm2], hmq, apply(mp.maps_gs, gs), ep, et, el)
  have hin2: mallocng.holds_m(c, A2, vm2, b) by defs(taut(i2, mp2, fr2, rw2, rs2, mq2), mallocng.holds_m)
  show by taut(a2, u2, nr2, hin2)
qed

// ----------------------------------------------------------------------
//  A group queued on a class's list (any list: free's queue)
// (a list with g appended: its elements)
theorem mp.snoc_at(L, g, k): L in list_type(omega) -> g in omega -> k in omega ->
  len: seq_len(seq_concat(L, seq_one(g))) = int_add(seq_len(L), 1) &&
  old: (int_lt(k, seq_len(L)) -> seq_concat(L, seq_one(g))[k] = L[k]) &&
  new: seq_concat(L, seq_one(g))[seq_len(L)] = g
proof
  assume hl hg hk
  have xl := mp(all_elim(tr.seq_one_type, {g}, {omega}), hg)
  have ln: seq_len(seq_concat(L, seq_one(g))) = int_add(seq_len(L), 1) by arith(hl, xl)
  have o: int_lt(k, seq_len(L)) -> seq_concat(L, seq_one(g))[k] = L[k] proof
    assume h
    show := at({seq_concat(L, seq_one(g))[k]}, hl, xl, hk, h)
  qed
  have n0 := at({seq_concat(L, seq_one(g))[int_add(seq_len(L), 0)]}, hl, xl, (0 in omega by simp()), (int_lt(0, seq_len(seq_one(g))) by simp()))
  have e0: int_add(seq_len(L), 0) = seq_len(L) by arith(hl)
  have nw: seq_concat(L, seq_one(g))[seq_len(L)] = g by simp(rewrite(e0, n0))
  show by taut(ln, o, nw)
qed

theorem mp.snoc_on(L, g, x): L in list_type(omega) -> g in omega ->
  (mallocng.on_list(seq_concat(L, seq_one(g)), x) <-> mallocng.on_list(L, x) || x = g)
proof
  assume hl hg
  let l2 := seq_concat(L, seq_one(g))
  have lo: seq_len(L) in omega by arith(hl)
  have {ln = len, nw = new} := apply(mp.snoc_at[L := L, g := g, k := 0], hl, hg, simp())
  have d1: mallocng.on_list(l2, x) -> mallocng.on_list(L, x) || x = g proof
    assume h
    obtain k, hk hkl hke from expand(h, mallocng.on_list)
    have {ok = old} := apply(mp.snoc_at[L := L, g := g, k := k], hl, hg, hk)
    have c1: int_lt(k, seq_len(L)) -> mallocng.on_list(L, x) proof
      assume hl2
      have e := mp(ok, hl2)
      show by defs(ex_intro({k}, taut(hk, hl2, trans(sym(e), hke))), mallocng.on_list)
    qed
    have c2: !int_lt(k, seq_len(L)) -> x = g proof
      assume hl2
      have kn: k = seq_len(L) by arith(hk, hl2, hkl, ln, lo)
      have q := rewrite(sym(kn), nw)
      show := trans(sym(hke), q)
    qed
    show by taut(c1, c2)
  qed
  have d2: mallocng.on_list(L, x) || x = g -> mallocng.on_list(l2, x) proof
    assume h
    have c1: mallocng.on_list(L, x) -> mallocng.on_list(l2, x) proof
      assume hx
      obtain k, hk hkl hke from expand(hx, mallocng.on_list)
      have {ok = old} := apply(mp.snoc_at[L := L, g := g, k := k], hl, hg, hk)
      have e := mp(ok, hkl)
      have kl2: int_lt(k, seq_len(l2)) by arith(hkl, ln)
      show by defs(ex_intro({k}, taut(hk, kl2, trans(e, hke))), mallocng.on_list)
    qed
    have c2: x = g -> mallocng.on_list(l2, x) proof
      assume e
      have kl2: int_lt(seq_len(L), seq_len(l2)) by arith(ln, lo)
      show by defs(ex_intro({seq_len(L)}, taut(lo, kl2, trans(nw, sym(e)))), mallocng.on_list)
    qed
    show by taut(h, c1, c2)
  qed
  show by taut(d1, d2)
qed

// a group in use, on no list (its links 0), joinable to class sc's list
theorem mp.join_any(c, A, vm, b, objs, sc, g): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> vm.bytes in fn_space(bits(64), bits(8)) ->
  mallocng.holds_m(c, A, vm, b) -> mallocng.shown_in(c, A, objs) -> sc in omega -> int_lt(sc, 48) -> !mallocng.on_list(A.active[sc], g) ->
  mallocng.is_used(A, g) -> A.metas[g].prev = 0 -> A.metas[g].next = 0 ->
  mallocng_specs.joinable(vm, objs, int_add(int_add(c.ctx, mallocng.C_ACTIVE), int_mul(8, sc)), A.active[sc], g)
proof
  assume hc hu ha hvb hh hsh hs hsl hnl hg hp0 hn0
  have VS := apply(mp.held_vis[c := c, A := A, objs := objs, b := b], hsh)
  let F := mallocng.held(c, A, b)
  let M := mallocng.mview(vm, F)
  let PH := int_add(int_add(c.ctx, mallocng.C_ACTIVE), int_mul(8, sc))
  have {H = inv} := expand(hh, mallocng.holds_m)
  have {huo = used, hac = active} := expand(H, mallocng.holds)
  have ms := apply(mp.used_slot, H, hg)
  have gun := apply(mp.used_untaken, H, hg)
  have {go = nat, gal = al, gb = bound, inr = acc, gout = out} := apply(mp.slot_meta[c := c, A := A, vm := vm, b := b, g := g], hc, hu, ha, hh, ms, gun)
  have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  have ka: mallocng.C_ACTIVE = 80 by defs(refl({80}), mallocng.C_ACTIVE)
  have co: c.ctx in omega by simp(hc)
  have p64: int_pow(2, 64) = 18446744073709551616 by simp()
  // its link words: the allocator's, accessible
  have w0: all j. j in omega -> int_lt(j, 8) -> int_add(int_add(g, 0), j) in F && mallocng.m_rw(M, int_add(int_add(g, 0), j)) &&
      !(snd(mallocng.pg(M, int_add(int_add(g, 0), j))).kind = 2) proof
    fix j
    assume hj hjl
    show := mp(all_elim(inr, {int_add(int_add(g, 0), j)}), arith(go, hj), arith(go, hj), arith(go, hj, hjl))
  qed
  have w8: all j. j in omega -> int_lt(j, 8) -> int_add(int_add(g, 8), j) in F && mallocng.m_rw(M, int_add(int_add(g, 8), j)) &&
      !(snd(mallocng.pg(M, int_add(int_add(g, 8), j))).kind = 2) proof
    fix j
    assume hj hjl
    show := mp(all_elim(inr, {int_add(int_add(g, 8), j)}), arith(go, hj), arith(go, hj), arith(go, hj, hjl))
  qed
  have glo: int_le(24, g) by taut(apply(mp.slot_meta[c := c, A := A, vm := vm, b := b, g := g], hc, hu, ha, hh, ms, gun))
  have nz: !(g = 0) by arith(glo, go)
  have k0 := apply(mp.word_rw[vm := vm, F := F, objs := objs, p := g, off := 0], go, simp(), nz, arith(gb), w0, VS)
  have k8 := apply(mp.word_rw[vm := vm, F := F, objs := objs, p := g, off := 8], go, simp(), nz, arith(gb), w8, VS)
  have g16: int_le(int_add(g, 16), int_pow(2, 64)) by arith(gb, p64)
  have off: int_le(int_add(PH, 8), g) || int_le(int_add(g, 16), PH) by arith(gout, ks, ka, co, hs, hsl)
  // apart from the list's groups: other metas
  have ol: all x0. x0 in omega -> int_lt(x0, seq_len(A.active[sc])) -> int_le(int_add(A.active[sc][x0], 16), g) || int_le(int_add(g, 16), A.active[sc][x0]) proof
    fix x0
    assume hx hxl
    let l := A.active[sc][x0]
    have lu _ _ := mp(all_elim(expand(hac, mallocng.active_ok), {sc}, {x0}), conj(hs, hx), conj(hsl, hxl))
    have ne: !(l = g) proof
      assume e
      have on: mallocng.on_list(A.active[sc], g) by defs(ex_intro({x0}, taut(hx, hxl, e)), mallocng.on_list)
      show by taut(on, hnl)
    qed
    have lsl := apply(mp.used_slot, H, lu)
    have lun := apply(mp.used_untaken, H, lu)
    have {lo = nat} := apply(mp.slot_meta[c := c, A := A, vm := vm, b := b, g := l], hc, hu, ha, hh, lsl, lun)
    have d1 := apply(mp.meta_disj[c := c, A := A, M := M, b := b, brk := vm.brk, g := g, l := l, a := l], hc, hu, ha, H, ms, lsl, ne, lo, arith(lo), arith(lo))
    have d2 := apply(mp.meta_disj[c := c, A := A, M := M, b := b, brk := vm.brk, g := l, l := g, a := g], hc, hu, ha, H, lsl, ms, (!(g = l) by taut(ne)), go, arith(go), arith(go))
    show by arith(d1, d2, lo, go)
  qed
  // its links read: 0
  have gok := apply(mp.used_group, huo, hg)
  have {mim} := expand(gok, mallocng.group_ok)
  have {mpv = prev, mnx = next} := expand(mim, mallocng.meta_in_memory)
  have i0: all j. j in omega -> int_lt(j, 8) -> int_add(g, j) in F proof
    fix j
    assume hj hjl
    have q _ _ := mp(all_elim(inr, {int_add(g, j)}), arith(go, hj), arith(go, hj), arith(go, hj, hjl))
    show := q
  qed
  have i8: all j. j in omega -> int_lt(j, 8) -> int_add(int_add(g, 8), j) in F proof
    fix j
    assume hj hjl
    have q _ _ := mp(all_elim(w8, {j}), hj, hjl)
    show := q
  qed
  have r0 := apply(mp.view_read[vm := vm, fp := F, a := g, n := 8], go, simp(), simp(), i0)
  have r8 := apply(mp.view_read[vm := vm, fp := F, a := int_add(g, 8), n := 8], arith(go), simp(), simp(), i8)
  have z0: mallocng_specs.rd64(vm, g) = 0 by defs(simp(trans(r0, trans(mpv, hp0))), mallocng_specs.rd64)
  have a8: bits_add(64, g, 8) = int_add(g, 8) by defs(arith(go, gb), bits_add, pow2)
  have z8: mallocng_specs.rd64(vm, bits_add(64, g, 8)) = 0 by defs(simp(a8, trans(r8, trans(mnx, hn0))), mallocng_specs.rd64)
  show by defs(taut(g16, k0, k8, gal, off, ol, z0, z8), mallocng_specs.joinable)
qed

// The invariant kept by a group queued at the end of class sc's list: g in
// use, of class sc, on no list (its links 0), not partially active; past
// the head (the list not empty) full or with a slot freed: none
// available, some freed; with an unused slot no own mapping. The queue's
// effect on the list (`queued` at it): g appended, only links written
theorem mp.qu_step_g(c, A, vm, V, b, objs, sc, g): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  vm in x86_64_linux.Vm -> V in x86_64_linux.Vm -> mallocng.holds_m(c, A, vm, b) -> mallocng.shown_in(c, A, objs) -> int_mod(c.ctx, 8) = 0 -> sc in omega -> int_lt(sc, 48) ->
  !mallocng.on_list(A.active[sc], g) -> mallocng.is_used(A, g) -> A.metas[g].sizeclass = sc -> A.metas[g].prev = 0 -> A.metas[g].next = 0 ->
  !mallocng.partial(mallocng.mview(vm, mallocng.held(c, A, b)), A, g) ->
  (int_lt(0, seq_len(A.active[sc])) -> A.metas[g].avail = 0 && !(A.metas[g].freed = 0)) ->
  (mallocng.has_unused(A, g) -> !mallocng.own_mapping(A.metas[g])) ->
  mallocng_specs.list_at(V, objs, int_add(int_add(c.ctx, mallocng.C_ACTIVE), int_mul(8, sc)), seq_concat(A.active[sc], seq_one(g))) ->
  mallocng_specs.links_only(vm, V, int_add(int_add(c.ctx, mallocng.C_ACTIVE), int_mul(8, sc)), seq_concat(A.active[sc], seq_one(g))) ->
  abs: mp.enlist(A, sc, seq_concat(A.active[sc], seq_one(g)), V) in mallocng.Abs && univ: mp.enlist(A, sc, seq_concat(A.active[sc], seq_one(g)), V) in univ(1) &&
  holds: mallocng.holds_m(c, mp.enlist(A, sc, seq_concat(A.active[sc], seq_one(g)), V), V, b) &&
  unt: mallocng.kept_outside(c, A, b, vm, V, empty) &&
  slots: mp.enlist(A, sc, seq_concat(A.active[sc], seq_one(g)), V).slots = A.slots &&
  list: mp.enlist(A, sc, seq_concat(A.active[sc], seq_one(g)), V).active[sc] = seq_concat(A.active[sc], seq_one(g)) &&
  geom: mp.geom(A, mp.enlist(A, sc, seq_concat(A.active[sc], seq_one(g)), V))
proof
  assume hc hu ha hb hvm hV hh hsh cal hs hsl hnl hg hsc hp0 hn0 hnp htl hreu at2 only2
  let L := A.active[sc]
  let l2 := seq_concat(L, seq_one(g))
  have vb: vm.bytes in fn_space(bits(64), bits(8)) by simp(hvm)
  have vb2: V.bytes in fn_space(bits(64), bits(8)) by simp(hV)
  have {H = inv} := expand(hh, mallocng.holds_m)
  have {cok = ctx, hfr = fresh, hac = active} := expand(H, mallocng.holds)
  have {c11 = nactive} := expand(cok, mallocng.ctx_ok)
  have al: A.active in list_type(list_type(omega)) by simp(ha)
  have lt := mp(at_type[l := A.active, t := list_type(omega), i := sc], al, hs, (int_lt(sc, seq_len(A.active)) by arith(c11, hsl)))
  have {go = nat} := apply(mp.used_nat, ha, hg)
  have xl := mp(all_elim(tr.seq_one_type, {g}, {omega}), go)
  have l2t: l2 in list_type(omega) := mp(all_elim(tr.concat_list, {L}, {seq_one(g)}, {omega}), lt, xl)
  // the queue's memory: g appended
  have la := apply(mp.active_at[c := c, A := A, vm := vm, b := b, objs := objs, sc := sc], hc, hu, ha, vb, hh, hsh, cal, hs, hsl)
  // its groups: the list's, and g joining
  have onl: all x. mallocng.on_list(l2, x) <-> mallocng.on_list(L, x) || x = g proof
    fix x
    show := apply(mp.snoc_on[L := L, g := g, x := x], lt, go)
  qed
  have kold: all x. mallocng.on_list(L, x) -> mallocng.on_list(l2, x) proof
    fix x
    assume h
    show by taut(h, all_elim(onl, {x}))
  qed
  have knew: all x. mallocng.on_list(l2, x) -> !mallocng.on_list(L, x) -> mallocng.is_used(A, x) && A.metas[x].sizeclass = sc proof
    fix x
    assume h1 h2
    have e: x = g by taut(h1, h2, all_elim(onl, {x}))
    show := subst({y. mallocng.is_used(A, y) && A.metas[y].sizeclass = sc}, sym(e), conj(hg, hsc))
  qed
  have sub: all x. mallocng.on_list(l2, x) -> mallocng.on_list(l2, x) proof
    fix x
    assume h
    show h
  qed
  have gone: all x. mallocng.on_list(l2, x) -> !mallocng.on_list(l2, x) -> gimple.bytes_at(V, x, 8) = 0 && gimple.bytes_at(V, int_add(x, 8), 8) = 0 proof
    fix x
    assume h1 h2
    show by taut(h1, h2)
  qed
  have P: mp.rlpre(c, A, vm, V, b, objs, sc, l2, l2) by taut(hc, hu, ha, hb, vb, vb2, hh, hs, hsl, only2, at2, l2t, kold, knew, sub, gone)
  // past the head: the list's groups past its head, and g if the list was not empty
  have lo: seq_len(L) in omega by arith(lt)
  have htail: all k. k in omega -> int_lt(0, k) -> int_lt(k, seq_len(l2)) -> A.metas[l2[k]].avail = 0 && !(A.metas[l2[k]].freed = 0) proof
    fix k
    assume hk hp hkl
    have {ln = len, ok = old, nw = new} := apply(mp.snoc_at[L := L, g := g, k := k], lt, go, hk)
    have c1: int_lt(k, seq_len(L)) -> A.metas[l2[k]].avail = 0 && !(A.metas[l2[k]].freed = 0) proof
      assume hl
      have e := mp(ok, hl)
      have _ _ t := mp(all_elim(expand(hac, mallocng.active_ok), {sc}, {k}), conj(hs, hk), conj(hsl, hl))
      show := rewrite(sym(e), mp(t, hp))
    qed
    have c2: !int_lt(k, seq_len(L)) -> A.metas[l2[k]].avail = 0 && !(A.metas[l2[k]].freed = 0) proof
      assume hl
      have kn: k = seq_len(L) by arith(hk, hl, hkl, ln, lo)
      have q := rewrite(sym(kn), nw)
      have ne: int_lt(0, seq_len(L)) by arith(kn, hp)
      show := rewrite(sym(q), mp(htl, ne))
    qed
    show by taut(c1, c2)
  qed
  // initialized: a group in use
  have nz: !(A.init_done = 0) proof
    assume z
    have {lu = used} := mp(expand(hfr, mallocng.fresh_ok), z)
    obtain k, hk hkl _ from expand(hg, mallocng.is_used)
    show by arith(hk, hkl, lu)
  qed
  have nb: all x. mallocng.on_list(l2, x) -> !mallocng.on_list(L, x) -> mallocng.partial(mallocng.mview(vm, mallocng.held(c, A, b)), A, x) ->
      int_lt(4096, int_add(mallocng.UNIT, int_mul(mallocng.stride(A.metas[x]), int_add(A.metas[x].last_idx, 1)))) proof
    fix x
    assume h1 h2 hp
    have e: x = g by taut(h1, h2, all_elim(onl, {x}))
    have f: false by taut(rewrite(e, hp), hnp)
    show by taut(f)
  qed
  have nu: all x y. mallocng.on_list(l2, x) -> !mallocng.on_list(L, x) -> mallocng.on_list(l2, y) ->
      mallocng.partial(mallocng.mview(vm, mallocng.held(c, A, b)), A, x) -> mallocng.partial(mallocng.mview(vm, mallocng.held(c, A, b)), A, y) -> x = y proof
    fix x y
    assume h1 h2 _ hp _
    have e: x = g by taut(h1, h2, all_elim(onl, {x}))
    have f: false by taut(rewrite(e, hp), hnp)
    show by taut(f)
  qed
  have nr: all x. mallocng.on_list(l2, x) -> !mallocng.on_list(L, x) -> mallocng.has_unused(A, x) -> !mallocng.own_mapping(A.metas[x]) proof
    fix x
    assume h1 h2
    have e: x = g by taut(h1, h2, all_elim(onl, {x}))
    show := subst({y. mallocng.has_unused(A, y) -> !mallocng.own_mapping(A.metas[y])}, sym(e), hreu)
  qed
  have po := apply(mp.relink_partial, P, nb, nu)
  have ru := apply(mp.relink_reuse, P, nr)
  have hr := apply(mp.holds_relink, P, htail, nz, po, ru)
  have {a2 = abs, u2 = univ} := apply(mp.relink_abs[A := A, sc := sc, l2 := l2, K := l2, vm := V], ha, l2t, vb2)
  have {hg2 = geom} := apply(mp.relink_geom[A := A, sc := sc, l2 := l2, K := l2, vm := V], ha)
  have ut := apply(mp.rl_unt, P)
  have rsl: mp.enlist(A, sc, l2, V).slots = A.slots by defs(simp(), mp.relink)
  have {rlt = list} := apply(mp.relink_at[A := A, sc := sc, l2 := l2, K := l2, vm := V], ha)
  have rs: mp.enlist(A, sc, l2, V).active[sc] = l2 := trans(mp(all_elim(rlt, {sc}), hs, (int_lt(sc, seq_len(A.active)) by arith(hsl, c11))), mp(ite_t[c := sc = sc, a := l2, b := A.active[sc]], refl({sc})))
  show by taut(a2, u2, hr, ut, rsl, rs, hg2)
qed
