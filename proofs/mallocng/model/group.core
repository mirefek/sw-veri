// A group in use as the code reads it (`mp.grp_acc`), its masks' bits;
// records updated.

// A group in use: its meta record and its header's active index byte
// accessible, the record's words the abstract fields, the byte the
// invariant's
theorem mp.grp_acc(c, A, vm, b, objs, g): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> vm.bytes in fn_space(bits(64), bits(8)) ->
  mallocng.holds_m(c, A, vm, b) -> mallocng.shown_in(c, A, objs) -> mallocng.no_reserved(A) -> mallocng.is_used(A, g) ->
  nat: g in omega && top: int_le(int_add(g, 40), int_pow(2, 64)) && nz: !(g = 0) &&
  meta: (all o n. o in omega -> n in omega -> int_le(int_add(o, n), 40) ->
     gimple.usable(vm, objs, int_add(g, o), n, false) && gimple.usable(vm, objs, int_add(g, o), n, true)) &&
  next: gimple.bytes_at(vm, int_add(g, 8), 8) = A.metas[g].next &&
  mem: gimple.bytes_at(vm, int_add(g, 16), 8) = A.metas[g].mem &&
  avail: gimple.bytes_at(vm, int_add(g, 24), 4) = A.metas[g].avail &&
  freed: gimple.bytes_at(vm, int_add(g, 28), 4) = A.metas[g].freed &&
  word: gimple.bytes_at(vm, int_add(g, 32), 8) = int_add(int_add(int_add(A.metas[g].last_idx, int_mul(32, A.metas[g].freeable)),
    int_mul(64, A.metas[g].sizeclass)), int_mul(4096, A.metas[g].maplen)) &&
  hnz: !(A.metas[g].mem = 0) && htop: int_le(int_add(A.metas[g].mem, 9), int_pow(2, 64)) &&
  hrd: gimple.usable(vm, objs, int_add(A.metas[g].mem, 8), 1, false) && hwr: gimple.usable(vm, objs, int_add(A.metas[g].mem, 8), 1, true) &&
  hbyte: gimple.bytes_at(vm, int_add(A.metas[g].mem, 8), 1) = mallocng.b8(mallocng.mview(vm, mallocng.held(c, A, b)), int_add(A.metas[g].mem, 8)) &&
  hheld: int_add(A.metas[g].mem, 8) in mallocng.held(c, A, b)
proof
  assume hc hu ha hvb hh hsh hnr hg
  have VS := apply(mp.held_vis[c := c, A := A, objs := objs, b := b], hsh)
  let V := A.metas[g]
  let FP := mallocng.held(c, A, b)
  let M := mallocng.mview(vm, FP)
  have go g24 inr := apply(mp.meta_mem, hc, hu, ha, hh, hg)
  have top mw := apply(mp.meta_word, hc, hu, ha, hh, hg)
  have {H = inv} := expand(hh, mallocng.holds_m)
  have {huo = used, hp = perms} := expand(H, mallocng.holds)
  have gok := apply(mp.used_group, huo, hg)
  have {mim, hdr, hown = hdr_own} := expand(gok, mallocng.group_ok)
  have {mnx = next, mmem = mem, mav = avail, mfr = freed, mwd = word} := expand(mim, mallocng.meta_in_memory)
  have hdrg hdr16 hdrp := hdr
  have vt: V in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A.metas, x := g], simp(ha), go)
  have vmem: V.mem in omega by simp(vt)
  have vlast: V.last_idx in omega by simp(vt)
  have sn := apply(mp.stride_nat, ha, go, gok)
  // the meta's bytes: the allocator's, accessible
  have ub: all o. all n. o in omega -> n in omega -> int_le(int_add(o, n), 40) ->
      gimple.usable(vm, objs, int_add(g, o), n, false) && gimple.usable(vm, objs, int_add(g, o), n, true) proof
    fix o n
    assume ho hn hl
    have pb: all i. i in omega -> int_lt(i, n) -> int_add(int_add(g, o), i) in FP && mallocng.m_mapped(M, int_add(int_add(g, o), i)) &&
        snd(mallocng.pg(M, int_add(int_add(g, o), i))).prot.r && snd(mallocng.pg(M, int_add(int_add(g, o), i))).prot.w &&
        !(snd(mallocng.pg(M, int_add(int_add(g, o), i))).kind = 2) proof
      fix i
      assume hi hil
      have r1 r2 r3 := mp(all_elim(inr, {int_add(int_add(g, o), i)}), simp(go, ho, hi), arith(go, ho, hi), arith(go, ho, hi, hil, hl))
      show by taut(r1, expand(r2, mallocng.m_rw), r3)
    qed
    have pr: all i. i in omega -> int_lt(i, n) -> int_add(int_add(g, o), i) in FP && mallocng.m_mapped(M, int_add(int_add(g, o), i)) &&
        snd(mallocng.pg(M, int_add(int_add(g, o), i))).prot.r && !(snd(mallocng.pg(M, int_add(int_add(g, o), i))).kind = 2) proof
      fix i
      assume hi hil
      have q1 q2 q3 q4 q5 := mp(all_elim(pb, {i}), hi, hil)
      show by taut(q1, q2, q3, q5)
    qed
    have pw: all i. i in omega -> int_lt(i, n) -> int_add(int_add(g, o), i) in FP && mallocng.m_mapped(M, int_add(int_add(g, o), i)) &&
        snd(mallocng.pg(M, int_add(int_add(g, o), i))).prot.w && !(snd(mallocng.pg(M, int_add(int_add(g, o), i))).kind = 2) proof
      fix i
      assume hi hil
      have q1 q2 q3 q4 q5 := mp(all_elim(pb, {i}), hi, hil)
      show by taut(q1, q2, q4, q5)
    qed
    have ur := apply(mp.view_usable[vm := vm, fp := FP, objs := objs, a := int_add(g, o), n := n], simp(go, ho), pr, VS)
    have uw := apply(mp.view_usable_w[vm := vm, fp := FP, objs := objs, a := int_add(g, o), n := n], simp(go, ho), pw, VS)
    show by taut(ur, uw)
  qed
  have infp: all o. all n. o in omega -> n in omega -> int_le(int_add(o, n), 40) -> (all i. i in omega -> int_lt(i, n) -> int_add(int_add(g, o), i) in FP) proof
    fix o n
    assume ho hn hl
    fix i
    assume hi hil
    have r1 _ _ := mp(all_elim(inr, {int_add(int_add(g, o), i)}), simp(go, ho, hi), arith(go, ho, hi), arith(go, ho, hi, hil, hl))
    show := r1
  qed
  have v8 := apply(mp.view_read[vm := vm, fp := FP, a := int_add(g, 8), n := 8], simp(go), simp(), simp(), mp(all_elim(infp, {8}, {8}), simp(), simp(), simp()))
  have v16 := apply(mp.view_read[vm := vm, fp := FP, a := int_add(g, 16), n := 8], simp(go), simp(), simp(), mp(all_elim(infp, {16}, {8}), simp(), simp(), simp()))
  have v24 := apply(mp.view_read[vm := vm, fp := FP, a := int_add(g, 24), n := 4], simp(go), simp(), simp(), mp(all_elim(infp, {24}, {4}), simp(), simp(), simp()))
  have v28 := apply(mp.view_read[vm := vm, fp := FP, a := int_add(g, 28), n := 4], simp(go), simp(), simp(), mp(all_elim(infp, {28}, {4}), simp(), simp(), simp()))
  have v32 := apply(mp.view_read[vm := vm, fp := FP, a := int_add(g, 32), n := 8], simp(go), simp(), simp(), mp(all_elim(infp, {32}, {8}), simp(), simp(), simp()))
  // the group's header: its active index's byte -- the allocator's, accessible
  have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
  have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
  have sel: mallocng.slot_end(V, V.last_idx) = int_sub(int_add(int_add(int_add(V.mem, 16), int_mul(mallocng.stride(V), V.last_idx)), mallocng.stride(V)), 4)
    by defs(arith(cu, ci), mallocng.slot_end, mallocng.slot_start, mallocng.storage)
  have ml: int_mul(mallocng.stride(V), V.last_idx) in omega by simp(sn, vlast)
  let H8 := int_add(V.mem, 8)
  have h8o: H8 in omega by simp(vmem)
  have grh := apply(mp.group_bytes[A := A, M := M, b := b, h := g, a := H8], ha, go, gok, h8o, arith(vmem), arith(sel, ml, vmem, sn))
  obtain kg, hkg hkgr from expand(hg, mallocng.is_used)
  have hkgl hkge := hkgr
  have nl := mp(all_elim(hown, {H8}), h8o, (int_le(V.mem, H8) && int_lt(H8, int_add(V.mem, mallocng.UNIT)) by arith(vmem, cu)))
  have nr := apply(mp.nores[A := A, a := H8], hnr)
  have gr2 := subst({y. mallocng.in_range(H8, mallocng.group_range(A.metas[y]))}, sym(hkge), grh)
  have nt8 := apply(mp.grp_untaken, hc, hu, ha, H, hg, h8o, grh)
  have h8fp0 := apply(mp.group_fp[c := c, A := A, b := b, k := kg, a := H8], hc, hu, ha, hkg, hkgl, h8o, gr2, nl, nr, nt8)
  have h8fp := apply(mp.group_held[c := c, A := A, M := M, b := b, brk := vm.brk, h := g, a := H8], hc, hu, ha, H, hg, h8o, grh, h8fp0)
  have p1 p2 p3 := expand(hp, mallocng.perms_ok)
  have gr2a gr2b := expand(gr2, mallocng.in_range)
  have rw8 nk8 := mp(all_elim(p2, {kg}, {H8}), conj(hkg, h8o), taut(hkgl, gr2a, gr2b, nl, nr))
  have rwm rwr rww := expand(rw8, mallocng.m_rw)
  have mm2 := expand(rwm, mallocng.m_mapped, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
  have tl: int_lt(int_div(H8, 4096), int_div(int_sub(int_pow(2, 47), 4096), 4096)) by taut(mm2)
  have mtop: int_le(int_add(V.mem, 9), int_pow(2, 64)) by arith(tl, vmem)
  have one0: all i. i in omega -> int_lt(i, 1) -> i = 0 proof
    fix i
    assume hi hl
    show by arith(hi, hl)
  qed
  have us8 := apply(mp.view_usable[vm := vm, fp := FP, objs := objs, a := H8, n := 1], h8o,
    (all i. i in omega -> int_lt(i, 1) -> int_add(H8, i) in FP && mallocng.m_mapped(M, int_add(H8, i)) &&
       snd(mallocng.pg(M, int_add(H8, i))).prot.r && !(snd(mallocng.pg(M, int_add(H8, i))).kind = 2) by
     simp(h8fp, rwm, rwr, nk8, one0)), VS)
  have uw8 := apply(mp.view_usable_w[vm := vm, fp := FP, objs := objs, a := H8, n := 1], h8o,
    (all i. i in omega -> int_lt(i, 1) -> int_add(H8, i) in FP && mallocng.m_mapped(M, int_add(H8, i)) &&
       snd(mallocng.pg(M, int_add(H8, i))).prot.w && !(snd(mallocng.pg(M, int_add(H8, i))).kind = 2) by
     simp(h8fp, rwm, rww, nk8, one0)), VS)
  have vh := apply(mp.view_read[vm := vm, fp := FP, a := H8, n := 1], h8o, simp(), simp(), (all i. i in omega -> int_lt(i, 1) -> int_add(H8, i) in FP by simp(h8fp, one0)))
  have bv bvo := apply(mp.b8_view[vm := vm, fp := FP, a := H8], hvb, h8o, h8fp)
  have r81: mallocng.rd(M, H8, 1) = mallocng.b8(M, H8) by defs(simp(bvo), mallocng.rd)
  show by taut(go, top, (!(g = 0) by arith(g24, go)), ub, trans(v8, mnx), trans(v16, mmem), trans(v24, mav), trans(v28, mfr), trans(v32, mwd),
    (!(V.mem = 0) by arith(hdrp, vmem)), mtop, us8, uw8, trans(vh, r81), h8fp)
qed

// the layer's bit (a number) by the core's (a proposition)
theorem mp.nbit(x, i): x in omega -> i in omega -> mallocng.bit(x, i) = ite(bit(x, i), 1, 0)
proof
  assume hx hi
  have pp := mp(pow2_pos[k := i], hi)
  have d _ := apply(div_nat[x := x, m := pow2(i)], hx, pp)
  have e0: mallocng.bit(x, i) = int_mod(int_div(x, pow2(i)), 2) by defs(refl({int_mod(int_div(x, pow2(i)), 2)}), mallocng.bit, pow2)
  have c1: bit(x, i) -> mallocng.bit(x, i) = ite(bit(x, i), 1, 0) proof
    assume hb
    have e := expand(hb, bit)
    have it: ite(bit(x, i), 1, 0) = 1 by simp(hb)
    show by arith(e0, e, it)
  qed
  have c2: !bit(x, i) -> mallocng.bit(x, i) = ite(bit(x, i), 1, 0) proof
    assume hb
    have n1 := expand(hb, bit)
    have it: ite(bit(x, i), 1, 0) = 0 by simp(hb)
    show by arith(e0, n1, d, it)
  qed
  show by taut(c1, c2)
qed

// activate_group's masks: F's bits up to k (avail), the rest (freed)
theorem mp.ag_bits(F, k, i): F in omega -> k in omega -> i in omega -> int_lt(i, 32) ->
  av: mallocng.bit(bits_and(32, F, bits_of_int(32, int_sub(int_mul(2, int_pow(2, k)), 1))), i) = ite(int_le(i, k), mallocng.bit(F, i), 0) &&
  fr: mallocng.bit(bits_and(32, F, bits_not(32, bits_of_int(32, int_sub(int_mul(2, int_pow(2, k)), 1)))), i) = ite(int_le(i, k), 0, mallocng.bit(F, i))
proof
  assume hf hk hi hi32
  let ACT := bits_of_int(32, int_sub(int_mul(2, int_pow(2, k)), 1))
  have k1: int_add(k, 1) in omega by arith(hk)
  have p1 := mp(all_elim(pow2_add, {k}), hk, {1}, simp())
  have e2: int_mul(2, int_pow(2, k)) = pow2(int_add(k, 1)) by defs(arith(expand(p1, pow2)), pow2)
  have pk := mp(pow2_pos[k := int_add(k, 1)], k1)
  have mo: int_sub(pow2(int_add(k, 1)), 1) in omega by arith(pk)
  have ba: bit(ACT, i) <-> int_le(i, k) proof
    have b1 := apply(bit_of_int[n := 32, x := int_sub(int_mul(2, int_pow(2, k)), 1), i := i], simp(), rewrite(sym(e2), mo), hi)
    have b2 := apply(bit_mask[k := int_add(k, 1), i := i], k1, hi)
    have b3 := subst({y. bit(ACT, i) <-> int_lt(i, 32) && bit(int_sub(y, 1), i)}, e2, b1)
    show by taut(b3, b2, hi32, (int_lt(i, int_add(k, 1)) <-> int_le(i, k) by arith(hi, hk)))
  qed
  have av1 := apply(bit_and[n := 32, x := F, y := ACT, i := i], simp(), hi, hi32)
  have fr1 := apply(bit_and[n := 32, x := F, y := bits_not(32, ACT), i := i], simp(), hi, hi32)
  have nt := apply(bit_not[n := 32, x := ACT, i := i], simp(), hi, hi32)
  have ao := apply(bits_and_in[n := 32, x := F, y := ACT], simp())
  have fo := apply(bits_and_in[n := 32, x := F, y := bits_not(32, ACT)], simp())
  have nav := apply(mp.nbit[x := bits_and(32, F, ACT), i := i], (bits_and(32, F, ACT) in omega by defs(simp(ao), bits)), hi)
  have nfr := apply(mp.nbit[x := bits_and(32, F, bits_not(32, ACT)), i := i], (bits_and(32, F, bits_not(32, ACT)) in omega by defs(simp(fo), bits)), hi)
  have nf := apply(mp.nbit[x := F, i := i], hf, hi)
  have c1: int_le(i, k) -> av: mallocng.bit(bits_and(32, F, ACT), i) = ite(int_le(i, k), mallocng.bit(F, i), 0) &&
      fr: mallocng.bit(bits_and(32, F, bits_not(32, ACT)), i) = ite(int_le(i, k), 0, mallocng.bit(F, i)) proof
    assume h
    have x1: bit(bits_and(32, F, ACT), i) <-> bit(F, i) by taut(av1, ba, h)
    have x2: !bit(bits_and(32, F, bits_not(32, ACT)), i) by taut(fr1, nt, ba, h)
    have y1: mallocng.bit(bits_and(32, F, ACT), i) = mallocng.bit(F, i) by simp(nav, nf, x1)
    have y2: mallocng.bit(bits_and(32, F, bits_not(32, ACT)), i) = 0 by simp(nfr, x2)
    show by simp(y1, y2, h)
  qed
  have c2: !int_le(i, k) -> av: mallocng.bit(bits_and(32, F, ACT), i) = ite(int_le(i, k), mallocng.bit(F, i), 0) &&
      fr: mallocng.bit(bits_and(32, F, bits_not(32, ACT)), i) = ite(int_le(i, k), 0, mallocng.bit(F, i)) proof
    assume h
    have x1: !bit(bits_and(32, F, ACT), i) by taut(av1, ba, h)
    have x2: bit(bits_and(32, F, bits_not(32, ACT)), i) <-> bit(F, i) by taut(fr1, nt, ba, h)
    have y1: mallocng.bit(bits_and(32, F, ACT), i) = 0 by simp(nav, x1)
    have y2: mallocng.bit(bits_and(32, F, bits_not(32, ACT)), i) = mallocng.bit(F, i) by simp(nfr, nf, x2)
    show by simp(y1, y2, h)
  qed
  show by taut(c1, c2)
qed

// a number below 2^32 with no bit set: 0
theorem mp.nbits_zero(y): y in omega -> int_lt(y, int_pow(2, 32)) -> (all i. i in omega -> int_lt(i, 32) -> mallocng.bit(y, i) = 0) -> y = 0
proof
  assume hy hl hb
  have nb: all i. i in omega -> int_lt(i, 32) -> !bit(y, i) proof
    fix i
    assume hi hil
    have e := apply(mp.nbit[x := y, i := i], hy, hi)
    have z := mp(all_elim(hb, {i}), hi, hil)
    have c: bit(y, i) -> false proof
      assume h
      have one: ite(bit(y, i), 1, 0) = 1 by simp(h)
      show by arith(e, z, one)
    qed
    show by taut(c)
  qed
  show := mp(all_elim(bits_zero, {32}), simp(), {y}, hy, (int_lt(y, pow2(32)) by defs(hl, pow2)), nb)
qed

// activation keeps g's masks sound: its freed slots up to the active
// index (in M, as in M2) now available, the rest still freed; a big
// allocation's (nothing freed) still empty
theorem mp.act_masks(A, A2, M, M2, g, idx): A in mallocng.Abs -> A2 in mallocng.Abs -> g in omega ->
  mallocng.masks_ok(A, M, g) -> mallocng.big_ok(A, g) -> A.metas[g].avail = 0 -> mallocng_specs.activated(A, A2, g, idx) ->
  idx = int_mod(mallocng.b8(M, int_add(A.metas[g].mem, 8)), 32) ->
  mallocng.b8(M2, int_add(A.metas[g].mem, 8)) = mallocng.b8(M, int_add(A.metas[g].mem, 8)) ->
  (all i. i in omega -> int_le(i, A.metas[g].last_idx) ->
     mallocng.b8(M2, int_sub(mallocng.slot_start(A.metas[g], i), 4)) = mallocng.b8(M, int_sub(mallocng.slot_start(A.metas[g], i), 4))) ->
  masks: mallocng.masks_ok(A2, M2, g) && big: mallocng.big_ok(A2, g)
proof
  assume ha ha2 hg mk bg av0 hact eidx ebx es
  let V := A.metas[g]
  let V2 := A2.metas[g]
  have hmo _ avl frl hb := expand(hact, mallocng_specs.activated)
  have {em = mem, el = last, ess = slots, esc = sclass, emap = maplen} := apply(mp.mo_geom[A := A, A2 := A2, x := g], hmo, hg)
  have esl := apply(mp.mo_field[A := A, A2 := A2, k := "slots"], hmo, simp())
  have vt: V in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A.metas, x := g], simp(ha), hg)
  have vt2: V2 in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A2.metas, x := g], simp(ha2), hg)
  have vfr: V.freed in omega by simp(vt)
  have v2av: V2.avail in omega by simp(vt2)
  have v2fr: V2.freed in omega by simp(vt2)
  have vlast: V.last_idx in omega by simp(vt)
  have x2: int_mod(mallocng.b8(M2, int_add(V2.mem, 8)), 32) = idx by simp(em, ebx, eidx)
  have mko := expand(mk, mallocng.masks_ok)
  // bit i, before and after
  have bi: all i. i in omega -> int_lt(i, 32) ->
      av: mallocng.bit(V2.avail, i) = ite(int_le(i, idx), mallocng.bit(V.freed, i), 0) &&
      fr: mallocng.bit(V2.freed, i) = ite(int_le(i, idx), 0, mallocng.bit(V.freed, i)) &&
      old: mallocng.bit(V.avail, i) = 0 && f01: (mallocng.bit(V.freed, i) = 0 || mallocng.bit(V.freed, i) = 1) &&
      fo: mallocng.bit(V.freed, i) in omega && ao2: mallocng.bit(V2.avail, i) in omega && fo2: mallocng.bit(V2.freed, i) in omega proof
    fix i
    assume hi hil
    have a f := mp(all_elim(hb, {i}), hi, hil)
    have z0 := apply(mp.nbit[x := 0, i := i], simp(), hi)
    have nz := apply(bit_zero[i := i], hi)
    have o: mallocng.bit(V.avail, i) = 0 by simp(av0, z0, nz)
    have nf := apply(mp.nbit[x := V.freed, i := i], vfr, hi)
    have c1: bit(V.freed, i) -> mallocng.bit(V.freed, i) = 1 proof
      assume h
      show by simp(nf, h)
    qed
    have c2: !bit(V.freed, i) -> mallocng.bit(V.freed, i) = 0 proof
      assume h
      show by simp(nf, h)
    qed
    have fo: mallocng.bit(V.freed, i) in omega by simp(nf)
    have ao2: mallocng.bit(V2.avail, i) in omega by simp(apply(mp.nbit[x := V2.avail, i := i], v2av, hi))
    have fo2: mallocng.bit(V2.freed, i) in omega by simp(apply(mp.nbit[x := V2.freed, i := i], v2fr, hi))
    show by taut(a, f, o, c1, c2, fo, ao2, fo2)
  qed
  have r: all x0. x0 in omega -> int_lt(x0, 32) -> (((mallocng.bit(V2.avail, x0) = 1 -> int_le(x0, int_mod(mallocng.b8(M2, int_add(V2.mem, 8)), 32)) && mallocng.bit(V2.freed, x0) = 0) &&
      (int_lt(0, int_add(mallocng.bit(V2.avail, x0), mallocng.bit(V2.freed, x0))) -> int_le(x0, V2.last_idx))) &&
      (int_le(x0, V2.last_idx) -> (A2.slots[g][x0] = tag(0, empty) <-> int_lt(0, int_add(mallocng.bit(V2.avail, x0), mallocng.bit(V2.freed, x0)))) &&
        mallocng.b8(M2, int_sub(mallocng.slot_start(V2, x0), 4)) = 0)) &&
      (int_lt(int_mod(mallocng.b8(M2, int_add(V2.mem, 8)), 32), x0) && int_le(x0, V2.last_idx) -> mallocng.bit(V2.freed, x0) = 1) proof
    fix i
    assume hi hil
    have o1 o2 o3 o4 := mp(all_elim(mko, {i}), hi, hil)
    have {ba = av, bf = fr, bo = old, b01 = f01, bfo = fo, bao2 = ao2, bfo2 = fo2} := mp(all_elim(bi, {i}), hi, hil)
    let FI := mallocng.bit(V.freed, i)
    // the new bits: FI split at idx
    have lo: int_le(i, idx) -> mallocng.bit(V2.avail, i) = FI && mallocng.bit(V2.freed, i) = 0 proof
      assume h
      show by simp(ba, bf, h)
    qed
    have hi2: !int_le(i, idx) -> mallocng.bit(V2.avail, i) = 0 && mallocng.bit(V2.freed, i) = FI proof
      assume h
      show by simp(ba, bf, h)
    qed
    have sum: int_add(mallocng.bit(V2.avail, i), mallocng.bit(V2.freed, i)) = int_add(mallocng.bit(V.avail, i), FI) by arith(lo, hi2, bo, bfo, bao2, bfo2)
    have p1: mallocng.bit(V2.avail, i) = 1 -> int_le(i, int_mod(mallocng.b8(M2, int_add(V2.mem, 8)), 32)) && mallocng.bit(V2.freed, i) = 0 proof
      assume h
      have c: int_le(i, idx) by arith(h, hi2, bfo, bao2, bfo2)
      show by arith(c, lo, x2, bfo, bao2, bfo2)
    qed
    have p2: int_lt(0, int_add(mallocng.bit(V2.avail, i), mallocng.bit(V2.freed, i))) -> int_le(i, V2.last_idx) proof
      assume h
      show by arith(o2, h, sum, el, bfo, bao2, bfo2)
    qed
    have p3: int_le(i, V2.last_idx) -> (A2.slots[g][i] = tag(0, empty) <-> int_lt(0, int_add(mallocng.bit(V2.avail, i), mallocng.bit(V2.freed, i)))) &&
        mallocng.b8(M2, int_sub(mallocng.slot_start(V2, i), 4)) = 0 proof
      assume h
      have hl: int_le(i, V.last_idx) by arith(h, el)
      have q1 q2 := mp(o3, hl)
      have {ss = start} := all_elim(ess, {i})
      have sb := mp(all_elim(es, {i}), hi, hl)
      have e1: (A2.slots[g][i] = tag(0, empty)) <-> (A.slots[g][i] = tag(0, empty)) by simp(esl)
      have e2: int_lt(0, int_add(mallocng.bit(V2.avail, i), mallocng.bit(V2.freed, i))) <-> int_lt(0, int_add(mallocng.bit(V.avail, i), FI)) by arith(sum)
      have z: mallocng.b8(M2, int_sub(mallocng.slot_start(V2, i), 4)) = 0 by simp(ss, sb, q2)
      show by taut(e1, e2, q1, z)
    qed
    have p4: int_lt(int_mod(mallocng.b8(M2, int_add(V2.mem, 8)), 32), i) && int_le(i, V2.last_idx) -> mallocng.bit(V2.freed, i) = 1 proof
      assume h
      have h1 h2 := h
      have c: !int_le(i, idx) by arith(h1, x2)
      have q := mp(o4, taut((int_lt(int_mod(mallocng.b8(M, int_add(V.mem, 8)), 32), i) by arith(h1, x2, eidx)), (int_le(i, V.last_idx) by arith(h2, el))))
      show by arith(q, hi2, c, bfo, bao2, bfo2)
    qed
    show by taut(p1, p2, p3, p4)
  qed
  have m2: mallocng.masks_ok(A2, M2, g) by defs(r, mallocng.masks_ok)
  // big: nothing freed before, nothing after
  have b2: V2.sizeclass = 63 -> V2.last_idx = 0 && int_lt(0, V2.maplen) && V2.avail = 0 && V2.freed = 0 proof
    assume h
    have b1 b2 b3 b4 := mp(expand(bg, mallocng.big_ok), (V.sizeclass = 63 by arith(h, esc)))
    have zb: all i. i in omega -> int_lt(i, 32) -> mallocng.bit(V2.avail, i) = 0 && mallocng.bit(V2.freed, i) = 0 proof
      fix i
      assume hi hil
      have {ba = av, bf = fr} := mp(all_elim(bi, {i}), hi, hil)
      have nf := apply(mp.nbit[x := V.freed, i := i], vfr, hi)
      have f0: mallocng.bit(V.freed, i) = 0 by simp(nf, b4, apply(bit_zero[i := i], hi))
      show by simp(ba, bf, f0)
    qed
    have za: all i. i in omega -> int_lt(i, 32) -> mallocng.bit(V2.avail, i) = 0 proof
      fix i
      assume hi hil
      have x _ := mp(all_elim(zb, {i}), hi, hil)
      show := x
    qed
    have zf: all i. i in omega -> int_lt(i, 32) -> mallocng.bit(V2.freed, i) = 0 proof
      fix i
      assume hi hil
      have _ x := mp(all_elim(zb, {i}), hi, hil)
      show := x
    qed
    have a0 := apply(mp.nbits_zero[y := V2.avail], v2av, avl, za)
    have f0 := apply(mp.nbits_zero[y := V2.freed], v2fr, frl, zf)
    show by taut((V2.last_idx = 0 by arith(b1, el)), (int_lt(0, V2.maplen) by arith(b2, emap)), a0, f0)
  qed
  have bg2: mallocng.big_ok(A2, g) by defs(b2, mallocng.big_ok)
  show by taut(m2, bg2)
qed

// (a relation's pairs updated at a key of K by a value of B: still pairs
// of K and B)
theorem mp.pow_upd(K, B, r, k, v): r in powerset(cart(K, B)) -> k in K -> v in B -> fn_update(r, k, v) in powerset(cart(K, B))
proof
  assume hr hk hv
  have rs: subset(r, cart(K, B)) by taut(powerset_def[s := cart(K, B), a := r], hr)
  have sub: all z. z in fn_update(r, k, v) -> z in cart(K, B) proof
    fix z
    assume hz
    have c := fn_update_iff[f := r, k := k, v := v, z := z]
    have c1: z in r -> z in cart(K, B) proof
      assume h1
      show := mp(subset_elim[a := r, b := cart(K, B), z := z], rs, h1)
    qed
    have c2: z = pair(k, v) -> z in cart(K, B) proof
      assume h2
      show := rewrite(sym(h2), mp(cart_intro[a := K, b := B, x := k, y := v], hk, hv))
    qed
    show by taut(c, hz, c1, c2)
  qed
  show by taut(powerset_def[s := cart(K, B), a := fn_update(r, k, v)], (subset(fn_update(r, k, v), cart(K, B)) by defs(sub, subset)))
qed

// a function updated within its spaces: in them
theorem mp.space_upd(a, b, f, k, v): f in fn_space(a, b) -> k in a -> v in b -> fn_update(f, k, v) in fn_space(a, b)
proof
  assume hf hk hv
  have fp ff fd := (f in powerset(cart(a, b)) && is_fun(f) && dom(f) = a by simp(expand(hf, fn_space)))
  have p2 := apply(mp.pow_upd[K := a, B := b, r := f, k := k, v := v], fp, hk, hv)
  have f2 d2 := mp(fn_update_fd[f := f, k := k, v := v, d := a], ff, fd, hk)
  show by defs(simp(p2, f2, d2), fn_space)
qed

// a meta's masks set (numbers): a meta
theorem mp.meta_upd(V, av, fr): V in mallocng.MetaV -> av in omega -> fr in omega ->
  fn_update(fn_update(V, "avail", av), "freed", fr) in mallocng.MetaV
proof
  assume hv ha hf
  let K := insert("prev", insert("next", insert("mem", insert("avail", insert("freed", insert("last_idx", insert("freeable", insert("sizeclass", insert("maplen", empty)))))))))
  have vp vf vd := (V in powerset(cart(K, univ(1))) && is_fun(V) && dom(V) = K by simp(expand(hv, mallocng.MetaV)))
  let V1 := fn_update(V, "avail", av)
  have p1 := apply(mp.pow_upd[K := K, B := univ(1), r := V, k := "avail", v := av], vp, simp(), simp(ha))
  have f1 d1 := mp(fn_update_fd[f := V, k := "avail", v := av, d := K], vf, vd, simp())
  have p2 := apply(mp.pow_upd[K := K, B := univ(1), r := V1, k := "freed", v := fr], p1, simp(), simp(hf))
  have f2 d2 := mp(fn_update_fd[f := V1, k := "freed", v := fr, d := K], f1, d1, simp())
  have vu := mp(rec_univ[u := 1, k := K, r := V], simp(x86.insert_univ), vp, vf, vd)
  show by defs(simp(p2, f2, d2, ha, hf, vu, expand(hv, mallocng.MetaV)), mallocng.MetaV)
qed

// (the metas: a member)
theorem mp.metav_univ: mallocng.MetaV in univ(1)
proof
  let K := insert("prev", insert("next", insert("mem", insert("avail", insert("freed", insert("last_idx", insert("freeable", insert("sizeclass", insert("maplen", empty)))))))))
  have fl: all r. r in mallocng.MetaV -> is_fun(r) && (all y. y in K -> r[y] in omega) proof
    fix r
    assume hr
    have rv := expand(hr, mallocng.MetaV)
    have f: is_fun(r) by simp(rv)
    have ys: all y. y in K -> r[y] in omega proof
      fix y
      assume hy
      show by simp(hy, rv)
    qed
    show by taut(f, ys)
  qed
  show by defs(apply(rec_type_univ[u := 1, k := K, b := omega], simp(x86.insert_univ), omega_univ, expand(fl, mallocng.MetaV)), mallocng.MetaV)
qed

// an abstract state with one meta replaced: an abstract state (a member)
theorem mp.abs_upd(A, g, W): A in mallocng.Abs -> g in omega -> W in mallocng.MetaV ->
  abs: fn_update(A, "metas", fn_update(A.metas, g, W)) in mallocng.Abs && univ: fn_update(A, "metas", fn_update(A.metas, g, W)) in univ(1)
proof
  assume ha hg hw
  let K := insert("secret", insert("init_done", insert("auxv_at", insert("auxv", insert("areas", insert("avail_cnt", insert("reserve", insert("reserve_cnt", insert("free_metas", insert("used", insert("metas", insert("active", insert("slots", insert("brk", insert("taken", empty)))))))))))))))
  let X := fn_update(A.metas, g, W)
  have ap af ad := (A in powerset(cart(K, univ(1))) && is_fun(A) && dom(A) = K by simp(expand(ha, mallocng.Abs)))
  have ms: A.metas in fn_space(omega, mallocng.MetaV) by simp(ha)
  have xs := apply(mp.space_upd[a := omega, b := mallocng.MetaV, f := A.metas, k := g, v := W], ms, hg, hw)
  have xu := mp(fn_space_univ[u := 1, a := omega, b := mallocng.MetaV, f := X], omega_univ, mp.metav_univ, xs)
  have p2 := apply(mp.pow_upd[K := K, B := univ(1), r := A, k := "metas", v := X], ap, simp(), xu)
  have f2 d2 := mp(fn_update_fd[f := A, k := "metas", v := X, d := K], af, ad, simp())
  have au := mp(rec_univ[u := 1, k := K, r := A], simp(x86.insert_univ), ap, af, ad)
  have a2: fn_update(A, "metas", X) in mallocng.Abs by defs(simp(p2, f2, d2, xs, au, xu, expand(ha, mallocng.Abs)), mallocng.Abs)
  have u2 := mp(rec_univ[u := 1, k := K, r := fn_update(A, "metas", X)], simp(x86.insert_univ), p2, f2, d2)
  show by taut(a2, u2)
qed
