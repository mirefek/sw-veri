// The abstract state determined by memory (`mallocng.abs_unique`): two
// abstract states that hold of the same memory (layers/mallocng.sl's
// `rep`) are equal. What the invariant reads, each state through its own
// view, is the memory's bytes: the context's fields; the lists followed
// from it (the auxiliary vector, the meta areas, the free metas, the
// active lists); the used metas (the meta slots neither free nor
// available), their fields and their slots.

// ----------------------------------------------------------------------
//  Reads in two views

// n bytes at a, in both views: the same (the memory's)
theorem mp.u_rd2(vm, F, G, a, n): a in omega -> n in omega -> int_le(n, 18446744073709551616) ->
  (all i. i in omega -> int_lt(i, n) -> int_add(a, i) in F) -> (all i. i in omega -> int_lt(i, n) -> int_add(a, i) in G) ->
  mallocng.rd(mallocng.mview(vm, F), a, n) = mallocng.rd(mallocng.mview(vm, G), a, n)
proof
  assume ha hn hl hf hg
  have f := mp(mp.view_read[vm := vm, fp := F, a := a, n := n], ha, hn, hl, hf)
  have g := mp(mp.view_read[vm := vm, fp := G, a := a, n := n], ha, hn, hl, hg)
  show := trans(sym(f), g)
qed

// the context's bytes the invariant reads (not the free ones), n at off:
// in the view of an abstract state that holds, the memory's
theorem mp.u_ctx(c, A, vm, b, off, n): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_m(c, A, vm, b) ->
  off in omega -> n in omega -> int_le(int_add(off, n), mallocng.CTX_SIZE) ->
  (all i. i in omega -> int_lt(i, n) -> !mallocng.ctx_free(c, int_add(int_add(c.ctx, off), i))) ->
  mallocng.rd(mallocng.mview(vm, mallocng.held(c, A, b)), int_add(c.ctx, off), n) = gimple.bytes_at(vm, int_add(c.ctx, off), n)
proof
  assume hc hu ha hh ho hn hle hnf
  have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  have co: c.ctx in omega by simp(hc)
  have hf: all i. i in omega -> int_lt(i, n) -> int_add(int_add(c.ctx, off), i) in mallocng.held(c, A, b) proof
    fix i
    assume hi hil
    have r := apply(mp.ctx_acc[c := c, A := A, vm := vm, b := b, a := int_add(int_add(c.ctx, off), i)], hc, hu, ha, hh,
      arith(co, ho, hi), arith(co, ho, hi), arith(co, ho, hi, hil, hle, ks), mp(all_elim(hnf, {i}), hi, hil))
    show by taut(r)
  qed
  have v := mp(mp.view_read[vm := vm, fp := mallocng.held(c, A, b), a := int_add(c.ctx, off), n := n], arith(co, ho), hn, arith(hn, hle, ks), hf)
  show := sym(v)
qed

// ... the same in two abstract states' views
theorem mp.u_ctx2(c, A, B, vm, b, off, n): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> B in univ(1) -> B in mallocng.Abs ->
  mallocng.holds_m(c, A, vm, b) -> mallocng.holds_m(c, B, vm, b) ->
  off in omega -> n in omega -> int_le(int_add(off, n), mallocng.CTX_SIZE) ->
  (all i. i in omega -> int_lt(i, n) -> !mallocng.ctx_free(c, int_add(int_add(c.ctx, off), i))) ->
  mallocng.rd(mallocng.mview(vm, mallocng.held(c, A, b)), int_add(c.ctx, off), n) = mallocng.rd(mallocng.mview(vm, mallocng.held(c, B, b)), int_add(c.ctx, off), n)
proof
  assume hc hua ha hub hb hha hhb ho hn hle hnf
  have ea := apply(mp.u_ctx[c := c, A := A, vm := vm, b := b, off := off, n := n], hc, hua, ha, hha, ho, hn, hle, hnf)
  have eb := apply(mp.u_ctx[c := c, A := B, vm := vm, b := b, off := off, n := n], hc, hub, hb, hhb, ho, hn, hle, hnf)
  show := trans(ea, sym(eb))
qed

// (the context's words the invariant reads: none of the free bytes --
// those at 12..16 and 464..920)
theorem mp.u_nofree(c, off, n): c in mallocng.Cfg -> off in omega -> n in omega ->
  ((int_le(int_add(off, n), 12)) || (int_le(16, off) && int_le(int_add(off, n), 464)) || int_le(920, off)) ->
  all i. i in omega -> int_lt(i, n) -> !mallocng.ctx_free(c, int_add(int_add(c.ctx, off), i))
proof
  assume hc ho hn hr
  fix i
  assume hi hil
  have co: c.ctx in omega by simp(hc)
  have ks: mallocng.C_MMAP_CNT = 12 && mallocng.C_USAGE = 464 && mallocng.C_BRK = 920
    by defs(simp(), mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK)
  show by defs(arith(ks, co, ho, hn, hr, hi, hil), mallocng.ctx_free)
qed

// (nothing taken: no byte in a taken meta)
theorem mp.u_nt(A, a): seq_len(A.taken) = 0 -> !mallocng.in_taken(A, a)
proof
  assume ht
  have g: mallocng.in_taken(A, a) -> false proof
    assume h
    obtain k, hko hkl _ _ from expand(h, mallocng.in_taken)
    show by arith(hko, hkl, ht)
  qed
  show by taut(g)
qed

// a byte in a state's ranges, in no reserved slot or taken meta: held
// exactly when not live and not a free byte of the context
theorem mp.u_held_char(c, A, b, a): a in omega -> mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) ->
  !mallocng.in_reserved(A, a) -> !mallocng.in_taken(A, a) ->
  (a in mallocng.held(c, A, b) <-> !(a in malloc.live_of(b)) && !mallocng.ctx_free(c, a))
proof
  assume hao irs hnr hnt
  have to: a in mallocng.held(c, A, b) -> !(a in malloc.live_of(b)) && !mallocng.ctx_free(c, a) proof
    assume h
    have {fp = fp, nf = free} := apply(mp.held_fp, h)
    have s1 := set_select_def[s := omega, p := y. y in mallocng.fp_set(mallocng.fp_ranges(c, A), b) && !mallocng.in_reserved(A, y) && !mallocng.in_taken(A, y), z := a]
    have fs: a in mallocng.fp_set(mallocng.fp_ranges(c, A), b) by taut(s1, expand(fp, mallocng.footprint))
    have s3 := set_select_def[s := omega, p := y. mallocng.in_ranges(y, mallocng.fp_ranges(c, A)) && !(y in malloc.live_of(b)), z := a]
    have nl: !(a in malloc.live_of(b)) by taut(s3, expand(fs, mallocng.fp_set))
    show by taut(nl, nf)
  qed
  have from: !(a in malloc.live_of(b)) -> !mallocng.ctx_free(c, a) -> a in mallocng.held(c, A, b) proof
    assume nl nf
    have inn: a in mallocng.fp_set(mallocng.fp_ranges(c, A), b) by defs(sel(taut(hao, irs, nl)), mallocng.fp_set)
    have fp: a in mallocng.footprint(c, A, b) by defs(sel(taut(hao, inn, hnr, hnt)), mallocng.footprint)
    show := apply(mp.held_intro, fp, nf)
  qed
  show by taut(to, from)
qed

// a byte in both states' ranges, neither with a slot reserved nor a meta
// taken: held by one exactly when by the other
theorem mp.u_held_iff(c, A, B, b, a): a in omega -> mallocng.no_reserved(A) -> mallocng.no_reserved(B) ->
  seq_len(A.taken) = 0 -> seq_len(B.taken) = 0 ->
  mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) -> mallocng.in_ranges(a, mallocng.fp_ranges(c, B)) ->
  (a in mallocng.held(c, A, b) <-> a in mallocng.held(c, B, b))
proof
  assume hao hra hrb hta htb ina inb
  have ca := apply(mp.u_held_char[c := c, A := A, b := b, a := a], hao, ina, mp(mp.nores[A := A, a := a], hra), mp(mp.u_nt[A := A, a := a], hta))
  have cb := apply(mp.u_held_char[c := c, A := B, b := b, a := a], hao, inb, mp(mp.nores[A := B, a := a], hrb), mp(mp.u_nt[A := B, a := a], htb))
  show by taut(ca, cb)
qed

// ... so both views the same there
theorem mp.u_view_at(vm, F, G, a): a in omega -> (a in F <-> a in G) -> mallocng.mview(vm, F)[a] = mallocng.mview(vm, G)[a]
proof
  assume hao h
  show by defs(simp(hao, h), mallocng.mview)
qed

// n bytes at a in both states' ranges: read the same in both views
theorem mp.u_rd_same(c, A, B, vm, b, a, n): mallocng.no_reserved(A) -> mallocng.no_reserved(B) ->
  seq_len(A.taken) = 0 -> seq_len(B.taken) = 0 -> n in omega ->
  (all i. i in omega -> int_lt(i, n) -> int_add(a, i) in omega &&
     mallocng.in_ranges(int_add(a, i), mallocng.fp_ranges(c, A)) && mallocng.in_ranges(int_add(a, i), mallocng.fp_ranges(c, B))) ->
  mallocng.rd(mallocng.mview(vm, mallocng.held(c, A, b)), a, n) = mallocng.rd(mallocng.mview(vm, mallocng.held(c, B, b)), a, n)
proof
  assume hra hrb hta htb hn hr
  have e: all i. i in omega -> int_lt(i, n) ->
      mallocng.mview(vm, mallocng.held(c, B, b))[int_add(a, i)] = mallocng.mview(vm, mallocng.held(c, A, b))[int_add(a, i)] proof
    fix i
    assume hi hil
    have ao ia ib := mp(all_elim(hr, {i}), hi, hil)
    have iff := apply(mp.u_held_iff[c := c, A := B, B := A, b := b, a := int_add(a, i)], ao, hrb, hra, htb, hta, ib, ia)
    show := apply(mp.u_view_at[vm := vm, F := mallocng.held(c, B, b), G := mallocng.held(c, A, b), a := int_add(a, i)], ao, iff)
  qed
  show := sym(mp(mp.agree_rd[M := mallocng.mview(vm, mallocng.held(c, A, b)), M2 := mallocng.mview(vm, mallocng.held(c, B, b)), a := a, n := n], hn, e))
qed

// the fixed ranges in the footprint's ranges
theorem mp.u_fixed_fp(c, A, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs ->
  mallocng.in_ranges(a, mallocng.fixed_ranges(c, A)) -> mallocng.in_ranges(a, mallocng.fp_ranges(c, A))
proof
  assume hc hu ha h
  have pl := apply(mp.pre_list, hc, hu, ha)
  have {gl = groups} := apply(mp.fp_pieces, hc, hu, ha)
  have h2 := expand(h, mallocng.fixed_ranges)
  have r := apply(mp.ranges_l, pl, gl, h2)
  show by defs(r, mallocng.fp_ranges, mallocng.fixed_ranges)
qed

// a byte of the data symbols (the context, the lock, libc's), and of the
// auxiliary vector's entries: in the footprint's ranges
theorem mp.u_front_fp(c, A, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs ->
  (mallocng.in_ranges(a, mallocng.data_ranges(c)) || mallocng.in_ranges(a, mallocng.auxv_ranges(A))) ->
  mallocng.in_ranges(a, mallocng.fp_ranges(c, A))
proof
  assume hc hu ha h
  have {rd = rodata, ax = auxv} := apply(mp.front_pieces, hc, hu, ha)
  have ro := apply(mp.ro_list, (c.file in seq_type(bits(8)) by simp(hc)))
  have cf: c.ctx in omega && c.lock in omega && c.libc in omega by simp(hc)
  have o1 := apply(tr.seq_one_type, (pair(c.ctx, mallocng.CTX_SIZE) in univ(1) by simp(cf)))
  have o2 := apply(tr.seq_one_type, (pair(c.lock, 4) in univ(1) by simp(cf)))
  have o3 := apply(tr.seq_one_type, (pair(c.libc, 16) in univ(1) by simp(cf)))
  have dl: mallocng.data_ranges(c) in list_type(univ(1)) by defs(apply(tr.concat_list, apply(tr.concat_list, o1, o2), o3), mallocng.data_ranges)
  have d: mallocng.in_ranges(a, mallocng.data_ranges(c)) -> mallocng.in_ranges(a, seq_concat(seq_concat(mallocng.ro_ranges(c.file), mallocng.data_ranges(c)), mallocng.auxv_ranges(A))) proof
    assume hd
    show := apply(mp.ranges_l, rd, ax, apply(mp.ranges_r, ro, dl, hd))
  qed
  have x: mallocng.in_ranges(a, mallocng.auxv_ranges(A)) -> mallocng.in_ranges(a, seq_concat(seq_concat(mallocng.ro_ranges(c.file), mallocng.data_ranges(c)), mallocng.auxv_ranges(A))) proof
    assume hx
    show := apply(mp.ranges_r, rd, ax, hx)
  qed
  have q: mallocng.in_ranges(a, seq_concat(seq_concat(mallocng.ro_ranges(c.file), mallocng.data_ranges(c)), mallocng.auxv_ranges(A))) by taut(h, d, x)
  show := apply(mp.u_fixed_fp, hc, hu, ha, apply(mp.fixed_in[c := c, A := A, a := a], hc, hu, ha, taut(q)))
qed

// ----------------------------------------------------------------------
//  A cyclic list from a head (of nonzero elements): determined by memory

// (the common prefix: equal)
theorem mp.u_cyc_pre(M, h, l1, l2): l1 in list_type(omega) -> l2 in list_type(omega) ->
  mallocng.cyclic(M, h, l1) -> mallocng.cyclic(M, h, l2) ->
  all i. i in omega -> int_lt(i, seq_len(l1)) -> int_lt(i, seq_len(l2)) -> l1[i] = l2[i]
proof
  assume h1 h2 c1 c2
  have {f1 = first, k1 = links} := expand(c1, mallocng.cyclic)
  have {f2 = first, k2 = links} := expand(c2, mallocng.cyclic)
  let N1 := seq_len(l1)
  let N2 := seq_len(l2)
  have n1: N1 in omega by arith(h1)
  have n2: N2 in omega by arith(h2)
  let P(i) := int_lt(i, N1) -> int_lt(i, N2) -> l1[i] = l2[i]
  have base: P(0) proof
    assume a b
    have e1 := trans(f1, mp(ite_f[c := N1 = 0, a := 0, b := l1[0]], (!(N1 = 0) by arith(a))))
    have e2 := trans(f2, mp(ite_f[c := N2 = 0, a := 0, b := l2[0]], (!(N2 = 0) by arith(b))))
    show := trans(sym(e1), e2)
  qed
  have step: all i. i in omega -> P(i) -> P(int_add(i, 1)) proof
    fix i
    assume hi ih
    assume a b
    have a0: int_lt(i, N1) by arith(a, hi)
    have b0: int_lt(i, N2) by arith(b, hi)
    have e := mp(ih, a0, b0)
    have x1 _ := mp(all_elim(k1, {i}), hi, a0)
    have x2 _ := mp(all_elim(k2, {i}), hi, b0)
    have m1: int_mod(int_add(i, 1), N1) = int_add(i, 1) by arith(a, hi, n1)
    have m2: int_mod(int_add(i, 1), N2) = int_add(i, 1) by arith(b, hi, n2)
    show by simp(x1, x2, e, m1, m2)
  qed
  show by induct(base, step)
qed

// (neither shorter: a shorter one's last element links back to the head,
// the longer's on to its next -- the head, by the prefix: not distinct)
theorem mp.u_cyc_short(M, h, l1, l2): l1 in list_type(omega) -> l2 in list_type(omega) ->
  (all i. i in omega -> int_lt(i, seq_len(l2)) -> !(l2[i] = 0)) ->
  mallocng.cyclic(M, h, l1) -> mallocng.cyclic(M, h, l2) -> !int_lt(seq_len(l1), seq_len(l2))
proof
  assume h1 h2 z2 c1 c2
  have {f1 = first, k1 = links} := expand(c1, mallocng.cyclic)
  have {f2 = first, d2 = distinct, k2 = links} := expand(c2, mallocng.cyclic)
  have pre := apply(mp.u_cyc_pre[M := M, h := h, l1 := l1, l2 := l2], h1, h2, c1, c2)
  let N1 := seq_len(l1)
  let N2 := seq_len(l2)
  have n1: N1 in omega by arith(h1)
  have n2: N2 in omega by arith(h2)
  have g: int_lt(N1, N2) -> false proof
    assume lt
    // N1 = 0: the head 0, l2's head nonzero
    have c0: N1 = 0 -> false proof
      assume e0
      have hz := trans(f1, mp(ite_t[c := N1 = 0, a := 0, b := l1[0]], e0))
      have hl := trans(f2, mp(ite_f[c := N2 = 0, a := 0, b := l2[0]], (!(N2 = 0) by arith(lt, e0))))
      have nz := mp(all_elim(z2, {0}), simp(), arith(lt, e0))
      show by simp(hz, hl, nz)
    qed
    // else: the last of l1 links to l1's head and to l2[N1]
    have c1n: !(N1 = 0) -> false proof
      assume ne
      let j := int_sub(N1, 1)
      have jo: j in omega by arith(n1, ne)
      have jl1: int_lt(j, N1) by arith(n1, ne)
      have jl2: int_lt(j, N2) by arith(n1, ne, lt)
      have x1 _ := mp(all_elim(k1, {j}), jo, jl1)
      have x2 _ := mp(all_elim(k2, {j}), jo, jl2)
      have ej := mp(all_elim(pre, {j}), jo, jl1, jl2)
      have e0 := mp(all_elim(pre, {0}), simp(), arith(n1, ne), arith(lt, n1))
      have _ m1 := mp(mod_unique_int[x := int_add(j, 1), m := N1, q := 1, r := 0], simp(), simp(), arith(n1, ne), arith(n1, ne),
        (int_add(j, 1) = int_add(int_mul(N1, 1), 0) by arith(n1, ne)))
      have m2: int_mod(int_add(j, 1), N2) = N1 by arith(n1, ne, lt)
      have w: l2[N1] = l2[0] by simp(x1, x2, ej, e0, m1, m2)
      have z0: 0 in omega by simp()
      have p0: int_lt(0, N2) by arith(lt, n1)
      have d := mp(all_elim(d2, {N1}, {0}), conj(n1, z0), conj(lt, p0, w))
      show by arith(d, ne)
    qed
    show by taut(c0, c1n)
  qed
  show by taut(g)
qed

theorem mp.u_cyclic(M, h, l1, l2): l1 in list_type(omega) -> l2 in list_type(omega) ->
  (all i. i in omega -> int_lt(i, seq_len(l1)) -> !(l1[i] = 0)) -> (all i. i in omega -> int_lt(i, seq_len(l2)) -> !(l2[i] = 0)) ->
  mallocng.cyclic(M, h, l1) -> mallocng.cyclic(M, h, l2) -> l1 = l2
proof
  assume h1 h2 z1 z2 c1 c2
  have s12 := apply(mp.u_cyc_short[M := M, h := h, l1 := l1, l2 := l2], h1, h2, z2, c1, c2)
  have s21 := apply(mp.u_cyc_short[M := M, h := h, l1 := l2, l2 := l1], h2, h1, z1, c2, c1)
  have n1: seq_len(l1) in omega by arith(h1)
  have n2: seq_len(l2) in omega by arith(h2)
  have le: seq_len(l1) = seq_len(l2) by arith(s12, s21, n1, n2)
  have pre := apply(mp.u_cyc_pre[M := M, h := h, l1 := l1, l2 := l2], h1, h2, c1, c2)
  have el: all i. i in omega -> int_lt(i, seq_len(l1)) -> l1[i] = l2[i] proof
    fix i
    assume hi hl
    show := mp(all_elim(pre, {i}), hi, hl, (int_lt(i, seq_len(l2)) by arith(hl, le)))
  qed
  show := mp(ext_example[a := l1, b := l2, t := omega], h1, h2, le, el)
qed

// (every byte of the whole memory's view)
theorem mp.u_all(a): a in omega -> a in mallocng.all_bytes
proof
  assume h
  show by defs(simp(h), mallocng.all_bytes)
qed

// a cyclic list in a view whose elements' link words it holds: cyclic in
// the whole memory's view
theorem mp.u_cyc_full(vm, F, h, l): l in list_type(omega) ->
  (all i. i in omega -> int_lt(i, seq_len(l)) -> all a. a in omega -> int_le(l[i], a) -> int_lt(a, int_add(l[i], 16)) -> a in F) ->
  mallocng.cyclic(mallocng.mview(vm, F), h, l) -> mallocng.cyclic(mallocng.mview(vm, mallocng.all_bytes), h, l)
proof
  assume hl hF hc
  have {f = first, d = distinct, k = links} := expand(hc, mallocng.cyclic)
  have k2: all i. i in omega -> int_lt(i, seq_len(l)) ->
      mallocng.rd(mallocng.mview(vm, mallocng.all_bytes), int_add(l[i], 8), 8) = l[int_mod(int_add(i, 1), seq_len(l))] &&
      mallocng.rd(mallocng.mview(vm, mallocng.all_bytes), l[i], 8) = l[int_mod(int_sub(int_add(i, seq_len(l)), 1), seq_len(l))] proof
    fix i
    assume hi hil
    have x1 x2 := mp(all_elim(k, {i}), hi, hil)
    have li := mp(at_type[l := l, t := omega, i := i], hl, hi, hil)
    have inF := mp(all_elim(hF, {i}), hi, hil)
    have in8: all j. j in omega -> int_lt(j, 8) -> int_add(int_add(l[i], 8), j) in F proof
      fix j
      assume hj hjl
      show := mp(all_elim(inF, {int_add(int_add(l[i], 8), j)}), arith(li, hj), arith(li, hj), arith(li, hj, hjl))
    qed
    have in0: all j. j in omega -> int_lt(j, 8) -> int_add(l[i], j) in F proof
      fix j
      assume hj hjl
      show := mp(all_elim(inF, {int_add(l[i], j)}), arith(li, hj), arith(li, hj), arith(li, hj, hjl))
    qed
    have al8: all j. j in omega -> int_lt(j, 8) -> int_add(int_add(l[i], 8), j) in mallocng.all_bytes proof
      fix j
      assume hj hjl
      show := mp(mp.u_all[a := int_add(int_add(l[i], 8), j)], arith(li, hj))
    qed
    have al0: all j. j in omega -> int_lt(j, 8) -> int_add(l[i], j) in mallocng.all_bytes proof
      fix j
      assume hj hjl
      show := mp(mp.u_all[a := int_add(l[i], j)], arith(li, hj))
    qed
    have r8 := mp(mp.u_rd2[vm := vm, F := F, G := mallocng.all_bytes, a := int_add(l[i], 8), n := 8], arith(li), simp(), simp(), in8, al8)
    have r0 := mp(mp.u_rd2[vm := vm, F := F, G := mallocng.all_bytes, a := l[i], n := 8], li, simp(), simp(), in0, al0)
    show by simp(x1, x2, r8, r0)
  qed
  show by defs(taut(f, d, k2), mallocng.cyclic)
qed

// a list of meta slots, cyclic in the view of a state that holds, nothing
// taken: cyclic in the whole memory's view, its elements nonzero
theorem mp.u_meta_list(c, A, vm, b, h, L): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_m(c, A, vm, b) ->
  seq_len(A.taken) = 0 -> L in list_type(omega) -> (all i. i in omega -> int_lt(i, seq_len(L)) -> mallocng.meta_slot(A, L[i])) ->
  mallocng.cyclic(mallocng.mview(vm, mallocng.held(c, A, b)), h, L) ->
  mallocng.cyclic(mallocng.mview(vm, mallocng.all_bytes), h, L) && (all i. i in omega -> int_lt(i, seq_len(L)) -> !(L[i] = 0))
proof
  assume hc hu ha hh ht hl hm hcy
  have nt: all g. mp.untaken(A, g) proof
    fix g
    fix i
    assume hi hil
    show by arith(hi, hil, ht)
  qed
  have hF: all i. i in omega -> int_lt(i, seq_len(L)) -> all a. a in omega -> int_le(L[i], a) -> int_lt(a, int_add(L[i], 16)) -> a in mallocng.held(c, A, b) proof
    fix i
    assume hi hil
    fix a
    assume hao h1 h2
    have {acc = acc} := apply(mp.slot_meta[c := c, A := A, vm := vm, b := b, g := L[i]], hc, hu, ha, hh, mp(all_elim(hm, {i}), hi, hil), all_elim(nt, {L[i]}))
    have r := mp(all_elim(acc, {a}), hao, h1, arith(h2))
    show by taut(r)
  qed
  have full := apply(mp.u_cyc_full[vm := vm, F := mallocng.held(c, A, b), h := h, l := L], hl, hF, hcy)
  have nz: all i. i in omega -> int_lt(i, seq_len(L)) -> !(L[i] = 0) proof
    fix i
    assume hi hil
    have {low = low} := apply(mp.slot_meta[c := c, A := A, vm := vm, b := b, g := L[i]], hc, hu, ha, hh, mp(all_elim(hm, {i}), hi, hil), all_elim(nt, {L[i]}))
    have li := mp(at_type[l := L, t := omega, i := i], hl, hi, hil)
    show by arith(low, li)
  qed
  show by taut(full, nz)
qed

// two states' lists of meta slots, cyclic in their views from the same
// context word: equal
theorem mp.u_ctx_list(c, A, B, vm, b, off, LA, LB): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> B in univ(1) -> B in mallocng.Abs ->
  mallocng.holds_m(c, A, vm, b) -> mallocng.holds_m(c, B, vm, b) -> seq_len(A.taken) = 0 -> seq_len(B.taken) = 0 ->
  off in omega -> int_le(16, off) -> int_le(int_add(off, 8), 464) ->
  LA in list_type(omega) -> LB in list_type(omega) ->
  (all i. i in omega -> int_lt(i, seq_len(LA)) -> mallocng.meta_slot(A, LA[i])) ->
  (all i. i in omega -> int_lt(i, seq_len(LB)) -> mallocng.meta_slot(B, LB[i])) ->
  mallocng.cyclic(mallocng.mview(vm, mallocng.held(c, A, b)), mallocng.ctx_word(c, mallocng.mview(vm, mallocng.held(c, A, b)), off), LA) ->
  mallocng.cyclic(mallocng.mview(vm, mallocng.held(c, B, b)), mallocng.ctx_word(c, mallocng.mview(vm, mallocng.held(c, B, b)), off), LB) ->
  LA = LB
proof
  assume hc hua ha hub hb hha hhb hta htb ho h16 h464 la lb ma mb ca cb
  have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  have ew := apply(mp.u_ctx2[c := c, A := A, B := B, vm := vm, b := b, off := off, n := 8], hc, hua, ha, hub, hb, hha, hhb, ho, simp(),
    arith(h464, ks), apply(mp.u_nofree[c := c, off := off, n := 8], hc, ho, simp(), arith(h16, h464)))
  have hw: mallocng.ctx_word(c, mallocng.mview(vm, mallocng.held(c, A, b)), off) = mallocng.ctx_word(c, mallocng.mview(vm, mallocng.held(c, B, b)), off)
    by defs(ew, mallocng.ctx_word)
  have fa za := apply(mp.u_meta_list[c := c, A := A, vm := vm, b := b, L := LA], hc, hua, ha, hha, hta, la, ma, ca)
  have fb zb := apply(mp.u_meta_list[c := c, A := B, vm := vm, b := b, L := LB], hc, hub, hb, hhb, htb, lb, mb, cb)
  show := apply(mp.u_cyclic, la, lb, za, zb, rewrite(hw, fa), fb)
qed

// (a state's free metas and active lists: lists of meta slots)
theorem mp.u_slots_of(c, A, vm, b): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_m(c, A, vm, b) ->
  (all i. i in omega -> int_lt(i, seq_len(A.free_metas)) -> mallocng.meta_slot(A, A.free_metas[i])) &&
  (all sc i. sc in omega -> int_lt(sc, 48) -> i in omega -> int_lt(i, seq_len(A.active[sc])) -> mallocng.meta_slot(A, A.active[sc][i]))
proof
  assume hc hu ha hh
  have {H = inv} := expand(hh, mallocng.holds_m)
  have {part = part, act = active} := expand(H, mallocng.holds)
  have {fs = free_slots} := expand(part, mallocng.metas_partition)
  have f: all i. i in omega -> int_lt(i, seq_len(A.free_metas)) -> mallocng.meta_slot(A, A.free_metas[i]) proof
    fix i
    assume hi hil
    have r := mp(all_elim(fs, {i}), hi, hil)
    show by taut(r)
  qed
  have a: all sc i. sc in omega -> int_lt(sc, 48) -> i in omega -> int_lt(i, seq_len(A.active[sc])) -> mallocng.meta_slot(A, A.active[sc][i]) proof
    fix sc i
    assume hs hsl hi hil
    have r := mp(all_elim(expand(act, mallocng.active_ok), {sc}, {i}), conj(hs, hi), conj(hsl, hil))
    show := apply(mp.used_slot[g := A.active[sc][i]], H, taut(r))
  qed
  show by taut(f, a)
qed

theorem mp.u_lists(c, A, B, vm, b): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> B in univ(1) -> B in mallocng.Abs ->
  mallocng.holds_m(c, A, vm, b) -> mallocng.holds_m(c, B, vm, b) -> seq_len(A.taken) = 0 -> seq_len(B.taken) = 0 ->
  A.free_metas = B.free_metas && (all sc. sc in omega -> int_lt(sc, 48) -> A.active[sc] = B.active[sc])
proof
  assume hc hua ha hub hb hha hhb hta htb
  have {HA = inv} := expand(hha, mallocng.holds_m)
  have {HB = inv} := expand(hhb, mallocng.holds_m)
  have {cA = ctx} := expand(HA, mallocng.holds)
  have {cB = ctx} := expand(HB, mallocng.holds)
  have {fA = free_metas, aA = active} := expand(cA, mallocng.ctx_ok)
  have {fB = free_metas, aB = active} := expand(cB, mallocng.ctx_ok)
  have sfA saA := apply(mp.u_slots_of[c := c, A := A, vm := vm, b := b], hc, hua, ha, hha)
  have sfB saB := apply(mp.u_slots_of[c := c, A := B, vm := vm, b := b], hc, hub, hb, hhb)
  have ks: mallocng.C_FREE_META = 16 && mallocng.C_ACTIVE = 80 by defs(simp(), mallocng.C_FREE_META, mallocng.C_ACTIVE)
  have lfa: A.free_metas in list_type(omega) by simp(ha)
  have lfb: B.free_metas in list_type(omega) by simp(hb)
  have fm := apply(mp.u_ctx_list[c := c, A := A, B := B, vm := vm, b := b, off := mallocng.C_FREE_META, LA := A.free_metas, LB := B.free_metas],
    hc, hua, ha, hub, hb, hha, hhb, hta, htb, simp(ks), simp(ks), simp(ks), lfa, lfb, sfA, sfB, fA, fB)
  have ac: all sc. sc in omega -> int_lt(sc, 48) -> A.active[sc] = B.active[sc] proof
    fix sc
    assume hs hsl
    have laa: A.active in list_type(list_type(omega)) by simp(ha)
    have lab: B.active in list_type(list_type(omega)) by simp(hb)
    have {nA = nactive} := expand(cA, mallocng.ctx_ok)
    have {nB = nactive} := expand(cB, mallocng.ctx_ok)
    have la := mp(at_type[l := A.active, t := list_type(omega), i := sc], laa, hs, (int_lt(sc, seq_len(A.active)) by arith(hsl, nA)))
    have lb := mp(at_type[l := B.active, t := list_type(omega), i := sc], lab, hs, (int_lt(sc, seq_len(B.active)) by arith(hsl, nB)))
    have ea := mp(all_elim(aA, {sc}), hs, hsl)
    have eb := mp(all_elim(aB, {sc}), hs, hsl)
    have ma: all i. i in omega -> int_lt(i, seq_len(A.active[sc])) -> mallocng.meta_slot(A, A.active[sc][i]) proof
      fix i
      assume hi hil
      show := mp(all_elim(saA, {sc}, {i}), hs, hsl, hi, hil)
    qed
    have mb: all i. i in omega -> int_lt(i, seq_len(B.active[sc])) -> mallocng.meta_slot(B, B.active[sc][i]) proof
      fix i
      assume hi hil
      show := mp(all_elim(saB, {sc}, {i}), hs, hsl, hi, hil)
    qed
    show := apply(mp.u_ctx_list[c := c, A := A, B := B, vm := vm, b := b, off := int_add(mallocng.C_ACTIVE, int_mul(8, sc)), LA := A.active[sc], LB := B.active[sc]],
      hc, hua, ha, hub, hb, hha, hhb, hta, htb, arith(ks, hs), arith(ks, hs), arith(ks, hs, hsl), la, lb, ma, mb, ea, eb)
  qed
  show by taut(fm, ac)
qed

// ----------------------------------------------------------------------
//  A list linked from a head, ended by 0 (the meta areas): determined by
//  memory

abbrev mp.chain(M, h, l) := h = ite(seq_len(l) = 0, 0, l[0]) &&
  (all k. k in omega -> int_lt(k, seq_len(l)) -> mallocng.rd(M, int_add(l[k], 8), 8) = ite(int_lt(int_add(k, 1), seq_len(l)), l[int_add(k, 1)], 0))

theorem mp.u_chain_pre(M, h, l1, l2): l1 in list_type(omega) -> l2 in list_type(omega) -> mp.chain(M, h, l1) -> mp.chain(M, h, l2) ->
  all i. i in omega -> int_lt(i, seq_len(l1)) -> int_lt(i, seq_len(l2)) -> l1[i] = l2[i]
proof
  assume h1 h2 c1 c2
  have f1 k1 := c1
  have f2 k2 := c2
  let N1 := seq_len(l1)
  let N2 := seq_len(l2)
  have n1: N1 in omega by arith(h1)
  have n2: N2 in omega by arith(h2)
  let P(i) := int_lt(i, N1) -> int_lt(i, N2) -> l1[i] = l2[i]
  have base: P(0) proof
    assume a b
    have e1 := trans(f1, mp(ite_f[c := N1 = 0, a := 0, b := l1[0]], (!(N1 = 0) by arith(a, n1))))
    have e2 := trans(f2, mp(ite_f[c := N2 = 0, a := 0, b := l2[0]], (!(N2 = 0) by arith(b, n2))))
    show := trans(sym(e1), e2)
  qed
  have step: all i. i in omega -> P(i) -> P(int_add(i, 1)) proof
    fix i
    assume hi ih
    assume a b
    have a0: int_lt(i, N1) by arith(a, hi)
    have b0: int_lt(i, N2) by arith(b, hi)
    have e := mp(ih, a0, b0)
    have x1 := mp(all_elim(k1, {i}), hi, a0)
    have x2 := mp(all_elim(k2, {i}), hi, b0)
    have t1 := mp(ite_t[c := int_lt(int_add(i, 1), N1), a := l1[int_add(i, 1)], b := 0], a)
    have t2 := mp(ite_t[c := int_lt(int_add(i, 1), N2), a := l2[int_add(i, 1)], b := 0], b)
    show by simp(x1, x2, e, t1, t2)
  qed
  show by induct(base, step)
qed

theorem mp.u_chain_short(M, h, l1, l2): l1 in list_type(omega) -> l2 in list_type(omega) ->
  (all i. i in omega -> int_lt(i, seq_len(l2)) -> !(l2[i] = 0)) ->
  mp.chain(M, h, l1) -> mp.chain(M, h, l2) -> !int_lt(seq_len(l1), seq_len(l2))
proof
  assume h1 h2 z2 c1 c2
  have f1 k1 := c1
  have f2 k2 := c2
  have pre := apply(mp.u_chain_pre[M := M, h := h, l1 := l1, l2 := l2], h1, h2, c1, c2)
  let N1 := seq_len(l1)
  let N2 := seq_len(l2)
  have n1: N1 in omega by arith(h1)
  have n2: N2 in omega by arith(h2)
  have g: int_lt(N1, N2) -> false proof
    assume lt
    have c0: N1 = 0 -> false proof
      assume e0
      have hz := trans(f1, mp(ite_t[c := N1 = 0, a := 0, b := l1[0]], e0))
      have hl := trans(f2, mp(ite_f[c := N2 = 0, a := 0, b := l2[0]], (!(N2 = 0) by arith(lt, e0, n2))))
      have nz := mp(all_elim(z2, {0}), simp(), arith(lt, e0))
      show by simp(hz, hl, nz)
    qed
    have cn: !(N1 = 0) -> false proof
      assume ne
      let j := int_sub(N1, 1)
      have jo: j in omega by arith(n1, ne)
      have jl1: int_lt(j, N1) by arith(n1, ne)
      have jl2: int_lt(j, N2) by arith(n1, ne, lt)
      have x1 := mp(all_elim(k1, {j}), jo, jl1)
      have x2 := mp(all_elim(k2, {j}), jo, jl2)
      have ej := mp(all_elim(pre, {j}), jo, jl1, jl2)
      have t1 := mp(ite_f[c := int_lt(int_add(j, 1), N1), a := l1[int_add(j, 1)], b := 0], (!int_lt(int_add(j, 1), N1) by arith(n1, ne)))
      have t2 := mp(ite_t[c := int_lt(int_add(j, 1), N2), a := l2[int_add(j, 1)], b := 0], (int_lt(int_add(j, 1), N2) by arith(n1, ne, lt)))
      have e1: int_add(j, 1) = N1 by arith(n1, ne)
      have nz := mp(all_elim(z2, {N1}), n1, lt)
      show by simp(x1, x2, ej, t1, t2, e1, nz)
    qed
    show by taut(c0, cn)
  qed
  show by taut(g)
qed

theorem mp.u_chain(M, h, l1, l2): l1 in list_type(omega) -> l2 in list_type(omega) ->
  (all i. i in omega -> int_lt(i, seq_len(l1)) -> !(l1[i] = 0)) -> (all i. i in omega -> int_lt(i, seq_len(l2)) -> !(l2[i] = 0)) ->
  mp.chain(M, h, l1) -> mp.chain(M, h, l2) -> l1 = l2
proof
  assume h1 h2 z1 z2 c1 c2
  have s12 := apply(mp.u_chain_short[M := M, h := h, l1 := l1, l2 := l2], h1, h2, z2, c1, c2)
  have s21 := apply(mp.u_chain_short[M := M, h := h, l1 := l2, l2 := l1], h2, h1, z1, c2, c1)
  have n1: seq_len(l1) in omega by arith(h1)
  have n2: seq_len(l2) in omega by arith(h2)
  have le: seq_len(l1) = seq_len(l2) by arith(s12, s21, n1, n2)
  have pre := apply(mp.u_chain_pre[M := M, h := h, l1 := l1, l2 := l2], h1, h2, c1, c2)
  have el: all i. i in omega -> int_lt(i, seq_len(l1)) -> l1[i] = l2[i] proof
    fix i
    assume hi hl
    show := mp(all_elim(pre, {i}), hi, hl, (int_lt(i, seq_len(l2)) by arith(hl, le)))
  qed
  show := mp(ext_example[a := l1, b := l2, t := omega], h1, h2, le, el)
qed

// a state's meta areas: linked from the context's head word in the whole
// memory's view (their headers the invariant's), nonzero
theorem mp.u_areas_of(c, A, vm, b): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_m(c, A, vm, b) ->
  seq_len(A.taken) = 0 ->
  mp.chain(mallocng.mview(vm, mallocng.all_bytes), mallocng.ctx_word(c, mallocng.mview(vm, mallocng.held(c, A, b)), mallocng.C_AREA_HEAD), A.areas) &&
  (all i. i in omega -> int_lt(i, seq_len(A.areas)) -> !(A.areas[i] = 0))
proof
  assume hc hu ha hh ht
  let M := mallocng.mview(vm, mallocng.held(c, A, b))
  have {H = inv} := expand(hh, mallocng.holds_m)
  have {aok = areas, huo = used, ff = fixed, hga = apart} := expand(H, mallocng.holds)
  have {hd = head, each = each} := expand(aok, mallocng.areas_ok)
  have {fa = areas} := expand(ff, mallocng.fixed_free)
  have alt: A.areas in list_type(omega) by simp(ha)
  have nt: all a. !mallocng.in_taken(A, a) proof
    fix a
    have g: mallocng.in_taken(A, a) -> false proof
      assume h
      obtain k, hko hkl _ _ from expand(h, mallocng.in_taken)
      show by arith(hko, hkl, ht)
    qed
    show by taut(g)
  qed
  have lk: all k. k in omega -> int_lt(k, seq_len(A.areas)) ->
      mallocng.rd(mallocng.mview(vm, mallocng.all_bytes), int_add(A.areas[k], 8), 8) = ite(int_lt(int_add(k, 1), seq_len(A.areas)), A.areas[int_add(k, 1)], 0) proof
    fix k
    assume hk hkl
    have ak := mp(at_type[l := A.areas, t := omega, i := k], alt, hk, hkl)
    have _ _ _ e8 _ _ := mp(all_elim(each, {k}), hk, hkl)
    have inF: all j. j in omega -> int_lt(j, 8) -> int_add(int_add(A.areas[k], 8), j) in mallocng.held(c, A, b) proof
      fix j
      assume hj hjl
      let a := int_add(int_add(A.areas[k], 8), j)
      have hao: a in omega by arith(ak, hj)
      have nl := mp(all_elim(fa, {k}, {a}), conj(hk, hao), (int_lt(k, seq_len(A.areas)) && int_le(A.areas[k], a) && int_lt(a, int_add(A.areas[k], 4096))
        by arith(hkl, ak, hj, hjl)))
      have fp := apply(mp.area_fp[c := c, A := A, M := M, b := b, k := k, a := a], hc, hu, ha, huo, hga, hk, hkl, hao,
        arith(ak, hj), arith(ak, hj, hjl), nl, all_elim(nt, {a}))
      show := apply(mp.area_held[c := c, A := A, M := M, b := b, brk := vm.brk, k := k, a := a], hc, hu, ha, H, hk, hkl, hao,
        arith(ak, hj), arith(ak, hj, hjl), fp)
    qed
    have inA: all j. j in omega -> int_lt(j, 8) -> int_add(int_add(A.areas[k], 8), j) in mallocng.all_bytes proof
      fix j
      assume hj hjl
      show := mp(mp.u_all[a := int_add(int_add(A.areas[k], 8), j)], arith(ak, hj))
    qed
    have r := mp(mp.u_rd2[vm := vm, F := mallocng.held(c, A, b), G := mallocng.all_bytes, a := int_add(A.areas[k], 8), n := 8], arith(ak), simp(), simp(), inF, inA)
    show := trans(sym(r), e8)
  qed
  have hd2: mallocng.ctx_word(c, M, mallocng.C_AREA_HEAD) = ite(seq_len(A.areas) = 0, 0, A.areas[0]) by simp(hd)
  have nz: all i. i in omega -> int_lt(i, seq_len(A.areas)) -> !(A.areas[i] = 0) proof
    fix i
    assume hi hil
    have _ p _ _ _ _ := mp(all_elim(each, {i}), hi, hil)
    have ai := mp(at_type[l := A.areas, t := omega, i := i], alt, hi, hil)
    show by arith(p, ai)
  qed
  show by taut(hd2, lk, nz)
qed

theorem mp.u_areas(c, A, B, vm, b): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> B in univ(1) -> B in mallocng.Abs ->
  mallocng.holds_m(c, A, vm, b) -> mallocng.holds_m(c, B, vm, b) -> seq_len(A.taken) = 0 -> seq_len(B.taken) = 0 ->
  A.areas = B.areas
proof
  assume hc hua ha hub hb hha hhb hta htb
  have ks: mallocng.C_AREA_HEAD = 56 && mallocng.CTX_SIZE = 928 by defs(simp(), mallocng.C_AREA_HEAD, mallocng.CTX_SIZE)
  have ew := apply(mp.u_ctx2[c := c, A := A, B := B, vm := vm, b := b, off := mallocng.C_AREA_HEAD, n := 8], hc, hua, ha, hub, hb, hha, hhb, simp(ks), simp(),
    simp(ks), apply(mp.u_nofree[c := c, off := mallocng.C_AREA_HEAD, n := 8], hc, simp(ks), simp(), simp(ks)))
  have hw: mallocng.ctx_word(c, mallocng.mview(vm, mallocng.held(c, A, b)), mallocng.C_AREA_HEAD) =
      mallocng.ctx_word(c, mallocng.mview(vm, mallocng.held(c, B, b)), mallocng.C_AREA_HEAD) by defs(ew, mallocng.ctx_word)
  have ca1 ca2 za := apply(mp.u_areas_of[c := c, A := A, vm := vm, b := b], hc, hua, ha, hha, hta)
  have cb1 cb2 zb := apply(mp.u_areas_of[c := c, A := B, vm := vm, b := b], hc, hub, hb, hhb, htb)
  have la: A.areas in list_type(omega) by simp(ha)
  have lb: B.areas in list_type(omega) by simp(hb)
  show := apply(mp.u_chain, la, lb, za, zb, rewrite(hw, conj(ca1, ca2)), conj(cb1, cb2))
qed

// ----------------------------------------------------------------------
//  The context's fields

theorem mp.u_ctx_fields(c, A, B, vm, b): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> B in univ(1) -> B in mallocng.Abs ->
  mallocng.holds_m(c, A, vm, b) -> mallocng.holds_m(c, B, vm, b) ->
  A.secret = B.secret && A.init_done = B.init_done && A.avail_cnt = B.avail_cnt && A.reserve_cnt = B.reserve_cnt &&
  A.brk = B.brk && A.reserve = B.reserve
proof
  assume hc hua ha hub hb hha hhb
  have {HA = inv} := expand(hha, mallocng.holds_m)
  have {HB = inv} := expand(hhb, mallocng.holds_m)
  have {cA = ctx, nA = normal} := expand(HA, mallocng.holds)
  have {cB = ctx, nB = normal} := expand(HB, mallocng.holds)
  have {sA = secret, iA = init, vA = avail_cnt, rA = area_cnt, aA = avail_areas, kA = brk} := expand(cA, mallocng.ctx_ok)
  have {sB = secret, iB = init, vB = avail_cnt, rB = area_cnt, aB = avail_areas, kB = brk} := expand(cB, mallocng.ctx_ok)
  have ks: mallocng.C_SECRET = 0 && mallocng.C_INIT_DONE = 8 && mallocng.C_AVAIL_CNT = 32 && mallocng.C_AREA_CNT = 40 &&
      mallocng.C_AVAIL_AREAS = 72 && mallocng.C_BRK = 920 && mallocng.CTX_SIZE = 928
    by defs(simp(), mallocng.C_SECRET, mallocng.C_INIT_DONE, mallocng.C_AVAIL_CNT, mallocng.C_AREA_CNT, mallocng.C_AVAIL_AREAS,
      mallocng.C_BRK, mallocng.CTX_SIZE)
  // (each field: its bytes, read in both views)
  have e0 := apply(mp.u_ctx2[c := c, A := A, B := B, vm := vm, b := b, off := 0, n := 8], hc, hua, ha, hub, hb, hha, hhb, simp(), simp(), simp(ks),
    apply(mp.u_nofree[c := c, off := 0, n := 8], hc, simp(), simp(), simp()))
  have e8 := apply(mp.u_ctx2[c := c, A := A, B := B, vm := vm, b := b, off := 8, n := 4], hc, hua, ha, hub, hb, hha, hhb, simp(), simp(), simp(ks),
    apply(mp.u_nofree[c := c, off := 8, n := 4], hc, simp(), simp(), simp()))
  have e32 := apply(mp.u_ctx2[c := c, A := A, B := B, vm := vm, b := b, off := 32, n := 8], hc, hua, ha, hub, hb, hha, hhb, simp(), simp(), simp(ks),
    apply(mp.u_nofree[c := c, off := 32, n := 8], hc, simp(), simp(), simp()))
  have e40 := apply(mp.u_ctx2[c := c, A := A, B := B, vm := vm, b := b, off := 40, n := 8], hc, hua, ha, hub, hb, hha, hhb, simp(), simp(), simp(ks),
    apply(mp.u_nofree[c := c, off := 40, n := 8], hc, simp(), simp(), simp()))
  have e72 := apply(mp.u_ctx2[c := c, A := A, B := B, vm := vm, b := b, off := 72, n := 8], hc, hua, ha, hub, hb, hha, hhb, simp(), simp(), simp(ks),
    apply(mp.u_nofree[c := c, off := 72, n := 8], hc, simp(), simp(), simp()))
  have e920 := apply(mp.u_ctx2[c := c, A := A, B := B, vm := vm, b := b, off := 920, n := 8], hc, hua, ha, hub, hb, hha, hhb, simp(), simp(), simp(ks),
    apply(mp.u_nofree[c := c, off := 920, n := 8], hc, simp(), simp(), simp()))
  have sec: A.secret = B.secret by simp(expand(sA, mallocng.ctx_word), expand(sB, mallocng.ctx_word), e0, ks)
  have ini: A.init_done = B.init_done by simp(iA, iB, e8, ks)
  have avc: A.avail_cnt = B.avail_cnt by simp(expand(vA, mallocng.ctx_word), expand(vB, mallocng.ctx_word), e32, ks)
  have rsc: A.reserve_cnt = B.reserve_cnt by simp(expand(rA, mallocng.ctx_word), expand(rB, mallocng.ctx_word), e40, ks)
  have brk: A.brk = B.brk by simp(expand(kA, mallocng.ctx_word), expand(kB, mallocng.ctx_word), e920, ks)
  // (the reserve: the context's word while reserved pages remain, else 0)
  have {zA = reserve} := expand(nA, mallocng.normal)
  have {zB = reserve} := expand(nB, mallocng.normal)
  have ro: A.reserve_cnt in omega by simp(ha)
  have d: int_lt(0, A.reserve_cnt) || A.reserve_cnt = 0 by arith(ro)
  have r1: int_lt(0, A.reserve_cnt) -> A.reserve = B.reserve proof
    assume h
    show by simp(h, expand(aA, mallocng.ctx_word), expand(aB, mallocng.ctx_word), e72, ks, rsc)
  qed
  have r0: A.reserve_cnt = 0 -> A.reserve = B.reserve proof
    assume h
    have a0: A.reserve = 0 by taut(zA, h)
    have hb: B.reserve_cnt = 0 by simp(h, rsc)
    have b0: B.reserve = 0 by taut(zB, hb)
    show by simp(a0, b0)
  qed
  have rsv: A.reserve = B.reserve by taut(d, r1, r0)
  show by taut(sec, ini, avc, rsc, brk, rsv)
qed
