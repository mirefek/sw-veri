// The abstract state determined by memory (`mallocng.abs_unique`): two
// abstract states that hold of the same memory (layers/mallocng.sl's
// `rep`) are equal. What the invariant reads, each state through its own
// view, is the memory's bytes: the context's fields; the lists followed
// from it (the auxiliary vector, the meta areas, the free metas, the
// active lists); the used metas (the meta slots neither free nor
// available), their fields and their slots.

// ----------------------------------------------------------------------
//  Reads in two views

// n bytes at a, in both views: the same (the memory's)
theorem mp.u_rd2(vm, F, G, a, n): a in omega -> n in omega -> int_le(n, 18446744073709551616) ->
  (all i. i in omega -> int_lt(i, n) -> int_add(a, i) in F) -> (all i. i in omega -> int_lt(i, n) -> int_add(a, i) in G) ->
  mallocng.rd(mallocng.mview(vm, F), a, n) = mallocng.rd(mallocng.mview(vm, G), a, n)
proof
  assume ha hn hl hf hg
  have f := mp(mp.view_read[vm := vm, fp := F, a := a, n := n], ha, hn, hl, hf)
  have g := mp(mp.view_read[vm := vm, fp := G, a := a, n := n], ha, hn, hl, hg)
  show := trans(sym(f), g)
qed

// the context's bytes the invariant reads (not the free ones), n at off:
// in the view of an abstract state that holds, the memory's
theorem mp.u_ctx(c, A, vm, b, off, n): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_m(c, A, vm, b) ->
  off in omega -> n in omega -> int_le(int_add(off, n), mallocng.CTX_SIZE) ->
  (all i. i in omega -> int_lt(i, n) -> !mallocng.ctx_free(c, int_add(int_add(c.ctx, off), i))) ->
  mallocng.rd(mallocng.mview(vm, mallocng.held(c, A, b)), int_add(c.ctx, off), n) = gimple.bytes_at(vm, int_add(c.ctx, off), n)
proof
  assume hc hu ha hh ho hn hle hnf
  have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  have co: c.ctx in omega by simp(hc)
  have hf: all i. i in omega -> int_lt(i, n) -> int_add(int_add(c.ctx, off), i) in mallocng.held(c, A, b) proof
    fix i
    assume hi hil
    have r := apply(mp.ctx_acc[c := c, A := A, vm := vm, b := b, a := int_add(int_add(c.ctx, off), i)], hc, hu, ha, hh,
      arith(co, ho, hi), arith(co, ho, hi), arith(co, ho, hi, hil, hle, ks), mp(all_elim(hnf, {i}), hi, hil))
    show by taut(r)
  qed
  have v := mp(mp.view_read[vm := vm, fp := mallocng.held(c, A, b), a := int_add(c.ctx, off), n := n], arith(co, ho), hn, arith(hn, hle, ks), hf)
  show := sym(v)
qed

// ... the same in two abstract states' views
theorem mp.u_ctx2(c, A, B, vm, b, off, n): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> B in univ(1) -> B in mallocng.Abs ->
  mallocng.holds_m(c, A, vm, b) -> mallocng.holds_m(c, B, vm, b) ->
  off in omega -> n in omega -> int_le(int_add(off, n), mallocng.CTX_SIZE) ->
  (all i. i in omega -> int_lt(i, n) -> !mallocng.ctx_free(c, int_add(int_add(c.ctx, off), i))) ->
  mallocng.rd(mallocng.mview(vm, mallocng.held(c, A, b)), int_add(c.ctx, off), n) = mallocng.rd(mallocng.mview(vm, mallocng.held(c, B, b)), int_add(c.ctx, off), n)
proof
  assume hc hua ha hub hb hha hhb ho hn hle hnf
  have ea := apply(mp.u_ctx[c := c, A := A, vm := vm, b := b, off := off, n := n], hc, hua, ha, hha, ho, hn, hle, hnf)
  have eb := apply(mp.u_ctx[c := c, A := B, vm := vm, b := b, off := off, n := n], hc, hub, hb, hhb, ho, hn, hle, hnf)
  show := trans(ea, sym(eb))
qed

// (the context's words the invariant reads: none of the free bytes --
// those at 12..16 and 464..920)
theorem mp.u_nofree(c, off, n): c in mallocng.Cfg -> off in omega -> n in omega ->
  ((int_le(int_add(off, n), 12)) || (int_le(16, off) && int_le(int_add(off, n), 464)) || int_le(920, off)) ->
  all i. i in omega -> int_lt(i, n) -> !mallocng.ctx_free(c, int_add(int_add(c.ctx, off), i))
proof
  assume hc ho hn hr
  fix i
  assume hi hil
  have co: c.ctx in omega by simp(hc)
  have ks: mallocng.C_MMAP_CNT = 12 && mallocng.C_USAGE = 464 && mallocng.C_BRK = 920
    by defs(simp(), mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK)
  show by defs(arith(ks, co, ho, hn, hr, hi, hil), mallocng.ctx_free)
qed

// (nothing taken: no byte in a taken meta)
theorem mp.u_nt(A, a): seq_len(A.taken) = 0 -> !mallocng.in_taken(A, a)
proof
  assume ht
  have g: mallocng.in_taken(A, a) -> false proof
    assume h
    obtain k, hko hkl _ _ from expand(h, mallocng.in_taken)
    show by arith(hko, hkl, ht)
  qed
  show by taut(g)
qed

// a byte in a state's ranges, in no reserved slot or taken meta: held
// exactly when not live and not a free byte of the context
theorem mp.u_held_char(c, A, b, a): a in omega -> mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) ->
  !mallocng.in_reserved(A, a) -> !mallocng.in_taken(A, a) ->
  (a in mallocng.held(c, A, b) <-> !(a in malloc.live_of(b)) && !mallocng.ctx_free(c, a))
proof
  assume hao irs hnr hnt
  have to: a in mallocng.held(c, A, b) -> !(a in malloc.live_of(b)) && !mallocng.ctx_free(c, a) proof
    assume h
    have {fp = fp, nf = free} := apply(mp.held_fp, h)
    have s1 := set_select_def[s := omega, p := y. y in mallocng.fp_set(mallocng.fp_ranges(c, A), b) && !mallocng.in_reserved(A, y) && !mallocng.in_taken(A, y), z := a]
    have fs: a in mallocng.fp_set(mallocng.fp_ranges(c, A), b) by taut(s1, expand(fp, mallocng.footprint))
    have s3 := set_select_def[s := omega, p := y. mallocng.in_ranges(y, mallocng.fp_ranges(c, A)) && !(y in malloc.live_of(b)), z := a]
    have nl: !(a in malloc.live_of(b)) by taut(s3, expand(fs, mallocng.fp_set))
    show by taut(nl, nf)
  qed
  have from: !(a in malloc.live_of(b)) -> !mallocng.ctx_free(c, a) -> a in mallocng.held(c, A, b) proof
    assume nl nf
    have inn: a in mallocng.fp_set(mallocng.fp_ranges(c, A), b) by defs(sel(taut(hao, irs, nl)), mallocng.fp_set)
    have fp: a in mallocng.footprint(c, A, b) by defs(sel(taut(hao, inn, hnr, hnt)), mallocng.footprint)
    show := apply(mp.held_intro, fp, nf)
  qed
  show by taut(to, from)
qed

// a byte in both states' ranges, neither with a slot reserved nor a meta
// taken: held by one exactly when by the other
theorem mp.u_held_iff(c, A, B, b, a): a in omega -> mallocng.no_reserved(A) -> mallocng.no_reserved(B) ->
  seq_len(A.taken) = 0 -> seq_len(B.taken) = 0 ->
  mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) -> mallocng.in_ranges(a, mallocng.fp_ranges(c, B)) ->
  (a in mallocng.held(c, A, b) <-> a in mallocng.held(c, B, b))
proof
  assume hao hra hrb hta htb ina inb
  have ca := apply(mp.u_held_char[c := c, A := A, b := b, a := a], hao, ina, mp(mp.nores[A := A, a := a], hra), mp(mp.u_nt[A := A, a := a], hta))
  have cb := apply(mp.u_held_char[c := c, A := B, b := b, a := a], hao, inb, mp(mp.nores[A := B, a := a], hrb), mp(mp.u_nt[A := B, a := a], htb))
  show by taut(ca, cb)
qed

// ... so both views the same there
theorem mp.u_view_at(vm, F, G, a): a in omega -> (a in F <-> a in G) -> mallocng.mview(vm, F)[a] = mallocng.mview(vm, G)[a]
proof
  assume hao h
  show by defs(simp(hao, h), mallocng.mview)
qed

// n bytes at a in both states' ranges: read the same in both views
theorem mp.u_rd_same(c, A, B, vm, b, a, n): mallocng.no_reserved(A) -> mallocng.no_reserved(B) ->
  seq_len(A.taken) = 0 -> seq_len(B.taken) = 0 -> n in omega ->
  (all i. i in omega -> int_lt(i, n) -> int_add(a, i) in omega &&
     mallocng.in_ranges(int_add(a, i), mallocng.fp_ranges(c, A)) && mallocng.in_ranges(int_add(a, i), mallocng.fp_ranges(c, B))) ->
  mallocng.rd(mallocng.mview(vm, mallocng.held(c, A, b)), a, n) = mallocng.rd(mallocng.mview(vm, mallocng.held(c, B, b)), a, n)
proof
  assume hra hrb hta htb hn hr
  have e: all i. i in omega -> int_lt(i, n) ->
      mallocng.mview(vm, mallocng.held(c, B, b))[int_add(a, i)] = mallocng.mview(vm, mallocng.held(c, A, b))[int_add(a, i)] proof
    fix i
    assume hi hil
    have ao ia ib := mp(all_elim(hr, {i}), hi, hil)
    have iff := apply(mp.u_held_iff[c := c, A := B, B := A, b := b, a := int_add(a, i)], ao, hrb, hra, htb, hta, ib, ia)
    show := apply(mp.u_view_at[vm := vm, F := mallocng.held(c, B, b), G := mallocng.held(c, A, b), a := int_add(a, i)], ao, iff)
  qed
  show := sym(mp(mp.agree_rd[M := mallocng.mview(vm, mallocng.held(c, A, b)), M2 := mallocng.mview(vm, mallocng.held(c, B, b)), a := a, n := n], hn, e))
qed

// the fixed ranges in the footprint's ranges
theorem mp.u_fixed_fp(c, A, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs ->
  mallocng.in_ranges(a, mallocng.fixed_ranges(c, A)) -> mallocng.in_ranges(a, mallocng.fp_ranges(c, A))
proof
  assume hc hu ha h
  have pl := apply(mp.pre_list, hc, hu, ha)
  have {gl = groups} := apply(mp.fp_pieces, hc, hu, ha)
  have h2 := expand(h, mallocng.fixed_ranges)
  have r := apply(mp.ranges_l, pl, gl, h2)
  show by defs(r, mallocng.fp_ranges, mallocng.fixed_ranges)
qed

// a byte of the data symbols (the context, the lock, libc's), and of the
// auxiliary vector's entries: in the footprint's ranges
theorem mp.u_front_fp(c, A, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs ->
  (mallocng.in_ranges(a, mallocng.data_ranges(c)) || mallocng.in_ranges(a, mallocng.auxv_ranges(A))) ->
  mallocng.in_ranges(a, mallocng.fp_ranges(c, A))
proof
  assume hc hu ha h
  have {rd = rodata, ax = auxv} := apply(mp.front_pieces, hc, hu, ha)
  have ro := apply(mp.ro_list, (c.file in seq_type(bits(8)) by simp(hc)))
  have cf: c.ctx in omega && c.lock in omega && c.libc in omega by simp(hc)
  have o1 := apply(tr.seq_one_type, (pair(c.ctx, mallocng.CTX_SIZE) in univ(1) by simp(cf)))
  have o2 := apply(tr.seq_one_type, (pair(c.lock, 4) in univ(1) by simp(cf)))
  have o3 := apply(tr.seq_one_type, (pair(c.libc, 16) in univ(1) by simp(cf)))
  have dl: mallocng.data_ranges(c) in list_type(univ(1)) by defs(apply(tr.concat_list, apply(tr.concat_list, o1, o2), o3), mallocng.data_ranges)
  have d: mallocng.in_ranges(a, mallocng.data_ranges(c)) -> mallocng.in_ranges(a, seq_concat(seq_concat(mallocng.ro_ranges(c.file), mallocng.data_ranges(c)), mallocng.auxv_ranges(A))) proof
    assume hd
    show := apply(mp.ranges_l, rd, ax, apply(mp.ranges_r, ro, dl, hd))
  qed
  have x: mallocng.in_ranges(a, mallocng.auxv_ranges(A)) -> mallocng.in_ranges(a, seq_concat(seq_concat(mallocng.ro_ranges(c.file), mallocng.data_ranges(c)), mallocng.auxv_ranges(A))) proof
    assume hx
    show := apply(mp.ranges_r, rd, ax, hx)
  qed
  have q: mallocng.in_ranges(a, seq_concat(seq_concat(mallocng.ro_ranges(c.file), mallocng.data_ranges(c)), mallocng.auxv_ranges(A))) by taut(h, d, x)
  show := apply(mp.u_fixed_fp, hc, hu, ha, apply(mp.fixed_in[c := c, A := A, a := a], hc, hu, ha, taut(q)))
qed

// ----------------------------------------------------------------------
//  A cyclic list from a head (of nonzero elements): determined by memory

// (the common prefix: equal)
theorem mp.u_cyc_pre(M, h, l1, l2): l1 in list_type(omega) -> l2 in list_type(omega) ->
  mallocng.cyclic(M, h, l1) -> mallocng.cyclic(M, h, l2) ->
  all i. i in omega -> int_lt(i, seq_len(l1)) -> int_lt(i, seq_len(l2)) -> l1[i] = l2[i]
proof
  assume h1 h2 c1 c2
  have {f1 = first, k1 = links} := expand(c1, mallocng.cyclic)
  have {f2 = first, k2 = links} := expand(c2, mallocng.cyclic)
  let N1 := seq_len(l1)
  let N2 := seq_len(l2)
  have n1: N1 in omega by arith(h1)
  have n2: N2 in omega by arith(h2)
  let P(i) := int_lt(i, N1) -> int_lt(i, N2) -> l1[i] = l2[i]
  have base: P(0) proof
    assume a b
    have e1 := trans(f1, mp(ite_f[c := N1 = 0, a := 0, b := l1[0]], (!(N1 = 0) by arith(a))))
    have e2 := trans(f2, mp(ite_f[c := N2 = 0, a := 0, b := l2[0]], (!(N2 = 0) by arith(b))))
    show := trans(sym(e1), e2)
  qed
  have step: all i. i in omega -> P(i) -> P(int_add(i, 1)) proof
    fix i
    assume hi ih
    assume a b
    have a0: int_lt(i, N1) by arith(a, hi)
    have b0: int_lt(i, N2) by arith(b, hi)
    have e := mp(ih, a0, b0)
    have x1 _ := mp(all_elim(k1, {i}), hi, a0)
    have x2 _ := mp(all_elim(k2, {i}), hi, b0)
    have m1: int_mod(int_add(i, 1), N1) = int_add(i, 1) by arith(a, hi, n1)
    have m2: int_mod(int_add(i, 1), N2) = int_add(i, 1) by arith(b, hi, n2)
    show by simp(x1, x2, e, m1, m2)
  qed
  show by induct(base, step)
qed

// (neither shorter: a shorter one's last element links back to the head,
// the longer's on to its next -- the head, by the prefix: not distinct)
theorem mp.u_cyc_short(M, h, l1, l2): l1 in list_type(omega) -> l2 in list_type(omega) ->
  (all i. i in omega -> int_lt(i, seq_len(l2)) -> !(l2[i] = 0)) ->
  mallocng.cyclic(M, h, l1) -> mallocng.cyclic(M, h, l2) -> !int_lt(seq_len(l1), seq_len(l2))
proof
  assume h1 h2 z2 c1 c2
  have {f1 = first, k1 = links} := expand(c1, mallocng.cyclic)
  have {f2 = first, d2 = distinct, k2 = links} := expand(c2, mallocng.cyclic)
  have pre := apply(mp.u_cyc_pre[M := M, h := h, l1 := l1, l2 := l2], h1, h2, c1, c2)
  let N1 := seq_len(l1)
  let N2 := seq_len(l2)
  have n1: N1 in omega by arith(h1)
  have n2: N2 in omega by arith(h2)
  have g: int_lt(N1, N2) -> false proof
    assume lt
    // N1 = 0: the head 0, l2's head nonzero
    have c0: N1 = 0 -> false proof
      assume e0
      have hz := trans(f1, mp(ite_t[c := N1 = 0, a := 0, b := l1[0]], e0))
      have hl := trans(f2, mp(ite_f[c := N2 = 0, a := 0, b := l2[0]], (!(N2 = 0) by arith(lt, e0))))
      have nz := mp(all_elim(z2, {0}), simp(), arith(lt, e0))
      show by simp(hz, hl, nz)
    qed
    // else: the last of l1 links to l1's head and to l2[N1]
    have c1n: !(N1 = 0) -> false proof
      assume ne
      let j := int_sub(N1, 1)
      have jo: j in omega by arith(n1, ne)
      have jl1: int_lt(j, N1) by arith(n1, ne)
      have jl2: int_lt(j, N2) by arith(n1, ne, lt)
      have x1 _ := mp(all_elim(k1, {j}), jo, jl1)
      have x2 _ := mp(all_elim(k2, {j}), jo, jl2)
      have ej := mp(all_elim(pre, {j}), jo, jl1, jl2)
      have e0 := mp(all_elim(pre, {0}), simp(), arith(n1, ne), arith(lt, n1))
      have _ m1 := mp(mod_unique_int[x := int_add(j, 1), m := N1, q := 1, r := 0], simp(), simp(), arith(n1, ne), arith(n1, ne),
        (int_add(j, 1) = int_add(int_mul(N1, 1), 0) by arith(n1, ne)))
      have m2: int_mod(int_add(j, 1), N2) = N1 by arith(n1, ne, lt)
      have w: l2[N1] = l2[0] by simp(x1, x2, ej, e0, m1, m2)
      have z0: 0 in omega by simp()
      have p0: int_lt(0, N2) by arith(lt, n1)
      have d := mp(all_elim(d2, {N1}, {0}), conj(n1, z0), conj(lt, p0, w))
      show by arith(d, ne)
    qed
    show by taut(c0, c1n)
  qed
  show by taut(g)
qed

theorem mp.u_cyclic(M, h, l1, l2): l1 in list_type(omega) -> l2 in list_type(omega) ->
  (all i. i in omega -> int_lt(i, seq_len(l1)) -> !(l1[i] = 0)) -> (all i. i in omega -> int_lt(i, seq_len(l2)) -> !(l2[i] = 0)) ->
  mallocng.cyclic(M, h, l1) -> mallocng.cyclic(M, h, l2) -> l1 = l2
proof
  assume h1 h2 z1 z2 c1 c2
  have s12 := apply(mp.u_cyc_short[M := M, h := h, l1 := l1, l2 := l2], h1, h2, z2, c1, c2)
  have s21 := apply(mp.u_cyc_short[M := M, h := h, l1 := l2, l2 := l1], h2, h1, z1, c2, c1)
  have n1: seq_len(l1) in omega by arith(h1)
  have n2: seq_len(l2) in omega by arith(h2)
  have le: seq_len(l1) = seq_len(l2) by arith(s12, s21, n1, n2)
  have pre := apply(mp.u_cyc_pre[M := M, h := h, l1 := l1, l2 := l2], h1, h2, c1, c2)
  have el: all i. i in omega -> int_lt(i, seq_len(l1)) -> l1[i] = l2[i] proof
    fix i
    assume hi hl
    show := mp(all_elim(pre, {i}), hi, hl, (int_lt(i, seq_len(l2)) by arith(hl, le)))
  qed
  show := mp(ext_example[a := l1, b := l2, t := omega], h1, h2, le, el)
qed

// (every byte of the whole memory's view)
theorem mp.u_all(a): a in omega -> a in mallocng.all_bytes
proof
  assume h
  show by defs(simp(h), mallocng.all_bytes)
qed

// a cyclic list in a view whose elements' link words it holds: cyclic in
// the whole memory's view
theorem mp.u_cyc_full(vm, F, h, l): l in list_type(omega) ->
  (all i. i in omega -> int_lt(i, seq_len(l)) -> all a. a in omega -> int_le(l[i], a) -> int_lt(a, int_add(l[i], 16)) -> a in F) ->
  mallocng.cyclic(mallocng.mview(vm, F), h, l) -> mallocng.cyclic(mallocng.mview(vm, mallocng.all_bytes), h, l)
proof
  assume hl hF hc
  have {f = first, d = distinct, k = links} := expand(hc, mallocng.cyclic)
  have k2: all i. i in omega -> int_lt(i, seq_len(l)) ->
      mallocng.rd(mallocng.mview(vm, mallocng.all_bytes), int_add(l[i], 8), 8) = l[int_mod(int_add(i, 1), seq_len(l))] &&
      mallocng.rd(mallocng.mview(vm, mallocng.all_bytes), l[i], 8) = l[int_mod(int_sub(int_add(i, seq_len(l)), 1), seq_len(l))] proof
    fix i
    assume hi hil
    have x1 x2 := mp(all_elim(k, {i}), hi, hil)
    have li := mp(at_type[l := l, t := omega, i := i], hl, hi, hil)
    have inF := mp(all_elim(hF, {i}), hi, hil)
    have in8: all j. j in omega -> int_lt(j, 8) -> int_add(int_add(l[i], 8), j) in F proof
      fix j
      assume hj hjl
      show := mp(all_elim(inF, {int_add(int_add(l[i], 8), j)}), arith(li, hj), arith(li, hj), arith(li, hj, hjl))
    qed
    have in0: all j. j in omega -> int_lt(j, 8) -> int_add(l[i], j) in F proof
      fix j
      assume hj hjl
      show := mp(all_elim(inF, {int_add(l[i], j)}), arith(li, hj), arith(li, hj), arith(li, hj, hjl))
    qed
    have al8: all j. j in omega -> int_lt(j, 8) -> int_add(int_add(l[i], 8), j) in mallocng.all_bytes proof
      fix j
      assume hj hjl
      show := mp(mp.u_all[a := int_add(int_add(l[i], 8), j)], arith(li, hj))
    qed
    have al0: all j. j in omega -> int_lt(j, 8) -> int_add(l[i], j) in mallocng.all_bytes proof
      fix j
      assume hj hjl
      show := mp(mp.u_all[a := int_add(l[i], j)], arith(li, hj))
    qed
    have r8 := mp(mp.u_rd2[vm := vm, F := F, G := mallocng.all_bytes, a := int_add(l[i], 8), n := 8], arith(li), simp(), simp(), in8, al8)
    have r0 := mp(mp.u_rd2[vm := vm, F := F, G := mallocng.all_bytes, a := l[i], n := 8], li, simp(), simp(), in0, al0)
    show by simp(x1, x2, r8, r0)
  qed
  show by defs(taut(f, d, k2), mallocng.cyclic)
qed

// a list of meta slots, cyclic in the view of a state that holds, nothing
// taken: cyclic in the whole memory's view, its elements nonzero
theorem mp.u_meta_list(c, A, vm, b, h, L): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_m(c, A, vm, b) ->
  seq_len(A.taken) = 0 -> L in list_type(omega) -> (all i. i in omega -> int_lt(i, seq_len(L)) -> mallocng.meta_slot(A, L[i])) ->
  mallocng.cyclic(mallocng.mview(vm, mallocng.held(c, A, b)), h, L) ->
  mallocng.cyclic(mallocng.mview(vm, mallocng.all_bytes), h, L) && (all i. i in omega -> int_lt(i, seq_len(L)) -> !(L[i] = 0))
proof
  assume hc hu ha hh ht hl hm hcy
  have nt: all g. mp.untaken(A, g) proof
    fix g
    fix i
    assume hi hil
    show by arith(hi, hil, ht)
  qed
  have hF: all i. i in omega -> int_lt(i, seq_len(L)) -> all a. a in omega -> int_le(L[i], a) -> int_lt(a, int_add(L[i], 16)) -> a in mallocng.held(c, A, b) proof
    fix i
    assume hi hil
    fix a
    assume hao h1 h2
    have {acc = acc} := apply(mp.slot_meta[c := c, A := A, vm := vm, b := b, g := L[i]], hc, hu, ha, hh, mp(all_elim(hm, {i}), hi, hil), all_elim(nt, {L[i]}))
    have r := mp(all_elim(acc, {a}), hao, h1, arith(h2))
    show by taut(r)
  qed
  have full := apply(mp.u_cyc_full[vm := vm, F := mallocng.held(c, A, b), h := h, l := L], hl, hF, hcy)
  have nz: all i. i in omega -> int_lt(i, seq_len(L)) -> !(L[i] = 0) proof
    fix i
    assume hi hil
    have {low = low} := apply(mp.slot_meta[c := c, A := A, vm := vm, b := b, g := L[i]], hc, hu, ha, hh, mp(all_elim(hm, {i}), hi, hil), all_elim(nt, {L[i]}))
    have li := mp(at_type[l := L, t := omega, i := i], hl, hi, hil)
    show by arith(low, li)
  qed
  show by taut(full, nz)
qed

// two states' lists of meta slots, cyclic in their views from the same
// context word: equal
theorem mp.u_ctx_list(c, A, B, vm, b, off, LA, LB): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> B in univ(1) -> B in mallocng.Abs ->
  mallocng.holds_m(c, A, vm, b) -> mallocng.holds_m(c, B, vm, b) -> seq_len(A.taken) = 0 -> seq_len(B.taken) = 0 ->
  off in omega -> int_le(16, off) -> int_le(int_add(off, 8), 464) ->
  LA in list_type(omega) -> LB in list_type(omega) ->
  (all i. i in omega -> int_lt(i, seq_len(LA)) -> mallocng.meta_slot(A, LA[i])) ->
  (all i. i in omega -> int_lt(i, seq_len(LB)) -> mallocng.meta_slot(B, LB[i])) ->
  mallocng.cyclic(mallocng.mview(vm, mallocng.held(c, A, b)), mallocng.ctx_word(c, mallocng.mview(vm, mallocng.held(c, A, b)), off), LA) ->
  mallocng.cyclic(mallocng.mview(vm, mallocng.held(c, B, b)), mallocng.ctx_word(c, mallocng.mview(vm, mallocng.held(c, B, b)), off), LB) ->
  LA = LB
proof
  assume hc hua ha hub hb hha hhb hta htb ho h16 h464 la lb ma mb ca cb
  have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  have ew := apply(mp.u_ctx2[c := c, A := A, B := B, vm := vm, b := b, off := off, n := 8], hc, hua, ha, hub, hb, hha, hhb, ho, simp(),
    arith(h464, ks), apply(mp.u_nofree[c := c, off := off, n := 8], hc, ho, simp(), arith(h16, h464)))
  have hw: mallocng.ctx_word(c, mallocng.mview(vm, mallocng.held(c, A, b)), off) = mallocng.ctx_word(c, mallocng.mview(vm, mallocng.held(c, B, b)), off)
    by defs(ew, mallocng.ctx_word)
  have fa za := apply(mp.u_meta_list[c := c, A := A, vm := vm, b := b, L := LA], hc, hua, ha, hha, hta, la, ma, ca)
  have fb zb := apply(mp.u_meta_list[c := c, A := B, vm := vm, b := b, L := LB], hc, hub, hb, hhb, htb, lb, mb, cb)
  show := apply(mp.u_cyclic, la, lb, za, zb, rewrite(hw, fa), fb)
qed

// (a state's free metas and active lists: lists of meta slots)
theorem mp.u_slots_of(c, A, vm, b): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_m(c, A, vm, b) ->
  (all i. i in omega -> int_lt(i, seq_len(A.free_metas)) -> mallocng.meta_slot(A, A.free_metas[i])) &&
  (all sc i. sc in omega -> int_lt(sc, 48) -> i in omega -> int_lt(i, seq_len(A.active[sc])) -> mallocng.meta_slot(A, A.active[sc][i]))
proof
  assume hc hu ha hh
  have {H = inv} := expand(hh, mallocng.holds_m)
  have {part = part, act = active} := expand(H, mallocng.holds)
  have {fs = free_slots} := expand(part, mallocng.metas_partition)
  have f: all i. i in omega -> int_lt(i, seq_len(A.free_metas)) -> mallocng.meta_slot(A, A.free_metas[i]) proof
    fix i
    assume hi hil
    have r := mp(all_elim(fs, {i}), hi, hil)
    show by taut(r)
  qed
  have a: all sc i. sc in omega -> int_lt(sc, 48) -> i in omega -> int_lt(i, seq_len(A.active[sc])) -> mallocng.meta_slot(A, A.active[sc][i]) proof
    fix sc i
    assume hs hsl hi hil
    have r := mp(all_elim(expand(act, mallocng.active_ok), {sc}, {i}), conj(hs, hi), conj(hsl, hil))
    show := apply(mp.used_slot[g := A.active[sc][i]], H, taut(r))
  qed
  show by taut(f, a)
qed

theorem mp.u_lists(c, A, B, vm, b): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> B in univ(1) -> B in mallocng.Abs ->
  mallocng.holds_m(c, A, vm, b) -> mallocng.holds_m(c, B, vm, b) -> seq_len(A.taken) = 0 -> seq_len(B.taken) = 0 ->
  A.free_metas = B.free_metas && (all sc. sc in omega -> int_lt(sc, 48) -> A.active[sc] = B.active[sc])
proof
  assume hc hua ha hub hb hha hhb hta htb
  have {HA = inv} := expand(hha, mallocng.holds_m)
  have {HB = inv} := expand(hhb, mallocng.holds_m)
  have {cA = ctx} := expand(HA, mallocng.holds)
  have {cB = ctx} := expand(HB, mallocng.holds)
  have {fA = free_metas, aA = active} := expand(cA, mallocng.ctx_ok)
  have {fB = free_metas, aB = active} := expand(cB, mallocng.ctx_ok)
  have sfA saA := apply(mp.u_slots_of[c := c, A := A, vm := vm, b := b], hc, hua, ha, hha)
  have sfB saB := apply(mp.u_slots_of[c := c, A := B, vm := vm, b := b], hc, hub, hb, hhb)
  have ks: mallocng.C_FREE_META = 16 && mallocng.C_ACTIVE = 80 by defs(simp(), mallocng.C_FREE_META, mallocng.C_ACTIVE)
  have lfa: A.free_metas in list_type(omega) by simp(ha)
  have lfb: B.free_metas in list_type(omega) by simp(hb)
  have fm := apply(mp.u_ctx_list[c := c, A := A, B := B, vm := vm, b := b, off := mallocng.C_FREE_META, LA := A.free_metas, LB := B.free_metas],
    hc, hua, ha, hub, hb, hha, hhb, hta, htb, simp(ks), simp(ks), simp(ks), lfa, lfb, sfA, sfB, fA, fB)
  have ac: all sc. sc in omega -> int_lt(sc, 48) -> A.active[sc] = B.active[sc] proof
    fix sc
    assume hs hsl
    have laa: A.active in list_type(list_type(omega)) by simp(ha)
    have lab: B.active in list_type(list_type(omega)) by simp(hb)
    have {nA = nactive} := expand(cA, mallocng.ctx_ok)
    have {nB = nactive} := expand(cB, mallocng.ctx_ok)
    have la := mp(at_type[l := A.active, t := list_type(omega), i := sc], laa, hs, (int_lt(sc, seq_len(A.active)) by arith(hsl, nA)))
    have lb := mp(at_type[l := B.active, t := list_type(omega), i := sc], lab, hs, (int_lt(sc, seq_len(B.active)) by arith(hsl, nB)))
    have ea := mp(all_elim(aA, {sc}), hs, hsl)
    have eb := mp(all_elim(aB, {sc}), hs, hsl)
    have ma: all i. i in omega -> int_lt(i, seq_len(A.active[sc])) -> mallocng.meta_slot(A, A.active[sc][i]) proof
      fix i
      assume hi hil
      show := mp(all_elim(saA, {sc}, {i}), hs, hsl, hi, hil)
    qed
    have mb: all i. i in omega -> int_lt(i, seq_len(B.active[sc])) -> mallocng.meta_slot(B, B.active[sc][i]) proof
      fix i
      assume hi hil
      show := mp(all_elim(saB, {sc}, {i}), hs, hsl, hi, hil)
    qed
    show := apply(mp.u_ctx_list[c := c, A := A, B := B, vm := vm, b := b, off := int_add(mallocng.C_ACTIVE, int_mul(8, sc)), LA := A.active[sc], LB := B.active[sc]],
      hc, hua, ha, hub, hb, hha, hhb, hta, htb, arith(ks, hs), arith(ks, hs), arith(ks, hs, hsl), la, lb, ma, mb, ea, eb)
  qed
  show by taut(fm, ac)
qed

// ----------------------------------------------------------------------
//  A list linked from a head, ended by 0 (the meta areas): determined by
//  memory

abbrev mp.chain(M, h, l) := h = ite(seq_len(l) = 0, 0, l[0]) &&
  (all k. k in omega -> int_lt(k, seq_len(l)) -> mallocng.rd(M, int_add(l[k], 8), 8) = ite(int_lt(int_add(k, 1), seq_len(l)), l[int_add(k, 1)], 0))

theorem mp.u_chain_pre(M, h, l1, l2): l1 in list_type(omega) -> l2 in list_type(omega) -> mp.chain(M, h, l1) -> mp.chain(M, h, l2) ->
  all i. i in omega -> int_lt(i, seq_len(l1)) -> int_lt(i, seq_len(l2)) -> l1[i] = l2[i]
proof
  assume h1 h2 c1 c2
  have f1 k1 := c1
  have f2 k2 := c2
  let N1 := seq_len(l1)
  let N2 := seq_len(l2)
  have n1: N1 in omega by arith(h1)
  have n2: N2 in omega by arith(h2)
  let P(i) := int_lt(i, N1) -> int_lt(i, N2) -> l1[i] = l2[i]
  have base: P(0) proof
    assume a b
    have e1 := trans(f1, mp(ite_f[c := N1 = 0, a := 0, b := l1[0]], (!(N1 = 0) by arith(a, n1))))
    have e2 := trans(f2, mp(ite_f[c := N2 = 0, a := 0, b := l2[0]], (!(N2 = 0) by arith(b, n2))))
    show := trans(sym(e1), e2)
  qed
  have step: all i. i in omega -> P(i) -> P(int_add(i, 1)) proof
    fix i
    assume hi ih
    assume a b
    have a0: int_lt(i, N1) by arith(a, hi)
    have b0: int_lt(i, N2) by arith(b, hi)
    have e := mp(ih, a0, b0)
    have x1 := mp(all_elim(k1, {i}), hi, a0)
    have x2 := mp(all_elim(k2, {i}), hi, b0)
    have t1 := mp(ite_t[c := int_lt(int_add(i, 1), N1), a := l1[int_add(i, 1)], b := 0], a)
    have t2 := mp(ite_t[c := int_lt(int_add(i, 1), N2), a := l2[int_add(i, 1)], b := 0], b)
    show by simp(x1, x2, e, t1, t2)
  qed
  show by induct(base, step)
qed

theorem mp.u_chain_short(M, h, l1, l2): l1 in list_type(omega) -> l2 in list_type(omega) ->
  (all i. i in omega -> int_lt(i, seq_len(l2)) -> !(l2[i] = 0)) ->
  mp.chain(M, h, l1) -> mp.chain(M, h, l2) -> !int_lt(seq_len(l1), seq_len(l2))
proof
  assume h1 h2 z2 c1 c2
  have f1 k1 := c1
  have f2 k2 := c2
  have pre := apply(mp.u_chain_pre[M := M, h := h, l1 := l1, l2 := l2], h1, h2, c1, c2)
  let N1 := seq_len(l1)
  let N2 := seq_len(l2)
  have n1: N1 in omega by arith(h1)
  have n2: N2 in omega by arith(h2)
  have g: int_lt(N1, N2) -> false proof
    assume lt
    have c0: N1 = 0 -> false proof
      assume e0
      have hz := trans(f1, mp(ite_t[c := N1 = 0, a := 0, b := l1[0]], e0))
      have hl := trans(f2, mp(ite_f[c := N2 = 0, a := 0, b := l2[0]], (!(N2 = 0) by arith(lt, e0, n2))))
      have nz := mp(all_elim(z2, {0}), simp(), arith(lt, e0))
      show by simp(hz, hl, nz)
    qed
    have cn: !(N1 = 0) -> false proof
      assume ne
      let j := int_sub(N1, 1)
      have jo: j in omega by arith(n1, ne)
      have jl1: int_lt(j, N1) by arith(n1, ne)
      have jl2: int_lt(j, N2) by arith(n1, ne, lt)
      have x1 := mp(all_elim(k1, {j}), jo, jl1)
      have x2 := mp(all_elim(k2, {j}), jo, jl2)
      have ej := mp(all_elim(pre, {j}), jo, jl1, jl2)
      have t1 := mp(ite_f[c := int_lt(int_add(j, 1), N1), a := l1[int_add(j, 1)], b := 0], (!int_lt(int_add(j, 1), N1) by arith(n1, ne)))
      have t2 := mp(ite_t[c := int_lt(int_add(j, 1), N2), a := l2[int_add(j, 1)], b := 0], (int_lt(int_add(j, 1), N2) by arith(n1, ne, lt)))
      have e1: int_add(j, 1) = N1 by arith(n1, ne)
      have nz := mp(all_elim(z2, {N1}), n1, lt)
      show by simp(x1, x2, ej, t1, t2, e1, nz)
    qed
    show by taut(c0, cn)
  qed
  show by taut(g)
qed

theorem mp.u_chain(M, h, l1, l2): l1 in list_type(omega) -> l2 in list_type(omega) ->
  (all i. i in omega -> int_lt(i, seq_len(l1)) -> !(l1[i] = 0)) -> (all i. i in omega -> int_lt(i, seq_len(l2)) -> !(l2[i] = 0)) ->
  mp.chain(M, h, l1) -> mp.chain(M, h, l2) -> l1 = l2
proof
  assume h1 h2 z1 z2 c1 c2
  have s12 := apply(mp.u_chain_short[M := M, h := h, l1 := l1, l2 := l2], h1, h2, z2, c1, c2)
  have s21 := apply(mp.u_chain_short[M := M, h := h, l1 := l2, l2 := l1], h2, h1, z1, c2, c1)
  have n1: seq_len(l1) in omega by arith(h1)
  have n2: seq_len(l2) in omega by arith(h2)
  have le: seq_len(l1) = seq_len(l2) by arith(s12, s21, n1, n2)
  have pre := apply(mp.u_chain_pre[M := M, h := h, l1 := l1, l2 := l2], h1, h2, c1, c2)
  have el: all i. i in omega -> int_lt(i, seq_len(l1)) -> l1[i] = l2[i] proof
    fix i
    assume hi hl
    show := mp(all_elim(pre, {i}), hi, hl, (int_lt(i, seq_len(l2)) by arith(hl, le)))
  qed
  show := mp(ext_example[a := l1, b := l2, t := omega], h1, h2, le, el)
qed

// a state's meta areas: linked from the context's head word in the whole
// memory's view (their headers the invariant's), nonzero
theorem mp.u_areas_of(c, A, vm, b): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_m(c, A, vm, b) ->
  seq_len(A.taken) = 0 ->
  mp.chain(mallocng.mview(vm, mallocng.all_bytes), mallocng.ctx_word(c, mallocng.mview(vm, mallocng.held(c, A, b)), mallocng.C_AREA_HEAD), A.areas) &&
  (all i. i in omega -> int_lt(i, seq_len(A.areas)) -> !(A.areas[i] = 0))
proof
  assume hc hu ha hh ht
  let M := mallocng.mview(vm, mallocng.held(c, A, b))
  have {H = inv} := expand(hh, mallocng.holds_m)
  have {aok = areas, huo = used, ff = fixed, hga = apart} := expand(H, mallocng.holds)
  have {hd = head, each = each} := expand(aok, mallocng.areas_ok)
  have {fa = areas} := expand(ff, mallocng.fixed_free)
  have alt: A.areas in list_type(omega) by simp(ha)
  have nt: all a. !mallocng.in_taken(A, a) proof
    fix a
    have g: mallocng.in_taken(A, a) -> false proof
      assume h
      obtain k, hko hkl _ _ from expand(h, mallocng.in_taken)
      show by arith(hko, hkl, ht)
    qed
    show by taut(g)
  qed
  have lk: all k. k in omega -> int_lt(k, seq_len(A.areas)) ->
      mallocng.rd(mallocng.mview(vm, mallocng.all_bytes), int_add(A.areas[k], 8), 8) = ite(int_lt(int_add(k, 1), seq_len(A.areas)), A.areas[int_add(k, 1)], 0) proof
    fix k
    assume hk hkl
    have ak := mp(at_type[l := A.areas, t := omega, i := k], alt, hk, hkl)
    have _ _ _ e8 _ _ := mp(all_elim(each, {k}), hk, hkl)
    have inF: all j. j in omega -> int_lt(j, 8) -> int_add(int_add(A.areas[k], 8), j) in mallocng.held(c, A, b) proof
      fix j
      assume hj hjl
      let a := int_add(int_add(A.areas[k], 8), j)
      have hao: a in omega by arith(ak, hj)
      have nl := mp(all_elim(fa, {k}, {a}), conj(hk, hao), (int_lt(k, seq_len(A.areas)) && int_le(A.areas[k], a) && int_lt(a, int_add(A.areas[k], 4096))
        by arith(hkl, ak, hj, hjl)))
      have fp := apply(mp.area_fp[c := c, A := A, M := M, b := b, k := k, a := a], hc, hu, ha, huo, hga, hk, hkl, hao,
        arith(ak, hj), arith(ak, hj, hjl), nl, all_elim(nt, {a}))
      show := apply(mp.area_held[c := c, A := A, M := M, b := b, brk := vm.brk, k := k, a := a], hc, hu, ha, H, hk, hkl, hao,
        arith(ak, hj), arith(ak, hj, hjl), fp)
    qed
    have inA: all j. j in omega -> int_lt(j, 8) -> int_add(int_add(A.areas[k], 8), j) in mallocng.all_bytes proof
      fix j
      assume hj hjl
      show := mp(mp.u_all[a := int_add(int_add(A.areas[k], 8), j)], arith(ak, hj))
    qed
    have r := mp(mp.u_rd2[vm := vm, F := mallocng.held(c, A, b), G := mallocng.all_bytes, a := int_add(A.areas[k], 8), n := 8], arith(ak), simp(), simp(), inF, inA)
    show := trans(sym(r), e8)
  qed
  have hd2: mallocng.ctx_word(c, M, mallocng.C_AREA_HEAD) = ite(seq_len(A.areas) = 0, 0, A.areas[0]) by simp(hd)
  have nz: all i. i in omega -> int_lt(i, seq_len(A.areas)) -> !(A.areas[i] = 0) proof
    fix i
    assume hi hil
    have _ p _ _ _ _ := mp(all_elim(each, {i}), hi, hil)
    have ai := mp(at_type[l := A.areas, t := omega, i := i], alt, hi, hil)
    show by arith(p, ai)
  qed
  show by taut(hd2, lk, nz)
qed

theorem mp.u_areas(c, A, B, vm, b): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> B in univ(1) -> B in mallocng.Abs ->
  mallocng.holds_m(c, A, vm, b) -> mallocng.holds_m(c, B, vm, b) -> seq_len(A.taken) = 0 -> seq_len(B.taken) = 0 ->
  A.areas = B.areas
proof
  assume hc hua ha hub hb hha hhb hta htb
  have ks: mallocng.C_AREA_HEAD = 56 && mallocng.CTX_SIZE = 928 by defs(simp(), mallocng.C_AREA_HEAD, mallocng.CTX_SIZE)
  have ew := apply(mp.u_ctx2[c := c, A := A, B := B, vm := vm, b := b, off := mallocng.C_AREA_HEAD, n := 8], hc, hua, ha, hub, hb, hha, hhb, simp(ks), simp(),
    simp(ks), apply(mp.u_nofree[c := c, off := mallocng.C_AREA_HEAD, n := 8], hc, simp(ks), simp(), simp(ks)))
  have hw: mallocng.ctx_word(c, mallocng.mview(vm, mallocng.held(c, A, b)), mallocng.C_AREA_HEAD) =
      mallocng.ctx_word(c, mallocng.mview(vm, mallocng.held(c, B, b)), mallocng.C_AREA_HEAD) by defs(ew, mallocng.ctx_word)
  have ca1 ca2 za := apply(mp.u_areas_of[c := c, A := A, vm := vm, b := b], hc, hua, ha, hha, hta)
  have cb1 cb2 zb := apply(mp.u_areas_of[c := c, A := B, vm := vm, b := b], hc, hub, hb, hhb, htb)
  have la: A.areas in list_type(omega) by simp(ha)
  have lb: B.areas in list_type(omega) by simp(hb)
  show := apply(mp.u_chain, la, lb, za, zb, rewrite(hw, conj(ca1, ca2)), conj(cb1, cb2))
qed

// ----------------------------------------------------------------------
//  The auxiliary vector (while not initialized): read from libc's word,
//  its entries up to the first AT_NULL

// (two pairs of naturals with the same parts: equal)
theorem mp.u_pair_eq(u, v): u in cart(omega, omega) -> v in cart(omega, omega) -> fst(u) = fst(v) -> snd(u) = snd(v) -> u = v
proof
  assume hu hv hf hs
  obtain x y, _ _ eu from mp(cart_elim[a := omega, b := omega, z := u], hu)
  obtain x2 y2, _ _ ev from mp(cart_elim[a := omega, b := omega, z := v], hv)
  show by simp(eu, ev, rewrite(eu, rewrite(ev, hf)), rewrite(eu, rewrite(ev, hs)))
qed

// (the vector's bytes: in its range)
theorem mp.u_auxv_in(A, a): A in univ(1) -> A in mallocng.Abs -> a in omega -> int_le(A.auxv_at, a) -> int_lt(a, int_add(A.auxv_at, int_mul(16, seq_len(A.auxv)))) ->
  mallocng.in_ranges(a, mallocng.auxv_ranges(A))
proof
  assume hu ha hao h1 h2
  have al: A.auxv in list_type(cart(omega, omega)) by simp(ha)
  let P0 := pair(A.auxv_at, int_mul(16, seq_len(A.auxv)))
  let B := fn_build(int_sub(seq_len(A.auxv), 0), x0. ite(fst(A.auxv[int_add(0, x0)]) = x86_64_linux.AT_RANDOM, pair(int_add(snd(A.auxv[int_add(0, x0)]), 8), 8), pair(0, 0)))
  have ad: int_sub(seq_len(A.auxv), 0) in omega by arith(al)
  have av: all x0. x0 in int_sub(seq_len(A.auxv), 0) -> ite(fst(A.auxv[int_add(0, x0)]) = x86_64_linux.AT_RANDOM, pair(int_add(snd(A.auxv[int_add(0, x0)]), 8), 8), pair(0, 0)) in univ(1) proof
    fix x0
    assume hx
    show by simp(hu)
  qed
  have a1 := apply(tr.seq_one_type, (P0 in univ(1) by simp(hu)))
  have bl := apply(build_list, ad, av)
  have e0 := at({seq_concat(seq_one(P0), B)[0]}, a1, bl, (0 in omega by simp()), (int_lt(0, seq_len(seq_one(P0))) by simp()))
  have r0e: mallocng.auxv_ranges(A)[0] = P0 by defs(simp(e0), mallocng.auxv_ranges)
  have l0: int_lt(0, seq_len(mallocng.auxv_ranges(A))) by defs(arith(a1, bl), mallocng.auxv_ranges)
  have r0: mallocng.in_range(a, mallocng.auxv_ranges(A)[0]) by defs(simp(r0e, h1, h2), mallocng.in_range)
  have z0: 0 in omega by simp()
  show by defs(ex_intro({0}, taut(z0, l0, r0)), mallocng.in_ranges)
qed

theorem mp.u_auxv(c, A, B, vm, b): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> B in univ(1) -> B in mallocng.Abs ->
  mallocng.holds_m(c, A, vm, b) -> mallocng.holds_m(c, B, vm, b) -> mallocng.no_reserved(A) -> mallocng.no_reserved(B) ->
  seq_len(A.taken) = 0 -> seq_len(B.taken) = 0 -> A.init_done = B.init_done ->
  A.auxv_at = B.auxv_at && A.auxv = B.auxv
proof
  assume hc hua ha hub hb hha hhb hra hrb hta htb hin
  have {HA = inv} := expand(hha, mallocng.holds_m)
  have {HB = inv} := expand(hhb, mallocng.holds_m)
  have {frA = fresh, nA = normal} := expand(HA, mallocng.holds)
  have {frB = fresh, nB = normal} := expand(HB, mallocng.holds)
  have {iA = init} := expand(nA, mallocng.normal)
  have {iB = init} := expand(nB, mallocng.normal)
  have la: A.auxv in list_type(cart(omega, omega)) by simp(ha)
  have lb: B.auxv in list_type(cart(omega, omega)) by simp(hb)
  have ao: A.init_done in omega by simp(hua, ha)
  // initialized: both empty
  have done: !(A.init_done = 0) -> A.auxv_at = B.auxv_at && A.auxv = B.auxv proof
    assume ne
    have a0 x0 := mp(iA, ne)
    have b0 y0 := mp(iB, (!(B.init_done = 0) by simp(ne, hin)))
    have el: all i. i in omega -> int_lt(i, seq_len(A.auxv)) -> A.auxv[i] = B.auxv[i] proof
      fix i
      assume hi hil
      show by arith(hil, a0, hi)
    qed
    have eq := mp(ext_example[a := A.auxv, b := B.auxv, t := cart(omega, omega)], la, lb, simp(a0, b0), el)
    show by simp(x0, y0, eq)
  qed
  // not yet: read from memory
  have fresh: A.init_done = 0 -> A.auxv_at = B.auxv_at && A.auxv = B.auxv proof
    assume z
    have {xA = auxv_at, nzA = auxv_nz, lnA = auxv_len, eA = auxv, endA = auxv_end, nlA = auxv_null} := mp(expand(frA, mallocng.fresh_ok), z)
    have {xB = auxv_at, nzB = auxv_nz, lnB = auxv_len, eB = auxv, endB = auxv_end, nlB = auxv_null} := mp(expand(frB, mallocng.fresh_ok), (B.init_done = 0 by simp(z, hin)))
    // libc's word
    have _ _ d2 := mp.data_at[c := c]
    have cl: c.libc in omega by simp(hc)
    have kl: mallocng.L_AUXV = 8 by defs(simp(), mallocng.L_AUXV)
    have dl: seq_len(mallocng.data_ranges(c)) = 3 by defs(arith(), mallocng.data_ranges)
    have ww: all i. i in omega -> int_lt(i, 8) -> int_add(int_add(c.libc, mallocng.L_AUXV), i) in omega &&
        mallocng.in_ranges(int_add(int_add(c.libc, mallocng.L_AUXV), i), mallocng.fp_ranges(c, A)) &&
        mallocng.in_ranges(int_add(int_add(c.libc, mallocng.L_AUXV), i), mallocng.fp_ranges(c, B)) proof
      fix i
      assume hi hil
      let a := int_add(int_add(c.libc, mallocng.L_AUXV), i)
      have hao: a in omega by arith(cl, kl, hi)
      have r: mallocng.in_range(a, mallocng.data_ranges(c)[2]) by defs(simp(d2, (int_lt(a, int_add(c.libc, 16)) by arith(cl, kl, hi, hil)), (int_le(c.libc, a) by arith(cl, kl, hi))), mallocng.in_range)
      have t2: 2 in omega by simp()
      have ir: mallocng.in_ranges(a, mallocng.data_ranges(c)) by defs(ex_intro({2}, taut(t2, (int_lt(2, seq_len(mallocng.data_ranges(c))) by arith(dl)), r)), mallocng.in_ranges)
      have fa := apply(mp.u_front_fp[c := c, A := A, a := a], hc, hua, ha, taut(ir))
      have fb := apply(mp.u_front_fp[c := c, A := B, a := a], hc, hub, hb, taut(ir))
      show by taut(hao, fa, fb)
    qed
    have rw := apply(mp.u_rd_same[c := c, A := A, B := B, vm := vm, b := b, a := int_add(c.libc, mallocng.L_AUXV), n := 8], hra, hrb, hta, htb, simp(), ww)
    have at: A.auxv_at = B.auxv_at by simp(xA, xB, rw)
    // the entries: the common prefix
    have ato: A.auxv_at in omega by simp(ha)
    let NA := seq_len(A.auxv)
    let NB := seq_len(B.auxv)
    have na: NA in omega by arith(la)
    have nb: NB in omega by arith(lb)
    have lA: int_le(1, NA) by arith(expand(lnA, ord_le), na)
    have lB: int_le(1, NB) by arith(expand(lnB, ord_le), nb)
    // (entry k's bytes in both states' ranges)
    have eb: all k j. k in omega -> int_lt(k, NA) -> int_lt(k, NB) -> j in omega -> int_lt(j, 16) ->
        int_add(int_add(A.auxv_at, int_mul(16, k)), j) in omega &&
        mallocng.in_ranges(int_add(int_add(A.auxv_at, int_mul(16, k)), j), mallocng.fp_ranges(c, A)) &&
        mallocng.in_ranges(int_add(int_add(A.auxv_at, int_mul(16, k)), j), mallocng.fp_ranges(c, B)) proof
      fix k j
      assume hk hka hkb hj hjl
      let a := int_add(int_add(A.auxv_at, int_mul(16, k)), j)
      have hao: a in omega by arith(ato, hk, hj)
      have ia := apply(mp.u_auxv_in[A := A, a := a], hua, ha, hao, arith(ato, hk, hj), arith(ato, hk, hj, hjl, hka))
      have ib := apply(mp.u_auxv_in[A := B, a := a], hub, hb, hao, arith(at, ato, hk, hj), arith(at, ato, hk, hj, hjl, hkb))
      have fa := apply(mp.u_front_fp[c := c, A := A, a := a], hc, hua, ha, taut(ia))
      have fb := apply(mp.u_front_fp[c := c, A := B, a := a], hc, hub, hb, taut(ib))
      show by taut(hao, fa, fb)
    qed
    have ent: all k. k in omega -> int_lt(k, NA) -> int_lt(k, NB) -> A.auxv[k] = B.auxv[k] proof
      fix k
      assume hk hka hkb
      have w0: all j. j in omega -> int_lt(j, 8) -> int_add(int_add(A.auxv_at, int_mul(16, k)), j) in omega &&
          mallocng.in_ranges(int_add(int_add(A.auxv_at, int_mul(16, k)), j), mallocng.fp_ranges(c, A)) &&
          mallocng.in_ranges(int_add(int_add(A.auxv_at, int_mul(16, k)), j), mallocng.fp_ranges(c, B)) proof
        fix j
        assume hj hjl
        show := mp(all_elim(eb, {k}, {j}), hk, hka, hkb, hj, arith(hjl))
      qed
      have w8: all j. j in omega -> int_lt(j, 8) -> int_add(int_add(int_add(A.auxv_at, int_mul(16, k)), 8), j) in omega &&
          mallocng.in_ranges(int_add(int_add(int_add(A.auxv_at, int_mul(16, k)), 8), j), mallocng.fp_ranges(c, A)) &&
          mallocng.in_ranges(int_add(int_add(int_add(A.auxv_at, int_mul(16, k)), 8), j), mallocng.fp_ranges(c, B)) proof
        fix j
        assume hj hjl
        have e: int_add(int_add(int_add(A.auxv_at, int_mul(16, k)), 8), j) = int_add(int_add(A.auxv_at, int_mul(16, k)), int_add(8, j)) by arith(ato, hk, hj)
        show := rewrite(sym(e), mp(all_elim(eb, {k}, {int_add(8, j)}), hk, hka, hkb, arith(hj), arith(hj, hjl)))
      qed
      have r0 := apply(mp.u_rd_same[c := c, A := A, B := B, vm := vm, b := b, a := int_add(A.auxv_at, int_mul(16, k)), n := 8], hra, hrb, hta, htb, simp(), w0)
      have r8 := apply(mp.u_rd_same[c := c, A := A, B := B, vm := vm, b := b, a := int_add(int_add(A.auxv_at, int_mul(16, k)), 8), n := 8], hra, hrb, hta, htb, simp(), w8)
      have xa ya := mp(all_elim(eA, {k}), hk, hka)
      have xb yb := mp(all_elim(eB, {k}), hk, hkb)
      have f: fst(A.auxv[k]) = fst(B.auxv[k]) by simp(xa, xb, r0, at)
      have s: snd(A.auxv[k]) = snd(B.auxv[k]) by simp(ya, yb, r8, at)
      show := apply(mp.u_pair_eq, mp(at_type[l := A.auxv, t := cart(omega, omega), i := k], la, hk, hka),
        mp(at_type[l := B.auxv, t := cart(omega, omega), i := k], lb, hk, hkb), f, s)
    qed
    // the lengths: a shorter one's last entry AT_NULL, not the longer's
    have short: all l1 l2. (l1 = A.auxv && l2 = B.auxv) || (l1 = B.auxv && l2 = A.auxv) -> !int_lt(seq_len(l1), seq_len(l2)) proof
      fix l1 l2
      assume which
      have g: int_lt(seq_len(l1), seq_len(l2)) -> false proof
        assume lt
        have case1: l1 = A.auxv -> l2 = B.auxv -> false proof
          assume e1 e2
          let j := int_sub(NA, 1)
          have jo: j in omega by arith(lA,na)
          have lt2: int_lt(NA, NB) by simp(lt, e1, e2)
          have ej := mp(all_elim(ent, {j}), jo, arith(lA,na), arith(lA,na, lt2))
          have nn := mp(all_elim(nlB, {j}), jo, (int_lt(int_add(j, 1), NB) by arith(lA,na, lt2)))
          show by simp(endA, ej, nn)
        qed
        have case2: l1 = B.auxv -> l2 = A.auxv -> false proof
          assume e1 e2
          let j := int_sub(NB, 1)
          have jo: j in omega by arith(lB,nb)
          have lt2: int_lt(NB, NA) by simp(lt, e1, e2)
          have ej := mp(all_elim(ent, {j}), jo, arith(lB,nb, lt2), arith(lB,nb))
          have nn := mp(all_elim(nlA, {j}), jo, (int_lt(int_add(j, 1), NA) by arith(lB,nb, lt2)))
          show by simp(endB, ej, nn)
        qed
        show by taut(which, case1, case2)
      qed
      show by taut(g)
    qed
    have s1 := mp(all_elim(short, {A.auxv}, {B.auxv}), taut(refl({A.auxv}), refl({B.auxv})))
    have s2 := mp(all_elim(short, {B.auxv}, {A.auxv}), taut(refl({A.auxv}), refl({B.auxv})))
    have le: NA = NB by arith(s1, s2, na, nb)
    have el: all i. i in omega -> int_lt(i, NA) -> A.auxv[i] = B.auxv[i] proof
      fix i
      assume hi hil
      show := mp(all_elim(ent, {i}), hi, hil, arith(hil, le))
    qed
    have eq := mp(ext_example[a := A.auxv, b := B.auxv, t := cart(omega, omega)], la, lb, le, el)
    show by taut(at, eq)
  qed
  show by taut(done, fresh)
qed

// ----------------------------------------------------------------------
//  Two ascending lists of the same members: equal (the used metas)

abbrev mp.asc(l) := all k. k in omega -> int_lt(int_add(k, 1), seq_len(l)) -> int_lt(l[k], l[int_add(k, 1)])
abbrev mp.mem(l, x) := ex k. k in omega && (int_lt(k, seq_len(l)) && l[k] = x)

// (below an index or at it: no greater)
theorem mp.u_asc_le(l, i, j): l in list_type(omega) -> mp.asc(l) -> i in omega -> j in omega -> int_le(j, i) -> int_lt(i, seq_len(l)) ->
  int_le(l[j], l[i])
proof
  assume hl hs hi hj hji hil
  have lt: int_lt(j, i) -> int_le(l[j], l[i]) proof
    assume h
    have r := apply(mp.asc_lt[l := l, i := j, j := i], hl, hs, hj, hi, h, hil)
    show by arith(r)
  qed
  have eq: j = i -> int_le(l[j], l[i]) proof
    assume h
    have li := mp(at_type[l := l, t := omega, i := i], hl, hi, hil)
    show by simp(h, (int_le(l[i], l[i]) by arith(li)))
  qed
  have d: int_lt(j, i) || j = i by arith(hji, hi, hj)
  show by taut(d, lt, eq)
qed

// (a member of l2 above l2[i]: at l2[i + 1] or above)
theorem mp.u_asc_next(l, i, x): l in list_type(omega) -> mp.asc(l) -> i in omega -> int_lt(int_add(i, 1), seq_len(l)) ->
  mp.mem(l, x) -> int_lt(l[i], x) -> int_le(l[int_add(i, 1)], x)
proof
  assume hl hs hi hil hm hx
  obtain j, hj hjl he from hm
  have ge: int_le(int_add(i, 1), j) proof
    have g: int_le(j, i) -> false proof
      assume h
      have le := apply(mp.u_asc_le[l := l, i := i, j := j], hl, hs, hi, hj, h, arith(hil, hi))
      show by arith(le, he, hx)
    qed
    show by arith(g, hj, hi)
  qed
  have le := apply(mp.u_asc_le[l := l, i := j, j := int_add(i, 1)], hl, hs, hj, arith(hi), ge, hjl)
  show by simp(le, he)
qed

theorem mp.u_sorted(l1, l2): l1 in list_type(omega) -> l2 in list_type(omega) -> mp.asc(l1) -> mp.asc(l2) ->
  (all x. mp.mem(l1, x) <-> mp.mem(l2, x)) -> l1 = l2
proof
  assume h1 h2 s1 s2 hm
  let N1 := seq_len(l1)
  let N2 := seq_len(l2)
  have n1: N1 in omega by arith(h1)
  have n2: N2 in omega by arith(h2)
  // (each list's element at an index: a member of the other)
  have m1: all i. i in omega -> int_lt(i, N1) -> mp.mem(l2, l1[i]) proof
    fix i
    assume hi hil
    have m: mp.mem(l1, l1[i]) by ex_intro({i}, taut(hi, hil, refl({l1[i]})))
    show by taut(all_elim(hm, {l1[i]}), m)
  qed
  have m2: all i. i in omega -> int_lt(i, N2) -> mp.mem(l1, l2[i]) proof
    fix i
    assume hi hil
    have m: mp.mem(l2, l2[i]) by ex_intro({i}, taut(hi, hil, refl({l2[i]})))
    show by taut(all_elim(hm, {l2[i]}), m)
  qed
  // (a member: at the first element or above)
  have low: all l x. l in list_type(omega) -> mp.asc(l) -> int_lt(0, seq_len(l)) -> mp.mem(l, x) -> int_le(l[0], x) proof
    fix l x
    assume hl hs hp hmx
    obtain j, hj hjl he from hmx
    have le := apply(mp.u_asc_le[l := l, i := j, j := 0], hl, hs, hj, simp(), arith(hj), hjl)
    show by simp(le, he)
  qed
  let P(i) := int_lt(i, N1) -> int_lt(i, N2) -> l1[i] = l2[i]
  have base: P(0) proof
    assume a b
    have x := mp(all_elim(low, {l2}, {l1[0]}), h2, s2, b, mp(all_elim(m1, {0}), simp(), a))
    have y := mp(all_elim(low, {l1}, {l2[0]}), h1, s1, a, mp(all_elim(m2, {0}), simp(), b))
    have t1 := mp(at_type[l := l1, t := omega, i := 0], h1, simp(), a)
    have t2 := mp(at_type[l := l2, t := omega, i := 0], h2, simp(), b)
    show by arith(x, y, t1, t2)
  qed
  have step: all i. i in omega -> P(i) -> P(int_add(i, 1)) proof
    fix i
    assume hi ih
    assume a b
    have e := mp(ih, arith(a, hi), arith(b, hi))
    have ia := mp(at_type[l := l1, t := omega, i := int_add(i, 1)], h1, arith(hi), a)
    have ib := mp(at_type[l := l2, t := omega, i := int_add(i, 1)], h2, arith(hi), b)
    // l1[i+1] above l1[i] = l2[i]: at l2[i+1] or above; and back
    have u1 := apply(mp.asc_lt[l := l1, i := i, j := int_add(i, 1)], h1, s1, hi, arith(hi), arith(hi), a)
    have u2 := apply(mp.asc_lt[l := l2, i := i, j := int_add(i, 1)], h2, s2, hi, arith(hi), arith(hi), b)
    have x := apply(mp.u_asc_next[l := l2, i := i, x := l1[int_add(i, 1)]], h2, s2, hi, b, mp(all_elim(m1, {int_add(i, 1)}), arith(hi), a), rewrite(e, u1))
    have y := apply(mp.u_asc_next[l := l1, i := i, x := l2[int_add(i, 1)]], h1, s1, hi, a, mp(all_elim(m2, {int_add(i, 1)}), arith(hi), b), rewrite(sym(e), u2))
    show by arith(x, y, ia, ib)
  qed
  have pre: all i. i in omega -> P(i) by induct(base, step)
  // the lengths: the shorter's members all of the longer's first ones --
  // the longer's next one is none of them
  have short: all la lb. (la = l1 && lb = l2) || (la = l2 && lb = l1) -> !int_lt(seq_len(la), seq_len(lb)) proof
    fix la lb
    assume w
    have g: int_lt(seq_len(la), seq_len(lb)) -> false proof
      assume lt
      have k: all xa xb. xa in list_type(omega) -> xb in list_type(omega) -> mp.asc(xb) ->
          (all i. i in omega -> int_lt(i, seq_len(xb)) -> mp.mem(xa, xb[i])) ->
          (all i. i in omega -> int_lt(i, seq_len(xa)) -> int_lt(i, seq_len(xb)) -> xa[i] = xb[i]) ->
          int_lt(seq_len(xa), seq_len(xb)) -> false proof
        fix xa xb
        assume ha hb hsb hmb hp hlt
        let N := seq_len(xa)
        have no: N in omega by arith(ha)
        obtain j, hj hjl he from mp(all_elim(hmb, {N}), no, hlt)
        have ej := mp(all_elim(hp, {j}), hj, hjl, arith(hjl, hlt))
        have r := apply(mp.asc_lt[l := xb, i := j, j := N], hb, hsb, hj, no, hjl, hlt)
        show by simp(he, ej, r)
      qed
      have c1: la = l1 -> lb = l2 -> false proof
        assume e1 e2
        have pp: all i. i in omega -> int_lt(i, N1) -> int_lt(i, N2) -> l1[i] = l2[i] proof
          fix i
          assume hi ha1 hb2
          show := mp(all_elim(pre, {i}), hi, ha1, hb2)
        qed
        show := mp(all_elim(k, {l1}, {l2}), h1, h2, s2, m2, pp, (int_lt(N1, N2) by simp(lt, e1, e2)))
      qed
      have c2: la = l2 -> lb = l1 -> false proof
        assume e1 e2
        have pp: all i. i in omega -> int_lt(i, N2) -> int_lt(i, N1) -> l2[i] = l1[i] proof
          fix i
          assume hi hb2 ha1
          show := sym(mp(all_elim(pre, {i}), hi, ha1, hb2))
        qed
        show := mp(all_elim(k, {l2}, {l1}), h2, h1, s1, m1, pp, (int_lt(N2, N1) by simp(lt, e1, e2)))
      qed
      show by taut(w, c1, c2)
    qed
    show by taut(g)
  qed
  have q1 := mp(all_elim(short, {l1}, {l2}), taut(refl({l1}), refl({l2})))
  have q2 := mp(all_elim(short, {l2}, {l1}), taut(refl({l1}), refl({l2})))
  have le: N1 = N2 by arith(q1, q2, n1, n2)
  have el: all i. i in omega -> int_lt(i, N1) -> l1[i] = l2[i] proof
    fix i
    assume hi hil
    show := mp(all_elim(pre, {i}), hi, hil, arith(hil, le))
  qed
  show := mp(ext_example[a := l1, b := l2, t := omega], h1, h2, le, el)
qed

// a used meta, nothing taken: a meta slot neither free nor available
theorem mp.u_used_char(c, A, vm, b, g): A in mallocng.Abs -> mallocng.holds_m(c, A, vm, b) -> seq_len(A.taken) = 0 ->
  (mallocng.is_used(A, g) <-> mallocng.meta_slot(A, g) && !mp.mem(A.free_metas, g) && !mallocng.avail_meta(A, g))
proof
  assume ha hh ht
  have al: A.areas in list_type(omega) by simp(ha)
  have aln: seq_len(A.areas) in omega by arith(al)
  have {H = inv} := expand(hh, mallocng.holds_m)
  have {part = part} := expand(H, mallocng.holds)
  have {us = used_slots, fs = free_slots, cv = cover, fr = fresh} := expand(part, mallocng.metas_partition)
  have to: mallocng.is_used(A, g) -> mallocng.meta_slot(A, g) && !mp.mem(A.free_metas, g) && !mallocng.avail_meta(A, g) proof
    assume hu
    obtain k, hk hkl he from expand(hu, mallocng.is_used)
    have ms := rewrite(he, mp(all_elim(us, {k}), hk, hkl))
    have nf: mp.mem(A.free_metas, g) -> false proof
      assume hm
      obtain i, hi hil hie from hm
      have _ nu := mp(all_elim(fs, {i}), hi, hil)
      show by taut(rewrite(hie, nu), hu)
    qed
    have na: mallocng.avail_meta(A, g) -> false proof
      assume hav
      have pos ex := expand(hav, mallocng.avail_meta)
      obtain j, hj hjl hju hge from ex
      have nu _ := mp(all_elim(fr, {j}), hj, (ord_lt(0, seq_len(A.areas)) && int_le(int_sub(mallocng.NSLOTS, A.avail_cnt), j) && int_lt(j, mallocng.NSLOTS)
        by taut(pos, hjl, hju)))
      show by taut(rewrite(sym(hge), nu), hu)
    qed
    show by taut(ms, nf, na)
  qed
  have from: mallocng.meta_slot(A, g) -> !mp.mem(A.free_metas, g) -> !mallocng.avail_meta(A, g) -> mallocng.is_used(A, g) proof
    assume hms hnf hna
    obtain k j, hk hj hkl hjl he from expand(hms, mallocng.meta_slot)
    have c := mp(all_elim(cv, {k}, {j}), conj(hk, hj), conj(hkl, hjl))
    have nt: (ex i. i in omega && (int_lt(i, seq_len(A.taken)) && A.taken[i] = mallocng.meta_at(A.areas[k], j))) -> false proof
      assume h
      obtain i, hi hil _ from h
      show by arith(hi, hil, ht)
    qed
    have nf: (ex i. i in omega && (int_lt(i, seq_len(A.free_metas)) && A.free_metas[i] = mallocng.meta_at(A.areas[k], j))) -> false proof
      assume h
      show by taut(hnf, rewrite(sym(he), h))
    qed
    have na: mallocng.avail_meta(A, mallocng.meta_at(A.areas[k], j)) -> false proof
      assume h
      show by taut(hna, rewrite(sym(he), h))
    qed
    have u: mallocng.is_used(A, mallocng.meta_at(A.areas[k], j)) by taut(c, nt, nf, na)
    show := rewrite(sym(he), u)
  qed
  show by taut(to, from)
qed

theorem mp.u_used(c, A, B, vm, b): A in mallocng.Abs -> B in mallocng.Abs ->
  mallocng.holds_m(c, A, vm, b) -> mallocng.holds_m(c, B, vm, b) -> seq_len(A.taken) = 0 -> seq_len(B.taken) = 0 ->
  A.areas = B.areas -> A.free_metas = B.free_metas -> A.avail_cnt = B.avail_cnt -> A.used = B.used
proof
  assume ha hb hha hhb hta htb ea ef ev
  have {HA = inv} := expand(hha, mallocng.holds_m)
  have {HB = inv} := expand(hhb, mallocng.holds_m)
  have {pA = part} := expand(HA, mallocng.holds)
  have {pB = part} := expand(HB, mallocng.holds)
  have {sA = sorted} := expand(pA, mallocng.metas_partition)
  have {sB = sorted} := expand(pB, mallocng.metas_partition)
  have la: A.used in list_type(omega) by simp(ha)
  have lb: B.used in list_type(omega) by simp(hb)
  have same: all x. mp.mem(A.used, x) <-> mp.mem(B.used, x) proof
    fix x
    have ca := apply(mp.u_used_char[c := c, A := A, vm := vm, b := b, g := x], ha, hha, hta)
    have cb := apply(mp.u_used_char[c := c, A := B, vm := vm, b := b, g := x], hb, hhb, htb)
    have ms: mallocng.meta_slot(A, x) <-> mallocng.meta_slot(B, x) by defs(simp(ea), mallocng.meta_slot)
    have av: mallocng.avail_meta(A, x) <-> mallocng.avail_meta(B, x) by defs(simp(ea, ev), mallocng.avail_meta)
    have fm: mp.mem(A.free_metas, x) <-> mp.mem(B.free_metas, x) by simp(ef)
    have u: mallocng.is_used(A, x) <-> mallocng.is_used(B, x) by taut(ca, cb, ms, av, fm)
    show by defs(u, mallocng.is_used)
  qed
  show := apply(mp.u_sorted, la, lb, sA, sB, same)
qed

// ----------------------------------------------------------------------
//  The used metas' fields: read from their bytes

// (two metas' values with the same fields: equal)
theorem mp.u_metav_eq(v, w): v in mallocng.MetaV -> w in mallocng.MetaV ->
  v.prev = w.prev -> v.next = w.next -> v.mem = w.mem -> v.avail = w.avail -> v.freed = w.freed ->
  v.last_idx = w.last_idx -> v.freeable = w.freeable -> v.sizeclass = w.sizeclass -> v.maplen = w.maplen -> v = w
proof
  assume hv hw e1 e2 e3 e4 e5 e6 e7 e8 e9
  let K := insert("prev", insert("next", insert("mem", insert("avail", insert("freed", insert("last_idx", insert("freeable", insert("sizeclass", insert("maplen", empty)))))))))
  have fv: is_fun(v) && dom(v) = K by simp(expand(hv, mallocng.MetaV))
  have fw: is_fun(w) && dom(w) = K by simp(expand(hw, mallocng.MetaV))
  have ek: all k. k in dom(v) -> v[k] = w[k] proof
    fix k
    assume hk
    have dv: dom(v) = K by taut(fv)
    have kk := rewrite(dv, hk)
    show by simp(kk, e1, e2, e3, e4, e5, e6, e7, e8, e9)
  qed
  show := mp(rec_ext[a := v, b := w], taut(fv), taut(fw), (dom(v) = dom(w) by simp(fv, fw)), ek)
qed

// (a meta used in both states: its n bytes at off read the same)
theorem mp.u_rd_meta(c, A, B, vm, b, g, off, n): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> B in univ(1) -> B in mallocng.Abs ->
  mallocng.holds_m(c, A, vm, b) -> mallocng.holds_m(c, B, vm, b) -> seq_len(A.taken) = 0 -> seq_len(B.taken) = 0 ->
  mallocng.is_used(A, g) -> mallocng.is_used(B, g) -> off in omega -> n in omega -> int_le(int_add(off, n), 40) ->
  mallocng.rd(mallocng.mview(vm, mallocng.held(c, A, b)), int_add(g, off), n) = mallocng.rd(mallocng.mview(vm, mallocng.held(c, B, b)), int_add(g, off), n)
proof
  assume hc hua ha hub hb hha hhb hta htb uA uB ho hn hle
  have {HA = inv} := expand(hha, mallocng.holds_m)
  have {HB = inv} := expand(hhb, mallocng.holds_m)
  have ntA: mp.untaken(A, g) proof
    fix i
    assume hi hil
    show by arith(hi, hil, hta)
  qed
  have ntB: mp.untaken(B, g) proof
    fix i
    assume hi hil
    show by arith(hi, hil, htb)
  qed
  have {gA = nat, aA = acc} := apply(mp.slot_meta[c := c, A := A, vm := vm, b := b, g := g], hc, hua, ha, hha, apply(mp.used_slot[g := g], HA, uA), ntA)
  have {aB = acc} := apply(mp.slot_meta[c := c, A := B, vm := vm, b := b, g := g], hc, hub, hb, hhb, apply(mp.used_slot[g := g], HB, uB), ntB)
  have fa: all i. i in omega -> int_lt(i, n) -> int_add(int_add(g, off), i) in mallocng.held(c, A, b) proof
    fix i
    assume hi hil
    have r := mp(all_elim(aA, {int_add(int_add(g, off), i)}), arith(gA, ho, hi), arith(gA, ho, hi), arith(gA, ho, hi, hil, hle))
    show by taut(r)
  qed
  have fb: all i. i in omega -> int_lt(i, n) -> int_add(int_add(g, off), i) in mallocng.held(c, B, b) proof
    fix i
    assume hi hil
    have r := mp(all_elim(aB, {int_add(int_add(g, off), i)}), arith(gA, ho, hi), arith(gA, ho, hi), arith(gA, ho, hi, hil, hle))
    show by taut(r)
  qed
  show := mp(mp.u_rd2[vm := vm, F := mallocng.held(c, A, b), G := mallocng.held(c, B, b), a := int_add(g, off), n := n], arith(gA, ho), hn, arith(hn, hle), fa, fb)
qed

theorem mp.u_meta(c, A, B, vm, b, g): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> B in univ(1) -> B in mallocng.Abs ->
  mallocng.holds_m(c, A, vm, b) -> mallocng.holds_m(c, B, vm, b) -> seq_len(A.taken) = 0 -> seq_len(B.taken) = 0 ->
  mallocng.is_used(A, g) -> mallocng.is_used(B, g) -> A.metas[g] = B.metas[g]
proof
  assume hc hua ha hub hb hha hhb hta htb uA uB
  have {HA = inv} := expand(hha, mallocng.holds_m)
  have {HB = inv} := expand(hhb, mallocng.holds_m)
  have {oA = used} := expand(HA, mallocng.holds)
  have {oB = used} := expand(HB, mallocng.holds)
  have {mA = mim} := apply(mp.used_group[g := g], oA, uA)
  have {mB = mim} := apply(mp.used_group[g := g], oB, uB)
  have {pA = prev, nA = next, eA = mem, vA = avail, fA = freed, wA = word, lA = last, rA = freeable, sA = sclass} := expand(mA, mallocng.meta_in_memory)
  have {pB = prev, nB = next, eB = mem, vB = avail, fB = freed, wB = word, lB = last, rB = freeable, sB = sclass} := expand(mB, mallocng.meta_in_memory)
  have r0 := apply(mp.u_rd_meta[c := c, A := A, B := B, vm := vm, b := b, g := g, off := 0, n := 8], hc, hua, ha, hub, hb, hha, hhb, hta, htb, uA, uB, simp(), simp(), simp())
  have r8 := apply(mp.u_rd_meta[c := c, A := A, B := B, vm := vm, b := b, g := g, off := 8, n := 8], hc, hua, ha, hub, hb, hha, hhb, hta, htb, uA, uB, simp(), simp(), simp())
  have r16 := apply(mp.u_rd_meta[c := c, A := A, B := B, vm := vm, b := b, g := g, off := 16, n := 8], hc, hua, ha, hub, hb, hha, hhb, hta, htb, uA, uB, simp(), simp(), simp())
  have r24 := apply(mp.u_rd_meta[c := c, A := A, B := B, vm := vm, b := b, g := g, off := 24, n := 4], hc, hua, ha, hub, hb, hha, hhb, hta, htb, uA, uB, simp(), simp(), simp())
  have r28 := apply(mp.u_rd_meta[c := c, A := A, B := B, vm := vm, b := b, g := g, off := 28, n := 4], hc, hua, ha, hub, hb, hha, hhb, hta, htb, uA, uB, simp(), simp(), simp())
  have r32 := apply(mp.u_rd_meta[c := c, A := A, B := B, vm := vm, b := b, g := g, off := 32, n := 8], hc, hua, ha, hub, hb, hha, hhb, hta, htb, uA, uB, simp(), simp(), simp())
  obtain k, hk hkl he from expand(uA, mallocng.is_used)
  have go := rewrite(he, mp(at_type[l := A.used, t := omega, i := k], (A.used in list_type(omega) by simp(ha)), hk, hkl))
  have z: int_add(g, 0) = g by arith(go)
  have prev: A.metas[g].prev = B.metas[g].prev by simp(pA, pB, rewrite(z, r0))
  have next: A.metas[g].next = B.metas[g].next by simp(nA, nB, r8)
  have mem: A.metas[g].mem = B.metas[g].mem by simp(eA, eB, r16)
  have avail: A.metas[g].avail = B.metas[g].avail by simp(vA, vB, r24)
  have freed: A.metas[g].freed = B.metas[g].freed by simp(fA, fB, r28)
  // the packed word: its parts by their bounds
  have mvA: A.metas[g] in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A.metas, x := g], simp(ha), go)
  have mvB: B.metas[g] in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := B.metas, x := g], simp(hb), go)
  have tA1 tA2 tA3 := (A.metas[g].last_idx in omega && A.metas[g].sizeclass in omega && A.metas[g].maplen in omega by simp(expand(mvA, mallocng.MetaV)))
  have tB1 tB2 tB3 := (B.metas[g].last_idx in omega && B.metas[g].sizeclass in omega && B.metas[g].maplen in omega by simp(expand(mvB, mallocng.MetaV)))
  have ww: int_add(int_add(int_add(A.metas[g].last_idx, int_mul(32, A.metas[g].freeable)), int_mul(64, A.metas[g].sizeclass)), int_mul(4096, A.metas[g].maplen)) =
      int_add(int_add(int_add(B.metas[g].last_idx, int_mul(32, B.metas[g].freeable)), int_mul(64, B.metas[g].sizeclass)), int_mul(4096, B.metas[g].maplen))
    by simp(wA, wB, r32)
  // (by 4096: maplen and the rest; the rest by 64: sizeclass and the rest)
  let VA := A.metas[g]
  let VB := B.metas[g]
  let W := int_add(int_add(int_add(VA.last_idx, int_mul(32, VA.freeable)), int_mul(64, VA.sizeclass)), int_mul(4096, VA.maplen))
  let RA := int_add(int_add(VA.last_idx, int_mul(32, VA.freeable)), int_mul(64, VA.sizeclass))
  let RB := int_add(int_add(VB.last_idx, int_mul(32, VB.freeable)), int_mul(64, VB.sizeclass))
  have qa ra := mp(mod_unique_int[x := W, m := 4096, q := VA.maplen, r := RA], arith(tA1, tA2, tA3), arith(tA1, tA2, tA3, lA, rA, sA), simp(), arith(tA1, tA2, tA3, lA, rA, sA),
    (W = int_add(int_mul(4096, VA.maplen), RA) by arith(tA1, tA2, tA3)))
  have qb rb := mp(mod_unique_int[x := W, m := 4096, q := VB.maplen, r := RB], arith(tB1, tB2, tB3), arith(tB1, tB2, tB3, lB, rB, sB), simp(), arith(tB1, tB2, tB3, lB, rB, sB),
    (W = int_add(int_mul(4096, VB.maplen), RB) by arith(ww, tB1, tB2, tB3)))
  have ml: VA.maplen = VB.maplen by simp(qa, qb)
  have rr: RA = RB by simp(ra, rb)
  have q2a r2a := mp(mod_unique_int[x := RA, m := 64, q := VA.sizeclass, r := int_add(VA.last_idx, 32)], arith(tA1, tA2, tA3), arith(tA1, tA2, tA3), simp(), arith(tA1, tA2, tA3, lA),
    (RA = int_add(int_mul(64, VA.sizeclass), int_add(VA.last_idx, 32)) by arith(rA, tA1, tA2, tA3)))
  have q2b r2b := mp(mod_unique_int[x := RA, m := 64, q := VB.sizeclass, r := int_add(VB.last_idx, 32)], arith(tB1, tB2, tB3), arith(tB1, tB2, tB3), simp(), arith(tB1, tB2, tB3, lB),
    (RA = int_add(int_mul(64, VB.sizeclass), int_add(VB.last_idx, 32)) by arith(rr, rB, tB1, tB2, tB3)))
  have sc: VA.sizeclass = VB.sizeclass by simp(q2a, q2b)
  have li: VA.last_idx = VB.last_idx by arith(r2a, r2b, tA1, tB1)
  have parts: VA.last_idx = VB.last_idx && VA.sizeclass = VB.sizeclass && VA.maplen = VB.maplen by taut(li, sc, ml)
  have fr: A.metas[g].freeable = B.metas[g].freeable by simp(rA, rB)
  show := apply(mp.u_metav_eq, mvA, mvB, prev, next, mem, avail, freed, taut(parts), fr, taut(parts), taut(parts))
qed

// ----------------------------------------------------------------------
//  The used groups' slots: read from their in-band headers

// (a byte of a used group: in the footprint's ranges)
theorem mp.u_group_fp(c, A, g, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.is_used(A, g) ->
  mallocng.in_range(a, mallocng.group_range(A.metas[g])) -> mallocng.in_ranges(a, mallocng.fp_ranges(c, A))
proof
  assume hc hu ha hg hr0
  obtain k, hk hkl he from expand(hg, mallocng.is_used)
  have hr := rewrite(sym(he), hr0)
  let USED := fn_build(int_sub(seq_len(A.used), 0), x0. mallocng.group_range(A.metas[A.used[int_add(0, x0)]]))
  have pre := apply(mp.pre_list, hc, hu, ha)
  have ul: A.used in list_type(omega) by simp(ha)
  have ud: int_sub(seq_len(A.used), 0) in omega by arith(ul)
  have uv: all x0. x0 in int_sub(seq_len(A.used), 0) -> mallocng.group_range(A.metas[A.used[int_add(0, x0)]]) in univ(1) proof
    fix x0
    assume hx
    show by defs(simp(hu), mallocng.group_range, mallocng.stride)
  qed
  have usl := apply(build_list, ud, uv)
  have kl2: int_lt(k, int_sub(seq_len(A.used), 0)) by arith(ul, hk, hkl)
  have dl: seq_len(USED) = int_sub(seq_len(A.used), 0)
    by defs(fn_build_dom[d := int_sub(seq_len(A.used), 0), v := x0. mallocng.group_range(A.metas[A.used[int_add(0, x0)]])], seq_len)
  have kin := mp(nat_lt_mem[k := k, n := int_sub(seq_len(A.used), 0)], hk, ud, kl2)
  have w: ex j. j in omega && (int_lt(j, seq_len(USED)) && mallocng.in_range(a, USED[j]))
    by ex_intro({k}, simp(hk, kin, kl2, hr, dl))
  have ir := mp(ex_at_concat_r[a := seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(mallocng.ro_ranges(c.file), mallocng.data_ranges(c)), mallocng.auxv_ranges(A)),
    fn_build(int_sub(seq_len(A.areas), 0), x0. pair(A.areas[int_add(0, x0)], 4096))),
    seq_one(pair(A.reserve, int_mul(4096, A.reserve_cnt)))), seq_one(pair(c.sct, int_mul(2, 48)))), seq_one(pair(c.dbj, 32))), b := USED, t := univ(1), p := r. mallocng.in_range(a, r)], pre, usl, w)
  show by defs(ir, mallocng.in_ranges, mallocng.fp_ranges, mallocng.fixed_ranges)
qed

// where a framed block (or nested group) starts, its size code below 7:
// from its slot's header -- moved (code 7) by the offset at start - 2,
// else at the slot's start
abbrev mp.fstart(m, v, i) := ite(int_div(mallocng.b8(m, int_sub(mallocng.slot_start(v, i), 3)), 32) = 7,
  int_add(mallocng.slot_start(v, i), int_mul(16, mallocng.rd(m, int_sub(mallocng.slot_start(v, i), 2), 2))), mallocng.slot_start(v, i))

theorem mp.u_frame_p(m, v, i, p, n, tag): mallocng.frame_ok(m, v, i, p, n, tag) -> p in omega -> mallocng.slot_start(v, i) in omega ->
  int_lt(int_div(mallocng.b8(m, int_sub(p, 3)), 32), 7) -> p = mp.fstart(m, v, i)
proof
  assume hf hp hs h7
  have {st = start, un = unit, mv = moved} := expand(hf, mallocng.frame_ok)
  let S := mallocng.slot_start(v, i)
  have ku: mallocng.UNIT = 16 by defs(simp(), mallocng.UNIT)
  have gt: int_lt(S, p) -> p = mp.fstart(m, v, i) proof
    assume h
    have r b := mp(mv, h)
    have c7: int_div(mallocng.b8(m, int_sub(S, 3)), 32) = 7 by simp(b)
    have t := mp(ite_t[c := int_div(mallocng.b8(m, int_sub(S, 3)), 32) = 7, a := int_add(S, int_mul(16, mallocng.rd(m, int_sub(S, 2), 2))), b := S], c7)
    have e: p = int_add(S, int_mul(16, mallocng.rd(m, int_sub(S, 2), 2))) by arith(r, un, ku, hp, hs, h)
    show := trans(e, sym(t))
  qed
  have eq: p = S -> p = mp.fstart(m, v, i) proof
    assume h
    have n7: !(int_div(mallocng.b8(m, int_sub(S, 3)), 32) = 7) by simp(rewrite(h, h7), (int_lt(7, 7) -> false by arith()))
    have f := mp(ite_f[c := int_div(mallocng.b8(m, int_sub(S, 3)), 32) = 7, a := int_add(S, int_mul(16, mallocng.rd(m, int_sub(S, 2), 2))), b := S], n7)
    show := trans(h, sym(f))
  qed
  show by taut((int_lt(S, p) || p = S by arith(st, hp, hs)), gt, eq)
qed

// (a block's size code: at most 5; a nested group's: 6)
theorem mp.u_code_blk(m, v, i, p, n): mallocng.frame_ok(m, v, i, p, n, 0) -> int_le(int_add(p, n), mallocng.slot_end(v, i)) ->
  p in omega -> n in omega -> mallocng.slot_end(v, i) in omega -> int_le(int_div(mallocng.b8(m, int_sub(p, 3)), 32), 5)
proof
  assume hf hfit hp hn he
  have {sz = sized} := expand(hf, mallocng.frame_ok)
  have so _ := mp(sz, (!(0 = 6) by simp()))
  have s5 sl _ := expand(so, mallocng.size_ok)
  let R := int_sub(int_sub(mallocng.slot_end(v, i), p), n)
  have c1: int_le(5, R) -> int_le(int_div(mallocng.b8(m, int_sub(p, 3)), 32), 5) proof
    assume h
    have d _ _ := mp(s5, h)
    show by arith(d)
  qed
  have c2: int_lt(R, 5) -> int_le(int_div(mallocng.b8(m, int_sub(p, 3)), 32), 5) proof
    assume h
    have d := mp(sl, h)
    show by arith(d, h)
  qed
  show by taut((int_le(5, R) || int_lt(R, 5) by arith(hp, hn, he)), c1, c2)
qed

theorem mp.u_code_nest(m, v, i, p, n): mallocng.frame_ok(m, v, i, p, n, 6) -> int_div(mallocng.b8(m, int_sub(p, 3)), 32) = 6
proof
  assume hf
  have {ns = nested} := expand(hf, mallocng.frame_ok)
  show := mp(ns, refl({6}))
qed

// (a byte in both states' ranges: the same in both views)
theorem mp.u_b8_same(c, A, B, vm, b, a): mallocng.no_reserved(A) -> mallocng.no_reserved(B) ->
  seq_len(A.taken) = 0 -> seq_len(B.taken) = 0 -> a in omega ->
  mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) -> mallocng.in_ranges(a, mallocng.fp_ranges(c, B)) ->
  mallocng.b8(mallocng.mview(vm, mallocng.held(c, A, b)), a) = mallocng.b8(mallocng.mview(vm, mallocng.held(c, B, b)), a)
proof
  assume hra hrb hta htb hao ia ib
  have iff := apply(mp.u_held_iff[c := c, A := B, B := A, b := b, a := a], hao, hrb, hra, htb, hta, ib, ia)
  have v := apply(mp.u_view_at[vm := vm, F := mallocng.held(c, B, b), G := mallocng.held(c, A, b), a := a], hao, iff)
  have {e = byte} := apply(mp.agree_b8[M := mallocng.mview(vm, mallocng.held(c, A, b)), M2 := mallocng.mview(vm, mallocng.held(c, B, b)), a := a], v)
  show := sym(e)
qed

// (a byte of slot i, from its header's third byte to its end: the group's)
theorem mp.u_slot_bytes(A, M, b, g, i, a): A in mallocng.Abs -> g in omega -> mallocng.group_ok(A, M, b, g) -> i in omega ->
  int_le(i, A.metas[g].last_idx) -> a in omega ->
  int_le(int_sub(mallocng.slot_start(A.metas[g], i), 3), a) -> int_le(a, mallocng.slot_end(A.metas[g], i)) ->
  mallocng.in_range(a, mallocng.group_range(A.metas[g]))
proof
  assume ha hg hok hi hil hao h1 h2
  let V := A.metas[g]
  have mv := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A.metas, x := g], simp(ha), hg)
  have mo lo := (V.mem in omega && V.last_idx in omega by simp(expand(mv, mallocng.MetaV)))
  have so := apply(mp.stride_nat[A := A, M := M, b := b, g := g], ha, hg, hok)
  have ml := mp(all_elim(ms.mul_le, {mallocng.stride(V)}, {i}, {mallocng.stride(V)}, {V.last_idx}), so, hi, arith(so), arith(lo), arith(so), hil)
  have ks: mallocng.UNIT = 16 && mallocng.IB = 4 by defs(simp(), mallocng.UNIT, mallocng.IB)
  have es: mallocng.slot_start(V, i) = int_add(int_add(V.mem, 16), int_mul(mallocng.stride(V), i)) by defs(simp(ks), mallocng.slot_start, mallocng.storage)
  have ee: mallocng.slot_end(V, i) = int_sub(int_add(int_add(int_add(V.mem, 16), int_mul(mallocng.stride(V), i)), mallocng.stride(V)), 4)
    by defs(simp(ks), mallocng.slot_end, mallocng.slot_start, mallocng.storage)
  have el: mallocng.slot_end(V, V.last_idx) = int_sub(int_add(int_add(int_add(V.mem, 16), int_mul(mallocng.stride(V), V.last_idx)), mallocng.stride(V)), 4)
    by defs(simp(ks), mallocng.slot_end, mallocng.slot_start, mallocng.storage)
  have lo1: int_le(V.mem, a) by arith(h1, es, mo, so, hi, ml)
  have hi2: int_le(a, mallocng.slot_end(V, V.last_idx)) by arith(h2, ee, el, mo, so, hi, ml)
  show := apply(mp.group_bytes[A := A, M := M, b := b, h := g, a := a], ha, hg, hok, hao, lo1, hi2)
qed

// (a use: unused, reserved, a block or a nested group)
theorem mp.u_use_cases(u): u in mallocng.Use -> u = tag(0, empty) || u = tag(3, empty) || fst(u) = 1 || fst(u) = 2
proof
  assume hu
  let G := u = tag(0, empty) || u = tag(3, empty) || fst(u) = 1 || fst(u) = 2
  have c0: u in set_image(single(empty), x0. tag(0, x0)) -> G proof
    assume h
    obtain x, hx he from ((ex x0. x0 in single(empty) && tag(0, x0) = u) by taut(h, set_image_def[s := single(empty), f := x0. tag(0, x0), y := u]))
    have xe := mp(single_elim[a := empty, z := x], hx)
    show by simp(sym(he), xe)
  qed
  have c1: u in set_image(omega, x0. tag(1, x0)) -> G proof
    assume h
    obtain x, hx he from ((ex x0. x0 in omega && tag(1, x0) = u) by taut(h, set_image_def[s := omega, f := x0. tag(1, x0), y := u]))
    show by defs(simp(sym(he)), tag)
  qed
  have c2: u in set_image(omega, x0. tag(2, x0)) -> G proof
    assume h
    obtain x, hx he from ((ex x0. x0 in omega && tag(2, x0) = u) by taut(h, set_image_def[s := omega, f := x0. tag(2, x0), y := u]))
    show by defs(simp(sym(he)), tag)
  qed
  have c3: u in set_image(single(empty), x0. tag(3, x0)) -> G proof
    assume h
    obtain x, hx he from ((ex x0. x0 in single(empty) && tag(3, x0) = u) by taut(h, set_image_def[s := single(empty), f := x0. tag(3, x0), y := u]))
    have xe := mp(single_elim[a := empty, z := x], hx)
    show by simp(sym(he), xe)
  qed
  have hu2 := expand(hu, mallocng.Use)
  show by simp(hu2, c0, c1, c2, c3)
qed

abbrev mp.MV(c, A, vm, b) := mallocng.mview(vm, mallocng.held(c, A, b))

// (a case of a propositional ite: its branch)
theorem mp.ite_then(c, x, y): ite(c, x, y) -> c -> x
proof
  assume h hc
  show := rewrite(mp(ite_t[c := c, a := x, b := y], hc), h)
qed

theorem mp.ite_else(c, x, y): ite(c, x, y) -> !c -> y
proof
  assume h hc
  show := rewrite(mp(ite_f[c := c, a := x, b := y], hc), h)
qed

// what slot i of a used group holds, a block or a nested group: at the
// start its header says, its size code (at most 5, or 6), within the slot;
// a nested group's meta the word at its start
theorem mp.u_slot_one(c, A, vm, b, g, i): A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  mallocng.holds_m(c, A, vm, b) -> mallocng.is_used(A, g) -> g in omega -> i in omega -> int_le(i, A.metas[g].last_idx) ->
  ss: mallocng.slot_start(A.metas[g], i) in omega && s16: int_le(16, mallocng.slot_start(A.metas[g], i)) &&
  blk: (fst(A.slots[g][i]) = 1 -> snd(A.slots[g][i]) = mp.fstart(mp.MV(c, A, vm, b), A.metas[g], i) &&
    int_le(int_div(mallocng.b8(mp.MV(c, A, vm, b), int_sub(snd(A.slots[g][i]), 3)), 32), 5) &&
    int_le(mallocng.slot_start(A.metas[g], i), snd(A.slots[g][i])) && int_le(snd(A.slots[g][i]), mallocng.slot_end(A.metas[g], i))) &&
  nst: (fst(A.slots[g][i]) = 2 -> A.metas[snd(A.slots[g][i])].mem = mp.fstart(mp.MV(c, A, vm, b), A.metas[g], i) &&
    int_div(mallocng.b8(mp.MV(c, A, vm, b), int_sub(A.metas[snd(A.slots[g][i])].mem, 3)), 32) = 6 &&
    mallocng.rd(mp.MV(c, A, vm, b), A.metas[snd(A.slots[g][i])].mem, 8) = snd(A.slots[g][i]) &&
    int_le(mallocng.slot_start(A.metas[g], i), A.metas[snd(A.slots[g][i])].mem) &&
    int_le(int_add(A.metas[snd(A.slots[g][i])].mem, 8), mallocng.slot_end(A.metas[g], i)))
proof
  assume ha hbt hh hu hg hi hil
  let M := mp.MV(c, A, vm, b)
  let V := A.metas[g]
  let u := A.slots[g][i]
  have {H = inv} := expand(hh, mallocng.holds_m)
  have {huo = used} := expand(H, mallocng.holds)
  have ok := apply(mp.used_group[g := g], huo, hu)
  have {sl = slots, ns = nslots, mim = mim} := expand(ok, mallocng.group_ok)
  have {lt32 = last} := expand(mim, mallocng.meta_in_memory)
  have mv := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A.metas, x := g], simp(ha), hg)
  have mo lo := (V.mem in omega && V.last_idx in omega by simp(expand(mv, mallocng.MetaV)))
  have so := apply(mp.stride_nat[A := A, M := M, b := b, g := g], ha, hg, ok)
  have ks: mallocng.UNIT = 16 && mallocng.IB = 4 by defs(simp(), mallocng.UNIT, mallocng.IB)
  have es: mallocng.slot_start(V, i) = int_add(int_add(V.mem, 16), int_mul(mallocng.stride(V), i)) by defs(simp(ks), mallocng.slot_start, mallocng.storage)
  have ee: mallocng.slot_end(V, i) = int_sub(int_add(mallocng.slot_start(V, i), mallocng.stride(V)), 4) by defs(simp(ks), mallocng.slot_end)
  have sso: mallocng.slot_start(V, i) in omega by arith(es, mo, so, hi)
  have m0 := mp(all_elim(ms.mul_le, {0}, {0}, {mallocng.stride(V)}, {i}), simp(), simp(), arith(so), arith(hi), arith(so), arith(hi))
  have s16: int_le(16, mallocng.slot_start(V, i)) by arith(es, mo, m0)
  have seo: mallocng.slot_end(V, i) in omega by arith(ee, s16, so)
  have il: int_lt(i, seq_len(A.slots[g])) by arith(ns, hil, hi, lo)
  have sok := mp(all_elim(sl, {i}), hi, il)
  have sll: A.slots[g] in list_type(mallocng.Use) := mp(fn_space_app[a := omega, b := list_type(mallocng.Use), f := A.slots, x := g], simp(ha), hg)
  have uu := mp(at_type[l := A.slots[g], t := mallocng.Use, i := i], sll, hi, il)
  have b1: fst(u) = 1 -> snd(u) = mp.fstart(M, V, i) &&
      int_le(int_div(mallocng.b8(M, int_sub(snd(u), 3)), 32), 5) && int_le(mallocng.slot_start(V, i), snd(u)) && int_le(snd(u), mallocng.slot_end(V, i)) proof
    assume f1
    have n0 := mp(mp.tag_ne[u := u, k := 1, x := 0, v := empty], f1, simp())
    have blk := apply(mp.ite_then, apply(mp.ite_else, expand(sok, mallocng.slot_ok), n0), f1)
    have nn _ fr := blk
    have po := mp(mp.use_nat[u := u], uu, (!(fst(u) = 0) by simp(f1)), (!(fst(u) = 3) by simp(f1)))
    have bo := mp(fn_space_app[a := bits(64), b := option(omega), f := b, x := bits_of_int(64, snd(u))], hbt, simp(po))
    have _ no := mp(mp.opt_nat[o := b[bits_of_int(64, snd(u))]], bo, nn)
    have {st = start, fi = fits} := expand(fr, mallocng.frame_ok)
    have code := apply(mp.u_code_blk[m := M, v := V, i := i, p := snd(u), n := snd(b[bits_of_int(64, snd(u))])], fr, fi, po, no, seo)
    have pe := apply(mp.u_frame_p[m := M, v := V, i := i, p := snd(u), n := snd(b[bits_of_int(64, snd(u))]), tag := 0], fr, po, sso,
      (int_lt(int_div(mallocng.b8(M, int_sub(snd(u), 3)), 32), 7) by arith(code)))
    show by taut(pe, code, st, (int_le(snd(u), mallocng.slot_end(V, i)) by arith(fi, no)))
  qed
  have b2: fst(u) = 2 -> A.metas[snd(u)].mem = mp.fstart(M, V, i) &&
      int_div(mallocng.b8(M, int_sub(A.metas[snd(u)].mem, 3)), 32) = 6 && mallocng.rd(M, A.metas[snd(u)].mem, 8) = snd(u) &&
      int_le(mallocng.slot_start(V, i), A.metas[snd(u)].mem) && int_le(int_add(A.metas[snd(u)].mem, 8), mallocng.slot_end(V, i)) proof
    assume f2
    let h := snd(u)
    have n0 := mp(mp.tag_ne[u := u, k := 2, x := 0, v := empty], f2, simp())
    have n1: !(fst(u) = 1) by simp(f2)
    let NN := int_sub(int_add(mallocng.UNIT, int_mul(mallocng.stride(A.metas[h]), int_add(A.metas[h].last_idx, 1))), mallocng.IB)
    have nst := apply(mp.ite_then, apply(mp.ite_else, apply(mp.ite_else, expand(sok, mallocng.slot_ok), n0), n1), f2)
    have uh _ _ fr := nst
    have ho := mp(mp.use_nat[u := u], uu, (!(fst(u) = 0) by simp(f2)), (!(fst(u) = 3) by simp(f2)))
    have okh := apply(mp.used_group[g := h], huo, uh)
    have {hd = hdr} := expand(okh, mallocng.group_ok)
    have rh _ _ := hd
    have mvh := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A.metas, x := h], simp(ha), ho)
    have mho lho := (A.metas[h].mem in omega && A.metas[h].last_idx in omega by simp(expand(mvh, mallocng.MetaV)))
    have soh := apply(mp.stride_nat[A := A, M := M, b := b, g := h], ha, ho, okh)
    have code := apply(mp.u_code_nest[m := M, v := V, i := i, p := A.metas[h].mem, n := NN], fr)
    have pe := apply(mp.u_frame_p[m := M, v := V, i := i, p := A.metas[h].mem, n := NN, tag := 6], fr, mho, sso,
      (int_lt(int_div(mallocng.b8(M, int_sub(A.metas[h].mem, 3)), 32), 7) by arith(code)))
    have {st = start, fi = fits} := expand(fr, mallocng.frame_ok)
    have mlh := mp(all_elim(ms.mul_le, {0}, {0}, {mallocng.stride(A.metas[h])}, {int_add(A.metas[h].last_idx, 1)}), simp(), simp(), arith(soh), arith(lho), arith(soh), arith(lho))
    have p8: int_le(int_add(A.metas[h].mem, 8), mallocng.slot_end(V, i)) by arith(fi, ks, mlh, soh, lho)
    show by taut(pe, code, rh, st, p8)
  qed
  show by taut(sso, s16, b1, b2)
qed

// slot i of a group used in two states with the same metas: the same
theorem mp.u_slot(c, A, B, vm, b, g, i): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> B in univ(1) -> B in mallocng.Abs ->
  b in fn_space(bits(64), option(omega)) -> mallocng.holds_m(c, A, vm, b) -> mallocng.holds_m(c, B, vm, b) ->
  mallocng.no_reserved(A) -> mallocng.no_reserved(B) -> seq_len(A.taken) = 0 -> seq_len(B.taken) = 0 ->
  mallocng.is_used(A, g) -> mallocng.is_used(B, g) -> A.metas = B.metas -> g in omega -> i in omega -> int_le(i, A.metas[g].last_idx) ->
  A.slots[g][i] = B.slots[g][i]
proof
  assume hc hua ha hub hb hbt hha hhb hra hrb hta htb uA uB hm hg hi hil
  let V := A.metas[g]
  let MA := mp.MV(c, A, vm, b)
  let MB := mp.MV(c, B, vm, b)
  let uAs := A.slots[g][i]
  let uBs := B.slots[g][i]
  have eV: B.metas[g] = V by simp(hm)
  have {HA = inv} := expand(hha, mallocng.holds_m)
  have {HB = inv} := expand(hhb, mallocng.holds_m)
  have {oA = used} := expand(HA, mallocng.holds)
  have {oB = used} := expand(HB, mallocng.holds)
  have okA := apply(mp.used_group[g := g], oA, uA)
  have okB := apply(mp.used_group[g := g], oB, uB)
  have {nsA = nslots, mkA = masks, mimA = mim} := expand(okA, mallocng.group_ok)
  have {nsB = nslots, mkB = masks} := expand(okB, mallocng.group_ok)
  have {l32 = last} := expand(mimA, mallocng.meta_in_memory)
  have mv := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A.metas, x := g], simp(ha), hg)
  have lo: V.last_idx in omega by simp(expand(mv, mallocng.MetaV))
  have ilA: int_lt(i, seq_len(A.slots[g])) by arith(nsA, hil, hi, lo)
  have ilB: int_lt(i, seq_len(B.slots[g])) by arith(rewrite(eV, nsB), hil, hi, lo)
  // unused in one exactly when in the other: the masks' bits (the same metas)
  have mA := mp(all_elim(expand(mkA, mallocng.masks_ok), {i}), hi, arith(hil, l32, hi))
  have mB := mp(all_elim(expand(mkB, mallocng.masks_ok), {i}), hi, arith(hil, l32, hi))
  have _ _ ua _ := mA
  have _ _ ub _ := mB
  have uiA _ := mp(ua, hil)
  have uiB _ := mp(ub, (int_le(i, B.metas[g].last_idx) by simp(eV, hil)))
  have bq: int_lt(0, int_add(mallocng.bit(B.metas[g].avail, i), mallocng.bit(B.metas[g].freed, i))) <->
      int_lt(0, int_add(mallocng.bit(V.avail, i), mallocng.bit(V.freed, i))) by simp(eV)
  have un: uAs = tag(0, empty) <-> uBs = tag(0, empty) by taut(uiA, uiB, bq)
  // reserved in neither
  have rA := mp(all_elim(expand(hra, mallocng.no_reserved), {g}, {i}), conj(hg, hi), ilA)
  have rB := mp(all_elim(expand(hrb, mallocng.no_reserved), {g}, {i}), conj(hg, hi), ilB)
  // the two states' ends of what slot i holds
  have {ssA = ss, s16 = s16, bA = blk, nA = nst} := apply(mp.u_slot_one[c := c, A := A, vm := vm, b := b, g := g, i := i], ha, hbt, hha, uA, hg, hi, hil)
  have {bB = blk, nB = nst} := apply(mp.u_slot_one[c := c, A := B, vm := vm, b := b, g := g, i := i], hb, hbt, hhb, uB, hg, hi, rewrite(sym(eV), hil))
  let S := mallocng.slot_start(V, i)
  have sge := apply(mp.stride_ge[A := A, M := MA, b := b, g := g], ha, hg, okA)
  have ks: mallocng.IB = 4 by defs(simp(), mallocng.IB)
  have ee: mallocng.slot_end(V, i) = int_sub(int_add(S, mallocng.stride(V)), 4) by defs(simp(ks), mallocng.slot_end)
  // bytes of slot i (header to end): in both states' ranges
  have inb: all a. a in omega -> int_le(int_sub(S, 3), a) -> int_le(a, mallocng.slot_end(V, i)) ->
      mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) && mallocng.in_ranges(a, mallocng.fp_ranges(c, B)) proof
    fix a
    assume hao h1 h2
    have gr := apply(mp.u_slot_bytes[A := A, M := MA, b := b, g := g, i := i, a := a], ha, hg, okA, hi, hil, hao, h1, h2)
    have fa := apply(mp.u_group_fp[c := c, A := A, g := g, a := a], hc, hua, ha, uA, gr)
    have fb := apply(mp.u_group_fp[c := c, A := B, g := g, a := a], hc, hub, hb, uB, rewrite(sym(eV), gr))
    show by taut(fa, fb)
  qed
  // the header's start the same in both views
  have s3 := apply(mp.u_b8_same[c := c, A := A, B := B, vm := vm, b := b, a := int_sub(S, 3)], hra, hrb, hta, htb, arith(ssA, s16,sge),
    taut(mp(all_elim(inb, {int_sub(S, 3)}), arith(ssA, s16,sge), arith(ssA), arith(ee, ssA, sge))),
    taut(mp(all_elim(inb, {int_sub(S, 3)}), arith(ssA, s16,sge), arith(ssA), arith(ee, ssA, sge))))
  have w2: all j. j in omega -> int_lt(j, 2) -> int_add(int_sub(S, 2), j) in omega &&
      mallocng.in_ranges(int_add(int_sub(S, 2), j), mallocng.fp_ranges(c, A)) && mallocng.in_ranges(int_add(int_sub(S, 2), j), mallocng.fp_ranges(c, B)) proof
    fix j
    assume hj hjl
    have r := mp(all_elim(inb, {int_add(int_sub(S, 2), j)}), arith(ssA, s16,sge, hj), arith(ssA, s16,hj), arith(ee, ssA, sge, hj, hjl))
    show by taut((int_add(int_sub(S, 2), j) in omega by arith(ssA, s16,sge, hj)), r)
  qed
  have s2 := apply(mp.u_rd_same[c := c, A := A, B := B, vm := vm, b := b, a := int_sub(S, 2), n := 2], hra, hrb, hta, htb, simp(), w2)
  have pe: mp.fstart(MA, V, i) = mp.fstart(MB, V, i) by simp(s3, s2)
  let P := mp.fstart(MA, V, i)
  // the cases
  have cA := apply(mp.u_use_cases, mp(at_type[l := A.slots[g], t := mallocng.Use, i := i],
    mp(fn_space_app[a := omega, b := list_type(mallocng.Use), f := A.slots, x := g], simp(ha), hg), hi, ilA))
  have cB := apply(mp.u_use_cases, mp(at_type[l := B.slots[g], t := mallocng.Use, i := i],
    mp(fn_space_app[a := omega, b := list_type(mallocng.Use), f := B.slots, x := g], simp(hb), hg), hi, ilB))
  // (the size code at P - 3: the same in both views)
  have code: int_le(S, P) -> int_le(P, mallocng.slot_end(V, i)) ->
      mallocng.b8(MA, int_sub(P, 3)) = mallocng.b8(MB, int_sub(P, 3)) proof
    assume p1 p2
    have r := mp(all_elim(inb, {int_sub(P, 3)}), arith(ssA, s16,sge, p1), arith(p1), arith(p2))
    show := apply(mp.u_b8_same[c := c, A := A, B := B, vm := vm, b := b, a := int_sub(P, 3)], hra, hrb, hta, htb, arith(ssA, s16,sge, p1), taut(r), taut(r))
  qed
  have zero: uAs = tag(0, empty) -> uAs = uBs proof
    assume h
    have hb: uBs = tag(0, empty) by taut(un, h)
    show by simp(h, hb)
  qed
  have one: fst(uAs) = 1 -> uAs = uBs proof
    assume f1
    have pa ca p1 p2 := mp(bA, f1)
    have cs := mp(code, rewrite(pa, p1), rewrite(pa, p2))
    // B's: a block too (a nested group's code 6)
    have nB0: !(uBs = tag(0, empty)) by taut(un, mp(mp.tag_ne[u := uAs, k := 1, x := 0, v := empty], f1, simp()))
    have g2: fst(uBs) = 2 -> false proof
      assume f2
      have qb cb _ _ _ := mp(rewrite(eV, nB), f2)
      have e := trans(qb, sym(pe))
      show by arith(rewrite(e, cb), rewrite(pa, ca), cs)
    qed
    have f1B: fst(uBs) = 1 by taut(cB, nB0, rB, g2)
    have pb _ _ _ := mp(rewrite(eV, bB), f1B)
    have ea := mp(mp.use_eta[u := uAs], mp(at_type[l := A.slots[g], t := mallocng.Use, i := i],
      mp(fn_space_app[a := omega, b := list_type(mallocng.Use), f := A.slots, x := g], simp(ha), hg), hi, ilA))
    have eb := mp(mp.use_eta[u := uBs], mp(at_type[l := B.slots[g], t := mallocng.Use, i := i],
      mp(fn_space_app[a := omega, b := list_type(mallocng.Use), f := B.slots, x := g], simp(hb), hg), hi, ilB))
    show by simp(ea, eb, f1, f1B, pa, pb, pe)
  qed
  have two: fst(uAs) = 2 -> uAs = uBs proof
    assume f2
    have qa ca ra p1 p8 := mp(nA, f2)
    have nB0: !(uBs = tag(0, empty)) by taut(un, mp(mp.tag_ne[u := uAs, k := 2, x := 0, v := empty], f2, simp()))
    have cs := mp(code, rewrite(qa, p1), (int_le(P, mallocng.slot_end(V, i)) by arith(rewrite(qa, p8))))
    have g1: fst(uBs) = 1 -> false proof
      assume f1
      have pb cb _ _ := mp(rewrite(eV, bB), f1)
      have e := trans(pb, sym(pe))
      show by arith(rewrite(e, cb), rewrite(qa, ca), cs)
    qed
    have f2B: fst(uBs) = 2 by taut(cB, nB0, rB, g1)
    have qb _ rb _ _ := mp(rewrite(eV, nB), f2B)
    // the nested groups' metas: the word at P, in both views
    have w8: all j. j in omega -> int_lt(j, 8) -> int_add(P, j) in omega &&
        mallocng.in_ranges(int_add(P, j), mallocng.fp_ranges(c, A)) && mallocng.in_ranges(int_add(P, j), mallocng.fp_ranges(c, B)) proof
      fix j
      assume hj hjl
      have r := mp(all_elim(inb, {int_add(P, j)}), arith(ssA, s16,sge, rewrite(qa, p1), hj), arith(rewrite(qa, p1), hj), arith(rewrite(qa, p8), hj, hjl))
      show by taut((int_add(P, j) in omega by arith(ssA, s16,rewrite(qa, p1), hj)), r)
    qed
    have r8 := apply(mp.u_rd_same[c := c, A := A, B := B, vm := vm, b := b, a := P, n := 8], hra, hrb, hta, htb, simp(), w8)
    have hh: snd(uAs) = snd(uBs) by simp(rewrite(qa, ra), rewrite(trans(qb, sym(pe)), rb), r8)
    have ea := mp(mp.use_eta[u := uAs], mp(at_type[l := A.slots[g], t := mallocng.Use, i := i],
      mp(fn_space_app[a := omega, b := list_type(mallocng.Use), f := A.slots, x := g], simp(ha), hg), hi, ilA))
    have eb := mp(mp.use_eta[u := uBs], mp(at_type[l := B.slots[g], t := mallocng.Use, i := i],
      mp(fn_space_app[a := omega, b := list_type(mallocng.Use), f := B.slots, x := g], simp(hb), hg), hi, ilB))
    show by simp(ea, eb, f2, f2B, hh)
  qed
  show by taut(cA, rA, zero, one, two)
qed

// ----------------------------------------------------------------------
//  The context's fields

theorem mp.u_ctx_fields(c, A, B, vm, b): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> B in univ(1) -> B in mallocng.Abs ->
  mallocng.holds_m(c, A, vm, b) -> mallocng.holds_m(c, B, vm, b) ->
  A.secret = B.secret && A.init_done = B.init_done && A.avail_cnt = B.avail_cnt && A.reserve_cnt = B.reserve_cnt &&
  A.brk = B.brk && A.reserve = B.reserve
proof
  assume hc hua ha hub hb hha hhb
  have {HA = inv} := expand(hha, mallocng.holds_m)
  have {HB = inv} := expand(hhb, mallocng.holds_m)
  have {cA = ctx, nA = normal} := expand(HA, mallocng.holds)
  have {cB = ctx, nB = normal} := expand(HB, mallocng.holds)
  have {sA = secret, iA = init, vA = avail_cnt, rA = area_cnt, aA = avail_areas, kA = brk} := expand(cA, mallocng.ctx_ok)
  have {sB = secret, iB = init, vB = avail_cnt, rB = area_cnt, aB = avail_areas, kB = brk} := expand(cB, mallocng.ctx_ok)
  have ks: mallocng.C_SECRET = 0 && mallocng.C_INIT_DONE = 8 && mallocng.C_AVAIL_CNT = 32 && mallocng.C_AREA_CNT = 40 &&
      mallocng.C_AVAIL_AREAS = 72 && mallocng.C_BRK = 920 && mallocng.CTX_SIZE = 928
    by defs(simp(), mallocng.C_SECRET, mallocng.C_INIT_DONE, mallocng.C_AVAIL_CNT, mallocng.C_AREA_CNT, mallocng.C_AVAIL_AREAS,
      mallocng.C_BRK, mallocng.CTX_SIZE)
  // (each field: its bytes, read in both views)
  have e0 := apply(mp.u_ctx2[c := c, A := A, B := B, vm := vm, b := b, off := 0, n := 8], hc, hua, ha, hub, hb, hha, hhb, simp(), simp(), simp(ks),
    apply(mp.u_nofree[c := c, off := 0, n := 8], hc, simp(), simp(), simp()))
  have e8 := apply(mp.u_ctx2[c := c, A := A, B := B, vm := vm, b := b, off := 8, n := 4], hc, hua, ha, hub, hb, hha, hhb, simp(), simp(), simp(ks),
    apply(mp.u_nofree[c := c, off := 8, n := 4], hc, simp(), simp(), simp()))
  have e32 := apply(mp.u_ctx2[c := c, A := A, B := B, vm := vm, b := b, off := 32, n := 8], hc, hua, ha, hub, hb, hha, hhb, simp(), simp(), simp(ks),
    apply(mp.u_nofree[c := c, off := 32, n := 8], hc, simp(), simp(), simp()))
  have e40 := apply(mp.u_ctx2[c := c, A := A, B := B, vm := vm, b := b, off := 40, n := 8], hc, hua, ha, hub, hb, hha, hhb, simp(), simp(), simp(ks),
    apply(mp.u_nofree[c := c, off := 40, n := 8], hc, simp(), simp(), simp()))
  have e72 := apply(mp.u_ctx2[c := c, A := A, B := B, vm := vm, b := b, off := 72, n := 8], hc, hua, ha, hub, hb, hha, hhb, simp(), simp(), simp(ks),
    apply(mp.u_nofree[c := c, off := 72, n := 8], hc, simp(), simp(), simp()))
  have e920 := apply(mp.u_ctx2[c := c, A := A, B := B, vm := vm, b := b, off := 920, n := 8], hc, hua, ha, hub, hb, hha, hhb, simp(), simp(), simp(ks),
    apply(mp.u_nofree[c := c, off := 920, n := 8], hc, simp(), simp(), simp()))
  have sec: A.secret = B.secret by simp(expand(sA, mallocng.ctx_word), expand(sB, mallocng.ctx_word), e0, ks)
  have ini: A.init_done = B.init_done by simp(iA, iB, e8, ks)
  have avc: A.avail_cnt = B.avail_cnt by simp(expand(vA, mallocng.ctx_word), expand(vB, mallocng.ctx_word), e32, ks)
  have rsc: A.reserve_cnt = B.reserve_cnt by simp(expand(rA, mallocng.ctx_word), expand(rB, mallocng.ctx_word), e40, ks)
  have brk: A.brk = B.brk by simp(expand(kA, mallocng.ctx_word), expand(kB, mallocng.ctx_word), e920, ks)
  // (the reserve: the context's word while reserved pages remain, else 0)
  have {zA = reserve} := expand(nA, mallocng.normal)
  have {zB = reserve} := expand(nB, mallocng.normal)
  have ro: A.reserve_cnt in omega by simp(ha)
  have d: int_lt(0, A.reserve_cnt) || A.reserve_cnt = 0 by arith(ro)
  have r1: int_lt(0, A.reserve_cnt) -> A.reserve = B.reserve proof
    assume h
    show by simp(h, expand(aA, mallocng.ctx_word), expand(aB, mallocng.ctx_word), e72, ks, rsc)
  qed
  have r0: A.reserve_cnt = 0 -> A.reserve = B.reserve proof
    assume h
    have a0: A.reserve = 0 by taut(zA, h)
    have hb: B.reserve_cnt = 0 by simp(h, rsc)
    have b0: B.reserve = 0 by taut(zB, hb)
    show by simp(a0, b0)
  qed
  have rsv: A.reserve = B.reserve by taut(d, r1, r0)
  show by taut(sec, ini, avc, rsc, brk, rsv)
qed

// ----------------------------------------------------------------------
//  The abstract state determined by memory

// an abstract state: a record of values (in the universe)
theorem mallocng.abs_univ(A): A in mallocng.Abs -> A in univ(1)
proof
  assume ha
  let K := insert("secret", insert("init_done", insert("auxv_at", insert("auxv", insert("areas", insert("avail_cnt", insert("reserve", insert("reserve_cnt",
    insert("free_metas", insert("used", insert("metas", insert("active", insert("slots", insert("brk", insert("taken", empty)))))))))))))))
  have kp: K in univ(1) by simp(x86.insert_univ)
  have ap: A in powerset(cart(K, univ(1))) && is_fun(A) && dom(A) = K by simp(expand(ha, mallocng.Abs))
  show := mp(rec_univ[u := 1, k := K, r := A], kp, taut(ap), taut(ap), taut(ap))
qed

// (a heap state's blocks: a map of addresses to optional sizes)
theorem mp.u_blocks_ty(s): s in rec_and(abi.World, malloc.Heap.ghost) -> s.blocks in fn_space(bits(64), option(omega))
proof
  assume hs
  obtain w h, hw hh e from mp(rec_and_elim[a := abi.World, b := malloc.Heap.ghost, s := s], hs)
  have sd: dom(w) = abi.WKEYS by simp(expand(hw, abi.World))
  have hd: dom(h) = insert("blocks", empty) by simp(expand(hh, malloc.Heap.ghost))
  have bS: union2(w, h).blocks = h.blocks by simp(sd, hd)
  have bt: h.blocks in fn_space(bits(64), option(omega)) by simp(expand(hh, malloc.Heap.ghost))
  show := rewrite(sym(e), rewrite(sym(bS), bt))
qed

// (two functions on d, equal at every point: equal)
theorem mp.u_fn_eq(f, g, d, t): f in fn_space(d, t) -> g in fn_space(d, t) -> (all x. x in d -> f[x] = g[x]) -> f = g
proof
  assume hf hg he
  have ff fd := (is_fun(f) && dom(f) = d by simp(expand(hf, fn_space)))
  have gf gd := (is_fun(g) && dom(g) = d by simp(expand(hg, fn_space)))
  have pw: all k. k in dom(f) -> f[k] = g[k] proof
    fix k
    assume hk
    show := mp(all_elim(he, {k}), rewrite(fd, hk))
  qed
  show := mp(rec_ext[a := f, b := g], ff, gf, trans(fd, sym(gd)), pw)
qed

// (an empty list: equal to any other)
theorem mp.u_nil(l1, l2, t): l1 in list_type(t) -> l2 in list_type(t) -> seq_len(l1) = 0 -> seq_len(l2) = 0 -> l1 = l2
proof
  assume h1 h2 z1 z2
  have el: all i. i in omega -> int_lt(i, seq_len(l1)) -> l1[i] = l2[i] proof
    fix i
    assume hi hil
    show by arith(hi, hil, z1)
  qed
  show := mp(ext_example[a := l1, b := l2, t := t], h1, h2, trans(z1, sym(z2)), el)
qed

theorem mallocng.abs_unique(c, s, A, B): c in mallocng.Cfg -> s in rec_and(abi.World, malloc.Heap.ghost) -> A in mallocng.Abs -> B in mallocng.Abs ->
  mallocng.rep(c, A, s) -> mallocng.rep(c, B, s) -> A = B
proof
  assume hc hs ha hb ra rb
  have hua := apply(mallocng.abs_univ, ha)
  have hub := apply(mallocng.abs_univ, hb)
  have {hha = mem, nra = unres, tka = untaken} := expand(ra, mallocng.rep)
  have {hhb = mem, nrb = unres, tkb = untaken} := expand(rb, mallocng.rep)
  have bt := apply(mp.u_blocks_ty, hs)
  let vm := s.vm
  let b := s.blocks
  have sec ini avc rsc brk rsv := apply(mp.u_ctx_fields[c := c, A := A, B := B, vm := vm, b := b], hc, hua, ha, hub, hb, hha, hhb)
  have fm ac := apply(mp.u_lists[c := c, A := A, B := B, vm := vm, b := b], hc, hua, ha, hub, hb, hha, hhb, tka, tkb)
  have ar := apply(mp.u_areas[c := c, A := A, B := B, vm := vm, b := b], hc, hua, ha, hub, hb, hha, hhb, tka, tkb)
  have xa xv := apply(mp.u_auxv[c := c, A := A, B := B, vm := vm, b := b], hc, hua, ha, hub, hb, hha, hhb, nra, nrb, tka, tkb, ini)
  have us := apply(mp.u_used[c := c, A := A, B := B, vm := vm, b := b], ha, hb, hha, hhb, tka, tkb, ar, fm, avc)
  have {HA = inv} := expand(hha, mallocng.holds_m)
  have {HB = inv} := expand(hhb, mallocng.holds_m)
  have {nA = normal, cA = ctx} := expand(HA, mallocng.holds)
  have {nB = normal, cB = ctx} := expand(HB, mallocng.holds)
  have {zA = unused} := expand(nA, mallocng.normal)
  have {zB = unused} := expand(nB, mallocng.normal)
  have uiff: all g. mallocng.is_used(A, g) <-> mallocng.is_used(B, g) proof
    fix g
    show by defs(simp(us), mallocng.is_used)
  qed
  // the metas: the used ones read, the others zero
  have mt: A.metas = B.metas proof
    have pw: all g. g in omega -> A.metas[g] = B.metas[g] proof
      fix g
      assume hg
      have u: mallocng.is_used(A, g) -> A.metas[g] = B.metas[g] proof
        assume h
        show := apply(mp.u_meta[c := c, A := A, B := B, vm := vm, b := b, g := g], hc, hua, ha, hub, hb, hha, hhb, tka, tkb, h, taut(all_elim(uiff, {g}), h))
      qed
      have n: !mallocng.is_used(A, g) -> A.metas[g] = B.metas[g] proof
        assume h
        have a0 _ := mp(all_elim(zA, {g}), hg, h)
        have b0 _ := mp(all_elim(zB, {g}), hg, (!mallocng.is_used(B, g) by taut(all_elim(uiff, {g}), h)))
        show := trans(a0, sym(b0))
      qed
      show by taut(u, n)
    qed
    show := apply(mp.u_fn_eq[f := A.metas, g := B.metas, d := omega, t := mallocng.MetaV], (A.metas in fn_space(omega, mallocng.MetaV) by simp(ha)),
      (B.metas in fn_space(omega, mallocng.MetaV) by simp(hb)), pw)
  qed
  // the slots: the used groups' read, the others none
  have sl: A.slots = B.slots proof
    have pw: all g. g in omega -> A.slots[g] = B.slots[g] proof
      fix g
      assume hg
      have la := mp(fn_space_app[a := omega, b := list_type(mallocng.Use), f := A.slots, x := g], simp(ha), hg)
      have lb := mp(fn_space_app[a := omega, b := list_type(mallocng.Use), f := B.slots, x := g], simp(hb), hg)
      have u: mallocng.is_used(A, g) -> A.slots[g] = B.slots[g] proof
        assume h
        have hB: mallocng.is_used(B, g) by taut(all_elim(uiff, {g}), h)
        have {oA = used} := expand(HA, mallocng.holds)
        have {oB = used} := expand(HB, mallocng.holds)
        have {nsA = nslots} := expand(apply(mp.used_group[g := g], oA, h), mallocng.group_ok)
        have {nsB = nslots} := expand(apply(mp.used_group[g := g], oB, hB), mallocng.group_ok)
        have le: seq_len(A.slots[g]) = seq_len(B.slots[g]) by simp(nsA, nsB, mt)
        have mv := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A.metas, x := g], simp(ha), hg)
        have lo: A.metas[g].last_idx in omega by simp(expand(mv, mallocng.MetaV))
        have el: all i. i in omega -> int_lt(i, seq_len(A.slots[g])) -> A.slots[g][i] = B.slots[g][i] proof
          fix i
          assume hi hil
          show := apply(mp.u_slot[c := c, A := A, B := B, vm := vm, b := b, g := g, i := i], hc, hua, ha, hub, hb, bt, hha, hhb, nra, nrb, tka, tkb,
            h, hB, mt, hg, hi, arith(nsA, hil, hi, lo))
        qed
        show := mp(ext_example[a := A.slots[g], b := B.slots[g], t := mallocng.Use], la, lb, le, el)
      qed
      have n: !mallocng.is_used(A, g) -> A.slots[g] = B.slots[g] proof
        assume h
        have _ a0 := mp(all_elim(zA, {g}), hg, h)
        have _ b0 := mp(all_elim(zB, {g}), hg, (!mallocng.is_used(B, g) by taut(all_elim(uiff, {g}), h)))
        show := apply(mp.u_nil, la, lb, a0, b0)
      qed
      show by taut(u, n)
    qed
    show := apply(mp.u_fn_eq[f := A.slots, g := B.slots, d := omega, t := list_type(mallocng.Use)], (A.slots in fn_space(omega, list_type(mallocng.Use)) by simp(ha)),
      (B.slots in fn_space(omega, list_type(mallocng.Use)) by simp(hb)), pw)
  qed
  // the active lists: 48 of them, each the same
  have {naA = nactive} := expand(cA, mallocng.ctx_ok)
  have {naB = nactive} := expand(cB, mallocng.ctx_ok)
  have act: A.active = B.active proof
    have el: all k. k in omega -> int_lt(k, seq_len(A.active)) -> A.active[k] = B.active[k] proof
      fix k
      assume hk hkl
      show := mp(all_elim(ac, {k}), hk, arith(hkl, naA))
    qed
    show := mp(ext_example[a := A.active, b := B.active, t := list_type(omega)], (A.active in list_type(list_type(omega)) by simp(ha)),
      (B.active in list_type(list_type(omega)) by simp(hb)), trans(naA, sym(naB)), el)
  qed
  have tk := apply(mp.u_nil[l1 := A.taken, l2 := B.taken, t := omega], (A.taken in list_type(omega) by simp(ha)), (B.taken in list_type(omega) by simp(hb)), tka, tkb)
  // the records: the same fields
  let K := insert("secret", insert("init_done", insert("auxv_at", insert("auxv", insert("areas", insert("avail_cnt", insert("reserve", insert("reserve_cnt",
    insert("free_metas", insert("used", insert("metas", insert("active", insert("slots", insert("brk", insert("taken", empty)))))))))))))))
  have fa: is_fun(A) && dom(A) = K by simp(expand(ha, mallocng.Abs))
  have fb: is_fun(B) && dom(B) = K by simp(expand(hb, mallocng.Abs))
  have ek: all k. k in dom(A) -> A[k] = B[k] proof
    fix k
    assume hk
    have da: dom(A) = K by taut(fa)
    have kk := rewrite(da, hk)
    show by simp(kk, sec, ini, xa, xv, ar, avc, rsv, rsc, fm, us, mt, act, sl, brk, tk)
  qed
  show := mp(rec_ext[a := A, b := B], taut(fa), taut(fb), (dom(A) = dom(B) by simp(fa, fb)), ek)
qed
