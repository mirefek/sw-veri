// A group made (alloc_group): the meta taken last becomes a used group --
// in the groups in use at its place (they ascend), out of the taken ones,
// its record set, its slots unused --, either on pages mapped for it or
// nested in a reserved slot of a larger class's group (that slot's use
// then the nested group). The invariant kept: the new group's own clauses
// from its memory, the others' by the frame.

// ----------------------------------------------------------------------
//  The groups in use with one put at its place

// l with x put at position k (the ones from k on one further)
abbrev mp.ins_at(l, k, x) := fn_build(int_add(seq_len(l), 1), j. ite(int_lt(j, k), l[j], ite(j = k, x, l[int_sub(j, 1)])))

// (its length, its type, its elements)
theorem mp.ins_app(l, k, x, j): l in list_type(omega) -> k in omega -> int_le(k, seq_len(l)) -> x in omega ->
  (len: seq_len(mp.ins_at(l, k, x)) = int_add(seq_len(l), 1) && type: mp.ins_at(l, k, x) in list_type(omega)) &&
  elem: (j in omega -> int_lt(j, int_add(seq_len(l), 1)) -> mp.ins_at(l, k, x)[j] = ite(int_lt(j, k), l[j], ite(j = k, x, l[int_sub(j, 1)])))
proof
  assume hl hk hkl hx
  let D := int_add(seq_len(l), 1)
  have lo: seq_len(l) in omega by arith(hl)
  have dd: D in omega by arith(lo)
  have vt: all x0. x0 in D -> ite(int_lt(x0, k), l[x0], ite(x0 = k, x, l[int_sub(x0, 1)])) in omega proof
    fix x0
    assume h0
    have xo := mp(nat_elem[k := D, i := x0], dd, h0)
    have xl := mp(nat_mem_lt[k := D, i := x0], dd, h0)
    have c1: int_lt(x0, k) -> ite(int_lt(x0, k), l[x0], ite(x0 = k, x, l[int_sub(x0, 1)])) in omega proof
      assume h
      have t := apply(at_type[l := l, t := omega, i := x0], hl, xo, (int_lt(x0, seq_len(l)) by arith(h, hkl, xo)))
      have e: ite(int_lt(x0, k), l[x0], ite(x0 = k, x, l[int_sub(x0, 1)])) = l[x0] by simp(h)
      show := rewrite(sym(e), t)
    qed
    have c2: x0 = k -> ite(int_lt(x0, k), l[x0], ite(x0 = k, x, l[int_sub(x0, 1)])) in omega proof
      assume h
      have e: ite(int_lt(x0, k), l[x0], ite(x0 = k, x, l[int_sub(x0, 1)])) = x by simp(h, (!int_lt(x0, k) by arith(h)))
      show := rewrite(sym(e), hx)
    qed
    have c3: int_lt(k, x0) -> ite(int_lt(x0, k), l[x0], ite(x0 = k, x, l[int_sub(x0, 1)])) in omega proof
      assume h
      have t := apply(at_type[l := l, t := omega, i := int_sub(x0, 1)], hl, (int_sub(x0, 1) in omega by arith(h, hk, xo)), (int_lt(int_sub(x0, 1), seq_len(l)) by arith(xl, lo)))
      have e: ite(int_lt(x0, k), l[x0], ite(x0 = k, x, l[int_sub(x0, 1)])) = l[int_sub(x0, 1)] by simp((!int_lt(x0, k) by arith(h)), (!(x0 = k) by arith(h)))
      show := rewrite(sym(e), t)
    qed
    show by taut(c1, c2, c3, (int_lt(x0, k) || x0 = k || int_lt(k, x0) by arith(xo, hk)))
  qed
  have rl: mp.ins_at(l, k, x) in list_type(omega) := apply(build_list, dd, vt)
  have dl: seq_len(mp.ins_at(l, k, x)) = D by defs(fn_build_dom[d := D, v := x0. ite(int_lt(x0, k), l[x0], ite(x0 = k, x, l[int_sub(x0, 1)]))], seq_len)
  have ap: j in omega -> int_lt(j, D) -> mp.ins_at(l, k, x)[j] = ite(int_lt(j, k), l[j], ite(j = k, x, l[int_sub(j, 1)])) proof
    assume hj hjl
    have jd := mp(nat_lt_mem[k := j, n := D], hj, dd, hjl)
    show := mp(app_fn_build[d := D, v := x0. ite(int_lt(x0, k), l[x0], ite(x0 = k, x, l[int_sub(x0, 1)])), a := j], jd)
  qed
  show by taut(dl, rl, ap)
qed

// (a list ascending at each step ascends: l[i] < l[j] for i < j)
theorem mp.asc_lt(l, i, j): l in list_type(omega) -> (all k. k in omega -> int_lt(int_add(k, 1), seq_len(l)) -> int_lt(l[k], l[int_add(k, 1)])) ->
  i in omega -> j in omega -> int_lt(i, j) -> int_lt(j, seq_len(l)) -> int_lt(l[i], l[j])
proof
  assume hl hs hi hj hij hjl
  let L := seq_len(l)
  have lo: L in omega by arith(hl)
  let P(d) := all a. a in omega -> int_lt(int_add(int_add(a, d), 1), L) -> int_lt(l[a], l[int_add(int_add(a, d), 1)])
  have base: P(0) proof
    fix a
    assume ha hal
    have z: int_add(int_add(a, 0), 1) = int_add(a, 1) by arith(ha)
    show := rewrite(sym(z), mp(all_elim(hs, {a}), ha, rewrite(z, hal)))
  qed
  have step: all d. d in omega -> P(d) -> P(int_add(d, 1)) proof
    fix d
    assume hd ih
    fix a
    assume ha hal
    let b := int_add(int_add(a, d), 1)
    have bo: b in omega by arith(ha, hd)
    have i1 := mp(all_elim(ih, {a}), ha, (int_lt(b, L) by arith(hal, ha, hd)))
    have e: int_add(int_add(a, int_add(d, 1)), 1) = int_add(b, 1) by arith(ha, hd)
    have i2 := mp(all_elim(hs, {b}), bo, rewrite(e, hal))
    have ta := apply(at_type[l := l, t := omega, i := a], hl, ha, (int_lt(a, L) by arith(hal, ha, hd)))
    have tb := apply(at_type[l := l, t := omega, i := b], hl, bo, (int_lt(b, L) by arith(hal, ha, hd)))
    have tc := apply(at_type[l := l, t := omega, i := int_add(b, 1)], hl, (int_add(b, 1) in omega by arith(bo)), rewrite(e, hal))
    show := rewrite(sym(e), (int_lt(l[a], l[int_add(b, 1)]) by arith(i1, i2, ta, tb, tc)))
  qed
  have all_d: all d. d in omega -> P(d) by induct(base, step)
  let D := int_sub(int_sub(j, i), 1)
  have dd: D in omega by arith(hi, hj, hij)
  have e: int_add(int_add(i, D), 1) = j by arith(hi, hj, hij)
  have r := mp(all_elim(mp(all_elim(all_d, {D}), dd), {i}), hi, rewrite(sym(e), hjl))
  show := rewrite(e, r)
qed

// (x put at its place k: the list still ascends; its members l's and x)
theorem mp.ins_sorted(l, k, x): l in list_type(omega) -> k in omega -> int_le(k, seq_len(l)) -> x in omega ->
  (all j. j in omega -> int_lt(int_add(j, 1), seq_len(l)) -> int_lt(l[j], l[int_add(j, 1)])) ->
  (all j. j in omega -> int_lt(j, k) -> int_lt(l[j], x)) -> (all j. j in omega -> int_le(k, j) -> int_lt(j, seq_len(l)) -> int_lt(x, l[j])) ->
  all j. j in omega -> int_lt(int_add(j, 1), int_add(seq_len(l), 1)) -> int_lt(mp.ins_at(l, k, x)[j], mp.ins_at(l, k, x)[int_add(j, 1)])
proof
  assume hl hk hkl hx hs hlo hhi
  fix j
  assume hj hjl
  have lo: seq_len(l) in omega by arith(hl)
  have _ _ el := apply(mp.ins_app[l := l, k := k, x := x, j := j], hl, hk, hkl, hx)
  have _ _ el1 := apply(mp.ins_app[l := l, k := k, x := x, j := int_add(j, 1)], hl, hk, hkl, hx)
  have a0 := mp(el, hj, (int_lt(j, int_add(seq_len(l), 1)) by arith(hjl)))
  have a1 := mp(el1, (int_add(j, 1) in omega by arith(hj)), hjl)
  // (below k both l's; at k-1, k: l's last below and x; at k: x and l's at k; above: l's)
  have c1: int_lt(int_add(j, 1), k) -> int_lt(mp.ins_at(l, k, x)[j], mp.ins_at(l, k, x)[int_add(j, 1)]) proof
    assume h
    have s := mp(all_elim(hs, {j}), hj, (int_lt(int_add(j, 1), seq_len(l)) by arith(h, hkl)))
    show by simp(a0, a1, h, (int_lt(j, k) by arith(h)), s)
  qed
  have c2: int_add(j, 1) = k -> int_lt(mp.ins_at(l, k, x)[j], mp.ins_at(l, k, x)[int_add(j, 1)]) proof
    assume h
    have s := mp(all_elim(hlo, {j}), hj, (int_lt(j, k) by arith(h)))
    show by simp(a0, a1, h, (int_lt(j, k) by arith(h)), s)
  qed
  have c3: j = k -> int_lt(mp.ins_at(l, k, x)[j], mp.ins_at(l, k, x)[int_add(j, 1)]) proof
    assume h
    have s := mp(all_elim(hhi, {k}), hk, (int_le(k, k) by arith(hk)), (int_lt(k, seq_len(l)) by arith(h, hjl)))
    have e1: int_sub(int_add(j, 1), 1) = k by arith(h, hj)
    have v0 := trans(a0, trans(mp(ite_f[c := int_lt(j, k), a := l[j], b := ite(j = k, x, l[int_sub(j, 1)])], (!int_lt(j, k) by arith(h))),
      mp(ite_t[c := j = k, a := x, b := l[int_sub(j, 1)]], h)))
    have v1 := trans(a1, trans(mp(ite_f[c := int_lt(int_add(j, 1), k), a := l[int_add(j, 1)], b := ite(int_add(j, 1) = k, x, l[int_sub(int_add(j, 1), 1)])],
      (!int_lt(int_add(j, 1), k) by arith(h))), mp(ite_f[c := int_add(j, 1) = k, a := x, b := l[int_sub(int_add(j, 1), 1)]], (!(int_add(j, 1) = k) by arith(h)))))
    have tk := apply(at_type[l := l, t := omega, i := k], hl, hk, (int_lt(k, seq_len(l)) by arith(h, hjl)))
    show by arith(v0, v1, s, e1, hx, tk)
  qed
  have c4: int_lt(k, j) -> int_lt(mp.ins_at(l, k, x)[j], mp.ins_at(l, k, x)[int_add(j, 1)]) proof
    assume h
    have j1: int_sub(j, 1) in omega by arith(h, hk, hj)
    have e1: int_add(int_sub(j, 1), 1) = j by arith(h, hk, hj)
    have s := mp(all_elim(hs, {int_sub(j, 1)}), j1, (int_lt(int_add(int_sub(j, 1), 1), seq_len(l)) by arith(h, hjl, hj)))
    have e2: int_sub(int_add(j, 1), 1) = j by arith(hj)
    show by simp(a0, a1, (!int_lt(j, k) by arith(h)), (!(j = k) by arith(h)), (!int_lt(int_add(j, 1), k) by arith(h)), (!(int_add(j, 1) = k) by arith(h)), rewrite(e1, s), e2)
  qed
  show by taut(c1, c2, c3, c4, (int_lt(int_add(j, 1), k) || int_add(j, 1) = k || j = k || int_lt(k, j) by arith(hj, hk)))
qed

// (x not in an ascending list: its place, after the ones below it)
theorem mp.ins_pos(l, x): l in list_type(omega) -> x in omega ->
  (all j. j in omega -> int_lt(int_add(j, 1), seq_len(l)) -> int_lt(l[j], l[int_add(j, 1)])) ->
  (all j. j in omega -> int_lt(j, seq_len(l)) -> !(l[j] = x)) ->
  ex k. k in omega && int_le(k, seq_len(l)) && (all j. j in omega -> int_lt(j, k) -> int_lt(l[j], x)) &&
    (all j. j in omega -> int_le(k, j) -> int_lt(j, seq_len(l)) -> int_lt(x, l[j]))
proof
  assume hl hx hs hn
  let L := seq_len(l)
  have lo: L in omega by arith(hl)
  let p(k) := k in omega && (k = L || (int_lt(k, L) && int_lt(x, l[k])))
  have eL: ex a. a in omega && p(a) by ex_intro({L}, taut(lo, refl({L})))
  obtain m, hm hp hmin from mp(nat_least[p := k. p(k)], eL)
  have _ hpm := hp
  have ml: int_le(m, L) proof
    have c1: m = L -> int_le(m, L) proof
      assume e
      show by arith(e, lo)
    qed
    have c2: int_lt(m, L) && int_lt(x, l[m]) -> int_le(m, L) proof
      assume e
      have e1 _ := e
      show by arith(e1)
    qed
    show by taut(hpm, c1, c2)
  qed
  have lo2: all j. j in omega -> int_lt(j, m) -> int_lt(l[j], x) proof
    fix j
    assume hj hjm
    have np: !p(j) proof
      assume pj
      have le := mp(all_elim(hmin, {j}), hj, pj)
      show by arith(le, hjm)
    qed
    have jl: int_lt(j, L) by arith(hjm, ml)
    have nlt: !int_lt(x, l[j]) by taut(np, hj, jl)
    have ne := mp(all_elim(hn, {j}), hj, jl)
    have tj := apply(at_type[l := l, t := omega, i := j], hl, hj, jl)
    show by arith(nlt, ne, tj, hx)
  qed
  have hi2: all j. j in omega -> int_le(m, j) -> int_lt(j, L) -> int_lt(x, l[j]) proof
    fix j
    assume hj hmj hjl
    have nm: !(m = L) by arith(hmj, hjl)
    have ml2 xm := (int_lt(m, L) && int_lt(x, l[m]) by taut(hpm, nm))
    have c1: m = j -> int_lt(x, l[j]) proof
      assume e
      show := rewrite(e, xm)
    qed
    have c2: int_lt(m, j) -> int_lt(x, l[j]) proof
      assume h
      have a := apply(mp.asc_lt[l := l, i := m, j := j], hl, hs, hm, hj, h, hjl)
      have tm := apply(at_type[l := l, t := omega, i := m], hl, hm, ml2)
      have tj := apply(at_type[l := l, t := omega, i := j], hl, hj, hjl)
      show by arith(a, xm, tm, tj, hx)
    qed
    show by taut(c1, c2, (m = j || int_lt(m, j) by arith(hmj)))
  qed
  show by ex_intro({m}, taut(hm, ml, lo2, hi2))
qed

// (the members of l with x put at k: l's and x)
theorem mp.ins_mem(l, k, x, g): l in list_type(omega) -> k in omega -> int_le(k, seq_len(l)) -> x in omega ->
  ((ex i. i in omega && (int_lt(i, seq_len(mp.ins_at(l, k, x))) && mp.ins_at(l, k, x)[i] = g)) <->
   ((ex i. i in omega && (int_lt(i, seq_len(l)) && l[i] = g)) || g = x))
proof
  assume hl hk hkl hx
  have lo: seq_len(l) in omega by arith(hl)
  have dl _ _ := apply(mp.ins_app[l := l, k := k, x := x, j := 0], hl, hk, hkl, hx)
  have el: all j. j in omega -> int_lt(j, int_add(seq_len(l), 1)) -> mp.ins_at(l, k, x)[j] = ite(int_lt(j, k), l[j], ite(j = k, x, l[int_sub(j, 1)])) proof
    fix j
    have _ _ e := apply(mp.ins_app[l := l, k := k, x := x, j := j], hl, hk, hkl, hx)
    show e
  qed
  // (an element of the new list: below k l's, at k x, above l's one before)
  have fw: (ex i. i in omega && (int_lt(i, seq_len(mp.ins_at(l, k, x))) && mp.ins_at(l, k, x)[i] = g)) ->
      ((ex i. i in omega && (int_lt(i, seq_len(l)) && l[i] = g)) || g = x) proof
    assume e
    obtain i, hi hil hig from e
    have il: int_lt(i, int_add(seq_len(l), 1)) := rewrite(dl, hil)
    have v := mp(all_elim(el, {i}), hi, il)
    have c1: int_lt(i, k) -> (ex i. i in omega && (int_lt(i, seq_len(l)) && l[i] = g)) proof
      assume h
      have v2 := trans(sym(hig), trans(v, mp(ite_t[c := int_lt(i, k), a := l[i], b := ite(i = k, x, l[int_sub(i, 1)])], h)))
      show by ex_intro({i}, taut(hi, (int_lt(i, seq_len(l)) by arith(h, hkl)), sym(v2)))
    qed
    have c2: i = k -> g = x proof
      assume h
      show := trans(sym(hig), trans(v, trans(mp(ite_f[c := int_lt(i, k), a := l[i], b := ite(i = k, x, l[int_sub(i, 1)])], (!int_lt(i, k) by arith(h))),
        mp(ite_t[c := i = k, a := x, b := l[int_sub(i, 1)]], h))))
    qed
    have c3: int_lt(k, i) -> (ex i. i in omega && (int_lt(i, seq_len(l)) && l[i] = g)) proof
      assume h
      have v2 := trans(sym(hig), trans(v, trans(mp(ite_f[c := int_lt(i, k), a := l[i], b := ite(i = k, x, l[int_sub(i, 1)])], (!int_lt(i, k) by arith(h))),
        mp(ite_f[c := i = k, a := x, b := l[int_sub(i, 1)]], (!(i = k) by arith(h))))))
      show by ex_intro({int_sub(i, 1)}, taut((int_sub(i, 1) in omega by arith(h, hk, hi)), (int_lt(int_sub(i, 1), seq_len(l)) by arith(il, lo)), sym(v2)))
    qed
    show by taut(c1, c2, c3, (int_lt(i, k) || i = k || int_lt(k, i) by arith(hi, hk)))
  qed
  // (an element of l, or x: in the new list)
  have bw: ((ex i. i in omega && (int_lt(i, seq_len(l)) && l[i] = g)) || g = x) ->
      (ex i. i in omega && (int_lt(i, seq_len(mp.ins_at(l, k, x))) && mp.ins_at(l, k, x)[i] = g)) proof
    have b1: (ex i. i in omega && (int_lt(i, seq_len(l)) && l[i] = g)) ->
        (ex i. i in omega && (int_lt(i, seq_len(mp.ins_at(l, k, x))) && mp.ins_at(l, k, x)[i] = g)) proof
      assume e
      obtain i, hi hil hig from e
      have c1: int_lt(i, k) -> (ex i. i in omega && (int_lt(i, seq_len(mp.ins_at(l, k, x))) && mp.ins_at(l, k, x)[i] = g)) proof
        assume h
        have v := mp(all_elim(el, {i}), hi, (int_lt(i, int_add(seq_len(l), 1)) by arith(hil)))
        have v2 := trans(v, trans(mp(ite_t[c := int_lt(i, k), a := l[i], b := ite(i = k, x, l[int_sub(i, 1)])], h), hig))
        show by ex_intro({i}, taut(hi, rewrite(sym(dl), (int_lt(i, int_add(seq_len(l), 1)) by arith(hil))), v2))
      qed
      have c2: int_le(k, i) -> (ex i. i in omega && (int_lt(i, seq_len(mp.ins_at(l, k, x))) && mp.ins_at(l, k, x)[i] = g)) proof
        assume h
        let j := int_add(i, 1)
        have jo: j in omega by arith(hi)
        have jl: int_lt(j, int_add(seq_len(l), 1)) by arith(hil)
        have v := mp(all_elim(el, {j}), jo, jl)
        have e1: int_sub(j, 1) = i by arith(hi)
        have v2 := trans(v, trans(mp(ite_f[c := int_lt(j, k), a := l[j], b := ite(j = k, x, l[int_sub(j, 1)])], (!int_lt(j, k) by arith(h, hi))),
          trans(mp(ite_f[c := j = k, a := x, b := l[int_sub(j, 1)]], (!(j = k) by arith(h, hi))), rewrite(sym(e1), hig, {1}))))
        show by ex_intro({j}, taut(jo, rewrite(sym(dl), jl), v2))
      qed
      show by taut(c1, c2, (int_lt(i, k) || int_le(k, i) by arith(hi, hk)))
    qed
    have b2: g = x -> (ex i. i in omega && (int_lt(i, seq_len(mp.ins_at(l, k, x))) && mp.ins_at(l, k, x)[i] = g)) proof
      assume h
      have v := mp(all_elim(el, {k}), hk, (int_lt(k, int_add(seq_len(l), 1)) by arith(hkl)))
      have v2 := trans(v, trans(mp(ite_f[c := int_lt(k, k), a := l[k], b := ite(k = k, x, l[int_sub(k, 1)])], (!int_lt(k, k) by arith(hk))),
        trans(mp(ite_t[c := k = k, a := x, b := l[int_sub(k, 1)]], refl({k})), sym(h))))
      show by ex_intro({k}, taut(hk, rewrite(sym(dl), (int_lt(k, int_add(seq_len(l), 1)) by arith(hkl))), v2))
    qed
    show by taut(b1, b2)
  qed
  show by taut(fw, bw)
qed

// ----------------------------------------------------------------------
//  The new group in the abstract state

// meta m a group: in use at place k, the taken ones T, its record V, its n
// slots unused
abbrev mp.ngrp(A, k, T, m, V, n) := fn_update(fn_update(fn_update(fn_update(A, "used", mp.ins_at(A.used, k, m)), "taken", T),
  "metas", fn_update(A.metas, m, V)), "slots", fn_update(A.slots, m, fn_build(n, i. tag(0, empty))))

// (slot i of h holding u; the group m)
abbrev mp.setu(A, h, i, u) := fn_update(A, "slots", fn_update(A.slots, h, fn_update(A.slots[h], i, u)))
abbrev mp.nest(A, h, i, m) := mp.setu(A, h, i, tag(2, m))

theorem mp.ngrp_type(A, k, T, m, V, n): A in mallocng.Abs -> k in omega -> int_le(k, seq_len(A.used)) -> T in list_type(omega) -> m in omega ->
  V in mallocng.MetaV -> n in omega ->
  abs: mp.ngrp(A, k, T, m, V, n) in mallocng.Abs && univ: mp.ngrp(A, k, T, m, V, n) in univ(1)
proof
  assume ha hk hkl ht hm hv hn
  let K := insert("secret", insert("init_done", insert("auxv_at", insert("auxv", insert("areas", insert("avail_cnt", insert("reserve", insert("reserve_cnt", insert("free_metas", insert("used", insert("metas", insert("active", insert("slots", insert("brk", insert("taken", empty)))))))))))))))
  let U := mp.ins_at(A.used, k, m)
  let MS := fn_update(A.metas, m, V)
  let SL := fn_update(A.slots, m, fn_build(n, i. tag(0, empty)))
  let A1 := fn_update(A, "used", U)
  let A2 := fn_update(A1, "taken", T)
  let A3 := fn_update(A2, "metas", MS)
  have ap af ad := (A in powerset(cart(K, univ(1))) && is_fun(A) && dom(A) = K by simp(expand(ha, mallocng.Abs)))
  have ul: A.used in list_type(omega) by simp(ha)
  have _ ut _ := apply(mp.ins_app[l := A.used, k := k, x := m, j := 0], ul, hk, hkl, hm)
  have lu := apply(mp.list_univ, omega_univ)
  have uu: U in univ(1) := mp(mp(univ_trans[u := 1, a := U, b := list_type(omega)], lu), ut)
  have tu: T in univ(1) := mp(mp(univ_trans[u := 1, a := T, b := list_type(omega)], lu), ht)
  have ms: A.metas in fn_space(omega, mallocng.MetaV) by simp(ha)
  have mss := apply(mp.space_upd[a := omega, b := mallocng.MetaV, f := A.metas, k := m, v := V], ms, hm, hv)
  have msu := mp(fn_space_univ[u := 1, a := omega, b := mallocng.MetaV, f := MS], omega_univ, mp.metav_univ, mss)
  // (n unused slots: a list of uses)
  have r0: tag(0, empty) in set_image(single(empty), x0. tag(0, x0)) by taut(set_image_def[s := single(empty), f := x0. tag(0, x0), y := tag(0, empty)],
    (ex x0. x0 in single(empty) && tag(0, x0) = tag(0, empty) by ex_intro({empty}, taut(single_intro[a := empty], refl({tag(0, empty)})))))
  have u0: tag(0, empty) in mallocng.Use by defs(simp(r0), mallocng.Use)
  have nl: fn_build(n, i. tag(0, empty)) in list_type(mallocng.Use) := apply(build_list[d := n, v := i. tag(0, empty), t := mallocng.Use], hn,
    (all i. i in n -> tag(0, empty) in mallocng.Use by simp(u0)))
  have ss: A.slots in fn_space(omega, list_type(mallocng.Use)) by simp(ha)
  have sls := apply(mp.space_upd[a := omega, b := list_type(mallocng.Use), f := A.slots, k := m, v := fn_build(n, i. tag(0, empty))], ss, hm, nl)
  have luu := mp(mp.list_univ[t := mallocng.Use], mp.use_univ)
  have slu := mp(fn_space_univ[u := 1, a := omega, b := list_type(mallocng.Use), f := SL], omega_univ, luu, sls)
  have p1 := apply(mp.pow_upd[K := K, B := univ(1), r := A, k := "used", v := U], ap, simp(), uu)
  have f1 d1 := mp(fn_update_fd[f := A, k := "used", v := U, d := K], af, ad, simp())
  have p2 := apply(mp.pow_upd[K := K, B := univ(1), r := A1, k := "taken", v := T], p1, simp(), tu)
  have f2 d2 := mp(fn_update_fd[f := A1, k := "taken", v := T, d := K], f1, d1, simp())
  have p3 := apply(mp.pow_upd[K := K, B := univ(1), r := A2, k := "metas", v := MS], p2, simp(), msu)
  have f3 d3 := mp(fn_update_fd[f := A2, k := "metas", v := MS, d := K], f2, d2, simp())
  have p4 := apply(mp.pow_upd[K := K, B := univ(1), r := A3, k := "slots", v := SL], p3, simp(), slu)
  have f4 d4 := mp(fn_update_fd[f := A3, k := "slots", v := SL, d := K], f3, d3, simp())
  have au := mp(rec_univ[u := 1, k := K, r := A], simp(x86.insert_univ), ap, af, ad)
  have a4: mp.ngrp(A, k, T, m, V, n) in mallocng.Abs by defs(simp(p4, f4, d4, ut, ht, mss, sls, uu, tu, msu, slu, au, expand(ha, mallocng.Abs)), mallocng.Abs)
  have u4 := mp(rec_univ[u := 1, k := K, r := mp.ngrp(A, k, T, m, V, n)], simp(x86.insert_univ), p4, f4, d4)
  show by taut(a4, u4)
qed

// (a slot holding a block, a group: a use)
theorem mp.use1(p): p in omega -> tag(1, p) in mallocng.Use
proof
  assume hp
  have r1: tag(1, p) in set_image(omega, x0. tag(1, x0)) by taut(set_image_def[s := omega, f := x0. tag(1, x0), y := tag(1, p)],
    (ex x0. x0 in omega && tag(1, x0) = tag(1, p) by ex_intro({p}, taut(hp, refl({tag(1, p)})))))
  show by defs(simp(r1), mallocng.Use)
qed

theorem mp.use2(m): m in omega -> tag(2, m) in mallocng.Use
proof
  assume hm
  have r2: tag(2, m) in set_image(omega, x0. tag(2, x0)) by taut(set_image_def[s := omega, f := x0. tag(2, x0), y := tag(2, m)],
    (ex x0. x0 in omega && tag(2, x0) = tag(2, m) by ex_intro({m}, taut(hm, refl({tag(2, m)})))))
  show by defs(simp(r2), mallocng.Use)
qed

theorem mp.setu_type(A, h, i, u): A in mallocng.Abs -> h in omega -> i in omega -> int_lt(i, seq_len(A.slots[h])) -> u in mallocng.Use ->
  abs: mp.setu(A, h, i, u) in mallocng.Abs && univ: mp.setu(A, h, i, u) in univ(1)
proof
  assume ha hh hi hil u2
  let K := insert("secret", insert("init_done", insert("auxv_at", insert("auxv", insert("areas", insert("avail_cnt", insert("reserve", insert("reserve_cnt", insert("free_metas", insert("used", insert("metas", insert("active", insert("slots", insert("brk", insert("taken", empty)))))))))))))))
  let X := fn_update(A.slots, h, fn_update(A.slots[h], i, u))
  have ap af ad := (A in powerset(cart(K, univ(1))) && is_fun(A) && dom(A) = K by simp(expand(ha, mallocng.Abs)))
  have slt: A.slots[h] in list_type(mallocng.Use) := mp(fn_space_app[a := omega, b := list_type(mallocng.Use), f := A.slots, x := h], simp(ha), hh)
  have {l2 = list} := apply(mp.list_upd[l := A.slots[h], t := mallocng.Use, i := i, v := u], slt, hi, hil, u2)
  have ss: A.slots in fn_space(omega, list_type(mallocng.Use)) by simp(ha)
  have xs := apply(mp.space_upd[a := omega, b := list_type(mallocng.Use), f := A.slots, k := h, v := fn_update(A.slots[h], i, u)], ss, hh, l2)
  have luu := mp(mp.list_univ[t := mallocng.Use], mp.use_univ)
  have xu := mp(fn_space_univ[u := 1, a := omega, b := list_type(mallocng.Use), f := X], omega_univ, luu, xs)
  have p2 := apply(mp.pow_upd[K := K, B := univ(1), r := A, k := "slots", v := X], ap, simp(), xu)
  have f2 d2 := mp(fn_update_fd[f := A, k := "slots", v := X, d := K], af, ad, simp())
  have au := mp(rec_univ[u := 1, k := K, r := A], simp(x86.insert_univ), ap, af, ad)
  have a2: mp.setu(A, h, i, u) in mallocng.Abs by defs(simp(p2, f2, d2, xs, au, xu, expand(ha, mallocng.Abs)), mallocng.Abs)
  have v2 := mp(rec_univ[u := 1, k := K, r := mp.setu(A, h, i, u)], simp(x86.insert_univ), p2, f2, d2)
  show by taut(a2, v2)
qed

theorem mp.nest_type(A, h, i, m): A in mallocng.Abs -> h in omega -> i in omega -> int_lt(i, seq_len(A.slots[h])) -> m in omega ->
  abs: mp.nest(A, h, i, m) in mallocng.Abs && univ: mp.nest(A, h, i, m) in univ(1)
proof
  assume ha hh hi hil hm
  show := apply(mp.setu_type[A := A, h := h, i := i, u := tag(2, m)], ha, hh, hi, hil, apply(mp.use2, hm))
qed

// (the groups in use: the old ones and m)
theorem mp.ng_used(A, k, T, m, V, n, g): A in mallocng.Abs -> k in omega -> int_le(k, seq_len(A.used)) -> m in omega ->
  (mallocng.is_used(mp.ngrp(A, k, T, m, V, n), g) <-> mallocng.is_used(A, g) || g = m)
proof
  assume ha hk hkl hm
  have ul: A.used in list_type(omega) by simp(ha)
  have e := apply(mp.ins_mem[l := A.used, k := k, x := m, g := g], ul, hk, hkl, hm)
  have eu: mp.ngrp(A, k, T, m, V, n).used = mp.ins_at(A.used, k, m) by simp()
  show by defs(simp(eu, e), mallocng.is_used)
qed

// the metas' partition: m out of the taken ones into the used ones
theorem mp.ng_part(A, k, T, m, V, n): A in mallocng.Abs -> mallocng.metas_partition(A) -> T in list_type(omega) ->
  A.taken = seq_concat(T, seq_one(m)) -> k in omega -> int_le(k, seq_len(A.used)) ->
  (all j. j in omega -> int_lt(j, k) -> int_lt(A.used[j], m)) -> (all j. j in omega -> int_le(k, j) -> int_lt(j, seq_len(A.used)) -> int_lt(m, A.used[j])) ->
  mallocng.metas_partition(mp.ngrp(A, k, T, m, V, n))
proof
  assume ha hp ht hte hk hkl hlo hhi
  let A2 := mp.ngrp(A, k, T, m, V, n)
  let U := mp.ins_at(A.used, k, m)
  have {hs = sorted, hus = used_slots, hfs = free_slots, hcv = cover, htk = taken, hfr = fresh} := expand(hp, mallocng.metas_partition)
  have ul: A.used in list_type(omega) by simp(ha)
  have tl: A.taken in list_type(omega) by simp(ha)
  have tlo: seq_len(T) in omega by arith(ht)
  have lt0: seq_len(seq_concat(T, seq_one(m))) = int_add(seq_len(T), 1) by arith(ht)
  have lt: seq_len(A.taken) = int_add(seq_len(T), 1) := rewrite(sym(hte), lt0)
  have tm: A.taken[seq_len(T)] = m := rewrite(sym(hte), at({seq_concat(T, seq_one(m))[seq_len(T)]}, ht))
  have hm: m in omega := rewrite(tm, apply(at_type[l := A.taken, t := omega, i := seq_len(T)], tl, tlo, (int_lt(seq_len(T), seq_len(A.taken)) by arith(lt))))
  have tt: all i. i in omega -> int_lt(i, seq_len(T)) -> A.taken[i] = T[i] proof
    fix i
    assume hi hil
    show := rewrite(sym(hte), at({seq_concat(T, seq_one(m))[i]}, ht, hi, hil))
  qed
  // (m: a meta slot, not used, not fresh, not free -- the last taken)
  have ms0 mnu0 mna0 mnf0 mun0 := mp(all_elim(htk, {seq_len(T)}), tlo, (int_lt(seq_len(T), seq_len(A.taken)) by arith(lt)))
  have ms := rewrite(tm, ms0)
  have mnu := rewrite(tm, mnu0)
  have mna := rewrite(tm, mna0)
  have mnf := rewrite(tm, mnf0)
  have mun := rewrite(tm, mun0)
  have iu: all g. mallocng.is_used(A2, g) <-> mallocng.is_used(A, g) || g = m proof
    fix g
    show := apply(mp.ng_used[A := A, k := k, T := T, m := m, V := V, n := n, g := g], ha, hk, hkl, hm)
  qed
  have msl: all g. mallocng.meta_slot(A2, g) <-> mallocng.meta_slot(A, g) by defs(simp(), mallocng.meta_slot)
  have avl: all g. mallocng.avail_meta(A2, g) <-> mallocng.avail_meta(A, g) by defs(simp(), mallocng.avail_meta)
  have dl _ el := apply(mp.ins_app[l := A.used, k := k, x := m, j := 0], ul, hk, hkl, hm)
  // sorted
  have s2 := apply(mp.ins_sorted[l := A.used, k := k, x := m], ul, hk, hkl, hm, hs, hlo, hhi)
  have k1: all j. j in omega -> int_lt(int_add(j, 1), seq_len(A2.used)) -> int_lt(A2.used[j], A2.used[int_add(j, 1)]) by simp(s2, dl)
  // used_slots
  have k2: all j. j in omega -> int_lt(j, seq_len(A2.used)) -> mallocng.meta_slot(A2, A2.used[j]) proof
    fix j
    assume hj hjl
    have mem := apply(mp.ins_mem[l := A.used, k := k, x := m, g := A2.used[j]], ul, hk, hkl, hm)
    have iu2: mallocng.is_used(A2, A2.used[j]) by defs(ex_intro({j}, taut(hj, hjl, refl({A2.used[j]}))), mallocng.is_used)
    have c: mallocng.is_used(A, A2.used[j]) || A2.used[j] = m by taut(all_elim(iu, {A2.used[j]}), iu2)
    have c1: mallocng.is_used(A, A2.used[j]) -> mallocng.meta_slot(A2, A2.used[j]) proof
      assume h
      obtain i, hi hil hie from expand(h, mallocng.is_used)
      have s := mp(all_elim(hus, {i}), hi, hil)
      show by taut(all_elim(msl, {A2.used[j]}), rewrite(hie, s))
    qed
    have c2: A2.used[j] = m -> mallocng.meta_slot(A2, A2.used[j]) proof
      assume h
      show by taut(all_elim(msl, {A2.used[j]}), rewrite(sym(h), ms))
    qed
    show by taut(c, c1, c2)
  qed
  // free_slots: the free ones as before, none of them m
  have k3: all j. j in omega -> int_lt(j, seq_len(A2.free_metas)) -> mallocng.meta_slot(A2, A2.free_metas[j]) && !mallocng.is_used(A2, A2.free_metas[j]) proof
    fix j
    assume hj hjl
    have jl: int_lt(j, seq_len(A.free_metas)) by simp(hjl)
    have s1 s2 := mp(all_elim(hfs, {j}), hj, jl)
    have nm := mp(all_elim(mnf, {j}), hj, jl)
    have u2: !mallocng.is_used(A2, A.free_metas[j]) by taut(all_elim(iu, {A.free_metas[j]}), s2, nm)
    have m2: mallocng.meta_slot(A2, A.free_metas[j]) by taut(all_elim(msl, {A.free_metas[j]}), s1)
    show by simp(u2, m2)
  qed
  // cover: a meta slot used, free, fresh or taken as before -- m now used
  have k4: all x0 x1. x0 in omega && x1 in omega -> int_lt(x0, seq_len(A2.areas)) && int_lt(x1, mallocng.NSLOTS) ->
      ((mallocng.is_used(A2, mallocng.meta_at(A2.areas[x0], x1)) ||
        (ex x2. x2 in omega && (int_lt(x2, seq_len(A2.free_metas)) && A2.free_metas[x2] = mallocng.meta_at(A2.areas[x0], x1)))) ||
       mallocng.avail_meta(A2, mallocng.meta_at(A2.areas[x0], x1))) ||
      (ex x2. x2 in omega && (int_lt(x2, seq_len(A2.taken)) && A2.taken[x2] = mallocng.meta_at(A2.areas[x0], x1))) proof
    fix x0 x1
    assume hx hb
    let X := mallocng.meta_at(A.areas[x0], x1)
    have hb2: int_lt(x0, seq_len(A.areas)) && int_lt(x1, mallocng.NSLOTS) by simp(hb)
    have c := mp(all_elim(hcv, {x0}, {x1}), hx, hb2)
    have du: mallocng.is_used(A, X) -> mallocng.is_used(A2, X) by taut(all_elim(iu, {X}))
    have da: mallocng.avail_meta(A, X) -> mallocng.avail_meta(A2, X) by taut(all_elim(avl, {X}))
    have dt: (ex x2. x2 in omega && (int_lt(x2, seq_len(A.taken)) && A.taken[x2] = X)) ->
        mallocng.is_used(A2, X) || (ex x2. x2 in omega && (int_lt(x2, seq_len(T)) && T[x2] = X)) proof
      assume e
      obtain i, hi hil hie from e
      have t1: int_lt(i, seq_len(T)) -> (ex x2. x2 in omega && (int_lt(x2, seq_len(T)) && T[x2] = X)) proof
        assume h
        show by ex_intro({i}, taut(hi, h, trans(sym(mp(all_elim(tt, {i}), hi, h)), hie)))
      qed
      have t2: i = seq_len(T) -> mallocng.is_used(A2, X) proof
        assume h
        have xm: X = m := trans(sym(hie), rewrite(sym(h), tm, {1}))
        show by taut(all_elim(iu, {X}), xm)
      qed
      show by taut(t1, t2, (int_lt(i, seq_len(T)) || i = seq_len(T) by arith(hi, hil, lt)))
    qed
    have r: ((mallocng.is_used(A2, X) || (ex x2. x2 in omega && (int_lt(x2, seq_len(A.free_metas)) && A.free_metas[x2] = X))) || mallocng.avail_meta(A2, X)) ||
        (ex x2. x2 in omega && (int_lt(x2, seq_len(T)) && T[x2] = X)) by taut(c, du, da, dt)
    show by simp(r)
  qed
  // taken: the ones before m, each as it was
  have k5: all i. i in omega -> int_lt(i, seq_len(A2.taken)) ->
      (((mallocng.meta_slot(A2, A2.taken[i]) && !mallocng.is_used(A2, A2.taken[i])) && !mallocng.avail_meta(A2, A2.taken[i])) &&
        (all x1. x1 in omega -> int_lt(x1, seq_len(A2.free_metas)) -> !(A2.free_metas[x1] = A2.taken[i]))) &&
      (all x1. x1 in omega -> int_lt(x1, seq_len(A2.taken)) && A2.taken[x1] = A2.taken[i] -> x1 = i) proof
    fix i
    assume hi hil
    have il: int_lt(i, seq_len(T)) by simp(hil)
    have ti := mp(all_elim(tt, {i}), hi, il)
    have il2: int_lt(i, seq_len(A.taken)) by arith(il, lt)
    have q1 q2 q3 q4 q5 := mp(all_elim(htk, {i}), hi, il2)
    have nm: !(T[i] = m) proof
      assume e
      have e2: A.taken[i] = m := trans(ti, e)
      have ii := mp(all_elim(mun, {i}), hi, taut(il2, e2))
      show by arith(ii, il)
    qed
    have a1: mallocng.meta_slot(A2, T[i]) by taut(all_elim(msl, {T[i]}), rewrite(ti, q1))
    have a2: !mallocng.is_used(A2, T[i]) by taut(all_elim(iu, {T[i]}), rewrite(ti, q2), nm)
    have a3: !mallocng.avail_meta(A2, T[i]) by taut(all_elim(avl, {T[i]}), rewrite(ti, q3))
    have a4: all x1. x1 in omega -> int_lt(x1, seq_len(A.free_metas)) -> !(A.free_metas[x1] = T[i]) := rewrite(ti, q4)
    have a5: all x1. x1 in omega -> int_lt(x1, seq_len(T)) && T[x1] = T[i] -> x1 = i proof
      fix x1
      assume h1 h2
      have x1l te := h2
      have tx := mp(all_elim(tt, {x1}), h1, x1l)
      have e3: A.taken[x1] = A.taken[i] := trans(tx, trans(te, sym(ti)))
      show := mp(all_elim(q5, {x1}), h1, taut((int_lt(x1, seq_len(A.taken)) by arith(x1l, lt)), e3))
    qed
    show by simp(a1, a2, a3, a4, a5)
  qed
  // fresh: the fresh ones not used, m not one of them
  have k6: all x0. x0 in omega -> (ord_lt(0, seq_len(A2.areas)) && int_le(int_sub(mallocng.NSLOTS, A2.avail_cnt), x0)) && int_lt(x0, mallocng.NSLOTS) ->
      !mallocng.is_used(A2, mallocng.meta_at(A2.areas[int_sub(seq_len(A2.areas), 1)], x0)) &&
      (all x1. x1 in omega -> int_lt(x1, seq_len(A2.free_metas)) -> !(A2.free_metas[x1] = mallocng.meta_at(A2.areas[int_sub(seq_len(A2.areas), 1)], x0))) proof
    fix x0
    assume hx hb
    let X := mallocng.meta_at(A.areas[int_sub(seq_len(A.areas), 1)], x0)
    have hb2: (ord_lt(0, seq_len(A.areas)) && int_le(int_sub(mallocng.NSLOTS, A.avail_cnt), x0)) && int_lt(x0, mallocng.NSLOTS) by simp(hb)
    have f1 f2 := mp(all_elim(hfr, {x0}), hx, hb2)
    have b1 b2 b3 := hb2
    have av: mallocng.avail_meta(A, X) by defs(taut(b1, (ex x2. x2 in omega && ((int_le(int_sub(mallocng.NSLOTS, A.avail_cnt), x2) && int_lt(x2, mallocng.NSLOTS)) &&
      X = mallocng.meta_at(A.areas[int_sub(seq_len(A.areas), 1)], x2)) by ex_intro({x0}, taut(hx, b2, b3, refl({X}))))), mallocng.avail_meta)
    have nm: !(X = m) proof
      assume e
      show by taut(rewrite(e, av), mna)
    qed
    have u2: !mallocng.is_used(A2, X) by taut(all_elim(iu, {X}), f1, nm)
    show by simp(u2, f2)
  qed
  show by defs(taut(k1, k2, k3, k4, k5, k6), mallocng.metas_partition)
qed

// the state normalized where memory says nothing: the metas not in use as
// before (m now in use, not 0)
theorem mp.ng_normal(A, k, T, m, V, n): A in mallocng.Abs -> mallocng.normal(A) -> k in omega -> int_le(k, seq_len(A.used)) -> m in omega -> !(m = 0) ->
  mallocng.normal(mp.ngrp(A, k, T, m, V, n))
proof
  assume ha hn hk hkl hm hmz
  let A2 := mp.ngrp(A, k, T, m, V, n)
  have {nu = unused, ni = init, nr = reserve, nz = zero} := expand(hn, mallocng.normal)
  have iu: all g. mallocng.is_used(A2, g) <-> mallocng.is_used(A, g) || g = m proof
    fix g
    show := apply(mp.ng_used[A := A, k := k, T := T, m := m, V := V, n := n, g := g], ha, hk, hkl, hm)
  qed
  have k1: all x0. x0 in omega -> !mallocng.is_used(A2, x0) -> A2.metas[x0] = mallocng.ZERO_META && seq_len(A2.slots[x0]) = 0 proof
    fix x0
    assume hx hnu
    have nu0: !mallocng.is_used(A, x0) by taut(all_elim(iu, {x0}), hnu)
    have nm: !(x0 = m) by taut(all_elim(iu, {x0}), hnu)
    have z1 z2 := mp(all_elim(nu, {x0}), hx, nu0)
    have e1 := mp(app_update_other[f := A.metas, k := m, v := V, x := x0], nm)
    have e2 := mp(app_update_other[f := A.slots, k := m, v := fn_build(n, i. tag(0, empty)), x := x0], nm)
    show by simp(z1, z2, e1, e2)
  qed
  have k4: !mallocng.is_used(A2, 0) by taut(all_elim(iu, {0}), nz, (!(0 = m) by arith(hmz)))
  show by defs(simp(k1, ni, nr, k4, keep(mallocng.is_used, mallocng.ZERO_META)), mallocng.normal)
qed

// (a use in a slot of a group in use: there still)
theorem mp.ng_at(A, k, T, m, V, n, u): A in mallocng.Abs -> k in omega -> int_le(k, seq_len(A.used)) -> m in omega -> !mallocng.is_used(A, m) ->
  (ex x0. ex x1. (x0 in omega && x1 in omega) && ((int_lt(x0, seq_len(A.used)) && int_lt(x1, seq_len(A.slots[A.used[x0]]))) && A.slots[A.used[x0]][x1] = u)) ->
  (ex x0. ex x1. (x0 in omega && x1 in omega) && ((int_lt(x0, seq_len(mp.ngrp(A, k, T, m, V, n).used)) &&
     int_lt(x1, seq_len(mp.ngrp(A, k, T, m, V, n).slots[mp.ngrp(A, k, T, m, V, n).used[x0]]))) && mp.ngrp(A, k, T, m, V, n).slots[mp.ngrp(A, k, T, m, V, n).used[x0]][x1] = u))
proof
  assume ha hk hkl hm nm e
  let A2 := mp.ngrp(A, k, T, m, V, n)
  obtain j i, hj hi hjl hil hs from e
  let p := A.used[j]
  have ip: mallocng.is_used(A, p) by defs(ex_intro({j}, taut(hj, hjl, refl({p}))), mallocng.is_used)
  have ip2: mallocng.is_used(A2, p) by taut(apply(mp.ng_used[A := A, k := k, T := T, m := m, V := V, n := n, g := p], ha, hk, hkl, hm), ip)
  obtain j2, hj2 hjl2 hje from expand(ip2, mallocng.is_used)
  have pm: !(p = m) proof
    assume e2
    show by taut(rewrite(e2, ip), nm)
  qed
  have sp: A2.slots[p] = A.slots[p] by simp(mp(app_update_other[f := A.slots, k := m, v := fn_build(n, i. tag(0, empty)), x := p], pm))
  have il2: int_lt(i, seq_len(A2.slots[p])) := rewrite(sym(sp), hil)
  have s2: A2.slots[p][i] = u := rewrite(sym(sp), hs)
  show by ex_intro({j2}, {i}, taut(hj2, hi, hjl2, rewrite(sym(hje), il2), rewrite(sym(hje), s2)))
qed

// (a slot's use in a state keeping g's record and the groups in use with
// theirs: as before)
theorem mp.slot_tr(A, A2, M, b, g, j, u): u in mallocng.Use -> A2.metas[g] = A.metas[g] ->
  (all h. mallocng.is_used(A, h) -> mallocng.is_used(A2, h) && A2.metas[h] = A.metas[h]) ->
  mallocng.slot_ok(A, M, b, g, j, u) -> mallocng.slot_ok(A2, M, b, g, j, u)
proof
  assume ut emg emu so
  have c0: u = tag(0, empty) -> mallocng.slot_ok(A2, M, b, g, j, u) proof
    assume e
    show by defs(simp(e), mallocng.slot_ok)
  qed
  have c1: !(u = tag(0, empty)) -> fst(u) = 1 -> mallocng.slot_ok(A2, M, b, g, j, u) proof
    assume e0 e1
    let P := snd(u)
    have ue: u = tag(1, P) by simp(apply(mp.use_eta, ut), e1)
    have s0: !(b[bits_of_int(64, P)] = none) && mallocng.hdr_free(b, P) && mallocng.frame_ok(M, A.metas[g], j, P, snd(b[bits_of_int(64, P)]), 0)
      by simp(expand(rewrite(ue, so), mallocng.slot_ok))
    show by defs(simp(e0, e1, emg, s0), mallocng.slot_ok)
  qed
  have c2: !(u = tag(0, empty)) -> fst(u) = 2 -> mallocng.slot_ok(A2, M, b, g, j, u) proof
    assume e0 e2
    have s0: ((mallocng.is_used(A, snd(u)) && A.metas[snd(u)].maplen = 0) && mallocng.hdr_free(b, A.metas[snd(u)].mem)) &&
        mallocng.frame_ok(M, A.metas[g], j, A.metas[snd(u)].mem, int_sub(int_add(mallocng.UNIT, int_mul(mallocng.stride(A.metas[snd(u)]), int_add(A.metas[snd(u)].last_idx, 1))), mallocng.IB), 6)
      by simp(expand(rewrite((u = tag(2, snd(u)) by simp(apply(mp.use_eta, ut), e2)), so), mallocng.slot_ok))
    have iw _ _ _ := s0
    have iw2 emw := mp(all_elim(emu, {snd(u)}), iw)
    show by defs(simp(e0, e2, emg, emw, iw2, s0), mallocng.slot_ok)
  qed
  have c3: !(u = tag(0, empty)) -> !(fst(u) = 1) -> !(fst(u) = 2) -> mallocng.slot_ok(A2, M, b, g, j, u) proof
    assume e0 e1 e2
    show by defs(simp(e0, e1, e2), mallocng.slot_ok)
  qed
  show by taut(c0, c1, c2, c3)
qed

// a group in use before: as it was (its record and slots kept, the groups
// nested in it still in use)
theorem mp.ng_group(A, k, T, m, V, n, M, b, h): A in mallocng.Abs -> k in omega -> int_le(k, seq_len(A.used)) -> m in omega ->
  !mallocng.is_used(A, m) -> mallocng.is_used(A, h) -> mallocng.group_ok(A, M, b, h) ->
  mallocng.group_ok(mp.ngrp(A, k, T, m, V, n), M, b, h)
proof
  assume ha hk hkl hm nm iu gok
  let A2 := mp.ngrp(A, k, T, m, V, n)
  have iu2: all g. mallocng.is_used(A2, g) <-> mallocng.is_used(A, g) || g = m proof
    fix g
    show := apply(mp.ng_used[A := A, k := k, T := T, m := m, V := V, n := n, g := g], ha, hk, hkl, hm)
  qed
  // (a group in use: not m, its record and slots as before)
  have ne: all g. mallocng.is_used(A, g) -> !(g = m) proof
    fix g
    assume h1
    have r: !(g = m) proof
      assume e
      show by taut(rewrite(e, h1), nm)
    qed
    show r
  qed
  have em: all g. mallocng.is_used(A, g) -> A2.metas[g] = A.metas[g] proof
    fix g
    assume h1
    show by simp(mp(app_update_other[f := A.metas, k := m, v := V, x := g], mp(all_elim(ne, {g}), h1)))
  qed
  have es: all g. mallocng.is_used(A, g) -> A2.slots[g] = A.slots[g] proof
    fix g
    assume h1
    show by simp(mp(app_update_other[f := A.slots, k := m, v := fn_build(n, i. tag(0, empty)), x := g], mp(all_elim(ne, {g}), h1)))
  qed
  have ea: A2.active = A.active by simp()
  have emh := mp(all_elim(em, {h}), iu)
  have esh := mp(all_elim(es, {h}), iu)
  have emu: all g. mallocng.is_used(A, g) -> mallocng.is_used(A2, g) && A2.metas[g] = A.metas[g] proof
    fix g
    assume h1
    show by taut(all_elim(iu2, {g}), h1, mp(all_elim(em, {g}), h1))
  qed
  have {nested, slots} := expand(gok, mallocng.group_ok)
  have {mim, cls, hdr, hdr_own, act, nslots, masks, small, mapped, big, linked, unlinked, sentinel, chk_own, offs, span} :=
    rewrite(sym(ea), rewrite(sym(esh), rewrite(sym(emh), expand(gok, mallocng.group_ok))))
  have msk2: mallocng.masks_ok(A2, M, h) by defs(rewrite(sym(esh), rewrite(sym(emh), expand(masks, mallocng.masks_ok))), mallocng.masks_ok)
  have big2: mallocng.big_ok(A2, h) by defs(rewrite(sym(emh), expand(big, mallocng.big_ok)), mallocng.big_ok)
  // nested: in a slot of a group still in use
  have ne2: A2.metas[h].maplen = 0 -> (ex x0. ex x1. (x0 in omega && x1 in omega) &&
      ((int_lt(x0, seq_len(A2.used)) && int_lt(x1, seq_len(A2.slots[A2.used[x0]]))) && A2.slots[A2.used[x0]][x1] = tag(2, h))) proof
    assume z
    show := apply(mp.ng_at[A := A, k := k, T := T, m := m, V := V, n := n, u := tag(2, h)], ha, hk, hkl, hm, nm, mp(nested, rewrite(emh, z)))
  qed
  // the slots: each as before (a nested group's record kept)
  have sl2: all x0. x0 in omega -> int_lt(x0, seq_len(A2.slots[h])) -> mallocng.slot_ok(A2, M, b, h, x0, A2.slots[h][x0]) proof
    fix i
    assume hi hil0
    have hil: int_lt(i, seq_len(A.slots[h])) := rewrite(esh, hil0)
    let u := A.slots[h][i]
    have so := mp(all_elim(slots, {i}), hi, hil)
    have {ho = nat} := apply(mp.used_nat, ha, iu)
    have slt: A.slots[h] in list_type(mallocng.Use) := mp(fn_space_app[a := omega, b := list_type(mallocng.Use), f := A.slots, x := h], simp(ha), ho)
    have ut := apply(at_type[l := A.slots[h], t := mallocng.Use, i := i], slt, hi, hil)
    show := rewrite(sym(esh), apply(mp.slot_tr[A := A, A2 := A2, M := M, b := b, g := h, j := i, u := u], ut, emh, emu, so))
  qed
  show by defs(taut(mim, cls, hdr, hdr_own, act, nslots, msk2, small, mapped, ne2, big2, linked, unlinked, sl2, sentinel, chk_own, offs, span), mallocng.group_ok)
qed

// the groups in use: the old ones', m's group
theorem mp.ng_used_ok(A, k, T, m, V, n, M, b): A in mallocng.Abs -> k in omega -> int_le(k, seq_len(A.used)) -> m in omega ->
  (all h. mallocng.is_used(A, h) -> mallocng.group_ok(mp.ngrp(A, k, T, m, V, n), M, b, h)) -> mallocng.group_ok(mp.ngrp(A, k, T, m, V, n), M, b, m) ->
  mallocng.used_ok(mp.ngrp(A, k, T, m, V, n), M, b)
proof
  assume ha hk hkl hm go gm
  let A2 := mp.ngrp(A, k, T, m, V, n)
  have r: all x0. x0 in omega -> int_lt(x0, seq_len(A2.used)) -> mallocng.group_ok(A2, M, b, A2.used[x0]) proof
    fix j
    assume hj hjl
    let g := A2.used[j]
    have ig: mallocng.is_used(A2, g) by defs(ex_intro({j}, taut(hj, hjl, refl({g}))), mallocng.is_used)
    have c: mallocng.is_used(A, g) || g = m by taut(apply(mp.ng_used[A := A, k := k, T := T, m := m, V := V, n := n, g := g], ha, hk, hkl, hm), ig)
    have c1: mallocng.is_used(A, g) -> mallocng.group_ok(A2, M, b, g) by taut(all_elim(go, {g}))
    have c2: g = m -> mallocng.group_ok(A2, M, b, g) proof
      assume e
      show := rewrite(sym(e), gm)
    qed
    show by taut(c, c1, c2)
  qed
  show by defs(r, mallocng.used_ok)
qed

// ----------------------------------------------------------------------
//  The new group's own clauses

// (the bits from a below b)
theorem mp.bit_range(a, b, i): a in omega -> b in omega -> int_le(a, b) -> i in omega ->
  (bit(int_sub(pow2(b), pow2(a)), i) <-> int_le(a, i) && int_lt(i, b))
proof
  assume ha hb hab hi
  let d := int_sub(b, a)
  have do: d in omega by arith(hab, ha, hb)
  have sp := apply(pow2_split[a := a, b := b], ha, hb, hab)
  have pd := mp(pow2_pos[k := d], do)
  have e: int_sub(pow2(b), pow2(a)) = int_mul(int_sub(pow2(d), 1), pow2(a)) by arith(sp)
  have bm := apply(bit_mul[x := int_sub(pow2(d), 1), k := a, i := i], (int_sub(pow2(d), 1) in omega by arith(pd)), ha, hi)
  have c1: int_le(a, i) -> (bit(int_sub(pow2(d), 1), int_sub(i, a)) <-> int_lt(i, b)) proof
    assume h
    have k := apply(bit_mask[k := d, i := int_sub(i, a)], do, (int_sub(i, a) in omega by arith(h, hi, ha)))
    show by taut(k, (int_lt(int_sub(i, a), d) <-> int_lt(i, b) by arith(h)))
  qed
  show by taut(rewrite(sym(e), bm), c1)
qed

// a group made with its slots up to the active index x available, the
// others freed, all unused, their check bytes 0: its masks
theorem mp.ng_masks(A2, M, m, n): A2.slots[m] = fn_build(n, i. tag(0, empty)) -> n = int_add(A2.metas[m].last_idx, 1) -> A2.metas[m].last_idx in omega ->
  int_le(int_mod(mallocng.b8(M, int_add(A2.metas[m].mem, 8)), 32), A2.metas[m].last_idx) ->
  A2.metas[m].avail = int_sub(pow2(int_add(int_mod(mallocng.b8(M, int_add(A2.metas[m].mem, 8)), 32), 1)), 1) ->
  A2.metas[m].freed = int_sub(pow2(int_add(A2.metas[m].last_idx, 1)), pow2(int_add(int_mod(mallocng.b8(M, int_add(A2.metas[m].mem, 8)), 32), 1))) ->
  (all i. i in omega -> int_le(i, A2.metas[m].last_idx) -> mallocng.b8(M, int_sub(mallocng.slot_start(A2.metas[m], i), 4)) = 0) ->
  mallocng.masks_ok(A2, M, m)
proof
  assume es en hl hx eav efr chk
  let W := A2.metas[m]
  let X := int_mod(mallocng.b8(M, int_add(W.mem, 8)), 32)
  let L := W.last_idx
  have xo: X in omega by arith(hx, hl)
  have no: n in omega by arith(en, hl)
  have r: all x0. x0 in omega -> int_lt(x0, 32) ->
      (((mallocng.bit(W.avail, x0) = 1 -> int_le(x0, X) && mallocng.bit(W.freed, x0) = 0) &&
        (int_lt(0, int_add(mallocng.bit(W.avail, x0), mallocng.bit(W.freed, x0))) -> int_le(x0, L))) &&
       (int_le(x0, L) -> (A2.slots[m][x0] = tag(0, empty) <-> int_lt(0, int_add(mallocng.bit(W.avail, x0), mallocng.bit(W.freed, x0)))) &&
          mallocng.b8(M, int_sub(mallocng.slot_start(W, x0), 4)) = 0)) &&
      (int_lt(X, x0) && int_le(x0, L) -> mallocng.bit(W.freed, x0) = 1) proof
    fix i
    assume hi hil
    have ba := rewrite(sym(eav), apply(bit_mask[k := int_add(X, 1), i := i], (int_add(X, 1) in omega by arith(xo)), hi))
    have bf := rewrite(sym(efr), apply(mp.bit_range[a := int_add(X, 1), b := int_add(L, 1), i := i], (int_add(X, 1) in omega by arith(xo)),
      (int_add(L, 1) in omega by arith(hl)), (int_le(int_add(X, 1), int_add(L, 1)) by arith(hx)), hi))
    have na := apply(mp.nbit[x := W.avail, i := i], rewrite(sym(eav), (int_sub(pow2(int_add(X, 1)), 1) in omega by arith(mp(pow2_pos[k := int_add(X, 1)], (int_add(X, 1) in omega by arith(xo)))))), hi)
    have nf := apply(mp.nbit[x := W.freed, i := i], rewrite(sym(efr), (int_sub(pow2(int_add(L, 1)), pow2(int_add(X, 1))) in omega by
      arith(apply(pow2_le[a := int_add(X, 1), b := int_add(L, 1)], (int_add(X, 1) in omega by arith(xo)), (int_add(L, 1) in omega by arith(hl)), (int_le(int_add(X, 1), int_add(L, 1)) by arith(hx)))))), hi)
    have su: int_le(i, L) -> A2.slots[m][i] = tag(0, empty) proof
      assume h
      have id := mp(nat_lt_mem[k := i, n := n], hi, no, (int_lt(i, n) by arith(en, h)))
      show := rewrite(sym(es), mp(app_fn_build[d := n, v := i. tag(0, empty), a := i], id))
    qed
    have c1: int_lt(i, int_add(X, 1)) -> (mallocng.bit(W.avail, i) = 1 && mallocng.bit(W.freed, i) = 0) && int_lt(0, int_add(mallocng.bit(W.avail, i), mallocng.bit(W.freed, i))) proof
      assume h
      show by simp(na, nf, ba, bf, h)
    qed
    have c2: int_le(int_add(X, 1), i) -> int_lt(i, int_add(L, 1)) -> (mallocng.bit(W.avail, i) = 0 && mallocng.bit(W.freed, i) = 1) && int_lt(0, int_add(mallocng.bit(W.avail, i), mallocng.bit(W.freed, i))) proof
      assume h1 h2
      show by simp(na, nf, ba, bf, h1, h2, (!int_lt(i, int_add(X, 1)) by arith(h1)))
    qed
    have c3: int_le(int_add(L, 1), i) -> (mallocng.bit(W.avail, i) = 0 && mallocng.bit(W.freed, i) = 0) && !int_lt(0, int_add(mallocng.bit(W.avail, i), mallocng.bit(W.freed, i))) proof
      assume h
      show by simp(na, nf, ba, bf, (!int_lt(i, int_add(X, 1)) by arith(h, hx)), (!int_lt(i, int_add(L, 1)) by arith(h)))
    qed
    have k1: int_lt(i, int_add(X, 1)) -> int_le(i, L) by arith(hx)
    show by taut(c1, c2, c3, k1, su, mp(all_elim(chk, {i}), hi), (int_lt(i, int_add(X, 1)) || int_le(int_add(X, 1), i) && int_lt(i, int_add(L, 1)) || int_le(int_add(L, 1), i) by arith(hi, xo)),
      (int_lt(X, i) <-> int_le(int_add(X, 1), i) by arith(hi, xo)), (int_le(i, L) <-> int_lt(i, int_add(L, 1)) by arith(hi, hl)),
      (int_lt(i, int_add(X, 1)) -> int_le(i, X) by arith(hi, xo)), (int_le(int_add(X, 1), i) <-> !int_lt(i, int_add(X, 1)) by arith(hi, xo)),
      (int_le(int_add(L, 1), i) <-> !int_lt(i, int_add(L, 1)) by arith(hi, hl)), (mallocng.bit(W.avail, i) = 0 -> !(mallocng.bit(W.avail, i) = 1) by simp()))
  qed
  show by defs(r, mallocng.masks_ok)
qed

// the group made: its record in memory, its header pointing back, the
// masks as made, its slots unused (their check bytes and the end 0), on no
// list; mapped on its own or nested
theorem mp.ng_self(A2, M, b, m, n): A2.slots[m] = fn_build(n, i. tag(0, empty)) -> n = int_add(A2.metas[m].last_idx, 1) -> A2.metas[m].last_idx in omega ->
  mallocng.meta_in_memory(M, m, A2.metas[m]) -> int_lt(A2.metas[m].sizeclass, 48) ->
  hdr: ((mallocng.rd(M, A2.metas[m].mem, 8) = m && int_mod(A2.metas[m].mem, mallocng.UNIT) = 0) && int_lt(0, A2.metas[m].mem)) ->
  hdr_own: (all a. a in omega -> int_le(A2.metas[m].mem, a) && int_lt(a, int_add(A2.metas[m].mem, mallocng.UNIT)) -> !(a in malloc.live_of(b))) ->
  act: int_le(int_mod(mallocng.b8(M, int_add(A2.metas[m].mem, 8)), 32), A2.metas[m].last_idx) ->
  A2.metas[m].avail = int_sub(pow2(int_add(int_mod(mallocng.b8(M, int_add(A2.metas[m].mem, 8)), 32), 1)), 1) ->
  A2.metas[m].freed = int_sub(pow2(int_add(A2.metas[m].last_idx, 1)), pow2(int_add(int_mod(mallocng.b8(M, int_add(A2.metas[m].mem, 8)), 32), 1))) ->
  small: (mallocng.stride(A2.metas[m]) = mallocng.UNIT -> int_mod(mallocng.b8(M, int_add(A2.metas[m].mem, 8)), 32) = A2.metas[m].last_idx) ->
  mapped: (int_lt(0, A2.metas[m].maplen) -> int_mod(A2.metas[m].mem, 4096) = 0 &&
     int_le(int_add(mallocng.UNIT, int_mul(mallocng.stride(A2.metas[m]), int_add(A2.metas[m].last_idx, 1))), int_mul(A2.metas[m].maplen, 4096))) ->
  nested: (A2.metas[m].maplen = 0 -> (ex x0. ex x1. (x0 in omega && x1 in omega) &&
     ((int_lt(x0, seq_len(A2.used)) && int_lt(x1, seq_len(A2.slots[A2.used[x0]]))) && A2.slots[A2.used[x0]][x1] = tag(2, m)))) ->
  A2.metas[m].next = 0 -> A2.metas[m].prev = 0 ->
  (all j. j in omega -> int_lt(j, seq_len(A2.active[A2.metas[m].sizeclass])) -> !(A2.active[A2.metas[m].sizeclass][j] = m)) ->
  (all i. i in omega -> int_le(i, A2.metas[m].last_idx) -> mallocng.b8(M, int_sub(mallocng.slot_start(A2.metas[m], i), 4)) = 0) ->
  sentinel: mallocng.b8(M, mallocng.slot_end(A2.metas[m], A2.metas[m].last_idx)) = 0 ->
  chk_own: (all i. i in omega -> int_le(i, int_add(A2.metas[m].last_idx, 1)) -> !(int_sub(mallocng.slot_start(A2.metas[m], i), mallocng.IB) in malloc.live_of(b))) ->
  offs: (int_lt(0, A2.metas[m].last_idx) -> int_le(int_mul(mallocng.stride(A2.metas[m]), int_add(A2.metas[m].last_idx, 1)), int_mul(int_pow(2, 16), mallocng.UNIT))) ->
  span: int_lt(mallocng.stride(A2.metas[m]), int_mul(2, int_mul(mallocng.UNIT, mallocng.size_classes[A2.metas[m].sizeclass]))) ->
  mallocng.group_ok(A2, M, b, m)
proof
  assume es en hl mim cls hdr hown act eav efr small mapped nested enx epv nol chk sent chko offs span
  let W := A2.metas[m]
  have msk := apply(mp.ng_masks[A2 := A2, M := M, m := m, n := n], es, en, hl, act, eav, efr, chk)
  have no: n in omega by arith(en, hl)
  have dn: seq_len(A2.slots[m]) = n by defs(rewrite(sym(es), fn_build_dom[d := n, v := i. tag(0, empty)]), seq_len)
  have ns: seq_len(A2.slots[m]) = int_add(W.last_idx, 1) := trans(dn, en)
  have n63: !(W.sizeclass = 63) proof
    assume e
    show by arith(rewrite(e, cls))
  qed
  have big: mallocng.big_ok(A2, m) by defs(taut(n63), mallocng.big_ok)
  have lk: !(W.next = 0) <-> int_lt(W.sizeclass, 48) && (ex x0. x0 in omega && (int_lt(x0, seq_len(A2.active[W.sizeclass])) && A2.active[W.sizeclass][x0] = m)) proof
    have n1: !(ex x0. x0 in omega && (int_lt(x0, seq_len(A2.active[W.sizeclass])) && A2.active[W.sizeclass][x0] = m)) proof
      assume e
      obtain j, hj hjl hje from e
      show by taut(mp(all_elim(nol, {j}), hj, hjl), hje)
    qed
    show by taut(enx, n1)
  qed
  have ul: W.next = 0 -> W.prev = 0 by taut(epv)
  have sl: all x0. x0 in omega -> int_lt(x0, seq_len(A2.slots[m])) -> mallocng.slot_ok(A2, M, b, m, x0, A2.slots[m][x0]) proof
    fix i
    assume hi hil
    have id := mp(nat_lt_mem[k := i, n := n], hi, no, rewrite(dn, hil))
    have e := rewrite(sym(es), mp(app_fn_build[d := n, v := i. tag(0, empty), a := i], id))
    show by defs(simp(e), mallocng.slot_ok)
  qed
  have cl: int_lt(W.sizeclass, 48) || W.sizeclass = 63 by taut(cls)
  have sp: int_lt(W.sizeclass, 48) -> int_lt(mallocng.stride(W), int_mul(2, int_mul(mallocng.UNIT, mallocng.size_classes[W.sizeclass]))) by taut(span)
  show by defs(taut(mim, cl, hdr, hown, act, ns, msk, small, mapped, nested, big, lk, ul, sl, sent, chko, offs, sp), mallocng.group_ok)
qed

// ----------------------------------------------------------------------
//  The rest of the invariant

// the active lists as before (m on none: they hold groups in use), the
// live blocks in the slots as before
theorem mp.ng_lists(A, k, T, m, V, n, M, b): A in mallocng.Abs -> k in omega -> int_le(k, seq_len(A.used)) -> m in omega -> !mallocng.is_used(A, m) ->
  mallocng.active_ok(A) -> mallocng.partial_ok(A, M) -> mallocng.reuse_ok(A) -> mallocng.blocks_ok(A, b) ->
  active: mallocng.active_ok(mp.ngrp(A, k, T, m, V, n)) && partial: mallocng.partial_ok(mp.ngrp(A, k, T, m, V, n), M) &&
  reuse: mallocng.reuse_ok(mp.ngrp(A, k, T, m, V, n)) && in_slots: mallocng.blocks_ok(mp.ngrp(A, k, T, m, V, n), b)
proof
  assume ha hk hkl hm nm hac hpa hre hbl
  let A2 := mp.ngrp(A, k, T, m, V, n)
  have ea: A2.active = A.active by simp()
  have em: all g. mallocng.is_used(A, g) -> A2.metas[g] = A.metas[g] && A2.slots[g] = A.slots[g] proof
    fix g
    assume h1
    have gm: !(g = m) proof
      assume e
      show by taut(rewrite(e, h1), nm)
    qed
    have e1: A2.metas[g] = A.metas[g] by simp(mp(app_update_other[f := A.metas, k := m, v := V, x := g], gm))
    have e2: A2.slots[g] = A.slots[g] by simp(mp(app_update_other[f := A.slots, k := m, v := fn_build(n, i. tag(0, empty)), x := g], gm))
    show by taut(e1, e2)
  qed
  // (a group on a list: in use)
  have ol: all sc. all g. sc in omega -> int_lt(sc, 48) -> mallocng.on_list(A.active[sc], g) -> mallocng.is_used(A, g) proof
    fix sc g
    assume hs hsl o
    obtain j, hj hjl hje from expand(o, mallocng.on_list)
    have iu _ _ := mp(all_elim(expand(hac, mallocng.active_ok), {sc}, {j}), conj(hs, hj), conj(hsl, hjl))
    show := rewrite(hje, iu)
  qed
  have a2: all x0. all x1. x0 in omega && x1 in omega -> int_lt(x0, 48) && int_lt(x1, seq_len(A2.active[x0])) ->
      (mallocng.is_used(A2, A2.active[x0][x1]) && A2.metas[A2.active[x0][x1]].sizeclass = x0) &&
      (int_lt(0, x1) -> A2.metas[A2.active[x0][x1]].avail = 0 && !(A2.metas[A2.active[x0][x1]].freed = 0)) proof
    fix sc j
    assume ho h
    have hs hj := ho
    have hsl hjl0 := h
    have hjl: int_lt(j, seq_len(A.active[sc])) := rewrite(ea, hjl0)
    have q := mp(all_elim(expand(hac, mallocng.active_ok), {sc}, {j}), ho, conj(hsl, hjl))
    have iu _ _ := q
    let g := A.active[sc][j]
    have e1 _ := mp(all_elim(em, {g}), iu)
    have iu2: mallocng.is_used(A2, g) by taut(apply(mp.ng_used[A := A, k := k, T := T, m := m, V := V, n := n, g := g], ha, hk, hkl, hm), iu)
    have q2 := rewrite(sym(e1), q)
    have r: (mallocng.is_used(A2, g) && A2.metas[g].sizeclass = sc) && (int_lt(0, j) -> A2.metas[g].avail = 0 && !(A2.metas[g].freed = 0)) by taut(q2, iu2)
    show := rewrite(sym(ea), r)
  qed
  have pe: all sc. all g. sc in omega -> int_lt(sc, 48) -> mallocng.on_list(A.active[sc], g) ->
      (mallocng.partial(M, A2, g) <-> mallocng.partial(M, A, g)) && (mallocng.has_unused(A2, g) <-> mallocng.has_unused(A, g)) && A2.metas[g] = A.metas[g] proof
    fix sc g
    assume hs hsl o
    have e1 e2 := mp(all_elim(em, {g}), mp(all_elim(ol, {sc}, {g}), hs, hsl, o))
    have p1: mallocng.partial(M, A2, g) <-> mallocng.partial(M, A, g) by defs(simp(e1), mallocng.partial)
    have p2: mallocng.has_unused(A2, g) <-> mallocng.has_unused(A, g) by defs(simp(e2), mallocng.has_unused)
    show by taut(p1, p2, e1)
  qed
  have p1 p2 := expand(hpa, mallocng.partial_ok)
  have k1: all x0. all x1. all x2. (x0 in omega && x1 in omega) && x2 in omega -> (((int_lt(x0, 48) && mallocng.on_list(A2.active[x0], x1)) &&
      mallocng.on_list(A2.active[x0], x2)) && mallocng.partial(M, A2, x1)) && mallocng.partial(M, A2, x2) -> x1 = x2 proof
    fix sc g g2
    assume ho h
    have hs _ _ := ho
    have hsl o1 o2 q1 q2 := h
    have o1a := rewrite(ea, o1)
    have o2a := rewrite(ea, o2)
    have r1 _ _ := mp(all_elim(pe, {sc}, {g}), hs, hsl, o1a)
    have r2 _ _ := mp(all_elim(pe, {sc}, {g2}), hs, hsl, o2a)
    show := mp(all_elim(p1, {sc}, {g}, {g2}), ho, taut(hsl, o1a, o2a, r1, r2, q1, q2))
  qed
  have k2: all x0. all x1. x0 in omega && x1 in omega -> (int_lt(x0, 48) && mallocng.on_list(A2.active[x0], x1)) && mallocng.partial(M, A2, x1) ->
      int_lt(4096, int_add(mallocng.UNIT, int_mul(mallocng.stride(A2.metas[x1]), int_add(A2.metas[x1].last_idx, 1)))) proof
    fix sc g
    assume ho h
    have hs _ := ho
    have hsl o q := h
    have oa := rewrite(ea, o)
    have r _ e := mp(all_elim(pe, {sc}, {g}), hs, hsl, oa)
    show := rewrite(sym(e), mp(all_elim(p2, {sc}, {g}), ho, taut(hsl, oa, r, q)))
  qed
  have k3: all x0. all x1. x0 in omega && x1 in omega -> (int_lt(x0, 48) && mallocng.on_list(A2.active[x0], x1)) && mallocng.has_unused(A2, x1) ->
      !mallocng.own_mapping(A2.metas[x1]) proof
    fix sc g
    assume ho h
    have hs _ := ho
    have hsl o q := h
    have oa := rewrite(ea, o)
    have _ r e := mp(all_elim(pe, {sc}, {g}), hs, hsl, oa)
    show := rewrite(sym(e), mp(all_elim(expand(hre, mallocng.reuse_ok), {sc}, {g}), ho, taut(hsl, oa, r, q)))
  qed
  have k4: all x0. x0 in bits(64) -> !(b[x0] = none) -> (ex x1. ex x2. (x1 in omega && x2 in omega) &&
      ((int_lt(x1, seq_len(A2.used)) && int_lt(x2, seq_len(A2.slots[A2.used[x1]]))) && A2.slots[A2.used[x1]][x2] = tag(1, x0))) proof
    fix p
    assume hp hn
    show := apply(mp.ng_at[A := A, k := k, T := T, m := m, V := V, n := n, u := tag(1, p)], ha, hk, hkl, hm, nm,
      mp(all_elim(expand(hbl, mallocng.blocks_ok), {p}), hp, hn))
  qed
  have ac2: mallocng.active_ok(A2) by defs(a2, mallocng.active_ok)
  have pa2: mallocng.partial_ok(A2, M) by defs(taut(k1, k2), mallocng.partial_ok)
  have re2: mallocng.reuse_ok(A2) by defs(k3, mallocng.reuse_ok)
  have bl2: mallocng.blocks_ok(A2, b) by defs(k4, mallocng.blocks_ok)
  show by taut(ac2, pa2, re2, bl2)
qed

// (the regions before the groups': the data's, the image's, the areas',
// the reserve)
abbrev mp.reg_pre(c, A) := seq_concat(seq_concat(seq_concat(mallocng.data_ranges(c), mallocng.ro_ranges(c.file)),
  fn_build(int_sub(seq_len(A.areas), 0), x0. pair(A.areas[int_add(0, x0)], 4096))), seq_one(pair(A.reserve, int_mul(4096, A.reserve_cnt))))
abbrev mp.reg_q(c, A) := int_add(int_add(int_add(3, x86_64_linux.phnum(c.file)), seq_len(A.areas)), 1)

theorem mp.reg_front(c, A, i): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> i in omega ->
  pre: (int_lt(i, mp.reg_q(c, A)) -> mallocng.regions(c, A)[i] = mp.reg_pre(c, A)[i]) &&
  len: seq_len(mallocng.regions(c, A)) = int_add(mp.reg_q(c, A), seq_len(A.used))
proof
  assume hc hu ha hi
  let F := c.file
  let RO := mallocng.ro_ranges(F)
  let AR := fn_build(int_sub(seq_len(A.areas), 0), x0. pair(A.areas[int_add(0, x0)], 4096))
  let GR := fn_build(int_sub(seq_len(A.used), 0), x0. ite(int_lt(0, A.metas[A.used[int_add(0, x0)]].maplen), mallocng.group_range(A.metas[A.used[int_add(0, x0)]]), pair(0, 0)))
  let DR := mallocng.data_ranges(c)
  let P := mp.reg_pre(c, A)
  have fs: F in seq_type(bits(8)) by simp(hc)
  have pn: x86_64_linux.phnum(F) in omega by defs(mp(x86.le_at_nat[f := F, off := 56, n := 2], fs, simp()), x86_64_linux.phnum)
  have rol := apply(mp.ro_list, fs)
  have rlen: seq_len(RO) = x86_64_linux.phnum(F) by defs(arith(fn_build_dom[d := int_sub(x86_64_linux.phnum(F), 0), v := x0. ite(x86_64_linux.is_load(F, int_add(0, x0)) && !bit(x86_64_linux.segment(F, int_add(0, x0)).flags, 1), pair(x86_64_linux.segment(F, int_add(0, x0)).vaddr, x86_64_linux.segment(F, int_add(0, x0)).memsz), pair(0, 0))], pn), seq_len, mallocng.ro_ranges)
  have {p2 = areas, p3 = reserve} := apply(mp.fp_pieces, hc, hu, ha)
  have cf: c.ctx in omega && c.lock in omega && c.libc in omega by simp(hc)
  have o1 := apply(tr.seq_one_type, (pair(c.ctx, mallocng.CTX_SIZE) in univ(1) by simp(cf)))
  have o2 := apply(tr.seq_one_type, (pair(c.lock, 4) in univ(1) by simp(cf)))
  have o3 := apply(tr.seq_one_type, (pair(c.libc, 16) in univ(1) by simp(cf)))
  have dl: DR in list_type(univ(1)) by defs(apply(tr.concat_list, apply(tr.concat_list, o1, o2), o3), mallocng.data_ranges)
  have drl: seq_len(DR) = 3 by defs(arith(), mallocng.data_ranges)
  have pl: P in list_type(univ(1)) := apply(tr.concat_list, apply(tr.concat_list, apply(tr.concat_list, dl, rol), p2), p3)
  have rl: A.areas in list_type(omega) by simp(ha)
  have al: seq_len(A.areas) in omega by arith(rl)
  have arl: seq_len(AR) = int_sub(seq_len(A.areas), 0) by defs(fn_build_dom[d := int_sub(seq_len(A.areas), 0), v := x0. pair(A.areas[int_add(0, x0)], 4096)], seq_len)
  have pln: seq_len(P) = mp.reg_q(c, A) by arith(dl, rol, p2, p3, drl, rlen, arl, pn, al)
  have ul: A.used in list_type(omega) by simp(ha)
  have ud: int_sub(seq_len(A.used), 0) in omega by arith(ul)
  have gv: all x0. x0 in int_sub(seq_len(A.used), 0) -> ite(int_lt(0, A.metas[A.used[int_add(0, x0)]].maplen), mallocng.group_range(A.metas[A.used[int_add(0, x0)]]), pair(0, 0)) in univ(1) proof
    fix x0
    assume hx
    show by defs(simp(hu), mallocng.group_range, mallocng.stride)
  qed
  have p5 := apply(build_list, ud, gv)
  have grl: seq_len(GR) = int_sub(seq_len(A.used), 0) by defs(fn_build_dom[d := int_sub(seq_len(A.used), 0),
    v := x0. ite(int_lt(0, A.metas[A.used[int_add(0, x0)]].maplen), mallocng.group_range(A.metas[A.used[int_add(0, x0)]]), pair(0, 0))], seq_len)
  have er: mallocng.regions(c, A) = seq_concat(P, GR) by defs(refl({seq_concat(P, GR)}), mallocng.regions)
  have c1: int_lt(i, mp.reg_q(c, A)) -> seq_concat(P, GR)[i] = P[i] proof
    assume h
    show := at({seq_concat(P, GR)[i]}, pl, p5, pln, hi, h)
  qed
  have c2: seq_len(seq_concat(P, GR)) = int_add(mp.reg_q(c, A), seq_len(A.used)) by arith(pl, p5, pln, grl, ul)
  show by simp(er, c1, c2)
qed

// (regions rs2 the regions rs re-indexed by f, but for x: separate if x's
// is apart from the others)
theorem mp.sep_inject(rs, rs2, x, j. f): mallocng.separate(rs) -> x in omega ->
  (all i. i in omega -> int_lt(i, seq_len(rs2)) -> !(i = x) -> (f(i) in omega && int_lt(f(i), seq_len(rs))) && rs2[i] = rs[f(i)]) ->
  (all i. all j. i in omega -> j in omega -> !(i = x) -> !(j = x) -> f(i) = f(j) -> i = j) ->
  (all i. i in omega -> int_lt(i, seq_len(rs2)) -> !(i = x) -> mallocng.apart(rs2[x], rs2[i])) ->
  mallocng.separate(rs2)
proof
  assume hs hx hf hi ha
  have r: all x0. all x1. x0 in omega && x1 in omega -> (int_lt(x0, seq_len(rs2)) && int_lt(x1, seq_len(rs2))) && !(x0 = x1) -> mallocng.apart(rs2[x0], rs2[x1]) proof
    fix i j
    assume ho h
    have io jo := ho
    have il jl ne := h
    have c1: i = x -> mallocng.apart(rs2[i], rs2[j]) proof
      assume e
      have jx: !(j = x) proof
        assume e2
        show by taut(ne, trans(e, sym(e2)))
      qed
      show := rewrite(sym(e), mp(all_elim(ha, {j}), jo, jl, jx))
    qed
    have c2: j = x -> mallocng.apart(rs2[i], rs2[j]) proof
      assume e
      have ix: !(i = x) proof
        assume e2
        show by taut(ne, trans(e2, sym(e)))
      qed
      show := apply(mp.apart_sym, rewrite(sym(e), mp(all_elim(ha, {i}), io, il, ix)))
    qed
    have c3: !(i = x) -> !(j = x) -> mallocng.apart(rs2[i], rs2[j]) proof
      assume ix jx
      have fio fil fie := mp(all_elim(hf, {i}), io, il, ix)
      have fjo fjl fje := mp(all_elim(hf, {j}), jo, jl, jx)
      have fne: !(f(i) = f(j)) proof
        assume e
        show by taut(ne, mp(all_elim(hi, {i}, {j}), io, jo, ix, jx, e))
      qed
      have a := mp(all_elim(expand(hs, mallocng.separate), {f(i)}, {f(j)}), conj(fio, fjo), taut(fil, fjl, fne))
      show := rewrite(sym(fje), rewrite(sym(fie), a))
    qed
    show by taut(c1, c2, c3)
  qed
  show by defs(r, mallocng.separate)
qed

// the regions separate: the old ones, the new group's mapping (if mapped
// on its own) apart from them
theorem mp.ng_sep(c, A, k, T, m, V, n): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> k in omega -> int_le(k, seq_len(A.used)) -> m in omega ->
  !mallocng.is_used(A, m) -> mp.ngrp(A, k, T, m, V, n) in univ(1) -> mp.ngrp(A, k, T, m, V, n) in mallocng.Abs ->
  mallocng.separate(mallocng.regions(c, A)) ->
  (int_lt(0, V.maplen) -> all i. i in omega -> int_lt(i, seq_len(mallocng.regions(c, A))) -> mallocng.apart(mallocng.group_range(V), mallocng.regions(c, A)[i])) ->
  mallocng.separate(mallocng.regions(c, mp.ngrp(A, k, T, m, V, n)))
proof
  assume hc hu ha hk hkl hm nm hu2 ha2 hs hap
  let A2 := mp.ngrp(A, k, T, m, V, n)
  let Q := mp.reg_q(c, A)
  let X := int_add(Q, k)
  let R := mallocng.regions(c, A)
  let R2 := mallocng.regions(c, A2)
  have fs: c.file in seq_type(bits(8)) by simp(hc)
  have pn: x86_64_linux.phnum(c.file) in omega by defs(mp(x86.le_at_nat[f := c.file, off := 56, n := 2], fs, simp()), x86_64_linux.phnum)
  have al: seq_len(A.areas) in omega by arith((A.areas in list_type(omega) by simp(ha)))
  have ul: A.used in list_type(omega) by simp(ha)
  have uo: seq_len(A.used) in omega by arith(ul)
  have qo: Q in omega by arith(pn, al)
  have xo: X in omega by arith(qo, hk)
  have q2: mp.reg_q(c, A2) = Q by simp()
  have pe: mp.reg_pre(c, A2) = mp.reg_pre(c, A) by simp()
  have dl _ _ := apply(mp.ins_app[l := A.used, k := k, x := m, j := 0], ul, hk, hkl, hm)
  have el: all j. j in omega -> int_lt(j, int_add(seq_len(A.used), 1)) -> A2.used[j] = ite(int_lt(j, k), A.used[j], ite(j = k, m, A.used[int_sub(j, 1)])) proof
    fix j
    have _ _ e := apply(mp.ins_app[l := A.used, k := k, x := m, j := j], ul, hk, hkl, hm)
    show by simp(e)
  qed
  have u2l: seq_len(A2.used) = int_add(seq_len(A.used), 1) by simp(dl)
  have {l1 = len} := apply(mp.reg_front[c := c, A := A, i := 0], hc, hu, ha, simp())
  have {l2 = len} := apply(mp.reg_front[c := c, A := A2, i := 0], hc, hu2, ha2, simp())
  // (a group in use before: its record as before)
  have em: all g. mallocng.is_used(A, g) -> A2.metas[g] = A.metas[g] proof
    fix g
    assume h1
    have gm: !(g = m) proof
      assume e
      show by taut(rewrite(e, h1), nm)
    qed
    show by simp(mp(app_update_other[f := A.metas, k := m, v := V, x := g], gm))
  qed
  have iu: all j. j in omega -> int_lt(j, seq_len(A.used)) -> mallocng.is_used(A, A.used[j]) proof
    fix j
    assume hj hjl
    show by defs(ex_intro({j}, taut(hj, hjl, refl({A.used[j]}))), mallocng.is_used)
  qed
  // (the k-th group's entry of A2's: the j-th of A's)
  have gq: all i. all j. i in omega -> j in omega -> int_lt(j, seq_len(A.used)) -> int_lt(int_sub(i, Q), int_add(seq_len(A.used), 1)) ->
      int_le(Q, i) -> A2.used[int_sub(i, Q)] = A.used[j] -> R2[i] = R[int_add(Q, j)] proof
    fix i j
    assume hi hj hjl hil hqi eu
    let j2 := int_sub(i, Q)
    have j2o: j2 in omega by arith(hi, hqi, qo)
    have g2 _ := apply(mp.reg_grp[c := c, A := A2, k := j2], hc, hu2, ha2, j2o, rewrite(sym(u2l), hil))
    have g1 _ := apply(mp.reg_grp[c := c, A := A, k := j], hc, hu, ha, hj, hjl)
    have ei: int_add(mp.reg_q(c, A2), j2) = i by arith(q2, hqi, hi, qo)
    have e2 := rewrite(mp(all_elim(em, {A.used[j]}), mp(all_elim(iu, {j}), hj, hjl)), rewrite(eu, rewrite(ei, g2)))
    show := trans(e2, sym(g1))
  qed
  have hf: all i. i in omega -> int_lt(i, seq_len(R2)) -> !(i = X) ->
      (ite(int_lt(i, X), i, int_sub(i, 1)) in omega && int_lt(ite(int_lt(i, X), i, int_sub(i, 1)), seq_len(R))) && R2[i] = R[ite(int_lt(i, X), i, int_sub(i, 1))] proof
    fix i
    assume hi hil hix
    have c1: int_lt(i, Q) -> (i in omega && int_lt(i, seq_len(R))) && R2[i] = R[i] proof
      assume h
      have {p2 = pre} := apply(mp.reg_front[c := c, A := A2, i := i], hc, hu2, ha2, hi)
      have {p1 = pre} := apply(mp.reg_front[c := c, A := A, i := i], hc, hu, ha, hi)
      have e: R2[i] = R[i] := trans(rewrite(pe, mp(p2, rewrite(sym(q2), h))), sym(mp(p1, h)))
      show by taut(hi, (int_lt(i, seq_len(R)) by arith(l1, h, uo)), e)
    qed
    have c2: int_le(Q, i) -> int_lt(i, X) -> (i in omega && int_lt(i, seq_len(R))) && R2[i] = R[i] proof
      assume h1 h2
      let j := int_sub(i, Q)
      have jo: j in omega by arith(h1, hi, qo)
      have jk: int_lt(j, k) by arith(h2)
      have eu: A2.used[j] = A.used[j] := trans(mp(all_elim(el, {j}), jo, (int_lt(j, int_add(seq_len(A.used), 1)) by arith(jk, hkl))),
        mp(ite_t[c := int_lt(j, k), a := A.used[j], b := ite(j = k, m, A.used[int_sub(j, 1)])], jk))
      have e0 := mp(all_elim(gq, {i}, {j}), hi, jo, (int_lt(j, seq_len(A.used)) by arith(jk, hkl)), (int_lt(j, int_add(seq_len(A.used), 1)) by arith(jk, hkl)), h1, eu)
      have e: R2[i] = R[i] := rewrite((int_add(Q, j) = i by arith(h1, hi, qo)), e0)
      show by taut(hi, (int_lt(i, seq_len(R)) by arith(l1, h2, hkl, qo)), e)
    qed
    have c3: int_lt(X, i) -> (int_sub(i, 1) in omega && int_lt(int_sub(i, 1), seq_len(R))) && R2[i] = R[int_sub(i, 1)] proof
      assume h
      let j := int_sub(i, Q)
      have jo: j in omega by arith(h, hi, qo, hk)
      have kj: int_lt(k, j) by arith(h)
      have jl: int_lt(j, int_add(seq_len(A.used), 1)) by arith(hil, l2, u2l, q2)
      have eu: A2.used[j] = A.used[int_sub(j, 1)] := trans(mp(all_elim(el, {j}), jo, jl),
        trans(mp(ite_f[c := int_lt(j, k), a := A.used[j], b := ite(j = k, m, A.used[int_sub(j, 1)])], (!int_lt(j, k) by arith(kj))),
          mp(ite_f[c := j = k, a := m, b := A.used[int_sub(j, 1)]], (!(j = k) by arith(kj)))))
      have e0 := mp(all_elim(gq, {i}, {int_sub(j, 1)}), hi, (int_sub(j, 1) in omega by arith(kj, hk)), (int_lt(int_sub(j, 1), seq_len(A.used)) by arith(jl)), jl,
        (int_le(Q, i) by arith(h, hk)), eu)
      have e: R2[i] = R[int_sub(i, 1)] := rewrite((int_add(Q, int_sub(j, 1)) = int_sub(i, 1) by arith(h, hi, qo, hk)), e0)
      show by taut((int_sub(i, 1) in omega by arith(h, xo)), (int_lt(int_sub(i, 1), seq_len(R)) by arith(l1, l2, u2l, q2, hil)), e)
    qed
    have d1: int_lt(i, X) -> ite(int_lt(i, X), i, int_sub(i, 1)) = i by simp()
    have d2: !int_lt(i, X) -> ite(int_lt(i, X), i, int_sub(i, 1)) = int_sub(i, 1) by simp()
    have k1: int_lt(i, X) -> (ite(int_lt(i, X), i, int_sub(i, 1)) in omega && int_lt(ite(int_lt(i, X), i, int_sub(i, 1)), seq_len(R))) &&
        R2[i] = R[ite(int_lt(i, X), i, int_sub(i, 1))] proof
      assume h
      have r: (i in omega && int_lt(i, seq_len(R))) && R2[i] = R[i] by taut(c1, c2, h, (int_lt(i, Q) || int_le(Q, i) by arith(hi, qo)))
      show := subst({y. (y in omega && int_lt(y, seq_len(R))) && R2[i] = R[y]}, sym(mp(d1, h)), r)
    qed
    have k2: !int_lt(i, X) -> (ite(int_lt(i, X), i, int_sub(i, 1)) in omega && int_lt(ite(int_lt(i, X), i, int_sub(i, 1)), seq_len(R))) &&
        R2[i] = R[ite(int_lt(i, X), i, int_sub(i, 1))] proof
      assume h
      have r := mp(c3, (int_lt(X, i) by arith(h, hix)))
      show := subst({y. (y in omega && int_lt(y, seq_len(R))) && R2[i] = R[y]}, sym(mp(d2, h)), r)
    qed
    show by taut(k1, k2)
  qed
  have hi: all i. all j. i in omega -> j in omega -> !(i = X) -> !(j = X) -> ite(int_lt(i, X), i, int_sub(i, 1)) = ite(int_lt(j, X), j, int_sub(j, 1)) -> i = j proof
    fix i j
    assume hio hjo hix hjx e
    have a1: int_lt(i, X) -> ite(int_lt(i, X), i, int_sub(i, 1)) = i by simp()
    have a2: !int_lt(i, X) -> ite(int_lt(i, X), i, int_sub(i, 1)) = int_sub(i, 1) by simp()
    have b1: int_lt(j, X) -> ite(int_lt(j, X), j, int_sub(j, 1)) = j by simp()
    have b2: !int_lt(j, X) -> ite(int_lt(j, X), j, int_sub(j, 1)) = int_sub(j, 1) by simp()
    have r1: int_lt(i, X) -> int_lt(j, X) -> i = j proof
      assume h1 h2
      show := trans(sym(mp(a1, h1)), trans(e, mp(b1, h2)))
    qed
    have r2: int_lt(i, X) -> !int_lt(j, X) -> i = j proof
      assume h1 h2
      show by arith(trans(sym(mp(a1, h1)), trans(e, mp(b2, h2))), h1, h2, hjx, hio, hjo, xo)
    qed
    have r3: !int_lt(i, X) -> int_lt(j, X) -> i = j proof
      assume h1 h2
      show by arith(trans(sym(mp(a2, h1)), trans(e, mp(b1, h2))), h1, h2, hix, hio, hjo, xo)
    qed
    have r4: !int_lt(i, X) -> !int_lt(j, X) -> i = j proof
      assume h1 h2
      show by arith(trans(sym(mp(a2, h1)), trans(e, mp(b2, h2))), hio, hjo)
    qed
    show by taut(r1, r2, r3, r4)
  qed
  // the new entry: m's range if mapped, else empty
  have hx: all i. i in omega -> int_lt(i, seq_len(R2)) -> !(i = X) -> mallocng.apart(R2[X], R2[i]) proof
    fix i
    assume hio hil hix
    have fo fl fe := mp(all_elim(hf, {i}), hio, hil, hix)
    have gx _ := apply(mp.reg_grp[c := c, A := A2, k := k], hc, hu2, ha2, hk, (int_lt(k, seq_len(A2.used)) by arith(u2l, hkl)))
    have uk: A2.used[k] = m := trans(mp(all_elim(el, {k}), hk, (int_lt(k, int_add(seq_len(A.used), 1)) by arith(hkl))),
      trans(mp(ite_f[c := int_lt(k, k), a := A.used[k], b := ite(k = k, m, A.used[int_sub(k, 1)])], (!int_lt(k, k) by arith(hk))),
        mp(ite_t[c := k = k, a := m, b := A.used[int_sub(k, 1)]], refl({k}))))
    have vm: A2.metas[m] = V by simp()
    have ex: int_add(mp.reg_q(c, A2), k) = X by arith(q2)
    have rx: R2[X] = ite(int_lt(0, V.maplen), mallocng.group_range(V), pair(0, 0)) := rewrite(vm, rewrite(uk, rewrite(ex, gx)))
    have c1: int_lt(0, V.maplen) -> mallocng.apart(R2[X], R2[i]) proof
      assume h
      have a := mp(all_elim(mp(hap, h), {ite(int_lt(i, X), i, int_sub(i, 1))}), fo, fl)
      have r1: R2[X] = mallocng.group_range(V) by simp(rx, h)
      show := rewrite(sym(fe), rewrite(sym(r1), a))
    qed
    have c2: !int_lt(0, V.maplen) -> mallocng.apart(R2[X], R2[i]) proof
      assume h
      have r1: R2[X] = pair(0, 0) by simp(rx, h)
      show by defs(simp(r1), mallocng.apart)
    qed
    show by taut(c1, c2)
  qed
  show := apply(mp.sep_inject[rs := R, rs2 := R2, x := X, f := j. ite(int_lt(j, X), j, int_sub(j, 1))], hs, xo, hf, hi, hx)
qed

// (the j-th group in use: m, or one in use before at some place, its
// record and slots as before)
theorem mp.ng_member(A, k, T, m, V, n, g): A in mallocng.Abs -> k in omega -> int_le(k, seq_len(A.used)) -> m in omega -> !mallocng.is_used(A, m) ->
  mallocng.is_used(mp.ngrp(A, k, T, m, V, n), g) ->
  g = m || (ex x0. x0 in omega && (int_lt(x0, seq_len(A.used)) && A.used[x0] = g)) &&
    (mp.ngrp(A, k, T, m, V, n).metas[g] = A.metas[g] && mp.ngrp(A, k, T, m, V, n).slots[g] = A.slots[g])
proof
  assume ha hk hkl hm nm iu2
  have c: mallocng.is_used(A, g) || g = m by taut(apply(mp.ng_used[A := A, k := k, T := T, m := m, V := V, n := n, g := g], ha, hk, hkl, hm), iu2)
  have c1: mallocng.is_used(A, g) -> (ex x0. x0 in omega && (int_lt(x0, seq_len(A.used)) && A.used[x0] = g)) &&
      (mp.ngrp(A, k, T, m, V, n).metas[g] = A.metas[g] && mp.ngrp(A, k, T, m, V, n).slots[g] = A.slots[g]) proof
    assume h
    have gm: !(g = m) proof
      assume e
      show by taut(rewrite(e, h), nm)
    qed
    have e1: mp.ngrp(A, k, T, m, V, n).metas[g] = A.metas[g] by simp(mp(app_update_other[f := A.metas, k := m, v := V, x := g], gm))
    have e2: mp.ngrp(A, k, T, m, V, n).slots[g] = A.slots[g] by simp(mp(app_update_other[f := A.slots, k := m, v := fn_build(n, i. tag(0, empty)), x := g], gm))
    show by taut(expand(h, mallocng.is_used), e1, e2)
  qed
  show by taut(c, c1)
qed

// the slots reserved: as before (m's all unused)
theorem mp.ng_inres(A, k, T, m, V, n, a): A in mallocng.Abs -> k in omega -> int_le(k, seq_len(A.used)) -> m in omega -> !mallocng.is_used(A, m) -> n in omega ->
  (mallocng.in_reserved(mp.ngrp(A, k, T, m, V, n), a) <-> mallocng.in_reserved(A, a))
proof
  assume ha hk hkl hm nm hn
  let A2 := mp.ngrp(A, k, T, m, V, n)
  have fw: mallocng.in_reserved(A2, a) -> mallocng.in_reserved(A, a) proof
    assume h
    obtain g i, hg hi iu2 hil hs hin from expand(h, mallocng.in_reserved)
    have c1: g = m -> mallocng.in_reserved(A, a) proof
      assume e
      have s0: A2.slots[g] = fn_build(n, i. tag(0, empty)) by simp(e)
      have dn: seq_len(fn_build(n, i. tag(0, empty))) = n by defs(fn_build_dom[d := n, v := i. tag(0, empty)], seq_len)
      have il := mp(nat_lt_mem[k := i, n := n], hi, hn, rewrite(dn, rewrite(s0, hil)))
      have u0 := rewrite(sym(s0), mp(app_fn_build[d := n, v := i. tag(0, empty), a := i], il))
      have f: false by defs(simp(trans(sym(hs), u0)), tag)
      show by taut(f)
    qed
    have c2: (ex x0. x0 in omega && (int_lt(x0, seq_len(A.used)) && A.used[x0] = g)) && (A2.metas[g] = A.metas[g] && A2.slots[g] = A.slots[g]) ->
        mallocng.in_reserved(A, a) proof
      assume w
      have ex em es := w
      have iu: mallocng.is_used(A, g) by defs(ex, mallocng.is_used)
      show by defs(ex_intro({g}, {i}, taut(hg, hi, iu, rewrite(es, hil), rewrite(es, hs), rewrite(em, hin))), mallocng.in_reserved)
    qed
    show by taut(apply(mp.ng_member[A := A, k := k, T := T, m := m, V := V, n := n, g := g], ha, hk, hkl, hm, nm, iu2), c1, c2)
  qed
  have bw: mallocng.in_reserved(A, a) -> mallocng.in_reserved(A2, a) proof
    assume h
    obtain g i, hg hi iu hil hs hin from expand(h, mallocng.in_reserved)
    have iu2: mallocng.is_used(A2, g) by taut(apply(mp.ng_used[A := A, k := k, T := T, m := m, V := V, n := n, g := g], ha, hk, hkl, hm), iu)
    have gm: !(g = m) proof
      assume e
      show by taut(rewrite(e, iu), nm)
    qed
    have w: (ex x0. x0 in omega && (int_lt(x0, seq_len(A.used)) && A.used[x0] = g)) && (A2.metas[g] = A.metas[g] && A2.slots[g] = A.slots[g])
      by taut(apply(mp.ng_member[A := A, k := k, T := T, m := m, V := V, n := n, g := g], ha, hk, hkl, hm, nm, iu2), gm)
    have _ em es := w
    show by defs(ex_intro({g}, {i}, taut(hg, hi, iu2, rewrite(sym(es), hil), rewrite(sym(es), hs), rewrite(sym(em), hin))), mallocng.in_reserved)
  qed
  show by taut(fw, bw)
qed

// the groups apart from the fixed regions (as before): the old ones, m's
// (its range apart from them)
theorem mp.ng_apart(c, A, k, T, m, V, n): A in mallocng.Abs -> k in omega -> int_le(k, seq_len(A.used)) -> m in omega -> !mallocng.is_used(A, m) ->
  mallocng.groups_apart(c, A) -> (all a. a in omega -> mallocng.in_range(a, mallocng.group_range(V)) -> !mallocng.in_ranges(a, mallocng.fixed_ranges(c, A))) ->
  mallocng.groups_apart(c, mp.ngrp(A, k, T, m, V, n))
proof
  assume ha hk hkl hm nm hga hv
  let A2 := mp.ngrp(A, k, T, m, V, n)
  have fe: mallocng.fixed_ranges(c, A2) = mallocng.fixed_ranges(c, A) by defs(simp(), mallocng.fixed_ranges, mallocng.auxv_ranges)
  have r: all x0. all x1. x0 in omega && x1 in omega -> int_lt(x0, seq_len(A2.used)) && mallocng.in_range(x1, mallocng.group_range(A2.metas[A2.used[x0]])) ->
      !mallocng.in_ranges(x1, mallocng.fixed_ranges(c, A2)) proof
    fix j a
    assume ho h
    have hj hao := ho
    have hjl hin := h
    let g := A2.used[j]
    have iu2: mallocng.is_used(A2, g) by defs(ex_intro({j}, taut(hj, hjl, refl({g}))), mallocng.is_used)
    have c1: g = m -> !mallocng.in_ranges(a, mallocng.fixed_ranges(c, A2)) proof
      assume e
      have ev: A2.metas[g] = V by simp(e)
      show := rewrite(sym(fe), mp(all_elim(hv, {a}), hao, rewrite(ev, hin)))
    qed
    have c2: (ex x0. x0 in omega && (int_lt(x0, seq_len(A.used)) && A.used[x0] = g)) && (A2.metas[g] = A.metas[g] && A2.slots[g] = A.slots[g]) ->
        !mallocng.in_ranges(a, mallocng.fixed_ranges(c, A2)) proof
      assume w
      have ex em _ := w
      obtain k0, hk0 hk0l hke from ex
      have q := mp(all_elim(expand(hga, mallocng.groups_apart), {k0}, {a}), conj(hk0, hao), conj(hk0l, rewrite(sym(hke), rewrite(em, hin))))
      show := rewrite(sym(fe), q)
    qed
    show by taut(apply(mp.ng_member[A := A, k := k, T := T, m := m, V := V, n := n, g := g], ha, hk, hkl, hm, nm, iu2), c1, c2)
  qed
  show by defs(r, mallocng.groups_apart)
qed

// the fixed regions: as before
theorem mp.ng_fixed(c, A, k, T, m, V, n, b): mallocng.fixed_free(c, A, b) -> mallocng.fixed_free(c, mp.ngrp(A, k, T, m, V, n), b)
proof
  assume h
  show by defs(simp(expand(h, mallocng.fixed_free)), mallocng.fixed_free)
qed

// the allocator's memory accessible: as before, m's group's bytes (but the
// clients')
theorem mp.ng_perms(c, A, k, T, m, V, n, M, b): A in mallocng.Abs -> k in omega -> int_le(k, seq_len(A.used)) -> m in omega -> !mallocng.is_used(A, m) -> n in omega ->
  mallocng.perms_ok(c, A, M, b) ->
  (all a. a in omega -> mallocng.in_range(a, mallocng.group_range(V)) -> !(a in malloc.live_of(b)) -> mallocng.m_rw(M, a) && !(snd(mallocng.pg(M, a)).kind = 2)) ->
  mallocng.perms_ok(c, mp.ngrp(A, k, T, m, V, n), M, b)
proof
  assume ha hk hkl hm nm hn hp hv
  let A2 := mp.ngrp(A, k, T, m, V, n)
  have {pd = data, pgr = groups, pa = auxv} := expand(hp, mallocng.perms_ok)
  have xe: mallocng.auxv_ranges(A2) = mallocng.auxv_ranges(A) by defs(simp(), mallocng.auxv_ranges)
  have g2: all x0. all x1. x0 in omega && x1 in omega -> (((int_lt(x0, seq_len(A2.used)) && int_le(fst(mallocng.group_range(A2.metas[A2.used[x0]])), x1)) &&
      int_lt(x1, int_add(fst(mallocng.group_range(A2.metas[A2.used[x0]])), snd(mallocng.group_range(A2.metas[A2.used[x0]]))))) && !(x1 in malloc.live_of(b))) &&
      !mallocng.in_reserved(A2, x1) -> mallocng.m_rw(M, x1) && !(snd(mallocng.pg(M, x1)).kind = 2) proof
    fix j a
    assume ho h
    have hj hao := ho
    have hjl h1 h2 nl nr := h
    let g := A2.used[j]
    have iu2: mallocng.is_used(A2, g) by defs(ex_intro({j}, taut(hj, hjl, refl({g}))), mallocng.is_used)
    have c1: g = m -> mallocng.m_rw(M, a) && !(snd(mallocng.pg(M, a)).kind = 2) proof
      assume e
      have ev: A2.metas[g] = V by simp(e)
      show := mp(all_elim(hv, {a}), hao, (mallocng.in_range(a, mallocng.group_range(V)) by defs(taut(rewrite(ev, h1), rewrite(ev, h2)), mallocng.in_range)), nl)
    qed
    have c2: (ex x0. x0 in omega && (int_lt(x0, seq_len(A.used)) && A.used[x0] = g)) && (A2.metas[g] = A.metas[g] && A2.slots[g] = A.slots[g]) ->
        mallocng.m_rw(M, a) && !(snd(mallocng.pg(M, a)).kind = 2) proof
      assume w
      have ex em _ := w
      obtain k0, hk0 hk0l hke from ex
      have nr0: !mallocng.in_reserved(A, a) by taut(nr, apply(mp.ng_inres[A := A, k := k, T := T, m := m, V := V, n := n, a := a], ha, hk, hkl, hm, nm, hn))
      show := mp(all_elim(pgr, {k0}, {a}), conj(hk0, hao), taut(hk0l, rewrite(sym(hke), rewrite(em, h1)), rewrite(sym(hke), rewrite(em, h2)), nl, nr0))
    qed
    show by taut(apply(mp.ng_member[A := A, k := k, T := T, m := m, V := V, n := n, g := g], ha, hk, hkl, hm, nm, iu2), c1, c2)
  qed
  show by defs(taut(pd, g2, rewrite(sym(xe), pa)), mallocng.perms_ok)
qed

// the meta areas: as before, m's bytes (no longer taken) accessible
theorem mp.ng_areas(c, A, k, T, m, V, n, M): A in mallocng.Abs -> T in list_type(omega) -> A.taken = seq_concat(T, seq_one(m)) ->
  mallocng.areas_ok(c, A, M) ->
  (all a. a in omega -> int_le(m, a) -> int_lt(a, int_add(m, mallocng.META_SIZE)) -> mallocng.m_rw(M, a) && !(snd(mallocng.pg(M, a)).kind = 2)) ->
  mallocng.areas_ok(c, mp.ngrp(A, k, T, m, V, n), M)
proof
  assume ha ht hte h hv
  let A2 := mp.ngrp(A, k, T, m, V, n)
  have {hd = head, tl = tail, ea = each, ds = distinct, rs = reserve} := expand(h, mallocng.areas_ok)
  have tlo: seq_len(T) in omega by arith(ht)
  have lt: seq_len(A.taken) = int_add(seq_len(T), 1) := rewrite(sym(hte), (seq_len(seq_concat(T, seq_one(m))) = int_add(seq_len(T), 1) by arith(ht)))
  have tm: A.taken[seq_len(T)] = m := rewrite(sym(hte), at({seq_concat(T, seq_one(m))[seq_len(T)]}, ht))
  // (a byte taken before: taken still, or m's)
  have it: all a. mallocng.in_taken(A, a) -> mallocng.in_taken(A2, a) || int_le(m, a) && int_lt(a, int_add(m, mallocng.META_SIZE)) proof
    fix a
    assume h1
    obtain i, hi hil h2 h3 from expand(h1, mallocng.in_taken)
    have c1: int_lt(i, seq_len(T)) -> mallocng.in_taken(A2, a) proof
      assume hl
      have ti: A.taken[i] = T[i] := rewrite(sym(hte), at({seq_concat(T, seq_one(m))[i]}, ht, hi, hl))
      have tk: A2.taken = T by simp()
      show by defs(ex_intro({i}, taut(hi, rewrite(sym(tk), hl), rewrite(sym(tk), rewrite(ti, h2)), rewrite(sym(tk), rewrite(ti, h3)))), mallocng.in_taken)
    qed
    have c2: i = seq_len(T) -> int_le(m, a) && int_lt(a, int_add(m, mallocng.META_SIZE)) proof
      assume e
      have tm2: A.taken[i] = m := rewrite(sym(e), tm, {1})
      show by taut(rewrite(tm2, h2), rewrite(tm2, h3))
    qed
    show by taut(c1, c2, (int_lt(i, seq_len(T)) || i = seq_len(T) by arith(hi, hil, lt)))
  qed
  have e2: all x0. x0 in omega -> int_lt(x0, seq_len(A.areas)) -> ((((int_mod(A.areas[x0], 4096) = 0 && int_lt(0, A.areas[x0])) && mallocng.rd(M, A.areas[x0], 8) = A.secret) &&
      mallocng.rd(M, int_add(A.areas[x0], 8), 8) = ite(int_lt(int_add(x0, 1), seq_len(A.areas)), A.areas[int_add(x0, 1)], 0)) && mallocng.rd(M, int_add(A.areas[x0], 16), 4) = mallocng.NSLOTS) &&
      (all x1. x1 in omega -> (int_le(A.areas[x0], x1) && int_lt(x1, int_add(A.areas[x0], 4096))) && !mallocng.in_taken(A2, x1) -> mallocng.m_rw(M, x1) && !(snd(mallocng.pg(M, x1)).kind = 2)) proof
    fix j
    assume hj hjl
    have q1 q2 q3 q4 q5 qr := mp(all_elim(ea, {j}), hj, hjl)
    have r: all x1. x1 in omega -> (int_le(A.areas[j], x1) && int_lt(x1, int_add(A.areas[j], 4096))) && !mallocng.in_taken(A2, x1) -> mallocng.m_rw(M, x1) && !(snd(mallocng.pg(M, x1)).kind = 2) proof
      fix a
      assume hao hr
      have hr1 hr2 nt := hr
      have d1: mallocng.in_taken(A, a) -> mallocng.m_rw(M, a) && !(snd(mallocng.pg(M, a)).kind = 2) proof
        assume tk
        have w1 w2 := (int_le(m, a) && int_lt(a, int_add(m, mallocng.META_SIZE)) by taut(mp(all_elim(it, {a}), tk), nt))
        show := mp(all_elim(hv, {a}), hao, w1, w2)
      qed
      have d2: !mallocng.in_taken(A, a) -> mallocng.m_rw(M, a) && !(snd(mallocng.pg(M, a)).kind = 2) proof
        assume tk
        show := mp(all_elim(qr, {a}), hao, conj(conj(hr1, hr2), tk))
      qed
      show by taut(d1, d2)
    qed
    show by taut(q1, q2, q3, q4, q5, r)
  qed
  show by defs(simp(hd, tl, e2, ds, rs), mallocng.areas_ok)
qed

// ----------------------------------------------------------------------
//  The invariant for the new state

// (m, the meta taken last: not in use)
theorem mp.ng_taken(A, T, m): A in mallocng.Abs -> mallocng.metas_partition(A) -> T in list_type(omega) -> A.taken = seq_concat(T, seq_one(m)) ->
  nat: m in omega && unused: !mallocng.is_used(A, m)
proof
  assume ha hp ht hte
  have {htk = taken} := expand(hp, mallocng.metas_partition)
  have tl: A.taken in list_type(omega) by simp(ha)
  have tlo: seq_len(T) in omega by arith(ht)
  have lt: seq_len(A.taken) = int_add(seq_len(T), 1) := rewrite(sym(hte), (seq_len(seq_concat(T, seq_one(m))) = int_add(seq_len(T), 1) by arith(ht)))
  have tm: A.taken[seq_len(T)] = m := rewrite(sym(hte), at({seq_concat(T, seq_one(m))[seq_len(T)]}, ht))
  have hm: m in omega := rewrite(tm, apply(at_type[l := A.taken, t := omega, i := seq_len(T)], tl, tlo, (int_lt(seq_len(T), seq_len(A.taken)) by arith(lt))))
  have _ mnu0 _ _ _ := mp(all_elim(htk, {seq_len(T)}), tlo, (int_lt(seq_len(T), seq_len(A.taken)) by arith(lt)))
  show by taut(hm, rewrite(tm, mnu0))
qed

// the invariant after a group made from the meta taken last: the
// abstract clauses of the state before (on the new memory where they read
// it), the groups' in the new state, the memory's own (the image, the
// context, the tables) given
theorem mp.ng_holds_c(c, A, k, T, m, V, n, M2, b, brk2): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs ->
  T in list_type(omega) -> A.taken = seq_concat(T, seq_one(m)) -> !(m = 0) -> V in mallocng.MetaV -> n in omega ->
  k in omega -> int_le(k, seq_len(A.used)) ->
  (all j. j in omega -> int_lt(j, k) -> int_lt(A.used[j], m)) -> (all j. j in omega -> int_le(k, j) -> int_lt(j, seq_len(A.used)) -> int_lt(m, A.used[j])) ->
  mallocng.metas_partition(A) -> mallocng.active_ok(A) -> mallocng.partial_ok(A, M2) -> mallocng.reuse_ok(A) -> mallocng.blocks_ok(A, b) ->
  mallocng.normal(A) -> mallocng.separate(mallocng.regions(c, A)) -> malloc.blocks_wf(b) -> mallocng.fixed_free(c, A, b) -> mallocng.groups_apart(c, A) ->
  mallocng.perms_ok(c, A, M2, b) -> mallocng.areas_ok(c, A, M2) ->
  (all h. mallocng.is_used(A, h) -> mallocng.group_ok(mp.ngrp(A, k, T, m, V, n), M2, b, h)) ->
  mallocng.group_ok(mp.ngrp(A, k, T, m, V, n), M2, b, m) ->
  mallocng.image_ok(c, M2) -> mallocng.ctx_ok(c, mp.ngrp(A, k, T, m, V, n), M2) -> mallocng.fresh_ok(c, mp.ngrp(A, k, T, m, V, n), M2) ->
  (all a. a in omega -> int_le(m, a) -> int_lt(a, int_add(m, mallocng.META_SIZE)) -> mallocng.m_rw(M2, a) && !(snd(mallocng.pg(M2, a)).kind = 2)) ->
  mallocng.brk_ok(mp.ngrp(A, k, T, m, V, n), brk2) ->
  (all a. a in omega -> mallocng.in_range(a, mallocng.group_range(V)) -> !(a in malloc.live_of(b)) -> mallocng.m_rw(M2, a) && !(snd(mallocng.pg(M2, a)).kind = 2)) ->
  mallocng.classes_ok(c, M2) -> mallocng.debruijn_ok(c, M2) ->
  (int_lt(0, V.maplen) -> all i. i in omega -> int_lt(i, seq_len(mallocng.regions(c, A))) -> mallocng.apart(mallocng.group_range(V), mallocng.regions(c, A)[i])) ->
  (all a. a in omega -> mallocng.in_range(a, mallocng.group_range(V)) -> !mallocng.in_ranges(a, mallocng.fixed_ranges(c, A))) ->
  mallocng.holds(c, mp.ngrp(A, k, T, m, V, n), M2, b, brk2)
proof
  assume hc hu ha ht hte hmz hv hn hk hkl hlo hhi hp hac hpa hre hbl hnm hsp hwf hff hga pm ar go gm img cok fr mrw bk gpm cl db sep apt
  have {hm = nat, nm = unused} := apply(mp.ng_taken[A := A, T := T, m := m], ha, hp, ht, hte)
  have {au = abs, uu = univ} := apply(mp.ngrp_type[A := A, k := k, T := T, m := m, V := V, n := n], ha, hk, hkl, ht, hm, hv, hn)
  have u2 := apply(mp.ng_used_ok[A := A, k := k, T := T, m := m, V := V, n := n, M := M2, b := b], ha, hk, hkl, hm, go, gm)
  have {a2 = active, p2 = partial, r2 = reuse, b2 = in_slots} := apply(mp.ng_lists[A := A, k := k, T := T, m := m, V := V, n := n, M := M2, b := b],
    ha, hk, hkl, hm, nm, hac, hpa, hre, hbl)
  have pt2 := apply(mp.ng_part[A := A, k := k, T := T, m := m, V := V, n := n], ha, hp, ht, hte, hk, hkl, hlo, hhi)
  have nm2 := apply(mp.ng_normal[A := A, k := k, T := T, m := m, V := V, n := n], ha, hnm, hk, hkl, hm, hmz)
  have ar2 := apply(mp.ng_areas[c := c, A := A, k := k, T := T, m := m, V := V, n := n, M := M2], ha, ht, hte, ar, mrw)
  have pm2 := apply(mp.ng_perms[c := c, A := A, k := k, T := T, m := m, V := V, n := n, M := M2, b := b], ha, hk, hkl, hm, nm, hn, pm, gpm)
  have sp2 := apply(mp.ng_sep[c := c, A := A, k := k, T := T, m := m, V := V, n := n], hc, hu, ha, hk, hkl, hm, nm, uu, au, hsp, sep)
  have ff2 := apply(mp.ng_fixed[c := c, A := A, k := k, T := T, m := m, V := V, n := n, b := b], hff)
  have ga2 := apply(mp.ng_apart[c := c, A := A, k := k, T := T, m := m, V := V, n := n], ha, hk, hkl, hm, nm, hga, apt)
  show by defs(taut(img, cok, fr, ar2, pt2, u2, a2, p2, r2, b2, nm2, bk, pm2, sp2, hwf, cl, db, ff2, ga2), mallocng.holds)
qed

// ... a group mapped on its own: the old groups' bytes and records as
// before
theorem mp.ng_holds(c, A, k, T, m, V, n, M, M2, b, brk, brk2): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs ->
  b in fn_space(bits(64), option(omega)) -> mallocng.holds(c, A, M, b, brk) ->
  T in list_type(omega) -> A.taken = seq_concat(T, seq_one(m)) -> !(m = 0) -> V in mallocng.MetaV -> n in omega ->
  k in omega -> int_le(k, seq_len(A.used)) ->
  (all j. j in omega -> int_lt(j, k) -> int_lt(A.used[j], m)) -> (all j. j in omega -> int_le(k, j) -> int_lt(j, seq_len(A.used)) -> int_lt(m, A.used[j])) ->
  (all a. a in omega -> mp.ingrp(A, a) -> M2[a] = M[a]) ->
  (all g. all a. mallocng.is_used(A, g) -> a in omega -> int_le(g, a) -> int_lt(a, int_add(g, 40)) -> M2[a] = M[a]) ->
  mallocng.group_ok(mp.ngrp(A, k, T, m, V, n), M2, b, m) ->
  mallocng.image_ok(c, M2) -> mallocng.ctx_ok(c, mp.ngrp(A, k, T, m, V, n), M2) -> mallocng.fresh_ok(c, mp.ngrp(A, k, T, m, V, n), M2) ->
  mallocng.areas_ok(c, A, M2) ->
  (all a. a in omega -> int_le(m, a) -> int_lt(a, int_add(m, mallocng.META_SIZE)) -> mallocng.m_rw(M2, a) && !(snd(mallocng.pg(M2, a)).kind = 2)) ->
  mallocng.brk_ok(mp.ngrp(A, k, T, m, V, n), brk2) -> mallocng.perms_ok(c, A, M2, b) ->
  (all a. a in omega -> mallocng.in_range(a, mallocng.group_range(V)) -> !(a in malloc.live_of(b)) -> mallocng.m_rw(M2, a) && !(snd(mallocng.pg(M2, a)).kind = 2)) ->
  mallocng.classes_ok(c, M2) -> mallocng.debruijn_ok(c, M2) ->
  (int_lt(0, V.maplen) -> all i. i in omega -> int_lt(i, seq_len(mallocng.regions(c, A))) -> mallocng.apart(mallocng.group_range(V), mallocng.regions(c, A)[i])) ->
  (all a. a in omega -> mallocng.in_range(a, mallocng.group_range(V)) -> !mallocng.in_ranges(a, mallocng.fixed_ranges(c, A))) ->
  mallocng.holds(c, mp.ngrp(A, k, T, m, V, n), M2, b, brk2)
proof
  assume hc hu ha hb H ht hte hmz hv hn hk hkl hlo hhi gbs rcs gm img cok fr ar mrw bk pm gpm cl db sep apt
  have {hp = part, huo = used, hac = active, hpa = partial, hre = reuse, hbl = in_slots, hnm = normal, hsp = sep, hwf = wf, hff = fixed, hga = apart} :=
    expand(H, mallocng.holds)
  have {hm = nat, nm = unused} := apply(mp.ng_taken[A := A, T := T, m := m], ha, hp, ht, hte)
  // the old groups on the new memory, then in the new state
  have er: A.metas = A.metas && A.slots = A.slots && A.used = A.used && A.active = A.active by simp()
  have e1 e2 e3 e4 := er
  have u1 := apply(mp.used_tr[A := A, A2 := A, M := M, M2 := M2, b := b], ha, hb, e1, e2, e3, e4, huo, gbs, rcs)
  have p1 := apply(mp.partial_tr[A := A, A2 := A, M := M, M2 := M2, b := b], ha, e1, e4, hac, huo, hpa, gbs)
  have go: all h. mallocng.is_used(A, h) -> mallocng.group_ok(mp.ngrp(A, k, T, m, V, n), M2, b, h) proof
    fix h
    assume iu
    show := apply(mp.ng_group[A := A, k := k, T := T, m := m, V := V, n := n, M := M2, b := b, h := h], ha, hk, hkl, hm, nm, iu, apply(mp.used_group, u1, iu))
  qed
  show := apply(mp.ng_holds_c[c := c, A := A, k := k, T := T, m := m, V := V, n := n, M2 := M2, b := b, brk2 := brk2], hc, hu, ha, ht, hte, hmz, hv, hn, hk, hkl, hlo, hhi,
    hp, hac, p1, hre, hbl, hnm, hsp, hwf, hff, hga, pm, ar, go, gm, img, cok, fr, mrw, bk, gpm, cl, db, sep, apt)
qed

// ----------------------------------------------------------------------
//  A group nested in a reserved slot (slot i of g: the group m)

// (a slot's use other than reserved: as before)
// (a slot other than i of g: as before -- one holding what slot i of g
// does not)
theorem mp.su_slot0(A, g, i, u, p, j, v): !(A.slots[g][i] = v) -> A.slots[p][j] = v -> mp.setu(A, g, i, u).slots[p][j] = v
proof
  assume hn hs
  have c1: p = g -> mp.setu(A, g, i, u).slots[p][j] = v proof
    assume e
    have ji: !(j = i) proof
      assume e2
      have f: A.slots[g][i] = v := rewrite(e, rewrite(e2, hs))
      show by taut(hn, f)
    qed
    have s: mp.setu(A, g, i, u).slots[p] = fn_update(A.slots[g], i, u) by simp(e)
    show := trans(rewrite(sym(s), mp(app_update_other[f := A.slots[g], k := i, v := u, x := j], ji)), rewrite(e, hs))
  qed
  have c2: !(p = g) -> mp.setu(A, g, i, u).slots[p][j] = v proof
    assume ne
    have s: mp.setu(A, g, i, u).slots[p] = A.slots[p] by simp(mp(app_update_other[f := A.slots, k := g, v := fn_update(A.slots[g], i, u), x := p], ne))
    show := rewrite(sym(s), hs)
  qed
  show by taut(c1, c2)
qed

theorem mp.su_slot(A, g, i, u, p, j, v): A.slots[g][i] = tag(3, empty) -> A.slots[p][j] = v -> !(v = tag(3, empty)) -> mp.setu(A, g, i, u).slots[p][j] = v
proof
  assume hr hs hv
  have hn: !(A.slots[g][i] = v) proof
    assume f
    show by taut(hv, trans(sym(f), hr))
  qed
  show := apply(mp.su_slot0[A := A, g := g, i := i, u := u, p := p, j := j, v := v], hn, hs)
qed

theorem mp.nt_slot(A, g, i, m, p, j, u): A.slots[g][i] = tag(3, empty) -> A.slots[p][j] = u -> !(u = tag(3, empty)) -> mp.nest(A, g, i, m).slots[p][j] = u
proof
  assume hr hs hu
  show := apply(mp.su_slot[A := A, g := g, i := i, u := tag(2, m), p := p, j := j, v := u], hr, hs, hu)
qed

// (the slots' numbers: as before)
theorem mp.su_len(A, g, i, u, p): A in mallocng.Abs -> g in omega -> i in omega -> int_lt(i, seq_len(A.slots[g])) -> u in mallocng.Use ->
  seq_len(mp.setu(A, g, i, u).slots[p]) = seq_len(A.slots[p])
proof
  assume ha hg hi hil hu
  have c1: p = g -> seq_len(mp.setu(A, g, i, u).slots[p]) = seq_len(A.slots[p]) proof
    assume e
    have slt: A.slots[g] in list_type(mallocng.Use) := mp(fn_space_app[a := omega, b := list_type(mallocng.Use), f := A.slots, x := g], simp(ha), hg)
    have {ln = len} := apply(mp.list_upd[l := A.slots[g], t := mallocng.Use, i := i, v := u], slt, hi, hil, hu)
    show by simp(e, ln)
  qed
  have c2: !(p = g) -> seq_len(mp.setu(A, g, i, u).slots[p]) = seq_len(A.slots[p]) proof
    assume ne
    show by simp(mp(app_update_other[f := A.slots, k := g, v := fn_update(A.slots[g], i, u), x := p], ne))
  qed
  show by taut(c1, c2)
qed

theorem mp.nt_len(A, g, i, m, p): A in mallocng.Abs -> g in omega -> i in omega -> int_lt(i, seq_len(A.slots[g])) -> m in omega ->
  seq_len(mp.nest(A, g, i, m).slots[p]) = seq_len(A.slots[p])
proof
  assume ha hg hi hil hm
  show := apply(mp.su_len[A := A, g := g, i := i, u := tag(2, m), p := p], ha, hg, hi, hil, apply(mp.use2, hm))
qed

// a group in use but g: as it was (slot i of g not its nest)
theorem mp.su_group0(A, g, i, u, M, b, h): A in mallocng.Abs -> g in omega -> i in omega -> int_lt(i, seq_len(A.slots[g])) -> u in mallocng.Use ->
  !(A.slots[g][i] = tag(2, h)) -> !(h = g) -> mallocng.group_ok(A, M, b, h) ->
  mallocng.group_ok(mp.setu(A, g, i, u), M, b, h)
proof
  assume ha hg hi hil hu hn hne gok
  let A1 := mp.setu(A, g, i, u)
  have em: A1.metas = A.metas by simp()
  have eu: A1.used = A.used by simp()
  have ea: A1.active = A.active by simp()
  have esh: A1.slots[h] = A.slots[h] by simp(mp(app_update_other[f := A.slots, k := g, v := fn_update(A.slots[g], i, u), x := h], hne))
  have {nested} := expand(gok, mallocng.group_ok)
  have {mim, cls, hdr, hdr_own, act, nslots, masks, small, mapped, big, linked, unlinked, slots, sentinel, chk_own, offs, span} :=
    rewrite(sym(ea), rewrite(sym(esh), rewrite(sym(eu), rewrite(sym(em), expand(gok, mallocng.group_ok, mallocng.masks_ok, mallocng.big_ok, mallocng.slot_ok, mallocng.is_used)))))
  have ne2: A1.metas[h].maplen = 0 -> (ex x0. ex x1. (x0 in omega && x1 in omega) &&
      ((int_lt(x0, seq_len(A1.used)) && int_lt(x1, seq_len(A1.slots[A1.used[x0]]))) && A1.slots[A1.used[x0]][x1] = tag(2, h))) proof
    assume z
    obtain p j, hp hj hpl hjl hs from mp(nested, rewrite(em, z))
    have s2 := apply(mp.su_slot0[A := A, g := g, i := i, u := u, p := A.used[p], j := j, v := tag(2, h)], hn, hs)
    have l2: int_lt(j, seq_len(A1.slots[A.used[p]])) := rewrite(sym(apply(mp.su_len[A := A, g := g, i := i, u := u, p := A.used[p]], ha, hg, hi, hil, hu)), hjl)
    show by ex_intro({p}, {j}, taut(hp, hj, rewrite(sym(eu), hpl), rewrite(sym(eu), l2), rewrite(sym(eu), s2)))
  qed
  show by defs(conj(mim, cls, hdr, hdr_own, act, nslots, masks, small, mapped, ne2, big, linked, unlinked, slots, sentinel, chk_own, offs, span),
    mallocng.group_ok, mallocng.masks_ok, mallocng.big_ok, mallocng.slot_ok, mallocng.is_used)
qed

theorem mp.su_group(A, g, i, u, M, b, h): A in mallocng.Abs -> g in omega -> i in omega -> int_lt(i, seq_len(A.slots[g])) -> u in mallocng.Use ->
  A.slots[g][i] = tag(3, empty) -> !(h = g) -> mallocng.group_ok(A, M, b, h) ->
  mallocng.group_ok(mp.setu(A, g, i, u), M, b, h)
proof
  assume ha hg hi hil hu hr hne gok
  have hn: !(A.slots[g][i] = tag(2, h)) by defs(simp(hr), tag)
  show := apply(mp.su_group0[A := A, g := g, i := i, u := u, M := M, b := b, h := h], ha, hg, hi, hil, hu, hn, hne, gok)
qed

theorem mp.nt_group(A, g, i, m, M, b, h): A in mallocng.Abs -> g in omega -> i in omega -> int_lt(i, seq_len(A.slots[g])) -> m in omega ->
  A.slots[g][i] = tag(3, empty) -> !(h = g) -> mallocng.group_ok(A, M, b, h) ->
  mallocng.group_ok(mp.nest(A, g, i, m), M, b, h)
proof
  assume ha hg hi hil hm hr hne gok
  show := apply(mp.su_group[A := A, g := g, i := i, u := tag(2, m), M := M, b := b, h := h], ha, hg, hi, hil, apply(mp.use2, hm), hr, hne, gok)
qed

// the parent g, its slot i now holding m: in a state keeping its record,
// its list, the groups in use with theirs, its own nesting, m's slot as
// the parent's frame has it
theorem mp.su_parent0(A, A2, M, b, g, i, u): A in mallocng.Abs -> g in omega -> i in omega -> int_lt(i, seq_len(A.slots[g])) -> u in mallocng.Use ->
  !(u = tag(0, empty)) -> !(A.slots[g][i] = tag(0, empty)) -> mallocng.group_ok(A, M, b, g) ->
  A2.metas[g] = A.metas[g] -> A2.slots[g] = fn_update(A.slots[g], i, u) -> A2.active = A.active ->
  (all h. mallocng.is_used(A, h) -> mallocng.is_used(A2, h) && A2.metas[h] = A.metas[h]) ->
  (A2.metas[g].maplen = 0 -> (ex x0. ex x1. (x0 in omega && x1 in omega) &&
     ((int_lt(x0, seq_len(A2.used)) && int_lt(x1, seq_len(A2.slots[A2.used[x0]]))) && A2.slots[A2.used[x0]][x1] = tag(2, g)))) ->
  mallocng.slot_ok(A2, M, b, g, i, u) ->
  mallocng.group_ok(A2, M, b, g)
proof
  assume ha hg hi hil u2 hu0 hr gok emg esg ea emu ne2 soi
  have {mim, cls, hdr, hdr_own, act, nslots, masks, small, mapped, big, linked, unlinked, slots, sentinel, chk_own, offs, span} :=
    rewrite(sym(ea), rewrite(sym(emg), expand(gok, mallocng.group_ok)))
  have slt: A.slots[g] in list_type(mallocng.Use) := mp(fn_space_app[a := omega, b := list_type(mallocng.Use), f := A.slots, x := g], simp(ha), hg)
  have {ln = len} := apply(mp.list_upd[l := A.slots[g], t := mallocng.Use, i := i, v := u], slt, hi, hil, u2)
  have sl: seq_len(A2.slots[g]) = seq_len(A.slots[g]) := rewrite(sym(esg), ln)
  have ei: A2.slots[g][i] = u by simp(esg)
  have el: all j. !(j = i) -> A2.slots[g][j] = A.slots[g][j] proof
    fix j
    assume ne
    show := rewrite(sym(esg), mp(app_update_other[f := A.slots[g], k := i, v := u, x := j], ne))
  qed
  // (slot j unused: as before -- the slot i neither)
  have ue: all j. A2.slots[g][j] = tag(0, empty) <-> A.slots[g][j] = tag(0, empty) proof
    fix j
    have c1: j = i -> (A2.slots[g][j] = tag(0, empty) <-> A.slots[g][j] = tag(0, empty)) proof
      assume e
      have n1: !(A2.slots[g][j] = tag(0, empty)) := rewrite(sym(rewrite(sym(e), ei)), hu0)
      have n2: !(A.slots[g][j] = tag(0, empty)) := rewrite(sym(e), hr)
      show by taut(n1, n2)
    qed
    have c2: !(j = i) -> (A2.slots[g][j] = tag(0, empty) <-> A.slots[g][j] = tag(0, empty)) proof
      assume ne
      show by simp(mp(all_elim(el, {j}), ne))
    qed
    show by taut(c1, c2)
  qed
  have mk0 := rewrite(sym(emg), expand(masks, mallocng.masks_ok))
  have mk: all x0. x0 in omega -> int_lt(x0, 32) ->
      (((mallocng.bit(A2.metas[g].avail, x0) = 1 -> int_le(x0, int_mod(mallocng.b8(M, int_add(A2.metas[g].mem, 8)), 32)) && mallocng.bit(A2.metas[g].freed, x0) = 0) &&
        (int_lt(0, int_add(mallocng.bit(A2.metas[g].avail, x0), mallocng.bit(A2.metas[g].freed, x0))) -> int_le(x0, A2.metas[g].last_idx))) &&
       (int_le(x0, A2.metas[g].last_idx) -> (A2.slots[g][x0] = tag(0, empty) <-> int_lt(0, int_add(mallocng.bit(A2.metas[g].avail, x0), mallocng.bit(A2.metas[g].freed, x0)))) &&
          mallocng.b8(M, int_sub(mallocng.slot_start(A2.metas[g], x0), 4)) = 0)) &&
      (int_lt(int_mod(mallocng.b8(M, int_add(A2.metas[g].mem, 8)), 32), x0) && int_le(x0, A2.metas[g].last_idx) -> mallocng.bit(A2.metas[g].freed, x0) = 1) proof
    fix j
    assume hj hjl
    show by taut(mp(all_elim(mk0, {j}), hj, hjl), all_elim(ue, {j}))
  qed
  have msk2: mallocng.masks_ok(A2, M, g) by defs(mk, mallocng.masks_ok)
  have big2: mallocng.big_ok(A2, g) by defs(rewrite(sym(emg), expand(big, mallocng.big_ok)), mallocng.big_ok)
  have ns2: seq_len(A2.slots[g]) = int_add(A2.metas[g].last_idx, 1) := trans(sl, nslots)
  have sl2: all x0. x0 in omega -> int_lt(x0, seq_len(A2.slots[g])) -> mallocng.slot_ok(A2, M, b, g, x0, A2.slots[g][x0]) proof
    fix j
    assume hj hjl0
    have hjl: int_lt(j, seq_len(A.slots[g])) := rewrite(sl, hjl0)
    have c1: j = i -> mallocng.slot_ok(A2, M, b, g, j, A2.slots[g][j]) proof
      assume e
      show := rewrite(sym(e), rewrite(sym(ei), soi))
    qed
    have c2: !(j = i) -> mallocng.slot_ok(A2, M, b, g, j, A2.slots[g][j]) proof
      assume ne
      have ut := apply(at_type[l := A.slots[g], t := mallocng.Use, i := j], slt, hj, hjl)
      have s := apply(mp.slot_tr[A := A, A2 := A2, M := M, b := b, g := g, j := j, u := A.slots[g][j]], ut, emg, emu, mp(all_elim(slots, {j}), hj, hjl))
      show := rewrite(sym(mp(all_elim(el, {j}), ne)), s)
    qed
    show by taut(c1, c2)
  qed
  show by defs(taut(mim, cls, hdr, hdr_own, act, ns2, msk2, small, mapped, ne2, big2, linked, unlinked, sl2, sentinel, chk_own, offs, span), mallocng.group_ok)
qed

theorem mp.su_parent(A, A2, M, b, g, i, u): A in mallocng.Abs -> g in omega -> i in omega -> int_lt(i, seq_len(A.slots[g])) -> u in mallocng.Use ->
  !(u = tag(0, empty)) -> A.slots[g][i] = tag(3, empty) -> mallocng.group_ok(A, M, b, g) ->
  A2.metas[g] = A.metas[g] -> A2.slots[g] = fn_update(A.slots[g], i, u) -> A2.active = A.active ->
  (all h. mallocng.is_used(A, h) -> mallocng.is_used(A2, h) && A2.metas[h] = A.metas[h]) ->
  (A2.metas[g].maplen = 0 -> (ex x0. ex x1. (x0 in omega && x1 in omega) &&
     ((int_lt(x0, seq_len(A2.used)) && int_lt(x1, seq_len(A2.slots[A2.used[x0]]))) && A2.slots[A2.used[x0]][x1] = tag(2, g)))) ->
  mallocng.slot_ok(A2, M, b, g, i, u) ->
  mallocng.group_ok(A2, M, b, g)
proof
  assume ha hg hi hil u2 hu0 hr gok emg esg ea emu ne2 soi
  show := apply(mp.su_parent0[A := A, A2 := A2, M := M, b := b, g := g, i := i, u := u], ha, hg, hi, hil, u2, hu0,
    (!(A.slots[g][i] = tag(0, empty)) by defs(simp(hr), tag)), gok, emg, esg, ea, emu, ne2, soi)
qed

theorem mp.nt_parent(A, A2, M, b, g, i, m): A in mallocng.Abs -> g in omega -> i in omega -> int_lt(i, seq_len(A.slots[g])) -> m in omega ->
  A.slots[g][i] = tag(3, empty) -> mallocng.group_ok(A, M, b, g) ->
  A2.metas[g] = A.metas[g] -> A2.slots[g] = fn_update(A.slots[g], i, tag(2, m)) -> A2.active = A.active ->
  (all h. mallocng.is_used(A, h) -> mallocng.is_used(A2, h) && A2.metas[h] = A.metas[h]) ->
  (A2.metas[g].maplen = 0 -> (ex x0. ex x1. (x0 in omega && x1 in omega) &&
     ((int_lt(x0, seq_len(A2.used)) && int_lt(x1, seq_len(A2.slots[A2.used[x0]]))) && A2.slots[A2.used[x0]][x1] = tag(2, g)))) ->
  mallocng.slot_ok(A2, M, b, g, i, tag(2, m)) ->
  mallocng.group_ok(A2, M, b, g)
proof
  assume ha hg hi hil hm hr gok emg esg ea emu ne2 soi
  show := apply(mp.su_parent[A := A, A2 := A2, M := M, b := b, g := g, i := i, u := tag(2, m)], ha, hg, hi, hil, apply(mp.use2, hm),
    (!(tag(2, m) = tag(0, empty)) by defs(simp(), tag)), hr, gok, emg, esg, ea, emu, ne2, soi)
qed

// the state's other clauses: as before (the slot's use not read, but a
// slot unused or holding a block)
theorem mp.su_clauses0(c, A, g, i, u, M, b): A in mallocng.Abs -> g in omega -> i in omega -> int_lt(i, seq_len(A.slots[g])) -> u in mallocng.Use ->
  !(u = tag(0, empty)) -> (all q. q in bits(64) -> !(b[q] = none) -> !(A.slots[g][i] = tag(1, q))) -> mallocng.is_used(A, g) ->
  mallocng.metas_partition(A) -> mallocng.active_ok(A) -> mallocng.partial_ok(A, M) -> mallocng.reuse_ok(A) -> mallocng.blocks_ok(A, b) ->
  mallocng.normal(A) -> mallocng.separate(mallocng.regions(c, A)) -> mallocng.fixed_free(c, A, b) -> mallocng.groups_apart(c, A) -> mallocng.areas_ok(c, A, M) ->
  part: mallocng.metas_partition(mp.setu(A, g, i, u)) && active: mallocng.active_ok(mp.setu(A, g, i, u)) && partial: mallocng.partial_ok(mp.setu(A, g, i, u), M) &&
  reuse: mallocng.reuse_ok(mp.setu(A, g, i, u)) && in_slots: mallocng.blocks_ok(mp.setu(A, g, i, u), b) && normal: mallocng.normal(mp.setu(A, g, i, u)) &&
  sep: mallocng.separate(mallocng.regions(c, mp.setu(A, g, i, u))) && fixed: mallocng.fixed_free(c, mp.setu(A, g, i, u), b) &&
  apart: mallocng.groups_apart(c, mp.setu(A, g, i, u)) && areas: mallocng.areas_ok(c, mp.setu(A, g, i, u), M)
proof
  assume ha hg hi hil hm hu0 hr iug hp hac hpa hre hbl hnm hsp hff hga har
  let A1 := mp.setu(A, g, i, u)
  have eu: A1.used = A.used by simp()
  have ef: A1.free_metas = A.free_metas by simp()
  have eas: A1.areas = A.areas by simp()
  have eac: A1.avail_cnt = A.avail_cnt by simp()
  have et: A1.taken = A.taken by simp()
  have em: A1.metas = A.metas by simp()
  have ea: A1.active = A.active by simp()
  have pt: mallocng.metas_partition(A1) by defs(rewrite(sym(et), rewrite(sym(eac), rewrite(sym(eas), rewrite(sym(ef), rewrite(sym(eu),
    expand(hp, mallocng.metas_partition, mallocng.is_used, mallocng.meta_slot, mallocng.avail_meta)))))),
    mallocng.metas_partition, mallocng.is_used, mallocng.meta_slot, mallocng.avail_meta)
  have ac: mallocng.active_ok(A1) by defs(rewrite(sym(ea), rewrite(sym(em), rewrite(sym(eu), expand(hac, mallocng.active_ok, mallocng.is_used)))), mallocng.active_ok, mallocng.is_used)
  have pa: mallocng.partial_ok(A1, M) by defs(rewrite(sym(ea), rewrite(sym(em), expand(hpa, mallocng.partial_ok, mallocng.partial))), mallocng.partial_ok, mallocng.partial)
  have er: mallocng.regions(c, A1) = mallocng.regions(c, A) by defs(simp(), mallocng.regions)
  have sp := rewrite(sym(er), hsp)
  have ff: mallocng.fixed_free(c, A1, b) by defs(simp(expand(hff, mallocng.fixed_free)), mallocng.fixed_free)
  have fe: mallocng.fixed_ranges(c, A1) = mallocng.fixed_ranges(c, A) by defs(simp(), mallocng.fixed_ranges, mallocng.auxv_ranges)
  have ga: mallocng.groups_apart(c, A1) by defs(simp(fe, expand(hga, mallocng.groups_apart)), mallocng.groups_apart)
  have ar: mallocng.areas_ok(c, A1, M) by defs(simp(expand(har, mallocng.areas_ok, mallocng.in_taken)), mallocng.areas_ok, mallocng.in_taken)
  // reuse: a slot unused as before
  have hu: all h. mallocng.has_unused(A1, h) -> mallocng.has_unused(A, h) proof
    fix h
    assume e
    obtain j, hj hjl hs from expand(e, mallocng.has_unused)
    have l: int_lt(j, seq_len(A.slots[h])) := rewrite(apply(mp.su_len[A := A, g := g, i := i, u := u, p := h], ha, hg, hi, hil, hm), hjl)
    have c1: h = g && j = i -> false proof
      assume w
      have e1 e2 := w
      have s: A1.slots[h][j] = u by simp(e1, e2)
      show by taut(hu0, trans(sym(s), hs))
    qed
    have c2: !(h = g && j = i) -> A.slots[h][j] = tag(0, empty) proof
      assume ne
      have c3: h = g -> A.slots[h][j] = tag(0, empty) proof
        assume e1
        have ji: !(j = i) by taut(ne, e1)
        have s: A1.slots[h] = fn_update(A.slots[g], i, u) by simp(e1)
        show := rewrite(sym(e1), trans(sym(mp(app_update_other[f := A.slots[g], k := i, v := u, x := j], ji)), rewrite(s, hs)))
      qed
      have c4: !(h = g) -> A.slots[h][j] = tag(0, empty) proof
        assume e1
        have s: A1.slots[h] = A.slots[h] by simp(mp(app_update_other[f := A.slots, k := g, v := fn_update(A.slots[g], i, u), x := h], e1))
        show := rewrite(s, hs)
      qed
      show by taut(c3, c4)
    qed
    have s0: A.slots[h][j] = tag(0, empty) by taut(c1, c2)
    show by defs(ex_intro({j}, taut(hj, l, s0)), mallocng.has_unused)
  qed
  have k3: all x0. all x1. x0 in omega && x1 in omega -> (int_lt(x0, 48) && mallocng.on_list(A1.active[x0], x1)) && mallocng.has_unused(A1, x1) ->
      !mallocng.own_mapping(A1.metas[x1]) proof
    fix sc h
    assume ho w
    have hsl o q := w
    have r := mp(all_elim(expand(hre, mallocng.reuse_ok), {sc}, {h}), ho, taut(hsl, (mallocng.on_list(A.active[sc], h) by simp(o)), mp(all_elim(hu, {h}), q)))
    show by simp(r)
  qed
  have re: mallocng.reuse_ok(A1) by defs(k3, mallocng.reuse_ok)
  // the live blocks: in their slots as before
  have k4: all x0. x0 in bits(64) -> !(b[x0] = none) -> (ex x1. ex x2. (x1 in omega && x2 in omega) &&
      ((int_lt(x1, seq_len(A1.used)) && int_lt(x2, seq_len(A1.slots[A1.used[x1]]))) && A1.slots[A1.used[x1]][x2] = tag(1, x0))) proof
    fix p
    assume hp0 hn
    obtain q j, hq hj hql hjl hs from mp(all_elim(expand(hbl, mallocng.blocks_ok), {p}), hp0, hn)
    have s2 := apply(mp.su_slot0[A := A, g := g, i := i, u := u, p := A.used[q], j := j, v := tag(1, p)], mp(all_elim(hr, {p}), hp0, hn), hs)
    have l2: int_lt(j, seq_len(A1.slots[A.used[q]])) := rewrite(sym(apply(mp.su_len[A := A, g := g, i := i, u := u, p := A.used[q]], ha, hg, hi, hil, hm)), hjl)
    have eu: A1.used = A.used by simp()
    show by ex_intro({q}, {j}, taut(hq, hj, rewrite(sym(eu), hql), rewrite(sym(eu), l2), rewrite(sym(eu), s2)))
  qed
  have bl: mallocng.blocks_ok(A1, b) by defs(k4, mallocng.blocks_ok)
  // normal: the metas not in use as before (g in use)
  have {nu = unused, ni = init, nr = reserve, nz = zero} := expand(hnm, mallocng.normal)
  have k1: all x0. x0 in omega -> !mallocng.is_used(A1, x0) -> A1.metas[x0] = mallocng.ZERO_META && seq_len(A1.slots[x0]) = 0 proof
    fix x
    assume hx hn
    have hn0: !mallocng.is_used(A, x) by defs(simp(expand(hn, mallocng.is_used)), mallocng.is_used)
    have z1 z2 := mp(all_elim(nu, {x}), hx, hn0)
    have ln := apply(mp.su_len[A := A, g := g, i := i, u := u, p := x], ha, hg, hi, hil, hm)
    show by simp(z1, trans(ln, z2))
  qed
  have k5: !mallocng.is_used(A1, 0) by defs(simp(expand(nz, mallocng.is_used)), mallocng.is_used)
  have nm: mallocng.normal(A1) by defs(simp(k1, ni, nr, k5, keep(mallocng.is_used, mallocng.ZERO_META)), mallocng.normal)
  show by taut(pt, ac, pa, re, bl, nm, sp, ff, ga, ar)
qed

theorem mp.su_clauses(c, A, g, i, u, M, b): A in mallocng.Abs -> g in omega -> i in omega -> int_lt(i, seq_len(A.slots[g])) -> u in mallocng.Use ->
  !(u = tag(0, empty)) -> A.slots[g][i] = tag(3, empty) -> mallocng.is_used(A, g) ->
  mallocng.metas_partition(A) -> mallocng.active_ok(A) -> mallocng.partial_ok(A, M) -> mallocng.reuse_ok(A) -> mallocng.blocks_ok(A, b) ->
  mallocng.normal(A) -> mallocng.separate(mallocng.regions(c, A)) -> mallocng.fixed_free(c, A, b) -> mallocng.groups_apart(c, A) -> mallocng.areas_ok(c, A, M) ->
  part: mallocng.metas_partition(mp.setu(A, g, i, u)) && active: mallocng.active_ok(mp.setu(A, g, i, u)) && partial: mallocng.partial_ok(mp.setu(A, g, i, u), M) &&
  reuse: mallocng.reuse_ok(mp.setu(A, g, i, u)) && in_slots: mallocng.blocks_ok(mp.setu(A, g, i, u), b) && normal: mallocng.normal(mp.setu(A, g, i, u)) &&
  sep: mallocng.separate(mallocng.regions(c, mp.setu(A, g, i, u))) && fixed: mallocng.fixed_free(c, mp.setu(A, g, i, u), b) &&
  apart: mallocng.groups_apart(c, mp.setu(A, g, i, u)) && areas: mallocng.areas_ok(c, mp.setu(A, g, i, u), M)
proof
  assume ha hg hi hil hm hu0 hr iug hp hac hpa hre hbl hnm hsp hff hga har
  have nb: all q. q in bits(64) -> !(b[q] = none) -> !(A.slots[g][i] = tag(1, q)) proof
    fix q
    assume _ _
    show by defs(simp(hr), tag)
  qed
  show := apply(mp.su_clauses0[c := c, A := A, g := g, i := i, u := u, M := M, b := b], ha, hg, hi, hil, hm, hu0, nb, iug, hp, hac, hpa, hre, hbl, hnm, hsp, hff, hga, har)
qed

theorem mp.nt_clauses(c, A, g, i, m, M, b): A in mallocng.Abs -> g in omega -> i in omega -> int_lt(i, seq_len(A.slots[g])) -> m in omega ->
  A.slots[g][i] = tag(3, empty) -> mallocng.is_used(A, g) ->
  mallocng.metas_partition(A) -> mallocng.active_ok(A) -> mallocng.partial_ok(A, M) -> mallocng.reuse_ok(A) -> mallocng.blocks_ok(A, b) ->
  mallocng.normal(A) -> mallocng.separate(mallocng.regions(c, A)) -> mallocng.fixed_free(c, A, b) -> mallocng.groups_apart(c, A) -> mallocng.areas_ok(c, A, M) ->
  part: mallocng.metas_partition(mp.nest(A, g, i, m)) && active: mallocng.active_ok(mp.nest(A, g, i, m)) && partial: mallocng.partial_ok(mp.nest(A, g, i, m), M) &&
  reuse: mallocng.reuse_ok(mp.nest(A, g, i, m)) && in_slots: mallocng.blocks_ok(mp.nest(A, g, i, m), b) && normal: mallocng.normal(mp.nest(A, g, i, m)) &&
  sep: mallocng.separate(mallocng.regions(c, mp.nest(A, g, i, m))) && fixed: mallocng.fixed_free(c, mp.nest(A, g, i, m), b) &&
  apart: mallocng.groups_apart(c, mp.nest(A, g, i, m)) && areas: mallocng.areas_ok(c, mp.nest(A, g, i, m), M)
proof
  assume ha hg hi hil hm hr iug hp hac hpa hre hbl hnm hsp hff hga har
  show := apply(mp.su_clauses[c := c, A := A, g := g, i := i, u := tag(2, m), M := M, b := b], ha, hg, hi, hil, apply(mp.use2, hm),
    (!(tag(2, m) = tag(0, empty)) by defs(simp(), tag)), hr, iug, hp, hac, hpa, hre, hbl, hnm, hsp, hff, hga, har)
qed

// (a byte reserved before, not now: in the slot i of g)
theorem mp.su_inres(A, g, i, u, a): A in mallocng.Abs -> g in omega -> i in omega -> int_lt(i, seq_len(A.slots[g])) -> u in mallocng.Use ->
  A.slots[g][i] = tag(3, empty) -> mallocng.in_reserved(A, a) -> !mallocng.in_reserved(mp.setu(A, g, i, u), a) ->
  mallocng.in_slot(A.metas[g], i, a)
proof
  assume ha hg hi hil hm hr h nr
  obtain p j, hp hj iu hjl hs hin from expand(h, mallocng.in_reserved)
  have c1: p = g && j = i -> mallocng.in_slot(A.metas[g], i, a) proof
    assume w
    have e1 e2 := w
    show := rewrite(e2, rewrite(e1, hin))
  qed
  have c2: !(p = g && j = i) -> mallocng.in_slot(A.metas[g], i, a) proof
    assume ne
    have s2: mp.setu(A, g, i, u).slots[p][j] = tag(3, empty) proof
      have d1: p = g -> mp.setu(A, g, i, u).slots[p][j] = tag(3, empty) proof
        assume e
        have ji: !(j = i) by taut(ne, e)
        have s: mp.setu(A, g, i, u).slots[p] = fn_update(A.slots[g], i, u) by simp(e)
        show := trans(rewrite(sym(s), mp(app_update_other[f := A.slots[g], k := i, v := u, x := j], ji)), rewrite(e, hs))
      qed
      have d2: !(p = g) -> mp.setu(A, g, i, u).slots[p][j] = tag(3, empty) proof
        assume e
        have s: mp.setu(A, g, i, u).slots[p] = A.slots[p] by simp(mp(app_update_other[f := A.slots, k := g, v := fn_update(A.slots[g], i, u), x := p], e))
        show := rewrite(sym(s), hs)
      qed
      show by taut(d1, d2)
    qed
    have l2: int_lt(j, seq_len(mp.setu(A, g, i, u).slots[p])) := rewrite(sym(apply(mp.su_len[A := A, g := g, i := i, u := u, p := p], ha, hg, hi, hil, hm)), hjl)
    have iu2: mallocng.is_used(mp.setu(A, g, i, u), p) by defs(simp(expand(iu, mallocng.is_used)), mallocng.is_used)
    have r: mallocng.in_reserved(mp.setu(A, g, i, u), a) by defs(ex_intro({p}, {j}, taut(hp, hj, iu2, l2, s2, (mallocng.in_slot(mp.setu(A, g, i, u).metas[p], j, a) by simp(hin)))),
      mallocng.in_reserved)
    show by taut(r, nr)
  qed
  show by taut(c1, c2)
qed

theorem mp.nt_inres(A, g, i, m, a): A in mallocng.Abs -> g in omega -> i in omega -> int_lt(i, seq_len(A.slots[g])) -> m in omega ->
  A.slots[g][i] = tag(3, empty) -> mallocng.in_reserved(A, a) -> !mallocng.in_reserved(mp.nest(A, g, i, m), a) ->
  mallocng.in_slot(A.metas[g], i, a)
proof
  assume ha hg hi hil hm hr h nr
  show := apply(mp.su_inres[A := A, g := g, i := i, u := tag(2, m), a := a], ha, hg, hi, hil, apply(mp.use2, hm), hr, h, nr)
qed

// the allocator's memory accessible: as before, the slot's interior (no
// longer reserved) too
theorem mp.su_perms(c, A, g, i, u, M, b): A in mallocng.Abs -> g in omega -> i in omega -> int_lt(i, seq_len(A.slots[g])) -> u in mallocng.Use ->
  A.slots[g][i] = tag(3, empty) -> mallocng.perms_ok(c, A, M, b) ->
  (all a. a in omega -> mallocng.in_slot(A.metas[g], i, a) -> !(a in malloc.live_of(b)) -> mallocng.m_rw(M, a) && !(snd(mallocng.pg(M, a)).kind = 2)) ->
  mallocng.perms_ok(c, mp.setu(A, g, i, u), M, b)
proof
  assume ha hg hi hil hm hr hp hv
  let A1 := mp.setu(A, g, i, u)
  have {pd = data, pgr = groups, pa = auxv} := expand(hp, mallocng.perms_ok)
  have xe: mallocng.auxv_ranges(A1) = mallocng.auxv_ranges(A) by defs(simp(), mallocng.auxv_ranges)
  have eu: A1.used = A.used by simp()
  have em: A1.metas = A.metas by simp()
  have g2: all x0. all x1. x0 in omega && x1 in omega -> (((int_lt(x0, seq_len(A1.used)) && int_le(fst(mallocng.group_range(A1.metas[A1.used[x0]])), x1)) &&
      int_lt(x1, int_add(fst(mallocng.group_range(A1.metas[A1.used[x0]])), snd(mallocng.group_range(A1.metas[A1.used[x0]]))))) && !(x1 in malloc.live_of(b))) &&
      !mallocng.in_reserved(A1, x1) -> mallocng.m_rw(M, x1) && !(snd(mallocng.pg(M, x1)).kind = 2) proof
    fix j a
    assume ho h
    have hj hao := ho
    have hjl h1 h2 nl nr := h
    have c1: mallocng.in_reserved(A, a) -> mallocng.m_rw(M, a) && !(snd(mallocng.pg(M, a)).kind = 2) proof
      assume r
      show := mp(all_elim(hv, {a}), hao, apply(mp.su_inres[A := A, g := g, i := i, u := u, a := a], ha, hg, hi, hil, hm, hr, r, nr), nl)
    qed
    have c2: !mallocng.in_reserved(A, a) -> mallocng.m_rw(M, a) && !(snd(mallocng.pg(M, a)).kind = 2) proof
      assume nr0
      show := mp(all_elim(pgr, {j}, {a}), ho, taut(rewrite(eu, hjl), rewrite(eu, rewrite(em, h1)), rewrite(eu, rewrite(em, h2)), nl, nr0))
    qed
    show by taut(c1, c2)
  qed
  show by defs(taut(pd, g2, rewrite(sym(xe), pa)), mallocng.perms_ok)
qed

theorem mp.nt_perms(c, A, g, i, m, M, b): A in mallocng.Abs -> g in omega -> i in omega -> int_lt(i, seq_len(A.slots[g])) -> m in omega ->
  A.slots[g][i] = tag(3, empty) -> mallocng.perms_ok(c, A, M, b) ->
  (all a. a in omega -> mallocng.in_slot(A.metas[g], i, a) -> !(a in malloc.live_of(b)) -> mallocng.m_rw(M, a) && !(snd(mallocng.pg(M, a)).kind = 2)) ->
  mallocng.perms_ok(c, mp.nest(A, g, i, m), M, b)
proof
  assume ha hg hi hil hm hr hp hv
  show := apply(mp.su_perms[c := c, A := A, g := g, i := i, u := tag(2, m), M := M, b := b], ha, hg, hi, hil, apply(mp.use2, hm), hr, hp, hv)
qed

// the state with the group m made in slot i of g
abbrev mp.ngn(A, g, i, k, T, m, V, n) := mp.ngrp(mp.nest(A, g, i, m), k, T, m, V, n)

// (m nested: in slot i of g, a group in use)
theorem mp.ngn_wit(A, g, i, k, T, m, V, n): A in mallocng.Abs -> g in omega -> i in omega -> int_lt(i, seq_len(A.slots[g])) -> m in omega ->
  mallocng.is_used(A, g) -> !mallocng.is_used(A, m) -> k in omega -> int_le(k, seq_len(A.used)) ->
  (ex x0. ex x1. (x0 in omega && x1 in omega) && ((int_lt(x0, seq_len(mp.ngn(A, g, i, k, T, m, V, n).used)) &&
     int_lt(x1, seq_len(mp.ngn(A, g, i, k, T, m, V, n).slots[mp.ngn(A, g, i, k, T, m, V, n).used[x0]]))) && mp.ngn(A, g, i, k, T, m, V, n).slots[mp.ngn(A, g, i, k, T, m, V, n).used[x0]][x1] = tag(2, m)))
proof
  assume ha hg hi hil hm iug nm hk hkl
  let A1 := mp.nest(A, g, i, m)
  have {a1 = abs} := apply(mp.nest_type[A := A, h := g, i := i, m := m], ha, hg, hi, hil, hm)
  obtain j, hj hjl hje from expand(iug, mallocng.is_used)
  have eu: A1.used = A.used by simp()
  have s: A1.slots[A1.used[j]][i] = tag(2, m) by simp(hje)
  have eg: A1.used[j] = g by simp(hje)
  have l := subst({y. int_lt(i, seq_len(A1.slots[y]))}, sym(eg), rewrite(sym(apply(mp.nt_len[A := A, g := g, i := i, m := m, p := g], ha, hg, hi, hil, hm)), hil))
  have w: ex x0. ex x1. (x0 in omega && x1 in omega) && ((int_lt(x0, seq_len(A1.used)) && int_lt(x1, seq_len(A1.slots[A1.used[x0]]))) && A1.slots[A1.used[x0]][x1] = tag(2, m))
    by ex_intro({j}, {i}, taut(hj, hi, rewrite(sym(eu), hjl), l, s))
  have nm1: !mallocng.is_used(A1, m) by defs(simp(expand(nm, mallocng.is_used)), mallocng.is_used)
  show := apply(mp.ng_at[A := A1, k := k, T := T, m := m, V := V, n := n, u := tag(2, m)], a1, hk, rewrite(sym(eu), hkl), hm, nm1, w)
qed

// the invariant after a group made from the meta taken last in the slot i
// of g reserved for it: the parent's frame of it, the slot's interior
// accessible; the rest as for one mapped on its own
theorem mp.ngn_holds(c, A, g, i, k, T, m, V, n, M, M2, b, brk, brk2): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs ->
  b in fn_space(bits(64), option(omega)) -> mallocng.holds(c, A, M, b, brk) ->
  mallocng.is_used(A, g) -> i in omega -> int_lt(i, seq_len(A.slots[g])) -> A.slots[g][i] = tag(3, empty) ->
  T in list_type(omega) -> A.taken = seq_concat(T, seq_one(m)) -> !(m = 0) -> V in mallocng.MetaV -> n in omega ->
  k in omega -> int_le(k, seq_len(A.used)) ->
  (all j. j in omega -> int_lt(j, k) -> int_lt(A.used[j], m)) -> (all j. j in omega -> int_le(k, j) -> int_lt(j, seq_len(A.used)) -> int_lt(m, A.used[j])) ->
  (all a. a in omega -> mp.ingrp(A, a) -> M2[a] = M[a]) ->
  (all h. all a. mallocng.is_used(A, h) -> a in omega -> int_le(h, a) -> int_lt(a, int_add(h, 40)) -> M2[a] = M[a]) ->
  V.maplen = 0 -> mallocng.hdr_free(b, V.mem) ->
  mallocng.frame_ok(M2, A.metas[g], i, V.mem, int_sub(int_add(mallocng.UNIT, int_mul(mallocng.stride(V), int_add(V.last_idx, 1))), mallocng.IB), 6) ->
  (all a. a in omega -> mallocng.in_slot(A.metas[g], i, a) -> !(a in malloc.live_of(b)) -> mallocng.m_rw(M2, a) && !(snd(mallocng.pg(M2, a)).kind = 2)) ->
  mallocng.group_ok(mp.ngn(A, g, i, k, T, m, V, n), M2, b, m) ->
  mallocng.image_ok(c, M2) -> mallocng.ctx_ok(c, mp.ngn(A, g, i, k, T, m, V, n), M2) -> mallocng.fresh_ok(c, mp.ngn(A, g, i, k, T, m, V, n), M2) ->
  mallocng.areas_ok(c, A, M2) ->
  (all a. a in omega -> int_le(m, a) -> int_lt(a, int_add(m, mallocng.META_SIZE)) -> mallocng.m_rw(M2, a) && !(snd(mallocng.pg(M2, a)).kind = 2)) ->
  mallocng.brk_ok(mp.ngn(A, g, i, k, T, m, V, n), brk2) -> mallocng.perms_ok(c, A, M2, b) ->
  (all a. a in omega -> mallocng.in_range(a, mallocng.group_range(V)) -> !(a in malloc.live_of(b)) -> mallocng.m_rw(M2, a) && !(snd(mallocng.pg(M2, a)).kind = 2)) ->
  mallocng.classes_ok(c, M2) -> mallocng.debruijn_ok(c, M2) ->
  (all a. a in omega -> mallocng.in_range(a, mallocng.group_range(V)) -> !mallocng.in_ranges(a, mallocng.fixed_ranges(c, A))) ->
  mallocng.holds(c, mp.ngn(A, g, i, k, T, m, V, n), M2, b, brk2)
proof
  assume hc hu ha hb H iug hi hil hr ht hte hmz hv hn hk hkl hlo hhi gbs rcs vz vhf vfr srw gm img cok fr ar mrw bk pm gpm cl db apt
  let A1 := mp.nest(A, g, i, m)
  let X := mp.ngn(A, g, i, k, T, m, V, n)
  have {hp = part, huo = used, hac = active, hpa = partial, hre = reuse, hbl = in_slots, hnm = normal, hsp = sep, hwf = wf, hff = fixed, hga = apart} :=
    expand(H, mallocng.holds)
  have {hm = nat, nm = unused} := apply(mp.ng_taken[A := A, T := T, m := m], ha, hp, ht, hte)
  have {hg = nat} := apply(mp.used_nat, ha, iug)
  have gm0: !(g = m) proof
    assume e
    show by taut(rewrite(e, iug), nm)
  qed
  have {a1 = abs, u1 = univ} := apply(mp.nest_type[A := A, h := g, i := i, m := m], ha, hg, hi, hil, hm)
  // the old groups on the new memory
  have er: A.metas = A.metas && A.slots = A.slots && A.used = A.used && A.active = A.active by simp()
  have e1 e2 e3 e4 := er
  have uo := apply(mp.used_tr[A := A, A2 := A, M := M, M2 := M2, b := b], ha, hb, e1, e2, e3, e4, huo, gbs, rcs)
  have p1 := apply(mp.partial_tr[A := A, A2 := A, M := M, M2 := M2, b := b], ha, e1, e4, hac, huo, hpa, gbs)
  // the state with the slot holding m
  have {pt1 = part, ac1 = active, pa1 = partial, re1 = reuse, bl1 = in_slots, nm1 = normal, sp1 = sep, ff1 = fixed, ga1 = apart, ar1 = areas} :=
    apply(mp.nt_clauses[c := c, A := A, g := g, i := i, m := m, M := M2, b := b], ha, hg, hi, hil, hm, hr, iug, hp, hac, p1, hre, hbl, hnm, hsp, hff, hga, ar)
  have pm1 := apply(mp.nt_perms[c := c, A := A, g := g, i := i, m := m, M := M2, b := b], ha, hg, hi, hil, hm, hr, pm, srw)
  have eu: A1.used = A.used by simp()
  have et: A1.taken = A.taken by simp()
  have iu1: all h. mallocng.is_used(A1, h) <-> mallocng.is_used(A, h) proof
    fix h
    show by defs(simp(eu), mallocng.is_used)
  qed
  have nmA1: !mallocng.is_used(A1, m) by taut(all_elim(iu1, {m}), nm)
  have hkl1: int_le(k, seq_len(A1.used)) := rewrite(sym(eu), hkl)
  // (the groups in use before: in use, their records kept)
  have emu: all h. mallocng.is_used(A, h) -> mallocng.is_used(X, h) && X.metas[h] = A.metas[h] proof
    fix h
    assume h1
    have hm0: !(h = m) proof
      assume e
      show by taut(rewrite(e, h1), nm)
    qed
    have i2: mallocng.is_used(X, h) by taut(apply(mp.ng_used[A := A1, k := k, T := T, m := m, V := V, n := n, g := h], a1, hk, hkl1, hm), all_elim(iu1, {h}), h1)
    have e: X.metas[h] = A.metas[h] by simp(mp(app_update_other[f := A.metas, k := m, v := V, x := h], hm0))
    show by taut(i2, e)
  qed
  have go: all h. mallocng.is_used(A1, h) -> mallocng.group_ok(X, M2, b, h) proof
    fix h
    assume h1
    have h0: mallocng.is_used(A, h) by taut(all_elim(iu1, {h}), h1)
    have gok := apply(mp.used_group, uo, h0)
    have c1: !(h = g) -> mallocng.group_ok(X, M2, b, h) proof
      assume ne
      have g1 := apply(mp.nt_group[A := A, g := g, i := i, m := m, M := M2, b := b, h := h], ha, hg, hi, hil, hm, hr, ne, gok)
      show := apply(mp.ng_group[A := A1, k := k, T := T, m := m, V := V, n := n, M := M2, b := b, h := h], a1, hk, hkl1, hm, nmA1, h1, g1)
    qed
    have c2: h = g -> mallocng.group_ok(X, M2, b, h) proof
      assume e
      have gokg := rewrite(e, gok)
      have emg: X.metas[g] = A.metas[g] by simp(mp(app_update_other[f := A.metas, k := m, v := V, x := g], gm0))
      have esg: X.slots[g] = fn_update(A.slots[g], i, tag(2, m)) by simp(mp(app_update_other[f := fn_update(A.slots, g, fn_update(A.slots[g], i, tag(2, m))), k := m, v := fn_build(n, i. tag(0, empty)), x := g], gm0))
      have ea: X.active = A.active by simp()
      // (g's own nesting: as before)
      have {nst = nested} := expand(gokg, mallocng.group_ok)
      have ne2: X.metas[g].maplen = 0 -> (ex x0. ex x1. (x0 in omega && x1 in omega) &&
          ((int_lt(x0, seq_len(X.used)) && int_lt(x1, seq_len(X.slots[X.used[x0]]))) && X.slots[X.used[x0]][x1] = tag(2, g))) proof
        assume z
        obtain p j, hp0 hj hpl hjl hs from mp(nst, rewrite(emg, z))
        have s2 := apply(mp.nt_slot[A := A, g := g, i := i, m := m, p := A.used[p], j := j, u := tag(2, g)], hr, hs, (!(tag(2, g) = tag(3, empty)) by defs(simp(), tag)))
        have l2: int_lt(j, seq_len(A1.slots[A.used[p]])) := rewrite(sym(apply(mp.nt_len[A := A, g := g, i := i, m := m, p := A.used[p]], ha, hg, hi, hil, hm)), hjl)
        have w: ex x0. ex x1. (x0 in omega && x1 in omega) && ((int_lt(x0, seq_len(A1.used)) && int_lt(x1, seq_len(A1.slots[A1.used[x0]]))) && A1.slots[A1.used[x0]][x1] = tag(2, g))
          by ex_intro({p}, {j}, taut(hp0, hj, rewrite(sym(eu), hpl), rewrite(sym(eu), l2), rewrite(sym(eu), s2)))
        show := apply(mp.ng_at[A := A1, k := k, T := T, m := m, V := V, n := n, u := tag(2, g)], a1, hk, hkl1, hm, nmA1, w)
      qed
      // (the slot: m in use, nested there, framed)
      have im: mallocng.is_used(X, m) by taut(apply(mp.ng_used[A := A1, k := k, T := T, m := m, V := V, n := n, g := m], a1, hk, hkl1, hm), refl({m}))
      have xm: X.metas[m] = V by simp()
      have soi: mallocng.slot_ok(X, M2, b, g, i, tag(2, m)) by defs(simp(im, xm, emg, vz, vhf, vfr), mallocng.slot_ok)
      show := rewrite(sym(e), apply(mp.nt_parent[A := A, A2 := X, M := M2, b := b, g := g, i := i, m := m], ha, hg, hi, hil, hm, hr, gokg, emg, esg, ea, emu, ne2, soi))
    qed
    show by taut(c1, c2)
  qed
  have sep: int_lt(0, V.maplen) -> all x. x in omega -> int_lt(x, seq_len(mallocng.regions(c, A1))) -> mallocng.apart(mallocng.group_range(V), mallocng.regions(c, A1)[x]) proof
    assume z
    show by arith(z, vz)
  qed
  have fe: mallocng.fixed_ranges(c, A1) = mallocng.fixed_ranges(c, A) by defs(simp(), mallocng.fixed_ranges, mallocng.auxv_ranges)
  show := apply(mp.ng_holds_c[c := c, A := A1, k := k, T := T, m := m, V := V, n := n, M2 := M2, b := b, brk2 := brk2], hc, u1, a1, ht, rewrite(sym(et), hte), hmz, hv, hn,
    hk, hkl1, rewrite(sym(eu), hlo), rewrite(sym(eu), hhi), pt1, ac1, pa1, re1, bl1, nm1, sp1, hwf, ff1, ga1, pm1, ar1, go, gm, img, cok, fr, mrw, bk, gpm, cl, db,
    sep, rewrite(sym(fe), apt))
qed

// ----------------------------------------------------------------------
//  No group made: the meta taken last given back (free_meta), the free
//  ones then

// the state: x out of the taken ones onto the free ones' end
abbrev mp.back(A, T, x) := mp.mstep(A, seq_concat(A.free_metas, seq_one(x)), A.avail_cnt, T)

// the metas' partition: x out of the taken ones into the free ones
theorem mp.part_back(A, T, x): A in mallocng.Abs -> mallocng.metas_partition(A) -> T in list_type(omega) -> A.taken = seq_concat(T, seq_one(x)) ->
  mallocng.metas_partition(mp.back(A, T, x))
proof
  assume ha hp ht hte
  let A2 := mp.back(A, T, x)
  let F := A.free_metas
  have {hs = sorted, hus = used_slots, hfs = free_slots, hcv = cover, htk = taken, hfr = fresh} := expand(hp, mallocng.metas_partition)
  have fl: F in list_type(omega) by simp(ha)
  have flo: seq_len(F) in omega by arith(fl)
  have tlo: seq_len(T) in omega by arith(ht)
  have lt: seq_len(A.taken) = int_add(seq_len(T), 1) := rewrite(sym(hte), (seq_len(seq_concat(T, seq_one(x))) = int_add(seq_len(T), 1) by arith(ht)))
  have tm: A.taken[seq_len(T)] = x := rewrite(sym(hte), at({seq_concat(T, seq_one(x))[seq_len(T)]}, ht))
  have tt: all i. i in omega -> int_lt(i, seq_len(T)) -> A.taken[i] = T[i] proof
    fix i
    assume hi hil
    show := rewrite(sym(hte), at({seq_concat(T, seq_one(x))[i]}, ht, hi, hil))
  qed
  have tl: A.taken in list_type(omega) by simp(ha)
  have hx: x in omega := rewrite(tm, apply(at_type[l := A.taken, t := omega, i := seq_len(T)], tl, tlo, (int_lt(seq_len(T), seq_len(A.taken)) by arith(lt))))
  have xl := mp(all_elim(tr.seq_one_type, {x}, {omega}), hx)
  have lf: seq_len(A2.free_metas) = int_add(seq_len(F), 1) by simp((seq_len(seq_concat(F, seq_one(x))) = int_add(seq_len(F), 1) by arith(fl, xl)))
  have fx: A2.free_metas[seq_len(F)] = x by simp(at({seq_concat(F, seq_one(x))[seq_len(F)]}, fl))
  have ff: all i. i in omega -> int_lt(i, seq_len(F)) -> A2.free_metas[i] = F[i] proof
    fix i
    assume hi hil
    show by simp(at({seq_concat(F, seq_one(x))[i]}, fl, xl, hi, hil))
  qed
  // (x: a meta slot, not used, not available, not free, taken once)
  have ms0 mnu0 mna0 mnf0 mun0 := mp(all_elim(htk, {seq_len(T)}), tlo, (int_lt(seq_len(T), seq_len(A.taken)) by arith(lt)))
  have ms := rewrite(tm, ms0)
  have mnu := rewrite(tm, mnu0)
  have mna := rewrite(tm, mna0)
  have mnf := rewrite(tm, mnf0)
  have mun := rewrite(tm, mun0)
  have iu: all g. mallocng.is_used(A2, g) <-> mallocng.is_used(A, g) by defs(simp(), mallocng.is_used)
  have msl: all g. mallocng.meta_slot(A2, g) <-> mallocng.meta_slot(A, g) by defs(simp(), mallocng.meta_slot)
  have avl: all g. mallocng.avail_meta(A2, g) <-> mallocng.avail_meta(A, g) by defs(simp(), mallocng.avail_meta)
  // (an element of the new free list: an old one, or x)
  have fe: all i. i in omega -> int_lt(i, seq_len(A2.free_metas)) -> (int_lt(i, seq_len(F)) && A2.free_metas[i] = F[i]) || (i = seq_len(F) && A2.free_metas[i] = x) proof
    fix i
    assume hi hil
    have c1: int_lt(i, seq_len(F)) -> (int_lt(i, seq_len(F)) && A2.free_metas[i] = F[i]) || (i = seq_len(F) && A2.free_metas[i] = x) proof
      assume h
      show by taut(h, mp(all_elim(ff, {i}), hi, h))
    qed
    have c2: i = seq_len(F) -> (int_lt(i, seq_len(F)) && A2.free_metas[i] = F[i]) || (i = seq_len(F) && A2.free_metas[i] = x) proof
      assume h
      show by taut(h, rewrite(sym(h), fx))
    qed
    show by taut(c1, c2, (int_lt(i, seq_len(F)) || i = seq_len(F) by arith(hi, hil, lf)))
  qed
  have k1: all j. j in omega -> int_lt(int_add(j, 1), seq_len(A2.used)) -> int_lt(A2.used[j], A2.used[int_add(j, 1)]) by simp(hs)
  have k2: all j. j in omega -> int_lt(j, seq_len(A2.used)) -> mallocng.meta_slot(A2, A2.used[j]) proof
    fix j
    assume hj hjl
    show by taut(all_elim(msl, {A2.used[j]}), (mallocng.meta_slot(A, A2.used[j]) by simp(mp(all_elim(hus, {j}), hj, (int_lt(j, seq_len(A.used)) by simp(hjl))))))
  qed
  // free_slots: the old ones, x
  have k3: all j. j in omega -> int_lt(j, seq_len(A2.free_metas)) -> mallocng.meta_slot(A2, A2.free_metas[j]) && !mallocng.is_used(A2, A2.free_metas[j]) proof
    fix j
    assume hj hjl
    have d1: int_lt(j, seq_len(F)) && A2.free_metas[j] = F[j] -> mallocng.meta_slot(A2, A2.free_metas[j]) && !mallocng.is_used(A2, A2.free_metas[j]) proof
      assume w
      have h e := w
      have s1 s2 := mp(all_elim(hfs, {j}), hj, h)
      have r: mallocng.meta_slot(A2, F[j]) && !mallocng.is_used(A2, F[j]) by taut(all_elim(msl, {F[j]}), all_elim(iu, {F[j]}), s1, s2)
      show := rewrite(sym(e), r)
    qed
    have d2: j = seq_len(F) && A2.free_metas[j] = x -> mallocng.meta_slot(A2, A2.free_metas[j]) && !mallocng.is_used(A2, A2.free_metas[j]) proof
      assume w
      have _ e := w
      have r: mallocng.meta_slot(A2, x) && !mallocng.is_used(A2, x) by taut(all_elim(msl, {x}), all_elim(iu, {x}), ms, mnu)
      show := rewrite(sym(e), r)
    qed
    show by taut(mp(all_elim(fe, {j}), hj, hjl), d1, d2)
  qed
  // cover: used, free, fresh or taken as before -- x now free
  have k4: all x0 x1. x0 in omega && x1 in omega -> int_lt(x0, seq_len(A2.areas)) && int_lt(x1, mallocng.NSLOTS) ->
      ((mallocng.is_used(A2, mallocng.meta_at(A2.areas[x0], x1)) ||
        (ex x2. x2 in omega && (int_lt(x2, seq_len(A2.free_metas)) && A2.free_metas[x2] = mallocng.meta_at(A2.areas[x0], x1)))) ||
       mallocng.avail_meta(A2, mallocng.meta_at(A2.areas[x0], x1))) ||
      (ex x2. x2 in omega && (int_lt(x2, seq_len(A2.taken)) && A2.taken[x2] = mallocng.meta_at(A2.areas[x0], x1))) proof
    fix x0 x1
    assume hxo hb
    let X := mallocng.meta_at(A.areas[x0], x1)
    have hb2: int_lt(x0, seq_len(A.areas)) && int_lt(x1, mallocng.NSLOTS) by simp(hb)
    have c := mp(all_elim(hcv, {x0}, {x1}), hxo, hb2)
    have df: (ex x2. x2 in omega && (int_lt(x2, seq_len(F)) && F[x2] = X)) -> (ex x2. x2 in omega && (int_lt(x2, seq_len(A2.free_metas)) && A2.free_metas[x2] = X)) proof
      assume e
      obtain i, hi hil hie from e
      show by ex_intro({i}, taut(hi, (int_lt(i, seq_len(A2.free_metas)) by arith(hil, lf)), trans(mp(all_elim(ff, {i}), hi, hil), hie)))
    qed
    have dt: (ex x2. x2 in omega && (int_lt(x2, seq_len(A.taken)) && A.taken[x2] = X)) ->
        (ex x2. x2 in omega && (int_lt(x2, seq_len(A2.free_metas)) && A2.free_metas[x2] = X)) || (ex x2. x2 in omega && (int_lt(x2, seq_len(A2.taken)) && A2.taken[x2] = X)) proof
      assume e
      obtain i, hi hil hie from e
      have t1: int_lt(i, seq_len(T)) -> (ex x2. x2 in omega && (int_lt(x2, seq_len(A2.taken)) && A2.taken[x2] = X)) proof
        assume h
        have tk: A2.taken = T by simp()
        show by ex_intro({i}, taut(hi, rewrite(sym(tk), h), rewrite(sym(tk), trans(sym(mp(all_elim(tt, {i}), hi, h)), hie))))
      qed
      have t2: i = seq_len(T) -> (ex x2. x2 in omega && (int_lt(x2, seq_len(A2.free_metas)) && A2.free_metas[x2] = X)) proof
        assume h
        have xm: x = X := trans(sym(rewrite(sym(h), tm, {1})), hie)
        show by ex_intro({seq_len(F)}, taut(flo, (int_lt(seq_len(F), seq_len(A2.free_metas)) by arith(lf)), trans(fx, xm)))
      qed
      show by taut(t1, t2, (int_lt(i, seq_len(T)) || i = seq_len(T) by arith(hi, hil, lt)))
    qed
    have r: ((mallocng.is_used(A2, X) || (ex x2. x2 in omega && (int_lt(x2, seq_len(A2.free_metas)) && A2.free_metas[x2] = X))) || mallocng.avail_meta(A2, X)) ||
        (ex x2. x2 in omega && (int_lt(x2, seq_len(A2.taken)) && A2.taken[x2] = X)) by taut(c, all_elim(iu, {X}), all_elim(avl, {X}), df, dt)
    show by simp(r)
  qed
  // taken: the ones before x, each as it was, x not one of them
  have k5: all i. i in omega -> int_lt(i, seq_len(A2.taken)) ->
      (((mallocng.meta_slot(A2, A2.taken[i]) && !mallocng.is_used(A2, A2.taken[i])) && !mallocng.avail_meta(A2, A2.taken[i])) &&
        (all x1. x1 in omega -> int_lt(x1, seq_len(A2.free_metas)) -> !(A2.free_metas[x1] = A2.taken[i]))) &&
      (all x1. x1 in omega -> int_lt(x1, seq_len(A2.taken)) && A2.taken[x1] = A2.taken[i] -> x1 = i) proof
    fix i
    assume hi hil
    have il: int_lt(i, seq_len(T)) by simp(hil)
    have ti := mp(all_elim(tt, {i}), hi, il)
    have il2: int_lt(i, seq_len(A.taken)) by arith(il, lt)
    have q1 q2 q3 q4 q5 := mp(all_elim(htk, {i}), hi, il2)
    have nx: !(T[i] = x) proof
      assume e
      have e2: A.taken[i] = x := trans(ti, e)
      have ii := mp(all_elim(mun, {i}), hi, taut(il2, e2))
      show by arith(ii, il)
    qed
    have a1: mallocng.meta_slot(A2, T[i]) by taut(all_elim(msl, {T[i]}), rewrite(ti, q1))
    have a2: !mallocng.is_used(A2, T[i]) by taut(all_elim(iu, {T[i]}), rewrite(ti, q2))
    have a3: !mallocng.avail_meta(A2, T[i]) by taut(all_elim(avl, {T[i]}), rewrite(ti, q3))
    have a4: all x1. x1 in omega -> int_lt(x1, seq_len(A2.free_metas)) -> !(A2.free_metas[x1] = T[i]) proof
      fix j
      assume hj hjl
      have d1: int_lt(j, seq_len(F)) && A2.free_metas[j] = F[j] -> !(A2.free_metas[j] = T[i]) proof
        assume w
        have h e := w
        show := rewrite(sym(e), rewrite(ti, mp(all_elim(q4, {j}), hj, h)))
      qed
      have d2: j = seq_len(F) && A2.free_metas[j] = x -> !(A2.free_metas[j] = T[i]) proof
        assume w
        have _ e := w
        assume e2
        show by taut(nx, sym(trans(sym(e), e2)))
      qed
      show by taut(mp(all_elim(fe, {j}), hj, hjl), d1, d2)
    qed
    have a5: all x1. x1 in omega -> int_lt(x1, seq_len(T)) && T[x1] = T[i] -> x1 = i proof
      fix x1
      assume h1 h2
      have x1l te := h2
      have tx := mp(all_elim(tt, {x1}), h1, x1l)
      have e3: A.taken[x1] = A.taken[i] := trans(tx, trans(te, sym(ti)))
      show := mp(all_elim(q5, {x1}), h1, taut((int_lt(x1, seq_len(A.taken)) by arith(x1l, lt)), e3))
    qed
    show by simp(a1, a2, a3, a4, a5)
  qed
  // fresh: not used, not free -- x not one of them (not available)
  have k6: all x0. x0 in omega -> (ord_lt(0, seq_len(A2.areas)) && int_le(int_sub(mallocng.NSLOTS, A2.avail_cnt), x0)) && int_lt(x0, mallocng.NSLOTS) ->
      !mallocng.is_used(A2, mallocng.meta_at(A2.areas[int_sub(seq_len(A2.areas), 1)], x0)) &&
      (all x1. x1 in omega -> int_lt(x1, seq_len(A2.free_metas)) -> !(A2.free_metas[x1] = mallocng.meta_at(A2.areas[int_sub(seq_len(A2.areas), 1)], x0))) proof
    fix x0
    assume hxo hb
    let X := mallocng.meta_at(A.areas[int_sub(seq_len(A.areas), 1)], x0)
    have hb2: (ord_lt(0, seq_len(A.areas)) && int_le(int_sub(mallocng.NSLOTS, A.avail_cnt), x0)) && int_lt(x0, mallocng.NSLOTS) by simp(hb)
    have f1 f2 := mp(all_elim(hfr, {x0}), hxo, hb2)
    have b1 b2 b3 := hb2
    have av: mallocng.avail_meta(A, X) by defs(taut(b1, (ex x2. x2 in omega && ((int_le(int_sub(mallocng.NSLOTS, A.avail_cnt), x2) && int_lt(x2, mallocng.NSLOTS)) &&
      X = mallocng.meta_at(A.areas[int_sub(seq_len(A.areas), 1)], x2)) by ex_intro({x0}, taut(hxo, b2, b3, refl({X}))))), mallocng.avail_meta)
    have xn: !(x = X) proof
      assume e
      show by taut(rewrite(sym(e), av), mna)
    qed
    have u2: !mallocng.is_used(A2, X) by taut(all_elim(iu, {X}), f1)
    have n2: all x1. x1 in omega -> int_lt(x1, seq_len(A2.free_metas)) -> !(A2.free_metas[x1] = X) proof
      fix j
      assume hj hjl
      have d1: int_lt(j, seq_len(F)) && A2.free_metas[j] = F[j] -> !(A2.free_metas[j] = X) proof
        assume w
        have h e := w
        show := rewrite(sym(e), mp(all_elim(f2, {j}), hj, h))
      qed
      have d2: j = seq_len(F) && A2.free_metas[j] = x -> !(A2.free_metas[j] = X) proof
        assume w
        have _ e := w
        show := rewrite(sym(e), xn)
      qed
      show by taut(mp(all_elim(fe, {j}), hj, hjl), d1, d2)
    qed
    show by simp(u2, n2)
  qed
  show by defs(taut(k1, k2, k3, k4, k5, k6), mallocng.metas_partition)
qed

// free_meta's step (x appended to the free list, its record cleared but
// its links): a step of the metas' bookkeeping -- x's record accessible
theorem mp.fb_ms(c, A, T, x, vm, V1, b, objs): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  vm in x86_64_linux.Vm -> V1 in x86_64_linux.Vm -> mallocng.holds_m(c, A, vm, b) -> mallocng.shown_in(c, A, objs) -> int_mod(c.ctx, 8) = 0 ->
  T in list_type(omega) -> A.taken = seq_concat(T, seq_one(x)) ->
  mallocng_specs.meta_joinable(vm, objs, int_add(c.ctx, 16), A.free_metas, x) -> mallocng_specs.meta_freed(vm, V1, objs, int_add(c.ctx, 16), x) ->
  (all a. a in omega -> int_le(x, a) -> int_lt(a, int_add(x, 40)) ->
     mallocng.m_rw(mallocng.mview(vm, mallocng.all_bytes()), a) && !(snd(mallocng.pg(mallocng.mview(vm, mallocng.all_bytes()), a)).kind = 2)) ->
  mp.mspre(c, A, seq_concat(A.free_metas, seq_one(x)), A.avail_cnt, T, x, vm, V1, b)
proof
  assume hc hu ha hb hv hv1 hh hsh cal ht hte hj hfd xrw0
  let F := A.free_metas
  let F2 := seq_concat(A.free_metas, seq_one(x))
  let A2 := mp.back(A, T, x)
  let PH := int_add(c.ctx, 16)
  let M := mallocng.mview(vm, mallocng.held(c, A, b))
  let M2 := mallocng.mview(V1, mallocng.held(c, A2, b))
  have {H = inv, hm = mapped} := expand(hh, mallocng.holds_m)
  have {cok = ctx, hpt = part, huo = used, hga = apart, hff = fixed} := expand(H, mallocng.holds)
  have {k4 = avail_cnt, k5 = avail_le, k6 = avail_meta, k10 = free_metas} := expand(cok, mallocng.ctx_ok)
  have {fs = free_slots, htk = taken} := expand(hpt, mallocng.metas_partition)
  have vb: vm.bytes in fn_space(bits(64), bits(8)) by simp(hv)
  have vb2: V1.bytes in fn_space(bits(64), bits(8)) by simp(hv1)
  have fl: F in list_type(omega) by simp(ha)
  have tl: A.taken in list_type(omega) by simp(ha)
  have ko: A.avail_cnt in omega by simp(ha)
  have nle: int_le(A.avail_cnt, mallocng.NSLOTS) by simp(k5)
  have co: c.ctx in omega by simp(hc)
  have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  have kf: mallocng.C_FREE_META = 16 by defs(refl({16}), mallocng.C_FREE_META)
  have cm: mallocng.META_SIZE = 40 by defs(refl({40}), mallocng.META_SIZE)
  have cf := apply(mp.ctx_fp[c := c, A := A, vm := vm, b := b, a := int_add(c.ctx, 927)], hc, hu, ha, hh, arith(co), arith(co), arith(co, ks))
  have clo := apply(mp.fp_low[c := c, A := A, vm := vm, b := b, a := int_add(c.ctx, 927)], hm, cf)
  have pho: PH in omega by arith(co)
  have phb: PH in bits(64) by arith(co, clo)
  // (x: the last taken -- a meta slot not in use, in an area apart from the context)
  have tlo: seq_len(T) in omega by arith(ht)
  have lt: seq_len(A.taken) = int_add(seq_len(T), 1) := rewrite(sym(hte), (seq_len(seq_concat(T, seq_one(x))) = int_add(seq_len(T), 1) by arith(ht)))
  have tm: A.taken[seq_len(T)] = x := rewrite(sym(hte), at({seq_concat(T, seq_one(x))[seq_len(T)]}, ht))
  have ms0 mnu0 _ _ mun0 := mp(all_elim(htk, {seq_len(T)}), tlo, (int_lt(seq_len(T), seq_len(A.taken)) by arith(lt)))
  have xs := rewrite(tm, ms0)
  have xnu := rewrite(tm, mnu0)
  have mun := rewrite(tm, mun0)
  have {xo = nat, xa = area} := apply(mp.meta_page, ha, xs)
  obtain kx, hkx hkxl kx1 kx2 _ from xa
  have d0 _ _ := mp.data_at[c := c]
  have xoc: all a. a in omega -> int_le(x, a) -> int_lt(a, int_add(x, 40)) -> !(int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE))) proof
    fix a
    assume hao h1 h2
    have {n1 = data} := apply(mp.area_apart[c := c, A := A, M := M, b := b, brk := vm.brk, k := kx, a := a], hc, hu, ha, H, hkx, hkxl, hao, arith(kx1, h1), arith(kx2, h2))
    show by simp(expand(rewrite(d0, mp(all_elim(n1, {0}), simp(), simp())), mallocng.in_range))
  qed
  // the free metas: meta slots, not in use, not taken; the list as free_meta has it
  have hsl: all i. i in omega -> int_lt(i, seq_len(F)) -> mallocng.meta_slot(A, F[i]) && mp.untaken(A, F[i]) proof
    fix i
    assume hi hil
    have ms _ := mp(all_elim(fs, {i}), hi, hil)
    show by taut(ms, apply(mp.free_untaken, H, hi, hil))
  qed
  have la := apply(mp.ctx_list[c := c, A := A, vm := vm, b := b, objs := objs, off := 16, L := F], hc, hu, ha, vb, hh, hsh, cal, simp(), simp(), arith(), fl, hsl, rewrite(kf, k10))
  have r1 rz rest only := mp(all_elim(hfd, {F}), fl, conj(la, hj))
  have xl := mp(all_elim(tr.seq_one_type, {x}, {omega}), xo)
  have f2l := mp(all_elim(tr.concat_list, {F}, {seq_one(x)}, {omega}), fl, xl)
  // the new state's parts; x's bytes no longer taken, the others as before
  have em: A2.metas = A.metas by simp()
  have es: A2.slots = A.slots by simp()
  have eu: A2.used = A.used by simp()
  have ea: A2.active = A.active by simp()
  have eas: A2.areas = A.areas by simp()
  have etk: A.taken = seq_concat(A2.taken, seq_one(x)) by simp(hte)
  have fpr: mallocng.fp_ranges(c, A2) = mallocng.fp_ranges(c, A) by defs(simp(), mallocng.fp_ranges, mallocng.fixed_ranges, mallocng.auxv_ranges)
  have t2l: A2.taken in list_type(omega) by simp(ht)
  have tkx: all a. a in omega -> !(int_le(x, a) && int_lt(a, int_add(x, 40))) -> (mallocng.in_taken(A2, a) <-> mallocng.in_taken(A, a)) proof
    fix a
    assume _ nx
    show by taut(rewrite(cm, apply(mp.taken_snoc[A := A2, A2 := A, x := x, a := a], t2l, xo, etk)), nx)
  qed
  have hs2: all a. a in omega -> !(int_le(x, a) && int_lt(a, int_add(x, 40))) -> (a in mallocng.held(c, A2, b) <-> a in mallocng.held(c, A, b)) proof
    fix a
    assume hao nx
    have re := apply(mp.inres_fields[A := A, A2 := A2, a := a], em, es, eu)
    show := apply(mp.held_same[c := c, A := A, A2 := A2, b := b, a := a], fpr, re, mp(all_elim(tkx, {a}), hao, nx))
  qed
  have {aa2 = abs, au2 = univ} := apply(mp.mstep_type[A := A, F := F2, n := A.avail_cnt, T := T], ha, f2l, ko, ht)
  have ga2: mallocng.groups_apart(c, A2) by defs(simp(expand(hga, mallocng.groups_apart), fpr), mallocng.groups_apart)
  have u2 := apply(mp.used_tr[A := A, A2 := A2, M := M, M2 := M, b := b], ha, hb, em, es, eu, ea, huo,
    (all y. y in omega -> mp.ingrp(A, y) -> M[y] = M[y] by simp()), (all g. all y. mallocng.is_used(A, g) -> y in omega -> int_le(g, y) -> int_lt(y, int_add(g, 40)) -> M[y] = M[y] by simp()))
  // (x's bytes: the allocator's after -- in its area, not taken: no other taken meta's)
  have xh: all a. a in omega -> int_le(x, a) -> int_lt(a, int_add(x, 40)) -> a in mallocng.held(c, A2, b) proof
    fix a
    assume hao h1 h2
    have r1a: int_le(A.areas[kx], a) by arith(kx1, h1)
    have r2a: int_lt(a, int_add(A.areas[kx], 4096)) by arith(kx2, h2)
    have {ff1 = areas} := expand(hff, mallocng.fixed_free)
    have nl := mp(all_elim(ff1, {kx}, {a}), conj(hkx, hao), conj(conj(hkxl, r1a), r2a))
    have nt: !mallocng.in_taken(A2, a) proof
      assume w
      obtain i, hi hil w1 w2 from expand(w, mallocng.in_taken)
      have tk: A2.taken = T by simp()
      have il: int_lt(i, seq_len(T)) := rewrite(tk, hil)
      have ti: A.taken[i] = T[i] := rewrite(sym(hte), at({seq_concat(T, seq_one(x))[i]}, ht, hi, il))
      have il2: int_lt(i, seq_len(A.taken)) by arith(il, lt)
      have q1 _ _ _ _ := mp(all_elim(htk, {i}), hi, il2)
      have ne: !(T[i] = x) proof
        assume e
        have ii := mp(all_elim(mun, {i}), hi, taut(il2, trans(ti, e)))
        show by arith(ii, il)
      qed
      have d := apply(mp.meta_disj[c := c, A := A, M := M, b := b, brk := vm.brk, g := x, l := T[i], a := a], hc, hu, ha, H, xs, rewrite(ti, q1), ne, hao,
        rewrite(tk, w1), rewrite(cm, rewrite(tk, w2)))
      show by taut(d, h1, h2)
    qed
    have fp2 := apply(mp.area_fp[c := c, A := A2, M := M, b := b, k := kx, a := a], hc, au2, aa2, u2, ga2, hkx, rewrite(sym(eas), hkxl), hao,
      rewrite(sym(eas), r1a), rewrite(sym(eas), r2a), nl, nt)
    have nf: !mallocng.ctx_free(c, a) proof
      assume w
      have inc: int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE))
        by arith(expand(w, mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK), ks)
      show by taut(inc, mp(all_elim(xoc, {a}), hao, h1, h2))
    qed
    have hd := set_select_def[s := omega, p := y. y in mallocng.footprint(c, A2, b) && !mallocng.ctx_free(c, y), z := a]
    show by defs(taut(hd, fp2, nf, hao), mallocng.held)
  qed
  // the bytes written: the head word, x's record, the free metas' links
  have up := mp(app_update_other[f := V1, k := "bytes", v := vm.bytes, x := "pages"], (!("pages" = "bytes") by simp()))
  have ep: V1.pages = vm.pages by taut(sym(rewrite(rest, up)))
  have hby: all y. y in bits(64) -> !mp.tkbyte(c, A, y) -> !(int_le(x, y) && int_lt(y, int_add(x, 40))) -> V1.bytes[y] = vm.bytes[y] proof
    fix y
    assume hy hnt nx
    have yo: y in omega by arith(hy)
    have yl: int_lt(y, int_pow(2, 64)) by arith(hy)
    have oh: !(int_le(PH, y) && int_lt(y, int_add(PH, 8))) proof
      assume w
      have w1 w2 := w
      show by taut(hnt, (mp.tkbyte(c, A, y) by defs(taut((int_le(int_add(c.ctx, 16), y) && int_lt(y, int_add(c.ctx, 40)) by arith(w1, w2))), mp.tkbyte)))
    qed
    have on: all i. i in omega -> int_lt(i, seq_len(F)) -> !(int_le(F[i], y) && int_lt(y, int_add(F[i], 16))) proof
      fix i
      assume hi hil
      assume w
      have ms nu := mp(all_elim(fs, {i}), hi, hil)
      have ex1: ex l. (mallocng.meta_slot(A, l) && !mallocng.is_used(A, l)) && (int_le(l, y) && int_lt(y, int_add(l, 16))) by ex_intro({F[i]}, taut(ms, nu, w))
      show by taut(hnt, (mp.tkbyte(c, A, y) by defs(taut(ex1), mp.tkbyte)))
    qed
    have bb := mp(all_elim(only, {y}), yo, taut(yl, oh, nx, on))
    have bi := mp(bits_of_int_small[n := 64, a := y], yo, (int_lt(y, pow2(64)) by arith(hy)))
    show := rewrite(bi, bb)
  qed
  // x's record accessible in the new view
  have xrw: all a. a in omega -> int_le(x, a) -> int_lt(a, int_add(x, 40)) -> !mallocng.in_taken(A2, a) ->
      mallocng.m_rw(M2, a) && !(snd(mallocng.pg(M2, a)).kind = 2) proof
    fix a
    assume hao h1 h2 _
    have p2 := apply(mp.view_pg_at[vm := V1, F := mallocng.held(c, A2, b), a := a], mp(all_elim(xh, {a}), hao, h1, h2), hao)
    have p1 := apply(mp.view_pg_at[vm := vm, F := mallocng.all_bytes(), a := a], (a in mallocng.all_bytes() by defs(sel(taut(hao)), mallocng.all_bytes)), hao)
    have pe: mallocng.pg(M2, a) = mallocng.pg(mallocng.mview(vm, mallocng.all_bytes()), a) := trans(p2, trans((V1.pages[int_div(a, x86_64_linux.PAGE)] = vm.pages[int_div(a, x86_64_linux.PAGE)] by simp(ep)), sym(p1)))
    have {rw = rw} := apply(mp.pg_same, pe)
    have o1 o2 := mp(all_elim(xrw0, {a}), hao, h1, h2)
    show by taut(rw, o1, rewrite(sym(pe), o2))
  qed
  // the count and next meta words: not written, so as before
  have xout: int_le(int_add(c.ctx, mallocng.CTX_SIZE), x) || int_le(int_add(x, 40), c.ctx) proof
    have o1 := mp(all_elim(xoc, {x}), xo, arith(xo), arith(xo))
    have o2 := mp(all_elim(xoc, {int_add(x, 39)}), arith(xo), arith(xo), arith(xo))
    show by arith(o1, o2, ks, xo, co)
  qed
  have cag: all a. a in omega -> int_le(int_add(c.ctx, 24), a) -> int_lt(a, int_add(c.ctx, 40)) -> M2[a] = M[a] proof
    fix a
    assume hao h1 h2
    have oh: !(int_le(PH, a) && int_lt(a, int_add(PH, 8))) by arith(h1)
    have on: all i. i in omega -> int_lt(i, seq_len(F)) -> !(int_le(F[i], a) && int_lt(a, int_add(F[i], 16))) proof
      fix i
      assume hi hil
      have ms nt := mp(all_elim(hsl, {i}), hi, hil)
      have {fo2 = out} := apply(mp.slot_meta[c := c, A := A, vm := vm, b := b, g := F[i]], hc, hu, ha, hh, ms, nt)
      show by arith(fo2, ks, h1, h2)
    qed
    have nx: !(int_le(x, a) && int_lt(a, int_add(x, 40))) by arith(xout, ks, h1, h2)
    have bb := mp(all_elim(only, {a}), hao, taut((int_lt(a, int_pow(2, 64)) by arith(h2, co, clo)), oh, nx, on))
    show := apply(mp.view_tr[vm := vm, V2 := V1, F := mallocng.held(c, A, b), F2 := mallocng.held(c, A2, b), a := a], hao, mp(all_elim(hs2, {a}), hao, nx), bb,
      (V1.pages[int_div(a, x86_64_linux.PAGE)] = vm.pages[int_div(a, x86_64_linux.PAGE)] by simp(ep)))
  qed
  have g24: all i. i in omega -> int_lt(i, 8) -> M2[int_add(int_add(c.ctx, 24), i)] = M[int_add(int_add(c.ctx, 24), i)] proof
    fix i
    assume hi hil
    show := mp(all_elim(cag, {int_add(int_add(c.ctx, 24), i)}), arith(co, hi), arith(co, hi), arith(co, hi, hil))
  qed
  have g32: all i. i in omega -> int_lt(i, 8) -> M2[int_add(int_add(c.ctx, 32), i)] = M[int_add(int_add(c.ctx, 32), i)] proof
    fix i
    assume hi hil
    show := mp(all_elim(cag, {int_add(int_add(c.ctx, 32), i)}), arith(co, hi), arith(co, hi), arith(co, hi, hil))
  qed
  have w24 := apply(mp.agree_rd[M := M, M2 := M2, a := int_add(c.ctx, 24), n := 8], simp(), g24)
  have w32 := apply(mp.agree_rd[M := M, M2 := M2, a := int_add(c.ctx, 32), n := 8], simp(), g32)
  have we24: mallocng.ctx_word(c, M2, mallocng.C_AVAIL_META) = mallocng.ctx_word(c, M, mallocng.C_AVAIL_META) by defs(w24, mallocng.ctx_word, mallocng.C_AVAIL_META)
  have we32: mallocng.ctx_word(c, M2, mallocng.C_AVAIL_CNT) = mallocng.ctx_word(c, M, mallocng.C_AVAIL_CNT) by defs(w32, mallocng.ctx_word, mallocng.C_AVAIL_CNT)
  have kc := trans(we32, k4)
  have kn: int_lt(0, A.avail_cnt) -> ord_lt(0, seq_len(A.areas)) &&
      mallocng.ctx_word(c, M2, mallocng.C_AVAIL_META) = mallocng.meta_at(A.areas[int_sub(seq_len(A.areas), 1)], int_sub(mallocng.NSLOTS, A.avail_cnt))
    by simp(rewrite(sym(we24), k6))
  // the list: as free_meta left it, read through the new view (its head word
  // the context's, its links the free metas' records and x's)
  have {lkd = linked} := expand(r1, mallocng_specs.list_at)
  have _ dst2 _ := expand(lkd, mallocng.cyclic)
  have {hd2 = head} := apply(mp.list_rd[vm := V1, objs := objs, phead := PH, l := F2, i := 0], vb2, phb, f2l, r1)
  have phf: all i. i in omega -> int_lt(i, 8) -> int_add(PH, i) in mallocng.held(c, A2, b) proof
    fix i
    assume hi hil
    have nf: !mallocng.ctx_free(c, int_add(PH, i)) by defs(arith(hi, hil, co), mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK)
    have q _ _ := apply(mp.ctx_acc[c := c, A := A, vm := vm, b := b, a := int_add(PH, i)], hc, hu, ha, hh, arith(co, hi), arith(co, hi), arith(co, ks, hi, hil), nf)
    have th := mp(all_elim(hs2, {int_add(PH, i)}), arith(co, hi), (!(int_le(x, int_add(PH, i)) && int_lt(int_add(PH, i), int_add(x, 40))) by arith(xout, ks, co, hi, hil)))
    show by taut(q, th)
  qed
  have rh := apply(mp.view_read[vm := V1, fp := mallocng.held(c, A2, b), a := PH, n := 8], pho, simp(), simp(), phf)
  have hdw: mallocng.ctx_word(c, M2, mallocng.C_FREE_META) = ite(seq_len(F2) = 0, 0, F2[0]) by defs(trans(sym(rh), hd2), mallocng.ctx_word, mallocng.C_FREE_META)
  have lf2: seq_len(F2) = int_add(seq_len(F), 1) by arith(fl, xl)
  have lk2: all i. i in omega -> int_lt(i, seq_len(F2)) ->
      mallocng.rd(M2, int_add(F2[i], 8), 8) = F2[int_mod(int_add(i, 1), seq_len(F2))] &&
      mallocng.rd(M2, F2[i], 8) = F2[int_mod(int_sub(int_add(i, seq_len(F2)), 1), seq_len(F2))] proof
    fix i
    assume hi hil
    // (the element's 16 link bytes: held after)
    have inh: all a. a in omega -> int_le(F2[i], a) -> int_lt(a, int_add(F2[i], 16)) -> a in mallocng.held(c, A2, b) proof
      fix a
      assume hao h1 h2
      have c1: int_lt(i, seq_len(F)) -> a in mallocng.held(c, A2, b) proof
        assume h
        have e: F2[i] = F[i] := at({seq_concat(F, seq_one(x))[i]}, fl, xl, hi, h)
        have ms nt := mp(all_elim(hsl, {i}), hi, h)
        have {acc = acc} := apply(mp.slot_meta[c := c, A := A, vm := vm, b := b, g := F[i]], hc, hu, ha, hh, ms, nt)
        have q _ _ := mp(all_elim(acc, {a}), hao, rewrite(e, h1), arith(rewrite(e, h2)))
        have ne: !(F[i] = x) proof
          assume e2
          have fnt := mp(all_elim(nt, {seq_len(T)}), tlo, (int_lt(seq_len(T), seq_len(A.taken)) by arith(lt)))
          show by taut(fnt, trans(tm, sym(e2)))
        qed
        have nx := apply(mp.meta_disj[c := c, A := A, M := M, b := b, brk := vm.brk, g := x, l := F[i], a := a], hc, hu, ha, H, xs, ms, ne, hao, rewrite(e, h1), arith(rewrite(e, h2)))
        show by taut(q, mp(all_elim(hs2, {a}), hao, nx))
      qed
      have c2: i = seq_len(F) -> a in mallocng.held(c, A2, b) proof
        assume h
        have e: F2[i] = x := rewrite(sym(h), at({seq_concat(F, seq_one(x))[seq_len(F)]}, fl))
        show := mp(all_elim(xh, {a}), hao, rewrite(e, h1), arith(rewrite(e, h2)))
      qed
      show by taut(c1, c2, (int_lt(i, seq_len(F)) || i = seq_len(F) by arith(hi, hil, lf2, fl)))
    qed
    have fo: F2[i] in omega := apply(at_type[l := F2, t := omega, i := i], f2l, hi, hil)
    have in8: all j. j in omega -> int_lt(j, 8) -> int_add(int_add(F2[i], 8), j) in mallocng.held(c, A2, b) proof
      fix j
      assume hj hjl
      show := mp(all_elim(inh, {int_add(int_add(F2[i], 8), j)}), arith(fo, hj), arith(fo, hj), arith(fo, hj, hjl))
    qed
    have in0: all j. j in omega -> int_lt(j, 8) -> int_add(F2[i], j) in mallocng.held(c, A2, b) proof
      fix j
      assume hj hjl
      show := mp(all_elim(inh, {int_add(F2[i], j)}), arith(fo, hj), arith(fo, hj), arith(fo, hj, hjl))
    qed
    have r8 := apply(mp.view_read[vm := V1, fp := mallocng.held(c, A2, b), a := int_add(F2[i], 8), n := 8], arith(fo), simp(), simp(), in8)
    have r0 := apply(mp.view_read[vm := V1, fp := mallocng.held(c, A2, b), a := F2[i], n := 8], fo, simp(), simp(), in0)
    have {lks = links} := apply(mp.list_rd[vm := V1, objs := objs, phead := PH, l := F2, i := i], vb2, phb, f2l, r1)
    have l8 l0 := mp(lks, hi, hil)
    show by taut(trans(sym(r8), l8), trans(sym(r0), l0))
  qed
  have cy2: mallocng.cyclic(M2, mallocng.ctx_word(c, M2, mallocng.C_FREE_META), F2) by defs(taut(hdw, dst2, lk2), mallocng.cyclic)
  have pt2 := apply(mp.part_back[A := A, T := T, x := x], ha, hpt, ht, hte)
  show by taut(hc, hu, ha, hb, hv, hv1, hh, xs, xnu, f2l, ko, nle, ht, tkx, xrw, hby, ep, rest, pt2, cy2, kc, kn)
qed

// ... the invariant kept
theorem mp.fb_holds_in(c, A, T, x, vm, V1, b, objs): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  vm in x86_64_linux.Vm -> V1 in x86_64_linux.Vm -> mallocng.holds_m(c, A, vm, b) -> mallocng.shown_in(c, A, objs) -> int_mod(c.ctx, 8) = 0 ->
  T in list_type(omega) -> A.taken = seq_concat(T, seq_one(x)) ->
  mallocng_specs.meta_joinable(vm, objs, int_add(c.ctx, 16), A.free_metas, x) -> mallocng_specs.meta_freed(vm, V1, objs, int_add(c.ctx, 16), x) ->
  (all a. a in omega -> int_le(x, a) -> int_lt(a, int_add(x, 40)) ->
     mallocng.m_rw(mallocng.mview(vm, mallocng.all_bytes()), a) && !(snd(mallocng.pg(mallocng.mview(vm, mallocng.all_bytes()), a)).kind = 2)) ->
  mallocng.holds_m(c, mp.back(A, T, x), V1, b)
proof
  assume hc hu ha hb hv hv1 hh hsh cal ht hte hj hfd xrw
  show := apply(mp.ms_holds_in, apply(mp.fb_ms, hc, hu, ha, hb, hv, hv1, hh, hsh, cal, ht, hte, hj, hfd, xrw))
qed

// (m, the meta taken last: in a meta area, so apart from the context)
theorem mp.meta_noctx(c, A, vm, b, T, m): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_m(c, A, vm, b) ->
  T in list_type(omega) -> A.taken = seq_concat(T, seq_one(m)) ->
  int_le(int_add(c.ctx, 928), m) || int_le(int_add(m, 40), c.ctx)
proof
  assume hc hu ha hh ht hte
  have {H = inv} := expand(hh, mallocng.holds_m)
  have {hpt = part} := expand(H, mallocng.holds)
  have {htk = taken} := expand(hpt, mallocng.metas_partition)
  have tlo: seq_len(T) in omega by arith(ht)
  have lt: seq_len(A.taken) = int_add(seq_len(T), 1) := rewrite(sym(hte), (seq_len(seq_concat(T, seq_one(m))) = int_add(seq_len(T), 1) by arith(ht)))
  have tm: A.taken[seq_len(T)] = m := rewrite(sym(hte), at({seq_concat(T, seq_one(m))[seq_len(T)]}, ht))
  have ms0 _ _ _ _ := mp(all_elim(htk, {seq_len(T)}), tlo, (int_lt(seq_len(T), seq_len(A.taken)) by arith(lt)))
  have mo mex := apply(mp.meta_page, ha, rewrite(tm, ms0))
  obtain k, hk hkl g1 g2 _ from mex
  have rl: A.areas in list_type(omega) by simp(ha)
  have ako := mp(at_type[l := A.areas, t := omega, i := k], rl, hk, hkl)
  have co: c.ctx in omega by simp(hc)
  have cs: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  have i0: int_le(c.ctx, int_add(c.ctx, 0)) && int_lt(int_add(c.ctx, 0), int_add(c.ctx, 928)) by arith(co)
  have i9: int_le(c.ctx, int_add(c.ctx, 927)) && int_lt(int_add(c.ctx, 927), int_add(c.ctx, 928)) by arith(co)
  have n0 := mp(all_elim(apply(mp.ctx_noarea[c := c, A := A, a := int_add(c.ctx, 0)], hc, hu, ha, H, arith(co),
    (mallocng.in_range(int_add(c.ctx, 0), pair(c.ctx, mallocng.CTX_SIZE)) by defs(simp(cs, i0), mallocng.in_range))), {k}), hk, hkl)
  have n9 := mp(all_elim(apply(mp.ctx_noarea[c := c, A := A, a := int_add(c.ctx, 927)], hc, hu, ha, H, arith(co),
    (mallocng.in_range(int_add(c.ctx, 927), pair(c.ctx, mallocng.CTX_SIZE)) by defs(simp(cs, i9), mallocng.in_range))), {k}), hk, hkl)
  show by arith(n0, n9, g1, g2, ako, mo, co)
qed

// (the taken meta m's bytes: in a meta area, the allocator's -- none of
// the ABI's)
theorem mp.taken_vis(c, A, vm, b, objs, T, m): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_m(c, A, vm, b) ->
  mallocng.shown_in(c, A, objs) -> T in list_type(omega) -> A.taken = seq_concat(T, seq_one(m)) ->
  all i. i in omega -> int_lt(i, 40) -> int_add(m, i) in objs.c_bytes
proof
  assume hc hu ha hh hsh ht hte
  have {H = inv} := expand(hh, mallocng.holds_m)
  have {hpt = part, har = areas} := expand(H, mallocng.holds)
  have {htk = taken} := expand(hpt, mallocng.metas_partition)
  have tl: A.taken in list_type(omega) by simp(ha)
  have tlo: seq_len(T) in omega by arith(ht)
  have lt: seq_len(A.taken) = int_add(seq_len(T), 1) := rewrite(sym(hte), (seq_len(seq_concat(T, seq_one(m))) = int_add(seq_len(T), 1) by arith(ht)))
  have tm: A.taken[seq_len(T)] = m := rewrite(sym(hte), at({seq_concat(T, seq_one(m))[seq_len(T)]}, ht))
  have ms0 _ _ nf0 _ := mp(all_elim(htk, {seq_len(T)}), tlo, (int_lt(seq_len(T), seq_len(A.taken)) by arith(lt)))
  have msl := rewrite(tm, ms0)
  have nf := rewrite(tm, nf0)
  have mo mex := apply(mp.meta_page, ha, msl)
  obtain k, hk hkl g1 g2 g3 from mex
  fix i
  assume hi hil
  have mio: int_add(m, i) in omega by arith(mo, hi)
  have fx := apply(mp.area_fixed[c := c, A := A, k := k, a := int_add(m, i)], hc, hu, ha, hk, hkl, arith(g1, hi), arith(g2, hi, hil))
  show := apply(mp.fixed_vis[c := c, A := A, objs := objs, a := int_add(m, i)], hc, hu, ha, hsh, mio, fx)
qed

// m, the meta taken last, ready (alloc_meta's): one free_meta may give
// back -- a meta slot apart from the list's head and from the free metas,
// its 40 bytes usable
// (any meta slot not a free one: a meta in use, or one taken)
theorem mp.fm_join_slot(c, A, vm, b, objs, m): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_m(c, A, vm, b) -> mallocng.shown_in(c, A, objs) ->
  mallocng.meta_slot(A, m) -> (all k. k in omega -> int_lt(k, seq_len(A.free_metas)) -> !(A.free_metas[k] = m)) -> mallocng_specs.meta_ready(vm, m) ->
  mallocng_specs.meta_joinable(vm, objs, int_add(c.ctx, 16), A.free_metas, m)
proof
  assume hc hu ha hh hsh msl nf hrd
  have {H = inv} := expand(hh, mallocng.holds_m)
  have {hpt = part, har = areas} := expand(H, mallocng.holds)
  have mo mex := apply(mp.meta_page, ha, msl)
  obtain k, hk hkl g1 g2 g3 from mex
  have rl: A.areas in list_type(omega) by simp(ha)
  have ako := mp(at_type[l := A.areas, t := omega, i := k], rl, hk, hkl)
  have {aeach = each} := expand(har, mallocng.areas_ok)
  have aal _ _ _ _ _ := mp(all_elim(aeach, {k}), hk, hkl)
  have mal: int_mod(m, 8) = 0 by arith(g3, aal, g1, ako, mo)
  // (its bytes: read-write, so in user space)
  have rwa _ _ := expand(hrd, mallocng_specs.meta_ready)
  have each: all i. i in omega -> int_lt(i, 40) -> int_add(m, i) in mallocng.all_bytes() && mallocng.m_rw(mallocng.mview(vm, mallocng.all_bytes()), int_add(m, i)) &&
      !(snd(mallocng.pg(mallocng.mview(vm, mallocng.all_bytes()), int_add(m, i))).kind = 2) proof
    fix i
    assume hi hil
    have r1 r2 := mp(all_elim(rwa, {int_add(m, i)}), (int_add(m, i) in omega by arith(mo, hi)),
      (int_le(m, int_add(m, i)) && int_lt(int_add(m, i), int_add(m, mallocng.META_SIZE)) by defs(arith(hi, hil), mallocng.META_SIZE)))
    have mio: int_add(m, i) in omega by arith(mo, hi)
    show by taut((int_add(m, i) in mallocng.all_bytes() by defs(simp(mio), mallocng.all_bytes)), r1, r2)
  qed
  // (... in a meta area, the allocator's: none of the ABI's)
  have nh: all i. i in omega -> int_lt(i, 40) -> int_add(m, i) in objs.c_bytes proof
    fix i
    assume hi hil
    have mio: int_add(m, i) in omega by arith(mo, hi)
    have fx := apply(mp.area_fixed[c := c, A := A, k := k, a := int_add(m, i)], hc, hu, ha, hk, hkl, arith(g1, hi), arith(g2, hi, hil))
    show := apply(mp.fixed_vis[c := c, A := A, objs := objs, a := int_add(m, i)], hc, hu, ha, hsh, mio, fx)
  qed
  have u1 u2 := apply(mp.rw_usable_at[vm := vm, F := mallocng.all_bytes(), objs := objs, a := m, n := 40], mo, each, nh)
  have _ e39 _ := mp(each, {39}, simp(), simp())
  have mm39 _ _ := expand(e39, mallocng.m_rw)
  have p39 _ := expand(mm39, mallocng.m_mapped)
  have ts: int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE) = 34359738367 by defs(simp(), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
  have pg: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
  have bnd: int_le(int_add(m, 40), int_pow(2, 64)) by arith(p39, ts, pg, mo)
  // (apart from the list's head, in the context: not in an area)
  have co: c.ctx in omega by simp(hc)
  have cs: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  have i16: int_le(c.ctx, int_add(c.ctx, 16)) && int_lt(int_add(c.ctx, 16), int_add(c.ctx, 928)) by arith(co)
  have i23: int_le(c.ctx, int_add(c.ctx, 23)) && int_lt(int_add(c.ctx, 23), int_add(c.ctx, 928)) by arith(co)
  have na16 := mp(all_elim(apply(mp.ctx_noarea[c := c, A := A, a := int_add(c.ctx, 16)], hc, hu, ha, H, arith(co),
    (mallocng.in_range(int_add(c.ctx, 16), pair(c.ctx, mallocng.CTX_SIZE)) by defs(simp(cs, i16), mallocng.in_range))), {k}), hk, hkl)
  have na23 := mp(all_elim(apply(mp.ctx_noarea[c := c, A := A, a := int_add(c.ctx, 23)], hc, hu, ha, H, arith(co),
    (mallocng.in_range(int_add(c.ctx, 23), pair(c.ctx, mallocng.CTX_SIZE)) by defs(simp(cs, i23), mallocng.in_range))), {k}), hk, hkl)
  have oh: int_le(int_add(int_add(c.ctx, 16), 8), m) || int_le(int_add(m, 40), int_add(c.ctx, 16)) by arith(na16, na23, g1, g2, ako, mo, co)
  // (apart from each free meta: another meta slot)
  have ol: all i. i in omega -> int_lt(i, seq_len(A.free_metas)) -> int_le(int_add(A.free_metas[i], 16), m) || int_le(int_add(m, 40), A.free_metas[i]) proof
    fix i
    assume hi hil
    have {fsl = free_slots} := expand(hpt, mallocng.metas_partition)
    have fs _ := mp(all_elim(fsl, {i}), hi, hil)
    have ne := mp(all_elim(nf, {i}), hi, hil)
    have fo _ := apply(mp.meta_page, ha, fs)
    have d1 := apply(mp.meta_disj[c := c, A := A, g := m, l := A.free_metas[i], a := A.free_metas[i]], hc, hu, ha, H, msl, fs, ne, fo, arith(fo), arith(fo))
    have d2 := apply(mp.meta_disj[c := c, A := A, g := A.free_metas[i], l := m, a := m], hc, hu, ha, H, fs, msl, (!(m = A.free_metas[i]) by taut(ne)), mo, arith(mo), arith(mo))
    show by arith(d1, d2, fo, mo)
  qed
  show by defs(taut((!(m = 0) by arith(g1, ako)), bnd, mal, u1, u2, oh, ol), mallocng_specs.meta_joinable)
qed

// (the meta last taken)
theorem mp.fm_join(c, A, vm, b, objs, T, m): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_m(c, A, vm, b) -> mallocng.shown_in(c, A, objs) ->
  T in list_type(omega) -> A.taken = seq_concat(T, seq_one(m)) -> mallocng_specs.meta_ready(vm, m) ->
  mallocng_specs.meta_joinable(vm, objs, int_add(c.ctx, 16), A.free_metas, m)
proof
  assume hc hu ha hh hsh ht hte hrd
  have {H = inv} := expand(hh, mallocng.holds_m)
  have {hpt = part} := expand(H, mallocng.holds)
  have {htk = taken} := expand(hpt, mallocng.metas_partition)
  have tl: A.taken in list_type(omega) by simp(ha)
  have tlo: seq_len(T) in omega by arith(ht)
  have lt: seq_len(A.taken) = int_add(seq_len(T), 1) := rewrite(sym(hte), (seq_len(seq_concat(T, seq_one(m))) = int_add(seq_len(T), 1) by arith(ht)))
  have tm: A.taken[seq_len(T)] = m := rewrite(sym(hte), at({seq_concat(T, seq_one(m))[seq_len(T)]}, ht))
  have ms0 _ _ nf0 _ := mp(all_elim(htk, {seq_len(T)}), tlo, (int_lt(seq_len(T), seq_len(A.taken)) by arith(lt)))
  show := apply(mp.fm_join_slot[c := c, A := A, vm := vm, b := b, objs := objs, m := m], hc, hu, ha, hh, hsh, rewrite(tm, ms0), rewrite(tm, nf0), hrd)
qed

// ----------------------------------------------------------------------
//  The slot counts' tables read

// (a byte of the image's read-only segments: the invariant's)
theorem mp.ro_view(c, A, vm, b, i, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  mallocng.holds_m(c, A, vm, b) -> a in omega -> i in omega -> int_lt(i, x86_64_linux.phnum(c.file)) -> mallocng.in_range(a, mallocng.ro_ranges(c.file)[i]) ->
  a in mallocng.held(c, A, b)
proof
  assume hc hu ha hb hh hao hi hil inr
  let M := mallocng.mview(vm, mallocng.held(c, A, b))
  have {H = inv} := expand(hh, mallocng.holds_m)
  have {huo = used, hga = apart} := expand(H, mallocng.holds)
  let RO := mallocng.ro_ranges(c.file)
  let FR := seq_concat(seq_concat(mallocng.ro_ranges(c.file), mallocng.data_ranges(c)), mallocng.auxv_ranges(A))
  have fs: c.file in seq_type(bits(8)) by simp(hc)
  have pn: x86_64_linux.phnum(c.file) in omega by defs(mp(x86.le_at_nat[f := c.file, off := 56, n := 2], fs, simp()), x86_64_linux.phnum)
  have rol := apply(mp.ro_list, fs)
  have rlen: seq_len(RO) = x86_64_linux.phnum(c.file) by defs(arith(fn_build_dom[d := int_sub(x86_64_linux.phnum(c.file), 0), v := x0. ite(x86_64_linux.is_load(c.file, int_add(0, x0)) && !bit(x86_64_linux.segment(c.file, int_add(0, x0)).flags, 1), pair(x86_64_linux.segment(c.file, int_add(0, x0)).vaddr, x86_64_linux.segment(c.file, int_add(0, x0)).memsz), pair(0, 0))], pn), seq_len, mallocng.ro_ranges)
  have {pf = front, par = areas, prs = reserve, pcl = classes, pdb = debruijn} := apply(mp.fp_pieces, hc, hu, ha)
  have il: int_lt(i, seq_len(RO)) by arith(rlen, hil)
  have cf: c.ctx in omega && c.lock in omega && c.libc in omega by simp(hc)
  have o1 := apply(tr.seq_one_type, (pair(c.ctx, mallocng.CTX_SIZE) in univ(1) by simp(cf)))
  have o2 := apply(tr.seq_one_type, (pair(c.lock, 4) in univ(1) by simp(cf)))
  have o3 := apply(tr.seq_one_type, (pair(c.libc, 16) in univ(1) by simp(cf)))
  have dl: mallocng.data_ranges(c) in list_type(univ(1)) by defs(apply(tr.concat_list, apply(tr.concat_list, o1, o2), o3), mallocng.data_ranges)
  have {xl = auxv} := apply(mp.front_pieces, hc, hu, ha)
  have e1: FR[i] = RO[i] := at({FR[i]}, rol, dl, xl, hi, il)
  have lf: int_lt(i, seq_len(FR)) by arith(rol, dl, xl, il)
  have irf: mallocng.in_ranges(a, FR) by defs(ex_intro({i}, taut(hi, lf, rewrite(sym(e1), inr))), mallocng.in_ranges)
  // (in the fixed regions: no client's)
  let FX := seq_concat(seq_concat(seq_concat(seq_concat(FR, fn_build(int_sub(seq_len(A.areas), 0), x0. pair(A.areas[int_add(0, x0)], 4096))), seq_one(pair(A.reserve, int_mul(4096, A.reserve_cnt)))), seq_one(pair(c.sct, int_mul(2, 48)))), seq_one(pair(c.dbj, 32)))
  have fxe: mallocng.fixed_ranges(c, A) = FX by defs(refl({FX}), mallocng.fixed_ranges)
  have ef: FX[i] = RO[i] := at({FX[i]}, rol, dl, xl, par, prs, pcl, pdb, hi, il)
  have lfx: int_lt(i, seq_len(FX)) by arith(rol, dl, xl, par, prs, pcl, pdb, il)
  have irx: mallocng.in_ranges(a, mallocng.fixed_ranges(c, A)) := rewrite(sym(fxe), (mallocng.in_ranges(a, FX) by defs(ex_intro({i}, taut(hi, lfx, rewrite(sym(ef), inr))), mallocng.in_ranges)))
  have nl: !(a in malloc.live_of(b)) proof
    assume l
    show by taut(irx, apply(mp.live_nofix[c := c, A := A, M := M, b := b, brk := vm.brk, a := a], ha, hb, H, l))
  qed
  have nt := apply(mp.untaken_of, hc, hu, ha, H, hao, apply(mp.ro_noarea, hc, hu, ha, H, hao, hi, hil, inr))
  have nr := apply(mp.fixed_unres[c := c, A := A, M := M, b := b, a := a], hc, hu, ha, hao, huo, hga, taut(irf))
  have fp := apply(mp.fp_intro, hc, hu, ha, hao, nl, nr, nt, taut(irf))
  show := apply(mp.ro_held[c := c, A := A, M := M, b := b, brk := vm.brk, i := i, a := a], hc, hu, ha, H, hi, hil, inr, fp)
qed

// (a byte read through the invariant's view, held, mapped below the user
// space's end, readable: usable, its value the view's)
theorem mp.held_rd1(c, A, vm, b, objs, a): vm.bytes in fn_space(bits(64), bits(8)) -> a in omega -> a in mallocng.held(c, A, b) ->
  mallocng.m_mapped(mallocng.mview(vm, mallocng.held(c, A, b)), a) -> snd(mallocng.pg(mallocng.mview(vm, mallocng.held(c, A, b)), a)).prot.r ->
  !(snd(mallocng.pg(mallocng.mview(vm, mallocng.held(c, A, b)), a)).kind = 2) -> mallocng.shown_in(c, A, objs) ->
  gimple.usable(vm, objs, a, 1, false) && gimple.bytes_at(vm, bits_of_int(64, a), 1) = mallocng.b8(mallocng.mview(vm, mallocng.held(c, A, b)), a)
proof
  assume hvb hao hd mm pr nk hsh
  let FP := mallocng.held(c, A, b)
  let M := mallocng.mview(vm, FP)
  have t0: int_add(a, 0) = a by arith(hao)
  have bj: all j. j in omega -> int_lt(j, 1) -> int_add(a, j) in FP && mallocng.m_mapped(M, int_add(a, j)) &&
      snd(mallocng.pg(M, int_add(a, j))).prot.r && !(snd(mallocng.pg(M, int_add(a, j))).kind = 2) proof
    fix j
    assume hj hjl
    have j0: j = 0 by arith(hj, hjl)
    show by simp(j0, t0, hd, mm, pr, nk)
  qed
  have us := apply(mp.view_usable[vm := vm, fp := FP, objs := objs, a := a, n := 1], hao, bj, apply(mp.held_vis[c := c, A := A, objs := objs, b := b], hsh))
  have infp: all j. j in omega -> int_lt(j, 1) -> int_add(a, j) in FP proof
    fix j
    assume hj hjl
    have r := mp(all_elim(bj, {j}), hj, hjl)
    show by taut(r)
  qed
  have vr := apply(mp.view_read[vm := vm, fp := FP, a := a, n := 1], hao, simp(), simp(), infp)
  have mm2 := expand(mm, mallocng.m_mapped, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
  have tl: int_lt(int_div(a, 4096), int_div(int_sub(int_pow(2, 47), 4096), 4096)) by taut(mm2)
  have bt: bits_of_int(64, a) = a by defs(arith(tl, hao), bits_of_int, pow2)
  have _ bvo := apply(mp.b8_view[vm := vm, fp := FP, a := a], hvb, hao, hd)
  have r1: mallocng.rd(M, a, 1) = mallocng.b8(M, a) by defs(simp(bvo, t0), mallocng.rd)
  show by taut(us, subst({y. gimple.bytes_at(vm, y, 1) = mallocng.b8(M, a)}, sym(bt), trans(vr, r1)))
qed

// the slot counts' tables: readable, as the source has them
theorem mp.counts_tables(c, A, vm, b, objs): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  vm in x86_64_linux.Vm -> mallocng.holds_m(c, A, vm, b) -> mallocng.shown_in(c, A, objs) ->
  small: mallocng_specs.table_ok(vm, objs, c.scnt, 1, mallocng.small_cnt_tab) && med: mallocng_specs.table_ok(vm, objs, c.mcnt, 1, mallocng.med_cnt_tab)
proof
  assume hc hu ha hb hv hh hsh
  have hvb: vm.bytes in fn_space(bits(64), bits(8)) by simp(hv)
  let M := mallocng.mview(vm, mallocng.held(c, A, b))
  have {H = inv} := expand(hh, mallocng.holds_m)
  have {co = classes} := expand(H, mallocng.holds)
  have _ _ _ kc := expand(co, mallocng.classes_ok)
  have {ks = small, km = med, kr = read, kso = ro_small, kmo = ro_med} := expand(kc, mallocng.counts_ok)
  have sco: c.scnt in omega by simp(hc)
  have mco: c.mcnt in omega by simp(hc)
  obtain si, hsi hsil s1 s2 from kso
  obtain mi, hmi hmil m1 m2 from kmo
  have ls: seq_len(mallocng.small_cnt_tab) = 27 by defs(simp(), mallocng.small_cnt_tab)
  have lm: seq_len(mallocng.med_cnt_tab) = 4 by defs(simp(), mallocng.med_cnt_tab)
  have t1: all x0. x0 in omega -> int_lt(x0, seq_len(mallocng.small_cnt_tab)) ->
      gimple.usable(vm, objs, int_add(c.scnt, int_mul(1, x0)), 1, false) && gimple.bytes_at(vm, bits_of_int(64, int_add(c.scnt, int_mul(1, x0))), 1) = mallocng.small_cnt_tab[x0] proof
    fix i
    assume hi hl
    let T := int_add(c.scnt, int_mul(1, i))
    have i27: int_lt(i, 27) by simp(hl, ls)
    have to: T in omega by arith(sco, hi)
    have inr: mallocng.in_range(T, mallocng.ro_ranges(c.file)[si]) by defs(arith(s1, s2, sco, hi, i27), mallocng.in_range)
    have hd := apply(mp.ro_view[c := c, A := A, vm := vm, b := b, i := si, a := T], hc, hu, ha, hb, hh, to, hsi, hsil, inr)
    have mm pr nk := mp(all_elim(kr, {T}), to, (int_le(c.scnt, T) && int_lt(T, int_add(c.scnt, 27)) || int_le(c.mcnt, T) && int_lt(T, int_add(c.mcnt, 4)) by arith(sco, hi, i27)))
    have us bv := apply(mp.held_rd1[c := c, A := A, vm := vm, b := b, objs := objs, a := T], hvb, to, hd, mm, pr, nk, hsh)
    have ti: T = int_add(c.scnt, i) by arith(sco, hi)
    show by taut(us, trans(bv, rewrite(sym(ti), mp(all_elim(ks, {i}), hi, i27))))
  qed
  have t2: all x0. x0 in omega -> int_lt(x0, seq_len(mallocng.med_cnt_tab)) ->
      gimple.usable(vm, objs, int_add(c.mcnt, int_mul(1, x0)), 1, false) && gimple.bytes_at(vm, bits_of_int(64, int_add(c.mcnt, int_mul(1, x0))), 1) = mallocng.med_cnt_tab[x0] proof
    fix i
    assume hi hl
    let T := int_add(c.mcnt, int_mul(1, i))
    have i4: int_lt(i, 4) by simp(hl, lm)
    have to: T in omega by arith(mco, hi)
    have inr: mallocng.in_range(T, mallocng.ro_ranges(c.file)[mi]) by defs(arith(m1, m2, mco, hi, i4), mallocng.in_range)
    have hd := apply(mp.ro_view[c := c, A := A, vm := vm, b := b, i := mi, a := T], hc, hu, ha, hb, hh, to, hmi, hmil, inr)
    have mm pr nk := mp(all_elim(kr, {T}), to, (int_le(c.scnt, T) && int_lt(T, int_add(c.scnt, 27)) || int_le(c.mcnt, T) && int_lt(T, int_add(c.mcnt, 4)) by arith(mco, hi, i4)))
    have us bv := apply(mp.held_rd1[c := c, A := A, vm := vm, b := b, objs := objs, a := T], hvb, to, hd, mm, pr, nk, hsh)
    have ti: T = int_add(c.mcnt, i) by arith(mco, hi)
    show by taut(us, trans(bv, rewrite(sym(ti), mp(all_elim(km, {i}), hi, i4))))
  qed
  show by defs(taut(t1, t2), mallocng_specs.table_ok)
qed
