// The metas' supply changed, the groups as before (alloc_meta: a meta
// taken, an area added; the context's words, the free metas' links, the
// areas' headers, fresh pages written): the invariant's clauses about the
// groups -- their records and bytes, the lists, the slots -- kept by the
// frame (`mp.sframe`, `mp.holds_sframe`), the supply's clauses each
// operation's own.

// (a group's conditions read the state's groups only: its metas, slots,
// the groups in use and the active lists)
theorem mp.group_fields(A, A2, M, b, h): A2.metas = A.metas -> A2.slots = A.slots -> A2.used = A.used -> A2.active = A.active ->
  mallocng.group_ok(A, M, b, h) -> mallocng.group_ok(A2, M, b, h)
proof
  assume em es eu ea g
  have g0 := expand(g, mallocng.group_ok, mallocng.is_used, mallocng.slot_ok, mallocng.masks_ok, mallocng.big_ok)
  show by defs(rewrite(sym(ea), rewrite(sym(eu), rewrite(sym(es), rewrite(sym(em), g0)))),
    mallocng.group_ok, mallocng.is_used, mallocng.slot_ok, mallocng.masks_ok, mallocng.big_ok)
qed

// the groups in use on a view agreeing at their bytes and their metas'
// records, in a state of the same groups: as before
theorem mp.used_tr(A, A2, M, M2, b): A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  A2.metas = A.metas -> A2.slots = A.slots -> A2.used = A.used -> A2.active = A.active ->
  mallocng.used_ok(A, M, b) -> (all a. a in omega -> mp.ingrp(A, a) -> M2[a] = M[a]) ->
  (all g. all a. mallocng.is_used(A, g) -> a in omega -> int_le(g, a) -> int_lt(a, int_add(g, 40)) -> M2[a] = M[a]) ->
  mallocng.used_ok(A2, M2, b)
proof
  assume ha hb em es eu ea huo gbs rcs
  have gm: mp.geom(A, A) by simp(expand(ha, mallocng.Abs))
  have gg := apply(mp.geoms_of, ha, gm)
  have ul: A.used in list_type(omega) by simp(ha)
  have r: all x0. x0 in omega -> int_lt(x0, seq_len(A2.used)) -> mallocng.group_ok(A2, M2, b, A2.used[x0]) proof
    fix k
    assume hk hkl0
    have hkl: int_lt(k, seq_len(A.used)) := rewrite(eu, hkl0)
    let h := A.used[k]
    let V := A.metas[h]
    have ho := apply(at_type[l := A.used, t := omega, i := k], ul, hk, hkl)
    have iu: mallocng.is_used(A, h) by defs(ex_intro({k}, taut(hk, hkl, refl({h}))), mallocng.is_used)
    have gok := apply(mp.used_group, huo, iu)
    have {hm = mim, hmk = masks, hbg = big, hli = linked, hul = unlinked, hac = act, hsm = small} := expand(gok, mallocng.group_ok)
    // its bytes and its record: as before
    have agh: all a. a in omega -> int_le(V.mem, a) -> int_le(a, mallocng.slot_end(V, V.last_idx)) -> M2[a] = M[a] proof
      fix a
      assume hao h1 h2
      have gh: mp.gb(A, h, a) by defs(taut(h1, h2), mp.gb)
      show := mp(all_elim(gbs, {a}), hao, (mp.ingrp(A, a) by defs(ex_intro({h}, taut(iu, gh)), mp.ingrp)))
    qed
    have a40: all j. j in omega -> int_lt(j, 40) -> M2[int_add(h, j)] = M[int_add(h, j)] proof
      fix j
      assume hj hjl
      show := mp(all_elim(rcs, {h}, {int_add(h, j)}), iu, simp(ho, hj), arith(ho, hj), arith(ho, hj, hjl))
    qed
    have m1 := apply(mp.mim_mem[M := M, M2 := M2, h := h, v := V], ho, hm, a40)
    have vt: V in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A.metas, x := h], simp(ha), ho)
    have vmem: V.mem in omega by simp(vt)
    have vlast: V.last_idx in omega by simp(vt)
    have sn := apply(mp.stride_nat, ha, ho, gok)
    have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
    have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
    have ss: all i. mallocng.slot_start(V, i) = int_add(int_add(V.mem, 16), int_mul(mallocng.stride(V), i)) proof
      fix i
      show by defs(arith(cu), mallocng.slot_start, mallocng.storage)
    qed
    have sel: mallocng.slot_end(V, V.last_idx) = int_sub(int_add(int_add(int_add(V.mem, 16), int_mul(mallocng.stride(V), V.last_idx)), mallocng.stride(V)), 4)
      by defs(simp(all_elim(ss, {V.last_idx}), ci), mallocng.slot_end)
    have ml: int_mul(mallocng.stride(V), V.last_idx) in omega by simp(sn, vlast)
    have {bxb = byte} := apply(mp.agree_b8, mp(all_elim(agh, {int_add(V.mem, 8)}), simp(vmem), arith(vmem), arith(sel, ml, vmem, sn)))
    have es8: all i. i in omega -> int_le(i, V.last_idx) ->
        mallocng.b8(M2, int_sub(mallocng.slot_start(V, i), 4)) = mallocng.b8(M, int_sub(mallocng.slot_start(V, i), 4)) proof
      fix i
      assume hi hil
      have mi := mp(all_elim(ms.mul_le, {mallocng.stride(V)}, {i}, {mallocng.stride(V)}, {V.last_idx}), sn, hi, simp(sn), simp(vlast), arith(sn), hil)
      have si := all_elim(ss, {i})
      have mo: int_mul(mallocng.stride(V), i) in omega by simp(sn, hi)
      have a := mp(all_elim(agh, {int_sub(mallocng.slot_start(V, i), 4)}), arith(si, vmem, mo), arith(si, vmem, mo), arith(si, sel, mi, vmem, mo, ml, sn))
      have {ab = byte} := apply(mp.agree_b8, a)
      show := ab
    qed
    have mk := apply(mp.masks_mem[A := A, M := M, M2 := M2, h := h], hmk, bxb, es8)
    have lk: mp.links_ok(A, h) by defs(taut(hli, hul), mp.links_ok)
    have act2: int_le(int_mod(mallocng.b8(M2, int_add(V.mem, 8)), 32), V.last_idx) := rewrite(sym(bxb), hac)
    have sm2: mallocng.stride(V) = mallocng.UNIT -> int_mod(mallocng.b8(M2, int_add(V.mem, 8)), 32) = V.last_idx := rewrite(sym(bxb), hsm)
    have ag2: all a. a in omega -> int_le(V.mem, a) -> int_le(a, mallocng.slot_end(V, V.last_idx)) -> !(a = int_add(V.mem, 8)) ->
        (all j. j in omega -> int_lt(j, seq_len(A.slots[h])) ->
           ((A.slots[h][j] = tag(0, empty) || A.slots[h][j] = tag(3, empty)) -> !mallocng.in_slot(V, j, a)) &&
           (fst(A.slots[h][j]) = 2 -> !(int_le(mallocng.slot_start(V, j), a) && int_lt(a, mallocng.slot_end(V, j))))) ->
        M2[a] = M[a] proof
      fix a
      assume hao h1 h2 _ _
      show := mp(all_elim(agh, {a}), hao, h1, h2)
    qed
    have g1 := apply(mp.group_tr_s[A := A, A2 := A, M := M, M2 := M2, b := b, h := h], ha, hb, ho, gg, huo, gok, ag2, m1, mk, hbg, lk, act2, sm2)
    have g2 := apply(mp.group_fields[A := A, A2 := A2, M := M2, b := b, h := h], em, es, eu, ea, g1)
    show := rewrite(sym(eu), g2)
  qed
  show by defs(r, mallocng.used_ok)
qed

theorem mp.partial_tr(A, A2, M, M2, b): A in mallocng.Abs -> A2.metas = A.metas -> A2.active = A.active ->
  mallocng.active_ok(A) -> mallocng.used_ok(A, M, b) -> mallocng.partial_ok(A, M) -> (all a. a in omega -> mp.ingrp(A, a) -> M2[a] = M[a]) ->
  mallocng.partial_ok(A2, M2)
proof
  assume ha em ea hac huo hp gbs
  have p1 p2 := expand(hp, mallocng.partial_ok)
  // (a group on a list: partial after just when before -- its header's byte as before)
  have pe: all sc. all g. sc in omega -> int_lt(sc, 48) -> mallocng.on_list(A.active[sc], g) -> (mallocng.partial(M2, A2, g) <-> mallocng.partial(M, A, g)) proof
    fix sc g
    assume hs hsl ol
    obtain k, hk hkl hke from expand(ol, mallocng.on_list)
    have iu0 _ _ := mp(all_elim(expand(hac, mallocng.active_ok), {sc}, {k}), conj(hs, hk), conj(hsl, hkl))
    have iu := rewrite(hke, iu0)
    have {go = nat} := apply(mp.used_nat, ha, iu)
    have gok := apply(mp.used_group, huo, iu)
    let V := A.metas[g]
    have vt: V in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A.metas, x := g], simp(ha), go)
    have vmem: V.mem in omega by simp(vt)
    have vlast: V.last_idx in omega by simp(vt)
    have sn := apply(mp.stride_nat, ha, go, gok)
    have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
    have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
    have sel: mallocng.slot_end(V, V.last_idx) = int_sub(int_add(int_add(int_add(V.mem, 16), int_mul(mallocng.stride(V), V.last_idx)), mallocng.stride(V)), 4)
      by defs(simp(cu, ci), mallocng.slot_end, mallocng.slot_start, mallocng.storage)
    have ml: int_mul(mallocng.stride(V), V.last_idx) in omega by simp(sn, vlast)
    have gb8: mp.gb(A, g, int_add(V.mem, 8)) by defs(arith(sel, ml, vmem, sn), mp.gb)
    have ig: mp.ingrp(A, int_add(V.mem, 8)) by defs(ex_intro({g}, taut(iu, gb8)), mp.ingrp)
    have {eb = byte} := apply(mp.agree_b8, mp(all_elim(gbs, {int_add(V.mem, 8)}), simp(vmem), ig))
    show by defs(simp(eb, em), mallocng.partial)
  qed
  have c1: all x0. all x1. all x2. (x0 in omega && x1 in omega) && x2 in omega -> (((int_lt(x0, 48) && mallocng.on_list(A2.active[x0], x1)) &&
      mallocng.on_list(A2.active[x0], x2)) && mallocng.partial(M2, A2, x1)) && mallocng.partial(M2, A2, x2) -> x1 = x2 proof
    fix sc g g2
    assume ho h
    have hs _ _ := ho
    have hsl o1 o2 q1 q2 := h
    have o1a := rewrite(ea, o1)
    have o2a := rewrite(ea, o2)
    have r1 := mp(all_elim(pe, {sc}, {g}), hs, hsl, o1a)
    have r2 := mp(all_elim(pe, {sc}, {g2}), hs, hsl, o2a)
    show := mp(all_elim(p1, {sc}, {g}, {g2}), ho, taut(hsl, o1a, o2a, r1, r2, q1, q2))
  qed
  have c2: all x0. all x1. x0 in omega && x1 in omega -> (int_lt(x0, 48) && mallocng.on_list(A2.active[x0], x1)) && mallocng.partial(M2, A2, x1) ->
      int_lt(4096, int_add(mallocng.UNIT, int_mul(mallocng.stride(A2.metas[x1]), int_add(A2.metas[x1].last_idx, 1)))) proof
    fix sc g
    assume ho h
    have hs _ := ho
    have hsl o1 q1 := h
    have o1a := rewrite(ea, o1)
    have r1 := mp(all_elim(pe, {sc}, {g}), hs, hsl, o1a)
    show := rewrite(sym(em), mp(all_elim(p2, {sc}, {g}), ho, taut(hsl, o1a, r1, q1)))
  qed
  show by defs(taut(c1, c2), mallocng.partial_ok)
qed

// The image intact on a view agreeing at its read-only segments' bytes,
// the pages it is the last segment on (their starts), libc's need-locks
// byte and the lock word
theorem mp.image_tr(c, M, M2): c in mallocng.Cfg -> mallocng.image_ok(c, M) ->
  (all i. all a. i in omega -> a in omega -> int_lt(i, x86_64_linux.phnum(c.file)) -> mallocng.in_range(a, mallocng.ro_ranges(c.file)[i]) -> M2[a] = M[a]) ->
  M2[int_add(c.libc, mallocng.L_NEED_LOCKS)] = M[int_add(c.libc, mallocng.L_NEED_LOCKS)] ->
  (all i. i in omega -> int_lt(i, 4) -> M2[int_add(c.lock, i)] = M[int_add(c.lock, i)]) ->
  mallocng.image_ok(c, M2)
proof
  assume hc himg ro nl lk
  have i1 i2 i3 := expand(himg, mallocng.image_ok)
  let FL := c.file
  have fs: FL in seq_type(bits(8)) by simp(hc)
  have pn: x86_64_linux.phnum(FL) in omega by defs(mp(x86.le_at_nat[f := FL, off := 56, n := 2], fs, simp()), x86_64_linux.phnum)
  have ro2: all x0. x0 in omega -> int_lt(x0, x86_64_linux.phnum(FL)) && x86_64_linux.is_load(FL, x0) -> mallocng.ro_segment_ok(FL, x0, x86_64_linux.segment(FL, x0), M2) proof
    fix i
    assume hi hq
    let SG := x86_64_linux.segment(FL, i)
    have rs := mp(all_elim(i1, {i}), hi, hq)
    have hil hld := hq
    have r: !bit(SG.flags, 1) ->
        (all x0. x0 in omega -> int_le(SG.vaddr, x0) && int_lt(x0, int_add(SG.vaddr, SG.memsz)) ->
           mallocng.b8(M2, x0) = ite(int_lt(x0, int_add(SG.vaddr, SG.filesz)), FL[int_add(SG.offset, int_sub(x0, SG.vaddr))], 0)) &&
        (all x0. x0 in omega -> (int_le(SG.vaddr, x0) && int_lt(x0, int_add(SG.vaddr, SG.memsz))) && x86_64_linux.last_on_page(FL, i, int_div(x0, x86_64_linux.PAGE)) ->
           mallocng.pg(M2, x0) = some(fn_update(fn_update(empty, "prot", x86_64_linux.seg_prot(SG)), "kind", 0))) proof
      assume hw
      have b1 b2 := mp(expand(rs, mallocng.ro_segment_ok), hw)
      have iin := mp(nat_lt_mem[k := i, n := int_sub(x86_64_linux.phnum(FL), 0)], hi, arith(pn), arith(hil, pn, hi))
      have ab := mp(app_fn_build[d := int_sub(x86_64_linux.phnum(FL), 0), v := x0. ite(x86_64_linux.is_load(FL, int_add(0, x0)) && !bit(x86_64_linux.segment(FL, int_add(0, x0)).flags, 1),
        pair(x86_64_linux.segment(FL, int_add(0, x0)).vaddr, x86_64_linux.segment(FL, int_add(0, x0)).memsz), pair(0, 0)), a := i], iin)
      have ri: mallocng.ro_ranges(FL)[i] = pair(SG.vaddr, SG.memsz) by defs(simp(ab, (int_add(0, i) = i by arith(hi)), hld, hw), mallocng.ro_ranges)
      have ag: all x0. x0 in omega -> int_le(SG.vaddr, x0) && int_lt(x0, int_add(SG.vaddr, SG.memsz)) -> M2[x0] = M[x0] proof
        fix x
        assume hx hxr
        have inr: mallocng.in_range(x, mallocng.ro_ranges(FL)[i]) by defs(simp(ri, hxr), mallocng.in_range)
        show := mp(all_elim(ro, {i}, {x}), hi, hx, hil, inr)
      qed
      have bt: all x0. x0 in omega -> int_le(SG.vaddr, x0) && int_lt(x0, int_add(SG.vaddr, SG.memsz)) ->
          mallocng.b8(M2, x0) = ite(int_lt(x0, int_add(SG.vaddr, SG.filesz)), FL[int_add(SG.offset, int_sub(x0, SG.vaddr))], 0) proof
        fix x
        assume hx hxr
        have {eb = byte} := apply(mp.agree_b8, mp(all_elim(ag, {x}), hx, hxr))
        show := trans(eb, mp(all_elim(b1, {x}), hx, hxr))
      qed
      have pt: all x0. x0 in omega -> (int_le(SG.vaddr, x0) && int_lt(x0, int_add(SG.vaddr, SG.memsz))) && x86_64_linux.last_on_page(FL, i, int_div(x0, x86_64_linux.PAGE)) ->
          mallocng.pg(M2, x0) = some(fn_update(fn_update(empty, "prot", x86_64_linux.seg_prot(SG)), "kind", 0)) proof
        fix x
        assume hx hxr
        have r1 r2 _ := hxr
        have {ep = page} := apply(mp.agree_b8, mp(all_elim(ag, {x}), hx, conj(r1, r2)))
        show := trans(ep, mp(all_elim(b2, {x}), hx, hxr))
      qed
      show by taut(bt, pt)
    qed
    show by defs(r, mallocng.ro_segment_ok)
  qed
  have {elb = byte} := apply(mp.agree_b8, nl)
  have rl := apply(mp.agree_rd[M := M, M2 := M2, a := c.lock, n := 4], simp(), lk)
  show by defs(taut(ro2, rewrite(sym(elb), i2), rewrite(sym(rl), i3)), mallocng.image_ok)
qed

// the class table, a_ctz_32's table: intact on a view agreeing at their bytes
theorem mp.classes_tr(c, M, M2): c in mallocng.Cfg -> mallocng.classes_ok(c, M) ->
  (all a. a in omega -> int_le(c.sct, a) -> int_lt(a, int_add(c.sct, 96)) -> M2[a] = M[a]) -> mallocng.classes_ok(c, M2)
proof
  assume hc hcl ag
  have k1 k2 k3 := expand(hcl, mallocng.classes_ok)
  have so: c.sct in omega by simp(hc)
  have v2: all x0. x0 in omega -> int_lt(x0, 48) -> mallocng.rd(M2, int_add(c.sct, int_mul(2, x0)), 2) = mallocng.size_classes[x0] proof
    fix i
    assume hi hil
    have ai: all j. j in omega -> int_lt(j, 2) -> M2[int_add(int_add(c.sct, int_mul(2, i)), j)] = M[int_add(int_add(c.sct, int_mul(2, i)), j)] proof
      fix j
      assume hj hjl
      show := mp(all_elim(ag, {int_add(int_add(c.sct, int_mul(2, i)), j)}), simp(so, hi, hj), arith(so, hi, hj), arith(so, hi, hil, hj, hjl))
    qed
    show := trans(apply(mp.agree_rd, simp(), ai), mp(all_elim(k1, {i}), hi, hil))
  qed
  have p2: all x0. x0 in omega -> int_le(c.sct, x0) && int_lt(x0, int_add(c.sct, int_mul(2, 48))) ->
      (mallocng.m_mapped(M2, x0) && snd(mallocng.pg(M2, x0)).prot.r) && !(snd(mallocng.pg(M2, x0)).kind = 2) proof
    fix a
    assume ha hr
    have r1 r2 := hr
    have {ep = page} := apply(mp.agree_b8, mp(all_elim(ag, {a}), ha, r1, arith(r2)))
    have o := mp(all_elim(k2, {a}), ha, hr)
    show by defs(rewrite(sym(ep), expand(o, mallocng.m_mapped)), mallocng.m_mapped)
  qed
  show by defs(taut(v2, p2, k3), mallocng.classes_ok)
qed

theorem mp.debruijn_tr(c, M, M2): c in mallocng.Cfg -> mallocng.debruijn_ok(c, M) ->
  (all a. a in omega -> int_le(c.dbj, a) -> int_lt(a, int_add(c.dbj, 32)) -> M2[a] = M[a]) -> mallocng.debruijn_ok(c, M2)
proof
  assume hc hd ag
  have k1 k2 k3 := expand(hd, mallocng.debruijn_ok)
  have so: c.dbj in omega by simp(hc)
  have v2: all x0. x0 in omega -> int_lt(x0, 32) -> mallocng.rd(M2, int_add(c.dbj, x0), 1) = mallocng.debruijn32_tab[x0] proof
    fix i
    assume hi hil
    have ai: all j. j in omega -> int_lt(j, 1) -> M2[int_add(int_add(c.dbj, i), j)] = M[int_add(int_add(c.dbj, i), j)] proof
      fix j
      assume hj hjl
      show := mp(all_elim(ag, {int_add(int_add(c.dbj, i), j)}), simp(so, hi, hj), arith(so, hi, hj), arith(so, hi, hil, hj, hjl))
    qed
    show := trans(apply(mp.agree_rd, simp(), ai), mp(all_elim(k1, {i}), hi, hil))
  qed
  have p2: all x0. x0 in omega -> int_le(c.dbj, x0) && int_lt(x0, int_add(c.dbj, 32)) ->
      (mallocng.m_mapped(M2, x0) && snd(mallocng.pg(M2, x0)).prot.r) && !(snd(mallocng.pg(M2, x0)).kind = 2) proof
    fix a
    assume ha hr
    have r1 r2 := hr
    have {ep = page} := apply(mp.agree_b8, mp(all_elim(ag, {a}), ha, r1, r2))
    have o := mp(all_elim(k2, {a}), ha, hr)
    show by defs(rewrite(sym(ep), expand(o, mallocng.m_mapped)), mallocng.m_mapped)
  qed
  show by defs(taut(v2, p2, k3), mallocng.debruijn_ok)
qed

// The invariant for A2 on M2: the groups of A2 A's, the view as before at
// their bytes and their metas' records -- the groups' clauses kept (`used`,
// `active`, `partial`, `reuse`, `in_slots`, `wf`) --, the others given
theorem mp.holds_supply(c, A, A2, M, M2, b, brk, brk2): A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) -> mallocng.holds(c, A, M, b, brk) ->
  A2.metas = A.metas -> A2.slots = A.slots -> A2.used = A.used -> A2.active = A.active ->
  (all a. a in omega -> mp.ingrp(A, a) -> M2[a] = M[a]) ->
  (all g. all a. mallocng.is_used(A, g) -> a in omega -> int_le(g, a) -> int_lt(a, int_add(g, 40)) -> M2[a] = M[a]) ->
  mallocng.image_ok(c, M2) -> mallocng.ctx_ok(c, A2, M2) -> mallocng.fresh_ok(c, A2, M2) -> mallocng.areas_ok(c, A2, M2) ->
  mallocng.metas_partition(A2) -> mallocng.normal(A2) -> mallocng.brk_ok(A2, brk2) -> mallocng.perms_ok(c, A2, M2, b) ->
  mallocng.separate(mallocng.regions(c, A2)) -> mallocng.classes_ok(c, M2) -> mallocng.debruijn_ok(c, M2) ->
  mallocng.fixed_free(c, A2, b) -> mallocng.groups_apart(c, A2) ->
  mallocng.holds(c, A2, M2, b, brk2)
proof
  assume ha hb H em es eu ea gbs rcs img cok fr ar pt nm bk pm sp cl db ff ga
  have {huo = used, hac = active, hpa = partial, hre = reuse, hbl = in_slots, hwf = wf} := expand(H, mallocng.holds)
  have u2 := apply(mp.used_tr[A := A, A2 := A2, M := M, M2 := M2, b := b], ha, hb, em, es, eu, ea, huo, gbs, rcs)
  have p2 := apply(mp.partial_tr[A := A, A2 := A2, M := M, M2 := M2, b := b], ha, em, ea, hac, huo, hpa, gbs)
  have a2: mallocng.active_ok(A2) by defs(rewrite(sym(ea), rewrite(sym(eu), rewrite(sym(em), expand(hac, mallocng.active_ok, mallocng.is_used)))),
    mallocng.active_ok, mallocng.is_used)
  have r2: mallocng.reuse_ok(A2) by defs(rewrite(sym(ea), rewrite(sym(es), rewrite(sym(em), expand(hre, mallocng.reuse_ok, mallocng.has_unused, mallocng.own_mapping)))),
    mallocng.reuse_ok, mallocng.has_unused, mallocng.own_mapping)
  have b2: mallocng.blocks_ok(A2, b) by defs(rewrite(sym(es), rewrite(sym(eu), expand(hbl, mallocng.blocks_ok))), mallocng.blocks_ok)
  show by defs(taut(img, cok, fr, ar, pt, u2, a2, p2, r2, b2, nm, bk, pm, sp, hwf, cl, db, ff, ga), mallocng.holds)
qed

// ----------------------------------------------------------------------
//  A meta taken: x appended to the taken ones

// (the taken bytes: the ones before, and x's)
theorem mp.taken_snoc(A, A2, x, a): A.taken in list_type(omega) -> x in omega -> A2.taken = seq_concat(A.taken, seq_one(x)) ->
  (mallocng.in_taken(A2, a) <-> mallocng.in_taken(A, a) || (int_le(x, a) && int_lt(a, int_add(x, mallocng.META_SIZE))))
proof
  assume tl xo e
  let T := A.taken
  let n := seq_len(T)
  have no: n in omega by arith(tl)
  have xl := mp(all_elim(tr.seq_one_type, {x}, {omega}), xo)
  have l2: seq_len(A2.taken) = int_add(n, 1) := rewrite(sym(e), (seq_len(seq_concat(T, seq_one(x))) = int_add(n, 1) by arith(tl, xl)))
  have d1: mallocng.in_taken(A2, a) -> mallocng.in_taken(A, a) || (int_le(x, a) && int_lt(a, int_add(x, mallocng.META_SIZE))) proof
    assume h
    obtain k, hk hkl h1 h2 from expand(h, mallocng.in_taken)
    have c1: int_lt(k, n) -> mallocng.in_taken(A, a) proof
      assume hl
      have q := rewrite(sym(e), at({seq_concat(T, seq_one(x))[k]}, tl, xl, hk, hl))
      have g1 := rewrite(q, h1)
      have g2 := rewrite(q, h2)
      show by defs(ex_intro({k}, taut(hk, hl, g1, g2)), mallocng.in_taken)
    qed
    have c2: !int_lt(k, n) -> int_le(x, a) && int_lt(a, int_add(x, mallocng.META_SIZE)) proof
      assume hl
      have kn: k = int_add(n, 0) by arith(hk, hl, hkl, l2, no)
      have q0 := at({seq_concat(T, seq_one(x))[int_add(n, 0)]}, tl, xl, (0 in omega by simp()), (int_lt(0, seq_len(seq_one(x))) by simp()))
      have q1 := rewrite(sym(e), q0)
      have q := rewrite(sym(kn), q1)
      show by taut(rewrite(q, h1), rewrite(q, h2))
    qed
    show by taut(c1, c2)
  qed
  have d2: mallocng.in_taken(A, a) || (int_le(x, a) && int_lt(a, int_add(x, mallocng.META_SIZE))) -> mallocng.in_taken(A2, a) proof
    assume h
    have c1: mallocng.in_taken(A, a) -> mallocng.in_taken(A2, a) proof
      assume ht
      obtain k, hk hkl h1 h2 from expand(ht, mallocng.in_taken)
      have q := rewrite(sym(e), at({seq_concat(T, seq_one(x))[k]}, tl, xl, hk, hkl))
      have kl2: int_lt(k, seq_len(A2.taken)) by arith(hkl, l2)
      show by defs(ex_intro({k}, taut(hk, kl2, rewrite(sym(q), h1), rewrite(sym(q), h2))), mallocng.in_taken)
    qed
    have c2: int_le(x, a) && int_lt(a, int_add(x, mallocng.META_SIZE)) -> mallocng.in_taken(A2, a) proof
      assume hr
      have r1 r2 := hr
      have q0 := at({seq_concat(T, seq_one(x))[int_add(n, 0)]}, tl, xl, (0 in omega by simp()), (int_lt(0, seq_len(seq_one(x))) by simp()))
      have q := rewrite(sym(e), q0)
      have nn: int_add(n, 0) in omega by arith(no)
      have nl: int_lt(int_add(n, 0), seq_len(A2.taken)) by arith(l2, no)
      show by defs(ex_intro({int_add(n, 0)}, taut(nn, nl, rewrite(sym(q), r1), rewrite(sym(q), r2))), mallocng.in_taken)
    qed
    show by taut(h, c1, c2)
  qed
  show by taut(d1, d2)
qed

// a meta x taken: from the free ones (F the rest) or the area's available
// ones (n left), the supply's other parts as before
abbrev mp.take(A, F, n, x) := fn_update(fn_update(fn_update(A, "free_metas", F), "avail_cnt", n), "taken", seq_concat(A.taken, seq_one(x)))

theorem mp.take_type(A, F, n, x): A in mallocng.Abs -> F in list_type(omega) -> n in omega -> x in omega ->
  abs: mp.take(A, F, n, x) in mallocng.Abs && univ: mp.take(A, F, n, x) in univ(1)
proof
  assume ha hf hn hx
  let K := insert("secret", insert("init_done", insert("auxv_at", insert("auxv", insert("areas", insert("avail_cnt", insert("reserve", insert("reserve_cnt", insert("free_metas", insert("used", insert("metas", insert("active", insert("slots", insert("brk", insert("taken", empty)))))))))))))))
  let T := seq_concat(A.taken, seq_one(x))
  let A1 := fn_update(A, "free_metas", F)
  let A2 := fn_update(A1, "avail_cnt", n)
  have ap af ad := (A in powerset(cart(K, univ(1))) && is_fun(A) && dom(A) = K by simp(expand(ha, mallocng.Abs)))
  have tl: A.taken in list_type(omega) by simp(ha)
  have xl := mp(all_elim(tr.seq_one_type, {x}, {omega}), hx)
  have tt := mp(all_elim(tr.concat_list, {A.taken}, {seq_one(x)}, {omega}), tl, xl)
  have lu := apply(mp.list_univ, omega_univ)
  have fu: F in univ(1) := mp(mp(univ_trans[u := 1, a := F, b := list_type(omega)], lu), hf)
  have nu: n in univ(1) := mp(mp(univ_trans[u := 1, a := n, b := omega], omega_univ), hn)
  have tu: T in univ(1) := mp(mp(univ_trans[u := 1, a := T, b := list_type(omega)], lu), tt)
  have p1 := apply(mp.pow_upd[K := K, B := univ(1), r := A, k := "free_metas", v := F], ap, simp(), fu)
  have f1 d1 := mp(fn_update_fd[f := A, k := "free_metas", v := F, d := K], af, ad, simp())
  have p2 := apply(mp.pow_upd[K := K, B := univ(1), r := A1, k := "avail_cnt", v := n], p1, simp(), nu)
  have f2 d2 := mp(fn_update_fd[f := A1, k := "avail_cnt", v := n, d := K], f1, d1, simp())
  have p3 := apply(mp.pow_upd[K := K, B := univ(1), r := A2, k := "taken", v := T], p2, simp(), tu)
  have f3 d3 := mp(fn_update_fd[f := A2, k := "taken", v := T, d := K], f2, d2, simp())
  have au := mp(rec_univ[u := 1, k := K, r := A], simp(x86.insert_univ), ap, af, ad)
  have a3: mp.take(A, F, n, x) in mallocng.Abs by defs(simp(p3, f3, d3, hf, hn, tt, fu, nu, tu, au, expand(ha, mallocng.Abs)), mallocng.Abs)
  have u3 := mp(rec_univ[u := 1, k := K, r := mp.take(A, F, n, x)], simp(x86.insert_univ), p3, f3, d3)
  show by taut(a3, u3)
qed

// (the reserved bytes: read off the groups)
theorem mp.inres_fields(A, A2, a): A2.metas = A.metas -> A2.slots = A.slots -> A2.used = A.used ->
  (mallocng.in_reserved(A2, a) <-> mallocng.in_reserved(A, a))
proof
  assume em es eu
  have d1: mallocng.in_reserved(A2, a) -> mallocng.in_reserved(A, a) proof
    assume h
    show by defs(rewrite(es, rewrite(em, rewrite(eu, expand(h, mallocng.in_reserved, mallocng.is_used)))), mallocng.in_reserved, mallocng.is_used)
  qed
  have d2: mallocng.in_reserved(A, a) -> mallocng.in_reserved(A2, a) proof
    assume h
    show by defs(rewrite(sym(es), rewrite(sym(em), rewrite(sym(eu), expand(h, mallocng.in_reserved, mallocng.is_used)))), mallocng.in_reserved, mallocng.is_used)
  qed
  show by taut(d1, d2)
qed

// (a byte of the same ranges, reserved and taken in both states or
// neither: held in both or neither)
theorem mp.held_same(c, A, A2, b, a): mallocng.fp_ranges(c, A2) = mallocng.fp_ranges(c, A) ->
  (mallocng.in_reserved(A2, a) <-> mallocng.in_reserved(A, a)) -> (mallocng.in_taken(A2, a) <-> mallocng.in_taken(A, a)) ->
  (a in mallocng.held(c, A2, b) <-> a in mallocng.held(c, A, b))
proof
  assume fpr re te
  have f1 := set_select_def[s := omega, p := y. y in mallocng.fp_set(mallocng.fp_ranges(c, A), b) && !mallocng.in_reserved(A, y) && !mallocng.in_taken(A, y), z := a]
  have f2 := set_select_def[s := omega, p := y. y in mallocng.fp_set(mallocng.fp_ranges(c, A2), b) && !mallocng.in_reserved(A2, y) && !mallocng.in_taken(A2, y), z := a]
  have fs := subst({y. (a in mallocng.fp_set(mallocng.fp_ranges(c, A2), b)) <-> (a in mallocng.fp_set(y, b))}, fpr,
    ((a in mallocng.fp_set(mallocng.fp_ranges(c, A2), b)) <-> (a in mallocng.fp_set(mallocng.fp_ranges(c, A2), b)) by taut()))
  have fpe: a in mallocng.footprint(c, A2, b) <-> a in mallocng.footprint(c, A, b) by defs(taut(f1, f2, fs, re, te), mallocng.footprint)
  have h1 := set_select_def[s := omega, p := y. y in mallocng.footprint(c, A, b) && !mallocng.ctx_free(c, y), z := a]
  have h2 := set_select_def[s := omega, p := y. y in mallocng.footprint(c, A2, b) && !mallocng.ctx_free(c, y), z := a]
  show by defs(taut(h1, h2, fpe), mallocng.held)
qed

// (two views of two memories: equal at a byte of the same membership, value and page)
theorem mp.view_tr(vm, V2, F, F2, a): a in omega -> (a in F2 <-> a in F) ->
  V2.bytes[bits_of_int(64, a)] = vm.bytes[bits_of_int(64, a)] -> V2.pages[int_div(a, x86_64_linux.PAGE)] = vm.pages[int_div(a, x86_64_linux.PAGE)] ->
  mallocng.mview(V2, F2)[a] = mallocng.mview(vm, F)[a]
proof
  assume hao hm eb ep
  have a1 := mp(app_fn_build[d := omega, v := x. ite(x in F, some(pair(vm.bytes[bits_of_int(64, x)], vm.pages[int_div(x, x86_64_linux.PAGE)])), none), a := a], hao)
  have a2 := mp(app_fn_build[d := omega, v := x. ite(x in F2, some(pair(V2.bytes[bits_of_int(64, x)], V2.pages[int_div(x, x86_64_linux.PAGE)])), none), a := a], hao)
  have c1: a in F -> mallocng.mview(V2, F2)[a] = mallocng.mview(vm, F)[a] proof
    assume h
    have h2: a in F2 by taut(hm, h)
    show by defs(simp(a1, a2, h, h2, eb, ep), mallocng.mview)
  qed
  have c2: !(a in F) -> mallocng.mview(V2, F2)[a] = mallocng.mview(vm, F)[a] proof
    assume h
    have h2: !(a in F2) by taut(hm, h)
    show by defs(simp(a1, a2, h, h2), mallocng.mview)
  qed
  show by taut(c1, c2)
qed

// (x taken, the groups and the ranges as before: a byte outside x's record
// held after just when before -- so its view entry the same, its value and
// page the same; its page the same, its page alone)
theorem mp.take_held(c, A, A2, b, x, a): A.taken in list_type(omega) -> x in omega ->
  mallocng.fp_ranges(c, A2) = mallocng.fp_ranges(c, A) -> A2.metas = A.metas -> A2.slots = A.slots -> A2.used = A.used ->
  A2.taken = seq_concat(A.taken, seq_one(x)) -> !(int_le(x, a) && int_lt(a, int_add(x, 40))) ->
  (a in mallocng.held(c, A2, b) <-> a in mallocng.held(c, A, b))
proof
  assume tl xo fpr em es eu etk nx
  have re := apply(mp.inres_fields[A := A, A2 := A2, a := a], em, es, eu)
  have ts := apply(mp.taken_snoc[A := A, A2 := A2, x := x, a := a], tl, xo, etk)
  have cm: mallocng.META_SIZE = 40 by defs(refl({40}), mallocng.META_SIZE)
  have te: mallocng.in_taken(A2, a) <-> mallocng.in_taken(A, a) by taut(rewrite(cm, ts), nx)
  show := apply(mp.held_same[c := c, A := A, A2 := A2, b := b, a := a], fpr, re, te)
qed

theorem mp.take_agree(c, A, A2, vm, V1, b, x, a): A.taken in list_type(omega) -> x in omega -> a in omega ->
  mallocng.fp_ranges(c, A2) = mallocng.fp_ranges(c, A) -> A2.metas = A.metas -> A2.slots = A.slots -> A2.used = A.used ->
  A2.taken = seq_concat(A.taken, seq_one(x)) -> !(int_le(x, a) && int_lt(a, int_add(x, 40))) ->
  V1.bytes[bits_of_int(64, a)] = vm.bytes[bits_of_int(64, a)] -> V1.pages[int_div(a, x86_64_linux.PAGE)] = vm.pages[int_div(a, x86_64_linux.PAGE)] ->
  mallocng.mview(V1, mallocng.held(c, A2, b))[a] = mallocng.mview(vm, mallocng.held(c, A, b))[a]
proof
  assume tl xo hao fpr em es eu etk nx eb ep
  have hm := apply(mp.take_held[c := c, A := A, A2 := A2, b := b, x := x, a := a], tl, xo, fpr, em, es, eu, etk, nx)
  show := apply(mp.view_tr[vm := vm, V2 := V1, F := mallocng.held(c, A, b), F2 := mallocng.held(c, A2, b), a := a], hao, hm, eb, ep)
qed

theorem mp.take_pg(c, A, A2, vm, V1, b, x, a): A.taken in list_type(omega) -> x in omega -> a in omega ->
  mallocng.fp_ranges(c, A2) = mallocng.fp_ranges(c, A) -> A2.metas = A.metas -> A2.slots = A.slots -> A2.used = A.used ->
  A2.taken = seq_concat(A.taken, seq_one(x)) -> !(int_le(x, a) && int_lt(a, int_add(x, 40))) ->
  V1.pages[int_div(a, x86_64_linux.PAGE)] = vm.pages[int_div(a, x86_64_linux.PAGE)] ->
  mallocng.pg(mallocng.mview(V1, mallocng.held(c, A2, b)), a) = mallocng.pg(mallocng.mview(vm, mallocng.held(c, A, b)), a)
proof
  assume tl xo hao fpr em es eu etk nx ep
  have hm := apply(mp.take_held[c := c, A := A, A2 := A2, b := b, x := x, a := a], tl, xo, fpr, em, es, eu, etk, nx)
  have a1 := mp(app_fn_build[d := omega, v := y. ite(y in mallocng.held(c, A, b), some(pair(vm.bytes[bits_of_int(64, y)], vm.pages[int_div(y, x86_64_linux.PAGE)])), none), a := a], hao)
  have a2 := mp(app_fn_build[d := omega, v := y. ite(y in mallocng.held(c, A2, b), some(pair(V1.bytes[bits_of_int(64, y)], V1.pages[int_div(y, x86_64_linux.PAGE)])), none), a := a], hao)
  have c1: a in mallocng.held(c, A, b) -> mallocng.pg(mallocng.mview(V1, mallocng.held(c, A2, b)), a) = mallocng.pg(mallocng.mview(vm, mallocng.held(c, A, b)), a) proof
    assume h
    have h2: a in mallocng.held(c, A2, b) by taut(hm, h)
    show by defs(simp(a1, a2, h, h2, ep), mallocng.pg, mallocng.mview)
  qed
  have c2: !(a in mallocng.held(c, A, b)) -> mallocng.pg(mallocng.mview(V1, mallocng.held(c, A2, b)), a) = mallocng.pg(mallocng.mview(vm, mallocng.held(c, A, b)), a) proof
    assume h
    have h2: !(a in mallocng.held(c, A2, b)) by taut(hm, h)
    show by defs(simp(a1, a2, h, h2), mallocng.pg, mallocng.mview)
  qed
  show by taut(c1, c2)
qed

// (x taken, the memory written at w .. w+n-1 only, its pages as before: a
// byte outside both, the same in the invariant's view after)
theorem mp.take_view(c, A, A2, vm, V1, b, x, w, n, a): mallocng.holds_in(c, A, vm, b) -> A.taken in list_type(omega) -> x in omega ->
  mallocng.fp_ranges(c, A2) = mallocng.fp_ranges(c, A) -> A2.metas = A.metas -> A2.slots = A.slots -> A2.used = A.used ->
  A2.taken = seq_concat(A.taken, seq_one(x)) ->
  (all y. y in bits(64) -> !(int_le(w, y) && int_lt(y, int_add(w, n))) -> V1.bytes[y] = vm.bytes[y]) -> V1.pages = vm.pages ->
  a in omega -> !(int_le(w, a) && int_lt(a, int_add(w, n))) -> !(int_le(x, a) && int_lt(a, int_add(x, 40))) ->
  mallocng.mview(V1, mallocng.held(c, A2, b))[a] = mallocng.mview(vm, mallocng.held(c, A, b))[a]
proof
  assume hh tl xo fpr em es eu etk hby ep hao nw nx
  have {hm = mapped} := expand(hh, mallocng.holds_in)
  have hs := apply(mp.take_held[c := c, A := A, A2 := A2, b := b, x := x, a := a], tl, xo, fpr, em, es, eu, etk, nx)
  have e1 := apply(mp.view_mem[vm := V1, F1 := mallocng.held(c, A2, b), F2 := mallocng.held(c, A, b), a := a], hao, hs)
  have bt: a in mallocng.held(c, A, b) -> V1.bytes[bits_of_int(64, a)] = vm.bytes[bits_of_int(64, a)] proof
    assume hf
    have {hff = fp} := apply(mp.held_fp, hf)
    have lo := apply(mp.fp_low[c := c, A := A, vm := vm, b := b, a := a], hm, hff)
    have e: bits_of_int(64, a) = a by defs(arith(hao, lo), bits_of_int, pow2)
    have ab: a in bits(64) by arith(hao, lo)
    show := rewrite(sym(e), mp(all_elim(hby, {a}), ab, nw))
  qed
  have e2 := apply(mp.view_agree[vm := vm, vm2 := V1, fp := mallocng.held(c, A, b), a := a], hao, bt, ep)
  show := trans(e1, e2)
qed

// (one fewer available: the ones before but the first of them, x)
theorem mp.avail_dec(A, A2, x, g): A in mallocng.Abs -> int_lt(0, A.avail_cnt) -> int_le(A.avail_cnt, mallocng.NSLOTS) ->
  A2.areas = A.areas -> A2.avail_cnt = int_sub(A.avail_cnt, 1) ->
  x = mallocng.meta_at(A.areas[int_sub(seq_len(A.areas), 1)], int_sub(mallocng.NSLOTS, A.avail_cnt)) ->
  (mallocng.avail_meta(A2, g) <-> mallocng.avail_meta(A, g) && !(g = x))
proof
  assume ha hk hkn ear eac ex
  let L := A.areas[int_sub(seq_len(A.areas), 1)]
  have ko: A.avail_cnt in omega by simp(ha)
  have cs: mallocng.AREA_HDR = 24 && mallocng.META_SIZE = 40 && mallocng.NSLOTS = 101 by defs(simp(), mallocng.AREA_HDR, mallocng.META_SIZE, mallocng.NSLOTS)
  have _ _ c101 := cs
  have xe: x = int_add(int_add(L, 24), int_mul(40, int_sub(101, A.avail_cnt))) by simp(expand(ex, mallocng.meta_at), cs)
  have d1: mallocng.avail_meta(A2, g) -> mallocng.avail_meta(A, g) && !(g = x) proof
    assume h
    have hl ej := expand(h, mallocng.avail_meta)
    obtain j, hj hj1 hj2 hge from ej
    have hl1 := rewrite(ear, hl)
    have hj1a: int_le(int_sub(mallocng.NSLOTS, int_sub(A.avail_cnt, 1)), j) := rewrite(eac, hj1)
    have ge: g = mallocng.meta_at(L, j) := rewrite(ear, hge)
    have hj1n := rewrite(c101, hj1a)
    have j1n: int_le(int_sub(101, A.avail_cnt), j) by arith(hj1n, ko, hk, hj)
    have j1 := rewrite(sym(c101), j1n)
    have e1: ex x0. x0 in omega && ((int_le(int_sub(mallocng.NSLOTS, A.avail_cnt), x0) && int_lt(x0, mallocng.NSLOTS)) && g = mallocng.meta_at(L, x0))
      by ex_intro({j}, taut(hj, j1, hj2, ge))
    have a1: mallocng.avail_meta(A, g) by defs(taut(hl1, e1), mallocng.avail_meta)
    have gj: g = int_add(int_add(L, 24), int_mul(40, j)) by simp(expand(ge, mallocng.meta_at), cs)
    have ne: !(g = x) by arith(gj, xe, hj1n, ko, hk, hj)
    show by taut(a1, ne)
  qed
  have d2: mallocng.avail_meta(A, g) && !(g = x) -> mallocng.avail_meta(A2, g) proof
    assume h
    have h1 ne := h
    have hl ej := expand(h1, mallocng.avail_meta)
    obtain j, hj hj1 hj2 hge from ej
    have gj: g = int_add(int_add(L, 24), int_mul(40, j)) by simp(expand(hge, mallocng.meta_at), cs)
    have jn: !(j = int_sub(101, A.avail_cnt)) proof
      assume e
      have f: g = x by arith(gj, xe, e)
      show by taut(f, ne)
    qed
    have j2n: int_le(int_sub(101, A2.avail_cnt), j) by arith(rewrite(c101, hj1), jn, eac, ko, hk, hj)
    have j2 := rewrite(sym(c101), j2n)
    have hl2 := rewrite(sym(ear), hl)
    have ge2: g = mallocng.meta_at(A2.areas[int_sub(seq_len(A2.areas), 1)], j) := rewrite(sym(ear), hge)
    have e2: ex x0. x0 in omega && ((int_le(int_sub(mallocng.NSLOTS, A2.avail_cnt), x0) && int_lt(x0, mallocng.NSLOTS)) &&
        g = mallocng.meta_at(A2.areas[int_sub(seq_len(A2.areas), 1)], x0))
      by ex_intro({j}, taut(hj, j2, hj2, ge2))
    show by defs(taut(hl2, e2), mallocng.avail_meta)
  qed
  show by taut(d1, d2)
qed

// the metas' partition, the area's first available meta x taken
theorem mp.part_avail(A, A2, x): A in mallocng.Abs -> mallocng.metas_partition(A) -> int_lt(0, A.avail_cnt) -> int_le(A.avail_cnt, mallocng.NSLOTS) ->
  ord_lt(0, seq_len(A.areas)) -> A2.used = A.used -> A2.areas = A.areas -> A2.free_metas = A.free_metas -> A2.avail_cnt = int_sub(A.avail_cnt, 1) ->
  A2.taken = seq_concat(A.taken, seq_one(x)) -> x = mallocng.meta_at(A.areas[int_sub(seq_len(A.areas), 1)], int_sub(mallocng.NSLOTS, A.avail_cnt)) ->
  mallocng.metas_partition(A2)
proof
  assume ha hp hk hkn hn eu ear efr eac etk ex
  have {so = sorted, us = used_slots, fs = free_slots, cv = cover, tk = taken, fr = fresh} := expand(hp, mallocng.metas_partition)
  let L := A.areas[int_sub(seq_len(A.areas), 1)]
  let T := A.taken
  let n := seq_len(T)
  have cs: mallocng.AREA_HDR = 24 && mallocng.META_SIZE = 40 && mallocng.NSLOTS = 101 by defs(simp(), mallocng.AREA_HDR, mallocng.META_SIZE, mallocng.NSLOTS)
  have _ _ c101 := cs
  have ko: A.avail_cnt in omega by simp(ha)
  have al: A.areas in list_type(omega) by simp(ha)
  have tl: T in list_type(omega) by simp(ha)
  have no: n in omega by arith(tl)
  have lno: seq_len(A.areas) in omega by arith(al)
  have hni := mp(nat_mem_lt[k := seq_len(A.areas), i := 0], lno, expand(hn, ord_lt))
  have lo: int_sub(seq_len(A.areas), 1) in omega by arith(al, hni)
  have lol: int_lt(int_sub(seq_len(A.areas), 1), seq_len(A.areas)) by arith(al, hni)
  have Lo := apply(at_type[l := A.areas, t := omega, i := int_sub(seq_len(A.areas), 1)], al, lo, lol)
  have j0o: int_sub(mallocng.NSLOTS, A.avail_cnt) in omega := rewrite(sym(c101), (int_sub(101, A.avail_cnt) in omega by arith(ko, rewrite(c101, hkn))))
  have j0l: int_lt(int_sub(mallocng.NSLOTS, A.avail_cnt), mallocng.NSLOTS) := rewrite(sym(c101), (int_lt(int_sub(101, A.avail_cnt), 101) by arith(ko, hk)))
  have xe: x = int_add(int_add(L, 24), int_mul(40, int_sub(101, A.avail_cnt))) by simp(expand(ex, mallocng.meta_at), cs)
  have xo: x in omega by arith(xe, Lo, ko, rewrite(c101, hkn))
  // the state's parts: as A's, the available ones but x
  have ms: all g. mallocng.meta_slot(A2, g) <-> mallocng.meta_slot(A, g) proof
    fix g
    show by defs(simp(ear), mallocng.meta_slot)
  qed
  have iu: all g. mallocng.is_used(A2, g) <-> mallocng.is_used(A, g) proof
    fix g
    show by defs(simp(eu), mallocng.is_used)
  qed
  have av: all g. mallocng.avail_meta(A2, g) <-> mallocng.avail_meta(A, g) && !(g = x) proof
    fix g
    show := apply(mp.avail_dec[A := A, A2 := A2, x := x, g := g], ha, hk, hkn, ear, eac, ex)
  qed
  // x: a meta slot, available, not in use, free or taken
  have xs: mallocng.meta_slot(A, x) by defs(ex_intro({int_sub(seq_len(A.areas), 1)}, {int_sub(mallocng.NSLOTS, A.avail_cnt)}, taut(lo, j0o, lol, j0l, ex)), mallocng.meta_slot)
  have xe1: ex x0. x0 in omega && ((int_le(int_sub(mallocng.NSLOTS, A.avail_cnt), x0) && int_lt(x0, mallocng.NSLOTS)) && x = mallocng.meta_at(L, x0))
    by ex_intro({int_sub(mallocng.NSLOTS, A.avail_cnt)}, taut(j0o, (int_le(int_sub(mallocng.NSLOTS, A.avail_cnt), int_sub(mallocng.NSLOTS, A.avail_cnt)) by arith(j0o)), j0l, ex))
  have xa: mallocng.avail_meta(A, x) by defs(taut(hn, xe1), mallocng.avail_meta)
  have xnu xnf := mp(all_elim(fr, {int_sub(mallocng.NSLOTS, A.avail_cnt)}), j0o, taut(hn, (int_le(int_sub(mallocng.NSLOTS, A.avail_cnt), int_sub(mallocng.NSLOTS, A.avail_cnt)) by arith(j0o)), j0l))
  have xnu2 := rewrite(sym(ex), xnu)
  have xnt: all i. i in omega -> int_lt(i, n) -> !(T[i] = x) proof
    fix i
    assume hi hil
    have _ _ na _ _ := mp(all_elim(tk, {i}), hi, hil)
    assume e
    show by taut(na, rewrite(sym(e), xa))
  qed
  // A2's taken ones: A's, then x
  have xl := mp(all_elim(tr.seq_one_type, {x}, {omega}), xo)
  have l2: seq_len(A2.taken) = int_add(n, 1) := rewrite(sym(etk), (seq_len(seq_concat(T, seq_one(x))) = int_add(n, 1) by arith(tl, xl)))
  have old: all i. i in omega -> int_lt(i, n) -> A2.taken[i] = T[i] proof
    fix i
    assume hi hil
    show := rewrite(sym(etk), at({seq_concat(T, seq_one(x))[i]}, tl, xl, hi, hil))
  qed
  have new: A2.taken[n] = x := rewrite((int_add(n, 0) = n by arith(no)), rewrite(sym(etk),
    at({seq_concat(T, seq_one(x))[int_add(n, 0)]}, tl, xl, (0 in omega by simp()), (int_lt(0, seq_len(seq_one(x))) by simp()))))
  // the clauses
  have c1 := rewrite(sym(eu), so)
  have c2: all x0. x0 in omega -> int_lt(x0, seq_len(A2.used)) -> mallocng.meta_slot(A2, A2.used[x0]) proof
    fix k
    assume hk0 hkl
    have m := mp(all_elim(us, {k}), hk0, rewrite(eu, hkl))
    have m2: mallocng.meta_slot(A2, A.used[k]) by taut(m, all_elim(ms, {A.used[k]}))
    show := rewrite(sym(eu), m2)
  qed
  have c3: all x0. x0 in omega -> int_lt(x0, seq_len(A2.free_metas)) -> mallocng.meta_slot(A2, A2.free_metas[x0]) && !mallocng.is_used(A2, A2.free_metas[x0]) proof
    fix k
    assume hk0 hkl
    have m nu := mp(all_elim(fs, {k}), hk0, rewrite(efr, hkl))
    have q := rewrite(sym(efr), conj(m, nu))
    show by taut(q, all_elim(ms, {A2.free_metas[k]}), all_elim(iu, {A2.free_metas[k]}))
  qed
  have c4: all x0. all x1. x0 in omega && x1 in omega -> int_lt(x0, seq_len(A2.areas)) && int_lt(x1, mallocng.NSLOTS) ->
      ((mallocng.is_used(A2, mallocng.meta_at(A2.areas[x0], x1)) || (ex x2. x2 in omega && (int_lt(x2, seq_len(A2.free_metas)) && A2.free_metas[x2] = mallocng.meta_at(A2.areas[x0], x1)))) ||
        mallocng.avail_meta(A2, mallocng.meta_at(A2.areas[x0], x1))) ||
      (ex x2. x2 in omega && (int_lt(x2, seq_len(A2.taken)) && A2.taken[x2] = mallocng.meta_at(A2.areas[x0], x1))) proof
    fix k j
    assume hkj hl
    have hl1 hl2 := hl
    let G := mallocng.meta_at(A.areas[k], j)
    have ge: mallocng.meta_at(A2.areas[k], j) = G by simp(ear)
    have w := mp(all_elim(cv, {k}, {j}), hkj, conj(rewrite(ear, hl1), hl2))
    have u1: mallocng.is_used(A, G) -> mallocng.is_used(A2, G) by taut(all_elim(iu, {G}))
    have f1: (ex x2. x2 in omega && (int_lt(x2, seq_len(A.free_metas)) && A.free_metas[x2] = G)) ->
        (ex x2. x2 in omega && (int_lt(x2, seq_len(A2.free_metas)) && A2.free_metas[x2] = G)) by simp(efr)
    have a1: mallocng.avail_meta(A, G) -> mallocng.avail_meta(A2, G) || (ex x2. x2 in omega && (int_lt(x2, seq_len(A2.taken)) && A2.taken[x2] = G)) proof
      assume h
      have cx: G = x -> (ex x2. x2 in omega && (int_lt(x2, seq_len(A2.taken)) && A2.taken[x2] = G)) proof
        assume e
        show by ex_intro({n}, taut(no, (int_lt(n, seq_len(A2.taken)) by arith(l2, no)), trans(new, sym(e))))
      qed
      have co: !(G = x) -> mallocng.avail_meta(A2, G) by taut(h, all_elim(av, {G}))
      show by taut(cx, co)
    qed
    have t1: (ex x2. x2 in omega && (int_lt(x2, seq_len(A.taken)) && A.taken[x2] = G)) -> (ex x2. x2 in omega && (int_lt(x2, seq_len(A2.taken)) && A2.taken[x2] = G)) proof
      assume h
      obtain i, hi hil he from h
      show by ex_intro({i}, taut(hi, (int_lt(i, seq_len(A2.taken)) by arith(hil, l2)), trans(mp(all_elim(old, {i}), hi, hil), he)))
    qed
    have r: ((mallocng.is_used(A2, G) || (ex x2. x2 in omega && (int_lt(x2, seq_len(A2.free_metas)) && A2.free_metas[x2] = G))) || mallocng.avail_meta(A2, G)) ||
        (ex x2. x2 in omega && (int_lt(x2, seq_len(A2.taken)) && A2.taken[x2] = G)) by taut(w, u1, f1, a1, t1)
    show := rewrite(sym(ge), r)
  qed
  have c5: all x0. x0 in omega -> int_lt(x0, seq_len(A2.taken)) -> (((mallocng.meta_slot(A2, A2.taken[x0]) && !mallocng.is_used(A2, A2.taken[x0])) &&
      !mallocng.avail_meta(A2, A2.taken[x0])) && (all x1. x1 in omega -> int_lt(x1, seq_len(A2.free_metas)) -> !(A2.free_metas[x1] = A2.taken[x0]))) &&
      (all x1. x1 in omega -> int_lt(x1, seq_len(A2.taken)) && A2.taken[x1] = A2.taken[x0] -> x1 = x0) proof
    fix i
    assume hi hil
    // (another taken one: one of A's, or x)
    have which: all i2. i2 in omega -> int_lt(i2, seq_len(A2.taken)) -> (int_lt(i2, n) && A2.taken[i2] = T[i2]) || (i2 = n && A2.taken[i2] = x) proof
      fix i2
      assume hi2 hi2l
      have co: int_lt(i2, n) -> int_lt(i2, n) && A2.taken[i2] = T[i2] proof
        assume h
        show by taut(h, mp(all_elim(old, {i2}), hi2, h))
      qed
      have cn: !int_lt(i2, n) -> i2 = n && A2.taken[i2] = x proof
        assume h
        have e: i2 = n by arith(hi2l, l2, h, hi2, no)
        show by taut(e, subst({y. A2.taken[y] = x}, sym(e), new))
      qed
      show by taut(co, cn)
    qed
    have wi := mp(all_elim(which, {i}), hi, hil)
    have cold: int_lt(i, n) && A2.taken[i] = T[i] -> (((mallocng.meta_slot(A2, A2.taken[i]) && !mallocng.is_used(A2, A2.taken[i])) &&
        !mallocng.avail_meta(A2, A2.taken[i])) && (all x1. x1 in omega -> int_lt(x1, seq_len(A2.free_metas)) -> !(A2.free_metas[x1] = A2.taken[i]))) &&
        (all x1. x1 in omega -> int_lt(x1, seq_len(A2.taken)) && A2.taken[x1] = A2.taken[i] -> x1 = i) proof
      assume h
      have hn1 he := h
      have m nu na nf dd := mp(all_elim(tk, {i}), hi, hn1)
      have nf2: all x1. x1 in omega -> int_lt(x1, seq_len(A2.free_metas)) -> !(A2.free_metas[x1] = T[i]) proof
        fix k
        assume hk0 hkl
        show := rewrite(sym(efr), mp(all_elim(nf, {k}), hk0, rewrite(efr, hkl)))
      qed
      have dd2: all x1. x1 in omega -> int_lt(x1, seq_len(A2.taken)) && A2.taken[x1] = T[i] -> x1 = i proof
        fix i2
        assume hi2 h2
        have h21 h22 := h2
        have w2 := mp(all_elim(which, {i2}), hi2, h21)
        have o2: int_lt(i2, n) && A2.taken[i2] = T[i2] -> i2 = i proof
          assume h3
          have h31 h32 := h3
          show := mp(all_elim(dd, {i2}), hi2, conj(h31, trans(sym(h32), h22)))
        qed
        have n2: i2 = n && A2.taken[i2] = x -> i2 = i proof
          assume h3
          have _ h32 := h3
          have e: T[i] = x := trans(sym(h22), h32)
          show by taut(mp(all_elim(xnt, {i}), hi, hn1), e)
        qed
        show by taut(w2, o2, n2)
      qed
      have na2: !mallocng.avail_meta(A2, T[i]) by taut(na, all_elim(av, {T[i]}))
      have r: (((mallocng.meta_slot(A2, T[i]) && !mallocng.is_used(A2, T[i])) && !mallocng.avail_meta(A2, T[i])) &&
          (all x1. x1 in omega -> int_lt(x1, seq_len(A2.free_metas)) -> !(A2.free_metas[x1] = T[i]))) &&
          (all x1. x1 in omega -> int_lt(x1, seq_len(A2.taken)) && A2.taken[x1] = T[i] -> x1 = i)
        by taut(m, all_elim(ms, {T[i]}), nu, all_elim(iu, {T[i]}), na2, nf2, dd2)
      show := rewrite(sym(he), r)
    qed
    have cnew: i = n && A2.taken[i] = x -> (((mallocng.meta_slot(A2, A2.taken[i]) && !mallocng.is_used(A2, A2.taken[i])) &&
        !mallocng.avail_meta(A2, A2.taken[i])) && (all x1. x1 in omega -> int_lt(x1, seq_len(A2.free_metas)) -> !(A2.free_metas[x1] = A2.taken[i]))) &&
        (all x1. x1 in omega -> int_lt(x1, seq_len(A2.taken)) && A2.taken[x1] = A2.taken[i] -> x1 = i) proof
      assume h
      have hn1 he := h
      have nf2: all x1. x1 in omega -> int_lt(x1, seq_len(A2.free_metas)) -> !(A2.free_metas[x1] = x) proof
        fix k
        assume hk0 hkl
        show := rewrite(sym(efr), rewrite(sym(ex), mp(all_elim(xnf, {k}), hk0, rewrite(efr, hkl))))
      qed
      have dd2: all x1. x1 in omega -> int_lt(x1, seq_len(A2.taken)) && A2.taken[x1] = x -> x1 = i proof
        fix i2
        assume hi2 h2
        have h21 h22 := h2
        have w2 := mp(all_elim(which, {i2}), hi2, h21)
        have o2: int_lt(i2, n) && A2.taken[i2] = T[i2] -> i2 = i proof
          assume h3
          have h31 h32 := h3
          have e: T[i2] = x := trans(sym(h32), h22)
          have f := mp(all_elim(xnt, {i2}), hi2, h31)
          show by taut(f, e)
        qed
        have n2: i2 = n && A2.taken[i2] = x -> i2 = i proof
          assume h3
          have h31 _ := h3
          show := trans(h31, sym(hn1))
        qed
        show by taut(w2, o2, n2)
      qed
      have na2: !mallocng.avail_meta(A2, x) by taut(all_elim(av, {x}), refl({x}))
      have r: (((mallocng.meta_slot(A2, x) && !mallocng.is_used(A2, x)) && !mallocng.avail_meta(A2, x)) &&
          (all x1. x1 in omega -> int_lt(x1, seq_len(A2.free_metas)) -> !(A2.free_metas[x1] = x))) &&
          (all x1. x1 in omega -> int_lt(x1, seq_len(A2.taken)) && A2.taken[x1] = x -> x1 = i)
        by taut(xs, all_elim(ms, {x}), xnu2, all_elim(iu, {x}), na2, nf2, dd2)
      show := rewrite(sym(he), r)
    qed
    show by taut(wi, cold, cnew)
  qed
  have c6: all x0. x0 in omega -> (ord_lt(0, seq_len(A2.areas)) && int_le(int_sub(mallocng.NSLOTS, A2.avail_cnt), x0)) && int_lt(x0, mallocng.NSLOTS) ->
      !mallocng.is_used(A2, mallocng.meta_at(A2.areas[int_sub(seq_len(A2.areas), 1)], x0)) &&
      (all x1. x1 in omega -> int_lt(x1, seq_len(A2.free_metas)) -> !(A2.free_metas[x1] = mallocng.meta_at(A2.areas[int_sub(seq_len(A2.areas), 1)], x0))) proof
    fix j
    assume hj h
    have h1 h2 h3 := h
    have j1n: int_le(int_sub(101, A.avail_cnt), j) by arith(rewrite(c101, rewrite(eac, h2)), ko, hk, hj)
    have j1 := rewrite(sym(c101), j1n)
    have r1 r2 := mp(all_elim(fr, {j}), hj, taut(hn, j1, h3))
    have r2b: all x1. x1 in omega -> int_lt(x1, seq_len(A2.free_metas)) -> !(A2.free_metas[x1] = mallocng.meta_at(L, j)) proof
      fix k
      assume hk0 hkl
      show := rewrite(sym(efr), mp(all_elim(r2, {k}), hk0, rewrite(efr, hkl)))
    qed
    have r1b: !mallocng.is_used(A2, mallocng.meta_at(L, j)) by taut(r1, all_elim(iu, {mallocng.meta_at(L, j)}))
    show := rewrite(sym(ear), conj(r1b, r2b))
  qed
  show by defs(taut(c1, c2, c3, c4, c5, c6), mallocng.metas_partition)
qed

// the metas' partition, the free metas' first x taken
theorem mp.part_free(A, A2, x): A in mallocng.Abs -> mallocng.metas_partition(A) -> int_lt(0, seq_len(A.free_metas)) ->
  (all i. all j. i in omega -> j in omega -> int_lt(i, seq_len(A.free_metas)) -> int_lt(j, seq_len(A.free_metas)) -> A.free_metas[i] = A.free_metas[j] -> i = j) ->
  A2.used = A.used -> A2.areas = A.areas -> A2.free_metas = mallocng_specs.rm_at(A.free_metas, 0) -> A2.avail_cnt = A.avail_cnt ->
  A2.taken = seq_concat(A.taken, seq_one(x)) -> x = A.free_metas[0] ->
  mallocng.metas_partition(A2)
proof
  assume ha hp hn hd eu ear efr eac etk ex
  have {so = sorted, us = used_slots, fs = free_slots, cv = cover, tk = taken, fr = fresh} := expand(hp, mallocng.metas_partition)
  let F := A.free_metas
  let R := mallocng_specs.rm_at(F, 0)
  let T := A.taken
  let n := seq_len(T)
  have fl: F in list_type(omega) by simp(ha)
  have tl: T in list_type(omega) by simp(ha)
  have no: n in omega by arith(tl)
  have fo: seq_len(F) in omega by arith(fl)
  have {rl = len, rt = type} := apply(mp.rm_at_app[l := F, k := 0, j := 0], fl, simp(), hn)
  have rel: all j. j in omega -> int_lt(j, seq_len(R)) -> R[j] = F[int_add(j, 1)] proof
    fix j
    assume hj hjl
    have {re = elem} := apply(mp.rm_at_app[l := F, k := 0, j := j], fl, simp(), hn)
    have e := mp(re, hj, rewrite(rl, hjl))
    show by simp(e, hj)
  qed
  have xo: x in omega := rewrite(sym(ex), apply(at_type[l := F, t := omega, i := 0], fl, simp(), hn))
  have ms: all g. mallocng.meta_slot(A2, g) <-> mallocng.meta_slot(A, g) proof
    fix g
    show by defs(simp(ear), mallocng.meta_slot)
  qed
  have iu: all g. mallocng.is_used(A2, g) <-> mallocng.is_used(A, g) proof
    fix g
    show by defs(simp(eu), mallocng.is_used)
  qed
  have av: all g. mallocng.avail_meta(A2, g) <-> mallocng.avail_meta(A, g) proof
    fix g
    show by defs(simp(ear, eac), mallocng.avail_meta)
  qed
  // x: the first free meta -- a meta slot, not in use, not available, not taken
  have xs xnu := rewrite(sym(ex), mp(all_elim(fs, {0}), simp(), hn))
  have xna: !mallocng.avail_meta(A, x) proof
    assume h
    have hl ej := expand(h, mallocng.avail_meta)
    obtain j, hj hj1 hj2 hje from ej
    have _ nf := mp(all_elim(fr, {j}), hj, taut(hl, hj1, hj2))
    show by taut(mp(all_elim(nf, {0}), simp(), hn), trans(sym(ex), hje))
  qed
  have xnt: all i. i in omega -> int_lt(i, n) -> !(T[i] = x) proof
    fix i
    assume hi hil
    have _ _ _ nf _ := mp(all_elim(tk, {i}), hi, hil)
    assume e
    show by taut(mp(all_elim(nf, {0}), simp(), hn), trans(sym(ex), sym(e)))
  qed
  // A2's taken ones: A's, then x
  have xl := mp(all_elim(tr.seq_one_type, {x}, {omega}), xo)
  have l2: seq_len(A2.taken) = int_add(n, 1) := rewrite(sym(etk), (seq_len(seq_concat(T, seq_one(x))) = int_add(n, 1) by arith(tl, xl)))
  have old: all i. i in omega -> int_lt(i, n) -> A2.taken[i] = T[i] proof
    fix i
    assume hi hil
    show := rewrite(sym(etk), at({seq_concat(T, seq_one(x))[i]}, tl, xl, hi, hil))
  qed
  have new: A2.taken[n] = x := rewrite((int_add(n, 0) = n by arith(no)), rewrite(sym(etk),
    at({seq_concat(T, seq_one(x))[int_add(n, 0)]}, tl, xl, (0 in omega by simp()), (int_lt(0, seq_len(seq_one(x))) by simp()))))
  // the clauses
  have c1 := rewrite(sym(eu), so)
  have c2: all x0. x0 in omega -> int_lt(x0, seq_len(A2.used)) -> mallocng.meta_slot(A2, A2.used[x0]) proof
    fix k
    assume hk0 hkl
    have m := mp(all_elim(us, {k}), hk0, rewrite(eu, hkl))
    have m2: mallocng.meta_slot(A2, A.used[k]) by taut(m, all_elim(ms, {A.used[k]}))
    show := rewrite(sym(eu), m2)
  qed
  have c3: all x0. x0 in omega -> int_lt(x0, seq_len(A2.free_metas)) -> mallocng.meta_slot(A2, A2.free_metas[x0]) && !mallocng.is_used(A2, A2.free_metas[x0]) proof
    fix k
    assume hk0 hkl0
    have hkl: int_lt(k, seq_len(R)) := rewrite(efr, hkl0)
    have e := mp(all_elim(rel, {k}), hk0, hkl)
    have m nu := mp(all_elim(fs, {int_add(k, 1)}), simp(hk0), arith(hkl, rl, hk0))
    have q := rewrite(sym(e), conj(m, nu))
    have q2 := rewrite(sym(efr), q)
    show by taut(q2, all_elim(ms, {A2.free_metas[k]}), all_elim(iu, {A2.free_metas[k]}))
  qed
  have c4: all x0. all x1. x0 in omega && x1 in omega -> int_lt(x0, seq_len(A2.areas)) && int_lt(x1, mallocng.NSLOTS) ->
      ((mallocng.is_used(A2, mallocng.meta_at(A2.areas[x0], x1)) || (ex x2. x2 in omega && (int_lt(x2, seq_len(A2.free_metas)) && A2.free_metas[x2] = mallocng.meta_at(A2.areas[x0], x1)))) ||
        mallocng.avail_meta(A2, mallocng.meta_at(A2.areas[x0], x1))) ||
      (ex x2. x2 in omega && (int_lt(x2, seq_len(A2.taken)) && A2.taken[x2] = mallocng.meta_at(A2.areas[x0], x1))) proof
    fix k j
    assume hkj hl
    have hl1 hl2 := hl
    let G := mallocng.meta_at(A.areas[k], j)
    have ge: mallocng.meta_at(A2.areas[k], j) = G by simp(ear)
    have w := mp(all_elim(cv, {k}, {j}), hkj, conj(rewrite(ear, hl1), hl2))
    have u1: mallocng.is_used(A, G) -> mallocng.is_used(A2, G) by taut(all_elim(iu, {G}))
    have f1: (ex x2. x2 in omega && (int_lt(x2, seq_len(F)) && F[x2] = G)) ->
        (ex x2. x2 in omega && (int_lt(x2, seq_len(A2.free_metas)) && A2.free_metas[x2] = G)) ||
        (ex x2. x2 in omega && (int_lt(x2, seq_len(A2.taken)) && A2.taken[x2] = G)) proof
      assume h
      obtain i, hi hil he from h
      have z: i = 0 -> (ex x2. x2 in omega && (int_lt(x2, seq_len(A2.taken)) && A2.taken[x2] = G)) proof
        assume e
        have g0: x = G := trans(ex, trans(subst({y. F[0] = F[y]}, sym(e), refl({F[0]})), he))
        show by ex_intro({n}, taut(no, (int_lt(n, seq_len(A2.taken)) by arith(l2, no)), trans(new, g0)))
      qed
      have nz: !(i = 0) -> (ex x2. x2 in omega && (int_lt(x2, seq_len(A2.free_metas)) && A2.free_metas[x2] = G)) proof
        assume ne
        have i1: int_sub(i, 1) in omega by arith(hi, ne)
        have i1l: int_lt(int_sub(i, 1), seq_len(R)) by arith(hil, rl, ne, hi)
        have e := mp(all_elim(rel, {int_sub(i, 1)}), i1, i1l)
        have e2: R[int_sub(i, 1)] = G := trans(e, trans((F[int_add(int_sub(i, 1), 1)] = F[i] by simp((int_add(int_sub(i, 1), 1) = i by arith(hi, ne)))), he))
        show by ex_intro({int_sub(i, 1)}, taut(i1, rewrite(sym(efr), i1l), rewrite(sym(efr), e2)))
      qed
      show by taut(z, nz)
    qed
    have a1: mallocng.avail_meta(A, G) -> mallocng.avail_meta(A2, G) by taut(all_elim(av, {G}))
    have t1: (ex x2. x2 in omega && (int_lt(x2, seq_len(A.taken)) && A.taken[x2] = G)) -> (ex x2. x2 in omega && (int_lt(x2, seq_len(A2.taken)) && A2.taken[x2] = G)) proof
      assume h
      obtain i, hi hil he from h
      show by ex_intro({i}, taut(hi, (int_lt(i, seq_len(A2.taken)) by arith(hil, l2)), trans(mp(all_elim(old, {i}), hi, hil), he)))
    qed
    have r: ((mallocng.is_used(A2, G) || (ex x2. x2 in omega && (int_lt(x2, seq_len(A2.free_metas)) && A2.free_metas[x2] = G))) || mallocng.avail_meta(A2, G)) ||
        (ex x2. x2 in omega && (int_lt(x2, seq_len(A2.taken)) && A2.taken[x2] = G)) by taut(w, u1, f1, a1, t1)
    show := rewrite(sym(ge), r)
  qed
  // (a free meta after: one of A's, not x)
  have rf: all k. k in omega -> int_lt(k, seq_len(A2.free_metas)) -> (ex i. i in omega && int_lt(i, seq_len(F)) && A2.free_metas[k] = F[i]) && !(A2.free_metas[k] = x) proof
    fix k
    assume hk0 hkl0
    have hkl: int_lt(k, seq_len(R)) := rewrite(efr, hkl0)
    have e := rewrite(sym(efr), mp(all_elim(rel, {k}), hk0, hkl))
    have i1: int_add(k, 1) in omega by simp(hk0)
    have i1l: int_lt(int_add(k, 1), seq_len(F)) by arith(hkl, rl, hk0)
    have ne: !(A2.free_metas[k] = x) proof
      assume e2
      have q := mp(all_elim(hd, {int_add(k, 1)}, {0}), i1, simp(), i1l, hn, trans(sym(e), trans(e2, ex)))
      show by arith(q, hk0)
    qed
    show by taut((ex i. i in omega && int_lt(i, seq_len(F)) && A2.free_metas[k] = F[i] by ex_intro({int_add(k, 1)}, taut(i1, i1l, e))), ne)
  qed
  have c5: all x0. x0 in omega -> int_lt(x0, seq_len(A2.taken)) -> (((mallocng.meta_slot(A2, A2.taken[x0]) && !mallocng.is_used(A2, A2.taken[x0])) &&
      !mallocng.avail_meta(A2, A2.taken[x0])) && (all x1. x1 in omega -> int_lt(x1, seq_len(A2.free_metas)) -> !(A2.free_metas[x1] = A2.taken[x0]))) &&
      (all x1. x1 in omega -> int_lt(x1, seq_len(A2.taken)) && A2.taken[x1] = A2.taken[x0] -> x1 = x0) proof
    fix i
    assume hi hil
    have which: all i2. i2 in omega -> int_lt(i2, seq_len(A2.taken)) -> (int_lt(i2, n) && A2.taken[i2] = T[i2]) || (i2 = n && A2.taken[i2] = x) proof
      fix i2
      assume hi2 hi2l
      have co: int_lt(i2, n) -> int_lt(i2, n) && A2.taken[i2] = T[i2] proof
        assume h
        show by taut(h, mp(all_elim(old, {i2}), hi2, h))
      qed
      have cn: !int_lt(i2, n) -> i2 = n && A2.taken[i2] = x proof
        assume h
        have e: i2 = n by arith(hi2l, l2, h, hi2, no)
        show by taut(e, subst({y. A2.taken[y] = x}, sym(e), new))
      qed
      show by taut(co, cn)
    qed
    have wi := mp(all_elim(which, {i}), hi, hil)
    have cold: int_lt(i, n) && A2.taken[i] = T[i] -> (((mallocng.meta_slot(A2, A2.taken[i]) && !mallocng.is_used(A2, A2.taken[i])) &&
        !mallocng.avail_meta(A2, A2.taken[i])) && (all x1. x1 in omega -> int_lt(x1, seq_len(A2.free_metas)) -> !(A2.free_metas[x1] = A2.taken[i]))) &&
        (all x1. x1 in omega -> int_lt(x1, seq_len(A2.taken)) && A2.taken[x1] = A2.taken[i] -> x1 = i) proof
      assume h
      have hn1 he := h
      have m nu na nf dd := mp(all_elim(tk, {i}), hi, hn1)
      have nf2: all x1. x1 in omega -> int_lt(x1, seq_len(A2.free_metas)) -> !(A2.free_metas[x1] = T[i]) proof
        fix k
        assume hk0 hkl
        have ef _ := mp(all_elim(rf, {k}), hk0, hkl)
        obtain i0, hi0 hi0l hfe from ef
        assume e
        show by taut(mp(all_elim(nf, {i0}), hi0, hi0l), trans(sym(hfe), e))
      qed
      have dd2: all x1. x1 in omega -> int_lt(x1, seq_len(A2.taken)) && A2.taken[x1] = T[i] -> x1 = i proof
        fix i2
        assume hi2 h2
        have h21 h22 := h2
        have w2 := mp(all_elim(which, {i2}), hi2, h21)
        have o2: int_lt(i2, n) && A2.taken[i2] = T[i2] -> i2 = i proof
          assume h3
          have h31 h32 := h3
          show := mp(all_elim(dd, {i2}), hi2, conj(h31, trans(sym(h32), h22)))
        qed
        have n2: i2 = n && A2.taken[i2] = x -> i2 = i proof
          assume h3
          have _ h32 := h3
          have e: T[i] = x := trans(sym(h22), h32)
          show by taut(mp(all_elim(xnt, {i}), hi, hn1), e)
        qed
        show by taut(w2, o2, n2)
      qed
      have na2: !mallocng.avail_meta(A2, T[i]) by taut(na, all_elim(av, {T[i]}))
      have r: (((mallocng.meta_slot(A2, T[i]) && !mallocng.is_used(A2, T[i])) && !mallocng.avail_meta(A2, T[i])) &&
          (all x1. x1 in omega -> int_lt(x1, seq_len(A2.free_metas)) -> !(A2.free_metas[x1] = T[i]))) &&
          (all x1. x1 in omega -> int_lt(x1, seq_len(A2.taken)) && A2.taken[x1] = T[i] -> x1 = i)
        by taut(m, all_elim(ms, {T[i]}), nu, all_elim(iu, {T[i]}), na2, nf2, dd2)
      show := rewrite(sym(he), r)
    qed
    have cnew: i = n && A2.taken[i] = x -> (((mallocng.meta_slot(A2, A2.taken[i]) && !mallocng.is_used(A2, A2.taken[i])) &&
        !mallocng.avail_meta(A2, A2.taken[i])) && (all x1. x1 in omega -> int_lt(x1, seq_len(A2.free_metas)) -> !(A2.free_metas[x1] = A2.taken[i]))) &&
        (all x1. x1 in omega -> int_lt(x1, seq_len(A2.taken)) && A2.taken[x1] = A2.taken[i] -> x1 = i) proof
      assume h
      have hn1 he := h
      have nf2: all x1. x1 in omega -> int_lt(x1, seq_len(A2.free_metas)) -> !(A2.free_metas[x1] = x) proof
        fix k
        assume hk0 hkl
        have _ ne := mp(all_elim(rf, {k}), hk0, hkl)
        show ne
      qed
      have dd2: all x1. x1 in omega -> int_lt(x1, seq_len(A2.taken)) && A2.taken[x1] = x -> x1 = i proof
        fix i2
        assume hi2 h2
        have h21 h22 := h2
        have w2 := mp(all_elim(which, {i2}), hi2, h21)
        have o2: int_lt(i2, n) && A2.taken[i2] = T[i2] -> i2 = i proof
          assume h3
          have h31 h32 := h3
          have e: T[i2] = x := trans(sym(h32), h22)
          show by taut(mp(all_elim(xnt, {i2}), hi2, h31), e)
        qed
        have n2: i2 = n && A2.taken[i2] = x -> i2 = i proof
          assume h3
          have h31 _ := h3
          show := trans(h31, sym(hn1))
        qed
        show by taut(w2, o2, n2)
      qed
      have na2: !mallocng.avail_meta(A2, x) by taut(xna, all_elim(av, {x}))
      have r: (((mallocng.meta_slot(A2, x) && !mallocng.is_used(A2, x)) && !mallocng.avail_meta(A2, x)) &&
          (all x1. x1 in omega -> int_lt(x1, seq_len(A2.free_metas)) -> !(A2.free_metas[x1] = x))) &&
          (all x1. x1 in omega -> int_lt(x1, seq_len(A2.taken)) && A2.taken[x1] = x -> x1 = i)
        by taut(xs, all_elim(ms, {x}), xnu, all_elim(iu, {x}), na2, nf2, dd2)
      show := rewrite(sym(he), r)
    qed
    show by taut(wi, cold, cnew)
  qed
  have c6: all x0. x0 in omega -> (ord_lt(0, seq_len(A2.areas)) && int_le(int_sub(mallocng.NSLOTS, A2.avail_cnt), x0)) && int_lt(x0, mallocng.NSLOTS) ->
      !mallocng.is_used(A2, mallocng.meta_at(A2.areas[int_sub(seq_len(A2.areas), 1)], x0)) &&
      (all x1. x1 in omega -> int_lt(x1, seq_len(A2.free_metas)) -> !(A2.free_metas[x1] = mallocng.meta_at(A2.areas[int_sub(seq_len(A2.areas), 1)], x0))) proof
    fix j
    assume hj h
    have h1 h2 h3 := h
    have r1 r2 := mp(all_elim(fr, {j}), hj, taut(rewrite(ear, h1), rewrite(eac, h2), h3))
    let G := mallocng.meta_at(A.areas[int_sub(seq_len(A.areas), 1)], j)
    have r2b: all x1. x1 in omega -> int_lt(x1, seq_len(A2.free_metas)) -> !(A2.free_metas[x1] = G) proof
      fix k
      assume hk0 hkl
      have ef _ := mp(all_elim(rf, {k}), hk0, hkl)
      obtain i0, hi0 hi0l hfe from ef
      assume e
      show by taut(mp(all_elim(r2, {i0}), hi0, hi0l), trans(sym(hfe), e))
    qed
    have r1b: !mallocng.is_used(A2, G) by taut(r1, all_elim(iu, {G}))
    show := rewrite(sym(ear), conj(r1b, r2b))
  qed
  show by defs(taut(c1, c2, c3, c4, c5, c6), mallocng.metas_partition)
qed

// ----------------------------------------------------------------------
//  The area's next meta taken (alloc_meta's `m = ctx.avail_metas++`, the
//  count one less): the state `mp.tav`, the invariant kept

// the area's first available meta, and the state with it taken
abbrev mp.anext(A) := mallocng.meta_at(A.areas[int_sub(seq_len(A.areas), 1)], int_sub(mallocng.NSLOTS, A.avail_cnt))
abbrev mp.tav(A) := mp.take(A, A.free_metas, int_sub(A.avail_cnt, 1), mp.anext(A))

// the step: a meta available; the memory written at the context's
// available meta and count words only, to the next meta and the count
// less one, the pages and the rest as before
abbrev mp.tavpre(c, A, vm, V1, b) := cfg: c in mallocng.Cfg && univ: A in univ(1) && abs: A in mallocng.Abs &&
  blocks: b in fn_space(bits(64), option(omega)) && vm: vm in x86_64_linux.Vm && v1: V1 in x86_64_linux.Vm &&
  holds: mallocng.holds_in(c, A, vm, b) && cnt: int_lt(0, A.avail_cnt) &&
  bytes: (all y. y in bits(64) -> !(int_le(int_add(c.ctx, 24), y) && int_lt(y, int_add(c.ctx, 40))) -> V1.bytes[y] = vm.bytes[y]) &&
  pages: V1.pages = vm.pages && rest: fn_update(V1, "bytes", vm.bytes) = vm &&
  w32: gimple.bytes_at(V1, int_add(c.ctx, 32), 8) = int_sub(A.avail_cnt, 1) &&
  w24: gimple.bytes_at(V1, int_add(c.ctx, 24), 8) = int_add(mp.anext(A), 40)

// (the step's facts: the new state's type and parts, the next meta's place)
theorem mp.tav_basic(c, A, vm, V1, b): mp.tavpre(c, A, vm, V1, b) ->
  abs: mp.tav(A) in mallocng.Abs && univ: mp.tav(A) in univ(1) &&
  metas: mp.tav(A).metas = A.metas && slots: mp.tav(A).slots = A.slots && used: mp.tav(A).used = A.used && active: mp.tav(A).active = A.active &&
  areas: mp.tav(A).areas = A.areas && free: mp.tav(A).free_metas = A.free_metas && cnt: mp.tav(A).avail_cnt = int_sub(A.avail_cnt, 1) &&
  taken: mp.tav(A).taken = seq_concat(A.taken, seq_one(mp.anext(A))) &&
  ranges: mallocng.fp_ranges(c, mp.tav(A)) = mallocng.fp_ranges(c, A) && regions: mallocng.regions(c, mp.tav(A)) = mallocng.regions(c, A) &&
  fixed: mallocng.fixed_ranges(c, mp.tav(A)) = mallocng.fixed_ranges(c, A) &&
  tl: A.taken in list_type(omega) && nat: mp.anext(A) in omega && le: int_le(A.avail_cnt, mallocng.NSLOTS) &&
  len: ord_lt(0, seq_len(A.areas)) && word: mallocng.ctx_word(c, mallocng.mview(vm, mallocng.held(c, A, b)), mallocng.C_AVAIL_META) = mp.anext(A) &&
  page: (ex k. k in omega && int_lt(k, seq_len(A.areas)) && int_le(int_add(A.areas[k], 24), mp.anext(A)) &&
     int_le(int_add(mp.anext(A), 40), int_add(A.areas[k], 4096)) && int_mod(A.areas[k], 4096) = 0) &&
  slot: mallocng.meta_slot(A, mp.anext(A))
proof
  assume P
  have {ha = abs, hh = holds, hk = cnt} := P
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {cok = ctx, hpt = part, har = areas} := expand(H, mallocng.holds)
  have {cle = avail_le, cam = avail_meta} := expand(cok, mallocng.ctx_ok)
  have cl cw := mp(cam, hk)
  have tl: A.taken in list_type(omega) by simp(ha)
  have fl: A.free_metas in list_type(omega) by simp(ha)
  have ko: A.avail_cnt in omega by simp(ha)
  have km: int_sub(A.avail_cnt, 1) in omega by arith(ko, hk)
  have al: A.areas in list_type(omega) by simp(ha)
  have lno: seq_len(A.areas) in omega by arith(al)
  have hni := mp(nat_mem_lt[k := seq_len(A.areas), i := 0], lno, expand(cl, ord_lt))
  let LK := int_sub(seq_len(A.areas), 1)
  have lo: LK in omega by arith(al, hni)
  have lol: int_lt(LK, seq_len(A.areas)) by arith(al, hni)
  have Lo := apply(at_type[l := A.areas, t := omega, i := LK], al, lo, lol)
  have cs: mallocng.AREA_HDR = 24 && mallocng.META_SIZE = 40 && mallocng.NSLOTS = 101 by defs(simp(), mallocng.AREA_HDR, mallocng.META_SIZE, mallocng.NSLOTS)
  have _ _ c101 := cs
  have kle := rewrite(c101, cle)
  have xe: mp.anext(A) = int_add(int_add(A.areas[LK], 24), int_mul(40, int_sub(101, A.avail_cnt))) by defs(simp(cs), mallocng.meta_at)
  have xo: mp.anext(A) in omega by arith(xe, Lo, ko, kle)
  have {ty = abs, tu = univ} := apply(mp.take_type[A := A, F := A.free_metas, n := int_sub(A.avail_cnt, 1), x := mp.anext(A)], ha, fl, km, xo)
  have fpr: mallocng.fp_ranges(c, mp.tav(A)) = mallocng.fp_ranges(c, A) by defs(simp(), mallocng.fp_ranges, mallocng.fixed_ranges, mallocng.auxv_ranges)
  have rgr: mallocng.regions(c, mp.tav(A)) = mallocng.regions(c, A) by defs(simp(), mallocng.regions)
  have fxr: mallocng.fixed_ranges(c, mp.tav(A)) = mallocng.fixed_ranges(c, A) by defs(simp(), mallocng.fixed_ranges, mallocng.auxv_ranges)
  have {aeach = each} := expand(har, mallocng.areas_ok)
  have am _ _ _ _ _ := mp(all_elim(aeach, {LK}), lo, lol)
  have pg: ex k. k in omega && int_lt(k, seq_len(A.areas)) && int_le(int_add(A.areas[k], 24), mp.anext(A)) &&
      int_le(int_add(mp.anext(A), 40), int_add(A.areas[k], 4096)) && int_mod(A.areas[k], 4096) = 0
    by ex_intro({LK}, taut(lo, lol, (int_le(int_add(A.areas[LK], 24), mp.anext(A)) by arith(xe, Lo, ko, kle)),
      (int_le(int_add(mp.anext(A), 40), int_add(A.areas[LK], 4096)) by arith(xe, Lo, ko, kle, hk)), am))
  have j0o: int_sub(mallocng.NSLOTS, A.avail_cnt) in omega := rewrite(sym(c101), (int_sub(101, A.avail_cnt) in omega by arith(ko, kle)))
  have j0l: int_lt(int_sub(mallocng.NSLOTS, A.avail_cnt), mallocng.NSLOTS) := rewrite(sym(c101), (int_lt(int_sub(101, A.avail_cnt), 101) by arith(ko, hk)))
  have xs: mallocng.meta_slot(A, mp.anext(A)) by defs(ex_intro({LK}, {int_sub(mallocng.NSLOTS, A.avail_cnt)}, taut(lo, j0o, lol, j0l, refl({mp.anext(A)}))), mallocng.meta_slot)
  show by taut(xs, ty, tu, (mp.tav(A).metas = A.metas by simp()), (mp.tav(A).slots = A.slots by simp()), (mp.tav(A).used = A.used by simp()),
    (mp.tav(A).active = A.active by simp()), (mp.tav(A).areas = A.areas by simp()), (mp.tav(A).free_metas = A.free_metas by simp()),
    (mp.tav(A).avail_cnt = int_sub(A.avail_cnt, 1) by simp()), (mp.tav(A).taken = seq_concat(A.taken, seq_one(mp.anext(A))) by simp()),
    fpr, rgr, fxr, tl, xo, cle, cl, cw, pg)
qed

// (the views: a byte outside the context's written words and the next
// meta's record the same; a byte outside the record, its page)
theorem mp.tav_ag(c, A, vm, V1, b, a): mp.tavpre(c, A, vm, V1, b) -> a in omega ->
  !(int_le(int_add(c.ctx, 24), a) && int_lt(a, int_add(c.ctx, 40))) -> !(int_le(mp.anext(A), a) && int_lt(a, int_add(mp.anext(A), 40))) ->
  mallocng.mview(V1, mallocng.held(c, mp.tav(A), b))[a] = mallocng.mview(vm, mallocng.held(c, A, b))[a]
proof
  assume P hao nw nx
  have {hh = holds, hby = bytes, ep = pages} := P
  have {em = metas, es = slots, eu = used, etk = taken, fpr = ranges, tl = tl, xo = nat} := apply(mp.tav_basic, P)
  have nw2: !(int_le(int_add(c.ctx, 24), a) && int_lt(a, int_add(int_add(c.ctx, 24), 16))) by arith(nw)
  have hby2: all y. y in bits(64) -> !(int_le(int_add(c.ctx, 24), y) && int_lt(y, int_add(int_add(c.ctx, 24), 16))) -> V1.bytes[y] = vm.bytes[y] proof
    fix y
    assume hy hn
    show := mp(all_elim(hby, {y}), hy, (!(int_le(int_add(c.ctx, 24), y) && int_lt(y, int_add(c.ctx, 40))) by arith(hn)))
  qed
  show := apply(mp.take_view[c := c, A := A, A2 := mp.tav(A), vm := vm, V1 := V1, b := b, x := mp.anext(A), w := int_add(c.ctx, 24), n := 16, a := a],
    hh, tl, xo, fpr, em, es, eu, etk, hby2, ep, hao, nw2, nx)
qed

theorem mp.tav_pg(c, A, vm, V1, b, a): mp.tavpre(c, A, vm, V1, b) -> a in omega -> !(int_le(mp.anext(A), a) && int_lt(a, int_add(mp.anext(A), 40))) ->
  mallocng.pg(mallocng.mview(V1, mallocng.held(c, mp.tav(A), b)), a) = mallocng.pg(mallocng.mview(vm, mallocng.held(c, A, b)), a)
proof
  assume P hao nx
  have {ep = pages} := P
  have {em = metas, es = slots, eu = used, etk = taken, fpr = ranges, tl = tl, xo = nat} := apply(mp.tav_basic, P)
  have epa: V1.pages[int_div(a, x86_64_linux.PAGE)] = vm.pages[int_div(a, x86_64_linux.PAGE)] by simp(ep)
  show := apply(mp.take_pg[c := c, A := A, A2 := mp.tav(A), vm := vm, V1 := V1, b := b, x := mp.anext(A), a := a], tl, xo, hao, fpr, em, es, eu, etk, nx, epa)
qed

// (a byte in no meta area: outside the next meta's record)
theorem mp.tav_nox(c, A, vm, V1, b, a): mp.tavpre(c, A, vm, V1, b) ->
  (all k. k in omega -> int_lt(k, seq_len(A.areas)) -> !(int_le(A.areas[k], a) && int_lt(a, int_add(A.areas[k], 4096)))) ->
  !(int_le(mp.anext(A), a) && int_lt(a, int_add(mp.anext(A), 40)))
proof
  assume P hn
  have {pg = page} := apply(mp.tav_basic, P)
  obtain k, hk hkl k1 k2 _ from pg
  assume h
  have h1 h2 := h
  show by taut(mp(all_elim(hn, {k}), hk, hkl), (int_le(A.areas[k], a) && int_lt(a, int_add(A.areas[k], 4096)) by arith(k1, k2, h1, h2)))
qed

// (a byte outside the context and the meta areas: as before)
theorem mp.tav_far(c, A, vm, V1, b, a): mp.tavpre(c, A, vm, V1, b) -> a in omega -> !mallocng.in_range(a, pair(c.ctx, mallocng.CTX_SIZE)) ->
  (all k. k in omega -> int_lt(k, seq_len(A.areas)) -> !(int_le(A.areas[k], a) && int_lt(a, int_add(A.areas[k], 4096)))) ->
  mallocng.mview(V1, mallocng.held(c, mp.tav(A), b))[a] = mallocng.mview(vm, mallocng.held(c, A, b))[a]
proof
  assume P hao hnc hn
  have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  have h2: !(int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE))) by simp(expand(hnc, mallocng.in_range))
  have nw: !(int_le(int_add(c.ctx, 24), a) && int_lt(a, int_add(c.ctx, 40))) by arith(h2, ks)
  show := apply(mp.tav_ag[c := c, A := A, vm := vm, V1 := V1, b := b, a := a], P, hao, nw, apply(mp.tav_nox, P, hn))
qed

// (a meta's record but the next one's: as before)
theorem mp.tav_rec(c, A, vm, V1, b, g, a): mp.tavpre(c, A, vm, V1, b) -> mallocng.meta_slot(A, g) -> !(g = mp.anext(A)) ->
  a in omega -> int_le(g, a) -> int_lt(a, int_add(g, 40)) ->
  mallocng.mview(V1, mallocng.held(c, mp.tav(A), b))[a] = mallocng.mview(vm, mallocng.held(c, A, b))[a]
proof
  assume P hg hne hao h1 h2
  have {hc = cfg, hu = univ, ha = abs, hh = holds} := P
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {xs = slot} := apply(mp.tav_basic, P)
  have {gex = area} := apply(mp.meta_page, ha, hg)
  obtain k, hk hkl g1 g2 _ from gex
  have {ad = data} := apply(mp.area_apart[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, brk := vm.brk, k := k, a := a], hc, hu, ha, H, hk, hkl, hao,
    arith(g1, h1), arith(g2, h2))
  have nd := mp(all_elim(ad, {0}), simp(), simp())
  have d0 _ _ := apply(mp.data_at[c := c])
  have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  have nr: !(int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE))) by simp(expand(rewrite(d0, nd), mallocng.in_range))
  have nw: !(int_le(int_add(c.ctx, 24), a) && int_lt(a, int_add(c.ctx, 40))) by arith(nr, ks)
  have nx := apply(mp.meta_disj[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, brk := vm.brk, g := mp.anext(A), l := g, a := a],
    hc, hu, ha, H, xs, hg, hne, hao, h1, h2)
  show := apply(mp.tav_ag[c := c, A := A, vm := vm, V1 := V1, b := b, a := a], P, hao, nw, nx)
qed

// (a context byte not a free one: the allocator's after too)
theorem mp.tav_ctxheld(c, A, vm, V1, b, a): mp.tavpre(c, A, vm, V1, b) -> a in omega ->
  int_le(c.ctx, a) -> int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE)) -> !mallocng.ctx_free(c, a) -> a in mallocng.held(c, mp.tav(A), b)
proof
  assume P hao h1 h2 nf
  have {hc = cfg, hu = univ, ha = abs, hh = holds} := P
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {em = metas, es = slots, eu = used, etk = taken, fpr = ranges, tl = tl, xo = nat} := apply(mp.tav_basic, P)
  have hd _ _ := apply(mp.ctx_acc[c := c, A := A, vm := vm, b := b, a := a], hc, hu, ha, hh, hao, h1, h2, nf)
  have hin: mallocng.in_range(a, pair(c.ctx, mallocng.CTX_SIZE)) by defs(simp(h1, h2), mallocng.in_range)
  have hn := apply(mp.ctx_noarea[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, brk := vm.brk, a := a], hc, hu, ha, H, hao, hin)
  have hs := apply(mp.take_held[c := c, A := A, A2 := mp.tav(A), b := b, x := mp.anext(A), a := a], tl, xo, fpr, em, es, eu, etk, apply(mp.tav_nox, P, hn))
  show by taut(hs, hd)
qed

// (a byte of the context but its available meta and count words: as before)
theorem mp.tav_ctxb(c, A, vm, V1, b, a): mp.tavpre(c, A, vm, V1, b) -> a in omega ->
  int_le(c.ctx, a) -> int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE)) -> !(int_le(int_add(c.ctx, 24), a) && int_lt(a, int_add(c.ctx, 40))) ->
  mallocng.mview(V1, mallocng.held(c, mp.tav(A), b))[a] = mallocng.mview(vm, mallocng.held(c, A, b))[a]
proof
  assume P hao h1 h2 nw
  have {hc = cfg, hu = univ, ha = abs, hh = holds} := P
  have {H = inv} := expand(hh, mallocng.holds_in)
  have hin: mallocng.in_range(a, pair(c.ctx, mallocng.CTX_SIZE)) by defs(simp(h1, h2), mallocng.in_range)
  have hn := apply(mp.ctx_noarea[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, brk := vm.brk, a := a], hc, hu, ha, H, hao, hin)
  show := apply(mp.tav_ag[c := c, A := A, vm := vm, V1 := V1, b := b, a := a], P, hao, nw, apply(mp.tav_nox, P, hn))
qed

// (a context word but the written ones: as before)
theorem mp.tav_cw(c, A, vm, V1, b, off): mp.tavpre(c, A, vm, V1, b) -> off in omega -> int_le(int_add(off, 8), mallocng.CTX_SIZE) ->
  (int_le(int_add(off, 8), 24) || int_le(40, off)) ->
  mallocng.ctx_word(c, mallocng.mview(V1, mallocng.held(c, mp.tav(A), b)), off) = mallocng.ctx_word(c, mallocng.mview(vm, mallocng.held(c, A, b)), off)
proof
  assume P ho hl hw
  have {hc = cfg} := P
  have co: c.ctx in omega by simp(hc)
  have ai: all i. i in omega -> int_lt(i, 8) -> mallocng.mview(V1, mallocng.held(c, mp.tav(A), b))[int_add(int_add(c.ctx, off), i)] =
      mallocng.mview(vm, mallocng.held(c, A, b))[int_add(int_add(c.ctx, off), i)] proof
    fix i
    assume hi hil
    show := apply(mp.tav_ctxb[c := c, A := A, vm := vm, V1 := V1, b := b, a := int_add(int_add(c.ctx, off), i)], P, arith(co, ho, hi), arith(co, ho, hi),
      arith(co, ho, hi, hil, hl), arith(hw, hi, hil, ho))
  qed
  show by defs(apply(mp.agree_rd, simp(), ai), mallocng.ctx_word)
qed

// the context for the new state: the available count and meta words
// the written ones, the others and the lists' links as before
theorem mp.tav_ctx(c, A, vm, V1, b): mp.tavpre(c, A, vm, V1, b) ->
  mallocng.ctx_ok(c, mp.tav(A), mallocng.mview(V1, mallocng.held(c, mp.tav(A), b)))
proof
  assume P
  let A2 := mp.tav(A)
  let M := mallocng.mview(vm, mallocng.held(c, A, b))
  let M2 := mallocng.mview(V1, mallocng.held(c, A2, b))
  have {hc = cfg, hu = univ, ha = abs, hh = holds, hk = cnt, w32 = w32, w24 = w24} := P
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {cok = ctx, hpt = part} := expand(H, mallocng.holds)
  have {us = used_slots, fs = free_slots, fr = fresh} := expand(hpt, mallocng.metas_partition)
  have {c1 = secret, c2 = init, c3 = init_lt, c6 = avail_le, c7 = area_cnt, c8 = avail_areas, c9 = brk, c10 = free_metas, c11 = nactive, c12 = active, c13 = shift} := expand(cok, mallocng.ctx_ok)
  have {eac = cnt, eal = areas, len = len, xs = slot} := apply(mp.tav_basic, P)
  have co: c.ctx in omega by simp(hc)
  have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  have ko: A.avail_cnt in omega by simp(ha)
  // the words but the written ones: as before
  have cw: all off. off in omega -> int_le(int_add(off, 8), mallocng.CTX_SIZE) -> (int_le(int_add(off, 8), 24) || int_le(40, off)) ->
      mallocng.ctx_word(c, M2, off) = mallocng.ctx_word(c, M, off) proof
    fix off
    assume ho hl hw
    have ai: all i. i in omega -> int_lt(i, 8) -> M2[int_add(int_add(c.ctx, off), i)] = M[int_add(int_add(c.ctx, off), i)] proof
      fix i
      assume hi hil
      show := apply(mp.tav_ctxb[c := c, A := A, vm := vm, V1 := V1, b := b, a := int_add(int_add(c.ctx, off), i)], P, arith(co, ho, hi), arith(co, ho, hi),
        arith(co, ho, hi, hil, hl), arith(hw, hi, hil, ho))
    qed
    show by defs(apply(mp.agree_rd, simp(), ai), mallocng.ctx_word)
  qed
  have cv: ((((((((mallocng.C_SECRET = 0 && mallocng.C_INIT_DONE = 8) && mallocng.C_FREE_META = 16) && mallocng.C_AVAIL_META = 24) && mallocng.C_AVAIL_CNT = 32) &&
    mallocng.C_AREA_CNT = 40) && mallocng.C_AVAIL_AREAS = 72) && mallocng.C_ACTIVE = 80) && mallocng.C_BRK = 920) && mallocng.C_META_SHIFT = 48
    by defs(simp(), mallocng.C_SECRET, mallocng.C_INIT_DONE, mallocng.C_FREE_META, mallocng.C_AVAIL_META, mallocng.C_AVAIL_CNT, mallocng.C_AREA_CNT,
      mallocng.C_AVAIL_AREAS, mallocng.C_ACTIVE, mallocng.C_BRK, mallocng.C_META_SHIFT)
  have v0 v8 v16 v24 v32 v40 v72 v80 v920 v48 := cv
  have w0 := mp(all_elim(cw, {mallocng.C_SECRET}), simp(v0), arith(v0, ks), arith(v0))
  have w16 := mp(all_elim(cw, {mallocng.C_FREE_META}), simp(v16), arith(v16, ks), arith(v16))
  have w40 := mp(all_elim(cw, {mallocng.C_AREA_CNT}), simp(v40), arith(v40, ks), arith(v40))
  have w72 := mp(all_elim(cw, {mallocng.C_AVAIL_AREAS}), simp(v72), arith(v72, ks), arith(v72))
  have w920 := mp(all_elim(cw, {mallocng.C_BRK}), simp(v920), arith(v920, ks), arith(v920))
  have w48 := mp(all_elim(cw, {mallocng.C_META_SHIFT}), simp(v48), arith(v48, ks), arith(v48))
  have i4: all i. i in omega -> int_lt(i, 4) -> M2[int_add(int_add(c.ctx, mallocng.C_INIT_DONE), i)] = M[int_add(int_add(c.ctx, mallocng.C_INIT_DONE), i)] proof
    fix i
    assume hi hil
    show := apply(mp.tav_ctxb[c := c, A := A, vm := vm, V1 := V1, b := b, a := int_add(int_add(c.ctx, mallocng.C_INIT_DONE), i)], P,
      arith(co, v8, hi), arith(co, v8, hi), arith(co, v8, hi, hil, ks), arith(v8, hi, hil))
  qed
  have r4 := apply(mp.agree_rd, simp(), i4)
  // the written words: read back
  have rw: all off. off in omega -> int_le(24, off) -> int_le(int_add(off, 8), 40) ->
      mallocng.ctx_word(c, M2, off) = gimple.bytes_at(V1, int_add(c.ctx, off), 8) proof
    fix off
    assume ho h1 h2
    have inf: all i. i in omega -> int_lt(i, 8) -> int_add(int_add(c.ctx, off), i) in mallocng.held(c, A2, b) proof
      fix i
      assume hi hil
      have nf: !mallocng.ctx_free(c, int_add(int_add(c.ctx, off), i))
        by defs(arith(h1, h2, hi, hil, co, ho), mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK)
      show := apply(mp.tav_ctxheld[c := c, A := A, vm := vm, V1 := V1, b := b, a := int_add(int_add(c.ctx, off), i)], P,
        arith(co, ho, hi), arith(co, ho, hi), arith(co, ho, hi, hil, h2, ks), nf)
    qed
    have e := apply(mp.view_read[vm := V1, fp := mallocng.held(c, A2, b), a := int_add(c.ctx, off), n := 8], arith(co, ho), simp(), simp(), inf)
    show by defs(sym(e), mallocng.ctx_word)
  qed
  have n32 := trans(mp(all_elim(rw, {mallocng.C_AVAIL_CNT}), simp(v32), arith(v32), arith(v32)), rewrite(sym(v32), w32))
  have n24 := trans(mp(all_elim(rw, {mallocng.C_AVAIL_META}), simp(v24), arith(v24), arith(v24)), rewrite(sym(v24), w24))
  // the clauses
  have k3: int_lt(A2.init_done, 2) by simp(c3)
  have k4: mallocng.ctx_word(c, M2, mallocng.C_AVAIL_CNT) = A2.avail_cnt := trans(n32, sym(eac))
  have k5: int_le(A2.avail_cnt, mallocng.NSLOTS) by arith(eac, c6, hk)
  have cs: mallocng.AREA_HDR = 24 && mallocng.META_SIZE = 40 && mallocng.NSLOTS = 101 by defs(simp(), mallocng.AREA_HDR, mallocng.META_SIZE, mallocng.NSLOTS)
  have k6: int_lt(0, A2.avail_cnt) -> ord_lt(0, seq_len(A2.areas)) &&
      mallocng.ctx_word(c, M2, mallocng.C_AVAIL_META) = mallocng.meta_at(A2.areas[int_sub(seq_len(A2.areas), 1)], int_sub(mallocng.NSLOTS, A2.avail_cnt)) proof
    assume _
    have nx: mallocng.meta_at(A2.areas[int_sub(seq_len(A2.areas), 1)], int_sub(mallocng.NSLOTS, A2.avail_cnt)) = int_add(mp.anext(A), 40)
      by defs(simp(eal, eac, cs, ko, hk, c6), mallocng.meta_at)
    show by taut(rewrite(sym(eal), len), trans(n24, sym(nx)))
  qed
  have k1: mallocng.ctx_word(c, M2, mallocng.C_SECRET) = A2.secret := trans(trans(w0, c1), (A.secret = A2.secret by simp()))
  have k2: mallocng.rd(M2, int_add(c.ctx, mallocng.C_INIT_DONE), 4) = A2.init_done := trans(trans(r4, c2), (A.init_done = A2.init_done by simp()))
  have k7: mallocng.ctx_word(c, M2, mallocng.C_AREA_CNT) = A2.reserve_cnt := trans(trans(w40, c7), (A.reserve_cnt = A2.reserve_cnt by simp()))
  have k8: int_lt(0, A2.reserve_cnt) -> mallocng.ctx_word(c, M2, mallocng.C_AVAIL_AREAS) = A2.reserve && int_mod(A2.reserve, 4096) = 0
    by simp(c8, w72)
  have k9: mallocng.ctx_word(c, M2, mallocng.C_BRK) = A2.brk := trans(trans(w920, c9), (A.brk = A2.brk by simp()))
  have k13: int_le(mallocng.ctx_word(c, M2, mallocng.C_META_SHIFT), 34) := rewrite(sym(w48), c13)
  // the free metas' list: its metas' links as before
  have fx: all i. i in omega -> int_lt(i, seq_len(A.free_metas)) -> mallocng.meta_slot(A, A.free_metas[i]) && !(A.free_metas[i] = mp.anext(A)) proof
    fix i
    assume hi hil
    have m _ := mp(all_elim(fs, {i}), hi, hil)
    have _ nf := mp(all_elim(fr, {int_sub(mallocng.NSLOTS, A.avail_cnt)}), (int_sub(mallocng.NSLOTS, A.avail_cnt) in omega by arith(ko, c6, cs)),
      taut(len, (int_le(int_sub(mallocng.NSLOTS, A.avail_cnt), int_sub(mallocng.NSLOTS, A.avail_cnt)) by arith(ko, c6, cs)),
        (int_lt(int_sub(mallocng.NSLOTS, A.avail_cnt), mallocng.NSLOTS) by arith(ko, hk, cs))))
    show by taut(m, mp(all_elim(nf, {i}), hi, hil))
  qed
  have lk: all g. mallocng.meta_slot(A, g) -> !(g = mp.anext(A)) -> g in omega ->
      mallocng.rd(M2, int_add(g, 8), 8) = mallocng.rd(M, int_add(g, 8), 8) && mallocng.rd(M2, g, 8) = mallocng.rd(M, g, 8) proof
    fix g
    assume hg hne go
    have a8: all i. i in omega -> int_lt(i, 8) -> M2[int_add(int_add(g, 8), i)] = M[int_add(int_add(g, 8), i)] proof
      fix i
      assume hi hil
      show := apply(mp.tav_rec[c := c, A := A, vm := vm, V1 := V1, b := b, g := g, a := int_add(int_add(g, 8), i)], P, hg, hne, arith(go, hi), arith(go, hi), arith(go, hi, hil))
    qed
    have a0: all i. i in omega -> int_lt(i, 8) -> M2[int_add(g, i)] = M[int_add(g, i)] proof
      fix i
      assume hi hil
      show := apply(mp.tav_rec[c := c, A := A, vm := vm, V1 := V1, b := b, g := g, a := int_add(g, i)], P, hg, hne, arith(go, hi), arith(go, hi), arith(go, hi, hil))
    qed
    have r0 := apply(mp.agree_rd[M := M, M2 := M2, a := g, n := 8], simp(), a0)
    show by taut(apply(mp.agree_rd, simp(), a8), r0)
  qed
  have fl: all i. i in omega -> int_lt(i, seq_len(A.free_metas)) -> mallocng.rd(M2, int_add(A.free_metas[i], 8), 8) = mallocng.rd(M, int_add(A.free_metas[i], 8), 8) &&
      mallocng.rd(M2, A.free_metas[i], 8) = mallocng.rd(M, A.free_metas[i], 8) proof
    fix i
    assume hi hil
    have m nx := mp(all_elim(fx, {i}), hi, hil)
    have {go = nat} := apply(mp.meta_page, ha, m)
    show := mp(all_elim(lk, {A.free_metas[i]}), m, nx, go)
  qed
  have k10a := apply(mp.cyclic_agree[M := M, M2 := M2, hd := mallocng.ctx_word(c, M2, mallocng.C_FREE_META), l := A.free_metas], rewrite(sym(w16), c10), fl)
  have k10: mallocng.cyclic(M2, mallocng.ctx_word(c, M2, mallocng.C_FREE_META), A2.free_metas) by simp(k10a)
  have k11: seq_len(A2.active) = 48 by simp(c11)
  // the active lists: their groups' links as before
  have k12: all x0. x0 in omega -> int_lt(x0, 48) -> mallocng.cyclic(M2, mallocng.ctx_word(c, M2, int_add(mallocng.C_ACTIVE, int_mul(8, x0))), A2.active[x0]) proof
    fix sc
    assume hs hsl
    have wa := mp(all_elim(cw, {int_add(mallocng.C_ACTIVE, int_mul(8, sc))}), simp(v80, hs), arith(v80, ks, hs, hsl), arith(v80, hs))
    have {hac = active} := expand(H, mallocng.holds)
    have al: all i. i in omega -> int_lt(i, seq_len(A.active[sc])) ->
        mallocng.rd(M2, int_add(A.active[sc][i], 8), 8) = mallocng.rd(M, int_add(A.active[sc][i], 8), 8) &&
        mallocng.rd(M2, A.active[sc][i], 8) = mallocng.rd(M, A.active[sc][i], 8) proof
      fix i
      assume hi hil
      have iu _ _ := mp(all_elim(expand(hac, mallocng.active_ok), {sc}, {i}), conj(hs, hi), conj(hsl, hil))
      obtain k, hk0 hkl hke from expand(iu, mallocng.is_used)
      have ms := rewrite(hke, mp(all_elim(us, {k}), hk0, hkl))
      have {go = nat} := apply(mp.meta_page, ha, ms)
      // (x not in use: so not this group)
      have nu _ := mp(all_elim(fr, {int_sub(mallocng.NSLOTS, A.avail_cnt)}), (int_sub(mallocng.NSLOTS, A.avail_cnt) in omega by arith(ko, c6, cs)),
        taut(len, (int_le(int_sub(mallocng.NSLOTS, A.avail_cnt), int_sub(mallocng.NSLOTS, A.avail_cnt)) by arith(ko, c6, cs)),
          (int_lt(int_sub(mallocng.NSLOTS, A.avail_cnt), mallocng.NSLOTS) by arith(ko, hk, cs))))
      have ne: !(A.active[sc][i] = mp.anext(A)) proof
        assume e
        show by taut(nu, rewrite(e, iu))
      qed
      show := mp(all_elim(lk, {A.active[sc][i]}), ms, ne, go)
    qed
    have cy := apply(mp.cyclic_agree[M := M, M2 := M2, hd := mallocng.ctx_word(c, M2, int_add(mallocng.C_ACTIVE, int_mul(8, sc))), l := A.active[sc]],
      rewrite(sym(wa), mp(all_elim(c12, {sc}), hs, hsl)), al)
    show by simp(cy)
  qed
  show by defs(taut(k1, k2, k3, k4, k5, k6, k7, k8, k9, k10, k11, k12, k13), mallocng.ctx_ok)
qed

// (initialized: the auxiliary vector's ranges hold no byte)
theorem mp.auxv_none(A, k, a): A in univ(1) -> A in mallocng.Abs -> mallocng.normal(A) -> !(A.init_done = 0) -> k in omega ->
  int_lt(k, seq_len(mallocng.auxv_ranges(A))) -> !mallocng.in_range(a, mallocng.auxv_ranges(A)[k])
proof
  assume hu ha hn hi hk hkl
  have _ ni _ _ := expand(hn, mallocng.normal)
  have l0 a0 := mp(ni, hi)
  let P0 := pair(A.auxv_at, int_mul(16, seq_len(A.auxv)))
  let B := fn_build(int_sub(seq_len(A.auxv), 0), x0. ite(fst(A.auxv[int_add(0, x0)]) = x86_64_linux.AT_RANDOM, pair(int_add(snd(A.auxv[int_add(0, x0)]), 8), 8), pair(0, 0)))
  have al: A.auxv in list_type(cart(omega, omega)) by simp(ha)
  have ad: int_sub(seq_len(A.auxv), 0) in omega by arith(al)
  have av: all x0. x0 in int_sub(seq_len(A.auxv), 0) -> ite(fst(A.auxv[int_add(0, x0)]) = x86_64_linux.AT_RANDOM, pair(int_add(snd(A.auxv[int_add(0, x0)]), 8), 8), pair(0, 0)) in univ(1) proof
    fix x0
    assume hx
    show by simp(hu)
  qed
  have a1 := apply(tr.seq_one_type, (P0 in univ(1) by simp(hu)))
  have bl := apply(build_list, ad, av)
  have lb: seq_len(B) = int_sub(seq_len(A.auxv), 0) by defs(simp(expand(fn_build_dom[d := int_sub(seq_len(A.auxv), 0),
    v := x0. ite(fst(A.auxv[int_add(0, x0)]) = x86_64_linux.AT_RANDOM, pair(int_add(snd(A.auxv[int_add(0, x0)]), 8), 8), pair(0, 0))], seq_len)), seq_len)
  have lb0: seq_len(B) = 0 by arith(lb, l0)
  have l2: seq_len(seq_concat(seq_one(P0), B)) = 1 by arith(a1, bl, lb0)
  have ln: seq_len(mallocng.auxv_ranges(A)) = 1 by defs(l2, mallocng.auxv_ranges)
  have k0: k = 0 by arith(hk, hkl, ln)
  have e0 := at({seq_concat(seq_one(P0), B)[0]}, a1, bl, (0 in omega by simp()), (int_lt(0, seq_len(seq_one(P0))) by simp()))
  have e1: mallocng.auxv_ranges(A)[k] = pair(0, 0) by defs(simp(k0, e0, a0, l0), mallocng.auxv_ranges)
  have r: !mallocng.in_range(a, pair(0, 0)) by defs(simp(), mallocng.in_range)
  show := rewrite(sym(e1), r)
qed

// (x taken, the groups and the ranges as before: a byte outside x's
// record the allocator's after just when before)
theorem mp.take_fp(c, A, A2, b, x, a): A.taken in list_type(omega) -> x in omega ->
  mallocng.fp_ranges(c, A2) = mallocng.fp_ranges(c, A) -> A2.metas = A.metas -> A2.slots = A.slots -> A2.used = A.used ->
  A2.taken = seq_concat(A.taken, seq_one(x)) -> !(int_le(x, a) && int_lt(a, int_add(x, 40))) ->
  (a in mallocng.footprint(c, A2, b) <-> a in mallocng.footprint(c, A, b))
proof
  assume tl xo fpr em es eu etk nx
  have re := apply(mp.inres_fields[A := A, A2 := A2, a := a], em, es, eu)
  have ts := apply(mp.taken_snoc[A := A, A2 := A2, x := x, a := a], tl, xo, etk)
  have cm: mallocng.META_SIZE = 40 by defs(refl({40}), mallocng.META_SIZE)
  have te: mallocng.in_taken(A2, a) <-> mallocng.in_taken(A, a) by taut(rewrite(cm, ts), nx)
  have f1 := set_select_def[s := omega, p := y. y in mallocng.fp_set(mallocng.fp_ranges(c, A), b) && !mallocng.in_reserved(A, y) && !mallocng.in_taken(A, y), z := a]
  have f2 := set_select_def[s := omega, p := y. y in mallocng.fp_set(mallocng.fp_ranges(c, A2), b) && !mallocng.in_reserved(A2, y) && !mallocng.in_taken(A2, y), z := a]
  have fs := subst({y. (a in mallocng.fp_set(mallocng.fp_ranges(c, A2), b)) <-> (a in mallocng.fp_set(y, b))}, fpr,
    ((a in mallocng.fp_set(mallocng.fp_ranges(c, A2), b)) <-> (a in mallocng.fp_set(mallocng.fp_ranges(c, A2), b)) by taut()))
  show by defs(taut(f1, f2, fs, re, te), mallocng.footprint)
qed

// ----------------------------------------------------------------------
//  A meta taken, in general: x (a meta slot not in use, not taken) taken,
//  the free metas F, n available after; written: the context's list and
//  count words (16 .. 40) and the links of metas not in use only -- the
//  free list, the count and the next available meta given for the new
//  state, its partition too

// (the bytes such a step may write)
def mp.tkbyte(c, A, a) := (int_le(int_add(c.ctx, 16), a) && int_lt(a, int_add(c.ctx, 40))) ||
  (ex l. (mallocng.meta_slot(A, l) && !mallocng.is_used(A, l)) && (int_le(l, a) && int_lt(a, int_add(l, 16))))

abbrev mp.tkpre(c, A, F, n, x, vm, V1, b) := cfg: c in mallocng.Cfg && univ: A in univ(1) && abs: A in mallocng.Abs &&
  blocks: b in fn_space(bits(64), option(omega)) && vm: vm in x86_64_linux.Vm && v1: V1 in x86_64_linux.Vm &&
  holds: mallocng.holds_in(c, A, vm, b) && xslot: mallocng.meta_slot(A, x) && xfree: !mallocng.is_used(A, x) && xnew: mp.untaken(A, x) &&
  ftype: F in list_type(omega) && ntype: n in omega && nle: int_le(n, mallocng.NSLOTS) &&
  bytes: (all y. y in bits(64) -> !mp.tkbyte(c, A, y) -> V1.bytes[y] = vm.bytes[y]) &&
  pages: V1.pages = vm.pages && rest: fn_update(V1, "bytes", vm.bytes) = vm &&
  part: mallocng.metas_partition(mp.take(A, F, n, x)) &&
  list: mallocng.cyclic(mallocng.mview(V1, mallocng.held(c, mp.take(A, F, n, x), b)),
    mallocng.ctx_word(c, mallocng.mview(V1, mallocng.held(c, mp.take(A, F, n, x), b)), mallocng.C_FREE_META), F) &&
  cnt: mallocng.ctx_word(c, mallocng.mview(V1, mallocng.held(c, mp.take(A, F, n, x), b)), mallocng.C_AVAIL_CNT) = n &&
  next: (int_lt(0, n) -> ord_lt(0, seq_len(A.areas)) &&
    mallocng.ctx_word(c, mallocng.mview(V1, mallocng.held(c, mp.take(A, F, n, x), b)), mallocng.C_AVAIL_META) =
      mallocng.meta_at(A.areas[int_sub(seq_len(A.areas), 1)], int_sub(mallocng.NSLOTS, n)))

// (the step's facts: the new state's type and parts, x's place)
theorem mp.tk_basic(c, A, F, n, x, vm, V1, b): mp.tkpre(c, A, F, n, x, vm, V1, b) ->
  abs: mp.take(A, F, n, x) in mallocng.Abs && univ: mp.take(A, F, n, x) in univ(1) &&
  metas: mp.take(A, F, n, x).metas = A.metas && slots: mp.take(A, F, n, x).slots = A.slots && used: mp.take(A, F, n, x).used = A.used &&
  active: mp.take(A, F, n, x).active = A.active && areas: mp.take(A, F, n, x).areas = A.areas && free: mp.take(A, F, n, x).free_metas = F &&
  cnt: mp.take(A, F, n, x).avail_cnt = n && taken: mp.take(A, F, n, x).taken = seq_concat(A.taken, seq_one(x)) &&
  ranges: mallocng.fp_ranges(c, mp.take(A, F, n, x)) = mallocng.fp_ranges(c, A) && regions: mallocng.regions(c, mp.take(A, F, n, x)) = mallocng.regions(c, A) &&
  fixed: mallocng.fixed_ranges(c, mp.take(A, F, n, x)) = mallocng.fixed_ranges(c, A) &&
  tl: A.taken in list_type(omega) && nat: x in omega &&
  page: (ex k. k in omega && int_lt(k, seq_len(A.areas)) && int_le(int_add(A.areas[k], 24), x) &&
     int_le(int_add(x, 40), int_add(A.areas[k], 4096)) && int_mod(A.areas[k], 4096) = 0)
proof
  assume P
  have {ha = abs, hh = holds, xs = xslot, hf = ftype, hn = ntype} := P
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {har = areas} := expand(H, mallocng.holds)
  have tl: A.taken in list_type(omega) by simp(ha)
  have {xo = nat, xa = area} := apply(mp.meta_page, ha, xs)
  have {ty = abs, tu = univ} := apply(mp.take_type[A := A, F := F, n := n, x := x], ha, hf, hn, xo)
  have fpr: mallocng.fp_ranges(c, mp.take(A, F, n, x)) = mallocng.fp_ranges(c, A) by defs(simp(), mallocng.fp_ranges, mallocng.fixed_ranges, mallocng.auxv_ranges)
  have rgr: mallocng.regions(c, mp.take(A, F, n, x)) = mallocng.regions(c, A) by defs(simp(), mallocng.regions)
  have fxr: mallocng.fixed_ranges(c, mp.take(A, F, n, x)) = mallocng.fixed_ranges(c, A) by defs(simp(), mallocng.fixed_ranges, mallocng.auxv_ranges)
  have {aeach = each} := expand(har, mallocng.areas_ok)
  obtain k, hk hkl x1 x2 _ from xa
  have am _ _ _ _ _ := mp(all_elim(aeach, {k}), hk, hkl)
  have pg: ex k. k in omega && int_lt(k, seq_len(A.areas)) && int_le(int_add(A.areas[k], 24), x) &&
      int_le(int_add(x, 40), int_add(A.areas[k], 4096)) && int_mod(A.areas[k], 4096) = 0
    by ex_intro({k}, taut(hk, hkl, x1, x2, am))
  show by taut(ty, tu, (mp.take(A, F, n, x).metas = A.metas by simp()), (mp.take(A, F, n, x).slots = A.slots by simp()), (mp.take(A, F, n, x).used = A.used by simp()),
    (mp.take(A, F, n, x).active = A.active by simp()), (mp.take(A, F, n, x).areas = A.areas by simp()), (mp.take(A, F, n, x).free_metas = F by simp()),
    (mp.take(A, F, n, x).avail_cnt = n by simp()), (mp.take(A, F, n, x).taken = seq_concat(A.taken, seq_one(x)) by simp()),
    fpr, rgr, fxr, tl, xo, pg)
qed

// (the views: a byte the step does not write, outside x's record, the same;
// outside x's record, its page)
theorem mp.tk_ag(c, A, F, n, x, vm, V1, b, a): mp.tkpre(c, A, F, n, x, vm, V1, b) -> a in omega -> !mp.tkbyte(c, A, a) ->
  !(int_le(x, a) && int_lt(a, int_add(x, 40))) ->
  mallocng.mview(V1, mallocng.held(c, mp.take(A, F, n, x), b))[a] = mallocng.mview(vm, mallocng.held(c, A, b))[a]
proof
  assume P hao nw nx
  have {hh = holds, hby = bytes, ep = pages} := P
  have {em = metas, es = slots, eu = used, etk = taken, fpr = ranges, tl = tl, xo = nat} := apply(mp.tk_basic, P)
  have {hm = mapped} := expand(hh, mallocng.holds_in)
  have hs := apply(mp.take_held[c := c, A := A, A2 := mp.take(A, F, n, x), b := b, x := x, a := a], tl, xo, fpr, em, es, eu, etk, nx)
  have e1 := apply(mp.view_mem[vm := V1, F1 := mallocng.held(c, mp.take(A, F, n, x), b), F2 := mallocng.held(c, A, b), a := a], hao, hs)
  have bt: a in mallocng.held(c, A, b) -> V1.bytes[bits_of_int(64, a)] = vm.bytes[bits_of_int(64, a)] proof
    assume hf
    have {hff = fp} := apply(mp.held_fp, hf)
    have lo := apply(mp.fp_low[c := c, A := A, vm := vm, b := b, a := a], hm, hff)
    have e: bits_of_int(64, a) = a by defs(arith(hao, lo), bits_of_int, pow2)
    have ab: a in bits(64) by arith(hao, lo)
    show := rewrite(sym(e), mp(all_elim(hby, {a}), ab, nw))
  qed
  have e2 := apply(mp.view_agree[vm := vm, vm2 := V1, fp := mallocng.held(c, A, b), a := a], hao, bt, ep)
  show := trans(e1, e2)
qed

theorem mp.tk_pg(c, A, F, n, x, vm, V1, b, a): mp.tkpre(c, A, F, n, x, vm, V1, b) -> a in omega -> !(int_le(x, a) && int_lt(a, int_add(x, 40))) ->
  mallocng.pg(mallocng.mview(V1, mallocng.held(c, mp.take(A, F, n, x), b)), a) = mallocng.pg(mallocng.mview(vm, mallocng.held(c, A, b)), a)
proof
  assume P hao nx
  have {ep = pages} := P
  have {em = metas, es = slots, eu = used, etk = taken, fpr = ranges, tl = tl, xo = nat} := apply(mp.tk_basic, P)
  have epa: V1.pages[int_div(a, x86_64_linux.PAGE)] = vm.pages[int_div(a, x86_64_linux.PAGE)] by simp(ep)
  show := apply(mp.take_pg[c := c, A := A, A2 := mp.take(A, F, n, x), vm := vm, V1 := V1, b := b, x := x, a := a], tl, xo, hao, fpr, em, es, eu, etk, nx, epa)
qed

// (a byte in no meta area: outside x's record, written by no step)
theorem mp.tk_noarea(c, A, F, n, x, vm, V1, b, a): mp.tkpre(c, A, F, n, x, vm, V1, b) -> a in omega ->
  (all k. k in omega -> int_lt(k, seq_len(A.areas)) -> !(int_le(A.areas[k], a) && int_lt(a, int_add(A.areas[k], 4096)))) ->
  nx: !(int_le(x, a) && int_lt(a, int_add(x, 40))) && links: !(ex l. (mallocng.meta_slot(A, l) && !mallocng.is_used(A, l)) && (int_le(l, a) && int_lt(a, int_add(l, 16))))
proof
  assume P hao hn
  have {ha = abs} := P
  have {pg = page} := apply(mp.tk_basic, P)
  have nx: !(int_le(x, a) && int_lt(a, int_add(x, 40))) proof
    obtain k, hk hkl k1 k2 _ from pg
    assume h
    have h1 h2 := h
    show by taut(mp(all_elim(hn, {k}), hk, hkl), (int_le(A.areas[k], a) && int_lt(a, int_add(A.areas[k], 4096)) by arith(k1, k2, h1, h2)))
  qed
  have nl: !(ex l. (mallocng.meta_slot(A, l) && !mallocng.is_used(A, l)) && (int_le(l, a) && int_lt(a, int_add(l, 16)))) proof
    assume e
    obtain l, hls _ hin from e
    have {lex = area} := apply(mp.meta_page, ha, hls)
    obtain k, hk hkl l1 l2 _ from lex
    have i1 i2 := hin
    show by taut(mp(all_elim(hn, {k}), hk, hkl), (int_le(A.areas[k], a) && int_lt(a, int_add(A.areas[k], 4096)) by arith(l1, l2, i1, i2)))
  qed
  show by taut(nx, nl)
qed

// (a byte outside the context and the meta areas: as before)
theorem mp.tk_far(c, A, F, n, x, vm, V1, b, a): mp.tkpre(c, A, F, n, x, vm, V1, b) -> a in omega -> !mallocng.in_range(a, pair(c.ctx, mallocng.CTX_SIZE)) ->
  (all k. k in omega -> int_lt(k, seq_len(A.areas)) -> !(int_le(A.areas[k], a) && int_lt(a, int_add(A.areas[k], 4096)))) ->
  mallocng.mview(V1, mallocng.held(c, mp.take(A, F, n, x), b))[a] = mallocng.mview(vm, mallocng.held(c, A, b))[a]
proof
  assume P hao hnc hn
  have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  have h2: !(int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE))) by simp(expand(hnc, mallocng.in_range))
  have nc: !(int_le(int_add(c.ctx, 16), a) && int_lt(a, int_add(c.ctx, 40))) by arith(h2, ks)
  have {nx = nx, nl = links} := apply(mp.tk_noarea, P, hao, hn)
  have nw: !mp.tkbyte(c, A, a) by defs(taut(nc, nl), mp.tkbyte)
  show := apply(mp.tk_ag[c := c, A := A, F := F, n := n, x := x, vm := vm, V1 := V1, b := b, a := a], P, hao, nw, nx)
qed

// (a byte of the context but its list and count words: as before)
theorem mp.tk_ctxb(c, A, F, n, x, vm, V1, b, a): mp.tkpre(c, A, F, n, x, vm, V1, b) -> a in omega ->
  int_le(c.ctx, a) -> int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE)) -> !(int_le(int_add(c.ctx, 16), a) && int_lt(a, int_add(c.ctx, 40))) ->
  mallocng.mview(V1, mallocng.held(c, mp.take(A, F, n, x), b))[a] = mallocng.mview(vm, mallocng.held(c, A, b))[a]
proof
  assume P hao h1 h2 nc
  have {hc = cfg, hu = univ, ha = abs, hh = holds} := P
  have {H = inv} := expand(hh, mallocng.holds_in)
  have hin: mallocng.in_range(a, pair(c.ctx, mallocng.CTX_SIZE)) by defs(simp(h1, h2), mallocng.in_range)
  have hn := apply(mp.ctx_noarea[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, brk := vm.brk, a := a], hc, hu, ha, H, hao, hin)
  have {nx = nx, nl = links} := apply(mp.tk_noarea, P, hao, hn)
  have nw: !mp.tkbyte(c, A, a) by defs(taut(nc, nl), mp.tkbyte)
  show := apply(mp.tk_ag[c := c, A := A, F := F, n := n, x := x, vm := vm, V1 := V1, b := b, a := a], P, hao, nw, nx)
qed

// (a group's meta record: as before -- in an area, not x's, not a free one's)
theorem mp.tk_rec(c, A, F, n, x, vm, V1, b, g, a): mp.tkpre(c, A, F, n, x, vm, V1, b) -> mallocng.is_used(A, g) ->
  a in omega -> int_le(g, a) -> int_lt(a, int_add(g, 40)) ->
  mallocng.mview(V1, mallocng.held(c, mp.take(A, F, n, x), b))[a] = mallocng.mview(vm, mallocng.held(c, A, b))[a]
proof
  assume P iu hao h1 h2
  have {hc = cfg, hu = univ, ha = abs, hh = holds, xs = xslot, xnu = xfree} := P
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {hpt = part} := expand(H, mallocng.holds)
  have {us = used_slots} := expand(hpt, mallocng.metas_partition)
  obtain k, hk0 hkl hke from expand(iu, mallocng.is_used)
  have hg := rewrite(hke, mp(all_elim(us, {k}), hk0, hkl))
  have {gex = area} := apply(mp.meta_page, ha, hg)
  obtain j, hj hjl g1 g2 _ from gex
  have {ad = data, aa = areas} := apply(mp.area_apart[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, brk := vm.brk, k := j, a := a], hc, hu, ha, H, hj, hjl, hao,
    arith(g1, h1), arith(g2, h2))
  have nd := mp(all_elim(ad, {0}), simp(), simp())
  have d0 _ _ := apply(mp.data_at[c := c])
  have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  have nr: !(int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE))) by simp(expand(rewrite(d0, nd), mallocng.in_range))
  have nc: !(int_le(int_add(c.ctx, 16), a) && int_lt(a, int_add(c.ctx, 40))) by arith(nr, ks)
  // (a link word of a meta not in use: not g's record)
  have nl: !(ex l. (mallocng.meta_slot(A, l) && !mallocng.is_used(A, l)) && (int_le(l, a) && int_lt(a, int_add(l, 16)))) proof
    assume e
    obtain l, hls hlu hin from e
    have i1 i2 := hin
    have ne: !(l = g) proof
      assume el
      show by taut(hlu, rewrite(sym(el), iu))
    qed
    have d := apply(mp.meta_disj[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, brk := vm.brk, g := g, l := l, a := a],
      hc, hu, ha, H, hg, hls, ne, hao, i1, arith(i2))
    show by taut(d, h1, h2)
  qed
  have nw: !mp.tkbyte(c, A, a) by defs(taut(nc, nl), mp.tkbyte)
  have nex: !(g = x) proof
    assume e
    show by taut(xnu, rewrite(e, iu))
  qed
  have nx := apply(mp.meta_disj[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, brk := vm.brk, g := x, l := g, a := a],
    hc, hu, ha, H, xs, hg, nex, hao, h1, h2)
  show := apply(mp.tk_ag[c := c, A := A, F := F, n := n, x := x, vm := vm, V1 := V1, b := b, a := a], P, hao, nw, nx)
qed

// (a byte of a meta area's header: as before)
theorem mp.tk_hdr(c, A, F, n, x, vm, V1, b, k, a): mp.tkpre(c, A, F, n, x, vm, V1, b) -> k in omega -> int_lt(k, seq_len(A.areas)) -> a in omega ->
  int_le(A.areas[k], a) -> int_lt(a, int_add(A.areas[k], 24)) ->
  mallocng.mview(V1, mallocng.held(c, mp.take(A, F, n, x), b))[a] = mallocng.mview(vm, mallocng.held(c, A, b))[a]
proof
  assume P hk hkl hao h1 h2
  have {hc = cfg, hu = univ, ha = abs, hh = holds} := P
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {ad = data, aa = areas} := apply(mp.area_apart[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, brk := vm.brk, k := k, a := a],
    hc, hu, ha, H, hk, hkl, hao, h1, arith(h2))
  have nd := mp(all_elim(ad, {0}), simp(), simp())
  have d0 _ _ := apply(mp.data_at[c := c])
  have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  have nr: !(int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE))) by simp(expand(rewrite(d0, nd), mallocng.in_range))
  have nc: !(int_le(int_add(c.ctx, 16), a) && int_lt(a, int_add(c.ctx, 40))) by arith(nr, ks)
  // (a meta's record starts past its area's header: so a header byte in none)
  have nrec: all l. mallocng.meta_slot(A, l) -> !(int_le(l, a) && int_lt(a, int_add(l, 40))) proof
    fix l
    assume hl
    have {lex = area} := apply(mp.meta_page, ha, hl)
    obtain j, hj hjl l1 l2 _ from lex
    have same: j = k -> !(int_le(l, a) && int_lt(a, int_add(l, 40))) proof
      assume e
      have l1k := subst({y. int_le(int_add(A.areas[y], 24), l)}, e, l1)
      show by arith(l1k, h2)
    qed
    have other: !(j = k) -> !(int_le(l, a) && int_lt(a, int_add(l, 40))) proof
      assume ne
      have na := mp(all_elim(aa, {j}), hj, hjl, ne)
      assume hx
      have hx1 hx2 := hx
      show by taut(na, (int_le(A.areas[j], a) && int_lt(a, int_add(A.areas[j], 4096)) by arith(l1, l2, hx1, hx2)))
    qed
    show by taut(same, other)
  qed
  have nl: !(ex l. (mallocng.meta_slot(A, l) && !mallocng.is_used(A, l)) && (int_le(l, a) && int_lt(a, int_add(l, 16)))) proof
    assume e
    obtain l, hls _ hin from e
    have i1 i2 := hin
    show by taut(mp(all_elim(nrec, {l}), hls), (int_le(l, a) && int_lt(a, int_add(l, 40)) by arith(i1, i2)))
  qed
  have nw: !mp.tkbyte(c, A, a) by defs(taut(nc, nl), mp.tkbyte)
  have {xs = xslot} := P
  show := apply(mp.tk_ag[c := c, A := A, F := F, n := n, x := x, vm := vm, V1 := V1, b := b, a := a], P, hao, nw, mp(all_elim(nrec, {x}), xs))
qed

// (a context word outside the list and count words: as before)
theorem mp.tk_cw(c, A, F, n, x, vm, V1, b, off): mp.tkpre(c, A, F, n, x, vm, V1, b) -> off in omega -> int_le(int_add(off, 8), mallocng.CTX_SIZE) ->
  (int_le(int_add(off, 8), 16) || int_le(40, off)) ->
  mallocng.ctx_word(c, mallocng.mview(V1, mallocng.held(c, mp.take(A, F, n, x), b)), off) = mallocng.ctx_word(c, mallocng.mview(vm, mallocng.held(c, A, b)), off)
proof
  assume P ho hl hw
  have {hc = cfg} := P
  have co: c.ctx in omega by simp(hc)
  have ai: all i. i in omega -> int_lt(i, 8) -> mallocng.mview(V1, mallocng.held(c, mp.take(A, F, n, x), b))[int_add(int_add(c.ctx, off), i)] =
      mallocng.mview(vm, mallocng.held(c, A, b))[int_add(int_add(c.ctx, off), i)] proof
    fix i
    assume hi hil
    show := apply(mp.tk_ctxb[c := c, A := A, F := F, n := n, x := x, vm := vm, V1 := V1, b := b, a := int_add(int_add(c.ctx, off), i)], P, arith(co, ho, hi), arith(co, ho, hi),
      arith(co, ho, hi, hil, hl), arith(hw, hi, hil, ho))
  qed
  show by defs(apply(mp.agree_rd, simp(), ai), mallocng.ctx_word)
qed

// the context for the new state: the list and count words as given, the
// others and the active lists' links as before
theorem mp.tk_ctx(c, A, F, n, x, vm, V1, b): mp.tkpre(c, A, F, n, x, vm, V1, b) ->
  mallocng.ctx_ok(c, mp.take(A, F, n, x), mallocng.mview(V1, mallocng.held(c, mp.take(A, F, n, x), b)))
proof
  assume P
  let A2 := mp.take(A, F, n, x)
  let M := mallocng.mview(vm, mallocng.held(c, A, b))
  let M2 := mallocng.mview(V1, mallocng.held(c, A2, b))
  have {hc = cfg, hu = univ, ha = abs, hh = holds, hnl = nle, kl = list, kc = cnt, kn = next} := P
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {cok = ctx} := expand(H, mallocng.holds)
  have {c1 = secret, c2 = init, c3 = init_lt, c7 = area_cnt, c8 = avail_areas, c9 = brk, c11 = nactive, c12 = active, c13 = shift} := expand(cok, mallocng.ctx_ok)
  have {eal = areas, efr = free, eac = cnt} := apply(mp.tk_basic, P)
  have co: c.ctx in omega by simp(hc)
  have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  have cv: (((((mallocng.C_SECRET = 0 && mallocng.C_INIT_DONE = 8) && mallocng.C_AREA_CNT = 40) && mallocng.C_AVAIL_AREAS = 72) && mallocng.C_ACTIVE = 80) &&
    mallocng.C_BRK = 920) && mallocng.C_META_SHIFT = 48
    by defs(simp(), mallocng.C_SECRET, mallocng.C_INIT_DONE, mallocng.C_AREA_CNT, mallocng.C_AVAIL_AREAS, mallocng.C_ACTIVE, mallocng.C_BRK, mallocng.C_META_SHIFT)
  have v0 v8 v40 v72 v80 v920 v48 := cv
  have w0 := apply(mp.tk_cw[c := c, A := A, F := F, n := n, x := x, vm := vm, V1 := V1, b := b, off := mallocng.C_SECRET], P, simp(v0), arith(v0, ks), arith(v0))
  have w40 := apply(mp.tk_cw[c := c, A := A, F := F, n := n, x := x, vm := vm, V1 := V1, b := b, off := mallocng.C_AREA_CNT], P, simp(v40), arith(v40, ks), arith(v40))
  have w72 := apply(mp.tk_cw[c := c, A := A, F := F, n := n, x := x, vm := vm, V1 := V1, b := b, off := mallocng.C_AVAIL_AREAS], P, simp(v72), arith(v72, ks), arith(v72))
  have w920 := apply(mp.tk_cw[c := c, A := A, F := F, n := n, x := x, vm := vm, V1 := V1, b := b, off := mallocng.C_BRK], P, simp(v920), arith(v920, ks), arith(v920))
  have w48 := apply(mp.tk_cw[c := c, A := A, F := F, n := n, x := x, vm := vm, V1 := V1, b := b, off := mallocng.C_META_SHIFT], P, simp(v48), arith(v48, ks), arith(v48))
  have i4: all i. i in omega -> int_lt(i, 4) -> M2[int_add(int_add(c.ctx, mallocng.C_INIT_DONE), i)] = M[int_add(int_add(c.ctx, mallocng.C_INIT_DONE), i)] proof
    fix i
    assume hi hil
    show := apply(mp.tk_ctxb[c := c, A := A, F := F, n := n, x := x, vm := vm, V1 := V1, b := b, a := int_add(int_add(c.ctx, mallocng.C_INIT_DONE), i)], P,
      arith(co, v8, hi), arith(co, v8, hi), arith(co, v8, hi, hil, ks), arith(v8, hi, hil))
  qed
  have r4 := apply(mp.agree_rd, simp(), i4)
  have k1: mallocng.ctx_word(c, M2, mallocng.C_SECRET) = A2.secret := trans(trans(w0, c1), (A.secret = A2.secret by simp()))
  have k2: mallocng.rd(M2, int_add(c.ctx, mallocng.C_INIT_DONE), 4) = A2.init_done := trans(trans(r4, c2), (A.init_done = A2.init_done by simp()))
  have k3: int_lt(A2.init_done, 2) by simp(c3)
  have k4: mallocng.ctx_word(c, M2, mallocng.C_AVAIL_CNT) = A2.avail_cnt := trans(kc, sym(eac))
  have k5: int_le(A2.avail_cnt, mallocng.NSLOTS) by simp(eac, hnl)
  have k6: int_lt(0, A2.avail_cnt) -> ord_lt(0, seq_len(A2.areas)) &&
      mallocng.ctx_word(c, M2, mallocng.C_AVAIL_META) = mallocng.meta_at(A2.areas[int_sub(seq_len(A2.areas), 1)], int_sub(mallocng.NSLOTS, A2.avail_cnt)) by simp(kn, eal, eac)
  have k7: mallocng.ctx_word(c, M2, mallocng.C_AREA_CNT) = A2.reserve_cnt := trans(trans(w40, c7), (A.reserve_cnt = A2.reserve_cnt by simp()))
  have k8: int_lt(0, A2.reserve_cnt) -> mallocng.ctx_word(c, M2, mallocng.C_AVAIL_AREAS) = A2.reserve && int_mod(A2.reserve, 4096) = 0 by simp(c8, w72)
  have k9: mallocng.ctx_word(c, M2, mallocng.C_BRK) = A2.brk := trans(trans(w920, c9), (A.brk = A2.brk by simp()))
  have k10: mallocng.cyclic(M2, mallocng.ctx_word(c, M2, mallocng.C_FREE_META), A2.free_metas) by simp(kl, efr)
  have k11: seq_len(A2.active) = 48 by simp(c11)
  have k12: all x0. x0 in omega -> int_lt(x0, 48) -> mallocng.cyclic(M2, mallocng.ctx_word(c, M2, int_add(mallocng.C_ACTIVE, int_mul(8, x0))), A2.active[x0]) proof
    fix sc
    assume hs hsl
    have wa := apply(mp.tk_cw[c := c, A := A, F := F, n := n, x := x, vm := vm, V1 := V1, b := b, off := int_add(mallocng.C_ACTIVE, int_mul(8, sc))], P, simp(v80, hs),
      arith(v80, ks, hs, hsl), arith(v80, hs))
    have {hac = active} := expand(H, mallocng.holds)
    have al: all i. i in omega -> int_lt(i, seq_len(A.active[sc])) ->
        mallocng.rd(M2, int_add(A.active[sc][i], 8), 8) = mallocng.rd(M, int_add(A.active[sc][i], 8), 8) &&
        mallocng.rd(M2, A.active[sc][i], 8) = mallocng.rd(M, A.active[sc][i], 8) proof
      fix i
      assume hi hil
      have iu _ _ := mp(all_elim(expand(hac, mallocng.active_ok), {sc}, {i}), conj(hs, hi), conj(hsl, hil))
      have {go = nat} := apply(mp.used_nat, ha, iu)
      have a8: all j. j in omega -> int_lt(j, 8) -> M2[int_add(int_add(A.active[sc][i], 8), j)] = M[int_add(int_add(A.active[sc][i], 8), j)] proof
        fix j
        assume hj hjl
        show := apply(mp.tk_rec[c := c, A := A, F := F, n := n, x := x, vm := vm, V1 := V1, b := b, g := A.active[sc][i], a := int_add(int_add(A.active[sc][i], 8), j)],
          P, iu, arith(go, hj), arith(go, hj), arith(go, hj, hjl))
      qed
      have a0: all j. j in omega -> int_lt(j, 8) -> M2[int_add(A.active[sc][i], j)] = M[int_add(A.active[sc][i], j)] proof
        fix j
        assume hj hjl
        show := apply(mp.tk_rec[c := c, A := A, F := F, n := n, x := x, vm := vm, V1 := V1, b := b, g := A.active[sc][i], a := int_add(A.active[sc][i], j)],
          P, iu, arith(go, hj), arith(go, hj), arith(go, hj, hjl))
      qed
      show by taut(apply(mp.agree_rd, simp(), a8), apply(mp.agree_rd[M := M, M2 := M2, a := A.active[sc][i], n := 8], simp(), a0))
    qed
    have cy := apply(mp.cyclic_agree[M := M, M2 := M2, hd := mallocng.ctx_word(c, M2, int_add(mallocng.C_ACTIVE, int_mul(8, sc))), l := A.active[sc]],
      rewrite(sym(wa), mp(all_elim(c12, {sc}), hs, hsl)), al)
    show by simp(cy)
  qed
  have k13: int_le(mallocng.ctx_word(c, M2, mallocng.C_META_SHIFT), 34) := rewrite(sym(w48), c13)
  show by defs(taut(k1, k2, k3, k4, k5, k6, k7, k8, k9, k10, k11, k12, k13), mallocng.ctx_ok)
qed

// the meta areas for the new state: their headers and pages as before (x's
// record taken)
theorem mp.tk_areas(c, A, F, n, x, vm, V1, b): mp.tkpre(c, A, F, n, x, vm, V1, b) ->
  mallocng.areas_ok(c, mp.take(A, F, n, x), mallocng.mview(V1, mallocng.held(c, mp.take(A, F, n, x), b)))
proof
  assume P
  let A2 := mp.take(A, F, n, x)
  let M := mallocng.mview(vm, mallocng.held(c, A, b))
  let M2 := mallocng.mview(V1, mallocng.held(c, A2, b))
  have {hc = cfg, hu = univ, ha = abs, hh = holds} := P
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {har = areas} := expand(H, mallocng.holds)
  have {ah = head, at = tail, ae = each, ad = distinct, ar = reserve} := expand(har, mallocng.areas_ok)
  have {etk = taken, tl = tl, xo = nat} := apply(mp.tk_basic, P)
  have cv: mallocng.C_AREA_HEAD = 56 && mallocng.C_AREA_TAIL = 64 && mallocng.CTX_SIZE = 928 by defs(simp(), mallocng.C_AREA_HEAD, mallocng.C_AREA_TAIL, mallocng.CTX_SIZE)
  have vh vt vs := cv
  have wh := rewrite(sym(vh), apply(mp.tk_cw[c := c, A := A, F := F, n := n, x := x, vm := vm, V1 := V1, b := b, off := 56], P, simp(), arith(vs), arith()))
  have wt := rewrite(sym(vt), apply(mp.tk_cw[c := c, A := A, F := F, n := n, x := x, vm := vm, V1 := V1, b := b, off := 64], P, simp(), arith(vs), arith()))
  have rl: A.areas in list_type(omega) by simp(ha)
  have ae2: all x0. x0 in omega -> int_lt(x0, seq_len(A.areas)) ->
      ((((((int_mod(A.areas[x0], 4096) = 0 && int_lt(0, A.areas[x0])) && mallocng.rd(M2, A.areas[x0], 8) = A.secret) &&
        mallocng.rd(M2, int_add(A.areas[x0], 8), 8) = ite(int_lt(int_add(x0, 1), seq_len(A.areas)), A.areas[int_add(x0, 1)], 0)) &&
        mallocng.rd(M2, int_add(A.areas[x0], 16), 4) = mallocng.NSLOTS) &&
        (all x1. x1 in omega -> (int_le(A.areas[x0], x1) && int_lt(x1, int_add(A.areas[x0], 4096))) && !mallocng.in_taken(A2, x1) ->
           mallocng.m_rw(M2, x1) && !(snd(mallocng.pg(M2, x1)).kind = 2)))) proof
    fix k
    assume hk hkl
    have e1 e2 e3 e4 e5 e6 := mp(all_elim(ae, {k}), hk, hkl)
    have ako := mp(at_type[l := A.areas, t := omega, i := k], rl, hk, hkl)
    have hb: all o. all m. o in omega -> m in omega -> int_le(int_add(o, m), 24) ->
        mallocng.rd(M2, int_add(A.areas[k], o), m) = mallocng.rd(M, int_add(A.areas[k], o), m) proof
      fix o m
      assume ho hm hl
      have ai: all j. j in omega -> int_lt(j, m) -> M2[int_add(int_add(A.areas[k], o), j)] = M[int_add(int_add(A.areas[k], o), j)] proof
        fix j
        assume hj hjl
        show := apply(mp.tk_hdr[c := c, A := A, F := F, n := n, x := x, vm := vm, V1 := V1, b := b, k := k, a := int_add(int_add(A.areas[k], o), j)],
          P, hk, hkl, simp(ako, ho, hj), arith(ako, ho, hj), arith(ako, ho, hj, hjl, hl))
      qed
      show := apply(mp.agree_rd, hm, ai)
    qed
    have r0 := rewrite((int_add(A.areas[k], 0) = A.areas[k] by arith(ako)), mp(all_elim(hb, {0}, {8}), simp(), simp(), simp()))
    have r8 := mp(all_elim(hb, {8}, {8}), simp(), simp(), simp())
    have r16 := mp(all_elim(hb, {16}, {4}), simp(), simp(), simp())
    have p6: all x1. x1 in omega -> (int_le(A.areas[k], x1) && int_lt(x1, int_add(A.areas[k], 4096))) && !mallocng.in_taken(A2, x1) ->
        mallocng.m_rw(M2, x1) && !(snd(mallocng.pg(M2, x1)).kind = 2) proof
      fix y
      assume hy hyr
      have yr1 yr2 nt := hyr
      have ts := apply(mp.taken_snoc[A := A, A2 := A2, x := x, a := y], tl, xo, etk)
      have cm: mallocng.META_SIZE = 40 by defs(refl({40}), mallocng.META_SIZE)
      have nt1: !mallocng.in_taken(A, y) by taut(ts, nt)
      have nx: !(int_le(x, y) && int_lt(y, int_add(x, 40))) by taut(rewrite(cm, ts), nt)
      have pe := apply(mp.tk_pg[c := c, A := A, F := F, n := n, x := x, vm := vm, V1 := V1, b := b, a := y], P, hy, nx)
      have {rw = rw} := apply(mp.pg_same, pe)
      have o1 o2 := mp(all_elim(e6, {y}), hy, conj(conj(yr1, yr2), nt1))
      show by taut(rw, o1, rewrite(sym(pe), o2))
    qed
    show by taut(e1, e2, rewrite(sym(r0), e3), rewrite(sym(r8), e4), rewrite(sym(r16), e5), p6)
  qed
  have ar2: all x0. x0 in omega -> int_le(A.reserve, x0) && int_lt(x0, int_add(A.reserve, int_mul(4096, A.reserve_cnt))) ->
      mallocng.m_mapped(M2, x0) && !(snd(mallocng.pg(M2, x0)).kind = 2) && mallocng.b8(M2, x0) = 0 proof
    fix y
    assume hy hyr
    have inr: mallocng.in_range(y, pair(A.reserve, int_mul(4096, A.reserve_cnt))) by defs(simp(hyr), mallocng.in_range)
    have nc := apply(mp.not_ctx[c := c, A := A, M := M, b := b, brk := vm.brk, a := y], hc, hu, ha, H, hy, taut(inr))
    have na := apply(mp.noarea[c := c, A := A, M := M, b := b, brk := vm.brk, a := y], hc, hu, ha, H, hy, taut(inr))
    have e := apply(mp.tk_far[c := c, A := A, F := F, n := n, x := x, vm := vm, V1 := V1, b := b, a := y], P, hy, nc, na)
    have {eb = byte, ep = page} := apply(mp.agree_b8, e)
    have {mm = mapped} := apply(mp.pg_same, ep)
    have o1 ok1 o2 := mp(all_elim(ar, {y}), hy, hyr)
    show by taut(mm, o1, rewrite(sym(ep), ok1), rewrite(sym(eb), o2))
  qed
  show by defs(simp(rewrite(sym(wh), ah), rewrite(sym(wt), at), ae2, ad, ar2), mallocng.areas_ok)
qed

theorem mp.tk_perms(c, A, F, n, x, vm, V1, b): mp.tkpre(c, A, F, n, x, vm, V1, b) ->
  mallocng.perms_ok(c, mp.take(A, F, n, x), mallocng.mview(V1, mallocng.held(c, mp.take(A, F, n, x), b)), b)
proof
  assume P
  let A2 := mp.take(A, F, n, x)
  let M := mallocng.mview(vm, mallocng.held(c, A, b))
  let M2 := mallocng.mview(V1, mallocng.held(c, A2, b))
  have {hc = cfg, hu = univ, ha = abs, hh = holds} := P
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {hpm = perms, hnm = normal, hga = apart} := expand(H, mallocng.holds)
  have q1 q2 q3 := expand(hpm, mallocng.perms_ok)
  have {em = metas, es = slots, eu = used} := apply(mp.tk_basic, P)
  have r1: all x0. all x1. x0 in omega && x1 in omega -> ((int_lt(x0, 3) && int_le(fst(mallocng.data_ranges(c)[x0]), x1)) &&
      int_lt(x1, int_add(fst(mallocng.data_ranges(c)[x0]), snd(mallocng.data_ranges(c)[x0])))) && !mallocng.ctx_free(c, x1) ->
      mallocng.m_rw(M2, x1) && !(snd(mallocng.pg(M2, x1)).kind = 2) proof
    fix k a
    assume ho h
    have hk hao := ho
    have hkl h1 h2 _ := h
    have inr: mallocng.in_range(a, mallocng.data_ranges(c)[k]) by defs(taut(h1, h2), mallocng.in_range)
    have ed: ex i. i in omega && int_lt(i, 3) && mallocng.in_range(a, mallocng.data_ranges(c)[i]) by ex_intro({k}, taut(hk, hkl, inr))
    have na := apply(mp.noarea[c := c, A := A, M := M, b := b, brk := vm.brk, a := a], hc, hu, ha, H, hao, taut(ed))
    have {nx = nx} := apply(mp.tk_noarea, P, hao, na)
    have pe := apply(mp.tk_pg[c := c, A := A, F := F, n := n, x := x, vm := vm, V1 := V1, b := b, a := a], P, hao, nx)
    have {rw = rw} := apply(mp.pg_same, pe)
    have o1 o2 := mp(all_elim(q1, {k}, {a}), ho, h)
    show by taut(rw, o1, rewrite(sym(pe), o2))
  qed
  have r2: all x0. all x1. x0 in omega && x1 in omega -> (((int_lt(x0, seq_len(A.used)) && int_le(fst(mallocng.group_range(A.metas[A.used[x0]])), x1)) &&
      int_lt(x1, int_add(fst(mallocng.group_range(A.metas[A.used[x0]])), snd(mallocng.group_range(A.metas[A.used[x0]]))))) && !(x1 in malloc.live_of(b))) &&
      !mallocng.in_reserved(A2, x1) -> mallocng.m_rw(M2, x1) && !(snd(mallocng.pg(M2, x1)).kind = 2) proof
    fix k a
    assume ho h
    have hk hao := ho
    have hkl h1 h2 nl nr2 := h
    have nr: !mallocng.in_reserved(A, a) by taut(nr2, apply(mp.inres_fields[A := A, A2 := A2, a := a], em, es, eu))
    have inr: mallocng.in_range(a, mallocng.group_range(A.metas[A.used[k]])) by defs(taut(h1, h2), mallocng.in_range)
    have nf := mp(all_elim(expand(hga, mallocng.groups_apart), {k}, {a}), ho, conj(hkl, inr))
    have na: all x0. x0 in omega -> int_lt(x0, seq_len(A.areas)) -> !(int_le(A.areas[x0], a) && int_lt(a, int_add(A.areas[x0], 4096))) proof
      fix j
      assume hj hjl
      assume hin
      have hin1 hin2 := hin
      show by taut(nf, apply(mp.area_fixed[c := c, A := A, k := j, a := a], hc, hu, ha, hj, hjl, hin1, hin2))
    qed
    have {nx = nx} := apply(mp.tk_noarea, P, hao, na)
    have pe := apply(mp.tk_pg[c := c, A := A, F := F, n := n, x := x, vm := vm, V1 := V1, b := b, a := a], P, hao, nx)
    have {rw = rw} := apply(mp.pg_same, pe)
    have o1 o2 := mp(all_elim(q2, {k}, {a}), ho, taut(hkl, h1, h2, nl, nr))
    show by taut(rw, o1, rewrite(sym(pe), o2))
  qed
  // the auxiliary vector: as before -- its pages unchanged unless x's
  // record were in it, which needs initialization done (x's area exists)
  have {pg = page} := apply(mp.tk_basic, P)
  have {hfr = fresh} := expand(H, mallocng.holds)
  have fz := expand(hfr, mallocng.fresh_ok)
  have ni: !(A.init_done = 0) proof
    assume e
    have {z = areas} := mp(fz, e)
    obtain k0, hk0 hk0l _ _ _ from pg
    show by arith(z, hk0, hk0l)
  qed
  have r3: all x0. all x1. x0 in omega && x1 in omega -> (int_lt(x0, seq_len(mallocng.auxv_ranges(A))) && int_le(fst(mallocng.auxv_ranges(A)[x0]), x1)) &&
      int_lt(x1, int_add(fst(mallocng.auxv_ranges(A)[x0]), snd(mallocng.auxv_ranges(A)[x0]))) -> mallocng.m_mapped(M2, x1) && snd(mallocng.pg(M2, x1)).prot.r proof
    fix k a
    assume ho h
    have hk _ := ho
    have hkl h1 h2 := h
    have f := apply(mp.auxv_none[A := A, k := k, a := a], hu, ha, hnm, ni, hk, hkl)
    show by taut(f, (mallocng.in_range(a, mallocng.auxv_ranges(A)[k]) by defs(taut(h1, h2), mallocng.in_range)))
  qed
  have ear: mallocng.auxv_ranges(A2) = mallocng.auxv_ranges(A) by defs(simp(), mallocng.auxv_ranges)
  show by defs(simp(r1, r2, r3, ear, em, eu), mallocng.perms_ok)
qed

// (a byte of the lock, libc, the image's constants, the reserve or a
// group: as before)
theorem mp.tk_region(c, A, F, n, x, vm, V1, b, a): mp.tkpre(c, A, F, n, x, vm, V1, b) -> a in omega ->
  ((((ex i. i in omega && (int_lt(0, i) && int_lt(i, 3)) && mallocng.in_range(a, mallocng.data_ranges(c)[i])) ||
    (ex i. i in omega && int_lt(i, x86_64_linux.phnum(c.file)) && mallocng.in_range(a, mallocng.ro_ranges(c.file)[i]))) ||
    mallocng.in_range(a, pair(A.reserve, int_mul(4096, A.reserve_cnt)))) ||
    (ex h. mallocng.is_used(A, h) && mallocng.in_range(a, mallocng.group_range(A.metas[h])))) ->
  mallocng.mview(V1, mallocng.held(c, mp.take(A, F, n, x), b))[a] = mallocng.mview(vm, mallocng.held(c, A, b))[a]
proof
  assume P hao hr
  have {hc = cfg, hu = univ, ha = abs, hh = holds} := P
  have {H = inv} := expand(hh, mallocng.holds_in)
  have nc := apply(mp.not_ctx[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, brk := vm.brk, a := a], hc, hu, ha, H, hao, hr)
  have dd: (ex i. i in omega && (int_lt(0, i) && int_lt(i, 3)) && mallocng.in_range(a, mallocng.data_ranges(c)[i])) ->
      (ex i. i in omega && int_lt(i, 3) && mallocng.in_range(a, mallocng.data_ranges(c)[i])) proof
    assume e
    obtain i, hi hq hir from e
    have _ hi3 := hq
    show by ex_intro({i}, taut(hi, hi3, hir))
  qed
  have na := apply(mp.noarea[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, brk := vm.brk, a := a], hc, hu, ha, H, hao, taut(hr, dd))
  show := apply(mp.tk_far[c := c, A := A, F := F, n := n, x := x, vm := vm, V1 := V1, b := b, a := a], P, hao, nc, na)
qed

// the invariant for the new state on its view
theorem mp.tk_holds(c, A, F, n, x, vm, V1, b): mp.tkpre(c, A, F, n, x, vm, V1, b) ->
  mallocng.holds(c, mp.take(A, F, n, x), mallocng.mview(V1, mallocng.held(c, mp.take(A, F, n, x), b)), b, V1.brk)
proof
  assume P
  let A2 := mp.take(A, F, n, x)
  let M := mallocng.mview(vm, mallocng.held(c, A, b))
  let M2 := mallocng.mview(V1, mallocng.held(c, A2, b))
  have {hc = cfg, hu = univ, ha = abs, hb = blocks, hh = holds, rest = rest, pt2 = part} := P
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {hnm = normal, hbk = brk, hsp = sep, hcl = classes, hdb = debruijn, hff = fixed, hga = apart, hfr = fresh, himg = image, huo = used} :=
    expand(H, mallocng.holds)
  have {em = metas, es = slots, eu = used, ea = active, rgr = regions, fxr = fixed, pg = page} := apply(mp.tk_basic, P)
  have gbs: all a. a in omega -> mp.ingrp(A, a) -> M2[a] = M[a] proof
    fix a
    assume hao ig
    obtain h, iu gb from expand(ig, mp.ingrp)
    have {go = nat} := apply(mp.used_nat, ha, iu)
    have gok := apply(mp.used_group, huo, iu)
    have g1 g2 := expand(gb, mp.gb)
    have inr := apply(mp.group_bytes[A := A, M := M, b := b, h := h, a := a], ha, go, gok, hao, g1, g2)
    have e: ex h0. mallocng.is_used(A, h0) && mallocng.in_range(a, mallocng.group_range(A.metas[h0])) by ex_intro({h}, taut(iu, inr))
    show := apply(mp.tk_region[c := c, A := A, F := F, n := n, x := x, vm := vm, V1 := V1, b := b, a := a], P, hao, taut(e))
  qed
  have rcs: all g. all a. mallocng.is_used(A, g) -> a in omega -> int_le(g, a) -> int_lt(a, int_add(g, 40)) -> M2[a] = M[a] proof
    fix g a
    assume iu hao h1 h2
    show := apply(mp.tk_rec[c := c, A := A, F := F, n := n, x := x, vm := vm, V1 := V1, b := b, g := g, a := a], P, iu, hao, h1, h2)
  qed
  have d0 d1 d2 := apply(mp.data_at[c := c])
  have cl1 cl2 cl3 := (c.ctx in omega && c.lock in omega && c.libc in omega by simp(hc))
  have ro: all i. all a. i in omega -> a in omega -> int_lt(i, x86_64_linux.phnum(c.file)) -> mallocng.in_range(a, mallocng.ro_ranges(c.file)[i]) -> M2[a] = M[a] proof
    fix i a
    assume hi hao hil inr
    have e: ex i0. i0 in omega && int_lt(i0, x86_64_linux.phnum(c.file)) && mallocng.in_range(a, mallocng.ro_ranges(c.file)[i0]) by ex_intro({i}, taut(hi, hil, inr))
    show := apply(mp.tk_region[c := c, A := A, F := F, n := n, x := x, vm := vm, V1 := V1, b := b, a := a], P, hao, taut(e))
  qed
  have lnl: mallocng.L_NEED_LOCKS = 3 by defs(simp(), mallocng.L_NEED_LOCKS)
  have lb: mallocng.in_range(int_add(c.libc, mallocng.L_NEED_LOCKS), mallocng.data_ranges(c)[2]) by defs(simp(d2, lnl, (int_lt(int_add(c.libc, 3), int_add(c.libc, 16)) by arith(cl3))), mallocng.in_range)
  have lbx: ex i. i in omega && (int_lt(0, i) && int_lt(i, 3)) && mallocng.in_range(int_add(c.libc, mallocng.L_NEED_LOCKS), mallocng.data_ranges(c)[i])
    by ex_intro({2}, taut((2 in omega by simp()), (int_lt(0, 2) && int_lt(2, 3) by simp()), lb))
  have nl := apply(mp.tk_region[c := c, A := A, F := F, n := n, x := x, vm := vm, V1 := V1, b := b, a := int_add(c.libc, mallocng.L_NEED_LOCKS)], P, simp(cl3, lnl), taut(lbx))
  have lk: all i. i in omega -> int_lt(i, 4) -> M2[int_add(c.lock, i)] = M[int_add(c.lock, i)] proof
    fix i
    assume hi hil
    have inr: mallocng.in_range(int_add(c.lock, i), mallocng.data_ranges(c)[1]) by defs(simp(d1, (int_lt(int_add(c.lock, i), int_add(c.lock, 4)) by arith(cl2, hi, hil)), cl2, hi), mallocng.in_range)
    have ex: ex j. j in omega && (int_lt(0, j) && int_lt(j, 3)) && mallocng.in_range(int_add(c.lock, i), mallocng.data_ranges(c)[j])
      by ex_intro({1}, taut((1 in omega by simp()), (int_lt(0, 1) && int_lt(1, 3) by simp()), inr))
    show := apply(mp.tk_region[c := c, A := A, F := F, n := n, x := x, vm := vm, V1 := V1, b := b, a := int_add(c.lock, i)], P, simp(cl2, hi), taut(ex))
  qed
  have img := apply(mp.image_tr[c := c, M := M, M2 := M2], hc, himg, ro, nl, lk)
  have _ _ kc3 := expand(hcl, mallocng.classes_ok)
  have cla: all a. a in omega -> int_le(c.sct, a) -> int_lt(a, int_add(c.sct, 96)) -> M2[a] = M[a] proof
    fix a
    assume hao h1 h2
    obtain i, hi hil r1 r2 from kc3
    have inr: mallocng.in_range(a, mallocng.ro_ranges(c.file)[i]) by defs(arith(r1, r2, h1, h2), mallocng.in_range)
    show := mp(all_elim(ro, {i}, {a}), hi, hao, hil, inr)
  qed
  have cl := apply(mp.classes_tr[c := c, M := M, M2 := M2], hc, hcl, cla)
  have _ _ kd3 := expand(hdb, mallocng.debruijn_ok)
  have dba: all a. a in omega -> int_le(c.dbj, a) -> int_lt(a, int_add(c.dbj, 32)) -> M2[a] = M[a] proof
    fix a
    assume hao h1 h2
    obtain i, hi hil r1 r2 from kd3
    have inr: mallocng.in_range(a, mallocng.ro_ranges(c.file)[i]) by defs(arith(r1, r2, h1, h2), mallocng.in_range)
    show := mp(all_elim(ro, {i}, {a}), hi, hao, hil, inr)
  qed
  have db := apply(mp.debruijn_tr[c := c, M := M, M2 := M2], hc, hdb, dba)
  have cok2 := apply(mp.tk_ctx, P)
  have ar2 := apply(mp.tk_areas, P)
  have pm2 := apply(mp.tk_perms, P)
  have fz := expand(hfr, mallocng.fresh_ok)
  have ni: !(A.init_done = 0) proof
    assume e
    have {z = areas} := mp(fz, e)
    obtain k0, hk0 hk0l _ _ _ from pg
    show by arith(z, hk0, hk0l)
  qed
  have ni2: !(A2.init_done = 0) by simp(ni)
  have fr2: mallocng.fresh_ok(c, A2, M2) by defs(taut(ni2), mallocng.fresh_ok)
  have nm2: mallocng.normal(A2) by defs(simp(expand(hnm, mallocng.normal, mallocng.is_used)), mallocng.normal, mallocng.is_used)
  have eb: V1.brk = vm.brk := rewrite(rest, (V1.brk = fn_update(V1, "bytes", vm.bytes).brk by simp()))
  have bk2: mallocng.brk_ok(A2, V1.brk) by defs(simp(expand(hbk, mallocng.brk_ok), eb), mallocng.brk_ok)
  have sp2 := rewrite(sym(rgr), hsp)
  have ff2: mallocng.fixed_free(c, A2, b) by defs(simp(expand(hff, mallocng.fixed_free)), mallocng.fixed_free)
  have ga2: mallocng.groups_apart(c, A2) by defs(simp(expand(hga, mallocng.groups_apart), fxr), mallocng.groups_apart)
  show := apply(mp.holds_supply[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := vm.brk, brk2 := V1.brk], ha, hb, H, em, es, eu, ea, gbs, rcs,
    img, cok2, fr2, ar2, pt2, nm2, bk2, pm2, sp2, cl, db, ff2, ga2)
qed

// the step: the invariant in memory for the new state
theorem mp.tk_holds_in(c, A, F, n, x, vm, V1, b): mp.tkpre(c, A, F, n, x, vm, V1, b) -> mallocng.holds_in(c, mp.take(A, F, n, x), V1, b)
proof
  assume P
  let A2 := mp.take(A, F, n, x)
  have {hc = cfg, hu = univ, ha = abs, hh = holds, ep = pages} := P
  have {H = inv, hm = mapped, hfr = free} := expand(hh, mallocng.holds_in)
  have {em = metas, es = slots, eu = used, etk = taken, fpr = ranges, tl = tl, xo = nat} := apply(mp.tk_basic, P)
  have h2 := apply(mp.tk_holds, P)
  have m2: mallocng.fp_mapped(mallocng.fp_ranges(c, A2), b, V1) by defs(simp(expand(hm, mallocng.fp_mapped, x86_64_linux.mapped), fpr, ep), mallocng.fp_mapped, x86_64_linux.mapped)
  have fm: all a. a in omega -> mallocng.ctx_free(c, a) -> (a in mallocng.footprint(c, A, b) <-> a in mallocng.footprint(c, A2, b)) proof
    fix a
    assume hao hfa
    have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
    have inc: int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE))
      by arith(expand(hfa, mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK), ks)
    have hin: mallocng.in_range(a, pair(c.ctx, mallocng.CTX_SIZE)) by defs(simp(inc), mallocng.in_range)
    have hn := apply(mp.ctx_noarea[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, brk := vm.brk, a := a], hc, hu, ha, H, hao, hin)
    have {nx = nx} := apply(mp.tk_noarea, P, hao, hn)
    have e := apply(mp.take_fp[c := c, A := A, A2 := A2, b := b, x := x, a := a], tl, xo, fpr, em, es, eu, etk, nx)
    show by taut(e)
  qed
  have f1 := apply(mp.free_rw_mem[c := c, vm := vm, F1 := mallocng.footprint(c, A, b), F2 := mallocng.footprint(c, A2, b)], hfr, fm)
  have f2 := apply(mp.free_rw_pages[c := c, vm := vm, vm2 := V1, F := mallocng.footprint(c, A2, b)], f1, ep)
  have gu: all g. g in omega -> mallocng.is_used(A2, g) -> mallocng.is_used(A, g) && mallocng.group_range(A2.metas[g]) = mallocng.group_range(A.metas[g]) proof
    fix g
    assume _ h
    have iu: mallocng.is_used(A, g) by defs(rewrite(eu, expand(h, mallocng.is_used)), mallocng.is_used)
    have gr: mallocng.group_range(A2.metas[g]) = mallocng.group_range(A.metas[g]) := rewrite(em, refl({mallocng.group_range(A2.metas[g])}), {2})
    show by taut(iu, gr)
  qed
  have r2 := apply(mp.holds_rw[c := c, A := A, A2 := A2, vm := vm, vm2 := V1, b := b], hc, hu, ha, hh, ep, gu)
  show by defs(taut(h2, m2, f2, r2), mallocng.holds_in)
qed

// The area's next meta taken: such a step (its writes the count and next
// meta words, the free list as before)
theorem mp.tav_tk(c, A, vm, V1, b): mp.tavpre(c, A, vm, V1, b) ->
  mp.tkpre(c, A, A.free_metas, int_sub(A.avail_cnt, 1), mp.anext(A), vm, V1, b)
proof
  assume P
  have {hc = cfg, hu = univ, ha = abs, hb = blocks, hv = vm, hv1 = v1, hh = holds, hk = cnt, hby = bytes, ep = pages, rest = rest} := P
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {hpt = part} := expand(H, mallocng.holds)
  have {tk = taken, fr0 = fresh} := expand(hpt, mallocng.metas_partition)
  have {xs = slot, cle = le, len = len, eu = used, eal = areas, efr = free, eac = cnt, etk = taken} := apply(mp.tav_basic, P)
  have ko: A.avail_cnt in omega by simp(ha)
  have cs: mallocng.AREA_HDR = 24 && mallocng.META_SIZE = 40 && mallocng.NSLOTS = 101 by defs(simp(), mallocng.AREA_HDR, mallocng.META_SIZE, mallocng.NSLOTS)
  have j0o: int_sub(mallocng.NSLOTS, A.avail_cnt) in omega by arith(ko, cle, cs)
  have j0l: int_lt(int_sub(mallocng.NSLOTS, A.avail_cnt), mallocng.NSLOTS) by arith(ko, hk, cs)
  have xnu _ := mp(all_elim(fr0, {int_sub(mallocng.NSLOTS, A.avail_cnt)}), j0o, taut(len, (int_le(int_sub(mallocng.NSLOTS, A.avail_cnt), int_sub(mallocng.NSLOTS, A.avail_cnt)) by arith(j0o)), j0l))
  // (x available: no taken one -- those never are)
  have xe1: ex x0. x0 in omega && ((int_le(int_sub(mallocng.NSLOTS, A.avail_cnt), x0) && int_lt(x0, mallocng.NSLOTS)) &&
      mp.anext(A) = mallocng.meta_at(A.areas[int_sub(seq_len(A.areas), 1)], x0))
    by ex_intro({int_sub(mallocng.NSLOTS, A.avail_cnt)}, taut(j0o, (int_le(int_sub(mallocng.NSLOTS, A.avail_cnt), int_sub(mallocng.NSLOTS, A.avail_cnt)) by arith(j0o)), j0l,
      refl({mp.anext(A)})))
  have xa: mallocng.avail_meta(A, mp.anext(A)) by defs(taut(len, xe1), mallocng.avail_meta)
  have xnt: mp.untaken(A, mp.anext(A)) proof
    fix i
    assume hi hil
    have _ _ na _ _ := mp(all_elim(tk, {i}), hi, hil)
    assume e
    show by taut(na, rewrite(sym(e), xa))
  qed
  have fl: A.free_metas in list_type(omega) by simp(ha)
  have km: int_sub(A.avail_cnt, 1) in omega by arith(ko, hk)
  have kml: int_le(int_sub(A.avail_cnt, 1), mallocng.NSLOTS) by arith(cle, hk)
  have hby2: all y. y in bits(64) -> !mp.tkbyte(c, A, y) -> V1.bytes[y] = vm.bytes[y] proof
    fix y
    assume hy hn
    have nw: !(int_le(int_add(c.ctx, 24), y) && int_lt(y, int_add(c.ctx, 40))) proof
      assume hw
      have hw1 hw2 := hw
      show by taut(hn, (mp.tkbyte(c, A, y) by defs(taut((int_le(int_add(c.ctx, 16), y) && int_lt(y, int_add(c.ctx, 40)) by arith(hw1, hw2))), mp.tkbyte)))
    qed
    show := mp(all_elim(hby, {y}), hy, nw)
  qed
  have pt2 := apply(mp.part_avail[A := A, A2 := mp.tav(A), x := mp.anext(A)], ha, hpt, hk, cle, len, eu, eal, efr, eac, etk, refl({mp.anext(A)}))
  have cok := apply(mp.tav_ctx, P)
  have {k4 = avail_cnt, k6 = avail_meta, k10 = free_metas} := expand(cok, mallocng.ctx_ok)
  have kl: mallocng.cyclic(mallocng.mview(V1, mallocng.held(c, mp.tav(A), b)), mallocng.ctx_word(c, mallocng.mview(V1, mallocng.held(c, mp.tav(A), b)), mallocng.C_FREE_META), A.free_metas)
    by simp(k10)
  have kc: mallocng.ctx_word(c, mallocng.mview(V1, mallocng.held(c, mp.tav(A), b)), mallocng.C_AVAIL_CNT) = int_sub(A.avail_cnt, 1) by simp(k4)
  have kn: int_lt(0, int_sub(A.avail_cnt, 1)) -> ord_lt(0, seq_len(A.areas)) &&
      mallocng.ctx_word(c, mallocng.mview(V1, mallocng.held(c, mp.tav(A), b)), mallocng.C_AVAIL_META) =
        mallocng.meta_at(A.areas[int_sub(seq_len(A.areas), 1)], int_sub(mallocng.NSLOTS, int_sub(A.avail_cnt, 1))) by simp(k6)
  show by taut(hc, hu, ha, hb, hv, hv1, hh, xs, xnu, xnt, fl, km, kml, hby2, ep, rest, pt2, kl, kc, kn)
qed

// ... the invariant kept
theorem mp.tav_holds_in(c, A, vm, V1, b): mp.tavpre(c, A, vm, V1, b) -> mallocng.holds_in(c, mp.tav(A), V1, b)
proof
  assume P
  show := apply(mp.tk_holds_in, apply(mp.tav_tk, P))
qed

// The free metas' head taken (dequeue_head of the context's list): such a
// step (its writes the list's head word and links, the count and next
// meta as before)
theorem mp.tfr_tk(c, A, vm, V1, b, objs): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  vm in x86_64_linux.Vm -> V1 in x86_64_linux.Vm -> mallocng.holds_in(c, A, vm, b) -> int_mod(c.ctx, 8) = 0 -> int_lt(0, seq_len(A.free_metas)) ->
  mallocng_specs.dequeued(vm, V1, objs, int_add(c.ctx, 16), A.free_metas[0]) ->
  mp.tkpre(c, A, mallocng_specs.rm_at(A.free_metas, 0), A.avail_cnt, A.free_metas[0], vm, V1, b)
proof
  assume hc hu ha hb hv hv1 hh cal hn hdq
  let F := A.free_metas
  let x := A.free_metas[0]
  let R := mallocng_specs.rm_at(A.free_metas, 0)
  let A2 := mp.take(A, mallocng_specs.rm_at(A.free_metas, 0), A.avail_cnt, A.free_metas[0])
  let PH := int_add(c.ctx, 16)
  let M := mallocng.mview(vm, mallocng.held(c, A, b))
  let M2 := mallocng.mview(V1, mallocng.held(c, A2, b))
  have {H = inv, hm = mapped} := expand(hh, mallocng.holds_in)
  have {cok = ctx, hpt = part} := expand(H, mallocng.holds)
  have {k4 = avail_cnt, k5 = avail_le, k6 = avail_meta, k10 = free_metas} := expand(cok, mallocng.ctx_ok)
  have {fs = free_slots} := expand(hpt, mallocng.metas_partition)
  have vb: vm.bytes in fn_space(bits(64), bits(8)) by simp(hv)
  have vb2: V1.bytes in fn_space(bits(64), bits(8)) by simp(hv1)
  have fl: F in list_type(omega) by simp(ha)
  have tl: A.taken in list_type(omega) by simp(ha)
  have ko: A.avail_cnt in omega by simp(ha)
  have nle: int_le(A.avail_cnt, mallocng.NSLOTS) by simp(k5)
  have co: c.ctx in omega by simp(hc)
  have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  have kf: mallocng.C_FREE_META = 16 by defs(refl({16}), mallocng.C_FREE_META)
  have p64: int_pow(2, 64) = 18446744073709551616 by simp()
  // (the context below 2^64: its last byte the allocator's)
  have cf := apply(mp.ctx_fp[c := c, A := A, vm := vm, b := b, a := int_add(c.ctx, 927)], hc, hu, ha, hh, arith(co), arith(co), arith(co, ks))
  have clo := apply(mp.fp_low[c := c, A := A, vm := vm, b := b, a := int_add(c.ctx, 927)], hm, cf)
  have pho: PH in omega by arith(co)
  have phb: PH in bits(64) by arith(co, clo)
  // the free metas: meta slots, not in use, not taken -- the list as
  // dequeue has it
  have hsl: all i. i in omega -> int_lt(i, seq_len(F)) -> mallocng.meta_slot(A, F[i]) && mp.untaken(A, F[i]) proof
    fix i
    assume hi hil
    have ms _ := mp(all_elim(fs, {i}), hi, hil)
    show by taut(ms, apply(mp.free_untaken, H, hi, hil))
  qed
  have la := apply(mp.ctx_list[c := c, A := A, vm := vm, b := b, objs := objs, off := 16, L := F], hc, hu, ha, vb, hh, cal, simp(), simp(), arith(), fl, hsl, rewrite(kf, k10))
  have r1 _ _ only := mp(all_elim(expand(hdq, mallocng_specs.dequeued), {F}, {0}), conj(fl, (0 in omega by simp())), taut(la, hn, refl({x})))
  have {rml = len, rmt = type} := apply(mp.rm_at_app[l := F, k := 0, j := 0], fl, simp(), hn)
  have el: all j. j in omega -> int_lt(j, seq_len(R)) -> R[j] = F[int_add(j, 1)] proof
    fix j
    assume hj hjl
    have {re = elem} := apply(mp.rm_at_app[l := F, k := 0, j := j], fl, simp(), hn)
    have e := mp(re, hj, rewrite(rml, hjl))
    show by simp(e, hj)
  qed
  have _ dst _ := expand(k10, mallocng.cyclic)
  have hd: all i. all j. i in omega -> j in omega -> int_lt(i, seq_len(F)) -> int_lt(j, seq_len(F)) -> F[i] = F[j] -> i = j proof
    fix i j
    assume hi hj hil hjl he
    show := mp(all_elim(dst, {i}, {j}), conj(hi, hj), taut(hil, hjl, he))
  qed
  // x: the head
  have xs xnt := mp(all_elim(hsl, {0}), simp(), hn)
  have _ xnu := mp(all_elim(fs, {0}), simp(), hn)
  have {xo = nat, xout = out} := apply(mp.slot_meta[c := c, A := A, vm := vm, b := b, g := x], hc, hu, ha, hh, xs, xnt)
  // the new state's parts
  have fpr: mallocng.fp_ranges(c, A2) = mallocng.fp_ranges(c, A) by defs(simp(), mallocng.fp_ranges, mallocng.fixed_ranges, mallocng.auxv_ranges)
  have em: A2.metas = A.metas by simp()
  have es: A2.slots = A.slots by simp()
  have eu: A2.used = A.used by simp()
  have etk: A2.taken = seq_concat(A.taken, seq_one(x)) by simp()
  have pt2 := apply(mp.part_free[A := A, A2 := A2, x := x], ha, hpt, hn, hd, eu, simp(), simp(), simp(), etk, refl({x}))
  // the bytes written: the head word, the free metas' links
  have fo lo := expand(only, mallocng_specs.links_only)
  have up := mp(app_update_other[f := V1, k := "bytes", v := vm.bytes, x := "pages"], (!("pages" = "bytes") by simp()))
  have ep: V1.pages = vm.pages by taut(sym(rewrite(fo, up)))
  have hby: all y. y in bits(64) -> !mp.tkbyte(c, A, y) -> V1.bytes[y] = vm.bytes[y] proof
    fix y
    assume hy hnt
    have yo: y in omega by arith(hy)
    have yl: int_lt(y, int_pow(2, 64)) by arith(hy)
    have oh: !(int_le(PH, y) && int_lt(y, int_add(PH, 8))) proof
      assume w
      have w1 w2 := w
      show by taut(hnt, (mp.tkbyte(c, A, y) by defs(taut((int_le(int_add(c.ctx, 16), y) && int_lt(y, int_add(c.ctx, 40)) by arith(w1, w2))), mp.tkbyte)))
    qed
    have on: all i. i in omega -> int_lt(i, seq_len(F)) -> !(int_le(F[i], y) && int_lt(y, int_add(F[i], 16))) proof
      fix i
      assume hi hil
      assume w
      have ms nu := mp(all_elim(fs, {i}), hi, hil)
      have ex1: ex l. (mallocng.meta_slot(A, l) && !mallocng.is_used(A, l)) && (int_le(l, y) && int_lt(y, int_add(l, 16))) by ex_intro({F[i]}, taut(ms, nu, w))
      show by taut(hnt, (mp.tkbyte(c, A, y) by defs(taut(ex1), mp.tkbyte)))
    qed
    have bb := mp(all_elim(lo, {y}), yo, taut(yl, oh, on))
    have bi := mp(bits_of_int_small[n := 64, a := y], yo, (int_lt(y, pow2(64)) by arith(hy)))
    show := rewrite(bi, bb)
  qed
  // the count and next meta words: not written, so as before
  have cag: all a. a in omega -> int_le(int_add(c.ctx, 24), a) -> int_lt(a, int_add(c.ctx, 40)) -> M2[a] = M[a] proof
    fix a
    assume hao h1 h2
    have oh: !(int_le(PH, a) && int_lt(a, int_add(PH, 8))) by arith(h1)
    have on: all i. i in omega -> int_lt(i, seq_len(F)) -> !(int_le(F[i], a) && int_lt(a, int_add(F[i], 16))) proof
      fix i
      assume hi hil
      have ms nt := mp(all_elim(hsl, {i}), hi, hil)
      have {fo2 = out} := apply(mp.slot_meta[c := c, A := A, vm := vm, b := b, g := F[i]], hc, hu, ha, hh, ms, nt)
      show by arith(fo2, ks, h1, h2)
    qed
    have bb := mp(all_elim(lo, {a}), hao, taut((int_lt(a, int_pow(2, 64)) by arith(h2, co, clo)), oh, on))
    have nx: !(int_le(x, a) && int_lt(a, int_add(x, 40))) by arith(xout, ks, h1, h2)
    show := apply(mp.take_agree[c := c, A := A, A2 := A2, vm := vm, V1 := V1, b := b, x := x, a := a], tl, xo, hao, fpr, em, es, eu, etk, nx, bb,
      (V1.pages[int_div(a, x86_64_linux.PAGE)] = vm.pages[int_div(a, x86_64_linux.PAGE)] by simp(ep)))
  qed
  have g24: all i. i in omega -> int_lt(i, 8) -> M2[int_add(int_add(c.ctx, 24), i)] = M[int_add(int_add(c.ctx, 24), i)] proof
    fix i
    assume hi hil
    show := mp(all_elim(cag, {int_add(int_add(c.ctx, 24), i)}), arith(co, hi), arith(co, hi), arith(co, hi, hil))
  qed
  have g32: all i. i in omega -> int_lt(i, 8) -> M2[int_add(int_add(c.ctx, 32), i)] = M[int_add(int_add(c.ctx, 32), i)] proof
    fix i
    assume hi hil
    show := mp(all_elim(cag, {int_add(int_add(c.ctx, 32), i)}), arith(co, hi), arith(co, hi), arith(co, hi, hil))
  qed
  have w24 := apply(mp.agree_rd[M := M, M2 := M2, a := int_add(c.ctx, 24), n := 8], simp(), g24)
  have w32 := apply(mp.agree_rd[M := M, M2 := M2, a := int_add(c.ctx, 32), n := 8], simp(), g32)
  have we24: mallocng.ctx_word(c, M2, mallocng.C_AVAIL_META) = mallocng.ctx_word(c, M, mallocng.C_AVAIL_META) by defs(w24, mallocng.ctx_word, mallocng.C_AVAIL_META)
  have we32: mallocng.ctx_word(c, M2, mallocng.C_AVAIL_CNT) = mallocng.ctx_word(c, M, mallocng.C_AVAIL_CNT) by defs(w32, mallocng.ctx_word, mallocng.C_AVAIL_CNT)
  have kc := trans(we32, k4)
  have kn: int_lt(0, A.avail_cnt) -> ord_lt(0, seq_len(A.areas)) &&
      mallocng.ctx_word(c, M2, mallocng.C_AVAIL_META) = mallocng.meta_at(A.areas[int_sub(seq_len(A.areas), 1)], int_sub(mallocng.NSLOTS, A.avail_cnt))
    by simp(rewrite(sym(we24), k6))
  // the list: as dequeue left it, read through the new view (its head word
  // the context's, its links the free metas' records -- not x's)
  have {lkd = linked} := expand(r1, mallocng_specs.list_at)
  have _ dst2 _ := expand(lkd, mallocng.cyclic)
  have {hd2 = head} := apply(mp.list_rd[vm := V1, objs := objs, phead := PH, l := R, i := 0], vb2, phb, rmt, r1)
  have phf: all i. i in omega -> int_lt(i, 8) -> int_add(PH, i) in mallocng.held(c, A2, b) proof
    fix i
    assume hi hil
    have nf: !mallocng.ctx_free(c, int_add(PH, i)) by defs(arith(hi, hil, co), mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK)
    have q _ _ := apply(mp.ctx_acc[c := c, A := A, vm := vm, b := b, a := int_add(PH, i)], hc, hu, ha, hh, arith(co, hi), arith(co, hi), arith(co, ks, hi, hil), nf)
    have th := apply(mp.take_held[c := c, A := A, A2 := A2, b := b, x := x, a := int_add(PH, i)], tl, xo, fpr, em, es, eu, etk, (!(int_le(x, int_add(PH, i)) && int_lt(int_add(PH, i), int_add(x, 40))) by arith(xout, ks, co, hi, hil)))
    show by taut(q, th)
  qed
  have rh := apply(mp.view_read[vm := V1, fp := mallocng.held(c, A2, b), a := PH, n := 8], pho, simp(), simp(), phf)
  have hdw: mallocng.ctx_word(c, M2, mallocng.C_FREE_META) = ite(seq_len(R) = 0, 0, R[0]) by defs(trans(sym(rh), hd2), mallocng.ctx_word, mallocng.C_FREE_META)
  have lk2: all i. i in omega -> int_lt(i, seq_len(R)) ->
      mallocng.rd(M2, int_add(R[i], 8), 8) = R[int_mod(int_add(i, 1), seq_len(R))] &&
      mallocng.rd(M2, R[i], 8) = R[int_mod(int_sub(int_add(i, seq_len(R)), 1), seq_len(R))] proof
    fix i
    assume hi hil
    have e := mp(all_elim(el, {i}), hi, hil)
    have i1o: int_add(i, 1) in omega by simp(hi)
    have i1l: int_lt(int_add(i, 1), seq_len(F)) by arith(hil, rml, hi)
    have ms0 nt0 := mp(all_elim(hsl, {int_add(i, 1)}), i1o, i1l)
    have ms := rewrite(sym(e), ms0)
    have nt := rewrite(sym(e), nt0)
    have ne: !(R[i] = x) proof
      assume h
      have z := mp(all_elim(hd, {int_add(i, 1)}, {0}), i1o, simp(), i1l, hn, trans(sym(e), h))
      show by arith(z, hi)
    qed
    have {go = nat, acc = acc} := apply(mp.slot_meta[c := c, A := A, vm := vm, b := b, g := R[i]], hc, hu, ha, hh, ms, nt)
    have inh: all a. a in omega -> int_le(R[i], a) -> int_lt(a, int_add(R[i], 16)) -> a in mallocng.held(c, A2, b) proof
      fix a
      assume hao h1 h2
      have q _ _ := mp(all_elim(acc, {a}), hao, h1, arith(h2))
      have nx := apply(mp.meta_disj[c := c, A := A, M := M, b := b, brk := vm.brk, g := x, l := R[i], a := a], hc, hu, ha, H, xs, ms, ne, hao, h1, arith(h2))
      have th := apply(mp.take_held[c := c, A := A, A2 := A2, b := b, x := x, a := a], tl, xo, fpr, em, es, eu, etk, nx)
      show by taut(q, th)
    qed
    have in8: all j. j in omega -> int_lt(j, 8) -> int_add(int_add(R[i], 8), j) in mallocng.held(c, A2, b) proof
      fix j
      assume hj hjl
      show := mp(all_elim(inh, {int_add(int_add(R[i], 8), j)}), arith(go, hj), arith(go, hj), arith(go, hj, hjl))
    qed
    have in0: all j. j in omega -> int_lt(j, 8) -> int_add(R[i], j) in mallocng.held(c, A2, b) proof
      fix j
      assume hj hjl
      show := mp(all_elim(inh, {int_add(R[i], j)}), arith(go, hj), arith(go, hj), arith(go, hj, hjl))
    qed
    have r8 := apply(mp.view_read[vm := V1, fp := mallocng.held(c, A2, b), a := int_add(R[i], 8), n := 8], arith(go), simp(), simp(), in8)
    have r0 := apply(mp.view_read[vm := V1, fp := mallocng.held(c, A2, b), a := R[i], n := 8], go, simp(), simp(), in0)
    have {lks = links} := apply(mp.list_rd[vm := V1, objs := objs, phead := PH, l := R, i := i], vb2, phb, rmt, r1)
    have l8 l0 := mp(lks, hi, hil)
    show by taut(trans(sym(r8), l8), trans(sym(r0), l0))
  qed
  have cy2: mallocng.cyclic(M2, mallocng.ctx_word(c, M2, mallocng.C_FREE_META), R) by defs(taut(hdw, dst2, lk2), mallocng.cyclic)
  show by taut(hc, hu, ha, hb, hv, hv1, hh, xs, xnu, xnt, rmt, ko, nle, hby, ep, fo, pt2, cy2, kc, kn)
qed

// ... the invariant kept
theorem mp.tfr_holds_in(c, A, vm, V1, b, objs): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  vm in x86_64_linux.Vm -> V1 in x86_64_linux.Vm -> mallocng.holds_in(c, A, vm, b) -> int_mod(c.ctx, 8) = 0 -> int_lt(0, seq_len(A.free_metas)) ->
  mallocng_specs.dequeued(vm, V1, objs, int_add(c.ctx, 16), A.free_metas[0]) ->
  mallocng.holds_in(c, mp.take(A, mallocng_specs.rm_at(A.free_metas, 0), A.avail_cnt, A.free_metas[0]), V1, b)
proof
  assume hc hu ha hb hv hv1 hh cal hn hdq
  show := apply(mp.tk_holds_in, apply(mp.tfr_tk, hc, hu, ha, hb, hv, hv1, hh, cal, hn, hdq))
qed
