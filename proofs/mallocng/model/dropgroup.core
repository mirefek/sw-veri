// A group given back (free's free_group): out of the groups in use, its
// meta taken (until free_meta returns it), its slots none; a nested group's
// slot in its container reserved (given back in turn by nontrivial_free).
// The invariant kept.

// ----------------------------------------------------------------------
//  The abstract step
abbrev mp.nosl() := fn_build(0, i. tag(0, empty))

abbrev mp.drop(A, g, k) := fn_update(fn_update(fn_update(fn_update(A, "used", mallocng_specs.rm_at(A.used, k)), "taken", seq_concat(A.taken, seq_one(g))),
  "metas", fn_update(A.metas, g, mallocng.ZERO_META)), "slots", fn_update(A.slots, g, mp.nosl()))

theorem mp.drop_type(A, g, k): A in mallocng.Abs -> mallocng.normal(A) -> k in omega -> int_lt(k, seq_len(A.used)) -> g in omega ->
  abs: mp.drop(A, g, k) in mallocng.Abs && univ: mp.drop(A, g, k) in univ(1)
proof
  assume ha hn hk hkl hg
  let K := insert("secret", insert("init_done", insert("auxv_at", insert("auxv", insert("areas", insert("avail_cnt", insert("reserve", insert("reserve_cnt", insert("free_metas", insert("used", insert("metas", insert("active", insert("slots", insert("brk", insert("taken", empty)))))))))))))))
  let U := mallocng_specs.rm_at(A.used, k)
  let T := seq_concat(A.taken, seq_one(g))
  let MS := fn_update(A.metas, g, mallocng.ZERO_META)
  let SL := fn_update(A.slots, g, mp.nosl())
  let A1 := fn_update(A, "used", U)
  let A2 := fn_update(A1, "taken", T)
  let A3 := fn_update(A2, "metas", MS)
  have ap af ad := (A in powerset(cart(K, univ(1))) && is_fun(A) && dom(A) = K by simp(expand(ha, mallocng.Abs)))
  have ul: A.used in list_type(omega) by simp(ha)
  have tl: A.taken in list_type(omega) by simp(ha)
  have {ut = type} := apply(mp.rm_at_app[l := A.used, k := k, j := 0], ul, hk, hkl)
  have gl := mp(all_elim(tr.seq_one_type, {g}, {omega}), hg)
  have tt: T in list_type(omega) := mp(all_elim(tr.concat_list, {A.taken}, {seq_one(g)}, {omega}), tl, gl)
  have lu := apply(mp.list_univ, omega_univ)
  have uu: U in univ(1) := mp(mp(univ_trans[u := 1, a := U, b := list_type(omega)], lu), ut)
  have tu: T in univ(1) := mp(mp(univ_trans[u := 1, a := T, b := list_type(omega)], lu), tt)
  // (the zero meta: meta 0's, never in use)
  have {nu = unused, nz = zero} := expand(hn, mallocng.normal)
  have z0 _ := mp(all_elim(nu, {0}), simp(), nz)
  have ms: A.metas in fn_space(omega, mallocng.MetaV) by simp(ha)
  have zv: mallocng.ZERO_META in mallocng.MetaV := rewrite(z0, mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A.metas, x := 0], ms, simp()))
  have mss := apply(mp.space_upd[a := omega, b := mallocng.MetaV, f := A.metas, k := g, v := mallocng.ZERO_META], ms, hg, zv)
  have msu := mp(fn_space_univ[u := 1, a := omega, b := mallocng.MetaV, f := MS], omega_univ, mp.metav_univ, mss)
  // (no slots: a list of uses)
  have r0: tag(0, empty) in set_image(single(empty), x0. tag(0, x0)) by taut(set_image_def[s := single(empty), f := x0. tag(0, x0), y := tag(0, empty)],
    (ex x0. x0 in single(empty) && tag(0, x0) = tag(0, empty) by ex_intro({empty}, taut(single_intro[a := empty], refl({tag(0, empty)})))))
  have u0: tag(0, empty) in mallocng.Use by defs(simp(r0), mallocng.Use)
  have nl: mp.nosl() in list_type(mallocng.Use) := apply(build_list[d := 0, v := i. tag(0, empty), t := mallocng.Use], simp(),
    (all i. i in 0 -> tag(0, empty) in mallocng.Use by simp(u0)))
  have ss: A.slots in fn_space(omega, list_type(mallocng.Use)) by simp(ha)
  have sls := apply(mp.space_upd[a := omega, b := list_type(mallocng.Use), f := A.slots, k := g, v := mp.nosl()], ss, hg, nl)
  have luu := mp(mp.list_univ[t := mallocng.Use], mp.use_univ)
  have slu := mp(fn_space_univ[u := 1, a := omega, b := list_type(mallocng.Use), f := SL], omega_univ, luu, sls)
  have p1 := apply(mp.pow_upd[K := K, B := univ(1), r := A, k := "used", v := U], ap, simp(), uu)
  have f1 d1 := mp(fn_update_fd[f := A, k := "used", v := U, d := K], af, ad, simp())
  have p2 := apply(mp.pow_upd[K := K, B := univ(1), r := A1, k := "taken", v := T], p1, simp(), tu)
  have f2 d2 := mp(fn_update_fd[f := A1, k := "taken", v := T, d := K], f1, d1, simp())
  have p3 := apply(mp.pow_upd[K := K, B := univ(1), r := A2, k := "metas", v := MS], p2, simp(), msu)
  have f3 d3 := mp(fn_update_fd[f := A2, k := "metas", v := MS, d := K], f2, d2, simp())
  have p4 := apply(mp.pow_upd[K := K, B := univ(1), r := A3, k := "slots", v := SL], p3, simp(), slu)
  have f4 d4 := mp(fn_update_fd[f := A3, k := "slots", v := SL, d := K], f3, d3, simp())
  have au := mp(rec_univ[u := 1, k := K, r := A], simp(x86.insert_univ), ap, af, ad)
  have a4: mp.drop(A, g, k) in mallocng.Abs by defs(simp(p4, f4, d4, ut, tt, mss, sls, uu, tu, msu, slu, au, expand(ha, mallocng.Abs)), mallocng.Abs)
  have u4 := mp(rec_univ[u := 1, k := K, r := mp.drop(A, g, k)], simp(x86.insert_univ), p4, f4, d4)
  show by taut(a4, u4)
qed

// (the groups in use after: those before but g -- the used list sorted, so
// g only at its index)
theorem mp.drop_used(A, g, k, h): A in mallocng.Abs -> mallocng.metas_partition(A) -> k in omega -> int_lt(k, seq_len(A.used)) -> A.used[k] = g ->
  (mallocng.is_used(mp.drop(A, g, k), h) <-> mallocng.is_used(A, h) && !(h = g))
proof
  assume ha hp hk hkl hkg
  have {hs = sorted} := expand(hp, mallocng.metas_partition)
  have ul: A.used in list_type(omega) by simp(ha)
  have lo: seq_len(A.used) in omega by arith(ul)
  have eu: mp.drop(A, g, k).used = mallocng_specs.rm_at(A.used, k) by simp()
  have {ln = len} := apply(mp.rm_at_app[l := A.used, k := k, j := 0], ul, hk, hkl)
  have d1: mallocng.is_used(mp.drop(A, g, k), h) -> mallocng.is_used(A, h) && !(h = g) proof
    assume hu
    obtain j, hj hjl hje from expand(hu, mallocng.is_used)
    have jl: int_lt(j, int_sub(seq_len(A.used), 1)) := rewrite(ln, rewrite(eu, hjl))
    have {el = elem} := apply(mp.rm_at_app[l := A.used, k := k, j := j], ul, hk, hkl)
    have e := mp(el, hj, jl)
    let I := ite(int_lt(j, k), j, int_add(j, 1))
    have ca: int_lt(j, k) -> I in omega && int_lt(I, seq_len(A.used)) && !(I = k) proof
      assume l
      have e1: I = j by simp(l)
      show by taut(rewrite(sym(e1), (j in omega && int_lt(j, seq_len(A.used)) && !(j = k) by arith(hj, jl, lo, l))))
    qed
    have cb: !int_lt(j, k) -> I in omega && int_lt(I, seq_len(A.used)) && !(I = k) proof
      assume l
      have e1: I = int_add(j, 1) by simp(l)
      show by taut(rewrite(sym(e1), (int_add(j, 1) in omega && int_lt(int_add(j, 1), seq_len(A.used)) && !(int_add(j, 1) = k) by arith(hj, jl, lo, l, hk))))
    qed
    have io1 io2 io3 := (I in omega && int_lt(I, seq_len(A.used)) && !(I = k) by taut(ca, cb))
    have hu0: A.used[I] = h := trans(sym(e), rewrite(eu, hje))
    have u1: mallocng.is_used(A, h) by defs(ex_intro({I}, taut(io1, io2, hu0)), mallocng.is_used)
    // (two indices, two metas: sorted)
    have ne: !(h = g) proof
      assume e2
      have eq: A.used[I] = A.used[k] := trans(hu0, trans(e2, sym(hkg)))
      have c1: int_lt(I, k) -> false proof
        assume l
        show by arith(apply(mp.asc_lt[l := A.used, i := I, j := k], ul, hs, io1, hk, l, hkl), eq)
      qed
      have c2: int_lt(k, I) -> false proof
        assume l
        show by arith(apply(mp.asc_lt[l := A.used, i := k, j := I], ul, hs, hk, io1, l, io2), eq)
      qed
      show by taut(c1, c2, (int_lt(I, k) || int_lt(k, I) by arith(io1, hk, io3)))
    qed
    show by taut(u1, ne)
  qed
  have d2: mallocng.is_used(A, h) && !(h = g) -> mallocng.is_used(mp.drop(A, g, k), h) proof
    assume q
    have hu ne := q
    obtain i, hi hil hie from expand(hu, mallocng.is_used)
    have ik: !(i = k) proof
      assume e
      show by taut(ne, trans(sym(hie), rewrite(sym(e), hkg)))
    qed
    let J := ite(int_lt(i, k), i, int_sub(i, 1))
    have ca: int_lt(i, k) -> (J in omega && int_lt(J, int_sub(seq_len(A.used), 1))) && ite(int_lt(J, k), J, int_add(J, 1)) = i proof
      assume l
      have e1: J = i by simp(l)
      have lJ: int_lt(J, k) by arith(e1, l)
      have r: ite(int_lt(J, k), J, int_add(J, 1)) = i by simp(lJ, e1)
      have jo: J in omega && int_lt(J, int_sub(seq_len(A.used), 1)) by arith(e1, hi, l, hkl, lo)
      show by taut(jo, r)
    qed
    have cb: !int_lt(i, k) -> (J in omega && int_lt(J, int_sub(seq_len(A.used), 1))) && ite(int_lt(J, k), J, int_add(J, 1)) = i proof
      assume l
      have e1: J = int_sub(i, 1) by simp(l)
      have nlJ: !int_lt(J, k) by arith(e1, l, ik, hi, hk)
      have j1: int_add(J, 1) = i by arith(e1, hi, l, ik, hk)
      have r: ite(int_lt(J, k), J, int_add(J, 1)) = i by simp(nlJ, j1)
      have jo: J in omega && int_lt(J, int_sub(seq_len(A.used), 1)) by arith(e1, hi, hil, l, ik, hk, lo)
      show by taut(jo, r)
    qed
    have jo1 jo2 back := ((J in omega && int_lt(J, int_sub(seq_len(A.used), 1))) && ite(int_lt(J, k), J, int_add(J, 1)) = i by taut(ca, cb))
    have {el = elem} := apply(mp.rm_at_app[l := A.used, k := k, j := J], ul, hk, hkl)
    have e := mp(el, jo1, jo2)
    have e2: mallocng_specs.rm_at(A.used, k)[J] = h := trans(rewrite(back, e), hie)
    show by defs(ex_intro({J}, taut(jo1, rewrite(sym(eu), rewrite(sym(ln), jo2)), rewrite(sym(eu), e2))), mallocng.is_used)
  qed
  show by taut(d1, d2)
qed

// (a sorted list less one element: sorted)
theorem mp.rm_sorted(l, k): l in list_type(omega) -> k in omega -> int_lt(k, seq_len(l)) ->
  (all j. j in omega -> int_lt(int_add(j, 1), seq_len(l)) -> int_lt(l[j], l[int_add(j, 1)])) ->
  all j. j in omega -> int_lt(int_add(j, 1), seq_len(mallocng_specs.rm_at(l, k))) -> int_lt(mallocng_specs.rm_at(l, k)[j], mallocng_specs.rm_at(l, k)[int_add(j, 1)])
proof
  assume hl hk hkl hs
  fix j
  assume hj hjl
  have lo: seq_len(l) in omega by arith(hl)
  have {ln = len} := apply(mp.rm_at_app[l := l, k := k, j := 0], hl, hk, hkl)
  have jl: int_lt(int_add(j, 1), int_sub(seq_len(l), 1)) := rewrite(ln, hjl)
  have {e0 = elem} := apply(mp.rm_at_app[l := l, k := k, j := j], hl, hk, hkl)
  have {e1 = elem} := apply(mp.rm_at_app[l := l, k := k, j := int_add(j, 1)], hl, hk, hkl)
  have a0 := mp(e0, hj, arith(jl))
  have a1 := mp(e1, simp(hj), jl)
  // (the indices in l: increasing)
  have c1: int_lt(int_add(j, 1), k) -> int_lt(mallocng_specs.rm_at(l, k)[j], mallocng_specs.rm_at(l, k)[int_add(j, 1)]) proof
    assume h
    have hjk: int_lt(j, k) by arith(h)
    have i0: ite(int_lt(j, k), j, int_add(j, 1)) = j by simp(hjk)
    have i1: ite(int_lt(int_add(j, 1), k), int_add(j, 1), int_add(int_add(j, 1), 1)) = int_add(j, 1) by simp(h)
    have lt := apply(mp.asc_lt[l := l, i := j, j := int_add(j, 1)], hl, hs, hj, simp(hj), arith(), arith(jl, lo))
    show by simp(a0, a1, i0, i1, lt)
  qed
  have c2: int_lt(j, k) && !int_lt(int_add(j, 1), k) -> int_lt(mallocng_specs.rm_at(l, k)[j], mallocng_specs.rm_at(l, k)[int_add(j, 1)]) proof
    assume h
    have h1 h2 := h
    have i0: ite(int_lt(j, k), j, int_add(j, 1)) = j by simp(h1)
    have i1: ite(int_lt(int_add(j, 1), k), int_add(j, 1), int_add(int_add(j, 1), 1)) = int_add(int_add(j, 1), 1) by simp(h2)
    have lt := apply(mp.asc_lt[l := l, i := j, j := int_add(int_add(j, 1), 1)], hl, hs, hj, simp(hj), arith(), arith(jl, lo))
    show by simp(a0, a1, i0, i1, lt)
  qed
  have c3: !int_lt(j, k) -> int_lt(mallocng_specs.rm_at(l, k)[j], mallocng_specs.rm_at(l, k)[int_add(j, 1)]) proof
    assume h
    have h2: !int_lt(int_add(j, 1), k) by arith(h)
    have i0: ite(int_lt(j, k), j, int_add(j, 1)) = int_add(j, 1) by simp(h)
    have i1: ite(int_lt(int_add(j, 1), k), int_add(j, 1), int_add(int_add(j, 1), 1)) = int_add(int_add(j, 1), 1) by simp(h2)
    have lt := apply(mp.asc_lt[l := l, i := int_add(j, 1), j := int_add(int_add(j, 1), 1)], hl, hs, simp(hj), simp(hj), arith(), arith(jl, lo))
    show by simp(a0, a1, i0, i1, lt)
  qed
  show by taut(c1, c2, c3)
qed

// the metas' partition: g out of the used ones into the taken ones, last
theorem mp.drop_part(A, g, k): A in mallocng.Abs -> mallocng.metas_partition(A) -> k in omega -> int_lt(k, seq_len(A.used)) -> A.used[k] = g ->
  mallocng.metas_partition(mp.drop(A, g, k))
proof
  assume ha hp hk hkl hkg
  let A2 := mp.drop(A, g, k)
  let L := A.taken
  let T := seq_concat(L, seq_one(g))
  have {hs = sorted, hus = used_slots, hfs = free_slots, hcv = cover, htk = taken, hfr = fresh} := expand(hp, mallocng.metas_partition)
  have ul: A.used in list_type(omega) by simp(ha)
  have tl: A.taken in list_type(omega) by simp(ha)
  have go: g in omega := rewrite(hkg, apply(at_type[l := A.used, t := omega, i := k], ul, hk, hkl))
  have gu: mallocng.is_used(A, g) by defs(ex_intro({k}, taut(hk, hkl, hkg)), mallocng.is_used)
  have tlo: seq_len(L) in omega by arith(tl)
  have gl := mp(all_elim(tr.seq_one_type, {g}, {omega}), go)
  have {ln2 = len, nw2 = new} := apply(mp.snoc_at[L := L, g := g, k := 0], tl, go, simp())
  have et: A2.taken = T by simp()
  have iu: all h. mallocng.is_used(A2, h) <-> mallocng.is_used(A, h) && !(h = g) proof
    fix h
    show := apply(mp.drop_used[A := A, g := g, k := k, h := h], ha, hp, hk, hkl, hkg)
  qed
  have msl: all h. mallocng.meta_slot(A2, h) <-> mallocng.meta_slot(A, h) by defs(simp(), mallocng.meta_slot)
  have avl: all h. mallocng.avail_meta(A2, h) <-> mallocng.avail_meta(A, h) by defs(simp(), mallocng.avail_meta)
  // (g: a meta slot, not available, not free, not taken)
  have gsl := mp(all_elim(hus, {k}), hk, hkl)
  have gms := rewrite(hkg, gsl)
  have gna: !mallocng.avail_meta(A, g) proof
    assume av
    have a0 ex := expand(av, mallocng.avail_meta)
    obtain j, hj hjr from ex
    have hj1 hj2 hje := hjr
    have f1 _ := mp(all_elim(hfr, {j}), hj, taut(a0, hj1, hj2))
    show by taut(rewrite(sym(hje), f1), gu)
  qed
  have gnf: all x1. x1 in omega -> int_lt(x1, seq_len(A.free_metas)) -> !(A.free_metas[x1] = g) proof
    fix x1
    assume h1 h2 e
    have _ nu := mp(all_elim(hfs, {x1}), h1, h2)
    show by taut(rewrite(e, nu), gu)
  qed
  have gnt: all x1. x1 in omega -> int_lt(x1, seq_len(L)) -> !(L[x1] = g) proof
    fix x1
    assume h1 h2 e
    have _ nu _ _ _ := mp(all_elim(htk, {x1}), h1, h2)
    show by taut(rewrite(e, nu), gu)
  qed
  // sorted
  have k1: all j. j in omega -> int_lt(int_add(j, 1), seq_len(A2.used)) -> int_lt(A2.used[j], A2.used[int_add(j, 1)]) by simp(apply(mp.rm_sorted, ul, hk, hkl, hs))
  // used_slots
  have k2: all j. j in omega -> int_lt(j, seq_len(A2.used)) -> mallocng.meta_slot(A2, A2.used[j]) proof
    fix j
    assume hj hjl
    have iu2: mallocng.is_used(A2, A2.used[j]) by defs(ex_intro({j}, taut(hj, hjl, refl({A2.used[j]}))), mallocng.is_used)
    have u1: mallocng.is_used(A, A2.used[j]) by taut(all_elim(iu, {A2.used[j]}), iu2)
    obtain i, hi hil hie from expand(u1, mallocng.is_used)
    have s := mp(all_elim(hus, {i}), hi, hil)
    show by taut(all_elim(msl, {A2.used[j]}), rewrite(hie, s))
  qed
  // free_slots
  have k3: all j. j in omega -> int_lt(j, seq_len(A2.free_metas)) -> mallocng.meta_slot(A2, A2.free_metas[j]) && !mallocng.is_used(A2, A2.free_metas[j]) proof
    fix j
    assume hj hjl
    have jl: int_lt(j, seq_len(A.free_metas)) by simp(hjl)
    have s1 s2 := mp(all_elim(hfs, {j}), hj, jl)
    have u2: !mallocng.is_used(A2, A.free_metas[j]) by taut(all_elim(iu, {A.free_metas[j]}), s2)
    have m2: mallocng.meta_slot(A2, A.free_metas[j]) by taut(all_elim(msl, {A.free_metas[j]}), s1)
    show by simp(u2, m2)
  qed
  // cover: a meta slot used, free, fresh or taken as before -- g now taken
  have k4: all x0 x1. x0 in omega && x1 in omega -> int_lt(x0, seq_len(A2.areas)) && int_lt(x1, mallocng.NSLOTS) ->
      ((mallocng.is_used(A2, mallocng.meta_at(A2.areas[x0], x1)) ||
        (ex x2. x2 in omega && (int_lt(x2, seq_len(A2.free_metas)) && A2.free_metas[x2] = mallocng.meta_at(A2.areas[x0], x1)))) ||
       mallocng.avail_meta(A2, mallocng.meta_at(A2.areas[x0], x1))) ||
      (ex x2. x2 in omega && (int_lt(x2, seq_len(A2.taken)) && A2.taken[x2] = mallocng.meta_at(A2.areas[x0], x1))) proof
    fix x0 x1
    assume hx hb
    let X := mallocng.meta_at(A.areas[x0], x1)
    have hb2: int_lt(x0, seq_len(A.areas)) && int_lt(x1, mallocng.NSLOTS) by simp(hb)
    have c := mp(all_elim(hcv, {x0}, {x1}), hx, hb2)
    have du: mallocng.is_used(A, X) -> mallocng.is_used(A2, X) || (ex x2. x2 in omega && (int_lt(x2, seq_len(T)) && T[x2] = X)) proof
      assume h
      have c1: !(X = g) -> mallocng.is_used(A2, X) by taut(all_elim(iu, {X}), h)
      have c2: X = g -> (ex x2. x2 in omega && (int_lt(x2, seq_len(T)) && T[x2] = X)) proof
        assume e
        have tl2: int_lt(seq_len(L), seq_len(T)) by arith(ln2, tlo)
        show by ex_intro({seq_len(L)}, taut(tlo, tl2, trans(nw2, sym(e))))
      qed
      show by taut(c1, c2)
    qed
    have da: mallocng.avail_meta(A, X) -> mallocng.avail_meta(A2, X) by taut(all_elim(avl, {X}))
    have dt: (ex x2. x2 in omega && (int_lt(x2, seq_len(L)) && L[x2] = X)) -> (ex x2. x2 in omega && (int_lt(x2, seq_len(T)) && T[x2] = X)) proof
      assume e
      obtain i, hi hil hie from e
      have {ok = old} := apply(mp.snoc_at[L := L, g := g, k := i], tl, go, hi)
      have il2: int_lt(i, seq_len(T)) by arith(hil, ln2)
      show by ex_intro({i}, taut(hi, il2, trans(mp(ok, hil), hie)))
    qed
    have r: ((mallocng.is_used(A2, X) || (ex x2. x2 in omega && (int_lt(x2, seq_len(A.free_metas)) && A.free_metas[x2] = X))) || mallocng.avail_meta(A2, X)) ||
        (ex x2. x2 in omega && (int_lt(x2, seq_len(T)) && T[x2] = X)) by taut(c, du, da, dt)
    show by simp(r)
  qed
  // taken: those before, each as it was; g last
  have k5: all i. i in omega -> int_lt(i, seq_len(A2.taken)) ->
      (((mallocng.meta_slot(A2, A2.taken[i]) && !mallocng.is_used(A2, A2.taken[i])) && !mallocng.avail_meta(A2, A2.taken[i])) &&
        (all x1. x1 in omega -> int_lt(x1, seq_len(A2.free_metas)) -> !(A2.free_metas[x1] = A2.taken[i]))) &&
      (all x1. x1 in omega -> int_lt(x1, seq_len(A2.taken)) && A2.taken[x1] = A2.taken[i] -> x1 = i) proof
    fix i
    assume hi hil0
    have hil: int_lt(i, seq_len(T)) := rewrite(et, hil0)
    have {ok = old} := apply(mp.snoc_at[L := L, g := g, k := i], tl, go, hi)
    // (two taken metas the same: the same index)
    have tx: all x1. x1 in omega -> int_lt(x1, seq_len(T)) -> (int_lt(x1, seq_len(L)) && T[x1] = L[x1]) || (x1 = seq_len(L) && T[x1] = g) proof
      fix x1
      assume h1 h2
      have {okx = old} := apply(mp.snoc_at[L := L, g := g, k := x1], tl, go, h1)
      have c1: int_lt(x1, seq_len(L)) -> T[x1] = L[x1] := okx
      have c2: !int_lt(x1, seq_len(L)) -> x1 = seq_len(L) && T[x1] = g proof
        assume n
        have e: x1 = seq_len(L) by arith(h1, h2, n, ln2, tlo)
        show by taut(e, rewrite(sym(e), nw2))
      qed
      show by taut(c1, c2)
    qed
    have ci: int_lt(i, seq_len(L)) -> (((mallocng.meta_slot(A2, T[i]) && !mallocng.is_used(A2, T[i])) && !mallocng.avail_meta(A2, T[i])) &&
        (all x1. x1 in omega -> int_lt(x1, seq_len(A.free_metas)) -> !(A.free_metas[x1] = T[i]))) &&
        (all x1. x1 in omega -> int_lt(x1, seq_len(T)) && T[x1] = T[i] -> x1 = i) proof
      assume il
      have ti := mp(ok, il)
      have q1 q2 q3 q4 q5 := mp(all_elim(htk, {i}), hi, il)
      have a1: mallocng.meta_slot(A2, T[i]) by taut(all_elim(msl, {T[i]}), rewrite(sym(ti), q1))
      have a2: !mallocng.is_used(A2, T[i]) by taut(all_elim(iu, {T[i]}), rewrite(sym(ti), q2))
      have a3: !mallocng.avail_meta(A2, T[i]) by taut(all_elim(avl, {T[i]}), rewrite(sym(ti), q3))
      have a4: all x1. x1 in omega -> int_lt(x1, seq_len(A.free_metas)) -> !(A.free_metas[x1] = T[i]) := rewrite(sym(ti), q4)
      have a5: all x1. x1 in omega -> int_lt(x1, seq_len(T)) && T[x1] = T[i] -> x1 = i proof
        fix x1
        assume h1 h2
        have x1l te := h2
        have d1: int_lt(x1, seq_len(L)) && T[x1] = L[x1] -> x1 = i proof
          assume q
          have ql qe := q
          have e3: L[x1] = L[i] := trans(sym(qe), trans(te, ti))
          show := mp(all_elim(q5, {x1}), h1, taut(ql, e3))
        qed
        have d2: x1 = seq_len(L) && T[x1] = g -> x1 = i proof
          assume q
          have _ qe := q
          have f := mp(all_elim(gnt, {i}), hi, il)
          show by taut(f, trans(sym(ti), trans(sym(te), qe)))
        qed
        show by taut(mp(all_elim(tx, {x1}), h1, x1l), d1, d2)
      qed
      show by taut(a1, a2, a3, a4, a5)
    qed
    have cg: !int_lt(i, seq_len(L)) -> (((mallocng.meta_slot(A2, T[i]) && !mallocng.is_used(A2, T[i])) && !mallocng.avail_meta(A2, T[i])) &&
        (all x1. x1 in omega -> int_lt(x1, seq_len(A.free_metas)) -> !(A.free_metas[x1] = T[i]))) &&
        (all x1. x1 in omega -> int_lt(x1, seq_len(T)) && T[x1] = T[i] -> x1 = i) proof
      assume il
      have ie: i = seq_len(L) by arith(hi, hil, il, ln2, tlo)
      have tg: T[i] = g := rewrite(sym(ie), nw2)
      have a1: mallocng.meta_slot(A2, g) by taut(all_elim(msl, {g}), gms)
      have a2: !mallocng.is_used(A2, g) by taut(all_elim(iu, {g}), refl({g}))
      have a3: !mallocng.avail_meta(A2, g) by taut(all_elim(avl, {g}), gna)
      have a5: all x1. x1 in omega -> int_lt(x1, seq_len(T)) && T[x1] = g -> x1 = i proof
        fix x1
        assume h1 h2
        have x1l te := h2
        have d1: int_lt(x1, seq_len(L)) && T[x1] = L[x1] -> x1 = i proof
          assume q
          have ql qe := q
          have f := mp(all_elim(gnt, {x1}), h1, ql)
          show by taut(f, trans(sym(qe), te))
        qed
        have d2: x1 = seq_len(L) && T[x1] = g -> x1 = i proof
          assume q
          have qx _ := q
          show := trans(qx, sym(ie))
        qed
        show by taut(mp(all_elim(tx, {x1}), h1, x1l), d1, d2)
      qed
      show by simp(tg, a1, a2, a3, gnf, a5)
    qed
    have r: (((mallocng.meta_slot(A2, T[i]) && !mallocng.is_used(A2, T[i])) && !mallocng.avail_meta(A2, T[i])) &&
        (all x1. x1 in omega -> int_lt(x1, seq_len(A.free_metas)) -> !(A.free_metas[x1] = T[i]))) &&
        (all x1. x1 in omega -> int_lt(x1, seq_len(T)) && T[x1] = T[i] -> x1 = i) by taut(ci, cg)
    show by simp(r, et)
  qed
  // fresh: the fresh ones not used
  have k6: all x0. x0 in omega -> (ord_lt(0, seq_len(A2.areas)) && int_le(int_sub(mallocng.NSLOTS, A2.avail_cnt), x0)) && int_lt(x0, mallocng.NSLOTS) ->
      !mallocng.is_used(A2, mallocng.meta_at(A2.areas[int_sub(seq_len(A2.areas), 1)], x0)) &&
      (all x1. x1 in omega -> int_lt(x1, seq_len(A2.free_metas)) -> !(A2.free_metas[x1] = mallocng.meta_at(A2.areas[int_sub(seq_len(A2.areas), 1)], x0))) proof
    fix x0
    assume hx hb
    let X := mallocng.meta_at(A.areas[int_sub(seq_len(A.areas), 1)], x0)
    have hb2: (ord_lt(0, seq_len(A.areas)) && int_le(int_sub(mallocng.NSLOTS, A.avail_cnt), x0)) && int_lt(x0, mallocng.NSLOTS) by simp(hb)
    have f1 f2 := mp(all_elim(hfr, {x0}), hx, hb2)
    have u2: !mallocng.is_used(A2, X) by taut(all_elim(iu, {X}), f1)
    show by simp(u2, f2)
  qed
  show by defs(taut(k1, k2, k3, k4, k5, k6), mallocng.metas_partition)
qed

// ----------------------------------------------------------------------
//  A nested group's slot: its geometry, the only one nesting it

theorem mp.nest_geo(c, A, M, b, brk, h, j, g): A in mallocng.Abs -> mallocng.holds(c, A, M, b, brk) -> mallocng.is_used(A, h) -> j in omega ->
  int_lt(j, seq_len(A.slots[h])) -> A.slots[h][j] = tag(2, g) ->
  used: mallocng.is_used(A, g) && nat: g in omega && mem: A.metas[g].mem in omega && hmem: A.metas[h].mem in omega &&
  start: int_le(mallocng.slot_start(A.metas[h], j), A.metas[g].mem) &&
  fits: int_le(mallocng.slot_end(A.metas[g], A.metas[g].last_idx), mallocng.slot_end(A.metas[h], j)) &&
  body: int_le(int_add(A.metas[g].mem, 12), mallocng.slot_end(A.metas[g], A.metas[g].last_idx)) &&
  hdr: int_le(int_add(A.metas[h].mem, 16), mallocng.slot_start(A.metas[h], j)) &&
  last: int_le(mallocng.slot_end(A.metas[h], j), mallocng.slot_end(A.metas[h], A.metas[h].last_idx))
proof
  assume ha H hh hj hjl e
  have {huo = used} := expand(H, mallocng.holds)
  have gh := apply(mp.used_group, huo, hh)
  have {ho = nat} := apply(mp.used_nat, ha, hh)
  have {psl = slots} := expand(gh, mallocng.group_ok)
  have so := mp(all_elim(psl, {j}), hj, hjl)
  let W := A.metas[g]
  let V := A.metas[h]
  have s0: ((mallocng.is_used(A, g) && W.maplen = 0) && mallocng.hdr_free(b, W.mem)) &&
      mallocng.frame_ok(M, V, j, W.mem, int_sub(int_add(mallocng.UNIT, int_mul(mallocng.stride(W), int_add(W.last_idx, 1))), mallocng.IB), 6)
    by simp(expand(rewrite(e, so), mallocng.slot_ok))
  have gu _ _ fo := s0
  have {wme = start, wst = fits} := expand(fo, mallocng.frame_ok)
  have {go = nat} := apply(mp.used_nat, ha, gu)
  have {wm = mem, wl = last, ws = stride, wse = end} := apply(mp.geo, ha, go, apply(mp.used_group, huo, gu))
  have {pm = mem, pl = last, psn = stride, pss = start, pse = end, pns = nslots} := apply(mp.geo, ha, ho, gh)
  have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
  have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
  have e1 := all_elim(wse, {W.last_idx})
  have e2 := all_elim(pse, {j})
  have e3 := all_elim(pss, {j})
  have e4 := all_elim(pse, {V.last_idx})
  have mw: int_mul(mallocng.stride(W), W.last_idx) in omega by simp(ws, wl)
  have mv: int_mul(mallocng.stride(V), j) in omega by simp(psn, hj)
  have c1: int_le(mallocng.slot_end(W, W.last_idx), mallocng.slot_end(V, j)) by arith(e1, wst, cu, ci, mw, ws, wl)
  have c4: int_le(int_add(W.mem, 12), mallocng.slot_end(W, W.last_idx)) by arith(e1, mw, ws, wm)
  have c5: int_le(int_add(V.mem, 16), mallocng.slot_start(V, j)) by arith(e3, mv, pm)
  have il: int_le(j, V.last_idx) by arith(pns, hjl, hj, pl)
  have ml := mp(all_elim(ms.mul_le, {mallocng.stride(V)}, {j}, {mallocng.stride(V)}, {V.last_idx}), psn, hj, simp(psn), simp(pl), arith(psn), il)
  have c2: int_le(mallocng.slot_end(V, j), mallocng.slot_end(V, V.last_idx)) by arith(e2, e4, ml)
  show by taut(gu, go, wm, pm, wme, c1, c4, c5, c2)
qed

// (two slots nesting g: not in groups starting one before the other)
theorem mp.nest_below(c, A, M, b, brk, x, i, h, j, g): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds(c, A, M, b, brk) ->
  mallocng.is_used(A, x) -> mallocng.is_used(A, h) -> i in omega -> int_lt(i, seq_len(A.slots[x])) -> j in omega -> int_lt(j, seq_len(A.slots[h])) ->
  A.slots[x][i] = tag(2, g) -> A.slots[h][j] = tag(2, g) -> int_lt(A.metas[x].mem, A.metas[h].mem) -> false
proof
  assume hc hu ha H hx hh hi hil hj hjl ex eh lt
  have {huo = used} := expand(H, mallocng.holds)
  have {xg = start, xf = fits, xb = body, xh = hdr, xl = last, gm = mem, xm = hmem} :=
    apply(mp.nest_geo[c := c, A := A, M := M, b := b, brk := brk, h := x, j := i, g := g], ha, H, hx, hi, hil, ex)
  have {hg = start, hf = fits, hb = body, hhd = hdr, hl = last, hm = hmem} :=
    apply(mp.nest_geo[c := c, A := A, M := M, b := b, brk := brk, h := h, j := j, g := g], ha, H, hh, hj, hjl, eh)
  let G := A.metas[g].mem
  have gbh: mp.gb(A, h, G) by defs(arith(hg, hhd, hb, hf, hl), mp.gb)
  have gbx: mp.gb(A, x, G) by defs(arith(xg, xh, xb, xf, xl), mp.gb)
  have ins := apply(mp.laminar[c := c, A := A, M := M, b := b, brk := brk, h := h, k := x, a := G], hc, hu, ha, H, hh, hx, lt, gm, gbh, gbx)
  obtain j6, hj6 hj6l f6 s6 e6 z6 from expand(ins, mp.inside)
  have c1: j6 = i -> false proof
    assume e
    have sg: snd(A.slots[x][j6]) = g := rewrite(sym(e), (snd(A.slots[x][i]) = g by simp(ex)))
    have z := rewrite(sg, z6)
    show by arith(z, hg, hhd)
  qed
  have c2: !(j6 = i) -> false proof
    assume ne
    have {xo = nat} := apply(mp.used_nat, ha, hx)
    have {xs = stride, xss = start, xse = end} := apply(mp.geo, ha, xo, apply(mp.used_group, huo, hx))
    have sj := all_elim(xss, {j6})
    have ej := all_elim(xse, {j6})
    have si := all_elim(xss, {i})
    have ei := all_elim(xse, {i})
    have sp := apply(mp.slot_sep[m := A.metas[x].mem, S := mallocng.stride(A.metas[x]), i := j6, j := i, a := G], xm, xs, hj6, hi, ne,
      arith(s6, sj, hg, hhd), arith(e6, ej, hb, hf, hl))
    have q: int_lt(int_sub(int_add(int_add(A.metas[x].mem, 16), int_mul(mallocng.stride(A.metas[x]), i)), 4), G) &&
        int_lt(G, int_sub(int_add(int_add(int_add(A.metas[x].mem, 16), int_mul(mallocng.stride(A.metas[x]), i)), mallocng.stride(A.metas[x])), 4))
      by arith(xg, si, xb, xf, ei)
    show by taut(sp, q)
  qed
  show by taut(c1, c2)
qed

// a group nested in one slot only
theorem mp.nest_once(c, A, M, b, brk, x, i, h, j, g): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds(c, A, M, b, brk) ->
  mallocng.is_used(A, x) -> mallocng.is_used(A, h) -> i in omega -> int_lt(i, seq_len(A.slots[x])) -> j in omega -> int_lt(j, seq_len(A.slots[h])) ->
  A.slots[x][i] = tag(2, g) -> A.slots[h][j] = tag(2, g) -> x = h && i = j
proof
  assume hc hu ha H hx hh hi hil hj hjl ex eh
  have {xm = mem} := apply(mp.used_nat, ha, hx)
  have {hm = mem} := apply(mp.used_nat, ha, hh)
  have c1: int_lt(A.metas[x].mem, A.metas[h].mem) -> x = h && i = j proof
    assume l
    have f := apply(mp.nest_below[c := c, A := A, M := M, b := b, brk := brk, x := x, i := i, h := h, j := j, g := g], hc, hu, ha, H, hx, hh, hi, hil, hj, hjl, ex, eh, l)
    show by taut(f)
  qed
  have c2: int_lt(A.metas[h].mem, A.metas[x].mem) -> x = h && i = j proof
    assume l
    have f := apply(mp.nest_below[c := c, A := A, M := M, b := b, brk := brk, x := h, i := j, h := x, j := i, g := g], hc, hu, ha, H, hh, hx, hj, hjl, hi, hil, eh, ex, l)
    show by taut(f)
  qed
  have c3: A.metas[x].mem = A.metas[h].mem -> x = h && i = j proof
    assume em
    have exh := apply(mp.same_mem[c := c, A := A, M := M, b := b, brk := brk, g := x, h := h], H, hx, hh, em)
    have ex2 := rewrite(exh, ex)
    have il2 := rewrite(exh, hil)
    have {ig = start, ib = body, if = fits, ihm = hmem} := apply(mp.nest_geo[c := c, A := A, M := M, b := b, brk := brk, h := h, j := i, g := g], ha, H, hh, hi, il2, ex2)
    have {jg = start, jb = body, jf = fits} := apply(mp.nest_geo[c := c, A := A, M := M, b := b, brk := brk, h := h, j := j, g := g], ha, H, hh, hj, hjl, eh)
    have ij: i = j proof
      have ne: !(i = j) -> false proof
        assume n
        have {huo = used} := expand(H, mallocng.holds)
        have {ho = nat} := apply(mp.used_nat, ha, hh)
        have {hs = stride, hss = start, hse = end} := apply(mp.geo, ha, ho, apply(mp.used_group, huo, hh))
        let G := A.metas[g].mem
        have sp := apply(mp.slot_sep[m := A.metas[h].mem, S := mallocng.stride(A.metas[h]), i := i, j := j, a := G], ihm, hs, hi, hj, n,
          arith(ig, all_elim(hss, {i})), arith(ib, if, all_elim(hse, {i})))
        have q: int_lt(int_sub(int_add(int_add(A.metas[h].mem, 16), int_mul(mallocng.stride(A.metas[h]), j)), 4), G) &&
            int_lt(G, int_sub(int_add(int_add(int_add(A.metas[h].mem, 16), int_mul(mallocng.stride(A.metas[h]), j)), mallocng.stride(A.metas[h])), 4))
          by arith(jg, all_elim(hss, {j}), jb, jf, all_elim(hse, {j}))
        show by taut(sp, q)
      qed
      show by taut(ne)
    qed
    show by taut(exh, ij)
  qed
  show by taut(c1, c2, c3, (int_lt(A.metas[x].mem, A.metas[h].mem) || int_lt(A.metas[h].mem, A.metas[x].mem) || A.metas[x].mem = A.metas[h].mem by arith(xm, hm)))
qed

// ----------------------------------------------------------------------
//  Another group: as it was, in the state without g

// (a slot as it was: a nested group still in use, its record kept)
theorem mp.slot_tr2(A, A2, M, b, g, j, u): u in mallocng.Use -> A2.metas[g] = A.metas[g] ->
  (fst(u) = 2 -> mallocng.is_used(A2, snd(u)) && A2.metas[snd(u)] = A.metas[snd(u)]) ->
  mallocng.slot_ok(A, M, b, g, j, u) -> mallocng.slot_ok(A2, M, b, g, j, u)
proof
  assume ut emg emu so
  have c0: u = tag(0, empty) -> mallocng.slot_ok(A2, M, b, g, j, u) proof
    assume e
    show by defs(simp(e), mallocng.slot_ok)
  qed
  have c1: !(u = tag(0, empty)) -> fst(u) = 1 -> mallocng.slot_ok(A2, M, b, g, j, u) proof
    assume e0 e1
    let P := snd(u)
    have ue: u = tag(1, P) by simp(apply(mp.use_eta, ut), e1)
    have s0: !(b[bits_of_int(64, P)] = none) && mallocng.hdr_free(b, P) && mallocng.frame_ok(M, A.metas[g], j, P, snd(b[bits_of_int(64, P)]), 0)
      by simp(expand(rewrite(ue, so), mallocng.slot_ok))
    show by defs(simp(e0, e1, emg, s0), mallocng.slot_ok)
  qed
  have c2: !(u = tag(0, empty)) -> fst(u) = 2 -> mallocng.slot_ok(A2, M, b, g, j, u) proof
    assume e0 e2
    have s0: ((mallocng.is_used(A, snd(u)) && A.metas[snd(u)].maplen = 0) && mallocng.hdr_free(b, A.metas[snd(u)].mem)) &&
        mallocng.frame_ok(M, A.metas[g], j, A.metas[snd(u)].mem, int_sub(int_add(mallocng.UNIT, int_mul(mallocng.stride(A.metas[snd(u)]), int_add(A.metas[snd(u)].last_idx, 1))), mallocng.IB), 6)
      by simp(expand(rewrite((u = tag(2, snd(u)) by simp(apply(mp.use_eta, ut), e2)), so), mallocng.slot_ok))
    have iw2 emw := mp(emu, e2)
    show by defs(simp(e0, e2, emg, emw, iw2, s0), mallocng.slot_ok)
  qed
  have c3: !(u = tag(0, empty)) -> !(fst(u) = 1) -> !(fst(u) = 2) -> mallocng.slot_ok(A2, M, b, g, j, u) proof
    assume e0 e1 e2
    show by defs(simp(e0, e1, e2), mallocng.slot_ok)
  qed
  show by taut(c0, c1, c2, c3)
qed

// group h, its record and active lists kept, its slots too but a nested
// one now reserved, the groups nested in the rest still in use, itself
// nested still: as it was
theorem mp.grp_abs(A, A2, M, b, h): A in mallocng.Abs -> h in omega -> mallocng.group_ok(A, M, b, h) ->
  A2.metas[h] = A.metas[h] -> A2.active = A.active -> seq_len(A2.slots[h]) = seq_len(A.slots[h]) ->
  (all i. i in omega -> int_lt(i, seq_len(A.slots[h])) -> A2.slots[h][i] = A.slots[h][i] || (fst(A.slots[h][i]) = 2 && A2.slots[h][i] = tag(3, empty))) ->
  (all i. i in omega -> int_lt(i, seq_len(A.slots[h])) -> A2.slots[h][i] = A.slots[h][i] -> fst(A.slots[h][i]) = 2 ->
     mallocng.is_used(A2, snd(A.slots[h][i])) && A2.metas[snd(A.slots[h][i])] = A.metas[snd(A.slots[h][i])]) ->
  (A.metas[h].maplen = 0 -> ex x0. ex x1. (x0 in omega && x1 in omega) &&
     ((int_lt(x0, seq_len(A2.used)) && int_lt(x1, seq_len(A2.slots[A2.used[x0]]))) && A2.slots[A2.used[x0]][x1] = tag(2, h))) ->
  mallocng.group_ok(A2, M, b, h)
proof
  assume ha ho gok emh eac esl ssl snu ne
  have {sl0 = slots, mk0 = masks, ns0 = nslots} := expand(gok, mallocng.group_ok)
  have {mim, cls, hdr, hdr_own, act, nslots, small, mapped, big, linked, unlinked, sentinel, chk_own, offs, span} :=
    rewrite(sym(eac), rewrite(sym(emh), expand(gok, mallocng.group_ok)))
  have ns2 := rewrite(sym(esl), nslots)
  have vt: A.metas[h] in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A.metas, x := h], simp(ha), ho)
  have vl: A.metas[h].last_idx in omega by simp(vt)
  // the masks: a slot unused as before
  have mk := expand(mk0, mallocng.masks_ok)
  have r: all x0. x0 in omega -> int_lt(x0, 32) -> (((mallocng.bit(A.metas[h].avail, x0) = 1 -> int_le(x0, int_mod(mallocng.b8(M, int_add(A.metas[h].mem, 8)), 32)) && mallocng.bit(A.metas[h].freed, x0) = 0) &&
      (int_lt(0, int_add(mallocng.bit(A.metas[h].avail, x0), mallocng.bit(A.metas[h].freed, x0))) -> int_le(x0, A.metas[h].last_idx))) &&
      (int_le(x0, A.metas[h].last_idx) -> (A2.slots[h][x0] = tag(0, empty) <-> int_lt(0, int_add(mallocng.bit(A.metas[h].avail, x0), mallocng.bit(A.metas[h].freed, x0)))) &&
        mallocng.b8(M, int_sub(mallocng.slot_start(A.metas[h], x0), 4)) = 0)) &&
      (int_lt(int_mod(mallocng.b8(M, int_add(A.metas[h].mem, 8)), 32), x0) && int_le(x0, A.metas[h].last_idx) -> mallocng.bit(A.metas[h].freed, x0) = 1) proof
    fix i
    assume hi hil
    have a b2 cc d := mp(all_elim(mk, {i}), hi, hil)
    have c2: int_le(i, A.metas[h].last_idx) -> (A2.slots[h][i] = tag(0, empty) <-> int_lt(0, int_add(mallocng.bit(A.metas[h].avail, i), mallocng.bit(A.metas[h].freed, i)))) &&
        mallocng.b8(M, int_sub(mallocng.slot_start(A.metas[h], i), 4)) = 0 proof
      assume hl
      have c1 c0 := mp(cc, hl)
      have il: int_lt(i, seq_len(A.slots[h])) by arith(ns0, hl, hi, vl)
      have q1: A2.slots[h][i] = A.slots[h][i] -> (A2.slots[h][i] = tag(0, empty) <-> A.slots[h][i] = tag(0, empty)) proof
        assume e
        show by simp(e)
      qed
      have q2: fst(A.slots[h][i]) = 2 && A2.slots[h][i] = tag(3, empty) -> (A2.slots[h][i] = tag(0, empty) <-> A.slots[h][i] = tag(0, empty)) proof
        assume q
        have f2 e3 := q
        have n1: !(A2.slots[h][i] = tag(0, empty)) by defs(simp(e3), tag)
        have n2 := apply(mp.tag_ne[u := A.slots[h][i], k := 2, x := 0, v := empty], f2, simp())
        show by taut(n1, n2)
      qed
      have eu: A2.slots[h][i] = tag(0, empty) <-> A.slots[h][i] = tag(0, empty) by taut(mp(all_elim(ssl, {i}), hi, il), q1, q2)
      show by taut(eu, c1, c0)
    qed
    show by taut(a, b2, c2, d)
  qed
  have msk2: mallocng.masks_ok(A2, M, h) by defs(rewrite(sym(emh), r), mallocng.masks_ok)
  have big2: mallocng.big_ok(A2, h) by defs(rewrite(sym(emh), expand(big, mallocng.big_ok)), mallocng.big_ok)
  have ne2 := rewrite(sym(emh), ne)
  // the slots: each as before, or reserved
  have slt: A.slots[h] in list_type(mallocng.Use) := mp(fn_space_app[a := omega, b := list_type(mallocng.Use), f := A.slots, x := h], simp(ha), ho)
  have sl2: all x0. x0 in omega -> int_lt(x0, seq_len(A2.slots[h])) -> mallocng.slot_ok(A2, M, b, h, x0, A2.slots[h][x0]) proof
    fix i
    assume hi hil0
    have hil: int_lt(i, seq_len(A.slots[h])) := rewrite(esl, hil0)
    have so := mp(all_elim(sl0, {i}), hi, hil)
    have k1: A2.slots[h][i] = A.slots[h][i] -> mallocng.slot_ok(A2, M, b, h, i, A2.slots[h][i]) proof
      assume e
      have ut := apply(at_type[l := A.slots[h], t := mallocng.Use, i := i], slt, hi, hil)
      have tr := apply(mp.slot_tr2[A := A, A2 := A2, M := M, b := b, g := h, j := i, u := A.slots[h][i]], ut, emh, mp(all_elim(snu, {i}), hi, hil, e), so)
      show := rewrite(sym(e), tr)
    qed
    have k2: fst(A.slots[h][i]) = 2 && A2.slots[h][i] = tag(3, empty) -> mallocng.slot_ok(A2, M, b, h, i, A2.slots[h][i]) proof
      assume q
      have _ e3 := q
      show by defs(simp(e3), mallocng.slot_ok)
    qed
    show by taut(mp(all_elim(ssl, {i}), hi, hil), k1, k2)
  qed
  show by defs(taut(mim, cls, hdr, hdr_own, act, ns2, msk2, small, mapped, ne2, big2, linked, unlinked, sl2, sentinel, chk_own, offs, span), mallocng.group_ok)
qed

// ----------------------------------------------------------------------
//  Where the group given back lies: no other group's own bytes there

// (no group starts past a nested group g in its slot, g nesting none: by
// strong induction on where it starts -- its parent starts there too)
theorem mp.slot_alone(c, A, M, b, brk, h, j, g, x): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds(c, A, M, b, brk) ->
  mallocng.is_used(A, h) -> j in omega -> int_lt(j, seq_len(A.slots[h])) -> A.slots[h][j] = tag(2, g) ->
  (all i. i in omega -> int_lt(i, seq_len(A.slots[g])) -> !(fst(A.slots[g][i]) = 2)) ->
  mallocng.is_used(A, x) -> int_lt(A.metas[g].mem, A.metas[x].mem) -> int_lt(A.metas[x].mem, mallocng.slot_end(A.metas[h], j)) -> false
proof
  assume hc hu ha H hh hj hjl ehj gnn hx0 l10 l20
  have {huo = used} := expand(H, mallocng.holds)
  have {gu = used, gm = mem, hm = hmem, hst = start, hhd = hdr, hla = last} := apply(mp.nest_geo[c := c, A := A, M := M, b := b, brk := brk, h := h, j := j, g := g], ha, H, hh, hj, hjl, ehj)
  have {ho = nat} := apply(mp.used_nat, ha, hh)
  have {hs = stride, hss = start, hse = end} := apply(mp.geo, ha, ho, apply(mp.used_group, huo, hh))
  have sj := all_elim(hss, {j})
  have ej := all_elim(hse, {j})
  let G := A.metas[g].mem
  let E := mallocng.slot_end(A.metas[h], j)
  have st: all n. n in omega -> (all m. m in omega -> int_lt(m, n) -> all y. mallocng.is_used(A, y) -> A.metas[y].mem = m -> int_lt(G, m) -> int_lt(m, E) -> false) ->
      all y. mallocng.is_used(A, y) -> A.metas[y].mem = n -> int_lt(G, n) -> int_lt(n, E) -> false proof
    fix n
    assume hn ih
    fix y
    assume hy ey l1 l2
    have {yo = nat, ym = mem, yl = maplen} := apply(mp.used_nat, ha, hy)
    let X := A.metas[y].mem
    have l1x: int_lt(G, X) := rewrite(sym(ey), l1)
    have l2x: int_lt(X, E) := rewrite(sym(ey), l2)
    have {ys = stride, yl2 = last, yse = end} := apply(mp.geo, ha, yo, apply(mp.used_group, huo, hy))
    have ye := all_elim(yse, {A.metas[y].last_idx})
    have my: int_mul(mallocng.stride(A.metas[y]), A.metas[y].last_idx) in omega by simp(ys, yl2)
    have yb: int_le(int_add(X, 12), mallocng.slot_end(A.metas[y], A.metas[y].last_idx)) by arith(ye, my, ys, ym)
    have gbh: mp.gb(A, h, X) by defs(arith(l1x, l2x, hst, hhd, hla), mp.gb)
    have gby: mp.gb(A, y, X) by defs(arith(yb, ym), mp.gb)
    // (y in the slot interior)
    have yin: int_lt(int_sub(int_add(int_add(A.metas[h].mem, 16), int_mul(mallocng.stride(A.metas[h]), j)), 4), X) &&
        int_lt(X, int_sub(int_add(int_add(int_add(A.metas[h].mem, 16), int_mul(mallocng.stride(A.metas[h]), j)), mallocng.stride(A.metas[h])), 4))
      by arith(l1x, l2x, hst, sj, ej)
    // mapped: h's root maps it too
    have cm: int_lt(0, A.metas[y].maplen) -> false proof
      assume my0
      obtain r, hr hrm hr1 hr2 from apply(mp.root, ha, H, hh)
      have gbr: mp.gb(A, r, X) by defs(arith(hr1, hr2, l1x, l2x, hst, hhd, hla), mp.gb)
      have ne: !(r = y) proof
        assume e
        show by arith(rewrite(e, hr1), l1x, hst, hhd)
      qed
      have na := apply(mp.mapped_apart[c := c, A := A, M := M, b := b, brk := brk, g := r, h := y, a := X], hc, hu, ha, H, hr, hy, ne, hrm, my0, ym, gbr)
      show by taut(na, gby)
    qed
    // nested: in its parent's slot -- not g's (none), not h's (g's), not a
    // group before h (h in its slot), so one past g: earlier than y
    have cn: A.metas[y].maplen = 0 -> false proof
      assume z
      obtain p j3, hp hj3 hj3l hs3 hps hpe hpl hlt from apply(mp.parent, ha, H, hy, z)
      have {po = nat, pm = mem} := apply(mp.used_nat, ha, hp)
      have {ps = stride, pss = start, pse = end} := apply(mp.geo, ha, po, apply(mp.used_group, huo, hp))
      have s3 := all_elim(pss, {j3})
      have e3 := all_elim(pse, {j3})
      have gbp: mp.gb(A, p, X) by defs(arith(hlt, yb, hpe, hpl), mp.gb)
      have yin3: int_lt(int_sub(int_add(int_add(A.metas[p].mem, 16), int_mul(mallocng.stride(A.metas[p]), j3)), 4), X) &&
          int_lt(X, int_sub(int_add(int_add(int_add(A.metas[p].mem, 16), int_mul(mallocng.stride(A.metas[p]), j3)), mallocng.stride(A.metas[p])), 4))
        by arith(hps, s3, yb, hpe, e3)
      have c1: p = g -> false proof
        assume e
        have f2: fst(A.slots[p][j3]) = 2 by simp(hs3)
        show by taut(mp(all_elim(gnn, {j3}), hj3, rewrite(e, hj3l)), rewrite(e, f2))
      qed
      have c2: p = h -> false proof
        assume e
        have hs3h := rewrite(e, hs3)
        have jj: j3 = j proof
          have n: !(j3 = j) -> false proof
            assume ne
            have sp := apply(mp.slot_sep[m := A.metas[h].mem, S := mallocng.stride(A.metas[h]), i := j3, j := j, a := X], hm, hs, hj3, hj, ne,
              arith(rewrite(e, hps), all_elim(hss, {j3})), arith(yb, rewrite(e, hpe), all_elim(hse, {j3})))
            show by taut(sp, yin)
          qed
          show by taut(n)
        qed
        have tt: tag(2, y) = tag(2, g) := trans(sym(rewrite(jj, hs3h)), ehj)
        have yg: y = g by defs(simp(tt), tag)
        show by arith(rewrite(yg, l1x))
      qed
      have c3: int_lt(A.metas[p].mem, A.metas[h].mem) -> false proof
        assume l
        have ins := apply(mp.laminar[c := c, A := A, M := M, b := b, brk := brk, h := h, k := p, a := X], hc, hu, ha, H, hh, hp, l, ym, gbh, gbp)
        obtain j4, hj4 hj4l f4 s4 e4 z4 from expand(ins, mp.inside)
        have jj: j4 = j3 proof
          have n: !(j4 = j3) -> false proof
            assume ne
            have sp := apply(mp.slot_sep[m := A.metas[p].mem, S := mallocng.stride(A.metas[p]), i := j4, j := j3, a := X], pm, ps, hj4, hj3, ne,
              arith(s4, all_elim(pss, {j4}), l1x, hst, hhd), arith(e4, all_elim(pse, {j4}), l2x, hla))
            show by taut(sp, yin3)
          qed
          show by taut(n)
        qed
        have sx: snd(A.slots[p][j4]) = y := rewrite(sym(jj), (snd(A.slots[p][j3]) = y by simp(hs3)))
        show by arith(rewrite(sx, z4), l1x, hst, hhd)
      qed
      have c4: A.metas[p].mem = A.metas[h].mem -> false proof
        assume e
        show := mp(c2, apply(mp.same_mem[c := c, A := A, M := M, b := b, brk := brk, g := p, h := h], H, hp, hh, e))
      qed
      have c5: int_lt(A.metas[h].mem, A.metas[p].mem) -> false proof
        assume l
        have ins := apply(mp.laminar[c := c, A := A, M := M, b := b, brk := brk, h := p, k := h, a := X], hc, hu, ha, H, hp, hh, l, ym, gbp, gbh)
        obtain j5, hj5 hj5l f5 s5 e5 z5 from expand(ins, mp.inside)
        have jj: j5 = j proof
          have n: !(j5 = j) -> false proof
            assume ne
            have sp := apply(mp.slot_sep[m := A.metas[h].mem, S := mallocng.stride(A.metas[h]), i := j5, j := j, a := X], hm, hs, hj5, hj, ne,
              arith(s5, all_elim(hss, {j5}), hlt), arith(e5, all_elim(hse, {j5}), gbp, expand(gbp, mp.gb)))
            show by taut(sp, yin)
          qed
          show by taut(n)
        qed
        have sg: snd(A.slots[h][j5]) = g := rewrite(sym(jj), (snd(A.slots[h][j]) = g by simp(ehj)))
        have gp: int_le(G, A.metas[p].mem) := rewrite(sg, z5)
        have ne2: !(A.metas[p].mem = G) proof
          assume e
          show := mp(c1, apply(mp.same_mem[c := c, A := A, M := M, b := b, brk := brk, g := p, h := g], H, hp, gu, e))
        qed
        have gp2: int_lt(G, A.metas[p].mem) by arith(gp, ne2, pm, gm)
        show := mp(all_elim(mp(all_elim(ih, {A.metas[p].mem}), pm, arith(hlt, ey)), {p}), hp, refl({A.metas[p].mem}), gp2, arith(hlt, l2x))
      qed
      show by taut(c3, c4, c5, (int_lt(A.metas[p].mem, A.metas[h].mem) || A.metas[p].mem = A.metas[h].mem || int_lt(A.metas[h].mem, A.metas[p].mem) by arith(pm, hm)))
    qed
    show by taut(cm, cn, (int_lt(0, A.metas[y].maplen) || A.metas[y].maplen = 0 by arith(yl)))
  qed
  have all := mp(nat_strong_ind[p := n. all y. mallocng.is_used(A, y) -> A.metas[y].mem = n -> int_lt(G, n) -> int_lt(n, E) -> false], st)
  have {xm0 = mem} := apply(mp.used_nat, ha, hx0)
  show := mp(all_elim(mp(all_elim(all, {A.metas[x].mem}), xm0), {x}), hx0, refl({A.metas[x].mem}), l10, l20)
qed

// a byte of g's container slot's interior: no own byte of any other group
// but the container (its slot's)
theorem mp.nest_excl(c, A, M, b, brk, h, j, g, x, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds(c, A, M, b, brk) ->
  mallocng.is_used(A, h) -> j in omega -> int_lt(j, seq_len(A.slots[h])) -> A.slots[h][j] = tag(2, g) ->
  (all i. i in omega -> int_lt(i, seq_len(A.slots[g])) -> !(fst(A.slots[g][i]) = 2)) ->
  mallocng.is_used(A, x) -> !(x = g) -> !(x = h) -> a in omega -> mp.gb(A, x, a) -> mp.own(A, x, a) -> mallocng.in_slot(A.metas[h], j, a) -> false
proof
  assume hc hu ha H hh hj hjl ehj gnn hx xg xh hao gbx own isl
  have {huo = used} := expand(H, mallocng.holds)
  have {gu = used, gm = mem, hm = hmem, hst = start, hhd = hdr, hla = last} := apply(mp.nest_geo[c := c, A := A, M := M, b := b, brk := brk, h := h, j := j, g := g], ha, H, hh, hj, hjl, ehj)
  have {ho = nat} := apply(mp.used_nat, ha, hh)
  have {hs = stride, hss = start, hse = end} := apply(mp.geo, ha, ho, apply(mp.used_group, huo, hh))
  have {xo = nat, xm = mem} := apply(mp.used_nat, ha, hx)
  have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
  have i1 i2 := expand(isl, mallocng.in_slot)
  have x1 x2 := expand(gbx, mp.gb)
  have gbh: mp.gb(A, h, a) by defs(arith(i1, i2, ci, hhd, hla), mp.gb)
  have ain: int_lt(int_sub(int_add(int_add(A.metas[h].mem, 16), int_mul(mallocng.stride(A.metas[h]), j)), 4), a) &&
      int_lt(a, int_sub(int_add(int_add(int_add(A.metas[h].mem, 16), int_mul(mallocng.stride(A.metas[h]), j)), mallocng.stride(A.metas[h])), 4))
    by arith(i1, i2, ci, all_elim(hss, {j}), all_elim(hse, {j}))
  // x before h: h in x's nested slot, so a too -- not x's own
  have c1: int_lt(A.metas[x].mem, A.metas[h].mem) -> false proof
    assume l
    have ins := apply(mp.laminar[c := c, A := A, M := M, b := b, brk := brk, h := h, k := x, a := a], hc, hu, ha, H, hh, hx, l, hao, gbh, gbx)
    obtain j5, hj5 hj5l f5 s5 e5 z5 from expand(ins, mp.inside)
    have _ o2 := mp(all_elim(own, {j5}), hj5, hj5l)
    show by taut(mp(o2, f5), (int_le(A.metas[snd(A.slots[x][j5])].mem, a) && int_lt(a, mallocng.slot_end(A.metas[x], j5)) by arith(z5, i1, i2, ci, hhd, hla, e5)))
  qed
  have c2: A.metas[x].mem = A.metas[h].mem -> false proof
    assume e
    show by taut(xh, apply(mp.same_mem[c := c, A := A, M := M, b := b, brk := brk, g := x, h := h], H, hx, hh, e))
  qed
  // x past h: in its slot j, past g -- none there
  have c3: int_lt(A.metas[h].mem, A.metas[x].mem) -> false proof
    assume l
    have ins := apply(mp.laminar[c := c, A := A, M := M, b := b, brk := brk, h := x, k := h, a := a], hc, hu, ha, H, hx, hh, l, hao, gbx, gbh)
    obtain j6, hj6 hj6l f6 s6 e6 z6 from expand(ins, mp.inside)
    have jj: j6 = j proof
      have n: !(j6 = j) -> false proof
        assume ne
        have sp := apply(mp.slot_sep[m := A.metas[h].mem, S := mallocng.stride(A.metas[h]), i := j6, j := j, a := a], hm, hs, hj6, hj, ne,
          arith(s6, all_elim(hss, {j6}), x1), arith(e6, all_elim(hse, {j6}), x2))
        show by taut(sp, ain)
      qed
      show by taut(n)
    qed
    have sg: snd(A.slots[h][j6]) = g := rewrite(sym(jj), (snd(A.slots[h][j]) = g by simp(ehj)))
    have gx: int_le(A.metas[g].mem, A.metas[x].mem) := rewrite(sg, z6)
    have ne2: !(A.metas[x].mem = A.metas[g].mem) proof
      assume e
      show by taut(xg, apply(mp.same_mem[c := c, A := A, M := M, b := b, brk := brk, g := x, h := g], H, hx, gu, e))
    qed
    show := apply(mp.slot_alone[c := c, A := A, M := M, b := b, brk := brk, h := h, j := j, g := g, x := x], hc, hu, ha, H, hh, hj, hjl, ehj, gnn, hx,
      arith(gx, ne2, xm, gm), arith(x1, i2))
  qed
  show by taut(c1, c2, c3, (int_lt(A.metas[x].mem, A.metas[h].mem) || A.metas[x].mem = A.metas[h].mem || int_lt(A.metas[h].mem, A.metas[x].mem) by arith(xm, hm)))
qed

// (two groups mapped on their own: their ranges apart)
theorem mp.reg_two(c, A, M, b, brk, x, y, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds(c, A, M, b, brk) ->
  mallocng.is_used(A, x) -> mallocng.is_used(A, y) -> !(x = y) -> int_lt(0, A.metas[x].maplen) -> int_lt(0, A.metas[y].maplen) ->
  mallocng.in_range(a, mallocng.group_range(A.metas[x])) -> !mallocng.in_range(a, mallocng.group_range(A.metas[y]))
proof
  assume hc hu ha H hx hy hne mx my inx
  have {sep = sep} := expand(H, mallocng.holds)
  obtain kx, hkx hkxl hkxe from expand(hx, mallocng.is_used)
  obtain ky, hky hkyl hkye from expand(hy, mallocng.is_used)
  have kne: !(kx = ky) proof
    assume e
    show by taut(hne, trans(sym(hkxe), rewrite(sym(e), hkye)))
  qed
  have {ax = at, lx = len} := apply(mp.reg_grp[c := c, A := A, k := kx], hc, hu, ha, hkx, hkxl)
  have {ay = at, ly = len} := apply(mp.reg_grp[c := c, A := A, k := ky], hc, hu, ha, hky, hkyl)
  let RG := mallocng.regions(c, A)
  let B := int_add(int_add(int_add(3, x86_64_linux.phnum(c.file)), seq_len(A.areas)), 1)
  have fs: c.file in seq_type(bits(8)) by simp(hc)
  have pn: x86_64_linux.phnum(c.file) in omega by defs(mp(x86.le_at_nat[f := c.file, off := 56, n := 2], fs, simp()), x86_64_linux.phnum)
  have rl: A.areas in list_type(omega) by simp(ha)
  have al: seq_len(A.areas) in omega by arith(rl)
  have i1 i2 := (int_add(B, kx) in omega && int_add(B, ky) in omega by arith(pn, al, hkx, hky))
  have s := mp(all_elim(expand(sep, mallocng.separate), {int_add(B, kx)}, {int_add(B, ky)}), conj(i1, i2), conj(conj(lx, ly), (!(int_add(B, kx) = int_add(B, ky)) by arith(kne, hkx, hky))))
  have rn := apply(mp.regions_nat, hc, hu, ha)
  have tx := apply(at_type[l := RG, t := cart(omega, omega), i := int_add(B, kx)], rn, i1, lx)
  have ty := apply(at_type[l := RG, t := cart(omega, omega), i := int_add(B, ky)], rn, i2, ly)
  have ex: RG[int_add(B, kx)] = mallocng.group_range(A.metas[x]) by simp(ax, rewrite(sym(hkxe), mx), hkxe)
  have ey: RG[int_add(B, ky)] = mallocng.group_range(A.metas[y]) by simp(ay, rewrite(sym(hkye), my), hkye)
  show := rewrite(ey, apply(mp.apart_not, tx, ty, s, rewrite(sym(ex), inx)))
qed

// a group mapped on its own, nesting none: no other group's bytes in its
// range
theorem mp.own_disj(c, A, M, b, brk, g, x, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds(c, A, M, b, brk) ->
  mallocng.is_used(A, g) -> int_lt(0, A.metas[g].maplen) -> (all i. i in omega -> int_lt(i, seq_len(A.slots[g])) -> !(fst(A.slots[g][i]) = 2)) ->
  mallocng.is_used(A, x) -> !(x = g) -> a in omega -> mallocng.in_range(a, mallocng.group_range(A.metas[x])) ->
  !mallocng.in_range(a, mallocng.group_range(A.metas[g]))
proof
  assume hc hu ha H hg mg gnn hx xg hao inx
  have {huo = used} := expand(H, mallocng.holds)
  have {xo = nat, xl = maplen, xm = mem} := apply(mp.used_nat, ha, hx)
  have {go = nat, gm = mem} := apply(mp.used_nat, ha, hg)
  have c1: int_lt(0, A.metas[x].maplen) -> !mallocng.in_range(a, mallocng.group_range(A.metas[g])) proof
    assume mx
    show := apply(mp.reg_two[c := c, A := A, M := M, b := b, brk := brk, x := x, y := g, a := a], hc, hu, ha, H, hx, hg, xg, mx, mg, inx)
  qed
  // nested: within its root's range; its root not g (g nesting none)
  have c2: A.metas[x].maplen = 0 -> !mallocng.in_range(a, mallocng.group_range(A.metas[g])) proof
    assume z
    have {xs = stride, xl2 = last, xse = end} := apply(mp.geo, ha, xo, apply(mp.used_group, huo, hx))
    have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
    have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
    have gr: mallocng.group_range(A.metas[x]) = pair(A.metas[x].mem, int_add(int_sub(int_add(mallocng.UNIT, int_mul(mallocng.stride(A.metas[x]), int_add(A.metas[x].last_idx, 1))), mallocng.IB), 1))
      by defs(simp(z), mallocng.group_range)
    have r1 r2 := (int_le(A.metas[x].mem, a) && int_lt(a, int_add(A.metas[x].mem, int_add(int_sub(int_add(mallocng.UNIT, int_mul(mallocng.stride(A.metas[x]),
      int_add(A.metas[x].last_idx, 1))), mallocng.IB), 1))) by simp(expand(rewrite(gr, inx), mallocng.in_range)))
    have xe := all_elim(xse, {A.metas[x].last_idx})
    have mx: int_mul(mallocng.stride(A.metas[x]), A.metas[x].last_idx) in omega by simp(xs, xl2)
    have a2: int_le(a, mallocng.slot_end(A.metas[x], A.metas[x].last_idx)) by arith(r1, r2, xe, ci, cu, mx, xs, xl2)
    have xb: int_le(int_add(A.metas[x].mem, 12), mallocng.slot_end(A.metas[x], A.metas[x].last_idx)) by arith(xe, mx, xs, xm)
    obtain r, hr hrm hr1 hr2 from apply(mp.root, ha, H, hx)
    have {ro = nat} := apply(mp.used_nat, ha, hr)
    have rg: !(r = g) proof
      assume e
      have g1 := rewrite(e, hr1)
      have g2 := rewrite(e, hr2)
      have ne2: !(A.metas[x].mem = A.metas[g].mem) proof
        assume e2
        show by taut(xg, apply(mp.same_mem[c := c, A := A, M := M, b := b, brk := brk, g := x, h := g], H, hx, hg, e2))
      qed
      have gbx: mp.gb(A, x, A.metas[x].mem) by defs(arith(xb, xm), mp.gb)
      have gbg: mp.gb(A, g, A.metas[x].mem) by defs(arith(g1, g2, xb), mp.gb)
      have ins := apply(mp.laminar[c := c, A := A, M := M, b := b, brk := brk, h := x, k := g, a := A.metas[x].mem], hc, hu, ha, H, hx, hg, arith(g1, ne2), xm, gbx, gbg)
      obtain j6, hj6 hj6l f6 _ _ _ from expand(ins, mp.inside)
      show by taut(mp(all_elim(gnn, {j6}), hj6, hj6l), f6)
    qed
    have inr := apply(mp.group_bytes[A := A, M := M, b := b, h := r, a := a], ha, ro, apply(mp.used_group, huo, hr), hao, arith(hr1, r1), arith(a2, hr2))
    show := apply(mp.reg_two[c := c, A := A, M := M, b := b, brk := brk, x := r, y := g, a := a], hc, hu, ha, H, hr, hg, rg, hrm, mg, inr)
  qed
  show by taut(c1, c2, (int_lt(0, A.metas[x].maplen) || A.metas[x].maplen = 0 by arith(xl)))
qed

// ----------------------------------------------------------------------
//  The state without g: the other groups as they were, a slot nesting g
//  reserved

abbrev mp.dropr(A, A2, g) := used: (all x. mallocng.is_used(A2, x) <-> mallocng.is_used(A, x) && !(x = g)) &&
  metas: (all x. x in omega -> !(x = g) -> A2.metas[x] = A.metas[x]) &&
  slen: (all x. x in omega -> !(x = g) -> seq_len(A2.slots[x]) = seq_len(A.slots[x])) &&
  nest: (all x i. x in omega && i in omega -> !(x = g) -> int_lt(i, seq_len(A.slots[x])) -> A.slots[x][i] = tag(2, g) -> A2.slots[x][i] = tag(3, empty)) &&
  keep: (all x i. x in omega && i in omega -> !(x = g) -> int_lt(i, seq_len(A.slots[x])) -> !(A.slots[x][i] = tag(2, g)) -> A2.slots[x][i] = A.slots[x][i]) &&
  active: A2.active = A.active

// (the state with g's container slot reserved, g given back)
abbrev mp.dropn(A, g, k, h, j) := mp.setu(mp.drop(A, g, k), h, j, tag(3, empty))

// (a slot nesting y: its group and y in use, y not mapped)
theorem mp.nested_used(c, A, M, b, brk, x, i, y): A in mallocng.Abs -> mallocng.holds(c, A, M, b, brk) -> x in omega -> i in omega ->
  int_lt(i, seq_len(A.slots[x])) -> A.slots[x][i] = tag(2, y) ->
  used: mallocng.is_used(A, x) && inner: mallocng.is_used(A, y) && unmapped: A.metas[y].maplen = 0
proof
  assume ha H hx hi hil e
  have {huo = used, hn = normal} := expand(H, mallocng.holds)
  have {nu = unused} := expand(hn, mallocng.normal)
  have xu: mallocng.is_used(A, x) proof
    have n: !mallocng.is_used(A, x) -> false proof
      assume nx
      have _ z := mp(all_elim(nu, {x}), hx, nx)
      show by arith(z, hi, hil)
    qed
    show by taut(n)
  qed
  have {psl = slots} := expand(apply(mp.used_group, huo, xu), mallocng.group_ok)
  have so := mp(all_elim(psl, {i}), hi, hil)
  have s0: ((mallocng.is_used(A, y) && A.metas[y].maplen = 0) && mallocng.hdr_free(b, A.metas[y].mem)) &&
      mallocng.frame_ok(M, A.metas[x], i, A.metas[y].mem, int_sub(int_add(mallocng.UNIT, int_mul(mallocng.stride(A.metas[y]), int_add(A.metas[y].last_idx, 1))), mallocng.IB), 6)
    by simp(expand(rewrite(e, so), mallocng.slot_ok))
  have yu ym _ _ := s0
  show by taut(xu, yu, ym)
qed

// a group mapped on its own given back: none nests it
theorem mp.dropr_own(c, A, M, b, brk, g, k): A in mallocng.Abs -> mallocng.holds(c, A, M, b, brk) -> k in omega -> int_lt(k, seq_len(A.used)) -> A.used[k] = g ->
  int_lt(0, A.metas[g].maplen) -> mp.dropr(A, mp.drop(A, g, k), g)
proof
  assume ha H hk hkl hkg mg
  let D := mp.drop(A, g, k)
  have {hp = part} := expand(H, mallocng.holds)
  have c1: all x. mallocng.is_used(D, x) <-> mallocng.is_used(A, x) && !(x = g) proof
    fix x
    show := apply(mp.drop_used[A := A, g := g, k := k, h := x], ha, hp, hk, hkl, hkg)
  qed
  have c2: all x. x in omega -> !(x = g) -> D.metas[x] = A.metas[x] proof
    fix x
    assume hx ne
    show by simp(mp(app_update_other[f := A.metas, k := g, v := mallocng.ZERO_META, x := x], ne))
  qed
  have es: all x. !(x = g) -> D.slots[x] = A.slots[x] proof
    fix x
    assume ne
    show by simp(mp(app_update_other[f := A.slots, k := g, v := mp.nosl(), x := x], ne))
  qed
  have c3: all x. x in omega -> !(x = g) -> seq_len(D.slots[x]) = seq_len(A.slots[x]) proof
    fix x
    assume hx ne
    show by simp(mp(all_elim(es, {x}), ne))
  qed
  have c4: all x i. x in omega && i in omega -> !(x = g) -> int_lt(i, seq_len(A.slots[x])) -> A.slots[x][i] = tag(2, g) -> D.slots[x][i] = tag(3, empty) proof
    fix x i
    assume ho ne hil e
    have hx hi := ho
    have {un = unmapped} := apply(mp.nested_used[c := c, A := A, M := M, b := b, brk := brk, x := x, i := i, y := g], ha, H, hx, hi, hil, e)
    have f: false by arith(un, mg)
    show by taut(f)
  qed
  have c5: all x i. x in omega && i in omega -> !(x = g) -> int_lt(i, seq_len(A.slots[x])) -> !(A.slots[x][i] = tag(2, g)) -> D.slots[x][i] = A.slots[x][i] proof
    fix x i
    assume ho ne hil n2
    show by simp(mp(all_elim(es, {x}), ne))
  qed
  have c6: D.active = A.active by simp()
  show by taut(c1, c2, c3, c4, c5, c6)
qed

// a nested group given back: its container's slot reserved
theorem mp.dropr_nest(c, A, M, b, brk, g, k, h, j): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds(c, A, M, b, brk) ->
  k in omega -> int_lt(k, seq_len(A.used)) -> A.used[k] = g -> mallocng.is_used(A, h) -> j in omega -> int_lt(j, seq_len(A.slots[h])) -> A.slots[h][j] = tag(2, g) ->
  mp.dropr(A, mp.dropn(A, g, k, h, j), g)
proof
  assume hc hu ha H hk hkl hkg hh hj hjl ehj
  let D := mp.drop(A, g, k)
  let N := mp.dropn(A, g, k, h, j)
  have {hp = part} := expand(H, mallocng.holds)
  have {gm = mem, hm = hmem, hst = start, hhd = hdr} := apply(mp.nest_geo[c := c, A := A, M := M, b := b, brk := brk, h := h, j := j, g := g], ha, H, hh, hj, hjl, ehj)
  have hg: !(h = g) proof
    assume e
    show by arith(rewrite(e, hhd), rewrite(e, hst), gm)
  qed
  have {ho = nat} := apply(mp.used_nat, ha, hh)
  have c1: all x. mallocng.is_used(N, x) <-> mallocng.is_used(A, x) && !(x = g) proof
    fix x
    have e: mallocng.is_used(N, x) = mallocng.is_used(D, x) by defs(simp(), mallocng.is_used)
    show := rewrite(sym(e), apply(mp.drop_used[A := A, g := g, k := k, h := x], ha, hp, hk, hkl, hkg))
  qed
  have c2: all x. x in omega -> !(x = g) -> N.metas[x] = A.metas[x] proof
    fix x
    assume hx ne
    show by simp(mp(app_update_other[f := A.metas, k := g, v := mallocng.ZERO_META, x := x], ne))
  qed
  have dh := mp(app_update_other[f := A.slots, k := g, v := mp.nosl(), x := h], hg)
  have nsh: N.slots[h] = fn_update(A.slots[h], j, tag(3, empty)) by simp(dh)
  have nso: all x. !(x = h) -> !(x = g) -> N.slots[x] = A.slots[x] proof
    fix x
    assume nh ng
    have d1 := mp(app_update_other[f := A.slots, k := g, v := mp.nosl(), x := x], ng)
    have d2 := mp(app_update_other[f := fn_update(A.slots, g, mp.nosl()), k := h, v := fn_update(fn_update(A.slots, g, mp.nosl())[h], j, tag(3, empty)), x := x], nh)
    show by simp(d1, d2)
  qed
  have slt: A.slots[h] in list_type(mallocng.Use) := mp(fn_space_app[a := omega, b := list_type(mallocng.Use), f := A.slots, x := h], simp(ha), ho)
  have r0: tag(3, empty) in set_image(single(empty), x0. tag(3, x0)) by taut(set_image_def[s := single(empty), f := x0. tag(3, x0), y := tag(3, empty)],
    (ex x0. x0 in single(empty) && tag(3, x0) = tag(3, empty) by ex_intro({empty}, taut(single_intro[a := empty], refl({tag(3, empty)})))))
  have r3: tag(3, empty) in mallocng.Use by defs(simp(r0), mallocng.Use)
  have {lu = len} := apply(mp.list_upd[l := A.slots[h], t := mallocng.Use, i := j, v := tag(3, empty)], slt, hj, hjl, r3)
  have c3: all x. x in omega -> !(x = g) -> seq_len(N.slots[x]) = seq_len(A.slots[x]) proof
    fix x
    assume hx ne
    have d1: x = h -> seq_len(N.slots[x]) = seq_len(A.slots[x]) proof
      assume e
      show := subst({y. seq_len(N.slots[y]) = seq_len(A.slots[y])}, sym(e), trans((seq_len(N.slots[h]) = seq_len(fn_update(A.slots[h], j, tag(3, empty))) by simp(nsh)), lu))
    qed
    have d2: !(x = h) -> seq_len(N.slots[x]) = seq_len(A.slots[x]) proof
      assume nh
      show by simp(mp(all_elim(nso, {x}), nh, ne))
    qed
    show by taut(d1, d2)
  qed
  have c4: all x i. x in omega && i in omega -> !(x = g) -> int_lt(i, seq_len(A.slots[x])) -> A.slots[x][i] = tag(2, g) -> N.slots[x][i] = tag(3, empty) proof
    fix x i
    assume ho2 ne hil e
    have hx hi := ho2
    have {xu = used} := apply(mp.nested_used[c := c, A := A, M := M, b := b, brk := brk, x := x, i := i, y := g], ha, H, hx, hi, hil, e)
    have xh ij := apply(mp.nest_once[c := c, A := A, M := M, b := b, brk := brk, x := x, i := i, h := h, j := j, g := g], hc, hu, ha, H, xu, hh, hi, hil, hj, hjl, e, ehj)
    have nj: N.slots[h][j] = tag(3, empty) by simp(nsh)
    show := subst({y. N.slots[y][i] = tag(3, empty)}, sym(xh), subst({y. N.slots[h][y] = tag(3, empty)}, sym(ij), nj))
  qed
  have c5: all x i. x in omega && i in omega -> !(x = g) -> int_lt(i, seq_len(A.slots[x])) -> !(A.slots[x][i] = tag(2, g)) -> N.slots[x][i] = A.slots[x][i] proof
    fix x i
    assume ho2 ne hil n2
    have d1: x = h -> N.slots[x][i] = A.slots[x][i] proof
      assume e
      have ij: !(i = j) proof
        assume e2
        show by taut(n2, subst({y. A.slots[y][i] = tag(2, g)}, sym(e), subst({y. A.slots[h][y] = tag(2, g)}, sym(e2), ehj)))
      qed
      have u := mp(app_update_other[f := A.slots[h], k := j, v := tag(3, empty), x := i], ij)
      show := subst({y. N.slots[y][i] = A.slots[y][i]}, sym(e), (N.slots[h][i] = A.slots[h][i] by simp(nsh, u)))
    qed
    have d2: !(x = h) -> N.slots[x][i] = A.slots[x][i] proof
      assume nh
      show by simp(mp(all_elim(nso, {x}), nh, ne))
    qed
    show by taut(d1, d2)
  qed
  have c6: N.active = A.active by simp()
  show by taut(c1, c2, c3, c4, c5, c6)
qed

// (g off every active list: not linked)
theorem mp.nolist(c, A, M, b, brk, g): mallocng.holds(c, A, M, b, brk) -> mallocng.is_used(A, g) -> A.metas[g].next = 0 ->
  all sc k. sc in omega && k in omega -> int_lt(sc, 48) -> int_lt(k, seq_len(A.active[sc])) -> !(A.active[sc][k] = g)
proof
  assume H hg nx
  have {huo = used, hac = active} := expand(H, mallocng.holds)
  have {lk = linked} := expand(apply(mp.used_group, huo, hg), mallocng.group_ok)
  fix sc k
  assume ho hs hkl e
  have hs0 hk := ho
  have _ isc _ := mp(all_elim(expand(hac, mallocng.active_ok), {sc}, {k}), ho, conj(hs, hkl))
  have sce: A.metas[g].sizeclass = sc := rewrite(e, isc)
  have l1: int_lt(A.metas[g].sizeclass, 48) := rewrite(sym(sce), hs)
  have l2: ex x0. x0 in omega && (int_lt(x0, seq_len(A.active[A.metas[g].sizeclass])) && A.active[A.metas[g].sizeclass][x0] = g)
    by ex_intro({k}, taut(hk, rewrite(sym(sce), hkl), rewrite(sym(sce), e)))
  show by taut(lk, l1, l2, nx)
qed

// the groups in use: the others as they were
theorem mp.dr_used_ok(c, A, A2, M, b, brk, g): A in mallocng.Abs -> mallocng.holds(c, A, M, b, brk) -> mallocng.is_used(A, g) ->
  mallocng.emptied(A, g) -> mp.dropr(A, A2, g) -> mallocng.used_ok(A2, M, b)
proof
  assume ha H hg emp dr
  have {du = used, dm = metas, dl = slen, dn = nest, dk = keep, da = active} := dr
  have {huo = used} := expand(H, mallocng.holds)
  have em1 _ := expand(emp, mallocng.emptied)
  have ul: A.used in list_type(omega) by simp(ha)
  have r: all x0. x0 in omega -> int_lt(x0, seq_len(A2.used)) -> mallocng.group_ok(A2, M, b, A2.used[x0]) proof
    fix k
    assume hk hkl
    let x := A2.used[k]
    have iu2: mallocng.is_used(A2, x) by defs(ex_intro({k}, taut(hk, hkl, refl({x}))), mallocng.is_used)
    have iu xg := (mallocng.is_used(A, x) && !(x = g) by taut(all_elim(du, {x}), iu2))
    have {xo = nat} := apply(mp.used_nat, ha, iu)
    have gok := apply(mp.used_group, huo, iu)
    have ssl: all i. i in omega -> int_lt(i, seq_len(A.slots[x])) -> A2.slots[x][i] = A.slots[x][i] || (fst(A.slots[x][i]) = 2 && A2.slots[x][i] = tag(3, empty)) proof
      fix i
      assume hi hil
      have d1: A.slots[x][i] = tag(2, g) -> fst(A.slots[x][i]) = 2 && A2.slots[x][i] = tag(3, empty) proof
        assume e
        show by taut((fst(A.slots[x][i]) = 2 by simp(e)), mp(all_elim(dn, {x}, {i}), conj(xo, hi), xg, hil, e))
      qed
      have d2: !(A.slots[x][i] = tag(2, g)) -> A2.slots[x][i] = A.slots[x][i] := mp(all_elim(dk, {x}, {i}), conj(xo, hi), xg, hil)
      show by taut(d1, d2)
    qed
    have snu: all i. i in omega -> int_lt(i, seq_len(A.slots[x])) -> A2.slots[x][i] = A.slots[x][i] -> fst(A.slots[x][i]) = 2 ->
        mallocng.is_used(A2, snd(A.slots[x][i])) && A2.metas[snd(A.slots[x][i])] = A.metas[snd(A.slots[x][i])] proof
      fix i
      assume hi hil e f2
      have slt: A.slots[x] in list_type(mallocng.Use) := mp(fn_space_app[a := omega, b := list_type(mallocng.Use), f := A.slots, x := x], simp(ha), xo)
      have ut := apply(at_type[l := A.slots[x], t := mallocng.Use, i := i], slt, hi, hil)
      let y := snd(A.slots[x][i])
      have ue: A.slots[x][i] = tag(2, y) by simp(apply(mp.use_eta, ut), f2)
      have {yu = inner} := apply(mp.nested_used[c := c, A := A, M := M, b := b, brk := brk, x := x, i := i, y := y], ha, H, xo, hi, hil, ue)
      have {yo = nat} := apply(mp.used_nat, ha, yu)
      have yg: !(y = g) proof
        assume eg
        have e2: A.slots[x][i] = tag(2, g) := rewrite(eg, ue)
        have r3 := mp(all_elim(dn, {x}, {i}), conj(xo, hi), xg, hil, e2)
        have f: false by defs(simp(trans(sym(r3), trans(e, e2))), tag)
        show by taut(f)
      qed
      show by taut(all_elim(du, {y}), yu, yg, mp(all_elim(dm, {y}), yo, yg))
    qed
    have ne: A.metas[x].maplen = 0 -> ex x0. ex x1. (x0 in omega && x1 in omega) &&
        ((int_lt(x0, seq_len(A2.used)) && int_lt(x1, seq_len(A2.slots[A2.used[x0]]))) && A2.slots[A2.used[x0]][x1] = tag(2, x)) proof
      assume z
      have {nst = nested} := expand(gok, mallocng.group_ok)
      obtain k0 i0, hk0 hi0 hk0l hi0l hs0 from mp(nst, z)
      let p := A.used[k0]
      have po := apply(at_type[l := A.used, t := omega, i := k0], ul, hk0, hk0l)
      have pu: mallocng.is_used(A, p) by defs(ex_intro({k0}, taut(hk0, hk0l, refl({p}))), mallocng.is_used)
      have pg: !(p = g) proof
        assume e
        have q := mp(all_elim(em1, {i0}), hi0, rewrite(e, hi0l))
        have s1 := rewrite(e, hs0)
        have f: false by taut(q, (!(A.slots[g][i0] = tag(0, empty)) by defs(simp(s1), tag)), (!(A.slots[g][i0] = tag(3, empty)) by defs(simp(s1), tag)))
        show by taut(f)
      qed
      have nt: !(A.slots[p][i0] = tag(2, g)) proof
        assume e
        have f: x = g by defs(simp(trans(sym(hs0), e)), tag)
        show by taut(f, xg)
      qed
      have s2: A2.slots[p][i0] = tag(2, x) := trans(mp(all_elim(dk, {p}, {i0}), conj(po, hi0), pg, hi0l, nt), hs0)
      have pu2: mallocng.is_used(A2, p) by taut(all_elim(du, {p}), pu, pg)
      obtain k2, hk2 hk2l hk2e from expand(pu2, mallocng.is_used)
      have l2: int_lt(i0, seq_len(A2.slots[p])) := rewrite(sym(mp(all_elim(dl, {p}), po, pg)), hi0l)
      show by ex_intro({k2}, {i0}, taut(hk2, hi0, hk2l, rewrite(sym(hk2e), l2), rewrite(sym(hk2e), s2)))
    qed
    show := apply(mp.grp_abs[A := A, A2 := A2, M := M, b := b, h := x], ha, xo, gok, mp(all_elim(dm, {x}), xo, xg), da, mp(all_elim(dl, {x}), xo, xg), ssl, snu, ne)
  qed
  show by defs(r, mallocng.used_ok)
qed

// the lists: g on none, the listed groups as they were; the blocks in the
// same slots
theorem mp.dr_lists(c, A, A2, M, b, brk, g): A in mallocng.Abs -> mallocng.holds(c, A, M, b, brk) -> mallocng.is_used(A, g) -> A.metas[g].next = 0 ->
  mallocng.emptied(A, g) -> mp.dropr(A, A2, g) ->
  active: mallocng.active_ok(A2) && partial: mallocng.partial_ok(A2, M) && reuse: mallocng.reuse_ok(A2) && in_slots: mallocng.blocks_ok(A2, b)
proof
  assume ha H hg nx emp dr
  have {du = used, dm = metas, dl = slen, dn = nest, dk = keep, da = active} := dr
  have {hac = active, hpo = partial, hre = reuse, hin = in_slots} := expand(H, mallocng.holds)
  have em1 _ := expand(emp, mallocng.emptied)
  have nl := apply(mp.nolist[c := c, A := A, M := M, b := b, brk := brk, g := g], H, hg, nx)
  have ac0 := expand(hac, mallocng.active_ok)
  // (a listed group: not g, in use)
  have lg: all sc x. sc in omega -> int_lt(sc, 48) -> mallocng.on_list(A.active[sc], x) -> !(x = g) && mallocng.is_used(A, x) proof
    fix sc x
    assume hs hsl ol
    obtain k, hk hkl hke from expand(ol, mallocng.on_list)
    have ne: !(x = g) proof
      assume e
      show by taut(mp(all_elim(nl, {sc}, {k}), conj(hs, hk), hsl, hkl), trans(hke, e))
    qed
    have iu _ _ := mp(all_elim(ac0, {sc}, {k}), conj(hs, hk), conj(hsl, hkl))
    show by taut(ne, rewrite(hke, iu))
  qed
  have r1: all x0. all x1. x0 in omega && x1 in omega -> int_lt(x0, 48) && int_lt(x1, seq_len(A.active[x0])) ->
      (mallocng.is_used(A2, A.active[x0][x1]) && A2.metas[A.active[x0][x1]].sizeclass = x0) &&
      (int_lt(0, x1) -> A2.metas[A.active[x0][x1]].avail = 0 && !(A2.metas[A.active[x0][x1]].freed = 0)) proof
    fix sc k
    assume ho hq
    have hs hk := ho
    have hsl hkl := hq
    let x := A.active[sc][k]
    have ol: mallocng.on_list(A.active[sc], x) by defs(ex_intro({k}, taut(hk, hkl, refl({x}))), mallocng.on_list)
    have xg iu := mp(all_elim(lg, {sc}, {x}), hs, hsl, ol)
    have {xo = nat} := apply(mp.used_nat, ha, iu)
    have e := mp(all_elim(dm, {x}), xo, xg)
    have a1 a2 a3 := mp(all_elim(ac0, {sc}, {k}), ho, hq)
    show by taut(all_elim(du, {x}), iu, xg, rewrite(sym(e), a2), rewrite(sym(e), a3))
  qed
  have act2: mallocng.active_ok(A2) by defs(rewrite(sym(da), r1), mallocng.active_ok)
  have pk: mp.partial_kept(A, A2, M, M) proof
    fix sc x
    assume hn hs ol p2
    have hs0 _ := hn
    have ol0 := rewrite(da, ol)
    have xg iu := mp(all_elim(lg, {sc}, {x}), hs0, hs, ol0)
    have {xo = nat} := apply(mp.used_nat, ha, iu)
    have e := mp(all_elim(dm, {x}), xo, xg)
    have q: mallocng.partial(M, A, x) by defs(rewrite(e, expand(p2, mallocng.partial)), mallocng.partial)
    show by taut(ol0, q, (mallocng.stride(A2.metas[x]) = mallocng.stride(A.metas[x]) by simp(e)), (A2.metas[x].last_idx = A.metas[x].last_idx by simp(e)))
  qed
  have par2 := apply(mp.partial_mono[A := A, A2 := A2, M := M, M2 := M], hpo, pk)
  have r0 := expand(hre, mallocng.reuse_ok)
  have u: all sc x. sc in omega && x in omega -> int_lt(sc, 48) && mallocng.on_list(A2.active[sc], x) && mallocng.has_unused(A2, x) ->
      !mallocng.own_mapping(A2.metas[x]) proof
    fix sc x
    assume hn hp
    have l0 o2 u2 := hp
    have hs0 xo := hn
    have ol0 := rewrite(da, o2)
    have xg _ := mp(all_elim(lg, {sc}, {x}), hs0, l0, ol0)
    have e := mp(all_elim(dm, {x}), xo, xg)
    obtain i, hi hil hie from expand(u2, mallocng.has_unused)
    have il: int_lt(i, seq_len(A.slots[x])) := rewrite(mp(all_elim(dl, {x}), xo, xg), hil)
    have nt: !(A.slots[x][i] = tag(2, g)) proof
      assume e2
      have r3 := mp(all_elim(dn, {x}, {i}), conj(xo, hi), xg, il, e2)
      have f: false by defs(simp(trans(sym(r3), hie)), tag)
      show by taut(f)
    qed
    have s0: A.slots[x][i] = tag(0, empty) := trans(sym(mp(all_elim(dk, {x}, {i}), conj(xo, hi), xg, il, nt)), hie)
    have hu: mallocng.has_unused(A, x) by defs(ex_intro({i}, taut(hi, il, s0)), mallocng.has_unused)
    have nm := mp(all_elim(r0, {sc}, {x}), hn, taut(l0, ol0, hu))
    show := rewrite(sym(e), nm)
  qed
  have reu2: mallocng.reuse_ok(A2) by defs(taut(u), mallocng.reuse_ok)
  // the blocks: in slots of groups other than g (whose slots are none's)
  have x1 := expand(hin, mallocng.blocks_ok)
  have ul: A.used in list_type(omega) by simp(ha)
  have rb: all x0. x0 in bits(64) -> !(b[x0] = none) -> (ex x1. ex x2. (x1 in omega && x2 in omega) && ((int_lt(x1, seq_len(A2.used)) &&
      int_lt(x2, seq_len(A2.slots[A2.used[x1]]))) && A2.slots[A2.used[x1]][x2] = tag(1, x0))) proof
    fix p
    assume hp hn
    obtain k j, hk hj hkl hjl hs from mp(all_elim(x1, {p}), hp, hn)
    let s := A.used[k]
    have so := mp(at_type[l := A.used, t := omega, i := k], ul, hk, hkl)
    have su: mallocng.is_used(A, s) by defs(ex_intro({k}, taut(hk, hkl, refl({s}))), mallocng.is_used)
    have sg: !(s = g) proof
      assume e
      have q := mp(all_elim(em1, {j}), hj, rewrite(e, hjl))
      have s1 := rewrite(e, hs)
      have f: false by taut(q, (!(A.slots[g][j] = tag(0, empty)) by defs(simp(s1), tag)), (!(A.slots[g][j] = tag(3, empty)) by defs(simp(s1), tag)))
      show by taut(f)
    qed
    have nt: !(A.slots[s][j] = tag(2, g)) by defs(simp(hs), tag)
    have s2: A2.slots[s][j] = tag(1, p) := trans(mp(all_elim(dk, {s}, {j}), conj(so, hj), sg, hjl, nt), hs)
    have su2: mallocng.is_used(A2, s) by taut(all_elim(du, {s}), su, sg)
    obtain k2, hk2 hk2l hk2e from expand(su2, mallocng.is_used)
    have l2: int_lt(j, seq_len(A2.slots[s])) := rewrite(sym(mp(all_elim(dl, {s}), so, sg)), hjl)
    show by ex_intro({k2}, {j}, taut(hk2, hj, hk2l, rewrite(sym(hk2e), l2), rewrite(sym(hk2e), s2)))
  qed
  have bl2: mallocng.blocks_ok(A2, b) by defs(rb, mallocng.blocks_ok)
  show by taut(act2, par2, reu2, bl2)
qed
