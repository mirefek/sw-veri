// A big request's group (malloc's own mapping): the meta taken last, m, now
// describes a group of one slot on fresh pages of its own -- class 63, no
// mask bit set, its slot reserved (malloc frames its block there): its
// record written, its header pointing back, the pages otherwise zero.
// Fresh pages were unmapped and the taken meta's bytes not the
// allocator's: what the invariant read before is as it was; it reads m's
// record and the group's bytes but the slot's interior too. The invariant
// kept.
//
//   checked after proofs/mallocng/model/blockframe.core

// ----------------------------------------------------------------------
//  The new group in the abstract state

// m in use at place k, its record V, its one slot reserved (the state with
// a group of one unused slot, mp.ngrp, but for that slot)
abbrev mp.bgrp(A, k, T, m, V) := fn_update(mp.ngrp(A, k, T, m, V, 1), "slots", fn_update(A.slots, m, fn_build(1, i. tag(3, empty))))

theorem mp.bgrp_type(A, k, T, m, V): A in mallocng.Abs -> k in omega -> int_le(k, seq_len(A.used)) -> T in list_type(omega) -> m in omega ->
  V in mallocng.MetaV ->
  abs: mp.bgrp(A, k, T, m, V) in mallocng.Abs && univ: mp.bgrp(A, k, T, m, V) in univ(1)
proof
  assume ha hk hkl ht hm hv
  let K := insert("secret", insert("init_done", insert("auxv_at", insert("auxv", insert("areas", insert("avail_cnt", insert("reserve", insert("reserve_cnt", insert("free_metas", insert("used", insert("metas", insert("active", insert("slots", insert("brk", insert("taken", empty)))))))))))))))
  let U := mp.ins_at(A.used, k, m)
  let MS := fn_update(A.metas, m, V)
  let SL0 := fn_update(A.slots, m, fn_build(1, i. tag(0, empty)))
  let SL := fn_update(A.slots, m, fn_build(1, i. tag(3, empty)))
  let A1 := fn_update(A, "used", U)
  let A2 := fn_update(A1, "taken", T)
  let A3 := fn_update(A2, "metas", MS)
  have ap af ad := (A in powerset(cart(K, univ(1))) && is_fun(A) && dom(A) = K by simp(expand(ha, mallocng.Abs)))
  have ul: A.used in list_type(omega) by simp(ha)
  have _ ut _ := apply(mp.ins_app[l := A.used, k := k, x := m, j := 0], ul, hk, hkl, hm)
  have lu := apply(mp.list_univ, omega_univ)
  have uu: U in univ(1) := mp(mp(univ_trans[u := 1, a := U, b := list_type(omega)], lu), ut)
  have tu: T in univ(1) := mp(mp(univ_trans[u := 1, a := T, b := list_type(omega)], lu), ht)
  have ms: A.metas in fn_space(omega, mallocng.MetaV) by simp(ha)
  have mss := apply(mp.space_upd[a := omega, b := mallocng.MetaV, f := A.metas, k := m, v := V], ms, hm, hv)
  have msu := mp(fn_space_univ[u := 1, a := omega, b := mallocng.MetaV, f := MS], omega_univ, mp.metav_univ, mss)
  // (one slot, reserved: a list of uses)
  have r3: tag(3, empty) in set_image(single(empty), x0. tag(3, x0)) by taut(set_image_def[s := single(empty), f := x0. tag(3, x0), y := tag(3, empty)],
    (ex x0. x0 in single(empty) && tag(3, x0) = tag(3, empty) by ex_intro({empty}, taut(single_intro[a := empty], refl({tag(3, empty)})))))
  have u3: tag(3, empty) in mallocng.Use by defs(simp(r3), mallocng.Use)
  have nl: fn_build(1, i. tag(3, empty)) in list_type(mallocng.Use) := apply(build_list[d := 1, v := i. tag(3, empty), t := mallocng.Use], simp(),
    (all i. i in 1 -> tag(3, empty) in mallocng.Use by simp(u3)))
  have ss: A.slots in fn_space(omega, list_type(mallocng.Use)) by simp(ha)
  have sls := apply(mp.space_upd[a := omega, b := list_type(mallocng.Use), f := A.slots, k := m, v := fn_build(1, i. tag(3, empty))], ss, hm, nl)
  have luu := mp(mp.list_univ[t := mallocng.Use], mp.use_univ)
  have slu := mp(fn_space_univ[u := 1, a := omega, b := list_type(mallocng.Use), f := SL], omega_univ, luu, sls)
  have p1 := apply(mp.pow_upd[K := K, B := univ(1), r := A, k := "used", v := U], ap, simp(), uu)
  have f1 d1 := mp(fn_update_fd[f := A, k := "used", v := U, d := K], af, ad, simp())
  have p2 := apply(mp.pow_upd[K := K, B := univ(1), r := A1, k := "taken", v := T], p1, simp(), tu)
  have f2 d2 := mp(fn_update_fd[f := A1, k := "taken", v := T, d := K], f1, d1, simp())
  have p3 := apply(mp.pow_upd[K := K, B := univ(1), r := A2, k := "metas", v := MS], p2, simp(), msu)
  have f3 d3 := mp(fn_update_fd[f := A2, k := "metas", v := MS, d := K], f2, d2, simp())
  have p4 := apply(mp.pow_upd[K := K, B := univ(1), r := A3, k := "slots", v := SL], p3, simp(), slu)
  have f4 d4 := mp(fn_update_fd[f := A3, k := "slots", v := SL, d := K], f3, d3, simp())
  have au := mp(rec_univ[u := 1, k := K, r := A], simp(x86.insert_univ), ap, af, ad)
  have a4: fn_update(A3, "slots", SL) in mallocng.Abs by defs(simp(p4, f4, d4, ut, ht, mss, sls, uu, tu, msu, slu, au, expand(ha, mallocng.Abs)), mallocng.Abs)
  have u4 := mp(rec_univ[u := 1, k := K, r := fn_update(A3, "slots", SL)], simp(x86.insert_univ), p4, f4, d4)
  // (the state: the unused slot's update overwritten)
  have tw: mp.bgrp(A, k, T, m, V) = fn_update(A3, "slots", SL) := fn_update_twice[f := A3, k := "slots", a := SL0, b := SL]
  show by taut(rewrite(sym(tw), a4), rewrite(sym(tw), u4))
qed

// (the groups in use: the old ones and m)
theorem mp.bg_used(A, k, T, m, V, g): A in mallocng.Abs -> k in omega -> int_le(k, seq_len(A.used)) -> m in omega ->
  (mallocng.is_used(mp.bgrp(A, k, T, m, V), g) <-> mallocng.is_used(A, g) || g = m)
proof
  assume ha hk hkl hm
  have e: mallocng.is_used(mp.bgrp(A, k, T, m, V), g) <-> mallocng.is_used(mp.ngrp(A, k, T, m, V, 1), g) by defs(simp(), mallocng.is_used)
  show by taut(e, apply(mp.ng_used[A := A, k := k, T := T, m := m, V := V, n := 1, g := g], ha, hk, hkl, hm))
qed

// (a group in use now: m, or one in use before, as it was)
theorem mp.bg_member(A, k, T, m, V, g): A in mallocng.Abs -> k in omega -> int_le(k, seq_len(A.used)) -> m in omega -> !mallocng.is_used(A, m) ->
  mallocng.is_used(mp.bgrp(A, k, T, m, V), g) ->
  g = m || mallocng.is_used(A, g) && (mp.bgrp(A, k, T, m, V).metas[g] = A.metas[g] && mp.bgrp(A, k, T, m, V).slots[g] = A.slots[g])
proof
  assume ha hk hkl hm nm iu
  let Y := mp.ngrp(A, k, T, m, V, 1)
  let X := mp.bgrp(A, k, T, m, V)
  have iy: mallocng.is_used(Y, g) by defs(simp(expand(iu, mallocng.is_used)), mallocng.is_used)
  have c2: (ex x0. x0 in omega && (int_lt(x0, seq_len(A.used)) && A.used[x0] = g)) && (Y.metas[g] = A.metas[g] && Y.slots[g] = A.slots[g]) ->
      g = m || mallocng.is_used(A, g) && (X.metas[g] = A.metas[g] && X.slots[g] = A.slots[g]) proof
    assume w
    have ex em es := w
    have ia: mallocng.is_used(A, g) by defs(ex, mallocng.is_used)
    have gm: !(g = m) proof
      assume e
      show by taut(rewrite(e, ia), nm)
    qed
    have xm: X.metas[g] = A.metas[g] := trans((X.metas[g] = Y.metas[g] by simp()), em)
    have xs: X.slots[g] = A.slots[g] by simp(mp(app_update_other[f := A.slots, k := m, v := fn_build(1, i. tag(3, empty)), x := g], gm))
    show by taut(ia, xm, xs)
  qed
  show by taut(apply(mp.ng_member[A := A, k := k, T := T, m := m, V := V, n := 1, g := g], ha, hk, hkl, hm, nm, iy), c2)
qed

// (a reserved byte now: reserved before, or in m's slot)
theorem mp.bg_inres(A, k, T, m, V, a): A in mallocng.Abs -> k in omega -> int_le(k, seq_len(A.used)) -> m in omega -> !mallocng.is_used(A, m) ->
  (mallocng.in_reserved(mp.bgrp(A, k, T, m, V), a) <-> mallocng.in_reserved(A, a) || mallocng.in_slot(V, 0, a))
proof
  assume ha hk hkl hm nm
  let X := mp.bgrp(A, k, T, m, V)
  have xm: X.slots[m] = fn_build(1, i. tag(3, empty)) by simp()
  have xl: seq_len(X.slots[m]) = 1 by defs(rewrite(sym(xm), fn_build_dom[d := 1, v := i. tag(3, empty)]), seq_len)
  have fw: mallocng.in_reserved(X, a) -> mallocng.in_reserved(A, a) || mallocng.in_slot(V, 0, a) proof
    assume w
    obtain g i, hg hi iu hil hs his from expand(w, mallocng.in_reserved)
    have c1: g = m -> mallocng.in_slot(V, 0, a) proof
      assume e
      have i0: i = 0 by arith(rewrite(e, hil), xl, hi)
      show := rewrite(i0, rewrite((X.metas[g] = V by simp(e)), his))
    qed
    have c2: mallocng.is_used(A, g) && (X.metas[g] = A.metas[g] && X.slots[g] = A.slots[g]) -> mallocng.in_reserved(A, a) proof
      assume q
      have ia em es := q
      show by defs(ex_intro({g}, {i}, taut(hg, hi, ia, rewrite(es, hil), rewrite(es, hs), rewrite(em, his))), mallocng.in_reserved)
    qed
    show by taut(apply(mp.bg_member[A := A, k := k, T := T, m := m, V := V, g := g], ha, hk, hkl, hm, nm, iu), c1, c2)
  qed
  have bw1: mallocng.in_reserved(A, a) -> mallocng.in_reserved(X, a) proof
    assume w
    obtain g i, hg hi iu hil hs his from expand(w, mallocng.in_reserved)
    have gm: !(g = m) proof
      assume e
      show by taut(rewrite(e, iu), nm)
    qed
    have es: X.slots[g] = A.slots[g] by simp(mp(app_update_other[f := A.slots, k := m, v := fn_build(1, i. tag(3, empty)), x := g], gm))
    have em: X.metas[g] = A.metas[g] by simp(mp(app_update_other[f := A.metas, k := m, v := V, x := g], gm))
    have ix: mallocng.is_used(X, g) by taut(apply(mp.bg_used[A := A, k := k, T := T, m := m, V := V, g := g], ha, hk, hkl, hm), iu)
    show by defs(ex_intro({g}, {i}, taut(hg, hi, ix, rewrite(sym(es), hil), rewrite(sym(es), hs), rewrite(sym(em), his))), mallocng.in_reserved)
  qed
  have bw2: mallocng.in_slot(V, 0, a) -> mallocng.in_reserved(X, a) proof
    assume w
    have ix: mallocng.is_used(X, m) by taut(apply(mp.bg_used[A := A, k := k, T := T, m := m, V := V, g := m], ha, hk, hkl, hm), refl({m}))
    have j0 := mp(nat_lt_mem[k := 0, n := 1], simp(), simp(), simp())
    have s0: X.slots[m][0] = tag(3, empty) := rewrite(sym(xm), mp(app_fn_build[d := 1, v := i. tag(3, empty), a := 0], j0))
    show by defs(ex_intro({m}, {0}, taut(hm, (0 in omega by simp()), ix, (int_lt(0, seq_len(X.slots[m])) by arith(xl)), s0,
      rewrite(sym((X.metas[m] = V by simp())), w))), mallocng.in_reserved)
  qed
  show by taut(fw, bw1, bw2)
qed

// (the one slot: reserved)
theorem mp.res1_at: fn_build(1, i. tag(3, empty))[0] = tag(3, empty)
proof
  show := mp(app_fn_build[d := 1, v := i. tag(3, empty), a := 0], mp(nat_lt_mem[k := 0, n := 1], simp(), simp(), simp()))
qed

// the group made: its record in memory, its header pointing back, class
// 63, no mask bit set, its one slot reserved (its check byte and its end
// 0); mapped on its own, on no list
theorem mp.bg_self(A2, M, b, m): A2.slots[m] = fn_build(1, i. tag(3, empty)) -> A2.metas[m].last_idx = 0 ->
  mallocng.meta_in_memory(M, m, A2.metas[m]) -> A2.metas[m].sizeclass = 63 ->
  hdr: ((mallocng.rd(M, A2.metas[m].mem, 8) = m && int_mod(A2.metas[m].mem, mallocng.UNIT) = 0) && int_lt(0, A2.metas[m].mem)) ->
  hdr_own: (all a. a in omega -> int_le(A2.metas[m].mem, a) && int_lt(a, int_add(A2.metas[m].mem, mallocng.UNIT)) -> !(a in malloc.live_of(b))) ->
  act: int_mod(mallocng.b8(M, int_add(A2.metas[m].mem, 8)), 32) = 0 ->
  A2.metas[m].avail = 0 -> A2.metas[m].freed = 0 -> int_lt(0, A2.metas[m].maplen) ->
  mapped: (int_mod(A2.metas[m].mem, 4096) = 0 &&
     int_le(int_add(mallocng.UNIT, int_mul(mallocng.stride(A2.metas[m]), int_add(A2.metas[m].last_idx, 1))), int_mul(A2.metas[m].maplen, 4096))) ->
  A2.metas[m].next = 0 -> A2.metas[m].prev = 0 ->
  chk: mallocng.b8(M, int_sub(mallocng.slot_start(A2.metas[m], 0), 4)) = 0 ->
  sentinel: mallocng.b8(M, mallocng.slot_end(A2.metas[m], A2.metas[m].last_idx)) = 0 ->
  chk_own: (all i. i in omega -> int_le(i, int_add(A2.metas[m].last_idx, 1)) -> !(int_sub(mallocng.slot_start(A2.metas[m], i), mallocng.IB) in malloc.live_of(b))) ->
  mallocng.group_ok(A2, M, b, m)
proof
  assume es l0 mim s63 hdr hown act av0 fr0 ml0 mapped enx epv chk sent chko
  let W := A2.metas[m]
  have dn: seq_len(A2.slots[m]) = 1 by defs(rewrite(sym(es), fn_build_dom[d := 1, v := i. tag(3, empty)]), seq_len)
  have ns: seq_len(A2.slots[m]) = int_add(W.last_idx, 1) by arith(dn, l0)
  have t3: !(tag(3, empty) = tag(0, empty)) by defs(simp(), tag)
  have f3: fst(tag(3, empty)) = 3 by defs(simp(), tag)
  // (no bit set; the slot, reserved: not unused)
  have mk: all x0. x0 in omega -> int_lt(x0, 32) ->
      (((mallocng.bit(W.avail, x0) = 1 -> int_le(x0, int_mod(mallocng.b8(M, int_add(W.mem, 8)), 32)) && mallocng.bit(W.freed, x0) = 0) &&
        (int_lt(0, int_add(mallocng.bit(W.avail, x0), mallocng.bit(W.freed, x0))) -> int_le(x0, W.last_idx))) &&
       (int_le(x0, W.last_idx) -> (A2.slots[m][x0] = tag(0, empty) <-> int_lt(0, int_add(mallocng.bit(W.avail, x0), mallocng.bit(W.freed, x0)))) &&
          mallocng.b8(M, int_sub(mallocng.slot_start(W, x0), 4)) = 0)) &&
      (int_lt(int_mod(mallocng.b8(M, int_add(W.mem, 8)), 32), x0) && int_le(x0, W.last_idx) -> mallocng.bit(W.freed, x0) = 1) proof
    fix i
    assume hi hil
    have b0: mallocng.bit(0, i) = 0 by simp(mp(mp.nbit[x := 0, i := i], simp(), hi), mp(bit_zero_none[j := i], hi))
    have ba: mallocng.bit(W.avail, i) = 0 := rewrite(sym(av0), b0)
    have bf: mallocng.bit(W.freed, i) = 0 := rewrite(sym(fr0), b0)
    have z: int_le(i, W.last_idx) -> (A2.slots[m][i] = tag(0, empty) <-> int_lt(0, int_add(mallocng.bit(W.avail, i), mallocng.bit(W.freed, i)))) &&
        mallocng.b8(M, int_sub(mallocng.slot_start(W, i), 4)) = 0 proof
      assume h
      have i0: i = 0 by arith(h, l0, hi)
      have s: A2.slots[m][i] = tag(3, empty) by simp(es, i0, mp.res1_at)
      have n0: !(A2.slots[m][i] = tag(0, empty)) := rewrite(sym(s), t3)
      show by taut(n0, (!int_lt(0, int_add(mallocng.bit(W.avail, i), mallocng.bit(W.freed, i))) by arith(ba, bf)),
        subst({y. mallocng.b8(M, int_sub(mallocng.slot_start(W, y), 4)) = 0}, sym(i0), chk))
    qed
    show by taut(z, (!(mallocng.bit(W.avail, i) = 1) by arith(ba)), (!int_lt(0, int_add(mallocng.bit(W.avail, i), mallocng.bit(W.freed, i))) by arith(ba, bf)),
      (!(int_lt(int_mod(mallocng.b8(M, int_add(W.mem, 8)), 32), i) && int_le(i, W.last_idx)) by arith(act, l0, hi)))
  qed
  have msk: mallocng.masks_ok(A2, M, m) by defs(mk, mallocng.masks_ok)
  have big: mallocng.big_ok(A2, m) by defs(taut(l0, ml0, av0, fr0), mallocng.big_ok)
  have act2: int_le(int_mod(mallocng.b8(M, int_add(W.mem, 8)), 32), W.last_idx) by arith(act, l0)
  have small: mallocng.stride(W) = mallocng.UNIT -> int_mod(mallocng.b8(M, int_add(W.mem, 8)), 32) = W.last_idx by taut(trans(act, sym(l0)))
  have nested: W.maplen = 0 -> (ex x0. ex x1. (x0 in omega && x1 in omega) &&
      ((int_lt(x0, seq_len(A2.used)) && int_lt(x1, seq_len(A2.slots[A2.used[x0]]))) && A2.slots[A2.used[x0]][x1] = tag(2, m))) proof
    assume z
    have f: false by arith(z, ml0)
    show by taut(f)
  qed
  have n48: !int_lt(W.sizeclass, 48) by arith(s63)
  have lk: !(W.next = 0) <-> int_lt(W.sizeclass, 48) && (ex x0. x0 in omega && (int_lt(x0, seq_len(A2.active[W.sizeclass])) && A2.active[W.sizeclass][x0] = m))
    by taut(enx, n48)
  have ul: W.next = 0 -> W.prev = 0 by taut(epv)
  have sl: all x0. x0 in omega -> int_lt(x0, seq_len(A2.slots[m])) -> mallocng.slot_ok(A2, M, b, m, x0, A2.slots[m][x0]) proof
    fix i
    assume hi hil
    have i0: i = 0 by arith(hil, dn, hi)
    have s: A2.slots[m][i] = tag(3, empty) by simp(es, i0, mp.res1_at)
    show by defs(simp(s, t3, f3), mallocng.slot_ok)
  qed
  have offs: int_lt(0, W.last_idx) -> int_le(int_mul(mallocng.stride(W), int_add(W.last_idx, 1)), int_mul(int_pow(2, 16), mallocng.UNIT)) proof
    assume z
    have f: false by arith(z, l0)
    show by taut(f)
  qed
  have sp: int_lt(W.sizeclass, 48) -> int_lt(mallocng.stride(W), int_mul(2, int_mul(mallocng.UNIT, mallocng.size_classes[W.sizeclass]))) by taut(n48)
  have cl: int_lt(W.sizeclass, 48) || W.sizeclass = 63 by taut(s63)
  have mp2: int_lt(0, W.maplen) -> int_mod(W.mem, 4096) = 0 &&
      int_le(int_add(mallocng.UNIT, int_mul(mallocng.stride(W), int_add(W.last_idx, 1))), int_mul(W.maplen, 4096)) by taut(mapped)
  show by defs(taut(mim, cl, hdr, hown, act2, ns, msk, small, mp2, nested, big, lk, ul, sl, sent, chko, offs, sp), mallocng.group_ok)
qed

// ----------------------------------------------------------------------
//  The rest of the invariant: as with a group of an unused slot (the
//  groups, lists, places), its slot but reserved

// (a group's slots but m's: as with the group of an unused slot)
theorem mp.bg_other(A, k, T, m, V, p): !(p = m) -> mp.bgrp(A, k, T, m, V).slots[p] = mp.ngrp(A, k, T, m, V, 1).slots[p]
proof
  assume ne
  show by simp(mp(app_update_other[f := A.slots, k := m, v := fn_build(1, i. tag(3, empty)), x := p], ne),
    mp(app_update_other[f := A.slots, k := m, v := fn_build(1, i. tag(0, empty)), x := p], ne))
qed

// (a slot's use not unused: as with the group of an unused slot)
theorem mp.bg_slot(A, k, T, m, V, p, j, u): mp.ngrp(A, k, T, m, V, 1).slots[p][j] = u -> !(u = tag(0, empty)) -> j in omega ->
  int_lt(j, seq_len(mp.ngrp(A, k, T, m, V, 1).slots[p])) -> mp.bgrp(A, k, T, m, V).slots[p][j] = u
proof
  assume hs hu hj hjl
  let Y := mp.ngrp(A, k, T, m, V, 1)
  have c1: p = m -> false proof
    assume e
    have ym: Y.slots[p] = fn_build(1, i. tag(0, empty)) by simp(e)
    have yl: seq_len(Y.slots[p]) = 1 by defs(rewrite(sym(ym), fn_build_dom[d := 1, v := i. tag(0, empty)]), seq_len)
    have jm := mp(nat_lt_mem[k := j, n := 1], hj, simp(), (int_lt(j, 1) by arith(hjl, yl)))
    have y0: Y.slots[p][j] = tag(0, empty) := rewrite(sym(ym), mp(app_fn_build[d := 1, v := i. tag(0, empty), a := j], jm))
    show by taut(hu, trans(sym(hs), y0))
  qed
  have c2: !(p = m) -> mp.bgrp(A, k, T, m, V).slots[p][j] = u proof
    assume ne
    have e := apply(mp.bg_other[A := A, k := k, T := T, m := m, V := V, p := p], ne)
    show := rewrite(sym(e), hs)
  qed
  show by taut(c1, c2)
qed

// (a group but m's: as with the group of an unused slot)
theorem mp.bg_grp(A, k, T, m, V, M, b, h): !(h = m) -> mallocng.group_ok(mp.ngrp(A, k, T, m, V, 1), M, b, h) -> mallocng.group_ok(mp.bgrp(A, k, T, m, V), M, b, h)
proof
  assume hne gok
  let Y := mp.ngrp(A, k, T, m, V, 1)
  let X := mp.bgrp(A, k, T, m, V)
  have em: X.metas = Y.metas by simp()
  have eu: X.used = Y.used by simp()
  have ea: X.active = Y.active by simp()
  have esh := apply(mp.bg_other[A := A, k := k, T := T, m := m, V := V, p := h], hne)
  have {nested} := expand(gok, mallocng.group_ok)
  have {mim, cls, hdr, hdr_own, act, nslots, masks, small, mapped, big, linked, unlinked, slots, sentinel, chk_own, offs, span} :=
    rewrite(sym(ea), rewrite(sym(esh), rewrite(sym(eu), rewrite(sym(em), expand(gok, mallocng.group_ok, mallocng.masks_ok, mallocng.big_ok, mallocng.slot_ok, mallocng.is_used)))))
  have ne2: X.metas[h].maplen = 0 -> (ex x0. ex x1. (x0 in omega && x1 in omega) &&
      ((int_lt(x0, seq_len(X.used)) && int_lt(x1, seq_len(X.slots[X.used[x0]]))) && X.slots[X.used[x0]][x1] = tag(2, h))) proof
    assume z
    obtain p j, hp hj hpl hjl hs from mp(nested, rewrite(em, z))
    have s2 := apply(mp.bg_slot[A := A, k := k, T := T, m := m, V := V, p := Y.used[p], j := j, u := tag(2, h)], hs, (!(tag(2, h) = tag(0, empty)) by defs(simp(), tag)), hj, hjl)
    have l2: int_lt(j, seq_len(X.slots[Y.used[p]])) proof
      have c1: Y.used[p] = m -> false proof
        assume e
        have ym: Y.slots[Y.used[p]] = fn_build(1, i. tag(0, empty)) by simp(e)
        have yl: seq_len(Y.slots[Y.used[p]]) = 1 by defs(rewrite(sym(ym), fn_build_dom[d := 1, v := i. tag(0, empty)]), seq_len)
        have jm := mp(nat_lt_mem[k := j, n := 1], hj, simp(), (int_lt(j, 1) by arith(hjl, yl)))
        have y0: Y.slots[Y.used[p]][j] = tag(0, empty) := rewrite(sym(ym), mp(app_fn_build[d := 1, v := i. tag(0, empty), a := j], jm))
        show by defs(simp(trans(sym(hs), y0)), tag)
      qed
      have c2: !(Y.used[p] = m) -> int_lt(j, seq_len(X.slots[Y.used[p]])) proof
        assume ne
        have e := apply(mp.bg_other[A := A, k := k, T := T, m := m, V := V, p := Y.used[p]], ne)
        show := rewrite(sym(e), hjl)
      qed
      show by taut(c1, c2)
    qed
    show by ex_intro({p}, {j}, taut(hp, hj, rewrite(sym(eu), hpl), rewrite(sym(eu), l2), rewrite(sym(eu), s2)))
  qed
  show by defs(conj(mim, cls, hdr, hdr_own, act, nslots, masks, small, mapped, ne2, big, linked, unlinked, slots, sentinel, chk_own, offs, span),
    mallocng.group_ok, mallocng.masks_ok, mallocng.big_ok, mallocng.slot_ok, mallocng.is_used)
qed

// the allocator's memory accessible: as before, the new group's bytes but
// its slot's interior (reserved) too
theorem mp.bg_perms(c, A, k, T, m, V, M, b): A in mallocng.Abs -> k in omega -> int_le(k, seq_len(A.used)) -> m in omega -> !mallocng.is_used(A, m) ->
  mallocng.perms_ok(c, A, M, b) ->
  (all a. a in omega -> mallocng.in_range(a, mallocng.group_range(V)) -> !(a in malloc.live_of(b)) -> !mallocng.in_slot(V, 0, a) ->
     mallocng.m_rw(M, a) && !(snd(mallocng.pg(M, a)).kind = 2)) ->
  mallocng.perms_ok(c, mp.bgrp(A, k, T, m, V), M, b)
proof
  assume ha hk hkl hm nm hp hv
  let X := mp.bgrp(A, k, T, m, V)
  have {pd = data, pgr = groups, pa = auxv} := expand(hp, mallocng.perms_ok)
  have xe: mallocng.auxv_ranges(X) = mallocng.auxv_ranges(A) by defs(simp(), mallocng.auxv_ranges)
  have g2: all x0. all x1. x0 in omega && x1 in omega -> (((int_lt(x0, seq_len(X.used)) && int_le(fst(mallocng.group_range(X.metas[X.used[x0]])), x1)) &&
      int_lt(x1, int_add(fst(mallocng.group_range(X.metas[X.used[x0]])), snd(mallocng.group_range(X.metas[X.used[x0]]))))) && !(x1 in malloc.live_of(b))) &&
      !mallocng.in_reserved(X, x1) -> mallocng.m_rw(M, x1) && !(snd(mallocng.pg(M, x1)).kind = 2) proof
    fix j a
    assume ho h
    have hj hao := ho
    have hjl h1 h2 nl nr := h
    let g := X.used[j]
    have iu2: mallocng.is_used(X, g) by defs(ex_intro({j}, taut(hj, hjl, refl({g}))), mallocng.is_used)
    have rv := apply(mp.bg_inres[A := A, k := k, T := T, m := m, V := V, a := a], ha, hk, hkl, hm, nm)
    have c1: g = m -> mallocng.m_rw(M, a) && !(snd(mallocng.pg(M, a)).kind = 2) proof
      assume e
      have ev: X.metas[g] = V by simp(e)
      show := mp(all_elim(hv, {a}), hao, (mallocng.in_range(a, mallocng.group_range(V)) by defs(taut(rewrite(ev, h1), rewrite(ev, h2)), mallocng.in_range)), nl,
        (!mallocng.in_slot(V, 0, a) by taut(rv, nr)))
    qed
    have c2: mallocng.is_used(A, g) && (X.metas[g] = A.metas[g] && X.slots[g] = A.slots[g]) -> mallocng.m_rw(M, a) && !(snd(mallocng.pg(M, a)).kind = 2) proof
      assume w
      have iu em _ := w
      obtain k0, hk0 hk0l hke from expand(iu, mallocng.is_used)
      have nr0: !mallocng.in_reserved(A, a) by taut(nr, rv)
      show := mp(all_elim(pgr, {k0}, {a}), conj(hk0, hao), taut(hk0l, rewrite(sym(hke), rewrite(em, h1)), rewrite(sym(hke), rewrite(em, h2)), nl, nr0))
    qed
    show by taut(apply(mp.bg_member[A := A, k := k, T := T, m := m, V := V, g := g], ha, hk, hkl, hm, nm, iu2), c1, c2)
  qed
  show by defs(taut(pd, g2, rewrite(sym(xe), pa)), mallocng.perms_ok)
qed

// the invariant for the state with the big group, on a view M2 agreeing
// with M at the old groups' bytes and records (the old state's clauses on
// M2 given, the new group as made)
theorem mp.bg_holds(c, A, k, T, m, V, M, M2, b, brk, brk2): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs ->
  b in fn_space(bits(64), option(omega)) -> mallocng.holds(c, A, M, b, brk) ->
  T in list_type(omega) -> A.taken = seq_concat(T, seq_one(m)) -> !(m = 0) -> V in mallocng.MetaV ->
  k in omega -> int_le(k, seq_len(A.used)) ->
  (all j. j in omega -> int_lt(j, k) -> int_lt(A.used[j], m)) -> (all j. j in omega -> int_le(k, j) -> int_lt(j, seq_len(A.used)) -> int_lt(m, A.used[j])) ->
  (all a. a in omega -> mp.ingrp(A, a) -> M2[a] = M[a]) ->
  (all g. all a. mallocng.is_used(A, g) -> a in omega -> int_le(g, a) -> int_lt(a, int_add(g, 40)) -> M2[a] = M[a]) ->
  mallocng.group_ok(mp.bgrp(A, k, T, m, V), M2, b, m) ->
  mallocng.image_ok(c, M2) -> mallocng.ctx_ok(c, mp.bgrp(A, k, T, m, V), M2) -> mallocng.fresh_ok(c, mp.bgrp(A, k, T, m, V), M2) ->
  mallocng.areas_ok(c, A, M2) ->
  (all a. a in omega -> int_le(m, a) -> int_lt(a, int_add(m, mallocng.META_SIZE)) -> mallocng.m_rw(M2, a) && !(snd(mallocng.pg(M2, a)).kind = 2)) ->
  mallocng.brk_ok(mp.bgrp(A, k, T, m, V), brk2) -> mallocng.perms_ok(c, A, M2, b) ->
  (all a. a in omega -> mallocng.in_range(a, mallocng.group_range(V)) -> !(a in malloc.live_of(b)) -> !mallocng.in_slot(V, 0, a) ->
     mallocng.m_rw(M2, a) && !(snd(mallocng.pg(M2, a)).kind = 2)) ->
  mallocng.classes_ok(c, M2) -> mallocng.debruijn_ok(c, M2) ->
  (int_lt(0, V.maplen) -> all i. i in omega -> int_lt(i, seq_len(mallocng.regions(c, A))) -> mallocng.apart(mallocng.group_range(V), mallocng.regions(c, A)[i])) ->
  (all a. a in omega -> mallocng.in_range(a, mallocng.group_range(V)) -> !mallocng.in_ranges(a, mallocng.fixed_ranges(c, A))) ->
  mallocng.holds(c, mp.bgrp(A, k, T, m, V), M2, b, brk2)
proof
  assume hc hu ha hb H ht hte hmz hv hk hkl hlo hhi gbs rcs gm img cok fr ar mrw bk pm gpm cl db sep apt
  let Y := mp.ngrp(A, k, T, m, V, 1)
  let X := mp.bgrp(A, k, T, m, V)
  have {hp = part, huo = used, hac = active, hpa = partial, hre = reuse, hbl = in_slots, hnm = normal, hsp = sep, hwf = wf, hff = fixed, hga = apart} :=
    expand(H, mallocng.holds)
  have {hm = nat, nm = unused} := apply(mp.ng_taken[A := A, T := T, m := m], ha, hp, ht, hte)
  // the old groups on the new memory
  have er: A.metas = A.metas && A.slots = A.slots && A.used = A.used && A.active = A.active by simp()
  have e1 e2 e3 e4 := er
  have u1 := apply(mp.used_tr[A := A, A2 := A, M := M, M2 := M2, b := b], ha, hb, e1, e2, e3, e4, huo, gbs, rcs)
  have p1 := apply(mp.partial_tr[A := A, A2 := A, M := M, M2 := M2, b := b], ha, e1, e4, hac, huo, hpa, gbs)
  // the state with a group of an unused slot
  have {ya = abs, yu = univ} := apply(mp.ngrp_type[A := A, k := k, T := T, m := m, V := V, n := 1], ha, hk, hkl, ht, hm, hv, simp())
  have {a2 = active, p2 = partial, r2 = reuse, b2 = in_slots} := apply(mp.ng_lists[A := A, k := k, T := T, m := m, V := V, n := 1, M := M2, b := b],
    ha, hk, hkl, hm, nm, hac, p1, hre, hbl)
  have pt2 := apply(mp.ng_part[A := A, k := k, T := T, m := m, V := V, n := 1], ha, hp, ht, hte, hk, hkl, hlo, hhi)
  have nm2 := apply(mp.ng_normal[A := A, k := k, T := T, m := m, V := V, n := 1], ha, hnm, hk, hkl, hm, hmz)
  have ar2 := apply(mp.ng_areas[c := c, A := A, k := k, T := T, m := m, V := V, n := 1, M := M2], ha, ht, hte, ar, mrw)
  have sp2 := apply(mp.ng_sep[c := c, A := A, k := k, T := T, m := m, V := V, n := 1], hc, hu, ha, hk, hkl, hm, nm, yu, ya, hsp, sep)
  have ff2 := apply(mp.ng_fixed[c := c, A := A, k := k, T := T, m := m, V := V, n := 1, b := b], hff)
  have ga2 := apply(mp.ng_apart[c := c, A := A, k := k, T := T, m := m, V := V, n := 1], ha, hk, hkl, hm, nm, hga, apt)
  // ... and with its slot reserved: the parts but the slots as before
  have eaX: X.active = Y.active by simp()
  have emX: X.metas = Y.metas by simp()
  have euX: X.used = Y.used by simp()
  have efX: X.free_metas = Y.free_metas by simp()
  have esX: X.areas = Y.areas by simp()
  have ecX: X.avail_cnt = Y.avail_cnt by simp()
  have etX: X.taken = Y.taken by simp()
  have aX: mallocng.active_ok(X) by defs(rewrite(sym(eaX), rewrite(sym(emX), rewrite(sym(euX), expand(a2, mallocng.active_ok, mallocng.is_used)))), mallocng.active_ok, mallocng.is_used)
  have pX: mallocng.partial_ok(X, M2) by defs(rewrite(sym(eaX), rewrite(sym(emX), expand(p2, mallocng.partial_ok, mallocng.partial))), mallocng.partial_ok, mallocng.partial)
  have ptX: mallocng.metas_partition(X) by defs(rewrite(sym(etX), rewrite(sym(ecX), rewrite(sym(esX), rewrite(sym(efX), rewrite(sym(euX),
    expand(pt2, mallocng.metas_partition, mallocng.is_used, mallocng.meta_slot, mallocng.avail_meta)))))),
    mallocng.metas_partition, mallocng.is_used, mallocng.meta_slot, mallocng.avail_meta)
  have xm: X.slots[m] = fn_build(1, i. tag(3, empty)) by simp()
  have xml: seq_len(X.slots[m]) = 1 by defs(rewrite(sym(xm), fn_build_dom[d := 1, v := i. tag(3, empty)]), seq_len)
  // (no unused slot in m's group)
  have hu2: all g. mallocng.has_unused(X, g) -> mallocng.has_unused(Y, g) proof
    fix g
    assume w
    obtain j, hj hjl hs from expand(w, mallocng.has_unused)
    have c1: g = m -> false proof
      assume e
      have jm := mp(nat_lt_mem[k := j, n := 1], hj, simp(), (int_lt(j, 1) by arith(rewrite(e, hjl), xml)))
      have xg: X.slots[g] = fn_build(1, i. tag(3, empty)) := subst({y. X.slots[y] = fn_build(1, i. tag(3, empty))}, sym(e), xm)
      have x0: X.slots[g][j] = tag(3, empty) := rewrite(sym(xg), mp(app_fn_build[d := 1, v := i. tag(3, empty), a := j], jm))
      show by defs(simp(trans(sym(hs), x0)), tag)
    qed
    have c2: !(g = m) -> mallocng.has_unused(Y, g) proof
      assume ne
      have e := apply(mp.bg_other[A := A, k := k, T := T, m := m, V := V, p := g], ne)
      show by defs(ex_intro({j}, taut(hj, rewrite(e, hjl), rewrite(e, hs))), mallocng.has_unused)
    qed
    show by taut(c1, c2)
  qed
  have k3: all x0. all x1. x0 in omega && x1 in omega -> (int_lt(x0, 48) && mallocng.on_list(X.active[x0], x1)) && mallocng.has_unused(X, x1) ->
      !mallocng.own_mapping(X.metas[x1]) proof
    fix sc g
    assume ho w
    have hsl o q := w
    have r := mp(all_elim(expand(r2, mallocng.reuse_ok), {sc}, {g}), ho, taut(hsl, (mallocng.on_list(Y.active[sc], g) by simp(o)), mp(all_elim(hu2, {g}), q)))
    show by simp(r)
  qed
  have reX: mallocng.reuse_ok(X) by defs(k3, mallocng.reuse_ok)
  // (the live blocks: in the old groups' slots)
  have k4: all x0. x0 in bits(64) -> !(b[x0] = none) -> (ex x1. ex x2. (x1 in omega && x2 in omega) &&
      ((int_lt(x1, seq_len(X.used)) && int_lt(x2, seq_len(X.slots[X.used[x1]]))) && X.slots[X.used[x1]][x2] = tag(1, x0))) proof
    fix q
    assume hq hn
    obtain x1 x2, h1 h2 hl1 hl2 hs from mp(all_elim(expand(b2, mallocng.blocks_ok), {q}), hq, hn)
    have s2 := apply(mp.bg_slot[A := A, k := k, T := T, m := m, V := V, p := Y.used[x1], j := x2, u := tag(1, q)], hs, (!(tag(1, q) = tag(0, empty)) by defs(simp(), tag)), h2, hl2)
    have l2: int_lt(x2, seq_len(X.slots[Y.used[x1]])) proof
      have c1: Y.used[x1] = m -> false proof
        assume e
        have ym: Y.slots[Y.used[x1]] = fn_build(1, i. tag(0, empty)) by simp(e)
        have yl: seq_len(Y.slots[Y.used[x1]]) = 1 by defs(rewrite(sym(ym), fn_build_dom[d := 1, v := i. tag(0, empty)]), seq_len)
        have jm := mp(nat_lt_mem[k := x2, n := 1], h2, simp(), (int_lt(x2, 1) by arith(hl2, yl)))
        have y0: Y.slots[Y.used[x1]][x2] = tag(0, empty) := rewrite(sym(ym), mp(app_fn_build[d := 1, v := i. tag(0, empty), a := x2], jm))
        show by defs(simp(trans(sym(hs), y0)), tag)
      qed
      have c2: !(Y.used[x1] = m) -> int_lt(x2, seq_len(X.slots[Y.used[x1]])) proof
        assume ne
        have e := apply(mp.bg_other[A := A, k := k, T := T, m := m, V := V, p := Y.used[x1]], ne)
        show := rewrite(sym(e), hl2)
      qed
      show by taut(c1, c2)
    qed
    show by ex_intro({x1}, {x2}, taut(h1, h2, rewrite(sym(euX), hl1), rewrite(sym(euX), l2), rewrite(sym(euX), s2)))
  qed
  have bX: mallocng.blocks_ok(X, b) by defs(k4, mallocng.blocks_ok)
  // (normal: m in use, the others as before)
  have {nu = unused, ni = init, nr = reserve, nz = zero} := expand(nm2, mallocng.normal)
  have k1: all x0. x0 in omega -> !mallocng.is_used(X, x0) -> X.metas[x0] = mallocng.ZERO_META && seq_len(X.slots[x0]) = 0 proof
    fix x
    assume hx hn
    have hny: !mallocng.is_used(Y, x) by defs(simp(expand(hn, mallocng.is_used)), mallocng.is_used)
    have xne: !(x = m) proof
      assume e
      have im: mallocng.is_used(X, m) by taut(apply(mp.bg_used[A := A, k := k, T := T, m := m, V := V, g := m], ha, hk, hkl, hm), refl({m}))
      show by taut(hn, subst({y. mallocng.is_used(X, y)}, sym(e), im))
    qed
    have z1 z2 := mp(all_elim(nu, {x}), hx, hny)
    have e := apply(mp.bg_other[A := A, k := k, T := T, m := m, V := V, p := x], xne)
    show by taut(trans((X.metas[x] = Y.metas[x] by simp()), z1), rewrite(sym(e), z2))
  qed
  have k5: !mallocng.is_used(X, 0) by defs(simp(expand(nz, mallocng.is_used)), mallocng.is_used)
  have nmX: mallocng.normal(X) by defs(simp(k1, ni, nr, k5, keep(mallocng.is_used, mallocng.ZERO_META)), mallocng.normal)
  have arX: mallocng.areas_ok(c, X, M2) by defs(simp(expand(ar2, mallocng.areas_ok, mallocng.in_taken)), mallocng.areas_ok, mallocng.in_taken)
  have pmX := apply(mp.bg_perms[c := c, A := A, k := k, T := T, m := m, V := V, M := M2, b := b], ha, hk, hkl, hm, nm, pm, gpm)
  have erg: mallocng.regions(c, X) = mallocng.regions(c, Y) by defs(simp(), mallocng.regions)
  have spX := rewrite(sym(erg), sp2)
  have ffX: mallocng.fixed_free(c, X, b) by defs(simp(expand(ff2, mallocng.fixed_free)), mallocng.fixed_free)
  have fe: mallocng.fixed_ranges(c, X) = mallocng.fixed_ranges(c, Y) by defs(simp(), mallocng.fixed_ranges, mallocng.auxv_ranges)
  have gaX: mallocng.groups_apart(c, X) by defs(simp(fe, expand(ga2, mallocng.groups_apart)), mallocng.groups_apart)
  // the groups: the old ones as before, m's as made
  have r: all x0. x0 in omega -> int_lt(x0, seq_len(X.used)) -> mallocng.group_ok(X, M2, b, X.used[x0]) proof
    fix j
    assume hj hjl
    let g := X.used[j]
    have ig: mallocng.is_used(X, g) by defs(ex_intro({j}, taut(hj, hjl, refl({g}))), mallocng.is_used)
    have c1: g = m -> mallocng.group_ok(X, M2, b, g) proof
      assume e
      show := subst({y. mallocng.group_ok(X, M2, b, y)}, sym(e), gm)
    qed
    have c2: mallocng.is_used(A, g) -> !(g = m) -> mallocng.group_ok(X, M2, b, g) proof
      assume iu ne
      have gy := apply(mp.ng_group[A := A, k := k, T := T, m := m, V := V, n := 1, M := M2, b := b, h := g], ha, hk, hkl, hm, nm, iu, apply(mp.used_group, u1, iu))
      show := apply(mp.bg_grp[A := A, k := k, T := T, m := m, V := V, M := M2, b := b, h := g], ne, gy)
    qed
    show by taut(apply(mp.bg_used[A := A, k := k, T := T, m := m, V := V, g := g], ha, hk, hkl, hm), ig, c1, c2)
  qed
  have uo: mallocng.used_ok(X, M2, b) by defs(r, mallocng.used_ok)
  show by defs(taut(img, cok, fr, arX, ptX, uo, aX, pX, reX, bX, nmX, bk, pmX, spX, hwf, cl, db, ffX, gaX), mallocng.holds)
qed

// ----------------------------------------------------------------------
//  The step in memory

// the step from A on vm to mp.bgrp(A, k, T, m, V) on V1: m's record V in
// memory (class 63, one slot, no mask bit set), its group's range fresh (no
// byte of it the allocator's, a client's, reserved or taken), mapped
// read-write, zero but the header word (m); the pages, the break and every
// byte the invariant read before as they were
abbrev mp.bgpre(c, A, vm, V1, b, k, T, m, V) := cfg: c in mallocng.Cfg && univ: A in univ(1) && abs: A in mallocng.Abs &&
  blocks: b in fn_space(bits(64), option(omega)) && vm: vm in x86_64_linux.Vm && v1: V1 in x86_64_linux.Vm &&
  holds: mallocng.holds_m(c, A, vm, b) &&
  tlist: T in list_type(omega) && taken: A.taken = seq_concat(T, seq_one(m)) && mz: !(m = 0) &&
  meta: V in mallocng.MetaV &&
  place: (k in omega && int_le(k, seq_len(A.used))) && lo: (all j. j in omega -> int_lt(j, k) -> int_lt(A.used[j], m)) &&
  hi: (all j. j in omega -> int_le(k, j) -> int_lt(j, seq_len(A.used)) -> int_lt(m, A.used[j])) &&
  big: (((V.sizeclass = 63 && V.last_idx = 0) && V.avail = 0) && V.freed = 0) && maplen: int_lt(0, V.maplen) &&
  fresh: (all a. a in omega -> mallocng.in_range(a, mallocng.group_range(V)) ->
     !mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) && !(a in malloc.live_of(b)) && !mallocng.in_reserved(A, a) && !mallocng.in_taken(A, a)) &&
  newpg: (all a. a in omega -> mallocng.in_range(a, mallocng.group_range(V)) ->
     mallocng.m_rw(mallocng.mview(V1, mallocng.all_bytes()), a) && !(snd(mallocng.pg(mallocng.mview(V1, mallocng.all_bytes()), a)).kind = 2)) &&
  mrw: (all a. a in omega -> int_le(m, a) -> int_lt(a, int_add(m, mallocng.META_SIZE)) ->
     mallocng.m_rw(mallocng.mview(V1, mallocng.all_bytes()), a) && !(snd(mallocng.pg(mallocng.mview(V1, mallocng.all_bytes()), a)).kind = 2)) &&
  pages: V1.pages = vm.pages && brk: V1.brk = vm.brk && stk: (V1.stack_top = vm.stack_top && V1.stack_limit = vm.stack_limit) &&
  bytes: (all a. a in omega -> a in mallocng.held(c, A, b) -> V1.bytes[bits_of_int(64, a)] = vm.bytes[bits_of_int(64, a)]) &&
  rec: mallocng.meta_in_memory(mallocng.mview(V1, mallocng.all_bytes()), m, V) && links: (V.prev = 0 && V.next = 0) &&
  hdr: ((mallocng.rd(mallocng.mview(V1, mallocng.all_bytes()), V.mem, 8) = m && int_mod(V.mem, 4096) = 0) && int_lt(0, V.mem)) &&
  zero: (all a. a in omega -> int_le(int_add(V.mem, 8), a) -> int_lt(a, int_add(V.mem, int_mul(V.maplen, 4096))) ->
     mallocng.b8(mallocng.mview(V1, mallocng.all_bytes()), a) = 0)

// (m, V: m taken last, not in use; V's fields, its range and stride; the
// new states)
theorem mp.bg_basic(c, A, vm, V1, b, k, T, m, V): mp.bgpre(c, A, vm, V1, b, k, T, m, V) ->
  nat: m in omega && unused: !mallocng.is_used(A, m) && slot: mallocng.meta_slot(A, m) &&
  fields: (V.mem in omega && V.maplen in omega && V.last_idx in omega && V.sizeclass in omega) &&
  range: mallocng.group_range(V) = pair(V.mem, int_mul(V.maplen, 4096)) &&
  stride: mallocng.stride(V) = int_sub(int_mul(V.maplen, 4096), 16) &&
  abs1: mp.ngrp(A, k, T, m, V, 1) in mallocng.Abs && univ1: mp.ngrp(A, k, T, m, V, 1) in univ(1) &&
  abs2: mp.bgrp(A, k, T, m, V) in mallocng.Abs && univ2: mp.bgrp(A, k, T, m, V) in univ(1)
proof
  assume P
  have {ha = abs, hh = holds, ht = tlist, hte = taken, hv = meta, hpl = place, hml = maplen, hbg = big} := P
  have hk hkl := hpl
  have {H = inv} := expand(hh, mallocng.holds_m)
  have {hp = part} := expand(H, mallocng.holds)
  have {hm = nat, nm = unused} := apply(mp.ng_taken[A := A, T := T, m := m], ha, hp, ht, hte)
  have {htk = taken} := expand(hp, mallocng.metas_partition)
  have tlo: seq_len(T) in omega by arith(ht)
  have lt: seq_len(A.taken) = int_add(seq_len(T), 1) := rewrite(sym(hte), (seq_len(seq_concat(T, seq_one(m))) = int_add(seq_len(T), 1) by arith(ht)))
  have tm: A.taken[seq_len(T)] = m := rewrite(sym(hte), at({seq_concat(T, seq_one(m))[seq_len(T)]}, ht))
  have ms _ _ _ _ := mp(all_elim(htk, {seq_len(T)}), tlo, (int_lt(seq_len(T), seq_len(A.taken)) by arith(lt)))
  have vf: (V.mem in omega && V.maplen in omega && V.last_idx in omega && V.sizeclass in omega) by simp(hv)
  have _ l0 _ _ := hbg
  have gr: mallocng.group_range(V) = pair(V.mem, int_mul(V.maplen, 4096)) by defs(simp(hml), mallocng.group_range)
  have st: mallocng.stride(V) = int_sub(int_mul(V.maplen, 4096), 16) by defs(simp(l0, hml), mallocng.stride, mallocng.UNIT)
  have {ya = abs, yu = univ} := apply(mp.ngrp_type[A := A, k := k, T := T, m := m, V := V, n := 1], ha, hk, hkl, ht, hm, hv, simp())
  have {xa = abs, xu = univ} := apply(mp.bgrp_type[A := A, k := k, T := T, m := m, V := V], ha, hk, hkl, ht, hm, hv)
  show by taut(hm, nm, rewrite(tm, ms), vf, gr, st, ya, yu, xa, xu)
qed

// (the slot's interior: past the header's first 12 bytes, up to the last 4)
theorem mp.bg_sl(c, A, vm, V1, b, k, T, m, V, a): mp.bgpre(c, A, vm, V1, b, k, T, m, V) ->
  (mallocng.in_slot(V, 0, a) <-> int_lt(int_add(V.mem, 12), a) && int_lt(a, int_sub(int_add(V.mem, int_mul(V.maplen, 4096)), 4)))
proof
  assume P
  have {st = stride} := apply(mp.bg_basic, P)
  have e1: mallocng.slot_start(V, 0) = int_add(V.mem, 16) by defs(simp(), mallocng.slot_start, mallocng.storage, mallocng.UNIT)
  have e2: mallocng.slot_end(V, 0) = int_sub(int_add(mallocng.slot_start(V, 0), mallocng.stride(V)), 4) by defs(simp(), mallocng.slot_end, mallocng.IB)
  have l1: int_lt(int_sub(mallocng.slot_start(V, 0), 4), a) <-> int_lt(int_add(V.mem, 12), a) by arith(e1)
  have l2: int_lt(a, mallocng.slot_end(V, 0)) <-> int_lt(a, int_sub(int_add(V.mem, int_mul(V.maplen, 4096)), 4)) by arith(e1, e2, st)
  show by defs(taut(l1, l2), mallocng.in_slot, mallocng.IB)
qed

// the new state's owned ranges: the old ones and m's group's
theorem mp.bg_fpr(c, A, vm, V1, b, k, T, m, V, a): mp.bgpre(c, A, vm, V1, b, k, T, m, V) ->
  (mallocng.in_ranges(a, mallocng.fp_ranges(c, mp.bgrp(A, k, T, m, V))) <->
   mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) || mallocng.in_range(a, mallocng.group_range(V)))
proof
  assume P
  let A2 := mp.ngrp(A, k, T, m, V, 1)
  have {hc = cfg, hu = univ, ha = abs, hpl = place} := P
  have hk hkl := hpl
  have {hm = nat, nm = unused, au = abs1, uu = univ1} := apply(mp.bg_basic, P)
  have ex: mallocng.fp_ranges(c, mp.bgrp(A, k, T, m, V)) = mallocng.fp_ranges(c, A2) by defs(simp(), mallocng.fp_ranges, mallocng.fixed_ranges, mallocng.auxv_ranges)
  have {g1 = groups} := apply(mp.fp_pieces, hc, hu, ha)
  have {g2 = groups} := apply(mp.fp_pieces, hc, uu, au)
  have x1: mallocng.fixed_ranges(c, A) in list_type(univ(1)) by defs(apply(mp.pre_list, hc, hu, ha), mallocng.fixed_ranges)
  have fe: mallocng.fixed_ranges(c, A2) = mallocng.fixed_ranges(c, A) by defs(simp(), mallocng.fixed_ranges, mallocng.auxv_ranges)
  let G := fn_build(int_sub(seq_len(A.used), 0), x0. mallocng.group_range(A.metas[A.used[int_add(0, x0)]]))
  let G2 := fn_build(int_sub(seq_len(A2.used), 0), x0. mallocng.group_range(A2.metas[A2.used[int_add(0, x0)]]))
  have c1 := apply(mp.ranges_cat[a := a, xs := mallocng.fixed_ranges(c, A), ys := G], x1, g1)
  have c2 := apply(mp.ranges_cat[a := a, xs := mallocng.fixed_ranges(c, A), ys := G2], x1, g2)
  have r1 := apply(mp.grp_ranges[A := A, a := a], ha)
  have r2 := apply(mp.grp_ranges[A := A2, a := a], au)
  have q: (ex g. mallocng.is_used(A2, g) && mallocng.in_range(a, mallocng.group_range(A2.metas[g]))) <->
      (ex g. mallocng.is_used(A, g) && mallocng.in_range(a, mallocng.group_range(A.metas[g]))) || mallocng.in_range(a, mallocng.group_range(V)) proof
    have fw: (ex g. mallocng.is_used(A2, g) && mallocng.in_range(a, mallocng.group_range(A2.metas[g]))) ->
        (ex g. mallocng.is_used(A, g) && mallocng.in_range(a, mallocng.group_range(A.metas[g]))) || mallocng.in_range(a, mallocng.group_range(V)) proof
      assume h
      obtain g, iu2 hr from h
      have d1: g = m -> mallocng.in_range(a, mallocng.group_range(V)) proof
        assume e
        show := rewrite((A2.metas[g] = V by simp(e)), hr)
      qed
      have d2: (ex x0. x0 in omega && (int_lt(x0, seq_len(A.used)) && A.used[x0] = g)) && (A2.metas[g] = A.metas[g] && A2.slots[g] = A.slots[g]) ->
          (ex g. mallocng.is_used(A, g) && mallocng.in_range(a, mallocng.group_range(A.metas[g]))) proof
        assume w
        have ex0 em _ := w
        have iu: mallocng.is_used(A, g) by defs(ex0, mallocng.is_used)
        show by ex_intro({g}, taut(iu, rewrite(em, hr)))
      qed
      show by taut(apply(mp.ng_member[A := A, k := k, T := T, m := m, V := V, n := 1, g := g], ha, hk, hkl, hm, nm, iu2), d1, d2)
    qed
    have bw1: (ex g. mallocng.is_used(A, g) && mallocng.in_range(a, mallocng.group_range(A.metas[g]))) ->
        (ex g. mallocng.is_used(A2, g) && mallocng.in_range(a, mallocng.group_range(A2.metas[g]))) proof
      assume h
      obtain g, iu hr from h
      have iu2: mallocng.is_used(A2, g) by taut(apply(mp.ng_used[A := A, k := k, T := T, m := m, V := V, n := 1, g := g], ha, hk, hkl, hm), iu)
      have gm: !(g = m) proof
        assume e
        show by taut(rewrite(e, iu), nm)
      qed
      have em: A2.metas[g] = A.metas[g] by simp(mp(app_update_other[f := A.metas, k := m, v := V, x := g], gm))
      show by ex_intro({g}, taut(iu2, rewrite(sym(em), hr)))
    qed
    have bw2: mallocng.in_range(a, mallocng.group_range(V)) -> (ex g. mallocng.is_used(A2, g) && mallocng.in_range(a, mallocng.group_range(A2.metas[g]))) proof
      assume hr
      have iu2: mallocng.is_used(A2, m) by taut(apply(mp.ng_used[A := A, k := k, T := T, m := m, V := V, n := 1, g := m], ha, hk, hkl, hm), refl({m}))
      show by ex_intro({m}, taut(iu2, rewrite(sym((A2.metas[m] = V by simp())), hr)))
    qed
    show by taut(fw, bw1, bw2)
  qed
  have ff := subst({y. mallocng.in_ranges(a, seq_concat(y, G2)) <-> mallocng.in_ranges(a, seq_concat(mallocng.fixed_ranges(c, A), G2))}, sym(fe),
    (mallocng.in_ranges(a, seq_concat(mallocng.fixed_ranges(c, A), G2)) <-> mallocng.in_ranges(a, seq_concat(mallocng.fixed_ranges(c, A), G2)) by taut()))
  have s: mallocng.in_ranges(a, seq_concat(mallocng.fixed_ranges(c, A2), G2)) <-> mallocng.in_ranges(a, seq_concat(mallocng.fixed_ranges(c, A), G)) ||
      mallocng.in_range(a, mallocng.group_range(V)) by taut(ff, c2, c1, r1, r2, q)
  show := rewrite(sym(ex), (mallocng.in_ranges(a, mallocng.fp_ranges(c, A2)) <-> mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) || mallocng.in_range(a, mallocng.group_range(V))
    by defs(s, mallocng.fp_ranges)))
qed

// a byte of m's record: owned, in a meta area (none of the context's), no
// client's, not reserved; taken before, not now
theorem mp.bg_mrec(c, A, vm, V1, b, k, T, m, V, a): mp.bgpre(c, A, vm, V1, b, k, T, m, V) -> a in omega -> int_le(m, a) -> int_lt(a, int_add(m, mallocng.META_SIZE)) ->
  own: mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) && fixed: mallocng.in_ranges(a, mallocng.fixed_ranges(c, A)) &&
  area: (ex j. j in omega && int_lt(j, seq_len(A.areas)) && int_le(int_add(A.areas[j], 24), a) && int_lt(a, int_add(A.areas[j], 4096))) &&
  nctx: !mallocng.in_range(a, pair(c.ctx, mallocng.CTX_SIZE)) && live: !(a in malloc.live_of(b)) && res: !mallocng.in_reserved(A, a) &&
  was: mallocng.in_taken(A, a) && now: !mallocng.in_taken(mp.bgrp(A, k, T, m, V), a)
proof
  assume P hao h1 h2
  have {hc = cfg, hu = univ, ha = abs, hh = holds, ht = tlist, hte = taken} := P
  show := apply(mp.trec[c := c, A := A, vm := vm, b := b, T := T, m := m, A2 := mp.bgrp(A, k, T, m, V), a := a], hc, hu, ha, hh, ht, hte,
    (mp.bgrp(A, k, T, m, V).taken = T by simp()), hao, h1, h2)
qed

// the new state's footprint: the old one, m's group's range but its slot's
// interior, m's record
theorem mp.bg_fp(c, A, vm, V1, b, k, T, m, V, a): mp.bgpre(c, A, vm, V1, b, k, T, m, V) ->
  (a in mallocng.footprint(c, mp.bgrp(A, k, T, m, V), b) <-> a in mallocng.footprint(c, A, b) ||
     (a in omega && mallocng.in_range(a, mallocng.group_range(V)) && !mallocng.in_slot(V, 0, a)) ||
     (a in omega && int_le(m, a) && int_lt(a, int_add(m, mallocng.META_SIZE))))
proof
  assume P
  let X := mp.bgrp(A, k, T, m, V)
  have {ha = abs, hpl = place, hfr = fresh, ht = tlist, hte = taken} := P
  have hk hkl := hpl
  have {hm = nat, nm = unused, gr = range} := apply(mp.bg_basic, P)
  have f1 := apply(mp.fp_def[c := c, A := A, b := b, a := a])
  have f2 := apply(mp.fp_def[c := c, A := X, b := b, a := a])
  have fr := apply(mp.bg_fpr[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, a := a], P)
  have {tf = fw, tb = bw} := apply(mp.tk_cases[A := A, A2 := X, T := T, m := m, a := a], ht, hte, (X.taken = T by simp()))
  have rs := apply(mp.bg_inres[A := A, k := k, T := T, m := m, V := V, a := a], ha, hk, hkl, hm, nm)
  have g: a in omega -> mallocng.in_range(a, mallocng.group_range(V)) -> !mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) && !(a in malloc.live_of(b)) &&
      !mallocng.in_reserved(A, a) && !mallocng.in_taken(A, a) proof
    assume hao hr
    show := mp(all_elim(hfr, {a}), hao, hr)
  qed
  have r: a in omega -> int_le(m, a) -> int_lt(a, int_add(m, mallocng.META_SIZE)) -> mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) &&
      !(a in malloc.live_of(b)) && !mallocng.in_reserved(A, a) && !mallocng.in_taken(X, a) proof
    assume hao h1 h2
    have {o = own, l = live, s = res, t = now} := apply(mp.bg_mrec[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, a := a], P, hao, h1, h2)
    show by taut(o, l, s, t)
  qed
  have sl := apply(mp.bg_sl[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, a := a], P)
  have sg: mallocng.in_slot(V, 0, a) -> mallocng.in_range(a, mallocng.group_range(V)) proof
    assume w
    have w1 w2 := (int_lt(int_add(V.mem, 12), a) && int_lt(a, int_sub(int_add(V.mem, int_mul(V.maplen, 4096)), 4)) by taut(sl, w))
    show by defs(simp(gr, (int_le(V.mem, a) by arith(w1)), (int_lt(a, int_add(V.mem, int_mul(V.maplen, 4096))) by arith(w2))), mallocng.in_range)
  qed
  show by taut(f1, f2, fr, tf, tb, rs, g, r, sg)
qed

// ... and its held bytes; those held before: not m's group's, not m's record
theorem mp.bg_held(c, A, vm, V1, b, k, T, m, V, a): mp.bgpre(c, A, vm, V1, b, k, T, m, V) ->
  held: (a in mallocng.held(c, mp.bgrp(A, k, T, m, V), b) <-> a in mallocng.held(c, A, b) ||
     (a in omega && mallocng.in_range(a, mallocng.group_range(V)) && !mallocng.in_slot(V, 0, a)) ||
     (a in omega && int_le(m, a) && int_lt(a, int_add(m, mallocng.META_SIZE)))) &&
  old: (a in mallocng.held(c, A, b) -> !mallocng.in_range(a, mallocng.group_range(V)) && !(int_le(m, a) && int_lt(a, int_add(m, mallocng.META_SIZE))))
proof
  assume P
  let A2 := mp.bgrp(A, k, T, m, V)
  have {hc = cfg, hfr = fresh} := P
  have co: c.ctx in omega by simp(hc)
  have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  have fe := apply(mp.bg_fp[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, a := a], P)
  have hi1 := apply(mp.held_intro[c := c, A := A, b := b, a := a])
  have hi2 := apply(mp.held_intro[c := c, A := A2, b := b, a := a])
  have hf1 := apply(mp.held_fp[c := c, A := A, b := b, a := a])
  have hf2 := apply(mp.held_fp[c := c, A := A2, b := b, a := a])
  have f1 := apply(mp.fp_def[c := c, A := A, b := b, a := a])
  // (the new bytes: not the context's free ones)
  have d1: a in omega -> mallocng.in_range(a, mallocng.group_range(V)) -> !mallocng.ctx_free(c, a) && !mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) proof
    assume hao hr
    have no _ _ _ := mp(all_elim(hfr, {a}), hao, hr)
    have ncx: !mallocng.ctx_free(c, a) proof
      assume w
      have w0 := expand(w, mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK)
      have w1 w2 := (int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE)) by defs(arith(w0, co), mallocng.CTX_SIZE))
      have {hh = holds, hu = univ, ha = abs} := P
      have cf := apply(mp.ctx_fp[c := c, A := A, vm := vm, b := b, a := a], hc, hu, ha, hh, hao, w1, w2)
      show by taut(no, f1, cf)
    qed
    show by taut(ncx, no)
  qed
  have d2: a in omega -> int_le(m, a) -> int_lt(a, int_add(m, mallocng.META_SIZE)) -> mallocng.in_taken(A, a) proof
    assume hao h1 h2
    have {w = was} := apply(mp.bg_mrec[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, a := a], P, hao, h1, h2)
    show := w
  qed
  have nf2: a in omega -> int_le(m, a) -> int_lt(a, int_add(m, mallocng.META_SIZE)) -> !mallocng.ctx_free(c, a) proof
    assume hao h1 h2
    have {x = nctx} := apply(mp.bg_mrec[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, a := a], P, hao, h1, h2)
    have x2: !(int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, 928))) by simp(expand(x, mallocng.in_range), ks)
    show by defs(arith(x2, co), mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK)
  qed
  have p1: a in mallocng.held(c, A2, b) <-> a in mallocng.held(c, A, b) ||
     (a in omega && mallocng.in_range(a, mallocng.group_range(V)) && !mallocng.in_slot(V, 0, a)) ||
     (a in omega && int_le(m, a) && int_lt(a, int_add(m, mallocng.META_SIZE))) by taut(fe, hi1, hi2, hf1, hf2, d1, nf2)
  have p2: a in mallocng.held(c, A, b) -> !mallocng.in_range(a, mallocng.group_range(V)) && !(int_le(m, a) && int_lt(a, int_add(m, mallocng.META_SIZE))) by taut(hf1, f1, d1, d2)
  show by taut(p1, p2)
qed

// a byte neither m's group's nor m's record's: as before in the view
theorem mp.bg_view(c, A, vm, V1, b, k, T, m, V, a): mp.bgpre(c, A, vm, V1, b, k, T, m, V) -> a in omega ->
  !mallocng.in_range(a, mallocng.group_range(V)) -> !(int_le(m, a) && int_lt(a, int_add(m, mallocng.META_SIZE))) ->
  mallocng.mview(V1, mallocng.held(c, mp.bgrp(A, k, T, m, V), b))[a] = mallocng.mview(vm, mallocng.held(c, A, b))[a]
proof
  assume P hao ng nr
  have {hpg = pages, hby = bytes} := P
  have {hl = held} := apply(mp.bg_held[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, a := a], P)
  have hs: a in mallocng.held(c, mp.bgrp(A, k, T, m, V), b) <-> a in mallocng.held(c, A, b) by taut(hl, ng, nr)
  have e1 := apply(mp.view_mem[vm := V1, F1 := mallocng.held(c, mp.bgrp(A, k, T, m, V), b), F2 := mallocng.held(c, A, b), a := a], hao, hs)
  have bt: a in mallocng.held(c, A, b) -> V1.bytes[bits_of_int(64, a)] = vm.bytes[bits_of_int(64, a)] proof
    assume hf
    show := mp(all_elim(hby, {a}), hao, hf)
  qed
  have pt: a in mallocng.held(c, A, b) -> V1.pages[int_div(a, x86_64_linux.PAGE)] = vm.pages[int_div(a, x86_64_linux.PAGE)] proof
    assume hf
    show by simp(hpg)
  qed
  have e2 := apply(mp.view_agree2[vm := vm, vm2 := V1, fp := mallocng.held(c, A, b), a := a], hao, bt, pt)
  show := trans(e1, e2)
qed

// a byte of m's group out of its slot's interior, or of m's record: in the
// view as in memory
theorem mp.bg_new(c, A, vm, V1, b, k, T, m, V, a): mp.bgpre(c, A, vm, V1, b, k, T, m, V) -> a in omega ->
  (mallocng.in_range(a, mallocng.group_range(V)) && !mallocng.in_slot(V, 0, a)) || int_le(m, a) && int_lt(a, int_add(m, mallocng.META_SIZE)) ->
  mallocng.mview(V1, mallocng.held(c, mp.bgrp(A, k, T, m, V), b))[a] = mallocng.mview(V1, mallocng.all_bytes())[a]
proof
  assume P hao hw
  have {hl = held} := apply(mp.bg_held[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, a := a], P)
  have ab: a in mallocng.all_bytes() by defs(sel(taut(hao)), mallocng.all_bytes)
  show := apply(mp.view_mem[vm := V1, F1 := mallocng.held(c, mp.bgrp(A, k, T, m, V), b), F2 := mallocng.all_bytes(), a := a], hao, taut(hl, hao, hw, ab))
qed

// (... its byte and page)
theorem mp.bg_at(c, A, vm, V1, b, k, T, m, V, a): mp.bgpre(c, A, vm, V1, b, k, T, m, V) -> a in omega ->
  (mallocng.in_range(a, mallocng.group_range(V)) && !mallocng.in_slot(V, 0, a)) || int_le(m, a) && int_lt(a, int_add(m, mallocng.META_SIZE)) ->
  b8: mallocng.b8(mallocng.mview(V1, mallocng.held(c, mp.bgrp(A, k, T, m, V), b)), a) = mallocng.b8(mallocng.mview(V1, mallocng.all_bytes()), a) &&
  pg: mallocng.pg(mallocng.mview(V1, mallocng.held(c, mp.bgrp(A, k, T, m, V), b)), a) = mallocng.pg(mallocng.mview(V1, mallocng.all_bytes()), a)
proof
  assume P hao hw
  have e := apply(mp.bg_new[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, a := a], P, hao, hw)
  show by taut((mallocng.b8(mallocng.mview(V1, mallocng.held(c, mp.bgrp(A, k, T, m, V), b)), a) = mallocng.b8(mallocng.mview(V1, mallocng.all_bytes()), a) by defs(simp(e), mallocng.b8)),
    (mallocng.pg(mallocng.mview(V1, mallocng.held(c, mp.bgrp(A, k, T, m, V), b)), a) = mallocng.pg(mallocng.mview(V1, mallocng.all_bytes()), a) by defs(simp(e), mallocng.pg)))
qed

// ----------------------------------------------------------------------
//  The old regions' bytes: as before

// an owned byte outside every meta area: as before
theorem mp.bg_far(c, A, vm, V1, b, k, T, m, V, a): mp.bgpre(c, A, vm, V1, b, k, T, m, V) -> a in omega ->
  mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) ->
  (all j. j in omega -> int_lt(j, seq_len(A.areas)) -> !(int_le(A.areas[j], a) && int_lt(a, int_add(A.areas[j], 4096)))) ->
  mallocng.mview(V1, mallocng.held(c, mp.bgrp(A, k, T, m, V), b))[a] = mallocng.mview(vm, mallocng.held(c, A, b))[a]
proof
  assume P hao ir na
  have {hfr = fresh} := P
  have ng: !mallocng.in_range(a, mallocng.group_range(V)) proof
    assume w
    have no _ _ _ := mp(all_elim(hfr, {a}), hao, w)
    show by taut(no, ir)
  qed
  have nr: !(int_le(m, a) && int_lt(a, int_add(m, mallocng.META_SIZE))) proof
    assume w
    have w1 w2 := w
    have {ar = area} := apply(mp.bg_mrec[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, a := a], P, hao, w1, w2)
    obtain j, hj hjl g1 g2 from ar
    show by taut(mp(all_elim(na, {j}), hj, hjl), (int_le(A.areas[j], a) by arith(g1)), g2)
  qed
  show := apply(mp.bg_view[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, a := a], P, hao, ng, nr)
qed

// a byte of a meta area: as before, but m's record's
theorem mp.bg_area(c, A, vm, V1, b, k, T, m, V, j, a): mp.bgpre(c, A, vm, V1, b, k, T, m, V) -> j in omega -> int_lt(j, seq_len(A.areas)) -> a in omega ->
  int_le(A.areas[j], a) -> int_lt(a, int_add(A.areas[j], 4096)) -> !(int_le(m, a) && int_lt(a, int_add(m, mallocng.META_SIZE))) ->
  mallocng.mview(V1, mallocng.held(c, mp.bgrp(A, k, T, m, V), b))[a] = mallocng.mview(vm, mallocng.held(c, A, b))[a]
proof
  assume P hj hjl hao h1 h2 nr
  have {hc = cfg, hu = univ, ha = abs, hfr = fresh} := P
  have fx := apply(mp.area_fixed[c := c, A := A, k := j, a := a], hc, hu, ha, hj, hjl, h1, h2)
  have {p6 = groups} := apply(mp.fp_pieces, hc, hu, ha)
  have x1: mallocng.fixed_ranges(c, A) in list_type(univ(1)) by defs(apply(mp.pre_list, hc, hu, ha), mallocng.fixed_ranges)
  have ir: mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) by defs(apply(mp.ranges_l, x1, p6, fx), mallocng.fp_ranges)
  have ng: !mallocng.in_range(a, mallocng.group_range(V)) proof
    assume w
    have no _ _ _ := mp(all_elim(hfr, {a}), hao, w)
    show by taut(no, ir)
  qed
  show := apply(mp.bg_view[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, a := a], P, hao, ng, nr)
qed

// a byte of a meta slot not taken (a record of a free meta, a group's): as
// before
theorem mp.bg_meta(c, A, vm, V1, b, k, T, m, V, g, a): mp.bgpre(c, A, vm, V1, b, k, T, m, V) -> mallocng.meta_slot(A, g) -> mp.untaken(A, g) ->
  a in omega -> int_le(g, a) -> int_lt(a, int_add(g, 40)) ->
  mallocng.mview(V1, mallocng.held(c, mp.bgrp(A, k, T, m, V), b))[a] = mallocng.mview(vm, mallocng.held(c, A, b))[a]
proof
  assume P hg hnt hao h1 h2
  have {hc = cfg, hu = univ, ha = abs, hh = holds} := P
  have {acc = acc} := apply(mp.slot_meta[c := c, A := A, vm := vm, b := b, g := g], hc, hu, ha, hh, hg, hnt)
  have hd _ _ := mp(all_elim(acc, {a}), hao, h1, h2)
  have {o = old} := apply(mp.bg_held[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, a := a], P)
  have ng nr := mp(o, hd)
  show := apply(mp.bg_view[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, a := a], P, hao, ng, nr)
qed

// (a byte of the data or the image's constants: in no meta area, as before)
theorem mp.bg_data(c, A, vm, V1, b, k, T, m, V, i, a): mp.bgpre(c, A, vm, V1, b, k, T, m, V) -> i in omega -> int_lt(i, 3) -> a in omega ->
  mallocng.in_range(a, mallocng.data_ranges(c)[i]) ->
  mallocng.mview(V1, mallocng.held(c, mp.bgrp(A, k, T, m, V), b))[a] = mallocng.mview(vm, mallocng.held(c, A, b))[a]
proof
  assume P hi hil hao hr
  have {hc = cfg, hu = univ, ha = abs, hh = holds} := P
  have {H = inv} := expand(hh, mallocng.holds_m)
  have na: all j. j in omega -> int_lt(j, seq_len(A.areas)) -> !(int_le(A.areas[j], a) && int_lt(a, int_add(A.areas[j], 4096))) proof
    fix j
    assume hj hjl w
    have w1 w2 := w
    have {d = data} := apply(mp.area_apart[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, brk := vm.brk, k := j, a := a], hc, hu, ha, H, hj, hjl, hao, w1, w2)
    show by taut(mp(all_elim(d, {i}), hi, hil), hr)
  qed
  show := apply(mp.bg_far[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, a := a], P, hao, apply(mp.data_own, hc, hu, ha, hi, hil, hr), na)
qed

theorem mp.bg_ro(c, A, vm, V1, b, k, T, m, V, i, a): mp.bgpre(c, A, vm, V1, b, k, T, m, V) -> i in omega -> int_lt(i, x86_64_linux.phnum(c.file)) -> a in omega ->
  mallocng.in_range(a, mallocng.ro_ranges(c.file)[i]) ->
  mallocng.mview(V1, mallocng.held(c, mp.bgrp(A, k, T, m, V), b))[a] = mallocng.mview(vm, mallocng.held(c, A, b))[a]
proof
  assume P hi hil hao hr
  have {hc = cfg, hu = univ, ha = abs, hh = holds} := P
  have {H = inv} := expand(hh, mallocng.holds_m)
  have na := apply(mp.ro_noarea[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, brk := vm.brk, i := i, a := a], hc, hu, ha, H, hao, hi, hil, hr)
  show := apply(mp.bg_far[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, a := a], P, hao, apply(mp.ro_own, hc, hu, ha, hi, hil, hr), na)
qed

// (a byte of the reserve: the same)
theorem mp.bg_res(c, A, vm, V1, b, k, T, m, V, a): mp.bgpre(c, A, vm, V1, b, k, T, m, V) -> a in omega ->
  mallocng.in_range(a, pair(A.reserve, int_mul(4096, A.reserve_cnt))) ->
  mallocng.mview(V1, mallocng.held(c, mp.bgrp(A, k, T, m, V), b))[a] = mallocng.mview(vm, mallocng.held(c, A, b))[a]
proof
  assume P hao hr
  have {hc = cfg, hu = univ, ha = abs, hh = holds} := P
  have {H = inv} := expand(hh, mallocng.holds_m)
  have na: all j. j in omega -> int_lt(j, seq_len(A.areas)) -> !(int_le(A.areas[j], a) && int_lt(a, int_add(A.areas[j], 4096))) proof
    fix j
    assume hj hjl w
    have w1 w2 := w
    have {r = reserve} := apply(mp.area_apart[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, brk := vm.brk, k := j, a := a], hc, hu, ha, H, hj, hjl, hao, w1, w2)
    show by taut(r, hr)
  qed
  have fx: mallocng.in_ranges(a, mallocng.fixed_ranges(c, A)) by taut(apply(mp.fixed_cases[c := c, A := A, a := a], hc, hu, ha), hr)
  have {p6 = groups} := apply(mp.fp_pieces, hc, hu, ha)
  have x1: mallocng.fixed_ranges(c, A) in list_type(univ(1)) by defs(apply(mp.pre_list, hc, hu, ha), mallocng.fixed_ranges)
  have ir: mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) by defs(apply(mp.ranges_l, x1, p6, fx), mallocng.fp_ranges)
  show := apply(mp.bg_far[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, a := a], P, hao, ir, na)
qed

// (a byte of a group in use: owned, in no meta area -- as before)
theorem mp.bg_gbyte(c, A, vm, V1, b, k, T, m, V, h, a): mp.bgpre(c, A, vm, V1, b, k, T, m, V) -> mallocng.is_used(A, h) -> a in omega ->
  mallocng.in_range(a, mallocng.group_range(A.metas[h])) ->
  mallocng.mview(V1, mallocng.held(c, mp.bgrp(A, k, T, m, V), b))[a] = mallocng.mview(vm, mallocng.held(c, A, b))[a]
proof
  assume P iu hao hr
  have {hc = cfg, hu = univ, ha = abs, hh = holds} := P
  have {H = inv} := expand(hh, mallocng.holds_m)
  have {ow = own} := apply(mp.grp_own[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, brk := vm.brk, g := h, a := a], hc, hu, ha, H, iu, hao, hr)
  have na: all j. j in omega -> int_lt(j, seq_len(A.areas)) -> !(int_le(A.areas[j], a) && int_lt(a, int_add(A.areas[j], 4096))) proof
    fix j
    assume hj hjl w
    have w1 w2 := w
    have {g = groups} := apply(mp.area_apart[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, brk := vm.brk, k := j, a := a], hc, hu, ha, H, hj, hjl, hao, w1, w2)
    show by taut(mp(all_elim(g, {h}), iu), hr)
  qed
  show := apply(mp.bg_far[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, a := a], P, hao, ow, na)
qed

// (a meta area's header, its first 24 bytes: not m's record)
theorem mp.bg_hdr(c, A, vm, V1, b, k, T, m, V, j, a): mp.bgpre(c, A, vm, V1, b, k, T, m, V) -> j in omega -> int_lt(j, seq_len(A.areas)) -> a in omega ->
  int_le(A.areas[j], a) -> int_lt(a, int_add(A.areas[j], 24)) ->
  mallocng.mview(V1, mallocng.held(c, mp.bgrp(A, k, T, m, V), b))[a] = mallocng.mview(vm, mallocng.held(c, A, b))[a]
proof
  assume P hj hjl hao h1 h2
  have {hc = cfg, hu = univ, ha = abs, hh = holds} := P
  have {H = inv} := expand(hh, mallocng.holds_m)
  have nr: !(int_le(m, a) && int_lt(a, int_add(m, mallocng.META_SIZE))) proof
    assume w
    have w1 w2 := w
    have {ar = area} := apply(mp.bg_mrec[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, a := a], P, hao, w1, w2)
    obtain j2, hj2 hj2l g1 g2 from ar
    have c1: j2 = j -> false proof
      assume e
      show by arith(rewrite(e, g1), h2)
    qed
    have c2: !(j2 = j) -> false proof
      assume ne
      have rl: A.areas in list_type(omega) by simp(ha)
      have ajo := apply(at_type[l := A.areas, t := omega, i := j2], rl, hj2, hj2l)
      have {ars = areas} := apply(mp.area_apart[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, brk := vm.brk, k := j2, a := a], hc, hu, ha, H,
        hj2, hj2l, hao, arith(g1, ajo), g2)
      show by taut(mp(all_elim(ars, {j}), hj, hjl, (!(j = j2) by taut(ne))), h1, (int_lt(a, int_add(A.areas[j], 4096)) by arith(h2)))
    qed
    show by taut(c1, c2)
  qed
  show := apply(mp.bg_area[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, j := j, a := a], P, hj, hjl, hao, h1,
    (int_lt(a, int_add(A.areas[j], 4096)) by arith(h2)), nr)
qed

// (initialized: m is in a meta area; libc's auxiliary vector then gone)
theorem mp.bg_init(c, A, vm, V1, b, k, T, m, V): mp.bgpre(c, A, vm, V1, b, k, T, m, V) ->
  init: !(A.init_done = 0) && auxv: (all a. !mallocng.in_ranges(a, mallocng.auxv_ranges(A)))
proof
  assume P
  have {hh = holds, hu = univ, ha = abs} := P
  have {H = inv} := expand(hh, mallocng.holds_m)
  have {hfr = fresh, hnm = normal} := expand(H, mallocng.holds)
  have {ms = slot} := apply(mp.bg_basic, P)
  obtain j l, hj hl hjl hll e from expand(ms, mallocng.meta_slot)
  have ni: !(A.init_done = 0) proof
    assume z
    have {z0 = areas} := mp(expand(hfr, mallocng.fresh_ok), z)
    show by arith(z0, hjl)
  qed
  have nx: all a. !mallocng.in_ranges(a, mallocng.auxv_ranges(A)) proof
    fix a
    assume w
    obtain i, hi hil hr from expand(w, mallocng.in_ranges)
    show by taut(hr, apply(mp.auxv_none[A := A, k := i, a := a], hu, ha, hnm, ni, hi, hil))
  qed
  show by taut(ni, nx)
qed

// ----------------------------------------------------------------------
//  The new group in the new view

// the new group: as made
theorem mp.bg_mself(c, A, vm, V1, b, k, T, m, V): mp.bgpre(c, A, vm, V1, b, k, T, m, V) ->
  mallocng.group_ok(mp.bgrp(A, k, T, m, V), mallocng.mview(V1, mallocng.held(c, mp.bgrp(A, k, T, m, V), b)), b, m)
proof
  assume P
  let X := mp.bgrp(A, k, T, m, V)
  let M2 := mallocng.mview(V1, mallocng.held(c, X, b))
  let MA := mallocng.mview(V1, mallocng.all_bytes())
  have {hml = maplen, hfr = fresh, hrec = rec, hlk = links, hhd = hdr, hz = zero, hbg = big} := P
  have {hm = nat, vf = fields, gr = range, st = stride} := apply(mp.bg_basic, P)
  have vmo vlo vio vso := vf
  have s63 l0 av0 fr0 := hbg
  have ev: X.metas[m] = V by simp()
  have ku: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
  have kb: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
  let P0 := V.mem
  let L := int_mul(V.maplen, 4096)
  have lo: int_le(4096, L) by arith(hml, vlo)
  have h0 hp hpp := hhd
  have sl: all a. mallocng.in_slot(V, 0, a) <-> int_lt(int_add(P0, 12), a) && int_lt(a, int_sub(int_add(P0, L), 4)) proof
    fix a
    show := apply(mp.bg_sl[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, a := a], P)
  qed
  // (the group's bytes but the slot's interior: held, as in memory)
  have inr: all a. a in omega -> int_le(P0, a) -> int_lt(a, int_add(P0, L)) -> mallocng.in_range(a, mallocng.group_range(V)) proof
    fix a
    assume hao h1 h2
    show by defs(simp(gr, h1, h2), mallocng.in_range)
  qed
  have hs: all a. int_le(a, int_add(P0, 12)) -> !mallocng.in_slot(V, 0, a) proof
    fix a
    assume h w
    have w1 _ := (int_lt(int_add(P0, 12), a) && int_lt(a, int_sub(int_add(P0, L), 4)) by taut(all_elim(sl, {a}), w))
    show by arith(w1, h)
  qed
  have ts: all a. int_le(int_sub(int_add(P0, L), 4), a) -> !mallocng.in_slot(V, 0, a) proof
    fix a
    assume h w
    have _ w2 := (int_lt(int_add(P0, 12), a) && int_lt(a, int_sub(int_add(P0, L), 4)) by taut(all_elim(sl, {a}), w))
    show by arith(w2, h)
  qed
  have at: all a. a in omega -> int_le(P0, a) -> int_lt(a, int_add(P0, L)) -> !mallocng.in_slot(V, 0, a) -> mallocng.b8(M2, a) = mallocng.b8(MA, a) proof
    fix a
    assume hao h1 h2 ns
    have {e = b8} := apply(mp.bg_at[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, a := a], P, hao,
      taut(mp(all_elim(inr, {a}), hao, h1, h2), ns))
    show := e
  qed
  have z: all a. a in omega -> int_le(int_add(P0, 8), a) -> int_lt(a, int_add(P0, L)) -> !mallocng.in_slot(V, 0, a) -> mallocng.b8(M2, a) = 0 proof
    fix a
    assume hao h1 h2 ns
    show := trans(mp(all_elim(at, {a}), hao, arith(h1), h2, ns), mp(all_elim(hz, {a}), hao, h1, h2))
  qed
  // the record: from memory
  have rj: all j. j in omega -> int_lt(j, 40) -> M2[int_add(m, j)] = MA[int_add(m, j)] proof
    fix j
    assume hj hjl
    have cm: mallocng.META_SIZE = 40 by defs(refl({40}), mallocng.META_SIZE)
    show := apply(mp.bg_new[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, a := int_add(m, j)], P, arith(hm, hj),
      taut((int_le(m, int_add(m, j)) by arith(hj)), (int_lt(int_add(m, j), int_add(m, mallocng.META_SIZE)) by arith(hjl, cm))))
  qed
  have mim := subst({y. mallocng.meta_in_memory(M2, m, y)}, sym(ev), apply(mp.mim_mem[M := MA, M2 := M2, h := m, v := V], hm, hrec, rj))
  // the header: m
  have hj: all j. j in omega -> int_lt(j, 8) -> M2[int_add(P0, j)] = MA[int_add(P0, j)] proof
    fix j
    assume hj hjl
    show := apply(mp.bg_new[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, a := int_add(P0, j)], P, arith(vmo, hj),
      taut(mp(all_elim(inr, {int_add(P0, j)}), arith(vmo, hj), arith(hj), arith(hjl, lo)), mp(all_elim(hs, {int_add(P0, j)}), arith(hjl))))
  qed
  have rh: mallocng.rd(M2, P0, 8) = m := trans(apply(mp.agree_rd, simp(), hj), h0)
  have hdr2: (mallocng.rd(M2, X.metas[m].mem, 8) = m && int_mod(X.metas[m].mem, mallocng.UNIT) = 0) && int_lt(0, X.metas[m].mem)
    by simp(ev, rh, (int_mod(P0, 16) = 0 by arith(hp, vmo)), hpp, ku)
  have own: all a. a in omega -> int_le(X.metas[m].mem, a) && int_lt(a, int_add(X.metas[m].mem, mallocng.UNIT)) -> !(a in malloc.live_of(b)) proof
    fix a
    assume hao h
    have h1 h2 := rewrite(ku, rewrite(ev, h))
    have _ nl _ _ := mp(all_elim(hfr, {a}), hao, mp(all_elim(inr, {a}), hao, h1, arith(h2, lo)))
    show := nl
  qed
  // the zero bytes: the active index, the slot's check byte, its end
  have act: int_mod(mallocng.b8(M2, int_add(X.metas[m].mem, 8)), 32) = 0 proof
    have z8 := mp(all_elim(z, {int_add(P0, 8)}), arith(vmo), arith(), arith(lo), mp(all_elim(hs, {int_add(P0, 8)}), arith()))
    show by simp(ev, z8)
  qed
  have ss0: mallocng.slot_start(X.metas[m], 0) = int_add(P0, 16) by defs(simp(ev), mallocng.slot_start, mallocng.storage, mallocng.UNIT)
  have chk: mallocng.b8(M2, int_sub(mallocng.slot_start(X.metas[m], 0), 4)) = 0 proof
    have z12 := mp(all_elim(z, {int_add(P0, 12)}), arith(vmo), arith(), arith(lo), mp(all_elim(hs, {int_add(P0, 12)}), arith()))
    show := rewrite(sym((int_sub(mallocng.slot_start(X.metas[m], 0), 4) = int_add(P0, 12) by arith(ss0))), z12)
  qed
  have xl0: X.metas[m].last_idx = 0 by simp(ev, l0)
  have xst: mallocng.stride(X.metas[m]) = int_sub(L, 16) by simp(ev, st)
  have se0: mallocng.slot_end(X.metas[m], X.metas[m].last_idx) = int_sub(int_add(P0, L), 4) proof
    have e1: mallocng.slot_end(X.metas[m], X.metas[m].last_idx) = int_sub(int_add(mallocng.slot_start(X.metas[m], X.metas[m].last_idx), mallocng.stride(X.metas[m])), 4)
      by defs(simp(), mallocng.slot_end, mallocng.IB)
    have e2: mallocng.slot_start(X.metas[m], X.metas[m].last_idx) = int_add(P0, 16) := rewrite(sym(xl0), ss0)
    show by arith(e1, e2, xst)
  qed
  have sen: mallocng.b8(M2, mallocng.slot_end(X.metas[m], X.metas[m].last_idx)) = 0 proof
    have zE := mp(all_elim(z, {int_sub(int_add(P0, L), 4)}), arith(vmo, lo), arith(lo), arith(lo), mp(all_elim(ts, {int_sub(int_add(P0, L), 4)}), arith()))
    show := rewrite(sym(se0), zE)
  qed
  have ss1: mallocng.slot_start(X.metas[m], 1) = int_add(int_add(P0, 16), mallocng.stride(X.metas[m])) by defs(simp(ev), mallocng.slot_start, mallocng.storage, mallocng.UNIT)
  have co2: all i. i in omega -> int_le(i, int_add(X.metas[m].last_idx, 1)) -> !(int_sub(mallocng.slot_start(X.metas[m], i), mallocng.IB) in malloc.live_of(b)) proof
    fix i
    assume hi hil
    have i01: i = 0 || i = 1 by arith(hi, hil, xl0)
    have c0: i = 0 -> int_le(P0, int_sub(mallocng.slot_start(X.metas[m], i), mallocng.IB)) && int_lt(int_sub(mallocng.slot_start(X.metas[m], i), mallocng.IB), int_add(P0, L)) proof
      assume e
      have s := subst({y. mallocng.slot_start(X.metas[m], y) = int_add(P0, 16)}, sym(e), ss0)
      show by arith(s, kb, lo, vmo)
    qed
    have c1: i = 1 -> int_le(P0, int_sub(mallocng.slot_start(X.metas[m], i), mallocng.IB)) && int_lt(int_sub(mallocng.slot_start(X.metas[m], i), mallocng.IB), int_add(P0, L)) proof
      assume e
      have s := subst({y. mallocng.slot_start(X.metas[m], y) = int_add(int_add(P0, 16), mallocng.stride(X.metas[m]))}, sym(e), ss1)
      show by arith(s, kb, lo, vmo, xst)
    qed
    have a1 a2 := (int_le(P0, int_sub(mallocng.slot_start(X.metas[m], i), mallocng.IB)) && int_lt(int_sub(mallocng.slot_start(X.metas[m], i), mallocng.IB), int_add(P0, L))
      by taut(i01, c0, c1))
    have ao: int_sub(mallocng.slot_start(X.metas[m], i), mallocng.IB) in omega by arith(a1, vmo)
    have _ nl _ _ := mp(all_elim(hfr, {int_sub(mallocng.slot_start(X.metas[m], i), mallocng.IB)}), ao,
      mp(all_elim(inr, {int_sub(mallocng.slot_start(X.metas[m], i), mallocng.IB)}), ao, a1, a2))
    show := nl
  qed
  have mp0: int_le(int_add(mallocng.UNIT, int_mul(mallocng.stride(X.metas[m]), int_add(X.metas[m].last_idx, 1))), int_mul(X.metas[m].maplen, 4096)) proof
    have e: int_mul(mallocng.stride(X.metas[m]), int_add(X.metas[m].last_idx, 1)) = int_mul(mallocng.stride(X.metas[m]), 1) by simp(xl0)
    have ml: int_mul(X.metas[m].maplen, 4096) = L by simp(ev)
    show by arith(e, xst, ku, ml)
  qed
  have pv nx := hlk
  show := apply(mp.bg_self[A2 := X, M := M2, b := b, m := m], (X.slots[m] = fn_build(1, i. tag(3, empty)) by simp()), xl0, mim,
    (X.metas[m].sizeclass = 63 by simp(ev, s63)), hdr2, own, act, (X.metas[m].avail = 0 by simp(ev, av0)), (X.metas[m].freed = 0 by simp(ev, fr0)),
    (int_lt(0, X.metas[m].maplen) by simp(ev, hml)), conj((int_mod(X.metas[m].mem, 4096) = 0 by simp(ev, hp)), mp0),
    (X.metas[m].next = 0 by simp(ev, nx)), (X.metas[m].prev = 0 by simp(ev, pv)), chk, sen, co2)
qed

// ----------------------------------------------------------------------
//  The invariant for the new state

// ... on its view
theorem mp.bg_mholds(c, A, vm, V1, b, k, T, m, V): mp.bgpre(c, A, vm, V1, b, k, T, m, V) ->
  mallocng.holds(c, mp.bgrp(A, k, T, m, V), mallocng.mview(V1, mallocng.held(c, mp.bgrp(A, k, T, m, V), b)), b, V1.brk)
proof
  assume P
  let A2 := mp.bgrp(A, k, T, m, V)
  let M := mallocng.mview(vm, mallocng.held(c, A, b))
  let M2 := mallocng.mview(V1, mallocng.held(c, A2, b))
  let MA := mallocng.mview(V1, mallocng.all_bytes())
  have {hc = cfg, hu = univ, ha = abs, hb = blocks, hh = holds, ht = tlist, hte = taken, hmz = mz, hv = meta, hpl = place, hlo = lo, hhi = hi,
    hfr = fresh, hnp = newpg, hmrw = mrw, hbr = brk, hml = maplen} := P
  have hk hkl := hpl
  have {H = inv} := expand(hh, mallocng.holds_m)
  have {hnm = normal, hcl = classes, hdb = debruijn, hga = apart, himg = image, huo = used, hpt = part, cok = ctx, har = areas, hpm = perms, hac = active,
    hbk = brk} := expand(H, mallocng.holds)
  have {hm = nat, gr = range} := apply(mp.bg_basic, P)
  have {ni = init, nax = auxv} := apply(mp.bg_init, P)
  have co: c.ctx in omega by simp(hc)
  have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  // the old groups' bytes and records
  have gbs: all a. a in omega -> mp.ingrp(A, a) -> M2[a] = M[a] proof
    fix a
    assume hao ig
    obtain h, iu gb from expand(ig, mp.ingrp)
    have {go = nat} := apply(mp.used_nat, ha, iu)
    have gok := apply(mp.used_group, huo, iu)
    have g1 g2 := expand(gb, mp.gb)
    have inr := apply(mp.group_bytes[A := A, M := M, b := b, h := h, a := a], ha, go, gok, hao, g1, g2)
    show := apply(mp.bg_gbyte[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, h := h, a := a], P, iu, hao, inr)
  qed
  have rcs: all g. all a. mallocng.is_used(A, g) -> a in omega -> int_le(g, a) -> int_lt(a, int_add(g, 40)) -> M2[a] = M[a] proof
    fix g a
    assume iu hao h1 h2
    show := apply(mp.bg_meta[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, g := g, a := a], P, apply(mp.used_slot, H, iu),
      apply(mp.used_untaken, H, iu), hao, h1, h2)
  qed
  have gm := apply(mp.bg_mself, P)
  // the image, the tables
  have ro2: all i. all a. i in omega -> a in omega -> int_lt(i, x86_64_linux.phnum(c.file)) -> mallocng.in_range(a, mallocng.ro_ranges(c.file)[i]) -> M2[a] = M[a] proof
    fix i a
    assume hi hao hil inr
    show := apply(mp.bg_ro[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, i := i, a := a], P, hi, hil, hao, inr)
  qed
  have d0 d1 d2 := apply(mp.data_at[c := c])
  have cl1 cl2 cl3 := (c.ctx in omega && c.lock in omega && c.libc in omega by simp(hc))
  have lnl: mallocng.L_NEED_LOCKS = 3 by defs(simp(), mallocng.L_NEED_LOCKS)
  have lb: mallocng.in_range(int_add(c.libc, mallocng.L_NEED_LOCKS), mallocng.data_ranges(c)[2]) by defs(simp(d2, lnl, (int_lt(int_add(c.libc, 3), int_add(c.libc, 16)) by arith(cl3))), mallocng.in_range)
  have nl := apply(mp.bg_data[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, i := 2, a := int_add(c.libc, mallocng.L_NEED_LOCKS)], P,
    simp(), simp(), (int_add(c.libc, mallocng.L_NEED_LOCKS) in omega by simp(cl3, lnl)), lb)
  have lk: all i. i in omega -> int_lt(i, 4) -> M2[int_add(c.lock, i)] = M[int_add(c.lock, i)] proof
    fix i
    assume hi hil
    have inr: mallocng.in_range(int_add(c.lock, i), mallocng.data_ranges(c)[1]) by defs(simp(d1, (int_lt(int_add(c.lock, i), int_add(c.lock, 4)) by arith(cl2, hi, hil)), cl2, hi), mallocng.in_range)
    show := apply(mp.bg_data[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, i := 1, a := int_add(c.lock, i)], P, simp(), simp(),
      (int_add(c.lock, i) in omega by simp(cl2, hi)), inr)
  qed
  have img := apply(mp.image_tr[c := c, M := M, M2 := M2], hc, himg, ro2, nl, lk)
  have cl := apply(mp.classes_tr[c := c, M := M, M2 := M2], hc, hcl, ro2)
  have _ _ kd3 := expand(hdb, mallocng.debruijn_ok)
  have dba: all a. a in omega -> int_le(c.dbj, a) -> int_lt(a, int_add(c.dbj, 32)) -> M2[a] = M[a] proof
    fix a
    assume hao h1 h2
    obtain i, hi hil r1 r2 from kd3
    have inr: mallocng.in_range(a, mallocng.ro_ranges(c.file)[i]) by defs(arith(r1, r2, h1, h2), mallocng.in_range)
    show := mp(all_elim(ro2, {i}, {a}), hi, hao, hil, inr)
  qed
  have db := apply(mp.debruijn_tr[c := c, M := M, M2 := M2], hc, hdb, dba)
  // the context: its bytes, the lists' links as before
  have cx: all a. a in omega -> int_le(c.ctx, a) -> int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE)) -> M2[a] = M[a] proof
    fix a
    assume hao h1 h2
    have inr: mallocng.in_range(a, mallocng.data_ranges(c)[0]) by defs(simp(d0, h1, h2), mallocng.in_range)
    show := apply(mp.bg_data[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, i := 0, a := a], P, simp(), simp(), hao, inr)
  qed
  have {fs = free_slots} := expand(hpt, mallocng.metas_partition)
  have fmr: all i. all a. i in omega -> a in omega -> int_lt(i, seq_len(A.free_metas)) -> int_le(A.free_metas[i], a) -> int_lt(a, int_add(A.free_metas[i], 16)) -> M2[a] = M[a] proof
    fix i a
    assume hi hao hil h1 h2
    have ms _ := mp(all_elim(fs, {i}), hi, hil)
    show := apply(mp.bg_meta[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, g := A.free_metas[i], a := a], P, ms,
      apply(mp.free_untaken, H, hi, hil), hao, h1, arith(h2))
  qed
  have acr: all s. all i. all a. s in omega -> i in omega -> a in omega -> int_lt(s, 48) -> int_lt(i, seq_len(A.active[s])) -> int_le(A.active[s][i], a) ->
      int_lt(a, int_add(A.active[s][i], 16)) -> M2[a] = M[a] proof
    fix s i a
    assume hs hi hao hsl hil h1 h2
    have iu _ _ := mp(all_elim(expand(hac, mallocng.active_ok), {s}, {i}), conj(hs, hi), conj(hsl, hil))
    show := apply(mp.bg_meta[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, g := A.active[s][i], a := a], P, apply(mp.used_slot, H, iu),
      apply(mp.used_untaken, H, iu), hao, h1, arith(h2))
  qed
  have cok1 := apply(mp.ctx_agree[c := c, A := A, M := M, M2 := M2], hc, ha, cok, cx, fmr, acr)
  have cok2: mallocng.ctx_ok(c, A2, M2) by defs(simp(expand(cok1, mallocng.ctx_ok)), mallocng.ctx_ok)
  have fr2: mallocng.fresh_ok(c, A2, M2) by defs(taut((!(A2.init_done = 0) by simp(ni))), mallocng.fresh_ok)
  // the meta areas
  have {hd = head, tl = tail, ea = each, ds = distinct, rs = reserve} := expand(har, mallocng.areas_ok)
  have chd: mallocng.ctx_word(c, M2, mallocng.C_AREA_HEAD) = mallocng.ctx_word(c, M, mallocng.C_AREA_HEAD) proof
    have ai: all i. i in omega -> int_lt(i, 8) -> M2[int_add(int_add(c.ctx, mallocng.C_AREA_HEAD), i)] = M[int_add(int_add(c.ctx, mallocng.C_AREA_HEAD), i)] proof
      fix i
      assume hi hil
      show := mp(all_elim(cx, {int_add(int_add(c.ctx, mallocng.C_AREA_HEAD), i)}), arith(co, hi), defs(arith(co, hi), mallocng.C_AREA_HEAD), defs(arith(co, hi, hil, ks), mallocng.C_AREA_HEAD))
    qed
    show by defs(apply(mp.agree_rd, simp(), ai), mallocng.ctx_word)
  qed
  have ctl: mallocng.ctx_word(c, M2, mallocng.C_AREA_TAIL) = mallocng.ctx_word(c, M, mallocng.C_AREA_TAIL) proof
    have ai: all i. i in omega -> int_lt(i, 8) -> M2[int_add(int_add(c.ctx, mallocng.C_AREA_TAIL), i)] = M[int_add(int_add(c.ctx, mallocng.C_AREA_TAIL), i)] proof
      fix i
      assume hi hil
      show := mp(all_elim(cx, {int_add(int_add(c.ctx, mallocng.C_AREA_TAIL), i)}), arith(co, hi), defs(arith(co, hi), mallocng.C_AREA_TAIL), defs(arith(co, hi, hil, ks), mallocng.C_AREA_TAIL))
    qed
    show by defs(apply(mp.agree_rd, simp(), ai), mallocng.ctx_word)
  qed
  have rl: A.areas in list_type(omega) by simp(ha)
  have e2: all x0. x0 in omega -> int_lt(x0, seq_len(A.areas)) -> ((((int_mod(A.areas[x0], 4096) = 0 && int_lt(0, A.areas[x0])) && mallocng.rd(M2, A.areas[x0], 8) = A.secret) &&
      mallocng.rd(M2, int_add(A.areas[x0], 8), 8) = ite(int_lt(int_add(x0, 1), seq_len(A.areas)), A.areas[int_add(x0, 1)], 0)) && mallocng.rd(M2, int_add(A.areas[x0], 16), 4) = mallocng.NSLOTS) &&
      (all x1. x1 in omega -> (int_le(A.areas[x0], x1) && int_lt(x1, int_add(A.areas[x0], 4096))) && !mallocng.in_taken(A, x1) -> mallocng.m_rw(M2, x1) && !(snd(mallocng.pg(M2, x1)).kind = 2)) proof
    fix j
    assume hj hjl
    have q1 q2 q3 q4 q5 qr := mp(all_elim(ea, {j}), hj, hjl)
    have ajo := apply(at_type[l := A.areas, t := omega, i := j], rl, hj, hjl)
    have hh2: all i. i in omega -> int_lt(i, 24) -> M2[int_add(A.areas[j], i)] = M[int_add(A.areas[j], i)] proof
      fix i
      assume hi hil
      show := apply(mp.bg_hdr[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, j := j, a := int_add(A.areas[j], i)], P, hj, hjl,
        arith(ajo, hi), arith(hi), arith(hil))
    qed
    have h0: all i. i in omega -> int_lt(i, 8) -> M2[int_add(A.areas[j], i)] = M[int_add(A.areas[j], i)] proof
      fix i
      assume hi hil
      show := mp(all_elim(hh2, {i}), hi, arith(hil))
    qed
    have h8: all i. i in omega -> int_lt(i, 8) -> M2[int_add(int_add(A.areas[j], 8), i)] = M[int_add(int_add(A.areas[j], 8), i)] proof
      fix i
      assume hi hil
      have e := mp(all_elim(hh2, {int_add(8, i)}), arith(hi), arith(hil))
      show := rewrite((int_add(A.areas[j], int_add(8, i)) = int_add(int_add(A.areas[j], 8), i) by arith(ajo, hi)), e)
    qed
    have h16: all i. i in omega -> int_lt(i, 4) -> M2[int_add(int_add(A.areas[j], 16), i)] = M[int_add(int_add(A.areas[j], 16), i)] proof
      fix i
      assume hi hil
      have e := mp(all_elim(hh2, {int_add(16, i)}), arith(hi), arith(hil))
      show := rewrite((int_add(A.areas[j], int_add(16, i)) = int_add(int_add(A.areas[j], 16), i) by arith(ajo, hi)), e)
    qed
    have r0 := trans(apply(mp.agree_rd[M := M, M2 := M2, a := A.areas[j], n := 8], simp(), h0), q3)
    have r8 := trans(apply(mp.agree_rd, simp(), h8), q4)
    have r16 := trans(apply(mp.agree_rd, simp(), h16), q5)
    have rw: all x1. x1 in omega -> (int_le(A.areas[j], x1) && int_lt(x1, int_add(A.areas[j], 4096))) && !mallocng.in_taken(A, x1) -> mallocng.m_rw(M2, x1) && !(snd(mallocng.pg(M2, x1)).kind = 2) proof
      fix a
      assume hao hr
      have hr1 hr2 nt := hr
      have nr: !(int_le(m, a) && int_lt(a, int_add(m, mallocng.META_SIZE))) proof
        assume w
        have w1 w2 := w
        have {wt = was} := apply(mp.bg_mrec[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, a := a], P, hao, w1, w2)
        show by taut(wt, nt)
      qed
      have e := apply(mp.bg_area[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, j := j, a := a], P, hj, hjl, hao, hr1, hr2, nr)
      have pe: mallocng.pg(M2, a) = mallocng.pg(M, a) by defs(simp(e), mallocng.pg)
      have {r = rw} := apply(mp.pg_same, pe)
      have o1 o2 := mp(all_elim(qr, {a}), hao, hr)
      show by taut(r, o1, rewrite(sym(pe), o2))
    qed
    show by taut(q1, q2, r0, r8, r16, rw)
  qed
  have rs2: all x0. x0 in omega -> int_le(A.reserve, x0) && int_lt(x0, int_add(A.reserve, int_mul(4096, A.reserve_cnt))) ->
      (mallocng.m_mapped(M2, x0) && !(snd(mallocng.pg(M2, x0)).kind = 2)) && mallocng.b8(M2, x0) = 0 proof
    fix a
    assume hao hr
    have e := apply(mp.bg_res[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, a := a], P, hao, (mallocng.in_range(a, pair(A.reserve, int_mul(4096, A.reserve_cnt))) by defs(simp(hr), mallocng.in_range)))
    have pe: mallocng.pg(M2, a) = mallocng.pg(M, a) by defs(simp(e), mallocng.pg)
    have be: mallocng.b8(M2, a) = mallocng.b8(M, a) by defs(simp(e), mallocng.b8)
    have {mm = mapped} := apply(mp.pg_same, pe)
    have o1 o2 o3 := mp(all_elim(rs, {a}), hao, hr)
    show by taut(mm, o1, rewrite(sym(pe), o2), trans(be, o3))
  qed
  have ar2: mallocng.areas_ok(c, A, M2) by defs(simp(rewrite(sym(chd), hd), rewrite(sym(ctl), tl), e2, ds, rs2), mallocng.areas_ok)
  // m's record, the new group but its slot's interior: accessible
  have mrw2: all a. a in omega -> int_le(m, a) -> int_lt(a, int_add(m, mallocng.META_SIZE)) -> mallocng.m_rw(M2, a) && !(snd(mallocng.pg(M2, a)).kind = 2) proof
    fix a
    assume hao h1 h2
    have {pe = pg} := apply(mp.bg_at[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, a := a], P, hao, taut(h1, h2))
    have {r = rw} := apply(mp.pg_same, pe)
    have o1 o2 := mp(all_elim(hmrw, {a}), hao, h1, h2)
    show by taut(r, o1, rewrite(sym(pe), o2))
  qed
  have gpm: all a. a in omega -> mallocng.in_range(a, mallocng.group_range(V)) -> !(a in malloc.live_of(b)) -> !mallocng.in_slot(V, 0, a) ->
      mallocng.m_rw(M2, a) && !(snd(mallocng.pg(M2, a)).kind = 2) proof
    fix a
    assume hao hr _ ns
    have {pe = pg} := apply(mp.bg_at[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, a := a], P, hao, taut(hr, ns))
    have {r = rw} := apply(mp.pg_same, pe)
    have o1 o2 := mp(all_elim(hnp, {a}), hao, hr)
    show by taut(r, o1, rewrite(sym(pe), o2))
  qed
  have bk2: mallocng.brk_ok(A2, V1.brk) by defs(simp(expand(hbk, mallocng.brk_ok), hbr), mallocng.brk_ok)
  // the old state's accesses on the new view
  have {pd = data, pgr = groups} := expand(hpm, mallocng.perms_ok)
  have pd2: all x0. all x1. x0 in omega && x1 in omega -> ((int_lt(x0, 3) && int_le(fst(mallocng.data_ranges(c)[x0]), x1)) &&
      int_lt(x1, int_add(fst(mallocng.data_ranges(c)[x0]), snd(mallocng.data_ranges(c)[x0])))) && !mallocng.ctx_free(c, x1) ->
      mallocng.m_rw(M2, x1) && !(snd(mallocng.pg(M2, x1)).kind = 2) proof
    fix i a
    assume ho h
    have hi hao := ho
    have hil h1 h2 _ := h
    have e := apply(mp.bg_data[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, i := i, a := a], P, hi, hil, hao,
      (mallocng.in_range(a, mallocng.data_ranges(c)[i]) by defs(taut(h1, h2), mallocng.in_range)))
    have pe: mallocng.pg(M2, a) = mallocng.pg(M, a) by defs(simp(e), mallocng.pg)
    have {r = rw} := apply(mp.pg_same, pe)
    have o1 o2 := mp(all_elim(pd, {i}, {a}), ho, h)
    show by taut(r, o1, rewrite(sym(pe), o2))
  qed
  have pg2: all x0. all x1. x0 in omega && x1 in omega -> (((int_lt(x0, seq_len(A.used)) && int_le(fst(mallocng.group_range(A.metas[A.used[x0]])), x1)) &&
      int_lt(x1, int_add(fst(mallocng.group_range(A.metas[A.used[x0]])), snd(mallocng.group_range(A.metas[A.used[x0]]))))) && !(x1 in malloc.live_of(b))) &&
      !mallocng.in_reserved(A, x1) -> mallocng.m_rw(M2, x1) && !(snd(mallocng.pg(M2, x1)).kind = 2) proof
    fix j a
    assume ho h
    have hj hao := ho
    have hjl h1 h2 _ _ := h
    have iu: mallocng.is_used(A, A.used[j]) by defs(ex_intro({j}, taut(hj, hjl, refl({A.used[j]}))), mallocng.is_used)
    have e := apply(mp.bg_gbyte[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, h := A.used[j], a := a], P, iu, hao,
      (mallocng.in_range(a, mallocng.group_range(A.metas[A.used[j]])) by defs(taut(h1, h2), mallocng.in_range)))
    have pe: mallocng.pg(M2, a) = mallocng.pg(M, a) by defs(simp(e), mallocng.pg)
    have {r = rw} := apply(mp.pg_same, pe)
    have o1 o2 := mp(all_elim(pgr, {j}, {a}), ho, h)
    show by taut(r, o1, rewrite(sym(pe), o2))
  qed
  have pa2: all x0. all x1. x0 in omega && x1 in omega -> (int_lt(x0, seq_len(mallocng.auxv_ranges(A))) && int_le(fst(mallocng.auxv_ranges(A)[x0]), x1)) &&
      int_lt(x1, int_add(fst(mallocng.auxv_ranges(A)[x0]), snd(mallocng.auxv_ranges(A)[x0]))) ->
      (mallocng.m_mapped(M2, x1) && snd(mallocng.pg(M2, x1)).prot.r) && !(snd(mallocng.pg(M2, x1)).kind = 2) proof
    fix j a
    assume ho h
    have hj hao := ho
    have hjl h1 h2 := h
    have ir: mallocng.in_ranges(a, mallocng.auxv_ranges(A)) by defs(ex_intro({j}, taut(hj, hjl, (mallocng.in_range(a, mallocng.auxv_ranges(A)[j]) by defs(taut(h1, h2), mallocng.in_range)))),
      mallocng.in_ranges)
    have f: false by taut(ir, all_elim(nax, {a}))
    show by taut(f)
  qed
  have pm2: mallocng.perms_ok(c, A, M2, b) by defs(taut(pd2, pg2, pa2), mallocng.perms_ok)
  // the new group's range: apart from every region, from the fixed ones
  have rn := apply(mp.regions_nat, hc, hu, ha)
  have sep: int_lt(0, V.maplen) -> all i. i in omega -> int_lt(i, seq_len(mallocng.regions(c, A))) -> mallocng.apart(mallocng.group_range(V), mallocng.regions(c, A)[i]) proof
    assume _
    fix i
    assume hi hil
    have rc := apply(at_type[l := mallocng.regions(c, A), t := cart(omega, omega), i := i], rn, hi, hil)
    have vf: (V.mem in omega && V.maplen in omega) by simp(hv)
    have vm0 vm1 := vf
    have gc: mallocng.group_range(V) in cart(omega, omega) := rewrite(sym(gr), mp(cart_intro[a := omega, b := omega, x := V.mem, y := int_mul(V.maplen, 4096)], vm0,
      (int_mul(V.maplen, 4096) in omega by arith(vm1))))
    have q: all a. a in omega -> mallocng.in_range(a, mallocng.group_range(V)) -> !mallocng.in_range(a, mallocng.regions(c, A)[i]) proof
      fix a
      assume hao hr w
      have ir: mallocng.in_ranges(a, mallocng.regions(c, A)) by defs(ex_intro({i}, taut(hi, hil, w)), mallocng.in_ranges)
      have no _ _ _ := mp(all_elim(hfr, {a}), hao, hr)
      show by taut(no, apply(mp.regions_fp, hc, hu, ha, ir))
    qed
    show := apply(mp.apart_of, gc, rc, q)
  qed
  have {p6 = groups} := apply(mp.fp_pieces, hc, hu, ha)
  have x1: mallocng.fixed_ranges(c, A) in list_type(univ(1)) by defs(apply(mp.pre_list, hc, hu, ha), mallocng.fixed_ranges)
  have apt: all a. a in omega -> mallocng.in_range(a, mallocng.group_range(V)) -> !mallocng.in_ranges(a, mallocng.fixed_ranges(c, A)) proof
    fix a
    assume hao hr w
    have no _ _ _ := mp(all_elim(hfr, {a}), hao, hr)
    show by taut(no, (mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) by defs(apply(mp.ranges_l, x1, p6, w), mallocng.fp_ranges)))
  qed
  show := apply(mp.bg_holds[c := c, A := A, k := k, T := T, m := m, V := V, M := M, M2 := M2, b := b, brk := vm.brk, brk2 := V1.brk],
    hc, hu, ha, hb, H, ht, hte, hmz, hv, hk, hkl, hlo, hhi, gbs, rcs, gm, img, cok2, fr2, ar2, mrw2, bk2, pm2, gpm, cl, db, sep, apt)
qed

// The step: the invariant in memory for the state with the big group made
theorem mp.bg_holds_m(c, A, vm, V1, b, k, T, m, V): mp.bgpre(c, A, vm, V1, b, k, T, m, V) -> mallocng.holds_m(c, mp.bgrp(A, k, T, m, V), V1, b)
proof
  assume P
  let A2 := mp.bgrp(A, k, T, m, V)
  let M := mallocng.mview(vm, mallocng.held(c, A, b))
  have {hc = cfg, hu = univ, ha = abs, hb = blocks, hh = holds, hpg = pages, hnp = newpg, hfr = fresh, hpl = place} := P
  have hk hkl := hpl
  have {H = inv, hm0 = mapped, hfw = free, hrw = rw} := expand(hh, mallocng.holds_m)
  have {huo = used, hga = apart} := expand(H, mallocng.holds)
  have {hm = nat, nm = unused, gr = range} := apply(mp.bg_basic, P)
  have h2 := apply(mp.bg_mholds, P)
  have ab: all a. a in omega -> a in mallocng.all_bytes() proof
    fix a
    assume hao
    show by defs(sel(taut(hao)), mallocng.all_bytes)
  qed
  // (a byte of the slot's interior: in m's group)
  have sg: all a. mallocng.in_slot(V, 0, a) -> mallocng.in_range(a, mallocng.group_range(V)) proof
    fix a
    assume w
    have sl := apply(mp.bg_sl[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, a := a], P)
    have w1 w2 := (int_lt(int_add(V.mem, 12), a) && int_lt(a, int_sub(int_add(V.mem, int_mul(V.maplen, 4096)), 4)) by taut(sl, w))
    show by defs(simp(gr, (int_le(V.mem, a) by arith(w1)), (int_lt(a, int_add(V.mem, int_mul(V.maplen, 4096))) by arith(w2))), mallocng.in_range)
  qed
  // the owned bytes mapped: the old ones on their pages, the new group's fresh
  have mq: all x0. all x1. x0 in omega && x1 in omega -> ((int_lt(x0, seq_len(mallocng.fp_ranges(c, A2))) && int_le(fst(mallocng.fp_ranges(c, A2)[x0]), x1)) &&
      int_lt(x1, int_add(fst(mallocng.fp_ranges(c, A2)[x0]), snd(mallocng.fp_ranges(c, A2)[x0])))) && !(x1 in malloc.live_of(b)) ->
      x86_64_linux.mapped(V1, int_div(x1, x86_64_linux.PAGE)) && !(snd(V1.pages[int_div(x1, x86_64_linux.PAGE)]).kind = 2) proof
    fix j a
    assume ho h
    have hj hao := ho
    have hjl h1 h2a nl := h
    have inr: mallocng.in_range(a, mallocng.fp_ranges(c, A2)[j]) by defs(taut(h1, h2a), mallocng.in_range)
    have ir2: mallocng.in_ranges(a, mallocng.fp_ranges(c, A2)) by defs(ex_intro({j}, taut(hj, hjl, inr)), mallocng.in_ranges)
    have fpr := apply(mp.bg_fpr[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, a := a], P)
    have c1: mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) -> x86_64_linux.mapped(V1, int_div(a, x86_64_linux.PAGE)) && !(snd(V1.pages[int_div(a, x86_64_linux.PAGE)]).kind = 2) proof
      assume ir
      have m0 := apply(mp.owned_mapped, ha, hb, hh, hao, ir)
      obtain k1, hk1 hk1l hr1 from expand(ir, mallocng.in_ranges)
      have g1 g2 := expand(hr1, mallocng.in_range)
      have _ ns := mp(all_elim(expand(hm0, mallocng.fp_mapped), {k1}, {a}), conj(hk1, hao), taut(hk1l, g1, g2, nl))
      have mm: x86_64_linux.mapped(V1, int_div(a, x86_64_linux.PAGE)) by defs(simp(hpg, expand(m0, x86_64_linux.mapped)), x86_64_linux.mapped)
      show by taut(mm, rewrite(sym(hpg), ns))
    qed
    have c2: mallocng.in_range(a, mallocng.group_range(V)) -> x86_64_linux.mapped(V1, int_div(a, x86_64_linux.PAGE)) && !(snd(V1.pages[int_div(a, x86_64_linux.PAGE)]).kind = 2) proof
      assume w
      have mm mk := mp(all_elim(hnp, {a}), hao, w)
      have mr _ _ := expand(mm, mallocng.m_rw)
      have mb mn := expand(mr, mallocng.m_mapped)
      have p0 := apply(mp.pg_view[vm := V1, fp := mallocng.all_bytes(), a := a], hao, mp(all_elim(ab, {a}), hao))
      have mm2: x86_64_linux.mapped(V1, int_div(a, x86_64_linux.PAGE)) by defs(taut(mb, rewrite(p0, mn)), x86_64_linux.mapped)
      show by taut(mm2, rewrite(p0, mk))
    qed
    show by taut(fpr, ir2, c1, c2)
  qed
  have m2: mallocng.fp_mapped(mallocng.fp_ranges(c, A2), b, V1) by defs(mq, mallocng.fp_mapped)
  // the free bytes: the context's, owned before and after
  have fm: all a. a in omega -> mallocng.ctx_free(c, a) -> (a in mallocng.footprint(c, A, b) <-> a in mallocng.footprint(c, A2, b)) proof
    fix a
    assume hao hfa
    have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
    have i1 i2 := (int_le(c.ctx, a) && int_lt(a, int_add(c.ctx, mallocng.CTX_SIZE))
      by arith(expand(hfa, mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_USAGE, mallocng.C_BRK), ks))
    have cf := apply(mp.ctx_fp[c := c, A := A, vm := vm, b := b, a := a], hc, hu, ha, hh, hao, i1, i2)
    have ef := apply(mp.bg_fp[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, a := a], P)
    show by taut(ef, cf)
  qed
  have f1 := apply(mp.free_rw_mem[c := c, vm := vm, F1 := mallocng.footprint(c, A, b), F2 := mallocng.footprint(c, A2, b)], hfw, fm)
  have fq: all a. a in omega -> mallocng.ctx_free(c, a) -> mallocng.m_rw(mallocng.mview(V1, mallocng.footprint(c, A2, b)), a) &&
      !(snd(mallocng.pg(mallocng.mview(V1, mallocng.footprint(c, A2, b)), a)).kind = 2) proof
    fix a
    assume hao hfa
    have o1 o2 := mp(all_elim(expand(f1, mallocng.free_rw), {a}), hao, hfa)
    have pe := apply(mp.view_pg[vm := vm, vm2 := V1, fp := mallocng.footprint(c, A2, b), a := a], hao, hpg)
    have {rw = rw} := apply(mp.pg_same, pe)
    show by taut(rw, o1, rewrite(sym(pe), o2))
  qed
  have f2: mallocng.free_rw(c, mallocng.mview(V1, mallocng.footprint(c, A2, b))) by defs(fq, mallocng.free_rw)
  // the groups' bytes: the old ones on their pages, the new group's fresh
  have gq: all x0. all x1. x0 in omega && x1 in omega -> (mallocng.is_used(A2, x0) && mallocng.in_range(x1, mallocng.group_range(A2.metas[x0]))) &&
      ((x1 in mallocng.footprint(c, A2, b) || x1 in malloc.live_of(b)) || mallocng.in_reserved(A2, x1)) ->
      mallocng.m_rw(mallocng.mview(V1, mallocng.all_bytes()), x1) && !(snd(mallocng.pg(mallocng.mview(V1, mallocng.all_bytes()), x1)).kind = 2) proof
    fix g a
    assume ho h
    have hg hao := ho
    have iu2 inr2 w := h
    have d1: g = m -> mallocng.m_rw(mallocng.mview(V1, mallocng.all_bytes()), a) && !(snd(mallocng.pg(mallocng.mview(V1, mallocng.all_bytes()), a)).kind = 2) proof
      assume e
      show := mp(all_elim(hnp, {a}), hao, rewrite((A2.metas[g] = V by simp(e)), inr2))
    qed
    have d2: mallocng.is_used(A, g) && (A2.metas[g] = A.metas[g] && A2.slots[g] = A.slots[g]) ->
        mallocng.m_rw(mallocng.mview(V1, mallocng.all_bytes()), a) && !(snd(mallocng.pg(mallocng.mview(V1, mallocng.all_bytes()), a)).kind = 2) proof
      assume q
      have iu em _ := q
      have inr: mallocng.in_range(a, mallocng.group_range(A.metas[g])) := rewrite(em, inr2)
      have {ow = own} := apply(mp.grp_own[c := c, A := A, M := M, b := b, brk := vm.brk, g := g, a := a], hc, hu, ha, H, iu, hao, inr)
      have ef := apply(mp.bg_fp[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, a := a], P)
      have ng: !mallocng.in_range(a, mallocng.group_range(V)) proof
        assume w2
        have no2 _ _ _ := mp(all_elim(hfr, {a}), hao, w2)
        show by taut(no2, ow)
      qed
      have nr: !(int_le(m, a) && int_lt(a, int_add(m, mallocng.META_SIZE))) proof
        assume w2
        have w3 w4 := w2
        have {fx = fixed} := apply(mp.bg_mrec[c := c, A := A, vm := vm, V1 := V1, b := b, k := k, T := T, m := m, V := V, a := a], P, hao, w3, w4)
        obtain l, hl hll hle from expand(iu, mallocng.is_used)
        have q2 := mp(all_elim(expand(hga, mallocng.groups_apart), {l}, {a}), conj(hl, hao), conj(hll, rewrite(sym(hle), inr)))
        show by taut(q2, fx)
      qed
      have re := apply(mp.bg_inres[A := A, k := k, T := T, m := m, V := V, a := a], ha, hk, hkl, hm, nm)
      have w1: (a in mallocng.footprint(c, A, b) || a in malloc.live_of(b)) || mallocng.in_reserved(A, a) by taut(w, ef, ng, nr, re, all_elim(sg, {a}))
      have o1 o2 := mp(all_elim(expand(hrw, mallocng.grp_rw), {g}, {a}), ho, taut(iu, inr, w1))
      have pe := apply(mp.view_pg[vm := vm, vm2 := V1, fp := mallocng.all_bytes(), a := a], hao, hpg)
      have {rw = rw} := apply(mp.pg_same, pe)
      show by taut(rw, o1, rewrite(sym(pe), o2))
    qed
    show by taut(apply(mp.bg_member[A := A, k := k, T := T, m := m, V := V, g := g], ha, hk, hkl, hm, nm, iu2), d1, d2)
  qed
  have r2: mallocng.grp_rw(c, A2, V1, b) by defs(gq, mallocng.grp_rw)
  // (the reserve's pages: as they were)
  have {hrs = rsv} := expand(hh, mallocng.holds_m)
  have {ep0 = pages, est = stk} := P
  have et el := est
  have rs2 := apply(mp.rsv_pages[A := A, A2 := A2, vm := vm, vm2 := V1], hrs, (A2.reserve = A.reserve by simp()), (A2.reserve_cnt = A.reserve_cnt by simp()), ep0, et, el)
  show by defs(taut(h2, m2, f2, r2, rs2), mallocng.holds_m)
qed
