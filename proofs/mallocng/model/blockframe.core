// A reserved slot framed for a client block (malloc's last step: enframe
// on the slot alloc_slot reserved, or malloc's own): the slot holds the
// block, the block is live -- the invariant kept.
//
//   checked after proofs/mallocng/model/groupnest.core

// ----------------------------------------------------------------------
//  Geometry: slots apart

// two slots neither of which holds a nested group, not the same: one's
// span (its check byte to its end) misses the other's interior -- in one
// group by their places, across groups by nesting (the inner group lies in
// a nested slot of the outer, neither of these)
theorem mp.slot_apart(c, A, M, b, brk, g, i, h, j, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds(c, A, M, b, brk) ->
  mallocng.is_used(A, g) -> i in omega -> int_lt(i, seq_len(A.slots[g])) -> !(fst(A.slots[g][i]) = 2) ->
  mallocng.is_used(A, h) -> j in omega -> int_lt(j, seq_len(A.slots[h])) -> !(fst(A.slots[h][j]) = 2) ->
  !(g = h && i = j) -> a in omega ->
  int_le(int_sub(mallocng.slot_start(A.metas[h], j), 4), a) -> int_le(a, mallocng.slot_end(A.metas[h], j)) -> !mallocng.in_slot(A.metas[g], i, a)
proof
  assume hc hu ha H hg hi hil ng hh hj hjl nh ne hao la lb
  assume his
  have {huo = used} := expand(H, mallocng.holds)
  let V := A.metas[h]
  let W := A.metas[g]
  have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
  // (slot j of h: its span among h's bytes)
  have {ho = nat} := apply(mp.used_nat, ha, hh)
  have hk := apply(mp.used_group, huo, hh)
  have {hm = mem, hl0 = last, hst = stride, hss = start, hse = end, hns = nslots} := apply(mp.geo, ha, ho, hk)
  have mj: int_mul(mallocng.stride(V), j) in omega by simp(hst, hj)
  have il: int_le(j, V.last_idx) by arith(hns, hjl, hj, hl0)
  have ml := mp(all_elim(ms.mul_le, {mallocng.stride(V)}, {j}, {mallocng.stride(V)}, {V.last_idx}), hst, hj, simp(hst), simp(hl0), arith(hst), il)
  have v12: int_le(int_add(V.mem, 12), a) by arith(la, all_elim(hss, {j}), mj)
  have vle: int_le(a, mallocng.slot_end(V, V.last_idx)) by arith(lb, all_elim(hse, {j}), all_elim(hse, {V.last_idx}), ml)
  have gb: mp.gb(A, h, a) by defs(taut((int_le(V.mem, a) by arith(v12)), vle), mp.gb)
  have cj1: int_le(int_sub(int_add(int_add(V.mem, 16), int_mul(mallocng.stride(V), j)), 4), a) by arith(la, all_elim(hss, {j}))
  have cj2: int_le(a, int_sub(int_add(int_add(int_add(V.mem, 16), int_mul(mallocng.stride(V), j)), mallocng.stride(V)), 4)) by arith(lb, all_elim(hse, {j}))
  // (slot i of g: its interior among g's bytes)
  have {go = nat} := apply(mp.used_nat, ha, hg)
  have gk := apply(mp.used_group, huo, hg)
  have {gm2 = mem, gl2 = last, gs2 = stride, gss2 = start, gse2 = end, gns2 = nslots} := apply(mp.geo, ha, go, gk)
  have s1 s2 := expand(his, mallocng.in_slot)
  have ili: int_le(i, W.last_idx) by arith(gns2, hil, hi, gl2)
  have mi := mp(all_elim(ms.mul_le, {mallocng.stride(W)}, {i}, {mallocng.stride(W)}, {W.last_idx}), gs2, hi, simp(gs2), simp(gl2), arith(gs2), ili)
  have moi: int_mul(mallocng.stride(W), i) in omega by simp(gs2, hi)
  have q1: int_lt(int_add(W.mem, 12), a) by arith(s1, ci, all_elim(gss2, {i}), moi)
  have q2: int_lt(a, mallocng.slot_end(W, W.last_idx)) by arith(s2, all_elim(gse2, {i}), all_elim(gse2, {W.last_idx}), mi)
  have gg: mp.gb(A, g, a) by defs(taut((int_le(W.mem, a) by arith(q1)), (int_le(a, mallocng.slot_end(W, W.last_idx)) by arith(q2))), mp.gb)
  have ini: int_lt(int_sub(int_add(int_add(W.mem, 16), int_mul(mallocng.stride(W), i)), 4), a) &&
      int_lt(a, int_sub(int_add(int_add(int_add(W.mem, 16), int_mul(mallocng.stride(W), i)), mallocng.stride(W)), 4))
    by arith(s1, s2, ci, all_elim(gss2, {i}), all_elim(gse2, {i}))
  // the same group: two of its slots, apart
  have same: g = h -> false proof
    assume e
    have nij: !(j = i) proof
      assume e2
      show by taut(ne, e, sym(e2))
    qed
    have t1 t2 := expand(rewrite(e, his), mallocng.in_slot)
    have s := apply(mp.slot_sep[m := V.mem, S := mallocng.stride(V), i := j, j := i, a := a], hm, hst, hj, hi, nij, cj1, cj2)
    show by taut(s, (int_lt(int_sub(int_add(int_add(V.mem, 16), int_mul(mallocng.stride(V), i)), 4), a) by arith(t1, ci, all_elim(hss, {i}))),
      (int_lt(a, int_sub(int_add(int_add(int_add(V.mem, 16), int_mul(mallocng.stride(V), i)), mallocng.stride(V)), 4)) by arith(t2, all_elim(hse, {i}))))
  qed
  // groups nest: the inner one in a nested slot of the outer -- apart from
  // the slot there
  have other: !(g = h) -> false proof
    assume nge
    // h inside a nested slot j2 of g: j2 not i; slot j2's span holds a
    have below: int_lt(W.mem, V.mem) -> false proof
      assume l
      obtain j2, a1 _ a3 a4 a5 _ from expand(apply(mp.laminar, hc, hu, ha, H, hh, hg, l, hao, gb, gg), mp.inside)
      have ij: !(j2 = i) proof
        assume e
        show by taut(ng, rewrite(e, a3))
      qed
      have s := apply(mp.slot_sep[m := W.mem, S := mallocng.stride(W), i := j2, j := i, a := a], gm2, gs2, a1, hi, ij,
        (int_le(int_sub(int_add(int_add(W.mem, 16), int_mul(mallocng.stride(W), j2)), 4), a) by arith(a4, v12, all_elim(gss2, {j2}))),
        (int_le(a, int_sub(int_add(int_add(int_add(W.mem, 16), int_mul(mallocng.stride(W), j2)), mallocng.stride(W)), 4)) by arith(a5, vle, all_elim(gse2, {j2}))))
      show by taut(s, ini)
    qed
    have eqm: W.mem = V.mem -> false proof
      assume e
      show by taut(nge, apply(mp.same_mem, H, hg, hh, e))
    qed
    // g inside a nested slot j2 of h: j2 not j; slot j2's interior holds a
    have above: int_lt(V.mem, W.mem) -> false proof
      assume l
      obtain j2, a1 _ a3 a4 a5 _ from expand(apply(mp.laminar, hc, hu, ha, H, hg, hh, l, hao, gg, gb), mp.inside)
      have jj: !(j2 = j) proof
        assume e
        show by taut(nh, rewrite(e, a3))
      qed
      have s := apply(mp.slot_sep[m := V.mem, S := mallocng.stride(V), i := j, j := j2, a := a], hm, hst, hj, a1, (!(j = j2) by taut(jj, (j = j2 -> j2 = j by taut()))), cj1, cj2)
      show by taut(s, (int_lt(int_sub(int_add(int_add(V.mem, 16), int_mul(mallocng.stride(V), j2)), 4), a) by arith(a4, q1, all_elim(hss, {j2}))),
        (int_lt(a, int_sub(int_add(int_add(int_add(V.mem, 16), int_mul(mallocng.stride(V), j2)), mallocng.stride(V)), 4)) by arith(a5, q2, all_elim(hse, {j2}))))
    qed
    show by taut(below, eqm, above, (int_lt(W.mem, V.mem) || W.mem = V.mem || int_lt(V.mem, W.mem) by arith(gm2, hm)))
  qed
  show by taut(same, other)
qed

// a frame for n bytes at p in slot i: p from the slot's start, p and its
// place (`extent`: at least a byte) before the slot's end -- a slot's
// interior less 4 is 12 past whole units, p whole units past its start
theorem mp.frame_ext(M, v, i, p, n, t): v in mallocng.MetaV -> i in omega -> p in omega -> n in omega -> mallocng.frame_ok(M, v, i, p, n, t) ->
  int_le(mallocng.slot_start(v, i), p) && int_le(int_add(p, malloc.extent(n)), mallocng.slot_end(v, i))
proof
  assume hv hi hp hn hf
  have {f1 = start, fu = unit, f3 = fits} := expand(hf, mallocng.frame_ok)
  have s16 := apply(mp.stride16, hv)
  have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
  have se: mallocng.slot_end(v, i) = int_sub(int_add(mallocng.slot_start(v, i), mallocng.stride(v)), 4) by defs(refl({int_sub(int_add(mallocng.slot_start(v, i), mallocng.stride(v)), 4)}),
    mallocng.slot_end, mallocng.IB)
  have z: n = 0 -> int_le(int_add(p, malloc.extent(n)), mallocng.slot_end(v, i)) proof
    assume e
    have x1: malloc.extent(n) = 1 by defs(simp(e), malloc.extent)
    show by arith(x1, e, f1, rewrite(cu, fu), f3, s16, se, hp)
  qed
  have nz: !(n = 0) -> int_le(int_add(p, malloc.extent(n)), mallocng.slot_end(v, i)) proof
    assume e
    have xn: malloc.extent(n) = n by defs(simp(e), malloc.extent)
    show by arith(xn, f3)
  qed
  show by taut(f1, z, nz)
qed

// ----------------------------------------------------------------------
//  Geometry: a slot's body (its start to its end) holding no group misses
//  the bytes the invariant keeps from clients -- the groups' headers, the
//  check bytes, the frames' headers

// (a group's slots: a unit at least)
theorem mp.stride_ge(A, M, b, g): A in mallocng.Abs -> g in omega -> mallocng.group_ok(A, M, b, g) -> int_le(16, mallocng.stride(A.metas[g]))
proof
  assume ha hg hok
  let V := A.metas[g]
  have vt: V in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A.metas, x := g], simp(ha), hg)
  have vm: V.maplen in omega by simp(vt)
  have vs: V.sizeclass in omega by simp(vt)
  have {sc = cls, big0 = big} := expand(hok, mallocng.group_ok)
  have big: V.sizeclass = 63 -> V.last_idx = 0 && int_lt(0, V.maplen) by taut(expand(big0, mallocng.big_ok))
  have c1: V.last_idx = 0 && int_lt(0, V.maplen) -> int_le(16, mallocng.stride(V)) proof
    assume h
    have e := mp(ite_t[c := V.last_idx = 0 && int_lt(0, V.maplen), a := int_sub(int_mul(V.maplen, 4096), mallocng.UNIT), b := int_mul(mallocng.UNIT, mallocng.size_classes[V.sizeclass])], h)
    have l0: int_lt(0, V.maplen) by taut(h)
    have m: int_le(16, int_sub(int_mul(V.maplen, 4096), mallocng.UNIT)) by defs(arith(vm, l0), mallocng.UNIT)
    show by defs(rewrite(sym(e), m), mallocng.stride)
  qed
  have c2: !(V.last_idx = 0 && int_lt(0, V.maplen)) -> int_le(16, mallocng.stride(V)) proof
    assume h
    have s48: int_lt(V.sizeclass, 48) by taut(sc, big, h)
    have sc0 := mp(all_elim(ms.sc_mono, {0}, {V.sizeclass}), simp(), vs, arith(vs), s48)
    have s0: mallocng.size_classes[0] = 1 by simp(ms.sc_vals)
    have e := mp(ite_f[c := V.last_idx = 0 && int_lt(0, V.maplen), a := int_sub(int_mul(V.maplen, 4096), mallocng.UNIT), b := int_mul(mallocng.UNIT, mallocng.size_classes[V.sizeclass])], h)
    have m: int_le(16, int_mul(mallocng.UNIT, mallocng.size_classes[V.sizeclass])) by defs(arith(sc0, s0), mallocng.UNIT)
    show by defs(rewrite(sym(e), m), mallocng.stride)
  qed
  show by taut(c1, c2)
qed

// a byte of h not deep in a nested slot: before its group's start or from
// the slot's end
def mp.nq(A, h, a) := all j. j in omega -> int_lt(j, seq_len(A.slots[h])) -> fst(A.slots[h][j]) = 2 ->
  !(int_le(A.metas[snd(A.slots[h][j])].mem, a) && int_lt(a, mallocng.slot_end(A.metas[h], j)))

// ... a byte in the span of slot j0 (its check byte to its end), before
// the group nested there
theorem mp.nest_q(A, M, b, h, j0, a): A in mallocng.Abs -> h in omega -> mallocng.group_ok(A, M, b, h) -> j0 in omega -> a in omega ->
  int_le(int_sub(mallocng.slot_start(A.metas[h], j0), 4), a) -> int_le(a, mallocng.slot_end(A.metas[h], j0)) ->
  (int_lt(j0, seq_len(A.slots[h])) -> fst(A.slots[h][j0]) = 2 -> !(int_le(A.metas[snd(A.slots[h][j0])].mem, a) && int_lt(a, mallocng.slot_end(A.metas[h], j0)))) ->
  mp.nq(A, h, a)
proof
  assume ha hh gok hj0 hao l1 l2 own
  let V := A.metas[h]
  let S := mallocng.stride(V)
  have {hm = mem, hst = stride, hss = start, hse = end} := apply(mp.geo, ha, hh, gok)
  have q: all j. j in omega -> int_lt(j, seq_len(A.slots[h])) -> fst(A.slots[h][j]) = 2 ->
      !(int_le(A.metas[snd(A.slots[h][j])].mem, a) && int_lt(a, mallocng.slot_end(V, j))) proof
    fix j
    assume hj hjl f2
    have {st = start} := apply(mp.nest_start[A := A, M := M, b := b, h := h, j := j], ha, hh, gok, hj, hjl, f2)
    // (an earlier slot: ends before slot j0's check byte)
    have lo: int_lt(j, j0) -> !(int_le(A.metas[snd(A.slots[h][j])].mem, a) && int_lt(a, mallocng.slot_end(V, j))) proof
      assume l w
      have _ w2 := w
      have ml := mp(all_elim(ms.mul_le, {S}, {int_add(j, 1)}, {S}, {j0}), hst, (int_add(j, 1) in omega by arith(hj)), arith(hst), arith(hj0), arith(hst), arith(l, hj, hj0))
      have d: int_mul(S, int_add(j, 1)) = int_add(int_mul(S, j), S) by simp(hst, hj)
      show by arith(ml, d, l1, w2, all_elim(hss, {j0}), all_elim(hse, {j}))
    qed
    // (a later one: its group starts past slot j0's end)
    have hi: int_lt(j0, j) -> !(int_le(A.metas[snd(A.slots[h][j])].mem, a) && int_lt(a, mallocng.slot_end(V, j))) proof
      assume l w
      have w1 _ := w
      have ml := mp(all_elim(ms.mul_le, {S}, {int_add(j0, 1)}, {S}, {j}), hst, (int_add(j0, 1) in omega by arith(hj0)), arith(hst), arith(hj), arith(hst), arith(l, hj, hj0))
      have d: int_mul(S, int_add(j0, 1)) = int_add(int_mul(S, j0), S) by simp(hst, hj0)
      show by arith(ml, d, l2, w1, st, all_elim(hss, {j}), all_elim(hse, {j0}))
    qed
    have eq: j = j0 -> !(int_le(A.metas[snd(A.slots[h][j])].mem, a) && int_lt(a, mallocng.slot_end(V, j))) proof
      assume e
      show := rewrite(sym(e), mp(own, rewrite(e, hjl), rewrite(e, f2)))
    qed
    show by taut(lo, hi, eq, (int_lt(j, j0) || j = j0 || int_lt(j0, j) by arith(hj, hj0)))
  qed
  show by defs(q, mp.nq)
qed

// a byte of h in the body of slot i of g (holding no group), h's own (not
// deep in a nested slot): g is h (else one group lies in a nested slot of
// the other -- h's nested slot holds a, or g's slot i the nested one's)
theorem mp.own_body(c, A, M, b, brk, g, i, h, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds(c, A, M, b, brk) ->
  mallocng.is_used(A, g) -> i in omega -> int_lt(i, seq_len(A.slots[g])) -> !(fst(A.slots[g][i]) = 2) ->
  mallocng.is_used(A, h) -> a in omega -> mp.gb(A, h, a) -> mp.nq(A, h, a) ->
  int_le(mallocng.slot_start(A.metas[g], i), a) -> int_lt(a, mallocng.slot_end(A.metas[g], i)) -> h = g
proof
  assume hc hu ha H hg hi hil ng hh hao gb q la lb
  have {huo = used} := expand(H, mallocng.holds)
  let W := A.metas[g]
  let V := A.metas[h]
  have {go = nat} := apply(mp.used_nat, ha, hg)
  have {gm2 = mem, gl2 = last, gs2 = stride, gss2 = start, gse2 = end, gns2 = nslots} := apply(mp.geo, ha, go, apply(mp.used_group, huo, hg))
  have {hm = mem} := apply(mp.used_nat, ha, hh)
  have ili: int_le(i, W.last_idx) by arith(gns2, hil, hi, gl2)
  have mi := mp(all_elim(ms.mul_le, {mallocng.stride(W)}, {i}, {mallocng.stride(W)}, {W.last_idx}), gs2, hi, simp(gs2), simp(gl2), arith(gs2), ili)
  have moi: int_mul(mallocng.stride(W), i) in omega by simp(gs2, hi)
  have ele: int_le(mallocng.slot_end(W, i), mallocng.slot_end(W, W.last_idx)) by arith(all_elim(gse2, {i}), all_elim(gse2, {W.last_idx}), mi)
  have gg: mp.gb(A, g, a) by defs(taut((int_le(W.mem, a) by arith(la, all_elim(gss2, {i}), moi)), (int_le(a, mallocng.slot_end(W, W.last_idx)) by arith(lb, ele))), mp.gb)
  have ini: int_lt(int_sub(int_add(int_add(W.mem, 16), int_mul(mallocng.stride(W), i)), 4), a) &&
      int_lt(a, int_sub(int_add(int_add(int_add(W.mem, 16), int_mul(mallocng.stride(W), i)), mallocng.stride(W)), 4))
    by arith(la, lb, all_elim(gss2, {i}), all_elim(gse2, {i}))
  have h1 h2 := expand(gb, mp.gb)
  // h first: g in a nested slot of h, past the group there -- deep in it
  have below: int_lt(V.mem, W.mem) -> h = g proof
    assume l
    obtain j2, a1 a2 a3 _ a5 a6 from expand(apply(mp.laminar, hc, hu, ha, H, hg, hh, l, hao, gg, gb), mp.inside)
    have w := mp(all_elim(expand(q, mp.nq), {j2}), a1, a2, a3)
    have f: false by taut(w, (int_le(A.metas[snd(A.slots[h][j2])].mem, a) by arith(a6, la, all_elim(gss2, {i}), moi)), (int_lt(a, mallocng.slot_end(V, j2)) by arith(lb, ele, a5)))
    show by taut(f)
  qed
  have eqm: V.mem = W.mem -> h = g proof
    assume e
    show := apply(mp.same_mem, H, hh, hg, e)
  qed
  // g first: h in a nested slot j2 of g, not i -- whose span misses slot
  // i's interior
  have above: int_lt(W.mem, V.mem) -> h = g proof
    assume l
    obtain j2, a1 _ a3 a4 a5 _ from expand(apply(mp.laminar, hc, hu, ha, H, hh, hg, l, hao, gb, gg), mp.inside)
    have ij: !(j2 = i) proof
      assume e
      show by taut(ng, rewrite(e, a3))
    qed
    have s := apply(mp.slot_sep[m := W.mem, S := mallocng.stride(W), i := j2, j := i, a := a], gm2, gs2, a1, hi, ij,
      (int_le(int_sub(int_add(int_add(W.mem, 16), int_mul(mallocng.stride(W), j2)), 4), a) by arith(a4, h1, all_elim(gss2, {j2}))),
      (int_le(a, int_sub(int_add(int_add(int_add(W.mem, 16), int_mul(mallocng.stride(W), j2)), mallocng.stride(W)), 4)) by arith(a5, h2, all_elim(gse2, {j2}))))
    have f: false by taut(s, ini)
    show by taut(f)
  qed
  show by taut(below, eqm, above, (int_lt(V.mem, W.mem) || V.mem = W.mem || int_lt(W.mem, V.mem) by arith(gm2, hm)))
qed

// a group's header: not in the body of slot i of g
theorem mp.ghdr_out(c, A, M, b, brk, g, i, h, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds(c, A, M, b, brk) ->
  mallocng.is_used(A, g) -> i in omega -> int_lt(i, seq_len(A.slots[g])) -> !(fst(A.slots[g][i]) = 2) ->
  mallocng.is_used(A, h) -> a in omega -> int_le(A.metas[h].mem, a) -> int_lt(a, int_add(A.metas[h].mem, 16)) ->
  !(int_le(mallocng.slot_start(A.metas[g], i), a) && int_lt(a, mallocng.slot_end(A.metas[g], i)))
proof
  assume hc hu ha H hg hi hil ng hh hao l1 l2 w
  have la lb := w
  have {huo = used} := expand(H, mallocng.holds)
  let V := A.metas[h]
  have {ho = nat} := apply(mp.used_nat, ha, hh)
  have gok := apply(mp.used_group, huo, hh)
  have {hm = mem, hl = last, hst = stride, hss = start, hse = end} := apply(mp.geo, ha, ho, gok)
  have s16 := apply(mp.stride_ge, ha, ho, gok)
  have ml: int_mul(mallocng.stride(V), V.last_idx) in omega by simp(hst, hl)
  have gb: mp.gb(A, h, a) by defs(taut(l1, (int_le(a, mallocng.slot_end(V, V.last_idx)) by arith(l2, all_elim(hse, {V.last_idx}), ml, s16))), mp.gb)
  have q: all j. j in omega -> int_lt(j, seq_len(A.slots[h])) -> fst(A.slots[h][j]) = 2 ->
      !(int_le(A.metas[snd(A.slots[h][j])].mem, a) && int_lt(a, mallocng.slot_end(V, j))) proof
    fix j
    assume hj hjl f2 w2
    have w1 _ := w2
    have {st = start} := apply(mp.nest_start[A := A, M := M, b := b, h := h, j := j], ha, ho, gok, hj, hjl, f2)
    have mj: int_mul(mallocng.stride(V), j) in omega by simp(hst, hj)
    show by arith(w1, st, all_elim(hss, {j}), mj, l2)
  qed
  have e := apply(mp.own_body, hc, hu, ha, H, hg, hi, hil, ng, hh, hao, gb, (mp.nq(A, h, a) by defs(q, mp.nq)), la, lb)
  // (g's own header: before its slots)
  have mi: int_mul(mallocng.stride(V), i) in omega by simp(hst, hi)
  show by arith(rewrite(sym(e), la), all_elim(hss, {i}), mi, l2)
qed

// a check byte (slot j's, or the last slot's end): not in the body of slot
// i of g
theorem mp.chk_out(c, A, M, b, brk, g, i, h, j): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds(c, A, M, b, brk) ->
  mallocng.is_used(A, g) -> i in omega -> int_lt(i, seq_len(A.slots[g])) -> !(fst(A.slots[g][i]) = 2) ->
  mallocng.is_used(A, h) -> j in omega -> int_le(j, int_add(A.metas[h].last_idx, 1)) ->
  !(int_le(mallocng.slot_start(A.metas[g], i), int_sub(mallocng.slot_start(A.metas[h], j), mallocng.IB)) &&
    int_lt(int_sub(mallocng.slot_start(A.metas[h], j), mallocng.IB), mallocng.slot_end(A.metas[g], i)))
proof
  assume hc hu ha H hg hi hil ng hh hj hjl w
  have la lb := w
  have {huo = used} := expand(H, mallocng.holds)
  let V := A.metas[h]
  let S := mallocng.stride(V)
  let a := int_sub(mallocng.slot_start(V, j), mallocng.IB)
  have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
  have {ho = nat} := apply(mp.used_nat, ha, hh)
  have gok := apply(mp.used_group, huo, hh)
  have {hm = mem, hl = last, hst = stride, hss = start, hse = end, hns = nslots} := apply(mp.geo, ha, ho, gok)
  have mj: int_mul(S, j) in omega by simp(hst, hj)
  have ao: a in omega by arith(all_elim(hss, {j}), ci, hm, mj)
  have d: int_mul(S, int_add(V.last_idx, 1)) = int_add(int_mul(S, V.last_idx), S) by simp(hst, hl)
  have ml := mp(all_elim(ms.mul_le, {S}, {j}, {S}, {int_add(V.last_idx, 1)}), hst, hj, arith(hst), arith(hl), arith(hst), hjl)
  have gb: mp.gb(A, h, a) by defs(taut((int_le(V.mem, a) by arith(all_elim(hss, {j}), ci, mj)),
    (int_le(a, mallocng.slot_end(V, V.last_idx)) by arith(all_elim(hss, {j}), ci, all_elim(hse, {V.last_idx}), ml, d))), mp.gb)
  // (slot j's own check byte: before its group; the end: the last slot's)
  have q1: int_le(j, V.last_idx) -> mp.nq(A, h, a) proof
    assume l
    have own: int_lt(j, seq_len(A.slots[h])) -> fst(A.slots[h][j]) = 2 -> !(int_le(A.metas[snd(A.slots[h][j])].mem, a) && int_lt(a, mallocng.slot_end(V, j))) proof
      assume hjl2 f2 w2
      have w1 _ := w2
      have {st = start} := apply(mp.nest_start[A := A, M := M, b := b, h := h, j := j], ha, ho, gok, hj, hjl2, f2)
      show by arith(w1, st, ci)
    qed
    show := apply(mp.nest_q[A := A, M := M, b := b, h := h, j0 := j, a := a], ha, ho, gok, hj, ao, arith(ci), arith(all_elim(hss, {j}), all_elim(hse, {j}), ci, hst), own)
  qed
  have q2: j = int_add(V.last_idx, 1) -> mp.nq(A, h, a) proof
    assume e
    have mje: int_mul(S, j) = int_add(int_mul(S, V.last_idx), S) := rewrite(sym(e), d)
    have ae: a = mallocng.slot_end(V, V.last_idx) by arith(mje, all_elim(hss, {j}), all_elim(hse, {V.last_idx}), ci)
    have own: int_lt(V.last_idx, seq_len(A.slots[h])) -> fst(A.slots[h][V.last_idx]) = 2 ->
        !(int_le(A.metas[snd(A.slots[h][V.last_idx])].mem, a) && int_lt(a, mallocng.slot_end(V, V.last_idx))) proof
      assume _ _ w2
      have _ w3 := w2
      show by arith(w3, ae)
    qed
    show := apply(mp.nest_q[A := A, M := M, b := b, h := h, j0 := V.last_idx, a := a], ha, ho, gok, hl, ao,
      arith(ae, all_elim(hss, {V.last_idx}), all_elim(hse, {V.last_idx}), hst), arith(ae), own)
  qed
  have q := (mp.nq(A, h, a) by taut(q1, q2, (int_le(j, V.last_idx) || j = int_add(V.last_idx, 1) by arith(hjl, hj, hl))))
  have e := apply(mp.own_body, hc, hu, ha, H, hg, hi, hil, ng, hh, ao, gb, q, la, lb)
  // (in g: before slot i or past its end)
  have la2 := rewrite(sym(e), la)
  have lb2 := rewrite(sym(e), lb)
  have c1: int_le(j, i) -> false proof
    assume l
    have m2 := mp(all_elim(ms.mul_le, {S}, {j}, {S}, {i}), hst, hj, arith(hst), arith(hi), arith(hst), l)
    show by arith(la2, all_elim(hss, {i}), all_elim(hss, {j}), ci, m2)
  qed
  have c2: int_lt(i, j) -> false proof
    assume l
    have m2 := mp(all_elim(ms.mul_le, {S}, {int_add(i, 1)}, {S}, {j}), hst, (int_add(i, 1) in omega by arith(hi)), arith(hst), arith(hj), arith(hst), arith(l, hi, hj))
    have d2: int_mul(S, int_add(i, 1)) = int_add(int_mul(S, i), S) by simp(hst, hi)
    show by arith(lb2, all_elim(hss, {j}), all_elim(hse, {i}), ci, m2, d2)
  qed
  show by taut(c1, c2, (int_le(j, i) || int_lt(i, j) by arith(hi, hj)))
qed

// a frame's header (the in-band header before what starts at q in slot j
// of h -- a block, or the group nested there --, not slot i of g): not in
// the body of slot i of g
theorem mp.frm_out(c, A, M, b, brk, g, i, h, j, q, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds(c, A, M, b, brk) ->
  mallocng.is_used(A, g) -> i in omega -> int_lt(i, seq_len(A.slots[g])) -> !(fst(A.slots[g][i]) = 2) ->
  mallocng.is_used(A, h) -> j in omega -> int_lt(j, seq_len(A.slots[h])) -> !(h = g && j = i) ->
  q in omega -> int_le(mallocng.slot_start(A.metas[h], j), q) -> int_le(q, mallocng.slot_end(A.metas[h], j)) ->
  (fst(A.slots[h][j]) = 2 -> A.metas[snd(A.slots[h][j])].mem = q) ->
  a in omega -> int_le(int_sub(q, mallocng.IB), a) -> int_lt(a, q) ->
  !(int_le(mallocng.slot_start(A.metas[g], i), a) && int_lt(a, mallocng.slot_end(A.metas[g], i)))
proof
  assume hc hu ha H hg hi hil ng hh hj hjl ne hq q1 q2 nq hao l1 l2 w
  have la lb := w
  have {huo = used} := expand(H, mallocng.holds)
  let V := A.metas[h]
  let S := mallocng.stride(V)
  have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
  have {ho = nat} := apply(mp.used_nat, ha, hh)
  have gok := apply(mp.used_group, huo, hh)
  have {hm = mem, hl = last, hst = stride, hss = start, hse = end, hns = nslots} := apply(mp.geo, ha, ho, gok)
  have mj: int_mul(S, j) in omega by simp(hst, hj)
  have jl: int_le(j, V.last_idx) by arith(hns, hjl, hj, hl)
  have ml := mp(all_elim(ms.mul_le, {S}, {j}, {S}, {V.last_idx}), hst, hj, arith(hst), arith(hl), arith(hst), jl)
  have gb: mp.gb(A, h, a) by defs(taut((int_le(V.mem, a) by arith(l1, q1, all_elim(hss, {j}), ci, mj)),
    (int_le(a, mallocng.slot_end(V, V.last_idx)) by arith(l2, q2, all_elim(hse, {j}), all_elim(hse, {V.last_idx}), ml))), mp.gb)
  have own: int_lt(j, seq_len(A.slots[h])) -> fst(A.slots[h][j]) = 2 -> !(int_le(A.metas[snd(A.slots[h][j])].mem, a) && int_lt(a, mallocng.slot_end(V, j))) proof
    assume _ f2 w2
    have w1 _ := w2
    show by arith(w1, mp(nq, f2), l2)
  qed
  have qq := apply(mp.nest_q[A := A, M := M, b := b, h := h, j0 := j, a := a], ha, ho, gok, hj, hao, arith(l1, q1, ci), arith(l2, q2), own)
  have e := apply(mp.own_body, hc, hu, ha, H, hg, hi, hil, ng, hh, hao, gb, qq, la, lb)
  have ji: !(j = i) by taut(ne, e)
  // (another slot of g: before slot i or past its end)
  have la2 := rewrite(sym(e), la)
  have lb2 := rewrite(sym(e), lb)
  have c1: int_lt(j, i) -> false proof
    assume l
    have m2 := mp(all_elim(ms.mul_le, {S}, {int_add(j, 1)}, {S}, {i}), hst, (int_add(j, 1) in omega by arith(hj)), arith(hst), arith(hi), arith(hst), arith(l, hi, hj))
    have d2: int_mul(S, int_add(j, 1)) = int_add(int_mul(S, j), S) by simp(hst, hj)
    show by arith(la2, l2, q2, all_elim(hss, {i}), all_elim(hse, {j}), m2, d2)
  qed
  have c2: int_lt(i, j) -> false proof
    assume l
    have m2 := mp(all_elim(ms.mul_le, {S}, {int_add(i, 1)}, {S}, {j}), hst, (int_add(i, 1) in omega by arith(hi)), arith(hst), arith(hj), arith(hst), arith(l, hi, hj))
    have d2: int_mul(S, int_add(i, 1)) = int_add(int_mul(S, i), S) by simp(hst, hi)
    show by arith(lb2, l1, q1, all_elim(hss, {j}), all_elim(hse, {i}), ci, m2, d2)
  qed
  show by taut(c1, c2, ji, (int_lt(j, i) || j = i || int_lt(i, j) by arith(hi, hj)))
qed

// ----------------------------------------------------------------------
//  The new block

// (an option's value)
theorem mp.opt_nat(o): o in option(omega) -> !(o = none) -> o = some(snd(o)) && snd(o) in omega
proof
  assume ho hn
  have u := union2_iff[a := single(none), b := set_image(omega, x. some(x)), z := o]
  have c: o in single(none) || o in set_image(omega, x. some(x)) by taut(u, expand(ho, option))
  have c1: !(o in single(none)) proof
    assume w
    show by taut(hn, apply(single_elim, w))
  qed
  have im := set_image_def[s := omega, f := x. some(x), y := o]
  have ex := (ex x. x in omega && some(x) = o by taut(im, c, c1))
  obtain x, hx he from ex
  have sx: snd(o) = x := rewrite(he, (snd(some(x)) = x by defs(simp(), some, tag)))
  show by taut(rewrite(sym(sx), sym(he)), rewrite(sym(sx), hx))
qed

// (the blocks with p set)
theorem mp.sb_app(b, p, w, q): q in bits(64) -> malloc.set_block(b, p, w)[q] = ite(q = p, w, b[q])
proof
  assume hq
  have e := mp(app_fn_build[d := bits(64), v := x. ite(x = p, w, b[x]), a := q], hq)
  show by defs(e, malloc.set_block)
qed

// (a byte of a block's range)
theorem mp.rng_def(q, m, a): a in malloc.range(q, m) <-> a in omega && (int_le(q, a) && int_lt(a, int_add(q, m)))
proof
  show by defs(set_select_def[s := omega, p := y. int_le(q, y) && int_lt(y, int_add(q, m)), z := a], malloc.range)
qed

// (a live byte: of a block)
theorem mp.live_def(b, a): a in malloc.live_of(b) <-> a in omega && (ex q. q in bits(64) && (!(b[q] = none) && a in malloc.range(q, snd(b[q]))))
proof
  show by defs(set_select_def[s := omega, p := y. ex q. q in bits(64) && (!(b[q] = none) && y in malloc.range(q, snd(b[q]))), z := a], malloc.live_of)
qed

// a block made at p (none there): the live bytes those of the others and
// its own
theorem mp.live_new(b, p, n, a): p in bits(64) -> b[p] = none ->
  (a in malloc.live_of(malloc.set_block(b, p, some(n))) <-> a in malloc.live_of(b) || (a in omega && int_le(p, a) && int_lt(a, int_add(p, n))))
proof
  assume hp hn
  let B2 := malloc.set_block(b, p, some(n))
  have l1 := apply(mp.live_def[b := b, a := a])
  have l2 := apply(mp.live_def[b := B2, a := a])
  have e2: B2[p] = some(n) by simp(apply(mp.sb_app[b := b, p := p, w := some(n), q := p], hp))
  have nn: !(some(n) = none) by defs(simp(), some, none, tag)
  have sn: snd(some(n)) = n by defs(simp(), some, tag)
  have sb: snd(B2[p]) = n := rewrite(sym(e2), sn)
  have rp := apply(mp.rng_def[q := p, m := n, a := a])
  have fw: a in malloc.live_of(B2) -> a in malloc.live_of(b) || (a in omega && int_le(p, a) && int_lt(a, int_add(p, n))) proof
    assume h
    have ao ex := (a in omega && (ex q. q in bits(64) && (!(B2[q] = none) && a in malloc.range(q, snd(B2[q])))) by taut(l2, h))
    obtain q, hq hn2 hr from ex
    have c1: q = p -> a in omega && int_le(p, a) && int_lt(a, int_add(p, n)) proof
      assume e
      have r2: a in malloc.range(p, n) := rewrite(sb, rewrite(e, hr))
      show by taut(rp, r2)
    qed
    have c2: !(q = p) -> a in malloc.live_of(b) proof
      assume ne
      have eq: B2[q] = b[q] by simp(apply(mp.sb_app[b := b, p := p, w := some(n), q := q], hq), ne)
      have w: ex q. q in bits(64) && (!(b[q] = none) && a in malloc.range(q, snd(b[q]))) by ex_intro({q}, taut(hq, rewrite(eq, hn2), rewrite(eq, hr)))
      show by taut(l1, ao, w)
    qed
    show by taut(c1, c2)
  qed
  have bw: a in malloc.live_of(b) || (a in omega && int_le(p, a) && int_lt(a, int_add(p, n))) -> a in malloc.live_of(B2) proof
    assume h
    have c1: a in malloc.live_of(b) -> a in malloc.live_of(B2) proof
      assume h1
      have ao ex := (a in omega && (ex q. q in bits(64) && (!(b[q] = none) && a in malloc.range(q, snd(b[q])))) by taut(l1, h1))
      obtain q, hq hn1 hr from ex
      have ne: !(q = p) proof
        assume e
        show by taut(hn1, rewrite(sym(e), hn))
      qed
      have eq: B2[q] = b[q] by simp(apply(mp.sb_app[b := b, p := p, w := some(n), q := q], hq), ne)
      have w: ex q. q in bits(64) && (!(B2[q] = none) && a in malloc.range(q, snd(B2[q]))) by ex_intro({q}, taut(hq, rewrite(sym(eq), hn1), rewrite(sym(eq), hr)))
      show by taut(l2, ao, w)
    qed
    have c2: a in omega && int_le(p, a) && int_lt(a, int_add(p, n)) -> a in malloc.live_of(B2) proof
      assume h2
      have ao _ _ := h2
      have r0: a in malloc.range(p, n) by taut(rp, h2)
      have r: a in malloc.range(p, snd(B2[p])) := rewrite(sym(sb), r0)
      have bn: !(B2[p] = none) := rewrite(sym(e2), nn)
      have w: ex q. q in bits(64) && (!(B2[q] = none) && a in malloc.range(q, snd(B2[q]))) by ex_intro({p}, taut(hp, bn, r))
      show by taut(l2, ao, w)
    qed
    show by taut(h, c1, c2)
  qed
  show by taut(fw, bw)
qed

// (a block's place: a byte at least, its usable bytes)
theorem mp.ext_ge(n): n in omega -> int_le(1, malloc.extent(n)) && int_le(n, malloc.extent(n))
proof
  assume hn
  have c1: n = 0 -> int_le(1, malloc.extent(n)) && int_le(n, malloc.extent(n)) proof
    assume e
    have x1: malloc.extent(n) = 1 by defs(simp(e), malloc.extent)
    show by arith(x1, e)
  qed
  have c2: !(n = 0) -> int_le(1, malloc.extent(n)) && int_le(n, malloc.extent(n)) proof
    assume e
    have xn: malloc.extent(n) = n by defs(simp(e), malloc.extent)
    show by arith(xn, e, hn)
  qed
  show by taut(c1, c2)
qed

// a reserved slot's body: no block starts there (a block lies in its own
// slot's body; slots holding no group apart)
theorem mp.res_free(c, A, M, b, brk, g, i, p): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  mallocng.holds(c, A, M, b, brk) -> mallocng.is_used(A, g) -> i in omega -> int_lt(i, seq_len(A.slots[g])) -> A.slots[g][i] = tag(3, empty) ->
  p in bits(64) -> int_le(mallocng.slot_start(A.metas[g], i), p) -> int_lt(p, mallocng.slot_end(A.metas[g], i)) -> b[p] = none
proof
  assume hc hu ha hb H hg hi hil hr hp l1 l2
  have {huo = used, hbl = in_slots} := expand(H, mallocng.holds)
  have po: p in omega by arith(hp)
  have pb: bits_of_int(64, p) = p := mp(bits_of_int_small[n := 64, a := p], po, (int_lt(p, pow2(64)) by arith(hp)))
  have nb: !(b[p] = none) -> false proof
    assume hn
    obtain k j, hk hj hkl hjl hs from mp(all_elim(expand(hbl, mallocng.blocks_ok), {p}), hp, hn)
    let h := A.used[k]
    let V := A.metas[h]
    have iu: mallocng.is_used(A, h) by defs(ex_intro({k}, taut(hk, hkl, refl({h}))), mallocng.is_used)
    have {ho = nat} := apply(mp.used_nat, ha, iu)
    have gok := apply(mp.used_group, huo, iu)
    have {gso = slots} := expand(gok, mallocng.group_ok)
    have so := mp(all_elim(gso, {j}), hj, hjl)
    have s3: !(b[bits_of_int(64, p)] = none) && mallocng.hdr_free(b, p) && mallocng.frame_ok(M, V, j, p, snd(b[bits_of_int(64, p)]), 0)
      by simp(expand(rewrite(hs, so), mallocng.slot_ok))
    have fo: mallocng.frame_ok(M, V, j, p, snd(b[p]), 0) := rewrite(pb, (mallocng.frame_ok(M, V, j, p, snd(b[bits_of_int(64, p)]), 0) by taut(s3)))
    have bo := mp(fn_space_app[a := bits(64), b := option(omega), f := b, x := p], hb, hp)
    have _ nno := apply(mp.opt_nat, bo, hn)
    have vt: V in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := A.metas, x := h], simp(ha), ho)
    have fs fe := apply(mp.frame_ext, vt, hj, po, nno, fo)
    have x1 _ := apply(mp.ext_ge, nno)
    have f1: fst(A.slots[h][j]) = 1 by defs(simp(hs), tag)
    have f3: fst(A.slots[g][i]) = 3 by defs(simp(hr), tag)
    have ne: !(g = h && i = j) proof
      assume w
      have e1 e2 := w
      show by arith(rewrite(sym(e2), rewrite(sym(e1), f1)), f3)
    qed
    have na := apply(mp.slot_apart[c := c, A := A, M := M, b := b, brk := brk, g := g, i := i, h := h, j := j, a := p], hc, hu, ha, H, hg, hi, hil,
      (!(fst(A.slots[g][i]) = 2) by arith(f3)), iu, hj, hjl, (!(fst(A.slots[h][j]) = 2) by arith(f1)), ne, po, arith(fs), arith(fe, x1))
    have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
    show by taut(na, (mallocng.in_slot(A.metas[g], i, p) by defs(arith(l1, l2, ci), mallocng.in_slot)))
  qed
  show by taut(nb)
qed

// ----------------------------------------------------------------------
//  The groups with the new block: as before

// a slot, the blocks b2 keeping b's: as before, its frame's header no
// client's still
theorem mp.slot_nb(A, M, b, b2, h, j, u): u in mallocng.Use -> mallocng.slot_ok(A, M, b, h, j, u) ->
  (all q. q in bits(64) -> !(b[q] = none) -> b2[q] = b[q]) ->
  (fst(u) = 1 -> mallocng.hdr_free(b2, snd(u))) -> (fst(u) = 2 -> mallocng.hdr_free(b2, A.metas[snd(u)].mem)) ->
  mallocng.slot_ok(A, M, b2, h, j, u)
proof
  assume ut so hb f1 f2
  have c0: u = tag(0, empty) -> mallocng.slot_ok(A, M, b2, h, j, u) proof
    assume e
    show by defs(simp(e), mallocng.slot_ok)
  qed
  have c1: !(u = tag(0, empty)) -> fst(u) = 1 -> mallocng.slot_ok(A, M, b2, h, j, u) proof
    assume e0 e1
    let P := snd(u)
    have ue: u = tag(1, P) by simp(apply(mp.use_eta, ut), e1)
    have s0: !(b[bits_of_int(64, P)] = none) && mallocng.hdr_free(b, P) && mallocng.frame_ok(M, A.metas[h], j, P, snd(b[bits_of_int(64, P)]), 0)
      by simp(expand(rewrite(ue, so), mallocng.slot_ok))
    have bn _ fo := s0
    have eq := mp(all_elim(hb, {bits_of_int(64, P)}), (bits_of_int(64, P) in bits(64) by simp()), bn)
    show by defs(simp(e0, e1, eq, bn, mp(f1, e1), fo), mallocng.slot_ok)
  qed
  have c2: !(u = tag(0, empty)) -> fst(u) = 2 -> mallocng.slot_ok(A, M, b2, h, j, u) proof
    assume e0 e2
    have s0: ((mallocng.is_used(A, snd(u)) && A.metas[snd(u)].maplen = 0) && mallocng.hdr_free(b, A.metas[snd(u)].mem)) &&
        mallocng.frame_ok(M, A.metas[h], j, A.metas[snd(u)].mem, int_sub(int_add(mallocng.UNIT, int_mul(mallocng.stride(A.metas[snd(u)]), int_add(A.metas[snd(u)].last_idx, 1))), mallocng.IB), 6)
      by simp(expand(rewrite((u = tag(2, snd(u)) by simp(apply(mp.use_eta, ut), e2)), so), mallocng.slot_ok))
    have iw mz _ fo := s0
    show by defs(simp(e0, e2, iw, mz, mp(f2, e2), fo), mallocng.slot_ok)
  qed
  have c3: !(u = tag(0, empty)) -> !(fst(u) = 1) -> !(fst(u) = 2) -> mallocng.slot_ok(A, M, b2, h, j, u) proof
    assume e0 e1 e2
    show by defs(simp(e0, e1, e2), mallocng.slot_ok)
  qed
  show by taut(c0, c1, c2, c3)
qed

// a group, the blocks b2 keeping b's: as before, its header, check bytes
// and frames' headers no client's still
theorem mp.grp_nb(A, M, b, b2, h): A in mallocng.Abs -> h in omega -> mallocng.group_ok(A, M, b, h) ->
  (all q. q in bits(64) -> !(b[q] = none) -> b2[q] = b[q]) ->
  (all a. a in omega -> int_le(A.metas[h].mem, a) && int_lt(a, int_add(A.metas[h].mem, mallocng.UNIT)) -> !(a in malloc.live_of(b2))) ->
  (all j. j in omega -> int_le(j, int_add(A.metas[h].last_idx, 1)) -> !(int_sub(mallocng.slot_start(A.metas[h], j), mallocng.IB) in malloc.live_of(b2))) ->
  (all j. j in omega -> int_lt(j, seq_len(A.slots[h])) -> fst(A.slots[h][j]) = 1 -> mallocng.hdr_free(b2, snd(A.slots[h][j]))) ->
  (all j. j in omega -> int_lt(j, seq_len(A.slots[h])) -> fst(A.slots[h][j]) = 2 -> mallocng.hdr_free(b2, A.metas[snd(A.slots[h][j])].mem)) ->
  mallocng.group_ok(A, M, b2, h)
proof
  assume ha hh gok hb hown hchk hf1 hf2
  have {mim, cls, hdr, act, nslots, masks, small, mapped, nested, big, linked, unlinked, slots, sentinel, offs, span} := expand(gok, mallocng.group_ok)
  have slt: A.slots[h] in list_type(mallocng.Use) := mp(fn_space_app[a := omega, b := list_type(mallocng.Use), f := A.slots, x := h], simp(ha), hh)
  have sl2: all x0. x0 in omega -> int_lt(x0, seq_len(A.slots[h])) -> mallocng.slot_ok(A, M, b2, h, x0, A.slots[h][x0]) proof
    fix j
    assume hj hjl
    have ut := apply(at_type[l := A.slots[h], t := mallocng.Use, i := j], slt, hj, hjl)
    have g1: fst(A.slots[h][j]) = 1 -> mallocng.hdr_free(b2, snd(A.slots[h][j])) := mp(all_elim(hf1, {j}), hj, hjl)
    have g2: fst(A.slots[h][j]) = 2 -> mallocng.hdr_free(b2, A.metas[snd(A.slots[h][j])].mem) := mp(all_elim(hf2, {j}), hj, hjl)
    show := apply(mp.slot_nb[A := A, M := M, b := b, b2 := b2, h := h, j := j, u := A.slots[h][j]], ut, mp(all_elim(slots, {j}), hj, hjl), hb, g1, g2)
  qed
  show by defs(taut(mim, cls, hdr, hown, act, nslots, masks, small, mapped, nested, big, linked, unlinked, sl2, sentinel, hchk, offs, span), mallocng.group_ok)
qed

// the blocks with one made in the body of slot i of g (reserved): each
// group as before -- the block misses its header, check bytes and frames'
// headers
theorem mp.grp_blk(c, A, M, b, brk, g, i, p, n, h): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  mallocng.holds(c, A, M, b, brk) -> mallocng.is_used(A, g) -> i in omega -> int_lt(i, seq_len(A.slots[g])) -> A.slots[g][i] = tag(3, empty) ->
  p in bits(64) -> n in omega -> int_le(mallocng.slot_start(A.metas[g], i), p) -> int_le(int_add(p, n), mallocng.slot_end(A.metas[g], i)) -> b[p] = none ->
  mallocng.is_used(A, h) -> mallocng.group_ok(A, M, malloc.set_block(b, p, some(n)), h)
proof
  assume hc hu ha hb H hg hi hil hr hp hn l1 l2 hpn hh
  let B2 := malloc.set_block(b, p, some(n))
  let V := A.metas[h]
  have {huo = used} := expand(H, mallocng.holds)
  have {ho = nat} := apply(mp.used_nat, ha, hh)
  have gok := apply(mp.used_group, huo, hh)
  have {own = hdr_own, chk = chk_own, gsl = slots} := expand(gok, mallocng.group_ok)
  have f3: fst(A.slots[g][i]) = 3 by defs(simp(hr), tag)
  have ng: !(fst(A.slots[g][i]) = 2) by arith(f3)
  have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
  have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
  // (the old blocks kept)
  have hb2: all q. q in bits(64) -> !(b[q] = none) -> B2[q] = b[q] proof
    fix q
    assume hq hnq
    have ne: !(q = p) proof
      assume e
      show by taut(hnq, rewrite(sym(e), hpn))
    qed
    show by simp(apply(mp.sb_app[b := b, p := p, w := some(n), q := q], hq), ne)
  qed
  // (a byte no client's, out of the slot's body: no client's still)
  have nb: all a. !(a in malloc.live_of(b)) -> !(int_le(mallocng.slot_start(A.metas[g], i), a) && int_lt(a, mallocng.slot_end(A.metas[g], i))) ->
      !(a in malloc.live_of(B2)) proof
    fix a
    assume n1 n2 w
    have l := apply(mp.live_new[b := b, p := p, n := n, a := a], hp, hpn)
    have _ w1 w2 := (a in omega && int_le(p, a) && int_lt(a, int_add(p, n)) by taut(l, w, n1))
    show by taut(n2, (int_le(mallocng.slot_start(A.metas[g], i), a) && int_lt(a, mallocng.slot_end(A.metas[g], i)) by arith(l1, l2, w1, w2)))
  qed
  have hown: all a. a in omega -> int_le(V.mem, a) && int_lt(a, int_add(V.mem, mallocng.UNIT)) -> !(a in malloc.live_of(B2)) proof
    fix a
    assume hao w
    have w1 w2 := w
    have o := apply(mp.ghdr_out[c := c, A := A, M := M, b := b, brk := brk, g := g, i := i, h := h, a := a], hc, hu, ha, H, hg, hi, hil, ng, hh, hao, w1, arith(w2, cu))
    show := mp(all_elim(nb, {a}), mp(all_elim(own, {a}), hao, w), o)
  qed
  have hchk: all j. j in omega -> int_le(j, int_add(V.last_idx, 1)) -> !(int_sub(mallocng.slot_start(V, j), mallocng.IB) in malloc.live_of(B2)) proof
    fix j
    assume hj hjl
    have o := apply(mp.chk_out[c := c, A := A, M := M, b := b, brk := brk, g := g, i := i, h := h, j := j], hc, hu, ha, H, hg, hi, hil, ng, hh, hj, hjl)
    show := mp(all_elim(nb, {int_sub(mallocng.slot_start(V, j), mallocng.IB)}), mp(all_elim(chk, {j}), hj, hjl), o)
  qed
  have slt: A.slots[h] in list_type(mallocng.Use) := mp(fn_space_app[a := omega, b := list_type(mallocng.Use), f := A.slots, x := h], simp(ha), ho)
  // (slot j of h not slot i of g: their uses differ)
  have nij: all j. fst(A.slots[h][j]) = 1 || fst(A.slots[h][j]) = 2 -> !(h = g && j = i) proof
    fix j
    assume f w
    have e1 e2 := w
    show by taut(rewrite(e2, rewrite(e1, f)), ng, (!(fst(A.slots[g][i]) = 1) by arith(f3)))
  qed
  // a block's frame header
  have hf1: all j. j in omega -> int_lt(j, seq_len(A.slots[h])) -> fst(A.slots[h][j]) = 1 -> mallocng.hdr_free(B2, snd(A.slots[h][j])) proof
    fix j
    assume hj hjl e1
    let u := A.slots[h][j]
    let Q := snd(u)
    have ut := apply(at_type[l := A.slots[h], t := mallocng.Use, i := j], slt, hj, hjl)
    have qo := apply(mp.use_nat, ut, arith(e1), arith(e1))
    have ue: u = tag(1, Q) by simp(apply(mp.use_eta, ut), e1)
    have so := mp(all_elim(gsl, {j}), hj, hjl)
    have s0: !(b[bits_of_int(64, Q)] = none) && mallocng.hdr_free(b, Q) && mallocng.frame_ok(M, V, j, Q, snd(b[bits_of_int(64, Q)]), 0)
      by simp(expand(rewrite(ue, so), mallocng.slot_ok))
    have bn hfr fo := s0
    have bo := mp(fn_space_app[a := bits(64), b := option(omega), f := b, x := bits_of_int(64, Q)], hb, (bits_of_int(64, Q) in bits(64) by simp()))
    have _ nno := apply(mp.opt_nat, bo, bn)
    have {fs = start, ff = fits} := expand(fo, mallocng.frame_ok)
    have vq: fst(u) = 2 -> A.metas[Q].mem = Q proof
      assume e
      have f: false by arith(e, e1)
      show by taut(f)
    qed
    have r: all a. a in omega -> int_le(int_sub(Q, mallocng.IB), a) && int_lt(a, Q) -> !(a in malloc.live_of(B2)) proof
      fix a
      assume hao w
      have w1 w2 := w
      have o := apply(mp.frm_out[c := c, A := A, M := M, b := b, brk := brk, g := g, i := i, h := h, j := j, q := Q, a := a], hc, hu, ha, H, hg, hi, hil, ng, hh,
        hj, hjl, mp(all_elim(nij, {j}), taut(e1)), qo, fs, arith(ff, nno), vq, hao, w1, w2)
      show := mp(all_elim(nb, {a}), mp(all_elim(expand(hfr, mallocng.hdr_free), {a}), hao, w), o)
    qed
    show by defs(r, mallocng.hdr_free)
  qed
  // a nested group's frame header
  have hf2: all j. j in omega -> int_lt(j, seq_len(A.slots[h])) -> fst(A.slots[h][j]) = 2 -> mallocng.hdr_free(B2, A.metas[snd(A.slots[h][j])].mem) proof
    fix j
    assume hj hjl e2
    let u := A.slots[h][j]
    let Q := A.metas[snd(u)].mem
    have ut := apply(at_type[l := A.slots[h], t := mallocng.Use, i := j], slt, hj, hjl)
    have so := mp(all_elim(gsl, {j}), hj, hjl)
    have s0: ((mallocng.is_used(A, snd(u)) && A.metas[snd(u)].maplen = 0) && mallocng.hdr_free(b, Q)) &&
        mallocng.frame_ok(M, V, j, Q, int_sub(int_add(mallocng.UNIT, int_mul(mallocng.stride(A.metas[snd(u)]), int_add(A.metas[snd(u)].last_idx, 1))), mallocng.IB), 6)
      by simp(expand(rewrite((u = tag(2, snd(u)) by simp(apply(mp.use_eta, ut), e2)), so), mallocng.slot_ok))
    have iw _ hfr _ := s0
    have {wo = nat, wm = mem} := apply(mp.used_nat, ha, iw)
    have wn := apply(mp.stride_nat, ha, wo, apply(mp.used_group, huo, iw))
    have {wl = last} := apply(mp.geo, ha, wo, apply(mp.used_group, huo, iw))
    have {fs = start, ff = fits} := apply(mp.nest_start[A := A, M := M, b := b, h := h, j := j], ha, ho, gok, hj, hjl, e2)
    have mo: int_mul(mallocng.stride(A.metas[snd(u)]), int_add(A.metas[snd(u)].last_idx, 1)) in omega by simp(wn, wl)
    have vq: fst(u) = 2 -> Q = Q proof
      assume _
      show := refl({Q})
    qed
    have r: all a. a in omega -> int_le(int_sub(Q, mallocng.IB), a) && int_lt(a, Q) -> !(a in malloc.live_of(B2)) proof
      fix a
      assume hao w
      have w1 w2 := w
      have o := apply(mp.frm_out[c := c, A := A, M := M, b := b, brk := brk, g := g, i := i, h := h, j := j, q := Q, a := a], hc, hu, ha, H, hg, hi, hil, ng, hh,
        hj, hjl, mp(all_elim(nij, {j}), taut(e2)), wm, fs, arith(ff, mo, cu, ci), vq, hao, w1, w2)
      show := mp(all_elim(nb, {a}), mp(all_elim(expand(hfr, mallocng.hdr_free), {a}), hao, w), o)
    qed
    show by defs(r, mallocng.hdr_free)
  qed
  show := apply(mp.grp_nb[A := A, M := M, b := b, b2 := B2, h := h], ha, ho, gok, hb2, hown, hchk, hf1, hf2)
qed
