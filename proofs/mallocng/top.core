// The top level: mallocng's malloc and free by the malloc layer's specs
// (layers/malloc.sl), from their purpose specs (layers/mallocng_specs.sl).
// The malloc layer's state (the world, the live blocks) is the purpose
// specs' without the abstract state A: a state of the layer's invariant
// (`mallocng.inv`) has some A it represents (`mallocng.rep`), and that A
// meets the purpose specs' precondition.

// ----------------------------------------------------------------------
//  At a call: the layer's precondition and rep give the purpose spec's

// errno's i-th byte: one of the layer's errno bytes (errno at the thread
// pointer's 0x34)
theorem mp.top_ebyte(eo, S, i): S.fs_base in bits(64) -> int_le(int_add(S.fs_base, 56), int_pow(2, 64)) -> app(eo, empty) = 52 ->
  i in omega -> int_lt(i, 4) -> int_add(int_add(S.fs_base, 52), i) in malloc.errno_bytes(eo, S)
proof
  assume fsb fsl he hi hil
  show by defs(sel(defs(arith(fsb, fsl, hi, hil, he), bits_add, bits_of_int, pow2)), malloc.errno_bytes, malloc.range)
qed

theorem mp.top_pre(c, A, S, eo, b, cd, st): S.fs_base in bits(64) -> mallocng.rep(c, A, S) -> app(eo, empty) = 52 ->
  malloc.errno_ok(eo, S) -> malloc.world_ok(b, cd, st, S) ->
  hin: mallocng.holds_in(c, A, S.vm, S.objs, S.blocks) && thread: abi.thread_ok(S.vm, S.fs_base) && tls: mallocng_specs.tls_apart(c, A, S.fs_base) &&
  brk: abi.brk_start_ok(S.vm) && errno: mallocng_specs.errno_ok(S.vm, S.objs, S.fs_base) && apart: mallocng_specs.errno_apart(c, A, S.vm, S.fs_base)
proof
  assume fsb hr he heo hw
  have {hm = mem, rtl = tls, rer = errno, rca = canary} := expand(hr, mallocng.rep)
  have nst cb th _ bk _ := expand(hw, malloc.world_ok)
  // (the thread pointer below the task's end: errno's bytes too)
  have kp: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
  have ts: int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE) = 34359738367 by defs(simp(), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
  have r0 _ _ _ := expand(th, abi.thread_ok)
  have m0 _ := mp(all_elim(expand(r0, x86_64_linux.readable), {0}), simp(), simp())
  have t0 _ := expand(m0, x86_64_linux.mapped)
  have fsl: int_le(int_add(S.fs_base, 56), int_pow(2, 64)) by arith(t0, ts, kp, fsb)
  have ea: mallocng_specs.errno_at(S.fs_base) = int_add(S.fs_base, 52) by defs(arith(fsb, fsl), mallocng_specs.errno_at, bits_add, pow2)
  // errno's bytes: mapped read-write, not the stack's, the C world's
  have eb: all i. i in omega -> int_lt(i, 4) ->
      (x86_64_linux.mapped(S.vm, int_div(int_add(mallocng_specs.errno_at(S.fs_base), i), x86_64_linux.PAGE)) &&
       !(snd(S.vm.pages[int_div(int_add(mallocng_specs.errno_at(S.fs_base), i), x86_64_linux.PAGE)]).kind = 2)) &&
      snd(S.vm.pages[int_div(int_add(mallocng_specs.errno_at(S.fs_base), i), x86_64_linux.PAGE)]).prot.r &&
      snd(S.vm.pages[int_div(int_add(mallocng_specs.errno_at(S.fs_base), i), x86_64_linux.PAGE)]).prot.w &&
      int_add(mallocng_specs.errno_at(S.fs_base), i) in S.objs.c_bytes && !mallocng.in_ranges(int_add(mallocng_specs.errno_at(S.fs_base), i), mallocng.fp_ranges(c, A)) proof
    fix i
    assume hi hil
    let a := int_add(int_add(S.fs_base, 52), i)
    have ae: int_add(mallocng_specs.errno_at(S.fs_base), i) = a by simp(ea)
    have ao: a in omega by arith(fsb, hi)
    have rw := mp(all_elim(expand(heo, malloc.errno_ok), {a}), ao, apply(mp.top_ebyte[eo := eo, S := S, i := i], fsb, fsl, he, hi, hil))
    have mq pr pw := expand(rw, malloc.rw_mapped)
    have ml mn := expand(mq, x86_64_linux.mapped)
    have qs: int_div(a, x86_64_linux.PAGE) in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) by sel(taut((int_div(a, x86_64_linux.PAGE) in omega by arith(ao, kp)), ml))
    have nk := mp(all_elim(nst, {int_div(a, x86_64_linux.PAGE)}), qs, mn)
    have nc: !(a in abi.canary(S.fs_base)) proof
      assume w
      have w1 w2 := (int_le(int_add(S.fs_base, 40), a) && int_lt(a, int_add(S.fs_base, 48)) by taut(set_select_def[s := omega, p := x0. int_le(int_add(S.fs_base, 40), x0) && int_lt(x0, int_add(S.fs_base, 48)), z := a], expand(w, abi.canary)))
      show by arith(w2, hi)
    qed
    have inc: a in S.objs.c_bytes := rewrite(sym(cb), (a in set_select(omega, x0. !(x0 in abi.canary(S.fs_base))) by sel(taut(ao, nc))))
    have nr := mp(all_elim(rer, {i}), hi, hil)
    show by simp(ae, mq, nk, pr, pw, inc, nr)
  qed
  have ap: mallocng_specs.errno_apart(c, A, S.vm, S.fs_base) proof
    fix i
    assume hi hil
    have e1 e2 _ _ _ e6 := mp(all_elim(eb, {i}), hi, hil)
    show by taut(e1, e6)
  qed
  have uw: gimple.usable(S.vm, S.objs, mallocng_specs.errno_at(S.fs_base), 4, true) proof
    fix i
    assume hi hil
    have e1 e2 e3 e4 e5 _ := mp(all_elim(eb, {i}), hi, hil)
    show by simp(e1, e2, e4, e5)
  qed
  have ur: gimple.usable(S.vm, S.objs, mallocng_specs.errno_at(S.fs_base), 4, false) proof
    fix i
    assume hi hil
    have e1 e2 e3 e4 e5 _ := mp(all_elim(eb, {i}), hi, hil)
    show by simp(e1, e2, e3, e5)
  qed
  have eok: mallocng_specs.errno_ok(S.vm, S.objs, S.fs_base) by defs(taut(fsl, uw, th, ur), mallocng_specs.errno_ok)
  // the allocator's bytes and its reserve's pages: the C world's (none the canary's)
  have fs: mallocng.fp_shown(mallocng.fp_ranges(c, A), S.objs) proof
    fix a
    assume ao ir
    have nc: !(a in abi.canary(S.fs_base)) proof
      assume w
      have n1 _ := mp(all_elim(rca, {a}), ao, w)
      show by taut(n1, ir)
    qed
    show := rewrite(sym(cb), (a in set_select(omega, x0. !(x0 in abi.canary(S.fs_base))) by sel(taut(ao, nc))))
  qed
  have rs: int_lt(0, A.reserve_cnt) -> (all x0. x0 in omega -> int_le(int_div(A.reserve, x86_64_linux.PAGE), int_div(x0, x86_64_linux.PAGE)) &&
      int_lt(int_div(x0, x86_64_linux.PAGE), int_add(int_div(A.reserve, x86_64_linux.PAGE), A.reserve_cnt)) -> x0 in S.objs.c_bytes) proof
    assume c0
    fix a
    assume ao hq
    have nc: !(a in abi.canary(S.fs_base)) proof
      assume w
      have _ n2 := mp(all_elim(rca, {a}), ao, w)
      show by taut(n2, c0, hq)
    qed
    show := rewrite(sym(cb), (a in set_select(omega, x0. !(x0 in abi.canary(S.fs_base))) by sel(taut(ao, nc))))
  qed
  have sh: mallocng.shown_in(c, A, S.objs) by defs(taut(fs, rs), mallocng.shown_in)
  have hin: mallocng.holds_in(c, A, S.vm, S.objs, S.blocks) by defs(taut(hm, sh), mallocng.holds_in)
  have tl: mallocng_specs.tls_apart(c, A, S.fs_base) by defs(rtl, mallocng_specs.tls_apart)
  show by taut(hin, th, tl, bk, eok, ap)
qed

// ----------------------------------------------------------------------
//  After a call: the new state's representation

// (a byte read-write in the machine's view: mapped read-write)
theorem mp.top_rw(vm, a): a in omega -> mallocng.m_rw(mallocng.mview(vm, mallocng.all_bytes()), a) -> malloc.rw_mapped(vm, a)
proof
  assume hao r
  have mm0 pr pw := expand(r, mallocng.m_rw)
  have mb mn := expand(mm0, mallocng.m_mapped)
  have p0 := apply(mp.pg_view[vm := vm, fp := mallocng.all_bytes(), a := a], hao, (a in mallocng.all_bytes() by defs(sel(taut(hao)), mallocng.all_bytes)))
  have mq: x86_64_linux.mapped(vm, int_div(a, x86_64_linux.PAGE)) by defs(taut(mb, rewrite(p0, mn)), x86_64_linux.mapped)
  show by defs(taut(mq, rewrite(p0, pr), rewrite(p0, pw)), malloc.rw_mapped)
qed

// (the live blocks of a state that holds: mapped read-write -- in their
// groups, which are)
theorem mp.top_live(c, A, V, b): A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) -> mallocng.holds_m(c, A, V, b) ->
  all q. q in bits(64) -> !(b[q] = none) -> (all x. x in omega -> int_le(q, x) && int_lt(x, int_add(q, snd(b[q]))) -> malloc.rw_mapped(V, x))
proof
  assume ha hb hm
  have {H = inv, hrw = rw} := expand(hm, mallocng.holds_m)
  fix q
  assume hq hn
  fix x
  assume ho hr
  have inr: x in malloc.range(q, snd(b[q])) by defs(sel(taut(ho, hr)), malloc.range)
  have ex: ex y. y in bits(64) && (!(b[y] = none) && x in malloc.range(y, snd(b[y]))) by ex_intro({q}, taut(hq, hn, inr))
  have l: x in malloc.live_of(b) by taut(apply(mp.live_def[b := b, a := x]), ho, ex)
  obtain g, hg hgr from apply(mp.live_grp, ha, hb, H, l)
  have {go = nat} := apply(mp.used_nat, ha, hg)
  have r1 _ := mp(all_elim(expand(hrw, mallocng.grp_rw), {g}, {x}), conj(go, ho), taut(hg, hgr, l))
  show := apply(mp.top_rw, ho, r1)
qed

// (the stack protector's word: mapped, apart from A -- so from A2, whose
// ranges are A's or memory unmapped before, and from A2's reserve's pages,
// whole pages of its ranges)
theorem mp.top_can(c, A, A2, V2, b2, vm, fs): c in mallocng.Cfg -> A2 in univ(1) -> A2 in mallocng.Abs -> mallocng.holds_m(c, A2, V2, b2) -> fs in bits(64) ->
  abi.canary_ok(vm, fs) -> mp.rng_grown(c, A2, A, vm) ->
  (all x0. x0 in omega -> x0 in abi.canary(fs) -> !mallocng.in_ranges(x0, mallocng.fp_ranges(c, A)) &&
     !((int_lt(0, A.reserve_cnt) && int_le(int_div(A.reserve, x86_64_linux.PAGE), int_div(x0, x86_64_linux.PAGE))) &&
       int_lt(int_div(x0, x86_64_linux.PAGE), int_add(int_div(A.reserve, x86_64_linux.PAGE), A.reserve_cnt)))) ->
  all x0. x0 in omega -> x0 in abi.canary(fs) -> !mallocng.in_ranges(x0, mallocng.fp_ranges(c, A2)) &&
    !((int_lt(0, A2.reserve_cnt) && int_le(int_div(A2.reserve, x86_64_linux.PAGE), int_div(x0, x86_64_linux.PAGE))) &&
      int_lt(int_div(x0, x86_64_linux.PAGE), int_add(int_div(A2.reserve, x86_64_linux.PAGE), A2.reserve_cnt)))
proof
  assume hc hu ha hm fsb hcn hg hca
  have kp: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
  have rd _ := expand(hcn, abi.canary_ok)
  fix a
  assume ao ac
  have a1 a2 := (int_le(int_add(fs, 40), a) && int_lt(a, int_add(fs, 48)) by taut(set_select_def[s := omega, p := x0. int_le(int_add(fs, 40), x0) && int_lt(x0, int_add(fs, 48)), z := a], expand(ac, abi.canary)))
  // (its page mapped)
  let j := int_sub(int_sub(a, fs), 40)
  have mj _ := mp(all_elim(expand(rd, x86_64_linux.readable), {j}), (j in omega by arith(a1)), (int_lt(j, 8) by arith(a2)))
  have eqa: int_add(int_add(fs, 40), j) = a by arith()
  have ma := rewrite(eqa, mj)
  have n0 _ := mp(all_elim(hca, {a}), ao, ac)
  have n1: !mallocng.in_ranges(a, mallocng.fp_ranges(c, A2)) proof
    assume ir
    show by taut(mp(all_elim(hg, {a}), ao, ir), n0, ma)
  qed
  // (A2's reserve: whole pages of its ranges)
  have n2: !((int_lt(0, A2.reserve_cnt) && int_le(int_div(A2.reserve, x86_64_linux.PAGE), int_div(a, x86_64_linux.PAGE))) &&
      int_lt(int_div(a, x86_64_linux.PAGE), int_add(int_div(A2.reserve, x86_64_linux.PAGE), A2.reserve_cnt))) proof
    assume w
    have w0 w1 w2 := w
    have {H = inv} := expand(hm, mallocng.holds_m)
    have {cok = ctx} := expand(H, mallocng.holds)
    have {k7 = avail_areas} := expand(cok, mallocng.ctx_ok)
    have _ ral := mp(k7, w0)
    have ro rco := (A2.reserve in omega && A2.reserve_cnt in omega by simp(ha))
    have r1: int_le(A2.reserve, a) by arith(ral, w1, kp, ro, ao)
    have r2: int_lt(a, int_add(A2.reserve, int_mul(4096, A2.reserve_cnt))) by arith(ral, w2, kp, ro, rco, ao)
    show by taut(n1, apply(mp.res_rng[c := c, A := A2, a := a], hc, hu, ha, r1, r2))
  qed
  show by taut(n1, n2)
qed

// (the thread pointer sound: below the task's end, errno 0x34 past it)
theorem mp.top_fsl(vm, fs): fs in bits(64) -> abi.thread_ok(vm, fs) ->
  fsl: int_le(int_add(fs, 56), int_pow(2, 64)) && ea: mallocng_specs.errno_at(fs) = int_add(fs, 52)
proof
  assume fsb th
  have kp: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
  have ts: int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE) = 34359738367 by defs(simp(), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
  have r0 _ _ _ := expand(th, abi.thread_ok)
  have m0 _ := mp(all_elim(expand(r0, x86_64_linux.readable), {0}), simp(), simp())
  have t0 _ := expand(m0, x86_64_linux.mapped)
  have fsl: int_le(int_add(fs, 56), int_pow(2, 64)) by arith(t0, ts, kp, fsb)
  have ea: mallocng_specs.errno_at(fs) = int_add(fs, 52) by defs(arith(fsb, fsl), mallocng_specs.errno_at, bits_add, pow2)
  show by taut(fsl, ea)
qed

// (a block of size n made at p: the blocks still a map to sizes)
theorem mp.sb_btype(b, p, n): b in fn_space(bits(64), option(omega)) -> n in omega -> malloc.set_block(b, p, some(n)) in fn_space(bits(64), option(omega))
proof
  assume hb hn
  have r1: some(n) in set_image(omega, x0. some(x0)) by taut(set_image_def[s := omega, f := x0. some(x0), y := some(n)],
    (ex x0. x0 in omega && some(x0) = some(n) by ex_intro({n}, taut(hn, refl({some(n)})))))
  have sn: some(n) in option(omega) by defs(simp(r1), option)
  have vq: all q. q in bits(64) -> ite(q = p, some(n), b[q]) in option(omega) proof
    fix q
    assume hq
    have bq := mp(fn_space_app[a := bits(64), b := option(omega), f := b, x := q], hb, hq)
    have c1: q = p -> ite(q = p, some(n), b[q]) in option(omega) proof
      assume e
      show by simp(e, sn)
    qed
    have c2: !(q = p) -> ite(q = p, some(n), b[q]) in option(omega) proof
      assume e
      show by simp(e, bq)
    qed
    show by taut(c1, c2)
  qed
  show by defs(mp(fn_build_space[d := bits(64), v := q. ite(q = p, some(n), b[q]), b := option(omega)], vq), malloc.set_block)
qed

// (malloc(0)'s block at p: its place, the byte p, the allocator's -- in
// p's slot, no live block's, neither reserved nor taken)
theorem mp.top_zbyte(c, A3, V3, B, p): c in mallocng.Cfg -> A3 in univ(1) -> A3 in mallocng.Abs -> B in fn_space(bits(64), option(omega)) -> p in bits(64) ->
  B[p] = none -> mallocng.holds_m(c, A3, V3, malloc.set_block(B, p, some(0))) -> mallocng.no_reserved(A3) -> seq_len(A3.taken) = 0 ->
  p in mallocng.footprint(c, A3, malloc.set_block(B, p, some(0)))
proof
  assume hc hu ha hb hp hbn hm nr tk
  let B2 := malloc.set_block(B, p, some(0))
  have b2t := apply(mp.sb_btype[b := B, p := p, n := 0], hb, simp())
  have {H = inv} := expand(hm, mallocng.holds_m)
  have {huo = used, bok = in_slots, bwf = wf} := expand(H, mallocng.holds)
  have b2p: B2[p] = some(0) by defs(simp(hp), malloc.set_block)
  have po: p in omega by arith(hp)
  // (its slot)
  obtain k i, hk hi hkl hil hs from mp(all_elim(expand(bok, mallocng.blocks_ok), {p}), hp, (!(B2[p] = none) by simp(b2p)))
  let g := A3.used[k]
  have iu: mallocng.is_used(A3, g) by defs(ex_intro({k}, taut(hk, hkl, refl({g}))), mallocng.is_used)
  have {go = nat} := apply(mp.used_nat, ha, iu)
  have {ins = inslot} := apply(mp.blk_frame[c := c, A := A3, M := mallocng.mview(V3, mallocng.held(c, A3, B2)), b := B2, brk := V3.brk, h := g, j := i, q := p],
    ha, b2t, H, iu, hi, hil, hs, po)
  have gok := apply(mp.used_group, huo, iu)
  have ir := apply(mp.slot_in_group[A := A3, M := mallocng.mview(V3, mallocng.held(c, A3, B2)), b := B2, g := g, i := i, a := p], ha, go, hi, po, gok, hil, ins)
  have rr := apply(mp.used_rng, hc, hu, ha, iu, ir)
  // (no live block's: the blocks' places apart)
  have nl: !(p in malloc.live_of(B2)) proof
    assume l
    have l2 := (p in malloc.live_of(B) || (p in omega && int_le(p, p) && int_lt(p, int_add(p, 0))) by taut(apply(mp.live_new[b := B, p := p, n := 0, a := p], hp, hbn), l))
    have l3: p in malloc.live_of(B) by taut(l2, (!int_lt(p, int_add(p, 0)) by arith()))
    have _ ex := (p in omega && (ex q. q in bits(64) && (!(B[q] = none) && p in malloc.range(q, snd(B[q])))) by taut(apply(mp.live_def[b := B, a := p]), l3))
    obtain q, hq hqn hqr from ex
    have qp: !(q = p) proof
      assume e
      show by taut(hqn, rewrite(sym(e), hbn))
    qed
    have bq: B2[q] = B[q] by defs(simp(hq, qp), malloc.set_block)
    have _ _ dj := expand(mp(all_elim(expand(bwf, malloc.blocks_wf), {p}), hp, (!(B2[p] = none) by simp(b2p))), malloc.block_wf)
    have d := mp(all_elim(dj, {q}), hq, conj(qp, (!(B2[q] = none) by simp(bq, hqn))))
    have q1 q2 := (int_le(q, p) && int_lt(p, int_add(q, snd(B[q]))) by taut(set_select_def[s := omega, p := x0. int_le(q, x0) && int_lt(x0, int_add(q, snd(B[q]))), z := p], expand(hqr, malloc.range)))
    have _ sq := apply(mp.opt_nat[o := B[q]], mp(fn_space_app[a := bits(64), b := option(omega), f := B, x := q], hb, hq), hqn)
    have inp: p in malloc.range(p, malloc.extent(snd(B2[p]))) by defs(sel(simp(po, b2p)), malloc.range, malloc.extent)
    have ext: int_le(snd(B[q]), malloc.extent(snd(B[q]))) proof
      have c0: snd(B[q]) = 0 -> int_le(snd(B[q]), malloc.extent(snd(B[q]))) proof
        assume e
        show by defs(simp(e), malloc.extent)
      qed
      have c1: !(snd(B[q]) = 0) -> int_le(snd(B[q]), malloc.extent(snd(B[q]))) proof
        assume e
        show by defs(simp(e), malloc.extent)
      qed
      show by taut(c0, c1)
    qed
    have inq: p in malloc.range(q, malloc.extent(snd(B2[q]))) by defs(sel(arith(po, q1, q2, sq, ext, (snd(B2[q]) = snd(B[q]) by simp(bq)))), malloc.range)
    show by taut(mp(all_elim(expand(d, malloc.disjoint), {p}), po), inp, inq)
  qed
  have nres := apply(mp.nores[A := A3, a := p], nr)
  have nt: !mallocng.in_taken(A3, p) proof
    assume w
    obtain kk, hkk hkkl _ _ from expand(w, mallocng.in_taken)
    show by arith(hkk, hkkl, tk)
  qed
  show by taut(apply(mp.fp_def[c := c, A := A3, b := B2, a := p]), po, rr, nl, nres, nt)
qed

// After malloc's block p of n bytes (`mp.mi_blk`, from A at S): the new
// state represented by A3 (rep), p 16-aligned (the blocks' places), and
// its place -- n bytes, or the byte p for malloc(0) -- the allocator's
// before or unmapped
theorem mp.top_mblk(c, A, S, n, A3, V3, p): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> S.blocks in fn_space(bits(64), option(omega)) ->
  S.fs_base in bits(64) -> n in omega -> mallocng.rep(c, A, S) -> abi.thread_ok(S.vm, S.fs_base) -> abi.canary_ok(S.vm, S.fs_base) ->
  mallocng_specs.errno_apart(c, A, S.vm, S.fs_base) -> mp.mi_blk(c, A, n, S.blocks, S, A3, V3, p) ->
  rep: mallocng.rep(c, A3, fn_update(fn_update(S, "blocks", malloc.set_block(S.blocks, p, some(n))), "vm", V3)) &&
  align: int_mod(p, 16) = 0 &&
  ext: (all a. a in omega -> a in malloc.range(p, malloc.extent(n)) ->
     a in mallocng.footprint(c, A, S.blocks) || !x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)))
proof
  assume hc hu ha hb fsb hn hr hth hcn hea hblk
  let B := S.blocks
  let B2 := malloc.set_block(B, p, some(n))
  have {hm = mem, rtl = tls, rca = canary} := expand(hr, mallocng.rep)
  have a3a a3u nr3 tk3 v3v pb pnz bn hm3 hsh3 hun hfp hbr := hblk
  have b2t := apply(mp.sb_btype[b := B, p := p, n := n], hb, hn)
  have {fsl = fsl, ea = ea} := apply(mp.top_fsl, fsb, hth)
  // A3's ranges: A's or memory unmapped before
  have {f = fp, l = live} := apply(mp.has_rng, hc, hu, ha, hb, hm)
  have gfp: all a. a in omega -> a in mallocng.footprint(c, A3, B2) ->
      mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) || !x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) proof
    fix a
    assume ao h
    show by taut(mp(all_elim(hfp, {a}), ao, h), all_elim(f, {a}))
  qed
  have grs: all a. a in omega -> mallocng.in_reserved(A3, a) ->
      mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) || !x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) proof
    fix a
    assume _ h
    show by taut(h, apply(mp.nores[A := A3, a := a], nr3))
  qed
  have gtk: all a. a in omega -> mallocng.in_taken(A3, a) ->
      mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) || !x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) proof
    fix a
    assume _ w
    obtain kk, hkk hkkl _ _ from expand(w, mallocng.in_taken)
    have f0: false by arith(hkk, hkkl, tk3)
    show by taut(f0)
  qed
  have glv: all a. a in omega -> a in malloc.live_of(B2) ->
      mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) || !x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) proof
    fix a
    assume ao h
    have l2 := (a in malloc.live_of(B) || (a in omega && int_le(p, a) && int_lt(a, int_add(p, n))) by taut(apply(mp.live_new[b := B, p := p, n := n, a := a], pb, bn), h))
    have c1: (a in omega && int_le(p, a) && int_lt(a, int_add(p, n))) ->
        mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) || !x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) proof
      assume w
      have _ w1 w2 := w
      show by taut(mp(all_elim(hbr, {a}), ao, w1, w2), all_elim(f, {a}))
    qed
    show by taut(l2, all_elim(l, {a}), c1)
  qed
  have grown := apply(mp.rng_grow[c := c, A := A, A2 := A3, b2 := B2, vm := S.vm], gfp, grs, gtk, glv)
  // rep's parts for A3
  have tl3 := apply(mp.tls_grow[c := c, A := A, A2 := A3, vm := S.vm, fs := S.fs_base], fsb, hth, (mallocng_specs.tls_apart(c, A, S.fs_base) by defs(rtl, mallocng_specs.tls_apart)), grown)
  have er3: all x0. x0 in omega -> int_lt(x0, 4) -> !mallocng.in_ranges(int_add(int_add(S.fs_base, 52), x0), mallocng.fp_ranges(c, A3)) proof
    fix i
    assume hi hil
    have n0 m0 := rewrite(ea, mp(all_elim(expand(hea, mallocng_specs.errno_apart), {i}), hi, hil))
    assume ir
    show by taut(mp(all_elim(grown, {int_add(int_add(S.fs_base, 52), i)}), (int_add(int_add(S.fs_base, 52), i) in omega by arith(fsb, hi)), ir), n0, m0)
  qed
  have ca3 := apply(mp.top_can[c := c, A := A, A2 := A3, V2 := V3, b2 := B2, vm := S.vm, fs := S.fs_base], hc, a3u, a3a, hm3, fsb, hcn, grown, rca)
  have lv3 := apply(mp.top_live[c := c, A := A3, V := V3, b := B2], a3a, b2t, hm3)
  let T := fn_update(fn_update(S, "blocks", B2), "vm", V3)
  have tm: mallocng.holds_m(c, A3, T.vm, T.blocks) by simp(hm3, keep(mallocng.holds_m))
  have tl: malloc.live_rw(T) by defs(simp(lv3), malloc.live_rw)
  have tt: all x0. x0 in omega -> int_lt(x0, 8) -> !mallocng.in_ranges(int_add(T.fs_base, x0), mallocng.fp_ranges(c, A3)) by simp(expand(tl3, mallocng_specs.tls_apart))
  have te: all x0. x0 in omega -> int_lt(x0, 4) -> !mallocng.in_ranges(int_add(int_add(T.fs_base, 52), x0), mallocng.fp_ranges(c, A3)) by simp(er3)
  have tc: all x0. x0 in omega -> x0 in abi.canary(T.fs_base) -> !mallocng.in_ranges(x0, mallocng.fp_ranges(c, A3)) &&
      !((int_lt(0, A3.reserve_cnt) && int_le(int_div(A3.reserve, x86_64_linux.PAGE), int_div(x0, x86_64_linux.PAGE))) &&
        int_lt(int_div(x0, x86_64_linux.PAGE), int_add(int_div(A3.reserve, x86_64_linux.PAGE), A3.reserve_cnt))) by simp(ca3)
  have rep3: mallocng.rep(c, A3, T) by defs(taut(tm, nr3, tk3, tl, tt, te, tc), mallocng.rep)
  // p 16-aligned: the blocks' places
  have {H3 = inv} := expand(hm3, mallocng.holds_m)
  have {bwf = wf} := expand(H3, mallocng.holds)
  have b2p: B2[p] = some(n) by defs(simp(pb), malloc.set_block)
  have _ al _ := expand(mp(all_elim(expand(bwf, malloc.blocks_wf), {p}), pb, (!(B2[p] = none) by simp(b2p))), malloc.block_wf)
  // its place: the block's bytes, or for malloc(0) the byte p
  have ext: all a. a in omega -> a in malloc.range(p, malloc.extent(n)) ->
      a in mallocng.footprint(c, A, B) || !x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) proof
    fix a
    assume ao h
    have r1 r2 := (int_le(p, a) && int_lt(a, int_add(p, malloc.extent(n))) by taut(set_select_def[s := omega, p := x0. int_le(p, x0) && int_lt(x0, int_add(p, malloc.extent(n))), z := a], expand(h, malloc.range)))
    have z0: n = 0 -> a in mallocng.footprint(c, A, B) || !x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) proof
      assume e
      have ap: a = p by defs(arith(r1, rewrite(e, r2)), malloc.extent)
      have fz := apply(mp.top_zbyte[c := c, A3 := A3, V3 := V3, B := B, p := p], hc, a3u, a3a, hb, pb, bn, rewrite(e, hm3), nr3, tk3)
      show := rewrite(sym(ap), mp(all_elim(hfp, {p}), (p in omega by arith(pb)), rewrite(sym(e), fz)))
    qed
    have z1: !(n = 0) -> a in mallocng.footprint(c, A, B) || !x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) proof
      assume e
      have en: malloc.extent(n) = n by defs(simp(e), malloc.extent)
      have r3: int_lt(a, int_add(p, n)) := rewrite(en, r2)
      show := mp(all_elim(hbr, {a}), ao, r1, r3)
    qed
    show by taut(z0, z1)
  qed
  show by taut(rep3, al, ext)
qed

// After malloc's failure (`mp.mi_zero`, from A at S): the new memory
// represented by A2, the live blocks as they were
theorem mp.top_mzero(c, A, S, A2, V2): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> S.blocks in fn_space(bits(64), option(omega)) ->
  S.fs_base in bits(64) -> mallocng.rep(c, A, S) -> abi.thread_ok(S.vm, S.fs_base) -> abi.canary_ok(S.vm, S.fs_base) ->
  mallocng_specs.errno_apart(c, A, S.vm, S.fs_base) -> mp.mi_zero(c, A, S.blocks, S, A2, V2) ->
  mallocng.rep(c, A2, fn_update(S, "vm", V2))
proof
  assume hc hu ha hb fsb hr hth hcn hea hz
  let B := S.blocks
  have {hm = mem, rtl = tls, rca = canary} := expand(hr, mallocng.rep)
  have a2a a2u nr2 tk2 v2v hm2 hsh2 hun hfp _ := hz
  have {fsl = fsl, ea = ea} := apply(mp.top_fsl, fsb, hth)
  have {f = fp, l = live} := apply(mp.has_rng, hc, hu, ha, hb, hm)
  have gfp: all a. a in omega -> a in mallocng.footprint(c, A2, B) ->
      mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) || !x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) proof
    fix a
    assume ao h
    show by taut(mp(all_elim(hfp, {a}), ao, h), all_elim(f, {a}))
  qed
  have grs: all a. a in omega -> mallocng.in_reserved(A2, a) ->
      mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) || !x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) proof
    fix a
    assume _ h
    show by taut(h, apply(mp.nores[A := A2, a := a], nr2))
  qed
  have gtk: all a. a in omega -> mallocng.in_taken(A2, a) ->
      mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) || !x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) proof
    fix a
    assume _ w
    obtain kk, hkk hkkl _ _ from expand(w, mallocng.in_taken)
    have f0: false by arith(hkk, hkkl, tk2)
    show by taut(f0)
  qed
  have glv: all a. a in omega -> a in malloc.live_of(B) ->
      mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) || !x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) proof
    fix a
    assume _ h
    show by taut(mp(all_elim(l, {a}), h))
  qed
  have grown := apply(mp.rng_grow[c := c, A := A, A2 := A2, b2 := B, vm := S.vm], gfp, grs, gtk, glv)
  have tl2 := apply(mp.tls_grow[c := c, A := A, A2 := A2, vm := S.vm, fs := S.fs_base], fsb, hth, (mallocng_specs.tls_apart(c, A, S.fs_base) by defs(rtl, mallocng_specs.tls_apart)), grown)
  have er2: all x0. x0 in omega -> int_lt(x0, 4) -> !mallocng.in_ranges(int_add(int_add(S.fs_base, 52), x0), mallocng.fp_ranges(c, A2)) proof
    fix i
    assume hi hil
    have n0 m0 := rewrite(ea, mp(all_elim(expand(hea, mallocng_specs.errno_apart), {i}), hi, hil))
    assume ir
    show by taut(mp(all_elim(grown, {int_add(int_add(S.fs_base, 52), i)}), (int_add(int_add(S.fs_base, 52), i) in omega by arith(fsb, hi)), ir), n0, m0)
  qed
  have ca2 := apply(mp.top_can[c := c, A := A, A2 := A2, V2 := V2, b2 := B, vm := S.vm, fs := S.fs_base], hc, a2u, a2a, hm2, fsb, hcn, grown, rca)
  have lv2 := apply(mp.top_live[c := c, A := A2, V := V2, b := B], a2a, hb, hm2)
  let T := fn_update(S, "vm", V2)
  have tm: mallocng.holds_m(c, A2, T.vm, T.blocks) by simp(hm2, keep(mallocng.holds_m))
  have tl: malloc.live_rw(T) by defs(simp(lv2), malloc.live_rw)
  have tt: all x0. x0 in omega -> int_lt(x0, 8) -> !mallocng.in_ranges(int_add(T.fs_base, x0), mallocng.fp_ranges(c, A2)) by simp(expand(tl2, mallocng_specs.tls_apart))
  have te: all x0. x0 in omega -> int_lt(x0, 4) -> !mallocng.in_ranges(int_add(int_add(T.fs_base, 52), x0), mallocng.fp_ranges(c, A2)) by simp(er2)
  have tc: all x0. x0 in omega -> x0 in abi.canary(T.fs_base) -> !mallocng.in_ranges(x0, mallocng.fp_ranges(c, A2)) &&
      !((int_lt(0, A2.reserve_cnt) && int_le(int_div(A2.reserve, x86_64_linux.PAGE), int_div(x0, x86_64_linux.PAGE))) &&
        int_lt(int_div(x0, x86_64_linux.PAGE), int_add(int_div(A2.reserve, x86_64_linux.PAGE), A2.reserve_cnt))) by simp(ca2)
  show by defs(taut(tm, nr2, tk2, tl, tt, te, tc), mallocng.rep)
qed

// ----------------------------------------------------------------------
//  The layer's allocator step

// (a byte of the layer's errno bytes: one of errno's)
theorem mp.top_eb(eo, S, a): S.fs_base in bits(64) -> int_le(int_add(S.fs_base, 56), int_pow(2, 64)) -> app(eo, empty) = 52 ->
  a in omega -> a in mp.errno(S.fs_base) -> a in malloc.errno_bytes(eo, S)
proof
  assume fsb fsl he ao h
  have h1 h2 := (int_le(int_add(S.fs_base, 52), a) && int_lt(a, int_add(S.fs_base, 56)) by taut(set_select_def[s := omega, p := x. int_le(int_add(S.fs_base, 52), x) && int_lt(x, int_add(S.fs_base, 56)), z := a], h))
  let i := int_sub(int_sub(a, S.fs_base), 52)
  have e := apply(mp.top_ebyte[eo := eo, S := S, i := i], fsb, fsl, he, (i in omega by arith(h1)), (int_lt(i, 4) by arith(h2)))
  show := rewrite((int_add(int_add(S.fs_base, 52), i) = a by arith()), e)
qed

// From A at S to A2 at T, the memory outside the allocator's untouched but
// errno, the allocator grown only into memory unmapped before: a step of
// the layer's allocator (with errno's bytes extra)
theorem mp.top_step(c, A, S, T, A2, eo, b, cd, st): A in mallocng.Abs -> A2 in mallocng.Abs ->
  S in rec_and(abi.World, malloc.Heap.ghost) -> T in rec_and(abi.World, malloc.Heap.ghost) -> S.fs_base in bits(64) -> app(eo, empty) = 52 ->
  mallocng.rep(c, A, S) -> mallocng.rep(c, A2, T) -> abi.thread_ok(S.vm, S.fs_base) -> malloc.world_ok(b, cd, st, S) ->
  mallocng.untouched(c, A, S.blocks, S.vm, T.vm, S.objs, mp.errno(S.fs_base)) ->
  (all a. a in omega -> a in mallocng.footprint(c, A2, T.blocks) ->
     a in mallocng.footprint(c, A, S.blocks) || !x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE))) ->
  malloc.step_ok(mallocng.inv(c), mallocng.owned(c), S, T, malloc.errno_bytes(eo, S))
proof
  assume ha ha2 hs ht fsb he hr hr2 hth hw hun hg
  have {fsl = fsl} := apply(mp.top_fsl, fsb, hth)
  have nst _ _ _ _ _ := expand(hw, malloc.world_ok)
  have uk bk := expand(hun, mallocng.untouched)
  // outside what S's allocator owns and errno: untouched (no stack page
  // among the world's: no byte stack-free)
  have fr: all a. a in omega -> (!(a in mallocng.owned(c)[S]) && !(a in malloc.errno_bytes(eo, S))) && x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) ->
      T.vm.bytes[bits_of_int(64, a)] = S.vm.bytes[bits_of_int(64, a)] && T.vm.pages[int_div(a, x86_64_linux.PAGE)] = S.vm.pages[int_div(a, x86_64_linux.PAGE)] proof
    fix a
    assume ao h
    have no ne hm := h
    have nf: !(a in mallocng.footprint(c, A, S.blocks)) proof
      assume w
      show by taut(no, apply(mallocng.owned_intro[c := c, s := S, A := A, a := a], hs, ha, hr, ao, w))
    qed
    have nr: !(a in mp.errno(S.fs_base)) proof
      assume w
      show by taut(ne, apply(mp.top_eb[eo := eo, S := S, a := a], fsb, fsl, he, ao, w))
    qed
    have ml mn := expand(hm, x86_64_linux.mapped)
    have kp: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
    have qs: int_div(a, x86_64_linux.PAGE) in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) by sel(taut((int_div(a, x86_64_linux.PAGE) in omega by arith(ao, kp)), ml))
    have nk := mp(all_elim(nst, {int_div(a, x86_64_linux.PAGE)}), qs, mn)
    have nsf: !abi.stack_free(S.vm, S.objs, a) by defs(taut(hm, nk), abi.stack_free)
    have u1 u2 := mp(all_elim(uk, {a}), ao, conj(conj(nf, nr), hm))
    show by taut(mp(u1, nsf), u2)
  qed
  have b1 b2 b3 := expand(bk, mallocng.bounds_kept)
  have af: malloc.alloc_frame(mallocng.owned(c), S, T.vm, malloc.errno_bytes(eo, S)) by defs(taut(fr, b1, b2, b3), malloc.alloc_frame)
  have ti := apply(mallocng.inv_intro[c := c, s := T, A := A2], ht, ha2, hr2)
  // what T's allocator owns: A2's footprint (A2 unique), so A's or unmapped
  have ow: all a. a in omega -> a in mallocng.owned(c)[T] ->
      (a in mallocng.owned(c)[S] || a in malloc.errno_bytes(eo, S)) || !x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) proof
    fix a
    assume ao h
    obtain B, hb hbr hbf from apply(mallocng.owned_mem[c := c, s := T, a := a], ht, h)
    have eq := apply(mallocng.abs_unique[c := c, s := T, A := B, B := A2], ht, hb, ha2, hbr, hr2)
    have g1 := mp(all_elim(hg, {a}), ao, rewrite(eq, hbf))
    have c1: a in mallocng.footprint(c, A, S.blocks) -> a in mallocng.owned(c)[S] proof
      assume w
      show := apply(mallocng.owned_intro[c := c, s := S, A := A, a := a], hs, ha, hr, ao, w)
    qed
    show by taut(g1, c1)
  qed
  show by defs(taut(af, ti, ow), malloc.step_ok)
qed

// ----------------------------------------------------------------------
//  malloc's failure: the layer's out_of_memory

// (errno ENOMEM: its bytes 12, 0, 0, 0)
theorem mp.top_e12(V, a): V.bytes in fn_space(bits(64), bits(8)) -> gimple.bytes_at(V, a, 4) = 12 ->
  all i. i in omega -> int_lt(i, 4) -> V.bytes[bits_add(64, a, bits_of_int(64, i))] = bits_of_int(8, int_div(12, int_pow(256, i)))
proof
  assume hb he
  let y(k) := V.bytes[bits_add(64, a, bits_of_int(64, k))]
  have s4: int_add(int_add(int_add(y(0), int_mul(y(1), 256)), int_mul(y(2), 65536)), int_mul(y(3), 16777216)) = 12 by simp(expand(he, gimple.bytes_at))
  have yb: all k. y(k) in bits(8) proof
    fix k
    show := apply(fn_space_app, hb, (bits_add(64, a, bits_of_int(64, k)) in bits(64) by simp()))
  qed
  have b0 := all_elim(yb, {0})
  have b1 := all_elim(yb, {1})
  have b2 := all_elim(yb, {2})
  have b3 := all_elim(yb, {3})
  have v0: y(0) = 12 by arith(s4, b0, b1, b2, b3)
  have v1: y(1) = 0 by arith(s4, b0, b1, b2, b3)
  have v2: y(2) = 0 by arith(s4, b0, b1, b2, b3)
  have v3: y(3) = 0 by arith(s4, b0, b1, b2, b3)
  fix i
  assume hi hil
  have cs: i = 0 || i = 1 || i = 2 || i = 3 by arith(hi, hil)
  have c0: i = 0 -> y(i) = bits_of_int(8, int_div(12, int_pow(256, i))) proof
    assume e
    show by simp(e, v0)
  qed
  have c1: i = 1 -> y(i) = bits_of_int(8, int_div(12, int_pow(256, i))) proof
    assume e
    show by simp(e, v1)
  qed
  have c2: i = 2 -> y(i) = bits_of_int(8, int_div(12, int_pow(256, i))) proof
    assume e
    show by simp(e, v2)
  qed
  have c3: i = 3 -> y(i) = bits_of_int(8, int_div(12, int_pow(256, i))) proof
    assume e
    show by simp(e, v3)
  qed
  show by taut(cs, c0, c1, c2, c3)
qed

// errno set to ENOMEM where it is ENOMEM already: the state as it was (the
// loop's run, by its invariant -- the state unchanged -- and variant 4 - i)
theorem mp.top_seterr(eo, T): T in univ(1) -> T.vm in x86_64_linux.Vm -> is_fun(T) -> "vm" in dom(T) -> T.fs_base in bits(64) ->
  app(eo, empty) = 52 -> mallocng_specs.errno_is(T.vm, T.fs_base, x86_64_linux.ENOMEM) ->
  runs(malloc.set_errno(eo, x86_64_linux.ENOMEM), T, ok(T, empty))
proof
  assume hu hvm hf hd fsb he hen
  let a := bits_add(64, T.fs_base, bits_of_int(64, app(eo, empty)))
  let B := T.vm.bytes
  have ke: x86_64_linux.ENOMEM = 12 by defs(refl({12}), x86_64_linux.ENOMEM)
  have ea: mallocng_specs.errno_at(T.fs_base) = a by defs(simp(he), mallocng_specs.errno_at)
  have b12: gimple.bytes_at(T.vm, a, 4) = 12 := rewrite(ke, rewrite(ea, expand(hen, mallocng_specs.errno_is)))
  have bt: B in fn_space(bits(64), bits(8)) by simp(hvm)
  have e12 := apply(mp.top_e12[V := T.vm, a := a], bt, b12)
  have bf: is_fun(B) && dom(B) = bits(64) by simp(hvm)
  have vf: is_fun(T.vm) && "bytes" in dom(T.vm) by simp(hvm)
  have e0v := mp(fn_update_same[f := T.vm, k := "bytes"], taut(vf), taut(vf))
  have e0s := mp(fn_update_same[f := T, k := "vm"], hf, hd)
  let P(l) := ex i. i in omega && int_le(i, 4) && l = pair(T, i)
  let M(l) := int_sub(4, snd(l))
  let G(l, r) := r = exc(pair(fst(l), snd(l)), pair("brk", empty))
  let BODYA(q, l, o) := (int_lt(snd(l), 4) && letin(snd(l), x7. letin(fn_update(fst(l), "vm", fn_update(fst(l).vm, "bytes",
      fn_update(fst(l).vm.bytes, bits_add(64, q, bits_of_int(64, x7)), bits_of_int(8, int_div(x86_64_linux.ENOMEM, int_pow(256, x7)))))), x8. o = ok(pair(x8, int_add(snd(l), 1)), empty)))) ||
    (!int_lt(snd(l), 4) && o = exc(pair(fst(l), snd(l)), pair("brk", empty)))
  let BODY(l, o) := BODYA(a, l, o)
  have p0: P(pair(T, 0)) by ex_intro({0}, simp())
  have pm: all l. P(l) -> M(l) in omega proof
    fix l
    assume hp2
    obtain i, hi from hp2
    show by simp(hi)
  qed
  have pb: all l. P(l) -> true -> (ex l2. BODY(l, ok(l2, empty)) && P(l2) && int_lt(M(l2), M(l))) || (ex r. BODY(l, r) && G(l, r) && !is_ok(r) && !(fst(r) = 2)) proof
    fix l
    assume hp2 ht
    obtain i, io il le from hp2
    have more: int_lt(i, 4) -> (ex l2. BODY(l, ok(l2, empty)) && P(l2) && int_lt(M(l2), M(l))) proof
      assume hlt
      let k := bits_add(64, a, bits_of_int(64, i))
      have kb: k in bits(64) by simp()
      have bk := mp(all_elim(e12, {i}), io, hlt)
      have same := mp(fn_update_same[f := B, k := k], taut(bf), (k in dom(B) by simp(bf, kb)))
      have ub: fn_update(B, k, bits_of_int(8, int_div(x86_64_linux.ENOMEM, int_pow(256, i)))) = B := rewrite(sym(ke), rewrite(bk, same))
      have bd: BODY(l, ok(pair(T, int_add(i, 1)), empty)) by defs(simp(le, hlt, ub, e0v, e0s), letin)
      have p2: P(pair(T, int_add(i, 1))) by ex_intro({int_add(i, 1)}, simp(io, hlt))
      have m2: int_lt(M(pair(T, int_add(i, 1))), M(l)) by simp(le, io)
      show by ex_intro({pair(T, int_add(i, 1))}, taut(bd, p2, m2))
    qed
    have done: !int_lt(i, 4) -> (ex r. BODY(l, r) && G(l, r) && !is_ok(r) && !(fst(r) = 2)) proof
      assume hge
      let R := exc(pair(fst(l), snd(l)), pair("brk", empty))
      have bd: BODY(l, R) by simp(le, hge)
      have g: G(l, R) by simp()
      have no: !is_ok(R) by defs(simp(), is_ok)
      have nd: !(fst(R) = 2) by simp()
      show by ex_intro({R}, taut(bd, g, no, nd))
    qed
    have cs: int_lt(i, 4) || !int_lt(i, 4) by taut()
    show by taut(cs, more, done)
  qed
  have ex := mp(while_exists[l0 := pair(T, 0), c := l. true, b := l o. BODY(l, o), tr := l. fn_update(empty, "os.events", fst(l).os.events), p := l. P(l), m := l. M(l),
    g := l r. G(l, r)], p0, pm, pb)
  obtain r, hw hnd hcase from ex
  have nst: (ex l. P(l) && !true && r = ok(l, empty)) -> false proof
    assume h
    obtain l0, hl0 from h
    show by taut(hl0)
  qed
  have lft: ex l. P(l) && true && BODY(l, r) && G(l, r) && !is_ok(r) by taut(hcase, nst)
  obtain l, hpl _ hbl hgl hno from lft
  obtain i, io il le from hpl
  have ni: !int_lt(i, 4) proof
    assume hlt
    have bb := rewrite(le, hbl)
    have bb2: letin(i, x7. letin(fn_update(T, "vm", fn_update(T.vm, "bytes",
        fn_update(T.vm.bytes, bits_add(64, a, bits_of_int(64, x7)), bits_of_int(8, int_div(x86_64_linux.ENOMEM, int_pow(256, x7)))))), x8. r = ok(pair(x8, int_add(i, 1)), empty))) by simp(bb, hlt)
    have b1: ex x8. r = ok(pair(x8, int_add(i, 1)), empty) by ex_intro({fn_update(T, "vm", fn_update(T.vm, "bytes",
        fn_update(T.vm.bytes, bits_add(64, a, bits_of_int(64, i)), bits_of_int(8, int_div(x86_64_linux.ENOMEM, int_pow(256, i))))))}, defs(bb2, letin))
    obtain x8, hx8 from b1
    have ok8: is_ok(r) by defs(ex_intro({pair(x8, int_add(i, 1))}, {empty}, hx8), is_ok)
    show by taut(ok8, hno)
  qed
  have ien: i = 4 by arith(il, ni, io)
  have re: r = exc(pair(T, 4), pair("brk", empty)) by simp(hgl, le, ien)
  have hw2 := rewrite(re, hw)
  have pu: pair(T, ok(T, empty)) in univ(1) by simp(hu)
  have rel: letin(a, x2. letin(0, x3. ex x4. while_rel(pair(T, x3), x5. true, x5 x6. BODYA(x2, x5, x6), x5. fn_update(empty, "os.events", fst(x5).os.events), x4) &&
      (((fst(x4) = 0 || (fst(x4) = 1 && fst(out_value(x4)) = "brk")) && ok(T, empty) = ok(fst(out_state(x4)), empty)) ||
       ((((fst(x4) = 1 && fst(out_value(x4)) = "ret") && ok(T, empty) = ok(fst(out_state(x4)), snd(out_value(x4)))) ||
         ((fst(x4) = 1 && fst(out_value(x4)) = "raise") && ok(T, empty) = exc(fst(out_state(x4)), snd(out_value(x4))))) ||
        (fst(x4) = 2 && ok(T, empty) = diverge(snd(x4))))))) by defs(ex_intro({exc(pair(T, 4), pair("brk", empty))}, simp(hw2, keep(while_rel))), letin, out_state, out_value)
  show by defs(apply(tr.runs_intro, {T}, {ok(T, empty)}, pu, rel), malloc.set_errno)
qed

// The layer's out_of_memory from S to T, its new memory V: an allocator
// step (V errno ENOMEM already), errno set (so unchanged)
theorem mp.top_oom(I, O, eo, S, V): S in univ(1) -> V in x86_64_linux.Vm -> S.fs_base in bits(64) -> app(eo, empty) = 52 ->
  fn_update(S, "vm", V) in univ(1) -> is_fun(fn_update(S, "vm", V)) -> "vm" in dom(fn_update(S, "vm", V)) ->
  malloc.step_ok(I, O, S, fn_update(S, "vm", V), malloc.errno_bytes(eo, S)) -> mallocng_specs.errno_is(V, S.fs_base, x86_64_linux.ENOMEM) ->
  runs(malloc.out_of_memory(I, O, eo, S), S, ok(fn_update(S, "vm", V), 0))
proof
  assume su hv fsb he tu tf td hst hen
  let T := fn_update(S, "vm", V)
  have tv: T.vm = V by simp()
  have tfs: T.fs_base = S.fs_base by simp()
  have se := apply(mp.top_seterr[eo := eo, T := T], tu, rewrite(sym(tv), hv), tf, td, rewrite(sym(tfs), fsb), he, rewrite(sym(tfs), rewrite(sym(tv), hen)))
  have pa: pair(S, ok(T, empty)) in univ(1) by simp(su, tu)
  have ra: any_rel(x2. x2 in x86_64_linux.Vm && malloc.step_ok(I, O, S, fn_update(S, "vm", x2), malloc.errno_bytes(eo, S)),
      x2. letin(fn_update(S, "vm", x2), x3. ok(T, empty) = ok(x3, empty))) by spec_ret({V}, hv, hst)
  have as: runs(malloc.allocator_step(I, O, S, malloc.errno_bytes(eo, S)), S, ok(T, empty)) by defs(apply(tr.runs_intro, {S}, {ok(T, empty)}, pa, ra), malloc.allocator_step)
  have b2 := mp(all_elim(gc.bind_ok[p := malloc.set_errno(eo, x86_64_linux.ENOMEM), k := x4 x5. ok(T, 0) = ok(x4, 0), x := x4 x5. ok(T, 0) = exc(x4, x5), d := x4. ok(T, 0) = diverge(x4)],
    {T}, {T}, {empty}), se, refl({ok(T, 0)}))
  have b1 := mp(all_elim(gc.bind_ok[p := malloc.allocator_step(I, O, S, malloc.errno_bytes(eo, S)),
      k := x2 x3. bind_rel(malloc.set_errno(eo, x86_64_linux.ENOMEM), x2, x4 x5. ok(T, 0) = ok(x4, 0), x4 x5. ok(T, 0) = exc(x4, x5), x4. ok(T, 0) = diverge(x4)),
      x := x2 x3. ok(T, 0) = exc(x2, x3), d := x2. ok(T, 0) = diverge(x2)], {S}, {T}, {empty}), as, b2)
  have pu: pair(S, ok(T, 0)) in univ(1) by simp(su, tu)
  show by defs(apply(tr.runs_intro, {S}, {ok(T, 0)}, pu, b1), malloc.out_of_memory)
qed

// ... so the layer's malloc may return 0 there (out of memory: `any?`'s
// failure)
theorem mp.top_mfail(I, O, eo, b, cd, st, n, S, T): pair(S, ok(T, 0)) in univ(1) -> runs(malloc.out_of_memory(I, O, eo, S), S, ok(T, 0)) ->
  runs(malloc.malloc(I, O, eo, b, cd, st, n), S, ok(T, 0))
proof
  assume pu ho
  let W := exc(pair(T, empty), pair("ret", 0))
  have bo := mp(all_elim(gc.bind_ok[p := malloc.out_of_memory(I, O, eo, S), k := x4 x5. W = exc(pair(x4, empty), pair("ret", x5)),
      x := x4 x5. W = exc(pair(x4, empty), pair("raise", x5)), d := x4. W = diverge(x4)], {S}, {T}, {0}), ho, refl({W}))
  show by spec_ret({W}, pu, bo)
qed

// ... its block p of n bytes: a place and an allocator step for it
theorem mp.top_mok(I, O, eo, b, cd, st, n, S, p, V): n in omega -> p in bits(64) -> !(p = 0) -> int_mod(p, 16) = 0 -> malloc.fresh_block(O, S, p, n) ->
  V in x86_64_linux.Vm -> malloc.step_ok(I, O, S, fn_update(fn_update(S, "blocks", malloc.set_block(S.blocks, p, some(n))), "vm", V), malloc.errno_bytes(eo, S)) ->
  pair(S, ok(fn_update(fn_update(S, "blocks", malloc.set_block(S.blocks, p, some(n))), "vm", V), p)) in univ(1) ->
  runs(malloc.malloc(I, O, eo, b, cd, st, n), S, ok(fn_update(fn_update(S, "blocks", malloc.set_block(S.blocks, p, some(n))), "vm", V), p))
proof
  assume hn hp hp0 hal hfr hv hst pu
  let K := ok(pair(S, empty), empty)
  have nn: int_le(n, n) by arith(hn)
  show by spec_ret({K}, {K}, {n}, {n}, {K}, {p}, {p}, {K}, {V}, {V}, hn, nn, hp, hp0, hal, hfr, hv, hst, pu)
qed

// ... anything where its precondition fails
theorem mp.top_many(I, O, eo, b, cd, st, n, S, o): pair(S, o) in univ(1) ->
  !((S in I && malloc.errno_ok(eo, S)) && malloc.world_ok(b, cd, st, S)) -> runs(malloc.malloc(I, O, eo, b, cd, st, n), S, o)
proof
  assume pu hn
  show by spec_ret(pu, hn)
qed

// (a run of p, an outcome: p bound to its outcome as it is)
theorem mp.bind_self(p, s, o): runs(p, s, o) -> (ex x v. o = ok(x, v)) || (ex x e. o = exc(x, e)) || (ex t. o = diverge(t)) ->
  bind_rel(p, s, x3 x4. o = ok(x3, x4), x3 x4. o = exc(x3, x4), x3. o = diverge(x3))
proof
  assume hr hs
  have c1: (ex x v. o = ok(x, v)) -> bind_rel(p, s, x3 x4. o = ok(x3, x4), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) proof
    assume e
    obtain x v, eo from e
    show := mp(all_elim(gc.bind_ok[p := p, k := x3 x4. o = ok(x3, x4), x := x3 x4. o = exc(x3, x4), d := x3. o = diverge(x3)], {s}, {x}, {v}), rewrite(eo, hr), eo)
  qed
  have c2: (ex x e. o = exc(x, e)) -> bind_rel(p, s, x3 x4. o = ok(x3, x4), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) proof
    assume e
    obtain x ee, eo from e
    show := mp(all_elim(gc.bind_exc[p := p, k := x3 x4. o = ok(x3, x4), x := x3 x4. o = exc(x3, x4), d := x3. o = diverge(x3)], {s}, {x}, {ee}), rewrite(eo, hr), eo)
  qed
  have c3: (ex t. o = diverge(t)) -> bind_rel(p, s, x3 x4. o = ok(x3, x4), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) proof
    assume e
    obtain t, eo from e
    show := mp(all_elim(gc.bind_div[p := p, k := x3 x4. o = ok(x3, x4), x := x3 x4. o = exc(x3, x4), d := x3. o = diverge(x3)], {s}, {t}), rewrite(eo, hr), eo)
  qed
  show by taut(hs, c1, c2, c3)
qed

// the layer's malloc as a C function value: its run, the argument's
theorem mp.top_mfun(I, O, eo, b, cd, st, regs, S, o): regs in abi.ARGS -> pair(S, o) in univ(1) ->
  (ex x v. o = ok(x, v)) || (ex x e. o = exc(x, e)) || (ex t. o = diverge(t)) ->
  runs(malloc.malloc(I, O, eo, b, cd, st, regs[0]), S, o) -> runs(malloc.malloc_fun(I, O, eo, b, cd, st)[regs], S, o)
proof
  assume hr pu hs hm
  have br := apply(mp.bind_self, hm, hs)
  have r := mp(all_elim(tr.runs_intro[r := x1 x2. bind_rel(malloc.malloc(I, O, eo, b, cd, st, regs[0]), x1,
    x3 x4. x2 = ok(x3, x4), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))], {S}, {o}), pu, br)
  show by defs(rewrite(sym(mp(app_fn_build[d := abi.ARGS, v := x0. mkprog(x1 x2. bind_rel(malloc.malloc(I, O, eo, b, cd, st, x0[0]), x1,
    x3 x4. x2 = ok(x3, x4), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), a := regs], hr)), r), malloc.malloc_fun)
qed

// a single-result spec widened (rdx any): its return with any second word,
// its exceptions and divergences as they are
abbrev mp.WR(F, regs, x1, x2) := bind_rel(F[regs], x1, x3 x4. any_rel(x5. x5 in bits(64), x5. x2 = ok(x3, pair(x4, x5))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))

theorem mp.top_wide(G, F, regs, S, o2): regs in abi.ARGS -> pair(S, o2) in univ(1) -> mp.WR(F, regs, S, o2) -> runs(abi.wide(G, F)[regs], S, o2)
proof
  assume hr pu hw
  have r := mp(all_elim(tr.runs_intro[r := x1 x2. mp.WR(F, regs, x1, x2)], {S}, {o2}), pu, hw)
  show by defs(rewrite(sym(mp(app_fn_build[d := abi.ARGS, v := x0. mkprog(x1 x2. mp.WR(F, x0, x1, x2)), a := regs], hr)), r), abi.wide)
qed

theorem mp.wr_ok(F, regs, S, x, r, y): y in bits(64) -> runs(F[regs], S, ok(x, r)) -> mp.WR(F, regs, S, ok(x, pair(r, y)))
proof
  assume hy hr
  have k: any_rel(x5. x5 in bits(64), x5. ok(x, pair(r, y)) = ok(x, pair(r, x5))) by spec_ret({y}, hy)
  show := mp(all_elim(gc.bind_ok[p := F[regs], k := x3 x4. any_rel(x5. x5 in bits(64), x5. ok(x, pair(r, y)) = ok(x3, pair(x4, x5))),
    x := x3 x4. ok(x, pair(r, y)) = exc(x3, x4), d := x3. ok(x, pair(r, y)) = diverge(x3)], {S}, {x}, {r}), hr, k)
qed

theorem mp.wr_exc(F, regs, S, x, e): runs(F[regs], S, exc(x, e)) -> mp.WR(F, regs, S, exc(x, e))
proof
  assume hr
  show := mp(all_elim(gc.bind_exc[p := F[regs], k := x3 x4. any_rel(x5. x5 in bits(64), x5. exc(x, e) = ok(x3, pair(x4, x5))),
    x := x3 x4. exc(x, e) = exc(x3, x4), d := x3. exc(x, e) = diverge(x3)], {S}, {x}, {e}), hr, refl({exc(x, e)}))
qed

theorem mp.wr_div(F, regs, S, t): runs(F[regs], S, diverge(t)) -> mp.WR(F, regs, S, diverge(t))
proof
  assume hr
  show := mp(all_elim(gc.bind_div[p := F[regs], k := x3 x4. any_rel(x5. x5 in bits(64), x5. diverge(t) = ok(x3, pair(x4, x5))),
    x := x3 x4. diverge(t) = exc(x3, x4), d := x3. diverge(t) = diverge(x3)], {S}, {t}), hr, refl({diverge(t)}))
qed
