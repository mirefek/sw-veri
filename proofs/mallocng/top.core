// The top level: mallocng's malloc and free by the malloc layer's specs
// (layers/malloc.sl), from their purpose specs (layers/mallocng_specs.sl).
// The malloc layer's state (the world, the live blocks) is the purpose
// specs' without the abstract state A: a state of the layer's invariant
// (`mallocng.inv`) has some A it represents (`mallocng.rep`), and that A
// meets the purpose specs' precondition.

// ----------------------------------------------------------------------
//  At a call: the layer's precondition and rep give the purpose spec's

// errno's i-th byte: one of the layer's errno bytes (errno at the thread
// pointer's 0x34)
theorem mp.top_ebyte(eo, S, i): S.fs_base in bits(64) -> int_le(int_add(S.fs_base, 56), int_pow(2, 64)) -> app(eo, empty) = 52 ->
  i in omega -> int_lt(i, 4) -> int_add(int_add(S.fs_base, 52), i) in malloc.errno_bytes(eo, S)
proof
  assume fsb fsl he hi hil
  show by defs(sel(defs(arith(fsb, fsl, hi, hil, he), bits_add, bits_of_int, pow2)), malloc.errno_bytes, malloc.range)
qed

theorem mp.top_pre(c, A, S, eo, b, cd, st): S.fs_base in bits(64) -> mallocng.rep(c, A, S) -> app(eo, empty) = 52 ->
  malloc.errno_ok(eo, S) -> malloc.world_ok(b, cd, st, S) ->
  hin: mallocng.holds_in(c, A, S.vm, S.objs, S.blocks) && thread: abi.thread_ok(S.vm, S.fs_base) && tls: mallocng_specs.tls_apart(c, A, S.fs_base) &&
  brk: abi.brk_start_ok(S.vm) && errno: mallocng_specs.errno_ok(S.vm, S.objs, S.fs_base) && apart: mallocng_specs.errno_apart(c, A, S.vm, S.fs_base)
proof
  assume fsb hr he heo hw
  have {hm = mem, rtl = tls, rer = errno, rca = canary, rax = aux} := expand(hr, mallocng.rep)
  have nst cb th _ bk _ _ := expand(hw, malloc.world_ok)
  // (the thread pointer below the task's end: errno's bytes too)
  have kp: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
  have ts: int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE) = 34359738367 by defs(simp(), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
  have r0 _ _ _ := expand(th, abi.thread_ok)
  have m0 _ := mp(all_elim(expand(r0, x86_64_linux.readable), {0}), simp(), simp())
  have t0 _ := expand(m0, x86_64_linux.mapped)
  have fsl: int_le(int_add(S.fs_base, 56), int_pow(2, 64)) by arith(t0, ts, kp, fsb)
  have ea: mallocng_specs.errno_at(S.fs_base) = int_add(S.fs_base, 52) by defs(arith(fsb, fsl), mallocng_specs.errno_at, bits_add, pow2)
  // errno's bytes: mapped read-write, not the stack's, the C world's
  have eb: all i. i in omega -> int_lt(i, 4) ->
      (x86_64_linux.mapped(S.vm, int_div(int_add(mallocng_specs.errno_at(S.fs_base), i), x86_64_linux.PAGE)) &&
       !(snd(S.vm.pages[int_div(int_add(mallocng_specs.errno_at(S.fs_base), i), x86_64_linux.PAGE)]).kind = 2)) &&
      snd(S.vm.pages[int_div(int_add(mallocng_specs.errno_at(S.fs_base), i), x86_64_linux.PAGE)]).prot.r &&
      snd(S.vm.pages[int_div(int_add(mallocng_specs.errno_at(S.fs_base), i), x86_64_linux.PAGE)]).prot.w &&
      int_add(mallocng_specs.errno_at(S.fs_base), i) in S.objs.c_bytes && !mallocng.in_ranges(int_add(mallocng_specs.errno_at(S.fs_base), i), mallocng.fp_ranges(c, A)) proof
    fix i
    assume hi hil
    let a := int_add(int_add(S.fs_base, 52), i)
    have ae: int_add(mallocng_specs.errno_at(S.fs_base), i) = a by simp(ea)
    have ao: a in omega by arith(fsb, hi)
    have rw := mp(all_elim(expand(heo, malloc.errno_ok), {a}), ao, apply(mp.top_ebyte[eo := eo, S := S, i := i], fsb, fsl, he, hi, hil))
    have mq pr pw := expand(rw, malloc.rw_mapped)
    have ml mn := expand(mq, x86_64_linux.mapped)
    have qs: int_div(a, x86_64_linux.PAGE) in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) by sel(taut((int_div(a, x86_64_linux.PAGE) in omega by arith(ao, kp)), ml))
    have nk := mp(all_elim(nst, {int_div(a, x86_64_linux.PAGE)}), qs, mn)
    have nc: !(a in abi.canary(S.fs_base)) proof
      assume w
      have w1 w2 := (int_le(int_add(S.fs_base, 40), a) && int_lt(a, int_add(S.fs_base, 48)) by taut(set_select_def[s := omega, p := x0. int_le(int_add(S.fs_base, 40), x0) && int_lt(x0, int_add(S.fs_base, 48)), z := a], expand(w, abi.canary)))
      show by arith(w2, hi)
    qed
    have inc: a in S.objs.c_bytes := rewrite(sym(cb), (a in set_select(omega, x0. !(x0 in abi.canary(S.fs_base))) by sel(taut(ao, nc))))
    have nr := mp(all_elim(rer, {i}), hi, hil)
    show by simp(ae, mq, nk, pr, pw, inc, nr)
  qed
  have ap: mallocng_specs.errno_apart(c, A, S.vm, S.fs_base) proof
    fix i
    assume hi hil
    have e1 e2 _ _ _ e6 := mp(all_elim(eb, {i}), hi, hil)
    show by taut(e1, e6)
  qed
  have uw: gimple.usable(S.vm, S.objs, mallocng_specs.errno_at(S.fs_base), 4, true) proof
    fix i
    assume hi hil
    have e1 e2 e3 e4 e5 _ := mp(all_elim(eb, {i}), hi, hil)
    show by simp(e1, e2, e4, e5)
  qed
  have ur: gimple.usable(S.vm, S.objs, mallocng_specs.errno_at(S.fs_base), 4, false) proof
    fix i
    assume hi hil
    have e1 e2 e3 e4 e5 _ := mp(all_elim(eb, {i}), hi, hil)
    show by simp(e1, e2, e3, e5)
  qed
  have eok: mallocng_specs.errno_ok(S.vm, S.objs, S.fs_base) by defs(taut(fsl, uw, th, ur), mallocng_specs.errno_ok)
  // the allocator's bytes and its reserve's pages: the C world's (none the canary's)
  have fs: mallocng.fp_shown(mallocng.fp_ranges(c, A), S.objs) proof
    fix a
    assume ao ir
    have nc: !(a in abi.canary(S.fs_base)) proof
      assume w
      have n1 _ := mp(all_elim(rca, {a}), ao, w)
      show by taut(n1, ir)
    qed
    show := rewrite(sym(cb), (a in set_select(omega, x0. !(x0 in abi.canary(S.fs_base))) by sel(taut(ao, nc))))
  qed
  have rs: int_lt(0, A.reserve_cnt) -> (all x0. x0 in omega -> int_le(int_div(A.reserve, x86_64_linux.PAGE), int_div(x0, x86_64_linux.PAGE)) &&
      int_lt(int_div(x0, x86_64_linux.PAGE), int_add(int_div(A.reserve, x86_64_linux.PAGE), A.reserve_cnt)) -> x0 in S.objs.c_bytes) proof
    assume c0
    fix a
    assume ao hq
    have nc: !(a in abi.canary(S.fs_base)) proof
      assume w
      have _ n2 := mp(all_elim(rca, {a}), ao, w)
      show by taut(n2, c0, hq)
    qed
    show := rewrite(sym(cb), (a in set_select(omega, x0. !(x0 in abi.canary(S.fs_base))) by sel(taut(ao, nc))))
  qed
  have sh: mallocng.shown_in(c, A, S.objs) by defs(taut(fs, rs, rax), mallocng.shown_in)
  have hin: mallocng.holds_in(c, A, S.vm, S.objs, S.blocks) by defs(taut(hm, sh), mallocng.holds_in)
  have tl: mallocng_specs.tls_apart(c, A, S.fs_base) by defs(rtl, mallocng_specs.tls_apart)
  show by taut(hin, th, tl, bk, eok, ap)
qed

// ----------------------------------------------------------------------
//  After a call: the new state's representation

// (a byte read-write in the machine's view: mapped read-write)
theorem mp.top_rw(vm, a): a in omega -> mallocng.m_rw(mallocng.mview(vm, mallocng.all_bytes()), a) -> malloc.rw_mapped(vm, a)
proof
  assume hao r
  have mm0 pr pw := expand(r, mallocng.m_rw)
  have mb mn := expand(mm0, mallocng.m_mapped)
  have p0 := apply(mp.pg_view[vm := vm, fp := mallocng.all_bytes(), a := a], hao, (a in mallocng.all_bytes() by defs(sel(taut(hao)), mallocng.all_bytes)))
  have mq: x86_64_linux.mapped(vm, int_div(a, x86_64_linux.PAGE)) by defs(taut(mb, rewrite(p0, mn)), x86_64_linux.mapped)
  show by defs(taut(mq, rewrite(p0, pr), rewrite(p0, pw)), malloc.rw_mapped)
qed

// (the live blocks of a state that holds: mapped read-write -- in their
// groups, which are)
theorem mp.top_live(c, A, V, b): A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) -> mallocng.holds_m(c, A, V, b) ->
  all q. q in bits(64) -> !(b[q] = none) -> (all x. x in omega -> int_le(q, x) && int_lt(x, int_add(q, snd(b[q]))) -> malloc.rw_mapped(V, x))
proof
  assume ha hb hm
  have {H = inv, hrw = rw} := expand(hm, mallocng.holds_m)
  fix q
  assume hq hn
  fix x
  assume ho hr
  have inr: x in malloc.range(q, snd(b[q])) by defs(sel(taut(ho, hr)), malloc.range)
  have ex: ex y. y in bits(64) && (!(b[y] = none) && x in malloc.range(y, snd(b[y]))) by ex_intro({q}, taut(hq, hn, inr))
  have l: x in malloc.live_of(b) by taut(apply(mp.live_def[b := b, a := x]), ho, ex)
  obtain g, hg hgr from apply(mp.live_grp, ha, hb, H, l)
  have {go = nat} := apply(mp.used_nat, ha, hg)
  have r1 _ := mp(all_elim(expand(hrw, mallocng.grp_rw), {g}, {x}), conj(go, ho), taut(hg, hgr, l))
  show := apply(mp.top_rw, ho, r1)
qed

// (the stack protector's word: mapped, apart from A -- so from A2, whose
// ranges are A's or memory unmapped before, and from A2's reserve's pages,
// whole pages of its ranges)
theorem mp.top_can(c, A, A2, V2, b2, vm, fs): c in mallocng.Cfg -> A2 in univ(1) -> A2 in mallocng.Abs -> mallocng.holds_m(c, A2, V2, b2) -> fs in bits(64) ->
  abi.canary_ok(vm, fs) -> mp.rng_grown(c, A2, A, vm) ->
  (all x0. x0 in omega -> x0 in abi.canary(fs) -> !mallocng.in_ranges(x0, mallocng.fp_ranges(c, A)) &&
     !((int_lt(0, A.reserve_cnt) && int_le(int_div(A.reserve, x86_64_linux.PAGE), int_div(x0, x86_64_linux.PAGE))) &&
       int_lt(int_div(x0, x86_64_linux.PAGE), int_add(int_div(A.reserve, x86_64_linux.PAGE), A.reserve_cnt)))) ->
  all x0. x0 in omega -> x0 in abi.canary(fs) -> !mallocng.in_ranges(x0, mallocng.fp_ranges(c, A2)) &&
    !((int_lt(0, A2.reserve_cnt) && int_le(int_div(A2.reserve, x86_64_linux.PAGE), int_div(x0, x86_64_linux.PAGE))) &&
      int_lt(int_div(x0, x86_64_linux.PAGE), int_add(int_div(A2.reserve, x86_64_linux.PAGE), A2.reserve_cnt)))
proof
  assume hc hu ha hm fsb hcn hg hca
  have kp: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
  have rd _ := expand(hcn, abi.canary_ok)
  fix a
  assume ao ac
  have a1 a2 := (int_le(int_add(fs, 40), a) && int_lt(a, int_add(fs, 48)) by taut(set_select_def[s := omega, p := x0. int_le(int_add(fs, 40), x0) && int_lt(x0, int_add(fs, 48)), z := a], expand(ac, abi.canary)))
  // (its page mapped)
  let j := int_sub(int_sub(a, fs), 40)
  have mj _ := mp(all_elim(expand(rd, x86_64_linux.readable), {j}), (j in omega by arith(a1)), (int_lt(j, 8) by arith(a2)))
  have eqa: int_add(int_add(fs, 40), j) = a by arith()
  have ma := rewrite(eqa, mj)
  have n0 _ := mp(all_elim(hca, {a}), ao, ac)
  have n1: !mallocng.in_ranges(a, mallocng.fp_ranges(c, A2)) proof
    assume ir
    show by taut(mp(all_elim(hg, {a}), ao, ir), n0, ma)
  qed
  // (A2's reserve: whole pages of its ranges)
  have n2: !((int_lt(0, A2.reserve_cnt) && int_le(int_div(A2.reserve, x86_64_linux.PAGE), int_div(a, x86_64_linux.PAGE))) &&
      int_lt(int_div(a, x86_64_linux.PAGE), int_add(int_div(A2.reserve, x86_64_linux.PAGE), A2.reserve_cnt))) proof
    assume w
    have w0 w1 w2 := w
    have {H = inv} := expand(hm, mallocng.holds_m)
    have {cok = ctx} := expand(H, mallocng.holds)
    have {k7 = avail_areas} := expand(cok, mallocng.ctx_ok)
    have _ ral := mp(k7, w0)
    have ro rco := (A2.reserve in omega && A2.reserve_cnt in omega by simp(ha))
    have r1: int_le(A2.reserve, a) by arith(ral, w1, kp, ro, ao)
    have r2: int_lt(a, int_add(A2.reserve, int_mul(4096, A2.reserve_cnt))) by arith(ral, w2, kp, ro, rco, ao)
    show by taut(n1, apply(mp.res_rng[c := c, A := A2, a := a], hc, hu, ha, r1, r2))
  qed
  show by taut(n1, n2)
qed

// (the thread pointer sound: below the task's end, errno 0x34 past it)
theorem mp.top_fsl(vm, fs): fs in bits(64) -> abi.thread_ok(vm, fs) ->
  fsl: int_le(int_add(fs, 56), int_pow(2, 64)) && ea: mallocng_specs.errno_at(fs) = int_add(fs, 52)
proof
  assume fsb th
  have kp: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
  have ts: int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE) = 34359738367 by defs(simp(), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
  have r0 _ _ _ := expand(th, abi.thread_ok)
  have m0 _ := mp(all_elim(expand(r0, x86_64_linux.readable), {0}), simp(), simp())
  have t0 _ := expand(m0, x86_64_linux.mapped)
  have fsl: int_le(int_add(fs, 56), int_pow(2, 64)) by arith(t0, ts, kp, fsb)
  have ea: mallocng_specs.errno_at(fs) = int_add(fs, 52) by defs(arith(fsb, fsl), mallocng_specs.errno_at, bits_add, pow2)
  show by taut(fsl, ea)
qed

// ----------------------------------------------------------------------
//  The world after a step as any call needs it (malloc.sl's world_ok)

// (the stack protector's word: as before -- none of the allocator's bytes)
theorem mp.canary_unt(c, A, b, V0, V1, objs, fs, e): fs in bits(64) -> abi.canary_ok(V0, fs) ->
  (all a. a in abi.canary(fs) -> !mallocng.in_ranges(a, mallocng.fp_ranges(c, A))) ->
  mallocng.untouched(c, A, b, V0, V1, objs, e) -> (all i. i in omega -> int_lt(i, 8) -> !(int_add(int_add(fs, 40), i) in e)) -> abi.canary_ok(V1, fs)
proof
  assume hfb hc0 hap hun he
  have r0 w0 := expand(hc0, abi.canary_ok)
  have u1 _ _ := expand(hun, mallocng.untouched)
  have same: all i. i in omega -> int_lt(i, 8) ->
      V1.pages[int_div(int_add(int_add(fs, 40), i), x86_64_linux.PAGE)] = V0.pages[int_div(int_add(int_add(fs, 40), i), x86_64_linux.PAGE)] proof
    fix i
    assume hi hil
    have mp1 _ := mp(all_elim(expand(r0, x86_64_linux.readable), {i}), hi, hil)
    have ao: int_add(int_add(fs, 40), i) in omega by arith(hfb, hi)
    have ic: int_add(int_add(fs, 40), i) in abi.canary(fs) by defs(sel(arith(hfb, hi, hil)), abi.canary)
    have nf: !(int_add(int_add(fs, 40), i) in mallocng.footprint(c, A, b)) proof
      assume f
      have _ ir := apply(mp.fp_owned[c := c, A := A, b := b, a := int_add(int_add(fs, 40), i)], f)
      show by taut(ir, mp(all_elim(hap, {int_add(int_add(fs, 40), i)}), ic))
    qed
    have _ pt := mp(all_elim(u1, {int_add(int_add(fs, 40), i)}), ao, taut(nf, mp(all_elim(he, {i}), hi, hil), mp1))
    show := pt
  qed
  have r1: all x0. x0 in omega -> int_lt(x0, 8) -> x86_64_linux.mapped(V1, int_div(int_add(int_add(fs, 40), x0), x86_64_linux.PAGE)) &&
      snd(V1.pages[int_div(int_add(int_add(fs, 40), x0), x86_64_linux.PAGE)]).prot.r proof
    fix i
    assume hi hil
    have m0 p0 := mp(all_elim(expand(r0, x86_64_linux.readable), {i}), hi, hil)
    have ep := mp(all_elim(same, {i}), hi, hil)
    have m1: x86_64_linux.mapped(V1, int_div(int_add(int_add(fs, 40), i), x86_64_linux.PAGE)) by defs(rewrite(sym(ep), expand(m0, x86_64_linux.mapped)), x86_64_linux.mapped)
    show by taut(m1, rewrite(sym(ep), p0))
  qed
  have w1: all x0. x0 in omega -> int_lt(x0, 8) -> snd(V1.pages[int_div(int_add(int_add(fs, 40), x0), x86_64_linux.PAGE)]).prot.w &&
      !abi.stack_page(V1, int_div(int_add(int_add(fs, 40), x0), x86_64_linux.PAGE)) proof
    fix i
    assume hi hil
    have q0 n0 := mp(all_elim(w0, {i}), hi, hil)
    have ep := mp(all_elim(same, {i}), hi, hil)
    have n1: !abi.stack_page(V1, int_div(int_add(int_add(fs, 40), i), x86_64_linux.PAGE)) by defs(rewrite(sym(ep), expand(n0, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
    show by taut(rewrite(sym(ep), q0), n1)
  qed
  show by defs(taut(r1, w1), abi.canary_ok, x86_64_linux.readable)
qed

// (a read-only segment's byte, as the invariant has it: the file's)
theorem mp.ro_img(c, A, vm, b, k, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) -> vm in x86_64_linux.Vm ->
  mallocng.holds_m(c, A, vm, b) -> k in omega -> int_lt(k, x86_64_linux.phnum(c.file)) -> x86_64_linux.is_load(c.file, k) -> !bit(x86_64_linux.segment(c.file, k).flags, 1) ->
  a in omega -> int_le(x86_64_linux.segment(c.file, k).vaddr, a) -> int_lt(a, int_add(x86_64_linux.segment(c.file, k).vaddr, x86_64_linux.segment(c.file, k).memsz)) ->
  vm.bytes[bits_of_int(64, a)] = ite(int_lt(a, int_add(x86_64_linux.segment(c.file, k).vaddr, x86_64_linux.segment(c.file, k).filesz)),
    c.file[int_add(x86_64_linux.segment(c.file, k).offset, int_sub(a, x86_64_linux.segment(c.file, k).vaddr))], 0) &&
  (x86_64_linux.last_on_page(c.file, k, int_div(a, x86_64_linux.PAGE)) ->
    vm.pages[int_div(a, x86_64_linux.PAGE)] = some(fn_update(fn_update(empty, "prot", x86_64_linux.seg_prot(x86_64_linux.segment(c.file, k))), "kind", 0)))
proof
  assume hc hu ha hb hv hh hk hkl hl hf hao h1 h2
  have ri := apply(mp.ro_at, hc, hk, hkl, hl, hf)
  have inr: mallocng.in_range(a, mallocng.ro_ranges(c.file)[k]) by defs(simp(ri, h1, h2), mallocng.in_range)
  have hd := apply(mp.ro_view[c := c, A := A, vm := vm, b := b, i := k, a := a], hc, hu, ha, hb, hh, hao, hk, hkl, inr)
  have {H = inv} := expand(hh, mallocng.holds_m)
  have {himg = image} := expand(H, mallocng.holds)
  have i1 _ _ := expand(himg, mallocng.image_ok)
  have rs := mp(all_elim(i1, {k}), hk, conj(hkl, hl))
  have b1 b2 := mp(expand(rs, mallocng.ro_segment_ok), hf)
  have e1 := mp(all_elim(b1, {a}), hao, conj(h1, h2))
  have vb: vm.bytes in fn_space(bits(64), bits(8)) by simp(expand(hv, x86_64_linux.Vm))
  have bv _ := apply(mp.b8_view[vm := vm, fp := mallocng.held(c, A, b), a := a], vb, hao, hd)
  have pv := apply(mp.pg_view[vm := vm, fp := mallocng.held(c, A, b), a := a], hao, hd)
  have p: x86_64_linux.last_on_page(c.file, k, int_div(a, x86_64_linux.PAGE)) ->
      vm.pages[int_div(a, x86_64_linux.PAGE)] = some(fn_update(fn_update(empty, "prot", x86_64_linux.seg_prot(x86_64_linux.segment(c.file, k))), "kind", 0)) proof
    assume hlp
    show := trans(sym(pv), mp(all_elim(b2, {a}), hao, conj(conj(h1, h2), hlp)))
  qed
  show by taut(trans(sym(bv), e1), p)
qed

// the program's code in a read-only segment k, its every page that
// segment's last (as exec maps it: its protection there)
abbrev mp.code_img(c, base, code, k) := k in omega && int_lt(k, x86_64_linux.phnum(c.file)) && x86_64_linux.is_load(c.file, k) &&
  !bit(x86_64_linux.segment(c.file, k).flags, 1) && base in omega &&
  (all i. i in omega -> int_lt(i, seq_len(code)) ->
     (int_le(x86_64_linux.segment(c.file, k).vaddr, int_add(base, i)) && int_lt(int_add(base, i), int_add(x86_64_linux.segment(c.file, k).vaddr, x86_64_linux.segment(c.file, k).memsz))) &&
     x86_64_linux.last_on_page(c.file, k, int_div(int_add(base, i), x86_64_linux.PAGE)) && int_lt(int_add(base, i), 18446744073709551616))

// (two states the invariant holds in: the code as loaded in both)
theorem mp.code_kept(c, A, A2, vm, vm2, b, b2, base, code, k): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  vm in x86_64_linux.Vm -> mallocng.holds_m(c, A, vm, b) -> A2 in univ(1) -> A2 in mallocng.Abs -> b2 in fn_space(bits(64), option(omega)) ->
  vm2 in x86_64_linux.Vm -> mallocng.holds_m(c, A2, vm2, b2) -> mp.code_img(c, base, code, k) -> abi.code_at(vm, base, code) -> abi.code_at(vm2, base, code)
proof
  assume hc hu ha hb hv hh hu2 ha2 hb2 hv2 hh2 hci hca
  have k0 k1 k2 k3 bo ci := hci
  unfold abi.code_at
  fix i
  assume hi hil
  have c0 := mp(all_elim(expand(hca, abi.code_at), {i}), hi, hil)
  have r1 r2 lp lt := mp(all_elim(ci, {i}), hi, hil)
  have ao: int_add(base, i) in omega by arith(bo, hi)
  have e1 p1 := apply(mp.ro_img[c := c, A := A, vm := vm, b := b, k := k, a := int_add(base, i)], hc, hu, ha, hb, hv, hh, k0, k1, k2, k3, ao, r1, r2)
  have e2 p2 := apply(mp.ro_img[c := c, A := A2, vm := vm2, b := b2, k := k, a := int_add(base, i)], hc, hu2, ha2, hb2, hv2, hh2, k0, k1, k2, k3, ao, r1, r2)
  have eb: vm2.bytes[bits_of_int(64, int_add(base, i))] = vm.bytes[bits_of_int(64, int_add(base, i))] := trans(e2, sym(e1))
  have ab: bits_of_int(64, int_add(base, i)) = int_add(base, i) by defs(arith(ao, lt), bits_of_int, pow2)
  have ep0: vm2.pages[int_div(int_add(base, i), x86_64_linux.PAGE)] = vm.pages[int_div(int_add(base, i), x86_64_linux.PAGE)] := trans(mp(p2, lp), sym(mp(p1, lp)))
  have ep: vm2.pages[x86_64_linux.page_of(bits_of_int(64, int_add(base, i)))] = vm.pages[x86_64_linux.page_of(bits_of_int(64, int_add(base, i)))]
    by defs(simp(ab, ep0), x86_64_linux.page_of)
  show by defs(rewrite(sym(ep), rewrite(sym(eb), expand(c0, x86_64_linux.fetchable, x86_64_linux.can_access, abi.stack_page, x86_64_linux.mapped))),
    x86_64_linux.fetchable, x86_64_linux.can_access, abi.stack_page, x86_64_linux.mapped)
qed

// A step of the allocator from S to T (T represented, the memory outside
// the allocator's untouched but E -- neither the thread's word nor the
// stack protector's --, the thread and the objects as before): the world
// as any call needs it, still
theorem mp.wok_kept(c, A, A2, S, T, objs, E, b, cd, st, k): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> A2 in univ(1) -> A2 in mallocng.Abs ->
  S.blocks in fn_space(bits(64), option(omega)) -> S.vm in x86_64_linux.Vm -> T.blocks in fn_space(bits(64), option(omega)) -> T.vm in x86_64_linux.Vm ->
  S.fs_base in bits(64) -> mallocng.rep(c, A, S) -> mallocng.rep(c, A2, T) -> malloc.world_ok(b, cd, st, S) ->
  mallocng.untouched(c, A, S.blocks, S.vm, T.vm, objs, E) ->
  (all i. i in omega -> int_lt(i, 8) -> !(int_add(S.fs_base, i) in E) && !(int_add(int_add(S.fs_base, 40), i) in E)) ->
  T.objs = S.objs -> T.fs_base = S.fs_base -> mp.code_img(c, app(b, empty), app(cd, empty), k) ->
  malloc.world_ok(b, cd, st, T)
proof
  assume hc hu ha hu2 ha2 hb hv hb2 hv2 fsb hr hr2 hw hun he hob hfs hci
  have nst cb th cn bs ld lv := expand(hw, malloc.world_ok)
  have _ _ bkk := expand(hun, mallocng.untouched)
  have bt bl bsk kd := expand(bkk, mallocng.bounds_kept)
  have {hm = mem, rtl = tls, rca = canary} := expand(hr, mallocng.rep)
  have {hm2 = mem} := expand(hr2, mallocng.rep)
  // (no stack page: none new)
  have n1: all x0. x0 in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) -> !(T.vm.pages[x0] = none) ->
      !(snd(T.vm.pages[x0]).kind = 2) proof
    fix q
    assume hq hn
    assume hk
    have qo ql := (q in omega && int_lt(q, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) by taut(unsel(hq)))
    have e := mp(all_elim(kd, {q}), qo, conj(conj(ql, hn), hk))
    have ns := mp(all_elim(nst, {q}), hq, rewrite(e, hn))
    show by taut(ns, rewrite(e, hk))
  qed
  have c2 := rewrite(sym(hfs), rewrite(sym(hob), cb))
  // (the thread's word, the stack protector's: none of the allocator's)
  have tla: mallocng_specs.tls_apart(c, A, S.fs_base) by defs(rtl, mallocng_specs.tls_apart)
  have et: all i. i in omega -> int_lt(i, 8) -> !(int_add(S.fs_base, i) in E) proof
    fix i
    assume hi hil
    have e1 _ := mp(all_elim(he, {i}), hi, hil)
    show := e1
  qed
  have ec: all i. i in omega -> int_lt(i, 8) -> !(int_add(int_add(S.fs_base, 40), i) in E) proof
    fix i
    assume hi hil
    have _ e2 := mp(all_elim(he, {i}), hi, hil)
    show := e2
  qed
  have th2 := rewrite(sym(hfs), apply(mp.tls_unt[c := c, A := A, b := S.blocks, V0 := S.vm, V1 := T.vm, objs := objs, fs := S.fs_base, e := E], fsb, th, tla, hun, et))
  have can: all a. a in abi.canary(S.fs_base) -> !mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) proof
    fix a
    assume h
    have ao: a in omega by taut(unsel(expand(h, abi.canary)))
    have r _ := mp(all_elim(rca, {a}), ao, h)
    show := r
  qed
  have cn2 := rewrite(sym(hfs), apply(mp.canary_unt[c := c, A := A, b := S.blocks, V0 := S.vm, V1 := T.vm, objs := objs, fs := S.fs_base, e := E], fsb, cn, can, hun, ec))
  have bs2: abi.brk_start_ok(T.vm) by defs(simp(expand(bs, abi.brk_start_ok), bsk), abi.brk_start_ok)
  // (the program: its code the image's, so as it was; its statics off the
  // stack's space, the same)
  have ca st0 := expand(ld, abi.loaded)
  have ca2 := apply(mp.code_kept[c := c, A := A, A2 := A2, vm := S.vm, vm2 := T.vm, b := S.blocks, b2 := T.blocks, base := app(b, empty), code := app(cd, empty), k := k],
    hc, hu, ha, hb, hv, hm, hu2, ha2, hb2, hv2, hm2, hci, ca)
  have fl: x86_64_linux.stack_floor(T.vm) = x86_64_linux.stack_floor(S.vm) by rsimp(x86_64_linux.stack_floor, bt, bl)
  have st2: all x0. x0 in omega -> x0 in app(st, empty) -> x86_64_linux.off_stack_space(T.vm, int_div(x0, x86_64_linux.PAGE), 1) proof
    fix a
    assume hao ha3
    have o := mp(all_elim(st0, {a}), hao, ha3)
    show by defs(rewrite(sym(fl), rewrite(sym(bt), expand(o, x86_64_linux.off_stack_space))), x86_64_linux.off_stack_space)
  qed
  have ld2: abi.loaded(T.vm, app(b, empty), app(cd, empty), app(st, empty)) by defs(taut(ca2, st2), abi.loaded)
  // (the callers' objects: the same, in the same space)
  have lv2: all x0. x0 in omega -> x0 in T.objs.live -> int_le(x86_64_linux.stack_floor(T.vm), x0) && int_lt(x0, T.vm.stack_top) proof
    fix a
    assume hao hl
    have l1 l2 := mp(all_elim(lv, {a}), hao, rewrite(hob, hl))
    show by taut(rewrite(sym(fl), l1), rewrite(sym(bt), l2))
  qed
  show by defs(taut(n1, c2, th2, cn2, bs2, ld2, lv2), malloc.world_ok)
qed

// (errno's bytes: neither the thread's word nor the stack protector's)
theorem mp.errno_off(fs): all i. i in omega -> int_lt(i, 8) -> !(int_add(fs, i) in mp.errno(fs)) && !(int_add(int_add(fs, 40), i) in mp.errno(fs))
proof
  fix i
  assume hi hil
  have c1: !(int_add(fs, i) in mp.errno(fs)) proof
    assume w
    have _ w1 _ := (int_add(fs, i) in omega && int_le(int_add(fs, 52), int_add(fs, i)) && int_lt(int_add(fs, i), int_add(fs, 56))
      by taut(set_select_def[s := omega, p := x. int_le(int_add(fs, 52), x) && int_lt(x, int_add(fs, 56)), z := int_add(fs, i)], w))
    show by arith(w1, hil)
  qed
  have c2: !(int_add(int_add(fs, 40), i) in mp.errno(fs)) proof
    assume w
    have _ w1 _ := (int_add(int_add(fs, 40), i) in omega && int_le(int_add(fs, 52), int_add(int_add(fs, 40), i)) && int_lt(int_add(int_add(fs, 40), i), int_add(fs, 56))
      by taut(set_select_def[s := omega, p := x. int_le(int_add(fs, 52), x) && int_lt(x, int_add(fs, 56)), z := int_add(int_add(fs, 40), i)], w))
    show by arith(w1, hil)
  qed
  show by taut(c1, c2)
qed

// (a block of size n made at p: the blocks still a map to sizes)
theorem mp.sb_btype(b, p, n): b in fn_space(bits(64), option(omega)) -> n in omega -> malloc.set_block(b, p, some(n)) in fn_space(bits(64), option(omega))
proof
  assume hb hn
  have r1: some(n) in set_image(omega, x0. some(x0)) by taut(set_image_def[s := omega, f := x0. some(x0), y := some(n)],
    (ex x0. x0 in omega && some(x0) = some(n) by ex_intro({n}, taut(hn, refl({some(n)})))))
  have sn: some(n) in option(omega) by defs(simp(r1), option)
  have vq: all q. q in bits(64) -> ite(q = p, some(n), b[q]) in option(omega) proof
    fix q
    assume hq
    have bq := mp(fn_space_app[a := bits(64), b := option(omega), f := b, x := q], hb, hq)
    have c1: q = p -> ite(q = p, some(n), b[q]) in option(omega) proof
      assume e
      show by simp(e, sn)
    qed
    have c2: !(q = p) -> ite(q = p, some(n), b[q]) in option(omega) proof
      assume e
      show by simp(e, bq)
    qed
    show by taut(c1, c2)
  qed
  show by defs(mp(fn_build_space[d := bits(64), v := q. ite(q = p, some(n), b[q]), b := option(omega)], vq), malloc.set_block)
qed

// (malloc(0)'s block at p: its place, the byte p, the allocator's -- in
// p's slot, no live block's, neither reserved nor taken)
theorem mp.top_zbyte(c, A3, V3, B, p): c in mallocng.Cfg -> A3 in univ(1) -> A3 in mallocng.Abs -> B in fn_space(bits(64), option(omega)) -> p in bits(64) ->
  B[p] = none -> mallocng.holds_m(c, A3, V3, malloc.set_block(B, p, some(0))) -> mallocng.no_reserved(A3) -> seq_len(A3.taken) = 0 ->
  p in mallocng.footprint(c, A3, malloc.set_block(B, p, some(0)))
proof
  assume hc hu ha hb hp hbn hm nr tk
  let B2 := malloc.set_block(B, p, some(0))
  have b2t := apply(mp.sb_btype[b := B, p := p, n := 0], hb, simp())
  have {H = inv} := expand(hm, mallocng.holds_m)
  have {huo = used, bok = in_slots, bwf = wf} := expand(H, mallocng.holds)
  have b2p: B2[p] = some(0) by defs(simp(hp), malloc.set_block)
  have po: p in omega by arith(hp)
  // (its slot)
  obtain k i, hk hi hkl hil hs from mp(all_elim(expand(bok, mallocng.blocks_ok), {p}), hp, (!(B2[p] = none) by simp(b2p)))
  let g := A3.used[k]
  have iu: mallocng.is_used(A3, g) by defs(ex_intro({k}, taut(hk, hkl, refl({g}))), mallocng.is_used)
  have {go = nat} := apply(mp.used_nat, ha, iu)
  have {ins = inslot} := apply(mp.blk_frame[c := c, A := A3, M := mallocng.mview(V3, mallocng.held(c, A3, B2)), b := B2, brk := V3.brk, h := g, j := i, q := p],
    ha, b2t, H, iu, hi, hil, hs, po)
  have gok := apply(mp.used_group, huo, iu)
  have ir := apply(mp.slot_in_group[A := A3, M := mallocng.mview(V3, mallocng.held(c, A3, B2)), b := B2, g := g, i := i, a := p], ha, go, hi, po, gok, hil, ins)
  have rr := apply(mp.used_rng, hc, hu, ha, iu, ir)
  // (no live block's: the blocks' places apart)
  have nl: !(p in malloc.live_of(B2)) proof
    assume l
    have l2 := (p in malloc.live_of(B) || (p in omega && int_le(p, p) && int_lt(p, int_add(p, 0))) by taut(apply(mp.live_new[b := B, p := p, n := 0, a := p], hp, hbn), l))
    have l3: p in malloc.live_of(B) by taut(l2, (!int_lt(p, int_add(p, 0)) by arith()))
    have _ ex := (p in omega && (ex q. q in bits(64) && (!(B[q] = none) && p in malloc.range(q, snd(B[q])))) by taut(apply(mp.live_def[b := B, a := p]), l3))
    obtain q, hq hqn hqr from ex
    have qp: !(q = p) proof
      assume e
      show by taut(hqn, rewrite(sym(e), hbn))
    qed
    have bq: B2[q] = B[q] by defs(simp(hq, qp), malloc.set_block)
    have _ _ dj := expand(mp(all_elim(expand(bwf, malloc.blocks_wf), {p}), hp, (!(B2[p] = none) by simp(b2p))), malloc.block_wf)
    have d := mp(all_elim(dj, {q}), hq, conj(qp, (!(B2[q] = none) by simp(bq, hqn))))
    have q1 q2 := (int_le(q, p) && int_lt(p, int_add(q, snd(B[q]))) by taut(set_select_def[s := omega, p := x0. int_le(q, x0) && int_lt(x0, int_add(q, snd(B[q]))), z := p], expand(hqr, malloc.range)))
    have _ sq := apply(mp.opt_nat[o := B[q]], mp(fn_space_app[a := bits(64), b := option(omega), f := B, x := q], hb, hq), hqn)
    have inp: p in malloc.range(p, malloc.extent(snd(B2[p]))) by defs(sel(simp(po, b2p)), malloc.range, malloc.extent)
    have ext: int_le(snd(B[q]), malloc.extent(snd(B[q]))) proof
      have c0: snd(B[q]) = 0 -> int_le(snd(B[q]), malloc.extent(snd(B[q]))) proof
        assume e
        show by defs(simp(e), malloc.extent)
      qed
      have c1: !(snd(B[q]) = 0) -> int_le(snd(B[q]), malloc.extent(snd(B[q]))) proof
        assume e
        show by defs(simp(e), malloc.extent)
      qed
      show by taut(c0, c1)
    qed
    have inq: p in malloc.range(q, malloc.extent(snd(B2[q]))) by defs(sel(arith(po, q1, q2, sq, ext, (snd(B2[q]) = snd(B[q]) by simp(bq)))), malloc.range)
    show by taut(mp(all_elim(expand(d, malloc.disjoint), {p}), po), inp, inq)
  qed
  have nres := apply(mp.nores[A := A3, a := p], nr)
  have nt: !mallocng.in_taken(A3, p) proof
    assume w
    obtain kk, hkk hkkl _ _ from expand(w, mallocng.in_taken)
    show by arith(hkk, hkkl, tk)
  qed
  show by taut(apply(mp.fp_def[c := c, A := A3, b := B2, a := p]), po, rr, nl, nres, nt)
qed

// After malloc's block p of n bytes (`mp.mi_blk`, from A at S): the new
// state represented by A3 (rep), p 16-aligned (the blocks' places), and
// its place -- n bytes, or the byte p for malloc(0) -- the allocator's
// before or unmapped
theorem mp.top_mblk(c, A, S, n, A3, V3, p): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> S.blocks in fn_space(bits(64), option(omega)) ->
  S.fs_base in bits(64) -> n in omega -> mallocng.rep(c, A, S) -> abi.thread_ok(S.vm, S.fs_base) -> abi.canary_ok(S.vm, S.fs_base) ->
  mallocng_specs.errno_apart(c, A, S.vm, S.fs_base) -> mp.mi_blk(c, A, n, S.blocks, S, A3, V3, p) ->
  rep: mallocng.rep(c, A3, fn_update(fn_update(S, "blocks", malloc.set_block(S.blocks, p, some(n))), "vm", V3)) &&
  align: int_mod(p, 16) = 0 &&
  ext: (all a. a in omega -> a in malloc.range(p, malloc.extent(n)) ->
     a in mallocng.footprint(c, A, S.blocks) || (!x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) && !mallocng.in_stack_space(S.vm, a)))
proof
  assume hc hu ha hb fsb hn hr hth hcn hea hblk
  let B := S.blocks
  let B2 := malloc.set_block(B, p, some(n))
  have {hm = mem, rtl = tls, rca = canary} := expand(hr, mallocng.rep)
  have a3a a3u nr3 tk3 v3v pb pnz bn hm3 hsh3 hun hfp hbr := hblk
  have b2t := apply(mp.sb_btype[b := B, p := p, n := n], hb, hn)
  have {fsl = fsl, ea = ea} := apply(mp.top_fsl, fsb, hth)
  // A3's ranges: A's or memory unmapped before
  have {f = fp, l = live} := apply(mp.has_rng, hc, hu, ha, hb, hm)
  have gfp: all a. a in omega -> a in mallocng.footprint(c, A3, B2) ->
      mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) || (!x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) && !mallocng.in_stack_space(S.vm, a)) proof
    fix a
    assume ao h
    show by taut(mp(all_elim(hfp, {a}), ao, h), all_elim(f, {a}))
  qed
  have grs: all a. a in omega -> mallocng.in_reserved(A3, a) ->
      mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) || (!x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) && !mallocng.in_stack_space(S.vm, a)) proof
    fix a
    assume _ h
    show by taut(h, apply(mp.nores[A := A3, a := a], nr3))
  qed
  have gtk: all a. a in omega -> mallocng.in_taken(A3, a) ->
      mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) || (!x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) && !mallocng.in_stack_space(S.vm, a)) proof
    fix a
    assume _ w
    obtain kk, hkk hkkl _ _ from expand(w, mallocng.in_taken)
    have f0: false by arith(hkk, hkkl, tk3)
    show by taut(f0)
  qed
  have glv: all a. a in omega -> a in malloc.live_of(B2) ->
      mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) || (!x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) && !mallocng.in_stack_space(S.vm, a)) proof
    fix a
    assume ao h
    have l2 := (a in malloc.live_of(B) || (a in omega && int_le(p, a) && int_lt(a, int_add(p, n))) by taut(apply(mp.live_new[b := B, p := p, n := n, a := a], pb, bn), h))
    have c1: (a in omega && int_le(p, a) && int_lt(a, int_add(p, n))) ->
        mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) || (!x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) && !mallocng.in_stack_space(S.vm, a)) proof
      assume w
      have _ w1 w2 := w
      show by taut(mp(all_elim(hbr, {a}), ao, w1, w2), all_elim(f, {a}))
    qed
    show by taut(l2, all_elim(l, {a}), c1)
  qed
  have grown := apply(mp.rng_grow[c := c, A := A, A2 := A3, b2 := B2, vm := S.vm], gfp, grs, gtk, glv)
  // rep's parts for A3
  have tl3 := apply(mp.tls_grow[c := c, A := A, A2 := A3, vm := S.vm, fs := S.fs_base], fsb, hth, (mallocng_specs.tls_apart(c, A, S.fs_base) by defs(rtl, mallocng_specs.tls_apart)), grown)
  have er3: all x0. x0 in omega -> int_lt(x0, 4) -> !mallocng.in_ranges(int_add(int_add(S.fs_base, 52), x0), mallocng.fp_ranges(c, A3)) proof
    fix i
    assume hi hil
    have n0 m0 := rewrite(ea, mp(all_elim(expand(hea, mallocng_specs.errno_apart), {i}), hi, hil))
    assume ir
    show by taut(mp(all_elim(grown, {int_add(int_add(S.fs_base, 52), i)}), (int_add(int_add(S.fs_base, 52), i) in omega by arith(fsb, hi)), ir), n0, m0)
  qed
  have ca3 := apply(mp.top_can[c := c, A := A, A2 := A3, V2 := V3, b2 := B2, vm := S.vm, fs := S.fs_base], hc, a3u, a3a, hm3, fsb, hcn, grown, rca)
  have lv3 := apply(mp.top_live[c := c, A := A3, V := V3, b := B2], a3a, b2t, hm3)
  let T := fn_update(fn_update(S, "blocks", B2), "vm", V3)
  have tm: mallocng.holds_m(c, A3, T.vm, T.blocks) by simp(hm3, keep(mallocng.holds_m))
  have tl: malloc.live_rw(T) by defs(simp(lv3), malloc.live_rw)
  have tt: all x0. x0 in omega -> int_lt(x0, 8) -> !mallocng.in_ranges(int_add(T.fs_base, x0), mallocng.fp_ranges(c, A3)) by simp(expand(tl3, mallocng_specs.tls_apart))
  have te: all x0. x0 in omega -> int_lt(x0, 4) -> !mallocng.in_ranges(int_add(int_add(T.fs_base, 52), x0), mallocng.fp_ranges(c, A3)) by simp(er3)
  have tc: all x0. x0 in omega -> x0 in abi.canary(T.fs_base) -> !mallocng.in_ranges(x0, mallocng.fp_ranges(c, A3)) &&
      !((int_lt(0, A3.reserve_cnt) && int_le(int_div(A3.reserve, x86_64_linux.PAGE), int_div(x0, x86_64_linux.PAGE))) &&
        int_lt(int_div(x0, x86_64_linux.PAGE), int_add(int_div(A3.reserve, x86_64_linux.PAGE), A3.reserve_cnt))) by simp(ca3)
  have {ax3 = aux} := expand(hsh3, mallocng.shown_in)
  have tx: mallocng.aux_live(A3, T.objs) by simp(ax3, keep(mallocng.aux_live))
  have rep3: mallocng.rep(c, A3, T) by defs(taut(tm, nr3, tk3, tl, tt, te, tc, tx), mallocng.rep)
  // p 16-aligned: the blocks' places
  have {H3 = inv} := expand(hm3, mallocng.holds_m)
  have {bwf = wf} := expand(H3, mallocng.holds)
  have b2p: B2[p] = some(n) by defs(simp(pb), malloc.set_block)
  have _ al _ := expand(mp(all_elim(expand(bwf, malloc.blocks_wf), {p}), pb, (!(B2[p] = none) by simp(b2p))), malloc.block_wf)
  // its place: the block's bytes, or for malloc(0) the byte p
  have ext: all a. a in omega -> a in malloc.range(p, malloc.extent(n)) ->
      a in mallocng.footprint(c, A, B) || (!x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) && !mallocng.in_stack_space(S.vm, a)) proof
    fix a
    assume ao h
    have r1 r2 := (int_le(p, a) && int_lt(a, int_add(p, malloc.extent(n))) by taut(set_select_def[s := omega, p := x0. int_le(p, x0) && int_lt(x0, int_add(p, malloc.extent(n))), z := a], expand(h, malloc.range)))
    have z0: n = 0 -> a in mallocng.footprint(c, A, B) || (!x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) && !mallocng.in_stack_space(S.vm, a)) proof
      assume e
      have ap: a = p by defs(arith(r1, rewrite(e, r2)), malloc.extent)
      have fz := apply(mp.top_zbyte[c := c, A3 := A3, V3 := V3, B := B, p := p], hc, a3u, a3a, hb, pb, bn, rewrite(e, hm3), nr3, tk3)
      show := rewrite(sym(ap), mp(all_elim(hfp, {p}), (p in omega by arith(pb)), rewrite(sym(e), fz)))
    qed
    have z1: !(n = 0) -> a in mallocng.footprint(c, A, B) || (!x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) && !mallocng.in_stack_space(S.vm, a)) proof
      assume e
      have en: malloc.extent(n) = n by defs(simp(e), malloc.extent)
      have r3: int_lt(a, int_add(p, n)) := rewrite(en, r2)
      show := mp(all_elim(hbr, {a}), ao, r1, r3)
    qed
    show by taut(z0, z1)
  qed
  show by taut(rep3, al, ext)
qed

// After malloc's failure (`mp.mi_zero`, from A at S): the new memory
// represented by A2, the live blocks as they were
theorem mp.top_mzero(c, A, S, A2, V2): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> S.blocks in fn_space(bits(64), option(omega)) ->
  S.fs_base in bits(64) -> mallocng.rep(c, A, S) -> abi.thread_ok(S.vm, S.fs_base) -> abi.canary_ok(S.vm, S.fs_base) ->
  mallocng_specs.errno_apart(c, A, S.vm, S.fs_base) -> mp.mi_zero(c, A, S.blocks, S, A2, V2) ->
  mallocng.rep(c, A2, fn_update(S, "vm", V2))
proof
  assume hc hu ha hb fsb hr hth hcn hea hz
  let B := S.blocks
  have {hm = mem, rtl = tls, rca = canary} := expand(hr, mallocng.rep)
  have a2a a2u nr2 tk2 v2v hm2 hsh2 hun hfp _ := hz
  have {fsl = fsl, ea = ea} := apply(mp.top_fsl, fsb, hth)
  have {f = fp, l = live} := apply(mp.has_rng, hc, hu, ha, hb, hm)
  have gfp: all a. a in omega -> a in mallocng.footprint(c, A2, B) ->
      mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) || (!x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) && !mallocng.in_stack_space(S.vm, a)) proof
    fix a
    assume ao h
    show by taut(mp(all_elim(hfp, {a}), ao, h), all_elim(f, {a}))
  qed
  have grs: all a. a in omega -> mallocng.in_reserved(A2, a) ->
      mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) || (!x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) && !mallocng.in_stack_space(S.vm, a)) proof
    fix a
    assume _ h
    show by taut(h, apply(mp.nores[A := A2, a := a], nr2))
  qed
  have gtk: all a. a in omega -> mallocng.in_taken(A2, a) ->
      mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) || (!x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) && !mallocng.in_stack_space(S.vm, a)) proof
    fix a
    assume _ w
    obtain kk, hkk hkkl _ _ from expand(w, mallocng.in_taken)
    have f0: false by arith(hkk, hkkl, tk2)
    show by taut(f0)
  qed
  have glv: all a. a in omega -> a in malloc.live_of(B) ->
      mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) || (!x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) && !mallocng.in_stack_space(S.vm, a)) proof
    fix a
    assume _ h
    show by taut(mp(all_elim(l, {a}), h))
  qed
  have grown := apply(mp.rng_grow[c := c, A := A, A2 := A2, b2 := B, vm := S.vm], gfp, grs, gtk, glv)
  have tl2 := apply(mp.tls_grow[c := c, A := A, A2 := A2, vm := S.vm, fs := S.fs_base], fsb, hth, (mallocng_specs.tls_apart(c, A, S.fs_base) by defs(rtl, mallocng_specs.tls_apart)), grown)
  have er2: all x0. x0 in omega -> int_lt(x0, 4) -> !mallocng.in_ranges(int_add(int_add(S.fs_base, 52), x0), mallocng.fp_ranges(c, A2)) proof
    fix i
    assume hi hil
    have n0 m0 := rewrite(ea, mp(all_elim(expand(hea, mallocng_specs.errno_apart), {i}), hi, hil))
    assume ir
    show by taut(mp(all_elim(grown, {int_add(int_add(S.fs_base, 52), i)}), (int_add(int_add(S.fs_base, 52), i) in omega by arith(fsb, hi)), ir), n0, m0)
  qed
  have ca2 := apply(mp.top_can[c := c, A := A, A2 := A2, V2 := V2, b2 := B, vm := S.vm, fs := S.fs_base], hc, a2u, a2a, hm2, fsb, hcn, grown, rca)
  have lv2 := apply(mp.top_live[c := c, A := A2, V := V2, b := B], a2a, hb, hm2)
  let T := fn_update(S, "vm", V2)
  have tm: mallocng.holds_m(c, A2, T.vm, T.blocks) by simp(hm2, keep(mallocng.holds_m))
  have tl: malloc.live_rw(T) by defs(simp(lv2), malloc.live_rw)
  have tt: all x0. x0 in omega -> int_lt(x0, 8) -> !mallocng.in_ranges(int_add(T.fs_base, x0), mallocng.fp_ranges(c, A2)) by simp(expand(tl2, mallocng_specs.tls_apart))
  have te: all x0. x0 in omega -> int_lt(x0, 4) -> !mallocng.in_ranges(int_add(int_add(T.fs_base, 52), x0), mallocng.fp_ranges(c, A2)) by simp(er2)
  have tc: all x0. x0 in omega -> x0 in abi.canary(T.fs_base) -> !mallocng.in_ranges(x0, mallocng.fp_ranges(c, A2)) &&
      !((int_lt(0, A2.reserve_cnt) && int_le(int_div(A2.reserve, x86_64_linux.PAGE), int_div(x0, x86_64_linux.PAGE))) &&
        int_lt(int_div(x0, x86_64_linux.PAGE), int_add(int_div(A2.reserve, x86_64_linux.PAGE), A2.reserve_cnt))) by simp(ca2)
  have {ax2 = aux} := expand(hsh2, mallocng.shown_in)
  have tx: mallocng.aux_live(A2, T.objs) by simp(ax2, keep(mallocng.aux_live))
  show by defs(taut(tm, nr2, tk2, tl, tt, te, tc, tx), mallocng.rep)
qed

// ----------------------------------------------------------------------
//  The layer's allocator step

// (a byte of the layer's errno bytes: one of errno's)
theorem mp.top_eb(eo, S, a): S.fs_base in bits(64) -> int_le(int_add(S.fs_base, 56), int_pow(2, 64)) -> app(eo, empty) = 52 ->
  a in omega -> a in mp.errno(S.fs_base) -> a in malloc.errno_bytes(eo, S)
proof
  assume fsb fsl he ao h
  have h1 h2 := (int_le(int_add(S.fs_base, 52), a) && int_lt(a, int_add(S.fs_base, 56)) by taut(set_select_def[s := omega, p := x. int_le(int_add(S.fs_base, 52), x) && int_lt(x, int_add(S.fs_base, 56)), z := a], h))
  let i := int_sub(int_sub(a, S.fs_base), 52)
  have e := apply(mp.top_ebyte[eo := eo, S := S, i := i], fsb, fsl, he, (i in omega by arith(h1)), (int_lt(i, 4) by arith(h2)))
  show := rewrite((int_add(int_add(S.fs_base, 52), i) = a by arith()), e)
qed

// From A at S to A2 at T, the memory outside the allocator's untouched but
// errno, the allocator grown only into memory unmapped before: a step of
// the layer's allocator (with errno's bytes extra)
theorem mp.top_step(c, A, S, T, A2, eo, b, cd, st): c in mallocng.Cfg -> A in mallocng.Abs -> A2 in mallocng.Abs ->
  S in rec_and(abi.World, malloc.Heap.ghost) -> T in rec_and(abi.World, malloc.Heap.ghost) -> S.fs_base in bits(64) -> app(eo, empty) = 52 ->
  mallocng.rep(c, A, S) -> mallocng.rep(c, A2, T) -> abi.thread_ok(S.vm, S.fs_base) -> malloc.world_ok(b, cd, st, S) ->
  mallocng.untouched(c, A, S.blocks, S.vm, T.vm, S.objs, mp.errno(S.fs_base)) ->
  (all a. a in omega -> a in mallocng.footprint(c, A2, T.blocks) ->
     a in mallocng.footprint(c, A, S.blocks) || (!x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) && !mallocng.in_stack_space(S.vm, a))) ->
  malloc.step_ok(mallocng.inv(c), mallocng.owned(c), S, T, malloc.errno_bytes(eo, S))
proof
  assume hcf ha ha2 hs ht fsb he hr hr2 hth hw hun hg
  have {fsl = fsl} := apply(mp.top_fsl, fsb, hth)
  have nst _ _ _ _ _ lst := expand(hw, malloc.world_ok)
  have uk uo bk := expand(hun, mallocng.untouched)
  // outside what S's allocator owns and errno: untouched (no stack page
  // among the world's: no byte stack-free)
  have fr: all a. a in omega -> (!(a in mallocng.owned(c)[S]) && !(a in malloc.errno_bytes(eo, S))) && x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) ->
      T.vm.bytes[bits_of_int(64, a)] = S.vm.bytes[bits_of_int(64, a)] && T.vm.pages[int_div(a, x86_64_linux.PAGE)] = S.vm.pages[int_div(a, x86_64_linux.PAGE)] proof
    fix a
    assume ao h
    have no ne hm := h
    have nf: !(a in mallocng.footprint(c, A, S.blocks)) proof
      assume w
      show by taut(no, apply(mallocng.owned_intro[c := c, s := S, A := A, a := a], hs, ha, hr, ao, w))
    qed
    have nr: !(a in mp.errno(S.fs_base)) proof
      assume w
      show by taut(ne, apply(mp.top_eb[eo := eo, S := S, a := a], fsb, fsl, he, ao, w))
    qed
    have ml mn := expand(hm, x86_64_linux.mapped)
    have kp: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
    have qs: int_div(a, x86_64_linux.PAGE) in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) by sel(taut((int_div(a, x86_64_linux.PAGE) in omega by arith(ao, kp)), ml))
    have nk := mp(all_elim(nst, {int_div(a, x86_64_linux.PAGE)}), qs, mn)
    have nsf: !abi.stack_free(S.vm, S.objs, a) by defs(taut(hm, nk), abi.stack_free)
    have u1 u2 := mp(all_elim(uk, {a}), ao, conj(conj(nf, nr), hm))
    show by taut(mp(u1, nsf), u2)
  qed
  // the callers' objects: on mapped pages as above, or in the stack's
  // space (the world's), on no page -- untouched
  have fo: all a. a in omega -> ((!(a in mallocng.owned(c)[S]) && !(a in malloc.errno_bytes(eo, S))) && a in S.objs.live) && int_lt(a, x86_64_linux.TASK_SIZE) ->
      T.vm.bytes[bits_of_int(64, a)] = S.vm.bytes[bits_of_int(64, a)] && T.vm.pages[int_div(a, x86_64_linux.PAGE)] = S.vm.pages[int_div(a, x86_64_linux.PAGE)] proof
    fix a
    assume ao h
    have no ne hl ht2 := h
    have cm: x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) ->
        T.vm.bytes[bits_of_int(64, a)] = S.vm.bytes[bits_of_int(64, a)] && T.vm.pages[int_div(a, x86_64_linux.PAGE)] = S.vm.pages[int_div(a, x86_64_linux.PAGE)] proof
      assume hm
      show := mp(all_elim(fr, {a}), ao, conj(conj(no, ne), hm))
    qed
    have cu: !x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) ->
        T.vm.bytes[bits_of_int(64, a)] = S.vm.bytes[bits_of_int(64, a)] && T.vm.pages[int_div(a, x86_64_linux.PAGE)] = S.vm.pages[int_div(a, x86_64_linux.PAGE)] proof
      assume nm
      have nf: !(a in mallocng.footprint(c, A, S.blocks)) proof
        assume w
        show by taut(no, apply(mallocng.owned_intro[c := c, s := S, A := A, a := a], hs, ha, hr, ao, w))
      qed
      have nr: !(a in mp.errno(S.fs_base)) proof
        assume w
        show by taut(ne, apply(mp.top_eb[eo := eo, S := S, a := a], fsb, fsl, he, ao, w))
      qed
      have l1 l2 := mp(all_elim(lst, {a}), ao, hl)
      have is: mallocng.in_stack_space(S.vm, a) by defs(taut(l1, l2, ht2), mallocng.in_stack_space)
      show := mp(all_elim(uo, {a}), ao, conj(conj(conj(conj(nf, nr), hl), is), nm))
    qed
    show by taut(cm, cu)
  qed
  have b1 b2 b3 _ := expand(bk, mallocng.bounds_kept)
  have af: malloc.alloc_frame(mallocng.owned(c), S, T.vm, malloc.errno_bytes(eo, S)) by defs(taut(fr, fo, b1, b2, b3), malloc.alloc_frame)
  have ti := apply(mallocng.inv_intro[c := c, s := T, A := A2], ht, ha2, hr2)
  // what T's allocator owns: A2's footprint (A2 unique), so A's or unmapped
  have ow: all a. a in omega -> a in mallocng.owned(c)[T] ->
      (a in mallocng.owned(c)[S] || a in malloc.errno_bytes(eo, S)) || !x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) proof
    fix a
    assume ao h
    obtain B, hb hbr hbf from apply(mallocng.owned_mem[c := c, s := T, a := a], ht, h)
    have eq := apply(mallocng.abs_unique[c := c, s := T, A := B, B := A2], hcf, ht, hb, ha2, hbr, hr2)
    have g1 := mp(all_elim(hg, {a}), ao, rewrite(eq, hbf))
    have c1: a in mallocng.footprint(c, A, S.blocks) -> a in mallocng.owned(c)[S] proof
      assume w
      show := apply(mallocng.owned_intro[c := c, s := S, A := A, a := a], hs, ha, hr, ao, w)
    qed
    show by taut(g1, c1)
  qed
  show by defs(taut(af, ti, ow), malloc.step_ok)
qed

// ----------------------------------------------------------------------
//  malloc's failure: the layer's out_of_memory

// (errno ENOMEM: its bytes 12, 0, 0, 0)
theorem mp.top_e12(V, a): V.bytes in fn_space(bits(64), bits(8)) -> gimple.bytes_at(V, a, 4) = 12 ->
  all i. i in omega -> int_lt(i, 4) -> V.bytes[bits_add(64, a, bits_of_int(64, i))] = bits_of_int(8, int_div(12, int_pow(256, i)))
proof
  assume hb he
  let y(k) := V.bytes[bits_add(64, a, bits_of_int(64, k))]
  have s4: int_add(int_add(int_add(y(0), int_mul(y(1), 256)), int_mul(y(2), 65536)), int_mul(y(3), 16777216)) = 12 by simp(expand(he, gimple.bytes_at))
  have yb: all k. y(k) in bits(8) proof
    fix k
    show := apply(fn_space_app, hb, (bits_add(64, a, bits_of_int(64, k)) in bits(64) by simp()))
  qed
  have b0 := all_elim(yb, {0})
  have b1 := all_elim(yb, {1})
  have b2 := all_elim(yb, {2})
  have b3 := all_elim(yb, {3})
  have v0: y(0) = 12 by arith(s4, b0, b1, b2, b3)
  have v1: y(1) = 0 by arith(s4, b0, b1, b2, b3)
  have v2: y(2) = 0 by arith(s4, b0, b1, b2, b3)
  have v3: y(3) = 0 by arith(s4, b0, b1, b2, b3)
  fix i
  assume hi hil
  have cs: i = 0 || i = 1 || i = 2 || i = 3 by arith(hi, hil)
  have c0: i = 0 -> y(i) = bits_of_int(8, int_div(12, int_pow(256, i))) proof
    assume e
    show by simp(e, v0)
  qed
  have c1: i = 1 -> y(i) = bits_of_int(8, int_div(12, int_pow(256, i))) proof
    assume e
    show by simp(e, v1)
  qed
  have c2: i = 2 -> y(i) = bits_of_int(8, int_div(12, int_pow(256, i))) proof
    assume e
    show by simp(e, v2)
  qed
  have c3: i = 3 -> y(i) = bits_of_int(8, int_div(12, int_pow(256, i))) proof
    assume e
    show by simp(e, v3)
  qed
  show by taut(cs, c0, c1, c2, c3)
qed

// errno set to ENOMEM where it is ENOMEM already: the state as it was (the
// loop's run, by its invariant -- the state unchanged -- and variant 4 - i)
theorem mp.top_seterr(eo, T): T in univ(1) -> T.vm in x86_64_linux.Vm -> is_fun(T) -> "vm" in dom(T) -> T.fs_base in bits(64) ->
  app(eo, empty) = 52 -> mallocng_specs.errno_is(T.vm, T.fs_base, x86_64_linux.ENOMEM) ->
  runs(malloc.set_errno(eo, x86_64_linux.ENOMEM), T, ok(T, empty))
proof
  assume hu hvm hf hd fsb he hen
  let a := bits_add(64, T.fs_base, bits_of_int(64, app(eo, empty)))
  let B := T.vm.bytes
  have ke: x86_64_linux.ENOMEM = 12 by defs(refl({12}), x86_64_linux.ENOMEM)
  have ea: mallocng_specs.errno_at(T.fs_base) = a by defs(simp(he), mallocng_specs.errno_at)
  have b12: gimple.bytes_at(T.vm, a, 4) = 12 := rewrite(ke, rewrite(ea, expand(hen, mallocng_specs.errno_is)))
  have bt: B in fn_space(bits(64), bits(8)) by simp(hvm)
  have e12 := apply(mp.top_e12[V := T.vm, a := a], bt, b12)
  have bf: is_fun(B) && dom(B) = bits(64) by simp(hvm)
  have vf: is_fun(T.vm) && "bytes" in dom(T.vm) by simp(hvm)
  have e0v := mp(fn_update_same[f := T.vm, k := "bytes"], taut(vf), taut(vf))
  have e0s := mp(fn_update_same[f := T, k := "vm"], hf, hd)
  let P(l) := ex i. i in omega && int_le(i, 4) && l = pair(T, i)
  let M(l) := int_sub(4, snd(l))
  let G(l, r) := r = exc(pair(fst(l), snd(l)), pair("brk", empty))
  let BODYA(q, l, o) := (int_lt(snd(l), 4) && letin(snd(l), x7. letin(fn_update(fst(l), "vm", fn_update(fst(l).vm, "bytes",
      fn_update(fst(l).vm.bytes, bits_add(64, q, bits_of_int(64, x7)), bits_of_int(8, int_div(x86_64_linux.ENOMEM, int_pow(256, x7)))))), x8. o = ok(pair(x8, int_add(snd(l), 1)), empty)))) ||
    (!int_lt(snd(l), 4) && o = exc(pair(fst(l), snd(l)), pair("brk", empty)))
  let BODY(l, o) := BODYA(a, l, o)
  have p0: P(pair(T, 0)) by ex_intro({0}, simp())
  have pm: all l. P(l) -> M(l) in omega proof
    fix l
    assume hp2
    obtain i, hi from hp2
    show by simp(hi)
  qed
  have pb: all l. P(l) -> true -> (ex l2. BODY(l, ok(l2, empty)) && P(l2) && int_lt(M(l2), M(l))) || (ex r. BODY(l, r) && G(l, r) && !is_ok(r) && !(fst(r) = 2)) proof
    fix l
    assume hp2 ht
    obtain i, io il le from hp2
    have more: int_lt(i, 4) -> (ex l2. BODY(l, ok(l2, empty)) && P(l2) && int_lt(M(l2), M(l))) proof
      assume hlt
      let k := bits_add(64, a, bits_of_int(64, i))
      have kb: k in bits(64) by simp()
      have bk := mp(all_elim(e12, {i}), io, hlt)
      have same := mp(fn_update_same[f := B, k := k], taut(bf), (k in dom(B) by simp(bf, kb)))
      have ub: fn_update(B, k, bits_of_int(8, int_div(x86_64_linux.ENOMEM, int_pow(256, i)))) = B := rewrite(sym(ke), rewrite(bk, same))
      have bd: BODY(l, ok(pair(T, int_add(i, 1)), empty)) by defs(simp(le, hlt, ub, e0v, e0s), letin)
      have p2: P(pair(T, int_add(i, 1))) by ex_intro({int_add(i, 1)}, simp(io, hlt))
      have m2: int_lt(M(pair(T, int_add(i, 1))), M(l)) by simp(le, io)
      show by ex_intro({pair(T, int_add(i, 1))}, taut(bd, p2, m2))
    qed
    have done: !int_lt(i, 4) -> (ex r. BODY(l, r) && G(l, r) && !is_ok(r) && !(fst(r) = 2)) proof
      assume hge
      let R := exc(pair(fst(l), snd(l)), pair("brk", empty))
      have bd: BODY(l, R) by simp(le, hge)
      have g: G(l, R) by simp()
      have no: !is_ok(R) by defs(simp(), is_ok)
      have nd: !(fst(R) = 2) by simp()
      show by ex_intro({R}, taut(bd, g, no, nd))
    qed
    have cs: int_lt(i, 4) || !int_lt(i, 4) by taut()
    show by taut(cs, more, done)
  qed
  have ex := mp(while_exists[l0 := pair(T, 0), c := l. true, b := l o. BODY(l, o), tr := l. fn_update(empty, "os.events", fst(l).os.events), p := l. P(l), m := l. M(l),
    g := l r. G(l, r)], p0, pm, pb)
  obtain r, hw hnd hcase from ex
  have nst: (ex l. P(l) && !true && r = ok(l, empty)) -> false proof
    assume h
    obtain l0, hl0 from h
    show by taut(hl0)
  qed
  have lft: ex l. P(l) && true && BODY(l, r) && G(l, r) && !is_ok(r) by taut(hcase, nst)
  obtain l, hpl _ hbl hgl hno from lft
  obtain i, io il le from hpl
  have ni: !int_lt(i, 4) proof
    assume hlt
    have bb := rewrite(le, hbl)
    have bb2: letin(i, x7. letin(fn_update(T, "vm", fn_update(T.vm, "bytes",
        fn_update(T.vm.bytes, bits_add(64, a, bits_of_int(64, x7)), bits_of_int(8, int_div(x86_64_linux.ENOMEM, int_pow(256, x7)))))), x8. r = ok(pair(x8, int_add(i, 1)), empty))) by simp(bb, hlt)
    have b1: ex x8. r = ok(pair(x8, int_add(i, 1)), empty) by ex_intro({fn_update(T, "vm", fn_update(T.vm, "bytes",
        fn_update(T.vm.bytes, bits_add(64, a, bits_of_int(64, i)), bits_of_int(8, int_div(x86_64_linux.ENOMEM, int_pow(256, i))))))}, defs(bb2, letin))
    obtain x8, hx8 from b1
    have ok8: is_ok(r) by defs(ex_intro({pair(x8, int_add(i, 1))}, {empty}, hx8), is_ok)
    show by taut(ok8, hno)
  qed
  have ien: i = 4 by arith(il, ni, io)
  have re: r = exc(pair(T, 4), pair("brk", empty)) by simp(hgl, le, ien)
  have hw2 := rewrite(re, hw)
  have pu: pair(T, ok(T, empty)) in univ(1) by simp(hu)
  have rel: letin(a, x2. letin(0, x3. ex x4. while_rel(pair(T, x3), x5. true, x5 x6. BODYA(x2, x5, x6), x5. fn_update(empty, "os.events", fst(x5).os.events), x4) &&
      (((fst(x4) = 0 || (fst(x4) = 1 && fst(out_value(x4)) = "brk")) && ok(T, empty) = ok(fst(out_state(x4)), empty)) ||
       ((((fst(x4) = 1 && fst(out_value(x4)) = "ret") && ok(T, empty) = ok(fst(out_state(x4)), snd(out_value(x4)))) ||
         ((fst(x4) = 1 && fst(out_value(x4)) = "raise") && ok(T, empty) = exc(fst(out_state(x4)), snd(out_value(x4))))) ||
        (fst(x4) = 2 && ok(T, empty) = diverge(snd(x4))))))) by defs(ex_intro({exc(pair(T, 4), pair("brk", empty))}, simp(hw2, keep(while_rel))), letin, out_state, out_value)
  show by defs(apply(tr.runs_intro, {T}, {ok(T, empty)}, pu, rel), malloc.set_errno)
qed

// The layer's out_of_memory from S to T, its new memory V: an allocator
// step (V errno ENOMEM already), errno set (so unchanged)
theorem mp.top_oom(I, O, eo, b, cd, st, S, V): S in univ(1) -> V in x86_64_linux.Vm -> S.fs_base in bits(64) -> app(eo, empty) = 52 ->
  fn_update(S, "vm", V) in univ(1) -> is_fun(fn_update(S, "vm", V)) -> "vm" in dom(fn_update(S, "vm", V)) ->
  malloc.step_ok(I, O, S, fn_update(S, "vm", V), malloc.errno_bytes(eo, S)) -> malloc.world_ok(b, cd, st, fn_update(S, "vm", V)) ->
  mallocng_specs.errno_is(V, S.fs_base, x86_64_linux.ENOMEM) ->
  runs(malloc.out_of_memory(I, O, eo, b, cd, st, S), S, ok(fn_update(S, "vm", V), 0))
proof
  assume su hv fsb he tu tf td hst hwk hen
  let T := fn_update(S, "vm", V)
  have tv: T.vm = V by simp()
  have tfs: T.fs_base = S.fs_base by simp()
  have se := apply(mp.top_seterr[eo := eo, T := T], tu, rewrite(sym(tv), hv), tf, td, rewrite(sym(tfs), fsb), he, rewrite(sym(tfs), rewrite(sym(tv), hen)))
  have pa: pair(S, ok(T, empty)) in univ(1) by simp(su, tu)
  have as: runs(malloc.allocator_step(I, O, b, cd, st, S, malloc.errno_bytes(eo, S)), S, ok(T, empty)) by spec_ret({V}, hv, hst, hwk, pa)
  have b2 := mp(all_elim(gc.bind_ok[p := malloc.set_errno(eo, x86_64_linux.ENOMEM), k := x4 x5. ok(T, 0) = ok(x4, 0), x := x4 x5. ok(T, 0) = exc(x4, x5), d := x4. ok(T, 0) = diverge(x4)],
    {T}, {T}, {empty}), se, refl({ok(T, 0)}))
  have b1 := mp(all_elim(gc.bind_ok[p := malloc.allocator_step(I, O, b, cd, st, S, malloc.errno_bytes(eo, S)),
      k := x2 x3. bind_rel(malloc.set_errno(eo, x86_64_linux.ENOMEM), x2, x4 x5. ok(T, 0) = ok(x4, 0), x4 x5. ok(T, 0) = exc(x4, x5), x4. ok(T, 0) = diverge(x4)),
      x := x2 x3. ok(T, 0) = exc(x2, x3), d := x2. ok(T, 0) = diverge(x2)], {S}, {T}, {empty}), as, b2)
  have pu: pair(S, ok(T, 0)) in univ(1) by simp(su, tu)
  show by defs(apply(tr.runs_intro, {S}, {ok(T, 0)}, pu, b1), malloc.out_of_memory)
qed

// ... so the layer's malloc may return 0 there (out of memory: `any?`'s
// failure)
theorem mp.top_mfail(I, O, eo, b, cd, st, n, S, T): pair(S, ok(T, 0)) in univ(1) -> runs(malloc.out_of_memory(I, O, eo, b, cd, st, S), S, ok(T, 0)) ->
  runs(malloc.malloc(I, O, eo, b, cd, st, n), S, ok(T, 0))
proof
  assume pu ho
  let W := exc(pair(T, empty), pair("ret", 0))
  have bo := mp(all_elim(gc.bind_ok[p := malloc.out_of_memory(I, O, eo, b, cd, st, S), k := x4 x5. W = exc(pair(x4, empty), pair("ret", x5)),
      x := x4 x5. W = exc(pair(x4, empty), pair("raise", x5)), d := x4. W = diverge(x4)], {S}, {T}, {0}), ho, refl({W}))
  show by spec_ret({W}, pu, bo)
qed

// ... its block p of n bytes: a place and an allocator step for it
theorem mp.top_mok(I, O, eo, b, cd, st, n, S, p, V): n in omega -> p in bits(64) -> !(p = 0) -> int_mod(p, 16) = 0 -> malloc.fresh_block(O, S, p, n) ->
  V in x86_64_linux.Vm -> malloc.step_ok(I, O, S, fn_update(fn_update(S, "blocks", malloc.set_block(S.blocks, p, some(n))), "vm", V), malloc.errno_bytes(eo, S)) ->
  malloc.world_ok(b, cd, st, fn_update(fn_update(S, "blocks", malloc.set_block(S.blocks, p, some(n))), "vm", V)) ->
  pair(S, ok(fn_update(fn_update(S, "blocks", malloc.set_block(S.blocks, p, some(n))), "vm", V), p)) in univ(1) ->
  runs(malloc.malloc(I, O, eo, b, cd, st, n), S, ok(fn_update(fn_update(S, "blocks", malloc.set_block(S.blocks, p, some(n))), "vm", V), p))
proof
  assume hn hp hp0 hal hfr hv hst hwk pu
  let K := ok(pair(S, empty), empty)
  have nn: int_le(n, n) by arith(hn)
  show by spec_ret({K}, {K}, {n}, {n}, {K}, {p}, {p}, {K}, {V}, {V}, hn, nn, hp, hp0, hal, hfr, hv, hst, hwk, pu)
qed

// ... anything where its precondition fails
theorem mp.top_many(I, O, eo, b, cd, st, n, S, o): pair(S, o) in univ(1) ->
  !((S in I && malloc.errno_ok(eo, S)) && malloc.world_ok(b, cd, st, S)) -> runs(malloc.malloc(I, O, eo, b, cd, st, n), S, o)
proof
  assume pu hn
  show by spec_ret(pu, hn)
qed

// (a run of p, an outcome: p bound to its outcome as it is)
theorem mp.bind_self(p, s, o): runs(p, s, o) -> (ex x v. o = ok(x, v)) || (ex x e. o = exc(x, e)) || (ex t. o = diverge(t)) ->
  bind_rel(p, s, x3 x4. o = ok(x3, x4), x3 x4. o = exc(x3, x4), x3. o = diverge(x3))
proof
  assume hr hs
  have c1: (ex x v. o = ok(x, v)) -> bind_rel(p, s, x3 x4. o = ok(x3, x4), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) proof
    assume e
    obtain x v, eo from e
    show := mp(all_elim(gc.bind_ok[p := p, k := x3 x4. o = ok(x3, x4), x := x3 x4. o = exc(x3, x4), d := x3. o = diverge(x3)], {s}, {x}, {v}), rewrite(eo, hr), eo)
  qed
  have c2: (ex x e. o = exc(x, e)) -> bind_rel(p, s, x3 x4. o = ok(x3, x4), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) proof
    assume e
    obtain x ee, eo from e
    show := mp(all_elim(gc.bind_exc[p := p, k := x3 x4. o = ok(x3, x4), x := x3 x4. o = exc(x3, x4), d := x3. o = diverge(x3)], {s}, {x}, {ee}), rewrite(eo, hr), eo)
  qed
  have c3: (ex t. o = diverge(t)) -> bind_rel(p, s, x3 x4. o = ok(x3, x4), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) proof
    assume e
    obtain t, eo from e
    show := mp(all_elim(gc.bind_div[p := p, k := x3 x4. o = ok(x3, x4), x := x3 x4. o = exc(x3, x4), d := x3. o = diverge(x3)], {s}, {t}), rewrite(eo, hr), eo)
  qed
  show by taut(hs, c1, c2, c3)
qed

// the layer's malloc as a C function value: its run, the argument's
theorem mp.top_mfun(I, O, eo, b, cd, st, regs, S, o): regs in abi.ARGS -> pair(S, o) in univ(1) ->
  (ex x v. o = ok(x, v)) || (ex x e. o = exc(x, e)) || (ex t. o = diverge(t)) ->
  runs(malloc.malloc(I, O, eo, b, cd, st, regs[0]), S, o) -> runs(malloc.malloc_fun(I, O, eo, b, cd, st)[regs], S, o)
proof
  assume hr pu hs hm
  have br0 := apply(mp.bind_self, hm, hs)
  have br: !ord_le(1, seq_len(regs)) || bind_rel(malloc.malloc(I, O, eo, b, cd, st, regs[0]), S, x3 x4. o = ok(x3, x4), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) by taut(br0)
  have r := mp(all_elim(tr.runs_intro[r := x1 x2. !ord_le(1, seq_len(regs)) || bind_rel(malloc.malloc(I, O, eo, b, cd, st, regs[0]), x1,
    x3 x4. x2 = ok(x3, x4), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))], {S}, {o}), pu, br)
  show by defs(rewrite(sym(mp(app_fn_build[d := abi.ARGS, v := x0. mkprog(x1 x2. !ord_le(1, seq_len(x0)) || bind_rel(malloc.malloc(I, O, eo, b, cd, st, x0[0]), x1,
    x3 x4. x2 = ok(x3, x4), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), a := regs], hr)), r), malloc.malloc_fun)
qed

// ... anything with no argument
theorem mp.top_mfun0(I, O, eo, b, cd, st, regs, S, o): regs in abi.ARGS -> pair(S, o) in univ(1) -> !ord_le(1, seq_len(regs)) ->
  runs(malloc.malloc_fun(I, O, eo, b, cd, st)[regs], S, o)
proof
  assume hr pu hn
  have br: !ord_le(1, seq_len(regs)) || bind_rel(malloc.malloc(I, O, eo, b, cd, st, regs[0]), S, x3 x4. o = ok(x3, x4), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) by taut(hn)
  have r := mp(all_elim(tr.runs_intro[r := x1 x2. !ord_le(1, seq_len(regs)) || bind_rel(malloc.malloc(I, O, eo, b, cd, st, regs[0]), x1,
    x3 x4. x2 = ok(x3, x4), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))], {S}, {o}), pu, br)
  show by defs(rewrite(sym(mp(app_fn_build[d := abi.ARGS, v := x0. mkprog(x1 x2. !ord_le(1, seq_len(x0)) || bind_rel(malloc.malloc(I, O, eo, b, cd, st, x0[0]), x1,
    x3 x4. x2 = ok(x3, x4), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), a := regs], hr)), r), malloc.malloc_fun)
qed

// a single-result spec widened (rdx any): its return with any second word,
// its exceptions and divergences as they are
abbrev mp.WR(F, regs, x1, x2) := bind_rel(F[regs], x1, x3 x4. any_rel(x5. x5 in bits(64), x5. x2 = ok(x3, pair(x4, x5))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))

theorem mp.top_wide(G, F, regs, S, o2): regs in abi.ARGS -> pair(S, o2) in univ(1) -> mp.WR(F, regs, S, o2) -> runs(abi.wide(G, F)[regs], S, o2)
proof
  assume hr pu hw
  have r := mp(all_elim(tr.runs_intro[r := x1 x2. mp.WR(F, regs, x1, x2)], {S}, {o2}), pu, hw)
  show by defs(rewrite(sym(mp(app_fn_build[d := abi.ARGS, v := x0. mkprog(x1 x2. mp.WR(F, x0, x1, x2)), a := regs], hr)), r), abi.wide)
qed

theorem mp.wr_ok(F, regs, S, x, r, y): y in bits(64) -> runs(F[regs], S, ok(x, r)) -> mp.WR(F, regs, S, ok(x, pair(r, y)))
proof
  assume hy hr
  have k: any_rel(x5. x5 in bits(64), x5. ok(x, pair(r, y)) = ok(x, pair(r, x5))) by spec_ret({y}, hy)
  show := mp(all_elim(gc.bind_ok[p := F[regs], k := x3 x4. any_rel(x5. x5 in bits(64), x5. ok(x, pair(r, y)) = ok(x3, pair(x4, x5))),
    x := x3 x4. ok(x, pair(r, y)) = exc(x3, x4), d := x3. ok(x, pair(r, y)) = diverge(x3)], {S}, {x}, {r}), hr, k)
qed

theorem mp.wr_exc(F, regs, S, x, e): runs(F[regs], S, exc(x, e)) -> mp.WR(F, regs, S, exc(x, e))
proof
  assume hr
  show := mp(all_elim(gc.bind_exc[p := F[regs], k := x3 x4. any_rel(x5. x5 in bits(64), x5. exc(x, e) = ok(x3, pair(x4, x5))),
    x := x3 x4. exc(x, e) = exc(x3, x4), d := x3. exc(x, e) = diverge(x3)], {S}, {x}, {e}), hr, refl({exc(x, e)}))
qed

theorem mp.wr_div(F, regs, S, t): runs(F[regs], S, diverge(t)) -> mp.WR(F, regs, S, diverge(t))
proof
  assume hr
  show := mp(all_elim(gc.bind_div[p := F[regs], k := x3 x4. any_rel(x5. x5 in bits(64), x5. diverge(t) = ok(x3, pair(x4, x5))),
    x := x3 x4. diverge(t) = exc(x3, x4), d := x3. diverge(t) = diverge(x3)], {S}, {t}), hr, refl({diverge(t)}))
qed

// ----------------------------------------------------------------------
//  The `malloc` symbol by the layer's malloc

// the layer's ghost part (the live blocks): apart from the machine's and
// the world's fields
theorem mp.hg_ok: abi.ghost_ok(malloc.Heap.ghost)
proof
  fix h
  assume hh
  have kb: insert("blocks", empty) in univ(1) by simp(x86.insert_univ)
  have xp xf xd _ := (h in powerset(cart(insert("blocks", empty), univ(1))) && is_fun(h) && dom(h) = insert("blocks", empty) && h.blocks in fn_space(bits(64), option(omega))
    by simp(expand(hh, malloc.Heap.ghost)))
  have hu := mp(rec_univ[u := 1, k := insert("blocks", empty), r := h], kb, xp, xf, xd)
  have k1 := apply(mp.one_key, xf, xd)
  have keys: all z. z in h -> !(fst(z) in abi.KEYS) && !(fst(z) in abi.WKEYS) proof
    fix z
    assume hz
    show by simp(mp(all_elim(k1, {z}), hz))
  qed
  show by taut(hu, xf, keys)
qed

// (the layer's ghost part, its live blocks replaced)
theorem mp.hg_updb(h, b2): h in malloc.Heap.ghost -> b2 in fn_space(bits(64), option(omega)) -> b2 in univ(1) -> fn_update(h, "blocks", b2) in malloc.Heap.ghost
proof
  assume hx hb2 hu2
  have xp xf xd _ := (h in powerset(cart(insert("blocks", empty), univ(1))) && is_fun(h) && dom(h) = insert("blocks", empty) && h.blocks in fn_space(bits(64), option(omega))
    by simp(expand(hx, malloc.Heap.ghost)))
  let X2 := fn_update(h, "blocks", b2)
  have x2f x2d := mp(fn_update_fd[f := h, k := "blocks", v := b2, d := insert("blocks", empty)], xf, xd, simp())
  have xs: subset(h, cart(insert("blocks", empty), univ(1))) by taut(powerset_def[s := cart(insert("blocks", empty), univ(1)), a := h], xp)
  have sub: all z. z in X2 -> z in cart(insert("blocks", empty), univ(1)) proof
    fix z
    assume hz
    have c := fn_update_iff[f := h, k := "blocks", v := b2, z := z]
    have c1: z in h -> z in cart(insert("blocks", empty), univ(1)) proof
      assume h1
      show := mp(subset_elim[a := h, b := cart(insert("blocks", empty), univ(1)), z := z], xs, h1)
    qed
    have c2: z = pair("blocks", b2) -> z in cart(insert("blocks", empty), univ(1)) proof
      assume h2
      show := rewrite(sym(h2), mp(cart_intro[a := insert("blocks", empty), b := univ(1), x := "blocks", y := b2], simp(), hu2))
    qed
    show by taut(c, hz, c1, c2)
  qed
  have pw: X2 in powerset(cart(insert("blocks", empty), univ(1))) by taut(powerset_def[s := cart(insert("blocks", empty), univ(1)), a := X2], (subset(X2, cart(insert("blocks", empty), univ(1))) by defs(sub, subset)))
  have ap: X2.blocks = b2 := app_update_same[f := h, k := "blocks", v := b2]
  have sd := set_select_def[s := powerset(cart(insert("blocks", empty), univ(1))), p := x0. (is_fun(x0) && dom(x0) = insert("blocks", empty)) && x0.blocks in fn_space(bits(64), option(omega)), z := X2]
  show by defs(taut(sd, pw, x2f, x2d, rewrite(sym(ap), hb2)), malloc.Heap.ghost)
qed

// (the abstract state A as a ghost part)
theorem mp.abs_rec(A): A in mallocng.Abs -> A in univ(1) -> fn_update(empty, "A", A) in mallocng_specs.MallocAbs.ghost
proof
  assume ha hu
  let Y := fn_update(empty, "A", A)
  have ef ed := dom_empty
  have yf := mp(fn_update_fun[f := empty, k := "A", v := A], ef)
  have yd: dom(Y) = insert("A", empty) := rewrite(ed, mp(dom_update[f := empty, k := "A", v := A], ef))
  have sub: all z. z in Y -> z in cart(insert("A", empty), univ(1)) proof
    fix z
    assume hz
    have c := fn_update_iff[f := empty, k := "A", v := A, z := z]
    have c2: z = pair("A", A) -> z in cart(insert("A", empty), univ(1)) proof
      assume h2
      show := rewrite(sym(h2), mp(cart_intro[a := insert("A", empty), b := univ(1), x := "A", y := A], simp(), hu))
    qed
    have ne: !(z in empty) by simp()
    show by taut(c, hz, ne, c2)
  qed
  have pw: Y in powerset(cart(insert("A", empty), univ(1))) by taut(powerset_def[s := cart(insert("A", empty), univ(1)), a := Y], (subset(Y, cart(insert("A", empty), univ(1))) by defs(sub, subset)))
  have ap: Y.A = A := app_update_same[f := empty, k := "A", v := A]
  have sd := set_select_def[s := powerset(cart(insert("A", empty), univ(1))), p := x0. (is_fun(x0) && dom(x0) = insert("A", empty)) && x0.A in mallocng.Abs, z := Y]
  show by defs(taut(sd, pw, yf, yd, rewrite(sym(ap), ha)), mallocng_specs.MallocAbs.ghost)
qed

// default_malloc's run (__libc_malloc_impl's called as such) with its
// returns as one
theorem mp.dm_run2(c, n, g, s, h, o): n in bits(64) -> mp.mi_call(c, g) -> s in abi.World -> h in mp.G ->
  mallocng.holds_m(c, h.A, s.vm, h.blocks) -> mallocng.shown_in(c, h.A, s.objs) -> mallocng.no_reserved(h.A) -> seq_len(h.A.taken) = 0 ->
  abi.thread_ok(s.vm, s.fs_base) -> mallocng_specs.tls_apart(c, h.A, s.fs_base) ->
  abi.brk_start_ok(s.vm) -> mallocng_specs.errno_ok(s.vm, s.objs, s.fs_base) -> mallocng_specs.errno_apart(c, h.A, s.vm, s.fs_base) ->
  runs(c_src_malloc_lite_malloc.default_malloc(n, g), s, o) ->
  abi.ovf_out(s, o) || (ex V p. (V in x86_64_linux.Vm && p in bits(64) && (ex A2. mp.mi_ret(c, h.A, n, h.blocks, s, A2, V, p))) && o = ok(fn_update(s, "vm", V), p))
proof
  assume hnb hmi hw hh hin hsh hnr htk hth htl hbs heo hea hr
  show := apply(mp.mi_out2[c := c, A := h.A, n := n, B := h.blocks, s := s, o := o],
    apply(mp.dm_run[c := c, n := n, g := g, s := s, h := h, o := o], hnb, hmi, hw, hh, hin, hsh, hnr, htk, hth, htl, hbs, heo, hea, hr))
qed

// the `malloc` symbol's code called as __libc_malloc_impl
theorem mp.dm_q: all c g. mp.mi_call(c, g) -> mp.mi_call(c, c_src_malloc_lite_malloc.default_malloc_fun(g))
proof
  fix c g
  assume hmi
  fix n t h regs o2
  assume hnb hw hh hin hsh hnr htk hth htl hbs heo hea hro hr
  have rl rn r0 := apply(gc.regs1, hnb, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  have o1l: ord_le(1, seq_len(regs)) by defs(simp(rn), ord_le)
  have bp: bits_of_int(64, regs[0]) = n by defs(simp(r0, hnb), bits_of_int, pow2)
  step o3 V p, e hs1 from hr with o1l, bp, mp.dm_run2 using ra, hnb, hmi, hw, hh, hin, hsh, hnr, htk, hth, htl, hbs, heo, hea
  have hv hpb hex := hs1
  step o4 y, e2 from e with g.result64_inv using hpb
  have fp: fst(pair(p, y)) = p by simp()
  have hex2 := subst({z. ex X. mp.mi_ret(c, h.A, n, h.blocks, t, X, V, z)}, sym(fp), hex)
  show by disj({2}, ex_intro({V}, {pair(p, y)}, taut(hv, hex2, e2)))
qed

// the layer's malloc for mallocng (configuration c, errno at eo, the
// program loaded as b, cd, st) as a C function value, and its precondition
abbrev mp.UF(c, eo, b, cd, st) := malloc.malloc_fun(mallocng.inv(c), mallocng.owned(c), eo, b, cd, st)
abbrev mp.MPRE(c, eo, b, cd, st, S) := (S in mallocng.inv(c) && malloc.errno_ok(eo, S)) && malloc.world_ok(b, cd, st, S)

// ... widened: anything where it has no argument or its precondition fails
theorem mp.top_any(c, eo, b, cd, st, regs, S, o): regs in abi.ARGS -> pair(S, o) in univ(1) -> abi.outcome(o) ->
  (all x v. o = ok(x, v) -> v in cart(bits(64), bits(64))) -> !(ord_le(1, seq_len(regs)) && mp.MPRE(c, eo, b, cd, st, S)) ->
  runs(abi.wide(malloc.Heap.ghost, mp.UF(c, eo, b, cd, st))[regs], S, o)
proof
  assume hra pu hsh hv hn
  have fr: all o1. pair(S, o1) in univ(1) -> abi.outcome(o1) -> runs(mp.UF(c, eo, b, cd, st)[regs], S, o1) proof
    fix o1
    assume pu1 sh1
    have c0: !ord_le(1, seq_len(regs)) -> runs(mp.UF(c, eo, b, cd, st)[regs], S, o1) proof
      assume n0
      show := apply(mp.top_mfun0[I := mallocng.inv(c), O := mallocng.owned(c), eo := eo, b := b, cd := cd, st := st, regs := regs, S := S, o := o1], hra, pu1, n0)
    qed
    have c1: !mp.MPRE(c, eo, b, cd, st, S) -> runs(mp.UF(c, eo, b, cd, st)[regs], S, o1) proof
      assume n1
      show := apply(mp.top_mfun[I := mallocng.inv(c), O := mallocng.owned(c), eo := eo, b := b, cd := cd, st := st, regs := regs, S := S, o := o1], hra, pu1, sh1,
        apply(mp.top_many[I := mallocng.inv(c), O := mallocng.owned(c), eo := eo, b := b, cd := cd, st := st, n := regs[0], S := S, o := o1], pu1, n1))
    qed
    show by taut(hn, c0, c1)
  qed
  have k1: (ex m1 e. o = ok(m1, e)) -> runs(abi.wide(malloc.Heap.ghost, mp.UF(c, eo, b, cd, st))[regs], S, o) proof
    assume e
    obtain x v, eo1 from e
    obtain r y, _ hy ev from apply(cart_elim, mp(all_elim(hv, {x}, {v}), eo1))
    have pu2: pair(S, ok(x, pair(r, y))) in univ(1) := rewrite(ev, rewrite(eo1, pu))
    have pu1: pair(S, ok(x, r)) in univ(1) by simp(pu2)
    have sh1: abi.outcome(ok(x, r)) by disj({1}, ex_intro({x}, {r}, refl({ok(x, r)})))
    have w := apply(mp.top_wide[G := malloc.Heap.ghost, F := mp.UF(c, eo, b, cd, st), regs := regs, S := S, o2 := ok(x, pair(r, y))], hra, pu2,
      apply(mp.wr_ok, hy, mp(all_elim(fr, {ok(x, r)}), pu1, sh1)))
    show := rewrite(sym(eo1), rewrite(sym(ev), w))
  qed
  have k2: (ex m1 e. o = exc(m1, e)) -> runs(abi.wide(malloc.Heap.ghost, mp.UF(c, eo, b, cd, st))[regs], S, o) proof
    assume e
    obtain x ee, eo1 from e
    have pu1 := rewrite(eo1, pu)
    have sh1 := rewrite(eo1, hsh)
    have w := apply(mp.top_wide[G := malloc.Heap.ghost, F := mp.UF(c, eo, b, cd, st), regs := regs, S := S, o2 := exc(x, ee)], hra, pu1,
      apply(mp.wr_exc, mp(all_elim(fr, {exc(x, ee)}), pu1, sh1)))
    show := rewrite(sym(eo1), w)
  qed
  have k3: (ex t. o = diverge(t)) -> runs(abi.wide(malloc.Heap.ghost, mp.UF(c, eo, b, cd, st))[regs], S, o) proof
    assume e
    obtain t, eo1 from e
    have pu1 := rewrite(eo1, pu)
    have sh1 := rewrite(eo1, hsh)
    have w := apply(mp.top_wide[G := malloc.Heap.ghost, F := mp.UF(c, eo, b, cd, st), regs := regs, S := S, o2 := diverge(t)], hra, pu1,
      apply(mp.wr_div, mp(all_elim(fr, {diverge(t)}), pu1, sh1)))
    show := rewrite(sym(eo1), w)
  qed
  show by taut(hsh, k1, k2, k3)
qed

// ... with its argument first of any list of arguments
theorem mp.dm_post(c, g, regs, t, h, o2): mp.mi_call(c, g) -> regs in abi.ARGS -> ord_le(1, seq_len(regs)) -> t in abi.World -> h in mp.G ->
  mallocng.holds_m(c, h.A, t.vm, h.blocks) -> mallocng.shown_in(c, h.A, t.objs) -> mallocng.no_reserved(h.A) -> seq_len(h.A.taken) = 0 ->
  abi.thread_ok(t.vm, t.fs_base) -> mallocng_specs.tls_apart(c, h.A, t.fs_base) ->
  abi.brk_start_ok(t.vm) -> mallocng_specs.errno_ok(t.vm, t.objs, t.fs_base) -> mallocng_specs.errno_apart(c, h.A, t.vm, t.fs_base) ->
  runs(c_src_malloc_lite_malloc.default_malloc_fun(g)[regs], t, o2) -> mp.mi_post(c, regs[0], t, h, o2)
proof
  assume hmi ra o1l hw hh hin hsh hnr htk hth htl hbs heo hea hr
  have rl _ := (regs in list_type(bits(64)) && ord_le(seq_len(regs), 6) by simp(ra))
  have lo: seq_len(regs) in omega by simp(rl)
  have l1: int_le(1, seq_len(regs)) proof
    have c1: 1 in seq_len(regs) -> int_le(1, seq_len(regs)) proof
      assume m
      show by arith(apply(nat_mem_lt[k := seq_len(regs), i := 1], lo, m))
    qed
    have c2: 1 = seq_len(regs) -> int_le(1, seq_len(regs)) proof
      assume e
      show by arith(e)
    qed
    show by taut(expand(o1l, ord_le), c1, c2)
  qed
  have hnb := apply(at_type[l := regs, t := bits(64), i := 0], rl, simp(), (int_lt(0, seq_len(regs)) by arith(l1)))
  have bp: bits_of_int(64, regs[0]) = regs[0] by defs(simp(hnb), bits_of_int, pow2)
  step o3 V p, e hs1 from hr with o1l, bp, mp.dm_run2 using ra, hnb, hmi, hw, hh, hin, hsh, hnr, htk, hth, htl, hbs, heo, hea
  have hv hpb hex := hs1
  step o4 y, e2 from e with g.result64_inv using hpb
  have fp: fst(pair(p, y)) = p by simp()
  have hex2 := subst({z. ex X. mp.mi_ret(c, h.A, regs[0], h.blocks, t, X, V, z)}, sym(fp), hex)
  show by disj({2}, ex_intro({V}, {pair(p, y)}, taut(hv, hex2, e2)))
qed

// (a run of a C function value: in the universe)
theorem mp.fv_univ(F, regs, s, o): F in fn_space(abi.ARGS, powerset(univ(1))) -> regs in abi.ARGS -> runs(F[regs], s, o) -> pair(s, o) in univ(1)
proof
  assume hf hra hr
  have pw := apply(fn_space_app, hf, hra)
  have ss: subset(F[regs], univ(1)) by taut(powerset_def[s := univ(1), a := F[regs]], pw)
  show := apply(subset_elim, ss, expand(hr, runs))
qed

// The `malloc` symbol from the world s with the layer's ghost part h,
// where the layer's malloc is undefined: its outcome o the layer's (the
// live blocks as they were)
theorem mp.top_undef(c, eo, b, cd, st, regs, s, h, o): regs in abi.ARGS -> s in abi.World -> h in malloc.Heap.ghost -> pair(s, o) in univ(1) -> abi.outcome(o) ->
  (all x v. o = ok(x, v) -> v in cart(bits(64), bits(64))) -> !(ord_le(1, seq_len(regs)) && mp.MPRE(c, eo, b, cd, st, union2(s, h))) ->
  ex h2. h2 in malloc.Heap.ghost && runs(abi.wide(malloc.Heap.ghost, mp.UF(c, eo, b, cd, st))[regs], union2(s, h), with_ghost(o, h2))
proof
  assume hra hs hh pu hsh hv hn
  have hu _ _ := mp(all_elim(mp.hg_ok, {h}), hh)
  have pu0 ou0 := apply(abi.wg_univ, pu, hu, hsh)
  have wt: all x v. with_ghost(o, h) = ok(x, v) -> v in cart(bits(64), bits(64)) proof
    fix x v
    assume e
    have k1: (ex m1 e1. o = ok(m1, e1)) -> v in cart(bits(64), bits(64)) proof
      assume w
      obtain m1 e1, eo1 from w
      have e2: ok(union2(m1, h), e1) = ok(x, v) := trans(sym(all_elim(abi.wg_ok, {m1}, {e1}, {h})), rewrite(eo1, e))
      have ve: e1 = v by simp(e2)
      show := rewrite(ve, mp(all_elim(hv, {m1}, {e1}), eo1))
    qed
    have k2: (ex m1 e1. o = exc(m1, e1)) -> v in cart(bits(64), bits(64)) proof
      assume w
      obtain m1 e1, eo1 from w
      have e2: exc(union2(m1, h), e1) = ok(x, v) := trans(sym(all_elim(abi.wg_exc, {m1}, {e1}, {h})), rewrite(eo1, e))
      show by simp(e2)
    qed
    have k3: (ex t. o = diverge(t)) -> v in cart(bits(64), bits(64)) proof
      assume w
      obtain t, eo1 from w
      have e2: diverge(t) = ok(x, v) := trans(sym(all_elim(abi.wg_div, {t}, {h})), rewrite(eo1, e))
      show by simp(e2)
    qed
    show by taut(hsh, k1, k2, k3)
  qed
  have r := apply(mp.top_any[c := c, eo := eo, b := b, cd := cd, st := st, regs := regs, S := union2(s, h), o := with_ghost(o, h)], hra, pu0, ou0, wt, hn)
  show by ex_intro({h}, taut(hh, r))
qed

// (a return's state: the world's new memory V and the ghost part h2 --
// the layer's state's memory and live blocks replaced)
theorem mp.top_rec(s, h, h2, V): s in abi.World -> s in univ(1) -> h in malloc.Heap.ghost -> h2 in malloc.Heap.ghost -> V in x86_64_linux.Vm ->
  h2 = h || (ex B2. h2 = fn_update(h, "blocks", B2)) ->
  typ: union2(fn_update(s, "vm", V), h2) in rec_and(abi.World, malloc.Heap.ghost) &&
  eq: union2(fn_update(s, "vm", V), h2) = fn_update(fn_update(union2(s, h), "blocks", h2.blocks), "vm", V) &&
  uv: union2(fn_update(s, "vm", V), h2) in univ(1) && fun: is_fun(union2(fn_update(s, "vm", V), h2)) && vmd: "vm" in dom(union2(fn_update(s, "vm", V), h2))
proof
  assume hs su hh hh2 hv hk
  have _ _ wv wvu := apply(tr.world_set[w := s, v := V, os := s.os, fs := s.fs_base], hs, su, hv, apply(x86.vm_univ, hv), (s.os in x86_64_linux.Os by simp(hs)),
    mp(app_univ[u := 1, f := s, k := "os"], su), (s.fs_base in bits(64) by simp(hs)))
  have typ := apply(rec_and_intro, wv, hh2)
  have sd: dom(s) = insert("vm", insert("os", insert("fs_base", insert("cpu", insert("objs", empty))))) by simp(expand(hs, abi.World))
  have sk := apply(abi.keys_of[f := s, d := insert("vm", insert("os", insert("fs_base", insert("cpu", insert("objs", empty)))))], sd)
  have nb: all z. z in s -> fst(z) != "blocks" proof
    fix z
    assume hz
    show by simp(mp(all_elim(sk, {z}), hz))
  qed
  have _ _ k2 := mp(all_elim(mp.hg_ok, {h2}), hh2)
  have nv: all z. z in h2 -> fst(z) != "vm" proof
    fix z
    assume hz
    have _ w := mp(all_elim(k2, {z}), hz)
    show by simp(w)
  qed
  have hd: dom(h) = insert("blocks", empty) by simp(expand(hh, malloc.Heap.ghost))
  have hf: is_fun(h) by simp(expand(hh, malloc.Heap.ghost))
  // h2: h with its blocks h2's
  have hb: h2 = fn_update(h, "blocks", h2.blocks) proof
    have c1: h2 = h -> h2 = fn_update(h, "blocks", h2.blocks) proof
      assume e
      have s1 := mp(fn_update_same[f := h, k := "blocks"], hf, (("blocks" in dom(h)) by simp(hd)))
      show := rewrite(sym(e), sym(s1))
    qed
    have c2: (ex B2. h2 = fn_update(h, "blocks", B2)) -> h2 = fn_update(h, "blocks", h2.blocks) proof
      assume w
      obtain B2, e from w
      have ab: h2.blocks = B2 := rewrite(sym(e), app_update_same[f := h, k := "blocks", v := B2])
      show := rewrite(sym(ab), e)
    qed
    show by taut(hk, c1, c2)
  qed
  have e1 := mp(fn_update_union_r[a := s, b := h, k := "blocks", v := h2.blocks], nb)
  have e2 := mp(fn_update_union_l[a := s, b := h2, k := "vm", v := V], nv)
  have e1b := rewrite(sym(hb), e1)
  have e3: fn_update(fn_update(union2(s, h), "blocks", h2.blocks), "vm", V) = union2(fn_update(s, "vm", V), h2) :=
    trans(subst({w. fn_update(fn_update(union2(s, h), "blocks", h2.blocks), "vm", V) = fn_update(w, "vm", V)}, e1b,
      refl({fn_update(fn_update(union2(s, h), "blocks", h2.blocks), "vm", V)})), e2)
  // (the record: in the universe, a function, its memory a field)
  have h2u h2f _ := mp(all_elim(mp.hg_ok, {h2}), hh2)
  have uv := mp(union2_univ[u := 1, a := fn_update(s, "vm", V), b := h2], wvu, h2u)
  have sf: is_fun(s) by simp(expand(hs, abi.World))
  have wf := mp(fn_update_fun[f := s, k := "vm", v := V], sf)
  have wd: dom(fn_update(s, "vm", V)) = abi.WKEYS := rewrite(sd, mp(fn_update_dom[f := s, k := "vm", v := V], sf, (("vm" in dom(s)) by simp(sd))))
  have wk := apply(abi.keys_of[f := fn_update(s, "vm", V), d := abi.WKEYS], wd)
  have dj: all z w. z in fn_update(s, "vm", V) -> w in h2 -> fst(z) != fst(w) proof
    fix z w
    assume hz hw
    have a1 := mp(all_elim(wk, {z}), hz)
    have _ a2 := mp(all_elim(k2, {w}), hw)
    assume e
    show by taut(a2, rewrite(e, a1))
  qed
  have fun := apply(union2_fun, wf, h2f, dj)
  have vmd: "vm" in dom(union2(fn_update(s, "vm", V), h2)) by simp(dom_union2[a := fn_update(s, "vm", V), b := h2], wd)
  show by taut(typ, sym(e3), uv, fun, vmd)
qed

// (the layer's state s with h: a function, its blocks a field)
theorem mp.top_sfun(s, h): s in abi.World -> h in malloc.Heap.ghost -> is_fun(union2(s, h)) && "blocks" in dom(union2(s, h))
proof
  assume hs hh
  have sd: dom(s) = abi.WKEYS by simp(expand(hs, abi.World))
  have hd: dom(h) = insert("blocks", empty) by simp(expand(hh, malloc.Heap.ghost))
  have sf: is_fun(s) by simp(expand(hs, abi.World))
  have _ hf k2 := mp(all_elim(mp.hg_ok, {h}), hh)
  have sk := apply(abi.keys_of[f := s, d := abi.WKEYS], sd)
  have dj: all z w. z in s -> w in h -> fst(z) != fst(w) proof
    fix z w
    assume hz hw
    have a1 := mp(all_elim(sk, {z}), hz)
    have _ a2 := mp(all_elim(k2, {w}), hw)
    assume e
    show by taut(a2, rewrite(e, a1))
  qed
  have f := apply(union2_fun, sf, hf, dj)
  have d: "blocks" in dom(union2(s, h)) by simp(dom_union2[a := s, b := h], hd)
  show by taut(f, d)
qed

// (a block of size n made at p: the blocks in the universe)
theorem mp.sb_bu(b, p, n): b in fn_space(bits(64), option(omega)) -> n in omega -> malloc.set_block(b, p, some(n)) in univ(1)
proof
  assume hb hn
  have smu: all x. x in omega -> some(x) in univ(1) proof
    fix x
    assume hx
    have xu := mp(mp(univ_trans[u := 1, a := x, b := omega], omega_univ), hx)
    show by defs(simp(xu), some)
  qed
  have imu := mp(mp(univ_image[u := 1, s := omega, f := x. some(x)], omega_univ), smu)
  have nu: single(none) in univ(1) by defs(simp(), single, none)
  have ou: option(omega) in univ(1) by defs(mp(mp(union2_univ[u := 1, a := single(none), b := set_image(omega, x. some(x))], nu), imu), option)
  show := mp(fn_space_univ[u := 1, a := bits(64), b := option(omega), f := malloc.set_block(b, p, some(n))], bits_univ[n := 64], ou, apply(mp.sb_btype, hb, hn))
qed

// The `malloc` symbol's 0 (`mp.mi_zero`, from A at the layer's state):
// the layer's malloc's, out of memory
theorem mp.top_zero(c, eo, b, cd, st, regs, s, h, A, A2, V, y, k): c in mallocng.Cfg -> app(eo, empty) = 52 -> regs in abi.ARGS -> ord_le(1, seq_len(regs)) ->
  s in abi.World -> s in univ(1) -> h in malloc.Heap.ghost -> mp.MPRE(c, eo, b, cd, st, union2(s, h)) -> A in mallocng.Abs -> mallocng.rep(c, A, union2(s, h)) ->
  V in x86_64_linux.Vm -> y in bits(64) -> mp.mi_zero(c, A, h.blocks, s, A2, V) -> mp.code_img(c, app(b, empty), app(cd, empty), k) ->
  runs(abi.wide(malloc.Heap.ghost, mp.UF(c, eo, b, cd, st))[regs], union2(s, h), with_ghost(ok(fn_update(s, "vm", V), pair(0, y)), h))
proof
  assume hc he hra o1l hs su hh hpre ha hrep hv hy hz0 hci
  let S := union2(s, h)
  have hinv heo hwo := hpre
  have au := apply(mallocng.abs_univ, ha)
  have sd: dom(s) = abi.WKEYS by simp(expand(hs, abi.World))
  have hd: dom(h) = insert("blocks", empty) by simp(expand(hh, malloc.Heap.ghost))
  have vS: S.vm = s.vm by simp(sd, hd)
  have oS: S.objs = s.objs by simp(sd, hd)
  have fS: S.fs_base = s.fs_base by simp(sd, hd)
  have bS: S.blocks = h.blocks by simp(sd, hd)
  have fsb: S.fs_base in bits(64) := rewrite(sym(fS), (s.fs_base in bits(64) by simp(hs)))
  have bt: S.blocks in fn_space(bits(64), option(omega)) := rewrite(sym(bS), (h.blocks in fn_space(bits(64), option(omega)) by simp(expand(hh, malloc.Heap.ghost))))
  have hz := rewrite(sym(bS), rewrite(sym(fS), rewrite(sym(oS), rewrite(sym(vS), hz0))))
  have a2a a2u nr2 tk2 v2v hm2 hsh2 hun hfp hen := hz
  have _ _ th cn _ _ _ := expand(hwo, malloc.world_ok)
  have {eap = apart} := apply(mp.top_pre[c := c, A := A, S := S, eo := eo, b := b, cd := cd, st := st], fsb, hrep, he, heo, hwo)
  have rep2 := apply(mp.top_mzero[c := c, A := A, S := S, A2 := A2, V2 := V], hc, au, ha, bt, fsb, hrep, th, cn, eap, hz)
  // the new state T: the layer's state with the memory V
  let T := fn_update(S, "vm", V)
  have {typ = typ, eq = eq, uv = uv, fun = fun, vmd = vmd} := apply(mp.top_rec[s := s, h := h, h2 := h, V := V], hs, su, hh, hh, hv, disj({1}, refl({h})))
  have sf sb := apply(mp.top_sfun, hs, hh)
  have same := rewrite(bS, mp(fn_update_same[f := S, k := "blocks"], sf, sb))
  have te: union2(fn_update(s, "vm", V), h) = T := rewrite(same, eq)
  have tg := rewrite(te, typ)
  have tu := rewrite(te, uv)
  have tf := rewrite(te, fun)
  have td := rewrite(te, vmd)
  have tv: T.vm = V by simp()
  have tb: T.blocks = S.blocks by simp()
  have sg := apply(rec_and_intro, hs, hh)
  have stp := apply(mp.top_step[c := c, A := A, S := S, T := T, A2 := A2, eo := eo, b := b, cd := cd, st := st], hc, ha, a2a, sg, tg, fsb, he, hrep, rep2, th, hwo,
    rewrite(sym(tv), hun),
    subst({w. all a. a in omega -> a in mallocng.footprint(c, A2, w) -> a in mallocng.footprint(c, A, S.blocks) || (!x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) && !mallocng.in_stack_space(S.vm, a))}, sym(tb), hfp))
  have Su: S in univ(1) := mp(union2_univ[u := 1, a := s, b := h], su, (h in univ(1) by taut(mp(all_elim(mp.hg_ok, {h}), hh))))
  // (the world after: as any call needs it)
  have svm: S.vm in x86_64_linux.Vm := rewrite(sym(vS), (s.vm in x86_64_linux.Vm by simp(expand(hs, abi.World))))
  have wk := apply(mp.wok_kept[c := c, A := A, A2 := A2, S := S, T := T, objs := S.objs, E := mp.errno(S.fs_base), b := b, cd := cd, st := st, k := k],
    hc, au, ha, a2u, a2a, bt, svm, rewrite(sym(tb), bt), rewrite(sym(tv), hv), fsb, hrep, rep2, hwo, rewrite(sym(tv), hun), mp.errno_off[fs := S.fs_base],
    (T.objs = S.objs by simp()), (T.fs_base = S.fs_base by simp()), hci)
  have oom := apply(mp.top_oom[I := mallocng.inv(c), O := mallocng.owned(c), eo := eo, b := b, cd := cd, st := st, S := S, V := V], Su, hv, fsb, he, tu, tf, td, stp, wk, hen)
  // the layer's malloc returning 0 there, as a C function value, widened
  have pu: pair(S, ok(T, 0)) in univ(1) by simp(Su, tu)
  have mf := apply(mp.top_mfail[I := mallocng.inv(c), O := mallocng.owned(c), eo := eo, b := b, cd := cd, st := st, n := regs[0], S := S, T := T], pu, oom)
  have sh: abi.outcome(ok(T, 0)) by disj({1}, ex_intro({T}, {0}, refl({ok(T, 0)})))
  have fv := apply(mp.top_mfun[I := mallocng.inv(c), O := mallocng.owned(c), eo := eo, b := b, cd := cd, st := st, regs := regs, S := S, o := ok(T, 0)], hra, pu, sh, mf)
  have pu2: pair(S, ok(T, pair(0, y))) in univ(1) by simp(Su, tu, hy)
  have w := apply(mp.top_wide[G := malloc.Heap.ghost, F := mp.UF(c, eo, b, cd, st), regs := regs, S := S, o2 := ok(T, pair(0, y))], hra, pu2,
    apply(mp.wr_ok[F := mp.UF(c, eo, b, cd, st), regs := regs, S := S, x := T, r := 0, y := y], hy, fv))
  show := rewrite(sym(all_elim(abi.wg_ok, {fn_update(s, "vm", V)}, {pair(0, y)}, {h})), rewrite(sym(te), w))
qed

// The `malloc` symbol's block p (`mp.mi_blk`, from A at the layer's
// state): the layer's malloc's, the block live after
theorem mp.top_blk(c, eo, b, cd, st, regs, s, h, A, A3, V, p, y, k): c in mallocng.Cfg -> app(eo, empty) = 52 -> regs in abi.ARGS -> ord_le(1, seq_len(regs)) ->
  s in abi.World -> s in univ(1) -> h in malloc.Heap.ghost -> mp.MPRE(c, eo, b, cd, st, union2(s, h)) -> A in mallocng.Abs -> mallocng.rep(c, A, union2(s, h)) ->
  V in x86_64_linux.Vm -> y in bits(64) -> regs[0] in omega -> mp.mi_blk(c, A, regs[0], h.blocks, s, A3, V, p) -> mp.code_img(c, app(b, empty), app(cd, empty), k) ->
  ex h2. h2 in malloc.Heap.ghost && runs(abi.wide(malloc.Heap.ghost, mp.UF(c, eo, b, cd, st))[regs], union2(s, h), with_ghost(ok(fn_update(s, "vm", V), pair(p, y)), h2))
proof
  assume hc he hra o1l hs su hh hpre ha hrep hv hy hn hb0 hci
  let S := union2(s, h)
  let n := regs[0]
  have hinv heo hwo := hpre
  have au := apply(mallocng.abs_univ, ha)
  have sd: dom(s) = abi.WKEYS by simp(expand(hs, abi.World))
  have hd: dom(h) = insert("blocks", empty) by simp(expand(hh, malloc.Heap.ghost))
  have vS: S.vm = s.vm by simp(sd, hd)
  have oS: S.objs = s.objs by simp(sd, hd)
  have fS: S.fs_base = s.fs_base by simp(sd, hd)
  have bS: S.blocks = h.blocks by simp(sd, hd)
  have fsb: S.fs_base in bits(64) := rewrite(sym(fS), (s.fs_base in bits(64) by simp(hs)))
  have bt: S.blocks in fn_space(bits(64), option(omega)) := rewrite(sym(bS), (h.blocks in fn_space(bits(64), option(omega)) by simp(expand(hh, malloc.Heap.ghost))))
  have hb := rewrite(sym(bS), rewrite(sym(fS), rewrite(sym(oS), rewrite(sym(vS), hb0))))
  have a3a a3u nr3 tk3 v3v pb pnz bn hm3 hsh3 hun hfp hbr := hb
  have _ _ th cn _ _ _ := expand(hwo, malloc.world_ok)
  have {eap = apart} := apply(mp.top_pre[c := c, A := A, S := S, eo := eo, b := b, cd := cd, st := st], fsb, hrep, he, heo, hwo)
  have {rep3 = rep, al = align, ext = ext} := apply(mp.top_mblk[c := c, A := A, S := S, n := n, A3 := A3, V3 := V, p := p], hc, au, ha, bt, fsb, hn, hrep, th, cn, eap, hb)
  // the new state T: the block live, the memory V
  let B2 := malloc.set_block(S.blocks, p, some(n))
  let H2 := fn_update(h, "blocks", B2)
  let T := fn_update(fn_update(S, "blocks", B2), "vm", V)
  have hg2 := apply(mp.hg_updb[h := h, b2 := B2], hh, apply(mp.sb_btype[b := S.blocks, p := p, n := n], bt, hn), apply(mp.sb_bu[b := S.blocks, p := p, n := n], bt, hn))
  have {typ = typ, eq = eq, uv = uv} := apply(mp.top_rec[s := s, h := h, h2 := H2, V := V], hs, su, hh, hg2, hv, disj({2}, ex_intro({B2}, refl({H2}))))
  have hb2: H2.blocks = B2 := app_update_same[f := h, k := "blocks", v := B2]
  have te: union2(fn_update(s, "vm", V), H2) = T := rewrite(hb2, eq)
  have tg := rewrite(te, typ)
  have tu := rewrite(te, uv)
  have tv: T.vm = V by simp()
  have tb: T.blocks = B2 by simp()
  have sg := apply(rec_and_intro, hs, hh)
  have stp := apply(mp.top_step[c := c, A := A, S := S, T := T, A2 := A3, eo := eo, b := b, cd := cd, st := st], hc, ha, a3a, sg, tg, fsb, he, hrep, rep3, th, hwo,
    rewrite(sym(tv), hun),
    subst({w. all a. a in omega -> a in mallocng.footprint(c, A3, w) -> a in mallocng.footprint(c, A, S.blocks) || (!x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) && !mallocng.in_stack_space(S.vm, a))}, sym(tb), hfp))
  // its place fresh: the allocator's before or unmapped
  have fr: malloc.fresh_block(mallocng.owned(c), S, p, n) proof
    have fa: all a. a in omega -> a in malloc.range(p, malloc.extent(n)) -> a in mallocng.owned(c)[S] || !x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) proof
      fix a
      assume ao ar
      have c1: a in mallocng.footprint(c, A, S.blocks) -> a in mallocng.owned(c)[S] proof
        assume w
        show := apply(mallocng.owned_intro[c := c, s := S, A := A, a := a], sg, ha, hrep, ao, w)
      qed
      show by taut(mp(all_elim(ext, {a}), ao, ar), c1)
    qed
    show by defs(taut(bn, fa), malloc.fresh_block)
  qed
  have Su: S in univ(1) := mp(union2_univ[u := 1, a := s, b := h], su, (h in univ(1) by taut(mp(all_elim(mp.hg_ok, {h}), hh))))
  have pu: pair(S, ok(T, p)) in univ(1) by simp(Su, tu, pb)
  // (the world after: as any call needs it)
  have svm: S.vm in x86_64_linux.Vm := rewrite(sym(vS), (s.vm in x86_64_linux.Vm by simp(expand(hs, abi.World))))
  have b2t := apply(mp.sb_btype[b := S.blocks, p := p, n := n], bt, hn)
  have wk := apply(mp.wok_kept[c := c, A := A, A2 := A3, S := S, T := T, objs := S.objs, E := mp.errno(S.fs_base), b := b, cd := cd, st := st, k := k],
    hc, au, ha, a3u, a3a, bt, svm, rewrite(sym(tb), b2t), rewrite(sym(tv), hv), fsb, hrep, rep3, hwo, rewrite(sym(tv), hun), mp.errno_off[fs := S.fs_base],
    (T.objs = S.objs by simp()), (T.fs_base = S.fs_base by simp()), hci)
  have mk := apply(mp.top_mok[I := mallocng.inv(c), O := mallocng.owned(c), eo := eo, b := b, cd := cd, st := st, n := n, S := S, p := p, V := V], hn, pb, pnz, al, fr, hv, stp, wk, pu)
  have sh: abi.outcome(ok(T, p)) by disj({1}, ex_intro({T}, {p}, refl({ok(T, p)})))
  have fv := apply(mp.top_mfun[I := mallocng.inv(c), O := mallocng.owned(c), eo := eo, b := b, cd := cd, st := st, regs := regs, S := S, o := ok(T, p)], hra, pu, sh, mk)
  have pu2: pair(S, ok(T, pair(p, y))) in univ(1) by simp(Su, tu, hy, pb)
  have w := apply(mp.top_wide[G := malloc.Heap.ghost, F := mp.UF(c, eo, b, cd, st), regs := regs, S := S, o2 := ok(T, pair(p, y))], hra, pu2,
    apply(mp.wr_ok[F := mp.UF(c, eo, b, cd, st), regs := regs, S := S, x := T, r := p, y := y], hy, fv))
  have r := rewrite(sym(all_elim(abi.wg_ok, {fn_update(s, "vm", V)}, {pair(p, y)}, {H2})), rewrite(sym(te), w))
  show by ex_intro({H2}, taut(hg2, r))
qed

// ... where it is defined: from A (rep), the purpose spec's ghost part
// union2(h, {A}); the code's outcome mallocng's (`mp.mi_post`)
theorem mp.top_post(c, eo, b, cd, st, g, regs, s, h, o): app(eo, empty) = 52 -> mp.mi_call(c, g) -> regs in abi.ARGS -> s in abi.World -> h in malloc.Heap.ghost ->
  runs(c_src_malloc_lite_malloc.default_malloc_fun(g)[regs], s, o) -> ord_le(1, seq_len(regs)) -> mp.MPRE(c, eo, b, cd, st, union2(s, h)) ->
  ex A. A in mallocng.Abs && mallocng.rep(c, A, union2(s, h)) && mp.mi_post(c, regs[0], s, union2(h, fn_update(empty, "A", A)), o)
proof
  assume he hmi hra hs hh hr o1l hpre
  let S := union2(s, h)
  have hinv heo hwo := hpre
  obtain A, ha hrep from apply(mallocng.inv_rep, hinv)
  let HA := union2(h, fn_update(empty, "A", A))
  have au := apply(mallocng.abs_univ, ha)
  have hag := apply(rec_and_intro, hh, apply(mp.abs_rec, ha, au))
  have sd: dom(s) = insert("vm", insert("os", insert("fs_base", insert("cpu", insert("objs", empty))))) by simp(expand(hs, abi.World))
  have hd: dom(h) = insert("blocks", empty) by simp(expand(hh, malloc.Heap.ghost))
  have vS: S.vm = s.vm by simp(sd, hd)
  have oS: S.objs = s.objs by simp(sd, hd)
  have fS: S.fs_base = s.fs_base by simp(sd, hd)
  have bS: S.blocks = h.blocks by simp(sd, hd)
  have aA: HA.A = A by simp(hd)
  have bA: HA.blocks = h.blocks by simp(hd)
  have fsb: s.fs_base in bits(64) by simp(hs)
  have {hin = hin, th = thread, tl = tls, bk = brk, eok = errno, eap = apart} := apply(mp.top_pre[c := c, A := A, S := S, eo := eo, b := b, cd := cd, st := st],
    rewrite(sym(fS), fsb), hrep, he, heo, hwo)
  have {hm = mem, hsh = shown} := hin
  have {nr = unres, tk = untaken} := expand(hrep, mallocng.rep)
  have q1: mallocng.holds_m(c, HA.A, s.vm, HA.blocks) := rewrite(sym(bA), rewrite(sym(aA), rewrite(bS, rewrite(vS, hm))))
  have q2: mallocng.shown_in(c, HA.A, s.objs) := rewrite(sym(aA), rewrite(oS, hsh))
  have q3: mallocng.no_reserved(HA.A) := rewrite(sym(aA), nr)
  have q4: seq_len(HA.A.taken) = 0 := rewrite(sym(aA), tk)
  have q5: abi.thread_ok(s.vm, s.fs_base) := rewrite(fS, rewrite(vS, th))
  have q6: mallocng_specs.tls_apart(c, HA.A, s.fs_base) := rewrite(sym(aA), rewrite(fS, tl))
  have q7: abi.brk_start_ok(s.vm) := rewrite(vS, bk)
  have q8: mallocng_specs.errno_ok(s.vm, s.objs, s.fs_base) := rewrite(fS, rewrite(oS, rewrite(vS, eok)))
  have q9: mallocng_specs.errno_apart(c, HA.A, s.vm, s.fs_base) := rewrite(sym(aA), rewrite(fS, rewrite(vS, eap)))
  have post := apply(mp.dm_post[c := c, g := g, regs := regs, t := s, h := HA, o2 := o], hmi, hra, o1l, hs, hag, q1, q2, q3, q4, q5, q6, q7, q8, q9, hr)
  show by ex_intro({A}, taut(ha, hrep, post))
qed

// The `malloc` symbol's code (over any __libc_malloc_impl called as such)
// refines the layer's malloc, but for stack overflows keeping the I/O
theorem mp.top_ref(c, eo, b, cd, st, g, regs, k): c in mallocng.Cfg -> app(eo, empty) = 52 -> mp.mi_call(c, g) -> regs in abi.ARGS ->
  mp.code_img(c, app(b, empty), app(cd, empty), k) ->
  abi.refines_ovf(c_src_malloc_lite_malloc.default_malloc_fun(g)[regs], abi.wide(malloc.Heap.ghost, mp.UF(c, eo, b, cd, st))[regs], malloc.Heap.ghost)
proof
  assume hc he hmi hra hci
  fix s h
  assume hs hh
  fix o
  assume hr hsh hv
  let S := union2(s, h)
  let GOAL := (ex h2. h2 in malloc.Heap.ghost && runs(abi.wide(malloc.Heap.ghost, mp.UF(c, eo, b, cd, st))[regs], S, with_ghost(o, h2))) ||
    (ex x. o = exc(x, exc_val("stack_overflow", empty)) && x.os = s.os)
  have ty: c_src_malloc_lite_malloc.default_malloc_fun(g) in fn_space(abi.ARGS, powerset(univ(1))) by defs(tr.fun_typed, c_src_malloc_lite_malloc.default_malloc_fun)
  have pu := apply(mp.fv_univ, ty, hra, hr)
  have su: s in univ(1) by simp(pu)
  // undefined: anything
  have cu: !(ord_le(1, seq_len(regs)) && mp.MPRE(c, eo, b, cd, st, S)) -> GOAL proof
    assume hn
    show by disj({1}, apply(mp.top_undef[c := c, eo := eo, b := b, cd := cd, st := st, regs := regs, s := s, h := h, o := o], hra, hs, hh, pu, hsh, hv, hn))
  qed
  // defined: the code's outcome mallocng's
  have cdf: ord_le(1, seq_len(regs)) && mp.MPRE(c, eo, b, cd, st, S) -> GOAL proof
    assume hd0
    have o1l hpre := hd0
    obtain A, ha hrep hpost from apply(mp.top_post[c := c, eo := eo, b := b, cd := cd, st := st, g := g, regs := regs, s := s, h := h, o := o], he, hmi, hra, hs, hh, hr, o1l, hpre)
    let HA := union2(h, fn_update(empty, "A", A))
    have hdm: dom(h) = insert("blocks", empty) by simp(expand(hh, malloc.Heap.ghost))
    have aA: HA.A = A by simp(hdm)
    have bA: HA.blocks = h.blocks by simp(hdm)
    have rl _ := (regs in list_type(bits(64)) && ord_le(seq_len(regs), 6) by simp(hra))
    have lo: seq_len(regs) in omega by simp(rl)
    have l1: int_le(1, seq_len(regs)) proof
      have c1: 1 in seq_len(regs) -> int_le(1, seq_len(regs)) proof
        assume m
        show by arith(apply(nat_mem_lt[k := seq_len(regs), i := 1], lo, m))
      qed
      have c2: 1 = seq_len(regs) -> int_le(1, seq_len(regs)) proof
        assume e
        show by arith(e)
      qed
      show by taut(expand(o1l, ord_le), c1, c2)
    qed
    have r0b := apply(at_type[l := regs, t := bits(64), i := 0], rl, simp(), (int_lt(0, seq_len(regs)) by arith(l1)))
    have hn: regs[0] in omega by arith(r0b)
    // an overflow: the ABI's
    have k1: abi.ovf_out(s, o) -> GOAL proof
      assume w
      obtain v ob, _ _ eo1 from w
      show by disj({2}, ex_intro({fn_update(fn_update(s, "vm", v), "objs", ob)}, simp(eo1)))
    qed
    // a return: 0 or a block
    have k2: (ex V rr. (V in x86_64_linux.Vm && (ex A2. mp.mi_ret(c, HA.A, regs[0], HA.blocks, s, A2, V, fst(rr)))) && o = ok(fn_update(s, "vm", V), rr)) -> GOAL proof
      assume w
      obtain V rr, hv2 hex ho from w
      obtain p y, _ hy er from apply(cart_elim, mp(all_elim(hv, {fn_update(s, "vm", V)}, {rr}), ho))
      obtain A2, hret0 from hex
      have fp: fst(rr) = p by simp(er)
      have hret := rewrite(fp, rewrite(bA, rewrite(aA, hret0)))
      have oe: o = ok(fn_update(s, "vm", V), pair(p, y)) := rewrite(er, ho)
      have z: p = 0 && mp.mi_zero(c, A, h.blocks, s, A2, V) -> GOAL proof
        assume q
        have q0 qz := q
        have r := apply(mp.top_zero[c := c, eo := eo, b := b, cd := cd, st := st, regs := regs, s := s, h := h, A := A, A2 := A2, V := V, y := y, k := k],
          hc, he, hra, o1l, hs, su, hh, hpre, ha, hrep, hv2, hy, qz, hci)
        have r2 := rewrite(sym(oe), rewrite(sym(q0), r))
        show by disj({1}, ex_intro({h}, taut(hh, r2)))
      qed
      have k: !(p = 0) && mp.mi_blk(c, A, regs[0], h.blocks, s, A2, V, p) -> GOAL proof
        assume q
        have _ qb := q
        obtain h2, hh2 r from apply(mp.top_blk[c := c, eo := eo, b := b, cd := cd, st := st, regs := regs, s := s, h := h, A := A, A3 := A2, V := V, p := p, y := y, k := k],
          hc, he, hra, o1l, hs, su, hh, hpre, ha, hrep, hv2, hy, hn, qb, hci)
        show by disj({1}, ex_intro({h2}, taut(hh2, rewrite(sym(oe), r))))
      qed
      show by taut(hret, z, k)
    qed
    show by taut(hpost, k1, k2)
  qed
  show by taut(cu, cdf)
qed

// (an exception of the layer's malloc where it is undefined)
abbrev mp.UB := exc_val("undefined", empty)

// The `malloc` symbol's code diverges only where the layer's malloc is
// undefined (where defined, its outcome mallocng's: no divergence)
theorem mp.top_div(c, eo, b, cd, st, g): app(eo, empty) = 52 -> mp.mi_call(c, g) ->
  tr.div_raises_low(c_src_malloc_lite_malloc.default_malloc_fun(g), abi.wide(malloc.Heap.ghost, mp.UF(c, eo, b, cd, st)), malloc.Heap.ghost)
proof
  assume he hmi
  unfold tr.div_raises_low
  fix regs w h
  assume hra hw hwu hh
  fix t
  assume hr
  let S := union2(w, h)
  have hu _ _ := mp(all_elim(mp.hg_ok, {h}), hh)
  have Su := mp(union2_univ[u := 1, a := w, b := h], hwu, hu)
  have sg := apply(rec_and_intro, hw, hh)
  have dn: !(ord_le(1, seq_len(regs)) && mp.MPRE(c, eo, b, cd, st, S)) proof
    assume hd0
    have o1l hpre := hd0
    obtain A, _ _ hpost from apply(mp.top_post[c := c, eo := eo, b := b, cd := cd, st := st, g := g, regs := regs, s := w, h := h, o := diverge(t)], he, hmi, hra, hw, hh, hr, o1l, hpre)
    have k1: abi.ovf_out(w, diverge(t)) -> false proof
      assume q
      obtain v ob, _ _ e from q
      show by simp(e)
    qed
    have k2: (ex V rr. (V in x86_64_linux.Vm && (ex A2. mp.mi_ret(c, union2(h, fn_update(empty, "A", A)).A, regs[0], union2(h, fn_update(empty, "A", A)).blocks, w, A2, V, fst(rr)))) &&
        diverge(t) = ok(fn_update(w, "vm", V), rr)) -> false proof
      assume q
      obtain V rr, _ _ e from q
      show by simp(e)
    qed
    show by taut(hpost, k1, k2)
  qed
  have eu: mp.UB in univ(1) by defs(simp(), exc_val)
  have pu: pair(S, exc(S, mp.UB)) in univ(1) by simp(Su, eu)
  have sh: abi.outcome(exc(S, mp.UB)) by disj({2}, ex_intro({S}, {mp.UB}, refl({exc(S, mp.UB)})))
  have vt: all x v. exc(S, mp.UB) = ok(x, v) -> v in cart(bits(64), bits(64)) proof
    fix x v
    assume e
    show by simp(e)
  qed
  have r := apply(mp.top_any[c := c, eo := eo, b := b, cd := cd, st := st, regs := regs, S := S, o := exc(S, mp.UB)], hra, pu, sh, vt, dn)
  have ne: !(mp.UB = exc_val("stack_overflow", empty)) by defs(simp(), exc_val)
  have na: !(mp.UB = exc_val("at_main", empty)) by defs(simp(), exc_val)
  show by ex_intro({mp.UB}, {S}, taut(eu, ne, na, sg, r))
qed

// ... and raises where the program is not loaded (or the stack
// protector's word not writable): its precondition failing
theorem mp.top_unl(c, eo, b, cd, st, regs, w): regs in abi.ARGS -> w in rec_and(abi.World, malloc.Heap.ghost) -> w in univ(1) ->
  !(abi.loaded(w.vm, app(b, empty), app(cd, empty), app(st, empty)) && abi.canary_ok(w.vm, w.fs_base)) ->
  abi.spec_raises(rec_and(abi.World, malloc.Heap.ghost), w, abi.wide(malloc.Heap.ghost, mp.UF(c, eo, b, cd, st)), regs)
proof
  assume hra hw wu hn
  have dn: !(ord_le(1, seq_len(regs)) && mp.MPRE(c, eo, b, cd, st, w)) proof
    assume hd0
    have _ hpre := hd0
    have _ _ hwo := hpre
    have _ _ _ cn _ ld _ := expand(hwo, malloc.world_ok)
    show by taut(hn, cn, ld)
  qed
  have eu: mp.UB in univ(1) by defs(simp(), exc_val)
  have pu: pair(w, exc(w, mp.UB)) in univ(1) by simp(wu, eu)
  have sh: abi.outcome(exc(w, mp.UB)) by disj({2}, ex_intro({w}, {mp.UB}, refl({exc(w, mp.UB)})))
  have vt: all x v. exc(w, mp.UB) = ok(x, v) -> v in cart(bits(64), bits(64)) proof
    fix x v
    assume e
    show by simp(e)
  qed
  have r := apply(mp.top_any[c := c, eo := eo, b := b, cd := cd, st := st, regs := regs, S := w, o := exc(w, mp.UB)], hra, pu, sh, vt, dn)
  show := apply(abi.raises_intro_g, {malloc.Heap.ghost}, {w}, {w}, {abi.wide(malloc.Heap.ghost, mp.UF(c, eo, b, cd, st))}, {regs}, {mp.UB}, hw, eu, (!(mp.UB = exc_val("stack_overflow", empty)) by defs(simp(), exc_val)), r)
qed

// ----------------------------------------------------------------------
//  malloc end to end

// The `malloc` symbol's machine code implements the malloc layer's malloc
// (layers/malloc.sl), its allocator invariant mallocng's (`mallocng.inv`,
// `mallocng.owned`), errno at the thread pointer's 0x34, the program
// loaded as C1 has it
theorem mp.top_malloc: all c statics eo b cd st. mp.mi_cfg(c) -> app(eo, empty) = 52 ->
  app(b, empty) = 4198400 -> app(cd, empty) = text.code -> app(st, empty) = statics -> mp.code_img(c, app(b, empty), app(cd, empty), 1) ->
  abi.implements(malloc.Heap.ghost, 4202244, malloc.malloc_fun(mallocng.inv(c), mallocng.owned(c), eo, b, cd, st))
proof
  fix c statics eo b cd st
  assume hmc he hb hcd hst hci
  have hcf: mp.ap_cfg(c) by taut(hmc)
  have hc _ _ _ _ _ _ := hcf
  obtain G, hi ht ho hq from mp(all_elim(mp.mi_known, {c}, {statics}, {mp.GRS}, {c_src_malloc_mallocng_malloc_cfg.__syscall1_fun()}, {mp.MM}, {mp.MPR}, {mp.EL}), hmc,
    mp(all_elim(mp.ap_leaves_ok, {c}, {statics}), hcf))
  let LOW := c_src_malloc_lite_malloc.default_malloc_fun(G)
  let CFG := c_src_malloc_lite_malloc_cfg.default_malloc_fun(G)
  let W := abi.wide(malloc.Heap.ghost, mp.UF(c, eo, b, cd, st))
  have ln := mp(all_elim(dmc.implements, {statics}, {G}), hi, ht, ho)
  have im := mp(all_elim(tr.implements_refine, {4202244}, {CFG}, {LOW}, {4198400}, {text.code}, {statics}), ln, all_elim(default_malloc_ref, {G}))
  have ro: all args. args in abi.ARGS -> abi.refines_ovf(LOW[args], W[args], malloc.Heap.ghost) proof
    fix args
    assume hA
    show := apply(mp.top_ref[c := c, eo := eo, b := b, cd := cd, st := st, g := G, regs := args, k := 1], hc, he, hq, hA, hci)
  qed
  have dv := apply(mp.top_div[c := c, eo := eo, b := b, cd := cd, st := st, g := G], he, hq)
  have nl: all args w. args in abi.ARGS -> w in rec_and(abi.World, malloc.Heap.ghost) -> w in univ(1) ->
      !(abi.loaded(w.vm, 4198400, text.code, statics) && abi.canary_ok(w.vm, w.fs_base)) -> abi.spec_raises(rec_and(abi.World, malloc.Heap.ghost), w, W, args) proof
    fix args w
    assume hA hw wu hn
    show := apply(mp.top_unl[c := c, eo := eo, b := b, cd := cd, st := st, regs := args, w := w], hA, hw, wu, rewrite(sym(hst), rewrite(sym(hcd), rewrite(sym(hb), hn))))
  qed
  show by defs(apply(tr.implements_abi_l, mp.hg_ok, dv, im, ro, nl), abi.implements)
qed
