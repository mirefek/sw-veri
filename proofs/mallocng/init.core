// the program headers in the view (at AT_PHDR, 56 bytes each, 8 of them):
// readable, none PT_TLS, startup writing none
theorem ui.phdrs: all argv envp m0 s lo top. x86_64_linux.exec_state(musl_malloc.file, argv, envp, m0) -> ui.ctx(m0, s, lo, top) -> int_lt(1032, lo) ->
  startup_specs.phdrs_ok(ui.wvm(s.vm), ui.wob0(m0.gpr[4], top), 4194368, 56, 8, startup_specs.start_writes(ui.G))
proof
  fix argv envp m0 s lo top
  assume he hc hlo
  have {g0 = s0} := ui.elf
  have c: all i. i in omega -> int_lt(i, 8) -> !(int_add(4194368, int_mul(56, i)) = 0) &&
      gimple.usable(ui.wvm(s.vm), ui.wob0(m0.gpr[4], top), int_add(4194368, int_mul(56, i)), 56, false) &&
      !(gimple.bytes_at(ui.wvm(s.vm), bits_of_int(64, int_add(4194368, int_mul(56, i))), 4) = startup_specs.PT_TLS) &&
      (all j. j in omega -> int_lt(j, 56) -> !(int_add(int_add(4194368, int_mul(56, i)), j) in startup_specs.start_writes(ui.G))) proof
    fix i
    assume hi hil
    let X := int_add(4194368, int_mul(56, i))
    have xo: X in omega by arith(hi)
    have pg: all j. j in omega -> int_lt(j, 56) -> ui.img_page(int_div(int_add(X, j), x86_64_linux.PAGE), false) proof
      fix j
      assume hj hjl
      show by arith(hi, hil, hj, hjl)
    qed
    have us := apply(ui.us_img[argv := argv, envp := envp, m0 := m0, s := s, lo := lo, top := top, x := X, n := 56, w := false], he, hc, hlo, xo, pg)
    have pg4: all j. j in omega -> int_lt(j, 4) -> ui.img_page(int_div(int_add(X, j), x86_64_linux.PAGE), false) proof
      fix j
      assume hj hjl
      show := mp(all_elim(pg, {j}), hj, arith(hjl))
    qed
    have r := apply(ui.img_read[argv := argv, envp := envp, m0 := m0, s := s, lo := lo, top := top, j := 0, ty := 1, fl := 4, of := 0, va := 4194304, fs := 512, ms := 512,
      a := X, n := 4], he, hc, hlo, eval(), eval(), g0, eval(), eval(), xo, eval(), arith(hi), arith(hi, hil), arith(hi, hil), pg4)
    have xe: int_add(0, int_sub(X, 4194304)) = x86_64_linux.ph(musl_malloc.file, i) := trans((int_add(0, int_sub(X, 4194304)) = int_add(64, int_mul(56, i)) by arith(hi)), sym(ui.ph_eq[i := i]))
    have xb: bits_of_int(64, X) = X := apply(nf.boi_in[n := 64, x := X], eval(), (X in bits(64) by arith(hi, hil)))
    have ty := rewrite(sym(rewrite(xe, r)), apply(ui.ph_types[i := i], hi, hil))
    have pt: startup_specs.PT_TLS = 7 by defs(eval(), startup_specs.PT_TLS)
    have ty2: !(gimple.bytes_at(ui.wvm(s.vm), bits_of_int(64, X), 4) = startup_specs.PT_TLS) := rewrite(sym(pt), rewrite(sym(xb), ty))
    have nw: all j. j in omega -> int_lt(j, 56) -> !(int_add(X, j) in startup_specs.start_writes(ui.G)) proof
      fix j
      assume hj hjl hw
      have _ b _ := apply(ui.sw_range[x := int_add(X, j)], hw)
      show by arith(b, hi, hil, hj, hjl)
    qed
    show by taut((!(X = 0) by arith(hi)), us, ty2, nw)
  qed
  show by defs(taut((int_lt(int_add(int_add(4194368, int_mul(56, 8)), 56), int_pow(2, 63)) by eval()), c), startup_specs.phdrs_ok)
qed

// the constructors' table (one entry: frame_dummy) in the view: readable,
// startup writing none of it
theorem ui.ctors: all argv envp m0 s lo top. x86_64_linux.exec_state(musl_malloc.file, argv, envp, m0) -> ui.ctx(m0, s, lo, top) -> int_lt(1032, lo) ->
  startup_specs.ctors_ok(ui.wvm(s.vm), ui.wob0(m0.gpr[4], top), ui.P, startup_specs.start_writes(ui.G))
proof
  fix argv envp m0 s lo top
  assume he hc hlo
  have {g3 = s3} := ui.elf
  have ia: ui.P.init_array = 4227016 by eval()
  have pg: all j. j in omega -> int_lt(j, 8) -> ui.img_page(int_div(int_add(4227016, j), x86_64_linux.PAGE), false) proof
    fix j
    assume hj hjl
    show by arith(hj, hjl)
  qed
  have us := apply(ui.us_img[argv := argv, envp := envp, m0 := m0, s := s, lo := lo, top := top, x := 4227016, n := 8, w := false], he, hc, hlo, eval(), pg)
  have r := apply(ui.img_read[argv := argv, envp := envp, m0 := m0, s := s, lo := lo, top := top, j := 3, ty := 1, fl := 6, of := 28616, va := 4227016, fs := 72, ms := 1680,
    a := 4227016, n := 8], he, hc, hlo, eval(), eval(), g3, eval(), eval(), eval(), eval(), eval(), eval(), eval(), pg)
  have fv := apply(ui.le_val[F := musl_malloc.file, off := int_add(28616, int_sub(4227016, 4227016)), n := 8, v := 4198864], unfold(musl_malloc.file), eval(), eval(), eval(), eval(), eval())
  have rv: gimple.bytes_at(ui.wvm(s.vm), 4227016, 8) = 4198864 := trans(r, fv)
  have c: all i. i in omega -> int_lt(i, 1) -> gimple.usable(ui.wvm(s.vm), ui.wob0(m0.gpr[4], top), int_add(ui.P.init_array, int_mul(8, i)), 8, false) &&
      gimple.bytes_at(ui.wvm(s.vm), bits_add(64, ui.P.init_array, int_mul(8, i)), 8) = ui.P.ctor &&
      (all j. j in omega -> int_lt(j, 8) -> !(int_add(int_add(ui.P.init_array, int_mul(8, i)), j) in startup_specs.start_writes(ui.G))) proof
    fix i
    assume hi hil
    have i0: i = 0 by arith(hi, hil)
    have a0: int_add(ui.P.init_array, int_mul(8, i)) = 4227016 by rsimp(i0, ia)
    have a1: bits_add(64, ui.P.init_array, int_mul(8, i)) = 4227016 by rsimp(i0, ia)
    have nw: all j. j in omega -> int_lt(j, 8) -> !(int_add(4227016, j) in startup_specs.start_writes(ui.G)) proof
      fix j
      assume hj hjl hw
      have _ b _ := apply(ui.sw_range[x := int_add(4227016, j)], hw)
      show by arith(b, hj, hjl)
    qed
    have ct: ui.P.ctor = 4198864 by eval()
    let V := ui.wvm(s.vm)
    let O := ui.wob0(m0.gpr[4], top)
    let A0 := int_add(ui.P.init_array, int_mul(8, i))
    have f1: gimple.usable(V, O, 4227016, 8, false) && gimple.bytes_at(V, 4227016, 8) = ui.P.ctor &&
      (all j. j in omega -> int_lt(j, 8) -> !(int_add(4227016, j) in startup_specs.start_writes(ui.G))) by taut(us, rewrite(sym(ct), rv), nw)
    have f2 := subst({y. gimple.usable(V, O, y, 8, false) && gimple.bytes_at(V, 4227016, 8) = ui.P.ctor &&
      (all j. j in omega -> int_lt(j, 8) -> !(int_add(y, j) in startup_specs.start_writes(ui.G)))}, sym(a0), f1)
    show := subst({y. gimple.usable(V, O, A0, 8, false) && gimple.bytes_at(V, y, 8) = ui.P.ctor &&
      (all j. j in omega -> int_lt(j, 8) -> !(int_add(A0, j) in startup_specs.start_writes(ui.G)))}, sym(a1), f2)
  qed
  show by defs(ex_intro({1}, taut((1 in omega by eval()), (ui.P.init_array_end = int_add(ui.P.init_array, int_mul(8, 1)) by eval()),
    (int_lt(ui.P.init_array_end, int_pow(2, 63)) by eval()), c)), startup_specs.ctors_ok)
qed

// ----------------------------------------------------------------------
//  Exec's stack data as startup reads it

// exec's process (unprivileged), its stack [lo, top) above the image, the
// stack's data, the entry s
def ui.SX(m0, s, lo, top, argv, envp, auxv) := ui.ctx(m0, s, lo, top) && int_lt(1032, lo) && seq_len(argv) in omega && seq_len(envp) in omega &&
  (all i. i in omega -> int_lt(i, seq_len(argv)) -> seq_len(argv[i]) in omega) && auxv in list_type(cart(omega, omega)) &&
  x86_64_linux.stack_layout(m0.vm, m0.gpr[4], argv, envp, auxv) && x86_64_linux.auxv_ok(musl_malloc.file, m0.vm, m0.os, auxv) &&
  x86_64_linux.stack_data(m0.vm, m0.gpr[4], int_mul(top, x86_64_linux.PAGE), argv, envp, auxv) &&
  x86_64_linux.exec_state(musl_malloc.file, argv, envp, m0) && claim_malloc.unprivileged(m0.os) && int_lt(seq_len(argv), 2147483648)

// (a word of exec's memory: a number below 2^64)
theorem ui.le_nat: all m0 a. m0 in x86_64_linux.Machine -> x86_64_linux.le(m0.vm.bytes, a, 8) in omega && int_lt(x86_64_linux.le(m0.vm.bytes, a, 8), 18446744073709551616)
proof
  fix m0 a
  assume hM
  have bt: m0.vm.bytes in fn_space(bits(64), bits(8)) by simp(expand(apply(x86i.parts, hM).4, x86_64_linux.Vm))
  have l8 := mp(x86.le8_nat[vm := m0.vm, a := a], bt)
  have qo ql := apply(g.bytes_bound[vm := m0.vm, a := a, n := 8], bt, eval())
  show := rewrite(sym(l8), conj(qo, rewrite((int_pow(256, 8) = 18446744073709551616 by eval()), ql)))
qed

// argv[0] (the program's name; none: argc 0, the null word): a C string
// on the stack
theorem ui.pn_cstr: all m0 s lo top argv envp auxv pn. ui.SX(m0, s, lo, top, argv, envp, auxv) ->
  pn = bits_of_int(64, x86_64_linux.le(m0.vm.bytes, bits_of_int(64, int_add(m0.gpr[4], 8)), 8)) -> !(pn = 0) ->
  startup_specs.cstr(ui.wvm(s.vm), ui.wob0(m0.gpr[4], top), pn, startup_specs.start_writes(ui.G))
proof
  fix m0 s lo top argv envp auxv pn
  assume hx hpn hnz
  have hc hlo hna hne hel hla hsl hao hsd .. := expand(hx, ui.SX)
  have hM _ _ hs hl _ h16 _ := expand(hc, ui.ctx)
  have r0 := apply(x86i.rsp_typed, hM)
  let R := m0.gpr[4]
  have _ ia z1 .. := expand(hsl, x86_64_linux.stack_layout, x86_64_linux.cstring, x86_64_linux.u64_at)
  have _ _ sa .. := expand(hsd, x86_64_linux.stack_data, x86_64_linux.in_stack, x86_64_linux.u64_at)
  let Q := x86_64_linux.le(m0.vm.bytes, bits_of_int(64, int_add(R, 8)), 8)
  have qo ql := mp(ui.le_nat[m0 := m0, a := bits_of_int(64, int_add(R, 8))], hM)
  have e0: int_add(int_add(R, 8), int_mul(8, 0)) = int_add(R, 8) by arith(r0)
  have c0: seq_len(argv) = 0 -> false proof
    assume h0
    have z := rewrite(e0, rewrite(h0, z1))
    have qz := subst({y. bits_of_int(64, Q) = bits_of_int(64, y)}, z, refl({bits_of_int(64, Q)}))
    have p0: pn = 0 := trans(hpn, trans(qz, (bits_of_int(64, 0) = 0 by eval())))
    show by taut(p0, hnz)
  qed
  have c1: int_lt(0, seq_len(argv)) -> startup_specs.cstr(ui.wvm(s.vm), ui.wob0(R, top), pn, startup_specs.start_writes(ui.G)) proof
    assume hp
    have _ zb _ := rewrite(e0, mp(all_elim(ia, {0}), eval(), hp))
    have b1 b2 := rewrite(e0, mp(all_elim(sa, {0}), eval(), hp))
    have L0 := mp(all_elim(hel, {0}), eval(), hp)
    have cq := apply(ui.cstr_stk[m0 := m0, s := s, lo := lo, top := top, q := Q, L := seq_len(argv[0])], hc, hlo, qo, L0, zb, b1, b2)
    have qb: bits_of_int(64, Q) = Q := apply(nf.boi_in[n := 64, x := Q], eval(), (Q in bits(64) by arith(qo, ql)))
    show := rewrite(sym(trans(hpn, qb)), cq)
  qed
  show by taut(c0, c1, (seq_len(argv) = 0 || int_lt(0, seq_len(argv)) by arith(hna)))
qed

// aux[AT_EXECFN] (the executable's name): a C string on the stack
theorem ui.execfn: all m0 s lo top argv envp auxv. ui.SX(m0, s, lo, top, argv, envp, auxv) ->
  all v. v in omega -> startup_specs.aux_is(auxv, x86_64_linux.AT_EXECFN, v) -> !(v = 0) ->
    startup_specs.cstr(ui.wvm(s.vm), ui.wob0(m0.gpr[4], top), v, startup_specs.start_writes(ui.G))
proof
  fix m0 s lo top argv envp auxv
  assume hx
  fix v
  assume hv ha hnz
  have hc hlo hna hne hel hla hsl hao hsd .. := expand(hx, ui.SX)
  have uq := expand(hao, x86_64_linux.auxv_ok).12
  have _ _ _ _ _ ix := expand(hsd, x86_64_linux.stack_data, x86_64_linux.in_stack, x86_64_linux.aux)
  obtain q str, hq hs hk hcs b1 b2 from ix
  have vq := apply(ui.aux_eq[auxv := auxv, key := x86_64_linux.AT_EXECFN, q := q, v := v], uq, (!(x86_64_linux.AT_EXECFN = x86_64_linux.AT_NULL) by defs(eval(), x86_64_linux.AT_EXECFN, x86_64_linux.AT_NULL)), hk, ha)
  have _ zb := expand(hcs, x86_64_linux.cstring)
  have L0: seq_len(str) in omega by defs(simp(expand(hs, list_type)), seq_len)
  have cq := apply(ui.cstr_stk[m0 := m0, s := s, lo := lo, top := top, q := q, L := seq_len(str)], hc, hlo, hq, L0, zb, b1, b2)
  show := rewrite(sym(vq), cq)
qed

// aux[AT_RANDOM] (16 random bytes): on the stack, startup writing none
theorem ui.random: all m0 s lo top argv envp auxv. ui.SX(m0, s, lo, top, argv, envp, auxv) ->
  all e. e in omega -> startup_specs.aux_is(auxv, x86_64_linux.AT_RANDOM, e) -> !(e = 0) ->
    gimple.usable(ui.wvm(s.vm), ui.wob0(m0.gpr[4], top), e, 8, false) && int_lt(int_add(e, 8), int_pow(2, 63)) &&
    (all i. i in omega -> int_lt(i, 8) -> !(int_add(e, i) in startup_specs.start_writes(ui.G)))
proof
  fix m0 s lo top argv envp auxv
  assume hx
  fix e
  assume he ha hnz
  have hc hlo hna hne hel hla hsl hao hsd .. := expand(hx, ui.SX)
  have hM _ _ hs .. := expand(hc, ui.ctx)
  have s1 s2 .. := expand(hs, x86_64_linux.stack_pages)
  have uq := expand(hao, x86_64_linux.auxv_ok).12
  have _ _ _ _ ir _ := expand(hsd, x86_64_linux.stack_data, x86_64_linux.in_stack, x86_64_linux.aux)
  obtain q, hq hk b1 b2 from ir
  have eq := apply(ui.aux_eq[auxv := auxv, key := x86_64_linux.AT_RANDOM, q := q, v := e], uq, (!(x86_64_linux.AT_RANDOM = x86_64_linux.AT_NULL) by defs(eval(), x86_64_linux.AT_RANDOM, x86_64_linux.AT_NULL)), hk, ha)
  have us := apply(ui.us_stack[m0 := m0, s := s, lo := lo, top := top, x := q, n := 8, w := false], hc, hq, eval(), b1, arith(b2, hq))
  have nw: all i. i in omega -> int_lt(i, 8) -> !(int_add(q, i) in startup_specs.start_writes(ui.G)) proof
    fix i
    assume hi hil
    show := apply(ui.stk_nw[m0 := m0, s := s, lo := lo, top := top, x := int_add(q, i)], hc, hlo, arith(hq, hi), arith(b1, hq, hi))
  qed
  show := rewrite(sym(eq), conj(conj(us, (int_lt(int_add(q, 8), int_pow(2, 63)) by arith(b2, hq, s2))), nw))
qed

// the vector's other entries musl reads: the headers', the credentials
// (unprivileged: real and effective the same), not secure
theorem ui.auxs: all m0 s lo top argv envp auxv. ui.SX(m0, s, lo, top, argv, envp, auxv) ->
  (startup_specs.aux_is(auxv, x86_64_linux.AT_PHDR, 4194368) && startup_specs.aux_is(auxv, x86_64_linux.AT_PHENT, 56) &&
   startup_specs.aux_is(auxv, x86_64_linux.AT_PHNUM, 8)) &&
  (startup_specs.aux_is(auxv, x86_64_linux.AT_UID, m0.os.creds.uid) && startup_specs.aux_is(auxv, x86_64_linux.AT_EUID, m0.os.creds.uid) &&
   startup_specs.aux_is(auxv, x86_64_linux.AT_GID, m0.os.creds.gid) && startup_specs.aux_is(auxv, x86_64_linux.AT_EGID, m0.os.creds.gid)) &&
  startup_specs.aux_is(auxv, x86_64_linux.AT_SECURE, 0)
proof
  fix m0 s lo top argv envp auxv
  assume hx
  have hc hlo hna hne hel hla hsl hao hsd he hu h31 := expand(hx, ui.SX)
  have ns eu eg := expand(hu, claim_malloc.unprivileged)
  have _ _ k3 k4 k5 k6 k7 k8 k9 k10 _ _ := expand(hao, x86_64_linux.auxv_ok, x86_64_linux.aux)
  obtain q, hq hk hph _ _ from k10
  have q0 := apply(ui.phdr_q[q := q], hph)
  have {pn = phnum} := ui.elf
  have a1 := apply(ui.aux_is, rewrite(q0, hk))
  have a2 := apply(ui.aux_is, k3)
  have a3 := apply(ui.aux_is, rewrite(pn, k4))
  have a4 := apply(ui.aux_is, k6)
  have a5 := apply(ui.aux_is, rewrite(sym(eu), k7))
  have a6 := apply(ui.aux_is, k8)
  have a7 := apply(ui.aux_is, rewrite(sym(eg), k9))
  have i0: ite(m0.os.secure, 1, 0) = 0 := mp(ite_f[c := m0.os.secure, a := 1, b := 0], ns)
  have a8 := apply(ui.aux_is, rewrite(i0, k5))
  show by taut(a1, a2, a3, a4, a5, a6, a7, a8)
qed

// (a value of the vector: a number)
theorem ui.aux_nat: all auxv key v. auxv in list_type(cart(omega, omega)) -> (ex k. k in omega && (int_lt(k, seq_len(auxv)) && auxv[k] = pair(key, v))) -> v in omega
proof
  fix auxv key v
  assume hl hk
  obtain k, ko kl ke from hk
  have m := rewrite(ke, mp(at_type[l := auxv, t := cart(omega, omega), i := k], hl, ko, kl))
  obtain x, hx from mp(cart_elim[a := omega, b := omega, z := pair(key, v)], m)
  obtain z, hz from hx
  have _ zb ez := hz
  have _ vz := apply(pair_inj[a := key, b := v, c := x, d := z], ez)
  show := rewrite(sym(vz), zb)
qed

// __init_libc's precondition in the view: envp past argv's words, argv[0]
// the program's name
theorem ui.libc_pre: all m0 s lo top argv envp auxv E pn. ui.SX(m0, s, lo, top, argv, envp, auxv) ->
  E = int_add(int_add(m0.gpr[4], 16), int_mul(8, seq_len(argv))) ->
  pn = bits_of_int(64, x86_64_linux.le(m0.vm.bytes, bits_of_int(64, int_add(m0.gpr[4], 8)), 8)) ->
  startup_specs.init_libc_pre(ui.wvm(s.vm), ui.wob0(m0.gpr[4], top), ui.G, E, pn)
proof
  fix m0 s lo top argv envp auxv E pn
  assume hx hE hpn
  have hc hlo hna hne hel hla hsl hao hsd he hu h31 := expand(hx, ui.SX)
  have hM _ _ hs .. := expand(hc, ui.ctx)
  have r0 := apply(x86i.rsp_typed, hM)
  let V := ui.wvm(s.vm)
  let O := ui.wob0(m0.gpr[4], top)
  let n := seq_len(envp)
  have nl: seq_len(auxv) in omega by defs(simp(expand(hla, list_type)), seq_len)
  have c1 := apply(ui.env_view[m0 := m0, s := s, lo := lo, top := top, argv := argv, envp := envp, auxv := auxv, E := E], hc, hna, hne, hla, hsl, hsd, hE)
  have c2 := apply(ui.auxv_view[m0 := m0, s := s, lo := lo, top := top, argv := argv, envp := envp, auxv := auxv, A := int_add(E, int_mul(8, int_add(n, 1)))],
    hc, hna, hne, hla, hsl, hao, hsd, arith(hE, r0, hna, hne))
  have c3: all x. x in omega -> int_le(E, x) && int_lt(x, int_add(int_add(E, int_mul(8, int_add(n, 1))), int_mul(16, seq_len(auxv)))) ->
      !(x in startup_specs.start_writes(ui.G)) proof
    fix x
    assume hx2 hr
    have b1 _ := hr
    show := apply(ui.stk_nw[m0 := m0, s := s, lo := lo, top := top, x := x], hc, hlo, hx2, arith(b1, hE, r0, hna))
  qed
  have c4 := apply(ui.globals[argv := argv, envp := envp, m0 := m0, s := s, lo := lo, top := top], he, hc, hlo)
  have c5 := apply(ui.tls_fresh[argv := argv, envp := envp, m0 := m0, s := s, lo := lo, top := top], he, hc, hlo)
  have c6: !(pn = 0) -> startup_specs.cstr(V, O, pn, startup_specs.start_writes(ui.G)) proof
    assume hnz
    show := apply(ui.pn_cstr[m0 := m0, s := s, lo := lo, top := top, argv := argv, envp := envp, auxv := auxv, pn := pn], hx, hpn, hnz)
  qed
  have c7 := apply(ui.execfn[m0 := m0, s := s, lo := lo, top := top, argv := argv, envp := envp, auxv := auxv], hx)
  have c8 := apply(ui.empty_cstr[argv := argv, envp := envp, m0 := m0, s := s, lo := lo, top := top], he, hc, hlo)
  have a1 a2 a3 a4 a5 a6 a7 a8 := apply(ui.auxs[m0 := m0, s := s, lo := lo, top := top, argv := argv, envp := envp, auxv := auxv], hx)
  have ph := apply(ui.phdrs[argv := argv, envp := envp, m0 := m0, s := s, lo := lo, top := top], he, hc, hlo)
  have c9: ex ph pe phn. ((ph in omega && pe in omega) && phn in omega) && (((startup_specs.aux_is(auxv, x86_64_linux.AT_PHDR, ph) &&
      startup_specs.aux_is(auxv, x86_64_linux.AT_PHENT, pe)) && startup_specs.aux_is(auxv, x86_64_linux.AT_PHNUM, phn)) &&
      startup_specs.phdrs_ok(V, O, ph, pe, phn, startup_specs.start_writes(ui.G)))
    by ex_intro({4194368}, {56}, {8}, taut((4194368 in omega by eval()), (56 in omega by eval()), (8 in omega by eval()), a1, a2, a3, ph))
  have c10 := apply(ui.random[m0 := m0, s := s, lo := lo, top := top, argv := argv, envp := envp, auxv := auxv], hx)
  have _ _ _ _ _ k6 _ k8 .. := expand(hao, x86_64_linux.auxv_ok, x86_64_linux.aux)
  have uo := apply(ui.aux_nat[auxv := auxv, key := x86_64_linux.AT_UID, v := m0.os.creds.uid], hla, k6)
  have go := apply(ui.aux_nat[auxv := auxv, key := x86_64_linux.AT_GID, v := m0.os.creds.gid], hla, k8)
  have c11: ex u gr. (u in omega && gr in omega) && (((startup_specs.aux_is(auxv, x86_64_linux.AT_UID, u) && startup_specs.aux_is(auxv, x86_64_linux.AT_EUID, u)) &&
      startup_specs.aux_is(auxv, x86_64_linux.AT_GID, gr)) && startup_specs.aux_is(auxv, x86_64_linux.AT_EGID, gr))
    by ex_intro({m0.os.creds.uid}, {m0.os.creds.gid}, taut(uo, go, a4, a5, a6, a7))
  have nh: n in omega := hne
  show by defs(ex_intro({n}, {auxv}, taut(nh, hla, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, a8)), startup_specs.init_libc_pre)
qed

// _start_c's precondition in the world's view at its entry: exec's stack
// (argc at rsp, then argv)
theorem ui.cpre: all m0 s lo top argv envp auxv. ui.SX(m0, s, lo, top, argv, envp, auxv) ->
  ui.c_pre(ui.wvm(s.vm), ui.wob0(m0.gpr[4], top), ui.G, ui.P, m0.gpr[4])
proof
  fix m0 s lo top argv envp auxv
  assume hx
  have hc hlo hna hne hel hla hsl hao hsd he hu h31 := expand(hx, ui.SX)
  have hM _ _ hs _ _ h16 _ := expand(hc, ui.ctx)
  have s1 s2 .. := expand(hs, x86_64_linux.stack_pages)
  have r0 := apply(x86i.rsp_typed, hM)
  let R := m0.gpr[4]
  let V := ui.wvm(s.vm)
  let O := ui.wob0(R, top)
  let la := seq_len(argv)
  have a0 .. := expand(hsl, x86_64_linux.stack_layout)
  have _ ib .. := expand(hsd, x86_64_linux.stack_data, x86_64_linux.in_stack)
  have nl: seq_len(auxv) in omega by defs(simp(expand(hla, list_type)), seq_len)
  have ro: R in omega by arith(r0)
  have top8: int_le(int_add(int_add(R, 16), int_mul(8, int_add(la, 1))), int_mul(top, x86_64_linux.PAGE)) by arith(ib, hna, hne, nl, r0)
  // argc: the stack's first word
  have w0 := apply(ui.w_word[m0 := m0, s := s, lo := lo, top := top, a := R], hc, ro, arith(r0), arith(top8, hna, r0))
  have ac: gimple.bytes_at(V, R, 8) = la := trans(w0, expand(a0, x86_64_linux.u64_at))
  have b8: bits_add(64, R, 8) = int_add(R, 8) := apply(x86.add_nowrap[a := R, b := 8], ro, eval(), arith(top8, s2, hna, r0))
  have eE: bits_add(64, int_add(R, 8), int_mul(8, int_add(la, 1))) = int_add(int_add(R, 8), int_mul(8, int_add(la, 1))) :=
    apply(x86.add_nowrap[a := int_add(R, 8), b := int_mul(8, int_add(la, 1))], arith(r0), arith(hna), arith(top8, s2, hna, r0))
  let E := bits_add(64, bits_add(64, R, 8), int_mul(8, int_add(gimple.bytes_at(V, R, 8), 1)))
  have e1 := subst({y. E = bits_add(64, y, int_mul(8, int_add(gimple.bytes_at(V, R, 8), 1)))}, b8, refl({E}))
  have e2 := subst({y. E = bits_add(64, int_add(R, 8), int_mul(8, int_add(y, 1)))}, ac, e1)
  have hE: E = int_add(int_add(R, 16), int_mul(8, la)) := trans(e2, trans(eE, (int_add(int_add(R, 8), int_mul(8, int_add(la, 1))) = int_add(int_add(R, 16), int_mul(8, la)) by arith(r0, hna))))
  // argv[0]: the stack's second word
  have w1 := apply(ui.w_word[m0 := m0, s := s, lo := lo, top := top, a := int_add(R, 8)], hc, arith(r0), arith(r0), arith(top8, hna, r0))
  let pn := bits_of_int(64, gimple.bytes_at(V, bits_add(64, R, 8), 8))
  have p1 := subst({y. pn = bits_of_int(64, gimple.bytes_at(V, y, 8))}, b8, refl({pn}))
  have hpn: pn = bits_of_int(64, x86_64_linux.le(m0.vm.bytes, bits_of_int(64, int_add(R, 8)), 8)) := subst({y. pn = bits_of_int(64, y)}, w1, p1)
  have lp := apply(ui.libc_pre[m0 := m0, s := s, lo := lo, top := top, argv := argv, envp := envp, auxv := auxv, E := E, pn := pn], hx, hE, hpn)
  have ct := apply(ui.ctors[argv := argv, envp := envp, m0 := m0, s := s, lo := lo, top := top], he, hc, hlo)
  have u0 := apply(ui.us_stack[m0 := m0, s := s, lo := lo, top := top, x := R, n := 8, w := false], hc, ro, eval(), arith(r0), arith(top8, hna, r0))
  have u1 := apply(ui.us_stack[m0 := m0, s := s, lo := lo, top := top, x := int_add(R, 8), n := 8, w := false], hc, arith(r0), eval(), arith(r0), arith(top8, hna, r0))
  have u1b: gimple.usable(V, O, bits_add(64, R, 8), 8, false) := rewrite(sym(b8), u1)
  have m1: int_lt(gimple.bytes_at(V, R, 8), int_pow(2, 31)) := rewrite(sym(ac), (int_lt(la, int_pow(2, 31)) by arith(hna, h31)))
  have m2: !(bits_add(64, R, 8) = 0) := rewrite(sym(b8), (!(int_add(R, 8) = 0) by arith(r0)))
  have m3: int_lt(int_add(bits_add(64, R, 8), int_mul(8, int_add(gimple.bytes_at(V, R, 8), 1))), int_pow(2, 63)) :=
    rewrite(sym(b8), rewrite(sym(ac), (int_lt(int_add(int_add(R, 8), int_mul(8, int_add(la, 1))), int_pow(2, 63)) by arith(top8, s2, hna, r0))))
  have sm: startup_specs.start_main_pre(V, O, ui.G, ui.P, gimple.bytes_at(V, R, 8), bits_add(64, R, 8)) by defs(taut(m1, m2, m3, u1b, lp, ct), startup_specs.start_main_pre)
  show by taut((!(R = 0) by arith(h16)), (int_lt(int_add(R, 16), int_pow(2, 63)) by arith(top8, s2, hna, r0)), u0, sm)
qed

// ----------------------------------------------------------------------
//  From exec to main

// (a machine: in the universe)
theorem ui.m_univ: all m. m in x86_64_linux.Machine -> m in univ(1)
proof
  fix m
  assume h
  let K := insert("gpr", insert("xmm", insert("rip", insert("flags", insert("cpu", insert("fs_base", insert("gs_base", insert("vm", insert("os", empty)))))))))
  have hp hq := unsel(expand(h, x86_64_linux.Machine))
  have hf hd := (is_fun(m) && dom(m) = K by taut(hq))
  have ku: K in univ(1) by simp()
  show := mp(rec_univ[u := 1, k := K, r := m], ku, hp, hf, hd)
qed

// (exec's stack data: a set of addresses)
theorem ui.iobjs_type: all r top. ui.iobjs(r, top) in set_type(omega)
proof
  fix r top
  have ss: subset(ui.iobjs(r, top), omega) proof
    fix x
    assume h
    show by taut(set_select_def[s := omega, p := x0. int_le(r, x0) && int_lt(x0, int_mul(top, x86_64_linux.PAGE)), z := x], h)
  qed
  show by defs(taut(powerset_def[s := omega, a := ui.iobjs(r, top)], ss), set_type)
qed

// (_start_c's return address: _start's, not main)
theorem ui.ret_addr: all m0 s. m0 in x86_64_linux.Machine -> ui.s5(m0, s) -> int_le(16, m0.gpr[4]) ->
  x86_64_linux.le(s.vm.bytes, s.gpr[4], 8) = 4198565
proof
  fix m0 s
  assume hM h5 h16
  have _ _ _ hsp _ _ _ _ _ _ ev := expand(h5, ui.s5)
  obtain v1, _ _ _ _ ve vt from ev
  have bt: v1.bytes in fn_space(bits(64), bits(8)) by simp(expand(vt, x86_64_linux.Vm))
  have g0 := apply(x86i.rsp_typed, hM)
  let A := bits_sub(64, m0.gpr[4], 8)
  have ab: A in bits(64) by simp()
  have sb: s.vm.bytes = x86_64_linux.store_le(v1.bytes, A, 8, 4198565) by rsimp(ve)
  have l := apply(tr.le_store_n[b := v1.bytes, a := A, n := 8, x := 4198565], bt, ab, taut(refl({8})), eval())
  show := rewrite(sym(hsp), rewrite(sym(sb), l))
qed

// (exec's stack: above the image's last page)
theorem ui.lo_img: all lo. (all x0 x1. x0 in omega && x1 in omega -> x86_64_linux.is_load(musl_malloc.file, x0) && x86_64_linux.seg_page(x86_64_linux.segment(musl_malloc.file, x0), x1) -> int_lt(x1, lo)) ->
  int_lt(1032, lo)
proof
  fix lo
  assume h
  have sp := apply(ui.seg_page_at[j := 3, p := 1032], ((3 = 0 && 1032 = 1024) || (3 = 2 && 1032 = 1030) || (3 = 3 && int_le(1031, 1032) && int_le(1032, 1032)) by eval()))
  show := mp(all_elim(h, {3}, {1032}), conj((3 in omega by eval()), (1032 in omega by eval())), conj(apply(ui.load_i[i := 3], eval(), eval()), sp))
qed

// The claim's run from exec to main: _start, then _start_c's -- its spec's
// world entering main, exec's stack data as startup read it
theorem ui.to_main: all argv envp m0 m. argv in list_type(list_type(bits(8))) -> envp in list_type(list_type(bits(8))) -> m0 in x86_64_linux.Machine ->
  x86_64_linux.exec_state(musl_malloc.file, argv, envp, m0) -> claim_malloc.unprivileged(m0.os) ->
  runs(claim_malloc.run_until(musl_malloc.main_at), m0, ok(m, empty)) ->
  ex lo top auxv s V fs. ui.SX(m0, s, lo, top, argv, envp, auxv) && ui.at_main(s, ui.iobjs(m0.gpr[4], top), m, m0.gpr[4], V, fs)
proof
  fix argv envp m0 m
  assume hav hev hM he hu hr
  have mu := apply(ui.m_univ, hM)
  have ur := apply(ui.until_parts, rewrite((musl_malloc.main_at = 4198873 by defs(eval(), musl_malloc.main_at)), hr))
  have tc := apply(ui.text_code[argv := argv, envp := envp, m0 := m0], he)
  have _ _ ex _ _ bpg _ _ hrip hal _ _ hfl _ _ _ := expand(he, x86_64_linux.exec_state)
  obtain lo top auxv, hlo htop hax hspp _ hbelow _ hl1 hl2 h31 _ hsl hao hsd from ex
  have s1 s2 .. := expand(hspp, x86_64_linux.stack_pages)
  have g0 := apply(x86i.rsp_typed, hM)
  have l32 := apply(ui.lo_img[lo := lo], hbelow)
  have h16: int_le(16, m0.gpr[4]) by arith(hl1, l32)
  have hhi: int_lt(m0.gpr[4], 140737488355328) by arith(hl2, s2)
  have en := apply(ui.le_val[F := musl_malloc.file, off := 24, n := 8, v := 4198543], unfold(musl_malloc.file), eval(), eval(), eval(), eval(), eval())
  have rip: m0.rip = 4198543 := trans(hrip, (x86_64_linux.entry_of(musl_malloc.file) = 4198543 by defs(en, x86_64_linux.entry_of)))
  have ndf: !m0.flags.df by rsimp(hfl)
  obtain m4, h4 u4 from apply(ui.start4[m0 := m0, m := m], hM, mu, tc, rip, ur)
  obtain s, h5 u5 from apply(ui.start_call[m0 := m0, m4 := m4, m := m], hM, h4, hal, h16, hhi, tc, u4)
  have sM sU srip .. := expand(h5, ui.s5)
  have hc: ui.ctx(m0, s, lo, top) by defs(taut(hM, hlo, htop, hspp, hl1, hl2, h16, h5), ui.ctx)
  // (exec's stack facts)
  have na: seq_len(argv) in omega by defs(simp(expand(hav, list_type)), seq_len)
  have ne: seq_len(envp) in omega by defs(simp(expand(hev, list_type)), seq_len)
  have el: all i. i in omega -> int_lt(i, seq_len(argv)) -> seq_len(argv[i]) in omega proof
    fix i
    assume hi hil
    have t := mp(at_type[l := argv, t := list_type(bits(8)), i := i], hav, hi, hil)
    show by defs(simp(expand(t, list_type)), seq_len)
  qed
  have a31: int_lt(seq_len(argv), 2147483648) := rewrite((int_pow(2, 31) = 2147483648 by eval()), mp(nat_mem_lt[k := int_pow(2, 31), i := seq_len(argv)], eval(), expand(h31, ord_lt)))
  have hx: ui.SX(m0, s, lo, top, argv, envp, auxv) by defs(taut(hc, l32, na, ne, el, hax, hsl, hao, hsd, he, hu, a31), ui.SX)
  // (_start_c's run: the stop at main as its spec's world entering it)
  let objs := ui.iobjs(m0.gpr[4], top)
  have ot: objs in set_type(omega) := ui.iobjs_type[r := m0.gpr[4], top := top]
  have lo1 := apply(ui.entry_loaded[m0 := m0, s := s], h5, tc)
  have eo := apply(ui.entry_eok[m0 := m0, s := s, lo := lo, top := top], hM, hlo, htop, hspp, hl1, hl2, hal, h16, ndf, bpg, h5)
  have ob := apply(ui.entry_objs[m0 := m0, s := s, lo := lo, top := top], hM, hlo, htop, hspp, hl1, h16, h5)
  have ra := apply(ui.ret_addr[m0 := m0, s := s], hM, h5, h16)
  have nt: !(4198873 = x86_64_linux.le(s.vm.bytes, s.gpr[4], 8)) := rewrite(sym(ra), (!(4198873 = 4198565) by eval()))
  have _ _ _ sv := apply(x86i.parts, sM)
  have wt wu := apply(ui.wvm_typed, sv, apply(ui.vm_univ, sv))
  have Wu := apply(tr.vw_univ[b := false, s := s, objs := objs, mem := ui.wvm(s.vm)], sU, ot, wt)
  have Ww := apply(tr.vw_typed[b := false, s := s, objs := objs, mem := ui.wvm(s.vm)], sM, ot, wt, Wu)
  have cp := apply(ui.cpre[m0 := m0, s := s, lo := lo, top := top, argv := argv, envp := envp, auxv := auxv], hx)
  have st := apply(ui.c_stop[s := s, objs := objs, m := m, a := m0.gpr[4]], sM, sU, lo1, srip, eo, g0, ot, ob, u5, nt, Ww, Wu, cp)
  obtain V fs, am from apply(ui.main_world[s := s, objs := objs, m := m, a := m0.gpr[4]], g0, Ww, Wu, cp, st)
  show by ex_intro({lo}, {top}, {auxv}, {s}, {V}, {fs}, taut(hx, am))
qed

// ----------------------------------------------------------------------
//  The empty heap at main

// the allocator's configuration for this binary (claim.core's musl.cfg)
abbrev ui.C := fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(empty,
  "file", musl_malloc.file), "ctx", c_src_malloc_mallocng_malloc.__malloc_context),
  "lock", c_src_malloc_mallocng_malloc.__malloc_lock), "libc", c_src_malloc_mallocng_malloc.__libc),
  "sct", c_src_malloc_mallocng_malloc.__malloc_size_classes), "dbj", c_src_malloc_mallocng_malloc.debruijn32),
  "scnt", c_src_malloc_mallocng_malloc.small_cnt_tab), "mcnt", c_src_malloc_mallocng_malloc.med_cnt_tab)

// (the claim's C view of memory: the world's view)
theorem ui.cv_eq: all vm. claim_malloc.c_vm(vm) = ui.wvm(vm)
proof
  fix vm
  show by defs(refl({ui.wvm(vm)}), claim_malloc.c_vm)
qed

// a page at main, below the stack: the world's view's at main's entry
theorem ui.main_pg: all s objs m a V fs p. ui.at_main(s, objs, m, a, V, fs) -> p in omega -> int_lt(p, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) ->
  ui.wvm(m.vm).pages[p] = V.pages[p] && V.pages = ui.wvm(s.vm).pages
proof
  fix s objs m a V fs p
  assume ha hp hpl
  have _ hfr _ _ _ _ _ hvok := expand(ha, ui.at_main)
  have f1 _ := expand(hfr, startup_specs.frame)
  have vp: V.pages = ui.wvm(s.vm).pages := trans(rsimp(apply(ui.app_eq[k := "pages"], f1)), (ui.wpages(s.vm) = ui.wvm(s.vm).pages by rsimp()))
  have wp _ := expand(hvok, tr.vok)
  have pd: p in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) by sel(conj(hp, hpl))
  have w1 := mp(all_elim(expand(wp, abi.world_pages), {p}), pd)
  have a := mp(app_fn_build[d := set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))), v := q. ite(abi.stack_page(m.vm, q), none, m.vm.pages[q]), a := p], pd)
  have e: ui.wvm(m.vm).pages[p] = ite(abi.stack_page(m.vm, p), none, m.vm.pages[p]) by rsimp(a)
  show by taut(trans(e, sym(w1)), vp)
qed

// a byte at main, the world's at main's entry on a mapped page there,
// not written by startup: the entry's
theorem ui.main_byte: all s objs m a V fs x. ui.at_main(s, objs, m, a, V, fs) -> x in bits(64) ->
  x86_64_linux.mapped(ui.wvm(s.vm), int_div(x, x86_64_linux.PAGE)) -> !(snd(ui.wvm(s.vm).pages[int_div(x, x86_64_linux.PAGE)]).kind = 2) ->
  !(x in startup_specs.start_writes(ui.G)) -> m.vm.bytes[x] = ui.wvm(s.vm).bytes[x]
proof
  fix s objs m a V fs x
  assume ha hx hm hk hw
  let p := int_div(x, x86_64_linux.PAGE)
  have _ hfr _ _ _ _ _ hvok := expand(ha, ui.at_main)
  have _ f2 := expand(hfr, startup_specs.frame)
  have nf: !abi.stack_free(ui.wvm(s.vm), abi.wob(objs, abi.cball), x) proof
    assume h
    have n1 _ := expand(h, abi.stack_free)
    show by taut(n1, hm, hk)
  qed
  have vb := mp(all_elim(f2, {x}), hx, hw, nf)
  have f1 _ := expand(hfr, startup_specs.frame)
  have vp: V.pages = ui.wvm(s.vm).pages := trans(rsimp(apply(ui.app_eq[k := "pages"], f1)), (ui.wpages(s.vm) = ui.wvm(s.vm).pages by rsimp()))
  have _ wm := expand(hvok, tr.vok)
  have {wb = bytes} := expand(wm, tr.wmc)
  have mV: x86_64_linux.mapped(V, p) := apply(ui.mapped_eq[v1 := ui.wvm(s.vm), v2 := V, p := p], apply(ui.app_eq[k := p], sym(vp)), hm)
  have kV: !(snd(V.pages[p]).kind = 2) := rewrite(sym(apply(ui.app_eq[k := p], vp)), hk)
  have cb: x in abi.wob(objs, tr.cbm(false, m.fs_base)).c_bytes by simp(hx)
  have dm: abi.in_domain(V, abi.wob(objs, tr.cbm(false, m.fs_base)), x) by defs(taut(mV, kV, cb), abi.in_domain)
  show := trans(mp(all_elim(wb, {x}), hx, dm), vb)
qed

// ----------------------------------------------------------------------
//  The allocator's ranges in the empty state

// (the file: bytes; the configuration a Cfg)
theorem ui.bytes_list: all c b. c = bytes_seq(b) -> (all i. i in bytes_len(b) -> bytes_at(b, i) in bits(8)) -> bytes_len(b) in omega ->
  c in list_type(bits(8))
proof
  fix c b
  assume e h hn
  show := rewrite(sym(e), apply(tr.bytes_list, {b}, {bits(8)}, h, hn))
qed

theorem ui.file_list: musl_malloc.file in list_type(bits(8))
proof
  show := mp(apply(ui.bytes_list, unfold(musl_malloc.file)), eval(), eval())
qed

theorem ui.file_bytes: musl_malloc.file in seq_type(bits(8)) && musl_malloc.file in univ(1)
proof
  have s: musl_malloc.file in seq_type(bits(8)) by simp(unsel(expand(ui.file_list, list_type)))
  have u := mp(univ_trans[u := 1, a := musl_malloc.file, b := list_type(bits(8))], mp(mp.list_univ[t := bits(8)], bits_univ[n := 8]), ui.file_list)
  show by taut(s, u)
qed

theorem ui.C_ok: ui.C in mallocng.Cfg
proof
  show by defs(simp(ui.file_bytes), mallocng.Cfg)
qed

// the read-only loads' bytes: the first page's, the text's, the
// read-only data's
abbrev ui.RO(a) := (int_le(4194304, a) && int_lt(a, 4194816)) || (int_le(4198400, a) && int_lt(a, 4216671)) || (int_le(4218880, a) && int_lt(a, 4219184))
// the allocator's data symbols: the context, the lock, libc's 16 bytes
abbrev ui.DATA(a) := (int_le(4227328, a) && int_lt(a, 4228256)) || (int_le(4227300, a) && int_lt(a, 4227304)) || (int_le(4227136, a) && int_lt(a, 4227152))

// (a byte of a header's read-only range: of a read-only load)
theorem ui.ro_in: all a k. a in omega -> k in omega ->
  mallocng.in_range(a, ite(x86_64_linux.is_load(musl_malloc.file, k) && !bit(x86_64_linux.segment(musl_malloc.file, k).flags, 1),
    pair(x86_64_linux.segment(musl_malloc.file, k).vaddr, x86_64_linux.segment(musl_malloc.file, k).memsz), pair(0, 0))) -> ui.RO(a)
proof
  fix a k
  assume ha hk hr
  let F := musl_malloc.file
  let c := x86_64_linux.is_load(F, k) && !bit(x86_64_linux.segment(F, k).flags, 1)
  let P := pair(x86_64_linux.segment(F, k).vaddr, x86_64_linux.segment(F, k).memsz)
  have c0: !c -> ui.RO(a) proof
    assume nc
    have e := mp(ite_f[c := c, a := P, b := pair(0, 0)], nc)
    have r0 := rsimp(expand(rewrite(e, hr), mallocng.in_range))
    show by arith(r0, ha)
  qed
  have c1: c -> ui.RO(a) proof
    assume hc
    have hl hnb := hc
    have e := mp(ite_t[c := c, a := P, b := pair(0, 0)], hc)
    have b1 b2 := rsimp(expand(rewrite(e, hr), mallocng.in_range))
    have kk := apply(ui.loads[j := k], hk, hl)
    have {g0 = s0, g1 = s1, g2 = s2, g3 = s3} := ui.elf
    have _ _ _ v0 _ m0 := expand(g0, ui.segis)
    have _ _ _ v1 _ m1 := expand(g1, ui.segis)
    have _ _ _ v2 _ m2 := expand(g2, ui.segis)
    have _ f3 _ _ _ _ := expand(g3, ui.segis)
    have d0: k = 0 -> ui.RO(a) proof
      assume e0
      show by arith(rewrite(e0, b1), rewrite(e0, b2), v0, m0)
    qed
    have d1: k = 1 -> ui.RO(a) proof
      assume e0
      show by arith(rewrite(e0, b1), rewrite(e0, b2), v1, m1)
    qed
    have d2: k = 2 -> ui.RO(a) proof
      assume e0
      show by arith(rewrite(e0, b1), rewrite(e0, b2), v2, m2)
    qed
    have d3: k = 3 -> ui.RO(a) proof
      assume e0
      show by taut(rewrite(f3, rewrite(e0, hnb)), (bit(6, 1) by eval()))
    qed
    show by taut(kk, d0, d1, d2, d3)
  qed
  show by taut(c0, c1)
qed

// a byte of the empty state's ranges: of a read-only load, a data
// symbol, or the auxiliary vector
def ui.FW(AT, L, a) := ui.RO(a) || ui.DATA(a) || mallocng.in_ranges(a, mallocng.auxv_ranges(mp.a0(AT, L)))

theorem ui.fp_where: all AT L a. AT in omega -> L in list_type(cart(omega, omega)) -> a in omega ->
  mallocng.in_ranges(a, mallocng.fp_ranges(ui.C, mp.a0(AT, L))) ->
  ui.RO(a) || ui.DATA(a) || mallocng.in_ranges(a, mallocng.auxv_ranges(mp.a0(AT, L)))
proof
  fix AT L a
  assume hat hl ha h
  let A := mp.a0(AT, L)
  let F := musl_malloc.file
  have {ab = abs, au = univ} := apply(mp.a0_type[AT := AT, L := L], hat, hl)
  have {fr = front, ar = areas, rs = reserve, cl = classes, db = debruijn, gr = groups} := apply(mp.fp_pieces[c := ui.C, A := A], ui.C_ok, au, ab)
  let RO := mallocng.ro_ranges(ui.C.file)
  let DA := mallocng.data_ranges(ui.C)
  let AX := mallocng.auxv_ranges(A)
  let AR := fn_build(int_sub(seq_len(A.areas), 0), x0. pair(A.areas[int_add(0, x0)], 4096))
  let RS := seq_one(pair(A.reserve, int_mul(4096, A.reserve_cnt)))
  let SC := seq_one(pair(ui.C.sct, int_mul(2, 48)))
  let DB := seq_one(pair(ui.C.dbj, 32))
  let GR := fn_build(int_sub(seq_len(A.used), 0), x0. mallocng.group_range(A.metas[A.used[int_add(0, x0)]]))
  have {rd = rodata, xl = auxv} := apply(mp.front_pieces[c := ui.C, A := A], ui.C_ok, au, ab)
  have ro := apply(mp.ro_list, (ui.C.file in seq_type(bits(8)) by simp(ui.file_bytes)))
  have cf: ui.C.ctx in omega && ui.C.lock in omega && ui.C.libc in omega by simp(ui.C_ok)
  have o1 := apply(tr.seq_one_type, (pair(ui.C.ctx, mallocng.CTX_SIZE) in univ(1) by simp(cf)))
  have o2 := apply(tr.seq_one_type, (pair(ui.C.lock, 4) in univ(1) by simp(cf)))
  have o3 := apply(tr.seq_one_type, (pair(ui.C.libc, 16) in univ(1) by simp(cf)))
  have dl: DA in list_type(univ(1)) by defs(apply(tr.concat_list, apply(tr.concat_list, o1, o2), o3), mallocng.data_ranges)
  have t1 := apply(tr.concat_list, fr, ar)
  have t2 := apply(tr.concat_list, t1, rs)
  have t3 := apply(tr.concat_list, t2, cl)
  have t4 := apply(tr.concat_list, t3, db)
  have h0 := expand(h, mallocng.fp_ranges, mallocng.fixed_ranges)
  have s0: mallocng.in_ranges(a, seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(RO, DA), AX), AR), RS), SC), DB)) || mallocng.in_ranges(a, GR)
    by taut(apply(mp.ranges_cat[a := a, xs := seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(RO, DA), AX), AR), RS), SC), DB), ys := GR], t4, gr), h0)
  // (no groups, no areas, no reserve)
  have {u0 = used, r0 = areas} := mp.e_lens[AT := AT, L := L]
  have ng: !mallocng.in_ranges(a, GR) proof
    assume hg
    obtain k, ko kl _ from apply(mp.ranges_build_inv[a := a, n := seq_len(A.used), r := x0. mallocng.group_range(A.metas[A.used[x0]])], (seq_len(A.used) in omega by arith(u0)), hg)
    show by arith(ko, kl, u0)
  qed
  have na: !mallocng.in_ranges(a, AR) proof
    assume hg
    obtain k, ko kl _ from apply(mp.ranges_build_inv[a := a, n := seq_len(A.areas), r := x0. pair(A.areas[x0], 4096)], (seq_len(A.areas) in omega by arith(r0)), hg)
    show by arith(ko, kl, r0)
  qed
  // (the reserve: none)
  have nr: !mallocng.in_ranges(a, RS) proof
    assume hg
    have q0: mallocng.in_range(a, pair(A.reserve, int_mul(4096, A.reserve_cnt))) by taut(mp.ranges_one[a := a, r := pair(A.reserve, int_mul(4096, A.reserve_cnt))], hg)
    have q := rsimp(expand(q0, mallocng.in_range))
    show by arith(q, ha)
  qed
  // (the class table, the de Bruijn table: in the read-only data)
  have ys: mallocng.in_ranges(a, SC) -> ui.RO(a) proof
    assume hg
    have q0: mallocng.in_range(a, pair(ui.C.sct, int_mul(2, 48))) by taut(mp.ranges_one[a := a, r := pair(ui.C.sct, int_mul(2, 48))], hg)
    have q1 q2 := rsimp(expand(q0, mallocng.in_range))
    show by arith(q1, q2, (ui.C.sct = 4218912 by eval()))
  qed
  have yd: mallocng.in_ranges(a, DB) -> ui.RO(a) proof
    assume hg
    have q0: mallocng.in_range(a, pair(ui.C.dbj, 32)) by taut(mp.ranges_one[a := a, r := pair(ui.C.dbj, 32)], hg)
    have q1 q2 := rsimp(expand(q0, mallocng.in_range))
    show by arith(q1, q2, (ui.C.dbj = 4219040 by eval()))
  qed
  // (the data symbols)
  have yda: mallocng.in_ranges(a, DA) -> ui.DATA(a) proof
    assume hg
    let D1 := seq_one(pair(ui.C.ctx, mallocng.CTX_SIZE))
    let D2 := seq_one(pair(ui.C.lock, 4))
    let D3 := seq_one(pair(ui.C.libc, 16))
    have h1 := expand(hg, mallocng.data_ranges)
    have o12 := apply(tr.concat_list, o1, o2)
    have k1: mallocng.in_ranges(a, seq_concat(D1, D2)) || mallocng.in_ranges(a, D3) by taut(apply(mp.ranges_cat[a := a, xs := seq_concat(D1, D2), ys := D3], o12, o3), h1)
    have e1: mallocng.in_ranges(a, D1) -> ui.DATA(a) proof
      assume h
      have q1 q2 := rsimp(expand((mallocng.in_range(a, pair(ui.C.ctx, mallocng.CTX_SIZE)) by taut(mp.ranges_one[a := a, r := pair(ui.C.ctx, mallocng.CTX_SIZE)], h)), mallocng.in_range))
      show by arith(q1, q2, (ui.C.ctx = 4227328 by eval()), (mallocng.CTX_SIZE = 928 by defs(eval(), mallocng.CTX_SIZE)))
    qed
    have e2: mallocng.in_ranges(a, D2) -> ui.DATA(a) proof
      assume h
      have q1 q2 := rsimp(expand((mallocng.in_range(a, pair(ui.C.lock, 4)) by taut(mp.ranges_one[a := a, r := pair(ui.C.lock, 4)], h)), mallocng.in_range))
      show by arith(q1, q2, (ui.C.lock = 4227300 by eval()))
    qed
    have e3: mallocng.in_ranges(a, D3) -> ui.DATA(a) proof
      assume h
      have q1 q2 := rsimp(expand((mallocng.in_range(a, pair(ui.C.libc, 16)) by taut(mp.ranges_one[a := a, r := pair(ui.C.libc, 16)], h)), mallocng.in_range))
      show by arith(q1, q2, (ui.C.libc = 4227136 by eval()))
    qed
    show by taut(k1, apply(mp.ranges_cat[a := a, xs := D1, ys := D2], o1, o2), e1, e2, e3)
  qed
  // (the read-only loads)
  have yro: mallocng.in_ranges(a, RO) -> ui.RO(a) proof
    assume hg
    have fe: ui.C.file = musl_malloc.file by rsimp()
    have h1 := expand(rewrite(fe, hg), mallocng.ro_ranges)
    have {pn = phnum} := ui.elf
    obtain k, ko _ kr from apply(mp.ranges_build_inv[a := a, n := x86_64_linux.phnum(F),
      r := y. ite(x86_64_linux.is_load(F, y) && !bit(x86_64_linux.segment(F, y).flags, 1), pair(x86_64_linux.segment(F, y).vaddr, x86_64_linux.segment(F, y).memsz), pair(0, 0))],
      (x86_64_linux.phnum(F) in omega by arith(pn)), h1)
    show := apply(ui.ro_in[a := a, k := k], ha, ko, kr)
  qed
  have p1 := apply(mp.ranges_cat[a := a, xs := seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(RO, DA), AX), AR), RS), SC), ys := DB], t3, db)
  have p2 := apply(mp.ranges_cat[a := a, xs := seq_concat(seq_concat(seq_concat(seq_concat(RO, DA), AX), AR), RS), ys := SC], t2, cl)
  have p3 := apply(mp.ranges_cat[a := a, xs := seq_concat(seq_concat(seq_concat(RO, DA), AX), AR), ys := RS], t1, rs)
  have p4 := apply(mp.ranges_cat[a := a, xs := seq_concat(seq_concat(RO, DA), AX), ys := AR], fr, ar)
  have p5 := apply(mp.ranges_cat[a := a, xs := seq_concat(RO, DA), ys := AX], rd, xl)
  have p6 := apply(mp.ranges_cat[a := a, xs := RO, ys := DA], ro, dl)
  have w1: mallocng.in_ranges(a, DB) -> ui.FW(AT, L, a) proof
    assume h2
    show by defs(taut(mp(yd, h2)), ui.FW)
  qed
  have w2: mallocng.in_ranges(a, SC) -> ui.FW(AT, L, a) proof
    assume h2
    show by defs(taut(mp(ys, h2)), ui.FW)
  qed
  have w3: mallocng.in_ranges(a, RO) -> ui.FW(AT, L, a) proof
    assume h2
    show by defs(taut(mp(yro, h2)), ui.FW)
  qed
  have w4: mallocng.in_ranges(a, DA) -> ui.FW(AT, L, a) proof
    assume h2
    show by defs(taut(mp(yda, h2)), ui.FW)
  qed
  have w5: mallocng.in_ranges(a, AX) -> ui.FW(AT, L, a) proof
    assume h2
    show by defs(taut(h2), ui.FW)
  qed
  have fw: ui.FW(AT, L, a) by taut(s0, ng, p1, w1, p2, w2, p3, nr, p4, na, p5, p6, w3, w4, w5)
  show by taut(expand(fw, ui.FW))
qed

// the vector's address (past argc, argv's and envp's words)
abbrev ui.AT(m0, argv, envp) := int_add(int_add(int_add(m0.gpr[4], 24), int_mul(8, seq_len(argv))), int_mul(8, seq_len(envp)))

// a byte of the vector's ranges (the vector, AT_RANDOM's last 8 bytes):
// on exec's stack, libc's data there (the claim's initial_auxv)
theorem ui.ax_in: all m0 s lo top argv envp auxv x. ui.SX(m0, s, lo, top, argv, envp, auxv) -> x in omega ->
  mallocng.in_ranges(x, mallocng.auxv_ranges(mp.a0(ui.AT(m0, argv, envp), auxv))) ->
  int_le(m0.gpr[4], x) && int_lt(x, int_mul(top, x86_64_linux.PAGE)) && claim_malloc.initial_auxv(m0, argv, envp, x)
proof
  fix m0 s lo top argv envp auxv x
  assume hx hxo h
  have hc hlo hna hne hel hla hsl hao hsd he hu h31 := expand(hx, ui.SX)
  have hM .. := expand(hc, ui.ctx)
  have r0 := apply(x86i.rsp_typed, hM)
  let AT := ui.AT(m0, argv, envp)
  let A := mp.a0(AT, auxv)
  have nl: seq_len(auxv) in omega by defs(simp(expand(hla, list_type)), seq_len)
  have ato: AT in omega by arith(r0, hna, hne)
  have {ab = abs, au = univ} := apply(mp.a0_type[AT := AT, L := auxv], ato, hla)
  have {xl = auxv} := apply(mp.front_pieces[c := ui.C, A := A], ui.C_ok, au, ab)
  have _ _ _ _ _ aa := expand(hsl, x86_64_linux.stack_layout)
  have _ ib _ _ ir _ := expand(hsd, x86_64_linux.stack_data, x86_64_linux.in_stack, x86_64_linux.aux)
  have uq := expand(hao, x86_64_linux.auxv_ok).12
  let P1 := seq_one(pair(A.auxv_at, int_mul(16, seq_len(A.auxv))))
  let P2 := fn_build(int_sub(seq_len(A.auxv), 0), x0. ite(fst(A.auxv[int_add(0, x0)]) = x86_64_linux.AT_RANDOM, pair(int_add(snd(A.auxv[int_add(0, x0)]), 8), 8), pair(0, 0)))
  have ea: A.auxv = auxv by rsimp()
  have et: A.auxv_at = AT by rsimp()
  have p1l := apply(tr.seq_one_type, (pair(A.auxv_at, int_mul(16, seq_len(A.auxv))) in univ(1) by simp(au)))
  have al: A.auxv in list_type(cart(omega, omega)) := subst({y. y in list_type(cart(omega, omega))}, sym(ea), hla)
  have ad: int_sub(seq_len(A.auxv), 0) in omega by arith(al)
  have avu: all x0. x0 in int_sub(seq_len(A.auxv), 0) -> ite(fst(A.auxv[int_add(0, x0)]) = x86_64_linux.AT_RANDOM, pair(int_add(snd(A.auxv[int_add(0, x0)]), 8), 8), pair(0, 0)) in univ(1) proof
    fix x0
    assume hx0
    show by simp(au)
  qed
  have p2l: P2 in list_type(univ(1)) := apply(build_list, ad, avu)
  have sp := apply(mp.ranges_cat[a := x, xs := P1, ys := P2], p1l, p2l)
  have h1 := expand(h, mallocng.auxv_ranges)
  // (the libc data: the claim's set, with exec's vector)
  have av: x86_64_linux.auxv_at(m0.vm, claim_malloc.auxv_addr(m0, argv, envp), auxv) by defs(aa, claim_malloc.auxv_addr)
  // the vector's words
  have c1: mallocng.in_ranges(x, P1) -> int_le(m0.gpr[4], x) && int_lt(x, int_mul(top, x86_64_linux.PAGE)) && claim_malloc.initial_auxv(m0, argv, envp, x) proof
    assume hp
    have q0: mallocng.in_range(x, pair(A.auxv_at, int_mul(16, seq_len(A.auxv)))) by taut(mp.ranges_one[a := x, r := pair(A.auxv_at, int_mul(16, seq_len(A.auxv)))], hp)
    have q1 q2 := rsimp(expand(q0, mallocng.in_range), et, ea)
    have ia: claim_malloc.initial_auxv(m0, argv, envp, x) by defs(ex_intro({auxv}, taut(hla, av, (int_le(claim_malloc.auxv_addr(m0, argv, envp), x) by defs(q1, claim_malloc.auxv_addr)),
      (int_lt(x, int_add(claim_malloc.auxv_addr(m0, argv, envp), int_mul(16, seq_len(auxv)))) by defs(q2, claim_malloc.auxv_addr)))), claim_malloc.initial_auxv)
    show by taut((int_le(m0.gpr[4], x) by arith(q1, r0, hna, hne)), (int_lt(x, int_mul(top, x86_64_linux.PAGE)) by arith(q2, ib, r0, hna, hne, nl)), ia)
  qed
  // AT_RANDOM's last 8 bytes
  have c2: mallocng.in_ranges(x, P2) -> int_le(m0.gpr[4], x) && int_lt(x, int_mul(top, x86_64_linux.PAGE)) && claim_malloc.initial_auxv(m0, argv, envp, x) proof
    assume hp
    obtain k, ko kl kr0 from apply(mp.ranges_build_inv[a := x, n := seq_len(A.auxv),
      r := y. ite(fst(A.auxv[y]) = x86_64_linux.AT_RANDOM, pair(int_add(snd(A.auxv[y]), 8), 8), pair(0, 0))], (seq_len(A.auxv) in omega by arith(al)), hp)
    have kr := rewrite(ea, kr0)
    let c := fst(auxv[k]) = x86_64_linux.AT_RANDOM
    let v := snd(auxv[k])
    have n0: !c -> false proof
      assume nc
      have q := rsimp(expand(rewrite(mp(ite_f[c := c, a := pair(int_add(v, 8), 8), b := pair(0, 0)], nc), kr), mallocng.in_range))
      show by arith(q, hxo)
    qed
    have hcv: c by taut(n0)
    have q1 q2 := rsimp(expand(rewrite(mp(ite_t[c := c, a := pair(int_add(v, 8), 8), b := pair(0, 0)], hcv), kr), mallocng.in_range))
    obtain q, hq hk b1 b2 from ir
    have klo: int_lt(k, seq_len(auxv)) := rewrite(ea, kl)
    have aiv: startup_specs.aux_is(auxv, x86_64_linux.AT_RANDOM, v) proof
      have e: ex j. j in omega && ((int_lt(j, seq_len(auxv)) && fst(auxv[j]) = x86_64_linux.AT_RANDOM) && snd(auxv[j]) = v) by ex_intro({k}, taut(ko, klo, hcv, refl({v})))
      show by defs(taut(e), startup_specs.aux_is)
    qed
    have vq := apply(ui.aux_eq[auxv := auxv, key := x86_64_linux.AT_RANDOM, q := q, v := v], uq,
      (!(x86_64_linux.AT_RANDOM = x86_64_linux.AT_NULL) by defs(eval(), x86_64_linux.AT_RANDOM, x86_64_linux.AT_NULL)), hk, aiv)
    have x1 x2 := (int_le(q, x) && int_lt(x, int_add(q, 16)) by arith(rewrite(vq, q1), rewrite(vq, q2)))
    have ia: claim_malloc.initial_auxv(m0, argv, envp, x) by defs(ex_intro({auxv}, taut(hla, av,
      (ex x1. x1 in omega && ((x86_64_linux.aux(auxv, x86_64_linux.AT_RANDOM, x1) && int_le(x1, x)) && int_lt(x, int_add(x1, 16)))
       by ex_intro({q}, taut(hq, (x86_64_linux.aux(auxv, x86_64_linux.AT_RANDOM, q) by defs(hk, x86_64_linux.aux)), x1, x2))))), claim_malloc.initial_auxv)
    show by taut((int_le(m0.gpr[4], x) by arith(x1, b1)), (int_lt(x, int_mul(top, x86_64_linux.PAGE)) by arith(x2, b2, hq)), ia)
  qed
  show by taut(sp, h1, c1, c2)
qed

// ----------------------------------------------------------------------
//  At main: the empty heap's representation

// exec's stack data as startup read it, main's world
def ui.MX(m0, s, lo, top, argv, envp, auxv, m, V, fs) := ui.SX(m0, s, lo, top, argv, envp, auxv) &&
  ui.at_main(s, ui.iobjs(m0.gpr[4], top), m, m0.gpr[4], V, fs)

abbrev ui.A0(m0, argv, envp, auxv) := mp.a0(ui.AT(m0, argv, envp), auxv)
abbrev ui.OB(m0, argv, envp) := set_select(omega, x. claim_malloc.initial_auxv(m0, argv, envp, x))

// (the vector's typing, its address)
theorem ui.mx_typ: all m0 s lo top argv envp auxv m V fs. ui.MX(m0, s, lo, top, argv, envp, auxv, m, V, fs) ->
  ui.AT(m0, argv, envp) in omega && auxv in list_type(cart(omega, omega))
proof
  fix m0 s lo top argv envp auxv m V fs
  assume h
  have hx _ := expand(h, ui.MX)
  have hc _ hna hne _ hla .. := expand(hx, ui.SX)
  have hM .. := expand(hc, ui.ctx)
  have r0 := apply(x86i.rsp_typed, hM)
  show by taut((ui.AT(m0, argv, envp) in omega by arith(r0, hna, hne)), hla)
qed

// the thread's descriptor (in the static TLS area): apart from the
// allocator's ranges
theorem ui.fs_apart: all m0 s lo top argv envp auxv m V fs j. ui.MX(m0, s, lo, top, argv, envp, auxv, m, V, fs) -> j in omega -> int_lt(j, 56) ->
  !mallocng.in_ranges(int_add(fs, j), mallocng.fp_ranges(ui.C, ui.A0(m0, argv, envp, auxv)))
proof
  fix m0 s lo top argv envp auxv m V fs j
  assume h hj hjl hin
  have hx ha := expand(h, ui.MX)
  have hc hlo .. := expand(hx, ui.SX)
  have _ _ _ _ hl .. := expand(hc, ui.ctx)
  have _ _ _ hfs hta .. := expand(ha, ui.at_main)
  have _ it := expand(hta, startup_specs.thread_at)
  have i1 i2 := expand(it, startup_specs.in_tls)
  have bt: ui.G.builtin_tls = 4228288 by eval()
  have at al := apply(ui.mx_typ[m0 := m0, s := s, lo := lo, top := top, argv := argv, envp := envp, auxv := auxv, m := m, V := V, fs := fs], h)
  have fo: int_add(fs, j) in omega by arith(hfs, hj)
  have w := expand(apply(ui.fp_where[AT := ui.AT(m0, argv, envp), L := auxv, a := int_add(fs, j)], at, al, fo, hin), ui.FW)
  have c3: mallocng.in_ranges(int_add(fs, j), mallocng.auxv_ranges(ui.A0(m0, argv, envp, auxv))) -> false proof
    assume hh
    have b1 _ _ := apply(ui.ax_in[m0 := m0, s := s, lo := lo, top := top, argv := argv, envp := envp, auxv := auxv, x := int_add(fs, j)], hx, fo, hh)
    show by arith(b1, hl, hlo, i2, bt, hjl, hj)
  qed
  have c12: !(ui.RO(int_add(fs, j)) || ui.DATA(int_add(fs, j))) by arith(i1, i2, bt, hjl, hj, hfs)
  show by taut(w, c3, c12)
qed

// the break at main: exec's (in the user space)
theorem ui.brk_main: all m0 s lo top argv envp auxv m V fs. ui.MX(m0, s, lo, top, argv, envp, auxv, m, V, fs) ->
  int_le(ui.wvm(m.vm).brk, x86_64_linux.TASK_SIZE)
proof
  fix m0 s lo top argv envp auxv m V fs
  assume h
  have hx ha := expand(h, ui.MX)
  have hc .. := expand(hx, ui.SX)
  have he := expand(hx, ui.SX).10
  have _ _ _ _ _ _ tsk be .. := expand(he, x86_64_linux.exec_state)
  have _ _ _ _ _ _ _ h5 := expand(hc, ui.ctx)
  have _ _ _ _ _ _ _ _ _ _ ev := expand(h5, ui.s5)
  obtain v1, _ _ vf _ ve _ from ev
  have _ _ _ fb := expand(vf, x86.vm_fields)
  have _ hfr _ _ _ _ _ hvok := expand(ha, ui.at_main)
  have f1 _ := expand(hfr, startup_specs.frame)
  have vb: V.brk = s.vm.brk := rsimp(apply(ui.app_eq[k := "brk"], f1))
  have _ wm := expand(hvok, tr.vok)
  have {mb = brk} := expand(wm, tr.wmc)
  have sb: s.vm.brk = v1.brk by rsimp(ve)
  have e: ui.wvm(m.vm).brk = m0.vm.brk_start by rsimp(mb, vb, sb, fb, be)
  show := rewrite(sym(e), tsk)
qed

// the vector: the world's live objects at main (the claim's libc data)
theorem ui.aux_main: all m0 s lo top argv envp auxv m V fs. ui.MX(m0, s, lo, top, argv, envp, auxv, m, V, fs) ->
  mallocng.aux_live(ui.A0(m0, argv, envp, auxv), abi.objs_at(ui.OB(m0, argv, envp), m.fs_base))
proof
  fix m0 s lo top argv envp auxv m V fs
  assume h
  have hx _ := expand(h, ui.MX)
  unfold mallocng.aux_live
  assume _
  fix a
  assume ho hin
  have _ _ ia := apply(ui.ax_in[m0 := m0, s := s, lo := lo, top := top, argv := argv, envp := envp, auxv := auxv, x := a], hx, ho, hin)
  have ob: a in ui.OB(m0, argv, envp) by sel(conj(ho, ia))
  show by defs(rsimp(ob), abi.objs_at)
qed

// (a pair of a product: its parts in the factors)
theorem ui.cart_parts: all z a b. z in cart(a, b) -> fst(z) in a && snd(z) in b
proof
  fix z a b
  assume h
  obtain x, hx from mp(cart_elim[a := a, b := b, z := z], h)
  obtain y, hy from hx
  have xa yb ez := hy
  have f: fst(z) = x by rsimp(ez)
  have s: snd(z) = y by rsimp(ez)
  show := conj(rewrite(sym(f), xa), rewrite(sym(s), yb))
qed

// (ranges apart: each byte of one names it -- f(a) the range's index)
theorem ui.sep_class(rs, x. f): rs in list_type(cart(omega, omega)) ->
  (all k a. k in omega -> int_lt(k, seq_len(rs)) -> a in omega -> mallocng.in_range(a, rs[k]) -> f(a) = k) -> mallocng.separate(rs)
proof
  assume hl hf
  unfold mallocng.separate
  fix k l
  assume hkl hlt
  have ko lo := hkl
  have kl ll ne := hlt
  have tk := mp(at_type[l := rs, t := cart(omega, omega), i := k], hl, ko, kl)
  have tl := mp(at_type[l := rs, t := cart(omega, omega), i := l], hl, lo, ll)
  have k1 k2 := apply(ui.cart_parts[z := rs[k], a := omega, b := omega], tk)
  have l1 l2 := apply(ui.cart_parts[z := rs[l], a := omega, b := omega], tl)
  // (overlapping: the later start in both)
  have no: !mallocng.apart(rs[k], rs[l]) -> false proof
    assume hn
    have n1 n2 n3 n4: !(snd(rs[k]) = 0) && !(snd(rs[l]) = 0) && !int_le(int_add(fst(rs[k]), snd(rs[k])), fst(rs[l])) &&
      !int_le(int_add(fst(rs[l]), snd(rs[l])), fst(rs[k])) by taut(expand((!mallocng.apart(rs[k], rs[l]) by taut(hn)), mallocng.apart))
    have c1: int_le(fst(rs[k]), fst(rs[l])) -> false proof
      assume h1
      have a1: mallocng.in_range(fst(rs[l]), rs[k]) by defs(arith(h1, n3, k1, k2, l1), mallocng.in_range)
      have a2: mallocng.in_range(fst(rs[l]), rs[l]) by defs(arith(n2, l1, l2), mallocng.in_range)
      have e1 := mp(all_elim(hf, {k}, {fst(rs[l])}), ko, kl, l1, a1)
      have e2 := mp(all_elim(hf, {l}, {fst(rs[l])}), lo, ll, l1, a2)
      show by taut(ne, trans(sym(e1), e2))
    qed
    have c2: int_lt(fst(rs[l]), fst(rs[k])) -> false proof
      assume h1
      have a1: mallocng.in_range(fst(rs[k]), rs[l]) by defs(arith(h1, n4, k1, l1, l2), mallocng.in_range)
      have a2: mallocng.in_range(fst(rs[k]), rs[k]) by defs(arith(n1, k1, k2), mallocng.in_range)
      have e1 := mp(all_elim(hf, {l}, {fst(rs[k])}), lo, ll, k1, a1)
      have e2 := mp(all_elim(hf, {k}, {fst(rs[k])}), ko, kl, k1, a2)
      show by taut(ne, trans(sym(e2), e1))
    qed
    show by taut(c1, c2, (int_le(fst(rs[k]), fst(rs[l])) || int_lt(fst(rs[l]), fst(rs[k])) by arith(k1, l1)))
  qed
  show by taut(no)
qed

// (a byte of header i's read-only range: of load 0, 1 or 2)
abbrev ui.S0(a) := int_le(4194304, a) && int_lt(a, 4194816)
abbrev ui.S1(a) := int_le(4198400, a) && int_lt(a, 4216671)
abbrev ui.S2(a) := int_le(4218880, a) && int_lt(a, 4219184)

theorem ui.ro_at: all a k. a in omega -> k in omega ->
  mallocng.in_range(a, ite(x86_64_linux.is_load(musl_malloc.file, k) && !bit(x86_64_linux.segment(musl_malloc.file, k).flags, 1),
    pair(x86_64_linux.segment(musl_malloc.file, k).vaddr, x86_64_linux.segment(musl_malloc.file, k).memsz), pair(0, 0))) ->
  (k = 0 && ui.S0(a)) || (k = 1 && ui.S1(a)) || (k = 2 && ui.S2(a))
proof
  fix a k
  assume ha hk hr
  let F := musl_malloc.file
  let c := x86_64_linux.is_load(F, k) && !bit(x86_64_linux.segment(F, k).flags, 1)
  let P := pair(x86_64_linux.segment(F, k).vaddr, x86_64_linux.segment(F, k).memsz)
  have c0: !c -> false proof
    assume nc
    have e := mp(ite_f[c := c, a := P, b := pair(0, 0)], nc)
    have r0 := rsimp(expand(rewrite(e, hr), mallocng.in_range))
    show by arith(r0, ha)
  qed
  have hc: c by taut(c0)
  have hl hnb := hc
  have e := mp(ite_t[c := c, a := P, b := pair(0, 0)], hc)
  have b1 b2 := rsimp(expand(rewrite(e, hr), mallocng.in_range))
  have kk := apply(ui.loads[j := k], hk, hl)
  have {g0 = s0, g1 = s1, g2 = s2, g3 = s3} := ui.elf
  have _ _ _ v0 _ m0 := expand(g0, ui.segis)
  have _ _ _ v1 _ m1 := expand(g1, ui.segis)
  have _ _ _ v2 _ m2 := expand(g2, ui.segis)
  have _ f3 _ _ _ _ := expand(g3, ui.segis)
  have d0: k = 0 -> ui.S0(a) proof
    assume e0
    show by arith(rewrite(e0, b1), rewrite(e0, b2), v0, m0)
  qed
  have d1: k = 1 -> ui.S1(a) proof
    assume e0
    show by arith(rewrite(e0, b1), rewrite(e0, b2), v1, m1)
  qed
  have d2: k = 2 -> ui.S2(a) proof
    assume e0
    show by arith(rewrite(e0, b1), rewrite(e0, b2), v2, m2)
  qed
  have d3: k = 3 -> false proof
    assume e0
    show by taut(rewrite(f3, rewrite(e0, hnb)), (bit(6, 1) by eval()))
  qed
  show by taut(kk, d0, d1, d2, d3)
qed

// (the range a byte of the regions is in: by its address)
abbrev ui.F(a) := ite(int_lt(a, 4194816), 3, ite(int_lt(a, 4216671), 4, ite(int_lt(a, 4219184), 5, ite(int_lt(a, 4227152), 2, ite(int_lt(a, 4227304), 1, 0)))))

theorem ui.f_vals: all a. a in omega -> (ui.S0(a) -> ui.F(a) = 3) && (ui.S1(a) -> ui.F(a) = 4) && (ui.S2(a) -> ui.F(a) = 5) &&
  (int_le(4227136, a) && int_lt(a, 4227152) -> ui.F(a) = 2) && (int_le(4227300, a) && int_lt(a, 4227304) -> ui.F(a) = 1) &&
  (int_le(4227328, a) && int_lt(a, 4228256) -> ui.F(a) = 0)
proof
  fix a
  assume ha
  have v0: ui.S0(a) -> ui.F(a) = 3 proof
    assume h
    show by rsimp((int_lt(a, 4194816) by arith(h)))
  qed
  have v1: ui.S1(a) -> ui.F(a) = 4 proof
    assume h
    show by rsimp((!int_lt(a, 4194816) by arith(h)), (int_lt(a, 4216671) by arith(h)))
  qed
  have v2: ui.S2(a) -> ui.F(a) = 5 proof
    assume h
    show by rsimp((!int_lt(a, 4194816) by arith(h)), (!int_lt(a, 4216671) by arith(h)), (int_lt(a, 4219184) by arith(h)))
  qed
  have v3: int_le(4227136, a) && int_lt(a, 4227152) -> ui.F(a) = 2 proof
    assume h
    show by rsimp((!int_lt(a, 4194816) by arith(h)), (!int_lt(a, 4216671) by arith(h)), (!int_lt(a, 4219184) by arith(h)), (int_lt(a, 4227152) by arith(h)))
  qed
  have v4: int_le(4227300, a) && int_lt(a, 4227304) -> ui.F(a) = 1 proof
    assume h
    show by rsimp((!int_lt(a, 4194816) by arith(h)), (!int_lt(a, 4216671) by arith(h)), (!int_lt(a, 4219184) by arith(h)), (!int_lt(a, 4227152) by arith(h)),
      (int_lt(a, 4227304) by arith(h)))
  qed
  have v5: int_le(4227328, a) && int_lt(a, 4228256) -> ui.F(a) = 0 proof
    assume h
    show by rsimp((!int_lt(a, 4194816) by arith(h)), (!int_lt(a, 4216671) by arith(h)), (!int_lt(a, 4219184) by arith(h)), (!int_lt(a, 4227152) by arith(h)),
      (!int_lt(a, 4227304) by arith(h)))
  qed
  show by taut(v0, v1, v2, v3, v4, v5)
qed

// the regions of the empty state (the data symbols, the read-only loads,
// no areas, no reserve, no groups): apart
theorem ui.sep_regions: all AT L. AT in omega -> L in list_type(cart(omega, omega)) -> mallocng.separate(mallocng.regions(ui.C, mp.a0(AT, L)))
proof
  fix AT L
  assume hat hl
  let A := mp.a0(AT, L)
  let F := musl_malloc.file
  have {ab = abs, au = univ} := apply(mp.a0_type[AT := AT, L := L], hat, hl)
  have {pf = front, pa = areas, pr = rodata, prs = reserve, pg = groups, peq = eq} := apply(mp.regions_parts[c := ui.C, A := A], ui.C_ok, au, ab)
  let P0 := pair(ui.C.ctx, mallocng.CTX_SIZE)
  let P1 := pair(ui.C.lock, 4)
  let P2 := pair(ui.C.libc, 16)
  let DA := mallocng.data_ranges(ui.C)
  let RO := mallocng.ro_ranges(ui.C.file)
  let AR := fn_build(int_sub(seq_len(A.areas), 0), x0. pair(A.areas[int_add(0, x0)], 4096))
  let RS := seq_one(pair(A.reserve, int_mul(4096, A.reserve_cnt)))
  let GR := fn_build(int_sub(seq_len(A.used), 0), x0. ite(int_lt(0, A.metas[A.used[int_add(0, x0)]].maplen), mallocng.group_range(A.metas[A.used[int_add(0, x0)]]), pair(0, 0)))
  let X2 := seq_concat(DA, RO)
  let X3 := seq_concat(X2, AR)
  let X4 := seq_concat(X3, RS)
  let R := seq_concat(X4, GR)
  have rt: R in list_type(cart(omega, omega)) := apply(tr.concat_list, apply(tr.concat_list, pf, apply(tr.seq_one_type, prs)), pg)
  // (the pieces: lists)
  have ro := apply(mp.ro_list, (ui.C.file in seq_type(bits(8)) by simp(ui.file_bytes)))
  have cf: ui.C.ctx in omega && ui.C.lock in omega && ui.C.libc in omega by simp(ui.C_ok)
  have o1 := apply(tr.seq_one_type, (P0 in univ(1) by simp(cf)))
  have o2 := apply(tr.seq_one_type, (P1 in univ(1) by simp(cf)))
  have o3 := apply(tr.seq_one_type, (P2 in univ(1) by simp(cf)))
  have dl: DA in list_type(univ(1)) by defs(apply(tr.concat_list, apply(tr.concat_list, o1, o2), o3), mallocng.data_ranges)
  have rsl := apply(tr.seq_one_type, prs)
  have x4c := apply(tr.concat_list, pf, rsl)
  // (their lengths)
  have {u0 = used, r0 = areas} := mp.e_lens[AT := AT, L := L]
  have dG: seq_len(GR) = int_sub(seq_len(A.used), 0) by defs(fn_build_dom[d := int_sub(seq_len(A.used), 0),
    v := x0. ite(int_lt(0, A.metas[A.used[int_add(0, x0)]].maplen), mallocng.group_range(A.metas[A.used[int_add(0, x0)]]), pair(0, 0))], seq_len)
  have lG: seq_len(GR) = 0 by arith(dG, u0)
  have dA: seq_len(AR) = int_sub(seq_len(A.areas), 0) by defs(fn_build_dom[d := int_sub(seq_len(A.areas), 0), v := x0. pair(A.areas[int_add(0, x0)], 4096)], seq_len)
  have lA: seq_len(AR) = 0 by arith(dA, r0)
  have lS: seq_len(RS) = 1 by arith(rsl)
  have {pn = phnum} := ui.elf
  have fe: ui.C.file = F by rsimp()
  have dR: seq_len(mallocng.ro_ranges(F)) = int_sub(x86_64_linux.phnum(F), 0) by defs(fn_build_dom[d := int_sub(x86_64_linux.phnum(F), 0),
    v := x0. ite(x86_64_linux.is_load(F, int_add(0, x0)) && !bit(x86_64_linux.segment(F, int_add(0, x0)).flags, 1),
      pair(x86_64_linux.segment(F, int_add(0, x0)).vaddr, x86_64_linux.segment(F, int_add(0, x0)).memsz), pair(0, 0))], seq_len, mallocng.ro_ranges)
  have lR: seq_len(RO) = 8 := rewrite(sym(fe), (seq_len(mallocng.ro_ranges(F)) = 8 by arith(dR, pn)))
  have lD: seq_len(DA) = 3 by defs(len_literal[x := P0, y := P1, z := P2], mallocng.data_ranges)
  have l2: seq_len(X2) = 11 by arith(dl, ro, lD, lR)
  have l3: seq_len(X3) = 11 by arith(pr, pa, l2, lA)
  have l4: seq_len(X4) = 12 by arith(pf, rsl, l3, lS)
  have lT: seq_len(R) = 12 by arith(x4c, pg, l4, lG)
  have H: all k a. k in omega -> int_lt(k, seq_len(R)) -> a in omega -> mallocng.in_range(a, R[k]) -> ui.F(a) = k proof
    fix k a
    assume ko kl ao hr
    have fv0 fv1 fv2 fv3 fv4 fv5 := apply(ui.f_vals[a := a], ao)
    have e1 := at({R[k]}, x4c, pg, ko, (int_lt(k, seq_len(X4)) by arith(kl, lT, l4)))
    have h4 := rewrite(e1, hr)
    // (the reserve: none)
    have c11: !int_lt(k, 11) -> ui.F(a) = k proof
      assume n11
      have e2 := at({X4[int_add(seq_len(X3), 0)]}, pf, rsl, (0 in omega by eval()), (int_lt(0, seq_len(RS)) by arith(lS)))
      have z: k = int_add(seq_len(X3), 0) by arith(n11, l3, kl, lT, ko)
      have q := rsimp(expand(rewrite(e2, rewrite(z, h4)), mallocng.in_range))
      show by arith(q, ao)
    qed
    have clt: int_lt(k, 11) -> ui.F(a) = k proof
      assume k11
      have e2 := at({X4[k]}, pf, rsl, ko, (int_lt(k, seq_len(X3)) by arith(k11, l3)))
      have e3 := at({X3[k]}, pr, pa, ko, (int_lt(k, seq_len(X2)) by arith(k11, l2)))
      have h2 := rewrite(e3, rewrite(e2, h4))
      // (the data symbols)
      have cd: int_lt(k, 3) -> ui.F(a) = k proof
        assume k3
        have e4 := at({X2[k]}, dl, ro, ko, (int_lt(k, seq_len(DA)) by arith(k3, lD)))
        have hd := rewrite(e4, h2)
        have d0: k = 0 -> ui.F(a) = k proof
          assume e0
          have dv: DA[0] = P0 by defs(at({seq_concat(seq_concat(seq_one(P0), seq_one(P1)), seq_one(P2))[0]}), mallocng.data_ranges)
          have q1 q2 := rsimp(expand(rewrite(dv, rewrite(e0, hd)), mallocng.in_range))
          show := rewrite(sym(e0), mp(fv5, (int_le(4227328, a) && int_lt(a, 4228256) by arith(q1, q2, (ui.C.ctx = 4227328 by eval()), (mallocng.CTX_SIZE = 928 by defs(eval(), mallocng.CTX_SIZE))))))
        qed
        have d1: k = 1 -> ui.F(a) = k proof
          assume e0
          have dv: DA[1] = P1 by defs(at({seq_concat(seq_concat(seq_one(P0), seq_one(P1)), seq_one(P2))[1]}), mallocng.data_ranges)
          have q1 q2 := rsimp(expand(rewrite(dv, rewrite(e0, hd)), mallocng.in_range))
          show := rewrite(sym(e0), mp(fv4, (int_le(4227300, a) && int_lt(a, 4227304) by arith(q1, q2, (ui.C.lock = 4227300 by eval())))))
        qed
        have d2: k = 2 -> ui.F(a) = k proof
          assume e0
          have dv: DA[2] = P2 by defs(at({seq_concat(seq_concat(seq_one(P0), seq_one(P1)), seq_one(P2))[2]}), mallocng.data_ranges)
          have q1 q2 := rsimp(expand(rewrite(dv, rewrite(e0, hd)), mallocng.in_range))
          show := rewrite(sym(e0), mp(fv3, (int_le(4227136, a) && int_lt(a, 4227152) by arith(q1, q2, (ui.C.libc = 4227136 by eval())))))
        qed
        show by taut(d0, d1, d2, (k = 0 || k = 1 || k = 2 by arith(k3, ko)))
      qed
      // (the read-only loads)
      have cr: !int_lt(k, 3) -> ui.F(a) = k proof
        assume n3
        let j := int_sub(k, seq_len(DA))
        have jo: j in omega by arith(n3, lD, ko)
        have e4 := at({X2[int_add(seq_len(DA), j)]}, dl, ro, jo, (int_lt(j, seq_len(RO)) by arith(k11, lD, lR, n3)))
        have kj: k = int_add(seq_len(DA), j) by arith(n3, lD, ko)
        have ij: int_sub(int_add(seq_len(DA), j), seq_len(DA)) = j by arith(jo, lD)
        have hr2 := rewrite(fe, rewrite(ij, rewrite(e4, rewrite(kj, h2))))
        have jm: j in int_sub(x86_64_linux.phnum(F), 0) := mp(nat_lt_mem[k := j, n := int_sub(x86_64_linux.phnum(F), 0)], jo, (int_sub(x86_64_linux.phnum(F), 0) in omega by arith(pn)),
          (int_lt(j, int_sub(x86_64_linux.phnum(F), 0)) by arith(k11, lD, pn, n3)))
        have ev := mp(app_fn_build[d := int_sub(x86_64_linux.phnum(F), 0),
          v := x0. ite(x86_64_linux.is_load(F, int_add(0, x0)) && !bit(x86_64_linux.segment(F, int_add(0, x0)).flags, 1),
            pair(x86_64_linux.segment(F, int_add(0, x0)).vaddr, x86_64_linux.segment(F, int_add(0, x0)).memsz), pair(0, 0)), a := j], jm)
        have hr3 := rewrite(ev, expand(hr2, mallocng.ro_ranges))
        have w := apply(ui.ro_at[a := a, k := int_add(0, j)], ao, arith(jo), hr3)
        have r0: int_add(0, j) = 0 && ui.S0(a) -> ui.F(a) = k proof
          assume hh
          have z s := hh
          show := trans(mp(fv0, s), (3 = k by arith(z, lD, ko, n3)))
        qed
        have r1: int_add(0, j) = 1 && ui.S1(a) -> ui.F(a) = k proof
          assume hh
          have z s := hh
          show := trans(mp(fv1, s), (4 = k by arith(z, lD, ko, n3)))
        qed
        have r2: int_add(0, j) = 2 && ui.S2(a) -> ui.F(a) = k proof
          assume hh
          have z s := hh
          show := trans(mp(fv2, s), (5 = k by arith(z, lD, ko, n3)))
        qed
        show by taut(w, r0, r1, r2)
      qed
      show by taut(cd, cr)
    qed
    show by taut(c11, clt)
  qed
  have sR := apply(ui.sep_class[rs := R, f := a. ui.F(a)], rt, H)
  show := rewrite(sym(peq), sR)
qed