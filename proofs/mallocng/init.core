    show by arith(hi, hil)
  qed
  have r := apply(ui.img_read[argv := argv, envp := envp, m0 := m0, s := s, lo := lo, top := top, j := 2, ty := 1, fl := 4, of := 24576, va := 4218880, fs := 304, ms := 304,
    a := 4218880, n := 1], he, hc, hlo, eval(), eval(), g2, eval(), eval(), eval(), eval(), eval(), eval(), eval(), pg)
  have fv := apply(ui.le_val[F := musl_malloc.file, off := int_add(24576, int_sub(4218880, 4218880)), n := 1, v := 0], unfold(musl_malloc.file), eval(), eval(), eval(), eval(), eval())
  have us1 := apply(ui.us_img[argv := argv, envp := envp, m0 := m0, s := s, lo := lo, top := top, x := 4218880, n := 1, w := false], he, hc, hlo, eval(), pg)
  have us := subst({y. gimple.usable(ui.wvm(s.vm), ui.wob0(m0.gpr[4], top), 4218880, y, false)}, (1 = int_add(0, 1) by eval()), us1)
  have b0: gimple.bytes_at(ui.wvm(s.vm), bits_of_int(64, int_add(4218880, 0)), 1) = 0 by rsimp(trans(r, fv))
  have nw: all i. i in omega -> int_le(i, 0) -> !(int_add(4218880, i) in startup_specs.start_writes(ui.G)) proof
    fix i
    assume hi hil hw
    have _ b _ := apply(ui.sw_range[x := int_add(4218880, i)], hw)
    show by arith(b, hil, hi)
  qed
  have nb: all i. i in omega -> int_lt(i, 0) -> !(gimple.bytes_at(ui.wvm(s.vm), bits_of_int(64, int_add(4218880, i)), 1) = 0) proof
    fix i
    assume hi hil
    show by arith(hi, hil)
  qed
  have c: startup_specs.cstr(ui.wvm(s.vm), ui.wob0(m0.gpr[4], top), 4218880, startup_specs.start_writes(ui.G)) by defs(ex_intro({0},
    taut((0 in omega by eval()), (!(4218880 = 0) by eval()), (int_lt(int_add(int_add(4218880, 0), 1), int_pow(2, 63)) by eval()), us, nb, b0, nw)), startup_specs.cstr)
  show := rewrite(sym(pv), c)
qed

// (program header i: at 64 + 56 i in the file)
theorem ui.ph_eq: all i. x86_64_linux.ph(musl_malloc.file, i) = int_add(64, int_mul(56, i))
proof
