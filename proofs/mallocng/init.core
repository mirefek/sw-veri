  have po := apply(ui.le_val[F := musl_malloc.file, off := 32, n := 8, v := 64], unfold(musl_malloc.file), eval(), eval(), eval(), eval(), eval())
  show by defs(rsimp(po), x86_64_linux.ph, x86_64_linux.phoff)
qed

// AT_PHDR: the headers where the first page maps them
theorem ui.phdr_q: all q. x86_64_linux.phdr_at(musl_malloc.file, q) -> q = 4194368
proof
  fix q
  assume h
  obtain i, hi hl hm hq from expand(h, x86_64_linux.phdr_at)
  have i0: i = 0 proof
    have n: int_lt(0, i) -> false proof
      assume lt
      show by taut(mp(all_elim(hm, {0}), eval(), lt), apply(ui.load_i[i := 0], eval(), eval()))
    qed
    show by arith(n, hi)
  qed
  have {g0 = s0} := ui.elf
  have _ _ eo ev _ _ := expand(g0, ui.segis)
  have po := apply(ui.le_val[F := musl_malloc.file, off := 32, n := 8, v := 64], unfold(musl_malloc.file), eval(), eval(), eval(), eval(), eval())
  have pf: x86_64_linux.phoff(musl_malloc.file) = 64 by defs(po, x86_64_linux.phoff)
  have q2 := rewrite(i0, hq)
  show by rsimp(q2, eo, ev, pf)
qed

