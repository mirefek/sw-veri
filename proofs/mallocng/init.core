// Startup to main: the claim's open lemma `musl.init` -- from exec's state
// at `_start`, the run to main's entry reaches it with the empty heap's
// invariant (proofs/mallocng/model/empty.core) holding.

// ----------------------------------------------------------------------
//  The claim's run to main as the bridge's run with a stop

// (the claim's loop body: a step until rip = t)
abbrev ui.U(t, l, o) := (!(fst(l).rip = t) && bind_rel(x86_64_linux.step, fst(l), x5 x6. o = ok(pair(x5, empty), empty), x5 x6. o = exc(pair(x5, empty), pair("raise", x6)), x5. o = diverge(x5))) ||
  (!!(fst(l).rip = t) && o = exc(pair(fst(l), empty), pair("brk", empty)))

// the claim's run to t from m0 ending at m, unfolded
def ui.UR(t, m0, m) := ex x0. while_rel(pair(m0, empty), l. true, l o. ui.U(t, l, o), l. fn_update(empty, "os.events", fst(l).os.events), x0) &&
  (((fst(x0) = 0 || (fst(x0) = 1 && fst(out_value(x0)) = "brk")) && m = fst(out_state(x0))) ||
   ((fst(x0) = 1 && fst(out_value(x0)) = "ret") && (m = fst(out_state(x0)) && empty = snd(out_value(x0)))))

theorem ui.until_parts: all t m0 m. runs(claim_malloc.run_until(t), m0, ok(m, empty)) -> ui.UR(t, m0, m)
proof
  fix t m0 m
  assume hr
  show by defs(simp(expand(hr, claim_malloc.run_until)), ui.UR)
qed

// the stopped run's outcomes when the claim's run gets to t at m: the stop
// at m, the discipline broken, or the entry's return reached
def ui.Q(s, m, o) := o = ok(m, exc_val("stop", empty)) || (ex x. o = exc(x, exc_val("disc", empty))) || (ex x. o = ok(x, empty) && tr.at_ret(s, x))

// (the stopped run from l: one of those)
def ui.Z(s, t, m, l) := ex r2 o2. while_rel(l, x. true, x y. tr.rbs(s, t, x, y), x. fn_update(empty, "os.events", fst(x).os.events), r2) &&
  !(fst(r2) = 2) && tr.rmap(r2, o2) && ui.Q(s, m, o2)

// (one pass leaving the stopped run: its result)
theorem ui.z_leave: all s t m l r2 o2. tr.rbs(s, t, l, r2) -> !is_ok(r2) -> !(fst(r2) = 2) -> tr.rmap(r2, o2) -> ui.Q(s, m, o2) -> ui.Z(s, t, m, l)
proof
  fix s t m l r2 o2
  assume hb hn hd hm hq
  have w := apply(while_leave[l0 := l, c := x. true, b := x y. tr.rbs(s, t, x, y), tr := x. fn_update(empty, "os.events", fst(x).os.events), r := r2], rsimp(), hb, hn)
  show by defs(ex_intro({r2}, {o2}, taut(w, hd, hm, hq)), ui.Z)
qed

// (the discipline broken at x: one of those)
theorem ui.q_disc: all s m x. ui.Q(s, m, exc(x, exc_val("disc", empty)))
proof
  fix s m x
  have ex: ex y. exc(x, exc_val("disc", empty)) = exc(y, exc_val("disc", empty)) by ex_intro({x}, refl({exc(x, exc_val("disc", empty))}))
  show by defs(taut(ex), ui.Q)
qed

// (a normal outcome: its state and value)
theorem ui.ok_inj: all a b c d. ok(a, b) = ok(c, d) -> a = c && b = d
proof
  fix a b c d
  assume e
  have _ e2 := apply(pair_inj[a := 0, b := pair(a, b), c := 0, d := pair(c, d)], (pair(0, pair(a, b)) = pair(0, pair(c, d)) by defs(e, ok, tag)))
  show := apply(pair_inj[a := a, b := b, c := c, d := d], e2)
qed

// (an exception: its state and value)
theorem ui.exc_inj: all a b c d. exc(a, b) = exc(c, d) -> a = c && b = d
proof
  fix a b c d
  assume e
  have _ e2 := apply(pair_inj[a := 1, b := pair(a, b), c := 1, d := pair(c, d)], (pair(1, pair(a, b)) = pair(1, pair(c, d)) by defs(e, exc, tag)))
  show := apply(pair_inj[a := a, b := b, c := c, d := d], e2)
qed

theorem ui.exc_nok: all a v. !is_ok(exc(a, v))
proof
  fix a v
  have n: is_ok(exc(a, v)) -> false proof
    assume h
    obtain x y, h2 from expand(h, is_ok)
    show := rsimp(h2)
  qed
  show by taut(n)
qed

// The claim's run to t from m0 ending at m: a stopped run from m0 (the
// entry s, its return address not t) ends with the stop at m, the
// discipline broken, or at the entry's return -- it takes the claim's
// steps
theorem ui.until_run: all s t m0 m. ui.UR(t, m0, m) -> !(t = x86_64_linux.le(s.vm.bytes, s.gpr[4], 8)) ->
  ex o. tr.run_s(s, t, m0, o) && ui.Q(s, m, o)
proof
  fix s t m0 m
  assume hr hnt
  obtain r, hw hm from expand(hr, ui.UR)
  // (the last pass: rip = t, at m)
  have base: all l. ((!true && r = ok(l, empty)) || (true && ui.U(t, l, r) && !is_ok(r))) -> ui.Z(s, t, m, l) proof
    fix l
    assume hl
    have u nr := (ui.U(t, l, r) && !is_ok(r) by taut(hl))
    have ca: !(fst(l).rip = t) && bind_rel(x86_64_linux.step, fst(l), x5 x6. r = ok(pair(x5, empty), empty), x5 x6. r = exc(pair(x5, empty), pair("raise", x6)), x5. r = diverge(x5)) -> false proof
      assume h
      have _ bd := h
      obtain o, _ oc from expand(bd, bind_rel)
      have c1: (ex s1 v. o = ok(s1, v) && r = ok(pair(s1, empty), empty)) -> false proof
        assume h1
        obtain s1 v, _ er from h1
        have io: is_ok(r) by defs(ex_intro({pair(s1, empty)}, {empty}, er), is_ok)
        show by taut(io, nr)
      qed
      have c2: (ex s1 x. o = exc(s1, x) && r = exc(pair(s1, empty), pair("raise", x))) -> false proof
        assume h2
        obtain s1 x, _ er from h2
        show := rsimp(rewrite(er, hm))
      qed
      have c3: (ex d. o = diverge(d) && r = diverge(d)) -> false proof
        assume h3
        obtain d, _ er from h3
        show := rsimp(rewrite(er, hm))
      qed
      show by taut(oc, c1, c2, c3)
    qed
    have rt er := (fst(l).rip = t && r = exc(pair(fst(l), empty), pair("brk", empty)) by taut(u, ca))
    have em: m = fst(l) := rsimp(rewrite(er, hm))
    have nret: !tr.at_ret(s, fst(l)) proof
      assume h
      have q _ := h
      show by taut(hnt, trans(sym(rt), q))
    qed
    have cs1: int_lt(fst(l).gpr[4], abi.sp(s)) -> ui.Z(s, t, m, l) proof
      assume hlt
      let r2 := exc(l, pair("ret", exc_val("stop", empty)))
      have b: tr.rbs(s, t, l, r2) by defs(taut(rt, nret, hlt, refl({r2})), tr.rbs)
      have rm: tr.rmap(r2, ok(m, exc_val("stop", empty))) by defs(rsimp(em), tr.rmap)
      have q: ui.Q(s, m, ok(m, exc_val("stop", empty))) by defs(taut(refl({ok(m, exc_val("stop", empty))})), ui.Q)
      show := apply(ui.z_leave, b, ui.exc_nok[a := l, v := pair("ret", exc_val("stop", empty))], rsimp(), rm, q)
    qed
    have cs2: !int_lt(fst(l).gpr[4], abi.sp(s)) -> ui.Z(s, t, m, l) proof
      assume hge
      let r2 := exc(l, pair("raise", exc_val("disc", empty)))
      have b: tr.rbs(s, t, l, r2) by defs(taut(nret, hge, refl({r2})), tr.rbs, tr.rbd)
      have rm: tr.rmap(r2, exc(fst(l), exc_val("disc", empty))) by defs(rsimp(), tr.rmap)
      show := apply(ui.z_leave, b, ui.exc_nok[a := l, v := pair("raise", exc_val("disc", empty))], rsimp(), rm, ui.q_disc[s := s, m := m, x := fst(l)])
    qed
    show by taut(cs1, cs2)
  qed
  // (a step: the stopped run takes it too, or leaves there)
  have stp: all l l1. true -> ui.U(t, l, ok(l1, empty)) -> ui.Z(s, t, m, l1) -> ui.Z(s, t, m, l) proof
    fix l l1
    assume _ u z1
    have nb: !(!!(fst(l).rip = t) && ok(l1, empty) = exc(pair(fst(l), empty), pair("brk", empty))) by rsimp()
    have rt bd := (!(fst(l).rip = t) && bind_rel(x86_64_linux.step, fst(l), x5 x6. ok(l1, empty) = ok(pair(x5, empty), empty), x5 x6. ok(l1, empty) = exc(pair(x5, empty), pair("raise", x6)), x5. ok(l1, empty) = diverge(x5)) by taut(u, nb))
    have cs1: !tr.disc_ok(s, fst(l)) -> ui.Z(s, t, m, l) proof
      assume hnd
      let r2 := exc(l, pair("raise", exc_val("disc", empty)))
      have b: tr.rbs(s, t, l, r2) by defs(taut(rt, hnd, refl({r2})), tr.rbs, tr.rbd)
      have rm: tr.rmap(r2, exc(fst(l), exc_val("disc", empty))) by defs(rsimp(), tr.rmap)
      show := apply(ui.z_leave, b, ui.exc_nok[a := l, v := pair("raise", exc_val("disc", empty))], rsimp(), rm, ui.q_disc[s := s, m := m, x := fst(l)])
    qed
    have cs2: tr.disc_ok(s, fst(l)) -> tr.at_ret(s, fst(l)) -> ui.Z(s, t, m, l) proof
      assume hd hret
      let r2 := exc(pair(fst(l), empty), pair("brk", empty))
      have b: tr.rbs(s, t, l, r2) by defs(taut(rt, hd, hret, refl({r2})), tr.rbs, tr.rbd, tr.rb)
      have rm: tr.rmap(r2, ok(fst(l), empty)) by defs(rsimp(), tr.rmap)
      have ex: ex x. ok(fst(l), empty) = ok(x, empty) && tr.at_ret(s, x) by ex_intro({fst(l)}, taut(hret, refl({ok(fst(l), empty)})))
      have q: ui.Q(s, m, ok(fst(l), empty)) by defs(taut(ex), ui.Q)
      show := apply(ui.z_leave, b, ui.exc_nok[a := pair(fst(l), empty), v := pair("brk", empty)], rsimp(), rm, q)
    qed
    have cs3: tr.disc_ok(s, fst(l)) -> !tr.at_ret(s, fst(l)) -> ui.Z(s, t, m, l) proof
      assume hd hnr
      have b: tr.rbs(s, t, l, ok(l1, empty)) by defs(taut(rt, hd, hnr, bd), tr.rbs, tr.rbd, tr.rb)
      obtain r1 o1, w1 d1 m1 q1 from expand(z1, ui.Z)
      have w := apply(while_step[l0 := l, l1 := l1, c := x. true, b := x y. tr.rbs(s, t, x, y), tr := x. fn_update(empty, "os.events", fst(x).os.events), r := r1], rsimp(), b, w1, d1)
      show by defs(ex_intro({r1}, {o1}, taut(w, d1, m1, q1)), ui.Z)
    qed
    show by taut(cs1, cs2, cs3)
  qed
  have nd: !(fst(r) = 2) proof
    assume h2
    show := rsimp(rewrite(h2, hm))
  qed
  have z0 := apply(while_run_ind[l0 := pair(m0, empty), c := l. true, b := l o. ui.U(t, l, o), tr := l. fn_update(empty, "os.events", fst(l).os.events), r := r, z := l. ui.Z(s, t, m, l)], base, stp, hw, nd)
  obtain r2 o2, w2 _ m2 q2 from expand(z0, ui.Z)
  have rs: tr.run_s(s, t, m0, o2) by defs(ex_intro({r2}, taut(w2, m2)), tr.run_s, tr.rws)
  show by ex_intro({o2}, taut(rs, q2))
qed

// The claim's run to t from m0 (not at t) ending at m: its first step
// ends normally, at m1, and the run from m1 ends at m
theorem ui.until_step: all t m0 m. !(m0.rip = t) -> ui.UR(t, m0, m) ->
  ex m1 v. runs(x86_64_linux.step(), m0, ok(m1, v)) && ui.UR(t, m1, m)
proof
  fix t m0 m
  assume hnt hr
  obtain r, hw hm from expand(hr, ui.UR)
  have nd: !(fst(r) = 2) proof
    assume h2
    show := rsimp(rewrite(h2, hm))
  qed
  have u := apply(while_unroll[l0 := pair(m0, empty), c := l. true, b := l o. ui.U(t, l, o), tr := l. fn_update(empty, "os.events", fst(l).os.events), r := r], hw)
  // (the first pass leaving: no step ending so)
  have c1: ui.U(t, pair(m0, empty), r) -> !is_ok(r) -> false proof
    assume hu nr
    have nb: !(!!(fst(pair(m0, empty)).rip = t) && r = exc(pair(fst(pair(m0, empty)), empty), pair("brk", empty))) by rsimp(hnt)
    have bd := (bind_rel(x86_64_linux.step, fst(pair(m0, empty)), x5 x6. r = ok(pair(x5, empty), empty), x5 x6. r = exc(pair(x5, empty), pair("raise", x6)), x5. r = diverge(x5)) by taut(hu, nb))
    obtain o, _ oc from expand(bd, bind_rel)
    have k1: (ex s1 v. o = ok(s1, v) && r = ok(pair(s1, empty), empty)) -> false proof
      assume h1
      obtain s1 v, _ er from h1
      have io: is_ok(r) by defs(ex_intro({pair(s1, empty)}, {empty}, er), is_ok)
      show by taut(io, nr)
    qed
    have k2: (ex s1 x. o = exc(s1, x) && r = exc(pair(s1, empty), pair("raise", x))) -> false proof
      assume h2
      obtain s1 x, _ er from h2
      show := rsimp(rewrite(er, hm))
    qed
    have k3: (ex d. o = diverge(d) && r = diverge(d)) -> false proof
      assume h3
      obtain d, _ er from h3
      show := rsimp(rewrite(er, hm))
    qed
    show by taut(oc, k1, k2, k3)
  qed
  have c2: (ex l1. ui.U(t, pair(m0, empty), ok(l1, empty)) && (ex r1. while_rel(l1, l. true, l o. ui.U(t, l, o), l. fn_update(empty, "os.events", fst(l).os.events), r1) &&
      fst(r1) = fst(r) && (!(fst(r) = 2) -> r1 = r))) ->
      ex m1 v. runs(x86_64_linux.step(), m0, ok(m1, v)) && ui.UR(t, m1, m) proof
    assume h
    obtain l1, hu ex1 from h
    obtain r1, w1 _ e1 from ex1
    have er: r1 = r := mp(e1, nd)
    have nb: !(!!(fst(pair(m0, empty)).rip = t) && ok(l1, empty) = exc(pair(fst(pair(m0, empty)), empty), pair("brk", empty))) by rsimp()
    have bd := (bind_rel(x86_64_linux.step, fst(pair(m0, empty)), x5 x6. ok(l1, empty) = ok(pair(x5, empty), empty), x5 x6. ok(l1, empty) = exc(pair(x5, empty), pair("raise", x6)), x5. ok(l1, empty) = diverge(x5)) by taut(hu, nb))
    obtain o, ho oc from expand(bd, bind_rel)
    have k1: (ex s1 v. o = ok(s1, v) && ok(l1, empty) = ok(pair(s1, empty), empty)) -> ex m1 v. runs(x86_64_linux.step(), m0, ok(m1, v)) && ui.UR(t, m1, m) proof
      assume h1
      obtain s1 v, eo el from h1
      have l1e _ := apply(ui.ok_inj, el)
      have fp: fst(pair(m0, empty)) = m0 by rsimp()
      have rs: runs(x86_64_linux.step(), m0, ok(s1, v)) := rewrite(fp, rewrite(eo, ho))
      have w2 := rewrite(l1e, rewrite(er, w1))
      have g: ex x0. while_rel(pair(s1, empty), l. true, l o. ui.U(t, l, o), l. fn_update(empty, "os.events", fst(l).os.events), x0) &&
          (((fst(x0) = 0 || (fst(x0) = 1 && fst(out_value(x0)) = "brk")) && m = fst(out_state(x0))) ||
           ((fst(x0) = 1 && fst(out_value(x0)) = "ret") && (m = fst(out_state(x0)) && empty = snd(out_value(x0))))) by ex_intro({r}, taut(w2, hm))
      have ru: ui.UR(t, s1, m) by defs(g, ui.UR)
      show by ex_intro({s1}, {v}, taut(rs, ru))
    qed
    have k2: (ex s1 x. o = exc(s1, x) && ok(l1, empty) = exc(pair(s1, empty), pair("raise", x))) -> false proof
      assume h2
      obtain s1 x, _ el from h2
      show := rsimp(el)
    qed
    have k3: (ex d. o = diverge(d) && ok(l1, empty) = diverge(d)) -> false proof
      assume h3
      obtain d, _ el from h3
      show := rsimp(el)
    qed
    show by taut(oc, k1, k2, k3)
  qed
  show by taut(u, c1, c2)
qed

// ----------------------------------------------------------------------
//  The program's file: its numbers read from its bytes

// (a little-endian number of the file's bytes: of its literal's)
def ui.le_b(B, off, n) := int_sum(0, n, x0. int_mul(bytes_at(B, int_add(off, x0)), int_pow(256, x0)))

theorem ui.le_file: all F B off n. F = bytes_seq(B) -> off in omega -> n in omega -> bytes_len(B) in omega -> int_le(int_add(off, n), bytes_len(B)) ->
  x86_64_linux.le_at(F, off, n) = ui.le_b(B, off, n)
proof
  fix F B off n
  assume e ho hn hb hl
  have pw: all i. i in omega -> int_le(0, i) -> int_lt(i, n) -> int_mul(F[int_add(off, i)], int_pow(256, i)) = int_mul(bytes_at(B, int_add(off, i)), int_pow(256, i)) proof
    fix i
    assume hi _ hil
    have m := mp(nat_lt_mem[k := int_add(off, i), n := bytes_len(B)], arith(ho, hi), hb, arith(hil, hl, ho, hi))
    have a := mp(app_fn_build[d := bytes_len(B), v := x. bytes_at(B, x), a := int_add(off, i)], m)
    have ab: F[int_add(off, i)] = bytes_at(B, int_add(off, i)) := rewrite(sym(e), (bytes_seq(B)[int_add(off, i)] = bytes_at(B, int_add(off, i)) by defs(a, bytes_seq)))
    show by rsimp(ab)
  qed
  have s := apply(int_sum_ext[a := 0, b := n, f := i. int_mul(F[int_add(off, i)], int_pow(256, i)), g := i. int_mul(bytes_at(B, int_add(off, i)), int_pow(256, i))], eval(), hn, pw)
  show by defs(s, x86_64_linux.le_at, ui.le_b)
qed

// (... its value, by evaluation)
theorem ui.le_val: all F B off n v. F = bytes_seq(B) -> off in omega -> n in omega -> bytes_len(B) in omega -> int_le(int_add(off, n), bytes_len(B)) ->
  ui.le_b(B, off, n) = v -> x86_64_linux.le_at(F, off, n) = v
proof
  fix F B off n v
  assume e ho hn hb hl hv
  show := trans(apply(ui.le_file, e, ho, hn, hb, hl), hv)
qed

// (program header i: its type and its segment, the values read)
theorem ui.seg_val: all F B i ty fl of va fs ms. F = bytes_seq(B) -> i in omega -> bytes_len(B) in omega -> int_le(int_add(int_add(64, int_mul(56, i)), 48), bytes_len(B)) ->
  ui.le_b(B, 32, 8) = 64 -> ui.le_b(B, int_add(64, int_mul(56, i)), 4) = ty -> ui.le_b(B, int_add(int_add(64, int_mul(56, i)), 4), 4) = fl ->
  ui.le_b(B, int_add(int_add(64, int_mul(56, i)), 8), 8) = of -> ui.le_b(B, int_add(int_add(64, int_mul(56, i)), 16), 8) = va ->
  ui.le_b(B, int_add(int_add(64, int_mul(56, i)), 32), 8) = fs -> ui.le_b(B, int_add(int_add(64, int_mul(56, i)), 40), 8) = ms ->
  type: x86_64_linux.le_at(F, x86_64_linux.ph(F, i), 4) = ty && flags: x86_64_linux.segment(F, i).flags = fl && offset: x86_64_linux.segment(F, i).offset = of &&
  vaddr: x86_64_linux.segment(F, i).vaddr = va && filesz: x86_64_linux.segment(F, i).filesz = fs && memsz: x86_64_linux.segment(F, i).memsz = ms
proof
  fix F B i ty fl of va fs ms
  assume e hi hb hl h0 h1 h2 h3 h4 h5 h6
  let P := int_add(64, int_mul(56, i))
  have po := apply(ui.le_val[F := F, B := B, off := 32, n := 8, v := 64], e, eval(), eval(), hb, arith(hl, hi), h0)
  have pp: x86_64_linux.ph(F, i) = P by defs(rsimp(po), x86_64_linux.ph, x86_64_linux.phoff)
  have q1 := apply(ui.le_val[F := F, B := B, off := P, n := 4, v := ty], e, arith(hi), eval(), hb, arith(hl, hi), h1)
  have q2 := apply(ui.le_val[F := F, B := B, off := int_add(P, 4), n := 4, v := fl], e, arith(hi), eval(), hb, arith(hl, hi), h2)
  have q3 := apply(ui.le_val[F := F, B := B, off := int_add(P, 8), n := 8, v := of], e, arith(hi), eval(), hb, arith(hl, hi), h3)
  have q4 := apply(ui.le_val[F := F, B := B, off := int_add(P, 16), n := 8, v := va], e, arith(hi), eval(), hb, arith(hl, hi), h4)
  have q5 := apply(ui.le_val[F := F, B := B, off := int_add(P, 32), n := 8, v := fs], e, arith(hi), eval(), hb, arith(hl, hi), h5)
  have q6 := apply(ui.le_val[F := F, B := B, off := int_add(P, 40), n := 8, v := ms], e, arith(hi), eval(), hb, arith(hl, hi), h6)
  have k1: x86_64_linux.le_at(F, x86_64_linux.ph(F, i), 4) = ty := rewrite(sym(pp), q1)
  have k2: x86_64_linux.segment(F, i).flags = fl by defs(rsimp(pp, q2), x86_64_linux.segment)
  have k3: x86_64_linux.segment(F, i).offset = of by defs(rsimp(pp, q3), x86_64_linux.segment)
  have k4: x86_64_linux.segment(F, i).vaddr = va by defs(rsimp(pp, q4), x86_64_linux.segment)
  have k5: x86_64_linux.segment(F, i).filesz = fs by defs(rsimp(pp, q5), x86_64_linux.segment)
  have k6: x86_64_linux.segment(F, i).memsz = ms by defs(rsimp(pp, q6), x86_64_linux.segment)
  show by taut(k1, k2, k3, k4, k5, k6)
qed

// program header i of F: its type, its segment
def ui.segis(F, i, ty, fl, of, va, fs, ms) := x86_64_linux.le_at(F, x86_64_linux.ph(F, i), 4) = ty && x86_64_linux.segment(F, i).flags = fl &&
  x86_64_linux.segment(F, i).offset = of && x86_64_linux.segment(F, i).vaddr = va && x86_64_linux.segment(F, i).filesz = fs && x86_64_linux.segment(F, i).memsz = ms

// The program's headers (readelf -l): its 4 loads -- the first page, the
// text, the read-only data, the data and .bss -- and 4 others
theorem ui.elf: phnum: x86_64_linux.phnum(musl_malloc.file) = 8 &&
  s0: ui.segis(musl_malloc.file, 0, 1, 4, 0, 4194304, 512, 512) && s1: ui.segis(musl_malloc.file, 1, 1, 5, 4096, 4198400, 18271, 18271) &&
  s2: ui.segis(musl_malloc.file, 2, 1, 4, 24576, 4218880, 304, 304) && s3: ui.segis(musl_malloc.file, 3, 1, 6, 28616, 4227016, 72, 1680) &&
  s4: ui.segis(musl_malloc.file, 4, 4, 4, 24832, 4219136, 48, 48) && s5: ui.segis(musl_malloc.file, 5, 1685382483, 4, 24832, 4219136, 48, 48) &&
  s6: ui.segis(musl_malloc.file, 6, 1685382481, 6, 0, 0, 0, 0) && s7: ui.segis(musl_malloc.file, 7, 1685382482, 4, 28616, 4227016, 56, 56)
proof
  let F := musl_malloc.file
  have pn := apply(ui.le_val[F := F, off := 56, n := 2, v := 8], unfold(musl_malloc.file), eval(), eval(), eval(),eval(), eval())
  have pp: x86_64_linux.phnum(F) = 8 by defs(pn, x86_64_linux.phnum)
  have k0 := apply(ui.seg_val[F := F, i := 0, ty := 1, fl := 4, of := 0, va := 4194304, fs := 512, ms := 512], unfold(musl_malloc.file), eval(), eval(), eval(),
    eval(), eval(), eval(), eval(), eval(), eval(), eval())
  have k1 := apply(ui.seg_val[F := F, i := 1, ty := 1, fl := 5, of := 4096, va := 4198400, fs := 18271, ms := 18271], unfold(musl_malloc.file), eval(), eval(), eval(),
    eval(), eval(), eval(), eval(), eval(), eval(), eval())
  have k2 := apply(ui.seg_val[F := F, i := 2, ty := 1, fl := 4, of := 24576, va := 4218880, fs := 304, ms := 304], unfold(musl_malloc.file), eval(), eval(), eval(),
    eval(), eval(), eval(), eval(), eval(), eval(), eval())
  have k3 := apply(ui.seg_val[F := F, i := 3, ty := 1, fl := 6, of := 28616, va := 4227016, fs := 72, ms := 1680], unfold(musl_malloc.file), eval(), eval(), eval(),
    eval(), eval(), eval(), eval(), eval(), eval(), eval())
  have k4 := apply(ui.seg_val[F := F, i := 4, ty := 4, fl := 4, of := 24832, va := 4219136, fs := 48, ms := 48], unfold(musl_malloc.file), eval(), eval(), eval(),
    eval(), eval(), eval(), eval(), eval(), eval(), eval())
  have k5 := apply(ui.seg_val[F := F, i := 5, ty := 1685382483, fl := 4, of := 24832, va := 4219136, fs := 48, ms := 48], unfold(musl_malloc.file), eval(), eval(), eval(),
    eval(), eval(), eval(), eval(), eval(), eval(), eval())
  have k6 := apply(ui.seg_val[F := F, i := 6, ty := 1685382481, fl := 6, of := 0, va := 0, fs := 0, ms := 0], unfold(musl_malloc.file), eval(), eval(), eval(),
    eval(), eval(), eval(), eval(), eval(), eval(), eval())
  have k7 := apply(ui.seg_val[F := F, i := 7, ty := 1685382482, fl := 4, of := 28616, va := 4227016, fs := 56, ms := 56], unfold(musl_malloc.file), eval(), eval(), eval(),
    eval(), eval(), eval(), eval(), eval(), eval(), eval())
  have g0: ui.segis(F, 0, 1, 4, 0, 4194304, 512, 512) by defs(k0, ui.segis)
  have g1: ui.segis(F, 1, 1, 5, 4096, 4198400, 18271, 18271) by defs(k1, ui.segis)
  have g2: ui.segis(F, 2, 1, 4, 24576, 4218880, 304, 304) by defs(k2, ui.segis)
  have g3: ui.segis(F, 3, 1, 6, 28616, 4227016, 72, 1680) by defs(k3, ui.segis)
  have g4: ui.segis(F, 4, 4, 4, 24832, 4219136, 48, 48) by defs(k4, ui.segis)
  have g5: ui.segis(F, 5, 1685382483, 4, 24832, 4219136, 48, 48) by defs(k5, ui.segis)
  have g6: ui.segis(F, 6, 1685382481, 6, 0, 0, 0, 0) by defs(k6, ui.segis)
  have g7: ui.segis(F, 7, 1685382482, 4, 28616, 4227016, 56, 56) by defs(k7, ui.segis)
  show by taut(pp, g0, g1, g2, g3, g4, g5, g6, g7)
qed

// ----------------------------------------------------------------------
//  The text as exec loads it

// (no load after the text's on its pages: the read-only data starts at
// page 1030)
theorem ui.later_none: all j p. j in omega -> int_lt(1, j) -> x86_64_linux.is_load(musl_malloc.file, j) -> int_le(p, 1029) ->
  !x86_64_linux.seg_page(x86_64_linux.segment(musl_malloc.file, j), p)
proof
  fix j p
  assume hj h1 hl hp
  let F := musl_malloc.file
  have {pn = phnum, g2 = s2, g3 = s3, g4 = s4, g5 = s5, g6 = s6, g7 = s7} := ui.elf
  have jl ty := expand(hl, x86_64_linux.is_load)
  have pl: x86_64_linux.PT_LOAD = 1 by defs(eval(), x86_64_linux.PT_LOAD)
  have cs: j = 2 || j = 3 || j = 4 || j = 5 || j = 6 || j = 7 by arith(hj, h1, jl, pn)
  have _ _ _ v2 _ m2 := expand(g2, ui.segis)
  have _ _ _ v3 _ m3 := expand(g3, ui.segis)
  have t4 _ _ _ _ _ := expand(g4, ui.segis)
  have t5 _ _ _ _ _ := expand(g5, ui.segis)
  have t6 _ _ _ _ _ := expand(g6, ui.segis)
  have t7 _ _ _ _ _ := expand(g7, ui.segis)
  have c2: j = 2 -> !x86_64_linux.seg_page(x86_64_linux.segment(F, j), p) proof
    assume e
    have n: !x86_64_linux.seg_page(x86_64_linux.segment(F, 2), p) by defs(arith(v2, hp), x86_64_linux.seg_page, x86_64_linux.PAGE)
    show := rewrite(sym(e), n)
  qed
  have c3: j = 3 -> !x86_64_linux.seg_page(x86_64_linux.segment(F, j), p) proof
    assume e
    have n: !x86_64_linux.seg_page(x86_64_linux.segment(F, 3), p) by defs(arith(v3, hp), x86_64_linux.seg_page, x86_64_linux.PAGE)
    show := rewrite(sym(e), n)
  qed
  have c4: !(j = 4) proof
    assume e
    show by arith(t4, rewrite(e, ty), pl)
  qed
  have c5: !(j = 5) proof
    assume e
    show by arith(t5, rewrite(e, ty), pl)
  qed
  have c6: !(j = 6) proof
    assume e
    show by arith(t6, rewrite(e, ty), pl)
  qed
  have c7: !(j = 7) proof
    assume e
    show by arith(t7, rewrite(e, ty), pl)
  qed
  show by taut(cs, c2, c3, c4, c5, c6, c7)
qed

// (the text's pages: 1025 .. 1029, the text segment the last on them)
theorem ui.text_last: all p. p in omega -> int_le(1025, p) -> int_le(p, 1029) -> x86_64_linux.last_on_page(musl_malloc.file, 1, p)
proof
  fix p
  assume hpo h1 h2
  let F := musl_malloc.file
  have {pn = phnum, g1 = s1} := ui.elf
  have t1 _ _ v1 _ m1 := expand(g1, ui.segis)
  have pl: x86_64_linux.PT_LOAD = 1 by defs(eval(), x86_64_linux.PT_LOAD)
  have il: x86_64_linux.is_load(F, 1) by defs(taut((int_lt(1, x86_64_linux.phnum(F)) by arith(pn)), trans(t1, sym(pl))), x86_64_linux.is_load)
  have sp: x86_64_linux.seg_page(x86_64_linux.segment(F, 1), p) by defs(arith(v1, m1, h1, h2), x86_64_linux.seg_page, x86_64_linux.PAGE)
  have nl: all x0. x0 in omega -> x86_64_linux.is_load(F, x0) && int_lt(1, x0) -> !x86_64_linux.seg_page(x86_64_linux.segment(F, x0), p) proof
    fix j
    assume hj hjl
    have l1 l2 := hjl
    show := apply(ui.later_none[j := j, p := p], hj, l2, l1, h2)
  qed
  show by defs(taut(il, sp, nl), x86_64_linux.last_on_page)
qed

theorem ui.load1: x86_64_linux.is_load(musl_malloc.file, 1)
proof
  have {pn = phnum, g1 = s1} := ui.elf
  have t1 _ _ _ _ _ := expand(g1, ui.segis)
  have pl: x86_64_linux.PT_LOAD = 1 by defs(eval(), x86_64_linux.PT_LOAD)
  show by defs(taut((int_lt(1, x86_64_linux.phnum(musl_malloc.file)) by arith(pn)), trans(t1, sym(pl))), x86_64_linux.is_load)
qed

// (a slice of the file at 4096: the text's bytes, compared by evaluation)
theorem ui.code_bytes: all F B T C n. F = bytes_seq(B) -> T = bytes_seq(C) -> bytes_len(C) = n -> bytes_len(B) in omega -> n in omega ->
  int_le(int_add(4096, n), bytes_len(B)) -> (all i. i in bytes_len(C) -> bytes_at(B, int_add(4096, i)) = bytes_at(C, i)) ->
  len: seq_len(T) = n && at: (all i. i in omega -> int_lt(i, n) -> F[int_add(4096, i)] = T[i])
proof
  fix F B T C n
  assume ef et en hb hc0 hl0 hs
  have hc: bytes_len(C) in omega := rewrite(sym(en), hc0)
  have hl: int_le(int_add(4096, bytes_len(C)), bytes_len(B)) := rewrite(sym(en), hl0)
  have l: seq_len(T) = n := trans(rewrite(sym(et), all_elim(tr.bytes_seq_len, {C})), en)
  have a: all i. i in omega -> int_lt(i, n) -> F[int_add(4096, i)] = T[i] proof
    fix i
    assume hi hil0
    have hil: int_lt(i, bytes_len(C)) := rewrite(sym(en), hil0)
    have mc := mp(nat_lt_mem[k := i, n := bytes_len(C)], hi, hc, hil)
    have mb := mp(nat_lt_mem[k := int_add(4096, i), n := bytes_len(B)], arith(hi), hb, arith(hil, hl, hi))
    have fb: F[int_add(4096, i)] = bytes_at(B, int_add(4096, i)) := rewrite(sym(ef),
      (bytes_seq(B)[int_add(4096, i)] = bytes_at(B, int_add(4096, i)) by defs(mp(app_fn_build[d := bytes_len(B), v := x. bytes_at(B, x), a := int_add(4096, i)], mb), bytes_seq)))
    have tc: T[i] = bytes_at(C, i) := rewrite(sym(et), (bytes_seq(C)[i] = bytes_at(C, i) by defs(mp(app_fn_build[d := bytes_len(C), v := x. bytes_at(C, x), a := i], mc), bytes_seq)))
    show := trans(trans(fb, mp(all_elim(hs, {i}), mc)), sym(tc))
  qed
  show by taut(l, a)
qed

theorem ui.text_bytes: len: seq_len(text.code) = 18271 &&
  at: (all i. i in omega -> int_lt(i, 18271) -> musl_malloc.file[int_add(4096, i)] = text.code[i])
proof
  show := apply(ui.code_bytes[F := musl_malloc.file, T := text.code, n := 18271], unfold(musl_malloc.file), unfold(text.code), eval(), eval(), eval(), eval(), eval())
qed

theorem ui.snd_some: all x. snd(some(x)) = x
proof
  fix x
  show by defs(rsimp(), some, tag)
qed

theorem ui.some_nn: all x. !(some(x) = none)
proof
  fix x
  assume e
  have k _ := apply(pair_inj[a := 1, b := x, c := 0, d := empty], (pair(1, x) = pair(0, empty) by defs(e, some, none, tag)))
  show by arith(k)
qed

// The text loaded: at exec, its pages read and execute only, not the
// stack's, its bytes the program's
theorem ui.text_code: all argv envp m0. x86_64_linux.exec_state(musl_malloc.file, argv, envp, m0) -> abi.code_at(m0.vm, 4198400, text.code)
proof
  fix argv envp m0
  assume he
  let F := musl_malloc.file
  have il: x86_64_linux.image_loaded(F, m0.vm) by taut(expand(he, x86_64_linux.exec_state))
  have ip ib := expand(il, x86_64_linux.image_loaded)
  have {tl = len, ta = at} := ui.text_bytes
  have {g1 = s1} := ui.elf
  have _ f1 o1 v1 z1 _ := expand(g1, ui.segis)
  have sb := mp(all_elim(ib, {1}), eval(), ui.load1)
  have sb1 _ := expand(sb, x86_64_linux.segment_bytes)
  unfold abi.code_at
  fix i
  assume hi hil0
  have hil: int_lt(i, 18271) := rewrite(tl, hil0)
  let a := int_add(4198400, i)
  have ab: a in bits(64) by arith(hi, hil)
  have be := apply(nf.boi_in[n := 64, x := a], eval(), ab)
  let p := int_div(a, 4096)
  have po: p in omega by arith(hi)
  have p1: int_le(1025, p) by arith(hi)
  have p2: int_le(p, 1029) by arith(hi, hil)
  have pg: x86_64_linux.page_of(bits_of_int(64, a)) = p by defs(rsimp(be), x86_64_linux.page_of, x86_64_linux.PAGE)
  have pv := mp(all_elim(ip, {1}, {p}), conj((1 in omega by eval()), po), apply(ui.text_last[p := p], po, p1, p2))
  have pr: x86_64_linux.seg_prot(x86_64_linux.segment(F, 1)) = fn_update(fn_update(fn_update(empty, "r", true), "w", false), "x", true)
    by defs(rsimp(f1, (bit(5, 2) by eval()), (!bit(5, 1) by eval()), (bit(5, 0) by eval())), x86_64_linux.seg_prot)
  have pt: int_lt(p, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) by arith(p2)
  have mp1: x86_64_linux.mapped(m0.vm, p) by defs(rsimp(pv, pt, ui.some_nn[x := fn_update(fn_update(empty, "prot", x86_64_linux.seg_prot(x86_64_linux.segment(F, 1))), "kind", 0)]), x86_64_linux.mapped)
  have pga: x86_64_linux.page_of(a) = p by defs(rsimp(), x86_64_linux.page_of, x86_64_linux.PAGE)
  let PG := fn_update(fn_update(empty, "prot", x86_64_linux.seg_prot(x86_64_linux.segment(F, 1))), "kind", 0)
  have sn: snd(m0.vm.pages[p]) = PG := rewrite(sym(pv), ui.snd_some[x := PG])
  have k1: x86_64_linux.fetchable(m0.vm, bits_of_int(64, a)) by defs(rsimp(be, pga, mp1, sn, pr), x86_64_linux.fetchable, x86_64_linux.hw_allows)
  have k2: !x86_64_linux.can_access(m0.vm, bits_of_int(64, a), 1) by defs(rsimp(be, pga, sn, pr), x86_64_linux.can_access, x86_64_linux.hw_allows)
  have k3: !abi.stack_page(m0.vm, x86_64_linux.page_of(bits_of_int(64, a))) by defs(rsimp(be, pga, sn), abi.stack_page)
  have bt := mp(all_elim(sb1, {a}), arith(hi), conj((int_le(x86_64_linux.segment(F, 1).vaddr, a) by arith(v1, hi)),
    (int_lt(a, int_add(x86_64_linux.segment(F, 1).vaddr, x86_64_linux.segment(F, 1).filesz)) by arith(v1, z1, hil))))
  have off: int_add(x86_64_linux.segment(F, 1).offset, int_sub(a, x86_64_linux.segment(F, 1).vaddr)) = int_add(4096, i) by arith(o1, v1, hi)
  have k4: m0.vm.bytes[bits_of_int(64, a)] = text.code[i] := trans(rewrite(off, bt), mp(all_elim(ta, {i}), hi, hil))
  show by taut(k1, k2, k3, k4)
qed

// ----------------------------------------------------------------------
//  The stack at exec

// (a function's value outside its domain: empty)
theorem ui.app_out: all f a b k. f in powerset(cart(a, b)) -> !(k in a) -> f[k] = empty
proof
  fix f a b k
  assume hf hk
  have ss: subset(f, cart(a, b)) by taut(powerset_def[s := cart(a, b), a := f], hf)
  have du: f[k] = ite(ex y. pair(k, y) in f, choose(y. pair(k, y) in f), empty)
    by defs(refl({ite(ex y. pair(k, y) in f, choose(y. pair(k, y) in f), empty)}), app)
  have ne: !(ex y. pair(k, y) in f) proof
    assume e
    obtain y, hy from e
    have cc := mp(subset_elim[a := f, b := cart(a, b), z := pair(k, y)], ss, hy)
    obtain x, hx from mp(cart_elim[a := a, b := b, z := pair(k, y)], cc)
    obtain z, hz from hx
    have xa _ ez := hz
    have kx _ := apply(pair_inj[a := k, b := y, c := x, d := z], ez)
    show by taut(hk, rewrite(sym(kx), xa))
  qed
  show := trans(du, mp(ite_f[c := ex y. pair(k, y) in f, a := choose(y. pair(k, y) in f), b := empty], ne))
qed

// The stack at exec: the ABI's reserve -- its pages [lo, top) the stack's,
// one kind, below its top; nothing else mapped near its growth room
theorem ui.exec_reserve: all vm lo top. vm in x86_64_linux.Vm -> lo in omega -> top in omega -> x86_64_linux.stack_pages(vm, lo, top) -> abi.stack_reserve(vm)
proof
  fix vm lo top
  assume hv hlo htop hs
  have s1 s2 s3 s4 s5 s6 s7 s8 := expand(hs, x86_64_linux.stack_pages)
  let PR := fn_update(fn_update(empty, "prot", fn_update(fn_update(fn_update(empty, "r", true), "w", true), "x", false)), "kind", 2)
  let SP := some(PR)
  have fl: x86_64_linux.stack_floor(vm) = int_sub(vm.stack_top, vm.stack_limit) by defs(refl({int_sub(vm.stack_top, vm.stack_limit)}), x86_64_linux.stack_floor)
  have pk: snd(SP).kind = 2 by rsimp(ui.snd_some)
  // (a stack page: one of [lo, top))
  have sk: all p. p in omega -> abi.stack_page(vm, p) -> int_le(lo, p) && int_lt(p, top) proof
    fix p
    assume hp hsp
    have m k := expand(hsp, abi.stack_page)
    have n: !((int_lt(p, lo) || int_le(top, p)) && x86_64_linux.mapped(vm, p)) proof
      assume h
      show by taut(k, mp(all_elim(s6, {p}), hp, h))
    qed
    show by arith(n, m, hp, hlo, htop)
  qed
  have r2: int_mod(vm.stack_top, x86_64_linux.PAGE) = 0 by arith(s3, htop)
  have r3: all p. p in omega -> abi.stack_page(vm, p) -> ((int_le(x86_64_linux.stack_floor(vm), int_mul(p, x86_64_linux.PAGE)) &&
      int_le(int_mul(int_add(p, 1), x86_64_linux.PAGE), vm.stack_top)) &&
      (all q. q in omega -> int_le(p, q) && int_le(int_mul(int_add(q, 1), x86_64_linux.PAGE), vm.stack_top) -> vm.pages[q] = vm.pages[p])) &&
      !(vm.pages[int_div(vm.stack_top, x86_64_linux.PAGE)] = vm.pages[p]) proof
    fix p
    assume hp hsp
    have l1 l2 := apply(sk, hp, hsp)
    have ep: vm.pages[p] = SP := mp(all_elim(s5, {p}), hp, conj(l1, l2))
    have a1: int_le(x86_64_linux.stack_floor(vm), int_mul(p, x86_64_linux.PAGE)) by arith(fl, s3, s4, l1)
    have a2: int_le(int_mul(int_add(p, 1), x86_64_linux.PAGE), vm.stack_top) by arith(s3, l2)
    have a3: all q. q in omega -> int_le(p, q) && int_le(int_mul(int_add(q, 1), x86_64_linux.PAGE), vm.stack_top) -> vm.pages[q] = vm.pages[p] proof
      fix q
      assume hq hql
      have q1 q2 := hql
      have eq := mp(all_elim(s5, {q}), hq, conj((int_le(lo, q) by arith(l1, q1)), (int_lt(q, top) by arith(s3, q2))))
      show := trans(eq, sym(ep))
    qed
    have tp: int_div(vm.stack_top, x86_64_linux.PAGE) = top by arith(s3, htop)
    have a4: !(vm.pages[top] = SP) proof
      assume et
      have c1: int_lt(top, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) -> false proof
        assume hlt
        have mt: x86_64_linux.mapped(vm, top) by defs(rsimp(hlt, et, ui.some_nn), x86_64_linux.mapped)
        have nk := mp(all_elim(s6, {top}), htop, conj((int_lt(top, lo) || int_le(top, top) by arith(htop)), mt))
        show by taut(nk, rewrite(sym(et), pk))
      qed
      have c2: top = int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE) -> false proof
        assume he
        have ps: vm.pages in fn_space(set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))), option(x86_64_linux.Page)) by taut(unsel(expand(hv, x86_64_linux.Vm)))
        have pc := unsel(expand(ps, fn_space))
        have nd: !(top in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)))) proof
          assume hin
          have _ lt := unsel(hin)
          show by arith(lt, he)
        qed
        have z := apply(ui.app_out[f := vm.pages, a := set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))), b := option(x86_64_linux.Page), k := top], taut(pc), nd)
        have e2: empty = pair(1, PR) by defs(trans(sym(z), et), some, tag)
        show by taut(all_elim(tr.pair_ne, {1}, {PR}), e2)
      qed
      show by taut(c1, c2, (int_lt(top, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) || top = int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE) by arith(s2)))
    qed
    show by taut(a1, a2, a3, rewrite(sym(tp), rewrite(sym(ep), a4)))
  qed
  have r4: all p. p in omega -> x86_64_linux.mapped(vm, p) && !abi.stack_page(vm, p) ->
      int_le(int_add(int_mul(int_add(p, 1), x86_64_linux.PAGE), x86_64_linux.STACK_GUARD_GAP), x86_64_linux.stack_floor(vm)) || int_le(vm.stack_top, int_mul(p, x86_64_linux.PAGE)) proof
    fix p
    assume hp hmn
    have hm hn := hmn
    have c1: int_le(lo, p) && int_lt(p, top) -> false proof
      assume hin
      have ep: vm.pages[p] = SP := mp(all_elim(s5, {p}), hp, hin)
      have st: abi.stack_page(vm, p) by defs(taut(hm, rewrite(sym(ep), pk)), abi.stack_page)
      show by taut(st, hn)
    qed
    have c2: int_lt(p, lo) -> int_le(int_add(int_mul(int_add(p, 1), x86_64_linux.PAGE), x86_64_linux.STACK_GUARD_GAP), x86_64_linux.stack_floor(vm)) proof
      assume hl
      show := mp(all_elim(s8, {p}), hp, conj(hl, hm))
    qed
    have c3: int_le(top, p) -> int_le(vm.stack_top, int_mul(p, x86_64_linux.PAGE)) proof
      assume ht
      show by arith(s3, ht)
    qed
    show by taut(c1, c2, c3, (int_lt(p, lo) || (int_le(lo, p) && int_lt(p, top)) || int_le(top, p) by arith(hp, hlo, htop)))
  qed
  show by defs(taut(s7, r2, r3, r4), abi.stack_reserve)
qed

// ----------------------------------------------------------------------
//  _start: xor rbp, rbp; mov rdi, rsp; lea rsi, [rip + ..]; and rsp, -16;
//  call _start_c

// (_start's code: in the text)
theorem ui.start_code: all vm. abi.code_at(vm, 4198400, text.code) -> abi.code_at(vm, 4198543, _start.code)
proof
  fix vm
  assume hc
  have vac: all x0. x0 in omega -> x0 in empty -> x86_64_linux.off_stack_space(vm, int_div(x0, x86_64_linux.PAGE), 1) proof
    fix x
    assume _ h
    show by taut(h, empty_mem[x := x])
  qed
  have l: abi.loaded(vm, 4198400, text.code, empty) by defs(taut(hc, vac), abi.loaded)
  have l2 := mp(all_elim(_start.in_text, {vm}, {empty}), l)
  show by taut(expand(l2, abi.loaded))
qed

// (a register written, rip and the flags set: a machine)
theorem ui.reg_m: all m r f g x. m in x86_64_linux.Machine -> m in univ(1) -> r in bits(64) -> x86i.flags_ok(m, f) -> g in x86_64_linux.Reg -> x in bits(64) ->
  fn_update(fn_update(fn_update(m, "rip", r), "flags", f), "gpr", fn_update(m.gpr, g, x)) in x86_64_linux.Machine &&
  fn_update(fn_update(fn_update(m, "rip", r), "flags", f), "gpr", fn_update(m.gpr, g, x)) in univ(1)
proof
  fix m r f g x
  assume mM mu hr hf hg hx
  have pt := apply(x86i.parts, mM)
  have f1 := expand(hf, x86i.flags_ok)
  have m2: fn_update(fn_update(fn_update(m, "rip", r), "flags", f), "gpr", fn_update(m.gpr, g, x)) in x86_64_linux.Machine
    by defs(simp(expand(mM, x86_64_linux.Machine), mu, hr, f1, hg, hx, pt), x86_64_linux.Machine)
  have m3: fn_update(fn_update(fn_update(m, "rip", r), "flags", f), "gpr", fn_update(m.gpr, g, x)) in univ(1) by simp(mu, hr, f1, hg, hx)
  show by taut(m2, m3)
qed

// (... rip and a register only)
theorem ui.reg_m0: all m r g x. m in x86_64_linux.Machine -> m in univ(1) -> r in bits(64) -> g in x86_64_linux.Reg -> x in bits(64) ->
  fn_update(fn_update(m, "rip", r), "gpr", fn_update(m.gpr, g, x)) in x86_64_linux.Machine &&
  fn_update(fn_update(m, "rip", r), "gpr", fn_update(m.gpr, g, x)) in univ(1)
proof
  fix m r g x
  assume mM mu hr hg hx
  have pt := apply(x86i.parts, mM)
  have m2: fn_update(fn_update(m, "rip", r), "gpr", fn_update(m.gpr, g, x)) in x86_64_linux.Machine
    by defs(simp(expand(mM, x86_64_linux.Machine), mu, hr, hg, hx, pt), x86_64_linux.Machine)
  have m3: fn_update(fn_update(m, "rip", r), "gpr", fn_update(m.gpr, g, x)) in univ(1) by simp(mu, hr, hg, hx)
  show by taut(m2, m3)
qed

// (_start's first 4 instructions, registers only, at m4 before the call)
def ui.s4(m0, m4) := m4 in x86_64_linux.Machine && m4 in univ(1) && m4.vm = m0.vm && m4.rip = 4198560 &&
  m4.gpr[4] = bits_and(64, m0.gpr[4], bits_sext(8, 64, 240)) && m4.gpr[7] = m0.gpr[4] && m4.flags.df = m0.flags.df &&
  m4.os = m0.os && m4.fs_base = m0.fs_base && m4.gs_base = m0.gs_base && m4.cpu = m0.cpu

theorem ui.start4: all m0 m. m0 in x86_64_linux.Machine -> m0 in univ(1) -> abi.code_at(m0.vm, 4198400, text.code) -> m0.rip = 4198543 ->
  ui.UR(4198873, m0, m) -> ex m4. ui.s4(m0, m4) && ui.UR(4198873, m4, m)
proof
  fix m0 m
  assume hM hU hc hr hur
  have sc := apply(ui.start_code[vm := m0.vm], hc)
  have g4 := apply(x86i.rsp_typed, hM)
  // xor rbp, rbp
  obtain m1 v1, hs1 hu1 from apply(ui.until_step[t := 4198873, m0 := m0, m := m], (!(m0.rip = 4198873) by rsimp(hr)), hur)
  have eb1 := mp(all_elim(_start.at_40108f, {m0}, {ok(m1, v1)}), hs1, sc, hr)
  obtain f1, hf1 he1 from mp(all_elim(x86i.xor64_rr, {m0}, {ok(m1, v1)}, {5}, {5}, {3}), hM, hU, eval(), eval(), eb1)
  let M1 := fn_update(fn_update(fn_update(m0, "rip", bits_add(64, m0.rip, 3)), "flags", f1), "gpr", fn_update(m0.gpr, 5, bits_xor(64, m0.gpr[5], m0.gpr[5])))
  have q1 _ := apply(ui.ok_inj, he1)
  have u1: ui.UR(4198873, M1, m) := rewrite(q1, hu1)
  have T1M T1U := apply(ui.reg_m[m := m0, r := bits_add(64, m0.rip, 3), f := f1, g := 5, x := bits_xor(64, m0.gpr[5], m0.gpr[5])], hM, hU,
    (bits_add(64, m0.rip, 3) in bits(64) by simp()), hf1, eval(), (bits_xor(64, m0.gpr[5], m0.gpr[5]) in bits(64) by simp()))
  have r1: M1.rip = 4198546 by rsimp(hr)
  have v1: M1.vm = m0.vm by rsimp()
  // mov rdi, rsp
  obtain m2 v2, hs2 hu2 from apply(ui.until_step[t := 4198873, m0 := M1, m := m], rewrite(sym(r1), (!(4198546 = 4198873) by eval())), u1)
  have eb2 := mp(all_elim(_start.at_401092, {M1}, {ok(m2, v2)}), hs2, rewrite(sym(v1), sc), r1)
  have he2 := mp(all_elim(x86i.mov64_rr, {M1}, {ok(m2, v2)}, {4}, {7}, {tag(0, 7)}, {tag(0, 4)}, {3}), T1M, T1U, eval(), eval(), eb2)
  let M2 := fn_update(fn_update(M1, "rip", bits_add(64, M1.rip, 3)), "gpr", fn_update(M1.gpr, 7, M1.gpr[4]))
  have q2 _ := apply(ui.ok_inj, he2)
  have u2: ui.UR(4198873, M2, m) := rewrite(q2, hu2)
  have g14: M1.gpr[4] = m0.gpr[4] by rsimp()
  have T2M T2U := apply(ui.reg_m0[m := M1, r := bits_add(64, M1.rip, 3), g := 7, x := M1.gpr[4]], T1M, T1U,
    (bits_add(64, M1.rip, 3) in bits(64) by simp()), eval(), rewrite(sym(g14), g4))
  have r2: M2.rip = 4198549 by rsimp(hr)
  have v2e: M2.vm = m0.vm by rsimp()
  // lea rsi, [rip + d]
  let MEM := fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(1, empty)), "index", none), "scale", 1), "disp", 18446744073705353060)
  obtain m3 v3, hs3 hu3 from apply(ui.until_step[t := 4198873, m0 := M2, m := m], rewrite(sym(r2), (!(4198549 = 4198873) by eval())), u2)
  have eb3 := mp(all_elim(_start.at_401095, {M2}, {ok(m3, v3)}), hs3, rewrite(sym(v2e), sc), r2)
  have he3 := mp(all_elim(x86i.lea_rip, {M2}, {ok(m3, v3)}, {6}, {18446744073705353060}, {tag(2, MEM)}, {tag(2, MEM)}, {tag(0, 6)}, {7}), T2M, T2U, eval(), eval(), eb3)
  let X3 := bits_add(64, int_add(bits_add(64, M2.rip, 7), 18446744073705353060), 0)
  let M3 := fn_update(fn_update(M2, "rip", bits_add(64, M2.rip, 7)), "gpr", fn_update(M2.gpr, 6, X3))
  have q3 _ := apply(ui.ok_inj, he3)
  have u3: ui.UR(4198873, M3, m) := rewrite(q3, hu3)
  have T3M T3U := apply(ui.reg_m0[m := M2, r := bits_add(64, M2.rip, 7), g := 6, x := X3], T2M, T2U,
    (bits_add(64, M2.rip, 7) in bits(64) by simp()), eval(), (X3 in bits(64) by simp()))
  have r3: M3.rip = 4198556 by rsimp(hr)
  have v3e: M3.vm = m0.vm by rsimp()
  // and rsp, -16
  obtain m4 v4, hs4 hu4 from apply(ui.until_step[t := 4198873, m0 := M3, m := m], rewrite(sym(r3), (!(4198556 = 4198873) by eval())), u3)
  have eb4 := mp(all_elim(_start.at_40109c, {M3}, {ok(m4, v4)}), hs4, rewrite(sym(v3e), sc), r3)
  obtain f4, hf4 he4 from mp(all_elim(x86i.and64_imm8, {M3}, {ok(m4, v4)}, {4}, {tag(0, 4)}, {240}, {4}), T3M, T3U, eval(), eval(), eb4)
  let M4 := fn_update(fn_update(fn_update(M3, "rip", bits_add(64, M3.rip, 4)), "flags", f4), "gpr", fn_update(M3.gpr, 4, bits_and(64, M3.gpr[4], bits_sext(8, 64, 240))))
  have q4 _ := apply(ui.ok_inj, he4)
  have u4: ui.UR(4198873, M4, m) := rewrite(q4, hu4)
  have g34: M3.gpr[4] = m0.gpr[4] by rsimp()
  have T4M T4U := apply(ui.reg_m[m := M3, r := bits_add(64, M3.rip, 4), f := f4, g := 4, x := bits_and(64, M3.gpr[4], bits_sext(8, 64, 240))], T3M, T3U,
    (bits_add(64, M3.rip, 4) in bits(64) by simp()), hf4, eval(), (bits_and(64, M3.gpr[4], bits_sext(8, 64, 240)) in bits(64) by simp()))
  have _ _ d1 := expand(hf1, x86i.flags_ok)
  have _ _ d4 := expand(hf4, x86i.flags_ok)
  have s4: ui.s4(m0, M4) by defs(taut(T4M, T4U, (M4.vm = m0.vm by rsimp()), (M4.rip = 4198560 by rsimp(hr)),
    (M4.gpr[4] = bits_and(64, m0.gpr[4], bits_sext(8, 64, 240)) by rsimp(g34)), (M4.gpr[7] = m0.gpr[4] by rsimp()),
    (M4.flags.df = m0.flags.df by rsimp(d4, d1)), (M4.os = m0.os by rsimp()), (M4.fs_base = m0.fs_base by rsimp()),
    (M4.gs_base = m0.gs_base by rsimp()), (M4.cpu = m0.cpu by rsimp())), ui.s4)
  show by ex_intro({M4}, taut(s4, u4))
qed

// (and rsp, -16 on an aligned rsp: rsp)
theorem ui.and16: all x. x in bits(64) -> int_mod(x, 16) = 0 -> bits_and(64, x, bits_sext(8, 64, 240)) = x
proof
  fix x
  assume hx hm
  have se: bits_sext(8, 64, 240) = bits_not(64, 15) by eval()
  have m2: bits_and(64, x, bits_not(64, 15)) = int_mul(int_div(x, 16), 16) by bitwise({64}, hx)
  show := trans(rewrite(sym(se), m2), (int_mul(int_div(x, 16), 16) = x by arith(hm, hx)))
qed

// (a touch: the memory changed only)
theorem ui.vm_only: all P m1. (m1 = P || (ex V. m1 = fn_update(P, "vm", V))) ->
  m1.rip = P.rip && m1.gpr = P.gpr && m1.os = P.os && m1.fs_base = P.fs_base && m1.gs_base = P.gs_base && m1.cpu = P.cpu && m1.flags = P.flags
proof
  fix P m1
  assume h
  have c1: m1 = P -> m1.rip = P.rip && m1.gpr = P.gpr && m1.os = P.os && m1.fs_base = P.fs_base && m1.gs_base = P.gs_base && m1.cpu = P.cpu && m1.flags = P.flags proof
    assume e
    show by rsimp(e)
  qed
  have c2: (ex V. m1 = fn_update(P, "vm", V)) -> m1.rip = P.rip && m1.gpr = P.gpr && m1.os = P.os && m1.fs_base = P.fs_base && m1.gs_base = P.gs_base && m1.cpu = P.cpu && m1.flags = P.flags proof
    assume e
    obtain V, ev from e
    show by rsimp(ev)
  qed
  show by taut(h, c1, c2)
qed

// (the call's state: the return address stored, rsp lowered, rip the
// callee's -- a machine)
theorem ui.call_m: all m1 a w r. m1 in x86_64_linux.Machine -> m1 in univ(1) -> a in bits(64) -> w in bits(64) -> r in bits(64) ->
  fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, a, 8, w))), "gpr", fn_update(m1.gpr, 4, a)), "rip", r) in x86_64_linux.Machine &&
  fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, a, 8, w))), "gpr", fn_update(m1.gpr, 4, a)), "rip", r) in univ(1)
proof
  fix m1 a w r
  assume mM mu ha hw hr
  have pt := apply(x86i.parts, mM)
  have _ _ _ pv := pt
  have bt: m1.vm.bytes in fn_space(bits(64), bits(8)) by taut(unsel(expand(pv, x86_64_linux.Vm)))
  have st := apply(x86.store_typed[b := m1.vm.bytes, a := a, n := 8, v := w], bt)
  have su := mp(fn_space_univ[u := 1, a := bits(64), b := bits(8), f := x86_64_linux.store_le(m1.vm.bytes, a, 8, w)], bits_univ[n := 64], bits_univ[n := 8], st)
  have vu: fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, a, 8, w)) in univ(1) by simp(mu, su)
  have vv := apply(tr.vm_bytes, pv, st, vu)
  have m2: fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, a, 8, w))), "gpr", fn_update(m1.gpr, 4, a)), "rip", r) in x86_64_linux.Machine
    by defs(simp(expand(mM, x86_64_linux.Machine), mu, vv, ha, hr, pt), x86_64_linux.Machine)
  have m3: fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, a, 8, w))), "gpr", fn_update(m1.gpr, 4, a)), "rip", r) in univ(1)
    by simp(mu, vu, ha, hr)
  show by taut(m2, m3)
qed

// at _start_c's entry, after the call: the return address pushed on
// exec's stack (grown if need be), rdi exec's rsp
def ui.s5(m0, s) := s in x86_64_linux.Machine && s in univ(1) && s.rip = 4198565 && s.gpr[4] = bits_sub(64, m0.gpr[4], 8) && s.gpr[7] = m0.gpr[4] &&
  s.flags.df = m0.flags.df && s.os = m0.os && s.fs_base = m0.fs_base && s.gs_base = m0.gs_base && s.cpu = m0.cpu &&
  (ex v1. x86.stk_ext(m0.vm, v1) && abi.vm_grows(m0.vm, v1) && x86.vm_fields(m0.vm, v1) &&
    (all j. j in omega -> int_lt(j, 8) -> x86_64_linux.can_access(v1, bits_add(64, bits_sub(64, m0.gpr[4], 8), bits_of_int(64, j)), 1)) &&
    s.vm = fn_update(v1, "bytes", x86_64_linux.store_le(v1.bytes, bits_sub(64, m0.gpr[4], 8), 8, 4198565)) && v1 in x86_64_linux.Vm)

theorem ui.start_call: all m0 m4 m. m0 in x86_64_linux.Machine -> ui.s4(m0, m4) -> int_mod(m0.gpr[4], 16) = 0 -> int_le(16, m0.gpr[4]) -> int_lt(m0.gpr[4], 140737488355328) ->
  abi.code_at(m0.vm, 4198400, text.code) -> ui.UR(4198873, m4, m) -> ex s. ui.s5(m0, s) && ui.UR(4198873, s, m)
proof
  fix m0 m4 m
  assume hM0 h4 hal hlo hhi hc hur
  have hM hU hv hr hsp hdi hdf hos hfs hgs hcpu := expand(h4, ui.s4)
  have g0 := apply(x86i.rsp_typed, hM0)
  have e4: m4.gpr[4] = m0.gpr[4] := trans(hsp, apply(ui.and16, g0, hal))
  have sc := rewrite(sym(hv), apply(ui.start_code[vm := m0.vm], hc))
  obtain m5 v5, hs5 hu5 from apply(ui.until_step[t := 4198873, m0 := m4, m := m], rewrite(sym(hr), (!(4198560 = 4198873) by eval())), hur)
  have eb := mp(all_elim(_start.at_4010a0, {m4}, {ok(m5, v5)}), hs5, sc, hr)
  have cl := mp(all_elim(x86i.call_rel32, {m4}, {ok(m5, v5)}, {0}, {5}), hM, hU, (0 in bits(32) by eval()),
    rewrite(sym(e4), (int_le(8, m0.gpr[4]) by arith(hlo))), rewrite(sym(e4), hhi), eb)
  let P := fn_update(m4, "rip", bits_add(64, m4.rip, bits_of_int(64, 5)))
  let A := bits_sub(64, m4.gpr[4], 8)
  have c2: (ex x e. runs(x86_64_linux.touch_range(A, 8, 1), P, exc(x, e)) && ok(m5, v5) = exc(x, e)) -> false proof
    assume h
    obtain x e, _ q from h
    show := rsimp(q)
  qed
  have c3: (ex t. runs(x86_64_linux.touch_range(A, 8, 1), P, diverge(t)) && ok(m5, v5) = diverge(t)) -> false proof
    assume h
    obtain t, _ q from h
    show := rsimp(q)
  qed
  obtain m1 e1, ht he from (ex m1 e1. runs(x86_64_linux.touch_range(A, 8, 1), P, ok(m1, e1)) &&
    ok(m5, v5) = ok(fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, A, 8, bits_add(64, m4.rip, bits_of_int(64, 5))))),
      "gpr", fn_update(m1.gpr, 4, A)), "rip", bits_add(64, m1.rip, bits_sext(32, 64, 0))), empty) by taut(cl, c2, c3))
  let S := fn_update(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, A, 8, bits_add(64, m4.rip, bits_of_int(64, 5))))),
      "gpr", fn_update(m1.gpr, 4, A)), "rip", bits_add(64, m1.rip, bits_sext(32, 64, 0)))
  have q5 _ := apply(ui.ok_inj, he)
  have u5: ui.UR(4198873, S, m) := rewrite(q5, hu5)
  // (the touch: m1 is P with its memory grown)
  have pt := apply(x86i.parts, hM)
  have pr: bits_add(64, m4.rip, bits_of_int(64, 5)) = 4198565 by rsimp(hr)
  have PM: P in x86_64_linux.Machine by defs(simp(expand(hM, x86_64_linux.Machine), hU, pt, pr), x86_64_linux.Machine)
  have PU: P in univ(1) by simp(hU, pr)
  have M1M M1U := apply(x86.touch_range_typed, PM, PU, ht)
  have _ vo := apply(x86.touch_range_vm, ht)
  have mr mg mos mfs mgs mcpu mfl := apply(ui.vm_only, vo)
  have sk := apply(x86.touch_range_stk, ht)
  have vg := apply(x86.touch_range_frame, (8 in omega by eval()), ht)
  have ac := apply(x86.touch_range_acc, ht)
  have pv: P.vm = m0.vm by rsimp(hv)
  have ab: A in bits(64) by simp()
  have SM SU := apply(ui.call_m[m1 := m1, a := A, w := bits_add(64, m4.rip, bits_of_int(64, 5)), r := bits_add(64, m1.rip, bits_sext(32, 64, 0))], M1M, M1U, ab,
    rewrite(sym(pr), (4198565 in bits(64) by eval())), (bits_add(64, m1.rip, bits_sext(32, 64, 0)) in bits(64) by simp()))
  have ae: A = bits_sub(64, m0.gpr[4], 8) by rsimp(e4)
  have k1: S.rip = 4198565 by rsimp(mr, hr, (bits_sext(32, 64, 0) = 0 by eval()))
  have k2: S.gpr[4] = bits_sub(64, m0.gpr[4], 8) by rsimp(ae)
  have k3: S.gpr[7] = m0.gpr[4] by rsimp(mg, hdi)
  have k4: S.flags.df = m0.flags.df by rsimp(mfl, hdf)
  have k5: S.os = m0.os by rsimp(mos, hos)
  have k6: S.fs_base = m0.fs_base by rsimp(mfs, hfs)
  have k7: S.gs_base = m0.gs_base by rsimp(mgs, hgs)
  have k8: S.cpu = m0.cpu by rsimp(mcpu, hcpu)
  have w1: x86.stk_ext(m0.vm, m1.vm) := rewrite(pv, sk)
  have w2: abi.vm_grows(m0.vm, m1.vm) := rewrite(pv, vg)
  have w3: all j. j in omega -> int_lt(j, 8) -> x86_64_linux.can_access(m1.vm, bits_add(64, bits_sub(64, m0.gpr[4], 8), bits_of_int(64, j)), 1) := rewrite(ae, ac)
  have w4: S.vm = fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, bits_sub(64, m0.gpr[4], 8), 8, 4198565)) by rsimp(ae, hr)
  have w5: x86.vm_fields(m0.vm, m1.vm) := rewrite(pv, apply(x86.touch_range_fields, ht))
  have ev: ex v1. x86.stk_ext(m0.vm, v1) && abi.vm_grows(m0.vm, v1) && x86.vm_fields(m0.vm, v1) &&
    (all j. j in omega -> int_lt(j, 8) -> x86_64_linux.can_access(v1, bits_add(64, bits_sub(64, m0.gpr[4], 8), bits_of_int(64, j)), 1)) &&
    S.vm = fn_update(v1, "bytes", x86_64_linux.store_le(v1.bytes, bits_sub(64, m0.gpr[4], 8), 8, 4198565)) && v1 in x86_64_linux.Vm
    by ex_intro({m1.vm}, taut(w1, w2, w5, w3, w4, apply(x86i.parts, M1M).4))
  have s5: ui.s5(m0, S) by defs(taut(SM, SU, k1, k2, k3, k4, k5, k6, k7, k8, ev), ui.s5)
  show by ex_intro({S}, taut(s5, u5))
qed

// ----------------------------------------------------------------------
//  The bridge's entry facts at _start_c

// (the bytes written: the pages' facts kept)
theorem ui.ca_bytes: all v B a k. x86_64_linux.can_access(v, a, k) -> x86_64_linux.can_access(fn_update(v, "bytes", B), a, k)
proof
  fix v B a k
  assume h
  show by defs(rsimp(expand(h, x86_64_linux.can_access, x86_64_linux.mapped)), x86_64_linux.can_access, x86_64_linux.mapped)
qed

theorem ui.sp_bytes: all v B p. abi.stack_page(v, p) -> abi.stack_page(fn_update(v, "bytes", B), p)
proof
  fix v B p
  assume h
  show by defs(rsimp(expand(h, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
qed

theorem ui.rsv_bytes: all v B. abi.stack_reserve(v) -> abi.stack_reserve(fn_update(v, "bytes", B))
proof
  fix v B
  assume h
  show by defs(rsimp(expand(h, abi.stack_reserve, abi.stack_page, x86_64_linux.mapped, x86_64_linux.stack_floor)),
    abi.stack_reserve, abi.stack_page, x86_64_linux.mapped, x86_64_linux.stack_floor)
qed

// (the push's page: exec's stack, or a page the stack grew by -- nothing
// else is mapped near the stack)
theorem ui.push_page: all vm v1 lo top a. vm in x86_64_linux.Vm -> lo in omega -> top in omega -> x86_64_linux.stack_pages(vm, lo, top) -> x86.stk_ext(vm, v1) ->
  a in omega -> int_le(int_mul(lo, x86_64_linux.PAGE), int_add(a, 8)) -> int_lt(a, int_mul(top, x86_64_linux.PAGE)) ->
  x86_64_linux.mapped(v1, int_div(a, x86_64_linux.PAGE)) -> abi.stack_page(v1, int_div(a, x86_64_linux.PAGE))
proof
  fix vm v1 lo top a
  assume hv hlo htop hs hx ha h1 h2 hm
  have s1 s2 s3 s4 s5 s6 s7 s8 := expand(hs, x86_64_linux.stack_pages)
  have x1 _ := expand(hx, x86.stk_ext)
  let p := int_div(a, x86_64_linux.PAGE)
  have po: p in omega by arith(ha)
  have c1: v1.pages[p] = vm.pages[p] -> abi.stack_page(v1, p) proof
    assume e
    have m1 m2 := expand(hm, x86_64_linux.mapped)
    have mv: x86_64_linux.mapped(vm, p) by defs(taut(m1, rewrite(e, m2)), x86_64_linux.mapped)
    have fl: x86_64_linux.stack_floor(vm) = int_sub(vm.stack_top, vm.stack_limit) by defs(refl({int_sub(vm.stack_top, vm.stack_limit)}), x86_64_linux.stack_floor)
    have nlo: !int_lt(p, lo) proof
      assume hl
      have g := mp(all_elim(s8, {p}), po, conj(hl, mv))
      show by arith(g, fl, s3, s4, h1, ha)
    qed
    have ep := mp(all_elim(s5, {p}), po, conj((int_le(lo, p) by arith(nlo, po, hlo)), (int_lt(p, top) by arith(h2, ha))))
    have q := rewrite(sym(ep), ui.snd_some[x := fn_update(fn_update(empty, "prot", fn_update(fn_update(fn_update(empty, "r", true), "w", true), "x", false)), "kind", 2)])
    have pk: snd(vm.pages[p]).kind = 2 by rsimp(q)
    show by defs(taut(hm, rewrite(sym(e), pk)), abi.stack_page)
  qed
  show by taut(mp(all_elim(x1, {p}), po), c1)
qed

// the world's memory at an entry: the machine's, its stack pages hidden
abbrev ui.wpages(vm) := fn_build(set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))), p. ite(abi.stack_page(vm, p), none, vm.pages[p]))
abbrev ui.wvm(vm) := fn_update(vm, "pages", ui.wpages(vm))

theorem ui.wvm_typed: all vm. vm in x86_64_linux.Vm -> vm in univ(1) -> ui.wvm(vm) in x86_64_linux.Vm && ui.wvm(vm) in univ(1)
proof
  fix vm
  assume h hu
  let D := set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)))
  have vp := apply(x86.vm_pages_typed, {vm}, h)
  have pv: all p. p in D -> ite(abi.stack_page(vm, p), none, vm.pages[p]) in option(x86_64_linux.Page) proof
    fix p
    assume hp
    have a := apply(x86.vm_page_at[vm := vm, q := p], h, hp)
    have n: none in option(x86_64_linux.Page) by defs(simp(), option)
    have c1: abi.stack_page(vm, p) -> ite(abi.stack_page(vm, p), none, vm.pages[p]) in option(x86_64_linux.Page) proof
      assume hs
      show := rewrite(sym(mp(ite_t[c := abi.stack_page(vm, p), a := none, b := vm.pages[p]], hs)), n)
    qed
    have c2: !abi.stack_page(vm, p) -> ite(abi.stack_page(vm, p), none, vm.pages[p]) in option(x86_64_linux.Page) proof
      assume hs
      show := rewrite(sym(mp(ite_f[c := abi.stack_page(vm, p), a := none, b := vm.pages[p]], hs)), a)
    qed
    show by taut(c1, c2)
  qed
  have ps := apply(fn_build_space[d := D, v := p. ite(abi.stack_page(vm, p), none, vm.pages[p]), b := option(x86_64_linux.Page)], pv)
  have pu := mp(fn_space_univ[u := 1, a := D, b := option(x86_64_linux.Page), f := ui.wpages(vm)], x86.pn_univ, x86.opt_page_univ, ps)
  have wu: ui.wvm(vm) in univ(1) by simp(hu, pu)
  let K := insert("pages", insert("bytes", insert("stack_top", insert("stack_limit", insert("brk_start", insert("brk", empty))))))
  have ht: is_fun(vm) && dom(vm) = K by simp(expand(h, x86_64_linux.Vm))
  have hf: is_fun(vm) by taut(ht)
  have dv: dom(vm) = K by taut(ht)
  have pd: "pages" in dom(vm) by simp(dv)
  have fuf := mp(fn_update_fun[f := vm, k := "pages", v := ui.wpages(vm)], hf)
  have fud := mp(mp(fn_update_dom[f := vm, k := "pages", v := ui.wpages(vm)], hf), pd)
  let W := ui.wvm(vm)
  have pv2: ((((((is_fun(W) && dom(W) = K) && W.pages in fn_space(D, option(x86_64_linux.Page))) && W.bytes in fn_space(bits(64), bits(8))) && W.stack_top in bits(64)) &&
    W.stack_limit in omega) && W.brk_start in bits(64)) && W.brk in bits(64) by simp(expand(h, x86_64_linux.Vm), ps, fuf, fud, dv)
  have r := mp(mp(mp(mp(rec_type_intro[u := 1, k := K, p := x0. ((((((is_fun(x0) && dom(x0) = K) && x0.pages in fn_space(D, option(x86_64_linux.Page))) &&
    x0.bytes in fn_space(bits(64), bits(8))) && x0.stack_top in bits(64)) && x0.stack_limit in omega) && x0.brk_start in bits(64)) && x0.brk in bits(64), r := W], wu), fuf), trans(fud, dv)), pv2)
  have wv: W in x86_64_linux.Vm by defs(r, x86_64_linux.Vm)
  show by taut(wv, wu)
qed

theorem ui.wvm_pages: all vm. abi.world_pages(vm, ui.wvm(vm))
proof
  fix vm
  unfold abi.world_pages
  fix p
  assume hp
  show by rsimp(mp(app_fn_build[d := set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))), v := q. ite(abi.stack_page(vm, q), none, vm.pages[q]), a := p], hp))
qed

// (a page of the view: the machine's, or none for a stack page)
theorem ui.wvm_at: all vm p. p in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) ->
  (abi.stack_page(vm, p) -> ui.wvm(vm).pages[p] = none) && (!abi.stack_page(vm, p) -> ui.wvm(vm).pages[p] = vm.pages[p])
proof
  fix vm p
  assume hp
  have a := mp(app_fn_build[d := set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))), v := q. ite(abi.stack_page(vm, q), none, vm.pages[q]), a := p], hp)
  have e: ui.wvm(vm).pages[p] = ite(abi.stack_page(vm, p), none, vm.pages[p]) by rsimp(a)
  have c1: abi.stack_page(vm, p) -> ui.wvm(vm).pages[p] = none proof
    assume hs
    show := trans(e, mp(ite_t[c := abi.stack_page(vm, p), a := none, b := vm.pages[p]], hs))
  qed
  have c2: !abi.stack_page(vm, p) -> ui.wvm(vm).pages[p] = vm.pages[p] proof
    assume hs
    show := trans(e, mp(ite_f[c := abi.stack_page(vm, p), a := none, b := vm.pages[p]], hs))
  qed
  show by taut(c1, c2)
qed

// the view at the entry s, with any callers' objects (all bytes the C
// world's: the startup mode)
theorem ui.wvm_vok: all s objs. tr.vok(false, s, objs, ui.wvm(s.vm))
proof
  fix s objs
  let V := s.vm
  let W := ui.wvm(s.vm)
  let OB := abi.wob(objs, abi.cball)
  let D := set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)))
  have k1: [top] tr.wmc(V, V, W, OB, s.fs_base, abi.sp(s)) by rsimp()
  have k2: [limit] tr.wmc(V, V, W, OB, s.fs_base, abi.sp(s)) by rsimp()
  have k3: [brk0] tr.wmc(V, V, W, OB, s.fs_base, abi.sp(s)) by rsimp()
  have k4: [brk] tr.wmc(V, V, W, OB, s.fs_base, abi.sp(s)) by rsimp()
  have k5: [bytes] tr.wmc(V, V, W, OB, s.fs_base, abi.sp(s)) proof
    fix x
    assume _ _
    show by rsimp()
  qed
  have k6: [frames] tr.wmc(V, V, W, OB, s.fs_base, abi.sp(s)) proof
    fix x
    assume _ _
    show := refl({V.bytes[x]})
  qed
  have k7: [hid] tr.wmc(V, V, W, OB, s.fs_base, abi.sp(s)) proof
    fix x
    assume _ _
    show by taut(refl({V.bytes[x]}), refl({V.pages[x86_64_linux.page_of(x)]}))
  qed
  have k8: [c_bytes] tr.wmc(V, V, W, OB, s.fs_base, abi.sp(s)) by rsimp()
  have k9: [pages] tr.wmc(V, V, W, OB, s.fs_base, abi.sp(s)) proof
    fix p
    assume hp
    have a1 a2 := apply(ui.wvm_at[vm := V, p := p], hp)
    have c1: abi.stack_page(V, p) -> V.pages[p] = W.pages[p] || (W.pages[p] = none && abi.stack_page(V, p)) proof
      assume hs
      show by taut(hs, mp(a1, hs))
    qed
    have c2: !abi.stack_page(V, p) -> V.pages[p] = W.pages[p] || (W.pages[p] = none && abi.stack_page(V, p)) proof
      assume hs
      show by taut(sym(mp(a2, hs)))
    qed
    show by taut(c1, c2)
  qed
  have k10: [nostk] tr.wmc(V, V, W, OB, s.fs_base, abi.sp(s)) proof
    fix p
    assume hp hn
    have _ lt := unsel(hp)
    have a1 a2 := apply(ui.wvm_at[vm := V, p := p], hp)
    have ns: !abi.stack_page(V, p) proof
      assume hs
      show by taut(hn, mp(a1, hs))
    qed
    have e := mp(a2, ns)
    have mv: x86_64_linux.mapped(V, p) by defs(taut(lt, rewrite(e, hn)), x86_64_linux.mapped)
    have nk: !(snd(V.pages[p]).kind = 2) proof
      assume hk
      have st: abi.stack_page(V, p) by defs(taut(mv, hk), abi.stack_page)
      show by taut(st, ns)
    qed
    show := rewrite(sym(e), nk)
  qed
  have k11: [stk] tr.wmc(V, V, W, OB, s.fs_base, abi.sp(s)) proof
    fix p
    assume _ _
    show := refl({V.pages[p]})
  qed
  have k12: [rsv] tr.wmc(V, V, W, OB, s.fs_base, abi.sp(s)) proof
    assume h
    show := h
  qed
  have wm: tr.wmc(V, V, W, OB, s.fs_base, abi.sp(s)) by clauses(k1, k2, k3, k4, k5, k6, k7, k8, k9, k10, k11, k12)
  have cb: abi.cball = tr.cbm(false, s.fs_base) by rsimp()
  show by defs(taut(ui.wvm_pages[vm := V], rewrite(cb, wm)), tr.vok)
qed

// the callers' stack objects at _start_c: exec's stack data, rsp to the
// stack's top
abbrev ui.iobjs(r, top) := set_select(omega, x. int_le(r, x) && int_lt(x, int_mul(top, x86_64_linux.PAGE)))

theorem ui.entry_objs: all m0 s lo top. m0 in x86_64_linux.Machine -> lo in omega -> top in omega -> x86_64_linux.stack_pages(m0.vm, lo, top) ->
  int_le(int_mul(lo, x86_64_linux.PAGE), m0.gpr[4]) -> int_le(16, m0.gpr[4]) -> ui.s5(m0, s) -> tr.objs_ok(s, ui.iobjs(m0.gpr[4], top))
proof
  fix m0 s lo top
  assume hM hlo htop hs h1 h16 h5
  have _ _ _ hsp _ _ _ _ _ _ ev := expand(h5, ui.s5)
  obtain v1, _ vg _ _ ve _ from ev
  have s1 s2 s3 s4 s5 s6 s7 s8 := expand(hs, x86_64_linux.stack_pages)
  have vg1 _ := expand(vg, abi.vm_grows)
  have g0 := apply(x86i.rsp_typed, hM)
  have spe: abi.sp(s) = m0.gpr[4] by rsimp(hsp, h16, g0, (int_add(int_sub(m0.gpr[4], 8), 8) = m0.gpr[4] by arith(g0)))
  unfold tr.objs_ok
  fix x
  assume hx hin
  have _ i1 i2 := unsel(hin)
  let q := int_div(x, x86_64_linux.PAGE)
  have qo: q in omega by arith(hx)
  let PR := fn_update(fn_update(empty, "prot", fn_update(fn_update(fn_update(empty, "r", true), "w", true), "x", false)), "kind", 2)
  have ep: m0.vm.pages[q] = some(PR) := mp(all_elim(s5, {q}), qo, conj((int_le(lo, q) by arith(h1, i1, hx)), (int_lt(q, top) by arith(i2, hx))))
  have mq: x86_64_linux.mapped(m0.vm, q) by defs(rsimp(ep, ui.some_nn[x := PR], (int_lt(q, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) by arith(i2, hx, s2))), x86_64_linux.mapped)
  have e1: v1.pages[q] = some(PR) := trans(mp(all_elim(vg1, {q}), qo, mq), ep)
  have e2: s.vm.pages[q] = some(PR) by rsimp(ve, e1)
  have sn: snd(s.vm.pages[q]) = PR := rewrite(sym(e2), ui.snd_some[x := PR])
  have ms: x86_64_linux.mapped(s.vm, q) by defs(rsimp(e2, ui.some_nn[x := PR], (int_lt(q, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) by arith(i2, hx, s2))), x86_64_linux.mapped)
  have xb: x in bits(64) by arith(i2, hx, s2)
  have be := apply(nf.boi_in[n := 64, x := x], eval(), xb)
  have k1: int_le(abi.sp(s), x) := rewrite(sym(spe), i1)
  have k2: abi.stack_page(s.vm, q) by defs(rsimp(ms, sn), abi.stack_page)
  have k3: x86_64_linux.can_access(s.vm, bits_of_int(64, x), 1) by defs(rsimp(be, ms, sn), x86_64_linux.can_access, x86_64_linux.page_of, x86_64_linux.hw_allows)
  show by taut(k1, k2, k3)
qed

// the ABI's entry at _start_c (the startup mode, aligned): rsp at the
// pushed return address on a stack page, the reserve, df clear, rdi exec's
// rsp -- the argument --, the break's start sound
theorem ui.entry_eok: all m0 s lo top. m0 in x86_64_linux.Machine -> lo in omega -> top in omega -> x86_64_linux.stack_pages(m0.vm, lo, top) ->
  int_le(int_mul(lo, x86_64_linux.PAGE), m0.gpr[4]) -> int_lt(m0.gpr[4], int_mul(top, x86_64_linux.PAGE)) -> int_mod(m0.gpr[4], 16) = 0 -> int_le(16, m0.gpr[4]) ->
  !m0.flags.df -> int_le(x86_64_linux.PAGE, m0.vm.brk_start) -> ui.s5(m0, s) -> tr.eok(false, false, s, seq_one(m0.gpr[4]))
proof
  fix m0 s lo top
  assume hM hlo htop hs h1 h2 hal h16 hdf hbs h5
  have _ _ _ hsp hdi hd _ _ _ _ ev := expand(h5, ui.s5)
  obtain v1, sk vg vf ac ve _ from ev
  have pt := apply(x86i.parts, hM)
  have _ _ _ hv := pt
  have g0 := apply(x86i.rsp_typed, hM)
  let A := bits_sub(64, m0.gpr[4], 8)
  have ae: A = int_sub(m0.gpr[4], 8) by rsimp(h16)
  have ao: A in omega by arith(ae, h16)
  have a0 := mp(all_elim(ac, {0}), eval(), eval())
  have a0e: bits_add(64, A, bits_of_int(64, 0)) = A by rsimp(ae, (int_add(int_sub(m0.gpr[4], 8), 0) = int_sub(m0.gpr[4], 8) by arith(h16)))
  have ca: x86_64_linux.can_access(v1, A, 1) := rewrite(a0e, a0)
  have mp1: x86_64_linux.mapped(v1, int_div(A, x86_64_linux.PAGE)) by taut(expand(ca, x86_64_linux.can_access, x86_64_linux.page_of))
  have sp := apply(ui.push_page[vm := m0.vm, v1 := v1, lo := lo, top := top, a := A], hv, hlo, htop, hs, sk, ao, arith(ae, h1), arith(ae, h2), mp1)
  let B := x86_64_linux.store_le(v1.bytes, A, 8, 4198565)
  have e1: abi.stack_page(s.vm, int_div(s.gpr[4], x86_64_linux.PAGE)) := rewrite(sym(hsp), rewrite(sym(ve), apply(ui.sp_bytes[B := B], sp)))
  have e2: x86_64_linux.can_access(s.vm, s.gpr[4], 1) := rewrite(sym(hsp), rewrite(sym(ve), apply(ui.ca_bytes[B := B], ca)))
  have rs := apply(ui.exec_reserve, hv, hlo, htop, hs)
  have _ sr := expand(sk, x86.stk_ext)
  have e3: abi.stack_reserve(s.vm) := rewrite(sym(ve), apply(ui.rsv_bytes[B := B], mp(sr, rs)))
  have e4: !s.flags.df := rewrite(sym(hd), hdf)
  have e5: all x0. x0 in omega -> int_lt(x0, seq_len(seq_one(m0.gpr[4]))) -> s.gpr[abi.ARG_REGS[x0]] = seq_one(m0.gpr[4])[x0] proof
    fix x
    assume hx hxl
    have z: x = 0 by arith(hx, (seq_len(seq_one(m0.gpr[4])) = 1 by simp()), hxl)
    have r0 _ _ _ _ _ := tr.argregs
    have q: s.gpr[abi.ARG_REGS[0]] = seq_one(m0.gpr[4])[0] := trans(rewrite(sym(r0), hdi), (m0.gpr[4] = seq_one(m0.gpr[4])[0] by simp()))
    show := rewrite(sym(z), q)
  qed
  have e6: int_mod(s.gpr[4], 8) = 0 := rewrite(sym(hsp), (int_mod(A, 8) = 0 by arith(ae, hal, h16)))
  have _ _ fb _ := expand(vf, x86.vm_fields)
  have e7: abi.brk_start_ok(s.vm) by defs(rsimp(ve, fb, hbs), abi.brk_start_ok)
  have e9: int_mod(bits_add(64, s.gpr[4], 8), 16) = 0 := rewrite(sym(hsp), (int_mod(bits_add(64, A, 8), 16) = 0 by arith(ae, hal, h16, g0)))
  show by defs(taut(e1, e2, e3, e4, e5, e6, e7, e9), tr.eok)
qed

// the program loaded at _start_c's entry: the text as exec loaded it, the
// push on the stack
theorem ui.entry_loaded: all m0 s. ui.s5(m0, s) -> abi.code_at(m0.vm, 4198400, text.code) -> abi.loaded(s.vm, 4198400, text.code, empty)
proof
  fix m0 s
  assume h5 hc
  have _ _ _ _ _ _ _ _ _ _ ev := expand(h5, ui.s5)
  obtain v1, _ vg _ ac ve _ from ev
  have c1 := apply(x86.code_grows[v0 := m0.vm, v := v1, a := 4198400, c := text.code], eval(), hc, vg)
  have c2 := all_elim(apply(tr.store_code_acc[f := 4198400, code := text.code, vm := v1, a := bits_sub(64, m0.gpr[4], 8), n := 8], eval(), eval(), c1, ac), {4198565})
  have c3: abi.code_at(s.vm, 4198400, text.code) := rewrite(sym(ve), c2)
  have vac: all x0. x0 in omega -> x0 in empty -> x86_64_linux.off_stack_space(s.vm, int_div(x0, x86_64_linux.PAGE), 1) proof
    fix x
    assume _ hx
    show by taut(hx, empty_mem[x := x])
  qed
  show by defs(taut(c3, vac), abi.loaded)
qed

// ----------------------------------------------------------------------
//  _start_c's spec: its runs

// (a memory: in the universe)
theorem ui.vm_univ: all vm. vm in x86_64_linux.Vm -> vm in univ(1)
proof
  fix vm
  assume h
  let K := insert("pages", insert("bytes", insert("stack_top", insert("stack_limit", insert("brk_start", insert("brk", empty))))))
  have hp hq := unsel(expand(h, x86_64_linux.Vm))
  have hf hd := (is_fun(vm) && dom(vm) = K by taut(hq))
  have ku: K in univ(1) by simp()
  show := mp(rec_univ[u := 1, k := K, r := vm], ku, hp, hf, hd)
qed

// (__init_tls's writes: startup's)
theorem ui.tls_sub: all g x. g.libc in bits(64) -> int_lt(int_add(g.libc, 56), 18446744073709551616) -> x in startup_specs.tls_writes(g) -> x in startup_specs.start_writes(g)
proof
  fix g x
  assume hl hl2 hx
  have xo q := unsel(expand(hx, startup_specs.tls_writes))
  have c2: x in startup_specs.span(bits_add(64, g.libc, 16), 32) -> x in startup_specs.span(bits_add(64, g.libc, 8), 48) proof
    assume h
    have _ a1 a2 := unsel(expand(h, startup_specs.span))
    show by defs(sel(conj(xo, (int_le(bits_add(64, g.libc, 8), x) && int_lt(x, int_add(bits_add(64, g.libc, 8), 48)) by defs(arith(a1, a2, hl, hl2), bits_add, pow2)))), startup_specs.span)
  qed
  show by defs(sel(conj(xo, (x in startup_specs.span(g.libc, 1) || x in startup_specs.span(bits_add(64, g.libc, 8), 48) || x in startup_specs.span(g.environ, 8) ||
    x in startup_specs.span(g.hwcap, 8) || x in startup_specs.span(g.sysinfo, 8) || x in startup_specs.span(g.progname, 8) ||
    x in startup_specs.span(g.progname_full, 8) || x in startup_specs.span(g.default_stacksize, 4) || x in startup_specs.span(g.builtin_tls, 336) ||
    x in startup_specs.span(g.main_tls, 48) || x in startup_specs.span(g.stack_chk_guard, 8) by taut(q, c2)))), startup_specs.start_writes)
qed

// (a store apart from the thread's descriptor's first 48 bytes: the thread
// kept)
theorem ui.ts_store: all V fs a v. startup_specs.thread_set(V, fs) -> fs in bits(64) -> a in bits(64) -> int_lt(int_add(fs, 48), 9223372036854775808) ->
  int_lt(int_add(a, 8), 9223372036854775808) -> (int_le(int_add(fs, 48), a) || int_le(int_add(a, 8), fs)) ->
  startup_specs.thread_set(fn_update(V, "bytes", x86_64_linux.store_le(V.bytes, a, 8, v)), fs)
proof
  fix V fs a v
  assume ht hf ha h1 h2 hd
  let V2 := fn_update(V, "bytes", x86_64_linux.store_le(V.bytes, a, 8, v))
  have to co := expand(ht, startup_specs.thread_set)
  have t1 t2 t3 t4 := expand(to, abi.thread_ok)
  have far: all k. k in omega -> int_lt(k, 8) -> !int_lt(bits_sub(64, bits_add(64, fs, bits_of_int(64, k)), a), 8) proof
    fix k
    assume hk hkl
    have bk: bits_of_int(64, k) = k := apply(nf.boi_in[n := 64, x := k], eval(), (k in bits(64) by arith(hk, hkl)))
    show by defs(arith(rewrite(bk, refl({bits_add(64, fs, bits_of_int(64, k))})), hk, hkl, hf, ha, h1, h2, hd), bits_sub, bits_add, pow2)
  qed
  have le := apply(x86.le_store_far[b := V.bytes, r := fs, a := a, n := 8, v := v], hf, ha, far)
  have t3b: x86_64_linux.le(V2.bytes, fs, 8) = fs by rsimp(le, t3)
  have to2: abi.thread_ok(V2, fs) by defs(taut((x86_64_linux.readable(V2, fs, 8) by rsimp(expand(t1, x86_64_linux.readable, x86_64_linux.mapped), x86_64_linux.readable, x86_64_linux.mapped)),(all x0. x0 in omega -> int_lt(x0, 8) -> !abi.stack_page(V2, int_div(int_add(fs, x0), x86_64_linux.PAGE)) by rsimp(expand(t2, abi.stack_page, x86_64_linux.mapped), abi.stack_page, x86_64_linux.mapped)), t3b, t4), abi.thread_ok)
  have c1 c2 := expand(co, abi.canary_ok)
  have co2: abi.canary_ok(V2, fs) by defs(taut((x86_64_linux.readable(V2, int_add(fs, 40), 8) by rsimp(expand(c1, x86_64_linux.readable, x86_64_linux.mapped), x86_64_linux.readable, x86_64_linux.mapped)),
    (all x0. x0 in omega -> int_lt(x0, 8) -> snd(V2.pages[int_div(int_add(int_add(fs, 40), x0), x86_64_linux.PAGE)]).prot.w &&
      !abi.stack_page(V2, int_div(int_add(int_add(fs, 40), x0), x86_64_linux.PAGE)) by rsimp(expand(c2, abi.stack_page, x86_64_linux.mapped), abi.stack_page, x86_64_linux.mapped))), abi.canary_ok)
  show by defs(taut(to2, co2), startup_specs.thread_set)
qed

// (a memory with startup's effect: the thread set up -- __init_tls's choice
// -- and libc.auxv past envp's n words: to_main's choice is possible)
theorem ui.main_exists: all g t E n. t in abi.World -> g.builtin_tls in bits(64) -> g.libc in bits(64) -> int_lt(int_add(g.libc, 56), 9223372036854775808) ->
  int_lt(int_add(g.builtin_tls, 336), 9223372036854775808) -> (int_le(int_add(g.builtin_tls, 336), int_add(g.libc, 8)) || int_le(int_add(g.libc, 16), g.builtin_tls)) ->
  startup_specs.globals_ok(t.vm, t.objs, g) -> n in omega -> startup_specs.env_at(t.vm, t.objs, E, n) -> E in bits(64) ->
  ex V. V in x86_64_linux.Vm && ((startup_specs.frame(t.vm, V, t.objs, startup_specs.start_writes(g)) &&
    (all x4. x4 in omega -> startup_specs.env_at(t.vm, t.objs, E, x4) -> gimple.bytes_at(V, int_add(g.libc, 8), 8) = int_add(E, int_mul(8, int_add(x4, 1))))) &&
    (ex x4. x4 in bits(64) && startup_specs.thread_at(g, V, x4)))
proof
  fix g t E n
  assume hw hb hl hl2 hb2 hdis hg hn he hE
  obtain V0, hV0 hfr0 hfs from apply(sp.tls_exists, {g}, {t}, hw, hb, hg)
  obtain fs0, hf0 hts hit from hfs
  let a := bits_add(64, g.libc, 8)
  let val := int_add(E, int_mul(8, int_add(n, 1)))
  let V2 := fn_update(V0, "bytes", x86_64_linux.store_le(V0.bytes, a, 8, val))
  have _ ev _ _ _ := expand(he, startup_specs.env_at)
  have ae: a = int_add(g.libc, 8) by defs(arith(hl, hl2), bits_add, pow2)
  have ab: a in bits(64) by arith(ae, hl, hl2)
  have vb: val in bits(64) by arith(ev, hn, hE)
  // (typed)
  have V0u := apply(ui.vm_univ, hV0)
  have bt: V0.bytes in fn_space(bits(64), bits(8)) by taut(unsel(expand(hV0, x86_64_linux.Vm)))
  have st := apply(x86.store_typed[b := V0.bytes, a := a, n := 8, v := val], bt)
  have su := mp(fn_space_univ[u := 1, a := bits(64), b := bits(8), f := x86_64_linux.store_le(V0.bytes, a, 8, val)], bits_univ[n := 64], bits_univ[n := 8], st)
  have V2u: V2 in univ(1) by simp(V0u, su)
  have V2v := apply(x86.store_vm[vm := V0, a := a, n := 8, v := val], hV0, V2u)
  // (the frame: __init_tls's writes and libc.auxv's word, startup's)
  have ts: all x. x in startup_specs.tls_writes(g) -> x in startup_specs.start_writes(g) proof
    fix x
    assume hx
    show := apply(ui.tls_sub[g := g, x := x], hl, arith(hl2), hx)
  qed
  have fr1 := apply(sp.fr_mono[b := t.vm, U := V0, o := t.objs, W1 := startup_specs.tls_writes(g), W2 := startup_specs.start_writes(g)], hfr0, ts)
  have sw: all i. i in omega -> int_lt(i, 8) -> int_add(a, i) in startup_specs.start_writes(g) || abi.stack_free(t.vm, t.objs, int_add(a, i)) proof
    fix i
    assume hi hil
    show by taut(apply(sp.sw_libc8[g := g, x := int_add(a, i)], hl, arith(hl2), arith(hi, ab), arith(ae, hi), arith(ae, hi, hil)))
  qed
  have fr2 := apply(sp.fr_store[b := t.vm, U := V0, objs := t.objs, W := startup_specs.start_writes(g), a := a, n := 8, v := val], fr1, ab, eval(), arith(ae, hl2), sw)
  // (libc.auxv's word)
  have l8 := apply(tr.le_store8[b := V0.bytes, a := a, x := val], bt, ab, arith(vb))
  have b2: V2.bytes in fn_space(bits(64), bits(8)) by rsimp(st, rewrite(ae, st))
  have l8b := apply(x86.le8_nat[vm := V2, a := a], b2)
  have bv: gimple.bytes_at(V2, a, 8) = val := trans(sym(l8b), trans((x86_64_linux.le(V2.bytes, a, 8) = x86_64_linux.le(x86_64_linux.store_le(V0.bytes, a, 8, val), a, 8) by rsimp()),
    trans(l8, apply(nf.boi_in[n := 64, x := val], eval(), vb))))
  have ea: all x4. x4 in omega -> startup_specs.env_at(t.vm, t.objs, E, x4) -> gimple.bytes_at(V2, int_add(g.libc, 8), 8) = int_add(E, int_mul(8, int_add(x4, 1))) proof
    fix x4
    assume h4 he4
    have q := apply(sp.env_unique[vm := t.vm, o := t.objs, e := E, n1 := n, n2 := x4], hn, h4, he, he4)
    have bc: gimple.bytes_at(V2, int_add(g.libc, 8), 8) = gimple.bytes_at(V2, a, 8) by rsimp(ae)
    show := rewrite(q, trans(bc, bv))
  qed
  // (the thread: apart from libc)
  have i1 i2 := expand(hit, startup_specs.in_tls)
  have ts2 := apply(ui.ts_store[V := V0, fs := fs0, a := a, v := val], hts, hf0, ab, arith(i2, hb2), arith(ae, hl2), arith(hdis, ae, i1, i2))
  have et: ex x4. x4 in bits(64) && startup_specs.thread_at(g, V2, x4) by ex_intro({fs0}, taut(hf0, (startup_specs.thread_at(g, V2, fs0) by defs(taut(ts2, hit), startup_specs.thread_at))))
  show by ex_intro({V2}, taut(V2v, fr2, ea, et))
qed

// _start_c's precondition (its spec's require)
abbrev ui.c_pre(vm, objs, g, P, sp) := !(sp = 0) && int_lt(int_add(sp, 16), int_pow(2, 63)) && gimple.usable(vm, objs, sp, 8, false) &&
  startup_specs.start_main_pre(vm, objs, g, P, gimple.bytes_at(vm, sp, 8), bits_add(64, sp, 8))

// _start_c's spec's runs from t (its precondition holding): a stack
// overflow, or main entered with startup's effect
theorem ui.c_q: all g P sp t o. t in abi.World -> t in univ(1) -> g.builtin_tls in bits(64) -> g.libc in bits(64) -> int_lt(int_add(g.libc, 56), 9223372036854775808) ->
  int_lt(int_add(g.builtin_tls, 336), 9223372036854775808) -> (int_le(int_add(g.builtin_tls, 336), int_add(g.libc, 8)) || int_le(int_add(g.libc, 16), g.builtin_tls)) ->
  sp in bits(64) -> ui.c_pre(t.vm, t.objs, g, P, sp) -> runs(startup_specs.start_c_spec_fun(g, P)[seq_one(sp)], t, o) ->
  sp.ovf_any(t, o) || (ex V fs. V in x86_64_linux.Vm && startup_specs.frame(t.vm, V, t.objs, startup_specs.start_writes(g)) &&
    (all x4. x4 in omega -> startup_specs.env_at(t.vm, t.objs, bits_add(64, sp, int_mul(8, int_add(gimple.bytes_at(t.vm, sp, 8), 2))), x4) ->
       gimple.bytes_at(V, int_add(g.libc, 8), 8) = int_add(bits_add(64, sp, int_mul(8, int_add(gimple.bytes_at(t.vm, sp, 8), 2))), int_mul(8, int_add(x4, 1)))) &&
    fs in bits(64) && startup_specs.thread_at(g, V, fs) && o = exc(fn_update(fn_update(t, "vm", V), "fs_base", fs), exc_val("at_main", empty)))
proof
  fix g P sp t o
  assume hw htu hb hl hl2 hb2 hdis hsp hpre h
  have sl := apply(tr.seq_one_type[x := sp, t := bits(64)], hsp)
  have ol: ord_le(seq_len(seq_one(sp)), 6) by defs(arith((seq_len(seq_one(sp)) = 1 by simp())), ord_le)
  have ra: seq_one(sp) in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by sel(conj(sl, ol))
  rsimp only, startup_specs.start_c_spec_fun, app_fn_build, ra in h
  have b := apply(g.runs_elim, h)
  have q0: bits_of_int(64, seq_one(sp)[0]) = sp by simp(apply(nf.boi_in[n := 64, x := sp], eval(), hsp))
  have o1l: ord_le(1, seq_len(seq_one(sp))) by defs(arith((seq_len(seq_one(sp)) = 1 by simp())), ord_le)
  have b2: bind_rel(startup_specs.start_c_spec(g, P, sp), t, x0 x1. any_rel(x2. x2 in bits(64), x2. any_rel(x3. x3 in bits(64), x3. o = ok(x0, pair(x2, x3)))),
    x0 x1. o = exc(x0, x1), x0. o = diverge(x0)) by taut(rewrite(q0, b), o1l)
  obtain o3, hs3 hk3 from expand(b2, bind_rel)
  rsimp only, startup_specs.start_c_spec in hs3
  obtain x0, hbr hout from apply(or_resolve, apply(g.runs_elim, hs3), hpre)
  let OVF := exc_val("stack_overflow", empty)
  have k1: case 1 of hbr proof
    assume e
    rsimp only, startup_specs.overflow_start, abi.overflow in e
    have pv _ _ _ := apply(ms.world_parts, hw)
    have vv: ex x. x in x86_64_linux.Vm by ex_intro({t.vm}, simp(pv))
    have fv: ex x. x in bits(64) by ex_intro({0}, simp())
    have l: ex f v ob. ((f in bits(64) && v in x86_64_linux.Vm) && ob in abi.Objs) &&
      x0 = exc(pair(fn_update(fn_update(fn_update(t, "fs_base", f), "vm", v), "objs", ob), empty), pair("raise", OVF)) by simp(e, vv, fv, ct.objs_ne)
    obtain f v ob, hf hv hob hx from l
    let T := fn_update(fn_update(fn_update(t, "fs_base", f), "vm", v), "objs", ob)
    have oe: o3 = exc(T, OVF) by simp(rewrite(hx, hout))
    have o2e: o = exc(T, OVF) by simp(rewrite(oe, hk3))
    have x: sp.ovf_any(t, o) by defs(ex_intro({f}, {v}, {ob}, taut(hf, hv, hob, o2e)), sp.ovf_any)
    show by taut(x)
  qed
  have k2: case 2 of hbr proof
    assume e
    rsimp only, startup_specs.to_main in e
    obtain o4, hs4 hk4 from expand(e, bind_rel)
    have hl1 := apply(g.letin_e, apply(g.runs_elim, hs4))
    rsimp in hl1
    // (the precondition's envp: n words)
    have _ hsp16 _ hsm := hpre
    have m1 m2 m3 m4 hil hct := expand(hsm, startup_specs.start_main_pre)
    obtain n auxv, hn _ hrest from expand(hil, startup_specs.init_libc_pre)
    have hen _ _ hgl _ _ _ _ _ _ _ _ := hrest
    let E := bits_add(64, sp, int_mul(8, int_add(gimple.bytes_at(t.vm, sp, 8), 2)))
    let C := gimple.bytes_at(t.vm, sp, 8)
    have _ _ _ tvb := apply(ms.world_parts, hw)
    have co _ := apply(g.bytes_bound[vm := t.vm, a := sp, n := 8], tvb, eval())
    have e1 := apply(x86.add_nowrap[a := sp, b := 8], arith(hsp), eval(), arith(hsp16, hsp))
    have e2 := apply(x86.add_nowrap[a := bits_add(64, sp, 8), b := int_mul(8, int_add(C, 1))], arith(e1, hsp), arith(co), arith(m3, e1, hsp, co))
    have e3 := apply(x86.add_nowrap[a := sp, b := int_mul(8, int_add(C, 2))], arith(hsp), arith(co), arith(m3, e1, hsp, co))
    have ee: bits_add(64, bits_add(64, sp, 8), int_mul(8, int_add(C, 1))) = E := trans(e2, trans((int_add(bits_add(64, sp, 8), int_mul(8, int_add(C, 1))) = int_add(sp, int_mul(8, int_add(C, 2))) by arith(e1, co, hsp)), sym(e3)))
    have hen2 := rewrite(ee, hen)
    have Eb: E in bits(64) by simp()
    have ex1 := apply(ui.main_exists[g := g, t := t, E := E, n := n], hw, hb, hl, hl2, hb2, hdis, hgl, hn, hen2, Eb)
    obtain V, hV hcv hk from apply(g.any_e, ex1, hl1)
    have hfr hea hth := hcv
    have hk1 := apply(g.letin_e, hk)
    rsimp in hk1
    obtain fs, hfb hts hk2 from apply(g.any_e, hth, hk1)
    have xe := apply(g.letin_e, hk2)
    let T := fn_update(fn_update(t, "vm", V), "fs_base", fs)
    let AM := exc_val("at_main", empty)
    obtain x, hr hc from xe
    rsimp only, startup_specs.main_entered in hr
    have xr: x = exc(T, AM) := apply(g.runs_elim, hr)
    have c1: (ex x1 x2. x = ok(x1, x2) && o4 = ok(x1, empty)) -> false proof
      assume hh
      obtain x1 x2, q _ from hh
      show := rsimp(trans(sym(xr), q))
    qed
    have c2: (ex x1 x2. x = exc(x1, x2) && o4 = exc(x1, x2)) -> o4 = exc(T, AM) proof
      assume hh
      obtain x1 x2, q1 q2 from hh
      show := trans(q2, trans(sym(q1), xr))
    qed
    have c3: (ex x1. x = diverge(x1) && o4 = diverge(x1)) -> false proof
      assume hh
      obtain x1, q _ from hh
      show := rsimp(trans(sym(xr), q))
    qed
    have o4e: o4 = exc(T, AM) by taut(hc, c1, c2, c3)
    have d1: (ex s1 v. o4 = ok(s1, v) && x0 = ok(pair(s1, empty), empty)) -> false proof
      assume hh
      obtain s1 v, q _ from hh
      show := rsimp(trans(sym(o4e), q))
    qed
    have d2: (ex s1 e1. o4 = exc(s1, e1) && x0 = exc(pair(s1, empty), pair("raise", e1))) -> x0 = exc(pair(T, empty), pair("raise", AM)) proof
      assume hh
      obtain s1 e1, q1 q2 from hh
      have i1 i2 := apply(ui.exc_inj, trans(sym(q1), o4e))
      show := rewrite(i1, rewrite(i2, q2))
    qed
    have d3: (ex d. o4 = diverge(d) && x0 = diverge(d)) -> false proof
      assume hh
      obtain d, q _ from hh
      show := rsimp(trans(sym(o4e), q))
    qed
    have x0e: x0 = exc(pair(T, empty), pair("raise", AM)) by taut(hk4, d1, d2, d3)
    have oe: o3 = exc(T, AM) by simp(rewrite(x0e, hout))
    have o2e: o = exc(T, AM) by simp(rewrite(oe, hk3))
    have r: ex V fs. V in x86_64_linux.Vm && startup_specs.frame(t.vm, V, t.objs, startup_specs.start_writes(g)) &&
      (all x4. x4 in omega -> startup_specs.env_at(t.vm, t.objs, bits_add(64, sp, int_mul(8, int_add(gimple.bytes_at(t.vm, sp, 8), 2))), x4) ->
         gimple.bytes_at(V, int_add(g.libc, 8), 8) = int_add(bits_add(64, sp, int_mul(8, int_add(gimple.bytes_at(t.vm, sp, 8), 2))), int_mul(8, int_add(x4, 1)))) &&
      fs in bits(64) && startup_specs.thread_at(g, V, fs) && o = exc(fn_update(fn_update(t, "vm", V), "fs_base", fs), exc_val("at_main", empty))
      by ex_intro({V}, {fs}, taut(hV, hfr, hea, hfb, hts, o2e))
    show by taut(r)
  qed
  show by taut(hbr, k1, k2)
qed

// (a spec that only overflows or enters main: the bridge's outcome for a
// run the claim's run gives -- the stop at m)
theorem ui.mtv_stop: all s V P W o m. (all o2. runs(P, W, o2) -> (ex x. o2 = exc(x, exc_val("stack_overflow", empty))) || (ex x. o2 = exc(x, exc_val("at_main", empty)))) ->
  tr.mtv(false, s, V, P, W, o, true) -> ui.Q(s, m, o) -> tr.stv(false, P, W, ok(m, exc_val("stop", empty)))
proof
  fix s V P W o m
  assume hP hm hq
  let OVF := exc_val("stack_overflow", empty)
  let AM := exc_val("at_main", empty)
  let ST := exc_val("stop", empty)
  // (no undefined behaviour: P raises nothing else)
  have nub: !tr.ub(s, V, P, W) proof
    assume hu
    obtain e x, _ n1 n2 _ hr from expand(hu, tr.ub)
    have c1: (ex y. exc(x, e) = exc(y, OVF)) -> false proof
      assume hh
      obtain y, q from hh
      have _ q2 := apply(ui.exc_inj, q)
      show by taut(q2, n1)
    qed
    have c2: (ex y. exc(x, e) = exc(y, AM)) -> false proof
      assume hh
      obtain y, q from hh
      have _ q2 := apply(ui.exc_inj, q)
      show by taut(q2, n2)
    qed
    show by taut(mp(all_elim(hP, {exc(x, e)}), hr), c1, c2)
  qed
  // (no return: P has no normal outcome)
  have nret: all m1. !tr.rtv(false, s, V, P, W, m1) proof
    fix m1
    assume hr
    have _ _ ew .. := expand(hr, tr.rtv)
    obtain w2, hw2 .. from ew
    have c1: (ex y. ok(w2, pair(m1.gpr[0], m1.gpr[2])) = exc(y, OVF)) -> false proof
      assume hh
      obtain y, q from hh
      show := rsimp(q)
    qed
    have c2: (ex y. ok(w2, pair(m1.gpr[0], m1.gpr[2])) = exc(y, AM)) -> false proof
      assume hh
      obtain y, q from hh
      show := rsimp(q)
    qed
    show by taut(mp(all_elim(hP, {ok(w2, pair(m1.gpr[0], m1.gpr[2]))}), hw2), c1, c2)
  qed
  have mt := expand(hm, tr.mtv)
  // (the cases of the claim's run)
  have q1: o = ok(m, ST) -> tr.stv(false, P, W, ok(m, ST)) proof
    assume e
    have ncr: !tr.crash(s, P, W, o) proof
      assume hc
      obtain m2 a k, oe _ _ _ _ _ from expand(hc, tr.crash)
      have z1: !(ok(m, ST) = exc(m2, exc_val("segv", pair(a, k)))) proof
        assume q
        show := rsimp(q)
      qed
      have z2: !(ok(m, ST) = exc(m2, exc_val("stack_fault", empty))) proof
        assume q
        show := rsimp(q)
      qed
      show by taut(rewrite(e, oe), z1, z2)
    qed
    have ndv: !tr.div(P, W, o) proof
      assume hd
      have dq _ := expand(hd, tr.div)
      obtain t2, q from dq
      show := rsimp(trans(sym(e), q))
    qed
    have nr2: !(ex m1. o = ok(m1, empty) && tr.rtv(false, s, V, P, W, m1)) proof
      assume hh
      obtain m1, q hr from hh
      show by taut(hr, all_elim(nret, {m1}))
    qed
    show := rewrite(e, (tr.stv(false, P, W, o) by taut(mt, nub, ncr, ndv, nr2)))
  qed
  have q2: (ex x. o = exc(x, exc_val("disc", empty))) -> false proof
    assume hh
    obtain x, e from hh
    have ncr: !tr.crash(s, P, W, o) proof
      assume hc
      obtain m2 a k, oe _ _ _ _ _ from expand(hc, tr.crash)
      have z1: !(exc(x, exc_val("disc", empty)) = exc(m2, exc_val("segv", pair(a, k)))) proof
        assume q
        have _ q2 := apply(ui.exc_inj, q)
        have u _ := apply(pair_inj[a := "disc", b := empty, c := "segv", d := pair(a, k)], (pair("disc", empty) = pair("segv", pair(a, k)) by defs(q2, exc_val)))
        show by taut(u, (!("disc" = "segv") by eval()))
      qed
      have z2: !(exc(x, exc_val("disc", empty)) = exc(m2, exc_val("stack_fault", empty))) proof
        assume q
        have _ q2 := apply(ui.exc_inj, q)
        have u _ := apply(pair_inj[a := "disc", b := empty, c := "stack_fault", d := empty], (pair("disc", empty) = pair("stack_fault", empty) by defs(q2, exc_val)))
        show by taut(u, (!("disc" = "stack_fault") by eval()))
      qed
      show by taut(rewrite(e, oe), z1, z2)
    qed
    have ndv: !tr.div(P, W, o) proof
      assume hd
      have dq _ := expand(hd, tr.div)
      obtain t2, q from dq
      show := rsimp(trans(sym(e), q))
    qed
    have nr2: !(ex m1. o = ok(m1, empty) && tr.rtv(false, s, V, P, W, m1)) proof
      assume hh
      obtain m1, q _ from hh
      show := rsimp(trans(sym(e), q))
    qed
    have nst: !tr.stv(false, P, W, o) proof
      assume hh
      obtain m3 w v2 mem2, q _ _ _ _ from expand(hh, tr.stv)
      show := rsimp(trans(sym(e), q))
    qed
    show by taut(mt, nub, ncr, ndv, nr2, nst)
  qed
  have q3: (ex x. o = ok(x, empty) && tr.at_ret(s, x)) -> false proof
    assume hh
    obtain x, e _ from hh
    have ncr: !tr.crash(s, P, W, o) proof
      assume hc
      obtain m2 a k, oe _ _ _ _ _ from expand(hc, tr.crash)
      have z1: !(ok(x, empty) = exc(m2, exc_val("segv", pair(a, k)))) proof
        assume q
        show := rsimp(q)
      qed
      have z2: !(ok(x, empty) = exc(m2, exc_val("stack_fault", empty))) proof
        assume q
        show := rsimp(q)
      qed
      show by taut(rewrite(e, oe), z1, z2)
    qed
    have ndv: !tr.div(P, W, o) proof
      assume hd
      have dq _ := expand(hd, tr.div)
      obtain t2, q from dq
      show := rsimp(trans(sym(e), q))
    qed
    have nr2: !(ex m1. o = ok(m1, empty) && tr.rtv(false, s, V, P, W, m1)) proof
      assume h2
      obtain m1, _ hr from h2
      show by taut(hr, all_elim(nret, {m1}))
    qed
    have nst: !tr.stv(false, P, W, o) proof
      assume h2
      obtain m3 w v2 mem2, q _ _ _ _ from expand(h2, tr.stv)
      have _ q2 := apply(ui.ok_inj, trans(sym(e), q))
      show by taut(q2, tr.stop_ne)
    qed
    show by taut(mt, nub, ncr, ndv, nr2, nst)
  qed
  show by taut(expand(hq, ui.Q), q1, q2, q3)
qed

// ----------------------------------------------------------------------
//  _start_c's machine code from its entry: the stop at main

// startup's globals and the program's addresses (the units' symbols)
abbrev ui.G := fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(empty,
  "environ", c_src_env___libc_start_main.__environ), "hwcap", c_src_env___libc_start_main.__hwcap), "sysinfo", c_src_env___libc_start_main.__sysinfo),
  "libc", c_src_env___libc_start_main.__libc), "progname", c_src_env___libc_start_main.__progname), "progname_full", c_src_env___libc_start_main.__progname_full),
  "empty_str", c_src_env___libc_start_main.str_), "default_stacksize", c_src_env___init_tls.__default_stacksize), "builtin_tls", c_src_env___init_tls.builtin_tls),
  "main_tls", c_src_env___init_tls.main_tls), "stack_chk_guard", c_src_env___stack_chk_fail.__stack_chk_guard)
abbrev ui.P := fn_update(fn_update(fn_update(fn_update(empty, "init_array", c_src_env___libc_start_main.__init_array_start),
  "init_array_end", c_src_env___libc_start_main.__init_array_end), "ctor", 4198864), "main", c_crt_crt1.main_at)

theorem ui.gp_ok: lk.gok(ui.G) && lk.pok(ui.P)
proof
  show by rsimp()
qed

// (the globals' layout: libc below the static TLS area)
theorem ui.g_facts: ui.G.builtin_tls in bits(64) && ui.G.libc in bits(64) && int_lt(int_add(ui.G.libc, 56), 9223372036854775808) &&
  int_lt(int_add(ui.G.builtin_tls, 336), 9223372036854775808) && (int_le(int_add(ui.G.builtin_tls, 336), int_add(ui.G.libc, 8)) || int_le(int_add(ui.G.libc, 16), ui.G.builtin_tls))
proof
  show by eval()
qed

// every run of _start_c's spec from a world where its precondition holds:
// a stack overflow or main entered
theorem ui.c_only: all a t o. t in abi.World -> t in univ(1) -> a in bits(64) -> ui.c_pre(t.vm, t.objs, ui.G, ui.P, a) ->
  runs(startup_specs.start_c_spec_fun(ui.G, ui.P)[seq_one(a)], t, o) ->
  (ex x. o = exc(x, exc_val("stack_overflow", empty))) || (ex x. o = exc(x, exc_val("at_main", empty)))
proof
  fix a t o
  assume hw hu ha hp hr
  have f1 f2 f3 f4 f5 := ui.g_facts
  have q := apply(ui.c_q[g := ui.G, P := ui.P, sp := a, t := t, o := o], hw, hu, f1, f2, f3, f4, f5, ha, hp, hr)
  have c1: sp.ovf_any(t, o) -> (ex x. o = exc(x, exc_val("stack_overflow", empty))) proof
    assume h
    obtain f v ob, _ _ _ e from expand(h, sp.ovf_any)
    show by ex_intro({fn_update(fn_update(fn_update(t, "fs_base", f), "vm", v), "objs", ob)}, e)
  qed
  have c2: (ex V fs. V in x86_64_linux.Vm && startup_specs.frame(t.vm, V, t.objs, startup_specs.start_writes(ui.G)) &&
    (all x4. x4 in omega -> startup_specs.env_at(t.vm, t.objs, bits_add(64, a, int_mul(8, int_add(gimple.bytes_at(t.vm, a, 8), 2))), x4) ->
       gimple.bytes_at(V, int_add(ui.G.libc, 8), 8) = int_add(bits_add(64, a, int_mul(8, int_add(gimple.bytes_at(t.vm, a, 8), 2))), int_mul(8, int_add(x4, 1)))) &&
    fs in bits(64) && startup_specs.thread_at(ui.G, V, fs) && o = exc(fn_update(fn_update(t, "vm", V), "fs_base", fs), exc_val("at_main", empty))) ->
    (ex x. o = exc(x, exc_val("at_main", empty))) proof
    assume h
    obtain V fs, _ _ _ _ _ e from h
    show by ex_intro({fn_update(fn_update(t, "vm", V), "fs_base", fs)}, e)
  qed
  show by taut(q, c1, c2)
qed

// _start_c's machine code from its entry s (exec's stack data the callers'
// objects, the world's view of s): the claim's run to main ends at m as
// its spec's world entering main
theorem ui.c_stop: all s objs m a. s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(s.vm, 4198400, text.code, empty) -> s.rip = 4198565 ->
  tr.eok(false, false, s, seq_one(a)) -> a in bits(64) -> objs in set_type(omega) -> tr.objs_ok(s, objs) -> ui.UR(4198873, s, m) ->
  !(4198873 = x86_64_linux.le(s.vm.bytes, s.gpr[4], 8)) -> tr.vw(false, s, objs, ui.wvm(s.vm)) in abi.World -> tr.vw(false, s, objs, ui.wvm(s.vm)) in univ(1) ->
  ui.c_pre(ui.wvm(s.vm), abi.wob(objs, abi.cball), ui.G, ui.P, a) ->
  tr.stv(false, startup_specs.start_c_spec_fun(ui.G, ui.P)[seq_one(a)], tr.vw(false, s, objs, ui.wvm(s.vm)), ok(m, exc_val("stop", empty)))
proof
  fix s objs m a
  assume hM hU hl hr he ha ho hob hur hnt hw hwu hp
  let W := tr.vw(false, s, objs, ui.wvm(s.vm))
  let SP := startup_specs.start_c_spec_fun(ui.G, ui.P)[seq_one(a)]
  obtain o, hrun hq from apply(ui.until_run[s := s, t := 4198873, m0 := s, m := m], hur, hnt)
  have gk: lk.gok(ui.G) by rsimp()
  have pk: lk.pok(ui.P) by rsimp()
  have im := expand(mp(all_elim(lk.start_impl, {ui.G}, {ui.P}, {empty}), gk, pk), tr.impl_m)
  have _ _ _ pv := apply(x86i.parts, hM)
  have wt _ := apply(ui.wvm_typed, pv, apply(ui.vm_univ, pv))
  have sl := apply(tr.seq_one_type[x := a, t := bits(64)], ha)
  have ol: ord_le(seq_len(seq_one(a)), 6) by defs(arith((seq_len(seq_one(a)) = 1 by simp())), ord_le)
  have ra: seq_one(a) in abi.ARGS by sel(conj(sl, ol))
  have mt := mp(all_elim(im, {seq_one(a)}, {objs}, {ui.wvm(s.vm)}, {s}, {o}), ra, ho, wt, hM, hU, hl, hr, he, hob, ui.wvm_vok[s := s, objs := objs], hrun)
  have wv: W.vm = ui.wvm(s.vm) by rsimp()
  have wo: W.objs = abi.wob(objs, abi.cball) by rsimp()
  have hP: all o2. runs(SP, W, o2) -> (ex x. o2 = exc(x, exc_val("stack_overflow", empty))) || (ex x. o2 = exc(x, exc_val("at_main", empty))) proof
    fix o2
    assume h2
    have hp2: ui.c_pre(W.vm, W.objs, ui.G, ui.P, a) := rewrite(sym(wv), rewrite(sym(wo), hp))
    show := apply(ui.c_only[a := a, t := W, o := o2], hw, hwu, ha, hp2, h2)
  qed
  show := apply(ui.mtv_stop[s := s, V := abi.wob(objs, tr.cbm(false, s.fs_base)), P := SP, W := W, o := o, m := m], hP, mt, hq)
qed

// (equal records: equal fields)
theorem ui.app_eq: all f g k. f = g -> f[k] = g[k]
proof
  fix f g k
  assume e
  show := subst({y. f[k] = y[k]}, e, refl({f[k]}))
qed

// the machine at main: its world startup's -- its memory's view V the
// entry's but startup's writes, libc.auxv set, the thread set up at m's
// thread pointer
def ui.at_main(s, objs, m, a, V, fs) := V in x86_64_linux.Vm && startup_specs.frame(ui.wvm(s.vm), V, abi.wob(objs, abi.cball), startup_specs.start_writes(ui.G)) &&
  (all x4. x4 in omega -> startup_specs.env_at(ui.wvm(s.vm), abi.wob(objs, abi.cball), bits_add(64, a, int_mul(8, int_add(gimple.bytes_at(ui.wvm(s.vm), a, 8), 2))), x4) ->
     gimple.bytes_at(V, int_add(ui.G.libc, 8), 8) = int_add(bits_add(64, a, int_mul(8, int_add(gimple.bytes_at(ui.wvm(s.vm), a, 8), 2))), int_mul(8, int_add(x4, 1)))) &&
  fs in bits(64) && startup_specs.thread_at(ui.G, V, fs) && m.fs_base = fs && m.os = s.os && tr.vok(false, m, objs, V)

theorem ui.main_world: all s objs m a. a in bits(64) -> tr.vw(false, s, objs, ui.wvm(s.vm)) in abi.World -> tr.vw(false, s, objs, ui.wvm(s.vm)) in univ(1) ->
  ui.c_pre(ui.wvm(s.vm), abi.wob(objs, abi.cball), ui.G, ui.P, a) ->
  tr.stv(false, startup_specs.start_c_spec_fun(ui.G, ui.P)[seq_one(a)], tr.vw(false, s, objs, ui.wvm(s.vm)), ok(m, exc_val("stop", empty))) ->
  ex V fs. ui.at_main(s, objs, m, a, V, fs)
proof
  fix s objs m a
  assume ha hw hwu hp hst
  let W := tr.vw(false, s, objs, ui.wvm(s.vm))
  let AM := exc_val("at_main", empty)
  obtain m1 w v2 mem2, e1 _ hr ew hv from expand(hst, tr.stv)
  have me _ := apply(ui.ok_inj, e1)
  have wv: W.vm = ui.wvm(s.vm) by rsimp()
  have wo: W.objs = abi.wob(objs, abi.cball) by rsimp()
  have hp2: ui.c_pre(W.vm, W.objs, ui.G, ui.P, a) := rewrite(sym(wv), rewrite(sym(wo), hp))
  have f1 f2 f3 f4 f5 := ui.g_facts
  have q := apply(ui.c_q[g := ui.G, P := ui.P, sp := a, t := W, o := exc(w, AM)], hw, hwu, f1, f2, f3, f4, f5, ha, hp2, hr)
  have c1: sp.ovf_any(W, exc(w, AM)) -> false proof
    assume h
    obtain f v ob, _ _ _ e from expand(h, sp.ovf_any)
    have _ q2 := apply(ui.exc_inj, e)
    have u _ := apply(pair_inj[a := "at_main", b := empty, c := "stack_overflow", d := empty], (pair("at_main", empty) = pair("stack_overflow", empty) by defs(q2, exc_val)))
    show by taut(u, (!("at_main" = "stack_overflow") by eval()))
  qed
  obtain V fs, hV hfr hen hfb hts e from (ex V fs. V in x86_64_linux.Vm && startup_specs.frame(W.vm, V, W.objs, startup_specs.start_writes(ui.G)) &&
    (all x4. x4 in omega -> startup_specs.env_at(W.vm, W.objs, bits_add(64, a, int_mul(8, int_add(gimple.bytes_at(W.vm, a, 8), 2))), x4) ->
       gimple.bytes_at(V, int_add(ui.G.libc, 8), 8) = int_add(bits_add(64, a, int_mul(8, int_add(gimple.bytes_at(W.vm, a, 8), 2))), int_mul(8, int_add(x4, 1)))) &&
    fs in bits(64) && startup_specs.thread_at(ui.G, V, fs) && exc(w, AM) = exc(fn_update(fn_update(W, "vm", V), "fs_base", fs), AM) by taut(q, c1))
  let T := fn_update(fn_update(W, "vm", V), "fs_base", fs)
  have wT _ := apply(ui.exc_inj, e)
  // (the stop's world: T -- its fields m's)
  have qT: tr.vw(false, m1, v2, mem2) = T := trans(sym(ew), wT)
  have k1: mem2 = V := rsimp(apply(ui.app_eq[k := "vm"], qT))
  have k2: m1.fs_base = fs := rsimp(apply(ui.app_eq[k := "fs_base"], qT))
  have k3: m1.os = s.os := rsimp(apply(ui.app_eq[k := "os"], qT))
  have k4: v2 = objs := rsimp(apply(ui.app_eq[k := "live"], apply(ui.app_eq[k := "objs"], qT)))
  have hv2: tr.vok(false, m, objs, V) := rewrite(sym(me), rewrite(k4, rewrite(k1, hv)))
  have r: ui.at_main(s, objs, m, a, V, fs) by defs(taut(hV, rewrite(wv, rewrite(wo, hfr)), rewrite(wv, rewrite(wo, hen)), hfb, hts,
    rewrite(sym(me), k2), rewrite(sym(me), k3), hv2), ui.at_main)
  show by ex_intro({V}, {fs}, r)
qed

// ----------------------------------------------------------------------
//  The world's view at _start_c's entry as exec's memory

// exec's stack [lo, top) with rsp in it, the entry s after _start's steps
def ui.ctx(m0, s, lo, top) := m0 in x86_64_linux.Machine && lo in omega && top in omega && x86_64_linux.stack_pages(m0.vm, lo, top) &&
  int_le(int_mul(lo, x86_64_linux.PAGE), m0.gpr[4]) && int_lt(m0.gpr[4], int_mul(top, x86_64_linux.PAGE)) && int_le(16, m0.gpr[4]) && ui.s5(m0, s)

// (the entry's memory: exec's grown, the return address pushed)
theorem ui.ctx_v1: all m0 s lo top. ui.ctx(m0, s, lo, top) -> ex v1. x86.stk_ext(m0.vm, v1) && abi.vm_grows(m0.vm, v1) &&
  s.vm = fn_update(v1, "bytes", x86_64_linux.store_le(v1.bytes, bits_sub(64, m0.gpr[4], 8), 8, 4198565))
proof
  fix m0 s lo top
  assume hc
  have _ _ _ _ _ _ _ h5 := expand(hc, ui.ctx)
  have _ _ _ _ _ _ _ _ _ _ ev := expand(h5, ui.s5)
  obtain v1, sk vg _ _ ve _ from ev
  show by ex_intro({v1}, taut(sk, vg, ve))
qed

// a page of exec's stack: hidden in the view
theorem ui.w_stack: all m0 s lo top p. ui.ctx(m0, s, lo, top) -> p in omega -> int_le(lo, p) -> int_lt(p, top) -> ui.wvm(s.vm).pages[p] = none
proof
  fix m0 s lo top p
  assume hc hp h1 h2
  have hM _ _ hs _ _ _ _ := expand(hc, ui.ctx)
  have s1 s2 s3 s4 s5 s6 s7 s8 := expand(hs, x86_64_linux.stack_pages)
  obtain v1, _ vg ve from apply(ui.ctx_v1, hc)
  have vg1 _ := expand(vg, abi.vm_grows)
  let PR := fn_update(fn_update(empty, "prot", fn_update(fn_update(fn_update(empty, "r", true), "w", true), "x", false)), "kind", 2)
  have ep: m0.vm.pages[p] = some(PR) := mp(all_elim(s5, {p}), hp, conj(h1, h2))
  have pl: int_lt(p, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) by arith(h2, s2)
  have mq: x86_64_linux.mapped(m0.vm, p) by defs(rsimp(ep, ui.some_nn[x := PR], pl), x86_64_linux.mapped)
  have e2: s.vm.pages[p] = some(PR) by rsimp(ve, trans(mp(all_elim(vg1, {p}), hp, mq), ep))
  have sn: snd(s.vm.pages[p]) = PR := rewrite(sym(e2), ui.snd_some[x := PR])
  have st: abi.stack_page(s.vm, p) by defs(rsimp(e2, ui.snd_some[x := PR], ui.some_nn[x := PR], pl), abi.stack_page, x86_64_linux.mapped)
  have a1 _ := apply(ui.wvm_at[vm := s.vm, p := p], sel(conj(hp, pl)))
  show := mp(a1, st)
qed

// a mapped page below the stack: the view's as exec's
theorem ui.w_low: all m0 s lo top p. ui.ctx(m0, s, lo, top) -> p in omega -> int_lt(p, lo) -> x86_64_linux.mapped(m0.vm, p) -> ui.wvm(s.vm).pages[p] = m0.vm.pages[p]
proof
  fix m0 s lo top p
  assume hc hp h1 hm
  have hM _ _ hs _ _ _ _ := expand(hc, ui.ctx)
  have s1 s2 s3 s4 s5 s6 s7 s8 := expand(hs, x86_64_linux.stack_pages)
  obtain v1, _ vg ve from apply(ui.ctx_v1, hc)
  have vg1 _ := expand(vg, abi.vm_grows)
  have e2: s.vm.pages[p] = m0.vm.pages[p] by rsimp(ve, mp(all_elim(vg1, {p}), hp, hm))
  have nk := mp(all_elim(s6, {p}), hp, conj((int_lt(p, lo) || int_le(top, p) by taut(h1)), hm))
  have ns: !abi.stack_page(s.vm, p) proof
    assume hs2
    have _ k := expand(hs2, abi.stack_page)
    show by taut(nk, rewrite(e2, k))
  qed
  have pl: int_lt(p, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) by taut(expand(hm, x86_64_linux.mapped))
  have _ a2 := apply(ui.wvm_at[vm := s.vm, p := p], sel(conj(hp, pl)))
  show := trans(mp(a2, ns), e2)
qed

// a byte on a page exec mapped, not the pushed return address's: the
// view's as exec's
theorem ui.w_byte: all m0 s lo top a. ui.ctx(m0, s, lo, top) -> a in bits(64) -> x86_64_linux.mapped(m0.vm, x86_64_linux.page_of(a)) ->
  !(int_le(int_sub(m0.gpr[4], 8), a) && int_lt(a, m0.gpr[4])) -> ui.wvm(s.vm).bytes[a] = m0.vm.bytes[a]
proof
  fix m0 s lo top a
  assume hc ha hm hn
  have hM _ _ _ _ _ h16 _ := expand(hc, ui.ctx)
  obtain v1, _ vg ve from apply(ui.ctx_v1, hc)
  have _ vg2 := expand(vg, abi.vm_grows)
  have g0 := apply(x86i.rsp_typed, hM)
  have so: all i. i in omega -> int_lt(i, 8) -> !(bits_add(64, bits_sub(64, m0.gpr[4], 8), bits_of_int(64, i)) = a) proof
    fix i
    assume hi hil
    have bi: bits_of_int(64, i) = i := apply(nf.boi_in[n := 64, x := i], eval(), (i in bits(64) by arith(hi, hil)))
    have e1 := apply(x86.add_nowrap[a := int_sub(m0.gpr[4], 8), b := i], arith(g0, h16), hi, arith(g0, hil))
    have e0: bits_sub(64, m0.gpr[4], 8) = int_sub(m0.gpr[4], 8) by defs(arith(g0, h16), bits_sub, pow2)
    assume q
    have q2: int_add(int_sub(m0.gpr[4], 8), i) = a := rewrite(e1, rewrite(bi, rewrite(e0, q)))
    show by taut(hn, (int_le(int_sub(m0.gpr[4], 8), a) && int_lt(a, m0.gpr[4]) by arith(q2, hi, hil)))
  qed
  have st := apply(x86.store_outside[b := v1.bytes, a := bits_sub(64, m0.gpr[4], 8), n := 8, v := 4198565, c := a], ha, so)
  have e3 := mp(all_elim(vg2, {a}), ha, hm)
  have e0: bits_sub(64, m0.gpr[4], 8) = int_sub(m0.gpr[4], 8) by defs(arith(g0, h16), bits_sub, pow2)
  show by rsimp(ve, st, rewrite(e0, st), e3)
qed

// n bytes at a on pages exec mapped, apart from the pushed return
// address: read in the view as in exec's memory
theorem ui.w_bytes: all m0 s lo top a n. ui.ctx(m0, s, lo, top) -> a in omega -> n in omega -> int_le(int_add(a, n), 18446744073709551616) ->
  (all i. i in omega -> int_lt(i, n) -> x86_64_linux.mapped(m0.vm, int_div(int_add(a, i), x86_64_linux.PAGE)) &&
     !(int_le(int_sub(m0.gpr[4], 8), int_add(a, i)) && int_lt(int_add(a, i), m0.gpr[4]))) ->
  gimple.bytes_at(ui.wvm(s.vm), a, n) = gimple.bytes_at(m0.vm, a, n)
proof
  fix m0 s lo top a n
  assume hc ha hn hl hp
  have pw: all i. i in omega -> int_le(0, i) -> int_lt(i, n) ->
      int_mul(ui.wvm(s.vm).bytes[bits_add(64, a, bits_of_int(64, i))], int_pow(256, i)) = int_mul(m0.vm.bytes[bits_add(64, a, bits_of_int(64, i))], int_pow(256, i)) proof
    fix i
    assume i1 _ i2
    have bi: bits_of_int(64, i) = i := apply(nf.boi_in[n := 64, x := i], eval(), (i in bits(64) by arith(i1, i2, hl, ha)))
    have ea: bits_add(64, a, i) = int_add(a, i) := apply(x86.add_nowrap[a := a, b := i], ha, i1, arith(i2, hl, ha, i1))
    have mq nr := mp(all_elim(hp, {i}), i1, i2)
    have xb: int_add(a, i) in bits(64) by arith(ha, i1, i2, hl)
    have pg: x86_64_linux.page_of(int_add(a, i)) = int_div(int_add(a, i), x86_64_linux.PAGE) by defs(rsimp(xb), x86_64_linux.page_of)
    have eb := apply(ui.w_byte[m0 := m0, s := s, lo := lo, top := top, a := int_add(a, i)], hc, xb, rewrite(sym(pg), mq), nr)
    show := rewrite(sym(bi), rewrite(sym(ea), subst({y. int_mul(ui.wvm(s.vm).bytes[int_add(a, i)], int_pow(256, i)) = int_mul(y, int_pow(256, i))}, eb, refl({int_mul(ui.wvm(s.vm).bytes[int_add(a, i)], int_pow(256, i))}))))
  qed
  have ext := mp(int_sum_ext[a := 0, b := n, f := i. int_mul(ui.wvm(s.vm).bytes[bits_add(64, a, bits_of_int(64, i))], int_pow(256, i)),
    g := i. int_mul(m0.vm.bytes[bits_add(64, a, bits_of_int(64, i))], int_pow(256, i))], eval(), hn, pw)
  show by defs(ext, gimple.bytes_at)
qed

// exec's stack data in the view: the callers' objects
abbrev ui.wob0(r, top) := abi.wob(ui.iobjs(r, top), abi.cball)

theorem ui.us_stack: all m0 s lo top x n w. ui.ctx(m0, s, lo, top) -> x in omega -> n in omega -> int_le(m0.gpr[4], x) ->
  int_le(int_add(x, n), int_mul(top, x86_64_linux.PAGE)) -> gimple.usable(ui.wvm(s.vm), ui.wob0(m0.gpr[4], top), x, n, w)
proof
  fix m0 s lo top x n w
  assume hc hx hn h1 h2
  have hM hlo htop hs hl _ _ _ := expand(hc, ui.ctx)
  have s1 s2 .. := expand(hs, x86_64_linux.stack_pages)
  unfold gimple.usable
  fix i
  assume hi hil
  let p := int_div(int_add(x, i), x86_64_linux.PAGE)
  have po: p in omega by arith(hx, hi)
  have pn := apply(ui.w_stack[m0 := m0, s := s, lo := lo, top := top, p := p], hc, po, arith(hl, h1, hx, hi), arith(h2, hil, hx, hi))
  have nm: !(x86_64_linux.mapped(ui.wvm(s.vm), p) && !(snd(ui.wvm(s.vm).pages[p]).kind = 2)) proof
    assume hh
    have m1 _ := hh
    have _ m2 := expand(m1, x86_64_linux.mapped)
    show by taut(m2, pn)
  qed
  have lt: int_lt(int_add(x, i), int_pow(2, 64)) by arith(h2, hil, hx, hi, s2)
  have li: int_add(x, i) in ui.iobjs(m0.gpr[4], top) by sel(conj((int_add(x, i) in omega by arith(hx, hi)),
    conj((int_le(m0.gpr[4], int_add(x, i)) by arith(h1, hx, hi)), (int_lt(int_add(x, i), int_mul(top, x86_64_linux.PAGE)) by arith(h2, hil, hx, hi)))))
  have lv: int_add(x, i) in ui.wob0(m0.gpr[4], top).live by rsimp(li)
  show := rewrite(sym(mp(ite_f[c := x86_64_linux.mapped(ui.wvm(s.vm), p) && !(snd(ui.wvm(s.vm).pages[p]).kind = 2), a := ite(w, snd(ui.wvm(s.vm).pages[p]).prot.w, snd(ui.wvm(s.vm).pages[p]).prot.r) && int_add(x, i) in ui.wob0(m0.gpr[4], top).c_bytes, b := int_lt(int_add(x, i), int_pow(2, 64)) && int_add(x, i) in ui.wob0(m0.gpr[4], top).live], nm)), conj(lt, lv))
qed

// ----------------------------------------------------------------------
//  The image's pages

// (the loads: the first four program headers)
theorem ui.loads: all j. j in omega -> x86_64_linux.is_load(musl_malloc.file, j) -> j = 0 || j = 1 || j = 2 || j = 3
proof
  fix j
  assume hj hl
  have {pn = phnum, g4 = s4, g5 = s5, g6 = s6, g7 = s7} := ui.elf
  have jl ty := expand(hl, x86_64_linux.is_load)
  have pl: x86_64_linux.PT_LOAD = 1 by defs(eval(), x86_64_linux.PT_LOAD)
  have t4 _ _ _ _ _ := expand(g4, ui.segis)
  have t5 _ _ _ _ _ := expand(g5, ui.segis)
  have t6 _ _ _ _ _ := expand(g6, ui.segis)
  have t7 _ _ _ _ _ := expand(g7, ui.segis)
  have c4: !(j = 4) proof
    assume e
    show by arith(t4, rewrite(e, ty), pl)
  qed
  have c5: !(j = 5) proof
    assume e
    show by arith(t5, rewrite(e, ty), pl)
  qed
  have c6: !(j = 6) proof
    assume e
    show by arith(t6, rewrite(e, ty), pl)
  qed
  have c7: !(j = 7) proof
    assume e
    show by arith(t7, rewrite(e, ty), pl)
  qed
  show by arith(hj, jl, pn, c4, c5, c6, c7)
qed

theorem ui.load_i: all i. i in omega -> int_le(i, 3) -> x86_64_linux.is_load(musl_malloc.file, i)
proof
  fix i
  assume hi hil
  have {pn = phnum, g0 = s0, g1 = s1, g2 = s2, g3 = s3} := ui.elf
  have pl: x86_64_linux.PT_LOAD = 1 by defs(eval(), x86_64_linux.PT_LOAD)
  have t0 _ _ _ _ _ := expand(g0, ui.segis)
  have t1 _ _ _ _ _ := expand(g1, ui.segis)
  have t2 _ _ _ _ _ := expand(g2, ui.segis)
  have t3 _ _ _ _ _ := expand(g3, ui.segis)
  have c: i = 0 || i = 1 || i = 2 || i = 3 by arith(hi, hil)
  have ty: x86_64_linux.le_at(musl_malloc.file, x86_64_linux.ph(musl_malloc.file, i), 4) = 1 proof
    have d0: i = 0 -> x86_64_linux.le_at(musl_malloc.file, x86_64_linux.ph(musl_malloc.file, i), 4) = 1 proof
      assume e
      show := rewrite(sym(e), t0)
    qed
    have d1: i = 1 -> x86_64_linux.le_at(musl_malloc.file, x86_64_linux.ph(musl_malloc.file, i), 4) = 1 proof
      assume e
      show := rewrite(sym(e), t1)
    qed
    have d2: i = 2 -> x86_64_linux.le_at(musl_malloc.file, x86_64_linux.ph(musl_malloc.file, i), 4) = 1 proof
      assume e
      show := rewrite(sym(e), t2)
    qed
    have d3: i = 3 -> x86_64_linux.le_at(musl_malloc.file, x86_64_linux.ph(musl_malloc.file, i), 4) = 1 proof
      assume e
      show := rewrite(sym(e), t3)
    qed
    show by taut(c, d0, d1, d2, d3)
  qed
  show by defs(taut((int_lt(i, x86_64_linux.phnum(musl_malloc.file)) by arith(pn, hil, hi)), trans(ty, sym(pl))), x86_64_linux.is_load)
qed

// (a segment the last on page p: no later load on p)
theorem ui.last_on: all i p. i in omega -> int_le(i, 3) -> x86_64_linux.seg_page(x86_64_linux.segment(musl_malloc.file, i), p) ->
  (all j. j in omega -> int_lt(i, j) -> int_le(j, 3) -> !x86_64_linux.seg_page(x86_64_linux.segment(musl_malloc.file, j), p)) ->
  x86_64_linux.last_on_page(musl_malloc.file, i, p)
proof
  fix i p
  assume hi hil hs hn
  have nl: all x0. x0 in omega -> x86_64_linux.is_load(musl_malloc.file, x0) && int_lt(i, x0) -> !x86_64_linux.seg_page(x86_64_linux.segment(musl_malloc.file, x0), p) proof
    fix j
    assume hj hjl
    have l1 l2 := hjl
    show := mp(all_elim(hn, {j}), hj, l2, (int_le(j, 3) by arith(apply(ui.loads, hj, l1))))
  qed
  show by defs(taut(apply(ui.load_i, hi, hil), hs, nl), x86_64_linux.last_on_page)
qed

// an image page as exec maps it: its segment's protection, not the stack
theorem ui.img_pg: all argv envp m0 i p. x86_64_linux.exec_state(musl_malloc.file, argv, envp, m0) -> i in omega -> p in omega ->
  x86_64_linux.last_on_page(musl_malloc.file, i, p) ->
  m0.vm.pages[p] = some(fn_update(fn_update(empty, "prot", x86_64_linux.seg_prot(x86_64_linux.segment(musl_malloc.file, i))), "kind", 0))
proof
  fix argv envp m0 i p
  assume he hi hp hl
  have il: x86_64_linux.image_loaded(musl_malloc.file, m0.vm) by taut(expand(he, x86_64_linux.exec_state))
  have ip _ := expand(il, x86_64_linux.image_loaded)
  show := mp(all_elim(ip, {i}, {p}), conj(hi, hp), hl)
qed

// (the loads' pages: 1024 the first's, 1025..1029 the text's, 1030 the
// read-only data's, 1031..1032 the data's)
theorem ui.seg_pages: all j p. j in omega -> int_le(j, 3) -> p in omega -> x86_64_linux.seg_page(x86_64_linux.segment(musl_malloc.file, j), p) ->
  (j = 0 && p = 1024) || (j = 1 && int_le(1025, p) && int_le(p, 1029)) || (j = 2 && p = 1030) || (j = 3 && int_le(1031, p) && int_le(p, 1032))
proof
  fix j p
  assume hj hj3 hp hs
  have {g0 = s0, g1 = s1, g2 = s2, g3 = s3} := ui.elf
  have _ _ _ v0 _ m0 := expand(g0, ui.segis)
  have _ _ _ v1 _ m1 := expand(g1, ui.segis)
  have _ _ _ v2 _ m2 := expand(g2, ui.segis)
  have _ _ _ v3 _ m3 := expand(g3, ui.segis)
  have sp := expand(hs, x86_64_linux.seg_page, x86_64_linux.PAGE)
  have c0: j = 0 -> p = 1024 proof
    assume e
    show by arith(rewrite(e, sp), v0, m0, hp)
  qed
  have c1: j = 1 -> int_le(1025, p) && int_le(p, 1029) proof
    assume e
    show by arith(rewrite(e, sp), v1, m1, hp)
  qed
  have c2: j = 2 -> p = 1030 proof
    assume e
    show by arith(rewrite(e, sp), v2, m2, hp)
  qed
  have c3: j = 3 -> int_le(1031, p) && int_le(p, 1032) proof
    assume e
    show by arith(rewrite(e, sp), v3, m3, hp)
  qed
  show by taut(c0, c1, c2, c3, (j = 0 || j = 1 || j = 2 || j = 3 by arith(hj, hj3)))
qed

theorem ui.seg_page_at: all j p. (j = 0 && p = 1024) || (j = 2 && p = 1030) || (j = 3 && int_le(1031, p) && int_le(p, 1032)) ->
  x86_64_linux.seg_page(x86_64_linux.segment(musl_malloc.file, j), p)
proof
  fix j p
  assume h
  have {g0 = s0, g2 = s2, g3 = s3} := ui.elf
  have _ _ _ v0 _ m0 := expand(g0, ui.segis)
  have _ _ _ v2 _ m2 := expand(g2, ui.segis)
  have _ _ _ v3 _ m3 := expand(g3, ui.segis)
  have c0: j = 0 && p = 1024 -> x86_64_linux.seg_page(x86_64_linux.segment(musl_malloc.file, j), p) proof
    assume e
    have e1 e2 := e
    show := rewrite(sym(e1), rewrite(sym(e2), (x86_64_linux.seg_page(x86_64_linux.segment(musl_malloc.file, 0), 1024) by defs(arith(v0, m0), x86_64_linux.seg_page, x86_64_linux.PAGE))))
  qed
  have c2: j = 2 && p = 1030 -> x86_64_linux.seg_page(x86_64_linux.segment(musl_malloc.file, j), p) proof
    assume e
    have e1 e2 := e
    show := rewrite(sym(e1), rewrite(sym(e2), (x86_64_linux.seg_page(x86_64_linux.segment(musl_malloc.file, 2), 1030) by defs(arith(v2, m2), x86_64_linux.seg_page, x86_64_linux.PAGE))))
  qed
  have c3: j = 3 && int_le(1031, p) && int_le(p, 1032) -> x86_64_linux.seg_page(x86_64_linux.segment(musl_malloc.file, j), p) proof
    assume e
    have e1 p1 p2 := e
    show := rewrite(sym(e1), (x86_64_linux.seg_page(x86_64_linux.segment(musl_malloc.file, 3), p) by defs(arith(v3, m3, p1, p2), x86_64_linux.seg_page, x86_64_linux.PAGE)))
  qed
  show by taut(h, c0, c2, c3)
qed

// the first page (the program headers) and the read-only data's: read
// only; the data's: read-write
abbrev ui.PG(r, w) := some(fn_update(fn_update(empty, "prot", fn_update(fn_update(fn_update(empty, "r", r), "w", w), "x", false)), "kind", 0))

theorem ui.pg_img: all argv envp m0 p. x86_64_linux.exec_state(musl_malloc.file, argv, envp, m0) -> p in omega ->
  ((p = 1024 || p = 1030) -> m0.vm.pages[p] = ui.PG(true, false)) && (int_le(1031, p) && int_le(p, 1032) -> m0.vm.pages[p] = ui.PG(true, true))
proof
  fix argv envp m0 p
  assume he hpo
  have {g0 = s0, g2 = s2, g3 = s3} := ui.elf
  have _ f0 _ _ _ _ := expand(g0, ui.segis)
  have _ f2 _ _ _ _ := expand(g2, ui.segis)
  have _ f3 _ _ _ _ := expand(g3, ui.segis)
  // (the last segment on each: no later one there)
  have nl: all i. i in omega -> int_le(i, 3) -> ((i = 0 && p = 1024) || (i = 2 && p = 1030) || (i = 3 && int_le(1031, p) && int_le(p, 1032))) ->
      x86_64_linux.last_on_page(musl_malloc.file, i, p) proof
    fix i
    assume hi hi3 hip
    have later: all j. j in omega -> int_lt(i, j) -> int_le(j, 3) -> !x86_64_linux.seg_page(x86_64_linux.segment(musl_malloc.file, j), p) proof
      fix j
      assume hj hij hj3 hs
      have q := apply(ui.seg_pages[j := j, p := p], hj, hj3, hpo, hs)
      show by arith(q, hip, hij)
    qed
    show := apply(ui.last_on[i := i, p := p], hi, hi3, apply(ui.seg_page_at[j := i, p := p], hip), later)
  qed
  have k1: (p = 1024 || p = 1030) -> m0.vm.pages[p] = ui.PG(true, false) proof
    assume hp
    have c0: p = 1024 -> m0.vm.pages[p] = ui.PG(true, false) proof
      assume e
      have l := mp(all_elim(nl, {0}), eval(), eval(), taut(refl({0}), e))
      have pg := apply(ui.img_pg[argv := argv, envp := envp, m0 := m0, i := 0, p := p], he, eval(), (p in omega by arith(e)), l)
      show by rsimp(pg, f0, x86_64_linux.seg_prot, (bit(4, 2) by eval()), (!bit(4, 1) by eval()), (!bit(4, 0) by eval()))
    qed
    have c2: p = 1030 -> m0.vm.pages[p] = ui.PG(true, false) proof
      assume e
      have l := mp(all_elim(nl, {2}), eval(), eval(), taut(refl({2}), e))
      have pg := apply(ui.img_pg[argv := argv, envp := envp, m0 := m0, i := 2, p := p], he, eval(), (p in omega by arith(e)), l)
      show by rsimp(pg, f2, x86_64_linux.seg_prot, (bit(4, 2) by eval()), (!bit(4, 1) by eval()), (!bit(4, 0) by eval()))
    qed
    show by taut(hp, c0, c2)
  qed
  have k2: int_le(1031, p) && int_le(p, 1032) -> m0.vm.pages[p] = ui.PG(true, true) proof
    assume hp
    have l := mp(all_elim(nl, {3}), eval(), eval(), taut(refl({3}), hp))
    have p1 _ := hp
    have pg := apply(ui.img_pg[argv := argv, envp := envp, m0 := m0, i := 3, p := p], he, eval(), (p in omega by arith(p1)), l)
    show by rsimp(pg, f3, x86_64_linux.seg_prot, (bit(6, 2) by eval()), (bit(6, 1) by eval()), (!bit(6, 0) by eval()))
  qed
  show by taut(k1, k2)
qed

// (an image page startup uses: read only, or the data's read-write)
abbrev ui.img_page(p, w) := (int_le(1031, p) && int_le(p, 1032)) || (!w && (p = 1024 || p = 1030))

// an image page in the view: exec's, readable, writable if the data's
abbrev ui.WI(s, m0, p, w) := x86_64_linux.mapped(ui.wvm(s.vm), p) && !(snd(ui.wvm(s.vm).pages[p]).kind = 2) && snd(ui.wvm(s.vm).pages[p]).prot.r &&
  (w -> snd(ui.wvm(s.vm).pages[p]).prot.w) && ui.wvm(s.vm).pages[p] = m0.vm.pages[p]

theorem ui.w_img: all argv envp m0 s lo top p w. x86_64_linux.exec_state(musl_malloc.file, argv, envp, m0) -> ui.ctx(m0, s, lo, top) -> int_lt(1032, lo) ->
  p in omega -> ui.img_page(p, w) -> ui.WI(s, m0, p, w)
proof
  fix argv envp m0 s lo top p w
  assume he hc hlo hp hi
  have k1 k2 := apply(ui.pg_img[argv := argv, envp := envp, m0 := m0, p := p], he, hp)
  have pl: int_lt(p, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) by arith(hi, (int_lt(1032, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) by eval()))
  have pb: int_lt(p, lo) by arith(hi, hlo)
  have any: all b. m0.vm.pages[p] = ui.PG(true, b) -> (w -> b) -> ui.WI(s, m0, p, w) proof
    fix b
    assume ep hb
    let PR := fn_update(fn_update(empty, "prot", fn_update(fn_update(fn_update(empty, "r", true), "w", b), "x", false)), "kind", 0)
    have mq: x86_64_linux.mapped(m0.vm, p) by defs(rsimp(ep, ui.some_nn[x := PR], pl), x86_64_linux.mapped)
    have ew := apply(ui.w_low[m0 := m0, s := s, lo := lo, top := top, p := p], hc, hp, pb, mq)
    have e2: ui.wvm(s.vm).pages[p] = some(PR) := trans(ew, ep)
    have mw: x86_64_linux.mapped(ui.wvm(s.vm), p) by defs(taut(pl, rewrite(sym(e2), ui.some_nn[x := PR])), x86_64_linux.mapped)
    have sn: snd(ui.wvm(s.vm).pages[p]) = PR := rewrite(sym(e2), ui.snd_some[x := PR])
    have kd: !(snd(ui.wvm(s.vm).pages[p]).kind = 2) := rewrite(sym(sn), (!(PR.kind = 2) by rsimp()))
    have pr: snd(ui.wvm(s.vm).pages[p]).prot.r := rewrite(sym(sn), (PR.prot.r by rsimp()))
    have pw: snd(ui.wvm(s.vm).pages[p]).prot.w = b := rewrite(sym(sn), (PR.prot.w = b by rsimp()))
    have pw2: w -> snd(ui.wvm(s.vm).pages[p]).prot.w proof
      assume hw
      show := rewrite(sym(pw), mp(hb, hw))
    qed
    show by taut(mw, kd, pr, pw2, ew)
  qed
  have c1: int_le(1031, p) && int_le(p, 1032) -> ui.WI(s, m0, p, w) proof
    assume h
    show := mp(all_elim(any, {true}), mp(k2, h), taut())
  qed
  have c2: !w && (p = 1024 || p = 1030) -> ui.WI(s, m0, p, w) proof
    assume h
    have nw h2 := h
    show := mp(all_elim(any, {false}), mp(k1, h2), taut(nw))
  qed
  show by taut(hi, c1, c2)
qed

// bytes on image pages: usable in the view
theorem ui.us_img: all argv envp m0 s lo top x n w. x86_64_linux.exec_state(musl_malloc.file, argv, envp, m0) -> ui.ctx(m0, s, lo, top) -> int_lt(1032, lo) ->
  x in omega -> (all i. i in omega -> int_lt(i, n) -> ui.img_page(int_div(int_add(x, i), x86_64_linux.PAGE), w)) ->
  gimple.usable(ui.wvm(s.vm), ui.wob0(m0.gpr[4], top), x, n, w)
proof
  fix argv envp m0 s lo top x n w
  assume he hc hlo hx hpg
  unfold gimple.usable
  fix i
  assume hi hil
  let p := int_div(int_add(x, i), x86_64_linux.PAGE)
  let V := ui.wvm(s.vm)
  have po: p in omega by arith(hx, hi)
  have mw kd pr pw _ := apply(ui.w_img[argv := argv, envp := envp, m0 := m0, s := s, lo := lo, top := top, p := p, w := w], he, hc, hlo, po, mp(all_elim(hpg, {i}), hi, hil))
  have xo: int_add(x, i) in omega by arith(hx, hi)
  have cb: int_add(x, i) in ui.wob0(m0.gpr[4], top).c_bytes by simp(xo)
  have pv: ite(w, snd(V.pages[p]).prot.w, snd(V.pages[p]).prot.r) proof
    have t1: w -> ite(w, snd(V.pages[p]).prot.w, snd(V.pages[p]).prot.r) proof
      assume hw
      show := rewrite(sym(mp(ite_t[c := w, a := snd(V.pages[p]).prot.w, b := snd(V.pages[p]).prot.r], hw)), mp(pw, hw))
    qed
    have t2: !w -> ite(w, snd(V.pages[p]).prot.w, snd(V.pages[p]).prot.r) proof
      assume hw
      show := rewrite(sym(mp(ite_f[c := w, a := snd(V.pages[p]).prot.w, b := snd(V.pages[p]).prot.r], hw)), pr)
    qed
    show by taut(t1, t2)
  qed
  show := rewrite(sym(mp(ite_t[c := x86_64_linux.mapped(V, p) && !(snd(V.pages[p]).kind = 2), a := ite(w, snd(V.pages[p]).prot.w, snd(V.pages[p]).prot.r) && int_add(x, i) in ui.wob0(m0.gpr[4], top).c_bytes, b := int_lt(int_add(x, i), int_pow(2, 64)) && int_add(x, i) in ui.wob0(m0.gpr[4], top).live], conj(mw, kd))), conj(pv, cb))
qed

// ----------------------------------------------------------------------
//  What startup writes: in the data's pages

// (a span within [L, U))
theorem ui.span_b: all x a n L U. x in set_select(omega, x1. int_le(a, x1) && int_lt(x1, int_add(a, n))) -> int_le(L, a) -> int_le(int_add(a, n), U) ->
  int_le(L, x) && int_lt(x, U)
proof
  fix x a n L U
  assume h h1 h2
  have xo b := unsel(h)
  show by arith(xo, b, h1, h2)
qed

theorem ui.sw_range: all x. x in startup_specs.start_writes(ui.G) -> x in omega && int_le(4227080, x) && int_lt(x, 4228696)
proof
  fix x
  assume h
  rsimp startup_specs.start_writes, startup_specs.span in h
  have xo d := unsel(h)
  let L := 4227080
  let U := 4228696
  have c1 := ui.span_b[x := x, a := c_src_env___libc_start_main.__libc, n := 1, L := L, U := U]
  have c2 := ui.span_b[x := x, a := int_add(c_src_env___libc_start_main.__libc, 8), n := 48, L := L, U := U]
  have c3 := ui.span_b[x := x, a := c_src_env___libc_start_main.__environ, n := 8, L := L, U := U]
  have c4 := ui.span_b[x := x, a := c_src_env___libc_start_main.__hwcap, n := 8, L := L, U := U]
  have c5 := ui.span_b[x := x, a := c_src_env___libc_start_main.__sysinfo, n := 8, L := L, U := U]
  have c6 := ui.span_b[x := x, a := c_src_env___libc_start_main.__progname, n := 8, L := L, U := U]
  have c7 := ui.span_b[x := x, a := c_src_env___libc_start_main.__progname_full, n := 8, L := L, U := U]
  have c8 := ui.span_b[x := x, a := c_src_env___init_tls.__default_stacksize, n := 4, L := L, U := U]
  have c9 := ui.span_b[x := x, a := c_src_env___init_tls.builtin_tls, n := 336, L := L, U := U]
  have c10 := ui.span_b[x := x, a := c_src_env___init_tls.main_tls, n := 48, L := L, U := U]
  have c11 := ui.span_b[x := x, a := c_src_env___stack_chk_fail.__stack_chk_guard, n := 8, L := L, U := U]
  have b: int_le(L, x) && int_lt(x, U) by taut(d, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11,
    (int_le(L, c_src_env___libc_start_main.__libc) by eval()), (int_le(int_add(c_src_env___libc_start_main.__libc, 1), U) by eval()),
    (int_le(L, int_add(c_src_env___libc_start_main.__libc, 8)) by eval()), (int_le(int_add(int_add(c_src_env___libc_start_main.__libc, 8), 48), U) by eval()),
    (int_le(L, c_src_env___libc_start_main.__environ) by eval()), (int_le(int_add(c_src_env___libc_start_main.__environ, 8), U) by eval()),
    (int_le(L, c_src_env___libc_start_main.__hwcap) by eval()), (int_le(int_add(c_src_env___libc_start_main.__hwcap, 8), U) by eval()),
    (int_le(L, c_src_env___libc_start_main.__sysinfo) by eval()), (int_le(int_add(c_src_env___libc_start_main.__sysinfo, 8), U) by eval()),
    (int_le(L, c_src_env___libc_start_main.__progname) by eval()), (int_le(int_add(c_src_env___libc_start_main.__progname, 8), U) by eval()),
    (int_le(L, c_src_env___libc_start_main.__progname_full) by eval()), (int_le(int_add(c_src_env___libc_start_main.__progname_full, 8), U) by eval()),
    (int_le(L, c_src_env___init_tls.__default_stacksize) by eval()), (int_le(int_add(c_src_env___init_tls.__default_stacksize, 4), U) by eval()),
    (int_le(L, c_src_env___init_tls.builtin_tls) by eval()), (int_le(int_add(c_src_env___init_tls.builtin_tls, 336), U) by eval()),
    (int_le(L, c_src_env___init_tls.main_tls) by eval()), (int_le(int_add(c_src_env___init_tls.main_tls, 48), U) by eval()),
    (int_le(L, c_src_env___stack_chk_fail.__stack_chk_guard) by eval()), (int_le(int_add(c_src_env___stack_chk_fail.__stack_chk_guard, 8), U) by eval()))
  show by taut(xo, b)
qed

// ----------------------------------------------------------------------
//  Reading exec's memory

// (n bytes, each the file's at off on: their number the file's)
theorem ui.bytes_file: all vm a F off n. a in omega -> n in omega -> int_le(int_add(a, n), 18446744073709551616) ->
  (all j. j in omega -> int_lt(j, n) -> vm.bytes[bits_of_int(64, int_add(a, j))] = F[int_add(off, j)]) ->
  gimple.bytes_at(vm, a, n) = x86_64_linux.le_at(F, off, n)
proof
  fix vm a F off n
  assume ha hn hl hb
  have pw: all i. i in omega -> int_le(0, i) -> int_lt(i, n) ->
      int_mul(vm.bytes[bits_add(64, a, bits_of_int(64, i))], int_pow(256, i)) = int_mul(F[int_add(off, i)], int_pow(256, i)) proof
    fix i
    assume i1 _ i2
    have bi: bits_of_int(64, i) = i := apply(nf.boi_in[n := 64, x := i], eval(), (i in bits(64) by arith(i1, i2, hl, ha)))
    have ea: bits_add(64, a, i) = int_add(a, i) := apply(x86.add_nowrap[a := a, b := i], ha, i1, arith(i2, hl, ha, i1))
    have bj: bits_of_int(64, int_add(a, i)) = int_add(a, i) := apply(nf.boi_in[n := 64, x := int_add(a, i)], eval(), (int_add(a, i) in bits(64) by arith(i1, i2, hl, ha)))
    have e := rewrite(bj, mp(all_elim(hb, {i}), i1, i2))
    show := rewrite(sym(bi), rewrite(sym(ea), subst({y. int_mul(vm.bytes[int_add(a, i)], int_pow(256, i)) = int_mul(y, int_pow(256, i))}, e, refl({int_mul(vm.bytes[int_add(a, i)], int_pow(256, i))}))))
  qed
  have ext := mp(int_sum_ext[a := 0, b := n, f := i. int_mul(vm.bytes[bits_add(64, a, bits_of_int(64, i))], int_pow(256, i)),
    g := i. int_mul(F[int_add(off, i)], int_pow(256, i))], eval(), hn, pw)
  show by defs(ext, gimple.bytes_at, x86_64_linux.le_at)
qed

// (n zero bytes: the zero sum)
theorem ui.bytes_zero: all vm a n. a in omega -> n in omega -> int_le(int_add(a, n), 18446744073709551616) ->
  (all j. j in omega -> int_lt(j, n) -> vm.bytes[bits_of_int(64, int_add(a, j))] = 0) ->
  gimple.bytes_at(vm, a, n) = int_sum(0, n, i. 0)
proof
  fix vm a n
  assume ha hn hl hb
  have pw: all i. i in omega -> int_le(0, i) -> int_lt(i, n) -> int_mul(vm.bytes[bits_add(64, a, bits_of_int(64, i))], int_pow(256, i)) = 0 proof
    fix i
    assume i1 _ i2
    have bi: bits_of_int(64, i) = i := apply(nf.boi_in[n := 64, x := i], eval(), (i in bits(64) by arith(i1, i2, hl, ha)))
    have ea: bits_add(64, a, i) = int_add(a, i) := apply(x86.add_nowrap[a := a, b := i], ha, i1, arith(i2, hl, ha, i1))
    have bj: bits_of_int(64, int_add(a, i)) = int_add(a, i) := apply(nf.boi_in[n := 64, x := int_add(a, i)], eval(), (int_add(a, i) in bits(64) by arith(i1, i2, hl, ha)))
    have e: vm.bytes[int_add(a, i)] = 0 := rewrite(bj, mp(all_elim(hb, {i}), i1, i2))
    have z: int_mul(0, int_pow(256, i)) = 0 by arith()
    show by rsimp(bi, ea, e, z)
  qed
  have ext := mp(int_sum_ext[a := 0, b := n, f := i. int_mul(vm.bytes[bits_add(64, a, bits_of_int(64, i))], int_pow(256, i)), g := i. 0], eval(), hn, pw)
  show by defs(ext, gimple.bytes_at)
qed

// a byte of exec's stack, from rsp up: on a mapped stack page
theorem ui.stk_mapped: all m0 s lo top x. ui.ctx(m0, s, lo, top) -> x in omega -> int_le(m0.gpr[4], x) -> int_lt(x, int_mul(top, x86_64_linux.PAGE)) ->
  x86_64_linux.mapped(m0.vm, int_div(x, x86_64_linux.PAGE))
proof
  fix m0 s lo top x
  assume hc hx h1 h2
  have hM hlo htop hs hl _ _ _ := expand(hc, ui.ctx)
  have s1 s2 s3 s4 s5 .. := expand(hs, x86_64_linux.stack_pages)
  let p := int_div(x, x86_64_linux.PAGE)
  let PR := fn_update(fn_update(empty, "prot", fn_update(fn_update(fn_update(empty, "r", true), "w", true), "x", false)), "kind", 2)
  have po: p in omega by arith(hx)
  have ep: m0.vm.pages[p] = some(PR) := mp(all_elim(s5, {p}), po, conj((int_le(lo, p) by arith(hl, h1, hx)), (int_lt(p, top) by arith(h2, hx))))
  have pl: int_lt(p, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) by arith(h2, hx, s2)
  show by defs(taut(pl, rewrite(sym(ep), ui.some_nn[x := PR])), x86_64_linux.mapped)
qed

// n bytes of exec's stack from rsp up: read in the view as in exec's memory
theorem ui.w_stk: all m0 s lo top a n. ui.ctx(m0, s, lo, top) -> a in omega -> n in omega -> int_le(m0.gpr[4], a) -> int_le(int_add(a, n), int_mul(top, x86_64_linux.PAGE)) ->
  gimple.bytes_at(ui.wvm(s.vm), a, n) = gimple.bytes_at(m0.vm, a, n)
proof
  fix m0 s lo top a n
  assume hc ha hn h1 h2
  have hM hlo htop hs hl _ _ _ := expand(hc, ui.ctx)
  have s1 s2 .. := expand(hs, x86_64_linux.stack_pages)
  have pi: all i. i in omega -> int_lt(i, n) -> x86_64_linux.mapped(m0.vm, int_div(int_add(a, i), x86_64_linux.PAGE)) &&
      !(int_le(int_sub(m0.gpr[4], 8), int_add(a, i)) && int_lt(int_add(a, i), m0.gpr[4])) proof
    fix i
    assume hi hil
    have mq := apply(ui.stk_mapped[m0 := m0, s := s, lo := lo, top := top, x := int_add(a, i)], hc, arith(ha, hi), arith(h1, ha, hi), arith(h2, hil, ha, hi))
    show by taut(mq, (!(int_lt(int_add(a, i), m0.gpr[4])) by arith(h1, ha, hi)))
  qed
  show := apply(ui.w_bytes[m0 := m0, s := s, lo := lo, top := top, a := a, n := n], hc, ha, hn, arith(h2, s2, hn, ha), pi)
qed

// a word of exec's stack in the view: exec's
theorem ui.w_word: all m0 s lo top a. ui.ctx(m0, s, lo, top) -> a in omega -> int_le(m0.gpr[4], a) -> int_le(int_add(a, 8), int_mul(top, x86_64_linux.PAGE)) ->
  gimple.bytes_at(ui.wvm(s.vm), a, 8) = x86_64_linux.le(m0.vm.bytes, bits_of_int(64, a), 8)
proof
  fix m0 s lo top a
  assume hc ha h1 h2
  have hM _ _ hs .. := expand(hc, ui.ctx)
  have s1 s2 .. := expand(hs, x86_64_linux.stack_pages)
  have bt: m0.vm.bytes in fn_space(bits(64), bits(8)) by simp(expand(apply(x86i.parts, hM).4, x86_64_linux.Vm))
  have ab: bits_of_int(64, a) = a := apply(nf.boi_in[n := 64, x := a], eval(), (a in bits(64) by arith(ha, h2, s2)))
  have e := apply(ui.w_stk[m0 := m0, s := s, lo := lo, top := top, a := a, n := 8], hc, ha, eval(), h1, h2)
  have l8 := mp(x86.le8_nat[vm := m0.vm, a := a], bt)
  show := subst({y. gimple.bytes_at(ui.wvm(s.vm), a, 8) = x86_64_linux.le(m0.vm.bytes, y, 8)}, sym(ab), trans(e, sym(l8)))
qed

// a byte of exec's stack in the view: exec's
theorem ui.w_stk1: all m0 s lo top a. ui.ctx(m0, s, lo, top) -> a in omega -> int_le(m0.gpr[4], a) -> int_lt(a, int_mul(top, x86_64_linux.PAGE)) ->
  gimple.bytes_at(ui.wvm(s.vm), bits_of_int(64, a), 1) = m0.vm.bytes[bits_of_int(64, a)]
proof
  fix m0 s lo top a
  assume hc ha h1 h2
  have hM _ _ hs .. := expand(hc, ui.ctx)
  have s1 s2 .. := expand(hs, x86_64_linux.stack_pages)
  have bt: m0.vm.bytes in fn_space(bits(64), bits(8)) by simp(expand(apply(x86i.parts, hM).4, x86_64_linux.Vm))
  have abt: a in bits(64) by arith(ha, h2, s2)
  have ab: bits_of_int(64, a) = a := apply(nf.boi_in[n := 64, x := a], eval(), abt)
  have e := apply(ui.w_stk[m0 := m0, s := s, lo := lo, top := top, a := a, n := 1], hc, ha, eval(), h1, arith(h2))
  have b1 := apply(ms.bytes1[vm := m0.vm, a := a], bt, abt)
  show := rewrite(sym(ab), trans(e, b1))
qed

// (exec's stack: above what startup writes)
theorem ui.stk_nw: all m0 s lo top x. ui.ctx(m0, s, lo, top) -> int_lt(1032, lo) -> x in omega -> int_le(m0.gpr[4], x) -> !(x in startup_specs.start_writes(ui.G))
proof
  fix m0 s lo top x
  assume hc hlo hx h1 hw
  have _ _ _ _ hl .. := expand(hc, ui.ctx)
  have _ _ b := apply(ui.sw_range[x := x], hw)
  show by arith(hl, hlo, h1, b, hx)
qed

// a string on exec's stack (a zero byte at L): a C string in the view,
// startup writing none of it
theorem ui.cstr_stk: all m0 s lo top q L. ui.ctx(m0, s, lo, top) -> int_lt(1032, lo) -> q in omega -> L in omega ->
  m0.vm.bytes[bits_of_int(64, int_add(q, L))] = 0 -> int_le(m0.gpr[4], q) -> int_le(int_add(q, int_add(L, 1)), int_mul(top, x86_64_linux.PAGE)) ->
  startup_specs.cstr(ui.wvm(s.vm), ui.wob0(m0.gpr[4], top), q, startup_specs.start_writes(ui.G))
proof
  fix m0 s lo top q L
  assume hc hlo hq hL hz h1 h2
  have hM _ _ hs _ _ h16 _ := expand(hc, ui.ctx)
  have s1 s2 .. := expand(hs, x86_64_linux.stack_pages)
  let V := ui.wvm(s.vm)
  have ex0: ex k. k in omega && (int_le(k, L) && m0.vm.bytes[bits_of_int(64, int_add(q, k))] = 0) by ex_intro({L}, taut(hL, (int_le(L, L) by arith(hL)), hz))
  obtain c, co cz cm from mp(nat_least[p := k. int_le(k, L) && m0.vm.bytes[bits_of_int(64, int_add(q, k))] = 0], ex0)
  have cl c0 := cz
  have nz: !(q = 0) by arith(h1, h16)
  have lt: int_lt(int_add(int_add(q, c), 1), int_pow(2, 63)) by arith(h2, cl, co, hq, s2)
  have us := apply(ui.us_stack[m0 := m0, s := s, lo := lo, top := top, x := q, n := int_add(c, 1), w := false], hc, hq, arith(co), h1, arith(h2, cl, co, hq))
  have bn: all i. i in omega -> int_lt(i, c) -> !(gimple.bytes_at(V, bits_of_int(64, int_add(q, i)), 1) = 0) proof
    fix i
    assume hi hic hb
    have e := apply(ui.w_stk1[m0 := m0, s := s, lo := lo, top := top, a := int_add(q, i)], hc, arith(hq, hi), arith(h1, hq, hi), arith(h2, hic, cl, hq, hi, co))
    have z: m0.vm.bytes[bits_of_int(64, int_add(q, i))] = 0 := trans(sym(e), hb)
    have le := mp(all_elim(cm, {i}), hi, conj((int_le(i, L) by arith(hic, cl, hi, co)), z))
    show by arith(le, hic, hi, co)
  qed
  have bz: gimple.bytes_at(V, bits_of_int(64, int_add(q, c)), 1) = 0 :=
    trans(apply(ui.w_stk1[m0 := m0, s := s, lo := lo, top := top, a := int_add(q, c)], hc, arith(hq, co), arith(h1, hq, co), arith(h2, cl, hq, co)), c0)
  have nw: all i. i in omega -> int_le(i, c) -> !(int_add(q, i) in startup_specs.start_writes(ui.G)) proof
    fix i
    assume hi hic
    show := apply(ui.stk_nw[m0 := m0, s := s, lo := lo, top := top, x := int_add(q, i)], hc, hlo, arith(hq, hi), arith(h1, hq, hi))
  qed
  show by defs(ex_intro({c}, taut(co, nz, lt, us, bn, bz, nw)), startup_specs.cstr)
qed

// ----------------------------------------------------------------------
//  The auxiliary vector

// (a pair of exec's vector: aux[key] as musl copies it)
theorem ui.aux_is: all auxv key v. (ex k. k in omega && (int_lt(k, seq_len(auxv)) && auxv[k] = pair(key, v))) -> startup_specs.aux_is(auxv, key, v)
proof
  fix auxv key v
  assume h
  obtain k, ko kl ke from h
  have f: fst(auxv[k]) = key by rsimp(ke)
  have s: snd(auxv[k]) = v by rsimp(ke)
  have e: ex j. j in omega && ((int_lt(j, seq_len(auxv)) && fst(auxv[j]) = key) && snd(auxv[j]) = v) by ex_intro({k}, taut(ko, kl, f, s))
  show by defs(taut(e), startup_specs.aux_is)
qed

// (each key once, but AT_NULL: aux[key] the pair's value)
abbrev ui.auxu(auxv) := all k j. k in omega && j in omega -> (int_lt(k, seq_len(auxv)) && int_lt(j, seq_len(auxv))) && !(k = j) ->
  !(fst(auxv[k]) = fst(auxv[j])) || fst(auxv[k]) = x86_64_linux.AT_NULL

theorem ui.aux_eq: all auxv key q v. ui.auxu(auxv) -> !(key = x86_64_linux.AT_NULL) ->
  (ex k. k in omega && (int_lt(k, seq_len(auxv)) && auxv[k] = pair(key, q))) -> startup_specs.aux_is(auxv, key, v) -> v = q
proof
  fix auxv key q v
  assume hu hn hk ha
  obtain k, ko kl ke from hk
  have fk: fst(auxv[k]) = key by rsimp(ke)
  have sk: snd(auxv[k]) = q by rsimp(ke)
  have c1: (ex j. j in omega && (int_lt(j, seq_len(auxv)) && fst(auxv[j]) = key && snd(auxv[j]) = v)) -> v = q proof
    assume hj
    obtain j, jo jl jf js from hj
    have same: j = k -> v = q proof
      assume e
      show := trans(sym(js), rewrite(sym(e), sk))
    qed
    have dif: !(j = k) -> v = q proof
      assume ne
      have u := mp(all_elim(hu, {j}, {k}), conj(jo, ko), conj(conj(jl, kl), ne))
      have eqf: fst(auxv[j]) = fst(auxv[k]) := trans(jf, sym(fk))
      have nl: !(fst(auxv[j]) = x86_64_linux.AT_NULL) := rewrite(sym(jf), hn)
      show by taut(u, eqf, nl)
    qed
    show by taut(same, dif)
  qed
  have c2: !(ex j. j in omega && (int_lt(j, seq_len(auxv)) && fst(auxv[j]) = key)) -> v = q proof
    assume hn2
    have ek: ex j. j in omega && (int_lt(j, seq_len(auxv)) && fst(auxv[j]) = key) by ex_intro({k}, taut(ko, kl, fk))
    show by taut(hn2, ek)
  qed
  show by taut(expand(ha, startup_specs.aux_is), c1, c2)
qed

// exec's vector (past argc, argv's and envp's words): musl's, its pairs
// read in the view
theorem ui.auxv_view: all m0 s lo top argv envp auxv A. ui.ctx(m0, s, lo, top) -> seq_len(argv) in omega -> seq_len(envp) in omega ->
  auxv in list_type(cart(omega, omega)) -> x86_64_linux.stack_layout(m0.vm, m0.gpr[4], argv, envp, auxv) ->
  x86_64_linux.auxv_ok(musl_malloc.file, m0.vm, m0.os, auxv) -> x86_64_linux.stack_data(m0.vm, m0.gpr[4], int_mul(top, x86_64_linux.PAGE), argv, envp, auxv) ->
  A = int_add(int_add(int_add(m0.gpr[4], 24), int_mul(8, seq_len(argv))), int_mul(8, seq_len(envp))) ->
  startup_specs.auxv_list(ui.wvm(s.vm), ui.wob0(m0.gpr[4], top), A, auxv)
proof
  fix m0 s lo top argv envp auxv A
  assume hc hna hne hla hsl hao hsd hA
  have hM _ _ hs hl _ h16 _ := expand(hc, ui.ctx)
  have s1 s2 .. := expand(hs, x86_64_linux.stack_pages)
  have r0 := apply(x86i.rsp_typed, hM)
  have _ _ _ _ _ aa := expand(hsl, x86_64_linux.stack_layout)
  have l1 aw al an := expand(aa, x86_64_linux.auxv_at, x86_64_linux.u64_at)
  have is1 .. := expand(hsd, x86_64_linux.stack_data)
  have _ ib := expand(is1, x86_64_linux.in_stack)
  have uq := expand(hao, x86_64_linux.auxv_ok).12
  have nl: seq_len(auxv) in omega by defs(simp(expand(hla, list_type)), seq_len)
  let V := ui.wvm(s.vm)
  have c2: int_lt(int_add(A, int_mul(16, seq_len(auxv))), int_pow(2, 63)) by arith(hA, ib, s2, r0, hna, hne, nl)
  have c3: all k. k in omega -> int_lt(k, seq_len(auxv)) -> gimple.usable(V, ui.wob0(m0.gpr[4], top), int_add(A, int_mul(16, k)), 16, false) &&
      gimple.bytes_at(V, bits_of_int(64, int_add(A, int_mul(16, k))), 8) = fst(auxv[k]) &&
      gimple.bytes_at(V, bits_of_int(64, int_add(int_add(A, int_mul(16, k)), 8)), 8) = snd(auxv[k]) proof
    fix k
    assume ko kl
    let X := int_add(A, int_mul(16, k))
    have xo: X in omega by arith(hA, r0, hna, hne, ko)
    have x1: int_le(m0.gpr[4], X) by arith(hA, r0, hna, hne, ko)
    have x2: int_le(int_add(X, 16), int_mul(top, x86_64_linux.PAGE)) by arith(hA, ib, kl, ko, r0, hna, hne, nl)
    have us := apply(ui.us_stack[m0 := m0, s := s, lo := lo, top := top, x := X, n := 16, w := false], hc, xo, eval(), x1, x2)
    have w1 := apply(ui.w_word[m0 := m0, s := s, lo := lo, top := top, a := X], hc, xo, x1, arith(x2))
    have w2 := apply(ui.w_word[m0 := m0, s := s, lo := lo, top := top, a := int_add(X, 8)], hc, arith(xo), arith(x1, xo), arith(x2, xo))
    have b1: bits_of_int(64, X) = X := apply(nf.boi_in[n := 64, x := X], eval(), (X in bits(64) by arith(xo, x2, s2)))
    have b2: bits_of_int(64, int_add(X, 8)) = int_add(X, 8) := apply(nf.boi_in[n := 64, x := int_add(X, 8)], eval(), (int_add(X, 8) in bits(64) by arith(xo, x2, s2)))
    have a1 a2 := rewrite(sym(hA), mp(all_elim(aw, {k}), ko, kl))
    have t1 := subst({y. gimple.bytes_at(V, y, 8) = fst(auxv[k])}, sym(b1), trans(w1, a1))
    have t2 := subst({y. gimple.bytes_at(V, y, 8) = snd(auxv[k])}, sym(b2), trans(w2, a2))
    show by taut(us, t1, t2)
  qed
  have c4: fst(auxv[int_sub(seq_len(auxv), 1)]) = x86_64_linux.AT_NULL by rsimp(al)
  have c6: all k j. k in omega && j in omega -> (int_lt(k, seq_len(auxv)) && int_lt(j, seq_len(auxv))) && fst(auxv[k]) = fst(auxv[j]) -> k = j proof
    fix k j
    assume hkj h
    have ko jo := hkj
    have kl jl e := h
    have d: !(k = j) -> false proof
      assume ne
      have u := mp(all_elim(uq, {k}, {j}), hkj, conj(conj(kl, jl), ne))
      have fk: fst(auxv[k]) = x86_64_linux.AT_NULL by taut(u, e)
      have fj: fst(auxv[j]) = x86_64_linux.AT_NULL := trans(sym(e), fk)
      have nk: !int_lt(int_add(k, 1), seq_len(auxv)) by taut(mp(all_elim(an, {k}), ko), fk)
      have nj: !int_lt(int_add(j, 1), seq_len(auxv)) by taut(mp(all_elim(an, {j}), jo), fj)
      show by arith(nk, nj, kl, jl, ne, ko, jo)
    qed
    show by taut(d)
  qed
  show by defs(taut(l1, c2, c3, c4, an, c6), startup_specs.auxv_list)
qed

// exec's envp (past argc and argv's words): musl's env_at, read in the view
theorem ui.env_view: all m0 s lo top argv envp auxv E. ui.ctx(m0, s, lo, top) -> seq_len(argv) in omega -> seq_len(envp) in omega ->
  auxv in list_type(cart(omega, omega)) -> x86_64_linux.stack_layout(m0.vm, m0.gpr[4], argv, envp, auxv) ->
  x86_64_linux.stack_data(m0.vm, m0.gpr[4], int_mul(top, x86_64_linux.PAGE), argv, envp, auxv) ->
  E = int_add(int_add(m0.gpr[4], 16), int_mul(8, seq_len(argv))) ->
  startup_specs.env_at(ui.wvm(s.vm), ui.wob0(m0.gpr[4], top), E, seq_len(envp))
proof
  fix m0 s lo top argv envp auxv E
  assume hc hna hne hla hsl hsd hE
  have hM _ _ hs hl _ h16 _ := expand(hc, ui.ctx)
  have s1 s2 .. := expand(hs, x86_64_linux.stack_pages)
  have r0 := apply(x86i.rsp_typed, hM)
  have _ _ _ _ z2 _ := expand(hsl, x86_64_linux.stack_layout, x86_64_linux.u64_at)
  have is1 _ ie _ _ := expand(hsd, x86_64_linux.stack_data, x86_64_linux.u64_at)
  have _ ib := expand(is1, x86_64_linux.in_stack)
  have nl: seq_len(auxv) in omega by defs(simp(expand(hla, list_type)), seq_len)
  let V := ui.wvm(s.vm)
  let n := seq_len(envp)
  // (a word of the table: in the view, exec's)
  have wd: all i. i in omega -> int_le(i, n) -> gimple.usable(V, ui.wob0(m0.gpr[4], top), int_add(E, int_mul(8, i)), 8, false) &&
      gimple.bytes_at(V, bits_of_int(64, int_add(E, int_mul(8, i))), 8) = x86_64_linux.le(m0.vm.bytes, bits_of_int(64, int_add(E, int_mul(8, i))), 8) proof
    fix i
    assume io il
    let X := int_add(E, int_mul(8, i))
    have xo: X in omega by arith(hE, r0, hna, io)
    have x1: int_le(m0.gpr[4], X) by arith(hE, r0, hna, io)
    have x2: int_le(int_add(X, 8), int_mul(top, x86_64_linux.PAGE)) by arith(hE, ib, il, io, r0, hna, hne, nl)
    have us := apply(ui.us_stack[m0 := m0, s := s, lo := lo, top := top, x := X, n := 8, w := false], hc, xo, eval(), x1, x2)
    have w1 := apply(ui.w_word[m0 := m0, s := s, lo := lo, top := top, a := X], hc, xo, x1, x2)
    have b1: bits_of_int(64, X) = X := apply(nf.boi_in[n := 64, x := X], eval(), (X in bits(64) by arith(xo, x2, s2)))
    have t1 := subst({y. gimple.bytes_at(V, y, 8) = x86_64_linux.le(m0.vm.bytes, bits_of_int(64, X), 8)}, sym(b1), w1)
    show by taut(us, t1)
  qed
  have c1: !(E = 0) by arith(hE, r0, hna)
  have c2: int_lt(int_add(E, int_mul(8, int_add(n, 2))), int_pow(2, 63)) by arith(hE, ib, s2, r0, hna, hne, nl)
  have c3: all i. i in omega -> int_le(i, n) -> gimple.usable(V, ui.wob0(m0.gpr[4], top), int_add(E, int_mul(8, i)), 8, false) proof
    fix i
    assume io il
    have u _ := mp(all_elim(wd, {i}), io, il)
    show := u
  qed
  have c4: all i. i in omega -> int_lt(i, n) -> !(gimple.bytes_at(V, bits_of_int(64, int_add(E, int_mul(8, i))), 8) = 0) proof
    fix i
    assume io il
    have _ e := mp(all_elim(wd, {i}), io, arith(il))
    have p1 _ := rewrite(sym(hE), mp(all_elim(ie, {i}), io, il))
    assume hz
    have z := trans(sym(e), hz)
    show by arith(rewrite(z, p1), h16)
  qed
  have _ e5 := mp(all_elim(wd, {n}), arith(hne), arith(hne))
  have c5: gimple.bytes_at(V, bits_of_int(64, int_add(E, int_mul(8, n))), 8) = 0 := trans(e5, rewrite(sym(hE), z2))
  show by defs(taut(c1, c2, c3, c4, c5), startup_specs.env_at)
qed

// ----------------------------------------------------------------------
//  The image in the view: startup's globals, the empty string, the
//  program headers, the constructors

// (a stack page: the stack's kind)
theorem ui.sp_kind: all vm p. abi.stack_page(vm, p) -> snd(vm.pages[p]).kind = 2
proof
  fix vm p
  assume h
  have _ k := expand(h, abi.stack_page)
  show := k
qed

// startup's globals: on the data's pages, usable
theorem ui.globals: all argv envp m0 s lo top. x86_64_linux.exec_state(musl_malloc.file, argv, envp, m0) -> ui.ctx(m0, s, lo, top) -> int_lt(1032, lo) ->
  startup_specs.globals_ok(ui.wvm(s.vm), ui.wob0(m0.gpr[4], top), ui.G)
proof
  fix argv envp m0 s lo top
  assume he hc hlo
  let V := ui.wvm(s.vm)
  have c1: all x. x in omega -> x in startup_specs.start_writes(ui.G) -> gimple.usable(V, ui.wob0(m0.gpr[4], top), x, 1, true) &&
      gimple.usable(V, ui.wob0(m0.gpr[4], top), x, 1, false) && x86_64_linux.mapped(V, int_div(x, x86_64_linux.PAGE)) &&
      snd(V.pages[int_div(x, x86_64_linux.PAGE)]).prot.r && snd(V.pages[int_div(x, x86_64_linux.PAGE)]).prot.w &&
      !abi.stack_page(V, int_div(x, x86_64_linux.PAGE)) proof
    fix x
    assume hx hw
    have _ b1 b2 := apply(ui.sw_range[x := x], hw)
    have pg: all w i. i in omega -> int_lt(i, 1) -> ui.img_page(int_div(int_add(x, i), x86_64_linux.PAGE), w) proof
      fix w i
      assume hi hil
      show by arith(hi, hil, b1, b2, hx)
    qed
    have u1 := apply(ui.us_img[argv := argv, envp := envp, m0 := m0, s := s, lo := lo, top := top, x := x, n := 1, w := true], he, hc, hlo, hx, all_elim(pg, {true}))
    have u2 := apply(ui.us_img[argv := argv, envp := envp, m0 := m0, s := s, lo := lo, top := top, x := x, n := 1, w := false], he, hc, hlo, hx, all_elim(pg, {false}))
    have mw kd pr pw _ := apply(ui.w_img[argv := argv, envp := envp, m0 := m0, s := s, lo := lo, top := top, p := int_div(x, x86_64_linux.PAGE), w := true], he, hc, hlo,
      arith(hx), (ui.img_page(int_div(x, x86_64_linux.PAGE), true) by arith(b1, b2, hx)))
    have ns: !abi.stack_page(V, int_div(x, x86_64_linux.PAGE)) proof
      assume h
      show by taut(apply(ui.sp_kind[vm := V, p := int_div(x, x86_64_linux.PAGE)], h), kd)
    qed
    show by taut(u1, u2, mw, pr, mp(pw, taut()), ns)
  qed
  show by defs(taut(c1, (int_lt(int_add(ui.G.libc, 56), int_pow(2, 63)) by eval()), (!(ui.G.builtin_tls = 0) by eval()),
    (int_lt(int_add(ui.G.builtin_tls, 336), int_pow(2, 63)) by eval())), startup_specs.globals_ok)
qed

// (the same page: mapped in both)
theorem ui.mapped_eq: all v1 v2 p. v1.pages[p] = v2.pages[p] -> x86_64_linux.mapped(v1, p) -> x86_64_linux.mapped(v2, p)
proof
  fix v1 v2 p
  assume e h
  have a b := expand(h, x86_64_linux.mapped)
  show by defs(taut(a, rewrite(e, b)), x86_64_linux.mapped)
qed

// n bytes on the image's pages (below its globals' end): read in the
// view as in exec's memory
theorem ui.w_img_bytes: all argv envp m0 s lo top a n. x86_64_linux.exec_state(musl_malloc.file, argv, envp, m0) -> ui.ctx(m0, s, lo, top) -> int_lt(1032, lo) ->
  a in omega -> n in omega -> int_le(int_add(a, n), 4228696) -> (all i. i in omega -> int_lt(i, n) -> ui.img_page(int_div(int_add(a, i), x86_64_linux.PAGE), false)) ->
  gimple.bytes_at(ui.wvm(s.vm), a, n) = gimple.bytes_at(m0.vm, a, n)
proof
  fix argv envp m0 s lo top a n
  assume he hc hlo ha hn hl hpg
  have _ _ _ _ hr .. := expand(hc, ui.ctx)
  have pi: all i. i in omega -> int_lt(i, n) -> x86_64_linux.mapped(m0.vm, int_div(int_add(a, i), x86_64_linux.PAGE)) &&
      !(int_le(int_sub(m0.gpr[4], 8), int_add(a, i)) && int_lt(int_add(a, i), m0.gpr[4])) proof
    fix i
    assume hi hil
    let p := int_div(int_add(a, i), x86_64_linux.PAGE)
    have mw _ _ _ ew := apply(ui.w_img[argv := argv, envp := envp, m0 := m0, s := s, lo := lo, top := top, p := p, w := false], he, hc, hlo, arith(ha, hi),
      mp(all_elim(hpg, {i}), hi, hil))
    have mq := apply(ui.mapped_eq[v1 := ui.wvm(s.vm), v2 := m0.vm, p := p], ew, mw)
    show by taut(mq, (!(int_le(int_sub(m0.gpr[4], 8), int_add(a, i))) by arith(hr, hlo, hl, hil, hi, ha)))
  qed
  show := apply(ui.w_bytes[m0 := m0, s := s, lo := lo, top := top, a := a, n := n], hc, ha, hn, arith(hl), pi)
qed

// a load's bytes at exec: the file's, then zeros (its .bss)
theorem ui.seg_bytes: all argv envp m0 j ty fl of va fs ms. x86_64_linux.exec_state(musl_malloc.file, argv, envp, m0) -> j in omega -> int_le(j, 3) ->
  ui.segis(musl_malloc.file, j, ty, fl, of, va, fs, ms) ->
  (all a. a in omega -> int_le(va, a) -> int_lt(a, int_add(va, fs)) -> m0.vm.bytes[bits_of_int(64, a)] = musl_malloc.file[int_add(of, int_sub(a, va))]) &&
  (all a. a in omega -> int_le(int_add(va, fs), a) -> int_lt(a, int_add(va, ms)) -> m0.vm.bytes[bits_of_int(64, a)] = 0)
proof
  fix argv envp m0 j ty fl of va fs ms
  assume he hj hj3 hg
  have il: x86_64_linux.image_loaded(musl_malloc.file, m0.vm) by taut(expand(he, x86_64_linux.exec_state))
  have _ sb := expand(il, x86_64_linux.image_loaded)
  have sj := mp(all_elim(sb, {j}), hj, apply(ui.load_i[i := j], hj, hj3))
  have _ _ eo ev ef em := expand(hg, ui.segis)
  have d z := rewrite(eo, rewrite(ev, rewrite(ef, rewrite(em, expand(sj, x86_64_linux.segment_bytes)))))
  have d2: all a. a in omega -> int_le(va, a) -> int_lt(a, int_add(va, fs)) -> m0.vm.bytes[bits_of_int(64, a)] = musl_malloc.file[int_add(of, int_sub(a, va))] proof
    fix a
    assume ha h1 h2
    show := mp(all_elim(d, {a}), ha, conj(h1, h2))
  qed
  have z2: all a. a in omega -> int_le(int_add(va, fs), a) -> int_lt(a, int_add(va, ms)) -> m0.vm.bytes[bits_of_int(64, a)] = 0 proof
    fix a
    assume ha h1 h2
    show := mp(all_elim(z, {a}), ha, conj(h1, h2))
  qed
  show by taut(d2, z2)
qed

// libc's TLS fields and the main TLS module: zero (in the .bss)
theorem ui.tls_fresh: all argv envp m0 s lo top. x86_64_linux.exec_state(musl_malloc.file, argv, envp, m0) -> ui.ctx(m0, s, lo, top) -> int_lt(1032, lo) ->
  startup_specs.tls_fresh(ui.wvm(s.vm), ui.G)
proof
  fix argv envp m0 s lo top
  assume he hc hlo
  have {g3 = s3} := ui.elf
  have _ bss := apply(ui.seg_bytes[argv := argv, envp := envp, m0 := m0, j := 3, ty := 1, fl := 6, of := 28616, va := 4227016, fs := 72, ms := 1680], he, eval(), eval(), g3)
  // (n bytes of the .bss at a: zero in the view)
  have zb: all a n. a in omega -> n in omega -> int_le(4227088, a) -> int_le(int_add(a, n), 4228696) ->
      gimple.bytes_at(ui.wvm(s.vm), a, n) = int_sum(0, n, i. 0) proof
    fix a n
    assume ha hn h1 h2
    have pg: all i. i in omega -> int_lt(i, n) -> ui.img_page(int_div(int_add(a, i), x86_64_linux.PAGE), false) proof
      fix i
      assume hi hil
      show by arith(hi, hil, h1, h2, ha)
    qed
    have e1 := apply(ui.w_img_bytes[argv := argv, envp := envp, m0 := m0, s := s, lo := lo, top := top, a := a, n := n], he, hc, hlo, ha, hn, h2, pg)
    have zs: all j. j in omega -> int_lt(j, n) -> m0.vm.bytes[bits_of_int(64, int_add(a, j))] = 0 proof
      fix j
      assume hj hjl
      show := mp(all_elim(bss, {int_add(a, j)}), arith(ha, hj), arith(h1, hj, ha), arith(h2, hjl, hj, ha))
    qed
    show := trans(e1, apply(ui.bytes_zero[vm := m0.vm, a := a, n := n], ha, hn, arith(h2), zs))
  qed
  have l16 := mp(all_elim(zb, {bits_add(64, ui.G.libc, 16)}, {8}), eval(), eval(), eval(), eval())
  have l24 := mp(all_elim(zb, {bits_add(64, ui.G.libc, 24)}, {8}), eval(), eval(), eval(), eval())
  have l32 := mp(all_elim(zb, {bits_add(64, ui.G.libc, 32)}, {8}), eval(), eval(), eval(), eval())
  have l40 := mp(all_elim(zb, {bits_add(64, ui.G.libc, 40)}, {8}), eval(), eval(), eval(), eval())
  have lm := mp(all_elim(zb, {ui.G.main_tls}, {48}), eval(), eval(), eval(), eval())
  have z8: int_sum(0, 8, i. 0) = 0 by eval()
  have z48: int_sum(0, 48, i. 0) = 0 by eval()
  show by defs(taut(trans(l16, z8), trans(l24, z8), trans(l32, z8), trans(l40, z8), trans(lm, z48)), startup_specs.tls_fresh)
qed

// n bytes of a load's file part (on the image's pages): in the view, the
// file's
theorem ui.img_read: all argv envp m0 s lo top j ty fl of va fs ms a n. x86_64_linux.exec_state(musl_malloc.file, argv, envp, m0) -> ui.ctx(m0, s, lo, top) ->
  int_lt(1032, lo) -> j in omega -> int_le(j, 3) -> ui.segis(musl_malloc.file, j, ty, fl, of, va, fs, ms) -> of in omega -> va in omega ->
  a in omega -> n in omega -> int_le(va, a) -> int_le(int_add(a, n), int_add(va, fs)) -> int_le(int_add(a, n), 4228696) ->
  (all i. i in omega -> int_lt(i, n) -> ui.img_page(int_div(int_add(a, i), x86_64_linux.PAGE), false)) ->
  gimple.bytes_at(ui.wvm(s.vm), a, n) = x86_64_linux.le_at(musl_malloc.file, int_add(of, int_sub(a, va)), n)
proof
  fix argv envp m0 s lo top j ty fl of va fs ms a n
  assume he hc hlo hj hj3 hg ho hv ha hn h1 h2 h3 hpg
  have e1 := apply(ui.w_img_bytes[argv := argv, envp := envp, m0 := m0, s := s, lo := lo, top := top, a := a, n := n], he, hc, hlo, ha, hn, h3, hpg)
  have dat _ := apply(ui.seg_bytes[argv := argv, envp := envp, m0 := m0, j := j, ty := ty, fl := fl, of := of, va := va, fs := fs, ms := ms], he, hj, hj3, hg)
  have bf: all i. i in omega -> int_lt(i, n) -> m0.vm.bytes[bits_of_int(64, int_add(a, i))] = musl_malloc.file[int_add(int_add(of, int_sub(a, va)), i)] proof
    fix i
    assume hi hil
    have d := mp(all_elim(dat, {int_add(a, i)}), arith(ha, hi), arith(h1, ha, hi), arith(h2, hil, ha, hi))
    have ix: int_add(of, int_sub(int_add(a, i), va)) = int_add(int_add(of, int_sub(a, va)), i) by arith(ho, hv, ha, hi, h1)
    show := rewrite(ix, d)
  qed
  show := trans(e1, apply(ui.bytes_file[vm := m0.vm, a := a, F := musl_malloc.file, off := int_add(of, int_sub(a, va)), n := n], ha, hn, arith(h3), bf))
qed

// the empty string ("" in the read-only data): a C string startup does
// not write
theorem ui.empty_cstr: all argv envp m0 s lo top. x86_64_linux.exec_state(musl_malloc.file, argv, envp, m0) -> ui.ctx(m0, s, lo, top) -> int_lt(1032, lo) ->
  startup_specs.cstr(ui.wvm(s.vm), ui.wob0(m0.gpr[4], top), ui.G.empty_str, startup_specs.start_writes(ui.G))
