// Startup to main: the claim's open lemma `musl.init` -- from exec's state
// at `_start`, the run to main's entry reaches it with the empty heap's
// invariant (proofs/mallocng/model/empty.core) holding.

// ----------------------------------------------------------------------
//  The claim's run to main as the bridge's run with a stop

// (the claim's loop body: a step until rip = t)
abbrev ui.U(t, l, o) := (!(fst(l).rip = t) && bind_rel(x86_64_linux.step, fst(l), x5 x6. o = ok(pair(x5, empty), empty), x5 x6. o = exc(pair(x5, empty), pair("raise", x6)), x5. o = diverge(x5))) ||
  (!!(fst(l).rip = t) && o = exc(pair(fst(l), empty), pair("brk", empty)))

// the claim's run to t from m0 ending at m, unfolded
def ui.UR(t, m0, m) := ex x0. while_rel(pair(m0, empty), l. true, l o. ui.U(t, l, o), l. fn_update(empty, "os.events", fst(l).os.events), x0) &&
  (((fst(x0) = 0 || (fst(x0) = 1 && fst(out_value(x0)) = "brk")) && m = fst(out_state(x0))) ||
   ((fst(x0) = 1 && fst(out_value(x0)) = "ret") && (m = fst(out_state(x0)) && empty = snd(out_value(x0)))))

theorem ui.until_parts: all t m0 m. runs(claim_malloc.run_until(t), m0, ok(m, empty)) -> ui.UR(t, m0, m)
proof
  fix t m0 m
  assume hr
  show by defs(simp(expand(hr, claim_malloc.run_until)), ui.UR)
qed

// the stopped run's outcomes when the claim's run gets to t at m: the stop
// at m, the discipline broken, or the entry's return reached
def ui.Q(s, m, o) := o = ok(m, exc_val("stop", empty)) || (ex x. o = exc(x, exc_val("disc", empty))) || (ex x. o = ok(x, empty) && tr.at_ret(s, x))

// (the stopped run from l: one of those)
def ui.Z(s, t, m, l) := ex r2 o2. while_rel(l, x. true, x y. tr.rbs(s, t, x, y), x. fn_update(empty, "os.events", fst(x).os.events), r2) &&
  !(fst(r2) = 2) && tr.rmap(r2, o2) && ui.Q(s, m, o2)

// (one pass leaving the stopped run: its result)
theorem ui.z_leave: all s t m l r2 o2. tr.rbs(s, t, l, r2) -> !is_ok(r2) -> !(fst(r2) = 2) -> tr.rmap(r2, o2) -> ui.Q(s, m, o2) -> ui.Z(s, t, m, l)
proof
  fix s t m l r2 o2
  assume hb hn hd hm hq
  have w := apply(while_leave[l0 := l, c := x. true, b := x y. tr.rbs(s, t, x, y), tr := x. fn_update(empty, "os.events", fst(x).os.events), r := r2], rsimp(), hb, hn)
  show by defs(ex_intro({r2}, {o2}, taut(w, hd, hm, hq)), ui.Z)
qed

// (the discipline broken at x: one of those)
theorem ui.q_disc: all s m x. ui.Q(s, m, exc(x, exc_val("disc", empty)))
proof
  fix s m x
  have ex: ex y. exc(x, exc_val("disc", empty)) = exc(y, exc_val("disc", empty)) by ex_intro({x}, refl({exc(x, exc_val("disc", empty))}))
  show by defs(taut(ex), ui.Q)
qed

// (a normal outcome: its state and value)
theorem ui.ok_inj: all a b c d. ok(a, b) = ok(c, d) -> a = c && b = d
proof
  fix a b c d
  assume e
  have _ e2 := apply(pair_inj[a := 0, b := pair(a, b), c := 0, d := pair(c, d)], (pair(0, pair(a, b)) = pair(0, pair(c, d)) by defs(e, ok, tag)))
  show := apply(pair_inj[a := a, b := b, c := c, d := d], e2)
qed

theorem ui.exc_nok: all a v. !is_ok(exc(a, v))
proof
  fix a v
  have n: is_ok(exc(a, v)) -> false proof
    assume h
    obtain x y, h2 from expand(h, is_ok)
    show := rsimp(h2)
  qed
  show by taut(n)
qed

// The claim's run to t from m0 ending at m: a stopped run from m0 (the
// entry s, its return address not t) ends with the stop at m, the
// discipline broken, or at the entry's return -- it takes the claim's
// steps
theorem ui.until_run: all s t m0 m. ui.UR(t, m0, m) -> !(t = x86_64_linux.le(s.vm.bytes, s.gpr[4], 8)) ->
  ex o. tr.run_s(s, t, m0, o) && ui.Q(s, m, o)
proof
  fix s t m0 m
  assume hr hnt
  obtain r, hw hm from expand(hr, ui.UR)
  // (the last pass: rip = t, at m)
  have base: all l. ((!true && r = ok(l, empty)) || (true && ui.U(t, l, r) && !is_ok(r))) -> ui.Z(s, t, m, l) proof
    fix l
    assume hl
    have u nr := (ui.U(t, l, r) && !is_ok(r) by taut(hl))
    have ca: !(fst(l).rip = t) && bind_rel(x86_64_linux.step, fst(l), x5 x6. r = ok(pair(x5, empty), empty), x5 x6. r = exc(pair(x5, empty), pair("raise", x6)), x5. r = diverge(x5)) -> false proof
      assume h
      have _ bd := h
      obtain o, _ oc from expand(bd, bind_rel)
      have c1: (ex s1 v. o = ok(s1, v) && r = ok(pair(s1, empty), empty)) -> false proof
        assume h1
        obtain s1 v, _ er from h1
        have io: is_ok(r) by defs(ex_intro({pair(s1, empty)}, {empty}, er), is_ok)
        show by taut(io, nr)
      qed
      have c2: (ex s1 x. o = exc(s1, x) && r = exc(pair(s1, empty), pair("raise", x))) -> false proof
        assume h2
        obtain s1 x, _ er from h2
        show := rsimp(rewrite(er, hm))
      qed
      have c3: (ex d. o = diverge(d) && r = diverge(d)) -> false proof
        assume h3
        obtain d, _ er from h3
        show := rsimp(rewrite(er, hm))
      qed
      show by taut(oc, c1, c2, c3)
    qed
    have rt er := (fst(l).rip = t && r = exc(pair(fst(l), empty), pair("brk", empty)) by taut(u, ca))
    have em: m = fst(l) := rsimp(rewrite(er, hm))
    have nret: !tr.at_ret(s, fst(l)) proof
      assume h
      have q _ := h
      show by taut(hnt, trans(sym(rt), q))
    qed
    have cs1: int_lt(fst(l).gpr[4], abi.sp(s)) -> ui.Z(s, t, m, l) proof
      assume hlt
      let r2 := exc(l, pair("ret", exc_val("stop", empty)))
      have b: tr.rbs(s, t, l, r2) by defs(taut(rt, nret, hlt, refl({r2})), tr.rbs)
      have rm: tr.rmap(r2, ok(m, exc_val("stop", empty))) by defs(rsimp(em), tr.rmap)
      have q: ui.Q(s, m, ok(m, exc_val("stop", empty))) by defs(taut(refl({ok(m, exc_val("stop", empty))})), ui.Q)
      show := apply(ui.z_leave, b, ui.exc_nok[a := l, v := pair("ret", exc_val("stop", empty))], rsimp(), rm, q)
    qed
    have cs2: !int_lt(fst(l).gpr[4], abi.sp(s)) -> ui.Z(s, t, m, l) proof
      assume hge
      let r2 := exc(l, pair("raise", exc_val("disc", empty)))
      have b: tr.rbs(s, t, l, r2) by defs(taut(nret, hge, refl({r2})), tr.rbs, tr.rbd)
      have rm: tr.rmap(r2, exc(fst(l), exc_val("disc", empty))) by defs(rsimp(), tr.rmap)
      show := apply(ui.z_leave, b, ui.exc_nok[a := l, v := pair("raise", exc_val("disc", empty))], rsimp(), rm, ui.q_disc[s := s, m := m, x := fst(l)])
    qed
    show by taut(cs1, cs2)
  qed
  // (a step: the stopped run takes it too, or leaves there)
  have stp: all l l1. true -> ui.U(t, l, ok(l1, empty)) -> ui.Z(s, t, m, l1) -> ui.Z(s, t, m, l) proof
    fix l l1
    assume _ u z1
    have nb: !(!!(fst(l).rip = t) && ok(l1, empty) = exc(pair(fst(l), empty), pair("brk", empty))) by rsimp()
    have rt bd := (!(fst(l).rip = t) && bind_rel(x86_64_linux.step, fst(l), x5 x6. ok(l1, empty) = ok(pair(x5, empty), empty), x5 x6. ok(l1, empty) = exc(pair(x5, empty), pair("raise", x6)), x5. ok(l1, empty) = diverge(x5)) by taut(u, nb))
    have cs1: !tr.disc_ok(s, fst(l)) -> ui.Z(s, t, m, l) proof
      assume hnd
      let r2 := exc(l, pair("raise", exc_val("disc", empty)))
      have b: tr.rbs(s, t, l, r2) by defs(taut(rt, hnd, refl({r2})), tr.rbs, tr.rbd)
      have rm: tr.rmap(r2, exc(fst(l), exc_val("disc", empty))) by defs(rsimp(), tr.rmap)
      show := apply(ui.z_leave, b, ui.exc_nok[a := l, v := pair("raise", exc_val("disc", empty))], rsimp(), rm, ui.q_disc[s := s, m := m, x := fst(l)])
    qed
    have cs2: tr.disc_ok(s, fst(l)) -> tr.at_ret(s, fst(l)) -> ui.Z(s, t, m, l) proof
      assume hd hret
      let r2 := exc(pair(fst(l), empty), pair("brk", empty))
      have b: tr.rbs(s, t, l, r2) by defs(taut(rt, hd, hret, refl({r2})), tr.rbs, tr.rbd, tr.rb)
      have rm: tr.rmap(r2, ok(fst(l), empty)) by defs(rsimp(), tr.rmap)
      have ex: ex x. ok(fst(l), empty) = ok(x, empty) && tr.at_ret(s, x) by ex_intro({fst(l)}, taut(hret, refl({ok(fst(l), empty)})))
      have q: ui.Q(s, m, ok(fst(l), empty)) by defs(taut(ex), ui.Q)
      show := apply(ui.z_leave, b, ui.exc_nok[a := pair(fst(l), empty), v := pair("brk", empty)], rsimp(), rm, q)
    qed
    have cs3: tr.disc_ok(s, fst(l)) -> !tr.at_ret(s, fst(l)) -> ui.Z(s, t, m, l) proof
      assume hd hnr
      have b: tr.rbs(s, t, l, ok(l1, empty)) by defs(taut(rt, hd, hnr, bd), tr.rbs, tr.rbd, tr.rb)
      obtain r1 o1, w1 d1 m1 q1 from expand(z1, ui.Z)
      have w := apply(while_step[l0 := l, l1 := l1, c := x. true, b := x y. tr.rbs(s, t, x, y), tr := x. fn_update(empty, "os.events", fst(x).os.events), r := r1], rsimp(), b, w1, d1)
      show by defs(ex_intro({r1}, {o1}, taut(w, d1, m1, q1)), ui.Z)
    qed
    show by taut(cs1, cs2, cs3)
  qed
  have nd: !(fst(r) = 2) proof
    assume h2
    show := rsimp(rewrite(h2, hm))
  qed
  have z0 := apply(while_run_ind[l0 := pair(m0, empty), c := l. true, b := l o. ui.U(t, l, o), tr := l. fn_update(empty, "os.events", fst(l).os.events), r := r, z := l. ui.Z(s, t, m, l)], base, stp, hw, nd)
  obtain r2 o2, w2 _ m2 q2 from expand(z0, ui.Z)
  have rs: tr.run_s(s, t, m0, o2) by defs(ex_intro({r2}, taut(w2, m2)), tr.run_s, tr.rws)
  show by ex_intro({o2}, taut(rs, q2))
qed

// The claim's run to t from m0 (not at t) ending at m: its first step
// ends normally, at m1, and the run from m1 ends at m
theorem ui.until_step: all t m0 m. !(m0.rip = t) -> ui.UR(t, m0, m) ->
  ex m1 v. runs(x86_64_linux.step(), m0, ok(m1, v)) && ui.UR(t, m1, m)
proof
  fix t m0 m
  assume hnt hr
  obtain r, hw hm from expand(hr, ui.UR)
  have nd: !(fst(r) = 2) proof
    assume h2
    show := rsimp(rewrite(h2, hm))
  qed
  have u := apply(while_unroll[l0 := pair(m0, empty), c := l. true, b := l o. ui.U(t, l, o), tr := l. fn_update(empty, "os.events", fst(l).os.events), r := r], hw)
  // (the first pass leaving: no step ending so)
  have c1: ui.U(t, pair(m0, empty), r) -> !is_ok(r) -> false proof
    assume hu nr
    have nb: !(!!(fst(pair(m0, empty)).rip = t) && r = exc(pair(fst(pair(m0, empty)), empty), pair("brk", empty))) by rsimp(hnt)
    have bd := (bind_rel(x86_64_linux.step, fst(pair(m0, empty)), x5 x6. r = ok(pair(x5, empty), empty), x5 x6. r = exc(pair(x5, empty), pair("raise", x6)), x5. r = diverge(x5)) by taut(hu, nb))
    obtain o, _ oc from expand(bd, bind_rel)
    have k1: (ex s1 v. o = ok(s1, v) && r = ok(pair(s1, empty), empty)) -> false proof
      assume h1
      obtain s1 v, _ er from h1
      have io: is_ok(r) by defs(ex_intro({pair(s1, empty)}, {empty}, er), is_ok)
      show by taut(io, nr)
    qed
    have k2: (ex s1 x. o = exc(s1, x) && r = exc(pair(s1, empty), pair("raise", x))) -> false proof
      assume h2
      obtain s1 x, _ er from h2
      show := rsimp(rewrite(er, hm))
    qed
    have k3: (ex d. o = diverge(d) && r = diverge(d)) -> false proof
      assume h3
      obtain d, _ er from h3
      show := rsimp(rewrite(er, hm))
    qed
    show by taut(oc, k1, k2, k3)
  qed
  have c2: (ex l1. ui.U(t, pair(m0, empty), ok(l1, empty)) && (ex r1. while_rel(l1, l. true, l o. ui.U(t, l, o), l. fn_update(empty, "os.events", fst(l).os.events), r1) &&
      fst(r1) = fst(r) && (!(fst(r) = 2) -> r1 = r))) ->
      ex m1 v. runs(x86_64_linux.step(), m0, ok(m1, v)) && ui.UR(t, m1, m) proof
    assume h
    obtain l1, hu ex1 from h
    obtain r1, w1 _ e1 from ex1
    have er: r1 = r := mp(e1, nd)
    have nb: !(!!(fst(pair(m0, empty)).rip = t) && ok(l1, empty) = exc(pair(fst(pair(m0, empty)), empty), pair("brk", empty))) by rsimp()
    have bd := (bind_rel(x86_64_linux.step, fst(pair(m0, empty)), x5 x6. ok(l1, empty) = ok(pair(x5, empty), empty), x5 x6. ok(l1, empty) = exc(pair(x5, empty), pair("raise", x6)), x5. ok(l1, empty) = diverge(x5)) by taut(hu, nb))
    obtain o, ho oc from expand(bd, bind_rel)
    have k1: (ex s1 v. o = ok(s1, v) && ok(l1, empty) = ok(pair(s1, empty), empty)) -> ex m1 v. runs(x86_64_linux.step(), m0, ok(m1, v)) && ui.UR(t, m1, m) proof
      assume h1
      obtain s1 v, eo el from h1
      have l1e _ := apply(ui.ok_inj, el)
      have fp: fst(pair(m0, empty)) = m0 by rsimp()
      have rs: runs(x86_64_linux.step(), m0, ok(s1, v)) := rewrite(fp, rewrite(eo, ho))
      have w2 := rewrite(l1e, rewrite(er, w1))
      have g: ex x0. while_rel(pair(s1, empty), l. true, l o. ui.U(t, l, o), l. fn_update(empty, "os.events", fst(l).os.events), x0) &&
          (((fst(x0) = 0 || (fst(x0) = 1 && fst(out_value(x0)) = "brk")) && m = fst(out_state(x0))) ||
           ((fst(x0) = 1 && fst(out_value(x0)) = "ret") && (m = fst(out_state(x0)) && empty = snd(out_value(x0))))) by ex_intro({r}, taut(w2, hm))
      have ru: ui.UR(t, s1, m) by defs(g, ui.UR)
      show by ex_intro({s1}, {v}, taut(rs, ru))
    qed
    have k2: (ex s1 x. o = exc(s1, x) && ok(l1, empty) = exc(pair(s1, empty), pair("raise", x))) -> false proof
      assume h2
      obtain s1 x, _ el from h2
      show := rsimp(el)
    qed
    have k3: (ex d. o = diverge(d) && ok(l1, empty) = diverge(d)) -> false proof
      assume h3
      obtain d, _ el from h3
      show := rsimp(el)
    qed
    show by taut(oc, k1, k2, k3)
  qed
  show by taut(u, c1, c2)
qed

// ----------------------------------------------------------------------
//  The program's file: its numbers read from its bytes

// (a little-endian number of the file's bytes: of its literal's)
def ui.le_b(B, off, n) := int_sum(0, n, x0. int_mul(bytes_at(B, int_add(off, x0)), int_pow(256, x0)))

theorem ui.le_file: all F B off n. F = bytes_seq(B) -> off in omega -> n in omega -> bytes_len(B) in omega -> int_le(int_add(off, n), bytes_len(B)) ->
  x86_64_linux.le_at(F, off, n) = ui.le_b(B, off, n)
proof
  fix F B off n
  assume e ho hn hb hl
  have pw: all i. i in omega -> int_le(0, i) -> int_lt(i, n) -> int_mul(F[int_add(off, i)], int_pow(256, i)) = int_mul(bytes_at(B, int_add(off, i)), int_pow(256, i)) proof
    fix i
    assume hi _ hil
    have m := mp(nat_lt_mem[k := int_add(off, i), n := bytes_len(B)], arith(ho, hi), hb, arith(hil, hl, ho, hi))
    have a := mp(app_fn_build[d := bytes_len(B), v := x. bytes_at(B, x), a := int_add(off, i)], m)
    have ab: F[int_add(off, i)] = bytes_at(B, int_add(off, i)) := rewrite(sym(e), (bytes_seq(B)[int_add(off, i)] = bytes_at(B, int_add(off, i)) by defs(a, bytes_seq)))
    show by rsimp(ab)
  qed
  have s := apply(int_sum_ext[a := 0, b := n, f := i. int_mul(F[int_add(off, i)], int_pow(256, i)), g := i. int_mul(bytes_at(B, int_add(off, i)), int_pow(256, i))], eval(), hn, pw)
  show by defs(s, x86_64_linux.le_at, ui.le_b)
qed

// (... its value, by evaluation)
theorem ui.le_val: all F B off n v. F = bytes_seq(B) -> off in omega -> n in omega -> bytes_len(B) in omega -> int_le(int_add(off, n), bytes_len(B)) ->
  ui.le_b(B, off, n) = v -> x86_64_linux.le_at(F, off, n) = v
proof
  fix F B off n v
  assume e ho hn hb hl hv
  show := trans(apply(ui.le_file, e, ho, hn, hb, hl), hv)
qed

// (program header i: its type and its segment, the values read)
theorem ui.seg_val: all F B i ty fl of va fs ms. F = bytes_seq(B) -> i in omega -> bytes_len(B) in omega -> int_le(int_add(int_add(64, int_mul(56, i)), 48), bytes_len(B)) ->
  ui.le_b(B, 32, 8) = 64 -> ui.le_b(B, int_add(64, int_mul(56, i)), 4) = ty -> ui.le_b(B, int_add(int_add(64, int_mul(56, i)), 4), 4) = fl ->
  ui.le_b(B, int_add(int_add(64, int_mul(56, i)), 8), 8) = of -> ui.le_b(B, int_add(int_add(64, int_mul(56, i)), 16), 8) = va ->
  ui.le_b(B, int_add(int_add(64, int_mul(56, i)), 32), 8) = fs -> ui.le_b(B, int_add(int_add(64, int_mul(56, i)), 40), 8) = ms ->
  type: x86_64_linux.le_at(F, x86_64_linux.ph(F, i), 4) = ty && flags: x86_64_linux.segment(F, i).flags = fl && offset: x86_64_linux.segment(F, i).offset = of &&
  vaddr: x86_64_linux.segment(F, i).vaddr = va && filesz: x86_64_linux.segment(F, i).filesz = fs && memsz: x86_64_linux.segment(F, i).memsz = ms
proof
  fix F B i ty fl of va fs ms
  assume e hi hb hl h0 h1 h2 h3 h4 h5 h6
  let P := int_add(64, int_mul(56, i))
  have po := apply(ui.le_val[F := F, B := B, off := 32, n := 8, v := 64], e, eval(), eval(), hb, arith(hl, hi), h0)
  have pp: x86_64_linux.ph(F, i) = P by defs(rsimp(po), x86_64_linux.ph, x86_64_linux.phoff)
  have q1 := apply(ui.le_val[F := F, B := B, off := P, n := 4, v := ty], e, arith(hi), eval(), hb, arith(hl, hi), h1)
  have q2 := apply(ui.le_val[F := F, B := B, off := int_add(P, 4), n := 4, v := fl], e, arith(hi), eval(), hb, arith(hl, hi), h2)
  have q3 := apply(ui.le_val[F := F, B := B, off := int_add(P, 8), n := 8, v := of], e, arith(hi), eval(), hb, arith(hl, hi), h3)
  have q4 := apply(ui.le_val[F := F, B := B, off := int_add(P, 16), n := 8, v := va], e, arith(hi), eval(), hb, arith(hl, hi), h4)
  have q5 := apply(ui.le_val[F := F, B := B, off := int_add(P, 32), n := 8, v := fs], e, arith(hi), eval(), hb, arith(hl, hi), h5)
  have q6 := apply(ui.le_val[F := F, B := B, off := int_add(P, 40), n := 8, v := ms], e, arith(hi), eval(), hb, arith(hl, hi), h6)
  have k1: x86_64_linux.le_at(F, x86_64_linux.ph(F, i), 4) = ty := rewrite(sym(pp), q1)
  have k2: x86_64_linux.segment(F, i).flags = fl by defs(rsimp(pp, q2), x86_64_linux.segment)
  have k3: x86_64_linux.segment(F, i).offset = of by defs(rsimp(pp, q3), x86_64_linux.segment)
  have k4: x86_64_linux.segment(F, i).vaddr = va by defs(rsimp(pp, q4), x86_64_linux.segment)
  have k5: x86_64_linux.segment(F, i).filesz = fs by defs(rsimp(pp, q5), x86_64_linux.segment)
  have k6: x86_64_linux.segment(F, i).memsz = ms by defs(rsimp(pp, q6), x86_64_linux.segment)
  show by taut(k1, k2, k3, k4, k5, k6)
qed

// program header i of F: its type, its segment
def ui.segis(F, i, ty, fl, of, va, fs, ms) := x86_64_linux.le_at(F, x86_64_linux.ph(F, i), 4) = ty && x86_64_linux.segment(F, i).flags = fl &&
  x86_64_linux.segment(F, i).offset = of && x86_64_linux.segment(F, i).vaddr = va && x86_64_linux.segment(F, i).filesz = fs && x86_64_linux.segment(F, i).memsz = ms

// The program's headers (readelf -l): its 4 loads -- the first page, the
// text, the read-only data, the data and .bss -- and 4 others
theorem ui.elf: phnum: x86_64_linux.phnum(musl_malloc.file) = 8 &&
  s0: ui.segis(musl_malloc.file, 0, 1, 4, 0, 4194304, 512, 512) && s1: ui.segis(musl_malloc.file, 1, 1, 5, 4096, 4198400, 18271, 18271) &&
  s2: ui.segis(musl_malloc.file, 2, 1, 4, 24576, 4218880, 304, 304) && s3: ui.segis(musl_malloc.file, 3, 1, 6, 28616, 4227016, 72, 1680) &&
  s4: ui.segis(musl_malloc.file, 4, 4, 4, 24832, 4219136, 48, 48) && s5: ui.segis(musl_malloc.file, 5, 1685382483, 4, 24832, 4219136, 48, 48) &&
  s6: ui.segis(musl_malloc.file, 6, 1685382481, 6, 0, 0, 0, 0) && s7: ui.segis(musl_malloc.file, 7, 1685382482, 4, 28616, 4227016, 56, 56)
proof
  let F := musl_malloc.file
  have pn := apply(ui.le_val[F := F, off := 56, n := 2, v := 8], unfold(musl_malloc.file), eval(), eval(), eval(),eval(), eval())
  have pp: x86_64_linux.phnum(F) = 8 by defs(pn, x86_64_linux.phnum)
  have k0 := apply(ui.seg_val[F := F, i := 0, ty := 1, fl := 4, of := 0, va := 4194304, fs := 512, ms := 512], unfold(musl_malloc.file), eval(), eval(), eval(),
    eval(), eval(), eval(), eval(), eval(), eval(), eval())
  have k1 := apply(ui.seg_val[F := F, i := 1, ty := 1, fl := 5, of := 4096, va := 4198400, fs := 18271, ms := 18271], unfold(musl_malloc.file), eval(), eval(), eval(),
    eval(), eval(), eval(), eval(), eval(), eval(), eval())
  have k2 := apply(ui.seg_val[F := F, i := 2, ty := 1, fl := 4, of := 24576, va := 4218880, fs := 304, ms := 304], unfold(musl_malloc.file), eval(), eval(), eval(),
    eval(), eval(), eval(), eval(), eval(), eval(), eval())
  have k3 := apply(ui.seg_val[F := F, i := 3, ty := 1, fl := 6, of := 28616, va := 4227016, fs := 72, ms := 1680], unfold(musl_malloc.file), eval(), eval(), eval(),
    eval(), eval(), eval(), eval(), eval(), eval(), eval())
  have k4 := apply(ui.seg_val[F := F, i := 4, ty := 4, fl := 4, of := 24832, va := 4219136, fs := 48, ms := 48], unfold(musl_malloc.file), eval(), eval(), eval(),
    eval(), eval(), eval(), eval(), eval(), eval(), eval())
  have k5 := apply(ui.seg_val[F := F, i := 5, ty := 1685382483, fl := 4, of := 24832, va := 4219136, fs := 48, ms := 48], unfold(musl_malloc.file), eval(), eval(), eval(),
    eval(), eval(), eval(), eval(), eval(), eval(), eval())
  have k6 := apply(ui.seg_val[F := F, i := 6, ty := 1685382481, fl := 6, of := 0, va := 0, fs := 0, ms := 0], unfold(musl_malloc.file), eval(), eval(), eval(),
    eval(), eval(), eval(), eval(), eval(), eval(), eval())
  have k7 := apply(ui.seg_val[F := F, i := 7, ty := 1685382482, fl := 4, of := 28616, va := 4227016, fs := 56, ms := 56], unfold(musl_malloc.file), eval(), eval(), eval(),
    eval(), eval(), eval(), eval(), eval(), eval(), eval())
  have g0: ui.segis(F, 0, 1, 4, 0, 4194304, 512, 512) by defs(k0, ui.segis)
  have g1: ui.segis(F, 1, 1, 5, 4096, 4198400, 18271, 18271) by defs(k1, ui.segis)
  have g2: ui.segis(F, 2, 1, 4, 24576, 4218880, 304, 304) by defs(k2, ui.segis)
  have g3: ui.segis(F, 3, 1, 6, 28616, 4227016, 72, 1680) by defs(k3, ui.segis)
  have g4: ui.segis(F, 4, 4, 4, 24832, 4219136, 48, 48) by defs(k4, ui.segis)
  have g5: ui.segis(F, 5, 1685382483, 4, 24832, 4219136, 48, 48) by defs(k5, ui.segis)
  have g6: ui.segis(F, 6, 1685382481, 6, 0, 0, 0, 0) by defs(k6, ui.segis)
  have g7: ui.segis(F, 7, 1685382482, 4, 28616, 4227016, 56, 56) by defs(k7, ui.segis)
  show by taut(pp, g0, g1, g2, g3, g4, g5, g6, g7)
qed

// ----------------------------------------------------------------------
//  The text as exec loads it

// (no load after the text's on its pages: the read-only data starts at
// page 1030)
theorem ui.later_none: all j p. j in omega -> int_lt(1, j) -> x86_64_linux.is_load(musl_malloc.file, j) -> int_le(p, 1029) ->
  !x86_64_linux.seg_page(x86_64_linux.segment(musl_malloc.file, j), p)
proof
  fix j p
  assume hj h1 hl hp
  let F := musl_malloc.file
  have {pn = phnum, g2 = s2, g3 = s3, g4 = s4, g5 = s5, g6 = s6, g7 = s7} := ui.elf
  have jl ty := expand(hl, x86_64_linux.is_load)
  have pl: x86_64_linux.PT_LOAD = 1 by defs(eval(), x86_64_linux.PT_LOAD)
  have cs: j = 2 || j = 3 || j = 4 || j = 5 || j = 6 || j = 7 by arith(hj, h1, jl, pn)
  have _ _ _ v2 _ m2 := expand(g2, ui.segis)
  have _ _ _ v3 _ m3 := expand(g3, ui.segis)
  have t4 _ _ _ _ _ := expand(g4, ui.segis)
  have t5 _ _ _ _ _ := expand(g5, ui.segis)
  have t6 _ _ _ _ _ := expand(g6, ui.segis)
  have t7 _ _ _ _ _ := expand(g7, ui.segis)
  have c2: j = 2 -> !x86_64_linux.seg_page(x86_64_linux.segment(F, j), p) proof
    assume e
    have n: !x86_64_linux.seg_page(x86_64_linux.segment(F, 2), p) by defs(arith(v2, hp), x86_64_linux.seg_page, x86_64_linux.PAGE)
    show := rewrite(sym(e), n)
  qed
  have c3: j = 3 -> !x86_64_linux.seg_page(x86_64_linux.segment(F, j), p) proof
    assume e
    have n: !x86_64_linux.seg_page(x86_64_linux.segment(F, 3), p) by defs(arith(v3, hp), x86_64_linux.seg_page, x86_64_linux.PAGE)
    show := rewrite(sym(e), n)
  qed
  have c4: !(j = 4) proof
    assume e
    show by arith(t4, rewrite(e, ty), pl)
  qed
  have c5: !(j = 5) proof
    assume e
    show by arith(t5, rewrite(e, ty), pl)
  qed
  have c6: !(j = 6) proof
    assume e
    show by arith(t6, rewrite(e, ty), pl)
  qed
  have c7: !(j = 7) proof
    assume e
    show by arith(t7, rewrite(e, ty), pl)
  qed
  show by taut(cs, c2, c3, c4, c5, c6, c7)
qed

// (the text's pages: 1025 .. 1029, the text segment the last on them)
theorem ui.text_last: all p. p in omega -> int_le(1025, p) -> int_le(p, 1029) -> x86_64_linux.last_on_page(musl_malloc.file, 1, p)
proof
  fix p
  assume hpo h1 h2
  let F := musl_malloc.file
  have {pn = phnum, g1 = s1} := ui.elf
  have t1 _ _ v1 _ m1 := expand(g1, ui.segis)
  have pl: x86_64_linux.PT_LOAD = 1 by defs(eval(), x86_64_linux.PT_LOAD)
  have il: x86_64_linux.is_load(F, 1) by defs(taut((int_lt(1, x86_64_linux.phnum(F)) by arith(pn)), trans(t1, sym(pl))), x86_64_linux.is_load)
  have sp: x86_64_linux.seg_page(x86_64_linux.segment(F, 1), p) by defs(arith(v1, m1, h1, h2), x86_64_linux.seg_page, x86_64_linux.PAGE)
  have nl: all x0. x0 in omega -> x86_64_linux.is_load(F, x0) && int_lt(1, x0) -> !x86_64_linux.seg_page(x86_64_linux.segment(F, x0), p) proof
    fix j
    assume hj hjl
    have l1 l2 := hjl
    show := apply(ui.later_none[j := j, p := p], hj, l2, l1, h2)
  qed
  show by defs(taut(il, sp, nl), x86_64_linux.last_on_page)
qed

theorem ui.load1: x86_64_linux.is_load(musl_malloc.file, 1)
proof
  have {pn = phnum, g1 = s1} := ui.elf
  have t1 _ _ _ _ _ := expand(g1, ui.segis)
  have pl: x86_64_linux.PT_LOAD = 1 by defs(eval(), x86_64_linux.PT_LOAD)
  show by defs(taut((int_lt(1, x86_64_linux.phnum(musl_malloc.file)) by arith(pn)), trans(t1, sym(pl))), x86_64_linux.is_load)
qed

// (a slice of the file at 4096: the text's bytes, compared by evaluation)
theorem ui.code_bytes: all F B T C n. F = bytes_seq(B) -> T = bytes_seq(C) -> bytes_len(C) = n -> bytes_len(B) in omega -> n in omega ->
  int_le(int_add(4096, n), bytes_len(B)) -> (all i. i in bytes_len(C) -> bytes_at(B, int_add(4096, i)) = bytes_at(C, i)) ->
  len: seq_len(T) = n && at: (all i. i in omega -> int_lt(i, n) -> F[int_add(4096, i)] = T[i])
proof
  fix F B T C n
  assume ef et en hb hc0 hl0 hs
  have hc: bytes_len(C) in omega := rewrite(sym(en), hc0)
  have hl: int_le(int_add(4096, bytes_len(C)), bytes_len(B)) := rewrite(sym(en), hl0)
  have l: seq_len(T) = n := trans(rewrite(sym(et), all_elim(tr.bytes_seq_len, {C})), en)
  have a: all i. i in omega -> int_lt(i, n) -> F[int_add(4096, i)] = T[i] proof
    fix i
    assume hi hil0
    have hil: int_lt(i, bytes_len(C)) := rewrite(sym(en), hil0)
    have mc := mp(nat_lt_mem[k := i, n := bytes_len(C)], hi, hc, hil)
    have mb := mp(nat_lt_mem[k := int_add(4096, i), n := bytes_len(B)], arith(hi), hb, arith(hil, hl, hi))
    have fb: F[int_add(4096, i)] = bytes_at(B, int_add(4096, i)) := rewrite(sym(ef),
      (bytes_seq(B)[int_add(4096, i)] = bytes_at(B, int_add(4096, i)) by defs(mp(app_fn_build[d := bytes_len(B), v := x. bytes_at(B, x), a := int_add(4096, i)], mb), bytes_seq)))
    have tc: T[i] = bytes_at(C, i) := rewrite(sym(et), (bytes_seq(C)[i] = bytes_at(C, i) by defs(mp(app_fn_build[d := bytes_len(C), v := x. bytes_at(C, x), a := i], mc), bytes_seq)))
    show := trans(trans(fb, mp(all_elim(hs, {i}), mc)), sym(tc))
  qed
  show by taut(l, a)
qed

theorem ui.text_bytes: len: seq_len(text.code) = 18271 &&
  at: (all i. i in omega -> int_lt(i, 18271) -> musl_malloc.file[int_add(4096, i)] = text.code[i])
proof
  show := apply(ui.code_bytes[F := musl_malloc.file, T := text.code, n := 18271], unfold(musl_malloc.file), unfold(text.code), eval(), eval(), eval(), eval(), eval())
qed

theorem ui.snd_some: all x. snd(some(x)) = x
proof
  fix x
  show by defs(rsimp(), some, tag)
qed

theorem ui.some_nn: all x. !(some(x) = none)
proof
  fix x
  assume e
  have k _ := apply(pair_inj[a := 1, b := x, c := 0, d := empty], (pair(1, x) = pair(0, empty) by defs(e, some, none, tag)))
  show by arith(k)
qed

// The text loaded: at exec, its pages read and execute only, not the
// stack's, its bytes the program's
theorem ui.text_code: all argv envp m0. x86_64_linux.exec_state(musl_malloc.file, argv, envp, m0) -> abi.code_at(m0.vm, 4198400, text.code)
proof
  fix argv envp m0
  assume he
  let F := musl_malloc.file
  have il: x86_64_linux.image_loaded(F, m0.vm) by taut(expand(he, x86_64_linux.exec_state))
  have ip ib := expand(il, x86_64_linux.image_loaded)
  have {tl = len, ta = at} := ui.text_bytes
  have {g1 = s1} := ui.elf
  have _ f1 o1 v1 z1 _ := expand(g1, ui.segis)
  have sb := mp(all_elim(ib, {1}), eval(), ui.load1)
  have sb1 _ := expand(sb, x86_64_linux.segment_bytes)
  unfold abi.code_at
  fix i
  assume hi hil0
  have hil: int_lt(i, 18271) := rewrite(tl, hil0)
  let a := int_add(4198400, i)
  have ab: a in bits(64) by arith(hi, hil)
  have be := apply(nf.boi_in[n := 64, x := a], eval(), ab)
  let p := int_div(a, 4096)
  have po: p in omega by arith(hi)
  have p1: int_le(1025, p) by arith(hi)
  have p2: int_le(p, 1029) by arith(hi, hil)
  have pg: x86_64_linux.page_of(bits_of_int(64, a)) = p by defs(rsimp(be), x86_64_linux.page_of, x86_64_linux.PAGE)
  have pv := mp(all_elim(ip, {1}, {p}), conj((1 in omega by eval()), po), apply(ui.text_last[p := p], po, p1, p2))
  have pr: x86_64_linux.seg_prot(x86_64_linux.segment(F, 1)) = fn_update(fn_update(fn_update(empty, "r", true), "w", false), "x", true)
    by defs(rsimp(f1, (bit(5, 2) by eval()), (!bit(5, 1) by eval()), (bit(5, 0) by eval())), x86_64_linux.seg_prot)
  have pt: int_lt(p, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) by arith(p2)
  have mp1: x86_64_linux.mapped(m0.vm, p) by defs(rsimp(pv, pt, ui.some_nn[x := fn_update(fn_update(empty, "prot", x86_64_linux.seg_prot(x86_64_linux.segment(F, 1))), "kind", 0)]), x86_64_linux.mapped)
  have pga: x86_64_linux.page_of(a) = p by defs(rsimp(), x86_64_linux.page_of, x86_64_linux.PAGE)
  let PG := fn_update(fn_update(empty, "prot", x86_64_linux.seg_prot(x86_64_linux.segment(F, 1))), "kind", 0)
  have sn: snd(m0.vm.pages[p]) = PG := rewrite(sym(pv), ui.snd_some[x := PG])
  have k1: x86_64_linux.fetchable(m0.vm, bits_of_int(64, a)) by defs(rsimp(be, pga, mp1, sn, pr), x86_64_linux.fetchable, x86_64_linux.hw_allows)
  have k2: !x86_64_linux.can_access(m0.vm, bits_of_int(64, a), 1) by defs(rsimp(be, pga, sn, pr), x86_64_linux.can_access, x86_64_linux.hw_allows)
  have k3: !abi.stack_page(m0.vm, x86_64_linux.page_of(bits_of_int(64, a))) by defs(rsimp(be, pga, sn), abi.stack_page)
  have bt := mp(all_elim(sb1, {a}), arith(hi), conj((int_le(x86_64_linux.segment(F, 1).vaddr, a) by arith(v1, hi)),
    (int_lt(a, int_add(x86_64_linux.segment(F, 1).vaddr, x86_64_linux.segment(F, 1).filesz)) by arith(v1, z1, hil))))
  have off: int_add(x86_64_linux.segment(F, 1).offset, int_sub(a, x86_64_linux.segment(F, 1).vaddr)) = int_add(4096, i) by arith(o1, v1, hi)
  have k4: m0.vm.bytes[bits_of_int(64, a)] = text.code[i] := trans(rewrite(off, bt), mp(all_elim(ta, {i}), hi, hil))
  show by taut(k1, k2, k3, k4)
qed
