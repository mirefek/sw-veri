// resetlock (musl mallocng; `movl $0, __malloc_lock(%rip); nop; ret` at
// -O0): C1 under the ABI. The store is to a global: the spec's world and
// the machine write the same bytes.
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core core/records.core \
//     core/list.core core/loop.core build/c_mallocng_malloc.core proofs/x86.core proofs/x86_code.core \
//     build/leaf_steps.core proofs/abi.core proofs/abi_restore.core proofs/abi_glue.core proofs/gimple.core \
//     proofs/abi_stack.core proofs/resetlock.core

abbrev rl.spec := c_src_malloc_mallocng_malloc.resetlock_fun()
// the lock word (__malloc_lock), 0 stored
abbrev rl.store(b) := x86_64_linux.store_le(b, 4227300, 4, 0)
abbrev rl.after(w) := fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", rl.store(app(app(w, "vm"), "bytes"))))
abbrev rl.defined(vm) := gimple.usable(vm, 4227300, 4, true)

theorem rl.fun_ok: all w args x y. w in univ(1) -> args in abi.ARGS -> x in bits(64) -> y in bits(64) -> rl.defined(app(w, "vm")) ->
  app(w, "vm") in x86_64_linux.Vm -> is_fun(w) -> "vm" in dom(w) -> runs(app(rl.spec, args), w, ok(rl.after(w), pair(x, y)))
proof
  fix w
  fix args
  fix x
  fix y
  assume hw: w in univ(1)
  assume hA: args in abi.ARGS
  assume hx: x in bits(64)
  assume hy: y in bits(64)
  assume hu: rl.defined(app(w, "vm"))
  assume hvm: app(w, "vm") in x86_64_linux.Vm
  assume hf: is_fun(w)
  assume hd: "vm" in dom(w)
  have st := apply(g.st32_ok, {w}, {4227300}, {0}, hw, simp(), simp(), simp(), hu, hvm, hf, hd)
  have su := apply(g.store_univ, {app(w, "vm")}, {4227300}, {4}, {0}, hvm)
  have pr: runs(c_src_malloc_mallocng_malloc.resetlock(), w, ok(rl.after(w), empty)) by defs(simp(hw, st, su, keep(gimple.st32)), c_src_malloc_mallocng_malloc.resetlock)
  show by defs(simp(hw, hA, hx, hy, pr, su, keep(c_src_malloc_mallocng_malloc.resetlock)), c_src_malloc_mallocng_malloc.resetlock_fun)
qed

theorem rl.fun_raises: all w args e. w in univ(1) -> e in univ(1) -> args in abi.ARGS -> !rl.defined(app(w, "vm")) -> runs(app(rl.spec, args), w, exc(w, e))
proof
  fix w
  fix args
  fix e
  assume hw: w in univ(1)
  assume he: e in univ(1)
  assume hA: args in abi.ARGS
  assume hn: !rl.defined(app(w, "vm"))
  have st := apply(g.st32_ub, {w}, {4227300}, {0}, {w}, {e}, hw, hw, he, simp(), simp(hn))
  show by defs(simp(hw, he, hA, st, keep(gimple.st32)), c_src_malloc_mallocng_malloc.resetlock_fun)
qed

// the lock word is not where the return address is: different pages (the
// lock's is not a stack page, rsp's is)
theorem rl.far: all vm sp. sp in bits(64) -> abi.stack_page(vm, int_div(sp, 4096)) -> !abi.stack_page(vm, 1032) ->
  int_mod(bits_add(64, sp, 8), 16) = 0 -> int_lt(sp, 140737488355328) ->
  (all k. k in omega -> int_lt(k, 8) -> !int_lt(bits_sub(64, bits_add(64, sp, bits_of_int(64, k)), 4227300), 4))
proof
  fix vm
  fix sp
  assume hsp: sp in bits(64)
  assume hs: abi.stack_page(vm, int_div(sp, 4096))
  assume hn: !abi.stack_page(vm, 1032)
  assume h16: int_mod(bits_add(64, sp, 8), 16) = 0
  assume h47: int_lt(sp, 140737488355328)
  have ne: int_div(sp, 4096) = 1032 -> false proof
    assume e: int_div(sp, 4096) = 1032
    show by taut(rewrite(e, hs), hn)
  qed
  show all k. k in omega -> int_lt(k, 8) -> !int_lt(bits_sub(64, bits_add(64, sp, bits_of_int(64, k)), 4227300), 4) proof
    fix k
    assume k1: k in omega
    assume k2: int_lt(k, 8)
    have pk := apply(abi.ret_pages, {sp}, {k}, hsp, h16, h47, k1, k2)
    have e1: bits_add(64, sp, bits_of_int(64, k)) = int_add(sp, k) by simp(hsp, h47, k1, k2)
    have pd: int_div(int_add(sp, k), 4096) = int_div(sp, 4096) by simp(rewrite(e1, pk))
    have e2: bits_sub(64, int_add(sp, k), 4227300) = int_mod(int_sub(int_add(sp, k), 4227300), 18446744073709551616) by defs(simp(hsp, k1), bits_sub, pow2)
    show by simp(e1, e2, pd, ne, hsp, h47, k1, k2)
  qed
qed

// the machine: the store, then the return (its address as at entry)
theorem resetlock.run(m, o): abi.code_at(app(m, "vm"), 4206146, resetlock.code()) -> app(m, "rip") = 4206146 -> app(app(m, "gpr"), 4) in bits(64) ->
  (all i. i in omega -> int_lt(i, 4) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, 4227300, bits_of_int(64, i)), 1)) ->
  (all i. i in omega -> int_lt(i, 8) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, app(app(m, "gpr"), 4), bits_of_int(64, i)), 0)) ->
  x86_64_linux.le(rl.store(app(app(m, "vm"), "bytes")), app(app(m, "gpr"), 4), 8) = abi.ret(m) ->
  runs(abi.run_to_return(), m, o) ->
  o = ok(fn_update(fn_update(fn_update(m, "vm", fn_update(app(m, "vm"), "bytes", rl.store(app(app(m, "vm"), "bytes")))), "gpr", fn_update(app(m, "gpr"), 4, abi.sp(m))), "rip", abi.ret(m)), empty)
proof
  assume hc: abi.code_at(app(m, "vm"), 4206146, resetlock.code())
  assume hr: app(m, "rip") = 4206146
  assume hsp: app(app(m, "gpr"), 4) in bits(64)
  assume aw: all i. i in omega -> int_lt(i, 4) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, 4227300, bits_of_int(64, i)), 1)
  assume a7: all i. i in omega -> int_lt(i, 8) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, app(app(m, "gpr"), 4), bits_of_int(64, i)), 0)
  assume hk: x86_64_linux.le(rl.store(app(app(m, "vm"), "bytes")), app(app(m, "gpr"), 4), 8) = abi.ret(m)
  assume h: runs(abi.run_to_return(), m, o)
  have r := symex(h, hc, hr, hsp, aw, a7, hk, resetlock.ok_402e42, resetlock.ok_402e4c, resetlock.ok_402e4d)
  show by simp(r, hsp, hk)
qed

// C1: for a program whose static data includes the lock word
theorem rl.implements: all statics. 4227300 in statics -> abi.implements2_at(single(empty), 4206146, rl.spec, 4206146, resetlock.code(), statics)
proof
  fix statics
  assume hst: 4227300 in statics
  have runs: all args s o. args in abi.ARGS -> s in x86_64_linux.Machine -> abi.loaded(app(s, "vm"), 4206146, resetlock.code(), statics) -> app(s, "rip") = 4206146 -> abi.entry_ok(s, args) ->
      runs(abi.run_to_return(), s, o) -> runs(abi.abi_function(single(empty), 4206146, rl.spec, args), s, o) proof
    fix args
    fix s
    fix o
    assume hA: args in abi.ARGS
    assume hM: s in x86_64_linux.Machine
    assume hl: abi.loaded(app(s, "vm"), 4206146, resetlock.code(), statics)
    assume hrip: app(s, "rip") = 4206146
    assume he: abi.entry_ok(s, args)
    assume hr: runs(abi.run_to_return(), s, o)
    have hc: abi.code_at(app(s, "vm"), 4206146, resetlock.code()) by taut(expand(hl, abi.loaded))
    have hp := apply(abi.run_univ, hr)
    have su: s in univ(1) by simp(hp)
    have hsp: app(app(s, "gpr"), 4) in bits(64) by simp(hM)
    have ent := apply(abi.entry_stack, hM, he)
    have sa := apply(abi.ret_access, {app(s, "vm")}, {app(app(s, "gpr"), 4)}, hsp, ent, ent)
    // the lock is not on the stack: the return address stays
    have ls: all x0. x0 in omega -> x0 in statics -> !abi.stack_page(app(s, "vm"), int_div(x0, x86_64_linux.PAGE)) by taut(expand(hl, abi.loaded))
    have nst: !abi.stack_page(app(s, "vm"), 1032) by simp(mp(all_elim(ls, {4227300}), simp(), hst), keep(abi.stack_page))
    have far := apply(rl.far, {app(s, "vm")}, {app(app(s, "gpr"), 4)}, hsp, ent, nst, ent, ent)
    have hk := apply(x86.le_store_far, {app(app(s, "vm"), "bytes")}, {app(app(s, "gpr"), 4)}, {4227300}, {4}, {0}, hsp, simp(), far)
    // the view: the memory as it is
    let w := abi.view(app(s, "vm"), s)
    have wu: w in univ(1) by simp(su)
    have wt: w in abi.World by simp(hM, su)
    have eu: empty in univ(1) by simp()
    // the lock word not writable: the spec raises
    have ub: !rl.defined(app(s, "vm")) -> runs(abi.abi_function(single(empty), 4206146, rl.spec, args), s, o) proof
      assume hn: !rl.defined(app(s, "vm"))
      have fr := apply(rl.fun_raises, wu, eu, hA, simp(hn))
      show := apply(abi.ub_case, {4206146}, {rl.spec}, {args}, {s}, {o}, {app(s, "vm")}, {empty}, hM, simp(hM), simp(su),
        defs(simp(hM), abi.scratch_view), defs(simp(), abi.world_matches), eu, fr, hp, simp(apply(abi.run_shape, hr)))
    qed
    // writable: the store and the return
    have ret: rl.defined(app(s, "vm")) -> runs(abi.abi_function(single(empty), 4206146, rl.spec, args), s, o) proof
      assume hd: rl.defined(app(s, "vm"))
      have aw: all i. i in omega -> int_lt(i, 4) -> x86_64_linux.can_access(app(s, "vm"), bits_add(64, 4227300, bits_of_int(64, i)), 1) proof
        fix i
        assume i1: i in omega
        assume i2: int_lt(i, 4)
        have r := apply(g.usable_write, {app(s, "vm")}, {app(s, "vm")}, {4227300}, {4}, {i}, hd, simp(), simp(), i1, i2)
        have ea: bits_add(64, 4227300, bits_of_int(64, i)) = bits_of_int(64, int_add(4227300, i)) by simp(i1, i2)
        show := rewrite(sym(ea), r)
      qed
      have eo := apply(resetlock.run, hc, hrip, hsp, aw, sa, hk, hr)
      let m1 := fn_update(fn_update(fn_update(s, "vm", fn_update(app(s, "vm"), "bytes", rl.store(app(app(s, "vm"), "bytes")))), "gpr", fn_update(app(s, "gpr"), 4, abi.sp(s))), "rip", abi.ret(s))
      have hp2 := rewrite(eo, hp)
      have m1u: m1 in univ(1) by taut(apply(abi.ok_univ, hp2))
      have m1M: m1 in x86_64_linux.Machine by simp(hM, m1u, x86.store_typed)
      have stu := apply(g.store_univ, {app(s, "vm")}, {4227300}, {4}, {0}, simp(hM))
      have fo := apply(rl.fun_ok, {w}, {args}, {app(app(m1, "gpr"), 0)}, {app(app(m1, "gpr"), 2)}, wu, hA, simp(hM), simp(hM), simp(hd), simp(hM), simp(wt), simp(wt))
      have rc := apply(abi.ret_case, {4206146}, {rl.spec}, {args}, {s}, {m1}, {app(s, "vm")}, {rl.after(w)},
        hM, he, m1M, hp2, simp(hM), simp(su), defs(simp(hM), abi.scratch_view), defs(simp(), abi.world_matches), fo,
        simp(hM, su, wt, wu, stu, x86.store_typed), simp(su, stu), defs(simp(), abi.world_matches),
        simp(), simp(), simp(), simp(), simp(), simp(), simp(), simp(expand(he, abi.entry_ok)))
      show := rewrite(sym(eo), rc)
    qed
    show by taut(ub, ret)
  qed
  show := apply(abi.implements_intro, runs)
qed
