theorem tr.eff_ld64: all w p off. tr.eff(w, o. runs(gimple.ld64(p, off), w, o))
proof
  fix w p off
  have m := all_elim(tr.eff_mem, {w}, {p}, {off}, {8}, {false})
  show by defs(apply(tr.eff_prog, {w}, apply(tr.eff_bind_ret, {w}, m)), gimple.ld64)
