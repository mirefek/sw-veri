// C1's bookkeeping for calls: a callee's spec returns to a world valid for
// GIMPLE (tr.returns_valid), or is undefined there (tr.callee_io). Proven
// from the spec's structure, without search: one lemma per GIMPLE
// combinator and primitive below, composed as the spec is built.
// A call of a callee: from the callee's own tr.callee_io (tr.eff_call).
// Checked after proofs/translate_call.core and proofs/gimple_inv.core.

// ---------------------------------------------------------------------
//  Validity kept

theorem tr.rv_refl: all w. tr.returns_valid(w, w)
proof
  fix w
  have l: all gb gc st. gb in omega -> abi.loaded(app(w, "vm"), gb, gc, st) -> abi.loaded(app(w, "vm"), gb, gc, st) proof
    fix gb gc st
    assume _ h
    show := h
  qed
  show by defs(taut(refl({app(app(w, "os"), "input")}), subset_refl[s := app(app(w, "os"), "events")], l, refl({app(w, "cpu")})), tr.returns_valid)
qed

theorem tr.rv_trans: all a b c. tr.returns_valid(a, b) -> tr.returns_valid(b, c) -> tr.returns_valid(a, c)
proof
  fix a b c
  assume h1 h2
  have i1 e1 l1 c1 := expand(h1, tr.returns_valid)
  have i2 e2 l2 c2 := expand(h2, tr.returns_valid)
  have ez: all z. z in app(app(a, "os"), "events") -> z in app(app(c, "os"), "events") proof
    fix z
    assume hz
    have zb := mp(subset_elim[a := app(app(a, "os"), "events"), b := app(app(b, "os"), "events"), z := z], e1, hz)
    show := mp(subset_elim[a := app(app(b, "os"), "events"), b := app(app(c, "os"), "events"), z := z], e2, zb)
  qed
  have e: subset(app(app(a, "os"), "events"), app(app(c, "os"), "events")) by defs(ez, subset)
  have l: all gb gc st. gb in omega -> abi.loaded(app(a, "vm"), gb, gc, st) -> abi.loaded(app(c, "vm"), gb, gc, st) proof
    fix gb gc st
    assume hg hl
    show := mp(all_elim(l2, {gb}, {gc}, {st}), hg, mp(all_elim(l1, {gb}, {gc}, {st}), hg, hl))
  qed
  show by defs(taut(trans(i2, i1), e, l, trans(c2, c1)), tr.returns_valid)
qed

// ---------------------------------------------------------------------
//  Effects: the outcomes r(o) of a program run from w

// every return keeps the world valid, or every exception is allowed (the
// program is undefined from w)
def tr.eff(w, o. r) := (all w2 v. r(ok(w2, v)) -> tr.returns_valid(w, w2)) || (all x e. x in univ(1) -> e in univ(1) -> r(exc(x, e)))

// a return in the state it started from
theorem tr.eff_ret: all w v. tr.eff(w, o. o = ok(w, v))
proof
  fix w v
  have g: all w2 r. ok(w2, r) = ok(w, v) -> tr.returns_valid(w, w2) proof
    fix w2 r
    assume h
    have e: w2 = w by simp(h)
    show := rewrite(sym(e), all_elim(tr.rv_refl, {w}), {2})
  qed
  show by defs(taut(g), tr.eff)
qed

// sequencing: p, then k on its return (exceptions and divergence passed on)
theorem tr.eff_bind(p, s1 v o. k): all w. tr.eff(w, o. runs(p, w, o)) -> (all s1 v. runs(p, w, ok(s1, v)) -> tr.eff(s1, o. k(s1, v, o))) ->
  tr.eff(w, o. bind_rel(p, w, s1 v. k(s1, v, o), s1 e. o = exc(s1, e), t. o = diverge(t)))
proof
  fix w
  assume hp hk
  let B(o) := bind_rel(p, w, s1 v. k(s1, v, o), s1 e. o = exc(s1, e), t. o = diverge(t))
  // p undefined: so is the sequence
  have ua: (all x e. x in univ(1) -> e in univ(1) -> runs(p, w, exc(x, e))) -> (all x e. x in univ(1) -> e in univ(1) -> B(exc(x, e))) proof
    assume hu
    fix x e
    assume hx he
    have r := mp(all_elim(hu, {x}, {e}), hx, he)
    show by defs(ex_intro({exc(x, e)}, simp(r)), bind_rel)
  qed
  // a return of p after which k is undefined: so is the sequence
  have ub: (ex s1 v. runs(p, w, ok(s1, v)) && (all x e. x in univ(1) -> e in univ(1) -> k(s1, v, exc(x, e)))) ->
      (all x e. x in univ(1) -> e in univ(1) -> B(exc(x, e))) proof
    assume h
    obtain s1 v, hr hu from h
    fix x e
    assume hx he
    have kx := mp(all_elim(hu, {x}, {e}), hx, he)
    show by defs(ex_intro({ok(s1, v)}, simp(hr, kx)), bind_rel)
  qed
  // otherwise every return is valid: p's, then k's
  have uc: (all w2 v. runs(p, w, ok(w2, v)) -> tr.returns_valid(w, w2)) ->
      !(ex s1 v. runs(p, w, ok(s1, v)) && (all x e. x in univ(1) -> e in univ(1) -> k(s1, v, exc(x, e)))) ->
      (all w2 r. B(ok(w2, r)) -> tr.returns_valid(w, w2)) proof
    assume hv hn
    fix w2 r
    assume hb
    obtain o1, hr1 hc from expand(hb, bind_rel)
    have c1: (ex s1 v. o1 = ok(s1, v) && k(s1, v, ok(w2, r))) -> tr.returns_valid(w, w2) proof
      assume e1
      obtain s1 v, eo ko from e1
      have r1 := rewrite(eo, hr1)
      have ek := expand(mp(all_elim(hk, {s1}, {v}), r1), tr.eff)
      have nu: (all x e. x in univ(1) -> e in univ(1) -> k(s1, v, exc(x, e))) -> false proof
        assume hu
        have ex: ex s1 v. runs(p, w, ok(s1, v)) && (all x e. x in univ(1) -> e in univ(1) -> k(s1, v, exc(x, e))) by ex_intro({s1}, {v}, taut(r1, hu))
        show by taut(hn, ex)
      qed
      have kv: all w3 v3. k(s1, v, ok(w3, v3)) -> tr.returns_valid(s1, w3) by taut(ek, nu)
      have rv2 := mp(all_elim(kv, {w2}, {r}), ko)
      have rv1 := mp(all_elim(hv, {s1}, {v}), r1)
      show := mp(all_elim(tr.rv_trans, {w}, {s1}, {w2}), rv1, rv2)
    qed
    have c2: (ex s1 e. o1 = exc(s1, e) && ok(w2, r) = exc(s1, e)) -> tr.returns_valid(w, w2) proof
      assume e2
      obtain s1 e, _ ee from e2
      show by simp(ee)
    qed
    have c3: (ex t. o1 = diverge(t) && ok(w2, r) = diverge(t)) -> tr.returns_valid(w, w2) proof
      assume e3
      obtain t, _ ee from e3
      show by simp(ee)
    qed
    show by taut(hc, c1, c2, c3)
  qed
  have ep := expand(hp, tr.eff)
  show by defs(taut(ep, ua, ub, uc), tr.eff)
qed

// a choice: each choice's effect (no choice possible: undefined)
theorem tr.eff_any(x. d, x o. k): all w. (all x. d(x) -> tr.eff(w, o. k(x, o))) -> tr.eff(w, o. any_rel(x. d(x), x. k(x, o)))
proof
  fix w
  assume hk
  // nothing to choose: anything
  have ua: !(ex x. d(x)) -> (all y e. y in univ(1) -> e in univ(1) -> any_rel(x. d(x), x. k(x, exc(y, e)))) proof
    assume hn
    fix y e
    assume _ _
    show by defs(taut(hn), any_rel)
  qed
  // a choice after which k is undefined: so is the whole
  have ub: (ex x. d(x) && (all y e. y in univ(1) -> e in univ(1) -> k(x, exc(y, e)))) ->
      (all y e. y in univ(1) -> e in univ(1) -> any_rel(x. d(x), x. k(x, exc(y, e)))) proof
    assume h
    obtain x, hd hu from h
    fix y e
    assume hy he
    have kx := mp(all_elim(hu, {y}, {e}), hy, he)
    show by defs(taut(((ex x. d(x) && k(x, exc(y, e))) by ex_intro({x}, taut(hd, kx)))), any_rel)
  qed
  // otherwise every return is valid: the chosen one's
  have uc: (ex x. d(x)) -> !(ex x. d(x) && (all y e. y in univ(1) -> e in univ(1) -> k(x, exc(y, e)))) ->
      (all w2 r. any_rel(x. d(x), x. k(x, ok(w2, r))) -> tr.returns_valid(w, w2)) proof
    assume hd0 hn
    fix w2 r
    assume ha
    have ha2 := expand(ha, any_rel)
    have c: (ex x. d(x) && k(x, ok(w2, r))) -> tr.returns_valid(w, w2) proof
      assume e1
      obtain x, hd kx from e1
      have ek := expand(mp(all_elim(hk, {x}), hd), tr.eff)
      have nu: (all y e. y in univ(1) -> e in univ(1) -> k(x, exc(y, e))) -> false proof
        assume hu
        have ex: ex x. d(x) && (all y e. y in univ(1) -> e in univ(1) -> k(x, exc(y, e))) by ex_intro({x}, taut(hd, hu))
        show by taut(hn, ex)
      qed
      have kv: all w3 v3. k(x, ok(w3, v3)) -> tr.returns_valid(w, w3) by taut(ek, nu)
      show := mp(all_elim(kv, {w2}, {r}), kx)
    qed
    show by taut(ha2, hd0, c)
  qed
  show by defs(taut(ua, ub, uc), tr.eff)
qed

// a guard: when it holds, the program's effect
theorem tr.eff_guard(c, o. r): all w. c -> tr.eff(w, o. r(o)) -> tr.eff(w, o. !c || r(o))
proof
  fix w
  assume hc he
  have e := expand(he, tr.eff)
  have a1: (all w2 v. r(ok(w2, v)) -> tr.returns_valid(w, w2)) -> (all w2 v. !c || r(ok(w2, v)) -> tr.returns_valid(w, w2)) proof
    assume h
    fix w2 v
    assume g
    show := mp(all_elim(h, {w2}, {v}), (r(ok(w2, v)) by taut(g, hc)))
  qed
  have a2: (all x e. x in univ(1) -> e in univ(1) -> r(exc(x, e))) -> (all x e. x in univ(1) -> e in univ(1) -> !c || r(exc(x, e))) proof
    assume h
    fix x e
    assume hx he2
    show by taut(mp(all_elim(h, {x}, {e}), hx, he2))
  qed
  show by defs(taut(e, a1, a2), tr.eff)
qed

// a program: its relation's effect from w (from a w outside univ(1), it
// has no runs at all)
theorem tr.eff_prog(x0 o. r): all w. tr.eff(w, o. r(w, o)) -> tr.eff(w, o. runs(mkprog(x0 o. r(x0, o)), w, o))
proof
  fix w
  assume he
  have e := expand(he, tr.eff)
  have a1: (all w2 v. r(w, ok(w2, v)) -> tr.returns_valid(w, w2)) -> (all w2 v. runs(mkprog(x0 o. r(x0, o)), w, ok(w2, v)) -> tr.returns_valid(w, w2)) proof
    assume h
    fix w2 v
    assume g
    show := mp(all_elim(h, {w2}, {v}), (r(w, ok(w2, v)) by simp(g)))
  qed
  have a2: w in univ(1) -> (all x e. x in univ(1) -> e in univ(1) -> r(w, exc(x, e))) -> (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 o. r(x0, o)), w, exc(x, e))) proof
    assume hw h
    fix x e
    assume hx hy
    have rx := mp(all_elim(h, {x}, {e}), hx, hy)
    show by simp(hw, hx, hy, rx)
  qed
  // (no runs from a w outside univ(1))
  have a3: !(w in univ(1)) -> (all w2 v. runs(mkprog(x0 o. r(x0, o)), w, ok(w2, v)) -> tr.returns_valid(w, w2)) proof
    assume hn
    fix w2 v
    assume g
    have m := expand(g, runs, mkprog)
    have pu: pair(w, ok(w2, v)) in univ(1) by taut(set_select_def[s := univ(1), p := z. ex s o. z = pair(s, o) && r(s, o), z := pair(w, ok(w2, v))], m)
    have hw: w in univ(1) by simp(pu)
    show by taut(hn, hw)
  qed
  show by defs(taut(e, a1, a2, a3), tr.eff)
qed

// `undefined if c; ..`: c is anything (every exception: a raise as the
// first statement's outcome); else the rest from the same state
theorem tr.eff_undef_if(c, s o. k): all w. (!c -> tr.eff(w, o. k(w, o))) ->
  tr.eff(w, o. ex x2. (c || (!c && x2 = ok(pair(w, empty), empty))) && ((fst(x2) = 0 && k(fst(out_state(x2)), o)) ||
    ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && o = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
      ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && o = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && o = diverge(snd(x2))))))
proof
  fix w
  assume hk
  let Q(o) := ex x2. (c || (!c && x2 = ok(pair(w, empty), empty))) && ((fst(x2) = 0 && k(fst(out_state(x2)), o)) ||
    ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && o = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
      ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && o = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && o = diverge(snd(x2)))))
  // undefined: a raise as the first statement's outcome
  have ua: c -> (all x e. x in univ(1) -> e in univ(1) -> Q(exc(x, e))) proof
    assume hc
    fix x e
    assume _ _
    show by ex_intro({exc(pair(x, empty), pair("raise", e))}, simp(hc))
  qed
  // defined: the rest, from w
  have ub: !c -> (all x e. x in univ(1) -> e in univ(1) -> k(w, exc(x, e))) -> (all x e. x in univ(1) -> e in univ(1) -> Q(exc(x, e))) proof
    assume hn hu
    fix x e
    assume hx he
    have kx := mp(all_elim(hu, {x}, {e}), hx, he)
    have os: fst(out_state(ok(pair(w, empty), empty))) = w by simp()
    show by ex_intro({ok(pair(w, empty), empty)}, simp(hn, rewrite(sym(os), kx)))
  qed
  have uc: !c -> (all w2 v. k(w, ok(w2, v)) -> tr.returns_valid(w, w2)) -> (all w2 v. Q(ok(w2, v)) -> tr.returns_valid(w, w2)) proof
    assume hn hv
    fix w2 v
    assume hq
    obtain x2, hx hd from hq
    have e2: x2 = ok(pair(w, empty), empty) by taut(hx, hn)
    have os: fst(out_state(ok(pair(w, empty), empty))) = w by simp()
    have k0: k(fst(out_state(ok(pair(w, empty), empty))), ok(w2, v)) by simp(rewrite(e2, hd))
    have kk := rewrite(os, k0)
    show := mp(all_elim(hv, {w2}, {v}), kk)
  qed
  have ek: !c -> (all w2 v. k(w, ok(w2, v)) -> tr.returns_valid(w, w2)) || (all x e. x in univ(1) -> e in univ(1) -> k(w, exc(x, e))) proof
    assume hn
    show := expand(mp(hk, hn), tr.eff)
  qed
  show by defs(taut(ua, ub, uc, ek), tr.eff)
qed

// (a program runs only from a state in univ(1))
theorem tr.runs_univ(x0 o. r): all w o. runs(mkprog(x0 o. r(x0, o)), w, o) -> w in univ(1)
proof
  fix w o
  assume g
  have m := expand(g, runs, mkprog)
  have pu: pair(w, o) in univ(1) by taut(set_select_def[s := univ(1), p := z. ex s o. z = pair(s, o) && r(s, o), z := pair(w, o)], m)
  show by simp(pu)
qed

// a return of a fixed value after p's return
theorem tr.eff_bind_ret(p, v. f): all w. tr.eff(w, o. runs(p, w, o)) -> tr.eff(w, o. bind_rel(p, w, s1 v. o = ok(s1, f(v)), s1 e. o = exc(s1, e), t. o = diverge(t)))
proof
  fix w
  assume hp
  have k: all s1 v. runs(p, w, ok(s1, v)) -> tr.eff(s1, o. o = ok(s1, f(v))) proof
    fix s1 v
    assume _
    show := all_elim(tr.eff_ret, {s1}, {f(v)})
  qed
  show by apply(tr.eff_bind, {w}, hp, k)
qed

// ---------------------------------------------------------------------
//  GIMPLE's primitives: the state kept, or undefined

theorem tr.eff_padd: all w p d. tr.eff(w, o. runs(gimple.padd(p, d), w, o))
proof
  fix w p d
  let A := int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), d))
  have a1: int_le(0, A) && int_lt(A, 18446744073709551616) -> (all w2 v. runs(gimple.padd(p, d), w, ok(w2, v)) -> tr.returns_valid(w, w2)) proof
    assume hd
    fix w2 v
    assume h
    have e: w2 = w by simp(expand(h, gimple.padd, gimple.binop, gimple.arith, gimple.fits, gimple.wrap), hd)
    show := rewrite(sym(e), all_elim(tr.rv_refl, {w}), {2})
  qed
  have a2: w in univ(1) -> !(int_le(0, A) && int_lt(A, 18446744073709551616)) -> (all x e. x in univ(1) -> e in univ(1) -> runs(gimple.padd(p, d), w, exc(x, e))) proof
    assume hw hn
    fix x e
    assume hx he
    show by defs(simp(hw, hx, he, hn), gimple.padd, gimple.binop, gimple.arith, gimple.fits, gimple.wrap)
  qed
  have a3: !(w in univ(1)) -> (all w2 v. runs(gimple.padd(p, d), w, ok(w2, v)) -> tr.returns_valid(w, w2)) proof
    assume hn
    fix w2 v
    assume h
    show by taut(hn, apply(tr.runs_univ, expand(h, gimple.padd)))
  qed
  show by defs(taut(a1, a2, a3), tr.eff)
qed

theorem tr.eff_arith: all w ty x. tr.eff(w, o. runs(gimple.arith(ty, x), w, o))
proof
  fix w ty x
  let C := app(ty, "signed") && !gimple.fits(ty, x)
  have b := mp(all_elim(tr.eff_undef_if[c := C, k := s o. o = ok(s, gimple.wrap(ty, x))], {w}), (!C -> tr.eff(w, o. o = ok(w, gimple.wrap(ty, x))) by taut(all_elim(tr.eff_ret, {w}, {gimple.wrap(ty, x)}))))
  show by defs(apply(tr.eff_prog, {w}, b), gimple.arith)
qed

theorem tr.eff_smul: all w n a b. tr.eff(w, o. runs(gimple.smul(n, a, b), w, o))
proof
  fix w n a b
  have ar := all_elim(tr.eff_arith, {w}, {fn_update(fn_update(empty, "prec", n), "signed", true)}, {int_mul(sint(n, a), sint(n, b))})
  show by defs(apply(tr.eff_prog, {w}, apply(tr.eff_bind_ret, {w}, ar)), gimple.smul)
qed

theorem tr.eff_elem: all w p i k. tr.eff(w, o. runs(gimple.elem(p, i, k), w, o))
proof
  fix w p i k
  have sm := all_elim(tr.eff_smul, {w}, {64}, {i}, {bits_of_int(64, k)})
  have kp: all s1 v. runs(gimple.smul(64, i, bits_of_int(64, k)), w, ok(s1, v)) ->
      tr.eff(s1, o. bind_rel(gimple.padd(p, v), s1, x4 x5. o = ok(x4, x5), x4 x5. o = exc(x4, x5), x4. o = diverge(x4))) proof
    fix s1 v
    assume _
    show by apply(tr.eff_bind_ret, {s1}, all_elim(tr.eff_padd, {s1}, {p}, {v}))
  qed
  show by defs(apply(tr.eff_prog, {w}, apply(tr.eff_bind, {w}, sm, kp)), gimple.elem)
qed

theorem tr.eff_result: all w n v. tr.eff(w, o. runs(gimple.result(n, v), w, o))
proof
  fix w n v
  have k: all x. x in bits(64) && x in gimple.in_reg(v, fn_update(fn_update(empty, "prec", n), "signed", false)) -> tr.eff(w, o. o = ok(w, x)) proof
    fix x
    assume _
    show := all_elim(tr.eff_ret, {w}, {x})
  qed
  show by defs(apply(tr.eff_prog, {w}, apply(tr.eff_any, {w}, k)), gimple.result)
qed

theorem tr.eff_mem: all w p off n wr. tr.eff(w, o. runs(gimple.mem(p, off, n, wr), w, o))
proof
  fix w p off n wr
  // after the address: `undefined if !usable`, then its return
  let K2(x3, x4, x1) := letin(x4, x5. ex x6. (!gimple.usable(app(x3, "vm"), app(x3, "objs"), x5, n, wr) ||
      (!!gimple.usable(app(x3, "vm"), app(x3, "objs"), x5, n, wr) && x6 = ok(pair(x3, empty), empty))) &&
    ((fst(x6) = 0 && x1 = ok(fst(out_state(x6)), x5)) || ((((fst(x6) = 1 && fst(out_value(x6)) = "ret") && x1 = ok(fst(out_state(x6)), snd(out_value(x6)))) ||
      ((fst(x6) = 1 && fst(out_value(x6)) = "raise") && x1 = exc(fst(out_state(x6)), snd(out_value(x6))))) || (fst(x6) = 2 && x1 = diverge(snd(x6))))))
  have k2: all s1 v. runs(gimple.padd(p, off), w, ok(s1, v)) -> tr.eff(s1, o. K2(s1, v, o)) proof
    fix s1 v
    assume _
    let U := !gimple.usable(app(s1, "vm"), app(s1, "objs"), v, n, wr)
    have b := mp(all_elim(tr.eff_undef_if[c := U, k := s o. o = ok(s, v)], {s1}), (!U -> tr.eff(s1, o. o = ok(s1, v)) by taut(all_elim(tr.eff_ret, {s1}, {v}))))
    show by defs(b, letin)
  qed
  have k1 := apply(tr.eff_bind, {w}, all_elim(tr.eff_padd, {w}, {p}, {off}), k2)
  have b := mp(all_elim(tr.eff_undef_if[c := p = 0, k := s o. bind_rel(gimple.padd(p, off), s, x3 x4. K2(x3, x4, o), x3 x4. o = exc(x3, x4), x3. o = diverge(x3))], {w}), taut(k1))
  show by defs(apply(tr.eff_prog, {w}, b), gimple.mem)
qed

theorem tr.eff_ld8: all w p off. tr.eff(w, o. runs(gimple.ld8(p, off), w, o))
proof
  fix w p off
  have m := all_elim(tr.eff_mem, {w}, {p}, {off}, {1}, {false})
  show by defs(apply(tr.eff_prog, {w}, apply(tr.eff_bind_ret, {w}, m)), gimple.ld8)
qed

// ---------------------------------------------------------------------
//  A spec's bookkeeping for its callers

// a `_fun` wrapper's program per argument list: its effect for the lists
// of at least n arguments gives tr.callee_io
theorem tr.callee_io_fun(x0 x1 x2. r): all n. (all args w. args in abi.ARGS -> ord_le(n, seq_len(args)) -> tr.eff(w, o. runs(mkprog(x1 x2. r(args, x1, x2)), w, o))) ->
  tr.callee_io(fn_build(abi.ARGS, x0. mkprog(x1 x2. r(x0, x1, x2))), n)
proof
  fix n
  assume h
  have g: all args w w2 rr. ord_le(n, seq_len(args)) -> runs(app(fn_build(abi.ARGS, x0. mkprog(x1 x2. r(x0, x1, x2))), args), w, ok(w2, rr)) ->
      tr.returns_valid(w, w2) || tr.may_raise(fn_build(abi.ARGS, x0. mkprog(x1 x2. r(x0, x1, x2))), args, w) proof
    fix args w w2 rr
    assume hn hr
    have ha hp := apply(runs_fn_build, hr)
    have e := expand(mp(all_elim(h, {args}, {w}), ha, hn), tr.eff)
    have ap := mp(app_fn_build[d := abi.ARGS, v := x0. mkprog(x1 x2. r(x0, x1, x2)), a := args], ha)
    have c1: (all w3 v. runs(mkprog(x1 x2. r(args, x1, x2)), w, ok(w3, v)) -> tr.returns_valid(w, w3)) -> tr.returns_valid(w, w2) proof
      assume hv
      show := mp(all_elim(hv, {w2}, {rr}), hp)
    qed
    have c2: (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x1 x2. r(args, x1, x2)), w, exc(x, e))) ->
        tr.may_raise(fn_build(abi.ARGS, x0. mkprog(x1 x2. r(x0, x1, x2))), args, w) proof
      assume hu
      show by defs(rewrite(sym(ap), hu), tr.may_raise)
    qed
    show by taut(e, c1, c2)
  qed
  show by defs(g, tr.callee_io)
qed

// ---------------------------------------------------------------------
//  Calls: GIMPLE's call keeps the world valid where its callee does

// (no argument registers possible: the call undefined)
theorem tr.call_noregs: all g args w x e. w in univ(1) -> x in univ(1) -> e in univ(1) -> !(ex regs. gc.regs_ok(regs, args)) ->
  runs(gimple.call(g, args), w, exc(x, e))
proof
  fix g args w x e
  assume hw hx he hn
  have hn2: !(ex x0. x0 in list_type(bits(64)) && (seq_len(x0) = seq_len(args) && (all x1. x1 in omega -> int_lt(x1, seq_len(args)) -> app(x0, x1) in gimple.in_reg(fst(app(args, x1)), snd(app(args, x1)))))) proof
    have c0: (ex x0. x0 in list_type(bits(64)) && (seq_len(x0) = seq_len(args) && (all x1. x1 in omega -> int_lt(x1, seq_len(args)) -> app(x0, x1) in gimple.in_reg(fst(app(args, x1)), snd(app(args, x1)))))) -> false proof
      assume he0
      obtain r0, h1 h23 from he0
      have h2 h3 := h23
      have ex1: ex regs. gc.regs_ok(regs, args) by ex_intro({r0}, conj(h1, h2, h3))
      show by taut(ex1, hn)
    qed
    show by taut(c0)
  qed
  have c: runs(gimple.call_callee(g, args), w, exc(x, e)) by defs(simp(hw, hx, he, hn2), gimple.call_callee)
  have b := apply(gc.bind_exc[p := gimple.call_callee(g, args), k := x3 x4. letin(x4, x5. gc.aft(x3, x5, exc(x, e))), x := x3 x4. exc(x, e) = exc(x3, x4), d := x3. exc(x, e) = diverge(x3)], c, refl({exc(x, e)}))
  show := apply(gc.call_from, hw, (pair(w, exc(x, e)) in univ(1) by simp(hw, hx, he)), b)
qed

// (the callee's stack objects replaced: the world as valid)
theorem tr.rv_back: all w w4 z. tr.returns_valid(w, w4) -> tr.returns_valid(w, fn_update(w4, "objs", z))
proof
  fix w w4 z
  assume h
  have i ev ld cpu := expand(h, tr.returns_valid)
  have ld2: all gb gc st. gb in omega -> abi.loaded(app(w, "vm"), gb, gc, st) -> abi.loaded(app(fn_update(w4, "objs", z), "vm"), gb, gc, st) proof
    fix gb gc st
    assume hb hl
    have l := mp(all_elim(ld, {gb}, {gc}, {st}), hb, hl)
    show by simp(l, keep(abi.loaded))
  qed
  show by defs(simp(i, ev, ld2, cpu, keep(abi.loaded)), tr.returns_valid)
qed

// A call of g with at least its n arguments: its returns keep the world
// valid, or it is undefined -- as g's (tr.callee_io)
theorem tr.eff_call: all g args n w. tr.callee_io(g, n) -> ord_le(n, seq_len(args)) -> tr.eff(w, o. runs(gimple.call(g, args), w, o))
proof
  fix g args n w
  assume hio hn
  let C := gimple.call(g, args)
  // (all exceptions: the call undefined)
  let U := all x e. x in univ(1) -> e in univ(1) -> runs(C, w, exc(x, e))
  have toE: U -> tr.eff(w, o. runs(C, w, o)) proof
    assume hu
    show by defs(taut(hu), tr.eff)
  qed
  // (a world outside the universe: no run at all)
  have nu: !(w in univ(1)) -> tr.eff(w, o. runs(C, w, o)) proof
    assume hn0
    have g0: all w2 v. runs(C, w, ok(w2, v)) -> tr.returns_valid(w, w2) proof
      fix w2 v
      assume h
      have pu: pair(w, ok(w2, v)) in univ(1) by taut(unsel(expand(h, runs, gimple.call, mkprog)))
      have f: false by simp(pu, hn0)
      show by taut(f)
    qed
    show by defs(taut(g0), tr.eff)
  qed
  have yu: w in univ(1) -> tr.eff(w, o. runs(C, w, o)) proof
    assume hw
    // no registers possible, the thread pointer broken, or the callee
    // undefined for some registers: the call undefined
    have u0: !(ex regs. gc.regs_ok(regs, args)) -> tr.eff(w, o. runs(C, w, o)) proof
      assume hr
      have hu: U proof
        fix x e
        assume hx he
        show := apply(tr.call_noregs, {g}, {args}, {w}, {x}, {e}, hw, hx, he, hr)
      qed
      show := mp(toE, hu)
    qed
    have u1: (ex regs. gc.regs_ok(regs, args)) -> !gc.sound(w) -> tr.eff(w, o. runs(C, w, o)) proof
      assume hr hs
      obtain regs, rg from hr
      have hu: U proof
        fix x e
        assume hx he
        show := apply(gc.call_ub, {g}, {args}, {w}, {regs}, {x}, {e}, hw, hx, he, rg, hs)
      qed
      show := mp(toE, hu)
    qed
    have u2: (ex regs. gc.regs_ok(regs, args) && tr.may_raise(g, regs, w)) -> gc.sound(w) -> tr.eff(w, o. runs(C, w, o)) proof
      assume hr hs
      obtain regs, r1 r2 r3 hm from hr
      have rg: gc.regs_ok(regs, args) := conj(r1, r2, r3)
      have hu: U proof
        fix x e
        assume hx he
        have c := mp(all_elim(expand(hm, tr.may_raise), {x}, {e}), hx, he)
        show := apply(gc.call_exc, {g}, {args}, {w}, {regs}, {x}, {e}, hw, hx, he, rg, hs, c)
      qed
      show := mp(toE, hu)
    qed
    // otherwise every return of the call is the callee's, which keeps the world valid
    have v: (ex regs. gc.regs_ok(regs, args)) -> gc.sound(w) -> !(ex regs. gc.regs_ok(regs, args) && tr.may_raise(g, regs, w)) -> tr.eff(w, o. runs(C, w, o)) proof
      assume hr hs hnm
      have g0: all w2 v. runs(C, w, ok(w2, v)) -> tr.returns_valid(w, w2) proof
        fix w2 v
        assume h
        have cs := apply(gc.call_cases, h)
        have c0: ok(w2, v) = exc(w, exc_val("stack_overflow", empty)) -> tr.returns_valid(w, w2) proof
          assume e
          have f: false by simp(e)
          show by taut(f)
        qed
        have c1: gc.cc(g, args, w, ok(w2, v)) -> tr.returns_valid(w, w2) proof
          assume hc
          obtain o1, h1 hk from expand(hc, bind_rel)
          have ci := apply(gc.cc_inv, hs, h1, hr)
          obtain regs o2, r1 r2 r3 ho2 hcase from ci
          have rg: gc.regs_ok(regs, args) := conj(r1, r2, r3)
          have rl := r2
          have k1: (ex s1 v1. o1 = ok(s1, v1) && letin(v1, x5. gc.aft(s1, x5, ok(w2, v)))) -> tr.returns_valid(w, w2) proof
            assume e
            obtain s1 v1, eo1 ha from e
            have af := apply(gc.aft_inv, expand(ha, letin))
            have ws: w2 = s1 by simp(af)
            have q1: (ex w4 r. o2 = ok(w4, r) && o1 = ok(gc.back(w4, w), pair(fst(r), snd(r)))) -> tr.returns_valid(w, w2) proof
              assume e2
              obtain w4 r, eo2 eo1b from e2
              have sb: s1 = gc.back(w4, w) by simp(eo1, eo1b)
              have hg := rewrite(eo2, ho2)
              have io := mp(all_elim(expand(hio, tr.callee_io), {regs}, {w}, {w4}, {r}), (ord_le(n, seq_len(regs)) by simp(rl, hn)), hg)
              have nm: !tr.may_raise(g, regs, w) proof
                have c: tr.may_raise(g, regs, w) -> false proof
                  assume hm
                  have ex1: ex regs. gc.regs_ok(regs, args) && tr.may_raise(g, regs, w) by ex_intro({regs}, conj(rg, hm))
                  show by taut(ex1, hnm)
                qed
                show by taut(c)
              qed
              have rv: tr.returns_valid(w, w4) by taut(io, nm)
              have rb := apply(tr.rv_back, {w}, {w4}, {app(w, "objs")}, rv)
              show by simp(ws, sb, rb, keep(tr.returns_valid))
            qed
            have q2: (ex x e. o2 = exc(x, e) && o1 = exc(x, e)) -> tr.returns_valid(w, w2) proof
              assume e2
              obtain x e, _ eo1b from e2
              have f: false by simp(eo1, eo1b)
              show by taut(f)
            qed
            have q3: (ex t. o2 = diverge(t) && o1 = diverge(t)) -> tr.returns_valid(w, w2) proof
              assume e2
              obtain t, _ eo1b from e2
              have f: false by simp(eo1, eo1b)
              show by taut(f)
            qed
            show by taut(hcase, q1, q2, q3)
          qed
          have k2: (ex s1 e1. o1 = exc(s1, e1) && ok(w2, v) = exc(s1, e1)) -> tr.returns_valid(w, w2) proof
            assume e
            obtain s1 e1, _ eo from e
            have f: false by simp(eo)
            show by taut(f)
          qed
          have k3: (ex t. o1 = diverge(t) && ok(w2, v) = diverge(t)) -> tr.returns_valid(w, w2) proof
            assume e
            obtain t, _ eo from e
            have f: false by simp(eo)
            show by taut(f)
          qed
          show by taut(hk, k1, k2, k3)
        qed
        show by taut(cs, c0, c1)
      qed
      show by defs(taut(g0), tr.eff)
    qed
    show by taut(u0, u1, u2, v)
  qed
  show by taut(nu, yu)
qed

// ... call1 (the result's rax only)
theorem tr.eff_call1: all g args n w. tr.callee_io(g, n) -> ord_le(n, seq_len(args)) -> tr.eff(w, o. runs(gimple.call1(g, args), w, o))
proof
  fix g args n w
  assume hio hn
  have c := mp(all_elim(tr.eff_call, {g}, {args}, {n}, {w}), hio, hn)
  have b := mp(all_elim(tr.eff_bind_ret[p := gimple.call(g, args), f := v. fst(v)], {w}), c)
  show by defs(apply(tr.eff_prog, {w}, b), gimple.call1, letin)
qed

// ---------------------------------------------------------------------
//  Statements: a block's statement outcome x carries the world and the
//  locals (out_state(x) = pair(world, locals)); a normal outcome (fst = 0)
//  goes on with the next statement, a "ret" returns, a "raise" raises

// every outcome but a raise (a normal one, a return, a loop's exit)
// keeps the world valid, or every raise is allowed (the statement is
// undefined from w)
def tr.seff(w, x. a) := (all x. a(x) -> (fst(x) = 0 || (fst(x) = 1 && !(fst(out_value(x)) = "raise"))) -> tr.returns_valid(w, fst(out_state(x)))) ||
  (all y e. y in univ(1) -> e in univ(1) -> (ex l. a(exc(pair(y, l), pair("raise", e)))))

// a block, as the program's body: its statement's outcome dispatched
theorem tr.eff_seq(x. a, x o. k): all w. tr.seff(w, x. a(x)) -> (all x. a(x) -> fst(x) = 0 -> tr.eff(fst(out_state(x)), o. k(x, o))) ->
  tr.eff(w, o. ex x. a(x) && ((fst(x) = 0 && k(x, o)) || ((((fst(x) = 1 && fst(out_value(x)) = "ret") && o = ok(fst(out_state(x)), snd(out_value(x)))) ||
    ((fst(x) = 1 && fst(out_value(x)) = "raise") && o = exc(fst(out_state(x)), snd(out_value(x))))) || (fst(x) = 2 && o = diverge(snd(x))))))
proof
  fix w
  assume ha hk
  let Q(o) := ex x. a(x) && ((fst(x) = 0 && k(x, o)) || ((((fst(x) = 1 && fst(out_value(x)) = "ret") && o = ok(fst(out_state(x)), snd(out_value(x)))) ||
    ((fst(x) = 1 && fst(out_value(x)) = "raise") && o = exc(fst(out_state(x)), snd(out_value(x))))) || (fst(x) = 2 && o = diverge(snd(x)))))
  // the statement undefined: a raise of anything
  have ua: (all y e. y in univ(1) -> e in univ(1) -> (ex l. a(exc(pair(y, l), pair("raise", e))))) -> (all y e. y in univ(1) -> e in univ(1) -> Q(exc(y, e))) proof
    assume hu
    fix y e
    assume hy he
    obtain l, hl from mp(all_elim(hu, {y}, {e}), hy, he)
    show by ex_intro({exc(pair(y, l), pair("raise", e))}, simp(hl))
  qed
  // a normal outcome after which the rest is undefined
  have ub: (ex x. a(x) && fst(x) = 0 && (all y e. y in univ(1) -> e in univ(1) -> k(x, exc(y, e)))) -> (all y e. y in univ(1) -> e in univ(1) -> Q(exc(y, e))) proof
    assume h
    obtain x, hx h0 hu from h
    fix y e
    assume hy he
    have kx := mp(all_elim(hu, {y}, {e}), hy, he)
    show by ex_intro({x}, taut(hx, h0, kx))
  qed
  // otherwise: every return valid
  have uc: (all x. a(x) -> (fst(x) = 0 || (fst(x) = 1 && !(fst(out_value(x)) = "raise"))) -> tr.returns_valid(w, fst(out_state(x)))) ->
      !(ex x. a(x) && fst(x) = 0 && (all y e. y in univ(1) -> e in univ(1) -> k(x, exc(y, e)))) -> (all w2 v. Q(ok(w2, v)) -> tr.returns_valid(w, w2)) proof
    assume hv hn
    fix w2 v
    assume hq
    obtain x, hx hd from hq
    have c1: (fst(x) = 0 && k(x, ok(w2, v))) -> tr.returns_valid(w, w2) proof
      assume h1
      have h0 kx := h1
      have ek := expand(mp(all_elim(hk, {x}), hx, h0), tr.eff)
      have nu: (all y e. y in univ(1) -> e in univ(1) -> k(x, exc(y, e))) -> false proof
        assume hu
        have ex: ex x. a(x) && fst(x) = 0 && (all y e. y in univ(1) -> e in univ(1) -> k(x, exc(y, e))) by ex_intro({x}, taut(hx, h0, hu))
        show by taut(hn, ex)
      qed
      have kv: all w3 v3. k(x, ok(w3, v3)) -> tr.returns_valid(fst(out_state(x)), w3) by taut(ek, nu)
      have r1 := mp(all_elim(hv, {x}), hx, (fst(x) = 0 || (fst(x) = 1 && !(fst(out_value(x)) = "raise")) by taut(h0)))
      show := mp(all_elim(tr.rv_trans, {w}, {fst(out_state(x))}, {w2}), r1, mp(all_elim(kv, {w2}, {v}), kx))
    qed
    have c2: ((fst(x) = 1 && fst(out_value(x)) = "ret") && ok(w2, v) = ok(fst(out_state(x)), snd(out_value(x)))) -> tr.returns_valid(w, w2) proof
      assume h2
      have hr1 hr2 he := h2
      have e2: w2 = fst(out_state(x)) by simp(he)
      have r1 := mp(all_elim(hv, {x}), hx, (fst(x) = 0 || (fst(x) = 1 && !(fst(out_value(x)) = "raise")) by simp(hr1, hr2)))
      show := rewrite(sym(e2), r1)
    qed
    have c3: ((fst(x) = 1 && fst(out_value(x)) = "raise") && ok(w2, v) = exc(fst(out_state(x)), snd(out_value(x)))) -> tr.returns_valid(w, w2) proof
      assume h3
      show by simp(h3.3)
    qed
    have c4: (fst(x) = 2 && ok(w2, v) = diverge(snd(x))) -> tr.returns_valid(w, w2) proof
      assume h4
      show by simp(h4.2)
    qed
    show by taut(hd, c1, c2, c3, c4)
  qed
  have ea := expand(ha, tr.seff)
  show by defs(taut(ea, ua, ub, uc), tr.eff)
qed

// a normal outcome, the world as it was
theorem tr.seff_ok: all w l v. tr.seff(w, y. y = ok(pair(w, l), v))
proof
  fix w l v
  have g: all y. y = ok(pair(w, l), v) -> (fst(y) = 0 || (fst(y) = 1 && !(fst(out_value(y)) = "raise"))) -> tr.returns_valid(w, fst(out_state(y))) proof
    fix y
    assume h _
    have e: fst(out_state(y)) = w by simp(h)
    show := rewrite(sym(e), all_elim(tr.rv_refl, {w}), {2})
  qed
  show by defs(taut(g), tr.seff)
qed

// a return, the world as it was
theorem tr.seff_ret: all w l v. tr.seff(w, y. y = exc(pair(w, l), pair("ret", v)))
proof
  fix w l v
  have g: all y. y = exc(pair(w, l), pair("ret", v)) -> (fst(y) = 0 || (fst(y) = 1 && !(fst(out_value(y)) = "raise"))) -> tr.returns_valid(w, fst(out_state(y))) proof
    fix y
    assume h _
    have e: fst(out_state(y)) = w by simp(h)
    show := rewrite(sym(e), all_elim(tr.rv_refl, {w}), {2})
  qed
  show by defs(taut(g), tr.seff)
qed

// `undefined if c`: anything, else a normal outcome
theorem tr.seff_undef_if(c): all w. tr.seff(w, x. c || (!c && x = ok(pair(w, empty), empty)))
proof
  fix w
  have ua: c -> (all y e. y in univ(1) -> e in univ(1) -> (ex l. c || (!c && exc(pair(y, l), pair("raise", e)) = ok(pair(w, empty), empty)))) proof
    assume hc
    fix y e
    assume _ _
    show by ex_intro({empty}, taut(hc))
  qed
  have uc: !c -> (all x. c || (!c && x = ok(pair(w, empty), empty)) -> (fst(x) = 0 || (fst(x) = 1 && !(fst(out_value(x)) = "raise"))) -> tr.returns_valid(w, fst(out_state(x)))) proof
    assume hn
    fix x
    assume h _
    have e: fst(out_state(x)) = w by simp(h, hn)
    show := rewrite(sym(e), all_elim(tr.rv_refl, {w}), {2})
  qed
  show by defs(taut(ua, uc), tr.seff)
qed

// `if c`: each branch's
theorem tr.seff_if(c, y. a1, y. a2): all w. (c -> tr.seff(w, y. a1(y))) -> (!c -> tr.seff(w, y. a2(y))) -> tr.seff(w, y. (c && a1(y)) || (!c && a2(y)))
proof
  fix w
  assume h1 h2
  have b1: c -> tr.seff(w, y. (c && a1(y)) || (!c && a2(y))) proof
    assume hc
    have e := expand(mp(h1, hc), tr.seff)
    have v: (all x. a1(x) -> (fst(x) = 0 || (fst(x) = 1 && !(fst(out_value(x)) = "raise"))) -> tr.returns_valid(w, fst(out_state(x)))) ->
        (all x. (c && a1(x)) || (!c && a2(x)) -> (fst(x) = 0 || (fst(x) = 1 && !(fst(out_value(x)) = "raise"))) -> tr.returns_valid(w, fst(out_state(x)))) proof
      assume hv
      fix x
      assume ha hr
      show := mp(all_elim(hv, {x}), (a1(x) by taut(ha, hc)), hr)
    qed
    have u: (all y e. y in univ(1) -> e in univ(1) -> (ex l. a1(exc(pair(y, l), pair("raise", e))))) ->
        (all y e. y in univ(1) -> e in univ(1) -> (ex l. (c && a1(exc(pair(y, l), pair("raise", e)))) || (!c && a2(exc(pair(y, l), pair("raise", e)))))) proof
      assume hu
      fix y e
      assume hy he
      obtain l, hl from mp(all_elim(hu, {y}, {e}), hy, he)
      show by ex_intro({l}, taut(hc, hl))
    qed
    show by defs(taut(e, v, u), tr.seff)
  qed
  have b2: !c -> tr.seff(w, y. (c && a1(y)) || (!c && a2(y))) proof
    assume hc
    have e := expand(mp(h2, hc), tr.seff)
    have v: (all x. a2(x) -> (fst(x) = 0 || (fst(x) = 1 && !(fst(out_value(x)) = "raise"))) -> tr.returns_valid(w, fst(out_state(x)))) ->
        (all x. (c && a1(x)) || (!c && a2(x)) -> (fst(x) = 0 || (fst(x) = 1 && !(fst(out_value(x)) = "raise"))) -> tr.returns_valid(w, fst(out_state(x)))) proof
      assume hv
      fix x
      assume ha hr
      show := mp(all_elim(hv, {x}), (a2(x) by taut(ha, hc)), hr)
    qed
    have u: (all y e. y in univ(1) -> e in univ(1) -> (ex l. a2(exc(pair(y, l), pair("raise", e))))) ->
        (all y e. y in univ(1) -> e in univ(1) -> (ex l. (c && a1(exc(pair(y, l), pair("raise", e)))) || (!c && a2(exc(pair(y, l), pair("raise", e)))))) proof
      assume hu
      fix y e
      assume hy he
      obtain l, hl from mp(all_elim(hu, {y}, {e}), hy, he)
      show by ex_intro({l}, taut(hc, hl))
    qed
    show by defs(taut(e, v, u), tr.seff)
  qed
  show by taut(b1, b2)
qed

// a choice: each choice's (none possible: anything)
theorem tr.seff_any(x. d, x y. k): all w. (all x. d(x) -> tr.seff(w, y. k(x, y))) -> tr.seff(w, y. any_rel(x. d(x), x. k(x, y)))
proof
  fix w
  assume hk
  have ua: !(ex x. d(x)) -> (all y e. y in univ(1) -> e in univ(1) -> (ex l. any_rel(x. d(x), x. k(x, exc(pair(y, l), pair("raise", e)))))) proof
    assume hn
    fix y e
    assume _ _
    show by ex_intro({empty}, defs(taut(hn), any_rel))
  qed
  have ub: (ex x. d(x) && (all y e. y in univ(1) -> e in univ(1) -> (ex l. k(x, exc(pair(y, l), pair("raise", e)))))) ->
      (all y e. y in univ(1) -> e in univ(1) -> (ex l. any_rel(x. d(x), x. k(x, exc(pair(y, l), pair("raise", e)))))) proof
    assume h
    obtain x, hd hu from h
    fix y e
    assume hy he
    obtain l, hl from mp(all_elim(hu, {y}, {e}), hy, he)
    show by ex_intro({l}, defs(taut(((ex x. d(x) && k(x, exc(pair(y, l), pair("raise", e)))) by ex_intro({x}, taut(hd, hl)))), any_rel))
  qed
  have uc: (ex x. d(x)) -> !(ex x. d(x) && (all y e. y in univ(1) -> e in univ(1) -> (ex l. k(x, exc(pair(y, l), pair("raise", e)))))) ->
      (all z. any_rel(x. d(x), x. k(x, z)) -> (fst(z) = 0 || (fst(z) = 1 && !(fst(out_value(z)) = "raise"))) -> tr.returns_valid(w, fst(out_state(z)))) proof
    assume hd0 hn
    fix z
    assume ha hr
    have ha2 := expand(ha, any_rel)
    have c: (ex x. d(x) && k(x, z)) -> tr.returns_valid(w, fst(out_state(z))) proof
      assume e1
      obtain x, hd kx from e1
      have ek := expand(mp(all_elim(hk, {x}), hd), tr.seff)
      have nu: (all y e. y in univ(1) -> e in univ(1) -> (ex l. k(x, exc(pair(y, l), pair("raise", e))))) -> false proof
        assume hu
        have ex: ex x. d(x) && (all y e. y in univ(1) -> e in univ(1) -> (ex l. k(x, exc(pair(y, l), pair("raise", e))))) by ex_intro({x}, taut(hd, hu))
        show by taut(hn, ex)
      qed
      have kv: all z2. k(x, z2) -> (fst(z2) = 0 || (fst(z2) = 1 && !(fst(out_value(z2)) = "raise"))) -> tr.returns_valid(w, fst(out_state(z2))) by taut(ek, nu)
      show := mp(all_elim(kv, {z}), kx, hr)
    qed
    show by taut(ha2, hd0, c)
  qed
  show by defs(taut(ua, ub, uc), tr.seff)
qed

// a statement's sequencing: p, then k on its return; p's raise raised
// with the locals l
theorem tr.seff_bind(p, s v y. k, s. l): all w. tr.eff(w, o. runs(p, w, o)) -> (all s1 v. runs(p, w, ok(s1, v)) -> tr.seff(s1, y. k(s1, v, y))) ->
  tr.seff(w, y. bind_rel(p, w, s1 v. k(s1, v, y), s1 e. y = exc(pair(s1, l(s1)), pair("raise", e)), t. y = diverge(t)))
proof
  fix w
  assume hp hk
  let B(y) := bind_rel(p, w, s1 v. k(s1, v, y), s1 e. y = exc(pair(s1, l(s1)), pair("raise", e)), t. y = diverge(t))
  have ua: (all x e. x in univ(1) -> e in univ(1) -> runs(p, w, exc(x, e))) -> (all y e. y in univ(1) -> e in univ(1) -> (ex l2. B(exc(pair(y, l2), pair("raise", e))))) proof
    assume hu
    fix y e
    assume hy he
    have r := mp(all_elim(hu, {y}, {e}), hy, he)
    show by ex_intro({l(y)}, defs(ex_intro({exc(y, e)}, simp(r)), bind_rel))
  qed
  have ub: (ex s1 v. runs(p, w, ok(s1, v)) && (all y e. y in univ(1) -> e in univ(1) -> (ex l2. k(s1, v, exc(pair(y, l2), pair("raise", e)))))) ->
      (all y e. y in univ(1) -> e in univ(1) -> (ex l2. B(exc(pair(y, l2), pair("raise", e))))) proof
    assume h
    obtain s1 v, hr hu from h
    fix y e
    assume hy he
    obtain l2, kx from mp(all_elim(hu, {y}, {e}), hy, he)
    show by ex_intro({l2}, defs(ex_intro({ok(s1, v)}, simp(hr, kx)), bind_rel))
  qed
  have uc: (all w2 v. runs(p, w, ok(w2, v)) -> tr.returns_valid(w, w2)) ->
      !(ex s1 v. runs(p, w, ok(s1, v)) && (all y e. y in univ(1) -> e in univ(1) -> (ex l2. k(s1, v, exc(pair(y, l2), pair("raise", e)))))) ->
      (all z. B(z) -> (fst(z) = 0 || (fst(z) = 1 && !(fst(out_value(z)) = "raise"))) -> tr.returns_valid(w, fst(out_state(z)))) proof
    assume hv hn
    fix z
    assume hb hr
    obtain o1, hr1 hc from expand(hb, bind_rel)
    have c1: (ex s1 v. o1 = ok(s1, v) && k(s1, v, z)) -> tr.returns_valid(w, fst(out_state(z))) proof
      assume e1
      obtain s1 v, eo ko from e1
      have r1 := rewrite(eo, hr1)
      have ek := expand(mp(all_elim(hk, {s1}, {v}), r1), tr.seff)
      have nu: (all y e. y in univ(1) -> e in univ(1) -> (ex l2. k(s1, v, exc(pair(y, l2), pair("raise", e))))) -> false proof
        assume hu
        have ex: ex s1 v. runs(p, w, ok(s1, v)) && (all y e. y in univ(1) -> e in univ(1) -> (ex l2. k(s1, v, exc(pair(y, l2), pair("raise", e))))) by ex_intro({s1}, {v}, taut(r1, hu))
        show by taut(hn, ex)
      qed
      have kv: all z2. k(s1, v, z2) -> (fst(z2) = 0 || (fst(z2) = 1 && !(fst(out_value(z2)) = "raise"))) -> tr.returns_valid(s1, fst(out_state(z2))) by taut(ek, nu)
      have rv2 := mp(all_elim(kv, {z}), ko, hr)
      have rv1 := mp(all_elim(hv, {s1}, {v}), r1)
      show := mp(all_elim(tr.rv_trans, {w}, {s1}, {fst(out_state(z))}), rv1, rv2)
    qed
    have c2: (ex s1 e. o1 = exc(s1, e) && z = exc(pair(s1, l(s1)), pair("raise", e))) -> tr.returns_valid(w, fst(out_state(z))) proof
      assume e2
      obtain s1 e, _ ee from e2
      show by simp(ee, hr)
    qed
    have c3: (ex t. o1 = diverge(t) && z = diverge(t)) -> tr.returns_valid(w, fst(out_state(z))) proof
      assume e3
      obtain t, _ ee from e3
      show by simp(ee, hr)
    qed
    show by taut(hc, c1, c2, c3)
  qed
  have ep := expand(hp, tr.eff)
  show by defs(taut(ep, ua, ub, uc), tr.seff)
qed

// a block inside a statement: its statement's outcome dispatched, the
// locals l(x) packed on a return or raise
theorem tr.seff_seq(x. a, x y. k, x. l): all w. tr.seff(w, x. a(x)) -> (all x. a(x) -> fst(x) = 0 -> tr.seff(fst(out_state(x)), y. k(x, y))) ->
  tr.seff(w, y. ex x. a(x) && ((fst(x) = 0 && k(x, y)) || ((((fst(x) = 1 && fst(out_value(x)) = "ret") && y = exc(pair(fst(out_state(x)), l(x)), pair("ret", snd(out_value(x))))) ||
    ((fst(x) = 1 && fst(out_value(x)) = "raise") && y = exc(pair(fst(out_state(x)), l(x)), pair("raise", snd(out_value(x)))))) || (fst(x) = 2 && y = diverge(snd(x))))))
proof
  fix w
  assume ha hk
  let Q(y) := ex x. a(x) && ((fst(x) = 0 && k(x, y)) || ((((fst(x) = 1 && fst(out_value(x)) = "ret") && y = exc(pair(fst(out_state(x)), l(x)), pair("ret", snd(out_value(x))))) ||
    ((fst(x) = 1 && fst(out_value(x)) = "raise") && y = exc(pair(fst(out_state(x)), l(x)), pair("raise", snd(out_value(x)))))) || (fst(x) = 2 && y = diverge(snd(x)))))
  have ua: (all y e. y in univ(1) -> e in univ(1) -> (ex l2. a(exc(pair(y, l2), pair("raise", e))))) -> (all y e. y in univ(1) -> e in univ(1) -> (ex l2. Q(exc(pair(y, l2), pair("raise", e))))) proof
    assume hu
    fix y e
    assume hy he
    obtain l2, hl from mp(all_elim(hu, {y}, {e}), hy, he)
    show by ex_intro({l(exc(pair(y, l2), pair("raise", e)))}, ex_intro({exc(pair(y, l2), pair("raise", e))}, simp(hl)))
  qed
  have ub: (ex x. a(x) && fst(x) = 0 && (all y e. y in univ(1) -> e in univ(1) -> (ex l2. k(x, exc(pair(y, l2), pair("raise", e)))))) ->
      (all y e. y in univ(1) -> e in univ(1) -> (ex l2. Q(exc(pair(y, l2), pair("raise", e))))) proof
    assume h
    obtain x, hx h0 hu from h
    fix y e
    assume hy he
    obtain l2, kx from mp(all_elim(hu, {y}, {e}), hy, he)
    show by ex_intro({l2}, ex_intro({x}, taut(hx, h0, kx)))
  qed
  have uc: (all x. a(x) -> (fst(x) = 0 || (fst(x) = 1 && !(fst(out_value(x)) = "raise"))) -> tr.returns_valid(w, fst(out_state(x)))) ->
      !(ex x. a(x) && fst(x) = 0 && (all y e. y in univ(1) -> e in univ(1) -> (ex l2. k(x, exc(pair(y, l2), pair("raise", e)))))) ->
      (all z. Q(z) -> (fst(z) = 0 || (fst(z) = 1 && !(fst(out_value(z)) = "raise"))) -> tr.returns_valid(w, fst(out_state(z)))) proof
    assume hv hn
    fix z
    assume hq hr
    obtain x, hx hd from hq
    have c1: (fst(x) = 0 && k(x, z)) -> tr.returns_valid(w, fst(out_state(z))) proof
      assume h1
      have h0 kx := h1
      have ek := expand(mp(all_elim(hk, {x}), hx, h0), tr.seff)
      have nu: (all y e. y in univ(1) -> e in univ(1) -> (ex l2. k(x, exc(pair(y, l2), pair("raise", e))))) -> false proof
        assume hu
        have ex: ex x. a(x) && fst(x) = 0 && (all y e. y in univ(1) -> e in univ(1) -> (ex l2. k(x, exc(pair(y, l2), pair("raise", e))))) by ex_intro({x}, taut(hx, h0, hu))
        show by taut(hn, ex)
      qed
      have kv: all z2. k(x, z2) -> (fst(z2) = 0 || (fst(z2) = 1 && !(fst(out_value(z2)) = "raise"))) -> tr.returns_valid(fst(out_state(x)), fst(out_state(z2))) by taut(ek, nu)
      have r1 := mp(all_elim(hv, {x}), hx, (fst(x) = 0 || (fst(x) = 1 && !(fst(out_value(x)) = "raise")) by taut(h0)))
      show := mp(all_elim(tr.rv_trans, {w}, {fst(out_state(x))}, {fst(out_state(z))}), r1, mp(all_elim(kv, {z}), kx, hr))
    qed
    have c2: ((fst(x) = 1 && fst(out_value(x)) = "ret") && z = exc(pair(fst(out_state(x)), l(x)), pair("ret", snd(out_value(x))))) -> tr.returns_valid(w, fst(out_state(z))) proof
      assume h2
      have hr1 hr2 he := h2
      have e2: fst(out_state(z)) = fst(out_state(x)) by simp(he)
      have r1 := mp(all_elim(hv, {x}), hx, (fst(x) = 0 || (fst(x) = 1 && !(fst(out_value(x)) = "raise")) by simp(hr1, hr2)))
      show := rewrite(sym(e2), r1)
    qed
    have c3: ((fst(x) = 1 && fst(out_value(x)) = "raise") && z = exc(pair(fst(out_state(x)), l(x)), pair("raise", snd(out_value(x))))) -> tr.returns_valid(w, fst(out_state(z))) proof
      assume h3
      show by simp(h3.3, hr)
    qed
    have c4: (fst(x) = 2 && z = diverge(snd(x))) -> tr.returns_valid(w, fst(out_state(z))) proof
      assume h4
      show by simp(h4.2, hr)
    qed
    show by taut(hd, c1, c2, c3, c4)
  qed
  have ea := expand(ha, tr.seff)
  show by defs(taut(ea, ua, ub, uc), tr.seff)
qed

// `if c` in a program: each branch's
theorem tr.eff_if(c, o. r1, o. r2): all w. (c -> tr.eff(w, o. r1(o))) -> (!c -> tr.eff(w, o. r2(o))) -> tr.eff(w, o. (c && r1(o)) || (!c && r2(o)))
proof
  fix w
  assume h1 h2
  have b1: c -> tr.eff(w, o. (c && r1(o)) || (!c && r2(o))) proof
    assume hc
    have e := expand(mp(h1, hc), tr.eff)
    have v: (all w2 v. r1(ok(w2, v)) -> tr.returns_valid(w, w2)) -> (all w2 v. (c && r1(ok(w2, v))) || (!c && r2(ok(w2, v))) -> tr.returns_valid(w, w2)) proof
      assume hv
      fix w2 v
      assume ha
      show := mp(all_elim(hv, {w2}, {v}), (r1(ok(w2, v)) by taut(ha, hc)))
    qed
    have u: (all x e. x in univ(1) -> e in univ(1) -> r1(exc(x, e))) -> (all x e. x in univ(1) -> e in univ(1) -> (c && r1(exc(x, e))) || (!c && r2(exc(x, e)))) proof
      assume hu
      fix x e
      assume hx he
      show by taut(hc, mp(all_elim(hu, {x}, {e}), hx, he))
    qed
    show by defs(taut(e, v, u), tr.eff)
  qed
  have b2: !c -> tr.eff(w, o. (c && r1(o)) || (!c && r2(o))) proof
    assume hc
    have e := expand(mp(h2, hc), tr.eff)
    have v: (all w2 v. r2(ok(w2, v)) -> tr.returns_valid(w, w2)) -> (all w2 v. (c && r1(ok(w2, v))) || (!c && r2(ok(w2, v))) -> tr.returns_valid(w, w2)) proof
      assume hv
      fix w2 v
      assume ha
      show := mp(all_elim(hv, {w2}, {v}), (r2(ok(w2, v)) by taut(ha, hc)))
    qed
    have u: (all x e. x in univ(1) -> e in univ(1) -> r2(exc(x, e))) -> (all x e. x in univ(1) -> e in univ(1) -> (c && r1(exc(x, e))) || (!c && r2(exc(x, e)))) proof
      assume hu
      fix x e
      assume hx he
      show by taut(hc, mp(all_elim(hu, {x}, {e}), hx, he))
    qed
    show by defs(taut(e, v, u), tr.eff)
  qed
  show by taut(b1, b2)
qed

theorem tr.eff_sadd: all w n a b. tr.eff(w, o. runs(gimple.sadd(n, a, b), w, o))
proof
  fix w n a b
  have ar := all_elim(tr.eff_arith, {w}, {fn_update(fn_update(empty, "prec", n), "signed", true)}, {int_add(sint(n, a), sint(n, b))})
  show by defs(apply(tr.eff_prog, {w}, apply(tr.eff_bind_ret, {w}, ar)), gimple.sadd)
qed

theorem tr.eff_ssub: all w n a b. tr.eff(w, o. runs(gimple.ssub(n, a, b), w, o))
proof
  fix w n a b
  have ar := all_elim(tr.eff_arith, {w}, {fn_update(fn_update(empty, "prec", n), "signed", true)}, {int_sub(sint(n, a), sint(n, b))})
  show by defs(apply(tr.eff_prog, {w}, apply(tr.eff_bind_ret, {w}, ar)), gimple.ssub)
qed

theorem tr.eff_ldbf: all w p off size pos bits. tr.eff(w, o. runs(gimple.ldbf(p, off, size, pos, bits), w, o))
proof
  fix w p off size pos bits
  have m := all_elim(tr.eff_mem, {w}, {p}, {off}, {size}, {false})
  show by defs(apply(tr.eff_prog, {w}, apply(tr.eff_bind_ret, {w}, m)), gimple.ldbf)
qed

theorem tr.eff_ld16: all w p off. tr.eff(w, o. runs(gimple.ld16(p, off), w, o))
proof
  fix w p off
  have m := all_elim(tr.eff_mem, {w}, {p}, {off}, {2}, {false})
  show by defs(apply(tr.eff_prog, {w}, apply(tr.eff_bind_ret, {w}, m)), gimple.ld16)
qed

theorem tr.eff_ld32: all w p off. tr.eff(w, o. runs(gimple.ld32(p, off), w, o))
proof
  fix w p off
  have m := all_elim(tr.eff_mem, {w}, {p}, {off}, {4}, {false})
  show by defs(apply(tr.eff_prog, {w}, apply(tr.eff_bind_ret, {w}, m)), gimple.ld32)
qed

theorem tr.eff_ld64: all w p off. tr.eff(w, o. runs(gimple.ld64(p, off), w, o))
proof
  fix w p off
  have m := all_elim(tr.eff_mem, {w}, {p}, {off}, {8}, {false})
  show by defs(apply(tr.eff_prog, {w}, apply(tr.eff_bind_ret, {w}, m)), gimple.ld64)
qed

// ---------------------------------------------------------------------
//  Stores: only the bytes the world may write change, so the program
//  stays loaded (its code is not writable)

// a byte the world w0 may write: writable, or a stack object's (off the
// program's mapped pages)
abbrev tr.wbl(w0, a) := x86_64_linux.can_access(app(w0, "vm"), a, 1) ||
  (a in app(w0, "objs") && !(x86_64_linux.mapped(app(w0, "vm"), x86_64_linux.page_of(a)) && !abi.stack_page(app(w0, "vm"), x86_64_linux.page_of(a))))

// w is w0 with its memory's bytes changed only where w0 may write
def tr.wr_only(w0, w) := w = w0 || (ex b. w = fn_update(w0, "vm", fn_update(app(w0, "vm"), "bytes", b)) &&
  (all a. !(app(b, a) = app(app(app(w0, "vm"), "bytes"), a)) -> tr.wbl(w0, a)))

// ... so the world stays valid: code is not writable
theorem tr.wr_only_valid: all w0 w. tr.wr_only(w0, w) -> tr.returns_valid(w0, w)
proof
  fix w0 w
  assume h
  have c1: w = w0 -> tr.returns_valid(w0, w) proof
    assume e
    show := rewrite(sym(e), all_elim(tr.rv_refl, {w0}), {2})
  qed
  have c2: (ex b. w = fn_update(w0, "vm", fn_update(app(w0, "vm"), "bytes", b)) &&
      (all a. !(app(b, a) = app(app(app(w0, "vm"), "bytes"), a)) -> tr.wbl(w0, a))) -> tr.returns_valid(w0, w) proof
    assume hb
    obtain b, he hd from hb
    have ose: app(w, "os") = app(w0, "os") by simp(he)
    have vme: app(w, "vm") = fn_update(app(w0, "vm"), "bytes", b) by simp(he)
    have l: all gb gc st. gb in omega -> abi.loaded(app(w0, "vm"), gb, gc, st) -> abi.loaded(app(w, "vm"), gb, gc, st) proof
      fix gb gc st
      assume _ hl
      have hc hs := expand(hl, abi.loaded)
      have g: all i. i in omega -> int_lt(i, seq_len(gc)) ->
          ((x86_64_linux.fetchable(app(w, "vm"), bits_of_int(64, int_add(gb, i))) && !x86_64_linux.can_access(app(w, "vm"), bits_of_int(64, int_add(gb, i)), 1)) &&
            !abi.stack_page(app(w, "vm"), x86_64_linux.page_of(bits_of_int(64, int_add(gb, i))))) &&
          app(app(app(w, "vm"), "bytes"), bits_of_int(64, int_add(gb, i))) = app(gc, i) proof
        fix i
        assume hi hlt
        have c0 := mp(all_elim(expand(hc, abi.code_at), {i}), hi, hlt)
        have fm: x86_64_linux.mapped(app(w0, "vm"), x86_64_linux.page_of(bits_of_int(64, int_add(gb, i)))) by taut(expand(c0, x86_64_linux.fetchable))
        have nb: app(b, bits_of_int(64, int_add(gb, i))) = app(app(app(w0, "vm"), "bytes"), bits_of_int(64, int_add(gb, i))) by taut(all_elim(hd, {bits_of_int(64, int_add(gb, i))}), c0, fm)
        show by defs(simp(expand(c0, x86_64_linux.fetchable, x86_64_linux.can_access, abi.stack_page, x86_64_linux.mapped), nb, vme), x86_64_linux.fetchable, x86_64_linux.can_access, abi.stack_page, x86_64_linux.mapped)
      qed
      have s: all x0. x0 in omega -> x0 in st -> x86_64_linux.mapped(app(w, "vm"), int_div(x0, x86_64_linux.PAGE)) && !abi.stack_page(app(w, "vm"), int_div(x0, x86_64_linux.PAGE)) proof
        fix x0
        assume h1 h2
        have s0 := mp(all_elim(hs, {x0}), h1, h2)
        show by defs(simp(expand(s0, abi.stack_page, x86_64_linux.mapped), vme), abi.stack_page, x86_64_linux.mapped)
      qed
      have cg: abi.code_at(app(w, "vm"), gb, gc) by defs(g, abi.code_at)
      show by defs(taut(cg, s), abi.loaded)
    qed
    have ev: subset(app(app(w0, "os"), "events"), app(app(w, "os"), "events")) := rewrite(sym(ose), subset_refl[s := app(app(w0, "os"), "events")], {2})
    have cpe: app(w, "cpu") = app(w0, "cpu") by simp(he)
    show by defs(taut(rewrite(sym(ose), refl({app(app(w0, "os"), "input")}), {1}), ev, l, cpe), tr.returns_valid)
  qed
  show by taut(expand(h, tr.wr_only), c1, c2)
qed

// one more byte stored where s may write
theorem tr.wr_only_step: all s w x c. tr.wr_only(s, w) -> tr.wbl(s, x) ->
  tr.wr_only(s, fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", fn_update(app(app(w, "vm"), "bytes"), x, c))))
proof
  fix s w x c
  assume h hx
  let BS := app(app(s, "vm"), "bytes")
  let NEW := fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", fn_update(app(app(w, "vm"), "bytes"), x, c)))
  // (the new bytes differ from s's at x, or where the old ones did)
  have d: all b. (all a. !(app(b, a) = app(BS, a)) -> tr.wbl(s, a)) ->
      (all a. !(app(fn_update(b, x, c), a) = app(BS, a)) -> tr.wbl(s, a)) proof
    fix b
    assume hb
    fix a
    assume hn
    have o: !(a = x) -> app(fn_update(b, x, c), a) = app(b, a) := app_update_other[f := b, k := x, v := c, x := a]
    have e: a = x -> tr.wbl(s, a) proof
      assume ea
      show := rewrite(sym(ea), hx)
    qed
    have n: !(a = x) -> tr.wbl(s, a) proof
      assume hax
      show := mp(all_elim(hb, {a}), rewrite(mp(o, hax), hn))
    qed
    show by taut(n, e)
  qed
  have c1: w = s -> tr.wr_only(s, NEW) proof
    assume e
    have r: all a. !(app(BS, a) = app(BS, a)) -> tr.wbl(s, a) proof
      fix a
      assume hn
      show by taut(hn, refl({app(BS, a)}))
    qed
    have d1 := mp(all_elim(d, {BS}), r)
    have ne: NEW = fn_update(s, "vm", fn_update(app(s, "vm"), "bytes", fn_update(BS, x, c))) by simp(e)
    have ex: ex b. NEW = fn_update(s, "vm", fn_update(app(s, "vm"), "bytes", b)) && (all a. !(app(b, a) = app(BS, a)) -> tr.wbl(s, a))
      by ex_intro({fn_update(BS, x, c)}, taut(ne, d1))
    show by defs(taut(ex), tr.wr_only)
  qed
  have c2: (ex b. w = fn_update(s, "vm", fn_update(app(s, "vm"), "bytes", b)) && (all a. !(app(b, a) = app(BS, a)) -> tr.wbl(s, a))) ->
      tr.wr_only(s, NEW) proof
    assume hb0
    obtain b, he hb from hb0
    have d1 := mp(all_elim(d, {b}), hb)
    have ne: NEW = fn_update(s, "vm", fn_update(app(s, "vm"), "bytes", fn_update(b, x, c))) by simp(he,
      fn_update_twice[f := app(s, "vm"), k := "bytes", a := b, b := fn_update(b, x, c)],
      fn_update_twice[f := s, k := "vm", a := fn_update(app(s, "vm"), "bytes", b), b := fn_update(app(s, "vm"), "bytes", fn_update(b, x, c))])
    have ex: ex b. NEW = fn_update(s, "vm", fn_update(app(s, "vm"), "bytes", b)) && (all a. !(app(b, a) = app(BS, a)) -> tr.wbl(s, a))
      by ex_intro({fn_update(b, x, c)}, taut(ne, d1))
    show by defs(taut(ex), tr.wr_only)
  qed
  show by taut(expand(h, tr.wr_only), c1, c2)
qed

// (a program's run: its relation)
theorem tr.runs_elim(x y. r): all s o. runs(mkprog(x y. r(x, y)), s, o) -> r(s, o)
proof
  fix s o
  assume h
  show by simp(h)
qed

// (a byte of an access usable for writing: one the world may write)
theorem tr.usable_wbl: all w a n j. gimple.usable(app(w, "vm"), app(w, "objs"), a, n, true) -> a in bits(64) -> j in omega -> int_lt(j, n) ->
  tr.wbl(w, bits_add(64, a, bits_of_int(64, j)))
proof
  fix w a n j
  assume hu ha hj hn
  have e := apply(tr.usable_ea, {app(w, "vm")}, {app(w, "objs")}, {a}, {n}, {true}, {j}, hu, ha, hj, hn)
  let X := int_add(a, j)
  let P := int_div(X, x86_64_linux.PAGE)
  let C := x86_64_linux.mapped(app(w, "vm"), P) && !(app(snd(app(app(app(w, "vm"), "pages"), P)), "kind") = 2)
  let PW := app(app(snd(app(app(app(w, "vm"), "pages"), P)), "prot"), "w")
  let PR := app(app(snd(app(app(app(w, "vm"), "pages"), P)), "prot"), "r")
  have ui := mp(all_elim(expand(hu, gimple.usable), {j}), hj, hn)
  have pe: x86_64_linux.page_of(X) = P by defs(simp(), x86_64_linux.page_of)
  have c1: C -> tr.wbl(w, X) proof
    assume hc
    have ip := rewrite(mp(ite_t[c := C, a := ite(true, PW, PR), b := int_lt(X, int_pow(2, 64)) && X in app(w, "objs")], hc), ui)
    have pw: PW by simp(ip)
    have ca: x86_64_linux.can_access(app(w, "vm"), X, 1) by defs(simp(pe, expand(hc, x86_64_linux.mapped), pw), x86_64_linux.can_access, x86_64_linux.mapped, x86_64_linux.hw_allows, x86_64_linux.accessible)
    show by taut(ca)
  qed
  have c2: !C -> tr.wbl(w, X) proof
    assume hc
    have ho0 := rewrite(mp(ite_f[c := C, a := ite(true, PW, PR), b := int_lt(X, int_pow(2, 64)) && X in app(w, "objs")], hc), ui)
    have xo: X in app(w, "objs") by taut(ho0)
    have nc: !(x86_64_linux.mapped(app(w, "vm"), x86_64_linux.page_of(X)) && !abi.stack_page(app(w, "vm"), x86_64_linux.page_of(X))) by defs(simp(pe, hc), abi.stack_page)
    show by taut(xo, nc)
  qed
  have r: tr.wbl(w, X) by taut(c1, c2)
  show := rewrite(sym(e), r)
qed

// writing n bytes at a, usable for writing: only bytes s may write
// changed (the loop by its invariant)
theorem tr.write_wr: all s a n v s2 r. runs(gimple.write_bytes(a, n, v), s, ok(s2, r)) -> gimple.usable(app(s, "vm"), app(s, "objs"), a, n, true) -> a in bits(64) -> tr.wr_only(s, s2)
proof
  fix s a n v s2 r
  assume h hu ha
  let B(x4, x5) := (int_lt(snd(x4), n) && x5 = ok(pair(fn_update(fst(x4), "vm", fn_update(app(fst(x4), "vm"), "bytes", fn_update(app(app(fst(x4), "vm"), "bytes"),
      bits_add(64, a, bits_of_int(64, snd(x4))), bits_of_int(8, int_div(v, int_pow(256, snd(x4))))))), int_add(snd(x4), 1)), empty)) ||
    (!int_lt(snd(x4), n) && x5 = exc(pair(fst(x4), snd(x4)), pair("brk", empty)))
  let TR(x4) := fn_update(empty, "os.events", app(app(fst(x4), "os"), "events"))
  have h1 := expand(apply(tr.runs_elim, expand(h, gimple.write_bytes)), letin)
  obtain x3, hw hd from h1
  // the invariant: only bytes s may write changed, the count a number
  have st: all l l2. tr.wr_only(s, fst(l)) && snd(l) in omega -> true -> B(l, ok(l2, empty)) -> tr.wr_only(s, fst(l2)) && snd(l2) in omega proof
    fix l l2
    assume hp _ hb
    have hwo ho := hp
    have c1: int_lt(snd(l), n) && ok(l2, empty) = ok(pair(fn_update(fst(l), "vm", fn_update(app(fst(l), "vm"), "bytes", fn_update(app(app(fst(l), "vm"), "bytes"),
        bits_add(64, a, bits_of_int(64, snd(l))), bits_of_int(8, int_div(v, int_pow(256, snd(l))))))), int_add(snd(l), 1)), empty) -> tr.wr_only(s, fst(l2)) && snd(l2) in omega proof
      assume hc
      have hlt he := hc
      have e2: l2 = pair(fn_update(fst(l), "vm", fn_update(app(fst(l), "vm"), "bytes", fn_update(app(app(fst(l), "vm"), "bytes"),
        bits_add(64, a, bits_of_int(64, snd(l))), bits_of_int(8, int_div(v, int_pow(256, snd(l))))))), int_add(snd(l), 1)) by simp(he)
      // the byte's address: writable in s
      have h0: int_le(0, a) by simp(ha)
      have cw2 := apply(tr.usable_wbl, {s}, {a}, {n}, {snd(l)}, hu, ha, ho, hlt)
      have w2 := apply(tr.wr_only_step, {s}, {fst(l)}, {bits_add(64, a, bits_of_int(64, snd(l)))}, {bits_of_int(8, int_div(v, int_pow(256, snd(l))))}, hwo, cw2)
      show by simp(e2, w2, ho)
    qed
    have c2: !int_lt(snd(l), n) && ok(l2, empty) = exc(pair(fst(l), snd(l)), pair("brk", empty)) -> tr.wr_only(s, fst(l2)) && snd(l2) in omega proof
      assume hc
      show by simp(hc.2)
    qed
    show by taut(hb, c1, c2)
  qed
  have p0: tr.wr_only(s, fst(pair(s, 0))) && snd(pair(s, 0)) in omega by defs(simp(), tr.wr_only)
  have iv := mp(while_inv[l0 := pair(s, 0), c := l. true, b := x4 x5. B(x4, x5), tr := x4. TR(x4), r := x3, p := l. tr.wr_only(s, fst(l)) && snd(l) in omega], p0, st, hw)
  // the exit: the "brk" of a state with the invariant (no return from a divergence)
  have d1: (ex t. x3 = diverge(t)) -> tr.wr_only(s, s2) proof
    assume e
    obtain t, et from e
    show by simp(rewrite(et, hd))
  qed
  have d2: (ex l. (tr.wr_only(s, fst(l)) && snd(l) in omega) && ((!true && x3 = ok(l, empty)) || ((true && B(l, x3)) && !is_ok(x3)))) -> tr.wr_only(s, s2) proof
    assume e
    obtain l, hwo _ hc from e
    have xe: x3 = exc(pair(fst(l), snd(l)), pair("brk", empty)) by simp(hc)
    have es: s2 = fst(l) by simp(rewrite(xe, hd))
    show := rewrite(sym(es), hwo)
  qed
  show by taut(iv, d1, d2)
qed

// p + d's address, when defined: the state kept
theorem tr.padd_fwd: all w p d s1 v. runs(gimple.padd(p, d), w, ok(s1, v)) ->
  int_le(0, int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), d))) ->
  int_lt(int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), d)), 18446744073709551616) ->
  s1 = w && v = bits_add(64, int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), d)), 0)
proof
  fix w p d s1 v
  assume h h0 h1
  show by simp(expand(h, gimple.padd, gimple.binop, gimple.arith, gimple.fits, gimple.wrap), h0, h1)
qed

// a memory access's definedness: a pointer, its address in range, the bytes usable
def tr.mem_def(w, p, off, n, wr) := !(p = 0) && int_le(0, int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), off))) &&
  int_lt(int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), off)), 18446744073709551616) &&
  gimple.usable(app(w, "vm"), app(w, "objs"), bits_add(64, int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), off)), 0), n, wr)

theorem tr.mem_fwd: all w p off n wr s1 v. runs(gimple.mem(p, off, n, wr), w, ok(s1, v)) -> tr.mem_def(w, p, off, n, wr) ->
  s1 = w && v = bits_add(64, int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), off)), 0)
proof
  fix w p off n wr s1 v
  assume h hd
  have d0 d1 d2 d3 := expand(hd, tr.mem_def)
  have pf := all_elim(tr.padd_fwd, {w}, {p}, {off})
  show by simp(expand(h, gimple.mem), d0, d1, d2, d3, pf, keep(gimple.padd))
qed

theorem tr.mem_ub: all w p off n wr x e. w in univ(1) -> x in univ(1) -> e in univ(1) -> !tr.mem_def(w, p, off, n, wr) -> runs(gimple.mem(p, off, n, wr), w, exc(x, e))
proof
  fix w p off n wr x e
  assume hw hx he hn
  show by defs(simp(hw, hx, he, expand(hn, tr.mem_def)), gimple.mem, gimple.padd, gimple.binop, gimple.arith, gimple.fits, gimple.wrap)
qed

// a store of n bytes (st8, st32, ..): its address, then the bytes written
theorem tr.eff_storen: all w p off n v. tr.eff(w, o. runs(mkprog(x0 x1. bind_rel(gimple.mem(p, off, n, true), x0, x2 x3. bind_rel(gimple.write_bytes(x3, n, v), x2,
  x4 x5. x1 = ok(x4, empty), x4 x5. x1 = exc(x4, x5), x4. x1 = diverge(x4)), x2 x3. x1 = exc(x2, x3), x2. x1 = diverge(x2))), w, o))
proof
  fix w p off n v
  let ST := mkprog(x0 x1. bind_rel(gimple.mem(p, off, n, true), x0, x2 x3. bind_rel(gimple.write_bytes(x3, n, v), x2,
    x4 x5. x1 = ok(x4, empty), x4 x5. x1 = exc(x4, x5), x4. x1 = diverge(x4)), x2 x3. x1 = exc(x2, x3), x2. x1 = diverge(x2)))
  let AD := bits_add(64, int_add(p, gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), off)), 0)
  // defined: only bytes w may write changed
  have a1: tr.mem_def(w, p, off, n, true) -> (all w2 r. runs(ST, w, ok(w2, r)) -> tr.returns_valid(w, w2)) proof
    assume hd
    fix w2 r
    assume h
    obtain o1, hm hc from expand(apply(tr.runs_elim, h), bind_rel)
    have c1: (ex s1 a1. o1 = ok(s1, a1) && (ex o2. runs(gimple.write_bytes(a1, n, v), s1, o2) && (((ex s3 r3. o2 = ok(s3, r3) && ok(w2, r) = ok(s3, empty)) ||
        (ex s3 e3. o2 = exc(s3, e3) && ok(w2, r) = exc(s3, e3))) || (ex t. o2 = diverge(t) && ok(w2, r) = diverge(t))))) ->
        tr.returns_valid(w, w2) proof
      assume e1
      obtain s1 a1, eo hb from e1
      have m := mp(all_elim(tr.mem_fwd, {w}, {p}, {off}, {n}, {true}, {s1}, {a1}), rewrite(eo, hm), hd)
      have es ea := m
      obtain o2, hw hc2 from hb
      have d2: (ex s3 r3. o2 = ok(s3, r3) && ok(w2, r) = ok(s3, empty)) -> tr.returns_valid(w, w2) proof
        assume e2
        obtain s3 r3, eo2 ee from e2
        have e3: w2 = s3 by simp(ee)
        have hw2 := rewrite(es, rewrite(ea, rewrite(eo2, hw)))
        have hu: gimple.usable(app(w, "vm"), app(w, "objs"), AD, n, true) by taut(expand(hd, tr.mem_def))
        have ab: AD in bits(64) by simp()
        have wo := mp(all_elim(tr.write_wr, {w}, {AD}, {n}, {v}, {s3}, {r3}), hw2, hu, ab)
        show := rewrite(sym(e3), mp(all_elim(tr.wr_only_valid, {w}, {s3}), wo))
      qed
      have d3: (ex s3 e3. o2 = exc(s3, e3) && ok(w2, r) = exc(s3, e3)) -> tr.returns_valid(w, w2) proof
        assume e2
        obtain s3 e3, _ ee from e2
        show by simp(ee)
      qed
      have d4: (ex t. o2 = diverge(t) && ok(w2, r) = diverge(t)) -> tr.returns_valid(w, w2) proof
        assume e2
        obtain t, _ ee from e2
        show by simp(ee)
      qed
      show by taut(hc2, d2, d3, d4)
    qed
    have c2: (ex s1 e1. o1 = exc(s1, e1) && ok(w2, r) = exc(s1, e1)) -> tr.returns_valid(w, w2) proof
      assume e2
      obtain s1 e1, _ ee from e2
      show by simp(ee)
    qed
    have c3: (ex t. o1 = diverge(t) && ok(w2, r) = diverge(t)) -> tr.returns_valid(w, w2) proof
      assume e2
      obtain t, _ ee from e2
      show by simp(ee)
    qed
    show by taut(hc, c1, c2, c3)
  qed
  // undefined: every exception (the address's)
  have a2: w in univ(1) -> !tr.mem_def(w, p, off, n, true) -> (all x e. x in univ(1) -> e in univ(1) -> runs(ST, w, exc(x, e))) proof
    assume hw hn
    fix x e
    assume hx he
    have mu := mp(all_elim(tr.mem_ub, {w}, {p}, {off}, {n}, {true}, {x}, {e}), hw, hx, he, hn)
    show by simp(hw, hx, he, mu, keep(gimple.mem, gimple.write_bytes))
  qed
  have a3: !(w in univ(1)) -> (all w2 r. runs(ST, w, ok(w2, r)) -> tr.returns_valid(w, w2)) proof
    assume hn
    fix w2 r
    assume h
    show by taut(hn, apply(tr.runs_univ, h))
  qed
  show by defs(taut(a1, a2, a3), tr.eff)
qed

theorem tr.eff_st8: all w p off v. tr.eff(w, o. runs(gimple.st8(p, off, v), w, o))
proof
  fix w p off v
  show by defs(all_elim(tr.eff_storen, {w}, {p}, {off}, {1}, {v}), gimple.st8)
qed

theorem tr.eff_st32: all w p off v. tr.eff(w, o. runs(gimple.st32(p, off, v), w, o))
proof
  fix w p off v
  show by defs(all_elim(tr.eff_storen, {w}, {p}, {off}, {4}, {v}), gimple.st32)
qed

theorem tr.eff_st64: all w p off v. tr.eff(w, o. runs(gimple.st64(p, off, v), w, o))
proof
  fix w p off v
  show by defs(all_elim(tr.eff_storen, {w}, {p}, {off}, {8}, {v}), gimple.st64)
qed

// a loop (states: the world and the locals): each iteration's body's
// effect from its state. A run's states keep the world valid along it,
// unless the body is undefined at one of them -- then the run up to there
// (while_prefix) makes the loop undefined.
theorem tr.seff_while(l. c, l o. b, l. tr, loc): all w. (all l. c(l) -> tr.seff(fst(l), o. b(l, o))) ->
  tr.seff(w, x. while_rel(pair(w, loc), l. c(l), l o. b(l, o), l. tr(l), x))
proof
  fix w
  assume hb
  let L0 := pair(w, loc)
  let UB(l) := all y e. y in univ(1) -> e in univ(1) -> (ex l2. b(l, exc(pair(y, l2), pair("raise", e))))
  let U := ex f k. k in omega && app(f, empty) = L0 && (all i. i in k -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) && c(app(f, k)) && UB(app(f, k))
  // undefined at a state of a run: the loop undefined
  have ua: U -> (all y e. y in univ(1) -> e in univ(1) -> (ex l2. while_rel(L0, l. c(l), l o. b(l, o), l. tr(l), exc(pair(y, l2), pair("raise", e))))) proof
    assume hu
    obtain f k, hk h0 hst hc hub from hu
    fix y e
    assume hy he
    obtain l2, bx from mp(all_elim(hub, {y}, {e}), hy, he)
    have nk: !is_ok(exc(pair(y, l2), pair("raise", e))) by defs(simp(), is_ok)
    have wp := mp(while_prefix[l0 := L0, c := l. c(l), b := l o. b(l, o), tr := l. tr(l), r := exc(pair(y, l2), pair("raise", e)), f := f, k := k], hk, h0, hst, hc, bx, nk)
    show by ex_intro({l2}, wp)
  qed
  // otherwise: along a run, the world valid
  have uc: !U -> (all x. while_rel(L0, l. c(l), l o. b(l, o), l. tr(l), x) -> (fst(x) = 0 || (fst(x) = 1 && !(fst(out_value(x)) = "raise"))) -> tr.returns_valid(w, fst(out_state(x)))) proof
    assume hn
    fix x
    assume hw hr
    have fin: (ex n f. n in omega && is_fun(f) && dom(f) = succ(n) && app(f, empty) = L0 &&
        (all i. i in n -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) &&
        ((!c(app(f, n)) && x = ok(app(f, n), empty)) || (c(app(f, n)) && b(app(f, n), x) && !is_ok(x)))) -> tr.returns_valid(w, fst(out_state(x))) proof
      assume h
      obtain n f, hn0 _ _ hf0 hst hex from h
      // the body at a state of this run (up to n) is not undefined there
      have nu: all k. k in omega -> int_le(k, n) -> c(app(f, k)) -> !UB(app(f, k)) proof
        fix k
        assume hk hkn hck
        have st: all i. i in k -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty)) proof
          fix i
          assume hi
          have io := mp(nat_elem[k := k, i := i], hk, hi)
          have in2: i in n by arith(hk, hkn, hi, io, hn0)
          show := mp(all_elim(hst, {i}), in2)
        qed
        have uu: UB(app(f, k)) -> U proof
          assume hub
          show by ex_intro({f}, {k}, taut(hk, hf0, st, hck, hub))
        qed
        show by taut(hn, uu)
      qed
      // the body's valid steps from a state of the run
      have bv: all k. k in omega -> int_le(k, n) -> c(app(f, k)) ->
          (all z. b(app(f, k), z) -> (fst(z) = 0 || (fst(z) = 1 && !(fst(out_value(z)) = "raise"))) -> tr.returns_valid(fst(app(f, k)), fst(out_state(z)))) proof
        fix k
        assume hk hkn hck
        have e := expand(mp(all_elim(hb, {app(f, k)}), hck), tr.seff)
        show by taut(e, mp(all_elim(nu, {k}), hk, hkn, hck))
      qed
      // every state up to n: the world valid from w
      have base: int_le(0, n) -> tr.returns_valid(w, fst(app(f, 0))) proof
        assume _
        have e0: fst(app(f, 0)) = w by simp(rewrite(sym(lit_zero), hf0))
        show := rewrite(sym(e0), all_elim(tr.rv_refl, {w}), {2})
      qed
      have step: all i. i in omega -> (int_le(i, n) -> tr.returns_valid(w, fst(app(f, i)))) -> (int_le(int_add(i, 1), n) -> tr.returns_valid(w, fst(app(f, int_add(i, 1))))) proof
        fix i
        assume hi ih hl
        have le: int_le(i, n) by arith(hi, hl)
        have lt: i in n by arith(hi, hl, hn0)
        have ci bi := mp(all_elim(hst, {i}), lt)
        have es: succ(i) = int_add(i, 1) by arith(hi)
        have bi2 := rewrite(es, bi)
        have z0: fst(ok(app(f, int_add(i, 1)), empty)) = 0 || (fst(ok(app(f, int_add(i, 1)), empty)) = 1 && !(fst(out_value(ok(app(f, int_add(i, 1)), empty))) = "raise")) by simp()
        have r1 := mp(all_elim(bv, {i}), hi, le, ci)
        have r2 := mp(all_elim(r1, {ok(app(f, int_add(i, 1)), empty)}), bi2, z0)
        have os: fst(out_state(ok(app(f, int_add(i, 1)), empty))) = fst(app(f, int_add(i, 1))) by simp()
        show := mp(all_elim(tr.rv_trans, {w}, {fst(app(f, i))}, {fst(app(f, int_add(i, 1)))}), mp(ih, le), rewrite(os, r2))
      qed
      have all := mp(nat_ind[p := k. int_le(k, n) -> tr.returns_valid(w, fst(app(f, k)))], base, step)
      have rn := mp(all_elim(all, {n}), hn0, (int_le(n, n) by arith(hn0)))
      // the exit: the loop's condition failing, or the body leaving
      have x1: (!c(app(f, n)) && x = ok(app(f, n), empty)) -> tr.returns_valid(w, fst(out_state(x))) proof
        assume hc
        have e1: fst(out_state(x)) = fst(app(f, n)) by simp(hc.2)
        show := rewrite(sym(e1), rn)
      qed
      have x2: (c(app(f, n)) && b(app(f, n), x) && !is_ok(x)) -> tr.returns_valid(w, fst(out_state(x))) proof
        assume hc
        have hcn hbx .. := hc
        have r1 := mp(all_elim(bv, {n}), hn0, (int_le(n, n) by arith(hn0)), hcn)
        show := mp(all_elim(tr.rv_trans, {w}, {fst(app(f, n))}, {fst(out_state(x))}), rn, mp(all_elim(r1, {x}), hbx, hr))
      qed
      show by taut(hex, x1, x2)
    qed
    have inf: (ex f. is_fun(f) && dom(f) = omega && app(f, empty) = L0 &&
        (all i. i in omega -> c(app(f, i)) && b(app(f, i), ok(app(f, succ(i)), empty))) &&
        x = diverge(trace_limit(i. tr(app(f, i))))) -> tr.returns_valid(w, fst(out_state(x))) proof
      assume h
      obtain f, _ _ _ _ hx from h
      show by simp(rewrite(hx, hr))
    qed
    show by taut(expand(hw, while_rel), fin, inf)
  qed
  show by defs(taut(ua, uc), tr.seff)
qed

// after a loop: its normal or "brk" exit goes on
theorem tr.eff_seq_loop(x. a, x o. k): all w. tr.seff(w, x. a(x)) -> (all x. a(x) -> (fst(x) = 0 || (fst(x) = 1 && fst(out_value(x)) = "brk")) -> tr.eff(fst(out_state(x)), o. k(x, o))) ->
  tr.eff(w, o. ex x. a(x) && (((fst(x) = 0 || (fst(x) = 1 && fst(out_value(x)) = "brk")) && k(x, o)) || ((((fst(x) = 1 && fst(out_value(x)) = "ret") && o = ok(fst(out_state(x)), snd(out_value(x)))) ||
    ((fst(x) = 1 && fst(out_value(x)) = "raise") && o = exc(fst(out_state(x)), snd(out_value(x))))) || (fst(x) = 2 && o = diverge(snd(x))))))
proof
  fix w
  assume ha hk
  let Q(o) := ex x. a(x) && (((fst(x) = 0 || (fst(x) = 1 && fst(out_value(x)) = "brk")) && k(x, o)) || ((((fst(x) = 1 && fst(out_value(x)) = "ret") && o = ok(fst(out_state(x)), snd(out_value(x)))) ||
    ((fst(x) = 1 && fst(out_value(x)) = "raise") && o = exc(fst(out_state(x)), snd(out_value(x))))) || (fst(x) = 2 && o = diverge(snd(x)))))
  // the statement undefined: a raise of anything
  have ua: (all y e. y in univ(1) -> e in univ(1) -> (ex l. a(exc(pair(y, l), pair("raise", e))))) -> (all y e. y in univ(1) -> e in univ(1) -> Q(exc(y, e))) proof
    assume hu
    fix y e
    assume hy he
    obtain l, hl from mp(all_elim(hu, {y}, {e}), hy, he)
    show by ex_intro({exc(pair(y, l), pair("raise", e))}, simp(hl))
  qed
  // a normal outcome after which the rest is undefined
  have ub: (ex x. a(x) && (fst(x) = 0 || (fst(x) = 1 && fst(out_value(x)) = "brk")) && (all y e. y in univ(1) -> e in univ(1) -> k(x, exc(y, e)))) -> (all y e. y in univ(1) -> e in univ(1) -> Q(exc(y, e))) proof
    assume h
    obtain x, hx h0 hu from h
    fix y e
    assume hy he
    have kx := mp(all_elim(hu, {y}, {e}), hy, he)
    show by ex_intro({x}, taut(hx, h0, kx))
  qed
  // otherwise: every return valid
  have uc: (all x. a(x) -> (fst(x) = 0 || (fst(x) = 1 && !(fst(out_value(x)) = "raise"))) -> tr.returns_valid(w, fst(out_state(x)))) ->
      !(ex x. a(x) && (fst(x) = 0 || (fst(x) = 1 && fst(out_value(x)) = "brk")) && (all y e. y in univ(1) -> e in univ(1) -> k(x, exc(y, e)))) -> (all w2 v. Q(ok(w2, v)) -> tr.returns_valid(w, w2)) proof
    assume hv hn
    fix w2 v
    assume hq
    obtain x, hx hd from hq
    have c1: ((fst(x) = 0 || (fst(x) = 1 && fst(out_value(x)) = "brk")) && k(x, ok(w2, v))) -> tr.returns_valid(w, w2) proof
      assume h1
      have h0 kx := h1
      have ek := expand(mp(all_elim(hk, {x}), hx, h0), tr.eff)
      have nu: (all y e. y in univ(1) -> e in univ(1) -> k(x, exc(y, e))) -> false proof
        assume hu
        have ex: ex x. a(x) && (fst(x) = 0 || (fst(x) = 1 && fst(out_value(x)) = "brk")) && (all y e. y in univ(1) -> e in univ(1) -> k(x, exc(y, e))) by ex_intro({x}, taut(hx, h0, hu))
        show by taut(hn, ex)
      qed
      have kv: all w3 v3. k(x, ok(w3, v3)) -> tr.returns_valid(fst(out_state(x)), w3) by taut(ek, nu)
      have r1 := mp(all_elim(hv, {x}), hx, (fst(x) = 0 || (fst(x) = 1 && !(fst(out_value(x)) = "raise")) by simp(h0)))
      show := mp(all_elim(tr.rv_trans, {w}, {fst(out_state(x))}, {w2}), r1, mp(all_elim(kv, {w2}, {v}), kx))
    qed
    have c2: ((fst(x) = 1 && fst(out_value(x)) = "ret") && ok(w2, v) = ok(fst(out_state(x)), snd(out_value(x)))) -> tr.returns_valid(w, w2) proof
      assume h2
      have hr1 hr2 he := h2
      have e2: w2 = fst(out_state(x)) by simp(he)
      have r1 := mp(all_elim(hv, {x}), hx, (fst(x) = 0 || (fst(x) = 1 && !(fst(out_value(x)) = "raise")) by simp(hr1, hr2)))
      show := rewrite(sym(e2), r1)
    qed
    have c3: ((fst(x) = 1 && fst(out_value(x)) = "raise") && ok(w2, v) = exc(fst(out_state(x)), snd(out_value(x)))) -> tr.returns_valid(w, w2) proof
      assume h3
      show by simp(h3.3)
    qed
    have c4: (fst(x) = 2 && ok(w2, v) = diverge(snd(x))) -> tr.returns_valid(w, w2) proof
      assume h4
      show by simp(h4.2)
    qed
    show by taut(hd, c1, c2, c3, c4)
  qed
  have ea := expand(ha, tr.seff)
  show by defs(taut(ea, ua, ub, uc), tr.eff)
qed

// a block inside a loop: its "brk" passed on
theorem tr.seff_seq_brk(x. a, x y. k, x. l): all w. tr.seff(w, x. a(x)) -> (all x. a(x) -> fst(x) = 0 -> tr.seff(fst(out_state(x)), y. k(x, y))) ->
  tr.seff(w, y. ex x. a(x) && ((fst(x) = 0 && k(x, y)) || (((((fst(x) = 1 && fst(out_value(x)) = "ret") && y = exc(pair(fst(out_state(x)), l(x)), pair("ret", snd(out_value(x))))) ||
    ((fst(x) = 1 && fst(out_value(x)) = "raise") && y = exc(pair(fst(out_state(x)), l(x)), pair("raise", snd(out_value(x)))))) ||
    ((fst(x) = 1 && fst(out_value(x)) = "brk") && y = exc(pair(fst(out_state(x)), l(x)), pair("brk", empty)))) || (fst(x) = 2 && y = diverge(snd(x))))))
proof
  fix w
  assume ha hk
  let Q(y) := ex x. a(x) && ((fst(x) = 0 && k(x, y)) || (((((fst(x) = 1 && fst(out_value(x)) = "ret") && y = exc(pair(fst(out_state(x)), l(x)), pair("ret", snd(out_value(x))))) ||
    ((fst(x) = 1 && fst(out_value(x)) = "raise") && y = exc(pair(fst(out_state(x)), l(x)), pair("raise", snd(out_value(x)))))) ||
    ((fst(x) = 1 && fst(out_value(x)) = "brk") && y = exc(pair(fst(out_state(x)), l(x)), pair("brk", empty)))) || (fst(x) = 2 && y = diverge(snd(x)))))
  have ua: (all y e. y in univ(1) -> e in univ(1) -> (ex l2. a(exc(pair(y, l2), pair("raise", e))))) -> (all y e. y in univ(1) -> e in univ(1) -> (ex l2. Q(exc(pair(y, l2), pair("raise", e))))) proof
    assume hu
    fix y e
    assume hy he
    obtain l2, hl from mp(all_elim(hu, {y}, {e}), hy, he)
    show by ex_intro({l(exc(pair(y, l2), pair("raise", e)))}, ex_intro({exc(pair(y, l2), pair("raise", e))}, simp(hl)))
  qed
  have ub: (ex x. a(x) && fst(x) = 0 && (all y e. y in univ(1) -> e in univ(1) -> (ex l2. k(x, exc(pair(y, l2), pair("raise", e)))))) ->
      (all y e. y in univ(1) -> e in univ(1) -> (ex l2. Q(exc(pair(y, l2), pair("raise", e))))) proof
    assume h
    obtain x, hx h0 hu from h
    fix y e
    assume hy he
    obtain l2, kx from mp(all_elim(hu, {y}, {e}), hy, he)
    show by ex_intro({l2}, ex_intro({x}, taut(hx, h0, kx)))
  qed
  have uc: (all x. a(x) -> (fst(x) = 0 || (fst(x) = 1 && !(fst(out_value(x)) = "raise"))) -> tr.returns_valid(w, fst(out_state(x)))) ->
      !(ex x. a(x) && fst(x) = 0 && (all y e. y in univ(1) -> e in univ(1) -> (ex l2. k(x, exc(pair(y, l2), pair("raise", e)))))) ->
      (all z. Q(z) -> (fst(z) = 0 || (fst(z) = 1 && !(fst(out_value(z)) = "raise"))) -> tr.returns_valid(w, fst(out_state(z)))) proof
    assume hv hn
    fix z
    assume hq hr
    obtain x, hx hd from hq
    have c1: (fst(x) = 0 && k(x, z)) -> tr.returns_valid(w, fst(out_state(z))) proof
      assume h1
      have h0 kx := h1
      have ek := expand(mp(all_elim(hk, {x}), hx, h0), tr.seff)
      have nu: (all y e. y in univ(1) -> e in univ(1) -> (ex l2. k(x, exc(pair(y, l2), pair("raise", e))))) -> false proof
        assume hu
        have ex: ex x. a(x) && fst(x) = 0 && (all y e. y in univ(1) -> e in univ(1) -> (ex l2. k(x, exc(pair(y, l2), pair("raise", e))))) by ex_intro({x}, taut(hx, h0, hu))
        show by taut(hn, ex)
      qed
      have kv: all z2. k(x, z2) -> (fst(z2) = 0 || (fst(z2) = 1 && !(fst(out_value(z2)) = "raise"))) -> tr.returns_valid(fst(out_state(x)), fst(out_state(z2))) by taut(ek, nu)
      have r1 := mp(all_elim(hv, {x}), hx, (fst(x) = 0 || (fst(x) = 1 && !(fst(out_value(x)) = "raise")) by taut(h0)))
      show := mp(all_elim(tr.rv_trans, {w}, {fst(out_state(x))}, {fst(out_state(z))}), r1, mp(all_elim(kv, {z}), kx, hr))
    qed
    have c2: ((fst(x) = 1 && fst(out_value(x)) = "ret") && z = exc(pair(fst(out_state(x)), l(x)), pair("ret", snd(out_value(x))))) -> tr.returns_valid(w, fst(out_state(z))) proof
      assume h2
      have hr1 hr2 he := h2
      have e2: fst(out_state(z)) = fst(out_state(x)) by simp(he)
      have r1 := mp(all_elim(hv, {x}), hx, (fst(x) = 0 || (fst(x) = 1 && !(fst(out_value(x)) = "raise")) by simp(hr1, hr2)))
      show := rewrite(sym(e2), r1)
    qed
    have c3: ((fst(x) = 1 && fst(out_value(x)) = "raise") && z = exc(pair(fst(out_state(x)), l(x)), pair("raise", snd(out_value(x))))) -> tr.returns_valid(w, fst(out_state(z))) proof
      assume h3
      show by simp(h3.3, hr)
    qed
    have c5: ((fst(x) = 1 && fst(out_value(x)) = "brk") && z = exc(pair(fst(out_state(x)), l(x)), pair("brk", empty))) -> tr.returns_valid(w, fst(out_state(z))) proof
      assume h5
      have hr1 hr2 he := h5
      have e2: fst(out_state(z)) = fst(out_state(x)) by simp(he)
      have r1 := mp(all_elim(hv, {x}), hx, (fst(x) = 0 || (fst(x) = 1 && !(fst(out_value(x)) = "raise")) by simp(hr1, hr2)))
      show := rewrite(sym(e2), r1)
    qed
    have c4: (fst(x) = 2 && z = diverge(snd(x))) -> tr.returns_valid(w, fst(out_state(z))) proof
      assume h4
      show by simp(h4.2, hr)
    qed
    show by taut(hd, c1, c2, c3, c4, c5)
  qed
  have ea := expand(ha, tr.seff)
  show by defs(taut(ea, ua, ub, uc), tr.seff)
qed

// a loop body's exit, the world as it was
theorem tr.seff_brk: all w l v. tr.seff(w, y. y = exc(pair(w, l), pair("brk", v)))
proof
  fix w l v
  have g: all y. y = exc(pair(w, l), pair("brk", v)) -> (fst(y) = 0 || (fst(y) = 1 && !(fst(out_value(y)) = "raise"))) -> tr.returns_valid(w, fst(out_state(y))) proof
    fix y
    assume h _
    have e: fst(out_state(y)) = w by simp(h)
    show := rewrite(sym(e), all_elim(tr.rv_refl, {w}), {2})
  qed
  show by defs(taut(g), tr.seff)
qed
