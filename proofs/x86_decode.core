// The decoding table's guards, kernel-checked (the steps' option
// SLC_DECODE_PREP=kernel): a row of the table runs to `ok` only if the
// byte after the table's `before` program is the row's first byte. The
// steps directive proves each row's instance of these lemmas once, then
// evaluates `decode`'s guarded form (the elaborator's `decode_g`) for each
// encoding: rows of another first byte fall at their guards unopened.
// (The byte at a state's position is written out, `app(app(s, "bytes"),
// app(s, "pos"))`, as the rows have it.)
//
//   checked before the steps directive (proofs/chain)

// (after p from s, the byte is k)
def dec.opc_of(p, s, k) := ex s2 u. runs(p, s, ok(s2, u)) && app(app(s2, "bytes"), app(s2, "pos")) = k

// (q leaves the bytes and the position as they are)
def dec.keeps(q) := all s s1 w. runs(q, s, ok(s1, w)) -> app(s1, "bytes") = app(s, "bytes") && app(s1, "pos") = app(s, "pos")

// (a program's run: its relation)
theorem dec.runs_elim(x y. r): all s o. runs(mkprog(x y. r(x, y)), s, o) -> r(s, o)
proof
  fix s o
  assume h
  show by symex(h)
qed

// a row's byte test at state x2, its outcome ok: the byte
theorem dec.test_ok(x2, k, R, st, v): (app(app(x2, "bytes"), app(x2, "pos")) = k && R) || (!(app(app(x2, "bytes"), app(x2, "pos")) = k) && ok(st, v) = exc(x2, exc_val("nomatch", empty))) ->
  app(app(x2, "bytes"), app(x2, "pos")) = k
proof
  assume h
  have no: !(ok(st, v) = exc(x2, exc_val("nomatch", empty))) by defs(symex(), exc, ok)
  show by taut(h, no)
qed

// a bind whose other outcomes re-raise / diverge, its outcome ok: p's ok
// outcome and the continuation
theorem dec.bind_ok(p, s1 u. K, s, st, v): bind_rel(p, s, s1 u. K(s1, u), s1 e. ok(st, v) = exc(s1, e), t. ok(st, v) = diverge(t)) ->
  ex s1 u. runs(p, s, ok(s1, u)) && K(s1, u)
proof
  assume h
  obtain o, hr hc from expand(h, bind_rel)
  cases from hc
  case h proof
    obtain s1 u, he hk from h
    show by ex_intro({s1}, {u}, taut(rewrite(he, hr), hk))
  qed
  case h proof
    obtain s1 e, _ hx from h
    have no: !(ok(st, v) = exc(s1, e)) by defs(symex(), exc, ok)
    show by taut(hx, no)
  qed
  case h proof
    obtain t, _ hd from h
    have no: !(ok(st, v) = diverge(t)) by defs(symex(), diverge, ok)
    show by taut(hd, no)
  qed
qed

// A row is walked from its top (the `before` decoder p, x86: prefixes) to
// its first byte's test: through binds of decoders that keep the position
// (dec.bind_keeps) and lets; each continuation's byte fact carried back.

// the row's top: its outcome ok, p's ok continuation giving the byte --
// the byte after p
theorem dec.top(p, k, x2 x3 x1. K): all s st v. runs(mkprog(x0 x1. bind_rel(p, x0, x2 x3. K(x2, x3, x1), x2 x3. x1 = exc(x2, x3), x2. x1 = diverge(x2))), s, ok(st, v)) ->
  (all s1 u. K(s1, u, ok(st, v)) -> app(app(s1, "bytes"), app(s1, "pos")) = k) ->
  dec.opc_of(p, s, k)
proof
  fix s st v
  assume h hk
  obtain s2 u, hp hc from apply(dec.bind_ok, apply(dec.runs_elim, h))
  show by defs(ex_intro({s2}, {u}, taut(hp, mp(all_elim(hk, {s2}, {u}), hc))), dec.opc_of)
qed

// a decoder keeping the bytes and the position, its continuation giving
// the byte: the byte before it
theorem dec.bind_keeps(q, k, s, st, v, x4 x5. K): dec.keeps(q) -> (all s1 u. K(s1, u) -> app(app(s1, "bytes"), app(s1, "pos")) = k) ->
  bind_rel(q, s, x4 x5. K(x4, x5), x4 x5. ok(st, v) = exc(x4, x5), x4. ok(st, v) = diverge(x4)) -> app(app(s, "bytes"), app(s, "pos")) = k
proof
  assume hq hk hb
  obtain s1 u, hr hc from apply(dec.bind_ok, hb)
  have b1 := mp(all_elim(hk, {s1}, {u}), hc)
  have e1 e2 := mp(all_elim(expand(hq, dec.keeps), {s}, {s1}, {u}), hr)
  show := rewrite(e2, rewrite(e1, b1))
qed

// the decoders the rows run before their first byte: they set the context
// only
theorem dec.keeps_opsize: dec.keeps(x86_64_linux.opsize)
proof
  unfold dec.keeps
  fix s s1 w
  assume h
  show by symex(h)
qed

theorem dec.keeps_rep: dec.keeps(x86_64_linux.rep)
proof
  unfold dec.keeps
  fix s s1 w
  assume h
  show by symex(h)
qed

