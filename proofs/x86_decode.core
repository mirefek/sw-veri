// (a run's state and outcome: a set's pair)
theorem dec.runs_univ(x y. r): all s o. runs(mkprog(x y. r(x, y)), s, o) -> pair(s, o) in univ(1)
proof
  fix s o
  assume h
  have u := unsel(expand(h, runs, mkprog))
  show by taut(u)
qed

// p's run to ok: the `before` program's (p, then ok with no value)
theorem dec.before_intro(p): all s s2 u. pair(s, ok(s2, empty)) in univ(1) -> runs(p, s, ok(s2, u)) ->
  runs(mkprog(x0 x1. bind_rel(p, x0, x2 x3. x1 = ok(x2, empty), x2 x3. x1 = exc(x2, x3), x2. x1 = diverge(x2))), s, ok(s2, empty))
proof
  fix s s2 u
  assume hu hr
  have hb: bind_rel(p, s, x2 x3. ok(s2, empty) = ok(x2, empty), x2 x3. ok(s2, empty) = exc(x2, x3), x2. ok(s2, empty) = diverge(x2)) by defs(ex_intro(symex(hr)), bind_rel)
  show by defs(symex(hu, hb), runs, mkprog)
qed

// the table's guard, from a row's: after prefixes from b's start the byte
// is k
theorem dec.opc_intro: all b k. dec.opc_of(x86_64_linux.prefixes, fn_update(fn_update(fn_update(empty, "bytes", b), "pos", 0), "ctx", x86_64_linux.START), k) -> x86_64_linux.x86.opc(b, k)
proof
  fix b k
  assume h
  obtain s2 u, hr hb from expand(h, dec.opc_of)
  have hu := apply(dec.runs_univ, expand(hr, x86_64_linux.prefixes))
  have hu2: pair(fn_update(fn_update(fn_update(empty, "bytes", b), "pos", 0), "ctx", x86_64_linux.START), ok(s2, empty)) in univ(1) by symex(hu)
  have rb := apply(dec.before_intro, hu2, hr)
  show by defs(ex_intro({s2}, {empty}, taut(rb, hb)), x86_64_linux.x86.opc, x86_64_linux.x86.before)
qed

// (a selection's members, its condition replaced by an equivalent one)
theorem dec.sel_cong(S, z. P, z. Q): (all z. P(z) <-> Q(z)) -> all x. x in set_select(S, z. P(z)) <-> x in set_select(S, z. Q(z))
proof
  assume he
  fix x
  have e := all_elim(he, {x})
  have a := set_select_def[s := S, z := x, p := z. P(z)]
  have c := set_select_def[s := S, z := x, p := z. Q(z)]
  show by taut(e, a, c)
qed

// (decode's condition and decode_g's: equivalent alternative by alternative)
theorem dec.or_cong(a1, a2, b1, b2): (a1 <-> b1) -> (a2 <-> b2) -> ((a1 || a2) <-> (b1 || b2))
proof
  assume h1 h2
  show by taut(h1, h2)
qed

theorem dec.guard_iff(a, g): (a -> g) -> (a <-> (g && a))
proof
  assume h
  show by taut(h)
qed

theorem dec.iff_refl(a): a <-> a
proof
  show by taut()
qed

// (the members of S2 are those of S1: S1's are too)
theorem dec.members_conv(S1, S2, x. R): (all x. x in S1 <-> x in S2) -> (all x. x in S2 <-> R(x)) -> all x. x in S1 <-> R(x)
proof
  assume h1 h2
  fix x
  show by taut(all_elim(h1, {x}), all_elim(h2, {x}))
qed

// a row's alternative in decode (its run from b's start, and the member
// picked): the row's guard, by its theorem
theorem dec.alt_guard(r, k, b, st v. Z): (all s st v. runs(r, s, ok(st, v)) -> dec.opc_of(x86_64_linux.prefixes, s, k)) ->
  (ex st v. runs(r, fn_update(fn_update(fn_update(empty, "bytes", b), "pos", 0), "ctx", x86_64_linux.START), ok(st, v)) && Z(st, v)) -> x86_64_linux.x86.opc(b, k)
proof
  assume hr ha
  obtain st v, hrun _ from ha
  show := apply(dec.opc_intro, mp(all_elim(hr, {fn_update(fn_update(fn_update(empty, "bytes", b), "pos", 0), "ctx", x86_64_linux.START)}, {st}, {v}), hrun))
qed
