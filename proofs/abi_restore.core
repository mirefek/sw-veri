theorem abi.restore_run: all saved X. X in univ(1) -> saved in univ(1) -> runs(abi.abi_restore(saved), X, ok(fn_update(X, "gpr", fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(app(X, "gpr"), 3, app(saved, 3)), 5, app(saved, 5)), 12, app(saved, 12)), 13, app(saved, 13)), 14, app(saved, 14)), 15, app(saved, 15))), empty))
proof
  fix saved X
  assume xu su
  have lp := all_elim(all_elim(abi.restore_loop, {saved}), {X})
  show by simp(xu, su, lp)
qed

// A normal return (abi_function's first branch): from the entry state s,
// with v the spec's view of memory, the spec's outcome (r0, r1) in world w2,
// the memory written back as nv, and g, xm, fl the havoc's choice of
// registers -- the outcome is N: the callee-saved registers restored, rsp,
// rax, rdx, df and rip set. (The machine's final state is shown equal to N
// field by field, with records.core.)
theorem abi.ret_intro: all f spec args objs mem s nv w2 r0 r1 g xm fl.
  s in univ(1) -> objs in univ(1) -> mem in univ(1) -> app(s, "vm") in x86_64_linux.Vm -> app(app(s, "gpr"), 4) in bits(64) ->
