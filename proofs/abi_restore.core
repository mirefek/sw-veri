("os", insert("fs_base", insert("cpu", insert("objs", empty))))))), "gpr", g), "xmm", xm), "flags", fl), "gpr"), 3, app(app(s, "gpr"), 3)), 5, app(app(s, "gpr"), 5)), 12, app(app(s, "gpr"), 12)), 13, app(app(s, "gpr"), 13)), 14, app(app(s, "gpr"), 14)), 15, app(app(s, "gpr"), 15))) in univ(1) by simp(su, hou, hmu, hnu, hw2, xu2, sgu, x12u, gu, xu, fu)
  show by simp(fbu, su, hou, hmu, wun, x7u, gsu, m1u, x12u, xu2, xfu, g0, s0, cl, rr, hw2, h0, h1, hnu, gu, tg, xu, tx, fu, tf, keep(abi.world_matches, abi.spec_raises, abi.entry_ok, abi.world.get, abi.world.set, abi.abi_call, abi.abi_restore))
qed

// any run of the machine to the return: in the universe, and an outcome
// (an ok one with no value: the loop's body raises only "raise" and "brk")
theorem abi.run_univ: all s o. runs(abi.run_to_return(), s, o) -> pair(s, o) in univ(1)
proof
  fix s o
  assume hr
  show by simp(expand(expand(hr, abi.run_to_return), runs, mkprog), keep(x86_64_linux.step))
qed

theorem abi.run_shape: all s o. runs(abi.run_to_return(), s, o) -> (ex m. o = ok(m, empty)) || (ex m e. o = exc(m, e)) || (ex t. o = diverge(t))
proof
  fix s o
  assume hr
  show by simp(hr, keep(x86_64_linux.step), {l0 l. true})
qed
