// The callee-saved registers restored by abi_function (layers/abi.sl, the
// loop over CALLEE_SAVED_LIST), as a run of the loop: built an iteration at
// a time with the open lemmas while_leave / while_step (core/loop.core).
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core core/records.core \
//     core/list.core core/loop.core build/musl_malloc_O0.core proofs/abi_restore.core

// the callee-saved registers restored (the loop of abi_function over
// CALLEE_SAVED_LIST, from any state X): it leaves by `brk` after the six
// registers, each set to its value at entry (in s); built with the open
// lemmas while_leave and while_step (core/loop.core)
theorem abi.restore_ok: all s X. while_rel(pair(X, 0), x16. true, x16 x17. (int_lt(snd(x16), seq_len(abi.CALLEE_SAVED_LIST)) && x17 = ok(pair(fn_update(fst(x16), "gpr", fn_update(app(fst(x16), "gpr"), app(abi.CALLEE_SAVED_LIST, snd(x16)), app(app(s, "gpr"), app(abi.CALLEE_SAVED_LIST, snd(x16))))), int_add(snd(x16), 1)), empty)) || (!int_lt(snd(x16), seq_len(abi.CALLEE_SAVED_LIST)) && x17 = exc(pair(fst(x16), snd(x16)), pair("brk", empty))), x16. fn_update(empty, "os.events", app(app(fst(x16), "os"), "events")), exc(pair(fn_update(X, "gpr", fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(app(X, "gpr"), 3, app(app(s, "gpr"), 3)), 5, app(app(s, "gpr"), 5)), 12, app(app(s, "gpr"), 12)), 13, app(app(s, "gpr"), 13)), 14, app(app(s, "gpr"), 14)), 15, app(app(s, "gpr"), 15))), 6), pair("brk", empty)))
