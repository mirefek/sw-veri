// The callee-saved registers restored by abi_function (layers/abi.sl,
// abi_restore: the loop over CALLEE_SAVED_LIST): from any state X, the six
// registers set from `saved`. The loop's run is built an iteration at a time
// with the theorems while_leave / while_step (core/loop.core).
// `ret_intro` puts it together with abi.call_ok: abi_function's normal
// return, as one outcome. `run_univ`, `run_shape`: what any run of
// run_to_return is.
//
//   slc kernel-check core/prelude.core core/logic.core core/sets.core core/nat.core core/records.core \
//     core/list.core core/loop.core build/musl_malloc_O0.core proofs/abi.core proofs/abi_restore.core

theorem abi.restore_loop: all saved X. while_rel(pair(X, 0), x16. true, x16 x17. (int_lt(snd(x16), seq_len(abi.CALLEE_SAVED_LIST)) && x17 = ok(pair(fn_update(fst(x16), "gpr", fn_update(app(fst(x16), "gpr"), app(abi.CALLEE_SAVED_LIST, snd(x16)), app(saved, app(abi.CALLEE_SAVED_LIST, snd(x16))))), int_add(snd(x16), 1)), empty)) || (!int_lt(snd(x16), seq_len(abi.CALLEE_SAVED_LIST)) && x17 = exc(pair(fst(x16), snd(x16)), pair("brk", empty))), x16. fn_update(empty, "os.events", app(app(fst(x16), "os"), "events")), exc(pair(fn_update(X, "gpr", fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(app(X, "gpr"), 3, app(saved, 3)), 5, app(saved, 5)), 12, app(saved, 12)), 13, app(saved, 13)), 14, app(saved, 14)), 15, app(saved, 15))), 6), pair("brk", empty)))
