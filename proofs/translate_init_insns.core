// Instruction rules first needed by the startup code (__init_tls.c's
// __copy_tls, static_init_tls): the machine's step (x86i.*) and the
// claim's (tr.*), as the others in x86_insn.core and translate*.core.

// sub rax, imm32 (REX.W 2D id)
theorem x86i.sub64_rax_imm32: all m o k len. m in x86_64_linux.Machine -> m in univ(1) -> k in bits(32) ->
  runs(x86_64_linux.exec_body(len, tag(52, pair(8, k))), m, o) ->
  ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", bits_add(64, m.rip, len)), "flags", f), "gpr",
    fn_update(m.gpr, 0, bits_sub(64, m.gpr[0], bits_sext(32, 64, k)))), empty)
proof
  fix m o k len
  assume hM hu hk hr
  have pt := apply(x86i.parts, hM)
  show by defs(simp(hr, hu, pt, mp(x86i.reg_typed, {m}, {0}, hM, simp()), hk, x86i.bool_univ), x86i.flags_ok)
qed

// sub rax, imm32: rax := u - kk
theorem tr.sub64_rax_imm(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len k kk u r hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a ->
    runs(x86_64_linux.exec_body(len, tag(52, pair(8, k))), m, o)) ->
  a2 = bits_add(64, a, len) -> k in bits(32) -> kk = bits_sext(32, 64, k) -> 0 in dom(rs) -> rs[0] = pair(8, u) ->
  r = bits_sub(64, u, kk) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs, 0, pair(8, r)), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len k kk u r hs ds rs p w
  assume hat ha2 hk hkk hd hu hr hpt0
  have hpt := rewrite(hr, hpt0)
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(m.gpr, 0, bits_sub(64, u, kk))), empty)) proof
    fix m o
    assume hi hr hh hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {0}, {8}, {u}, hrs, hd, hu)
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    obtain f, hf from apply(x86i.sub64_rax_imm32, {m}, {o}, {k}, {len}, ipM, ipU, hk, hx)
    show by ex_intro({f}, simp(hf, rg, hr, ha2, hkk, keep(x86i.flags_ok)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_sub(64, u, kk) in bits(int_mul(8, 8)) && bits_sub(64, u, kk) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  have g0: tr.scratch_reg(0) by defs(simp(), tr.scratch_reg)
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {0}, {8}, {bits_sub(64, u, kk)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, g0, ty, hpt)
qed

// sub qword [rsp + d], imm8 (REX.W 83 /5 ib)
theorem x86i.sub64_rsp_imm: all m o d k len. m in x86_64_linux.Machine -> m in univ(1) -> d in bits(64) -> k in bits(8) ->
  x86i.acc(m, x86i.rsp_ea(m, d), 8, 0) -> x86i.acc(m, x86i.rsp_ea(m, d), 8, 1) ->
  runs(x86_64_linux.exec_body(len, tag(60, pair(8, pair(5, pair(x86i.rsp_mem(d), pair(x86i.rsp_mem(d), k)))))), m, o) ->
  ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", bits_add(64, m.rip, len)), "flags", f), "vm",
    fn_update(m.vm, "bytes", x86_64_linux.store_le(m.vm.bytes, x86i.rsp_ea(m, d), 8,
      bits_sub(64, x86_64_linux.le(m.vm.bytes, x86i.rsp_ea(m, d), 8), bits_sext(8, 64, k))))), empty)
proof
  fix m o d k len
  assume hM hu hd hk a0 a1 h
  have pt := apply(x86i.parts, hM)
  have k0: all i. i in omega -> int_lt(i, 8) -> x86_64_linux.canonical(bits_add(64, x86i.rsp_ea(m, d), bits_of_int(64, i))) proof
    fix i
    assume i1 i2
    show by mp(all_elim(all_elim(all_elim(x86.access_canonical, {m.vm}), {bits_add(64, x86i.rsp_ea(m, d), bits_of_int(64, i))}), {0}), mp(mp(all_elim(a0, {i}), i1), i2))
  qed
  show by defs(simp(h, hu, pt, hk, hd, apply(x86i.rsp_typed, hM), a0, a1, k0, x86.touch_range_access, x86i.bool_univ, keep(x86_64_linux.touch_range, x86_64_linux.can_access)), x86i.flags_ok)
qed

// sub qword [rsp + d], imm8: the home c (u) := u - kk
theorem tr.sub64_home_imm(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len d c k kk u r hs hs2 ds rs p w. 
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a ->
    runs(x86_64_linux.exec_body(len, tag(60, pair(8, pair(5, pair(x86i.rsp_mem(d), pair(x86i.rsp_mem(d), k)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> base in omega -> d in bits(64) -> c = int_mod(int_sub(d, fr), 18446744073709551616) ->
  k in bits(8) -> kk = bits_sext(8, 64, k) -> c in dom(hs) -> hs[c] = pair(8, u) ->
  tr.hkeep(hs, hs2, c, 8) ->
  r = bits_sub(64, u, kk) ->
  tr.hfr(s, c, 8, v) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, fn_update(hs2, c, pair(8, r)), ds, rs, p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len d c k kk u r hs hs2 ds rs p w
  assume hat ha2 hbase hd hcd hk hkk hdd hu hkp hr hfv hpt0
  have hpt := rewrite(hr, hpt0)
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
     (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "vm",
       fn_update(m.vm, "bytes", x86_64_linux.store_le(m.vm.bytes, bits_add(64, int_add(s.gpr[4], c), 0), 8, bits_sub(64, u, kk)))), empty)) proof
    fix m o
    assume hi hr hh hrs ho
    have ip := apply(tr.inv_parts, hi)
    have mM: m in x86_64_linux.Machine by taut(ip)
    have mu: m in univ(1) by taut(ip)
    have fe := apply(tr.frame_ea, {s}, {base}, {code}, {fr}, {m}, {w}, {d}, {c}, {0}, hi, hd, hcd, simp())
    have ac := apply(tr.home_acc, {s}, {base}, {code}, {fr}, {m}, {w}, {hs}, {d}, {c}, {8}, {u}, hi, hh, hd, hcd, hdd, hu)
    have hg := apply(tr.home_read, {s}, {base}, {code}, {fr}, {m}, {w}, {hs}, {d}, {c}, {8}, {u}, hi, hh, hd, hcd, hdd, hu)
    have hx := mp(all_elim(hat, {m}, {o}), ho, taut(ip), hr)
    obtain f, hf from apply(x86i.sub64_rsp_imm, {m}, {o}, {d}, {k}, {len}, mM, mu, hd, hk, taut(ac), taut(ac), hx)
    show by ex_intro({f}, simp(hf, hg, fe, hr, ha2, hkk, keep(x86i.flags_ok)))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  have x64: bits_sub(64, u, kk) in bits(int_mul(8, 8)) by simp()
  show := apply(tr.hstore_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {c}, {8}, {u}, {bits_sub(64, u, kk)}, {hs}, {hs2}, {ds}, {rs}, {p}, {w}, he, hbase, a2b, hdd, hu, simp(), x64, hkp, hfv, hpt)
qed

// cmovcc r64 g, r64 h (REX.W 0F 40+cc /r): g := h if the condition holds
theorem x86i.cmov64_rr: all m o cc g h z1 z2 len. m in x86_64_linux.Machine -> m in univ(1) -> g in x86_64_linux.Reg -> h in x86_64_linux.Reg ->
  runs(x86_64_linux.exec_body(len, tag(84, pair(8, pair(cc, pair(g, pair(tag(0, h), pair(z1, z2))))))), m, o) ->
  o = ok(fn_update(fn_update(m, "rip", bits_add(64, m.rip, len)), "gpr", fn_update(m.gpr, g, ite(x86_64_linux.cond(m.flags, cc), m.gpr[h], m.gpr[g]))), empty)
proof
  fix m o cc g h z1 z2 len
  assume hM hu hg hh hr
  have pt := apply(x86i.parts, hM)
  show by simp(hr, hu, pt, apply(x86i.reg_typed, hM, hg), apply(x86i.reg_typed, hM, hh), x86i.bool_univ)
qed

// A compare's flags, then cmovcc r64 g, r64 h (g holding u, h x): g's
// value ite(c, u, x), c the condition's failing (as tr.setcc's)
theorem tr.cmov64(f. ff, zb. bkp, zb pb wb. bka): all s v base code fr a a2 a3 len2 cc c g h z1 z2 u nh x r hs ds rs p w.
  (all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
    (ex f. x86i.flags_ok(m, f) && ff(f) && o = ok(fn_update(fn_update(m, "rip", a2), "flags", f), empty))) ->
  (all f. ff(f) -> (x86_64_linux.cond(f, cc) <-> !c)) ->
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a2 ->
    runs(x86_64_linux.exec_body(len2, tag(84, pair(8, pair(cc, pair(g, pair(tag(0, h), pair(z1, z2))))))), m, o)) ->
  a3 = bits_add(64, a2, len2) -> a2 in bits(64) -> tr.scratch_reg(g) -> h in x86_64_linux.Reg -> g in dom(rs) -> rs[g] = pair(8, u) -> h in dom(rs) -> rs[h] = pair(nh, x) ->
  x in bits(64) -> (all m. m.rip = a2 -> !bkp(m)) -> r = ite(c, u, x) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a3, hs, ds, fn_update(rs, g, pair(8, r)), p, w) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 a3 len2 cc c g h z1 z2 u nh x r hs ds rs p w
  assume h1 hcc hat2 ha3 ha2 hg hhR hd hu hhd hhu hx64 hb2 hrr hpt0
  have hpt := rewrite(hrr, hpt0)
  let X := ite(c, u, x)
  have ha3b: a3 in bits(64) by simp(ha3)
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have g: all m. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, ds) -> tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m) proof
    fix m
    assume hi hr hh hrs hmm hfr
    have nr := apply(tr.inv_nr, hi)
    have rg ug := apply(tr.regs_get, {m}, {rs}, {g}, {8}, {u}, hrs, hd, hu)
    have rh _ := apply(tr.regs_get, {m}, {rs}, {h}, {nh}, {x}, hrs, hhd, hhu)
    have x64: X in bits(64) by simp(ug, hx64)
    have x88: X in bits(int_mul(8, 8)) by simp(x64)
    let Q1(m2) := ex f. x86i.flags_ok(m, f) && ff(f) && m2 = fn_update(fn_update(m, "rip", a2), "flags", f)
    have st1: all o. runs(x86_64_linux.step(), m, o) -> (ex m2. o = ok(m2, empty) && Q1(m2)) proof
      fix o
      assume ho
      obtain f, hf from mp(all_elim(h1, {m}, {o}), hi, hr, hh, hrs, ho)
      have q1: Q1(fn_update(fn_update(m, "rip", a2), "flags", f)) by ex_intro({f}, simp(hf, keep(x86i.flags_ok)))
      show by ex_intro({fn_update(fn_update(m, "rip", a2), "flags", f)}, taut(q1, hf))
    qed
    have post1: all m2. Q1(m2) -> tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m2) proof
      fix m2
      assume hq
      obtain f, hf from hq
      have fo: x86i.flags_ok(m, f) by taut(hf)
      have fff: ff(f) by taut(hf)
      have e: m2 = fn_update(fn_update(m, "rip", a2), "flags", f) by taut(hf)
      let M2 := fn_update(fn_update(m, "rip", a2), "flags", f)
      have i2 := mp(tr.inv_flags, {s}, {base}, {code}, {fr}, {m}, {w}, {a2}, {f}, hi, ha2, fo)
      have ipM ipU ipC .. := apply(tr.inv_parts, i2)
      have nr2: int_lt(M2.gpr[4], abi.sp(s)) by simp(nr)
      have k := mp(all_elim(hcc, {f}), fff)
      // (cmov's value: X)
      have ie1: c -> ite(x86_64_linux.cond(f, cc), x, u) = X proof
        assume hc
        have nc: !x86_64_linux.cond(f, cc) by taut(k, hc)
        show by simp(nc, hc)
      qed
      have ie2: !c -> ite(x86_64_linux.cond(f, cc), x, u) = X proof
        assume hc
        have yc: x86_64_linux.cond(f, cc) by taut(k, hc)
        show by simp(yc, hc)
      qed
      have ie: ite(x86_64_linux.cond(f, cc), x, u) = X by taut(ie1, ie2)
      let M3 := fn_update(fn_update(M2, "rip", a3), "gpr", fn_update(M2.gpr, g, X))
      have st2: all o. runs(x86_64_linux.step(), M2, o) -> (ex m3. o = ok(m3, empty) && m3 = M3) proof
        fix o
        assume ho
        have r2: M2.rip = a2 by simp()
        have hx := mp(all_elim(hat2, {M2}, {o}), ho, ipC, r2)
        have e2 := apply(x86i.cmov64_rr, {M2}, {o}, {cc}, {g}, {h}, {z1}, {z2}, {len2}, ipM, ipU, gR, hhR, hx)
        have fl: M2.flags = f by simp()
        have gg: M2.gpr[g] = u by simp(rg)
        have gh: M2.gpr[h] = x by simp(rh)
        have ra: bits_add(64, M2.rip, len2) = a3 by simp(ha3)
        have e3 := rewrite(ie, rewrite(gh, rewrite(gg, rewrite(fl, rewrite(ra, e2)))))
        show by ex_intro({M3}, simp(e3))
      qed
      have post2: all m3. m3 = M3 -> tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m3) proof
        fix m3
        assume e3
        have fsame := mp(all_elim(tr.flags_same, {M2}, {a3}, {fn_update(M2.gpr, g, X)}), ipM)
        have fok := mp(mp(all_elim(tr.flags_ok_same, {M2}), ipM), ipU)
        have i3a := apply(tr.inv_reg, {s}, {base}, {code}, {fr}, {M2}, {w}, {a3}, {M2.flags}, {g}, {X}, i2, ha3b, fok, hg, x64)
        have i3 := rewrite(fsame, i3a)
        have rs2: tr.regs(M2, rs) by defs(simp(expand(hrs, tr.regs)), tr.regs)
        have rs1 := apply(tr.regs_set, {M2}, {rs}, {g}, {8}, {X}, rs2, x88)
        have rs3: tr.regs(M3, fn_update(rs, g, pair(8, X))) by defs(simp(expand(rs1, tr.regs)), tr.regs)
        have rip3: M3.rip = a3 by simp()
        have c3 := apply(tr.pt_regs[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], hpt, i3, rip3, rs3, hh, hmm, hfr, simp(), simp())
        show := rewrite(sym(e3), c3)
      qed
      have sm := mp(tr.step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb), s := s, v := v, p := p, w := w, m := M2, q := y. y = M3], st2, nr2, post2)
      have rm2: M2.rip = a2 by simp()
      have cm := apply(tr.sim_cl[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {p}, {w}, {M2}, nr2, mp(all_elim(hb2, {M2}), rm2), sm)
      show := rewrite(sym(e), cm)
    qed
    show := mp(mp(mp(tr.step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb), s := s, v := v, p := p, w := w, m := m, q := y. Q1(y)], st1), nr), post1)
  qed
  show by defs(g, tr.lv)
qed

// mov dword [rip + d], r32 of a register of any width (u): the spec's 4
// bytes x, u's low dword (as tr.store32_bd_w)
theorem tr.store32_rip_w(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g d z1 z2 k u x bigA hs ds rs p p2 w w2. tr.hap(s, hs, v) -> 
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a ->
    runs(x86_64_linux.exec_body(len, tag(75, pair(4, pair(g, pair(x86i.rip_mem(d), pair(z1, z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> base in omega -> g in x86_64_linux.Reg -> d in bits(64) -> g in dom(rs) -> rs[g] = pair(k, u) -> bits_of_int(32, u) = x ->
  bigA = bits_add(64, int_add(a2, d), 0) -> gimple.usable(w.vm, w.objs, bigA, 4, true) ->
  w2 = fn_update(w, "vm", fn_update(w.vm, "bytes", x86_64_linux.store_le(w.vm.bytes, bigA, 4, x))) ->
  tr.red(p, w, p2, w2) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, rs, p2, w2) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g d z1 z2 k u x bigA hs ds rs p p2 w w2
  assume hap hat ha2 hbase hg hd hgd hgu hxe hA hus hw2 hred hpt
  have ab: bigA in bits(64) by simp(hA)
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "vm", fn_update(m.vm, "bytes", x86_64_linux.store_le(m.vm.bytes, bigA, 4, x))), empty) proof
    fix m o
    assume hi hr hh hrs hmm ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {k}, {u}, hrs, hgd, hgu)
    have sl := apply(tr.low32_of, (u in omega by simp(rewrite(rg.1, apply(x86i.reg_typed, ipM, hg)))))
    have ea: x86i.rip_ea(m, len, d) = bigA by simp(hr, ha2, hA)
    have wa := apply(tr.store_acc, {s}, {m}, {w}, {v}, {bigA}, {4}, hmm, ab, simp(), simp(), hus)
    have wa2 := rewrite(sym(ea), wa)
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    have e := apply(x86i.store32_rip, {m}, {o}, {g}, {d}, {z1}, {z2}, {len}, ipM, ipU, hg, hd, wa2, hx)
    show by simp(e, ea, rg, sl, hxe, hr, ha2)
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.store_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {bigA}, {4}, {x}, {hs}, {ds}, {rs}, {p}, {p2}, {w}, {w2}, hap, he, hbase, a2b, ab, simp(), simp(), hus, hw2, hred, hpt)
qed

// and r64, imm8 (REX.W 83 /4 ib)
theorem x86i.and64_imm8: all m o g z k len. m in x86_64_linux.Machine -> m in univ(1) -> g in x86_64_linux.Reg -> k in bits(8) ->
  runs(x86_64_linux.exec_body(len, tag(60, pair(8, pair(4, pair(tag(0, g), pair(z, k)))))), m, o) ->
  ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", bits_add(64, m.rip, len)), "flags", f), "gpr",
    fn_update(m.gpr, g, bits_and(64, m.gpr[g], bits_sext(8, 64, k)))), empty)
proof
  fix m o g z k len
  assume hM hu hg hk hr
  have pt := apply(x86i.parts, hM)
  show by defs(simp(hr, hu, pt, apply(x86i.reg_typed, hM, hg), hk, x86i.bool_univ), x86i.flags_ok)
qed

// and r64, imm8: g := u & kk
theorem tr.and64_imm8(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g z k kk u r hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a ->
    runs(x86_64_linux.exec_body(len, tag(60, pair(8, pair(4, pair(tag(0, g), pair(z, k)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> k in bits(8) -> kk = bits_sext(8, 64, k) -> g in dom(rs) -> rs[g] = pair(8, u) ->
  r = bits_and(64, u, kk) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs, g, pair(8, r)), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g z k kk u r hs ds rs p w
  assume hat ha2 hg hk hkk hd hu hr hpt0
  have hpt := rewrite(hr, hpt0)
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(m.gpr, g, bits_and(64, u, kk))), empty)) proof
    fix m o
    assume hi hr hh hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {8}, {u}, hrs, hd, hu)
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    obtain f, hf from apply(x86i.and64_imm8, {m}, {o}, {g}, {z}, {k}, {len}, ipM, ipU, gR, hk, hx)
    show by ex_intro({f}, simp(hf, rg, hr, ha2, hkk, keep(x86i.flags_ok)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_and(64, u, kk) in bits(int_mul(8, 8)) && bits_and(64, u, kk) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {8}, {bits_and(64, u, kk)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// push imm8 (6A ib) before a call with stack arguments: the word sext(k)
// at the frame's new bottom, as `push [rsp + d]`'s (x86i.push_m,
// tr.push_m64_cm, tr.push_m64_c0)
theorem x86i.push_i8: all m o k len. m in x86_64_linux.Machine -> m in univ(1) -> k in bits(8) ->
  int_le(8, m.gpr[4]) -> int_lt(m.gpr[4], 140737488355328) ->
  runs(x86_64_linux.exec_body(len, tag(116, k)), m, o) ->
  (ex m1 e1. runs(x86_64_linux.touch_range(bits_sub(64, m.gpr[4], 8), 8, 1), fn_update(m, "rip", bits_add(64, m.rip, bits_of_int(64, len))), ok(m1, e1)) &&
    o = ok(fn_update(fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, bits_sub(64, m.gpr[4], 8), 8,
      bits_sext(8, 64, k)))), "gpr", fn_update(m1.gpr, 4, bits_sub(64, m.gpr[4], 8))), empty)) ||
  (ex x e. runs(x86_64_linux.touch_range(bits_sub(64, m.gpr[4], 8), 8, 1), fn_update(m, "rip", bits_add(64, m.rip, bits_of_int(64, len))), exc(x, e)) &&
    o = exc(x, e)) ||
  (ex t. runs(x86_64_linux.touch_range(bits_sub(64, m.gpr[4], 8), 8, 1), fn_update(m, "rip", bits_add(64, m.rip, bits_of_int(64, len))), diverge(t)) &&
    o = diverge(t))
proof
  fix m o k len
  assume hM hu hk h8 hl hr
  have pt := apply(x86i.parts, hM)
  have r4 := apply(x86i.rsp_typed, hM)
  have k0: all j. j in omega -> int_lt(j, 8) -> x86_64_linux.canonical(bits_add(64, bits_sub(64, m.gpr[4], 8), bits_of_int(64, j))) proof
    fix j
    assume j1 j2
    have p64: pow2(64) = 18446744073709551616 by simp()
    have e0: int_mod(int_add(int_mod(int_sub(m.gpr[4], 8), 18446744073709551616), int_mod(j, 18446744073709551616)), 18446744073709551616) =
      int_add(int_sub(m.gpr[4], 8), j) by arith(r4, h8, hl, j1, j2)
    have e: bits_add(64, bits_sub(64, m.gpr[4], 8), bits_of_int(64, j)) = int_add(int_sub(m.gpr[4], 8), j)
      by defs(rewrite(sym(p64), e0), bits_add, bits_sub, bits_of_int)
    have c0: int_lt(int_add(int_sub(m.gpr[4], 8), j), 140737488355328) by arith(r4, hl, j1, j2)
    have pw: int_pow(2, 47) = 140737488355328 by simp()
    have c := rewrite(sym(pw), c0)
    have c2 := rewrite(sym(e), c)
    show by defs(taut(c2), x86_64_linux.canonical)
  qed
  show by simp(hr, hu, pt, r4, hk, k0, x86.touch_range_access, keep(x86_64_linux.touch_range, x86_64_linux.can_access))
qed

theorem tr.push_i8_cm(b, zb. bkp, zb pb wb. bka, x9 x10 x8. ka, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all s v base code fr a a2 len kb x fr2 c G a7 hs hs2 fd rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a ->
    runs(x86_64_linux.exec_body(len, tag(116, kb)), m, o)) ->
  a2 = bits_add(64, a, bits_of_int(64, len)) -> base in omega -> kb in bits(8) -> x = bits_sext(8, 64, kb) -> !(4 in dom(rs)) ->
  fr2 = int_add(fr, 8) -> int_le(fr2, tr.FMAX) -> c = int_sub(18446744073709551616, fr2) -> tr.cfr(fr) ->
  tr.hkeep(hs, hs2, c, 8) -> p = mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gc.c1m(b, G, a7), x0, x9 x10. ka(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) ->
  tr.hfr(s, c, 8, v) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr2, a2, fn_update(hs2, c, pair(8, x)), fd, rs, p, w) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, fd, rs, p, w)
proof
  fix s v base code fr a a2 len kb x fr2 c G a7 hs hs2 fd rs p w
  assume hat ha2 hb hk8 hxk hn4 hf2 hfl hcc hcf hk hpe hkx hfv hpt
  have a2b0: a2 in bits(64) by simp(ha2)
  have g0: all m. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, fd) ->
      tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m) proof
    fix m
    assume hi hr hh hrs hmm hfr
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have {sM, rspm, fro, slt} := hi
    have r4 := apply(x86i.rsp_typed, sM)
    have g8 := apply(tr.inv_gap, hi)
    have nr := apply(tr.inv_nr, hi)
    let S := s.gpr[4]
    let R8 := int_sub(S, fr2)
    have hc: tr.hrange(c, 8) by defs(arith(hcc, hf2, hfl, fro), tr.hrange)
    // (the push's address: the home's, rsp - 8)
    have ea: bits_sub(64, m.gpr[4], 8) = tr.ha(s, c) by defs(arith(rspm, r4, g8, hf2, hfl, hcc, fro), bits_sub, bits_add, pow2)
    have eR: bits_sub(64, m.gpr[4], 8) = R8 by defs(arith(rspm, r4, g8, hf2, hfl, fro), bits_sub, pow2)
    have eh: tr.ha(s, c) = R8 := trans(sym(ea), eR)
    have xb: x in bits(64) by simp(hxk)
    let ST(m1) := fn_update(m1, "vm", fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, tr.ha(s, c), 8, x)))
    let PU(m1) := fn_update(ST(m1), "gpr", fn_update(m1.gpr, 4, tr.ha(s, c)))
    let Q(m2) := ex m1 e1. runs(x86_64_linux.touch_range(tr.ha(s, c), 8, 1), fn_update(m, "rip", a2), ok(m1, e1)) && m2 = PU(m1)
    let QX(y, e) := runs(x86_64_linux.touch_range(tr.ha(s, c), 8, 1), fn_update(m, "rip", a2), exc(y, e))
    have st: all o. runs(x86_64_linux.step(), m, o) -> (ex m2. o = ok(m2, empty) && Q(m2)) || (ex y e. o = exc(y, e) && QX(y, e)) proof
      fix o
      assume ho
      have hx2 := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
      have m8: int_le(8, m.gpr[4]) by arith(rspm, r4, g8, hf2, hfl, fro)
      have ml: int_lt(m.gpr[4], 140737488355328) by arith(rspm, slt, fro)
      have ra: bits_add(64, m.rip, bits_of_int(64, len)) = a2 by simp(hr, ha2)
      have c0 := rewrite(ra, rewrite(sym(hxk), rewrite(ea, apply(x86i.push_i8, ipM, ipU, hk8, m8, ml, hx2))))
      have okc: (ex m1 e1. runs(x86_64_linux.touch_range(tr.ha(s, c), 8, 1), fn_update(m, "rip", a2), ok(m1, e1)) && o = ok(PU(m1), empty)) ->
          (ex m2. o = ok(m2, empty) && Q(m2)) proof
        assume h
        obtain m1 e1, h1 h2 from h
        have q: Q(PU(m1)) by ex_intro({m1}, {e1}, taut(h1, refl({PU(m1)})))
        show by ex_intro({PU(m1)}, taut(h2, q))
      qed
      have exc0: (ex y e. QX(y, e) && o = exc(y, e)) -> (ex y e. o = exc(y, e) && QX(y, e)) proof
        assume h
        obtain y e, h1 h2 from h
        show by ex_intro({y}, {e}, taut(h1, h2))
      qed
      have nd: all t. !runs(x86_64_linux.touch_range(tr.ha(s, c), 8, 1), fn_update(m, "rip", a2), diverge(t)) proof
        fix t
        show := apply(x86.touch_range_nodiv, {fn_update(m, "rip", a2)}, {tr.ha(s, c)}, {8}, {1}, {t}, simp())
      qed
      have dv: (ex t. runs(x86_64_linux.touch_range(tr.ha(s, c), 8, 1), fn_update(m, "rip", a2), diverge(t)) && o = diverge(t)) -> false proof
        assume h
        obtain t, ht _ from h
        show by taut(ht, all_elim(nd, {t}))
      qed
      show by taut(c0, okc, exc0, dv)
    qed
    have post: all m2. Q(m2) -> tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m2) proof
      fix m2
      assume hq
      obtain m1 e1, ht e2 from hq
      have a2b: a2 in bits(64) by simp(ha2)
      have i1 cos crip cgpr gr stk fl cvm v1 := apply(tr.inv_fstore, {s}, {base}, {code}, {fr}, {m}, {w}, {c}, {8}, {x}, {a2}, {m1}, {e1}, {ST(m1)}, hi, hb, a2b, hc, ht, refl({ST(m1)}))
      // the homes: those left, kept; the pushed one
      have hk2 := apply(tr.homes_store, {s}, {m}, {ST(m1)}, {hs}, {hs2}, {c}, {8}, {x}, {m1.vm}, r4, g8, hh, hk, hc, gr, cvm)
      // (the new home: writable, on a stack page -- by the stack's gap)
      have ce: int_sub(18446744073709551616, int_add(fr, 8)) = c by arith(hcc, hf2)
      have ph := rewrite(ce, rewrite(ea, apply(tr.push_hacc, {s}, {base}, {code}, {fr}, {m}, {w}, {v}, {x}, {a2}, {m1}, {e1}, hi, hcf, hmm, xb, a2b, rewrite(sym(ea), ht))))
      have pe: ST(m1).vm.pages = m1.vm.pages by simp()
      have ac2 := apply(tr.hacc_pages, {s}, {fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, tr.ha(s, c), 8, x))}, {ST(m1).vm}, {c}, {8},
        (ST(m1).vm.pages = fn_update(m1.vm, "bytes", x86_64_linux.store_le(m1.vm.bytes, tr.ha(s, c), 8, x)).pages by rsimp()), ph)
      have ac1 := apply(tr.hacc_pages, {s}, {ST(m1).vm}, {m1.vm}, {c}, {8}, sym(pe), ac2)
      have lv: x86_64_linux.le(ST(m1).vm.bytes, tr.ha(s, c), 8) = x by simp(apply(tr.le_store_n, {m1.vm.bytes}, {tr.ha(s, c)}, {8}, {x}, v1, simp(), simp(), (x in bits(int_mul(8, 8)) by simp(xb))))
      have h2 := apply(tr.homes_put, {s}, {ST(m1)}, {hs2}, {c}, {8}, {x}, hk2, lv, hc, ac2)
      have mm1 := apply(tr.mem_grow, {s}, {base}, {code}, {fr}, {m}, {m1}, {w}, {v}, hi, hmm, gr, stk, fl)
      have mm2 := apply(tr.mem_fstore, {s}, {base}, {code}, {fr}, {m}, {m1}, {ST(m1)}, {w}, {v}, {c}, {8}, {x}, hi, mm1, hc, ac1, hfv, simp())
      have f2 := apply(tr.frame_store, {s}, {m}, {ST(m1)}, {fd}, {m1.vm}, hfr, cos, gr, stk, pe, simp(), simp())
      // (then rsp: the frame fr + 8)
      have g1 := apply(x86i.parts, apply(tr.inv_parts, i1).1).2
      have eg: ST(m1).gpr = m1.gpr by simp()
      have gm: m1.gpr = m.gpr := trans(sym(eg), cgpr)
      have R8b: tr.ha(s, c) in bits(64) by simp(eh, (R8 in bits(64) by arith(r4, g8, hf2, hfl, fro)))
      let GR := fn_update(m1.gpr, 4, tr.ha(s, c))
      have G2: GR in fn_space(x86_64_linux.Reg, bits(64)) := apply(x86.space_upd, {x86_64_linux.Reg}, {bits(64)}, {m1.gpr}, {4}, {tr.ha(s, c)}, rewrite(eg, g1), simp(), R8b)
      have su := apply(tr.inv_parts, i1).2
      have gu := mp(app_univ[u := 1, f := ST(m1), k := "gpr"], su)
      have G2u: GR in univ(1) by simp(rewrite(eg, gu), R8b)
      have i2 := apply(tr.inv_gpr, {s}, {base}, {code}, {fr}, {fr2}, {ST(m1)}, {w}, {GR}, i1, G2, G2u, simp(eh), (fr2 in omega by arith(hf2, fro)))
      have rs2 := apply(tr.regs_g4, {m}, {PU(m1)}, {rs}, {tr.ha(s, c)}, hrs, hn4, (PU(m1).gpr = fn_update(m.gpr, 4, tr.ha(s, c)) by simp(gm)))
      have rip2: PU(m1).rip = a2 by simp(crip)
      have c2 := apply(tr.pt_regs[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr2}, {a2}, {fn_update(hs2, c, pair(8, x))}, {fd}, {rs}, {p}, {w}, {ST(m1)}, {PU(m1)},
        hpt, i2, rip2, rs2, h2, mm2, f2, simp(), simp())
      show := rewrite(sym(e2), c2)
    qed
    have fault: all y e. QX(y, e) -> tr.ub(s, v, p, w) || tr.crash(s, p, w, exc(y, e)) proof
      fix y e
      assume hq
      // (the call's fault: its spec's overflow -- the push its first step)
      have hq0 := rewrite(sym(ea), hq)
      have prb prm := apply(tr.push_range, {s}, {base}, {code}, {fr}, {m}, {w}, {a2}, hi, hcf)
      have mv: fn_update(m, "rip", a2).vm in x86_64_linux.Vm by simp(apply(x86i.parts, ipM))
      have m2u: fn_update(m, "rip", a2) in univ(1) by simp(ipU, a2b0)
      have p0o: int_div(S, 4096) in omega by simp(r4)
      have gr fa := apply(x86.touch_range_exc, {fn_update(m, "rip", a2)}, {bits_sub(64, m.gpr[4], 8)}, {8}, {1}, {int_div(int_sub(m.gpr[4], 8), 4096)}, {int_div(S, 4096)}, {y}, {e},
        mv, m2u, p0o, prm, prb, hq0)
      have se0 := apply(x86.touch_range_stk_exc, {fn_update(m, "rip", a2)}, {bits_sub(64, m.gpr[4], 8)}, {8}, {1}, {y}, {e}, hq0)
      have se: x86.stk_ext(m.vm, y.vm) by simp(se0)
      have cf := apply(tr.call_fault_m[b := b, g := G, args := a7, a := x9 x10 x8. ka(x9, fst(x10), x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1),
        kw := x3 x4 x2. kw(x3, x4, x2)], {s}, {v}, {base}, {code}, {fr}, {m}, {w}, {a2}, {y}, {e}, hi, hcf, hmm, hkx, a2b0, gr, fa, se)
      have {wu} := hi
      have rd := mp(all_elim(tr.call1_red_m[b := b, g := G, args := a7, a := x9 x10 x8. ka(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8), dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1),
        kw := x3 x4 x2. kw(x3, x4, x2)], {w}), wu)
      have u1: tr.ub(s, v, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gc.cm(b, G, a7), x0, x9 x10. ka(x9, fst(x10), x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w) -> tr.ub(s, v, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gc.c1m(b, G, a7), x0, x9 x10. ka(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w) proof
        assume h
        show := mp(all_elim(tr.ub_red, {s}, {v}, {mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gc.c1m(b, G, a7), x0, x9 x10. ka(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))}, {mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gc.cm(b, G, a7), x0, x9 x10. ka(x9, fst(x10), x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))}, {w}), rd, h)
      qed
      have c1: tr.crash(s, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gc.cm(b, G, a7), x0, x9 x10. ka(x9, fst(x10), x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, exc(y, e)) -> tr.crash(s, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gc.c1m(b, G, a7), x0, x9 x10. ka(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, exc(y, e)) proof
        assume h
        show := mp(all_elim(tr.crash_red, {s}, {mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gc.c1m(b, G, a7), x0, x9 x10. ka(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))}, {mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gc.cm(b, G, a7), x0, x9 x10. ka(x9, fst(x10), x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))}, {w}, {exc(y, e)}), rd, h)
      qed
      have r1: tr.ub(s, v, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gc.c1m(b, G, a7), x0, x9 x10. ka(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w) || tr.crash(s, mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gc.c1m(b, G, a7), x0, x9 x10. ka(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, exc(y, e)) by taut(cf, u1, c1)
      show := rewrite(sym(hpe), r1)
    qed
    show := mp(tr.step_x[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb), s := s, v := v, p := p, w := w, m := m, q := x. Q(x), qx := y e. QX(y, e)], st, nr, post, fault)
  qed
  show by defs(g0, tr.lv)
qed

theorem tr.push_i8_c0(zb. bkp, zb pb wb. bka, x9 x10 x8. ka, x9 x10 x8. xx, x9 x8. dd, x8 x1. k, x3 x4 x2. kw): all s v base code fr a a2 len kb x fr2 c G a7 hs hs2 fd rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a ->
    runs(x86_64_linux.exec_body(len, tag(116, kb)), m, o)) ->
  a2 = bits_add(64, a, bits_of_int(64, len)) -> base in omega -> kb in bits(8) -> x = bits_sext(8, 64, kb) -> !(4 in dom(rs)) ->
  fr2 = int_add(fr, 8) -> int_le(fr2, tr.FMAX) -> c = int_sub(18446744073709551616, fr2) -> tr.cfr(fr) ->
  tr.hkeep(hs, hs2, c, 8) -> p = mkprog(x1 x2. bind_rel(mkprog(x0 x1. ex x8. bind_rel(gimple.call1_0_s(G, a7), x0, x9 x10. ka(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))) ->
  (all x e. x in univ(1) -> e in univ(1) -> runs(mkprog(x0 x1. ex x8. xx(x, e, x8) && k(x8, x1)), w, exc(x, e))) ->
  tr.hfr(s, c, 8, v) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr2, a2, fn_update(hs2, c, pair(8, x)), fd, rs, p, w) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, fd, rs, p, w)
proof
  fix s v base code fr a a2 len kb x fr2 c G a7 hs hs2 fd rs p w
  assume hat ha2 hb hk8 hxk hn4 hf2 hfl hcc hcf hk hpe hkx hfv hpt
  have e1 := all_elim(gc.call1_0_s_eq, {G}, {a7})
  have e2 := mp(tr.ite_f[c := false, a := gimple.call1(G, a7), b := gimple.call1_0(G, a7)], (!false by taut()))
  have hpe2 := rewrite(sym(e2), rewrite(e1, hpe))
  show := apply(tr.push_i8_cm[b := false, bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb), ka := x9 x10 x8. ka(x9, x10, x8), xx := x9 x10 x8. xx(x9, x10, x8),
    dd := x9 x8. dd(x9, x8), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {len}, {kb}, {x}, {fr2}, {c}, {G}, {a7}, {hs}, {hs2}, {fd}, {rs}, {p}, {w},
    hat, ha2, hb, hk8, hxk, hn4, hf2, hfl, hcc, hcf, hk, hpe2, hkx, hfv, hpt)
qed

// (a CFG's cut points at the frame fr, stopping at t: from a deeper frame
// fr2 -- a call with its arguments pushed -- no cut point, as tr.tbp_cut)
theorem tr.tbp_cut_le(s, fr, fr2, a. ct, z. bkp, t): int_le(fr, fr2) -> (all z. int_lt(z.gpr[4], int_sub(s.gpr[4], fr2)) -> bkp(z) -> z.rip = t) ->
  all z. int_lt(z.gpr[4], int_sub(s.gpr[4], fr2)) -> tr.cut(s, fr, a. ct(a), z) || bkp(z) -> z.rip = t
proof
  assume hle hb
  fix z
  assume hl hc
  have n: tr.cut(s, fr, a. ct(a), z) -> false proof
    assume c
    have e := expand(c, tr.cut).2
    show by arith(e, hl, hle)
  qed
  show by taut(hc, n, mp(all_elim(hb, {z}), hl))
qed
