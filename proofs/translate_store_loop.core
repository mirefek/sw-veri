    have hg := apply(tr.home_read, {s}, {base}, {code}, {fr}, {m}, {w}, {hs}, {d}, {c}, {8}, {u}, hi, hh, hd, hcd, hdd, hu)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {8}, {x}, hrs, hgd, hx)
    have hx2 := mp(all_elim(hat, {m}, {o}), ho, taut(ip), hr)
    obtain f, hf from apply(x86i.or64_rsp_r, {m}, {o}, {g}, {d}, {len}, mM, mu, hgR, hd, taut(ac), taut(ac), hx2)
    show by ex_intro({f}, simp(hf, hg, fe, rg, hr, ha2, keep(x86i.flags_ok)))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  have x32: bits_or(64, u, x) in bits(int_mul(8, 8)) by simp()
  show := apply(tr.hstore_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {c}, {8}, {u}, {bits_or(64, u, x)}, {hs}, {hs2}, {ds}, {rs}, {p}, {w}, he, hbase, a2b, hdd, hu, simp(), x32, hkp, hpt)
qed


// add qword [rsp + d], r64 (the home holding u, g holding x): the home := r,
// the sum as the spec orders it
theorem tr.add64_home_r(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len d c g x u r hs hs2 ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(35, pair(8, pair(g, pair(x86i.rsp_mem(d), pair(x86i.rsp_mem(d), tag(0, g))))))), m, o)) ->
  a2 = bits_add(64, a, len) -> base in omega -> d in bits(64) -> c = int_mod(int_sub(d, fr), 18446744073709551616) ->
  c in dom(hs) -> app(hs, c) = pair(8, u) ->
  g in x86_64_linux.Reg -> g in dom(rs) -> app(rs, g) = pair(8, x) -> r = bits_add(64, u, x) ->
  tr.hkeep(hs, hs2, c, 8) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, fn_update(hs2, c, pair(8, r)), ds, rs, p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len d c g x u r hs hs2 ds rs p w
  assume hat ha2 hbase hd hcd hdd hu hgR hgd hx hr0 hkp hpt
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
     (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "vm",
       fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), bits_add(64, int_add(app(app(s, "gpr"), 4), c), 0), 8, r))), empty)) proof
    fix m o
    assume hi hr hh hrs ho
    have ip := apply(tr.inv_parts, hi)
    have mM: m in x86_64_linux.Machine by taut(ip)
    have mu: m in univ(1) by taut(ip)
    have fe := apply(tr.frame_ea, {s}, {base}, {code}, {fr}, {m}, {w}, {d}, {c}, {0}, hi, hd, hcd, simp())
    have ac := apply(tr.home_acc, {s}, {base}, {code}, {fr}, {m}, {w}, {hs}, {d}, {c}, {8}, {u}, hi, hh, hd, hcd, hdd, hu)
    have hg := apply(tr.home_read, {s}, {base}, {code}, {fr}, {m}, {w}, {hs}, {d}, {c}, {8}, {u}, hi, hh, hd, hcd, hdd, hu)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {8}, {x}, hrs, hgd, hx)
    have hx2 := mp(all_elim(hat, {m}, {o}), ho, taut(ip), hr)
    obtain f, hf from apply(x86i.add64_rsp_r, {m}, {o}, {g}, {d}, {len}, mM, mu, hgR, hd, taut(ac), taut(ac), hx2)
    show by ex_intro({f}, simp(hf, hg, fe, rg, hr0, hr, ha2, keep(x86i.flags_ok)))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  have x32: r in bits(int_mul(8, 8)) by simp(hr0)
  show := apply(tr.hstore_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {c}, {8}, {u}, {r}, {hs}, {hs2}, {ds}, {rs}, {p}, {w}, he, hbase, a2b, hdd, hu, simp(), x32, hkp, hpt)
qed

// ----------------------------------------------------------------------
//  64-bit equality tests: cmp, then je / jne (ZF: the words equal)

// ----------------------------------------------------------------------
//  64-bit stores through a pointer: mov [b + d], r64 / mov qword [b + d],
//  imm32 (b holding bv, the spec's field store of 8 bytes at bv + d)

theorem tr.store64_bd(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g b d z1 z2 bv u hs ds rs p p2 w w2.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(75, pair(8, pair(g, pair(x86i.bd_mem(b, d), pair(z1, z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> base in omega -> g in x86_64_linux.Reg -> b in x86_64_linux.Reg -> d in bits(32) ->
  b in dom(rs) -> app(rs, b) = pair(8, bv) -> bv in bits(64) -> g in dom(rs) -> app(rs, g) = pair(8, u) -> g.mem_defined(w, bv, d, 8, true) ->
  w2 = fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), bits_add(64, bv, d), 8, u))) ->
  tr.red(p, w, p2, w2) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, rs, p2, w2) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g b d z1 z2 bv u hs ds rs p p2 w w2
  assume hat ha2 hbase hg hb hd hbd hbu hbv hgd hgu hdef hw2 hred hpt
  have dnz dlt dus := hdef
  let A := bits_add(64, bv, d)
  have ab: A in bits(64) by simp()
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "vm", fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), A, 8, u))), empty) proof
    fix m o
    assume hi hr hh hrs hmm ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rb b64 := apply(tr.regs_get, {m}, {rs}, {b}, {8}, {bv}, hrs, hbd, hbu)
    have rg .. := apply(tr.regs_get, {m}, {rs}, {g}, {8}, {u}, hrs, hgd, hgu)
    have d64: d in bits(64) by simp(hd)
    have ea: x86i.bd_ea(m, b, d) = A by simp(rb, b64, d64)
    have ev := apply(tr.bd_int, {bv}, {d}, simp(b64), hd, dlt)
    have hus: gimple.usable(app(w, "vm"), app(w, "objs"), A, 8, true) := rewrite(ev, dus)
    have wa := apply(tr.store_acc, {s}, {m}, {w}, {v}, {A}, {8}, hmm, ab, simp(), simp(), hus)
    have wa2 := rewrite(sym(ea), wa)
    have hx2 := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    have e := apply(x86i.store64_bd, {m}, {o}, {g}, {b}, {d}, {z1}, {z2}, {len}, ipM, ipU, hg, hb, d64, wa2, hx2)
    show by simp(e, ea, rg, hr, ha2)
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  have ev := apply(tr.bd_int, {bv}, {d}, hbv, hd, dlt)
  have hus: gimple.usable(app(w, "vm"), app(w, "objs"), A, 8, true) := rewrite(ev, dus)
  show := apply(tr.store_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {A}, {8}, {u}, {hs}, {ds}, {rs}, {p}, {p2}, {w}, {w2}, he, hbase, a2b, ab, simp(), simp(), hus, hw2, hred, hpt)
qed

theorem tr.store64i_bd(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len b d k kk bv hs ds rs p p2 w w2.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(77, pair(8, pair(x86i.bd_mem(b, d), pair(x86i.bd_mem(b, d), k))))), m, o)) ->
  a2 = bits_add(64, a, len) -> base in omega -> b in x86_64_linux.Reg -> d in bits(32) -> k in bits(32) -> kk = bits_sext(32, 64, k) ->
  b in dom(rs) -> app(rs, b) = pair(8, bv) -> bv in bits(64) -> g.mem_defined(w, bv, d, 8, true) ->
  w2 = fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), bits_add(64, bv, d), 8, kk))) ->
  tr.red(p, w, p2, w2) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, rs, p2, w2) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len b d k kk bv hs ds rs p p2 w w2
  assume hat ha2 hbase hb hd hk hkk hbd hbu hbv hdef hw2 hred hpt
  have dnz dlt dus := hdef
  let A := bits_add(64, bv, d)
  have ab: A in bits(64) by simp()
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "vm", fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), A, 8, kk))), empty) proof
    fix m o
    assume hi hr hh hrs hmm ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rb b64 := apply(tr.regs_get, {m}, {rs}, {b}, {8}, {bv}, hrs, hbd, hbu)
    have d64: d in bits(64) by simp(hd)
    have ea: x86i.bd_ea(m, b, d) = A by simp(rb, b64, d64)
    have ev := apply(tr.bd_int, {bv}, {d}, simp(b64), hd, dlt)
    have hus: gimple.usable(app(w, "vm"), app(w, "objs"), A, 8, true) := rewrite(ev, dus)
    have wa := apply(tr.store_acc, {s}, {m}, {w}, {v}, {A}, {8}, hmm, ab, simp(), simp(), hus)
    have wa2 := rewrite(sym(ea), wa)
    have hx2 := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    have e := apply(x86i.store64i_bd, {m}, {o}, {b}, {d}, {k}, {len}, ipM, ipU, hb, d64, hk, wa2, hx2)
    show by simp(e, ea, hkk, hr, ha2)
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  have ev := apply(tr.bd_int, {bv}, {d}, hbv, hd, dlt)
  have hus: gimple.usable(app(w, "vm"), app(w, "objs"), A, 8, true) := rewrite(ev, dus)
  show := apply(tr.store_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {A}, {8}, {kk}, {hs}, {ds}, {rs}, {p}, {p2}, {w}, {w2}, he, hbase, a2b, ab, simp(), simp(), hus, hw2, hred, hpt)
qed

// mov dword [b + d], imm32 (b holding the pointer bv): the spec's 4-byte
// store of k
theorem tr.store32i_bd(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len b d k bv ea hs ds rs p p2 w w2.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(77, pair(4, pair(x86i.bd_mem(b, d), pair(x86i.bd_mem(b, d), k))))), m, o)) ->
  a2 = bits_add(64, a, len) -> base in omega -> b in x86_64_linux.Reg -> d in bits(32) -> k in bits(32) ->
  b in dom(rs) -> app(rs, b) = pair(8, bv) -> bv in bits(64) -> ea = bits_add(64, bv, d) || (d = 0 && ea = bv) -> g.mem_defined(w, bv, d, 4, true) ->
  w2 = fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), ea, 4, k))) ->
  tr.red(p, w, p2, w2) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, rs, p2, w2) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len b d k bv ea hs ds rs p p2 w w2
  assume hat ha2 hbase hb hd hk hbd hbu hbv hea hdef hw2x hred hpt
  have dnz dlt dus := hdef
  let A := bits_add(64, bv, d)
  have ab: A in bits(64) by simp()
  have eae: ea = A by simp(hea, hbv)
  have hw2 := rewrite(eae, hw2x)
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "vm", fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), A, 4, k))), empty) proof
    fix m o
    assume hi hr hh hrs hmm ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rb b64 := apply(tr.regs_get, {m}, {rs}, {b}, {8}, {bv}, hrs, hbd, hbu)
    have d64: d in bits(64) by simp(hd)
    have ea: x86i.bd_ea(m, b, d) = A by simp(rb, b64, d64)
    have ev := apply(tr.bd_int, {bv}, {d}, simp(b64), hd, dlt)
    have hus: gimple.usable(app(w, "vm"), app(w, "objs"), A, 4, true) := rewrite(ev, dus)
    have wa := apply(tr.store_acc, {s}, {m}, {w}, {v}, {A}, {4}, hmm, ab, simp(), simp(), hus)
    have wa2 := rewrite(sym(ea), wa)
    have hx2 := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    have e := apply(x86i.store32i_bd, {m}, {o}, {b}, {d}, {k}, {len}, ipM, ipU, hb, d64, hk, wa2, hx2)
    show by simp(e, ea, hr, ha2)
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  have ev := apply(tr.bd_int, {bv}, {d}, hbv, hd, dlt)
  have hus: gimple.usable(app(w, "vm"), app(w, "objs"), A, 4, true) := rewrite(ev, dus)
  show := apply(tr.store_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {A}, {4}, {k}, {hs}, {ds}, {rs}, {p}, {p2}, {w}, {w2}, he, hbase, a2b, ab, simp(), simp(), hus, hw2, hred, hpt)
qed

// mov qword [rip + d], r64 (g holding u): the spec's 8-byte store at a
// static's address bigA
theorem tr.store64_rip(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g d z1 z2 u bigA hs ds rs p p2 w w2.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(75, pair(8, pair(g, pair(x86i.rip_mem(d), pair(z1, z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> base in omega -> g in x86_64_linux.Reg -> d in bits(64) -> g in dom(rs) -> app(rs, g) = pair(8, u) ->
  bigA = bits_add(64, int_add(a2, d), 0) -> gimple.usable(app(w, "vm"), app(w, "objs"), bigA, 8, true) ->
  w2 = fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), bigA, 8, u))) ->
  tr.red(p, w, p2, w2) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, rs, p2, w2) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g d z1 z2 u bigA hs ds rs p p2 w w2
  assume hat ha2 hbase hg hd hgd hgu hA hus hw2 hred hpt
  have ab: bigA in bits(64) by simp(hA)
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "vm", fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), bigA, 8, u))), empty) proof
    fix m o
    assume hi hr hh hrs hmm ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rg .. := apply(tr.regs_get, {m}, {rs}, {g}, {8}, {u}, hrs, hgd, hgu)
    have ea: x86i.rip_ea(m, len, d) = bigA by simp(hr, ha2, hA)
    have wa := apply(tr.store_acc, {s}, {m}, {w}, {v}, {bigA}, {8}, hmm, ab, simp(), simp(), hus)
    have wa2 := rewrite(sym(ea), wa)
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    have e := apply(x86i.store64_rip, {m}, {o}, {g}, {d}, {z1}, {z2}, {len}, ipM, ipU, hg, hd, wa2, hx)
    show by simp(e, ea, rg, hr, ha2)
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.store_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {bigA}, {8}, {u}, {hs}, {ds}, {rs}, {p}, {p2}, {w}, {w2}, he, hbase, a2b, ab, simp(), simp(), hus, hw2, hred, hpt)
qed

// mov dword [rip + d], r32 (g holding u): the spec's 4-byte store at a
// static's address bigA
theorem tr.store32_rip(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g d z1 z2 u bigA hs ds rs p p2 w w2.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(75, pair(4, pair(g, pair(x86i.rip_mem(d), pair(z1, z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> base in omega -> g in x86_64_linux.Reg -> d in bits(64) -> g in dom(rs) -> app(rs, g) = pair(4, u) ->
  bigA = bits_add(64, int_add(a2, d), 0) -> gimple.usable(app(w, "vm"), app(w, "objs"), bigA, 4, true) ->
  w2 = fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), bigA, 4, u))) ->
  tr.red(p, w, p2, w2) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, rs, p2, w2) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g d z1 z2 u bigA hs ds rs p p2 w w2
  assume hat ha2 hbase hg hd hgd hgu hA hus hw2 hred hpt
  have ab: bigA in bits(64) by simp(hA)
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "vm", fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), bigA, 4, u))), empty) proof
    fix m o
    assume hi hr hh hrs hmm ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rg u32 := apply(tr.regs_get, {m}, {rs}, {g}, {4}, {u}, hrs, hgd, hgu)
    have sl: bits_slice(u, 31, 0) = u by defs(simp(u32), bits_slice, bits_of_int)
    have ea: x86i.rip_ea(m, len, d) = bigA by simp(hr, ha2, hA)
    have wa := apply(tr.store_acc, {s}, {m}, {w}, {v}, {bigA}, {4}, hmm, ab, simp(), simp(), hus)
    have wa2 := rewrite(sym(ea), wa)
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    have e := apply(x86i.store32_rip, {m}, {o}, {g}, {d}, {z1}, {z2}, {len}, ipM, ipU, hg, hd, wa2, hx)
    show by simp(e, ea, rg, sl, hr, ha2)
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.store_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {bigA}, {4}, {u}, {hs}, {ds}, {rs}, {p}, {p2}, {w}, {w2}, he, hbase, a2b, ab, simp(), simp(), hus, hw2, hred, hpt)
qed

// ----------------------------------------------------------------------
//  size_to_class's operations: 64-bit arithmetic on registers and homes,
//  unsigned comparisons, a call's 32-bit result in signed arithmetic

// add r64, imm8: GIMPLE's u + kk
theorem tr.add64_imm(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g z k kk u r hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(60, pair(8, pair(0, pair(tag(0, g), pair(z, k)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> k in bits(8) -> kk = bits_sext(8, 64, k) -> g in dom(rs) -> app(rs, g) = pair(8, u) ->
  r = bits_add(64, u, kk) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs, g, pair(8, r)), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g z k kk u r hs ds rs p w
  assume hat ha2 hg hk hkk hd hu hr hpt0
  have hpt := rewrite(hr, hpt0)
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bits_add(64, u, kk))), empty)) proof
    fix m o
    assume hi hr hh hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {8}, {u}, hrs, hd, hu)
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    obtain f, hf from apply(x86i.add64_imm, {m}, {o}, {g}, {z}, {k}, {len}, ipM, ipU, gR, hk, hx)
    show by ex_intro({f}, simp(hf, rg, hr, ha2, hkk, keep(x86i.flags_ok)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_add(64, u, kk) in bits(int_mul(8, 8)) && bits_add(64, u, kk) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {8}, {bits_add(64, u, kk)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// add rax, imm32: rax := u + kk
theorem tr.add64_rax_imm(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len k kk u r hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(37, pair(8, k))), m, o)) ->
  a2 = bits_add(64, a, len) -> k in bits(32) -> kk = bits_sext(32, 64, k) -> 0 in dom(rs) -> app(rs, 0) = pair(8, u) ->
  r = bits_add(64, u, kk) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs, 0, pair(8, r)), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len k kk u r hs ds rs p w
  assume hat ha2 hk hkk hd hu hr hpt0
  have hpt := rewrite(hr, hpt0)
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), 0, bits_add(64, u, kk))), empty)) proof
    fix m o
    assume hi hr hh hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {0}, {8}, {u}, hrs, hd, hu)
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    obtain f, hf from apply(x86i.add64_rax_imm32, {m}, {o}, {k}, {len}, ipM, ipU, hk, hx)
    show by ex_intro({f}, simp(hf, rg, hr, ha2, hkk, keep(x86i.flags_ok)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_add(64, u, kk) in bits(int_mul(8, 8)) && bits_add(64, u, kk) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  have g0: tr.scratch_reg(0) by defs(simp(), tr.scratch_reg)
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {0}, {8}, {bits_add(64, u, kk)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, g0, ty, hpt)
qed

// a 32-bit result in a 64-bit register: its low half (the upper bits
// unspecified)
theorem tr.result32w: all w u. w in univ(1) -> u in bits(int_mul(8, 8)) -> (all y. y in bits(64) ->
  runs(mkprog(x1 x2. letin(bits_of_int(32, u), x5. bind_rel(gimple.result(32, x5), x1, x6 x7. any_rel(x8. x8 in bits(64), x8. x2 = ok(x6, pair(x7, x8))), x6 x7. x2 = exc(x6, x7), x6. x2 = diverge(x6)))), w, ok(w, pair(u, y))))
proof
  fix w u
  assume hw hb
  fix y
  assume hy
  have b64: u in bits(64) by simp(hb)
  have p32: int_pow(2, 32) = 4294967296 by simp()
  have m0: int_mod(u, 4294967296) = int_mod(bits_of_int(32, u), 4294967296) by arith(b64)
  have m := rewrite(sym(p32), m0)
  have ro: runs(gimple.result(32, bits_of_int(32, u)), w, ok(w, u)) by defs(simp(hw, b64, m), gimple.result, gimple.in_reg)
  have k: bind_rel(gimple.result(32, bits_of_int(32, u)), w, x6 x7. any_rel(x8. x8 in bits(64), x8. ok(w, pair(u, y)) = ok(x6, pair(x7, x8))), x6 x7. ok(w, pair(u, y)) = exc(x6, x7), x6. ok(w, pair(u, y)) = diverge(x6))
    by defs(ex_intro({ok(w, u)}, simp(ro, hy, keep(runs, gimple.result))), bind_rel)
  have pu: pair(w, ok(w, pair(u, y))) in univ(1) by simp(hw, b64, hy)
  show := mp(mp(all_elim(tr.runs_intro[r := x1 x2. letin(bits_of_int(32, u), x5. bind_rel(gimple.result(32, x5), x1, x6 x7. any_rel(x8. x8 in bits(64), x8. x2 = ok(x6, pair(x7, x8))), x6 x7. x2 = exc(x6, x7), x6. x2 = diverge(x6)))],
    {w}, {ok(w, pair(u, y))}), pu), defs(k, letin))
qed

// add qword [rsp + d], imm8: the home c (u) := u + kk
theorem tr.add64_home(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len d c k kk u r hs hs2 ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(60, pair(8, pair(0, pair(x86i.rsp_mem(d), pair(x86i.rsp_mem(d), k)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> base in omega -> d in bits(64) -> c = int_mod(int_sub(d, fr), 18446744073709551616) ->
  k in bits(8) -> kk = bits_sext(8, 64, k) -> c in dom(hs) -> app(hs, c) = pair(8, u) ->
  tr.hkeep(hs, hs2, c, 8) ->
  r = bits_add(64, u, kk) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, fn_update(hs2, c, pair(8, r)), ds, rs, p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len d c k kk u r hs hs2 ds rs p w
  assume hat ha2 hbase hd hcd hk hkk hdd hu hkp hr hpt0
  have hpt := rewrite(hr, hpt0)
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
     (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "vm",
       fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), bits_add(64, int_add(app(app(s, "gpr"), 4), c), 0), 8, bits_add(64, u, kk)))), empty)) proof
    fix m o
    assume hi hr hh hrs ho
    have ip := apply(tr.inv_parts, hi)
    have mM: m in x86_64_linux.Machine by taut(ip)
    have mu: m in univ(1) by taut(ip)
    have fe := apply(tr.frame_ea, {s}, {base}, {code}, {fr}, {m}, {w}, {d}, {c}, {0}, hi, hd, hcd, simp())
    have ac := apply(tr.home_acc, {s}, {base}, {code}, {fr}, {m}, {w}, {hs}, {d}, {c}, {8}, {u}, hi, hh, hd, hcd, hdd, hu)
    have hg := apply(tr.home_read, {s}, {base}, {code}, {fr}, {m}, {w}, {hs}, {d}, {c}, {8}, {u}, hi, hh, hd, hcd, hdd, hu)
    have hx := mp(all_elim(hat, {m}, {o}), ho, taut(ip), hr)
    obtain f, hf from apply(x86i.add64_rsp_imm, {m}, {o}, {d}, {k}, {len}, mM, mu, hd, hk, taut(ac), taut(ac), hx)
    show by ex_intro({f}, simp(hf, hg, fe, hr, ha2, hkk, keep(x86i.flags_ok)))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  have x64: bits_add(64, u, kk) in bits(int_mul(8, 8)) by simp()
  show := apply(tr.hstore_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {c}, {8}, {u}, {bits_add(64, u, kk)}, {hs}, {hs2}, {ds}, {rs}, {p}, {w}, he, hbase, a2b, hdd, hu, simp(), x64, hkp, hpt)
qed

// mov r32 h, r32 g, g holding a 64-bit word u: h := u's low half
theorem tr.mov32_rr8(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g h z1 z2 u r hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(75, pair(4, pair(g, pair(tag(0, h), pair(z1, z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(h) -> g in x86_64_linux.Reg -> g in dom(rs) -> app(rs, g) = pair(8, u) ->
  r = bits_of_int(32, u) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs, h, pair(4, r)), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g h z1 z2 u r hs ds rs p w
  assume hat ha2 hh hg hd hu hr hpt0
  have hpt := rewrite(hr, hpt0)
  have hR: h in x86_64_linux.Reg by taut(expand(hh, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(app(m, "gpr"), h, bits_of_int(32, u))), empty) proof
    fix m o
    assume hi hr hhs hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {8}, {u}, hrs, hd, hu)
    have hx := mp(mp(mp(all_elim(hat, {m}, {o}), ho), ipC), hr)
    have e := apply(x86i.mov32_rr, {m}, {o}, {g}, {h}, {z1}, {z2}, {len}, ipM, ipU, hg, hR, hx)
    have sl: bits_slice(u, 31, 0) = bits_of_int(32, u) by defs(simp(), bits_slice, bits_of_int)
    show by simp(e, rg, hr, ha2, sl)
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_of_int(32, u) in bits(int_mul(8, 4)) && bits_of_int(32, u) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {h}, {4}, {bits_of_int(32, u)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hh, ty, hpt)
qed

// lea r32 g, [i * k] (i holding the 32-bit u): g := u * k, 32 bits
theorem tr.lea32_is(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g i k z1 z2 z3 u r hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(78, pair(4, pair(g, pair(z1, pair(z2, pair(z3, fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(0, empty)), "index", some(i)), "scale", k), "disp", 0)))))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> i in x86_64_linux.Reg -> k in bits(64) -> i in dom(rs) -> app(rs, i) = pair(4, u) ->
  r = bits_mul(32, u, k) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs, g, pair(4, r)), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g i k z1 z2 z3 u r hs ds rs p w
  assume hat ha2 hg hi hk hd hu hr hpt0
  have hpt := rewrite(hr, hpt0)
  // (the 64-bit product's low half: the 32-bit product)
  have p64: pow2(64) = 18446744073709551616 by simp()
  have p32: pow2(32) = 4294967296 by simp()
  have e0: bits_add(32, int_mod(int_mul(u, k), 18446744073709551616), 0) = int_mod(int_mul(u, k), 4294967296) by arith()
  have hm: bits_add(32, bits_mul(64, u, k), 0) = bits_mul(32, u, k) by defs(rewrite(sym(p32), rewrite(sym(p64), e0)), bits_mul)
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(app(m, "gpr"), g, bits_mul(32, u, k))), empty) proof
    fix m o
    assume hi2 hr hhs hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi2)
    have rg := apply(tr.regs_get, {m}, {rs}, {i}, {4}, {u}, hrs, hd, hu)
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    have e := apply(x86i.lea32_is, {m}, {o}, {g}, {i}, {k}, {z1}, {z2}, {z3}, {len}, ipM, ipU, gR, hi, simp(hk), hx)
    have k0: bits_add(64, k, 0) = k by simp(hk)
    show by simp(e, rg, hr, ha2, k0, hm)
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_mul(32, u, k) in bits(int_mul(8, 4)) && bits_mul(32, u, k) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {bits_mul(32, u, k)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// (cmp u, kk: sf != of exactly when u < kk, signed)
theorem tr.jl_flags: all u kk. u in bits(32) -> kk in bits(32) ->
  ((!(bit(bits_sub(32, u, kk), 31) <-> !(int_sub(sint(32, u), sint(32, kk)) = sint(32, bits_sub(32, u, kk))))) <-> int_lt(sint(32, u), sint(32, kk)))
proof
  fix u kk
  assume hu hk
  let D := bits_sub(32, u, kk)
  have jf := apply(tr.jle_flags, {u}, {kk}, hu, hk)
  have ub: int_le(0, u) && int_lt(u, 4294967296) by simp(hu)
  have kb: int_le(0, kk) && int_lt(kk, 4294967296) by simp(hk)
  have hD: D = int_mod(int_sub(u, kk), 4294967296) by defs(simp(), bits_sub, pow2)
  have su: (int_lt(u, 2147483648) && sint(32, u) = u) || (!int_lt(u, 2147483648) && sint(32, u) = int_sub(u, 4294967296)) by defs(simp(hu), sint, letin, pow2)
  have sk: (int_lt(kk, 2147483648) && sint(32, kk) = kk) || (!int_lt(kk, 2147483648) && sint(32, kk) = int_sub(kk, 4294967296)) by defs(simp(hk), sint, letin, pow2)
  have iu := apply(tr.sint32_int, hu)
  have ik := apply(tr.sint32_int, hk)
  have eq: (D = 0) <-> (sint(32, u) = sint(32, kk)) by arith(ub, kb, hD, su, sk, iu, ik)
  have nx: D = 0 -> !(!(bit(D, 31) <-> !(int_sub(sint(32, u), sint(32, kk)) = sint(32, D)))) proof
    assume e
    have ee: sint(32, u) = sint(32, kk) by taut(eq, e)
    have s0: int_sub(sint(32, u), sint(32, kk)) = 0 by arith(ee, iu, ik)
    show by simp(e, s0)
  qed
  have lt: int_lt(sint(32, u), sint(32, kk)) <-> (int_le(sint(32, u), sint(32, kk)) && !(sint(32, u) = sint(32, kk))) by arith(iu, ik)
  show by taut(jf, eq, nx, lt)
qed

// a store and a register written by one instruction (lock cmpxchg)
theorem tr.store_reg_step(zb. bkp, zb pb wb. bka): all s v base code fr a a2 a8 n x g k bigv hs ds rs p p2 w w2.
  (all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
     (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "vm",
       fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), a8, n, x))), "gpr", fn_update(app(m, "gpr"), g, bigv)), empty))) ->
  base in omega -> a2 in bits(64) -> a8 in bits(64) -> n in omega -> int_le(n, 8) -> gimple.usable(app(w, "vm"), app(w, "objs"), a8, n, true) ->
  tr.scratch_reg(g) -> bigv in bits(int_mul(8, k)) -> bigv in bits(64) ->
  w2 = fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), a8, n, x))) ->
  tr.red(p, w, p2, w2) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs, g, pair(k, bigv)), p2, w2) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 a8 n x g k bigv hs ds rs p p2 w w2
  assume he hbase ha2 ha8 hn hn8 hus hg hbk hb64 hw2 hred hpt
  have g: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, ds) -> tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m) proof
    fix m
    assume hi hr hh hrs hmm hfr
    have i := expand(hi, tr.inv)
    have mM: m in x86_64_linux.Machine by simp(i, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access))
    have mu: m in univ(1) by simp(i, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access))
    have sM: s in x86_64_linux.Machine by simp(i, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access))
    have cd: abi.code_at(app(m, "vm"), base, code) by simp(i, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access))
    have wW: w in abi.World && w in univ(1) by simp(i, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access))
    have r4 := apply(x86i.rsp_typed, sM)
    have nr := apply(tr.inv_nr, hi)
    let VM2 := fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), a8, n, x))
    let M2 := fn_update(fn_update(m, "rip", a2), "vm", VM2)
    let MX(f) := fn_update(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "vm", VM2), "gpr", fn_update(app(m, "gpr"), g, bigv))
    let Q(m2) := ex f. x86i.flags_ok(m, f) && m2 = MX(f)
    have st: all o. runs(x86_64_linux.step(), m, o) -> (ex m2. o = ok(m2, empty) && Q(m2)) proof
      fix o
      assume ho
      obtain f, hf from mp(all_elim(he, {m}, {o}), hi, hr, hh, hrs, hmm, ho)
      have q2: Q(MX(f)) by ex_intro({f}, simp(hf, keep(x86i.flags_ok)))
      show by ex_intro({MX(f)}, taut(q2, hf))
    qed
    have post: all m2. Q(m2) -> tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m2) proof
      fix m2
      assume hq
      obtain f, fo e2 from hq
      have pt := apply(x86i.parts, mM)
      // the machine's store: writable, its code untouched
      have wa := apply(tr.store_acc, {s}, {m}, {w}, {v}, {a8}, {n}, hmm, ha8, hn, hn8, hus)
      have sc := apply(tr.store_code_acc, {base}, {code}, {app(m, "vm")}, {a8}, {n}, hn, hbase, cd, wa)
      have cd2: abi.code_at(fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), a8, n, x)), base, code) := all_elim(sc, {x})
      have k0: tr.keeps_code(app(s, "vm"), app(m, "vm")) by simp(i, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access, tr.keeps_code))
      have kc := apply(tr.keeps_store, {app(s, "vm")}, {app(m, "vm")}, {a8}, {n}, {x}, hn, k0, wa)
      have kp := apply(tr.store_keeps, {s}, {base}, {code}, {fr}, {m}, {w}, {v}, {hs}, {a8}, {n}, {x}, hi, hmm, hh, ha8, hn, hus)
      have vV: app(m, "vm") in x86_64_linux.Vm by simp(pt)
      have su := apply(g.store_univ, {app(m, "vm")}, {a8}, {n}, {x}, vV)
      have nu: fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), a8, n, x)) in univ(1) by simp(mu, su)
      have nv := apply(x86.store_vm, {app(m, "vm")}, {a8}, {n}, {x}, vV, nu)
      have m2M: M2 in x86_64_linux.Machine by defs(simp(expand(mM, x86_64_linux.Machine), mu, pt, nv, nu, ha2), x86_64_linux.Machine)
      have m2u: M2 in univ(1) by simp(mu, nu, ha2)
      have ws := apply(tr.world_store, {w}, {a8}, {n}, {x}, taut(wW), taut(wW), ha8)
      have ws2 := rewrite(sym(hw2), ws)
      have kpt: tr.kept(app(s, "vm"), app(m, "vm"), app(app(s, "gpr"), 4)) by simp(i, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access, tr.kept))
      have vb := apply(tr.kept_bytes, {app(s, "vm")}, {app(m, "vm")}, {app(app(s, "gpr"), 4)}, {x86_64_linux.store_le(app(app(m, "vm"), "bytes"), a8, n, x)}, kpt)
      have i2: tr.inv(s, base, code, fr, M2, w2) by defs(simp(i, hw2, m2M, m2u, cd2, kc, kp, ws2, vb, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access, tr.kept)), tr.inv)
      have khm: tr.homes(s, fn_update(m, "vm", fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), a8, n, x))), hs) by taut(kp)
      have kh: tr.homes(s, M2, hs) by defs(simp(expand(khm, tr.homes)), tr.homes)
      have mm2 := apply(tr.mem_store, {s}, {m}, {M2}, {w}, {w2}, {v}, {a8}, {n}, {x}, hmm, ha8, hus, simp(), simp(hw2), simp(hw2))
      have pe: app(app(M2, "vm"), "pages") = app(app(m, "vm"), "pages") by simp()
      have f2 := apply(tr.frame_store, {s}, {m}, {M2}, {ds}, {app(m, "vm")}, hfr, simp(), all_elim(x86.grows_refl, {app(m, "vm")}), all_elim(x86.stk_ext_refl, {app(m, "vm")}), pe, simp(), simp())
      have fo2: x86i.flags_ok(M2, f) by defs(simp(expand(fo, x86i.flags_ok)), x86i.flags_ok)
      have ir := apply(tr.inv_reg, {s}, {base}, {code}, {fr}, {M2}, {w2}, {a2}, {f}, {g}, {bigv}, i2, ha2, fo2, hg, hb64)
      // (the machine after: M2 with rip, flags and the register -- MX(f))
      have s1 := mp(fn_update_swap[f := fn_update(m, "rip", a2), k := "vm", a := VM2, j := "rip", b := a2], simp())
      have s2 := fn_update_twice[f := m, k := "rip", a := a2, b := a2]
      have s3 := mp(fn_update_swap[f := fn_update(m, "rip", a2), k := "vm", a := VM2, j := "flags", b := f], simp())
      have gm: app(M2, "gpr") = app(m, "gpr") by simp()
      have mx: fn_update(fn_update(fn_update(M2, "rip", a2), "flags", f), "gpr", fn_update(app(M2, "gpr"), g, bigv)) = MX(f) by simp(s1, s2, s3, gm)
      have ix := rewrite(mx, ir)
      have rr := apply(tr.regs_set, {m}, {rs}, {g}, {k}, {bigv}, hrs, hbk)
      have rsx: tr.regs(MX(f), fn_update(rs, g, pair(k, bigv))) by defs(simp(expand(rr, tr.regs)), tr.regs)
      have rpx: app(MX(f), "rip") = a2 by simp()
      have c := apply(tr.pt_regs[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], hpt, ix, rpx, rsx, kh, mm2, f2, simp(), simp())
      have c2 := apply(tr.cl_red[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], hred, c)
      show := rewrite(sym(e2), c2)
    qed
    show := mp(mp(mp(tr.step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb), s := s, v := v, p := p, w := w, m := m, q := y. Q(y)], st), nr), post)
  qed
  show by defs(g, tr.lv)
qed

// cas32 at p (a = p): its old dword D read, the store of s if D is t, else
// of D
theorem tr.cas32_at_ok: all w p t sv a. w in abi.World -> w in univ(1) -> p in bits(64) -> t in bits(32) -> sv in bits(32) -> a = int_add(p, 0) ->
  g.mem_defined(w, p, 0, 4, true) && g.mem_defined(w, p, 0, 4, false) ->
  runs(gimple.cas32(p, t, sv), w, ok(fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), a, 4,
    ite(bits_of_int(32, gimple.bytes_at(app(w, "vm"), a, 4)) = t, sv, bits_of_int(32, gimple.bytes_at(app(w, "vm"), a, 4)))))),
    bits_of_int(32, gimple.bytes_at(app(w, "vm"), a, 4))))
proof
  fix w p t sv a
  assume hW hw hp ht hv ha hd
  have hdw: g.mem_defined(w, p, 0, 4, true) by taut(hd)
  have hdr: g.mem_defined(w, p, 0, 4, false) by taut(hd)
  have ap: a = p by simp(ha, hp)
  let D := bits_of_int(32, gimple.bytes_at(app(w, "vm"), p, 4))
  let V := ite(D = t, sv, D)
  have vb: V in bits(32) proof
    have c1: D = t -> V in bits(32) by simp(hv)
    have c2: !(D = t) -> V in bits(32) by simp()
    show by taut(c1, c2)
  qed
  have ld := apply(g.ld32_ok, {w}, {p}, hw, hp, hdr)
  have st := apply(tr.st32_at_ok, {w}, {p}, {0}, {V}, {p}, hW, hw, hp, simp(), vb, simp(hp), hdw)
  have wf := expand(hW, abi.World)
  have vV: app(w, "vm") in x86_64_linux.Vm by simp(wf)
  have stu := apply(fn_space_univ, bits_univ[n := 64], bits_univ[n := 8], apply(x86.store_typed, {app(app(w, "vm"), "bytes")}, {p}, {4}, {V}, simp(vV)))
  have r: runs(gimple.cas32(p, t, sv), w, ok(fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), p, 4, V))), D))
    by defs(simp(hw, ld, st, stu, keep(gimple.ld32, gimple.st32)), gimple.cas32)
  show := subst({y. runs(gimple.cas32(p, t, sv), w, ok(fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), y, 4,
    ite(bits_of_int(32, gimple.bytes_at(app(w, "vm"), y, 4)) = t, sv, bits_of_int(32, gimple.bytes_at(app(w, "vm"), y, 4)))))),
    bits_of_int(32, gimple.bytes_at(app(w, "vm"), y, 4))))}, sym(ap), r)
qed

theorem tr.cas32_ub: all s p t sv s2 e. s in univ(1) -> s2 in univ(1) -> e in univ(1) -> p in bits(64) ->
  !(g.mem_defined(s, p, 0, 4, true) && g.mem_defined(s, p, 0, 4, false)) ->
  runs(gimple.cas32(p, t, sv), s, exc(s2, e))
proof
  fix s p t sv s2 e
  assume hs h2 he hp hn
  // (not readable: the load raises; readable, not writable: the store)
  have c1: !g.mem_defined(s, p, 0, 4, false) -> runs(gimple.cas32(p, t, sv), s, exc(s2, e)) proof
    assume h
    have lu := apply(g.ld32_ub, {s}, {p}, {s2}, {e}, hs, h2, he, hp, h)
    show by defs(simp(hs, h2, he, lu, keep(gimple.ld32, gimple.st32)), gimple.cas32)
  qed
  have c2: g.mem_defined(s, p, 0, 4, false) -> !g.mem_defined(s, p, 0, 4, true) -> runs(gimple.cas32(p, t, sv), s, exc(s2, e)) proof
    assume h hw
    let D := bits_of_int(32, gimple.bytes_at(app(s, "vm"), p, 4))
    have ld := apply(g.ld32_ok, {s}, {p}, hs, hp, h)
    have su := apply(g.st32_at_ub, {s}, {p}, {0}, {ite(D = t, sv, D)}, {s2}, {e}, hs, h2, he, hp, simp(), hw)
    show by defs(simp(hs, h2, he, ld, su, keep(gimple.ld32, gimple.st32)), gimple.cas32)
  qed
  show by taut(hn, c1, c2)
qed

// a machine's registers written back unchanged
theorem tr.gpr_same: all m r f vm2. m in x86_64_linux.Machine ->
  fn_update(fn_update(fn_update(fn_update(m, "rip", r), "flags", f), "vm", vm2), "gpr", app(m, "gpr")) = fn_update(fn_update(fn_update(m, "rip", r), "flags", f), "vm", vm2)
proof
  fix m r f vm2
  assume hM
  have mf: is_fun(m) && "gpr" in dom(m) by simp(expand(hM, x86_64_linux.Machine))
  have mfun := mf.1
  have f1 := mp(fn_update_fun[f := m, k := "rip", v := r], mfun)
  have d1 := mp(dom_update[f := m, k := "rip", v := r], mfun)
  have f2 := mp(fn_update_fun[f := fn_update(m, "rip", r), k := "flags", v := f], f1)
  have d2 := mp(dom_update[f := fn_update(m, "rip", r), k := "flags", v := f], f1)
  have f3 := mp(fn_update_fun[f := fn_update(fn_update(m, "rip", r), "flags", f), k := "vm", v := vm2], f2)
  have d3 := mp(dom_update[f := fn_update(fn_update(m, "rip", r), "flags", f), k := "vm", v := vm2], f2)
  let M3 := fn_update(fn_update(fn_update(m, "rip", r), "flags", f), "vm", vm2)
  have r3: is_fun(M3) && "gpr" in dom(M3) by simp(mf, f1, d1, f2, d2, f3, d3)
  have e := mp(mp(fn_update_same[f := M3, k := "gpr"], simp(r3)), simp(r3))
  have e2: app(M3, "gpr") = app(m, "gpr") by simp()
  show := rewrite(e2, e)
qed

// lock cmpxchg [b] (b holding bv), r32 (g holding sv; eax t): the spec's
// compare-and-swap at bv -- its old dword D, sv written if D is t, else D;
// eax D either way
theorem tr.cas32_b(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g b z1 z2 z3 bv tv sv r hs ds rs p p2 w w2.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(97, pair(4, pair(g, pair(x86i.bd_mem(b, 0), pair(z1, pair(z2, z3))))))), m, o)) ->
  a2 = bits_add(64, a, len) -> base in omega -> g in x86_64_linux.Reg -> b in x86_64_linux.Reg ->
  b in dom(rs) -> app(rs, b) = pair(8, bv) -> bv in bits(64) -> g in dom(rs) -> app(rs, g) = pair(4, sv) -> 0 in dom(rs) -> app(rs, 0) = pair(4, tv) ->
  r = bits_of_int(32, gimple.bytes_at(app(w, "vm"), bv, 4)) ->
  g.mem_defined(w, bv, 0, 4, true) && g.mem_defined(w, bv, 0, 4, false) ->
  w2 = fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), bv, 4,
    ite(bits_of_int(32, gimple.bytes_at(app(w, "vm"), bv, 4)) = tv, sv, bits_of_int(32, gimple.bytes_at(app(w, "vm"), bv, 4)))))) ->
  tr.red(p, w, p2, w2) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs, 0, pair(4, r)), p2, w2) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g b z1 z2 z3 bv tv sv r hs ds rs p p2 w w2
  assume hat ha2 hbase hg hb hbd hbu bb hgd hgu h0d h0u hr hd hw2 hred hpt0
  have hpt := rewrite(hr, hpt0)
  let D := bits_of_int(32, gimple.bytes_at(app(w, "vm"), bv, 4))
  let V := ite(D = tv, sv, D)
  have hdw: g.mem_defined(w, bv, 0, 4, true) by taut(hd)
  have hdr: g.mem_defined(w, bv, 0, 4, false) by taut(hd)
  have hus: gimple.usable(app(w, "vm"), app(w, "objs"), bv, 4, true) by simp(hdw, bb)
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "vm",
        fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), bv, 4, V))), "gpr", fn_update(app(m, "gpr"), 0, D)), empty)) proof
    fix m o
    assume hi hr hh hrs hmm ho
    let G := ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "vm",
        fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), bv, 4, V))), "gpr", fn_update(app(m, "gpr"), 0, D)), empty)
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have pt := apply(x86i.parts, ipM)
    have rb := apply(tr.regs_get, {m}, {rs}, {b}, {8}, {bv}, hrs, hbd, hbu)
    have rg u32 := apply(tr.regs_get, {m}, {rs}, {g}, {4}, {sv}, hrs, hgd, hgu)
    have r0 t32 := apply(tr.regs_get, {m}, {rs}, {0}, {4}, {tv}, hrs, h0d, h0u)
    have tb := apply(x86i.reg_typed, ipM, hb)
    have ea: x86i.bd_ea(m, b, 0) = bv by simp(rb, tb)
    have sl: bits_slice(sv, 31, 0) = sv by defs(simp(u32), bits_slice, bits_of_int)
    have sl0: bits_slice(tv, 31, 0) = tv by defs(simp(t32), bits_slice, bits_of_int)
    have rd := apply(tr.reads, {s}, {m}, {w}, {v}, {bv}, {0}, {4}, bb, simp(), hdr, hmm, simp())
    have wa := apply(tr.store_acc, {s}, {m}, {w}, {v}, {bv}, {4}, hmm, bb, simp(), simp(), hus)
    have b0: bits_add(64, bv, 0) = bv by simp(bb)
    have ra := rewrite(sym(ea), rewrite(b0, rd.1))
    have wa2 := rewrite(sym(ea), wa)
    have lw := all_elim(tr.le_bytes, {app(w, "vm")}, {bv}, {4})
    have dm: x86_64_linux.le(app(app(m, "vm"), "bytes"), bv, 4) = D by simp(rewrite(b0, rd.2), lw, keep(gimple.bytes_at, x86_64_linux.le))
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    have ceq cne := apply(x86i.cas32_b, {m}, {o}, {g}, {b}, {z1}, {z2}, {z3}, {len}, ipM, ipU, hg, hb, ra, wa2, hx)
    // (t the old dword: s written, rax unchanged -- it is D)
    have c1: D = tv -> G proof
      assume e
      obtain f, fo eo from mp(ceq, simp(r0, sl0, ea, dm, e))
      have gf: is_fun(app(m, "gpr")) && 0 in dom(app(m, "gpr")) by defs(simp(pt), fn_space)
      have gs := mp(mp(fn_update_same[f := app(m, "gpr"), k := 0], simp(gf)), simp(gf))
      have gs2: fn_update(app(m, "gpr"), 0, D) = app(m, "gpr") by simp(gs, r0, e)
      have ms := apply(tr.gpr_same, {m}, {bits_add(64, app(m, "rip"), len)}, {f}, {fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), bv, 4, V))}, ipM)
      show by ex_intro({f}, simp(fo, eo, ea, rg, sl, e, gs2, ms, hr, ha2, keep(x86i.flags_ok)))
    qed
    // (else D written back, eax D)
    have c2: !(D = tv) -> G proof
      assume e
      obtain f, fo eo from mp(cne, simp(r0, sl0, ea, dm, e))
      show by ex_intro({f}, simp(fo, eo, ea, dm, e, hr, ha2, keep(x86i.flags_ok)))
    qed
    show by taut(c1, c2)
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  have hg0: tr.scratch_reg(0) by defs(simp(), tr.scratch_reg)
  have d32: D in bits(int_mul(8, 4)) by simp()
  have d64: D in bits(64) by simp()
  show := apply(tr.store_reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {bv}, {4}, {V}, {0}, {4}, {D}, {hs}, {ds}, {rs}, {p}, {p2}, {w}, {w2}, he, hbase, a2b, bb, simp(), simp(), hus, hg0, d32, d64, hw2, hred, hpt)
qed

// mov [b + d], r32 (b holding bv, g holding u: the spec's field store of 4
// bytes at bv + d)
theorem tr.store32_bd(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g b d z1 z2 bv u hs ds rs p p2 w w2.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(75, pair(4, pair(g, pair(x86i.bd_mem(b, d), pair(z1, z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> base in omega -> g in x86_64_linux.Reg -> b in x86_64_linux.Reg -> d in bits(32) ->
  b in dom(rs) -> app(rs, b) = pair(8, bv) -> bv in bits(64) -> g in dom(rs) -> app(rs, g) = pair(4, u) -> g.mem_defined(w, bv, d, 4, true) ->
  w2 = fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), bits_add(64, bv, d), 4, u))) ->
  tr.red(p, w, p2, w2) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, rs, p2, w2) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g b d z1 z2 bv u hs ds rs p p2 w w2
  assume hat ha2 hbase hg hb hd hbd hbu hbv hgd hgu hdef hw2 hred hpt
  have dnz dlt dus := hdef
  let A := bits_add(64, bv, d)
  have ab: A in bits(64) by simp()
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "vm", fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), A, 4, u))), empty) proof
    fix m o
    assume hi hr hh hrs hmm ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rb b64 := apply(tr.regs_get, {m}, {rs}, {b}, {8}, {bv}, hrs, hbd, hbu)
    have rg u32 := apply(tr.regs_get, {m}, {rs}, {g}, {4}, {u}, hrs, hgd, hgu)
    have sl: bits_slice(u, 31, 0) = u by defs(simp(u32), bits_slice, bits_of_int)
    have d64: d in bits(64) by simp(hd)
    have ea: x86i.bd_ea(m, b, d) = A by simp(rb, b64, d64)
    have ev := apply(tr.bd_int, {bv}, {d}, simp(b64), hd, dlt)
    have hus: gimple.usable(app(w, "vm"), app(w, "objs"), A, 4, true) := rewrite(ev, dus)
    have wa := apply(tr.store_acc, {s}, {m}, {w}, {v}, {A}, {4}, hmm, ab, simp(), simp(), hus)
    have wa2 := rewrite(sym(ea), wa)
    have hx2 := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    have e := apply(x86i.store32_bd, {m}, {o}, {g}, {b}, {d}, {z1}, {z2}, {len}, ipM, ipU, hg, hb, d64, wa2, hx2)
    show by simp(e, ea, rg, sl, hr, ha2)
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  have ev := apply(tr.bd_int, {bv}, {d}, hbv, hd, dlt)
  have hus: gimple.usable(app(w, "vm"), app(w, "objs"), A, 4, true) := rewrite(ev, dus)
  show := apply(tr.store_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {A}, {4}, {u}, {hs}, {ds}, {rs}, {p}, {p2}, {w}, {w2}, he, hbase, a2b, ab, simp(), simp(), hus, hw2, hred, hpt)
qed

// mov [b + d], r32 of a register u equal to the spec's word x (the same
// value written otherwise: the equation shown apart)
theorem tr.store32_bd_eq(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g b d z1 z2 bv u x hs ds rs p p2 w w2.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(75, pair(4, pair(g, pair(x86i.bd_mem(b, d), pair(z1, z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> base in omega -> g in x86_64_linux.Reg -> b in x86_64_linux.Reg -> d in bits(32) ->
  b in dom(rs) -> app(rs, b) = pair(8, bv) -> bv in bits(64) -> g in dom(rs) -> app(rs, g) = pair(4, u) -> u = x -> g.mem_defined(w, bv, d, 4, true) ->
  w2 = fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), bits_add(64, bv, d), 4, x))) ->
  tr.red(p, w, p2, w2) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, rs, p2, w2) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g b d z1 z2 bv u x hs ds rs p p2 w w2
  assume hat ha2 hbase hg hb hd hbd hbu hbv hgd hgu hux hdef hw2 hred hpt
  have hw := rewrite(sym(hux), hw2)
  show := apply(tr.store32_bd[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {len}, {g}, {b}, {d}, {z1}, {z2}, {bv}, {u}, {hs}, {ds}, {rs}, {p}, {p2}, {w}, {w2}, hat, ha2, hbase, hg, hb, hd, hbd, hbu, hbv, hgd, hgu, hdef, hw, hred, hpt)
qed

// ----------------------------------------------------------------------
//  Bitfield stores: GIMPLE's stbf, a read-modify-write of size bytes; the
//  machine reads them (a write's definedness lets it), merges, stores

// a bitfield's store: the size bytes at p + off, the field v at bits pos..
theorem g.stbf_at_ok: all s p off size pos k v. s in univ(1) -> p in bits(64) -> off in bits(32) -> size in omega -> int_lt(size, 18446744073709551616) ->
  g.mem_defined(s, p, off, size, true) -> app(s, "vm") in x86_64_linux.Vm -> is_fun(s) -> "vm" in dom(s) -> int_add(bits_and(128, gimple.b128(gimple.bytes_at(app(s, "vm"), int_add(p, off), size)), bits_not(128, gimple.b128(int_mul(int_pow(2, pos), int_sub(int_pow(2, k), 1))))), int_mul(int_mod(v, int_pow(2, k)), int_pow(2, pos))) in omega ->
  runs(gimple.stbf(p, off, size, pos, k, v), s, ok(fn_update(s, "vm", fn_update(app(s, "vm"), "bytes", x86_64_linux.store_le(app(app(s, "vm"), "bytes"), int_add(p, off), size, int_add(bits_and(128, gimple.b128(gimple.bytes_at(app(s, "vm"), int_add(p, off), size)), bits_not(128, gimple.b128(int_mul(int_pow(2, pos), int_sub(int_pow(2, k), 1))))), int_mul(int_mod(v, int_pow(2, k)), int_pow(2, pos)))))), empty))
proof
  fix s p off size pos k v
  assume hs hp ho hn hn2 hdf hvm hf hd hvo
  have m := apply(g.mem_at_ok, {s}, {p}, {off}, {size}, {true}, hs, hp, ho, hdf)
  have ab: int_add(p, off) in bits(64) by simp(hdf, hp, ho)
  have w := apply(g.write_ok, {s}, {int_add(p, off)}, {size}, {int_add(bits_and(128, gimple.b128(gimple.bytes_at(app(s, "vm"), int_add(p, off), size)), bits_not(128, gimple.b128(int_mul(int_pow(2, pos), int_sub(int_pow(2, k), 1))))), int_mul(int_mod(v, int_pow(2, k)), int_pow(2, pos)))}, hs, ab, hn, hn2, hvo, hvm, hf, hd)
  have stu := apply(fn_space_univ, bits_univ[n := 64], bits_univ[n := 8], apply(x86.store_typed, {app(app(s, "vm"), "bytes")}, {int_add(p, off)}, {size}, {int_add(bits_and(128, gimple.b128(gimple.bytes_at(app(s, "vm"), int_add(p, off), size)), bits_not(128, gimple.b128(int_mul(int_pow(2, pos), int_sub(int_pow(2, k), 1))))), int_mul(int_mod(v, int_pow(2, k)), int_pow(2, pos)))}, simp(hvm)))
  show by defs(simp(hs, m, w, stu, keep(gimple.mem, gimple.write_bytes)), gimple.stbf)
qed

theorem g.stbf_at_ub: all s p off size pos k v s2 e. s in univ(1) -> s2 in univ(1) -> e in univ(1) -> p in bits(64) -> off in bits(32) -> !g.mem_defined(s, p, off, size, true) ->
  runs(gimple.stbf(p, off, size, pos, k, v), s, exc(s2, e))
proof
  fix s p off size pos k v s2 e
  assume hs h2 he hp ho hn
  have mu := apply(g.mem_at_ub, {s}, {p}, {off}, {size}, {true}, {s2}, {e}, hs, h2, he, hp, ho, hn)
  show by defs(simp(hs, h2, he, mu, keep(gimple.mem, gimple.write_bytes)), gimple.stbf)
qed

// (in a world, at the machine's address of it)
theorem tr.stbf_at_ok: all w p off size pos k v a. w in abi.World -> w in univ(1) -> p in bits(64) -> off in bits(32) -> size in omega -> int_lt(size, 18446744073709551616) ->
  (a = int_add(p, off) || a = bits_add(64, p, off)) -> pos in omega -> k in omega -> v in omega -> g.mem_defined(w, p, off, size, true) ->
  runs(gimple.stbf(p, off, size, pos, k, v), w, ok(fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), a, size, int_add(bits_and(128, gimple.b128(gimple.bytes_at(app(w, "vm"), a, size)), bits_not(128, gimple.b128(int_mul(int_pow(2, pos), int_sub(int_pow(2, k), 1))))), int_mul(int_mod(v, int_pow(2, k)), int_pow(2, pos)))))), empty))
proof
  fix w p off size pos k v a
  assume hW hw hp ho hn hn2 ha hpo hk hv hd
  have a1 := mp(bits_and_in[n := 128, x := gimple.b128(gimple.bytes_at(app(w, "vm"), a, size)), y := bits_not(128, gimple.b128(int_mul(int_pow(2, pos), int_sub(int_pow(2, k), 1))))], simp())
  have a2: bits_and(128, gimple.b128(gimple.bytes_at(app(w, "vm"), a, size)), bits_not(128, gimple.b128(int_mul(int_pow(2, pos), int_sub(int_pow(2, k), 1))))) in omega by simp(a1)
  have kp: int_lt(0, int_pow(2, k)) by defs(mp(pow2_pos[k := k], hk), pow2)
  have pp: int_lt(0, int_pow(2, pos)) by defs(mp(pow2_pos[k := pos], hpo), pow2)
  have hvo: int_add(bits_and(128, gimple.b128(gimple.bytes_at(app(w, "vm"), a, size)), bits_not(128, gimple.b128(int_mul(int_pow(2, pos), int_sub(int_pow(2, k), 1))))), int_mul(int_mod(v, int_pow(2, k)), int_pow(2, pos))) in omega by arith(a2, kp, pp, hv)
  have wf := expand(hW, abi.World)
  have vV: app(w, "vm") in x86_64_linux.Vm by simp(wf)
  have fw: is_fun(w) by simp(wf)
  have dw: "vm" in dom(w) by simp(wf)
  have ev := apply(tr.bd_int, {p}, {off}, hp, ho, taut(hd))
  have ha2: a = int_add(p, off) by simp(rewrite(sym(ev), ha))
  have hvo2 := rewrite(ha2, hvo)
  have r := apply(g.stbf_at_ok, {w}, {p}, {off}, {size}, {pos}, {k}, {v}, hw, hp, ho, hn, hn2, hd, vV, fw, dw, hvo2)
  show := rewrite(sym(ha2), r)
qed

// (a word of 128 bits of x below 2^n, and-ed: below 2^n)
theorem tr.and_in: all n x y. n in omega -> int_le(n, 128) -> x in bits(n) -> bits_and(128, bits_of_int(128, x), y) in bits(n)
proof
  fix n x y
  assume hn hle hx
  have pl := mp(pow2_le[a := n, b := 128], hn, simp(), hle)
  have e: bits_of_int(128, x) = x by defs(arith(hx, pl, hn), bits_of_int)
  have nar := mp(bits_and_narrow[m := n, n := 128, x := x, y := y], hn, simp(), hle, hx)
  have i := mp(bits_and_in[n := n, x := x, y := y], hn)
  show := rewrite(sym(e), rewrite(sym(nar), i))
qed

// mov byte [b + d], r8 (b holding bv, g holding u: the spec's byte x, u's
// low byte, stored at bv + d)
theorem tr.store8_bd(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g b d z0 z1 bv n u x hs ds rs p p2 w w2.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(28, pair(z0, pair(z1, pair(x86i.bd_mem(b, d), tag(0, g)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> base in omega -> g in x86_64_linux.Reg -> int_lt(g, 4) -> b in x86_64_linux.Reg -> d in bits(32) ->
  b in dom(rs) -> app(rs, b) = pair(8, bv) -> bv in bits(64) -> g in dom(rs) -> app(rs, g) = pair(n, u) -> bits_slice(u, 7, 0) = x ->
  g.mem_defined(w, bv, d, 1, true) ->
  w2 = fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), bits_add(64, bv, d), 1, x))) ->
  tr.red(p, w, p2, w2) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, rs, p2, w2) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g b d z0 z1 bv n u x hs ds rs p p2 w w2
  assume hat ha2 hbase hg hg4 hb hd hbd hbu bb hgd hgu hx hdef hw2 hred hpt
  have dnz dlt dus := hdef
  let A := bits_add(64, bv, d)
  have ab: A in bits(64) by simp()
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "vm", fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), A, 1, x))), empty) proof
    fix m o
    assume hi hr hh hrs hmm ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rb b64 := apply(tr.regs_get, {m}, {rs}, {b}, {8}, {bv}, hrs, hbd, hbu)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {n}, {u}, hrs, hgd, hgu)
    have d64: d in bits(64) by simp(hd)
    have ea: x86i.bd_ea(m, b, d) = A by simp(rb, b64, d64)
    have ev := apply(tr.bd_int, {bv}, {d}, simp(b64), hd, dlt)
    have hus: gimple.usable(app(w, "vm"), app(w, "objs"), A, 1, true) := rewrite(ev, dus)
    have wa := apply(tr.store_acc, {s}, {m}, {w}, {v}, {A}, {1}, hmm, ab, simp(), simp(), hus)
    have wa2 := rewrite(sym(ea), wa)
    have hx2 := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    have e := apply(x86i.store8_bd, {m}, {o}, {g}, {b}, {d}, {z0}, {z1}, {len}, ipM, ipU, hg, hg4, hb, d64, wa2, hx2)
    show by simp(e, ea, rg, hx, hr, ha2)
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  have ev := apply(tr.bd_int, {bv}, {d}, bb, hd, dlt)
  have hus: gimple.usable(app(w, "vm"), app(w, "objs"), A, 1, true) := rewrite(ev, dus)
  show := apply(tr.store_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {A}, {1}, {x}, {hs}, {ds}, {rs}, {p}, {p2}, {w}, {w2}, he, hbase, a2b, ab, simp(), simp(), hus, hw2, hred, hpt)
qed

// mov word [b + d], r16 (b holding bv, g holding u: the spec's 2 bytes x,
// u's low word, stored at bv + d)
theorem tr.store16_bd(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g b d z1 z2 bv n u x hs ds rs p p2 w w2.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(75, pair(2, pair(g, pair(x86i.bd_mem(b, d), pair(z1, z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> base in omega -> g in x86_64_linux.Reg -> b in x86_64_linux.Reg -> d in bits(32) ->
  b in dom(rs) -> app(rs, b) = pair(8, bv) -> bv in bits(64) -> g in dom(rs) -> app(rs, g) = pair(n, u) -> bits_slice(u, 15, 0) = x ->
  g.mem_defined(w, bv, d, 2, true) ->
  w2 = fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), bits_add(64, bv, d), 2, x))) ->
  tr.red(p, w, p2, w2) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, rs, p2, w2) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g b d z1 z2 bv n u x hs ds rs p p2 w w2
  assume hat ha2 hbase hg hb hd hbd hbu bb hgd hgu hx hdef hw2 hred hpt
  have dnz dlt dus := hdef
  let A := bits_add(64, bv, d)
  have ab: A in bits(64) by simp()
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "vm", fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), A, 2, x))), empty) proof
    fix m o
    assume hi hr hh hrs hmm ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rb b64 := apply(tr.regs_get, {m}, {rs}, {b}, {8}, {bv}, hrs, hbd, hbu)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {n}, {u}, hrs, hgd, hgu)
    have d64: d in bits(64) by simp(hd)
    have ea: x86i.bd_ea(m, b, d) = A by simp(rb, b64, d64)
    have ev := apply(tr.bd_int, {bv}, {d}, simp(b64), hd, dlt)
    have hus: gimple.usable(app(w, "vm"), app(w, "objs"), A, 2, true) := rewrite(ev, dus)
    have wa := apply(tr.store_acc, {s}, {m}, {w}, {v}, {A}, {2}, hmm, ab, simp(), simp(), hus)
    have wa2 := rewrite(sym(ea), wa)
    have hx2 := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    have e := apply(x86i.store16_bd, {m}, {o}, {g}, {b}, {d}, {z1}, {z2}, {len}, ipM, ipU, hg, hb, d64, wa2, hx2)
    show by simp(e, ea, rg, hx, hr, ha2)
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  have ev := apply(tr.bd_int, {bv}, {d}, bb, hd, dlt)
  have hus: gimple.usable(app(w, "vm"), app(w, "objs"), A, 2, true) := rewrite(ev, dus)
  show := apply(tr.store_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {A}, {2}, {x}, {hs}, {ds}, {rs}, {p}, {p2}, {w}, {w2}, he, hbase, a2b, ab, simp(), simp(), hus, hw2, hred, hpt)
qed

// mov [b + d], r64 of a register u equal to the spec's word x (a merged
// bitfield's: the equation shown apart)
theorem tr.store64_bd_eq(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g b d z1 z2 bv u x hs ds rs p p2 w w2.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(75, pair(8, pair(g, pair(x86i.bd_mem(b, d), pair(z1, z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> base in omega -> g in x86_64_linux.Reg -> b in x86_64_linux.Reg -> d in bits(32) ->
  b in dom(rs) -> app(rs, b) = pair(8, bv) -> bv in bits(64) -> g in dom(rs) -> app(rs, g) = pair(8, u) -> u = x -> g.mem_defined(w, bv, d, 8, true) ->
  w2 = fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), bits_add(64, bv, d), 8, x))) ->
  tr.red(p, w, p2, w2) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, rs, p2, w2) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g b d z1 z2 bv u x hs ds rs p p2 w w2
  assume hat ha2 hbase hg hb hd hbd hbu hbv hgd hgu hux hdef hw2 hred hpt
  have hw := rewrite(sym(hux), hw2)
  show := apply(tr.store64_bd[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {len}, {g}, {b}, {d}, {z1}, {z2}, {bv}, {u}, {hs}, {ds}, {rs}, {p}, {p2}, {w}, {w2}, hat, ha2, hbase, hg, hb, hd, hbd, hbu, hbv, hgd, hgu, hdef, hw, hred, hpt)
qed

// mov qword [b + i], r64 (b holding bv, i holding iv, g holding u = x):
// the spec's 8-byte store of x at pp + off, the same address computed
// otherwise
theorem tr.store64_bi(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g b i z1 z2 bv iv u x pp off hs ds rs p p2 w w2.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(75, pair(8, pair(g, pair(x86i.bi_mem(b, i), pair(z1, z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> base in omega -> g in x86_64_linux.Reg -> b in x86_64_linux.Reg -> i in x86_64_linux.Reg ->
  b in dom(rs) -> app(rs, b) = pair(8, bv) -> i in dom(rs) -> app(rs, i) = pair(8, iv) -> g in dom(rs) -> app(rs, g) = pair(8, u) -> u = x ->
  pp in bits(64) -> off in bits(32) -> bits_add(64, bv, iv) = bits_add(64, pp, off) -> g.mem_defined(w, pp, off, 8, true) ->
  w2 = fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), bits_add(64, pp, off), 8, x))) ->
  tr.red(p, w, p2, w2) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, rs, p2, w2) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g b i z1 z2 bv iv u x pp off hs ds rs p p2 w w2
  assume hat ha2 hbase hg hb hi0 hbd hbu hid hiu hgd hgu hux hp ho hA hdef hw2 hred hpt
  have dnz dlt dus := hdef
  let A := bits_add(64, pp, off)
  have ab: A in bits(64) by simp()
  have ev := apply(tr.bd_int, {pp}, {off}, hp, ho, dlt)
  have hus: gimple.usable(app(w, "vm"), app(w, "objs"), A, 8, true) := rewrite(ev, dus)
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "vm", fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), A, 8, x))), empty) proof
    fix m o
    assume hi hr hh hrs hmm ho2
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rb .. := apply(tr.regs_get, {m}, {rs}, {b}, {8}, {bv}, hrs, hbd, hbu)
    have ri .. := apply(tr.regs_get, {m}, {rs}, {i}, {8}, {iv}, hrs, hid, hiu)
    have rg .. := apply(tr.regs_get, {m}, {rs}, {g}, {8}, {u}, hrs, hgd, hgu)
    have i64: iv in bits(64) by simp(apply(tr.regs_get, {m}, {rs}, {i}, {8}, {iv}, hrs, hid, hiu))
    have e0: bits_add(64, int_add(bv, bits_mul(64, iv, 1)), 0) = bits_add(64, bv, iv) by defs(arith(i64), bits_add, bits_mul)
    have ea: x86i.bi_ea(m, b, i) = A by simp(rb, ri, trans(e0, hA))
    have wa := apply(tr.store_acc, {s}, {m}, {w}, {v}, {A}, {8}, hmm, ab, simp(), simp(), hus)
    have wa2 := rewrite(sym(ea), wa)
    have hx := mp(all_elim(hat, {m}, {o}), ho2, ipC, hr)
    have e := apply(x86i.store64_bi, {m}, {o}, {g}, {b}, {i}, {z1}, {z2}, {len}, ipM, ipU, hg, hb, hi0, wa2, hx)
    show by simp(e, ea, rg, hux, hr, ha2)
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.store_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {A}, {8}, {x}, {hs}, {ds}, {rs}, {p}, {p2}, {w}, {w2}, he, hbase, a2b, ab, simp(), simp(), hus, hw2, hred, hpt)
qed

// or r64, r64 (g holding u, h holding x, of any widths: zero-extended)
theorem tr.or64_rr(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g h n1 u n2 x r hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(38, pair(8, pair(h, pair(tag(0, g), pair(tag(0, g), tag(0, h))))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> h in x86_64_linux.Reg -> g in dom(rs) -> app(rs, g) = pair(n1, u) -> h in dom(rs) -> app(rs, h) = pair(n2, x) ->
  r = bits_or(64, u, x) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs, g, pair(8, r)), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g h n1 u n2 x r hs ds rs p w
  assume hat ha2 hg hh hd hu hdh hx hr hpt0
  have hpt := rewrite(hr, hpt0)
  let R := bits_or(64, u, x)
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, R)), empty)) proof
    fix m o
    assume hi hr hh0 hrs ho
    have ip := apply(tr.inv_parts, hi)
    have ur _ := apply(tr.regs_get, {m}, {rs}, {g}, {n1}, {u}, hrs, hd, hu)
    have xr _ := apply(tr.regs_get, {m}, {rs}, {h}, {n2}, {x}, hrs, hdh, hx)
    have hx2 := mp(mp(mp(all_elim(hat, {m}, {o}), ho), taut(ip)), hr)
    obtain f, hf from apply(x86i.or64_rr, {m}, {o}, {g}, {h}, {len}, taut(ip), taut(ip), gR, hh, hx2)
    show by ex_intro({f}, simp(hf, ur, xr, hr, ha2, keep(x86i.flags_ok)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      R in bits(int_mul(8, 8)) && R in bits(64) proof
    fix m
    have i64 := mp(bits_or_in[n := 64, x := u, y := x], simp())
    show by simp(i64, keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {8}, {R}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// or r32, r32 (g holding u, h holding x; r the spec's order of u | x)
theorem tr.or32_rr(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g h u x r hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(38, pair(4, pair(h, pair(tag(0, g), pair(tag(0, g), tag(0, h))))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> h in x86_64_linux.Reg -> g in dom(rs) -> app(rs, g) = pair(4, u) -> h in dom(rs) -> app(rs, h) = pair(4, x) -> r = bits_or(32, u, x) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs, g, pair(4, r)), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g h u x r hs ds rs p w
  assume hat ha2 hg hh hd hu hdh hx hr0 hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, r)), empty)) proof
    fix m o
    assume hi hr hh0 hrs ho
    have ip := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {4}, {u}, hrs, hd, hu)
    have rh := apply(tr.regs_get, {m}, {rs}, {h}, {4}, {x}, hrs, hdh, hx)
    have xr x32 := rh
    have sl: bits_slice(x, 31, 0) = x by defs(simp(x32), bits_slice, bits_of_int)
    have hx2 := mp(mp(mp(all_elim(hat, {m}, {o}), ho), taut(ip)), hr)
    obtain f, hf from apply(x86i.or32_rr, {m}, {o}, {g}, {h}, {len}, taut(ip), taut(ip), gR, hh, hx2)
    show by ex_intro({f}, simp(hf, rg, xr, sl, hr0, hr, ha2, keep(x86i.flags_ok)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      r in bits(int_mul(8, 4)) && r in bits(64) proof
    fix m
    have i32 := mp(bits_and_in[n := 32, x := u, y := x], simp())
    show by simp(hr0, i32, keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {r}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// add dword [rsp + d], r32 (the home c holding u, g holding x)
theorem tr.add32_home_r(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len d c g x u r hs hs2 ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(35, pair(4, pair(g, pair(x86i.rsp_mem(d), pair(x86i.rsp_mem(d), tag(0, g))))))), m, o)) ->
  a2 = bits_add(64, a, len) -> base in omega -> d in bits(64) -> c = int_mod(int_sub(d, fr), 18446744073709551616) ->
  c in dom(hs) -> app(hs, c) = pair(4, u) ->
  g in x86_64_linux.Reg -> g in dom(rs) -> app(rs, g) = pair(4, x) -> r = bits_add(32, u, x) ->
  tr.hkeep(hs, hs2, c, 4) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, fn_update(hs2, c, pair(4, r)), ds, rs, p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len d c g x u r hs hs2 ds rs p w
  assume hat ha2 hbase hd hcd hdd hu hgR hgd hx hr0 hkp hpt
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
     (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "vm",
       fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), bits_add(64, int_add(app(app(s, "gpr"), 4), c), 0), 4, r))), empty)) proof
    fix m o
    assume hi hr hh hrs ho
    have ip := apply(tr.inv_parts, hi)
    have mM: m in x86_64_linux.Machine by taut(ip)
    have mu: m in univ(1) by taut(ip)
    have fe := apply(tr.frame_ea, {s}, {base}, {code}, {fr}, {m}, {w}, {d}, {c}, {0}, hi, hd, hcd, simp())
    have ac := apply(tr.home_acc, {s}, {base}, {code}, {fr}, {m}, {w}, {hs}, {d}, {c}, {4}, {u}, hi, hh, hd, hcd, hdd, hu)
    have hg := apply(tr.home_read, {s}, {base}, {code}, {fr}, {m}, {w}, {hs}, {d}, {c}, {4}, {u}, hi, hh, hd, hcd, hdd, hu)
    have rg x32 := apply(tr.regs_get, {m}, {rs}, {g}, {4}, {x}, hrs, hgd, hx)
    have sl: bits_slice(x, 31, 0) = x by defs(simp(x32), bits_slice, bits_of_int)
    have hx2 := mp(all_elim(hat, {m}, {o}), ho, taut(ip), hr)
    obtain f, hf from apply(x86i.add32_rsp_r, {m}, {o}, {g}, {d}, {len}, mM, mu, hgR, hd, taut(ac), taut(ac), hx2)
    show by ex_intro({f}, simp(hf, hg, fe, rg, sl, hr0, hr, ha2, keep(x86i.flags_ok)))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  have r32: r in bits(int_mul(8, 4)) by simp(hr0)
  show := apply(tr.hstore_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {c}, {4}, {u}, {r}, {hs}, {hs2}, {ds}, {rs}, {p}, {w}, he, hbase, a2b, hdd, hu, simp(), r32, hkp, hpt)
qed

// lea r64, [i * k] (i holding u)
theorem tr.lea64_is(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g i k z1 z2 z3 n u r hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(78, pair(8, pair(g, pair(z1, pair(z2, pair(z3, fn_update(fn_update(fn_update(fn_update(fn_update(empty, "seg", 0), "base", tag(0, empty)), "index", some(i)), "scale", k), "disp", 0)))))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> i in x86_64_linux.Reg -> k in bits(64) -> i in dom(rs) -> app(rs, i) = pair(n, u) ->
  r = bits_mul(64, u, k) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs, g, pair(8, r)), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g i k z1 z2 z3 n u r hs ds rs p w
  assume hat ha2 hg hi hk hd hu hr hpt0
  have hpt := rewrite(hr, hpt0)
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(app(m, "gpr"), g, bits_mul(64, u, k))), empty) proof
    fix m o
    assume hi2 hr hhs hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi2)
    have rg := apply(tr.regs_get, {m}, {rs}, {i}, {n}, {u}, hrs, hd, hu)
    have hx := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    have e := apply(x86i.lea64_is, {m}, {o}, {g}, {i}, {k}, {z1}, {z2}, {z3}, {len}, ipM, ipU, gR, hi, simp(hk), hx)
    have k0: bits_add(64, k, 0) = k by simp(hk)
    show by simp(e, rg, hr, ha2, k0)
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_mul(64, u, k) in bits(int_mul(8, 8)) && bits_mul(64, u, k) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {8}, {bits_mul(64, u, k)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed
