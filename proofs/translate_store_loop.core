  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(75, pair(4, pair(g, pair(x86i.bd_mem(b, 0), pair(z1, z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> base in omega -> g in x86_64_linux.Reg -> b in x86_64_linux.Reg ->
  b in dom(rs) -> app(rs, b) = pair(8, bv) -> bv in bits(64) -> g in dom(rs) -> app(rs, g) = pair(4, u) ->
  gimple.usable(app(w, "vm"), app(w, "objs"), bv, 4, true) ->
  w2 = fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), bv, 4, u))) ->
  tr.red(p, w, p2, w2) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, rs, p2, w2) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g b z1 z2 bv u hs ds rs p p2 w w2
  assume hat ha2 hbase hg hb hbd hbu bb hgd hgu hus hw2 hred hpt
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "vm", fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), bv, 4, u))), empty) proof
    fix m o
    assume hi hr hh hrs hmm ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rb := apply(tr.regs_get, {m}, {rs}, {b}, {8}, {bv}, hrs, hbd, hbu)
    have rg u32 := apply(tr.regs_get, {m}, {rs}, {g}, {4}, {u}, hrs, hgd, hgu)
    have tb := apply(x86i.reg_typed, ipM, hb)
    have ea: x86i.bd_ea(m, b, 0) = bv by simp(rb, tb)
    have sl: bits_slice(u, 31, 0) = u by defs(simp(u32), bits_slice, bits_of_int)
