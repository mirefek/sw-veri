// The translation's rules for stores (step_seq's, resetlock's): stores of
// n bytes both sides make (the world changing with the machine's memory),
// a write of the frame's slot (outside the world's domain), the 32-bit
// compare-and-branch on a slot. (Loops: on the readable CFG,
// proofs/translate_cfg.core.)
//
//   slc kernel-check <translate.core's chain> proofs/x86_insn.core build/leaf_steps.core \
//     ... proofs/translate.core proofs/translate_store_loop.core

// (n bytes stored at a: the memory at t, none of them, as before)
theorem tr.storen_other: all b a n x t. t in bits(64) ->
  (all j. j in omega -> int_lt(j, n) -> !(t = bits_add(64, a, bits_of_int(64, j)))) -> app(x86_64_linux.store_le(b, a, n, x), t) = app(b, t)
proof
  fix b a n x t
  assume ht hn
  have e1 := mp(app_fn_build[d := bits(64), v := y. ite(int_lt(bits_sub(64, y, a), n), bits_of_int(8, int_div(x, int_pow(256, bits_sub(64, y, a)))), app(b, y)), a := t], ht)
  have k: bits_sub(64, t, a) in omega by defs(simp(ht), bits_sub, pow2)
  have id := mp(x86.bits_add_sub_any[a := a, c := t], ht)
  have c: int_lt(bits_sub(64, t, a), n) -> false proof
    assume l
    have q := mp(all_elim(hn, {bits_sub(64, t, a)}), k, l)
    show by taut(q, sym(id))
  qed
  have nl: !int_lt(bits_sub(64, t, a), n) by taut(c)
  have f := mp(ite_f[c := int_lt(bits_sub(64, t, a), n), a := bits_of_int(8, int_div(x, int_pow(256, bits_sub(64, t, a)))), b := app(b, t)], nl)
  show by defs(taut(trans(e1, f)), x86_64_linux.store_le)
qed

// (the flags' arithmetic: u, k unsigned 32-bit, d their difference mod 2^32,
// x, y, z their signed readings)
theorem tr.jle_core: all u k d x y z. u in int -> k in int -> d in int -> x in int -> y in int -> z in int -> (int_le(0, u) && int_lt(u, 4294967296)) -> (int_le(0, k) && int_lt(k, 4294967296)) -> (int_le(0, d) && int_lt(d, 4294967296)) -> ((int_le(k, u) && d = int_sub(u, k)) || (int_lt(u, k) && d = int_add(int_sub(u, k), 4294967296))) -> ((int_lt(u, 2147483648) && x = u) || (!int_lt(u, 2147483648) && x = int_sub(u, 4294967296))) -> ((int_lt(k, 2147483648) && y = k) || (!int_lt(k, 2147483648) && y = int_sub(k, 4294967296))) -> ((int_lt(d, 2147483648) && z = d) || (!int_lt(d, 2147483648) && z = int_sub(d, 4294967296))) -> (((d = 0) || !(int_le(2147483648, d) <-> !(int_sub(x, y) = z))) <-> int_le(x, y))
proof
  fix u k d x y z
  assume iu ik id ix iy iz p0 p1 p2 p3 p4 p5 p6
  have r0: (int_le(k, u) && d = int_sub(u, k)) -> (int_lt(u, 2147483648) && x = u) -> (int_lt(k, 2147483648) && y = k) -> (int_lt(d, 2147483648) && z = d) -> (z = int_sub(x, y) || z = int_sub(int_sub(x, y), 4294967296) || z = int_add(int_sub(x, y), 4294967296)) proof
    assume y1 y2 y3 y4
    have q: z = int_sub(x, y) by arith(iu, ik, id, ix, iy, iz, p0, p1, p2, y1, y2, y3, y4)
    show by taut(q)
  qed
  have r1: (int_le(k, u) && d = int_sub(u, k)) -> (int_lt(u, 2147483648) && x = u) -> (int_lt(k, 2147483648) && y = k) -> (!int_lt(d, 2147483648) && z = int_sub(d, 4294967296)) -> (z = int_sub(x, y) || z = int_sub(int_sub(x, y), 4294967296) || z = int_add(int_sub(x, y), 4294967296)) proof
    assume y1 y2 y3 y4
    have q: z = int_sub(int_sub(x, y), 4294967296) by arith(iu, ik, id, ix, iy, iz, p0, p1, p2, y1, y2, y3, y4)
    show by taut(q)
  qed
  have r2: (int_le(k, u) && d = int_sub(u, k)) -> (int_lt(u, 2147483648) && x = u) -> (!int_lt(k, 2147483648) && y = int_sub(k, 4294967296)) -> (int_lt(d, 2147483648) && z = d) -> (z = int_sub(x, y) || z = int_sub(int_sub(x, y), 4294967296) || z = int_add(int_sub(x, y), 4294967296)) proof
    assume y1 y2 y3 y4
    have q: z = int_sub(int_sub(x, y), 4294967296) by arith(iu, ik, id, ix, iy, iz, p0, p1, p2, y1, y2, y3, y4)
    show by taut(q)
  qed
  have r3: (int_le(k, u) && d = int_sub(u, k)) -> (int_lt(u, 2147483648) && x = u) -> (!int_lt(k, 2147483648) && y = int_sub(k, 4294967296)) -> (!int_lt(d, 2147483648) && z = int_sub(d, 4294967296)) -> (z = int_sub(x, y) || z = int_sub(int_sub(x, y), 4294967296) || z = int_add(int_sub(x, y), 4294967296)) proof
    assume y1 y2 y3 y4
    have q: z = int_sub(x, y) by arith(iu, ik, id, ix, iy, iz, p0, p1, p2, y1, y2, y3, y4)
    show by taut(q)
  qed
  have r4: (int_le(k, u) && d = int_sub(u, k)) -> (!int_lt(u, 2147483648) && x = int_sub(u, 4294967296)) -> (int_lt(k, 2147483648) && y = k) -> (int_lt(d, 2147483648) && z = d) -> (z = int_sub(x, y) || z = int_sub(int_sub(x, y), 4294967296) || z = int_add(int_sub(x, y), 4294967296)) proof
    assume y1 y2 y3 y4
    have q: z = int_add(int_sub(x, y), 4294967296) by arith(iu, ik, id, ix, iy, iz, p0, p1, p2, y1, y2, y3, y4)
    show by taut(q)
  qed
  have r5: (int_le(k, u) && d = int_sub(u, k)) -> (!int_lt(u, 2147483648) && x = int_sub(u, 4294967296)) -> (int_lt(k, 2147483648) && y = k) -> (!int_lt(d, 2147483648) && z = int_sub(d, 4294967296)) -> (z = int_sub(x, y) || z = int_sub(int_sub(x, y), 4294967296) || z = int_add(int_sub(x, y), 4294967296)) proof
    assume y1 y2 y3 y4
    have q: z = int_sub(x, y) by arith(iu, ik, id, ix, iy, iz, p0, p1, p2, y1, y2, y3, y4)
    show by taut(q)
  qed
  have r6: (int_le(k, u) && d = int_sub(u, k)) -> (!int_lt(u, 2147483648) && x = int_sub(u, 4294967296)) -> (!int_lt(k, 2147483648) && y = int_sub(k, 4294967296)) -> (int_lt(d, 2147483648) && z = d) -> (z = int_sub(x, y) || z = int_sub(int_sub(x, y), 4294967296) || z = int_add(int_sub(x, y), 4294967296)) proof
    assume y1 y2 y3 y4
    have q: z = int_sub(x, y) by arith(iu, ik, id, ix, iy, iz, p0, p1, p2, y1, y2, y3, y4)
    show by taut(q)
  qed
  have r7: (int_le(k, u) && d = int_sub(u, k)) -> (!int_lt(u, 2147483648) && x = int_sub(u, 4294967296)) -> (!int_lt(k, 2147483648) && y = int_sub(k, 4294967296)) -> (!int_lt(d, 2147483648) && z = int_sub(d, 4294967296)) -> (z = int_sub(x, y) || z = int_sub(int_sub(x, y), 4294967296) || z = int_add(int_sub(x, y), 4294967296)) proof
    assume y1 y2 y3 y4
    have q: z = int_sub(int_sub(x, y), 4294967296) by arith(iu, ik, id, ix, iy, iz, p0, p1, p2, y1, y2, y3, y4)
    show by taut(q)
  qed
  have r8: (int_lt(u, k) && d = int_add(int_sub(u, k), 4294967296)) -> (int_lt(u, 2147483648) && x = u) -> (int_lt(k, 2147483648) && y = k) -> (int_lt(d, 2147483648) && z = d) -> (z = int_sub(x, y) || z = int_sub(int_sub(x, y), 4294967296) || z = int_add(int_sub(x, y), 4294967296)) proof
    assume y1 y2 y3 y4
    have q: z = int_add(int_sub(x, y), 4294967296) by arith(iu, ik, id, ix, iy, iz, p0, p1, p2, y1, y2, y3, y4)
    show by taut(q)
  qed
  have r9: (int_lt(u, k) && d = int_add(int_sub(u, k), 4294967296)) -> (int_lt(u, 2147483648) && x = u) -> (int_lt(k, 2147483648) && y = k) -> (!int_lt(d, 2147483648) && z = int_sub(d, 4294967296)) -> (z = int_sub(x, y) || z = int_sub(int_sub(x, y), 4294967296) || z = int_add(int_sub(x, y), 4294967296)) proof
    assume y1 y2 y3 y4
    have q: z = int_sub(x, y) by arith(iu, ik, id, ix, iy, iz, p0, p1, p2, y1, y2, y3, y4)
    show by taut(q)
  qed
  have r10: (int_lt(u, k) && d = int_add(int_sub(u, k), 4294967296)) -> (int_lt(u, 2147483648) && x = u) -> (!int_lt(k, 2147483648) && y = int_sub(k, 4294967296)) -> (int_lt(d, 2147483648) && z = d) -> (z = int_sub(x, y) || z = int_sub(int_sub(x, y), 4294967296) || z = int_add(int_sub(x, y), 4294967296)) proof
    assume y1 y2 y3 y4
    have q: z = int_sub(x, y) by arith(iu, ik, id, ix, iy, iz, p0, p1, p2, y1, y2, y3, y4)
    show by taut(q)
  qed
  have r11: (int_lt(u, k) && d = int_add(int_sub(u, k), 4294967296)) -> (int_lt(u, 2147483648) && x = u) -> (!int_lt(k, 2147483648) && y = int_sub(k, 4294967296)) -> (!int_lt(d, 2147483648) && z = int_sub(d, 4294967296)) -> (z = int_sub(x, y) || z = int_sub(int_sub(x, y), 4294967296) || z = int_add(int_sub(x, y), 4294967296)) proof
    assume y1 y2 y3 y4
    have q: z = int_sub(int_sub(x, y), 4294967296) by arith(iu, ik, id, ix, iy, iz, p0, p1, p2, y1, y2, y3, y4)
    show by taut(q)
  qed
  have r12: (int_lt(u, k) && d = int_add(int_sub(u, k), 4294967296)) -> (!int_lt(u, 2147483648) && x = int_sub(u, 4294967296)) -> (int_lt(k, 2147483648) && y = k) -> (int_lt(d, 2147483648) && z = d) -> (z = int_sub(x, y) || z = int_sub(int_sub(x, y), 4294967296) || z = int_add(int_sub(x, y), 4294967296)) proof
    assume y1 y2 y3 y4
    have q: z = int_sub(x, y) by arith(iu, ik, id, ix, iy, iz, p0, p1, p2, y1, y2, y3, y4)
    show by taut(q)
  qed
  have r13: (int_lt(u, k) && d = int_add(int_sub(u, k), 4294967296)) -> (!int_lt(u, 2147483648) && x = int_sub(u, 4294967296)) -> (int_lt(k, 2147483648) && y = k) -> (!int_lt(d, 2147483648) && z = int_sub(d, 4294967296)) -> (z = int_sub(x, y) || z = int_sub(int_sub(x, y), 4294967296) || z = int_add(int_sub(x, y), 4294967296)) proof
    assume y1 y2 y3 y4
    have q: z = int_add(int_sub(x, y), 4294967296) by arith(iu, ik, id, ix, iy, iz, p0, p1, p2, y1, y2, y3, y4)
    show by taut(q)
  qed
  have r14: (int_lt(u, k) && d = int_add(int_sub(u, k), 4294967296)) -> (!int_lt(u, 2147483648) && x = int_sub(u, 4294967296)) -> (!int_lt(k, 2147483648) && y = int_sub(k, 4294967296)) -> (int_lt(d, 2147483648) && z = d) -> (z = int_sub(x, y) || z = int_sub(int_sub(x, y), 4294967296) || z = int_add(int_sub(x, y), 4294967296)) proof
    assume y1 y2 y3 y4
    have q: z = int_add(int_sub(x, y), 4294967296) by arith(iu, ik, id, ix, iy, iz, p0, p1, p2, y1, y2, y3, y4)
    show by taut(q)
  qed
  have r15: (int_lt(u, k) && d = int_add(int_sub(u, k), 4294967296)) -> (!int_lt(u, 2147483648) && x = int_sub(u, 4294967296)) -> (!int_lt(k, 2147483648) && y = int_sub(k, 4294967296)) -> (!int_lt(d, 2147483648) && z = int_sub(d, 4294967296)) -> (z = int_sub(x, y) || z = int_sub(int_sub(x, y), 4294967296) || z = int_add(int_sub(x, y), 4294967296)) proof
    assume y1 y2 y3 y4
    have q: z = int_sub(x, y) by arith(iu, ik, id, ix, iy, iz, p0, p1, p2, y1, y2, y3, y4)
    show by taut(q)
  qed
  have rel: z = int_sub(x, y) || z = int_sub(int_sub(x, y), 4294967296) || z = int_add(int_sub(x, y), 4294967296) by taut(p3, p4, p5, p6, r0, r1, r2, r3, r4, r5, r6, r7, r8, r9, r10, r11, r12, r13, r14, r15)
  have xr: int_le(int_neg(2147483648), x) && int_lt(x, 2147483648) by arith(iu, ik, id, ix, iy, iz, p0, p4)
  have yr: int_le(int_neg(2147483648), y) && int_lt(y, 2147483648) by arith(iu, ik, id, ix, iy, iz, p1, p5)
  have zr: int_le(int_neg(2147483648), z) && int_lt(z, 2147483648) by arith(iu, ik, id, ix, iy, iz, p2, p6)
  have zero: (d = 0) <-> (z = 0) by arith(iu, ik, id, ix, iy, iz, p2, p6)
  have neg: int_le(2147483648, d) <-> int_lt(z, 0) by arith(iu, ik, id, ix, iy, iz, p2, p6)
  have g0: (z = int_sub(x, y)) -> (((z = 0) || !(int_lt(z, 0) <-> !(int_sub(x, y) = z))) <-> int_le(x, y)) proof
    assume e
    show by arith(iu, ik, id, ix, iy, iz, xr, yr, zr, e)
  qed
  have g1: (z = int_sub(int_sub(x, y), 4294967296)) -> (((z = 0) || !(int_lt(z, 0) <-> !(int_sub(x, y) = z))) <-> int_le(x, y)) proof
    assume e
    show by arith(iu, ik, id, ix, iy, iz, xr, yr, zr, e)
  qed
  have g2: (z = int_add(int_sub(x, y), 4294967296)) -> (((z = 0) || !(int_lt(z, 0) <-> !(int_sub(x, y) = z))) <-> int_le(x, y)) proof
    assume e
    show by arith(iu, ik, id, ix, iy, iz, xr, yr, zr, e)
  qed
  have gg: ((z = 0) || !(int_lt(z, 0) <-> !(int_sub(x, y) = z))) <-> int_le(x, y) by taut(rel, g0, g1, g2)
  show by taut(gg, zero, neg)
qed

// (cmp u, kk: zf or sf != of exactly when u <= kk, signed)
theorem tr.jle_flags: all u kk. u in bits(32) -> kk in bits(32) ->
  (((bits_sub(32, u, kk) = 0) || !(bit(bits_sub(32, u, kk), 31) <-> !(int_sub(sint(32, u), sint(32, kk)) = sint(32, bits_sub(32, u, kk))))) <-> int_le(sint(32, u), sint(32, kk)))
proof
  fix u kk
  assume hu hk
  let D := bits_sub(32, u, kk)
  have ub: int_le(0, u) && int_lt(u, 4294967296) by simp(hu)
  have kb: int_le(0, kk) && int_lt(kk, 4294967296) by simp(hk)
  have hD: D = int_mod(int_sub(u, kk), 4294967296) by defs(simp(), bits_sub, pow2)
  have db: int_le(0, D) && int_lt(D, 4294967296) by simp()
  have su: (int_lt(u, 2147483648) && sint(32, u) = u) || (!int_lt(u, 2147483648) && sint(32, u) = int_sub(u, 4294967296)) by defs(simp(hu), sint, letin, pow2)
  have sk: (int_lt(kk, 2147483648) && sint(32, kk) = kk) || (!int_lt(kk, 2147483648) && sint(32, kk) = int_sub(kk, 4294967296)) by defs(simp(hk), sint, letin, pow2)
  have sd: (int_lt(D, 2147483648) && sint(32, D) = D) || (!int_lt(D, 2147483648) && sint(32, D) = int_sub(D, 4294967296)) by defs(simp(db), sint, letin, pow2)
  have bd0: (int_mod(int_div(D, 2147483648), 2) = 1) <-> int_le(2147483648, D) by arith(db)
  have bd: bit(D, 31) <-> int_le(2147483648, D) by defs(simp(bd0), bit, pow2)
  have iu: u in int by simp(hu)
  have ik: kk in int by simp(hk)
  have idd: D in int by simp()
  have ix: sint(32, u) in int proof
    have c1: (int_lt(u, 2147483648) && sint(32, u) = u) -> sint(32, u) in int proof
      assume h
      have e: sint(32, u) = u by taut(h)
      show := rewrite(sym(e), iu)
    qed
    have c2: (!int_lt(u, 2147483648) && sint(32, u) = int_sub(u, 4294967296)) -> sint(32, u) in int proof
      assume h
      have e: sint(32, u) = int_sub(u, 4294967296) by taut(h)
      have t: int_sub(u, 4294967296) in int by arith(iu)
      show := rewrite(sym(e), t)
    qed
    show by taut(su, c1, c2)
  qed
  have iy: sint(32, kk) in int proof
    have c1: (int_lt(kk, 2147483648) && sint(32, kk) = kk) -> sint(32, kk) in int proof
      assume h
      have e: sint(32, kk) = kk by taut(h)
      show := rewrite(sym(e), ik)
    qed
    have c2: (!int_lt(kk, 2147483648) && sint(32, kk) = int_sub(kk, 4294967296)) -> sint(32, kk) in int proof
      assume h
      have e: sint(32, kk) = int_sub(kk, 4294967296) by taut(h)
      have t: int_sub(kk, 4294967296) in int by arith(ik)
      show := rewrite(sym(e), t)
    qed
    show by taut(sk, c1, c2)
  qed
  have iz: sint(32, D) in int proof
    have c1: (int_lt(D, 2147483648) && sint(32, D) = D) -> sint(32, D) in int proof
      assume h
      have e: sint(32, D) = D by taut(h)
      show := rewrite(sym(e), idd)
    qed
    have c2: (!int_lt(D, 2147483648) && sint(32, D) = int_sub(D, 4294967296)) -> sint(32, D) in int proof
      assume h
      have e: sint(32, D) = int_sub(D, 4294967296) by taut(h)
      have t: int_sub(D, 4294967296) in int by arith(idd)
      show := rewrite(sym(e), t)
    qed
    show by taut(sd, c1, c2)
  qed
  have hDc: (int_le(kk, u) && D = int_sub(u, kk)) || (int_lt(u, kk) && D = int_add(int_sub(u, kk), 4294967296)) by arith(iu, ik, idd, ub, kb, hD)
  have c := apply(tr.jle_core, {u}, {kk}, {D}, {sint(32, u)}, {sint(32, kk)}, {sint(32, D)}, iu, ik, idd, ix, iy, iz, ub, kb, db, hDc, su, sk, sd)
  have g: ((D = 0) || !(bit(D, 31) <-> !(int_sub(sint(32, u), sint(32, kk)) = sint(32, D)))) <-> int_le(sint(32, u), sint(32, kk)) by taut(c, bd)
  show := g
qed

// (two props equal: as an iff)
theorem tr.prop_eq: all a b. (a = false || a = true) -> (b = false || b = true) -> ((a = b) <-> (a <-> b))
proof
  fix a b
  assume ha hb
  have ta := mp(tr.prop_true, {a}, ha)
  have tb := mp(tr.prop_true, {b}, hb)
  have d1: false = true -> false proof
    assume e1
    have t1: true by simp()
    show := subst({y. y}, sym(e1), t1)
  qed
  have dir1: a = b -> (a <-> b) proof
    assume e
    have r: a <-> a by taut()
    show := subst({y. a <-> y}, e, r)
  qed
  have dir2: (a <-> b) -> a = b proof
    assume i
    have c1: a = false -> b = false -> a = b proof
      assume ea eb
      show := trans(ea, sym(eb))
    qed
    have c2: a = true -> b = true -> a = b proof
      assume ea eb
      show := trans(ea, sym(eb))
    qed
    have c3: a = false -> b = true -> a = b proof
      assume ea eb
      have bb: b by taut(tb, eb)
      have at: a = true by taut(ta, i, bb)
      have ft := rewrite(ea, at)
      show by taut(d1, ft)
    qed
    have c4: a = true -> b = false -> a = b proof
      assume ea eb
      have aa: a by taut(ta, ea)
      have bt: b = true by taut(tb, i, aa)
      have ft := rewrite(eb, bt)
      show by taut(d1, ft)
    qed
    show by taut(ha, hb, c1, c2, c3, c4)
  qed
  show by taut(dir1, dir2)
qed

// (a 32-bit value read signed: an integer)
theorem tr.sint32_int: all x. x in bits(32) -> sint(32, x) in int
proof
  fix x
  assume hx
  have xi: x in int by simp(hx)
  have sx: (int_lt(x, 2147483648) && sint(32, x) = x) || (!int_lt(x, 2147483648) && sint(32, x) = int_sub(x, 4294967296)) by defs(simp(hx), sint, letin, pow2)
  have c1: (int_lt(x, 2147483648) && sint(32, x) = x) -> sint(32, x) in int proof
    assume h
    have e: sint(32, x) = x by taut(h)
    show := rewrite(sym(e), xi)
  qed
  have c2: (!int_lt(x, 2147483648) && sint(32, x) = int_sub(x, 4294967296)) -> sint(32, x) in int proof
    assume h
    have e: sint(32, x) = int_sub(x, 4294967296) by taut(h)
    have t: int_sub(x, 4294967296) in int by arith(xi)
    show := rewrite(sym(e), t)
  qed
  show by taut(sx, c1, c2)
qed


// ----------------------------------------------------------------------
//  GIMPLE: a byte store, a byte load, at p + off

theorem g.write1_ok: all s a v. s in univ(1) -> a in bits(64) -> v in omega -> app(s, "vm") in x86_64_linux.Vm -> is_fun(s) -> "vm" in dom(s) ->
  runs(gimple.write_bytes(a, 1, v), s, ok(fn_update(s, "vm", fn_update(app(s, "vm"), "bytes", x86_64_linux.store_le(app(app(s, "vm"), "bytes"), a, 1, v))), empty))
proof
  fix s a v
  assume hs ha hv hvm hf hd
  have bf: is_fun(app(app(s, "vm"), "bytes")) && dom(app(app(s, "vm"), "bytes")) = bits(64) by simp(hvm)
  have z := apply(x86.store_zero, {app(app(s, "vm"), "bytes")}, {a}, {v}, taut(bf), taut(bf), ha)
  have s1: fn_update(app(app(s, "vm"), "bytes"), a, bits_of_int(8, v)) = x86_64_linux.store_le(app(app(s, "vm"), "bytes"), a, 1, v)
    by simp(ha, hv, rewrite(z, apply(x86.store_step, {app(app(s, "vm"), "bytes")}, {a}, {0}, {v}, ha, simp(), simp())))
  show by defs(simp(hs, ha, hv, hvm, hf, hd, sym(s1), unroll), gimple.write_bytes)
qed
// ----------------------------------------------------------------------
//  GIMPLE's write of n bytes (any n): the loop's run, by its invariant (the
//  first i bytes written) and variant (n - i) -- the bytes stored
//  little-endian

theorem g.write_ok: all s a n v. s in univ(1) -> a in bits(64) -> n in omega -> int_lt(n, 18446744073709551616) -> v in omega ->
  app(s, "vm") in x86_64_linux.Vm -> is_fun(s) -> "vm" in dom(s) ->
  runs(gimple.write_bytes(a, n, v), s, ok(fn_update(s, "vm", fn_update(app(s, "vm"), "bytes", x86_64_linux.store_le(app(app(s, "vm"), "bytes"), a, n, v))), empty))
proof
  fix s a n v
  assume hs ha hn hn64 hv hvm hf hd
  let B := app(app(s, "vm"), "bytes")
  let ST(i) := fn_update(s, "vm", fn_update(app(s, "vm"), "bytes", x86_64_linux.store_le(B, a, i, v)))
  let P(l) := ex i. i in omega && int_le(i, n) && l = pair(ST(i), i)
  let M(l) := int_sub(n, snd(l))
  let G(l, r) := r = exc(pair(fst(l), snd(l)), pair("brk", empty))
  let BODY(l, o) := (int_lt(snd(l), n) && letin(snd(l), x6. letin(fn_update(fst(l), "vm", fn_update(app(fst(l), "vm"), "bytes",
      fn_update(app(app(fst(l), "vm"), "bytes"), bits_add(64, a, bits_of_int(64, x6)), bits_of_int(8, int_div(v, int_pow(256, x6)))))), x7. o = ok(pair(x7, int_add(snd(l), 1)), empty)))) ||
    (!int_lt(snd(l), n) && o = exc(pair(fst(l), snd(l)), pair("brk", empty)))
  have bf: is_fun(B) && dom(B) = bits(64) by simp(hvm)
  have vf: is_fun(app(s, "vm")) && "bytes" in dom(app(s, "vm")) by simp(hvm)
  // the start: no byte written
  have z := apply(x86.store_zero, {B}, {a}, {v}, taut(bf), taut(bf), ha)
  have e0v := mp(fn_update_same[f := app(s, "vm"), k := "bytes"], taut(vf), taut(vf))
  have e0s := mp(fn_update_same[f := s, k := "vm"], hf, hd)
  have s0: ST(0) = s by simp(z, e0v, e0s)
  have p0: P(pair(s, 0)) by ex_intro({0}, simp(hn, s0))
  have pm: all l. P(l) -> M(l) in omega proof
    fix l
    assume hp
    obtain i, hi from hp
    show by simp(hi, hn)
  qed
  // a step: the next byte written, or (all written) the loop's break
  have pb: all l. P(l) -> true -> (ex l2. BODY(l, ok(l2, empty)) && P(l2) && int_lt(M(l2), M(l))) || (ex r. BODY(l, r) && G(l, r) && !is_ok(r) && !(fst(r) = 2)) proof
    fix l
    assume hp ht
    obtain i, io il le from hp
    have more: int_lt(i, n) -> (ex l2. BODY(l, ok(l2, empty)) && P(l2) && int_lt(M(l2), M(l))) proof
      assume hl
      have i64: int_lt(i, 18446744073709551616) by arith(hl, hn64)
      have sst := apply(x86.store_step, {B}, {a}, {i}, {v}, ha, io, i64)
      have tw1 := fn_update_twice[f := app(s, "vm"), k := "bytes", a := x86_64_linux.store_le(B, a, i, v), b := x86_64_linux.store_le(B, a, int_add(i, 1), v)]
      have tw2 := fn_update_twice[f := s, k := "vm", a := fn_update(app(s, "vm"), "bytes", x86_64_linux.store_le(B, a, i, v)), b := fn_update(app(s, "vm"), "bytes", x86_64_linux.store_le(B, a, int_add(i, 1), v))]
      have bd: BODY(l, ok(pair(ST(int_add(i, 1)), int_add(i, 1)), empty)) by defs(simp(le, hl, sst, tw1, tw2), letin)
      have p2: P(pair(ST(int_add(i, 1)), int_add(i, 1))) by ex_intro({int_add(i, 1)}, simp(io, hl))
      have m2: int_lt(M(pair(ST(int_add(i, 1)), int_add(i, 1))), M(l)) by simp(le, io)
      show by ex_intro({pair(ST(int_add(i, 1)), int_add(i, 1))}, taut(bd, p2, m2))
    qed
    have done: !int_lt(i, n) -> (ex r. BODY(l, r) && G(l, r) && !is_ok(r) && !(fst(r) = 2)) proof
      assume hl
      let R := exc(pair(fst(l), snd(l)), pair("brk", empty))
      have bd: BODY(l, R) by simp(le, hl)
      have g: G(l, R) by simp()
      have no: !is_ok(R) by defs(simp(), is_ok)
      have nd: !(fst(R) = 2) by simp()
      show by ex_intro({R}, taut(bd, g, no, nd))
    qed
    have cs: int_lt(i, n) || !int_lt(i, n) by taut()
    show by taut(cs, more, done)
  qed
  have ex := mp(while_exists[l0 := pair(s, 0), c := l. true, b := l o. BODY(l, o), tr := l. fn_update(empty, "os.events", app(app(fst(l), "os"), "events")), p := l. P(l), m := l. M(l),
    g := l r. G(l, r)], p0, pm, pb)
  obtain r, hw hnd hcase from ex
  // (the loop left by its break, all n bytes written)
  have nst: (ex l. P(l) && !true && r = ok(l, empty)) -> false proof
    assume h
    obtain l0, hl0 from h
    show by taut(hl0)
  qed
  have lft: ex l. P(l) && true && BODY(l, r) && G(l, r) && !is_ok(r) by taut(hcase, nst)
  obtain l, hpl _ hbl hgl hno from lft
  obtain i, io il le from hpl
  have ni: !int_lt(i, n) proof
    have c: int_lt(i, n) -> false proof
      assume hl
      have b1: ex x7. r = ok(pair(x7, int_add(i, 1)), empty) proof
        have bb := rewrite(le, hbl)
        have bb2: letin(i, x6. letin(fn_update(ST(i), "vm", fn_update(app(ST(i), "vm"), "bytes",
            fn_update(app(app(ST(i), "vm"), "bytes"), bits_add(64, a, bits_of_int(64, x6)), bits_of_int(8, int_div(v, int_pow(256, x6)))))), x7. r = ok(pair(x7, int_add(i, 1)), empty))) by simp(bb, hl)
        show by ex_intro({fn_update(ST(i), "vm", fn_update(app(ST(i), "vm"), "bytes", fn_update(app(app(ST(i), "vm"), "bytes"), bits_add(64, a, bits_of_int(64, i)), bits_of_int(8, int_div(v, int_pow(256, i))))))},
          defs(bb2, letin))
      qed
      obtain x7, hx7 from b1
      have ok7: is_ok(r) by defs(ex_intro({pair(x7, int_add(i, 1))}, {empty}, hx7), is_ok)
      show by taut(ok7, hno)
    qed
    show by taut(c)
  qed
  have ien: i = n by arith(il, ni, io, hn)
  have re: r = exc(pair(ST(n), n), pair("brk", empty)) by simp(hgl, le, ien)
  have hw2 := rewrite(re, hw)
  // the procedure: its loop, then ok
  have stu := apply(fn_space_univ, bits_univ[n := 64], bits_univ[n := 8], apply(x86.store_typed, {B}, {a}, {n}, {v}, simp(hvm)))
  have pu: pair(s, ok(ST(n), empty)) in univ(1) by simp(hs, stu)
  have rel: letin(0, x2. ex x3. while_rel(pair(s, x2), x4. true, x4 x5. BODY(x4, x5), x4. fn_update(empty, "os.events", app(app(fst(x4), "os"), "events")), x3) &&
      (((fst(x3) = 0 || (fst(x3) = 1 && fst(out_value(x3)) = "brk")) && ok(ST(n), empty) = ok(fst(out_state(x3)), empty)) ||
       ((((fst(x3) = 1 && fst(out_value(x3)) = "ret") && ok(ST(n), empty) = ok(fst(out_state(x3)), snd(out_value(x3)))) ||
         ((fst(x3) = 1 && fst(out_value(x3)) = "raise") && ok(ST(n), empty) = exc(fst(out_state(x3)), snd(out_value(x3))))) ||
        (fst(x3) = 2 && ok(ST(n), empty) = diverge(snd(x3)))))) by defs(ex_intro({exc(pair(ST(n), n), pair("brk", empty))}, simp(hw2, keep(while_rel))), letin, out_state, out_value)
  show by defs(apply(tr.runs_intro, {s}, {ok(ST(n), empty)}, pu, rel), gimple.write_bytes)
qed


theorem g.st8_at_ok: all s p off v. s in univ(1) -> p in bits(64) -> off in bits(32) -> v in bits(8) -> g.mem_defined(s, p, off, 1, true) ->
  app(s, "vm") in x86_64_linux.Vm -> is_fun(s) -> "vm" in dom(s) ->
  runs(gimple.st8(p, off, v), s, ok(fn_update(s, "vm", fn_update(app(s, "vm"), "bytes", x86_64_linux.store_le(app(app(s, "vm"), "bytes"), int_add(p, off), 1, v))), empty))
proof
  fix s p off v
  assume hs hp ho hv hdf hvm hf hd
  have m := apply(g.mem_at_ok, {s}, {p}, {off}, {1}, {true}, hs, hp, ho, hdf)
  have ab: int_add(p, off) in bits(64) by simp(hdf, hp, ho)
  have w := apply(g.write1_ok, {s}, {int_add(p, off)}, {v}, hs, ab, simp(hv), hvm, hf, hd)
  have stu := apply(fn_space_univ, bits_univ[n := 64], bits_univ[n := 8], apply(x86.store_typed, {app(app(s, "vm"), "bytes")}, {int_add(p, off)}, {1}, {v}, simp(hvm)))
  show by defs(simp(hs, m, w, stu, keep(gimple.mem, gimple.write_bytes)), gimple.st8)
qed

theorem g.st8_at_ub: all s p off v s2 e. s in univ(1) -> s2 in univ(1) -> e in univ(1) -> p in bits(64) -> off in bits(32) -> !g.mem_defined(s, p, off, 1, true) ->
  runs(gimple.st8(p, off, v), s, exc(s2, e))
proof
  fix s p off v s2 e
  assume hs h2 he hp ho hn
  have mu := apply(g.mem_at_ub, {s}, {p}, {off}, {1}, {true}, {s2}, {e}, hs, h2, he, hp, ho, hn)
  show by defs(simp(hs, h2, he, mu, keep(gimple.mem, gimple.write_bytes)), gimple.st8)
qed

theorem g.ld8_at_ok: all s p off. s in univ(1) -> p in bits(64) -> off in bits(32) -> g.mem_defined(s, p, off, 1, false) ->
  runs(gimple.ld8(p, off), s, ok(s, bits_of_int(8, gimple.bytes_at(app(s, "vm"), int_add(p, off), 1))))
proof
  fix s p off
  assume hs hp ho hdf
  have m := apply(g.mem_at_ok, {s}, {p}, {off}, {1}, {false}, hs, hp, ho, hdf)
  show by defs(simp(hs, m, keep(gimple.mem, gimple.bytes_at)), gimple.ld8)
qed

theorem g.ld8_at_ub: all s p off s2 e. s in univ(1) -> s2 in univ(1) -> e in univ(1) -> p in bits(64) -> off in bits(32) -> !g.mem_defined(s, p, off, 1, false) ->
  runs(gimple.ld8(p, off), s, exc(s2, e))
proof
  fix s p off s2 e
  assume hs h2 he hp ho hn
  have mu := apply(g.mem_at_ub, {s}, {p}, {off}, {1}, {false}, {s2}, {e}, hs, h2, he, hp, ho, hn)
  show by defs(simp(hs, h2, he, mu, keep(gimple.mem)), gimple.ld8)
qed

// ----------------------------------------------------------------------
//  Stores: the same bytes stored on both sides keep the memory's coupling

// (two memories agreeing at z: so after the same store)
theorem tr.store_le_agree: all b1 b2 a n x z. z in bits(64) -> app(b1, z) = app(b2, z) ->
  app(x86_64_linux.store_le(b1, a, n, x), z) = app(x86_64_linux.store_le(b2, a, n, x), z)
proof
  fix b1 b2 a n x z
  assume hz he
  have e1 := mp(app_fn_build[d := bits(64), v := y. ite(int_lt(bits_sub(64, y, a), n), bits_of_int(8, int_div(x, int_pow(256, bits_sub(64, y, a)))), app(b1, y)), a := z], hz)
  have e2 := mp(app_fn_build[d := bits(64), v := y. ite(int_lt(bits_sub(64, y, a), n), bits_of_int(8, int_div(x, int_pow(256, bits_sub(64, y, a)))), app(b2, y)), a := z], hz)
  have r := rewrite(he, e1)
  show by defs(taut(trans(r, sym(e2))), x86_64_linux.store_le)
qed

// (a usable byte: within the address space, in the domain)
theorem tr.usable_dom: all vm objs a n wr i. gimple.usable(vm, objs, a, n, wr) -> int_le(0, a) -> i in omega -> int_lt(i, n) ->
  int_lt(int_add(a, i), 18446744073709551616) && abi.in_domain(vm, objs, int_add(a, i))
proof
  fix vm objs a n wr i
  assume hu ha hi hn
  let X := int_add(a, i)
  let P := int_div(X, x86_64_linux.PAGE)
  let C := x86_64_linux.mapped(vm, P) && !(app(snd(app(app(vm, "pages"), P)), "kind") = 2)
  let IW := ite(wr, app(app(snd(app(app(vm, "pages"), P)), "prot"), "w"), app(app(snd(app(app(vm, "pages"), P)), "prot"), "r"))
  have ui := mp(all_elim(expand(hu, gimple.usable), {i}), hi, hn)
  have c1: C -> int_lt(X, 18446744073709551616) && abi.in_domain(vm, objs, X) proof
    assume hc
    have mc := expand(hc, x86_64_linux.mapped)
    have hlt: int_lt(X, 18446744073709551616) by simp(expand(mc, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE), ha, hi)
    have dm: abi.in_domain(vm, objs, X) by defs(taut(hc), abi.in_domain)
    show by taut(hlt, dm)
  qed
  have c2: !C -> int_lt(X, 18446744073709551616) && abi.in_domain(vm, objs, X) proof
    assume hc
    have ho0 := rewrite(mp(ite_f[c := C, a := IW, b := int_lt(X, int_pow(2, 64)) && X in objs], hc), ui)
    have hlt: int_lt(X, 18446744073709551616) by simp(ho0)
    have dm: abi.in_domain(vm, objs, X) by defs(taut(ho0), abi.in_domain)
    show by taut(hlt, dm)
  qed
  show by taut(c1, c2)
qed

// (the j-th byte of an access at a usable for n bytes: a + j)
theorem tr.usable_ea: all vm objs a n wr j. gimple.usable(vm, objs, a, n, wr) -> a in bits(64) -> j in omega -> int_lt(j, n) ->
  bits_add(64, a, bits_of_int(64, j)) = int_add(a, j)
proof
  fix vm objs a n wr j
  assume hu ha j1 j2
  have a0: int_le(0, a) by simp(ha)
  have ud := apply(tr.usable_dom, {vm}, {objs}, {a}, {n}, {wr}, {j}, hu, a0, j1, j2)
  have l: int_lt(int_add(a, j), 18446744073709551616) by taut(ud)
  have p64: pow2(64) = 18446744073709551616 by simp()
  have e0: int_mod(int_add(a, int_mod(j, 18446744073709551616)), 18446744073709551616) = int_add(a, j) by arith(a0, j1, j2, l)
  show by defs(rewrite(sym(p64), e0), bits_add, bits_of_int)
qed

// a store both sides make, of bytes usable in the world: the coupling kept
theorem tr.mem_store: all s m m2 w w2 ds a n x. tr.mem(s, m, w, ds) -> a in bits(64) -> gimple.usable(app(w, "vm"), app(w, "objs"), a, n, true) ->
  app(m2, "vm") = fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), a, n, x)) ->
  app(w2, "vm") = fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), a, n, x)) -> app(w2, "objs") = app(w, "objs") ->
  tr.mem(s, m2, w2, ds)
proof
  fix s m m2 w w2 ds a n x
  assume h ha hus em ew eo
  have {wob, wm, oacc} := h
  have {top, limit, brk0, brk, bytes, frames, pages, nostk, stk, rsv} := wm
  have a0: int_le(0, a) by simp(ha)
  // the stored bytes: in the domain
  have dm: all j. j in omega -> int_lt(j, n) -> abi.in_domain(app(w, "vm"), ds, bits_add(64, a, bits_of_int(64, j))) proof
    fix j
    assume j1 j2
    have ud := apply(tr.usable_dom, {app(w, "vm")}, {app(w, "objs")}, {a}, {n}, {true}, {j}, hus, a0, j1, j2)
    have e := apply(tr.usable_ea, {app(w, "vm")}, {app(w, "objs")}, {a}, {n}, {true}, {j}, hus, ha, j1, j2)
    have d1: abi.in_domain(app(w, "vm"), app(w, "objs"), int_add(a, j)) by taut(ud)
    show := rewrite(sym(e), rewrite(wob, d1))
  qed
  // (the world's domain: as before the store)
  have dq: all c. abi.in_domain(app(w2, "vm"), ds, c) = abi.in_domain(app(w, "vm"), ds, c) proof
    fix c
    show by defs(simp(ew), abi.in_domain, x86_64_linux.mapped)
  qed
  have by2: all c. c in bits(64) -> abi.in_domain(app(w2, "vm"), ds, c) -> app(app(app(m2, "vm"), "bytes"), c) = app(app(app(w2, "vm"), "bytes"), c) proof
    fix c
    assume hc hd
    have hd2 := rewrite(all_elim(dq, {c}), hd)
    have e := mp(all_elim(bytes, {c}), hc, hd2)
    have sa := apply(tr.store_le_agree, {app(app(m, "vm"), "bytes")}, {app(app(w, "vm"), "bytes")}, {a}, {n}, {x}, {c}, hc, e)
    show by simp(em, ew, sa)
  qed
  have fr2: all c. c in bits(64) -> (int_le(abi.sp(s), c) && !abi.in_domain(app(w2, "vm"), ds, c)) && abi.stack_page(app(s, "vm"), x86_64_linux.page_of(c)) ->
      app(app(app(m2, "vm"), "bytes"), c) = app(app(app(s, "vm"), "bytes"), c) proof
    fix c
    assume hc hf
    have nd2: !abi.in_domain(app(w2, "vm"), ds, c) by taut(hf)
    have nd: !abi.in_domain(app(w, "vm"), ds, c) := rewrite(all_elim(dq, {c}), nd2)
    have hf2: (int_le(abi.sp(s), c) && !abi.in_domain(app(w, "vm"), ds, c)) && abi.stack_page(app(s, "vm"), x86_64_linux.page_of(c)) by taut(hf, nd)
    have e := mp(all_elim(frames, {c}), hc, hf2)
    have ne: all j. j in omega -> int_lt(j, n) -> !(c = bits_add(64, a, bits_of_int(64, j))) proof
      fix j
      assume j1 j2
      have dj := mp(all_elim(dm, {j}), j1, j2)
      have c0: c = bits_add(64, a, bits_of_int(64, j)) -> false proof
        assume ec
        show by taut(rewrite(sym(ec), dj), nd)
      qed
      show by taut(c0)
    qed
    have so := apply(tr.storen_other, {app(app(m, "vm"), "bytes")}, {a}, {n}, {x}, {c}, hc, ne)
    show by simp(em, so, e)
  qed
  have pm: app(app(m2, "vm"), "pages") = app(app(m, "vm"), "pages") by simp(em)
  have pw: app(app(w2, "vm"), "pages") = app(app(w, "vm"), "pages") by simp(ew)
  have pg2: all x0. x0 in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) ->
      app(app(app(m2, "vm"), "pages"), x0) = app(app(app(w2, "vm"), "pages"), x0) || (app(app(app(w2, "vm"), "pages"), x0) = none && abi.stack_page(app(m2, "vm"), x0)) proof
    fix x0
    assume hx
    have c := mp(all_elim(pages, {x0}), hx)
    have sq := mp(all_elim(tr.sp_pages, {app(m, "vm")}, {app(m2, "vm")}, {x0}), pm)
    show := rewrite(sym(pw), rewrite(sym(sq), rewrite(sym(pm), c)))
  qed
  have rsv2: abi.stack_reserve(app(s, "vm")) -> abi.stack_reserve(app(m2, "vm")) proof
    assume h0
    show := apply(tr.rsv_same, pm, (app(app(m2, "vm"), "stack_top") = app(app(m, "vm"), "stack_top") by simp(em)), (app(app(m2, "vm"), "stack_limit") = app(app(m, "vm"), "stack_limit") by simp(em)), mp(rsv, h0))
  qed
  have wm2: abi.world_matches(app(s, "vm"), app(m2, "vm"), app(w2, "vm"), ds, abi.sp(s)) by defs(simp(em, ew, top, limit, brk0, brk, rewrite(em, rewrite(ew, by2)),
    rewrite(em, rewrite(ew, fr2)), rewrite(em, rewrite(ew, pg2)), nostk, stk, rewrite(em, rsv2), keep(abi.in_domain, abi.stack_page, abi.stack_reserve)), abi.world_matches)
  have oa2: all y. y in omega -> y in ds -> (int_le(abi.sp(s), y) && abi.stack_page(app(s, "vm"), int_div(y, x86_64_linux.PAGE))) && x86_64_linux.can_access(app(m2, "vm"), bits_of_int(64, y), 1) proof
    fix y
    assume h1 h2
    have c := mp(all_elim(oacc, {y}), h1, h2)
    have ca := apply(tr.acc_pages, {app(m, "vm")}, {app(m2, "vm")}, {bits_of_int(64, y)}, {1}, pm, taut(c))
    show by taut(c, ca)
  qed
  have wo2: app(w2, "objs") = ds := trans(eo, wob)
  show by defs(taut(wo2, wm2, oa2), tr.mem)
qed

// the world after a store: a world
theorem tr.world_store: all w a n x. w in abi.World -> w in univ(1) -> a in bits(64) ->
  fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), a, n, x))) in abi.World &&
  fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), a, n, x))) in univ(1)
proof
  fix w a n x
  assume hw hu ha
  have wf := expand(hw, abi.World)
  have vV: app(w, "vm") in x86_64_linux.Vm by simp(wf)
  have su := apply(g.store_univ, {app(w, "vm")}, {a}, {n}, {x}, vV)
  have vu: app(w, "vm") in univ(1) by simp(hu)
  have nu: fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), a, n, x)) in univ(1) by simp(vu, su)
  have nv := apply(x86.store_vm, {app(w, "vm")}, {a}, {n}, {x}, vV, nu)
  have r1: fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), a, n, x))) in abi.World by defs(simp(wf, nv, hu, su, nu), abi.World)
  have r2: fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), a, n, x))) in univ(1) by simp(hu, nu)
  show by taut(r1, r2)
qed

// (a byte the spec's store writes -- in the world's domain -- is no byte on
// a stack page below the entry's sp: the domain is the world's non-stack
// pages and the stack objects, at or above sp)
theorem tr.store_off: all s m w v a8 n j t. tr.mem(s, m, w, v) -> gimple.usable(app(w, "vm"), app(w, "objs"), a8, n, true) -> int_le(0, a8) -> j in omega -> int_lt(j, n) ->
  t in omega -> abi.stack_page(app(m, "vm"), int_div(t, 4096)) -> int_lt(t, abi.sp(s)) -> !(int_add(a8, j) = t)
proof
  fix s m w v a8 n j t
  assume hmm hus ha j1 j2 ht hsp hlt
  have {wob, wm, oacc} := hmm
  have {pages} := wm
  have lt dm := apply(tr.usable_dom, {app(w, "vm")}, {app(w, "objs")}, {a8}, {n}, {true}, {j}, hus, ha, j1, j2)
  have no: int_add(a8, j) = t -> false proof
    assume e
    have dm2 := rewrite(e, dm)
    have c1: t in app(w, "objs") -> false proof
      assume ho
      have ho2 := rewrite(wob, ho)
      have c := mp(all_elim(oacc, {t}), ht, ho2)
      show by arith(c, hlt)
    qed
    have c2: x86_64_linux.mapped(app(w, "vm"), int_div(t, x86_64_linux.PAGE)) && !(app(snd(app(app(app(w, "vm"), "pages"), int_div(t, x86_64_linux.PAGE))), "kind") = 2) -> false proof
      assume h
      have hm0 hk0 := h
      have po: int_div(t, 4096) in omega by simp(ht)
      have hp: int_div(t, x86_64_linux.PAGE) in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) by simp(expand(hm0, x86_64_linux.mapped), po, keep(x86_64_linux.TASK_SIZE))
      have pc := mp(all_elim(pages, {int_div(t, x86_64_linux.PAGE)}), hp)
      have nn: !(app(app(app(w, "vm"), "pages"), int_div(t, x86_64_linux.PAGE)) = none) by simp(expand(hm0, x86_64_linux.mapped))
      have pe: app(app(app(m, "vm"), "pages"), int_div(t, 4096)) = app(app(app(w, "vm"), "pages"), int_div(t, 4096)) by defs(simp(pc, nn), x86_64_linux.PAGE)
      have k2: app(snd(app(app(app(m, "vm"), "pages"), int_div(t, 4096))), "kind") = 2 by simp(expand(hsp, abi.stack_page))
      have k3 := rewrite(pe, k2)
      have hk1 := expand(hk0, x86_64_linux.PAGE)
      show by taut(k3, hk1)
    qed
    show by taut(expand(dm2, abi.in_domain), c1, c2)
  qed
  show by taut(no)
qed

// (the bytes near rsp -- the return address, the homes -- after the spec's
// store of n bytes at a8 (in the world's domain): as before)
theorem tr.store_keeps: all s base code fr m w v hs a8 n x. tr.inv(s, base, code, fr, m, w) -> tr.mem(s, m, w, v) -> tr.homes(s, m, hs) ->
  a8 in bits(64) -> n in omega -> gimple.usable(app(w, "vm"), app(w, "objs"), a8, n, true) ->
  x86_64_linux.le(x86_64_linux.store_le(app(app(m, "vm"), "bytes"), a8, n, x), app(app(s, "gpr"), 4), 8) = abi.ret(s) &&
  tr.homes(s, fn_update(m, "vm", fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), a8, n, x))), hs)
proof
  fix s base code fr m w v hs a8 n x
  assume hi hmm hh ha8 hn hus
  have {kp, ra8, sM, slt, sal, hsps} := hi
  have r4 := apply(x86i.rsp_typed, sM)
  have g8 := apply(tr.inv_gap, hi)
  have nr := apply(tr.sp_lt, {app(app(s, "gpr"), 4)}, r4, slt)
  have a0: int_le(0, a8) by simp(ha8)
  let R := app(app(s, "gpr"), 4)
  let B := app(app(m, "vm"), "bytes")
  // (a byte off the store: on a stack page of m, below sp)
  have off: all t. t in bits(64) -> abi.stack_page(app(m, "vm"), int_div(t, 4096)) -> int_lt(t, abi.sp(s)) -> app(x86_64_linux.store_le(B, a8, n, x), t) = app(B, t) proof
    fix t
    assume htb hsp hlt
    have ne: all j. j in omega -> int_lt(j, n) -> !(bits_add(64, a8, bits_of_int(64, j)) = t) proof
      fix j
      assume j1 j2
      have e := apply(tr.usable_ea, {app(w, "vm")}, {app(w, "objs")}, {a8}, {n}, {true}, {j}, hus, ha8, j1, j2)
      have nq := apply(tr.store_off, {s}, {m}, {w}, {v}, {a8}, {n}, {j}, {t}, hmm, hus, a0, j1, j2, simp(htb), hsp, hlt)
      show := rewrite(sym(e), nq)
    qed
    show := apply(x86.store_outside, {B}, {a8}, {n}, {x}, {t}, htb, ne)
  qed
  // the return address: on rsp's page, a stack page kept since the entry
  have so: R in omega by simp(r4)
  have kr := mp(all_elim(expand(kp, tr.kept), {R}), so, arith(so), arith(so))
  have p0: app(app(app(m, "vm"), "pages"), int_div(R, 4096)) = app(app(app(s, "vm"), "pages"), int_div(R, 4096)) by defs(kr, x86_64_linux.page_of, x86_64_linux.PAGE)
  have sp0: abi.stack_page(app(m, "vm"), int_div(R, 4096)) by defs(simp(p0, expand(hsps, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
  have rk: all k. k in omega -> int_lt(k, 8) -> app(x86_64_linux.store_le(B, a8, n, x), bits_add(64, R, bits_of_int(64, k))) = app(B, bits_add(64, R, bits_of_int(64, k))) proof
    fix k
    assume k1 k2
    have rp := apply(abi.ret_pages, {R}, {k}, r4, sal, slt, k1, k2)
    have ek: bits_add(64, R, bits_of_int(64, k)) = int_add(R, k) by simp(r4, slt, k1, k2)
    have spk: abi.stack_page(app(m, "vm"), int_div(bits_add(64, R, bits_of_int(64, k)), 4096)) by simp(rp, sp0)
    have lk: int_lt(bits_add(64, R, bits_of_int(64, k)), abi.sp(s)) by simp(ek, r4, slt, k1, k2)
    show := apply(off, {bits_add(64, R, bits_of_int(64, k))}, simp(), spk, lk)
  qed
  have r8 := apply(tr.le_same, {x86_64_linux.store_le(B, a8, n, x)}, {B}, {R}, {8}, simp(), rk)
  have re := trans(r8, ra8)
  // the homes: on stack pages, below rsp
  have hk: all c. c in dom(hs) -> x86_64_linux.le(app(app(fn_update(m, "vm", fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(B, a8, n, x))), "vm"), "bytes"),
      bits_add(64, int_add(R, c), 0), fst(app(hs, c))) = snd(app(hs, c)) && tr.hrange(c, fst(app(hs, c))) &&
      tr.hacc(s, app(fn_update(m, "vm", fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(B, a8, n, x))), "vm"), c, fst(app(hs, c))) proof
    fix c
    assume hc
    have hv hcr ha := mp(all_elim(expand(hh, tr.homes), {c}), hc)
    have nko: fst(app(hs, c)) in omega by taut(expand(hcr, tr.hrange))
    have ck: all k. k in omega -> int_lt(k, fst(app(hs, c))) ->
        app(x86_64_linux.store_le(B, a8, n, x), bits_add(64, bits_add(64, int_add(R, c), 0), bits_of_int(64, k))) = app(B, bits_add(64, bits_add(64, int_add(R, c), 0), bits_of_int(64, k))) proof
      fix k
      assume k1 k2
      have ek _ kl .. := apply(tr.ha_byte, {R}, {c}, {fst(app(hs, c))}, {k}, r4, g8, hcr, k1, k2)
      have a1 a2 := mp(all_elim(expand(ha, tr.hacc), {k}), k1, k2)
      have lk: int_lt(bits_add(64, bits_add(64, int_add(R, c), 0), bits_of_int(64, k)), abi.sp(s)) by simp(ek, kl, nr)
      show := apply(off, {bits_add(64, bits_add(64, int_add(R, c), 0), bits_of_int(64, k))}, simp(), a2, lk)
    qed
    have ls := apply(tr.le_same, {x86_64_linux.store_le(B, a8, n, x)}, {B}, {bits_add(64, int_add(R, c), 0)}, {fst(app(hs, c))}, nko, ck)
    have pe: app(app(fn_update(m, "vm", fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(B, a8, n, x))), "vm"), "pages") = app(app(m, "vm"), "pages") by simp()
    have ha2 := apply(tr.hacc_pages, {s}, {app(m, "vm")}, {app(fn_update(m, "vm", fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(B, a8, n, x))), "vm")}, {c}, {fst(app(hs, c))}, pe, ha)
    show by simp(ls, hv, hcr, ha2)
  qed
  have ho: tr.homes(s, fn_update(m, "vm", fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(B, a8, n, x))), hs) by defs(hk, tr.homes)
  show by taut(re, ho)
qed

// (the spec's n-byte store at a8 defined: the machine's bytes there
// writable)
theorem tr.store_acc: all s m w ds a8 n. tr.mem(s, m, w, ds) -> a8 in bits(64) -> n in omega -> int_le(n, 8) -> gimple.usable(app(w, "vm"), app(w, "objs"), a8, n, true) ->
  (all j. j in omega -> int_lt(j, n) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, a8, bits_of_int(64, j)), 1))
proof
  fix s m w ds a8 n
  assume hmm ha8 hn hn8 hus
  have ab0: int_le(0, a8) by simp(ha8)
  fix j
  assume j1 j2
  have r := apply(tr.mem_read, {s}, {m}, {w}, {ds}, {a8}, {n}, {true}, {j}, hmm, hus, ab0, j1, j2)
  have e := apply(tr.usable_ea, {app(w, "vm")}, {app(w, "objs")}, {a8}, {n}, {true}, {j}, hus, ha8, j1, j2)
  have c: x86_64_linux.can_access(app(m, "vm"), int_add(a8, j), 1) by taut(r)
  show := rewrite(sym(e), c)
qed

// a store both sides make: the machine's n bytes x at a8, off the stack
// pages (the spec's store there defined), the spec's world w2 = w with
// them; the claim after it (p reduced to p2 across the store) gives the
// claim before
theorem tr.store_step(zb. bkp, zb pb wb. bka): all s v base code fr a a2 a8 n x hs ds rs p p2 w w2.
  (all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
     o = ok(fn_update(fn_update(m, "rip", a2), "vm", fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), a8, n, x))), empty)) ->
  base in omega -> a2 in bits(64) -> a8 in bits(64) -> n in omega -> int_le(n, 8) -> gimple.usable(app(w, "vm"), app(w, "objs"), a8, n, true) ->
  w2 = fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), a8, n, x))) ->
  tr.red(p, w, p2, w2) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, rs, p2, w2) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 a8 n x hs ds rs p p2 w w2
  assume he hbase ha2 ha8 hn hn8 hus hw2 hred hpt
  have g: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, ds) -> tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m) proof
    fix m
    assume hi hr hh hrs hmm hfr
    have i := expand(hi, tr.inv)
    have mM: m in x86_64_linux.Machine by simp(i, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access))
    have mu: m in univ(1) by simp(i, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access))
    have sM: s in x86_64_linux.Machine by simp(i, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access))
    have cd: abi.code_at(app(m, "vm"), base, code) by simp(i, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access))
    have wW: w in abi.World && w in univ(1) by simp(i, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access))
    have r4 := apply(x86i.rsp_typed, sM)
    have nr := apply(tr.inv_nr, hi)
    let M2 := fn_update(fn_update(m, "rip", a2), "vm", fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), a8, n, x)))
    have st: all o. runs(x86_64_linux.step(), m, o) -> (ex m2. o = ok(m2, empty) && m2 = M2) proof
      fix o
      assume ho
      have e := mp(all_elim(he, {m}, {o}), hi, hr, hh, hrs, hmm, ho)
      show by ex_intro({M2}, simp(e))
    qed
    have post: all m2. m2 = M2 -> tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m2) proof
      fix m2
      assume e2
      have pt := apply(x86i.parts, mM)
      // the machine's store: writable, its code untouched
      have wa := apply(tr.store_acc, {s}, {m}, {w}, {v}, {a8}, {n}, hmm, ha8, hn, hn8, hus)
      have sc := apply(tr.store_code_acc, {base}, {code}, {app(m, "vm")}, {a8}, {n}, hn, hbase, cd, wa)
      have cd2: abi.code_at(fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), a8, n, x)), base, code) := all_elim(sc, {x})
      have k0: tr.keeps_code(app(s, "vm"), app(m, "vm")) by simp(i, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access, tr.keeps_code))
      have kc := apply(tr.keeps_store, {app(s, "vm")}, {app(m, "vm")}, {a8}, {n}, {x}, hn, k0, wa)
      have kp := apply(tr.store_keeps, {s}, {base}, {code}, {fr}, {m}, {w}, {v}, {hs}, {a8}, {n}, {x}, hi, hmm, hh, ha8, hn, hus)
      have vV: app(m, "vm") in x86_64_linux.Vm by simp(pt)
      have su := apply(g.store_univ, {app(m, "vm")}, {a8}, {n}, {x}, vV)
      have nu: fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), a8, n, x)) in univ(1) by simp(mu, su)
      have nv := apply(x86.store_vm, {app(m, "vm")}, {a8}, {n}, {x}, vV, nu)
      have m2M: M2 in x86_64_linux.Machine by defs(simp(expand(mM, x86_64_linux.Machine), mu, pt, nv, nu, ha2), x86_64_linux.Machine)
      have m2u: M2 in univ(1) by simp(mu, nu, ha2)
      have ws := apply(tr.world_store, {w}, {a8}, {n}, {x}, taut(wW), taut(wW), ha8)
      have ws2 := rewrite(sym(hw2), ws)
      have kpt: tr.kept(app(s, "vm"), app(m, "vm"), app(app(s, "gpr"), 4)) by simp(i, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access, tr.kept))
      have vb := apply(tr.kept_bytes, {app(s, "vm")}, {app(m, "vm")}, {app(app(s, "gpr"), 4)}, {x86_64_linux.store_le(app(app(m, "vm"), "bytes"), a8, n, x)}, kpt)
      have i2: tr.inv(s, base, code, fr, M2, w2) by defs(simp(i, hw2, m2M, m2u, cd2, kc, kp, ws2, vb, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access, tr.kept)), tr.inv)
      have khm: tr.homes(s, fn_update(m, "vm", fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), a8, n, x))), hs) by taut(kp)
      have kh: tr.homes(s, M2, hs) by defs(simp(expand(khm, tr.homes)), tr.homes)
      have rs2: tr.regs(M2, rs) by defs(simp(expand(hrs, tr.regs)), tr.regs)
      have mm2 := apply(tr.mem_store, {s}, {m}, {M2}, {w}, {w2}, {v}, {a8}, {n}, {x}, hmm, ha8, hus, simp(), simp(hw2), simp(hw2))
      have rp: app(M2, "rip") = a2 by simp()
      have pe: app(app(M2, "vm"), "pages") = app(app(m, "vm"), "pages") by simp()
      have f2 := apply(tr.frame_store, {s}, {m}, {M2}, {ds}, {app(m, "vm")}, hfr, simp(), all_elim(x86.grows_refl, {app(m, "vm")}), all_elim(x86.stk_ext_refl, {app(m, "vm")}), pe, simp(), simp())
      have c := mp(all_elim(expand(hpt, tr.pt), {M2}), i2, rp, kh, rs2, mm2, f2)
      have c2 := apply(tr.cl_red[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], hred, c)
      show := rewrite(sym(e2), c2)
    qed
    show := mp(mp(mp(tr.step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb), s := s, v := v, p := p, w := w, m := m, q := y. y = M2], st), nr), post)
  qed
  show by defs(g, tr.lv)
qed

// (a step setting rip only: the coupling kept)
theorem tr.rip_step(zb. bkp, zb pb wb. bka): all s v base code fr a t hs ds rs p w.
  (all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) -> o = ok(fn_update(m, "rip", t), empty)) ->
  t in bits(64) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, t, hs, ds, rs, p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a t hs ds rs p w
  assume he ht hpt
  have g: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, ds) -> tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m) proof
    fix m
    assume hi hr hh hrs hmm hfr
    have i := expand(hi, tr.inv)
    have sM: s in x86_64_linux.Machine by simp(i, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access))
    have r4 := apply(x86i.rsp_typed, sM)
    have nr := apply(tr.inv_nr, hi)
    have st: all o. runs(x86_64_linux.step(), m, o) -> (ex m2. o = ok(m2, empty) && m2 = fn_update(m, "rip", t)) proof
      fix o
      assume ho
      have e := mp(all_elim(he, {m}, {o}), hi, hr, hh, hrs, ho)
      show by ex_intro({fn_update(m, "rip", t)}, simp(e))
    qed
    have post: all m2. m2 = fn_update(m, "rip", t) -> tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m2) proof
      fix m2
      assume e2
      have i2 := mp(tr.inv_rip, {s}, {base}, {code}, {fr}, {m}, {w}, {t}, hi, ht)
      have rs2: tr.regs(fn_update(m, "rip", t), rs) by defs(simp(expand(hrs, tr.regs)), tr.regs)
      have rp: app(fn_update(m, "rip", t), "rip") = t by simp()
      have c := apply(tr.pt_regs[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], hpt, i2, rp, rs2, hh, hmm, hfr, simp(), simp())
      show := rewrite(sym(e2), c)
    qed
    show := mp(mp(mp(tr.step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb), s := s, v := v, p := p, w := w, m := m, q := y. y = fn_update(m, "rip", t)], st), nr), post)
  qed
  show by defs(g, tr.lv)
qed

// jmp rel8
theorem tr.jmp8(zb. bkp, zb pb wb. bka): all s v base code fr a a2 t len r hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(125, r)), m, o)) ->
  a2 = bits_add(64, a, len) -> t = bits_add(64, a2, bits_sext(8, 64, r)) -> r in bits(32) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, t, hs, ds, rs, p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 t len r hs ds rs p w
  assume hat ha2 hta hr8 hpt
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) -> o = ok(fn_update(m, "rip", t), empty) proof
    fix m o
    assume hi hr hh hrs ho
    have ip := apply(tr.inv_parts, hi)
    have hx := mp(all_elim(hat, {m}, {o}), ho, taut(ip), hr)
    have e := apply(x86i.jmp8, {m}, {o}, {r}, {len}, taut(ip), taut(ip), hr8, hx)
    show by simp(e, hr, ha2, hta)
  qed
  have tb: t in bits(64) by simp(hta)
  show := apply(tr.rip_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {t}, {hs}, {ds}, {rs}, {p}, {w}, he, tb, hpt)
qed

// jmp rel32
theorem tr.jmp32(zb. bkp, zb pb wb. bka): all s v base code fr a a2 t len r hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(124, r)), m, o)) ->
  a2 = bits_add(64, a, len) -> t = bits_add(64, a2, bits_sext(32, 64, r)) -> r in bits(32) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, t, hs, ds, rs, p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 t len r hs ds rs p w
  assume hat ha2 hta hr8 hpt
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) -> o = ok(fn_update(m, "rip", t), empty) proof
    fix m o
    assume hi hr hh hrs ho
    have ip := apply(tr.inv_parts, hi)
    have hx := mp(all_elim(hat, {m}, {o}), ho, taut(ip), hr)
    have e := apply(x86i.jmp32, {m}, {o}, {r}, {len}, taut(ip), taut(ip), hr8, hx)
    show by simp(e, hr, ha2, hta)
  qed
  have tb: t in bits(64) by simp(hta)
  show := apply(tr.rip_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {t}, {hs}, {ds}, {rs}, {p}, {w}, he, tb, hpt)
qed

// nop
theorem tr.nop(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len k hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(109, k)), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, rs, p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len k hs ds rs p w
  assume hat ha2 hpt
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) -> o = ok(fn_update(m, "rip", a2), empty) proof
    fix m o
    assume hi hr hh hrs ho
    have ip := apply(tr.inv_parts, hi)
    have hx := mp(all_elim(hat, {m}, {o}), ho, taut(ip), hr)
    have e := apply(x86i.nop, {m}, {o}, {k}, {len}, taut(ip), taut(ip), hx)
    show by simp(e, hr, ha2)
  qed
  have tb: a2 in bits(64) by simp(ha2)
  show := apply(tr.rip_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {hs}, {ds}, {rs}, {p}, {w}, he, tb, hpt)
qed

// add r32, imm8 (g holding u): g := u + kk
theorem tr.add32_imm(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g z k kk n u r hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(60, pair(4, pair(0, pair(tag(0, g), pair(z, k)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> k in bits(8) -> kk = bits_sext(8, 32, k) -> g in dom(rs) -> app(rs, g) = pair(n, u) -> u in bits(32) ->
  r = bits_add(32, u, kk) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs, g, pair(4, r)), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g z k kk n u r hs ds rs p w
  assume hat ha2 hg hk hkk hd hu hu32 hr hpt0
  have hpt := rewrite(hr, hpt0)
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bits_add(32, u, kk))), empty)) proof
    fix m o
    assume hi hr hh hrs ho
    have ip := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {n}, {u}, hrs, hd, hu)
    have hx := mp(mp(mp(all_elim(hat, {m}, {o}), ho), taut(ip)), hr)
    obtain f, hf from apply(x86i.add32_imm, {m}, {o}, {g}, {z}, {k}, {len}, taut(ip), taut(ip), gR, hk, hx)
    show by ex_intro({f}, simp(hf, rg, hu32, hr, ha2, hkk, keep(x86i.flags_ok)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_add(32, u, kk) in bits(int_mul(8, 4)) && bits_add(32, u, kk) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {bits_add(32, u, kk)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// or r32, imm8 (g holding u, a 32-bit word): g := u | kk (a bitfield's
// bits set: `or edx, 0x20`)
theorem tr.or32_imm(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g z k kk n u r hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(60, pair(4, pair(1, pair(tag(0, g), pair(z, k)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> k in bits(8) -> kk = bits_sext(8, 32, k) -> g in dom(rs) -> app(rs, g) = pair(n, u) -> u in bits(32) ->
  r = bits_or(32, u, kk) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs, g, pair(4, r)), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g z k kk n u r hs ds rs p w
  assume hat ha2 hg hk hkk hd hu hu32 hr hpt0
  have hpt := rewrite(hr, hpt0)
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bits_or(32, u, kk))), empty)) proof
    fix m o
    assume hi hr hh hrs ho
    have ip := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {n}, {u}, hrs, hd, hu)
    have hx := mp(mp(mp(all_elim(hat, {m}, {o}), ho), taut(ip)), hr)
    obtain f, hf from apply(x86i.or32_imm, {m}, {o}, {g}, {z}, {k}, {len}, taut(ip), taut(ip), gR, hk, hx)
    show by ex_intro({f}, simp(hf, rg, hu32, hr, ha2, hkk, keep(x86i.flags_ok)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_or(32, u, kk) in bits(int_mul(8, 4)) && bits_or(32, u, kk) in bits(64) proof
    fix m
    have i32 := mp(bits_or_in[n := 32, x := u, y := kk], simp())
    show by simp(i32, keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {bits_or(32, u, kk)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// mov dword [rsp + d], imm32: the slot c (rsp + d in the frame) := k (the
// frame written)
theorem tr.store32i_home(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len d c k hs hs2 ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(77, pair(4, pair(x86i.rsp_mem(d), pair(x86i.rsp_mem(d), k))))), m, o)) ->
  a2 = bits_add(64, a, len) -> base in omega -> d in bits(64) -> c = int_mod(int_sub(d, fr), 18446744073709551616) -> tr.hrange(c, 4) ->
  ds in omega -> int_le(int_sub(18446744073709551616, ds), c) -> int_le(ds, tr.FMAX) -> k in bits(32) -> tr.hkeep(hs, hs2, c, 4) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, fn_update(hs2, c, pair(4, k)), ds, rs, p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len d c k hs hs2 ds rs p w
  assume hat ha2 hbase hd hcd hc hfo hfd hfm hk hkp hpt
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex m1 e1. runs(x86_64_linux.touch_range(tr.ha(s, c), 4, 1), fn_update(m, "rip", a2), ok(m1, e1)) &&
        o = ok(fn_update(m1, "vm", fn_update(app(m1, "vm"), "bytes", x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), tr.ha(s, c), 4, k))), empty)) ||
      (ex y e. runs(x86_64_linux.touch_range(tr.ha(s, c), 4, 1), fn_update(m, "rip", a2), exc(y, e)) && o = exc(y, e)) proof
    fix m o
    assume hi hr hh hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have {sM, slt} := hi
    have r4 := apply(x86i.rsp_typed, sM)
    have g8 := apply(tr.inv_gap, hi)
    have fe := apply(tr.frame_ea, {s}, {base}, {code}, {fr}, {m}, {w}, {d}, {c}, {0}, hi, hd, hcd, simp())
    have k0: all i. i in omega -> int_lt(i, 4) -> x86_64_linux.canonical(bits_add(64, x86i.rsp_ea(m, d), bits_of_int(64, i))) proof
      fix i
      assume i1 i2
      have ei _ il .. := apply(tr.ha_byte, {app(app(s, "gpr"), 4)}, {c}, {4}, {i}, r4, g8, hc, i1, i2)
      have ea: bits_add(64, x86i.rsp_ea(m, d), bits_of_int(64, i)) = int_add(int_sub(app(app(s, "gpr"), 4), int_sub(18446744073709551616, c)), i) by simp(fe, ei)
      have cr := expand(hc, tr.hrange)
      show by defs(simp(ea, il, slt, i1, cr), x86_64_linux.canonical)
    qed
    have hx2 := mp(mp(mp(all_elim(hat, {m}, {o}), ho), ipC), hr)
    have r := apply(x86i.store32i_rsp_t, {m}, {o}, {d}, {k}, {len}, ipM, ipU, hd, hk, k0, hx2)
    have ra: bits_add(64, app(m, "rip"), len) = a2 by simp(hr, ha2)
    have r2 := rewrite(ra, rewrite(fe, r))
    have nd: all t. !runs(x86_64_linux.touch_range(tr.ha(s, c), 4, 1), fn_update(m, "rip", a2), diverge(t)) proof
      fix t
      show := apply(x86.touch_range_nodiv, {fn_update(m, "rip", a2)}, {tr.ha(s, c)}, {4}, {1}, {t}, simp())
    qed
    have dv: (ex t. runs(x86_64_linux.touch_range(tr.ha(s, c), 4, 1), fn_update(m, "rip", a2), diverge(t)) && o = diverge(t)) -> false proof
      assume h
      obtain t, ht from h
      show by taut(ht, all_elim(nd, {t}))
    qed
    show by taut(r2, dv)
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  have k4: k in bits(int_mul(8, 4)) by simp(hk)
  show := apply(tr.fstore_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {c}, {4}, {k}, {hs}, {hs2}, {ds}, {rs}, {p}, {w}, he, hbase, a2b, hc, hfo, hfd, hfm, simp(), k4, hkp, hpt)
qed

// mov qword [rsp + d], simm32 (the slot c): the slot c := k sign-extended
theorem tr.store64i_home(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len d c k kk hs hs2 ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(77, pair(8, pair(x86i.rsp_mem(d), pair(x86i.rsp_mem(d), k))))), m, o)) ->
  a2 = bits_add(64, a, len) -> base in omega -> d in bits(64) -> c = int_mod(int_sub(d, fr), 18446744073709551616) -> tr.hrange(c, 8) ->
  ds in omega -> int_le(int_sub(18446744073709551616, ds), c) -> int_le(ds, tr.FMAX) -> k in bits(32) -> kk = bits_sext(32, 64, k) -> tr.hkeep(hs, hs2, c, 8) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, fn_update(hs2, c, pair(8, kk)), ds, rs, p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len d c k kk hs hs2 ds rs p w
  assume hat ha2 hbase hd hcd hc hfo hfd hfm hk hkk hkp hpt
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex m1 e1. runs(x86_64_linux.touch_range(tr.ha(s, c), 8, 1), fn_update(m, "rip", a2), ok(m1, e1)) &&
        o = ok(fn_update(m1, "vm", fn_update(app(m1, "vm"), "bytes", x86_64_linux.store_le(app(app(m1, "vm"), "bytes"), tr.ha(s, c), 8, kk))), empty)) ||
      (ex y e. runs(x86_64_linux.touch_range(tr.ha(s, c), 8, 1), fn_update(m, "rip", a2), exc(y, e)) && o = exc(y, e)) proof
    fix m o
    assume hi hr hh hrs ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have {sM, slt} := hi
    have r4 := apply(x86i.rsp_typed, sM)
    have g8 := apply(tr.inv_gap, hi)
    have fe := apply(tr.frame_ea, {s}, {base}, {code}, {fr}, {m}, {w}, {d}, {c}, {0}, hi, hd, hcd, simp())
    have k0: all i. i in omega -> int_lt(i, 8) -> x86_64_linux.canonical(bits_add(64, x86i.rsp_ea(m, d), bits_of_int(64, i))) proof
      fix i
      assume i1 i2
      have ei _ il .. := apply(tr.ha_byte, {app(app(s, "gpr"), 4)}, {c}, {8}, {i}, r4, g8, hc, i1, i2)
      have ea: bits_add(64, x86i.rsp_ea(m, d), bits_of_int(64, i)) = int_add(int_sub(app(app(s, "gpr"), 4), int_sub(18446744073709551616, c)), i) by simp(fe, ei)
      have cr := expand(hc, tr.hrange)
      show by defs(simp(ea, il, slt, i1, cr), x86_64_linux.canonical)
    qed
    have hx2 := mp(mp(mp(all_elim(hat, {m}, {o}), ho), ipC), hr)
    have r := apply(x86i.store64i_rsp_t, {m}, {o}, {d}, {k}, {len}, ipM, ipU, hd, hk, k0, hx2)
    have ra: bits_add(64, app(m, "rip"), len) = a2 by simp(hr, ha2)
    have r2 := rewrite(sym(hkk), rewrite(ra, rewrite(fe, r)))
    have nd: all t. !runs(x86_64_linux.touch_range(tr.ha(s, c), 8, 1), fn_update(m, "rip", a2), diverge(t)) proof
      fix t
      show := apply(x86.touch_range_nodiv, {fn_update(m, "rip", a2)}, {tr.ha(s, c)}, {8}, {1}, {t}, simp())
    qed
    have dv: (ex t. runs(x86_64_linux.touch_range(tr.ha(s, c), 8, 1), fn_update(m, "rip", a2), diverge(t)) && o = diverge(t)) -> false proof
      assume h
      obtain t, ht from h
      show by taut(ht, all_elim(nd, {t}))
    qed
    show by taut(r2, dv)
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  have k4: kk in bits(int_mul(8, 8)) by simp(hkk, hk)
  show := apply(tr.fstore_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {c}, {8}, {kk}, {hs}, {hs2}, {ds}, {rs}, {p}, {w}, he, hbase, a2b, hc, hfo, hfd, hfm, simp(), k4, hkp, hpt)
qed

// add dword [rsp + d], imm8 (the slot c, at rsp + d in the frame, holding
// u): the slot c := u + kk
theorem tr.add32_home(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len d c k kk u r hs hs2 ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(60, pair(4, pair(0, pair(x86i.rsp_mem(d), pair(x86i.rsp_mem(d), k)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> base in omega -> d in bits(64) -> c = int_mod(int_sub(d, fr), 18446744073709551616) ->
  k in bits(8) -> kk = bits_sext(8, 32, k) -> c in dom(hs) -> app(hs, c) = pair(4, u) ->
  tr.hkeep(hs, hs2, c, 4) ->
  r = bits_add(32, u, kk) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, fn_update(hs2, c, pair(4, r)), ds, rs, p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len d c k kk u r hs hs2 ds rs p w
  assume hat ha2 hbase hd hcd hk hkk hdd hu hkp hr hpt0
  have hpt := rewrite(hr, hpt0)
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
     (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "vm",
       fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), bits_add(64, int_add(app(app(s, "gpr"), 4), c), 0), 4, bits_add(32, u, kk)))), empty)) proof
    fix m o
    assume hi hr hh hrs ho
    have ip := apply(tr.inv_parts, hi)
    have mM: m in x86_64_linux.Machine by taut(ip)
    have mu: m in univ(1) by taut(ip)
    have fe := apply(tr.frame_ea, {s}, {base}, {code}, {fr}, {m}, {w}, {d}, {c}, {0}, hi, hd, hcd, simp())
    have ac := apply(tr.home_acc, {s}, {base}, {code}, {fr}, {m}, {w}, {hs}, {d}, {c}, {4}, {u}, hi, hh, hd, hcd, hdd, hu)
    have hg := apply(tr.home_read, {s}, {base}, {code}, {fr}, {m}, {w}, {hs}, {d}, {c}, {4}, {u}, hi, hh, hd, hcd, hdd, hu)
    have hx := mp(all_elim(hat, {m}, {o}), ho, taut(ip), hr)
    obtain f, hf from apply(x86i.add32_rsp_imm, {m}, {o}, {d}, {k}, {len}, mM, mu, hd, hk, taut(ac), taut(ac), hx)
    show by ex_intro({f}, simp(hf, hg, fe, hr, ha2, hkk, keep(x86i.flags_ok)))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  have x32: bits_add(32, u, kk) in bits(int_mul(8, 4)) by simp()
  show := apply(tr.hstore_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {c}, {4}, {u}, {bits_add(32, u, kk)}, {hs}, {hs2}, {ds}, {rs}, {p}, {w}, he, hbase, a2b, hdd, hu, simp(), x32, hkp, hpt)
qed

// movzx r32, byte [rip + d] (the address bigA, a static's): g := the byte
// (the spec's load there defined)
theorem tr.movzx8_rip(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g d z2 bigA r hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(79, pair(4, pair(g, pair(x86i.rip_mem(d), pair(x86i.rip_mem(d), z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> d in bits(64) -> bigA = bits_add(64, int_add(a2, d), 0) -> gimple.usable(app(w, "vm"), app(w, "objs"), bigA, 1, false) ->
  r = bits_of_int(8, gimple.bytes_at(app(w, "vm"), bigA, 1)) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs, g, pair(1, r)), p, w) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g d z2 bigA r hs ds rs p w
  assume hat ha2 hg hd hA hus hr hpt0
  have hpt := rewrite(hr, hpt0)
  let BY := bits_of_int(8, gimple.bytes_at(app(w, "vm"), bigA, 1))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "gpr", fn_update(app(m, "gpr"), g, BY)), empty) proof
    fix m o
    assume hi hr hhs hrs hmm ho
    have ip := apply(tr.inv_parts, hi)
    have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
    have ea: x86i.rip_ea(m, len, d) = bigA by simp(hr, ha2, hA)
    have ab: bigA in bits(64) by simp(hA)
    have ab0: int_le(0, bigA) by simp(ab)
    // the byte: the world's
    have ml := apply(tr.mem_load, {s}, {m}, {w}, {v}, {bigA}, {1}, {false}, hmm, hus, ab, simp())
    have ac := rewrite(sym(ea), ml.1)
    have lw := all_elim(tr.le_bytes1, {app(w, "vm")}, {bigA})
    have hx := mp(all_elim(hat, {m}, {o}), ho, taut(ip), hr)
    have e := apply(x86i.movzx8_rip, {m}, {o}, {g}, {d}, {z2}, {len}, taut(ip), taut(ip), gR, hd, ac, hx)
    show by simp(e, ea, ml.2, lw, hr, ha2, keep(gimple.bytes_at, x86_64_linux.le))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> BY in bits(int_mul(8, 1)) && BY in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs, gimple.bytes_at))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step0v[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {1}, {BY}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// (the machine's byte store at a8: writable, from the spec's store defined)
// mov byte [rip + d], imm8 (the address bigA, a static's): the spec's
// store of k there
theorem tr.store8i_rip(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len d k bigA hs ds rs p p2 w w2.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(30, pair(x86i.rip_mem(d), pair(x86i.rip_mem(d), k)))), m, o)) ->
  a2 = bits_add(64, a, len) -> base in omega -> d in bits(64) -> k in bits(8) -> bigA = bits_add(64, int_add(a2, d), 0) ->
  gimple.usable(app(w, "vm"), app(w, "objs"), bigA, 1, true) ->
  w2 = fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), bigA, 1, k))) ->
  tr.red(p, w, p2, w2) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, rs, p2, w2) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len d k bigA hs ds rs p p2 w w2
  assume hat ha2 hbase hd hk hA hus hw2 hred hpt
  have ab: bigA in bits(64) by simp(hA)
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "vm", fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), bigA, 1, k))), empty) proof
    fix m o
    assume hi hr hh hrs hmm ho
    have ip := apply(tr.inv_parts, hi)
    have ea: x86i.rip_ea(m, len, d) = bigA by simp(hr, ha2, hA)
    have wa := apply(tr.store_acc, {s}, {m}, {w}, {v}, {bigA}, {1}, hmm, ab, simp(), simp(), hus)
    have wa2 := rewrite(sym(ea), wa)
    have hx := mp(all_elim(hat, {m}, {o}), ho, taut(ip), hr)
    have e := apply(x86i.store8i_rip, {m}, {o}, {d}, {k}, {len}, taut(ip), taut(ip), hd, hk, wa2, hx)
    show by simp(e, ea, hr, ha2)
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.store_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {bigA}, {1}, {k}, {hs}, {ds}, {rs}, {p}, {p2}, {w}, {w2}, he, hbase, a2b, ab, simp(), simp(), hus, hw2, hred, hpt)
qed

// mov dword [rip + d], imm32 (the address bigA, a static's): the spec's
// 4-byte store of k there
theorem tr.store32i_rip(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len d k bigA hs ds rs p p2 w w2.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(77, pair(4, pair(x86i.rip_mem(d), pair(x86i.rip_mem(d), k))))), m, o)) ->
  a2 = bits_add(64, a, len) -> base in omega -> d in bits(64) -> k in bits(32) -> bigA = bits_add(64, int_add(a2, d), 0) ->
  gimple.usable(app(w, "vm"), app(w, "objs"), bigA, 4, true) ->
  w2 = fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), bigA, 4, k))) ->
  tr.red(p, w, p2, w2) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, rs, p2, w2) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len d k bigA hs ds rs p p2 w w2
  assume hat ha2 hbase hd hk hA hus hw2 hred hpt
  have ab: bigA in bits(64) by simp(hA)
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "vm", fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), bigA, 4, k))), empty) proof
    fix m o
    assume hi hr hh hrs hmm ho
    have ip := apply(tr.inv_parts, hi)
    have ea: x86i.rip_ea(m, len, d) = bigA by simp(hr, ha2, hA)
    have wa := apply(tr.store_acc, {s}, {m}, {w}, {v}, {bigA}, {4}, hmm, ab, simp(), simp(), hus)
    have wa2 := rewrite(sym(ea), wa)
    have hx := mp(all_elim(hat, {m}, {o}), ho, taut(ip), hr)
    have e := apply(x86i.store32i_rip, {m}, {o}, {d}, {k}, {len}, taut(ip), taut(ip), hd, hk, wa2, hx)
    show by simp(e, ea, hr, ha2)
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.store_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {bigA}, {4}, {k}, {hs}, {ds}, {rs}, {p}, {p2}, {w}, {w2}, he, hbase, a2b, ab, simp(), simp(), hus,
    hw2, hred, hpt)
qed

// mov qword [rip + d], simm32: the spec's 8-byte store of kk
theorem tr.store64i_rip(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len d k kk bigA hs ds rs p p2 w w2.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(77, pair(8, pair(x86i.rip_mem(d), pair(x86i.rip_mem(d), k))))), m, o)) ->
  a2 = bits_add(64, a, len) -> base in omega -> d in bits(64) -> k in bits(32) -> kk = bits_sext(32, 64, k) -> bigA = bits_add(64, int_add(a2, d), 0) ->
  gimple.usable(app(w, "vm"), app(w, "objs"), bigA, 8, true) ->
  w2 = fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), bigA, 8, kk))) ->
  tr.red(p, w, p2, w2) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, rs, p2, w2) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len d k kk bigA hs ds rs p p2 w w2
  assume hat ha2 hbase hd hk hkk hA hus hw2 hred hpt
  have ab: bigA in bits(64) by simp(hA)
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "vm", fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), bigA, 8, kk))), empty) proof
    fix m o
    assume hi hr hh hrs hmm ho
    have ip := apply(tr.inv_parts, hi)
    have ea: x86i.rip_ea(m, len, d) = bigA by simp(hr, ha2, hA)
    have wa := apply(tr.store_acc, {s}, {m}, {w}, {v}, {bigA}, {8}, hmm, ab, simp(), simp(), hus)
    have wa2 := rewrite(sym(ea), wa)
    have hx := mp(all_elim(hat, {m}, {o}), ho, taut(ip), hr)
    have e := apply(x86i.store64i_rip, {m}, {o}, {d}, {k}, {len}, taut(ip), taut(ip), hd, hk, wa2, hx)
    show by simp(e, ea, hkk, hr, ha2)
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.store_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {bigA}, {8}, {kk}, {hs}, {ds}, {rs}, {p}, {p2}, {w}, {w2}, he, hbase, a2b, ab, simp(), simp(), hus,
    hw2, hred, hpt)
qed

// mov byte [rip + d], r8 (g a low byte register holding u): the spec's
// store of x (the byte of u) at bigA
theorem tr.store8_rip(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g d z0 z1 n u x bigA hs ds rs p p2 w w2.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(28, pair(z0, pair(z1, pair(x86i.rip_mem(d), tag(0, g)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> base in omega -> g in x86_64_linux.Reg -> int_lt(g, 4) -> d in bits(64) -> bigA = bits_add(64, int_add(a2, d), 0) ->
  g in dom(rs) -> app(rs, g) = pair(n, u) -> bits_slice(u, 7, 0) = x ->
  gimple.usable(app(w, "vm"), app(w, "objs"), bigA, 1, true) ->
  w2 = fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), bigA, 1, x))) ->
  tr.red(p, w, p2, w2) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, rs, p2, w2) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g d z0 z1 n u x bigA hs ds rs p p2 w w2
  assume hat ha2 hbase hg hg4 hd hA hgd hgu hx hus hw2 hred hpt
  have ab: bigA in bits(64) by simp(hA)
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "vm", fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), bigA, 1, x))), empty) proof
    fix m o
    assume hi hr hh hrs hmm ho
    have ip := apply(tr.inv_parts, hi)
    have ea: x86i.rip_ea(m, len, d) = bigA by simp(hr, ha2, hA)
    have wa := apply(tr.store_acc, {s}, {m}, {w}, {v}, {bigA}, {1}, hmm, ab, simp(), simp(), hus)
    have wa2 := rewrite(sym(ea), wa)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {n}, {u}, hrs, hgd, hgu)
    have hx2 := mp(all_elim(hat, {m}, {o}), ho, taut(ip), hr)
    have e := apply(x86i.store8_rip, {m}, {o}, {g}, {d}, {z0}, {z1}, {len}, taut(ip), taut(ip), hg, hg4, hd, wa2, hx2)
    show by simp(e, ea, rg, hx, hr, ha2)
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.store_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {bigA}, {1}, {x}, {hs}, {ds}, {rs}, {p}, {p2}, {w}, {w2}, he, hbase, a2b, ab, simp(), simp(), hus, hw2, hred, hpt)
qed

// mov byte [b + i], r8 (b holding bv, i the pointer iv, g holding u): the
// spec's store of x (the byte of u) at iv + bv
theorem tr.store8_bi(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g b i z0 z1 nb bv iv ad n u x hs ds rs p p2 w w2.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(28, pair(z0, pair(z1, pair(x86i.bi_mem(b, i), tag(0, g)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> base in omega -> g in x86_64_linux.Reg -> int_lt(g, 4) -> b in x86_64_linux.Reg -> i in x86_64_linux.Reg ->
  b in dom(rs) -> app(rs, b) = pair(nb, bv) -> i in dom(rs) -> app(rs, i) = pair(8, iv) -> g in dom(rs) -> app(rs, g) = pair(n, u) -> bits_slice(u, 7, 0) = x ->
  ad = bits_add(64, iv, bv) ->
  gimple.usable(app(w, "vm"), app(w, "objs"), ad, 1, true) ->
  w2 = fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), ad, 1, x))) ->
  tr.red(p, w, p2, w2) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, rs, p2, w2) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g b i z0 z1 nb bv iv ad n u x hs ds rs p p2 w w2
  assume hat ha2 hbase hg hg4 hb hi0 hbd hbu hid hiu hgd hgu hx had hus0 hw20 hred hpt
  have hus := rewrite(had, hus0)
  have hw2 := rewrite(had, hw20)
  let A := bits_add(64, iv, bv)
  have ab: A in bits(64) by simp()
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "vm", fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), A, 1, x))), empty) proof
    fix m o
    assume hi hr hh hrs hmm ho
    have ip := apply(tr.inv_parts, hi)
    have mM: m in x86_64_linux.Machine by taut(ip)
    have rb := apply(tr.regs_get, {m}, {rs}, {b}, {nb}, {bv}, hrs, hbd, hbu)
    have ri := apply(tr.regs_get, {m}, {rs}, {i}, {8}, {iv}, hrs, hid, hiu)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {n}, {u}, hrs, hgd, hgu)
    have tb := apply(x86i.reg_typed, mM, hb)
    have ti := apply(x86i.reg_typed, mM, hi0)
    have ea: x86i.bi_ea(m, b, i) = A by simp(rb, ri, tb, ti)
    have wa := apply(tr.store_acc, {s}, {m}, {w}, {v}, {A}, {1}, hmm, ab, simp(), simp(), hus)
    have wa2 := rewrite(sym(ea), wa)
