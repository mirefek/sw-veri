// sub r32, r32 (29 /r: g := g - h, h's low 32 bits)
theorem tr.sub32_rr(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g h u nh x r hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(50, pair(4, pair(h, pair(tag(0, g), pair(tag(0, g), tag(0, h))))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> h in x86_64_linux.Reg -> g in dom(rs) -> app(rs, g) = pair(4, u) -> h in dom(rs) -> app(rs, h) = pair(nh, x) ->
  r = bits_sub(32, u, bits_of_int(32, x)) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs, g, pair(4, r)), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g h u nh x r hs ds rs p w
  assume hat ha2 hg hh hd hu hdh hx hr hpt0
  have hpt := rewrite(hr, hpt0)
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bits_sub(32, u, bits_of_int(32, x)))), empty)) proof
    fix m o
    assume hi hr hh0 hrs ho
    have ip := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {4}, {u}, hrs, hd, hu)
    have rh := apply(tr.regs_get, {m}, {rs}, {h}, {nh}, {x}, hrs, hdh, hx)
    have xr: app(app(m, "gpr"), h) = x by taut(rh)
    have xb := mp(mp(all_elim(x86i.reg_typed, {m}, {h}), taut(ip)), hh)
    have xo: x in omega by simp(rewrite(xr, xb))
    have sl: bits_slice(x, 31, 0) = bits_of_int(32, x) by defs(simp(xo), bits_slice, bits_of_int)
    have hx2 := mp(mp(mp(all_elim(hat, {m}, {o}), ho), taut(ip)), hr)
    obtain f, hf from apply(x86i.sub32_rr, {m}, {o}, {g}, {h}, {len}, taut(ip), taut(ip), gR, hh, hx2)
    show by ex_intro({f}, simp(hf, rg, xr, sl, hr, ha2, keep(x86i.flags_ok)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_sub(32, u, bits_of_int(32, x)) in bits(int_mul(8, 4)) && bits_sub(32, u, bits_of_int(32, x)) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {bits_sub(32, u, bits_of_int(32, x))}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// (h holding 32 bits: its value itself)
theorem tr.sub32_rr4(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g h u x r hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(50, pair(4, pair(h, pair(tag(0, g), pair(tag(0, g), tag(0, h))))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> h in x86_64_linux.Reg -> g in dom(rs) -> app(rs, g) = pair(4, u) -> h in dom(rs) -> app(rs, h) = pair(4, x) ->
  r = bits_sub(32, u, x) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs, g, pair(4, r)), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g h u x r hs ds rs p w
  assume hat ha2 hg hh hd hu hdh hx hr hpt0
  have hpt := rewrite(hr, hpt0)
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bits_sub(32, u, x))), empty)) proof
    fix m o
    assume hi hr hh0 hrs ho
    have ip := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {4}, {u}, hrs, hd, hu)
    have rh := apply(tr.regs_get, {m}, {rs}, {h}, {4}, {x}, hrs, hdh, hx)
    have xr x32 := rh
    have sl: bits_slice(x, 31, 0) = x by defs(simp(x32), bits_slice, bits_of_int)
    have hx2 := mp(mp(mp(all_elim(hat, {m}, {o}), ho), taut(ip)), hr)
    obtain f, hf from apply(x86i.sub32_rr, {m}, {o}, {g}, {h}, {len}, taut(ip), taut(ip), gR, hh, hx2)
    show by ex_intro({f}, simp(hf, rg, xr, sl, hr, ha2, keep(x86i.flags_ok)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_sub(32, u, x) in bits(int_mul(8, 4)) && bits_sub(32, u, x) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {bits_sub(32, u, x)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed


theorem tr.sub64_rr(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g h u x r hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(50, pair(8, pair(h, pair(tag(0, g), pair(tag(0, g), tag(0, h))))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> h in x86_64_linux.Reg -> g in dom(rs) -> app(rs, g) = pair(8, u) -> h in dom(rs) -> app(rs, h) = pair(8, x) ->
