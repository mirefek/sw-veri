    show by simp(e, ea, rg, sl, hr, ha2)
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.store_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {bv}, {4}, {u}, {hs}, {ds}, {rs}, {p}, {p2}, {w}, {w2}, he, hbase, a2b, bb, simp(), simp(), hus, hw2, hred, hpt)
qed

// the return of a procedure without a result: rax:rdx anything
theorem tr.ret_void(zb. bkp, zb pb wb. bka): all s v base code a len hs fd rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a -> runs(x86_64_linux.exec_body(len, tag(122, empty)), m, o)) ->
  (w in univ(1) -> (all y1 y2. y1 in bits(64) -> y2 in bits(64) -> runs(p, w, ok(w, pair(y1, y2))))) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, 0, a, hs, fd, rs, p, w)
proof
  fix s v base code a len hs fd rs p w
  assume hat hsp
  have g: all m. tr.inv(s, base, code, 0, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, fd) -> tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m) proof
    fix m
    assume hi hr hhs hrs hmm hfr
    have i := expand(hi, tr.inv)
    have mM: m in x86_64_linux.Machine by simp(i, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access))
    have mu: m in univ(1) by simp(i, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access))
    have sM: s in x86_64_linux.Machine by simp(i, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access))
    have cd: abi.code_at(app(m, "vm"), base, code) by simp(i, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access))
    have ca: x86_64_linux.can_access(app(s, "vm"), app(app(s, "gpr"), 4), 1) by simp(i, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access))
    have al: int_mod(bits_add(64, app(app(s, "gpr"), 4), 8), 16) = 0 by simp(i, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access))
    have rspm := apply(tr.inv0_rsp, hi)
    have kpt: tr.kept(app(s, "vm"), app(m, "vm"), app(app(s, "gpr"), 4)) by simp(i, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access, tr.kept))
    have rest: x86_64_linux.le(app(app(m, "vm"), "bytes"), app(app(s, "gpr"), 4), 8) = abi.ret(s) && abi.callee_saved(m, s) && app(m, "cpu") = app(s, "cpu") && app(m, "gs_base") = app(s, "gs_base") &&
      app(m, "os") = app(w, "os") && app(m, "fs_base") = app(w, "fs_base") && !app(app(m, "flags"), "df") && w in abi.World && w in univ(1)
      by simp(i, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access))
    have r4 := apply(x86i.rsp_typed, sM)
    // (the return address's 8 bytes: readable)
    have ra := apply(abi.ret_access, {app(s, "vm")}, {app(app(s, "gpr"), 4)}, r4, ca, al)
    have acc: all j. j in omega -> int_lt(j, 8) -> x86_64_linux.can_access(app(m, "vm"), bits_add(64, app(app(m, "gpr"), 4), bits_of_int(64, j)), 0) proof
      fix j
      assume j1 j2
      have c1 := mp(mp(all_elim(ra, {j}), j1), j2)
      have hlt4: int_lt(app(app(s, "gpr"), 4), 140737488355328) by simp(i, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access))
      have jr := apply(tr.ret_range, {app(app(s, "gpr"), 4)}, {j}, r4, hlt4, j1, j2)
      have c3 := apply(tr.kept_acc, {app(s, "vm")}, {app(m, "vm")}, {app(app(s, "gpr"), 4)}, {bits_add(64, app(app(s, "gpr"), 4), bits_of_int(64, j))}, {0}, kpt,
        taut(jr), taut(jr), taut(jr), c1)
      show by simp(c3, rspm)
    qed
    let M2 := fn_update(fn_update(m, "gpr", fn_update(app(m, "gpr"), 4, bits_add(64, app(app(m, "gpr"), 4), 8))), "rip", x86_64_linux.le(app(app(m, "vm"), "bytes"), app(app(m, "gpr"), 4), 8))
    have st: all o. runs(x86_64_linux.step(), m, o) -> (ex m2. o = ok(m2, empty) && m2 = M2) proof
      fix o
      assume ho
      have hx := mp(mp(mp(all_elim(hat, {m}, {o}), ho), cd), hr)
      have e := apply(x86i.ret, {m}, {o}, {len}, mM, mu, acc, hx)
      show by ex_intro({M2}, simp(e))
    qed
    have nr := apply(tr.inv_nr, hi)
    // (at M2: the return point, the spec's result)
    have post: all m2. m2 = M2 -> tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m2) proof
      fix m2
      assume e2
      have pt := apply(x86i.parts, mM)
      have r0R: 0 in x86_64_linux.Reg by simp()
      have r0t := mp(mp(all_elim(x86i.reg_typed, {m}, {0}), mM), r0R)
      have r2R: 2 in x86_64_linux.Reg by simp()
      have r2t := mp(mp(all_elim(x86i.reg_typed, {m}, {2}), mM), r2R)
      have atr: tr.at_ret(s, M2) by simp(rest, rspm, r4)
      have lt: x86_64_linux.le(app(app(m, "vm"), "bytes"), app(app(m, "gpr"), 4), 8) in bits(64) by simp()
      have m2M: M2 in x86_64_linux.Machine by defs(simp(expand(mM, x86_64_linux.Machine), mu, pt, lt, r4, rspm), x86_64_linux.Machine)
      have wu: w in univ(1) by taut(rest)
      have sp := mp(hsp, wu)
      have rr0 := mp(all_elim(sp, {app(app(m, "gpr"), 0)}, {app(app(m, "gpr"), 2)}), r0t, r2t)
      have rr: runs(p, w, ok(w, pair(app(app(M2, "gpr"), 0), app(app(M2, "gpr"), 2)))) by simp(rr0)
      have wm := apply(tr.mem_wm, {s}, {m}, {w}, {v}, hmm)
      have wm2: abi.world_matches(app(s, "vm"), app(M2, "vm"), app(w, "vm"), v, abi.sp(s)) by simp(wm, keep(abi.world_matches))
      have e3 := mp(app_update_other[f := app(m, "gpr"), k := 4, v := bits_add(64, app(app(m, "gpr"), 4), 8), x := 3], simp())
      have e5 := mp(app_update_other[f := app(m, "gpr"), k := 4, v := bits_add(64, app(app(m, "gpr"), 4), 8), x := 5], simp())
      have e12 := mp(app_update_other[f := app(m, "gpr"), k := 4, v := bits_add(64, app(app(m, "gpr"), 4), 8), x := 12], simp())
      have e13 := mp(app_update_other[f := app(m, "gpr"), k := 4, v := bits_add(64, app(app(m, "gpr"), 4), 8), x := 13], simp())
      have e14 := mp(app_update_other[f := app(m, "gpr"), k := 4, v := bits_add(64, app(app(m, "gpr"), 4), 8), x := 14], simp())
      have e15 := mp(app_update_other[f := app(m, "gpr"), k := 4, v := bits_add(64, app(app(m, "gpr"), 4), 8), x := 15], simp())
      have cs: abi.callee_saved(M2, s) by simp(rest, e3, e5, e12, e13, e14, e15)
      have oth: app(M2, "os") = app(w, "os") && app(M2, "fs_base") = app(w, "fs_base") && app(M2, "cpu") = app(s, "cpu") && app(M2, "gs_base") = app(s, "gs_base") &&
        !app(app(M2, "flags"), "df") && w in abi.World by simp(rest, keep(abi.World))
      have gu := mp(app_univ[u := 1, f := m, k := "gpr"], mu)
      have m2u: M2 in univ(1) by simp(mu, gu, lt, r4)
      have ew: ex w2. runs(p, w, ok(w2, pair(app(app(M2, "gpr"), 0), app(app(M2, "gpr"), 2)))) && w2 in abi.World && w2 in univ(1) &&
          abi.world_matches(app(s, "vm"), app(M2, "vm"), app(w2, "vm"), v, abi.sp(s)) && app(M2, "os") = app(w2, "os") && app(M2, "fs_base") = app(w2, "fs_base")
        by ex_intro({w}, taut(rr, rest, wu, wm2, oth))
      have rk: tr.retok(s, v, p, w, M2) by defs(taut(m2M, m2u, ew, oth, atr, cs), tr.retok)
      have ou: tr.out(s, M2) by simp(atr)
      have c := apply(tr.cl_ret[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {p}, {w}, {M2}, ou, rk)
      show := rewrite(sym(e2), c)
    qed
    show := mp(mp(mp(tr.step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb), s := s, v := v, p := p, w := w, m := m, q := x. x = M2], st), nr), post)
  qed
  show by defs(g, tr.lv)
qed

// the wrapper's return without a result: (any, any)
theorem tr.result_void: all w. w in univ(1) -> (all y1 y2. y1 in bits(64) -> y2 in bits(64) ->
  runs(mkprog(x1 x2. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. x2 = ok(x1, pair(x5, x6))))), w, ok(w, pair(y1, y2))))
proof
  fix w
  assume hw
  fix y1 y2
  assume h1 h2
  have e2: ex x6. x6 in bits(64) && ok(w, pair(y1, y2)) = ok(w, pair(y1, x6)) by ex_intro({y2}, simp(h2))
  have i2: any_rel(x6. x6 in bits(64), x6. ok(w, pair(y1, y2)) = ok(w, pair(y1, x6))) by defs(taut(e2), any_rel)
  have e1: ex x5. x5 in bits(64) && any_rel(x6. x6 in bits(64), x6. ok(w, pair(y1, y2)) = ok(w, pair(x5, x6))) by ex_intro({y1}, taut(h1, i2))
  have k: any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. ok(w, pair(y1, y2)) = ok(w, pair(x5, x6)))) by defs(taut(expand(e1, any_rel)), any_rel)
  have pu: pair(w, ok(w, pair(y1, y2))) in univ(1) by simp(hw, h1, h2)
  show := mp(mp(all_elim(tr.runs_intro[r := x1 x2. any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. x2 = ok(x1, pair(x5, x6))))], {w}, {ok(w, pair(y1, y2))}), pu), k)
qed

// the entry of a function without arguments (no prologue: the claim at f
// itself, the world s's with the callers' stack objects v), its procedure
// q, its return kw: the claim for every entry gives abi.matches
theorem tr.entry0(lb, lc, base, code, statics, f, fd, q, x3 x4 x2. kw): base in omega ->
  (all vm. abi.loaded(vm, lb, lc, statics) -> abi.code_at(vm, base, code)) ->
  (all args v mem s. args in abi.ARGS -> v in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> abi.loaded(app(s, "vm"), lb, lc, statics) -> abi.view(s, v, mem) in univ(1) ->
    tr.pt(s, zb. false, zb pb wb. false, v, base, code, 0, f, empty, fd, empty, mkprog(x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), abi.view(s, v, mem))) ->
  (all args v mem s o. args in abi.ARGS -> v in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(app(s, "vm"), lb, lc, statics) -> app(s, "rip") = f ->
    abi.entry_ok(s, args) -> tr.objs_ok(s, v) -> abi.view_ok(s, v, mem) -> tr.run_d(s, s, o) ->
    tr.matches_t(fn_build(abi.ARGS, x0. mkprog(x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))), args, v, mem, s, o))
proof
  assume hbase hsub hbody
  fix args v mem s o
  assume hA hvo hmv hM hsu hl hrip he hob hvw hr
  let W := abi.view(s, v, mem)
  let SPEC := fn_build(abi.ARGS, x0. mkprog(x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))))
  let BIND := mkprog(x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))
  have hc := mp(all_elim(hsub, {app(s, "vm")}), hl)
  have su := hsu
  have ent := apply(abi.entry_stack, hM, he)
  have hdf: !app(app(s, "flags"), "df") by taut(expand(he, abi.entry_ok))
  have r4 := apply(x86i.rsp_typed, hM)
  have ou := apply(abi.objs_univ, hvo)
  have mu := apply(x86.vm_univ, hmv)
  have hvu: W in univ(1) by simp(su, ou, mu)
  have wt := apply(abi.world_typed, hM, hvo, hmv, hvu)
  have body := mp(all_elim(hbody, {args}, {v}, {mem}, {s}), hA, hvo, hmv, hM, hl, hvu)
  have z0: int_sub(app(app(s, "gpr"), 4), 0) = app(app(s, "gpr"), 4) by arith(r4)
  have inv: tr.inv(s, base, code, 0, s, W) by defs(simp(subset_refl[s := app(app(s, "os"), "events")], hvw.1, apply(abi.entry_gap, he), apply(abi.entry_rsv, he), all_elim(tr.keeps_refl, {app(s, "vm")}), all_elim(tr.kept_refl, {app(s, "vm")}, {app(app(s, "gpr"), 4)}), z0, hM, su, hc, hdf, wt, hvu, ent, keep(x86_64_linux.Machine, abi.World, abi.code_at, abi.stack_page, x86_64_linux.can_access)), tr.inv)
  have hh: tr.homes(s, s, empty) by defs(simp(dom_empty), tr.homes)
  have rr: tr.regs(s, empty) by defs(simp(dom_empty), tr.regs)
  have mm := apply(tr.mem_entry, hob, hvw)
  have fe := all_elim(tr.frame_entry, {s}, {fd})
  have lt0 := apply(tr.sp_lt, {app(app(s, "gpr"), 4)}, r4, ent.4)
  have ns0: !tr.stopk(s, zb. false, s) by defs(taut(lt0), tr.stopk)
  have c0 := mp(all_elim(expand(body, tr.pt), {s}), inv, hrip, hh, rr, mm, fe)
  have sim := mp(expand(c0, tr.cl).2, ns0)
  have ae: app(SPEC, args) = BIND by simp(hA)
  have r0: all o2. runs(BIND, W, o2) -> runs(app(SPEC, args), W, o2) proof
    fix o2
    assume h
    show := rewrite(sym(ae), h)
  qed
  have red: tr.red(app(SPEC, args), W, BIND, W) by defs(r0, tr.red)
  have sim2 := apply(tr.sim_red[bkp := zb. false, bka := zb pb wb. false], red, sim)
  show := apply(tr.entry_d, {SPEC}, {args}, {s}, {v}, {mem}, {o}, hM, ent.4, sim2, hr)
qed

// (the registers forgotten: a weaker claim)
theorem tr.pt_rs(zb. bkp, zb pb wb. bka): all s v base code fr a hs ds rs p w. tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, empty, p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a hs ds rs p w
  assume h
  have g: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, ds) -> tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m) proof
    fix m
    assume hi hr hh hrs hmm hfr
    have re: tr.regs(m, empty) by defs(simp(dom_empty), tr.regs)
    show := mp(all_elim(expand(h, tr.pt), {m}), hi, hr, hh, re, hmm, hfr)
  qed
  show by defs(g, tr.lv)
qed

// (fewer homes, each the same: a weaker claim -- a join's, on the homes its
// paths share, at a path with more)
def tr.hsub(hs1, hs) := all k. k in dom(hs1) -> k in dom(hs) && app(hs1, k) = app(hs, k)

theorem tr.hsub_empty: all hs. tr.hsub(empty, hs)
proof
  fix hs
  have g: all k. k in dom(empty) -> k in dom(hs) && app(empty, k) = app(hs, k) by simp(dom_empty)
  show by defs(g, tr.hsub)
qed

theorem tr.hsub_upd: all hs f k v. tr.hsub(f, hs) -> k in dom(hs) -> app(hs, k) = v -> tr.hsub(fn_update(f, k, v), hs)
proof
  fix hs f k v
  assume h hk he
  have g: all j. j in dom(fn_update(f, k, v)) -> j in dom(hs) && app(fn_update(f, k, v), j) = app(hs, j) proof
    fix j
    assume hj
    have cs := apply(tr.dom_cases, {f}, {k}, {v}, {j}, hj)
    have same: j = k -> j in dom(hs) && app(fn_update(f, k, v), j) = app(hs, j) proof
      assume e
      have g0: k in dom(hs) && app(fn_update(f, k, v), k) = app(hs, k) by simp(hk, he)
      show := subst({y. y in dom(hs) && app(fn_update(f, k, v), y) = app(hs, y)}, sym(e), g0)
    qed
    have other: !(j = k) -> j in dom(hs) && app(fn_update(f, k, v), j) = app(hs, j) proof
      assume ne
      have jd: j in dom(f) by taut(cs, ne)
      have k0 := mp(all_elim(expand(h, tr.hsub), {j}), jd)
      have e1 := mp(app_update_other[f := f, k := k, v := v, x := j], ne)
      show by simp(k0, e1)
    qed
    show by taut(same, other)
  qed
  show by defs(g, tr.hsub)
qed

theorem tr.pt_hs(zb. bkp, zb pb wb. bka): all s v base code fr a hs1 hs ds rs p w. tr.hsub(hs1, hs) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs1, ds, rs, p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a hs1 hs ds rs p w
  assume hsb h
  have g: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, ds) -> tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m) proof
    fix m
    assume hi hr hh hrs hmm hfr
    have h1: all c. c in dom(hs1) -> x86_64_linux.le(app(app(m, "vm"), "bytes"), bits_add(64, int_add(app(app(s, "gpr"), 4), c), 0), fst(app(hs1, c))) = snd(app(hs1, c)) &&
        tr.hrange(c, fst(app(hs1, c))) && tr.hacc(s, app(m, "vm"), c, fst(app(hs1, c))) proof
      fix c
      assume hc
      have sb := mp(all_elim(expand(hsb, tr.hsub), {c}), hc)
      have hc0 := mp(all_elim(expand(hh, tr.homes), {c}), sb.1)
      show by simp(hc0, sb.2)
    qed
    have hh1: tr.homes(s, m, hs1) by defs(h1, tr.homes)
    show := mp(all_elim(expand(h, tr.pt), {m}), hi, hr, hh1, hrs, hmm, hfr)
  qed
  show by defs(g, tr.lv)
qed

// a register holding n bytes holds k >= n bytes (a byte as a 32-bit word)
theorem tr.regs_widen: all m rs g n k u. tr.regs(m, rs) -> g in dom(rs) -> app(rs, g) = pair(n, u) -> u in bits(int_mul(8, k)) ->
  tr.regs(m, fn_update(rs, g, pair(k, u)))
proof
  fix m rs g n k u
  assume h hd hu hk
  have fr r := expand(h, tr.regs)
  have rg := apply(tr.regs_get, {m}, {rs}, {g}, {n}, {u}, h, hd, hu)
  have du := mp(dom_update[f := rs, k := g, v := pair(k, u)], fr)
  have fu := mp(fn_update_fun[f := rs, k := g, v := pair(k, u)], fr)
  have c: all r0. r0 in dom(fn_update(rs, g, pair(k, u))) -> app(app(m, "gpr"), r0) = snd(app(fn_update(rs, g, pair(k, u)), r0)) &&
      snd(app(fn_update(rs, g, pair(k, u)), r0)) in bits(int_mul(8, fst(app(fn_update(rs, g, pair(k, u)), r0)))) proof
    fix r0
    assume hd0
    have same: r0 = g -> app(app(m, "gpr"), r0) = snd(app(fn_update(rs, g, pair(k, u)), r0)) &&
        snd(app(fn_update(rs, g, pair(k, u)), r0)) in bits(int_mul(8, fst(app(fn_update(rs, g, pair(k, u)), r0)))) by simp(rg, hk)
    have other: !(r0 = g) -> app(app(m, "gpr"), r0) = snd(app(fn_update(rs, g, pair(k, u)), r0)) &&
        snd(app(fn_update(rs, g, pair(k, u)), r0)) in bits(int_mul(8, fst(app(fn_update(rs, g, pair(k, u)), r0)))) proof
      assume ne
      have e2 := mp(app_update_other[f := rs, k := g, v := pair(k, u), x := r0], ne)
      have hd2 := rewrite(du, hd0)
      have d0: r0 in dom(rs) by simp(hd2, ne)
      have c0 := mp(all_elim(r, {r0}), d0)
      show by simp(e2, c0)
    qed
    show by taut(same, other)
  qed
  show by defs(taut(fu, c), tr.regs)
qed

theorem tr.pt_widen(zb. bkp, zb pb wb. bka): all s v base code fr a hs ds rs p w g n k u. g in dom(rs) -> app(rs, g) = pair(n, u) -> n in omega -> k in omega -> int_le(n, k) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, fn_update(rs, g, pair(k, u)), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a hs ds rs p w g n k u
  assume hd hu hn hk hle h
  have pl := mp(pow2_le[a := int_mul(8, n), b := int_mul(8, k)], arith(hn), arith(hk), arith(hn, hk, hle))
  have c: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, ds) -> tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m) proof
    fix m
    assume hi hr hh hrs hmm hfr
    have rg u8 := apply(tr.regs_get, {m}, {rs}, {g}, {n}, {u}, hrs, hd, hu)
    have uk: u in bits(int_mul(8, k)) by arith(u8, pl, hn, hk)
    have re := apply(tr.regs_widen, {m}, {rs}, {g}, {n}, {k}, {u}, hrs, hd, hu, uk)
    show := mp(all_elim(expand(h, tr.pt), {m}), hi, hr, hh, re, hmm, hfr)
  qed
  show by defs(c, tr.lv)
qed

// ----------------------------------------------------------------------
//  The spec's rest across a change of its world (a store)

// a helper's single operation changing the world (no result)
theorem tr.call1w_ok(op, r): all w w2. w in univ(1) -> w2 in univ(1) -> runs(op, w, ok(w2, r)) ->
  runs(mkprog(x0 x1. bind_rel(op, x0, x2 x3. x1 = ok(x2, empty), x2 x3. x1 = exc(x2, x3), x2. x1 = diverge(x2))), w, ok(w2, empty))
proof
  fix w w2
  assume hw hw2 hq
  have b: bind_rel(op, w, x2 x3. ok(w2, empty) = ok(x2, empty), x2 x3. ok(w2, empty) = exc(x2, x3), x2. ok(w2, empty) = diverge(x2))
    by defs(ex_intro({ok(w2, r)}, simp(hq, keep(runs))), bind_rel)
  have pu: pair(w, ok(w2, empty)) in univ(1) by simp(hw, hw2)
  show := mp(all_elim(tr.runs_intro[r := x0 x1. bind_rel(op, x0, x2 x3. x1 = ok(x2, empty), x2 x3. x1 = exc(x2, x3), x2. x1 = diverge(x2))], {w}, {ok(w2, empty)}), pu, b)
qed

// an operation at the rest's head ending ok in the world w2: the rest after
// it, from w2
theorem tr.qs_opw(op, r, x9 x10 x8. a, x9 x10 x8. xx, x9 x8. dd, x8 x1. k): all w w2. w in univ(1) -> runs(op, w, ok(w2, r)) ->
  (all o. runs(mkprog(x0 x1. ex x8. a(x0, r, x8) && k(x8, x1)), w2, o) ->
    runs(mkprog(x0 x1. ex x8. bind_rel(op, x0, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, x1)), w, o))
proof
  fix w w2
  assume hw hq
  fix o
  assume hr
  have hu: pair(w2, o) in univ(1) && (ex x8. a(w2, r, x8) && k(x8, o)) by simp(expand(expand(hr, runs), mkprog))
  have ou: o in univ(1) by simp(hu)
  have h: ex x8. a(w2, r, x8) && k(x8, o) by taut(hu)
  obtain y, hy from h
  have ay: a(w2, r, y) by taut(hy)
  have e: ex o2. runs(op, w, o2) && ((ex s1 v. o2 = ok(s1, v) && a(s1, v, y)) || (ex s1 e. o2 = exc(s1, e) && xx(s1, e, y)) || (ex t. o2 = diverge(t) && dd(t, y)))
    by ex_intro({ok(w2, r)}, simp(hq, ay))
  have b: bind_rel(op, w, x9 x10. a(x9, x10, y), x9 x10. xx(x9, x10, y), x9. dd(x9, y)) by defs(e, bind_rel)
  have ex8: ex x8. bind_rel(op, w, x9 x10. a(x9, x10, x8), x9 x10. xx(x9, x10, x8), x9. dd(x9, x8)) && k(x8, o) by ex_intro({y}, taut(b, hy))
  have pu: pair(w, o) in univ(1) by simp(hw, ou)
  show by defs(simp(pu, ex8), runs, mkprog)
qed

// the point's program, the wrapper around the rest: across the world's change
theorem tr.wredw(w, w2, q, q2, x3 x4 x2. kw): w in univ(1) -> (all o. runs(q2, w2, o) -> runs(q, w, o)) ->
  tr.red(mkprog(x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w,
    mkprog(x1 x2. bind_rel(q2, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w2)
proof
  assume hw hq
  have g: all o. runs(mkprog(x1 x2. bind_rel(q2, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w2, o) ->
      runs(mkprog(x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, o) proof
    fix o
    assume hr
    have hu: pair(w2, o) in univ(1) && bind_rel(q2, w2, x3 x4. kw(x3, x4, o), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) by simp(expand(expand(hr, runs), mkprog))
    have ou: o in univ(1) by simp(hu)
    have hb2: bind_rel(q2, w2, x3 x4. kw(x3, x4, o), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) by taut(hu)
    have b2 := expand(hb2, bind_rel)
    obtain o2, h2 from b2
    have r1 := mp(all_elim(hq, {o2}), taut(h2))
    have b: bind_rel(q, w, x3 x4. kw(x3, x4, o), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) by defs(ex_intro({o2}, taut(r1, h2)), bind_rel)
    have pu: pair(w, o) in univ(1) by simp(hw, ou)
    show by defs(simp(pu, b), runs, mkprog)
  qed
  show by defs(g, tr.red)
qed

// ----------------------------------------------------------------------
//  GIMPLE's byte load and store at p + off, the address a computed

theorem tr.ld8_at_ok: all w p off a. w in univ(1) -> p in bits(64) -> off in bits(32) -> a = int_add(p, off) -> g.mem_defined(w, p, off, 1, false) ->
  runs(gimple.ld8(p, off), w, ok(w, bits_of_int(8, gimple.bytes_at(app(w, "vm"), a, 1))))
proof
  fix w p off a
  assume hw hp ho ha hd
  have r := apply(g.ld8_at_ok, {w}, {p}, {off}, hw, hp, ho, hd)
  show := rewrite(sym(ha), r)
qed

theorem tr.st8_at_ok: all w p off v a. w in abi.World -> w in univ(1) -> p in bits(64) -> off in bits(32) -> v in bits(8) -> a = int_add(p, off) ->
  g.mem_defined(w, p, off, 1, true) ->
  runs(gimple.st8(p, off, v), w, ok(fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), a, 1, v))), empty))
proof
  fix w p off v a
  assume hW hw hp ho hv ha hd
  have wf := expand(hW, abi.World)
  have vV: app(w, "vm") in x86_64_linux.Vm by simp(wf)
  have fw: is_fun(w) by simp(wf)
  have dw: "vm" in dom(w) by simp(wf)
  have r := apply(g.st8_at_ok, {w}, {p}, {off}, {v}, hw, hp, ho, hv, hd, vV, fw, dw)
  show := rewrite(sym(ha), r)
qed

// (a 4-byte store at p + off: as st8's)
theorem g.st32_at_ok: all s p off v. s in univ(1) -> p in bits(64) -> off in bits(32) -> v in bits(32) -> g.mem_defined(s, p, off, 4, true) ->
  app(s, "vm") in x86_64_linux.Vm -> is_fun(s) -> "vm" in dom(s) ->
  runs(gimple.st32(p, off, v), s, ok(fn_update(s, "vm", fn_update(app(s, "vm"), "bytes", x86_64_linux.store_le(app(app(s, "vm"), "bytes"), int_add(p, off), 4, v))), empty))
proof
  fix s p off v
  assume hs hp ho hv hdf hvm hf hd
  have m := apply(g.mem_at_ok, {s}, {p}, {off}, {4}, {true}, hs, hp, ho, hdf)
  have ab: int_add(p, off) in bits(64) by simp(hdf, hp, ho)
  have w := apply(g.write4_ok, {s}, {int_add(p, off)}, {v}, hs, ab, simp(hv), hvm, hf, hd)
  have stu := apply(fn_space_univ, bits_univ[n := 64], bits_univ[n := 8], apply(x86.store_typed, {app(app(s, "vm"), "bytes")}, {int_add(p, off)}, {4}, {v}, simp(hvm)))
  show by defs(simp(hs, m, w, stu, keep(gimple.mem, gimple.write_bytes)), gimple.st32)
qed

theorem g.st32_at_ub: all s p off v s2 e. s in univ(1) -> s2 in univ(1) -> e in univ(1) -> p in bits(64) -> off in bits(32) -> !g.mem_defined(s, p, off, 4, true) ->
  runs(gimple.st32(p, off, v), s, exc(s2, e))
proof
  fix s p off v s2 e
  assume hs h2 he hp ho hn
  have mu := apply(g.mem_at_ub, {s}, {p}, {off}, {4}, {true}, {s2}, {e}, hs, h2, he, hp, ho, hn)
  show by defs(simp(hs, h2, he, mu, keep(gimple.mem, gimple.write_bytes)), gimple.st32)
qed

theorem tr.bd_int: all p off. p in bits(64) -> off in bits(32) -> int_lt(int_add(p, off), pow2(64)) -> int_add(p, off) = bits_add(64, p, off)
proof
  fix p off
  assume hp ho hl
  have p64: pow2(64) = 18446744073709551616 by simp()
  have lt := rewrite(p64, hl)
  have bdef: bits_add(64, p, off) = int_mod(int_add(p, off), 18446744073709551616) by defs(simp(), bits_add)
  show by arith(bdef, hp, ho, lt)
qed

theorem tr.st32_at_ok: all w p off v a. w in abi.World -> w in univ(1) -> p in bits(64) -> off in bits(32) -> v in bits(32) -> (a = int_add(p, off) || a = bits_add(64, p, off)) ->
  g.mem_defined(w, p, off, 4, true) ->
  runs(gimple.st32(p, off, v), w, ok(fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), a, 4, v))), empty))
proof
  fix w p off v a
  assume hW hw hp ho hv ha hd
  have wf := expand(hW, abi.World)
  have vV: app(w, "vm") in x86_64_linux.Vm by simp(wf)
  have fw: is_fun(w) by simp(wf)
  have dw: "vm" in dom(w) by simp(wf)
  have r := apply(g.st32_at_ok, {w}, {p}, {off}, {v}, hw, hp, ho, hv, hd, vV, fw, dw)
  have ev := apply(tr.bd_int, {p}, {off}, hp, ho, taut(hd))
  have ha2: a = int_add(p, off) by simp(rewrite(sym(ev), ha))
  show := rewrite(sym(ha2), r)
qed


// (a 2-byte store at p + off: n bytes written)
theorem g.st16_at_ok: all s p off v. s in univ(1) -> p in bits(64) -> off in bits(32) -> v in bits(16) -> g.mem_defined(s, p, off, 2, true) ->
  app(s, "vm") in x86_64_linux.Vm -> is_fun(s) -> "vm" in dom(s) ->
  runs(gimple.st16(p, off, v), s, ok(fn_update(s, "vm", fn_update(app(s, "vm"), "bytes", x86_64_linux.store_le(app(app(s, "vm"), "bytes"), int_add(p, off), 2, v))), empty))
