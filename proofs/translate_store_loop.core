  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {8}, {bits_sub(64, u, x)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

// add r32, r32 / r64, r64 (g := g + h; of 64 bits, r the sum as the spec
// orders it)
theorem tr.add32_rr(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g h u x r hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(35, pair(4, pair(h, pair(tag(0, g), pair(tag(0, g), tag(0, h))))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> h in x86_64_linux.Reg -> g in dom(rs) -> app(rs, g) = pair(4, u) -> h in dom(rs) -> app(rs, h) = pair(4, x) -> r = bits_add(32, u, x) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs, g, pair(4, r)), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g h u x r hs ds rs p w
  assume hat ha2 hg hh hd hu hdh hx hr0 hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, r)), empty)) proof
    fix m o
    assume hi hr hh0 hrs ho
    have ip := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {4}, {u}, hrs, hd, hu)
    have rh := apply(tr.regs_get, {m}, {rs}, {h}, {4}, {x}, hrs, hdh, hx)
    have xr x32 := rh
    have sl: bits_slice(x, 31, 0) = x by defs(simp(x32), bits_slice, bits_of_int)
    have hx2 := mp(mp(mp(all_elim(hat, {m}, {o}), ho), taut(ip)), hr)
    obtain f, hf from apply(x86i.add32_rr, {m}, {o}, {g}, {h}, {len}, taut(ip), taut(ip), gR, hh, hx2)
    show by ex_intro({f}, simp(hf, rg, xr, sl, hr, ha2, hr0, keep(x86i.flags_ok)))
  qed
  have t0: bits_add(32, u, x) in bits(int_mul(8, 4)) && bits_add(32, u, x) in bits(64) by simp()
  have t1: r in bits(int_mul(8, 4)) && r in bits(64) := rewrite(sym(hr0), t0)
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      r in bits(int_mul(8, 4)) && r in bits(64) proof
    fix m
    show by taut(t1)
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {r}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed


// and r32, r32 (g := g & h; r the result as the spec orders it)
theorem tr.and32_rr(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g h u x r hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(47, pair(4, pair(h, pair(tag(0, g), pair(tag(0, g), tag(0, h))))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> h in x86_64_linux.Reg -> g in dom(rs) -> app(rs, g) = pair(4, u) -> h in dom(rs) -> app(rs, h) = pair(4, x) -> r = bits_and(32, u, x) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs, g, pair(4, r)), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g h u x r hs ds rs p w
  assume hat ha2 hg hh hd hu hdh hx hr0 hpt
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, r)), empty)) proof
    fix m o
    assume hi hr hh0 hrs ho
    have ip := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {4}, {u}, hrs, hd, hu)
    have rh := apply(tr.regs_get, {m}, {rs}, {h}, {4}, {x}, hrs, hdh, hx)
    have xr x32 := rh
    have sl: bits_slice(x, 31, 0) = x by defs(simp(x32), bits_slice, bits_of_int)
    have hx2 := mp(mp(mp(all_elim(hat, {m}, {o}), ho), taut(ip)), hr)
    obtain f, hf from apply(x86i.and32_rr, {m}, {o}, {g}, {h}, {len}, taut(ip), taut(ip), gR, hh, hx2)
    show by ex_intro({f}, simp(hf, rg, xr, sl, hr0, hr, ha2, keep(x86i.flags_ok)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      r in bits(int_mul(8, 4)) && r in bits(64) proof
    fix m
    have i32 := mp(bits_and_in[n := 32, x := u, y := x], simp())
    show by simp(hr0, i32, keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {r}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed

