  show by defs(simp(hs, m, w, stu, keep(gimple.mem, gimple.write_bytes)), gimple.st16)
qed

theorem g.st16_at_ub: all s p off v s2 e. s in univ(1) -> s2 in univ(1) -> e in univ(1) -> p in bits(64) -> off in bits(32) -> !g.mem_defined(s, p, off, 2, true) ->
  runs(gimple.st16(p, off, v), s, exc(s2, e))
proof
  fix s p off v s2 e
  assume hs h2 he hp ho hn
  have mu := apply(g.mem_at_ub, {s}, {p}, {off}, {2}, {true}, {s2}, {e}, hs, h2, he, hp, ho, hn)
  show by defs(simp(hs, h2, he, mu, keep(gimple.mem, gimple.write_bytes)), gimple.st16)
qed

theorem tr.st16_at_ok: all w p off v a. w in abi.World -> w in univ(1) -> p in bits(64) -> off in bits(32) -> v in bits(16) -> a = int_add(p, off) ->
  g.mem_defined(w, p, off, 2, true) ->
  runs(gimple.st16(p, off, v), w, ok(fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), a, 2, v))), empty))
proof
  fix w p off v a
  assume hW hw hp ho hv ha hd
  have wf := expand(hW, abi.World)
  have vV: app(w, "vm") in x86_64_linux.Vm by simp(wf)
  have fw: is_fun(w) by simp(wf)
  have dw: "vm" in dom(w) by simp(wf)
  have r := apply(g.st16_at_ok, {w}, {p}, {off}, {v}, hw, hp, ho, hv, hd, vV, fw, dw)
  show := rewrite(sym(ha), r)
qed

// mov [b], r16 (66 89 /r; b holding bv, g holding u: the spec's 2-byte store
// of u's low word x at bv)
theorem tr.store16_b(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g b z1 z2 bv n u x hs ds rs p p2 w w2.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(75, pair(2, pair(g, pair(x86i.bd_mem(b, 0), pair(z1, z2)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> base in omega -> g in x86_64_linux.Reg -> b in x86_64_linux.Reg ->
  b in dom(rs) -> app(rs, b) = pair(8, bv) -> bv in bits(64) -> g in dom(rs) -> app(rs, g) = pair(n, u) -> bits_slice(u, 15, 0) = x ->
  gimple.usable(app(w, "vm"), app(w, "objs"), bv, 2, true) ->
  w2 = fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), bv, 2, x))) ->
  tr.red(p, w, p2, w2) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, rs, p2, w2) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g b z1 z2 bv n u x hs ds rs p p2 w w2
  assume hat ha2 hbase hg hb hbd hbu bb hgd hgu hx hus hw2 hred hpt
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(fn_update(m, "rip", a2), "vm", fn_update(app(m, "vm"), "bytes", x86_64_linux.store_le(app(app(m, "vm"), "bytes"), bv, 2, x))), empty) proof
    fix m o
    assume hi hr hh hrs hmm ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have rb := apply(tr.regs_get, {m}, {rs}, {b}, {8}, {bv}, hrs, hbd, hbu)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {n}, {u}, hrs, hgd, hgu)
    have tb := apply(x86i.reg_typed, ipM, hb)
    have ea: x86i.bd_ea(m, b, 0) = bv by simp(rb, tb)
    have wa := apply(tr.store_acc, {s}, {m}, {w}, {v}, {bv}, {2}, hmm, bb, simp(), simp(), hus)
    have wa2 := rewrite(sym(ea), wa)
    have hx2 := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
    have e := apply(x86i.store16_bd, {m}, {o}, {g}, {b}, {0}, {z1}, {z2}, {len}, ipM, ipU, hg, hb, simp(), wa2, hx2)
    show by simp(e, ea, rg, hx, hr, ha2)
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.store_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {bv}, {2}, {x}, {hs}, {ds}, {rs}, {p}, {p2}, {w}, {w2}, he, hbase, a2b, bb, simp(), simp(), hus, hw2, hred, hpt)
qed

// (a field's address p + off, defined: no wrap)

// (an 8-byte store at p + off: as st32's, by the general write)
theorem g.st64_at_ok: all s p off v. s in univ(1) -> p in bits(64) -> off in bits(32) -> v in bits(64) -> g.mem_defined(s, p, off, 8, true) ->
  app(s, "vm") in x86_64_linux.Vm -> is_fun(s) -> "vm" in dom(s) ->
  runs(gimple.st64(p, off, v), s, ok(fn_update(s, "vm", fn_update(app(s, "vm"), "bytes", x86_64_linux.store_le(app(app(s, "vm"), "bytes"), int_add(p, off), 8, v))), empty))
proof
  fix s p off v
  assume hs hp ho hv hdf hvm hf hd
  have m := apply(g.mem_at_ok, {s}, {p}, {off}, {8}, {true}, hs, hp, ho, hdf)
  have ab: int_add(p, off) in bits(64) by simp(hdf, hp, ho)
  have w := apply(g.write_ok, {s}, {int_add(p, off)}, {8}, {v}, hs, ab, simp(), simp(), simp(hv), hvm, hf, hd)
  have stu := apply(fn_space_univ, bits_univ[n := 64], bits_univ[n := 8], apply(x86.store_typed, {app(app(s, "vm"), "bytes")}, {int_add(p, off)}, {8}, {v}, simp(hvm)))
  show by defs(simp(hs, m, w, stu, keep(gimple.mem, gimple.write_bytes)), gimple.st64)
qed

theorem g.st64_at_ub: all s p off v s2 e. s in univ(1) -> s2 in univ(1) -> e in univ(1) -> p in bits(64) -> off in bits(32) -> !g.mem_defined(s, p, off, 8, true) ->
  runs(gimple.st64(p, off, v), s, exc(s2, e))
proof
  fix s p off v s2 e
  assume hs h2 he hp ho hn
  have mu := apply(g.mem_at_ub, {s}, {p}, {off}, {8}, {true}, {s2}, {e}, hs, h2, he, hp, ho, hn)
  show by defs(simp(hs, h2, he, mu, keep(gimple.mem, gimple.write_bytes)), gimple.st64)
qed

theorem tr.st64_at_ok: all w p off v a. w in abi.World -> w in univ(1) -> p in bits(64) -> off in bits(32) -> v in bits(64) -> a = bits_add(64, p, off) ->
  g.mem_defined(w, p, off, 8, true) ->
  runs(gimple.st64(p, off, v), w, ok(fn_update(w, "vm", fn_update(app(w, "vm"), "bytes", x86_64_linux.store_le(app(app(w, "vm"), "bytes"), a, 8, v))), empty))
proof
  fix w p off v a
  assume hW hw hp ho hv ha hd
  have wf := expand(hW, abi.World)
  have vV: app(w, "vm") in x86_64_linux.Vm by simp(wf)
  have fw: is_fun(w) by simp(wf)
  have dw: "vm" in dom(w) by simp(wf)
  have r := apply(g.st64_at_ok, {w}, {p}, {off}, {v}, hw, hp, ho, hv, hd, vV, fw, dw)
  have ev := apply(tr.bd_int, {p}, {off}, hp, ho, taut(hd))
  show := rewrite(sym(ha), rewrite(ev, r))
qed

// (a map of the home d alone, or none)
theorem tr.only_empty: all d c. c in dom(empty) -> c = d
proof
  fix d c
  assume h
  have de: dom(empty) = empty by taut(dom_empty)
  have h2 := rewrite(de, h)
  show by simp(h2)
qed

theorem tr.only_upd: all d x c. c in dom(fn_update(empty, d, x)) -> c = d
proof
  fix d x c
  assume h
  have du := mp(dom_update[f := empty, k := d, v := x], taut(dom_empty))
  have h2 := rewrite(du, h)
  have de: dom(empty) = empty by taut(dom_empty)
  show by simp(rewrite(de, h2))
qed

// (the low byte of a 32-bit sum: the 8-bit sum)
theorem tr.low8_add: all a k. a in int -> k in int -> bits_slice(bits_add(32, a, k), 7, 0) = bits_add(8, a, k)
proof
  fix a k
  assume ha hk
  have e0: int_mod(int_div(int_mod(int_add(a, k), 4294967296), 1), 256) = int_mod(int_add(a, k), 256) by arith(ha, hk)
  have p0: pow2(0) = 1 by simp()
  have p8: pow2(int_sub(int_succ(7), 0)) = 256 by simp()
  have p32: pow2(32) = 4294967296 by simp()
  have p8b: pow2(8) = 256 by simp()
  show by defs(simp(e0, p0, p8, p32, p8b), bits_slice, bits_add)
qed

// (the same, the spec's constant another one alike mod 256: x + -1 in 8
// bits against the machine's 32-bit x + 0xffffffff)
theorem tr.low8_add_mod: all a k k2. a in int -> k in int -> k2 in int -> int_mod(k, 256) = int_mod(k2, 256) ->
  bits_slice(bits_add(32, a, k), 7, 0) = bits_add(8, a, k2)
proof
  fix a k k2
  assume ha hk hk2 hm
  have l := apply(tr.low8_add, {a}, {k}, ha, hk)
  have e0: int_mod(int_add(a, k), 256) = int_mod(int_add(a, k2), 256) by arith(ha, hk, hk2, hm)
  have p8: pow2(8) = 256 by simp()
  have e: bits_add(8, a, k) = bits_add(8, a, k2) by defs(rewrite(sym(p8), e0), bits_add)
  show := trans(l, e)
qed

// (a byte array's element p + i, i a counter's value in [0, K]: within
// [p, p + K + 1))
theorem tr.elem_in: all p i k. p in bits(64) -> i in bits(32) -> k in bits(32) -> int_le(0, sint(32, i)) -> !int_lt(sint(32, k), sint(32, i)) ->
  int_le(0, sint(32, k)) -> int_le(int_add(p, int_add(sint(32, k), 1)), 18446744073709551616) ->
  int_le(p, bits_add(64, p, bits_sext(32, 64, i))) && int_lt(bits_add(64, p, bits_sext(32, 64, i)), int_add(p, int_add(sint(32, k), 1)))
proof
  fix p i k
  assume hp hi hk h0 hc hk0 hr
  have si := apply(tr.sint32_int, hi)
  have sk := apply(tr.sint32_int, hk)
  have pb: int_le(0, p) && int_lt(p, 18446744073709551616) by simp(hp)
  have pi: p in int by simp(hp)
  // (i's sign-extension: i itself, sint(i) >= 0)
  have sx0: bits_sext(32, 64, i) = bits_of_int(64, sint(32, i)) by defs(simp(), bits_sext)
  have p64: pow2(64) = 18446744073709551616 by simp()
  have bo0: int_mod(sint(32, i), 18446744073709551616) = sint(32, i) by arith(si, sk, h0, hc)
  have bo: bits_of_int(64, sint(32, i)) = sint(32, i) by defs(rewrite(sym(p64), bo0), bits_of_int)
  have sx := trans(sx0, bo)
  have e0: int_mod(int_add(p, sint(32, i)), 18446744073709551616) = int_add(p, sint(32, i)) by arith(pi, si, sk, pb, h0, hc, hr)
  have ea: bits_add(64, p, sint(32, i)) = int_add(p, sint(32, i)) by defs(rewrite(sym(p64), e0), bits_add)
  have g0: int_le(p, int_add(p, sint(32, i))) && int_lt(int_add(p, sint(32, i)), int_add(p, int_add(sint(32, k), 1))) by arith(pi, si, sk, h0, hc)
  have g1 := rewrite(sym(ea), g0)
  show := rewrite(sym(sx), g1)
qed

// (an element of a byte array at an index i whose unsigned value is at most
// k < 2^31 -- a branch's bound: within [p, p + k])
theorem tr.elem_in_u: all p i k. p in bits(64) -> i in bits(32) -> int_le(i, k) -> int_lt(k, 2147483648) ->
  int_le(int_add(p, int_add(k, 1)), 18446744073709551616) ->
  int_le(p, bits_add(64, p, bits_sext(32, 64, i))) && int_lt(bits_add(64, p, bits_sext(32, 64, i)), int_add(p, int_add(k, 1)))
proof
  fix p i k
  assume hp hi hle hk hr
  have ib: int_le(0, i) && int_lt(i, 2147483648) by arith(hi, hle, hk)
  have p32: pow2(32) = 4294967296 by simp()
  have p31: pow2(int_sub(32, 1)) = 2147483648 by simp()
  have p64: pow2(64) = 18446744073709551616 by simp()
  have m32: int_mod(i, 4294967296) = i by arith(hi)
  have bi: bits_of_int(32, i) = i by defs(rewrite(sym(p32), m32), bits_of_int)
  have ilt: int_lt(i, 2147483648) by taut(ib)
  have lt := rewrite(sym(p31), ilt)
  have it := mp(ite_t[c := int_lt(i, pow2(int_sub(32, 1))), a := i, b := int_sub(i, pow2(32))], lt)
  have si: sint(32, i) = i by defs(simp(bi, it), sint)
  have m64: int_mod(i, 18446744073709551616) = i by arith(hi)
  have bo: bits_of_int(64, i) = i by defs(rewrite(sym(p64), m64), bits_of_int)
  have sx0: bits_sext(32, 64, i) = bits_of_int(64, sint(32, i)) by defs(simp(), bits_sext)
  have sx := trans(rewrite(si, sx0), bo)
  have pb: int_le(0, p) && int_lt(p, 18446744073709551616) by simp(hp)
  have e0: int_mod(int_add(p, i), 18446744073709551616) = int_add(p, i) by arith(pb, ib, hle, hr)
  have ea: bits_add(64, p, i) = int_add(p, i) by defs(rewrite(sym(p64), e0), bits_add)
  have g0: int_le(p, int_add(p, i)) && int_lt(int_add(p, i), int_add(p, int_add(k, 1))) by arith(pb, ib, hle)
  have g1 := rewrite(sym(ea), g0)
  show := rewrite(sym(sx), g1)
qed

// (an equation of a term with itself, anywhere in the rest: true)
theorem tr.qe_refl(x0 x1 y. b, x0. st): all w o. runs(mkprog(x0 x1. b(x0, x1, true)), w, o) -> runs(mkprog(x0 x1. b(x0, x1, st(x0) = st(x0))), w, o)
proof
  fix w
  have r: st(w) = st(w) := refl({st(w)})
  have t: true by simp()
  have e: (st(w) = st(w)) = true by simp(r)
  have g: all o. b(w, o, true) -> b(w, o, st(w) = st(w)) proof
    fix o
    assume h
    show := subst({y. b(w, o, y)}, sym(e), h)
  qed
  show := mp(tr.mkprog_mono[s := w, r1 := x0 x1. b(x0, x1, st(x0) = st(x0)), r2 := x0 x1. b(x0, x1, true)], g)
qed

// ----------------------------------------------------------------------
//  a_clz_32's operations: shifts by 1, or into the frame, sub r32, r32

// shr r32, 1 (D1 /5)
theorem tr.shr32_1(zb. bkp, zb pb wb. bka): all s v base code fr a a2 len g u r hs ds rs p w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(app(m, "vm"), base, code) -> app(m, "rip") = a ->
    runs(x86_64_linux.exec_body(len, tag(73, pair(4, pair(5, pair(tag(0, g), tag(0, g)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> tr.scratch_reg(g) -> g in dom(rs) -> app(rs, g) = pair(4, u) ->
  r = bits_shr(32, u, 1) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a2, hs, ds, fn_update(rs, g, pair(4, r)), p, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 len g u r hs ds rs p w
  assume hat ha2 hg hd hu hr hpt0
  have hpt := rewrite(hr, hpt0)
  have gR: g in x86_64_linux.Reg by taut(expand(hg, tr.scratch_reg))
  have he: all m o. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
      (ex f. x86i.flags_ok(m, f) && o = ok(fn_update(fn_update(fn_update(m, "rip", a2), "flags", f), "gpr", fn_update(app(m, "gpr"), g, bits_shr(32, u, 1))), empty)) proof
    fix m o
    assume hi hr hh hrs ho
    have ip := apply(tr.inv_parts, hi)
    have rg := apply(tr.regs_get, {m}, {rs}, {g}, {4}, {u}, hrs, hd, hu)
    have hx := mp(mp(mp(all_elim(hat, {m}, {o}), ho), taut(ip)), hr)
    obtain f, hf from apply(x86i.shr32_1, {m}, {o}, {g}, {len}, taut(ip), taut(ip), gR, hx)
    show by ex_intro({f}, simp(hf, rg, hr, ha2, keep(x86i.flags_ok)))
  qed
  have ty: all m. tr.inv(s, base, code, fr, m, w) -> app(m, "rip") = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) ->
      bits_shr(32, u, 1) in bits(int_mul(8, 4)) && bits_shr(32, u, 1) in bits(64) proof
    fix m
    show by simp(keep(tr.inv, tr.homes, tr.regs))
  qed
  have a2b: a2 in bits(64) by simp(ha2)
  show := apply(tr.reg_step[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {a2}, {g}, {4}, {bits_shr(32, u, 1)}, {hs}, {ds}, {rs}, {p}, {w}, he, a2b, hg, ty, hpt)
qed


