// The translation's rules for stores and loops (step_seq's, resetlock's):
// stores of n bytes both sides make (the world changing with the machine's
// memory), a write
// of the frame's slot (the frame then dirty, tr.mem's ds), the 32-bit
// compare-and-branch on a slot, and a counted loop by an invariant and a
// variant at its head (tr.wf2, tr.qs_loop) -- never unrolled.
//
//   slc kernel-check <translate.core's chain> proofs/x86_insn.core build/leaf_steps.core \
//     ... proofs/translate.core proofs/translate_store_loop.core
//
// (tr.qs_loop is by core/loop.core's while_step / while_leave.)

// (a read of n bytes: the same from two memories agreeing on them)
theorem tr.le_same: all b1 b2 r n. n in omega ->
  (all k. k in omega -> int_lt(k, n) -> app(b1, bits_add(64, r, bits_of_int(64, k))) = app(b2, bits_add(64, r, bits_of_int(64, k)))) ->
  x86_64_linux.le(b1, r, n) = x86_64_linux.le(b2, r, n)
proof
  fix b1
  fix b2
  fix r
  fix n
  assume hn: n in omega
  assume hk: all k. k in omega -> int_lt(k, n) -> app(b1, bits_add(64, r, bits_of_int(64, k))) = app(b2, bits_add(64, r, bits_of_int(64, k)))
  let F1(j) := int_mul(app(b1, bits_add(64, r, bits_of_int(64, j))), int_pow(256, j))
  let F2(j) := int_mul(app(b2, bits_add(64, r, bits_of_int(64, j))), int_pow(256, j))
  have s: all i. i in omega -> int_le(i, n) -> int_sum(0, i, j. F1(j)) = int_sum(0, i, j. F2(j)) proof
    have base: int_le(0, n) -> int_sum(0, 0, j. F1(j)) = int_sum(0, 0, j. F2(j)) proof
      assume z: int_le(0, n)
      have r1 := rec({nat_rec(empty, k v. int_add(v, F1(int_add(0, k))), 0)})
      have r2 := rec({nat_rec(empty, k v. int_add(v, F2(int_add(0, k))), 0)})
      show by defs(simp(r1, r2), int_sum)
    qed
    have step: all i. i in omega -> (int_le(i, n) -> int_sum(0, i, j. F1(j)) = int_sum(0, i, j. F2(j))) ->
        int_le(int_add(i, 1), n) -> int_sum(0, int_add(i, 1), j. F1(j)) = int_sum(0, int_add(i, 1), j. F2(j)) proof
      fix i
      assume hi: i in omega
      assume ih: int_le(i, n) -> int_sum(0, i, j. F1(j)) = int_sum(0, i, j. F2(j))
      assume hle: int_le(int_add(i, 1), n)
      have le: int_le(i, n) by arith(hi, hn, hle)
      have lt: int_lt(i, n) by arith(hi, hn, hle)
      have e0 := mp(ih, le)
      have ek := mp(all_elim(hk, {i}), hi, lt)
      have u1: int_sum(0, int_add(i, 1), j. F1(j)) = int_add(int_sum(0, i, j. F1(j)), F1(i)) by defs(simp(hi, rec({nat_rec(empty, k v. int_add(v, F1(int_add(0, k))), int_add(i, 1))}, hi)), int_sum)
      have u2: int_sum(0, int_add(i, 1), j. F2(j)) = int_add(int_sum(0, i, j. F2(j)), F2(i)) by defs(simp(hi, rec({nat_rec(empty, k v. int_add(v, F2(int_add(0, k))), int_add(i, 1))}, hi)), int_sum)
      show by simp(u1, u2, e0, ek)
    qed
    show by induct(base, step)
  qed
  have nn: int_le(n, n) by arith(hn)
  have sn := mp(all_elim(s, {n}), hn, nn)
  show by defs(simp(sn), x86_64_linux.le)
qed

// (the 8 bytes below rsp and the 8 above: rsp's page -- rsp + 8 16-aligned)
theorem tr.page_near: all sp a. sp in bits(64) -> int_mod(bits_add(64, sp, 8), 16) = 0 -> int_lt(sp, 140737488355328) ->
  int_le(int_sub(sp, 8), a) -> int_lt(a, int_add(sp, 8)) -> int_div(a, 4096) = int_div(sp, 4096)
proof
  fix sp
  fix a
  assume hs: sp in bits(64)
  assume hm: int_mod(bits_add(64, sp, 8), 16) = 0
  assume hl: int_lt(sp, 140737488355328)
  assume h1: int_le(int_sub(sp, 8), a)
  assume h2: int_lt(a, int_add(sp, 8))
  have p64: pow2(64) = 18446744073709551616 by simp()
  have sb: int_le(0, sp) by simp(hs)
  have e0: int_mod(int_add(sp, 8), 18446744073709551616) = int_add(sp, 8) by arith(sb, hl)
  have e: bits_add(64, sp, 8) = int_add(sp, 8) by defs(rewrite(sym(p64), e0), bits_add)
  have m8: int_mod(int_add(sp, 8), 16) = 0 := rewrite(e, hm)
  show by arith(hs, m8, h1, h2)
qed

// (a byte of a home, rsp + c + k, c in [-8, 0), k below the home's size:
// within the 8 bytes below rsp)
theorem tr.home_byte: all sp c k. sp in bits(64) -> int_le(8, sp) -> c in bits(64) -> int_le(18446744073709551608, c) -> k in omega ->
  int_lt(k, int_sub(18446744073709551616, c)) ->
  int_le(int_sub(sp, 8), bits_add(64, bits_add(64, int_add(sp, c), 0), bits_of_int(64, k))) && int_lt(bits_add(64, bits_add(64, int_add(sp, c), 0), bits_of_int(64, k)), sp)
proof
  fix sp
  fix c
  fix k
  assume hs: sp in bits(64)
  assume h8: int_le(8, sp)
  assume hc: c in bits(64)
  assume hc8: int_le(18446744073709551608, c)
  assume hk: k in omega
  assume hkc: int_lt(k, int_sub(18446744073709551616, c))
  have p64: pow2(64) = 18446744073709551616 by simp()
  have sb: int_lt(sp, 18446744073709551616) by simp(hs)
  have cb: int_lt(c, 18446744073709551616) by simp(hc)
  have e0: int_mod(int_add(int_mod(int_add(int_add(sp, c), 0), 18446744073709551616), int_mod(k, 18446744073709551616)), 18446744073709551616) = int_sub(int_add(int_add(sp, c), k), 18446744073709551616)
    by arith(h8, sb, cb, hc8, hk, hkc)
  have e: bits_add(64, bits_add(64, int_add(sp, c), 0), bits_of_int(64, k)) = int_sub(int_add(int_add(sp, c), k), pow2(64)) by defs(rewrite(sym(p64), e0), bits_add, bits_of_int)
  have g: int_le(int_sub(sp, 8), int_sub(int_add(int_add(sp, c), k), 18446744073709551616)) && int_lt(int_sub(int_add(int_add(sp, c), k), 18446744073709551616), sp) by arith(hc8, hk, hkc, cb)
  show := rewrite(sym(e), rewrite(sym(p64), g))
qed

// (a return address byte, rsp + k, k < 8: within the 8 bytes above rsp)
theorem tr.ret_byte: all sp k. sp in bits(64) -> int_lt(sp, 140737488355328) -> k in omega -> int_lt(k, 8) ->
  int_le(int_sub(sp, 8), bits_add(64, sp, bits_of_int(64, k))) && int_lt(bits_add(64, sp, bits_of_int(64, k)), int_add(sp, 8))
proof
  fix sp
  fix k
  assume hs: sp in bits(64)
  assume hl: int_lt(sp, 140737488355328)
  assume hk: k in omega
  assume k8: int_lt(k, 8)
  have p64: pow2(64) = 18446744073709551616 by simp()
  have sb: int_le(0, sp) by simp(hs)
  have e0: int_mod(int_add(sp, int_mod(k, 18446744073709551616)), 18446744073709551616) = int_add(sp, k) by arith(sb, hl, hk, k8)
  have e: bits_add(64, sp, bits_of_int(64, k)) = int_add(sp, k) by defs(rewrite(sym(p64), e0), bits_add, bits_of_int)
  have g: int_le(int_sub(sp, 8), int_add(sp, k)) && int_lt(int_add(sp, k), int_add(sp, 8)) by arith(hk, k8)
  show := rewrite(sym(e), g)
qed

// (an address off the stack pages is not a byte near rsp)
theorem tr.off_stack: all vm sp a t. sp in bits(64) -> int_mod(bits_add(64, sp, 8), 16) = 0 -> int_lt(sp, 140737488355328) ->
  abi.stack_page(vm, int_div(sp, 4096)) -> !abi.stack_page(vm, int_div(a, 4096)) ->
  int_le(int_sub(sp, 8), t) -> int_lt(t, int_add(sp, 8)) -> !(t = a)
proof
  fix vm
  fix sp
  fix a
  fix t
  assume hs: sp in bits(64)
  assume hm: int_mod(bits_add(64, sp, 8), 16) = 0
  assume hl: int_lt(sp, 140737488355328)
  assume hsp: abi.stack_page(vm, int_div(sp, 4096))
  assume hna: !abi.stack_page(vm, int_div(a, 4096))
  assume h1: int_le(int_sub(sp, 8), t)
  assume h2: int_lt(t, int_add(sp, 8))
  have pe := apply(tr.page_near, {sp}, {t}, hs, hm, hl, h1, h2)
  have n: t = a -> false proof
    assume e: t = a
    have pa := rewrite(e, pe)
    have sa := rewrite(sym(pa), hsp)
    show by taut(sa, hna)
  qed
  show by taut(n)
qed

// (n bytes stored at a: the memory at t, none of them, as before)
theorem tr.storen_other: all b a n x t. t in bits(64) ->
  (all j. j in omega -> int_lt(j, n) -> !(t = bits_add(64, a, bits_of_int(64, j)))) -> app(x86_64_linux.store_le(b, a, n, x), t) = app(b, t)
proof
  fix b
  fix a
  fix n
  fix x
  fix t
  assume ht: t in bits(64)
  assume hn: all j. j in omega -> int_lt(j, n) -> !(t = bits_add(64, a, bits_of_int(64, j)))
  have e1 := mp(app_fn_build[d := bits(64), v := y. ite(int_lt(bits_sub(64, y, a), n), bits_of_int(8, int_div(x, int_pow(256, bits_sub(64, y, a)))), app(b, y)), a := t], ht)
  have k: bits_sub(64, t, a) in omega by defs(simp(ht), bits_sub, pow2)
  have id := mp(x86.bits_add_sub_any[a := a, c := t], ht)
  have c: int_lt(bits_sub(64, t, a), n) -> false proof
    assume l: int_lt(bits_sub(64, t, a), n)
    have q := mp(all_elim(hn, {bits_sub(64, t, a)}), k, l)
    show by taut(q, sym(id))
  qed
  have nl: !int_lt(bits_sub(64, t, a), n) by taut(c)
  have f := mp(ite_f[c := int_lt(bits_sub(64, t, a), n), a := bits_of_int(8, int_div(x, int_pow(256, bits_sub(64, t, a)))), b := app(b, t)], nl)
  show by defs(taut(trans(e1, f)), x86_64_linux.store_le)
qed

// (n bytes stored at a8, none on a stack page: a byte near rsp as before)
theorem tr.store_near: all vm sp b a8 n x t. sp in bits(64) -> int_mod(bits_add(64, sp, 8), 16) = 0 -> int_lt(sp, 140737488355328) ->
  abi.stack_page(vm, int_div(sp, 4096)) -> (all j. j in omega -> int_lt(j, n) -> !abi.stack_page(vm, int_div(bits_add(64, a8, bits_of_int(64, j)), 4096))) ->
  t in bits(64) -> int_le(int_sub(sp, 8), t) -> int_lt(t, int_add(sp, 8)) -> app(x86_64_linux.store_le(b, a8, n, x), t) = app(b, t)
proof
  fix vm
  fix sp
  fix b
  fix a8
  fix n
  fix x
  fix t
  assume hs: sp in bits(64)
  assume hm: int_mod(bits_add(64, sp, 8), 16) = 0
  assume hl: int_lt(sp, 140737488355328)
  assume hsp: abi.stack_page(vm, int_div(sp, 4096))
  assume hns: all j. j in omega -> int_lt(j, n) -> !abi.stack_page(vm, int_div(bits_add(64, a8, bits_of_int(64, j)), 4096))
  assume ht: t in bits(64)
  assume h1: int_le(int_sub(sp, 8), t)
  assume h2: int_lt(t, int_add(sp, 8))
  have nt: all j. j in omega -> int_lt(j, n) -> !(t = bits_add(64, a8, bits_of_int(64, j))) proof
    fix j
    assume j1: j in omega
    assume j2: int_lt(j, n)
    show := apply(tr.off_stack, {vm}, {sp}, {bits_add(64, a8, bits_of_int(64, j))}, {t}, hs, hm, hl, hsp, mp(all_elim(hns, {j}), j1, j2), h1, h2)
  qed
  show := apply(tr.storen_other, {b}, {a8}, {n}, {x}, {t}, ht, nt)
qed

// (a byte off the stack pages: as the bytes of a 1-byte store)
theorem tr.off_stack1: all vm a. a in bits(64) -> !abi.stack_page(vm, int_div(a, 4096)) ->
  (all j. j in omega -> int_lt(j, 1) -> !abi.stack_page(vm, int_div(bits_add(64, a, bits_of_int(64, j)), 4096)))
proof
  fix vm
  fix a
  assume ha: a in bits(64)
  assume hn: !abi.stack_page(vm, int_div(a, 4096))
  fix j
  assume j1: j in omega
  assume j2: int_lt(j, 1)
  have jz: j = 0 by arith(j1, j2)
  show by simp(hn, jz, ha)
qed

// (the bytes [a, a + n) within a static range [lo, hi) off the stack
// pages: each off them)
theorem tr.off_stackn: all vm lo hi a n. (all c. c in omega -> int_le(lo, c) -> int_lt(c, hi) -> !abi.stack_page(vm, int_div(c, 4096))) ->
  a in bits(64) -> n in omega -> int_le(lo, a) -> int_le(int_add(a, n), hi) -> int_le(hi, 18446744073709551616) ->
  (all j. j in omega -> int_lt(j, n) -> !abi.stack_page(vm, int_div(bits_add(64, a, bits_of_int(64, j)), 4096)))
proof
  fix vm
  fix lo
  fix hi
  fix a
  fix n
  assume hr: all c. c in omega -> int_le(lo, c) -> int_lt(c, hi) -> !abi.stack_page(vm, int_div(c, 4096))
  assume ha: a in bits(64)
  assume hn: n in omega
  assume h1: int_le(lo, a)
  assume h2: int_le(int_add(a, n), hi)
  assume h3: int_le(hi, 18446744073709551616)
  fix j
  assume j1: j in omega
  assume j2: int_lt(j, n)
  have p64: pow2(64) = 18446744073709551616 by simp()
  have ab: int_le(0, a) by simp(ha)
  have e0: int_mod(int_add(a, int_mod(j, 18446744073709551616)), 18446744073709551616) = int_add(a, j) by arith(ab, j1, j2, h2, h3)
  have e: bits_add(64, a, bits_of_int(64, j)) = int_add(a, j) by defs(rewrite(sym(p64), e0), bits_add, bits_of_int)
  have c1: int_add(a, j) in omega by arith(ab, j1)
  have c2: int_le(lo, int_add(a, j)) by arith(h1, j1)
  have c3: int_lt(int_add(a, j), hi) by arith(h2, j2)
  have r := mp(all_elim(hr, {int_add(a, j)}), c1, c2, c3)
  show := rewrite(sym(e), r)
qed

// (rsp + 8 16-aligned: rsp at least 8)
theorem tr.sp_ge8: all sp. sp in bits(64) -> int_mod(bits_add(64, sp, 8), 16) = 0 -> int_lt(sp, 140737488355328) -> int_le(8, sp)
proof
  fix sp
  assume hs: sp in bits(64)
  assume hm: int_mod(bits_add(64, sp, 8), 16) = 0
  assume hl: int_lt(sp, 140737488355328)
  have p64: pow2(64) = 18446744073709551616 by simp()
  have sb: int_le(0, sp) by simp(hs)
  have e0: int_mod(int_add(sp, 8), 18446744073709551616) = int_add(sp, 8) by arith(sb, hl)
  have e: bits_add(64, sp, 8) = int_add(sp, 8) by defs(rewrite(sym(p64), e0), bits_add)
  have m8 := rewrite(e, hm)
  show by arith(sb, m8)
qed

// (the memory's pages: the world's)
theorem tr.mem_pages: all s m w ds. tr.mem(s, m, w, ds) -> app(app(w, "vm"), "pages") = app(app(m, "vm"), "pages")
proof
  fix s
  fix m
  fix w
  fix ds
  assume h: tr.mem(s, m, w, ds)
  have c1: (!ds && app(w, "vm") = app(m, "vm")) -> app(app(w, "vm"), "pages") = app(app(m, "vm"), "pages") proof
    assume h1: !ds && app(w, "vm") = app(m, "vm")
    have e: app(w, "vm") = app(m, "vm") by taut(h1)
    show by simp(e)
  qed
  have c2: (ds && fn_update(app(w, "vm"), "bytes", app(app(m, "vm"), "bytes")) = app(m, "vm") &&
      abi.agree(app(s, "vm"), abi.sp(s), app(app(m, "vm"), "bytes"), app(app(w, "vm"), "bytes"))) -> app(app(w, "vm"), "pages") = app(app(m, "vm"), "pages") proof
    assume h2: ds && fn_update(app(w, "vm"), "bytes", app(app(m, "vm"), "bytes")) = app(m, "vm") &&
      abi.agree(app(s, "vm"), abi.sp(s), app(app(m, "vm"), "bytes"), app(app(w, "vm"), "bytes"))
    have e: fn_update(app(w, "vm"), "bytes", app(app(m, "vm"), "bytes")) = app(m, "vm") by taut(h2)
    show by simp(sym(e))
  qed
  show by taut(expand(h, tr.mem), c1, c2)
qed

// (the flags' arithmetic: u, k unsigned 32-bit, d their difference mod 2^32,
// x, y, z their signed readings)
theorem tr.jle_core: all u k d x y z. u in int -> k in int -> d in int -> x in int -> y in int -> z in int -> (int_le(0, u) && int_lt(u, 4294967296)) -> (int_le(0, k) && int_lt(k, 4294967296)) -> (int_le(0, d) && int_lt(d, 4294967296)) -> ((int_le(k, u) && d = int_sub(u, k)) || (int_lt(u, k) && d = int_add(int_sub(u, k), 4294967296))) -> ((int_lt(u, 2147483648) && x = u) || (!int_lt(u, 2147483648) && x = int_sub(u, 4294967296))) -> ((int_lt(k, 2147483648) && y = k) || (!int_lt(k, 2147483648) && y = int_sub(k, 4294967296))) -> ((int_lt(d, 2147483648) && z = d) || (!int_lt(d, 2147483648) && z = int_sub(d, 4294967296))) -> (((d = 0) || !(int_le(2147483648, d) <-> !(int_sub(x, y) = z))) <-> int_le(x, y))
proof
  fix u
  fix k
  fix d
  fix x
  fix y
  fix z
  assume iu: u in int
  assume ik: k in int
  assume id: d in int
  assume ix: x in int
  assume iy: y in int
  assume iz: z in int
  assume p0: int_le(0, u) && int_lt(u, 4294967296)
  assume p1: int_le(0, k) && int_lt(k, 4294967296)
  assume p2: int_le(0, d) && int_lt(d, 4294967296)
  assume p3: (int_le(k, u) && d = int_sub(u, k)) || (int_lt(u, k) && d = int_add(int_sub(u, k), 4294967296))
  assume p4: (int_lt(u, 2147483648) && x = u) || (!int_lt(u, 2147483648) && x = int_sub(u, 4294967296))
  assume p5: (int_lt(k, 2147483648) && y = k) || (!int_lt(k, 2147483648) && y = int_sub(k, 4294967296))
  assume p6: (int_lt(d, 2147483648) && z = d) || (!int_lt(d, 2147483648) && z = int_sub(d, 4294967296))
  have r0: (int_le(k, u) && d = int_sub(u, k)) -> (int_lt(u, 2147483648) && x = u) -> (int_lt(k, 2147483648) && y = k) -> (int_lt(d, 2147483648) && z = d) -> (z = int_sub(x, y) || z = int_sub(int_sub(x, y), 4294967296) || z = int_add(int_sub(x, y), 4294967296)) proof
    assume y1: int_le(k, u) && d = int_sub(u, k)
    assume y2: int_lt(u, 2147483648) && x = u
    assume y3: int_lt(k, 2147483648) && y = k
    assume y4: int_lt(d, 2147483648) && z = d
    have q: z = int_sub(x, y) by arith(iu, ik, id, ix, iy, iz, p0, p1, p2, y1, y2, y3, y4)
    show by taut(q)
  qed
  have r1: (int_le(k, u) && d = int_sub(u, k)) -> (int_lt(u, 2147483648) && x = u) -> (int_lt(k, 2147483648) && y = k) -> (!int_lt(d, 2147483648) && z = int_sub(d, 4294967296)) -> (z = int_sub(x, y) || z = int_sub(int_sub(x, y), 4294967296) || z = int_add(int_sub(x, y), 4294967296)) proof
    assume y1: int_le(k, u) && d = int_sub(u, k)
    assume y2: int_lt(u, 2147483648) && x = u
    assume y3: int_lt(k, 2147483648) && y = k
    assume y4: !int_lt(d, 2147483648) && z = int_sub(d, 4294967296)
    have q: z = int_sub(int_sub(x, y), 4294967296) by arith(iu, ik, id, ix, iy, iz, p0, p1, p2, y1, y2, y3, y4)
    show by taut(q)
  qed
  have r2: (int_le(k, u) && d = int_sub(u, k)) -> (int_lt(u, 2147483648) && x = u) -> (!int_lt(k, 2147483648) && y = int_sub(k, 4294967296)) -> (int_lt(d, 2147483648) && z = d) -> (z = int_sub(x, y) || z = int_sub(int_sub(x, y), 4294967296) || z = int_add(int_sub(x, y), 4294967296)) proof
    assume y1: int_le(k, u) && d = int_sub(u, k)
    assume y2: int_lt(u, 2147483648) && x = u
    assume y3: !int_lt(k, 2147483648) && y = int_sub(k, 4294967296)
    assume y4: int_lt(d, 2147483648) && z = d
