    assume y1: int_lt(u, k) && d = int_add(int_sub(u, k), 4294967296)
    assume y2: int_lt(u, 2147483648) && x = u
    assume y3: !int_lt(k, 2147483648) && y = int_sub(k, 4294967296)
    assume y4: int_lt(d, 2147483648) && z = d
    have q: z = int_sub(x, y) by arith(iu, ik, id, ix, iy, iz, p0, p1, p2, y1, y2, y3, y4)
    show by taut(q)
