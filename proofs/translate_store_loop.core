  have r14: (int_lt(u, k) && d = int_add(int_sub(u, k), 4294967296)) -> (!int_lt(u, 2147483648) && x = int_sub(u, 4294967296)) -> (!int_lt(k, 2147483648) && y = int_sub(k, 4294967296)) -> (int_lt(d, 2147483648) && z = d) -> (z = int_sub(x, y) || z = int_sub(int_sub(x, y), 4294967296) || z = int_add(int_sub(x, y), 4294967296)) proof
    assume y1: int_lt(u, k) && d = int_add(int_sub(u, k), 4294967296)
