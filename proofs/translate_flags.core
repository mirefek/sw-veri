  have xo: x0 in omega by simp(rewrite(rg, xb))
  have sl: bits_slice(m.gpr[g], 15, 0) = bits_of_int(16, x0) by defs(simp(rg, xo), bits_slice, bits_of_int)
  have fit: x0 in bits(16) -> bits_of_int(16, x0) = x0 proof
