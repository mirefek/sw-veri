// Compares and conditional jumps (docs/overview.md, C1), by the flags: a
// compare or test sets them as x86i.subf / x86i.logf describe (a rule per
// operand shape, tr.fs_*: the instruction's step from the point's
// coupling), a condition code reads them (a lemma per code: tr.ccs_* for a
// compare's, tr.ccl_* for a test's), and the jump branches on the
// condition (tr.jcc) -- the compare's step, the code's lemma and the jump
// combined, each once.
//
// Check after proofs/translate_store_loop.core.

// the operand widths
def tr.width(n) := n = 8 || n = 16 || n = 32 || n = 64

// (a - b's zero flag: a = b)
theorem tr.sub_zero: all n a b. tr.width(n) -> a in bits(n) -> b in bits(n) -> ((bits_sub(n, a, b) = 0) <-> a = b)
proof
  fix n a b
  assume hw ha hb
  have c8: n = 8 -> ((bits_sub(n, a, b) = 0) <-> a = b) proof
    assume e
    have a1 := rewrite(e, ha)
    have b1 := rewrite(e, hb)
    have r: (int_mod(int_sub(a, b), 256) = 0) <-> a = b by arith(a1, b1)
    have r2: (bits_sub(8, a, b) = 0) <-> a = b by defs(simp(r), bits_sub)
    show := rewrite(sym(e), r2)
  qed
  have c16: n = 16 -> ((bits_sub(n, a, b) = 0) <-> a = b) proof
    assume e
    have a1 := rewrite(e, ha)
    have b1 := rewrite(e, hb)
    have r: (int_mod(int_sub(a, b), 65536) = 0) <-> a = b by arith(a1, b1)
    have r2: (bits_sub(16, a, b) = 0) <-> a = b by defs(simp(r), bits_sub)
    show := rewrite(sym(e), r2)
  qed
  have c32: n = 32 -> ((bits_sub(n, a, b) = 0) <-> a = b) proof
    assume e
    have a1 := rewrite(e, ha)
    have b1 := rewrite(e, hb)
    have r: (int_mod(int_sub(a, b), 4294967296) = 0) <-> a = b by arith(a1, b1)
    have r2: (bits_sub(32, a, b) = 0) <-> a = b by defs(simp(r), bits_sub)
    show := rewrite(sym(e), r2)
  qed
  have c64: n = 64 -> ((bits_sub(n, a, b) = 0) <-> a = b) proof
    assume e
    have a1 := rewrite(e, ha)
    have b1 := rewrite(e, hb)
    have r: (int_mod(int_sub(a, b), 18446744073709551616) = 0) <-> a = b by arith(a1, b1)
    have r2: (bits_sub(64, a, b) = 0) <-> a = b by defs(simp(r), bits_sub)
    show := rewrite(sym(e), r2)
  qed
  show by taut(expand(hw, tr.width), c8, c16, c32, c64)
qed

// (the low 8 bits of a register holding x0: its value at that width, or
// x0's low bits, or x0 itself known to fit)
theorem tr.reg_low8: all m rs g n x0 x. m in x86_64_linux.Machine -> g in x86_64_linux.Reg -> tr.regs(m, rs) -> g in dom(rs) -> rs[g] = pair(n, x0) ->
  (x = bits_of_int(8, x0) || (x = x0 && n = 1) || (x = x0 && x0 in bits(8))) -> bits_slice(m.gpr[g], 7, 0) = x
proof
  fix m rs g n x0 x
  assume hM hg hrs hgd hgu hx
  have rg r8 := apply(tr.regs_get, {m}, {rs}, {g}, {n}, {x0}, hrs, hgd, hgu)
  have xb := mp(mp(all_elim(x86i.reg_typed, {m}, {g}), hM), hg)
  have xo: x0 in omega by simp(rewrite(rg, xb))
  have sl: bits_slice(m.gpr[g], 7, 0) = bits_of_int(8, x0) by defs(simp(rg, xo), bits_slice, bits_of_int)
  have fit: x0 in bits(8) -> bits_of_int(8, x0) = x0 proof
    assume h
    show by defs(simp(h), bits_of_int)
  qed
  have wn: n = 1 -> x0 in bits(8) proof
    assume e
    show by simp(rewrite(e, r8))
  qed
  have c1: x = bits_of_int(8, x0) -> bits_of_int(8, x0) = x proof
    assume e
    show := sym(e)
  qed
  have c2: x = x0 -> x0 in bits(8) -> bits_of_int(8, x0) = x proof
    assume e hb
    have f1 := mp(fit, hb)
    show by simp(f1, e)
  qed
  have k: bits_of_int(8, x0) = x by taut(hx, c1, c2, wn)
  show := rewrite(k, sl)
qed

// (the low 16 bits of a register holding x0: its value at that width, or
// x0's low bits, or x0 itself known to fit)
theorem tr.reg_low16: all m rs g n x0 x. m in x86_64_linux.Machine -> g in x86_64_linux.Reg -> tr.regs(m, rs) -> g in dom(rs) -> rs[g] = pair(n, x0) ->
  (x = bits_of_int(16, x0) || (x = x0 && n = 2) || (x = x0 && x0 in bits(16))) -> bits_slice(m.gpr[g], 15, 0) = x
