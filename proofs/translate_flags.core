    show by defs(simp(h), bits_of_int)
  qed
  have wn: n = 2 -> x0 in bits(16) proof
    assume e
    show by simp(rewrite(e, r8))
  qed
  have c1: x = bits_of_int(16, x0) -> bits_of_int(16, x0) = x proof
    assume e
    show := sym(e)
  qed
  have c2: x = x0 -> x0 in bits(16) -> bits_of_int(16, x0) = x proof
    assume e hb
    have f1 := mp(fit, hb)
    show by simp(f1, e)
  qed
  have k: bits_of_int(16, x0) = x by taut(hx, c1, c2, wn)
  show := rewrite(k, sl)
qed

// (the low 32 bits of a register holding x0: its value at that width, or
// x0's low bits, or x0 itself known to fit)
theorem tr.reg_low32: all m rs g n x0 x. m in x86_64_linux.Machine -> g in x86_64_linux.Reg -> tr.regs(m, rs) -> g in dom(rs) -> rs[g] = pair(n, x0) ->
  (x = bits_of_int(32, x0) || (x = x0 && n = 4) || (x = x0 && x0 in bits(32))) -> bits_slice(m.gpr[g], 31, 0) = x
proof
  fix m rs g n x0 x
  assume hM hg hrs hgd hgu hx
  have rg r8 := apply(tr.regs_get, {m}, {rs}, {g}, {n}, {x0}, hrs, hgd, hgu)
  have xb := mp(mp(all_elim(x86i.reg_typed, {m}, {g}), hM), hg)
  have xo: x0 in omega by simp(rewrite(rg, xb))
  have sl: bits_slice(m.gpr[g], 31, 0) = bits_of_int(32, x0) by defs(simp(rg, xo), bits_slice, bits_of_int)
  have fit: x0 in bits(32) -> bits_of_int(32, x0) = x0 proof
    assume h
    show by defs(simp(h), bits_of_int)
  qed
  have wn: n = 4 -> x0 in bits(32) proof
    assume e
    show by simp(rewrite(e, r8))
  qed
  have c1: x = bits_of_int(32, x0) -> bits_of_int(32, x0) = x proof
    assume e
    show := sym(e)
  qed
  have c2: x = x0 -> x0 in bits(32) -> bits_of_int(32, x0) = x proof
    assume e hb
    have f1 := mp(fit, hb)
    show by simp(f1, e)
  qed
  have k: bits_of_int(32, x0) = x by taut(hx, c1, c2, wn)
  show := rewrite(k, sl)
qed

// cmp dword [rsp + d], r32: the home c (u) against g (x, its low 32 bits)
theorem tr.fs32_hr: all s base code fr a a2 len g d c n x0 x u hs rs w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a ->
    runs(x86_64_linux.exec_body(len, tag(56, pair(4, pair(g, pair(x86i.rsp_mem(d), pair(x86i.rsp_mem(d), tag(0, g))))))), m, o)) ->
  a2 = bits_add(64, a, len) -> g in x86_64_linux.Reg -> d in bits(64) -> c = int_mod(int_sub(d, fr), 18446744073709551616) -> c in dom(hs) -> hs[c] = pair(4, u) -> g in dom(rs) -> rs[g] = pair(n, x0) -> (x = bits_of_int(32, x0) || (x = x0 && n = 4) || (x = x0 && x0 in bits(32))) ->
  all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
    (ex f. x86i.flags_ok(m, f) && x86i.subf(32, u, x, f) && o = ok(fn_update(fn_update(m, "rip", a2), "flags", f), empty))
proof
  fix s base code fr a a2 len g d c n x0 x u hs rs w
  assume hat ha2 hg hd hcd hdd hu hgd hgu hx
  fix m o
  assume hi hr hh hrs ho
  have ipM ipU ipC .. := apply(tr.inv_parts, hi)
  have ac := apply(tr.home_acc, {s}, {base}, {code}, {fr}, {m}, {w}, {hs}, {d}, {c}, {4}, {u}, hi, hh, hd, hcd, hdd, hu)
  have hm := apply(tr.home_read, {s}, {base}, {code}, {fr}, {m}, {w}, {hs}, {d}, {c}, {4}, {u}, hi, hh, hd, hcd, hdd, hu)
  have sl := apply(tr.reg_low32, {m}, {rs}, {g}, {n}, {x0}, {x}, ipM, hg, hrs, hgd, hgu, hx)
  have e := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
  obtain f, hf from apply(x86i.cmpf32_rsp_r, {m}, {o}, {g}, {d}, {len}, ipM, ipU, hg, hd, taut(ac), e)
  have hf2 := rewrite(sl, rewrite(hm, hf))
  show by ex_intro({f}, simp(hf2, hr, ha2, keep(x86i.flags_ok, x86i.subf, x86i.logf)))
qed

// cmp r32, dword [rsp + d]: g (x, its low 32 bits) against the home c (u)
theorem tr.fs32_rh: all s base code fr a a2 len g d c n x0 x u hs rs w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a ->
    runs(x86_64_linux.exec_body(len, tag(57, pair(4, pair(g, pair(x86i.rsp_mem(d), pair(x86i.rsp_mem(d), tag(0, g))))))), m, o)) ->
  a2 = bits_add(64, a, len) -> g in x86_64_linux.Reg -> d in bits(64) -> c = int_mod(int_sub(d, fr), 18446744073709551616) -> c in dom(hs) -> hs[c] = pair(4, u) -> g in dom(rs) -> rs[g] = pair(n, x0) -> (x = bits_of_int(32, x0) || (x = x0 && n = 4) || (x = x0 && x0 in bits(32))) ->
  all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
    (ex f. x86i.flags_ok(m, f) && x86i.subf(32, x, u, f) && o = ok(fn_update(fn_update(m, "rip", a2), "flags", f), empty))
proof
  fix s base code fr a a2 len g d c n x0 x u hs rs w
  assume hat ha2 hg hd hcd hdd hu hgd hgu hx
  fix m o
  assume hi hr hh hrs ho
  have ipM ipU ipC .. := apply(tr.inv_parts, hi)
  have ac := apply(tr.home_acc, {s}, {base}, {code}, {fr}, {m}, {w}, {hs}, {d}, {c}, {4}, {u}, hi, hh, hd, hcd, hdd, hu)
  have hm := apply(tr.home_read, {s}, {base}, {code}, {fr}, {m}, {w}, {hs}, {d}, {c}, {4}, {u}, hi, hh, hd, hcd, hdd, hu)
  have sl := apply(tr.reg_low32, {m}, {rs}, {g}, {n}, {x0}, {x}, ipM, hg, hrs, hgd, hgu, hx)
  have e := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
  obtain f, hf from apply(x86i.cmpf32_r_rsp, {m}, {o}, {g}, {d}, {len}, ipM, ipU, hg, hd, taut(ac), e)
  have hf2 := rewrite(sl, rewrite(hm, hf))
  show by ex_intro({f}, simp(hf2, hr, ha2, keep(x86i.flags_ok, x86i.subf, x86i.logf)))
qed

// cmp qword [rsp + d], r64: the home c (u) against g (x)
theorem tr.fs64_hr: all s base code fr a a2 len g d c n x u hs rs w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a ->
    runs(x86_64_linux.exec_body(len, tag(56, pair(8, pair(g, pair(x86i.rsp_mem(d), pair(x86i.rsp_mem(d), tag(0, g))))))), m, o)) ->
  a2 = bits_add(64, a, len) -> g in x86_64_linux.Reg -> d in bits(64) -> c = int_mod(int_sub(d, fr), 18446744073709551616) -> c in dom(hs) -> hs[c] = pair(8, u) -> g in dom(rs) -> rs[g] = pair(n, x) ->
  all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
    (ex f. x86i.flags_ok(m, f) && x86i.subf(64, u, x, f) && o = ok(fn_update(fn_update(m, "rip", a2), "flags", f), empty))
proof
  fix s base code fr a a2 len g d c n x u hs rs w
  assume hat ha2 hg hd hcd hdd hu hgd hgu
  fix m o
  assume hi hr hh hrs ho
  have ipM ipU ipC .. := apply(tr.inv_parts, hi)
  have ac := apply(tr.home_acc, {s}, {base}, {code}, {fr}, {m}, {w}, {hs}, {d}, {c}, {8}, {u}, hi, hh, hd, hcd, hdd, hu)
  have hm := apply(tr.home_read, {s}, {base}, {code}, {fr}, {m}, {w}, {hs}, {d}, {c}, {8}, {u}, hi, hh, hd, hcd, hdd, hu)
  have rg .. := apply(tr.regs_get, {m}, {rs}, {g}, {n}, {x}, hrs, hgd, hgu)
  have e := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
  obtain f, hf from apply(x86i.cmpf64_rsp_r, {m}, {o}, {g}, {d}, {len}, ipM, ipU, hg, hd, taut(ac), e)
  have hf2 := rewrite(rg, rewrite(hm, hf))
  show by ex_intro({f}, simp(hf2, hr, ha2, keep(x86i.flags_ok, x86i.subf, x86i.logf)))
qed

// cmp r64, qword [rsp + d]: g (u) against the home c (x)
theorem tr.fs64_rh: all s base code fr a a2 len g d c n x u hs rs w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a ->
    runs(x86_64_linux.exec_body(len, tag(57, pair(8, pair(g, pair(x86i.rsp_mem(d), pair(x86i.rsp_mem(d), tag(0, g))))))), m, o)) ->
  a2 = bits_add(64, a, len) -> g in x86_64_linux.Reg -> d in bits(64) -> c = int_mod(int_sub(d, fr), 18446744073709551616) -> c in dom(hs) -> hs[c] = pair(8, x) -> g in dom(rs) -> rs[g] = pair(n, u) ->
  all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
    (ex f. x86i.flags_ok(m, f) && x86i.subf(64, u, x, f) && o = ok(fn_update(fn_update(m, "rip", a2), "flags", f), empty))
proof
  fix s base code fr a a2 len g d c n x u hs rs w
  assume hat ha2 hg hd hcd hdd hu hgd hgu
  fix m o
  assume hi hr hh hrs ho
  have ipM ipU ipC .. := apply(tr.inv_parts, hi)
  have ac := apply(tr.home_acc, {s}, {base}, {code}, {fr}, {m}, {w}, {hs}, {d}, {c}, {8}, {x}, hi, hh, hd, hcd, hdd, hu)
  have hm := apply(tr.home_read, {s}, {base}, {code}, {fr}, {m}, {w}, {hs}, {d}, {c}, {8}, {x}, hi, hh, hd, hcd, hdd, hu)
  have rg .. := apply(tr.regs_get, {m}, {rs}, {g}, {n}, {u}, hrs, hgd, hgu)
  have e := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
  obtain f, hf from apply(x86i.cmpf64_r_rsp, {m}, {o}, {g}, {d}, {len}, ipM, ipU, hg, hd, taut(ac), e)
  have hf2 := rewrite(rg, rewrite(hm, hf))
  show by ex_intro({f}, simp(hf2, hr, ha2, keep(x86i.flags_ok, x86i.subf, x86i.logf)))
qed

// cmp r64, r64: g (u) against h (x)
theorem tr.fs64_rr: all s base code fr a a2 len g h n1 n2 u x hs rs w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a ->
    runs(x86_64_linux.exec_body(len, tag(56, pair(8, pair(h, pair(tag(0, g), pair(tag(0, g), tag(0, h))))))), m, o)) ->
  a2 = bits_add(64, a, len) -> g in x86_64_linux.Reg -> h in x86_64_linux.Reg -> g in dom(rs) -> rs[g] = pair(n1, u) -> h in dom(rs) -> rs[h] = pair(n2, x) ->
  all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
    (ex f. x86i.flags_ok(m, f) && x86i.subf(64, u, x, f) && o = ok(fn_update(fn_update(m, "rip", a2), "flags", f), empty))
proof
  fix s base code fr a a2 len g h n1 n2 u x hs rs w
  assume hat ha2 hg hh0 hgd hgu hhd hhu
  fix m o
  assume hi hr hh hrs ho
  have ipM ipU ipC .. := apply(tr.inv_parts, hi)
  have rg .. := apply(tr.regs_get, {m}, {rs}, {g}, {n1}, {u}, hrs, hgd, hgu)
  have rh .. := apply(tr.regs_get, {m}, {rs}, {h}, {n2}, {x}, hrs, hhd, hhu)
  have e := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
  obtain f, hf from apply(x86i.cmpf64_rr, {m}, {o}, {g}, {h}, {len}, ipM, ipU, hg, hh0, e)
  have hf2 := rewrite(rh, rewrite(rg, hf))
  show by ex_intro({f}, simp(hf2, hr, ha2, keep(x86i.flags_ok, x86i.subf, x86i.logf)))
qed

// cmp dword [rsp + d], imm8: the home c (u) against kk
theorem tr.fs32_hi8: all s base code fr a a2 len d c k kk u hs rs w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a ->
    runs(x86_64_linux.exec_body(len, tag(60, pair(4, pair(7, pair(x86i.rsp_mem(d), pair(x86i.rsp_mem(d), k)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> d in bits(64) -> c = int_mod(int_sub(d, fr), 18446744073709551616) -> c in dom(hs) -> hs[c] = pair(4, u) -> k in bits(8) -> kk = bits_sext(8, 32, k) ->
  all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
    (ex f. x86i.flags_ok(m, f) && x86i.subf(32, u, kk, f) && o = ok(fn_update(fn_update(m, "rip", a2), "flags", f), empty))
proof
  fix s base code fr a a2 len d c k kk u hs rs w
  assume hat ha2 hd hcd hdd hu hk hkk
  fix m o
  assume hi hr hh hrs ho
  have ipM ipU ipC .. := apply(tr.inv_parts, hi)
  have ac := apply(tr.home_acc, {s}, {base}, {code}, {fr}, {m}, {w}, {hs}, {d}, {c}, {4}, {u}, hi, hh, hd, hcd, hdd, hu)
  have hm := apply(tr.home_read, {s}, {base}, {code}, {fr}, {m}, {w}, {hs}, {d}, {c}, {4}, {u}, hi, hh, hd, hcd, hdd, hu)
  have e := mp(all_elim(hat, {m}, {o}), ho, ipC, hr)
  obtain f, hf from apply(x86i.cmpf32_rsp_imm8, {m}, {o}, {d}, {k}, {len}, ipM, ipU, hd, hk, taut(ac), e)
  have hf2 := rewrite(sym(hkk), rewrite(hm, hf))
  show by ex_intro({f}, simp(hf2, hr, ha2, keep(x86i.flags_ok, x86i.subf, x86i.logf)))
qed

// cmp dword [rsp + d], imm32: the home c (u) against kk
theorem tr.fs32_hi32: all s base code fr a a2 len d c k kk u hs rs w.
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a ->
    runs(x86_64_linux.exec_body(len, tag(59, pair(4, pair(7, pair(x86i.rsp_mem(d), pair(x86i.rsp_mem(d), k)))))), m, o)) ->
  a2 = bits_add(64, a, len) -> d in bits(64) -> c = int_mod(int_sub(d, fr), 18446744073709551616) -> c in dom(hs) -> hs[c] = pair(4, u) -> k in bits(32) -> kk = bits_sext(32, 32, k) ->
  all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
    (ex f. x86i.flags_ok(m, f) && x86i.subf(32, u, kk, f) && o = ok(fn_update(fn_update(m, "rip", a2), "flags", f), empty))
proof
  fix s base code fr a a2 len d c k kk u hs rs w
  assume hat ha2 hd hcd hdd hu hk hkk
  fix m o
  assume hi hr hh hrs ho
  have ipM ipU ipC .. := apply(tr.inv_parts, hi)
