// ----------------------------------------------------------------------
//  The condition codes: a jump's condition by the flags alone, as the
//  fall-through's condition c (the jump taken when !c, tr.jcc)

// (a comparison: a proposition)
theorem tr.lt_prop: all a b. int_lt(a, b) = false || int_lt(a, b) = true
proof
  fix a b
  have ip: is_prop(int_lt(a, b)) by defs(in_prop[a := int_sub(b, int_succ(a)), b := omega], int_lt, int_le)
  show by defs(ip, is_prop)
qed

// je: on (to the fall-through) when a is not b
theorem tr.ccs_e: all n a b. tr.width(n) -> all f. x86i.subf(n, a, b, f) -> (x86_64_linux.cond(f, 4) <-> !!(a = b))
proof
  fix n a b
  assume hw
  fix f
  assume h
  have ha hb hz .. := expand(h, x86i.subf)
  have e1 := apply(tr.sub_zero, {n}, {a}, {b}, hw, ha, hb)
  have hp: (bits_sub(n, a, b) = 0) = false || (bits_sub(n, a, b) = 0) = true by defs(eq_prop[a := bits_sub(n, a, b), b := 0], is_prop)
  have e3 := mp(tr.prop_true, {bits_sub(n, a, b) = 0}, hp)
  have e4 := mp(tr.prop_false, {bits_sub(n, a, b) = 0}, hp)
  show by simp(hz, e1, e3, e4, all_elim(x86.cond_eval, {f}, {4}))
qed

// jne: on when a is b
theorem tr.ccs_ne: all n a b. tr.width(n) -> all f. x86i.subf(n, a, b, f) -> (x86_64_linux.cond(f, 5) <-> !(a = b))
proof
  fix n a b
  assume hw
  fix f
  assume h
  have ha hb hz .. := expand(h, x86i.subf)
  have e1 := apply(tr.sub_zero, {n}, {a}, {b}, hw, ha, hb)
  have hp: (bits_sub(n, a, b) = 0) = false || (bits_sub(n, a, b) = 0) = true by defs(eq_prop[a := bits_sub(n, a, b), b := 0], is_prop)
  have e3 := mp(tr.prop_true, {bits_sub(n, a, b) = 0}, hp)
  have e4 := mp(tr.prop_false, {bits_sub(n, a, b) = 0}, hp)
  show by simp(hz, e1, e3, e4, all_elim(x86.cond_eval, {f}, {5}))
qed

// jb: on when b <= a (unsigned)
theorem tr.ccs_b: all n a b. tr.width(n) -> all f. x86i.subf(n, a, b, f) -> (x86_64_linux.cond(f, 2) <-> !int_le(b, a))
proof
  fix n a b
  assume hw
  fix f
  assume h
  have ha hb hz hc .. := expand(h, x86i.subf)
  have lp := apply(tr.lt_prop, {a}, {b})
  have e3 := mp(tr.prop_true, {int_lt(a, b)}, lp)
  have e4 := mp(tr.prop_false, {int_lt(a, b)}, lp)
  have ca: x86_64_linux.cond(f, 2) <-> int_lt(a, b) by simp(hc, e3, e4, all_elim(x86.cond_eval, {f}, {2}))
  have ll: int_lt(a, b) <-> !int_le(b, a) by arith(ha, hb)
  show by taut(ca, ll)
qed

// jae: on when a < b (unsigned)
theorem tr.ccs_ae: all n a b. tr.width(n) -> all f. x86i.subf(n, a, b, f) -> (x86_64_linux.cond(f, 3) <-> !int_lt(a, b))
proof
  fix n a b
  assume hw
  fix f
  assume h
  have ha hb hz hc .. := expand(h, x86i.subf)
  have lp := apply(tr.lt_prop, {a}, {b})
  have e3 := mp(tr.prop_true, {int_lt(a, b)}, lp)
  have e4 := mp(tr.prop_false, {int_lt(a, b)}, lp)
  show by simp(hc, e3, e4, all_elim(x86.cond_eval, {f}, {3}))
qed

// jbe: on when b < a (unsigned)
theorem tr.ccs_be: all n a b. tr.width(n) -> all f. x86i.subf(n, a, b, f) -> (x86_64_linux.cond(f, 6) <-> !int_lt(b, a))
proof
  fix n a b
  assume hw
  fix f
  assume h
  have ha hb hz hc .. := expand(h, x86i.subf)
  have e1 := apply(tr.sub_zero, {n}, {a}, {b}, hw, ha, hb)
  have hp: (int_lt(a, b) || bits_sub(n, a, b) = 0) = false || (int_lt(a, b) || bits_sub(n, a, b) = 0) = true
    by defs(imp_prop[a := !int_lt(a, b), b := bits_sub(n, a, b) = 0], is_prop, or)
  have e3 := mp(tr.prop_true, {int_lt(a, b) || bits_sub(n, a, b) = 0}, hp)
  have e4 := mp(tr.prop_false, {int_lt(a, b) || bits_sub(n, a, b) = 0}, hp)
  have ca: x86_64_linux.cond(f, 6) <-> (int_lt(a, b) || bits_sub(n, a, b) = 0) by simp(hc, hz, e3, e4, all_elim(x86.cond_eval, {f}, {6}))
  have ll: (int_lt(a, b) || a = b) <-> !int_lt(b, a) by arith(ha, hb)
  show by taut(ca, e1, ll)
qed

// ja: on when a <= b (unsigned)
theorem tr.ccs_a: all n a b. tr.width(n) -> all f. x86i.subf(n, a, b, f) -> (x86_64_linux.cond(f, 7) <-> !int_le(a, b))
proof
  fix n a b
  assume hw
  fix f
  assume h
  have ha hb hz hc .. := expand(h, x86i.subf)
  have e1 := apply(tr.sub_zero, {n}, {a}, {b}, hw, ha, hb)
  have hp: (int_lt(a, b) || bits_sub(n, a, b) = 0) = false || (int_lt(a, b) || bits_sub(n, a, b) = 0) = true
    by defs(imp_prop[a := !int_lt(a, b), b := bits_sub(n, a, b) = 0], is_prop, or)
  have e3 := mp(tr.prop_true, {int_lt(a, b) || bits_sub(n, a, b) = 0}, hp)
  have e4 := mp(tr.prop_false, {int_lt(a, b) || bits_sub(n, a, b) = 0}, hp)
  have ca: x86_64_linux.cond(f, 7) <-> !(int_lt(a, b) || bits_sub(n, a, b) = 0) by simp(hc, hz, e3, e4, all_elim(x86.cond_eval, {f}, {7}))
  have ll: (int_lt(a, b) || a = b) <-> int_le(a, b) by arith(ha, hb)
  show by taut(ca, e1, ll)
qed

// jl (signed, 32 bits): on when b <= a
theorem tr.ccs32_l: all n a b. n = 32 -> all f. x86i.subf(n, a, b, f) -> (x86_64_linux.cond(f, 12) <-> !int_le(sint(32, b), sint(32, a)))
proof
  fix n a b
  assume hn
  fix f
  assume h0
  have h := rewrite(hn, h0)
  have ha hb hz hc hs ho := expand(h, x86i.subf)
  let D := bits_sub(32, a, b)
  let E := int_sub(sint(32, a), sint(32, b)) = sint(32, D)
  have hs2: f.sf = bit(D, 31) by simp(hs)
  have hq: (!(bit(D, 31) = (!E))) = false || (!(bit(D, 31) = (!E))) = true by defs(imp_prop[a := bit(D, 31) = (!E), b := false], is_prop, not)
  have e3 := mp(tr.prop_true, {!(bit(D, 31) = (!E))}, hq)
  have e4 := mp(tr.prop_false, {!(bit(D, 31) = (!E))}, hq)
  have ca: x86_64_linux.cond(f, 12) <-> !(bit(D, 31) = (!E)) by simp(hz, hs2, ho, e3, e4, all_elim(x86.cond_eval, {f}, {12}))
  have pb1: bit(D, 31) = false || bit(D, 31) = true by defs(eq_prop[a := int_mod(int_div(D, pow2(31)), 2), b := 1], is_prop, bit)
  have pb2: (!E) = false || (!E) = true by defs(imp_prop[a := E, b := false], is_prop, not)
  have pe := mp(tr.prop_eq, {bit(D, 31)}, {!E}, pb1, pb2)
  have jf := apply(tr.jl_flags, {a}, {b}, ha, hb)
  have si: int_lt(sint(32, a), sint(32, b)) <-> !int_le(sint(32, b), sint(32, a)) by arith(apply(tr.sint32_int, ha), apply(tr.sint32_int, hb))
  show by taut(ca, pe, jf, si)
qed

// jns after a 32-bit compare: on when a - b, signed, is not negative (a
// compare with 0: a's sign)
theorem tr.ccs32_ns: all n a b. n = 32 -> all f. x86i.subf(n, a, b, f) -> (x86_64_linux.cond(f, 9) <-> !int_lt(sint(32, bits_sub(32, a, b)), 0))
proof
  fix n a b
  assume hn
  fix f
  assume h0
  have h := rewrite(hn, h0)
  have ha hb hz hc hs ho := expand(h, x86i.subf)
  let D := bits_sub(32, a, b)
  have hs2: f.sf = bit(D, 31) by simp(hs)
  have pb1: bit(D, 31) = false || bit(D, 31) = true by defs(eq_prop[a := int_mod(int_div(D, pow2(31)), 2), b := 1], is_prop, bit)
  have e3 := mp(tr.prop_true, {bit(D, 31)}, pb1)
  have e4 := mp(tr.prop_false, {bit(D, 31)}, pb1)
  have ca: x86_64_linux.cond(f, 9) <-> !bit(D, 31) by simp(hs2, e3, e4, all_elim(x86.cond_eval, {f}, {9}))
  // (the sign bit: D at least 2^31, sint(32, D) negative)
  have d32: D in bits(32) by simp()
  have db: bit(D, 31) <-> !int_lt(D, 2147483648) by defs(arith(d32), bit, pow2)
  have sd: (int_lt(D, 2147483648) && sint(32, D) = D) || (!int_lt(D, 2147483648) && sint(32, D) = int_sub(D, 4294967296)) by defs(simp(d32), sint, letin, pow2)
  have ng: int_lt(sint(32, D), 0) <-> !int_lt(D, 2147483648) by arith(d32, sd)
  show by taut(ca, db, ng)
qed

// jns after a compare with 0: on when a, signed, is not below 0 -- as
// GIMPLE writes the condition (`a <s 0`: sint(32, a) < sint(32, 0))
theorem tr.ccs32_ns0: all n a. n = 32 -> all f. x86i.subf(n, a, 0, f) -> (x86_64_linux.cond(f, 9) <-> !int_lt(sint(32, a), sint(32, 0)))
proof
  fix n a
  assume hn
  fix f
  assume h0
  have c := mp(all_elim(mp(all_elim(tr.ccs32_ns, {n}, {a}, {0}), hn), {f}), h0)
  have h := rewrite(hn, h0)
  have ha .. := expand(h, x86i.subf)
  have e1: bits_sub(32, a, 0) = a by defs(simp(ha), bits_sub, pow2)
  have e2: sint(32, 0) = 0 by defs(simp(), sint, letin, pow2)
  show by simp(c, e1, e2)
qed

// jge (signed, 32 bits): on when a < b
theorem tr.ccs32_ge: all n a b. n = 32 -> all f. x86i.subf(n, a, b, f) -> (x86_64_linux.cond(f, 13) <-> !int_lt(sint(32, a), sint(32, b)))
proof
  fix n a b
  assume hn
  fix f
  assume h0
  have h := rewrite(hn, h0)
  have ha hb hz hc hs ho := expand(h, x86i.subf)
  let D := bits_sub(32, a, b)
  let E := int_sub(sint(32, a), sint(32, b)) = sint(32, D)
  have hs2: f.sf = bit(D, 31) by simp(hs)
  have hq: (!(bit(D, 31) = (!E))) = false || (!(bit(D, 31) = (!E))) = true by defs(imp_prop[a := bit(D, 31) = (!E), b := false], is_prop, not)
  have e3 := mp(tr.prop_true, {!(bit(D, 31) = (!E))}, hq)
  have e4 := mp(tr.prop_false, {!(bit(D, 31) = (!E))}, hq)
  have ca: x86_64_linux.cond(f, 13) <-> !!(bit(D, 31) = (!E)) by simp(hz, hs2, ho, e3, e4, all_elim(x86.cond_eval, {f}, {13}))
  have pb1: bit(D, 31) = false || bit(D, 31) = true by defs(eq_prop[a := int_mod(int_div(D, pow2(31)), 2), b := 1], is_prop, bit)
  have pb2: (!E) = false || (!E) = true by defs(imp_prop[a := E, b := false], is_prop, not)
  have pe := mp(tr.prop_eq, {bit(D, 31)}, {!E}, pb1, pb2)
  have jf := apply(tr.jl_flags, {a}, {b}, ha, hb)
  show by taut(ca, pe, jf)
qed

// jle (signed, 32 bits): on when b < a
theorem tr.ccs32_le: all n a b. n = 32 -> all f. x86i.subf(n, a, b, f) -> (x86_64_linux.cond(f, 14) <-> !int_lt(sint(32, b), sint(32, a)))
proof
  fix n a b
  assume hn
  fix f
  assume h0
  have h := rewrite(hn, h0)
  have ha hb hz hc hs ho := expand(h, x86i.subf)
  let D := bits_sub(32, a, b)
  let E := int_sub(sint(32, a), sint(32, b)) = sint(32, D)
  have hs2: f.sf = bit(D, 31) by simp(hs)
  have hp: ((D = 0) || !(bit(D, 31) = (!E))) = false || ((D = 0) || !(bit(D, 31) = (!E))) = true
    by defs(imp_prop[a := !(D = 0), b := !(bit(D, 31) = (!E))], is_prop, or)
  have e3 := mp(tr.prop_false, {(D = 0) || !(bit(D, 31) = (!E))}, hp)
  have e4 := mp(tr.prop_true, {(D = 0) || !(bit(D, 31) = (!E))}, hp)
  have ca: x86_64_linux.cond(f, 14) <-> ((D = 0) || !(bit(D, 31) = (!E))) by simp(hz, hs2, ho, e3, e4, all_elim(x86.cond_eval, {f}, {14}))
  have pb1: bit(D, 31) = false || bit(D, 31) = true by defs(eq_prop[a := int_mod(int_div(D, pow2(31)), 2), b := 1], is_prop, bit)
  have pb2: (!E) = false || (!E) = true by defs(imp_prop[a := E, b := false], is_prop, not)
  have pe := mp(tr.prop_eq, {bit(D, 31)}, {!E}, pb1, pb2)
  have jf := apply(tr.jle_flags, {a}, {b}, ha, hb)
  have si: int_le(sint(32, a), sint(32, b)) <-> !int_lt(sint(32, b), sint(32, a)) by arith(apply(tr.sint32_int, ha), apply(tr.sint32_int, hb))
  show by taut(ca, pe, jf, si)
qed

// jg (signed, 32 bits): on when a <= b
theorem tr.ccs32_g: all n a b. n = 32 -> all f. x86i.subf(n, a, b, f) -> (x86_64_linux.cond(f, 15) <-> !int_le(sint(32, a), sint(32, b)))
proof
  fix n a b
  assume hn
  fix f
  assume h0
  have h := rewrite(hn, h0)
  have ha hb hz hc hs ho := expand(h, x86i.subf)
  let D := bits_sub(32, a, b)
  let E := int_sub(sint(32, a), sint(32, b)) = sint(32, D)
  have hs2: f.sf = bit(D, 31) by simp(hs)
  have hp: ((D = 0) || !(bit(D, 31) = (!E))) = false || ((D = 0) || !(bit(D, 31) = (!E))) = true
    by defs(imp_prop[a := !(D = 0), b := !(bit(D, 31) = (!E))], is_prop, or)
  have e3 := mp(tr.prop_false, {(D = 0) || !(bit(D, 31) = (!E))}, hp)
  have e4 := mp(tr.prop_true, {(D = 0) || !(bit(D, 31) = (!E))}, hp)
  have ca: x86_64_linux.cond(f, 15) <-> !((D = 0) || !(bit(D, 31) = (!E))) by simp(hz, hs2, ho, e3, e4, all_elim(x86.cond_eval, {f}, {15}))
  have pb1: bit(D, 31) = false || bit(D, 31) = true by defs(eq_prop[a := int_mod(int_div(D, pow2(31)), 2), b := 1], is_prop, bit)
  have pb2: (!E) = false || (!E) = true by defs(imp_prop[a := E, b := false], is_prop, not)
  have pe := mp(tr.prop_eq, {bit(D, 31)}, {!E}, pb1, pb2)
  have jf := apply(tr.jle_flags, {a}, {b}, ha, hb)
  show by taut(ca, pe, jf)
qed

// a test's je: on when r is not 0; jne: on when it is
theorem tr.ccl_e: all n r. tr.width(n) -> all f. x86i.logf(n, r, f) -> (x86_64_linux.cond(f, 4) <-> !!(r = 0))
proof
  fix n r
  assume hw
  fix f
  assume h
  have hr hz .. := expand(h, x86i.logf)
  have hp: (r = 0) = false || (r = 0) = true by defs(eq_prop[a := r, b := 0], is_prop)
  have e3 := mp(tr.prop_true, {r = 0}, hp)
  have e4 := mp(tr.prop_false, {r = 0}, hp)
  show by simp(hz, e3, e4, all_elim(x86.cond_eval, {f}, {4}))
qed

theorem tr.ccl_ne: all n r. tr.width(n) -> all f. x86i.logf(n, r, f) -> (x86_64_linux.cond(f, 5) <-> !(r = 0))
proof
  fix n r
  assume hw
  fix f
  assume h
  have hr hz .. := expand(h, x86i.logf)
  have hp: (r = 0) = false || (r = 0) = true by defs(eq_prop[a := r, b := 0], is_prop)
  have e3 := mp(tr.prop_true, {r = 0}, hp)
  have e4 := mp(tr.prop_false, {r = 0}, hp)
  show by simp(hz, e3, e4, all_elim(x86.cond_eval, {f}, {5}))
qed

// jns after a test (32 bits): on when r, signed, is not below 0 -- as
// GIMPLE writes the condition (`r <s 0`)
theorem tr.ccl32_ns: all n r. n = 32 -> all f. x86i.logf(n, r, f) -> (x86_64_linux.cond(f, 9) <-> !int_lt(sint(32, r), sint(32, 0)))
proof
  fix n r
  assume hn
  fix f
  assume h0
  have h := rewrite(hn, h0)
  have hr hz hs hc ho := expand(h, x86i.logf)
  have hs2: f.sf = bit(r, 31) by simp(hs)
  have pb1: bit(r, 31) = false || bit(r, 31) = true by defs(eq_prop[a := int_mod(int_div(r, pow2(31)), 2), b := 1], is_prop, bit)
  have e3 := mp(tr.prop_true, {bit(r, 31)}, pb1)
  have e4 := mp(tr.prop_false, {bit(r, 31)}, pb1)
  have ca: x86_64_linux.cond(f, 9) <-> !bit(r, 31) by simp(hs2, e3, e4, all_elim(x86.cond_eval, {f}, {9}))
  // (the sign bit: r at least 2^31, sint(32, r) negative)
  have db: bit(r, 31) <-> !int_lt(r, 2147483648) by defs(arith(hr), bit, pow2)
  have sd: (int_lt(r, 2147483648) && sint(32, r) = r) || (!int_lt(r, 2147483648) && sint(32, r) = int_sub(r, 4294967296)) by defs(simp(hr), sint, letin, pow2)
  have e2: sint(32, 0) = 0 by defs(simp(), sint, letin, pow2)
  have ng: int_lt(sint(32, r), 0) <-> !int_lt(r, 2147483648) by arith(hr, sd)
  have c0: x86_64_linux.cond(f, 9) <-> !int_lt(sint(32, r), 0) by taut(ca, db, ng)
  show by simp(c0, e2)
qed

// ----------------------------------------------------------------------
//  The jump: a compare's step at a (its flags ff), the condition code cc
//  read as the fall-through's condition c, the jump at a2 -- on to a3 when
//  c, to t when not

theorem tr.jcc(f. ff, zb. bkp, zb pb wb. bka): all s v base code fr a a2 a3 t len2 jn jw cc r c hs ds rs p w.
  (all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> runs(x86_64_linux.step(), m, o) ->
    (ex f. x86i.flags_ok(m, f) && ff(f) && o = ok(fn_update(fn_update(m, "rip", a2), "flags", f), empty))) ->
  (all f. ff(f) -> (x86_64_linux.cond(f, cc) <-> !c)) ->
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, base, code) -> m.rip = a2 ->
    runs(x86_64_linux.exec_body(len2, tag(jn, pair(cc, r))), m, o)) ->
  a3 = bits_add(64, a2, len2) -> t = bits_add(64, a3, bits_sext(jw, 64, r)) -> (jn = 127 && jw = 8) || (jn = 128 && jw = 32) ->
  a2 in bits(64) -> cc in bits(4) -> r in bits(32) ->
  (all m. m.rip = a2 -> !bkp(m)) -> (c -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a3, hs, ds, rs, p, w)) ->
  (!c -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, t, hs, ds, rs, p, w)) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a a2 a3 t len2 jn jw cc r c hs ds rs p w
  assume h1 hcc hat2 ha3 hta hjw ha2 hc4 hr8 hb2 pa pb
  have h2: all m o. tr.inv(s, base, code, fr, m, w) -> m.rip = a2 -> runs(x86_64_linux.step(), m, o) ->
      o = ok(fn_update(m, "rip", ite(x86_64_linux.cond(m.flags, cc), t, a3)), empty) proof
    fix m o
    assume hi hr ho
    have ipM ipU ipC .. := apply(tr.inv_parts, hi)
    have hx := mp(all_elim(hat2, {m}, {o}), ho, ipC, hr)
    have e := apply(x86i.jcc, {m}, {o}, {cc}, {r}, {len2}, {jn}, {jw}, ipM, ipU, hc4, hr8, hjw, hx)
    show by simp(e, hr, ha3, hta)
  qed
  have h3: all m f. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> ff(f) -> (x86_64_linux.cond(f, cc) <-> !c) proof
    fix m f
    assume hi hr hh hrs hf
    show := mp(all_elim(hcc, {f}), hf)
  qed
  have ha3b: a3 in bits(64) by simp(ha3)
  have htb: t in bits(64) by simp(hta)
  show := mp(tr.branch[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb), s := s, v := v, base := base, code := code, fr := fr, a := a, a2 := a2, a3 := a3, t := t, cc := cc, hs := hs, ds := ds, rs := rs, p := p, w := w,
    ff := f. ff(f), c := c], h1, h2, h3, hb2, ha2, ha3b, htb, pa, pb)
qed
