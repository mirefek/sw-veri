// C1 of loops: the loop rule.
//
// The claim with breakpoints (tr.sim, proofs/translate.core: the run to the
// first state, after a step, where the function has returned or that is a
// point of bp, with an arrival condition there). The
// loop rule (tr.loop) has the claim for a loop at its head from the claim
// for one iteration (the head a breakpoint, arrived at coupled, the
// iteration's spec returning the next locals marked) -- by induction along
// a finite run, by coinduction for an infinite one.
//
//   slc kernel-check <the translate chain> proofs/translate_loop.core

// ----------------------------------------------------------------------
//  A loop in the spec at a loop head: the loop from the locals y (the
//  world x0), then the rest k (tr.lp0; tr.lf0 its finite runs), in the
//  function's result wrapper kw (tr.lprog, tr.lpf); one iteration of it
//  (tr.lone): the body, then -- going on -- a return marked by 2^64 (no
//  64-bit word: never the function's return) with the next locals, outside
//  the wrapper, or -- leaving -- the rest in the wrapper (its marked
//  returns dropped).

def tr.mk(o) := ex a b. o = ok(a, pair(18446744073709551616, b))
def tr.lp0(y, l o. b, l. tr, x8 x1. k) := mkprog(x0 x1. ex x8. while_rel(pair(x0, y), l. true, l o. b(l, o), l. tr(l), x8) && k(x8, x1))
def tr.lf0(y, l o. b, x8 x1. k) := mkprog(x0 x1. ex x8. while_fin_rel(pair(x0, y), l. true, l o. b(l, o), x8) && k(x8, x1))
def tr.lprog(y, l o. b, l. tr, x8 x1. k, x3 x4 x2. kw) :=
  mkprog(x1 x2. bind_rel(tr.lp0(y, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))
def tr.lpf(y, l o. b, x8 x1. k, x3 x4 x2. kw) :=
  mkprog(x1 x2. bind_rel(tr.lf0(y, l o. b(l, o), x8 x1. k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))
// (an outcome)
def tr.isout(o) := (ex a b. o = ok(a, b)) || (ex a b. o = exc(a, b)) || (ex t. o = diverge(t))
// (an iteration's end with the body's outcome r: marked on, or the rest in
// the wrapper from r's world, its marked returns dropped)
def tr.lcont(r, o, x8 x1. k, x3 x4 x2. kw) := (ex w2 y2. r = ok(pair(w2, y2), empty) && o = ok(w2, pair(18446744073709551616, y2))) ||
  (!is_ok(r) && bind_rel(mkprog(x0 x3. k(r, x3)), fst(out_state(r)), x4 x5. kw(x4, x5, o), x4 x5. o = exc(x4, x5), x4. o = diverge(x4)) && !tr.mk(o) && tr.isout(o))
// (the iteration as a procedure, and in the identity wrapper -- as the
// engine walks a point's rest, in a wrapper)
def tr.liter(y, l o. b, x8 x1. k, x3 x4 x2. kw) := mkprog(x0 x3. ex x8. b(pair(x0, y), x8) && tr.lcont(x8, x3, x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)))
def tr.lone(y, l o. b, x8 x1. k, x3 x4 x2. kw) := mkprog(x1 x2. bind_rel(tr.liter(y, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), x1, x3 x4. x2 = ok(x3, x4), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))

// (the wrapper around a program with fewer runs: fewer runs)
theorem tr.wrap_mono(x3 x4 x2. kw): all q1 q2 w w2 o. w in univ(1) -> (all o1. runs(q2, w2, o1) -> runs(q1, w, o1)) ->
  runs(mkprog(x1 x2. bind_rel(q2, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w2, o) ->
  runs(mkprog(x1 x2. bind_rel(q1, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, o)
proof
  fix q1 q2 w w2 o
  assume hw hq hr
  have pu := apply(g.runs_univ, hr)
  have u: pair(w, o) in univ(1) by simp(hw, pu)
  have b2 := apply(g.runs_elim, hr)
  obtain o1, r1 c1 from expand(b2, bind_rel)
  have r2 := mp(all_elim(hq, {o1}), r1)
  have b1: bind_rel(q1, w, x3 x4. kw(x3, x4, o), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) by defs(ex_intro({o1}, taut(r2, c1)), bind_rel)
  show := apply(tr.runs_intro[r := x1 x2. bind_rel(q1, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))], {w}, {o}, u, b1)
qed

// (the identity wrapper: the program's runs -- of its outcomes)
theorem tr.wrap_id_out(x y. r): all w o. runs(mkprog(x1 x2. bind_rel(mkprog(x y. r(x, y)), x1, x3 x4. x2 = ok(x3, x4), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, o) -> runs(mkprog(x y. r(x, y)), w, o)
proof
  fix w o
  assume hr
  have b := apply(g.runs_elim, hr)
  obtain o1, r1 c1 from expand(b, bind_rel)
  have k1: (ex s1 v1. o1 = ok(s1, v1) && o = ok(s1, v1)) -> o = o1 proof
    assume e
    obtain s1 v1, e1 e2 from e
    show := trans(e2, sym(e1))
  qed
  have k2: (ex s1 e0. o1 = exc(s1, e0) && o = exc(s1, e0)) -> o = o1 proof
    assume e
    obtain s1 e0, e1 e2 from e
    show := trans(e2, sym(e1))
  qed
  have k3: (ex t0. o1 = diverge(t0) && o = diverge(t0)) -> o = o1 proof
    assume e
    obtain t0, e1 e2 from e
    show := trans(e2, sym(e1))
  qed
  have oe: o = o1 by taut(c1, k1, k2, k3)
  show := rewrite(sym(oe), r1)
qed

theorem tr.wrap_id_in(x y. r): all w o. runs(mkprog(x y. r(x, y)), w, o) -> tr.isout(o) -> runs(mkprog(x1 x2. bind_rel(mkprog(x y. r(x, y)), x1, x3 x4. x2 = ok(x3, x4), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, o)
proof
  fix w o
  assume hr io
  have pu := apply(g.runs_univ, hr)
  have k1: (ex a b. o = ok(a, b)) -> (ex s1 v1. o = ok(s1, v1) && o = ok(s1, v1)) proof
    assume e
    obtain a b, e1 from e
    show by ex_intro({a}, {b}, taut(e1))
  qed
  have k2: (ex a b. o = exc(a, b)) -> (ex s1 e0. o = exc(s1, e0) && o = exc(s1, e0)) proof
    assume e
    obtain a b, e1 from e
    show by ex_intro({a}, {b}, taut(e1))
  qed
  have k3: (ex t0. o = diverge(t0)) -> (ex t1. o = diverge(t1) && o = diverge(t1)) proof
    assume e
    obtain t0, e1 from e
    show by ex_intro({t0}, taut(e1))
  qed
  have cs: (ex s1 v1. o = ok(s1, v1) && o = ok(s1, v1)) || (ex s1 e0. o = exc(s1, e0) && o = exc(s1, e0)) || (ex t1. o = diverge(t1) && o = diverge(t1))
    by taut(expand(io, tr.isout), k1, k2, k3)
  have b: bind_rel(mkprog(x y. r(x, y)), w, x3 x4. o = ok(x3, x4), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) by defs(ex_intro({o}, taut(hr, cs)), bind_rel)
  show := apply(tr.runs_intro[r := x1 x2. bind_rel(mkprog(x y. r(x, y)), x1, x3 x4. x2 = ok(x3, x4), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))], {w}, {o}, pu, b)
qed

// (an iteration's outcome, unmarked: the loop's, of no further iteration)
theorem tr.lone_f(l o. b, x8 x1. k, x3 x4 x2. kw): all w y o. runs(tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w, o) -> !tr.mk(o) ->
  runs(tr.lpf(y, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w, o)
proof
  fix w y o
  assume hr hm
  have hq := apply(tr.wrap_id_out[r := x0 x3. ex x8. b(pair(x0, y), x8) && tr.lcont(x8, x3, x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2))], {w}, {o}, expand(hr, tr.lone, tr.liter))
  have tt: true by taut()
  have pu := apply(g.runs_univ, hq)
  have wu: w in univ(1) by simp(pu)
  obtain x8, br cr0 from apply(g.runs_elim, hq)
  have cr := expand(cr0, tr.lcont)
  have go: (ex w2 y2. x8 = ok(pair(w2, y2), empty) && o = ok(w2, pair(18446744073709551616, y2))) -> false proof
    assume e
    obtain w2 y2, _ oe from e
    have m: tr.mk(o) by defs(ex_intro({w2}, {y2}, oe), tr.mk)
    show by taut(m, hm)
  qed
  have lv: !is_ok(x8) && bind_rel(mkprog(x0 x3. k(x8, x3)), fst(out_state(x8)), x4 x5. kw(x4, x5, o), x4 x5. o = exc(x4, x5), x4. o = diverge(x4)) by taut(cr, go)
  obtain o1, r1 c1 from expand(lv.2, bind_rel)
  have pu1 := apply(g.runs_univ, r1)
  have k1 := apply(g.runs_elim, r1)
  have u1: pair(w, o1) in univ(1) by simp(wu, pu1)
  have w1 := mp(while_fin_one[l0 := pair(w, y), c := l. true, b := l o. b(l, o), r := x8], taut(tt, br, lv.1))
  have r0: ex x9. while_fin_rel(pair(w, y), l. true, l o. b(l, o), x9) && k(x9, o1) by ex_intro({x8}, taut(w1, k1))
  have rf0 := apply(tr.runs_intro[r := x0 x1. ex x9. while_fin_rel(pair(x0, y), l. true, l o. b(l, o), x9) && k(x9, x1)], {w}, {o1}, u1, r0)
  have rf: runs(tr.lf0(y, l o. b(l, o), x8 x1. k(x8, x1)), w, o1) by defs(rf0, tr.lf0)
  have b1: bind_rel(tr.lf0(y, l o. b(l, o), x8 x1. k(x8, x1)), w, x3 x4. kw(x3, x4, o), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) by defs(ex_intro({o1}, taut(rf, c1)), bind_rel)
  have r2 := apply(tr.runs_intro[r := x1 x2. bind_rel(tr.lf0(y, l o. b(l, o), x8 x1. k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))], {w}, {o}, pu, b1)
  show by defs(r2, tr.lpf)
qed

// (an iteration's marked return: the body went on, to y2)
theorem tr.lone_mk(l o. b, x8 x1. k, x3 x4 x2. kw): all w y w2 y2. runs(tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w, ok(w2, pair(18446744073709551616, y2))) ->
  b(pair(w, y), ok(pair(w2, y2), empty))
proof
  fix w y w2 y2
  assume hr
  have hq := apply(tr.wrap_id_out[r := x0 x3. ex x8. b(pair(x0, y), x8) && tr.lcont(x8, x3, x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2))], {w}, {ok(w2, pair(18446744073709551616, y2))}, expand(hr, tr.lone, tr.liter))
  obtain x8, br cr0 from apply(g.runs_elim, hq)
  have cr := expand(cr0, tr.lcont)
  have m: tr.mk(ok(w2, pair(18446744073709551616, y2))) by defs(ex_intro({w2}, {y2}, refl({ok(w2, pair(18446744073709551616, y2))})), tr.mk)
  have c1: ex w3 y3. x8 = ok(pair(w3, y3), empty) && ok(w2, pair(18446744073709551616, y2)) = ok(w3, pair(18446744073709551616, y3)) by taut(cr, m)
  obtain w3 y3, xe oe from c1
  have e1: w3 = w2 && y3 = y2 by simp(oe)
  have xe2: x8 = ok(pair(w2, y2), empty) by simp(xe, e1)
  show := rewrite(xe2, br)
qed

// (an iteration, then a finite run from y2: a finite run from y, the same
// outcome)
theorem tr.lf0_step(l o. b, x8 x1. k): all w y w2 y2 o. w in univ(1) -> b(pair(w, y), ok(pair(w2, y2), empty)) ->
  runs(tr.lf0(y2, l o. b(l, o), x8 x1. k(x8, x1)), w2, o) -> runs(tr.lf0(y, l o. b(l, o), x8 x1. k(x8, x1)), w, o)
proof
  fix w y w2 y2 o
  assume hw hb hr
  have tt: true by taut()
  have pu := apply(g.runs_univ, expand(hr, tr.lf0))
  have u: pair(w, o) in univ(1) by simp(hw, pu)
  obtain x8, wr kr from apply(g.runs_elim, expand(hr, tr.lf0))
  have w1 := mp(while_step_fin[l0 := pair(w, y), l1 := pair(w2, y2), c := l. true, b := l o. b(l, o), r := x8], tt, hb, wr)
  have r0: ex x9. while_fin_rel(pair(w, y), l. true, l o. b(l, o), x9) && k(x9, o) by ex_intro({x8}, taut(w1, kr))
  have r1 := apply(tr.runs_intro[r := x0 x1. ex x9. while_fin_rel(pair(x0, y), l. true, l o. b(l, o), x9) && k(x9, x1)], {w}, {o}, u, r0)
  show by defs(r1, tr.lf0)
qed

theorem tr.lpf_step(l o. b, x8 x1. k, x3 x4 x2. kw): all w y w2 y2 o. w in univ(1) -> b(pair(w, y), ok(pair(w2, y2), empty)) ->
  runs(tr.lpf(y2, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w2, o) -> runs(tr.lpf(y, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w, o)
proof
  fix w y w2 y2 o
  assume hw hb hr
  have hq: all o1. runs(tr.lf0(y2, l o. b(l, o), x8 x1. k(x8, x1)), w2, o1) -> runs(tr.lf0(y, l o. b(l, o), x8 x1. k(x8, x1)), w, o1) proof
    fix o1
    assume h1
    show := apply(tr.lf0_step[b := l o. b(l, o), k := x8 x1. k(x8, x1)], {w}, {y}, {w2}, {y2}, {o1}, hw, hb, h1)
  qed
  have r := apply(tr.wrap_mono[kw := x3 x4 x2. kw(x3, x4, x2)], {tr.lf0(y, l o. b(l, o), x8 x1. k(x8, x1))}, {tr.lf0(y2, l o. b(l, o), x8 x1. k(x8, x1))}, {w}, {w2}, {o}, hw, hq, expand(hr, tr.lpf))
  show by defs(r, tr.lpf)
qed

// (a finite run: a run of the loop)
theorem tr.lpf_lp(l o. b, l. tr, x8 x1. k, x3 x4 x2. kw): all w y o. runs(tr.lpf(y, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w, o) ->
  runs(tr.lprog(y, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w, o)
proof
  fix w y o
  assume hr
  have pu := apply(g.runs_univ, expand(hr, tr.lpf))
  have wu: w in univ(1) by simp(pu)
  have hq: all o1. runs(tr.lf0(y, l o. b(l, o), x8 x1. k(x8, x1)), w, o1) -> runs(tr.lp0(y, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1)), w, o1) proof
    fix o1
    assume h1
    have pu1 := apply(g.runs_univ, expand(h1, tr.lf0))
    obtain x8, wr kr from apply(g.runs_elim, expand(h1, tr.lf0))
    have w1 := mp(while_fin_while[l0 := pair(w, y), c := l. true, b := l o. b(l, o), tr := l. tr(l), r := x8], wr)
    have r0: ex x9. while_rel(pair(w, y), l. true, l o. b(l, o), l. tr(l), x9) && k(x9, o1) by ex_intro({x8}, taut(w1, kr))
    have r1 := apply(tr.runs_intro[r := x0 x1. ex x9. while_rel(pair(x0, y), l. true, l o. b(l, o), l. tr(l), x9) && k(x9, x1)], {w}, {o1}, pu1, r0)
    show by defs(r1, tr.lp0)
  qed
  have r := apply(tr.wrap_mono[kw := x3 x4 x2. kw(x3, x4, x2)], {tr.lp0(y, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1))}, {tr.lf0(y, l o. b(l, o), x8 x1. k(x8, x1))}, {w}, {w}, {o}, wu, hq, expand(hr, tr.lpf))
  show by defs(r, tr.lprog)
qed

// ----------------------------------------------------------------------
//  The loop's outcome conditions

// the outcome o as the spec's: undefined, a crash, a divergence, or the
// return (no point of bp)
def tr.lg(s, z. bp, v, p, w, o) := tr.ub(s, v, p, w) || tr.crash(s, p, w, o) || tr.div(p, w, o) ||
  (ex m1. o = ok(m1, empty) && tr.out(s, m1) && tr.retok(s, v, p, w, m1))

// (... carried to a spec with those outcomes: its exceptions, divergences,
// returns of a 64-bit word)
theorem tr.lg_mono(z. bp): all s v p w p2 w2 o.
  (all x e. runs(p2, w2, exc(x, e)) -> runs(p, w, exc(x, e))) -> (all t. runs(p2, w2, diverge(t)) -> runs(p, w, diverge(t))) ->
  (all w3 r0 r1. r0 in bits(64) -> runs(p2, w2, ok(w3, pair(r0, r1))) -> runs(p, w, ok(w3, pair(r0, r1)))) ->
  tr.lg(s, z. bp(z), v, p2, w2, o) -> tr.lg(s, z. bp(z), v, p, w, o)
proof
  fix s v p w p2 w2 o
  assume hx hd hk h
  have c1: tr.ub(s, v, p2, w2) -> tr.ub(s, v, p, w) proof
    assume u
    obtain e x, eu en ena rs rr from expand(u, tr.ub)
    have r := mp(all_elim(hx, {x}, {e}), rr)
    show by defs(ex_intro({e}, {x}, taut(eu, en, ena, rs, r)), tr.ub)
  qed
  have c2: tr.crash(s, p2, w2, o) -> tr.crash(s, p, w, o) proof
    assume c
    obtain m1 a k0, c3 from expand(c, tr.crash)
    have o2: tr.ovf(p2, w2, m1.os) -> tr.ovf(p, w, m1.os) proof
      assume hv
      have e1: (ex x. x in rec_and(abi.World, single(empty)) && runs(p2, w2, exc(x, exc_val("stack_overflow", empty))) && x.os.events = m1.os.events) ->
          tr.ovf(p, w, m1.os) proof
        assume e
        obtain x, xa xr xe from e
        have r := mp(all_elim(hx, {x}, {exc_val("stack_overflow", empty)}), xr)
        have e2: ex x1. x1 in rec_and(abi.World, single(empty)) && runs(p, w, exc(x1, exc_val("stack_overflow", empty))) && x1.os.events = m1.os.events
          by ex_intro({x}, taut(xa, r, xe))
        show by defs(taut(e2), tr.ovf)
      qed
      have e3: (ex t. runs(p2, w2, diverge(t))) -> tr.ovf(p, w, m1.os) proof
        assume e
        obtain t, tr2 from e
        have r := mp(all_elim(hd, {t}), tr2)
        have e2: ex t1. runs(p, w, diverge(t1)) by ex_intro({t}, r)
        show by defs(taut(e2), tr.ovf)
      qed
      show by taut(expand(hv, tr.ovf), e1, e3)
    qed
    show by defs(ex_intro({m1}, {a}, {k0}, taut(c3, o2)), tr.crash)
  qed
  have c3: tr.div(p2, w2, o) -> tr.div(p, w, o) proof
    assume d
    have d1 d2 := expand(d, tr.div)
    obtain t, rt from d2
    have r := mp(all_elim(hd, {t}), rt)
    have e2: ex t1. runs(p, w, diverge(t1)) by ex_intro({t}, r)
    show by defs(taut(d1, e2), tr.div)
  qed
  have c4: (ex m1. o = ok(m1, empty) && tr.out(s, m1) && tr.retok(s, v, p2, w2, m1)) ->
      (ex m1. o = ok(m1, empty) && tr.out(s, m1) && tr.retok(s, v, p, w, m1)) proof
    assume e
    obtain m1, oe ar rt from e
    have rx := expand(rt, tr.retok)
    have mM: m1 in x86_64_linux.Machine by taut(rx)
    have ew: ex w3. runs(p2, w2, ok(w3, pair(m1.gpr[0], m1.gpr[2]))) && w3 in abi.World && w3 in univ(1) &&
        abi.world_matches(s.vm, m1.vm, w3.vm, abi.wob(v, w3.objs.c_bytes), s.fs_base, abi.sp(s)) && m1.os = w3.os && m1.fs_base = s.fs_base by taut(rx)
    obtain w3, h3 from ew
    have r0: 0 in x86_64_linux.Reg by simp()
    have rb := apply(x86i.reg_typed, mM, r0)
    have r := mp(all_elim(hk, {w3}, {m1.gpr[0]}, {m1.gpr[2]}), rb, h3.1)
    have ew2: ex w4. runs(p, w, ok(w4, pair(m1.gpr[0], m1.gpr[2]))) && w4 in abi.World && w4 in univ(1) &&
        abi.world_matches(s.vm, m1.vm, w4.vm, abi.wob(v, w4.objs.c_bytes), s.fs_base, abi.sp(s)) && m1.os = w4.os && m1.fs_base = s.fs_base
      by ex_intro({w3}, taut(r, h3))
    have rt2: tr.retok(s, v, p, w, m1) by defs(taut(rx, ew2), tr.retok)
    show by ex_intro({m1}, taut(oe, ar, rt2))
  qed
  show by defs(taut(expand(h, tr.lg), c1, c2, c3, c4), tr.lg)
qed

// ----------------------------------------------------------------------
//  A loop: its head h (the rip and rsp of a state), the coupling q(x, y, w)
//  of a machine state at the head with the spec's locals y and world w.
//  The claim for one iteration (tr.lone) with the head as a breakpoint,
//  arriving there coupled, the spec returning the next locals marked;
//  so the claim for the loop.

def tr.hd(x) := pair(x.rip, x.gpr[4])

// (an iteration: as the loop's run ends, or back at the head after one
// pass of the body)
theorem tr.loop_d(s, v, z. hp, z. bp, l o. b, x8 x1. k, x3 x4 x2. kw, x y w. q):
  (all x y w. q(x, y, w) -> tr.sim(s, z. hp(z) || bp(z), z p2 w2. hp(z) && (ex y2. q(z, y2, w2) && runs(p2, w2, ok(w2, pair(18446744073709551616, y2)))),
    v, tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w, x)) ->
  all x y w o. q(x, y, w) -> tr.run_k(s, z. hp(z) || bp(z), x, o) ->
    tr.lg(s, z. bp(z), v, tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w, o) ||
    (ex m1 y2 w2. o = ok(m1, empty) && q(m1, y2, w2) && b(pair(w, y), ok(pair(w2, y2), empty)))
proof
  assume hb
  fix x y w o
  assume hq hr
  let P := tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2))
  let G := tr.lg(s, z. bp(z), v, P, w, o) || (ex m1 y2 w2. o = ok(m1, empty) && q(m1, y2, w2) && b(pair(w, y), ok(pair(w2, y2), empty)))
  have c := mp(all_elim(expand(mp(all_elim(hb, {x}, {y}, {w}), hq), tr.sim), {o}), hr)
  have u: tr.ub(s, v, P, w) || tr.crash(s, P, w, o) || tr.div(P, w, o) -> G proof
    assume e
    have l: tr.lg(s, z. bp(z), v, P, w, o) by defs(taut(e), tr.lg)
    show by taut(l)
  qed
  have a: (ex m1. o = ok(m1, empty) && tr.arr(s, z. hp(z) || bp(z), z p2 w2. hp(z) && (ex y2. q(z, y2, w2) && runs(p2, w2, ok(w2, pair(18446744073709551616, y2)))),
      v, m1, P, w)) -> G proof
    assume e
    obtain m1, oe ha from e
    have ar1 ar2 := expand(ha, tr.arr)
    have st := apply(tr.run_k_stop[bkp := z. hp(z) || bp(z)], {s}, {x}, {m1}, {empty}, rewrite(oe, hr))
    // not returned: at the head or a point of bp -- the head, after a pass
    // of the body
    have c1: !tr.out(s, m1) -> G proof
      assume no
      have hp: hp(m1) || bp(m1) by taut(expand(st, tr.stopk), no)
      obtain p2 w2, rd hy from mp(ar2, no, hp)
      obtain y2, q2 r2 from hy.2
      have r1 := mp(all_elim(expand(rd, tr.red), {ok(w2, pair(18446744073709551616, y2))}), r2)
      have bs := apply(tr.lone_mk[b := l o. b(l, o), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {y}, {w2}, {y2}, r1)
      have e2: ex m2 y3 w3. o = ok(m2, empty) && q(m2, y3, w3) && b(pair(w, y), ok(pair(w3, y3), empty)) by ex_intro({m1}, {y2}, {w2}, taut(oe, q2, bs))
      show by taut(e2)
    qed
    // returned
    have c2: tr.out(s, m1) -> G proof
      assume at
      have rt := mp(ar1, at)
      have e2: ex m2. o = ok(m2, empty) && tr.out(s, m2) && tr.retok(s, v, P, w, m2) by ex_intro({m1}, taut(oe, at, rt))
      have l: tr.lg(s, z. bp(z), v, P, w, o) by defs(taut(e2), tr.lg)
      show by taut(l)
    qed
    show by taut(c1, c2)
  qed
  show by taut(expand(c, tr.gk), u, a)
qed

// (an iteration's outcome at y, w -- reached from y0, w0 by finitely many
// passes of the body: the loop's from y0, w0)
theorem tr.loop_e(s, v, z. bp, l o. b, l. tr, x8 x1. k, x3 x4 x2. kw): all y w y0 w0 o.
  (all o2. runs(tr.lpf(y, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w, o2) -> runs(tr.lpf(y0, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w0, o2)) ->
  tr.lg(s, z. bp(z), v, tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w, o) -> tr.lg(s, z. bp(z), v, tr.lprog(y0, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w0, o)
proof
  fix y w y0 w0 o
  assume hr hl
  let P1 := tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2))
  let P0 := tr.lprog(y0, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2))
  // an unmarked outcome: a finite run from y, so from y0
  have t: all o2. runs(P1, w, o2) -> !tr.mk(o2) -> runs(P0, w0, o2) proof
    fix o2
    assume r1 nm
    have f1 := apply(tr.lone_f[b := l o. b(l, o), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {y}, {o2}, r1, nm)
    have f0 := mp(all_elim(hr, {o2}), f1)
    show := apply(tr.lpf_lp[b := l o. b(l, o), tr := l. tr(l), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w0}, {y0}, {o2}, f0)
  qed
  have tx: all x e. runs(P1, w, exc(x, e)) -> runs(P0, w0, exc(x, e)) proof
    fix x e
    assume r1
    have nm0: tr.mk(exc(x, e)) -> false proof
      assume m
      obtain a b0, me from expand(m, tr.mk)
      show by simp(me)
    qed
    show := mp(all_elim(t, {exc(x, e)}), r1, taut(nm0))
  qed
  have td: all t1. runs(P1, w, diverge(t1)) -> runs(P0, w0, diverge(t1)) proof
    fix t1
    assume r1
    have nm0: tr.mk(diverge(t1)) -> false proof
      assume m
      obtain a b0, me from expand(m, tr.mk)
      show by simp(me)
    qed
    show := mp(all_elim(t, {diverge(t1)}), r1, taut(nm0))
  qed
  have tk: all w3 r0 r1. r0 in bits(64) -> runs(P1, w, ok(w3, pair(r0, r1))) -> runs(P0, w0, ok(w3, pair(r0, r1))) proof
    fix w3 r0 r1
    assume rb r2
    have nm0: tr.mk(ok(w3, pair(r0, r1))) -> false proof
      assume m
      obtain a b0, me from expand(m, tr.mk)
      have e: r0 = 18446744073709551616 by simp(me)
      show by arith(e, rb)
    qed
    show := mp(all_elim(t, {ok(w3, pair(r0, r1))}), r2, taut(nm0))
  qed
  show := apply(tr.lg_mono[bp := z. bp(z)], {s}, {v}, {P0}, {w0}, {P1}, {w}, {o}, tx, td, tk, hl)
qed

// (a state at the head: not the return)
theorem tr.hd_nret(s, h, x y w. q): (all x y w. q(x, y, w) -> tr.hd(x) = h && !tr.out(s, x)) ->
  all x y w m. q(x, y, w) -> tr.hd(m) = h -> !tr.out(s, m)
proof
  assume hq
  fix x y w m
  assume q0 hm
  have c := mp(all_elim(hq, {x}, {y}, {w}), q0)
  have e: m.rip = x.rip && m.gpr[4] = x.gpr[4] by simp(expand(hm, tr.hd), expand(c.1, tr.hd))
  have n: tr.out(s, m) -> false proof
    assume a
    have a2: tr.out(s, x) := rewrite(e.2, a)
    show by taut(a2, c.2)
  qed
  show by taut(n)
qed

// The loop's finite runs: each as the spec's from the loop
theorem tr.loop_fin(s, v, z. hp, z. bp, l o. b, l. tr, x8 x1. k, x3 x4 x2. kw, x y w. q):
  (all x y w. q(x, y, w) -> hp(x) && !bp(x) && !tr.out(s, x) && w in univ(1) && pair(w, y) in univ(1)) ->
  (all x y w. q(x, y, w) -> tr.sim(s, z. hp(z) || bp(z), z p2 w2. hp(z) && (ex y2. q(z, y2, w2) && runs(p2, w2, ok(w2, pair(18446744073709551616, y2)))),
    v, tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w, x)) ->
  (all x y w m. q(x, y, w) -> hp(m) -> !tr.out(s, m)) ->
  all x0 y0 w0 r o. q(x0, y0, w0) -> tr.rk(s, z. bp(z), x0, r) -> tr.rmap(r, o) -> !(fst(r) = 2) ->
    tr.lg(s, z. bp(z), v, tr.lprog(y0, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w0, o)
proof
  assume hq hb hnr
  fix x0 y0 w0 r o
  assume hq0 hrk hrm hnd
  have tt: true by taut()
  let LG := tr.lg(s, z. bp(z), v, tr.lprog(y0, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w0, o)
  let PF(y) := tr.lpf(y, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2))
  let RCH(y, w) := all o2. runs(PF(y), w, o2) -> runs(PF(y0), w0, o2)
  let MR(x, l) := all r1. !(fst(r1) = 2) -> tr.rwk(s, z. hp(z) || bp(z), l, r1) -> tr.rk(s, z. hp(z) || bp(z), x, r1)
  let TR(x5) := fn_update(empty, "os.events", fst(x5).os.events)
  have hd := mp(tr.loop_d[s := s, v := v, hp := z. hp(z), bp := z. bp(z), b := l o. b(l, o), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2), q := x y w. q(x, y, w)], hb)
  have hrun: tr.run_k(s, z. bp(z), x0, o) by defs(ex_intro({r}, taut(hrk, hrm)), tr.run_k)
  // (the run's return: at a stop of bp -- no head)
  have fo: all m1 y w. o = ok(m1, empty) -> q(m1, y, w) -> false proof
    fix m1 y w
    assume oe q1
    have st := apply(tr.run_k_stop[bkp := z. bp(z)], {s}, {x0}, {m1}, {empty}, rewrite(oe, hrun))
    have c := mp(all_elim(hq, {m1}, {y}, {w}), q1)
    show by taut(expand(st, tr.stopk), c)
  qed
  // an iteration from x ending the loop's run: the run as the spec's
  have h1: all x y w. q(x, y, w) -> RCH(y, w) -> tr.run_k(s, z. hp(z) || bp(z), x, o) -> LG proof
    fix x y w
    assume q1 rc hr
    have d := mp(all_elim(hd, {x}, {y}, {w}, {o}), q1, hr)
    have c1: tr.lg(s, z. bp(z), v, tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w, o) -> LG proof
      assume l1
      show := apply(tr.loop_e[s := s, v := v, bp := z. bp(z), b := l o. b(l, o), tr := l. tr(l), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {y}, {w}, {y0}, {w0}, {o}, rc, l1)
    qed
    have c2: (ex m1 y2 w2. o = ok(m1, empty) && q(m1, y2, w2) && b(pair(w, y), ok(pair(w2, y2), empty))) -> LG proof
      assume e
      obtain m1 y2 w2, oe q2 _ from e
      have f := mp(all_elim(fo, {m1}, {y2}, {w2}), oe, q2)
      show by taut(f)
    qed
    show by taut(d, c1, c2)
  qed
  // an iteration from x back at the head, at l: the loop's run as the
  // spec's, or the head's coupling, reached from y0
  have h2: all x y w l. q(x, y, w) -> RCH(y, w) -> tr.run_k(s, z. hp(z) || bp(z), x, ok(fst(l), empty)) -> hp(fst(l)) ->
      LG || (ex y2 w2. q(fst(l), y2, w2) && RCH(y2, w2)) proof
    fix x y w l
    assume q1 rc hr hh
    have hw: w in univ(1) by taut(mp(all_elim(hq, {x}, {y}, {w}), q1))
    have d := mp(all_elim(hd, {x}, {y}, {w}, {ok(fst(l), empty)}), q1, hr)
    let P1 := tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2))
    have c1: tr.lg(s, z. bp(z), v, P1, w, ok(fst(l), empty)) -> LG proof
      assume l1
      have u: tr.ub(s, v, P1, w) -> LG proof
        assume hu
        have l2: tr.lg(s, z. bp(z), v, P1, w, o) by defs(taut(hu), tr.lg)
        show := apply(tr.loop_e[s := s, v := v, bp := z. bp(z), b := l o. b(l, o), tr := l. tr(l), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {y}, {w}, {y0}, {w0}, {o}, rc, l2)
      qed
      have cr: tr.crash(s, P1, w, ok(fst(l), empty)) -> false proof
        assume c
        obtain m1 a k0, {oe} from expand(c, tr.crash)
        show by simp(oe)
      qed
      have dv: tr.div(P1, w, ok(fst(l), empty)) -> false proof
        assume c
        obtain t, te from expand(c, tr.div).1
        show by simp(te)
      qed
      have rt: (ex m1. ok(fst(l), empty) = ok(m1, empty) && tr.out(s, m1) && tr.retok(s, v, P1, w, m1)) -> false proof
        assume e
        obtain m1, oe at _ from e
        have me: m1 = fst(l) by simp(oe)
        have at2: tr.out(s, fst(l)) := rewrite(me, at)
        have na := mp(all_elim(hnr, {x}, {y}, {w}, {fst(l)}), q1, hh)
        show by taut(at2, na)
      qed
      show by taut(expand(l1, tr.lg), u, cr, dv, rt)
    qed
    have c2: (ex m1 y2 w2. ok(fst(l), empty) = ok(m1, empty) && q(m1, y2, w2) && b(pair(w, y), ok(pair(w2, y2), empty))) ->
        (ex y2 w2. q(fst(l), y2, w2) && RCH(y2, w2)) proof
      assume e
      obtain m1 y2 w2, oe q2 bs from e
      have me: m1 = fst(l) by simp(oe)
      have q3: q(fst(l), y2, w2) := rewrite(me, q2)
      have rc2: RCH(y2, w2) proof
        fix o2
        assume r2
        have r1 := apply(tr.lpf_step[b := l o. b(l, o), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {y}, {w2}, {y2}, {o2}, hw, bs, r2)
        show := mp(all_elim(rc, {o2}), r1)
      qed
      show by ex_intro({y2}, {w2}, taut(q3, rc2))
    qed
    show by taut(d, c1, c2)
  qed
  // arriving at the head at l (a break of the iteration's run): the loop
  // from there
  have ha: all l x y w. l = pair(fst(l), empty) -> q(x, y, w) -> RCH(y, w) -> MR(x, l) -> hp(fst(l)) ->
      (all y2 w2. q(fst(l), y2, w2) -> RCH(y2, w2) -> LG) -> LG proof
    fix l x y w
    assume ql q1 rc mr hh hh2
    have st: tr.stopk(s, z. hp(z) || bp(z), fst(l)) by defs(taut(hh), tr.stopk)
    have rb: tr.rbk(s, z. hp(z) || bp(z), l, exc(pair(fst(l), empty), pair("brk", empty))) by defs(taut(st, refl({exc(pair(fst(l), empty), pair("brk", empty))})), tr.rbk)
    have nok: !is_ok(exc(pair(fst(l), empty), pair("brk", empty))) by defs(simp(), is_ok)
    have w1 := mp(while_leave[l0 := l, c := x5. true, b := x5 x6. tr.rbk(s, z. hp(z) || bp(z), x5, x6), tr := x5. TR(x5), r := exc(pair(fst(l), empty), pair("brk", empty))], tt, rb, nok)
    have w2: tr.rwk(s, z. hp(z) || bp(z), l, exc(pair(fst(l), empty), pair("brk", empty))) by defs(w1, tr.rwk)
    have nd: !(fst(exc(pair(fst(l), empty), pair("brk", empty))) = 2) by simp()
    have rk := mp(all_elim(mr, {exc(pair(fst(l), empty), pair("brk", empty))}), nd, w2)
    have rm: tr.rmap(exc(pair(fst(l), empty), pair("brk", empty)), ok(fst(l), empty)) by defs(simp(), tr.rmap)
    have hr: tr.run_k(s, z. hp(z) || bp(z), x, ok(fst(l), empty)) by defs(ex_intro({exc(pair(fst(l), empty), pair("brk", empty))}, taut(rk, rm)), tr.run_k)
    have c := mp(all_elim(h2, {x}, {y}, {w}, {l}), q1, rc, hr, hh)
    have c2: (ex y2 w2. q(fst(l), y2, w2) && RCH(y2, w2)) -> LG proof
      assume e
      obtain y2 w2, q2 rc2 from e
      show := mp(all_elim(hh2, {y2}, {w2}), q2, rc2)
    qed
    show by taut(c, c2)
  qed
  let Z(l) := l = pair(fst(l), empty) -> (all x y w. q(x, y, w) -> RCH(y, w) -> MR(x, l) -> LG) && (all y w. q(fst(l), y, w) -> RCH(y, w) -> LG)
  // where the run ends
  have zb: all l. ((!true && r = ok(l, empty)) || (true && tr.rbk(s, z. bp(z), l, r) && !is_ok(r))) -> Z(l) proof
    fix l
    assume hl ql
    have hb1: tr.rbk(s, z. bp(z), l, r) && !is_ok(r) by taut(hl)
    have p2: all y w. q(fst(l), y, w) -> RCH(y, w) -> LG proof
      fix y w
      assume q1 rc
      have c := mp(all_elim(hq, {fst(l)}, {y}, {w}), q1)
      have nst: !tr.stopk(s, z. bp(z), fst(l)) by defs(taut(c), tr.stopk)
      have rd: tr.rst(l, r) by taut(expand(hb1.1, tr.rbk), nst)
      have rd2: tr.rst(pair(fst(l), empty), r) := rewrite(ql, rd)
      have rk: tr.rk(s, z. hp(z) || bp(z), fst(l), r) by defs(taut(rd2, hb1.2), tr.rk)
      have hr: tr.run_k(s, z. hp(z) || bp(z), fst(l), o) by defs(ex_intro({r}, taut(rk, hrm)), tr.run_k)
      show := mp(all_elim(h1, {fst(l)}, {y}, {w}), q1, rc, hr)
    qed
    have p1: all x y w. q(x, y, w) -> RCH(y, w) -> MR(x, l) -> LG proof
      fix x y w
      assume q1 rc mr
      have a1: hp(fst(l)) -> LG proof
        assume hh
        show := mp(all_elim(ha, {l}, {x}, {y}, {w}), ql, q1, rc, mr, hh, p2)
      qed
      have a2: !(hp(fst(l))) -> LG proof
        assume nh
        have rb2: tr.rbk(s, z. hp(z) || bp(z), l, r) by defs(taut(expand(hb1.1, tr.rbk, tr.stopk), nh), tr.rbk, tr.stopk)
        have w1 := mp(while_leave[l0 := l, c := x5. true, b := x5 x6. tr.rbk(s, z. hp(z) || bp(z), x5, x6), tr := x5. TR(x5), r := r], tt, rb2, hb1.2)
        have w2: tr.rwk(s, z. hp(z) || bp(z), l, r) by defs(w1, tr.rwk)
        have rk := mp(all_elim(mr, {r}), hnd, w2)
        have hr: tr.run_k(s, z. hp(z) || bp(z), x, o) by defs(ex_intro({r}, taut(rk, hrm)), tr.run_k)
        show := mp(all_elim(h1, {x}, {y}, {w}), q1, rc, hr)
      qed
      show by taut(a1, a2)
    qed
    show by taut(p1, p2)
  qed
  // a step of the run
  have zs: all l l1. true -> tr.rbk(s, z. bp(z), l, ok(l1, empty)) -> Z(l1) -> Z(l) proof
    fix l l1
    assume _ hb1 z1 ql
    have nst rd q1 := apply(tr.rbk_ok[bkp := z. bp(z)], {s}, {l}, {l1}, {empty}, hb1)
    have z2 := mp(z1, q1)
    have rd2: tr.rst(pair(fst(l), empty), ok(l1, empty)) := rewrite(ql, rd)
    have p2: all y w. q(fst(l), y, w) -> RCH(y, w) -> LG proof
      fix y w
      assume q2 rc
      have mr: MR(fst(l), l1) proof
        fix r1
        assume nd rw
        have e: ex l2. tr.rst(pair(fst(l), empty), ok(l2, empty)) && tr.rwk(s, z. hp(z) || bp(z), l2, r1) by ex_intro({l1}, taut(rd2, rw))
        show by defs(taut(e), tr.rk)
      qed
      show := mp(all_elim(z2.1, {fst(l)}, {y}, {w}), q2, rc, mr)
    qed
    have p1: all x y w. q(x, y, w) -> RCH(y, w) -> MR(x, l) -> LG proof
      fix x y w
      assume q2 rc mr
      have a1: hp(fst(l)) -> LG proof
        assume hh
        show := mp(all_elim(ha, {l}, {x}, {y}, {w}), ql, q2, rc, mr, hh, p2)
      qed
      have a2: !(hp(fst(l))) -> LG proof
        assume nh
        have rb2: tr.rbk(s, z. hp(z) || bp(z), l, ok(l1, empty)) by defs(taut(expand(nst, tr.stopk), nh, rd), tr.rbk, tr.stopk)
        have mr1: MR(x, l1) proof
          fix r1
          assume nd rw
          have w1 := mp(while_step[l0 := l, l1 := l1, c := x5. true, b := x5 x6. tr.rbk(s, z. hp(z) || bp(z), x5, x6), tr := x5. TR(x5), r := r1], tt, rb2, expand(rw, tr.rwk), nd)
          have w2: tr.rwk(s, z. hp(z) || bp(z), l, r1) by defs(w1, tr.rwk)
          show := mp(all_elim(mr, {r1}), nd, w2)
        qed
        show := mp(all_elim(z2.1, {x}, {y}, {w}), q2, rc, mr1)
      qed
      show by taut(a1, a2)
    qed
    show by taut(p1, p2)
  qed
  have rc0: RCH(y0, w0) proof
    fix o2
    assume r2
    show := r2
  qed
  // the first pass: on to l1, then the loop of passes; or it leaves
  have i1: (ex l1. tr.rst(pair(x0, empty), ok(l1, empty)) && tr.rwk(s, z. bp(z), l1, r)) -> LG proof
    assume e
    obtain l1, rb0 rw from e
    have q1: l1 = pair(fst(l1), empty) by simp(expand(rb0, tr.rst), keep(x86_64_linux.step))
    have zl := mp(while_run_ind[l0 := l1, c := x5. true, b := x5 x6. tr.rbk(s, z. bp(z), x5, x6), tr := x5. TR(x5), r := r, z := l. Z(l)], zb, zs, expand(rw, tr.rwk), hnd)
    have mr: MR(x0, l1) proof
      fix r1
      assume nd rw1
      have e2: ex l2. tr.rst(pair(x0, empty), ok(l2, empty)) && tr.rwk(s, z. hp(z) || bp(z), l2, r1) by ex_intro({l1}, taut(rb0, rw1))
      show by defs(taut(e2), tr.rk)
    qed
    show := mp(all_elim(mp(zl, q1).1, {x0}, {y0}, {w0}), hq0, rc0, mr)
  qed
  have i2: tr.rst(pair(x0, empty), r) && !is_ok(r) -> LG proof
    assume e
    have rk: tr.rk(s, z. hp(z) || bp(z), x0, r) by defs(taut(e), tr.rk)
    have hr: tr.run_k(s, z. hp(z) || bp(z), x0, o) by defs(ex_intro({r}, taut(rk, hrm)), tr.run_k)
    show := mp(all_elim(h1, {x0}, {y0}, {w0}), hq0, rc0, hr)
  qed
  show by taut(expand(hrk, tr.rk), i1, i2)
qed

// (a pair's first part: of the universe of the pair)
theorem tr.fst_univ: all z. z in univ(1) -> fst(z) in univ(1)
proof
  fix z
  assume hz
  have c1: (ex a b. z = pair(a, b)) -> fst(z) in univ(1) proof
    assume e
    obtain a b, ze from e
    have m1: single(a) in pair(a, b) by defs(upair_l[a := single(a), b := upair(a, b)], pair)
    have m2 := rewrite(sym(ze), m1)
    have su := mp(univ_trans[u := 1, a := single(a), b := z], hz, m2)
    have au := mp(univ_trans[u := 1, a := a, b := single(a)], su, single_intro[a := a])
    have fe: fst(z) = a by simp(ze)
    show := rewrite(sym(fe), au)
  qed
  have c2: !(ex a b. z = pair(a, b)) -> fst(z) in univ(1) proof
    assume ne
    have fe: fst(z) = empty by defs(mp(ite_f[c := ex a b. z = pair(a, b), a := choose(a. ex b. z = pair(a, b)), b := empty], ne), fst)
    show := rewrite(sym(fe), univ_empty[u := 1])
  qed
  show by taut(c1, c2)
qed

// (the limit of a chain of records of the universe: of the universe)
theorem tr.tl_univ(i. t): (all i. i in omega -> t(i) in univ(1)) -> trace_limit(i. t(i)) in univ(1)
proof
  assume h
  have t0 := mp(all_elim(h, {empty}), omega_zero)
  have fu: all z. z in t(empty) -> fst(z) in univ(1) proof
    fix z
    assume hz
    have zu := mp(univ_trans[u := 1, a := z, b := t(empty)], t0, hz)
    show := apply(tr.fst_univ, {z}, zu)
  qed
  have du: dom(t(empty)) in univ(1) by defs(mp(univ_image[u := 1, s := t(empty), f := z. fst(z)], t0, fu), dom)
  have vu: all f. f in dom(t(empty)) -> pair(f, union(set_image(omega, i. t(i)[f]))) in univ(1) proof
    fix f
    assume hf
    have fu2 := mp(univ_trans[u := 1, a := f, b := dom(t(empty))], du, hf)
    have au: all i. i in omega -> t(i)[f] in univ(1) proof
      fix i
      assume hi
      show := mp(app_univ[u := 1, f := t(i), k := f], mp(all_elim(h, {i}), hi))
    qed
    have iu := mp(univ_image[u := 1, s := omega, f := i. t(i)[f]], omega_univ, au)
    have uu := mp(univ_union[u := 1, s := set_image(omega, i. t(i)[f])], iu)
    show by simp(fu2, uu)
  qed
  have r := mp(univ_image[u := 1, s := dom(t(empty)), f := f. pair(f, union(set_image(omega, i. t(i)[f])))], du, vu)
  show by defs(r, trace_limit, fn_build)
qed

// The loop's infinite runs: as the spec's from the loop (an iteration's
// own divergence or undefined behaviour, or infinitely many of them: the
// spec's loop then runs forever too)
theorem tr.loop_div(s, v, z. hp, z. bp, l o. b, l. tr, x8 x1. k, x3 x4 x2. kw, x y w. q):
  (all x y w. q(x, y, w) -> hp(x) && !bp(x) && !tr.out(s, x) && w in univ(1) && pair(w, y) in univ(1)) ->
  (all x y w. q(x, y, w) -> tr.sim(s, z. hp(z) || bp(z), z p2 w2. hp(z) && (ex y2. q(z, y2, w2) && runs(p2, w2, ok(w2, pair(18446744073709551616, y2)))),
    v, tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w, x)) ->
  (all t. k(diverge(t), diverge(t))) -> (all l. l in univ(1) -> tr(l) in univ(1)) ->
  all x0 y0 w0 r o. q(x0, y0, w0) -> tr.rk(s, z. bp(z), x0, r) -> tr.rmap(r, o) -> fst(r) = 2 ->
    tr.lg(s, z. bp(z), v, tr.lprog(y0, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w0, o)
proof
  assume hq hb hk2 htr
  fix x0 y0 w0 r o
  assume hq0 hrk hrm hd0
  have tt: true by taut()
  let LG := tr.lg(s, z. bp(z), v, tr.lprog(y0, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w0, o)
  let PF(y) := tr.lpf(y, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2))
  let RCH(y, w) := all o2. runs(PF(y), w, o2) -> runs(PF(y0), w0, o2)
  let TR(x5) := fn_update(empty, "os.events", fst(x5).os.events)
  let BRK(l) := exc(pair(fst(l), empty), pair("brk", empty))
  have hd := mp(tr.loop_d[s := s, v := v, hp := z. hp(z), bp := z. bp(z), b := l o. b(l, o), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2), q := x y w. q(x, y, w)], hb)
  have rm2 := rewrite(hd0, expand(hrm, tr.rmap))
  have od: o = diverge(snd(r)) by simp(rm2)
  have em: LG || !LG by taut()
  have ng: !LG -> LG proof
    assume nlg
    // an iteration's undefined behaviour or divergence: the loop's
    have h3: all x y w t. q(x, y, w) -> RCH(y, w) -> tr.run_k(s, z. hp(z) || bp(z), x, diverge(t)) -> false proof
      fix x y w t
      assume q1 rc hr
      let P1 := tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2))
      have d := mp(all_elim(hd, {x}, {y}, {w}, {diverge(t)}), q1, hr)
      have c1: tr.lg(s, z. bp(z), v, P1, w, diverge(t)) -> false proof
        assume l1
        have u: tr.ub(s, v, P1, w) || tr.div(P1, w, diverge(t)) -> false proof
          assume e
          have dv: tr.div(P1, w, diverge(t)) -> tr.div(P1, w, o) proof
            assume dd
            have e2: ex t3. o = diverge(t3) by ex_intro({snd(r)}, od)
            show by defs(taut(expand(dd, tr.div), e2), tr.div)
          qed
          have l2: tr.lg(s, z. bp(z), v, P1, w, o) by defs(taut(e, dv), tr.lg)
          have lg := apply(tr.loop_e[s := s, v := v, bp := z. bp(z), b := l o. b(l, o), tr := l. tr(l), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {y}, {w}, {y0}, {w0}, {o}, rc, l2)
          show by taut(lg, nlg)
        qed
        have cr: tr.crash(s, P1, w, diverge(t)) -> false proof
          assume c
          obtain m1 a k0, {oe} from expand(c, tr.crash)
          show by simp(oe)
        qed
        have rt: (ex m1. diverge(t) = ok(m1, empty) && tr.out(s, m1) && tr.retok(s, v, P1, w, m1)) -> false proof
          assume e
          obtain m1, oe _ _ from e
          show by simp(oe)
        qed
        show by taut(expand(l1, tr.lg), u, cr, rt)
      qed
      have c2: (ex m1 y2 w2. diverge(t) = ok(m1, empty) && q(m1, y2, w2) && b(pair(w, y), ok(pair(w2, y2), empty))) -> false proof
        assume e
        obtain m1 y2 w2, oe _ _ from e
        show by simp(oe)
      qed
      show by taut(d, c1, c2)
    qed
    let DV(x) := ex r1. tr.rk(s, z. bp(z), x, r1) && fst(r1) = 2
    let S(l) := ex x w y. l = pair(w, y) && q(x, y, w) && RCH(y, w) && DV(x)
    // from a head whose run diverges: an iteration, to such a head
    have nx: all x y w. q(x, y, w) -> RCH(y, w) -> DV(x) -> (ex x2 y2 w2. q(x2, y2, w2) && b(pair(w, y), ok(pair(w2, y2), empty)) && DV(x2)) proof
      fix x y w
      assume q1 rc dv
      obtain r1, rk1 f1 from dv
      have rmd: tr.rmap(r1, diverge(snd(r1))) by defs(simp(f1), tr.rmap)
      // the first pass diverges
      have k2: tr.rst(pair(x, empty), r1) && !is_ok(r1) -> (ex x2 y2 w2. q(x2, y2, w2) && b(pair(w, y), ok(pair(w2, y2), empty)) && DV(x2)) proof
        assume e
        have rk: tr.rk(s, z. hp(z) || bp(z), x, r1) by defs(taut(e), tr.rk)
        have hr: tr.run_k(s, z. hp(z) || bp(z), x, diverge(snd(r1))) by defs(ex_intro({r1}, taut(rk, rmd)), tr.run_k)
        have f := mp(all_elim(h3, {x}, {y}, {w}, {snd(r1)}), q1, rc, hr)
        show by taut(f)
      qed
      // the loop of passes: cut where it first reaches the head
      have k1: (ex l1. tr.rst(pair(x, empty), ok(l1, empty)) && tr.rwk(s, z. bp(z), l1, r1)) -> (ex x2 y2 w2. q(x2, y2, w2) && b(pair(w, y), ok(pair(w2, y2), empty)) && DV(x2)) proof
        assume e
        obtain l1, rb0 rw from e
        have q1s: l1 = pair(fst(l1), empty) by simp(expand(rb0, tr.rst), keep(x86_64_linux.step))
        have he: all l. !is_ok(BRK(l)) proof
          fix l
          show by defs(simp(), is_ok)
        qed
        have hqs: all l l2. l = pair(fst(l), empty) -> tr.rbk(s, z. bp(z), l, ok(l2, empty)) -> l2 = pair(fst(l2), empty) proof
          fix l l2
          assume _ hb1
          have c := apply(tr.rbk_ok[bkp := z. bp(z)], {s}, {l}, {l2}, {empty}, hb1)
          show by taut(c)
        qed
        have sp := mp(while_split[l0 := l1, b := x5 x6. tr.rbk(s, z. bp(z), x5, x6), tr := x5. TR(x5), p := l. !(hp(fst(l))), e := l. BRK(l), r := r1, q := l. l = pair(fst(l), empty)],
          he, q1s, hqs, expand(rw, tr.rwk))
        // the guarded passes: those of the iteration
        have gb: all l o2. (!(hp(fst(l))) && tr.rbk(s, z. bp(z), l, o2)) || (!!(hp(fst(l))) && o2 = BRK(l)) -> tr.rbk(s, z. hp(z) || bp(z), l, o2) proof
          fix l o2
          assume g
          have g1: !(hp(fst(l))) && tr.rbk(s, z. bp(z), l, o2) -> tr.rbk(s, z. hp(z) || bp(z), l, o2) proof
            assume g2
            show by defs(taut(expand(g2.2, tr.rbk, tr.stopk), g2.1), tr.rbk, tr.stopk)
          qed
          have g3: !!(hp(fst(l))) && o2 = BRK(l) -> tr.rbk(s, z. hp(z) || bp(z), l, o2) proof
            assume g2
            have st: tr.stopk(s, z. hp(z) || bp(z), fst(l)) by defs(taut(g2.1), tr.stopk)
            show by defs(taut(st, g2.2), tr.rbk)
          qed
          show by taut(g, g1, g3)
        qed
        // never at the head: the iteration diverges
        have ca: while_rel(l1, l. true, l o2. (!(hp(fst(l))) && tr.rbk(s, z. bp(z), l, o2)) || (!!(hp(fst(l))) && o2 = BRK(l)), l. TR(l), r1) ->
            (ex x2 y2 w2. q(x2, y2, w2) && b(pair(w, y), ok(pair(w2, y2), empty)) && DV(x2)) proof
          assume wg
          have w2 := mp(while_mono[l0 := l1, c := l. true, b1 := l o2. (!(hp(fst(l))) && tr.rbk(s, z. bp(z), l, o2)) || (!!(hp(fst(l))) && o2 = BRK(l)),
            b2 := l o2. tr.rbk(s, z. hp(z) || bp(z), l, o2), tr := l. TR(l), r := r1], gb, wg)
          have rw2: tr.rwk(s, z. hp(z) || bp(z), l1, r1) by defs(w2, tr.rwk)
          have e2: ex l2. tr.rst(pair(x, empty), ok(l2, empty)) && tr.rwk(s, z. hp(z) || bp(z), l2, r1) by ex_intro({l1}, taut(rb0, rw2))
          have rk: tr.rk(s, z. hp(z) || bp(z), x, r1) by defs(taut(e2), tr.rk)
          have hr: tr.run_k(s, z. hp(z) || bp(z), x, diverge(snd(r1))) by defs(ex_intro({r1}, taut(rk, rmd)), tr.run_k)
          have f := mp(all_elim(h3, {x}, {y}, {w}, {snd(r1)}), q1, rc, hr)
          show by taut(f)
        qed
        // at the head at l: the iteration's end; the run goes on from l
        have cb: (ex l. l = pair(fst(l), empty) && while_rel(l1, l. true, l o2. (!(hp(fst(l))) && tr.rbk(s, z. bp(z), l, o2)) || (!!(hp(fst(l))) && o2 = BRK(l)), l. TR(l), BRK(l)) &&
            (ex r2. while_rel(l, l. true, l o2. tr.rbk(s, z. bp(z), l, o2), l. TR(l), r2) && fst(r2) = fst(r1) && (!(fst(r1) = 2) -> r2 = r1))) ->
            (ex x2 y2 w2. q(x2, y2, w2) && b(pair(w, y), ok(pair(w2, y2), empty)) && DV(x2)) proof
          assume e2
          obtain l, ql wg er from e2
          obtain r2, wr2 f2 _ from er
          have f22: fst(r2) = 2 by simp(f1, f2)
          have w2 := mp(while_mono[l0 := l1, c := l. true, b1 := l o2. (!(hp(fst(l))) && tr.rbk(s, z. bp(z), l, o2)) || (!!(hp(fst(l))) && o2 = BRK(l)),
            b2 := l o2. tr.rbk(s, z. hp(z) || bp(z), l, o2), tr := l. TR(l), r := BRK(l)], gb, wg)
          have rw2: tr.rwk(s, z. hp(z) || bp(z), l1, BRK(l)) by defs(w2, tr.rwk)
          have e3: ex l2. tr.rst(pair(x, empty), ok(l2, empty)) && tr.rwk(s, z. hp(z) || bp(z), l2, BRK(l)) by ex_intro({l1}, taut(rb0, rw2))
          have rk: tr.rk(s, z. hp(z) || bp(z), x, BRK(l)) by defs(taut(e3), tr.rk)
          have rmb: tr.rmap(BRK(l), ok(fst(l), empty)) by defs(simp(), tr.rmap)
          have hr: tr.run_k(s, z. hp(z) || bp(z), x, ok(fst(l), empty)) by defs(ex_intro({BRK(l)}, taut(rk, rmb)), tr.run_k)
          // the run from l: on, diverging (so l is no stop)
          have un := mp(while_unroll[l0 := l, c := l. true, b := l o2. tr.rbk(s, z. bp(z), l, o2), tr := l. TR(l), r := r2], wr2)
          have nst: !tr.stopk(s, z. bp(z), fst(l)) proof
            have n: tr.stopk(s, z. bp(z), fst(l)) -> false proof
              assume st
              have u1: tr.rbk(s, z. bp(z), l, r2) && !is_ok(r2) -> false proof
                assume e4
                have r2e: r2 = BRK(l) by taut(expand(e4.1, tr.rbk), st)
                have f3: fst(r2) = 1 by simp(r2e)
                show by simp(f3, f22)
              qed
              have u2: (ex l3. tr.rbk(s, z. bp(z), l, ok(l3, empty)) && (ex r3. while_rel(l3, l. true, l o2. tr.rbk(s, z. bp(z), l, o2), l. TR(l), r3) &&
                  fst(r3) = fst(r2) && (!(fst(r2) = 2) -> r3 = r2))) -> false proof
                assume e4
                obtain l3, hb3 _ from e4
                have c := apply(tr.rbk_ok[bkp := z. bp(z)], {s}, {l}, {l3}, {empty}, hb3)
                show by taut(c, st)
              qed
              show by taut(un, u1, u2)
            qed
            show by taut(n)
          qed
          have dvl: DV(fst(l)) proof
            have v1: tr.rbk(s, z. bp(z), l, r2) && !is_ok(r2) -> DV(fst(l)) proof
              assume e4
              have rd: tr.rst(l, r2) by taut(expand(e4.1, tr.rbk), nst)
              have rd2: tr.rst(pair(fst(l), empty), r2) := rewrite(ql, rd)
              have rk2: tr.rk(s, z. bp(z), fst(l), r2) by defs(taut(rd2, e4.2), tr.rk)
              show by ex_intro({r2}, taut(rk2, f22))
            qed
            have v2: (ex l3. tr.rbk(s, z. bp(z), l, ok(l3, empty)) && (ex r3. while_rel(l3, l. true, l o2. tr.rbk(s, z. bp(z), l, o2), l. TR(l), r3) &&
                fst(r3) = fst(r2) && (!(fst(r2) = 2) -> r3 = r2))) -> DV(fst(l)) proof
              assume e4
              obtain l3, hb3 er3 from e4
              obtain r3, wr3 f3 _ from er3
              have c := apply(tr.rbk_ok[bkp := z. bp(z)], {s}, {l}, {l3}, {empty}, hb3)
              have rd2: tr.rst(pair(fst(l), empty), ok(l3, empty)) := rewrite(ql, c.2)
              have rw3: tr.rwk(s, z. bp(z), l3, r3) by defs(wr3, tr.rwk)
              have e5: ex l4. tr.rst(pair(fst(l), empty), ok(l4, empty)) && tr.rwk(s, z. bp(z), l4, r3) by ex_intro({l3}, taut(rd2, rw3))
              have rk2: tr.rk(s, z. bp(z), fst(l), r3) by defs(taut(e5), tr.rk)
              have f33: fst(r3) = 2 by simp(f3, f22)
              show by ex_intro({r3}, taut(rk2, f33))
            qed
            have v0: (!true && r2 = ok(l, empty)) -> DV(fst(l)) proof
              assume e4
              show by taut(e4)
            qed
            show by taut(un, v0, v1, v2)
          qed
          // the iteration's end at the head: a pass of the body
          have d := mp(all_elim(hd, {x}, {y}, {w}, {ok(fst(l), empty)}), q1, hr)
          let P1 := tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2))
          have d1: tr.lg(s, z. bp(z), v, P1, w, ok(fst(l), empty)) -> false proof
            assume l2
            have u: tr.ub(s, v, P1, w) -> false proof
              assume hu
              have l3: tr.lg(s, z. bp(z), v, P1, w, o) by defs(taut(hu), tr.lg)
              have lg := apply(tr.loop_e[s := s, v := v, bp := z. bp(z), b := l o. b(l, o), tr := l. tr(l), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {y}, {w}, {y0}, {w0}, {o}, rc, l3)
              show by taut(lg, nlg)
            qed
            have cr: tr.crash(s, P1, w, ok(fst(l), empty)) -> false proof
              assume c
              obtain m1 a k0, {oe} from expand(c, tr.crash)
              show by simp(oe)
            qed
            have dv2: tr.div(P1, w, ok(fst(l), empty)) -> false proof
              assume c
              obtain t, te from expand(c, tr.div).1
              show by simp(te)
            qed
            have rt: (ex m1. ok(fst(l), empty) = ok(m1, empty) && tr.out(s, m1) && tr.retok(s, v, P1, w, m1)) -> false proof
              assume e4
              obtain m1, oe at _ from e4
              have me: m1 = fst(l) by simp(oe)
              have at2: tr.out(s, fst(l)) := rewrite(me, at)
              have st: tr.stopk(s, z. bp(z), fst(l)) by defs(taut(at2), tr.stopk)
              show by taut(st, nst)
            qed
            show by taut(expand(l2, tr.lg), u, cr, dv2, rt)
          qed
          have d2: (ex m1 y2 w2. ok(fst(l), empty) = ok(m1, empty) && q(m1, y2, w2) && b(pair(w, y), ok(pair(w2, y2), empty))) ->
              (ex x2 y2 w2. q(x2, y2, w2) && b(pair(w, y), ok(pair(w2, y2), empty)) && DV(x2)) proof
            assume e4
            obtain m1 y2 w2, oe q2 bs from e4
            have me: m1 = fst(l) by simp(oe)
            have q3: q(fst(l), y2, w2) := rewrite(me, q2)
            show by ex_intro({fst(l)}, {y2}, {w2}, taut(q3, bs, dvl))
          qed
          show by taut(d, d1, d2)
        qed
        show by taut(sp, ca, cb)
      qed
      show by taut(expand(rk1, tr.rk), k1, k2)
    qed
    have ss: all l. S(l) -> true && (ex l2. b(l, ok(l2, empty)) && S(l2)) proof
      fix l
      assume sl
      obtain x w y, le q1 rc dv from sl
      obtain x2 y2 w2, q2 bs dv2 from mp(all_elim(nx, {x}, {y}, {w}), q1, rc, dv)
      have hw: w in univ(1) by taut(mp(all_elim(hq, {x}, {y}, {w}), q1))
      have rc2: RCH(y2, w2) proof
        fix o2
        assume r2
        have r1 := apply(tr.lpf_step[b := l o. b(l, o), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {y}, {w2}, {y2}, {o2}, hw, bs, r2)
        show := mp(all_elim(rc, {o2}), r1)
      qed
      have s2: S(pair(w2, y2)) by ex_intro({x2}, {w2}, {y2}, taut(refl({pair(w2, y2)}), q2, rc2, dv2))
      have bl: b(l, ok(pair(w2, y2), empty)) := rewrite(sym(le), bs)
      have e2: ex l2. b(l, ok(l2, empty)) && S(l2) by ex_intro({pair(w2, y2)}, taut(bl, s2))
      show by taut(e2)
    qed
    have rc0: RCH(y0, w0) proof
      fix o2
      assume r2
      show := r2
    qed
    have dv0: DV(x0) by ex_intro({r}, taut(hrk, hd0))
    have s0: S(pair(w0, y0)) by ex_intro({x0}, {w0}, {y0}, taut(refl({pair(w0, y0)}), hq0, rc0, dv0))
    obtain f, ff fd f0 fs from mp(while_coind[l0 := pair(w0, y0), c := l. true, b := l o. b(l, o), s := l. S(l)], s0, ss)
    // so the spec's loop runs forever
    let T := trace_limit(i. tr(f[i]))
    have fs2: all i. i in omega -> true && b(f[i], ok(f[succ(i)], empty)) proof
      fix i
      assume hi
      have c := mp(all_elim(fs, {i}), hi)
      show by taut(c)
    qed
    have inf: ex f2. is_fun(f2) && dom(f2) = omega && f2[empty] = pair(w0, y0) &&
        (all i. i in omega -> true && b(f2[i], ok(f2[succ(i)], empty))) && diverge(T) = diverge(trace_limit(i. tr(f2[i])))
      by ex_intro({f}, taut(ff, fd, f0, fs2, refl({diverge(T)})))
    have wr: while_rel(pair(w0, y0), l. true, l o. b(l, o), l. tr(l), diverge(T)) by defs(taut(inf), while_rel)
    have tu0: all i. i in omega -> tr(f[i]) in univ(1) proof
      fix i
      assume hi
      have c := mp(all_elim(fs, {i}), hi)
      obtain x w y, le q1 _ _ from c.1
      have pu: pair(w, y) in univ(1) by taut(mp(all_elim(hq, {x}, {y}, {w}), q1))
      have au: f[i] in univ(1) := rewrite(sym(le), pu)
      show := mp(all_elim(htr, {f[i]}), au)
    qed
    have tu := mp(tr.tl_univ[t := i. tr(f[i])], tu0)
    have w0u: w0 in univ(1) by taut(mp(all_elim(hq, {x0}, {y0}, {w0}), hq0))
    have u: pair(w0, diverge(T)) in univ(1) by simp(w0u, tu)
    have r0: ex x9. while_rel(pair(w0, y0), l. true, l o. b(l, o), l. tr(l), x9) && k(x9, diverge(T)) by ex_intro({diverge(T)}, taut(wr, all_elim(hk2, {T})))
    have r1 := apply(tr.runs_intro[r := x0 x1. ex x9. while_rel(pair(x0, y0), l. true, l o. b(l, o), l. tr(l), x9) && k(x9, x1)], {w0}, {diverge(T)}, u, r0)
    have r1p: runs(tr.lp0(y0, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1)), w0, diverge(T)) by defs(r1, tr.lp0)
    // (the wrapper passes the divergence on)
    have bw: bind_rel(tr.lp0(y0, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1)), w0, x3 x4. kw(x3, x4, diverge(T)), x3 x4. diverge(T) = exc(x3, x4), x3. diverge(T) = diverge(x3))
      by defs(ex_intro({diverge(T)}, taut(r1p, (ex t5. diverge(T) = diverge(t5) && diverge(T) = diverge(t5) by ex_intro({T}, taut(refl({diverge(T)})))))), bind_rel)
    have r2w := apply(tr.runs_intro[r := x1 x2. bind_rel(tr.lp0(y0, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1)), x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))], {w0}, {diverge(T)}, u, bw)
    have r2: runs(tr.lprog(y0, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w0, diverge(T)) by defs(r2w, tr.lprog)
    have e3: ex t3. runs(tr.lprog(y0, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w0, diverge(t3)) by ex_intro({T}, r2)
    have e4: ex t4. o = diverge(t4) by ex_intro({snd(r)}, od)
    have dv: tr.div(tr.lprog(y0, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w0, o) by defs(taut(e3, e4), tr.div)
    have lg: LG by defs(taut(dv), tr.lg)
    show by taut(lg, nlg)
  qed
  show by taut(em, ng)
qed

// The rule of cut points: at the states of hp (the cut points -- a loop's
// head, or a CFG's block entries), coupled by q, the claim for the program
// iterated (a CFG: one block per iteration, the label in the locals) --
// from the claim for one iteration (the cut points breakpoints, arrived at
// coupled, with the iteration's spec returning the next locals marked)
theorem tr.loop_cut(s, v, z. hp, z. bp, z p w. ar, l o. b, l. tr, x8 x1. k, x3 x4 x2. kw, x y w. q):
  (all x y w. q(x, y, w) -> hp(x) && !bp(x) && !tr.out(s, x) && w in univ(1) && pair(w, y) in univ(1)) ->
  (all x y w m. q(x, y, w) -> hp(m) -> !tr.out(s, m)) ->
  (all t. k(diverge(t), diverge(t))) -> (all l. l in univ(1) -> tr(l) in univ(1)) ->
  (all x y w. q(x, y, w) -> tr.sim(s, z. hp(z) || bp(z), z p2 w2. hp(z) && (ex y2. q(z, y2, w2) && runs(p2, w2, ok(w2, pair(18446744073709551616, y2)))),
    v, tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w, x)) ->
  all x y w. q(x, y, w) -> tr.sim(s, z. bp(z), z p w. ar(z, p, w), v, tr.lprog(y, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w, x)
proof
  assume hq hnr hk2 htr hb
  fix x y w
  assume q0
  let P := tr.lprog(y, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2))
  have g: all o. tr.run_k(s, z. bp(z), x, o) -> tr.gk(s, z. bp(z), z p w. ar(z, p, w), v, P, w, o) proof
    fix o
    assume hr
    obtain r, rk rm from expand(hr, tr.run_k)
    have f: !(fst(r) = 2) -> tr.lg(s, z. bp(z), v, P, w, o) proof
      assume nd
      show := mp(all_elim(mp(tr.loop_fin[s := s, v := v, hp := z. hp(z), bp := z. bp(z), b := l o. b(l, o), tr := l. tr(l), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2), q := x y w. q(x, y, w)], hq, hb, hnr),
        {x}, {y}, {w}, {r}, {o}), q0, rk, rm, nd)
    qed
    have d: fst(r) = 2 -> tr.lg(s, z. bp(z), v, P, w, o) proof
      assume dd
      show := mp(all_elim(mp(tr.loop_div[s := s, v := v, hp := z. hp(z), bp := z. bp(z), b := l o. b(l, o), tr := l. tr(l), k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2), q := x y w. q(x, y, w)], hq, hb, hk2, htr),
        {x}, {y}, {w}, {r}, {o}), q0, rk, rm, dd)
    qed
    have lg: tr.lg(s, z. bp(z), v, P, w, o) by taut(f, d)
    // (the return: no point of bp, so the arrival is the return's)
    have rt: (ex m1. o = ok(m1, empty) && tr.out(s, m1) && tr.retok(s, v, P, w, m1)) ->
        (ex m1. o = ok(m1, empty) && tr.arr(s, z. bp(z), z p w. ar(z, p, w), v, m1, P, w)) proof
      assume e
      obtain m1, oe at rt0 from e
      have a: tr.arr(s, z. bp(z), z p w. ar(z, p, w), v, m1, P, w) by defs(taut(rt0, at), tr.arr)
      show by ex_intro({m1}, taut(oe, a))
    qed
    show by defs(taut(expand(lg, tr.lg), rt), tr.gk)
  qed
  show by defs(g, tr.sim)
qed

// The loop rule: at the loop's head h, coupled by q (the cut points: h)
theorem tr.loop(s, v, h, z. bp, z p w. ar, l o. b, l. tr, x8 x1. k, x3 x4 x2. kw, x y w. q):
  (all x y w. q(x, y, w) -> tr.hd(x) = h && !bp(x) && !tr.out(s, x) && w in univ(1) && pair(w, y) in univ(1)) ->
  (all t. k(diverge(t), diverge(t))) -> (all l. l in univ(1) -> tr(l) in univ(1)) ->
  (all x y w. q(x, y, w) -> tr.sim(s, z. tr.hd(z) = h || bp(z), z p2 w2. tr.hd(z) = h && (ex y2. q(z, y2, w2) && runs(p2, w2, ok(w2, pair(18446744073709551616, y2)))),
    v, tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w, x)) ->
  all x y w. q(x, y, w) -> tr.sim(s, z. bp(z), z p w. ar(z, p, w), v, tr.lprog(y, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w, x)
proof
  assume hq hk2 htr hb
  have hq2: all x y w. q(x, y, w) -> tr.hd(x) = h && !tr.out(s, x) proof
    fix x y w
    assume q1
    have c := mp(all_elim(hq, {x}, {y}, {w}), q1)
    show by taut(c)
  qed
  have hnr := mp(tr.hd_nret[s := s, h := h, q := x y w. q(x, y, w)], hq2)
  show := mp(tr.loop_cut[s := s, v := v, hp := z. tr.hd(z) = h, bp := z. bp(z), ar := z p w. ar(z, p, w), b := l o. b(l, o), tr := l. tr(l), k := x8 x1. k(x8, x1),
    kw := x3 x4 x2. kw(x3, x4, x2), q := x y w. q(x, y, w)], hq, hnr, hk2, htr, hb)
qed

// ----------------------------------------------------------------------
//  A loop in the engine's walk: the iteration's ends as reductions of the
//  rest, its marked returns dropped after the exit, the loop rule on the
//  point claims (tr.loop_lv), the head's arrival (tr.pt_head)

// (the body went on: the marked return)
// (a callee's states, below the frame x: not at a loop's head h there)
theorem tr.tbp_hd(z. bkp, t): all x h. (all z. int_lt(z.gpr[4], x) -> bkp(z) -> z.rip = t) ->
  all z. int_lt(z.gpr[4], x) -> tr.hd(z) = pair(h, x) || bkp(z) -> z.rip = t
proof
  fix x h
  assume hb
  fix z
  assume hl hc
  have n: tr.hd(z) = pair(h, x) -> false proof
    assume e
    have e2: z.gpr[4] = x by simp(expand(e, tr.hd))
    show by arith(e2, hl)
  qed
  show by taut(hc, n, mp(all_elim(hb, {z}), hl))
qed

theorem tr.nobp_hd(z. bkp): all x h. (all z. int_lt(z.gpr[4], x) -> !bkp(z)) ->
  all z. int_lt(z.gpr[4], x) -> !(tr.hd(z) = pair(h, x) || bkp(z))
proof
  fix x h
  assume hb
  fix z
  assume hl
  have nb := mp(all_elim(hb, {z}), hl)
  have n: tr.hd(z) = pair(h, x) -> false proof
    assume e
    have e2: z.gpr[4] = x by simp(expand(e, tr.hd))
    show by arith(e2, hl)
  qed
  show by taut(n, nb)
qed

// (a rest run from w: its start world w)
theorem tr.q_at(x0 x1. b): all w o. runs(mkprog(x0 x1. b(w, x1)), w, o) -> runs(mkprog(x0 x1. b(x0, x1)), w, o)
proof
  fix w o
  assume hr
  have pu := apply(g.runs_univ, hr)
  have c := apply(g.runs_elim, hr)
  show := apply(tr.runs_intro[r := x0 x1. b(x0, x1)], {w}, {o}, pu, c)
qed

// (and back: the start world w in a rest run from w, its start world)
theorem tr.q_from(x0 x1 y. b): all w o. runs(mkprog(x0 x1. b(x0, x1, x0)), w, o) -> runs(mkprog(x0 x1. b(x0, x1, w)), w, o)
proof
  fix w o
  assume hr
  have pu := apply(g.runs_univ, hr)
  have c := apply(g.runs_elim, hr)
  show := apply(tr.runs_intro[r := x0 x1. b(x0, x1, w)], {w}, {o}, pu, c)
qed

theorem tr.lcont_ok(x8 x1. k, x3 x4 x2. kw): all w w2 y2 o. runs(mkprog(x0 x1. x1 = ok(w2, pair(18446744073709551616, y2))), w, o) ->
  runs(mkprog(x0 x1. tr.lcont(ok(pair(w2, y2), empty), x1, x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2))), w, o)
proof
  fix w w2 y2 o
  assume hr
  have pu := apply(g.runs_univ, hr)
  have oe := apply(g.runs_elim, hr)
  have e: ex w3 y3. ok(pair(w2, y2), empty) = ok(pair(w3, y3), empty) && o = ok(w3, pair(18446744073709551616, y3))
    by ex_intro({w2}, {y2}, taut(refl({ok(pair(w2, y2), empty)}), oe))
  have c: tr.lcont(ok(pair(w2, y2), empty), o, x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)) by defs(taut(e), tr.lcont)
  show := apply(tr.runs_intro[r := x0 x1. tr.lcont(ok(pair(w2, y2), empty), x1, x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2))], {w}, {o}, pu, c)
qed

// (the body left with e: the rest in the wrapper from e's world, its
// marked returns dropped)
theorem tr.lcont_exit(x8 x1. k, x3 x4 x2. kw): all w e o. !is_ok(e) -> fst(out_state(e)) = w ->
  runs(mkprog(x1 x2. bind_rel(mkprog(x0 x3. k(e, x3)), x1, x4 x5. kw(x4, x5, x2), x4 x5. x2 = exc(x4, x5), x4. x2 = diverge(x4)) && !tr.mk(x2) && tr.isout(x2)), w, o) ->
  runs(mkprog(x0 x1. tr.lcont(e, x1, x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2))), w, o)
proof
  fix w e o
  assume hn hw hr
  have pu := apply(g.runs_univ, hr)
  have b nm io := apply(g.runs_elim, hr)
  have b2 := rewrite(sym(hw), b)
  have c: tr.lcont(e, o, x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)) by defs(taut(hn, b2, nm, io), tr.lcont)
  show := apply(tr.runs_intro[r := x0 x1. tr.lcont(e, x1, x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2))], {w}, {o}, pu, c)
qed

// After the loop: the claim with no arrival (none is reached outside the
// loop) gives the claim on the rest with its marked returns dropped -- a
// return of the function is no marked one, the crashes' and raises'
// outcomes none either
theorem tr.lv_unmark(zb. bkp, zb pb wb. bka, x3 x4 x2. kw): all s v base code fr a hs ds rs q w.
  tr.lv(s, zb. bkp(zb), zb pb wb. false, v, base, code, fr, a, hs, ds, rs, mkprog(x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs,
    mkprog(x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)) && !tr.mk(x2) && tr.isout(x2)), w)
proof
  fix s v base code fr a hs ds rs q w
  assume h
  let P := mkprog(x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))
  let PF := mkprog(x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)) && !tr.mk(x2) && tr.isout(x2))
  // (the filtered program's runs: the program's, unmarked)
  have rf: all o. runs(P, w, o) -> !tr.mk(o) -> tr.isout(o) -> runs(PF, w, o) proof
    fix o
    assume hr nm io
    have pu := apply(g.runs_univ, hr)
    have b := apply(g.runs_elim, hr)
    have c: bind_rel(q, w, x3 x4. kw(x3, x4, o), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) && !tr.mk(o) && tr.isout(o) by taut(b, nm, io)
    show := apply(tr.runs_intro[r := x1 x2. bind_rel(q, x1, x3 x4. kw(x3, x4, x2), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)) && !tr.mk(x2) && tr.isout(x2)], {w}, {o}, pu, c)
  qed
  have iox: all x e. tr.isout(exc(x, e)) proof
    fix x e
    have e1: ex a0 b0. exc(x, e) = exc(a0, b0) by ex_intro({x}, {e}, refl({exc(x, e)}))
    show by defs(taut(e1), tr.isout)
  qed
  have iod: all t. tr.isout(diverge(t)) proof
    fix t
    have e1: ex t0. diverge(t) = diverge(t0) by ex_intro({t}, refl({diverge(t)}))
    show by defs(taut(e1), tr.isout)
  qed
  have iok: all a1 b1. tr.isout(ok(a1, b1)) proof
    fix a1 b1
    have e1: ex a0 b0. ok(a1, b1) = ok(a0, b0) by ex_intro({a1}, {b1}, refl({ok(a1, b1)}))
    show by defs(taut(e1), tr.isout)
  qed
  have nmx: all x e. !tr.mk(exc(x, e)) proof
    fix x e
    have n: tr.mk(exc(x, e)) -> false proof
      assume m
      obtain a0 b0, me from expand(m, tr.mk)
      show by simp(me)
    qed
    show by taut(n)
  qed
  have nmd: all t. !tr.mk(diverge(t)) proof
    fix t
    have n: tr.mk(diverge(t)) -> false proof
      assume m
      obtain a0 b0, me from expand(m, tr.mk)
      show by simp(me)
    qed
    show by taut(n)
  qed
  have g: all m. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, ds) ->
      tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, PF, w, m) proof
    fix m
    assume hi hr hh hrs hmm hfr
    have sm := expand(mp(all_elim(expand(h, tr.lv), {m}), hi, hr, hh, hrs, hmm, hfr), tr.sim)
    have g2: all o. tr.run_k(s, zb. bkp(zb), m, o) -> tr.gk(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, PF, w, o) proof
      fix o
      assume ho
      have c := expand(mp(all_elim(sm, {o}), ho), tr.gk)
      have c1: tr.ub(s, v, P, w) -> tr.ub(s, v, PF, w) proof
        assume u
        obtain e x, eu en ena rs0 rr from expand(u, tr.ub)
        have r := mp(all_elim(rf, {exc(x, e)}), rr, all_elim(nmx, {x}, {e}), all_elim(iox, {x}, {e}))
        show by defs(ex_intro({e}, {x}, taut(eu, en, ena, rs0, r)), tr.ub)
      qed
      have c2: tr.crash(s, P, w, o) -> tr.crash(s, PF, w, o) proof
        assume cr
        obtain m1 a1 k0, c3 from expand(cr, tr.crash)
        have o2: tr.ovf(P, w, m1.os) -> tr.ovf(PF, w, m1.os) proof
          assume hv
          have e1: (ex x. x in rec_and(abi.World, single(empty)) && runs(P, w, exc(x, exc_val("stack_overflow", empty))) && x.os.events = m1.os.events) ->
              tr.ovf(PF, w, m1.os) proof
            assume e
            obtain x, xa xr xe from e
            have r := mp(all_elim(rf, {exc(x, exc_val("stack_overflow", empty))}), xr, all_elim(nmx, {x}, {exc_val("stack_overflow", empty)}), all_elim(iox, {x}, {exc_val("stack_overflow", empty)}))
            have e2: ex x1. x1 in rec_and(abi.World, single(empty)) && runs(PF, w, exc(x1, exc_val("stack_overflow", empty))) && x1.os.events = m1.os.events
              by ex_intro({x}, taut(xa, r, xe))
            show by defs(taut(e2), tr.ovf)
          qed
          have e3: (ex t. runs(P, w, diverge(t))) -> tr.ovf(PF, w, m1.os) proof
            assume e
            obtain t, rt from e
            have r := mp(all_elim(rf, {diverge(t)}), rt, all_elim(nmd, {t}), all_elim(iod, {t}))
            have e2: ex t1. runs(PF, w, diverge(t1)) by ex_intro({t}, r)
            show by defs(taut(e2), tr.ovf)
          qed
          show by taut(expand(hv, tr.ovf), e1, e3)
        qed
        show by defs(ex_intro({m1}, {a1}, {k0}, taut(c3, o2)), tr.crash)
      qed
      have c3: tr.div(P, w, o) -> tr.div(PF, w, o) proof
        assume d
        have d1 d2 := expand(d, tr.div)
        obtain t, rt from d2
        have r := mp(all_elim(rf, {diverge(t)}), rt, all_elim(nmd, {t}), all_elim(iod, {t}))
        have e2: ex t1. runs(PF, w, diverge(t1)) by ex_intro({t}, r)
        show by defs(taut(d1, e2), tr.div)
      qed
      have c4: (ex m1. o = ok(m1, empty) && tr.arr(s, zb. bkp(zb), zb pb wb. false, v, m1, P, w)) ->
          (ex m1. o = ok(m1, empty) && tr.arr(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, m1, PF, w)) proof
        assume e
        obtain m1, oe ha from e
        have a1 a2 := expand(ha, tr.arr)
        have b1: tr.out(s, m1) -> tr.retok(s, v, PF, w, m1) proof
          assume ou
          have rx := expand(mp(a1, ou), tr.retok)
          have mM: m1 in x86_64_linux.Machine by taut(rx)
          have ew: ex w3. runs(P, w, ok(w3, pair(m1.gpr[0], m1.gpr[2]))) && w3 in abi.World && w3 in univ(1) &&
              abi.world_matches(s.vm, m1.vm, w3.vm, abi.wob(v, w3.objs.c_bytes), s.fs_base, abi.sp(s)) && m1.os = w3.os && m1.fs_base = s.fs_base by taut(rx)
          obtain w3, h3 from ew
          have r0R: 0 in x86_64_linux.Reg by simp()
          have rb := apply(x86i.reg_typed, mM, r0R)
          have nm: !tr.mk(ok(w3, pair(m1.gpr[0], m1.gpr[2]))) proof
            have n: tr.mk(ok(w3, pair(m1.gpr[0], m1.gpr[2]))) -> false proof
              assume m2
              obtain a0 b0, me from expand(m2, tr.mk)
              have e5: m1.gpr[0] = 18446744073709551616 by simp(me)
              show by arith(e5, rb)
            qed
            show by taut(n)
          qed
          have r := mp(all_elim(rf, {ok(w3, pair(m1.gpr[0], m1.gpr[2]))}), h3.1, nm, all_elim(iok, {w3}, {pair(m1.gpr[0], m1.gpr[2])}))
          have ew2: ex w4. runs(PF, w, ok(w4, pair(m1.gpr[0], m1.gpr[2]))) && w4 in abi.World && w4 in univ(1) &&
              abi.world_matches(s.vm, m1.vm, w4.vm, abi.wob(v, w4.objs.c_bytes), s.fs_base, abi.sp(s)) && m1.os = w4.os && m1.fs_base = s.fs_base
            by ex_intro({w3}, taut(r, h3))
          show by defs(taut(rx, ew2), tr.retok)
        qed
        have b2: !tr.out(s, m1) -> bkp(m1) -> (ex p2 w2. tr.red(PF, w, p2, w2) && bka(m1, p2, w2)) proof
          assume no hb
          obtain p2 w2, _ f from mp(a2, no, hb)
          show by taut(f)
        qed
        have a: tr.arr(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, m1, PF, w) by defs(taut(b1, b2), tr.arr)
        show by ex_intro({m1}, taut(oe, a))
      qed
      show by defs(taut(c, c1, c2, c3, c4), tr.gk)
    qed
    show by defs(g2, tr.sim)
  qed
  show by defs(g, tr.lv)
qed

// (homes: of fewer)
theorem tr.homes_sub: all s m hs1 hs. tr.hsub(hs1, hs) -> tr.homes(s, m, hs) -> tr.homes(s, m, hs1)
proof
  fix s m hs1 hs
  assume hsb hh
  have h1: all c. c in dom(hs1) -> x86_64_linux.le(m.vm.bytes, bits_add(64, int_add(s.gpr[4], c), 0), fst(hs1[c])) = snd(hs1[c]) &&
      tr.hrange(c, fst(hs1[c])) && tr.hacc(s, m.vm, c, fst(hs1[c])) proof
    fix c
    assume hc
    have sb := mp(all_elim(expand(hsb, tr.hsub), {c}), hc)
    have hc0 := mp(all_elim(expand(hh, tr.homes), {c}), sb.1)
    show by simp(hc0, sb.2)
  qed
  show by defs(h1, tr.homes)
qed

// The loop rule on the point claims: at the head ha (rsp the entry's less
// the frame fr), coupled by the homes hs(y) to the locals y, the claim for
// the loop -- from the claim for one iteration, the head a breakpoint
// arrived at coupled (the homes at the locals there), its spec returning
// them marked
theorem tr.loop_lv(s, v, base, code, fr, ha, fd, rc, y. hs, y. yt, z. bkp, z p w. bka, l o. b, l. tr, x8 x1. k, x3 x4 x2. kw):
  (all t. k(diverge(t), diverge(t))) -> (all l. l in univ(1) -> tr(l) in univ(1)) -> (all z. z.rip = ha -> !bkp(z)) ->
  (all y w. pair(w, y) in univ(1) -> yt(y) -> w in abi.World && w in univ(1) -> tr.lv(s, z. tr.hd(z) = pair(ha, int_sub(s.gpr[4], fr)) || bkp(z),
    z p2 w2. tr.hd(z) = pair(ha, int_sub(s.gpr[4], fr)) && (ex y2. (tr.inv(s, base, code, fr, z, w2) && z.rip = ha && tr.homes(s, z, hs(y2)) && tr.regs(z, rc) &&
      tr.mem(s, z, w2, v) && tr.frame(s, z, fd) && pair(w2, y2) in univ(1) && yt(y2)) && runs(p2, w2, ok(w2, pair(18446744073709551616, y2)))),
    v, base, code, fr, ha, hs(y), fd, rc,tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w)) ->
  all y w. pair(w, y) in univ(1) -> yt(y) ->
    tr.lv(s, z. bkp(z), z p w. bka(z, p, w), v, base, code, fr, ha, hs(y), fd, rc,tr.lprog(y, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w)
proof
  assume hk2 htr hbo hb
  let Q(x, y, w) := tr.inv(s, base, code, fr, x, w) && x.rip = ha && tr.homes(s, x, hs(y)) && tr.regs(x, rc) && tr.mem(s, x, w, v) && tr.frame(s, x, fd) && pair(w, y) in univ(1) && yt(y)
  let H := pair(ha, int_sub(s.gpr[4], fr))
  have hq: all x y w. Q(x, y, w) -> tr.hd(x) = H && !bkp(x) && !tr.out(s, x) && w in univ(1) && pair(w, y) in univ(1) proof
    fix x y w
    assume q
    have hi hr hh hg hm hf hu hy := q
    have rspm := apply(tr.inv_parts, hi).4
    have hd: tr.hd(x) = H by defs(simp(hr, rspm), tr.hd)
    have nb := mp(all_elim(hbo, {x}), hr)
    have nr := apply(tr.inv_nr, hi)
    have wu := hi.wu
    show by taut(hd, nb, nr, wu, hu)
  qed
  have hb2: all x y w. Q(x, y, w) -> tr.sim(s, z. tr.hd(z) = H || bkp(z), z p2 w2. tr.hd(z) = H && (ex y2. Q(z, y2, w2) && runs(p2, w2, ok(w2, pair(18446744073709551616, y2)))),
      v, tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w, x) proof
    fix x y w
    assume q
    have hi hr hh hg hm hf hu hy := q
    have wW := hi.wW
    have wu := hi.wu
    have l := mp(all_elim(hb, {y}, {w}), hu, hy, conj(wW, wu))
    show := mp(all_elim(expand(l, tr.lv), {x}), hi, hr, hh, hg, hm, hf)
  qed
  have lp := mp(tr.loop[s := s, v := v, h := H, bp := z. bkp(z), ar := z p w. bka(z, p, w), b := l o. b(l, o), tr := l. tr(l), k := x8 x1. k(x8, x1),
    kw := x3 x4 x2. kw(x3, x4, x2), q := x y w. Q(x, y, w)], hq, hk2, htr, hb2)
  fix y w
  assume hu hy
  have g: all m. tr.inv(s, base, code, fr, m, w) -> m.rip = ha -> tr.homes(s, m, hs(y)) -> tr.regs(m, rc) -> tr.mem(s, m, w, v) -> tr.frame(s, m, fd) ->
      tr.sim(s, z. bkp(z), z p w. bka(z, p, w), v, tr.lprog(y, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)), w, m) proof
    fix m
    assume hi hr hh hg hm hf
    have q: Q(m, y, w) by taut(hi, hr, hh, hg, hm, hf, hu, hy)
    show := mp(all_elim(lp, {m}, {y}, {w}), q)
  qed
  show by defs(g, tr.lv)
qed

// (back at the head, coupled to the locals y2, the spec's marked return of
// them: the arrival)
// (the frame of fd bytes: of fewer too)
theorem tr.frame_le: all s base code fr m w fd fd2. tr.inv(s, base, code, fr, m, w) -> fd in omega -> fd2 in omega -> int_lt(0, fd2) -> int_le(fd2, fd) -> int_le(fd, tr.FMAX) ->
  tr.frame(s, m, fd) -> tr.frame(s, m, fd2)
proof
  fix s base code fr m w fd fd2
  assume hi fo h2o hpos hle hmax hf
  have {sM} := hi
  have r4 := apply(x86i.rsp_typed, sM)
  have g8 := apply(tr.inv_gap, hi)
  let R := s.gpr[4]
  let C := int_sub(18446744073709551616, fd)
  let C2 := int_sub(18446744073709551616, fd2)
  have hr: tr.hrange(C, fd) by defs(arith(fo, hpos, hle, hmax), tr.hrange)
  have hr2: tr.hrange(C2, fd2) by defs(arith(h2o, hpos, hle, hmax), tr.hrange)
  have c: tr.hacc(s, m.vm, C, fd) -> tr.hacc(s, m.vm, C2, fd2) proof
    assume ha
    have g: all i. i in omega -> int_lt(i, fd2) ->
        x86_64_linux.can_access(m.vm, bits_add(64, tr.ha(s, C2), bits_of_int(64, i)), 1) &&
        abi.stack_page(m.vm, int_div(bits_add(64, tr.ha(s, C2), bits_of_int(64, i)), 4096)) proof
      fix i
      assume i1 i2
      let J := int_add(i, int_sub(fd, fd2))
      have j1: J in omega by arith(i1, hle, h2o)
      have j2: int_lt(J, fd) by arith(i2, hle)
      have aj := mp(all_elim(expand(ha, tr.hacc), {J}), j1, j2)
      have e1 .. := apply(tr.ha_byte, {R}, {C}, {fd}, {J}, r4, g8, hr, j1, j2)
      have e2 .. := apply(tr.ha_byte, {R}, {C2}, {fd2}, {i}, r4, g8, hr2, i1, i2)
      have ee: int_add(int_sub(R, int_sub(18446744073709551616, C)), J) = int_add(int_sub(R, int_sub(18446744073709551616, C2)), i) by arith(fo, h2o)
      have aj2 := rewrite(ee, rewrite(e1, aj))
      show by simp(e2, aj2)
    qed
    show by defs(g, tr.hacc)
  qed
  have f0 := expand(hf, tr.frame)
  show by defs(taut(f0, c), tr.frame)
qed

// (a claim at a frame of fd2 bytes: at one of more)
theorem tr.pt_fd(zb. bkp, zb pb wb. bka): all s v base code fr a hs fd fd2 rs p w. fd in omega -> fd2 in omega -> int_lt(0, fd2) -> int_le(fd2, fd) -> int_le(fd, tr.FMAX) ->
  tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, fd2, rs, p, w) -> tr.pt(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, fd, rs, p, w)
proof
  fix s v base code fr a hs fd fd2 rs p w
  assume fo h2o hpos hle hmax h
  have g: all m. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, fd) ->
      tr.cl(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m) proof
    fix m
    assume hi hr hh hrs hmm hfr
    have f2 := apply(tr.frame_le, {s}, {base}, {code}, {fr}, {m}, {w}, {fd}, {fd2}, hi, fo, h2o, hpos, hle, hmax, hfr)
    show := mp(all_elim(expand(h, tr.pt), {m}), hi, hr, hh, hrs, hmm, f2)
  qed
  show by defs(g, tr.pt)
qed

theorem tr.pt_head(s, v, base, code, fr, ha, fd, rc, y. hs, y. yt, z. bkp): all hs2 rs p w y2. tr.hsub(hs(y2), hs2) -> tr.cs_sub(rc, rs) -> pair(w, y2) in univ(1) -> yt(y2) ->
  runs(p, w, ok(w, pair(18446744073709551616, y2))) ->
  tr.pt(s, z. tr.hd(z) = pair(ha, int_sub(s.gpr[4], fr)) || bkp(z),
    z p2 w2. tr.hd(z) = pair(ha, int_sub(s.gpr[4], fr)) && (ex y3. (tr.inv(s, base, code, fr, z, w2) && z.rip = ha && tr.homes(s, z, hs(y3)) && tr.regs(z, rc) &&
      tr.mem(s, z, w2, v) && tr.frame(s, z, fd) && pair(w2, y3) in univ(1) && yt(y3)) && runs(p2, w2, ok(w2, pair(18446744073709551616, y3)))),
    v, base, code, fr, ha, hs2, fd, rs, p, w)
proof
  fix hs2 rs p w y2
  assume hsb hsub hu hy hr
  let Q(x, y, w) := tr.inv(s, base, code, fr, x, w) && x.rip = ha && tr.homes(s, x, hs(y)) && tr.regs(x, rc) && tr.mem(s, x, w, v) && tr.frame(s, x, fd) && pair(w, y) in univ(1) && yt(y)
  let H := pair(ha, int_sub(s.gpr[4], fr))
  have g: all m. tr.inv(s, base, code, fr, m, w) -> m.rip = ha -> tr.homes(s, m, hs2) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, fd) ->
      tr.cl(s, z. tr.hd(z) = H || bkp(z), z p2 w2. tr.hd(z) = H && (ex y3. Q(z, y3, w2) && runs(p2, w2, ok(w2, pair(18446744073709551616, y3)))), v, p, w, m) proof
    fix m
    assume hi hr2 hh hrs hm hf
    have hh1 := apply(tr.homes_sub, hsb, hh)
    have hg := apply(tr.regs_cs_keep[m := m, x := m, rs := rs, rc := rc], hrs, hsub, (all r. tr.cs_reg(r) -> m.gpr[r] = m.gpr[r] by rsimp()))
    have rspm := apply(tr.inv_parts, hi).4
    have hd: tr.hd(m) = H by defs(simp(hr2, rspm), tr.hd)
    have nr := apply(tr.inv_nr, hi)
    have st: tr.stopk(s, z. tr.hd(z) = H || bkp(z), m) by defs(taut(hd), tr.stopk)
    have rd: tr.red(p, w, p, w) proof
      have g3: all o. runs(p, w, o) -> runs(p, w, o) proof
        fix o
        assume h
        show := h
      qed
      show by defs(g3, tr.red)
    qed
    have q: Q(m, y2, w) by taut(hi, hr2, hh1, hg, hm, hf, hu, hy)
    have ey: ex y3. Q(m, y3, w) && runs(p, w, ok(w, pair(18446744073709551616, y3))) by ex_intro({y2}, taut(q, hr))
    have ex2: ex p2 w2. tr.red(p, w, p2, w2) && (tr.hd(m) = H && (ex y3. Q(m, y3, w2) && runs(p2, w2, ok(w2, pair(18446744073709551616, y3)))))
      by ex_intro({p}, {w}, taut(rd, hd, ey))
    have a: tr.arr(s, z. tr.hd(z) = H || bkp(z), z p2 w2. tr.hd(z) = H && (ex y3. Q(z, y3, w2) && runs(p2, w2, ok(w2, pair(18446744073709551616, y3)))), v, m, p, w)
      by defs(taut(nr, ex2), tr.arr)
    show by defs(taut(st, a), tr.cl)
  qed
  show by defs(g, tr.pt)
qed

// (the loop state's trace, GIMPLE's: of the universe)
theorem tr.tr_univ: all l. l in univ(1) -> fn_update(empty, "os.events", fst(l).os.events) in univ(1)
proof
  fix l
  assume h
  have f := apply(tr.fst_univ, {l}, h)
  have a1 := mp(app_univ[u := 1, f := fst(l), k := "os"], f)
  have a2 := mp(app_univ[u := 1, f := fst(l).os, k := "events"], a1)
  show by simp(a2)
qed

// (the claim leaving a point, for a spec with more runs)
theorem tr.lv_red(zb. bkp, zb pb wb. bka): all s v base code fr a hs ds rs p p2 w. (all o. runs(p2, w, o) -> runs(p, w, o)) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p2, w) -> tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, p, w)
proof
  fix s v base code fr a hs ds rs p p2 w
  assume hr h
  have rd: tr.red(p, w, p2, w) by defs(hr, tr.red)
  have g: all m. tr.inv(s, base, code, fr, m, w) -> m.rip = a -> tr.homes(s, m, hs) -> tr.regs(m, rs) -> tr.mem(s, m, w, v) -> tr.frame(s, m, ds) ->
      tr.sim(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, p, w, m) proof
    fix m
    assume hi hr2 hh hrs hmm hfr
    have c := mp(all_elim(expand(h, tr.lv), {m}), hi, hr2, hh, hrs, hmm, hfr)
    show := apply(tr.sim_red[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {p}, {w}, {p2}, {w}, {m}, rd, c)
  qed
  show by defs(g, tr.lv)
qed

// The loop's exit (the body leaving with e, at its world): the claim with
// no arrival on the rest in the wrapper gives the iteration's end's
theorem tr.lv_exit(zb. bkp, zb pb wb. bka, x8 x1. k, x3 x4 x2. kw): all s v base code fr a hs ds rs e w. !is_ok(e) -> fst(out_state(e)) = w ->
  tr.lv(s, zb. bkp(zb), zb pb wb. false, v, base, code, fr, a, hs, ds, rs,
    mkprog(x1 x2. bind_rel(mkprog(x0 x3. k(e, x3)), x1, x4 x5. kw(x4, x5, x2), x4 x5. x2 = exc(x4, x5), x4. x2 = diverge(x4))), w) ->
  tr.lv(s, zb. bkp(zb), zb pb wb. bka(zb, pb, wb), v, base, code, fr, a, hs, ds, rs, mkprog(x1 x2. bind_rel(mkprog(x0 x1. tr.lcont(e, x1, x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2))), x1, x3 x4. x2 = ok(x3, x4), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w)
proof
  fix s v base code fr a hs ds rs e w
  assume hn hw h
  have u := apply(tr.lv_unmark[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb), kw := x3 x4 x2. kw(x3, x4, x2)],
    {s}, {v}, {base}, {code}, {fr}, {a}, {hs}, {ds}, {rs}, {mkprog(x0 x3. k(e, x3))}, {w}, h)
  have r: all o. runs(mkprog(x1 x2. bind_rel(mkprog(x0 x3. k(e, x3)), x1, x4 x5. kw(x4, x5, x2), x4 x5. x2 = exc(x4, x5), x4. x2 = diverge(x4)) && !tr.mk(x2) && tr.isout(x2)), w, o) ->
      runs(mkprog(x1 x2. bind_rel(mkprog(x0 x1. tr.lcont(e, x1, x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2))), x1, x3 x4. x2 = ok(x3, x4), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))), w, o) proof
    fix o
    assume hr
    have io := apply(g.runs_elim, hr).3
    have c := apply(tr.lcont_exit[k := x8 x1. k(x8, x1), kw := x3 x4 x2. kw(x3, x4, x2)], {w}, {e}, {o}, hn, hw, hr)
    show := apply(tr.wrap_id_in[r := x0 x1. tr.lcont(e, x1, x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2))], {w}, {o}, c, io)
  qed
  show := apply(tr.lv_red[bkp := zb. bkp(zb), bka := zb pb wb. bka(zb, pb, wb)], {s}, {v}, {base}, {code}, {fr}, {a}, {hs}, {ds}, {rs},
    {mkprog(x1 x2. bind_rel(mkprog(x0 x1. tr.lcont(e, x1, x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2))), x1, x3 x4. x2 = ok(x3, x4), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3)))},
    {mkprog(x1 x2. bind_rel(mkprog(x0 x3. k(e, x3)), x1, x4 x5. kw(x4, x5, x2), x4 x5. x2 = exc(x4, x5), x4. x2 = diverge(x4)) && !tr.mk(x2) && tr.isout(x2))}, {w}, r, u)
qed

// (a return: an outcome)
theorem tr.isout_ok: all a b. tr.isout(ok(a, b))
proof
  fix a b
  have e1: ex a0 b0. ok(a, b) = ok(a0, b0) by ex_intro({a}, {b}, refl({ok(a, b)}))
  show by defs(taut(e1), tr.isout)
qed

// (the body left with e, the rest raising (it reads no world): the
// iteration's end raises)
theorem tr.lcont_raise(x8 x1. k, x3 x4 x2. kw): all w e x y. !is_ok(e) -> fst(out_state(e)) in univ(1) -> runs(mkprog(x0 x3. k(e, x3)), w, exc(x, y)) ->
  runs(mkprog(x0 x1. tr.lcont(e, x1, x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2))), w, exc(x, y))
proof
  fix w e x y
  assume hn hw1 hr
  have pu := apply(g.runs_univ, hr)
  have kr := apply(g.runs_elim, hr)
  have u1: pair(fst(out_state(e)), exc(x, y)) in univ(1) by simp(pu, hw1)
  have hr2 := apply(tr.runs_intro[r := x0 x3. k(e, x3)], {fst(out_state(e))}, {exc(x, y)}, u1, kr)
  have ec: ex s1 e1. exc(x, y) = exc(s1, e1) && exc(x, y) = exc(s1, e1) by ex_intro({x}, {y}, taut(refl({exc(x, y)})))
  have b: bind_rel(mkprog(x0 x3. k(e, x3)), fst(out_state(e)), x4 x5. kw(x4, x5, exc(x, y)), x4 x5. exc(x, y) = exc(x4, x5), x4. exc(x, y) = diverge(x4))
    by defs(ex_intro({exc(x, y)}, taut(hr2, ec)), bind_rel)
  have nm: !tr.mk(exc(x, y)) proof
    have n: tr.mk(exc(x, y)) -> false proof
      assume m
      obtain a0 b0, me from expand(m, tr.mk)
      show by simp(me)
    qed
    show by taut(n)
  qed
  have e1: ex a0 b0. exc(x, y) = exc(a0, b0) by ex_intro({x}, {y}, refl({exc(x, y)}))
  have io: tr.isout(exc(x, y)) by defs(taut(e1), tr.isout)
  have c: tr.lcont(e, exc(x, y), x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2)) by defs(taut(hn, b, nm, io), tr.lcont)
  show := apply(tr.runs_intro[r := x0 x1. tr.lcont(e, x1, x8 x1. k(x8, x1), x3 x4 x2. kw(x3, x4, x2))], {w}, {exc(x, y)}, pu, c)
qed
