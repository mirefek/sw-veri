// C1 of loops: breakpoints and the loop rule.
//
// The claim at a point (tr.simk) is about the machine's run from there --
// at least one step -- to the first state that is a breakpoint: the
// function's return, or a point of bp (a loop's head). There the arrival
// condition holds: at the return, the spec returns as the machine does; at
// a point of bp, the relation ar of the state and the spec reached. The
// loop rule (tr.loop) has the claim for a loop at its head from the claim
// for one iteration (the head a breakpoint, arrived at coupled, the
// iteration's spec returning the next locals marked) -- by induction along
// a finite run, by coinduction for an infinite one.
//
//   slc kernel-check <the translate chain> proofs/translate_loop.core

// ----------------------------------------------------------------------
//  A loop in the spec at a loop head: the loop from the locals y (the
//  world x0), then the rest k; one iteration of it (tr.lone): the body,
//  then -- going on -- a return marked by 2^64 (no 64-bit word: never the
//  function's return) with the next locals, or -- leaving -- the rest
//  (its marked returns dropped). (tr.lpf: the loop's finite runs.)

def tr.mk(o) := ex a b. o = ok(a, pair(18446744073709551616, b))
def tr.lprog(y, l o. b, l. tr, x8 x1. k) := mkprog(x0 x1. ex x8. while_rel(pair(x0, y), l. true, l o. b(l, o), l. tr(l), x8) && k(x8, x1))
def tr.lpf(y, l o. b, x8 x1. k) := mkprog(x0 x1. ex x8. while_fin_rel(pair(x0, y), l. true, l o. b(l, o), x8) && k(x8, x1))
def tr.lone(y, l o. b, x8 x1. k) := mkprog(x0 x1. ex x8. b(pair(x0, y), x8) &&
  ((ex w2 y2. x8 = ok(pair(w2, y2), empty) && x1 = ok(w2, pair(18446744073709551616, y2))) || (!is_ok(x8) && k(x8, x1) && !tr.mk(x1))))

// (an iteration's outcome, unmarked: the loop's, of no further iteration)
theorem tr.lone_f(l o. b, x8 x1. k): all w y o. runs(tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1)), w, o) -> !tr.mk(o) ->
  runs(tr.lpf(y, l o. b(l, o), x8 x1. k(x8, x1)), w, o)
proof
  fix w y o
  assume hr hm
  have tt: true by taut()
  have pu := apply(g.runs_univ, expand(hr, tr.lone))
  obtain x8, br cr from apply(g.runs_elim, expand(hr, tr.lone))
  have go: (ex w2 y2. x8 = ok(pair(w2, y2), empty) && o = ok(w2, pair(18446744073709551616, y2))) -> false proof
    assume e
    obtain w2 y2, _ oe from e
    have m: tr.mk(o) by defs(ex_intro({w2}, {y2}, oe), tr.mk)
    show by taut(m, hm)
  qed
  have lv: !is_ok(x8) && k(x8, o) by taut(cr, go)
  have w1 := mp(while_fin_one[l0 := pair(w, y), c := l. true, b := l o. b(l, o), r := x8], taut(tt, br, lv))
  have r0: ex x9. while_fin_rel(pair(w, y), l. true, l o. b(l, o), x9) && k(x9, o) by ex_intro({x8}, taut(w1, lv))
  have r1 := apply(tr.runs_intro[r := x0 x1. ex x9. while_fin_rel(pair(x0, y), l. true, l o. b(l, o), x9) && k(x9, x1)], {w}, {o}, pu, r0)
  show by defs(r1, tr.lpf)
qed

// (an iteration's marked return: the body went on, to y2)
theorem tr.lone_mk(l o. b, x8 x1. k): all w y w2 y2. runs(tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1)), w, ok(w2, pair(18446744073709551616, y2))) ->
  b(pair(w, y), ok(pair(w2, y2), empty))
proof
  fix w y w2 y2
  assume hr
  obtain x8, br cr from apply(g.runs_elim, expand(hr, tr.lone))
  have m: tr.mk(ok(w2, pair(18446744073709551616, y2))) by defs(ex_intro({w2}, {y2}, refl({ok(w2, pair(18446744073709551616, y2))})), tr.mk)
  have nm: !(!is_ok(x8) && k(x8, ok(w2, pair(18446744073709551616, y2))) && !tr.mk(ok(w2, pair(18446744073709551616, y2)))) by taut(m)
  have c1: ex w3 y3. x8 = ok(pair(w3, y3), empty) && ok(w2, pair(18446744073709551616, y2)) = ok(w3, pair(18446744073709551616, y3)) by taut(cr, nm)
  obtain w3 y3, xe oe from c1
  have e1: w3 = w2 && y3 = y2 by simp(oe)
  have xe2: x8 = ok(pair(w2, y2), empty) by simp(xe, e1)
  show := rewrite(xe2, br)
qed

// (an iteration, then a finite run from y2: a finite run from y, the same
// outcome)
theorem tr.lpf_step(l o. b, x8 x1. k): all w y w2 y2 o. w in univ(1) -> b(pair(w, y), ok(pair(w2, y2), empty)) ->
  runs(tr.lpf(y2, l o. b(l, o), x8 x1. k(x8, x1)), w2, o) -> runs(tr.lpf(y, l o. b(l, o), x8 x1. k(x8, x1)), w, o)
proof
  fix w y w2 y2 o
  assume hw hb hr
  have tt: true by taut()
  have pu := apply(g.runs_univ, expand(hr, tr.lpf))
  have u: pair(w, o) in univ(1) by simp(hw, pu)
  obtain x8, wr kr from apply(g.runs_elim, expand(hr, tr.lpf))
  have w1 := mp(while_step_fin[l0 := pair(w, y), l1 := pair(w2, y2), c := l. true, b := l o. b(l, o), r := x8], tt, hb, wr)
  have r0: ex x9. while_fin_rel(pair(w, y), l. true, l o. b(l, o), x9) && k(x9, o) by ex_intro({x8}, taut(w1, kr))
  have r1 := apply(tr.runs_intro[r := x0 x1. ex x9. while_fin_rel(pair(x0, y), l. true, l o. b(l, o), x9) && k(x9, x1)], {w}, {o}, u, r0)
  show by defs(r1, tr.lpf)
qed

// (a finite run: a run of the loop)
theorem tr.lpf_lp(l o. b, l. tr, x8 x1. k): all w y o. runs(tr.lpf(y, l o. b(l, o), x8 x1. k(x8, x1)), w, o) ->
  runs(tr.lprog(y, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1)), w, o)
proof
  fix w y o
  assume hr
  have pu := apply(g.runs_univ, expand(hr, tr.lpf))
  obtain x8, wr kr from apply(g.runs_elim, expand(hr, tr.lpf))
  have w1 := mp(while_fin_while[l0 := pair(w, y), c := l. true, b := l o. b(l, o), tr := l. tr(l), r := x8], wr)
  have r0: ex x9. while_rel(pair(w, y), l. true, l o. b(l, o), l. tr(l), x9) && k(x9, o) by ex_intro({x8}, taut(w1, kr))
  have r1 := apply(tr.runs_intro[r := x0 x1. ex x9. while_rel(pair(x0, y), l. true, l o. b(l, o), l. tr(l), x9) && k(x9, x1)], {w}, {o}, pu, r0)
  show by defs(r1, tr.lprog)
qed

// ----------------------------------------------------------------------
//  Breakpoints: the claim at a point is about the run from there to the
//  first state, after a step, that is a breakpoint -- the return
//  (tr.at_ret) or one of bp; there the arrival condition holds: at the
//  return, the spec returns as the machine does (tr.retok); at a point of
//  bp, ar of the state and of the spec reached (up to a reduction)

def tr.stopk(s, z. bp, m) := tr.at_ret(s, m) || bp(m)
def tr.rbk(s, z. bp, l, o) := (tr.stopk(s, z. bp(z), fst(l)) && o = exc(pair(fst(l), empty), pair("brk", empty))) ||
  (!tr.stopk(s, z. bp(z), fst(l)) && tr.rbd(s, l, o))
def tr.rwk(s, z. bp, l, r) := while_rel(l, x5. true, x5 x6. tr.rbk(s, z. bp(z), x5, x6), x5. fn_update(empty, "os.events", app(app(fst(x5), "os"), "events")), r)
def tr.rk(s, z. bp, m, r) := (ex l1. tr.rbd(s, pair(m, empty), ok(l1, empty)) && tr.rwk(s, z. bp(z), l1, r)) || (tr.rbd(s, pair(m, empty), r) && !is_ok(r))
def tr.run_k(s, z. bp, m, o) := ex r. tr.rk(s, z. bp(z), m, r) && tr.rmap(r, o)

def tr.retok(s, v, p, w, m1) := m1 in x86_64_linux.Machine && m1 in univ(1) &&
  (ex w2. runs(p, w, ok(w2, pair(app(app(m1, "gpr"), 0), app(app(m1, "gpr"), 2)))) && w2 in abi.World && w2 in univ(1) &&
    abi.world_matches(app(s, "vm"), app(m1, "vm"), app(w2, "vm"), v, abi.sp(s)) && app(m1, "os") = app(w2, "os") && app(m1, "fs_base") = app(w2, "fs_base")) &&
  app(m1, "cpu") = app(s, "cpu") && app(m1, "gs_base") = app(s, "gs_base") && app(m1, "rip") = abi.ret(s) && app(app(m1, "gpr"), 4) = abi.sp(s) &&
  abi.callee_saved(m1, s) && !app(app(m1, "flags"), "df")
def tr.arr(s, z. bp, z p w. ar, v, m, p, w) := (tr.at_ret(s, m) -> tr.retok(s, v, p, w, m)) && (bp(m) -> (ex p2 w2. tr.red(p, w, p2, w2) && ar(m, p2, w2)))
def tr.simk(s, z. bp, z p w. ar, v, p, w, m) := all o. tr.run_k(s, z. bp(z), m, o) ->
  tr.ub(s, v, p, w) || tr.crash(s, p, w, o) || tr.div(p, w, o) || (ex m1. o = ok(m1, empty) && tr.arr(s, z. bp(z), z p w. ar(z, p, w), v, m1, p, w))

// the outcome o as the spec's: undefined, a crash, a divergence, or the
// return (no point of bp)
def tr.lg(s, z. bp, v, p, w, o) := tr.ub(s, v, p, w) || tr.crash(s, p, w, o) || tr.div(p, w, o) ||
  (ex m1. o = ok(m1, empty) && tr.at_ret(s, m1) && !bp(m1) && tr.retok(s, v, p, w, m1))

// (... carried to a spec with those outcomes: its exceptions, divergences,
// returns of a 64-bit word)
theorem tr.lg_mono(z. bp): all s v p w p2 w2 o.
  (all x e. runs(p2, w2, exc(x, e)) -> runs(p, w, exc(x, e))) -> (all t. runs(p2, w2, diverge(t)) -> runs(p, w, diverge(t))) ->
  (all w3 r0 r1. r0 in bits(64) -> runs(p2, w2, ok(w3, pair(r0, r1))) -> runs(p, w, ok(w3, pair(r0, r1)))) ->
  tr.lg(s, z. bp(z), v, p2, w2, o) -> tr.lg(s, z. bp(z), v, p, w, o)
proof
  fix s v p w p2 w2 o
  assume hx hd hk h
  have c1: tr.ub(s, v, p2, w2) -> tr.ub(s, v, p, w) proof
    assume u
    obtain e x, eu en rs rr from expand(u, tr.ub)
    have r := mp(all_elim(hx, {x}, {e}), rr)
    show by defs(ex_intro({e}, {x}, taut(eu, en, rs, r)), tr.ub)
  qed
  have c2: tr.crash(s, p2, w2, o) -> tr.crash(s, p, w, o) proof
    assume c
    obtain m1 a k0, c3 from expand(c, tr.crash)
    have o2: tr.ovf(p2, w2, app(m1, "os")) -> tr.ovf(p, w, app(m1, "os")) proof
      assume hv
      have e1: (ex x. x in rec_and(abi.World, single(empty)) && runs(p2, w2, exc(x, exc_val("stack_overflow", empty))) && app(app(x, "os"), "events") = app(app(m1, "os"), "events")) ->
          tr.ovf(p, w, app(m1, "os")) proof
        assume e
        obtain x, xa xr xe from e
        have r := mp(all_elim(hx, {x}, {exc_val("stack_overflow", empty)}), xr)
        have e2: ex x1. x1 in rec_and(abi.World, single(empty)) && runs(p, w, exc(x1, exc_val("stack_overflow", empty))) && app(app(x1, "os"), "events") = app(app(m1, "os"), "events")
          by ex_intro({x}, taut(xa, r, xe))
        show by defs(taut(e2), tr.ovf)
      qed
      have e3: (ex t. runs(p2, w2, diverge(t))) -> tr.ovf(p, w, app(m1, "os")) proof
        assume e
        obtain t, tr2 from e
        have r := mp(all_elim(hd, {t}), tr2)
        have e2: ex t1. runs(p, w, diverge(t1)) by ex_intro({t}, r)
        show by defs(taut(e2), tr.ovf)
      qed
      show by taut(expand(hv, tr.ovf), e1, e3)
    qed
    show by defs(ex_intro({m1}, {a}, {k0}, taut(c3, o2)), tr.crash)
  qed
  have c3: tr.div(p2, w2, o) -> tr.div(p, w, o) proof
    assume d
    have d1 d2 := expand(d, tr.div)
    obtain t, rt from d2
    have r := mp(all_elim(hd, {t}), rt)
    have e2: ex t1. runs(p, w, diverge(t1)) by ex_intro({t}, r)
    show by defs(taut(d1, e2), tr.div)
  qed
  have c4: (ex m1. o = ok(m1, empty) && tr.at_ret(s, m1) && !bp(m1) && tr.retok(s, v, p2, w2, m1)) ->
      (ex m1. o = ok(m1, empty) && tr.at_ret(s, m1) && !bp(m1) && tr.retok(s, v, p, w, m1)) proof
    assume e
    obtain m1, oe ar nb rt from e
    have rx := expand(rt, tr.retok)
    have mM: m1 in x86_64_linux.Machine by taut(rx)
    have ew: ex w3. runs(p2, w2, ok(w3, pair(app(app(m1, "gpr"), 0), app(app(m1, "gpr"), 2)))) && w3 in abi.World && w3 in univ(1) &&
        abi.world_matches(app(s, "vm"), app(m1, "vm"), app(w3, "vm"), v, abi.sp(s)) && app(m1, "os") = app(w3, "os") && app(m1, "fs_base") = app(w3, "fs_base") by taut(rx)
    obtain w3, h3 from ew
    have r0: 0 in x86_64_linux.Reg by simp()
    have rb := apply(x86i.reg_typed, mM, r0)
    have r := mp(all_elim(hk, {w3}, {app(app(m1, "gpr"), 0)}, {app(app(m1, "gpr"), 2)}), rb, h3.1)
    have ew2: ex w4. runs(p, w, ok(w4, pair(app(app(m1, "gpr"), 0), app(app(m1, "gpr"), 2)))) && w4 in abi.World && w4 in univ(1) &&
        abi.world_matches(app(s, "vm"), app(m1, "vm"), app(w4, "vm"), v, abi.sp(s)) && app(m1, "os") = app(w4, "os") && app(m1, "fs_base") = app(w4, "fs_base")
      by ex_intro({w3}, taut(r, h3))
    have rt2: tr.retok(s, v, p, w, m1) by defs(taut(rx, ew2), tr.retok)
    show by ex_intro({m1}, taut(oe, ar, nb, rt2))
  qed
  show by defs(taut(expand(h, tr.lg), c1, c2, c3, c4), tr.lg)
qed

// (a pass that does not go on: a raise, a divergence, or the return
// reached)
theorem tr.rbd_out: all s l r. tr.rbd(s, l, r) -> !is_ok(r) ->
  (fst(r) = 1 && fst(out_value(r)) = "raise") || fst(r) = 2 || (r = exc(pair(fst(l), empty), pair("brk", empty)) && tr.at_ret(s, fst(l)))
proof
  fix s l r
  assume h hn
  show by simp(hn, expand(h, tr.rbd, tr.rb, bind_rel), keep(x86_64_linux.step))
qed

// (a pass that goes on: to a loop state, at a state that is no stop)
theorem tr.rbk_ok(z. bp): all s l l2 e. tr.rbk(s, z. bp(z), l, ok(l2, e)) -> !tr.stopk(s, z. bp(z), fst(l)) && tr.rbd(s, l, ok(l2, e)) && l2 = pair(fst(l2), empty)
proof
  fix s l l2 e
  assume h
  have c: !tr.stopk(s, z. bp(z), fst(l)) && tr.rbd(s, l, ok(l2, e)) by simp(expand(h, tr.rbk))
  have q: l2 = pair(fst(l2), empty) by simp(expand(c.2, tr.rbd, tr.rb), keep(x86_64_linux.step))
  show by taut(c, q)
qed

// (the run's return: at a stop)
theorem tr.run_k_stop(z. bp): all s m m1 e. tr.run_k(s, z. bp(z), m, ok(m1, e)) -> tr.stopk(s, z. bp(z), m1)
proof
  fix s m m1 e
  assume h
  obtain r, rk rm from expand(h, tr.run_k)
  // (the run leaving with r at the loop state l: a stop where it is a break)
  have lv: all l. (tr.rbd(s, l, r) && !is_ok(r)) || (tr.stopk(s, z. bp(z), fst(l)) && r = exc(pair(fst(l), empty), pair("brk", empty))) ->
      tr.stopk(s, z. bp(z), m1) proof
    fix l
    assume hl
    have o1: (fst(r) = 1 && fst(out_value(r)) = "raise") -> false proof
      assume e1
      have rm2 := rewrite(e1.2, expand(rm, tr.rmap))
      show by simp(rm2, e1.1)
    qed
    have o2: fst(r) = 2 -> false proof
      assume e1
      show by simp(expand(rm, tr.rmap), e1)
    qed
    have o3: r = exc(pair(fst(l), empty), pair("brk", empty)) -> m1 = fst(l) proof
      assume e1
      have rm2 := rewrite(e1, expand(rm, tr.rmap))
      show by simp(rm2)
    qed
    have c1: tr.rbd(s, l, r) && !is_ok(r) -> tr.stopk(s, z. bp(z), m1) proof
      assume hb
      have ro := apply(tr.rbd_out, {s}, {l}, {r}, hb.1, hb.2)
      have ar: r = exc(pair(fst(l), empty), pair("brk", empty)) && tr.at_ret(s, fst(l)) by taut(ro, o1, o2)
      have me := mp(o3, ar.1)
      have st: tr.stopk(s, z. bp(z), fst(l)) by defs(taut(ar.2), tr.stopk)
      show := rewrite(sym(me), st)
    qed
    have c2: tr.stopk(s, z. bp(z), fst(l)) && r = exc(pair(fst(l), empty), pair("brk", empty)) -> tr.stopk(s, z. bp(z), m1) proof
      assume hb
      have me := mp(o3, hb.2)
      show := rewrite(sym(me), hb.1)
    qed
    show by taut(hl, c1, c2)
  qed
  // the first pass leaves
  have f1: tr.rbd(s, pair(m, empty), r) && !is_ok(r) -> tr.stopk(s, z. bp(z), m1) proof
    assume hb
    show := mp(all_elim(lv, {pair(m, empty)}), taut(hb))
  qed
  // the loop leaves (it cannot stop: its condition is true), or diverges
  have f2: (ex l1. tr.rbd(s, pair(m, empty), ok(l1, empty)) && tr.rwk(s, z. bp(z), l1, r)) -> tr.stopk(s, z. bp(z), m1) proof
    assume e
    obtain l1, _ hw from e
    have cs := mp(while_cases[l0 := l1, c := x5. true, b := x5 x6. tr.rbk(s, z. bp(z), x5, x6), tr := x5. fn_update(empty, "os.events", app(app(fst(x5), "os"), "events")), r := r],
      expand(hw, tr.rwk))
    have d: (ex t. r = diverge(t)) -> tr.stopk(s, z. bp(z), m1) proof
      assume ed
      obtain t, rt from ed
      have rm2 := rewrite(rt, expand(rm, tr.rmap))
      show by simp(rm2)
    qed
    have b: (ex l. (!true && r = ok(l, empty)) || (true && tr.rbk(s, z. bp(z), l, r) && !is_ok(r))) -> tr.stopk(s, z. bp(z), m1) proof
      assume el
      obtain l, hl from el
      have hb: tr.rbk(s, z. bp(z), l, r) && !is_ok(r) by taut(hl)
      have hb2: (tr.rbd(s, l, r) && !is_ok(r)) || (tr.stopk(s, z. bp(z), fst(l)) && r = exc(pair(fst(l), empty), pair("brk", empty))) by taut(expand(hb.1, tr.rbk), hb.2)
      show := mp(all_elim(lv, {l}), hb2)
    qed
    show by taut(cs, d, b)
  qed
  show by taut(expand(rk, tr.rk), f1, f2)
qed

// ----------------------------------------------------------------------
//  A loop: its head h (the rip and rsp of a state), the coupling q(x, y, w)
//  of a machine state at the head with the spec's locals y and world w.
//  The claim for one iteration (tr.lone) with the head as a breakpoint,
//  arriving there coupled, the spec returning the next locals marked;
//  so the claim for the loop.

def tr.hd(x) := pair(app(x, "rip"), app(app(x, "gpr"), 4))

// (an iteration: as the loop's run ends, or back at the head after one
// pass of the body)
theorem tr.loop_d(s, v, h, z. bp, l o. b, x8 x1. k, x y w. q):
  (all x y w. q(x, y, w) -> tr.simk(s, z. tr.hd(z) = h || bp(z), z p2 w2. tr.hd(z) = h && (ex y2. q(z, y2, w2) && runs(p2, w2, ok(w2, pair(18446744073709551616, y2)))),
    v, tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1)), w, x)) ->
  all x y w o. q(x, y, w) -> tr.run_k(s, z. tr.hd(z) = h || bp(z), x, o) ->
    tr.lg(s, z. bp(z), v, tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1)), w, o) ||
    (ex m1 y2 w2. o = ok(m1, empty) && q(m1, y2, w2) && b(pair(w, y), ok(pair(w2, y2), empty)))
proof
  assume hb
  fix x y w o
  assume hq hr
  let P := tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1))
  let G := tr.lg(s, z. bp(z), v, P, w, o) || (ex m1 y2 w2. o = ok(m1, empty) && q(m1, y2, w2) && b(pair(w, y), ok(pair(w2, y2), empty)))
  have c := mp(all_elim(expand(mp(all_elim(hb, {x}, {y}, {w}), hq), tr.simk), {o}), hr)
  have u: tr.ub(s, v, P, w) || tr.crash(s, P, w, o) || tr.div(P, w, o) -> G proof
    assume e
    have l: tr.lg(s, z. bp(z), v, P, w, o) by defs(taut(e), tr.lg)
    show by taut(l)
  qed
  have a: (ex m1. o = ok(m1, empty) && tr.arr(s, z. tr.hd(z) = h || bp(z), z p2 w2. tr.hd(z) = h && (ex y2. q(z, y2, w2) && runs(p2, w2, ok(w2, pair(18446744073709551616, y2)))),
      v, m1, P, w)) -> G proof
    assume e
    obtain m1, oe ha from e
    have ar1 ar2 := expand(ha, tr.arr)
    have st := apply(tr.run_k_stop[bp := z. tr.hd(z) = h || bp(z)], {s}, {x}, {m1}, {empty}, rewrite(oe, hr))
    // at the head or a point of bp: the head, after a pass of the body
    have c1: tr.hd(m1) = h || bp(m1) -> G proof
      assume hp
      obtain p2 w2, rd hy from mp(ar2, hp)
      obtain y2, q2 r2 from hy.2
      have r1 := mp(all_elim(expand(rd, tr.red), {ok(w2, pair(18446744073709551616, y2))}), r2)
      have bs := apply(tr.lone_mk[b := l o. b(l, o), k := x8 x1. k(x8, x1)], {w}, {y}, {w2}, {y2}, r1)
      have e2: ex m2 y3 w3. o = ok(m2, empty) && q(m2, y3, w3) && b(pair(w, y), ok(pair(w3, y3), empty)) by ex_intro({m1}, {y2}, {w2}, taut(oe, q2, bs))
      show by taut(e2)
    qed
    // else the return
    have c2: !(tr.hd(m1) = h || bp(m1)) -> G proof
      assume np
      have at: tr.at_ret(s, m1) by taut(expand(st, tr.stopk), np)
      have rt := mp(ar1, at)
      have nb: !bp(m1) by taut(np)
      have e2: ex m2. o = ok(m2, empty) && tr.at_ret(s, m2) && !bp(m2) && tr.retok(s, v, P, w, m2) by ex_intro({m1}, taut(oe, at, nb, rt))
      have l: tr.lg(s, z. bp(z), v, P, w, o) by defs(taut(e2), tr.lg)
      show by taut(l)
    qed
    show by taut(c1, c2)
  qed
  show by taut(c, u, a)
qed

// (an iteration's outcome at y, w -- reached from y0, w0 by finitely many
// passes of the body: the loop's from y0, w0)
theorem tr.loop_e(s, v, z. bp, l o. b, l. tr, x8 x1. k): all y w y0 w0 o.
  (all o2. runs(tr.lpf(y, l o. b(l, o), x8 x1. k(x8, x1)), w, o2) -> runs(tr.lpf(y0, l o. b(l, o), x8 x1. k(x8, x1)), w0, o2)) ->
  tr.lg(s, z. bp(z), v, tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1)), w, o) -> tr.lg(s, z. bp(z), v, tr.lprog(y0, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1)), w0, o)
proof
  fix y w y0 w0 o
  assume hr hl
  let P1 := tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1))
  let P0 := tr.lprog(y0, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1))
  // an unmarked outcome: a finite run from y, so from y0
  have t: all o2. runs(P1, w, o2) -> !tr.mk(o2) -> runs(P0, w0, o2) proof
    fix o2
    assume r1 nm
    have f1 := apply(tr.lone_f[b := l o. b(l, o), k := x8 x1. k(x8, x1)], {w}, {y}, {o2}, r1, nm)
    have f0 := mp(all_elim(hr, {o2}), f1)
    show := apply(tr.lpf_lp[b := l o. b(l, o), tr := l. tr(l), k := x8 x1. k(x8, x1)], {w0}, {y0}, {o2}, f0)
  qed
  have tx: all x e. runs(P1, w, exc(x, e)) -> runs(P0, w0, exc(x, e)) proof
    fix x e
    assume r1
    have nm0: tr.mk(exc(x, e)) -> false proof
      assume m
      obtain a b0, me from expand(m, tr.mk)
      show by simp(me)
    qed
    show := mp(all_elim(t, {exc(x, e)}), r1, taut(nm0))
  qed
  have td: all t1. runs(P1, w, diverge(t1)) -> runs(P0, w0, diverge(t1)) proof
    fix t1
    assume r1
    have nm0: tr.mk(diverge(t1)) -> false proof
      assume m
      obtain a b0, me from expand(m, tr.mk)
      show by simp(me)
    qed
    show := mp(all_elim(t, {diverge(t1)}), r1, taut(nm0))
  qed
  have tk: all w3 r0 r1. r0 in bits(64) -> runs(P1, w, ok(w3, pair(r0, r1))) -> runs(P0, w0, ok(w3, pair(r0, r1))) proof
    fix w3 r0 r1
    assume rb r2
    have nm0: tr.mk(ok(w3, pair(r0, r1))) -> false proof
      assume m
      obtain a b0, me from expand(m, tr.mk)
      have e: r0 = 18446744073709551616 by simp(me)
      show by arith(e, rb)
    qed
    show := mp(all_elim(t, {ok(w3, pair(r0, r1))}), r2, taut(nm0))
  qed
  show := apply(tr.lg_mono[bp := z. bp(z)], {s}, {v}, {P0}, {w0}, {P1}, {w}, {o}, tx, td, tk, hl)
qed

// (a state at the head: not the return)
theorem tr.hd_nret(s, h, x y w. q): (all x y w. q(x, y, w) -> tr.hd(x) = h && !tr.at_ret(s, x)) ->
  all x y w m. q(x, y, w) -> tr.hd(m) = h -> !tr.at_ret(s, m)
proof
  assume hq
  fix x y w m
  assume q0 hm
  have c := mp(all_elim(hq, {x}, {y}, {w}), q0)
  have e: app(m, "rip") = app(x, "rip") && app(app(m, "gpr"), 4) = app(app(x, "gpr"), 4) by simp(expand(hm, tr.hd), expand(c.1, tr.hd))
  have n: tr.at_ret(s, m) -> false proof
    assume a
    have a2: tr.at_ret(s, x) := rewrite(e.2, rewrite(e.1, a))
    show by taut(a2, c.2)
  qed
  show by taut(n)
qed

// The loop's finite runs: each as the spec's from the loop
theorem tr.loop_fin(s, v, h, z. bp, l o. b, l. tr, x8 x1. k, x y w. q):
  (all x y w. q(x, y, w) -> tr.hd(x) = h && !bp(x) && !tr.at_ret(s, x) && w in univ(1) && pair(w, y) in univ(1)) ->
  (all x y w. q(x, y, w) -> tr.simk(s, z. tr.hd(z) = h || bp(z), z p2 w2. tr.hd(z) = h && (ex y2. q(z, y2, w2) && runs(p2, w2, ok(w2, pair(18446744073709551616, y2)))),
    v, tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1)), w, x)) ->
  all x0 y0 w0 r o. q(x0, y0, w0) -> tr.rk(s, z. bp(z), x0, r) -> tr.rmap(r, o) -> !(fst(r) = 2) ->
    tr.lg(s, z. bp(z), v, tr.lprog(y0, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1)), w0, o)
proof
  assume hq hb
  fix x0 y0 w0 r o
  assume hq0 hrk hrm hnd
  have tt: true by taut()
  let LG := tr.lg(s, z. bp(z), v, tr.lprog(y0, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1)), w0, o)
  let PF(y) := tr.lpf(y, l o. b(l, o), x8 x1. k(x8, x1))
  let RCH(y, w) := all o2. runs(PF(y), w, o2) -> runs(PF(y0), w0, o2)
  let MR(x, l) := all r1. !(fst(r1) = 2) -> tr.rwk(s, z. tr.hd(z) = h || bp(z), l, r1) -> tr.rk(s, z. tr.hd(z) = h || bp(z), x, r1)
  let TR(x5) := fn_update(empty, "os.events", app(app(fst(x5), "os"), "events"))
  have hd := mp(tr.loop_d[s := s, v := v, h := h, bp := z. bp(z), b := l o. b(l, o), k := x8 x1. k(x8, x1), q := x y w. q(x, y, w)], hb)
  have hq2: all x y w. q(x, y, w) -> tr.hd(x) = h && !tr.at_ret(s, x) proof
    fix x y w
    assume q1
    have c := mp(all_elim(hq, {x}, {y}, {w}), q1)
    show by taut(c)
  qed
  have hnr := mp(tr.hd_nret[s := s, h := h, q := x y w. q(x, y, w)], hq2)
  have hrun: tr.run_k(s, z. bp(z), x0, o) by defs(ex_intro({r}, taut(hrk, hrm)), tr.run_k)
  // (the run's return: at a stop of bp -- no head)
  have fo: all m1 y w. o = ok(m1, empty) -> q(m1, y, w) -> false proof
    fix m1 y w
    assume oe q1
    have st := apply(tr.run_k_stop[bp := z. bp(z)], {s}, {x0}, {m1}, {empty}, rewrite(oe, hrun))
    have c := mp(all_elim(hq, {m1}, {y}, {w}), q1)
    show by taut(expand(st, tr.stopk), c)
  qed
  // an iteration from x ending the loop's run: the run as the spec's
  have h1: all x y w. q(x, y, w) -> RCH(y, w) -> tr.run_k(s, z. tr.hd(z) = h || bp(z), x, o) -> LG proof
    fix x y w
    assume q1 rc hr
    have d := mp(all_elim(hd, {x}, {y}, {w}, {o}), q1, hr)
    have c1: tr.lg(s, z. bp(z), v, tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1)), w, o) -> LG proof
      assume l1
      show := apply(tr.loop_e[s := s, v := v, bp := z. bp(z), b := l o. b(l, o), tr := l. tr(l), k := x8 x1. k(x8, x1)], {y}, {w}, {y0}, {w0}, {o}, rc, l1)
    qed
    have c2: (ex m1 y2 w2. o = ok(m1, empty) && q(m1, y2, w2) && b(pair(w, y), ok(pair(w2, y2), empty))) -> LG proof
      assume e
      obtain m1 y2 w2, oe q2 _ from e
      have f := mp(all_elim(fo, {m1}, {y2}, {w2}), oe, q2)
      show by taut(f)
    qed
    show by taut(d, c1, c2)
  qed
  // an iteration from x back at the head, at l: the loop's run as the
  // spec's, or the head's coupling, reached from y0
  have h2: all x y w l. q(x, y, w) -> RCH(y, w) -> tr.run_k(s, z. tr.hd(z) = h || bp(z), x, ok(fst(l), empty)) -> tr.hd(fst(l)) = h ->
      LG || (ex y2 w2. q(fst(l), y2, w2) && RCH(y2, w2)) proof
    fix x y w l
    assume q1 rc hr hh
    have hw: w in univ(1) by taut(mp(all_elim(hq, {x}, {y}, {w}), q1))
    have d := mp(all_elim(hd, {x}, {y}, {w}, {ok(fst(l), empty)}), q1, hr)
    let P1 := tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1))
    have c1: tr.lg(s, z. bp(z), v, P1, w, ok(fst(l), empty)) -> LG proof
      assume l1
      have u: tr.ub(s, v, P1, w) -> LG proof
        assume hu
        have l2: tr.lg(s, z. bp(z), v, P1, w, o) by defs(taut(hu), tr.lg)
        show := apply(tr.loop_e[s := s, v := v, bp := z. bp(z), b := l o. b(l, o), tr := l. tr(l), k := x8 x1. k(x8, x1)], {y}, {w}, {y0}, {w0}, {o}, rc, l2)
      qed
      have cr: tr.crash(s, P1, w, ok(fst(l), empty)) -> false proof
        assume c
        obtain m1 a k0, {oe} from expand(c, tr.crash)
        show by simp(oe)
      qed
      have dv: tr.div(P1, w, ok(fst(l), empty)) -> false proof
        assume c
        obtain t, te from expand(c, tr.div).1
        show by simp(te)
      qed
      have rt: (ex m1. ok(fst(l), empty) = ok(m1, empty) && tr.at_ret(s, m1) && !bp(m1) && tr.retok(s, v, P1, w, m1)) -> false proof
        assume e
        obtain m1, oe at _ _ from e
        have me: m1 = fst(l) by simp(oe)
        have at2: tr.at_ret(s, fst(l)) := rewrite(me, at)
        have na := mp(all_elim(hnr, {x}, {y}, {w}, {fst(l)}), q1, hh)
        show by taut(at2, na)
      qed
      show by taut(expand(l1, tr.lg), u, cr, dv, rt)
    qed
    have c2: (ex m1 y2 w2. ok(fst(l), empty) = ok(m1, empty) && q(m1, y2, w2) && b(pair(w, y), ok(pair(w2, y2), empty))) ->
        (ex y2 w2. q(fst(l), y2, w2) && RCH(y2, w2)) proof
      assume e
      obtain m1 y2 w2, oe q2 bs from e
      have me: m1 = fst(l) by simp(oe)
      have q3: q(fst(l), y2, w2) := rewrite(me, q2)
      have rc2: RCH(y2, w2) proof
        fix o2
        assume r2
        have r1 := apply(tr.lpf_step[b := l o. b(l, o), k := x8 x1. k(x8, x1)], {w}, {y}, {w2}, {y2}, {o2}, hw, bs, r2)
        show := mp(all_elim(rc, {o2}), r1)
      qed
      show by ex_intro({y2}, {w2}, taut(q3, rc2))
    qed
    show by taut(d, c1, c2)
  qed
  // arriving at the head at l (a break of the iteration's run): the loop
  // from there
  have ha: all l x y w. l = pair(fst(l), empty) -> q(x, y, w) -> RCH(y, w) -> MR(x, l) -> tr.hd(fst(l)) = h ->
      (all y2 w2. q(fst(l), y2, w2) -> RCH(y2, w2) -> LG) -> LG proof
    fix l x y w
    assume ql q1 rc mr hh hh2
    have st: tr.stopk(s, z. tr.hd(z) = h || bp(z), fst(l)) by defs(taut(hh), tr.stopk)
    have rb: tr.rbk(s, z. tr.hd(z) = h || bp(z), l, exc(pair(fst(l), empty), pair("brk", empty))) by defs(taut(st, refl({exc(pair(fst(l), empty), pair("brk", empty))})), tr.rbk)
    have nok: !is_ok(exc(pair(fst(l), empty), pair("brk", empty))) by defs(simp(), is_ok)
    have w1 := mp(while_leave[l0 := l, c := x5. true, b := x5 x6. tr.rbk(s, z. tr.hd(z) = h || bp(z), x5, x6), tr := x5. TR(x5), r := exc(pair(fst(l), empty), pair("brk", empty))], tt, rb, nok)
    have w2: tr.rwk(s, z. tr.hd(z) = h || bp(z), l, exc(pair(fst(l), empty), pair("brk", empty))) by defs(w1, tr.rwk)
    have nd: !(fst(exc(pair(fst(l), empty), pair("brk", empty))) = 2) by simp()
    have rk := mp(all_elim(mr, {exc(pair(fst(l), empty), pair("brk", empty))}), nd, w2)
    have rm: tr.rmap(exc(pair(fst(l), empty), pair("brk", empty)), ok(fst(l), empty)) by defs(simp(), tr.rmap)
    have hr: tr.run_k(s, z. tr.hd(z) = h || bp(z), x, ok(fst(l), empty)) by defs(ex_intro({exc(pair(fst(l), empty), pair("brk", empty))}, taut(rk, rm)), tr.run_k)
    have c := mp(all_elim(h2, {x}, {y}, {w}, {l}), q1, rc, hr, hh)
    have c2: (ex y2 w2. q(fst(l), y2, w2) && RCH(y2, w2)) -> LG proof
      assume e
      obtain y2 w2, q2 rc2 from e
      show := mp(all_elim(hh2, {y2}, {w2}), q2, rc2)
    qed
    show by taut(c, c2)
  qed
  let Z(l) := l = pair(fst(l), empty) -> (all x y w. q(x, y, w) -> RCH(y, w) -> MR(x, l) -> LG) && (all y w. q(fst(l), y, w) -> RCH(y, w) -> LG)
  // where the run ends
  have zb: all l. ((!true && r = ok(l, empty)) || (true && tr.rbk(s, z. bp(z), l, r) && !is_ok(r))) -> Z(l) proof
    fix l
    assume hl ql
    have hb1: tr.rbk(s, z. bp(z), l, r) && !is_ok(r) by taut(hl)
    have p2: all y w. q(fst(l), y, w) -> RCH(y, w) -> LG proof
      fix y w
      assume q1 rc
      have c := mp(all_elim(hq, {fst(l)}, {y}, {w}), q1)
      have nst: !tr.stopk(s, z. bp(z), fst(l)) by defs(taut(c), tr.stopk)
      have rd: tr.rbd(s, l, r) by taut(expand(hb1.1, tr.rbk), nst)
      have rd2: tr.rbd(s, pair(fst(l), empty), r) := rewrite(ql, rd)
      have rk: tr.rk(s, z. tr.hd(z) = h || bp(z), fst(l), r) by defs(taut(rd2, hb1.2), tr.rk)
      have hr: tr.run_k(s, z. tr.hd(z) = h || bp(z), fst(l), o) by defs(ex_intro({r}, taut(rk, hrm)), tr.run_k)
      show := mp(all_elim(h1, {fst(l)}, {y}, {w}), q1, rc, hr)
    qed
    have p1: all x y w. q(x, y, w) -> RCH(y, w) -> MR(x, l) -> LG proof
      fix x y w
      assume q1 rc mr
      have a1: tr.hd(fst(l)) = h -> LG proof
        assume hh
        show := mp(all_elim(ha, {l}, {x}, {y}, {w}), ql, q1, rc, mr, hh, p2)
      qed
      have a2: !(tr.hd(fst(l)) = h) -> LG proof
        assume nh
        have rb2: tr.rbk(s, z. tr.hd(z) = h || bp(z), l, r) by defs(taut(expand(hb1.1, tr.rbk, tr.stopk), nh), tr.rbk, tr.stopk)
        have w1 := mp(while_leave[l0 := l, c := x5. true, b := x5 x6. tr.rbk(s, z. tr.hd(z) = h || bp(z), x5, x6), tr := x5. TR(x5), r := r], tt, rb2, hb1.2)
        have w2: tr.rwk(s, z. tr.hd(z) = h || bp(z), l, r) by defs(w1, tr.rwk)
        have rk := mp(all_elim(mr, {r}), hnd, w2)
        have hr: tr.run_k(s, z. tr.hd(z) = h || bp(z), x, o) by defs(ex_intro({r}, taut(rk, hrm)), tr.run_k)
        show := mp(all_elim(h1, {x}, {y}, {w}), q1, rc, hr)
      qed
      show by taut(a1, a2)
    qed
    show by taut(p1, p2)
  qed
  // a step of the run
  have zs: all l l1. true -> tr.rbk(s, z. bp(z), l, ok(l1, empty)) -> Z(l1) -> Z(l) proof
    fix l l1
    assume _ hb1 z1 ql
    have nst rd q1 := apply(tr.rbk_ok[bp := z. bp(z)], {s}, {l}, {l1}, {empty}, hb1)
    have z2 := mp(z1, q1)
    have rd2: tr.rbd(s, pair(fst(l), empty), ok(l1, empty)) := rewrite(ql, rd)
    have p2: all y w. q(fst(l), y, w) -> RCH(y, w) -> LG proof
      fix y w
      assume q2 rc
      have mr: MR(fst(l), l1) proof
        fix r1
        assume nd rw
        have e: ex l2. tr.rbd(s, pair(fst(l), empty), ok(l2, empty)) && tr.rwk(s, z. tr.hd(z) = h || bp(z), l2, r1) by ex_intro({l1}, taut(rd2, rw))
        show by defs(taut(e), tr.rk)
      qed
      show := mp(all_elim(z2.1, {fst(l)}, {y}, {w}), q2, rc, mr)
    qed
    have p1: all x y w. q(x, y, w) -> RCH(y, w) -> MR(x, l) -> LG proof
      fix x y w
      assume q2 rc mr
      have a1: tr.hd(fst(l)) = h -> LG proof
        assume hh
        show := mp(all_elim(ha, {l}, {x}, {y}, {w}), ql, q2, rc, mr, hh, p2)
      qed
      have a2: !(tr.hd(fst(l)) = h) -> LG proof
        assume nh
        have rb2: tr.rbk(s, z. tr.hd(z) = h || bp(z), l, ok(l1, empty)) by defs(taut(expand(nst, tr.stopk), nh, rd), tr.rbk, tr.stopk)
        have mr1: MR(x, l1) proof
          fix r1
          assume nd rw
          have w1 := mp(while_step[l0 := l, l1 := l1, c := x5. true, b := x5 x6. tr.rbk(s, z. tr.hd(z) = h || bp(z), x5, x6), tr := x5. TR(x5), r := r1], tt, rb2, expand(rw, tr.rwk), nd)
          have w2: tr.rwk(s, z. tr.hd(z) = h || bp(z), l, r1) by defs(w1, tr.rwk)
          show := mp(all_elim(mr, {r1}), nd, w2)
        qed
        show := mp(all_elim(z2.1, {x}, {y}, {w}), q2, rc, mr1)
      qed
      show by taut(a1, a2)
    qed
    show by taut(p1, p2)
  qed
  have rc0: RCH(y0, w0) proof
    fix o2
    assume r2
    show := r2
  qed
  // the first pass: on to l1, then the loop of passes; or it leaves
  have i1: (ex l1. tr.rbd(s, pair(x0, empty), ok(l1, empty)) && tr.rwk(s, z. bp(z), l1, r)) -> LG proof
    assume e
    obtain l1, rb0 rw from e
    have q1: l1 = pair(fst(l1), empty) by simp(expand(rb0, tr.rbd, tr.rb), keep(x86_64_linux.step))
    have zl := mp(while_run_ind[l0 := l1, c := x5. true, b := x5 x6. tr.rbk(s, z. bp(z), x5, x6), tr := x5. TR(x5), r := r, z := l. Z(l)], zb, zs, expand(rw, tr.rwk), hnd)
    have mr: MR(x0, l1) proof
      fix r1
      assume nd rw1
      have e2: ex l2. tr.rbd(s, pair(x0, empty), ok(l2, empty)) && tr.rwk(s, z. tr.hd(z) = h || bp(z), l2, r1) by ex_intro({l1}, taut(rb0, rw1))
      show by defs(taut(e2), tr.rk)
    qed
    show := mp(all_elim(mp(zl, q1).1, {x0}, {y0}, {w0}), hq0, rc0, mr)
  qed
  have i2: tr.rbd(s, pair(x0, empty), r) && !is_ok(r) -> LG proof
    assume e
    have rk: tr.rk(s, z. tr.hd(z) = h || bp(z), x0, r) by defs(taut(e), tr.rk)
    have hr: tr.run_k(s, z. tr.hd(z) = h || bp(z), x0, o) by defs(ex_intro({r}, taut(rk, hrm)), tr.run_k)
    show := mp(all_elim(h1, {x0}, {y0}, {w0}), hq0, rc0, hr)
  qed
  show by taut(expand(hrk, tr.rk), i1, i2)
qed

// (a pair's first part: of the universe of the pair)
theorem tr.fst_univ: all z. z in univ(1) -> fst(z) in univ(1)
proof
  fix z
  assume hz
  have c1: (ex a b. z = pair(a, b)) -> fst(z) in univ(1) proof
    assume e
    obtain a b, ze from e
    have m1: single(a) in pair(a, b) by defs(upair_l[a := single(a), b := upair(a, b)], pair)
    have m2 := rewrite(sym(ze), m1)
    have su := mp(univ_trans[u := 1, a := single(a), b := z], hz, m2)
    have au := mp(univ_trans[u := 1, a := a, b := single(a)], su, single_intro[a := a])
    have fe: fst(z) = a by simp(ze)
    show := rewrite(sym(fe), au)
  qed
  have c2: !(ex a b. z = pair(a, b)) -> fst(z) in univ(1) proof
    assume ne
    have fe: fst(z) = empty by defs(mp(ite_f[c := ex a b. z = pair(a, b), a := choose(a. ex b. z = pair(a, b)), b := empty], ne), fst)
    show := rewrite(sym(fe), univ_empty[u := 1])
  qed
  show by taut(c1, c2)
qed

// (the limit of a chain of records of the universe: of the universe)
theorem tr.tl_univ(i. t): (all i. i in omega -> t(i) in univ(1)) -> trace_limit(i. t(i)) in univ(1)
proof
  assume h
  have t0 := mp(all_elim(h, {empty}), omega_zero)
  have fu: all z. z in t(empty) -> fst(z) in univ(1) proof
    fix z
    assume hz
    have zu := mp(univ_trans[u := 1, a := z, b := t(empty)], t0, hz)
    show := apply(tr.fst_univ, {z}, zu)
  qed
  have du: dom(t(empty)) in univ(1) by defs(mp(univ_image[u := 1, s := t(empty), f := z. fst(z)], t0, fu), dom)
  have vu: all f. f in dom(t(empty)) -> pair(f, union(set_image(omega, i. app(t(i), f)))) in univ(1) proof
    fix f
    assume hf
    have fu2 := mp(univ_trans[u := 1, a := f, b := dom(t(empty))], du, hf)
    have au: all i. i in omega -> app(t(i), f) in univ(1) proof
      fix i
      assume hi
      show := mp(app_univ[u := 1, f := t(i), k := f], mp(all_elim(h, {i}), hi))
    qed
    have iu := mp(univ_image[u := 1, s := omega, f := i. app(t(i), f)], omega_univ, au)
    have uu := mp(univ_union[u := 1, s := set_image(omega, i. app(t(i), f))], iu)
    show by simp(fu2, uu)
  qed
  have r := mp(univ_image[u := 1, s := dom(t(empty)), f := f. pair(f, union(set_image(omega, i. app(t(i), f))))], du, vu)
  show by defs(r, trace_limit, fn_build)
qed

// The loop's infinite runs: as the spec's from the loop (an iteration's
// own divergence or undefined behaviour, or infinitely many of them: the
// spec's loop then runs forever too)
theorem tr.loop_div(s, v, h, z. bp, l o. b, l. tr, x8 x1. k, x y w. q):
  (all x y w. q(x, y, w) -> tr.hd(x) = h && !bp(x) && !tr.at_ret(s, x) && w in univ(1) && pair(w, y) in univ(1)) ->
  (all x y w. q(x, y, w) -> tr.simk(s, z. tr.hd(z) = h || bp(z), z p2 w2. tr.hd(z) = h && (ex y2. q(z, y2, w2) && runs(p2, w2, ok(w2, pair(18446744073709551616, y2)))),
    v, tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1)), w, x)) ->
  (all t. k(diverge(t), diverge(t))) -> (all l. l in univ(1) -> tr(l) in univ(1)) ->
  all x0 y0 w0 r o. q(x0, y0, w0) -> tr.rk(s, z. bp(z), x0, r) -> tr.rmap(r, o) -> fst(r) = 2 ->
    tr.lg(s, z. bp(z), v, tr.lprog(y0, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1)), w0, o)
proof
  assume hq hb hk2 htr
  fix x0 y0 w0 r o
  assume hq0 hrk hrm hd0
  have tt: true by taut()
  let LG := tr.lg(s, z. bp(z), v, tr.lprog(y0, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1)), w0, o)
  let PF(y) := tr.lpf(y, l o. b(l, o), x8 x1. k(x8, x1))
  let RCH(y, w) := all o2. runs(PF(y), w, o2) -> runs(PF(y0), w0, o2)
  let TR(x5) := fn_update(empty, "os.events", app(app(fst(x5), "os"), "events"))
  let BRK(l) := exc(pair(fst(l), empty), pair("brk", empty))
  have hd := mp(tr.loop_d[s := s, v := v, h := h, bp := z. bp(z), b := l o. b(l, o), k := x8 x1. k(x8, x1), q := x y w. q(x, y, w)], hb)
  have rm2 := rewrite(hd0, expand(hrm, tr.rmap))
  have od: o = diverge(snd(r)) by simp(rm2)
  have em: LG || !LG by taut()
  have ng: !LG -> LG proof
    assume nlg
    // an iteration's undefined behaviour or divergence: the loop's
    have h3: all x y w t. q(x, y, w) -> RCH(y, w) -> tr.run_k(s, z. tr.hd(z) = h || bp(z), x, diverge(t)) -> false proof
      fix x y w t
      assume q1 rc hr
      let P1 := tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1))
      have d := mp(all_elim(hd, {x}, {y}, {w}, {diverge(t)}), q1, hr)
      have c1: tr.lg(s, z. bp(z), v, P1, w, diverge(t)) -> false proof
        assume l1
        have u: tr.ub(s, v, P1, w) || tr.div(P1, w, diverge(t)) -> false proof
          assume e
          have dv: tr.div(P1, w, diverge(t)) -> tr.div(P1, w, o) proof
            assume dd
            have e2: ex t3. o = diverge(t3) by ex_intro({snd(r)}, od)
            show by defs(taut(expand(dd, tr.div), e2), tr.div)
          qed
          have l2: tr.lg(s, z. bp(z), v, P1, w, o) by defs(taut(e, dv), tr.lg)
          have lg := apply(tr.loop_e[s := s, v := v, bp := z. bp(z), b := l o. b(l, o), tr := l. tr(l), k := x8 x1. k(x8, x1)], {y}, {w}, {y0}, {w0}, {o}, rc, l2)
          show by taut(lg, nlg)
        qed
        have cr: tr.crash(s, P1, w, diverge(t)) -> false proof
          assume c
          obtain m1 a k0, {oe} from expand(c, tr.crash)
          show by simp(oe)
        qed
        have rt: (ex m1. diverge(t) = ok(m1, empty) && tr.at_ret(s, m1) && !bp(m1) && tr.retok(s, v, P1, w, m1)) -> false proof
          assume e
          obtain m1, oe _ _ _ from e
          show by simp(oe)
        qed
        show by taut(expand(l1, tr.lg), u, cr, rt)
      qed
      have c2: (ex m1 y2 w2. diverge(t) = ok(m1, empty) && q(m1, y2, w2) && b(pair(w, y), ok(pair(w2, y2), empty))) -> false proof
        assume e
        obtain m1 y2 w2, oe _ _ from e
        show by simp(oe)
      qed
      show by taut(d, c1, c2)
    qed
    let DV(x) := ex r1. tr.rk(s, z. bp(z), x, r1) && fst(r1) = 2
    let S(l) := ex x w y. l = pair(w, y) && q(x, y, w) && RCH(y, w) && DV(x)
    // from a head whose run diverges: an iteration, to such a head
    have nx: all x y w. q(x, y, w) -> RCH(y, w) -> DV(x) -> (ex x2 y2 w2. q(x2, y2, w2) && b(pair(w, y), ok(pair(w2, y2), empty)) && DV(x2)) proof
      fix x y w
      assume q1 rc dv
      obtain r1, rk1 f1 from dv
      have rmd: tr.rmap(r1, diverge(snd(r1))) by defs(simp(f1), tr.rmap)
      // the first pass diverges
      have k2: tr.rbd(s, pair(x, empty), r1) && !is_ok(r1) -> (ex x2 y2 w2. q(x2, y2, w2) && b(pair(w, y), ok(pair(w2, y2), empty)) && DV(x2)) proof
        assume e
        have rk: tr.rk(s, z. tr.hd(z) = h || bp(z), x, r1) by defs(taut(e), tr.rk)
        have hr: tr.run_k(s, z. tr.hd(z) = h || bp(z), x, diverge(snd(r1))) by defs(ex_intro({r1}, taut(rk, rmd)), tr.run_k)
        have f := mp(all_elim(h3, {x}, {y}, {w}, {snd(r1)}), q1, rc, hr)
        show by taut(f)
      qed
      // the loop of passes: cut where it first reaches the head
      have k1: (ex l1. tr.rbd(s, pair(x, empty), ok(l1, empty)) && tr.rwk(s, z. bp(z), l1, r1)) -> (ex x2 y2 w2. q(x2, y2, w2) && b(pair(w, y), ok(pair(w2, y2), empty)) && DV(x2)) proof
        assume e
        obtain l1, rb0 rw from e
        have q1s: l1 = pair(fst(l1), empty) by simp(expand(rb0, tr.rbd, tr.rb), keep(x86_64_linux.step))
        have he: all l. !is_ok(BRK(l)) proof
          fix l
          show by defs(simp(), is_ok)
        qed
        have hqs: all l l2. l = pair(fst(l), empty) -> tr.rbk(s, z. bp(z), l, ok(l2, empty)) -> l2 = pair(fst(l2), empty) proof
          fix l l2
          assume _ hb1
          have c := apply(tr.rbk_ok[bp := z. bp(z)], {s}, {l}, {l2}, {empty}, hb1)
          show by taut(c)
        qed
        have sp := mp(while_split[l0 := l1, b := x5 x6. tr.rbk(s, z. bp(z), x5, x6), tr := x5. TR(x5), p := l. !(tr.hd(fst(l)) = h), e := l. BRK(l), r := r1, q := l. l = pair(fst(l), empty)],
          he, q1s, hqs, expand(rw, tr.rwk))
        // the guarded passes: those of the iteration
        have gb: all l o2. (!(tr.hd(fst(l)) = h) && tr.rbk(s, z. bp(z), l, o2)) || (!!(tr.hd(fst(l)) = h) && o2 = BRK(l)) -> tr.rbk(s, z. tr.hd(z) = h || bp(z), l, o2) proof
          fix l o2
          assume g
          have g1: !(tr.hd(fst(l)) = h) && tr.rbk(s, z. bp(z), l, o2) -> tr.rbk(s, z. tr.hd(z) = h || bp(z), l, o2) proof
            assume g2
            show by defs(taut(expand(g2.2, tr.rbk, tr.stopk), g2.1), tr.rbk, tr.stopk)
          qed
          have g3: !!(tr.hd(fst(l)) = h) && o2 = BRK(l) -> tr.rbk(s, z. tr.hd(z) = h || bp(z), l, o2) proof
            assume g2
            have st: tr.stopk(s, z. tr.hd(z) = h || bp(z), fst(l)) by defs(taut(g2.1), tr.stopk)
            show by defs(taut(st, g2.2), tr.rbk)
          qed
          show by taut(g, g1, g3)
        qed
        // never at the head: the iteration diverges
        have ca: while_rel(l1, l. true, l o2. (!(tr.hd(fst(l)) = h) && tr.rbk(s, z. bp(z), l, o2)) || (!!(tr.hd(fst(l)) = h) && o2 = BRK(l)), l. TR(l), r1) ->
            (ex x2 y2 w2. q(x2, y2, w2) && b(pair(w, y), ok(pair(w2, y2), empty)) && DV(x2)) proof
          assume wg
          have w2 := mp(while_mono[l0 := l1, c := l. true, b1 := l o2. (!(tr.hd(fst(l)) = h) && tr.rbk(s, z. bp(z), l, o2)) || (!!(tr.hd(fst(l)) = h) && o2 = BRK(l)),
            b2 := l o2. tr.rbk(s, z. tr.hd(z) = h || bp(z), l, o2), tr := l. TR(l), r := r1], gb, wg)
          have rw2: tr.rwk(s, z. tr.hd(z) = h || bp(z), l1, r1) by defs(w2, tr.rwk)
          have e2: ex l2. tr.rbd(s, pair(x, empty), ok(l2, empty)) && tr.rwk(s, z. tr.hd(z) = h || bp(z), l2, r1) by ex_intro({l1}, taut(rb0, rw2))
          have rk: tr.rk(s, z. tr.hd(z) = h || bp(z), x, r1) by defs(taut(e2), tr.rk)
          have hr: tr.run_k(s, z. tr.hd(z) = h || bp(z), x, diverge(snd(r1))) by defs(ex_intro({r1}, taut(rk, rmd)), tr.run_k)
          have f := mp(all_elim(h3, {x}, {y}, {w}, {snd(r1)}), q1, rc, hr)
          show by taut(f)
        qed
        // at the head at l: the iteration's end; the run goes on from l
        have cb: (ex l. l = pair(fst(l), empty) && while_rel(l1, l. true, l o2. (!(tr.hd(fst(l)) = h) && tr.rbk(s, z. bp(z), l, o2)) || (!!(tr.hd(fst(l)) = h) && o2 = BRK(l)), l. TR(l), BRK(l)) &&
            (ex r2. while_rel(l, l. true, l o2. tr.rbk(s, z. bp(z), l, o2), l. TR(l), r2) && fst(r2) = fst(r1) && (!(fst(r1) = 2) -> r2 = r1))) ->
            (ex x2 y2 w2. q(x2, y2, w2) && b(pair(w, y), ok(pair(w2, y2), empty)) && DV(x2)) proof
          assume e2
          obtain l, ql wg er from e2
          obtain r2, wr2 f2 _ from er
          have f22: fst(r2) = 2 by simp(f1, f2)
          have w2 := mp(while_mono[l0 := l1, c := l. true, b1 := l o2. (!(tr.hd(fst(l)) = h) && tr.rbk(s, z. bp(z), l, o2)) || (!!(tr.hd(fst(l)) = h) && o2 = BRK(l)),
            b2 := l o2. tr.rbk(s, z. tr.hd(z) = h || bp(z), l, o2), tr := l. TR(l), r := BRK(l)], gb, wg)
          have rw2: tr.rwk(s, z. tr.hd(z) = h || bp(z), l1, BRK(l)) by defs(w2, tr.rwk)
          have e3: ex l2. tr.rbd(s, pair(x, empty), ok(l2, empty)) && tr.rwk(s, z. tr.hd(z) = h || bp(z), l2, BRK(l)) by ex_intro({l1}, taut(rb0, rw2))
          have rk: tr.rk(s, z. tr.hd(z) = h || bp(z), x, BRK(l)) by defs(taut(e3), tr.rk)
          have rmb: tr.rmap(BRK(l), ok(fst(l), empty)) by defs(simp(), tr.rmap)
          have hr: tr.run_k(s, z. tr.hd(z) = h || bp(z), x, ok(fst(l), empty)) by defs(ex_intro({BRK(l)}, taut(rk, rmb)), tr.run_k)
          // the run from l: on, diverging (so l is no stop)
          have un := mp(while_unroll[l0 := l, c := l. true, b := l o2. tr.rbk(s, z. bp(z), l, o2), tr := l. TR(l), r := r2], wr2)
          have nst: !tr.stopk(s, z. bp(z), fst(l)) proof
            have n: tr.stopk(s, z. bp(z), fst(l)) -> false proof
              assume st
              have u1: tr.rbk(s, z. bp(z), l, r2) && !is_ok(r2) -> false proof
                assume e4
                have r2e: r2 = BRK(l) by taut(expand(e4.1, tr.rbk), st)
                have f3: fst(r2) = 1 by simp(r2e)
                show by simp(f3, f22)
              qed
              have u2: (ex l3. tr.rbk(s, z. bp(z), l, ok(l3, empty)) && (ex r3. while_rel(l3, l. true, l o2. tr.rbk(s, z. bp(z), l, o2), l. TR(l), r3) &&
                  fst(r3) = fst(r2) && (!(fst(r2) = 2) -> r3 = r2))) -> false proof
                assume e4
                obtain l3, hb3 _ from e4
                have c := apply(tr.rbk_ok[bp := z. bp(z)], {s}, {l}, {l3}, {empty}, hb3)
                show by taut(c, st)
              qed
              show by taut(un, u1, u2)
            qed
            show by taut(n)
          qed
          have dvl: DV(fst(l)) proof
            have v1: tr.rbk(s, z. bp(z), l, r2) && !is_ok(r2) -> DV(fst(l)) proof
              assume e4
              have rd: tr.rbd(s, l, r2) by taut(expand(e4.1, tr.rbk), nst)
              have rd2: tr.rbd(s, pair(fst(l), empty), r2) := rewrite(ql, rd)
              have rk2: tr.rk(s, z. bp(z), fst(l), r2) by defs(taut(rd2, e4.2), tr.rk)
              show by ex_intro({r2}, taut(rk2, f22))
            qed
            have v2: (ex l3. tr.rbk(s, z. bp(z), l, ok(l3, empty)) && (ex r3. while_rel(l3, l. true, l o2. tr.rbk(s, z. bp(z), l, o2), l. TR(l), r3) &&
                fst(r3) = fst(r2) && (!(fst(r2) = 2) -> r3 = r2))) -> DV(fst(l)) proof
              assume e4
              obtain l3, hb3 er3 from e4
              obtain r3, wr3 f3 _ from er3
              have c := apply(tr.rbk_ok[bp := z. bp(z)], {s}, {l}, {l3}, {empty}, hb3)
              have rd2: tr.rbd(s, pair(fst(l), empty), ok(l3, empty)) := rewrite(ql, c.2)
              have rw3: tr.rwk(s, z. bp(z), l3, r3) by defs(wr3, tr.rwk)
              have e5: ex l4. tr.rbd(s, pair(fst(l), empty), ok(l4, empty)) && tr.rwk(s, z. bp(z), l4, r3) by ex_intro({l3}, taut(rd2, rw3))
              have rk2: tr.rk(s, z. bp(z), fst(l), r3) by defs(taut(e5), tr.rk)
              have f33: fst(r3) = 2 by simp(f3, f22)
              show by ex_intro({r3}, taut(rk2, f33))
            qed
            have v0: (!true && r2 = ok(l, empty)) -> DV(fst(l)) proof
              assume e4
              show by taut(e4)
            qed
            show by taut(un, v0, v1, v2)
          qed
          // the iteration's end at the head: a pass of the body
          have d := mp(all_elim(hd, {x}, {y}, {w}, {ok(fst(l), empty)}), q1, hr)
          let P1 := tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1))
          have d1: tr.lg(s, z. bp(z), v, P1, w, ok(fst(l), empty)) -> false proof
            assume l2
            have u: tr.ub(s, v, P1, w) -> false proof
              assume hu
              have l3: tr.lg(s, z. bp(z), v, P1, w, o) by defs(taut(hu), tr.lg)
              have lg := apply(tr.loop_e[s := s, v := v, bp := z. bp(z), b := l o. b(l, o), tr := l. tr(l), k := x8 x1. k(x8, x1)], {y}, {w}, {y0}, {w0}, {o}, rc, l3)
              show by taut(lg, nlg)
            qed
            have cr: tr.crash(s, P1, w, ok(fst(l), empty)) -> false proof
              assume c
              obtain m1 a k0, {oe} from expand(c, tr.crash)
              show by simp(oe)
            qed
            have dv2: tr.div(P1, w, ok(fst(l), empty)) -> false proof
              assume c
              obtain t, te from expand(c, tr.div).1
              show by simp(te)
            qed
            have rt: (ex m1. ok(fst(l), empty) = ok(m1, empty) && tr.at_ret(s, m1) && !bp(m1) && tr.retok(s, v, P1, w, m1)) -> false proof
              assume e4
              obtain m1, oe at _ _ from e4
              have me: m1 = fst(l) by simp(oe)
              have at2: tr.at_ret(s, fst(l)) := rewrite(me, at)
              have st: tr.stopk(s, z. bp(z), fst(l)) by defs(taut(at2), tr.stopk)
              show by taut(st, nst)
            qed
            show by taut(expand(l2, tr.lg), u, cr, dv2, rt)
          qed
          have d2: (ex m1 y2 w2. ok(fst(l), empty) = ok(m1, empty) && q(m1, y2, w2) && b(pair(w, y), ok(pair(w2, y2), empty))) ->
              (ex x2 y2 w2. q(x2, y2, w2) && b(pair(w, y), ok(pair(w2, y2), empty)) && DV(x2)) proof
            assume e4
            obtain m1 y2 w2, oe q2 bs from e4
            have me: m1 = fst(l) by simp(oe)
            have q3: q(fst(l), y2, w2) := rewrite(me, q2)
            show by ex_intro({fst(l)}, {y2}, {w2}, taut(q3, bs, dvl))
          qed
          show by taut(d, d1, d2)
        qed
        show by taut(sp, ca, cb)
      qed
      show by taut(expand(rk1, tr.rk), k1, k2)
    qed
    have ss: all l. S(l) -> true && (ex l2. b(l, ok(l2, empty)) && S(l2)) proof
      fix l
      assume sl
      obtain x w y, le q1 rc dv from sl
      obtain x2 y2 w2, q2 bs dv2 from mp(all_elim(nx, {x}, {y}, {w}), q1, rc, dv)
      have hw: w in univ(1) by taut(mp(all_elim(hq, {x}, {y}, {w}), q1))
      have rc2: RCH(y2, w2) proof
        fix o2
        assume r2
        have r1 := apply(tr.lpf_step[b := l o. b(l, o), k := x8 x1. k(x8, x1)], {w}, {y}, {w2}, {y2}, {o2}, hw, bs, r2)
        show := mp(all_elim(rc, {o2}), r1)
      qed
      have s2: S(pair(w2, y2)) by ex_intro({x2}, {w2}, {y2}, taut(refl({pair(w2, y2)}), q2, rc2, dv2))
      have bl: b(l, ok(pair(w2, y2), empty)) := rewrite(sym(le), bs)
      have e2: ex l2. b(l, ok(l2, empty)) && S(l2) by ex_intro({pair(w2, y2)}, taut(bl, s2))
      show by taut(e2)
    qed
    have rc0: RCH(y0, w0) proof
      fix o2
      assume r2
      show := r2
    qed
    have dv0: DV(x0) by ex_intro({r}, taut(hrk, hd0))
    have s0: S(pair(w0, y0)) by ex_intro({x0}, {w0}, {y0}, taut(refl({pair(w0, y0)}), hq0, rc0, dv0))
    obtain f, ff fd f0 fs from mp(while_coind[l0 := pair(w0, y0), c := l. true, b := l o. b(l, o), s := l. S(l)], s0, ss)
    // so the spec's loop runs forever
    let T := trace_limit(i. tr(app(f, i)))
    have fs2: all i. i in omega -> true && b(app(f, i), ok(app(f, succ(i)), empty)) proof
      fix i
      assume hi
      have c := mp(all_elim(fs, {i}), hi)
      show by taut(c)
    qed
    have inf: ex f2. is_fun(f2) && dom(f2) = omega && app(f2, empty) = pair(w0, y0) &&
        (all i. i in omega -> true && b(app(f2, i), ok(app(f2, succ(i)), empty))) && diverge(T) = diverge(trace_limit(i. tr(app(f2, i))))
      by ex_intro({f}, taut(ff, fd, f0, fs2, refl({diverge(T)})))
    have wr: while_rel(pair(w0, y0), l. true, l o. b(l, o), l. tr(l), diverge(T)) by defs(taut(inf), while_rel)
    have tu0: all i. i in omega -> tr(app(f, i)) in univ(1) proof
      fix i
      assume hi
      have c := mp(all_elim(fs, {i}), hi)
      obtain x w y, le q1 _ _ from c.1
      have pu: pair(w, y) in univ(1) by taut(mp(all_elim(hq, {x}, {y}, {w}), q1))
      have au: app(f, i) in univ(1) := rewrite(sym(le), pu)
      show := mp(all_elim(htr, {app(f, i)}), au)
    qed
    have tu := mp(tr.tl_univ[t := i. tr(app(f, i))], tu0)
    have w0u: w0 in univ(1) by taut(mp(all_elim(hq, {x0}, {y0}, {w0}), hq0))
    have u: pair(w0, diverge(T)) in univ(1) by simp(w0u, tu)
    have r0: ex x9. while_rel(pair(w0, y0), l. true, l o. b(l, o), l. tr(l), x9) && k(x9, diverge(T)) by ex_intro({diverge(T)}, taut(wr, all_elim(hk2, {T})))
    have r1 := apply(tr.runs_intro[r := x0 x1. ex x9. while_rel(pair(x0, y0), l. true, l o. b(l, o), l. tr(l), x9) && k(x9, x1)], {w0}, {diverge(T)}, u, r0)
    have r2: runs(tr.lprog(y0, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1)), w0, diverge(T)) by defs(r1, tr.lprog)
    have e3: ex t3. runs(tr.lprog(y0, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1)), w0, diverge(t3)) by ex_intro({T}, r2)
    have e4: ex t4. o = diverge(t4) by ex_intro({snd(r)}, od)
    have dv: tr.div(tr.lprog(y0, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1)), w0, o) by defs(taut(e3, e4), tr.div)
    have lg: LG by defs(taut(dv), tr.lg)
    show by taut(lg, nlg)
  qed
  show by taut(em, ng)
qed

// The loop rule: at the loop's head h, coupled by q, the claim for the
// loop -- from the claim for one iteration (the head a breakpoint, arrived
// at coupled, with the iteration's spec returning the next locals marked)
theorem tr.loop(s, v, h, z. bp, z p w. ar, l o. b, l. tr, x8 x1. k, x y w. q):
  (all x y w. q(x, y, w) -> tr.hd(x) = h && !bp(x) && !tr.at_ret(s, x) && w in univ(1) && pair(w, y) in univ(1)) ->
  (all t. k(diverge(t), diverge(t))) -> (all l. l in univ(1) -> tr(l) in univ(1)) ->
  (all x y w. q(x, y, w) -> tr.simk(s, z. tr.hd(z) = h || bp(z), z p2 w2. tr.hd(z) = h && (ex y2. q(z, y2, w2) && runs(p2, w2, ok(w2, pair(18446744073709551616, y2)))),
    v, tr.lone(y, l o. b(l, o), x8 x1. k(x8, x1)), w, x)) ->
  all x y w. q(x, y, w) -> tr.simk(s, z. bp(z), z p w. ar(z, p, w), v, tr.lprog(y, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1)), w, x)
proof
  assume hq hk2 htr hb
  fix x y w
  assume q0
  let P := tr.lprog(y, l o. b(l, o), l. tr(l), x8 x1. k(x8, x1))
  have g: all o. tr.run_k(s, z. bp(z), x, o) -> tr.ub(s, v, P, w) || tr.crash(s, P, w, o) || tr.div(P, w, o) ||
      (ex m1. o = ok(m1, empty) && tr.arr(s, z. bp(z), z p w. ar(z, p, w), v, m1, P, w)) proof
    fix o
    assume hr
    obtain r, rk rm from expand(hr, tr.run_k)
    have f: !(fst(r) = 2) -> tr.lg(s, z. bp(z), v, P, w, o) proof
      assume nd
      show := mp(all_elim(mp(tr.loop_fin[s := s, v := v, h := h, bp := z. bp(z), b := l o. b(l, o), tr := l. tr(l), k := x8 x1. k(x8, x1), q := x y w. q(x, y, w)], hq, hb),
        {x}, {y}, {w}, {r}, {o}), q0, rk, rm, nd)
    qed
    have d: fst(r) = 2 -> tr.lg(s, z. bp(z), v, P, w, o) proof
      assume dd
      show := mp(all_elim(mp(tr.loop_div[s := s, v := v, h := h, bp := z. bp(z), b := l o. b(l, o), tr := l. tr(l), k := x8 x1. k(x8, x1), q := x y w. q(x, y, w)], hq, hb, hk2, htr),
        {x}, {y}, {w}, {r}, {o}), q0, rk, rm, dd)
    qed
    have lg: tr.lg(s, z. bp(z), v, P, w, o) by taut(f, d)
    // (the return: no point of bp, so the arrival is the return's)
    have rt: (ex m1. o = ok(m1, empty) && tr.at_ret(s, m1) && !bp(m1) && tr.retok(s, v, P, w, m1)) ->
        (ex m1. o = ok(m1, empty) && tr.arr(s, z. bp(z), z p w. ar(z, p, w), v, m1, P, w)) proof
      assume e
      obtain m1, oe at nb rt0 from e
      have a: tr.arr(s, z. bp(z), z p w. ar(z, p, w), v, m1, P, w) by defs(taut(rt0, nb), tr.arr)
      show by ex_intro({m1}, taut(oe, a))
    qed
    show by taut(expand(lg, tr.lg), rt)
  qed
  show by defs(g, tr.simk)
qed
