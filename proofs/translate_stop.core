// The run with a stop address: a function's disciplined run (tr.run_d)
// that ends where rip = t, its outcome ok(x, stop) (a return's value
// `stop`: no return's -- theirs empty -- and no machine fault's) -- the
// claim's `run_until(main)` in a function's terms (docs/todo.md section 5). A
// contract in this form gives the contract (tr.implements_at) of a spec
// that never raises at main: a run that never gets to t is the same run
// without the stop, and one that does matches only where the spec raises.
// (A raise at main is no undefined behaviour in the bridge: tr.ub,
// abi.raises_at leave it out, as a stack overflow.)

// (at t within the discipline: at the return a return, above the entry's
// sp disc)
abbrev tr.at_stop(s, t, x) := x.rip = t && !tr.at_ret(s, x) && int_lt(x.gpr[4], abi.sp(s))
def tr.rbs(s, t, l, o) := (!tr.at_stop(s, t, fst(l)) && tr.rbd(s, l, o)) || (!!tr.at_stop(s, t, fst(l)) && o = exc(l, pair("ret", exc_val("stop", empty))))
// (the stop's value: no return's)
theorem tr.stop_ne: !(exc_val("stop", empty) = empty)
proof
  have n := all_elim(tr.pair_ne, {"stop"}, {empty})
  have g: exc_val("stop", empty) = empty -> false proof
    assume e
    have e2: empty = pair("stop", empty) by defs(sym(e), exc_val)
    show by taut(e2, n)
  qed
  show by taut(g)
qed

def tr.rws(s, t, l, r) := while_rel(l, x5. true, x5 x6. tr.rbs(s, t, x5, x6), x5. fn_update(empty, "os.events", fst(x5).os.events), r)
def tr.run_s(s, t, m, o) := ex r. tr.rws(s, t, pair(m, empty), r) && tr.rmap(r, o)

// The outcomes matching a spec with the stop: as tr.matches_t, and the
// stop -- the spec raising `at_main` (the callee at t entered with its
// precondition) in a world that is a view of the machine stopped (its
// memory, its objects)
def tr.stop_t(spec, args, objs, mem, s, o) :=
  ex m w v2 mem2. o = ok(m, exc_val("stop", empty)) && abi.raise_state(w) && runs(spec[args], abi.view(s, objs, mem), exc(w, exc_val("at_main", empty))) &&
    w = abi.view(m, v2, mem2) && abi.view_ok(m, v2, mem2)

// The outcomes matching with the stop allowed (k) or not (a function never
// stopping at t: the stop only where the spec is undefined)
def tr.matches_tk(spec, args, objs, mem, s, o, k) := tr.matches_t(spec, args, objs, mem, s, o) || (k && tr.stop_t(spec, args, objs, mem, s, o))

// the contract with a stop at t: every disciplined run, stopping at t,
// matches the spec so
def tr.implements_stop(f, spec, t, k, base, code, statics) :=
  all args objs mem s o. args in abi.ARGS -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(s.vm, base, code, statics) ->
    s.rip = f -> abi.entry_ok(s, args) -> tr.objs_ok(s, objs) -> abi.view_ok(s, objs, mem) -> tr.run_s(s, t, s, o) -> tr.matches_tk(spec, args, objs, mem, s, o, k)

// (a disciplined run: the run stopping at t, or the run stopping at t
// stops)
theorem tr.run_d_s: all s t m o. tr.run_d(s, m, o) -> tr.run_s(s, t, m, o) || (ex x. tr.run_s(s, t, m, ok(x, exc_val("stop", empty))))
proof
  fix s t m o
  assume h
  obtain x4, hw hm from expand(h, tr.run_d)
  have ne: all l. !is_ok(exc(l, pair("ret", exc_val("stop", empty)))) proof
    fix l
    have n: is_ok(exc(l, pair("ret", exc_val("stop", empty)))) -> false proof
      assume h2
      obtain a b, h3 from expand(h2, is_ok)
      show by simp(h3)
    qed
    show by taut(n)
  qed
  have g := mp(mp(while_guard[l0 := pair(m, empty), b := l o. tr.rbd(s, l, o), tr := l. fn_update(empty, "os.events", fst(l).os.events),
    p := l. !tr.at_stop(s, t, fst(l)), e := l. exc(l, pair("ret", exc_val("stop", empty))), r := x4], ne), expand(hw, tr.rwd))
  have kept: while_rel(pair(m, empty), l. true, l o. (!tr.at_stop(s, t, fst(l)) && tr.rbd(s, l, o)) || (!!tr.at_stop(s, t, fst(l)) && o = exc(l, pair("ret", exc_val("stop", empty)))),
      l. fn_update(empty, "os.events", fst(l).os.events), x4) -> tr.run_s(s, t, m, o) proof
    assume w
    have ws: tr.rws(s, t, pair(m, empty), x4) by defs(w, tr.rws, tr.rbs)
    show by defs(ex_intro({x4}, taut(ws, hm)), tr.run_s)
  qed
  have left: (ex l. while_rel(pair(m, empty), l. true, l o. (!tr.at_stop(s, t, fst(l)) && tr.rbd(s, l, o)) || (!!tr.at_stop(s, t, fst(l)) && o = exc(l, pair("ret", exc_val("stop", empty)))),
      l. fn_update(empty, "os.events", fst(l).os.events), exc(l, pair("ret", exc_val("stop", empty))))) -> (ex x. tr.run_s(s, t, m, ok(x, exc_val("stop", empty)))) proof
    assume e
    obtain l, w from e
    have ws: tr.rws(s, t, pair(m, empty), exc(l, pair("ret", exc_val("stop", empty)))) by defs(w, tr.rws, tr.rbs)
    have rm: tr.rmap(exc(l, pair("ret", exc_val("stop", empty))), ok(fst(l), exc_val("stop", empty))) by defs(simp(), tr.rmap)
    have rs: tr.run_s(s, t, m, ok(fst(l), exc_val("stop", empty))) by defs(ex_intro({exc(l, pair("ret", exc_val("stop", empty)))}, taut(ws, rm)), tr.run_s)
    show by ex_intro({fst(l)}, rs)
  qed
  show by taut(g, kept, left)
qed

// (a stop matches the spec only where it raises: then anything does)
theorem tr.stop_matches: all spec args objs mem s x o. tr.matches_t(spec, args, objs, mem, s, ok(x, exc_val("stop", empty))) -> tr.matches_t(spec, args, objs, mem, s, o)
proof
  fix spec args objs mem s x o
  assume ma
  have n2: (ex m1 w2. ok(x, exc_val("stop", empty)) = ok(m1, empty) && m1 in x86_64_linux.Machine && m1 in univ(1) &&
      runs(spec[args], abi.view(s, objs, mem), ok(w2, pair(m1.gpr[0], m1.gpr[2]))) && w2 in abi.World && w2 in univ(1) &&
      abi.world_matches(s.vm, m1.vm, w2.vm, abi.wob(objs, w2.objs.c_bytes), s.fs_base, abi.sp(s)) && m1.os = w2.os && m1.fs_base = s.fs_base &&
      m1.cpu = s.cpu && m1.gs_base = s.gs_base && m1.rip = abi.ret(s) && m1.gpr[4] = abi.sp(s) &&
      abi.callee_saved(m1, s) && !m1.flags.df) -> false proof
    assume e
    obtain m1 w2, e2 from e
    show by simp(e2.1, tr.stop_ne)
  qed
  have n3: tr.crashes_t(spec, args, objs, mem, s, ok(x, exc_val("stop", empty))) -> false proof
    assume e
    obtain m1 a k, {oe} from expand(e, tr.crashes_t)
    show by simp(expand(oe, exc_val))
  qed
  have n4: tr.div(spec[args], abi.view(s, objs, mem), ok(x, exc_val("stop", empty))) -> false proof
    assume e
    obtain t, q from expand(e, tr.div).1
    show by simp(q)
  qed
  have n5 := all_elim(tr.xo_ok, {spec[args]}, {abi.view(s, objs, mem)}, {x}, {exc_val("stop", empty)})
  have r: abi.raises_at(spec, args, objs, mem, s) by taut(expand(ma, tr.matches_t), n2, n3, n4, n5)
  show by defs(taut(r), tr.matches_t)
qed

// the contract of a function never stopping at t gives the contract
// (the runs never stopping matching: the disciplined runs too)
theorem tr.ns_run: all spec args objs mem s t o. (all o2. tr.run_s(s, t, s, o2) -> tr.matches_tk(spec, args, objs, mem, s, o2, false)) ->
  tr.run_d(s, s, o) -> tr.matches_t(spec, args, objs, mem, s, o)
proof
  fix spec args objs mem s t o
  assume c hr
  have d := apply(tr.run_d_s[s := s, t := t, m := s, o := o], hr)
  have c1: tr.run_s(s, t, s, o) -> tr.matches_t(spec, args, objs, mem, s, o) proof
    assume rs
    show by taut(expand(mp(all_elim(c, {o}), rs), tr.matches_tk))
  qed
  have c2: (ex x. tr.run_s(s, t, s, ok(x, exc_val("stop", empty)))) -> tr.matches_t(spec, args, objs, mem, s, o) proof
    assume e
    obtain x, rs from e
    have mt: tr.matches_t(spec, args, objs, mem, s, ok(x, exc_val("stop", empty)))
      by taut(expand(mp(all_elim(c, {ok(x, exc_val("stop", empty))}), rs), tr.matches_tk))
    show := apply(tr.stop_matches[spec := spec, args := args, objs := objs, mem := mem, s := s, x := x, o := o], mt)
  qed
  show by taut(d, c1, c2)
qed

theorem tr.implements_ns_at: all f spec t base code statics. tr.implements_stop(f, spec, t, false, base, code, statics) -> tr.implements_at(f, spec, base, code, statics)
proof
  fix f spec t base code statics
  assume h
  have c := expand(h, tr.implements_stop)
  have g: all args objs mem s o. args in abi.ARGS -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(s.vm, base, code, statics) ->
      s.rip = f -> abi.entry_ok(s, args) -> tr.objs_ok(s, objs) -> abi.view_ok(s, objs, mem) -> tr.run_d(s, s, o) -> tr.matches_t(spec, args, objs, mem, s, o) proof
    fix args objs mem s o
    assume hA hot hmv hM su hl hrip he ok hwm hr
    have c2: all o2. tr.run_s(s, t, s, o2) -> tr.matches_tk(spec, args, objs, mem, s, o2, false) proof
      fix o2
      assume rs
      show := mp(all_elim(c, {args}, {objs}, {mem}, {s}, {o2}), hA, hot, hmv, hM, su, hl, hrip, he, ok, hwm, rs)
    qed
    show := apply(tr.ns_run, {spec}, {args}, {objs}, {mem}, {s}, {t}, {o}, c2, hr)
  qed
  show by defs(g, tr.implements_at)
qed

// ----------------------------------------------------------------------
//  Where a run returns

// (a disciplined last pass whose outcome maps to a return: at the return)
theorem tr.rbd_last: all s l r x e. tr.rbd(s, l, r) -> !is_ok(r) -> tr.rmap(r, ok(x, e)) -> tr.at_ret(s, x)
proof
  fix s l r x e
  assume hb nk hm
  have c1: tr.disc_ok(s, fst(l)) && tr.rb(s, l, r) -> tr.at_ret(s, x) proof
    assume hd
    have b1: (!tr.at_ret(s, fst(l)) && bind_rel(x86_64_linux.step, fst(l), x7 x8. r = ok(pair(x7, empty), empty), x7 x8. r = exc(pair(x7, empty), pair("raise", x8)), x7. r = diverge(x7))) ->
        tr.at_ret(s, x) proof
      assume hb1
      obtain o2, ho2 from expand(hb1.2, bind_rel)
      have k1: (ex s1 v1. o2 = ok(s1, v1) && r = ok(pair(s1, empty), empty)) -> tr.at_ret(s, x) proof
        assume ek
        obtain s1 v1, _ re from ek
        show by simp(expand(rewrite(re, nk), is_ok))
      qed
      have k2: (ex s1 e1. o2 = exc(s1, e1) && r = exc(pair(s1, empty), pair("raise", e1))) -> tr.at_ret(s, x) proof
        assume ek
        obtain s1 e1, _ re from ek
        show by simp(expand(rewrite(re, hm), tr.rmap))
      qed
      have k3: (ex t. o2 = diverge(t) && r = diverge(t)) -> tr.at_ret(s, x) proof
        assume ek
        obtain t, _ re from ek
        show by simp(expand(rewrite(re, hm), tr.rmap))
      qed
      show by taut(ho2, k1, k2, k3)
    qed
    have b2: (!!tr.at_ret(s, fst(l)) && r = exc(pair(fst(l), empty), pair("brk", empty))) -> tr.at_ret(s, x) proof
      assume hb2
      have nar re := hb2
      have xe: x = fst(l) by simp(expand(rewrite(re, hm), tr.rmap))
      have ar: tr.at_ret(s, fst(l)) by taut(nar)
      show := rewrite(sym(xe), ar)
    qed
    show by taut(expand(hd.2, tr.rb), b1, b2)
  qed
  have c2: !tr.disc_ok(s, fst(l)) && r = exc(l, pair("raise", exc_val("disc", empty))) -> tr.at_ret(s, x) proof
    assume hd
    show by simp(expand(rewrite(hd.2, hm), tr.rmap))
  qed
  show by taut(expand(hb, tr.rbd), c1, c2)
qed

// (a stop run returning: at the return)
theorem tr.run_s_ok: all s t m x. tr.run_s(s, t, m, ok(x, empty)) -> tr.at_ret(s, x)
proof
  fix s t m x
  assume h
  obtain r, hw hm from expand(h, tr.run_s)
  have wi := mp(mp(mp(while_inv[l0 := pair(m, empty), c := l. true, b := l o. tr.rbs(s, t, l, o),
    tr := l. fn_update(empty, "os.events", fst(l).os.events), r := r, p := l. true], simp()), simp()), expand(hw, tr.rws))
  have nd: !(ex t2. r = diverge(t2)) proof
    have g: (ex t2. r = diverge(t2)) -> false proof
      assume ed
      obtain t2, ht from ed
      show by simp(expand(rewrite(ht, hm), tr.rmap))
    qed
    show by taut(g)
  qed
  have el: ex l. true && ((!true && r = ok(l, empty)) || (true && tr.rbs(s, t, l, r) && !is_ok(r))) by taut(wi, nd)
  obtain l, hl from el
  have hb: tr.rbs(s, t, l, r) by taut(hl)
  have nk: !is_ok(r) by taut(hl)
  have c1: !tr.at_stop(s, t, fst(l)) && tr.rbd(s, l, r) -> tr.at_ret(s, x) proof
    assume hd
    show := apply(tr.rbd_last[s := s, l := l, r := r, x := x, e := empty], (tr.rbd(s, l, r) by taut(hd)), nk, hm)
  qed
  have c2: !!tr.at_stop(s, t, fst(l)) && r = exc(l, pair("ret", exc_val("stop", empty))) -> tr.at_ret(s, x) proof
    assume hd
    show by simp(expand(rewrite(hd.2, hm), tr.rmap), tr.stop_ne)
  qed
  show by taut(expand(hb, tr.rbs), c1, c2)
qed

// ----------------------------------------------------------------------
//  The claim's run with the breakpoint rip = t (as tr.run_d_k for the
//  disciplined run): the stop run's outcome, or the claim's run stops
//  where the stop run leaves with disc, or where it stops at t

theorem tr.run_s_k: all s t m o. tr.run_s(s, t, m, o) -> int_lt(m.gpr[4], abi.sp(s)) -> !(m.rip = t) ->
  (ex o1. tr.run_k(s, zb. zb.rip = t, m, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2))) ||
  (ex x. o = exc(x, exc_val("disc", empty)) && tr.run_k(s, zb. zb.rip = t, m, ok(x, empty)) && !tr.at_ret(s, x) && tr.out(s, x))||
  (ex x. o = ok(x, exc_val("stop", empty)) && tr.run_k(s, zb. zb.rip = t, m, ok(x, empty)) && x.rip = t && !tr.at_ret(s, x))
proof
  fix s t m o
  assume h hlt hnt
  let G := (ex o1. tr.run_k(s, zb. zb.rip = t, m, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2))) ||
    (ex x. o = exc(x, exc_val("disc", empty)) && tr.run_k(s, zb. zb.rip = t, m, ok(x, empty)) && !tr.at_ret(s, x) && tr.out(s, x))||
    (ex x. o = ok(x, exc_val("stop", empty)) && tr.run_k(s, zb. zb.rip = t, m, ok(x, empty)) && x.rip = t && !tr.at_ret(s, x))
  let TR(x5) := fn_update(empty, "os.events", fst(x5).os.events)
  let P(l) := int_lt(fst(l).gpr[4], abi.sp(s)) && !(fst(l).rip = t)
  let E(l) := exc(pair(fst(l), empty), pair("brk", empty))
  obtain r, hw hm from expand(h, tr.run_s)
  // (below the sp, off t: the pass is the plain step)
  have pb: all l o2. P(l) -> tr.rbs(s, t, l, o2) -> tr.rst(l, o2) proof
    fix l o2
    assume hp hb
    have hp1 hp2 := hp
    have ne: fst(l).gpr[4] = abi.sp(s) -> false proof
      assume e
      have l2 := rewrite(e, hp1)
      show by arith(l2)
    qed
    have nar: !tr.at_ret(s, fst(l)) by taut(ne)
    have dok: tr.disc_ok(s, fst(l)) by taut(hp1)
    have bd: tr.rbd(s, l, o2) by taut(expand(hb, tr.rbs), hp2)
    have rb: tr.rb(s, l, o2) by taut(expand(bd, tr.rbd), dok)
    show by defs(taut(expand(rb, tr.rb), nar), tr.rst)
  qed
  // (the guarded passes: the claim's, t a breakpoint)
  have gb: all l o2. (P(l) && tr.rbs(s, t, l, o2)) || (!P(l) && o2 = E(l)) -> tr.rbk(s, zb. zb.rip = t, l, o2) proof
    fix l o2
    assume g
    have g1: P(l) && tr.rbs(s, t, l, o2) -> tr.rbk(s, zb. zb.rip = t, l, o2) proof
      assume e
      have pe: P(l) by taut(e)
      have rs := mp(all_elim(pb, {l}, {o2}), pe, (tr.rbs(s, t, l, o2) by taut(e)))
      have ns: !tr.stopk(s, zb. zb.rip = t, fst(l)) by defs(taut(pe), tr.stopk)
      show by defs(taut(ns, rs), tr.rbk)
    qed
    have g2: !P(l) && o2 = E(l) -> tr.rbk(s, zb. zb.rip = t, l, o2) proof
      assume e
      have st: tr.stopk(s, zb. zb.rip = t, fst(l)) by defs(taut(e.1), tr.stopk)
      show by defs(taut(st, e.2), tr.rbk)
    qed
    show by taut(g, g1, g2)
  qed
  have pm: P(pair(m, empty)) by simp(hlt, hnt)
  have un := mp(while_unroll[l0 := pair(m, empty), c := x5. true, b := x5 x6. tr.rbs(s, t, x5, x6), tr := x5. TR(x5), r := r], expand(hw, tr.rws))
  // the first pass leaves
  have u1: tr.rbs(s, t, pair(m, empty), r) && !is_ok(r) -> G proof
    assume e
    have rs := mp(all_elim(pb, {pair(m, empty)}, {r}), pm, e.1)
    have rk: tr.rk(s, zb. zb.rip = t, m, r) by defs(taut(rs, e.2), tr.rk)
    have rn: tr.run_k(s, zb. zb.rip = t, m, o) by defs(ex_intro({r}, taut(rk, hm)), tr.run_k)
    have e1: ex o1. tr.run_k(s, zb. zb.rip = t, m, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2)) by ex_intro({o}, taut(rn, refl({o})))
    show by taut(e1)
  qed
  // the first pass goes on to l1: the passes from l1 cut where rsp first
  // reaches the entry's sp, or rip t
  have u2: (ex l1. tr.rbs(s, t, pair(m, empty), ok(l1, empty)) && (ex r1. while_rel(l1, x5. true, x5 x6. tr.rbs(s, t, x5, x6), x5. TR(x5), r1) &&
      fst(r1) = fst(r) && (!(fst(r) = 2) -> r1 = r))) -> G proof
    assume e
    obtain l1, rb0 er from e
    obtain r1, w1 f1 e1 from er
    have rs0 := mp(all_elim(pb, {pair(m, empty)}, {ok(l1, empty)}), pm, rb0)
    have q1: l1 = pair(fst(l1), empty) by simp(expand(rs0, tr.rst), keep(x86_64_linux.step))
    have he: all l. !is_ok(E(l)) proof
      fix l
      show by defs(simp(), is_ok)
    qed
    have hqs: all l l2. l = pair(fst(l), empty) -> tr.rbs(s, t, l, ok(l2, empty)) -> l2 = pair(fst(l2), empty) proof
      fix l l2
      assume _ hb
      show by simp(expand(hb, tr.rbs, tr.rbd, tr.rb), keep(x86_64_linux.step))
    qed
    have sp := mp(while_split[l0 := l1, b := l o2. tr.rbs(s, t, l, o2), tr := l. TR(l), p := l. P(l), e := l. E(l), r := r1, q := l. l = pair(fst(l), empty)],
      he, q1, hqs, w1)
    let GB(l, o2) := (P(l) && tr.rbs(s, t, l, o2)) || (!P(l) && o2 = E(l))
    // never reaching it: the claim's run, the same outcome
    have ca: while_rel(l1, l. true, l o2. GB(l, o2), l. TR(l), r1) -> G proof
      assume wg
      have w2 := mp(while_mono[l0 := l1, c := l. true, b1 := l o2. GB(l, o2), b2 := l o2. tr.rbk(s, zb. zb.rip = t, l, o2), tr := l. TR(l), r := r1], gb, wg)
      have rw: tr.rwk(s, zb. zb.rip = t, l1, r1) by defs(w2, tr.rwk)
      have ex2: ex l2. tr.rst(pair(m, empty), ok(l2, empty)) && tr.rwk(s, zb. zb.rip = t, l2, r1) by ex_intro({l1}, taut(rs0, rw))
      have rk: tr.rk(s, zb. zb.rip = t, m, r1) by defs(taut(ex2), tr.rk)
      have nd: !(fst(r) = 2) -> G proof
        assume n
        have re := mp(e1, n)
        have rn: tr.run_k(s, zb. zb.rip = t, m, o) by defs(ex_intro({r1}, taut(rk, rewrite(sym(re), hm))), tr.run_k)
        have e3: ex o1. tr.run_k(s, zb. zb.rip = t, m, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2)) by ex_intro({o}, taut(rn, refl({o})))
        show by taut(e3)
      qed
      have dd: fst(r) = 2 -> G proof
        assume d
        have d1: fst(r1) = 2 by simp(f1, d)
        have rm1: tr.rmap(r1, diverge(snd(r1))) by defs(simp(d1), tr.rmap)
        have rn: tr.run_k(s, zb. zb.rip = t, m, diverge(snd(r1))) by defs(ex_intro({r1}, taut(rk, rm1)), tr.run_k)
        have od: fst(o) = 2 by simp(expand(hm, tr.rmap), d)
        have dd2: fst(diverge(snd(r1))) = 2 by simp()
        have e3: ex o1. tr.run_k(s, zb. zb.rip = t, m, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2)) by ex_intro({diverge(snd(r1))}, taut(rn, dd2, od))
        show by taut(e3)
      qed
      show by taut(nd, dd)
    qed
    // reaching it at l: the claim's run stops there; the stop run stops
    // there (at t), returns there (at the return) or leaves with disc
    have cb: (ex l. l = pair(fst(l), empty) && while_rel(l1, l. true, l o2. GB(l, o2), l. TR(l), E(l)) &&
        (ex r2. while_rel(l, l. true, l o2. tr.rbs(s, t, l, o2), l. TR(l), r2) && fst(r2) = fst(r1) && (!(fst(r1) = 2) -> r2 = r1))) -> G proof
      assume e2
      obtain l, ql wg er2 from e2
      obtain r2, w3 f3 e3 from er2
      have w2 := mp(while_mono[l0 := l1, c := l. true, b1 := l o2. GB(l, o2), b2 := l o2. tr.rbk(s, zb. zb.rip = t, l, o2), tr := l. TR(l), r := E(l)], gb, wg)
      have rw: tr.rwk(s, zb. zb.rip = t, l1, E(l)) by defs(w2, tr.rwk)
      have ex2: ex l2. tr.rst(pair(m, empty), ok(l2, empty)) && tr.rwk(s, zb. zb.rip = t, l2, E(l)) by ex_intro({l1}, taut(rs0, rw))
      have rk: tr.rk(s, zb. zb.rip = t, m, E(l)) by defs(taut(ex2), tr.rk)
      have rmb: tr.rmap(E(l), ok(fst(l), empty)) by defs(simp(), tr.rmap)
      have rn: tr.run_k(s, zb. zb.rip = t, m, ok(fst(l), empty)) by defs(ex_intro({E(l)}, taut(rk, rmb)), tr.run_k)
      // (at l, the guarded run's last pass is a cut)
      have cs := mp(while_cases[l0 := l1, c := l. true, b := l o2. GB(l, o2), tr := l. TR(l), r := E(l)], wg)
      have np: !P(l) proof
        have c1: (ex l3. (!true && E(l) = ok(l3, empty)) || (true && GB(l3, E(l)) && !is_ok(E(l)))) -> !P(l) proof
          assume el
          obtain l3, hl3 from el
          have gb3: GB(l3, E(l)) by taut(hl3)
          have k1: P(l3) && tr.rbs(s, t, l3, E(l)) -> !P(l) proof
            assume k
            have rs3 := mp(all_elim(pb, {l3}, {E(l)}), (P(l3) by taut(k)), (tr.rbs(s, t, l3, E(l)) by taut(k)))
            have ro := apply(tr.rst_out, {l3}, {E(l)}, rs3, all_elim(he, {l}))
            have f: false by simp(ro)
            show by taut(f)
          qed
          have k2: !P(l3) && E(l) = E(l3) -> !P(l) proof
            assume k
            have fe: fst(l) = fst(l3) by simp(k.2)
            show := rewrite(sym(fe), k.1)
          qed
          show by taut(gb3, k1, k2)
        qed
        have c2: (ex t2. E(l) = diverge(t2)) -> !P(l) proof
          assume ed
          obtain t2, te from ed
          have f: false by simp(te)
          show by taut(f)
        qed
        show by taut(cs, c1, c2)
      qed
      // the stop run from l
      have un2 := mp(while_unroll[l0 := l, c := x5. true, b := x5 x6. tr.rbs(s, t, x5, x6), tr := x5. TR(x5), r := r2], w3)
      have rr: !(fst(r2) = 2) -> r2 = r proof
        assume n2
        have n1: !(fst(r1) = 2) by simp(n2, f3)
        have n0: !(fst(r) = 2) by simp(n1, f1)
        show := trans(mp(e3, n1), mp(e1, n0))
      qed
      have v0: (!true && r2 = ok(l, empty)) -> G proof
        assume k
        show by taut(k)
      qed
      // (a pass from l always leaving: the run's outcome its)
      have one: all o3. (all o2. tr.rbs(s, t, l, o2) -> o2 = o3) -> !is_ok(o3) -> !(fst(o3) = 2) -> tr.rmap(o3, o) proof
        fix o3
        assume bb nok nd3
        have v1: tr.rbs(s, t, l, r2) && !is_ok(r2) -> tr.rmap(o3, o) proof
          assume k
          have r2e := mp(all_elim(bb, {r2}), k.1)
          have n2: !(fst(r2) = 2) := rewrite(sym(r2e), nd3)
          have re := mp(rr, n2)
          show := rewrite(r2e, rewrite(sym(re), hm))
        qed
        have v2: (ex l4. tr.rbs(s, t, l, ok(l4, empty)) && (ex r4. while_rel(l4, x5. true, x5 x6. tr.rbs(s, t, x5, x6), x5. TR(x5), r4) && fst(r4) = fst(r2) &&
            (!(fst(r2) = 2) -> r4 = r2))) -> tr.rmap(o3, o) proof
          assume k
          obtain l4, hb4 _ from k
          have r4e := mp(all_elim(bb, {ok(l4, empty)}), hb4)
          have ok4: is_ok(ok(l4, empty)) by defs(ex_intro({l4}, {empty}, refl({ok(l4, empty)})), is_ok)
          have f: false by taut(nok, rewrite(r4e, ok4))
          show by taut(f)
        qed
        have v00: (!true && r2 = ok(l, empty)) -> tr.rmap(o3, o) proof
          assume k
          show by taut(k)
        qed
        show by taut(un2, v00, v1, v2)
      qed
      // (at t: it stops)
      have st1: tr.at_stop(s, t, fst(l)) -> G proof
        assume ht
        have ht1 ht2 _ := ht
        let O3 := exc(l, pair("ret", exc_val("stop", empty)))
        have bb: all o2. tr.rbs(s, t, l, o2) -> o2 = O3 proof
          fix o2
          assume hb
          show by taut(expand(hb, tr.rbs), ht)
        qed
        have nok: !is_ok(O3) proof
          have n: is_ok(O3) -> false proof
            assume h3
            obtain a b, h4 from expand(h3, is_ok)
            show by simp(h4)
          qed
          show by taut(n)
        qed
        have rm := mp(all_elim(one, {O3}), bb, nok, (!(fst(O3) = 2) by simp()))
        have oe: o = ok(fst(l), exc_val("stop", empty)) by simp(expand(rm, tr.rmap))
        have e4: ex x. o = ok(x, exc_val("stop", empty)) && tr.run_k(s, zb. zb.rip = t, m, ok(x, empty)) && x.rip = t && !tr.at_ret(s, x)
          by ex_intro({fst(l)}, taut(oe, rn, ht1, ht2))
        show by taut(e4)
      qed
      // (off t, or at the return: rsp has reached the sp -- at the return:
      // it returns; elsewhere: disc)
      have st2: !tr.at_stop(s, t, fst(l)) -> G proof
        assume nt
        have lt1: fst(l).rip = t -> !int_lt(fst(l).gpr[4], abi.sp(s)) proof
          assume e
          have c1: tr.at_ret(s, fst(l)) -> !int_lt(fst(l).gpr[4], abi.sp(s)) proof
            assume ar
            have eq: fst(l).gpr[4] = abi.sp(s) by taut(ar)
            show by arith(eq)
          qed
          show by taut(nt, e, c1)
        qed
        have nlt: !int_lt(fst(l).gpr[4], abi.sp(s)) by taut(np, lt1)
        have at1: tr.at_ret(s, fst(l)) -> G proof
          assume at
          let O3 := exc(pair(fst(l), empty), pair("brk", empty))
          have dok: tr.disc_ok(s, fst(l)) by taut(at)
          have bb: all o2. tr.rbs(s, t, l, o2) -> o2 = O3 proof
            fix o2
            assume hb
            have bd: tr.rbd(s, l, o2) by taut(expand(hb, tr.rbs), nt)
            have rb: tr.rb(s, l, o2) by taut(expand(bd, tr.rbd), dok)
            show by taut(expand(rb, tr.rb), at)
          qed
          have nok: !is_ok(O3) by defs(simp(), is_ok)
          have rm := mp(all_elim(one, {O3}), bb, nok, (!(fst(O3) = 2) by simp()))
          have oe: o = ok(fst(l), empty) by simp(expand(rm, tr.rmap))
          have e4: ex o1. tr.run_k(s, zb. zb.rip = t, m, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2)) by ex_intro({ok(fst(l), empty)}, taut(rn, sym(oe)))
          show by taut(e4)
        qed
        have at2: !tr.at_ret(s, fst(l)) -> G proof
          assume nat
          let O3 := exc(l, pair("raise", exc_val("disc", empty)))
          have ndok: !tr.disc_ok(s, fst(l)) by taut(nat, nlt)
          have bb: all o2. tr.rbs(s, t, l, o2) -> o2 = O3 proof
            fix o2
            assume hb
            have bd: tr.rbd(s, l, o2) by taut(expand(hb, tr.rbs), nt)
            show by taut(expand(bd, tr.rbd), ndok)
          qed
          have nok: !is_ok(O3) proof
            have n: is_ok(O3) -> false proof
              assume h3
              obtain a b, h4 from expand(h3, is_ok)
              show by simp(h4)
            qed
            show by taut(n)
          qed
          have rm := mp(all_elim(one, {O3}), bb, nok, (!(fst(O3) = 2) by simp()))
          have oe: o = exc(fst(l), exc_val("disc", empty)) by simp(expand(rm, tr.rmap))
          have e4: ex x. o = exc(x, exc_val("disc", empty)) && tr.run_k(s, zb. zb.rip = t, m, ok(x, empty)) && !tr.at_ret(s, x) && tr.out(s, x)
            by ex_intro({fst(l)}, taut(oe, rn, nat, nlt))
          show by taut(e4)
        qed
        show by taut(at1, at2)
      qed
      show by taut(st1, st2)
    qed
    show by taut(sp, ca, cb)
  qed
  have u0: (!true && r = ok(pair(m, empty), empty)) -> G proof
    assume e
    show by taut(e)
  qed
  show by taut(un, u0, u1, u2)
qed

// (a stop run's outcome tagged 2: a divergence)
theorem tr.run_s_div: all s t m o. tr.run_s(s, t, m, o) -> fst(o) = 2 -> (ex t2. o = diverge(t2))
proof
  fix s t m o
  assume h hf
  obtain r, _ hm from expand(h, tr.run_s)
  have c: fst(r) = 2 && o = diverge(snd(r)) by simp(expand(hm, tr.rmap), hf)
  show by ex_intro({snd(r)}, taut(c))
qed

// ----------------------------------------------------------------------
//  The contract with the stop from the claim at the entry (as tr.entry_d):
//  the claim with the breakpoint rip = t, there the program left raising
//  at main in a world that is a view of the machine (tr.at_t)

def tr.at_t(zb, pb, wb) := (ex w2 v2 mem2. abi.raise_state(w2) && runs(pb, wb, exc(w2, exc_val("at_main", empty))) && w2 = abi.view(zb, v2, mem2) &&
    abi.view_ok(zb, v2, mem2)) ||
  // (or undefined: main's precondition failing)
  (ex e x. e in univ(1) && !(e = exc_val("stack_overflow", empty)) && abi.nstop(e) && abi.raise_state(x) && runs(pb, wb, exc(x, e)))

// ----------------------------------------------------------------------
//  The contract with the stop in either mode b (tr.cbm), in the claim's
//  terms: V the callers' stack objects with the mode's C bytes, W the
//  entry's world, P the spec's program (the main mode's: tr.matches_tk,
//  tr.implements_stop)

// a return: P's, its thread pointer the entry's in the main mode, the
// world's in the startup's
def tr.rtv(b, s, V, P, W, m1) := m1 in x86_64_linux.Machine && m1 in univ(1) &&
  (ex w2. runs(P, W, ok(w2, pair(m1.gpr[0], m1.gpr[2]))) && w2 in abi.World && w2 in univ(1) &&
    tr.wmc(s.vm, m1.vm, w2.vm, abi.wob(V.live, w2.objs.c_bytes), s.fs_base, abi.sp(s)) && m1.os = w2.os &&
    w2.objs.c_bytes = V.c_bytes && (b -> m1.fs_base = s.fs_base) && (!b -> m1.fs_base = w2.fs_base)) &&
  m1.cpu = s.cpu && m1.gs_base = s.gs_base && m1.rip = abi.ret(s) && m1.gpr[4] = abi.sp(s) &&
  abi.callee_saved(m1, s) && !m1.flags.df
// the stop's relation (tr.at_t): main entered, the program raising at
// main in a view of the machine stopped -- or undefined
def tr.at_tm(b, zb, pb, wb) := (ex w2 v2 mem2. abi.raise_state(w2) && runs(pb, wb, exc(w2, exc_val("at_main", empty))) && w2 = tr.vw(b, zb, v2, mem2) &&
    tr.vok(b, zb, v2, mem2)) ||
  (ex e x. e in univ(1) && !(e = exc_val("stack_overflow", empty)) && abi.nstop(e) && abi.raise_state(x) && runs(pb, wb, exc(x, e)))
// the stop (tr.stop_t)
def tr.stv(b, P, W, o) := ex m w v2 mem2. o = ok(m, exc_val("stop", empty)) && abi.raise_state(w) && runs(P, W, exc(w, exc_val("at_main", empty))) &&
  w = tr.vw(b, m, v2, mem2) && tr.vok(b, m, v2, mem2)
// the outcomes matching: undefined, a crash, a divergence, a return, the
// stop if allowed (k)
def tr.mtv(b, s, V, P, W, o, k) := tr.ub(s, V, P, W) || tr.crash(s, P, W, o) || tr.div(P, W, o) ||
  (ex m1. o = ok(m1, empty) && tr.rtv(b, s, V, P, W, m1)) || (k && tr.stv(b, P, W, o)) || tr.xo(P, W, o)
// the contract (u: for an entry of any alignment)
def tr.impl_m(b, u, f, spec, t, k, base, code, statics) :=
  all args objs mem s o. args in abi.ARGS -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(s.vm, base, code, statics) ->
    s.rip = f -> tr.eok(b, u, s, args) -> tr.objs_ok(s, objs) -> tr.vok(b, s, objs, mem) -> tr.run_s(s, t, s, o) ->
    tr.mtv(b, s, abi.wob(objs, tr.cbm(b, s.fs_base)), spec[args], tr.vw(b, s, objs, mem), o, k)

// The contract from the claim at the entry, t a breakpoint (its relation
// tr.at_tm if the stop is allowed, k)
theorem tr.entry_skm: all b P W s V o t k. s in x86_64_linux.Machine -> int_lt(s.gpr[4], 140737488355328) -> !(s.rip = t) ->
  (b -> tr.mainv(s, V)) ->
  tr.sim(s, zb. zb.rip = t, zb pb wb. k && tr.at_tm(b, zb, pb, wb), V, P, W, s) -> tr.run_s(s, t, s, o) -> tr.mtv(b, s, V, P, W, o, k)
proof
  fix b P W s V o t k
  assume hM hsl hnt hbm h rd
  have r4 := apply(x86i.rsp_typed, hM)
  have lt := apply(tr.sp_lt, {s.gpr[4]}, r4, hsl)
  have sm := expand(h, tr.sim)
  // (a return reached: the spec's)
  have rt: all m1. tr.retok(s, V, P, W, m1) -> tr.rtv(b, s, V, P, W, m1) proof
    fix m1
    assume hr
    have rx := expand(hr, tr.retok)
    have ew: ex w3. runs(P, W, ok(w3, pair(m1.gpr[0], m1.gpr[2]))) && w3 in abi.World && w3 in univ(1) &&
        tr.wmc(s.vm, m1.vm, w3.vm, abi.wob(V.live, w3.objs.c_bytes), s.fs_base, abi.sp(s)) && m1.os = w3.os && tr.rfs(s, V, m1, w3) by taut(rx)
    obtain w3, h3 from ew
    have f1: b -> m1.fs_base = s.fs_base proof
      assume hb
      have mv := mp(hbm, hb)
      show by taut(h3, mv)
    qed
    have f2: !b -> m1.fs_base = w3.fs_base by taut(h3)
    have e3: ex w2. runs(P, W, ok(w2, pair(m1.gpr[0], m1.gpr[2]))) && w2 in abi.World && w2 in univ(1) &&
        tr.wmc(s.vm, m1.vm, w2.vm, abi.wob(V.live, w2.objs.c_bytes), s.fs_base, abi.sp(s)) && m1.os = w2.os &&
        w2.objs.c_bytes = V.c_bytes && (b -> m1.fs_base = s.fs_base) && (!b -> m1.fs_base = w2.fs_base) by ex_intro({w3}, taut(h3, f1, f2))
    show by defs(taut(rx, e3), tr.rtv)
  qed
  have k1: tr.ub(s, V, P, W) -> tr.mtv(b, s, V, P, W, o, k) proof
    assume u
    show by defs(taut(u), tr.mtv)
  qed
  have rdk := apply(tr.run_s_k, {s}, {t}, {s}, {o}, rd, lt, hnt)
  // the claim's run to the same outcome
  have c1: (ex o1. tr.run_k(s, zb. zb.rip = t, s, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2))) -> tr.mtv(b, s, V, P, W, o, k) proof
    assume e
    obtain o1, rk eo from e
    have g := expand(mp(all_elim(sm, {o1}), rk), tr.gk)
    have k2: tr.crash(s, P, W, o1) -> tr.mtv(b, s, V, P, W, o, k) proof
      assume c
      obtain m1 a k0, {oe} from expand(c, tr.crash)
      have nd: !(fst(o1) = 2) by simp(oe)
      have oe2: o1 = o by taut(eo, nd)
      have c2 := rewrite(oe2, c)
      show by defs(taut(c2), tr.mtv)
    qed
    have k3: tr.div(P, W, o1) -> tr.mtv(b, s, V, P, W, o, k) proof
      assume d
      obtain t2, te from expand(d, tr.div).1
      have f1: fst(o1) = 2 by simp(te)
      have f0a: o1 = o -> fst(o) = 2 proof
        assume e5
        show := rewrite(e5, f1)
      qed
      have f0: fst(o) = 2 by taut(eo, f0a)
      have ed := apply(tr.run_s_div, rd, f0)
      have d2: tr.div(P, W, o) by defs(taut(ed, expand(d, tr.div).2), tr.div)
      show by defs(taut(d2), tr.mtv)
    qed
    // (the claim's run returning: the stop run returns there)
    have k4: (ex m1. o1 = ok(m1, empty) && tr.arr(s, zb. zb.rip = t, zb pb wb. k && tr.at_tm(b, zb, pb, wb), V, m1, P, W)) -> tr.mtv(b, s, V, P, W, o, k) proof
      assume e2
      obtain m1, oe1 ha from e2
      have nd: !(fst(o1) = 2) by simp(oe1)
      have oe0: o1 = o by taut(eo, nd)
      have oe: o = ok(m1, empty) := trans(sym(oe0), oe1)
      have at := apply(tr.run_s_ok, rewrite(oe, rd))
      have ou: tr.out(s, m1) proof
        have ne: int_lt(m1.gpr[4], abi.sp(s)) -> false proof
          assume l2
          have l3 := rewrite(at.2, l2)
          show by arith(l3)
        qed
        show by taut(ne)
      qed
      have hr := mp(expand(ha, tr.arr).1, ou)
      have rv := mp(all_elim(rt, {m1}), hr)
      have e5: ex m2. o = ok(m2, empty) && tr.rtv(b, s, V, P, W, m2) by ex_intro({m1}, taut(oe, rv))
      show by defs(taut(e5), tr.mtv)
    qed
    have k5: tr.xo(P, W, o1) -> tr.mtv(b, s, V, P, W, o, k) proof
      assume hx
      obtain m1 st x, _ xe _ _ from expand(hx, tr.xo)
      have nd: !(fst(o1) = 2) by simp(xe)
      have oe2: o1 = o by taut(eo, nd)
      show by defs(taut(rewrite(oe2, hx)), tr.mtv)
    qed
    show by taut(g, k1, k2, k3, k4, k5)
  qed
  // the claim's run stopping where the stop run leaves with disc: undefined
  have c2: (ex x. o = exc(x, exc_val("disc", empty)) && tr.run_k(s, zb. zb.rip = t, s, ok(x, empty)) && !tr.at_ret(s, x) && tr.out(s, x)) ->
      tr.mtv(b, s, V, P, W, o, k) proof
    assume e
    obtain x, oe rk nat nxt from e
    have g := expand(mp(all_elim(sm, {ok(x, empty)}), rk), tr.gk)
    have k2: tr.crash(s, P, W, ok(x, empty)) -> false proof
      assume c
      obtain m1 a k0, {oe} from expand(c, tr.crash)
      show by simp(oe)
    qed
    have k3 := all_elim(tr.div_ok, {P}, {W}, {x}, {empty})
    have k4: (ex m1. ok(x, empty) = ok(m1, empty) && tr.arr(s, zb. zb.rip = t, zb pb wb. k && tr.at_tm(b, zb, pb, wb), V, m1, P, W)) -> false proof
      assume e2
      obtain m1, oe1 ha from e2
      have me: m1 = x by simp(oe1)
      have ou: tr.out(s, x) := nxt
      have ha2 := rewrite(me, ha)
      have rx := expand(mp(expand(ha2, tr.arr).1, ou), tr.retok)
      have at: tr.at_ret(s, x) by taut(rx)
      show by taut(at, nat)
    qed
    show by taut(g, k1, k2, k3, k4, all_elim(tr.xo_ok, {P}, {W}, {x}, {empty}))
  qed
  // the stop: the claim's run stops at t, the program raising at main there
  have c3: (ex x. o = ok(x, exc_val("stop", empty)) && tr.run_k(s, zb. zb.rip = t, s, ok(x, empty)) && x.rip = t && !tr.at_ret(s, x)) ->
      tr.mtv(b, s, V, P, W, o, k) proof
    assume e
    obtain x, oe rk xt xnr from e
    have g := expand(mp(all_elim(sm, {ok(x, empty)}), rk), tr.gk)
    have k2: tr.crash(s, P, W, ok(x, empty)) -> false proof
      assume c
      obtain m1 a k0, {oe2 = oe} from expand(c, tr.crash)
      show by simp(oe2)
    qed
    have k3 := all_elim(tr.div_ok, {P}, {W}, {x}, {empty})
    have k4: (ex m1. ok(x, empty) = ok(m1, empty) && tr.arr(s, zb. zb.rip = t, zb pb wb. k && tr.at_tm(b, zb, pb, wb), V, m1, P, W)) ->
        tr.mtv(b, s, V, P, W, o, k) proof
      assume e2
      obtain m1, oe1 ha from e2
      have me: m1 = x by simp(oe1)
      have ha2 := rewrite(me, ha)
      have ar2 := expand(ha2, tr.arr).2
      // (at t, below the sp: the breakpoint's relation)
      have no: !tr.out(s, x) proof
        have ou: tr.out(s, x) -> false proof
          assume ou
          have rx := expand(mp(expand(ha2, tr.arr).1, ou), tr.retok)
          have at: tr.at_ret(s, x) by taut(rx)
          show by taut(at, xnr)
        qed
        show by taut(ou)
      qed
      obtain p2 w2, rd2 att from mp(ar2, no, xt)
      have kk hat := att
      have red := expand(rd2, tr.red)
      // (main entered: the stop; or undefined)
      have a1: (ex w3 v3 mem3. abi.raise_state(w3) && runs(p2, w2, exc(w3, exc_val("at_main", empty))) && w3 = tr.vw(b, x, v3, mem3) &&
          tr.vok(b, x, v3, mem3)) -> tr.mtv(b, s, V, P, W, o, k) proof
        assume ea
        obtain w3 v3 mem3, rs3 ru3 we3 vo3 from ea
        have ru := mp(all_elim(red, {exc(w3, exc_val("at_main", empty))}), ru3)
        have st: tr.stv(b, P, W, o) by defs(ex_intro({x}, {w3}, {v3}, {mem3}, taut(oe, rs3, ru, we3, vo3)), tr.stv)
        show by defs(taut(st, kk), tr.mtv)
      qed
      have a2: (ex e x3. e in univ(1) && !(e = exc_val("stack_overflow", empty)) && abi.nstop(e) && abi.raise_state(x3) &&
          runs(p2, w2, exc(x3, e))) -> tr.mtv(b, s, V, P, W, o, k) proof
        assume eb
        obtain e x3, eu en ea rs3 ru3 from eb
        have ru := mp(all_elim(red, {exc(x3, e)}), ru3)
        have ub: tr.ub(s, V, P, W) by defs(ex_intro({e}, {x3}, taut(eu, en, ea, rs3, ru)), tr.ub)
        show by defs(taut(ub), tr.mtv)
      qed
      show by taut(expand(hat, tr.at_tm), a1, a2)
    qed
    show by taut(g, k1, k2, k3, k4, all_elim(tr.xo_ok, {P}, {W}, {x}, {empty}))
  qed
  show by taut(rdk, c1, c2, c3)
qed

// (the main mode's relation at t: tr.at_t)
theorem tr.at_tm_t: all zb pb wb. tr.at_t(zb, pb, wb) <-> tr.at_tm(true, zb, pb, wb)
proof
  fix zb pb wb
  have a: (ex w2 v2 mem2. abi.raise_state(w2) && runs(pb, wb, exc(w2, exc_val("at_main", empty))) && w2 = abi.view(zb, v2, mem2) && abi.view_ok(zb, v2, mem2)) ->
      (ex w2 v2 mem2. abi.raise_state(w2) && runs(pb, wb, exc(w2, exc_val("at_main", empty))) && w2 = tr.vw(true, zb, v2, mem2) && tr.vok(true, zb, v2, mem2)) proof
    assume e
    obtain w2 v2 mem2, h1 h2 h3 h4 from e
    have h3b := rewrite(sym(all_elim(tr.vw_t, {zb}, {v2}, {mem2})), h3)
    have h4b: tr.vok(true, zb, v2, mem2) by taut(all_elim(tr.vok_t, {zb}, {v2}, {mem2}), h4)
    show by ex_intro({w2}, {v2}, {mem2}, taut(h1, h2, h3b, h4b))
  qed
  have b: (ex w2 v2 mem2. abi.raise_state(w2) && runs(pb, wb, exc(w2, exc_val("at_main", empty))) && w2 = tr.vw(true, zb, v2, mem2) && tr.vok(true, zb, v2, mem2)) ->
      (ex w2 v2 mem2. abi.raise_state(w2) && runs(pb, wb, exc(w2, exc_val("at_main", empty))) && w2 = abi.view(zb, v2, mem2) && abi.view_ok(zb, v2, mem2)) proof
    assume e
    obtain w2 v2 mem2, h1 h2 h3 h4 from e
    have h3b := rewrite(all_elim(tr.vw_t, {zb}, {v2}, {mem2}), h3)
    have h4b: abi.view_ok(zb, v2, mem2) by taut(all_elim(tr.vok_t, {zb}, {v2}, {mem2}), h4)
    show by ex_intro({w2}, {v2}, {mem2}, taut(h1, h2, h3b, h4b))
  qed
  show by defs(taut(a, b), tr.at_t, tr.at_tm)
qed

// (the main mode's match: the generic one's)
theorem tr.mt_of: all spec args objs mem s o k. tr.matches_tk(spec, args, objs, mem, s, o, k) ->
  tr.mtv(true, s, abi.wob(objs, tr.cbm(true, s.fs_base)), spec[args], tr.vw(true, s, objs, mem), o, k)
proof
  fix spec args objs mem s o k
  assume h
  let V := abi.wob(objs, tr.cbm(true, s.fs_base))
  let W := tr.vw(true, s, objs, mem)
  let P := spec[args]
  have we := all_elim(tr.vw_t, {s}, {objs}, {mem})
  have ce := all_elim(tr.cbm_t, {s.fs_base})
  have m := expand(h, tr.matches_tk, tr.matches_t)
  // undefined
  have k1: abi.raises_at(spec, args, objs, mem, s) -> tr.mtv(true, s, V, P, W, o, k) proof
    assume r
    obtain e x, eu en ea rs ru from expand(r, abi.raises_at)
    have ru2 := rewrite(sym(we), ru)
    have u: tr.ub(s, V, P, W) by defs(ex_intro({e}, {x}, taut(eu, en, ea, rs, ru2)), tr.ub)
    show by defs(taut(u), tr.mtv)
  qed
  // a return
  have k2: (ex m1 w2. o = ok(m1, empty) && m1 in x86_64_linux.Machine && m1 in univ(1) &&
      runs(spec[args], abi.view(s, objs, mem), ok(w2, pair(m1.gpr[0], m1.gpr[2]))) && w2 in abi.World && w2 in univ(1) &&
      abi.world_matches(s.vm, m1.vm, w2.vm, abi.wob(objs, w2.objs.c_bytes), s.fs_base, abi.sp(s)) && m1.os = w2.os && m1.fs_base = s.fs_base &&
      m1.cpu = s.cpu && m1.gs_base = s.gs_base && m1.rip = abi.ret(s) && m1.gpr[4] = abi.sp(s) &&
      abi.callee_saved(m1, s) && !m1.flags.df) -> tr.mtv(true, s, V, P, W, o, k) proof
    assume e
    obtain m1 w2, h2 from e
    have wm: abi.world_matches(s.vm, m1.vm, w2.vm, abi.wob(objs, w2.objs.c_bytes), s.fs_base, abi.sp(s)) by taut(h2)
    have {c_bytes} := wm
    have cb: w2.objs.c_bytes = V.c_bytes by simp(c_bytes, ce)
    have wmc0 := apply(tr.wm_wmc, wm)
    have wmc: tr.wmc(s.vm, m1.vm, w2.vm, abi.wob(V.live, w2.objs.c_bytes), s.fs_base, abi.sp(s)) by simp(wmc0, keep(tr.wmc, abi.canary))
    have ru0: runs(spec[args], abi.view(s, objs, mem), ok(w2, pair(m1.gpr[0], m1.gpr[2]))) by taut(h2)
    have ru: runs(P, W, ok(w2, pair(m1.gpr[0], m1.gpr[2]))) := rewrite(sym(we), ru0)
    have fs: m1.fs_base = s.fs_base by taut(h2)
    have f1: true -> m1.fs_base = s.fs_base by taut(fs)
    have f2: !true -> m1.fs_base = w2.fs_base by taut()
    have ww: w2 in abi.World && w2 in univ(1) by taut(h2)
    have os: m1.os = w2.os by taut(h2)
    have e3: ex w3. runs(P, W, ok(w3, pair(m1.gpr[0], m1.gpr[2]))) && w3 in abi.World && w3 in univ(1) &&
        tr.wmc(s.vm, m1.vm, w3.vm, abi.wob(V.live, w3.objs.c_bytes), s.fs_base, abi.sp(s)) && m1.os = w3.os &&
        w3.objs.c_bytes = V.c_bytes && (true -> m1.fs_base = s.fs_base) && (!true -> m1.fs_base = w3.fs_base) by ex_intro({w2}, taut(ww, os, ru, wmc, cb, f1, f2))
    have mM: m1 in x86_64_linux.Machine && m1 in univ(1) by taut(h2)
    have rc: m1.cpu = s.cpu && m1.gs_base = s.gs_base && m1.rip = abi.ret(s) && m1.gpr[4] = abi.sp(s) && abi.callee_saved(m1, s) && !m1.flags.df by taut(h2)
    have oe: o = ok(m1, empty) by taut(h2)
    have rv: tr.rtv(true, s, V, P, W, m1) by defs(taut(mM, rc, e3), tr.rtv)
    have e5: ex m2. o = ok(m2, empty) && tr.rtv(true, s, V, P, W, m2) by ex_intro({m1}, taut(oe, rv))
    show by defs(taut(e5), tr.mtv)
  qed
  // a crash
  have k3: tr.crashes_t(spec, args, objs, mem, s, o) -> tr.mtv(true, s, V, P, W, o, k) proof
    assume c
    obtain m1 a k0, {oe, m1M, ab, sev, ovk} from expand(c, tr.crashes_t)
    have {input, events} := ovk
    have i2: s.os.input = m1.os.input by simp(input)
    have ev2 := rewrite(sym(we), events)
    have we2: W.os.events = s.os.events by simp()
    have ev3 := rewrite(we2, ev2)
    have io: tr.ovf(P, W, m1.os) || s.os.events = m1.os.events by taut(ev3)
    have cr: tr.crash(s, P, W, o) by defs(ex_intro({m1}, {a}, {k0}, taut(oe, m1M, ab, sev, i2, io)), tr.crash)
    show by defs(taut(cr), tr.mtv)
  qed
  // a divergence
  have k4: tr.div(spec[args], abi.view(s, objs, mem), o) -> tr.mtv(true, s, V, P, W, o, k) proof
    assume d
    have d2: tr.div(P, W, o) := rewrite(sym(we), d)
    show by defs(taut(d2), tr.mtv)
  qed
  // the stop
  have k5: k && tr.stop_t(spec, args, objs, mem, s, o) -> tr.mtv(true, s, V, P, W, o, k) proof
    assume kst
    have kk st := kst
    obtain m2 w3 v3 mem3, oe rs ru we3 vo from expand(st, tr.stop_t)
    have ru2 := rewrite(sym(we), ru)
    have we4 := rewrite(sym(all_elim(tr.vw_t, {m2}, {v3}, {mem3})), we3)
    have vo2: tr.vok(true, m2, v3, mem3) by taut(all_elim(tr.vok_t, {m2}, {v3}, {mem3}), vo)
    have sv: tr.stv(true, P, W, o) by defs(ex_intro({m2}, {w3}, {v3}, {mem3}, taut(oe, rs, ru2, we4, vo2)), tr.stv)
    show by defs(taut(sv, kk), tr.mtv)
  qed
  // an exit
  have k6: tr.xo(spec[args], abi.view(s, objs, mem), o) -> tr.mtv(true, s, V, P, W, o, k) proof
    assume x
    have x2: tr.xo(P, W, o) := rewrite(sym(we), x)
    show by defs(taut(x2), tr.mtv)
  qed
  show by taut(m, k1, k2, k3, k4, k5, k6)
qed

// (... and back: the generic match in the main mode, the main mode's)
theorem tr.mt_to: all spec args objs mem s o k. tr.mtv(true, s, abi.wob(objs, abi.cbytes0(s.fs_base)), spec[args], abi.view(s, objs, mem), o, k) ->
  tr.matches_tk(spec, args, objs, mem, s, o, k)
proof
  fix spec args objs mem s o k
  assume h
  let V := abi.wob(objs, abi.cbytes0(s.fs_base))
  let W := abi.view(s, objs, mem)
  let P := spec[args]
  have m := expand(h, tr.mtv)
  // undefined
  have k1: tr.ub(s, V, P, W) -> tr.matches_tk(spec, args, objs, mem, s, o, k) proof
    assume u
    show by defs(taut(apply(tr.ub_at, u)), tr.matches_tk, tr.matches_t)
  qed
  // a crash
  have k2: tr.crash(s, P, W, o) -> tr.matches_tk(spec, args, objs, mem, s, o, k) proof
    assume c
    show by defs(taut(apply(tr.crash_at, c)), tr.matches_tk, tr.matches_t)
  qed
  // a divergence
  have k3: tr.div(P, W, o) -> tr.matches_tk(spec, args, objs, mem, s, o, k) proof
    assume d
    show by defs(taut(d), tr.matches_tk, tr.matches_t)
  qed
  // a return
  have k4: (ex m1. o = ok(m1, empty) && tr.rtv(true, s, V, P, W, m1)) -> tr.matches_tk(spec, args, objs, mem, s, o, k) proof
    assume e
    obtain m1, oe rv from e
    have mM mu ew rc0 rc1 rc2 rc3 rc4 rc5 := expand(rv, tr.rtv)
    obtain w2, hr2 w2W w2u wmc os cb f1 _ from ew
    have cb2: w2.objs.c_bytes = abi.cbytes0(s.fs_base) by simp(cb)
    have wmc2: tr.wmc(s.vm, m1.vm, w2.vm, abi.wob(objs, abi.cbytes0(s.fs_base)), s.fs_base, abi.sp(s)) by simp(rewrite(cb2, wmc), keep(tr.wmc))
    have wm := rewrite(sym(cb2), apply(tr.wmc_wm, wmc2))
    have fs: m1.fs_base = s.fs_base := mp(f1, (true by taut()))
    have e1: ex m2 w3. o = ok(m2, empty) && m2 in x86_64_linux.Machine && m2 in univ(1) &&
        runs(spec[args], abi.view(s, objs, mem), ok(w3, pair(m2.gpr[0], m2.gpr[2]))) && w3 in abi.World && w3 in univ(1) &&
        abi.world_matches(s.vm, m2.vm, w3.vm, abi.wob(objs, w3.objs.c_bytes), s.fs_base, abi.sp(s)) && m2.os = w3.os && m2.fs_base = s.fs_base &&
        m2.cpu = s.cpu && m2.gs_base = s.gs_base && m2.rip = abi.ret(s) && m2.gpr[4] = abi.sp(s) &&
        abi.callee_saved(m2, s) && !m2.flags.df
      by ex_intro({m1}, {w2}, taut(oe, mM, mu, hr2, w2W, w2u, wm, os, fs, rc0, rc1, rc2, rc3, rc4, rc5))
    show by defs(taut(e1), tr.matches_tk, tr.matches_t)
  qed
  // the stop
  have k5: k && tr.stv(true, P, W, o) -> tr.matches_tk(spec, args, objs, mem, s, o, k) proof
    assume kst
    have kk st := kst
    obtain m2 w3 v3 mem3, oe rs ru we3 vo from expand(st, tr.stv)
    have we4 := rewrite(all_elim(tr.vw_t, {m2}, {v3}, {mem3}), we3)
    have vo2: abi.view_ok(m2, v3, mem3) by taut(all_elim(tr.vok_t, {m2}, {v3}, {mem3}), vo)
    have sv: tr.stop_t(spec, args, objs, mem, s, o) by defs(ex_intro({m2}, {w3}, {v3}, {mem3}, taut(oe, rs, ru, we4, vo2)), tr.stop_t)
    show by defs(taut(sv, kk), tr.matches_tk)
  qed
  have k6: tr.xo(P, W, o) -> tr.matches_tk(spec, args, objs, mem, s, o, k) proof
    assume x
    show by defs(taut(x), tr.matches_tk, tr.matches_t)
  qed
  show by taut(m, k1, k2, k3, k4, k5, k6)
qed

// (the main mode's contract: the generic one's)
theorem tr.impl_of: all f spec t k base code statics. tr.implements_stop(f, spec, t, k, base, code, statics) -> tr.impl_m(true, false, f, spec, t, k, base, code, statics)
proof
  fix f spec t k base code statics
  assume h
  have g: all args objs mem s o. args in abi.ARGS -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(s.vm, base, code, statics) ->
      s.rip = f -> tr.eok(true, false, s, args) -> tr.objs_ok(s, objs) -> tr.vok(true, s, objs, mem) -> tr.run_s(s, t, s, o) ->
      tr.mtv(true, s, abi.wob(objs, tr.cbm(true, s.fs_base)), spec[args], tr.vw(true, s, objs, mem), o, k) proof
    fix args objs mem s o
    assume h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 h11
    have eo: abi.entry_ok(s, args) by taut(all_elim(tr.eok_t, {s}, {args}), h4, h8)
    have vo: abi.view_ok(s, objs, mem) by taut(all_elim(tr.vok_t, {s}, {objs}, {mem}), h10)
    have mt := mp(all_elim(expand(h, tr.implements_stop), {args}, {objs}, {mem}, {s}, {o}), h1, h2, h3, h4, h5, h6, h7, eo, h9, vo, h11)
    show := apply(tr.mt_of, mt)
  qed
  show by defs(g, tr.impl_m)
qed

// (a run matching P matches Q when Q has all of P's runs: each case -- a
// raise, a crash, a divergence, a return, the stop -- is of P's runs)
theorem tr.mtv_mono: all b s V P Q W o k. (all x. runs(P, W, x) -> runs(Q, W, x)) -> tr.mtv(b, s, V, P, W, o, k) -> tr.mtv(b, s, V, Q, W, o, k)
proof
  fix b s V P Q W o k
  assume hr mt
  show by defs(simp(hr, expand(mt, tr.mtv, tr.ub, tr.crash, tr.ovf, tr.div, tr.rtv, tr.stv, tr.xo)), tr.mtv, tr.ub, tr.crash, tr.ovf, tr.div, tr.rtv, tr.stv, tr.xo)
qed

// Composition in either mode (as tr.implements_refine): the machine code
// implementing F, F refining S for the ABI's arguments and every world --
// the machine code implements S
theorem tr.impl_m_refine: all b u f F S t k base code statics. tr.impl_m(b, u, f, F, t, k, base, code, statics) ->
  (all regs w o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> w in abi.World -> runs(F[regs], w, o) -> runs(S[regs], w, o)) ->
  tr.impl_m(b, u, f, S, t, k, base, code, statics)
proof
  fix b u f F S t k base code statics
  assume hi hc
  have g: all args objs mem s o. args in abi.ARGS -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(s.vm, base, code, statics) ->
      s.rip = f -> tr.eok(b, u, s, args) -> tr.objs_ok(s, objs) -> tr.vok(b, s, objs, mem) -> tr.run_s(s, t, s, o) ->
      tr.mtv(b, s, abi.wob(objs, tr.cbm(b, s.fs_base)), S[args], tr.vw(b, s, objs, mem), o, k) proof
    fix args objs mem s o
    assume hA hvo hmv hM su hl hrip he hob hvw hrd
    have m := mp(all_elim(expand(hi, tr.impl_m), {args}, {objs}, {mem}, {s}, {o}), hA, hvo, hmv, hM, su, hl, hrip, he, hob, hvw, hrd)
    // (the entry's world a world; the arguments the ABI's)
    have wu := apply(tr.vw_univ, {b}, {s}, {objs}, {mem}, su, hvo, hmv)
    have wt := apply(tr.vw_typed, {b}, {s}, {objs}, {mem}, hM, hvo, hmv, wu)
    have al: args in list_type(bits(64)) by simp(hA)
    have lo: seq_len(args) in omega by simp(al)
    have o6: ord_le(seq_len(args), 6) by simp(hA)
    have ll: int_le(seq_len(args), 6) by arith(expand(o6, ord_le), lo)
    have r: all x. runs(F[args], tr.vw(b, s, objs, mem), x) -> runs(S[args], tr.vw(b, s, objs, mem), x) proof
      fix x
      show := mp(all_elim(hc, {args}, {tr.vw(b, s, objs, mem)}, {x}), al, ll, wt)
    qed
    show := apply(tr.mtv_mono, r, m)
  qed
  show by defs(g, tr.impl_m)
qed

// ----------------------------------------------------------------------
//  A call in the stop form (as tr.run_split_k): the caller's run, its
//  breakpoints and t, from the callee's entry c

// (a stop run's outcome tagged 2: a divergence, by its loop)
theorem tr.rws_div: all c t l r. while_rel(l, x5. true, x5 x6. tr.rbs(c, t, x5, x6), x5. fn_update(empty, "os.events", fst(x5).os.events), r) -> fst(r) = 2 ->
  ex t0. r = diverge(t0)
proof
  fix c t l r
  assume hw d
  have cs := mp(while_cases[l0 := l, c := x5. true, b := x5 x6. tr.rbs(c, t, x5, x6), tr := x5. fn_update(empty, "os.events", fst(x5).os.events), r := r], hw)
  have b: (ex l2. (!true && r = ok(l2, empty)) || (true && tr.rbs(c, t, l2, r) && !is_ok(r))) -> ex t0. r = diverge(t0) proof
    assume e
    obtain l2, hl from e
    have hb: tr.rbs(c, t, l2, r) by taut(hl)
    show by simp(expand(hb, tr.rbs, tr.rbd, tr.rb, bind_rel), d, keep(x86_64_linux.step))
  qed
  show by taut(cs, b)
qed

def tr.at_stop_d(s, t, x) := tr.at_stop(s, t, x)

// The callee's stop run (to some outcome of the same kind), or the callee
// returns to x and the caller's passes go on from x, or the callee leaves
// its discipline, or it stops at x -- where the caller's run stops, its
// breakpoint (the callee's sp at most the caller's, no breakpoint of the
// caller below it but t)
theorem tr.run_split_ks(zb. bkp): all s c t o. s in x86_64_linux.Machine -> int_le(abi.sp(c), abi.sp(s)) -> int_lt(c.gpr[4], abi.sp(c)) -> !(c.rip = t) ->
  (all z. int_lt(z.gpr[4], abi.sp(c)) -> !bkp(z)) -> tr.run_k(s, zb. bkp(zb) || zb.rip = t, c, o) ->
  (ex o1. tr.run_s(c, t, c, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2))) ||
  (ex x r1 o1. tr.run_s(c, t, c, ok(x, empty)) && tr.rwk(s, zb. bkp(zb) || zb.rip = t, pair(x, empty), r1) && tr.rmap(r1, o1) &&
    (o1 = o || (fst(o1) = 2 && fst(o) = 2))) ||
  (ex x. tr.run_s(c, t, c, exc(x, exc_val("disc", empty)))) ||
  (ex x. tr.run_s(c, t, c, ok(x, exc_val("stop", empty))) && o = ok(x, empty) && tr.at_stop(c, t, x))
proof
  fix s c t o
  assume hM hsp hcl hct hbx hr
  let G := (ex o1. tr.run_s(c, t, c, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2))) ||
    (ex x r1 o1. tr.run_s(c, t, c, ok(x, empty)) && tr.rwk(s, zb. bkp(zb) || zb.rip = t, pair(x, empty), r1) && tr.rmap(r1, o1) &&
      (o1 = o || (fst(o1) = 2 && fst(o) = 2))) ||
    (ex x. tr.run_s(c, t, c, exc(x, exc_val("disc", empty)))) ||
    (ex x. tr.run_s(c, t, c, ok(x, exc_val("stop", empty))) && o = ok(x, empty) && tr.at_stop(c, t, x))
  let P(l) := !tr.at_ret(c, fst(l)) && int_lt(fst(l).gpr[4], abi.sp(c)) && !(fst(l).rip = t)
  let EB(l) := exc(pair(fst(l), empty), pair("brk", empty))
  let ES(l) := exc(l, pair("ret", exc_val("stop", empty)))
  let ED(l) := exc(l, pair("raise", exc_val("disc", empty)))
  let E(l) := ite(tr.at_ret_d(c, fst(l)), EB(l), ite(tr.at_stop_d(c, t, fst(l)), ES(l), ED(l)))
  let TR(l) := fn_update(empty, "os.events", fst(l).os.events)
  have r4 := apply(x86i.rsp_typed, hM)
  have spb: abi.sp(s) in bits(64) by simp(r4)
  obtain r, rk hm from expand(hr, tr.run_k)
  // (inside the callee, off t: the caller's pass, the callee's stop run's)
  have pb: all l o2. P(l) -> tr.rbk(s, zb. bkp(zb) || zb.rip = t, l, o2) -> tr.rbs(c, t, l, o2) proof
    fix l o2
    assume hp hb
    have nar lt nt := hp
    have lt2: int_lt(fst(l).gpr[4], abi.sp(s)) by arith(lt, hsp)
    have nb := mp(all_elim(hbx, {fst(l)}), lt)
    have ns: !tr.stopk(s, zb. bkp(zb) || zb.rip = t, fst(l)) by defs(taut(lt2, nb, nt), tr.stopk)
    have rs: tr.rst(l, o2) by taut(expand(hb, tr.rbk), ns)
    have dok: tr.disc_ok(c, fst(l)) by taut(lt)
    have rb: tr.rb(c, l, o2) by defs(taut(nar, expand(rs, tr.rst)), tr.rb)
    have rd: tr.rbd(c, l, o2) by defs(taut(dok, rb), tr.rbd)
    show by defs(taut(nt, rd), tr.rbs)
  qed
  // (the first pass, from c: the callee's)
  have pc: P(pair(c, empty)) proof
    have ne: c.gpr[4] = abi.sp(c) -> false proof
      assume e
      show by arith(e, hcl)
    qed
    have nar: !tr.at_ret(c, c) by taut(ne)
    show by simp(nar, hcl, hct)
  qed
  have p0: all o2. tr.rst(pair(c, empty), o2) -> tr.rbs(c, t, pair(c, empty), o2) proof
    fix o2
    assume hs
    have nar lt nt := pc
    have dok: tr.disc_ok(c, fst(pair(c, empty))) by taut(lt)
    have rb: tr.rb(c, pair(c, empty), o2) by defs(taut(nar, expand(hs, tr.rst)), tr.rb)
    have rd: tr.rbd(c, pair(c, empty), o2) by defs(taut(dok, rb), tr.rbd)
    show by defs(taut(nt, rd), tr.rbs)
  qed
  have he: all l. !is_ok(E(l)) proof
    fix l
    have n: is_ok(E(l)) -> false proof
      assume h
      obtain a b, h2 from expand(h, is_ok)
      have c1: tr.at_ret_d(c, fst(l)) -> false proof
        assume ar
        have et := apply(tr.ite_t, {tr.at_ret_d(c, fst(l))}, {EB(l)}, {ite(tr.at_stop_d(c, t, fst(l)), ES(l), ED(l))}, ar)
        show by simp(rewrite(et, h2))
      qed
      have c2: !tr.at_ret_d(c, fst(l)) -> false proof
        assume nar
        have ef := apply(tr.ite_f, {tr.at_ret_d(c, fst(l))}, {EB(l)}, {ite(tr.at_stop_d(c, t, fst(l)), ES(l), ED(l))}, nar)
        have h3 := rewrite(ef, h2)
        have d1: tr.at_stop_d(c, t, fst(l)) -> false proof
          assume as
          have e2 := apply(tr.ite_t, {tr.at_stop_d(c, t, fst(l))}, {ES(l)}, {ED(l)}, as)
          show by simp(rewrite(e2, h3))
        qed
        have d2: !tr.at_stop_d(c, t, fst(l)) -> false proof
          assume nas
          have e2 := apply(tr.ite_f, {tr.at_stop_d(c, t, fst(l))}, {ES(l)}, {ED(l)}, nas)
          show by simp(rewrite(e2, h3))
        qed
        show by taut(d1, d2)
      qed
      show by taut(c1, c2)
    qed
    show by taut(n)
  qed
  // the first pass leaves: the callee's run
  have k2: tr.rst(pair(c, empty), r) && !is_ok(r) -> G proof
    assume e
    have rb := mp(all_elim(p0, {r}), e.1)
    have tt: true by taut()
    have w := mp(while_leave[l0 := pair(c, empty), c := x5. true, b := x5 x6. tr.rbs(c, t, x5, x6), tr := x5. TR(x5), r := r], tt, rb, e.2)
    have ws: tr.rws(c, t, pair(c, empty), r) by defs(w, tr.rws)
    have rs: tr.run_s(c, t, c, o) by defs(ex_intro({r}, taut(ws, hm)), tr.run_s)
    have e1: ex o1. tr.run_s(c, t, c, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2)) by ex_intro({o}, taut(rs, refl({o})))
    show by taut(e1)
  qed
  // the first pass goes on to l1: the passes from l1, cut where the callee
  // returns, leaves its discipline or stops
  have k1: (ex l1. tr.rst(pair(c, empty), ok(l1, empty)) && tr.rwk(s, zb. bkp(zb) || zb.rip = t, l1, r)) -> G proof
    assume e
    obtain l1, rs0 rw from e
    have rb0 := mp(all_elim(p0, {ok(l1, empty)}), rs0)
    have tt: true by taut()
    have q1: l1 = pair(fst(l1), empty) by simp(expand(rs0, tr.rst), keep(x86_64_linux.step))
    have hq: all l l2. l = pair(fst(l), empty) -> tr.rbk(s, zb. bkp(zb) || zb.rip = t, l, ok(l2, empty)) -> l2 = pair(fst(l2), empty) proof
      fix l l2
      assume _ hb
      have c3 := apply(tr.rbk_ok[bkp := zb. bkp(zb) || zb.rip = t], {s}, {l}, {l2}, {empty}, hb)
      show by taut(c3)
    qed
    have sp := mp(while_split[l0 := l1, b := l o2. tr.rbk(s, zb. bkp(zb) || zb.rip = t, l, o2), tr := l. TR(l), p := l. P(l), e := l. E(l), r := r,
      q := l. l = pair(fst(l), empty)], he, q1, hq, expand(rw, tr.rwk))
    // the guarded passes: the callee's
    have gb: all l o2. (P(l) && tr.rbk(s, zb. bkp(zb) || zb.rip = t, l, o2)) || (!P(l) && o2 = E(l)) -> tr.rbs(c, t, l, o2) proof
      fix l o2
      assume h
      have in: P(l) -> tr.rbs(c, t, l, o2) proof
        assume hp
        have b1: tr.rbk(s, zb. bkp(zb) || zb.rip = t, l, o2) by taut(h, hp)
        show := mp(all_elim(pb, {l}, {o2}), hp, b1)
      qed
      have out: !P(l) -> tr.rbs(c, t, l, o2) proof
        assume np
        have eo: o2 = E(l) by taut(h, np)
        have c1: tr.at_ret_d(c, fst(l)) -> tr.rbs(c, t, l, o2) proof
          assume ar
          have et := apply(tr.ite_t, {tr.at_ret_d(c, fst(l))}, {EB(l)}, {ite(tr.at_stop_d(c, t, fst(l)), ES(l), ED(l))}, ar)
          have eo2 := rewrite(et, eo)
          have ar2: tr.at_ret(c, fst(l)) by defs(ar, tr.at_ret_d)
          have rd: tr.rbd(c, l, o2) by defs(simp(eo2, ar2, keep(x86_64_linux.step)), tr.rbd, tr.rb)
          have ns: !tr.at_stop(c, t, fst(l)) by taut(ar2)
          show by defs(taut(ns, rd), tr.rbs)
        qed
        have c2: !tr.at_ret_d(c, fst(l)) -> tr.rbs(c, t, l, o2) proof
          assume nar
          have ef := apply(tr.ite_f, {tr.at_ret_d(c, fst(l))}, {EB(l)}, {ite(tr.at_stop_d(c, t, fst(l)), ES(l), ED(l))}, nar)
          have eo2 := rewrite(ef, eo)
          have nar2: !tr.at_ret(c, fst(l)) by defs(nar, tr.at_ret_d)
          have d1: tr.at_stop_d(c, t, fst(l)) -> tr.rbs(c, t, l, o2) proof
            assume as
            have e2 := apply(tr.ite_t, {tr.at_stop_d(c, t, fst(l))}, {ES(l)}, {ED(l)}, as)
            have eo3 := rewrite(e2, eo2)
            have as2: tr.at_stop(c, t, fst(l)) by defs(as, tr.at_stop_d)
            show by defs(taut(as2, eo3), tr.rbs)
          qed
          have d2: !tr.at_stop_d(c, t, fst(l)) -> tr.rbs(c, t, l, o2) proof
            assume nas
            have e2 := apply(tr.ite_f, {tr.at_stop_d(c, t, fst(l))}, {ES(l)}, {ED(l)}, nas)
            have eo3 := rewrite(e2, eo2)
            have nas2: !tr.at_stop(c, t, fst(l)) by defs(nas, tr.at_stop_d)
            have nlt: !int_lt(fst(l).gpr[4], abi.sp(c)) by taut(np, nar2, nas2)
            have rd: tr.rbd(c, l, o2) by defs(simp(eo3, nar2, nlt, keep(x86_64_linux.step)), tr.rbd, tr.rb)
            show by defs(taut(nas2, rd), tr.rbs)
          qed
          show by taut(d1, d2)
        qed
        show by taut(c1, c2)
      qed
      show by taut(in, out)
    qed
    // throughout: the callee's run (the first pass prepended)
    have ca: while_rel(l1, l. true, l o2. (P(l) && tr.rbk(s, zb. bkp(zb) || zb.rip = t, l, o2)) || (!P(l) && o2 = E(l)), l. TR(l), r) -> G proof
      assume w
      have w2 := mp(while_mono[l0 := l1, c := l. true, b1 := l o2. (P(l) && tr.rbk(s, zb. bkp(zb) || zb.rip = t, l, o2)) || (!P(l) && o2 = E(l)),
        b2 := l o2. tr.rbs(c, t, l, o2), tr := l. TR(l), r := r], gb, w)
      have nd: !(fst(r) = 2) -> G proof
        assume n
        have w3 := mp(while_step[l0 := pair(c, empty), l1 := l1, c := l. true, b := l o2. tr.rbs(c, t, l, o2), tr := l. TR(l), r := r], tt, rb0, w2, n)
        have ws: tr.rws(c, t, pair(c, empty), r) by defs(w3, tr.rws)
        have rs: tr.run_s(c, t, c, o) by defs(ex_intro({r}, taut(ws, hm)), tr.run_s)
        have e1: ex o1. tr.run_s(c, t, c, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2)) by ex_intro({o}, taut(rs, refl({o})))
        show by taut(e1)
      qed
      have dd: fst(r) = 2 -> G proof
        assume d
        obtain t0, rd0 from apply(tr.rws_div, {c}, {t}, {l1}, {r}, w2, d)
        have w2d := rewrite(rd0, w2)
        obtain t2, w3 from mp(while_step_div[l0 := pair(c, empty), l1 := l1, c := l. true, b := l o2. tr.rbs(c, t, l, o2), tr := l. TR(l), t := t0], tt, rb0, w2d)
        have ws: tr.rws(c, t, pair(c, empty), diverge(t2)) by defs(w3, tr.rws)
        have rm2: tr.rmap(diverge(t2), diverge(t2)) by defs(simp(), tr.rmap)
        have rs: tr.run_s(c, t, c, diverge(t2)) by defs(ex_intro({diverge(t2)}, taut(ws, rm2)), tr.run_s)
        have od: fst(o) = 2 by simp(expand(hm, tr.rmap), d)
        have f2: fst(diverge(t2)) = 2 by simp()
        have e1: ex o1. tr.run_s(c, t, c, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2)) by ex_intro({diverge(t2)}, taut(rs, f2, od))
        show by taut(e1)
      qed
      show by taut(nd, dd)
    qed
    // left at l: the callee's return (the caller's passes on from it), its
    // leaving the discipline, or its stop (the caller's breakpoint)
    have cb: (ex l. l = pair(fst(l), empty) && while_rel(l1, l. true, l o2. (P(l) && tr.rbk(s, zb. bkp(zb) || zb.rip = t, l, o2)) || (!P(l) && o2 = E(l)), l. TR(l), E(l)) &&
        (ex r1. while_rel(l, l. true, l o2. tr.rbk(s, zb. bkp(zb) || zb.rip = t, l, o2), l. TR(l), r1) && fst(r1) = fst(r) && (!(fst(r) = 2) -> r1 = r))) -> G proof
      assume h
      obtain l, ql wg er1 from h
      have w2 := mp(while_mono[l0 := l1, c := l. true, b1 := l o2. (P(l) && tr.rbk(s, zb. bkp(zb) || zb.rip = t, l, o2)) || (!P(l) && o2 = E(l)),
        b2 := l o2. tr.rbs(c, t, l, o2), tr := l. TR(l), r := E(l)], gb, wg)
      have nd0: fst(E(l)) = 2 -> false proof
        assume d
        have ne := all_elim(he, {l})
        have c1: fst(E(l)) = 2 -> !is_ok(E(l)) -> false proof
          assume d2 _
          have c3: tr.at_ret_d(c, fst(l)) -> false proof
            assume ar
            have et := apply(tr.ite_t, {tr.at_ret_d(c, fst(l))}, {EB(l)}, {ite(tr.at_stop_d(c, t, fst(l)), ES(l), ED(l))}, ar)
            show by simp(rewrite(et, d2))
          qed
          have c4: !tr.at_ret_d(c, fst(l)) -> false proof
            assume nar
            have ef := apply(tr.ite_f, {tr.at_ret_d(c, fst(l))}, {EB(l)}, {ite(tr.at_stop_d(c, t, fst(l)), ES(l), ED(l))}, nar)
            have d3 := rewrite(ef, d2)
            have d5: tr.at_stop_d(c, t, fst(l)) -> false proof
              assume as
              have e2 := apply(tr.ite_t, {tr.at_stop_d(c, t, fst(l))}, {ES(l)}, {ED(l)}, as)
              show by simp(rewrite(e2, d3))
            qed
            have d6: !tr.at_stop_d(c, t, fst(l)) -> false proof
              assume nas
              have e2 := apply(tr.ite_f, {tr.at_stop_d(c, t, fst(l))}, {ES(l)}, {ED(l)}, nas)
              show by simp(rewrite(e2, d3))
            qed
            show by taut(d5, d6)
          qed
          show by taut(c3, c4)
        qed
        show by taut(c1, d, ne)
      qed
      have w3 := mp(while_step[l0 := pair(c, empty), l1 := l1, c := l. true, b := l o2. tr.rbs(c, t, l, o2), tr := l. TR(l), r := E(l)], tt, rb0, w2, taut(nd0))
      have wd: tr.rws(c, t, pair(c, empty), E(l)) by defs(w3, tr.rws)
      // (the return)
      have c1: tr.at_ret_d(c, fst(l)) -> G proof
        assume ar
        have ee := apply(tr.ite_t, {tr.at_ret_d(c, fst(l))}, {EB(l)}, {ite(tr.at_stop_d(c, t, fst(l)), ES(l), ED(l))}, ar)
        have wd2 := rewrite(ee, wd)
        have rm: tr.rmap(EB(l), ok(fst(l), empty)) by defs(simp(), tr.rmap)
        have rc: tr.run_s(c, t, c, ok(fst(l), empty)) by defs(ex_intro({EB(l)}, taut(wd2, rm)), tr.run_s)
        obtain r1, wr1 f4 re4 from er1
        have wr2 := rewrite(ql, wr1)
        have wk: tr.rwk(s, zb. bkp(zb) || zb.rip = t, pair(fst(l), empty), r1) by defs(wr2, tr.rwk)
        have same: !(fst(r) = 2) -> G proof
          assume n
          have re := mp(re4, n)
          have rm1 := rewrite(sym(re), hm)
          have e1: ex x r2 o1. tr.run_s(c, t, c, ok(x, empty)) && tr.rwk(s, zb. bkp(zb) || zb.rip = t, pair(x, empty), r2) && tr.rmap(r2, o1) &&
              (o1 = o || (fst(o1) = 2 && fst(o) = 2)) by ex_intro({fst(l)}, {r1}, {o}, taut(rc, wk, rm1, refl({o})))
          show by taut(e1)
        qed
        have div: fst(r) = 2 -> G proof
          assume d
          have d1: fst(r1) = 2 by simp(f4, d)
          have rm1: tr.rmap(r1, diverge(snd(r1))) by defs(simp(d1), tr.rmap)
          have od: fst(o) = 2 by simp(expand(hm, tr.rmap), d)
          have f2: fst(diverge(snd(r1))) = 2 by simp()
          have e1: ex x r2 o1. tr.run_s(c, t, c, ok(x, empty)) && tr.rwk(s, zb. bkp(zb) || zb.rip = t, pair(x, empty), r2) && tr.rmap(r2, o1) &&
              (o1 = o || (fst(o1) = 2 && fst(o) = 2)) by ex_intro({fst(l)}, {r1}, {diverge(snd(r1))}, taut(rc, wk, rm1, f2, od))
          show by taut(e1)
        qed
        show by taut(same, div)
      qed
      have c2: !tr.at_ret_d(c, fst(l)) -> G proof
        assume nar
        have ee := apply(tr.ite_f, {tr.at_ret_d(c, fst(l))}, {EB(l)}, {ite(tr.at_stop_d(c, t, fst(l)), ES(l), ED(l))}, nar)
        have wd2 := rewrite(ee, wd)
        // (the stop: the caller's run stops there, at t its breakpoint)
        have d1: tr.at_stop_d(c, t, fst(l)) -> G proof
          assume as
          have e2 := apply(tr.ite_t, {tr.at_stop_d(c, t, fst(l))}, {ES(l)}, {ED(l)}, as)
          have wd3 := rewrite(e2, wd2)
          have rm: tr.rmap(ES(l), ok(fst(l), exc_val("stop", empty))) by defs(simp(), tr.rmap)
          have rc: tr.run_s(c, t, c, ok(fst(l), exc_val("stop", empty))) by defs(ex_intro({ES(l)}, taut(wd3, rm)), tr.run_s)
          have as2: tr.at_stop(c, t, fst(l)) by defs(as, tr.at_stop_d)
          have xt: fst(l).rip = t by taut(as2)
          obtain r1, wr1 f4 re4 from er1
          have un3 := mp(while_unroll[l0 := l, c := x5. true, b := x5 x6. tr.rbk(s, zb. bkp(zb) || zb.rip = t, x5, x6), tr := x5. TR(x5), r := r1], wr1)
          have stk: tr.stopk(s, zb. bkp(zb) || zb.rip = t, fst(l)) by defs(taut(xt), tr.stopk)
          have bb: all o3. tr.rbk(s, zb. bkp(zb) || zb.rip = t, l, o3) -> o3 = exc(pair(fst(l), empty), pair("brk", empty)) proof
            fix o3
            assume hb
            show by taut(expand(hb, tr.rbk), stk)
          qed
          have v1: tr.rbk(s, zb. bkp(zb) || zb.rip = t, l, r1) && !is_ok(r1) -> o = ok(fst(l), empty) proof
            assume k
            have r1e := mp(all_elim(bb, {r1}), (tr.rbk(s, zb. bkp(zb) || zb.rip = t, l, r1) by taut(k)))
            have n1: !(fst(r1) = 2) by simp(r1e)
            have n0: !(fst(r) = 2) by simp(n1, f4)
            have re := mp(re4, n0)
            show by simp(expand(rewrite(r1e, rewrite(sym(re), hm)), tr.rmap))
          qed
          have v2: (ex l4. tr.rbk(s, zb. bkp(zb) || zb.rip = t, l, ok(l4, empty)) && (ex r4. while_rel(l4, x5. true, x5 x6. tr.rbk(s, zb. bkp(zb) || zb.rip = t, x5, x6),
              x5. TR(x5), r4) && fst(r4) = fst(r1) && (!(fst(r1) = 2) -> r4 = r1))) -> o = ok(fst(l), empty) proof
            assume k
            obtain l4, hb4 _ from k
            have r4e := mp(all_elim(bb, {ok(l4, empty)}), hb4)
            have f: false by simp(r4e)
            show by taut(f)
          qed
          have v0: (!true && r1 = ok(l, empty)) -> o = ok(fst(l), empty) proof
            assume k
            show by taut(k)
          qed
          have oe: o = ok(fst(l), empty) by taut(un3, v0, v1, v2)
          have e4: ex x. tr.run_s(c, t, c, ok(x, exc_val("stop", empty))) && o = ok(x, empty) && tr.at_stop(c, t, x) by ex_intro({fst(l)}, taut(rc, oe, as2))
          show by taut(e4)
        qed
        // (the discipline left)
        have d2: !tr.at_stop_d(c, t, fst(l)) -> G proof
          assume nas
          have e2 := apply(tr.ite_f, {tr.at_stop_d(c, t, fst(l))}, {ES(l)}, {ED(l)}, nas)
          have wd3 := rewrite(e2, wd2)
          have rm: tr.rmap(ED(l), exc(fst(l), exc_val("disc", empty))) by defs(simp(), tr.rmap)
          have rc: tr.run_s(c, t, c, exc(fst(l), exc_val("disc", empty))) by defs(ex_intro({ED(l)}, taut(wd3, rm)), tr.run_s)
          have e1: ex x. tr.run_s(c, t, c, exc(x, exc_val("disc", empty))) by ex_intro({fst(l)}, rc)
          show by taut(e1)
        qed
        show by taut(d1, d2)
      qed
      show by taut(c1, c2)
    qed
    show by taut(sp, ca, cb)
  qed
  show by taut(expand(rk, tr.rk), k1, k2)
qed

// ----------------------------------------------------------------------
//  The function at t (main): entered, the run stops

// (a run from t stops there at once)
theorem tr.run_s_at: all s t m o. m.rip = t -> !tr.at_ret(s, m) -> int_lt(m.gpr[4], abi.sp(s)) -> tr.run_s(s, t, m, o) -> o = ok(m, exc_val("stop", empty))
proof
  fix s t m o
  assume hr hna hlt h
  obtain r, hw hm from expand(h, tr.run_s)
  have u := mp(while_unroll[l0 := pair(m, empty), c := x5. true, b := x5 x6. tr.rbs(s, t, x5, x6), tr := x5. fn_update(empty, "os.events", fst(x5).os.events), r := r],
    expand(hw, tr.rws))
  // (the first pass: the stop)
  have st: all o2. tr.rbs(s, t, pair(m, empty), o2) -> o2 = exc(pair(m, empty), pair("ret", exc_val("stop", empty))) proof
    fix o2
    assume b
    have fe: fst(pair(m, empty)) = m by simp()
    show by taut(rewrite(fe, expand(b, tr.rbs)), hr, hna, hlt)
  qed
  have c2: tr.rbs(s, t, pair(m, empty), r) -> o = ok(m, exc_val("stop", empty)) proof
    assume b
    have re := mp(all_elim(st, {r}), b)
    show by simp(rewrite(re, expand(hm, tr.rmap)))
  qed
  have c3: (ex l1. tr.rbs(s, t, pair(m, empty), ok(l1, empty)) && (ex r1. while_rel(l1, x5. true, x5 x6. tr.rbs(s, t, x5, x6), x5. fn_update(empty, "os.events", fst(x5).os.events), r1) &&
      fst(r1) = fst(r) && (!(fst(r) = 2) -> r1 = r))) -> false proof
    assume e
    obtain l1, b _ from e
    have re := mp(all_elim(st, {ok(l1, empty)}), b)
    show by simp(re)
  qed
  show by taut(u, c2, c3)
qed


// (a step with the one outcome ok(m2), off the stop, below the entry's
// sp: the stop's run from m is its run from m2 -- a divergence some
// divergence)
theorem tr.run_s_det: all s t m m2 o. tr.run_s(s, t, m, o) -> int_lt(m.gpr[4], abi.sp(s)) -> !(m.rip = t) ->
  (all o2. runs(x86_64_linux.step(), m, o2) -> o2 = ok(m2, empty)) ->
  ex o1. tr.run_s(s, t, m2, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2))
proof
  fix s t m m2 o
  assume h hlt hnt hdet
  let G := ex o1. tr.run_s(s, t, m2, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2))
  let TR(x5) := fn_update(empty, "os.events", fst(x5).os.events)
  obtain r, hw hm from expand(h, tr.run_s)
  have ne: m.gpr[4] = abi.sp(s) -> false proof
    assume e
    have l2 := rewrite(e, hlt)
    show by arith(l2)
  qed
  have nar: !tr.at_ret(s, m) by taut(ne)
  // (the first pass: the step, to m2 only)
  have pb: all o2. tr.rbs(s, t, pair(m, empty), o2) -> o2 = ok(pair(m2, empty), empty) proof
    fix o2
    assume hb
    have b1: tr.rbd(s, pair(m, empty), o2) by simp(expand(hb, tr.rbs), hnt, nar, hlt, keep(x86_64_linux.step, tr.rbd))
    have b2: tr.rb(s, pair(m, empty), o2) by simp(expand(b1, tr.rbd), nar, hlt, keep(x86_64_linux.step, tr.rb))
    have b3: bind_rel(x86_64_linux.step, m, x7 x8. o2 = ok(pair(x7, empty), empty), x7 x8. o2 = exc(pair(x7, empty), pair("raise", x8)), x7. o2 = diverge(x7)) by simp(expand(b2, tr.rb), nar, keep(x86_64_linux.step))
    obtain o3, r3 c3 from expand(b3, bind_rel)
    have e3 := mp(all_elim(hdet, {o3}), r3)
    show by simp(rewrite(e3, c3))
  qed
  have un := mp(while_unroll[l0 := pair(m, empty), c := x5. true, b := x5 x6. tr.rbs(s, t, x5, x6), tr := x5. TR(x5), r := r], expand(hw, tr.rws))
  // (the pass leaving: not so, the step goes on)
  have u1: tr.rbs(s, t, pair(m, empty), r) && !is_ok(r) -> false proof
    assume e
    have er := mp(all_elim(pb, {r}), e.1)
    show by defs(simp(rewrite(er, e.2)), is_ok)
  qed
  have u2: (ex l1. tr.rbs(s, t, pair(m, empty), ok(l1, empty)) && (ex r1. while_rel(l1, x5. true, x5 x6. tr.rbs(s, t, x5, x6), x5. TR(x5), r1) &&
      fst(r1) = fst(r) && (!(fst(r) = 2) -> r1 = r))) -> G proof
    assume e
    obtain l1, rb0 er from e
    obtain r1, w1 f1 e1 from er
    have q1 := mp(all_elim(pb, {ok(l1, empty)}), rb0)
    have l1e: l1 = pair(m2, empty) by simp(q1)
    have w2 := rewrite(l1e, w1)
    have rw: tr.rws(s, t, pair(m2, empty), r1) by defs(w2, tr.rws)
    have nd: !(fst(r) = 2) -> G proof
      assume n
      have re := mp(e1, n)
      have rs: tr.run_s(s, t, m2, o) by defs(ex_intro({r1}, taut(rw, rewrite(sym(re), hm))), tr.run_s)
      show by ex_intro({o}, taut(rs, refl({o})))
    qed
    have dd: fst(r) = 2 -> G proof
      assume d
      have d1: fst(r1) = 2 by simp(f1, d)
      have rm1: tr.rmap(r1, diverge(snd(r1))) by defs(simp(d1), tr.rmap)
      have rs: tr.run_s(s, t, m2, diverge(snd(r1))) by defs(ex_intro({r1}, taut(rw, rm1)), tr.run_s)
      have od: fst(o) = 2 by simp(expand(hm, tr.rmap), d)
      have dd2: fst(diverge(snd(r1))) = 2 by simp()
      show by ex_intro({diverge(snd(r1))}, taut(rs, dd2, od))
    qed
    show by taut(nd, dd)
  qed
  show by taut(un, u1, u2)
qed

// (the entry's rip: neither the stop's run nor its outcomes read it)
theorem tr.run_s_rip: all s x t m o. tr.run_s(s, t, m, o) -> tr.run_s(fn_update(s, "rip", x), t, m, o)
proof
  fix s x t m o
  assume h
  let S2 := fn_update(s, "rip", x)
  have e1: S2.vm = s.vm by simp()
  have e2: S2.gpr = s.gpr by simp()
  have h1 := expand(h, tr.run_s, tr.rws, tr.rbs, tr.rbd, tr.rb)
  show by defs(rewrite(sym(e1), rewrite(sym(e2), h1)), tr.run_s, tr.rws, tr.rbs, tr.rbd, tr.rb)
qed

theorem tr.mtv_rip: all b s x V P W o k. tr.mtv(b, fn_update(s, "rip", x), V, P, W, o, k) -> tr.mtv(b, s, V, P, W, o, k)
proof
  fix b s x V P W o k
  assume h
  let S2 := fn_update(s, "rip", x)
  have e1: S2.vm = s.vm by simp()
  have e2: S2.gpr = s.gpr by simp()
  have e3: S2.os = s.os by simp()
  have e4: S2.cpu = s.cpu by simp()
  have e5: S2.gs_base = s.gs_base by simp()
  have e6: S2.fs_base = s.fs_base by simp()
  have h1 := expand(h, tr.mtv, tr.ub, tr.crash, tr.rtv)
  show by defs(rewrite(e1, rewrite(e2, rewrite(e3, rewrite(e4, rewrite(e5, rewrite(e6, h1)))))), tr.mtv, tr.ub, tr.crash, tr.rtv)
qed

// (a divergence's match: any other divergence's)
theorem tr.mtv_dv: all b s V P W o o2 k. (ex t. o = diverge(t)) -> (ex t. o2 = diverge(t)) -> tr.mtv(b, s, V, P, W, o, k) -> tr.mtv(b, s, V, P, W, o2, k)
proof
  fix b s V P W o o2 k
  assume h1 h2 hm
  obtain t1, e1 from h1
  have hm1 := rewrite(e1, expand(hm, tr.mtv, tr.crash, tr.div, tr.stv))
  have u: tr.ub(s, V, P, W) || (ex t2. runs(P, W, diverge(t2))) by simp(hm1, all_elim(tr.xo_div, {P}, {W}, {t1}), keep(tr.ub, tr.rtv))
  have d: tr.ub(s, V, P, W) -> tr.mtv(b, s, V, P, W, o2, k) proof
    assume h
    show by defs(taut(h), tr.mtv)
  qed
  have dv: (ex t2. runs(P, W, diverge(t2))) -> tr.mtv(b, s, V, P, W, o2, k) proof
    assume h
    have dd: tr.div(P, W, o2) by defs(taut(h2, h), tr.div)
    show by defs(taut(dd), tr.mtv)
  qed
  show by taut(u, d, dv)
qed

// A function whose code is `endbr64; jmp g` (gcc's frame_dummy): the
// contract of the code at g its own -- two steps, rip only
theorem tr.impl_m_jmp: all b u f f2 g r lb lc code statics spec t k.
  (all vm st. abi.loaded(vm, lb, lc, st) -> abi.loaded(vm, f, code, st)) ->
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, f, code) -> m.rip = f -> runs(x86_64_linux.exec_body(4, tag(155, empty)), m, o)) ->
  (all m o. runs(x86_64_linux.step(), m, o) -> abi.code_at(m.vm, f, code) -> m.rip = f2 -> runs(x86_64_linux.exec_body(5, tag(124, r)), m, o)) ->
  f2 = bits_add(64, f, 4) -> r in bits(32) -> g = bits_add(64, bits_add(64, f2, 5), bits_sext(32, 64, r)) -> !(f = t) -> !(f2 = t) ->
  tr.impl_m(b, u, g, spec, t, k, lb, lc, statics) -> tr.impl_m(b, u, f, spec, t, k, lb, lc, statics)
proof
  fix b u f f2 g r lb lc code statics spec t k
  assume hin ha1 ha2 hf2 hr hg hn1 hn2 himp
  have I := expand(himp, tr.impl_m)
  have G: all args objs mem s o. args in abi.ARGS -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) ->
      abi.loaded(s.vm, lb, lc, statics) -> s.rip = f -> tr.eok(b, u, s, args) -> tr.objs_ok(s, objs) -> tr.vok(b, s, objs, mem) -> tr.run_s(s, t, s, o) ->
      tr.mtv(b, s, abi.wob(objs, tr.cbm(b, s.fs_base)), spec[args], tr.vw(b, s, objs, mem), o, k) proof
    fix args objs mem s o
    assume hA ho hm hs hu hl hrip he hob hvk hrun
    have pt := apply(x86i.parts, hs)
    have cd: abi.code_at(s.vm, f, code) by simp(expand(mp(all_elim(hin, {s.vm}, {statics}), hl), abi.loaded), keep(abi.code_at))
    have st := apply(tr.eok_stack, {b}, {u}, {s}, {args}, hs, he)
    have slt: int_lt(s.gpr[4], 140737488355328) by taut(st)
    have r4 := apply(x86i.rsp_typed, hs)
    have lt := apply(tr.sp_lt, {s.gpr[4]}, r4, slt)
    let S1 := fn_update(s, "rip", f2)
    let S2 := fn_update(S1, "rip", g)
    have f2b: f2 in bits(64) by simp(hf2)
    have gb: g in bits(64) by simp(hg)
    have S1M: S1 in x86_64_linux.Machine by defs(simp(expand(hs, x86_64_linux.Machine), hu, f2b, pt), x86_64_linux.Machine)
    have S1U: S1 in univ(1) by simp(hu, f2b)
    have S2M: S2 in x86_64_linux.Machine by defs(simp(expand(hs, x86_64_linux.Machine), hu, gb, pt), x86_64_linux.Machine)
    have S2U: S2 in univ(1) by simp(hu, gb)
    // (endbr64: to S1 only; jmp: to S2 only)
    have d1: all o2. runs(x86_64_linux.step(), s, o2) -> o2 = ok(S1, empty) proof
      fix o2
      assume h2
      have e := mp(all_elim(ha1, {s}, {o2}), h2, cd, hrip)
      show by simp(apply(x86i.endbr64, hs, hu, e), hrip, hf2)
    qed
    have d2: all o2. runs(x86_64_linux.step(), S1, o2) -> o2 = ok(S2, empty) proof
      fix o2
      assume h2
      have e := mp(all_elim(ha2, {S1}, {o2}), h2, (abi.code_at(S1.vm, f, code) by simp(cd)), (S1.rip = f2 by simp()))
      show by simp(apply(x86i.jmp32, S1M, S1U, hr, e), hg)
    qed
    have nt1: !(s.rip = t) := rewrite(sym(hrip), hn1)
    obtain o1, r1 c1 from apply(tr.run_s_det, {s}, {t}, {s}, {S1}, {o}, hrun, lt, nt1, d1)
    have nt2: !(S1.rip = t) by simp(hn2)
    have lt1: int_lt(S1.gpr[4], abi.sp(s)) by simp(lt)
    obtain o3, r3 c3 from apply(tr.run_s_det, {s}, {t}, {S1}, {S2}, {o1}, r1, lt1, nt2, d2)
    // (the run from S2: its own entry's)
    have q1 := apply(tr.run_s_rip, {s}, {f2}, {t}, {S2}, {o3}, r3)
    have q2 := apply(tr.run_s_rip, {S1}, {g}, {t}, {S2}, {o3}, q1)
    have e1: S2.vm = s.vm by simp()
    have e2: S2.gpr = s.gpr by simp()
    have e3: S2.os = s.os by simp()
    have e4: S2.cpu = s.cpu by simp()
    have e6: S2.fs_base = s.fs_base by simp()
    have e7: S2.flags = s.flags by simp()
    have l2: abi.loaded(S2.vm, lb, lc, statics) := rewrite(sym(e1), hl)
    have eo2: tr.eok(b, u, S2, args) by defs(rewrite(sym(e1), rewrite(sym(e2), rewrite(sym(e6), rewrite(sym(e7), expand(he, tr.eok))))), tr.eok)
    have ob2: tr.objs_ok(S2, objs) by defs(rewrite(sym(e1), rewrite(sym(e2), expand(hob, tr.objs_ok))), tr.objs_ok)
    have vk2: tr.vok(b, S2, objs, mem) by defs(rewrite(sym(e1), rewrite(sym(e2), rewrite(sym(e6), expand(hvk, tr.vok)))), tr.vok)
    have m3 := mp(all_elim(I, {args}, {objs}, {mem}, {S2}, {o3}), hA, ho, hm, S2M, S2U, l2, (S2.rip = g by simp()), eo2, ob2, vk2, q2)
    have m4 := rewrite(e3, rewrite(e4, rewrite(e6, m3)))
    have m5 := apply(tr.mtv_rip, {b}, {S1}, {g}, {abi.wob(objs, tr.cbm(b, s.fs_base))}, {spec[args]}, {tr.vw(b, s, objs, mem)}, {o3}, {k}, m4)
    have m6 := apply(tr.mtv_rip, {b}, {s}, {f2}, {abi.wob(objs, tr.cbm(b, s.fs_base))}, {spec[args]}, {tr.vw(b, s, objs, mem)}, {o3}, {k}, m5)
    // (the outcome: o's, or a divergence as o)
    have same: o3 = o -> tr.mtv(b, s, abi.wob(objs, tr.cbm(b, s.fs_base)), spec[args], tr.vw(b, s, objs, mem), o, k) proof
      assume e
      show := rewrite(e, m6)
    qed
    have dv: fst(o3) = 2 -> fst(o) = 2 -> tr.mtv(b, s, abi.wob(objs, tr.cbm(b, s.fs_base)), spec[args], tr.vw(b, s, objs, mem), o, k) proof
      assume d3 d0
      have x3 := apply(tr.run_s_div, {S2}, {t}, {S2}, {o3}, q2, d3)
      have x0 := apply(tr.run_s_div, {s}, {t}, {s}, {o}, hrun, d0)
      show := apply(tr.mtv_dv, {b}, {s}, {abi.wob(objs, tr.cbm(b, s.fs_base))}, {spec[args]}, {tr.vw(b, s, objs, mem)}, {o3}, {o}, {k}, x3, x0, m6)
    qed
    have f1: fst(o1) = 2 -> fst(o) = 2 proof
      assume d
      have a1: o1 = o -> fst(o) = 2 proof
        assume e
        show := rewrite(e, d)
      qed
      show by taut(c1, a1)
    qed
    have f3: fst(o1) = 2 -> fst(o3) = 2 proof
      assume d
      have a1: o3 = o1 -> fst(o3) = 2 proof
        assume e
        show := rewrite(sym(e), d)
      qed
      show by taut(c3, a1)
    qed
    have eq: o3 = o1 -> o1 = o -> o3 = o proof
      assume x1 x2
      show := trans(x1, x2)
    qed
    show by taut(c1, c3, same, dv, f1, f3, eq)
  qed
  show by defs(G, tr.impl_m)
qed

// ----------------------------------------------------------------------
//  The contracts converted: one for any alignment (u) gives an aligned
//  call's; one never stopping (k false) gives one allowed to stop (k true)

theorem tr.impl_m_u: all b f spec t k base code statics. tr.impl_m(b, true, f, spec, t, k, base, code, statics) -> tr.impl_m(b, false, f, spec, t, k, base, code, statics)
proof
  fix b f spec t k base code statics
  assume h
  have i := expand(h, tr.impl_m)
  have g: all args objs mem s o. args in abi.ARGS -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(s.vm, base, code, statics) ->
      s.rip = f -> tr.eok(b, false, s, args) -> tr.objs_ok(s, objs) -> tr.vok(b, s, objs, mem) -> tr.run_s(s, t, s, o) ->
      tr.mtv(b, s, abi.wob(objs, tr.cbm(b, s.fs_base)), spec[args], tr.vw(b, s, objs, mem), o, k) proof
    fix args objs mem s o
    assume ha ho hm hs hu hl hr he hob hv hrun
    have e2 := apply(tr.eok_u, {b}, {false}, {s}, {args}, he)
    show := mp(all_elim(i, {args}, {objs}, {mem}, {s}, {o}), ha, ho, hm, hs, hu, hl, hr, e2, hob, hv, hrun)
  qed
  show by defs(g, tr.impl_m)
qed

theorem tr.impl_m_k: all b u f spec t base code statics. tr.impl_m(b, u, f, spec, t, false, base, code, statics) -> tr.impl_m(b, u, f, spec, t, true, base, code, statics)
proof
  fix b u f spec t base code statics
  assume h
  have i := expand(h, tr.impl_m)
  have g: all args objs mem s o. args in abi.ARGS -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(s.vm, base, code, statics) ->
      s.rip = f -> tr.eok(b, u, s, args) -> tr.objs_ok(s, objs) -> tr.vok(b, s, objs, mem) -> tr.run_s(s, t, s, o) ->
      tr.mtv(b, s, abi.wob(objs, tr.cbm(b, s.fs_base)), spec[args], tr.vw(b, s, objs, mem), o, true) proof
    fix args objs mem s o
    assume ha ho hm hs hu hl hr he hob hv hrun
    have m := mp(all_elim(i, {args}, {objs}, {mem}, {s}, {o}), ha, ho, hm, hs, hu, hl, hr, he, hob, hv, hrun)
    show by defs(taut(expand(m, tr.mtv)), tr.mtv)
  qed
  show by defs(g, tr.impl_m)
qed

// (the main mode's contract never stopping at t: the ABI's contract -- a
// run reaching t stops there, so its spec is undefined, matching any
// outcome)
theorem tr.impl_m_main: all f spec t base code statics. tr.impl_m(true, false, f, spec, t, false, base, code, statics) -> tr.implements_at(f, spec, base, code, statics)
proof
  fix f spec t base code statics
  assume h
  have i := expand(h, tr.impl_m)
  have g: all args objs mem s o. args in abi.ARGS -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) ->
      abi.loaded(s.vm, base, code, statics) -> s.rip = f -> abi.entry_ok(s, args) -> tr.objs_ok(s, objs) -> abi.view_ok(s, objs, mem) -> tr.run_d(s, s, o) ->
      tr.matches_t(spec, args, objs, mem, s, o) proof
    fix args objs mem s o
    assume ha ho hm hs hu hl hr he hob hv hrun
    have e2: tr.eok(true, false, s, args) by taut(all_elim(tr.eok_t, {s}, {args}), hs, he)
    have v2: tr.vok(true, s, objs, mem) by taut(all_elim(tr.vok_t, {s}, {objs}, {mem}), hv)
    have cb: tr.cbm(true, s.fs_base) = abi.cbytes0(s.fs_base) := mp(ite_t[c := true, a := abi.cbytes0(s.fs_base), b := abi.cball], (true by taut()))
    // (each run stopping at t: the contract's match, the main mode's)
    have mt: all o2. tr.run_s(s, t, s, o2) -> tr.matches_tk(spec, args, objs, mem, s, o2, false) proof
      fix o2
      assume hr2
      have m := mp(all_elim(i, {args}, {objs}, {mem}, {s}, {o2}), ha, ho, hm, hs, hu, hl, hr, e2, hob, v2, hr2)
      have m3 := rewrite(cb, rewrite(all_elim(tr.vw_t, {s}, {objs}, {mem}), m))
      show := apply(tr.mt_to, m3)
    qed
    have c := apply(tr.run_d_s, {s}, {t}, {s}, {o}, hrun)
    have c1: tr.run_s(s, t, s, o) -> tr.matches_t(spec, args, objs, mem, s, o) proof
      assume r
      show by taut(expand(mp(all_elim(mt, {o}), r), tr.matches_tk))
    qed
    have c2: (ex x. tr.run_s(s, t, s, ok(x, exc_val("stop", empty)))) -> tr.matches_t(spec, args, objs, mem, s, o) proof
      assume ex
      obtain x, r from ex
      have mk := mp(all_elim(mt, {ok(x, exc_val("stop", empty))}), r)
      have ra: abi.raises_at(spec, args, objs, mem, s) by simp(expand(mk, tr.matches_tk, tr.matches_t, tr.crashes_t, tr.div), tr.stop_ne,
        all_elim(tr.xo_ok, {spec[args]}, {abi.view(s, objs, mem)}, {x}, {exc_val("stop", empty)}), keep(abi.raises_at))
      show by defs(taut(ra), tr.matches_t)
    qed
    show by taut(c, c1, c2)
  qed
  show by defs(g, tr.implements_at)
qed
