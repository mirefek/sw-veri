// The run with a stop address: a function's disciplined run (tr.run_d)
// that ends where rip = t, with the exception `stop` -- the claim's
// `run_until(main)` in a function's terms (docs/todo.md section 5). A
// contract in this form gives the contract (tr.implements_at) of a spec
// that never raises at main: a run that never gets to t is the same run
// without the stop, and one that does matches only where the spec raises.
// (A raise at main is no undefined behaviour in the bridge: tr.ub,
// abi.raises_at leave it out, as a stack overflow.)

// (at t within the discipline: at the return a return, above the entry's
// sp disc)
abbrev tr.at_stop(s, t, x) := x.rip = t && !tr.at_ret(s, x) && int_lt(x.gpr[4], abi.sp(s))
def tr.rbs(s, t, l, o) := (!tr.at_stop(s, t, fst(l)) && tr.rbd(s, l, o)) || (!!tr.at_stop(s, t, fst(l)) && o = exc(l, pair("raise", exc_val("stop", empty))))
def tr.rws(s, t, l, r) := while_rel(l, x5. true, x5 x6. tr.rbs(s, t, x5, x6), x5. fn_update(empty, "os.events", fst(x5).os.events), r)
def tr.run_s(s, t, m, o) := ex r. tr.rws(s, t, pair(m, empty), r) && tr.rmap(r, o)

// The outcomes matching a spec with the stop: as tr.matches_t, and the
// stop -- the spec raising `at_main` (the callee at t entered with its
// precondition) in a world that is a view of the machine stopped (its
// memory, its objects)
def tr.stop_t(spec, args, objs, mem, s, o) :=
  ex m w v2 mem2. o = exc(m, exc_val("stop", empty)) && abi.raise_state(w) && runs(spec[args], abi.view(s, objs, mem), exc(w, exc_val("at_main", empty))) &&
    w = abi.view(m, v2, mem2) && abi.view_ok(m, v2, mem2)
def tr.matches_ts(spec, args, objs, mem, s, o) :=
  abi.raises_at(spec, args, objs, mem, s) ||
  (ex m1 w2. o = ok(m1, empty) && m1 in x86_64_linux.Machine && m1 in univ(1) &&
    runs(spec[args], abi.view(s, objs, mem), ok(w2, pair(m1.gpr[0], m1.gpr[2]))) && w2 in abi.World && w2 in univ(1) &&
    abi.world_matches(s.vm, m1.vm, w2.vm, abi.wob(objs, w2.objs.c_bytes), s.fs_base, abi.sp(s)) && m1.os = w2.os && m1.fs_base = s.fs_base &&
    m1.cpu = s.cpu && m1.gs_base = s.gs_base && m1.rip = abi.ret(s) && m1.gpr[4] = abi.sp(s) &&
    abi.callee_saved(m1, s) && !m1.flags.df) ||
  tr.crashes_t(spec, args, objs, mem, s, o) || tr.div(spec[args], abi.view(s, objs, mem), o) || tr.stop_t(spec, args, objs, mem, s, o)

// the contract with a stop at t: every disciplined run, stopping at t,
// matches the spec so
def tr.implements_stop(f, spec, t, base, code, statics) :=
  all args objs mem s o. args in abi.ARGS -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(s.vm, base, code, statics) ->
    s.rip = f -> abi.entry_ok(s, args) -> tr.objs_ok(s, objs) -> abi.view_ok(s, objs, mem) -> tr.run_s(s, t, s, o) -> tr.matches_ts(spec, args, objs, mem, s, o)

// a spec that never raises at main
def tr.no_main(spec) := all args w x. !runs(spec[args], w, exc(x, exc_val("at_main", empty)))

// (matching with the stop, for a spec never raising at main: matching)
theorem tr.matches_of_s: all spec args objs mem s o. tr.no_main(spec) -> tr.matches_ts(spec, args, objs, mem, s, o) -> tr.matches_t(spec, args, objs, mem, s, o)
proof
  fix spec args objs mem s o
  assume hn h
  have r2: tr.stop_t(spec, args, objs, mem, s, o) -> false proof
    assume st
    obtain m w v2 mem2, _ _ rs _ _ from expand(st, tr.stop_t)
    show by taut(rs, all_elim(expand(hn, tr.no_main), {args}, {abi.view(s, objs, mem)}, {w}))
  qed
  show by defs(taut(expand(h, tr.matches_ts), r2), tr.matches_t)
qed

// (a disciplined run: the run stopping at t, or the run stopping at t
// stops)
theorem tr.run_d_s: all s t m o. tr.run_d(s, m, o) -> tr.run_s(s, t, m, o) || (ex x. tr.run_s(s, t, m, exc(x, exc_val("stop", empty))))
proof
  fix s t m o
  assume h
  obtain x4, hw hm from expand(h, tr.run_d)
  have ne: all l. !is_ok(exc(l, pair("raise", exc_val("stop", empty)))) proof
    fix l
    have n: is_ok(exc(l, pair("raise", exc_val("stop", empty)))) -> false proof
      assume h2
      obtain a b, h3 from expand(h2, is_ok)
      show by simp(h3)
    qed
    show by taut(n)
  qed
  have g := mp(mp(while_guard[l0 := pair(m, empty), b := l o. tr.rbd(s, l, o), tr := l. fn_update(empty, "os.events", fst(l).os.events),
    p := l. !tr.at_stop(s, t, fst(l)), e := l. exc(l, pair("raise", exc_val("stop", empty))), r := x4], ne), expand(hw, tr.rwd))
  have kept: while_rel(pair(m, empty), l. true, l o. (!tr.at_stop(s, t, fst(l)) && tr.rbd(s, l, o)) || (!!tr.at_stop(s, t, fst(l)) && o = exc(l, pair("raise", exc_val("stop", empty)))),
      l. fn_update(empty, "os.events", fst(l).os.events), x4) -> tr.run_s(s, t, m, o) proof
    assume w
    have ws: tr.rws(s, t, pair(m, empty), x4) by defs(w, tr.rws, tr.rbs)
    show by defs(ex_intro({x4}, taut(ws, hm)), tr.run_s)
  qed
  have left: (ex l. while_rel(pair(m, empty), l. true, l o. (!tr.at_stop(s, t, fst(l)) && tr.rbd(s, l, o)) || (!!tr.at_stop(s, t, fst(l)) && o = exc(l, pair("raise", exc_val("stop", empty)))),
      l. fn_update(empty, "os.events", fst(l).os.events), exc(l, pair("raise", exc_val("stop", empty))))) -> (ex x. tr.run_s(s, t, m, exc(x, exc_val("stop", empty)))) proof
    assume e
    obtain l, w from e
    have ws: tr.rws(s, t, pair(m, empty), exc(l, pair("raise", exc_val("stop", empty)))) by defs(w, tr.rws, tr.rbs)
    have rm: tr.rmap(exc(l, pair("raise", exc_val("stop", empty))), exc(fst(l), exc_val("stop", empty))) by defs(simp(), tr.rmap)
    have rs: tr.run_s(s, t, m, exc(fst(l), exc_val("stop", empty))) by defs(ex_intro({exc(l, pair("raise", exc_val("stop", empty)))}, taut(ws, rm)), tr.run_s)
    show by ex_intro({fst(l)}, rs)
  qed
  show by taut(g, kept, left)
qed

// (a stop matches the spec only where it raises: then anything does)
theorem tr.stop_matches: all spec args objs mem s x o. tr.matches_t(spec, args, objs, mem, s, exc(x, exc_val("stop", empty))) -> tr.matches_t(spec, args, objs, mem, s, o)
proof
  fix spec args objs mem s x o
  assume ma
  have n2: (ex m1 w2. exc(x, exc_val("stop", empty)) = ok(m1, empty) && m1 in x86_64_linux.Machine && m1 in univ(1) &&
      runs(spec[args], abi.view(s, objs, mem), ok(w2, pair(m1.gpr[0], m1.gpr[2]))) && w2 in abi.World && w2 in univ(1) &&
      abi.world_matches(s.vm, m1.vm, w2.vm, abi.wob(objs, w2.objs.c_bytes), s.fs_base, abi.sp(s)) && m1.os = w2.os && m1.fs_base = s.fs_base &&
      m1.cpu = s.cpu && m1.gs_base = s.gs_base && m1.rip = abi.ret(s) && m1.gpr[4] = abi.sp(s) &&
      abi.callee_saved(m1, s) && !m1.flags.df) -> false proof
    assume e
    obtain m1 w2, e2 from e
    show by simp(e2.1)
  qed
  have n3: tr.crashes_t(spec, args, objs, mem, s, exc(x, exc_val("stop", empty))) -> false proof
    assume e
    obtain m1 a k, {oe} from expand(e, tr.crashes_t)
    show by simp(expand(oe, exc_val))
  qed
  have n4: tr.div(spec[args], abi.view(s, objs, mem), exc(x, exc_val("stop", empty))) -> false proof
    assume e
    obtain t, q from expand(e, tr.div).1
    show by simp(q)
  qed
  have r: abi.raises_at(spec, args, objs, mem, s) by taut(expand(ma, tr.matches_t), n2, n3, n4)
  show by defs(taut(r), tr.matches_t)
qed

// the contract with a stop gives the contract
theorem tr.implements_of_s: all f spec t base code statics. tr.no_main(spec) -> tr.implements_stop(f, spec, t, base, code, statics) -> tr.implements_at(f, spec, base, code, statics)
proof
  fix f spec t base code statics
  assume hn h
  have c := expand(h, tr.implements_stop)
  have g: all args objs mem s o. args in abi.ARGS -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(s.vm, base, code, statics) ->
      s.rip = f -> abi.entry_ok(s, args) -> tr.objs_ok(s, objs) -> abi.view_ok(s, objs, mem) -> tr.run_d(s, s, o) -> tr.matches_t(spec, args, objs, mem, s, o) proof
    fix args objs mem s o
    assume hA hot hmv hM su hl hrip he ok hwm hr
    have d := apply(tr.run_d_s[s := s, t := t, m := s, o := o], hr)
    have c1: tr.run_s(s, t, s, o) -> tr.matches_t(spec, args, objs, mem, s, o) proof
      assume rs
      show := apply(tr.matches_of_s, hn, mp(all_elim(c, {args}, {objs}, {mem}, {s}, {o}), hA, hot, hmv, hM, su, hl, hrip, he, ok, hwm, rs))
    qed
    have c2: (ex x. tr.run_s(s, t, s, exc(x, exc_val("stop", empty)))) -> tr.matches_t(spec, args, objs, mem, s, o) proof
      assume e
      obtain x, rs from e
      have mt := apply(tr.matches_of_s, hn, mp(all_elim(c, {args}, {objs}, {mem}, {s}, {exc(x, exc_val("stop", empty))}), hA, hot, hmv, hM, su, hl, hrip, he, ok, hwm, rs))
      show := apply(tr.stop_matches[spec := spec, args := args, objs := objs, mem := mem, s := s, x := x, o := o], mt)
    qed
    show by taut(d, c1, c2)
  qed
  show by defs(g, tr.implements_at)
qed

// ----------------------------------------------------------------------
//  Where a run returns

// (a disciplined last pass whose outcome maps to a return: at the return)
theorem tr.rbd_last: all s l r x e. tr.rbd(s, l, r) -> !is_ok(r) -> tr.rmap(r, ok(x, e)) -> tr.at_ret(s, x)
proof
  fix s l r x e
  assume hb nk hm
  have c1: tr.disc_ok(s, fst(l)) && tr.rb(s, l, r) -> tr.at_ret(s, x) proof
    assume hd
    have b1: (!tr.at_ret(s, fst(l)) && bind_rel(x86_64_linux.step, fst(l), x7 x8. r = ok(pair(x7, empty), empty), x7 x8. r = exc(pair(x7, empty), pair("raise", x8)), x7. r = diverge(x7))) ->
        tr.at_ret(s, x) proof
      assume hb1
      obtain o2, ho2 from expand(hb1.2, bind_rel)
      have k1: (ex s1 v1. o2 = ok(s1, v1) && r = ok(pair(s1, empty), empty)) -> tr.at_ret(s, x) proof
        assume ek
        obtain s1 v1, _ re from ek
        show by simp(expand(rewrite(re, nk), is_ok))
      qed
      have k2: (ex s1 e1. o2 = exc(s1, e1) && r = exc(pair(s1, empty), pair("raise", e1))) -> tr.at_ret(s, x) proof
        assume ek
        obtain s1 e1, _ re from ek
        show by simp(expand(rewrite(re, hm), tr.rmap))
      qed
      have k3: (ex t. o2 = diverge(t) && r = diverge(t)) -> tr.at_ret(s, x) proof
        assume ek
        obtain t, _ re from ek
        show by simp(expand(rewrite(re, hm), tr.rmap))
      qed
      show by taut(ho2, k1, k2, k3)
    qed
    have b2: (!!tr.at_ret(s, fst(l)) && r = exc(pair(fst(l), empty), pair("brk", empty))) -> tr.at_ret(s, x) proof
      assume hb2
      have nar re := hb2
      have xe: x = fst(l) by simp(expand(rewrite(re, hm), tr.rmap))
      have ar: tr.at_ret(s, fst(l)) by taut(nar)
      show := rewrite(sym(xe), ar)
    qed
    show by taut(expand(hd.2, tr.rb), b1, b2)
  qed
  have c2: !tr.disc_ok(s, fst(l)) && r = exc(l, pair("raise", exc_val("disc", empty))) -> tr.at_ret(s, x) proof
    assume hd
    show by simp(expand(rewrite(hd.2, hm), tr.rmap))
  qed
  show by taut(expand(hb, tr.rbd), c1, c2)
qed

// (a stop run returning: at the return)
theorem tr.run_s_ok: all s t m x e. tr.run_s(s, t, m, ok(x, e)) -> tr.at_ret(s, x)
proof
  fix s t m x e
  assume h
  obtain r, hw hm from expand(h, tr.run_s)
  have wi := mp(mp(mp(while_inv[l0 := pair(m, empty), c := l. true, b := l o. tr.rbs(s, t, l, o),
    tr := l. fn_update(empty, "os.events", fst(l).os.events), r := r, p := l. true], simp()), simp()), expand(hw, tr.rws))
  have nd: !(ex t2. r = diverge(t2)) proof
    have g: (ex t2. r = diverge(t2)) -> false proof
      assume ed
      obtain t2, ht from ed
      show by simp(expand(rewrite(ht, hm), tr.rmap))
    qed
    show by taut(g)
  qed
  have el: ex l. true && ((!true && r = ok(l, empty)) || (true && tr.rbs(s, t, l, r) && !is_ok(r))) by taut(wi, nd)
  obtain l, hl from el
  have hb: tr.rbs(s, t, l, r) by taut(hl)
  have nk: !is_ok(r) by taut(hl)
  have c1: !tr.at_stop(s, t, fst(l)) && tr.rbd(s, l, r) -> tr.at_ret(s, x) proof
    assume hd
    show := apply(tr.rbd_last[s := s, l := l, r := r, x := x, e := e], (tr.rbd(s, l, r) by taut(hd)), nk, hm)
  qed
  have c2: !!tr.at_stop(s, t, fst(l)) && r = exc(l, pair("raise", exc_val("stop", empty))) -> tr.at_ret(s, x) proof
    assume hd
    show by simp(expand(rewrite(hd.2, hm), tr.rmap))
  qed
  show by taut(expand(hb, tr.rbs), c1, c2)
qed

// ----------------------------------------------------------------------
//  The claim's run with the breakpoint rip = t (as tr.run_d_k for the
//  disciplined run): the stop run's outcome, or the claim's run stops
//  where the stop run leaves with disc, or where it stops at t

theorem tr.run_s_k: all s t m o. tr.run_s(s, t, m, o) -> int_lt(m.gpr[4], abi.sp(s)) -> !(m.rip = t) ->
  (ex o1. tr.run_k(s, zb. zb.rip = t, m, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2))) ||
  (ex x. o = exc(x, exc_val("disc", empty)) && tr.run_k(s, zb. zb.rip = t, m, ok(x, empty)) && !tr.at_ret(s, x) && tr.out(s, x))||
  (ex x. o = exc(x, exc_val("stop", empty)) && tr.run_k(s, zb. zb.rip = t, m, ok(x, empty)) && x.rip = t && !tr.at_ret(s, x))
proof
  fix s t m o
  assume h hlt hnt
  let G := (ex o1. tr.run_k(s, zb. zb.rip = t, m, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2))) ||
    (ex x. o = exc(x, exc_val("disc", empty)) && tr.run_k(s, zb. zb.rip = t, m, ok(x, empty)) && !tr.at_ret(s, x) && tr.out(s, x))||
    (ex x. o = exc(x, exc_val("stop", empty)) && tr.run_k(s, zb. zb.rip = t, m, ok(x, empty)) && x.rip = t && !tr.at_ret(s, x))
  let TR(x5) := fn_update(empty, "os.events", fst(x5).os.events)
  let P(l) := int_lt(fst(l).gpr[4], abi.sp(s)) && !(fst(l).rip = t)
  let E(l) := exc(pair(fst(l), empty), pair("brk", empty))
  obtain r, hw hm from expand(h, tr.run_s)
  // (below the sp, off t: the pass is the plain step)
  have pb: all l o2. P(l) -> tr.rbs(s, t, l, o2) -> tr.rst(l, o2) proof
    fix l o2
    assume hp hb
    have hp1 hp2 := hp
    have ne: fst(l).gpr[4] = abi.sp(s) -> false proof
      assume e
      have l2 := rewrite(e, hp1)
      show by arith(l2)
    qed
    have nar: !tr.at_ret(s, fst(l)) by taut(ne)
    have dok: tr.disc_ok(s, fst(l)) by taut(hp1)
    have bd: tr.rbd(s, l, o2) by taut(expand(hb, tr.rbs), hp2)
    have rb: tr.rb(s, l, o2) by taut(expand(bd, tr.rbd), dok)
    show by defs(taut(expand(rb, tr.rb), nar), tr.rst)
  qed
  // (the guarded passes: the claim's, t a breakpoint)
  have gb: all l o2. (P(l) && tr.rbs(s, t, l, o2)) || (!P(l) && o2 = E(l)) -> tr.rbk(s, zb. zb.rip = t, l, o2) proof
    fix l o2
    assume g
    have g1: P(l) && tr.rbs(s, t, l, o2) -> tr.rbk(s, zb. zb.rip = t, l, o2) proof
      assume e
      have pe: P(l) by taut(e)
      have rs := mp(all_elim(pb, {l}, {o2}), pe, (tr.rbs(s, t, l, o2) by taut(e)))
      have ns: !tr.stopk(s, zb. zb.rip = t, fst(l)) by defs(taut(pe), tr.stopk)
      show by defs(taut(ns, rs), tr.rbk)
    qed
    have g2: !P(l) && o2 = E(l) -> tr.rbk(s, zb. zb.rip = t, l, o2) proof
      assume e
      have st: tr.stopk(s, zb. zb.rip = t, fst(l)) by defs(taut(e.1), tr.stopk)
      show by defs(taut(st, e.2), tr.rbk)
    qed
    show by taut(g, g1, g2)
  qed
  have pm: P(pair(m, empty)) by simp(hlt, hnt)
  have un := mp(while_unroll[l0 := pair(m, empty), c := x5. true, b := x5 x6. tr.rbs(s, t, x5, x6), tr := x5. TR(x5), r := r], expand(hw, tr.rws))
  // the first pass leaves
  have u1: tr.rbs(s, t, pair(m, empty), r) && !is_ok(r) -> G proof
    assume e
    have rs := mp(all_elim(pb, {pair(m, empty)}, {r}), pm, e.1)
    have rk: tr.rk(s, zb. zb.rip = t, m, r) by defs(taut(rs, e.2), tr.rk)
    have rn: tr.run_k(s, zb. zb.rip = t, m, o) by defs(ex_intro({r}, taut(rk, hm)), tr.run_k)
    have e1: ex o1. tr.run_k(s, zb. zb.rip = t, m, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2)) by ex_intro({o}, taut(rn, refl({o})))
    show by taut(e1)
  qed
  // the first pass goes on to l1: the passes from l1 cut where rsp first
  // reaches the entry's sp, or rip t
  have u2: (ex l1. tr.rbs(s, t, pair(m, empty), ok(l1, empty)) && (ex r1. while_rel(l1, x5. true, x5 x6. tr.rbs(s, t, x5, x6), x5. TR(x5), r1) &&
      fst(r1) = fst(r) && (!(fst(r) = 2) -> r1 = r))) -> G proof
    assume e
    obtain l1, rb0 er from e
    obtain r1, w1 f1 e1 from er
    have rs0 := mp(all_elim(pb, {pair(m, empty)}, {ok(l1, empty)}), pm, rb0)
    have q1: l1 = pair(fst(l1), empty) by simp(expand(rs0, tr.rst), keep(x86_64_linux.step))
    have he: all l. !is_ok(E(l)) proof
      fix l
      show by defs(simp(), is_ok)
    qed
    have hqs: all l l2. l = pair(fst(l), empty) -> tr.rbs(s, t, l, ok(l2, empty)) -> l2 = pair(fst(l2), empty) proof
      fix l l2
      assume _ hb
      show by simp(expand(hb, tr.rbs, tr.rbd, tr.rb), keep(x86_64_linux.step))
    qed
    have sp := mp(while_split[l0 := l1, b := l o2. tr.rbs(s, t, l, o2), tr := l. TR(l), p := l. P(l), e := l. E(l), r := r1, q := l. l = pair(fst(l), empty)],
      he, q1, hqs, w1)
    let GB(l, o2) := (P(l) && tr.rbs(s, t, l, o2)) || (!P(l) && o2 = E(l))
    // never reaching it: the claim's run, the same outcome
    have ca: while_rel(l1, l. true, l o2. GB(l, o2), l. TR(l), r1) -> G proof
      assume wg
      have w2 := mp(while_mono[l0 := l1, c := l. true, b1 := l o2. GB(l, o2), b2 := l o2. tr.rbk(s, zb. zb.rip = t, l, o2), tr := l. TR(l), r := r1], gb, wg)
      have rw: tr.rwk(s, zb. zb.rip = t, l1, r1) by defs(w2, tr.rwk)
      have ex2: ex l2. tr.rst(pair(m, empty), ok(l2, empty)) && tr.rwk(s, zb. zb.rip = t, l2, r1) by ex_intro({l1}, taut(rs0, rw))
      have rk: tr.rk(s, zb. zb.rip = t, m, r1) by defs(taut(ex2), tr.rk)
      have nd: !(fst(r) = 2) -> G proof
        assume n
        have re := mp(e1, n)
        have rn: tr.run_k(s, zb. zb.rip = t, m, o) by defs(ex_intro({r1}, taut(rk, rewrite(sym(re), hm))), tr.run_k)
        have e3: ex o1. tr.run_k(s, zb. zb.rip = t, m, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2)) by ex_intro({o}, taut(rn, refl({o})))
        show by taut(e3)
      qed
      have dd: fst(r) = 2 -> G proof
        assume d
        have d1: fst(r1) = 2 by simp(f1, d)
        have rm1: tr.rmap(r1, diverge(snd(r1))) by defs(simp(d1), tr.rmap)
        have rn: tr.run_k(s, zb. zb.rip = t, m, diverge(snd(r1))) by defs(ex_intro({r1}, taut(rk, rm1)), tr.run_k)
        have od: fst(o) = 2 by simp(expand(hm, tr.rmap), d)
        have dd2: fst(diverge(snd(r1))) = 2 by simp()
        have e3: ex o1. tr.run_k(s, zb. zb.rip = t, m, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2)) by ex_intro({diverge(snd(r1))}, taut(rn, dd2, od))
        show by taut(e3)
      qed
      show by taut(nd, dd)
    qed
    // reaching it at l: the claim's run stops there; the stop run stops
    // there (at t), returns there (at the return) or leaves with disc
    have cb: (ex l. l = pair(fst(l), empty) && while_rel(l1, l. true, l o2. GB(l, o2), l. TR(l), E(l)) &&
        (ex r2. while_rel(l, l. true, l o2. tr.rbs(s, t, l, o2), l. TR(l), r2) && fst(r2) = fst(r1) && (!(fst(r1) = 2) -> r2 = r1))) -> G proof
      assume e2
      obtain l, ql wg er2 from e2
      obtain r2, w3 f3 e3 from er2
      have w2 := mp(while_mono[l0 := l1, c := l. true, b1 := l o2. GB(l, o2), b2 := l o2. tr.rbk(s, zb. zb.rip = t, l, o2), tr := l. TR(l), r := E(l)], gb, wg)
      have rw: tr.rwk(s, zb. zb.rip = t, l1, E(l)) by defs(w2, tr.rwk)
      have ex2: ex l2. tr.rst(pair(m, empty), ok(l2, empty)) && tr.rwk(s, zb. zb.rip = t, l2, E(l)) by ex_intro({l1}, taut(rs0, rw))
      have rk: tr.rk(s, zb. zb.rip = t, m, E(l)) by defs(taut(ex2), tr.rk)
      have rmb: tr.rmap(E(l), ok(fst(l), empty)) by defs(simp(), tr.rmap)
      have rn: tr.run_k(s, zb. zb.rip = t, m, ok(fst(l), empty)) by defs(ex_intro({E(l)}, taut(rk, rmb)), tr.run_k)
      // (at l, the guarded run's last pass is a cut)
      have cs := mp(while_cases[l0 := l1, c := l. true, b := l o2. GB(l, o2), tr := l. TR(l), r := E(l)], wg)
      have np: !P(l) proof
        have c1: (ex l3. (!true && E(l) = ok(l3, empty)) || (true && GB(l3, E(l)) && !is_ok(E(l)))) -> !P(l) proof
          assume el
          obtain l3, hl3 from el
          have gb3: GB(l3, E(l)) by taut(hl3)
          have k1: P(l3) && tr.rbs(s, t, l3, E(l)) -> !P(l) proof
            assume k
            have rs3 := mp(all_elim(pb, {l3}, {E(l)}), (P(l3) by taut(k)), (tr.rbs(s, t, l3, E(l)) by taut(k)))
            have ro := apply(tr.rst_out, {l3}, {E(l)}, rs3, all_elim(he, {l}))
            have f: false by simp(ro)
            show by taut(f)
          qed
          have k2: !P(l3) && E(l) = E(l3) -> !P(l) proof
            assume k
            have fe: fst(l) = fst(l3) by simp(k.2)
            show := rewrite(sym(fe), k.1)
          qed
          show by taut(gb3, k1, k2)
        qed
        have c2: (ex t2. E(l) = diverge(t2)) -> !P(l) proof
          assume ed
          obtain t2, te from ed
          have f: false by simp(te)
          show by taut(f)
        qed
        show by taut(cs, c1, c2)
      qed
      // the stop run from l
      have un2 := mp(while_unroll[l0 := l, c := x5. true, b := x5 x6. tr.rbs(s, t, x5, x6), tr := x5. TR(x5), r := r2], w3)
      have rr: !(fst(r2) = 2) -> r2 = r proof
        assume n2
        have n1: !(fst(r1) = 2) by simp(n2, f3)
        have n0: !(fst(r) = 2) by simp(n1, f1)
        show := trans(mp(e3, n1), mp(e1, n0))
      qed
      have v0: (!true && r2 = ok(l, empty)) -> G proof
        assume k
        show by taut(k)
      qed
      // (a pass from l always leaving: the run's outcome its)
      have one: all o3. (all o2. tr.rbs(s, t, l, o2) -> o2 = o3) -> !is_ok(o3) -> !(fst(o3) = 2) -> tr.rmap(o3, o) proof
        fix o3
        assume bb nok nd3
        have v1: tr.rbs(s, t, l, r2) && !is_ok(r2) -> tr.rmap(o3, o) proof
          assume k
          have r2e := mp(all_elim(bb, {r2}), k.1)
          have n2: !(fst(r2) = 2) := rewrite(sym(r2e), nd3)
          have re := mp(rr, n2)
          show := rewrite(r2e, rewrite(sym(re), hm))
        qed
        have v2: (ex l4. tr.rbs(s, t, l, ok(l4, empty)) && (ex r4. while_rel(l4, x5. true, x5 x6. tr.rbs(s, t, x5, x6), x5. TR(x5), r4) && fst(r4) = fst(r2) &&
            (!(fst(r2) = 2) -> r4 = r2))) -> tr.rmap(o3, o) proof
          assume k
          obtain l4, hb4 _ from k
          have r4e := mp(all_elim(bb, {ok(l4, empty)}), hb4)
          have ok4: is_ok(ok(l4, empty)) by defs(ex_intro({l4}, {empty}, refl({ok(l4, empty)})), is_ok)
          have f: false by taut(nok, rewrite(r4e, ok4))
          show by taut(f)
        qed
        have v00: (!true && r2 = ok(l, empty)) -> tr.rmap(o3, o) proof
          assume k
          show by taut(k)
        qed
        show by taut(un2, v00, v1, v2)
      qed
      // (at t: it stops)
      have st1: tr.at_stop(s, t, fst(l)) -> G proof
        assume ht
        have ht1 ht2 _ := ht
        let O3 := exc(l, pair("raise", exc_val("stop", empty)))
        have bb: all o2. tr.rbs(s, t, l, o2) -> o2 = O3 proof
          fix o2
          assume hb
          show by taut(expand(hb, tr.rbs), ht)
        qed
        have nok: !is_ok(O3) proof
          have n: is_ok(O3) -> false proof
            assume h3
            obtain a b, h4 from expand(h3, is_ok)
            show by simp(h4)
          qed
          show by taut(n)
        qed
        have rm := mp(all_elim(one, {O3}), bb, nok, (!(fst(O3) = 2) by simp()))
        have oe: o = exc(fst(l), exc_val("stop", empty)) by simp(expand(rm, tr.rmap))
        have e4: ex x. o = exc(x, exc_val("stop", empty)) && tr.run_k(s, zb. zb.rip = t, m, ok(x, empty)) && x.rip = t && !tr.at_ret(s, x)
          by ex_intro({fst(l)}, taut(oe, rn, ht1, ht2))
        show by taut(e4)
      qed
      // (off t, or at the return: rsp has reached the sp -- at the return:
      // it returns; elsewhere: disc)
      have st2: !tr.at_stop(s, t, fst(l)) -> G proof
        assume nt
        have lt1: fst(l).rip = t -> !int_lt(fst(l).gpr[4], abi.sp(s)) proof
          assume e
          have c1: tr.at_ret(s, fst(l)) -> !int_lt(fst(l).gpr[4], abi.sp(s)) proof
            assume ar
            have eq: fst(l).gpr[4] = abi.sp(s) by taut(ar)
            show by arith(eq)
          qed
          show by taut(nt, e, c1)
        qed
        have nlt: !int_lt(fst(l).gpr[4], abi.sp(s)) by taut(np, lt1)
        have at1: tr.at_ret(s, fst(l)) -> G proof
          assume at
          let O3 := exc(pair(fst(l), empty), pair("brk", empty))
          have dok: tr.disc_ok(s, fst(l)) by taut(at)
          have bb: all o2. tr.rbs(s, t, l, o2) -> o2 = O3 proof
            fix o2
            assume hb
            have bd: tr.rbd(s, l, o2) by taut(expand(hb, tr.rbs), nt)
            have rb: tr.rb(s, l, o2) by taut(expand(bd, tr.rbd), dok)
            show by taut(expand(rb, tr.rb), at)
          qed
          have nok: !is_ok(O3) by defs(simp(), is_ok)
          have rm := mp(all_elim(one, {O3}), bb, nok, (!(fst(O3) = 2) by simp()))
          have oe: o = ok(fst(l), empty) by simp(expand(rm, tr.rmap))
          have e4: ex o1. tr.run_k(s, zb. zb.rip = t, m, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2)) by ex_intro({ok(fst(l), empty)}, taut(rn, sym(oe)))
          show by taut(e4)
        qed
        have at2: !tr.at_ret(s, fst(l)) -> G proof
          assume nat
          let O3 := exc(l, pair("raise", exc_val("disc", empty)))
          have ndok: !tr.disc_ok(s, fst(l)) by taut(nat, nlt)
          have bb: all o2. tr.rbs(s, t, l, o2) -> o2 = O3 proof
            fix o2
            assume hb
            have bd: tr.rbd(s, l, o2) by taut(expand(hb, tr.rbs), nt)
            show by taut(expand(bd, tr.rbd), ndok)
          qed
          have nok: !is_ok(O3) proof
            have n: is_ok(O3) -> false proof
              assume h3
              obtain a b, h4 from expand(h3, is_ok)
              show by simp(h4)
            qed
            show by taut(n)
          qed
          have rm := mp(all_elim(one, {O3}), bb, nok, (!(fst(O3) = 2) by simp()))
          have oe: o = exc(fst(l), exc_val("disc", empty)) by simp(expand(rm, tr.rmap))
          have e4: ex x. o = exc(x, exc_val("disc", empty)) && tr.run_k(s, zb. zb.rip = t, m, ok(x, empty)) && !tr.at_ret(s, x) && tr.out(s, x)
            by ex_intro({fst(l)}, taut(oe, rn, nat, nlt))
          show by taut(e4)
        qed
        show by taut(at1, at2)
      qed
      show by taut(st1, st2)
    qed
    show by taut(sp, ca, cb)
  qed
  have u0: (!true && r = ok(pair(m, empty), empty)) -> G proof
    assume e
    show by taut(e)
  qed
  show by taut(un, u0, u1, u2)
qed

// (a stop run's outcome tagged 2: a divergence)
theorem tr.run_s_div: all s t m o. tr.run_s(s, t, m, o) -> fst(o) = 2 -> (ex t2. o = diverge(t2))
proof
  fix s t m o
  assume h hf
  obtain r, _ hm from expand(h, tr.run_s)
  have c: fst(r) = 2 && o = diverge(snd(r)) by simp(expand(hm, tr.rmap), hf)
  show by ex_intro({snd(r)}, taut(c))
qed

// ----------------------------------------------------------------------
//  The contract with the stop from the claim at the entry (as tr.entry_d):
//  the claim with the breakpoint rip = t, there the program left raising
//  at main in a world that is a view of the machine (tr.at_t)

def tr.at_t(zb, pb, wb) := (ex w2 v2 mem2. abi.raise_state(w2) && runs(pb, wb, exc(w2, exc_val("at_main", empty))) && w2 = abi.view(zb, v2, mem2) &&
    abi.view_ok(zb, v2, mem2)) ||
  // (or undefined: main's precondition failing)
  (ex e x. e in univ(1) && !(e = exc_val("stack_overflow", empty)) && !(e = exc_val("at_main", empty)) && abi.raise_state(x) && runs(pb, wb, exc(x, e)))

theorem tr.entry_s: all spec args s v mem o t. s in x86_64_linux.Machine -> int_lt(s.gpr[4], 140737488355328) -> !(s.rip = t) ->
  tr.sim(s, zb. zb.rip = t, zb pb wb. tr.at_t(zb, pb, wb), v, spec[args], abi.view(s, v, mem), s) -> tr.run_s(s, t, s, o) ->
  tr.matches_ts(spec, args, v, mem, s, o)
proof
  fix spec args s v mem o t
  assume hM hsl hnt h rd
  let P := spec[args]
  let W := abi.view(s, v, mem)
  have r4 := apply(x86i.rsp_typed, hM)
  have lt := apply(tr.sp_lt, {s.gpr[4]}, r4, hsl)
  have cr := all_elim(tr.crash_at, {spec}, {args}, {s}, {v}, {mem}, {o})
  have ua := all_elim(tr.ub_at, {spec}, {args}, {s}, {v}, {mem})
  have sm := expand(h, tr.sim)
  // (a return reached: the spec's return, as the contract has it)
  have rt: all m1. o = ok(m1, empty) -> tr.retok(s, v, P, W, m1) -> tr.matches_ts(spec, args, v, mem, s, o) proof
    fix m1
    assume oe hr
    have rx := expand(hr, tr.retok)
    have e1: ex m2 w2. o = ok(m2, empty) && m2 in x86_64_linux.Machine && m2 in univ(1) &&
        runs(spec[args], abi.view(s, v, mem), ok(w2, pair(m2.gpr[0], m2.gpr[2]))) && w2 in abi.World && w2 in univ(1) &&
        abi.world_matches(s.vm, m2.vm, w2.vm, abi.wob(v, w2.objs.c_bytes), s.fs_base, abi.sp(s)) && m2.os = w2.os && m2.fs_base = s.fs_base &&
        m2.cpu = s.cpu && m2.gs_base = s.gs_base && m2.rip = abi.ret(s) && m2.gpr[4] = abi.sp(s) &&
        abi.callee_saved(m2, s) && !m2.flags.df proof
      have ew: ex w3. runs(P, W, ok(w3, pair(m1.gpr[0], m1.gpr[2]))) && w3 in abi.World && w3 in univ(1) &&
          abi.world_matches(s.vm, m1.vm, w3.vm, abi.wob(v, w3.objs.c_bytes), s.fs_base, abi.sp(s)) && m1.os = w3.os && m1.fs_base = s.fs_base by taut(rx)
      obtain w3, h3 from ew
      show by ex_intro({m1}, {w3}, taut(oe, rx, h3))
    qed
    show by defs(taut(e1), tr.matches_ts)
  qed
  have k1: tr.ub(s, v, P, W) -> tr.matches_ts(spec, args, v, mem, s, o) proof
    assume u
    show by defs(taut(mp(ua, u)), tr.matches_ts)
  qed
  have rdk := apply(tr.run_s_k, {s}, {t}, {s}, {o}, rd, lt, hnt)
  // the claim's run to the same outcome
  have c1: (ex o1. tr.run_k(s, zb. zb.rip = t, s, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2))) -> tr.matches_ts(spec, args, v, mem, s, o) proof
    assume e
    obtain o1, rk eo from e
    have g := expand(mp(all_elim(sm, {o1}), rk), tr.gk)
    have k2: tr.crash(s, P, W, o1) -> tr.matches_ts(spec, args, v, mem, s, o) proof
      assume c
      obtain m1 a k0, {oe} from expand(c, tr.crash)
      have nd: !(fst(o1) = 2) by simp(oe)
      have oe: o1 = o by taut(eo, nd)
      have c2 := rewrite(oe, c)
      show by defs(taut(mp(cr, c2)), tr.matches_ts)
    qed
    have k3: tr.div(P, W, o1) -> tr.matches_ts(spec, args, v, mem, s, o) proof
      assume d
      obtain t2, te from expand(d, tr.div).1
      have f1: fst(o1) = 2 by simp(te)
      have f0a: o1 = o -> fst(o) = 2 proof
        assume e5
        show := rewrite(e5, f1)
      qed
      have f0: fst(o) = 2 by taut(eo, f0a)
      have ed := apply(tr.run_s_div, rd, f0)
      have d2: tr.div(P, W, o) by defs(taut(ed, expand(d, tr.div).2), tr.div)
      show by defs(taut(d2), tr.matches_ts)
    qed
    // (the claim's run stopping: the stop run returns there)
    have k4: (ex m1. o1 = ok(m1, empty) && tr.arr(s, zb. zb.rip = t, zb pb wb. tr.at_t(zb, pb, wb), v, m1, P, W)) -> tr.matches_ts(spec, args, v, mem, s, o) proof
      assume e2
      obtain m1, oe1 ha from e2
      have nd: !(fst(o1) = 2) by simp(oe1)
      have oe0: o1 = o by taut(eo, nd)
      have oe: o = ok(m1, empty) := trans(sym(oe0), oe1)
      have at := apply(tr.run_s_ok, rewrite(oe, rd))
      have ou: tr.out(s, m1) proof
        have ne: int_lt(m1.gpr[4], abi.sp(s)) -> false proof
          assume l2
          have l3 := rewrite(at.2, l2)
          show by arith(l3)
        qed
        show by taut(ne)
      qed
      have hr := mp(expand(ha, tr.arr).1, ou)
      show := mp(all_elim(rt, {m1}), oe, hr)
    qed
    show by taut(g, k1, k2, k3, k4)
  qed
  // the claim's run stopping where the stop run leaves with disc: undefined
  have c2: (ex x. o = exc(x, exc_val("disc", empty)) && tr.run_k(s, zb. zb.rip = t, s, ok(x, empty)) && !tr.at_ret(s, x) && tr.out(s, x))->
      tr.matches_ts(spec, args, v, mem, s, o) proof
    assume e
    obtain x, oe rk nat nxt from e
    have g := expand(mp(all_elim(sm, {ok(x, empty)}), rk), tr.gk)
    have k2: tr.crash(s, P, W, ok(x, empty)) -> false proof
      assume c
      obtain m1 a k0, {oe} from expand(c, tr.crash)
      show by simp(oe)
    qed
    have k3 := all_elim(tr.div_ok, {P}, {W}, {x}, {empty})
    have k4: (ex m1. ok(x, empty) = ok(m1, empty) && tr.arr(s, zb. zb.rip = t, zb pb wb. tr.at_t(zb, pb, wb), v, m1, P, W)) -> false proof
      assume e2
      obtain m1, oe1 ha from e2
      have me: m1 = x by simp(oe1)
      have st := apply(tr.run_k_stop[bkp := zb. zb.rip = t], {s}, {s}, {x}, {empty}, rk)
      have ou: tr.out(s, x) := nxt
      have ha2 := rewrite(me, ha)
      have rx := expand(mp(expand(ha2, tr.arr).1, ou), tr.retok)
      have at: tr.at_ret(s, x) by taut(rx)
      show by taut(at, nat)
    qed
    show by taut(g, k1, k2, k3, k4)
  qed
  // the stop: the claim's run stops at t, the program raising at main there
  have c3: (ex x. o = exc(x, exc_val("stop", empty)) && tr.run_k(s, zb. zb.rip = t, s, ok(x, empty)) && x.rip = t && !tr.at_ret(s, x)) ->
      tr.matches_ts(spec, args, v, mem, s, o) proof
    assume e
    obtain x, oe rk xt xnr from e
    have g := expand(mp(all_elim(sm, {ok(x, empty)}), rk), tr.gk)
    have k2: tr.crash(s, P, W, ok(x, empty)) -> false proof
      assume c
      obtain m1 a k0, {oe2 = oe} from expand(c, tr.crash)
      show by simp(oe2)
    qed
    have k3 := all_elim(tr.div_ok, {P}, {W}, {x}, {empty})
    have k4: (ex m1. ok(x, empty) = ok(m1, empty) && tr.arr(s, zb. zb.rip = t, zb pb wb. tr.at_t(zb, pb, wb), v, m1, P, W)) ->
        tr.matches_ts(spec, args, v, mem, s, o) proof
      assume e2
      obtain m1, oe1 ha from e2
      have me: m1 = x by simp(oe1)
      have ha2 := rewrite(me, ha)
      have ar2 := expand(ha2, tr.arr).2
      // (at t, below the sp: the breakpoint's relation)
      have no: !tr.out(s, x) proof
        have ou: tr.out(s, x) -> false proof
          assume ou
          have rx := expand(mp(expand(ha2, tr.arr).1, ou), tr.retok)
          have at: tr.at_ret(s, x) by taut(rx)
          show by taut(at, xnr)
        qed
        show by taut(ou)
      qed
      obtain p2 w2, rd2 att from mp(ar2, no, xt)
      have red := expand(rd2, tr.red)
      // (main entered: the stop; or undefined)
      have a1: (ex w3 v3 mem3. abi.raise_state(w3) && runs(p2, w2, exc(w3, exc_val("at_main", empty))) && w3 = abi.view(x, v3, mem3) &&
          abi.view_ok(x, v3, mem3)) -> tr.matches_ts(spec, args, v, mem, s, o) proof
        assume ea
        obtain w3 v3 mem3, rs3 ru3 we3 vo3 from ea
        have ru := mp(all_elim(red, {exc(w3, exc_val("at_main", empty))}), ru3)
        have st: tr.stop_t(spec, args, v, mem, s, o) by defs(ex_intro({x}, {w3}, {v3}, {mem3}, taut(oe, rs3, ru, we3, vo3)), tr.stop_t)
        show by defs(taut(st), tr.matches_ts)
      qed
      have a2: (ex e x3. e in univ(1) && !(e = exc_val("stack_overflow", empty)) && !(e = exc_val("at_main", empty)) && abi.raise_state(x3) &&
          runs(p2, w2, exc(x3, e))) -> tr.matches_ts(spec, args, v, mem, s, o) proof
        assume eb
        obtain e x3, eu en ea rs3 ru3 from eb
        have ru := mp(all_elim(red, {exc(x3, e)}), ru3)
        have ra: abi.raises_at(spec, args, v, mem, s) by defs(ex_intro({e}, {x3}, taut(eu, en, ea, rs3, ru)), abi.raises_at)
        show by defs(taut(ra), tr.matches_ts)
      qed
      show by taut(expand(att, tr.at_t), a1, a2)
    qed
    show by taut(g, k1, k2, k3, k4)
  qed
  show by taut(rdk, c1, c2, c3)
qed

// ----------------------------------------------------------------------
//  A call in the stop form (as tr.run_split_k): the caller's run, its
//  breakpoints and t, from the callee's entry c

// (a stop run's outcome tagged 2: a divergence, by its loop)
theorem tr.rws_div: all c t l r. while_rel(l, x5. true, x5 x6. tr.rbs(c, t, x5, x6), x5. fn_update(empty, "os.events", fst(x5).os.events), r) -> fst(r) = 2 ->
  ex t0. r = diverge(t0)
proof
  fix c t l r
  assume hw d
  have cs := mp(while_cases[l0 := l, c := x5. true, b := x5 x6. tr.rbs(c, t, x5, x6), tr := x5. fn_update(empty, "os.events", fst(x5).os.events), r := r], hw)
  have b: (ex l2. (!true && r = ok(l2, empty)) || (true && tr.rbs(c, t, l2, r) && !is_ok(r))) -> ex t0. r = diverge(t0) proof
    assume e
    obtain l2, hl from e
    have hb: tr.rbs(c, t, l2, r) by taut(hl)
    show by simp(expand(hb, tr.rbs, tr.rbd, tr.rb, bind_rel), d, keep(x86_64_linux.step))
  qed
  show by taut(cs, b)
qed

def tr.at_stop_d(s, t, x) := tr.at_stop(s, t, x)

// The callee's stop run (to some outcome of the same kind), or the callee
// returns to x and the caller's passes go on from x, or the callee leaves
// its discipline, or it stops at x -- where the caller's run stops, its
// breakpoint (the callee's sp at most the caller's, no breakpoint of the
// caller below it but t)
theorem tr.run_split_ks(zb. bkp): all s c t o. s in x86_64_linux.Machine -> int_le(abi.sp(c), abi.sp(s)) -> int_lt(c.gpr[4], abi.sp(c)) -> !(c.rip = t) ->
  (all z. int_lt(z.gpr[4], abi.sp(c)) -> !bkp(z)) -> tr.run_k(s, zb. bkp(zb) || zb.rip = t, c, o) ->
  (ex o1. tr.run_s(c, t, c, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2))) ||
  (ex x r1 o1. tr.run_s(c, t, c, ok(x, empty)) && tr.rwk(s, zb. bkp(zb) || zb.rip = t, pair(x, empty), r1) && tr.rmap(r1, o1) &&
    (o1 = o || (fst(o1) = 2 && fst(o) = 2))) ||
  (ex x. tr.run_s(c, t, c, exc(x, exc_val("disc", empty)))) ||
  (ex x. tr.run_s(c, t, c, exc(x, exc_val("stop", empty))) && o = ok(x, empty))
proof
  fix s c t o
  assume hM hsp hcl hct hbx hr
  let G := (ex o1. tr.run_s(c, t, c, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2))) ||
    (ex x r1 o1. tr.run_s(c, t, c, ok(x, empty)) && tr.rwk(s, zb. bkp(zb) || zb.rip = t, pair(x, empty), r1) && tr.rmap(r1, o1) &&
      (o1 = o || (fst(o1) = 2 && fst(o) = 2))) ||
    (ex x. tr.run_s(c, t, c, exc(x, exc_val("disc", empty)))) ||
    (ex x. tr.run_s(c, t, c, exc(x, exc_val("stop", empty))) && o = ok(x, empty))
  let P(l) := !tr.at_ret(c, fst(l)) && int_lt(fst(l).gpr[4], abi.sp(c)) && !(fst(l).rip = t)
  let EB(l) := exc(pair(fst(l), empty), pair("brk", empty))
  let ES(l) := exc(l, pair("raise", exc_val("stop", empty)))
  let ED(l) := exc(l, pair("raise", exc_val("disc", empty)))
  let E(l) := ite(tr.at_ret_d(c, fst(l)), EB(l), ite(tr.at_stop_d(c, t, fst(l)), ES(l), ED(l)))
  let TR(l) := fn_update(empty, "os.events", fst(l).os.events)
  have r4 := apply(x86i.rsp_typed, hM)
  have spb: abi.sp(s) in bits(64) by simp(r4)
  obtain r, rk hm from expand(hr, tr.run_k)
  // (inside the callee, off t: the caller's pass, the callee's stop run's)
  have pb: all l o2. P(l) -> tr.rbk(s, zb. bkp(zb) || zb.rip = t, l, o2) -> tr.rbs(c, t, l, o2) proof
    fix l o2
    assume hp hb
    have nar lt nt := hp
    have lt2: int_lt(fst(l).gpr[4], abi.sp(s)) by arith(lt, hsp)
    have nb := mp(all_elim(hbx, {fst(l)}), lt)
    have ns: !tr.stopk(s, zb. bkp(zb) || zb.rip = t, fst(l)) by defs(taut(lt2, nb, nt), tr.stopk)
    have rs: tr.rst(l, o2) by taut(expand(hb, tr.rbk), ns)
    have dok: tr.disc_ok(c, fst(l)) by taut(lt)
    have rb: tr.rb(c, l, o2) by defs(taut(nar, expand(rs, tr.rst)), tr.rb)
    have rd: tr.rbd(c, l, o2) by defs(taut(dok, rb), tr.rbd)
    show by defs(taut(nt, rd), tr.rbs)
  qed
  // (the first pass, from c: the callee's)
  have pc: P(pair(c, empty)) proof
    have ne: c.gpr[4] = abi.sp(c) -> false proof
      assume e
      show by arith(e, hcl)
    qed
    have nar: !tr.at_ret(c, c) by taut(ne)
    show by simp(nar, hcl, hct)
  qed
  have p0: all o2. tr.rst(pair(c, empty), o2) -> tr.rbs(c, t, pair(c, empty), o2) proof
    fix o2
    assume hs
    have nar lt nt := pc
    have dok: tr.disc_ok(c, fst(pair(c, empty))) by taut(lt)
    have rb: tr.rb(c, pair(c, empty), o2) by defs(taut(nar, expand(hs, tr.rst)), tr.rb)
    have rd: tr.rbd(c, pair(c, empty), o2) by defs(taut(dok, rb), tr.rbd)
    show by defs(taut(nt, rd), tr.rbs)
  qed
  have he: all l. !is_ok(E(l)) proof
    fix l
    have n: is_ok(E(l)) -> false proof
      assume h
      obtain a b, h2 from expand(h, is_ok)
      have c1: tr.at_ret_d(c, fst(l)) -> false proof
        assume ar
        have et := apply(tr.ite_t, {tr.at_ret_d(c, fst(l))}, {EB(l)}, {ite(tr.at_stop_d(c, t, fst(l)), ES(l), ED(l))}, ar)
        show by simp(rewrite(et, h2))
      qed
      have c2: !tr.at_ret_d(c, fst(l)) -> false proof
        assume nar
        have ef := apply(tr.ite_f, {tr.at_ret_d(c, fst(l))}, {EB(l)}, {ite(tr.at_stop_d(c, t, fst(l)), ES(l), ED(l))}, nar)
        have h3 := rewrite(ef, h2)
        have d1: tr.at_stop_d(c, t, fst(l)) -> false proof
          assume as
          have e2 := apply(tr.ite_t, {tr.at_stop_d(c, t, fst(l))}, {ES(l)}, {ED(l)}, as)
          show by simp(rewrite(e2, h3))
        qed
        have d2: !tr.at_stop_d(c, t, fst(l)) -> false proof
          assume nas
          have e2 := apply(tr.ite_f, {tr.at_stop_d(c, t, fst(l))}, {ES(l)}, {ED(l)}, nas)
          show by simp(rewrite(e2, h3))
        qed
        show by taut(d1, d2)
      qed
      show by taut(c1, c2)
    qed
    show by taut(n)
  qed
  // the first pass leaves: the callee's run
  have k2: tr.rst(pair(c, empty), r) && !is_ok(r) -> G proof
    assume e
    have rb := mp(all_elim(p0, {r}), e.1)
    have tt: true by taut()
    have w := mp(while_leave[l0 := pair(c, empty), c := x5. true, b := x5 x6. tr.rbs(c, t, x5, x6), tr := x5. TR(x5), r := r], tt, rb, e.2)
    have ws: tr.rws(c, t, pair(c, empty), r) by defs(w, tr.rws)
    have rs: tr.run_s(c, t, c, o) by defs(ex_intro({r}, taut(ws, hm)), tr.run_s)
    have e1: ex o1. tr.run_s(c, t, c, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2)) by ex_intro({o}, taut(rs, refl({o})))
    show by taut(e1)
  qed
  // the first pass goes on to l1: the passes from l1, cut where the callee
  // returns, leaves its discipline or stops
  have k1: (ex l1. tr.rst(pair(c, empty), ok(l1, empty)) && tr.rwk(s, zb. bkp(zb) || zb.rip = t, l1, r)) -> G proof
    assume e
    obtain l1, rs0 rw from e
    have rb0 := mp(all_elim(p0, {ok(l1, empty)}), rs0)
    have tt: true by taut()
    have q1: l1 = pair(fst(l1), empty) by simp(expand(rs0, tr.rst), keep(x86_64_linux.step))
    have hq: all l l2. l = pair(fst(l), empty) -> tr.rbk(s, zb. bkp(zb) || zb.rip = t, l, ok(l2, empty)) -> l2 = pair(fst(l2), empty) proof
      fix l l2
      assume _ hb
      have c3 := apply(tr.rbk_ok[bkp := zb. bkp(zb) || zb.rip = t], {s}, {l}, {l2}, {empty}, hb)
      show by taut(c3)
    qed
    have sp := mp(while_split[l0 := l1, b := l o2. tr.rbk(s, zb. bkp(zb) || zb.rip = t, l, o2), tr := l. TR(l), p := l. P(l), e := l. E(l), r := r,
      q := l. l = pair(fst(l), empty)], he, q1, hq, expand(rw, tr.rwk))
    // the guarded passes: the callee's
    have gb: all l o2. (P(l) && tr.rbk(s, zb. bkp(zb) || zb.rip = t, l, o2)) || (!P(l) && o2 = E(l)) -> tr.rbs(c, t, l, o2) proof
      fix l o2
      assume h
      have in: P(l) -> tr.rbs(c, t, l, o2) proof
        assume hp
        have b1: tr.rbk(s, zb. bkp(zb) || zb.rip = t, l, o2) by taut(h, hp)
        show := mp(all_elim(pb, {l}, {o2}), hp, b1)
      qed
      have out: !P(l) -> tr.rbs(c, t, l, o2) proof
        assume np
        have eo: o2 = E(l) by taut(h, np)
        have c1: tr.at_ret_d(c, fst(l)) -> tr.rbs(c, t, l, o2) proof
          assume ar
          have et := apply(tr.ite_t, {tr.at_ret_d(c, fst(l))}, {EB(l)}, {ite(tr.at_stop_d(c, t, fst(l)), ES(l), ED(l))}, ar)
          have eo2 := rewrite(et, eo)
          have ar2: tr.at_ret(c, fst(l)) by defs(ar, tr.at_ret_d)
          have rd: tr.rbd(c, l, o2) by defs(simp(eo2, ar2, keep(x86_64_linux.step)), tr.rbd, tr.rb)
          have ns: !tr.at_stop(c, t, fst(l)) by taut(ar2)
          show by defs(taut(ns, rd), tr.rbs)
        qed
        have c2: !tr.at_ret_d(c, fst(l)) -> tr.rbs(c, t, l, o2) proof
          assume nar
          have ef := apply(tr.ite_f, {tr.at_ret_d(c, fst(l))}, {EB(l)}, {ite(tr.at_stop_d(c, t, fst(l)), ES(l), ED(l))}, nar)
          have eo2 := rewrite(ef, eo)
          have nar2: !tr.at_ret(c, fst(l)) by defs(nar, tr.at_ret_d)
          have d1: tr.at_stop_d(c, t, fst(l)) -> tr.rbs(c, t, l, o2) proof
            assume as
            have e2 := apply(tr.ite_t, {tr.at_stop_d(c, t, fst(l))}, {ES(l)}, {ED(l)}, as)
            have eo3 := rewrite(e2, eo2)
            have as2: tr.at_stop(c, t, fst(l)) by defs(as, tr.at_stop_d)
            show by defs(taut(as2, eo3), tr.rbs)
          qed
          have d2: !tr.at_stop_d(c, t, fst(l)) -> tr.rbs(c, t, l, o2) proof
            assume nas
            have e2 := apply(tr.ite_f, {tr.at_stop_d(c, t, fst(l))}, {ES(l)}, {ED(l)}, nas)
            have eo3 := rewrite(e2, eo2)
            have nas2: !tr.at_stop(c, t, fst(l)) by defs(nas, tr.at_stop_d)
            have nlt: !int_lt(fst(l).gpr[4], abi.sp(c)) by taut(np, nar2, nas2)
            have rd: tr.rbd(c, l, o2) by defs(simp(eo3, nar2, nlt, keep(x86_64_linux.step)), tr.rbd, tr.rb)
            show by defs(taut(nas2, rd), tr.rbs)
          qed
          show by taut(d1, d2)
        qed
        show by taut(c1, c2)
      qed
      show by taut(in, out)
    qed
    // throughout: the callee's run (the first pass prepended)
    have ca: while_rel(l1, l. true, l o2. (P(l) && tr.rbk(s, zb. bkp(zb) || zb.rip = t, l, o2)) || (!P(l) && o2 = E(l)), l. TR(l), r) -> G proof
      assume w
      have w2 := mp(while_mono[l0 := l1, c := l. true, b1 := l o2. (P(l) && tr.rbk(s, zb. bkp(zb) || zb.rip = t, l, o2)) || (!P(l) && o2 = E(l)),
        b2 := l o2. tr.rbs(c, t, l, o2), tr := l. TR(l), r := r], gb, w)
      have nd: !(fst(r) = 2) -> G proof
        assume n
        have w3 := mp(while_step[l0 := pair(c, empty), l1 := l1, c := l. true, b := l o2. tr.rbs(c, t, l, o2), tr := l. TR(l), r := r], tt, rb0, w2, n)
        have ws: tr.rws(c, t, pair(c, empty), r) by defs(w3, tr.rws)
        have rs: tr.run_s(c, t, c, o) by defs(ex_intro({r}, taut(ws, hm)), tr.run_s)
        have e1: ex o1. tr.run_s(c, t, c, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2)) by ex_intro({o}, taut(rs, refl({o})))
        show by taut(e1)
      qed
      have dd: fst(r) = 2 -> G proof
        assume d
        obtain t0, rd0 from apply(tr.rws_div, {c}, {t}, {l1}, {r}, w2, d)
        have w2d := rewrite(rd0, w2)
        obtain t2, w3 from mp(while_step_div[l0 := pair(c, empty), l1 := l1, c := l. true, b := l o2. tr.rbs(c, t, l, o2), tr := l. TR(l), t := t0], tt, rb0, w2d)
        have ws: tr.rws(c, t, pair(c, empty), diverge(t2)) by defs(w3, tr.rws)
        have rm2: tr.rmap(diverge(t2), diverge(t2)) by defs(simp(), tr.rmap)
        have rs: tr.run_s(c, t, c, diverge(t2)) by defs(ex_intro({diverge(t2)}, taut(ws, rm2)), tr.run_s)
        have od: fst(o) = 2 by simp(expand(hm, tr.rmap), d)
        have f2: fst(diverge(t2)) = 2 by simp()
        have e1: ex o1. tr.run_s(c, t, c, o1) && (o1 = o || (fst(o1) = 2 && fst(o) = 2)) by ex_intro({diverge(t2)}, taut(rs, f2, od))
        show by taut(e1)
      qed
      show by taut(nd, dd)
    qed
    // left at l: the callee's return (the caller's passes on from it), its
    // leaving the discipline, or its stop (the caller's breakpoint)
    have cb: (ex l. l = pair(fst(l), empty) && while_rel(l1, l. true, l o2. (P(l) && tr.rbk(s, zb. bkp(zb) || zb.rip = t, l, o2)) || (!P(l) && o2 = E(l)), l. TR(l), E(l)) &&
        (ex r1. while_rel(l, l. true, l o2. tr.rbk(s, zb. bkp(zb) || zb.rip = t, l, o2), l. TR(l), r1) && fst(r1) = fst(r) && (!(fst(r) = 2) -> r1 = r))) -> G proof
      assume h
      obtain l, ql wg er1 from h
      have w2 := mp(while_mono[l0 := l1, c := l. true, b1 := l o2. (P(l) && tr.rbk(s, zb. bkp(zb) || zb.rip = t, l, o2)) || (!P(l) && o2 = E(l)),
        b2 := l o2. tr.rbs(c, t, l, o2), tr := l. TR(l), r := E(l)], gb, wg)
      have nd0: fst(E(l)) = 2 -> false proof
        assume d
        have ne := all_elim(he, {l})
        have c1: fst(E(l)) = 2 -> !is_ok(E(l)) -> false proof
          assume d2 _
          have c3: tr.at_ret_d(c, fst(l)) -> false proof
            assume ar
            have et := apply(tr.ite_t, {tr.at_ret_d(c, fst(l))}, {EB(l)}, {ite(tr.at_stop_d(c, t, fst(l)), ES(l), ED(l))}, ar)
            show by simp(rewrite(et, d2))
          qed
          have c4: !tr.at_ret_d(c, fst(l)) -> false proof
            assume nar
            have ef := apply(tr.ite_f, {tr.at_ret_d(c, fst(l))}, {EB(l)}, {ite(tr.at_stop_d(c, t, fst(l)), ES(l), ED(l))}, nar)
            have d3 := rewrite(ef, d2)
            have d5: tr.at_stop_d(c, t, fst(l)) -> false proof
              assume as
              have e2 := apply(tr.ite_t, {tr.at_stop_d(c, t, fst(l))}, {ES(l)}, {ED(l)}, as)
              show by simp(rewrite(e2, d3))
            qed
            have d6: !tr.at_stop_d(c, t, fst(l)) -> false proof
              assume nas
              have e2 := apply(tr.ite_f, {tr.at_stop_d(c, t, fst(l))}, {ES(l)}, {ED(l)}, nas)
              show by simp(rewrite(e2, d3))
            qed
            show by taut(d5, d6)
          qed
          show by taut(c3, c4)
        qed
        show by taut(c1, d, ne)
      qed
      have w3 := mp(while_step[l0 := pair(c, empty), l1 := l1, c := l. true, b := l o2. tr.rbs(c, t, l, o2), tr := l. TR(l), r := E(l)], tt, rb0, w2, taut(nd0))
      have wd: tr.rws(c, t, pair(c, empty), E(l)) by defs(w3, tr.rws)
      // (the return)
      have c1: tr.at_ret_d(c, fst(l)) -> G proof
        assume ar
        have ee := apply(tr.ite_t, {tr.at_ret_d(c, fst(l))}, {EB(l)}, {ite(tr.at_stop_d(c, t, fst(l)), ES(l), ED(l))}, ar)
        have wd2 := rewrite(ee, wd)
        have rm: tr.rmap(EB(l), ok(fst(l), empty)) by defs(simp(), tr.rmap)
        have rc: tr.run_s(c, t, c, ok(fst(l), empty)) by defs(ex_intro({EB(l)}, taut(wd2, rm)), tr.run_s)
        obtain r1, wr1 f4 re4 from er1
        have wr2 := rewrite(ql, wr1)
        have wk: tr.rwk(s, zb. bkp(zb) || zb.rip = t, pair(fst(l), empty), r1) by defs(wr2, tr.rwk)
        have same: !(fst(r) = 2) -> G proof
          assume n
          have re := mp(re4, n)
          have rm1 := rewrite(sym(re), hm)
          have e1: ex x r2 o1. tr.run_s(c, t, c, ok(x, empty)) && tr.rwk(s, zb. bkp(zb) || zb.rip = t, pair(x, empty), r2) && tr.rmap(r2, o1) &&
              (o1 = o || (fst(o1) = 2 && fst(o) = 2)) by ex_intro({fst(l)}, {r1}, {o}, taut(rc, wk, rm1, refl({o})))
          show by taut(e1)
        qed
        have div: fst(r) = 2 -> G proof
          assume d
          have d1: fst(r1) = 2 by simp(f4, d)
          have rm1: tr.rmap(r1, diverge(snd(r1))) by defs(simp(d1), tr.rmap)
          have od: fst(o) = 2 by simp(expand(hm, tr.rmap), d)
          have f2: fst(diverge(snd(r1))) = 2 by simp()
          have e1: ex x r2 o1. tr.run_s(c, t, c, ok(x, empty)) && tr.rwk(s, zb. bkp(zb) || zb.rip = t, pair(x, empty), r2) && tr.rmap(r2, o1) &&
              (o1 = o || (fst(o1) = 2 && fst(o) = 2)) by ex_intro({fst(l)}, {r1}, {diverge(snd(r1))}, taut(rc, wk, rm1, f2, od))
          show by taut(e1)
        qed
        show by taut(same, div)
      qed
      have c2: !tr.at_ret_d(c, fst(l)) -> G proof
        assume nar
        have ee := apply(tr.ite_f, {tr.at_ret_d(c, fst(l))}, {EB(l)}, {ite(tr.at_stop_d(c, t, fst(l)), ES(l), ED(l))}, nar)
        have wd2 := rewrite(ee, wd)
        // (the stop: the caller's run stops there, at t its breakpoint)
        have d1: tr.at_stop_d(c, t, fst(l)) -> G proof
          assume as
          have e2 := apply(tr.ite_t, {tr.at_stop_d(c, t, fst(l))}, {ES(l)}, {ED(l)}, as)
          have wd3 := rewrite(e2, wd2)
          have rm: tr.rmap(ES(l), exc(fst(l), exc_val("stop", empty))) by defs(simp(), tr.rmap)
          have rc: tr.run_s(c, t, c, exc(fst(l), exc_val("stop", empty))) by defs(ex_intro({ES(l)}, taut(wd3, rm)), tr.run_s)
          have as2: tr.at_stop(c, t, fst(l)) by defs(as, tr.at_stop_d)
          have xt: fst(l).rip = t by taut(as2)
          obtain r1, wr1 f4 re4 from er1
          have un3 := mp(while_unroll[l0 := l, c := x5. true, b := x5 x6. tr.rbk(s, zb. bkp(zb) || zb.rip = t, x5, x6), tr := x5. TR(x5), r := r1], wr1)
          have stk: tr.stopk(s, zb. bkp(zb) || zb.rip = t, fst(l)) by defs(taut(xt), tr.stopk)
          have bb: all o3. tr.rbk(s, zb. bkp(zb) || zb.rip = t, l, o3) -> o3 = exc(pair(fst(l), empty), pair("brk", empty)) proof
            fix o3
            assume hb
            show by taut(expand(hb, tr.rbk), stk)
          qed
          have v1: tr.rbk(s, zb. bkp(zb) || zb.rip = t, l, r1) && !is_ok(r1) -> o = ok(fst(l), empty) proof
            assume k
            have r1e := mp(all_elim(bb, {r1}), (tr.rbk(s, zb. bkp(zb) || zb.rip = t, l, r1) by taut(k)))
            have n1: !(fst(r1) = 2) by simp(r1e)
            have n0: !(fst(r) = 2) by simp(n1, f4)
            have re := mp(re4, n0)
            show by simp(expand(rewrite(r1e, rewrite(sym(re), hm)), tr.rmap))
          qed
          have v2: (ex l4. tr.rbk(s, zb. bkp(zb) || zb.rip = t, l, ok(l4, empty)) && (ex r4. while_rel(l4, x5. true, x5 x6. tr.rbk(s, zb. bkp(zb) || zb.rip = t, x5, x6),
              x5. TR(x5), r4) && fst(r4) = fst(r1) && (!(fst(r1) = 2) -> r4 = r1))) -> o = ok(fst(l), empty) proof
            assume k
            obtain l4, hb4 _ from k
            have r4e := mp(all_elim(bb, {ok(l4, empty)}), hb4)
            have f: false by simp(r4e)
            show by taut(f)
          qed
          have v0: (!true && r1 = ok(l, empty)) -> o = ok(fst(l), empty) proof
            assume k
            show by taut(k)
          qed
          have oe: o = ok(fst(l), empty) by taut(un3, v0, v1, v2)
          have e4: ex x. tr.run_s(c, t, c, exc(x, exc_val("stop", empty))) && o = ok(x, empty) by ex_intro({fst(l)}, taut(rc, oe))
          show by taut(e4)
        qed
        // (the discipline left)
        have d2: !tr.at_stop_d(c, t, fst(l)) -> G proof
          assume nas
          have e2 := apply(tr.ite_f, {tr.at_stop_d(c, t, fst(l))}, {ES(l)}, {ED(l)}, nas)
          have wd3 := rewrite(e2, wd2)
          have rm: tr.rmap(ED(l), exc(fst(l), exc_val("disc", empty))) by defs(simp(), tr.rmap)
          have rc: tr.run_s(c, t, c, exc(fst(l), exc_val("disc", empty))) by defs(ex_intro({ED(l)}, taut(wd3, rm)), tr.run_s)
          have e1: ex x. tr.run_s(c, t, c, exc(x, exc_val("disc", empty))) by ex_intro({fst(l)}, rc)
          show by taut(e1)
        qed
        show by taut(d1, d2)
      qed
      show by taut(c1, c2)
    qed
    show by taut(sp, ca, cb)
  qed
  show by taut(expand(rk, tr.rk), k1, k2)
qed

// ----------------------------------------------------------------------
//  The function at t (main): entered, the run stops

// (a run from t stops there at once)
theorem tr.run_s_at: all s t m o. m.rip = t -> !tr.at_ret(s, m) -> int_lt(m.gpr[4], abi.sp(s)) -> tr.run_s(s, t, m, o) -> o = exc(m, exc_val("stop", empty))
proof
  fix s t m o
  assume hr hna hlt h
  obtain r, hw hm from expand(h, tr.run_s)
  have u := mp(while_unroll[l0 := pair(m, empty), c := x5. true, b := x5 x6. tr.rbs(s, t, x5, x6), tr := x5. fn_update(empty, "os.events", fst(x5).os.events), r := r],
    expand(hw, tr.rws))
  // (the first pass: the stop)
  have st: all o2. tr.rbs(s, t, pair(m, empty), o2) -> o2 = exc(pair(m, empty), pair("raise", exc_val("stop", empty))) proof
    fix o2
    assume b
    have fe: fst(pair(m, empty)) = m by simp()
    show by taut(rewrite(fe, expand(b, tr.rbs)), hr, hna, hlt)
  qed
  have c2: tr.rbs(s, t, pair(m, empty), r) -> o = exc(m, exc_val("stop", empty)) proof
    assume b
    have re := mp(all_elim(st, {r}), b)
    show by simp(rewrite(re, expand(hm, tr.rmap)))
  qed
  have c3: (ex l1. tr.rbs(s, t, pair(m, empty), ok(l1, empty)) && (ex r1. while_rel(l1, x5. true, x5 x6. tr.rbs(s, t, x5, x6), x5. fn_update(empty, "os.events", fst(x5).os.events), r1) &&
      fst(r1) = fst(r) && (!(fst(r) = 2) -> r1 = r))) -> false proof
    assume e
    obtain l1, b _ from e
    have re := mp(all_elim(st, {ok(l1, empty)}), b)
    show by simp(re)
  qed
  show by taut(u, c2, c3)
qed

// a function at t whose spec, from its entry's world, raises at main in
// that world (or raises): its contract with the stop at t
theorem tr.stop_entry: all f spec base code statics.
  (all args objs mem s. args in abi.ARGS -> s in x86_64_linux.Machine -> abi.view_ok(s, objs, mem) ->
     abi.raises_at(spec, args, objs, mem, s) ||
     (abi.raise_state(abi.view(s, objs, mem)) && runs(spec[args], abi.view(s, objs, mem), exc(abi.view(s, objs, mem), exc_val("at_main", empty))))) ->
  tr.implements_stop(f, spec, f, base, code, statics)
proof
  fix f spec base code statics
  assume hsp
  have g: all args objs mem s o. args in abi.ARGS -> objs in set_type(omega) -> mem in x86_64_linux.Vm -> s in x86_64_linux.Machine -> s in univ(1) -> abi.loaded(s.vm, base, code, statics) ->
      s.rip = f -> abi.entry_ok(s, args) -> tr.objs_ok(s, objs) -> abi.view_ok(s, objs, mem) -> tr.run_s(s, f, s, o) -> tr.matches_ts(spec, args, objs, mem, s, o) proof
    fix args objs mem s o
    assume hA _ _ hM _ _ hrip he _ hwm hr
    // (the entry within its discipline: rsp below its sp, so not at its
    // return)
    have r4 := apply(x86i.rsp_typed, hM)
    have _ _ _ slt := apply(tr.entry_stack_u, hM, apply(tr.entry_ok_u_of, hM, he))
    have lt := apply(tr.sp_lt, {s.gpr[4]}, r4, slt)
    have ne: s.gpr[4] = abi.sp(s) -> false proof
      assume e
      show by arith(e, lt)
    qed
    have na: !tr.at_ret(s, s) by taut(ne)
    have oe := apply(tr.run_s_at[s := s, t := f, m := s, o := o], hrip, na, lt, hr)
    have c := mp(all_elim(hsp, {args}, {objs}, {mem}, {s}), hA, hM, hwm)
    have c2: abi.raise_state(abi.view(s, objs, mem)) && runs(spec[args], abi.view(s, objs, mem), exc(abi.view(s, objs, mem), exc_val("at_main", empty))) ->
        tr.stop_t(spec, args, objs, mem, s, o) proof
      assume hb
      have rs ru := hb
      show by defs(ex_intro({s}, {abi.view(s, objs, mem)}, {objs}, {mem}, taut(oe, rs, ru, refl({abi.view(s, objs, mem)}), hwm)), tr.stop_t)
    qed
    show by defs(taut(c, c2), tr.matches_ts)
  qed
  show by defs(g, tr.implements_stop)
qed
