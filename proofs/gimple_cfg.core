// A function's readable CFG (`slc gimple --readable --cfg`) refines its
// structured form (`--readable`): the C2 proofs, about the structured
// form, carried to the CFG, which C1 relates to the machine code
// (proofs/translate_cfg.core).
//
// The CFG is a loop over its blocks (`while_rel` with condition true, the
// state l = pair(world, locals), the block to run among the locals); its
// rest k after the loop (a return, a raise: the loop only leaves that
// way). A simulation inv relates each CFG state to a program of the
// structured form (the rest of it from the matching point): from a
// related state, a block going on reaches a related state whose program's
// runs are the first one's; a block leaving gives a run of the related
// program. Then every run of the CFG from a related state is one of its
// program: the theorem by cut points, proofs/gimple_cut.core.

// ----------------------------------------------------------------------
//  The refinement walk: a run of the CFG's side (a relation l of the
//  outcome) is one of the structured side (a program q, from s). A point's
//  claim is proven by walking both sides at once: the same operation,
//  condition, choice on both by congruence (the same terms: no operation's
//  meaning), one side's reductions on their own.

def g.ref(o. l, q, s) := all o. l(o) -> pair(s, o) in univ(1) -> runs(q, s, o)

// (the universe: of a pair, its parts; a pair of two)
theorem g.pair_univ: all a b. a in univ(1) -> b in univ(1) -> pair(a, b) in univ(1)
proof
  fix a b
  assume ha hb
  show by simp(ha, hb)
qed

theorem g.univ_fst: all a b. pair(a, b) in univ(1) -> a in univ(1)
proof
  fix a b
  assume h
  have f := apply(tr.fst_univ, {pair(a, b)}, h)
  show by simp(f)
qed

theorem g.univ_snd: all a b. pair(a, b) in univ(1) -> b in univ(1)
proof
  fix a b
  assume h
  have m1: upair(a, b) in pair(a, b) by defs(upair_r[a := single(a), b := upair(a, b)], pair)
  have su := mp(univ_trans[u := 1, a := upair(a, b), b := pair(a, b)], h, m1)
  show := mp(univ_trans[u := 1, a := b, b := upair(a, b)], su, upair_r[a := a, b := b])
qed

// one side's step: the CFG's (its runs among the next relation's), the
// structured side's (the next program's runs among its)
theorem g.ref_low(o. l, o. l2, q): all s. (all o. l(o) -> l2(o)) -> g.ref(o. l2(o), q, s) -> g.ref(o. l(o), q, s)
proof
  fix s
  assume hl h
  have g: all o. l(o) -> pair(s, o) in univ(1) -> runs(q, s, o) proof
    fix o
    assume a u
    show := mp(all_elim(expand(h, g.ref), {o}), mp(all_elim(hl, {o}), a), u)
  qed
  show by defs(g, g.ref)
qed

theorem g.ref_up(o. l, q, q2): all s. g.ref(o. l(o), q2, s) -> (all o. runs(q2, s, o) -> runs(q, s, o)) -> g.ref(o. l(o), q, s)
proof
  fix s
  assume h hq
  have g: all o. l(o) -> pair(s, o) in univ(1) -> runs(q, s, o) proof
    fix o
    assume a u
    show := mp(all_elim(hq, {o}), mp(all_elim(expand(h, g.ref), {o}), a, u))
  qed
  show by defs(g, g.ref)
qed

// (an outcome's world: of the universe, the run's)
theorem g.ok_univ: all s s1 v. pair(s, ok(s1, v)) in univ(1) -> s1 in univ(1)
proof
  fix s s1 v
  assume h
  have u1 := apply(g.univ_snd, {s}, {ok(s1, v)}, h)
  have u2: pair(0, pair(s1, v)) in univ(1) := expand(u1, ok, tag)
  have u3 := apply(g.univ_snd, {0}, {pair(s1, v)}, u2)
  show := apply(g.univ_fst, {s1}, {v}, u3)
qed

theorem g.exc_univ: all s s1 e. pair(s, exc(s1, e)) in univ(1) -> s1 in univ(1)
proof
  fix s s1 e
  assume h
  have u1 := apply(g.univ_snd, {s}, {exc(s1, e)}, h)
  have u2: pair(1, pair(s1, e)) in univ(1) := expand(u1, exc, tag)
  have u3 := apply(g.univ_snd, {1}, {pair(s1, e)}, u2)
  show := apply(g.univ_fst, {s1}, {e}, u3)
qed

// The same operation on both sides (the CFG's at its world s, the
// structured side's at its program's): the rest after each outcome
theorem g.ref_op(op, s v x8. ka, s e x8. xa, t x8. da, x8 o. kl, s v x8. kb, s e x8. xb, t x8. db, x8 o. ku): all s.
  (all r. runs(op, s, r) -> pair(s, r) in univ(1)) ->
  (all s1 v. g.ref(o. ex x8. ka(s1, v, x8) && kl(x8, o), mkprog(x0 x1. ex x8. kb(s1, v, x8) && ku(x8, x1)), s1)) ->
  (all s1 e. g.ref(o. ex x8. xa(s1, e, x8) && kl(x8, o), mkprog(x0 x1. ex x8. xb(s1, e, x8) && ku(x8, x1)), s1)) ->
  (all t. g.ref(o. ex x8. da(t, x8) && kl(x8, o), mkprog(x0 x1. ex x8. db(t, x8) && ku(x8, x1)), s)) ->
  g.ref(o. ex x8. bind_rel(op, s, x9 x10. ka(x9, x10, x8), x9 x10. xa(x9, x10, x8), x9. da(x9, x8)) && kl(x8, o),
    mkprog(x0 x1. ex x8. bind_rel(op, x0, x9 x10. kb(x9, x10, x8), x9 x10. xb(x9, x10, x8), x9. db(x9, x8)) && ku(x8, x1)), s)
proof
  fix s
  assume hu hok hex hdv
  have g: all o. (ex x8. bind_rel(op, s, x9 x10. ka(x9, x10, x8), x9 x10. xa(x9, x10, x8), x9. da(x9, x8)) && kl(x8, o)) -> pair(s, o) in univ(1) ->
      runs(mkprog(x0 x1. ex x8. bind_rel(op, x0, x9 x10. kb(x9, x10, x8), x9 x10. xb(x9, x10, x8), x9. db(x9, x8)) && ku(x8, x1)), s, o) proof
    fix o
    assume hl ho
    obtain x8, hb hk from hl
    obtain r, hr hc from expand(hb, bind_rel)
    have ru := mp(all_elim(hu, {r}), hr)
    have oU := apply(g.univ_snd, {s}, {o}, ho)
    have c1: (ex s1 v. r = ok(s1, v) && ka(s1, v, x8)) -> runs(mkprog(x0 x1. ex x8. bind_rel(op, x0, x9 x10. kb(x9, x10, x8), x9 x10. xb(x9, x10, x8), x9. db(x9, x8)) && ku(x8, x1)), s, o) proof
      assume e
      obtain s1 v, er k1 from e
      have s1u := apply(g.ok_univ, {s}, {s1}, {v}, rewrite(er, ru))
      have pu := apply(g.pair_univ, {s1}, {o}, s1u, oU)
      have l1: ex x8. ka(s1, v, x8) && kl(x8, o) by ex_intro({x8}, taut(k1, hk))
      have r1 := mp(all_elim(expand(all_elim(hok, {s1}, {v}), g.ref), {o}), l1, pu)
      obtain y8, kb1 ku1 from apply(g.runs_elim, r1)
      have e2: ex s2 v2. r = ok(s2, v2) && kb(s2, v2, y8) by ex_intro({s1}, {v}, taut(er, kb1))
      have bu: bind_rel(op, s, x9 x10. kb(x9, x10, y8), x9 x10. xb(x9, x10, y8), x9. db(x9, y8)) by defs(ex_intro({r}, taut(hr, e2)), bind_rel)
      have ub: ex x8. bind_rel(op, s, x9 x10. kb(x9, x10, x8), x9 x10. xb(x9, x10, x8), x9. db(x9, x8)) && ku(x8, o) by ex_intro({y8}, taut(bu, ku1))
      show := apply(tr.runs_intro[r := x0 x1. ex x8. bind_rel(op, x0, x9 x10. kb(x9, x10, x8), x9 x10. xb(x9, x10, x8), x9. db(x9, x8)) && ku(x8, x1)], {s}, {o}, ho, ub)
    qed
    have c2: (ex s1 e. r = exc(s1, e) && xa(s1, e, x8)) -> runs(mkprog(x0 x1. ex x8. bind_rel(op, x0, x9 x10. kb(x9, x10, x8), x9 x10. xb(x9, x10, x8), x9. db(x9, x8)) && ku(x8, x1)), s, o) proof
      assume e
      obtain s1 e1, er k1 from e
      have s1u := apply(g.exc_univ, {s}, {s1}, {e1}, rewrite(er, ru))
      have pu := apply(g.pair_univ, {s1}, {o}, s1u, oU)
      have l1: ex x8. xa(s1, e1, x8) && kl(x8, o) by ex_intro({x8}, taut(k1, hk))
      have r1 := mp(all_elim(expand(all_elim(hex, {s1}, {e1}), g.ref), {o}), l1, pu)
      obtain y8, kb1 ku1 from apply(g.runs_elim, r1)
      have e2: ex s2 e2. r = exc(s2, e2) && xb(s2, e2, y8) by ex_intro({s1}, {e1}, taut(er, kb1))
      have bu: bind_rel(op, s, x9 x10. kb(x9, x10, y8), x9 x10. xb(x9, x10, y8), x9. db(x9, y8)) by defs(ex_intro({r}, taut(hr, e2)), bind_rel)
      have ub: ex x8. bind_rel(op, s, x9 x10. kb(x9, x10, x8), x9 x10. xb(x9, x10, x8), x9. db(x9, x8)) && ku(x8, o) by ex_intro({y8}, taut(bu, ku1))
      show := apply(tr.runs_intro[r := x0 x1. ex x8. bind_rel(op, x0, x9 x10. kb(x9, x10, x8), x9 x10. xb(x9, x10, x8), x9. db(x9, x8)) && ku(x8, x1)], {s}, {o}, ho, ub)
    qed
    have c3: (ex t. r = diverge(t) && da(t, x8)) -> runs(mkprog(x0 x1. ex x8. bind_rel(op, x0, x9 x10. kb(x9, x10, x8), x9 x10. xb(x9, x10, x8), x9. db(x9, x8)) && ku(x8, x1)), s, o) proof
      assume e
      obtain t, er k1 from e
      have l1: ex x8. da(t, x8) && kl(x8, o) by ex_intro({x8}, taut(k1, hk))
      have r1 := mp(all_elim(expand(all_elim(hdv, {t}), g.ref), {o}), l1, ho)
      obtain y8, kb1 ku1 from apply(g.runs_elim, r1)
      have e2: ex t2. r = diverge(t2) && db(t2, y8) by ex_intro({t}, taut(er, kb1))
      have bu: bind_rel(op, s, x9 x10. kb(x9, x10, y8), x9 x10. xb(x9, x10, y8), x9. db(x9, y8)) by defs(ex_intro({r}, taut(hr, e2)), bind_rel)
      have ub: ex x8. bind_rel(op, s, x9 x10. kb(x9, x10, x8), x9 x10. xb(x9, x10, x8), x9. db(x9, x8)) && ku(x8, o) by ex_intro({y8}, taut(bu, ku1))
      show := apply(tr.runs_intro[r := x0 x1. ex x8. bind_rel(op, x0, x9 x10. kb(x9, x10, x8), x9 x10. xb(x9, x10, x8), x9. db(x9, x8)) && ku(x8, x1)], {s}, {o}, ho, ub)
    qed
    show by taut(hc, c1, c2, c3)
  qed
  show by defs(g, g.ref)
qed

// The same condition on both sides: each way on its own
theorem g.ref_if(c, x8. a1, x8. a2, x8 o. kl, x0 x8. b1, x0 x8. b2, x8 o. ku): all s.
  (c -> g.ref(o. ex x8. a1(x8) && kl(x8, o), mkprog(x0 x1. ex x8. b1(x0, x8) && ku(x8, x1)), s)) ->
  (!c -> g.ref(o. ex x8. a2(x8) && kl(x8, o), mkprog(x0 x1. ex x8. b2(x0, x8) && ku(x8, x1)), s)) ->
  g.ref(o. ex x8. ((c && a1(x8)) || (!c && a2(x8))) && kl(x8, o), mkprog(x0 x1. ex x8. ((c && b1(x0, x8)) || (!c && b2(x0, x8))) && ku(x8, x1)), s)
proof
  fix s
  assume h1 h2
  have g: all o. (ex x8. ((c && a1(x8)) || (!c && a2(x8))) && kl(x8, o)) -> pair(s, o) in univ(1) ->
      runs(mkprog(x0 x1. ex x8. ((c && b1(x0, x8)) || (!c && b2(x0, x8))) && ku(x8, x1)), s, o) proof
    fix o
    assume hl ho
    obtain x8, ha hk from hl
    have t1: c -> runs(mkprog(x0 x1. ex x8. ((c && b1(x0, x8)) || (!c && b2(x0, x8))) && ku(x8, x1)), s, o) proof
      assume hc
      have l1: ex x8. a1(x8) && kl(x8, o) by ex_intro({x8}, taut(ha, hk, hc))
      obtain y8, b y from apply(g.runs_elim, mp(all_elim(expand(mp(h1, hc), g.ref), {o}), l1, ho))
      have u: ex x8. ((c && b1(s, x8)) || (!c && b2(s, x8))) && ku(x8, o) by ex_intro({y8}, taut(b, y, hc))
      show := apply(tr.runs_intro[r := x0 x1. ex x8. ((c && b1(x0, x8)) || (!c && b2(x0, x8))) && ku(x8, x1)], {s}, {o}, ho, u)
    qed
    have t2: !c -> runs(mkprog(x0 x1. ex x8. ((c && b1(x0, x8)) || (!c && b2(x0, x8))) && ku(x8, x1)), s, o) proof
      assume hc
      have l1: ex x8. a2(x8) && kl(x8, o) by ex_intro({x8}, taut(ha, hk, hc))
      obtain y8, b y from apply(g.runs_elim, mp(all_elim(expand(mp(h2, hc), g.ref), {o}), l1, ho))
      have u: ex x8. ((c && b1(s, x8)) || (!c && b2(s, x8))) && ku(x8, o) by ex_intro({y8}, taut(b, y, hc))
      show := apply(tr.runs_intro[r := x0 x1. ex x8. ((c && b1(x0, x8)) || (!c && b2(x0, x8))) && ku(x8, x1)], {s}, {o}, ho, u)
    qed
    show by taut(t1, t2)
  qed
  show by defs(g, g.ref)
qed

// (the same condition, the structured side's ways the other way round:
// its first under the negation)
theorem g.ref_ifn(c, x8. a1, x8. a2, x8 o. kl, x0 x8. b1, x0 x8. b2, x8 o. ku): all s.
  (c -> g.ref(o. ex x8. a1(x8) && kl(x8, o), mkprog(x0 x1. ex x8. b1(x0, x8) && ku(x8, x1)), s)) ->
  (!c -> g.ref(o. ex x8. a2(x8) && kl(x8, o), mkprog(x0 x1. ex x8. b2(x0, x8) && ku(x8, x1)), s)) ->
  g.ref(o. ex x8. ((c && a1(x8)) || (!c && a2(x8))) && kl(x8, o), mkprog(x0 x1. ex x8. ((!c && b2(x0, x8)) || (!!c && b1(x0, x8))) && ku(x8, x1)), s)
proof
  fix s
  assume h1 h2
  have g: all o. (ex x8. ((c && a1(x8)) || (!c && a2(x8))) && kl(x8, o)) -> pair(s, o) in univ(1) ->
      runs(mkprog(x0 x1. ex x8. ((!c && b2(x0, x8)) || (!!c && b1(x0, x8))) && ku(x8, x1)), s, o) proof
    fix o
    assume hl ho
    obtain x8, ha hk from hl
    have t1: c -> runs(mkprog(x0 x1. ex x8. ((!c && b2(x0, x8)) || (!!c && b1(x0, x8))) && ku(x8, x1)), s, o) proof
      assume hc
      have l1: ex x8. a1(x8) && kl(x8, o) by ex_intro({x8}, taut(ha, hk, hc))
      obtain y8, b y from apply(g.runs_elim, mp(all_elim(expand(mp(h1, hc), g.ref), {o}), l1, ho))
      have u: ex x8. ((!c && b2(s, x8)) || (!!c && b1(s, x8))) && ku(x8, o) by ex_intro({y8}, taut(b, y, hc))
      show := apply(tr.runs_intro[r := x0 x1. ex x8. ((!c && b2(x0, x8)) || (!!c && b1(x0, x8))) && ku(x8, x1)], {s}, {o}, ho, u)
    qed
    have t2: !c -> runs(mkprog(x0 x1. ex x8. ((!c && b2(x0, x8)) || (!!c && b1(x0, x8))) && ku(x8, x1)), s, o) proof
      assume hc
      have l1: ex x8. a2(x8) && kl(x8, o) by ex_intro({x8}, taut(ha, hk, hc))
      obtain y8, b y from apply(g.runs_elim, mp(all_elim(expand(mp(h2, hc), g.ref), {o}), l1, ho))
      have u: ex x8. ((!c && b2(s, x8)) || (!!c && b1(s, x8))) && ku(x8, o) by ex_intro({y8}, taut(b, y, hc))
      show := apply(tr.runs_intro[r := x0 x1. ex x8. ((!c && b2(x0, x8)) || (!!c && b1(x0, x8))) && ku(x8, x1)], {s}, {o}, ho, u)
    qed
    show by taut(t1, t2)
  qed
  show by defs(g, g.ref)
qed

// The same choice on both sides (from a domain not empty): each value
theorem g.ref_any(x. d, x x8. a, x8 o. kl, x0 x x8. b, x8 o. ku): all s. (ex x. d(x)) ->
  (all c. d(c) -> g.ref(o. ex x8. a(c, x8) && kl(x8, o), mkprog(x0 x1. ex x8. b(x0, c, x8) && ku(x8, x1)), s)) ->
  g.ref(o. ex x8. any_rel(x. d(x), x. a(x, x8)) && kl(x8, o), mkprog(x0 x1. ex x8. any_rel(x. d(x), x. b(x0, x, x8)) && ku(x8, x1)), s)
proof
  fix s
  assume hne h
  have g: all o. (ex x8. any_rel(x. d(x), x. a(x, x8)) && kl(x8, o)) -> pair(s, o) in univ(1) ->
      runs(mkprog(x0 x1. ex x8. any_rel(x. d(x), x. b(x0, x, x8)) && ku(x8, x1)), s, o) proof
    fix o
    assume hl ho
    obtain x8, ha hk from hl
    have ex1: ex x. d(x) && a(x, x8) by taut(expand(ha, any_rel), hne)
    obtain c, dc ac from ex1
    have l1: ex x8. a(c, x8) && kl(x8, o) by ex_intro({x8}, taut(ac, hk))
    obtain y8, b y from apply(g.runs_elim, mp(all_elim(expand(mp(all_elim(h, {c}), dc), g.ref), {o}), l1, ho))
    have e1: ex x. d(x) && b(s, x, y8) by ex_intro({c}, taut(dc, b))
    have an: any_rel(x. d(x), x. b(s, x, y8)) by defs(taut(e1), any_rel)
    have u: ex x8. any_rel(x. d(x), x. b(s, x, x8)) && ku(x8, o) by ex_intro({y8}, taut(an, y))
    show := apply(tr.runs_intro[r := x0 x1. ex x8. any_rel(x. d(x), x. b(x0, x, x8)) && ku(x8, x1)], {s}, {o}, ho, u)
  qed
  show by defs(g, g.ref)
qed

// the CFG's side on its own: a disjunct whose guard does not hold
// dropped, one whose guard holds taken; blocks nested to the right; a
// block outcome named
theorem g.low_orl(p, x8. a, x8. r, x8 o. k): !p -> all o. (ex x8. ((p && a(x8)) || r(x8)) && k(x8, o)) -> ex x8. r(x8) && k(x8, o)
proof
  assume hp
  fix o
  assume h
  obtain x8, h1 h2 from h
  show by ex_intro({x8}, taut(h1, h2, hp))
qed

theorem g.low_orr(p, x8. a, x8. r, x8 o. k): !p -> all o. (ex x8. (r(x8) || (p && a(x8))) && k(x8, o)) -> ex x8. r(x8) && k(x8, o)
proof
  assume hp
  fix o
  assume h
  obtain x8, h1 h2 from h
  show by ex_intro({x8}, taut(h1, h2, hp))
qed

theorem g.low_and(p, x8. a, x8 o. k): p -> all o. (ex x8. (p && a(x8)) && k(x8, o)) -> ex x8. a(x8) && k(x8, o)
proof
  assume hp
  fix o
  assume h
  obtain x8, h1 h2 h3 from h
  show by ex_intro({x8}, taut(h2, h3))
qed

theorem g.low_assoc(x9. a, x9 x8. k1, x8 o. k2): all o. (ex x8. (ex x9. a(x9) && k1(x9, x8)) && k2(x8, o)) -> ex x9. a(x9) && (ex x8. k1(x9, x8) && k2(x8, o))
proof
  fix o
  assume h
  obtain x8, h1 h2 from h
  obtain x9, a9 k9 from h1
  have e: ex x8. k1(x9, x8) && k2(x8, o) by ex_intro({x8}, taut(k9, h2))
  show by ex_intro({x9}, taut(a9, e))
qed

theorem g.low_eq(e, x8 o. k): all o. (ex x8. x8 = e && k(x8, o)) -> k(e, o)
proof
  fix o
  assume h
  obtain x8, h1 h2 from h
  show := rewrite(h1, h2)
qed

// The leaves: the CFG going on at a state related to the structured
// side's rest; the same result on both sides
theorem g.ref_jump(l q. inv): all l2 q s. inv(l2, q) -> s = fst(l2) ->
  g.ref(o. all q2. inv(l2, q2) -> pair(fst(l2), o) in univ(1) -> runs(q2, fst(l2), o), q, s)
proof
  fix l2 q s
  assume hi hs
  have g: all o. (all q2. inv(l2, q2) -> pair(fst(l2), o) in univ(1) -> runs(q2, fst(l2), o)) -> pair(s, o) in univ(1) -> runs(q, s, o) proof
    fix o
    assume h ho
    have ho2: pair(fst(l2), o) in univ(1) := rewrite(hs, ho)
    show := rewrite(sym(hs), mp(all_elim(h, {q}), hi, ho2))
  qed
  show by defs(g, g.ref)
qed

theorem g.ref_eq(e): all s. g.ref(o. o = e, mkprog(x0 x1. x1 = e), s)
proof
  fix s
  have g: all o. o = e -> pair(s, o) in univ(1) -> runs(mkprog(x0 x1. x1 = e), s, o) proof
    fix o
    assume h ho
    show := apply(tr.runs_intro[r := x0 x1. x1 = e], {s}, {o}, ho, h)
  qed
  show by defs(g, g.ref)
qed

// (the CFG's side: a let's value in place; any relation as a block whose
// outcome is the run's)
theorem g.low_let(e, x x8. a, x8 o. k): all o. (ex x8. letin(e, x. a(x, x8)) && k(x8, o)) -> ex x8. a(e, x8) && k(x8, o)
proof
  fix o
  assume h
  obtain x8, h1 h2 from h
  have a1: a(e, x8) := expand(h1, letin)
  show by ex_intro({x8}, taut(a1, h2))
qed

theorem g.low_intro(o. l): all o. l(o) -> ex x8. l(x8) && x8 = o
proof
  fix o
  assume h
  show by ex_intro({o}, taut(h, refl({o})))
qed

// ----------------------------------------------------------------------
//  The CFG's side on its own: every outcome of a block has p (a block's
//  ways on: to related states, a lower rank)

def g.post(o. l, o. p) := all o. l(o) -> p(o)

theorem g.post_low(o. l, o. l2, o. p): (all o. l(o) -> l2(o)) -> g.post(o. l2(o), o. p(o)) -> g.post(o. l(o), o. p(o))
proof
  assume hl h
  have g: all o. l(o) -> p(o) proof
    fix o
    assume a
    show := mp(all_elim(expand(h, g.post), {o}), mp(all_elim(hl, {o}), a))
  qed
  show by defs(g, g.post)
qed

theorem g.post_op(op, s v x8. ka, s e x8. xa, t x8. da, x8 o. kl, o. p): all s.
  (all s1 v. g.post(o. ex x8. ka(s1, v, x8) && kl(x8, o), o. p(o))) ->
  (all s1 e. g.post(o. ex x8. xa(s1, e, x8) && kl(x8, o), o. p(o))) ->
  (all t. g.post(o. ex x8. da(t, x8) && kl(x8, o), o. p(o))) ->
  g.post(o. ex x8. bind_rel(op, s, x9 x10. ka(x9, x10, x8), x9 x10. xa(x9, x10, x8), x9. da(x9, x8)) && kl(x8, o), o. p(o))
proof
  fix s
  assume hok hex hdv
  have g: all o. (ex x8. bind_rel(op, s, x9 x10. ka(x9, x10, x8), x9 x10. xa(x9, x10, x8), x9. da(x9, x8)) && kl(x8, o)) -> p(o) proof
    fix o
    assume hl
    obtain x8, hb hk from hl
    obtain r, hr hc from expand(hb, bind_rel)
    have c1: (ex s1 v. r = ok(s1, v) && ka(s1, v, x8)) -> p(o) proof
      assume e
      obtain s1 v, er k1 from e
      have l1: ex x8. ka(s1, v, x8) && kl(x8, o) by ex_intro({x8}, taut(k1, hk))
      show := mp(all_elim(expand(all_elim(hok, {s1}, {v}), g.post), {o}), l1)
    qed
    have c2: (ex s1 e. r = exc(s1, e) && xa(s1, e, x8)) -> p(o) proof
      assume e
      obtain s1 e1, er k1 from e
      have l1: ex x8. xa(s1, e1, x8) && kl(x8, o) by ex_intro({x8}, taut(k1, hk))
      show := mp(all_elim(expand(all_elim(hex, {s1}, {e1}), g.post), {o}), l1)
    qed
    have c3: (ex t. r = diverge(t) && da(t, x8)) -> p(o) proof
      assume e
      obtain t, er k1 from e
      have l1: ex x8. da(t, x8) && kl(x8, o) by ex_intro({x8}, taut(k1, hk))
      show := mp(all_elim(expand(all_elim(hdv, {t}), g.post), {o}), l1)
    qed
    show by taut(hc, c1, c2, c3)
  qed
  show by defs(g, g.post)
qed

theorem g.post_if(c, x8. a1, x8. a2, x8 o. kl, o. p):
  (c -> g.post(o. ex x8. a1(x8) && kl(x8, o), o. p(o))) -> (!c -> g.post(o. ex x8. a2(x8) && kl(x8, o), o. p(o))) ->
  g.post(o. ex x8. ((c && a1(x8)) || (!c && a2(x8))) && kl(x8, o), o. p(o))
proof
  assume h1 h2
  have g: all o. (ex x8. ((c && a1(x8)) || (!c && a2(x8))) && kl(x8, o)) -> p(o) proof
    fix o
    assume hl
    obtain x8, ha hk from hl
    have t1: c -> p(o) proof
      assume hc
      have l1: ex x8. a1(x8) && kl(x8, o) by ex_intro({x8}, taut(ha, hk, hc))
      show := mp(all_elim(expand(mp(h1, hc), g.post), {o}), l1)
    qed
    have t2: !c -> p(o) proof
      assume hc
      have l1: ex x8. a2(x8) && kl(x8, o) by ex_intro({x8}, taut(ha, hk, hc))
      show := mp(all_elim(expand(mp(h2, hc), g.post), {o}), l1)
    qed
    show by taut(t1, t2)
  qed
  show by defs(g, g.post)
qed

theorem g.post_eq(e, o. p): p(e) -> g.post(o. o = e, o. p(o))
proof
  assume h
  have g: all o. o = e -> p(o) proof
    fix o
    assume he
    show := rewrite(sym(he), h)
  qed
  show by defs(g, g.post)
qed

// ----------------------------------------------------------------------
//  The points: inv a disjunction, a point's claim at its label's states

theorem g.inv_none(l q. G): all l q. false -> G(l, q)
proof
  fix l q
  assume h
  show by taut(h)
qed

theorem g.inv_or(l q. G, l q. A, l q. B): (all l q. A(l, q) -> G(l, q)) -> (all l q. B(l, q) -> G(l, q)) -> all l q. A(l, q) || B(l, q) -> G(l, q)
proof
  assume ha hb
  fix l q
  assume h
  have c1 := all_elim(ha, {l}, {q})
  have c2 := all_elim(hb, {l}, {q})
  show by taut(h, c1, c2)
qed

// ----------------------------------------------------------------------
//  The function wrappers (`F_fun`): the same, but for the procedure called
//  -- refined by its refinement

theorem g.wrap_ref1(x. c, p1, p2, s v o. k, s e o. x, t o. d): (all s r. runs(p1, s, r) -> runs(p2, s, r)) ->
  all s o. runs(mkprog(x1 x2. c(x1) || bind_rel(p1, x1, y v. k(y, v, x2), y e. x(y, e, x2), t. d(t, x2))), s, o) ->
    runs(mkprog(x1 x2. c(x1) || bind_rel(p2, x1, y v. k(y, v, x2), y e. x(y, e, x2), t. d(t, x2))), s, o)
proof
  assume h
  fix s o
  assume hr
  have u := apply(g.runs_univ, hr)
  have b := apply(g.runs_elim, hr)
  have c2: bind_rel(p1, s, y v. k(y, v, o), y e. x(y, e, o), t. d(t, o)) -> bind_rel(p2, s, y v. k(y, v, o), y e. x(y, e, o), t. d(t, o)) proof
    assume hb
    obtain r, r1 rc from expand(hb, bind_rel)
    have r2 := mp(all_elim(h, {s}, {r}), r1)
    show by defs(ex_intro({r}, taut(r2, rc)), bind_rel)
  qed
  have g: c(s) || bind_rel(p2, s, y v. k(y, v, o), y e. x(y, e, o), t. d(t, o)) by taut(b, c2)
  show := apply(tr.runs_intro[r := x1 x2. c(x1) || bind_rel(p2, x1, y v. k(y, v, x2), y e. x(y, e, x2), t. d(t, x2))], {s}, {o}, u, g)
qed

theorem g.wrap_ref0(p1, p2, s v o. k, s e o. x, t o. d): (all s r. runs(p1, s, r) -> runs(p2, s, r)) ->
  all s o. runs(mkprog(x1 x2. bind_rel(p1, x1, y v. k(y, v, x2), y e. x(y, e, x2), t. d(t, x2))), s, o) ->
    runs(mkprog(x1 x2. bind_rel(p2, x1, y v. k(y, v, x2), y e. x(y, e, x2), t. d(t, x2))), s, o)
proof
  assume h
  fix s o
  assume hr
  have u := apply(g.runs_univ, hr)
  have b := apply(g.runs_elim, hr)
  obtain r, r1 rc from expand(b, bind_rel)
  have r2 := mp(all_elim(h, {s}, {r}), r1)
  have g: bind_rel(p2, s, y v. k(y, v, o), y e. x(y, e, o), t. d(t, o)) by defs(ex_intro({r}, taut(r2, rc)), bind_rel)
  show := apply(tr.runs_intro[r := x1 x2. bind_rel(p2, x1, y v. k(y, v, x2), y e. x(y, e, x2), t. d(t, x2))], {s}, {o}, u, g)
qed

// ... and the function: each argument list's program
theorem g.fun_ref(d, x. v1, x. v2): (all a s o. a in d -> runs(v1(a), s, o) -> runs(v2(a), s, o)) ->
  all a s o. runs(fn_build(d, x. v1(x))[a], s, o) -> runs(fn_build(d, x. v2(x))[a], s, o)
proof
  assume h
  fix a s o
  assume hr
  have e := apply(runs_fn_build[d := d, v := x. v1(x), a := a, s := s, o := o], hr)
  have r2 := mp(all_elim(h, {a}, {s}, {o}), e.1, e.2)
  have ea := apply(app_fn_build[d := d, v := x. v2(x), a := a], e.1)
  show := rewrite(sym(ea), r2)
qed

// (the CFG's loop as a walk's claim)
theorem g.ref_cfg(l, q, l o. b, l. tr, x8 o. k): (all r o. while_rel(l, x. true, x y. b(x, y), x. tr(x), r) -> k(r, o) -> pair(fst(l), o) in univ(1) -> runs(q, fst(l), o)) ->
  g.ref(o. ex x8. while_rel(l, x. true, x y. b(x, y), x. tr(x), x8) && k(x8, o), q, fst(l))
proof
  assume h
  have g: all o. (ex x8. while_rel(l, x. true, x y. b(x, y), x. tr(x), x8) && k(x8, o)) -> pair(fst(l), o) in univ(1) -> runs(q, fst(l), o) proof
    fix o
    assume hl hu
    obtain r, hw hk from hl
    show := mp(all_elim(h, {r}, {o}), hw, hk, hu)
  qed
  show by defs(g, g.ref)
qed

// (the CFG side's disjuncts whose guards do not hold, all dropped)
theorem g.low_orl2(x8. a, x8. r, x8 o. k): (all x8. !r(x8)) -> all o. (ex x8. (a(x8) || r(x8)) && k(x8, o)) -> ex x8. a(x8) && k(x8, o)
proof
  assume hr
  fix o
  assume h
  obtain x8, h1 h2 from h
  have n := all_elim(hr, {x8})
  show by ex_intro({x8}, taut(h1, h2, n))
qed

// (a choice of a word: from a domain not empty)
theorem g.bits_ne: all n. n in omega -> ex x. x in bits(n)
proof
  fix n
  assume hn
  have z: 0 in bits(n) by simp(hn)
  show by ex_intro({0}, z)
qed

// (a point: its label k, its locals' shape sh -- components free, a
// literal, the same as another --, its program u; its claim for every
// world and components)
theorem g.inv_pt2(l q. G, k, y. sh, y. u): (all w y. G(pair(w, pair(k, sh(y))), u(y))) ->
  all l q. (ex y. l = pair(fst(l), pair(k, sh(y))) && q = u(y)) -> G(l, q)
proof
  assume h
  fix l q
  assume e
  obtain y, e1 e2 from e
  have g := all_elim(h, {fst(l)}, {y})
  have g1 := subst({x. G(x, u(y))}, sym(e1), g)
  show := subst({x. G(l, x)}, sym(e2), g1)
qed

theorem g.inv_intro(k, y. sh, y. u): all l q y. l = pair(fst(l), pair(k, sh(y))) -> q = u(y) -> ex y2. l = pair(fst(l), pair(k, sh(y2))) && q = u(y2)
proof
  fix l q y
  assume e1 e2
  show by ex_intro({y}, taut(e1, e2))
qed

// (a block's every outcome ok(l2): Q(l2))
theorem g.post_use(x8. b, l2. Q): g.post(o. ex x8. b(x8) && x8 = o, o. all l2. o = ok(l2, empty) -> Q(l2)) -> all l2. b(ok(l2, empty)) -> Q(l2)
proof
  assume h
  fix l2
  assume hb
  have l1: ex x8. b(x8) && x8 = ok(l2, empty) by ex_intro({ok(l2, empty)}, taut(hb, refl({ok(l2, empty)})))
  have p := mp(all_elim(expand(h, g.post), {ok(l2, empty)}), l1)
  show := mp(all_elim(p, {l2}), refl({ok(l2, empty)}))
qed

// (the CFG's iteration ending: going on at e, or leaving to its rest)
theorem g.low_nx(e, l2 o. j, o. k): all o. ((ex l2. ok(e, empty) = ok(l2, empty) && j(l2, o)) || (!is_ok(ok(e, empty)) && k(o))) -> j(e, o)
proof
  fix o
  assume h
  have ok1: is_ok(ok(e, empty)) by defs(ex_intro({e}, {empty}, refl({ok(e, empty)})), is_ok)
  have h2: ex l2. ok(e, empty) = ok(l2, empty) && j(l2, o) by taut(h, ok1)
  obtain l2, e1 j1 from h2
  have e2: e = l2 by simp(e1)
  show := rewrite(sym(e2), j1)
qed

theorem g.low_nx2(e, l2 o. j, o. k): !is_ok(e) -> all o. ((ex l2. e = ok(l2, empty) && j(l2, o)) || (!is_ok(e) && k(o))) -> k(o)
proof
  assume hn
  fix o
  assume h
  have n1: (ex l2. e = ok(l2, empty) && j(l2, o)) -> false proof
    assume e1
    obtain l2, e2 j2 from e1
    have ok2: is_ok(e) by defs(ex_intro({l2}, {empty}, e2), is_ok)
    show by taut(ok2, hn)
  qed
  show by taut(h, n1)
qed

theorem g.post_exc(a, b, l2. Q): all l2. exc(a, b) = ok(l2, empty) -> Q(l2)
proof
  fix l2
  assume e
  have f: false by defs(simp(e), exc, ok, tag)
  show by taut(f)
qed

theorem g.post_div(a, l2. Q): all l2. diverge(a) = ok(l2, empty) -> Q(l2)
proof
  fix l2
  assume e
  have f: false by defs(simp(e), diverge, ok, tag)
  show by taut(f)
qed

theorem g.not_ok_exc: all a b. !is_ok(exc(a, b))
proof
  fix a b
  have g: (ex s v. exc(a, b) = ok(s, v)) -> false proof
    assume e
    obtain s v, e1 from e
    show by defs(simp(e1), exc, ok, tag)
  qed
  show by defs(taut(g), is_ok)
qed

theorem g.not_ok_div: all a. !is_ok(diverge(a))
proof
  fix a
  have g: (ex s v. diverge(a) = ok(s, v)) -> false proof
    assume e
    obtain s v, e1 from e
    show by defs(simp(e1), diverge, ok, tag)
  qed
  show by defs(taut(g), is_ok)
qed

// (the CFG side: a term written by an equation)
theorem g.low_rw(o x. l, a, b): a = b -> all o. l(o, a) -> l(o, b)
proof
  assume e
  fix o
  assume h
  show := subst({x. l(o, x)}, e, h)
qed

// (a disjunction refuted: each side's leading guard false)
theorem g.nor(a, b): !a -> !b -> !(a || b)
proof
  assume ha hb
  show by taut(ha, hb)
qed

theorem g.nand(p, a): !p -> !(p && a)
proof
  assume hp
  show by taut(hp)
qed

// (a named outcome, its equation the other way round)
theorem g.low_eqr(e, x8 o. k): all o. (ex x8. e = x8 && k(x8, o)) -> k(e, o)
proof
  fix o
  assume h
  obtain x8, h1 h2 from h
  show := rewrite(sym(h1), h2)
qed

// (the result, its equation the other way round)
theorem g.low_sym(e): all o. e = o -> o = e
proof
  fix o
  assume h
  show := sym(h)
qed

theorem g.low_orr2(x8. a, x8. r, x8 o. k): (all x8. !a(x8)) -> all o. (ex x8. (a(x8) || r(x8)) && k(x8, o)) -> ex x8. r(x8) && k(x8, o)
proof
  assume ha
  fix o
  assume h
  obtain x8, h1 h2 from h
  have n := all_elim(ha, {x8})
  show by ex_intro({x8}, taut(h1, h2, n))
qed

theorem g.snd_diverge(t): snd(diverge(t)) = t
proof
  show by defs(simp(), diverge, tag)
qed

// (the world, a projection taken in it)
theorem g.ref_wrw(o. l, q, x. c, a, b): a = b -> g.ref(o. l(o), q, c(b)) -> g.ref(o. l(o), q, c(a))
proof
  assume e h
  show := subst({x. g.ref(o. l(o), q, c(x))}, sym(e), h)
qed

// (the CFG side's call of its layer's callee: of the structured layer's,
// by the callee's refinement)
theorem g.low_op(p1, p2, s, s1 v x8. ka, s1 e x8. xa, t x8. da, x8 o. kl): (all r. runs(p1, s, r) -> runs(p2, s, r)) ->
  all o. (ex x8. bind_rel(p1, s, x9 x10. ka(x9, x10, x8), x9 x10. xa(x9, x10, x8), x9. da(x9, x8)) && kl(x8, o)) ->
    ex x8. bind_rel(p2, s, x9 x10. ka(x9, x10, x8), x9 x10. xa(x9, x10, x8), x9. da(x9, x8)) && kl(x8, o)
proof
  assume h
  fix o
  assume hl
  obtain x8, hb hk from hl
  obtain r, r1 rc from expand(hb, bind_rel)
  have r2 := mp(all_elim(h, {r}), r1)
  have b2: bind_rel(p2, s, x9 x10. ka(x9, x10, x8), x9 x10. xa(x9, x10, x8), x9. da(x9, x8)) by defs(ex_intro({r}, taut(r2, rc)), bind_rel)
  show by ex_intro({x8}, taut(b2, hk))
qed

// (a block's rest whose last step is the outcome itself: without it)
theorem g.low_kid(x8. a, x8 x9. k): all o. (ex x8. a(x8) && (ex x9. k(x8, x9) && x9 = o)) -> ex x8. a(x8) && k(x8, o)
proof
  fix o
  assume h
  obtain x8, ha hk from h
  obtain x9, k1 e from hk
  show by ex_intro({x8}, taut(ha, rewrite(e, k1)))
qed

// (the world, by an equation)
theorem g.ref_ws(o. l, q, a, b): a = b -> g.ref(o. l(o), q, a) -> g.ref(o. l(o), q, b)
proof
  assume e h
  show := subst({x. g.ref(o. l(o), q, x)}, e, h)
qed
