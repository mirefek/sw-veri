// Reading mallocng's invariant (layers/mallocng.sl): the allocator's
// bytes (the footprint's pieces), GIMPLE's reads of them as the
// invariant's view, a used meta's bytes and fields, the class table,
// what starts in a slot and its header. Lemmas for the functions'
// meaning-level proofs (proofs/mallocng_purpose.core).

// ----------------------------------------------------------------------
//  The allocator's bytes: a group's, no client's (the footprint's ranges)

theorem mp.ro_list(f): f in seq_type(bits(8)) -> mallocng.ro_ranges(f) in list_type(univ(1))
proof
  assume hf
  have pn: x86_64_linux.phnum(f) in omega by defs(mp(x86.le_at_nat[f := f, off := 56, n := 2], hf, simp()), x86_64_linux.phnum)
  have d: int_sub(x86_64_linux.phnum(f), 0) in omega by arith(pn)
  have vt: all i. i in int_sub(x86_64_linux.phnum(f), 0) -> ite(x86_64_linux.is_load(f, int_add(0, i)) && !bit(app(x86_64_linux.segment(f, int_add(0, i)), "flags"), 1), pair(app(x86_64_linux.segment(f, int_add(0, i)), "vaddr"), app(x86_64_linux.segment(f, int_add(0, i)), "memsz")), pair(0, 0)) in univ(1) proof
    fix i
    assume hi
    have v1 := mp(x86.le_at_nat[f := f, off := int_add(x86_64_linux.ph(f, int_add(0, i)), 16), n := 8], hf, simp())
    have v2 := mp(x86.le_at_nat[f := f, off := int_add(x86_64_linux.ph(f, int_add(0, i)), 40), n := 8], hf, simp())
    show by defs(simp(v1, v2), x86_64_linux.segment)
  qed
  show by defs(apply(build_list, d, vt), mallocng.ro_ranges)
qed

// the ranges before the groups' (the image, the data, the auxiliary
// vector, the meta areas, the reserve, the class table): a list
theorem mp.pre_list(c, A): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs ->
  seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(mallocng.ro_ranges(app(c, "file")), mallocng.data_ranges(c)), mallocng.auxv_ranges(A)),
    fn_build(int_sub(seq_len(app(A, "areas")), 0), x0. pair(app(app(A, "areas"), int_add(0, x0)), 4096))),
    seq_one(pair(app(A, "reserve"), int_mul(4096, app(A, "reserve_cnt"))))), seq_one(pair(app(c, "sct"), int_mul(2, 48)))) in list_type(univ(1))
proof
  assume hc hu ha
  have ro := apply(mp.ro_list, (app(c, "file") in seq_type(bits(8)) by simp(hc)))
  have cf: app(c, "ctx") in omega && app(c, "lock") in omega && app(c, "libc") in omega && app(c, "sct") in omega by simp(hc)
  have o1 := apply(tr.seq_one_type, (pair(app(c, "ctx"), mallocng.CTX_SIZE) in univ(1) by simp(cf)))
  have o2 := apply(tr.seq_one_type, (pair(app(c, "lock"), 4) in univ(1) by simp(cf)))
  have o3 := apply(tr.seq_one_type, (pair(app(c, "libc"), 16) in univ(1) by simp(cf)))
  have dl: mallocng.data_ranges(c) in list_type(univ(1)) by defs(apply(tr.concat_list, apply(tr.concat_list, o1, o2), o3), mallocng.data_ranges)
  have al: app(A, "auxv") in list_type(cart(omega, omega)) by simp(ha)
  have ad: int_sub(seq_len(app(A, "auxv")), 0) in omega by arith(al)
  have av: all x0. x0 in int_sub(seq_len(app(A, "auxv")), 0) -> ite(fst(app(app(A, "auxv"), int_add(0, x0))) = x86_64_linux.AT_RANDOM, pair(int_add(snd(app(app(A, "auxv"), int_add(0, x0))), 8), 8), pair(0, 0)) in univ(1) proof
    fix x0
    assume hx
    show by simp(hu)
  qed
  have a1 := apply(tr.seq_one_type, (pair(app(A, "auxv_at"), int_mul(16, seq_len(app(A, "auxv")))) in univ(1) by simp(hu)))
  have xl: mallocng.auxv_ranges(A) in list_type(univ(1)) by defs(apply(tr.concat_list, a1, apply(build_list, ad, av)), mallocng.auxv_ranges)
  have rl: app(A, "areas") in list_type(omega) by simp(ha)
  have rd: int_sub(seq_len(app(A, "areas")), 0) in omega by arith(rl)
  have rv: all x0. x0 in int_sub(seq_len(app(A, "areas")), 0) -> pair(app(app(A, "areas"), int_add(0, x0)), 4096) in univ(1) proof
    fix x0
    assume hx
    show by simp(hu)
  qed
  have arl := apply(build_list, rd, rv)
  have res := apply(tr.seq_one_type, (pair(app(A, "reserve"), int_mul(4096, app(A, "reserve_cnt"))) in univ(1) by simp(hu)))
  have tb := apply(tr.seq_one_type, (pair(app(c, "sct"), int_mul(2, 48)) in univ(1) by simp(cf)))
  show := apply(tr.concat_list, apply(tr.concat_list, apply(tr.concat_list, apply(tr.concat_list, apply(tr.concat_list, ro, dl), xl), arl), res), tb)
qed

// a byte of a group in use, no client's: the allocator's
theorem mp.group_fp(c, A, b, k, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs ->
  k in omega -> int_lt(k, seq_len(app(A, "used"))) -> a in omega ->
  mallocng.in_range(a, mallocng.group_range(app(app(A, "metas"), app(app(A, "used"), k)))) -> !(a in malloc.live_of(b)) -> !mallocng.in_reserved(A, a) ->
  a in mallocng.footprint(c, A, b)
proof
  assume hc hu ha hk hkl hao hr hl hnr
  let USED := fn_build(int_sub(seq_len(app(A, "used")), 0), x0. mallocng.group_range(app(app(A, "metas"), app(app(A, "used"), int_add(0, x0)))))
  have pre := apply(mp.pre_list, hc, hu, ha)
  have ul: app(A, "used") in list_type(omega) by simp(ha)
  have ud: int_sub(seq_len(app(A, "used")), 0) in omega by arith(ul)
  have uv: all x0. x0 in int_sub(seq_len(app(A, "used")), 0) -> mallocng.group_range(app(app(A, "metas"), app(app(A, "used"), int_add(0, x0)))) in univ(1) proof
    fix x0
    assume hx
    show by defs(simp(hu), mallocng.group_range, mallocng.stride)
  qed
  have usl := apply(build_list, ud, uv)
  have kl2: int_lt(k, int_sub(seq_len(app(A, "used")), 0)) by arith(ul, hk, hkl)
  have dl: seq_len(USED) = int_sub(seq_len(app(A, "used")), 0)
    by defs(fn_build_dom[d := int_sub(seq_len(app(A, "used")), 0), v := x0. mallocng.group_range(app(app(A, "metas"), app(app(A, "used"), int_add(0, x0))))], seq_len)
  have kin := mp(nat_lt_mem[k := k, n := int_sub(seq_len(app(A, "used")), 0)], hk, ud, kl2)
  have w: ex j. j in omega && (int_lt(j, seq_len(USED)) && mallocng.in_range(a, app(USED, j)))
    by ex_intro({k}, simp(hk, kin, kl2, hr, dl))
  have ir := mp(ex_at_concat_r[a := seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(mallocng.ro_ranges(app(c, "file")), mallocng.data_ranges(c)), mallocng.auxv_ranges(A)),
    fn_build(int_sub(seq_len(app(A, "areas")), 0), x0. pair(app(app(A, "areas"), int_add(0, x0)), 4096))),
    seq_one(pair(app(A, "reserve"), int_mul(4096, app(A, "reserve_cnt"))))), seq_one(pair(app(c, "sct"), int_mul(2, 48)))), b := USED, t := univ(1), p := r. mallocng.in_range(a, r)], pre, usl, w)
  have irs: mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) by defs(ir, mallocng.in_ranges, mallocng.fp_ranges, mallocng.fixed_ranges)
  have inn: a in mallocng.fp_set(mallocng.fp_ranges(c, A), b) by defs(sel(taut(hao, irs, hl)), mallocng.fp_set)
  show by defs(sel(taut(hao, inn, hnr)), mallocng.footprint)
qed

// (a byte in a range of a piece: in one of the whole list)
theorem mp.ranges_l(a, xs, ys): xs in list_type(univ(1)) -> ys in list_type(univ(1)) -> mallocng.in_ranges(a, xs) -> mallocng.in_ranges(a, seq_concat(xs, ys))
proof
  assume hx hy hr
  show by defs(mp(ex_at_concat_l[a := xs, b := ys, t := univ(1), p := r. mallocng.in_range(a, r)], hx, hy, expand(hr, mallocng.in_ranges)), mallocng.in_ranges)
qed

theorem mp.ranges_r(a, xs, ys): xs in list_type(univ(1)) -> ys in list_type(univ(1)) -> mallocng.in_ranges(a, ys) -> mallocng.in_ranges(a, seq_concat(xs, ys))
proof
  assume hx hy hr
  show by defs(mp(ex_at_concat_r[a := xs, b := ys, t := univ(1), p := r. mallocng.in_range(a, r)], hx, hy, expand(hr, mallocng.in_ranges)), mallocng.in_ranges)
qed

// the footprint's pieces: the image's and the data's, the auxiliary
// vector's, the meta areas', the reserve's, the class table's, the groups'
theorem mp.fp_pieces(c, A): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs ->
  front: seq_concat(seq_concat(mallocng.ro_ranges(app(c, "file")), mallocng.data_ranges(c)), mallocng.auxv_ranges(A)) in list_type(univ(1)) &&
  areas: fn_build(int_sub(seq_len(app(A, "areas")), 0), x0. pair(app(app(A, "areas"), int_add(0, x0)), 4096)) in list_type(univ(1)) &&
  reserve: seq_one(pair(app(A, "reserve"), int_mul(4096, app(A, "reserve_cnt")))) in list_type(univ(1)) &&
  classes: seq_one(pair(app(c, "sct"), int_mul(2, 48))) in list_type(univ(1)) &&
  groups: fn_build(int_sub(seq_len(app(A, "used")), 0), x0. mallocng.group_range(app(app(A, "metas"), app(app(A, "used"), int_add(0, x0))))) in list_type(univ(1))
proof
  assume hc hu ha
  have ro := apply(mp.ro_list, (app(c, "file") in seq_type(bits(8)) by simp(hc)))
  have cf: app(c, "ctx") in omega && app(c, "lock") in omega && app(c, "libc") in omega && app(c, "sct") in omega by simp(hc)
  have o1 := apply(tr.seq_one_type, (pair(app(c, "ctx"), mallocng.CTX_SIZE) in univ(1) by simp(cf)))
  have o2 := apply(tr.seq_one_type, (pair(app(c, "lock"), 4) in univ(1) by simp(cf)))
  have o3 := apply(tr.seq_one_type, (pair(app(c, "libc"), 16) in univ(1) by simp(cf)))
  have dl: mallocng.data_ranges(c) in list_type(univ(1)) by defs(apply(tr.concat_list, apply(tr.concat_list, o1, o2), o3), mallocng.data_ranges)
  have al: app(A, "auxv") in list_type(cart(omega, omega)) by simp(ha)
  have ad: int_sub(seq_len(app(A, "auxv")), 0) in omega by arith(al)
  have av: all x0. x0 in int_sub(seq_len(app(A, "auxv")), 0) -> ite(fst(app(app(A, "auxv"), int_add(0, x0))) = x86_64_linux.AT_RANDOM, pair(int_add(snd(app(app(A, "auxv"), int_add(0, x0))), 8), 8), pair(0, 0)) in univ(1) proof
    fix x0
    assume hx
    show by simp(hu)
  qed
  have a1 := apply(tr.seq_one_type, (pair(app(A, "auxv_at"), int_mul(16, seq_len(app(A, "auxv")))) in univ(1) by simp(hu)))
  have xl: mallocng.auxv_ranges(A) in list_type(univ(1)) by defs(apply(tr.concat_list, a1, apply(build_list, ad, av)), mallocng.auxv_ranges)
  have rl: app(A, "areas") in list_type(omega) by simp(ha)
  have rd: int_sub(seq_len(app(A, "areas")), 0) in omega by arith(rl)
  have rv: all x0. x0 in int_sub(seq_len(app(A, "areas")), 0) -> pair(app(app(A, "areas"), int_add(0, x0)), 4096) in univ(1) proof
    fix x0
    assume hx
    show by simp(hu)
  qed
  have arl := apply(build_list, rd, rv)
  have res := apply(tr.seq_one_type, (pair(app(A, "reserve"), int_mul(4096, app(A, "reserve_cnt"))) in univ(1) by simp(hu)))
  have tb := apply(tr.seq_one_type, (pair(app(c, "sct"), int_mul(2, 48)) in univ(1) by simp(cf)))
  have ul: app(A, "used") in list_type(omega) by simp(ha)
  have ud: int_sub(seq_len(app(A, "used")), 0) in omega by arith(ul)
  have uv: all x0. x0 in int_sub(seq_len(app(A, "used")), 0) -> mallocng.group_range(app(app(A, "metas"), app(app(A, "used"), int_add(0, x0)))) in univ(1) proof
    fix x0
    assume hx
    show by defs(simp(hu), mallocng.group_range, mallocng.stride)
  qed
  have usl := apply(build_list, ud, uv)
  show by taut(apply(tr.concat_list, apply(tr.concat_list, ro, dl), xl), arl, res, tb, usl)
qed

// a byte of one of those ranges, no client's: the allocator's
theorem mp.fp_intro(c, A, b, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> a in omega -> !(a in malloc.live_of(b)) -> !mallocng.in_reserved(A, a) ->
  (mallocng.in_ranges(a, seq_concat(seq_concat(mallocng.ro_ranges(app(c, "file")), mallocng.data_ranges(c)), mallocng.auxv_ranges(A))) ||
   mallocng.in_ranges(a, fn_build(int_sub(seq_len(app(A, "areas")), 0), x0. pair(app(app(A, "areas"), int_add(0, x0)), 4096))) ||
   mallocng.in_ranges(a, seq_one(pair(app(A, "reserve"), int_mul(4096, app(A, "reserve_cnt"))))) ||
   mallocng.in_ranges(a, seq_one(pair(app(c, "sct"), int_mul(2, 48)))) ||
   mallocng.in_ranges(a, fn_build(int_sub(seq_len(app(A, "used")), 0), x0. mallocng.group_range(app(app(A, "metas"), app(app(A, "used"), int_add(0, x0))))))) ->
  a in mallocng.footprint(c, A, b)
proof
  assume hc hu ha hao hl hnr hr
  have p1 p2 p3 p4 p5 := apply(mp.fp_pieces, hc, hu, ha)
  let L1 := seq_concat(seq_concat(mallocng.ro_ranges(app(c, "file")), mallocng.data_ranges(c)), mallocng.auxv_ranges(A))
  let L2 := seq_concat(L1, fn_build(int_sub(seq_len(app(A, "areas")), 0), x0. pair(app(app(A, "areas"), int_add(0, x0)), 4096)))
  let L3 := seq_concat(L2, seq_one(pair(app(A, "reserve"), int_mul(4096, app(A, "reserve_cnt")))))
  let L4 := seq_concat(L3, seq_one(pair(app(c, "sct"), int_mul(2, 48))))
  have t2 := apply(tr.concat_list, p1, p2)
  have t3 := apply(tr.concat_list, t2, p3)
  have t4 := apply(tr.concat_list, t3, p4)
  // into the whole list: each piece's ranges are the list's
  have u4: mallocng.in_ranges(a, L4) -> mallocng.in_ranges(a, seq_concat(L4, fn_build(int_sub(seq_len(app(A, "used")), 0), x0. mallocng.group_range(app(app(A, "metas"), app(app(A, "used"), int_add(0, x0))))))) proof
    assume h
    show := apply(mp.ranges_l, t4, p5, h)
  qed
  have u3: mallocng.in_ranges(a, L3) -> mallocng.in_ranges(a, L4) proof
    assume h
    show := apply(mp.ranges_l, t3, p4, h)
  qed
  have u2: mallocng.in_ranges(a, L2) -> mallocng.in_ranges(a, L3) proof
    assume h
    show := apply(mp.ranges_l, t2, p3, h)
  qed
  have u1: mallocng.in_ranges(a, L1) -> mallocng.in_ranges(a, L2) proof
    assume h
    show := apply(mp.ranges_l, p1, p2, h)
  qed
  have r2: mallocng.in_ranges(a, fn_build(int_sub(seq_len(app(A, "areas")), 0), x0. pair(app(app(A, "areas"), int_add(0, x0)), 4096))) -> mallocng.in_ranges(a, L2) proof
    assume h
    show := apply(mp.ranges_r, p1, p2, h)
  qed
  have r3: mallocng.in_ranges(a, seq_one(pair(app(A, "reserve"), int_mul(4096, app(A, "reserve_cnt"))))) -> mallocng.in_ranges(a, L3) proof
    assume h
    show := apply(mp.ranges_r, t2, p3, h)
  qed
  have r4: mallocng.in_ranges(a, seq_one(pair(app(c, "sct"), int_mul(2, 48)))) -> mallocng.in_ranges(a, L4) proof
    assume h
    show := apply(mp.ranges_r, t3, p4, h)
  qed
  have r5: mallocng.in_ranges(a, fn_build(int_sub(seq_len(app(A, "used")), 0), x0. mallocng.group_range(app(app(A, "metas"), app(app(A, "used"), int_add(0, x0)))))) ->
      mallocng.in_ranges(a, seq_concat(L4, fn_build(int_sub(seq_len(app(A, "used")), 0), x0. mallocng.group_range(app(app(A, "metas"), app(app(A, "used"), int_add(0, x0))))))) proof
    assume h
    show := apply(mp.ranges_r, t4, p5, h)
  qed
  have all: mallocng.in_ranges(a, seq_concat(L4, fn_build(int_sub(seq_len(app(A, "used")), 0), x0. mallocng.group_range(app(app(A, "metas"), app(app(A, "used"), int_add(0, x0))))))) by taut(hr, u1, u2, u3, u4, r2, r3, r4, r5)
  have irs: mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) by defs(all, mallocng.fp_ranges, mallocng.fixed_ranges)
  have inn: a in mallocng.fp_set(mallocng.fp_ranges(c, A), b) by defs(sel(taut(hao, irs, hl)), mallocng.fp_set)
  show by defs(sel(taut(hao, inn, hnr)), mallocng.footprint)
qed

// the bytes the invariant reads (`held`): the footprint's but the
// context's free ones -- outside the context, or at a word it reads
theorem mp.held_intro(c, A, b, a): a in mallocng.footprint(c, A, b) -> !mallocng.ctx_free(c, a) -> a in mallocng.held(c, A, b)
proof
  assume hf hn
  have s1 := set_select_def[s := omega, p := y. y in mallocng.fp_set(mallocng.fp_ranges(c, A), b) && !mallocng.in_reserved(A, y), z := a]
  have ao: a in omega by taut(s1, expand(hf, mallocng.footprint))
  have s2 := set_select_def[s := omega, p := y. y in mallocng.footprint(c, A, b) && !mallocng.ctx_free(c, y), z := a]
  show by defs(taut(s2, ao, hf, hn), mallocng.held)
qed

theorem mp.held_fp(c, A, b, a): a in mallocng.held(c, A, b) -> fp: a in mallocng.footprint(c, A, b) && free: !mallocng.ctx_free(c, a)
proof
  assume h
  have s2 := set_select_def[s := omega, p := y. y in mallocng.footprint(c, A, b) && !mallocng.ctx_free(c, y), z := a]
  show by taut(s2, expand(h, mallocng.held))
qed

// (a byte outside the context: not free)
theorem mp.held_out(c, A, b, a): a in mallocng.footprint(c, A, b) -> !mallocng.in_range(a, pair(app(c, "ctx"), mallocng.CTX_SIZE)) -> a in mallocng.held(c, A, b)
proof
  assume hf ho
  have ho2: !(int_le(app(c, "ctx"), a) && int_lt(a, int_add(app(c, "ctx"), mallocng.CTX_SIZE))) by simp(expand(ho, mallocng.in_range))
  have cs: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  have n: !mallocng.ctx_free(c, a) by defs(arith(ho2, cs), mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_META_SHIFT, mallocng.C_USAGE, mallocng.C_BRK)
  show := apply(mp.held_intro, hf, n)
qed

// (a byte in the k-th element's range of a list built elementwise)
theorem mp.ranges_build(a, n, x. r, k): n in omega -> k in omega -> int_lt(k, n) -> mallocng.in_range(a, r(k)) ->
  mallocng.in_ranges(a, fn_build(int_sub(n, 0), x. r(int_add(0, x))))
proof
  assume hn hk hl hr
  have d: int_sub(n, 0) in omega by arith(hn)
  have kl: int_lt(k, int_sub(n, 0)) by arith(hn, hk, hl)
  have kin := mp(nat_lt_mem[k := k, n := int_sub(n, 0)], hk, d, kl)
  have dl: seq_len(fn_build(int_sub(n, 0), x. r(int_add(0, x)))) = int_sub(n, 0) by defs(fn_build_dom[d := int_sub(n, 0), v := x. r(int_add(0, x))], seq_len)
  have z: int_add(0, k) = k by arith(hk)
  have ak: app(fn_build(int_sub(n, 0), x. r(int_add(0, x))), k) = r(k) by simp(kin, z)
  have w: ex j. j in omega && (int_lt(j, seq_len(fn_build(int_sub(n, 0), x. r(int_add(0, x))))) && mallocng.in_range(a, app(fn_build(int_sub(n, 0), x. r(int_add(0, x))), j)))
    by ex_intro({k}, taut(hk, rewrite(sym(dl), kl), rewrite(sym(ak), hr)))
  show by defs(w, mallocng.in_ranges)
qed

// (a group in use: its group_ok)
theorem mp.used_group(A, M, b, g): mallocng.used_ok(A, M, b) -> mallocng.is_used(A, g) -> mallocng.group_ok(A, M, b, g)
proof
  assume uo hg
  obtain k, hk hkl hkg from expand(hg, mallocng.is_used)
  show := rewrite(hkg, mp(all_elim(expand(uo, mallocng.used_ok), {k}), hk, hkl))
qed

// a group's slots: its stride a natural (an individually mapped group's
// one slot, or its class's size)
theorem mp.stride_nat(A, M, b, g): A in mallocng.Abs -> g in omega -> mallocng.group_ok(A, M, b, g) -> mallocng.stride(app(app(A, "metas"), g)) in omega
proof
  assume ha hg hok
  let V := app(app(A, "metas"), g)
  have vt: V in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := app(A, "metas"), x := g], simp(ha), hg)
  have vm: app(V, "maplen") in omega by simp(vt)
  have vs: app(V, "sizeclass") in omega by simp(vt)
  have {sc = cls, big0 = big} := expand(hok, mallocng.group_ok)
  have big: app(V, "sizeclass") = 63 -> app(V, "last_idx") = 0 && int_lt(0, app(V, "maplen")) by taut(expand(big0, mallocng.big_ok))
  have c1: app(V, "last_idx") = 0 && int_lt(0, app(V, "maplen")) -> mallocng.stride(V) in omega proof
    assume h
    have e := mp(ite_t[c := app(V, "last_idx") = 0 && int_lt(0, app(V, "maplen")), a := int_sub(int_mul(app(V, "maplen"), 4096), mallocng.UNIT), b := int_mul(mallocng.UNIT, app(mallocng.size_classes, app(V, "sizeclass")))], h)
    have l0: int_lt(0, app(V, "maplen")) by taut(h)
    have m: int_sub(int_mul(app(V, "maplen"), 4096), mallocng.UNIT) in omega by defs(arith(vm, l0), mallocng.UNIT)
    show by defs(rewrite(sym(e), m), mallocng.stride)
  qed
  have c2: !(app(V, "last_idx") = 0 && int_lt(0, app(V, "maplen"))) -> mallocng.stride(V) in omega proof
    assume h
    have s48: int_lt(app(V, "sizeclass"), 48) by taut(sc, big, h)
    have sn := mp(all_elim(ms.sc_nat, {app(V, "sizeclass")}), vs, s48)
    have e := mp(ite_f[c := app(V, "last_idx") = 0 && int_lt(0, app(V, "maplen")), a := int_sub(int_mul(app(V, "maplen"), 4096), mallocng.UNIT), b := int_mul(mallocng.UNIT, app(mallocng.size_classes, app(V, "sizeclass")))], h)
    have sn1: app(mallocng.size_classes, app(V, "sizeclass")) in omega by taut(sn)
    have m: int_mul(mallocng.UNIT, app(mallocng.size_classes, app(V, "sizeclass"))) in omega by defs(arith(sn1), mallocng.UNIT)
    show by defs(rewrite(sym(e), m), mallocng.stride)
  qed
  show by taut(c1, c2)
qed

// a slot's interior: in its group's bytes
theorem mp.slot_in_group(A, M, b, g, i, a): A in mallocng.Abs -> g in omega -> i in omega -> a in omega -> mallocng.group_ok(A, M, b, g) ->
  int_lt(i, seq_len(app(app(A, "slots"), g))) -> mallocng.in_slot(app(app(A, "metas"), g), i, a) ->
  mallocng.in_range(a, mallocng.group_range(app(app(A, "metas"), g)))
proof
  assume ha hg hi hao hok hil his
  let V := app(app(A, "metas"), g)
  let S := mallocng.stride(V)
  have vt: V in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := app(A, "metas"), x := g], simp(ha), hg)
  have vo: app(V, "mem") in omega && app(V, "maplen") in omega && app(V, "last_idx") in omega by simp(vt)
  have {gl = nslots, gmp = mapped} := expand(hok, mallocng.group_ok)
  have so := apply(mp.stride_nat, ha, hg, hok)
  have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
  have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
  have s1 s2 := expand(his, mallocng.in_slot, mallocng.slot_end, mallocng.slot_start, mallocng.storage)
  have il: int_le(int_add(i, 1), int_add(app(V, "last_idx"), 1)) by arith(gl, hil)
  have mle := mp(all_elim(ms.mul_le, {S}, {int_add(i, 1)}, {S}, {int_add(app(V, "last_idx"), 1)}), so, (int_add(i, 1) in omega by simp(hi)), simp(so), simp(vo), arith(so), il)
  have d1: int_mul(S, int_add(i, 1)) = int_add(int_mul(S, i), S) by simp(so, hi)
  have m0: int_mul(S, i) in omega by simp(so, hi)
  have up: int_lt(a, int_add(int_add(app(V, "mem"), 16), int_sub(int_mul(S, int_add(app(V, "last_idx"), 1)), 4))) by arith(s2, cu, ci, d1, mle)
  have lo: int_le(app(V, "mem"), a) by arith(s1, cu, ci, m0)
  have c1: int_lt(0, app(V, "maplen")) -> mallocng.in_range(a, mallocng.group_range(V)) proof
    assume k
    have _ big := mp(gmp, k)
    have e := mp(ite_t[c := int_lt(0, app(V, "maplen")), a := pair(app(V, "mem"), int_mul(app(V, "maplen"), 4096)), b := pair(app(V, "mem"), int_add(int_sub(int_add(mallocng.UNIT, int_mul(S, int_add(app(V, "last_idx"), 1))), mallocng.IB), 1))], k)
    have r: int_le(app(V, "mem"), a) && int_lt(a, int_add(app(V, "mem"), int_mul(app(V, "maplen"), 4096))) by arith(lo, up, big, cu)
    show by defs(simp(e, r), mallocng.group_range, mallocng.in_range)
  qed
  have c2: !int_lt(0, app(V, "maplen")) -> mallocng.in_range(a, mallocng.group_range(V)) proof
    assume k
    have e := mp(ite_f[c := int_lt(0, app(V, "maplen")), a := pair(app(V, "mem"), int_mul(app(V, "maplen"), 4096)), b := pair(app(V, "mem"), int_add(int_sub(int_add(mallocng.UNIT, int_mul(S, int_add(app(V, "last_idx"), 1))), mallocng.IB), 1))], k)
    have r: int_le(app(V, "mem"), a) && int_lt(a, int_add(app(V, "mem"), int_add(int_sub(int_add(mallocng.UNIT, int_mul(S, int_add(app(V, "last_idx"), 1))), mallocng.IB), 1))) by arith(lo, up, cu, ci)
    show by defs(simp(e, r), mallocng.group_range, mallocng.in_range)
  qed
  show by taut(c1, c2)
qed

// a byte of the fixed regions: in no reserved slot (the groups apart from them)
theorem mp.fixed_unres(c, A, M, b, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> a in omega ->
  mallocng.used_ok(A, M, b) -> mallocng.groups_apart(c, A) ->
  (mallocng.in_ranges(a, seq_concat(seq_concat(mallocng.ro_ranges(app(c, "file")), mallocng.data_ranges(c)), mallocng.auxv_ranges(A))) ||
   mallocng.in_ranges(a, fn_build(int_sub(seq_len(app(A, "areas")), 0), x0. pair(app(app(A, "areas"), int_add(0, x0)), 4096))) ||
   mallocng.in_ranges(a, seq_one(pair(app(A, "reserve"), int_mul(4096, app(A, "reserve_cnt"))))) ||
   mallocng.in_ranges(a, seq_one(pair(app(c, "sct"), int_mul(2, 48))))) ->
  !mallocng.in_reserved(A, a)
proof
  assume hc hu ha hao huo hga hr
  have p1 p2 p3 p4 _ := apply(mp.fp_pieces, hc, hu, ha)
  let L1 := seq_concat(seq_concat(mallocng.ro_ranges(app(c, "file")), mallocng.data_ranges(c)), mallocng.auxv_ranges(A))
  let L2 := seq_concat(L1, fn_build(int_sub(seq_len(app(A, "areas")), 0), x0. pair(app(app(A, "areas"), int_add(0, x0)), 4096)))
  let L3 := seq_concat(L2, seq_one(pair(app(A, "reserve"), int_mul(4096, app(A, "reserve_cnt")))))
  let L4 := seq_concat(L3, seq_one(pair(app(c, "sct"), int_mul(2, 48))))
  have t2 := apply(tr.concat_list, p1, p2)
  have t3 := apply(tr.concat_list, t2, p3)
  have u3: mallocng.in_ranges(a, L3) -> mallocng.in_ranges(a, L4) proof
    assume h
    show := apply(mp.ranges_l, t3, p4, h)
  qed
  have u2: mallocng.in_ranges(a, L2) -> mallocng.in_ranges(a, L3) proof
    assume h
    show := apply(mp.ranges_l, t2, p3, h)
  qed
  have u1: mallocng.in_ranges(a, L1) -> mallocng.in_ranges(a, L2) proof
    assume h
    show := apply(mp.ranges_l, p1, p2, h)
  qed
  have r2: mallocng.in_ranges(a, fn_build(int_sub(seq_len(app(A, "areas")), 0), x0. pair(app(app(A, "areas"), int_add(0, x0)), 4096))) -> mallocng.in_ranges(a, L2) proof
    assume h
    show := apply(mp.ranges_r, p1, p2, h)
  qed
  have r3: mallocng.in_ranges(a, seq_one(pair(app(A, "reserve"), int_mul(4096, app(A, "reserve_cnt"))))) -> mallocng.in_ranges(a, L3) proof
    assume h
    show := apply(mp.ranges_r, t2, p3, h)
  qed
  have r4: mallocng.in_ranges(a, seq_one(pair(app(c, "sct"), int_mul(2, 48)))) -> mallocng.in_ranges(a, L4) proof
    assume h
    show := apply(mp.ranges_r, t3, p4, h)
  qed
  have ifx: mallocng.in_ranges(a, mallocng.fixed_ranges(c, A)) by defs(taut(hr, u1, u2, u3, r2, r3, r4), mallocng.fixed_ranges)
  have k: mallocng.in_reserved(A, a) -> false proof
    assume h
    obtain g i, hg hi hug hil _ his from expand(h, mallocng.in_reserved)
    obtain k, hk hkl hke from expand(hug, mallocng.is_used)
    have gok := apply(mp.used_group, huo, hug)
    have rg := apply(mp.slot_in_group[A := A, M := M, b := b, g := g, i := i, a := a], ha, hg, hi, hao, gok, hil, his)
    have na := mp(all_elim(expand(hga, mallocng.groups_apart), {k}, {a}), conj(hk, hao), conj(hkl, rewrite(sym(hke), rg)))
    show by taut(na, ifx)
  qed
  show by taut(k)
qed
// a byte of a meta area, of the class table: the allocator's, if no client's
// (in no reserved slot: the groups apart from them)
theorem mp.area_fp(c, A, M, b, k, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs ->
  mallocng.used_ok(A, M, b) -> mallocng.groups_apart(c, A) ->
  k in omega -> int_lt(k, seq_len(app(A, "areas"))) -> a in omega ->
  int_le(app(app(A, "areas"), k), a) -> int_lt(a, int_add(app(app(A, "areas"), k), 4096)) -> !(a in malloc.live_of(b)) ->
  a in mallocng.footprint(c, A, b)
proof
  assume hc hu ha huo hga hk hkl hao h1 h2 hl
  have alt: app(A, "areas") in list_type(omega) by simp(ha)
  have al: seq_len(app(A, "areas")) in omega by arith(alt)
  have rr: mallocng.in_range(a, pair(app(app(A, "areas"), k), 4096)) by defs(simp(h1, h2), mallocng.in_range)
  have ir := apply(mp.ranges_build[r := x. pair(app(app(A, "areas"), x), 4096)], al, hk, hkl, rr)
  have nr := apply(mp.fixed_unres[c := c, A := A, M := M, b := b, a := a], hc, hu, ha, hao, huo, hga, taut(ir))
  show := apply(mp.fp_intro, hc, hu, ha, hao, hl, nr, taut(ir))
qed

theorem mp.sct_fp(c, A, M, b, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs ->
  mallocng.used_ok(A, M, b) -> mallocng.groups_apart(c, A) -> a in omega ->
  int_le(app(c, "sct"), a) -> int_lt(a, int_add(app(c, "sct"), int_mul(2, 48))) -> !(a in malloc.live_of(b)) ->
  a in mallocng.footprint(c, A, b)
proof
  assume hc hu ha huo hga hao h1 h2 hl
  have rr: mallocng.in_range(a, pair(app(c, "sct"), int_mul(2, 48))) by defs(simp(h1, h2), mallocng.in_range)
  have l1: int_lt(0, seq_len(seq_one(pair(app(c, "sct"), int_mul(2, 48))))) by arith()
  have a0 := at({app(seq_one(pair(app(c, "sct"), int_mul(2, 48))), 0)})
  have ir: mallocng.in_ranges(a, seq_one(pair(app(c, "sct"), int_mul(2, 48)))) by defs(ex_intro({0}, simp(rr, l1, a0)), mallocng.in_ranges)
  have nr := apply(mp.fixed_unres[c := c, A := A, M := M, b := b, a := a], hc, hu, ha, hao, huo, hga, taut(ir))
  show := apply(mp.fp_intro, hc, hu, ha, hao, hl, nr, taut(ir))
qed
// ----------------------------------------------------------------------
//  Separation: a meta area's page apart from the other regions; views
//  agreeing; A2 differing from A in the groups' masks only

// the separate regions: the data's, the image's, the areas', the reserve's
// (then the mapped groups'), at their indices
theorem mp.reg_at(c, A, i): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> i in omega ->
  ((data: (int_lt(i, 3) -> app(mallocng.regions(c, A), i) = app(mallocng.data_ranges(c), i)) &&
   ro: (int_lt(i, x86_64_linux.phnum(app(c, "file"))) -> app(mallocng.regions(c, A), int_add(3, i)) = app(mallocng.ro_ranges(app(c, "file")), i))) &&
   area: (int_lt(i, seq_len(app(A, "areas"))) -> app(mallocng.regions(c, A), int_add(int_add(3, x86_64_linux.phnum(app(c, "file"))), i)) = pair(app(app(A, "areas"), i), 4096))) &&
  reserve: app(mallocng.regions(c, A), int_add(int_add(3, x86_64_linux.phnum(app(c, "file"))), seq_len(app(A, "areas")))) = pair(app(A, "reserve"), int_mul(4096, app(A, "reserve_cnt"))) &&
  len: int_le(int_add(int_add(int_add(3, x86_64_linux.phnum(app(c, "file"))), seq_len(app(A, "areas"))), 1), seq_len(mallocng.regions(c, A)))
proof
  assume hc hu ha hi
  let F := app(c, "file")
  let RO := mallocng.ro_ranges(F)
  let AR := fn_build(int_sub(seq_len(app(A, "areas")), 0), x0. pair(app(app(A, "areas"), int_add(0, x0)), 4096))
  let RS := seq_one(pair(app(A, "reserve"), int_mul(4096, app(A, "reserve_cnt"))))
  let GR := fn_build(int_sub(seq_len(app(A, "used")), 0), x0. ite(int_lt(0, app(app(app(A, "metas"), app(app(A, "used"), int_add(0, x0))), "maplen")), mallocng.group_range(app(app(A, "metas"), app(app(A, "used"), int_add(0, x0)))), pair(0, 0)))
  let DR := mallocng.data_ranges(c)
  let R := seq_concat(seq_concat(seq_concat(seq_concat(DR, RO), AR), RS), GR)
  have fs: F in seq_type(bits(8)) by simp(hc)
  have pn: x86_64_linux.phnum(F) in omega by defs(mp(x86.le_at_nat[f := F, off := 56, n := 2], fs, simp()), x86_64_linux.phnum)
  have rol := apply(mp.ro_list, fs)
  have rlen: seq_len(RO) = x86_64_linux.phnum(F) by defs(arith(fn_build_dom[d := int_sub(x86_64_linux.phnum(F), 0), v := x0. ite(x86_64_linux.is_load(F, int_add(0, x0)) && !bit(app(x86_64_linux.segment(F, int_add(0, x0)), "flags"), 1), pair(app(x86_64_linux.segment(F, int_add(0, x0)), "vaddr"), app(x86_64_linux.segment(F, int_add(0, x0)), "memsz")), pair(0, 0))], pn), seq_len, mallocng.ro_ranges)
  have {p2 = areas, p3 = reserve} := apply(mp.fp_pieces, hc, hu, ha)
  have cf: app(c, "ctx") in omega && app(c, "lock") in omega && app(c, "libc") in omega by simp(hc)
  have o1 := apply(tr.seq_one_type, (pair(app(c, "ctx"), mallocng.CTX_SIZE) in univ(1) by simp(cf)))
  have o2 := apply(tr.seq_one_type, (pair(app(c, "lock"), 4) in univ(1) by simp(cf)))
  have o3 := apply(tr.seq_one_type, (pair(app(c, "libc"), 16) in univ(1) by simp(cf)))
  have dl: DR in list_type(univ(1)) by defs(apply(tr.concat_list, apply(tr.concat_list, o1, o2), o3), mallocng.data_ranges)
  have drl: seq_len(DR) = 3 by defs(arith(), mallocng.data_ranges)
  have er: mallocng.regions(c, A) = R by defs(refl({R}), mallocng.regions)
  have rl: app(A, "areas") in list_type(omega) by simp(ha)
  have al: seq_len(app(A, "areas")) in omega by arith(rl)
  have ul: app(A, "used") in list_type(omega) by simp(ha)
  have ud: int_sub(seq_len(app(A, "used")), 0) in omega by arith(ul)
  have gv: all x0. x0 in int_sub(seq_len(app(A, "used")), 0) -> ite(int_lt(0, app(app(app(A, "metas"), app(app(A, "used"), int_add(0, x0))), "maplen")), mallocng.group_range(app(app(A, "metas"), app(app(A, "used"), int_add(0, x0)))), pair(0, 0)) in univ(1) proof
    fix x0
    assume hx
    show by defs(simp(hu), mallocng.group_range, mallocng.stride)
  qed
  have p5 := apply(build_list, ud, gv)
  have arl: seq_len(AR) = int_sub(seq_len(app(A, "areas")), 0) by defs(fn_build_dom[d := int_sub(seq_len(app(A, "areas")), 0), v := x0. pair(app(app(A, "areas"), int_add(0, x0)), 4096)], seq_len)
  have c1: int_lt(i, 3) -> app(R, i) = app(DR, i) proof
    assume h
    show := at({app(R, i)}, dl, rol, p2, p3, p5, drl, rlen, arl, pn, al, hi, h)
  qed
  have c2: int_lt(i, x86_64_linux.phnum(F)) -> app(R, int_add(3, i)) = app(RO, i) proof
    assume h
    have e := at({app(R, int_add(3, i))}, dl, rol, p2, p3, p5, drl, rlen, arl, pn, al, hi, h)
    show by simp(e, (int_sub(int_add(3, i), seq_len(DR)) = i by arith(drl, hi)))
  qed
  have c3: int_lt(i, seq_len(app(A, "areas"))) -> app(R, int_add(int_add(3, x86_64_linux.phnum(F)), i)) = pair(app(app(A, "areas"), i), 4096) proof
    assume h
    have e := at({app(R, int_add(int_add(3, x86_64_linux.phnum(F)), i))}, dl, rol, p2, p3, p5, drl, rlen, arl, pn, al, hi, h)
    have ix: int_sub(int_add(int_add(3, x86_64_linux.phnum(F)), i), int_add(seq_len(DR), seq_len(RO))) = i by arith(drl, rlen, pn, hi)
    have iin := mp(nat_lt_mem[k := i, n := int_sub(seq_len(app(A, "areas")), 0)], hi, arith(al), arith(h, al))
    have ab := mp(app_fn_build[d := int_sub(seq_len(app(A, "areas")), 0), v := x0. pair(app(app(A, "areas"), int_add(0, x0)), 4096), a := i], iin)
    show by simp(e, ix, ab, (int_add(0, i) = i by arith(hi)))
  qed
  have c4 := at({app(R, int_add(int_add(3, x86_64_linux.phnum(F)), seq_len(app(A, "areas"))))}, dl, rol, p2, p3, p5, drl, rlen, arl, pn, al)
  have c5: int_le(int_add(int_add(int_add(3, x86_64_linux.phnum(F)), seq_len(app(A, "areas"))), 1), seq_len(R)) by arith(dl, rol, p2, p3, p5, drl, rlen, arl, pn, al)
  show by simp(er, c1, c2, c3, c4, c5)
qed

// (a range of naturals: its parts)
theorem mp.cart_nat(r): r in cart(omega, omega) -> start: fst(r) in omega && size: snd(r) in omega
proof
  assume h
  obtain x y, hx hy he from mp(cart_elim[a := omega, b := omega, z := r], h)
  show by simp(he, hx, hy)
qed

// (apart ranges share no byte)
theorem mp.apart_not(r, q, a): r in cart(omega, omega) -> q in cart(omega, omega) -> mallocng.apart(r, q) -> mallocng.in_range(a, r) -> !mallocng.in_range(a, q)
proof
  assume hrt hqt hp hr
  have r0 r0b := apply(mp.cart_nat, hrt)
  have q0 q0b := apply(mp.cart_nat, hqt)
  have r1 r2 := expand(hr, mallocng.in_range)
  have n: mallocng.in_range(a, q) -> false proof
    assume hq
    have q1 q2 := expand(hq, mallocng.in_range)
    show by arith(expand(hp, mallocng.apart), r0, r0b, q0, q0b, r1, r2, q1, q2)
  qed
  show by taut(n)
qed

// the separate regions: ranges of naturals
theorem mp.regions_nat(c, A): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.regions(c, A) in list_type(cart(omega, omega))
proof
  assume hc hu ha
  let F := app(c, "file")
  have fs: F in seq_type(bits(8)) by simp(hc)
  have cf1 cf2 cf3 := (app(c, "ctx") in omega && app(c, "lock") in omega && app(c, "libc") in omega by simp(hc))
  have o1 := apply(tr.seq_one_type, mp(cart_intro[a := omega, b := omega, x := app(c, "ctx"), y := mallocng.CTX_SIZE], cf1, (mallocng.CTX_SIZE in omega by defs(simp(), mallocng.CTX_SIZE))))
  have o2 := apply(tr.seq_one_type, mp(cart_intro[a := omega, b := omega, x := app(c, "lock"), y := 4], cf2, simp()))
  have o3 := apply(tr.seq_one_type, mp(cart_intro[a := omega, b := omega, x := app(c, "libc"), y := 16], cf3, simp()))
  have dl := apply(tr.concat_list, apply(tr.concat_list, o1, o2), o3)
  have pn: x86_64_linux.phnum(F) in omega by defs(mp(x86.le_at_nat[f := F, off := 56, n := 2], fs, simp()), x86_64_linux.phnum)
  have d: int_sub(x86_64_linux.phnum(F), 0) in omega by arith(pn)
  have vt: all i. i in int_sub(x86_64_linux.phnum(F), 0) -> ite(x86_64_linux.is_load(F, int_add(0, i)) && !bit(app(x86_64_linux.segment(F, int_add(0, i)), "flags"), 1), pair(app(x86_64_linux.segment(F, int_add(0, i)), "vaddr"), app(x86_64_linux.segment(F, int_add(0, i)), "memsz")), pair(0, 0)) in cart(omega, omega) proof
    fix i
    assume hi
    have v1 := mp(x86.le_at_nat[f := F, off := int_add(x86_64_linux.ph(F, int_add(0, i)), 16), n := 8], fs, simp())
    have v2 := mp(x86.le_at_nat[f := F, off := int_add(x86_64_linux.ph(F, int_add(0, i)), 40), n := 8], fs, simp())
    have w1: app(x86_64_linux.segment(F, int_add(0, i)), "vaddr") in omega by defs(simp(v1), x86_64_linux.segment)
    have w2: app(x86_64_linux.segment(F, int_add(0, i)), "memsz") in omega by defs(simp(v2), x86_64_linux.segment)
    have p := mp(cart_intro[a := omega, b := omega, x := app(x86_64_linux.segment(F, int_add(0, i)), "vaddr"), y := app(x86_64_linux.segment(F, int_add(0, i)), "memsz")], w1, w2)
    show := apply(ite_in[c := x86_64_linux.is_load(F, int_add(0, i)) && !bit(app(x86_64_linux.segment(F, int_add(0, i)), "flags"), 1)], p, mp(cart_intro[a := omega, b := omega, x := 0, y := 0], simp(), simp()))
  qed
  have rol: mallocng.ro_ranges(F) in list_type(cart(omega, omega)) by defs(apply(build_list, d, vt), mallocng.ro_ranges)
  have rl: app(A, "areas") in list_type(omega) by simp(ha)
  have ad: int_sub(seq_len(app(A, "areas")), 0) in omega by arith(rl)
  have av: all x0. x0 in int_sub(seq_len(app(A, "areas")), 0) -> pair(app(app(A, "areas"), int_add(0, x0)), 4096) in cart(omega, omega) proof
    fix x0
    assume hx
    have xo := mp(nat_elem[k := int_sub(seq_len(app(A, "areas")), 0), i := x0], ad, hx)
    have xl := mp(nat_mem_lt[k := int_sub(seq_len(app(A, "areas")), 0), i := x0], ad, hx)
    have e := apply(at_type[l := app(A, "areas"), t := omega, i := int_add(0, x0)], rl, simp(xo), arith(xo, xl, rl))
    show := mp(cart_intro[a := omega, b := omega, x := app(app(A, "areas"), int_add(0, x0)), y := 4096], e, simp())
  qed
  have arl := apply(build_list, ad, av)
  have rs := apply(tr.seq_one_type, mp(cart_intro[a := omega, b := omega, x := app(A, "reserve"), y := int_mul(4096, app(A, "reserve_cnt"))], (app(A, "reserve") in omega by simp(ha)), (int_mul(4096, app(A, "reserve_cnt")) in omega by simp((app(A, "reserve_cnt") in omega by simp(ha))))))
  have ul: app(A, "used") in list_type(omega) by simp(ha)
  have ud: int_sub(seq_len(app(A, "used")), 0) in omega by arith(ul)
  have gv: all x0. x0 in int_sub(seq_len(app(A, "used")), 0) -> ite(int_lt(0, app(app(app(A, "metas"), app(app(A, "used"), int_add(0, x0))), "maplen")), mallocng.group_range(app(app(A, "metas"), app(app(A, "used"), int_add(0, x0)))), pair(0, 0)) in cart(omega, omega) proof
    fix x0
    assume hx
    let V := app(app(A, "metas"), app(app(A, "used"), int_add(0, x0)))
    have xo := mp(nat_elem[k := int_sub(seq_len(app(A, "used")), 0), i := x0], ud, hx)
    have xl := mp(nat_mem_lt[k := int_sub(seq_len(app(A, "used")), 0), i := x0], ud, hx)
    have uo := apply(at_type[l := app(A, "used"), t := omega, i := int_add(0, x0)], ul, simp(xo), arith(xo, xl, ul))
    have vt: V in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := app(A, "metas"), x := app(app(A, "used"), int_add(0, x0))], simp(ha), uo)
    have vo1 vo2 := (app(V, "mem") in omega && app(V, "maplen") in omega by simp(vt))
    have c1: int_lt(0, app(V, "maplen")) -> ite(int_lt(0, app(V, "maplen")), mallocng.group_range(V), pair(0, 0)) in cart(omega, omega) proof
      assume h
      have e: mallocng.group_range(V) = pair(app(V, "mem"), int_mul(app(V, "maplen"), 4096)) by defs(simp(h), mallocng.group_range)
      have pc := mp(cart_intro[a := omega, b := omega, x := app(V, "mem"), y := int_mul(app(V, "maplen"), 4096)], vo1, simp(vo2))
      show by simp(h, e, pc)
    qed
    have c2: !int_lt(0, app(V, "maplen")) -> ite(int_lt(0, app(V, "maplen")), mallocng.group_range(V), pair(0, 0)) in cart(omega, omega) proof
      assume h
      show by simp(h, mp(cart_intro[a := omega, b := omega, x := 0, y := 0], simp(), simp()))
    qed
    show by taut(c1, c2)
  qed
  have grl := apply(build_list, ud, gv)
  show by defs(apply(tr.concat_list, apply(tr.concat_list, apply(tr.concat_list, apply(tr.concat_list, dl, rol), arl), rs), grl), mallocng.regions, mallocng.data_ranges)
qed

// a byte of a meta area: in the fixed regions
theorem mp.area_fixed(c, A, k, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> k in omega -> int_lt(k, seq_len(app(A, "areas"))) ->
  int_le(app(app(A, "areas"), k), a) -> int_lt(a, int_add(app(app(A, "areas"), k), 4096)) ->
  mallocng.in_ranges(a, mallocng.fixed_ranges(c, A))
proof
  assume hc hu ha hk hkl h1 h2
  have {p1 = front, p2 = areas, p3 = reserve, p4 = classes} := apply(mp.fp_pieces, hc, hu, ha)
  have rl: app(A, "areas") in list_type(omega) by simp(ha)
  have al: seq_len(app(A, "areas")) in omega by arith(rl)
  have rr: mallocng.in_range(a, pair(app(app(A, "areas"), k), 4096)) by defs(simp(h1, h2), mallocng.in_range)
  have ir := apply(mp.ranges_build[r := x. pair(app(app(A, "areas"), x), 4096)], al, hk, hkl, rr)
  have t2 := apply(tr.concat_list, p1, p2)
  have t3 := apply(tr.concat_list, t2, p3)
  have i2 := apply(mp.ranges_r, p1, p2, ir)
  have i3 := apply(mp.ranges_l, t2, p3, i2)
  have i4 := apply(mp.ranges_l, t3, p4, i3)
  show by defs(i4, mallocng.fixed_ranges)
qed

// a byte of meta area k: in no other region (the data, the image's
// constants, the reserve, another area), in no group
theorem mp.area_apart(c, A, M, b, brk, k, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds(c, A, M, b, brk) ->
  k in omega -> int_lt(k, seq_len(app(A, "areas"))) -> a in omega -> int_le(app(app(A, "areas"), k), a) -> int_lt(a, int_add(app(app(A, "areas"), k), 4096)) ->
  (((data: (all i. i in omega -> int_lt(i, 3) -> !mallocng.in_range(a, app(mallocng.data_ranges(c), i))) &&
    ro: (all i. i in omega -> int_lt(i, x86_64_linux.phnum(app(c, "file"))) -> !mallocng.in_range(a, app(mallocng.ro_ranges(app(c, "file")), i)))) &&
    reserve: !mallocng.in_range(a, pair(app(A, "reserve"), int_mul(4096, app(A, "reserve_cnt"))))) &&
    areas: (all k2. k2 in omega -> int_lt(k2, seq_len(app(A, "areas"))) -> !(k2 = k) -> !(int_le(app(app(A, "areas"), k2), a) && int_lt(a, int_add(app(app(A, "areas"), k2), 4096))))) &&
  groups: (all h. mallocng.is_used(A, h) -> !mallocng.in_range(a, mallocng.group_range(app(app(A, "metas"), h))))
proof
  assume hc hu ha H hk hkl hao h1 h2
  have {sep = sep, hga = apart} := expand(H, mallocng.holds)
  let F := app(c, "file")
  let PN := x86_64_linux.phnum(F)
  let L := seq_len(app(A, "areas"))
  let RG := mallocng.regions(c, A)
  have fs: F in seq_type(bits(8)) by simp(hc)
  have pn: PN in omega by defs(mp(x86.le_at_nat[f := F, off := 56, n := 2], fs, simp()), x86_64_linux.phnum)
  have rl: app(A, "areas") in list_type(omega) by simp(ha)
  have lo: L in omega by arith(rl)
  have {ek = area} := apply(mp.reg_at[c := c, A := A, i := k], hc, hu, ha, hk)
  have {er = reserve, rlen = len} := apply(mp.reg_at[c := c, A := A, i := 0], hc, hu, ha, simp())
  let JK := int_add(int_add(3, PN), k)
  have rk: mallocng.in_range(a, app(RG, JK)) by defs(simp(mp(ek, hkl), h1, h2), mallocng.in_range)
  // apart from region j, j another index
  have out: all j. j in omega -> int_lt(j, seq_len(RG)) -> !(j = JK) -> !mallocng.in_range(a, app(RG, j)) proof
    fix j
    assume hj hjl hne
    have s := mp(all_elim(expand(sep, mallocng.separate), {JK}, {j}), conj((JK in omega by simp(pn, hk)), hj), conj(conj((int_lt(JK, seq_len(RG)) by arith(rlen, hkl, pn, hk)), hjl), (!(JK = j) by taut(hne))))
    have rn := apply(mp.regions_nat, hc, hu, ha)
    have tk := apply(at_type[l := RG, t := cart(omega, omega), i := JK], rn, (JK in omega by simp(pn, hk)), (int_lt(JK, seq_len(RG)) by arith(rlen, hkl, pn, hk)))
    have tj := apply(at_type[l := RG, t := cart(omega, omega), i := j], rn, hj, hjl)
    show := apply(mp.apart_not, tk, tj, s, rk)
  qed
  have d: all i. i in omega -> int_lt(i, 3) -> !mallocng.in_range(a, app(mallocng.data_ranges(c), i)) proof
    fix i
    assume hi hil
    have {e = data} := apply(mp.reg_at[c := c, A := A, i := i], hc, hu, ha, hi)
    have o := mp(all_elim(out, {i}), hi, arith(rlen, hil, pn, lo, hi), arith(hil, pn, hk, hi))
    show := rewrite(mp(e, hil), o)
  qed
  have r: all i. i in omega -> int_lt(i, PN) -> !mallocng.in_range(a, app(mallocng.ro_ranges(F), i)) proof
    fix i
    assume hi hil
    have {e = ro} := apply(mp.reg_at[c := c, A := A, i := i], hc, hu, ha, hi)
    have o := mp(all_elim(out, {int_add(3, i)}), simp(hi), arith(rlen, hil, pn, lo), arith(hil, pn, hk, hi))
    show := rewrite(mp(e, hil), o)
  qed
  have rs: !mallocng.in_range(a, pair(app(A, "reserve"), int_mul(4096, app(A, "reserve_cnt")))) proof
    have o := mp(all_elim(out, {int_add(int_add(3, PN), L)}), simp(pn, lo), arith(rlen, pn, lo), arith(hkl, pn, hk, lo))
    show := rewrite(er, o)
  qed
  have ar: all k2. k2 in omega -> int_lt(k2, L) -> !(k2 = k) -> !(int_le(app(app(A, "areas"), k2), a) && int_lt(a, int_add(app(app(A, "areas"), k2), 4096))) proof
    fix k2
    assume hk2 hk2l hne
    have {e2 = area} := apply(mp.reg_at[c := c, A := A, i := k2], hc, hu, ha, hk2)
    have o := mp(all_elim(out, {int_add(int_add(3, PN), k2)}), simp(pn, hk2), arith(rlen, hk2l, pn, lo), arith(hne, pn, hk, hk2))
    have o2 := rewrite(mp(e2, hk2l), o)
    have o3 := expand(o2, mallocng.in_range)
    show by simp(o3)
  qed
  have gr: all h. mallocng.is_used(A, h) -> !mallocng.in_range(a, mallocng.group_range(app(app(A, "metas"), h))) proof
    fix h
    assume hh
    obtain u, hu0 hul he from expand(hh, mallocng.is_used)
    have ifx := apply(mp.area_fixed, hc, hu, ha, hk, hkl, h1, h2)
    have n: mallocng.in_range(a, mallocng.group_range(app(app(A, "metas"), h))) -> false proof
      assume hr
      have na := mp(all_elim(expand(hga, mallocng.groups_apart), {u}, {a}), conj(hu0, hao), conj(hul, rewrite(sym(he), hr)))
      show by taut(na, ifx)
    qed
    show by taut(n)
  qed
  show by taut(d, r, rs, ar, gr)
qed

// two views agreeing at a: the same byte, the same page
theorem mp.agree_b8(M, M2, a): app(M2, a) = app(M, a) -> byte: mallocng.b8(M2, a) = mallocng.b8(M, a) && page: mallocng.pg(M2, a) = mallocng.pg(M, a)
proof
  assume h
  show by defs(simp(h), mallocng.b8, mallocng.pg)
qed

// ... at n bytes from a: the same word
theorem mp.agree_rd(M, M2, a, n): n in omega -> (all i. i in omega -> int_lt(i, n) -> app(M2, int_add(a, i)) = app(M, int_add(a, i))) ->
  mallocng.rd(M2, a, n) = mallocng.rd(M, a, n)
proof
  assume hn he
  have pw: all i. i in omega -> int_le(0, i) -> int_lt(i, n) ->
      int_mul(mallocng.b8(M2, int_add(a, i)), int_pow(256, i)) = int_mul(mallocng.b8(M, int_add(a, i)), int_pow(256, i)) proof
    fix i
    assume hi _ hil
    have {b = byte} := apply(mp.agree_b8, mp(all_elim(he, {i}), hi, hil))
    show by simp(b)
  qed
  have e := mp(int_sum_ext[a := 0, b := n, f := i. int_mul(mallocng.b8(M2, int_add(a, i)), int_pow(256, i)), g := i. int_mul(mallocng.b8(M, int_add(a, i)), int_pow(256, i))], simp(), hn, pw)
  show by defs(e, mallocng.rd)
qed

// A2 differing from A in the groups' masks only: its other fields A's
theorem mp.mo_field(A, A2, k): mallocng_purpose.masks_only(A, A2) -> !(k = "metas") -> app(A2, k) = app(A, k)
proof
  assume h hk
  have {e = others} := expand(h, mallocng_purpose.masks_only)
  have a := app_update_other[f := A2, k := "metas", v := app(A, "metas"), x := k]
  show := trans(sym(mp(a, hk)), subst({y. app(fn_update(A2, "metas", app(A, "metas")), k) = app(y, k)}, e, refl({app(fn_update(A2, "metas", app(A, "metas")), k)})))
qed

// ... and its groups' fields but the masks A's
theorem mp.mo_meta(A, A2, x, k): mallocng_purpose.masks_only(A, A2) -> x in omega -> !(k = "avail") -> !(k = "freed") ->
  app(app(app(A2, "metas"), x), k) = app(app(app(A, "metas"), x), k)
proof
  assume h hx ka kf
  have {e = groups} := expand(h, mallocng_purpose.masks_only)
  have ex := mp(all_elim(e, {x}), hx)
  let V2 := app(app(A2, "metas"), x)
  let V := app(app(A, "metas"), x)
  have a2 := trans(mp(app_update_other[f := fn_update(V2, "avail", 0), k := "freed", v := 0, x := k], kf), mp(app_update_other[f := V2, k := "avail", v := 0, x := k], ka))
  have a1 := trans(mp(app_update_other[f := fn_update(V, "avail", 0), k := "freed", v := 0, x := k], kf), mp(app_update_other[f := V, k := "avail", v := 0, x := k], ka))
  show := trans(sym(a2), trans(subst({y. app(fn_update(fn_update(V2, "avail", 0), "freed", 0), k) = app(y, k)}, ex, refl({app(fn_update(fn_update(V2, "avail", 0), "freed", 0), k)})), a1))
qed

// (so its geometry: the stride, the slots, the group's bytes)
theorem mp.mo_geom(A, A2, x): mallocng_purpose.masks_only(A, A2) -> x in omega ->
  mem: app(app(app(A2, "metas"), x), "mem") = app(app(app(A, "metas"), x), "mem") && maplen: app(app(app(A2, "metas"), x), "maplen") = app(app(app(A, "metas"), x), "maplen") &&
  last: app(app(app(A2, "metas"), x), "last_idx") = app(app(app(A, "metas"), x), "last_idx") && sclass: app(app(app(A2, "metas"), x), "sizeclass") = app(app(app(A, "metas"), x), "sizeclass") &&
  freeable: app(app(app(A2, "metas"), x), "freeable") = app(app(app(A, "metas"), x), "freeable") && prev: app(app(app(A2, "metas"), x), "prev") = app(app(app(A, "metas"), x), "prev") &&
  next: app(app(app(A2, "metas"), x), "next") = app(app(app(A, "metas"), x), "next") &&
  stride: mallocng.stride(app(app(A2, "metas"), x)) = mallocng.stride(app(app(A, "metas"), x)) &&
  range: mallocng.group_range(app(app(A2, "metas"), x)) = mallocng.group_range(app(app(A, "metas"), x)) &&
  slots: (all i. start: mallocng.slot_start(app(app(A2, "metas"), x), i) = mallocng.slot_start(app(app(A, "metas"), x), i) &&
     end: mallocng.slot_end(app(app(A2, "metas"), x), i) = mallocng.slot_end(app(app(A, "metas"), x), i)) &&
  storage: mallocng.storage(app(app(A2, "metas"), x)) = mallocng.storage(app(app(A, "metas"), x))
proof
  assume h hx
  have fm := apply(mp.mo_meta[A := A, A2 := A2, x := x, k := "mem"], h, hx, simp(), simp())
  have fp := apply(mp.mo_meta[A := A, A2 := A2, x := x, k := "maplen"], h, hx, simp(), simp())
  have fl := apply(mp.mo_meta[A := A, A2 := A2, x := x, k := "last_idx"], h, hx, simp(), simp())
  have fs := apply(mp.mo_meta[A := A, A2 := A2, x := x, k := "sizeclass"], h, hx, simp(), simp())
  have ff := apply(mp.mo_meta[A := A, A2 := A2, x := x, k := "freeable"], h, hx, simp(), simp())
  have fv := apply(mp.mo_meta[A := A, A2 := A2, x := x, k := "prev"], h, hx, simp(), simp())
  have fn := apply(mp.mo_meta[A := A, A2 := A2, x := x, k := "next"], h, hx, simp(), simp())
  have st: mallocng.stride(app(app(A2, "metas"), x)) = mallocng.stride(app(app(A, "metas"), x)) by defs(simp(fp, fl, fs), mallocng.stride)
  have gr: mallocng.group_range(app(app(A2, "metas"), x)) = mallocng.group_range(app(app(A, "metas"), x)) by defs(simp(fm, fp, fl, st), mallocng.group_range)
  have sg: mallocng.storage(app(app(A2, "metas"), x)) = mallocng.storage(app(app(A, "metas"), x)) by defs(simp(fm), mallocng.storage)
  have ss: all i. mallocng.slot_start(app(app(A2, "metas"), x), i) = mallocng.slot_start(app(app(A, "metas"), x), i) &&
      mallocng.slot_end(app(app(A2, "metas"), x), i) = mallocng.slot_end(app(app(A, "metas"), x), i) proof
    fix i
    have s1: mallocng.slot_start(app(app(A2, "metas"), x), i) = mallocng.slot_start(app(app(A, "metas"), x), i) by defs(simp(sg, st), mallocng.slot_start)
    have s2: mallocng.slot_end(app(app(A2, "metas"), x), i) = mallocng.slot_end(app(app(A, "metas"), x), i) by defs(simp(s1, st), mallocng.slot_end)
    show by taut(s1, s2)
  qed
  show by taut(fm, fp, fl, fs, ff, fv, fn, st, gr, ss, sg)
qed

// a slot's frame (`frame_ok`) on a view agreeing on the slot's bytes (and
// the header byte before it), the group's geometry the same
theorem mp.frame_agree(M, M2, v, v2, i, p, n, tag): mallocng.frame_ok(M, v, i, p, n, tag) ->
  mallocng.slot_start(v2, i) = mallocng.slot_start(v, i) -> mallocng.slot_end(v2, i) = mallocng.slot_end(v, i) ->
  mallocng.storage(v2) = mallocng.storage(v) -> app(v2, "sizeclass") = app(v, "sizeclass") ->
  mallocng.slot_start(v, i) in omega -> mallocng.slot_end(v, i) in omega -> int_le(5, mallocng.slot_start(v, i)) -> p in omega -> n in omega ->
  (all a. a in omega -> int_le(int_sub(mallocng.slot_start(v, i), 5), a) -> int_le(a, mallocng.slot_end(v, i)) -> app(M2, a) = app(M, a)) ->
  mallocng.frame_ok(M2, v2, i, p, n, tag)
proof
  assume H es ee eg ec so eo s5 hp hn ag
  let S := mallocng.slot_start(v, i)
  let E := mallocng.slot_end(v, i)
  have {f1 = start, f3 = fits} := expand(H, mallocng.frame_ok)
  have b: all x. x in omega -> int_le(int_sub(S, 5), x) -> int_le(x, E) -> mallocng.b8(M2, x) = mallocng.b8(M, x) proof
    fix x
    assume hx h1 h2
    have {e = byte} := apply(mp.agree_b8, mp(all_elim(ag, {x}), hx, h1, h2))
    show := e
  qed
  have r: all x n2. x in omega -> n2 in omega -> int_le(int_sub(S, 5), x) -> int_le(int_add(x, n2), int_add(E, 1)) -> mallocng.rd(M2, x, n2) = mallocng.rd(M, x, n2) proof
    fix x n2
    assume hx hn2 h1 h2
    have ai: all j. j in omega -> int_lt(j, n2) -> app(M2, int_add(x, j)) = app(M, int_add(x, j)) proof
      fix j
      assume hj hjl
      show := mp(all_elim(ag, {int_add(x, j)}), simp(hx, hj), arith(h1, hj, hx), arith(h2, hjl, hj, hx))
    qed
    show := apply(mp.agree_rd, hn2, ai)
  qed
  have b1 := mp(all_elim(b, {int_sub(p, 4)}), arith(f1, so, s5, hp), arith(f1, so, hp), arith(f1, f3, so, hp, hn))
  have b2 := mp(all_elim(b, {int_sub(p, 3)}), arith(f1, so, s5, hp), arith(f1, so, hp), arith(f1, f3, so, hp, hn))
  have b3 := mp(all_elim(b, {int_add(p, n)}), simp(hp, hn), arith(f1, so, hp, hn), arith(f3, hp, hn))
  have b4 := mp(all_elim(b, {int_sub(E, 5)}), arith(f1, f3, so, s5, hp, hn, eo), arith(f1, f3, so, hp, hn, eo), arith(eo))
  have b5 := mp(all_elim(b, {E}), eo, arith(f1, f3, so, hp, hn, eo), arith(eo))
  have b6 := mp(all_elim(b, {int_sub(S, 3)}), arith(so, s5), arith(so), arith(f1, f3, so, hp, hn, eo))
  have r1 := mp(all_elim(r, {int_sub(p, 2)}, {2}), arith(f1, so, s5, hp), simp(), arith(f1, so, hp), arith(f1, f3, so, hp, hn, eo))
  have r2 := mp(all_elim(r, {int_sub(S, 2)}, {2}), arith(so, s5), simp(), arith(so), arith(f1, f3, so, hp, hn, eo))
  have r3 := mp(all_elim(r, {int_sub(E, 4)}, {4}), arith(f1, f3, so, s5, hp, hn, eo), simp(), arith(f1, f3, so, hp, hn, eo), arith(eo))
  have fo := expand(H, mallocng.frame_ok, mallocng.size_ok)
  show by defs(simp(es, ee, eg, ec, b1, b2, b3, b4, b5, b6, r1, r2, r3, fo), mallocng.frame_ok, mallocng.size_ok)
qed

// a slot's use: a client block's start, a nested group's meta -- naturals
theorem mp.use_nat(u): u in mallocng.Use -> !(fst(u) = 0) -> !(fst(u) = 3) -> snd(u) in omega
proof
  assume hu h0 h3
  have c0: u in set_image(single(empty), x0. tag(0, x0)) -> snd(u) in omega proof
    assume h
    obtain x, hx he from ((ex x0. x0 in single(empty) && tag(0, x0) = u) by taut(h, set_image_def[s := single(empty), f := x0. tag(0, x0), y := u]))
    have f: fst(u) = 0 by defs(simp(sym(he)), tag)
    show by taut(f, h0)
  qed
  have c1: u in set_image(omega, x0. tag(1, x0)) -> snd(u) in omega proof
    assume h
    obtain x, hx he from ((ex x0. x0 in omega && tag(1, x0) = u) by taut(h, set_image_def[s := omega, f := x0. tag(1, x0), y := u]))
    show by defs(simp(sym(he), hx), tag)
  qed
  have c2: u in set_image(omega, x0. tag(2, x0)) -> snd(u) in omega proof
    assume h
    obtain x, hx he from ((ex x0. x0 in omega && tag(2, x0) = u) by taut(h, set_image_def[s := omega, f := x0. tag(2, x0), y := u]))
    show by defs(simp(sym(he), hx), tag)
  qed
  have c3: u in set_image(single(empty), x0. tag(3, x0)) -> snd(u) in omega proof
    assume h
    obtain x, hx he from ((ex x0. x0 in single(empty) && tag(3, x0) = u) by taut(h, set_image_def[s := single(empty), f := x0. tag(3, x0), y := u]))
    have f: fst(u) = 3 by defs(simp(sym(he)), tag)
    show by taut(f, h3)
  qed
  have hu2 := expand(hu, mallocng.Use)
  show by simp(hu2, c0, c1, c2, c3)
qed

// (a use: its tag and value)
theorem mp.use_eta(u): u in mallocng.Use -> u = tag(fst(u), snd(u))
proof
  assume hu
  have c0: u in set_image(single(empty), x0. tag(0, x0)) -> u = tag(fst(u), snd(u)) proof
    assume h
    obtain x, hx he from ((ex x0. x0 in single(empty) && tag(0, x0) = u) by taut(h, set_image_def[s := single(empty), f := x0. tag(0, x0), y := u]))
    show by defs(simp(sym(he)), tag)
  qed
  have c1: u in set_image(omega, x0. tag(1, x0)) -> u = tag(fst(u), snd(u)) proof
    assume h
    obtain x, hx he from ((ex x0. x0 in omega && tag(1, x0) = u) by taut(h, set_image_def[s := omega, f := x0. tag(1, x0), y := u]))
    show by defs(simp(sym(he)), tag)
  qed
  have c2: u in set_image(omega, x0. tag(2, x0)) -> u = tag(fst(u), snd(u)) proof
    assume h
    obtain x, hx he from ((ex x0. x0 in omega && tag(2, x0) = u) by taut(h, set_image_def[s := omega, f := x0. tag(2, x0), y := u]))
    show by defs(simp(sym(he)), tag)
  qed
  have c3: u in set_image(single(empty), x0. tag(3, x0)) -> u = tag(fst(u), snd(u)) proof
    assume h
    obtain x, hx he from ((ex x0. x0 in single(empty) && tag(3, x0) = u) by taut(h, set_image_def[s := single(empty), f := x0. tag(3, x0), y := u]))
    show by defs(simp(sym(he)), tag)
  qed
  have hu2 := expand(hu, mallocng.Use)
  show by simp(hu2, c0, c1, c2, c3)
qed

// group h of A, its bytes (from its header to its last slot's end) the
// same in M2, its masks and meta word given anew: group h of A2 -- A2
// differing from A in the groups' masks only
theorem mp.group_tr(A, A2, M, M2, b, h): A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) -> h in omega ->
  mallocng_purpose.masks_only(A, A2) -> mallocng.used_ok(A, M, b) -> mallocng.group_ok(A, M, b, h) ->
  (all a. a in omega -> int_le(app(app(app(A, "metas"), h), "mem"), a) ->
     int_le(a, mallocng.slot_end(app(app(A, "metas"), h), app(app(app(A, "metas"), h), "last_idx"))) -> app(M2, a) = app(M, a)) ->
  mallocng.meta_in_memory(M2, h, app(app(A2, "metas"), h)) -> mallocng.masks_ok(A2, M2, h) -> mallocng.big_ok(A2, h) ->
  mallocng.group_ok(A2, M2, b, h)
proof
  assume ha hb hh hmo uo gok ag mim2 msk2 big2
  let V := app(app(A, "metas"), h)
  let V2 := app(app(A2, "metas"), h)
  have fm fp fl fs ff fv fn st gr ss sg := apply(mp.mo_geom[A := A, A2 := A2, x := h], hmo, hh)
  have esl := apply(mp.mo_field[A := A, A2 := A2, k := "slots"], hmo, simp())
  have eus := apply(mp.mo_field[A := A, A2 := A2, k := "used"], hmo, simp())
  have eac := apply(mp.mo_field[A := A, A2 := A2, k := "active"], hmo, simp())
  have vt: V in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := app(A, "metas"), x := h], simp(ha), hh)
  have vmem: app(V, "mem") in omega by simp(vt)
  have vlast: app(V, "last_idx") in omega by simp(vt)
  have sn := apply(mp.stride_nat, ha, hh, gok)
  have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
  have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
  have {cls, hdr, hdr_own, act, nslots, small, mapped, nested, linked, unlinked, slots, sentinel, chk_own, offs} := expand(gok, mallocng.group_ok)
  let S := mallocng.stride(V)
  let SE := mallocng.slot_end(V, app(V, "last_idx"))
  have sse: all i. start: mallocng.slot_start(V, i) = int_add(int_add(app(V, "mem"), 16), int_mul(S, i)) && end: mallocng.slot_end(V, i) = int_sub(int_add(int_add(int_add(app(V, "mem"), 16), int_mul(S, i)), S), 4) proof
    fix i
    have s1: mallocng.slot_start(V, i) = int_add(int_add(app(V, "mem"), 16), int_mul(S, i)) by defs(arith(cu), mallocng.slot_start, mallocng.storage)
    have s2: mallocng.slot_end(V, i) = int_sub(int_add(int_add(int_add(app(V, "mem"), 16), int_mul(S, i)), S), 4) by defs(simp(s1, ci), mallocng.slot_end)
    show by taut(s1, s2)
  qed
  have {seE = end} := all_elim(sse, {app(V, "last_idx")})
  have ml: int_mul(S, app(V, "last_idx")) in omega by simp(sn, vlast)
  have seo: SE in omega by arith(seE, ml, vmem, sn)
  // the header's word and active index, the last slot's end: as before
  have ag8: all j. j in omega -> int_lt(j, 8) -> app(M2, int_add(app(V, "mem"), j)) = app(M, int_add(app(V, "mem"), j)) proof
    fix j
    assume hj hjl
    show := mp(all_elim(ag, {int_add(app(V, "mem"), j)}), simp(vmem, hj), arith(vmem, hj), arith(seE, ml, vmem, sn, hj, hjl))
  qed
  have rh := apply(mp.agree_rd[M := M, M2 := M2, a := app(V, "mem"), n := 8], simp(), ag8)
  have {bx = byte} := apply(mp.agree_b8, mp(all_elim(ag, {int_add(app(V, "mem"), 8)}), simp(vmem), arith(vmem), arith(seE, ml, vmem, sn)))
  have {bs = byte} := apply(mp.agree_b8, mp(all_elim(ag, {SE}), seo, arith(seE, ml, vmem, sn), arith(seo)))
  // the slots: each as before (the frames' bytes in the group's)
  have sl2: all x0. x0 in omega -> int_lt(x0, seq_len(app(app(A2, "slots"), h))) -> mallocng.slot_ok(A2, M2, b, h, x0, app(app(app(A2, "slots"), h), x0)) proof
    fix i
    assume hi hil0
    have hil: int_lt(i, seq_len(app(app(A, "slots"), h))) := rewrite(esl, hil0)
    let u := app(app(app(A, "slots"), h), i)
    have so := mp(all_elim(slots, {i}), hi, hil)
    have slt: app(app(A, "slots"), h) in list_type(mallocng.Use) := mp(fn_space_app[a := omega, b := list_type(mallocng.Use), f := app(A, "slots"), x := h], simp(ha), hh)
    have ut := apply(at_type[l := app(app(A, "slots"), h), t := mallocng.Use, i := i], slt, hi, hil)
    have il: int_le(i, app(V, "last_idx")) by arith(nslots, hil, hi, vlast)
    have mi := mp(all_elim(ms.mul_le, {S}, {i}, {S}, {app(V, "last_idx")}), sn, hi, simp(sn), simp(vlast), arith(sn), il)
    have ssi sei := all_elim(sse, {i})
    have mo: int_mul(S, i) in omega by simp(sn, hi)
    have sso: mallocng.slot_start(V, i) in omega by arith(ssi, vmem, mo)
    have seio: mallocng.slot_end(V, i) in omega by arith(sei, vmem, mo, sn)
    have s5: int_le(5, mallocng.slot_start(V, i)) by arith(ssi, vmem, mo)
    have agi: all a. a in omega -> int_le(int_sub(mallocng.slot_start(V, i), 5), a) -> int_le(a, mallocng.slot_end(V, i)) -> app(M2, a) = app(M, a) proof
      fix a
      assume hao h1 h2
      show := mp(all_elim(ag, {a}), hao, arith(h1, ssi, vmem, mo), arith(h2, sei, seE, mi, vmem, mo, sn, ml))
    qed
    have s1 s2 := all_elim(ss, {i})
    have c0: u = tag(0, empty) -> mallocng.slot_ok(A2, M2, b, h, i, app(app(app(A2, "slots"), h), i)) proof
      assume e
      show by defs(simp(esl, e), mallocng.slot_ok)
    qed
    have c1: !(u = tag(0, empty)) -> fst(u) = 1 -> mallocng.slot_ok(A2, M2, b, h, i, app(app(app(A2, "slots"), h), i)) proof
      assume e0 e1
      have po := apply(mp.use_nat, ut, (!(fst(u) = 0) by simp(e1)), (!(fst(u) = 3) by simp(e1)))
      let P := snd(u)
      have ue: u = tag(1, P) by simp(apply(mp.use_eta, ut), e1)
      have s0: !(app(b, bits_of_int(64, P)) = none) && mallocng.hdr_free(b, P) && mallocng.frame_ok(M, V, i, P, snd(app(b, bits_of_int(64, P))), 0)
        by simp(expand(rewrite(ue, so), mallocng.slot_ok))
      have nb hf fo := s0
      have bt := mp(fn_space_app[a := bits(64), b := option(omega), f := b, x := bits_of_int(64, P)], hb, simp())
      have nn := apply(some_val, bt, nb)
      have f2 := apply(mp.frame_agree[M := M, M2 := M2, v := V, v2 := V2, i := i, p := P, n := snd(app(b, bits_of_int(64, P))), tag := 0], fo, s1, s2, sg, fs, sso, seio, s5, po, nn, agi)
      show by defs(simp(esl, e0, e1, nb, hf, f2), mallocng.slot_ok)
    qed
    have c2: !(u = tag(0, empty)) -> fst(u) = 2 -> mallocng.slot_ok(A2, M2, b, h, i, app(app(app(A2, "slots"), h), i)) proof
      assume e0 e2
      have ho := apply(mp.use_nat, ut, (!(fst(u) = 0) by simp(e2)), (!(fst(u) = 3) by simp(e2)))
      let H2 := snd(u)
      have ue: u = tag(2, H2) by simp(apply(mp.use_eta, ut), e2)
      let W := app(app(A, "metas"), H2)
      let NW := int_sub(int_add(mallocng.UNIT, int_mul(mallocng.stride(W), int_add(app(W, "last_idx"), 1))), mallocng.IB)
      have s0: ((((mallocng.is_used(A, H2) && app(W, "maplen") = 0) && app(W, "mem") = mallocng.slot_start(V, i)) &&
          int_le(int_add(mallocng.UNIT, int_mul(mallocng.stride(W), int_add(app(W, "last_idx"), 1))), mallocng.stride(V))) && mallocng.hdr_free(b, app(W, "mem"))) &&
          mallocng.frame_ok(M, V, i, app(W, "mem"), NW, 6)
        by simp(expand(rewrite(ue, so), mallocng.slot_ok))
      have iu wm0 wme wst whf fo := s0
      have gw := apply(mp.used_group, uo, iu)
      have wn := apply(mp.stride_nat, ha, ho, gw)
      have wt: W in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := app(A, "metas"), x := H2], simp(ha), ho)
      have wl: app(W, "last_idx") in omega by simp(wt)
      have wmo: app(W, "mem") in omega by simp(wt)
      have mw: int_mul(mallocng.stride(W), int_add(app(W, "last_idx"), 1)) in omega by simp(wn, wl)
      have nwo: NW in omega by arith(mw, cu, ci)
      have f2 := apply(mp.frame_agree[M := M, M2 := M2, v := V, v2 := V2, i := i, p := app(W, "mem"), n := NW, tag := 6], fo, s1, s2, sg, fs, sso, seio, s5, wmo, nwo, agi)
      have {wm = mem, wp = maplen, wl2 = last, wst2 = stride} := apply(mp.mo_geom[A := A, A2 := A2, x := H2], hmo, ho)
      have iu2: mallocng.is_used(A2, H2) by defs(simp(eus, expand(iu, mallocng.is_used)), mallocng.is_used)
      show by defs(simp(esl, e0, e2, iu2, wm, wp, wl2, wst2, s1, st, wm0, wme, wst, whf, f2), mallocng.slot_ok)
    qed
    have c3: !(u = tag(0, empty)) -> !(fst(u) = 1) -> !(fst(u) = 2) -> mallocng.slot_ok(A2, M2, b, h, i, app(app(app(A2, "slots"), h), i)) proof
      assume e0 e1 e2
      show by defs(simp(esl, e0, e1, e2), mallocng.slot_ok)
    qed
    show by taut(c0, c1, c2, c3)
  qed
  have ch2: all x0. x0 in omega -> int_le(x0, int_add(app(V2, "last_idx"), 1)) -> !(int_sub(mallocng.slot_start(V2, x0), mallocng.IB) in malloc.live_of(b)) proof
    fix i
    assume hi hil
    have {s1 = start} := all_elim(ss, {i})
    have c := mp(all_elim(chk_own, {i}), hi, rewrite(fl, hil))
    show := rewrite(sym(s1), c)
  qed
  have {s2l = end} := all_elim(ss, {app(V, "last_idx")})
  have se2: mallocng.slot_end(V2, app(V2, "last_idx")) = SE by simp(fl, s2l)
  // each conjunct: as before, read on A2 and M2
  have cls2 := rewrite(sym(fs), cls)
  have hdr2 := rewrite(sym(fm), rewrite(sym(rh), hdr))
  have ho2 := rewrite(sym(fm), hdr_own)
  have act2 := rewrite(sym(fl), rewrite(sym(fm), rewrite(sym(bx), act)))
  have ns2 := rewrite(sym(fl), rewrite(sym(esl), nslots))
  have sm2 := rewrite(sym(fl), rewrite(sym(fm), rewrite(sym(bx), rewrite(sym(st), small))))
  have mp2 := rewrite(sym(fl), rewrite(sym(fm), rewrite(sym(fp), rewrite(sym(st), mapped))))
  have ne2 := rewrite(sym(esl), rewrite(sym(eus), rewrite(sym(fp), nested)))
  have lk2 := rewrite(sym(eac), rewrite(sym(fs), rewrite(sym(fn), linked)))
  have ul2 := rewrite(sym(fv), rewrite(sym(fn), unlinked))
  have sn2 := rewrite(sym(se2), rewrite(sym(bs), sentinel))
  have of2 := rewrite(sym(fl), rewrite(sym(st), offs))
  show by defs(taut(mim2, cls2, hdr2, ho2, act2, ns2, msk2, sm2, mp2, ne2, big2, lk2, ul2, sl2, sn2, ch2, of2), mallocng.group_ok)
qed

// A2 differing from A in the groups' masks only: what reads no group
// field the same for both
theorem mp.mo_same(c, A, A2, M, b, brk): mallocng_purpose.masks_only(A, A2) ->
  part: mallocng.metas_partition(A2) = mallocng.metas_partition(A) && in_slots: mallocng.blocks_ok(A2, b) = mallocng.blocks_ok(A, b) &&
  brk: mallocng.brk_ok(A2, brk) = mallocng.brk_ok(A, brk) && fixed: mallocng.fixed_free(c, A2, b) = mallocng.fixed_free(c, A, b) &&
  franges: mallocng.fixed_ranges(c, A2) = mallocng.fixed_ranges(c, A) && ctx: mallocng.ctx_ok(c, A2, M) = mallocng.ctx_ok(c, A, M) &&
  fresh: mallocng.fresh_ok(c, A2, M) = mallocng.fresh_ok(c, A, M) && auxv: mallocng.auxv_ranges(A2) = mallocng.auxv_ranges(A)
proof
  assume h
  have {e = others} := expand(h, mallocng_purpose.masks_only)
  let X := app(A, "metas")
  have t: ((((mallocng.metas_partition(fn_update(A2, "metas", X)) = mallocng.metas_partition(A2) && mallocng.blocks_ok(fn_update(A2, "metas", X), b) = mallocng.blocks_ok(A2, b)) &&
    (mallocng.brk_ok(fn_update(A2, "metas", X), brk) = mallocng.brk_ok(A2, brk) && mallocng.fixed_free(c, fn_update(A2, "metas", X), b) = mallocng.fixed_free(c, A2, b))) &&
   (mallocng.fixed_ranges(c, fn_update(A2, "metas", X)) = mallocng.fixed_ranges(c, A2) && mallocng.ctx_ok(c, fn_update(A2, "metas", X), M) = mallocng.ctx_ok(c, A2, M))) &&
   mallocng.fresh_ok(c, fn_update(A2, "metas", X), M) = mallocng.fresh_ok(c, A2, M)) && mallocng.auxv_ranges(fn_update(A2, "metas", X)) = mallocng.auxv_ranges(A2)
    by defs(simp(), mallocng.metas_partition, mallocng.meta_slot, mallocng.is_used, mallocng.avail_meta, mallocng.blocks_ok, mallocng.brk_ok, mallocng.fixed_free,
      mallocng.fixed_ranges, mallocng.auxv_ranges, mallocng.ctx_ok, mallocng.ctx_word, mallocng.fresh_ok)
  have t2 := rewrite(e, t)
  have a1 a2 a3 a4 a5 a6 a7 a8 := t2
  show by taut(sym(a1), sym(a2), sym(a3), sym(a4), sym(a5), sym(a6), sym(a7), sym(a8))
qed

// a meta slot: in an area's page, past its header, 40 bytes in from it
theorem mp.meta_page(A, g): A in mallocng.Abs -> mallocng.meta_slot(A, g) -> nat: g in omega &&
  area: (ex k. k in omega && int_lt(k, seq_len(app(A, "areas"))) &&
    int_le(int_add(app(app(A, "areas"), k), 24), g) && int_le(int_add(g, 40), int_add(app(app(A, "areas"), k), 4096)) &&
    int_mod(int_sub(int_sub(g, app(app(A, "areas"), k)), 24), 40) = 0)
proof
  assume ha hs
  obtain k j, hk hj hkl hjl he from expand(hs, mallocng.meta_slot)
  have rl: app(A, "areas") in list_type(omega) by simp(ha)
  have aro := mp(at_type[l := app(A, "areas"), t := omega, i := k], rl, hk, hkl)
  have cs: mallocng.AREA_HDR = 24 && mallocng.META_SIZE = 40 && mallocng.NSLOTS = 101 by defs(simp(), mallocng.AREA_HDR, mallocng.META_SIZE, mallocng.NSLOTS)
  have ge: g = int_add(int_add(app(app(A, "areas"), k), 24), int_mul(40, j)) by simp(expand(he, mallocng.meta_at), cs)
  have jl: int_lt(j, 101) by simp(hjl, cs)
  have r: (int_le(int_add(app(app(A, "areas"), k), 24), g) && int_le(int_add(g, 40), int_add(app(app(A, "areas"), k), 4096))) &&
    int_mod(int_sub(int_sub(g, app(app(A, "areas"), k)), 24), 40) = 0 by arith(ge, aro, hj, jl)
  have go: g in omega by simp(ge, aro, hj)
  have ex: ex k. k in omega && int_lt(k, seq_len(app(A, "areas"))) &&
    int_le(int_add(app(app(A, "areas"), k), 24), g) && int_le(int_add(g, 40), int_add(app(app(A, "areas"), k), 4096)) &&
    int_mod(int_sub(int_sub(g, app(app(A, "areas"), k)), 24), 40) = 0 by ex_intro({k}, taut(hk, hkl, r))
  show by taut(go, ex)
qed

// distinct meta slots: apart (in one area 40 bytes apart, areas apart)
theorem mp.meta_disj(c, A, M, b, brk, g, l, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds(c, A, M, b, brk) ->
  mallocng.meta_slot(A, g) -> mallocng.meta_slot(A, l) -> !(l = g) -> a in omega -> int_le(l, a) -> int_lt(a, int_add(l, 40)) ->
  !(int_le(g, a) && int_lt(a, int_add(g, 40)))
proof
  assume hc hu ha H hg hl hne hao h1 h2
  have go gex := apply(mp.meta_page, ha, hg)
  obtain k, hk hkl g1 g2 g3 from gex
  have lo lex := apply(mp.meta_page, ha, hl)
  obtain k2, hk2 hk2l l1 l2 l3 from lex
  have rl: app(A, "areas") in list_type(omega) by simp(ha)
  have ako := mp(at_type[l := app(A, "areas"), t := omega, i := k], rl, hk, hkl)
  have ak2 := mp(at_type[l := app(A, "areas"), t := omega, i := k2], rl, hk2, hk2l)
  have n: int_le(g, a) && int_lt(a, int_add(g, 40)) -> false proof
    assume hin
    have i1 i2 := hin
    have same: k = k2 -> false proof
      assume e
      have l3e := rewrite(sym(e), l3)
      show by arith(g3, l3e, g1, l1, i1, i2, h1, h2, hne, ako, hao, go, lo)
    qed
    have diff: !(k = k2) -> false proof
      assume e
      have ina: int_le(app(app(A, "areas"), k2), a) && int_lt(a, int_add(app(app(A, "areas"), k2), 4096)) by arith(l1, l2, h1, h2, ak2, hao)
      have {ar = areas} := apply(mp.area_apart[c := c, A := A, M := M, b := b, brk := brk, k := k2, a := a], hc, hu, ha, H, hk2, hk2l, hao, taut(ina), taut(ina))
      have o := mp(all_elim(ar, {k}), hk, hkl, (!(k = k2) by taut(e)))
      have ink: int_le(app(app(A, "areas"), k), a) && int_lt(a, int_add(app(app(A, "areas"), k), 4096)) by arith(g1, g2, i1, i2, ako, hao)
      show by taut(o, ink)
    qed
    show by taut(same, diff)
  qed
  show by taut(n)
qed

// a group's bytes from its header to its last slot's end: in its range
theorem mp.group_bytes(A, M, b, h, a): A in mallocng.Abs -> h in omega -> mallocng.group_ok(A, M, b, h) -> a in omega ->
  int_le(app(app(app(A, "metas"), h), "mem"), a) -> int_le(a, mallocng.slot_end(app(app(A, "metas"), h), app(app(app(A, "metas"), h), "last_idx"))) ->
  mallocng.in_range(a, mallocng.group_range(app(app(A, "metas"), h)))
proof
  assume ha hh gok hao h1 h2
  let V := app(app(A, "metas"), h)
  let S := mallocng.stride(V)
  have vt: V in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := app(A, "metas"), x := h], simp(ha), hh)
  have vo1 vo2 vo3 := (app(V, "mem") in omega && app(V, "maplen") in omega && app(V, "last_idx") in omega by simp(vt))
  have {gmp = mapped} := expand(gok, mallocng.group_ok)
  have so := apply(mp.stride_nat, ha, hh, gok)
  have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
  have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
  have se: mallocng.slot_end(V, app(V, "last_idx")) = int_sub(int_add(int_add(app(V, "mem"), 16), int_mul(S, int_add(app(V, "last_idx"), 1))), 4)
    by defs(arith(cu, ci, so, vo3), mallocng.slot_end, mallocng.slot_start, mallocng.storage)
  have mo: int_mul(S, int_add(app(V, "last_idx"), 1)) in omega by simp(so, vo3)
  have c1: int_lt(0, app(V, "maplen")) -> mallocng.in_range(a, mallocng.group_range(V)) proof
    assume k
    have {big = fits} := mp(gmp, k)
    have e := mp(ite_t[c := int_lt(0, app(V, "maplen")), a := pair(app(V, "mem"), int_mul(app(V, "maplen"), 4096)), b := pair(app(V, "mem"), int_add(int_sub(int_add(mallocng.UNIT, int_mul(S, int_add(app(V, "last_idx"), 1))), mallocng.IB), 1))], k)
    have r: int_le(app(V, "mem"), a) && int_lt(a, int_add(app(V, "mem"), int_mul(app(V, "maplen"), 4096))) by arith(h1, h2, se, big, cu, mo)
    show by defs(simp(e, r), mallocng.group_range, mallocng.in_range)
  qed
  have c2: !int_lt(0, app(V, "maplen")) -> mallocng.in_range(a, mallocng.group_range(V)) proof
    assume k
    have e := mp(ite_f[c := int_lt(0, app(V, "maplen")), a := pair(app(V, "mem"), int_mul(app(V, "maplen"), 4096)), b := pair(app(V, "mem"), int_add(int_sub(int_add(mallocng.UNIT, int_mul(S, int_add(app(V, "last_idx"), 1))), mallocng.IB), 1))], k)
    have r: int_le(app(V, "mem"), a) && int_lt(a, int_add(app(V, "mem"), int_add(int_sub(int_add(mallocng.UNIT, int_mul(S, int_add(app(V, "last_idx"), 1))), mallocng.IB), 1))) by arith(h1, h2, se, cu, ci, mo)
    show by defs(simp(e, r), mallocng.group_range, mallocng.in_range)
  qed
  show by taut(c1, c2)
qed

// (masks only: which groups are in use, the areas' conditions the same)
theorem mp.mo_used(c, A, A2, M, x): mallocng_purpose.masks_only(A, A2) ->
  used: mallocng.is_used(A2, x) = mallocng.is_used(A, x) && areas: mallocng.areas_ok(c, A2, M) = mallocng.areas_ok(c, A, M)
proof
  assume h
  have {e = others} := expand(h, mallocng_purpose.masks_only)
  have t: mallocng.is_used(fn_update(A2, "metas", app(A, "metas")), x) = mallocng.is_used(A2, x) &&
      mallocng.areas_ok(c, fn_update(A2, "metas", app(A, "metas")), M) = mallocng.areas_ok(c, A2, M)
    by defs(simp(), mallocng.is_used, mallocng.areas_ok, mallocng.ctx_word)
  have a1 a2 := rewrite(e, t)
  show by taut(sym(a1), sym(a2))
qed

// (masks only: the same bytes in reserved slots)
theorem mp.mo_inres(A, A2, a): A in mallocng.Abs -> mallocng_purpose.masks_only(A, A2) ->
  (mallocng.in_reserved(A2, a) <-> mallocng.in_reserved(A, a))
proof
  assume ha h
  have esl := apply(mp.mo_field[A := A, A2 := A2, k := "slots"], h, simp())
  have d1: mallocng.in_reserved(A2, a) -> mallocng.in_reserved(A, a) proof
    assume r
    obtain x i, hx hi hu hil hs his from expand(r, mallocng.in_reserved)
    have {u1 = used} := apply(mp.mo_used[c := empty, A := A, A2 := A2, M := empty, x := x], h)
    have {ss = slots} := apply(mp.mo_geom[A := A, A2 := A2, x := x], h, hx)
    have s1 s2 := all_elim(ss, {i})
    have is2: mallocng.in_slot(app(app(A, "metas"), x), i, a) by defs(simp(rewrite(s1, rewrite(s2, expand(his, mallocng.in_slot)))), mallocng.in_slot)
    have ex: ex x0. ex x1. (x0 in omega && x1 in omega) && (((mallocng.is_used(A, x0) && int_lt(x1, seq_len(app(app(A, "slots"), x0)))) && app(app(app(A, "slots"), x0), x1) = tag(3, empty)) && mallocng.in_slot(app(app(A, "metas"), x0), x1, a))
      by ex_intro({x}, {i}, taut(hx, hi, rewrite(u1, hu), rewrite(esl, hil), rewrite(esl, hs), is2))
    show by defs(ex, mallocng.in_reserved)
  qed
  have d2: mallocng.in_reserved(A, a) -> mallocng.in_reserved(A2, a) proof
    assume r
    obtain x i, hx hi hu hil hs his from expand(r, mallocng.in_reserved)
    have {u1 = used} := apply(mp.mo_used[c := empty, A := A, A2 := A2, M := empty, x := x], h)
    have {ss = slots} := apply(mp.mo_geom[A := A, A2 := A2, x := x], h, hx)
    have s1 s2 := all_elim(ss, {i})
    have is2: mallocng.in_slot(app(app(A2, "metas"), x), i, a) by defs(simp(s1, s2, expand(his, mallocng.in_slot)), mallocng.in_slot)
    have ex: ex x0. ex x1. (x0 in omega && x1 in omega) && (((mallocng.is_used(A2, x0) && int_lt(x1, seq_len(app(app(A2, "slots"), x0)))) && app(app(app(A2, "slots"), x0), x1) = tag(3, empty)) && mallocng.in_slot(app(app(A2, "metas"), x0), x1, a))
      by ex_intro({x}, {i}, taut(hx, hi, rewrite(sym(u1), hu), rewrite(sym(esl), hil), rewrite(sym(esl), hs), is2))
    show by defs(ex, mallocng.in_reserved)
  qed
  show by taut(d1, d2)
qed

// (masks only: the same separate regions)
theorem mp.mo_regions(c, A, A2): A in mallocng.Abs -> mallocng_purpose.masks_only(A, A2) -> mallocng.regions(c, A2) = mallocng.regions(c, A)
proof
  assume ha h
  have {e = others} := expand(h, mallocng_purpose.masks_only)
  let GA := fn_build(int_sub(seq_len(app(A, "used")), 0), x0. ite(int_lt(0, app(app(app(A, "metas"), app(app(A, "used"), int_add(0, x0))), "maplen")), mallocng.group_range(app(app(A, "metas"), app(app(A, "used"), int_add(0, x0)))), pair(0, 0)))
  let GA2 := fn_build(int_sub(seq_len(app(A, "used")), 0), x0. ite(int_lt(0, app(app(app(A2, "metas"), app(app(A, "used"), int_add(0, x0))), "maplen")), mallocng.group_range(app(app(A2, "metas"), app(app(A, "used"), int_add(0, x0)))), pair(0, 0)))
  have ul: app(A, "used") in list_type(omega) by simp(ha)
  have ud: int_sub(seq_len(app(A, "used")), 0) in omega by arith(ul)
  have pw: all x0. x0 in int_sub(seq_len(app(A, "used")), 0) ->
      ite(int_lt(0, app(app(app(A2, "metas"), app(app(A, "used"), int_add(0, x0))), "maplen")), mallocng.group_range(app(app(A2, "metas"), app(app(A, "used"), int_add(0, x0)))), pair(0, 0)) =
      ite(int_lt(0, app(app(app(A, "metas"), app(app(A, "used"), int_add(0, x0))), "maplen")), mallocng.group_range(app(app(A, "metas"), app(app(A, "used"), int_add(0, x0)))), pair(0, 0)) proof
    fix x0
    assume hx
    have xo := mp(nat_elem[k := int_sub(seq_len(app(A, "used")), 0), i := x0], ud, hx)
    have xl := mp(nat_mem_lt[k := int_sub(seq_len(app(A, "used")), 0), i := x0], ud, hx)
    have uo := apply(at_type[l := app(A, "used"), t := omega, i := int_add(0, x0)], ul, simp(xo), arith(xo, xl, ul))
    have {fp = maplen, gr = range} := apply(mp.mo_geom[A := A, A2 := A2, x := app(app(A, "used"), int_add(0, x0))], h, uo)
    show by simp(fp, gr)
  qed
  have eg: GA2 = GA := mp(fn_build_ext[d := int_sub(seq_len(app(A, "used")), 0),
    f := x0. ite(int_lt(0, app(app(app(A2, "metas"), app(app(A, "used"), int_add(0, x0))), "maplen")), mallocng.group_range(app(app(A2, "metas"), app(app(A, "used"), int_add(0, x0)))), pair(0, 0)),
    g := x0. ite(int_lt(0, app(app(app(A, "metas"), app(app(A, "used"), int_add(0, x0))), "maplen")), mallocng.group_range(app(app(A, "metas"), app(app(A, "used"), int_add(0, x0)))), pair(0, 0))], pw)
  have eus := apply(mp.mo_field[A := A, A2 := A2, k := "used"], h, simp())
  have ear := apply(mp.mo_field[A := A, A2 := A2, k := "areas"], h, simp())
  have ere := apply(mp.mo_field[A := A, A2 := A2, k := "reserve"], h, simp())
  have erc := apply(mp.mo_field[A := A, A2 := A2, k := "reserve_cnt"], h, simp())
  show by defs(simp(eus, ear, ere, erc, eg), mallocng.regions)
qed

// (two views with the same pages: the same access)
theorem mp.pg_same(M, M2, x): mallocng.pg(M2, x) = mallocng.pg(M, x) ->
  rw: (mallocng.m_rw(M2, x) <-> mallocng.m_rw(M, x)) && mapped: (mallocng.m_mapped(M2, x) <-> mallocng.m_mapped(M, x))
proof
  assume h
  show by defs(simp(h), mallocng.m_rw, mallocng.m_mapped)
qed

// a cyclic list on a view agreeing at its links: the same list
theorem mp.cyclic_agree(M, M2, hd, l): mallocng.cyclic(M, hd, l) ->
  (all i. i in omega -> int_lt(i, seq_len(l)) -> mallocng.rd(M2, int_add(app(l, i), 8), 8) = mallocng.rd(M, int_add(app(l, i), 8), 8) &&
     mallocng.rd(M2, app(l, i), 8) = mallocng.rd(M, app(l, i), 8)) ->
  mallocng.cyclic(M2, hd, l)
proof
  assume H ag
  have c1 c2 c3 := expand(H, mallocng.cyclic)
  have c3b: all x0. x0 in omega -> int_lt(x0, seq_len(l)) -> mallocng.rd(M2, int_add(app(l, x0), 8), 8) = app(l, int_mod(int_add(x0, 1), seq_len(l))) &&
      mallocng.rd(M2, app(l, x0), 8) = app(l, int_mod(int_sub(int_add(x0, seq_len(l)), 1), seq_len(l))) proof
    fix i
    assume hi hil
    have a1 a2 := mp(all_elim(ag, {i}), hi, hil)
    have b1 b2 := mp(all_elim(c3, {i}), hi, hil)
    show by taut(trans(a1, b1), trans(a2, b2))
  qed
  show by defs(taut(c1, c2, c3b), mallocng.cyclic)
qed

// a meta's record on a view agreeing at its 40 bytes: the same
theorem mp.mim_mem(M, M2, h, v): h in omega -> mallocng.meta_in_memory(M, h, v) ->
  (all j. j in omega -> int_lt(j, 40) -> app(M2, int_add(h, j)) = app(M, int_add(h, j))) -> mallocng.meta_in_memory(M2, h, v)
proof
  assume hh hm ag
  have rw: all o. all n. o in omega -> n in omega -> int_le(int_add(o, n), 40) -> mallocng.rd(M2, int_add(h, o), n) = mallocng.rd(M, int_add(h, o), n) proof
    fix o n
    assume ho hn hl
    have ai: all i. i in omega -> int_lt(i, n) -> app(M2, int_add(int_add(h, o), i)) = app(M, int_add(int_add(h, o), i)) proof
      fix i
      assume hi hil
      have e: int_add(int_add(h, o), i) = int_add(h, int_add(o, i)) by arith(hh, ho, hi)
      have a := mp(all_elim(ag, {int_add(o, i)}), simp(ho, hi), arith(hl, hil, hi, ho, hn))
      show := rewrite(sym(e), a)
    qed
    show := apply(mp.agree_rd, hn, ai)
  qed
  have r0 := rewrite((int_add(h, 0) = h by arith(hh)), mp(all_elim(rw, {0}, {8}), simp(), simp(), simp()))
  have r8 := mp(all_elim(rw, {8}, {8}), simp(), simp(), simp())
  have r16 := mp(all_elim(rw, {16}, {8}), simp(), simp(), simp())
  have r24 := mp(all_elim(rw, {24}, {4}), simp(), simp(), simp())
  have r28 := mp(all_elim(rw, {28}, {4}), simp(), simp(), simp())
  have r32 := mp(all_elim(rw, {32}, {8}), simp(), simp(), simp())
  have m1 m2 m3 m4 m5 m6 m7 m8 m9 := expand(hm, mallocng.meta_in_memory)
  show by defs(taut(rewrite(sym(r0), m1), rewrite(sym(r8), m2), rewrite(sym(r16), m3), rewrite(sym(r24), m4), rewrite(sym(r28), m5), rewrite(sym(r32), m6), m7, m8, m9),
    mallocng.meta_in_memory)
qed

// a group's masks on a view agreeing at its header's active index and its
// slots' check bytes: the same
theorem mp.masks_mem(A, M, M2, h): mallocng.masks_ok(A, M, h) ->
  mallocng.b8(M2, int_add(app(app(app(A, "metas"), h), "mem"), 8)) = mallocng.b8(M, int_add(app(app(app(A, "metas"), h), "mem"), 8)) ->
  (all i. i in omega -> int_le(i, app(app(app(A, "metas"), h), "last_idx")) ->
     mallocng.b8(M2, int_sub(mallocng.slot_start(app(app(A, "metas"), h), i), 4)) = mallocng.b8(M, int_sub(mallocng.slot_start(app(app(A, "metas"), h), i), 4))) ->
  mallocng.masks_ok(A, M2, h)
proof
  assume hm ex es
  have mk := expand(hm, mallocng.masks_ok)
  have r: all x0. x0 in omega -> int_lt(x0, 32) -> (((mallocng.bit(app(app(app(A, "metas"), h), "avail"), x0) = 1 -> int_le(x0, int_mod(mallocng.b8(M2, int_add(app(app(app(A, "metas"), h), "mem"), 8)), 32)) && mallocng.bit(app(app(app(A, "metas"), h), "freed"), x0) = 0) &&
      (int_lt(0, int_add(mallocng.bit(app(app(app(A, "metas"), h), "avail"), x0), mallocng.bit(app(app(app(A, "metas"), h), "freed"), x0))) -> int_le(x0, app(app(app(A, "metas"), h), "last_idx")))) &&
      (int_le(x0, app(app(app(A, "metas"), h), "last_idx")) -> (app(app(app(A, "slots"), h), x0) = tag(0, empty) <-> int_lt(0, int_add(mallocng.bit(app(app(app(A, "metas"), h), "avail"), x0), mallocng.bit(app(app(app(A, "metas"), h), "freed"), x0)))) &&
        mallocng.b8(M2, int_sub(mallocng.slot_start(app(app(A, "metas"), h), x0), 4)) = 0)) &&
      (int_lt(int_mod(mallocng.b8(M2, int_add(app(app(app(A, "metas"), h), "mem"), 8)), 32), x0) && int_le(x0, app(app(app(A, "metas"), h), "last_idx")) -> mallocng.bit(app(app(app(A, "metas"), h), "freed"), x0) = 1) proof
    fix i
    assume hi hil
    have a b cc d := mp(all_elim(mk, {i}), hi, hil)
    have c2: int_le(i, app(app(app(A, "metas"), h), "last_idx")) -> (app(app(app(A, "slots"), h), i) = tag(0, empty) <-> int_lt(0, int_add(mallocng.bit(app(app(app(A, "metas"), h), "avail"), i), mallocng.bit(app(app(app(A, "metas"), h), "freed"), i)))) &&
        mallocng.b8(M2, int_sub(mallocng.slot_start(app(app(A, "metas"), h), i), 4)) = 0 proof
      assume hl
      have c1 c0 := mp(cc, hl)
      show by taut(c1, rewrite(sym(mp(all_elim(es, {i}), hi, hl)), c0))
    qed
    show by taut(rewrite(sym(ex), a), b, c2, rewrite(sym(ex), d))
  qed
  show by defs(r, mallocng.masks_ok)
qed

// (the data symbols' ranges: the context, the lock, libc's)
theorem mp.data_at(c): app(mallocng.data_ranges(c), 0) = pair(app(c, "ctx"), mallocng.CTX_SIZE) && app(mallocng.data_ranges(c), 1) = pair(app(c, "lock"), 4) &&
  app(mallocng.data_ranges(c), 2) = pair(app(c, "libc"), 16)
proof
  let DR := seq_concat(seq_concat(seq_one(pair(app(c, "ctx"), mallocng.CTX_SIZE)), seq_one(pair(app(c, "lock"), 4))), seq_one(pair(app(c, "libc"), 16)))
  have e0 := at({app(DR, 0)})
  have e1 := at({app(DR, 1)})
  have e2 := at({app(DR, 2)})
  show by defs(taut(e0, e1, e2), mallocng.data_ranges)
qed

// (a byte of one of the fixed pieces: in the fixed ranges)
theorem mp.fixed_in(c, A, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs ->
  (mallocng.in_ranges(a, seq_concat(seq_concat(mallocng.ro_ranges(app(c, "file")), mallocng.data_ranges(c)), mallocng.auxv_ranges(A))) ||
   mallocng.in_ranges(a, fn_build(int_sub(seq_len(app(A, "areas")), 0), x0. pair(app(app(A, "areas"), int_add(0, x0)), 4096))) ||
   mallocng.in_ranges(a, seq_one(pair(app(A, "reserve"), int_mul(4096, app(A, "reserve_cnt"))))) ||
   mallocng.in_ranges(a, seq_one(pair(app(c, "sct"), int_mul(2, 48))))) ->
  mallocng.in_ranges(a, mallocng.fixed_ranges(c, A))
proof
  assume hc hu ha hr
  have p1 p2 p3 p4 _ := apply(mp.fp_pieces, hc, hu, ha)
  let L1 := seq_concat(seq_concat(mallocng.ro_ranges(app(c, "file")), mallocng.data_ranges(c)), mallocng.auxv_ranges(A))
  let L2 := seq_concat(L1, fn_build(int_sub(seq_len(app(A, "areas")), 0), x0. pair(app(app(A, "areas"), int_add(0, x0)), 4096)))
  let L3 := seq_concat(L2, seq_one(pair(app(A, "reserve"), int_mul(4096, app(A, "reserve_cnt")))))
  let L4 := seq_concat(L3, seq_one(pair(app(c, "sct"), int_mul(2, 48))))
  have t2 := apply(tr.concat_list, p1, p2)
  have t3 := apply(tr.concat_list, t2, p3)
  have u3: mallocng.in_ranges(a, L3) -> mallocng.in_ranges(a, L4) proof
    assume h
    show := apply(mp.ranges_l, t3, p4, h)
  qed
  have u2: mallocng.in_ranges(a, L2) -> mallocng.in_ranges(a, L3) proof
    assume h
    show := apply(mp.ranges_l, t2, p3, h)
  qed
  have u1: mallocng.in_ranges(a, L1) -> mallocng.in_ranges(a, L2) proof
    assume h
    show := apply(mp.ranges_l, p1, p2, h)
  qed
  have r2: mallocng.in_ranges(a, fn_build(int_sub(seq_len(app(A, "areas")), 0), x0. pair(app(app(A, "areas"), int_add(0, x0)), 4096))) -> mallocng.in_ranges(a, L2) proof
    assume h
    show := apply(mp.ranges_r, p1, p2, h)
  qed
  have r3: mallocng.in_ranges(a, seq_one(pair(app(A, "reserve"), int_mul(4096, app(A, "reserve_cnt"))))) -> mallocng.in_ranges(a, L3) proof
    assume h
    show := apply(mp.ranges_r, t2, p3, h)
  qed
  have r4: mallocng.in_ranges(a, seq_one(pair(app(c, "sct"), int_mul(2, 48)))) -> mallocng.in_ranges(a, L4) proof
    assume h
    show := apply(mp.ranges_r, t3, p4, h)
  qed
  show by defs(taut(hr, u1, u2, u3, r2, r3, r4), mallocng.fixed_ranges)
qed

// (a byte of the context: in the front pieces -- the image's, the data
// symbols', the auxiliary vector's)
theorem mp.ctx_front(c, A, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.in_range(a, pair(app(c, "ctx"), mallocng.CTX_SIZE)) ->
  mallocng.in_ranges(a, seq_concat(seq_concat(mallocng.ro_ranges(app(c, "file")), mallocng.data_ranges(c)), mallocng.auxv_ranges(A)))
proof
  assume hc hu ha h
  have ro := apply(mp.ro_list, (app(c, "file") in seq_type(bits(8)) by simp(hc)))
  have cf: app(c, "ctx") in omega && app(c, "lock") in omega && app(c, "libc") in omega by simp(hc)
  have o1 := apply(tr.seq_one_type, (pair(app(c, "ctx"), mallocng.CTX_SIZE) in univ(1) by simp(cf)))
  have o2 := apply(tr.seq_one_type, (pair(app(c, "lock"), 4) in univ(1) by simp(cf)))
  have o3 := apply(tr.seq_one_type, (pair(app(c, "libc"), 16) in univ(1) by simp(cf)))
  have dl: mallocng.data_ranges(c) in list_type(univ(1)) by defs(apply(tr.concat_list, apply(tr.concat_list, o1, o2), o3), mallocng.data_ranges)
  have al: app(A, "auxv") in list_type(cart(omega, omega)) by simp(ha)
  have ad: int_sub(seq_len(app(A, "auxv")), 0) in omega by arith(al)
  have av: all x0. x0 in int_sub(seq_len(app(A, "auxv")), 0) -> ite(fst(app(app(A, "auxv"), int_add(0, x0))) = x86_64_linux.AT_RANDOM, pair(int_add(snd(app(app(A, "auxv"), int_add(0, x0))), 8), 8), pair(0, 0)) in univ(1) proof
    fix x0
    assume hx
    show by simp(hu)
  qed
  have a1 := apply(tr.seq_one_type, (pair(app(A, "auxv_at"), int_mul(16, seq_len(app(A, "auxv")))) in univ(1) by simp(hu)))
  have xl: mallocng.auxv_ranges(A) in list_type(univ(1)) by defs(apply(tr.concat_list, a1, apply(build_list, ad, av)), mallocng.auxv_ranges)
  have e0 _ _ := mp.data_at[c := c]
  have dlen: int_lt(0, seq_len(mallocng.data_ranges(c))) by defs(simp(), mallocng.data_ranges)
  have d0x: ex x0. x0 in omega && (int_lt(x0, seq_len(mallocng.data_ranges(c))) && mallocng.in_range(a, app(mallocng.data_ranges(c), x0)))
    by ex_intro({0}, taut((0 in omega by simp()), dlen, rewrite(sym(e0), h)))
  have d0: mallocng.in_ranges(a, mallocng.data_ranges(c)) by defs(d0x, mallocng.in_ranges)
  have c1 := apply(mp.ranges_r, ro, dl, d0)
  show := apply(mp.ranges_l, apply(tr.concat_list, ro, dl), xl, c1)
qed

// the context's bytes: the allocator's (no client's, no group's)
theorem mp.ctx_fp(c, A, vm, b, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_in(c, A, vm, b) ->
  a in omega -> int_le(app(c, "ctx"), a) -> int_lt(a, int_add(app(c, "ctx"), mallocng.CTX_SIZE)) -> a in mallocng.footprint(c, A, b)
proof
  assume hc hu ha hh hao h1 h2
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {huo = used, ff = fixed, hga = apart} := expand(H, mallocng.holds)
  have _ _ fc := expand(ff, mallocng.fixed_free)
  have nl := mp(all_elim(fc, {a}), hao, conj(h1, h2))
  have ir: mallocng.in_range(a, pair(app(c, "ctx"), mallocng.CTX_SIZE)) by defs(simp(h1, h2), mallocng.in_range)
  have cf := apply(mp.ctx_front[c := c, A := A, a := a], hc, hu, ha, ir)
  have nr := apply(mp.fixed_unres, hc, hu, ha, hao, huo, hga, taut(cf))
  show := apply(mp.fp_intro, hc, hu, ha, hao, nl, nr, taut(cf))
qed

// ... and, not a free one: the invariant's, accessible
theorem mp.ctx_acc(c, A, vm, b, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_in(c, A, vm, b) ->
  a in omega -> int_le(app(c, "ctx"), a) -> int_lt(a, int_add(app(c, "ctx"), mallocng.CTX_SIZE)) -> !mallocng.ctx_free(c, a) ->
  a in mallocng.held(c, A, b) && mallocng.m_rw(mallocng.mview(vm, mallocng.held(c, A, b)), a) &&
  !(app(snd(mallocng.pg(mallocng.mview(vm, mallocng.held(c, A, b)), a)), "kind") = 2)
proof
  assume hc hu ha hh hao h1 h2 nf
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {po = perms} := expand(H, mallocng.holds)
  have pd _ _ := expand(po, mallocng.perms_ok)
  have d0 _ _ := mp.data_at[c := c]
  have fp0 := apply(mp.ctx_fp[c := c, A := A, vm := vm, b := b, a := a], hc, hu, ha, hh, hao, h1, h2)
  have fp := apply(mp.held_intro, fp0, nf)
  have z0: 0 in omega by simp()
  have rw := mp(all_elim(pd, {0}, {a}), conj(z0, hao), (int_lt(0, 3) && int_le(fst(app(mallocng.data_ranges(c), 0)), a) &&
    int_lt(a, int_add(fst(app(mallocng.data_ranges(c), 0)), snd(app(mallocng.data_ranges(c), 0)))) && !mallocng.ctx_free(c, a) by simp(d0, h1, h2, nf)))
  show by taut(fp, rw)
qed

// a meta area's byte of the footprint: one the invariant reads (the areas
// apart from the context)
theorem mp.area_held(c, A, M, b, brk, k, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds(c, A, M, b, brk) ->
  k in omega -> int_lt(k, seq_len(app(A, "areas"))) -> a in omega -> int_le(app(app(A, "areas"), k), a) -> int_lt(a, int_add(app(app(A, "areas"), k), 4096)) ->
  a in mallocng.footprint(c, A, b) -> a in mallocng.held(c, A, b)
proof
  assume hc hu ha H hk hkl hao h1 h2 hf
  have {nd = data} := apply(mp.area_apart[c := c, A := A, M := M, b := b, brk := brk, k := k, a := a], hc, hu, ha, H, hk, hkl, hao, h1, h2)
  have e0 _ _ := mp.data_at[c := c]
  have n0 := rewrite(e0, mp(all_elim(nd, {0}), simp(), simp()))
  show := apply(mp.held_out, hf, n0)
qed

// a used group's byte of the footprint: one the invariant reads (the
// groups apart from the fixed ranges)
theorem mp.group_held(c, A, M, b, brk, h, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds(c, A, M, b, brk) ->
  mallocng.is_used(A, h) -> a in omega -> mallocng.in_range(a, mallocng.group_range(app(app(A, "metas"), h))) ->
  a in mallocng.footprint(c, A, b) -> a in mallocng.held(c, A, b)
proof
  assume hc hu ha H hh hao hr hf
  have {hga = apart} := expand(H, mallocng.holds)
  obtain k, hk hkl hke from expand(hh, mallocng.is_used)
  have na := mp(all_elim(expand(hga, mallocng.groups_apart), {k}, {a}), conj(hk, hao), conj(hkl, rewrite(sym(hke), hr)))
  have nc: !mallocng.in_range(a, pair(app(c, "ctx"), mallocng.CTX_SIZE)) proof
    assume hin
    have cf := apply(mp.ctx_front[c := c, A := A, a := a], hc, hu, ha, hin)
    have fi := apply(mp.fixed_in[c := c, A := A, a := a], hc, hu, ha, taut(cf))
    show by taut(fi, na)
  qed
  show := apply(mp.held_out, hf, nc)
qed

// a byte of the image's read-only segment i in the footprint: one the
// invariant reads (the image apart from the data symbols)
theorem mp.ro_held(c, A, M, b, brk, i, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds(c, A, M, b, brk) ->
  i in omega -> int_lt(i, x86_64_linux.phnum(app(c, "file"))) -> mallocng.in_range(a, app(mallocng.ro_ranges(app(c, "file")), i)) ->
  a in mallocng.footprint(c, A, b) -> a in mallocng.held(c, A, b)
proof
  assume hc hu ha H hi hil hr hf
  have {sep = sep} := expand(H, mallocng.holds)
  let F := app(c, "file")
  let PN := x86_64_linux.phnum(F)
  let RG := mallocng.regions(c, A)
  have fs: F in seq_type(bits(8)) by simp(hc)
  have pn: PN in omega by defs(mp(x86.le_at_nat[f := F, off := 56, n := 2], fs, simp()), x86_64_linux.phnum)
  have {er = ro, rlen = len} := apply(mp.reg_at[c := c, A := A, i := i], hc, hu, ha, hi)
  have {ed = data} := apply(mp.reg_at[c := c, A := A, i := 0], hc, hu, ha, simp())
  let JI := int_add(3, i)
  have rk: mallocng.in_range(a, app(RG, JI)) := rewrite(sym(mp(er, hil)), hr)
  have rl: app(A, "areas") in list_type(omega) by simp(ha)
  have lo: seq_len(app(A, "areas")) in omega by arith(rl)
  have ln: int_lt(JI, seq_len(RG)) by arith(rlen, hil, pn, hi, lo)
  have s := mp(all_elim(expand(sep, mallocng.separate), {JI}, {0}), conj((JI in omega by simp(hi)), (0 in omega by simp())), conj(conj(ln, (int_lt(0, seq_len(RG)) by arith(rlen, pn, lo))), (!(JI = 0) by arith(hi))))
  have rn := apply(mp.regions_nat, hc, hu, ha)
  have tk := apply(at_type[l := RG, t := cart(omega, omega), i := JI], rn, (JI in omega by simp(hi)), ln)
  have t0 := apply(at_type[l := RG, t := cart(omega, omega), i := 0], rn, simp(), arith(rlen, pn, lo))
  have o := apply(mp.apart_not, tk, t0, s, rk)
  have e0 _ _ := mp.data_at[c := c]
  have nc: !mallocng.in_range(a, pair(app(c, "ctx"), mallocng.CTX_SIZE)) := rewrite(e0, rewrite(mp(ed, (int_lt(0, 3) by simp())), o))
  show := apply(mp.held_out, hf, nc)
qed

// ----------------------------------------------------------------------
//  GIMPLE's reads of the allocator's bytes: the invariant's view of them

// n bytes at a, all in fp, read through vm: the view's
theorem mp.view_read(vm, fp, a, n): a in omega -> n in omega -> int_le(n, 18446744073709551616) ->
  (all i. i in omega -> int_lt(i, n) -> int_add(a, i) in fp) ->
  gimple.bytes_at(vm, a, n) = mallocng.rd(mallocng.mview(vm, fp), a, n)
proof
  assume ha hn hl hf
  have pw: all i. i in omega -> int_le(0, i) -> int_lt(i, n) ->
      int_mul(app(app(vm, "bytes"), bits_add(64, a, bits_of_int(64, i))), int_pow(256, i)) = int_mul(mallocng.b8(mallocng.mview(vm, fp), int_add(a, i)), int_pow(256, i)) proof
    fix i
    assume hi _ hil
    have inf := mp(all_elim(hf, {i}), hi, hil)
    have ai: int_add(a, i) in omega by arith(ha, hi)
    have ba: bits_add(64, a, bits_of_int(64, i)) = bits_of_int(64, int_add(a, i)) by defs(arith(ha, hi, hil, hl), bits_add, bits_of_int, pow2)
    have b8: mallocng.b8(mallocng.mview(vm, fp), int_add(a, i)) = app(app(vm, "bytes"), bits_of_int(64, int_add(a, i)))
      by defs(simp(inf, ai), mallocng.b8, mallocng.mview, some)
    show by simp(ba, b8)
  qed
  have e := mp(int_sum_ext[a := 0, b := n, f := i. int_mul(app(app(vm, "bytes"), bits_add(64, a, bits_of_int(64, i))), int_pow(256, i)),
    g := i. int_mul(mallocng.b8(mallocng.mview(vm, fp), int_add(a, i)), int_pow(256, i))], simp(), hn, pw)
  show by defs(e, gimple.bytes_at, mallocng.rd)
qed

// GIMPLE may read the allocator's bytes it sees readable (not the stack's)
theorem mp.view_usable(vm, fp, objs, a, n): a in omega ->
  (all i. i in omega -> int_lt(i, n) -> int_add(a, i) in fp && mallocng.m_mapped(mallocng.mview(vm, fp), int_add(a, i)) &&
     app(app(snd(mallocng.pg(mallocng.mview(vm, fp), int_add(a, i))), "prot"), "r") && !(app(snd(mallocng.pg(mallocng.mview(vm, fp), int_add(a, i))), "kind") = 2)) ->
  gimple.usable(vm, objs, a, n, false)
proof
  assume ha hf
  have g: all i. i in omega -> int_lt(i, n) -> ite(x86_64_linux.mapped(vm, int_div(int_add(a, i), x86_64_linux.PAGE)) && !(app(snd(app(app(vm, "pages"), int_div(int_add(a, i), x86_64_linux.PAGE))), "kind") = 2),
      ite(false, app(app(snd(app(app(vm, "pages"), int_div(int_add(a, i), x86_64_linux.PAGE))), "prot"), "w"), app(app(snd(app(app(vm, "pages"), int_div(int_add(a, i), x86_64_linux.PAGE))), "prot"), "r")),
      int_lt(int_add(a, i), int_pow(2, 64)) && int_add(a, i) in objs) proof
    fix i
    assume hi hl
    have f1 f2 f3 f4 := mp(all_elim(hf, {i}), hi, hl)
    have ai: int_add(a, i) in omega by arith(ha, hi)
    have pg: mallocng.pg(mallocng.mview(vm, fp), int_add(a, i)) = app(app(vm, "pages"), int_div(int_add(a, i), x86_64_linux.PAGE))
      by defs(simp(f1, ai), mallocng.pg, mallocng.mview, some)
    have m2 := expand(f2, mallocng.m_mapped)
    show by defs(simp(rewrite(pg, m2), rewrite(pg, f3), rewrite(pg, f4)), x86_64_linux.mapped)
  qed
  show by defs(g, gimple.usable)
qed

// ... and write the bytes it sees writable
theorem mp.view_usable_w(vm, fp, objs, a, n): a in omega ->
  (all i. i in omega -> int_lt(i, n) -> int_add(a, i) in fp && mallocng.m_mapped(mallocng.mview(vm, fp), int_add(a, i)) &&
     app(app(snd(mallocng.pg(mallocng.mview(vm, fp), int_add(a, i))), "prot"), "w") && !(app(snd(mallocng.pg(mallocng.mview(vm, fp), int_add(a, i))), "kind") = 2)) ->
  gimple.usable(vm, objs, a, n, true)
proof
  assume ha hf
  have g: all i. i in omega -> int_lt(i, n) -> ite(x86_64_linux.mapped(vm, int_div(int_add(a, i), x86_64_linux.PAGE)) && !(app(snd(app(app(vm, "pages"), int_div(int_add(a, i), x86_64_linux.PAGE))), "kind") = 2),
      ite(true, app(app(snd(app(app(vm, "pages"), int_div(int_add(a, i), x86_64_linux.PAGE))), "prot"), "w"), app(app(snd(app(app(vm, "pages"), int_div(int_add(a, i), x86_64_linux.PAGE))), "prot"), "r")),
      int_lt(int_add(a, i), int_pow(2, 64)) && int_add(a, i) in objs) proof
    fix i
    assume hi hl
    have f1 f2 f3 f4 := mp(all_elim(hf, {i}), hi, hl)
    have ai: int_add(a, i) in omega by arith(ha, hi)
    have pg: mallocng.pg(mallocng.mview(vm, fp), int_add(a, i)) = app(app(vm, "pages"), int_div(int_add(a, i), x86_64_linux.PAGE))
      by defs(simp(f1, ai), mallocng.pg, mallocng.mview, some)
    have m2 := expand(f2, mallocng.m_mapped)
    show by defs(simp(rewrite(pg, m2), rewrite(pg, f3), rewrite(pg, f4)), x86_64_linux.mapped)
  qed
  show by defs(g, gimple.usable)
qed

// a meta in use: in a meta area, its 40 bytes the allocator's, readable and
// writable, not the stack's
theorem mp.slot_mem(c, A, vm, b, g): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs ->
  mallocng.holds_in(c, A, vm, b) -> mallocng.meta_slot(A, g) ->
  g in omega && int_le(24, g) &&
  (all a. a in omega -> int_le(g, a) -> int_lt(a, int_add(g, 40)) ->
     a in mallocng.held(c, A, b) && mallocng.m_rw(mallocng.mview(vm, mallocng.held(c, A, b)), a) &&
     !(app(snd(mallocng.pg(mallocng.mview(vm, mallocng.held(c, A, b)), a)), "kind") = 2))
proof
  assume hc hu ha hh sl
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {aok = areas, huo = used, ff = fixed, hga = apart} := expand(H, mallocng.holds)
  obtain k2 j, hk2 hj hk2l hjl he from expand(sl, mallocng.meta_slot)
  have _ _ ar _ _ := expand(aok, mallocng.areas_ok)
  have a1 a2 _ _ _ a6 := mp(all_elim(ar, {k2}), hk2, hk2l)
  have ff1 _ _ := expand(ff, mallocng.fixed_free)
  have rl: app(A, "areas") in list_type(omega) by simp(ha)
  have aro := mp(at_type[l := app(A, "areas"), t := omega, i := k2], rl, hk2, hk2l)
  have cs: mallocng.AREA_HDR = 24 && mallocng.META_SIZE = 40 && mallocng.NSLOTS = 101 by defs(simp(), mallocng.AREA_HDR, mallocng.META_SIZE, mallocng.NSLOTS)
  have ge: g = int_add(int_add(app(app(A, "areas"), k2), 24), int_mul(40, j)) by simp(expand(he, mallocng.meta_at), cs)
  have go: g in omega by arith(ge, aro, hj)
  have g24: int_le(24, g) by arith(ge, aro, hj)
  have inr: all a. a in omega -> int_le(g, a) -> int_lt(a, int_add(g, 40)) ->
      a in mallocng.held(c, A, b) && mallocng.m_rw(mallocng.mview(vm, mallocng.held(c, A, b)), a) &&
      !(app(snd(mallocng.pg(mallocng.mview(vm, mallocng.held(c, A, b)), a)), "kind") = 2) proof
    fix a
    assume hao h1 h2
    have jl: int_lt(j, 101) by simp(hjl, cs)
    have r1: int_le(app(app(A, "areas"), k2), a) by arith(ge, h1, hj)
    have r2: int_lt(a, int_add(app(app(A, "areas"), k2), 4096)) by arith(ge, h2, hj, jl)
    have nl := mp(all_elim(ff1, {k2}, {a}), conj(hk2, hao), conj(conj(hk2l, r1), r2))
    have fp := apply(mp.area_fp, hc, hu, ha, huo, hga, hk2, hk2l, hao, r1, r2, nl)
    have hd := apply(mp.area_held, hc, hu, ha, H, hk2, hk2l, hao, r1, r2, fp)
    have rw := mp(all_elim(a6, {a}), hao, conj(r1, r2))
    show by taut(hd, rw)
  qed
  show by taut(go, g24, inr)
qed

// (a used group's meta: a meta slot)
theorem mp.used_slot(c, A, M, b, brk, g): mallocng.holds(c, A, M, b, brk) -> mallocng.is_used(A, g) -> mallocng.meta_slot(A, g)
proof
  assume H hg
  have {mpart = part} := expand(H, mallocng.holds)
  have {ms = used_slots} := expand(mpart, mallocng.metas_partition)
  obtain k, hk hkl hkg from expand(hg, mallocng.is_used)
  show := rewrite(hkg, mp(all_elim(ms, {k}), hk, hkl))
qed

theorem mp.meta_mem(c, A, vm, b, g): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs ->
  mallocng.holds_in(c, A, vm, b) -> mallocng.is_used(A, g) ->
  g in omega && int_le(24, g) &&
  (all a. a in omega -> int_le(g, a) -> int_lt(a, int_add(g, 40)) ->
     a in mallocng.held(c, A, b) && mallocng.m_rw(mallocng.mview(vm, mallocng.held(c, A, b)), a) &&
     !(app(snd(mallocng.pg(mallocng.mview(vm, mallocng.held(c, A, b)), a)), "kind") = 2))
proof
  assume hc hu ha hh hg
  have {H = inv} := expand(hh, mallocng.holds_in)
  show := apply(mp.slot_mem, hc, hu, ha, hh, apply(mp.used_slot, H, hg))
qed

// a meta in use: its word of last_idx, freeable, sizeclass and maplen as
// GIMPLE reads it (mallocng_specs.mword), the fields' packing
theorem mp.meta_word(c, A, vm, b, g): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs ->
  mallocng.holds_in(c, A, vm, b) -> mallocng.is_used(A, g) ->
  int_le(int_add(g, 40), int_pow(2, 64)) &&
  mallocng_specs.mword(vm, g) = int_add(int_add(int_add(app(app(app(A, "metas"), g), "last_idx"), int_mul(32, app(app(app(A, "metas"), g), "freeable"))),
    int_mul(64, app(app(app(A, "metas"), g), "sizeclass"))), int_mul(4096, app(app(app(A, "metas"), g), "maplen")))
proof
  assume hc hu ha hh hg
  let FP := mallocng.held(c, A, b)
  have go g24 inr := apply(mp.meta_mem, hc, hu, ha, hh, hg)
  // its last byte mapped: below the user space's end
  have l39 := mp(all_elim(inr, {int_add(g, 39)}), (int_add(g, 39) in omega by arith(go)), (int_le(g, int_add(g, 39)) by arith(go)), (int_lt(int_add(g, 39), int_add(g, 40)) by arith(go)))
  have _ rw39 _ := l39
  have mm: mallocng.m_mapped(mallocng.mview(vm, FP), int_add(g, 39)) by taut(expand(rw39, mallocng.m_rw))
  have mm2 := expand(mm, mallocng.m_mapped, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
  have tl: int_lt(int_div(int_add(g, 39), 4096), int_div(int_sub(int_pow(2, 47), 4096), 4096)) by taut(mm2)
  have top: int_le(int_add(g, 40), int_pow(2, 64)) by arith(tl, go)
  // the word read: the view's
  have ba: bits_add(64, g, 32) = int_add(g, 32) by defs(arith(go, top), bits_add, pow2)
  have infp: all i. i in omega -> int_lt(i, 8) -> int_add(int_add(g, 32), i) in FP proof
    fix i
    assume hi hl
    have r := mp(all_elim(inr, {int_add(int_add(g, 32), i)}), (int_add(int_add(g, 32), i) in omega by arith(go, hi)), (int_le(g, int_add(int_add(g, 32), i)) by arith(go, hi)), (int_lt(int_add(int_add(g, 32), i), int_add(g, 40)) by arith(go, hi, hl)))
    show by taut(r)
  qed
  have vr := apply(mp.view_read[vm := vm, fp := FP, a := int_add(g, 32), n := 8], (int_add(g, 32) in omega by arith(go)), simp(), simp(), infp)
  // the invariant's: meta_in_memory
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {uo = used} := expand(H, mallocng.holds)
  have gok := apply(mp.used_group, uo, hg)
  have mim .. := expand(gok, mallocng.group_ok)
  have _ _ _ _ _ w5 _ _ _ := expand(mim, mallocng.meta_in_memory)
  show by defs(taut(top, rewrite(sym(ba), trans(vr, w5))), mallocng_specs.mword)
qed

// the class table as GIMPLE reads it: the size classes
theorem mp.classes_table(c, A, vm, b, objs): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs ->
  mallocng.holds_in(c, A, vm, b) -> mallocng_specs.table_ok(vm, objs, app(c, "sct"), 2, mallocng.size_classes)
proof
  assume hc hu ha hh
  let FP := mallocng.held(c, A, b)
  let M := mallocng.mview(vm, FP)
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {huo = used, co = classes, ff = fixed, hga = apart} := expand(H, mallocng.holds)
  have co1 co2 co3 := expand(co, mallocng.classes_ok)
  have _ ff2 _ := expand(ff, mallocng.fixed_free)
  have so: app(c, "sct") in omega by simp(hc)
  obtain ri, hri hril hr1 hr2 from co3
  // a byte of the table: the allocator's, readable, in a read-only segment
  have byte: all a. a in omega -> int_le(app(c, "sct"), a) -> int_lt(a, int_add(app(c, "sct"), int_mul(2, 48))) ->
      a in FP && mallocng.m_mapped(M, a) && app(app(snd(mallocng.pg(M, a)), "prot"), "r") && !(app(snd(mallocng.pg(M, a)), "kind") = 2) proof
    fix a
    assume hao h1 h2
    have nl := mp(all_elim(ff2, {a}), hao, conj(h1, h2))
    have fp := apply(mp.sct_fp, hc, hu, ha, huo, hga, hao, h1, h2, nl)
    have inr: mallocng.in_range(a, app(mallocng.ro_ranges(app(c, "file")), ri)) by defs(arith(hr1, hr2, h1, h2), mallocng.in_range)
    have hd := apply(mp.ro_held[c := c, A := A, M := M, b := b, brk := app(vm, "brk"), i := ri, a := a], hc, hu, ha, H, hri, hril, inr, fp)
    have rd := mp(all_elim(co2, {a}), hao, conj(h1, h2))
    show by taut(hd, rd)
  qed
  have tab: all i. i in omega -> int_lt(i, seq_len(mallocng.size_classes)) ->
      gimple.usable(vm, objs, int_add(app(c, "sct"), int_mul(2, i)), 2, false) &&
      gimple.bytes_at(vm, bits_of_int(64, int_add(app(c, "sct"), int_mul(2, i))), 2) = app(mallocng.size_classes, i) proof
    fix i
    assume hi hl
    have i48: int_lt(i, 48) by simp(hl, ms.sc_len)
    let T := int_add(app(c, "sct"), int_mul(2, i))
    have to: T in omega by arith(so, hi)
    have bj: all j. j in omega -> int_lt(j, 2) -> int_add(T, j) in FP && mallocng.m_mapped(M, int_add(T, j)) &&
        app(app(snd(mallocng.pg(M, int_add(T, j))), "prot"), "r") && !(app(snd(mallocng.pg(M, int_add(T, j))), "kind") = 2) proof
      fix j
      assume hj hjl
      show := mp(all_elim(byte, {int_add(T, j)}), (int_add(T, j) in omega by arith(to, hj)), (int_le(app(c, "sct"), int_add(T, j)) by arith(so, hi, hj)),
        (int_lt(int_add(T, j), int_add(app(c, "sct"), int_mul(2, 48))) by arith(so, hi, hj, i48, hjl)))
    qed
    have us := apply(mp.view_usable[vm := vm, fp := FP, objs := objs, a := T, n := 2], to, bj)
    have infp: all j. j in omega -> int_lt(j, 2) -> int_add(T, j) in FP proof
      fix j
      assume hj hjl
      have r := mp(all_elim(bj, {j}), hj, hjl)
      show by taut(r)
    qed
    have vr := apply(mp.view_read[vm := vm, fp := FP, a := T, n := 2], to, simp(), simp(), infp)
    // below the user space's end
    have _ m0 _ _ := mp(all_elim(bj, {0}), simp(), simp())
    have mm2 := expand(m0, mallocng.m_mapped, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
    have tl: int_lt(int_div(int_add(T, 0), 4096), int_div(int_sub(int_pow(2, 47), 4096), 4096)) by taut(mm2)
    have bt: bits_of_int(64, T) = T by defs(arith(tl, to), bits_of_int, pow2)
    have cv := mp(all_elim(co1, {i}), hi, i48)
    show by taut(us, rewrite(sym(bt), trans(vr, cv)))
  qed
  show by defs(tab, mallocng_specs.table_ok)
qed

// ----------------------------------------------------------------------
//  What starts in a slot: its header (the invariant read)
// what starts at p in slot i of the group g: in the slot, its header's
// byte at p - 3 the slot's index, the header no client's
theorem mp.slot_frame(A, M, b, g, i, p): A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) -> g in omega -> i in omega -> p in omega ->
  mallocng.used_ok(A, M, b) -> mallocng.group_ok(A, M, b, g) -> mallocng.starts_at(A, g, i, p) ->
  int_le(mallocng.slot_start(app(app(A, "metas"), g), i), p) && int_le(p, mallocng.slot_end(app(app(A, "metas"), g), i)) &&
  int_mod(mallocng.b8(M, int_sub(p, 3)), 32) = i && mallocng.hdr_free(b, p) &&
  int_mod(int_sub(p, mallocng.slot_start(app(app(A, "metas"), g), i)), mallocng.UNIT) = 0 && mallocng.b8(M, int_sub(p, 4)) = 0 &&
  mallocng.rd(M, int_sub(p, 2), 2) = int_div(int_sub(p, mallocng.storage(app(app(A, "metas"), g))), mallocng.UNIT) &&
  (int_lt(app(app(app(A, "metas"), g), "sizeclass"), 48) -> int_lt(int_sub(p, mallocng.storage(app(app(A, "metas"), g))),
     int_mul(int_mul(mallocng.UNIT, app(mallocng.size_classes, app(app(app(A, "metas"), g), "sizeclass"))), int_add(i, 1))))
proof
  assume ha hb hg hi hp uo gok hs
  let V := app(app(A, "metas"), g)
  have iu il sl := expand(hs, mallocng.starts_at)
  have {gso = slots} := expand(gok, mallocng.group_ok)
  have so := mp(all_elim(gso, {i}), hi, il)
  // a client block at p
  have cb: app(app(app(A, "slots"), g), i) = tag(1, p) -> int_le(mallocng.slot_start(V, i), p) && int_le(p, mallocng.slot_end(V, i)) &&
      int_mod(mallocng.b8(M, int_sub(p, 3)), 32) = i && mallocng.hdr_free(b, p) &&
      int_mod(int_sub(p, mallocng.slot_start(V, i)), mallocng.UNIT) = 0 && mallocng.b8(M, int_sub(p, 4)) = 0 &&
      mallocng.rd(M, int_sub(p, 2), 2) = int_div(int_sub(p, mallocng.storage(V)), mallocng.UNIT) &&
      (int_lt(app(V, "sizeclass"), 48) -> int_lt(int_sub(p, mallocng.storage(V)), int_mul(int_mul(mallocng.UNIT, app(mallocng.size_classes, app(V, "sizeclass"))), int_add(i, 1)))) proof
    assume e
    have s1: !(app(b, bits_of_int(64, p)) = none) && mallocng.hdr_free(b, p) && mallocng.frame_ok(M, V, i, p, snd(app(b, bits_of_int(64, p))), 0)
      by simp(expand(rewrite(e, so), mallocng.slot_ok))
    have bt := mp(fn_space_app[a := bits(64), b := option(omega), f := b, x := bits_of_int(64, p)], hb, simp())
    have no: !(app(b, bits_of_int(64, p)) = none) by taut(s1)
    have nn := apply(some_val, bt, no)
    have fo: mallocng.frame_ok(M, V, i, p, snd(app(b, bits_of_int(64, p))), 0) by taut(s1)
    have f1 f2 f3 f4 f5 f6 _ _ _ f10 := expand(fo, mallocng.frame_ok)
    have up: int_le(p, mallocng.slot_end(V, i)) by arith(f3, nn, hp)
    show by taut(f1, up, f5, s1, f2, f4, f6, f10)
  qed
  // a nested group at p
  have cn: (ex h. h in omega && (app(app(app(A, "slots"), g), i) = tag(2, h) && app(app(app(A, "metas"), h), "mem") = p)) ->
      int_le(mallocng.slot_start(V, i), p) && int_le(p, mallocng.slot_end(V, i)) &&
      int_mod(mallocng.b8(M, int_sub(p, 3)), 32) = i && mallocng.hdr_free(b, p) &&
      int_mod(int_sub(p, mallocng.slot_start(V, i)), mallocng.UNIT) = 0 && mallocng.b8(M, int_sub(p, 4)) = 0 &&
      mallocng.rd(M, int_sub(p, 2), 2) = int_div(int_sub(p, mallocng.storage(V)), mallocng.UNIT) &&
      (int_lt(app(V, "sizeclass"), 48) -> int_lt(int_sub(p, mallocng.storage(V)), int_mul(int_mul(mallocng.UNIT, app(mallocng.size_classes, app(V, "sizeclass"))), int_add(i, 1)))) proof
    assume e
    obtain h, hh he2 from e
    have he hm := he2
    let W := app(app(A, "metas"), h)
    have s1: mallocng.is_used(A, h) && mallocng.hdr_free(b, app(W, "mem")) &&
        mallocng.frame_ok(M, V, i, app(W, "mem"), int_sub(int_add(mallocng.UNIT, int_mul(mallocng.stride(W), int_add(app(W, "last_idx"), 1))), mallocng.IB), 6)
      by simp(expand(rewrite(he, so), mallocng.slot_ok))
    have hu: mallocng.is_used(A, h) by taut(s1)
    obtain k, hk hkl hkh from expand(hu, mallocng.is_used)
    have gh := rewrite(hkh, mp(all_elim(expand(uo, mallocng.used_ok), {k}), hk, hkl))
    have wn := apply(mp.stride_nat, ha, hh, gh)
    have wt: W in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := app(A, "metas"), x := h], simp(ha), hh)
    have wl: app(W, "last_idx") in omega by simp(wt)
    have pos := mp(all_elim(ms.mul_le, {0}, {0}, {mallocng.stride(W)}, {int_add(app(W, "last_idx"), 1)}), simp(), simp(), simp(wn), simp(wl), arith(wn), arith(wl))
    have fo: mallocng.frame_ok(M, V, i, app(W, "mem"), int_sub(int_add(mallocng.UNIT, int_mul(mallocng.stride(W), int_add(app(W, "last_idx"), 1))), mallocng.IB), 6) by taut(s1)
    have f1 f2 f3 f4 f5 f6 _ _ _ f10 := expand(rewrite(hm, fo), mallocng.frame_ok)
    have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
    have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
    have up: int_le(p, mallocng.slot_end(V, i)) by arith(f3, pos, hp, cu, ci)
    have hw: mallocng.hdr_free(b, app(W, "mem")) by taut(s1)
    have hf: mallocng.hdr_free(b, p) := rewrite(hm, hw)
    show by taut(f1, up, f5, hf, f2, f4, f6, f10)
  qed
  show by taut(sl, cb, cn)
qed

// no slot reserved: no byte in one
theorem mp.nores(A, a): mallocng.no_reserved(A) -> !mallocng.in_reserved(A, a)
proof
  assume hn
  have k: mallocng.in_reserved(A, a) -> false proof
    assume h
    obtain g i, hg hi _ hil hrs _ from expand(h, mallocng.in_reserved)
    have ne := mp(all_elim(expand(hn, mallocng.no_reserved), {g}, {i}), conj(hg, hi), hil)
    show by taut(ne, hrs)
  qed
  show by taut(k)
qed

// slot i of g the only one reserved: a byte outside its interior in none
theorem mp.ronly_out(A, g, i, a): mallocng.reserved_only(A, g, i) -> !mallocng.in_slot(app(app(A, "metas"), g), i, a) -> !mallocng.in_reserved(A, a)
proof
  assume hr hn
  have _ _ ro := expand(hr, mallocng.reserved_only)
  have k: mallocng.in_reserved(A, a) -> false proof
    assume h
    obtain g2 i2, hg hi _ hil hrs his from expand(h, mallocng.in_reserved)
    have eg ei := mp(all_elim(ro, {g2}, {i2}), conj(hg, hi), conj(hil, hrs))
    have hs2: mallocng.in_slot(app(app(A, "metas"), g), i, a) := rewrite(ei, rewrite(eg, his))
    show by taut(hs2, hn)
  qed
  show by taut(k)
qed

// a reserved slot's interior: not the allocator's
theorem mp.int_nfp(c, A, b, g, i, a): g in omega -> i in omega -> mallocng.is_used(A, g) -> mallocng.reserved_only(A, g, i) ->
  mallocng.in_slot(app(app(A, "metas"), g), i, a) -> !(a in mallocng.footprint(c, A, b))
proof
  assume hg hi hu hr hs
  have il rs _ := expand(hr, mallocng.reserved_only)
  have ir: mallocng.in_reserved(A, a) by defs(ex_intro({g}, {i}, taut(hg, hi, hu, il, rs, hs)), mallocng.in_reserved)
  have k: a in mallocng.footprint(c, A, b) -> false proof
    assume h
    have u := unsel(expand(h, mallocng.footprint))
    show by taut(u, ir)
  qed
  show by taut(k)
qed

// slot j's check byte (j past the last: the group's end byte), in no
// reserved slot: the allocator's, and 0
theorem mp.chk_fp(c, A, vm, b, g, j): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> j in omega ->
  mallocng.holds_in(c, A, vm, b) -> mallocng.is_used(A, g) -> int_le(j, int_add(app(app(app(A, "metas"), g), "last_idx"), 1)) ->
  !mallocng.in_reserved(A, int_sub(mallocng.slot_start(app(app(A, "metas"), g), j), mallocng.IB)) ->
  int_sub(mallocng.slot_start(app(app(A, "metas"), g), j), mallocng.IB) in mallocng.held(c, A, b) &&
  mallocng.b8(mallocng.mview(vm, mallocng.held(c, A, b)), int_sub(mallocng.slot_start(app(app(A, "metas"), g), j), mallocng.IB)) = 0
proof
  assume hc hu ha hj hh hg hjl hnr
  let V := app(app(A, "metas"), g)
  let X := int_sub(mallocng.slot_start(V, j), mallocng.IB)
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {uo = used} := expand(H, mallocng.holds)
  obtain k, hk hkl hkg from expand(hg, mallocng.is_used)
  have go: g in omega := rewrite(hkg, mp(at_type[l := app(A, "used"), t := omega, i := k], simp(ha), hk, hkl))
  have gok := apply(mp.used_group, uo, hg)
  have {mim, masks, gmp = mapped, sent = sentinel, chk = chk_own} := expand(gok, mallocng.group_ok)
  have vt: V in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := app(A, "metas"), x := g], simp(ha), go)
  have vo: app(V, "mem") in omega && app(V, "maplen") in omega && app(V, "last_idx") in omega by simp(vt)
  have vme vml vli := vo
  have sn := apply(mp.stride_nat, ha, go, gok)
  have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
  have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
  have ss: mallocng.slot_start(V, j) = int_add(int_add(app(V, "mem"), 16), int_mul(mallocng.stride(V), j)) by defs(arith(cu), mallocng.slot_start, mallocng.storage)
  have m0: int_mul(mallocng.stride(V), j) in omega by simp(sn, hj)
  have mle := mp(all_elim(ms.mul_le, {mallocng.stride(V)}, {j}, {mallocng.stride(V)}, {int_add(app(V, "last_idx"), 1)}), sn, hj, simp(sn), simp(vo), arith(sn), hjl)
  have xo: X in omega by arith(ss, ci, vme, m0)
  // in the group's bytes
  have ir: mallocng.in_range(X, mallocng.group_range(V)) proof
    have c1: int_lt(0, app(V, "maplen")) -> mallocng.in_range(X, mallocng.group_range(V)) proof
      assume h
      have _ mm := mp(gmp, h)
      have e := mp(ite_t[c := int_lt(0, app(V, "maplen")), a := pair(app(V, "mem"), int_mul(app(V, "maplen"), 4096)), b := pair(app(V, "mem"), int_add(int_sub(int_add(mallocng.UNIT, int_mul(mallocng.stride(V), int_add(app(V, "last_idx"), 1))), mallocng.IB), 1))], h)
      have r: int_le(app(V, "mem"), X) && int_lt(X, int_add(app(V, "mem"), int_mul(app(V, "maplen"), 4096))) by arith(ss, ci, cu, m0, mle, mm, vme, vli)
      show by defs(simp(e, r), mallocng.in_range, mallocng.group_range)
    qed
    have c2: !int_lt(0, app(V, "maplen")) -> mallocng.in_range(X, mallocng.group_range(V)) proof
      assume h
      have e := mp(ite_f[c := int_lt(0, app(V, "maplen")), a := pair(app(V, "mem"), int_mul(app(V, "maplen"), 4096)), b := pair(app(V, "mem"), int_add(int_sub(int_add(mallocng.UNIT, int_mul(mallocng.stride(V), int_add(app(V, "last_idx"), 1))), mallocng.IB), 1))], h)
      have r: int_le(app(V, "mem"), X) && int_lt(X, int_add(app(V, "mem"), int_add(int_sub(int_add(mallocng.UNIT, int_mul(mallocng.stride(V), int_add(app(V, "last_idx"), 1))), mallocng.IB), 1))) by arith(ss, ci, cu, m0, mle, vme, vli)
      show by defs(simp(e, r), mallocng.in_range, mallocng.group_range)
    qed
    show by taut(c1, c2)
  qed
  have nl := mp(all_elim(chk, {j}), hj, hjl)
  have irk := subst({y. mallocng.in_range(X, mallocng.group_range(app(app(A, "metas"), y)))}, sym(hkg), ir)
  have fp0 := apply(mp.group_fp, hc, hu, ha, hk, hkl, xo, irk, nl, hnr)
  have fp := apply(mp.group_held[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, brk := app(vm, "brk"), h := g, a := X], hc, hu, ha, H, hg, xo, ir, fp0)
  // 0: the check byte (masks), or the group's end byte (sentinel)
  have lt32: int_lt(app(V, "last_idx"), 32) by simp(expand(mim, mallocng.meta_in_memory))
  have v0: int_le(j, app(V, "last_idx")) -> mallocng.b8(mallocng.mview(vm, mallocng.held(c, A, b)), X) = 0 proof
    assume h
    have _ _ m3 _ := mp(all_elim(masks, {j}), hj, (int_lt(j, 32) by arith(h, lt32)))
    have _ z := mp(m3, h)
    show z
  qed
  have v1: j = int_add(app(V, "last_idx"), 1) -> mallocng.b8(mallocng.mview(vm, mallocng.held(c, A, b)), X) = 0 proof
    assume h
    have d: int_mul(mallocng.stride(V), int_add(app(V, "last_idx"), 1)) = int_add(int_mul(mallocng.stride(V), app(V, "last_idx")), mallocng.stride(V)) by simp(sn, vli)
    have d2: int_mul(mallocng.stride(V), j) = int_add(int_mul(mallocng.stride(V), app(V, "last_idx")), mallocng.stride(V)) :=
      trans(subst({y. int_mul(mallocng.stride(V), j) = int_mul(mallocng.stride(V), y)}, h, refl({int_mul(mallocng.stride(V), j)})), d)
    have se: mallocng.slot_end(V, app(V, "last_idx")) = X by defs(arith(ss, d2, sn, vme, vli, cu, ci), mallocng.slot_end, mallocng.slot_start, mallocng.storage)
    show := rewrite(se, sent)
  qed
  show by taut(fp, v0, v1, (int_le(j, app(V, "last_idx")) || j = int_add(app(V, "last_idx"), 1) by arith(hjl, hj, vli)))
qed

// the header byte at p - 3 of what starts in a slot (a client block, a
// nested group): the allocator's, readable and writable (not a stack
// page), the slot's index in its low 5 bits (no slot reserved)
theorem mp.slot_hdr(c, A, vm, b, g, i, p): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  i in omega -> p in omega -> mallocng.holds_in(c, A, vm, b) -> mallocng.no_reserved(A) -> mallocng.starts_at(A, g, i, p) ->
  int_le(16, p) && int_sub(p, 3) in mallocng.held(c, A, b) &&
  int_mod(mallocng.b8(mallocng.mview(vm, mallocng.held(c, A, b)), int_sub(p, 3)), 32) = i &&
  mallocng.m_rw(mallocng.mview(vm, mallocng.held(c, A, b)), int_sub(p, 3)) &&
  !(app(snd(mallocng.pg(mallocng.mview(vm, mallocng.held(c, A, b)), int_sub(p, 3))), "kind") = 2)
proof
  assume hc hu ha hb hi hp hh hnr hs
  let FP := mallocng.held(c, A, b)
  let M := mallocng.mview(vm, FP)
  let V := app(app(A, "metas"), g)
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {uo = used, po = perms} := expand(H, mallocng.holds)
  have iu il _ := expand(hs, mallocng.starts_at)
  obtain k, hk hkl hkg from expand(iu, mallocng.is_used)
  have go: g in omega := rewrite(hkg, mp(at_type[l := app(A, "used"), t := omega, i := k], simp(ha), hk, hkl))
  have gok := rewrite(hkg, mp(all_elim(expand(uo, mallocng.used_ok), {k}), hk, hkl))
  have s1 s2 s3 s4 .. := apply(mp.slot_frame, ha, hb, go, hi, hp, uo, gok, hs)
  have vt: V in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := app(A, "metas"), x := g], simp(ha), go)
  have vmem: app(V, "mem") in omega by simp(vt)
  have vmap: app(V, "maplen") in omega by simp(vt)
  have vlast: app(V, "last_idx") in omega by simp(vt)
  have sn := apply(mp.stride_nat, ha, go, gok)
  have {gl = nslots, gmp = mapped} := expand(gok, mallocng.group_ok)
  have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
  have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
  // the slot within its group: its start past the header, its end before the group's
  have m0 := mp(all_elim(ms.mul_le, {0}, {0}, {mallocng.stride(V)}, {i}), simp(), simp(), simp(sn), simp(hi), arith(sn), arith(hi))
  have ile: int_le(int_add(i, 1), int_add(app(V, "last_idx"), 1)) by arith(gl, il, hi, vlast)
  have m1 := mp(all_elim(ms.mul_le, {mallocng.stride(V)}, {int_add(i, 1)}, {mallocng.stride(V)}, {int_add(app(V, "last_idx"), 1)}), sn, simp(hi), simp(sn), simp(vlast), arith(sn), ile)
  have ss: mallocng.slot_start(V, i) = int_add(int_add(app(V, "mem"), 16), int_mul(mallocng.stride(V), i)) by defs(arith(cu), mallocng.slot_start, mallocng.storage)
  have se: mallocng.slot_end(V, i) = int_sub(int_add(mallocng.slot_start(V, i), mallocng.stride(V)), 4) by defs(arith(ci), mallocng.slot_end)
  have dist: int_mul(mallocng.stride(V), int_add(i, 1)) = int_add(int_mul(mallocng.stride(V), i), mallocng.stride(V)) by arith(sn, hi)
  have lo: int_le(int_add(app(V, "mem"), 16), p) by arith(s1, ss, m0)
  have hi16: int_le(16, p) by arith(lo, vmem)
  have top: int_le(p, int_add(int_add(app(V, "mem"), 12), int_mul(mallocng.stride(V), int_add(i, 1)))) by arith(s2, se, ss, dist)
  have ir: mallocng.in_range(int_sub(p, 3), mallocng.group_range(V)) proof
    have c1: int_lt(0, app(V, "maplen")) -> mallocng.in_range(int_sub(p, 3), mallocng.group_range(V)) proof
      assume h
      have g2 := mp(gmp, h)
      have mm: int_le(int_add(mallocng.UNIT, int_mul(mallocng.stride(V), int_add(app(V, "last_idx"), 1))), int_mul(app(V, "maplen"), 4096)) by taut(g2)
      have e := mp(ite_t[c := int_lt(0, app(V, "maplen")), a := pair(app(V, "mem"), int_mul(app(V, "maplen"), 4096)), b := pair(app(V, "mem"), int_add(int_sub(int_add(mallocng.UNIT, int_mul(mallocng.stride(V), int_add(app(V, "last_idx"), 1))), mallocng.IB), 1))], h)
      have r: int_le(app(V, "mem"), int_sub(p, 3)) && int_lt(int_sub(p, 3), int_add(app(V, "mem"), int_mul(app(V, "maplen"), 4096))) by arith(lo, top, m1, mm, cu)
      show by defs(simp(e, r), mallocng.in_range, mallocng.group_range)
    qed
    have c2: !int_lt(0, app(V, "maplen")) -> mallocng.in_range(int_sub(p, 3), mallocng.group_range(V)) proof
      assume h
      have e := mp(ite_f[c := int_lt(0, app(V, "maplen")), a := pair(app(V, "mem"), int_mul(app(V, "maplen"), 4096)), b := pair(app(V, "mem"), int_add(int_sub(int_add(mallocng.UNIT, int_mul(mallocng.stride(V), int_add(app(V, "last_idx"), 1))), mallocng.IB), 1))], h)
      have r: int_le(app(V, "mem"), int_sub(p, 3)) && int_lt(int_sub(p, 3), int_add(app(V, "mem"), int_add(int_sub(int_add(mallocng.UNIT, int_mul(mallocng.stride(V), int_add(app(V, "last_idx"), 1))), mallocng.IB), 1))) by arith(lo, top, m1, cu, ci)
      show by defs(simp(e, r), mallocng.in_range, mallocng.group_range)
    qed
    show by taut(c1, c2)
  qed
  // the header no client's: the allocator's byte
  have p3: int_sub(p, 3) in omega by arith(hi16, hp)
  have nl := mp(all_elim(expand(s4, mallocng.hdr_free), {int_sub(p, 3)}), p3, (int_le(int_sub(p, mallocng.IB), int_sub(p, 3)) && int_lt(int_sub(p, 3), p) by arith(ci, hi16)))
  have irk := rewrite(sym(hkg), ir)
  have nr := apply(mp.nores[A := A, a := int_sub(p, 3)], hnr)
  have fp0 := apply(mp.group_fp, hc, hu, ha, hk, hkl, p3, irk, nl, nr)
  have fp := apply(mp.group_held[c := c, A := A, M := M, b := b, brk := app(vm, "brk"), h := g, a := int_sub(p, 3)], hc, hu, ha, H, iu, p3, ir, fp0)
  // accessible as the code does
  have _ pg2 _ := expand(po, mallocng.perms_ok)
  have rr: (int_lt(k, seq_len(app(A, "used"))) && int_le(fst(mallocng.group_range(app(app(A, "metas"), app(app(A, "used"), k)))), int_sub(p, 3))) &&
      int_lt(int_sub(p, 3), int_add(fst(mallocng.group_range(app(app(A, "metas"), app(app(A, "used"), k)))), snd(mallocng.group_range(app(app(A, "metas"), app(app(A, "used"), k)))))) by taut(hkl, expand(irk, mallocng.in_range))
  have acc := mp(all_elim(pg2, {k}, {int_sub(p, 3)}), conj(hk, p3), conj(conj(rr, nl), nr))
  show by taut(hi16, fp, s3, acc)
qed

// a meta's area (its page): the allocator's, accessible, its first word the
// secret
theorem mp.meta_area(c, A, vm, b, g): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs ->
  mallocng.holds_in(c, A, vm, b) -> mallocng.is_used(A, g) ->
  int_lt(0, int_mul(int_div(g, 4096), 4096)) &&
  (all a. a in omega -> int_le(int_mul(int_div(g, 4096), 4096), a) -> int_lt(a, int_add(int_mul(int_div(g, 4096), 4096), 4096)) ->
     a in mallocng.held(c, A, b) && mallocng.m_rw(mallocng.mview(vm, mallocng.held(c, A, b)), a) &&
     !(app(snd(mallocng.pg(mallocng.mview(vm, mallocng.held(c, A, b)), a)), "kind") = 2)) &&
  mallocng.rd(mallocng.mview(vm, mallocng.held(c, A, b)), int_mul(int_div(g, 4096), 4096), 8) = app(A, "secret")
proof
  assume hc hu ha hh hg
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {aok = areas, mpart = part, huo = used, ff = fixed, hga = apart} := expand(H, mallocng.holds)
  obtain k, hk hkl hkg from expand(hg, mallocng.is_used)
  have _ ms _ _ _ := expand(mpart, mallocng.metas_partition)
  have sl := rewrite(hkg, mp(all_elim(ms, {k}), hk, hkl))
  obtain k2 j, hk2 hj hk2l hjl he from expand(sl, mallocng.meta_slot)
  have _ _ ar _ _ := expand(aok, mallocng.areas_ok)
  have a1 a2 a3 _ _ a6 := mp(all_elim(ar, {k2}), hk2, hk2l)
  have ff1 _ _ := expand(ff, mallocng.fixed_free)
  have rl: app(A, "areas") in list_type(omega) by simp(ha)
  have aro := mp(at_type[l := app(A, "areas"), t := omega, i := k2], rl, hk2, hk2l)
  have cs: mallocng.AREA_HDR = 24 && mallocng.META_SIZE = 40 && mallocng.NSLOTS = 101 by defs(simp(), mallocng.AREA_HDR, mallocng.META_SIZE, mallocng.NSLOTS)
  have ge: g = int_add(int_add(app(app(A, "areas"), k2), 24), int_mul(40, j)) by simp(expand(he, mallocng.meta_at), cs)
  have jl: int_lt(j, 101) by simp(hjl, cs)
  // the page of g: its area
  have ea: int_mul(int_div(g, 4096), 4096) = app(app(A, "areas"), k2) by arith(ge, aro, hj, jl, a1)
  have inr: all a. a in omega -> int_le(int_mul(int_div(g, 4096), 4096), a) -> int_lt(a, int_add(int_mul(int_div(g, 4096), 4096), 4096)) ->
      a in mallocng.held(c, A, b) && mallocng.m_rw(mallocng.mview(vm, mallocng.held(c, A, b)), a) &&
      !(app(snd(mallocng.pg(mallocng.mview(vm, mallocng.held(c, A, b)), a)), "kind") = 2) proof
    fix a
    assume hao h1 h2
    have r1: int_le(app(app(A, "areas"), k2), a) := rewrite(ea, h1)
    have r2: int_lt(a, int_add(app(app(A, "areas"), k2), 4096)) := rewrite(ea, h2)
    have nl := mp(all_elim(ff1, {k2}, {a}), conj(hk2, hao), conj(conj(hk2l, r1), r2))
    have fp := apply(mp.area_fp, hc, hu, ha, huo, hga, hk2, hk2l, hao, r1, r2, nl)
    have hd := apply(mp.area_held, hc, hu, ha, H, hk2, hk2l, hao, r1, r2, fp)
    have rw := mp(all_elim(a6, {a}), hao, conj(r1, r2))
    show by taut(hd, rw)
  qed
  show by taut(rewrite(sym(ea), a2), inr, rewrite(sym(ea), a3))
qed

// the context's first word: the allocator's, accessible, the secret
theorem mp.ctx_secret(c, A, vm, b): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_in(c, A, vm, b) ->
  (all a. a in omega -> int_le(app(c, "ctx"), a) -> int_lt(a, int_add(app(c, "ctx"), 8)) ->
     a in mallocng.held(c, A, b) && mallocng.m_rw(mallocng.mview(vm, mallocng.held(c, A, b)), a) &&
     !(app(snd(mallocng.pg(mallocng.mview(vm, mallocng.held(c, A, b)), a)), "kind") = 2)) &&
  mallocng.rd(mallocng.mview(vm, mallocng.held(c, A, b)), app(c, "ctx"), 8) = app(A, "secret")
proof
  assume hc hu ha hh
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {cok = ctx} := expand(H, mallocng.holds)
  have cx: app(c, "ctx") in omega by simp(hc)
  have csz: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  have inr: all a. a in omega -> int_le(app(c, "ctx"), a) -> int_lt(a, int_add(app(c, "ctx"), 8)) ->
      a in mallocng.held(c, A, b) && mallocng.m_rw(mallocng.mview(vm, mallocng.held(c, A, b)), a) &&
      !(app(snd(mallocng.pg(mallocng.mview(vm, mallocng.held(c, A, b)), a)), "kind") = 2) proof
    fix a
    assume hao h1 h2
    have h2b: int_lt(a, int_add(app(c, "ctx"), mallocng.CTX_SIZE)) by arith(h2, csz)
    have nf: !mallocng.ctx_free(c, a) by defs(arith(h2), mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_META_SHIFT, mallocng.C_USAGE, mallocng.C_BRK)
    show := apply(mp.ctx_acc[c := c, A := A, vm := vm, b := b, a := a], hc, hu, ha, hh, hao, h1, h2b, nf)
  qed
  have c1 .. := expand(cok, mallocng.ctx_ok)
  have cs: mallocng.C_SECRET = 0 by defs(refl({0}), mallocng.C_SECRET)
  have sec: mallocng.rd(mallocng.mview(vm, mallocng.held(c, A, b)), app(c, "ctx"), 8) = app(A, "secret") by simp(expand(c1, mallocng.ctx_word), cs, cx)
  show by taut(inr, sec)
qed

// the group's bytes from its start up to what starts at p in one of its
// slots (its header, the slots before, p's in-band header): within the
// group; the allocator's and accessible, those no client's (no slot
// reserved)
theorem mp.below_p(c, A, vm, b, g, i, p): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  i in omega -> p in omega -> mallocng.holds_in(c, A, vm, b) -> mallocng.no_reserved(A) -> mallocng.starts_at(A, g, i, p) ->
  all a. a in omega -> int_le(app(app(app(A, "metas"), g), "mem"), a) -> int_lt(a, p) -> !(a in malloc.live_of(b)) ->
    a in mallocng.held(c, A, b) && mallocng.m_rw(mallocng.mview(vm, mallocng.held(c, A, b)), a) &&
    !(app(snd(mallocng.pg(mallocng.mview(vm, mallocng.held(c, A, b)), a)), "kind") = 2)
proof
  assume hc hu ha hb hi hp hh hnr hs
  let V := app(app(A, "metas"), g)
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {uo = used, po = perms} := expand(H, mallocng.holds)
  have iu il _ := expand(hs, mallocng.starts_at)
  obtain k, hk hkl hkg from expand(iu, mallocng.is_used)
  have go: g in omega := rewrite(hkg, mp(at_type[l := app(A, "used"), t := omega, i := k], simp(ha), hk, hkl))
  have gok := rewrite(hkg, mp(all_elim(expand(uo, mallocng.used_ok), {k}), hk, hkl))
  have s1 s2 .. := apply(mp.slot_frame, ha, hb, go, hi, hp, uo, gok, hs)
  have vt: V in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := app(A, "metas"), x := g], simp(ha), go)
  have vmem: app(V, "mem") in omega by simp(vt)
  have vlast: app(V, "last_idx") in omega by simp(vt)
  have sn := apply(mp.stride_nat, ha, go, gok)
  have {gl = nslots, gmp = mapped} := expand(gok, mallocng.group_ok)
  have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
  have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
  have ile: int_le(int_add(i, 1), int_add(app(V, "last_idx"), 1)) by arith(gl, il, hi, vlast)
  have m1 := mp(all_elim(ms.mul_le, {mallocng.stride(V)}, {int_add(i, 1)}, {mallocng.stride(V)}, {int_add(app(V, "last_idx"), 1)}), sn, simp(hi), simp(sn), simp(vlast), arith(sn), ile)
  have ss: mallocng.slot_start(V, i) = int_add(int_add(app(V, "mem"), 16), int_mul(mallocng.stride(V), i)) by defs(arith(cu), mallocng.slot_start, mallocng.storage)
  have se: mallocng.slot_end(V, i) = int_sub(int_add(mallocng.slot_start(V, i), mallocng.stride(V)), 4) by defs(arith(ci), mallocng.slot_end)
  have dist: int_mul(mallocng.stride(V), int_add(i, 1)) = int_add(int_mul(mallocng.stride(V), i), mallocng.stride(V)) by arith(sn, hi)
  have top: int_le(p, int_add(int_add(app(V, "mem"), 12), int_mul(mallocng.stride(V), int_add(i, 1)))) by arith(s2, se, ss, dist)
  have _ pg2 _ := expand(po, mallocng.perms_ok)
  fix a
  assume hao h1 h2 nl
  have ir: mallocng.in_range(a, mallocng.group_range(V)) proof
    have c1: int_lt(0, app(V, "maplen")) -> mallocng.in_range(a, mallocng.group_range(V)) proof
      assume h
      have g2 := mp(gmp, h)
      have mm: int_le(int_add(mallocng.UNIT, int_mul(mallocng.stride(V), int_add(app(V, "last_idx"), 1))), int_mul(app(V, "maplen"), 4096)) by taut(g2)
      have e := mp(ite_t[c := int_lt(0, app(V, "maplen")), a := pair(app(V, "mem"), int_mul(app(V, "maplen"), 4096)), b := pair(app(V, "mem"), int_add(int_sub(int_add(mallocng.UNIT, int_mul(mallocng.stride(V), int_add(app(V, "last_idx"), 1))), mallocng.IB), 1))], h)
      have r: int_le(app(V, "mem"), a) && int_lt(a, int_add(app(V, "mem"), int_mul(app(V, "maplen"), 4096))) by arith(h1, h2, top, m1, mm, cu)
      show by defs(simp(e, r), mallocng.in_range, mallocng.group_range)
    qed
    have c2: !int_lt(0, app(V, "maplen")) -> mallocng.in_range(a, mallocng.group_range(V)) proof
      assume h
      have e := mp(ite_f[c := int_lt(0, app(V, "maplen")), a := pair(app(V, "mem"), int_mul(app(V, "maplen"), 4096)), b := pair(app(V, "mem"), int_add(int_sub(int_add(mallocng.UNIT, int_mul(mallocng.stride(V), int_add(app(V, "last_idx"), 1))), mallocng.IB), 1))], h)
      have r: int_le(app(V, "mem"), a) && int_lt(a, int_add(app(V, "mem"), int_add(int_sub(int_add(mallocng.UNIT, int_mul(mallocng.stride(V), int_add(app(V, "last_idx"), 1))), mallocng.IB), 1))) by arith(h1, h2, top, m1, cu, ci)
      show by defs(simp(e, r), mallocng.in_range, mallocng.group_range)
    qed
    show by taut(c1, c2)
  qed
  have irk := rewrite(sym(hkg), ir)
  have nr := apply(mp.nores[A := A, a := a], hnr)
  have fp0 := apply(mp.group_fp, hc, hu, ha, hk, hkl, hao, irk, nl, nr)
  have fp := apply(mp.group_held[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, brk := app(vm, "brk"), h := g, a := a], hc, hu, ha, H, iu, hao, ir, fp0)
  have rr: (int_lt(k, seq_len(app(A, "used"))) && int_le(fst(mallocng.group_range(app(app(A, "metas"), app(app(A, "used"), k)))), a)) &&
      int_lt(a, int_add(fst(mallocng.group_range(app(app(A, "metas"), app(app(A, "used"), k)))), snd(mallocng.group_range(app(app(A, "metas"), app(app(A, "used"), k)))))) by taut(hkl, expand(irk, mallocng.in_range))
  have acc := mp(all_elim(pg2, {k}, {a}), conj(hk, hao), conj(conj(rr, nl), nr))
  show by taut(fp, acc)
qed

// a byte of the view: memory's, a byte
theorem mp.b8_view(vm, fp, a): app(vm, "bytes") in fn_space(bits(64), bits(8)) -> a in omega -> a in fp ->
  mallocng.b8(mallocng.mview(vm, fp), a) = app(app(vm, "bytes"), bits_of_int(64, a)) && mallocng.b8(mallocng.mview(vm, fp), a) in omega
proof
  assume hb ha hf
  have e: mallocng.b8(mallocng.mview(vm, fp), a) = app(app(vm, "bytes"), bits_of_int(64, a)) by defs(simp(hf, ha), mallocng.b8, mallocng.mview, some)
  have bb := mp(fn_space_app[a := bits(64), b := bits(8), f := app(vm, "bytes"), x := bits_of_int(64, a)], hb, simp())
  show by taut(e, rewrite(sym(e), (app(app(vm, "bytes"), bits_of_int(64, a)) in omega by simp(bb))))
qed

// ----------------------------------------------------------------------
//  get_stride's conditions: a group in use meets them, its stride the
//  group's (`mallocng_specs.stride_w`: the meta word's fields)

theorem mp.gs_pre(c, A, vm, b, objs, g): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> g in bits(64) ->
  mallocng.holds_in(c, A, vm, b) -> mallocng.is_used(A, g) ->
  mallocng_specs.get_stride_pre(vm, objs, app(c, "sct"), g) &&
  mallocng_specs.stride_w(vm, g) = mallocng.stride(app(app(A, "metas"), g)) &&
  int_mod(int_div(mallocng_specs.mword(vm, g), 64), 64) = app(app(app(A, "metas"), g), "sizeclass")
proof
  assume hc hu ha hg hin hus
  let V := app(app(A, "metas"), g)
  have go: g in omega by simp(hg)
  // the meta's word: its fields packed
  have top mw := apply(mp.meta_word, hc, hu, ha, hin, hus)
  have {H = inv} := expand(hin, mallocng.holds_in)
  have {uo = used} := expand(H, mallocng.holds)
  have gok := apply(mp.used_group, uo, hus)
  have {mim, sc = cls, big1 = big} := expand(gok, mallocng.group_ok)
  have big := expand(big1, mallocng.big_ok)
  have _ _ _ _ _ _ bl bf bs := expand(mim, mallocng.meta_in_memory)
  have vt: V in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := app(A, "metas"), x := g], simp(ha), go)
  have vl: app(V, "last_idx") in omega by simp(vt)
  have vf: app(V, "freeable") in omega by simp(vt)
  have vs: app(V, "sizeclass") in omega by simp(vt)
  have vm2: app(V, "maplen") in omega by simp(vt)
  let W := mallocng_specs.mword(vm, g)
  have w32: int_mod(W, 32) = app(V, "last_idx") by arith(mw, bl, bf, bs, vl, vf, vs, vm2)
  have w4k: int_div(W, 4096) = app(V, "maplen") by arith(mw, bl, bf, bs, vl, vf, vs, vm2)
  have w64: int_mod(int_div(W, 64), 64) = app(V, "sizeclass") by arith(mw, bl, bf, bs, vl, vf, vs, vm2)
  have msi: mallocng_specs.mapped_single(vm, g) <-> app(V, "last_idx") = 0 && int_lt(0, app(V, "maplen"))
    by defs(simp(w32, w4k, vm2), mallocng_specs.mapped_single)
  have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
  have sw: mallocng_specs.stride_w(vm, g) = mallocng.stride(V) by defs(simp(msi, w4k, w64, cu), mallocng_specs.stride_w, mallocng.stride)
  // the word readable, the class table
  have _ g24 inr := apply(mp.meta_mem, hc, hu, ha, hin, hus)
  let FP := mallocng.held(c, A, b)
  have bj: all j. j in omega -> int_lt(j, 8) -> int_add(int_add(g, 32), j) in FP && mallocng.m_mapped(mallocng.mview(vm, FP), int_add(int_add(g, 32), j)) &&
      app(app(snd(mallocng.pg(mallocng.mview(vm, FP), int_add(int_add(g, 32), j))), "prot"), "r") && !(app(snd(mallocng.pg(mallocng.mview(vm, FP), int_add(int_add(g, 32), j))), "kind") = 2) proof
    fix j
    assume hj hjl
    have r1 r2 r3 := mp(all_elim(inr, {int_add(int_add(g, 32), j)}), (int_add(int_add(g, 32), j) in omega by arith(go, hj)),
      (int_le(g, int_add(int_add(g, 32), j)) by arith(go, hj)), (int_lt(int_add(int_add(g, 32), j), int_add(g, 40)) by arith(go, hj, hjl)))
    show by taut(r1, expand(r2, mallocng.m_rw), r3)
  qed
  have us := apply(mp.view_usable[vm := vm, fp := FP, objs := objs, a := int_add(g, 32), n := 8], (int_add(g, 32) in omega by arith(go)), bj)
  have tb := apply(mp.classes_table[c := c, A := A, vm := vm, b := b, objs := objs], hc, hu, ha, hin)
  have gpre: mallocng_specs.get_stride_pre(vm, objs, app(c, "sct"), g)
    by defs(simp(top, us, tb, msi, w64, sc, big, g24, go), mallocng_specs.get_stride_pre)
  show by taut(gpre, sw, w64)
qed

// ----------------------------------------------------------------------
//  get_meta's checks: what starts at p in slot i of the group g passes
//  them all (`mallocng_specs.get_meta_pre`), the meta read g, the index i

theorem mp.gm_pre(c, A, vm, b, objs, fs, g, i, p): c in mallocng.Cfg ->
  app(c, "ctx") = c_src_malloc_mallocng_malloc.__malloc_context -> app(c, "sct") = c_src_malloc_mallocng_malloc.__malloc_size_classes ->
  A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) -> app(vm, "bytes") in fn_space(bits(64), bits(8)) ->
  p in bits(64) -> i in omega -> mallocng.holds_in(c, A, vm, b) -> mallocng.no_reserved(A) -> abi.thread_ok(vm, fs) -> mallocng.starts_at(A, g, i, p) ->
  mallocng_specs.get_meta_pre(vm, objs, fs, c_src_malloc_mallocng_malloc.__malloc_context, c_src_malloc_mallocng_malloc.__malloc_size_classes, p) &&
  mallocng_specs.gm_meta(vm, p) = g && mallocng_specs.gm_idx(vm, p) = i
proof
  assume hc hctx hsct hu ha hb hvb hp hi hh hnr hth hs
  let FP := mallocng.held(c, A, b)
  let M := mallocng.mview(vm, FP)
  let V := app(app(A, "metas"), g)
  let CTX := c_src_malloc_mallocng_malloc.__malloc_context
  let SCT := c_src_malloc_mallocng_malloc.__malloc_size_classes
  have hpo: p in omega by simp(hp)
  have p64: pow2(64) = 18446744073709551616 by simp()
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {uo = used, po = perms} := expand(H, mallocng.holds)
  have iu il sl := expand(hs, mallocng.starts_at)
  obtain k, hk hkl hkg from expand(iu, mallocng.is_used)
  have go: g in omega := rewrite(hkg, mp(at_type[l := app(A, "used"), t := omega, i := k], simp(ha), hk, hkl))
  have gok := apply(mp.used_group, uo, iu)
  have s1 s2 s3 s4 s5 s6 s7 s8 := apply(mp.slot_frame, ha, hb, go, hi, hpo, uo, gok, hs)
  have vt: V in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := app(A, "metas"), x := g], simp(ha), go)
  have vmem: app(V, "mem") in omega by simp(vt)
  have vmap: app(V, "maplen") in omega by simp(vt)
  have vlast: app(V, "last_idx") in omega by simp(vt)
  have vfr: app(V, "freeable") in omega by simp(vt)
  have vsc: app(V, "sizeclass") in omega by simp(vt)
  have vav: app(V, "avail") in omega by simp(vt)
  have vfd: app(V, "freed") in omega by simp(vt)
  have sn := apply(mp.stride_nat, ha, go, gok)
  have {mim, gsc = cls, g3 = hdr, g4 = hdr_own, gl = nslots, g7f = masks, gmp = mapped, big1 = big} := expand(gok, mallocng.group_ok)
  have g7 := expand(g7f, mallocng.masks_ok)
  have big := expand(big1, mallocng.big_ok)
  have rdg m16 mpos := g3
  have _ _ mmem mav mfr _ bl bf bs := expand(mim, mallocng.meta_in_memory)
  have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
  have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
  // the slot's geometry: p past the group's header, before its end
  have m0 := mp(all_elim(ms.mul_le, {0}, {0}, {mallocng.stride(V)}, {i}), simp(), simp(), simp(sn), simp(hi), arith(sn), arith(hi))
  have ile: int_le(int_add(i, 1), int_add(app(V, "last_idx"), 1)) by arith(gl, il, hi, vlast)
  have m1 := mp(all_elim(ms.mul_le, {mallocng.stride(V)}, {int_add(i, 1)}, {mallocng.stride(V)}, {int_add(app(V, "last_idx"), 1)}), sn, simp(hi), simp(sn), simp(vlast), arith(sn), ile)
  have ss: mallocng.slot_start(V, i) = int_add(int_add(app(V, "mem"), 16), int_mul(mallocng.stride(V), i)) by defs(arith(cu), mallocng.slot_start, mallocng.storage)
  have st: mallocng.storage(V) = int_add(app(V, "mem"), 16) by defs(arith(cu), mallocng.storage)
  have se: mallocng.slot_end(V, i) = int_sub(int_add(mallocng.slot_start(V, i), mallocng.stride(V)), 4) by defs(arith(ci), mallocng.slot_end)
  have dist: int_mul(mallocng.stride(V), int_add(i, 1)) = int_add(int_mul(mallocng.stride(V), i), mallocng.stride(V)) by arith(sn, hi)
  have lo: int_le(int_add(app(V, "mem"), 16), p) by arith(s1, ss, m0)
  have h16: int_le(16, p) by arith(lo, vmem)
  have ptop: int_le(p, int_add(int_add(app(V, "mem"), 12), int_mul(mallocng.stride(V), int_add(i, 1)))) by arith(s2, se, ss, dist)
  have hpl: int_lt(p, 18446744073709551616) by simp(hp)
  // the stride: a multiple of a unit (a class's size, or a mapping less a unit)
  have sq: ex q. q in omega && mallocng.stride(V) = int_mul(16, q) proof
    have c1: app(V, "last_idx") = 0 && int_lt(0, app(V, "maplen")) -> ex q. q in omega && mallocng.stride(V) = int_mul(16, q) proof
      assume h
      have e: mallocng.stride(V) = int_sub(int_mul(app(V, "maplen"), 4096), 16) by defs(simp(h, cu), mallocng.stride)
      show by ex_intro({int_sub(int_mul(app(V, "maplen"), 256), 1)}, arith(e, h, vmap))
    qed
    have c2: !(app(V, "last_idx") = 0 && int_lt(0, app(V, "maplen"))) -> ex q. q in omega && mallocng.stride(V) = int_mul(16, q) proof
      assume h
      have e: mallocng.stride(V) = int_mul(16, app(mallocng.size_classes, app(V, "sizeclass"))) by defs(simp(h, cu), mallocng.stride)
      have s48: int_lt(app(V, "sizeclass"), 48) by taut(gsc, big, h)
      have sn1 _ := mp(all_elim(ms.sc_nat, {app(V, "sizeclass")}), vsc, s48)
      show by ex_intro({app(mallocng.size_classes, app(V, "sizeclass"))}, taut(sn1, e))
    qed
    show by taut(c1, c2)
  qed
  obtain q, hq hsq from sq
  // the offset in units OFF: from the group's storage to p
  let OFF := int_div(int_sub(p, mallocng.storage(V)), mallocng.UNIT)
  have sqi := subst({y. int_mul(mallocng.stride(V), i) = int_mul(y, i)}, hsq, refl({int_mul(mallocng.stride(V), i)}))
  have asc: int_mul(int_mul(16, q), i) = int_mul(16, int_mul(q, i)) by arith(hq, hi)
  have sqi2 := trans(sqi, asc)
  have ps: int_sub(p, mallocng.storage(V)) = int_add(int_sub(p, mallocng.slot_start(V, i)), int_mul(16, int_mul(q, i))) by arith(ss, st, sqi2, s1)
  have o16: int_mul(16, OFF) = int_sub(p, mallocng.storage(V)) by arith(ps, s5, cu, hq, hi)
  have hal: int_mod(p, 16) = 0 by arith(o16, st, m16, cu)
  // p's header: the allocator's, readable; its bytes as the invariant has them
  have bp := apply(mp.below_p, hc, hu, ha, hb, hi, hpo, hh, hnr, hs)
  have hdr: all j. j in omega -> int_lt(j, 4) -> int_add(int_sub(p, 4), j) in FP && mallocng.m_mapped(M, int_add(int_sub(p, 4), j)) &&
      app(app(snd(mallocng.pg(M, int_add(int_sub(p, 4), j))), "prot"), "r") && !(app(snd(mallocng.pg(M, int_add(int_sub(p, 4), j))), "kind") = 2) proof
    fix j
    assume hj hjl
    let a := int_add(int_sub(p, 4), j)
    have nl := mp(all_elim(expand(s4, mallocng.hdr_free), {a}), (a in omega by arith(h16, hj)), (int_le(int_sub(p, mallocng.IB), a) && int_lt(a, p) by arith(ci, hj, hjl, h16)))
    have r1 r2 r3 := mp(all_elim(bp, {a}), (a in omega by arith(h16, hj)), (int_le(app(V, "mem"), a) by arith(lo, hj)), (int_lt(a, p) by arith(hj, hjl, h16)), nl)
    show by taut(r1, expand(r2, mallocng.m_rw), r3)
  qed
  have u4 := apply(mp.view_usable[vm := vm, fp := FP, objs := objs, a := int_sub(p, 4), n := 4], (int_sub(p, 4) in omega by arith(h16)), hdr)
  have hfp: all j. j in omega -> int_lt(j, 4) -> int_add(int_sub(p, 4), j) in FP proof
    fix j
    assume hj hjl
    have r := mp(all_elim(hdr, {j}), hj, hjl)
    show by taut(r)
  qed
  have f4 := mp(all_elim(hfp, {0}), simp(), simp())
  have f3 := mp(all_elim(hfp, {1}), simp(), simp())
  have f2 := mp(all_elim(hfp, {2}), simp(), simp())
  have f1 := mp(all_elim(hfp, {3}), simp(), simp())
  have bs4: bits_sub(64, p, 4) = int_sub(p, 4) by defs(arith(hpo, h16, hpl), bits_sub, pow2)
  have bs3: bits_sub(64, p, 3) = int_sub(p, 3) by defs(arith(hpo, h16, hpl), bits_sub, pow2)
  have bs2: bits_sub(64, p, 2) = int_sub(p, 2) by defs(arith(hpo, h16, hpl), bits_sub, pow2)
  // (from p - 4 + d on, n bytes: within the header)
  have hsub: all d n. d in omega -> n in omega -> int_le(int_add(d, n), 4) -> (all j. j in omega -> int_lt(j, n) -> int_add(int_add(int_sub(p, 4), d), j) in FP) proof
    fix d n
    assume hd hn hdn
    fix j
    assume hj hjl
    have r := mp(all_elim(hfp, {int_add(d, j)}), (int_add(d, j) in omega by arith(hd, hj)), (int_lt(int_add(d, j), 4) by arith(hdn, hjl)))
    have e: int_add(int_add(int_sub(p, 4), d), j) = int_add(int_sub(p, 4), int_add(d, j)) by arith()
    show := rewrite(sym(e), r)
  qed
  have a4: int_add(int_sub(p, 4), 0) = int_sub(p, 4) by arith()
  have a3: int_add(int_sub(p, 4), 1) = int_sub(p, 3) by arith(h16)
  have a2: int_add(int_sub(p, 4), 2) = int_sub(p, 2) by arith(h16)
  have v4 := apply(mp.view_read[vm := vm, fp := FP, a := int_sub(p, 4), n := 1], (int_sub(p, 4) in omega by arith(h16)), simp(), simp(),
    rewrite(a4, mp(all_elim(hsub, {0}, {1}), simp(), simp(), simp())))
  have v3 := apply(mp.view_read[vm := vm, fp := FP, a := int_sub(p, 3), n := 1], (int_sub(p, 3) in omega by arith(h16)), simp(), simp(),
    rewrite(a3, mp(all_elim(hsub, {1}, {1}), simp(), simp(), simp())))
  have v2 := apply(mp.view_read[vm := vm, fp := FP, a := int_sub(p, 2), n := 2], (int_sub(p, 2) in omega by arith(h16)), simp(), simp(),
    rewrite(a2, mp(all_elim(hsub, {2}, {2}), simp(), simp(), simp())))
  have _ b4n := apply(mp.b8_view, hvb, (int_sub(p, 4) in omega by arith(h16)), rewrite(a4, f4))
  have _ b3n := apply(mp.b8_view, hvb, (int_sub(p, 3) in omega by arith(h16)), rewrite(a3, f3))
  have r4: mallocng.rd(M, int_sub(p, 4), 1) = mallocng.b8(M, int_sub(p, 4)) by defs(simp(b4n), mallocng.rd)
  have r3: mallocng.rd(M, int_sub(p, 3), 1) = mallocng.b8(M, int_sub(p, 3)) by defs(simp(b3n), mallocng.rd)
  have q4 := subst({y. gimple.bytes_at(vm, y, 1) = gimple.bytes_at(vm, int_sub(p, 4), 1)}, sym(bs4), refl({gimple.bytes_at(vm, int_sub(p, 4), 1)}))
  have q3 := subst({y. gimple.bytes_at(vm, y, 1) = gimple.bytes_at(vm, int_sub(p, 3), 1)}, sym(bs3), refl({gimple.bytes_at(vm, int_sub(p, 3), 1)}))
  have q2 := subst({y. gimple.bytes_at(vm, y, 2) = gimple.bytes_at(vm, int_sub(p, 2), 2)}, sym(bs2), refl({gimple.bytes_at(vm, int_sub(p, 2), 2)}))
  have e4: gimple.bytes_at(vm, bits_sub(64, p, 4), 1) = 0 := trans(trans(q4, trans(v4, r4)), s6)
  have e3: gimple.bytes_at(vm, bits_sub(64, p, 3), 1) = mallocng.b8(M, int_sub(p, 3)) := trans(q3, trans(v3, r3))
  have e2: gimple.bytes_at(vm, bits_sub(64, p, 2), 2) = OFF := trans(q2, trans(v2, s7))
  have eoff: mallocng_specs.gm_off(vm, p) = OFF by defs(simp(e4, e2), mallocng_specs.gm_off)
  have eidx: mallocng_specs.gm_idx(vm, p) = i by defs(simp(e3, s3), mallocng_specs.gm_idx)
  have ebase: mallocng_specs.gm_base(vm, p) = app(V, "mem") by defs(arith(eoff, o16, st, cu, hpo, vmem), mallocng_specs.gm_base)
  have hmem: int_lt(app(V, "mem"), 18446744073709551616) by arith(lo, hpl)
  // the group's header: its first word the meta g
  have g4b: all a. a in omega -> int_le(app(V, "mem"), a) -> int_lt(a, int_add(app(V, "mem"), mallocng.UNIT)) -> !(a in malloc.live_of(b)) proof
    fix a
    assume hao h1 h2
    show := mp(all_elim(g4, {a}), hao, conj(h1, h2))
  qed
  have ghd: all j. j in omega -> int_lt(j, 8) -> int_add(app(V, "mem"), j) in FP && mallocng.m_mapped(M, int_add(app(V, "mem"), j)) &&
      app(app(snd(mallocng.pg(M, int_add(app(V, "mem"), j))), "prot"), "r") && !(app(snd(mallocng.pg(M, int_add(app(V, "mem"), j))), "kind") = 2) proof
    fix j
    assume hj hjl
    let a := int_add(app(V, "mem"), j)
    have ao: a in omega by arith(vmem, hj)
    have nl := mp(all_elim(g4b, {a}), ao, (int_le(app(V, "mem"), a) by arith(hj)), (int_lt(a, int_add(app(V, "mem"), mallocng.UNIT)) by arith(hjl, cu)))
    have r1 r2 r3 := mp(all_elim(bp, {a}), ao, (int_le(app(V, "mem"), a) by arith(hj)), (int_lt(a, p) by arith(hjl, lo)), nl)
    show by taut(r1, expand(r2, mallocng.m_rw), r3)
  qed
  have umem := apply(mp.view_usable[vm := vm, fp := FP, objs := objs, a := app(V, "mem"), n := 8], vmem, ghd)
  have gfp: all j. j in omega -> int_lt(j, 8) -> int_add(app(V, "mem"), j) in FP proof
    fix j
    assume hj hjl
    have r := mp(all_elim(ghd, {j}), hj, hjl)
    show by taut(r)
  qed
  have vmm := apply(mp.view_read[vm := vm, fp := FP, a := app(V, "mem"), n := 8], vmem, simp(), simp(), gfp)
  // the meta g: in use, its bytes the allocator's, its word
  have top mw := apply(mp.meta_word, hc, hu, ha, hh, iu)
  have _ g24 inr := apply(mp.meta_mem, hc, hu, ha, hh, iu)
  have bmem: bits_of_int(64, app(V, "mem")) = app(V, "mem") by defs(arith(vmem, hmem), bits_of_int, pow2)
  have bg: bits_of_int(64, g) = g by defs(arith(go, top), bits_of_int, pow2)
  have egm: mallocng_specs.gm_meta(vm, p) = g by defs(simp(ebase, bmem, vmm, rdg, bg), mallocng_specs.gm_meta, mallocng_specs.rd64)
  have mbytes: all d n. d in omega -> n in omega -> int_le(int_add(d, n), 40) ->
      gimple.usable(vm, objs, int_add(g, d), n, false) && gimple.bytes_at(vm, int_add(g, d), n) = mallocng.rd(M, int_add(g, d), n) proof
    fix d n
    assume hd hn hdn
    have bj: all j. j in omega -> int_lt(j, n) -> int_add(int_add(g, d), j) in FP && mallocng.m_mapped(M, int_add(int_add(g, d), j)) &&
        app(app(snd(mallocng.pg(M, int_add(int_add(g, d), j))), "prot"), "r") && !(app(snd(mallocng.pg(M, int_add(int_add(g, d), j))), "kind") = 2) proof
      fix j
      assume hj hjl
      have r1 r2 r3 := mp(all_elim(inr, {int_add(int_add(g, d), j)}), (int_add(int_add(g, d), j) in omega by arith(go, hd, hj)),
        (int_le(g, int_add(int_add(g, d), j)) by arith(go, hd, hj)), (int_lt(int_add(int_add(g, d), j), int_add(g, 40)) by arith(hdn, hjl)))
      show by taut(r1, expand(r2, mallocng.m_rw), r3)
    qed
    have fpj: all j. j in omega -> int_lt(j, n) -> int_add(int_add(g, d), j) in FP proof
      fix j
      assume hj hjl
      have r := mp(all_elim(bj, {j}), hj, hjl)
      show by taut(r)
    qed
    have us := apply(mp.view_usable[vm := vm, fp := FP, objs := objs, a := int_add(g, d), n := n], (int_add(g, d) in omega by arith(go, hd)), bj)
    have vr := apply(mp.view_read[vm := vm, fp := FP, a := int_add(g, d), n := n], (int_add(g, d) in omega by arith(go, hd)), hn, (int_le(n, 18446744073709551616) by arith(hdn, hd)), fpj)
    show by taut(us, vr)
  qed
  have u16 v16 := mp(all_elim(mbytes, {16}, {24}), simp(), simp(), simp())
  have _ vw16 := mp(all_elim(mbytes, {16}, {8}), simp(), simp(), simp())
  have _ vw24 := mp(all_elim(mbytes, {24}, {4}), simp(), simp(), simp())
  have _ vw28 := mp(all_elim(mbytes, {28}, {4}), simp(), simp(), simp())
  have ba16: bits_add(64, g, 16) = int_add(g, 16) by defs(arith(go, top), bits_add, pow2)
  have ba24: bits_add(64, g, 24) = int_add(g, 24) by defs(arith(go, top), bits_add, pow2)
  have ba28: bits_add(64, g, 28) = int_add(g, 28) by defs(arith(go, top), bits_add, pow2)
  // the fields: last index, size class, mapping
  have w32: int_mod(mallocng_specs.mword(vm, g), 32) = app(V, "last_idx") by arith(mw, bl, bf, bs, vlast, vfr, vsc, vmap)
  have w4k: int_div(mallocng_specs.mword(vm, g), 4096) = app(V, "maplen") by arith(mw, bl, bf, bs, vlast, vfr, vsc, vmap)
  have w64: int_mod(int_div(mallocng_specs.mword(vm, g), 64), 64) = app(V, "sizeclass") by arith(mw, bl, bf, bs, vlast, vfr, vsc, vmap)
  have ilast: int_le(i, app(V, "last_idx")) by arith(gl, il, hi, vlast)
  have i32: int_lt(i, 32) by arith(ilast, bl)
  // p's slot: in use (neither available nor freed)
  have nu: !(app(app(app(A, "slots"), g), i) = tag(0, empty)) by simp(sl)
  have g7i := mp(all_elim(g7, {i}), hi, i32)
  have _ _ g7c _ := g7i
  have g7d _ := mp(g7c, ilast)
  have sz: !int_lt(0, int_add(mallocng.bit(app(V, "avail"), i), mallocng.bit(app(V, "freed"), i))) by taut(g7d, nu)
  have sz2 := expand(sz, mallocng.bit)
  have bav: mallocng.bit(app(V, "avail"), i) = 0 by defs(arith(sz2, vav, vfd), mallocng.bit)
  have bfr: mallocng.bit(app(V, "freed"), i) = 0 by defs(arith(sz2, vav, vfd), mallocng.bit)
  // the meta's area: its first word the secret, the context's too
  have a0 ainr asec := apply(mp.meta_area, hc, hu, ha, hh, iu)
  have cinr csec := apply(mp.ctx_secret, hc, hu, ha, hh)
  let AR := int_mul(int_div(g, 4096), 4096)
  let SCX := int_mod(int_div(mallocng_specs.mword(vm, mallocng_specs.gm_meta(vm, p)), 64), 64)
  let CL := app(mallocng.size_classes, app(V, "sizeclass"))
  have arb: AR in omega && int_le(AR, g) by arith(go)
  have argl: int_lt(int_add(AR, 8), 18446744073709551616) by arith(arb, top)
  // each check, as get_meta's precondition states it
  have c4: !(gimple.bytes_at(vm, bits_sub(64, p, 4), 1) = 0) -> ((gimple.usable(vm, objs, int_sub(p, 8), 4, false) && gimple.bytes_at(vm, bits_sub(64, p, 2), 2) = 0) &&
      int_lt(65535, gimple.bytes_at(vm, bits_sub(64, p, 8), 4))) && int_lt(gimple.bytes_at(vm, bits_sub(64, p, 8), 4), int_pow(2, 27)) by taut(e4)
  have c5: int_lt(int_add(int_mul(mallocng.UNIT, mallocng_specs.gm_off(vm, p)), mallocng.UNIT), p) by arith(eoff, o16, st, cu, mpos, vmem)
  have c6: gimple.usable(vm, objs, mallocng_specs.gm_base(vm, p), 8, false) := rewrite(sym(ebase), umem)
  have c7: !(mallocng_specs.gm_meta(vm, p) = 0) by arith(egm, g24, go)
  have c8: int_le(int_add(mallocng_specs.gm_meta(vm, p), 40), int_pow(2, 64)) := rewrite(sym(egm), top)
  have c9: gimple.usable(vm, objs, int_add(mallocng_specs.gm_meta(vm, p), 16), 24, false) := rewrite(sym(egm), u16)
  have m16: mallocng_specs.rd64(vm, bits_add(64, g, 16)) = app(V, "mem") by defs(simp(ba16, vw16, mmem, bmem), mallocng_specs.rd64)
  have c10: mallocng_specs.rd64(vm, bits_add(64, mallocng_specs.gm_meta(vm, p), 16)) = mallocng_specs.gm_base(vm, p) := rewrite(sym(egm), rewrite(sym(ebase), m16))
  have c11: int_le(mallocng_specs.gm_idx(vm, p), int_mod(mallocng_specs.mword(vm, mallocng_specs.gm_meta(vm, p)), 32)) by simp(eidx, egm, w32, ilast)
  have c12: int_mod(int_div(gimple.bytes_at(vm, bits_add(64, mallocng_specs.gm_meta(vm, p), 24), 4), int_pow(2, mallocng_specs.gm_idx(vm, p))), 2) = 0
    by simp(egm, eidx, ba24, vw24, mav, expand(bav, mallocng.bit))
  have c13: int_mod(int_div(gimple.bytes_at(vm, bits_add(64, mallocng_specs.gm_meta(vm, p), 28), 4), int_pow(2, mallocng_specs.gm_idx(vm, p))), 2) = 0
    by simp(egm, eidx, ba28, vw28, mfr, expand(bfr, mallocng.bit))
  have c14: !(int_mul(int_div(mallocng_specs.gm_meta(vm, p), 4096), 4096) = 0) by simp(egm, a0)
  have abj: all j. j in omega -> int_lt(j, 8) -> int_add(AR, j) in FP && mallocng.m_mapped(M, int_add(AR, j)) &&
      app(app(snd(mallocng.pg(M, int_add(AR, j))), "prot"), "r") && !(app(snd(mallocng.pg(M, int_add(AR, j))), "kind") = 2) proof
    fix j
    assume hj hjl
    have r1 r2 r3 := mp(all_elim(ainr, {int_add(AR, j)}), (int_add(AR, j) in omega by arith(arb, hj)), (int_le(AR, int_add(AR, j)) by arith(hj)), (int_lt(int_add(AR, j), int_add(AR, 4096)) by arith(hjl)))
    show by taut(r1, expand(r2, mallocng.m_rw), r3)
  qed
  have uar := apply(mp.view_usable[vm := vm, fp := FP, objs := objs, a := AR, n := 8], (AR in omega by taut(arb)), abj)
  have c15: gimple.usable(vm, objs, int_mul(int_div(mallocng_specs.gm_meta(vm, p), 4096), 4096), 8, false) := rewrite(sym(egm), uar)
  have cv: CTX = 4227328 by defs(refl({4227328}), c_src_malloc_mallocng_malloc.__malloc_context)
  have c16: !(CTX = 0) by simp(cv)
  have c17: int_le(int_add(CTX, 8), int_pow(2, 64)) by simp(cv)
  have cbj: all j. j in omega -> int_lt(j, 8) -> int_add(CTX, j) in FP && mallocng.m_mapped(M, int_add(CTX, j)) &&
      app(app(snd(mallocng.pg(M, int_add(CTX, j))), "prot"), "r") && !(app(snd(mallocng.pg(M, int_add(CTX, j))), "kind") = 2) proof
    fix j
    assume hj hjl
    have r1 r2 r3 := mp(all_elim(cinr, {int_add(CTX, j)}), (int_add(CTX, j) in omega by arith(cv, hj)), (int_le(app(c, "ctx"), int_add(CTX, j)) by arith(hctx, hj)), (int_lt(int_add(CTX, j), int_add(app(c, "ctx"), 8)) by arith(hctx, hjl)))
    show by taut(r1, expand(r2, mallocng.m_rw), r3)
  qed
  have c18 := apply(mp.view_usable[vm := vm, fp := FP, objs := objs, a := CTX, n := 8], (CTX in omega by simp(cv)), cbj)
  have afp: all j. j in omega -> int_lt(j, 8) -> int_add(AR, j) in FP proof
    fix j
    assume hj hjl
    have r := mp(all_elim(abj, {j}), hj, hjl)
    show by taut(r)
  qed
  have cfp: all j. j in omega -> int_lt(j, 8) -> int_add(CTX, j) in FP proof
    fix j
    assume hj hjl
    have r := mp(all_elim(cbj, {j}), hj, hjl)
    show by taut(r)
  qed
  have var := apply(mp.view_read[vm := vm, fp := FP, a := AR, n := 8], (AR in omega by taut(arb)), simp(), simp(), afp)
  have vct := apply(mp.view_read[vm := vm, fp := FP, a := CTX, n := 8], (CTX in omega by simp(cv)), simp(), simp(), cfp)
  have bar: bits_of_int(64, AR) = AR by defs(arith(arb, argl), bits_of_int, pow2)
  have s19: mallocng_specs.rd64(vm, bits_of_int(64, AR)) = mallocng_specs.rd64(vm, CTX) by defs(simp(bar, var, vct, asec, rewrite(hctx, csec)), mallocng_specs.rd64)
  have c19: mallocng_specs.rd64(vm, bits_of_int(64, int_mul(int_div(mallocng_specs.gm_meta(vm, p), 4096), 4096))) = mallocng_specs.rd64(vm, CTX) := rewrite(sym(egm), s19)
  // the class's bounds on the offset
  have scx: SCX = app(V, "sizeclass") by simp(egm, w64)
  have clo: int_lt(app(V, "sizeclass"), 48) -> CL in omega proof
    assume h
    have r _ := mp(all_elim(ms.sc_nat, {app(V, "sizeclass")}), vsc, h)
    show := r
  qed
  have lob: int_lt(app(V, "sizeclass"), 48) -> int_le(int_mul(CL, i), OFF) proof
    assume h
    have co := mp(clo, h)
    have k1: app(V, "last_idx") = 0 && int_lt(0, app(V, "maplen")) -> int_le(int_mul(CL, i), OFF) proof
      assume h2
      have hl0: app(V, "last_idx") = 0 by taut(h2)
      have i0: i = 0 by arith(ilast, hl0, hi, vlast)
      show by arith(i0, co, cu, lo, st, vmem)
    qed
    have k2: !(app(V, "last_idx") = 0 && int_lt(0, app(V, "maplen"))) -> int_le(int_mul(CL, i), OFF) proof
      assume h2
      have e: mallocng.stride(V) = int_mul(16, CL) by defs(simp(h2, cu), mallocng.stride)
      have e2 := subst({y. int_mul(mallocng.stride(V), i) = int_mul(y, i)}, e, refl({int_mul(mallocng.stride(V), i)}))
      have as2: int_mul(int_mul(16, CL), i) = int_mul(16, int_mul(CL, i)) by arith(co, hi)
      have po := mp(all_elim(ms.mul_le, {0}, {0}, {CL}, {i}), simp(), simp(), simp(co), simp(hi), arith(co), arith(hi))
      show by arith(trans(e2, as2), o16, st, ss, s1, po)
    qed
    show by taut(k1, k2)
  qed
  have upb: int_lt(app(V, "sizeclass"), 48) -> int_lt(OFF, int_mul(CL, int_add(i, 1))) proof
    assume h
    have co := mp(clo, h)
    have b8u := mp(s8, h)
    have as3: int_mul(int_mul(mallocng.UNIT, CL), int_add(i, 1)) = int_mul(16, int_mul(CL, int_add(i, 1))) by arith(co, hi, cu)
    show by arith(rewrite(as3, b8u), o16)
  qed
  have tb := apply(mp.classes_table[c := c, A := A, vm := vm, b := b, objs := objs], hc, hu, ha, hh)
  have c20: int_lt(SCX, 48) -> (mallocng_specs.table_ok(vm, objs, SCT, 2, mallocng.size_classes) &&
      int_le(int_mul(app(mallocng.size_classes, SCX), mallocng_specs.gm_idx(vm, p)), mallocng_specs.gm_off(vm, p))) &&
      int_lt(mallocng_specs.gm_off(vm, p), int_mul(app(mallocng.size_classes, SCX), int_add(mallocng_specs.gm_idx(vm, p), 1))) proof
    assume h
    have h48: int_lt(app(V, "sizeclass"), 48) := rewrite(scx, h)
    have l1 := mp(lob, h48)
    have l2 := mp(upb, h48)
    show by simp(rewrite(hsct, tb), scx, eidx, eoff, l1, l2)
  qed
  have c21: int_le(48, SCX) -> SCX = 63 proof
    assume h
    have h2: !int_lt(app(V, "sizeclass"), 48) by arith(rewrite(scx, h))
    have e63: app(V, "sizeclass") = 63 by taut(gsc, h2)
    show by simp(scx, e63)
  qed
  have c22: !(int_div(mallocng_specs.mword(vm, mallocng_specs.gm_meta(vm, p)), 4096) = 0) ->
      int_lt(mallocng_specs.gm_off(vm, p), int_mul(int_div(mallocng_specs.mword(vm, mallocng_specs.gm_meta(vm, p)), 4096), 256)) proof
    assume h
    have h0: int_lt(0, app(V, "maplen")) by arith(rewrite(w4k, rewrite(egm, h)), vmap)
    have g2 := mp(gmp, h0)
    have mm: int_le(int_add(mallocng.UNIT, int_mul(mallocng.stride(V), int_add(app(V, "last_idx"), 1))), int_mul(app(V, "maplen"), 4096)) by taut(g2)
    have lt: int_lt(OFF, int_mul(app(V, "maplen"), 256)) by arith(mm, m1, ptop, o16, st, cu, vmem, vmap, hpo, sn, lo)
    show by simp(egm, w4k, eoff, lt)
  qed
  have pre: mallocng_specs.get_meta_pre(vm, objs, fs, CTX, SCT, p)
    by defs(taut(hal, h16, u4, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15, c16, c17, c18, c19, c20, c21, c22, hth), mallocng_specs.get_meta_pre)
  show by taut(pre, egm, eidx)
qed


// ----------------------------------------------------------------------
//  Memory after stores: a byte a store did not cover, a store's own bytes

// a byte outside a store (one not wrapping around the address space): the
// old byte
theorem mp.st_out(B, c, k, v, x): x in bits(64) -> c in bits(64) -> k in omega -> int_le(int_add(c, k), 18446744073709551616) ->
  (int_le(int_add(c, k), x) || int_lt(x, c)) ->
  app(x86_64_linux.store_le(B, c, k, v), x) = app(B, x)
proof
  assume hx hc hk hck hout
  have e1 := mp(app_fn_build[d := bits(64), v := y. ite(int_lt(bits_sub(64, y, c), k), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, y, c)))), app(B, y)), a := x], hx)
  have nl: !int_lt(bits_sub(64, x, c), k) by defs(arith(hx, hc, hk, hck, hout), bits_sub, bits, pow2)
  have f := mp(ite_f[c := int_lt(bits_sub(64, x, c), k), a := bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x, c)))), b := app(B, x)], nl)
  show by defs(taut(trans(e1, f)), x86_64_linux.store_le)
qed

// byte j of a store: v's
theorem mp.st_at(B, c, k, v, j): c in bits(64) -> j in omega -> int_lt(j, k) -> int_le(int_add(c, k), 18446744073709551616) ->
  app(x86_64_linux.store_le(B, c, k, v), int_add(c, j)) = bits_of_int(8, int_div(v, int_pow(256, j)))
proof
  assume hc hj hjk hck
  have cb: int_le(0, c) && int_lt(c, 18446744073709551616) by simp(hc)
  have xl: int_lt(int_add(c, j), 18446744073709551616) by arith(cb, hj, hjk, hck)
  have xb: int_add(c, j) in bits(64) by simp(cb, hj, xl)
  have e1 := mp(app_fn_build[d := bits(64), v := y. ite(int_lt(bits_sub(64, y, c), k), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, y, c)))), app(B, y)), a := int_add(c, j)], xb)
  have d: bits_sub(64, int_add(c, j), c) = j by defs(arith(hc, hj, hjk, hck), bits_sub, bits, pow2)
  have lt: int_lt(bits_sub(64, int_add(c, j), c), k) := rewrite(sym(d), hjk)
  have t := mp(ite_t[c := int_lt(bits_sub(64, int_add(c, j), c), k), a := bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, int_add(c, j), c)))), b := app(B, int_add(c, j))], lt)
  show by defs(simp(trans(e1, t), d), x86_64_linux.store_le)
qed

// n bytes outside a store: the old ones
theorem mp.rd_out(vm, c, k, v, a, n): a in omega -> n in omega -> c in bits(64) -> k in omega ->
  int_le(int_add(a, n), 18446744073709551616) -> int_le(int_add(c, k), 18446744073709551616) ->
  (int_le(int_add(c, k), a) || int_le(int_add(a, n), c)) ->
  gimple.bytes_at(fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), c, k, v)), a, n) = gimple.bytes_at(vm, a, n)
proof
  assume ha hn hc hk han hck hout
  have pw: all i. i in omega -> int_le(0, i) -> int_lt(i, n) ->
      int_mul(app(app(fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), c, k, v)), "bytes"), bits_add(64, a, bits_of_int(64, i))), int_pow(256, i)) =
      int_mul(app(app(vm, "bytes"), bits_add(64, a, bits_of_int(64, i))), int_pow(256, i)) proof
    fix i
    assume hi _ hil
    have ba: bits_add(64, a, bits_of_int(64, i)) = int_add(a, i) by defs(arith(ha, hi, hil, han), bits_add, bits_of_int, pow2)
    have xl: int_lt(int_add(a, i), 18446744073709551616) by arith(ha, hi, hil, han)
    have xb: int_add(a, i) in bits(64) by simp(ha, hi, xl)
    have o: int_le(int_add(c, k), int_add(a, i)) || int_lt(int_add(a, i), c) by arith(ha, hi, hil, hout)
    have s := apply(mp.st_out[B := app(vm, "bytes"), c := c, k := k, v := v, x := int_add(a, i)], xb, hc, hk, hck, o)
    show by simp(ba, s)
  qed
  have e := mp(int_sum_ext[a := 0, b := n, f := i. int_mul(app(app(fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), c, k, v)), "bytes"), bits_add(64, a, bits_of_int(64, i))), int_pow(256, i)),
    g := i. int_mul(app(app(vm, "bytes"), bits_add(64, a, bits_of_int(64, i))), int_pow(256, i))], simp(), hn, pw)
  show by defs(e, gimple.bytes_at)
qed

// a 1-byte and a 4-byte store read back
theorem mp.rd_at1(vm, c, v): c in bits(64) -> v in omega ->
  gimple.bytes_at(fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), c, 1, v)), c, 1) = int_mod(v, 256)
proof
  assume hc hv
  show by defs(simp(hc, hv), gimple.bytes_at, x86_64_linux.store_le)
qed

// (as `tr.le_store8`: the bytes as a 32-bit word, then below 2^32)
theorem mp.rd_at4(vm, c, v): app(vm, "bytes") in fn_space(bits(64), bits(8)) -> c in bits(64) -> v in omega ->
  gimple.bytes_at(fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), c, 4, v)), c, 4) = int_mod(v, 4294967296)
proof
  assume hb hc hv
  let V := fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), c, 4, v))
  have le4: x86_64_linux.le(x86_64_linux.store_le(app(vm, "bytes"), c, 4, v), c, 4) = bits_of_int(32, v) by simp(hb, hc, hv)
  have lb := all_elim(tr.le_bytes, {V}, {c}, {4})
  have w: bits_of_int(32, gimple.bytes_at(V, c, 4)) = bits_of_int(32, v) by simp(le4, lb)
  have vb: app(V, "bytes") in fn_space(bits(64), bits(8)) by simp(mp(all_elim(x86.store_typed, {app(vm, "bytes")}, {c}, {4}, {v}), hb))
  have bn bl := mp(all_elim(g.bytes_bound, {V}, {c}, {4}), vb, simp())
  have id: bits_of_int(32, gimple.bytes_at(V, c, 4)) = gimple.bytes_at(V, c, 4) by defs(simp(bn, bl), bits_of_int, pow2)
  show by defs(simp(trans(sym(id), w)), bits_of_int, pow2)
qed

// the same through the specs' byte and word writes (`wr8`, `wr32`)
theorem mp.wr8_out(V, c, v, x): x in bits(64) -> c in bits(64) -> (int_le(int_add(c, 1), x) || int_lt(x, c)) ->
  app(app(mallocng_specs.wr8(V, c, v), "bytes"), x) = app(app(V, "bytes"), x)
proof
  assume hx hc ho
  have cl: int_le(int_add(c, 1), 18446744073709551616) by arith(simp(hc))
  have s := apply(mp.st_out[B := app(V, "bytes"), c := c, k := 1, v := v, x := x], hx, hc, simp(), cl, ho)
  show by defs(simp(s), mallocng_specs.wr8)
qed

theorem mp.wr32_out(V, c, v, x): x in bits(64) -> c in bits(64) -> int_le(int_add(c, 4), 18446744073709551616) -> (int_le(int_add(c, 4), x) || int_lt(x, c)) ->
  app(app(mallocng_specs.wr32(V, c, v), "bytes"), x) = app(app(V, "bytes"), x)
proof
  assume hx hc cl ho
  have s := apply(mp.st_out[B := app(V, "bytes"), c := c, k := 4, v := v, x := x], hx, hc, simp(), cl, ho)
  show by defs(simp(s), mallocng_specs.wr32)
qed

theorem mp.wr16_out(V, c, v, x): x in bits(64) -> c in bits(64) -> int_le(int_add(c, 2), 18446744073709551616) -> (int_le(int_add(c, 2), x) || int_lt(x, c)) ->
  app(app(mallocng_specs.wr16(V, c, v), "bytes"), x) = app(app(V, "bytes"), x)
proof
  assume hx hc cl ho
  have s := apply(mp.st_out[B := app(V, "bytes"), c := c, k := 2, v := v, x := x], hx, hc, simp(), cl, ho)
  show by defs(simp(s), mallocng_specs.wr16)
qed

theorem mp.wr16_typed(V, c, v): app(V, "bytes") in fn_space(bits(64), bits(8)) -> app(mallocng_specs.wr16(V, c, v), "bytes") in fn_space(bits(64), bits(8))
proof
  assume hb
  show by defs(simp(mp(all_elim(x86.store_typed, {app(V, "bytes")}, {c}, {2}, {v}), hb)), mallocng_specs.wr16)
qed

// a 16-bit store read back (as `mp.rd_at4`)
theorem mp.rd_at2(vm, c, v): app(vm, "bytes") in fn_space(bits(64), bits(8)) -> c in bits(64) -> v in omega ->
  gimple.bytes_at(mallocng_specs.wr16(vm, c, v), c, 2) = int_mod(v, 65536)
proof
  assume hb hc hv
  let V := fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), c, 2, v))
  have le2: x86_64_linux.le(x86_64_linux.store_le(app(vm, "bytes"), c, 2, v), c, 2) = bits_of_int(16, v) by simp(hb, hc, hv)
  have lb := all_elim(tr.le_bytes, {V}, {c}, {2})
  have w: bits_of_int(16, gimple.bytes_at(V, c, 2)) = bits_of_int(16, v) by simp(le2, lb)
  have vb: app(V, "bytes") in fn_space(bits(64), bits(8)) by simp(mp(all_elim(x86.store_typed, {app(vm, "bytes")}, {c}, {2}, {v}), hb))
  have bn bl := mp(all_elim(g.bytes_bound, {V}, {c}, {2}), vb, simp())
  have id: bits_of_int(16, gimple.bytes_at(V, c, 2)) = gimple.bytes_at(V, c, 2) by defs(simp(bn, bl), bits_of_int, pow2)
  show by defs(simp(trans(sym(id), w)), bits_of_int, pow2, mallocng_specs.wr16)
qed

// n bytes read through the specs' byte, 16-bit writes not covering them
theorem mp.wr8_rd(V, c, v, a, n): a in omega -> n in omega -> c in bits(64) -> int_le(int_add(a, n), 18446744073709551616) ->
  (int_le(int_add(c, 1), a) || int_le(int_add(a, n), c)) ->
  gimple.bytes_at(mallocng_specs.wr8(V, c, v), a, n) = gimple.bytes_at(V, a, n)
proof
  assume ha hn hc hl ho
  have cl: int_le(int_add(c, 1), 18446744073709551616) by arith(simp(hc))
  show by defs(apply(mp.rd_out[vm := V, c := c, k := 1, v := v, a := a, n := n], ha, hn, hc, simp(), hl, cl, ho), mallocng_specs.wr8)
qed

theorem mp.wr16_rd(V, c, v, a, n): a in omega -> n in omega -> c in bits(64) -> int_le(int_add(a, n), 18446744073709551616) -> int_le(int_add(c, 2), 18446744073709551616) ->
  (int_le(int_add(c, 2), a) || int_le(int_add(a, n), c)) ->
  gimple.bytes_at(mallocng_specs.wr16(V, c, v), a, n) = gimple.bytes_at(V, a, n)
proof
  assume ha hn hc hl cl ho
  show by defs(apply(mp.rd_out[vm := V, c := c, k := 2, v := v, a := a, n := n], ha, hn, hc, simp(), hl, cl, ho), mallocng_specs.wr16)
qed

// two memories with the same n bytes at a: the same read there
theorem mp.rd_same(v1, v2, a, n): a in omega -> n in omega -> int_le(int_add(a, n), 18446744073709551616) ->
  (all j. j in omega -> int_lt(j, n) -> app(app(v1, "bytes"), int_add(a, j)) = app(app(v2, "bytes"), int_add(a, j))) ->
  gimple.bytes_at(v1, a, n) = gimple.bytes_at(v2, a, n)
proof
  assume ha hn hl hs
  have pw: all j. j in omega -> int_le(0, j) -> int_lt(j, n) ->
      int_mul(app(app(v1, "bytes"), bits_add(64, a, bits_of_int(64, j))), int_pow(256, j)) = int_mul(app(app(v2, "bytes"), bits_add(64, a, bits_of_int(64, j))), int_pow(256, j)) proof
    fix j
    assume hj _ hjl
    have ba: bits_add(64, a, bits_of_int(64, j)) = int_add(a, j) by defs(arith(ha, hj, hjl, hl), bits_add, bits_of_int, pow2)
    show by simp(ba, mp(all_elim(hs, {j}), hj, hjl))
  qed
  have e := mp(int_sum_ext[a := 0, b := n, f := j. int_mul(app(app(v1, "bytes"), bits_add(64, a, bits_of_int(64, j))), int_pow(256, j)),
    g := j. int_mul(app(app(v2, "bytes"), bits_add(64, a, bits_of_int(64, j))), int_pow(256, j))], simp(), hn, pw)
  show by defs(e, gimple.bytes_at)
qed

theorem mp.wr8_typed(V, c, v): app(V, "bytes") in fn_space(bits(64), bits(8)) -> app(mallocng_specs.wr8(V, c, v), "bytes") in fn_space(bits(64), bits(8))
proof
  assume hb
  show by defs(simp(mp(all_elim(x86.store_typed, {app(V, "bytes")}, {c}, {1}, {v}), hb)), mallocng_specs.wr8)
qed

theorem mp.wr32_typed(V, c, v): app(V, "bytes") in fn_space(bits(64), bits(8)) -> app(mallocng_specs.wr32(V, c, v), "bytes") in fn_space(bits(64), bits(8))
proof
  assume hb
  show by defs(simp(mp(all_elim(x86.store_typed, {app(V, "bytes")}, {c}, {4}, {v}), hb)), mallocng_specs.wr32)
qed

theorem mp.wr8_at(V, c, v): c in bits(64) -> v in omega ->
  app(app(mallocng_specs.wr8(V, c, v), "bytes"), c) = int_mod(v, 256)
proof
  assume hc hv
  have cl: int_le(int_add(c, 1), 18446744073709551616) by arith(simp(hc))
  have s := apply(mp.st_at[B := app(V, "bytes"), c := c, k := 1, v := v, j := 0], hc, simp(), simp(), cl)
  show by defs(simp(s, hc, hv), mallocng_specs.wr8, bits_of_int, pow2)
qed

// ----------------------------------------------------------------------
//  set_size's effect read as the encoding

// set_size's effect (`set_size_vm`): the slack after the n bytes recorded
// (`size_ok`), the header byte's low 5 bits kept; nothing but the bytes
// changed, and of them only the header byte, the byte after the n and the
// count's 5 bytes before end
theorem mp.ss_post(vm, p, e, n): vm in x86_64_linux.Vm -> app(vm, "bytes") in fn_space(bits(64), bits(8)) ->
  p in bits(64) -> e in bits(64) -> n in bits(64) ->
  int_le(4, p) -> int_le(int_add(p, n), e) -> int_lt(e, int_pow(2, 63)) -> int_lt(mallocng_specs.reserved(p, e, n), int_pow(2, 31)) ->
  fn_update(mallocng_specs.set_size_vm(vm, p, e, n), "bytes", app(vm, "bytes")) = vm &&
  mallocng.size_ok(mallocng.mview(mallocng_specs.set_size_vm(vm, p, e, n), mallocng.all_bytes), p, e, n) &&
  int_mod(gimple.bytes_at(mallocng_specs.set_size_vm(vm, p, e, n), bits_sub(64, p, 3), 1), 32) = int_mod(gimple.bytes_at(vm, bits_sub(64, p, 3), 1), 32) &&
  (all a. a in omega -> int_lt(a, 18446744073709551616) -> !(a = int_sub(p, 3)) -> !(int_le(int_add(p, n), a) && int_lt(a, e)) ->
     app(app(mallocng_specs.set_size_vm(vm, p, e, n), "bytes"), bits_of_int(64, a)) = app(app(vm, "bytes"), bits_of_int(64, a)))
proof
  assume hvm hb hp he hn h4 hpe he63 hr31
  let R := int_sub(int_sub(e, p), n)
  let PS := bits_sub(64, p, 3)
  let PN := bits_add(64, p, n)
  let E4 := bits_sub(64, e, 4)
  let E5 := bits_sub(64, e, 5)
  let H := gimple.bytes_at(vm, PS, 1)
  let C := ite(int_le(5, R), 5, R)
  let Hn := int_add(int_mod(H, 32), int_mul(32, C))
  let W1 := mallocng_specs.wr8(vm, PN, 0)
  let W2 := mallocng_specs.wr32(W1, E4, R)
  let V1 := ite(int_lt(0, R), W1, vm)
  let V2 := ite(int_le(5, R), mallocng_specs.wr8(W2, E5, 0), V1)
  let V := mallocng_specs.wr8(V2, PS, Hn)
  have ev: mallocng_specs.set_size_vm(vm, p, e, n) = V by defs(simp(), mallocng_specs.set_size_vm, mallocng_specs.reserved)
  // the addresses
  have pb: int_le(0, p) && int_lt(p, 18446744073709551616) by simp(hp)
  have eb: int_le(0, e) && int_lt(e, 18446744073709551616) by simp(he)
  have nb: int_le(0, n) && int_lt(n, 18446744073709551616) by simp(hn)
  have e63: int_lt(e, 9223372036854775808) by simp(he63)
  have r31: int_lt(R, 2147483648) by simp(expand(hr31, mallocng_specs.reserved))
  have ps: PS = int_sub(p, 3) by defs(arith(pb, h4), bits_sub, pow2)
  have pn: PN = int_add(p, n) by defs(arith(pb, nb, hpe, e63), bits_add, pow2)
  have e4: E4 = int_sub(e, 4) by defs(arith(eb, pb, nb, hpe, h4), bits_sub, pow2)
  have psb: PS in bits(64) by simp(ps, pb, h4)
  have pnb: PN in bits(64) by simp(pn, pb, nb, hpe, e63)
  have e4b: E4 in bits(64) by simp(e4, eb, pb, nb, hpe, h4)
  have e4l: int_le(int_add(E4, 4), 18446744073709551616) by arith(e4, eb)
  have e5: int_le(5, R) -> E5 = int_sub(e, 5) && E5 in bits(64) proof
    assume k5
    have q: E5 = int_sub(e, 5) by defs(arith(eb, pb, nb, k5), bits_sub, pow2)
    show by taut(q, (E5 in bits(64) by simp(q, eb, pb, nb, k5)))
  qed
  have w1b := apply(mp.wr8_typed[V := vm, c := PN, v := 0], hb)
  have w2b := apply(mp.wr32_typed[V := W1, c := E4, v := R], w1b)
  have w3b := apply(mp.wr8_typed[V := W2, c := E5, v := 0], w2b)
  have v2b: app(V2, "bytes") in fn_space(bits(64), bits(8)) by simp(hb, w1b, w3b)
  // the memory before the header byte's write: the old bytes but the one
  // after the n bytes (0) and the count's (0, then the count)
  have u2: all x. x in bits(64) -> (int_lt(0, R) -> !(x = int_add(p, n))) -> (int_le(5, R) -> !(int_le(int_sub(e, 5), x) && int_lt(x, e))) ->
      app(app(V2, "bytes"), x) = app(app(vm, "bytes"), x) proof
    fix x
    assume hx hxn hxe
    have xo: x in omega by simp(hx)
    have c0: !int_lt(0, R) -> app(app(V2, "bytes"), x) = app(app(vm, "bytes"), x) proof
      assume k
      have k5: !int_le(5, R) by arith(k)
      have v2: V2 = vm by simp(k, k5)
      show by simp(v2)
    qed
    have c1: int_lt(0, R) -> !int_le(5, R) -> app(app(V2, "bytes"), x) = app(app(vm, "bytes"), x) proof
      assume k k5
      have v2: V2 = W1 by simp(k, k5)
      have o: int_le(int_add(PN, 1), x) || int_lt(x, PN) by arith(pn, xo, pb, nb, mp(hxn, k))
      have w := apply(mp.wr8_out[V := vm, c := PN, v := 0, x := x], hx, pnb, o)
      show by simp(v2, w)
    qed
    have c2: int_le(5, R) -> app(app(V2, "bytes"), x) = app(app(vm, "bytes"), x) proof
      assume k5
      have k: int_lt(0, R) by arith(k5)
      have v2: V2 = mallocng_specs.wr8(W2, E5, 0) by simp(k5)
      have q5 q5b := mp(e5, k5)
      have xe := mp(hxe, k5)
      have o5: int_le(int_add(E5, 1), x) || int_lt(x, E5) by arith(q5, xo, xe)
      have o4: int_le(int_add(E4, 4), x) || int_lt(x, E4) by arith(e4, xo, xe)
      have o1: int_le(int_add(PN, 1), x) || int_lt(x, PN) by arith(pn, xo, pb, nb, mp(hxn, k))
      have w5 := apply(mp.wr8_out[V := W2, c := E5, v := 0, x := x], hx, q5b, o5)
      have w4 := apply(mp.wr32_out[V := W1, c := E4, v := R, x := x], hx, e4b, e4l, o4)
      have w1 := apply(mp.wr8_out[V := vm, c := PN, v := 0, x := x], hx, pnb, o1)
      show by simp(v2, w5, w4, w1)
    qed
    show by taut(c0, c1, c2)
  qed
  have z1: int_lt(0, R) -> app(app(V2, "bytes"), PN) = 0 proof
    assume k
    have c1: !int_le(5, R) -> app(app(V2, "bytes"), PN) = 0 proof
      assume k5
      have v2: V2 = W1 by simp(k, k5)
      have w := apply(mp.wr8_at[V := vm, c := PN, v := 0], pnb, simp())
      show by simp(v2, w)
    qed
    have c2: int_le(5, R) -> app(app(V2, "bytes"), PN) = 0 proof
      assume k5
      have v2: V2 = mallocng_specs.wr8(W2, E5, 0) by simp(k5)
      have q5 q5b := mp(e5, k5)
      have at: PN = E5 -> app(app(V2, "bytes"), PN) = 0 proof
        assume q
        have w := apply(mp.wr8_at[V := W2, c := E5, v := 0], q5b, simp())
        show by simp(v2, q, w)
      qed
      have bel: !(PN = E5) -> app(app(V2, "bytes"), PN) = 0 proof
        assume q
        have o5: int_le(int_add(E5, 1), PN) || int_lt(PN, E5) by arith(q, pn, q5, k5)
        have o4: int_le(int_add(E4, 4), PN) || int_lt(PN, E4) by arith(pn, e4, k5)
        have w5 := apply(mp.wr8_out[V := W2, c := E5, v := 0, x := PN], pnb, q5b, o5)
        have w4 := apply(mp.wr32_out[V := W1, c := E4, v := R, x := PN], pnb, e4b, e4l, o4)
        have w1 := apply(mp.wr8_at[V := vm, c := PN, v := 0], pnb, simp())
        show by simp(v2, w5, w4, w1)
      qed
      show by taut(at, bel)
    qed
    show by taut(c1, c2)
  qed
  have z2: int_le(5, R) -> gimple.bytes_at(V2, E4, 4) = R && app(app(V2, "bytes"), E5) = 0 proof
    assume k5
    have v2: V2 = mallocng_specs.wr8(W2, E5, 0) by simp(k5)
    have q5 q5b := mp(e5, k5)
    have e5l: int_le(int_add(E5, 1), 18446744073709551616) by arith(q5, eb)
    have e4o: E4 in omega by simp(e4b)
    have r1 := apply(mp.rd_out[vm := W2, c := E5, k := 1, v := 0, a := E4, n := 4], e4o, simp(), q5b, simp(), e4l, e5l, (int_le(int_add(E5, 1), E4) || int_le(int_add(E4, 4), E5) by arith(q5, e4)))
    have ro: R in omega by arith(k5)
    have r2 := apply(mp.rd_at4[vm := W1, c := E4, v := R], w1b, e4b, ro)
    have rm: int_mod(R, 4294967296) = R by arith(k5, r31)
    have w := apply(mp.wr8_at[V := W2, c := E5, v := 0], q5b, simp())
    have f8: mallocng_specs.wr8(W2, E5, 0) = fn_update(W2, "bytes", x86_64_linux.store_le(app(W2, "bytes"), E5, 1, 0)) by defs(simp(), mallocng_specs.wr8)
    have f32: W2 = fn_update(W1, "bytes", x86_64_linux.store_le(app(W1, "bytes"), E4, 4, R)) by defs(simp(), mallocng_specs.wr32)
    have a0 := subst({y. gimple.bytes_at(V2, E4, 4) = gimple.bytes_at(y, E4, 4)}, v2, refl({gimple.bytes_at(V2, E4, 4)}))
    have a2 := subst({y. gimple.bytes_at(V2, E4, 4) = gimple.bytes_at(y, E4, 4)}, f8, a0)
    have a3 := subst({y. gimple.bytes_at(V2, E4, 4) = gimple.bytes_at(y, E4, 4)}, f32, trans(a2, r1))
    have a1: gimple.bytes_at(V2, E4, 4) = R := trans(a3, trans(r2, rm))
    have b0 := subst({y. app(app(V2, "bytes"), E5) = app(app(y, "bytes"), E5)}, v2, refl({app(app(V2, "bytes"), E5)}))
    show by taut(a1, trans(trans(b0, w), (int_mod(0, 256) = 0 by simp())))
  qed
  // the header byte, written last: its old low 5 bits, the count above
  have hbo hbl := mp(all_elim(g.bytes_bound, {vm}, {PS}, {1}), hb, simp())
  have _ hmo := apply(div_nat[x := H, m := 32], hbo, simp())
  have hml: int_lt(int_mod(H, 32), 32) by arith(hmo)
  have ro: int_le(0, R) by arith(hpe)
  have c5: int_le(5, R) -> C = 5 by simp()
  have cr: !int_le(5, R) -> C = R by simp()
  have co: C in omega && int_le(C, 5) proof
    have a: int_le(5, R) -> C in omega && int_le(C, 5) proof
      assume k
      show by simp(mp(c5, k))
    qed
    have b: !int_le(5, R) -> C in omega && int_le(C, 5) proof
      assume k
      have rl: int_le(R, 5) by arith(k)
      show by simp(mp(cr, k), ro, rl, pb, eb, nb)
    qed
    show by taut(a, b)
  qed
  have hnm: Hn in omega by simp(co, hmo)
  have hno: Hn in omega && int_lt(Hn, 192) by taut(hnm, (int_lt(Hn, 192) by arith(co, hmo, hml)))
  have du dm := apply(div_unique[x := Hn, m := 32, q := C, r := int_mod(H, 32)], hno, co, hmo, simp(), hml, (Hn = int_add(int_mul(32, C), int_mod(H, 32)) by arith()))
  have pso: PS in omega by simp(psb)
  have fv: V = fn_update(V2, "bytes", x86_64_linux.store_le(app(V2, "bytes"), PS, 1, Hn)) by defs(simp(), mallocng_specs.wr8)
  have vb := apply(mp.wr8_typed[V := V2, c := PS, v := Hn], v2b)
  have vat := apply(mp.wr8_at[V := V2, c := PS, v := Hn], psb, hno)
  have hm256: int_mod(Hn, 256) = Hn by arith(hno)
  have vout: all x. x in bits(64) -> !(x = PS) -> app(app(V, "bytes"), x) = app(app(V2, "bytes"), x) proof
    fix x
    assume hx hq
    have xo: x in omega by simp(hx)
    have o: int_le(int_add(PS, 1), x) || int_lt(x, PS) by arith(xo, pso, hq)
    show := apply(mp.wr8_out[V := V2, c := PS, v := Hn, x := x], hx, psb, o)
  qed
  // the view of the bytes
  let M := mallocng.mview(V, mallocng.all_bytes)
  have inall: all a. a in omega -> a in mallocng.all_bytes proof
    fix a
    assume ha
    show by defs(simp(ha), mallocng.all_bytes)
  qed
  have bv: all a. a in omega -> mallocng.b8(M, a) = app(app(V, "bytes"), bits_of_int(64, a)) proof
    fix a
    assume ha
    have b _ := apply(mp.b8_view[vm := V, fp := mallocng.all_bytes, a := a], vb, ha, mp(all_elim(inall, {a}), ha))
    show b
  qed
  have p3o: int_sub(p, 3) in omega by arith(pb, h4)
  have bps: bits_of_int(64, int_sub(p, 3)) = PS by defs(arith(pb, h4, ps), bits_of_int, pow2)
  have b8h: mallocng.b8(M, int_sub(p, 3)) = Hn := trans(mp(all_elim(bv, {int_sub(p, 3)}), p3o), trans(subst({y. app(app(V, "bytes"), bits_of_int(64, int_sub(p, 3))) = app(app(V, "bytes"), y)}, bps, refl({app(app(V, "bytes"), bits_of_int(64, int_sub(p, 3)))})), trans(vat, hm256)))
  have s5: int_le(5, R) -> (int_div(mallocng.b8(M, int_sub(p, 3)), 32) = 5 && mallocng.rd(M, int_sub(e, 4), 4) = R) && mallocng.b8(M, int_sub(e, 5)) = 0 proof
    assume k5
    have q5 q5b := mp(e5, k5)
    have zr ze := mp(z2, k5)
    have d5: int_div(mallocng.b8(M, int_sub(p, 3)), 32) = 5 by simp(b8h, du, mp(c5, k5))
    have e4o: int_sub(e, 4) in omega by arith(eb, pb, nb, hpe, h4)
    have ie: all i. i in omega -> int_lt(i, 4) -> int_add(int_sub(e, 4), i) in mallocng.all_bytes proof
      fix i
      assume hi _
      show := mp(all_elim(inall, {int_add(int_sub(e, 4), i)}), (int_add(int_sub(e, 4), i) in omega by simp(e4o, hi)))
    qed
    have vr := apply(mp.view_read[vm := V, fp := mallocng.all_bytes, a := int_sub(e, 4), n := 4], e4o, simp(), simp(), ie)
    have ro4 := apply(mp.rd_out[vm := V2, c := PS, k := 1, v := Hn, a := E4, n := 4], (E4 in omega by simp(e4b)), simp(), psb, simp(), e4l, (int_le(int_add(PS, 1), 18446744073709551616) by arith(pso, psb)), (int_le(int_add(PS, 1), E4) || int_le(int_add(E4, 4), PS) by arith(ps, e4, k5, nb)))
    have rr: mallocng.rd(M, int_sub(e, 4), 4) = R := trans(sym(vr), trans(subst({y. gimple.bytes_at(V, int_sub(e, 4), 4) = gimple.bytes_at(V, y, 4)}, sym(e4), refl({gimple.bytes_at(V, int_sub(e, 4), 4)})),
      trans(subst({y. gimple.bytes_at(V, E4, 4) = gimple.bytes_at(y, E4, 4)}, fv, refl({gimple.bytes_at(V, E4, 4)})), trans(ro4, zr))))
    have e5o: int_sub(e, 5) in omega by arith(eb, pb, nb, k5)
    have b5: bits_of_int(64, int_sub(e, 5)) = E5 by defs(arith(eb, pb, nb, k5, q5), bits_of_int, pow2)
    have z5: mallocng.b8(M, int_sub(e, 5)) = 0 := trans(mp(all_elim(bv, {int_sub(e, 5)}), e5o), trans(subst({y. app(app(V, "bytes"), bits_of_int(64, int_sub(e, 5))) = app(app(V, "bytes"), y)}, b5, refl({app(app(V, "bytes"), bits_of_int(64, int_sub(e, 5)))})),
      trans(mp(all_elim(vout, {E5}), q5b, (!(E5 = PS) by arith(q5, ps, k5, nb))), ze)))
    show by taut(d5, rr, z5)
  qed
  have s4: int_lt(R, 5) -> int_div(mallocng.b8(M, int_sub(p, 3)), 32) = R proof
    assume k
    show by simp(b8h, du, mp(cr, (!int_le(5, R) by arith(k))))
  qed
  have s0: int_lt(0, R) -> mallocng.b8(M, int_add(p, n)) = 0 proof
    assume k
    have pno: int_add(p, n) in omega by arith(pb, nb)
    have bpn: bits_of_int(64, int_add(p, n)) = PN by defs(arith(pb, nb, hpe, e63, pn), bits_of_int, pow2)
    show := trans(mp(all_elim(bv, {int_add(p, n)}), pno), trans(subst({y. app(app(V, "bytes"), bits_of_int(64, int_add(p, n))) = app(app(V, "bytes"), y)}, bpn, refl({app(app(V, "bytes"), bits_of_int(64, int_add(p, n)))})),
      trans(mp(all_elim(vout, {PN}), pnb, (!(PN = PS) by arith(pn, ps, nb))), mp(z1, k))))
  qed
  have so: mallocng.size_ok(M, p, e, n) by defs(taut(s5, s4, s0), mallocng.size_ok)
  // the header byte's low 5 bits
  have r1 := apply(mp.rd_at1[vm := V2, c := PS, v := Hn], psb, hno)
  have hk: int_mod(gimple.bytes_at(V, PS, 1), 32) = int_mod(H, 32) := trans(subst({y. int_mod(gimple.bytes_at(V, PS, 1), 32) = int_mod(gimple.bytes_at(y, PS, 1), 32)}, fv, refl({int_mod(gimple.bytes_at(V, PS, 1), 32)})),
    trans(subst({y. int_mod(gimple.bytes_at(fn_update(V2, "bytes", x86_64_linux.store_le(app(V2, "bytes"), PS, 1, Hn)), PS, 1), 32) = int_mod(y, 32)}, trans(r1, hm256), refl({int_mod(gimple.bytes_at(fn_update(V2, "bytes", x86_64_linux.store_le(app(V2, "bytes"), PS, 1, Hn)), PS, 1), 32)})), dm))
  // the other bytes
  have un: all a. a in omega -> int_lt(a, 18446744073709551616) -> !(a = int_sub(p, 3)) -> !(int_le(int_add(p, n), a) && int_lt(a, e)) ->
      app(app(V, "bytes"), bits_of_int(64, a)) = app(app(vm, "bytes"), bits_of_int(64, a)) proof
    fix a
    assume ha hl hq1 hq2
    have ba: bits_of_int(64, a) = a by defs(arith(ha, hl), bits_of_int, pow2)
    have ab: a in bits(64) by simp(ha, hl)
    have v1 := mp(all_elim(vout, {a}), ab, (!(a = PS) by arith(ha, ps, hq1)))
    have n1: int_lt(0, R) -> !(a = int_add(p, n)) proof
      assume k
      show by arith(k, hq2, ha, pb, nb)
    qed
    have n2: int_le(5, R) -> !(int_le(int_sub(e, 5), a) && int_lt(a, e)) proof
      assume k
      show by arith(k, hq2, ha, pb, nb)
    qed
    have v2 := mp(all_elim(u2, {a}), ab, n1, n2)
    show by simp(ba, trans(v1, v2))
  qed
  // only the bytes changed
  have vs := apply(fn_update_same[f := vm, k := "bytes"], simp(hvm), simp(hvm))
  have fu2: fn_update(V2, "bytes", app(vm, "bytes")) = vm by defs(simp(vs, fn_update_twice), mallocng_specs.wr8, mallocng_specs.wr32)
  have fu: fn_update(V, "bytes", app(vm, "bytes")) = vm := trans(subst({y. fn_update(V, "bytes", app(vm, "bytes")) = fn_update(y, "bytes", app(vm, "bytes"))}, fv, refl({fn_update(V, "bytes", app(vm, "bytes"))})), trans(fn_update_twice[f := V2, k := "bytes", a := x86_64_linux.store_le(app(V2, "bytes"), PS, 1, Hn), b := app(vm, "bytes")], fu2))
  show by simp(ev, fu, so, hk, un)
qed

// ----------------------------------------------------------------------
//  enframe's conditions: slot i of the group g, the one reserved, its bytes
//  accessible (`slot_rw`), room for n bytes: they hold; the stride, the
//  slot's start, the mem word the group's; its check byte and end byte 0

theorem mp.ef_pre(c, A, vm, b, objs, fs, g, i, n): c in mallocng.Cfg -> app(c, "sct") = c_src_malloc_mallocng_malloc.__malloc_size_classes ->
  A in univ(1) -> A in mallocng.Abs -> app(vm, "bytes") in fn_space(bits(64), bits(8)) -> g in bits(64) -> i in omega -> n in bits(64) ->
  mallocng.holds_in(c, A, vm, b) -> abi.thread_ok(vm, fs) -> mallocng.is_used(A, g) -> mallocng.reserved_only(A, g, i) ->
  mallocng.slot_rw(vm, app(app(A, "metas"), g), i) ->
  int_le(int_add(n, mallocng.IB), mallocng.stride(app(app(A, "metas"), g))) -> int_lt(mallocng.stride(app(app(A, "metas"), g)), int_pow(2, 31)) ->
  (int_le(int_add(fs, 8), int_sub(mallocng.slot_start(app(app(A, "metas"), g), i), mallocng.IB)) || int_le(mallocng.slot_end(app(app(A, "metas"), g), i), fs)) ->
  mallocng_specs.enframe_pre(vm, objs, fs, c_src_malloc_mallocng_malloc.__malloc_size_classes, g, i, n) &&
  mallocng_specs.stride_w(vm, g) = mallocng.stride(app(app(A, "metas"), g)) &&
  mallocng_specs.eslot(vm, g, i) = mallocng.slot_start(app(app(A, "metas"), g), i) &&
  mallocng_specs.rd64(vm, bits_add(64, g, 16)) = app(app(app(A, "metas"), g), "mem") &&
  int_lt(i, 32) && int_le(i, app(app(app(A, "metas"), g), "last_idx")) &&
  app(app(vm, "bytes"), bits_of_int(64, int_sub(mallocng.slot_start(app(app(A, "metas"), g), i), mallocng.IB))) = 0 &&
  app(app(vm, "bytes"), bits_of_int(64, mallocng.slot_end(app(app(A, "metas"), g), i))) = 0
proof
  assume hc hsct hu ha hvb hg hi hn hh hth hus hro hrw hns hs31 hfs
  let V := app(app(A, "metas"), g)
  let FP := mallocng.held(c, A, b)
  let M := mallocng.mview(vm, FP)
  let S := mallocng.stride(V)
  let SCT := c_src_malloc_mallocng_malloc.__malloc_size_classes
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {uo = used} := expand(H, mallocng.holds)
  have gok := apply(mp.used_group, uo, hus)
  have {mim, hd = hdr, gl = nslots} := expand(gok, mallocng.group_ok)
  have go: g in omega by simp(hg)
  have vt: V in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := app(A, "metas"), x := g], simp(ha), go)
  have vo: app(V, "mem") in omega && app(V, "maplen") in omega && app(V, "last_idx") in omega by simp(vt)
  have vme vml vli := vo
  have sn := apply(mp.stride_nat, ha, go, gok)
  have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
  have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
  have il _ _ := expand(hro, mallocng.reserved_only)
  have ile: int_le(i, app(V, "last_idx")) by arith(gl, il)
  have lt32: int_lt(app(V, "last_idx"), 32) by simp(expand(mim, mallocng.meta_in_memory))
  have i32: int_lt(i, 32) by arith(ile, lt32)
  have ss: mallocng.slot_start(V, i) = int_add(int_add(app(V, "mem"), 16), int_mul(S, i)) by defs(arith(cu), mallocng.slot_start, mallocng.storage)
  have se: mallocng.slot_end(V, i) = int_sub(int_add(mallocng.slot_start(V, i), S), 4) by defs(arith(ci), mallocng.slot_end)
  have m0: int_mul(S, i) in omega by simp(sn, hi)
  // get_stride's conditions; the stride the group's
  have gsp sw _ := apply(mp.gs_pre[c := c, A := A, vm := vm, b := b, objs := objs, g := g], hc, hu, ha, hg, hh, hus)
  have gsp2 := rewrite(hsct, gsp)
  have gnz g40 _ _ := expand(gsp, mallocng_specs.get_stride_pre)
  // the meta's bytes; its mem word
  have _ g24 inr := apply(mp.meta_mem, hc, hu, ha, hh, hus)
  have m16: all j. j in omega -> int_lt(j, 8) -> int_add(int_add(g, 16), j) in FP && mallocng.m_mapped(M, int_add(int_add(g, 16), j)) &&
      app(app(snd(mallocng.pg(M, int_add(int_add(g, 16), j))), "prot"), "r") && !(app(snd(mallocng.pg(M, int_add(int_add(g, 16), j))), "kind") = 2) proof
    fix j
    assume hj hjl
    have f rw k := mp(all_elim(inr, {int_add(int_add(g, 16), j)}), (int_add(int_add(g, 16), j) in omega by simp(go, hj)), arith(hj), arith(hj, hjl))
    show by taut(f, expand(rw, mallocng.m_rw), k)
  qed
  have u16 := apply(mp.view_usable[vm := vm, fp := FP, objs := objs, a := int_add(g, 16), n := 8], (int_add(g, 16) in omega by simp(go)), m16)
  have in16: all j. j in omega -> int_lt(j, 8) -> int_add(int_add(g, 16), j) in FP proof
    fix j
    assume hj hjl
    have f _ _ _ := mp(all_elim(m16, {j}), hj, hjl)
    show f
  qed
  have vr := apply(mp.view_read[vm := vm, fp := FP, a := int_add(g, 16), n := 8], (int_add(g, 16) in omega by simp(go)), simp(), simp(), in16)
  have _ _ mi3 .. := expand(mim, mallocng.meta_in_memory)
  have memv: gimple.bytes_at(vm, int_add(g, 16), 8) = app(V, "mem") := trans(vr, mi3)
  have b16: bits_add(64, g, 16) = int_add(g, 16) by defs(arith(go, g40), bits_add, pow2)
  have bbo bbl := mp(all_elim(g.bytes_bound, {vm}, {int_add(g, 16)}, {8}), hvb, simp())
  have p8: int_pow(256, 8) = 18446744073709551616 by simp()
  have mb: int_lt(app(V, "mem"), 18446744073709551616) by arith(memv, bbl, p8)
  have r1 := all_elim(ms.v_rd64, {vm}, {bits_add(64, g, 16)})
  have bm: bits_add(64, app(V, "mem"), 0) = app(V, "mem") by defs(arith(vme, mb), bits_add, pow2)
  have rdm: mallocng_specs.rd64(vm, bits_add(64, g, 16)) = app(V, "mem") by simp(r1, b16, memv, bm)
  have esl: mallocng_specs.eslot(vm, g, i) = mallocng.slot_start(V, i) by defs(simp(rdm, sw, cu), mallocng_specs.eslot, mallocng.slot_start, mallocng.storage)
  let E := mallocng_specs.eslot(vm, g, i)
  let SW := mallocng_specs.stride_w(vm, g)
  have _ _ mpos := hd
  have c3: int_lt(i, int_pow(2, 31)) by simp(i32)
  have c4: int_le(int_add(n, mallocng.IB), SW) := rewrite(sym(sw), hns)
  have c5: int_lt(SW, int_pow(2, 31)) := rewrite(sym(sw), hs31)
  have c6: int_lt(mallocng.IB, E) by arith(esl, ss, ci, mpos, m0)
  // the slot's bytes: accessible, below the task size
  have chunk: all a. a in omega -> int_le(int_sub(mallocng.slot_start(V, i), mallocng.IB), a) -> int_lt(a, mallocng.slot_end(V, i)) ->
      mallocng.m_rw(mallocng.mview(vm, mallocng.all_bytes), a) && !(app(snd(mallocng.pg(mallocng.mview(vm, mallocng.all_bytes), a)), "kind") = 2) proof
    fix a
    assume ha2 h1 h2
    show := mp(all_elim(expand(hrw, mallocng.slot_rw), {a}), ha2, conj(h1, h2))
  qed
  have s4: int_le(4, S) by arith(hns, ci, (n in omega by simp(hn)))
  have lst: int_sub(mallocng.slot_end(V, i), 1) in omega by arith(se, ss, vme, m0, s4)
  have lrw _ := mp(all_elim(chunk, {int_sub(mallocng.slot_end(V, i), 1)}), lst, arith(se, ci, s4), arith())
  have lmp _ _ := expand(lrw, mallocng.m_rw)
  have ltk _ := expand(lmp, mallocng.m_mapped)
  have tk: int_lt(int_div(int_sub(mallocng.slot_end(V, i), 1), 4096), 34359738367) by simp(expand(ltk, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))
  have c7: int_lt(int_add(E, SW), int_pow(2, 63)) by arith(esl, sw, se, ss, vme, m0, sn, tk, (int_pow(2, 63) = 9223372036854775808 by simp()))
  have sso: mallocng.slot_start(V, i) in omega by arith(ss, vme, m0)
  // the meta's mem word apart from the slot: the meta's bytes are the
  // allocator's, the slot's interior is not
  have c8: int_le(int_add(g, 24), int_sub(E, mallocng.IB)) || int_le(int_add(int_sub(E, mallocng.IB), SW), int_add(g, 16)) proof
    // (a byte both the meta's and the slot interior's: none)
    have none: all X. X in omega -> int_le(g, X) -> int_lt(X, int_add(g, 40)) -> int_lt(int_sub(mallocng.slot_start(V, i), mallocng.IB), X) -> int_lt(X, mallocng.slot_end(V, i)) -> false proof
      fix X
      assume x1 x2 x3 x4 x5
      have fh _ _ := mp(all_elim(inr, {X}), x1, x2, x3)
      have {f = fp} := apply(mp.held_fp, fh)
      have isl: mallocng.in_slot(V, i, X) by defs(taut(x4, x5), mallocng.in_slot)
      have nf := apply(mp.int_nfp[c := c, A := A, b := b, g := g, i := i, a := X], go, hi, hus, hro, isl)
      show by taut(f, nf)
    qed
    have k: !int_le(int_add(g, 24), int_sub(E, mallocng.IB)) -> !int_le(int_add(int_sub(E, mallocng.IB), SW), int_add(g, 16)) -> false proof
      assume k1 k2
      have ka: int_le(int_add(g, 16), int_sub(mallocng.slot_start(V, i), 3)) -> false proof
        assume h
        let X := int_sub(mallocng.slot_start(V, i), 3)
        show := mp(all_elim(none, {X}), arith(h, go), arith(h, go), arith(k1, esl, ci, sso), arith(ci, sso), arith(se, s4, sso, sn))
      qed
      have kb: !int_le(int_add(g, 16), int_sub(mallocng.slot_start(V, i), 3)) -> false proof
        assume h
        let X := int_add(g, 16)
        show := mp(all_elim(none, {X}), simp(go), arith(go), arith(go), arith(h, ci, sso, go), arith(k2, esl, sw, se, ci, sso, sn, go))
      qed
      show by taut(ka, kb)
    qed
    show by taut(k)
  qed
  have c9: int_le(int_add(fs, 8), int_sub(E, mallocng.IB)) || int_le(int_add(int_sub(E, mallocng.IB), SW), fs) by arith(hfs, esl, sw, se, ci, sso, sn)
  // GIMPLE may read and write the slot's bytes
  have cb: all j. j in omega -> int_lt(j, SW) -> int_add(int_sub(E, mallocng.IB), j) in mallocng.all_bytes &&
      mallocng.m_rw(mallocng.mview(vm, mallocng.all_bytes), int_add(int_sub(E, mallocng.IB), j)) &&
      !(app(snd(mallocng.pg(mallocng.mview(vm, mallocng.all_bytes), int_add(int_sub(E, mallocng.IB), j))), "kind") = 2) proof
    fix j
    assume hj hjl
    have ao: int_add(int_sub(E, mallocng.IB), j) in omega by arith(c6, hj)
    have r k := mp(all_elim(chunk, {int_add(int_sub(E, mallocng.IB), j)}), ao, arith(esl, hj, sso), arith(esl, sw, se, ci, hjl, sso, sn))
    show by taut(r, k, (int_add(int_sub(E, mallocng.IB), j) in mallocng.all_bytes by defs(simp(ao), mallocng.all_bytes)))
  qed
  have cbr: all j. j in omega -> int_lt(j, SW) -> int_add(int_sub(E, mallocng.IB), j) in mallocng.all_bytes && mallocng.m_mapped(mallocng.mview(vm, mallocng.all_bytes), int_add(int_sub(E, mallocng.IB), j)) &&
      app(app(snd(mallocng.pg(mallocng.mview(vm, mallocng.all_bytes), int_add(int_sub(E, mallocng.IB), j))), "prot"), "r") && !(app(snd(mallocng.pg(mallocng.mview(vm, mallocng.all_bytes), int_add(int_sub(E, mallocng.IB), j))), "kind") = 2) proof
    fix j
    assume hj hjl
    have a r k := mp(all_elim(cb, {j}), hj, hjl)
    show by taut(a, expand(r, mallocng.m_rw), k)
  qed
  have cbw: all j. j in omega -> int_lt(j, SW) -> int_add(int_sub(E, mallocng.IB), j) in mallocng.all_bytes && mallocng.m_mapped(mallocng.mview(vm, mallocng.all_bytes), int_add(int_sub(E, mallocng.IB), j)) &&
      app(app(snd(mallocng.pg(mallocng.mview(vm, mallocng.all_bytes), int_add(int_sub(E, mallocng.IB), j))), "prot"), "w") && !(app(snd(mallocng.pg(mallocng.mview(vm, mallocng.all_bytes), int_add(int_sub(E, mallocng.IB), j))), "kind") = 2) proof
    fix j
    assume hj hjl
    have a r k := mp(all_elim(cb, {j}), hj, hjl)
    show by taut(a, expand(r, mallocng.m_rw), k)
  qed
  have eo4: int_sub(E, mallocng.IB) in omega by arith(c6)
  have c10 := apply(mp.view_usable[vm := vm, fp := mallocng.all_bytes, objs := objs, a := int_sub(E, mallocng.IB), n := SW], eo4, cbr)
  have c11 := apply(mp.view_usable_w[vm := vm, fp := mallocng.all_bytes, objs := objs, a := int_sub(E, mallocng.IB), n := SW], eo4, cbw)
  // the check byte, the end byte: the allocator's, 0
  have nr0 := apply(mp.ronly_out[A := A, g := g, i := i, a := int_sub(mallocng.slot_start(V, i), mallocng.IB)], hro, (!mallocng.in_slot(V, i, int_sub(mallocng.slot_start(V, i), mallocng.IB)) by defs(arith(), mallocng.in_slot)))
  have k0f k0z := apply(mp.chk_fp[c := c, A := A, vm := vm, b := b, g := g, j := i], hc, hu, ha, hi, hh, hus, arith(ile), nr0)
  have x0o: int_sub(mallocng.slot_start(V, i), mallocng.IB) in omega by arith(ss, ci, vme, m0)
  have k0v _ := apply(mp.b8_view[vm := vm, fp := FP, a := int_sub(mallocng.slot_start(V, i), mallocng.IB)], hvb, x0o, k0f)
  have chk0: app(app(vm, "bytes"), bits_of_int(64, int_sub(mallocng.slot_start(V, i), mallocng.IB))) = 0 := trans(sym(k0v), k0z)
  have c12: gimple.bytes_at(vm, bits_of_int(64, int_sub(E, mallocng.IB)), 1) = 0 by defs(simp(esl, chk0), gimple.bytes_at)
  have sn1: mallocng.slot_start(V, int_add(i, 1)) = int_add(mallocng.slot_start(V, i), S) by defs(simp(sn, hi), mallocng.slot_start, mallocng.storage)
  have ee: int_sub(mallocng.slot_start(V, int_add(i, 1)), mallocng.IB) = mallocng.slot_end(V, i) by arith(sn1, se, ci)
  have nr1 := apply(mp.ronly_out[A := A, g := g, i := i, a := int_sub(mallocng.slot_start(V, int_add(i, 1)), mallocng.IB)], hro,
    (!mallocng.in_slot(V, i, int_sub(mallocng.slot_start(V, int_add(i, 1)), mallocng.IB)) by defs(arith(ee), mallocng.in_slot)))
  have k1f k1z := apply(mp.chk_fp[c := c, A := A, vm := vm, b := b, g := g, j := int_add(i, 1)], hc, hu, ha, simp(hi), hh, hus, arith(ile), nr1)
  have x1o: int_sub(mallocng.slot_start(V, int_add(i, 1)), mallocng.IB) in omega by arith(ee, lst)
  have k1v _ := apply(mp.b8_view[vm := vm, fp := FP, a := int_sub(mallocng.slot_start(V, int_add(i, 1)), mallocng.IB)], hvb, x1o, k1f)
  have end0 := rewrite(ee, trans(sym(k1v), k1z))
  have pre: mallocng_specs.enframe_pre(vm, objs, fs, SCT, g, i, n)
    by defs(taut(gsp2, u16, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, hth), mallocng_specs.enframe_pre)
  show by taut(pre, sw, esl, rdm, i32, ile, chk0, end0)
qed

// ----------------------------------------------------------------------
//  enframe's frame: its header writes (`enframe_hdr`), then set_size's

// the header writes for p in slot i (start SS), the group's storage ST:
// below SS - 3 and from p on the old bytes; p's index at p - 3, its offset
// from the storage at p - 2; past the slot's start the slot's offset record
// at SS - 2, its tag at SS - 3 and p's check byte at p - 4
theorem mp.ef_hdr(vm, g, i, P, SS, ST): app(vm, "bytes") in fn_space(bits(64), bits(8)) -> g in bits(64) -> i in omega -> int_lt(i, 32) -> P in bits(64) ->
  mallocng_specs.eslot(vm, g, i) = SS -> int_add(mallocng_specs.rd64(vm, bits_add(64, g, 16)), mallocng.UNIT) = ST -> ST in omega ->
  int_le(16, SS) -> int_le(SS, P) -> int_mod(int_sub(P, SS), 16) = 0 -> int_lt(P, int_add(SS, 4096)) -> int_lt(P, 9223372036854775808) ->
  int_le(ST, P) -> int_lt(int_div(int_sub(P, ST), 16), 65536) ->
  (all x. x in omega -> int_lt(x, 18446744073709551616) -> (int_lt(x, int_sub(SS, 3)) || int_le(P, x)) ->
     app(app(mallocng_specs.enframe_hdr(vm, g, i, P), "bytes"), x) = app(app(vm, "bytes"), x)) &&
  app(app(mallocng_specs.enframe_hdr(vm, g, i, P), "bytes"), int_sub(P, 3)) = i &&
  gimple.bytes_at(mallocng_specs.enframe_hdr(vm, g, i, P), int_sub(P, 2), 2) = int_div(int_sub(P, ST), 16) &&
  (int_lt(SS, P) -> gimple.bytes_at(mallocng_specs.enframe_hdr(vm, g, i, P), int_sub(SS, 2), 2) = int_div(int_sub(P, SS), 16) &&
     app(app(mallocng_specs.enframe_hdr(vm, g, i, P), "bytes"), int_sub(SS, 3)) = 224 &&
     app(app(mallocng_specs.enframe_hdr(vm, g, i, P), "bytes"), int_sub(P, 4)) = 0) &&
  (all X. fn_update(mallocng_specs.enframe_hdr(vm, g, i, P), "bytes", X) = fn_update(vm, "bytes", X))
proof
  assume hb hg hi i32 hP esl est sto s16 hsp hal h4k p63 hst o16
  let E := mallocng_specs.eslot(vm, g, i)
  let Z := mallocng_specs.wr16(vm, bits_of_int(64, int_sub(E, 2)), int_div(int_sub(P, E), mallocng.UNIT))
  let Y := mallocng_specs.wr8(Z, bits_of_int(64, int_sub(E, 3)), int_mul(7, 32))
  let V1 := ite(int_lt(E, P), mallocng_specs.wr8(Y, bits_sub(64, P, 4), 0), vm)
  let WO := int_mod(int_div(int_sub(P, int_add(mallocng_specs.rd64(vm, bits_add(64, g, 16)), mallocng.UNIT)), mallocng.UNIT), int_pow(2, 16))
  let X1 := mallocng_specs.wr16(V1, bits_sub(64, P, 2), WO)
  let H := mallocng_specs.wr8(X1, bits_sub(64, P, 3), int_mod(i, 256))
  have eh: mallocng_specs.enframe_hdr(vm, g, i, P) = H by defs(simp(), mallocng_specs.enframe_hdr)
  have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
  have pb: int_le(0, P) && int_lt(P, 18446744073709551616) by simp(hP)
  // the addresses
  have p3: bits_sub(64, P, 3) = int_sub(P, 3) by defs(arith(pb, s16, hsp), bits_sub, pow2)
  have p2: bits_sub(64, P, 2) = int_sub(P, 2) by defs(arith(pb, s16, hsp), bits_sub, pow2)
  have p4: bits_sub(64, P, 4) = int_sub(P, 4) by defs(arith(pb, s16, hsp), bits_sub, pow2)
  have s2: bits_of_int(64, int_sub(E, 2)) = int_sub(SS, 2) by defs(arith(esl, s16, hsp, p63), bits_of_int, pow2)
  have s3: bits_of_int(64, int_sub(E, 3)) = int_sub(SS, 3) by defs(arith(esl, s16, hsp, p63), bits_of_int, pow2)
  have p3b: int_sub(P, 3) in bits(64) by simp(pb, s16, hsp)
  have p2b: int_sub(P, 2) in bits(64) by simp(pb, s16, hsp)
  have p4b: int_sub(P, 4) in bits(64) by simp(pb, s16, hsp)
  have s2b: int_sub(SS, 2) in bits(64) by simp(pb, s16, hsp)
  have s3b: int_sub(SS, 3) in bits(64) by simp(pb, s16, hsp)
  have zb := apply(mp.wr16_typed[V := vm, c := bits_of_int(64, int_sub(E, 2)), v := int_div(int_sub(P, E), mallocng.UNIT)], hb)
  have yb := apply(mp.wr8_typed[V := Z, c := bits_of_int(64, int_sub(E, 3)), v := int_mul(7, 32)], zb)
  have v1b: app(V1, "bytes") in fn_space(bits(64), bits(8)) by simp(hb, apply(mp.wr8_typed[V := Y, c := bits_sub(64, P, 4), v := 0], yb))
  have x1b := apply(mp.wr16_typed[V := V1, c := bits_sub(64, P, 2), v := WO], v1b)
  // the old bytes, outside [SS - 3, P)
  have h1: all x. x in omega -> int_lt(x, 18446744073709551616) -> (int_lt(x, int_sub(SS, 3)) || int_le(P, x)) ->
      app(app(H, "bytes"), x) = app(app(vm, "bytes"), x) proof
    fix x
    assume hx hxl ho
    have xb: x in bits(64) by simp(hx, hxl)
    have a1 := apply(mp.wr8_out[V := X1, c := bits_sub(64, P, 3), v := int_mod(i, 256), x := x], xb, rewrite(sym(p3), p3b), (int_le(int_add(bits_sub(64, P, 3), 1), x) || int_lt(x, bits_sub(64, P, 3)) by arith(p3, ho, hsp, s16, hx)))
    have a2 := apply(mp.wr16_out[V := V1, c := bits_sub(64, P, 2), v := WO, x := x], xb, rewrite(sym(p2), p2b), arith(p2, pb, hsp, s16), (int_le(int_add(bits_sub(64, P, 2), 2), x) || int_lt(x, bits_sub(64, P, 2)) by arith(p2, ho, hsp, s16, hx)))
    have c0: !int_lt(E, P) -> app(app(V1, "bytes"), x) = app(app(vm, "bytes"), x) by simp()
    have c1: int_lt(E, P) -> app(app(V1, "bytes"), x) = app(app(vm, "bytes"), x) proof
      assume k
      have v1e: V1 = mallocng_specs.wr8(Y, bits_sub(64, P, 4), 0) by simp(k)
      have pg: int_le(int_add(SS, 16), P) by arith(k, esl, hal, hsp)
      have b1 := apply(mp.wr8_out[V := Y, c := bits_sub(64, P, 4), v := 0, x := x], xb, rewrite(sym(p4), p4b), (int_le(int_add(bits_sub(64, P, 4), 1), x) || int_lt(x, bits_sub(64, P, 4)) by arith(p4, ho, pg, hx)))
      have b2 := apply(mp.wr8_out[V := Z, c := bits_of_int(64, int_sub(E, 3)), v := int_mul(7, 32), x := x], xb, rewrite(sym(s3), s3b), (int_le(int_add(bits_of_int(64, int_sub(E, 3)), 1), x) || int_lt(x, bits_of_int(64, int_sub(E, 3))) by arith(s3, ho, pg, hx)))
      have b3 := apply(mp.wr16_out[V := vm, c := bits_of_int(64, int_sub(E, 2)), v := int_div(int_sub(P, E), mallocng.UNIT), x := x], xb, rewrite(sym(s2), s2b), arith(s2, pg, pb), (int_le(int_add(bits_of_int(64, int_sub(E, 2)), 2), x) || int_lt(x, bits_of_int(64, int_sub(E, 2))) by arith(s2, ho, pg, hx)))
      show by simp(v1e, b1, b2, b3)
    qed
    show by simp(a1, a2, c0, c1)
  qed
  have ib: int_mod(int_mod(i, 256), 256) = i by arith(hi, i32)
  // p's index
  have hp3: app(app(H, "bytes"), int_sub(P, 3)) = i :=
    trans(subst({y. app(app(H, "bytes"), y) = int_mod(int_mod(i, 256), 256)}, p3, apply(mp.wr8_at[V := X1, c := bits_sub(64, P, 3), v := int_mod(i, 256)], rewrite(sym(p3), p3b), simp(hi))), ib)
  // p's offset from the storage
  have po: int_sub(P, 2) in omega by arith(pb, s16, hsp)
  have r1 := apply(mp.wr8_rd[V := X1, c := bits_sub(64, P, 3), v := int_mod(i, 256), a := int_sub(P, 2), n := 2], po, simp(), rewrite(sym(p3), p3b), arith(pb), arith(p3))
  have r2 := subst({y. gimple.bytes_at(X1, y, 2) = int_mod(WO, 65536)}, p2, apply(mp.rd_at2[vm := V1, c := bits_sub(64, P, 2), v := WO], v1b, rewrite(sym(p2), p2b), simp()))
  have wo: WO = int_div(int_sub(P, ST), 16) by defs(arith(est, cu, sto, hst, o16), pow2)
  have hp2: gimple.bytes_at(H, int_sub(P, 2), 2) = int_div(int_sub(P, ST), 16) := trans(r1, trans(r2, (int_mod(WO, 65536) = int_div(int_sub(P, ST), 16) by arith(wo, sto, hst, o16))))
  // past the slot's start: its offset record, its tag, p's check byte
  have hlo: int_lt(SS, P) -> gimple.bytes_at(H, int_sub(SS, 2), 2) = int_div(int_sub(P, SS), 16) &&
      app(app(H, "bytes"), int_sub(SS, 3)) = 224 && app(app(H, "bytes"), int_sub(P, 4)) = 0 proof
    assume k
    have ke: int_lt(E, P) := rewrite(sym(esl), k)
    have v1e: V1 = mallocng_specs.wr8(Y, bits_sub(64, P, 4), 0) by simp(ke)
    have pg: int_le(int_add(SS, 16), P) by arith(k, hal, hsp)
    have so: int_sub(SS, 2) in omega by arith(s16)
    have q1 := apply(mp.wr8_rd[V := X1, c := bits_sub(64, P, 3), v := int_mod(i, 256), a := int_sub(SS, 2), n := 2], so, simp(), rewrite(sym(p3), p3b), arith(pb, pg), arith(p3, pg))
    have q2 := apply(mp.wr16_rd[V := V1, c := bits_sub(64, P, 2), v := WO, a := int_sub(SS, 2), n := 2], so, simp(), rewrite(sym(p2), p2b), arith(pb, pg), arith(p2, pb, pg), arith(p2, pg))
    have q3 := apply(mp.wr8_rd[V := Y, c := bits_sub(64, P, 4), v := 0, a := int_sub(SS, 2), n := 2], so, simp(), rewrite(sym(p4), p4b), arith(pb, pg), arith(p4, pg))
    have q4 := apply(mp.wr8_rd[V := Z, c := bits_of_int(64, int_sub(E, 3)), v := int_mul(7, 32), a := int_sub(SS, 2), n := 2], so, simp(), rewrite(sym(s3), s3b), arith(pb, pg), arith(s3))
    have q5 := subst({y. gimple.bytes_at(Z, y, 2) = int_mod(int_div(int_sub(P, E), mallocng.UNIT), 65536)}, s2,
      apply(mp.rd_at2[vm := vm, c := bits_of_int(64, int_sub(E, 2)), v := int_div(int_sub(P, E), mallocng.UNIT)], hb, rewrite(sym(s2), s2b), arith(ke, esl, hsp, cu, pb, s16)))
    have qv: int_mod(int_div(int_sub(P, E), mallocng.UNIT), 65536) = int_div(int_sub(P, SS), 16) by arith(esl, cu, hsp, h4k)
    have rlo: gimple.bytes_at(H, int_sub(SS, 2), 2) = int_div(int_sub(P, SS), 16) := trans(q1, trans(q2, trans(rewrite(sym(v1e), q3), trans(q4, trans(q5, qv)))))
    have xs3: int_sub(SS, 3) in bits(64) := s3b
    have t1 := apply(mp.wr8_out[V := X1, c := bits_sub(64, P, 3), v := int_mod(i, 256), x := int_sub(SS, 3)], xs3, rewrite(sym(p3), p3b), arith(p3, pg))
    have t2 := apply(mp.wr16_out[V := V1, c := bits_sub(64, P, 2), v := WO, x := int_sub(SS, 3)], xs3, rewrite(sym(p2), p2b), arith(p2, pb, pg), arith(p2, pg))
    have t3 := apply(mp.wr8_out[V := Y, c := bits_sub(64, P, 4), v := 0, x := int_sub(SS, 3)], xs3, rewrite(sym(p4), p4b), arith(p4, pg))
    have t4 := subst({y. app(app(Y, "bytes"), y) = int_mod(int_mul(7, 32), 256)}, s3, apply(mp.wr8_at[V := Z, c := bits_of_int(64, int_sub(E, 3)), v := int_mul(7, 32)], rewrite(sym(s3), s3b), simp()))
    have rtg: app(app(H, "bytes"), int_sub(SS, 3)) = 224 := trans(t1, trans(t2, trans(rewrite(sym(v1e), t3), trans(t4, (int_mod(int_mul(7, 32), 256) = 224 by simp())))))
    have xp4: int_sub(P, 4) in bits(64) := p4b
    have u1 := apply(mp.wr8_out[V := X1, c := bits_sub(64, P, 3), v := int_mod(i, 256), x := int_sub(P, 4)], xp4, rewrite(sym(p3), p3b), arith(p3))
    have u2 := apply(mp.wr16_out[V := V1, c := bits_sub(64, P, 2), v := WO, x := int_sub(P, 4)], xp4, rewrite(sym(p2), p2b), arith(p2, pb, pg), arith(p2))
    have u3 := subst({y. app(app(mallocng_specs.wr8(Y, bits_sub(64, P, 4), 0), "bytes"), y) = int_mod(0, 256)}, p4, apply(mp.wr8_at[V := Y, c := bits_sub(64, P, 4), v := 0], rewrite(sym(p4), p4b), simp()))
    have rck: app(app(H, "bytes"), int_sub(P, 4)) = 0 := trans(u1, trans(u2, trans(rewrite(sym(v1e), u3), (int_mod(0, 256) = 0 by simp()))))
    show by taut(rlo, rtg, rck)
  qed
  // nothing but the bytes written
  have fx: all X. fn_update(H, "bytes", X) = fn_update(vm, "bytes", X) proof
    fix X
    have c0: !int_lt(E, P) -> fn_update(H, "bytes", X) = fn_update(vm, "bytes", X) by defs(simp(fn_update_twice), mallocng_specs.wr8, mallocng_specs.wr16)
    have c1: int_lt(E, P) -> fn_update(H, "bytes", X) = fn_update(vm, "bytes", X) by defs(simp(fn_update_twice), mallocng_specs.wr8, mallocng_specs.wr16)
    show by taut(c0, c1)
  qed
  show by simp(eh, h1, hp3, hp2, hlo, fx)
qed

// enframe's memory (`ms.ef_run`: set_size's, `size_set`, on the header
// writes): the slot framed (`framed`) -- the frame read back byte by byte,
// the slot's check and end bytes the invariant's 0, the class's bound the
// caller's
theorem mp.ef_frame(vm, W, v, g, i, n, P): vm in x86_64_linux.Vm -> app(vm, "bytes") in fn_space(bits(64), bits(8)) -> W in x86_64_linux.Vm ->
  g in bits(64) -> i in omega -> int_lt(i, 32) -> n in bits(64) -> P in bits(64) ->
  mallocng_specs.eslot(vm, g, i) = mallocng.slot_start(v, i) -> mallocng_specs.stride_w(vm, g) = mallocng.stride(v) ->
  mallocng_specs.rd64(vm, bits_add(64, g, 16)) = app(v, "mem") -> mallocng.stride(v) in omega -> app(v, "mem") in omega ->
  int_le(mallocng.slot_start(v, i), P) -> int_mod(int_sub(P, mallocng.slot_start(v, i)), 16) = 0 -> int_le(int_add(P, n), mallocng.slot_end(v, i)) ->
  int_lt(P, int_add(mallocng.slot_start(v, i), 4096)) -> int_lt(mallocng.slot_end(v, i), 9223372036854775808) ->
  int_lt(int_div(int_sub(P, mallocng.storage(v)), 16), 65536) ->
  (int_lt(app(v, "sizeclass"), 48) -> int_lt(int_sub(int_sub(mallocng.slot_end(v, i), n), mallocng.storage(v)), int_mul(int_mul(mallocng.UNIT, app(mallocng.size_classes, app(v, "sizeclass"))), int_add(i, 1)))) ->
  app(app(vm, "bytes"), bits_of_int(64, int_sub(mallocng.slot_start(v, i), mallocng.IB))) = 0 ->
  app(app(vm, "bytes"), bits_of_int(64, mallocng.slot_end(v, i))) = 0 ->
  mallocng_purpose.size_set(mallocng_specs.enframe_hdr(vm, g, i, P), W, P, mallocng_specs.eend(vm, g, i), n) ->
  mallocng_purpose.framed(vm, W, v, i, P, n)
proof
  assume hvm hb hW hg hi i32 hn hP esl sw rdm sn vme hsp hal hpl h4k se63 o16 hcls chk0 end0 hss
  let SS := mallocng.slot_start(v, i)
  let SE := mallocng.slot_end(v, i)
  let ST := mallocng.storage(v)
  let H := mallocng_specs.enframe_hdr(vm, g, i, P)
  let M := mallocng.mview(W, mallocng.all_bytes)
  have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
  have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
  have pb: int_le(0, P) && int_lt(P, 18446744073709551616) by simp(hP)
  have nb: int_le(0, n) && int_lt(n, 18446744073709551616) by simp(hn)
  have m0: int_mul(mallocng.stride(v), i) in omega by simp(sn, hi)
  have ss: SS = int_add(int_add(app(v, "mem"), 16), int_mul(mallocng.stride(v), i)) by defs(arith(cu), mallocng.slot_start, mallocng.storage)
  have stv: ST = int_add(app(v, "mem"), 16) by defs(arith(cu), mallocng.storage)
  have se: SE = int_sub(int_add(SS, mallocng.stride(v)), 4) by defs(arith(ci), mallocng.slot_end)
  have s16: int_le(16, SS) by arith(ss, vme, m0)
  have sto: ST in omega by arith(stv, vme)
  have est: int_add(mallocng_specs.rd64(vm, bits_add(64, g, 16)), mallocng.UNIT) = ST by arith(rdm, stv, cu)
  have p63: int_lt(P, 9223372036854775808) by arith(hpl, se63, nb)
  have hst: int_le(ST, P) by arith(stv, ss, m0, hsp)
  have hh1 hp3 hp2 hlo fx := apply(mp.ef_hdr[vm := vm, g := g, i := i, P := P, SS := SS, ST := ST], hb, hg, hi, i32, hP, esl, est, sto, s16, hsp, hal, h4k, p63, hst, o16)
  // set_size's part: the slack recorded; the header byte's low bits, the
  // bytes outside the header byte and the slack: as it found them
  have eend: mallocng_specs.eend(vm, g, i) = SE by defs(arith(esl, sw, se, ci, se63, ss, vme, m0, sn), mallocng_specs.eend, bits_of_int, pow2)
  have hss2 := rewrite(eend, hss)
  have fu so hk un := expand(hss2, mallocng_purpose.size_set)
  have bx: all x. x in omega -> int_lt(x, 18446744073709551616) -> bits_of_int(64, x) = x proof
    fix x
    assume hx hxl
    show by defs(arith(hx, hxl), bits_of_int, pow2)
  qed
  have wu: all x. x in omega -> int_lt(x, 18446744073709551616) -> !(x = int_sub(P, 3)) -> (int_lt(x, int_add(P, n)) || int_le(SE, x)) ->
      app(app(W, "bytes"), x) = app(app(H, "bytes"), x) proof
    fix x
    assume hx hxl hx3 hxs
    have u := mp(all_elim(un, {x}), hx, (((int_lt(x, int_pow(2, 64)) && !(x = int_sub(P, 3))) && !(int_le(int_add(P, n), x) && int_lt(x, SE))) by arith(hxl, hx3, hxs, hx)))
    show by simp(u, mp(all_elim(bx, {x}), hx, hxl))
  qed
  // reading the view of W
  have bW: all x. x in omega -> int_lt(x, 18446744073709551616) -> mallocng.b8(M, x) = app(app(W, "bytes"), x) proof
    fix x
    assume hx hxl
    have wb: app(W, "bytes") in fn_space(bits(64), bits(8)) by simp(hW)
    have r _ := apply(mp.b8_view[vm := W, fp := mallocng.all_bytes, a := x], wb, hx, (x in mallocng.all_bytes by defs(simp(hx), mallocng.all_bytes)))
    show by simp(r, mp(all_elim(bx, {x}), hx, hxl))
  qed
  have wb: app(W, "bytes") in fn_space(bits(64), bits(8)) by simp(hW)
  have pl2: int_lt(int_add(P, n), 18446744073709551616) by arith(hpl, se63)
  // p's check byte: written 0 past the slot's start, else the slot's own
  have f4: mallocng.b8(M, int_sub(P, 4)) = 0 proof
    have xo: int_sub(P, 4) in omega by arith(hsp, s16)
    have xl: int_lt(int_sub(P, 4), 18446744073709551616) by arith(pb)
    have w4 := mp(all_elim(wu, {int_sub(P, 4)}), xo, xl, (!(int_sub(P, 4) = int_sub(P, 3)) by arith()), (int_lt(int_sub(P, 4), int_add(P, n)) || int_le(SE, int_sub(P, 4)) by arith(nb)))
    have c1: int_lt(SS, P) -> app(app(H, "bytes"), int_sub(P, 4)) = 0 proof
      assume k
      have _ _ z := mp(hlo, k)
      show z
    qed
    have c2: !int_lt(SS, P) -> app(app(H, "bytes"), int_sub(P, 4)) = 0 proof
      assume k
      have pe: P = SS by arith(k, hsp, (P in omega by simp(hP)), ss, vme, m0)
      have h0 := mp(all_elim(hh1, {int_sub(P, 4)}), xo, xl, (int_lt(int_sub(P, 4), int_sub(SS, 3)) || int_le(P, int_sub(P, 4)) by arith(pe)))
      have c0: bits_of_int(64, int_sub(SS, mallocng.IB)) = int_sub(P, 4) by defs(arith(pe, ci, s16, pb), bits_of_int, pow2)
      show := trans(h0, rewrite(c0, chk0))
    qed
    show := trans(mp(all_elim(bW, {int_sub(P, 4)}), xo, xl), trans(w4, (app(app(H, "bytes"), int_sub(P, 4)) = 0 by taut(c1, c2))))
  qed
  // p's index: set_size keeps its low 5 bits
  have p3: bits_sub(64, P, 3) = int_sub(P, 3) by defs(arith(pb, s16, hsp), bits_sub, pow2)
  have p3o: int_sub(P, 3) in omega by arith(hsp, s16)
  have p3l: int_lt(int_sub(P, 3), 18446744073709551616) by arith(pb)
  have p3b: int_sub(P, 3) in bits(64) by simp(p3o, p3l)
  have wbo := mp(fn_space_app[a := bits(64), b := bits(8), f := app(W, "bytes"), x := int_sub(P, 3)], wb, p3b)
  have bw3: gimple.bytes_at(W, bits_sub(64, P, 3), 1) = app(app(W, "bytes"), int_sub(P, 3)) by defs(simp(p3, p3o, p3l, wbo), gimple.bytes_at)
  have bh3: gimple.bytes_at(H, bits_sub(64, P, 3), 1) = i by defs(simp(p3, p3o, p3l, hp3, hi), gimple.bytes_at)
  have im: int_mod(i, 32) = i by arith(hi, i32)
  have f5: int_mod(mallocng.b8(M, int_sub(P, 3)), 32) = i := trans(subst({y. int_mod(mallocng.b8(M, int_sub(P, 3)), 32) = int_mod(y, 32)}, mp(all_elim(bW, {int_sub(P, 3)}), p3o, p3l), refl({int_mod(mallocng.b8(M, int_sub(P, 3)), 32)})),
    trans(rewrite(bh3, rewrite(bw3, hk)), im))
  // the 2-byte reads, through set_size's untouched bytes
  have rdw: all a. a in omega -> int_le(int_add(a, 2), int_add(P, n)) -> !(a = int_sub(P, 3)) -> !(int_add(a, 1) = int_sub(P, 3)) ->
      mallocng.rd(M, a, 2) = gimple.bytes_at(H, a, 2) proof
    fix a
    assume ha hl h0 h1
    have inn: all j. j in omega -> int_lt(j, 2) -> int_add(a, j) in mallocng.all_bytes proof
      fix j
      assume hj _
      show by defs(simp(ha, hj), mallocng.all_bytes)
    qed
    have vr := apply(mp.view_read[vm := W, fp := mallocng.all_bytes, a := a, n := 2], ha, simp(), simp(), inn)
    have same: all j. j in omega -> int_lt(j, 2) -> app(app(W, "bytes"), int_add(a, j)) = app(app(H, "bytes"), int_add(a, j)) proof
      fix j
      assume hj hjl
      have aj: int_add(a, j) in omega by arith(ha, hj)
      have nj: !(int_add(a, j) = int_sub(P, 3)) proof
        have k: int_add(a, j) = int_sub(P, 3) -> false proof
          assume e
          have c: j = 0 || j = 1 by arith(hj, hjl)
          show by taut(c, (j = 0 -> false by arith(e, h0, ha, hj, pb)), (j = 1 -> false by arith(e, h1, ha, hj, pb)))
        qed
        show by taut(k)
      qed
      show := mp(all_elim(wu, {int_add(a, j)}), aj, arith(hl, pl2, hj, hjl), nj, (int_lt(int_add(a, j), int_add(P, n)) || int_le(SE, int_add(a, j)) by arith(hl, hjl, hj)))
    qed
    have sm := apply(mp.rd_same[v1 := W, v2 := H, a := a, n := 2], ha, simp(), arith(hl, pl2), same)
    show := trans(sym(vr), sm)
  qed
  // p's offset from the storage
  have p2o: int_sub(P, 2) in omega by arith(hsp, s16)
  have f6: mallocng.rd(M, int_sub(P, 2), 2) = int_div(int_sub(P, ST), mallocng.UNIT) :=
    trans(mp(all_elim(rdw, {int_sub(P, 2)}), p2o, arith(nb), arith(), arith()), trans(hp2, (int_div(int_sub(P, ST), 16) = int_div(int_sub(P, ST), mallocng.UNIT) by simp(cu))))
  // past the slot's start: its offset record, its tag
  have f7: int_lt(SS, P) -> mallocng.rd(M, int_sub(SS, 2), 2) = int_div(int_sub(P, SS), mallocng.UNIT) && mallocng.b8(M, int_sub(SS, 3)) = int_mul(7, 32) proof
    assume k
    have lo tg _ := mp(hlo, k)
    have pg: int_le(int_add(SS, 16), P) by arith(k, hal, hsp, (P in omega by simp(hP)), ss, vme, m0)
    have s2o: int_sub(SS, 2) in omega by arith(s16)
    have r1 := trans(mp(all_elim(rdw, {int_sub(SS, 2)}), s2o, arith(pg, nb), arith(pg), arith(pg)), trans(lo, (int_div(int_sub(P, SS), 16) = int_div(int_sub(P, SS), mallocng.UNIT) by simp(cu))))
    have s3o: int_sub(SS, 3) in omega by arith(s16)
    have s3l: int_lt(int_sub(SS, 3), 18446744073709551616) by arith(pg, pb)
    have w3 := mp(all_elim(wu, {int_sub(SS, 3)}), s3o, s3l, (!(int_sub(SS, 3) = int_sub(P, 3)) by arith(pg)), (int_lt(int_sub(SS, 3), int_add(P, n)) || int_le(SE, int_sub(SS, 3)) by arith(pg, nb)))
    have r2: mallocng.b8(M, int_sub(SS, 3)) = int_mul(7, 32) := trans(mp(all_elim(bW, {int_sub(SS, 3)}), s3o, s3l), trans(w3, trans(tg, (224 = int_mul(7, 32) by simp()))))
    show by taut(r1, r2)
  qed
  // the slack recorded; the slot's end byte, as it was: 0
  have seo: SE in omega by arith(se, ss, vme, m0, sn, hpl, nb)
  have sel: int_lt(SE, 18446744073709551616) by arith(se63)
  have we := mp(all_elim(wu, {SE}), seo, sel, (!(SE = int_sub(P, 3)) by arith(hpl, nb, seo, pb)), (int_lt(SE, int_add(P, n)) || int_le(SE, SE) by arith(seo)))
  have he := mp(all_elim(hh1, {SE}), seo, sel, (int_lt(SE, int_sub(SS, 3)) || int_le(P, SE) by arith(hpl, nb, seo, pb)))
  have f9b: mallocng.b8(M, SE) = 0 := trans(mp(all_elim(bW, {SE}), seo, sel), trans(we, trans(he, rewrite(mp(all_elim(bx, {SE}), seo, sel), end0))))
  // within the class's slot: by the caller's bound
  have f10: int_lt(app(v, "sizeclass"), 48) -> int_lt(int_sub(P, ST), int_mul(int_mul(mallocng.UNIT, app(mallocng.size_classes, app(v, "sizeclass"))), int_add(i, 1))) proof
    assume k
    have b := mp(hcls, k)
    show by arith(b, hpl, nb)
  qed
  have six: !(0 = 6) by simp()
  have halu: int_mod(int_sub(P, SS), mallocng.UNIT) = 0 by simp(hal, cu)
  have fok: mallocng.frame_ok(M, v, i, P, n, 0) by defs(taut(hsp, halu, hpl, f4, f5, f6, f7, six, so, f9b, f10), mallocng.frame_ok)
  // only the bytes changed, of them only the slot interior's
  have vs := apply(fn_update_same[f := vm, k := "bytes"], simp(hvm), simp(hvm))
  have c1: fn_update(W, "bytes", app(vm, "bytes")) = vm := trans(sym(fn_update_twice[f := W, k := "bytes", a := app(H, "bytes"), b := app(vm, "bytes")]),
    trans(subst({y. fn_update(fn_update(W, "bytes", app(H, "bytes")), "bytes", app(vm, "bytes")) = fn_update(y, "bytes", app(vm, "bytes"))}, fu, refl({fn_update(fn_update(W, "bytes", app(H, "bytes")), "bytes", app(vm, "bytes"))})),
      trans(all_elim(fx, {app(vm, "bytes")}), vs)))
  have c3: all x. x in omega -> int_lt(x, int_pow(2, 64)) && !mallocng.in_slot(v, i, x) -> app(app(W, "bytes"), bits_of_int(64, x)) = app(app(vm, "bytes"), bits_of_int(64, x)) proof
    fix x
    assume hx hc
    have hl hn2 := hc
    have xl: int_lt(x, 18446744073709551616) by simp(hl)
    have hn3: !(int_lt(int_sub(SS, mallocng.IB), x) && int_lt(x, SE)) by defs(hn2, mallocng.in_slot)
    have out: int_le(x, int_sub(SS, 4)) || int_le(SE, x) by arith(hn3, hx, ci, seo, s16)
    have w := mp(all_elim(wu, {x}), hx, xl, (!(x = int_sub(P, 3)) by arith(out, hsp, hpl, nb, hx)), (int_lt(x, int_add(P, n)) || int_le(SE, x) by arith(out, hsp, nb, hx)))
    have h := mp(all_elim(hh1, {x}), hx, xl, (int_lt(x, int_sub(SS, 3)) || int_le(P, x) by arith(out, hpl, nb, hx)))
    show by simp(mp(all_elim(bx, {x}), hx, xl), trans(w, h))
  qed
  show by defs(taut(c1, fok, c3), mallocng_purpose.framed)
qed

// ----------------------------------------------------------------------
//  Words: 8-aligned words apart, one read through a 64-bit write

// two 8-aligned words: the same, or apart
theorem mp.al8_ne(a, c): a in omega -> c in omega -> int_mod(a, 8) = 0 -> int_mod(c, 8) = 0 -> !(a = c) ->
  int_le(int_add(c, 8), a) || int_le(int_add(a, 8), c)
proof
  assume ha hc ma mc hne
  show by arith(ha, hc, ma, mc, hne)
qed

// a 64-bit store read back (as `mp.rd_at4`)
theorem mp.rd_at8(vm, c, v): app(vm, "bytes") in fn_space(bits(64), bits(8)) -> c in bits(64) -> v in bits(64) ->
  gimple.bytes_at(mallocng_specs.wr64(vm, c, v), c, 8) = v
proof
  assume hb hc hv
  let V := fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), c, 8, v))
  have le8 := mp(all_elim(tr.le_store8, {app(vm, "bytes")}, {c}, {v}), hb, hc, simp(hv))
  have lb := all_elim(tr.le_bytes, {V}, {c}, {8})
  have w: bits_of_int(64, gimple.bytes_at(V, c, 8)) = bits_of_int(64, v) by simp(le8, lb)
  have vb: app(V, "bytes") in fn_space(bits(64), bits(8)) by simp(mp(all_elim(x86.store_typed, {app(vm, "bytes")}, {c}, {8}, {v}), hb))
  have bn bl := mp(all_elim(g.bytes_bound, {V}, {c}, {8}), vb, simp())
  have id: bits_of_int(64, gimple.bytes_at(V, c, 8)) = gimple.bytes_at(V, c, 8) by defs(simp(bn, bl), bits_of_int, pow2)
  have iv: bits_of_int(64, v) = v by defs(simp(hv), bits_of_int, pow2)
  show by defs(trans(sym(id), trans(w, iv)), mallocng_specs.wr64)
qed

// a word w read through a 64-bit write at c (both 8-aligned): the value
// written there, else the old word
theorem mp.w64(V, c, v, w): app(V, "bytes") in fn_space(bits(64), bits(8)) -> c in bits(64) -> v in bits(64) -> w in omega ->
  int_le(int_add(w, 8), 18446744073709551616) -> int_le(int_add(c, 8), 18446744073709551616) -> int_mod(c, 8) = 0 -> int_mod(w, 8) = 0 ->
  gimple.bytes_at(mallocng_specs.wr64(V, c, v), w, 8) = ite(w = c, v, gimple.bytes_at(V, w, 8))
proof
  assume hb hc hv hw hwl hcl mc mw
  have co: c in omega by simp(hc)
  have c1: w = c -> gimple.bytes_at(mallocng_specs.wr64(V, c, v), w, 8) = ite(w = c, v, gimple.bytes_at(V, w, 8)) proof
    assume e
    have r := apply(mp.rd_at8[vm := V, c := c, v := v], hb, hc, hv)
    show by simp(e, r)
  qed
  have c2: !(w = c) -> gimple.bytes_at(mallocng_specs.wr64(V, c, v), w, 8) = ite(w = c, v, gimple.bytes_at(V, w, 8)) proof
    assume e
    have ap := apply(mp.al8_ne[a := w, c := c], hw, co, mw, mc, e)
    have r: gimple.bytes_at(mallocng_specs.wr64(V, c, v), w, 8) = gimple.bytes_at(V, w, 8)
      by defs(apply(mp.rd_out[vm := V, c := c, k := 8, v := v, a := w, n := 8], hw, simp(), hc, simp(), hwl, hcl, ap), mallocng_specs.wr64)
    show by simp(e, r)
  qed
  show by taut(c1, c2)
qed

// ----------------------------------------------------------------------
//  Lists: a cyclic list's successor and predecessor indices, and after an
//  element's removal (`rm_at`)

// x's successor and predecessor modulo L
theorem mp.mod_succ(x, L): x in omega -> L in omega -> int_lt(x, L) ->
  int_mod(int_add(x, 1), L) = ite(int_lt(int_add(x, 1), L), int_add(x, 1), 0)
proof
  assume hx hL hl
  have c1: int_lt(int_add(x, 1), L) -> int_mod(int_add(x, 1), L) = int_add(x, 1) proof
    assume k
    have {r = rem} := apply(div_unique[x := int_add(x, 1), m := L, q := 0, r := int_add(x, 1)], simp(hx), simp(), simp(hx), arith(hl, hx), k, arith(hx))
    show r
  qed
  have c2: !int_lt(int_add(x, 1), L) -> int_mod(int_add(x, 1), L) = 0 proof
    assume k
    have {r = rem} := apply(div_unique[x := int_add(x, 1), m := L, q := 1, r := 0], simp(hx), simp(), simp(), arith(hl, hx), arith(hl, hx), arith(k, hl, hx, hL))
    show r
  qed
  show by simp(c1, c2)
qed

theorem mp.mod_pred(x, L): x in omega -> L in omega -> int_lt(x, L) ->
  int_mod(int_sub(int_add(x, L), 1), L) = ite(x = 0, int_sub(L, 1), int_sub(x, 1))
proof
  assume hx hL hl
  have c1: x = 0 -> int_mod(int_sub(int_add(x, L), 1), L) = int_sub(L, 1) proof
    assume k
    have {r = rem} := apply(div_unique[x := int_sub(int_add(x, L), 1), m := L, q := 0, r := int_sub(L, 1)], arith(k, hl, hL), simp(), arith(hl, hL, hx), arith(hl, hx), arith(), arith(k))
    show r
  qed
  have c2: !(x = 0) -> int_mod(int_sub(int_add(x, L), 1), L) = int_sub(x, 1) proof
    assume k
    have {r = rem} := apply(div_unique[x := int_sub(int_add(x, L), 1), m := L, q := 1, r := int_sub(x, 1)], arith(k, hl, hL, hx), simp(), arith(k, hx), arith(hl, hx), arith(hl), arith())
    show r
  qed
  show by simp(c1, c2)
qed

// l without element k (`rm_at`): its j-th element l's F(j)-th
// (F(j) = j below k, j + 1 from k on). Its successor in the shorter list:
// the successor's in l -- but for k's predecessor, whose is k's successor
theorem mp.rm_next(L, k, j): L in omega -> k in omega -> j in omega -> int_le(2, L) -> int_lt(k, L) -> int_lt(j, int_sub(L, 1)) ->
  (!(ite(int_lt(j, k), j, int_add(j, 1)) = int_mod(int_sub(int_add(k, L), 1), L)) ->
     ite(int_lt(int_mod(int_add(j, 1), int_sub(L, 1)), k), int_mod(int_add(j, 1), int_sub(L, 1)), int_add(int_mod(int_add(j, 1), int_sub(L, 1)), 1)) =
       int_mod(int_add(ite(int_lt(j, k), j, int_add(j, 1)), 1), L)) &&
  (ite(int_lt(j, k), j, int_add(j, 1)) = int_mod(int_sub(int_add(k, L), 1), L) ->
     ite(int_lt(int_mod(int_add(j, 1), int_sub(L, 1)), k), int_mod(int_add(j, 1), int_sub(L, 1)), int_add(int_mod(int_add(j, 1), int_sub(L, 1)), 1)) = int_mod(int_add(k, 1), L))
proof
  assume hL hk hj h2 hkl hjl
  have l1: int_sub(L, 1) in omega by arith(hL, h2)
  have ae := apply(mp.mod_succ[x := j, L := int_sub(L, 1)], hj, l1, hjl)
  have pe := apply(mp.mod_pred[x := k, L := L], hk, hL, hkl)
  have se := apply(mp.mod_succ[x := k, L := L], hk, hL, hkl)
  let G := (!(ite(int_lt(j, k), j, int_add(j, 1)) = int_mod(int_sub(int_add(k, L), 1), L)) ->
     ite(int_lt(int_mod(int_add(j, 1), int_sub(L, 1)), k), int_mod(int_add(j, 1), int_sub(L, 1)), int_add(int_mod(int_add(j, 1), int_sub(L, 1)), 1)) =
       int_mod(int_add(ite(int_lt(j, k), j, int_add(j, 1)), 1), L)) &&
    (ite(int_lt(j, k), j, int_add(j, 1)) = int_mod(int_sub(int_add(k, L), 1), L) ->
     ite(int_lt(int_mod(int_add(j, 1), int_sub(L, 1)), k), int_mod(int_add(j, 1), int_sub(L, 1)), int_add(int_mod(int_add(j, 1), int_sub(L, 1)), 1)) = int_mod(int_add(k, 1), L))
  // j below k's predecessor: j and its successor kept
  have ca: int_lt(j, k) -> int_lt(int_add(j, 1), int_sub(L, 1)) -> int_lt(int_add(j, 1), k) -> G proof
    assume c1 c2 c3
    have eA: int_mod(int_add(j, 1), int_sub(L, 1)) = int_add(j, 1) by simp(ae, c2)
    have k0: !(k = 0) by arith(c1, hj, hk)
    have epk: int_mod(int_sub(int_add(k, L), 1), L) = int_sub(k, 1) by simp(pe, k0)
    have jl: int_lt(int_add(j, 1), L) by arith(c2, hj, hL)
    have esf := apply(mp.mod_succ[x := j, L := L], hj, hL, arith(c2, hj, hL))
    have esf2: int_mod(int_add(j, 1), L) = int_add(j, 1) by simp(esf, jl)
    have ne: !(j = int_sub(k, 1)) by arith(c3, hj, hk)
    show by simp(eA, epk, esf2, c1, c3, ne)
  qed
  // j k's predecessor (k inside): its successor k's
  have cb: int_lt(j, k) -> int_lt(int_add(j, 1), int_sub(L, 1)) -> !int_lt(int_add(j, 1), k) -> G proof
    assume c1 c2 c3
    have eA: int_mod(int_add(j, 1), int_sub(L, 1)) = int_add(j, 1) by simp(ae, c2)
    have k0: !(k = 0) by arith(c1, hj, hk)
    have epk: int_mod(int_sub(int_add(k, L), 1), L) = int_sub(k, 1) by simp(pe, k0)
    have eq: j = int_sub(k, 1) by arith(c1, c3, hj, hk)
    have kl: int_lt(int_add(k, 1), L) by arith(c1, c2, c3, hj, hk, hL)
    have se2: int_mod(int_add(k, 1), L) = int_add(k, 1) by simp(se, kl)
    show by simp(eA, epk, se2, c1, c3, eq)
  qed
  // j k's predecessor, k the last: its successor the first
  have cc: int_lt(j, k) -> !int_lt(int_add(j, 1), int_sub(L, 1)) -> G proof
    assume c1 c2
    have eA: int_mod(int_add(j, 1), int_sub(L, 1)) = 0 by simp(ae, c2)
    have k0: !(k = 0) by arith(c1, hj, hk)
    have z: int_lt(0, k) by arith(k0, hk)
    have epk: int_mod(int_sub(int_add(k, L), 1), L) = int_sub(k, 1) by simp(pe, k0)
    have eq: j = int_sub(k, 1) by arith(c1, c2, hjl, hkl, hj, hk, hL)
    have kl: !int_lt(int_add(k, 1), L) by arith(c1, c2, hjl, hkl, hj, hk, hL)
    have se2: int_mod(int_add(k, 1), L) = 0 by simp(se, kl)
    show by simp(eA, epk, se2, c1, z, eq)
  qed
  // j past k, inside: j + 1 and its successor kept
  have cd: !int_lt(j, k) -> int_lt(int_add(j, 1), int_sub(L, 1)) -> G proof
    assume c1 c2
    have eA: int_mod(int_add(j, 1), int_sub(L, 1)) = int_add(j, 1) by simp(ae, c2)
    have c3: !int_lt(int_add(j, 1), k) by arith(c1, hj, hk)
    have esf := apply(mp.mod_succ[x := int_add(j, 1), L := L], (int_add(j, 1) in omega by simp(hj)), hL, arith(c2, hj, hL))
    have jl: int_lt(int_add(int_add(j, 1), 1), L) by arith(c2, hj, hL)
    have esf2: int_mod(int_add(int_add(j, 1), 1), L) = int_add(int_add(j, 1), 1) by simp(esf, jl)
    have ne: !(int_add(j, 1) = int_mod(int_sub(int_add(k, L), 1), L)) proof
      have n0: k = 0 -> !(int_add(j, 1) = int_mod(int_sub(int_add(k, L), 1), L)) proof
        assume z
        have p: int_mod(int_sub(int_add(k, L), 1), L) = int_sub(L, 1) by simp(pe, z)
        show by simp(p, (!(int_add(j, 1) = int_sub(L, 1)) by arith(c2, hj, hL)))
      qed
      have n1: !(k = 0) -> !(int_add(j, 1) = int_mod(int_sub(int_add(k, L), 1), L)) proof
        assume z
        have p: int_mod(int_sub(int_add(k, L), 1), L) = int_sub(k, 1) by simp(pe, z)
        show by simp(p, (!(int_add(j, 1) = int_sub(k, 1)) by arith(c1, hj, hk)))
      qed
      show by taut(n0, n1)
    qed
    show by simp(eA, esf2, c1, c3, ne)
  qed
  // j the last, k the first: its successor (the shorter list's first) l's second
  have ce: !int_lt(j, k) -> !int_lt(int_add(j, 1), int_sub(L, 1)) -> k = 0 -> G proof
    assume c1 c2 c3
    have eA: int_mod(int_add(j, 1), int_sub(L, 1)) = 0 by simp(ae, c2)
    have eq: int_add(j, 1) = int_sub(L, 1) by arith(c2, hjl, hj, hL)
    have one: int_lt(1, L) by arith(h2)
    have p: int_mod(int_sub(int_add(k, L), 1), L) = int_sub(L, 1) by simp(pe, c3)
    have se2: int_mod(int_add(k, 1), L) = 1 by simp(se, c3, one)
    show by simp(eA, p, se2, c1, c3, eq)
  qed
  // j the last, k inside: its successor the first, as l's last's
  have cf: !int_lt(j, k) -> !int_lt(int_add(j, 1), int_sub(L, 1)) -> !(k = 0) -> G proof
    assume c1 c2 c3
    have eA: int_mod(int_add(j, 1), int_sub(L, 1)) = 0 by simp(ae, c2)
    have z: int_lt(0, k) by arith(c3, hk)
    have eq: int_add(j, 1) = int_sub(L, 1) by arith(c2, hjl, hj, hL)
    have esf := apply(mp.mod_succ[x := int_add(j, 1), L := L], (int_add(j, 1) in omega by simp(hj)), hL, arith(eq, hL, h2))
    have nl: !int_lt(int_add(int_add(j, 1), 1), L) by arith(eq, hL)
    have esf2: int_mod(int_add(int_add(j, 1), 1), L) = 0 by simp(esf, nl)
    have p: int_mod(int_sub(int_add(k, L), 1), L) = int_sub(k, 1) by simp(pe, c3)
    have ne: !(int_add(j, 1) = int_sub(k, 1)) by arith(c1, hj, hk)
    show by simp(eA, p, esf2, c1, c3, z, ne)
  qed
  show by taut(ca, cb, cc, cd, ce, cf)
qed

// ... its predecessor: the predecessor's in l -- but for k's successor,
// whose is k's predecessor
theorem mp.rm_prev(L, k, j): L in omega -> k in omega -> j in omega -> int_le(2, L) -> int_lt(k, L) -> int_lt(j, int_sub(L, 1)) ->
  (!(ite(int_lt(j, k), j, int_add(j, 1)) = int_mod(int_add(k, 1), L)) ->
     ite(int_lt(int_mod(int_sub(int_add(j, int_sub(L, 1)), 1), int_sub(L, 1)), k), int_mod(int_sub(int_add(j, int_sub(L, 1)), 1), int_sub(L, 1)),
       int_add(int_mod(int_sub(int_add(j, int_sub(L, 1)), 1), int_sub(L, 1)), 1)) =
       int_mod(int_sub(int_add(ite(int_lt(j, k), j, int_add(j, 1)), L), 1), L)) &&
  (ite(int_lt(j, k), j, int_add(j, 1)) = int_mod(int_add(k, 1), L) ->
     ite(int_lt(int_mod(int_sub(int_add(j, int_sub(L, 1)), 1), int_sub(L, 1)), k), int_mod(int_sub(int_add(j, int_sub(L, 1)), 1), int_sub(L, 1)),
       int_add(int_mod(int_sub(int_add(j, int_sub(L, 1)), 1), int_sub(L, 1)), 1)) = int_mod(int_sub(int_add(k, L), 1), L))
proof
  assume hL hk hj h2 hkl hjl
  have l1: int_sub(L, 1) in omega by arith(hL, h2)
  have ae := apply(mp.mod_pred[x := j, L := int_sub(L, 1)], hj, l1, hjl)
  have pe := apply(mp.mod_pred[x := k, L := L], hk, hL, hkl)
  have se := apply(mp.mod_succ[x := k, L := L], hk, hL, hkl)
  let G := (!(ite(int_lt(j, k), j, int_add(j, 1)) = int_mod(int_add(k, 1), L)) ->
     ite(int_lt(int_mod(int_sub(int_add(j, int_sub(L, 1)), 1), int_sub(L, 1)), k), int_mod(int_sub(int_add(j, int_sub(L, 1)), 1), int_sub(L, 1)),
       int_add(int_mod(int_sub(int_add(j, int_sub(L, 1)), 1), int_sub(L, 1)), 1)) =
       int_mod(int_sub(int_add(ite(int_lt(j, k), j, int_add(j, 1)), L), 1), L)) &&
    (ite(int_lt(j, k), j, int_add(j, 1)) = int_mod(int_add(k, 1), L) ->
     ite(int_lt(int_mod(int_sub(int_add(j, int_sub(L, 1)), 1), int_sub(L, 1)), k), int_mod(int_sub(int_add(j, int_sub(L, 1)), 1), int_sub(L, 1)),
       int_add(int_mod(int_sub(int_add(j, int_sub(L, 1)), 1), int_sub(L, 1)), 1)) = int_mod(int_sub(int_add(k, L), 1), L))
  // j the first, k the first: its predecessor (the last) l's last, k's
  have ca: j = 0 -> k = 0 -> G proof
    assume c1 c2
    have eA: int_mod(int_sub(int_add(j, int_sub(L, 1)), 1), int_sub(L, 1)) = int_sub(L, 2) by simp(ae, c1)
    have nl: !int_lt(int_sub(L, 2), k) by arith(c2, h2)
    have one: int_lt(1, L) by arith(h2)
    have s2: int_mod(int_add(k, 1), L) = 1 by simp(se, c2, one)
    have p2: int_mod(int_sub(int_add(k, L), 1), L) = int_sub(L, 1) by simp(pe, c2)
    have e1: int_add(int_sub(L, 2), 1) = int_sub(L, 1) by arith(h2)
    show by simp(eA, nl, s2, p2, e1, c1, c2)
  qed
  // j the first, k the last: j k's successor, its predecessor k's
  have cb: j = 0 -> !(k = 0) -> int_add(k, 1) = L -> G proof
    assume c1 c2 c3
    have eA: int_mod(int_sub(int_add(j, int_sub(L, 1)), 1), int_sub(L, 1)) = int_sub(L, 2) by simp(ae, c1)
    have z: int_lt(0, k) by arith(c2, hk)
    have lt: int_lt(int_sub(L, 2), k) by arith(c3)
    have s2: int_mod(int_add(k, 1), L) = 0 by simp(se, c3)
    have p2: int_mod(int_sub(int_add(k, L), 1), L) = int_sub(k, 1) by simp(pe, c2)
    have e1: int_sub(L, 2) = int_sub(k, 1) by arith(c3)
    show by simp(eA, z, lt, s2, p2, e1, c1)
  qed
  // j the first, k inside: its predecessor l's last
  have cc: j = 0 -> !(k = 0) -> !(int_add(k, 1) = L) -> G proof
    assume c1 c2 c3
    have eA: int_mod(int_sub(int_add(j, int_sub(L, 1)), 1), int_sub(L, 1)) = int_sub(L, 2) by simp(ae, c1)
    have z: int_lt(0, k) by arith(c2, hk)
    have nl: !int_lt(int_sub(L, 2), k) by arith(c3, hkl, hk, hL)
    have kl: int_lt(int_add(k, 1), L) by arith(c3, hkl, hk, hL)
    have s2: int_mod(int_add(k, 1), L) = int_add(k, 1) by simp(se, kl)
    have ne: !(0 = int_add(k, 1)) by arith(hk)
    have p0 := apply(mp.mod_pred[x := 0, L := L], simp(), hL, arith(h2))
    have p02: int_mod(int_sub(int_add(0, L), 1), L) = int_sub(L, 1) by simp(p0)
    have e1: int_add(int_sub(L, 2), 1) = int_sub(L, 1) by arith(h2)
    show by simp(eA, z, nl, s2, ne, p02, e1, c1)
  qed
  // j inside, below k: j and its predecessor kept
  have cd: !(j = 0) -> int_lt(j, k) -> G proof
    assume c1 c2
    have eA: int_mod(int_sub(int_add(j, int_sub(L, 1)), 1), int_sub(L, 1)) = int_sub(j, 1) by simp(ae, c1)
    have lt: int_lt(int_sub(j, 1), k) by arith(c2, hj)
    have ne: !(j = int_mod(int_add(k, 1), L)) proof
      have n0: int_lt(int_add(k, 1), L) -> !(j = int_mod(int_add(k, 1), L)) proof
        assume q
        have s2: int_mod(int_add(k, 1), L) = int_add(k, 1) by simp(se, q)
        show by simp(s2, (!(j = int_add(k, 1)) by arith(c2, hj, hk)))
      qed
      have n1: !int_lt(int_add(k, 1), L) -> !(j = int_mod(int_add(k, 1), L)) proof
        assume q
        have s2: int_mod(int_add(k, 1), L) = 0 by simp(se, q)
        show by simp(s2, c1)
      qed
      show by taut(n0, n1)
    qed
    have pj := apply(mp.mod_pred[x := j, L := L], hj, hL, arith(hjl, hj, hL))
    have pj2: int_mod(int_sub(int_add(j, L), 1), L) = int_sub(j, 1) by simp(pj, c1)
    show by simp(eA, lt, ne, pj2, c2)
  qed
  // j k's successor (j = k, after the removal): its predecessor k's
  have ce: !(j = 0) -> !int_lt(j, k) -> j = k -> G proof
    assume c1 c2 c3
    have eA: int_mod(int_sub(int_add(j, int_sub(L, 1)), 1), int_sub(L, 1)) = int_sub(j, 1) by simp(ae, c1)
    have lt: int_lt(int_sub(j, 1), k) by arith(c3, hj)
    have kl: int_lt(int_add(k, 1), L) by arith(c3, hjl, hj)
    have s2: int_mod(int_add(k, 1), L) = int_add(k, 1) by simp(se, kl)
    have k0: !(k = 0) by arith(c1, c3)
    have p2: int_mod(int_sub(int_add(k, L), 1), L) = int_sub(k, 1) by simp(pe, k0)
    have e1: int_sub(j, 1) = int_sub(k, 1) by arith(c3)
    have e2: int_add(j, 1) = int_add(k, 1) by arith(c3)
    show by simp(eA, lt, s2, p2, e1, e2, c2)
  qed
  // j inside, past k: j + 1 and its predecessor kept
  have cf: !(j = 0) -> !int_lt(j, k) -> !(j = k) -> G proof
    assume c1 c2 c3
    have eA: int_mod(int_sub(int_add(j, int_sub(L, 1)), 1), int_sub(L, 1)) = int_sub(j, 1) by simp(ae, c1)
    have nl: !int_lt(int_sub(j, 1), k) by arith(c2, c3, hj, hk)
    have e1: int_add(int_sub(j, 1), 1) = j by arith(c1, hj)
    have ne: !(int_add(j, 1) = int_mod(int_add(k, 1), L)) proof
      have n0: int_lt(int_add(k, 1), L) -> !(int_add(j, 1) = int_mod(int_add(k, 1), L)) proof
        assume q
        have s2: int_mod(int_add(k, 1), L) = int_add(k, 1) by simp(se, q)
        show by simp(s2, (!(int_add(j, 1) = int_add(k, 1)) by arith(c2, c3, hj, hk)))
      qed
      have n1: !int_lt(int_add(k, 1), L) -> !(int_add(j, 1) = int_mod(int_add(k, 1), L)) proof
        assume q
        have s2: int_mod(int_add(k, 1), L) = 0 by simp(se, q)
        show by simp(s2, (!(int_add(j, 1) = 0) by arith(hj)))
      qed
      show by taut(n0, n1)
    qed
    have pj := apply(mp.mod_pred[x := int_add(j, 1), L := L], (int_add(j, 1) in omega by simp(hj)), hL, arith(hjl, hj, hL))
    have pj2: int_mod(int_sub(int_add(int_add(j, 1), L), 1), L) = j by simp(pj, hj, (!(int_add(j, 1) = 0) by arith(hj)))
    show by simp(eA, nl, e1, ne, pj2, c2)
  qed
  show by taut(ca, cb, cc, cd, ce, cf)
qed

// ----------------------------------------------------------------------
//  Lists at a head word (`list_at`): read word by word, built from
//  words; dequeue's effect on them

// l without its k-th element: its length, its type, its elements
theorem mp.rm_at_app(l, k, j): l in list_type(omega) -> k in omega -> int_lt(k, seq_len(l)) ->
  (len: seq_len(mallocng_purpose.rm_at(l, k)) = int_sub(seq_len(l), 1) && type: mallocng_purpose.rm_at(l, k) in list_type(omega)) &&
  elem: (j in omega -> int_lt(j, int_sub(seq_len(l), 1)) -> app(mallocng_purpose.rm_at(l, k), j) = app(l, ite(int_lt(j, k), j, int_add(j, 1))))
proof
  assume hl hk hkl
  let D := int_sub(int_sub(seq_len(l), 1), 0)
  have lo: seq_len(l) in omega by arith(hl)
  have dd: D in omega by arith(hl, hk, hkl)
  // an index of the result: one of l's
  have ix: all x. x in omega -> int_lt(x, D) -> ite(int_lt(int_add(0, x), k), int_add(0, x), int_add(int_add(0, x), 1)) in omega &&
      int_lt(ite(int_lt(int_add(0, x), k), int_add(0, x), int_add(int_add(0, x), 1)), seq_len(l)) proof
    fix x
    assume hx hxl
    have c1: int_lt(int_add(0, x), k) -> ite(int_lt(int_add(0, x), k), int_add(0, x), int_add(int_add(0, x), 1)) = x by simp(hx)
    have c2: !int_lt(int_add(0, x), k) -> ite(int_lt(int_add(0, x), k), int_add(0, x), int_add(int_add(0, x), 1)) = int_add(x, 1) by simp(hx)
    have r1: int_lt(int_add(0, x), k) -> ite(int_lt(int_add(0, x), k), int_add(0, x), int_add(int_add(0, x), 1)) in omega &&
        int_lt(ite(int_lt(int_add(0, x), k), int_add(0, x), int_add(int_add(0, x), 1)), seq_len(l)) proof
      assume h
      have e := mp(c1, h)
      have xl2: int_lt(x, seq_len(l)) by arith(hx, hxl, lo)
      show by simp(e, hx, xl2)
    qed
    have r2: !int_lt(int_add(0, x), k) -> ite(int_lt(int_add(0, x), k), int_add(0, x), int_add(int_add(0, x), 1)) in omega &&
        int_lt(ite(int_lt(int_add(0, x), k), int_add(0, x), int_add(int_add(0, x), 1)), seq_len(l)) proof
      assume h
      have e := mp(c2, h)
      have x1o: int_add(x, 1) in omega by simp(hx)
      have x1l: int_lt(int_add(x, 1), seq_len(l)) by arith(hx, hxl, lo)
      show by simp(e, x1o, x1l)
    qed
    show by taut(r1, r2)
  qed
  have vt: all x0. x0 in D -> app(l, ite(int_lt(int_add(0, x0), k), int_add(0, x0), int_add(int_add(0, x0), 1))) in omega proof
    fix x0
    assume hx
    have xo := mp(nat_elem[k := D, i := x0], dd, hx)
    have xl := mp(nat_mem_lt[k := D, i := x0], dd, hx)
    have io il := mp(all_elim(ix, {x0}), xo, xl)
    show := apply(at_type[l := l, t := omega, i := ite(int_lt(int_add(0, x0), k), int_add(0, x0), int_add(int_add(0, x0), 1))], hl, io, il)
  qed
  have rl: mallocng_purpose.rm_at(l, k) in list_type(omega) by defs(apply(build_list, dd, vt), mallocng_purpose.rm_at)
  have dl: seq_len(mallocng_purpose.rm_at(l, k)) = D
    by defs(fn_build_dom[d := D, v := x0. app(l, ite(int_lt(int_add(0, x0), k), int_add(0, x0), int_add(int_add(0, x0), 1)))], seq_len, mallocng_purpose.rm_at)
  have dl2: seq_len(mallocng_purpose.rm_at(l, k)) = int_sub(seq_len(l), 1) by arith(dl, lo)
  have ap: j in omega -> int_lt(j, int_sub(seq_len(l), 1)) -> app(mallocng_purpose.rm_at(l, k), j) = app(l, ite(int_lt(j, k), j, int_add(j, 1))) proof
    assume hj hjl
    have jd := mp(nat_lt_mem[k := j, n := D], hj, dd, arith(hj, hjl, lo))
    have a := mp(app_fn_build[d := D, v := x0. app(l, ite(int_lt(int_add(0, x0), k), int_add(0, x0), int_add(int_add(0, x0), 1))), a := j], jd)
    have z: int_add(0, j) = j by arith(hj)
    show by defs(simp(a, z), mallocng_purpose.rm_at)
  qed
  show by taut(dl2, rl, ap)
qed

// a word read through the view of all bytes
theorem mp.view_w8(vm, a): a in omega -> int_le(int_add(a, 8), 18446744073709551616) ->
  mallocng.rd(mallocng.mview(vm, mallocng.all_bytes), a, 8) = gimple.bytes_at(vm, a, 8)
proof
  assume ha hl
  have ie: all i. i in omega -> int_lt(i, 8) -> int_add(a, i) in mallocng.all_bytes proof
    fix i
    assume hi _
    show by defs(simp(ha, hi), mallocng.all_bytes)
  qed
  show := sym(apply(mp.view_read[vm := vm, fp := mallocng.all_bytes, a := a, n := 8], ha, simp(), simp(), ie))
qed

// the list at *phead read word by word: the head word its first element,
// each element's links its neighbours
theorem mp.list_rd(vm, objs, phead, l, i): app(vm, "bytes") in fn_space(bits(64), bits(8)) -> phead in bits(64) -> l in list_type(omega) ->
  mallocng_purpose.list_at(vm, objs, phead, l) ->
  head: gimple.bytes_at(vm, phead, 8) = ite(seq_len(l) = 0, 0, app(l, 0)) &&
  links: (i in omega -> int_lt(i, seq_len(l)) ->
     next: gimple.bytes_at(vm, int_add(app(l, i), 8), 8) = app(l, int_mod(int_add(i, 1), seq_len(l))) &&
     prev: gimple.bytes_at(vm, app(l, i), 8) = app(l, int_mod(int_sub(int_add(i, seq_len(l)), 1), seq_len(l))))
proof
  assume hb hp hl H
  have {cy = linked, el = elems} := expand(H, mallocng_purpose.list_at)
  have {ch = first, cw = links} := expand(cy, mallocng.cyclic)
  have bo bl := mp(all_elim(g.bytes_bound, {vm}, {phead}, {8}), hb, simp())
  have rv: mallocng_specs.rd64(vm, phead) = gimple.bytes_at(vm, phead, 8) by defs(simp(bo, bl), mallocng_specs.rd64, bits_of_int, pow2)
  have hd := trans(sym(rv), ch)
  have ws: i in omega -> int_lt(i, seq_len(l)) ->
      gimple.bytes_at(vm, int_add(app(l, i), 8), 8) = app(l, int_mod(int_add(i, 1), seq_len(l))) &&
      gimple.bytes_at(vm, app(l, i), 8) = app(l, int_mod(int_sub(int_add(i, seq_len(l)), 1), seq_len(l))) proof
    assume hi hil
    have lo := apply(at_type[l := l, t := omega, i := i], hl, hi, hil)
    have lb .. := mp(all_elim(el, {i}), hi, hil)
    have rn rp := mp(all_elim(cw, {i}), hi, hil)
    have vn := apply(mp.view_w8[vm := vm, a := int_add(app(l, i), 8)], simp(lo), arith(lo, lb))
    have vp := apply(mp.view_w8[vm := vm, a := app(l, i)], lo, arith(lo, lb))
    show by taut(trans(sym(vn), rn), trans(sym(vp), rp))
  qed
  show by taut(hd, ws)
qed

// k's predecessor and successor in a cyclic list of 2 or more: not k; k
// the first, its successor the second
theorem mp.nb_idx(L, k): L in omega -> k in omega -> int_le(2, L) -> int_lt(k, L) ->
  (pred_ne: !(int_mod(int_sub(int_add(k, L), 1), L) = k) && succ_ne: !(int_mod(int_add(k, 1), L) = k)) && first: (k = 0 -> int_mod(int_add(k, 1), L) = 1)
proof
  assume hL hk h2 hkl
  have pe := apply(mp.mod_pred[x := k, L := L], hk, hL, hkl)
  have se := apply(mp.mod_succ[x := k, L := L], hk, hL, hkl)
  have c0: k = 0 -> (!(int_mod(int_sub(int_add(k, L), 1), L) = k) && !(int_mod(int_add(k, 1), L) = k)) && int_mod(int_add(k, 1), L) = 1 proof
    assume h
    have l1: int_lt(int_add(k, 1), L) by arith(h, h2)
    have ep: int_mod(int_sub(int_add(k, L), 1), L) = int_sub(L, 1) by simp(pe, h)
    have en: int_mod(int_add(k, 1), L) = int_add(k, 1) by simp(se, l1)
    show by arith(ep, en, h, h2, hL)
  qed
  have c1: !(k = 0) -> !(int_mod(int_sub(int_add(k, L), 1), L) = k) && !(int_mod(int_add(k, 1), L) = k) proof
    assume h
    have ep: int_mod(int_sub(int_add(k, L), 1), L) = int_sub(k, 1) by simp(pe, h)
    have n1: int_lt(int_add(k, 1), L) -> !(int_mod(int_add(k, 1), L) = k) proof
      assume l1
      have en: int_mod(int_add(k, 1), L) = int_add(k, 1) by simp(se, l1)
      show by arith(en, hk)
    qed
    have n2: !int_lt(int_add(k, 1), L) -> !(int_mod(int_add(k, 1), L) = k) proof
      assume l1
      have en: int_mod(int_add(k, 1), L) = 0 by simp(se, l1)
      show by arith(en, h, hk)
    qed
    have np: !(int_mod(int_sub(int_add(k, L), 1), L) = k) by arith(ep, hk)
    show by taut(np, n1, n2)
  qed
  show by taut(c0, c1)
qed

// a word, or a byte, outside a 64-bit write: as before
theorem mp.w64_out(V, c, v, w): c in bits(64) -> w in omega -> int_le(int_add(w, 8), 18446744073709551616) -> int_le(int_add(c, 8), 18446744073709551616) ->
  (int_le(int_add(c, 8), w) || int_le(int_add(w, 8), c)) ->
  gimple.bytes_at(mallocng_specs.wr64(V, c, v), w, 8) = gimple.bytes_at(V, w, 8)
proof
  assume hc hw hwl hcl ho
  show by defs(apply(mp.rd_out[vm := V, c := c, k := 8, v := v, a := w, n := 8], hw, simp(), hc, simp(), hwl, hcl, ho), mallocng_specs.wr64)
qed

theorem mp.wb_out(V, c, v, x): x in bits(64) -> c in bits(64) -> int_le(int_add(c, 8), 18446744073709551616) ->
  (int_le(int_add(c, 8), x) || int_lt(x, c)) ->
  app(app(mallocng_specs.wr64(V, c, v), "bytes"), x) = app(app(V, "bytes"), x)
proof
  assume hx hc hcl ho
  have s := apply(mp.st_out[B := app(V, "bytes"), c := c, k := 8, v := v, x := x], hx, hc, simp(), hcl, ho)
  show by defs(simp(s, app_update_same[f := V, k := "bytes", v := x86_64_linux.store_le(app(V, "bytes"), c, 8, v)]), mallocng_specs.wr64)
qed

// ... and back: a list at *phead from its words
theorem mp.list_mk(vm, objs, phead, l): app(vm, "bytes") in fn_space(bits(64), bits(8)) -> phead in bits(64) -> l in list_type(omega) ->
  mallocng_specs.word_ok(vm, objs, phead, 0) -> mallocng_specs.al8(phead) ->
  (all x0. x0 in omega -> int_lt(x0, seq_len(l)) -> ((((int_le(int_add(app(l, x0), 16), int_pow(2, 64)) && mallocng_specs.word_ok(vm, objs, bits_of_int(64, app(l, x0)), 0)) &&
     mallocng_specs.word_ok(vm, objs, bits_of_int(64, app(l, x0)), 8)) && int_mod(app(l, x0), 8) = 0) && (int_le(int_add(phead, 8), app(l, x0)) || int_le(int_add(app(l, x0), 16), phead)))) ->
  (all x0. all x1. x0 in omega && x1 in omega -> (int_lt(x0, seq_len(l)) && int_lt(x1, seq_len(l))) && !(x0 = x1) ->
     int_le(int_add(app(l, x0), 16), app(l, x1)) || int_le(int_add(app(l, x1), 16), app(l, x0))) ->
  gimple.bytes_at(vm, phead, 8) = ite(seq_len(l) = 0, 0, app(l, 0)) ->
  (all i. i in omega -> int_lt(i, seq_len(l)) ->
     gimple.bytes_at(vm, int_add(app(l, i), 8), 8) = app(l, int_mod(int_add(i, 1), seq_len(l))) &&
     gimple.bytes_at(vm, app(l, i), 8) = app(l, int_mod(int_sub(int_add(i, seq_len(l)), 1), seq_len(l)))) ->
  mallocng_purpose.list_at(vm, objs, phead, l)
proof
  assume hb hp hl hok hal el ap hd ws
  have bo bl := mp(all_elim(g.bytes_bound, {vm}, {phead}, {8}), hb, simp())
  have rv: mallocng_specs.rd64(vm, phead) = gimple.bytes_at(vm, phead, 8) by defs(simp(bo, bl), mallocng_specs.rd64, bits_of_int, pow2)
  have ch := trans(rv, hd)
  // apart, so distinct
  have cd: all x0. all x1. x0 in omega && x1 in omega -> (int_lt(x0, seq_len(l)) && int_lt(x1, seq_len(l))) && app(l, x0) = app(l, x1) -> x0 = x1 proof
    fix x0 x1
    assume ho hq
    have o0: x0 in omega by taut(ho)
    have l0: int_lt(x0, seq_len(l)) by taut(hq)
    have e: app(l, x0) = app(l, x1) by taut(hq)
    have lo := apply(at_type[l := l, t := omega, i := x0], hl, o0, l0)
    have ne: !(x0 = x1) -> false proof
      assume h
      have a := mp(all_elim(ap, {x0}, {x1}), ho, taut(hq, h))
      show by arith(a, e, lo)
    qed
    show by taut(ne)
  qed
  have cw: all x0. x0 in omega -> int_lt(x0, seq_len(l)) ->
      mallocng.rd(mallocng.mview(vm, mallocng.all_bytes), int_add(app(l, x0), 8), 8) = app(l, int_mod(int_add(x0, 1), seq_len(l))) &&
      mallocng.rd(mallocng.mview(vm, mallocng.all_bytes), app(l, x0), 8) = app(l, int_mod(int_sub(int_add(x0, seq_len(l)), 1), seq_len(l))) proof
    fix x0
    assume hi hil
    have lo := apply(at_type[l := l, t := omega, i := x0], hl, hi, hil)
    have lb .. := mp(all_elim(el, {x0}), hi, hil)
    have rn rp := mp(all_elim(ws, {x0}), hi, hil)
    have vn := apply(mp.view_w8[vm := vm, a := int_add(app(l, x0), 8)], simp(lo), arith(lo, lb))
    have vp := apply(mp.view_w8[vm := vm, a := app(l, x0)], lo, arith(lo, lb))
    show by taut(trans(vn, rn), trans(vp, rp))
  qed
  have cy: mallocng.cyclic(mallocng.mview(vm, mallocng.all_bytes), mallocng_specs.rd64(vm, phead), l) by defs(taut(ch, cd, cw), mallocng.cyclic)
  show by defs(taut(hok, hal, cy, el, ap), mallocng_purpose.list_at)
qed

theorem mp.wr64_typed(V, c, v): app(V, "bytes") in fn_space(bits(64), bits(8)) -> app(mallocng_specs.wr64(V, c, v), "bytes") in fn_space(bits(64), bits(8))
proof
  assume hb
  show by defs(simp(mp(all_elim(x86.store_typed, {app(V, "bytes")}, {c}, {8}, {v}), hb)), mallocng_specs.wr64)
qed

// a 64-bit write changes only the bytes
theorem mp.wr64_only(V, c, v, W): fn_update(V, "bytes", app(W, "bytes")) = W -> fn_update(mallocng_specs.wr64(V, c, v), "bytes", app(W, "bytes")) = W
proof
  assume h
  have t := fn_update_twice[f := V, k := "bytes", a := x86_64_linux.store_le(app(V, "bytes"), c, 8, v), b := app(W, "bytes")]
  show by defs(trans(t, h), mallocng_specs.wr64)
qed

// dequeue's effect on the list at *phead holding m, of 2 or more: m out
// of it, its neighbours linked, the head moved past it; m's links cleared;
// no byte but the head word and the links written
theorem mp.dq_list2(vm, objs, phead, m, l, k): vm in x86_64_linux.Vm -> app(vm, "bytes") in fn_space(bits(64), bits(8)) -> phead in bits(64) -> m in bits(64) ->
  l in list_type(omega) -> k in omega -> int_lt(k, seq_len(l)) -> int_le(2, seq_len(l)) -> app(l, k) = m ->
  mallocng_purpose.list_at(vm, objs, phead, l) ->
  ((mallocng_purpose.list_at(mallocng_specs.dequeue_vm(vm, phead, m), objs, phead, mallocng_purpose.rm_at(l, k)) &&
     mallocng_specs.rd64(mallocng_specs.dequeue_vm(vm, phead, m), m) = 0) && mallocng_specs.rd64(mallocng_specs.dequeue_vm(vm, phead, m), bits_add(64, m, 8)) = 0) &&
  mallocng_purpose.links_only(vm, mallocng_specs.dequeue_vm(vm, phead, m), phead, l)
proof
  assume hvm hb hp hm hl hk hkl h2 hlk H
  let L := seq_len(l)
  let IP := int_mod(int_sub(int_add(k, L), 1), L)
  let IN := int_mod(int_add(k, 1), L)
  let P := app(l, IP)
  let N := app(l, IN)
  have {hok = head, hal = head_al, el = elems, ap = apart} := expand(H, mallocng_purpose.list_at)
  have lo: L in omega by arith(hl)
  have ipk ink in0 := apply(mp.nb_idx[L := L, k := k], lo, hk, h2, hkl)
  have ipo: IP in omega by arith(hk, lo, h2)
  have ipl: int_lt(IP, L) by arith(hk, lo, h2)
  have ino: IN in omega by arith(hk, lo, h2)
  have inl: int_lt(IN, L) by arith(hk, lo, h2)
  have pho: phead in omega by simp(hp)
  have {phl0 = bound} := expand(hok, mallocng_specs.word_ok)
  have phl: int_le(int_add(phead, 8), 18446744073709551616) by arith(phl0, pho)

  // l's elements: naturals, apart from the head word and from each other
  have ef: all i. i in omega -> int_lt(i, L) -> (app(l, i) in omega && int_le(int_add(app(l, i), 16), 18446744073709551616)) &&
      (int_le(int_add(phead, 8), app(l, i)) || int_le(int_add(app(l, i), 16), phead)) proof
    fix i
    assume hi hil
    have lo2 := apply(at_type[l := l, t := omega, i := i], hl, hi, hil)
    have {lb = bound, lp = off_head} := mp(all_elim(el, {i}), hi, hil)
    have lb2: int_le(int_add(app(l, i), 16), 18446744073709551616) by arith(lb)
    show by taut(lo2, lb2, lp)
  qed
  have ea: all i. all j. i in omega -> j in omega -> int_lt(i, L) -> int_lt(j, L) -> !(i = j) ->
      int_le(int_add(app(l, i), 16), app(l, j)) || int_le(int_add(app(l, j), 16), app(l, i)) proof
    fix i j
    assume hi hj hil hjl hne
    show := mp(all_elim(ap, {i}, {j}), taut(hi, hj), taut(hil, hjl, hne))
  qed
  have po pb pa := mp(all_elim(ef, {IP}), ipo, ipl)
  have no nb na := mp(all_elim(ef, {IN}), ino, inl)
  have mo0 mb0 ma0 := mp(all_elim(ef, {k}), hk, hkl)
  have mo := rewrite(hlk, mo0)
  have mb := rewrite(hlk, mb0)
  have ma := rewrite(hlk, ma0)
  have pm := rewrite(hlk, mp(all_elim(ea, {IP}, {k}), ipo, hk, ipl, hkl, ipk))
  have nm := rewrite(hlk, mp(all_elim(ea, {IN}, {k}), ino, hk, inl, hkl, ink))

  // the words read: m's links its neighbours, the head word the first
  have hd0 ws0 := apply(mp.list_rd[vm := vm, objs := objs, phead := phead, l := l, i := k], hb, hp, hl, H)
  have rn0 rp0 := mp(ws0, hk, hkl)
  have rn := rewrite(hlk, rn0)
  have rp := rewrite(hlk, rp0)
  have h0: gimple.bytes_at(vm, phead, 8) = app(l, 0) by simp(hd0, (!(L = 0) by arith(h2, lo)))
  have z0 := apply(at_type[l := l, t := omega, i := 0], hl, simp(), (int_lt(0, L) by arith(h2, lo)))
  have zo zb za := mp(all_elim(ef, {0}), simp(), (int_lt(0, L) by arith(h2, lo)))
  have bm8: bits_add(64, m, 8) = int_add(m, 8) by defs(arith(mo, mb), bits_add, bits_of_int, pow2)
  have bp8: bits_add(64, P, 8) = int_add(P, 8) by defs(arith(po, pb), bits_add, bits_of_int, pow2)
  have nlt: int_lt(N, 18446744073709551616) by arith(nb)
  have plt: int_lt(P, 18446744073709551616) by arith(pb)
  have eN: mallocng_specs.mnext(vm, m) = N by defs(simp(bm8, rn, no, nlt), mallocng_specs.mnext, mallocng_specs.rd64, bits_of_int, pow2)
  have eP: mallocng_specs.mprev(vm, m) = P by defs(simp(rp, po, plt), mallocng_specs.mprev, mallocng_specs.rd64, bits_of_int, pow2)
  have nnm: !(N = m) by arith(nm, mo, no)
  have nbits: N in bits(64) by simp(no, nlt)
  have pbits: P in bits(64) by simp(po, plt)
  have p8b: int_add(P, 8) in bits(64) by simp(po, (int_lt(int_add(P, 8), 18446744073709551616) by arith(pb)))
  have m8b: int_add(m, 8) in bits(64) by simp(mo, (int_lt(int_add(m, 8), 18446744073709551616) by arith(mb)))
  have zbits: 0 in bits(64) by simp()

  // the writes: m's neighbours linked, the head moved (m the first), m's links cleared
  let V1 := mallocng_specs.wr64(vm, int_add(P, 8), N)
  let V2 := mallocng_specs.wr64(V1, N, P)
  have e2: mallocng_specs.dq_links(vm, phead, m) = V2 by defs(simp(eN, eP, nnm, bp8), mallocng_specs.dq_links)
  have tb1 := apply(mp.wr64_typed[V := vm, c := int_add(P, 8), v := N], hb)
  have tb2 := apply(mp.wr64_typed[V := V1, c := N, v := P], tb1)
  have v2h: gimple.bytes_at(V2, phead, 8) = app(l, 0) :=
    trans(apply(mp.w64_out[V := V1, c := N, v := P, w := phead], nbits, pho, phl, arith(nb), arith(na, no, pho)),
      trans(apply(mp.w64_out[V := vm, c := int_add(P, 8), v := N, w := phead], p8b, pho, phl, arith(pb), arith(pa, po, pho)), h0))
  have rv2: mallocng_specs.rd64(V2, phead) = app(l, 0) by defs(simp(v2h, zo, (int_lt(app(l, 0), 18446744073709551616) by arith(zb))), mallocng_specs.rd64, bits_of_int, pow2)
  let V3 := mallocng_specs.dq_head(V2, vm, phead, m)
  have c0: k = 0 -> V3 = mallocng_specs.wr64(V2, phead, N) proof
    assume h
    have e0: app(l, 0) = m := rewrite(h, hlk)
    show by defs(simp(eN, nnm, rv2, e0), mallocng_specs.dq_head)
  qed
  have c1: !(k = 0) -> V3 = V2 proof
    assume h
    have a := rewrite(hlk, mp(all_elim(ea, {0}, {k}), simp(), hk, (int_lt(0, L) by arith(h2, lo)), hkl, (!(0 = k) by taut(h))))
    have ne: !(app(l, 0) = m) by arith(a, zo, mo)
    show by defs(simp(rv2, ne), mallocng_specs.dq_head)
  qed
  have tb3: app(V3, "bytes") in fn_space(bits(64), bits(8)) proof
    have q0: k = 0 -> app(V3, "bytes") in fn_space(bits(64), bits(8)) proof
      assume h
      show := subst({y. app(y, "bytes") in fn_space(bits(64), bits(8))}, sym(mp(c0, h)), apply(mp.wr64_typed[V := V2, c := phead, v := N], tb2))
    qed
    have q1: !(k = 0) -> app(V3, "bytes") in fn_space(bits(64), bits(8)) proof
      assume h
      show := subst({y. app(y, "bytes") in fn_space(bits(64), bits(8))}, sym(mp(c1, h)), tb2)
    qed
    show by taut(q0, q1)
  qed
  // (V3: V2 but for the head word)
  have r3: all w. w in omega -> int_le(int_add(w, 8), 18446744073709551616) -> (int_le(int_add(phead, 8), w) || int_le(int_add(w, 8), phead)) ->
      gimple.bytes_at(V3, w, 8) = gimple.bytes_at(V2, w, 8) proof
    fix w
    assume hw hwl ho
    have q0: k = 0 -> gimple.bytes_at(V3, w, 8) = gimple.bytes_at(V2, w, 8) proof
      assume h
      have o := apply(mp.w64_out[V := V2, c := phead, v := N, w := w], hp, hw, hwl, phl, ho)
      show := subst({y. gimple.bytes_at(y, w, 8) = gimple.bytes_at(V2, w, 8)}, sym(mp(c0, h)), o)
    qed
    have q1: !(k = 0) -> gimple.bytes_at(V3, w, 8) = gimple.bytes_at(V2, w, 8) proof
      assume h
      show := subst({y. gimple.bytes_at(y, w, 8) = gimple.bytes_at(V2, w, 8)}, sym(mp(c1, h)), refl({gimple.bytes_at(V2, w, 8)}))
    qed
    show by taut(q0, q1)
  qed
  have r3b: all x. x in bits(64) -> (int_le(int_add(phead, 8), x) || int_lt(x, phead)) -> app(app(V3, "bytes"), x) = app(app(V2, "bytes"), x) proof
    fix x
    assume hx ho
    have q0: k = 0 -> app(app(V3, "bytes"), x) = app(app(V2, "bytes"), x) proof
      assume h
      have o := apply(mp.wb_out[V := V2, c := phead, v := N, x := x], hx, hp, phl, ho)
      show := subst({y. app(app(y, "bytes"), x) = app(app(V2, "bytes"), x)}, sym(mp(c0, h)), o)
    qed
    have q1: !(k = 0) -> app(app(V3, "bytes"), x) = app(app(V2, "bytes"), x) proof
      assume h
      show := subst({y. app(app(y, "bytes"), x) = app(app(V2, "bytes"), x)}, sym(mp(c1, h)), refl({app(app(V2, "bytes"), x)}))
    qed
    show by taut(q0, q1)
  qed
  have r3h0: k = 0 -> gimple.bytes_at(V3, phead, 8) = N proof
    assume h
    show := subst({y. gimple.bytes_at(y, phead, 8) = N}, sym(mp(c0, h)), apply(mp.rd_at8[vm := V2, c := phead, v := N], tb2, hp, nbits))
  qed
  have r3h1: !(k = 0) -> gimple.bytes_at(V3, phead, 8) = app(l, 0) proof
    assume h
    show := subst({y. gimple.bytes_at(y, phead, 8) = app(l, 0)}, sym(mp(c1, h)), v2h)
  qed
  // only the bytes changed
  have vf: is_fun(vm) by simp(hvm)
  have vd: "bytes" in dom(vm) by simp(hvm)
  have vs := apply(fn_update_same[f := vm, k := "bytes"], vf, vd)
  have fu2 := apply(mp.wr64_only[V := V1, c := N, v := P, W := vm], apply(mp.wr64_only[V := vm, c := int_add(P, 8), v := N, W := vm], vs))
  have fu3: fn_update(V3, "bytes", app(vm, "bytes")) = vm proof
    have q0: k = 0 -> fn_update(V3, "bytes", app(vm, "bytes")) = vm proof
      assume h
      have f := apply(mp.wr64_only[V := V2, c := phead, v := N, W := vm], fu2)
      show := subst({y. fn_update(y, "bytes", app(vm, "bytes")) = vm}, sym(mp(c0, h)), f)
    qed
    have q1: !(k = 0) -> fn_update(V3, "bytes", app(vm, "bytes")) = vm proof
      assume h
      show := subst({y. fn_update(y, "bytes", app(vm, "bytes")) = vm}, sym(mp(c1, h)), fu2)
    qed
    show by taut(q0, q1)
  qed
  let V4 := mallocng_specs.wr64(V3, int_add(m, 8), 0)
  let V5 := mallocng_specs.wr64(V4, m, 0)
  have e5: mallocng_specs.dequeue_vm(vm, phead, m) = V5 by defs(simp(e2, bm8), mallocng_specs.dequeue_vm)
  have tb4 := apply(mp.wr64_typed[V := V3, c := int_add(m, 8), v := 0], tb3)
  have tb5 := apply(mp.wr64_typed[V := V4, c := m, v := 0], tb4)
  have fu5 := apply(mp.wr64_only[V := V4, c := m, v := 0, W := vm], apply(mp.wr64_only[V := V3, c := int_add(m, 8), v := 0, W := vm], fu3))
  have r5: all w. w in omega -> int_le(int_add(w, 8), 18446744073709551616) -> (int_le(int_add(m, 16), w) || int_le(int_add(w, 8), m)) ->
      gimple.bytes_at(V5, w, 8) = gimple.bytes_at(V3, w, 8) proof
    fix w
    assume hw hwl ho
    show := trans(apply(mp.w64_out[V := V4, c := m, v := 0, w := w], hm, hw, hwl, arith(mb), arith(ho, hw, mo)),
      apply(mp.w64_out[V := V3, c := int_add(m, 8), v := 0, w := w], m8b, hw, hwl, arith(mb), arith(ho, hw, mo)))
  qed
  have z5: gimple.bytes_at(V5, m, 8) = 0 := apply(mp.rd_at8[vm := V4, c := m, v := 0], tb4, hm, zbits)
  have z58: gimple.bytes_at(V5, int_add(m, 8), 8) = 0 :=
    trans(apply(mp.w64_out[V := V4, c := m, v := 0, w := int_add(m, 8)], hm, simp(mo), arith(mb), arith(mb), arith(mo)),
      apply(mp.rd_at8[vm := V3, c := int_add(m, 8), v := 0], tb3, m8b, zbits))
  have q5: mallocng_specs.rd64(V5, m) = 0 by defs(simp(z5), mallocng_specs.rd64, bits_of_int, pow2)
  have q58: mallocng_specs.rd64(V5, bits_add(64, m, 8)) = 0 by defs(simp(bm8, z58), mallocng_specs.rd64, bits_of_int, pow2)

  // the others' links: as before, but for m's neighbours' links to m
  have wn: all i. i in omega -> int_lt(i, L) -> !(i = k) ->
      ((!(i = IP) -> gimple.bytes_at(V5, int_add(app(l, i), 8), 8) = gimple.bytes_at(vm, int_add(app(l, i), 8), 8)) &&
       (i = IP -> gimple.bytes_at(V5, int_add(app(l, i), 8), 8) = N)) &&
      ((!(i = IN) -> gimple.bytes_at(V5, app(l, i), 8) = gimple.bytes_at(vm, app(l, i), 8)) &&
       (i = IN -> gimple.bytes_at(V5, app(l, i), 8) = P)) proof
    fix i
    assume hi hil hik
    have lo2 lb la := mp(all_elim(ef, {i}), hi, hil)
    have am := rewrite(hlk, mp(all_elim(ea, {i}, {k}), hi, hk, hil, hkl, hik))
    have l8o: int_add(app(l, i), 8) in omega by simp(lo2)
    // through m's links and the head word
    have s1 := trans(mp(all_elim(r5, {int_add(app(l, i), 8)}), l8o, arith(lb), arith(am, lo2, mo)),
      mp(all_elim(r3, {int_add(app(l, i), 8)}), l8o, arith(lb), arith(la, lo2, pho)))
    have s2 := trans(mp(all_elim(r5, {app(l, i)}), lo2, arith(lb), arith(am, lo2, mo)),
      mp(all_elim(r3, {app(l, i)}), lo2, arith(lb), arith(la, lo2, pho)))
    // l_i: P, or apart from it; N likewise
    have qp: app(l, i) = P || int_le(int_add(app(l, i), 16), P) || int_le(int_add(P, 16), app(l, i)) proof
      have a1: i = IP -> app(l, i) = P by simp()
      have a2: !(i = IP) -> int_le(int_add(app(l, i), 16), P) || int_le(int_add(P, 16), app(l, i)) proof
        assume h
        show := mp(all_elim(ea, {i}, {IP}), hi, ipo, hil, ipl, h)
      qed
      show by taut(a1, a2)
    qed
    have qn: app(l, i) = N || int_le(int_add(app(l, i), 16), N) || int_le(int_add(N, 16), app(l, i)) proof
      have a1: i = IN -> app(l, i) = N by simp()
      have a2: !(i = IN) -> int_le(int_add(app(l, i), 16), N) || int_le(int_add(N, 16), app(l, i)) proof
        assume h
        show := mp(all_elim(ea, {i}, {IN}), hi, ino, hil, inl, h)
      qed
      show by taut(a1, a2)
    qed
    // the next link: through N's prev, then P's next
    have u1 := apply(mp.w64_out[V := V1, c := N, v := P, w := int_add(app(l, i), 8)], nbits, l8o, arith(lb), arith(nb), arith(qn, lo2, no))
    have n1: !(i = IP) -> gimple.bytes_at(V5, int_add(app(l, i), 8), 8) = gimple.bytes_at(vm, int_add(app(l, i), 8), 8) proof
      assume h
      have a := mp(all_elim(ea, {i}, {IP}), hi, ipo, hil, ipl, h)
      show := trans(s1, trans(u1, apply(mp.w64_out[V := vm, c := int_add(P, 8), v := N, w := int_add(app(l, i), 8)], p8b, l8o, arith(lb), arith(pb), arith(a, lo2, po))))
    qed
    have n2: i = IP -> gimple.bytes_at(V5, int_add(app(l, i), 8), 8) = N proof
      assume h
      have e: app(l, i) = P by simp(h)
      have r := subst({y. gimple.bytes_at(V1, int_add(y, 8), 8) = N}, sym(e), apply(mp.rd_at8[vm := vm, c := int_add(P, 8), v := N], hb, p8b, nbits))
      show := trans(s1, trans(u1, r))
    qed
    // the prev link: through N's prev
    have v1 := apply(mp.w64_out[V := vm, c := int_add(P, 8), v := N, w := app(l, i)], p8b, lo2, arith(lb), arith(pb), arith(qp, lo2, po))
    have p1: !(i = IN) -> gimple.bytes_at(V5, app(l, i), 8) = gimple.bytes_at(vm, app(l, i), 8) proof
      assume h
      have a := mp(all_elim(ea, {i}, {IN}), hi, ino, hil, inl, h)
      show := trans(s2, trans(apply(mp.w64_out[V := V1, c := N, v := P, w := app(l, i)], nbits, lo2, arith(lb), arith(nb), arith(a, lo2, no)), v1))
    qed
    have p2: i = IN -> gimple.bytes_at(V5, app(l, i), 8) = P proof
      assume h
      have e: app(l, i) = N by simp(h)
      have r := subst({y. gimple.bytes_at(V2, y, 8) = P}, sym(e), apply(mp.rd_at8[vm := V1, c := N, v := P], tb1, nbits, pbits))
      show := trans(s2, r)
    qed
    show by taut(n1, n2, p1, p2)
  qed

  // the list without m
  let R := mallocng_purpose.rm_at(l, k)
  have {dl2 = len, rl = type} := apply(mp.rm_at_app[l := l, k := k, j := 0], hl, hk, hkl)
  have wo: all p. all off. mallocng_specs.word_ok(V5, objs, p, off) = mallocng_specs.word_ok(vm, objs, p, off) proof
    fix p off
    have f := all_elim(ms.f_word_ok, {V5}, {app(vm, "bytes")}, {objs}, {p}, {off})
    show := sym(rewrite(fu5, f))
  qed
  // R's j-th: l's G-th (G = j below k, j + 1 from k on), not m
  have gi: all j. j in omega -> int_lt(j, int_sub(L, 1)) ->
      (nat: ite(int_lt(j, k), j, int_add(j, 1)) in omega && below: int_lt(ite(int_lt(j, k), j, int_add(j, 1)), L)) &&
      not_k: !(ite(int_lt(j, k), j, int_add(j, 1)) = k) && elem: app(R, j) = app(l, ite(int_lt(j, k), j, int_add(j, 1))) proof
    fix j
    assume hj hjl
    have {ra = elem} := apply(mp.rm_at_app[l := l, k := k, j := j], hl, hk, hkl)
    have rj := mp(ra, hj, hjl)
    have a1: int_lt(j, k) -> (ite(int_lt(j, k), j, int_add(j, 1)) in omega && int_lt(ite(int_lt(j, k), j, int_add(j, 1)), L)) &&
        !(ite(int_lt(j, k), j, int_add(j, 1)) = k) proof
      assume h
      have jl: int_lt(j, L) by arith(hj, hjl, lo)
      have jk: !(j = k) by arith(h, hj, hk)
      have kj: !(k = j) by arith(h, hj, hk)
      show by simp(h, hj, jl, jk, kj)
    qed
    have a2: !int_lt(j, k) -> (ite(int_lt(j, k), j, int_add(j, 1)) in omega && int_lt(ite(int_lt(j, k), j, int_add(j, 1)), L)) &&
        !(ite(int_lt(j, k), j, int_add(j, 1)) = k) proof
      assume h
      have j1o: int_add(j, 1) in omega by simp(hj)
      have jl: int_lt(int_add(j, 1), L) by arith(hj, hjl, lo)
      have jk: !(int_add(j, 1) = k) by arith(h, hj, hk)
      have kj: !(k = int_add(j, 1)) by arith(h, hj, hk)
      show by simp(h, j1o, jl, jk, kj)
    qed
    show by taut(a1, a2, rj)
  qed
  have el5: all x0. x0 in omega -> int_lt(x0, seq_len(R)) ->
      ((((int_le(int_add(app(R, x0), 16), int_pow(2, 64)) && mallocng_specs.word_ok(V5, objs, bits_of_int(64, app(R, x0)), 0)) &&
        mallocng_specs.word_ok(V5, objs, bits_of_int(64, app(R, x0)), 8)) && int_mod(app(R, x0), 8) = 0) &&
       (int_le(int_add(phead, 8), app(R, x0)) || int_le(int_add(app(R, x0), 16), phead))) proof
    fix x0
    assume hx hxl
    have {go = nat, gl = below, ge = elem} := mp(all_elim(gi, {x0}), hx, simp(hxl, dl2))
    have e := mp(all_elim(el, {ite(int_lt(x0, k), x0, int_add(x0, 1))}), go, gl)
    have w0 := all_elim(wo, {bits_of_int(64, app(l, ite(int_lt(x0, k), x0, int_add(x0, 1))))}, {0})
    have w8 := all_elim(wo, {bits_of_int(64, app(l, ite(int_lt(x0, k), x0, int_add(x0, 1))))}, {8})
    show by simp(ge, w0, w8, e)
  qed
  have ap5: all x0. all x1. x0 in omega && x1 in omega -> (int_lt(x0, seq_len(R)) && int_lt(x1, seq_len(R))) && !(x0 = x1) ->
      int_le(int_add(app(R, x0), 16), app(R, x1)) || int_le(int_add(app(R, x1), 16), app(R, x0)) proof
    fix x0 x1
    assume ho hq
    have x0o: x0 in omega by taut(ho)
    have x1o: x1 in omega by taut(ho)
    have x0l: int_lt(x0, int_sub(L, 1)) by simp(hq, dl2)
    have x1l: int_lt(x1, int_sub(L, 1)) by simp(hq, dl2)
    have ne: !(x0 = x1) by taut(hq)
    have {g0o = nat, g0l = below, g0e = elem} := mp(all_elim(gi, {x0}), x0o, x0l)
    have {g1o = nat, g1l = below, g1e = elem} := mp(all_elim(gi, {x1}), x1o, x1l)
    // G is one-to-one
    have gne: !(ite(int_lt(x0, k), x0, int_add(x0, 1)) = ite(int_lt(x1, k), x1, int_add(x1, 1))) proof
      have c00: int_lt(x0, k) -> int_lt(x1, k) -> !(ite(int_lt(x0, k), x0, int_add(x0, 1)) = ite(int_lt(x1, k), x1, int_add(x1, 1))) proof
        assume a b
        show by simp(a, b, ne)
      qed
      have c01: int_lt(x0, k) -> !int_lt(x1, k) -> !(ite(int_lt(x0, k), x0, int_add(x0, 1)) = ite(int_lt(x1, k), x1, int_add(x1, 1))) proof
        assume a b
        have d: !(x0 = int_add(x1, 1)) by arith(a, b, x0o, x1o)
        show by simp(a, b, d)
      qed
      have c10: !int_lt(x0, k) -> int_lt(x1, k) -> !(ite(int_lt(x0, k), x0, int_add(x0, 1)) = ite(int_lt(x1, k), x1, int_add(x1, 1))) proof
        assume a b
        have d: !(int_add(x0, 1) = x1) by arith(a, b, x0o, x1o)
        show by simp(a, b, d)
      qed
      have c11: !int_lt(x0, k) -> !int_lt(x1, k) -> !(ite(int_lt(x0, k), x0, int_add(x0, 1)) = ite(int_lt(x1, k), x1, int_add(x1, 1))) proof
        assume a b
        have d: !(int_add(x0, 1) = int_add(x1, 1)) by arith(ne, x0o, x1o)
        show by simp(a, b, d)
      qed
      show by taut(c00, c01, c10, c11)
    qed
    have a := mp(all_elim(ea, {ite(int_lt(x0, k), x0, int_add(x0, 1))}, {ite(int_lt(x1, k), x1, int_add(x1, 1))}), g0o, g1o, g0l, g1l, gne)
    show by simp(g0e, g1e, a)
  qed
  // the head word: R's first (l's second if m was the first)
  have hd5: gimple.bytes_at(V5, phead, 8) = ite(seq_len(R) = 0, 0, app(R, 0)) proof
    have s := trans(mp(all_elim(r5, {phead}), pho, phl, arith(ma, pho, mo)), refl({gimple.bytes_at(V3, phead, 8)}))
    have nz: !(seq_len(R) = 0) by arith(dl2, h2)
    have {r0 = elem} := mp(all_elim(gi, {0}), simp(), (int_lt(0, int_sub(L, 1)) by arith(h2, lo)))
    have q0: k = 0 -> gimple.bytes_at(V5, phead, 8) = ite(seq_len(R) = 0, 0, app(R, 0)) proof
      assume h
      have i1 := mp(in0, h)
      have a: app(R, 0) = N by simp(r0, h, i1)
      show by simp(s, mp(r3h0, h), nz, a)
    qed
    have q1: !(k = 0) -> gimple.bytes_at(V5, phead, 8) = ite(seq_len(R) = 0, 0, app(R, 0)) proof
      assume h
      have kp: int_lt(0, k) by arith(h, hk)
      have a: app(R, 0) = app(l, 0) by simp(r0, kp)
      show by simp(s, mp(r3h1, h), nz, a)
    qed
    show by taut(q0, q1)
  qed
  // the links: l's, but around m
  have ws5: all i. i in omega -> int_lt(i, seq_len(R)) ->
      gimple.bytes_at(V5, int_add(app(R, i), 8), 8) = app(R, int_mod(int_add(i, 1), seq_len(R))) &&
      gimple.bytes_at(V5, app(R, i), 8) = app(R, int_mod(int_sub(int_add(i, seq_len(R)), 1), seq_len(R))) proof
    fix j
    assume hj hjl0
    have hjl: int_lt(j, int_sub(L, 1)) by simp(hjl0, dl2)
    let G := ite(int_lt(j, k), j, int_add(j, 1))
    have go gl gk ge := mp(all_elim(gi, {j}), hj, hjl)
    have wl0 wl1 := apply(mp.rm_next[L := L, k := k, j := j], lo, hk, hj, h2, hkl, hjl)
    have wp0 wp1 := apply(mp.rm_prev[L := L, k := k, j := j], lo, hk, hj, h2, hkl, hjl)
    let J1 := int_mod(int_add(j, 1), int_sub(L, 1))
    let J2 := int_mod(int_sub(int_add(j, int_sub(L, 1)), 1), int_sub(L, 1))
    have j1o: J1 in omega by arith(lo, h2, hj)
    have j1l: int_lt(J1, int_sub(L, 1)) by arith(lo, h2, hj)
    have j2o: J2 in omega by arith(lo, h2, hj)
    have j2l: int_lt(J2, int_sub(L, 1)) by arith(lo, h2, hj)
    have {r1 = elem} := mp(all_elim(gi, {J1}), j1o, j1l)
    have {r2 = elem} := mp(all_elim(gi, {J2}), j2o, j2l)
    have {lw = links} := apply(mp.list_rd[vm := vm, objs := objs, phead := phead, l := l, i := G], hb, hp, hl, H)
    have ln lp := mp(lw, go, gl)
    have wg := mp(all_elim(wn, {G}), go, gl, gk)
    have wa wb wc wd := wg
    // the next link
    have nx0: !(G = IP) -> gimple.bytes_at(V5, int_add(app(l, G), 8), 8) = app(R, J1) proof
      assume h
      show by simp(r1, mp(wl0, h), mp(wa, h), ln)
    qed
    have nx1: G = IP -> gimple.bytes_at(V5, int_add(app(l, G), 8), 8) = app(R, J1) proof
      assume h
      show by simp(r1, mp(wl1, h), mp(wb, h))
    qed
    // the prev link
    have pv0: !(G = IN) -> gimple.bytes_at(V5, app(l, G), 8) = app(R, J2) proof
      assume h
      show by simp(r2, mp(wp0, h), mp(wc, h), lp)
    qed
    have pv1: G = IN -> gimple.bytes_at(V5, app(l, G), 8) = app(R, J2) proof
      assume h
      show by simp(r2, mp(wp1, h), mp(wd, h))
    qed
    have nx: gimple.bytes_at(V5, int_add(app(l, G), 8), 8) = app(R, J1) by taut(nx0, nx1)
    have pv: gimple.bytes_at(V5, app(l, G), 8) = app(R, J2) by taut(pv0, pv1)
    show by simp(ge, dl2, nx, pv)
  qed
  have hal5: mallocng_specs.al8(phead) := hal
  have hok5: mallocng_specs.word_ok(V5, objs, phead, 0) by simp(all_elim(wo, {phead}, {0}), hok)
  have la := apply(mp.list_mk[vm := V5, objs := objs, phead := phead, l := R], tb5, hp, rl, hok5, hal5, el5, ap5, hd5, ws5)

  // no byte but the links and the head word written
  have lo5: all x0. x0 in omega -> (int_lt(x0, int_pow(2, 64)) && !(int_le(phead, x0) && int_lt(x0, int_add(phead, 8)))) &&
      (all x1. x1 in omega -> int_lt(x1, L) -> !(int_le(app(l, x1), x0) && int_lt(x0, int_add(app(l, x1), 16)))) ->
      app(app(V5, "bytes"), bits_of_int(64, x0)) = app(app(vm, "bytes"), bits_of_int(64, x0)) proof
    fix x0
    assume hx hq
    have xl: int_lt(x0, 18446744073709551616) by arith(hq)
    have xp: !(int_le(phead, x0) && int_lt(x0, int_add(phead, 8))) by taut(hq)
    have xa: all x1. x1 in omega -> int_lt(x1, L) -> !(int_le(app(l, x1), x0) && int_lt(x0, int_add(app(l, x1), 16))) by taut(hq)
    have xb: x0 in bits(64) by simp(hx, xl)
    have bx: bits_of_int(64, x0) = x0 by defs(simp(hx, xl), bits_of_int, pow2)
    have om := rewrite(hlk, mp(all_elim(xa, {k}), hk, hkl))
    have op := mp(all_elim(xa, {IP}), ipo, ipl)
    have on := mp(all_elim(xa, {IN}), ino, inl)
    have b5 := apply(mp.wb_out[V := V4, c := m, v := 0, x := x0], xb, hm, arith(mb), arith(om, hx, mo))
    have b4 := apply(mp.wb_out[V := V3, c := int_add(m, 8), v := 0, x := x0], xb, m8b, arith(mb), arith(om, hx, mo))
    have b3 := mp(all_elim(r3b, {x0}), xb, arith(xp, hx, pho))
    have b2 := apply(mp.wb_out[V := V1, c := N, v := P, x := x0], xb, nbits, arith(nb), arith(on, hx, no))
    have b1 := apply(mp.wb_out[V := vm, c := int_add(P, 8), v := N, x := x0], xb, p8b, arith(pb), arith(op, hx, po))
    show by simp(bx, trans(b5, trans(b4, trans(b3, trans(b2, b1)))))
  qed
  have lk: mallocng_purpose.links_only(vm, V5, phead, l) by defs(taut(fu5, lo5), mallocng_purpose.links_only)
  have all5: ((mallocng_purpose.list_at(V5, objs, phead, R) && mallocng_specs.rd64(V5, m) = 0) && mallocng_specs.rd64(V5, bits_add(64, m, 8)) = 0) &&
    mallocng_purpose.links_only(vm, V5, phead, l) by taut(la, q5, q58, lk)
  show := subst({y. ((mallocng_purpose.list_at(y, objs, phead, R) && mallocng_specs.rd64(y, m) = 0) && mallocng_specs.rd64(y, bits_add(64, m, 8)) = 0) &&
    mallocng_purpose.links_only(vm, y, phead, l)}, sym(e5), all5)
qed

// m in the list at *phead: dequeue's precondition holds (the words it
// writes usable, aligned, apart); m is its own successor just when alone
theorem mp.dq_pre(vm, objs, phead, m, l, k): app(vm, "bytes") in fn_space(bits(64), bits(8)) -> phead in bits(64) -> m in bits(64) ->
  l in list_type(omega) -> k in omega -> int_lt(k, seq_len(l)) -> app(l, k) = m -> mallocng_purpose.list_at(vm, objs, phead, l) ->
  pre: mallocng_specs.dequeue_pre(vm, objs, phead, m) && alone: (seq_len(l) = 1 <-> mallocng_specs.mnext(vm, m) = m)
proof
  assume hb hp hm hl hk hkl hlk H
  let L := seq_len(l)
  let IP := int_mod(int_sub(int_add(k, L), 1), L)
  let IN := int_mod(int_add(k, 1), L)
  let P := app(l, IP)
  let N := app(l, IN)
  have {hok = head, hal = head_al, el = elems, ap = apart} := expand(H, mallocng_purpose.list_at)
  have lo: L in omega by arith(hl)
  have mo: m in omega by simp(hm)
  have pho: phead in omega by simp(hp)
  have mb0 mw0 mw8 mm ma := rewrite(hlk, mp(all_elim(el, {k}), hk, hkl))
  have bm: bits_of_int(64, m) = m by defs(simp(hm), bits_of_int, pow2)
  have mwa := rewrite(bm, mw0)
  have mwb := rewrite(bm, mw8)
  have bm8: bits_add(64, m, 8) = int_add(m, 8) by defs(arith(mo, mb0), bits_add, bits_of_int, pow2)
  have {ws0 = links} := apply(mp.list_rd[vm := vm, objs := objs, phead := phead, l := l, i := k], hb, hp, hl, H)
  have rn0 rp0 := mp(ws0, hk, hkl)
  have rn := rewrite(hlk, rn0)
  have rp := rewrite(hlk, rp0)
  have ino: IN in omega by arith(hk, lo, hkl)
  have inl: int_lt(IN, L) by arith(hk, lo, hkl)
  have no := apply(at_type[l := l, t := omega, i := IN], hl, ino, inl)
  have {nb = bound, nw0 = prev_ok, nm = al, na = off_head} := mp(all_elim(el, {IN}), ino, inl)
  have nlt: int_lt(N, 18446744073709551616) by arith(nb)
  have eN: mallocng_specs.mnext(vm, m) = N by defs(simp(bm8, rn, no, nlt), mallocng_specs.mnext, mallocng_specs.rd64, bits_of_int, pow2)
  have al8m: mallocng_specs.al8(m) by defs(mm, mallocng_specs.al8)
  have pm1: !(phead = m) by arith(ma, mo, pho)
  have pm2: !(phead = int_add(m, 8)) by arith(ma, mo, pho)
  // alone: its own successor
  have a1: L = 1 -> mallocng_specs.mnext(vm, m) = m proof
    assume h
    have k0: k = 0 by arith(h, hk, hkl, lo)
    have i0: IN = 0 by arith(h, hk, lo)
    have e: N = m by simp(i0, rewrite(k0, hlk))
    show := trans(eN, e)
  qed
  // with others: its neighbours' links apart from its own and the head word
  have a2: !(L = 1) -> !(mallocng_specs.mnext(vm, m) = m) &&
      ((((((((mallocng_specs.word_ok(vm, objs, mallocng_specs.mprev(vm, m), 8) && mallocng_specs.word_ok(vm, objs, mallocng_specs.mnext(vm, m), 0)) &&
        mallocng_specs.al8(mallocng_specs.mprev(vm, m))) && mallocng_specs.al8(mallocng_specs.mnext(vm, m))) && !(mallocng_specs.mprev(vm, m) = m)) &&
        !(int_add(mallocng_specs.mprev(vm, m), 8) = m)) && !(mallocng_specs.mnext(vm, m) = int_add(m, 8))) && !(int_add(mallocng_specs.mprev(vm, m), 8) = phead)) &&
        !(mallocng_specs.mnext(vm, m) = phead)) && !(int_add(mallocng_specs.mprev(vm, m), 8) = mallocng_specs.mnext(vm, m)) proof
    assume h
    have h2: int_le(2, L) by arith(h, hk, hkl, lo)
    have {ipk = pred_ne, ink = succ_ne} := apply(mp.nb_idx[L := L, k := k], lo, hk, h2, hkl)
    have ipo: IP in omega by arith(hk, lo, h2)
    have ipl: int_lt(IP, L) by arith(hk, lo, h2)
    have po := apply(at_type[l := l, t := omega, i := IP], hl, ipo, ipl)
    have {pb = bound, pw8 = next_ok, pm = al, pa = off_head} := mp(all_elim(el, {IP}), ipo, ipl)
    have plt: int_lt(P, 18446744073709551616) by arith(pb)
    have eP: mallocng_specs.mprev(vm, m) = P by defs(simp(rp, po, plt), mallocng_specs.mprev, mallocng_specs.rd64, bits_of_int, pow2)
    have bp: bits_of_int(64, P) = P by defs(simp(po, plt), bits_of_int, pow2)
    have bn: bits_of_int(64, N) = N by defs(simp(no, nlt), bits_of_int, pow2)
    have pw := rewrite(bp, pw8)
    have nw := rewrite(bn, nw0)
    have pmd := rewrite(hlk, mp(all_elim(ap, {IP}, {k}), taut(ipo, hk), taut(ipl, hkl, ipk)))
    have nmd := rewrite(hlk, mp(all_elim(ap, {IN}, {k}), taut(ino, hk), taut(inl, hkl, ink)))
    // P and N: the same element, or apart
    have qpn: P = N || int_le(int_add(P, 16), N) || int_le(int_add(N, 16), P) proof
      have b1: IP = IN -> P = N by simp()
      have b2: !(IP = IN) -> int_le(int_add(P, 16), N) || int_le(int_add(N, 16), P) proof
        assume hne
        show := mp(all_elim(ap, {IP}, {IN}), taut(ipo, ino), taut(ipl, inl, hne))
      qed
      show by taut(b1, b2)
    qed
    have f1: mallocng_specs.al8(P) by defs(pm, mallocng_specs.al8)
    have f2: mallocng_specs.al8(N) by defs(nm, mallocng_specs.al8)
    have f3: !(P = m) by arith(pmd, po, mo)
    have f4: !(int_add(P, 8) = m) by arith(pmd, po, mo)
    have f5: !(N = int_add(m, 8)) by arith(nmd, no, mo)
    have f6: !(int_add(P, 8) = phead) by arith(pa, po, pho)
    have f7: !(N = phead) by arith(na, no, pho)
    have f8: !(int_add(P, 8) = N) by arith(qpn, po, no)
    have f9: !(N = m) by arith(nmd, no, mo)
    show by simp(eN, eP, pw, nw, f1, f2, f3, f4, f5, f6, f7, f8, f9)
  qed
  have tl: !(mallocng_specs.mnext(vm, m) = m) ->
      ((((((((mallocng_specs.word_ok(vm, objs, mallocng_specs.mprev(vm, m), 8) && mallocng_specs.word_ok(vm, objs, mallocng_specs.mnext(vm, m), 0)) &&
        mallocng_specs.al8(mallocng_specs.mprev(vm, m))) && mallocng_specs.al8(mallocng_specs.mnext(vm, m))) && !(mallocng_specs.mprev(vm, m) = m)) &&
        !(int_add(mallocng_specs.mprev(vm, m), 8) = m)) && !(mallocng_specs.mnext(vm, m) = int_add(m, 8))) && !(int_add(mallocng_specs.mprev(vm, m), 8) = phead)) &&
        !(mallocng_specs.mnext(vm, m) = phead)) && !(int_add(mallocng_specs.mprev(vm, m), 8) = mallocng_specs.mnext(vm, m)) by taut(a1, a2)
  have dp: mallocng_specs.dequeue_pre(vm, objs, phead, m) by defs(taut(hok, mwa, mwb, hal, al8m, pm1, pm2, tl), mallocng_specs.dequeue_pre)
  have io: seq_len(l) = 1 <-> mallocng_specs.mnext(vm, m) = m by taut(a1, a2)
  show by taut(dp, io)
qed

// dequeue's effect on the list at *phead holding only m: the list empty,
// m's links cleared, nothing else written
theorem mp.dq_list1(vm, objs, phead, m, l, k): vm in x86_64_linux.Vm -> app(vm, "bytes") in fn_space(bits(64), bits(8)) -> phead in bits(64) -> m in bits(64) ->
  l in list_type(omega) -> k in omega -> int_lt(k, seq_len(l)) -> seq_len(l) = 1 -> app(l, k) = m ->
  mallocng_purpose.list_at(vm, objs, phead, l) ->
  ((mallocng_purpose.list_at(mallocng_specs.dequeue_vm(vm, phead, m), objs, phead, mallocng_purpose.rm_at(l, k)) &&
     mallocng_specs.rd64(mallocng_specs.dequeue_vm(vm, phead, m), m) = 0) && mallocng_specs.rd64(mallocng_specs.dequeue_vm(vm, phead, m), bits_add(64, m, 8)) = 0) &&
  mallocng_purpose.links_only(vm, mallocng_specs.dequeue_vm(vm, phead, m), phead, l)
proof
  assume hvm hb hp hm hl hk hkl h1 hlk H
  let L := seq_len(l)
  let N := mallocng_specs.mnext(vm, m)
  have {hok = head, hal = head_al, el = elems, ap = apart} := expand(H, mallocng_purpose.list_at)
  have lo: L in omega by arith(hl)
  have mo: m in omega by simp(hm)
  have pho: phead in omega by simp(hp)
  have {phl0 = bound} := expand(hok, mallocng_specs.word_ok)
  have phl: int_le(int_add(phead, 8), 18446744073709551616) by arith(phl0, pho)
  have {mb0 = bound, ma = off_head} := rewrite(hlk, mp(all_elim(el, {k}), hk, hkl))
  have mb: int_le(int_add(m, 16), 18446744073709551616) by arith(mb0)
  have bm8: bits_add(64, m, 8) = int_add(m, 8) by defs(arith(mo, mb), bits_add, bits_of_int, pow2)
  have m8b: int_add(m, 8) in bits(64) by simp(mo, (int_lt(int_add(m, 8), 18446744073709551616) by arith(mb)))
  have zbits: 0 in bits(64) by simp()
  have {io = alone} := apply(mp.dq_pre[vm := vm, objs := objs, phead := phead, m := m, l := l, k := k], hb, hp, hm, hl, hk, hkl, hlk, H)
  have nm: N = m by taut(io, h1)
  // dequeue_vm of m alone: the head word cleared, then m's links
  have nn: !!(N = m) by taut(nm)
  have nc: !(!(N = m) && mallocng_specs.rd64(mallocng_specs.wr64(vm, phead, 0), phead) = m) by taut(nn)
  have dl: mallocng_specs.dq_links(vm, phead, m) = mallocng_specs.wr64(vm, phead, 0)
    by defs(mp(tr.ite_f[c := !(N = m), a := mallocng_specs.wr64(mallocng_specs.wr64(vm, bits_add(64, mallocng_specs.mprev(vm, m), 8), N), N, mallocng_specs.mprev(vm, m)),
      b := mallocng_specs.wr64(vm, phead, 0)], nn), mallocng_specs.dq_links)
  have dh: mallocng_specs.dq_head(mallocng_specs.wr64(vm, phead, 0), vm, phead, m) = mallocng_specs.wr64(vm, phead, 0)
    by defs(mp(tr.ite_f[c := !(N = m) && mallocng_specs.rd64(mallocng_specs.wr64(vm, phead, 0), phead) = m, a := mallocng_specs.wr64(mallocng_specs.wr64(vm, phead, 0), phead, N),
      b := mallocng_specs.wr64(vm, phead, 0)], nc), mallocng_specs.dq_head)
  let V1 := mallocng_specs.wr64(vm, phead, 0)
  let V2 := mallocng_specs.wr64(V1, int_add(m, 8), 0)
  let V3 := mallocng_specs.wr64(V2, m, 0)
  have d0: mallocng_specs.dequeue_vm(vm, phead, m) = mallocng_specs.wr64(mallocng_specs.wr64(mallocng_specs.dq_head(mallocng_specs.dq_links(vm, phead, m), vm, phead, m), bits_add(64, m, 8), 0), m, 0)
    by defs(refl({mallocng_specs.wr64(mallocng_specs.wr64(mallocng_specs.dq_head(mallocng_specs.dq_links(vm, phead, m), vm, phead, m), bits_add(64, m, 8), 0), m, 0)}), mallocng_specs.dequeue_vm)
  have e3: mallocng_specs.dequeue_vm(vm, phead, m) = V3 := rewrite(bm8, rewrite(dh, rewrite(dl, d0)))
  have tb1 := apply(mp.wr64_typed[V := vm, c := phead, v := 0], hb)
  have tb2 := apply(mp.wr64_typed[V := V1, c := int_add(m, 8), v := 0], tb1)
  have tb3 := apply(mp.wr64_typed[V := V2, c := m, v := 0], tb2)
  have vf: is_fun(vm) by simp(hvm)
  have vd: "bytes" in dom(vm) by simp(hvm)
  have vs := apply(fn_update_same[f := vm, k := "bytes"], vf, vd)
  have fu3 := apply(mp.wr64_only[V := V2, c := m, v := 0, W := vm], apply(mp.wr64_only[V := V1, c := int_add(m, 8), v := 0, W := vm],
    apply(mp.wr64_only[V := vm, c := phead, v := 0, W := vm], vs)))
  // the words: all three cleared
  have hd: gimple.bytes_at(V3, phead, 8) = 0 :=
    trans(apply(mp.w64_out[V := V2, c := m, v := 0, w := phead], hm, pho, phl, arith(mb), arith(ma, mo, pho)),
      trans(apply(mp.w64_out[V := V1, c := int_add(m, 8), v := 0, w := phead], m8b, pho, phl, arith(mb), arith(ma, mo, pho)),
        apply(mp.rd_at8[vm := vm, c := phead, v := 0], hb, hp, zbits)))
  have z0: gimple.bytes_at(V3, m, 8) = 0 := apply(mp.rd_at8[vm := V2, c := m, v := 0], tb2, hm, zbits)
  have z8: gimple.bytes_at(V3, int_add(m, 8), 8) = 0 :=
    trans(apply(mp.w64_out[V := V2, c := m, v := 0, w := int_add(m, 8)], hm, simp(mo), arith(mb), arith(mb), arith(mo)),
      apply(mp.rd_at8[vm := V1, c := int_add(m, 8), v := 0], tb1, m8b, zbits))
  have q0: mallocng_specs.rd64(V3, m) = 0 by defs(simp(z0), mallocng_specs.rd64, bits_of_int, pow2)
  have q8: mallocng_specs.rd64(V3, bits_add(64, m, 8)) = 0 by defs(simp(bm8, z8), mallocng_specs.rd64, bits_of_int, pow2)
  // the list: empty
  let R := mallocng_purpose.rm_at(l, k)
  have {dl2 = len, rl = type} := apply(mp.rm_at_app[l := l, k := k, j := 0], hl, hk, hkl)
  have r0: seq_len(R) = 0 by arith(dl2, h1)
  have wo: all p. all off. mallocng_specs.word_ok(V3, objs, p, off) = mallocng_specs.word_ok(vm, objs, p, off) proof
    fix p off
    have f := all_elim(ms.f_word_ok, {V3}, {app(vm, "bytes")}, {objs}, {p}, {off})
    show := sym(rewrite(fu3, f))
  qed
  have hok3: mallocng_specs.word_ok(V3, objs, phead, 0) by simp(all_elim(wo, {phead}, {0}), hok)
  have el3: all x0. x0 in omega -> int_lt(x0, seq_len(R)) ->
      ((((int_le(int_add(app(R, x0), 16), int_pow(2, 64)) && mallocng_specs.word_ok(V3, objs, bits_of_int(64, app(R, x0)), 0)) &&
        mallocng_specs.word_ok(V3, objs, bits_of_int(64, app(R, x0)), 8)) && int_mod(app(R, x0), 8) = 0) &&
       (int_le(int_add(phead, 8), app(R, x0)) || int_le(int_add(app(R, x0), 16), phead))) proof
    fix x0
    assume hx hxl
    have f: false by arith(hx, hxl, r0)
    show by taut(f)
  qed
  have ap3: all x0. all x1. x0 in omega && x1 in omega -> (int_lt(x0, seq_len(R)) && int_lt(x1, seq_len(R))) && !(x0 = x1) ->
      int_le(int_add(app(R, x0), 16), app(R, x1)) || int_le(int_add(app(R, x1), 16), app(R, x0)) proof
    fix x0 x1
    assume ho hq
    have x0o: x0 in omega by taut(ho)
    have x0l: int_lt(x0, seq_len(R)) by taut(hq)
    have f: false by arith(x0o, x0l, r0)
    show by taut(f)
  qed
  have hd3: gimple.bytes_at(V3, phead, 8) = ite(seq_len(R) = 0, 0, app(R, 0)) by simp(hd, r0)
  have ws3: all i. i in omega -> int_lt(i, seq_len(R)) ->
      gimple.bytes_at(V3, int_add(app(R, i), 8), 8) = app(R, int_mod(int_add(i, 1), seq_len(R))) &&
      gimple.bytes_at(V3, app(R, i), 8) = app(R, int_mod(int_sub(int_add(i, seq_len(R)), 1), seq_len(R))) proof
    fix i
    assume hi hil
    have f: false by arith(hi, hil, r0)
    show by taut(f)
  qed
  have la := apply(mp.list_mk[vm := V3, objs := objs, phead := phead, l := R], tb3, hp, rl, hok3, hal, el3, ap3, hd3, ws3)
  // no byte but the head word and m's links written
  have lo3: all x0. x0 in omega -> (int_lt(x0, int_pow(2, 64)) && !(int_le(phead, x0) && int_lt(x0, int_add(phead, 8)))) &&
      (all x1. x1 in omega -> int_lt(x1, L) -> !(int_le(app(l, x1), x0) && int_lt(x0, int_add(app(l, x1), 16)))) ->
      app(app(V3, "bytes"), bits_of_int(64, x0)) = app(app(vm, "bytes"), bits_of_int(64, x0)) proof
    fix x0
    assume hx hq
    have xl: int_lt(x0, 18446744073709551616) by arith(hq)
    have xp: !(int_le(phead, x0) && int_lt(x0, int_add(phead, 8))) by taut(hq)
    have xa: all x1. x1 in omega -> int_lt(x1, L) -> !(int_le(app(l, x1), x0) && int_lt(x0, int_add(app(l, x1), 16))) by taut(hq)
    have xb: x0 in bits(64) by simp(hx, xl)
    have bx: bits_of_int(64, x0) = x0 by defs(simp(hx, xl), bits_of_int, pow2)
    have om := rewrite(hlk, mp(all_elim(xa, {k}), hk, hkl))
    have b3 := apply(mp.wb_out[V := V2, c := m, v := 0, x := x0], xb, hm, arith(mb), arith(om, hx, mo))
    have b2 := apply(mp.wb_out[V := V1, c := int_add(m, 8), v := 0, x := x0], xb, m8b, arith(mb), arith(om, hx, mo))
    have b1 := apply(mp.wb_out[V := vm, c := phead, v := 0, x := x0], xb, hp, phl, arith(xp, hx, pho))
    show by simp(bx, trans(b3, trans(b2, b1)))
  qed
  have lk: mallocng_purpose.links_only(vm, V3, phead, l) by defs(taut(fu3, lo3), mallocng_purpose.links_only)
  have all3: ((mallocng_purpose.list_at(V3, objs, phead, R) && mallocng_specs.rd64(V3, m) = 0) && mallocng_specs.rd64(V3, bits_add(64, m, 8)) = 0) &&
    mallocng_purpose.links_only(vm, V3, phead, l) by taut(la, q0, q8, lk)
  show := subst({y. ((mallocng_purpose.list_at(y, objs, phead, R) && mallocng_specs.rd64(y, m) = 0) && mallocng_specs.rd64(y, bits_add(64, m, 8)) = 0) &&
    mallocng_purpose.links_only(vm, y, phead, l)}, sym(e3), all3)
qed

// dequeue's effect is what it is for: for any list at *phead holding m
theorem mp.dq_done(vm, objs, phead, m): vm in x86_64_linux.Vm -> app(vm, "bytes") in fn_space(bits(64), bits(8)) -> phead in bits(64) -> m in bits(64) ->
  mallocng_purpose.dequeued(vm, mallocng_specs.dequeue_vm(vm, phead, m), objs, phead, m)
proof
  assume hvm hb hp hm
  have a: all x0. all x1. x0 in list_type(omega) && x1 in omega -> (mallocng_purpose.list_at(vm, objs, phead, x0) && int_lt(x1, seq_len(x0))) && app(x0, x1) = m ->
      ((mallocng_purpose.list_at(mallocng_specs.dequeue_vm(vm, phead, m), objs, phead, mallocng_purpose.rm_at(x0, x1)) &&
        mallocng_specs.rd64(mallocng_specs.dequeue_vm(vm, phead, m), m) = 0) && mallocng_specs.rd64(mallocng_specs.dequeue_vm(vm, phead, m), bits_add(64, m, 8)) = 0) &&
      mallocng_purpose.links_only(vm, mallocng_specs.dequeue_vm(vm, phead, m), phead, x0) proof
    fix l k
    assume ht hq
    have hl: l in list_type(omega) by taut(ht)
    have hk: k in omega by taut(ht)
    have H: mallocng_purpose.list_at(vm, objs, phead, l) by taut(hq)
    have hkl: int_lt(k, seq_len(l)) by taut(hq)
    have hlk: app(l, k) = m by taut(hq)
    have lo: seq_len(l) in omega by arith(hl)
    have c1: seq_len(l) = 1 -> ((mallocng_purpose.list_at(mallocng_specs.dequeue_vm(vm, phead, m), objs, phead, mallocng_purpose.rm_at(l, k)) &&
        mallocng_specs.rd64(mallocng_specs.dequeue_vm(vm, phead, m), m) = 0) && mallocng_specs.rd64(mallocng_specs.dequeue_vm(vm, phead, m), bits_add(64, m, 8)) = 0) &&
        mallocng_purpose.links_only(vm, mallocng_specs.dequeue_vm(vm, phead, m), phead, l) proof
      assume h
      show := apply(mp.dq_list1[vm := vm, objs := objs, phead := phead, m := m, l := l, k := k], hvm, hb, hp, hm, hl, hk, hkl, h, hlk, H)
    qed
    have c2: !(seq_len(l) = 1) -> ((mallocng_purpose.list_at(mallocng_specs.dequeue_vm(vm, phead, m), objs, phead, mallocng_purpose.rm_at(l, k)) &&
        mallocng_specs.rd64(mallocng_specs.dequeue_vm(vm, phead, m), m) = 0) && mallocng_specs.rd64(mallocng_specs.dequeue_vm(vm, phead, m), bits_add(64, m, 8)) = 0) &&
        mallocng_purpose.links_only(vm, mallocng_specs.dequeue_vm(vm, phead, m), phead, l) proof
      assume h
      have h2: int_le(2, seq_len(l)) by arith(h, hk, hkl, lo)
      show := apply(mp.dq_list2[vm := vm, objs := objs, phead := phead, m := m, l := l, k := k], hvm, hb, hp, hm, hl, hk, hkl, h2, hlk, H)
    qed
    show by taut(c1, c2)
  qed
  show by defs(a, mallocng_purpose.dequeued)
qed

// the head word of a list: its first element (0 for an empty list), for
// whichever list is there
theorem mp.head_is(vm, objs, phead, l): app(vm, "bytes") in fn_space(bits(64), bits(8)) -> phead in bits(64) -> l in list_type(omega) ->
  mallocng_purpose.list_at(vm, objs, phead, l) ->
  value: mallocng_specs.rd64(vm, phead) = ite(seq_len(l) = 0, 0, app(l, 0)) && is_head: mallocng_purpose.is_head(vm, objs, phead, mallocng_specs.rd64(vm, phead))
proof
  assume hb hp hl H
  have bo bl := mp(all_elim(g.bytes_bound, {vm}, {phead}, {8}), hb, simp())
  have rv: mallocng_specs.rd64(vm, phead) = gimple.bytes_at(vm, phead, 8) by defs(simp(bo, bl), mallocng_specs.rd64, bits_of_int, pow2)
  have {hd = head} := apply(mp.list_rd[vm := vm, objs := objs, phead := phead, l := l, i := 0], hb, hp, hl, H)
  have ih: all x0. x0 in list_type(omega) -> mallocng_purpose.list_at(vm, objs, phead, x0) -> mallocng_specs.rd64(vm, phead) = ite(seq_len(x0) = 0, 0, app(x0, 0)) proof
    fix l2
    assume hl2 H2
    have {hd2 = head} := apply(mp.list_rd[vm := vm, objs := objs, phead := phead, l := l2, i := 0], hb, hp, hl2, H2)
    show := trans(rv, hd2)
  qed
  show by defs(taut(trans(rv, hd), ih), mallocng_purpose.is_head)
qed


// ----------------------------------------------------------------------
//  queue's effect on a list: m appended (`l ++ [m]`); free_meta's: m's
//  meta zeroed, then appended

// l with x appended: its length, its type, its elements
theorem mp.snoc(l, x, j): l in list_type(omega) -> x in omega ->
  (len: seq_len(seq_concat(l, seq_one(x))) = int_add(seq_len(l), 1) && type: seq_concat(l, seq_one(x)) in list_type(omega)) &&
  elem: (j in omega -> int_lt(j, seq_len(l)) -> app(seq_concat(l, seq_one(x)), j) = app(l, j)) && last: app(seq_concat(l, seq_one(x)), seq_len(l)) = x
proof
  assume hl hx
  have ln: seq_len(seq_concat(l, seq_one(x))) = int_add(seq_len(l), 1) by arith(hl)
  have one := apply(tr.seq_one_type, hx)
  have ty := apply(tr.concat_list, hl, one)
  have a1: j in omega -> int_lt(j, seq_len(l)) -> app(seq_concat(l, seq_one(x)), j) = app(l, j) proof
    assume hj hjl
    show := at({app(seq_concat(l, seq_one(x)), j)}, hl, hj, hjl)
  qed
  have lo: seq_len(l) in omega by arith(hl)
  have a2 := at({app(seq_concat(l, seq_one(x)), seq_len(l))}, hl, lo)
  show by taut(ln, ty, a1, simp(a2))
qed

// an element of the list at *phead: a natural, its links accessible,
// aligned, apart from the head word
theorem mp.list_el(vm, objs, phead, l, i): l in list_type(omega) -> mallocng_purpose.list_at(vm, objs, phead, l) -> i in omega -> int_lt(i, seq_len(l)) ->
  ((((nat: app(l, i) in omega && bound: int_le(int_add(app(l, i), 16), 18446744073709551616)) && prev_ok: mallocng_specs.word_ok(vm, objs, app(l, i), 0)) &&
    next_ok: mallocng_specs.word_ok(vm, objs, app(l, i), 8)) && al: int_mod(app(l, i), 8) = 0) &&
  off_head: (int_le(int_add(phead, 8), app(l, i)) || int_le(int_add(app(l, i), 16), phead))
proof
  assume hl H hi hil
  have {el = elems} := expand(H, mallocng_purpose.list_at)
  have lo := apply(at_type[l := l, t := omega, i := i], hl, hi, hil)
  have lb w0 w8 lm la := mp(all_elim(el, {i}), hi, hil)
  have lb2: int_le(int_add(app(l, i), 16), 18446744073709551616) by arith(lb)
  have bl: bits_of_int(64, app(l, i)) = app(l, i) by defs(simp(lo, (int_lt(app(l, i), 18446744073709551616) by arith(lb))), bits_of_int, pow2)
  show by taut(lo, lb2, rewrite(bl, w0), rewrite(bl, w8), lm, la)
qed

// l ++ [m], m joinable: its elements' facts and apartness, on any memory V
// differing from vm in bytes only (as `list_at` states them)
theorem mp.snoc_ok(vm, V, objs, phead, l, m): m in bits(64) -> l in list_type(omega) -> mallocng_purpose.list_at(vm, objs, phead, l) ->
  mallocng_purpose.joinable(vm, objs, phead, l, m) -> fn_update(V, "bytes", app(vm, "bytes")) = vm ->
  (all x0. x0 in omega -> int_lt(x0, seq_len(seq_concat(l, seq_one(m)))) ->
     ((((int_le(int_add(app(seq_concat(l, seq_one(m)), x0), 16), int_pow(2, 64)) && mallocng_specs.word_ok(V, objs, bits_of_int(64, app(seq_concat(l, seq_one(m)), x0)), 0)) &&
       mallocng_specs.word_ok(V, objs, bits_of_int(64, app(seq_concat(l, seq_one(m)), x0)), 8)) && int_mod(app(seq_concat(l, seq_one(m)), x0), 8) = 0) &&
      (int_le(int_add(phead, 8), app(seq_concat(l, seq_one(m)), x0)) || int_le(int_add(app(seq_concat(l, seq_one(m)), x0), 16), phead)))) &&
  (all x0. all x1. x0 in omega && x1 in omega -> (int_lt(x0, seq_len(seq_concat(l, seq_one(m)))) && int_lt(x1, seq_len(seq_concat(l, seq_one(m))))) && !(x0 = x1) ->
     int_le(int_add(app(seq_concat(l, seq_one(m)), x0), 16), app(seq_concat(l, seq_one(m)), x1)) || int_le(int_add(app(seq_concat(l, seq_one(m)), x1), 16), app(seq_concat(l, seq_one(m)), x0)))
proof
  assume hm hl H J fu
  let R := seq_concat(l, seq_one(m))
  let L := seq_len(l)
  have mo: m in omega by simp(hm)
  have lo: L in omega by arith(hl)
  have {rl = len, rL = last} := apply(mp.snoc[l := l, x := m, j := 0], hl, mo)
  have {el = elems, ap = apart} := expand(H, mallocng_purpose.list_at)
  have {jb = bound, jw0 = prev_ok, jw8 = next_ok, jm = al, ja = off_head, jl = off_list} := expand(J, mallocng_purpose.joinable)
  have wo: all p. all off. mallocng_specs.word_ok(V, objs, p, off) = mallocng_specs.word_ok(vm, objs, p, off) proof
    fix p off
    have f := all_elim(ms.f_word_ok, {V}, {app(vm, "bytes")}, {objs}, {p}, {off})
    show := sym(rewrite(fu, f))
  qed
  have bm: bits_of_int(64, m) = m by defs(simp(hm), bits_of_int, pow2)
  have e: all x0. x0 in omega -> int_lt(x0, seq_len(R)) ->
      ((((int_le(int_add(app(R, x0), 16), int_pow(2, 64)) && mallocng_specs.word_ok(V, objs, bits_of_int(64, app(R, x0)), 0)) &&
        mallocng_specs.word_ok(V, objs, bits_of_int(64, app(R, x0)), 8)) && int_mod(app(R, x0), 8) = 0) &&
       (int_le(int_add(phead, 8), app(R, x0)) || int_le(int_add(app(R, x0), 16), phead))) proof
    fix x0
    assume hx hxl
    have c1: int_lt(x0, L) -> ((((int_le(int_add(app(R, x0), 16), int_pow(2, 64)) && mallocng_specs.word_ok(V, objs, bits_of_int(64, app(R, x0)), 0)) &&
        mallocng_specs.word_ok(V, objs, bits_of_int(64, app(R, x0)), 8)) && int_mod(app(R, x0), 8) = 0) &&
       (int_le(int_add(phead, 8), app(R, x0)) || int_le(int_add(app(R, x0), 16), phead))) proof
      assume h
      have {ra = elem} := apply(mp.snoc[l := l, x := m, j := x0], hl, mo)
      have r := mp(ra, hx, h)
      have q := mp(all_elim(el, {x0}), hx, h)
      have w0 := all_elim(wo, {bits_of_int(64, app(l, x0))}, {0})
      have w8 := all_elim(wo, {bits_of_int(64, app(l, x0))}, {8})
      show by simp(r, w0, w8, q)
    qed
    have c2: !int_lt(x0, L) -> ((((int_le(int_add(app(R, x0), 16), int_pow(2, 64)) && mallocng_specs.word_ok(V, objs, bits_of_int(64, app(R, x0)), 0)) &&
        mallocng_specs.word_ok(V, objs, bits_of_int(64, app(R, x0)), 8)) && int_mod(app(R, x0), 8) = 0) &&
       (int_le(int_add(phead, 8), app(R, x0)) || int_le(int_add(app(R, x0), 16), phead))) proof
      assume h
      have xe: x0 = L by arith(h, hx, hxl, rl, lo)
      have w0 := all_elim(wo, {m}, {0})
      have w8 := all_elim(wo, {m}, {8})
      have r: app(R, x0) = m by simp(xe, rL)
      show by simp(r, bm, w0, w8, jb, jw0, jw8, jm, ja)
    qed
    show by taut(c1, c2)
  qed
  have a: all x0. all x1. x0 in omega && x1 in omega -> (int_lt(x0, seq_len(R)) && int_lt(x1, seq_len(R))) && !(x0 = x1) ->
      int_le(int_add(app(R, x0), 16), app(R, x1)) || int_le(int_add(app(R, x1), 16), app(R, x0)) proof
    fix x0 x1
    assume ho hq
    have x0o: x0 in omega by taut(ho)
    have x1o: x1 in omega by taut(ho)
    have x0l: int_lt(x0, int_add(L, 1)) by simp(hq, rl)
    have x1l: int_lt(x1, int_add(L, 1)) by simp(hq, rl)
    have ne: !(x0 = x1) by taut(hq)
    have {r0 = elem} := apply(mp.snoc[l := l, x := m, j := x0], hl, mo)
    have {r1 = elem} := apply(mp.snoc[l := l, x := m, j := x1], hl, mo)
    // both l's; one of them m
    have c00: int_lt(x0, L) -> int_lt(x1, L) -> int_le(int_add(app(R, x0), 16), app(R, x1)) || int_le(int_add(app(R, x1), 16), app(R, x0)) proof
      assume a b
      have q := mp(all_elim(ap, {x0}, {x1}), taut(x0o, x1o), taut(a, b, ne))
      show by simp(mp(r0, x0o, a), mp(r1, x1o, b), q)
    qed
    have c01: int_lt(x0, L) -> !int_lt(x1, L) -> int_le(int_add(app(R, x0), 16), app(R, x1)) || int_le(int_add(app(R, x1), 16), app(R, x0)) proof
      assume a b
      have xe: x1 = L by arith(b, x1o, x1l, lo)
      have q := mp(all_elim(jl, {x0}), x0o, a)
      show by simp(mp(r0, x0o, a), xe, rL, q)
    qed
    have c10: !int_lt(x0, L) -> int_lt(x1, L) -> int_le(int_add(app(R, x0), 16), app(R, x1)) || int_le(int_add(app(R, x1), 16), app(R, x0)) proof
      assume a b
      have xe: x0 = L by arith(a, x0o, x0l, lo)
      have q := mp(all_elim(jl, {x1}), x1o, b)
      show by simp(mp(r1, x1o, b), xe, rL, q)
    qed
    have c11: !int_lt(x0, L) -> !int_lt(x1, L) -> int_le(int_add(app(R, x0), 16), app(R, x1)) || int_le(int_add(app(R, x1), 16), app(R, x0)) proof
      assume a b
      have f: false by arith(a, b, ne, x0o, x1o, x0l, x1l, lo)
      show by taut(f)
    qed
    show by taut(c00, c01, c10, c11)
  qed
  show by taut(e, a)
qed

// m joinable to the list at *phead: queue's precondition holds (its links
// 0, the words it writes usable and aligned)
theorem mp.qu_pre(vm, objs, phead, m, l): app(vm, "bytes") in fn_space(bits(64), bits(8)) -> phead in bits(64) -> m in bits(64) ->
  l in list_type(omega) -> mallocng_purpose.list_at(vm, objs, phead, l) -> mallocng_purpose.joinable(vm, objs, phead, l, m) ->
  mallocng_specs.queue_pre(vm, objs, phead, m)
proof
  assume hb hp hm hl H J
  let L := seq_len(l)
  let IP := int_mod(int_sub(int_add(0, L), 1), L)
  have {hok = head, hal = head_al} := expand(H, mallocng_purpose.list_at)
  have {jw0 = prev_ok, jw8 = next_ok, jm = al, jl = off_list, jz0 = prev0, jz8 = next0} := expand(J, mallocng_purpose.joinable)
  have mo: m in omega by simp(hm)
  have lo: L in omega by arith(hl)
  have al8m: mallocng_specs.al8(m) by defs(jm, mallocng_specs.al8)
  have enx: mallocng_specs.mnext(vm, m) = 0 by defs(jz8, mallocng_specs.mnext)
  have epv: mallocng_specs.mprev(vm, m) = 0 by defs(jz0, mallocng_specs.mprev)
  have {mh = value} := apply(mp.head_is[vm := vm, objs := objs, phead := phead, l := l], hb, hp, hl, H)
  have tl: !(mallocng_specs.rd64(vm, phead) = 0) ->
      ((((mallocng_specs.word_ok(vm, objs, mallocng_specs.rd64(vm, phead), 0) && mallocng_specs.al8(mallocng_specs.rd64(vm, phead))) &&
        mallocng_specs.word_ok(vm, objs, mallocng_specs.mprev(vm, mallocng_specs.rd64(vm, phead)), 8)) && mallocng_specs.al8(mallocng_specs.mprev(vm, mallocng_specs.rd64(vm, phead)))) &&
        !(mallocng_specs.rd64(vm, phead) = int_add(m, 8))) && !(mallocng_specs.mprev(vm, mallocng_specs.rd64(vm, phead)) = m) proof
    assume hn
    have l0z: L = 0 -> mallocng_specs.rd64(vm, phead) = 0 proof
      assume h0
      show by simp(mh, h0)
    qed
    have ln: !(L = 0) by taut(l0z, hn)
    have eH: mallocng_specs.rd64(vm, phead) = app(l, 0) by simp(mh, ln)
    have l0: int_lt(0, L) by arith(ln, lo)
    have ipo: IP in omega by arith(lo, l0)
    have ipl: int_lt(IP, L) by arith(lo, l0)
    have {ho = nat, hb16 = bound, hw0 = prev_ok, hmod = al} := apply(mp.list_el[vm := vm, objs := objs, phead := phead, l := l, i := 0], hl, H, simp(), l0)
    have {po = nat, pb16 = bound, pw8 = next_ok, pmod = al} := apply(mp.list_el[vm := vm, objs := objs, phead := phead, l := l, i := IP], hl, H, ipo, ipl)
    have {ws = links} := apply(mp.list_rd[vm := vm, objs := objs, phead := phead, l := l, i := 0], hb, hp, hl, H)
    have {rp = prev} := mp(ws, simp(), l0)
    have eP: mallocng_specs.mprev(vm, app(l, 0)) = app(l, IP)
      by defs(simp(rp, po, (int_lt(app(l, IP), 18446744073709551616) by arith(pb16))), mallocng_specs.mprev, mallocng_specs.rd64, bits_of_int, pow2)
    have a0: mallocng_specs.al8(app(l, 0)) by defs(hmod, mallocng_specs.al8)
    have ap: mallocng_specs.al8(app(l, IP)) by defs(pmod, mallocng_specs.al8)
    have d0 := mp(all_elim(jl, {0}), simp(), l0)
    have dp := mp(all_elim(jl, {IP}), ipo, ipl)
    have n1: !(app(l, 0) = int_add(m, 8)) by arith(d0, ho, mo)
    have n2: !(app(l, IP) = m) by arith(dp, po, mo)
    show by simp(eH, eP, hw0, a0, pw8, ap, n1, n2)
  qed
  show by defs(taut(hok, jw0, jw8, hal, al8m, enx, epv, tl), mallocng_specs.queue_pre)
qed

// queue's effect on an empty list at *phead: m alone in it, linked to
// itself, the head
theorem mp.qu_list0(vm, objs, phead, m, l): vm in x86_64_linux.Vm -> app(vm, "bytes") in fn_space(bits(64), bits(8)) -> phead in bits(64) -> m in bits(64) ->
  l in list_type(omega) -> seq_len(l) = 0 -> mallocng_purpose.list_at(vm, objs, phead, l) -> mallocng_purpose.joinable(vm, objs, phead, l, m) ->
  mallocng_purpose.list_at(mallocng_specs.queue_vm(vm, phead, m), objs, phead, seq_concat(l, seq_one(m))) &&
  mallocng_purpose.links_only(vm, mallocng_specs.queue_vm(vm, phead, m), phead, seq_concat(l, seq_one(m)))
proof
  assume hvm hb hp hm hl h0 H J
  let R := seq_concat(l, seq_one(m))
  have {hok = head, hal = head_al} := expand(H, mallocng_purpose.list_at)
  have {jb = bound, ja = off_head} := expand(J, mallocng_purpose.joinable)
  have mo: m in omega by simp(hm)
  have pho: phead in omega by simp(hp)
  have {phl0 = bound} := expand(hok, mallocng_specs.word_ok)
  have phl: int_le(int_add(phead, 8), 18446744073709551616) by arith(phl0, pho)
  have mb: int_le(int_add(m, 16), 18446744073709551616) by arith(jb)
  have bm8: bits_add(64, m, 8) = int_add(m, 8) by defs(arith(mo, mb), bits_add, bits_of_int, pow2)
  have m8b: int_add(m, 8) in bits(64) by simp(mo, (int_lt(int_add(m, 8), 18446744073709551616) by arith(mb)))
  have {mh = value} := apply(mp.head_is[vm := vm, objs := objs, phead := phead, l := l], hb, hp, hl, H)
  have e0: mallocng_specs.rd64(vm, phead) = 0 by simp(mh, h0)
  let W1 := mallocng_specs.wr64(vm, int_add(m, 8), m)
  let W2 := mallocng_specs.wr64(W1, m, m)
  let W3 := mallocng_specs.wr64(W2, phead, m)
  have e3: mallocng_specs.queue_vm(vm, phead, m) = W3 by defs(simp(e0, bm8), mallocng_specs.queue_vm)
  have tb1 := apply(mp.wr64_typed[V := vm, c := int_add(m, 8), v := m], hb)
  have tb2 := apply(mp.wr64_typed[V := W1, c := m, v := m], tb1)
  have tb3 := apply(mp.wr64_typed[V := W2, c := phead, v := m], tb2)
  have vf: is_fun(vm) by simp(hvm)
  have vd: "bytes" in dom(vm) by simp(hvm)
  have vs := apply(fn_update_same[f := vm, k := "bytes"], vf, vd)
  have fu3 := apply(mp.wr64_only[V := W2, c := phead, v := m, W := vm], apply(mp.wr64_only[V := W1, c := m, v := m, W := vm],
    apply(mp.wr64_only[V := vm, c := int_add(m, 8), v := m, W := vm], vs)))
  // the words: the head word, m's links all m
  have rh: gimple.bytes_at(W3, phead, 8) = m := apply(mp.rd_at8[vm := W2, c := phead, v := m], tb2, hp, hm)
  have rm8: gimple.bytes_at(W3, int_add(m, 8), 8) = m :=
    trans(apply(mp.w64_out[V := W2, c := phead, v := m, w := int_add(m, 8)], hp, simp(mo), arith(mb), phl, arith(ja, mo, pho)),
      trans(apply(mp.w64_out[V := W1, c := m, v := m, w := int_add(m, 8)], hm, simp(mo), arith(mb), arith(mb), arith(mo)),
        apply(mp.rd_at8[vm := vm, c := int_add(m, 8), v := m], hb, m8b, hm)))
  have rm: gimple.bytes_at(W3, m, 8) = m :=
    trans(apply(mp.w64_out[V := W2, c := phead, v := m, w := m], hp, mo, arith(mb), phl, arith(ja, mo, pho)),
      apply(mp.rd_at8[vm := W1, c := m, v := m], tb1, hm, hm))
  // the list [m]
  have {rl = len, rty = type, rL = last} := apply(mp.snoc[l := l, x := m, j := 0], hl, mo)
  have r1: seq_len(R) = 1 by simp(rl, h0)
  have r0: app(R, 0) = m by simp(rL, h0)
  have wo := all_elim(ms.f_word_ok, {W3}, {app(vm, "bytes")}, {objs}, {phead}, {0})
  have hok3: mallocng_specs.word_ok(W3, objs, phead, 0) by simp(rewrite(fu3, wo), hok)
  have el3 ap3 := apply(mp.snoc_ok[vm := vm, V := W3, objs := objs, phead := phead, l := l, m := m], hm, hl, H, J, fu3)
  have hd3: gimple.bytes_at(W3, phead, 8) = ite(seq_len(R) = 0, 0, app(R, 0)) by simp(rh, r1, r0)
  have ws3: all i. i in omega -> int_lt(i, seq_len(R)) ->
      gimple.bytes_at(W3, int_add(app(R, i), 8), 8) = app(R, int_mod(int_add(i, 1), seq_len(R))) &&
      gimple.bytes_at(W3, app(R, i), 8) = app(R, int_mod(int_sub(int_add(i, seq_len(R)), 1), seq_len(R))) proof
    fix i
    assume hi hil
    have iz: i = 0 by arith(hi, hil, r1)
    have m1: int_mod(int_add(i, 1), seq_len(R)) = 0 by arith(iz, r1)
    have m2: int_mod(int_sub(int_add(i, seq_len(R)), 1), seq_len(R)) = 0 by arith(iz, r1)
    show by simp(iz, m1, m2, r0, rm8, rm)
  qed
  have la := apply(mp.list_mk[vm := W3, objs := objs, phead := phead, l := R], tb3, hp, rty, hok3, hal, el3, ap3, hd3, ws3)
  // no byte but the head word and m's links written
  have lo3: all x0. x0 in omega -> (int_lt(x0, int_pow(2, 64)) && !(int_le(phead, x0) && int_lt(x0, int_add(phead, 8)))) &&
      (all x1. x1 in omega -> int_lt(x1, seq_len(R)) -> !(int_le(app(R, x1), x0) && int_lt(x0, int_add(app(R, x1), 16)))) ->
      app(app(W3, "bytes"), bits_of_int(64, x0)) = app(app(vm, "bytes"), bits_of_int(64, x0)) proof
    fix x0
    assume hx hq
    have xl: int_lt(x0, 18446744073709551616) by arith(hq)
    have xp: !(int_le(phead, x0) && int_lt(x0, int_add(phead, 8))) by taut(hq)
    have xa: all x1. x1 in omega -> int_lt(x1, seq_len(R)) -> !(int_le(app(R, x1), x0) && int_lt(x0, int_add(app(R, x1), 16))) by taut(hq)
    have xb: x0 in bits(64) by simp(hx, xl)
    have bx: bits_of_int(64, x0) = x0 by defs(simp(hx, xl), bits_of_int, pow2)
    have om := rewrite(r0, mp(all_elim(xa, {0}), simp(), (int_lt(0, seq_len(R)) by arith(r1))))
    have b3 := apply(mp.wb_out[V := W2, c := phead, v := m, x := x0], xb, hp, phl, arith(xp, hx, pho))
    have b2 := apply(mp.wb_out[V := W1, c := m, v := m, x := x0], xb, hm, arith(mb), arith(om, hx, mo))
    have b1 := apply(mp.wb_out[V := vm, c := int_add(m, 8), v := m, x := x0], xb, m8b, arith(mb), arith(om, hx, mo))
    show by simp(bx, trans(b3, trans(b2, b1)))
  qed
  have lk: mallocng_purpose.links_only(vm, W3, phead, R) by defs(taut(fu3, lo3), mallocng_purpose.links_only)
  have all3: mallocng_purpose.list_at(W3, objs, phead, R) && mallocng_purpose.links_only(vm, W3, phead, R) by taut(la, lk)
  show := subst({y. mallocng_purpose.list_at(y, objs, phead, R) && mallocng_purpose.links_only(vm, y, phead, R)}, sym(e3), all3)
qed

// queue's effect on a list at *phead of 1 or more: m at its end, between
// its last element P and its first H
theorem mp.qu_list1(vm, objs, phead, m, l): vm in x86_64_linux.Vm -> app(vm, "bytes") in fn_space(bits(64), bits(8)) -> phead in bits(64) -> m in bits(64) ->
  l in list_type(omega) -> int_lt(0, seq_len(l)) -> mallocng_purpose.list_at(vm, objs, phead, l) -> mallocng_purpose.joinable(vm, objs, phead, l, m) ->
  mallocng_purpose.list_at(mallocng_specs.queue_vm(vm, phead, m), objs, phead, seq_concat(l, seq_one(m))) &&
  mallocng_purpose.links_only(vm, mallocng_specs.queue_vm(vm, phead, m), phead, seq_concat(l, seq_one(m)))
proof
  assume hvm hb hp hm hl hl0 H J
  let L := seq_len(l)
  let L1 := int_add(L, 1)
  let IP := int_mod(int_sub(int_add(0, L), 1), L)
  let H0 := app(l, 0)
  let P := app(l, IP)
  let R := seq_concat(l, seq_one(m))
  have {hok = head, hal = head_al, ap = apart} := expand(H, mallocng_purpose.list_at)
  have {jb = bound, ja = off_head, jl = off_list} := expand(J, mallocng_purpose.joinable)
  have mo: m in omega by simp(hm)
  have lo: L in omega by arith(hl)
  have l1o: L1 in omega by simp(lo)
  have pho: phead in omega by simp(hp)
  have {phl0 = bound} := expand(hok, mallocng_specs.word_ok)
  have phl: int_le(int_add(phead, 8), 18446744073709551616) by arith(phl0, pho)
  have mb: int_le(int_add(m, 16), 18446744073709551616) by arith(jb)
  have bm8: bits_add(64, m, 8) = int_add(m, 8) by defs(arith(mo, mb), bits_add, bits_of_int, pow2)
  have m8b: int_add(m, 8) in bits(64) by simp(mo, (int_lt(int_add(m, 8), 18446744073709551616) by arith(mb)))
  have pe0 := apply(mp.mod_pred[x := 0, L := L], simp(), lo, hl0)
  have ipe: IP = int_sub(L, 1) by simp(pe0)
  have ipo: IP in omega by arith(ipe, lo, hl0)
  have ipl: int_lt(IP, L) by arith(ipe, lo, hl0)
  have {ho = nat, hb16 = bound, hw0 = prev_ok, hpa = off_head} := apply(mp.list_el[vm := vm, objs := objs, phead := phead, l := l, i := 0], hl, H, simp(), hl0)
  have {po = nat, pb16 = bound, ppa = off_head} := apply(mp.list_el[vm := vm, objs := objs, phead := phead, l := l, i := IP], hl, H, ipo, ipl)
  have d0 := mp(all_elim(jl, {0}), simp(), hl0)
  have dp := mp(all_elim(jl, {IP}), ipo, ipl)
  have {hz0 = nonnull} := expand(hw0, mallocng_specs.word_ok)
  have h0b: H0 in bits(64) by simp(ho, (int_lt(H0, 18446744073709551616) by arith(hb16)))
  have pbits: P in bits(64) by simp(po, (int_lt(P, 18446744073709551616) by arith(pb16)))
  have p8b: int_add(P, 8) in bits(64) by simp(po, (int_lt(int_add(P, 8), 18446744073709551616) by arith(pb16)))
  have bP8: bits_add(64, P, 8) = int_add(P, 8) by defs(arith(po, pb16), bits_add, bits_of_int, pow2)
  // the words read: the head word H, H's prev P
  have {mh = value} := apply(mp.head_is[vm := vm, objs := objs, phead := phead, l := l], hb, hp, hl, H)
  have ln: !(L = 0) by arith(hl0, lo)
  have eH: mallocng_specs.rd64(vm, phead) = H0 by simp(mh, ln)
  have hd0 ws0 := apply(mp.list_rd[vm := vm, objs := objs, phead := phead, l := l, i := 0], hb, hp, hl, H)
  have eHb: gimple.bytes_at(vm, phead, 8) = H0 by simp(hd0, ln)
  have {rp0 = prev} := mp(ws0, simp(), hl0)
  have eP: mallocng_specs.mprev(vm, H0) = P
    by defs(simp(rp0, po, (int_lt(P, 18446744073709551616) by arith(pb16))), mallocng_specs.mprev, mallocng_specs.rd64, bits_of_int, pow2)
  // the writes: m's links H and P, P's next and H's prev m
  let V1 := mallocng_specs.wr64(vm, int_add(m, 8), H0)
  let V2 := mallocng_specs.wr64(V1, m, P)
  let V3 := mallocng_specs.wr64(V2, int_add(P, 8), m)
  let V4 := mallocng_specs.wr64(V3, H0, m)
  have e4: mallocng_specs.queue_vm(vm, phead, m) = V4 by defs(simp(eH, eP, hz0, bm8, bP8), mallocng_specs.queue_vm)
  have tb1 := apply(mp.wr64_typed[V := vm, c := int_add(m, 8), v := H0], hb)
  have tb2 := apply(mp.wr64_typed[V := V1, c := m, v := P], tb1)
  have tb3 := apply(mp.wr64_typed[V := V2, c := int_add(P, 8), v := m], tb2)
  have tb4 := apply(mp.wr64_typed[V := V3, c := H0, v := m], tb3)
  have vf: is_fun(vm) by simp(hvm)
  have vd: "bytes" in dom(vm) by simp(hvm)
  have vs := apply(fn_update_same[f := vm, k := "bytes"], vf, vd)
  have fu4 := apply(mp.wr64_only[V := V3, c := H0, v := m, W := vm], apply(mp.wr64_only[V := V2, c := int_add(P, 8), v := m, W := vm],
    apply(mp.wr64_only[V := V1, c := m, v := P, W := vm], apply(mp.wr64_only[V := vm, c := int_add(m, 8), v := H0, W := vm], vs))))
  // m's links, the head word
  have rm8: gimple.bytes_at(V4, int_add(m, 8), 8) = H0 :=
    trans(apply(mp.w64_out[V := V3, c := H0, v := m, w := int_add(m, 8)], h0b, simp(mo), arith(mb), arith(hb16), arith(d0, ho, mo)),
      trans(apply(mp.w64_out[V := V2, c := int_add(P, 8), v := m, w := int_add(m, 8)], p8b, simp(mo), arith(mb), arith(pb16), arith(dp, po, mo)),
        trans(apply(mp.w64_out[V := V1, c := m, v := P, w := int_add(m, 8)], hm, simp(mo), arith(mb), arith(mb), arith(mo)),
          apply(mp.rd_at8[vm := vm, c := int_add(m, 8), v := H0], hb, m8b, h0b))))
  have rm: gimple.bytes_at(V4, m, 8) = P :=
    trans(apply(mp.w64_out[V := V3, c := H0, v := m, w := m], h0b, mo, arith(mb), arith(hb16), arith(d0, ho, mo)),
      trans(apply(mp.w64_out[V := V2, c := int_add(P, 8), v := m, w := m], p8b, mo, arith(mb), arith(pb16), arith(dp, po, mo)),
        apply(mp.rd_at8[vm := V1, c := m, v := P], tb1, hm, pbits)))
  have rph: gimple.bytes_at(V4, phead, 8) = H0 :=
    trans(apply(mp.w64_out[V := V3, c := H0, v := m, w := phead], h0b, pho, phl, arith(hb16), arith(hpa, ho, pho)),
      trans(apply(mp.w64_out[V := V2, c := int_add(P, 8), v := m, w := phead], p8b, pho, phl, arith(pb16), arith(ppa, po, pho)),
        trans(apply(mp.w64_out[V := V1, c := m, v := P, w := phead], hm, pho, phl, arith(mb), arith(ja, mo, pho)),
          trans(apply(mp.w64_out[V := vm, c := int_add(m, 8), v := H0, w := phead], m8b, pho, phl, arith(mb), arith(ja, mo, pho)), eHb))))
  // l's links: as before, but P's next and H's prev
  have wn: all j. j in omega -> int_lt(j, L) ->
      ((j = IP -> gimple.bytes_at(V4, int_add(app(l, j), 8), 8) = m) &&
       (!(j = IP) -> gimple.bytes_at(V4, int_add(app(l, j), 8), 8) = gimple.bytes_at(vm, int_add(app(l, j), 8), 8))) &&
      ((j = 0 -> gimple.bytes_at(V4, app(l, j), 8) = m) &&
       (!(j = 0) -> gimple.bytes_at(V4, app(l, j), 8) = gimple.bytes_at(vm, app(l, j), 8))) proof
    fix j
    assume hj hjl
    have {jo = nat, jb16 = bound} := apply(mp.list_el[vm := vm, objs := objs, phead := phead, l := l, i := j], hl, H, hj, hjl)
    have dm := mp(all_elim(jl, {j}), hj, hjl)
    have l8o: int_add(app(l, j), 8) in omega by simp(jo)
    have qH: app(l, j) = H0 || int_le(int_add(app(l, j), 16), H0) || int_le(int_add(H0, 16), app(l, j)) proof
      have a1: j = 0 -> app(l, j) = H0 by simp()
      have a2: !(j = 0) -> int_le(int_add(app(l, j), 16), H0) || int_le(int_add(H0, 16), app(l, j)) proof
        assume h
        show := mp(all_elim(ap, {j}, {0}), taut(hj, (0 in omega by simp())), taut(hjl, hl0, h))
      qed
      show by taut(a1, a2)
    qed
    have qP: app(l, j) = P || int_le(int_add(app(l, j), 16), P) || int_le(int_add(P, 16), app(l, j)) proof
      have a1: j = IP -> app(l, j) = P by simp()
      have a2: !(j = IP) -> int_le(int_add(app(l, j), 16), P) || int_le(int_add(P, 16), app(l, j)) proof
        assume h
        show := mp(all_elim(ap, {j}, {IP}), taut(hj, ipo), taut(hjl, ipl, h))
      qed
      show by taut(a1, a2)
    qed
    // the next link
    have s4 := apply(mp.w64_out[V := V3, c := H0, v := m, w := int_add(app(l, j), 8)], h0b, l8o, arith(jb16), arith(hb16), arith(qH, jo, ho))
    have n1: j = IP -> gimple.bytes_at(V4, int_add(app(l, j), 8), 8) = m proof
      assume h
      have e: app(l, j) = P by simp(h)
      have r := subst({y. gimple.bytes_at(V3, int_add(y, 8), 8) = m}, sym(e), apply(mp.rd_at8[vm := V2, c := int_add(P, 8), v := m], tb2, p8b, hm))
      show := trans(s4, r)
    qed
    have n2: !(j = IP) -> gimple.bytes_at(V4, int_add(app(l, j), 8), 8) = gimple.bytes_at(vm, int_add(app(l, j), 8), 8) proof
      assume h
      have a := mp(all_elim(ap, {j}, {IP}), taut(hj, ipo), taut(hjl, ipl, h))
      show := trans(s4, trans(apply(mp.w64_out[V := V2, c := int_add(P, 8), v := m, w := int_add(app(l, j), 8)], p8b, l8o, arith(jb16), arith(pb16), arith(a, jo, po)),
        trans(apply(mp.w64_out[V := V1, c := m, v := P, w := int_add(app(l, j), 8)], hm, l8o, arith(jb16), arith(mb), arith(dm, jo, mo)),
          apply(mp.w64_out[V := vm, c := int_add(m, 8), v := H0, w := int_add(app(l, j), 8)], m8b, l8o, arith(jb16), arith(mb), arith(dm, jo, mo)))))
    qed
    // the prev link
    have p1: j = 0 -> gimple.bytes_at(V4, app(l, j), 8) = m proof
      assume h
      have e: app(l, j) = H0 by simp(h)
      show := subst({y. gimple.bytes_at(V4, y, 8) = m}, sym(e), apply(mp.rd_at8[vm := V3, c := H0, v := m], tb3, h0b, hm))
    qed
    have p2: !(j = 0) -> gimple.bytes_at(V4, app(l, j), 8) = gimple.bytes_at(vm, app(l, j), 8) proof
      assume h
      have a := mp(all_elim(ap, {j}, {0}), taut(hj, (0 in omega by simp())), taut(hjl, hl0, h))
      show := trans(apply(mp.w64_out[V := V3, c := H0, v := m, w := app(l, j)], h0b, jo, arith(jb16), arith(hb16), arith(a, jo, ho)),
        trans(apply(mp.w64_out[V := V2, c := int_add(P, 8), v := m, w := app(l, j)], p8b, jo, arith(jb16), arith(pb16), arith(qP, jo, po)),
          trans(apply(mp.w64_out[V := V1, c := m, v := P, w := app(l, j)], hm, jo, arith(jb16), arith(mb), arith(dm, jo, mo)),
            apply(mp.w64_out[V := vm, c := int_add(m, 8), v := H0, w := app(l, j)], m8b, jo, arith(jb16), arith(mb), arith(dm, jo, mo)))))
    qed
    show by taut(n1, n2, p1, p2)
  qed

  // the list l ++ [m]
  have {rl = len, rty = type, rL = last} := apply(mp.snoc[l := l, x := m, j := 0], hl, mo)
  have wo := all_elim(ms.f_word_ok, {V4}, {app(vm, "bytes")}, {objs}, {phead}, {0})
  have hok4: mallocng_specs.word_ok(V4, objs, phead, 0) by simp(rewrite(fu4, wo), hok)
  have el4 ap4 := apply(mp.snoc_ok[vm := vm, V := V4, objs := objs, phead := phead, l := l, m := m], hm, hl, H, J, fu4)
  have {ra0 = elem} := apply(mp.snoc[l := l, x := m, j := 0], hl, mo)
  have r0: app(R, 0) = H0 := mp(ra0, simp(), hl0)
  have hd4: gimple.bytes_at(V4, phead, 8) = ite(seq_len(R) = 0, 0, app(R, 0)) by simp(rph, rl, lo, r0)
  have ws4: all i. i in omega -> int_lt(i, seq_len(R)) ->
      gimple.bytes_at(V4, int_add(app(R, i), 8), 8) = app(R, int_mod(int_add(i, 1), seq_len(R))) &&
      gimple.bytes_at(V4, app(R, i), 8) = app(R, int_mod(int_sub(int_add(i, seq_len(R)), 1), seq_len(R))) proof
    fix j
    assume hj hjl0
    have hjl: int_lt(j, L1) by simp(hjl0, rl)
    have ms1 := apply(mp.mod_succ[x := j, L := L1], hj, l1o, hjl)
    have mp1 := apply(mp.mod_pred[x := j, L := L1], hj, l1o, hjl)
    let N1 := int_mod(int_add(j, 1), L1)
    let P1 := int_mod(int_sub(int_add(j, L1), 1), L1)
    have {raj = elem} := apply(mp.snoc[l := l, x := m, j := j], hl, mo)
    // m, the last: its next H (the first), its prev P
    have cm: j = L -> gimple.bytes_at(V4, int_add(app(R, j), 8), 8) = app(R, N1) && gimple.bytes_at(V4, app(R, j), 8) = app(R, P1) proof
      assume h
      have rj: app(R, j) = m by simp(h, rL)
      have n1: N1 = 0 by simp(ms1, h)
      have p1: P1 = int_sub(L, 1) by simp(mp1, h, ln)
      have {rp = elem} := apply(mp.snoc[l := l, x := m, j := int_sub(L, 1)], hl, mo)
      have rP: app(R, int_sub(L, 1)) = P by simp(mp(rp, (int_sub(L, 1) in omega by arith(lo, hl0)), (int_lt(int_sub(L, 1), L) by arith(lo))), ipe)
      show by simp(rj, n1, p1, r0, rP, rm8, rm)
    qed
    // one of l's
    have cl: int_lt(j, L) -> gimple.bytes_at(V4, int_add(app(R, j), 8), 8) = app(R, N1) && gimple.bytes_at(V4, app(R, j), 8) = app(R, P1) proof
      assume h
      have rj: app(R, j) = app(l, j) := mp(raj, hj, h)
      have w1 w2 w3 w4 := mp(all_elim(wn, {j}), hj, h)
      have {lw = links} := apply(mp.list_rd[vm := vm, objs := objs, phead := phead, l := l, i := j], hb, hp, hl, H)
      have ln1 lp1 := mp(lw, hj, h)
      have j1: int_lt(int_add(j, 1), L1) by arith(h)
      have n1: N1 = int_add(j, 1) by simp(ms1, j1)
      // the next link: m for the last, else the next's
      have nx1: j = IP -> gimple.bytes_at(V4, int_add(app(R, j), 8), 8) = app(R, N1) proof
        assume e
        have jl: int_add(j, 1) = L by arith(e, ipe, lo, hj)
        show by simp(rj, mp(w1, e), n1, jl, rL)
      qed
      have nx2: !(j = IP) -> gimple.bytes_at(V4, int_add(app(R, j), 8), 8) = app(R, N1) proof
        assume e
        have jl: int_lt(int_add(j, 1), L) by arith(e, ipe, h, hj)
        have sl := apply(mp.mod_succ[x := j, L := L], hj, lo, h)
        have s2: int_mod(int_add(j, 1), L) = int_add(j, 1) by simp(sl, jl)
        have {rj1 = elem} := apply(mp.snoc[l := l, x := m, j := int_add(j, 1)], hl, mo)
        have r1: app(R, int_add(j, 1)) = app(l, int_add(j, 1)) := mp(rj1, simp(hj), jl)
        show by simp(rj, mp(w2, e), ln1, s2, n1, r1)
      qed
      // the prev link: m for the first, else the previous'
      have pv1: j = 0 -> gimple.bytes_at(V4, app(R, j), 8) = app(R, P1) proof
        assume e
        have m0 := trans(mp1, mp(all_elim(tr.ite_t, {j = 0}, {int_sub(L1, 1)}, {int_sub(j, 1)}), e))
        have p1: P1 = L by arith(m0, lo)
        show by simp(rj, mp(w3, e), p1, rL)
      qed
      have pv2: !(j = 0) -> gimple.bytes_at(V4, app(R, j), 8) = app(R, P1) proof
        assume e
        have p1: P1 = int_sub(j, 1) by simp(mp1, e)
        have pl := apply(mp.mod_pred[x := j, L := L], hj, lo, h)
        have p2: int_mod(int_sub(int_add(j, L), 1), L) = int_sub(j, 1) by simp(pl, e)
        have {rj1 = elem} := apply(mp.snoc[l := l, x := m, j := int_sub(j, 1)], hl, mo)
        have r1: app(R, int_sub(j, 1)) = app(l, int_sub(j, 1)) := mp(rj1, (int_sub(j, 1) in omega by arith(e, hj)), (int_lt(int_sub(j, 1), L) by arith(h, hj)))
        show by simp(rj, mp(w4, e), lp1, p2, p1, r1)
      qed
      show by taut(nx1, nx2, pv1, pv2)
    qed
    have c: int_lt(j, L) || j = L by arith(hjl, hj, lo)
    have r: gimple.bytes_at(V4, int_add(app(R, j), 8), 8) = app(R, N1) && gimple.bytes_at(V4, app(R, j), 8) = app(R, P1) by taut(c, cm, cl)
    show by simp(r, rl)
  qed
  have la := apply(mp.list_mk[vm := V4, objs := objs, phead := phead, l := R], tb4, hp, rty, hok4, hal, el4, ap4, hd4, ws4)
  // no byte but the links written
  have lo4: all x0. x0 in omega -> (int_lt(x0, int_pow(2, 64)) && !(int_le(phead, x0) && int_lt(x0, int_add(phead, 8)))) &&
      (all x1. x1 in omega -> int_lt(x1, seq_len(R)) -> !(int_le(app(R, x1), x0) && int_lt(x0, int_add(app(R, x1), 16)))) ->
      app(app(V4, "bytes"), bits_of_int(64, x0)) = app(app(vm, "bytes"), bits_of_int(64, x0)) proof
    fix x0
    assume hx hq
    have xl: int_lt(x0, 18446744073709551616) by arith(hq)
    have xa: all x1. x1 in omega -> int_lt(x1, seq_len(R)) -> !(int_le(app(R, x1), x0) && int_lt(x0, int_add(app(R, x1), 16))) by taut(hq)
    have xb: x0 in bits(64) by simp(hx, xl)
    have bx: bits_of_int(64, x0) = x0 by defs(simp(hx, xl), bits_of_int, pow2)
    have om := rewrite(rL, mp(all_elim(xa, {L}), lo, (int_lt(L, seq_len(R)) by arith(rl))))
    have oh := rewrite(r0, mp(all_elim(xa, {0}), simp(), (int_lt(0, seq_len(R)) by arith(rl, lo))))
    have {rpi = elem} := apply(mp.snoc[l := l, x := m, j := IP], hl, mo)
    have op := rewrite(mp(rpi, ipo, ipl), mp(all_elim(xa, {IP}), ipo, (int_lt(IP, seq_len(R)) by arith(rl, ipl))))
    have b4 := apply(mp.wb_out[V := V3, c := H0, v := m, x := x0], xb, h0b, arith(hb16), arith(oh, hx, ho))
    have b3 := apply(mp.wb_out[V := V2, c := int_add(P, 8), v := m, x := x0], xb, p8b, arith(pb16), arith(op, hx, po))
    have b2 := apply(mp.wb_out[V := V1, c := m, v := P, x := x0], xb, hm, arith(mb), arith(om, hx, mo))
    have b1 := apply(mp.wb_out[V := vm, c := int_add(m, 8), v := H0, x := x0], xb, m8b, arith(mb), arith(om, hx, mo))
    show by simp(bx, trans(b4, trans(b3, trans(b2, b1))))
  qed
  have lk: mallocng_purpose.links_only(vm, V4, phead, R) by defs(taut(fu4, lo4), mallocng_purpose.links_only)
  have all4: mallocng_purpose.list_at(V4, objs, phead, R) && mallocng_purpose.links_only(vm, V4, phead, R) by taut(la, lk)
  show := subst({y. mallocng_purpose.list_at(y, objs, phead, R) && mallocng_purpose.links_only(vm, y, phead, R)}, sym(e4), all4)
qed

// queue's effect is what it is for: for any list at *phead m is joinable to
theorem mp.qu_done(vm, objs, phead, m): vm in x86_64_linux.Vm -> app(vm, "bytes") in fn_space(bits(64), bits(8)) -> phead in bits(64) -> m in bits(64) ->
  mallocng_purpose.queued(vm, mallocng_specs.queue_vm(vm, phead, m), objs, phead, m)
proof
  assume hvm hb hp hm
  have a: all x0. x0 in list_type(omega) -> mallocng_purpose.list_at(vm, objs, phead, x0) && mallocng_purpose.joinable(vm, objs, phead, x0, m) ->
      mallocng_purpose.list_at(mallocng_specs.queue_vm(vm, phead, m), objs, phead, seq_concat(x0, seq_one(m))) &&
      mallocng_purpose.links_only(vm, mallocng_specs.queue_vm(vm, phead, m), phead, seq_concat(x0, seq_one(m))) proof
    fix l
    assume hl hq
    have H: mallocng_purpose.list_at(vm, objs, phead, l) by taut(hq)
    have J: mallocng_purpose.joinable(vm, objs, phead, l, m) by taut(hq)
    have lo: seq_len(l) in omega by arith(hl)
    have c0: seq_len(l) = 0 -> mallocng_purpose.list_at(mallocng_specs.queue_vm(vm, phead, m), objs, phead, seq_concat(l, seq_one(m))) &&
        mallocng_purpose.links_only(vm, mallocng_specs.queue_vm(vm, phead, m), phead, seq_concat(l, seq_one(m))) proof
      assume h
      show := apply(mp.qu_list0[vm := vm, objs := objs, phead := phead, m := m, l := l], hvm, hb, hp, hm, hl, h, H, J)
    qed
    have c1: !(seq_len(l) = 0) -> mallocng_purpose.list_at(mallocng_specs.queue_vm(vm, phead, m), objs, phead, seq_concat(l, seq_one(m))) &&
        mallocng_purpose.links_only(vm, mallocng_specs.queue_vm(vm, phead, m), phead, seq_concat(l, seq_one(m))) proof
      assume h
      show := apply(mp.qu_list1[vm := vm, objs := objs, phead := phead, m := m, l := l], hvm, hb, hp, hm, hl, (int_lt(0, seq_len(l)) by arith(h, lo)), H, J)
    qed
    show by taut(c0, c1)
  qed
  show by defs(a, mallocng_purpose.queued)
qed

// m's meta zeroed: each of its bytes 0, so each of its words
theorem mp.zero_b(vm, m, j): m in bits(64) -> j in omega -> int_lt(j, 40) -> int_le(int_add(m, 40), 18446744073709551616) ->
  app(app(mallocng_specs.zero_meta(vm, m), "bytes"), int_add(m, j)) = 0
proof
  assume hm hj hjl hml
  have s := apply(mp.st_at[B := app(vm, "bytes"), c := m, k := 40, v := 0, j := j], hm, hj, hjl, hml)
  have pp := mp(all_elim(pow256_pos, {j}), hj)
  have {d0 = quot} := apply(div_unique[x := 0, m := int_pow(256, j), q := 0, r := 0], simp(), simp(), simp(), pp, pp, arith())
  have z: bits_of_int(8, int_div(0, int_pow(256, j))) = 0 by defs(simp(d0), bits_of_int, pow2)
  show by defs(simp(s, z, app_update_same[f := vm, k := "bytes", v := x86_64_linux.store_le(app(vm, "bytes"), m, 40, 0)]), mallocng_specs.zero_meta)
qed

theorem mp.zero_w(vm, m, o): app(vm, "bytes") in fn_space(bits(64), bits(8)) -> m in bits(64) -> o in omega -> int_le(int_add(o, 8), 40) ->
  int_le(int_add(m, 40), 18446744073709551616) -> gimple.bytes_at(mallocng_specs.zero_meta(vm, m), int_add(m, o), 8) = 0
proof
  assume hb hm ho hol hml
  let X := mallocng_specs.wr64(vm, int_add(m, o), 0)
  have mo: m in omega by simp(hm)
  have cb: int_add(m, o) in bits(64) by simp(mo, ho, (int_lt(int_add(m, o), 18446744073709551616) by arith(mo, ho, hol, hml)))
  have x0 := apply(mp.rd_at8[vm := vm, c := int_add(m, o), v := 0], hb, cb, simp())
  have eq: all j. j in omega -> int_lt(j, 8) -> app(app(mallocng_specs.zero_meta(vm, m), "bytes"), int_add(int_add(m, o), j)) = app(app(X, "bytes"), int_add(int_add(m, o), j)) proof
    fix j
    assume hj hjl
    have a: int_add(int_add(m, o), j) = int_add(m, int_add(o, j)) by arith(mo, ho, hj)
    have z1 := apply(mp.zero_b[vm := vm, m := m, j := int_add(o, j)], hm, simp(ho, hj), arith(hol, ho, hj, hjl), hml)
    have s2 := apply(mp.st_at[B := app(vm, "bytes"), c := int_add(m, o), k := 8, v := 0, j := j], cb, hj, hjl, arith(mo, ho, hol, hml))
    have pp := mp(all_elim(pow256_pos, {j}), hj)
    have {d0 = quot} := apply(div_unique[x := 0, m := int_pow(256, j), q := 0, r := 0], simp(), simp(), simp(), pp, pp, arith())
    have z: bits_of_int(8, int_div(0, int_pow(256, j))) = 0 by defs(simp(d0), bits_of_int, pow2)
    have z2: app(app(X, "bytes"), int_add(int_add(m, o), j)) = 0
      by defs(simp(s2, z, app_update_same[f := vm, k := "bytes", v := x86_64_linux.store_le(app(vm, "bytes"), int_add(m, o), 8, 0)]), mallocng_specs.wr64)
    show by simp(a, z1, rewrite(a, z2))
  qed
  have rs := apply(mp.rd_same[v1 := mallocng_specs.zero_meta(vm, m), v2 := X, a := int_add(m, o), n := 8], simp(mo, ho), simp(), arith(mo, ho, hol, hml), eq)
  show := trans(rs, x0)
qed

// the list at *phead on a memory V, its words and the bytes' type the
// same, and V differing from vm in bytes only: the list there too
theorem mp.list_keep(vm, V, objs, phead, l): app(vm, "bytes") in fn_space(bits(64), bits(8)) -> app(V, "bytes") in fn_space(bits(64), bits(8)) ->
  phead in bits(64) -> l in list_type(omega) -> fn_update(V, "bytes", app(vm, "bytes")) = vm -> mallocng_purpose.list_at(vm, objs, phead, l) ->
  gimple.bytes_at(V, phead, 8) = gimple.bytes_at(vm, phead, 8) ->
  (all i. i in omega -> int_lt(i, seq_len(l)) ->
     gimple.bytes_at(V, int_add(app(l, i), 8), 8) = gimple.bytes_at(vm, int_add(app(l, i), 8), 8) && gimple.bytes_at(V, app(l, i), 8) = gimple.bytes_at(vm, app(l, i), 8)) ->
  mallocng_purpose.list_at(V, objs, phead, l)
proof
  assume hb hbV hp hl fu H eh ew
  have {hok = head, hal = head_al, el = elems, ap = apart} := expand(H, mallocng_purpose.list_at)
  have wo: all p. all off. mallocng_specs.word_ok(V, objs, p, off) = mallocng_specs.word_ok(vm, objs, p, off) proof
    fix p off
    have f := all_elim(ms.f_word_ok, {V}, {app(vm, "bytes")}, {objs}, {p}, {off})
    show := sym(rewrite(fu, f))
  qed
  have hokV: mallocng_specs.word_ok(V, objs, phead, 0) by simp(all_elim(wo, {phead}, {0}), hok)
  have elV: all x0. x0 in omega -> int_lt(x0, seq_len(l)) -> ((((int_le(int_add(app(l, x0), 16), int_pow(2, 64)) && mallocng_specs.word_ok(V, objs, bits_of_int(64, app(l, x0)), 0)) &&
      mallocng_specs.word_ok(V, objs, bits_of_int(64, app(l, x0)), 8)) && int_mod(app(l, x0), 8) = 0) && (int_le(int_add(phead, 8), app(l, x0)) || int_le(int_add(app(l, x0), 16), phead))) proof
    fix x0
    assume hx hxl
    have q := mp(all_elim(el, {x0}), hx, hxl)
    have w0 := all_elim(wo, {bits_of_int(64, app(l, x0))}, {0})
    have w8 := all_elim(wo, {bits_of_int(64, app(l, x0))}, {8})
    show by simp(w0, w8, q)
  qed
  have {hd = head} := apply(mp.list_rd[vm := vm, objs := objs, phead := phead, l := l, i := 0], hb, hp, hl, H)
  have hdV := trans(eh, hd)
  have wsV: all i. i in omega -> int_lt(i, seq_len(l)) ->
      gimple.bytes_at(V, int_add(app(l, i), 8), 8) = app(l, int_mod(int_add(i, 1), seq_len(l))) &&
      gimple.bytes_at(V, app(l, i), 8) = app(l, int_mod(int_sub(int_add(i, seq_len(l)), 1), seq_len(l))) proof
    fix i
    assume hi hil
    have {ws = links} := apply(mp.list_rd[vm := vm, objs := objs, phead := phead, l := l, i := i], hb, hp, hl, H)
    have rn rp := mp(ws, hi, hil)
    have en ep := mp(all_elim(ew, {i}), hi, hil)
    show by taut(trans(en, rn), trans(ep, rp))
  qed
  show := apply(mp.list_mk[vm := V, objs := objs, phead := phead, l := l], hbV, hp, hl, hokV, hal, elV, ap, hdV, wsV)
qed

// m's meta zeroed: the list at *phead (apart from it) kept, m joinable to it
theorem mp.fm_pre(vm, objs, phead, m, l): vm in x86_64_linux.Vm -> app(vm, "bytes") in fn_space(bits(64), bits(8)) -> phead in bits(64) -> m in bits(64) ->
  l in list_type(omega) -> mallocng_purpose.list_at(vm, objs, phead, l) -> mallocng_purpose.meta_joinable(vm, objs, phead, l, m) ->
  mallocng_purpose.list_at(mallocng_specs.zero_meta(vm, m), objs, phead, l) && mallocng_purpose.joinable(mallocng_specs.zero_meta(vm, m), objs, phead, l, m)
proof
  assume hvm hb hp hm hl H J
  let ZV := mallocng_specs.zero_meta(vm, m)
  have {hok = head} := expand(H, mallocng_purpose.list_at)
  have mz ml mm ur uw ma mlst := expand(J, mallocng_purpose.joinable)
  have mo: m in omega by simp(hm)
  have pho: phead in omega by simp(hp)
  have {phl0 = bound} := expand(hok, mallocng_specs.word_ok)
  have phl: int_le(int_add(phead, 8), 18446744073709551616) by arith(phl0, pho)
  have mlt: int_le(int_add(m, 40), 18446744073709551616) by arith(ml)
  have tbZ: app(ZV, "bytes") in fn_space(bits(64), bits(8)) by defs(simp(mp(all_elim(x86.store_typed, {app(vm, "bytes")}, {m}, {40}, {0}), hb)), mallocng_specs.zero_meta)
  have vf: is_fun(vm) by simp(hvm)
  have vd: "bytes" in dom(vm) by simp(hvm)
  have vs := apply(fn_update_same[f := vm, k := "bytes"], vf, vd)
  have fu: fn_update(ZV, "bytes", app(vm, "bytes")) = vm
    by defs(trans(fn_update_twice[f := vm, k := "bytes", a := x86_64_linux.store_le(app(vm, "bytes"), m, 40, 0), b := app(vm, "bytes")], vs), mallocng_specs.zero_meta)
  // words apart from m's meta: as before
  have ro: all w. w in omega -> int_le(int_add(w, 8), 18446744073709551616) -> (int_le(int_add(m, 40), w) || int_le(int_add(w, 8), m)) ->
      gimple.bytes_at(ZV, w, 8) = gimple.bytes_at(vm, w, 8) proof
    fix w
    assume hw hwl hap
    show by defs(apply(mp.rd_out[vm := vm, c := m, k := 40, v := 0, a := w, n := 8], hw, simp(), hm, simp(), hwl, mlt, hap), mallocng_specs.zero_meta)
  qed
  have eh := mp(all_elim(ro, {phead}), pho, phl, arith(ma, mo, pho))
  have ew: all i. i in omega -> int_lt(i, seq_len(l)) ->
      gimple.bytes_at(ZV, int_add(app(l, i), 8), 8) = gimple.bytes_at(vm, int_add(app(l, i), 8), 8) && gimple.bytes_at(ZV, app(l, i), 8) = gimple.bytes_at(vm, app(l, i), 8) proof
    fix i
    assume hi hil
    have lo lb .. := apply(mp.list_el[vm := vm, objs := objs, phead := phead, l := l, i := i], hl, H, hi, hil)
    have d := mp(all_elim(mlst, {i}), hi, hil)
    have e1 := mp(all_elim(ro, {int_add(app(l, i), 8)}), simp(lo), arith(lb), arith(d, lo, mo))
    have e2 := mp(all_elim(ro, {app(l, i)}), lo, arith(lb), arith(d, lo, mo))
    show by taut(e1, e2)
  qed
  have lz := apply(mp.list_keep[vm := vm, V := ZV, objs := objs, phead := phead, l := l], hb, tbZ, hp, hl, fu, H, eh, ew)
  // m joinable: its words usable, its links 0
  have urZ: gimple.usable(ZV, objs, m, 40, false) by defs(simp(all_elim(ms.f_usable, {vm}, {x86_64_linux.store_le(app(vm, "bytes"), m, 40, 0)}, {objs}, {m}, {40}, {false}), ur), mallocng_specs.zero_meta)
  have uwZ: gimple.usable(ZV, objs, m, 40, true) by defs(simp(all_elim(ms.f_usable, {vm}, {x86_64_linux.store_le(app(vm, "bytes"), m, 40, 0)}, {objs}, {m}, {40}, {true}), uw), mallocng_specs.zero_meta)
  have mi: m in int by simp(mo)
  have u0r := mp(all_elim(ms.usable_part, {ZV}, {objs}, {m}, {40}, {int_add(m, 0)}, {8}, {false}), mi, simp(mo), arith(mo), arith(mo), urZ)
  have u0w := mp(all_elim(ms.usable_part, {ZV}, {objs}, {m}, {40}, {int_add(m, 0)}, {8}, {true}), mi, simp(mo), arith(mo), arith(mo), uwZ)
  have u8r := mp(all_elim(ms.usable_part, {ZV}, {objs}, {m}, {40}, {int_add(m, 8)}, {8}, {false}), mi, simp(mo), arith(mo), arith(mo), urZ)
  have u8w := mp(all_elim(ms.usable_part, {ZV}, {objs}, {m}, {40}, {int_add(m, 8)}, {8}, {true}), mi, simp(mo), arith(mo), arith(mo), uwZ)
  have w0: mallocng_specs.word_ok(ZV, objs, m, 0) by defs(taut(mz, (int_le(int_add(int_add(m, 0), 8), int_pow(2, 64)) by arith(ml)), u0r, u0w), mallocng_specs.word_ok)
  have w8: mallocng_specs.word_ok(ZV, objs, m, 8) by defs(taut(mz, (int_le(int_add(int_add(m, 8), 8), int_pow(2, 64)) by arith(ml)), u8r, u8w), mallocng_specs.word_ok)
  have z0 := apply(mp.zero_w[vm := vm, m := m, o := 0], hb, hm, simp(), simp(), mlt)
  have z8 := apply(mp.zero_w[vm := vm, m := m, o := 8], hb, hm, simp(), simp(), mlt)
  have bm8: bits_add(64, m, 8) = int_add(m, 8) by defs(arith(mo, ml), bits_add, bits_of_int, pow2)
  have z0m := rewrite((int_add(m, 0) = m by arith(mo)), z0)
  have r0: mallocng_specs.rd64(ZV, m) = 0 by defs(simp(z0m), mallocng_specs.rd64, bits_of_int, pow2)
  have r8: mallocng_specs.rd64(ZV, bits_add(64, m, 8)) = 0 by defs(simp(z8, bm8), mallocng_specs.rd64, bits_of_int, pow2)
  have m16: int_le(int_add(m, 16), int_pow(2, 64)) by arith(ml)
  have ma2: int_le(int_add(phead, 8), m) || int_le(int_add(m, 16), phead) by arith(ma, mo, pho)
  have ml2: all x0. x0 in omega -> int_lt(x0, seq_len(l)) -> int_le(int_add(app(l, x0), 16), m) || int_le(int_add(m, 16), app(l, x0)) proof
    fix x0
    assume hx hxl
    have lo := apply(at_type[l := l, t := omega, i := x0], hl, hx, hxl)
    have d := mp(all_elim(mlst, {x0}), hx, hxl)
    show by arith(d, lo, mo)
  qed
  have jz: mallocng_purpose.joinable(ZV, objs, phead, l, m) by defs(taut(m16, w0, w8, mm, ma2, ml2, r0, r8), mallocng_purpose.joinable)
  show by taut(lz, jz)
qed

// m's meta zeroed, then m queued: m's meta freed (its links the list's,
// its other bytes 0, nothing else written)
theorem mp.fm_done(vm, V, objs, phead, m): vm in x86_64_linux.Vm -> app(vm, "bytes") in fn_space(bits(64), bits(8)) -> phead in bits(64) -> m in bits(64) ->
  mallocng_purpose.queued(mallocng_specs.zero_meta(vm, m), V, objs, phead, m) -> mallocng_purpose.meta_freed(vm, V, objs, phead, m)
proof
  assume hvm hb hp hm Q
  let ZV := mallocng_specs.zero_meta(vm, m)
  have a: all x0. x0 in list_type(omega) -> mallocng_purpose.list_at(vm, objs, phead, x0) && mallocng_purpose.meta_joinable(vm, objs, phead, x0, m) ->
      ((mallocng_purpose.list_at(V, objs, phead, seq_concat(x0, seq_one(m))) &&
        (all x1. x1 in omega -> int_le(int_add(m, 16), x1) && int_lt(x1, int_add(m, 40)) -> app(app(V, "bytes"), bits_of_int(64, x1)) = 0)) &&
        fn_update(V, "bytes", app(vm, "bytes")) = vm) &&
      (all x1. x1 in omega -> ((int_lt(x1, int_pow(2, 64)) && !(int_le(phead, x1) && int_lt(x1, int_add(phead, 8)))) && !(int_le(m, x1) && int_lt(x1, int_add(m, 40)))) &&
        (all x2. x2 in omega -> int_lt(x2, seq_len(x0)) -> !(int_le(app(x0, x2), x1) && int_lt(x1, int_add(app(x0, x2), 16)))) ->
        app(app(V, "bytes"), bits_of_int(64, x1)) = app(app(vm, "bytes"), bits_of_int(64, x1))) proof
    fix l
    assume hl hq
    have H: mallocng_purpose.list_at(vm, objs, phead, l) by taut(hq)
    have J: mallocng_purpose.meta_joinable(vm, objs, phead, l, m) by taut(hq)
    have {ml = bound, ma = off_head, mlst = off_list} := expand(J, mallocng_purpose.meta_joinable)
    have mo: m in omega by simp(hm)
    have pho: phead in omega by simp(hp)
    have lo: seq_len(l) in omega by arith(hl)
    have mlt: int_le(int_add(m, 40), 18446744073709551616) by arith(ml)
    have lz jz := apply(mp.fm_pre[vm := vm, objs := objs, phead := phead, m := m, l := l], hvm, hb, hp, hm, hl, H, J)
    have la lk := mp(all_elim(expand(Q, mallocng_purpose.queued), {l}), hl, taut(lz, jz))
    have fuZ lkb := expand(lk, mallocng_purpose.links_only)
    let R := seq_concat(l, seq_one(m))
    have {rl = len, rL = last} := apply(mp.snoc[l := l, x := m, j := 0], hl, mo)
    // a byte outside the list's links and the head word: V's the zeroed one
    have kz: all x1. x1 in omega -> int_lt(x1, 18446744073709551616) -> !(int_le(phead, x1) && int_lt(x1, int_add(phead, 8))) ->
        !(int_le(m, x1) && int_lt(x1, int_add(m, 16))) ->
        (all x2. x2 in omega -> int_lt(x2, seq_len(l)) -> !(int_le(app(l, x2), x1) && int_lt(x1, int_add(app(l, x2), 16)))) ->
        app(app(V, "bytes"), bits_of_int(64, x1)) = app(app(ZV, "bytes"), bits_of_int(64, x1)) proof
      fix x1
      assume hx hxl hxp hxm hxa
      have xa: all x2. x2 in omega -> int_lt(x2, seq_len(R)) -> !(int_le(app(R, x2), x1) && int_lt(x1, int_add(app(R, x2), 16))) proof
        fix x2
        assume h2 h2l
        have c1: int_lt(x2, seq_len(l)) -> !(int_le(app(R, x2), x1) && int_lt(x1, int_add(app(R, x2), 16))) proof
          assume h
          have {r2 = elem} := apply(mp.snoc[l := l, x := m, j := x2], hl, mo)
          show by simp(mp(r2, h2, h), mp(all_elim(hxa, {x2}), h2, h))
        qed
        have c2: !int_lt(x2, seq_len(l)) -> !(int_le(app(R, x2), x1) && int_lt(x1, int_add(app(R, x2), 16))) proof
          assume h
          have xe: x2 = seq_len(l) by arith(h, h2, h2l, rl, lo)
          show by simp(xe, rL, hxm)
        qed
        show by taut(c1, c2)
      qed
      show := mp(all_elim(lkb, {x1}), hx, taut((int_lt(x1, int_pow(2, 64)) by arith(hxl)), hxp, xa))
    qed
    // m's other bytes: 0
    have zr: all x1. x1 in omega -> int_le(int_add(m, 16), x1) && int_lt(x1, int_add(m, 40)) -> app(app(V, "bytes"), bits_of_int(64, x1)) = 0 proof
      fix x1
      assume hx hr
      have xl: int_lt(x1, 18446744073709551616) by arith(hr, mlt)
      have bx: bits_of_int(64, x1) = x1 by defs(simp(hx, xl), bits_of_int, pow2)
      have xa: all x2. x2 in omega -> int_lt(x2, seq_len(l)) -> !(int_le(app(l, x2), x1) && int_lt(x1, int_add(app(l, x2), 16))) proof
        fix x2
        assume h2 h2l
        have l2 := apply(at_type[l := l, t := omega, i := x2], hl, h2, h2l)
        have d := mp(all_elim(mlst, {x2}), h2, h2l)
        show by arith(d, l2, hr, mo, hx)
      qed
      have k := mp(all_elim(kz, {x1}), hx, xl, arith(ma, hr, mo, pho, hx), arith(hr, mo, hx), xa)
      have e: x1 = int_add(m, int_sub(x1, m)) by arith(hx, mo)
      have z := apply(mp.zero_b[vm := vm, m := m, j := int_sub(x1, m)], hm, arith(hr, mo, hx), arith(hr, mo, hx), mlt)
      have z2: app(app(ZV, "bytes"), x1) = 0 := rewrite(sym(e), z)
      show by simp(k, bx, z2)
    qed
    // V differs from vm in bytes only
    have vf: is_fun(vm) by simp(hvm)
    have vd: "bytes" in dom(vm) by simp(hvm)
    have vs := apply(fn_update_same[f := vm, k := "bytes"], vf, vd)
    have fZ: fn_update(ZV, "bytes", app(vm, "bytes")) = vm
      by defs(trans(fn_update_twice[f := vm, k := "bytes", a := x86_64_linux.store_le(app(vm, "bytes"), m, 40, 0), b := app(vm, "bytes")], vs), mallocng_specs.zero_meta)
    have t1 := fn_update_twice[f := V, k := "bytes", a := app(ZV, "bytes"), b := app(vm, "bytes")]
    have fu: fn_update(V, "bytes", app(vm, "bytes")) = vm := trans(sym(t1), trans(subst({y. fn_update(fn_update(V, "bytes", app(ZV, "bytes")), "bytes", app(vm, "bytes")) = fn_update(y, "bytes", app(vm, "bytes"))}, fuZ, refl({fn_update(fn_update(V, "bytes", app(ZV, "bytes")), "bytes", app(vm, "bytes"))})), fZ))
    // the frame
    have fr: all x1. x1 in omega -> ((int_lt(x1, int_pow(2, 64)) && !(int_le(phead, x1) && int_lt(x1, int_add(phead, 8)))) && !(int_le(m, x1) && int_lt(x1, int_add(m, 40)))) &&
        (all x2. x2 in omega -> int_lt(x2, seq_len(l)) -> !(int_le(app(l, x2), x1) && int_lt(x1, int_add(app(l, x2), 16)))) ->
        app(app(V, "bytes"), bits_of_int(64, x1)) = app(app(vm, "bytes"), bits_of_int(64, x1)) proof
      fix x1
      assume hx hq2
      have xl: int_lt(x1, 18446744073709551616) by arith(hq2)
      have xp: !(int_le(phead, x1) && int_lt(x1, int_add(phead, 8))) by taut(hq2)
      have xm: !(int_le(m, x1) && int_lt(x1, int_add(m, 40))) by taut(hq2)
      have xa: all x2. x2 in omega -> int_lt(x2, seq_len(l)) -> !(int_le(app(l, x2), x1) && int_lt(x1, int_add(app(l, x2), 16))) by taut(hq2)
      have bx: bits_of_int(64, x1) = x1 by defs(simp(hx, xl), bits_of_int, pow2)
      have xb: x1 in bits(64) by simp(hx, xl)
      have k := mp(all_elim(kz, {x1}), hx, xl, xp, arith(xm, hx, mo), xa)
      have so := apply(mp.st_out[B := app(vm, "bytes"), c := m, k := 40, v := 0, x := x1], xb, hm, simp(), mlt, arith(xm, hx, mo))
      have zo: app(app(ZV, "bytes"), x1) = app(app(vm, "bytes"), x1)
        by defs(simp(so, app_update_same[f := vm, k := "bytes", v := x86_64_linux.store_le(app(vm, "bytes"), m, 40, 0)]), mallocng_specs.zero_meta)
      show by simp(k, bx, zo)
    qed
    show by taut(la, zr, fu, fr)
  qed
  show by defs(a, mallocng_purpose.meta_freed)
qed

// ----------------------------------------------------------------------
//  The invariant kept by a used group's masks written

// the frame: A2 differing from A in g's masks only, the view M2 from M in
// g's two mask words only (the pages the same)
abbrev mp.mframe(c, A, A2, M, M2, b, brk, g) := cfg: c in mallocng.Cfg && univ: A in univ(1) && abs: A in mallocng.Abs && abs2: A2 in mallocng.Abs &&
  blocks: b in fn_space(bits(64), option(omega)) && holds: mallocng.holds(c, A, M, b, brk) && mo: mallocng_purpose.masks_only(A, A2) &&
  others: (all h. h in omega -> !(h = g) -> app(app(A2, "metas"), h) = app(app(A, "metas"), h)) && used: mallocng.is_used(A, g) &&
  bytes: (all a. a in omega -> !(int_le(int_add(g, 24), a) && int_lt(a, int_add(g, 32))) -> app(M2, a) = app(M, a)) &&
  pages: (all a. a in omega -> mallocng.pg(M2, a) = mallocng.pg(M, a))

// g's mask words: in g's meta area's page (g in omega)
theorem mp.mf_page(c, A, A2, M, M2, b, brk, g): mp.mframe(c, A, A2, M, M2, b, brk, g) ->
  nat: g in omega && area: (ex k. k in omega && int_lt(k, seq_len(app(A, "areas"))) &&
    (all a. int_le(int_add(g, 24), a) && int_lt(a, int_add(g, 32)) -> int_le(app(app(A, "areas"), k), a) && int_lt(a, int_add(app(app(A, "areas"), k), 4096))) &&
    int_le(int_add(app(app(A, "areas"), k), 24), g))
proof
  assume F
  have {ha = abs, H = holds, hg = used} := F
  have {hpart = part} := expand(H, mallocng.holds)
  obtain kg, hkg hkgr from expand(hg, mallocng.is_used)
  have hkgl hkge := hkgr
  have {usl = used_slots} := expand(hpart, mallocng.metas_partition)
  have gms := rewrite(hkge, mp(all_elim(usl, {kg}), hkg, hkgl))
  have {go = nat, gex = area} := apply(mp.meta_page, ha, gms)
  obtain k, hk hkl glo ghi gstep from gex
  have rl: app(A, "areas") in list_type(omega) by simp(ha)
  have aro := mp(at_type[l := app(A, "areas"), t := omega, i := k], rl, hk, hkl)
  have inp: all a. int_le(int_add(g, 24), a) && int_lt(a, int_add(g, 32)) -> int_le(app(app(A, "areas"), k), a) && int_lt(a, int_add(app(app(A, "areas"), k), 4096)) proof
    fix a
    assume h
    have h1 h2 := h
    show by arith(h1, h2, glo, ghi, go, aro)
  qed
  have ex: ex k2. k2 in omega && int_lt(k2, seq_len(app(A, "areas"))) &&
      (all a. int_le(int_add(g, 24), a) && int_lt(a, int_add(g, 32)) -> int_le(app(app(A, "areas"), k2), a) && int_lt(a, int_add(app(app(A, "areas"), k2), 4096))) &&
      int_le(int_add(app(app(A, "areas"), k2), 24), g)
    by ex_intro({k}, taut(hk, hkl, inp, glo))
  show by taut(go, ex)
qed

// a byte in no meta area's page: no mask word of g -- as before
theorem mp.mf_far(c, A, A2, M, M2, b, brk, g, a): mp.mframe(c, A, A2, M, M2, b, brk, g) -> a in omega ->
  (all k. k in omega -> int_lt(k, seq_len(app(A, "areas"))) -> !(int_le(app(app(A, "areas"), k), a) && int_lt(a, int_add(app(app(A, "areas"), k), 4096)))) ->
  app(M2, a) = app(M, a)
proof
  assume F hao hn
  have {agw = bytes} := F
  have {pa = area} := apply(mp.mf_page, F)
  obtain k, hk hkl inp glo from pa
  have nw: int_le(int_add(g, 24), a) && int_lt(a, int_add(g, 32)) -> false proof
    assume w
    show by taut(mp(all_elim(hn, {k}), hk, hkl), mp(all_elim(inp, {a}), w))
  qed
  show := mp(all_elim(agw, {a}), hao, (!(int_le(int_add(g, 24), a) && int_lt(a, int_add(g, 32))) by taut(nw)))
qed

// a byte of the data, the image's constants, the reserve or a group: in
// no meta area's page
theorem mp.noarea(c, A, M, b, brk, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds(c, A, M, b, brk) -> a in omega ->
  ((((ex i. i in omega && int_lt(i, 3) && mallocng.in_range(a, app(mallocng.data_ranges(c), i))) ||
    (ex i. i in omega && int_lt(i, x86_64_linux.phnum(app(c, "file"))) && mallocng.in_range(a, app(mallocng.ro_ranges(app(c, "file")), i)))) ||
    mallocng.in_range(a, pair(app(A, "reserve"), int_mul(4096, app(A, "reserve_cnt"))))) ||
    (ex h. mallocng.is_used(A, h) && mallocng.in_range(a, mallocng.group_range(app(app(A, "metas"), h))))) ->
  (all k. k in omega -> int_lt(k, seq_len(app(A, "areas"))) -> !(int_le(app(app(A, "areas"), k), a) && int_lt(a, int_add(app(app(A, "areas"), k), 4096))))
proof
  assume hc hu ha H hao hr
  fix k
  assume hk hkl
  have n: int_le(app(app(A, "areas"), k), a) && int_lt(a, int_add(app(app(A, "areas"), k), 4096)) -> false proof
    assume hin
    have {d = data, r = ro, rs = reserve, gr = groups} := apply(mp.area_apart[c := c, A := A, M := M, b := b, brk := brk, k := k, a := a], hc, hu, ha, H, hk, hkl, hao, taut(hin), taut(hin))
    have c1: (ex i. i in omega && int_lt(i, 3) && mallocng.in_range(a, app(mallocng.data_ranges(c), i))) -> false proof
      assume e
      obtain i, hi hil hir from e
      show by taut(mp(all_elim(d, {i}), hi, hil), hir)
    qed
    have c2: (ex i. i in omega && int_lt(i, x86_64_linux.phnum(app(c, "file"))) && mallocng.in_range(a, app(mallocng.ro_ranges(app(c, "file")), i))) -> false proof
      assume e
      obtain i, hi hil hir from e
      show by taut(mp(all_elim(r, {i}), hi, hil), hir)
    qed
    have c4: (ex h. mallocng.is_used(A, h) && mallocng.in_range(a, mallocng.group_range(app(app(A, "metas"), h)))) -> false proof
      assume e
      obtain h, hh hir from e
      show by taut(mp(all_elim(gr, {h}), hh), hir)
    qed
    show by taut(hr, c1, c2, rs, c4)
  qed
  show by taut(n)
qed

// a byte of a meta's other than g's mask words: as before
theorem mp.mf_meta(c, A, A2, M, M2, b, brk, g, l, a): mp.mframe(c, A, A2, M, M2, b, brk, g) -> mallocng.meta_slot(A, l) -> a in omega ->
  int_le(l, a) -> int_lt(a, int_add(l, 40)) -> (!(l = g) || int_lt(a, int_add(g, 24)) || int_le(int_add(g, 32), a)) -> app(M2, a) = app(M, a)
proof
  assume F hl hao h1 h2 hor
  have {hc = cfg, hu = univ, ha = abs, H = holds, hg = used, agw = bytes} := F
  have {hpart = part} := expand(H, mallocng.holds)
  obtain kg, hkg hkgr from expand(hg, mallocng.is_used)
  have hkgl hkge := hkgr
  have {usl = used_slots} := expand(hpart, mallocng.metas_partition)
  have gms := rewrite(hkge, mp(all_elim(usl, {kg}), hkg, hkgl))
  have {go = nat} := apply(mp.mf_page, F)
  have c1: !(l = g) -> !(int_le(int_add(g, 24), a) && int_lt(a, int_add(g, 32))) proof
    assume hne
    have d := apply(mp.meta_disj[c := c, A := A, M := M, b := b, brk := brk, g := g, l := l, a := a], hc, hu, ha, H, gms, hl, hne, hao, h1, h2)
    show by arith(d, go, hao)
  qed
  have c2: int_lt(a, int_add(g, 24)) || int_le(int_add(g, 32), a) -> !(int_le(int_add(g, 24), a) && int_lt(a, int_add(g, 32))) proof
    assume h
    show by arith(h, go, hao)
  qed
  show := mp(all_elim(agw, {a}), hao, taut(hor, c1, c2))
qed

// a byte of a meta area's header: as before (g's mask words past it)
theorem mp.mf_hdr(c, A, A2, M, M2, b, brk, g, k, a): mp.mframe(c, A, A2, M, M2, b, brk, g) -> k in omega -> int_lt(k, seq_len(app(A, "areas"))) -> a in omega ->
  int_le(app(app(A, "areas"), k), a) -> int_lt(a, int_add(app(app(A, "areas"), k), 24)) -> app(M2, a) = app(M, a)
proof
  assume F hk hkl hao h1 h2
  have {hc = cfg, hu = univ, ha = abs, H = holds, agw = bytes} := F
  have {go = nat, pa = area} := apply(mp.mf_page, F)
  obtain k0, hk0 hk0l inp glo from pa
  have rl: app(A, "areas") in list_type(omega) by simp(ha)
  have ako := mp(at_type[l := app(A, "areas"), t := omega, i := k], rl, hk, hkl)
  have ak0 := mp(at_type[l := app(A, "areas"), t := omega, i := k0], rl, hk0, hk0l)
  have nw: int_le(int_add(g, 24), a) && int_lt(a, int_add(g, 32)) -> false proof
    assume w
    have pg0 := mp(all_elim(inp, {a}), w)
    have same: k = k0 -> false proof
      assume e
      have h2e := rewrite(e, h2)
      have w1 w2 := w
      show by arith(h2e, glo, w1, go, hao, ak0)
    qed
    have diff: !(k = k0) -> false proof
      assume e
      have {ar = areas} := apply(mp.area_apart[c := c, A := A, M := M, b := b, brk := brk, k := k, a := a], hc, hu, ha, H, hk, hkl, hao, h1, arith(h2, ako, hao))
      show by taut(mp(all_elim(ar, {k0}), hk0, hk0l, (!(k0 = k) by taut(e))), pg0)
    qed
    show by taut(same, diff)
  qed
  show := mp(all_elim(agw, {a}), hao, (!(int_le(int_add(g, 24), a) && int_lt(a, int_add(g, 32))) by taut(nw)))
qed

// (a read-only segment's range: naturals)
theorem mp.ro_nat(f, i): f in seq_type(bits(8)) -> i in omega -> int_lt(i, x86_64_linux.phnum(f)) -> app(mallocng.ro_ranges(f), i) in cart(omega, omega)
proof
  assume fs hi hil
  have pn: x86_64_linux.phnum(f) in omega by defs(mp(x86.le_at_nat[f := f, off := 56, n := 2], fs, simp()), x86_64_linux.phnum)
  have iin := mp(nat_lt_mem[k := i, n := int_sub(x86_64_linux.phnum(f), 0)], hi, arith(pn), arith(hil, pn, hi))
  have ab := mp(app_fn_build[d := int_sub(x86_64_linux.phnum(f), 0), v := x0. ite(x86_64_linux.is_load(f, int_add(0, x0)) && !bit(app(x86_64_linux.segment(f, int_add(0, x0)), "flags"), 1),
    pair(app(x86_64_linux.segment(f, int_add(0, x0)), "vaddr"), app(x86_64_linux.segment(f, int_add(0, x0)), "memsz")), pair(0, 0)), a := i], iin)
  have v1 := mp(x86.le_at_nat[f := f, off := int_add(x86_64_linux.ph(f, int_add(0, i)), 16), n := 8], fs, simp())
  have v2 := mp(x86.le_at_nat[f := f, off := int_add(x86_64_linux.ph(f, int_add(0, i)), 40), n := 8], fs, simp())
  have w1: app(x86_64_linux.segment(f, int_add(0, i)), "vaddr") in omega by defs(simp(v1), x86_64_linux.segment)
  have w2: app(x86_64_linux.segment(f, int_add(0, i)), "memsz") in omega by defs(simp(v2), x86_64_linux.segment)
  have p := mp(cart_intro[a := omega, b := omega, x := app(x86_64_linux.segment(f, int_add(0, i)), "vaddr"), y := app(x86_64_linux.segment(f, int_add(0, i)), "memsz")], w1, w2)
  have it := apply(ite_in[c := x86_64_linux.is_load(f, int_add(0, i)) && !bit(app(x86_64_linux.segment(f, int_add(0, i)), "flags"), 1)], p, mp(cart_intro[a := omega, b := omega, x := 0, y := 0], simp(), simp()))
  show by defs(rewrite(sym(ab), it), mallocng.ro_ranges)
qed

// (a byte of the data, the image's constants, the reserve or a group: as before)
theorem mp.mf_region(c, A, A2, M, M2, b, brk, g, a): mp.mframe(c, A, A2, M, M2, b, brk, g) -> a in omega ->
  ((((ex i. i in omega && int_lt(i, 3) && mallocng.in_range(a, app(mallocng.data_ranges(c), i))) ||
    (ex i. i in omega && int_lt(i, x86_64_linux.phnum(app(c, "file"))) && mallocng.in_range(a, app(mallocng.ro_ranges(app(c, "file")), i)))) ||
    mallocng.in_range(a, pair(app(A, "reserve"), int_mul(4096, app(A, "reserve_cnt"))))) ||
    (ex h. mallocng.is_used(A, h) && mallocng.in_range(a, mallocng.group_range(app(app(A, "metas"), h))))) ->
  app(M2, a) = app(M, a)
proof
  assume F hao hr
  have {hc = cfg, hu = univ, ha = abs, H = holds} := F
  show := apply(mp.mf_far[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, g := g, a := a], F, hao,
    apply(mp.noarea[c := c, A := A, M := M, b := b, brk := brk, a := a], hc, hu, ha, H, hao, hr))
qed

// the image intact: its bytes and pages none of g's mask words
theorem mp.mf_image(c, A, A2, M, M2, b, brk, g): mp.mframe(c, A, A2, M, M2, b, brk, g) -> mallocng.image_ok(c, M2)
proof
  assume F
  have {hc = cfg, H = holds, pgs = pages} := F
  have {himg = image} := expand(H, mallocng.holds)
  have i1 i2 i3 := expand(himg, mallocng.image_ok)
  let FL := app(c, "file")
  have fs: FL in seq_type(bits(8)) by simp(hc)
  have pn: x86_64_linux.phnum(FL) in omega by defs(mp(x86.le_at_nat[f := FL, off := 56, n := 2], fs, simp()), x86_64_linux.phnum)
  have cl1 cl2 cl3 := (app(c, "ctx") in omega && app(c, "lock") in omega && app(c, "libc") in omega by simp(hc))
  have d0 d1 d2 := apply(mp.data_at[c := c])
  // the read-only segments
  have ro2: all x0. x0 in omega -> int_lt(x0, x86_64_linux.phnum(FL)) && x86_64_linux.is_load(FL, x0) -> mallocng.ro_segment_ok(FL, x0, x86_64_linux.segment(FL, x0), M2) proof
    fix i
    assume hi hq
    let SG := x86_64_linux.segment(FL, i)
    have rs := mp(all_elim(i1, {i}), hi, hq)
    have hil hld := hq
    have r: !bit(app(SG, "flags"), 1) ->
        (all x0. x0 in omega -> int_le(app(SG, "vaddr"), x0) && int_lt(x0, int_add(app(SG, "vaddr"), app(SG, "memsz"))) ->
           mallocng.b8(M2, x0) = ite(int_lt(x0, int_add(app(SG, "vaddr"), app(SG, "filesz"))), app(FL, int_add(app(SG, "offset"), int_sub(x0, app(SG, "vaddr")))), 0)) &&
        (all x0. x0 in omega -> (int_le(int_div(app(SG, "vaddr"), x86_64_linux.PAGE), x0) && int_le(x0, int_div(int_sub(int_add(app(SG, "vaddr"), app(SG, "memsz")), 1), x86_64_linux.PAGE))) &&
           x86_64_linux.last_on_page(FL, i, x0) -> mallocng.pg(M2, int_mul(x0, x86_64_linux.PAGE)) = some(fn_update(fn_update(empty, "prot", x86_64_linux.seg_prot(SG)), "kind", 0))) proof
      assume hw
      have b1 b2 := mp(expand(rs, mallocng.ro_segment_ok), hw)
      have iin := mp(nat_lt_mem[k := i, n := int_sub(x86_64_linux.phnum(FL), 0)], hi, arith(pn), arith(hil, pn, hi))
      have ab := mp(app_fn_build[d := int_sub(x86_64_linux.phnum(FL), 0), v := x0. ite(x86_64_linux.is_load(FL, int_add(0, x0)) && !bit(app(x86_64_linux.segment(FL, int_add(0, x0)), "flags"), 1),
        pair(app(x86_64_linux.segment(FL, int_add(0, x0)), "vaddr"), app(x86_64_linux.segment(FL, int_add(0, x0)), "memsz")), pair(0, 0)), a := i], iin)
      have ri: app(mallocng.ro_ranges(FL), i) = pair(app(SG, "vaddr"), app(SG, "memsz")) by defs(simp(ab, (int_add(0, i) = i by arith(hi)), hld, hw), mallocng.ro_ranges)
      have bt: all x0. x0 in omega -> int_le(app(SG, "vaddr"), x0) && int_lt(x0, int_add(app(SG, "vaddr"), app(SG, "memsz"))) ->
          mallocng.b8(M2, x0) = ite(int_lt(x0, int_add(app(SG, "vaddr"), app(SG, "filesz"))), app(FL, int_add(app(SG, "offset"), int_sub(x0, app(SG, "vaddr")))), 0) proof
        fix x
        assume hx hxr
        have inr: mallocng.in_range(x, app(mallocng.ro_ranges(FL), i)) by defs(simp(ri, hxr), mallocng.in_range)
        have ex: ex j. j in omega && int_lt(j, x86_64_linux.phnum(FL)) && mallocng.in_range(x, app(mallocng.ro_ranges(FL), j)) by ex_intro({i}, taut(hi, hil, inr))
        have e := apply(mp.mf_region[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, g := g, a := x], F, hx, taut(ex))
        have {eb = byte} := apply(mp.agree_b8, e)
        show := trans(eb, mp(all_elim(b1, {x}), hx, hxr))
      qed
      have pt: all x0. x0 in omega -> (int_le(int_div(app(SG, "vaddr"), x86_64_linux.PAGE), x0) && int_le(x0, int_div(int_sub(int_add(app(SG, "vaddr"), app(SG, "memsz")), 1), x86_64_linux.PAGE))) &&
          x86_64_linux.last_on_page(FL, i, x0) -> mallocng.pg(M2, int_mul(x0, x86_64_linux.PAGE)) = some(fn_update(fn_update(empty, "prot", x86_64_linux.seg_prot(SG)), "kind", 0)) proof
        fix x
        assume hx hxr
        have po: int_mul(x, x86_64_linux.PAGE) in omega by defs(simp(hx), x86_64_linux.PAGE)
        show := trans(mp(all_elim(pgs, {int_mul(x, x86_64_linux.PAGE)}), po), mp(all_elim(b2, {x}), hx, hxr))
      qed
      show by taut(bt, pt)
    qed
    show by defs(r, mallocng.ro_segment_ok)
  qed
  // libc's need-locks byte, the lock word
  have lnl: mallocng.L_NEED_LOCKS = 3 by defs(simp(), mallocng.L_NEED_LOCKS)
  have lr: int_le(app(c, "libc"), int_add(app(c, "libc"), 3)) && int_lt(int_add(app(c, "libc"), 3), int_add(app(c, "libc"), 16)) by arith(cl3)
  have lb: mallocng.in_range(int_add(app(c, "libc"), mallocng.L_NEED_LOCKS), app(mallocng.data_ranges(c), 2)) by defs(simp(d2, lnl, lr), mallocng.in_range)
  have lbx: ex i. i in omega && int_lt(i, 3) && mallocng.in_range(int_add(app(c, "libc"), mallocng.L_NEED_LOCKS), app(mallocng.data_ranges(c), i)) by ex_intro({2}, taut((2 in omega by simp()), (int_lt(2, 3) by simp()), lb))
  have el := apply(mp.mf_region[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, g := g, a := int_add(app(c, "libc"), mallocng.L_NEED_LOCKS)], F, simp(cl3, lnl), taut(lbx))
  have {elb = byte} := apply(mp.agree_b8, el)
  have lk: all i. i in omega -> int_lt(i, 4) -> app(M2, int_add(app(c, "lock"), i)) = app(M, int_add(app(c, "lock"), i)) proof
    fix i
    assume hi hil
    have lr: int_le(app(c, "lock"), int_add(app(c, "lock"), i)) && int_lt(int_add(app(c, "lock"), i), int_add(app(c, "lock"), 4)) by arith(cl2, hi, hil)
    have inr: mallocng.in_range(int_add(app(c, "lock"), i), app(mallocng.data_ranges(c), 1)) by defs(simp(d1, lr), mallocng.in_range)
    have ex: ex j. j in omega && int_lt(j, 3) && mallocng.in_range(int_add(app(c, "lock"), i), app(mallocng.data_ranges(c), j)) by ex_intro({1}, taut((1 in omega by simp()), (int_lt(1, 3) by simp()), inr))
    show := apply(mp.mf_region[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, g := g, a := int_add(app(c, "lock"), i)], F, simp(cl2, hi), taut(ex))
  qed
  have rl := apply(mp.agree_rd[M := M, M2 := M2, a := app(c, "lock"), n := 4], simp(), lk)
  show by defs(taut(ro2, rewrite(sym(elb), i2), rewrite(sym(rl), i3)), mallocng.image_ok)
qed

// the class table intact: in the image's constants
theorem mp.mf_classes(c, A, A2, M, M2, b, brk, g): mp.mframe(c, A, A2, M, M2, b, brk, g) -> mallocng.classes_ok(c, M2)
proof
  assume F
  have {hc = cfg, H = holds, pgs = pages} := F
  have {hcls = classes} := expand(H, mallocng.holds)
  have k1 k2 k3 := expand(hcls, mallocng.classes_ok)
  obtain i, hi hil hlo hhi from k3
  have so: app(c, "sct") in omega by simp(hc)
  let RI := app(mallocng.ro_ranges(app(c, "file")), i)
  have fs: app(c, "file") in seq_type(bits(8)) by simp(hc)
  have rn := apply(mp.ro_nat[f := app(c, "file"), i := i], fs, hi, hil)
  have rs rz := apply(mp.cart_nat, rn)
  have tb: all a. a in omega -> int_le(app(c, "sct"), a) -> int_lt(a, int_add(app(c, "sct"), int_mul(2, 48))) -> app(M2, a) = app(M, a) proof
    fix a
    assume hao h1 h2
    have inr: mallocng.in_range(a, RI) by defs(arith(h1, h2, hlo, hhi, rs, rz, so, hao), mallocng.in_range)
    have ex: ex j. j in omega && int_lt(j, x86_64_linux.phnum(app(c, "file"))) && mallocng.in_range(a, app(mallocng.ro_ranges(app(c, "file")), j)) by ex_intro({i}, taut(hi, hil, inr))
    show := apply(mp.mf_region[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, g := g, a := a], F, hao, taut(ex))
  qed
  have k1b: all x0. x0 in omega -> int_lt(x0, 48) -> mallocng.rd(M2, int_add(app(c, "sct"), int_mul(2, x0)), 2) = app(mallocng.size_classes, x0) proof
    fix x
    assume hx hxl
    have ai: all j. j in omega -> int_lt(j, 2) -> app(M2, int_add(int_add(app(c, "sct"), int_mul(2, x)), j)) = app(M, int_add(int_add(app(c, "sct"), int_mul(2, x)), j)) proof
      fix j
      assume hj hjl
      show := mp(all_elim(tb, {int_add(int_add(app(c, "sct"), int_mul(2, x)), j)}), simp(so, hx, hj), arith(so, hx, hj), arith(so, hx, hxl, hj, hjl))
    qed
    have e := apply(mp.agree_rd[M := M, M2 := M2, a := int_add(app(c, "sct"), int_mul(2, x)), n := 2], simp(), ai)
    show := trans(e, mp(all_elim(k1, {x}), hx, hxl))
  qed
  have k2b: all x0. x0 in omega -> int_le(app(c, "sct"), x0) && int_lt(x0, int_add(app(c, "sct"), int_mul(2, 48))) ->
      (mallocng.m_mapped(M2, x0) && app(app(snd(mallocng.pg(M2, x0)), "prot"), "r")) && !(app(snd(mallocng.pg(M2, x0)), "kind") = 2) proof
    fix x
    assume hx hxr
    have pe := mp(all_elim(pgs, {x}), hx)
    have o := mp(all_elim(k2, {x}), hx, hxr)
    show by defs(simp(pe, o, expand(o, mallocng.m_mapped)), mallocng.m_mapped)
  qed
  show by defs(taut(k1b, k2b, k3), mallocng.classes_ok)
qed

// (the context's words: as before -- its bytes data)
theorem mp.mf_cw(c, A, A2, M, M2, b, brk, g, off, n): mp.mframe(c, A, A2, M, M2, b, brk, g) -> off in omega -> n in omega ->
  int_le(int_add(off, n), mallocng.CTX_SIZE) -> mallocng.rd(M2, int_add(app(c, "ctx"), off), n) = mallocng.rd(M, int_add(app(c, "ctx"), off), n)
proof
  assume F ho hn hl
  have {hc = cfg} := F
  have co: app(c, "ctx") in omega by simp(hc)
  have d0 d1 d2 := apply(mp.data_at[c := c])
  have cs: mallocng.CTX_SIZE = 928 by defs(simp(), mallocng.CTX_SIZE)
  have ai: all j. j in omega -> int_lt(j, n) -> app(M2, int_add(int_add(app(c, "ctx"), off), j)) = app(M, int_add(int_add(app(c, "ctx"), off), j)) proof
    fix j
    assume hj hjl
    have lr: int_le(app(c, "ctx"), int_add(int_add(app(c, "ctx"), off), j)) && int_lt(int_add(int_add(app(c, "ctx"), off), j), int_add(app(c, "ctx"), mallocng.CTX_SIZE)) by arith(co, ho, hj, hjl, hl, cs)
    have inr: mallocng.in_range(int_add(int_add(app(c, "ctx"), off), j), app(mallocng.data_ranges(c), 0)) by defs(simp(d0, lr), mallocng.in_range)
    have ex: ex i. i in omega && int_lt(i, 3) && mallocng.in_range(int_add(int_add(app(c, "ctx"), off), j), app(mallocng.data_ranges(c), i))
      by ex_intro({0}, taut((0 in omega by simp()), (int_lt(0, 3) by simp()), inr))
    show := apply(mp.mf_region[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, g := g, a := int_add(int_add(app(c, "ctx"), off), j)], F, simp(co, ho, hj), taut(ex))
  qed
  show := apply(mp.agree_rd, hn, ai)
qed

// (a meta's links: as before -- g's mask words past them)
theorem mp.mf_links(c, A, A2, M, M2, b, brk, g, l): mp.mframe(c, A, A2, M, M2, b, brk, g) -> mallocng.meta_slot(A, l) ->
  next: mallocng.rd(M2, int_add(l, 8), 8) = mallocng.rd(M, int_add(l, 8), 8) && prev: mallocng.rd(M2, l, 8) = mallocng.rd(M, l, 8)
proof
  assume F hl
  have {ha = abs} := F
  have {lo = nat} := apply(mp.meta_page, ha, hl)
  have {go = nat} := apply(mp.mf_page, F)
  have by16: all j. j in omega -> int_lt(j, 16) -> app(M2, int_add(l, j)) = app(M, int_add(l, j)) proof
    fix j
    assume hj hjl
    have d: !(l = g) || int_lt(int_add(l, j), int_add(g, 24)) || int_le(int_add(g, 32), int_add(l, j)) proof
      have c1: l = g -> int_lt(int_add(l, j), int_add(g, 24)) by arith(hj, hjl, lo, go)
      show by taut(c1)
    qed
    show := apply(mp.mf_meta[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, g := g, l := l, a := int_add(l, j)], F, hl, simp(lo, hj),
      arith(lo, hj), arith(lo, hj, hjl), d)
  qed
  have a8: all j. j in omega -> int_lt(j, 8) -> app(M2, int_add(int_add(l, 8), j)) = app(M, int_add(int_add(l, 8), j)) proof
    fix j
    assume hj hjl
    have e: int_add(int_add(l, 8), j) = int_add(l, int_add(8, j)) by arith(lo, hj)
    show := rewrite(sym(e), mp(all_elim(by16, {int_add(8, j)}), simp(hj), arith(hj, hjl)))
  qed
  have a0: all j. j in omega -> int_lt(j, 8) -> app(M2, int_add(l, j)) = app(M, int_add(l, j)) proof
    fix j
    assume hj hjl
    show := mp(all_elim(by16, {j}), hj, arith(hj, hjl))
  qed
  show by taut(apply(mp.agree_rd[M := M, M2 := M2, a := int_add(l, 8), n := 8], simp(), a8), apply(mp.agree_rd[M := M, M2 := M2, a := l, n := 8], simp(), a0))
qed

// the context intact: its words, its lists' links
theorem mp.mf_ctx(c, A, A2, M, M2, b, brk, g): mp.mframe(c, A, A2, M, M2, b, brk, g) -> mallocng.ctx_ok(c, A2, M2)
proof
  assume F
  have {H = holds, hmo = mo} := F
  have {hctx = ctx, hpart = part, hac = active} := expand(H, mallocng.holds)
  have {usl = used_slots, frs = free_slots} := expand(hpart, mallocng.metas_partition)
  have c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 := expand(hctx, mallocng.ctx_ok)
  have cv: (((((((mallocng.C_SECRET = 0 && mallocng.C_INIT_DONE = 8) && mallocng.C_FREE_META = 16) && mallocng.C_AVAIL_META = 24) && mallocng.C_AVAIL_CNT = 32) &&
    mallocng.C_AREA_CNT = 40) && mallocng.C_AVAIL_AREAS = 72) && mallocng.C_ACTIVE = 80) && mallocng.C_BRK = 920 && mallocng.CTX_SIZE = 928
    by defs(simp(), mallocng.C_SECRET, mallocng.C_INIT_DONE, mallocng.C_FREE_META, mallocng.C_AVAIL_META, mallocng.C_AVAIL_CNT, mallocng.C_AREA_CNT,
      mallocng.C_AVAIL_AREAS, mallocng.C_ACTIVE, mallocng.C_BRK, mallocng.CTX_SIZE)
  have v0 v8 v16 v24 v32 v40 v72 v80 v920 vs := cv
  have cw: all off. off in omega -> int_le(int_add(off, 8), mallocng.CTX_SIZE) -> mallocng.ctx_word(c, M2, off) = mallocng.ctx_word(c, M, off) proof
    fix off
    assume ho hl
    show by defs(apply(mp.mf_cw[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, g := g, off := off, n := 8], F, ho, simp(), hl), mallocng.ctx_word)
  qed
  have w0 := mp(all_elim(cw, {mallocng.C_SECRET}), simp(v0), arith(v0, vs))
  have w24 := mp(all_elim(cw, {mallocng.C_AVAIL_META}), simp(v24), arith(v24, vs))
  have w32 := mp(all_elim(cw, {mallocng.C_AVAIL_CNT}), simp(v32), arith(v32, vs))
  have w40 := mp(all_elim(cw, {mallocng.C_AREA_CNT}), simp(v40), arith(v40, vs))
  have w72 := mp(all_elim(cw, {mallocng.C_AVAIL_AREAS}), simp(v72), arith(v72, vs))
  have w920 := mp(all_elim(cw, {mallocng.C_BRK}), simp(v920), arith(v920, vs))
  have w16 := mp(all_elim(cw, {mallocng.C_FREE_META}), simp(v16), arith(v16, vs))
  have r4 := apply(mp.mf_cw[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, g := g, off := mallocng.C_INIT_DONE, n := 4], F, simp(v8), simp(), arith(v8, vs))
  // the free metas' list
  have fl: all i. i in omega -> int_lt(i, seq_len(app(A, "free_metas"))) ->
      mallocng.rd(M2, int_add(app(app(A, "free_metas"), i), 8), 8) = mallocng.rd(M, int_add(app(app(A, "free_metas"), i), 8), 8) &&
      mallocng.rd(M2, app(app(A, "free_metas"), i), 8) = mallocng.rd(M, app(app(A, "free_metas"), i), 8) proof
    fix i
    assume hi hil
    have ms nu := mp(all_elim(frs, {i}), hi, hil)
    show := apply(mp.mf_links[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, g := g, l := app(app(A, "free_metas"), i)], F, ms)
  qed
  have c10b := apply(mp.cyclic_agree[M := M, M2 := M2, hd := mallocng.ctx_word(c, M2, mallocng.C_FREE_META), l := app(A, "free_metas")], rewrite(sym(w16), c10), fl)
  // the active lists
  have c12b: all x0. x0 in omega -> int_lt(x0, 48) ->
      mallocng.cyclic(M2, mallocng.ctx_word(c, M2, int_add(mallocng.C_ACTIVE, int_mul(8, x0))), app(app(A, "active"), x0)) proof
    fix sc
    assume hs hsl
    have wa := mp(all_elim(cw, {int_add(mallocng.C_ACTIVE, int_mul(8, sc))}), simp(v80, hs), arith(v80, vs, hs, hsl))
    have al: all i. i in omega -> int_lt(i, seq_len(app(app(A, "active"), sc))) ->
        mallocng.rd(M2, int_add(app(app(app(A, "active"), sc), i), 8), 8) = mallocng.rd(M, int_add(app(app(app(A, "active"), sc), i), 8), 8) &&
        mallocng.rd(M2, app(app(app(A, "active"), sc), i), 8) = mallocng.rd(M, app(app(app(A, "active"), sc), i), 8) proof
      fix i
      assume hi hil
      have iu isc ihd := mp(all_elim(expand(hac, mallocng.active_ok), {sc}, {i}), conj(hs, hi), conj(hsl, hil))
      obtain k, hk hkr from expand(iu, mallocng.is_used)
      have hkl hke := hkr
      have ms := rewrite(hke, mp(all_elim(usl, {k}), hk, hkl))
      show := apply(mp.mf_links[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, g := g, l := app(app(app(A, "active"), sc), i)], F, ms)
    qed
    show := apply(mp.cyclic_agree[M := M, M2 := M2, hd := mallocng.ctx_word(c, M2, int_add(mallocng.C_ACTIVE, int_mul(8, sc))), l := app(app(A, "active"), sc)],
      rewrite(sym(wa), mp(all_elim(c12, {sc}), hs, hsl)), al)
  qed
  have ok: mallocng.ctx_ok(c, A, M2) by defs(taut(rewrite(sym(w0), c1), rewrite(sym(r4), c2), c3, rewrite(sym(w32), c4), c5, rewrite(sym(w24), c6),
    rewrite(sym(w40), c7), rewrite(sym(w72), c8), rewrite(sym(w920), c9), c10b, c11, c12b), mallocng.ctx_ok)
  have {ec = ctx} := apply(mp.mo_same[c := c, A := A, A2 := A2, M := M2, b := b, brk := brk], hmo)
  show := rewrite(sym(ec), ok)
qed

// fresh: a group in use, so initialised -- nothing to keep
theorem mp.mf_fresh(c, A, A2, M, M2, b, brk, g): mp.mframe(c, A, A2, M, M2, b, brk, g) -> mallocng.fresh_ok(c, A2, M2)
proof
  assume F
  have {H = holds, hmo = mo, hg = used} := F
  have {hfr = fresh} := expand(H, mallocng.holds)
  obtain kg, hkg hkgr from expand(hg, mallocng.is_used)
  have hkgl hkge := hkgr
  have z: app(A, "init_done") = 0 -> seq_len(app(A, "used")) = 0 by taut(expand(hfr, mallocng.fresh_ok))
  have nz: !(app(A, "init_done") = 0) proof
    have n: app(A, "init_done") = 0 -> false proof
      assume h
      show by arith(mp(z, h), hkg, hkgl)
    qed
    show by taut(n)
  qed
  have ok: mallocng.fresh_ok(c, A, M2) by defs(taut(nz), mallocng.fresh_ok)
  have {ef = fresh} := apply(mp.mo_same[c := c, A := A, A2 := A2, M := M2, b := b, brk := brk], hmo)
  show := rewrite(sym(ef), ok)
qed

// the meta areas intact: their headers, pages and the reserve's bytes
theorem mp.mf_areas(c, A, A2, M, M2, b, brk, g): mp.mframe(c, A, A2, M, M2, b, brk, g) -> mallocng.areas_ok(c, A2, M2)
proof
  assume F
  have {ha = abs, H = holds, hmo = mo, pgs = pages} := F
  have {har = areas} := expand(H, mallocng.holds)
  have {ah = head, at = tail, ae = each, ad = distinct, ar = reserve} := expand(har, mallocng.areas_ok)
  have cv: mallocng.C_AREA_HEAD = 56 && mallocng.C_AREA_TAIL = 64 && mallocng.CTX_SIZE = 928 by defs(simp(), mallocng.C_AREA_HEAD, mallocng.C_AREA_TAIL, mallocng.CTX_SIZE)
  have vh vt vs := cv
  have wh: mallocng.ctx_word(c, M2, mallocng.C_AREA_HEAD) = mallocng.ctx_word(c, M, mallocng.C_AREA_HEAD)
    by defs(apply(mp.mf_cw[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, g := g, off := mallocng.C_AREA_HEAD, n := 8], F, simp(vh), simp(), arith(vh, vs)), mallocng.ctx_word)
  have wt: mallocng.ctx_word(c, M2, mallocng.C_AREA_TAIL) = mallocng.ctx_word(c, M, mallocng.C_AREA_TAIL)
    by defs(apply(mp.mf_cw[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, g := g, off := mallocng.C_AREA_TAIL, n := 8], F, simp(vt), simp(), arith(vt, vs)), mallocng.ctx_word)
  have rl: app(A, "areas") in list_type(omega) by simp(ha)
  have ae2: all x0. x0 in omega -> int_lt(x0, seq_len(app(A, "areas"))) ->
      ((((((int_mod(app(app(A, "areas"), x0), 4096) = 0 && int_lt(0, app(app(A, "areas"), x0))) && mallocng.rd(M2, app(app(A, "areas"), x0), 8) = app(A, "secret")) &&
        mallocng.rd(M2, int_add(app(app(A, "areas"), x0), 8), 8) = ite(int_lt(int_add(x0, 1), seq_len(app(A, "areas"))), app(app(A, "areas"), int_add(x0, 1)), 0)) &&
        mallocng.rd(M2, int_add(app(app(A, "areas"), x0), 16), 4) = mallocng.NSLOTS) &&
        (all x1. x1 in omega -> int_le(app(app(A, "areas"), x0), x1) && int_lt(x1, int_add(app(app(A, "areas"), x0), 4096)) -> mallocng.m_rw(M2, x1) && !(app(snd(mallocng.pg(M2, x1)), "kind") = 2)))) proof
    fix k
    assume hk hkl
    have e1 e2 e3 e4 e5 e6 := mp(all_elim(ae, {k}), hk, hkl)
    have ako := mp(at_type[l := app(A, "areas"), t := omega, i := k], rl, hk, hkl)
    have hb: all o. all n. o in omega -> n in omega -> int_le(int_add(o, n), 24) ->
        mallocng.rd(M2, int_add(app(app(A, "areas"), k), o), n) = mallocng.rd(M, int_add(app(app(A, "areas"), k), o), n) proof
      fix o n
      assume ho hn hl
      have ai: all j. j in omega -> int_lt(j, n) -> app(M2, int_add(int_add(app(app(A, "areas"), k), o), j)) = app(M, int_add(int_add(app(app(A, "areas"), k), o), j)) proof
        fix j
        assume hj hjl
        show := apply(mp.mf_hdr[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, g := g, k := k, a := int_add(int_add(app(app(A, "areas"), k), o), j)],
          F, hk, hkl, simp(ako, ho, hj), arith(ako, ho, hj), arith(ako, ho, hj, hjl, hl))
      qed
      show := apply(mp.agree_rd, hn, ai)
    qed
    have r0 := rewrite((int_add(app(app(A, "areas"), k), 0) = app(app(A, "areas"), k) by arith(ako)), mp(all_elim(hb, {0}, {8}), simp(), simp(), simp()))
    have r8 := mp(all_elim(hb, {8}, {8}), simp(), simp(), simp())
    have r16 := mp(all_elim(hb, {16}, {4}), simp(), simp(), simp())
    have p6: all x1. x1 in omega -> int_le(app(app(A, "areas"), k), x1) && int_lt(x1, int_add(app(app(A, "areas"), k), 4096)) ->
        mallocng.m_rw(M2, x1) && !(app(snd(mallocng.pg(M2, x1)), "kind") = 2) proof
      fix x
      assume hx hxr
      have pe := mp(all_elim(pgs, {x}), hx)
      have {rw = rw} := apply(mp.pg_same, pe)
      have o1 o2 := mp(all_elim(e6, {x}), hx, hxr)
      show by taut(rw, o1, rewrite(sym(pe), o2))
    qed
    show by taut(e1, e2, rewrite(sym(r0), e3), rewrite(sym(r8), e4), rewrite(sym(r16), e5), p6)
  qed
  have ar2: all x0. x0 in omega -> int_le(app(A, "reserve"), x0) && int_lt(x0, int_add(app(A, "reserve"), int_mul(4096, app(A, "reserve_cnt")))) ->
      mallocng.m_mapped(M2, x0) && mallocng.b8(M2, x0) = 0 proof
    fix x
    assume hx hxr
    have inr: mallocng.in_range(x, pair(app(A, "reserve"), int_mul(4096, app(A, "reserve_cnt")))) by defs(simp(hxr), mallocng.in_range)
    have e := apply(mp.mf_region[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, g := g, a := x], F, hx, taut(inr))
    have {eb = byte, ep = page} := apply(mp.agree_b8, e)
    have {mm = mapped} := apply(mp.pg_same, ep)
    have o1 o2 := mp(all_elim(ar, {x}), hx, hxr)
    show by taut(mm, o1, rewrite(sym(eb), o2))
  qed
  have ok: mallocng.areas_ok(c, A, M2) by defs(taut(rewrite(sym(wh), ah), rewrite(sym(wt), at), ae2, ad, ar2), mallocng.areas_ok)
  have {ea = areas} := apply(mp.mo_used[c := c, A := A, A2 := A2, M := M2, x := g], hmo)
  show := rewrite(sym(ea), ok)
qed

// the groups in use: g with its masks anew, the others as before
theorem mp.mf_used(c, A, A2, M, M2, b, brk, g): mp.mframe(c, A, A2, M, M2, b, brk, g) ->
  mallocng.meta_in_memory(M2, g, app(app(A2, "metas"), g)) -> mallocng.masks_ok(A2, M2, g) -> mallocng.big_ok(A2, g) ->
  mallocng.used_ok(A2, M2, b)
proof
  assume F mim2 msk2 big2
  have {ha = abs, hb = blocks, H = holds, hmo = mo, heq = others} := F
  have {huo = used, hpart = part} := expand(H, mallocng.holds)
  have {usl = used_slots} := expand(hpart, mallocng.metas_partition)
  have eus := apply(mp.mo_field[A := A, A2 := A2, k := "used"], hmo, simp())
  have esl := apply(mp.mo_field[A := A, A2 := A2, k := "slots"], hmo, simp())
  have ul: app(A, "used") in list_type(omega) by simp(ha)
  have r: all x0. x0 in omega -> int_lt(x0, seq_len(app(A2, "used"))) -> mallocng.group_ok(A2, M2, b, app(app(A2, "used"), x0)) proof
    fix k
    assume hk hkl0
    have hkl: int_lt(k, seq_len(app(A, "used"))) := rewrite(eus, hkl0)
    let h := app(app(A, "used"), k)
    let V := app(app(A, "metas"), h)
    have ho := apply(at_type[l := app(A, "used"), t := omega, i := k], ul, hk, hkl)
    have iu: mallocng.is_used(A, h) by defs(ex_intro({k}, taut(hk, hkl, refl({h}))), mallocng.is_used)
    have hms := mp(all_elim(usl, {k}), hk, hkl)
    have gok := apply(mp.used_group, huo, iu)
    have {hm = mim, hmk = masks, hbg = big} := expand(gok, mallocng.group_ok)
    // its bytes: as before
    have agh: all a. a in omega -> int_le(app(V, "mem"), a) -> int_le(a, mallocng.slot_end(V, app(V, "last_idx"))) -> app(M2, a) = app(M, a) proof
      fix a
      assume hao h1 h2
      have inr := apply(mp.group_bytes[A := A, M := M, b := b, h := h, a := a], ha, ho, gok, hao, h1, h2)
      have ex: ex hh. mallocng.is_used(A, hh) && mallocng.in_range(a, mallocng.group_range(app(app(A, "metas"), hh))) by ex_intro({h}, taut(iu, inr))
      show := apply(mp.mf_region[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, g := g, a := a], F, hao, taut(ex))
    qed
    // g: its record, masks, big-allocation clause anew
    have cg: h = g -> mallocng.group_ok(A2, M2, b, h) proof
      assume e
      show := apply(mp.group_tr[A := A, A2 := A2, M := M, M2 := M2, b := b, h := h], ha, hb, ho, hmo, huo, gok, agh,
        rewrite(sym(e), mim2), rewrite(sym(e), msk2), rewrite(sym(e), big2))
    qed
    // another: as before
    have co: !(h = g) -> mallocng.group_ok(A2, M2, b, h) proof
      assume ne
      have eh := mp(all_elim(heq, {h}), ho, ne)
      have a40: all j. j in omega -> int_lt(j, 40) -> app(M2, int_add(h, j)) = app(M, int_add(h, j)) proof
        fix j
        assume hj hjl
        show := apply(mp.mf_meta[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, g := g, l := h, a := int_add(h, j)], F, hms, simp(ho, hj),
          arith(ho, hj), arith(ho, hj, hjl), (!(h = g) || int_lt(int_add(h, j), int_add(g, 24)) || int_le(int_add(g, 32), int_add(h, j)) by taut(ne)))
      qed
      have m1 := apply(mp.mim_mem[M := M, M2 := M2, h := h, v := V], ho, hm, a40)
      have vt: V in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := app(A, "metas"), x := h], simp(ha), ho)
      have vmem: app(V, "mem") in omega by simp(vt)
      have vlast: app(V, "last_idx") in omega by simp(vt)
      have sn := apply(mp.stride_nat, ha, ho, gok)
      have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
      have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
      have ss: all i. mallocng.slot_start(V, i) = int_add(int_add(app(V, "mem"), 16), int_mul(mallocng.stride(V), i)) proof
        fix i
        show by defs(arith(cu), mallocng.slot_start, mallocng.storage)
      qed
      have sel: mallocng.slot_end(V, app(V, "last_idx")) = int_sub(int_add(int_add(int_add(app(V, "mem"), 16), int_mul(mallocng.stride(V), app(V, "last_idx"))), mallocng.stride(V)), 4)
        by defs(simp(all_elim(ss, {app(V, "last_idx")}), ci), mallocng.slot_end)
      have ml: int_mul(mallocng.stride(V), app(V, "last_idx")) in omega by simp(sn, vlast)
      have bx := apply(mp.agree_b8, mp(all_elim(agh, {int_add(app(V, "mem"), 8)}), simp(vmem), arith(vmem), arith(sel, ml, vmem, sn)))
      have {bxb = byte} := bx
      have es: all i. i in omega -> int_le(i, app(V, "last_idx")) ->
          mallocng.b8(M2, int_sub(mallocng.slot_start(V, i), 4)) = mallocng.b8(M, int_sub(mallocng.slot_start(V, i), 4)) proof
        fix i
        assume hi hil
        have mi := mp(all_elim(ms.mul_le, {mallocng.stride(V)}, {i}, {mallocng.stride(V)}, {app(V, "last_idx")}), sn, hi, simp(sn), simp(vlast), arith(sn), hil)
        have si := all_elim(ss, {i})
        have mo: int_mul(mallocng.stride(V), i) in omega by simp(sn, hi)
        have a := mp(all_elim(agh, {int_sub(mallocng.slot_start(V, i), 4)}), arith(si, vmem, mo), arith(si, vmem, mo), arith(si, sel, mi, vmem, mo, ml, sn))
        have {ab = byte} := apply(mp.agree_b8, a)
        show := ab
      qed
      have mk := apply(mp.masks_mem[A := A, M := M, M2 := M2, h := h], hmk, bxb, es)
      have mk2: mallocng.masks_ok(A2, M2, h) by defs(rewrite(sym(esl), rewrite(sym(eh), expand(mk, mallocng.masks_ok))), mallocng.masks_ok)
      have bg2: mallocng.big_ok(A2, h) by defs(rewrite(sym(eh), expand(hbg, mallocng.big_ok)), mallocng.big_ok)
      show := apply(mp.group_tr[A := A, A2 := A2, M := M, M2 := M2, b := b, h := h], ha, hb, ho, hmo, huo, gok, agh, rewrite(sym(eh), m1), mk2, bg2)
    qed
    have gk: mallocng.group_ok(A2, M2, b, h) by taut(cg, co)
    show := rewrite(sym(eus), gk)
  qed
  show by defs(r, mallocng.used_ok)
qed

// the active lists: as before -- g, if past a list's head, still full
theorem mp.mf_active(c, A, A2, M, M2, b, brk, g): mp.mframe(c, A, A2, M, M2, b, brk, g) ->
  (all sc. all k. sc in omega && k in omega -> int_lt(sc, 48) && int_lt(k, seq_len(app(app(A, "active"), sc))) -> int_lt(0, k) ->
     app(app(app(A, "active"), sc), k) = g -> app(app(app(A2, "metas"), g), "avail") = 0 && !(app(app(app(A2, "metas"), g), "freed") = 0)) ->
  mallocng.active_ok(A2)
proof
  assume F hac2
  have {ha = abs, H = holds, hmo = mo, heq = others} := F
  have {hac = active} := expand(H, mallocng.holds)
  have eac := apply(mp.mo_field[A := A, A2 := A2, k := "active"], hmo, simp())
  have r: all x0. all x1. x0 in omega && x1 in omega -> int_lt(x0, 48) && int_lt(x1, seq_len(app(app(A2, "active"), x0))) ->
      (mallocng.is_used(A2, app(app(app(A2, "active"), x0), x1)) && app(app(app(A2, "metas"), app(app(app(A2, "active"), x0), x1)), "sizeclass") = x0) &&
      (int_lt(0, x1) -> app(app(app(A2, "metas"), app(app(app(A2, "active"), x0), x1)), "avail") = 0 && !(app(app(app(A2, "metas"), app(app(app(A2, "active"), x0), x1)), "freed") = 0)) proof
    fix sc k
    assume ho hq
    let X := app(app(app(A, "active"), sc), k)
    have hs hk := ho
    have hsl hkl0 := hq
    have hkl: int_lt(k, seq_len(app(app(A, "active"), sc))) := rewrite(eac, hkl0)
    have iu isc ihd := mp(all_elim(expand(hac, mallocng.active_ok), {sc}, {k}), conj(hs, hk), conj(hsl, hkl))
    obtain u, hu0 hur from expand(iu, mallocng.is_used)
    have hul hue := hur
    have ul: app(A, "used") in list_type(omega) by simp(ha)
    have xo := rewrite(hue, apply(at_type[l := app(A, "used"), t := omega, i := u], ul, hu0, hul))
    have {eu = used} := apply(mp.mo_used[c := c, A := A, A2 := A2, M := M, x := X], hmo)
    have {es = sclass} := apply(mp.mo_geom[A := A, A2 := A2, x := X], hmo, xo)
    have h1: mallocng.is_used(A2, X) && app(app(app(A2, "metas"), X), "sizeclass") = sc by taut(rewrite(sym(eu), iu), trans(es, isc))
    have h2: int_lt(0, k) -> app(app(app(A2, "metas"), X), "avail") = 0 && !(app(app(app(A2, "metas"), X), "freed") = 0) proof
      assume hp
      have cg: X = g -> app(app(app(A2, "metas"), X), "avail") = 0 && !(app(app(app(A2, "metas"), X), "freed") = 0) proof
        assume e
        show := rewrite(sym(e), mp(all_elim(hac2, {sc}, {k}), conj(hs, hk), conj(hsl, hkl), hp, e))
      qed
      have co: !(X = g) -> app(app(app(A2, "metas"), X), "avail") = 0 && !(app(app(app(A2, "metas"), X), "freed") = 0) proof
        assume ne
        show := rewrite(sym(mp(all_elim(heq, {X}), xo, ne)), mp(ihd, hp))
      qed
      show by taut(cg, co)
    qed
    show := rewrite(sym(eac), conj(h1, h2))
  qed
  show by defs(r, mallocng.active_ok)
qed

// normal: g in use, so the groups not in use as before
theorem mp.mf_normal(c, A, A2, M, M2, b, brk, g): mp.mframe(c, A, A2, M, M2, b, brk, g) -> mallocng.normal(A2)
proof
  assume F
  have {H = holds, hmo = mo, heq = others, hg = used} := F
  have {hn = normal} := expand(H, mallocng.holds)
  have n1 n2 n3 n4 := expand(hn, mallocng.normal)
  have esl := apply(mp.mo_field[A := A, A2 := A2, k := "slots"], hmo, simp())
  have r1: all x0. x0 in omega -> !mallocng.is_used(A2, x0) -> app(app(A2, "metas"), x0) = mallocng.ZERO_META && seq_len(app(app(A2, "slots"), x0)) = 0 proof
    fix x
    assume hx hnu
    have {eu = used} := apply(mp.mo_used[c := c, A := A, A2 := A2, M := M, x := x], hmo)
    have nu := rewrite(eu, hnu)
    have ne: !(x = g) proof
      have n: x = g -> false proof
        assume e
        show by taut(rewrite(e, nu), hg)
      qed
      show by taut(n)
    qed
    have z1 z2 := mp(all_elim(n1, {x}), hx, nu)
    show by taut(trans(mp(all_elim(heq, {x}), hx, ne), z1), rewrite(sym(esl), z2))
  qed
  have eid := apply(mp.mo_field[A := A, A2 := A2, k := "init_done"], hmo, simp())
  have eax := apply(mp.mo_field[A := A, A2 := A2, k := "auxv"], hmo, simp())
  have eat := apply(mp.mo_field[A := A, A2 := A2, k := "auxv_at"], hmo, simp())
  have erc := apply(mp.mo_field[A := A, A2 := A2, k := "reserve_cnt"], hmo, simp())
  have ere := apply(mp.mo_field[A := A, A2 := A2, k := "reserve"], hmo, simp())
  have {e0 = used} := apply(mp.mo_used[c := c, A := A, A2 := A2, M := M, x := 0], hmo)
  show by defs(taut(r1, rewrite(sym(eat), rewrite(sym(eax), rewrite(sym(eid), n2))), rewrite(sym(ere), rewrite(sym(erc), n3)), rewrite(sym(e0), n4)), mallocng.normal)
qed

// the permissions: as before (the pages the same, the groups' bytes too)
theorem mp.mf_perms(c, A, A2, M, M2, b, brk, g): mp.mframe(c, A, A2, M, M2, b, brk, g) -> mallocng.perms_ok(c, A2, M2, b)
proof
  assume F
  have {ha = abs, H = holds, hmo = mo, pgs = pages} := F
  have {hp = perms} := expand(H, mallocng.holds)
  have p1 p2 p3 := expand(hp, mallocng.perms_ok)
  have eus := apply(mp.mo_field[A := A, A2 := A2, k := "used"], hmo, simp())
  have {eax = auxv} := apply(mp.mo_same[c := c, A := A, A2 := A2, M := M, b := b, brk := brk], hmo)
  have ul: app(A, "used") in list_type(omega) by simp(ha)
  // (a page as before: access the same)
  have pq: all x. x in omega -> mallocng.m_rw(M, x) && !(app(snd(mallocng.pg(M, x)), "kind") = 2) -> mallocng.m_rw(M2, x) && !(app(snd(mallocng.pg(M2, x)), "kind") = 2) proof
    fix x
    assume hx h
    have pe := mp(all_elim(pgs, {x}), hx)
    have {rw = rw} := apply(mp.pg_same, pe)
    have o1 o2 := h
    show by taut(rw, o1, rewrite(sym(pe), o2))
  qed
  have q1: all x0. all x1. x0 in omega && x1 in omega -> ((int_lt(x0, 3) && int_le(fst(app(mallocng.data_ranges(c), x0)), x1)) && int_lt(x1, int_add(fst(app(mallocng.data_ranges(c), x0)), snd(app(mallocng.data_ranges(c), x0))))) && !mallocng.ctx_free(c, x1) ->
      mallocng.m_rw(M2, x1) && !(app(snd(mallocng.pg(M2, x1)), "kind") = 2) proof
    fix k x
    assume ho hq
    have hk hx := ho
    show := mp(all_elim(pq, {x}), hx, mp(all_elim(p1, {k}, {x}), ho, hq))
  qed
  have q2: all x0. all x1. x0 in omega && x1 in omega -> (((int_lt(x0, seq_len(app(A2, "used"))) && int_le(fst(mallocng.group_range(app(app(A2, "metas"), app(app(A2, "used"), x0)))), x1)) &&
      int_lt(x1, int_add(fst(mallocng.group_range(app(app(A2, "metas"), app(app(A2, "used"), x0)))), snd(mallocng.group_range(app(app(A2, "metas"), app(app(A2, "used"), x0))))))) &&
      !(x1 in malloc.live_of(b))) && !mallocng.in_reserved(A2, x1) -> mallocng.m_rw(M2, x1) && !(app(snd(mallocng.pg(M2, x1)), "kind") = 2) proof
    fix k x
    assume ho hq
    have hk hx := ho
    have hkl0 lo hi nl nr := hq
    have hkl: int_lt(k, seq_len(app(A, "used"))) := rewrite(eus, hkl0)
    have uo := apply(at_type[l := app(A, "used"), t := omega, i := k], ul, hk, hkl)
    have {gr = range} := apply(mp.mo_geom[A := A, A2 := A2, x := app(app(A, "used"), k)], hmo, uo)
    have ir := apply(mp.mo_inres[A := A, A2 := A2, a := x], ha, hmo)
    have lo2 := rewrite(gr, rewrite(eus, lo))
    have hi2 := rewrite(gr, rewrite(eus, hi))
    have nr2: !mallocng.in_reserved(A, x) by taut(ir, nr)
    show := mp(all_elim(pq, {x}), hx, mp(all_elim(p2, {k}, {x}), ho, taut(hkl, lo2, hi2, nl, nr2)))
  qed
  have q3: all x0. all x1. x0 in omega && x1 in omega -> (int_lt(x0, seq_len(mallocng.auxv_ranges(A2))) && int_le(fst(app(mallocng.auxv_ranges(A2), x0)), x1)) &&
      int_lt(x1, int_add(fst(app(mallocng.auxv_ranges(A2), x0)), snd(app(mallocng.auxv_ranges(A2), x0)))) -> mallocng.m_mapped(M2, x1) && app(app(snd(mallocng.pg(M2, x1)), "prot"), "r") proof
    fix k x
    assume ho hq
    have hk hx := ho
    have o1 o2 := mp(all_elim(p3, {k}, {x}), ho, rewrite(eax, hq))
    have pe := mp(all_elim(pgs, {x}), hx)
    have {mm = mapped} := apply(mp.pg_same, pe)
    show by taut(mm, o1, rewrite(sym(pe), o2))
  qed
  show by defs(taut(q1, q2, q3), mallocng.perms_ok)
qed

// the groups apart from the fixed regions: as before
theorem mp.mf_apart(c, A, A2, M, M2, b, brk, g): mp.mframe(c, A, A2, M, M2, b, brk, g) -> mallocng.groups_apart(c, A2)
proof
  assume F
  have {ha = abs, H = holds, hmo = mo} := F
  have {hap = apart} := expand(H, mallocng.holds)
  have eus := apply(mp.mo_field[A := A, A2 := A2, k := "used"], hmo, simp())
  have {efr = franges} := apply(mp.mo_same[c := c, A := A, A2 := A2, M := M, b := b, brk := brk], hmo)
  have ul: app(A, "used") in list_type(omega) by simp(ha)
  have r: all x0. all x1. x0 in omega && x1 in omega -> int_lt(x0, seq_len(app(A2, "used"))) && mallocng.in_range(x1, mallocng.group_range(app(app(A2, "metas"), app(app(A2, "used"), x0)))) ->
      !mallocng.in_ranges(x1, mallocng.fixed_ranges(c, A2)) proof
    fix k x
    assume ho hq
    have hk hx := ho
    have hkl0 hr := hq
    have hkl: int_lt(k, seq_len(app(A, "used"))) := rewrite(eus, hkl0)
    have uo := apply(at_type[l := app(A, "used"), t := omega, i := k], ul, hk, hkl)
    have {gr = range} := apply(mp.mo_geom[A := A, A2 := A2, x := app(app(A, "used"), k)], hmo, uo)
    have o := mp(all_elim(expand(hap, mallocng.groups_apart), {k}, {x}), ho, taut(hkl, rewrite(gr, rewrite(eus, hr))))
    show := rewrite(sym(efr), o)
  qed
  show by defs(r, mallocng.groups_apart)
qed

// the invariant kept by a used group's masks written (`mp.mframe`): g's
// meta record, masks and big-allocation clause holding anew, g, if past
// an active list's head, still full
theorem mp.holds_masks(c, A, A2, M, M2, b, brk, g): mp.mframe(c, A, A2, M, M2, b, brk, g) ->
  mallocng.meta_in_memory(M2, g, app(app(A2, "metas"), g)) -> mallocng.masks_ok(A2, M2, g) -> mallocng.big_ok(A2, g) ->
  (all sc. all k. sc in omega && k in omega -> int_lt(sc, 48) && int_lt(k, seq_len(app(app(A, "active"), sc))) -> int_lt(0, k) ->
     app(app(app(A, "active"), sc), k) = g -> app(app(app(A2, "metas"), g), "avail") = 0 && !(app(app(app(A2, "metas"), g), "freed") = 0)) ->
  mallocng.holds(c, A2, M2, b, brk)
proof
  assume F mim2 msk2 big2 hac2
  have {ha = abs, H = holds, hmo = mo} := F
  have {hpart = part, hin = in_slots, hbrk = brk, hsep = sep, hwf = wf, hfix = fixed} := expand(H, mallocng.holds)
  have {ep = part, ein = in_slots, ebrk = brk, efx = fixed} := apply(mp.mo_same[c := c, A := A, A2 := A2, M := M, b := b, brk := brk], hmo)
  have er := apply(mp.mo_regions[c := c, A := A, A2 := A2], ha, hmo)
  have im := apply(mp.mf_image[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, g := g], F)
  have cx := apply(mp.mf_ctx[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, g := g], F)
  have fr := apply(mp.mf_fresh[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, g := g], F)
  have ar := apply(mp.mf_areas[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, g := g], F)
  have us := apply(mp.mf_used[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, g := g], F, mim2, msk2, big2)
  have ac := apply(mp.mf_active[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, g := g], F, hac2)
  have nm := apply(mp.mf_normal[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, g := g], F)
  have pm := apply(mp.mf_perms[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, g := g], F)
  have cl := apply(mp.mf_classes[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, g := g], F)
  have gp := apply(mp.mf_apart[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := brk, g := g], F)
  show by defs(taut(im, cx, fr, ar, rewrite(sym(ep), hpart), us, ac, rewrite(sym(ein), hin), nm, rewrite(sym(ebrk), hbrk), pm, rewrite(sym(er), hsep), hwf, cl,
    rewrite(sym(efx), hfix), gp), mallocng.holds)
qed

// ----------------------------------------------------------------------
//  activate_group: the footprint in user space, the views agreeing, its
//  precondition from the invariant, the masks split at the active index,
//  the new state (records updated) activated

// (masks only: the same ranges, the same footprint)
theorem mp.mo_ranges(c, A, A2): A in mallocng.Abs -> mallocng_purpose.masks_only(A, A2) -> mallocng.fp_ranges(c, A2) = mallocng.fp_ranges(c, A)
proof
  assume ha hmo
  have {efx = franges} := apply(mp.mo_same[c := c, A := A, A2 := A2, M := empty, b := empty, brk := empty], hmo)
  have eus := apply(mp.mo_field[A := A, A2 := A2, k := "used"], hmo, simp())
  have ul: app(A, "used") in list_type(omega) by simp(ha)
  have ud: int_sub(seq_len(app(A, "used")), 0) in omega by arith(ul)
  have pw: all x0. x0 in int_sub(seq_len(app(A, "used")), 0) ->
      mallocng.group_range(app(app(A2, "metas"), app(app(A, "used"), int_add(0, x0)))) = mallocng.group_range(app(app(A, "metas"), app(app(A, "used"), int_add(0, x0)))) proof
    fix x0
    assume hx
    have xo := mp(nat_elem[k := int_sub(seq_len(app(A, "used")), 0), i := x0], ud, hx)
    have xl := mp(nat_mem_lt[k := int_sub(seq_len(app(A, "used")), 0), i := x0], ud, hx)
    have uo := apply(at_type[l := app(A, "used"), t := omega, i := int_add(0, x0)], ul, simp(xo), arith(xo, xl, ul))
    have {gr = range} := apply(mp.mo_geom[A := A, A2 := A2, x := app(app(A, "used"), int_add(0, x0))], hmo, uo)
    show := gr
  qed
  have eg := mp(fn_build_ext[d := int_sub(seq_len(app(A, "used")), 0), f := x0. mallocng.group_range(app(app(A2, "metas"), app(app(A, "used"), int_add(0, x0)))),
    g := x0. mallocng.group_range(app(app(A, "metas"), app(app(A, "used"), int_add(0, x0))))], pw)
  show by defs(simp(efx, eus, eg), mallocng.fp_ranges)
qed

theorem mp.mo_fp(c, A, A2, b): A in mallocng.Abs -> mallocng_purpose.masks_only(A, A2) -> mallocng.footprint(c, A2, b) = mallocng.footprint(c, A, b)
proof
  assume ha hmo
  have efr := apply(mp.mo_ranges[c := c, A := A, A2 := A2], ha, hmo)
  have ext: all x. x in mallocng.footprint(c, A2, b) <-> x in mallocng.footprint(c, A, b) proof
    fix x
    have s2 := set_select_def[s := omega, p := y. y in mallocng.fp_set(mallocng.fp_ranges(c, A2), b) && !mallocng.in_reserved(A2, y), z := x]
    have s1 := set_select_def[s := omega, p := y. y in mallocng.fp_set(mallocng.fp_ranges(c, A), b) && !mallocng.in_reserved(A, y), z := x]
    have ir := apply(mp.mo_inres[A := A, A2 := A2, a := x], ha, hmo)
    have m2 := subst({y. (x in mallocng.fp_set(mallocng.fp_ranges(c, A2), b)) <-> (x in mallocng.fp_set(y, b))}, efr,
      ((x in mallocng.fp_set(mallocng.fp_ranges(c, A2), b)) <-> (x in mallocng.fp_set(mallocng.fp_ranges(c, A2), b)) by taut()))
    show by defs(taut(s2, s1, ir, m2), mallocng.footprint)
  qed
  show := mp(set_ext[a := mallocng.footprint(c, A2, b), b := mallocng.footprint(c, A, b)], ext)
qed

// (masks only: the same bytes the invariant reads)
theorem mp.mo_held(c, A, A2, b): A in mallocng.Abs -> mallocng_purpose.masks_only(A, A2) -> mallocng.held(c, A2, b) = mallocng.held(c, A, b)
proof
  assume ha hmo
  have efp := apply(mp.mo_fp[c := c, A := A, A2 := A2, b := b], ha, hmo)
  show by defs(simp(efp), mallocng.held)
qed

// the footprint mapped: in user space (below 2^64, no address wraps)
theorem mp.fp_low(c, A, vm, b, a): mallocng.fp_mapped(mallocng.fp_ranges(c, A), b, vm) -> a in mallocng.footprint(c, A, b) ->
  int_lt(a, 18446744073709551616)
proof
  assume hm ha
  have s1 := set_select_def[s := omega, p := y. y in mallocng.fp_set(mallocng.fp_ranges(c, A), b) && !mallocng.in_reserved(A, y), z := a]
  have ao af _ := (a in omega && a in mallocng.fp_set(mallocng.fp_ranges(c, A), b) && !mallocng.in_reserved(A, a) by taut(s1, expand(ha, mallocng.footprint)))
  have s2 := set_select_def[s := omega, p := y. mallocng.in_ranges(y, mallocng.fp_ranges(c, A)) && !(y in malloc.live_of(b)), z := a]
  have _ ir nl := (a in omega && mallocng.in_ranges(a, mallocng.fp_ranges(c, A)) && !(a in malloc.live_of(b)) by taut(s2, expand(af, mallocng.fp_set)))
  obtain k, hk hkl hr from expand(ir, mallocng.in_ranges)
  have r1 r2 := expand(hr, mallocng.in_range)
  have mp1 := mp(all_elim(expand(hm, mallocng.fp_mapped), {k}, {a}), taut(hk, ao), taut(hkl, r1, r2, nl))
  have lt _ := expand(mp1, x86_64_linux.mapped)
  have ts: int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE) = 34359738367 by defs(simp(), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
  have pg: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
  show by arith(lt, ts, pg, ao)
qed

// two memories with the same pages, a's byte (if a is seen) the same:
// their views at a
theorem mp.view_agree(vm, vm2, fp, a): a in omega -> (a in fp -> app(app(vm2, "bytes"), bits_of_int(64, a)) = app(app(vm, "bytes"), bits_of_int(64, a))) ->
  app(vm2, "pages") = app(vm, "pages") -> app(mallocng.mview(vm2, fp), a) = app(mallocng.mview(vm, fp), a)
proof
  assume hao eb ep
  have a2 := mp(app_fn_build[d := omega, v := x. ite(x in fp, some(pair(app(app(vm2, "bytes"), bits_of_int(64, x)), app(app(vm2, "pages"), int_div(x, x86_64_linux.PAGE)))), none), a := a], hao)
  have a1 := mp(app_fn_build[d := omega, v := x. ite(x in fp, some(pair(app(app(vm, "bytes"), bits_of_int(64, x)), app(app(vm, "pages"), int_div(x, x86_64_linux.PAGE)))), none), a := a], hao)
  have c1: a in fp -> app(mallocng.mview(vm2, fp), a) = app(mallocng.mview(vm, fp), a) proof
    assume h
    show by defs(simp(a2, a1, mp(eb, h), ep, h), mallocng.mview)
  qed
  have c2: !(a in fp) -> app(mallocng.mview(vm2, fp), a) = app(mallocng.mview(vm, fp), a) proof
    assume h
    show by defs(simp(a2, a1, h), mallocng.mview)
  qed
  show by taut(c1, c2)
qed

theorem mp.view_pg(vm, vm2, fp, a): a in omega -> app(vm2, "pages") = app(vm, "pages") -> mallocng.pg(mallocng.mview(vm2, fp), a) = mallocng.pg(mallocng.mview(vm, fp), a)
proof
  assume hao ep
  have a2 := mp(app_fn_build[d := omega, v := x. ite(x in fp, some(pair(app(app(vm2, "bytes"), bits_of_int(64, x)), app(app(vm2, "pages"), int_div(x, x86_64_linux.PAGE)))), none), a := a], hao)
  have a1 := mp(app_fn_build[d := omega, v := x. ite(x in fp, some(pair(app(app(vm, "bytes"), bits_of_int(64, x)), app(app(vm, "pages"), int_div(x, x86_64_linux.PAGE)))), none), a := a], hao)
  have v2: mallocng.pg(mallocng.mview(vm2, fp), a) = snd(snd(ite(a in fp, some(pair(app(app(vm2, "bytes"), bits_of_int(64, a)), app(app(vm2, "pages"), int_div(a, x86_64_linux.PAGE)))), none)))
    by defs(simp(a2), mallocng.pg, mallocng.mview)
  have v1: mallocng.pg(mallocng.mview(vm, fp), a) = snd(snd(ite(a in fp, some(pair(app(app(vm, "bytes"), bits_of_int(64, a)), app(app(vm, "pages"), int_div(a, x86_64_linux.PAGE)))), none)))
    by defs(simp(a1), mallocng.pg, mallocng.mview)
  have c1: a in fp -> mallocng.pg(mallocng.mview(vm2, fp), a) = mallocng.pg(mallocng.mview(vm, fp), a) proof
    assume h
    have w2: mallocng.pg(mallocng.mview(vm2, fp), a) = app(app(vm2, "pages"), int_div(a, x86_64_linux.PAGE)) by defs(simp(v2, h), some)
    have w1: mallocng.pg(mallocng.mview(vm, fp), a) = app(app(vm, "pages"), int_div(a, x86_64_linux.PAGE)) by defs(simp(v1, h), some)
    show by simp(w2, w1, ep)
  qed
  have c2: !(a in fp) -> mallocng.pg(mallocng.mview(vm2, fp), a) = mallocng.pg(mallocng.mview(vm, fp), a) proof
    assume h
    show by simp(v2, v1, h)
  qed
  show by taut(c1, c2)
qed

// the context's free bytes accessible: so on a memory with the same pages
theorem mp.free_rw_pages(c, vm, vm2, F): mallocng.free_rw(c, mallocng.mview(vm, F)) -> app(vm2, "pages") = app(vm, "pages") -> mallocng.free_rw(c, mallocng.mview(vm2, F))
proof
  assume hf ep
  have r: all a. a in omega -> mallocng.ctx_free(c, a) -> mallocng.m_rw(mallocng.mview(vm2, F), a) &&
      !(app(snd(mallocng.pg(mallocng.mview(vm2, F), a)), "kind") = 2) proof
    fix a
    assume hao hfa
    have h1 := mp(all_elim(expand(hf, mallocng.free_rw), {a}), hao, hfa)
    have e := apply(mp.view_pg[vm := vm, vm2 := vm2, fp := F, a := a], hao, ep)
    show by defs(rewrite(sym(e), expand(h1, mallocng.m_rw, mallocng.m_mapped)), mallocng.m_rw, mallocng.m_mapped)
  qed
  show by defs(r, mallocng.free_rw)
qed

// the footprint mapped: so on a memory with the same pages
theorem mp.fpm_pages(RS, b, vm, vm2): mallocng.fp_mapped(RS, b, vm) -> app(vm2, "pages") = app(vm, "pages") -> mallocng.fp_mapped(RS, b, vm2)
proof
  assume hm ep
  have mpw: all x0. all x1. x0 in omega && x1 in omega -> ((int_lt(x0, seq_len(RS)) && int_le(fst(app(RS, x0)), x1)) && int_lt(x1, int_add(fst(app(RS, x0)), snd(app(RS, x0))))) &&
      !(x1 in malloc.live_of(b)) -> x86_64_linux.mapped(vm2, int_div(x1, x86_64_linux.PAGE)) proof
    fix k a
    assume ho hr
    have m1 := mp(all_elim(expand(hm, mallocng.fp_mapped), {k}, {a}), ho, hr)
    have l1 l2 := expand(m1, x86_64_linux.mapped)
    show by defs(taut(l1, rewrite(sym(ep), l2)), x86_64_linux.mapped)
  qed
  show by defs(mpw, mallocng.fp_mapped)
qed

// two views of a memory agreeing at every byte: the same
theorem mp.view_ext(vm, vm2, fp): (all a. a in omega -> app(mallocng.mview(vm2, fp), a) = app(mallocng.mview(vm, fp), a)) ->
  mallocng.mview(vm2, fp) = mallocng.mview(vm, fp)
proof
  assume h
  let F2(y) := ite(y in fp, some(pair(app(app(vm2, "bytes"), bits_of_int(64, y)), app(app(vm2, "pages"), int_div(y, x86_64_linux.PAGE)))), none)
  let F1(y) := ite(y in fp, some(pair(app(app(vm, "bytes"), bits_of_int(64, y)), app(app(vm, "pages"), int_div(y, x86_64_linux.PAGE)))), none)
  have pw: all y. y in omega -> F2(y) = F1(y) proof
    fix y
    assume hy
    have a2 := mp(app_fn_build[d := omega, v := x. F2(x), a := y], hy)
    have a1 := mp(app_fn_build[d := omega, v := x. F1(x), a := y], hy)
    show := rewrite(a1, rewrite(a2, expand(mp(all_elim(h, {y}), hy), mallocng.mview)))
  qed
  have ext := mp(fn_build_ext[d := omega, f := x. F2(x), g := x. F1(x)], pw)
  show by defs(ext, mallocng.mview)
qed

// a byte of the context's free ones: the allocator's, accessible
theorem mp.free_acc(c, A, vm, b, a): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_in(c, A, vm, b) ->
  a in omega -> mallocng.ctx_free(c, a) ->
  a in mallocng.footprint(c, A, b) && mallocng.m_rw(mallocng.mview(vm, mallocng.footprint(c, A, b)), a) &&
  !(app(snd(mallocng.pg(mallocng.mview(vm, mallocng.footprint(c, A, b)), a)), "kind") = 2)
proof
  assume hc hu ha hh hao hf
  have {hfr = free} := expand(hh, mallocng.holds_in)
  have k1: mallocng.C_MMAP_CNT = 12 by defs(refl({12}), mallocng.C_MMAP_CNT)
  have k2: mallocng.C_META_SHIFT = 48 by defs(refl({48}), mallocng.C_META_SHIFT)
  have k3: mallocng.C_USAGE = 464 by defs(refl({464}), mallocng.C_USAGE)
  have k4: mallocng.C_BRK = 920 by defs(refl({920}), mallocng.C_BRK)
  have k5: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  have fr := expand(hf, mallocng.ctx_free)
  have h1: int_le(app(c, "ctx"), a) by arith(fr, k1, k2, k3, k4)
  have h2: int_lt(a, int_add(app(c, "ctx"), mallocng.CTX_SIZE)) by arith(fr, k1, k2, k3, k4, k5)
  have fp := apply(mp.ctx_fp[c := c, A := A, vm := vm, b := b, a := a], hc, hu, ha, hh, hao, h1, h2)
  have rw := mp(all_elim(expand(hfr, mallocng.free_rw), {a}), hao, hf)
  show by taut(fp, rw)
qed

// n bytes read-write in a view (each a page's, not a stack page's):
// usable, for reading and writing; a word so: accessible
theorem mp.rw_usable(vm, F, objs, a, n): a in omega ->
  (all i. i in omega -> int_lt(i, n) -> int_add(a, i) in F && mallocng.m_rw(mallocng.mview(vm, F), int_add(a, i)) &&
     !(app(snd(mallocng.pg(mallocng.mview(vm, F), int_add(a, i))), "kind") = 2)) ->
  gimple.usable(vm, objs, a, n, false) && gimple.usable(vm, objs, a, n, true)
proof
  assume hao each
  have er: all i. i in omega -> int_lt(i, n) -> int_add(a, i) in F && mallocng.m_mapped(mallocng.mview(vm, F), int_add(a, i)) &&
      app(app(snd(mallocng.pg(mallocng.mview(vm, F), int_add(a, i))), "prot"), "r") && !(app(snd(mallocng.pg(mallocng.mview(vm, F), int_add(a, i))), "kind") = 2) proof
    fix i
    assume hi hl
    have e1 e2 e3 := mp(all_elim(each, {i}), hi, hl)
    show by taut(e1, expand(e2, mallocng.m_rw), e3)
  qed
  have ew: all i. i in omega -> int_lt(i, n) -> int_add(a, i) in F && mallocng.m_mapped(mallocng.mview(vm, F), int_add(a, i)) &&
      app(app(snd(mallocng.pg(mallocng.mview(vm, F), int_add(a, i))), "prot"), "w") && !(app(snd(mallocng.pg(mallocng.mview(vm, F), int_add(a, i))), "kind") = 2) proof
    fix i
    assume hi hl
    have e1 e2 e3 := mp(all_elim(each, {i}), hi, hl)
    show by taut(e1, expand(e2, mallocng.m_rw), e3)
  qed
  show by taut(apply(mp.view_usable[vm := vm, fp := F, objs := objs, a := a, n := n], hao, er), apply(mp.view_usable_w[vm := vm, fp := F, objs := objs, a := a, n := n], hao, ew))
qed

theorem mp.word_rw(vm, F, objs, p, off): p in omega -> off in omega -> !(p = 0) -> int_le(int_add(int_add(p, off), 8), 18446744073709551616) ->
  (all i. i in omega -> int_lt(i, 8) -> int_add(int_add(p, off), i) in F && mallocng.m_rw(mallocng.mview(vm, F), int_add(int_add(p, off), i)) &&
     !(app(snd(mallocng.pg(mallocng.mview(vm, F), int_add(int_add(p, off), i))), "kind") = 2)) ->
  mallocng_specs.word_ok(vm, objs, p, off)
proof
  assume hp ho hnz hb hr
  have u1 u2 := apply(mp.rw_usable[vm := vm, F := F, objs := objs, a := int_add(p, off), n := 8], arith(hp, ho), hr)
  have b2: int_le(int_add(int_add(p, off), 8), int_pow(2, 64)) by simp(hb)
  show by defs(taut(hnz, b2, u1, u2), mallocng_specs.word_ok)
qed

// n bytes from a, all the context's free ones: usable, for reading and
// writing
theorem mp.free_usable(c, A, vm, b, objs, a, n): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_in(c, A, vm, b) ->
  a in omega -> (all i. i in omega -> int_lt(i, n) -> mallocng.ctx_free(c, int_add(a, i))) ->
  gimple.usable(vm, objs, a, n, false) && gimple.usable(vm, objs, a, n, true)
proof
  assume hc hu ha hh hao hf
  let F := mallocng.footprint(c, A, b)
  have each: all i. i in omega -> int_lt(i, n) -> int_add(a, i) in F && mallocng.m_rw(mallocng.mview(vm, F), int_add(a, i)) &&
      !(app(snd(mallocng.pg(mallocng.mview(vm, F), int_add(a, i))), "kind") = 2) proof
    fix i
    assume hi hl
    show := apply(mp.free_acc[c := c, A := A, vm := vm, b := b, a := int_add(a, i)], hc, hu, ha, hh, arith(hao, hi), mp(all_elim(hf, {i}), hi, hl))
  qed
  show := apply(mp.rw_usable[vm := vm, F := F, objs := objs, a := a, n := n], hao, each)
qed

// the context's free bytes changed, nothing else: the invariant kept (the
// invariant's view the same, the pages the same)
theorem mp.co_holds(c, A, vm, vm2, b): mallocng.holds_in(c, A, vm, b) -> mallocng_purpose.ctx_only(c, vm, vm2) -> mallocng.holds_in(c, A, vm2, b)
proof
  assume hh hco
  have {H = inv, hm = mapped, hfr = free} := expand(hh, mallocng.holds_in)
  have er eb := expand(hco, mallocng_purpose.ctx_only)
  have up := mp(app_update_other[f := vm2, k := "bytes", v := app(vm, "bytes"), x := "pages"], (!("pages" = "bytes") by simp()))
  have ep: app(vm2, "pages") = app(vm, "pages") := sym(rewrite(er, up))
  have uk := mp(app_update_other[f := vm2, k := "bytes", v := app(vm, "bytes"), x := "brk"], (!("brk" = "bytes") by simp()))
  have ek: app(vm2, "brk") = app(vm, "brk") := sym(rewrite(er, uk))
  // the invariant's view: its bytes not free, so the same
  let FP := mallocng.held(c, A, b)
  have ag: all a. a in omega -> app(mallocng.mview(vm2, FP), a) = app(mallocng.mview(vm, FP), a) proof
    fix a
    assume hao
    have bt: a in FP -> app(app(vm2, "bytes"), bits_of_int(64, a)) = app(app(vm, "bytes"), bits_of_int(64, a)) proof
      assume hf
      have {hff = fp, nfr = free} := apply(mp.held_fp, hf)
      have lo := apply(mp.fp_low[c := c, A := A, vm := vm, b := b, a := a], hm, hff)
      have e: bits_of_int(64, a) = a by defs(arith(hao, lo), bits_of_int, pow2)
      have ab: a in bits(64) by arith(hao, lo)
      show := rewrite(sym(e), mp(all_elim(eb, {a}), ab, nfr))
    qed
    show := apply(mp.view_agree[vm := vm, vm2 := vm2, fp := FP, a := a], hao, bt, ep)
  qed
  have ve := apply(mp.view_ext[vm := vm, vm2 := vm2, fp := FP], ag)
  have i2 := rewrite(sym(ek), rewrite(sym(ve), H))
  have m2 := apply(mp.fpm_pages, hm, ep)
  have fr2 := apply(mp.free_rw_pages[c := c, vm := vm, vm2 := vm2, F := mallocng.footprint(c, A, b)], hfr, ep)
  show by defs(taut(i2, m2, fr2), mallocng.holds_in)
qed

// (nothing changed; k bytes stored at a, all free; one change, then another)
theorem mp.co_refl(c, vm): vm in x86_64_linux.Vm -> mallocng_purpose.ctx_only(c, vm, vm)
proof
  assume hv
  have e := mp(fn_update_same[f := vm, k := "bytes"], simp(hv), simp(hv))
  have b: all x. x in bits(64) -> !mallocng.ctx_free(c, x) -> app(app(vm, "bytes"), x) = app(app(vm, "bytes"), x) proof
    fix x
    assume _ _
    show := refl({app(app(vm, "bytes"), x)})
  qed
  show by defs(taut(e, b), mallocng_purpose.ctx_only)
qed

theorem mp.co_store(c, vm, a, k, v): vm in x86_64_linux.Vm -> a in bits(64) -> k in omega -> int_le(int_add(a, k), 18446744073709551616) ->
  (all i. i in omega -> int_lt(i, k) -> mallocng.ctx_free(c, int_add(a, i))) ->
  mallocng_purpose.ctx_only(c, vm, fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, k, v)))
proof
  assume hv ha hk hak hf
  let V2 := fn_update(vm, "bytes", x86_64_linux.store_le(app(vm, "bytes"), a, k, v))
  have e0 := mp(fn_update_same[f := vm, k := "bytes"], simp(hv), simp(hv))
  have e: fn_update(V2, "bytes", app(vm, "bytes")) = vm := trans(fn_update_twice[f := vm, k := "bytes", a := x86_64_linux.store_le(app(vm, "bytes"), a, k, v), b := app(vm, "bytes")], e0)
  have b: all x. x in bits(64) -> !mallocng.ctx_free(c, x) -> app(app(V2, "bytes"), x) = app(app(vm, "bytes"), x) proof
    fix x
    assume hx hn
    // (x outside the store: else x = a + i, free)
    have o: int_le(int_add(a, k), x) || int_lt(x, a) proof
      have inr: int_le(a, x) && int_lt(x, int_add(a, k)) -> false proof
        assume hi
        have i0: int_sub(x, a) in omega by arith(hi, ha, hx)
        have il: int_lt(int_sub(x, a), k) by arith(hi)
        have fx := mp(all_elim(hf, {int_sub(x, a)}), i0, il)
        have ex: int_add(a, int_sub(x, a)) = x by arith(hx, ha)
        show by taut(rewrite(ex, fx), hn)
      qed
      show by arith(inr)
    qed
    have so := apply(mp.st_out[B := app(vm, "bytes"), c := a, k := k, v := v, x := x], hx, ha, hk, hak, o)
    show by simp(so, app_update_same[f := vm, k := "bytes", v := x86_64_linux.store_le(app(vm, "bytes"), a, k, v)])
  qed
  show by defs(taut(e, b), mallocng_purpose.ctx_only)
qed

theorem mp.co_trans(c, v1, v2, v3): mallocng_purpose.ctx_only(c, v1, v2) -> mallocng_purpose.ctx_only(c, v2, v3) -> mallocng_purpose.ctx_only(c, v1, v3)
proof
  assume h1 h2
  have r1 b1 := expand(h1, mallocng_purpose.ctx_only)
  have r2 b2 := expand(h2, mallocng_purpose.ctx_only)
  // (v3 with v2's bytes is v2; with v1's bytes then v1)
  have t := fn_update_twice[f := v3, k := "bytes", a := app(v2, "bytes"), b := app(v1, "bytes")]
  have r: fn_update(v3, "bytes", app(v1, "bytes")) = v1 := trans(sym(rewrite(r2, t)), r1)
  have b: all x. x in bits(64) -> !mallocng.ctx_free(c, x) -> app(app(v3, "bytes"), x) = app(app(v1, "bytes"), x) proof
    fix x
    assume hx hn
    show := trans(mp(all_elim(b2, {x}), hx, hn), mp(all_elim(b1, {x}), hx, hn))
  qed
  show by defs(taut(r, b), mallocng_purpose.ctx_only)
qed

// ----------------------------------------------------------------------
//  The lists in memory, by the invariant

// a meta slot: 8-aligned, its 40 bytes the invariant's and accessible,
// below 2^64; outside the context
theorem mp.slot_meta(c, A, vm, b, g): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> mallocng.holds_in(c, A, vm, b) -> mallocng.meta_slot(A, g) ->
  nat: g in omega && low: int_le(24, g) && al: int_mod(g, 8) = 0 && bound: int_le(int_add(g, 40), 18446744073709551616) &&
  acc: (all a. a in omega -> int_le(g, a) -> int_lt(a, int_add(g, 40)) ->
     a in mallocng.held(c, A, b) && mallocng.m_rw(mallocng.mview(vm, mallocng.held(c, A, b)), a) &&
     !(app(snd(mallocng.pg(mallocng.mview(vm, mallocng.held(c, A, b)), a)), "kind") = 2)) &&
  out: (int_le(int_add(app(c, "ctx"), mallocng.CTX_SIZE), g) || int_le(int_add(g, 40), app(c, "ctx")))
proof
  assume hc hu ha hh ms
  have {H = inv, hm = mapped} := expand(hh, mallocng.holds_in)
  have {aok = areas} := expand(H, mallocng.holds)
  have {each = each} := expand(aok, mallocng.areas_ok)
  have go g24 inr := apply(mp.slot_mem, hc, hu, ha, hh, ms)
  // (its last byte the allocator's: below 2^64)
  have l39 _ _ := mp(all_elim(inr, {int_add(g, 39)}), arith(go), arith(go), arith(go))
  have {f39 = fp} := apply(mp.held_fp, l39)
  have lo := apply(mp.fp_low[c := c, A := A, vm := vm, b := b, a := int_add(g, 39)], hm, f39)
  have gb: int_le(int_add(g, 40), 18446744073709551616) by arith(lo)
  obtain k j, hk hj hkl hjl he from expand(ms, mallocng.meta_slot)
  have rl: app(A, "areas") in list_type(omega) by simp(ha)
  have aro := mp(at_type[l := app(A, "areas"), t := omega, i := k], rl, hk, hkl)
  have cs: mallocng.AREA_HDR = 24 && mallocng.META_SIZE = 40 && mallocng.NSLOTS = 101 by defs(simp(), mallocng.AREA_HDR, mallocng.META_SIZE, mallocng.NSLOTS)
  have ge: g = int_add(int_add(app(app(A, "areas"), k), 24), int_mul(40, j)) by simp(expand(he, mallocng.meta_at), cs)
  have jl: int_lt(j, 101) by simp(hjl, cs)
  have am .. := mp(all_elim(each, {k}), hk, hkl)
  have al: int_mod(g, 8) = 0 by arith(ge, am, aro, hj)
  // (the meta's first and last bytes in the area, so not the context's)
  have d0 _ _ := mp.data_at[c := c]
  have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  have {n1 = data} := apply(mp.area_apart[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, brk := app(vm, "brk"), k := k, a := g],
    hc, hu, ha, H, hk, hkl, go, arith(ge, aro, hj), arith(ge, aro, hj, jl))
  have {n2 = data} := apply(mp.area_apart[c := c, A := A, M := mallocng.mview(vm, mallocng.held(c, A, b)), b := b, brk := app(vm, "brk"), k := k, a := int_add(g, 39)],
    hc, hu, ha, H, hk, hkl, arith(go), arith(ge, aro, hj), arith(ge, aro, hj, jl))
  have o1: !(int_le(app(c, "ctx"), g) && int_lt(g, int_add(app(c, "ctx"), mallocng.CTX_SIZE))) by simp(expand(rewrite(d0, mp(all_elim(n1, {0}), simp(), simp())), mallocng.in_range))
  have o2: !(int_le(app(c, "ctx"), int_add(g, 39)) && int_lt(int_add(g, 39), int_add(app(c, "ctx"), mallocng.CTX_SIZE)))
    by simp(expand(rewrite(d0, mp(all_elim(n2, {0}), simp(), simp())), mallocng.in_range))
  have co: app(c, "ctx") in omega by simp(hc)
  have out: int_le(int_add(app(c, "ctx"), mallocng.CTX_SIZE), g) || int_le(int_add(g, 40), app(c, "ctx")) by arith(o1, o2, ks, go, co)
  show by taut(go, g24, al, gb, inr, out)
qed

// a list at a word of the context the invariant reads (`off`), cyclic on
// the invariant's view, of meta slots: as the list functions need it
// (`list_at`)
theorem mp.ctx_list(c, A, vm, b, objs, off, L): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> app(vm, "bytes") in fn_space(bits(64), bits(8)) ->
  mallocng.holds_in(c, A, vm, b) -> int_mod(app(c, "ctx"), 8) = 0 -> off in omega -> int_mod(off, 8) = 0 ->
  ((int_le(16, off) && int_le(int_add(off, 8), 48)) || (int_le(56, off) && int_le(int_add(off, 8), 464))) ->
  L in list_type(omega) -> (all i. i in omega -> int_lt(i, seq_len(L)) -> mallocng.meta_slot(A, app(L, i))) ->
  mallocng.cyclic(mallocng.mview(vm, mallocng.held(c, A, b)), mallocng.ctx_word(c, mallocng.mview(vm, mallocng.held(c, A, b)), off), L) ->
  mallocng_purpose.list_at(vm, objs, int_add(app(c, "ctx"), off), L)
proof
  assume hc hu ha hvb hh hal hoo hoa hor ll hsl hcy
  let F := mallocng.held(c, A, b)
  let M := mallocng.mview(vm, F)
  let PH := int_add(app(c, "ctx"), off)
  have {H = inv, hm = mapped} := expand(hh, mallocng.holds_in)
  have ks: mallocng.CTX_SIZE = 928 by defs(refl({928}), mallocng.CTX_SIZE)
  have p64: int_pow(2, 64) = 18446744073709551616 by simp()
  have co: app(c, "ctx") in omega by simp(hc)
  // (the context below 2^64: its last byte the allocator's)
  have cf := apply(mp.ctx_fp[c := c, A := A, vm := vm, b := b, a := int_add(app(c, "ctx"), 927)], hc, hu, ha, hh, arith(co), arith(co), arith(co, ks))
  have clo := apply(mp.fp_low[c := c, A := A, vm := vm, b := b, a := int_add(app(c, "ctx"), 927)], hm, cf)
  have pho: PH in omega by arith(co, hoo)
  have phb: PH in bits(64) by arith(co, hoo, hor, clo)
  // the head word: the context's, not a free one -- accessible
  have hw: all i. i in omega -> int_lt(i, 8) -> int_add(int_add(PH, 0), i) in F && mallocng.m_rw(M, int_add(int_add(PH, 0), i)) &&
      !(app(snd(mallocng.pg(M, int_add(int_add(PH, 0), i))), "kind") = 2) proof
    fix i
    assume hi hil
    have nf: !mallocng.ctx_free(c, int_add(int_add(PH, 0), i))
      by defs(arith(hor, hoo, hi, hil, co), mallocng.ctx_free, mallocng.C_MMAP_CNT, mallocng.C_META_SHIFT, mallocng.C_USAGE, mallocng.C_BRK)
    show := apply(mp.ctx_acc[c := c, A := A, vm := vm, b := b, a := int_add(int_add(PH, 0), i)], hc, hu, ha, hh, arith(pho, hi), arith(co, hoo, hi), arith(co, ks, hor, hoo, hi, hil), nf)
  qed
  have wh := apply(mp.word_rw[vm := vm, F := F, objs := objs, p := PH, off := 0], pho, simp(), arith(co, hor), arith(co, hor, hoo, clo), hw)
  have hal8: mallocng_specs.al8(PH) by defs(arith(hal, hoa, hoo, co), mallocng_specs.al8)
  have f1 f2 f3 := expand(hcy, mallocng.cyclic)
  // the head word read
  have hin: all i. i in omega -> int_lt(i, 8) -> int_add(PH, i) in F proof
    fix i
    assume hi hil
    have q _ _ := mp(all_elim(hw, {i}), hi, hil)
    show by simp(q)
  qed
  have rh := apply(mp.view_read[vm := vm, fp := F, a := PH, n := 8], pho, simp(), simp(), hin)
  have hd: gimple.bytes_at(vm, PH, 8) = ite(seq_len(L) = 0, 0, app(L, 0)) := trans(rh, expand(f1, mallocng.ctx_word))
  // its elements: metas, outside the context
  have elV: all x0. x0 in omega -> int_lt(x0, seq_len(L)) -> ((((int_le(int_add(app(L, x0), 16), int_pow(2, 64)) && mallocng_specs.word_ok(vm, objs, bits_of_int(64, app(L, x0)), 0)) &&
      mallocng_specs.word_ok(vm, objs, bits_of_int(64, app(L, x0)), 8)) && int_mod(app(L, x0), 8) = 0) && (int_le(int_add(PH, 8), app(L, x0)) || int_le(int_add(app(L, x0), 16), PH))) proof
    fix i
    assume hi hil
    let g := app(L, i)
    have {go = nat, glo = low, gal = al, gb = bound, inr = acc, gout = out} := apply(mp.slot_meta[c := c, A := A, vm := vm, b := b, g := g], hc, hu, ha, hh, mp(all_elim(hsl, {i}), hi, hil))
    have eb: bits_of_int(64, g) = g by defs(arith(go, gb), bits_of_int, pow2)
    have w0: all j. j in omega -> int_lt(j, 8) -> int_add(int_add(g, 0), j) in F && mallocng.m_rw(M, int_add(int_add(g, 0), j)) &&
        !(app(snd(mallocng.pg(M, int_add(int_add(g, 0), j))), "kind") = 2) proof
      fix j
      assume hj hjl
      show := mp(all_elim(inr, {int_add(int_add(g, 0), j)}), arith(go, hj), arith(go, hj), arith(go, hj, hjl))
    qed
    have w8: all j. j in omega -> int_lt(j, 8) -> int_add(int_add(g, 8), j) in F && mallocng.m_rw(M, int_add(int_add(g, 8), j)) &&
        !(app(snd(mallocng.pg(M, int_add(int_add(g, 8), j))), "kind") = 2) proof
      fix j
      assume hj hjl
      show := mp(all_elim(inr, {int_add(int_add(g, 8), j)}), arith(go, hj), arith(go, hj), arith(go, hj, hjl))
    qed
    have nz: !(g = 0) by arith(glo, go)
    have k0 := apply(mp.word_rw[vm := vm, F := F, objs := objs, p := g, off := 0], go, simp(), nz, arith(gb), w0)
    have k8 := apply(mp.word_rw[vm := vm, F := F, objs := objs, p := g, off := 8], go, simp(), nz, arith(gb), w8)
    have k0b := subst({y. mallocng_specs.word_ok(vm, objs, y, 0)}, sym(eb), k0)
    have k8b := subst({y. mallocng_specs.word_ok(vm, objs, y, 8)}, sym(eb), k8)
    have g16: int_le(int_add(g, 16), int_pow(2, 64)) by arith(gb, p64)
    have off: int_le(int_add(PH, 8), g) || int_le(int_add(g, 16), PH) by arith(gout, ks, hor, hoo, co)
    show by taut(g16, k0b, k8b, gal, off)
  qed
  // apart: distinct metas
  have apV: all x0. all x1. x0 in omega && x1 in omega -> (int_lt(x0, seq_len(L)) && int_lt(x1, seq_len(L))) && !(x0 = x1) ->
      int_le(int_add(app(L, x0), 16), app(L, x1)) || int_le(int_add(app(L, x1), 16), app(L, x0)) proof
    fix i j
    assume ho hr
    have hi hj := ho
    have hil hjl hne := hr
    have ne: !(app(L, i) = app(L, j)) proof
      assume e
      have q := mp(all_elim(f2, {i}, {j}), conj(hi, hj), conj(conj(hil, hjl), e))
      show by taut(q, hne)
    qed
    have isl := mp(all_elim(hsl, {i}), hi, hil)
    have jsl := mp(all_elim(hsl, {j}), hj, hjl)
    have {io = nat} := apply(mp.slot_meta[c := c, A := A, vm := vm, b := b, g := app(L, i)], hc, hu, ha, hh, isl)
    have {jo = nat} := apply(mp.slot_meta[c := c, A := A, vm := vm, b := b, g := app(L, j)], hc, hu, ha, hh, jsl)
    have d1 := apply(mp.meta_disj[c := c, A := A, M := M, b := b, brk := app(vm, "brk"), g := app(L, i), l := app(L, j), a := app(L, j)],
      hc, hu, ha, H, isl, jsl, (!(app(L, j) = app(L, i)) by taut(ne)), jo, arith(jo), arith(jo))
    have d2 := apply(mp.meta_disj[c := c, A := A, M := M, b := b, brk := app(vm, "brk"), g := app(L, j), l := app(L, i), a := app(L, i)],
      hc, hu, ha, H, jsl, isl, ne, io, arith(io), arith(io))
    show by arith(d1, d2, io, jo)
  qed
  // its links read
  have lk: all i. i in omega -> int_lt(i, seq_len(L)) ->
      gimple.bytes_at(vm, int_add(app(L, i), 8), 8) = app(L, int_mod(int_add(i, 1), seq_len(L))) &&
      gimple.bytes_at(vm, app(L, i), 8) = app(L, int_mod(int_sub(int_add(i, seq_len(L)), 1), seq_len(L))) proof
    fix i
    assume hi hil
    let g := app(L, i)
    have {go = nat, inr = acc} := apply(mp.slot_meta[c := c, A := A, vm := vm, b := b, g := g], hc, hu, ha, hh, mp(all_elim(hsl, {i}), hi, hil))
    have in8: all j. j in omega -> int_lt(j, 8) -> int_add(int_add(g, 8), j) in F proof
      fix j
      assume hj hjl
      have q _ _ := mp(all_elim(inr, {int_add(int_add(g, 8), j)}), arith(go, hj), arith(go, hj), arith(go, hj, hjl))
      show := q
    qed
    have in0: all j. j in omega -> int_lt(j, 8) -> int_add(g, j) in F proof
      fix j
      assume hj hjl
      have q _ _ := mp(all_elim(inr, {int_add(g, j)}), arith(go, hj), arith(go, hj), arith(go, hj, hjl))
      show := q
    qed
    have r8 := apply(mp.view_read[vm := vm, fp := F, a := int_add(g, 8), n := 8], arith(go), simp(), simp(), in8)
    have r0 := apply(mp.view_read[vm := vm, fp := F, a := g, n := 8], go, simp(), simp(), in0)
    have l8 l0 := mp(all_elim(f3, {i}), hi, hil)
    show by taut(trans(r8, l8), trans(r0, l0))
  qed
  show := apply(mp.list_mk[vm := vm, objs := objs, phead := PH, l := L], hvb, phb, ll, wh, hal8, elV, apV, hd, lk)
qed

// class sc's active list, at its word in the context
theorem mp.active_at(c, A, vm, b, objs, sc): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> app(vm, "bytes") in fn_space(bits(64), bits(8)) ->
  mallocng.holds_in(c, A, vm, b) -> int_mod(app(c, "ctx"), 8) = 0 -> sc in omega -> int_lt(sc, 48) ->
  mallocng_purpose.list_at(vm, objs, int_add(int_add(app(c, "ctx"), mallocng.C_ACTIVE), int_mul(8, sc)), app(app(A, "active"), sc))
proof
  assume hc hu ha hvb hh hal hs hsl
  let L := app(app(A, "active"), sc)
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {cok = ctx, act = active} := expand(H, mallocng.holds)
  have ka: mallocng.C_ACTIVE = 80 by defs(refl({80}), mallocng.C_ACTIVE)
  have _ _ _ _ _ _ _ _ _ _ la cy := expand(cok, mallocng.ctx_ok)
  have al0: app(A, "active") in list_type(list_type(omega)) by simp(ha)
  have ll := mp(at_type[l := app(A, "active"), t := list_type(omega), i := sc], al0, hs, (int_lt(sc, seq_len(app(A, "active"))) by arith(la, hsl)))
  have sl: all i. i in omega -> int_lt(i, seq_len(L)) -> mallocng.meta_slot(A, app(L, i)) proof
    fix i
    assume hi hil
    have gu .. := mp(all_elim(expand(act, mallocng.active_ok), {sc}, {i}), conj(hs, hi), conj(hsl, hil))
    show := apply(mp.used_slot, H, gu)
  qed
  have r := apply(mp.ctx_list[c := c, A := A, vm := vm, b := b, objs := objs, off := int_add(mallocng.C_ACTIVE, int_mul(8, sc)), L := L],
    hc, hu, ha, hvb, hh, hal, arith(ka, hs), arith(ka, hs), arith(ka, hs, hsl), ll, sl, mp(all_elim(cy, {sc}), hs, hsl))
  have ea: int_add(app(c, "ctx"), int_add(mallocng.C_ACTIVE, int_mul(8, sc))) = int_add(int_add(app(c, "ctx"), mallocng.C_ACTIVE), int_mul(8, sc)) by arith()
  show := rewrite(ea, r)
qed

// the free metas' list, at its word in the context
theorem mp.free_metas_at(c, A, vm, b, objs): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> app(vm, "bytes") in fn_space(bits(64), bits(8)) ->
  mallocng.holds_in(c, A, vm, b) -> int_mod(app(c, "ctx"), 8) = 0 ->
  mallocng_purpose.list_at(vm, objs, int_add(app(c, "ctx"), mallocng.C_FREE_META), app(A, "free_metas"))
proof
  assume hc hu ha hvb hh hal
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {cok = ctx, mpart = part} := expand(H, mallocng.holds)
  have {fs = free_slots} := expand(mpart, mallocng.metas_partition)
  have kf: mallocng.C_FREE_META = 16 by defs(refl({16}), mallocng.C_FREE_META)
  have _ _ _ _ _ _ _ _ _ cf .. := expand(cok, mallocng.ctx_ok)
  have ll: app(A, "free_metas") in list_type(omega) by simp(ha)
  have sl: all i. i in omega -> int_lt(i, seq_len(app(A, "free_metas"))) -> mallocng.meta_slot(A, app(app(A, "free_metas"), i)) proof
    fix i
    assume hi hil
    have q _ := mp(all_elim(fs, {i}), hi, hil)
    show := q
  qed
  show := apply(mp.ctx_list[c := c, A := A, vm := vm, b := b, objs := objs, off := mallocng.C_FREE_META, L := app(A, "free_metas")],
    hc, hu, ha, hvb, hh, hal, arith(kf), arith(kf), arith(kf), ll, sl, cf)
qed

// ----------------------------------------------------------------------
//  activate_group: what its code reads, by the invariant

// a group in use, none of its slots available: activate_group's
// precondition holds; the freed mask it reads g's, its active-slot mask
// from the group header's active index
theorem mp.ag_pre(c, A, vm, b, objs, fs, g): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> b in fn_space(bits(64), option(omega)) ->
  app(vm, "bytes") in fn_space(bits(64), bits(8)) -> g in bits(64) -> mallocng.holds_in(c, A, vm, b) -> mallocng.no_reserved(A) -> abi.thread_ok(vm, fs) ->
  mallocng.is_used(A, g) -> app(app(app(A, "metas"), g), "avail") = 0 ->
  pre: mallocng_specs.activate_group_pre(vm, objs, fs, g) &&
  freed: mallocng_specs.ag_freed(vm, g) = app(app(app(A, "metas"), g), "freed") &&
  act: mallocng_specs.ag_act(vm, g) = bits_of_int(32, int_sub(int_mul(2, int_pow(2, mallocng_purpose.active_idx(vm, app(app(A, "metas"), g)))), 1)) &&
  idx: mallocng_purpose.active_idx(vm, app(app(A, "metas"), g)) = int_mod(mallocng.b8(mallocng.mview(vm, mallocng.held(c, A, b)), int_add(app(app(app(A, "metas"), g), "mem"), 8)), 32) &&
  inat: mallocng_purpose.active_idx(vm, app(app(A, "metas"), g)) in omega && ilt: int_lt(mallocng_purpose.active_idx(vm, app(app(A, "metas"), g)), 32)
proof
  assume hc hu ha hb hvb hgb hh hnr hth hg hav
  let V := app(app(A, "metas"), g)
  let FP := mallocng.held(c, A, b)
  let M := mallocng.mview(vm, FP)
  have go g24 inr := apply(mp.meta_mem, hc, hu, ha, hh, hg)
  have top mw := apply(mp.meta_word, hc, hu, ha, hh, hg)
  have {H = inv} := expand(hh, mallocng.holds_in)
  have {huo = used, hp = perms} := expand(H, mallocng.holds)
  have gok := apply(mp.used_group, huo, hg)
  have {mim, hdr, hown = hdr_own} := expand(gok, mallocng.group_ok)
  have {mmem = mem, mav = avail, mfr = freed} := expand(mim, mallocng.meta_in_memory)
  have hdrg hdr16 hdrp := hdr
  have vt: V in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := app(A, "metas"), x := g], simp(ha), go)
  have vmem: app(V, "mem") in omega by simp(vt)
  have vlast: app(V, "last_idx") in omega by simp(vt)
  have sn := apply(mp.stride_nat, ha, go, gok)
  // the meta's bytes: the allocator's, accessible
  have mb: all o. all n. o in omega -> n in omega -> int_le(int_add(o, n), 40) ->
      (all i. i in omega -> int_lt(i, n) -> int_add(int_add(g, o), i) in FP && mallocng.m_mapped(M, int_add(int_add(g, o), i)) &&
         app(app(snd(mallocng.pg(M, int_add(int_add(g, o), i))), "prot"), "r") && app(app(snd(mallocng.pg(M, int_add(int_add(g, o), i))), "prot"), "w") &&
         !(app(snd(mallocng.pg(M, int_add(int_add(g, o), i))), "kind") = 2)) proof
    fix o n
    assume ho hn hl
    fix i
    assume hi hil
    have r1 r2 r3 := mp(all_elim(inr, {int_add(int_add(g, o), i)}), simp(go, ho, hi), arith(go, ho, hi), arith(go, ho, hi, hil, hl))
    show by taut(r1, expand(r2, mallocng.m_rw), r3)
  qed
  have m16b := mp(all_elim(mb, {16}, {16}), simp(), simp(), simp())
  have m16: all i. i in omega -> int_lt(i, 16) -> int_add(int_add(g, 16), i) in FP && mallocng.m_mapped(M, int_add(int_add(g, 16), i)) &&
      app(app(snd(mallocng.pg(M, int_add(int_add(g, 16), i))), "prot"), "r") && !(app(snd(mallocng.pg(M, int_add(int_add(g, 16), i))), "kind") = 2) proof
    fix i
    assume hi hil
    have q1 q2 q3 q4 q5 := mp(all_elim(m16b, {i}), hi, hil)
    show by taut(q1, q2, q3, q5)
  qed
  have m24b := mp(all_elim(mb, {24}, {8}), simp(), simp(), simp())
  have m24: all i. i in omega -> int_lt(i, 8) -> int_add(int_add(g, 24), i) in FP && mallocng.m_mapped(M, int_add(int_add(g, 24), i)) &&
      app(app(snd(mallocng.pg(M, int_add(int_add(g, 24), i))), "prot"), "w") && !(app(snd(mallocng.pg(M, int_add(int_add(g, 24), i))), "kind") = 2) proof
    fix i
    assume hi hil
    have q1 q2 q3 q4 q5 := mp(all_elim(m24b, {i}), hi, hil)
    show by taut(q1, q2, q4, q5)
  qed
  have ur16 := apply(mp.view_usable[vm := vm, fp := FP, objs := objs, a := int_add(g, 16), n := 16], simp(go), m16)
  have uw24 := apply(mp.view_usable_w[vm := vm, fp := FP, objs := objs, a := int_add(g, 24), n := 8], simp(go), m24)
  have b16: bits_add(64, g, 16) = int_add(g, 16) by defs(arith(go, top), bits_add, pow2)
  have b24: bits_add(64, g, 24) = int_add(g, 24) by defs(arith(go, top), bits_add, pow2)
  have b28: bits_add(64, g, 28) = int_add(g, 28) by defs(arith(go, top), bits_add, pow2)
  have infp: all o. all n. o in omega -> n in omega -> int_le(int_add(o, n), 40) -> (all i. i in omega -> int_lt(i, n) -> int_add(int_add(g, o), i) in FP) proof
    fix o n
    assume ho hn hl
    fix i
    assume hi hil
    have r := mp(all_elim(mb, {o}, {n}), ho, hn, hl)
    have q .. := mp(all_elim(r, {i}), hi, hil)
    show := q
  qed
  have v24 := apply(mp.view_read[vm := vm, fp := FP, a := int_add(g, 24), n := 4], simp(go), simp(), simp(), mp(all_elim(infp, {24}, {4}), simp(), simp(), simp()))
  have v28 := apply(mp.view_read[vm := vm, fp := FP, a := int_add(g, 28), n := 4], simp(go), simp(), simp(), mp(all_elim(infp, {28}, {4}), simp(), simp(), simp()))
  have v16 := apply(mp.view_read[vm := vm, fp := FP, a := int_add(g, 16), n := 8], simp(go), simp(), simp(), mp(all_elim(infp, {16}, {8}), simp(), simp(), simp()))
  have z24: gimple.bytes_at(vm, bits_add(64, g, 24), 4) = 0 by simp(b24, v24, mav, hav)
  // the group's header: its word g, its active index's byte -- the allocator's, accessible
  have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
  have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
  have sel: mallocng.slot_end(V, app(V, "last_idx")) = int_sub(int_add(int_add(int_add(app(V, "mem"), 16), int_mul(mallocng.stride(V), app(V, "last_idx"))), mallocng.stride(V)), 4)
    by defs(arith(cu, ci), mallocng.slot_end, mallocng.slot_start, mallocng.storage)
  have ml: int_mul(mallocng.stride(V), app(V, "last_idx")) in omega by simp(sn, vlast)
  let H8 := int_add(app(V, "mem"), 8)
  have h8o: H8 in omega by simp(vmem)
  have grh := apply(mp.group_bytes[A := A, M := M, b := b, h := g, a := H8], ha, go, gok, h8o, arith(vmem), arith(sel, ml, vmem, sn))
  obtain kg, hkg hkgr from expand(hg, mallocng.is_used)
  have hkgl hkge := hkgr
  have nl := mp(all_elim(hown, {H8}), h8o, (int_le(app(V, "mem"), H8) && int_lt(H8, int_add(app(V, "mem"), mallocng.UNIT)) by arith(vmem, cu)))
  have nr := apply(mp.nores[A := A, a := H8], hnr)
  have gr2 := subst({y. mallocng.in_range(H8, mallocng.group_range(app(app(A, "metas"), y)))}, sym(hkge), grh)
  have h8fp0 := apply(mp.group_fp[c := c, A := A, b := b, k := kg, a := H8], hc, hu, ha, hkg, hkgl, h8o, gr2, nl, nr)
  have h8fp := apply(mp.group_held[c := c, A := A, M := M, b := b, brk := app(vm, "brk"), h := g, a := H8], hc, hu, ha, H, hg, h8o, grh, h8fp0)
  have p1 p2 p3 := expand(hp, mallocng.perms_ok)
  have gr2a gr2b := expand(gr2, mallocng.in_range)
  have rw8 nk8 := mp(all_elim(p2, {kg}, {H8}), conj(hkg, h8o), taut(hkgl, gr2a, gr2b, nl, nr))
  have rwm rwr rww := expand(rw8, mallocng.m_rw)
  have mm2 := expand(rwm, mallocng.m_mapped, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
  have tl: int_lt(int_div(H8, 4096), int_div(int_sub(int_pow(2, 47), 4096), 4096)) by taut(mm2)
  have mtop: int_le(int_add(app(V, "mem"), 9), int_pow(2, 64)) by arith(tl, vmem)
  have one0: all i. i in omega -> int_lt(i, 1) -> i = 0 proof
    fix i
    assume hi hl
    show by arith(hi, hl)
  qed
  have us8 := apply(mp.view_usable[vm := vm, fp := FP, objs := objs, a := H8, n := 1], h8o,
    (all i. i in omega -> int_lt(i, 1) -> int_add(H8, i) in FP && mallocng.m_mapped(M, int_add(H8, i)) &&
       app(app(snd(mallocng.pg(M, int_add(H8, i))), "prot"), "r") && !(app(snd(mallocng.pg(M, int_add(H8, i))), "kind") = 2) by
     simp(h8fp, rwm, rwr, nk8, one0)))
  // the words GIMPLE reads
  have mlt: int_lt(app(V, "mem"), 18446744073709551616) by arith(mtop)
  have e16: mallocng_specs.rd64(vm, bits_add(64, g, 16)) = app(V, "mem") by defs(simp(b16, v16, mmem, vmem, mlt), mallocng_specs.rd64, bits_of_int, pow2)
  have fo fl := mp(all_elim(g.bytes_bound, {vm}, {int_add(g, 28)}, {4}), hvb, simp())
  have eF: mallocng_specs.ag_freed(vm, g) = app(V, "freed") by defs(simp(b28, sym(trans(v28, mfr)), fo, fl), mallocng_specs.ag_freed, bits_of_int, pow2)
  have b8m: bits_add(64, app(V, "mem"), 8) = H8 by defs(arith(vmem, mtop), bits_add, pow2)
  have v8 := apply(mp.view_read[vm := vm, fp := FP, a := H8, n := 1], h8o, simp(), simp(), (all i. i in omega -> int_lt(i, 1) -> int_add(H8, i) in FP by simp(h8fp, one0)))
  have bv bvo := apply(mp.b8_view[vm := vm, fp := FP, a := H8], hvb, h8o, h8fp)
  have r81: mallocng.rd(M, H8, 1) = mallocng.b8(M, H8) by defs(simp(bvo), mallocng.rd)
  have ab: H8 in mallocng.all_bytes by defs(simp(h8o), mallocng.all_bytes)
  have bva bvao := apply(mp.b8_view[vm := vm, fp := mallocng.all_bytes, a := H8], hvb, h8o, ab)
  have eidx: mallocng_purpose.active_idx(vm, V) = int_mod(mallocng.b8(M, H8), 32) by defs(simp(bva, bv), mallocng_purpose.active_idx)
  have eA: mallocng_specs.ag_act(vm, g) = bits_of_int(32, int_sub(int_mul(2, int_pow(2, mallocng_purpose.active_idx(vm, V))), 1))
    by defs(simp(e16, b8m, v8, r81, eidx), mallocng_specs.ag_act)
  have pre: mallocng_specs.activate_group_pre(vm, objs, fs, g)
    by defs(taut((!(g = 0) by arith(g24, go)), (int_le(int_add(g, 32), int_pow(2, 64)) by arith(top, go)), ur16, uw24, z24,
      rewrite(sym(e16), (!(app(V, "mem") = 0) by arith(hdrp, vmem))), rewrite(sym(e16), mtop), rewrite(sym(e16), us8), hth), mallocng_specs.activate_group_pre)
  have inat: mallocng_purpose.active_idx(vm, V) in omega by arith(eidx, bvo)
  have ilt: int_lt(mallocng_purpose.active_idx(vm, V), 32) by arith(eidx, bvo)
  show by taut(pre, eF, eA, eidx, inat, ilt)
qed

// the layer's bit (a number) by the core's (a proposition)
theorem mp.nbit(x, i): x in omega -> i in omega -> mallocng.bit(x, i) = ite(bit(x, i), 1, 0)
proof
  assume hx hi
  have pp := mp(pow2_pos[k := i], hi)
  have d _ := apply(div_nat[x := x, m := pow2(i)], hx, pp)
  have e0: mallocng.bit(x, i) = int_mod(int_div(x, pow2(i)), 2) by defs(refl({int_mod(int_div(x, pow2(i)), 2)}), mallocng.bit, pow2)
  have c1: bit(x, i) -> mallocng.bit(x, i) = ite(bit(x, i), 1, 0) proof
    assume hb
    have e := expand(hb, bit)
    have it: ite(bit(x, i), 1, 0) = 1 by simp(hb)
    show by arith(e0, e, it)
  qed
  have c2: !bit(x, i) -> mallocng.bit(x, i) = ite(bit(x, i), 1, 0) proof
    assume hb
    have n1 := expand(hb, bit)
    have it: ite(bit(x, i), 1, 0) = 0 by simp(hb)
    show by arith(e0, n1, d, it)
  qed
  show by taut(c1, c2)
qed

// activate_group's masks: F's bits up to k (avail), the rest (freed)
theorem mp.ag_bits(F, k, i): F in omega -> k in omega -> i in omega -> int_lt(i, 32) ->
  av: mallocng.bit(bits_and(32, F, bits_of_int(32, int_sub(int_mul(2, int_pow(2, k)), 1))), i) = ite(int_le(i, k), mallocng.bit(F, i), 0) &&
  fr: mallocng.bit(bits_and(32, F, bits_not(32, bits_of_int(32, int_sub(int_mul(2, int_pow(2, k)), 1)))), i) = ite(int_le(i, k), 0, mallocng.bit(F, i))
proof
  assume hf hk hi hi32
  let ACT := bits_of_int(32, int_sub(int_mul(2, int_pow(2, k)), 1))
  have k1: int_add(k, 1) in omega by arith(hk)
  have p1 := mp(all_elim(pow2_add, {k}), hk, {1}, simp())
  have e2: int_mul(2, int_pow(2, k)) = pow2(int_add(k, 1)) by defs(arith(expand(p1, pow2)), pow2)
  have pk := mp(pow2_pos[k := int_add(k, 1)], k1)
  have mo: int_sub(pow2(int_add(k, 1)), 1) in omega by arith(pk)
  have ba: bit(ACT, i) <-> int_le(i, k) proof
    have b1 := apply(bit_of_int[n := 32, x := int_sub(int_mul(2, int_pow(2, k)), 1), i := i], simp(), rewrite(sym(e2), mo), hi)
    have b2 := apply(bit_mask[k := int_add(k, 1), i := i], k1, hi)
    have b3 := subst({y. bit(ACT, i) <-> int_lt(i, 32) && bit(int_sub(y, 1), i)}, e2, b1)
    show by taut(b3, b2, hi32, (int_lt(i, int_add(k, 1)) <-> int_le(i, k) by arith(hi, hk)))
  qed
  have av1 := apply(bit_and[n := 32, x := F, y := ACT, i := i], simp(), hi, hi32)
  have fr1 := apply(bit_and[n := 32, x := F, y := bits_not(32, ACT), i := i], simp(), hi, hi32)
  have nt := apply(bit_not[n := 32, x := ACT, i := i], simp(), hi, hi32)
  have ao := apply(bits_and_in[n := 32, x := F, y := ACT], simp())
  have fo := apply(bits_and_in[n := 32, x := F, y := bits_not(32, ACT)], simp())
  have nav := apply(mp.nbit[x := bits_and(32, F, ACT), i := i], (bits_and(32, F, ACT) in omega by defs(simp(ao), bits)), hi)
  have nfr := apply(mp.nbit[x := bits_and(32, F, bits_not(32, ACT)), i := i], (bits_and(32, F, bits_not(32, ACT)) in omega by defs(simp(fo), bits)), hi)
  have nf := apply(mp.nbit[x := F, i := i], hf, hi)
  have c1: int_le(i, k) -> av: mallocng.bit(bits_and(32, F, ACT), i) = ite(int_le(i, k), mallocng.bit(F, i), 0) &&
      fr: mallocng.bit(bits_and(32, F, bits_not(32, ACT)), i) = ite(int_le(i, k), 0, mallocng.bit(F, i)) proof
    assume h
    have x1: bit(bits_and(32, F, ACT), i) <-> bit(F, i) by taut(av1, ba, h)
    have x2: !bit(bits_and(32, F, bits_not(32, ACT)), i) by taut(fr1, nt, ba, h)
    have y1: mallocng.bit(bits_and(32, F, ACT), i) = mallocng.bit(F, i) by simp(nav, nf, x1)
    have y2: mallocng.bit(bits_and(32, F, bits_not(32, ACT)), i) = 0 by simp(nfr, x2)
    show by simp(y1, y2, h)
  qed
  have c2: !int_le(i, k) -> av: mallocng.bit(bits_and(32, F, ACT), i) = ite(int_le(i, k), mallocng.bit(F, i), 0) &&
      fr: mallocng.bit(bits_and(32, F, bits_not(32, ACT)), i) = ite(int_le(i, k), 0, mallocng.bit(F, i)) proof
    assume h
    have x1: !bit(bits_and(32, F, ACT), i) by taut(av1, ba, h)
    have x2: bit(bits_and(32, F, bits_not(32, ACT)), i) <-> bit(F, i) by taut(fr1, nt, ba, h)
    have y1: mallocng.bit(bits_and(32, F, ACT), i) = 0 by simp(nav, x1)
    have y2: mallocng.bit(bits_and(32, F, bits_not(32, ACT)), i) = mallocng.bit(F, i) by simp(nfr, nf, x2)
    show by simp(y1, y2, h)
  qed
  show by taut(c1, c2)
qed

// a number below 2^32 with no bit set: 0
theorem mp.nbits_zero(y): y in omega -> int_lt(y, int_pow(2, 32)) -> (all i. i in omega -> int_lt(i, 32) -> mallocng.bit(y, i) = 0) -> y = 0
proof
  assume hy hl hb
  have nb: all i. i in omega -> int_lt(i, 32) -> !bit(y, i) proof
    fix i
    assume hi hil
    have e := apply(mp.nbit[x := y, i := i], hy, hi)
    have z := mp(all_elim(hb, {i}), hi, hil)
    have c: bit(y, i) -> false proof
      assume h
      have one: ite(bit(y, i), 1, 0) = 1 by simp(h)
      show by arith(e, z, one)
    qed
    show by taut(c)
  qed
  show := mp(all_elim(bits_zero, {32}), simp(), {y}, hy, (int_lt(y, pow2(32)) by defs(hl, pow2)), nb)
qed

// activation keeps g's masks sound: its freed slots up to the active
// index (in M, as in M2) now available, the rest still freed; a big
// allocation's (nothing freed) still empty
theorem mp.act_masks(A, A2, M, M2, g, idx): A in mallocng.Abs -> A2 in mallocng.Abs -> g in omega ->
  mallocng.masks_ok(A, M, g) -> mallocng.big_ok(A, g) -> app(app(app(A, "metas"), g), "avail") = 0 -> mallocng_purpose.activated(A, A2, g, idx) ->
  idx = int_mod(mallocng.b8(M, int_add(app(app(app(A, "metas"), g), "mem"), 8)), 32) ->
  mallocng.b8(M2, int_add(app(app(app(A, "metas"), g), "mem"), 8)) = mallocng.b8(M, int_add(app(app(app(A, "metas"), g), "mem"), 8)) ->
  (all i. i in omega -> int_le(i, app(app(app(A, "metas"), g), "last_idx")) ->
     mallocng.b8(M2, int_sub(mallocng.slot_start(app(app(A, "metas"), g), i), 4)) = mallocng.b8(M, int_sub(mallocng.slot_start(app(app(A, "metas"), g), i), 4))) ->
  masks: mallocng.masks_ok(A2, M2, g) && big: mallocng.big_ok(A2, g)
proof
  assume ha ha2 hg mk bg av0 hact eidx ebx es
  let V := app(app(A, "metas"), g)
  let V2 := app(app(A2, "metas"), g)
  have hmo _ avl frl hb := expand(hact, mallocng_purpose.activated)
  have {em = mem, el = last, ess = slots, esc = sclass, emap = maplen} := apply(mp.mo_geom[A := A, A2 := A2, x := g], hmo, hg)
  have esl := apply(mp.mo_field[A := A, A2 := A2, k := "slots"], hmo, simp())
  have vt: V in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := app(A, "metas"), x := g], simp(ha), hg)
  have vt2: V2 in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := app(A2, "metas"), x := g], simp(ha2), hg)
  have vfr: app(V, "freed") in omega by simp(vt)
  have v2av: app(V2, "avail") in omega by simp(vt2)
  have v2fr: app(V2, "freed") in omega by simp(vt2)
  have vlast: app(V, "last_idx") in omega by simp(vt)
  have x2: int_mod(mallocng.b8(M2, int_add(app(V2, "mem"), 8)), 32) = idx by simp(em, ebx, eidx)
  have mko := expand(mk, mallocng.masks_ok)
  // bit i, before and after
  have bi: all i. i in omega -> int_lt(i, 32) ->
      av: mallocng.bit(app(V2, "avail"), i) = ite(int_le(i, idx), mallocng.bit(app(V, "freed"), i), 0) &&
      fr: mallocng.bit(app(V2, "freed"), i) = ite(int_le(i, idx), 0, mallocng.bit(app(V, "freed"), i)) &&
      old: mallocng.bit(app(V, "avail"), i) = 0 && f01: (mallocng.bit(app(V, "freed"), i) = 0 || mallocng.bit(app(V, "freed"), i) = 1) &&
      fo: mallocng.bit(app(V, "freed"), i) in omega && ao2: mallocng.bit(app(V2, "avail"), i) in omega && fo2: mallocng.bit(app(V2, "freed"), i) in omega proof
    fix i
    assume hi hil
    have a f := mp(all_elim(hb, {i}), hi, hil)
    have z0 := apply(mp.nbit[x := 0, i := i], simp(), hi)
    have nz := apply(bit_zero[i := i], hi)
    have o: mallocng.bit(app(V, "avail"), i) = 0 by simp(av0, z0, nz)
    have nf := apply(mp.nbit[x := app(V, "freed"), i := i], vfr, hi)
    have c1: bit(app(V, "freed"), i) -> mallocng.bit(app(V, "freed"), i) = 1 proof
      assume h
      show by simp(nf, h)
    qed
    have c2: !bit(app(V, "freed"), i) -> mallocng.bit(app(V, "freed"), i) = 0 proof
      assume h
      show by simp(nf, h)
    qed
    have fo: mallocng.bit(app(V, "freed"), i) in omega by simp(nf)
    have ao2: mallocng.bit(app(V2, "avail"), i) in omega by simp(apply(mp.nbit[x := app(V2, "avail"), i := i], v2av, hi))
    have fo2: mallocng.bit(app(V2, "freed"), i) in omega by simp(apply(mp.nbit[x := app(V2, "freed"), i := i], v2fr, hi))
    show by taut(a, f, o, c1, c2, fo, ao2, fo2)
  qed
  have r: all x0. x0 in omega -> int_lt(x0, 32) -> (((mallocng.bit(app(V2, "avail"), x0) = 1 -> int_le(x0, int_mod(mallocng.b8(M2, int_add(app(V2, "mem"), 8)), 32)) && mallocng.bit(app(V2, "freed"), x0) = 0) &&
      (int_lt(0, int_add(mallocng.bit(app(V2, "avail"), x0), mallocng.bit(app(V2, "freed"), x0))) -> int_le(x0, app(V2, "last_idx")))) &&
      (int_le(x0, app(V2, "last_idx")) -> (app(app(app(A2, "slots"), g), x0) = tag(0, empty) <-> int_lt(0, int_add(mallocng.bit(app(V2, "avail"), x0), mallocng.bit(app(V2, "freed"), x0)))) &&
        mallocng.b8(M2, int_sub(mallocng.slot_start(V2, x0), 4)) = 0)) &&
      (int_lt(int_mod(mallocng.b8(M2, int_add(app(V2, "mem"), 8)), 32), x0) && int_le(x0, app(V2, "last_idx")) -> mallocng.bit(app(V2, "freed"), x0) = 1) proof
    fix i
    assume hi hil
    have o1 o2 o3 o4 := mp(all_elim(mko, {i}), hi, hil)
    have {ba = av, bf = fr, bo = old, b01 = f01, bfo = fo, bao2 = ao2, bfo2 = fo2} := mp(all_elim(bi, {i}), hi, hil)
    let FI := mallocng.bit(app(V, "freed"), i)
    // the new bits: FI split at idx
    have lo: int_le(i, idx) -> mallocng.bit(app(V2, "avail"), i) = FI && mallocng.bit(app(V2, "freed"), i) = 0 proof
      assume h
      show by simp(ba, bf, h)
    qed
    have hi2: !int_le(i, idx) -> mallocng.bit(app(V2, "avail"), i) = 0 && mallocng.bit(app(V2, "freed"), i) = FI proof
      assume h
      show by simp(ba, bf, h)
    qed
    have sum: int_add(mallocng.bit(app(V2, "avail"), i), mallocng.bit(app(V2, "freed"), i)) = int_add(mallocng.bit(app(V, "avail"), i), FI) by arith(lo, hi2, bo, bfo, bao2, bfo2)
    have p1: mallocng.bit(app(V2, "avail"), i) = 1 -> int_le(i, int_mod(mallocng.b8(M2, int_add(app(V2, "mem"), 8)), 32)) && mallocng.bit(app(V2, "freed"), i) = 0 proof
      assume h
      have c: int_le(i, idx) by arith(h, hi2, bfo, bao2, bfo2)
      show by arith(c, lo, x2, bfo, bao2, bfo2)
    qed
    have p2: int_lt(0, int_add(mallocng.bit(app(V2, "avail"), i), mallocng.bit(app(V2, "freed"), i))) -> int_le(i, app(V2, "last_idx")) proof
      assume h
      show by arith(o2, h, sum, el, bfo, bao2, bfo2)
    qed
    have p3: int_le(i, app(V2, "last_idx")) -> (app(app(app(A2, "slots"), g), i) = tag(0, empty) <-> int_lt(0, int_add(mallocng.bit(app(V2, "avail"), i), mallocng.bit(app(V2, "freed"), i)))) &&
        mallocng.b8(M2, int_sub(mallocng.slot_start(V2, i), 4)) = 0 proof
      assume h
      have hl: int_le(i, app(V, "last_idx")) by arith(h, el)
      have q1 q2 := mp(o3, hl)
      have {ss = start} := all_elim(ess, {i})
      have sb := mp(all_elim(es, {i}), hi, hl)
      have e1: (app(app(app(A2, "slots"), g), i) = tag(0, empty)) <-> (app(app(app(A, "slots"), g), i) = tag(0, empty)) by simp(esl)
      have e2: int_lt(0, int_add(mallocng.bit(app(V2, "avail"), i), mallocng.bit(app(V2, "freed"), i))) <-> int_lt(0, int_add(mallocng.bit(app(V, "avail"), i), FI)) by arith(sum)
      have z: mallocng.b8(M2, int_sub(mallocng.slot_start(V2, i), 4)) = 0 by simp(ss, sb, q2)
      show by taut(e1, e2, q1, z)
    qed
    have p4: int_lt(int_mod(mallocng.b8(M2, int_add(app(V2, "mem"), 8)), 32), i) && int_le(i, app(V2, "last_idx")) -> mallocng.bit(app(V2, "freed"), i) = 1 proof
      assume h
      have h1 h2 := h
      have c: !int_le(i, idx) by arith(h1, x2)
      have q := mp(o4, taut((int_lt(int_mod(mallocng.b8(M, int_add(app(V, "mem"), 8)), 32), i) by arith(h1, x2, eidx)), (int_le(i, app(V, "last_idx")) by arith(h2, el))))
      show by arith(q, hi2, c, bfo, bao2, bfo2)
    qed
    show by taut(p1, p2, p3, p4)
  qed
  have m2: mallocng.masks_ok(A2, M2, g) by defs(r, mallocng.masks_ok)
  // big: nothing freed before, nothing after
  have b2: app(V2, "sizeclass") = 63 -> app(V2, "last_idx") = 0 && int_lt(0, app(V2, "maplen")) && app(V2, "avail") = 0 && app(V2, "freed") = 0 proof
    assume h
    have b1 b2 b3 b4 := mp(expand(bg, mallocng.big_ok), (app(V, "sizeclass") = 63 by arith(h, esc)))
    have zb: all i. i in omega -> int_lt(i, 32) -> mallocng.bit(app(V2, "avail"), i) = 0 && mallocng.bit(app(V2, "freed"), i) = 0 proof
      fix i
      assume hi hil
      have {ba = av, bf = fr} := mp(all_elim(bi, {i}), hi, hil)
      have nf := apply(mp.nbit[x := app(V, "freed"), i := i], vfr, hi)
      have f0: mallocng.bit(app(V, "freed"), i) = 0 by simp(nf, b4, apply(bit_zero[i := i], hi))
      show by simp(ba, bf, f0)
    qed
    have za: all i. i in omega -> int_lt(i, 32) -> mallocng.bit(app(V2, "avail"), i) = 0 proof
      fix i
      assume hi hil
      have x _ := mp(all_elim(zb, {i}), hi, hil)
      show := x
    qed
    have zf: all i. i in omega -> int_lt(i, 32) -> mallocng.bit(app(V2, "freed"), i) = 0 proof
      fix i
      assume hi hil
      have _ x := mp(all_elim(zb, {i}), hi, hil)
      show := x
    qed
    have a0 := apply(mp.nbits_zero[y := app(V2, "avail")], v2av, avl, za)
    have f0 := apply(mp.nbits_zero[y := app(V2, "freed")], v2fr, frl, zf)
    show by taut((app(V2, "last_idx") = 0 by arith(b1, el)), (int_lt(0, app(V2, "maplen")) by arith(b2, emap)), a0, f0)
  qed
  have bg2: mallocng.big_ok(A2, g) by defs(b2, mallocng.big_ok)
  show by taut(m2, bg2)
qed

// (a relation's pairs updated at a key of K by a value of B: still pairs
// of K and B)
theorem mp.pow_upd(K, B, r, k, v): r in powerset(cart(K, B)) -> k in K -> v in B -> fn_update(r, k, v) in powerset(cart(K, B))
proof
  assume hr hk hv
  have rs: subset(r, cart(K, B)) by taut(powerset_def[s := cart(K, B), a := r], hr)
  have sub: all z. z in fn_update(r, k, v) -> z in cart(K, B) proof
    fix z
    assume hz
    have c := fn_update_iff[f := r, k := k, v := v, z := z]
    have c1: z in r -> z in cart(K, B) proof
      assume h1
      show := mp(subset_elim[a := r, b := cart(K, B), z := z], rs, h1)
    qed
    have c2: z = pair(k, v) -> z in cart(K, B) proof
      assume h2
      show := rewrite(sym(h2), mp(cart_intro[a := K, b := B, x := k, y := v], hk, hv))
    qed
    show by taut(c, hz, c1, c2)
  qed
  show by taut(powerset_def[s := cart(K, B), a := fn_update(r, k, v)], (subset(fn_update(r, k, v), cart(K, B)) by defs(sub, subset)))
qed

// a function updated within its spaces: in them
theorem mp.space_upd(a, b, f, k, v): f in fn_space(a, b) -> k in a -> v in b -> fn_update(f, k, v) in fn_space(a, b)
proof
  assume hf hk hv
  have fp ff fd := (f in powerset(cart(a, b)) && is_fun(f) && dom(f) = a by simp(expand(hf, fn_space)))
  have p2 := apply(mp.pow_upd[K := a, B := b, r := f, k := k, v := v], fp, hk, hv)
  have f2 d2 := mp(fn_update_fd[f := f, k := k, v := v, d := a], ff, fd, hk)
  show by defs(simp(p2, f2, d2), fn_space)
qed

// a meta's masks set (numbers): a meta
theorem mp.meta_upd(V, av, fr): V in mallocng.MetaV -> av in omega -> fr in omega ->
  fn_update(fn_update(V, "avail", av), "freed", fr) in mallocng.MetaV
proof
  assume hv ha hf
  let K := insert("prev", insert("next", insert("mem", insert("avail", insert("freed", insert("last_idx", insert("freeable", insert("sizeclass", insert("maplen", empty)))))))))
  have vp vf vd := (V in powerset(cart(K, univ(1))) && is_fun(V) && dom(V) = K by simp(expand(hv, mallocng.MetaV)))
  let V1 := fn_update(V, "avail", av)
  have p1 := apply(mp.pow_upd[K := K, B := univ(1), r := V, k := "avail", v := av], vp, simp(), simp(ha))
  have f1 d1 := mp(fn_update_fd[f := V, k := "avail", v := av, d := K], vf, vd, simp())
  have p2 := apply(mp.pow_upd[K := K, B := univ(1), r := V1, k := "freed", v := fr], p1, simp(), simp(hf))
  have f2 d2 := mp(fn_update_fd[f := V1, k := "freed", v := fr, d := K], f1, d1, simp())
  have vu := mp(rec_univ[u := 1, k := K, r := V], simp(x86.insert_univ), vp, vf, vd)
  show by defs(simp(p2, f2, d2, ha, hf, vu, expand(hv, mallocng.MetaV)), mallocng.MetaV)
qed

// (the metas: a member)
theorem mp.metav_univ: mallocng.MetaV in univ(1)
proof
  let K := insert("prev", insert("next", insert("mem", insert("avail", insert("freed", insert("last_idx", insert("freeable", insert("sizeclass", insert("maplen", empty)))))))))
  have fl: all r. r in mallocng.MetaV -> is_fun(r) && (all y. y in K -> app(r, y) in omega) proof
    fix r
    assume hr
    have rv := expand(hr, mallocng.MetaV)
    have f: is_fun(r) by simp(rv)
    have ys: all y. y in K -> app(r, y) in omega proof
      fix y
      assume hy
      show by simp(hy, rv)
    qed
    show by taut(f, ys)
  qed
  show by defs(apply(rec_type_univ[u := 1, k := K, b := omega], simp(x86.insert_univ), omega_univ, expand(fl, mallocng.MetaV)), mallocng.MetaV)
qed

// an abstract state with one meta replaced: an abstract state (a member)
theorem mp.abs_upd(A, g, W): A in mallocng.Abs -> g in omega -> W in mallocng.MetaV ->
  abs: fn_update(A, "metas", fn_update(app(A, "metas"), g, W)) in mallocng.Abs && univ: fn_update(A, "metas", fn_update(app(A, "metas"), g, W)) in univ(1)
proof
  assume ha hg hw
  let K := insert("secret", insert("init_done", insert("auxv_at", insert("auxv", insert("areas", insert("avail_cnt", insert("reserve", insert("reserve_cnt", insert("free_metas", insert("used", insert("metas", insert("active", insert("slots", insert("brk", empty))))))))))))))
  let X := fn_update(app(A, "metas"), g, W)
  have ap af ad := (A in powerset(cart(K, univ(1))) && is_fun(A) && dom(A) = K by simp(expand(ha, mallocng.Abs)))
  have ms: app(A, "metas") in fn_space(omega, mallocng.MetaV) by simp(ha)
  have xs := apply(mp.space_upd[a := omega, b := mallocng.MetaV, f := app(A, "metas"), k := g, v := W], ms, hg, hw)
  have xu := mp(fn_space_univ[u := 1, a := omega, b := mallocng.MetaV, f := X], omega_univ, mp.metav_univ, xs)
  have p2 := apply(mp.pow_upd[K := K, B := univ(1), r := A, k := "metas", v := X], ap, simp(), xu)
  have f2 d2 := mp(fn_update_fd[f := A, k := "metas", v := X, d := K], af, ad, simp())
  have au := mp(rec_univ[u := 1, k := K, r := A], simp(x86.insert_univ), ap, af, ad)
  have a2: fn_update(A, "metas", X) in mallocng.Abs by defs(simp(p2, f2, d2, xs, au, xu, expand(ha, mallocng.Abs)), mallocng.Abs)
  have u2 := mp(rec_univ[u := 1, k := K, r := fn_update(A, "metas", X)], simp(x86.insert_univ), p2, f2, d2)
  show by taut(a2, u2)
qed

// activate_group's new state: g's freed slots up to idx made available
// (the code's masks: freed & act, freed & ~act, act the low idx + 1 bits)
abbrev mp.act_mask(idx) := bits_of_int(32, int_sub(int_mul(2, int_pow(2, idx)), 1))
abbrev mp.act_meta(V, idx) := fn_update(fn_update(V, "avail", bits_and(32, app(V, "freed"), mp.act_mask(idx))), "freed", bits_and(32, app(V, "freed"), bits_not(32, mp.act_mask(idx))))
abbrev mp.act_abs(A, g, idx) := fn_update(A, "metas", fn_update(app(A, "metas"), g, mp.act_meta(app(app(A, "metas"), g), idx)))

// (the masks cleared: the same, whatever the masks were)
theorem mp.clear_masks(V, a, f): fn_update(fn_update(fn_update(fn_update(V, "avail", a), "freed", f), "avail", 0), "freed", 0) = fn_update(fn_update(V, "avail", 0), "freed", 0)
proof
  let V1 := fn_update(V, "avail", a)
  have sw := mp(fn_update_swap[f := V1, k := "freed", a := f, j := "avail", b := 0], simp())
  have tw := fn_update_twice[f := V, k := "avail", a := a, b := 0]
  have e1: fn_update(fn_update(V1, "freed", f), "avail", 0) = fn_update(fn_update(V, "avail", 0), "freed", f) :=
    trans(sw, subst({y. fn_update(fn_update(V1, "avail", 0), "freed", f) = fn_update(y, "freed", f)}, tw, refl({fn_update(fn_update(V1, "avail", 0), "freed", f)})))
  have e2 := subst({y. fn_update(fn_update(fn_update(V1, "freed", f), "avail", 0), "freed", 0) = fn_update(y, "freed", 0)}, e1,
    refl({fn_update(fn_update(fn_update(V1, "freed", f), "avail", 0), "freed", 0)}))
  show := trans(e2, fn_update_twice[f := fn_update(V, "avail", 0), k := "freed", a := f, b := 0])
qed

theorem mp.act_state(A, g, idx): A in mallocng.Abs -> g in omega -> idx in omega ->
  abs: mp.act_abs(A, g, idx) in mallocng.Abs && univ: mp.act_abs(A, g, idx) in univ(1) && act: mallocng_purpose.activated(A, mp.act_abs(A, g, idx), g, idx) &&
  at: app(app(mp.act_abs(A, g, idx), "metas"), g) = mp.act_meta(app(app(A, "metas"), g), idx)
proof
  assume ha hg hi
  let V := app(app(A, "metas"), g)
  let F := app(V, "freed")
  let ACT := mp.act_mask(idx)
  let AV := bits_and(32, F, ACT)
  let FR := bits_and(32, F, bits_not(32, ACT))
  let W := mp.act_meta(V, idx)
  let A2 := mp.act_abs(A, g, idx)
  have vt: V in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := app(A, "metas"), x := g], simp(ha), hg)
  have fo: F in omega by simp(vt)
  have avb := apply(bits_and_in[n := 32, x := F, y := ACT], simp())
  have frb := apply(bits_and_in[n := 32, x := F, y := bits_not(32, ACT)], simp())
  have avo: AV in omega && int_lt(AV, int_pow(2, 32)) by defs(simp(avb), bits, pow2)
  have fro: FR in omega && int_lt(FR, int_pow(2, 32)) by defs(simp(frb), bits, pow2)
  have wt := apply(mp.meta_upd[V := V, av := AV, fr := FR], vt, taut(avo), taut(fro))
  have {a2 = abs, u2 = univ} := apply(mp.abs_upd[A := A, g := g, W := W], ha, hg, wt)
  // A2's metas: W at g, the others A's
  have em: app(A2, "metas") = fn_update(app(A, "metas"), g, W) := app_update_same[f := A, k := "metas", v := fn_update(app(A, "metas"), g, W)]
  have eg: app(app(A2, "metas"), g) = W := trans(subst({y. app(app(A2, "metas"), g) = app(y, g)}, em, refl({app(app(A2, "metas"), g)})), app_update_same[f := app(A, "metas"), k := g, v := W])
  have eo: all x0. x0 in omega -> !(x0 = g) -> app(app(A2, "metas"), x0) = app(app(A, "metas"), x0) proof
    fix x
    assume hx hne
    show := trans(subst({y. app(app(A2, "metas"), x) = app(y, x)}, em, refl({app(app(A2, "metas"), x)})), mp(app_update_other[f := app(A, "metas"), k := g, v := W, x := x], hne))
  qed
  have wav: app(W, "avail") = AV by simp()
  have wfr: app(W, "freed") = FR by simp()
  // masks only (the rest of A kept)
  have af ad := (is_fun(A) && "metas" in dom(A) by simp(expand(ha, mallocng.Abs)))
  have ot: fn_update(A2, "metas", app(A, "metas")) = A :=
    trans(fn_update_twice[f := A, k := "metas", a := fn_update(app(A, "metas"), g, W), b := app(A, "metas")], mp(fn_update_same[f := A, k := "metas"], af, ad))
  have gr: all x0. x0 in omega -> fn_update(fn_update(app(app(A2, "metas"), x0), "avail", 0), "freed", 0) = fn_update(fn_update(app(app(A, "metas"), x0), "avail", 0), "freed", 0) proof
    fix x
    assume hx
    have c1: x = g -> fn_update(fn_update(app(app(A2, "metas"), x), "avail", 0), "freed", 0) = fn_update(fn_update(app(app(A, "metas"), x), "avail", 0), "freed", 0) proof
      assume e
      have cm := mp.clear_masks[V := V, a := AV, f := FR]
      have k1 := subst({y. fn_update(fn_update(app(app(A2, "metas"), g), "avail", 0), "freed", 0) = fn_update(fn_update(y, "avail", 0), "freed", 0)}, eg,
        refl({fn_update(fn_update(app(app(A2, "metas"), g), "avail", 0), "freed", 0)}))
      have k2 := trans(k1, cm)
      show := subst({y. fn_update(fn_update(app(app(A2, "metas"), y), "avail", 0), "freed", 0) = fn_update(fn_update(app(app(A, "metas"), y), "avail", 0), "freed", 0)}, sym(e), k2)
    qed
    have c2: !(x = g) -> fn_update(fn_update(app(app(A2, "metas"), x), "avail", 0), "freed", 0) = fn_update(fn_update(app(app(A, "metas"), x), "avail", 0), "freed", 0) proof
      assume ne
      have e := mp(all_elim(eo, {x}), hx, ne)
      show := subst({y. fn_update(fn_update(app(app(A2, "metas"), x), "avail", 0), "freed", 0) = fn_update(fn_update(y, "avail", 0), "freed", 0)}, e,
        refl({fn_update(fn_update(app(app(A2, "metas"), x), "avail", 0), "freed", 0)}))
    qed
    show by taut(c1, c2)
  qed
  have mo: mallocng_purpose.masks_only(A, A2) by defs(taut(ot, gr), mallocng_purpose.masks_only)
  // the bits
  have bt: all x0. x0 in omega -> int_lt(x0, 32) ->
      mallocng.bit(app(app(app(A2, "metas"), g), "avail"), x0) = ite(int_le(x0, idx), mallocng.bit(F, x0), 0) &&
      mallocng.bit(app(app(app(A2, "metas"), g), "freed"), x0) = ite(int_le(x0, idx), 0, mallocng.bit(F, x0)) proof
    fix i
    assume h1 h2
    have {b1 = av, b2 = fr} := apply(mp.ag_bits[F := F, k := idx, i := i], fo, hi, h1, h2)
    have ea: app(app(app(A2, "metas"), g), "avail") = AV := trans(subst({y. app(app(app(A2, "metas"), g), "avail") = app(y, "avail")}, eg, refl({app(app(app(A2, "metas"), g), "avail")})), wav)
    have ef: app(app(app(A2, "metas"), g), "freed") = FR := trans(subst({y. app(app(app(A2, "metas"), g), "freed") = app(y, "freed")}, eg, refl({app(app(app(A2, "metas"), g), "freed")})), wfr)
    show := conj(rewrite(sym(ea), b1), rewrite(sym(ef), b2))
  qed
  have lt1: int_lt(app(app(app(A2, "metas"), g), "avail"), int_pow(2, 32)) by simp(eg, wav, avo)
  have lt2: int_lt(app(app(app(A2, "metas"), g), "freed"), int_pow(2, 32)) by simp(eg, wfr, fro)
  have act: mallocng_purpose.activated(A, A2, g, idx) by defs(taut(mo, eo, lt1, lt2, bt), mallocng_purpose.activated)
  show by taut(a2, u2, act, eg)
qed

// a meta's record in a view agreeing but at its masks, the new masks
// there: in memory
theorem mp.mim_masks(M, M2, g, V, V2): g in omega -> mallocng.meta_in_memory(M, g, V) ->
  (all j. j in omega -> int_lt(j, 40) -> !(int_le(24, j) && int_lt(j, 32)) -> app(M2, int_add(g, j)) = app(M, int_add(g, j))) ->
  mallocng.rd(M2, int_add(g, 24), 4) = app(V2, "avail") -> mallocng.rd(M2, int_add(g, 28), 4) = app(V2, "freed") ->
  app(V2, "prev") = app(V, "prev") -> app(V2, "next") = app(V, "next") -> app(V2, "mem") = app(V, "mem") -> app(V2, "last_idx") = app(V, "last_idx") ->
  app(V2, "freeable") = app(V, "freeable") -> app(V2, "sizeclass") = app(V, "sizeclass") -> app(V2, "maplen") = app(V, "maplen") ->
  mallocng.meta_in_memory(M2, g, V2)
proof
  assume hg hm ag rav rfr ep en em el ef es emap
  have rw: all o. all n. o in omega -> n in omega -> int_le(int_add(o, n), 40) -> (int_le(int_add(o, n), 24) || int_le(32, o)) ->
      mallocng.rd(M2, int_add(g, o), n) = mallocng.rd(M, int_add(g, o), n) proof
    fix o n
    assume ho hn hl hout
    have ai: all i. i in omega -> int_lt(i, n) -> app(M2, int_add(int_add(g, o), i)) = app(M, int_add(int_add(g, o), i)) proof
      fix i
      assume hi hil
      have e: int_add(int_add(g, o), i) = int_add(g, int_add(o, i)) by arith(hg, ho, hi)
      have a := mp(all_elim(ag, {int_add(o, i)}), simp(ho, hi), arith(hl, hil, hi, ho, hn), arith(hout, hil, hi, ho, hn))
      show := rewrite(sym(e), a)
    qed
    show := apply(mp.agree_rd, hn, ai)
  qed
  have r0 := rewrite((int_add(g, 0) = g by arith(hg)), mp(all_elim(rw, {0}, {8}), simp(), simp(), simp(), simp()))
  have r8 := mp(all_elim(rw, {8}, {8}), simp(), simp(), simp(), simp())
  have r16 := mp(all_elim(rw, {16}, {8}), simp(), simp(), simp(), simp())
  have r32 := mp(all_elim(rw, {32}, {8}), simp(), simp(), simp(), simp())
  have m1 m2 m3 _ _ m6 m7 m8 m9 := expand(hm, mallocng.meta_in_memory)
  have n1 := trans(rewrite(sym(r0), m1), sym(ep))
  have n2 := trans(rewrite(sym(r8), m2), sym(en))
  have n3 := trans(rewrite(sym(r16), m3), sym(em))
  have n6 := rewrite(sym(emap), rewrite(sym(es), rewrite(sym(ef), rewrite(sym(el), rewrite(sym(r32), m6)))))
  show by defs(taut(n1, n2, n3, rav, rfr, n6, rewrite(sym(el), m7), rewrite(sym(ef), m8), rewrite(sym(es), m9)), mallocng.meta_in_memory)
qed

// the invariant kept by a used group activated (its freed slots up to the
// active index made available), the memory as a whole: no byte but g's
// mask words written (as 64-bit addresses), the new masks there, nothing
// but bytes; g on no active list past its head, or still full
theorem mp.holds_in_act(c, A, A2, vm, vm2, b, g, idx): c in mallocng.Cfg -> A in univ(1) -> A in mallocng.Abs -> A2 in mallocng.Abs ->
  b in fn_space(bits(64), option(omega)) -> mallocng.holds_in(c, A, vm, b) -> mallocng_purpose.activated(A, A2, g, idx) -> mallocng.is_used(A, g) ->
  app(app(app(A, "metas"), g), "avail") = 0 ->
  idx = int_mod(mallocng.b8(mallocng.mview(vm, mallocng.held(c, A, b)), int_add(app(app(app(A, "metas"), g), "mem"), 8)), 32) ->
  (all x. x in bits(64) -> !(int_le(int_add(g, 24), x) && int_lt(x, int_add(g, 32))) -> app(app(vm2, "bytes"), x) = app(app(vm, "bytes"), x)) ->
  app(vm2, "pages") = app(vm, "pages") -> app(vm2, "brk") = app(vm, "brk") ->
  mallocng.rd(mallocng.mview(vm2, mallocng.held(c, A, b)), int_add(g, 24), 4) = app(app(app(A2, "metas"), g), "avail") ->
  mallocng.rd(mallocng.mview(vm2, mallocng.held(c, A, b)), int_add(g, 28), 4) = app(app(app(A2, "metas"), g), "freed") ->
  (all sc. all k. sc in omega && k in omega -> int_lt(sc, 48) && int_lt(k, seq_len(app(app(A, "active"), sc))) -> int_lt(0, k) ->
     app(app(app(A, "active"), sc), k) = g -> app(app(app(A2, "metas"), g), "avail") = 0 && !(app(app(app(A2, "metas"), g), "freed") = 0)) ->
  mallocng.holds_in(c, A2, vm2, b)
proof
  assume hc hu ha ha2 hb hh hact hg av0 eidx eb ep ek rav rfr hac2
  let FP := mallocng.held(c, A, b)
  let M := mallocng.mview(vm, FP)
  let M2 := mallocng.mview(vm2, FP)
  have hmo heq _ _ _ := expand(hact, mallocng_purpose.activated)
  have {H = inv, hm = mapped, hfr = free} := expand(hh, mallocng.holds_in)
  have ag: all a. a in omega -> !(int_le(int_add(g, 24), a) && int_lt(a, int_add(g, 32))) -> app(M2, a) = app(M, a) proof
    fix a
    assume hao hw
    have bt: a in FP -> app(app(vm2, "bytes"), bits_of_int(64, a)) = app(app(vm, "bytes"), bits_of_int(64, a)) proof
      assume hf
      have {hff = fp} := apply(mp.held_fp, hf)
      have lo := apply(mp.fp_low[c := c, A := A, vm := vm, b := b, a := a], hm, hff)
      have e: bits_of_int(64, a) = a by defs(arith(hao, lo), bits_of_int, pow2)
      have ab: a in bits(64) by arith(hao, lo)
      show := rewrite(sym(e), mp(all_elim(eb, {a}), ab, hw))
    qed
    show := apply(mp.view_agree[vm := vm, vm2 := vm2, fp := FP, a := a], hao, bt, ep)
  qed
  have pg: all a. a in omega -> mallocng.pg(M2, a) = mallocng.pg(M, a) proof
    fix a
    assume hao
    show := apply(mp.view_pg[vm := vm, vm2 := vm2, fp := FP, a := a], hao, ep)
  qed
  have F: mp.mframe(c, A, A2, M, M2, b, app(vm, "brk"), g) by taut(hc, hu, ha, ha2, hb, H, hmo, heq, hg, ag, pg)
  have {go = nat} := apply(mp.mf_page, F)
  // g's group: its record, masks and big clause, its bytes as before
  have {huo = used} := expand(H, mallocng.holds)
  have gok := apply(mp.used_group, huo, hg)
  have {hmim = mim, hmk = masks, hbg = big} := expand(gok, mallocng.group_ok)
  let V := app(app(A, "metas"), g)
  have agh: all a. a in omega -> int_le(app(V, "mem"), a) -> int_le(a, mallocng.slot_end(V, app(V, "last_idx"))) -> app(M2, a) = app(M, a) proof
    fix a
    assume hao h1 h2
    have inr := apply(mp.group_bytes[A := A, M := M, b := b, h := g, a := a], ha, go, gok, hao, h1, h2)
    have ex: ex hh. mallocng.is_used(A, hh) && mallocng.in_range(a, mallocng.group_range(app(app(A, "metas"), hh))) by ex_intro({g}, taut(hg, inr))
    show := apply(mp.mf_region[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := app(vm, "brk"), g := g, a := a], F, hao, taut(ex))
  qed
  have vt: V in mallocng.MetaV := mp(fn_space_app[a := omega, b := mallocng.MetaV, f := app(A, "metas"), x := g], simp(ha), go)
  have vmem: app(V, "mem") in omega by simp(vt)
  have vlast: app(V, "last_idx") in omega by simp(vt)
  have sn := apply(mp.stride_nat, ha, go, gok)
  have cu: mallocng.UNIT = 16 by defs(refl({16}), mallocng.UNIT)
  have ci: mallocng.IB = 4 by defs(refl({4}), mallocng.IB)
  have ss: all i. mallocng.slot_start(V, i) = int_add(int_add(app(V, "mem"), 16), int_mul(mallocng.stride(V), i)) proof
    fix i
    show by defs(arith(cu), mallocng.slot_start, mallocng.storage)
  qed
  have sel: mallocng.slot_end(V, app(V, "last_idx")) = int_sub(int_add(int_add(int_add(app(V, "mem"), 16), int_mul(mallocng.stride(V), app(V, "last_idx"))), mallocng.stride(V)), 4)
    by defs(simp(all_elim(ss, {app(V, "last_idx")}), ci), mallocng.slot_end)
  have ml: int_mul(mallocng.stride(V), app(V, "last_idx")) in omega by simp(sn, vlast)
  have {bxb = byte} := apply(mp.agree_b8, mp(all_elim(agh, {int_add(app(V, "mem"), 8)}), simp(vmem), arith(vmem), arith(sel, ml, vmem, sn)))
  have es: all i. i in omega -> int_le(i, app(V, "last_idx")) ->
      mallocng.b8(M2, int_sub(mallocng.slot_start(V, i), 4)) = mallocng.b8(M, int_sub(mallocng.slot_start(V, i), 4)) proof
    fix i
    assume hi hil
    have mi := mp(all_elim(ms.mul_le, {mallocng.stride(V)}, {i}, {mallocng.stride(V)}, {app(V, "last_idx")}), sn, hi, simp(sn), simp(vlast), arith(sn), hil)
    have si := all_elim(ss, {i})
    have mo: int_mul(mallocng.stride(V), i) in omega by simp(sn, hi)
    have a := mp(all_elim(agh, {int_sub(mallocng.slot_start(V, i), 4)}), arith(si, vmem, mo), arith(si, vmem, mo), arith(si, sel, mi, vmem, mo, ml, sn))
    have {ab = byte} := apply(mp.agree_b8, a)
    show := ab
  qed
  // the new masks: sound (`mp.act_masks`), in memory
  have {msk2 = masks, big2 = big} := apply(mp.act_masks[A := A, A2 := A2, M := M, M2 := M2, g := g, idx := idx], ha, ha2, go, hmk, hbg, av0, hact, eidx, bxb, es)
  have a40: all j. j in omega -> int_lt(j, 40) -> !(int_le(24, j) && int_lt(j, 32)) -> app(M2, int_add(g, j)) = app(M, int_add(g, j)) proof
    fix j
    assume hj hjl hjo
    show := mp(all_elim(ag, {int_add(g, j)}), simp(go, hj), arith(hjo, go, hj))
  qed
  have {gm = mem, gl = last, gs = sclass, gf = freeable, gp = prev, gn = next, gmap = maplen} := apply(mp.mo_geom[A := A, A2 := A2, x := g], hmo, go)
  have mim2 := apply(mp.mim_masks[M := M, M2 := M2, g := g, V := V, V2 := app(app(A2, "metas"), g)], go, hmim, a40, rav, rfr, gp, gn, gm, gl, gf, gs, gmap)
  have h2 := apply(mp.holds_masks[c := c, A := A, A2 := A2, M := M, M2 := M2, b := b, brk := app(vm, "brk"), g := g], F, mim2, msk2, big2, hac2)
  have efp := apply(mp.mo_held[c := c, A := A, A2 := A2, b := b], ha, hmo)
  have efp0 := apply(mp.mo_fp[c := c, A := A, A2 := A2, b := b], ha, hmo)
  have efr := apply(mp.mo_ranges[c := c, A := A, A2 := A2], ha, hmo)
  // the same pages: the same mapped
  have mp2 := apply(mp.fpm_pages, hm, ep)
  have i2 := rewrite(sym(ek), rewrite(sym(efp), h2))
  have m3 := rewrite(sym(efr), mp2)
  have fr2 := rewrite(sym(efp0), apply(mp.free_rw_pages[c := c, vm := vm, vm2 := vm2, F := mallocng.footprint(c, A, b)], hfr, ep))
  show by defs(taut(i2, m3, fr2), mallocng.holds_in)
qed

// a 32-bit write: the bytes outside it kept, nothing but bytes changed,
// its value read back
theorem mp.w32_out(V, c, v, x): x in bits(64) -> c in bits(64) -> int_le(int_add(c, 4), 18446744073709551616) ->
  (int_le(int_add(c, 4), x) || int_lt(x, c)) ->
  app(app(mallocng_specs.wr32(V, c, v), "bytes"), x) = app(app(V, "bytes"), x)
proof
  assume hx hc hcl ho
  have s := apply(mp.st_out[B := app(V, "bytes"), c := c, k := 4, v := v, x := x], hx, hc, simp(), hcl, ho)
  show by defs(simp(s, app_update_same[f := V, k := "bytes", v := x86_64_linux.store_le(app(V, "bytes"), c, 4, v)]), mallocng_specs.wr32)
qed

theorem mp.w32_keep(V, c, v, k): !(k = "bytes") -> app(mallocng_specs.wr32(V, c, v), k) = app(V, k)
proof
  assume hk
  show by defs(mp(app_update_other[f := V, k := "bytes", v := x86_64_linux.store_le(app(V, "bytes"), c, 4, v), x := k], hk), mallocng_specs.wr32)
qed

theorem mp.w32_typed(V, c, v): app(V, "bytes") in fn_space(bits(64), bits(8)) -> app(mallocng_specs.wr32(V, c, v), "bytes") in fn_space(bits(64), bits(8))
proof
  assume hb
  show by defs(simp(mp(all_elim(x86.store_typed, {app(V, "bytes")}, {c}, {4}, {v}), hb)), mallocng_specs.wr32)
qed

theorem mp.w32_vm(V, c, v): V in x86_64_linux.Vm -> mallocng_specs.wr32(V, c, v) in x86_64_linux.Vm
proof
  assume hv
  show by defs(apply(ms.wr_any, {V}, {c}, {4}, {v}, hv), mallocng_specs.wr32)
qed

theorem mp.w32_at(V, c, v): app(V, "bytes") in fn_space(bits(64), bits(8)) -> c in bits(64) -> v in omega -> int_lt(v, 4294967296) ->
  gimple.bytes_at(mallocng_specs.wr32(V, c, v), c, 4) = v
proof
  assume hb hc hv hvl
  have r := apply(mp.rd_at4[vm := V, c := c, v := v], hb, hc, hv)
  have m: int_mod(v, 4294967296) = v by arith(hv, hvl)
  show by defs(trans(r, m), mallocng_specs.wr32)
qed

theorem mp.w32_rd_out(V, c, v, a, n): a in omega -> n in omega -> c in bits(64) -> int_le(int_add(a, n), 18446744073709551616) -> int_le(int_add(c, 4), 18446744073709551616) ->
  (int_le(int_add(c, 4), a) || int_le(int_add(a, n), c)) -> gimple.bytes_at(mallocng_specs.wr32(V, c, v), a, n) = gimple.bytes_at(V, a, n)
proof
  assume ha hn hc hal hcl ho
  show by defs(apply(mp.rd_out[vm := V, c := c, k := 4, v := v, a := a, n := n], ha, hn, hc, simp(), hal, hcl, ho), mallocng_specs.wr32)
qed
