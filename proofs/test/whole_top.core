// The program's claim (docs/todo.md 1(e)): the process from exec runs
// _start's steps to _start_c's entry, from there as the contract of the
// linked whole run (tm.whole_link) and its spec's ends (pw.stc_end) say --
// an exit with 0 or 1, or a stack overflow.

// ----------------------------------------------------------------------
//  The process's run, and the bridge's disciplined run

// (the process's loop body: a step)
abbrev pw.PSB(l, o) := bind_rel(x86_64_linux.step, fst(l), x7 x8. o = ok(pair(x7, empty), empty), x7 x8. o = exc(pair(x7, empty), pair("raise", x8)), x7. o = diverge(x7))
abbrev pw.TRE(l) := fn_update(empty, "os.events", fst(l).os.events)

// the process's run from m with the outcome o, unfolded
def pw.PR(m, o) := ex r. while_rel(pair(m, empty), l. true, l o2. pw.PSB(l, o2), l. pw.TRE(l), r) && tr.rmap(r, o)

theorem pw.proc_parts: all m o. runs(claim_program.run_process, m, o) -> pw.PR(m, o)
proof
  fix m o
  assume hr
  let B1(l, o2) := pw.PSB(l, o2) || (!true && o2 = exc(pair(fst(l), empty), pair("brk", empty)))
  have e: ex x2. while_rel(pair(m, empty), l. true, l o2. B1(l, o2), l. pw.TRE(l), x2) && tr.rmap(x2, o)
    by defs(simp(expand(hr, claim_program.run_process)), tr.rmap)
  obtain x2, hw hm from e
  have bb: all l o2. B1(l, o2) -> pw.PSB(l, o2) proof
    fix l o2
    assume h
    show by taut(h)
  qed
  have hw2 := apply(while_mono[l0 := pair(m, empty), c := l. true, b1 := l o2. B1(l, o2), b2 := l o2. pw.PSB(l, o2), tr := l. pw.TRE(l), r := x2], bb, hw)
  show by defs(ex_intro({x2}, taut(hw2, hm)), pw.PR)
qed

// (the run with the return's stop: the disciplined run, or that run
// leaving with disc)
theorem pw.rw_rd: all s r o. tr.rw(s, pair(s, empty), r) -> tr.rmap(r, o) -> tr.run_d(s, s, o) || (ex x. tr.run_d(s, s, exc(x, exc_val("disc", empty))))
proof
  fix s r o
  assume hw hm
  have ne: all l. !is_ok(exc(l, pair("raise", exc_val("disc", empty)))) proof
    fix l
    have n: is_ok(exc(l, pair("raise", exc_val("disc", empty)))) -> false proof
      assume h
      obtain a b, h2 from expand(h, is_ok)
      show by simp(h2)
    qed
    show by taut(n)
  qed
  have g := mp(mp(while_guard[l0 := pair(s, empty), b := l o. tr.rb(s, l, o), tr := l. fn_update(empty, "os.events", fst(l).os.events),
    p := l. tr.disc_ok(s, fst(l)), e := l. exc(l, pair("raise", exc_val("disc", empty))), r := r], ne), expand(hw, tr.rw))
  have kept: while_rel(pair(s, empty), l. true, l o. (tr.disc_ok(s, fst(l)) && tr.rb(s, l, o)) || (!tr.disc_ok(s, fst(l)) && o = exc(l, pair("raise", exc_val("disc", empty)))),
      l. fn_update(empty, "os.events", fst(l).os.events), r) -> tr.run_d(s, s, o) proof
    assume w
    have wd: tr.rwd(s, pair(s, empty), r) by defs(w, tr.rwd, tr.rbd)
    show by defs(ex_intro({r}, taut(wd, hm)), tr.run_d)
  qed
  have left: (ex l. while_rel(pair(s, empty), l. true, l o. (tr.disc_ok(s, fst(l)) && tr.rb(s, l, o)) || (!tr.disc_ok(s, fst(l)) && o = exc(l, pair("raise", exc_val("disc", empty)))),
      l. fn_update(empty, "os.events", fst(l).os.events), exc(l, pair("raise", exc_val("disc", empty))))) -> (ex x. tr.run_d(s, s, exc(x, exc_val("disc", empty)))) proof
    assume e
    obtain l, w from e
    have wd: tr.rwd(s, pair(s, empty), exc(l, pair("raise", exc_val("disc", empty)))) by defs(w, tr.rwd, tr.rbd)
    have rm: tr.rmap(exc(l, pair("raise", exc_val("disc", empty))), exc(fst(l), exc_val("disc", empty))) by defs(simp(), tr.rmap)
    have rd: tr.run_d(s, s, exc(fst(l), exc_val("disc", empty))) by defs(ex_intro({exc(l, pair("raise", exc_val("disc", empty)))}, taut(wd, rm)), tr.run_d)
    show by ex_intro({fst(l)}, rd)
  qed
  show by taut(g, kept, left)
qed

// the process's run from s: the disciplined run from s, or that run
// leaving early -- with disc, or at the entry's return
theorem pw.proc_rd: all s o. pw.PR(s, o) ->
  tr.run_d(s, s, o) || (ex x. tr.run_d(s, s, exc(x, exc_val("disc", empty)))) || (ex x. tr.run_d(s, s, ok(x, empty)))
proof
  fix s o
  assume hp
  obtain r, hw hm from expand(hp, pw.PR)
  let E(l) := exc(pair(fst(l), empty), pair("brk", empty))
  have ne: all l. !is_ok(E(l)) proof
    fix l
    have n: is_ok(E(l)) -> false proof
      assume h
      obtain a b, h2 from expand(h, is_ok)
      show by simp(h2)
    qed
    show by taut(n)
  qed
  have g := mp(mp(while_guard[l0 := pair(s, empty), b := l o2. pw.PSB(l, o2), tr := l. pw.TRE(l), p := l. !tr.at_ret(s, fst(l)), e := l. E(l), r := r], ne), hw)
  have c1: while_rel(pair(s, empty), l. true, l o2. (!tr.at_ret(s, fst(l)) && pw.PSB(l, o2)) || (!!tr.at_ret(s, fst(l)) && o2 = E(l)), l. pw.TRE(l), r) ->
      tr.run_d(s, s, o) || (ex x. tr.run_d(s, s, exc(x, exc_val("disc", empty)))) || (ex x. tr.run_d(s, s, ok(x, empty))) proof
    assume w
    have rw: tr.rw(s, pair(s, empty), r) by defs(w, tr.rw, tr.rb)
    show by taut(apply(pw.rw_rd, rw, hm))
  qed
  have c2: (ex l. while_rel(pair(s, empty), l. true, l o2. (!tr.at_ret(s, fst(l)) && pw.PSB(l, o2)) || (!!tr.at_ret(s, fst(l)) && o2 = E(l)), l. pw.TRE(l), E(l))) ->
      tr.run_d(s, s, o) || (ex x. tr.run_d(s, s, exc(x, exc_val("disc", empty)))) || (ex x. tr.run_d(s, s, ok(x, empty))) proof
    assume e
    obtain l, w from e
    have rw: tr.rw(s, pair(s, empty), E(l)) by defs(w, tr.rw, tr.rb)
    have rm: tr.rmap(E(l), ok(fst(l), empty)) by defs(simp(), tr.rmap)
    have q := apply(pw.rw_rd, rw, rm)
    have c21: tr.run_d(s, s, ok(fst(l), empty)) -> ex x. tr.run_d(s, s, ok(x, empty)) proof
      assume h
      show by ex_intro({fst(l)}, h)
    qed
    show by taut(q, c21)
  qed
  show by taut(g, c1, c2)
qed

// ----------------------------------------------------------------------
//  The contract's outcomes, the spec ending

// the machine's outcomes the whole run's contract allows when its spec
// ends (pw.END): a divergence, a stack overflow below the entry's sp, a
// stack fault, an exit with 0 or 1
abbrev pw.XO(s, o) := (ex t. o = diverge(t)) ||
  (ex m1 a k. (o = exc(m1, exc_val("segv", pair(a, k))) && (k = 0 || k = 1 || k = 3)) && a in bits(64) && abi.overflow_at(m1.vm, m1.gpr[4], abi.sp(s), a)) ||
  (ex m1. o = exc(m1, exc_val("stack_fault", empty))) || (ex m1 st. o = exc(m1, exc_val("exit", st)) && (st = 0 || st = 1))

theorem pw.mtv_end: all s V P W o. (all x. runs(P, W, x) -> pw.END(x)) -> tr.mtv(false, s, V, P, W, o, false) -> pw.XO(s, o)
proof
  fix s V P W o
  assume he hm
  have c1: tr.ub(s, V, P, W) -> pw.XO(s, o) proof
    assume h
    obtain e x, _ ne ns _ hr from expand(h, tr.ub)
    have q := mp(all_elim(he, {exc(x, e)}), hr)
    have k1: (ex y. exc(x, e) = exc(y, pw.OVF)) -> false proof
      assume h1
      obtain y, ey from h1
      have _ ee := apply(ui.exc_inj, ey)
      show by taut(ne, ee)
    qed
    have k2: (ex y c. exc(x, e) = exc(y, exc_val("exit", c)) && (c = 0 || c = 1)) -> false proof
      assume h2
      obtain y c, ey _ from h2
      have _ ee := apply(ui.exc_inj, ey)
      have nx: ex st. e = exc_val("exit", st) by ex_intro({c}, ee)
      show by taut(expand(ns, abi.nstop), nx)
    qed
    show by taut(q, k1, k2)
  qed
  have c2: tr.crash(s, P, W, o) -> pw.XO(s, o) proof
    assume h
    obtain m1 a k, oe _ ab _ _ _ from expand(h, tr.crash)
    have d1: (o = exc(m1, exc_val("segv", pair(a, k))) && (k = 0 || k = 1 || k = 3)) && abi.overflow_at(m1.vm, m1.gpr[4], abi.sp(s), a) -> pw.XO(s, o) proof
      assume h1
      have x: ex m2 a2 k2. (o = exc(m2, exc_val("segv", pair(a2, k2))) && (k2 = 0 || k2 = 1 || k2 = 3)) && a2 in bits(64) &&
        abi.overflow_at(m2.vm, m2.gpr[4], abi.sp(s), a2) by ex_intro({m1}, {a}, {k}, taut(h1, ab))
      show by taut(x)
    qed
    have d2: o = exc(m1, exc_val("stack_fault", empty)) -> pw.XO(s, o) proof
      assume h2
      show by taut((ex m2. o = exc(m2, exc_val("stack_fault", empty)) by ex_intro({m1}, h2)))
    qed
    show by taut(oe, d1, d2)
  qed
  have c3: tr.div(P, W, o) -> pw.XO(s, o) proof
    assume h
    have d _ := expand(h, tr.div)
    show by taut(d)
  qed
  have c4: (ex m1. o = ok(m1, empty) && tr.rtv(false, s, V, P, W, m1)) -> pw.XO(s, o) proof
    assume h
    obtain m1, _ hr from h
    have _ _ ew .. := expand(hr, tr.rtv)
    obtain w2, hp .. from ew
    have q := mp(all_elim(he, {ok(w2, pair(m1.gpr[0], m1.gpr[2]))}), hp)
    show by taut(q, all_elim(pw.end_ok, {w2}, {pair(m1.gpr[0], m1.gpr[2])}))
  qed
  have c5: tr.xo(P, W, o) -> pw.XO(s, o) proof
    assume h
    obtain m1 st x, _ oe _ hr from expand(h, tr.xo)
    have q := mp(all_elim(he, {exc(x, exc_val("exit", st))}), hr)
    have k1: (ex y. exc(x, exc_val("exit", st)) = exc(y, pw.OVF)) -> false proof
      assume h1
      obtain y, ey from h1
      have _ ee := apply(ui.exc_inj, ey)
      have q2 _ := apply(pair_inj[a := "exit", b := st, c := "stack_overflow", d := empty], (pair("exit", st) = pair("stack_overflow", empty) by defs(ee, exc_val)))
      show by taut(q2, (!("exit" = "stack_overflow") by eval()))
    qed
    have k2: (ex y c. exc(x, exc_val("exit", st)) = exc(y, exc_val("exit", c)) && (c = 0 || c = 1)) -> pw.XO(s, o) proof
      assume h2
      obtain y c, ey hc from h2
      have _ ee := apply(ui.exc_inj, ey)
      have _ sc := apply(pair_inj[a := "exit", b := st, c := "exit", d := c], (pair("exit", st) = pair("exit", c) by defs(ee, exc_val)))
      have x: ex m2 st2. o = exc(m2, exc_val("exit", st2)) && (st2 = 0 || st2 = 1) by ex_intro({m1}, {st}, taut(oe, rewrite(sym(sc), hc)))
      show by taut(x)
    qed
    show by taut(q, k1, k2)
  qed
  show by taut(expand(hm, tr.mtv), c1, c2, c3, c4, c5)
qed

// (the early stops: none of those outcomes)
theorem pw.xo_disc: all s x. !pw.XO(s, exc(x, exc_val("disc", empty)))
proof
  fix s x
  let D := exc(x, exc_val("disc", empty))
  have a1: (ex t. D = diverge(t)) -> false proof
    assume e
    obtain t, et from e
    show by simp(et)
  qed
  have a2: (ex m1 a k. (D = exc(m1, exc_val("segv", pair(a, k))) && (k = 0 || k = 1 || k = 3)) && a in bits(64) && abi.overflow_at(m1.vm, m1.gpr[4], abi.sp(s), a)) -> false proof
    assume e
    obtain m1 a k, et .. from e
    have _ ee := apply(ui.exc_inj, et)
    have q1 _ := apply(pair_inj[a := "disc", b := empty, c := "segv", d := pair(a, k)], (pair("disc", empty) = pair("segv", pair(a, k)) by defs(ee, exc_val)))
    show by taut(q1, (!("disc" = "segv") by eval()))
  qed
  have a3: (ex m1. D = exc(m1, exc_val("stack_fault", empty))) -> false proof
    assume e
    obtain m1, et from e
    have _ ee := apply(ui.exc_inj, et)
    have q1 _ := apply(pair_inj[a := "disc", b := empty, c := "stack_fault", d := empty], (pair("disc", empty) = pair("stack_fault", empty) by defs(ee, exc_val)))
    show by taut(q1, (!("disc" = "stack_fault") by eval()))
  qed
  have a4: (ex m1 st. D = exc(m1, exc_val("exit", st)) && (st = 0 || st = 1)) -> false proof
    assume e
    obtain m1 st, et _ from e
    have _ ee := apply(ui.exc_inj, et)
    have q1 _ := apply(pair_inj[a := "disc", b := empty, c := "exit", d := st], (pair("disc", empty) = pair("exit", st) by defs(ee, exc_val)))
    show by taut(q1, (!("disc" = "exit") by eval()))
  qed
  show by taut(a1, a2, a3, a4)
qed

theorem pw.xo_ok: all s x. !pw.XO(s, ok(x, empty))
proof
  fix s x
  have a1: (ex t. ok(x, empty) = diverge(t)) -> false proof
    assume e
    obtain t, et from e
    show by simp(et)
  qed
  have a2: (ex m1 a k. (ok(x, empty) = exc(m1, exc_val("segv", pair(a, k))) && (k = 0 || k = 1 || k = 3)) && a in bits(64) && abi.overflow_at(m1.vm, m1.gpr[4], abi.sp(s), a)) -> false proof
    assume e
    obtain m1 a k, et .. from e
    show by simp(et)
  qed
  have a3: (ex m1. ok(x, empty) = exc(m1, exc_val("stack_fault", empty))) -> false proof
    assume e
    obtain m1, et from e
    show by simp(et)
  qed
  have a4: (ex m1 st. ok(x, empty) = exc(m1, exc_val("exit", st)) && (st = 0 || st = 1)) -> false proof
    assume e
    obtain m1 st, et _ from e
    show by simp(et)
  qed
  show by taut(a1, a2, a3, a4)
qed

// ----------------------------------------------------------------------
//  From _start_c's entry

// (the program's statics at the entry: off the stack's space -- under its
// floor, below the image's last page)
theorem pw.loaded_st: all m0 s lo top argv envp auxv. ui.SX(m0, s, lo, top, argv, envp, auxv) -> abi.loaded(s.vm, 4198400, text.code, tm.ST)
proof
  fix m0 s lo top argv envp auxv
  assume hx
  have hc hlo _ _ _ _ _ _ _ he _ _ := expand(hx, ui.SX)
  have hM _ _ hsp _ _ _ h5 := expand(hc, ui.ctx)
  have _ _ _ _ _ _ _ sp8 := expand(hsp, x86_64_linux.stack_pages)
  have ca _ := expand(apply(ui.entry_loaded, h5, apply(ui.text_code[argv := argv, envp := envp, m0 := m0], he)), abi.loaded)
  have st sl _ := apply(pw.s_fields, hc)
  have fl: x86_64_linux.stack_floor(s.vm) = x86_64_linux.stack_floor(m0.vm) by defs(simp(st, sl), x86_64_linux.stack_floor)
  have m32: x86_64_linux.mapped(m0.vm, 1032) by defs(simp(apply(ui.pg_img[argv := argv, envp := envp, m0 := m0, p := 1032], he, simp())), x86_64_linux.mapped)
  have f32 := mp(all_elim(sp8, {1032}), simp(), conj(hlo, m32))
  have cs: all a. a in omega -> a in tm.ST -> x86_64_linux.off_stack_space(s.vm, int_div(a, x86_64_linux.PAGE), 1) proof
    fix a
    assume ha hs
    have se := apply(musl.unit_app, unfold(musl_malloc.prog_statics))
    have al: int_lt(a, 4228688) by simp(expand(rewrite(se, hs), int_range), ha)
    show by defs(arith(f32, fl, al, ha), x86_64_linux.off_stack_space)
  qed
  show by defs(taut(ca, cs), abi.loaded)
qed

// the process from _start_c's entry (exec's machine after _start's
// steps): as the linked whole run's contract allows, its spec ending
theorem pw.from_entry: all m0 s lo top argv envp auxv o. ui.SX(m0, s, lo, top, argv, envp, auxv) -> tr.eok(false, false, s, seq_one(m0.gpr[4])) ->
  pw.PR(s, o) -> pw.XO(s, o)
proof
  fix m0 s lo top argv envp auxv o
  assume hx heo hp
  have hc _ _ _ _ _ _ _ _ he _ _ := expand(hx, ui.SX)
  have hM hlo0 htop hsp hl1 _ h16 h5 := expand(hc, ui.ctx)
  have sM sU srip .. := expand(h5, ui.s5)
  obtain G NF, himp _ _ hmio hmc _ _ hfio hfc from tm.whole_link
  let p := m0.gpr[4]
  let args := seq_one(p)
  let OBJ := pw.OBJ(m0, top)
  let MEM := ui.wvm(s.vm)
  have g0 := apply(x86i.rsp_typed, hM)
  have sl := apply(tr.seq_one_type[x := p, t := bits(64)], g0)
  have ln: seq_len(args) = 1 by simp()
  have ol: ord_le(seq_len(args), 6) by defs(arith(ln), ord_le)
  have hA: args in abi.ARGS by sel(conj(sl, ol))
  have ot := ui.iobjs_type[r := p, top := top]
  have _ _ _ sv := apply(x86i.parts, sM)
  have wt wu := apply(ui.wvm_typed, sv, apply(ui.vm_univ, sv))
  have ld := apply(pw.loaded_st[m0 := m0, s := s, lo := lo, top := top, argv := argv, envp := envp, auxv := auxv], hx)
  have ca _ := expand(ld, abi.loaded)
  have ob := apply(ui.entry_objs[m0 := m0, s := s, lo := lo, top := top], hM, hlo0, htop, hsp, hl1, h16, h5)
  have vk := all_elim(ui.wvm_vok, {s}, {OBJ})
  have Wu := apply(tr.vw_univ[b := false, s := s, objs := OBJ, mem := MEM], sU, ot, wt)
  have Ww := apply(tr.vw_typed[b := false, s := s, objs := OBJ, mem := MEM], sM, ot, wt, Wu)
  have cp := apply(ui.cpre[m0 := m0, s := s, lo := lo, top := top, argv := argv, envp := envp, auxv := auxv], hx)
  have r0: pw.R0(args) = p by simp(apply(nf.boi_in[n := 64, x := p], eval(), g0))
  // the spec ends (pw.stc_end)
  have hE: all x. runs(tm.STC(G, NF)[args], tr.vw(false, s, OBJ, MEM), x) -> pw.END(x) proof
    fix x
    assume hr
    show := apply(pw.stc_end, {G}, {NF}, {m0}, {s}, {lo}, {top}, {argv}, {envp}, {auxv}, {args}, {x}, hmio, hmc, hfio, hfc, hx, heo, ca, Ww, Wu, cp,
      sl, arith(ln), (ord_le(1, seq_len(args)) by defs(arith(ln), ord_le)), r0, hr)
  qed
  // the contract at each disciplined run
  have ct: all o2. tr.run_d(s, s, o2) -> pw.XO(s, o2) proof
    fix o2
    assume hrd
    have mt := mp(all_elim(expand(himp, tr.impl_d), {args}, {OBJ}, {MEM}, {s}, {o2}), hA, ot, wt, sM, sU, ld, srip, heo, ob, vk, hrd)
    show := apply(pw.mtv_end, {s}, {abi.wob(OBJ, tr.cbm(false, s.fs_base))}, {tm.STC(G, NF)[args]}, {tr.vw(false, s, OBJ, MEM)}, {o2}, hE, mt)
  qed
  have k2: (ex x. tr.run_d(s, s, exc(x, exc_val("disc", empty)))) -> pw.XO(s, o) proof
    assume e
    obtain x, hr from e
    show by taut(mp(all_elim(ct, {exc(x, exc_val("disc", empty))}), hr), all_elim(pw.xo_disc, {s}, {x}))
  qed
  have k3: (ex x. tr.run_d(s, s, ok(x, empty))) -> pw.XO(s, o) proof
    assume e
    obtain x, hr from e
    show by taut(mp(all_elim(ct, {ok(x, empty)}), hr), all_elim(pw.xo_ok, {s}, {x}))
  qed
  show by taut(apply(pw.proc_rd, hp), all_elim(ct, {o}), k2, k3)
qed

// ----------------------------------------------------------------------
//  From exec: _start's steps

// the process's first step (its outcome not a divergence): its ok outcome
// continuing the run, its exception the run's
theorem pw.proc_step: all m o. pw.PR(m, o) -> !(ex t. o = diverge(t)) ->
  ex o1. runs(x86_64_linux.step(), m, o1) && (all m1 v. o1 = ok(m1, v) -> pw.PR(m1, o)) && (all y e. o1 = exc(y, e) -> o = exc(y, e))
proof
  fix m o
  assume hp hnd
  obtain r, hw hm from expand(hp, pw.PR)
  have nd: !(fst(r) = 2) proof
    assume h2
    have od: o = diverge(snd(r)) := rsimp(rewrite(h2, expand(hm, tr.rmap)))
    show by taut(hnd, (ex t. o = diverge(t) by ex_intro({snd(r)}, od)))
  qed
  let GOAL := ex o1. runs(x86_64_linux.step(), m, o1) && (all m1 v. o1 = ok(m1, v) -> pw.PR(m1, o)) && (all y e. o1 = exc(y, e) -> o = exc(y, e))
  have u := apply(while_unroll[l0 := pair(m, empty), c := l. true, b := l o2. pw.PSB(l, o2), tr := l. pw.TRE(l), r := r], hw)
  have fp: fst(pair(m, empty)) = m by simp()
  // (the first pass leaving: an exception)
  have c2: pw.PSB(pair(m, empty), r) -> !is_ok(r) -> GOAL proof
    assume hb nr
    obtain o1, hs1 hk from expand(hb, bind_rel)
    have ok1: all m1 v. o1 = ok(m1, v) -> pw.PR(m1, o) proof
      fix m1 v
      assume e
      have k1: (ex s1 v1. o1 = ok(s1, v1) && r = ok(pair(s1, empty), empty)) -> false proof
        assume h1
        obtain s1 v1, _ er from h1
        show by taut(nr, (is_ok(r) by defs(ex_intro({pair(s1, empty)}, {empty}, er), is_ok)))
      qed
      have k2: (ex s1 x. o1 = exc(s1, x) && r = exc(pair(s1, empty), pair("raise", x))) -> false proof
        assume h2
        obtain s1 x, eo _ from h2
        show := rsimp(trans(sym(e), eo))
      qed
      have k3: (ex d. o1 = diverge(d) && r = diverge(d)) -> false proof
        assume h3
        obtain d, eo _ from h3
        show := rsimp(trans(sym(e), eo))
      qed
      show by taut(hk, k1, k2, k3)
    qed
    have ex1: all y e. o1 = exc(y, e) -> o = exc(y, e) proof
      fix y e
      assume eo
      have k1: (ex s1 v1. o1 = ok(s1, v1) && r = ok(pair(s1, empty), empty)) -> o = exc(y, e) proof
        assume h1
        obtain s1 v1, e1 _ from h1
        show by taut(rsimp(trans(sym(eo), e1)))
      qed
      have k2: (ex s1 x. o1 = exc(s1, x) && r = exc(pair(s1, empty), pair("raise", x))) -> o = exc(y, e) proof
        assume h2
        obtain s1 x, e1 er from h2
        have ys _ := apply(ui.exc_inj, trans(sym(eo), e1))
        have _ xe := apply(ui.exc_inj, trans(sym(eo), e1))
        have oe: o = exc(s1, x) := rsimp(rewrite(er, expand(hm, tr.rmap)))
        show := rewrite(sym(ys), rewrite(sym(xe), oe))
      qed
      have k3: (ex d. o1 = diverge(d) && r = diverge(d)) -> o = exc(y, e) proof
        assume h3
        obtain d, e1 _ from h3
        show by taut(rsimp(trans(sym(eo), e1)))
      qed
      show by taut(hk, k1, k2, k3)
    qed
    show by ex_intro({o1}, taut(rewrite(fp, hs1), ok1, ex1))
  qed
  // (a first step going on: the run from its state)
  have c3: (ex l1. pw.PSB(pair(m, empty), ok(l1, empty)) && (ex r1. while_rel(l1, l. true, l o2. pw.PSB(l, o2), l. pw.TRE(l), r1) &&
      fst(r1) = fst(r) && (!(fst(r) = 2) -> r1 = r))) -> GOAL proof
    assume h
    obtain l1, hb ex1 from h
    obtain r1, w1 _ e1 from ex1
    have er: r1 = r := mp(e1, nd)
    obtain o1, hs1 hk from expand(hb, bind_rel)
    have k1: (ex s1 v1. o1 = ok(s1, v1) && ok(l1, empty) = ok(pair(s1, empty), empty)) -> GOAL proof
      assume h1
      obtain s1 v1, eo el from h1
      have l1e _ := apply(ui.ok_inj, el)
      have okc: all m2 v2. o1 = ok(m2, v2) -> pw.PR(m2, o) proof
        fix m2 v2
        assume e2
        have me _ := apply(ui.ok_inj, trans(sym(e2), eo))
        have w2 := rewrite(l1e, rewrite(er, w1))
        show by defs(ex_intro({r}, taut(rewrite(sym(me), w2), hm)), pw.PR)
      qed
      have exc1: all y e. o1 = exc(y, e) -> o = exc(y, e) proof
        fix y e
        assume e2
        show by taut(rsimp(trans(sym(e2), eo)))
      qed
      show by ex_intro({o1}, taut(rewrite(fp, hs1), okc, exc1))
    qed
    have k2: (ex s1 x. o1 = exc(s1, x) && ok(l1, empty) = exc(pair(s1, empty), pair("raise", x))) -> GOAL proof
      assume h2
      obtain s1 x, _ el from h2
      show by taut(rsimp(el))
    qed
    have k3: (ex d. o1 = diverge(d) && ok(l1, empty) = diverge(d)) -> GOAL proof
      assume h3
      obtain d, _ el from h3
      show by taut(rsimp(el))
    qed
    show by taut(hk, k1, k2, k3)
  qed
  show by taut(u, c2, c3)
qed

// _start's call pushing the return address, faulting: a stack overflow --
// below exec's rsp, the pages up to it the stack's or none
theorem pw.push_fault: all m0 lo top m4 y e. m0 in x86_64_linux.Machine -> lo in omega -> top in omega -> x86_64_linux.stack_pages(m0.vm, lo, top) ->
  int_le(int_mul(lo, x86_64_linux.PAGE), m0.gpr[4]) -> int_lt(m0.gpr[4], int_mul(top, x86_64_linux.PAGE)) -> int_le(16, m0.gpr[4]) -> int_mod(m0.gpr[4], 16) = 0 ->
  ui.s4(m0, m4) ->
  runs(x86_64_linux.touch_range(bits_sub(64, m4.gpr[4], 8), 8, 1), fn_update(m4, "rip", bits_add(64, m4.rip, bits_of_int(64, 5))), exc(y, e)) ->
  ex a c. (a in bits(64) && c in x86_64_linux.SegvCode) && e = exc_val("segv", pair(a, c)) && abi.overflow_at(y.vm, y.gpr[4], m0.gpr[4], a)
proof
  fix m0 lo top m4 y e
  assume hM0 hlo htop hsp hl1 hl2 h16 hal h4 ht
  have hM hU hv hr hsp4 _ _ _ _ _ _ := expand(h4, ui.s4)
  have sp1 sp2 sp3 sp4 sp5 _ _ sp8 := expand(hsp, x86_64_linux.stack_pages)
  have g0 := apply(x86i.rsp_typed, hM0)
  have e4: m4.gpr[4] = m0.gpr[4] := trans(hsp4, apply(ui.and16, g0, hal))
  let R := m0.gpr[4]
  let P := fn_update(m4, "rip", bits_add(64, m4.rip, bits_of_int(64, 5)))
  let A := bits_sub(64, m4.gpr[4], 8)
  have pt := apply(x86i.parts, hM)
  have pr: bits_add(64, m4.rip, bits_of_int(64, 5)) = 4198565 by rsimp(hr)
  have PM: P in x86_64_linux.Machine by defs(simp(expand(hM, x86_64_linux.Machine), hU, pt, pr), x86_64_linux.Machine)
  have PU: P in univ(1) by simp(hU, pr)
  have v0: P.vm in x86_64_linux.Vm := apply(x86i.parts, PM).4
  have pv: P.vm = m0.vm by rsimp(hv)
  let RP := int_div(R, x86_64_linux.PAGE)
  have ro: RP in omega by defs(arith(g0), x86_64_linux.PAGE)
  have rl1: int_le(lo, RP) && int_lt(RP, top) by defs(arith(hl1, hl2, g0), x86_64_linux.PAGE)
  have rpg := mp(all_elim(sp5, {RP}), ro, rl1)
  have mr: x86_64_linux.mapped(P.vm, RP) by defs(simp(pv, rpg, (int_lt(RP, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) by arith(rl1, sp2))), x86_64_linux.mapped)
  have ae: A = int_sub(R, 8) by defs(arith(e4, g0, h16), bits_sub, bits_of_int, pow2)
  have rb: x86.range_below(A, 8, 0, RP) proof
    have g: all j. j in omega -> int_lt(j, 8) -> int_le(0, x86_64_linux.page_of(bits_add(64, A, bits_of_int(64, j)))) &&
        int_le(x86_64_linux.page_of(bits_add(64, A, bits_of_int(64, j))), RP) proof
      fix j
      assume j1 j2
      have ej: bits_add(64, A, bits_of_int(64, j)) = int_add(int_sub(R, 8), j) by defs(arith(ae, g0, h16, j1, j2), bits_add, bits_of_int, pow2)
      show by defs(arith(ej, g0, h16, j1, j2), x86_64_linux.page_of, x86_64_linux.PAGE)
    qed
    show by defs(g, x86.range_below)
  qed
  have gr fa := apply(x86.touch_range_exc, {P}, {A}, {8}, {1}, {0}, {RP}, {y}, {e}, v0, PU, ro, mr, rb, ht)
  have {yM = cM, ygpr = cgpr} := apply(x86.grown_typed, {P}, {0}, {RP}, {y}, PM, PU, gr)
  have sx := apply(x86.touch_range_stk_exc, {P}, {A}, {8}, {1}, {y}, {e}, ht)
  have sk1 _ := expand(sx, x86.stk_ext)
  obtain j, jo jn tf0 from expand(fa, x86.fault_at)
  let X := bits_add(64, A, bits_of_int(64, j))
  have xe: X = int_add(int_sub(R, 8), j) by defs(arith(ae, g0, h16, jo, jn), bits_add, bits_of_int, pow2)
  have xb: X in bits(64) by simp()
  have yr: y.gpr[4] = R by simp(ygpr, e4)
  // (the pages from X's to rsp's: the stack's, or none)
  have ov: abi.overflow_at(y.vm, y.gpr[4], R, X) proof
    have lt: int_lt(X, R) by arith(xe, jn, jo)
    have pg: all p. p in omega -> int_le(int_div(X, x86_64_linux.PAGE), p) && int_le(p, int_div(y.gpr[4], x86_64_linux.PAGE)) ->
        abi.stack_page(y.vm, p) || !x86_64_linux.mapped(y.vm, p) proof
      fix p
      assume hp hb
      have p1 p2 := hb
      have k := mp(all_elim(sk1, {p}), hp)
      have same: y.vm.pages[p] = m0.vm.pages[p] -> abi.stack_page(y.vm, p) || !x86_64_linux.mapped(y.vm, p) proof
        assume eq
        have up: int_le(lo, p) -> abi.stack_page(y.vm, p) proof
          assume hl
          have pl: int_lt(p, top) by defs(arith(p2, yr, rl1, g0), x86_64_linux.PAGE)
          have q := mp(all_elim(sp5, {p}), hp, conj(hl, pl))
          show by defs(simp(eq, q, (int_lt(p, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) by arith(pl, sp2))), abi.stack_page, x86_64_linux.mapped)
        qed
        have dn: int_lt(p, lo) -> !x86_64_linux.mapped(y.vm, p) proof
          assume hl hmy
          have m0p: x86_64_linux.mapped(m0.vm, p) by defs(simp(rewrite(eq, expand(hmy, x86_64_linux.mapped))), x86_64_linux.mapped)
          have q := mp(all_elim(sp8, {p}), hp, conj(hl, m0p))
          have sf: x86_64_linux.stack_floor(m0.vm) = int_sub(m0.vm.stack_top, m0.vm.stack_limit) by defs(simp(), x86_64_linux.stack_floor)
          show by defs(arith(q, sf, hl, p1, xe, hl1, jo, sp4, sp3, g0, h16), x86_64_linux.STACK_GUARD_GAP, x86_64_linux.PAGE)
        qed
        show by taut(up, dn, (int_le(lo, p) || int_lt(p, lo) by arith(hp, hlo)))
      qed
      show by taut(rewrite(pv, k), same)
    qed
    show by defs(taut(lt, pg), abi.overflow_at)
  qed
  have cn: x86_64_linux.canonical(X) by defs(arith(xe, hl2, sp2, jn, jo), x86_64_linux.canonical, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
  have tf := expand(tf0, x86.touch_fault)
  let GOAL := ex a c. (a in bits(64) && c in x86_64_linux.SegvCode) && e = exc_val("segv", pair(a, c)) && abi.overflow_at(y.vm, y.gpr[4], m0.gpr[4], a)
  have kc: all c. c in x86_64_linux.SegvCode -> e = exc_val("segv", pair(X, c)) -> GOAL proof
    fix c
    assume hc he
    show by ex_intro({X}, {c}, taut(xb, hc, he, ov))
  qed
  have c0: e = exc_val("segv", pair(X, 0)) -> GOAL := mp(all_elim(kc, {0}), eval())
  have c1: e = exc_val("segv", pair(X, 1)) -> GOAL := mp(all_elim(kc, {1}), eval())
  have c3: e = exc_val("segv", pair(X, 3)) -> GOAL := mp(all_elim(kc, {3}), eval())
  show by taut(tf, cn, c0, c1, c3)
qed
