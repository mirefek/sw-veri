// The whole run's GIMPLE from _start_c's entry (docs/todo.md 1(d)):
// _start_c, __libc_start_main and stage2 with the program's main and exit
// linked end -- an exit with 0 or 1, or a stack overflow -- from the view
// of exec's memory at _start_c's entry machine s.

abbrev pw.OBJ(m0, top) := ui.iobjs(m0.gpr[4], top)
abbrev pw.W0(s, m0, top) := tr.vw(false, s, pw.OBJ(m0, top), ui.wvm(s.vm))

// (envp past argv's argc words and its null: from sp)
theorem pw.env_eq: all a c. a in bits(64) -> c in omega -> int_lt(int_add(a, int_mul(8, int_add(c, 2))), 18446744073709551616) ->
  bits_add(64, bits_add(64, a, 8), int_mul(8, int_add(c, 1))) = bits_add(64, a, int_mul(8, int_add(c, 2)))
proof
  fix a c
  assume ha hc hl
  show by defs(arith(ha, hc, hl), bits_add, bits_of_int, pow2)
qed

theorem pw.stc_end: all G NF m0 s lo top argv envp auxv regs o. tr.callee_io(tm.MAL(G), 1) -> tm.mcall(pw.I, pw.O, pw.EO, pw.PB, pw.PC, pw.PS, tm.MAL(G)) ->
  tr.callee_io(tm.FRE(NF), 1) -> tm.fcall(pw.I, pw.O, pw.EO, pw.PB, pw.PC, pw.PS, tm.FRE(NF)) ->
  ui.SX(m0, s, lo, top, argv, envp, auxv) -> tr.eok(false, false, s, seq_one(m0.gpr[4])) -> abi.code_at(s.vm, 4198400, text.code) ->
  pw.W0(s, m0, top) in abi.World -> pw.W0(s, m0, top) in univ(1) -> ui.c_pre(ui.wvm(s.vm), abi.wob(pw.OBJ(m0, top), abi.cball), ui.G, ui.P, m0.gpr[4]) ->
  regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> ord_le(1, seq_len(regs)) -> pw.R0(regs) = m0.gpr[4] ->
  runs(tm.STC(G, NF)[regs], pw.W0(s, m0, top), o) -> pw.END(o)
proof
  fix G NF m0 s lo top argv envp auxv regs o
  assume hmio hmc hfio hfc hx heo hca hw0 hu0 hcp hr hl h1 h0 h
  let W0 := pw.W0(s, m0, top)
  let OBJ := pw.OBJ(m0, top)
  let p := m0.gpr[4]
  let M := tr.as_su(tm.LOWC(G, NF))
  let EX := lwh.EXW
  let SW := startup_specs.start_writes(ui.G)
  have wv: W0.vm = ui.wvm(s.vm) by rsimp()
  have wo: W0.objs = abi.wob(OBJ, abi.cball) by rsimp()
  have cp: ui.c_pre(W0.vm, W0.objs, ui.G, ui.P, p) by simp(wv, wo, hcp, keep(startup_specs.start_main_pre, gimple.usable, gimple.bytes_at))
  have cp1 cp2 cp3 cp4 := cp
  have wcv: gimple.bytes_at(W0.vm, p, 8) = gimple.bytes_at(ui.wvm(s.vm), p, 8) by simp(wv)
  have sm1 sm2 sm3 sm4 sm5 sm6 := expand(cp4, startup_specs.start_main_pre)
  have g0 := apply(x86i.rsp_typed, (m0 in x86_64_linux.Machine by taut(expand(expand(hx, ui.SX), ui.ctx))))
  have wc0 wc1 := apply(g.bytes_bound, {W0.vm}, {p}, {8}, (W0.vm.bytes in fn_space(bits(64), bits(8)) by simp(apply(ms.world_parts, hw0))), simp())
  have g1 g2 g3 g4 g5 g6 g7 g8 g9 g10 g11 := (lk.gok(ui.G) by taut(ui.gp_ok))
  have icalls := apply(lk.libc_calls, {ui.G}, g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, g11)
  have f1 f2 f3 f4 f5 := ui.g_facts
  have el8: bits_add(64, ui.G.libc, 8) = int_add(ui.G.libc, 8) by eval()
  // _start_c's call of __libc_start_main: its arguments, then its run
  have hL: all regs2 o2. gc.regs_ok(regs2, pw.A6(W0, pw.R0(regs))) -> runs(lwh.LSM(M, EX)[regs2], W0, o2) -> pw.END(o2) proof
    fix regs2 o2
    assume hro hr2
    let A6 := pw.A6(W0, pw.R0(regs))
    have rl rln _ := hro
    have rn: seq_len(regs2) = 6 := trans(rln, (seq_len(A6) = 6 by simp()))
    have q0 := apply(gc.reg_at[regs := regs2, args := A6, i := 0, w := 64, x := c_crt_crt1.main_at], hro, simp(), simp(rn), at({A6[0]}), simp(), eval())
    have q1 := apply(gc.reg_at[regs := regs2, args := A6, i := 1, w := 32, x := pw.WC(W0, pw.R0(regs))], hro, simp(), simp(rn), at({A6[1]}), simp(),
      (pw.WC(W0, pw.R0(regs)) in bits(32) by arith(h0, wc0, wc1, sm1)))
    have q2 := apply(gc.reg_at[regs := regs2, args := A6, i := 2, w := 64, x := bits_add(64, pw.R0(regs), 8)], hro, simp(), simp(rn), at({A6[2]}), simp(), simp())
    have r1: pw.R1(regs2) = gimple.bytes_at(W0.vm, p, 8) := rewrite(h0, q1)
    have r2: pw.R2(regs2) = bits_add(64, p, 8) := rewrite(h0, q2)
    have smp: startup_specs.start_main_pre(W0.vm, W0.objs, ui.G, ui.P, pw.R1(regs2), pw.R2(regs2)) := rewrite(sym(r1), rewrite(sym(r2), cp4))
    // (startup's effect: possible -- the thread, libc.auxv past envp)
    let E := pw.ENVB(pw.R1(regs2), pw.R2(regs2))
    have il := rewrite(sym(r1), rewrite(sym(r2), sm5))
    obtain n0 L0, hn0 _ hbig from expand(il, startup_specs.init_libc_pre)
    have hen _ _ hgl .. := hbig
    have eb: E in bits(64) by simp()
    have ex0 := apply(ui.main_exists[g := ui.G, t := W0, E := E, n := n0], hw0, f1, f2, f3, f4, f5, hgl, hn0, hen, eb)
    have exV: ex V. sp.TMV(ui.G, E, W0, V) by simp(el8, ex0)
    // stage2's call: main's precondition there
    have hS2: all V fs regs3 o3. sp.TMV(ui.G, E, W0, V) -> fs in bits(64) -> startup_specs.thread_at(ui.G, V, fs) ->
        gc.regs_ok(regs3, pw.A3(pw.R0(regs2), pw.R1(regs2), pw.R2(regs2))) ->
        runs(lwh.FP(4200677, lwh.S2(M, EX))[c_src_env___libc_start_main.libc_start_main_stage2_at][regs3], pw.W1(W0, V, fs), o3) -> pw.END(o3) proof
      fix V fs regs3 o3
      assume htm hfb hth hro3 hr3
      let W1 := pw.W1(W0, V, fs)
      let A3 := pw.A3(pw.R0(regs2), pw.R1(regs2), pw.R2(regs2))
      have hv tf te _ := htm
      have fe: lwh.FP(4200677, lwh.S2(M, EX))[c_src_env___libc_start_main.libc_start_main_stage2_at] = lwh.S2(M, EX)
        by simp((c_src_env___libc_start_main.libc_start_main_stage2_at = 4200677 by eval()))
      have rl3 rln3 _ := hro3
      have rn3: seq_len(regs3) = 3 := trans(rln3, (seq_len(A3) = 3 by simp()))
      have p0 := apply(gc.reg_at[regs := regs3, args := A3, i := 0, w := 64, x := pw.R0(regs2)], hro3, simp(), simp(rn3), at({A3[0]}), simp(), simp())
      have p1 := apply(gc.reg_at[regs := regs3, args := A3, i := 1, w := 32, x := pw.R1(regs2)], hro3, simp(), simp(rn3), at({A3[1]}), simp(), simp())
      have p2 := apply(gc.reg_at[regs := regs3, args := A3, i := 2, w := 64, x := pw.R2(regs2)], hro3, simp(), simp(rn3), at({A3[2]}), simp(), simp())
      have m0e: pw.R0(regs3) = ui.P.main by simp(p0, q0)
      have m31: int_lt(pw.R1(regs3), int_pow(2, 31)) by arith(p1, r1, sm1)
      have m63: int_lt(pw.ENV(pw.R1(regs3), pw.R2(regs3)), int_pow(2, 63)) by arith(p1, p2, r1, r2, sm3)
      have hu0b: W0 in univ(1) := hu0
      have w1aW w1au := apply(mp.am_world[s := W0, V := V], hw0, hu0b, hv)
      have w1W w1u := apply(sp.world_fs[s := fn_update(W0, "vm", V), f := fs], w1aW, w1au, hfb)
      // (the constructors: kept by startup's frame)
      have ck := apply(sp.ctors_keep[b := W0.vm, U := V, objs := W0.objs, P := ui.P, W := SW], eval(), sm6, tf)
      have ck1: startup_specs.ctors_ok(W1.vm, W1.objs, ui.P, set_select(omega, x2. false)) by simp(ck)
      // (main entered at pw.MM: startup's effect from s)
      have tfs := rewrite(wv, rewrite(wo, tf))
      have p8: bits_add(64, p, 8) = int_add(p, 8) by defs(arith(g0, cp2), bits_add, bits_of_int, pow2)
      have ce: int_lt(int_add(p, int_mul(8, int_add(gimple.bytes_at(ui.wvm(s.vm), p, 8), 2))), 18446744073709551616) by arith(sm3, wc0, wcv, p8)
      have ee := apply(pw.env_eq, {p}, {gimple.bytes_at(ui.wvm(s.vm), p, 8)}, g0, rewrite(wcv, wc0), ce)
      have r1v: pw.R1(regs2) = gimple.bytes_at(ui.wvm(s.vm), p, 8) := trans(r1, wcv)
      have Ee: E = bits_add(64, p, int_mul(8, int_add(gimple.bytes_at(ui.wvm(s.vm), p, 8), 2))) := trans(rewrite(r1v, rewrite(r2, refl({E}), {2}), {2}), ee)
      have te2: all x4. x4 in omega -> startup_specs.env_at(ui.wvm(s.vm), abi.wob(OBJ, abi.cball), bits_add(64, p, int_mul(8, int_add(gimple.bytes_at(ui.wvm(s.vm), p, 8), 2))), x4) ->
          gimple.bytes_at(V, int_add(ui.G.libc, 8), 8) = int_add(bits_add(64, p, int_mul(8, int_add(gimple.bytes_at(ui.wvm(s.vm), p, 8), 2))), int_mul(8, int_add(x4, 1))) proof
        fix x4
        assume hx4 he4
        have e4 := rewrite(sym(wo), rewrite(sym(wv), rewrite(sym(Ee), he4)))
        have q := mp(all_elim(te, {x4}), hx4, e4)
        show := rewrite(el8, rewrite(Ee, q))
      qed
      have hat := apply(pw.at_main, {s}, {OBJ}, {p}, {V}, {fs}, hv, tfs, te2, hfb, hth)
      have hmr := apply(pw.mr_w1[m0 := m0, s := s, lo := lo, top := top, argv := argv, envp := envp, auxv := auxv, V := V, fs := fs, W := W1], hx, hat, heo, hca,
        w1W, w1u, simp(), simp(), (W1.objs.live = OBJ by simp(wo)))
      show := apply(pw.s2_main, {G}, {NF}, {regs3}, {W1}, {o3}, hmio, hmc, hfio, hfc, rl3, arith(rn3), (ord_le(3, seq_len(regs3)) by defs(simp(rn3), ord_le)),
        w1W, w1u, m0e, m31, m63, ck1, hmr, rewrite(fe, hr3))
    qed
    show := apply(pw.lsm_fun, {ui.G}, {ui.P}, {ilcl.F}, {lwh.FP(4200677, lwh.S2(M, EX))}, {regs2}, {W0}, {o2}, rl, arith(rn), (ord_le(6, seq_len(regs2)) by defs(simp(rn), ord_le)),
      hw0, smp, icalls, exV, hS2, hr2)
  qed
  show := apply(pw.stc_fun, {lwh.LSM(M, EX)}, {regs}, {W0}, {o}, hr, hl, h1, hw0, rewrite(sym(h0), cp1), rewrite(sym(h0), cp2), (gimple.usable(W0.vm, W0.objs, pw.R0(regs), 8, false) by simp(h0, cp3, keep(gimple.usable))),
    (int_lt(pw.WC(W0, pw.R0(regs)), int_pow(2, 31)) by arith(h0, sm1)), hL, h)
qed
