// The test program's helpers by their purpose (layers/test_malloc.sl):
// pat(i, j) block i's j-th pattern byte, size(i) its size, fill(b, i)
// writes the pattern, intact(b, i) checks it.

// ----------------------------------------------------------------------
//  Arithmetic

// (multiplying by 31, by 40: GIMPLE's signed product's low half, the
// unsigned one)
theorem tp.imul_31: tr.imul_by(31)
proof
  have g: all y. y in bits(32) -> bits_add(32, int_mul(sint(32, y), sint(32, 31)), 0) = bits_mul(32, y, 31) proof
    fix y
    assume hy
    have c1: int_lt(y, 2147483648) -> bits_add(32, int_mul(sint(32, y), 31), 0) = bits_mul(32, y, 31) proof
      assume hl
      show by defs(simp(hy, hl), bits_add, bits_mul, sint)
    qed
    have c2: !int_lt(y, 2147483648) -> bits_add(32, int_mul(sint(32, y), 31), 0) = bits_mul(32, y, 31) proof
      assume hl
      have e: int_mod(int_mul(int_sub(y, 4294967296), 31), 4294967296) = int_mod(int_mul(y, 31), 4294967296) by arith(hy)
      show by defs(simp(hy, hl, e), bits_add, bits_mul, sint)
    qed
    have e: bits_add(32, int_mul(sint(32, y), 31), 0) = bits_mul(32, y, 31) by taut(c1, c2)
    show by simp(e)
  qed
  show by defs(g, tr.imul_by)
qed

theorem tp.imul_40: tr.imul_by(40)
proof
  have g: all y. y in bits(32) -> bits_add(32, int_mul(sint(32, y), sint(32, 40)), 0) = bits_mul(32, y, 40) proof
    fix y
    assume hy
    have c1: int_lt(y, 2147483648) -> bits_add(32, int_mul(sint(32, y), 40), 0) = bits_mul(32, y, 40) proof
      assume hl
      show by defs(simp(hy, hl), bits_add, bits_mul, sint)
    qed
    have c2: !int_lt(y, 2147483648) -> bits_add(32, int_mul(sint(32, y), 40), 0) = bits_mul(32, y, 40) proof
      assume hl
      have e: int_mod(int_mul(int_sub(y, 4294967296), 40), 4294967296) = int_mod(int_mul(y, 40), 4294967296) by arith(hy)
      show by defs(simp(hy, hl, e), bits_add, bits_mul, sint)
    qed
    have e: bits_add(32, int_mul(sint(32, y), 40), 0) = bits_mul(32, y, 40) by taut(c1, c2)
    show by simp(e)
  qed
  show by defs(g, tr.imul_by)
qed

// (a dword's low byte: it mod 256)
theorem tp.low8: all y. y in bits(32) -> bits_and(32, y, 255) = int_mod(y, 256)
proof
  fix y
  assume hy
  have y0: y in omega by simp(hy)
  have p8: pow2(8) = 256 by simp()
  have m255: int_sub(pow2(8), 1) = 255 by simp()
  have mb: int_mod(y, pow2(8)) in bits(32) by arith(y0, p8)
  have e0: bits_and(32, bits_of_int(32, y), int_sub(pow2(8), 1)) = int_mod(y, pow2(8)) by bitwise({32}, y0, mb)
  have b32: bits_of_int(32, y) = y by defs(simp(hy), bits_of_int)
  show := rewrite(b32, rewrite(p8, rewrite(m255, e0)))
qed

// ----------------------------------------------------------------------
//  pat, size: their runs

theorem tp.pat_run: all i j s o. i in bits(32) -> j in bits(32) -> int_lt(i, test_malloc.NBLK) -> int_lt(j, test_malloc.size_of(test_malloc.NBLK)) ->
  s in univ(1) -> runs(c_tests_test_malloc.pat(i, j), s, o) -> o = ok(s, bits_of_int(32, test_malloc.pat_of(i, j)))
proof
  fix i j s o
  assume hi hj hil hjl hu hr
  have nb: test_malloc.NBLK = 8 by defs(refl({8}), test_malloc.NBLK)
  have i8: int_lt(i, 8) := rewrite(nb, hil)
  have j3: int_lt(j, 336) by defs(simp(rewrite(nb, hjl)), test_malloc.size_of)
  have si := mp(all_elim(ms.sint_small, {i}), simp(hi), arith(i8))
  have sj := mp(all_elim(ms.sint_small, {j}), simp(hj), arith(j3))
  have s31 := mp(all_elim(ms.sint_small, {31}), simp(), arith())
  have r1: int_le(0, int_mul(i, 31)) && int_lt(int_mul(i, 31), 2147483648) by arith(hi, i8)
  have f1: tr.s32_fits(int_mul(sint(32, i), sint(32, 31))) by defs(simp(si, s31, r1), gimple.fits)
  have d1 := apply(g.smul32_det, {s}, {i}, {31}, hu, hi, simp(), tp.imul_31, f1)
  let M := bits_mul(32, i, 31)
  have me: M = int_mul(i, 31) by defs(arith(hi, i8), bits_mul)
  have sm := mp(all_elim(ms.sint_small, {M}), (M in omega by simp(me, hi)), arith(me, hi, i8))
  have r2: int_le(0, int_add(j, int_mul(i, 31))) && int_lt(int_add(j, int_mul(i, 31)), 2147483648) by arith(hi, i8, hj, j3)
  have f2: tr.s32_fits(int_add(sint(32, j), sint(32, M))) by defs(simp(sj, sm, me, r2), gimple.fits)
  have d2 := apply(g.sadd32_det, {s}, {j}, {M}, hu, hj, simp(), f2)
  step x1, c1 from hr with d1
  step c2 from c1 with d2
  have ae: bits_add(32, j, M) = int_add(j, int_mul(i, 31)) by defs(arith(me, hi, i8, hj, j3), bits_add)
  have lo := mp(all_elim(tp.low8, {bits_add(32, j, M)}), simp())
  have pv: bits_and(32, bits_add(32, j, M), 255) = bits_of_int(32, test_malloc.pat_of(i, j))
    by defs(simp(lo, ae, r2), test_malloc.pat_of, bits_of_int)
  show by simp(c2, pv)
qed

theorem tp.size_run: all i s o. i in bits(32) -> int_lt(i, test_malloc.NBLK) -> s in univ(1) ->
  runs(c_tests_test_malloc.size(i), s, o) -> o = ok(s, bits_of_int(32, test_malloc.size_of(i)))
proof
  fix i s o
  assume hi hil hu hr
  have nb: test_malloc.NBLK = 8 by defs(refl({8}), test_malloc.NBLK)
  have i8: int_lt(i, 8) := rewrite(nb, hil)
  have si := mp(all_elim(ms.sint_small, {i}), simp(hi), arith(i8))
  have s40 := mp(all_elim(ms.sint_small, {40}), simp(), arith())
  have r1: int_le(0, int_mul(i, 40)) && int_lt(int_mul(i, 40), 2147483648) by arith(hi, i8)
  have f1: tr.s32_fits(int_mul(sint(32, i), sint(32, 40))) by defs(simp(si, s40, r1), gimple.fits)
  have d1 := apply(g.smul32_det, {s}, {i}, {40}, hu, hi, simp(), tp.imul_40, f1)
  let M := bits_mul(32, i, 40)
  have me: M = int_mul(i, 40) by defs(arith(hi, i8), bits_mul)
  have sm := mp(all_elim(ms.sint_small, {M}), (M in omega by simp(me, hi)), arith(me, hi, i8))
  have s16 := mp(all_elim(ms.sint_small, {16}), simp(), arith())
  have r2: int_le(0, int_add(int_mul(i, 40), 16)) && int_lt(int_add(int_mul(i, 40), 16), 2147483648) by arith(hi, i8)
  have f2: tr.s32_fits(int_add(sint(32, M), sint(32, 16))) by defs(simp(sm, s16, me, r2), gimple.fits)
  have d2 := apply(g.sadd32_det, {s}, {M}, {16}, hu, simp(), simp(), f2)
  step x1, c1 from hr with d1
  step c2 from c1 with d2
  have ae: bits_add(32, M, 16) = bits_of_int(32, test_malloc.size_of(i)) by defs(arith(me, hi, i8), bits_add, bits_of_int, test_malloc.size_of)
  show by simp(c2, ae)
qed

// pat's code by its purpose
theorem tp.pat: all i j. i in bits(32) -> j in bits(32) -> refines(c_tests_test_malloc.pat(i, j), test_malloc.pat_spec(i, j), abi.World)
proof
  fix i j
  assume hi hj
  show proof
    fix s o
    assume hw hr
    have pu := apply(g.runs_univ, expand(hr, c_tests_test_malloc.pat))
    have hu: s in univ(1) by simp(pu)
    let PRE := int_lt(i, test_malloc.NBLK) && int_lt(j, test_malloc.size_of(test_malloc.NBLK))
    have np: !PRE -> runs(test_malloc.pat_spec(i, j), s, o) proof
      assume hn
      show by defs(simp(pu, hn), test_malloc.pat_spec)
    qed
    have yp: PRE -> runs(test_malloc.pat_spec(i, j), s, o) proof
      assume hp
      have hil hjl := hp
      have e := mp(all_elim(tp.pat_run, {i}, {j}, {s}, {o}), hi, hj, hil, hjl, hu, hr)
      show by defs(simp(e, pu, hp, keep(abi.overflow)), test_malloc.pat_spec)
    qed
    show by taut(np, yp)
  qed
qed

// size's code by its purpose
theorem tp.size: all i. i in bits(32) -> refines(c_tests_test_malloc.size(i), test_malloc.size_spec(i), abi.World)
proof
  fix i
  assume hi
  show proof
    fix s o
    assume hw hr
    have pu := apply(g.runs_univ, expand(hr, c_tests_test_malloc.size))
    have hu: s in univ(1) by simp(pu)
    have np: !int_lt(i, test_malloc.NBLK) -> runs(test_malloc.size_spec(i), s, o) proof
      assume hn
      show by defs(simp(pu, hn), test_malloc.size_spec)
    qed
    have yp: int_lt(i, test_malloc.NBLK) -> runs(test_malloc.size_spec(i), s, o) proof
      assume hil
      have e := mp(all_elim(tp.size_run, {i}, {s}, {o}), hi, hil, hu, hr)
      show by defs(simp(e, pu, hil, keep(abi.overflow)), test_malloc.size_spec)
    qed
    show by taut(np, yp)
  qed
qed

// ----------------------------------------------------------------------
//  The CFG forms refine the structured ones; pat's and size's C function
//  values, divergence, machine code: tp.pat_fun, tp.pat_divw,
//  tp.pat_implements, .. (tp.size_..)

refines pat_ref c_tests_test_malloc_cfg.pat_fun c_tests_test_malloc.pat_fun
refines size_ref c_tests_test_malloc_cfg.size_fun c_tests_test_malloc.size_fun
refines intact_ref c_tests_test_malloc_cfg.intact_fun c_tests_test_malloc.intact_fun
refines fill_ref c_tests_test_malloc_cfg.fill_fun c_tests_test_malloc.fill_fun
refines main_ref c_tests_test_malloc_cfg.main_fun c_tests_test_malloc.main_fun

contract pat test_malloc.pat_spec_fun by tp.pat
contract size test_malloc.size_spec_fun by tp.size

// ----------------------------------------------------------------------
//  pat's and size's contracts at a call

// (as g.fun_q, for a spec's C function value: its result bound first)
theorem tp.fun_ql(x0. p, w, n, regs, s, o2, v): regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) -> ord_le(n, seq_len(regs)) -> s in abi.World ->
  (all o. runs(p(regs), s, o) -> abi.ovf_out(s, o) || o = ok(s, v)) ->
  (all o. runs(gimple.result(w, v), s, o) -> ex u. u in bits(64) && bits_of_int(w, u) = v && o = ok(s, u)) ->
  runs(fn_build(set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)), x0. mkprog(x1 x2. !ord_le(n, seq_len(x0)) || bind_rel(p(x0), x1, x3 x4. letin(x4, x5. bind_rel(gimple.result(w, x5), x3, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. x2 = ok(x6, pair(x8, x9)))),
    x6 x7. x2 = exc(x6, x7), x6. x2 = diverge(x6))), x3 x4. x2 = exc(x3, x4), x3. x2 = diverge(x3))))[regs], s, o2) ->
  abi.ovf_out(s, o2) ||
  (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && bits_of_int(w, fst(r)) = v && fst(r) in bits(64))
proof
  assume hr hn hw hp hres h
  let OVF := exc_val("stack_overflow", empty)
  rsimp only, app_fn_build, hr in h
  have pv pf pd pb := apply(ms.world_parts, hw)
  have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], pf, pd)
  have b := apply(g.runs_elim, h)
  have b2: bind_rel(p(regs), s, x3 x4. letin(x4, x5. bind_rel(gimple.result(w, x5), x3, x6 x7. letin(x7, x8. any_rel(x9. x9 in bits(64), x9. o2 = ok(x6, pair(x8, x9)))),
      x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))), x3 x4. o2 = exc(x3, x4), x3. o2 = diverge(x3)) by taut(b, hn)
  obtain o3, hs3 hk3 from expand(b2, bind_rel)
  have c1: abi.ovf_out(s, o3) ->
      abi.ovf_out(s, o2) || (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && bits_of_int(w, fst(r)) = v && fst(r) in bits(64)) proof
    assume e
    obtain vm ob, hv hob he from e
    have oe: o2 = exc(fn_update(fn_update(s, "vm", vm), "objs", ob), OVF) by simp(rewrite(he, hk3))
    have l: abi.ovf_out(s, o2) by ex_intro({vm}, {ob}, taut(hv, hob, oe))
    show by taut(l)
  qed
  have c2: o3 = ok(s, v) ->
      abi.ovf_out(s, o2) || (ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && bits_of_int(w, fst(r)) = v && fst(r) in bits(64)) proof
    assume he
    have k1: bind_rel(gimple.result(w, v), s, x6 x7. any_rel(x8. x8 in bits(64), x8. o2 = ok(x6, pair(x7, x8))), x6 x7. o2 = exc(x6, x7), x6. o2 = diverge(x6))
      by simp(expand(rewrite(he, hk3), letin), keep(bind_rel, gimple.result))
    obtain o4, hr4 hk4 from expand(k1, bind_rel)
    obtain u, hu64 hlow ho4 from mp(all_elim(hres, {o4}), hr4)
    have k2: any_rel(x8. x8 in bits(64), x8. o2 = ok(s, pair(u, x8))) by simp(rewrite(ho4, hk4), keep(any_rel))
    have ne: ex y. y in bits(64) by ex_intro({0}, simp())
    obtain y, hy hoy from apply(g.any_e, ne, k2)
    have cl: bits_of_int(w, fst(pair(u, y))) = v by simp(hlow)
    have fb: fst(pair(u, y)) in bits(64) by simp(hu64)
    have l: ex r. o2 = ok(fn_update(s, "vm", s.vm), r) && bits_of_int(w, fst(r)) = v && fst(r) in bits(64) by ex_intro({pair(u, y)}, taut(rewrite(sym(ss), hoy), cl, fb))
    show by taut(l)
  qed
  show by taut(mp(all_elim(hp, {o3}), hs3), c1, c2)
qed

// (the registers of a call with two 32-bit words a, b: their low halves)
theorem tp.regs2_32: all regs a b. a in bits(32) -> b in bits(32) -> gc.regs_ok(regs, seq_concat(seq_one(gimple.arg(32, a)), seq_one(gimple.arg(32, b)))) ->
  regs in list_type(bits(64)) && seq_len(regs) = 2 && bits_of_int(32, regs[0]) = a && bits_of_int(32, regs[1]) = b
proof
  fix regs a b
  assume ha hb h
  have r1 r2 r3 := h
  let L := seq_concat(seq_one(gimple.arg(32, a)), seq_one(gimple.arg(32, b)))
  have l2: seq_len(L) = 2 by simp()
  have p32: int_pow(2, 32) = 4294967296 by simp()
  have z0 := mp(all_elim(r3, {0}), simp(), (int_lt(0, seq_len(L)) by simp(l2)))
  have z1 := mp(all_elim(r3, {1}), simp(), (int_lt(1, seq_len(L)) by simp(l2)))
  have q0 := at({seq_concat(seq_one(gimple.arg(32, a)), seq_one(gimple.arg(32, b)))[0]})
  have q1 := at({seq_concat(seq_one(gimple.arg(32, a)), seq_one(gimple.arg(32, b)))[1]})
  have m0: int_mod(regs[0], 4294967296) = int_mod(a, 4294967296) by simp(expand(rewrite(q0, z0), gimple.in_reg, gimple.arg), p32)
  have m1: int_mod(regs[1], 4294967296) = int_mod(b, 4294967296) by simp(expand(rewrite(q1, z1), gimple.in_reg, gimple.arg), p32)
  have e0: bits_of_int(32, regs[0]) = a by defs(simp(m0, (int_mod(a, 4294967296) = a by arith(ha))), bits_of_int, pow2)
  have e1: bits_of_int(32, regs[1]) = b by defs(simp(m1, (int_mod(b, 4294967296) = b by arith(hb))), bits_of_int, pow2)
  show by taut(r1, trans(r2, l2), e0, e1)
qed

// size(i): block i's size, the world unchanged
theorem tp.size_q: all t i regs o2. t in abi.World -> i in bits(32) -> int_lt(i, test_malloc.NBLK) ->
  gc.regs_ok(regs, seq_one(gimple.arg(32, i))) -> runs(test_malloc.size_spec_fun()[regs], t, o2) ->
  abi.ovf_out(t, o2) ||
  (ex r. o2 = ok(fn_update(t, "vm", t.vm), r) && (bits_of_int(32, fst(r)) = bits_of_int(32, test_malloc.size_of(i)) && fst(r) in bits(64)))
proof
  fix t i regs o2
  assume hw hi hil hro h2
  have rl rn r0 := mp(all_elim(gc.regs1_32, {regs}, {i}), hi, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, (ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)), keep(ord_le))
  have o1: ord_le(1, seq_len(regs)) by defs(simp(rn), ord_le)
  let SV := bits_of_int(32, test_malloc.size_of(i))
  have pv _ _ _ := apply(ms.world_parts, hw)
  have pc: all o. runs(test_malloc.size_spec(bits_of_int(32, regs[0])), t, o) -> abi.ovf_out(t, o) || o = ok(t, SV) proof
    fix o
    assume hr
    have ci := apply(ct.contract_inv, expand(rewrite(r0, hr), test_malloc.size_spec), hil, pv)
    show by simp(ci)
  qed
  have res: all o. runs(gimple.result(32, SV), t, o) -> ex u. u in bits(64) && bits_of_int(32, u) = SV && o = ok(t, u) proof
    fix o
    assume hr
    show := mp(all_elim(g.result32_inv, {t}, {SV}, {o}), simp(), hr)
  qed
  have q := apply(tp.fun_ql[p := x0. test_malloc.size_spec(bits_of_int(32, x0[0])), w := 32, n := 1, regs := regs, s := t, o2 := o2, v := SV], ra, o1, hw, pc, res,
    expand(h2, test_malloc.size_spec_fun))
  have c: (ex r. o2 = ok(fn_update(t, "vm", t.vm), r) && bits_of_int(32, fst(r)) = SV && fst(r) in bits(64)) ->
      (ex r. o2 = ok(fn_update(t, "vm", t.vm), r) && (bits_of_int(32, fst(r)) = SV && fst(r) in bits(64))) proof
    assume e
    obtain r, e1 e2 e3 from e
    show by ex_intro({r}, taut(e1, e2, e3))
  qed
  show by taut(q, c)
qed

// pat(i, j): block i's j-th pattern byte, the world unchanged
theorem tp.pat_q: all t i j regs o2. t in abi.World -> i in bits(32) -> j in bits(32) -> int_lt(i, test_malloc.NBLK) -> int_lt(j, test_malloc.size_of(test_malloc.NBLK)) ->
  gc.regs_ok(regs, seq_concat(seq_one(gimple.arg(32, i)), seq_one(gimple.arg(32, j)))) -> runs(test_malloc.pat_spec_fun()[regs], t, o2) ->
  abi.ovf_out(t, o2) ||
  (ex r. o2 = ok(fn_update(t, "vm", t.vm), r) && (bits_of_int(32, fst(r)) = bits_of_int(32, test_malloc.pat_of(i, j)) && fst(r) in bits(64)))
proof
  fix t i j regs o2
  assume hw hi hj hil hjl hro h2
  have rl rn r0 r1 := mp(all_elim(tp.regs2_32, {regs}, {i}, {j}), hi, hj, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, (ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)), keep(ord_le))
  have o2l: ord_le(2, seq_len(regs)) by defs(simp(rn), ord_le)
  let PV := bits_of_int(32, test_malloc.pat_of(i, j))
  have pv _ _ _ := apply(ms.world_parts, hw)
  have pc: all o. runs(test_malloc.pat_spec(bits_of_int(32, regs[0]), bits_of_int(32, regs[1])), t, o) -> abi.ovf_out(t, o) || o = ok(t, PV) proof
    fix o
    assume hr
    have ci := apply(ct.contract_inv, expand(rewrite(r1, rewrite(r0, hr)), test_malloc.pat_spec), conj(hil, hjl), pv)
    show by simp(ci)
  qed
  have res: all o. runs(gimple.result(32, PV), t, o) -> ex u. u in bits(64) && bits_of_int(32, u) = PV && o = ok(t, u) proof
    fix o
    assume hr
    show := mp(all_elim(g.result32_inv, {t}, {PV}, {o}), simp(), hr)
  qed
  have q := apply(tp.fun_ql[p := x0. test_malloc.pat_spec(bits_of_int(32, x0[0]), bits_of_int(32, x0[1])), w := 32, n := 2, regs := regs, s := t, o2 := o2, v := PV], ra, o2l, hw, pc, res,
    expand(h2, test_malloc.pat_spec_fun))
  have c: (ex r. o2 = ok(fn_update(t, "vm", t.vm), r) && bits_of_int(32, fst(r)) = PV && fst(r) in bits(64)) ->
      (ex r. o2 = ok(fn_update(t, "vm", t.vm), r) && (bits_of_int(32, fst(r)) = PV && fst(r) in bits(64))) proof
    assume e
    obtain r, e1 e2 e3 from e
    show by ex_intro({r}, taut(e1, e2, e3))
  qed
  show by taut(q, c)
qed

// ----------------------------------------------------------------------
//  fill: its run

// (a callee g called as F)
abbrev tp.calls(g, F) := all regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> s in abi.World -> runs(g[regs], s, o) -> runs(F[regs], s, o)

// fill's loop: V the memory s0 with block i's first j pattern bytes written at b
abbrev tp.finv(s0, V, b, i, j) := V in x86_64_linux.Vm && fn_update(V, "bytes", s0.bytes) = s0 &&
  (all k. k in omega -> int_lt(k, j) -> gimple.bytes_at(V, bits_add(64, b, bits_of_int(64, k)), 1) = test_malloc.pat_of(i, k)) &&
  (all a. a in bits(64) -> !(int_le(b, a) && int_lt(a, int_add(b, j))) -> V.bytes[a] = s0.bytes[a])

// (the next pattern byte stored at b + j)
theorem tp.finv_step(s0, V, b, i, j, A, v): tp.finv(s0, V, b, i, j) -> b in bits(64) -> j in omega -> int_lt(int_add(b, j), 18446744073709551616) ->
  A = int_add(b, j) -> bits_of_int(8, v) = test_malloc.pat_of(i, j) ->
  tp.finv(s0, fn_update(V, "bytes", x86_64_linux.store_le(V.bytes, A, 1, v)), b, i, int_add(j, 1))
proof
  assume hf hb hj hl ha hv
  have vV e0 pf of := hf
  let V2 := fn_update(V, "bytes", x86_64_linux.store_le(V.bytes, A, 1, v))
  have v2V := mp(all_elim(ms.wr_any, {V}, {A}, {1}, {v}), vV)
  have bt: V.bytes in fn_space(bits(64), bits(8)) by simp(vV)
  have e2: fn_update(V2, "bytes", s0.bytes) = s0 := trans((fn_update(V2, "bytes", s0.bytes) = fn_update(V, "bytes", s0.bytes) by simp()), e0)
  have ab: A in bits(64) by arith(ha, hb, hj, hl)
  have p2: all k. k in omega -> int_lt(k, int_add(j, 1)) -> gimple.bytes_at(V2, bits_add(64, b, bits_of_int(64, k)), 1) = test_malloc.pat_of(i, k) proof
    fix k
    assume hk hkl
    have kb: bits_add(64, b, bits_of_int(64, k)) = int_add(b, k) by defs(arith(hb, hk, hkl, hl), bits_add, bits_of_int, pow2)
    have b2: V2.bytes in fn_space(bits(64), bits(8)) by simp(mp(all_elim(x86.store_typed, {V.bytes}, {A}, {1}, {v}), bt))
    have kb64: int_add(b, k) in bits(64) by arith(hb, hk, hkl, hl)
    have r2 := mp(all_elim(ms.bytes1, {V2}, {int_add(b, k)}), simp(b2), kb64)
    have g1 := subst({y. gimple.bytes_at(V2, bits_add(64, b, bits_of_int(64, k)), 1) = gimple.bytes_at(V2, y, 1)}, kb, refl({gimple.bytes_at(V2, bits_add(64, b, bits_of_int(64, k)), 1)}))
    have vb: V2.bytes = x86_64_linux.store_le(V.bytes, A, 1, v) by simp()
    have c1: k = j -> gimple.bytes_at(V2, bits_add(64, b, bits_of_int(64, k)), 1) = test_malloc.pat_of(i, k) proof
      assume e
      have st := apply(mp.st1_at[z := V.bytes, a := A, v := v], ab)
      have ak: A = int_add(b, k) by arith(ha, e)
      have st2 := rewrite(sym(vb), subst({y. x86_64_linux.store_le(V.bytes, A, 1, v)[y] = bits_of_int(8, v)}, ak, st))
      have hv2: bits_of_int(8, v) = test_malloc.pat_of(i, k) := rewrite(sym(e), hv)
      show := trans(g1, trans(r2, trans(st2, hv2)))
    qed
    have c2: !(k = j) -> gimple.bytes_at(V2, bits_add(64, b, bits_of_int(64, k)), 1) = test_malloc.pat_of(i, k) proof
      assume ne
      have kl: int_lt(k, j) by arith(hkl, ne)
      have so := apply(mp.st_out[B := V.bytes, c := A, k := 1, v := v, x := int_add(b, k)], kb64, ab, simp(), arith(ha, hl, hj),
        (int_le(int_add(A, 1), int_add(b, k)) || int_lt(int_add(b, k), A) by arith(ha, kl)))
      have r1 := mp(all_elim(ms.bytes1, {V}, {int_add(b, k)}), simp(bt), kb64)
      have pk := rewrite(kb, mp(all_elim(pf, {k}), hk, kl))
      have vk: V.bytes[int_add(b, k)] = test_malloc.pat_of(i, k) := trans(sym(r1), pk)
      show := trans(g1, trans(r2, trans(rewrite(sym(vb), so), vk)))
    qed
    show by taut(c1, c2)
  qed
  have o2: all a. a in bits(64) -> !(int_le(b, a) && int_lt(a, int_add(b, int_add(j, 1)))) -> V2.bytes[a] = s0.bytes[a] proof
    fix a
    assume ha2 hn
    have so := apply(mp.st_out[B := V.bytes, c := A, k := 1, v := v, x := a], ha2, ab, simp(), arith(ha, hl, hj),
      (int_le(int_add(A, 1), a) || int_lt(a, A) by arith(ha, hn)))
    have oo := mp(all_elim(of, {a}), ha2, (!(int_le(b, a) && int_lt(a, int_add(b, j))) by arith(hn)))
    show by simp(so, oo)
  qed
  show by taut(v2V, e2, p2, o2)
qed

// (the thread pointer sound after the writes: its word none of the block's)
theorem tp.th_fill(s0, V, b, i, j, fs): fs in bits(64) -> abi.thread_ok(s0, fs) -> tp.finv(s0, V, b, i, j) -> int_le(j, test_malloc.size_of(i)) ->
  b in bits(64) -> (all k. k in omega -> int_lt(k, test_malloc.size_of(i)) -> !(int_add(b, k) in malloc.range(fs, 8))) -> abi.thread_ok(V, fs)
proof
  assume hfb ht hf hjl hb hap
  have vV e0 _ of := hf
  have {fsl = fsl} := apply(mp.top_fsl, hfb, ht)
  have up2 := mp(app_update_other[f := V, k := "bytes", v := s0.bytes, x := "pages"], (!("pages" = "bytes") by simp()))
  have uvp: V.pages = s0.pages := sym(rewrite(e0, up2))
  have same: all x. x in omega -> int_lt(x, 8) -> V.bytes[bits_of_int(64, int_add(fs, x))] = s0.bytes[bits_of_int(64, int_add(fs, x))] &&
      V.pages[int_div(int_add(fs, x), x86_64_linux.PAGE)] = s0.pages[int_div(int_add(fs, x), x86_64_linux.PAGE)] proof
    fix x
    assume hx hxl
    have ea: bits_of_int(64, int_add(fs, x)) = int_add(fs, x) by defs(arith(hfb, hx, hxl, fsl), bits_of_int, pow2)
    have ab: int_add(fs, x) in bits(64) by arith(hfb, hx, hxl, fsl)
    have nb: !(int_le(b, int_add(fs, x)) && int_lt(int_add(fs, x), int_add(b, j))) proof
      assume w
      have w1 w2 := w
      let K := int_sub(int_add(fs, x), b)
      have ko: K in omega by arith(w1, hb, hfb, hx)
      have kl: int_lt(K, test_malloc.size_of(i)) by arith(w2, hjl)
      have inr: int_add(b, K) in malloc.range(fs, 8) by defs(sel(arith(hfb, hx, hxl, hb)), malloc.range)
      show by taut(mp(all_elim(hap, {K}), ko, kl), inr)
    qed
    have oo := mp(all_elim(of, {int_add(fs, x)}), ab, nb)
    show by taut(rewrite(sym(ea), oo), (V.pages[int_div(int_add(fs, x), x86_64_linux.PAGE)] = s0.pages[int_div(int_add(fs, x), x86_64_linux.PAGE)] by simp(uvp)))
  qed
  show := apply(mp.th_same[V0 := s0, V1 := V, fs := fs], hfb, ht, same)
qed

theorem tp.fill_run: all b i gp gs s o. b in bits(64) -> i in bits(32) -> int_lt(i, test_malloc.NBLK) -> s in abi.World -> s in univ(1) ->
  abi.thread_ok(s.vm, s.fs_base) -> test_malloc.blk_usable(s.vm, s.objs, b, i, true) ->
  (all k. k in omega -> int_lt(k, test_malloc.size_of(i)) -> !(int_add(b, k) in malloc.range(s.fs_base, 8))) ->
  tp.calls(gp, test_malloc.pat_spec_fun()) -> tp.calls(gs, test_malloc.size_spec_fun()) ->
  runs(c_tests_test_malloc.fill(b, i, gp, gs), s, o) ->
  abi.ovf_out(s, o) || (ex V. tp.finv(s.vm, V, b, i, test_malloc.size_of(i)) && o = ok(fn_update(s, "vm", V), empty))
proof
  fix b i gp gs s o
  assume hb hi hil hw hu hth hus hap hgp hgs hr
  let SZ := test_malloc.size_of(i)
  let OVF := exc_val("stack_overflow", empty)
  have fsb: s.fs_base in bits(64) by simp(expand(hw, abi.World))
  step j0, h1 from hr
  obtain r, wl kr from h1
  let BODY(x, y) := loop_body(wl)
  let W(V) := fn_update(s, "vm", V)
  let G3(j, V, y) := (int_lt(j, SZ) && (ex V2. tp.finv(s.vm, V2, b, i, int_add(j, 1)) && y = ok(pair(W(V2), int_add(j, 1)), empty))) ||
    (j = SZ && y = exc(pair(W(V), j), pair("brk", empty))) ||
    (ex v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && y = exc(pair(fn_update(W(v), "objs", ob), j), pair("raise", OVF)))
  have trip: all j V y. j in omega -> int_le(j, SZ) -> tp.finv(s.vm, V, b, i, j) -> BODY(pair(W(V), j), y) -> G3(j, V, y) proof
    fix j V y
    assume hj hjl hf hbd
    have vV e0 _ _ := hf
    have wW wu := apply(mp.am_world, hw, hu, vV)
    have th := apply(tp.th_fill[s0 := s.vm, V := V, b := b, i := i, j := j, fs := s.fs_base], fsb, hth, hf, hjl, hb, hap)
    have thW: abi.thread_ok(W(V).vm, W(V).fs_base) by simp(th)
    step r1, e1 hr1 from hbd with tp.size_q using hgs, wW, wu, thW, hi, hil
    have hz _ := hr1
    have ww: fn_update(fn_update(s, "vm", V), "vm", app(fn_update(s, "vm", V), "vm")) = fn_update(s, "vm", V) by simp()
    have e2 := rewrite(ww, rewrite(hz, e1))
    have nb: test_malloc.NBLK = 8 by defs(refl({8}), test_malloc.NBLK)
    have i8: int_lt(i, 8) := rewrite(nb, hil)
    have szl: int_le(SZ, 296) by defs(arith(i8, hi), test_malloc.size_of)
    have sz0: int_le(0, SZ) by defs(arith(hi), test_malloc.size_of)
    have szo: SZ in omega by defs(arith(hi), test_malloc.size_of)
    have p32: int_pow(2, 32) = 4294967296 by simp()
    have bS: bits_of_int(32, SZ) = SZ by defs(arith(szl, sz0, szo, p32), bits_of_int, pow2)
    have sS: sint(32, bits_of_int(32, SZ)) = SZ := rewrite(sym(bS), mp(all_elim(ms.sint_small, {SZ}), szo, arith(szl)))
    have sj: sint(32, j) = j := mp(all_elim(ms.sint_small, {j}), hj, arith(hjl, szl))
    have cA: j = SZ -> G3(j, V, y) proof
      assume e
      have ca: int_le(sint(32, bits_of_int(32, SZ)), sint(32, j)) by simp(sS, sj, e)
      step eA from e2 with ca
      show by taut(e, eA)
    qed
    have cB: int_lt(j, SZ) -> G3(j, V, y) proof
      assume lt
      have cb: !int_le(sint(32, bits_of_int(32, SZ)), sint(32, j)) by simp(sS, sj, (!int_le(SZ, j) by arith(lt)))
      have jb: j in bits(32) by arith(hj, hjl, szl)
      have jl: int_lt(j, test_malloc.size_of(test_malloc.NBLK)) by defs(arith(hjl, szl, nb), test_malloc.size_of)
      step q2 r2, e3 hr2 from e2 with cb, tp.pat_q using hgp, wW, wu, thW, hi, jb, hil, jl
      have hz2 _ := hr2
      // (the pattern byte: below 256)
      let PT := test_malloc.pat_of(i, j)
      have pto: PT in omega by defs(arith(hi, hj), test_malloc.pat_of)
      have ptl: int_lt(PT, 256) by defs(arith(hi, hj), test_malloc.pat_of)
      have pb32: bits_of_int(32, PT) = PT by defs(arith(pto, ptl, p32), bits_of_int, pow2)
      have p8: bits_of_int(8, PT) = PT by defs(arith(pto, ptl), bits_of_int, pow2)
      have e4 := rewrite(p8, rewrite(pb32, rewrite(hz2, rewrite(ww, e3))))
      // (b + j: the byte's address)
      let T64 := fn_update(fn_update(empty, "prec", 64), "signed", true)
      have xb _ sv _ _ := mp(all_elim(tr.sext_vals, {j}), jb)
      have sx: gimple.sval(T64, bits_sext(32, 64, j)) = j := trans(sv, sj)
      have bu1 bu2 bu3 := expand(hus, test_malloc.blk_usable)
      have bjl: int_lt(int_add(b, j), 18446744073709551616) by arith(bu2, lt, szl)
      have pd := apply(g.padd_det, {W(V)}, {b}, {bits_sext(32, 64, j)}, wu, hb, xb,
        (int_le(0, int_add(b, gimple.sval(T64, bits_sext(32, 64, j)))) by arith(sx, hb, hj)),
        (int_lt(int_add(b, gimple.sval(T64, bits_sext(32, 64, j))), pow2(64)) by defs(arith(sx, bjl), pow2)))
      let A := int_add(b, gimple.sval(T64, bits_sext(32, 64, j)))
      have ae: A = int_add(b, j) by simp(sx)
      have ab: A in bits(64) by arith(ae, hb, hj, bjl)
      have z0: int_add(A, 0) = int_add(b, j) by arith(ae)
      have uj := mp(all_elim(bu3, {j}), hj, lt)
      have uV := apply(mp.usable_bytes[v := s.vm, v2 := V, objs := s.objs, a := int_add(b, j), n := 1, w := true], e0, uj)
      have md: g.mem_defined(W(V), A, 0, 1, true) by simp(z0, uV, (!(A = 0) by arith(ae, bu1, hb, hj)), (int_lt(int_add(b, j), pow2(64)) by defs(arith(bjl), pow2)))
      have sd := mp(all_elim(ms.st8_det, {W(V)}, {A}, {0}, {PT}), wW, wu, ab, simp(), md)
      let V2 := fn_update(V, "bytes", x86_64_linux.store_le(V.bytes, int_add(A, 0), 1, PT))
      have v2V := mp(all_elim(ms.wr_any, {V}, {int_add(A, 0)}, {1}, {PT}), vV)
      have w2W w2u := apply(mp.am_world, hw, hu, v2V)
      have ew: fn_update(W(V), "vm", fn_update(W(V).vm, "bytes", x86_64_linux.store_le(W(V).vm.bytes, int_add(A, 0), 1, PT))) = W(V2) by simp()
      have s1 := mp(all_elim(ms.sint_small, {1}), simp(), arith())
      have fj: tr.s32_fits(int_add(sint(32, j), sint(32, 1))) by defs(simp(sj, s1, (int_lt(int_add(j, 1), 2147483648) by arith(lt, szl)), (int_le(0, j) by arith(hj))), gimple.fits)
      have ad := apply(g.sadd32_det, {W(V2)}, {j}, {1}, w2u, jb, simp(), fj)
      step e5 from e4 with pd, sd, ew, ad
      have j1: bits_add(32, j, 1) = int_add(j, 1) by defs(arith(lt, szl, hj, p32), bits_add, pow2)
      have fi := apply(tp.finv_step[s0 := s.vm, V := V, b := b, i := i, j := j, A := int_add(A, 0), v := PT], hf, hb, hj, bjl, z0, p8)
      have k1: ex V3. tp.finv(s.vm, V3, b, i, int_add(j, 1)) && y = ok(pair(W(V3), int_add(j, 1)), empty)
        by ex_intro({V2}, taut(fi, rewrite(j1, e5)))
      show by taut(lt, k1)
    qed
    show by taut(cA, cB, (j = SZ || int_lt(j, SZ) by arith(hjl)))
  qed
  // the loop: j bytes written, j up to SZ
  let PI(x) := ex j V. ((j in omega && int_le(j, SZ)) && tp.finv(s.vm, V, b, i, j)) && x = pair(W(V), j)
  let M(x) := int_sub(SZ, snd(x))
  have pv pf pd pbt := apply(ms.world_parts, hw)
  have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], pf, pd)
  have vb0: fn_update(s.vm, "bytes", s.vm.bytes) = s.vm by simp(pv)
  have szo: SZ in omega by defs(arith(hi), test_malloc.size_of)
  have f0: tp.finv(s.vm, s.vm, b, i, 0) proof
    have a1: all k. k in omega -> int_lt(k, 0) -> gimple.bytes_at(s.vm, bits_add(64, b, bits_of_int(64, k)), 1) = test_malloc.pat_of(i, k) proof
      fix k
      assume hk hkl
      show by arith(hk, hkl)
    qed
    have a2: all a. a in bits(64) -> !(int_le(b, a) && int_lt(a, int_add(b, 0))) -> s.vm.bytes[a] = s.vm.bytes[a] proof
      fix a
      assume _ _
      show := refl({s.vm.bytes[a]})
    qed
    show by taut(pv, vb0, a1, a2)
  qed
  have p0: PI(pair(s, 0)) by ex_intro({0}, {s.vm}, taut((0 in omega by simp()), (int_le(0, SZ) by arith(szo)), f0, (pair(s, 0) = pair(W(s.vm), 0) by simp(ss))))
  have pm: all x. PI(x) -> M(x) in omega proof
    fix x
    assume hp
    obtain j V, hj hjl _ _ _ _ hx from hp
    show by simp(hx, (int_sub(SZ, j) in omega by arith(hj, hjl)))
  qed
  have nx: all x x2. PI(x) -> BODY(x, ok(x2, empty)) -> PI(x2) && int_lt(M(x2), M(x)) proof
    fix x x2
    assume hp hbd
    obtain j V, hj hjl f1 f2 f3 f4 hx from hp
    have hf: tp.finv(s.vm, V, b, i, j) by taut(f1, f2, f3, f4)
    have t := mp(all_elim(trip, {j}, {V}, {ok(x2, empty)}), hj, hjl, hf, rewrite(hx, hbd))
    have nb: !(ok(x2, empty) = exc(pair(W(V), j), pair("brk", empty))) by defs(simp(), ok, exc)
    have no: !(ex v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && ok(x2, empty) = exc(pair(fn_update(W(v), "objs", ob), j), pair("raise", OVF))) proof
      assume e
      obtain v ob, _ _ he from e
      show by defs(simp(he), ok, exc)
    qed
    have lt ex2 := (int_lt(j, SZ) && (ex V2. tp.finv(s.vm, V2, b, i, int_add(j, 1)) && ok(x2, empty) = ok(pair(W(V2), int_add(j, 1)), empty)) by taut(t, nb, no))
    obtain V2, g1 g2 g3 g4 he2 from ex2
    have hf2: tp.finv(s.vm, V2, b, i, int_add(j, 1)) by taut(g1, g2, g3, g4)
    have xe: x2 = pair(W(V2), int_add(j, 1)) by simp(he2)
    have p2: PI(x2) by ex_intro({int_add(j, 1)}, {V2}, taut((int_add(j, 1) in omega by arith(hj)), (int_le(int_add(j, 1), SZ) by arith(lt)), hf2, xe))
    have m2: int_lt(M(x2), M(x)) by simp(xe, hx, (int_lt(int_sub(SZ, int_add(j, 1)), int_sub(SZ, j)) by arith(hj)))
    show by taut(p2, m2)
  qed
  have wv := apply(g.loop[b := x y. BODY(x, y), p := x. PI(x), m := x. M(x)], p0, pm, nx, wl)
  obtain x, hpl bb nk from wv
  obtain j V, hj hjl f1 f2 f3 f4 hx from hpl
  have hf: tp.finv(s.vm, V, b, i, j) by taut(f1, f2, f3, f4)
  have t := mp(all_elim(trip, {j}, {V}, {r}), hj, hjl, hf, rewrite(hx, bb))
  have c1: (int_lt(j, SZ) && (ex V2. tp.finv(s.vm, V2, b, i, int_add(j, 1)) && r = ok(pair(W(V2), int_add(j, 1)), empty))) -> false proof
    assume h
    have _ e := h
    obtain V2, _ _ _ _ he from e
    have io: is_ok(r) by defs(ex_intro({pair(W(V2), int_add(j, 1))}, {empty}, he), is_ok)
    show by taut(io, nk)
  qed
  have c2: j = SZ && r = exc(pair(W(V), j), pair("brk", empty)) ->
      abi.ovf_out(s, o) || (ex V3. tp.finv(s.vm, V3, b, i, SZ) && o = ok(fn_update(s, "vm", V3), empty)) proof
    assume h
    have ej er := h
    have oe: o = ok(W(V), empty) by simp(rewrite(er, kr))
    show by disj({2}, ex_intro({V}, taut(rewrite(ej, hf), oe)))
  qed
  have c3: (ex v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && r = exc(pair(fn_update(W(v), "objs", ob), j), pair("raise", OVF))) ->
      abi.ovf_out(s, o) || (ex V3. tp.finv(s.vm, V3, b, i, SZ) && o = ok(fn_update(s, "vm", V3), empty)) proof
    assume h
    obtain v ob, hv hob er from h
    have oe: o = exc(fn_update(fn_update(s, "vm", v), "objs", ob), OVF) by simp(rewrite(er, kr))
    show by disj({1}, ex_intro({v}, {ob}, taut(hv, hob, oe)))
  qed
  show by taut(t, c1, c2, c3)
qed

// ----------------------------------------------------------------------
//  fill by its purpose

// (the spec's runs: its requirement not met, anything; an overflow; the
// pattern written, nothing else)
theorem tp.fills_run(b, i, s, o): s in abi.World -> pair(s, o) in univ(1) ->
  (!(((int_lt(i, test_malloc.NBLK) && test_malloc.blk_usable(s.vm, s.objs, b, i, true)) && abi.thread_ok(s.vm, s.fs_base)) &&
     (all x2. x2 in omega -> int_lt(x2, test_malloc.size_of(i)) -> !(int_add(b, x2) in malloc.range(s.fs_base, 8)))) ||
   abi.ovf_out(s, o) || (ex V. tp.finv(s.vm, V, b, i, test_malloc.size_of(i)) && o = ok(fn_update(s, "vm", V), empty))) ->
  runs(test_malloc.fill_spec(b, i), s, o)
proof
  assume hw pu h
  let OVF := exc_val("stack_overflow", empty)
  let SZ := test_malloc.size_of(i)
  let PRE(x0) := ((int_lt(i, test_malloc.NBLK) && test_malloc.blk_usable(app(x0, "vm"), app(x0, "objs"), b, i, true)) && abi.thread_ok(app(x0, "vm"), app(x0, "fs_base"))) &&
    (all x2. x2 in omega -> int_lt(x2, SZ) -> !(int_add(b, x2) in malloc.range(app(x0, "fs_base"), 8)))
  let BR1(x0, x2) := bind_rel(abi.overflow, x0, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)), x3. x2 = diverge(x3))
  let BR2(x0, x2) := letin(app(x0, "vm"), x3. any_rel(x4. x4 in x86_64_linux.Vm && ((fn_update(app(fn_update(x0, "vm", x4), "vm"), "bytes", app(x3, "bytes")) = x3 &&
    test_malloc.has_pat(app(fn_update(x0, "vm", x4), "vm"), b, i)) && (all x5. x5 in bits(64) -> !(int_le(b, x5) && int_lt(x5, int_add(b, SZ))) ->
    app(app(app(fn_update(x0, "vm", x4), "vm"), "bytes"), x5) = app(app(x3, "bytes"), x5))), x4. letin(fn_update(x0, "vm", x4), x5. x2 = ok(pair(x5, empty), empty))))
  let DS(x2, x1) := (fst(x2) = 0 && x1 = ok(fst(out_state(x2)), empty)) || ((((fst(x2) = 1 && fst(out_value(x2)) = "ret") && x1 = ok(fst(out_state(x2)), snd(out_value(x2)))) ||
    ((fst(x2) = 1 && fst(out_value(x2)) = "raise") && x1 = exc(fst(out_state(x2)), snd(out_value(x2))))) || (fst(x2) = 2 && x1 = diverge(snd(x2))))
  let SB(x0, x1) := !PRE(x0) || (ex x2. (BR1(x0, x2) || BR2(x0, x2)) && DS(x2, x1))
  have g0: SB(s, o) proof
    have c1: !PRE(s) -> SB(s, o) proof
      assume hn
      show by taut(hn)
    qed
    have c2: abi.ovf_out(s, o) -> SB(s, o) proof
      assume e
      obtain v ob, hv hob ho from e
      let WO := fn_update(fn_update(s, "vm", v), "objs", ob)
      let X2 := exc(pair(WO, empty), pair("raise", OVF))
      have r1 := apply(ct.overflow_intro, {s}, {v}, {ob}, hv, hob, rewrite(ho, pu))
      have cx: ex x3 x4. exc(WO, OVF) = exc(x3, x4) && X2 = exc(pair(x3, empty), pair("raise", x4)) by ex_intro({WO}, {OVF}, taut(refl({exc(WO, OVF)}), refl({X2})))
      have b1: BR1(s, X2) by defs(ex_intro({exc(WO, OVF)}, taut(r1, cx)), bind_rel)
      have d1: DS(X2, o) by simp(ho)
      show by taut((ex x2. (BR1(s, x2) || BR2(s, x2)) && DS(x2, o) by ex_intro({X2}, taut(b1, d1))))
    qed
    have c3: (ex V. tp.finv(s.vm, V, b, i, SZ) && o = ok(fn_update(s, "vm", V), empty)) -> SB(s, o) proof
      assume e
      obtain V, hV he hp hfr ho from e
      let X2 := ok(pair(fn_update(s, "vm", V), empty), empty)
      have hpt: test_malloc.has_pat(V, b, i) by defs(hp, test_malloc.has_pat)
      have ev: ex x4. (x4 in x86_64_linux.Vm && ((fn_update(app(fn_update(s, "vm", x4), "vm"), "bytes", app(s.vm, "bytes")) = s.vm &&
          test_malloc.has_pat(app(fn_update(s, "vm", x4), "vm"), b, i)) && (all x5. x5 in bits(64) -> !(int_le(b, x5) && int_lt(x5, int_add(b, SZ))) ->
          app(app(app(fn_update(s, "vm", x4), "vm"), "bytes"), x5) = app(app(s.vm, "bytes"), x5)))) && letin(fn_update(s, "vm", x4), x5. X2 = ok(pair(x5, empty), empty))
        by ex_intro({V}, defs(simp(hV, he, hpt, hfr, keep(test_malloc.has_pat)), letin))
      have b2: BR2(s, X2) by defs(taut(expand(ev, any_rel, letin)), any_rel, letin)
      have d2: DS(X2, o) by simp(ho)
      show by taut((ex x2. (BR1(s, x2) || BR2(s, x2)) && DS(x2, o) by ex_intro({X2}, taut(b2, d2))))
    qed
    show by taut(h, c1, c2, c3)
  qed
  show by defs(apply(tr.runs_intro[r := x0 x1. SB(x0, x1)], {s}, {o}, pu, g0), test_malloc.fill_spec)
qed

// fill's code by its purpose, its callees by their contracts
theorem tp.fill: all b i gp gs. b in bits(64) -> i in bits(32) -> tp.calls(gp, test_malloc.pat_spec_fun()) -> tp.calls(gs, test_malloc.size_spec_fun()) ->
  refines(c_tests_test_malloc.fill(b, i, gp, gs), test_malloc.fill_spec(b, i), abi.World)
proof
  fix b i gp gs
  assume hb hi hgp hgs
  show proof
    fix s o
    assume hw hr
    have pu := apply(g.runs_univ, expand(hr, c_tests_test_malloc.fill))
    have hu: s in univ(1) by simp(pu)
    have c: ((int_lt(i, test_malloc.NBLK) && test_malloc.blk_usable(s.vm, s.objs, b, i, true)) && abi.thread_ok(s.vm, s.fs_base)) &&
        (all x2. x2 in omega -> int_lt(x2, test_malloc.size_of(i)) -> !(int_add(b, x2) in malloc.range(s.fs_base, 8))) ->
        abi.ovf_out(s, o) || (ex V. tp.finv(s.vm, V, b, i, test_malloc.size_of(i)) && o = ok(fn_update(s, "vm", V), empty)) proof
      assume hp
      have hil hus hth hap := hp
      show := mp(all_elim(tp.fill_run, {b}, {i}, {gp}, {gs}, {s}, {o}), hb, hi, hil, hw, hu, hth, hus, hap, hgp, hgs, hr)
    qed
    show := apply(tp.fills_run[b := b, i := i, s := s, o := o], hw, pu, taut(c))
  qed
qed

contract fill test_malloc.fill_spec_fun by tp.fill

// ----------------------------------------------------------------------
//  intact: its run

theorem tp.intact_run: all b i gp gs s o. b in bits(64) -> i in bits(32) -> int_lt(i, test_malloc.NBLK) -> s in abi.World -> s in univ(1) ->
  abi.thread_ok(s.vm, s.fs_base) -> test_malloc.blk_usable(s.vm, s.objs, b, i, false) ->
  tp.calls(gp, test_malloc.pat_spec_fun()) -> tp.calls(gs, test_malloc.size_spec_fun()) ->
  runs(c_tests_test_malloc.intact(b, i, gp, gs), s, o) ->
  abi.ovf_out(s, o) || (test_malloc.has_pat(s.vm, b, i) && o = ok(s, 1)) || (!test_malloc.has_pat(s.vm, b, i) && o = ok(s, 0))
proof
  fix b i gp gs s o
  assume hb hi hil hw hu hth hus hgp hgs hr
  step a0 a1 a2 a3, h1 from hr
  obtain r, wl kr from h1
  let BODY(x, y) := loop_body(wl)
  let SZ := test_malloc.size_of(i)
  let OVF := exc_val("stack_overflow", empty)
  let X(j, c1, c2, c3) := pair(s, pair(j, pair(c1, pair(c2, c3))))
  // (the first j bytes the pattern's)
  let PF(j) := all k. k in omega -> int_lt(k, j) -> gimple.bytes_at(s.vm, bits_add(64, b, bits_of_int(64, k)), 1) = test_malloc.pat_of(i, k)
  let BJ(j) := gimple.bytes_at(s.vm, bits_add(64, b, bits_of_int(64, j)), 1) = test_malloc.pat_of(i, j)
  let G3(j, c1, c2, c3, y) := (int_lt(j, SZ) && BJ(j) && y = ok(X(int_add(j, 1), c1, c2, c3), empty)) ||
    (j = SZ && y = exc(X(j, c1, c2, c3), pair("brk", empty))) ||
    (int_lt(j, SZ) && !BJ(j) && y = exc(X(j, c1, 0, 0), pair("ret", 0))) ||
    (ex v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && y = exc(pair(fn_update(fn_update(s, "vm", v), "objs", ob), pair(j, pair(c1, pair(c2, c3)))), pair("raise", OVF)))
  have pv pf pd pbt := apply(ms.world_parts, hw)
  have ss: fn_update(s, "vm", s.vm) = s := mp(fn_update_same[f := s, k := "vm"], pf, pd)
  have nb: test_malloc.NBLK = 8 by defs(refl({8}), test_malloc.NBLK)
  have i8: int_lt(i, 8) := rewrite(nb, hil)
  have szl: int_le(SZ, 296) by defs(arith(i8, hi), test_malloc.size_of)
  have szo: SZ in omega by defs(arith(hi), test_malloc.size_of)
  have p32: int_pow(2, 32) = 4294967296 by simp()
  have bS: bits_of_int(32, SZ) = SZ by defs(arith(szl, szo, p32), bits_of_int, pow2)
  have sS: sint(32, bits_of_int(32, SZ)) = SZ := rewrite(sym(bS), mp(all_elim(ms.sint_small, {SZ}), szo, arith(szl)))
  have trip: all j c1 c2 c3 y. j in omega -> int_le(j, SZ) -> BODY(X(j, c1, c2, c3), y) -> G3(j, c1, c2, c3, y) proof
    fix j c1 c2 c3 y
    assume hj hjl hbd
    step r1, e1 hr1 from hbd with tp.size_q using hgs, hw, hu, hth, hi, hil
    have hz _ := hr1
    have e2 := rewrite(ss, rewrite(hz, e1))
    have sj: sint(32, j) = j := mp(all_elim(ms.sint_small, {j}), hj, arith(hjl, szl))
    have cA: j = SZ -> G3(j, c1, c2, c3, y) proof
      assume e
      have ca: int_le(sint(32, bits_of_int(32, SZ)), sint(32, j)) by simp(sS, sj, e)
      step eA from e2 with ca
      show by taut(e, eA)
    qed
    have cB: int_lt(j, SZ) -> G3(j, c1, c2, c3, y) proof
      assume lt
      have cb: !int_le(sint(32, bits_of_int(32, SZ)), sint(32, j)) by simp(sS, sj, (!int_le(SZ, j) by arith(lt)))
      have jb: j in bits(32) by arith(hj, hjl, szl)
      have jl: int_lt(j, test_malloc.size_of(test_malloc.NBLK)) by defs(arith(hjl, szl, nb), test_malloc.size_of)
      let T64 := fn_update(fn_update(empty, "prec", 64), "signed", true)
      have xb _ sv _ _ := mp(all_elim(tr.sext_vals, {j}), jb)
      have sx: gimple.sval(T64, bits_sext(32, 64, j)) = j := trans(sv, sj)
      have bu1 bu2 bu3 := expand(hus, test_malloc.blk_usable)
      have bjl: int_lt(int_add(b, j), 18446744073709551616) by arith(bu2, lt, szl)
      have pd := apply(g.padd_det, {s}, {b}, {bits_sext(32, 64, j)}, hu, hb, xb,
        (int_le(0, int_add(b, gimple.sval(T64, bits_sext(32, 64, j)))) by arith(sx, hb, hj)),
        (int_lt(int_add(b, gimple.sval(T64, bits_sext(32, 64, j))), pow2(64)) by defs(arith(sx, bjl), pow2)))
      let A := int_add(b, gimple.sval(T64, bits_sext(32, 64, j)))
      have ae: A = int_add(b, j) by simp(sx)
      have ab: A in bits(64) by arith(ae, hb, hj, bjl)
      have z0: int_add(A, 0) = int_add(b, j) by arith(ae)
      have uj := mp(all_elim(bu3, {j}), hj, lt)
      have md: g.mem_defined(s, A, 0, 1, false) by simp(z0, uj, (!(A = 0) by arith(ae, bu1, hb, hj)), (int_lt(int_add(b, j), pow2(64)) by defs(arith(bjl), pow2)))
      have ld := mp(all_elim(g.ld8_det, {s}, {A}, {0}), hu, ab, simp(), md)
      step q2 r2, e3 hr2 from e2 with cb, pd, ld, tp.pat_q using hgp, hw, hu, hth, hi, jb, hil, jl
      have hz2 _ := hr2
      let PT := test_malloc.pat_of(i, j)
      have pto: PT in omega by defs(arith(hi, hj), test_malloc.pat_of)
      have ptl: int_lt(PT, 256) by defs(arith(hi, hj), test_malloc.pat_of)
      have pb32: bits_of_int(32, PT) = PT by defs(arith(pto, ptl, p32), bits_of_int, pow2)
      let BY := gimple.bytes_at(s.vm, int_add(b, j), 1)
      have byo byl := apply(g.bytes_bound, {s.vm}, {int_add(b, j)}, {1}, pbt, simp())
      have b8: bits_of_int(8, BY) = BY by defs(arith(byo, byl), bits_of_int, pow2)
      have e4 := rewrite(ss, rewrite(b8, rewrite(z0, rewrite(pb32, rewrite(hz2, e3)))))
      have kb: bits_add(64, b, bits_of_int(64, j)) = int_add(b, j) by defs(arith(hb, hj, bjl), bits_add, bits_of_int, pow2)
      have bj: BJ(j) <-> BY = PT by simp(kb)
      have cM: BY = PT -> G3(j, c1, c2, c3, y) proof
        assume e
        have s1 := mp(all_elim(ms.sint_small, {1}), simp(), arith())
        have fj: tr.s32_fits(int_add(sint(32, j), sint(32, 1))) by defs(simp(sj, s1, (int_lt(int_add(j, 1), 2147483648) by arith(lt, szl)), (int_le(0, j) by arith(hj))), gimple.fits)
        have ad := apply(g.sadd32_det, {s}, {j}, {1}, hu, jb, simp(), fj)
        step e5 from e4 with e, ad
        have j1: bits_add(32, j, 1) = int_add(j, 1) by defs(arith(lt, szl, hj, p32), bits_add, pow2)
        show by taut(lt, (BJ(j) by taut(bj, e)), rewrite(j1, e5))
      qed
      have cN: !(BY = PT) -> G3(j, c1, c2, c3, y) proof
        assume ne
        step e5 from e4 with ne
        show by taut(lt, (!BJ(j) by taut(bj, ne)), e5)
      qed
      show by taut(cM, cN)
    qed
    show by taut(cA, cB, (j = SZ || int_lt(j, SZ) by arith(hjl)))
  qed
  // the loop: the first j bytes the pattern's
  let PI(x) := ex j c1 c2 c3. ((j in omega && int_le(j, SZ)) && PF(j)) && x = X(j, c1, c2, c3)
  let M(x) := int_sub(SZ, fst(snd(x)))
  have pf0: PF(0) proof
    fix k
    assume hk hkl
    show by arith(hk, hkl)
  qed
  have p0: PI(X(0, a1, a2, a3)) by ex_intro({0}, {a1}, {a2}, {a3}, taut((0 in omega by simp()), (int_le(0, SZ) by arith(szo)), pf0, refl({X(0, a1, a2, a3)})))
  have pm: all x. PI(x) -> M(x) in omega proof
    fix x
    assume hp
    obtain j c1 c2 c3, hj hjl _ hx from hp
    show by simp(hx, (int_sub(SZ, j) in omega by arith(hj, hjl)))
  qed
  have nx: all x x2. PI(x) -> BODY(x, ok(x2, empty)) -> PI(x2) && int_lt(M(x2), M(x)) proof
    fix x x2
    assume hp hbd
    obtain j c1 c2 c3, hj hjl hpf hx from hp
    have t := mp(all_elim(trip, {j}, {c1}, {c2}, {c3}, {ok(x2, empty)}), hj, hjl, rewrite(hx, hbd))
    have n2: !(ok(x2, empty) = exc(X(j, c1, c2, c3), pair("brk", empty))) by defs(simp(), ok, exc)
    have n3: !(ok(x2, empty) = exc(X(j, c1, 0, 0), pair("ret", 0))) by defs(simp(), ok, exc)
    have n4: !(ex v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && ok(x2, empty) = exc(pair(fn_update(fn_update(s, "vm", v), "objs", ob), pair(j, pair(c1, pair(c2, c3)))), pair("raise", OVF))) proof
      assume e
      obtain v ob, _ _ he from e
      show by defs(simp(he), ok, exc)
    qed
    have lt hbj he := (int_lt(j, SZ) && BJ(j) && ok(x2, empty) = ok(X(int_add(j, 1), c1, c2, c3), empty) by taut(t, n2, n3, n4))
    have xe: x2 = X(int_add(j, 1), c1, c2, c3) by simp(he)
    have pf2: PF(int_add(j, 1)) proof
      fix k
      assume hk hkl
      have c1k: int_lt(k, j) -> gimple.bytes_at(s.vm, bits_add(64, b, bits_of_int(64, k)), 1) = test_malloc.pat_of(i, k) proof
        assume kl
        show := mp(all_elim(hpf, {k}), hk, kl)
      qed
      have c2k: k = j -> gimple.bytes_at(s.vm, bits_add(64, b, bits_of_int(64, k)), 1) = test_malloc.pat_of(i, k) proof
        assume e
        show := rewrite(sym(e), hbj)
      qed
      show by taut(c1k, c2k, (int_lt(k, j) || k = j by arith(hk, hkl)))
    qed
    have p2: PI(x2) by ex_intro({int_add(j, 1)}, {c1}, {c2}, {c3}, taut((int_add(j, 1) in omega by arith(hj)), (int_le(int_add(j, 1), SZ) by arith(lt)), pf2, xe))
    have m2: int_lt(M(x2), M(x)) by simp(xe, hx, (int_lt(int_sub(SZ, int_add(j, 1)), int_sub(SZ, j)) by arith(hj)))
    show by taut(p2, m2)
  qed
  have wv := apply(g.loop[b := x y. BODY(x, y), p := x. PI(x), m := x. M(x)], p0, pm, nx, wl)
  obtain x, hpl bb nk from wv
  obtain j c1 c2 c3, hj hjl hpf hx from hpl
  have t := mp(all_elim(trip, {j}, {c1}, {c2}, {c3}, {r}), hj, hjl, rewrite(hx, bb))
  let GOAL := abi.ovf_out(s, o) || (test_malloc.has_pat(s.vm, b, i) && o = ok(s, 1)) || (!test_malloc.has_pat(s.vm, b, i) && o = ok(s, 0))
  have k1: int_lt(j, SZ) && BJ(j) && r = ok(X(int_add(j, 1), c1, c2, c3), empty) -> GOAL proof
    assume h
    have _ _ e := h
    have io: is_ok(r) by defs(ex_intro({X(int_add(j, 1), c1, c2, c3)}, {empty}, e), is_ok)
    show by taut(io, nk)
  qed
  have k2: j = SZ && r = exc(X(j, c1, c2, c3), pair("brk", empty)) -> GOAL proof
    assume h
    have ej er := h
    have oe: o = ok(s, 1) by simp(rewrite(er, kr), keep(letin))
    have hp: test_malloc.has_pat(s.vm, b, i) by defs(rewrite(ej, hpf), test_malloc.has_pat)
    show by taut(hp, oe)
  qed
  have k3: int_lt(j, SZ) && !BJ(j) && r = exc(X(j, c1, 0, 0), pair("ret", 0)) -> GOAL proof
    assume h
    have lt nbj er := h
    have oe: o = ok(s, 0) by simp(rewrite(er, kr))
    have np: !test_malloc.has_pat(s.vm, b, i) proof
      assume hp
      show by taut(nbj, mp(all_elim(expand(hp, test_malloc.has_pat), {j}), hj, lt))
    qed
    show by taut(np, oe)
  qed
  have k4: (ex v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && r = exc(pair(fn_update(fn_update(s, "vm", v), "objs", ob), pair(j, pair(c1, pair(c2, c3)))), pair("raise", OVF))) -> GOAL proof
    assume h
    obtain v ob, hv hob er from h
    have oe: o = exc(fn_update(fn_update(s, "vm", v), "objs", ob), OVF) by simp(rewrite(er, kr))
    show by disj({1}, ex_intro({v}, {ob}, taut(hv, hob, oe)))
  qed
  show by taut(t, k1, k2, k3, k4)
qed
