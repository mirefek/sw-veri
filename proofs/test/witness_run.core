// The witness's run reaches main: its 1063 steps one at a time (run_steps:
// each instruction decoded and executed on the concrete state, its step a
// fact, rc.w_step; the stop at main, rc.w_stop; set_tid_address's thread id
// a picked witness) -- its own file for the cache.
theorem wit.run: ex m. runs(claim_malloc.run_until(musl_malloc.main_at), wit.m0, ok(m, empty))
proof
  have w: ex mf. rc.W(musl_malloc.main_at, wit.m0, mf) by run_steps(rc.w_stop, rc.w_step)
  obtain mf, hw from w
  have mu: wit.m0 in univ(1) by eval()
  show by ex_intro({mf}, apply(rc.w_runs, mu, hw))
qed
