// The whole run's startup path at GIMPLE level (docs/todo.md 1(d)): from
// _start_c's entry, every outcome an end -- a stack overflow, or an exit
// with 0 or 1. Each function's run by its callees' outcomes given as
// premises (main's and exit's, then stage2's, __libc_start_main's).

abbrev pw.OVF := exc_val("stack_overflow", empty)
abbrev pw.END(o) := (ex x. o = exc(x, pw.OVF)) || (ex x c. o = exc(x, exc_val("exit", c)) && (c = 0 || c = 1))

// (an end is no return, no divergence)
theorem pw.end_ok: all w v. !pw.END(ok(w, v))
proof
  fix w v
  have n: pw.END(ok(w, v)) -> false proof
    assume h
    have a1: (ex x. ok(w, v) = exc(x, pw.OVF)) -> false proof
      assume e
      obtain x, ex from e
      show by simp(ex)
    qed
    have a2: (ex x c. ok(w, v) = exc(x, exc_val("exit", c)) && (c = 0 || c = 1)) -> false proof
      assume e
      obtain x c, ex _ from e
      show by simp(ex)
    qed
    show by taut(h, a1, a2)
  qed
  show by taut(n)
qed

theorem pw.end_div: all t. !pw.END(diverge(t))
proof
  fix t
  have n: pw.END(diverge(t)) -> false proof
    assume h
    have a1: (ex x. diverge(t) = exc(x, pw.OVF)) -> false proof
      assume e
      obtain x, ex from e
      show by simp(ex)
    qed
    have a2: (ex x c. diverge(t) = exc(x, exc_val("exit", c)) && (c = 0 || c = 1)) -> false proof
      assume e
      obtain x c, ex _ from e
      show by simp(ex)
    qed
    show by taut(h, a1, a2)
  qed
  show by taut(n)
qed

// ----------------------------------------------------------------------
//  stage2: __libc_start_init (its spec), main (an end, or a return R
//  holds after), exit (an end from every such return)

abbrev pw.ENV(argc, argv) := int_add(argv, int_mul(8, int_add(argc, 1)))
abbrev pw.A2(argc, argv) := seq_concat(seq_concat(seq_one(gimple.arg(32, argc)), seq_one(gimple.arg(64, argv))), seq_one(gimple.arg(64, pw.ENV(argc, argv))))

theorem pw.s2_run(w u. R): all P main argc argv SI FP EX s o. s in abi.World -> main in bits(64) -> argc in bits(32) -> argv in bits(64) ->
  main = P.main -> int_lt(argc, int_pow(2, 31)) -> int_lt(pw.ENV(argc, argv), int_pow(2, 63)) ->
  startup_specs.ctors_ok(s.vm, s.objs, P, set_select(omega, x2. false)) ->
  mp.calls(SI, startup_specs.start_init_spec_fun(P)) ->
  (all regs o2. gc.regs_ok(regs, pw.A2(argc, argv)) -> runs(FP[main][regs], s, o2) -> pw.END(o2) || (ex w r. o2 = ok(w, r) && R(gc.back0(w, s), fst(r)))) ->
  (all w u regs o2. R(w, u) -> gc.regs_ok(regs, seq_one(gimple.arg(32, bits_of_int(32, u)))) -> runs(EX[regs], w, o2) -> pw.END(o2)) ->
  runs(c_src_env___libc_start_main.libc_start_main_stage2(main, argc, argv, SI, FP, EX), s, o) -> pw.END(o)
proof
  fix P main argc argv SI FP EX s o
  assume hw hmb hab hvb hm h31 hb63 hct hSI hM hX h
  have pu := apply(g.runs_univ, expand(h, c_src_env___libc_start_main.libc_start_main_stage2))
  have hu: s in univ(1) by simp(pu)
  let OVF := exc_val("stack_overflow", empty)
  let M := int_mul(8, int_add(argc, 1))
  let TY := fn_update(fn_update(empty, "prec", 64), "signed", true)
  have ao: argc in omega by simp(hab)
  have vo: argv in omega by simp(hvb)
  have m1: bits_of_int(32, argc) = argc by defs(arith(ao, h31), bits_of_int)
  have m2: bits_of_int(64, argc) = argc by defs(arith(ao, h31), bits_of_int)
  have p31: int_lt(argc, pow2(31)) by arith(h31)
  have eS: bits_sext(32, 64, argc) = argc by defs(simp(m1, m2, p31), bits_sext, sint, letin)
  have eA1: bits_add(64, argc, 1) = int_add(argc, 1) by defs(arith(ao, h31), bits_add)
  have eM: bits_mul(64, int_add(argc, 1), 8) = M by defs(arith(ao, h31), bits_mul)
  have p63: int_pow(2, int_sub(64, 1)) = 9223372036854775808 by simp()
  have nlt: !int_le(int_pow(2, int_sub(64, 1)), M) by arith(ao, h31, p63)
  have eV: gimple.sval(TY, M) = M by defs(simp(nlt), gimple.sval)
  have ml: int_lt(M, pow2(64)) by arith(ao, h31)
  have mb: M in bits(64) by defs(simp(ao, ml), bits)
  have pz: int_le(0, int_add(argv, gimple.sval(TY, M))) by arith(eV, ao, vo)
  have pl: int_lt(int_add(argv, gimple.sval(TY, M)), pow2(64)) by arith(eV, ao, vo, hb63)
  have b := apply(g.runs_elim, expand(h, c_src_env___libc_start_main.libc_start_main_stage2))
  step a1, h0 from b
  have h0r := rewrite(eM, rewrite(eA1, rewrite(eS, h0)))
  step h1 from h0r with g.padd_det using conj(hu, hvb, mb, pz, pl)
  have h1r := rewrite(eV, h1)
  let ENV := int_add(argv, M)
  have sv wf wd _ := apply(ms.world_parts, hw)
  have od: "objs" in dom(s) by simp(expand(hw, abi.World))
  // __libc_start_init called: an overflow, or nothing
  obtain oc, hrc hdc from apply(g.bind_open, h1r)
  let QS(o2) := sp.ovf_any(s, o2) || (ex v. o2 = ok(s, v))
  have rg0 := gc.regs0_ex
  have hqs: all regs o2. gc.regs_ok(regs, empty) -> runs(SI[regs], s, o2) -> QS(o2) proof
    fix regs o2
    assume hro hg
    have rl rn := apply(gc.regs0, hro)
    have l6: int_le(seq_len(regs), 6) by arith(rn)
    have ra := mp(sp.regs_in[regs := regs], rl, l6)
    have hs := mp(all_elim(hSI, {regs}, {s}, {o2}), rl, l6, hw, hg)
    have b2 := apply(sp.fun_out0[Q := a. startup_specs.start_init_spec(P)], {regs}, {s}, {o2}, ra, expand(hs, startup_specs.start_init_spec_fun))
    show := apply(sp.si_call, hw, hct, b2)
  qed
  have ci := apply(gc.call0_inv[Q := o2. QS(o2)], {SI}, {empty}, {s}, {oc}, rg0, hqs, hrc)
  have endo: all x. o = exc(x, OVF) -> pw.END(o) proof
    fix x
    assume e
    show by taut((ex x2. o = exc(x2, OVF) by ex_intro({x}, e)))
  qed
  have kA: oc = exc(s, OVF) -> pw.END(o) proof
    assume e
    have oe: o = exc(s, OVF) by simp(rewrite(e, hdc))
    show := mp(all_elim(endo, {s}), oe)
  qed
  have kC: (ex x e. QS(exc(x, e)) && oc = exc(x, e)) -> pw.END(o) proof
    assume q
    obtain x e, hq4 he from q
    have nk: !(ex v. exc(x, e) = ok(s, v)) by defs(simp(), ok, exc)
    have ov: sp.ovf_any(s, exc(x, e)) by taut(hq4, nk)
    obtain f v ob, _ _ _ oe0 from expand(ov, sp.ovf_any)
    have oe: o = exc(x, e) by simp(rewrite(he, hdc))
    have ee: e = OVF by simp(oe0)
    show := mp(all_elim(endo, {x}), rewrite(ee, oe))
  qed
  have kD: (ex t. QS(diverge(t)) && oc = diverge(t)) -> pw.END(o) proof
    assume q
    obtain t, hq4 _ from q
    have f: false by defs(simp(expand(hq4, sp.ovf_any)), ok, exc, diverge)
    show by taut(f)
  qed
  // ... nothing: main called at s
  have kB: (ex w4 r. QS(ok(w4, r)) && (oc = ok(gc.back0(w4, s), pair(fst(r), snd(r))) || oc = exc(gc.back0(w4, s), OVF))) -> pw.END(o) proof
    assume q
    obtain w4 r, hq4 ho4 from q
    have no: !sp.ovf_any(s, ok(w4, r)) by defs(simp(), sp.ovf_any, ok, exc)
    obtain v, e4 from (ex v. ok(w4, r) = ok(s, v) by taut(hq4, no))
    have w4e: w4 = s by simp(e4)
    have os := apply(gc.objs_same, hw)
    have bk: gc.back0(w4, s) = s by simp(w4e, os, wf, od)
    have k2: oc = exc(gc.back0(w4, s), OVF) -> pw.END(o) proof
      assume e
      show := mp(kA, rewrite(bk, e))
    qed
    have k1: oc = ok(gc.back0(w4, s), pair(fst(r), snd(r))) -> pw.END(o) proof
      assume e
      step h2 from rewrite(bk, rewrite(e, hdc))
      obtain oc2, hrc2 hdc2 from apply(g.bind_open, h2)
      obtain o3, r3 rel3 from apply(sp.call1_0_e, hrc2)
      have el: int_lt(ENV, pow2(64)) by arith(hb63, ao, vo)
      have eo: ENV in omega by simp(ao, vo)
      have envb: ENV in bits(64) by defs(simp(eo, el), bits)
      have rg2 := apply(gc.regs_get, apply(gc.regs_cat, apply(gc.regs_cat, apply(gc.regs_one[w := 32, x := argc], simp(), simp(), hab),
        apply(gc.regs_one[w := 64, x := argv], simp(), simp(), hvb)), apply(gc.regs_one[w := 64, x := ENV], simp(), simp(), envb)))
      let QM(o2) := pw.END(o2) || (ex w r. o2 = ok(w, r) && R(gc.back0(w, s), fst(r)))
      have hq2: all regs o2. gc.regs_ok(regs, pw.A2(argc, argv)) -> runs(FP[main][regs], s, o2) -> QM(o2) proof
        fix regs o2
        assume hro hg
        show := mp(all_elim(hM, {regs}, {o2}), hro, hg)
      qed
      have ci2 := apply(gc.call0_inv[Q := o2. QM(o2)], {FP[main]}, {pw.A2(argc, argv)}, {s}, {o3}, rg2, hq2, r3)
      // (the call's exception o3: o's)
      have ox: all X E. o3 = exc(X, E) -> o = exc(X, E) proof
        fix X E
        assume e3
        have e2: oc2 = exc(X, E) by simp(rewrite(e3, rel3))
        show by simp(rewrite(e2, hdc2))
      qed
      have m1: o3 = exc(s, OVF) -> pw.END(o) proof
        assume e3
        show := mp(all_elim(endo, {s}), mp(all_elim(ox, {s}, {OVF}), e3))
      qed
      have m3: (ex x e. QM(exc(x, e)) && o3 = exc(x, e)) -> pw.END(o) proof
        assume q2
        obtain x e, hq e3 from q2
        have oe := mp(all_elim(ox, {x}, {e}), e3)
        have nr: !(ex w r. exc(x, e) = ok(w, r) && R(gc.back0(w, s), fst(r))) proof
          assume q3
          obtain w r, f _ from q3
          show by simp(f)
        qed
        have en: pw.END(exc(x, e)) by taut(hq, nr)
        show := rewrite(sym(oe), en)
      qed
      have m4: (ex t. QM(diverge(t)) && o3 = diverge(t)) -> pw.END(o) proof
        assume q2
        obtain t, hq _ from q2
        have nr: !(ex w r. diverge(t) = ok(w, r) && R(gc.back0(w, s), fst(r))) proof
          assume q3
          obtain w r, f _ from q3
          show by simp(f)
        qed
        have f: false by taut(hq, nr, all_elim(pw.end_div, {t}))
        show by taut(f)
      qed
      // (main returned: exit called after)
      have m2: (ex w5 r5. QM(ok(w5, r5)) && (o3 = ok(gc.back0(w5, s), pair(fst(r5), snd(r5))) || o3 = exc(gc.back0(w5, s), OVF))) -> pw.END(o) proof
        assume q2
        obtain w5 r5, hq ho3 from q2
        have hr5: R(gc.back0(w5, s), fst(r5)) proof
          have c1: (ex w r. ok(w5, r5) = ok(w, r) && R(gc.back0(w, s), fst(r))) -> R(gc.back0(w5, s), fst(r5)) proof
            assume q3
            obtain w r, f hr from q3
            have we: w = w5 by simp(f)
            have re: r = r5 by simp(f)
            show := rewrite(re, rewrite(we, hr))
          qed
          show by taut(hq, c1, all_elim(pw.end_ok, {w5}, {r5}))
        qed
        have n2: o3 = exc(gc.back0(w5, s), OVF) -> pw.END(o) proof
          assume e3
          show := mp(all_elim(endo, {gc.back0(w5, s)}), mp(all_elim(ox, {gc.back0(w5, s)}, {OVF}), e3))
        qed
        have n1: o3 = ok(gc.back0(w5, s), pair(fst(r5), snd(r5))) -> pw.END(o) proof
          assume e3
          let W2 := gc.back0(w5, s)
          let U := fst(r5)
          have e2: oc2 = ok(W2, U) by simp(rewrite(e3, rel3))
          step h3 from rewrite(e2, hdc2)
          obtain oc3, hrc3 hdc3 from apply(g.bind_open, h3)
          have rg3 := apply(gc.regs_get, apply(gc.regs_one[w := 32, x := bits_of_int(32, U)], simp(), simp(), (bits_of_int(32, U) in bits(32) by simp())))
          have hq3: all regs o2. gc.regs_ok(regs, seq_one(gimple.arg(32, bits_of_int(32, U)))) -> runs(EX[regs], W2, o2) -> pw.END(o2) proof
            fix regs o2
            assume hro hg
            show := mp(all_elim(hX, {W2}, {U}, {regs}, {o2}), hr5, hro, hg)
          qed
          have ci3 := apply(gc.call0_inv[Q := o2. pw.END(o2)], {EX}, {seq_one(gimple.arg(32, bits_of_int(32, U)))}, {W2}, {oc3}, rg3, hq3, hrc3)
          have z1: oc3 = exc(W2, OVF) -> pw.END(o) proof
            assume e4
            have oe: o = exc(W2, OVF) by simp(rewrite(e4, hdc3))
            show := mp(all_elim(endo, {W2}), oe)
          qed
          have z2: (ex w6 r6. pw.END(ok(w6, r6)) && (oc3 = ok(gc.back0(w6, W2), pair(fst(r6), snd(r6))) || oc3 = exc(gc.back0(w6, W2), OVF))) -> pw.END(o) proof
            assume q4
            obtain w6 r6, f _ from q4
            show by taut(f, all_elim(pw.end_ok, {w6}, {r6}))
          qed
          have z3: (ex x e. pw.END(exc(x, e)) && oc3 = exc(x, e)) -> pw.END(o) proof
            assume q4
            obtain x e, en e4 from q4
            have oe: o = exc(x, e) by simp(rewrite(e4, hdc3))
            show := rewrite(sym(oe), en)
          qed
          have z4: (ex t. pw.END(diverge(t)) && oc3 = diverge(t)) -> pw.END(o) proof
            assume q4
            obtain t, f _ from q4
            show by taut(f, all_elim(pw.end_div, {t}))
          qed
          show by taut(ci3, z1, z2, z3, z4)
        qed
        show by taut(ho3, n1, n2)
      qed
      show by taut(ci2, m1, m2, m3, m4)
    qed
    show by taut(ho4, k1, k2)
  qed
  show by taut(ci, kA, kB, kC, kD)
qed

// (a run's end through a wrapper's continuation: the end itself)
theorem pw.end_k(x3 x4 x2. K): all o3 o. pw.END(o3) ->
  ((ex s1 v. o3 = ok(s1, v) && K(s1, v, o)) || (ex s1 e. o3 = exc(s1, e) && o = exc(s1, e))) || (ex t. o3 = diverge(t) && o = diverge(t)) -> pw.END(o)
proof
  fix o3 o
  assume he hk
  have c1: (ex s1 v. o3 = ok(s1, v) && K(s1, v, o)) -> pw.END(o) proof
    assume q
    obtain s1 v, e _ from q
    show by taut(rewrite(e, he), all_elim(pw.end_ok, {s1}, {v}))
  qed
  have c2: (ex s1 e. o3 = exc(s1, e) && o = exc(s1, e)) -> pw.END(o) proof
    assume q
    obtain s1 e, e1 e2 from q
    show := rewrite(sym(e2), rewrite(e1, he))
  qed
  have c3: (ex t. o3 = diverge(t) && o = diverge(t)) -> pw.END(o) proof
    assume q
    obtain t, e _ from q
    show by taut(rewrite(e, he), all_elim(pw.end_div, {t}))
  qed
  show by taut(hk, c1, c2, c3)
qed

// stage2's C function (its CFG form): so, with three arguments
abbrev pw.R0(regs) := bits_of_int(64, regs[0])
abbrev pw.R1(regs) := bits_of_int(32, regs[1])
abbrev pw.R2(regs) := bits_of_int(64, regs[2])

theorem pw.s2_fun(w u. R): all P SI FP EX regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> ord_le(3, seq_len(regs)) -> s in abi.World ->
  pw.R0(regs) = P.main -> int_lt(pw.R1(regs), int_pow(2, 31)) -> int_lt(pw.ENV(pw.R1(regs), pw.R2(regs)), int_pow(2, 63)) ->
  startup_specs.ctors_ok(s.vm, s.objs, P, set_select(omega, x2. false)) ->
  mp.calls(SI, startup_specs.start_init_spec_fun(P)) ->
  (all regs2 o2. gc.regs_ok(regs2, pw.A2(pw.R1(regs), pw.R2(regs))) -> runs(FP[pw.R0(regs)][regs2], s, o2) -> pw.END(o2) || (ex w r. o2 = ok(w, r) && R(gc.back0(w, s), fst(r)))) ->
  (all w u regs2 o2. R(w, u) -> gc.regs_ok(regs2, seq_one(gimple.arg(32, bits_of_int(32, u)))) -> runs(EX[regs2], w, o2) -> pw.END(o2)) ->
  runs(c_src_env___libc_start_main_cfg.libc_start_main_stage2_fun(SI, FP, EX)[regs], s, o) -> pw.END(o)
proof
  fix P SI FP EX regs s o
  assume hr hl h3 hw hm h31 hb63 hct hSI hM hX h
  have hs := mp(all_elim(stage2_ref, {SI}, {FP}, {EX}, {regs}, {s}, {o}), hr, hl, hw, h)
  have ra := mp(sp.regs_in[regs := regs], hr, hl)
  have hs2 := expand(hs, c_src_env___libc_start_main.libc_start_main_stage2_fun)
  rsimp only, app_fn_build, ra in hs2
  have b := apply(g.runs_elim, hs2)
  have b2: bind_rel(c_src_env___libc_start_main.libc_start_main_stage2(pw.R0(regs), pw.R1(regs), pw.R2(regs), SI, FP, EX), s,
      x3 x4. sp.KC32(x3, x4, o), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) by taut(b, h3)
  obtain o3, r3 k3 from expand(b2, bind_rel)
  have e3 := apply(pw.s2_run[R := w u. R(w, u)], {P}, {pw.R0(regs)}, {pw.R1(regs)}, {pw.R2(regs)}, {SI}, {FP}, {EX}, {s}, {o3}, hw,
    (pw.R0(regs) in bits(64) by simp()), (pw.R1(regs) in bits(32) by simp()), (pw.R2(regs) in bits(64) by simp()), hm, h31, hb63, hct, hSI, hM, hX, r3)
  show := apply(pw.end_k[K := x3 x4 x2. sp.KC32(x3, x4, x2)], {o3}, {o}, e3, k3)
qed

// ----------------------------------------------------------------------
//  __libc_start_main: __init_libc (its spec, some memory it may leave),
//  then stage2 through its pointer (an end from every world libc set up)

abbrev pw.ENVB(argc, argv) := bits_add(64, argv, int_mul(8, int_add(argc, 1)))
abbrev pw.W1(s, V, fs) := fn_update(fn_update(s, "vm", V), "fs_base", fs)
abbrev pw.A3(main, argc, argv) := seq_concat(seq_concat(seq_one(gimple.arg(64, main)), seq_one(gimple.arg(32, argc))), seq_one(gimple.arg(64, argv)))

theorem pw.lsm_run: all g P main argc argv d1 d2 d3 IL FP s o. s in abi.World -> main in bits(64) -> argc in bits(32) -> argv in bits(64) ->
  startup_specs.start_main_pre(s.vm, s.objs, g, P, argc, argv) ->
  mp.calls(IL, startup_specs.init_libc_spec_fun(g)) -> (ex V. sp.TMV(g, pw.ENVB(argc, argv), s, V)) ->
  (all V fs regs o2. sp.TMV(g, pw.ENVB(argc, argv), s, V) -> fs in bits(64) -> startup_specs.thread_at(g, V, fs) -> gc.regs_ok(regs, pw.A3(main, argc, argv)) ->
    runs(FP[c_src_env___libc_start_main.libc_start_main_stage2_at][regs], pw.W1(s, V, fs), o2) -> pw.END(o2)) ->
  runs(c_src_env___libc_start_main.__libc_start_main(main, argc, argv, d1, d2, d3, IL, FP), s, o) -> pw.END(o)
proof
  fix g P main argc argv d1 d2 d3 IL FP s o
  assume hw hmb hab hvb hsm hIL hex hS2 h
  let ENVb := pw.ENVB(argc, argv)
  have pu := apply(g.runs_univ, expand(h, c_src_env___libc_start_main.__libc_start_main))
  have hu: s in univ(1) by simp(pu)
  have sa1 sa2 sa3 sa4 sa5 sa6 := expand(hsm, startup_specs.start_main_pre)
  let OVF := exc_val("stack_overflow", empty)
  let M := int_mul(8, int_add(argc, 1))
  let TY := fn_update(fn_update(empty, "prec", 64), "signed", true)
  have ao: argc in omega by simp(hab)
  have vo: argv in omega by simp(hvb)
  have m1: bits_of_int(32, argc) = argc by defs(arith(ao, sa1), bits_of_int)
  have m2: bits_of_int(64, argc) = argc by defs(arith(ao, sa1), bits_of_int)
  have p31: int_lt(argc, pow2(31)) by arith(sa1)
  have eS: bits_sext(32, 64, argc) = argc by defs(simp(m1, m2, p31), bits_sext, sint, letin)
  have eA1: bits_add(64, argc, 1) = int_add(argc, 1) by defs(arith(ao, sa1), bits_add)
  have eM: bits_mul(64, int_add(argc, 1), 8) = M by defs(arith(ao, sa1), bits_mul)
  have p63: int_pow(2, int_sub(64, 1)) = 9223372036854775808 by simp()
  have nlt: !int_le(int_pow(2, int_sub(64, 1)), M) by arith(ao, sa1, p63)
  have eV: gimple.sval(TY, M) = M by defs(simp(nlt), gimple.sval)
  have ml: int_lt(M, pow2(64)) by arith(ao, sa1)
  have mb: M in bits(64) by defs(simp(ao, ml), bits)
  have pz: int_le(0, int_add(argv, gimple.sval(TY, M))) by arith(eV, ao, vo)
  have pl: int_lt(int_add(argv, gimple.sval(TY, M)), pow2(64)) by arith(eV, ao, vo, sa3)
  have p0: int_add(argv, 0) = argv by arith(vo)
  have pl0: int_lt(int_add(argv, 0), pow2(64)) by arith(vo, sa3)
  have md: g.mem_defined(s, argv, 0, 8, false) by simp(sa2, sa4, pl0, p0)
  have b := apply(g.runs_elim, expand(h, c_src_env___libc_start_main.__libc_start_main))
  step a1, h0 from b
  step a2, h0b from h0
  step a3, h0c from h0b
  have h0r := rewrite(eM, rewrite(eA1, rewrite(eS, h0c)))
  step h1 from h0r with g.padd_det, g.ld64_det using conj(hu, hvb, mb, pz, pl, md)
  let A0 := bits_of_int(64, gimple.bytes_at(s.vm, argv, 8))
  have eE: int_add(argv, M) = ENVb by defs(arith(ao, vo, sa3), bits_add)
  have h1r := rewrite(eE, rewrite(p0, rewrite(eV, h1)))
  have sv wf wd _ := apply(ms.world_parts, hw)
  have od: "objs" in dom(s) by simp(expand(hw, abi.World))
  have endo: all x. o = exc(x, OVF) -> pw.END(o) proof
    fix x
    assume e
    show by taut((ex x2. o = exc(x2, OVF) by ex_intro({x}, e)))
  qed
  have hovf: sp.ovf_any(s, o) -> pw.END(o) proof
    assume ov
    obtain f v ob, _ _ _ e from expand(ov, sp.ovf_any)
    show := mp(all_elim(endo, {fn_update(fn_update(fn_update(s, "fs_base", f), "vm", v), "objs", ob)}), e)
  qed
  // __init_libc called as its spec says
  obtain oc, hrc hdc from apply(g.bind_open, h1r)
  let ARGS1 := seq_concat(seq_one(gimple.arg(64, ENVb)), seq_one(gimple.arg(64, A0)))
  let QI(o2) := sp.ovf_any(s, o2) || (ex V fs v. (sp.TMV(g, ENVb, s, V) && fs in bits(64) && startup_specs.thread_at(g, V, fs)) &&
    o2 = ok(fn_update(fn_update(s, "vm", V), "fs_base", fs), v)) || !(ex V. sp.TMV(g, ENVb, s, V))
  have eb: ENVb in bits(64) by simp()
  have a0b: A0 in bits(64) by simp()
  have rg := apply(gc.regs_get, apply(gc.regs_cat, apply(gc.regs_one[w := 64, x := ENVb], simp(), simp(), eb), apply(gc.regs_one[w := 64, x := A0], simp(), simp(), a0b)))
  have hqi: all regs o2. gc.regs_ok(regs, ARGS1) -> runs(IL[regs], s, o2) -> QI(o2) proof
    fix regs o2
    assume hro hg
    have rl rln _ := hro
    have rn: seq_len(regs) = 2 := trans(rln, (seq_len(ARGS1) = 2 by simp()))
    have l6: int_le(seq_len(regs), 6) by arith(rn)
    have ra := mp(sp.regs_in[regs := regs], rl, l6)
    have o2l: ord_le(2, seq_len(regs)) by defs(simp(rn), ord_le)
    have hs := mp(all_elim(hIL, {regs}, {s}, {o2}), rl, l6, hw, hg)
    have q0 := apply(gc.reg_at[regs := regs, args := ARGS1, i := 0, w := 64, x := ENVb], hro, simp(), simp(), at({ARGS1[0]}), simp(), eb)
    have q1 := apply(gc.reg_at[regs := regs, args := ARGS1, i := 1, w := 64, x := A0], hro, simp(), simp(), at({ARGS1[1]}), simp(), a0b)
    have b2 := rewrite(q0, rewrite(q1, apply(sp.fun_out[n := 2, Q := a. startup_specs.init_libc_spec(g, bits_of_int(64, a[0]), bits_of_int(64, a[1]))], ra, o2l,
      expand(hs, startup_specs.init_libc_spec_fun))))
    obtain o4, r4 k4 from expand(b2, bind_rel)
    have il := apply(sp.il_q, hw, sa5, r4)
    have kc := apply(sp.k_cases, k4)
    have j1: sp.ovf_any(s, o4) -> QI(o2) proof
      assume ov
      obtain f v ob, _ _ _ e from expand(ov, sp.ovf_any)
      have nk: !is_ok(o4) := rewrite(sym(e), all_elim(g.not_ok_exc, {fn_update(fn_update(fn_update(s, "fs_base", f), "vm", v), "objs", ob)}, {OVF}))
      have j: (!is_ok(o4) && o2 = o4) -> sp.ovf_any(s, o2) proof
        assume q
        have _ e2 := q
        show := rewrite(sym(e2), ov)
      qed
      show by taut(kc, nk, j)
    qed
    have j2: (ex V fs. (sp.TMV(g, ENVb, s, V) && fs in bits(64) && startup_specs.thread_at(g, V, fs)) && o4 = ok(fn_update(fn_update(s, "vm", V), "fs_base", fs), empty)) -> QI(o2) proof
      assume q
      obtain V fs, hV hfr hl8 hfs0 hfb hts e from q
      have a := (sp.anyv(fn_update(fn_update(s, "vm", V), "fs_base", fs), o2) by simp(rewrite(e, k4), keep(any_rel)))
      obtain v, e2 from apply(sp.anyv_ok, a)
      have x: ex V2 fs2 v2. (sp.TMV(g, ENVb, s, V2) && fs2 in bits(64) && startup_specs.thread_at(g, V2, fs2)) && o2 = ok(fn_update(fn_update(s, "vm", V2), "fs_base", fs2), v2)
        by ex_intro({V}, {fs}, {v}, taut(hV, hfr, hl8, hfs0, hfb, hts, e2))
      show by taut(x)
    qed
    show by taut(il, j1, j2)
  qed
  have ci := apply(gc.call0_inv[Q := o2. QI(o2)], {IL}, {ARGS1}, {s}, {oc}, rg, hqi, hrc)
  have kA: oc = exc(s, OVF) -> pw.END(o) proof
    assume e
    show := mp(all_elim(endo, {s}), (o = exc(s, OVF) by simp(rewrite(e, hdc))))
  qed
  have kC: (ex x e. QI(exc(x, e)) && oc = exc(x, e)) -> pw.END(o) proof
    assume q
    obtain x e, hq4 he from q
    have oe: o = exc(x, e) by simp(rewrite(he, hdc))
    have c1: sp.ovf_any(s, exc(x, e)) -> pw.END(o) proof
      assume ov
      show := mp(hovf, rewrite(sym(oe), ov))
    qed
    have c2: (ex V fs v. (sp.TMV(g, ENVb, s, V) && fs in bits(64) && startup_specs.thread_at(g, V, fs)) && exc(x, e) = ok(fn_update(fn_update(s, "vm", V), "fs_base", fs), v)) ->
        pw.END(o) proof
      assume q2
      obtain V fs v, _ _ _ _ _ _ f from q2
      have ff: false by defs(simp(f), ok, exc)
      show by taut(ff)
    qed
    show by taut(hq4, c1, c2, hex)
  qed
  have kD: (ex t. QI(diverge(t)) && oc = diverge(t)) -> pw.END(o) proof
    assume q
    obtain t, hq4 he from q
    have c1: sp.ovf_any(s, diverge(t)) -> pw.END(o) proof
      assume ov
      have ff: false by defs(simp(expand(ov, sp.ovf_any)), exc, diverge)
      show by taut(ff)
    qed
    have c2: (ex V fs v. (sp.TMV(g, ENVb, s, V) && fs in bits(64) && startup_specs.thread_at(g, V, fs)) && diverge(t) = ok(fn_update(fn_update(s, "vm", V), "fs_base", fs), v)) ->
        pw.END(o) proof
      assume q2
      obtain V fs v, _ _ _ _ _ _ f from q2
      have ff: false by defs(simp(f), ok, diverge)
      show by taut(ff)
    qed
    show by taut(hq4, c1, c2, hex)
  qed
  have kB: (ex w4 r. QI(ok(w4, r)) && (oc = ok(gc.back0(w4, s), pair(fst(r), snd(r))) || oc = exc(gc.back0(w4, s), OVF))) -> pw.END(o) proof
    assume q
    obtain w4 r, hq4 ho4 from q
    have c1: sp.ovf_any(s, ok(w4, r)) -> pw.END(o) proof
      assume ov
      have ff: false by defs(simp(expand(ov, sp.ovf_any)), ok, exc)
      show by taut(ff)
    qed
    // libc set up at W1: stage2 called there
    have c2: (ex V fs v. (sp.TMV(g, ENVb, s, V) && fs in bits(64) && startup_specs.thread_at(g, V, fs)) && ok(w4, r) = ok(fn_update(fn_update(s, "vm", V), "fs_base", fs), v)) ->
        pw.END(o) proof
      assume q2
      obtain V fs v, hV hfr hl8 hfs0 hfb hts e4 from q2
      let W1 := fn_update(fn_update(s, "vm", V), "fs_base", fs)
      have w4e: w4 = W1 by simp(e4)
      have wv1 wv2 := apply(mp.am_world, hw, hu, hV)
      have ww1 ww2 := apply(sp.world_fs, wv1, wv2, hfb)
      have sv1 wf1 wd1 _ := apply(ms.world_parts, ww1)
      have od1: "objs" in dom(W1) by simp(expand(ww1, abi.World))
      have os := apply(gc.objs_same, hw)
      have bk: gc.back0(w4, s) = W1 by simp(w4e, os, wf1, od1, wf, od)
      have k2: oc = exc(gc.back0(w4, s), OVF) -> pw.END(o) proof
        assume e
        show := mp(all_elim(endo, {W1}), (o = exc(W1, OVF) by simp(rewrite(bk, rewrite(e, hdc)))))
      qed
      have k1: oc = ok(gc.back0(w4, s), pair(fst(r), snd(r))) -> pw.END(o) proof
        assume e
        step h2 from rewrite(bk, rewrite(e, hdc))
        obtain oc2, hrc2 hdc2 from apply(g.bind_open, h2)
        obtain o3, r3 rel3 from apply(sp.call1_0_e, hrc2)
        have rg2 := apply(gc.regs_get, apply(gc.regs_cat, apply(gc.regs_cat, apply(gc.regs_one[w := 64, x := main], simp(), simp(), hmb),
          apply(gc.regs_one[w := 32, x := argc], simp(), simp(), hab)), apply(gc.regs_one[w := 64, x := argv], simp(), simp(), hvb)))
        have hq2: all regs o2. gc.regs_ok(regs, pw.A3(main, argc, argv)) -> runs(FP[c_src_env___libc_start_main.libc_start_main_stage2_at][regs], W1, o2) -> pw.END(o2) proof
          fix regs o2
          assume hro hg
          show := mp(all_elim(hS2, {V}, {fs}, {regs}, {o2}), conj(hV, conj(conj(hfr, hl8), hfs0)), hfb, hts, hro, hg)
        qed
        have ci2 := apply(gc.call0_inv[Q := o2. pw.END(o2)], {FP[c_src_env___libc_start_main.libc_start_main_stage2_at]}, {pw.A3(main, argc, argv)}, {W1}, {o3}, rg2, hq2, r3)
        have ox: all X E. o3 = exc(X, E) -> o = exc(X, E) proof
          fix X E
          assume e3
          have e2: oc2 = exc(X, E) by simp(rewrite(e3, rel3))
          show by simp(rewrite(e2, hdc2))
        qed
        have m1: o3 = exc(W1, OVF) -> pw.END(o) proof
          assume e3
          show := mp(all_elim(endo, {W1}), mp(all_elim(ox, {W1}, {OVF}), e3))
        qed
        have m2: (ex w5 r5. pw.END(ok(w5, r5)) && (o3 = ok(gc.back0(w5, W1), pair(fst(r5), snd(r5))) || o3 = exc(gc.back0(w5, W1), OVF))) -> pw.END(o) proof
          assume q3
          obtain w5 r5, f _ from q3
          show by taut(f, all_elim(pw.end_ok, {w5}, {r5}))
        qed
        have m3: (ex x e. pw.END(exc(x, e)) && o3 = exc(x, e)) -> pw.END(o) proof
          assume q3
          obtain x e, en e3 from q3
          show := rewrite(sym(mp(all_elim(ox, {x}, {e}), e3)), en)
        qed
        have m4: (ex t. pw.END(diverge(t)) && o3 = diverge(t)) -> pw.END(o) proof
          assume q3
          obtain t, f _ from q3
          show by taut(f, all_elim(pw.end_div, {t}))
        qed
        show by taut(ci2, m1, m2, m3, m4)
      qed
      show by taut(ho4, k1, k2)
    qed
    show by taut(hq4, c1, c2, hex)
  qed
  show by taut(ci, kA, kB, kC, kD)
qed

// __libc_start_main's C function (its CFG form): so, with six arguments
theorem pw.lsm_fun: all g P IL FP regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> ord_le(6, seq_len(regs)) -> s in abi.World ->
  startup_specs.start_main_pre(s.vm, s.objs, g, P, pw.R1(regs), pw.R2(regs)) ->
  mp.calls(IL, startup_specs.init_libc_spec_fun(g)) -> (ex V. sp.TMV(g, pw.ENVB(pw.R1(regs), pw.R2(regs)), s, V)) ->
  (all V fs regs2 o2. sp.TMV(g, pw.ENVB(pw.R1(regs), pw.R2(regs)), s, V) -> fs in bits(64) -> startup_specs.thread_at(g, V, fs) ->
    gc.regs_ok(regs2, pw.A3(pw.R0(regs), pw.R1(regs), pw.R2(regs))) ->
    runs(FP[c_src_env___libc_start_main.libc_start_main_stage2_at][regs2], pw.W1(s, V, fs), o2) -> pw.END(o2)) ->
  runs(c_src_env___libc_start_main_cfg.__libc_start_main_fun(IL, FP)[regs], s, o) -> pw.END(o)
proof
  fix g P IL FP regs s o
  assume hr hl h6 hw hsm hIL hex hS2 h
  have hs := mp(all_elim(start_main_ref, {IL}, {FP}, {regs}, {s}, {o}), hr, hl, hw, h)
  have ra := mp(sp.regs_in[regs := regs], hr, hl)
  have hs2 := expand(hs, c_src_env___libc_start_main.__libc_start_main_fun)
  rsimp only, app_fn_build, ra in hs2
  have b := apply(g.runs_elim, hs2)
  have b2: bind_rel(c_src_env___libc_start_main.__libc_start_main(pw.R0(regs), pw.R1(regs), pw.R2(regs), bits_of_int(64, regs[3]), bits_of_int(64, regs[4]),
      bits_of_int(64, regs[5]), IL, FP), s, x3 x4. sp.KC32(x3, x4, o), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) by taut(b, h6)
  obtain o3, r3 k3 from expand(b2, bind_rel)
  have e3 := mp(all_elim(pw.lsm_run, {g}, {P}, {pw.R0(regs)}, {pw.R1(regs)}, {pw.R2(regs)}, {bits_of_int(64, regs[3])}, {bits_of_int(64, regs[4])},
      {bits_of_int(64, regs[5])}, {IL}, {FP}, {s}, {o3}), hw,
    (pw.R0(regs) in bits(64) by simp()), (pw.R1(regs) in bits(32) by simp()), (pw.R2(regs) in bits(64) by simp()), hsm, hIL, hex, hS2, r3)
  show := apply(pw.end_k[K := x3 x4 x2. sp.KC32(x3, x4, x2)], {o3}, {o}, e3, k3)
qed

// ----------------------------------------------------------------------
//  _start_c(p): __libc_start_main called with main, argc (the word at p),
//  argv (p + 8)

abbrev pw.WC(s, p) := gimple.bytes_at(s.vm, p, 8)
abbrev pw.A6(s, p) := seq_concat(seq_concat(seq_concat(seq_concat(seq_concat(seq_one(gimple.arg(64, c_crt_crt1.main_at)), seq_one(gimple.arg(32, pw.WC(s, p)))),
  seq_one(gimple.arg(64, bits_add(64, p, 8)))), seq_one(gimple.arg(64, c_crt_crt1._init_at))), seq_one(gimple.arg(64, c_crt_crt1._fini_at))), seq_one(gimple.arg(64, bits_of_int(64, 0))))

theorem pw.stc_run: all LSM p s o. s in abi.World -> p in bits(64) -> !(p = 0) -> int_lt(int_add(p, 16), int_pow(2, 63)) ->
  gimple.usable(s.vm, s.objs, p, 8, false) -> int_lt(pw.WC(s, p), int_pow(2, 31)) ->
  (all regs o2. gc.regs_ok(regs, pw.A6(s, p)) -> runs(LSM[regs], s, o2) -> pw.END(o2)) ->
  runs(c_crt_crt1._start_c(p, LSM), s, o) -> pw.END(o)
proof
  fix LSM p s o
  assume hw hp hp1 hp2 hus h31 hL h
  have pu := apply(g.runs_univ, expand(h, c_crt_crt1._start_c))
  have hu: s in univ(1) by simp(pu)
  have b := apply(g.runs_elim, expand(h, c_crt_crt1._start_c))
  have pl: int_lt(int_add(p, 0), pow2(64)) by arith(hp2, hp)
  have p0: int_add(p, 0) = p by arith(hp)
  have md: g.mem_defined(s, p, 0, 8, false) by simp(hp1, hus, pl, p0)
  have sv8: g.sv64(8) = 8 by simp()
  have pl8: int_lt(int_add(p, g.sv64(8)), pow2(64)) by arith(hp2, hp, sv8)
  have pz8: int_le(0, int_add(p, g.sv64(8))) by arith(hp, sv8)
  step a1, h0 from b
  step a2, h1 from h0 with g.ld64_det, g.padd_det using conj(hu, hp, md, pl8, pz8)
  let W := gimple.bytes_at(s.vm, p, 8)
  let AV := bits_add(64, p, 8)
  have _ _ _ sbt := apply(ms.world_parts, hw)
  have wo _ := apply(g.bytes_bound, {s.vm}, {p}, {8}, sbt, simp())
  have eA: bits_of_int(32, bits_of_int(64, W)) = W by defs(arith(wo, h31), bits_of_int)
  have e8: gimple.sval(fn_update(fn_update(empty, "prec", 64), "signed", true), 8) = 8 by simp()
  have bq: int_add(p, 8) = AV by defs(arith(hp, hp2), bits_add, bits_of_int)
  have h2 := rewrite(bq, rewrite(e8, rewrite(eA, rewrite(p0, h1))))
  obtain oc, hrc hdc from apply(g.bind_open, h2)
  have mb: c_crt_crt1.main_at in bits(64) by defs(simp(), c_crt_crt1.main_at)
  have ib: c_crt_crt1._init_at in bits(64) by defs(simp(), c_crt_crt1._init_at)
  have fb: c_crt_crt1._fini_at in bits(64) by defs(simp(), c_crt_crt1._fini_at)
  have w32: int_lt(W, pow2(32)) by arith(h31, wo)
  have wb: W in bits(32) by defs(simp(wo, w32), bits)
  have avb: AV in bits(64) by simp()
  have rg := apply(gc.regs_get, apply(gc.regs_cat, apply(gc.regs_cat, apply(gc.regs_cat, apply(gc.regs_cat, apply(gc.regs_cat,
    apply(gc.regs_one[w := 64, x := c_crt_crt1.main_at], simp(), simp(), mb), apply(gc.regs_one[w := 32, x := W], simp(), simp(), wb)),
    apply(gc.regs_one[w := 64, x := AV], simp(), simp(), avb)), apply(gc.regs_one[w := 64, x := c_crt_crt1._init_at], simp(), simp(), ib)),
    apply(gc.regs_one[w := 64, x := c_crt_crt1._fini_at], simp(), simp(), fb)), apply(gc.regs_one[w := 64, x := bits_of_int(64, 0)], simp(), simp(), simp())))
  have ci := apply(gc.call0_inv[Q := o2. pw.END(o2)], {LSM}, {pw.A6(s, p)}, {s}, {oc}, rg, hL, hrc)
  have kA: oc = exc(s, pw.OVF) -> pw.END(o) proof
    assume e
    have oe: o = exc(s, pw.OVF) by simp(rewrite(e, hdc))
    show by taut((ex x2. o = exc(x2, pw.OVF) by ex_intro({s}, oe)))
  qed
  have kB: (ex w4 r. pw.END(ok(w4, r)) && (oc = ok(gc.back0(w4, s), pair(fst(r), snd(r))) || oc = exc(gc.back0(w4, s), pw.OVF))) -> pw.END(o) proof
    assume q
    obtain w4 r, f _ from q
    show by taut(f, all_elim(pw.end_ok, {w4}, {r}))
  qed
  have kC: (ex x e. pw.END(exc(x, e)) && oc = exc(x, e)) -> pw.END(o) proof
    assume q
    obtain x e, en e4 from q
    have oe: o = exc(x, e) by simp(rewrite(e4, hdc))
    show := rewrite(sym(oe), en)
  qed
  have kD: (ex t. pw.END(diverge(t)) && oc = diverge(t)) -> pw.END(o) proof
    assume q
    obtain t, f _ from q
    show by taut(f, all_elim(pw.end_div, {t}))
  qed
  show by taut(ci, kA, kB, kC, kD)
qed

// _start_c's C function (its CFG form): so, with an argument
theorem pw.stc_fun: all LSM regs s o. regs in list_type(bits(64)) -> int_le(seq_len(regs), 6) -> ord_le(1, seq_len(regs)) -> s in abi.World ->
  !(pw.R0(regs) = 0) -> int_lt(int_add(pw.R0(regs), 16), int_pow(2, 63)) -> gimple.usable(s.vm, s.objs, pw.R0(regs), 8, false) -> int_lt(pw.WC(s, pw.R0(regs)), int_pow(2, 31)) ->
  (all regs2 o2. gc.regs_ok(regs2, pw.A6(s, pw.R0(regs))) -> runs(LSM[regs2], s, o2) -> pw.END(o2)) ->
  runs(c_crt_crt1_cfg._start_c_fun(LSM)[regs], s, o) -> pw.END(o)
proof
  fix LSM regs s o
  assume hr hl h1 hw hp1 hp2 hus h31 hL h
  have hs := mp(all_elim(start_c_ref, {LSM}, {regs}, {s}, {o}), hr, hl, hw, h)
  have ra := mp(sp.regs_in[regs := regs], hr, hl)
  have hs2 := expand(hs, c_crt_crt1._start_c_fun)
  rsimp only, app_fn_build, ra in hs2
  have b := apply(g.runs_elim, hs2)
  have b2: bind_rel(c_crt_crt1._start_c(pw.R0(regs), LSM), s, x3 x4. sp.anyv(x3, o), x3 x4. o = exc(x3, x4), x3. o = diverge(x3)) by taut(b, h1)
  obtain o3, r3 k3 from expand(b2, bind_rel)
  have e3 := mp(all_elim(pw.stc_run, {LSM}, {pw.R0(regs)}, {s}, {o3}), hw, (pw.R0(regs) in bits(64) by simp()), hp1, hp2, hus, h31, hL, r3)
  show := apply(pw.end_k[K := x3 x4 x2. sp.anyv(x3, x2)], {o3}, {o}, e3, k3)
qed

// ----------------------------------------------------------------------
//  exit at its call: its linked code by its spec (from exit_pre: an
//  overflow, or exit with the code's low byte)

theorem pw.ex_calls: mp.calls(lxp.EX, startup_specs.exit_spec_fun(xt.XP))
proof
  let DR := musl_asm_cfg.deregister_tm_clones_fun()
  let FI := musl_asm_cfg._init_fun()
  let S1 := c_src_exit__Exit_cfg.__syscall1_fun()
  have fpio: all T. T in bits(64) -> tr.callee_io(lxp.FP(4198784, lxp.DT)[T], 0) proof
    fix T
    assume hT
    have e := mp(app_fn_build[d := bits(64), v := x. ite(x = 4198784, lxp.DT, lnk.A), a := T], hT)
    have i: tr.callee_io(ite(T = 4198784, lxp.DT, lnk.A), 0) by simp(mp(all_elim(gdtc.io, {musl_asm_cfg.deregister_tm_clones_fun()}), dtmc.io), mp.undef_io[n := 0])
    show := rewrite(sym(e), i)
  qed
  have hG6 := mp(all_elim(ex_fini_ref, {lxp.FP(4198784, lxp.DT)}, {FI}), fpio, finic.io)
  have hG8 := mp(all_elim(ex_xe_ref, {S1}), exs1c.io)
  have hG2: mp.calls(c_src_malloc_mallocng_malloc_cfg.a_cas_fun(), mallocng_specs.a_cas_spec_fun()) proof
    fix regs s o
    assume h1 h2 h3 hr
    show := mp(all_elim(ms.a_cas_fun_c2, {regs}, {s}, {o}), h1, h2, h3, mp(all_elim(a_cas_ref, {regs}, {s}, {o}), h1, h2, h3, hr))
  qed
  show := mp(all_elim(xt.exit_calls, {c_src_exit_exit_cfg.__get_tp_fun()}, {c_src_malloc_mallocng_malloc_cfg.a_cas_fun()}, {lnk.A}, {lnk.A},
      {c_src_exit_exit_cfg.dummy_fun()}, {lxp.FN}, {c_src_exit_exit_cfg.dummy_fun()}, {lxp.XE}, {DR}, {FI}, {S1}, {xt.XP}),
    simp(), simp(), simp(), simp(), simp(), ex_gtp_ref, hG2, ex_dm_ref, ex_dm_ref, dtm_ref, init_ref, hG6, ex_s1_ref, hG8)
qed

// (abi.overflow from h: an overflow's raise)
theorem pw.ovf_x(h, x2): bind_rel(abi.overflow, h, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)), x3. x2 = diverge(x3)) ->
  ex y. x2 = exc(y, pair("raise", pw.OVF))
proof
  assume e1
  rsimp only, abi.overflow in e1
  have vv := lwh.vm_ne
  have l: ex v ob. (v in x86_64_linux.Vm && ob in abi.Objs) &&
    x2 = exc(pair(fn_update(fn_update(h, "vm", v), "objs", ob), empty), pair("raise", pw.OVF)) by simp(e1, vv, ct.objs_ne)
  obtain v ob, _ _ hx from l
  show by ex_intro({pair(fn_update(fn_update(h, "vm", v), "objs", ob), empty)}, hx)
qed

// exit's spec from exit_pre: an overflow, or exit with the low byte
theorem pw.xs_out: all regs h o. regs in sp.REGS -> ord_le(1, seq_len(regs)) ->
  startup_specs.exit_pre(h.vm, h.objs, xt.XP, h.fs_base) -> runs(startup_specs.exit_spec_fun(xt.XP)[regs], h, o) ->
  (ex x. o = exc(x, pw.OVF)) || (ex x. o = exc(x, exc_val("exit", bits_slice(bits_of_int(32, regs[0]), 7, 0))))
proof
  fix regs h o
  assume ra h1 hp hr
  let C := bits_of_int(32, regs[0])
  let GOAL := (ex x. o = exc(x, pw.OVF)) || (ex x. o = exc(x, exc_val("exit", bits_slice(C, 7, 0))))
  have b := apply(sp.fun_out[n := 1, Q := a. startup_specs.exit_spec(xt.XP, bits_of_int(32, a[0]))], ra, h1, expand(hr, startup_specs.exit_spec_fun))
  obtain o4, r4 k4 from expand(b, bind_rel)
  have bb := apply(or_resolve, apply(g.runs_elim, expand(r4, startup_specs.exit_spec)), hp)
  obtain x2, hbr hd from bb
  // (o4 an exception: o the same)
  have kc := apply(sp.k_cases, k4)
  have oo: all y e. o4 = exc(y, e) -> o = exc(y, e) proof
    fix y e
    assume e4
    have nk: !is_ok(o4) := rewrite(sym(e4), all_elim(g.not_ok_exc, {y}, {e}))
    have j: (!is_ok(o4) && o = o4) -> o = exc(y, e) proof
      assume q
      have _ e5 := q
      show := trans(e5, e4)
    qed
    show by taut(kc, nk, j)
  qed
  have c1: bind_rel(abi.overflow, h, x3 x4. x2 = ok(pair(x3, empty), empty), x3 x4. x2 = exc(pair(x3, empty), pair("raise", x4)), x3. x2 = diverge(x3)) -> GOAL proof
    assume e
    obtain y, hx from apply(pw.ovf_x, e)
    have e4: o4 = exc(fst(y), pw.OVF) by simp(rewrite(hx, hd))
    have oe := mp(all_elim(oo, {fst(y)}, {pw.OVF}), e4)
    show by taut((ex x. o = exc(x, pw.OVF) by ex_intro({fst(y)}, oe)))
  qed
  have c2: any_rel(x3. x3 in x86_64_linux.Vm, x3. letin(fn_update(h, "vm", x3), x4. x2 = exc(pair(x4, empty), pair("raise", exc_val("exit", bits_slice(C, 7, 0)))))) -> GOAL proof
    assume e
    obtain V, _ l from apply(g.any_e, lwh.vm_ne, e)
    have hx: x2 = exc(pair(fn_update(h, "vm", V), empty), pair("raise", exc_val("exit", bits_slice(C, 7, 0)))) by defs(l, letin)
    have e4: o4 = exc(fn_update(h, "vm", V), exc_val("exit", bits_slice(C, 7, 0))) by simp(rewrite(hx, hd))
    have oe := mp(all_elim(oo, {fn_update(h, "vm", V)}, {exc_val("exit", bits_slice(C, 7, 0))}), e4)
    show by taut((ex x. o = exc(x, exc_val("exit", bits_slice(C, 7, 0))) by ex_intro({fn_update(h, "vm", V)}, oe)))
  qed
  show by taut(hbr, c1, c2)
qed

// exit called from the startup's world w, with 0 or 1, exit_pre where the
// canary is hidden: an end
abbrev pw.XR(w, u) := (w in abi.World && w in univ(1)) && tr.tc_ok(w) && startup_specs.exit_pre(w.vm, tr.hide(w).objs, xt.XP, w.fs_base) &&
  (bits_of_int(32, u) = 0 || bits_of_int(32, u) = 1)

theorem pw.exit_end: all w u regs o2. pw.XR(w, u) -> gc.regs_ok(regs, seq_one(gimple.arg(32, bits_of_int(32, u)))) -> runs(lwh.EXW[regs], w, o2) -> pw.END(o2)
proof
  fix w u regs o2
  assume hx hro hr
  have hw wu htc hpre hv := hx
  let V := bits_of_int(32, u)
  have rl rln _ := hro
  have rn: seq_len(regs) = 1 := trans(rln, (seq_len(seq_one(gimple.arg(32, V))) = 1 by simp()))
  have l6: int_le(seq_len(regs), 6) by arith(rn)
  have ra := mp(sp.regs_in[regs := regs], rl, l6)
  have hA: regs in abi.ARGS by simp(ra)
  have o1l: ord_le(1, seq_len(regs)) by defs(simp(rn), ord_le)
  have q0 := apply(gc.reg_at[regs := regs, args := seq_one(gimple.arg(32, V)), i := 0, w := 32, x := V], hro, simp(), simp(), simp(), simp(), (V in bits(32) by simp()))
  have sr := apply(tr.su_elim, {lxp.EX}, {regs}, {w}, {o2}, hA, hr)
  have c1: !tr.tc_ok(w) -> pw.END(o2) by taut(htc)
  have c2: (ex x3. runs(lxp.EX[regs], tr.hide(w), x3) && tr.omap(w, x3, o2)) -> pw.END(o2) proof
    assume e
    obtain x3, rx om from e
    have ol _ := apply(abi.objs_parts, (w.objs in abi.Objs by simp(expand(hw, abi.World))))
    have fb: w.fs_base in bits(64) by simp(expand(hw, abi.World))
    have ct cu := all_elim(tr.cbm_type, {true}, {w.fs_base})
    have cte := all_elim(tr.cbm_t, {w.fs_base})
    have ot _ := apply(abi.wob_typed, {w.objs.live}, {abi.cbytes0(w.fs_base)}, ol, rewrite(cte, ct), rewrite(cte, cu))
    have hwh _ := apply(sp.world_objs[s := w, ob := abi.wob(w.objs.live, abi.cbytes0(w.fs_base))], hw, wu, ot)
    have rs := mp(all_elim(pw.ex_calls, {regs}, {tr.hide(w)}, {x3}), rl, l6, hwh, rx)
    have hp2: startup_specs.exit_pre(tr.hide(w).vm, tr.hide(w).objs, xt.XP, tr.hide(w).fs_base) by simp(hpre)
    have xo := apply(pw.xs_out, {regs}, {tr.hide(w)}, {x3}, ra, o1l, hp2, rs)
    // (the code's low byte: 0 or 1)
    have bs: bits_slice(bits_of_int(32, regs[0]), 7, 0) = 0 || bits_slice(bits_of_int(32, regs[0]), 7, 0) = 1 by simp(q0, hv)
    have en: pw.END(x3) proof
      have d1: (ex x. x3 = exc(x, pw.OVF)) -> pw.END(x3) by taut()
      have d2: (ex x. x3 = exc(x, exc_val("exit", bits_slice(bits_of_int(32, regs[0]), 7, 0)))) -> pw.END(x3) proof
        assume q
        obtain x, ex from q
        have z: ex x5 c. x3 = exc(x5, exc_val("exit", c)) && (c = 0 || c = 1) by ex_intro({x}, {bits_slice(bits_of_int(32, regs[0]), 7, 0)}, conj(ex, bs))
        show by taut(z)
      qed
      show by taut(xo, d1, d2)
    qed
    // (omap: an exception unchanged)
    have m1: (ex w2 r. x3 = ok(w2, r) && o2 = ok(tr.rest(w, w2), r)) -> pw.END(o2) proof
      assume q
      obtain w2 r, e3 _ from q
      show by taut(rewrite(e3, en), all_elim(pw.end_ok, {w2}, {r}))
    qed
    have m2: (ex x e. x3 = exc(x, e) && o2 = exc(x, e)) -> pw.END(o2) proof
      assume q
      obtain x e, e3 e4 from q
      show := rewrite(sym(e4), rewrite(e3, en))
    qed
    have m3: (ex t. x3 = diverge(t) && o2 = diverge(t)) -> pw.END(o2) proof
      assume q
      obtain t, e3 _ from q
      show by taut(rewrite(e3, en), all_elim(pw.end_div, {t}))
    qed
    show by taut(expand(om, tr.omap), m1, m2, m3)
  qed
  show by taut(sr, c1, c2)
qed
