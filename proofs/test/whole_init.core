// The world at stage2's call (docs/todo.md 1(d)): main's precondition
// there. The machine-level Init lemmas (ui.rep_main, ui.owned_main) at a
// machine whose view is the startup world's memory -- _start_c's entry
// machine with the world's bytes (pw.MM) --, carried to the world main is
// called at (its objects the whole initial stack: rep reads objects only
// in aux_live).

// (_start_c's entry machine with V's bytes, the thread pointer fs)
abbrev pw.MM(s, V, fs) := fn_update(fn_update(s, "vm", fn_update(s.vm, "bytes", V.bytes)), "fs_base", fs)

// (the view of a memory with other bytes: the view with them)
theorem pw.wvm_b: all vm B. ui.wvm(fn_update(vm, "bytes", B)) = fn_update(ui.wvm(vm), "bytes", B)
proof
  fix vm B
  have wp: ui.wpages(fn_update(vm, "bytes", B)) = ui.wpages(vm) by defs(simp(), abi.stack_page, x86_64_linux.mapped)
  have sw := mp(fn_update_swap[f := vm, k := "bytes", a := B, j := "pages", b := ui.wpages(vm)], (!("bytes" = "pages") by simp()))
  show by simp(wp, sw)
qed

// (a memory as W but for its bytes: W with its bytes)
theorem pw.v_bytes: all W V. V in x86_64_linux.Vm -> fn_update(V, "bytes", W.bytes) = W -> V = fn_update(W, "bytes", V.bytes)
proof
  fix W V
  assume hv hf
  have vf: is_fun(V) && "bytes" in dom(V) by simp(expand(hv, x86_64_linux.Vm))
  have t := fn_update_twice[f := V, k := "bytes", a := W.bytes, b := V.bytes]
  have s0 := mp(fn_update_same[f := V, k := "bytes"], taut(vf), taut(vf))
  have e: fn_update(fn_update(V, "bytes", W.bytes), "bytes", V.bytes) = V := trans(t, s0)
  show := sym(rewrite(hf, e))
qed

// startup's effect at _start_c's entry machine s (its view's memory V,
// the thread at fs): main entered at pw.MM
theorem pw.at_main: all s objs a V fs. V in x86_64_linux.Vm -> startup_specs.frame(ui.wvm(s.vm), V, abi.wob(objs, abi.cball), startup_specs.start_writes(ui.G)) ->
  (all x4. x4 in omega -> startup_specs.env_at(ui.wvm(s.vm), abi.wob(objs, abi.cball), bits_add(64, a, int_mul(8, int_add(gimple.bytes_at(ui.wvm(s.vm), a, 8), 2))), x4) ->
     gimple.bytes_at(V, int_add(ui.G.libc, 8), 8) = int_add(bits_add(64, a, int_mul(8, int_add(gimple.bytes_at(ui.wvm(s.vm), a, 8), 2))), int_mul(8, int_add(x4, 1)))) ->
  fs in bits(64) -> startup_specs.thread_at(ui.G, V, fs) -> ui.at_main(s, objs, pw.MM(s, V, fs), a, V, fs)
proof
  fix s objs a V fs
  assume hv hfr hen hfb hts
  let M := pw.MM(s, V, fs)
  have fb _ := expand(hfr, startup_specs.frame)
  have ve := apply(pw.v_bytes, {ui.wvm(s.vm)}, {V}, hv, fb)
  have mv: M.vm = fn_update(s.vm, "bytes", V.bytes) by simp()
  have wm: ui.wvm(M.vm) = V := trans(rewrite(sym(mv), all_elim(pw.wvm_b, {s.vm}, {V.bytes})), sym(ve))
  have vk := rewrite(wm, all_elim(ui.wvm_vok, {M}, {objs}))
  have mf: M.fs_base = fs by simp()
  have mo: M.os = s.os by simp()
  show by defs(taut(hv, hfr, hen, hfb, hts, mf, mo, vk), ui.at_main)
qed

// (rep in a heap as S but for its objects, the auxiliary vector live)
theorem pw.rep_xfer: all c A S S2. mallocng.rep(c, A, S) -> S2.vm = S.vm -> S2.blocks = S.blocks -> S2.fs_base = S.fs_base ->
  mallocng.aux_live(A, S2.objs) -> mallocng.rep(c, A, S2)
proof
  fix c A S S2
  assume h hv hb hf hx
  have m u t l tl er ca _ := expand(h, mallocng.rep)
  have l2: malloc.live_rw(S2) by defs(rewrite(sym(hv), rewrite(sym(hb), expand(l, malloc.live_rw))), malloc.live_rw)
  show by defs(taut(rewrite(sym(hv), rewrite(sym(hb), m)), u, t, l2, rewrite(sym(hf), tl), rewrite(sym(hf), er), rewrite(sym(hf), ca), hx), mallocng.rep)
qed

// ----------------------------------------------------------------------
//  world_ok at main's call (docs/todo.md 1(c0))

// (_start_c's entry: exec's stack's fields)
theorem pw.s_fields: all m0 s lo top. ui.ctx(m0, s, lo, top) ->
  s.vm.stack_top = m0.vm.stack_top && s.vm.stack_limit = m0.vm.stack_limit && s.vm.brk_start = m0.vm.brk_start
proof
  fix m0 s lo top
  assume hc
  have _ _ _ _ _ _ _ h5 := expand(hc, ui.ctx)
  have _ _ _ _ _ _ _ _ _ _ hx := expand(h5, ui.s5)
  obtain v1, _ _ hf _ hsv _ from hx
  have f1 f2 f3 _ := expand(hf, x86.vm_fields)
  show by simp(hsv, f1, f2, f3)
qed

// the startup's memory V at _start_c's entry machine s (its view's, but
// for startup's writes), the thread at fs: world_ok of a heap with V, the
// canary's bytes hidden, the initial stack live
theorem pw.wok: all m0 s lo top argv envp V fs H. x86_64_linux.exec_state(musl_malloc.file, argv, envp, m0) -> ui.ctx(m0, s, lo, top) -> int_lt(1032, lo) ->
  tr.eok(false, false, s, seq_one(m0.gpr[4])) -> abi.code_at(s.vm, 4198400, text.code) -> V in x86_64_linux.Vm ->
  startup_specs.frame(ui.wvm(s.vm), V, abi.wob(ui.iobjs(m0.gpr[4], top), abi.cball), startup_specs.start_writes(ui.G)) ->
  fs in bits(64) -> startup_specs.thread_at(ui.G, V, fs) ->
  H.vm = V -> H.fs_base = fs -> H.objs.c_bytes = set_select(omega, x. !(x in abi.canary(fs))) -> H.objs.live = ui.iobjs(m0.gpr[4], top) ->
  malloc.world_ok(pw.PB, pw.PC, pw.PS, H)
proof
  fix m0 s lo top argv envp V fs H
  assume he hc hlo heo hca hv hfr hfb hta hHv hHf hHc hHl
  let W := ui.wvm(s.vm)
  let D := set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)))
  have fb fo := expand(hfr, startup_specs.frame)
  have ve := apply(pw.v_bytes, {W}, {V}, hv, fb)
  have vp: V.pages = W.pages by simp(apply(ui.app_eq[k := "pages"], ve))
  have vtop: V.stack_top = s.vm.stack_top by simp(apply(ui.app_eq[k := "stack_top"], ve))
  have vlim: V.stack_limit = s.vm.stack_limit by simp(apply(ui.app_eq[k := "stack_limit"], ve))
  have vbs: V.brk_start = s.vm.brk_start by simp(apply(ui.app_eq[k := "brk_start"], ve))
  have st sl sb := apply(pw.s_fields, hc)
  have hM _ _ hsp h1 h2 h16 _ := expand(hc, ui.ctx)
  have sp1 sp2 sp3 sp4 _ _ sp7 sp8 := expand(hsp, x86_64_linux.stack_pages)
  have _ _ ers _ _ _ ebk _ _ := expand(heo, tr.eok)
  have _ _ _ rmap := expand(ers, abi.stack_reserve)
  have fl: x86_64_linux.stack_floor(V) = x86_64_linux.stack_floor(m0.vm) by defs(simp(vtop, vlim, st, sl), x86_64_linux.stack_floor)
  // (a page of V: s's, not the stack's)
  have pg: all p. p in D -> !(V.pages[p] = none) -> V.pages[p] = s.vm.pages[p] && x86_64_linux.mapped(s.vm, p) && !abi.stack_page(s.vm, p) proof
    fix p
    assume hp hn
    have _ lt := unsel(hp)
    have a1 a2 := apply(ui.wvm_at[vm := s.vm, p := p], hp)
    have ns: !abi.stack_page(s.vm, p) proof
      assume hs
      show by taut(hn, rewrite(sym(vp), mp(a1, hs)))
    qed
    have e: V.pages[p] = s.vm.pages[p] := trans(apply(ui.app_eq[k := p], vp), mp(a2, ns))
    have mv: x86_64_linux.mapped(s.vm, p) by defs(taut(lt, rewrite(e, hn)), x86_64_linux.mapped)
    show by taut(e, mv, ns)
  qed
  // the pages: none the stack's, all off its space
  have c1: all p. p in D -> !(V.pages[p] = none) -> !(snd(V.pages[p]).kind = 2) proof
    fix p
    assume hp hn
    have e mv ns := mp(all_elim(pg, {p}), hp, hn)
    have nk: !(snd(s.vm.pages[p]).kind = 2) proof
      assume hk
      show by taut(ns, (abi.stack_page(s.vm, p) by defs(taut(mv, hk), abi.stack_page)))
    qed
    show := rewrite(sym(e), nk)
  qed
  have c7: all p. p in D -> !(V.pages[p] = none) -> x86_64_linux.off_stack_space(V, p, 1) proof
    fix p
    assume hp hn
    have po _ := unsel(hp)
    have e mv ns := mp(all_elim(pg, {p}), hp, hn)
    have o := mp(all_elim(rmap, {p}), po, conj(mv, ns))
    have sfl: x86_64_linux.stack_floor(V) = x86_64_linux.stack_floor(s.vm) by defs(simp(vtop, vlim), x86_64_linux.stack_floor)
    show by defs(rewrite(sym(sfl), rewrite(sym(vtop), o)), x86_64_linux.off_stack_space)
  qed
  // the thread
  have ts _ := expand(hta, startup_specs.thread_at)
  have tok cok _ := expand(ts, startup_specs.thread_set)
  // the break's start
  have c4: abi.brk_start_ok(V) by defs(simp(vbs, expand(ebk, abi.brk_start_ok)), abi.brk_start_ok)
  // the program's code: s's pages and bytes (not startup's writes)
  have cd: abi.code_at(V, 4198400, text.code) proof
    unfold abi.code_at
    fix i
    assume hi hil
    let A := bits_of_int(64, int_add(4198400, i))
    have q1 q2 q3 q4 := mp(all_elim(expand(hca, abi.code_at), {i}), hi, hil)
    have tl _ := ui.text_bytes
    have av: A = int_add(4198400, i) := apply(nf.boi_in, {64}, {int_add(4198400, i)}, simp(), (int_add(4198400, i) in bits(64) by arith(hi, hil, tl)))
    have pD: x86_64_linux.page_of(A) in D by defs(sel(taut((int_div(A, x86_64_linux.PAGE) in omega by defs(arith(av, hi), x86_64_linux.PAGE)),
      (int_lt(int_div(A, x86_64_linux.PAGE), int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)) by defs(arith(av, hi, hil, tl), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)))),
      x86_64_linux.page_of)
    have a1 a2 := apply(ui.wvm_at[vm := s.vm, p := x86_64_linux.page_of(A)], pD)
    have pe: V.pages[x86_64_linux.page_of(A)] = s.vm.pages[x86_64_linux.page_of(A)] := trans(apply(ui.app_eq[k := x86_64_linux.page_of(A)], vp), mp(a2, q3))
    have m1 _ := expand(q1, x86_64_linux.fetchable)
    have nsf: !abi.stack_free(W, abi.wob(ui.iobjs(m0.gpr[4], top), abi.cball), A) proof
      assume hsf
      have k: !(snd(s.vm.pages[x86_64_linux.page_of(A)]).kind = 2) proof
        assume hk
        show by taut(q3, (abi.stack_page(s.vm, x86_64_linux.page_of(A)) by defs(taut(m1, hk), abi.stack_page)))
      qed
      have wm: x86_64_linux.mapped(W, x86_64_linux.page_of(A)) && !(snd(W.pages[x86_64_linux.page_of(A)]).kind = 2) by defs(simp(mp(a2, q3), expand(m1, x86_64_linux.mapped), k), x86_64_linux.mapped)
      show by taut(expand(wm, x86_64_linux.page_of), expand(hsf, abi.stack_free))
    qed
    have nw: !(A in startup_specs.start_writes(ui.G)) proof
      assume hw
      have _ l1 _ := apply(ui.sw_range, hw)
      show by arith(l1, av, hil, tl)
    qed
    have be: V.bytes[A] = s.vm.bytes[A] by simp(mp(all_elim(fo, {A}), simp(), nw, nsf))
    have r1: x86_64_linux.fetchable(V, A) by defs(simp(pe, expand(q1, x86_64_linux.fetchable, x86_64_linux.mapped)), x86_64_linux.fetchable, x86_64_linux.mapped)
    have r2: !x86_64_linux.can_access(V, A, 1) by defs(simp(pe, expand(q2, x86_64_linux.can_access, x86_64_linux.mapped)), x86_64_linux.can_access, x86_64_linux.mapped)
    have r3: !abi.stack_page(V, x86_64_linux.page_of(A)) by defs(simp(pe, expand(q3, abi.stack_page, x86_64_linux.mapped)), abi.stack_page, x86_64_linux.mapped)
    show by taut(r1, r2, r3, trans(be, q4))
  qed
  // the statics: below the image's last page, under the stack's floor
  have m32: x86_64_linux.mapped(m0.vm, 1032) by defs(simp(apply(ui.pg_img[argv := argv, envp := envp, m0 := m0, p := 1032], he, simp())), x86_64_linux.mapped)
  have f32 := mp(all_elim(sp8, {1032}), simp(), conj(hlo, m32))
  have cs: all a. a in omega -> a in app(musl_malloc.prog_statics, empty) -> x86_64_linux.off_stack_space(V, int_div(a, x86_64_linux.PAGE), 1) proof
    fix a
    assume ha hs
    have se := apply(musl.unit_app, unfold(musl_malloc.prog_statics))
    have al: int_lt(a, 4228688) by simp(expand(rewrite(se, hs), int_range), ha)
    show by defs(arith(f32, fl, al, ha), x86_64_linux.off_stack_space)
  qed
  // the live objects: exec's stack data, rsp to the stack's top
  have c6: all a. a in omega -> a in H.objs.live -> (int_le(x86_64_linux.stack_floor(H.vm), a) && int_lt(a, H.vm.stack_top)) && int_lt(a, x86_64_linux.TASK_SIZE) proof
    fix a
    assume ha hl
    have i1 i2 := unsel(rewrite(hHl, hl))
    have g: (int_le(x86_64_linux.stack_floor(V), a) && int_lt(a, V.stack_top)) && int_lt(a, x86_64_linux.TASK_SIZE)
      by defs(arith(vtop, vlim, st, sl, sp3, sp4, sp2, h1, i1, i2, ha), x86_64_linux.stack_floor, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
    show := rewrite(sym(hHv), g)
  qed
  have c8v: int_le(V.stack_top, x86_64_linux.TASK_SIZE) by defs(arith(vtop, st, sp3, sp2), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
  have c8: int_le(H.vm.stack_top, x86_64_linux.TASK_SIZE) := rewrite(sym(hHv), c8v)
  have he2 hb2 hcd2 := musl.prog
  show by defs(simp(hHv, hHf, hHc, c1, tok, cok, c4, cd, cs, c6, c7, c8, hb2, hcd2, keep(abi.loaded, abi.code_at, x86_64_linux.off_stack_space)), malloc.world_ok, abi.loaded)
qed

// ----------------------------------------------------------------------
//  the allocator's invariant at main's call

// (pw.MM's view: V)
theorem pw.mm_view: all s V fs ob w. V in x86_64_linux.Vm -> startup_specs.frame(ui.wvm(s.vm), V, ob, w) -> ui.wvm(pw.MM(s, V, fs).vm) = V
proof
  fix s V fs ob w
  assume hv hfr
  have fb _ := expand(hfr, startup_specs.frame)
  have ve := apply(pw.v_bytes, {ui.wvm(s.vm)}, {V}, hv, fb)
  have mv: pw.MM(s, V, fs).vm = fn_update(s.vm, "bytes", V.bytes) by simp()
  show := trans(rewrite(sym(mv), all_elim(pw.wvm_b, {s.vm}, {V.bytes})), sym(ve))
qed

// main entered at pw.MM (startup's effect from _start_c's entry): a heap
// with V, no blocks, the thread at fs, the initial stack live -- in
// mallocng's invariant
theorem pw.inv_w1: all m0 s lo top argv envp auxv V fs H. ui.SX(m0, s, lo, top, argv, envp, auxv) ->
  ui.at_main(s, ui.iobjs(m0.gpr[4], top), pw.MM(s, V, fs), m0.gpr[4], V, fs) ->
  H in rec_and(abi.World, malloc.Heap.ghost) -> H.vm = V -> H.blocks = fn_build(bits(64), x. none) -> H.fs_base = fs -> H.objs.live = ui.iobjs(m0.gpr[4], top) ->
  H in musl.inv
proof
  fix m0 s lo top argv envp auxv V fs H
  assume hx hat hHw hHv hHb hHf hHl
  let M := pw.MM(s, V, fs)
  let S := claim_malloc.empty_heap(M, ui.OB(m0, argv, envp))
  let A := ui.A0(m0, argv, envp, auxv)
  have hv hfr _ _ _ _ _ _ := expand(hat, ui.at_main)
  have h: ui.MX(m0, s, lo, top, argv, envp, auxv, M, V, fs) by defs(conj(hx, hat), ui.MX)
  have r0 := apply(ui.rep_main[m0 := m0, s := s, lo := lo, top := top, argv := argv, envp := envp, auxv := auxv, m := M, V := V, fs := fs], h)
  have at al := apply(ui.mx_typ[m0 := m0, s := s, lo := lo, top := top, argv := argv, envp := envp, auxv := auxv, m := M, V := V, fs := fs], h)
  have {aa = abs} := apply(mp.a0_type[AT := ui.AT(m0, argv, envp), L := auxv], at, al)
  have wv := apply(pw.mm_view, {s}, {V}, {fs}, {abi.wob(ui.iobjs(m0.gpr[4], top), abi.cball)}, {startup_specs.start_writes(ui.G)}, hv, hfr)
  have sv0: S.vm = claim_malloc.c_vm(M.vm) by defs(rsimp(), claim_malloc.empty_heap)
  have sv: S.vm = V := trans(sv0, trans(all_elim(ui.cv_eq, {M.vm}), wv))
  have sb: S.blocks = fn_build(bits(64), x. none) by defs(rsimp(), claim_malloc.empty_heap)
  have sf: S.fs_base = fs by defs(rsimp(), claim_malloc.empty_heap)
  // (the vector's bytes: on the initial stack, live)
  have ax: mallocng.aux_live(A, H.objs) proof
    unfold mallocng.aux_live
    assume _
    fix x
    assume hxo hr
    have i1 i2 _ := apply(ui.ax_in[m0 := m0, s := s, lo := lo, top := top, argv := argv, envp := envp, auxv := auxv, x := x], hx, hxo, hr)
    show := rewrite(sym(hHl), (x in ui.iobjs(m0.gpr[4], top) by sel(taut(hxo, i1, i2))))
  qed
  have r2 := apply(pw.rep_xfer, {ui.C}, {A}, {S}, {H}, r0, trans(hHv, sym(sv)), trans(hHb, sym(sb)), trans(hHf, sym(sf)), ax)
  have i1 := apply(mallocng.inv_intro[c := ui.C, s := H, A := A], hHw, aa, r2)
  have e: musl.cfg = ui.C by defs(refl({ui.C}), musl.cfg)
  show by defs(rewrite(sym(e), i1), musl.inv)
qed

// ----------------------------------------------------------------------
//  exit's words at main's call: exec's, kept by startup's frame

// (startup's writes: the spans of its globals -- apart from exit's lock
// and the dtors' completed byte)
theorem pw.sw_at: all x. x in startup_specs.start_writes(ui.G) ->
  (int_le(4227080, x) && int_lt(x, 4227084)) || (int_le(4227112, x) && int_lt(x, 4227120)) || (int_le(4227128, x) && int_lt(x, 4227264)) ||
  (int_le(4228256, x) && int_lt(x, 4228688))
proof
  fix x
  assume h
  rsimp startup_specs.start_writes, startup_specs.span in h
  have _ d := unsel(h)
  have c1 := apply(ui.span_c[x := x, a := c_src_env___libc_start_main.__libc, n := 1, L := 4227128, U := 4227264], eval(), eval())
  have c2 := apply(ui.span_c[x := x, a := int_add(c_src_env___libc_start_main.__libc, 8), n := 48, L := 4227128, U := 4227264], eval(), eval())
  have c3 := apply(ui.span_c[x := x, a := c_src_env___libc_start_main.__environ, n := 8, L := 4228256, U := 4228688], eval(), eval())
  have c4 := apply(ui.span_c[x := x, a := c_src_env___libc_start_main.__hwcap, n := 8, L := 4227128, U := 4227264], eval(), eval())
  have c5 := apply(ui.span_c[x := x, a := c_src_env___libc_start_main.__sysinfo, n := 8, L := 4227128, U := 4227264], eval(), eval())
  have c6 := apply(ui.span_c[x := x, a := c_src_env___libc_start_main.__progname, n := 8, L := 4227128, U := 4227264], eval(), eval())
  have c7 := apply(ui.span_c[x := x, a := c_src_env___libc_start_main.__progname_full, n := 8, L := 4227128, U := 4227264], eval(), eval())
  have c8 := apply(ui.span_c[x := x, a := c_src_env___init_tls.__default_stacksize, n := 4, L := 4227080, U := 4227084], eval(), eval())
  have c9 := apply(ui.span_c[x := x, a := c_src_env___init_tls.builtin_tls, n := 336, L := 4228256, U := 4228688], eval(), eval())
  have c10 := apply(ui.span_c[x := x, a := c_src_env___init_tls.main_tls, n := 48, L := 4228256, U := 4228688], eval(), eval())
  have c11 := apply(ui.span_c[x := x, a := c_src_env___stack_chk_fail.__stack_chk_guard, n := 8, L := 4227112, U := 4227120], eval(), eval())
  show by taut(d, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11)
qed

// (usable with other objects: the same live ones, the bytes the C world's
// in both)
theorem pw.usable_cb(vm, o1, o2, a, n, w): gimple.usable(vm, o1, a, n, w) -> o2.live = o1.live ->
  (all i. i in omega -> int_lt(i, n) -> int_add(a, i) in o1.c_bytes -> int_add(a, i) in o2.c_bytes) -> gimple.usable(vm, o2, a, n, w)
proof
  assume hu hl hc
  let P(i) := int_div(int_add(a, i), x86_64_linux.PAGE)
  let C(i) := x86_64_linux.mapped(vm, P(i)) && !(snd(vm.pages[P(i)]).kind = 2)
  let X(i, ob) := ite(w, snd(vm.pages[P(i)]).prot.w, snd(vm.pages[P(i)]).prot.r) && int_add(a, i) in ob.c_bytes
  let Y(i, ob) := int_lt(int_add(a, i), int_pow(2, 64)) && int_add(a, i) in ob.live
  have g: all i. i in omega -> int_lt(i, n) -> ite(C(i), X(i, o2), Y(i, o2)) proof
    fix i
    assume hi hn
    have ui := mp(all_elim(expand(hu, gimple.usable), {i}), hi, hn)
    have c1: C(i) -> ite(C(i), X(i, o2), Y(i, o2)) proof
      assume h1
      have x1 x2 := rewrite(mp(ite_t[c := C(i), a := X(i, o1), b := Y(i, o1)], h1), ui)
      have x3 := mp(all_elim(hc, {i}), hi, hn, x2)
      show := rewrite(sym(mp(ite_t[c := C(i), a := X(i, o2), b := Y(i, o2)], h1)), (X(i, o2) by taut(x1, x3)))
    qed
    have c2: !C(i) -> ite(C(i), X(i, o2), Y(i, o2)) proof
      assume h1
      have y1 y2 := rewrite(mp(ite_f[c := C(i), a := X(i, o1), b := Y(i, o1)], h1), ui)
      have y3: int_add(a, i) in o2.live := rewrite(sym(hl), y2)
      show := rewrite(sym(mp(ite_f[c := C(i), a := X(i, o2), b := Y(i, o2)], h1)), (Y(i, o2) by taut(y1, y3)))
    qed
    show by taut(c1, c2)
  qed
  show by defs(g, gimple.usable)
qed

// (n bytes of the image's read-only or data pages, none startup's
// writes: V's as the view's)
theorem pw.v_img_bytes: all argv envp m0 s lo top V ob a n. x86_64_linux.exec_state(musl_malloc.file, argv, envp, m0) -> ui.ctx(m0, s, lo, top) -> int_lt(1032, lo) ->
  startup_specs.frame(ui.wvm(s.vm), V, ob, startup_specs.start_writes(ui.G)) -> a in omega -> n in omega -> int_le(int_add(a, n), 4228688) ->
  (all i. i in omega -> int_lt(i, n) -> ui.img_page(int_div(int_add(a, i), x86_64_linux.PAGE), false) && !(int_add(a, i) in startup_specs.start_writes(ui.G))) ->
  gimple.bytes_at(V, a, n) = gimple.bytes_at(ui.wvm(s.vm), a, n)
proof
  fix argv envp m0 s lo top V ob a n
  assume he hc hlo hfr ha hn hl hp
  have _ fo := expand(hfr, startup_specs.frame)
  have be: all i. i in omega -> int_lt(i, n) -> V.bytes[bits_add(64, a, bits_of_int(64, i))] = ui.wvm(s.vm).bytes[bits_add(64, a, bits_of_int(64, i))] proof
    fix i
    assume hi hil
    have pi nw := mp(all_elim(hp, {i}), hi, hil)
    have ea := apply(ms.add_i, {a}, {i}, ha, hi, arith(hl, hil, hi, ha, hn))
    have wi := apply(ui.w_img[argv := argv, envp := envp, m0 := m0, s := s, lo := lo, top := top, p := int_div(int_add(a, i), x86_64_linux.PAGE), w := false],
      he, hc, hlo, (int_div(int_add(a, i), x86_64_linux.PAGE) in omega by defs(arith(ha, hi), x86_64_linux.PAGE)), pi)
    have wm wk _ _ _ := wi
    have nsf: !abi.stack_free(ui.wvm(s.vm), ob, int_add(a, i)) by defs(taut(wm, wk), abi.stack_free)
    have q := mp(all_elim(fo, {int_add(a, i)}), (int_add(a, i) in bits(64) by arith(hl, hil, hi, ha)), nw, nsf)
    show := rewrite(sym(ea), q)
  qed
  show := apply(mp.bytes_same[U := V, vm := ui.wvm(s.vm), a := a, n := n], hn, be)
qed

// (bytes on the data pages 1031 and 1032: image pages)
theorem pw.img_rng: all a n w. a in omega -> n in omega -> int_le(4222976, a) -> int_le(int_add(a, n), 4231168) ->
  all i. i in omega -> int_lt(i, n) -> ui.img_page(int_div(int_add(a, i), x86_64_linux.PAGE), w)
proof
  fix a n w
  assume ha hn h1 h2
  fix i
  assume hi hil
  show by defs(arith(ha, hn, h1, h2, hi, hil), x86_64_linux.PAGE)
qed

// exit's precondition at main's call: exit's words exec's (the lock and
// completed byte in the .bss, the fini_array entry and the GOT word from
// the file), startup's frame keeping them; the thread set up
theorem pw.xpre_w1: all argv envp m0 s lo top V fs. x86_64_linux.exec_state(musl_malloc.file, argv, envp, m0) -> ui.ctx(m0, s, lo, top) -> int_lt(1032, lo) ->
  V in x86_64_linux.Vm -> startup_specs.frame(ui.wvm(s.vm), V, abi.wob(ui.iobjs(m0.gpr[4], top), abi.cball), startup_specs.start_writes(ui.G)) ->
  fs in bits(64) -> startup_specs.thread_at(ui.G, V, fs) ->
  startup_specs.exit_pre(V, abi.wob(ui.iobjs(m0.gpr[4], top), abi.cbytes0(fs)), xt.XP, fs)
proof
  fix argv envp m0 s lo top V fs
  assume he hc hlo hv hfr hfb hta
  let W := ui.wvm(s.vm)
  let OB0 := abi.wob(ui.iobjs(m0.gpr[4], top), abi.cball)
  let OB := abi.wob(ui.iobjs(m0.gpr[4], top), abi.cbytes0(fs))
  have fb _ := expand(hfr, startup_specs.frame)
  have ve := apply(pw.v_bytes, {W}, {V}, hv, fb)
  have vp: V.pages = W.pages by simp(apply(ui.app_eq[k := "pages"], ve))
  have ts it := expand(hta, startup_specs.thread_at)
  have tok _ tid := expand(ts, startup_specs.thread_set)
  have it1 it2 := expand(it, startup_specs.in_tls)
  have bt: ui.G.builtin_tls = 4228288 by eval()
  have fr: int_le(4228288, fs) && int_le(int_add(fs, 200), 4228624) by arith(it1, it2, bt, hfb)
  // (usable bytes on the data pages, none the canary's: V's)
  have U: all a n w. a in omega -> n in omega -> int_le(4222976, a) -> int_le(int_add(a, n), 4231168) ->
      (all i. i in omega -> int_lt(i, n) -> !(int_add(a, i) in abi.canary(fs))) -> gimple.usable(V, OB, a, n, w) proof
    fix a n w
    assume ha hn h1 h2 hnc
    have u0 := apply(ui.us_img[argv := argv, envp := envp, m0 := m0, s := s, lo := lo, top := top, x := a, n := n, w := w], he, hc, hlo, ha,
      apply(pw.img_rng, {a}, {n}, {w}, ha, hn, h1, h2))
    have pe: all i. i in omega -> int_lt(i, n) -> V.pages[int_div(int_add(a, i), x86_64_linux.PAGE)] = W.pages[int_div(int_add(a, i), x86_64_linux.PAGE)] proof
      fix i
      assume _ _
      show := apply(ui.app_eq[k := int_div(int_add(a, i), x86_64_linux.PAGE)], vp)
    qed
    have u1 := apply(mp.usable_pg[vm := W, vm2 := V, objs := ui.wob0(m0.gpr[4], top), a := a, n := n, w := w], pe, u0)
    have cb: all i. i in omega -> int_lt(i, n) -> int_add(a, i) in ui.wob0(m0.gpr[4], top).c_bytes -> int_add(a, i) in OB.c_bytes proof
      fix i
      assume hi hil _
      show by simp(mp(all_elim(hnc, {i}), hi, hil), (int_add(a, i) in omega by arith(ha, hi)))
    qed
    show := apply(pw.usable_cb[vm := V, o1 := ui.wob0(m0.gpr[4], top), o2 := OB, a := a, n := n, w := w], u1, simp(), cb)
  qed
  // (bytes on the data pages, none startup's writes: V's the view's)
  have B: all a n. a in omega -> n in omega -> int_le(4222976, a) -> int_le(int_add(a, n), 4228688) ->
      (all i. i in omega -> int_lt(i, n) -> !(int_add(a, i) in startup_specs.start_writes(ui.G))) -> gimple.bytes_at(V, a, n) = gimple.bytes_at(W, a, n) proof
    fix a n
    assume ha hn h1 h2 hnw
    have pg := apply(pw.img_rng, {a}, {n}, {false}, ha, hn, h1, (int_le(int_add(a, n), 4231168) by arith(h2)))
    have hp: all i. i in omega -> int_lt(i, n) -> ui.img_page(int_div(int_add(a, i), x86_64_linux.PAGE), false) && !(int_add(a, i) in startup_specs.start_writes(ui.G)) proof
      fix i
      assume hi hil
      show by taut(mp(all_elim(pg, {i}), hi, hil), mp(all_elim(hnw, {i}), hi, hil))
    qed
    show := apply(pw.v_img_bytes[argv := argv, envp := envp, m0 := m0, s := s, lo := lo, top := top, V := V, ob := OB0, a := a, n := n], he, hc, hlo, hfr, ha, hn, h2, hp)
  qed
  // (exit's words apart from startup's writes, from the canary)
  have nw: all a n. a in omega -> n in omega -> int_le(int_add(a, n), 4227080) || (int_le(4227084, a) && int_le(int_add(a, n), 4227112)) ||
      (int_le(4227120, a) && int_le(int_add(a, n), 4227128)) -> (all i. i in omega -> int_lt(i, n) -> !(int_add(a, i) in startup_specs.start_writes(ui.G))) proof
    fix a n
    assume ha hn hr
    fix i
    assume hi hil hw
    have q := apply(pw.sw_at, hw)
    show by arith(q, hr, hi, hil, ha)
  qed
  have nc: all a n. a in omega -> n in omega -> int_le(int_add(a, n), 4227128) -> (all i. i in omega -> int_lt(i, n) -> !(int_add(a, i) in abi.canary(fs))) proof
    fix a n
    assume ha hn hr
    fix i
    assume hi hil hcn
    have _ c1 _ := unsel(expand(hcn, abi.canary))
    show by arith(c1, fr, hr, hi, hil)
  qed
  // the thread's id word
  have n48: all i. i in omega -> int_lt(i, 4) -> !(int_add(int_add(fs, 48), i) in abi.canary(fs)) proof
    fix i
    assume hi hil hcn
    have _ _ c2 := unsel(expand(hcn, abi.canary))
    show by arith(c2, hi)
  qed
  have u48 := mp(all_elim(U, {int_add(fs, 48)}, {4}, {false}), (int_add(fs, 48) in omega by arith(hfb)), simp(), (int_le(4222976, int_add(fs, 48)) by arith(fr)),
    (int_le(int_add(int_add(fs, 48), 4), 4231168) by arith(fr)), n48)
  // the lock: .bss, zero
  have {g3 = s3} := ui.elf
  have _ bss := apply(ui.seg_bytes[argv := argv, envp := envp, m0 := m0, j := 3, ty := 1, fl := 6, of := 28616, va := 4227016, fs := 72, ms := 1672], he, eval(), eval(), g3)
  have lk: pw.LK = 4227120 by eval()
  have lw0 := apply(ui.w_img_bytes[argv := argv, envp := envp, m0 := m0, s := s, lo := lo, top := top, a := 4227120, n := 4], he, hc, hlo, eval(), eval(), eval(),
    apply(pw.img_rng, {4227120}, {4}, {false}, eval(), eval(), eval(), eval()))
  have lzs: all j. j in omega -> int_lt(j, 4) -> m0.vm.bytes[bits_of_int(64, int_add(4227120, j))] = 0 proof
    fix j
    assume hj hjl
    show := mp(all_elim(bss, {int_add(4227120, j)}), arith(hj), arith(hj), arith(hj, hjl))
  qed
  have lw := trans(lw0, trans(apply(ui.bytes_zero[vm := m0.vm, a := 4227120, n := 4], eval(), eval(), eval(), lzs), (int_sum(0, 4, i. 0) = 0 by eval())))
  have lv := trans(mp(all_elim(B, {4227120}, {4}), eval(), eval(), eval(), eval(), mp(all_elim(nw, {4227120}, {4}), eval(), eval(), eval())), lw)
  // the fini_array entry, the GOT word: the file's
  have ff := apply(ui.img_read[argv := argv, envp := envp, m0 := m0, s := s, lo := lo, top := top, j := 3, ty := 1, fl := 6, of := 28616, va := 4227016, fs := 72, ms := 1672,
    a := 4227024, n := 8], he, hc, hlo, eval(), eval(), g3, eval(), eval(), eval(), eval(), eval(), eval(), eval(),
    apply(pw.img_rng, {4227024}, {8}, {false}, eval(), eval(), eval(), eval()))
  have fv := trans(mp(all_elim(B, {4227024}, {8}), eval(), eval(), eval(), eval(), mp(all_elim(nw, {4227024}, {8}), eval(), eval(), eval())),
    trans(rewrite((int_add(28616, int_sub(4227024, 4227016)) = 28624 by eval()), ff),
      apply(ui.le_val[F := musl_malloc.file, off := 28624, n := 8, v := 4198784], unfold(musl_malloc.file), eval(), eval(), eval(), eval(), eval())))
  have gf := apply(ui.img_read[argv := argv, envp := envp, m0 := m0, s := s, lo := lo, top := top, j := 3, ty := 1, fl := 6, of := 28616, va := 4227016, fs := 72, ms := 1672,
    a := 4227040, n := 8], he, hc, hlo, eval(), eval(), g3, eval(), eval(), eval(), eval(), eval(), eval(), eval(),
    apply(pw.img_rng, {4227040}, {8}, {false}, eval(), eval(), eval(), eval()))
  have gv := trans(mp(all_elim(B, {4227040}, {8}), eval(), eval(), eval(), eval(), mp(all_elim(nw, {4227040}, {8}), eval(), eval(), eval())),
    trans(rewrite((int_add(28616, int_sub(4227040, 4227016)) = 28640 by eval()), gf),
      apply(ui.le_val[F := musl_malloc.file, off := 28640, n := 8, v := 0], unfold(musl_malloc.file), eval(), eval(), eval(), eval(), eval())))
  // usable: the lock, completed (read and written), the fini_array entry and the GOT word (read)
  have ul := mp(all_elim(U, {4227120}, {4}, {false}), eval(), eval(), eval(), eval(), mp(all_elim(nc, {4227120}, {4}), eval(), eval(), eval()))
  have ulw := mp(all_elim(U, {4227120}, {4}, {true}), eval(), eval(), eval(), eval(), mp(all_elim(nc, {4227120}, {4}), eval(), eval(), eval()))
  have uf := mp(all_elim(U, {4227024}, {8}, {false}), eval(), eval(), eval(), eval(), mp(all_elim(nc, {4227024}, {8}), eval(), eval(), eval()))
  have uc := mp(all_elim(U, {4227104}, {1}, {false}), eval(), eval(), eval(), eval(), mp(all_elim(nc, {4227104}, {1}), eval(), eval(), eval()))
  have ucw := mp(all_elim(U, {4227104}, {1}, {true}), eval(), eval(), eval(), eval(), mp(all_elim(nc, {4227104}, {1}), eval(), eval(), eval()))
  have ug := mp(all_elim(U, {4227040}, {8}, {false}), eval(), eval(), eval(), eval(), mp(all_elim(nc, {4227040}, {8}), eval(), eval(), eval()))
  have xv: xt.XP.lock = 4227120 && xt.XP.fini_array = 4227024 && xt.XP.dtors = 4198784 && xt.XP.completed = 4227104 && xt.XP.cxa_got = 4227040 by eval()
  show by defs(simp(xv, tok, u48, tid, fr, ul, ulw, lv, uf, fv, uc, ucw, ug, gv, keep(gimple.usable, gimple.bytes_at, abi.thread_ok)), startup_specs.exit_pre)
qed
