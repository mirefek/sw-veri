// A witness that the program's runs are not vacuous: a concrete exec state
// of the binary (argv = ["test_malloc"], no environment, uid 1000) whose
// run reaches `main`.

// a page as exec maps it
abbrev wit.PG(r, w, x, k) := some(fn_update(fn_update(empty, "prot", fn_update(fn_update(fn_update(empty, "r", r), "w", w), "x", x)), "kind", k))

// the stack's 32 pages below TASK_SIZE, the image's pages (the first's,
// the text's, the read-only data's, the data's)
def wit.pg_at(p) :=
  ite(int_le(34359738335, p) && int_lt(p, 34359738367), wit.PG(true, true, false, 2),
  ite(int_le(1031, p) && int_le(p, 1032), wit.PG(true, true, false, 0),
  ite(p = 1030, wit.PG(true, false, false, 0),
  ite(int_le(1025, p) && int_le(p, 1029), wit.PG(true, false, true, 0),
  ite(p = 1024, wit.PG(true, false, false, 0), none)))))
def wit.pages := fn_build(set_select(omega, p. int_lt(p, 34359738367)), p. wit.pg_at(p))

// the initial stack's 288 bytes from rsp: argc 1, argv[0], 0, 0 (no
// environment), the auxv (PHDR, PHENT, PHNUM, PAGESZ, ENTRY, UID, EUID, GID,
// EGID, SECURE, RANDOM, EXECFN, NULL), the 16 random bytes, "test_malloc"
def wit.stack := bytes_seq(bytes"")

// memory: the stack, the loads' file bytes (the data's bss zero), else 0
def wit.byte_at(a) :=
  ite(int_le(140737488350944, a) && int_lt(a, 140737488351232), wit.stack[int_sub(a, 140737488350944)],
  ite(int_le(4227016, a) && int_lt(a, 4228688), ite(int_lt(a, 4227088), musl_malloc.file[int_add(int_sub(a, 4227016), 28616)], 0),
  ite(int_le(4218880, a) && int_lt(a, 4219272), musl_malloc.file[int_add(int_sub(a, 4218880), 24576)],
  ite(int_le(4198400, a) && int_lt(a, 4216692), musl_malloc.file[int_add(int_sub(a, 4198400), 4096)],
  ite(int_le(4194304, a) && int_lt(a, 4194816), musl_malloc.file[int_sub(a, 4194304)], 0)))))
def wit.bytes := fn_build(bits(64), a. wit.byte_at(a))

def wit.vm := fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(empty,
  "pages", wit.pages), "bytes", wit.bytes), "stack_top", 140737488351232), "stack_limit", 8388608),
  "brk_start", 4296704), "brk", 4296704)

def wit.os := fn_update(fn_update(fn_update(fn_update(empty, "input", empty), "events", empty),
  "creds", fn_update(fn_update(fn_update(fn_update(empty, "uid", 1000), "euid", 1000), "gid", 1000), "egid", 1000)), "secure", false)

def wit.flags := fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(empty,
  "cf", false), "pf", false), "af", false), "zf", false), "sf", false), "df", false), "of", false)

// rsp the stack's data, rip the entry, the rest zero
def wit.m0 := fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(fn_update(empty,
  "gpr", fn_build(x86_64_linux.Reg, r. ite(r = 4, 140737488350944, 0))), "xmm", fn_build(x86_64_linux.Reg, r. 0)),
  "rip", 4198543), "flags", wit.flags), "cpu", fn_update(fn_update(empty, "bmi1", false), "pku", false)),
  "fs_base", 0), "gs_base", 0), "vm", wit.vm), "os", wit.os)
