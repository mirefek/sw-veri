// main's callees as malloc.sl has them (layers/malloc.sl): malloc's
// outcomes (malloc_client.core's, and those through set_errno's loop),
// the call rules for musl's malloc and free at main's calls.

// set_errno's run from W: errno's four bytes written, nothing else
theorem malloc.seterr_run(e, x, W, t, v): fn_update(W, "vm", W.vm) = W -> W.vm in x86_64_linux.Vm -> runs(malloc.set_errno(e, x), W, ok(t, v)) ->
  t = fn_update(W, "vm", t.vm) && fn_update(t.vm, "bytes", W.vm.bytes) = W.vm &&
  (all a. a in bits(64) -> (all j. j in omega -> int_lt(j, 4) -> !(a = bits_add(64, bits_add(64, W.fs_base, bits_of_int(64, e[empty])), bits_of_int(64, j)))) ->
     t.vm.bytes[a] = W.vm.bytes[a])
proof
  assume hw0 hv hr
  step h1 from hr
  obtain r, wl kr from h1
  let BODY(l, y) := loop_body(wl)
  let EA(j) := bits_add(64, bits_add(64, W.fs_base, bits_of_int(64, e[empty])), bits_of_int(64, j))
  let FR(U) := fn_update(U, "bytes", W.vm.bytes) = W.vm && (all a. a in bits(64) -> (all j. j in omega -> int_lt(j, 4) -> !(a = EA(j))) -> U.bytes[a] = W.vm.bytes[a])
  let PI(l) := ex k U. ((k in omega && int_le(k, 4)) && FR(U)) && l = pair(fn_update(W, "vm", U), k)
  let M(l) := int_sub(4, snd(l))
  have f0: FR(W.vm) proof
    have a1: fn_update(W.vm, "bytes", W.vm.bytes) = W.vm by simp(hv)
    have a2: all a. a in bits(64) -> (all j. j in omega -> int_lt(j, 4) -> !(a = EA(j))) -> W.vm.bytes[a] = W.vm.bytes[a] proof
      fix a
      assume _ _
      show := refl({W.vm.bytes[a]})
    qed
    show by taut(a1, a2)
  qed
  have p0: PI(pair(W, 0)) by ex_intro({0}, {W.vm}, taut((0 in omega by simp()), (int_le(0, 4) by arith()), f0, (pair(W, 0) = pair(fn_update(W, "vm", W.vm), 0) by simp(hw0))))
  have pm: all l. PI(l) -> M(l) in omega proof
    fix l
    assume hp
    obtain k U, hk hk4 _ _ hx from hp
    show by simp(hx, (int_sub(4, k) in omega by arith(hk, hk4)))
  qed
  have nx: all l l2. PI(l) -> BODY(l, ok(l2, empty)) -> PI(l2) && int_lt(M(l2), M(l)) proof
    fix l l2
    assume hp hb
    obtain k U, hk hk4 f1 f2 hx from hp
    let V8 := bits_of_int(8, int_div(x, int_pow(256, k)))
    let U2 := fn_update(U, "bytes", fn_update(U.bytes, EA(k), V8))
    have kl e2 := (int_lt(k, 4) && l2 = pair(fn_update(W, "vm", U2), int_add(k, 1)) by simp(rewrite(hx, hb)))
    have g1: fn_update(U2, "bytes", W.vm.bytes) = W.vm := trans((fn_update(U2, "bytes", W.vm.bytes) = fn_update(U, "bytes", W.vm.bytes) by simp()), f1)
    have g2: all a. a in bits(64) -> (all j. j in omega -> int_lt(j, 4) -> !(a = EA(j))) -> U2.bytes[a] = W.vm.bytes[a] proof
      fix a
      assume ha hn
      have ne := mp(all_elim(hn, {k}), hk, kl)
      have q := mp(app_update_other[f := U.bytes, k := EA(k), v := V8, x := a], ne)
      have q2: U2.bytes[a] = U.bytes[a] by simp(q)
      show := trans(q2, mp(all_elim(f2, {a}), ha, hn))
    qed
    have p2: PI(l2) by ex_intro({int_add(k, 1)}, {U2}, taut((int_add(k, 1) in omega by arith(hk)), (int_le(int_add(k, 1), 4) by arith(kl)), g1, g2, e2))
    have m2: int_lt(M(l2), M(l)) by simp(e2, hx, (int_lt(int_sub(4, int_add(k, 1)), int_sub(4, k)) by arith(hk)))
    show by taut(p2, m2)
  qed
  have wv := apply(g.loop[b := l y. BODY(l, y), p := l. PI(l), m := l. M(l)], p0, pm, nx, wl)
  obtain l, hpl bb nk from wv
  obtain k U, hk hk4 f1 f2 hx from hpl
  have ok1: !(int_lt(k, 4)) proof
    assume kl
    have e3: r = ok(pair(fn_update(W, "vm", fn_update(U, "bytes", fn_update(U.bytes, EA(k), bits_of_int(8, int_div(x, int_pow(256, k)))))), int_add(k, 1)), empty)
      by simp(rewrite(hx, bb), kl)
    have io: is_ok(r) by defs(ex_intro({pair(fn_update(W, "vm", fn_update(U, "bytes", fn_update(U.bytes, EA(k), bits_of_int(8, int_div(x, int_pow(256, k)))))), int_add(k, 1))}, {empty}, e3), is_ok)
    show by taut(io, nk)
  qed
  have er: r = exc(pair(fn_update(W, "vm", U), k), pair("brk", empty)) by simp(rewrite(hx, bb), ok1)
  have te: t = fn_update(W, "vm", U) by simp(rewrite(er, kr))
  have tv: t.vm = U by simp(te)
  show by taut(rewrite(sym(tv), te), rewrite(sym(tv), f1), rewrite(sym(tv), f2))
qed

// malloc returning 0: an allocator step to some memory V (the world as
// any call needs it), then errno written -- its four bytes only
theorem malloc.malloc_zero(i, o, e, b, c, st, n, s, t):
  runs(malloc.malloc(i, o, e, b, c, st, n), s, ok(t, 0)) -> s in rec_and(abi.World, malloc.Heap.ghost) -> s in i -> malloc.errno_ok(e, s) ->
  malloc.world_ok(b, c, st, s) ->
  ex V. V in x86_64_linux.Vm && malloc.step_ok(i, o, s, fn_update(s, "vm", V), malloc.errno_bytes(e, s)) && malloc.world_ok(b, c, st, fn_update(s, "vm", V)) &&
    t = fn_update(s, "vm", t.vm) && fn_update(t.vm, "bytes", V.bytes) = V &&
    (all a. a in bits(64) -> (all j. j in omega -> int_lt(j, 4) -> !(a = bits_add(64, bits_add(64, s.fs_base, bits_of_int(64, e[empty])), bits_of_int(64, j)))) ->
       t.vm.bytes[a] = V.bytes[a])
proof
  assume h ht hi he hwo
  have hs0 := mp(mp(malloc.idle_step[i := i, o := o, s := s, x := malloc.errno_bytes(e, s)], ht), hi)
  obtain vm, hv hst hse from hs0
  have hs: ex vm. vm in x86_64_linux.Vm && (malloc.step_ok(i, o, s, fn_update(s, "vm", vm), malloc.errno_bytes(e, s)) &&
      malloc.world_ok(b, c, st, fn_update(s, "vm", vm))) by ex_intro({vm}, taut(hv, hst, rewrite(sym(hse), hwo)))
  have k: ex V v0. (V in x86_64_linux.Vm && malloc.step_ok(i, o, s, fn_update(s, "vm", V), malloc.errno_bytes(e, s)) &&
      malloc.world_ok(b, c, st, fn_update(s, "vm", V))) && runs(malloc.set_errno(e, x86_64_linux.ENOMEM), fn_update(s, "vm", V), ok(t, v0))
    by simp(h, hi, he, hwo, hs, keep(malloc.set_errno))
  obtain V v0, kv kst kwo kr from k
  have r1 r2 r3 := apply(malloc.seterr_run[e := e, x := x86_64_linux.ENOMEM, W := fn_update(s, "vm", V), t := t, v := v0], (fn_update(fn_update(s, "vm", V), "vm", fn_update(s, "vm", V).vm) = fn_update(s, "vm", V) by simp()),
    (fn_update(s, "vm", V).vm in x86_64_linux.Vm by simp(kv)), kr)
  have t1: t = fn_update(s, "vm", t.vm) by simp(r1)
  show by ex_intro({V}, simp(kv, kst, kwo, t1, r2, r3))
qed

// malloc where defined: a return (it neither raises nor diverges)
theorem malloc.malloc_ret(i, o, e, b, c, st, n, s, x):
  runs(malloc.malloc(i, o, e, b, c, st, n), s, x) -> s in rec_and(abi.World, malloc.Heap.ghost) -> s in i -> malloc.errno_ok(e, s) ->
  malloc.world_ok(b, c, st, s) -> ex t v. x = ok(t, v)
proof
  assume h ht hi he hwo
  have hs0 := mp(mp(malloc.idle_step[i := i, o := o, s := s, x := malloc.errno_bytes(e, s)], ht), hi)
  obtain vm, hv hst hse from hs0
  have hs: ex vm. vm in x86_64_linux.Vm && (malloc.step_ok(i, o, s, fn_update(s, "vm", vm), malloc.errno_bytes(e, s)) &&
      malloc.world_ok(b, c, st, fn_update(s, "vm", vm))) by ex_intro({vm}, taut(hv, hst, rewrite(sym(hse), hwo)))
  show by simp(h, hi, he, hwo, hs, {l0 l. snd(l) in omega && int_le(snd(l), 4)}, {l. int_sub(4, snd(l))})
qed

// the ABI's malloc (its value widened to a pair of words), where defined:
// malloc's return at its argument
theorem tm.wm_ret(I, O, eo, b, cd, st, regs, S, X): regs in abi.ARGS -> ord_le(1, seq_len(regs)) ->
  runs(abi.wide(malloc.Heap.ghost, malloc.malloc_fun(I, O, eo, b, cd, st))[regs], S, X) ->
  S in rec_and(abi.World, malloc.Heap.ghost) -> S in I -> malloc.errno_ok(eo, S) -> malloc.world_ok(b, cd, st, S) ->
  ex T v z. runs(malloc.malloc(I, O, eo, b, cd, st, regs[0]), S, ok(T, v)) && X = ok(T, pair(v, z))
proof
  assume hra h1 h ht hi he hwo
  rsimp only, abi.wide, app_fn_build, hra in h
  have b1 := apply(g.runs_elim, h)
  obtain y, hy ky from expand(b1, bind_rel)
  rsimp only, malloc.malloc_fun, app_fn_build, hra in hy
  have b2 := apply(g.runs_elim, hy)
  have b3: bind_rel(malloc.malloc(I, O, eo, b, cd, st, regs[0]), S, x3 x4. y = ok(x3, x4), x3 x4. y = exc(x3, x4), x3. y = diverge(x3)) by taut(b2, h1)
  obtain Y, hY kY from expand(b3, bind_rel)
  obtain T v, eY from apply(malloc.malloc_ret[i := I, o := O, e := eo, b := b, c := cd, st := st, n := regs[0], s := S, x := Y], hY, ht, hi, he, hwo)
  have ey: y = ok(T, v) by simp(rewrite(eY, kY))
  have kz: any_rel(x5. x5 in bits(64), x5. X = ok(T, pair(v, x5))) by simp(rewrite(ey, ky), keep(any_rel))
  have ne: ex z. z in bits(64) by ex_intro({0}, simp())
  obtain z, _ hz from apply(g.any_e, ne, kz)
  show by ex_intro({T}, {v}, {z}, taut(rewrite(eY, hY), hz))
qed

// (a heap state's world and ghost parts: determined by it)
theorem tm.union_inj(a, b, c, d): a in abi.World -> c in abi.World -> b in malloc.Heap.ghost -> d in malloc.Heap.ghost ->
  union2(a, b) = union2(c, d) -> a = c && b = d
proof
  assume ha hc hb hd e
  have da: dom(a) = abi.WKEYS by simp(expand(ha, abi.World))
  have dc: dom(c) = abi.WKEYS by simp(expand(hc, abi.World))
  have ka := apply(abi.keys_of, da)
  have kc := apply(abi.keys_of, dc)
  have gb: all z. z in b -> !(fst(z) in abi.WKEYS) proof
    fix z
    assume hz
    have _ _ k := mp(all_elim(mp.hg_ok, {b}), hb)
    have _ k2 := mp(all_elim(k, {z}), hz)
    show := k2
  qed
  have gd: all z. z in d -> !(fst(z) in abi.WKEYS) proof
    fix z
    assume hz
    have _ _ k := mp(all_elim(mp.hg_ok, {d}), hd)
    have _ k2 := mp(all_elim(k, {z}), hz)
    show := k2
  qed
  have r1 := apply(abi.restrict_union_l[a := a, b := b, d := abi.WKEYS], ka, gb)
  have r2 := apply(abi.restrict_union_l[a := c, b := d, d := abi.WKEYS], kc, gd)
  have g1 := apply(abi.ghost_part_union_r[a := a, b := b, d := abi.WKEYS], ka, gb)
  have g2 := apply(abi.ghost_part_union_r[a := c, b := d, d := abi.WKEYS], kc, gd)
  have ac: a = c := trans(sym(r1), trans(subst({y. restrict(union2(a, b), abi.WKEYS) = restrict(y, abi.WKEYS)}, e, refl({restrict(union2(a, b), abi.WKEYS)})), r2))
  have bd: b = d := trans(sym(g1), trans(subst({y. ghost_part(union2(a, b), abi.WKEYS) = ghost_part(y, abi.WKEYS)}, e, refl({ghost_part(union2(a, b), abi.WKEYS)})), g2))
  show by taut(ac, bd)
qed

// (a heap state with its blocks B and memory V: the world with V joined
// with the ghost part with B)
theorem tm.split(t, h, B, V): t in abi.World -> t in univ(1) -> h in malloc.Heap.ghost -> V in x86_64_linux.Vm ->
  B in fn_space(bits(64), option(omega)) -> B in univ(1) ->
  fn_update(h, "blocks", B) in malloc.Heap.ghost &&
  fn_update(fn_update(union2(t, h), "blocks", B), "vm", V) = union2(fn_update(t, "vm", V), fn_update(h, "blocks", B))
proof
  assume hw hu hh hv hb hbu
  have hg := apply(mp.hg_updb[h := h, b2 := B], hh, hb, hbu)
  have k: fn_update(h, "blocks", B) = h || (ex B2. fn_update(h, "blocks", B) = fn_update(h, "blocks", B2)) by disj({2}, ex_intro({B}, refl({fn_update(h, "blocks", B)})))
  have {eq = eq} := apply(mp.top_rec[s := t, h := h, h2 := fn_update(h, "blocks", B), V := V], hw, hu, hh, hg, hv, k)
  have bb: fn_update(h, "blocks", B).blocks = B := app_update_same[f := h, k := "blocks", v := B]
  show by taut(hg, sym(rewrite(bb, eq)))
qed

// (its blocks set to themselves: the same state)
theorem tm.blk_same(t, h): t in abi.World -> h in malloc.Heap.ghost -> fn_update(union2(t, h), "blocks", h.blocks) = union2(t, h)
proof
  assume hw hh
  have sd: dom(t) = abi.WKEYS by simp(expand(hw, abi.World))
  have sk := apply(abi.keys_of, sd)
  have nb: all z. z in t -> fst(z) != "blocks" proof
    fix z
    assume hz
    show by simp(mp(all_elim(sk, {z}), hz))
  qed
  have e1 := mp(fn_update_union_r[a := t, b := h, k := "blocks", v := h.blocks], nb)
  have hd: dom(h) = insert("blocks", empty) by simp(expand(hh, malloc.Heap.ghost))
  have hf: is_fun(h) by simp(expand(hh, malloc.Heap.ghost))
  have s1 := mp(fn_update_same[f := h, k := "blocks"], hf, (("blocks" in dom(h)) by simp(hd)))
  show := rewrite(s1, e1)
qed

// ----------------------------------------------------------------------
//  malloc at main's call

// a callee gm the code of malloc: refining the ABI's malloc strictly (an
// overflow the ABI's); its outcomes, worlds and pairs of words
abbrev tm.mcallee(I, O, eo, b, cd, st, gm) := all args s h. args in abi.ARGS -> s in abi.World -> h in malloc.Heap.ghost ->
  mp.ref_s(gm[args], abi.wide(malloc.Heap.ghost, malloc.malloc_fun(I, O, eo, b, cd, st))[args], malloc.Heap.ghost, s, h)
abbrev tm.otyped(g) := all args s o. runs(g[args], s, o) ->
  abi.outcome(o) && (all x v. o = ok(x, v) -> v in cart(bits(64), bits(64))) && (all x v. o = ok(x, v) -> x in abi.World)

// malloc(n) at a call from the world t, the ghost part h: an overflow, or
// a return -- the memory V, the layer's malloc from t joined with h to
// V's world joined with some ghost part, its value r's word
theorem tm.malloc_q: all I O eo b cd st gm h t n regs o2. tm.mcallee(I, O, eo, b, cd, st, gm) -> tm.otyped(gm) ->
  t in abi.World -> t in univ(1) -> h in malloc.Heap.ghost ->
  union2(t, h) in I -> malloc.errno_ok(eo, union2(t, h)) -> malloc.world_ok(b, cd, st, union2(t, h)) -> n in bits(64) ->
  gc.regs_ok(regs, seq_one(gimple.arg(64, n))) -> runs(gm[regs], t, o2) ->
  abi.ovf_out(t, o2) ||
  (ex V r. (V in x86_64_linux.Vm && (ex h2. h2 in malloc.Heap.ghost &&
     runs(malloc.malloc(I, O, eo, b, cd, st, n), union2(t, h), ok(union2(fn_update(t, "vm", V), h2), fst(r))))) && o2 = ok(fn_update(t, "vm", V), r))
proof
  fix I O eo b cd st gm h t n regs o2
  assume hm hot hw hu hh hi he hwo hn hro hr
  let S := union2(t, h)
  have rl rn r0 := apply(gc.regs1, hn, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have ra: regs in abi.ARGS by simp(rl, (ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)), keep(ord_le))
  have o1l: ord_le(1, seq_len(regs)) by defs(simp(rn), ord_le)
  have st0 := apply(rec_and_intro, hw, hh)
  have rs := mp(all_elim(hm, {regs}, {t}, {h}), ra, hw, hh)
  have ty1 ty2 ty3 := mp(all_elim(hot, {regs}, {t}, {o2}), hr)
  have d := mp(all_elim(rs, {o2}), hr, ty1, ty2)
  have c2: (ex h2. h2 in malloc.Heap.ghost && runs(abi.wide(malloc.Heap.ghost, malloc.malloc_fun(I, O, eo, b, cd, st))[regs], S, with_ghost(o2, h2))) ->
      (ex V r. (V in x86_64_linux.Vm && (ex h2. h2 in malloc.Heap.ghost &&
        runs(malloc.malloc(I, O, eo, b, cd, st, n), S, ok(union2(fn_update(t, "vm", V), h2), fst(r))))) && o2 = ok(fn_update(t, "vm", V), r)) proof
    assume w
    obtain h2, hh2 hw2 from w
    obtain T v z, hT eT from apply(tm.wm_ret[I := I, O := O, eo := eo, b := b, cd := cd, st := st, regs := regs, S := S, X := with_ghost(o2, h2)], ra, o1l, hw2, st0, hi, he, hwo)
    have hTn := rewrite(r0, hT)
    // (o2 a return: so with its ghost part)
    have nx: !(ex m1 e1. o2 = exc(m1, e1)) proof
      assume q
      obtain m1 e1, eq from q
      show by simp(rewrite(eq, eT), abi.wg_exc)
    qed
    have nd: !(ex t1. o2 = diverge(t1)) proof
      assume q
      obtain t1, eq from q
      show by simp(rewrite(eq, eT), abi.wg_div)
    qed
    obtain t2 rr, eo2 from (ex m1 e1. o2 = ok(m1, e1) by taut(ty1, nx, nd))
    have wg: ok(union2(t2, h2), rr) = ok(T, pair(v, z)) := trans(sym(all_elim(abi.wg_ok, {t2}, {rr}, {h2})), rewrite(eo2, eT))
    have eT2: T = union2(t2, h2) by simp(wg)
    have er: rr = pair(v, z) by simp(wg)
    have t2w := mp(all_elim(ty3, {t2}, {rr}), eo2)
    have dt2: dom(t2) = abi.WKEYS by simp(expand(t2w, abi.World))
    have dh2: dom(h2) = insert("blocks", empty) by simp(expand(hh2, malloc.Heap.ghost))
    have tb: T.blocks = h2.blocks := rewrite(sym(eT2), (union2(t2, h2).blocks = h2.blocks by simp(dt2, dh2)))
    have tv: T.vm = t2.vm := rewrite(sym(eT2), (union2(t2, h2).vm = t2.vm by simp(dt2, dh2)))
    have v2: t2.vm in x86_64_linux.Vm by simp(expand(t2w, abi.World))
    have hb2: h2.blocks in fn_space(bits(64), option(omega)) by simp(expand(hh2, malloc.Heap.ghost))
    have h2u _ _ := mp(all_elim(mp.hg_ok, {h2}), hh2)
    have hbu := mp(app_univ[u := 1, f := h2, k := "blocks"], h2u)
    // (T: S with its blocks and memory T's)
    have shp: T = fn_update(fn_update(S, "blocks", T.blocks), "vm", T.vm) proof
      have k1: !(v = 0) -> T = fn_update(fn_update(S, "blocks", T.blocks), "vm", T.vm) proof
        assume nz
        have _ e2 := apply(malloc.malloc_blk[i := I, o := O, e := eo, b := b, c := cd, st := st, n := n, s := S, t := T, v := v], hTn, hi, he, hwo, nz)
        obtain z2 V2, _ _ _ et _ _ from e2
        have ebl: T.blocks = malloc.set_block(S.blocks, v, some(z2)) by simp(et)
        have evm: T.vm = V2 by simp(et)
        show := rewrite(sym(evm), rewrite(sym(ebl), et))
      qed
      have k0: v = 0 -> T = fn_update(fn_update(S, "blocks", T.blocks), "vm", T.vm) proof
        assume ez
        obtain V2, _ _ _ et _ _ from apply(malloc.malloc_zero[i := I, o := O, e := eo, b := b, c := cd, st := st, n := n, s := S, t := T], rewrite(ez, hTn), st0, hi, he, hwo)
        have dt: dom(t) = abi.WKEYS by simp(expand(hw, abi.World))
        have dh: dom(h) = insert("blocks", empty) by simp(expand(hh, malloc.Heap.ghost))
        have sb: S.blocks = h.blocks by simp(dt, dh)
        have tb0: T.blocks = S.blocks := rewrite(sym(et), (fn_update(S, "vm", T.vm).blocks = S.blocks by simp()))
        have ebl: T.blocks = h.blocks := trans(tb0, sb)
        have bs := apply(tm.blk_same, hw, hh)
        show := rewrite(sym(ebl), subst({y. T = fn_update(y, "vm", T.vm)}, sym(bs), et))
      qed
      show by taut(k0, k1)
    qed
    have hgs eqs := apply(tm.split[t := t, h := h, B := h2.blocks, V := t2.vm], hw, hu, hh, v2, hb2, hbu)
    have e3: union2(t2, h2) = union2(fn_update(t, "vm", t2.vm), fn_update(h, "blocks", h2.blocks)) := trans(sym(eT2), trans(rewrite(tv, rewrite(tb, shp)), eqs))
    have w2W _ := apply(mp.am_world, hw, hu, v2)
    have it ih := apply(tm.union_inj, t2w, w2W, hh2, hgs, e3)
    have rv: fst(rr) = v by simp(er)
    have mr: runs(malloc.malloc(I, O, eo, b, cd, st, n), S, ok(union2(fn_update(t, "vm", t2.vm), h2), fst(rr))) :=
      rewrite(sym(rv), rewrite(it, rewrite(eT2, hTn)))
    show by ex_intro({t2.vm}, {rr}, taut(v2, (ex h3. h3 in malloc.Heap.ghost && runs(malloc.malloc(I, O, eo, b, cd, st, n), S, ok(union2(fn_update(t, "vm", t2.vm), h3), fst(rr))) by ex_intro({h2}, taut(hh2, mr))),
      rewrite(it, eo2)))
  qed
  show by taut(d, c2)
qed

// ----------------------------------------------------------------------
//  free at main's call

// free(p) of a live block, where defined: its block dropped, an allocator
// step taking the block's memory back (the world as any call needs it);
// free(0): nothing. Where defined it only returns (a step there is: law
// free_step).
theorem malloc.free_out(i, o, e, b, c, st, p, s, x): malloc.free_step(i, o, b, c, st) ->
  runs(malloc.free(i, o, e, b, c, st, p), s, x) -> s in rec_and(abi.World, malloc.Heap.ghost) -> p in bits(64) -> malloc.world_ok(b, c, st, s) ->
  (!(p = 0) -> s in i && malloc.errno_ok(e, s) && !(s.blocks[p] = none)) ->
  (p = 0 && x = ok(s, empty)) ||
  (!(p = 0) && (ex V. V in x86_64_linux.Vm && x = ok(fn_update(fn_update(s, "blocks", malloc.set_block(s.blocks, p, none)), "vm", V), empty) &&
     malloc.step_ok(i, o, s, fn_update(fn_update(s, "blocks", malloc.set_block(s.blocks, p, none)), "vm", V), malloc.range(p, snd(s.blocks[p]))) &&
     malloc.world_ok(b, c, st, fn_update(fn_update(s, "blocks", malloc.set_block(s.blocks, p, none)), "vm", V))))
proof
  assume hfs h ht hp hwo hpre
  have c0: p = 0 -> x = ok(s, empty) proof
    assume e0
    show by simp(h, hwo, e0)
  qed
  have c1: !(p = 0) -> (ex V. V in x86_64_linux.Vm && x = ok(fn_update(fn_update(s, "blocks", malloc.set_block(s.blocks, p, none)), "vm", V), empty) &&
     malloc.step_ok(i, o, s, fn_update(fn_update(s, "blocks", malloc.set_block(s.blocks, p, none)), "vm", V), malloc.range(p, snd(s.blocks[p]))) &&
     malloc.world_ok(b, c, st, fn_update(fn_update(s, "blocks", malloc.set_block(s.blocks, p, none)), "vm", V))) proof
    assume nz
    have hi he hb := mp(hpre, nz)
    have fs := mp(all_elim(expand(hfs, malloc.free_step), {s}, {p}), conj(ht, hp), conj(conj(hi, hwo), hb))
    show by simp(h, hwo, nz, hi, he, hb, fs)
  qed
  show by taut(c0, c1)
qed

// the ABI's free where defined: free's return at its argument
theorem tm.wf_ret(I, O, eo, b, cd, st, regs, S, X): malloc.free_step(I, O, b, cd, st) -> regs in abi.ARGS -> ord_le(1, seq_len(regs)) ->
  runs(abi.wide(malloc.Heap.ghost, malloc.free_fun(I, O, eo, b, cd, st))[regs], S, X) ->
  S in rec_and(abi.World, malloc.Heap.ghost) -> regs[0] in bits(64) -> malloc.world_ok(b, cd, st, S) ->
  (!(regs[0] = 0) -> S in I && malloc.errno_ok(eo, S) && !(S.blocks[regs[0]] = none)) ->
  ex T y z. runs(malloc.free(I, O, eo, b, cd, st, regs[0]), S, ok(T, empty)) && X = ok(T, pair(y, z))
proof
  assume hfs hra h1 h ht hp hwo hpre
  rsimp only, abi.wide, app_fn_build, hra in h
  have b1 := apply(g.runs_elim, h)
  obtain y, hy ky from expand(b1, bind_rel)
  rsimp only, malloc.free_fun, app_fn_build, hra in hy
  have b2 := apply(g.runs_elim, hy)
  have b3: bind_rel(malloc.free(I, O, eo, b, cd, st, regs[0]), S, x3 x4. any_rel(x5. x5 in bits(64), x5. y = ok(x3, x5)), x3 x4. y = exc(x3, x4), x3. y = diverge(x3)) by taut(b2, h1)
  obtain Y, hY kY from expand(b3, bind_rel)
  have fo := apply(malloc.free_out[i := I, o := O, e := eo, b := b, c := cd, st := st, p := regs[0], s := S, x := Y], hfs, hY, ht, hp, hwo, hpre)
  have yk: ex T. Y = ok(T, empty) proof
    have k0: regs[0] = 0 && Y = ok(S, empty) -> ex T. Y = ok(T, empty) proof
      assume q
      have _ e := q
      show by ex_intro({S}, e)
    qed
    have k1: (!(regs[0] = 0) && (ex V. V in x86_64_linux.Vm && Y = ok(fn_update(fn_update(S, "blocks", malloc.set_block(S.blocks, regs[0], none)), "vm", V), empty) &&
        malloc.step_ok(I, O, S, fn_update(fn_update(S, "blocks", malloc.set_block(S.blocks, regs[0], none)), "vm", V), malloc.range(regs[0], snd(S.blocks[regs[0]]))) &&
        malloc.world_ok(b, cd, st, fn_update(fn_update(S, "blocks", malloc.set_block(S.blocks, regs[0], none)), "vm", V)))) -> ex T. Y = ok(T, empty) proof
      assume q
      have _ e := q
      obtain V, _ e2 _ _ from e
      show by ex_intro({fn_update(fn_update(S, "blocks", malloc.set_block(S.blocks, regs[0], none)), "vm", V)}, e2)
    qed
    show by taut(fo, k0, k1)
  qed
  obtain T, eY from yk
  have ky2: any_rel(x5. x5 in bits(64), x5. y = ok(T, x5)) by simp(rewrite(eY, kY), keep(any_rel))
  have ne: ex z. z in bits(64) by ex_intro({0}, simp())
  obtain y0, _ hy0 from apply(g.any_e, ne, ky2)
  have kz: any_rel(x5. x5 in bits(64), x5. X = ok(T, pair(y0, x5))) by simp(rewrite(hy0, ky), keep(any_rel))
  obtain z, _ hz from apply(g.any_e, ne, kz)
  show by ex_intro({T}, {y0}, {z}, taut(rewrite(eY, hY), hz))
qed

// a callee gf the code of free: refining the ABI's free strictly from a
// world with its thread sound (mp.free_low_all)
abbrev tm.fcallee(I, O, eo, b, cd, st, gf) := all args s h. args in abi.ARGS -> s in abi.World -> s in univ(1) -> h in malloc.Heap.ghost ->
  abi.thread_ok(s.vm, s.fs_base) -> mp.ref_s(gf[args], abi.wide(malloc.Heap.ghost, malloc.free_fun(I, O, eo, b, cd, st))[args], malloc.Heap.ghost, s, h)

// free(p) at a call from the world t, the ghost part h: an overflow, or a
// return -- the memory V, the layer's free from t joined with h to V's
// world joined with some ghost part
theorem tm.free_q: all I O eo b cd st gf h t p regs o2. malloc.free_step(I, O, b, cd, st) -> tm.fcallee(I, O, eo, b, cd, st, gf) -> tm.otyped(gf) ->
  t in abi.World -> t in univ(1) -> h in malloc.Heap.ghost -> malloc.world_ok(b, cd, st, union2(t, h)) ->
  (!(p = 0) -> union2(t, h) in I && malloc.errno_ok(eo, union2(t, h)) && !(union2(t, h).blocks[p] = none)) -> p in bits(64) ->
  gc.regs_ok(regs, seq_one(gimple.arg(64, p))) -> runs(gf[regs], t, o2) ->
  abi.ovf_out(t, o2) ||
  (ex V r. (V in x86_64_linux.Vm && (ex h2. h2 in malloc.Heap.ghost &&
     runs(malloc.free(I, O, eo, b, cd, st, p), union2(t, h), ok(union2(fn_update(t, "vm", V), h2), empty)))) && o2 = ok(fn_update(t, "vm", V), r))
proof
  fix I O eo b cd st gf h t p regs o2
  assume hfs hf hot hw hu hh hwo hpre hp hro hr
  let S := union2(t, h)
  have rl rn r0 := apply(gc.regs1, hp, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have ra: regs in abi.ARGS by simp(rl, (ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)), keep(ord_le))
  have o1l: ord_le(1, seq_len(regs)) by defs(simp(rn), ord_le)
  have st0 := apply(rec_and_intro, hw, hh)
  have dt: dom(t) = abi.WKEYS by simp(expand(hw, abi.World))
  have dh: dom(h) = insert("blocks", empty) by simp(expand(hh, malloc.Heap.ghost))
  have sv: S.vm = t.vm by simp(dt, dh)
  have sfs: S.fs_base = t.fs_base by simp(dt, dh)
  have _ _ th _ _ _ _ _ := expand(hwo, malloc.world_ok)
  have tht: abi.thread_ok(t.vm, t.fs_base) := rewrite(sfs, rewrite(sv, th))
  have rs := mp(all_elim(hf, {regs}, {t}, {h}), ra, hw, hu, hh, tht)
  have ty1 ty2 ty3 := mp(all_elim(hot, {regs}, {t}, {o2}), hr)
  have d := mp(all_elim(rs, {o2}), hr, ty1, ty2)
  have hpre0: !(regs[0] = 0) -> S in I && malloc.errno_ok(eo, S) && !(S.blocks[regs[0]] = none) := rewrite(sym(r0), hpre)
  have c2: (ex h2. h2 in malloc.Heap.ghost && runs(abi.wide(malloc.Heap.ghost, malloc.free_fun(I, O, eo, b, cd, st))[regs], S, with_ghost(o2, h2))) ->
      (ex V r. (V in x86_64_linux.Vm && (ex h2. h2 in malloc.Heap.ghost &&
        runs(malloc.free(I, O, eo, b, cd, st, p), S, ok(union2(fn_update(t, "vm", V), h2), empty)))) && o2 = ok(fn_update(t, "vm", V), r)) proof
    assume w
    obtain h2, hh2 hw2 from w
    obtain T y z, hT eT from apply(tm.wf_ret[I := I, O := O, eo := eo, b := b, cd := cd, st := st, regs := regs, S := S, X := with_ghost(o2, h2)], hfs, ra, o1l, hw2, st0,
      rewrite(sym(r0), hp), hwo, hpre0)
    have hTn := rewrite(r0, hT)
    have nx: !(ex m1 e1. o2 = exc(m1, e1)) proof
      assume q
      obtain m1 e1, eq from q
      show by simp(rewrite(eq, eT), abi.wg_exc)
    qed
    have nd: !(ex t1. o2 = diverge(t1)) proof
      assume q
      obtain t1, eq from q
      show by simp(rewrite(eq, eT), abi.wg_div)
    qed
    obtain t2 rr, eo2 from (ex m1 e1. o2 = ok(m1, e1) by taut(ty1, nx, nd))
    have wg: ok(union2(t2, h2), rr) = ok(T, pair(y, z)) := trans(sym(all_elim(abi.wg_ok, {t2}, {rr}, {h2})), rewrite(eo2, eT))
    have eT2: T = union2(t2, h2) by simp(wg)
    have t2w := mp(all_elim(ty3, {t2}, {rr}), eo2)
    have dt2: dom(t2) = abi.WKEYS by simp(expand(t2w, abi.World))
    have dh2: dom(h2) = insert("blocks", empty) by simp(expand(hh2, malloc.Heap.ghost))
    have v2: t2.vm in x86_64_linux.Vm by simp(expand(t2w, abi.World))
    have fo := apply(malloc.free_out[i := I, o := O, e := eo, b := b, c := cd, st := st, p := p, s := S, x := ok(T, empty)], hfs, hTn, st0, hp, hwo, hpre)
    // free(0): nothing
    have k0: p = 0 && ok(T, empty) = ok(S, empty) -> (ex V r. (V in x86_64_linux.Vm && (ex h3. h3 in malloc.Heap.ghost &&
        runs(malloc.free(I, O, eo, b, cd, st, p), S, ok(union2(fn_update(t, "vm", V), h3), empty)))) && o2 = ok(fn_update(t, "vm", V), r)) proof
      assume q
      have _ eq := q
      have ts: T = S by simp(eq)
      have it ih := apply(tm.union_inj, t2w, hw, hh2, hh, trans(sym(eT2), ts))
      have _ pf pd _ := apply(ms.world_parts, hw)
      have ss: fn_update(t, "vm", t.vm) = t := mp(fn_update_same[f := t, k := "vm"], pf, pd)
      have mr: runs(malloc.free(I, O, eo, b, cd, st, p), S, ok(union2(fn_update(t, "vm", t.vm), h2), empty)) := rewrite(sym(ss), rewrite(it, rewrite(eT2, hTn)))
      have vt: t.vm in x86_64_linux.Vm by simp(expand(hw, abi.World))
      show by ex_intro({t.vm}, {rr}, taut(vt, (ex h3. h3 in malloc.Heap.ghost && runs(malloc.free(I, O, eo, b, cd, st, p), S, ok(union2(fn_update(t, "vm", t.vm), h3), empty)) by ex_intro({h2}, taut(hh2, mr))),
        rewrite(sym(ss), rewrite(it, eo2))))
    qed
    // free of a block: its blocks and memory changed
    have k1: (!(p = 0) && (ex V. V in x86_64_linux.Vm && ok(T, empty) = ok(fn_update(fn_update(S, "blocks", malloc.set_block(S.blocks, p, none)), "vm", V), empty) &&
        malloc.step_ok(I, O, S, fn_update(fn_update(S, "blocks", malloc.set_block(S.blocks, p, none)), "vm", V), malloc.range(p, snd(S.blocks[p]))) &&
        malloc.world_ok(b, cd, st, fn_update(fn_update(S, "blocks", malloc.set_block(S.blocks, p, none)), "vm", V)))) ->
        (ex V r. (V in x86_64_linux.Vm && (ex h3. h3 in malloc.Heap.ghost &&
        runs(malloc.free(I, O, eo, b, cd, st, p), S, ok(union2(fn_update(t, "vm", V), h3), empty)))) && o2 = ok(fn_update(t, "vm", V), r)) proof
      assume q
      have _ e := q
      obtain V2, _ eq _ _ from e
      have et: T = fn_update(fn_update(S, "blocks", malloc.set_block(S.blocks, p, none)), "vm", V2) by simp(eq)
      have tb: T.blocks = h2.blocks := rewrite(sym(eT2), (union2(t2, h2).blocks = h2.blocks by simp(dt2, dh2)))
      have tv: T.vm = t2.vm := rewrite(sym(eT2), (union2(t2, h2).vm = t2.vm by simp(dt2, dh2)))
      have ebl: T.blocks = malloc.set_block(S.blocks, p, none) by simp(et)
      have evm: T.vm = V2 by simp(et)
      have shp := rewrite(sym(evm), rewrite(sym(ebl), et))
      have hb2: h2.blocks in fn_space(bits(64), option(omega)) by simp(expand(hh2, malloc.Heap.ghost))
      have h2u _ _ := mp(all_elim(mp.hg_ok, {h2}), hh2)
      have hbu := mp(app_univ[u := 1, f := h2, k := "blocks"], h2u)
      have hgs eqs := apply(tm.split[t := t, h := h, B := h2.blocks, V := t2.vm], hw, hu, hh, v2, hb2, hbu)
      have e3: union2(t2, h2) = union2(fn_update(t, "vm", t2.vm), fn_update(h, "blocks", h2.blocks)) := trans(sym(eT2), trans(rewrite(tv, rewrite(tb, shp)), eqs))
      have w2W _ := apply(mp.am_world, hw, hu, v2)
      have it ih := apply(tm.union_inj, t2w, w2W, hh2, hgs, e3)
      have mr: runs(malloc.free(I, O, eo, b, cd, st, p), S, ok(union2(fn_update(t, "vm", t2.vm), h2), empty)) := rewrite(it, rewrite(eT2, hTn))
      show by ex_intro({t2.vm}, {rr}, taut(v2, (ex h3. h3 in malloc.Heap.ghost && runs(malloc.free(I, O, eo, b, cd, st, p), S, ok(union2(fn_update(t, "vm", t2.vm), h3), empty)) by ex_intro({h2}, taut(hh2, mr))),
        rewrite(it, eo2)))
    qed
    show by taut(fo, k0, k1)
  qed
  show by taut(d, c2)
qed
