// main's invariant by the malloc layer (layers/malloc.sl): what the
// allocator's steps and the client's writes keep. S0 is the state at
// main's start, H the state now (the world joined with the ghost blocks).

// ----------------------------------------------------------------------
//  The memory outside the allocator's at main's start (and errno's)

// a byte mapped at S0, none of the allocator's nor errno's: still none of
// the allocator's, in no live block, its byte and page as at S0
abbrev tm.kept(O, eo, S0, H) := all a. a in omega -> !(a in O[S0]) -> !(a in malloc.errno_bytes(eo, S0)) ->
  x86_64_linux.mapped(S0.vm, int_div(a, x86_64_linux.PAGE)) ->
  (!(a in O[H]) && !(a in malloc.live_of(H.blocks))) && H.vm.bytes[bits_of_int(64, a)] = S0.vm.bytes[bits_of_int(64, a)] &&
  H.vm.pages[int_div(a, x86_64_linux.PAGE)] = S0.vm.pages[int_div(a, x86_64_linux.PAGE)]

// (a page as at S0: mapped as at S0)
theorem tm.mapped_eq(V, V0, q): V.pages[q] = V0.pages[q] -> x86_64_linux.mapped(V0, q) -> x86_64_linux.mapped(V, q)
proof
  assume e m
  show by defs(rewrite(sym(e), expand(m, x86_64_linux.mapped)), x86_64_linux.mapped)
qed

// An allocator step from H to T with extra bytes X (errno's or a live
// block's), the live bytes after only the live ones before, the
// allocator's or unmapped ones: the bytes kept, kept still
theorem tm.kept_step(I, O, eo, S0, H, T, X): tm.kept(O, eo, S0, H) -> malloc.step_ok(I, O, H, T, X) -> H.fs_base = S0.fs_base ->
  (all a. a in X -> a in malloc.errno_bytes(eo, H) || a in malloc.live_of(H.blocks)) ->
  (all a. a in malloc.live_of(T.blocks) -> (a in malloc.live_of(H.blocks) || a in O[H]) || !x86_64_linux.mapped(H.vm, int_div(a, x86_64_linux.PAGE))) ->
  tm.kept(O, eo, S0, T)
proof
  assume hk hst hfs hx hl
  have af _ ow := expand(hst, malloc.step_ok)
  have f1 _ _ _ _ := expand(af, malloc.alloc_frame)
  have eb: malloc.errno_bytes(eo, H) = malloc.errno_bytes(eo, S0) by defs(simp(hfs), malloc.errno_bytes)
  fix a
  assume ao no ne m0
  have nh nl bh ph := mp(all_elim(hk, {a}), ao, no, ne, m0)
  have mh := apply(tm.mapped_eq[V := H.vm, V0 := S0.vm, q := int_div(a, x86_64_linux.PAGE)], ph, m0)
  have nx: !(a in X) proof
    assume w
    show by taut(rewrite(eb, mp(all_elim(hx, {a}), w)), ne, nl)
  qed
  have b1 p1 := mp(all_elim(f1, {a}), ao, conj(conj(nh, nx), mh))
  have nt: !(a in O[T]) proof
    assume w
    show by taut(mp(all_elim(ow, {a}), ao, w), nh, nx, mh)
  qed
  have nlt: !(a in malloc.live_of(T.blocks)) proof
    assume w
    show by taut(mp(all_elim(hl, {a}), w), nl, nh, mh)
  qed
  show by taut(nt, nlt, trans(b1, bh), trans(p1, ph))
qed

// (malloc's new block p of z bytes, fresh: a live byte after a live one
// before, or the allocator's, or unmapped)
theorem tm.live_new(O, H, p, z, a): malloc.fresh_block(O, H, p, z) -> a in malloc.live_of(malloc.set_block(H.blocks, p, some(z))) ->
  (a in malloc.live_of(H.blocks) || a in O[H]) || !x86_64_linux.mapped(H.vm, int_div(a, x86_64_linux.PAGE))
proof
  assume hf w
  have ao ex := (a in omega && (ex q. q in bits(64) && (!(malloc.set_block(H.blocks, p, some(z))[q] = none) &&
      a in malloc.range(q, snd(malloc.set_block(H.blocks, p, some(z))[q])))) by taut(apply(mp.live_def[b := malloc.set_block(H.blocks, p, some(z)), a := a]), w))
  obtain q, hq hqn hqr from ex
  have _ fr := expand(hf, malloc.fresh_block)
  have c1: q = p -> (a in malloc.live_of(H.blocks) || a in O[H]) || !x86_64_linux.mapped(H.vm, int_div(a, x86_64_linux.PAGE)) proof
    assume e
    have sb: malloc.set_block(H.blocks, p, some(z))[q] = some(z) by defs(simp(e, hq), malloc.set_block)
    have hr2: a in malloc.range(q, z) by simp(rewrite(sb, hqr))
    have r1 r2 := (int_le(q, a) && int_lt(a, int_add(q, z)) by taut(set_select_def[s := omega, p := x. int_le(q, x) && int_lt(x, int_add(q, z)), z := a], expand(hr2, malloc.range)))
    have re: a in malloc.range(p, malloc.extent(z)) by defs(sel(taut(ao, (int_le(p, a) by simp(e, r1)), (int_lt(a, int_add(p, ite(z = 0, 1, z))) by arith(e, r2, (int_le(z, ite(z = 0, 1, z)) by simp()))))), malloc.range, malloc.extent)
    show by taut(mp(all_elim(fr, {a}), ao, re))
  qed
  have c2: !(q = p) -> (a in malloc.live_of(H.blocks) || a in O[H]) || !x86_64_linux.mapped(H.vm, int_div(a, x86_64_linux.PAGE)) proof
    assume ne
    have sb: malloc.set_block(H.blocks, p, some(z))[q] = H.blocks[q] by defs(simp(ne, hq), malloc.set_block)
    have l: a in malloc.live_of(H.blocks) by taut(apply(mp.live_def[b := H.blocks, a := a]), ao,
      (ex q2. q2 in bits(64) && (!(H.blocks[q2] = none) && a in malloc.range(q2, snd(H.blocks[q2]))) by ex_intro({q}, taut(hq, rewrite(sb, hqn), rewrite(sb, hqr)))))
    show by taut(l)
  qed
  show by taut(c1, c2)
qed

// ----------------------------------------------------------------------
//  The test's blocks: block k at q, its pattern

// q block k's: a live block, at least size(k) bytes, its pattern
abbrev tm.bk(H, q, k) := ((q in bits(64) && !(q = 0)) && !(H.blocks[q] = none)) && int_le(test_malloc.size_of(k), snd(H.blocks[q])) && test_malloc.has_pat(H.vm, q, k)

// (a byte of a live block: live, none of the allocator's, mapped
// read-write)
theorem tm.live_facts(I, O, H, q, a): malloc.owned_private(I, O) -> malloc.inv_wf(I) -> H in rec_and(abi.World, malloc.Heap.ghost) -> H in I ->
  q in bits(64) -> !(H.blocks[q] = none) -> a in omega -> int_le(q, a) -> int_lt(a, int_add(q, snd(H.blocks[q]))) ->
  lv: a in malloc.live_of(H.blocks) && own: !(a in O[H]) && rw: malloc.rw_mapped(H.vm, a)
proof
  assume hop hwf ht hi hq hn ao h1 h2
  have lv := apply(mp.blk_live[b := H.blocks, p := q, a := a], hq, hn, ao,
    (a in malloc.range(q, snd(H.blocks[q])) by defs(sel(taut(ao, h1, h2)), malloc.range)))
  have dj := expand(mp(all_elim(expand(hop, malloc.owned_private), {H}), ht, hi), malloc.disjoint)
  have no: !(a in O[H]) by taut(mp(all_elim(dj, {a}), ao), (a in malloc.live(H) by defs(lv, malloc.live)))
  have _ lr := expand(mp(all_elim(expand(hwf, malloc.inv_wf), {H}), ht, hi), malloc.heap_wf)
  have rw := mp(all_elim(mp(all_elim(expand(lr, malloc.live_rw), {q}), hq, hn), {a}), ao, conj(h1, h2))
  show by taut(lv, no, rw)
qed

// (block k's pattern at q: kept where its bytes are)
theorem tm.pat_keep(V, V2, q, k): V in x86_64_linux.Vm -> V2 in x86_64_linux.Vm -> q in bits(64) ->
  int_lt(int_add(q, test_malloc.size_of(k)), 18446744073709551616) -> test_malloc.has_pat(V, q, k) ->
  (all a. a in omega -> int_le(q, a) -> int_lt(a, int_add(q, test_malloc.size_of(k))) -> V2.bytes[bits_of_int(64, a)] = V.bytes[bits_of_int(64, a)]) ->
  test_malloc.has_pat(V2, q, k)
proof
  assume hv hv2 hq hl hp hag
  have vt: V.bytes in fn_space(bits(64), bits(8)) by simp(expand(hv, x86_64_linux.Vm))
  have vt2: V2.bytes in fn_space(bits(64), bits(8)) by simp(expand(hv2, x86_64_linux.Vm))
  have g: all j. j in omega -> int_lt(j, test_malloc.size_of(k)) ->
      gimple.bytes_at(V2, bits_add(64, q, bits_of_int(64, j)), 1) = test_malloc.pat_of(k, j) proof
    fix j
    assume hj hjl
    let X := bits_add(64, q, bits_of_int(64, j))
    have xe: X = int_add(q, j) by defs(arith(hq, hj, hjl, hl), bits_add, bits_of_int, pow2)
    have xb: X in bits(64) by arith(xe, hq, hj, hjl, hl)
    have bq: bits_of_int(64, int_add(q, j)) = int_add(q, j) by defs(arith(hq, hj, hjl, hl), bits_of_int, pow2)
    have e := rewrite(bq, mp(all_elim(hag, {int_add(q, j)}), (int_add(q, j) in omega by arith(hq, hj)), (int_le(q, int_add(q, j)) by arith(hj)),
      (int_lt(int_add(q, j), int_add(q, test_malloc.size_of(k))) by arith(hjl))))
    have g0 := rewrite(xe, mp(all_elim(expand(hp, test_malloc.has_pat), {j}), hj, hjl))
    have b1 := rewrite(xe, mp(all_elim(ms.bytes1, {V}, {X}), vt, xb))
    have b2 := rewrite(xe, mp(all_elim(ms.bytes1, {V2}, {X}), vt2, xb))
    show := rewrite(sym(xe), trans(trans(b2, e), trans(sym(b1), g0)))
  qed
  show by defs(g, test_malloc.has_pat)
qed

// An allocator step from H to T, its extra bytes none of block k's at q,
// that block as it was: block k's still
theorem tm.bk_step(I, O, H, T, X, q, k): k in omega -> malloc.owned_private(I, O) -> malloc.inv_wf(I) -> H in rec_and(abi.World, malloc.Heap.ghost) -> H in I ->
  H.vm in x86_64_linux.Vm -> T.vm in x86_64_linux.Vm -> tm.bk(H, q, k) -> malloc.step_ok(I, O, H, T, X) ->
  (all a. a in omega -> int_le(q, a) -> int_lt(a, int_add(q, snd(H.blocks[q]))) -> !(a in X)) -> T.blocks[q] = H.blocks[q] ->
  tm.bk(T, q, k)
proof
  assume ko hop hwf ht hi hv hv2 hb hst hx hbe
  have hq q0 hn hz hp := hb
  have af _ _ := expand(hst, malloc.step_ok)
  have f1 _ _ _ _ := expand(af, malloc.alloc_frame)
  let SZ := test_malloc.size_of(k)
  have s16: int_le(16, SZ) by defs(arith(ko), test_malloc.size_of)
  // (the block's last byte mapped: below the task's end)
  have lst := apply(tm.live_facts[I := I, O := O, H := H, q := q, a := int_sub(int_add(q, SZ), 1)], hop, hwf, ht, hi, hq, hn,
    (int_sub(int_add(q, SZ), 1) in omega by arith(hq, s16)), (int_le(q, int_sub(int_add(q, SZ), 1)) by arith(s16)), (int_lt(int_sub(int_add(q, SZ), 1), int_add(q, snd(H.blocks[q]))) by arith(hz)))
  have {rwl = rw} := lst
  have ml _ _ := expand(rwl, malloc.rw_mapped)
  have mt _ := expand(ml, x86_64_linux.mapped)
  have hl: int_lt(int_add(q, SZ), 18446744073709551616) by defs(arith(mt, hq, s16), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
  have ag: all a. a in omega -> int_le(q, a) -> int_lt(a, int_add(q, SZ)) -> T.vm.bytes[bits_of_int(64, a)] = H.vm.bytes[bits_of_int(64, a)] proof
    fix a
    assume ao h1 h2
    have h3: int_lt(a, int_add(q, snd(H.blocks[q]))) by arith(h2, hz)
    have {no = own, rw = rw} := apply(tm.live_facts[I := I, O := O, H := H, q := q, a := a], hop, hwf, ht, hi, hq, hn, ao, h1, h3)
    have m _ _ := expand(rw, malloc.rw_mapped)
    have b1 _ := mp(all_elim(f1, {a}), ao, conj(conj(no, mp(all_elim(hx, {a}), ao, h1, h3)), m))
    show b1
  qed
  have p2 := apply(tm.pat_keep[V := H.vm, V2 := T.vm, q := q, k := k], hv, hv2, hq, hl, hp, ag)
  show by taut(hq, q0, rewrite(sym(hbe), hn), rewrite(sym(hbe), hz), p2)
qed

// ----------------------------------------------------------------------
//  The client's writes: bytes only

// a world with bytes written but the thread's word and the code's: as any
// call needs it still
theorem tm.wok_bytes(b, cd, st, H, X): malloc.world_ok(b, cd, st, H) -> x86_64_linux.le(X, H.fs_base, 8) = x86_64_linux.le(H.vm.bytes, H.fs_base, 8) ->
  (all i. i in omega -> int_lt(i, seq_len(cd[empty])) -> X[bits_of_int(64, int_add(b[empty], i))] = H.vm.bytes[bits_of_int(64, int_add(b[empty], i))]) ->
  malloc.world_ok(b, cd, st, fn_update(H, "vm", fn_update(H.vm, "bytes", X)))
proof
  assume hw ht hc
  let VX := fn_update(H.vm, "bytes", X)
  have n1 c2 th cn bs ld lv os tk := expand(hw, malloc.world_ok)
  have th2 := mp(all_elim(ms.thread_keep, {H.vm}, {X}, {H.fs_base}), th, ht)
  have cn2: abi.canary_ok(VX, H.fs_base) by defs(simp(expand(cn, abi.canary_ok, x86_64_linux.readable, abi.stack_page, x86_64_linux.mapped)),
    abi.canary_ok, x86_64_linux.readable, abi.stack_page, x86_64_linux.mapped)
  have bs2: abi.brk_start_ok(VX) by defs(simp(expand(bs, abi.brk_start_ok)), abi.brk_start_ok)
  have ca st0 := expand(ld, abi.loaded)
  have ca2: abi.code_at(VX, b[empty], cd[empty]) proof
    have g: all i. i in omega -> int_lt(i, seq_len(cd[empty])) ->
        ((x86_64_linux.fetchable(VX, bits_of_int(64, int_add(b[empty], i))) && !x86_64_linux.can_access(VX, bits_of_int(64, int_add(b[empty], i)), 1)) &&
         !abi.stack_page(VX, x86_64_linux.page_of(bits_of_int(64, int_add(b[empty], i))))) && VX.bytes[bits_of_int(64, int_add(b[empty], i))] = cd[empty][i] proof
      fix i
      assume hi hil
      have q1 q2 q3 q4 := mp(all_elim(expand(ca, abi.code_at), {i}), hi, hil)
      have r1: x86_64_linux.fetchable(VX, bits_of_int(64, int_add(b[empty], i))) by defs(simp(expand(q1, x86_64_linux.fetchable, x86_64_linux.mapped)),
        x86_64_linux.fetchable, x86_64_linux.mapped)
      have r2: !x86_64_linux.can_access(VX, bits_of_int(64, int_add(b[empty], i)), 1) by defs(simp(expand(q2, x86_64_linux.can_access, x86_64_linux.mapped)),
        x86_64_linux.can_access, x86_64_linux.mapped)
      have r3: !abi.stack_page(VX, x86_64_linux.page_of(bits_of_int(64, int_add(b[empty], i)))) by defs(simp(expand(q3, abi.stack_page, x86_64_linux.mapped)),
        abi.stack_page, x86_64_linux.mapped)
      have r4: VX.bytes[bits_of_int(64, int_add(b[empty], i))] = cd[empty][i] by simp(mp(all_elim(hc, {i}), hi, hil), q4)
      show by taut(r1, r2, r3, r4)
    qed
    show by defs(g, abi.code_at)
  qed
  have sf: x86_64_linux.stack_floor(VX) = x86_64_linux.stack_floor(H.vm) by defs(simp(), x86_64_linux.stack_floor)
  have st2: all x0. x0 in omega -> x0 in st[empty] -> x86_64_linux.off_stack_space(VX, int_div(x0, x86_64_linux.PAGE), 1) proof
    fix a
    assume hao ha3
    show by defs(simp(sf, expand(mp(all_elim(st0, {a}), hao, ha3), x86_64_linux.off_stack_space)), x86_64_linux.off_stack_space)
  qed
  have ld2: abi.loaded(VX, b[empty], cd[empty], st[empty]) by defs(taut(ca2, st2), abi.loaded)
  have os2: all x0. x0 in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) -> !(VX.pages[x0] = none) ->
      x86_64_linux.off_stack_space(VX, x0, 1) proof
    fix q
    assume hq hn
    show by defs(simp(sf, expand(mp(all_elim(os, {q}), hq, (!(H.vm.pages[q] = none) by simp(hn))), x86_64_linux.off_stack_space)), x86_64_linux.off_stack_space)
  qed
  show by defs(simp(n1, c2, th2, cn2, bs2, ld2, lv, os2, sf, tk), malloc.world_ok)
qed

// (a live byte: mapped read-write)
theorem tm.live_rw(I, O, H, a): malloc.owned_private(I, O) -> malloc.inv_wf(I) -> H in rec_and(abi.World, malloc.Heap.ghost) -> H in I ->
  a in malloc.live_of(H.blocks) -> a in omega && malloc.rw_mapped(H.vm, a) && !(a in O[H])
proof
  assume hop hwf ht hi hl
  have ao ex := (a in omega && (ex q. q in bits(64) && (!(H.blocks[q] = none) && a in malloc.range(q, snd(H.blocks[q])))) by taut(apply(mp.live_def[b := H.blocks, a := a]), hl))
  obtain q, hq hqn hqr from ex
  have _ r1 r2 := (a in omega && int_le(q, a) && int_lt(a, int_add(q, snd(H.blocks[q]))) by taut(set_select_def[s := omega, p := x. int_le(q, x) && int_lt(x, int_add(q, snd(H.blocks[q]))), z := a],
    expand(hqr, malloc.range)))
  have {no = own, rw = rw} := apply(tm.live_facts[I := I, O := O, H := H, q := q, a := a], hop, hwf, ht, hi, hq, hqn, ao, r1, r2)
  show by taut(ao, rw, no)
qed

// The client writing bytes X: only bytes of live blocks or unmapped ones
// (its stack objects), none of the allocator's. The invariant, the
// allocator's bytes, errno, the world as any call needs it and the memory
// outside the allocator's at main's start: kept
theorem tm.client(I, O, eo, b, cd, st, S0, H, X): malloc.frame(I, O) -> malloc.owned_private(I, O) -> malloc.owned_mapped(I, O) -> malloc.inv_wf(I) ->
  malloc.live_apart(I, eo) -> H in rec_and(abi.World, malloc.Heap.ghost) -> fn_update(H, "vm", fn_update(H.vm, "bytes", X)) in rec_and(abi.World, malloc.Heap.ghost) ->
  H in I -> malloc.errno_ok(eo, H) -> malloc.world_ok(b, cd, st, H) -> tm.kept(O, eo, S0, H) ->
  (all x. x in bits(64) -> X[x] = H.vm.bytes[x] ||
     ((x in malloc.live_of(H.blocks) || !x86_64_linux.mapped(H.vm, int_div(x, x86_64_linux.PAGE))) && !(x in O[H]))) ->
  inv: fn_update(H, "vm", fn_update(H.vm, "bytes", X)) in I && own: O[fn_update(H, "vm", fn_update(H.vm, "bytes", X))] = O[H] &&
  eok: malloc.errno_ok(eo, fn_update(H, "vm", fn_update(H.vm, "bytes", X))) && wok: malloc.world_ok(b, cd, st, fn_update(H, "vm", fn_update(H.vm, "bytes", X))) &&
  kept: tm.kept(O, eo, S0, fn_update(H, "vm", fn_update(H.vm, "bytes", X)))
proof
  assume hfr hop hom hwf hla ht ht2 hi heo hw hk hW
  let VX := fn_update(H.vm, "bytes", X)
  let T := fn_update(H, "vm", VX)
  have fsb := apply(mp.u_fs_ty, ht)
  have _ _ th _ _ ld lv _ _ := expand(hw, malloc.world_ok)
  have {fsl = fsl} := apply(mp.top_fsl, fsb, th)
  have ts: int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE) = 34359738367 by defs(simp(), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
  have pg: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
  // (a mapped byte: below the task's end, its own word)
  have mlow: all a. a in omega -> x86_64_linux.mapped(H.vm, int_div(a, x86_64_linux.PAGE)) -> bits_of_int(64, a) = a && a in bits(64) proof
    fix a
    assume ao m
    have ml _ := expand(m, x86_64_linux.mapped)
    show by defs(arith(ao, ml, ts, pg), bits_of_int, pow2)
  qed
  // (where X differs: a live block's byte or an unmapped one)
  have same: all a. a in omega -> x86_64_linux.mapped(H.vm, int_div(a, x86_64_linux.PAGE)) -> !(a in malloc.live_of(H.blocks)) ->
      X[bits_of_int(64, a)] = H.vm.bytes[bits_of_int(64, a)] proof
    fix a
    assume ao m nl
    have be ab := mp(all_elim(mlow, {a}), ao, m)
    have c := mp(all_elim(hW, {a}), ab)
    show := rewrite(sym(be), (X[a] = H.vm.bytes[a] by taut(c, m, nl)))
  qed
  // (the allocator's bytes: none written)
  have ownX: all a. a in omega -> a in O[H] -> X[bits_of_int(64, a)] = H.vm.bytes[bits_of_int(64, a)] proof
    fix a
    assume ao hoa
    have mo := mp(all_elim(mp(all_elim(expand(hom, malloc.owned_mapped), {H}), ht, hi), {a}), ao, hoa)
    have c1: x86_64_linux.mapped(H.vm, int_div(a, x86_64_linux.PAGE)) -> X[bits_of_int(64, a)] = H.vm.bytes[bits_of_int(64, a)] proof
      assume m
      have be ab := mp(all_elim(mlow, {a}), ao, m)
      show := rewrite(sym(be), (X[a] = H.vm.bytes[a] by taut(mp(all_elim(hW, {a}), ab), hoa)))
    qed
    have c2: a in H.objs.live -> X[bits_of_int(64, a)] = H.vm.bytes[bits_of_int(64, a)] proof
      assume l
      have _ _ l3 := mp(all_elim(lv, {a}), ao, l)
      have be: bits_of_int(64, a) = a by defs(arith(ao, l3), bits_of_int, pow2, x86_64_linux.TASK_SIZE)
      have ab: a in bits(64) by defs(arith(ao, l3), x86_64_linux.TASK_SIZE)
      show := rewrite(sym(be), (X[a] = H.vm.bytes[a] by taut(mp(all_elim(hW, {a}), ab), hoa)))
    qed
    show by taut(mo, c1, c2)
  qed
  // the invariant: the frame law
  have fr := mp(all_elim(expand(hfr, malloc.frame), {H}, {T}), conj(ht, ht2), taut(hi, (T.blocks = H.blocks by simp()), (T.vm.brk = H.vm.brk by simp()),
    (T.fs_base = H.fs_base by simp()), (T.vm.stack_top = H.vm.stack_top by simp()), (T.vm.stack_limit = H.vm.stack_limit by simp()),
    (all a. a in omega -> a in O[H] -> T.vm.bytes[bits_of_int(64, a)] = H.vm.bytes[bits_of_int(64, a)] && T.vm.pages[int_div(a, x86_64_linux.PAGE)] = H.vm.pages[int_div(a, x86_64_linux.PAGE)]
      by simp(ownX)),
    (all a. a in omega -> a in O[H] && a in H.objs.live -> a in T.objs.live by simp()),
    (all a. a in omega -> a in malloc.live(H) -> T.vm.pages[int_div(a, x86_64_linux.PAGE)] = H.vm.pages[int_div(a, x86_64_linux.PAGE)] by simp())))
  have tin tow := fr
  // errno: its pages, its place as they were
  have eok: malloc.errno_ok(eo, T) proof
    have g: all a. a in omega -> a in malloc.errno_bytes(eo, T) -> malloc.rw_mapped(T.vm, a) proof
      fix a
      assume ao ha
      have eb: malloc.errno_bytes(eo, T) = malloc.errno_bytes(eo, H) by defs(simp(), malloc.errno_bytes)
      have r := mp(all_elim(expand(heo, malloc.errno_ok), {a}), ao, rewrite(eb, ha))
      show by defs(simp(expand(r, malloc.rw_mapped, x86_64_linux.mapped)), malloc.rw_mapped, x86_64_linux.mapped)
    qed
    show by defs(g, malloc.errno_ok)
  qed
  // the world: the thread's word and the code none written
  have r0 _ _ _ := expand(th, abi.thread_ok)
  have la := mp(all_elim(expand(hla, malloc.live_apart), {H}), ht, hi)
  have lsame: all k. k in omega -> int_lt(k, 8) -> X[bits_add(64, H.fs_base, bits_of_int(64, k))] = H.vm.bytes[bits_add(64, H.fs_base, bits_of_int(64, k))] proof
    fix k
    assume hk hkl
    have m0 _ := mp(all_elim(expand(r0, x86_64_linux.readable), {k}), hk, hkl)
    have ae: bits_add(64, H.fs_base, bits_of_int(64, k)) = int_add(H.fs_base, k) by defs(arith(fsb, hk, hkl, fsl), bits_add, bits_of_int, pow2)
    have be: bits_of_int(64, int_add(H.fs_base, k)) = int_add(H.fs_base, k) by defs(arith(fsb, hk, hkl, fsl), bits_of_int, pow2)
    have nl: !(int_add(H.fs_base, k) in malloc.live_of(H.blocks)) proof
      assume w
      have ir: int_add(H.fs_base, k) in malloc.range(H.fs_base, 8) by defs(sel(arith(fsb, hk, hkl)), malloc.range)
      have n1 _ _ := mp(all_elim(la, {int_add(H.fs_base, k)}), (int_add(H.fs_base, k) in omega by arith(fsb, hk)), (int_add(H.fs_base, k) in malloc.live(H) by defs(w, malloc.live)))
      show by taut(n1, ir)
    qed
    have s := mp(all_elim(same, {int_add(H.fs_base, k)}), (int_add(H.fs_base, k) in omega by arith(fsb, hk)), m0, nl)
    show := rewrite(sym(ae), rewrite(be, s))
  qed
  have hle := mp(all_elim(tr.le_same, {X}, {H.vm.bytes}, {H.fs_base}, {8}), (8 in omega by simp()), lsame)
  have ca _ := expand(ld, abi.loaded)
  have csame: all i. i in omega -> int_lt(i, seq_len(cd[empty])) -> X[bits_of_int(64, int_add(b[empty], i))] = H.vm.bytes[bits_of_int(64, int_add(b[empty], i))] proof
    fix i
    assume hi2 hil
    let x := bits_of_int(64, int_add(b[empty], i))
    have q1 q2 _ _ := mp(all_elim(expand(ca, abi.code_at), {i}), hi2, hil)
    have xb: x in bits(64) by defs(simp(), bits_of_int, pow2)
    have mx: x86_64_linux.mapped(H.vm, int_div(x, x86_64_linux.PAGE)) by taut(expand(q1, x86_64_linux.fetchable, x86_64_linux.page_of))
    have nl: !(x in malloc.live_of(H.blocks)) proof
      assume w
      have _ rw _ := apply(tm.live_rw[I := I, O := O, H := H, a := x], hop, hwf, ht, hi, w)
      show by taut(q2, (x86_64_linux.can_access(H.vm, x, 1) by defs(simp(expand(rw, malloc.rw_mapped)), x86_64_linux.can_access, x86_64_linux.hw_allows, x86_64_linux.page_of)))
    qed
    show by taut(mp(all_elim(hW, {x}), xb), mx, nl)
  qed
  have wok := apply(tm.wok_bytes[b := b, cd := cd, st := st, H := H, X := X], hw, hle, csame)
  // the memory outside the allocator's at main's start: none written
  have kept: tm.kept(O, eo, S0, T) proof
    fix a
    assume ao no ne m0
    have nh nl bh ph := mp(all_elim(hk, {a}), ao, no, ne, m0)
    have mh := apply(tm.mapped_eq[V := H.vm, V0 := S0.vm, q := int_div(a, x86_64_linux.PAGE)], ph, m0)
    have s := mp(all_elim(same, {a}), ao, mh, nl)
    show by taut(rewrite(sym(tow), nh), (!(a in malloc.live_of(T.blocks)) by simp(nl)), (T.vm.bytes[bits_of_int(64, a)] = S0.vm.bytes[bits_of_int(64, a)] by simp(s, bh)),
      (T.vm.pages[int_div(a, x86_64_linux.PAGE)] = S0.vm.pages[int_div(a, x86_64_linux.PAGE)] by simp(ph)))
  qed
  show by taut(tin, tow, eok, wok, kept)
qed

// ----------------------------------------------------------------------
//  main's array: a stack object, none of the allocator's

// (a live object of a world as any call needs it: on no mapped page)
theorem tm.obj_unm(b, cd, st, H, a): malloc.world_ok(b, cd, st, H) -> a in omega -> a in H.objs.live ->
  !x86_64_linux.mapped(H.vm, int_div(a, x86_64_linux.PAGE))
proof
  assume hw ao hl
  have _ _ _ _ _ _ lv os _ := expand(hw, malloc.world_ok)
  have l1 l2 _ := mp(all_elim(lv, {a}), ao, hl)
  assume m
  have ml mn := expand(m, x86_64_linux.mapped)
  have pg: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
  have qs: int_div(a, x86_64_linux.PAGE) in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) by sel(taut((int_div(a, x86_64_linux.PAGE) in omega by arith(ao, pg)), ml))
  have o := mp(all_elim(os, {int_div(a, x86_64_linux.PAGE)}), qs, mn)
  have gp: x86_64_linux.STACK_GUARD_GAP in omega by defs(simp(), x86_64_linux.STACK_GUARD_GAP)
  show by arith(expand(o, x86_64_linux.off_stack_space), l1, l2, ao, gp, pg)
qed

// (an 8-byte word: as its bytes)
theorem tm.cell_eq(V, V2, c): c in omega -> int_le(int_add(c, 8), 18446744073709551616) ->
  (all a. a in omega -> int_le(c, a) -> int_lt(a, int_add(c, 8)) -> V2.bytes[bits_of_int(64, a)] = V.bytes[bits_of_int(64, a)]) ->
  gimple.bytes_at(V2, c, 8) = gimple.bytes_at(V, c, 8)
proof
  assume hc hl hag
  have per: all i. i in omega -> int_le(0, i) -> int_lt(i, 8) ->
      int_mul(V2.bytes[bits_add(64, c, bits_of_int(64, i))], int_pow(256, i)) = int_mul(V.bytes[bits_add(64, c, bits_of_int(64, i))], int_pow(256, i)) proof
    fix i
    assume hi _ hil
    have ab: bits_add(64, c, bits_of_int(64, i)) = bits_of_int(64, int_add(c, i)) by defs(arith(hc, hl, hi, hil), bits_add, bits_of_int, pow2)
    have k := mp(all_elim(hag, {int_add(c, i)}), (int_add(c, i) in omega by arith(hc, hi)), (int_le(c, int_add(c, i)) by arith(hi)), (int_lt(int_add(c, i), int_add(c, 8)) by arith(hil)))
    show by simp(ab, k)
  qed
  have s := apply(int_sum_ext[a := 0, b := 8, f := i. int_mul(V2.bytes[bits_add(64, c, bits_of_int(64, i))], int_pow(256, i)),
    g := i. int_mul(V.bytes[bits_add(64, c, bits_of_int(64, i))], int_pow(256, i))], simp(), simp(), per)
  show by defs(s, gimple.bytes_at)
qed

// An allocator step from H to T, its extra bytes mapped ones: a live
// object of H none of the allocator's keeps its byte, still none of the
// allocator's
theorem tm.obj_step(I, O, b, cd, st, H, T, X, a): malloc.step_ok(I, O, H, T, X) -> malloc.world_ok(b, cd, st, H) ->
  (all x. x in X -> x86_64_linux.mapped(H.vm, int_div(x, x86_64_linux.PAGE))) -> a in omega -> a in H.objs.live -> !(a in O[H]) ->
  T.vm.bytes[bits_of_int(64, a)] = H.vm.bytes[bits_of_int(64, a)] && !(a in O[T])
proof
  assume hst hw hx ao hl no
  have af _ ow := expand(hst, malloc.step_ok)
  have _ f2 _ _ _ := expand(af, malloc.alloc_frame)
  have _ _ _ _ _ _ lv _ _ := expand(hw, malloc.world_ok)
  have _ _ l3 := mp(all_elim(lv, {a}), ao, hl)
  have um := apply(tm.obj_unm[b := b, cd := cd, st := st, H := H, a := a], hw, ao, hl)
  have nx: !(a in X) proof
    assume w
    show by taut(um, mp(all_elim(hx, {a}), w))
  qed
  have b2 _ := mp(all_elim(f2, {a}), ao, conj(conj(conj(no, nx), hl), l3))
  have nt: !(a in O[T]) by taut(mp(all_elim(ow, {a}), ao), no, nx, hl)
  show by taut(b2, nt)
qed

// ----------------------------------------------------------------------
//  main's invariant

// (the laws main relies on)
abbrev tm.laws(I, O, eo) := (((malloc.frame(I, O) && malloc.owned_private(I, O)) && malloc.owned_mapped(I, O)) && malloc.inv_wf(I)) && malloc.live_apart(I, eo)

// the array's k-th word, its bytes main's, none of the allocator's
abbrev tm.cell(V, l0, k) := gimple.bytes_at(V, int_add(l0, int_mul(8, k)), 8)
abbrev tm.arr(O, H, l0) := all a. a in omega -> int_le(l0, a) -> int_lt(a, int_add(l0, 64)) -> a in H.objs.live && !(a in O[H])

// the blocks k of K at the array's words
abbrev tm.bks(H, l0, K) := all k. k in omega -> int_lt(k, 8) -> k in K -> tm.bk(H, tm.cell(H.vm, l0, k), k)

// main at H, from S0: the allocator's invariant, errno, the world, the
// memory outside the allocator's kept, the array, the blocks of K
abbrev tm.mi(I, O, eo, b, cd, st, S0, H, l0, K) := ((((H in I && malloc.errno_ok(eo, H)) && malloc.world_ok(b, cd, st, H)) && H.fs_base = S0.fs_base) &&
  tm.kept(O, eo, S0, H)) && tm.arr(O, H, l0) && tm.bks(H, l0, K)

// (two blocks' patterns at one place: the same block -- their first bytes
// differ)
theorem tm.bk_distinct(H, q, k, j): k in omega -> j in omega -> int_lt(k, 8) -> int_lt(j, 8) -> tm.bk(H, q, k) -> tm.bk(H, q, j) -> k = j
proof
  assume hk hj hkl hjl bk bj
  have _ _ _ _ pk := bk
  have _ _ _ _ pj := bj
  have s16k: int_lt(0, test_malloc.size_of(k)) by defs(arith(hk), test_malloc.size_of)
  have s16j: int_lt(0, test_malloc.size_of(j)) by defs(arith(hj), test_malloc.size_of)
  have ek := mp(all_elim(expand(pk, test_malloc.has_pat), {0}), simp(), s16k)
  have ej := mp(all_elim(expand(pj, test_malloc.has_pat), {0}), simp(), s16j)
  have e: test_malloc.pat_of(k, 0) = test_malloc.pat_of(j, 0) := trans(sym(ek), ej)
  have a1: test_malloc.pat_of(k, 0) = int_mul(31, k) by defs(arith(hk, hkl), test_malloc.pat_of)
  have a2: test_malloc.pat_of(j, 0) = int_mul(31, j) by defs(arith(hj, hjl), test_malloc.pat_of)
  show by arith(e, a1, a2)
qed

// (a live byte: not errno's)
theorem tm.live_noerr(I, eo, H, a): malloc.live_apart(I, eo) -> H in rec_and(abi.World, malloc.Heap.ghost) -> H in I -> app(eo, empty) = 52 ->
  int_le(int_add(H.fs_base, 56), int_pow(2, 64)) -> a in omega -> a in malloc.live_of(H.blocks) -> !(a in malloc.errno_bytes(eo, H))
proof
  assume hla ht hi he fsl ao hl
  have fsb := apply(mp.u_fs_ty, ht)
  have _ n2 _ := mp(all_elim(mp(all_elim(expand(hla, malloc.live_apart), {H}), ht, hi), {a}), ao, (a in malloc.live(H) by defs(hl, malloc.live)))
  assume w
  have h1 h2 := apply(mp.top_ebi[eo := eo, S := H, a := a], fsb, fsl, he, w)
  show by taut(n2, (int_le(int_add(H.fs_base, app(eo, empty)), a) && int_lt(a, int_add(int_add(H.fs_base, app(eo, empty)), 4)) by arith(h1, h2, he)))
qed

// (errno's bytes: mapped)
theorem tm.err_mapped(eo, H, x): malloc.errno_ok(eo, H) -> x in malloc.errno_bytes(eo, H) -> x86_64_linux.mapped(H.vm, int_div(x, x86_64_linux.PAGE))
proof
  assume he w
  have xo _ := unsel(expand(w, malloc.errno_bytes, malloc.range))
  have m _ _ := expand(mp(all_elim(expand(he, malloc.errno_ok), {x}), xo, w), malloc.rw_mapped)
  show m
qed

// malloc's block p of z bytes at H (fresh, an allocator step to T, the
// world and errno as any call needs them): main's invariant at T, p none
// of K's blocks
theorem tm.mi_malloc(I, O, eo, b, cd, st, S0, H, l0, K, p, z, V): tm.laws(I, O, eo) -> app(eo, empty) = 52 -> H in rec_and(abi.World, malloc.Heap.ghost) ->
  H.vm in x86_64_linux.Vm -> V in x86_64_linux.Vm -> l0 in omega -> int_le(int_add(l0, 64), 18446744073709551616) -> tm.mi(I, O, eo, b, cd, st, S0, H, l0, K) ->
  malloc.fresh_block(O, H, p, z) ->
  malloc.step_ok(I, O, H, fn_update(fn_update(H, "blocks", malloc.set_block(H.blocks, p, some(z))), "vm", V), malloc.errno_bytes(eo, H)) ->
  malloc.world_ok(b, cd, st, fn_update(fn_update(H, "blocks", malloc.set_block(H.blocks, p, some(z))), "vm", V)) ->
  malloc.errno_ok(eo, fn_update(fn_update(H, "blocks", malloc.set_block(H.blocks, p, some(z))), "vm", V)) ->
  tm.mi(I, O, eo, b, cd, st, S0, fn_update(fn_update(H, "blocks", malloc.set_block(H.blocks, p, some(z))), "vm", V), l0, K) &&
  (all k. k in omega -> int_lt(k, 8) -> k in K -> !(tm.cell(V, l0, k) = p))
proof
  assume hl he ht hvH hv hl0 hl64 hmi hfb hst hwT heT
  let T := fn_update(fn_update(H, "blocks", malloc.set_block(H.blocks, p, some(z))), "vm", V)
  let X := malloc.errno_bytes(eo, H)
  have hfr hop hom hwf hla := hl
  have hi heo hw hfs hk ha hb := hmi
  have _ _ th _ _ _ _ _ _ := expand(hw, malloc.world_ok)
  have {fsl = fsl} := apply(mp.top_fsl, apply(mp.u_fs_ty, ht), th)
  have tv: T.vm = V by simp()
  have tb: T.blocks = malloc.set_block(H.blocks, p, some(z)) by simp()
  have tfs: T.fs_base = S0.fs_base by simp(hfs)
  have tob: T.objs = H.objs by simp()
  have _ ti _ := expand(hst, malloc.step_ok)
  // the memory outside the allocator's at main's start
  have lnew: all a. a in malloc.live_of(T.blocks) -> (a in malloc.live_of(H.blocks) || a in O[H]) || !x86_64_linux.mapped(H.vm, int_div(a, x86_64_linux.PAGE)) proof
    fix a
    assume w
    show := apply(tm.live_new[O := O, H := H, p := p, z := z, a := a], hfb, rewrite(tb, w))
  qed
  have xe: all a. a in X -> a in malloc.errno_bytes(eo, H) || a in malloc.live_of(H.blocks) proof
    fix a
    assume w
    show by taut(w)
  qed
  have kT := apply(tm.kept_step[I := I, O := O, eo := eo, S0 := S0, H := H, T := T, X := X], hk, hst, hfs, xe, lnew)
  // the array: kept, none of the allocator's
  have xm: all x. x in X -> x86_64_linux.mapped(H.vm, int_div(x, x86_64_linux.PAGE)) proof
    fix x
    assume w
    show := apply(tm.err_mapped[eo := eo, H := H, x := x], heo, w)
  qed
  have arT: tm.arr(O, T, l0) proof
    fix a
    assume ao h1 h2
    have l nO := mp(all_elim(ha, {a}), ao, h1, h2)
    have _ nT := apply(tm.obj_step[I := I, O := O, b := b, cd := cd, st := st, H := H, T := T, X := X, a := a], hst, hw, xm, ao, l, nO)
    show by taut(rewrite(sym(tob), l), nT)
  qed
  have ce: all k. k in omega -> int_lt(k, 8) -> tm.cell(T.vm, l0, k) = tm.cell(H.vm, l0, k) proof
    fix k
    assume hk2 hkl
    have ag: all a. a in omega -> int_le(int_add(l0, int_mul(8, k)), a) -> int_lt(a, int_add(int_add(l0, int_mul(8, k)), 8)) ->
        T.vm.bytes[bits_of_int(64, a)] = H.vm.bytes[bits_of_int(64, a)] proof
      fix a
      assume ao h1 h2
      have l nO := mp(all_elim(ha, {a}), ao, (int_le(l0, a) by arith(h1, hk2)), (int_lt(a, int_add(l0, 64)) by arith(h2, hkl)))
      have bt _ := apply(tm.obj_step[I := I, O := O, b := b, cd := cd, st := st, H := H, T := T, X := X, a := a], hst, hw, xm, ao, l, nO)
      show bt
    qed
    show := apply(tm.cell_eq[V := H.vm, V2 := T.vm, c := int_add(l0, int_mul(8, k))], (int_add(l0, int_mul(8, k)) in omega by arith(hl0, hk2)),
      (int_le(int_add(int_add(l0, int_mul(8, k)), 8), 18446744073709551616) by arith(hl64, hkl, hk2)), ag)
  qed
  // the blocks: none of them p (fresh), their bytes no errno's
  have _ fr := expand(hfb, malloc.fresh_block)
  have bks: all k. k in omega -> int_lt(k, 8) -> k in K -> tm.bk(T, tm.cell(T.vm, l0, k), k) && !(tm.cell(V, l0, k) = p) proof
    fix k
    assume hk2 hkl hkK
    let q := tm.cell(H.vm, l0, k)
    have bH := mp(all_elim(hb, {k}), hk2, hkl, hkK)
    have hq _ hn _ _ := bH
    have np: !(q = p) proof
      assume e
      show by taut(hn, rewrite(sym(e), (H.blocks[p] = none by taut(expand(hfb, malloc.fresh_block)))))
    qed
    have tbq: T.blocks[q] = H.blocks[q] by defs(simp(np, hq), malloc.set_block)
    have hxr: all a. a in omega -> int_le(q, a) -> int_lt(a, int_add(q, snd(H.blocks[q]))) -> !(a in X) proof
      fix a
      assume ao h1 h2
      have {lv = lv} := apply(tm.live_facts[I := I, O := O, H := H, q := q, a := a], hop, hwf, ht, hi, hq, hn, ao, h1, h2)
      show := apply(tm.live_noerr[I := I, eo := eo, H := H, a := a], hla, ht, hi, he, fsl, ao, lv)
    qed
    have bT := apply(tm.bk_step[I := I, O := O, H := H, T := T, X := X, q := q, k := k], hk2, hop, hwf, ht, hi, hvH, rewrite(sym(tv), hv), bH, hst, hxr, tbq)
    have c := mp(all_elim(ce, {k}), hk2, hkl)
    show by taut(rewrite(sym(c), bT), rewrite(tv, rewrite(sym(c), np)))
  qed
  have bksT: tm.bks(T, l0, K) proof
    fix k
    assume hk2 hkl hkK
    show by taut(mp(all_elim(bks, {k}), hk2, hkl, hkK))
  qed
  have dis: all k. k in omega -> int_lt(k, 8) -> k in K -> !(tm.cell(V, l0, k) = p) proof
    fix k
    assume hk2 hkl hkK
    show by taut(mp(all_elim(bks, {k}), hk2, hkl, hkK))
  qed
  show by taut(ti, heT, hwT, tfs, kT, arT, bksT, dis)
qed

// (a byte of a range: of the range of its extent)
theorem tm.in_extent(p, z, a): a in malloc.range(p, z) -> a in malloc.range(p, malloc.extent(z))
proof
  assume w
  have ao r1 r2 := (a in omega && int_le(p, a) && int_lt(a, int_add(p, z)) by taut(set_select_def[s := omega, p := x. int_le(p, x) && int_lt(x, int_add(p, z)), z := a], expand(w, malloc.range)))
  show by defs(sel(taut(ao, r1, (int_lt(a, int_add(p, ite(z = 0, 1, z))) by arith(r2, (int_le(z, ite(z = 0, 1, z)) by simp()))))), malloc.range, malloc.extent)
qed

// (two live blocks at different places: no byte of both)
theorem tm.blk_apart(I, H, q, q2, a): malloc.inv_wf(I) -> H in rec_and(abi.World, malloc.Heap.ghost) -> H in I -> q in bits(64) -> q2 in bits(64) ->
  !(H.blocks[q] = none) -> !(H.blocks[q2] = none) -> !(q = q2) -> a in malloc.range(q, snd(H.blocks[q])) -> !(a in malloc.range(q2, snd(H.blocks[q2])))
proof
  assume hwf ht hi hq hq2 hn hn2 ne w
  have bw _ := expand(mp(all_elim(expand(hwf, malloc.inv_wf), {H}), ht, hi), malloc.heap_wf)
  have _ _ dj := expand(mp(all_elim(expand(bw, malloc.blocks_wf), {q}), hq, hn), malloc.block_wf)
  have d := expand(mp(all_elim(dj, {q2}), hq2, conj((!(q2 = q) by taut(ne)), hn2)), malloc.disjoint)
  have ao _ := unsel(expand(w, malloc.range))
  assume w2
  show by taut(mp(all_elim(d, {a}), ao), apply(tm.in_extent[p := q, z := snd(H.blocks[q]), a := a], w), apply(tm.in_extent[p := q2, z := snd(H.blocks[q2]), a := a], w2))
qed

// free of block j's q at H (an allocator step to T taking its bytes back,
// the world and errno as any call needs them): main's invariant at T for
// K2, K without j
theorem tm.mi_free(I, O, eo, b, cd, st, S0, H, l0, K, K2, j, V): tm.laws(I, O, eo) -> app(eo, empty) = 52 -> H in rec_and(abi.World, malloc.Heap.ghost) ->
  H.vm in x86_64_linux.Vm -> V in x86_64_linux.Vm -> l0 in omega -> int_le(int_add(l0, 64), 18446744073709551616) -> tm.mi(I, O, eo, b, cd, st, S0, H, l0, K) ->
  j in omega -> int_lt(j, 8) -> j in K -> (all k. k in omega -> k in K2 -> k in K && !(k = j)) ->
  malloc.step_ok(I, O, H, fn_update(fn_update(H, "blocks", malloc.set_block(H.blocks, tm.cell(H.vm, l0, j), none)), "vm", V),
    malloc.range(tm.cell(H.vm, l0, j), snd(H.blocks[tm.cell(H.vm, l0, j)]))) ->
  malloc.world_ok(b, cd, st, fn_update(fn_update(H, "blocks", malloc.set_block(H.blocks, tm.cell(H.vm, l0, j), none)), "vm", V)) ->
  malloc.errno_ok(eo, fn_update(fn_update(H, "blocks", malloc.set_block(H.blocks, tm.cell(H.vm, l0, j), none)), "vm", V)) ->
  tm.mi(I, O, eo, b, cd, st, S0, fn_update(fn_update(H, "blocks", malloc.set_block(H.blocks, tm.cell(H.vm, l0, j), none)), "vm", V), l0, K2)
proof
  assume hl he ht hvH hv hl0 hl64 hmi hj hjl hjK hK2 hst hwT heT
  let q := tm.cell(H.vm, l0, j)
  let T := fn_update(fn_update(H, "blocks", malloc.set_block(H.blocks, q, none)), "vm", V)
  let X := malloc.range(q, snd(H.blocks[q]))
  have hfr hop hom hwf hla := hl
  have hi heo hw hfs hk ha hb := hmi
  have tv: T.vm = V by simp()
  have tb: T.blocks = malloc.set_block(H.blocks, q, none) by simp()
  have tfs: T.fs_base = S0.fs_base by simp(hfs)
  have tob: T.objs = H.objs by simp()
  have _ ti _ := expand(hst, malloc.step_ok)
  have bj := mp(all_elim(hb, {j}), hj, hjl, hjK)
  have hq _ hn _ _ := bj
  // (the block's bytes: live, mapped)
  have xl: all a. a in X -> a in malloc.live_of(H.blocks) proof
    fix a
    assume w
    have ao _ := unsel(expand(w, malloc.range))
    show := apply(mp.blk_live[b := H.blocks, p := q, a := a], hq, hn, ao, w)
  qed
  have xe: all a. a in X -> a in malloc.errno_bytes(eo, H) || a in malloc.live_of(H.blocks) proof
    fix a
    assume w
    show by taut(mp(all_elim(xl, {a}), w))
  qed
  have lnew: all a. a in malloc.live_of(T.blocks) -> (a in malloc.live_of(H.blocks) || a in O[H]) || !x86_64_linux.mapped(H.vm, int_div(a, x86_64_linux.PAGE)) proof
    fix a
    assume w
    show by taut(apply(mp.live_drop[b := H.blocks, p := q, a := a], hq, rewrite(tb, w)))
  qed
  have kT := apply(tm.kept_step[I := I, O := O, eo := eo, S0 := S0, H := H, T := T, X := X], hk, hst, hfs, xe, lnew)
  have xm: all x. x in X -> x86_64_linux.mapped(H.vm, int_div(x, x86_64_linux.PAGE)) proof
    fix x
    assume w
    have _ rw _ := apply(tm.live_rw[I := I, O := O, H := H, a := x], hop, hwf, ht, hi, mp(all_elim(xl, {x}), w))
    have m _ _ := expand(rw, malloc.rw_mapped)
    show m
  qed
  have arT: tm.arr(O, T, l0) proof
    fix a
    assume ao h1 h2
    have l nO := mp(all_elim(ha, {a}), ao, h1, h2)
    have _ nT := apply(tm.obj_step[I := I, O := O, b := b, cd := cd, st := st, H := H, T := T, X := X, a := a], hst, hw, xm, ao, l, nO)
    show by taut(rewrite(sym(tob), l), nT)
  qed
  have ce: all k. k in omega -> int_lt(k, 8) -> tm.cell(T.vm, l0, k) = tm.cell(H.vm, l0, k) proof
    fix k
    assume hk2 hkl
    have ag: all a. a in omega -> int_le(int_add(l0, int_mul(8, k)), a) -> int_lt(a, int_add(int_add(l0, int_mul(8, k)), 8)) ->
        T.vm.bytes[bits_of_int(64, a)] = H.vm.bytes[bits_of_int(64, a)] proof
      fix a
      assume ao h1 h2
      have l nO := mp(all_elim(ha, {a}), ao, (int_le(l0, a) by arith(h1, hk2)), (int_lt(a, int_add(l0, 64)) by arith(h2, hkl)))
      have bt _ := apply(tm.obj_step[I := I, O := O, b := b, cd := cd, st := st, H := H, T := T, X := X, a := a], hst, hw, xm, ao, l, nO)
      show bt
    qed
    show := apply(tm.cell_eq[V := H.vm, V2 := T.vm, c := int_add(l0, int_mul(8, k))], (int_add(l0, int_mul(8, k)) in omega by arith(hl0, hk2)),
      (int_le(int_add(int_add(l0, int_mul(8, k)), 8), 18446744073709551616) by arith(hl64, hkl, hk2)), ag)
  qed
  have bksT: tm.bks(T, l0, K2) proof
    fix k
    assume hk2 hkl hkK2
    have hkK nkj := mp(all_elim(hK2, {k}), hk2, hkK2)
    let q2 := tm.cell(H.vm, l0, k)
    have bH := mp(all_elim(hb, {k}), hk2, hkl, hkK)
    have hq2 _ hn2 _ _ := bH
    have nq: !(q2 = q) proof
      assume e
      show by taut(nkj, apply(tm.bk_distinct[H := H, q := q2, k := k, j := j], hk2, hj, hkl, hjl, bH, rewrite(sym(e), bj)))
    qed
    have tbq: T.blocks[q2] = H.blocks[q2] by defs(simp(nq, hq2), malloc.set_block)
    have hxr: all a. a in omega -> int_le(q2, a) -> int_lt(a, int_add(q2, snd(H.blocks[q2]))) -> !(a in X) proof
      fix a
      assume ao h1 h2
      have ir: a in malloc.range(q2, snd(H.blocks[q2])) by defs(sel(taut(ao, h1, h2)), malloc.range)
      show := apply(tm.blk_apart[I := I, H := H, q := q2, q2 := q, a := a], hwf, ht, hi, hq2, hq, hn2, hn, nq, ir)
    qed
    have bT := apply(tm.bk_step[I := I, O := O, H := H, T := T, X := X, q := q2, k := k], hk2, hop, hwf, ht, hi, hvH, rewrite(sym(tv), hv), bH, hst, hxr, tbq)
    show := rewrite(sym(mp(all_elim(ce, {k}), hk2, hkl)), bT)
  qed
  show by taut(ti, heT, hwT, tfs, kT, arT, bksT)
qed

// (a store's bytes: elsewhere as before)
theorem tm.st_at(B, A, n, v, x): x in bits(64) -> A in omega -> n in omega -> int_le(int_add(A, n), 18446744073709551616) -> !(int_le(A, x) && int_lt(x, int_add(A, n))) ->
  x86_64_linux.store_le(B, A, n, v)[x] = B[x]
proof
  assume hx ha hn hl hno
  have e := mp(app_fn_build[d := bits(64), v := x0. ite(int_lt(bits_sub(64, x0, A), n), bits_of_int(8, int_div(v, int_pow(256, bits_sub(64, x0, A)))), B[x0]), a := x], hx)
  have ns: !int_lt(bits_sub(64, x, A), n) by defs(arith(hx, ha, hn, hl, hno), bits_sub, pow2)
  show by defs(simp(e, ns), x86_64_linux.store_le)
qed

// main storing p at its array's word i (none of K's): main's invariant
// kept, the word p
theorem tm.mi_store(I, O, eo, b, cd, st, S0, H, l0, K, i, p): tm.laws(I, O, eo) -> H in rec_and(abi.World, malloc.Heap.ghost) ->
  fn_update(H, "vm", fn_update(H.vm, "bytes", x86_64_linux.store_le(H.vm.bytes, int_add(l0, int_mul(8, i)), 8, p))) in rec_and(abi.World, malloc.Heap.ghost) ->
  H.vm in x86_64_linux.Vm -> l0 in omega -> int_le(int_add(l0, 64), 18446744073709551616) -> i in omega -> int_lt(i, 8) -> p in bits(64) ->
  tm.mi(I, O, eo, b, cd, st, S0, H, l0, K) -> (all k. k in omega -> k in K -> !(k = i)) ->
  tm.mi(I, O, eo, b, cd, st, S0, fn_update(H, "vm", fn_update(H.vm, "bytes", x86_64_linux.store_le(H.vm.bytes, int_add(l0, int_mul(8, i)), 8, p))), l0, K) &&
  tm.cell(fn_update(H.vm, "bytes", x86_64_linux.store_le(H.vm.bytes, int_add(l0, int_mul(8, i)), 8, p)), l0, i) = p
proof
  assume hl ht ht2 hvH hl0 hl64 hi0 hil hp hmi hKi
  let A := int_add(l0, int_mul(8, i))
  let X := x86_64_linux.store_le(H.vm.bytes, A, 8, p)
  let VX := fn_update(H.vm, "bytes", X)
  let T := fn_update(H, "vm", VX)
  have hfr hop hom hwf hla := hl
  have hi heo hw hfs hk ha hb := hmi
  have ao: A in omega by arith(hl0, hi0)
  have a8: int_le(int_add(A, 8), 18446744073709551616) by arith(hl64, hil, hi0)
  have out: all x. x in bits(64) -> !(int_le(A, x) && int_lt(x, int_add(A, 8))) -> X[x] = H.vm.bytes[x] proof
    fix x
    assume hx hn
    show := apply(tm.st_at[B := H.vm.bytes, A := A, n := 8, v := p, x := x], hx, ao, simp(), a8, hn)
  qed
  // (the word's bytes: the array's -- live, unmapped, none of the allocator's)
  have hW: all x. x in bits(64) -> X[x] = H.vm.bytes[x] ||
      ((x in malloc.live_of(H.blocks) || !x86_64_linux.mapped(H.vm, int_div(x, x86_64_linux.PAGE))) && !(x in O[H])) proof
    fix x
    assume hx
    have c1: int_le(A, x) && int_lt(x, int_add(A, 8)) -> !x86_64_linux.mapped(H.vm, int_div(x, x86_64_linux.PAGE)) && !(x in O[H]) proof
      assume w
      have w1 w2 := w
      have l nO := mp(all_elim(ha, {x}), (x in omega by arith(hx)), (int_le(l0, x) by arith(w1, hi0)), (int_lt(x, int_add(l0, 64)) by arith(w2, hil)))
      show by taut(apply(tm.obj_unm[b := b, cd := cd, st := st, H := H, a := x], hw, (x in omega by arith(hx)), l), nO)
    qed
    show by taut(c1, mp(all_elim(out, {x}), hx))
  qed
  have {tin = inv, tow = own, eok = eok, wok = wok, kept = kept} := apply(tm.client[I := I, O := O, eo := eo, b := b, cd := cd, st := st, S0 := S0, H := H, X := X],
    hfr, hop, hom, hwf, hla, ht, ht2, hi, heo, hw, hk, hW)
  have tob: T.objs = H.objs by simp()
  have tbl: T.blocks = H.blocks by simp()
  have arT: tm.arr(O, T, l0) proof
    fix a
    assume ao2 h1 h2
    have l nO := mp(all_elim(ha, {a}), ao2, h1, h2)
    show by taut(rewrite(sym(tob), l), rewrite(sym(tow), nO))
  qed
  // (a byte off the word, below 2^64: as it was)
  have agr: all a. a in omega -> int_lt(a, 18446744073709551616) -> !(int_le(A, a) && int_lt(a, int_add(A, 8))) -> T.vm.bytes[bits_of_int(64, a)] = H.vm.bytes[bits_of_int(64, a)] proof
    fix a
    assume ao2 al hn
    have be: bits_of_int(64, a) = a by defs(arith(ao2, al), bits_of_int, pow2)
    have xb: a in bits(64) by arith(ao2, al)
    show by simp(be, mp(all_elim(out, {a}), xb, hn))
  qed
  have bksT: tm.bks(T, l0, K) proof
    fix k
    assume hk2 hkl hkK
    have nki := mp(all_elim(hKi, {k}), hk2, hkK)
    have ce: tm.cell(T.vm, l0, k) = tm.cell(H.vm, l0, k) proof
      have ag: all a. a in omega -> int_le(int_add(l0, int_mul(8, k)), a) -> int_lt(a, int_add(int_add(l0, int_mul(8, k)), 8)) ->
          T.vm.bytes[bits_of_int(64, a)] = H.vm.bytes[bits_of_int(64, a)] proof
        fix a
        assume ao2 h1 h2
        show := mp(all_elim(agr, {a}), ao2, (int_lt(a, 18446744073709551616) by arith(h2, hl64, hkl, hk2)),
          (!(int_le(A, a) && int_lt(a, int_add(A, 8))) by arith(h1, h2, nki, hk2, hi0)))
      qed
      show := apply(tm.cell_eq[V := H.vm, V2 := T.vm, c := int_add(l0, int_mul(8, k))], (int_add(l0, int_mul(8, k)) in omega by arith(hl0, hk2)),
        (int_le(int_add(int_add(l0, int_mul(8, k)), 8), 18446744073709551616) by arith(hl64, hkl, hk2)), ag)
    qed
    let q := tm.cell(H.vm, l0, k)
    have bH := mp(all_elim(hb, {k}), hk2, hkl, hkK)
    have hq q0 hn hz hpt := bH
    // (the block's bytes: mapped, so off the word)
    have bag: all a. a in omega -> int_le(q, a) -> int_lt(a, int_add(q, test_malloc.size_of(k))) -> T.vm.bytes[bits_of_int(64, a)] = H.vm.bytes[bits_of_int(64, a)] proof
      fix a
      assume ao2 h1 h2
      have {rw = rw} := apply(tm.live_facts[I := I, O := O, H := H, q := q, a := a], hop, hwf, ht, hi, hq, hn, ao2, h1, (int_lt(a, int_add(q, snd(H.blocks[q]))) by arith(h2, hz)))
      have m _ _ := expand(rw, malloc.rw_mapped)
      have ml _ := expand(m, x86_64_linux.mapped)
      have nw: !(int_le(A, a) && int_lt(a, int_add(A, 8))) proof
        assume w
        have w1 w2 := w
        have l _ := mp(all_elim(ha, {a}), ao2, (int_le(l0, a) by arith(w1, hi0)), (int_lt(a, int_add(l0, 64)) by arith(w2, hil)))
        show by taut(m, apply(tm.obj_unm[b := b, cd := cd, st := st, H := H, a := a], hw, ao2, l))
      qed
      show := mp(all_elim(agr, {a}), ao2, (int_lt(a, 18446744073709551616) by defs(arith(ml, ao2), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)), nw)
    qed
    have s16: int_le(16, test_malloc.size_of(k)) by defs(arith(hk2), test_malloc.size_of)
    have {rwl = rw} := apply(tm.live_facts[I := I, O := O, H := H, q := q, a := int_sub(int_add(q, test_malloc.size_of(k)), 1)], hop, hwf, ht, hi, hq, hn,
      (int_sub(int_add(q, test_malloc.size_of(k)), 1) in omega by arith(hq, s16)), (int_le(q, int_sub(int_add(q, test_malloc.size_of(k)), 1)) by arith(s16)),
      (int_lt(int_sub(int_add(q, test_malloc.size_of(k)), 1), int_add(q, snd(H.blocks[q]))) by arith(hz)))
    have ml2 _ _ := expand(rwl, malloc.rw_mapped)
    have mt _ := expand(ml2, x86_64_linux.mapped)
    have hlt: int_lt(int_add(q, test_malloc.size_of(k)), 18446744073709551616) by defs(arith(mt, hq, s16), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
    have vX: VX in x86_64_linux.Vm := mp(all_elim(ms.wr_any, {H.vm}, {A}, {8}, {p}), hvH)
    have pT := apply(tm.pat_keep[V := H.vm, V2 := T.vm, q := q, k := k], hvH, (T.vm in x86_64_linux.Vm by simp(vX)), hq, hlt, hpt, bag)
    have bT: tm.bk(T, q, k) by taut(hq, q0, rewrite(sym(tbl), hn), rewrite(sym(tbl), hz), pT)
    show := rewrite(sym(ce), bT)
  qed
  have cv: tm.cell(VX, l0, i) = p by mem(hp, ao, a8)
  show by taut(tin, eok, wok, (T.fs_base = S0.fs_base by simp(hfs)), kept, arT, bksT, cv)
qed

// fill of block i at its array word's q (a live block of at least size(i)
// bytes, none of K's): main's invariant for K2, K with i
theorem tm.mi_fill(I, O, eo, b, cd, st, S0, H, l0, K, K2, i, V): tm.laws(I, O, eo) -> H in rec_and(abi.World, malloc.Heap.ghost) ->
  fn_update(H, "vm", V) in rec_and(abi.World, malloc.Heap.ghost) -> H.vm in x86_64_linux.Vm -> l0 in omega -> int_le(int_add(l0, 64), 18446744073709551616) ->
  i in omega -> int_lt(i, 8) -> tm.mi(I, O, eo, b, cd, st, S0, H, l0, K) -> (all k. k in omega -> k in K2 -> k in K || k = i) ->
  tm.cell(H.vm, l0, i) in bits(64) -> !(tm.cell(H.vm, l0, i) = 0) -> !(H.blocks[tm.cell(H.vm, l0, i)] = none) ->
  int_le(test_malloc.size_of(i), snd(H.blocks[tm.cell(H.vm, l0, i)])) ->
  (all k. k in omega -> int_lt(k, 8) -> k in K -> !(tm.cell(H.vm, l0, k) = tm.cell(H.vm, l0, i))) ->
  tp.finv(H.vm, V, tm.cell(H.vm, l0, i), i, test_malloc.size_of(i)) ->
  tm.mi(I, O, eo, b, cd, st, S0, fn_update(H, "vm", V), l0, K2)
proof
  assume hl ht ht2 hvH hl0 hl64 hi0 hil hmi hK2 hqb hq0 hqn hqz hdis hf
  let q := tm.cell(H.vm, l0, i)
  let SZ := test_malloc.size_of(i)
  let T := fn_update(H, "vm", V)
  have hfr hop hom hwf hla := hl
  have hi heo hw hfs hk ha hb := hmi
  have vV e0 fpat fout := hf
  // (V: H's memory with V's bytes)
  have vf vd := (is_fun(V) && "bytes" in dom(V) by simp(expand(vV, x86_64_linux.Vm)))
  have t1 := fn_update_twice[f := V, k := "bytes", a := H.vm.bytes, b := V.bytes]
  have t2 := mp(fn_update_same[f := V, k := "bytes"], vf, vd)
  have veq: fn_update(H.vm, "bytes", V.bytes) = V := trans(rewrite(e0, t1), t2)
  have teq: fn_update(H, "vm", fn_update(H.vm, "bytes", V.bytes)) = T := rewrite(veq, refl({fn_update(H, "vm", fn_update(H.vm, "bytes", V.bytes))}), {2})
  // (V's bytes: H's but the block's first SZ)
  have s16: int_le(16, SZ) by defs(arith(hi0), test_malloc.size_of)
  have hW: all x. x in bits(64) -> V.bytes[x] = H.vm.bytes[x] ||
      ((x in malloc.live_of(H.blocks) || !x86_64_linux.mapped(H.vm, int_div(x, x86_64_linux.PAGE))) && !(x in O[H])) proof
    fix x
    assume hx
    have c1: int_le(q, x) && int_lt(x, int_add(q, SZ)) -> x in malloc.live_of(H.blocks) && !(x in O[H]) proof
      assume w
      have w1 w2 := w
      have {lv = lv, no = own} := apply(tm.live_facts[I := I, O := O, H := H, q := q, a := x], hop, hwf, ht, hi, hqb, hqn, (x in omega by arith(hx)), w1,
        (int_lt(x, int_add(q, snd(H.blocks[q]))) by arith(w2, hqz)))
      show by taut(lv, no)
    qed
    show by taut(c1, mp(all_elim(fout, {x}), hx))
  qed
  have {tin = inv, tow = own, eok = eok, wok = wok, kept = kept} := apply(tm.client[I := I, O := O, eo := eo, b := b, cd := cd, st := st, S0 := S0, H := H, X := V.bytes],
    hfr, hop, hom, hwf, hla, ht, rewrite(sym(teq), ht2), hi, heo, hw, hk, hW)
  have tin2 := rewrite(teq, tin)
  have tow2 := rewrite(teq, tow)
  have eok2 := rewrite(teq, eok)
  have wok2 := rewrite(teq, wok)
  have kept2 := rewrite(teq, kept)
  have tob: T.objs = H.objs by simp()
  have tbl: T.blocks = H.blocks by simp()
  have tv: T.vm = V by simp()
  have arT: tm.arr(O, T, l0) proof
    fix a
    assume ao2 h1 h2
    have l nO := mp(all_elim(ha, {a}), ao2, h1, h2)
    show by taut(rewrite(sym(tob), l), rewrite(sym(tow2), nO))
  qed
  // (a byte off the block, below 2^64: as it was)
  have agr: all a. a in omega -> int_lt(a, 18446744073709551616) -> !(int_le(q, a) && int_lt(a, int_add(q, SZ))) ->
      T.vm.bytes[bits_of_int(64, a)] = H.vm.bytes[bits_of_int(64, a)] proof
    fix a
    assume ao2 al hn
    have be: bits_of_int(64, a) = a by defs(arith(ao2, al), bits_of_int, pow2)
    have xb: a in bits(64) by arith(ao2, al)
    show by simp(be, tv, mp(all_elim(fout, {a}), xb, hn))
  qed
  // (the array's words: unmapped, so off the block)
  have ce: all k. k in omega -> int_lt(k, 8) -> tm.cell(T.vm, l0, k) = tm.cell(H.vm, l0, k) proof
    fix k
    assume hk2 hkl
    have ag: all a. a in omega -> int_le(int_add(l0, int_mul(8, k)), a) -> int_lt(a, int_add(int_add(l0, int_mul(8, k)), 8)) ->
        T.vm.bytes[bits_of_int(64, a)] = H.vm.bytes[bits_of_int(64, a)] proof
      fix a
      assume ao2 h1 h2
      have l _ := mp(all_elim(ha, {a}), ao2, (int_le(l0, a) by arith(h1, hk2)), (int_lt(a, int_add(l0, 64)) by arith(h2, hkl)))
      have um := apply(tm.obj_unm[b := b, cd := cd, st := st, H := H, a := a], hw, ao2, l)
      have nb: !(int_le(q, a) && int_lt(a, int_add(q, SZ))) proof
        assume w
        have w1 w2 := w
        have {rw = rw} := apply(tm.live_facts[I := I, O := O, H := H, q := q, a := a], hop, hwf, ht, hi, hqb, hqn, ao2, w1, (int_lt(a, int_add(q, snd(H.blocks[q]))) by arith(w2, hqz)))
        have m _ _ := expand(rw, malloc.rw_mapped)
        show by taut(m, um)
      qed
      show := mp(all_elim(agr, {a}), ao2, (int_lt(a, 18446744073709551616) by arith(h2, hl64, hkl, hk2)), nb)
    qed
    show := apply(tm.cell_eq[V := H.vm, V2 := T.vm, c := int_add(l0, int_mul(8, k))], (int_add(l0, int_mul(8, k)) in omega by arith(hl0, hk2)),
      (int_le(int_add(int_add(l0, int_mul(8, k)), 8), 18446744073709551616) by arith(hl64, hkl, hk2)), ag)
  qed
  have bksT: tm.bks(T, l0, K2) proof
    fix k
    assume hk2 hkl hkK2
    have ck := mp(all_elim(ce, {k}), hk2, hkl)
    have cK: k in K -> tm.bk(T, tm.cell(T.vm, l0, k), k) proof
      assume hkK
      let q2 := tm.cell(H.vm, l0, k)
      have bH := mp(all_elim(hb, {k}), hk2, hkl, hkK)
      have hq2 q20 hn2 hz2 hp2 := bH
      have nq := mp(all_elim(hdis, {k}), hk2, hkl, hkK)
      have s16k: int_le(16, test_malloc.size_of(k)) by defs(arith(hk2), test_malloc.size_of)
      have bag: all a. a in omega -> int_le(q2, a) -> int_lt(a, int_add(q2, test_malloc.size_of(k))) -> T.vm.bytes[bits_of_int(64, a)] = H.vm.bytes[bits_of_int(64, a)] proof
        fix a
        assume ao2 h1 h2
        have ir: a in malloc.range(q2, snd(H.blocks[q2])) by defs(sel(taut(ao2, h1, (int_lt(a, int_add(q2, snd(H.blocks[q2]))) by arith(h2, hz2)))), malloc.range)
        have na := apply(tm.blk_apart[I := I, H := H, q := q2, q2 := q, a := a], hwf, ht, hi, hq2, hqb, hn2, hqn, nq, ir)
        have nb: !(int_le(q, a) && int_lt(a, int_add(q, SZ))) proof
          assume w
          have w1 w2 := w
          show by taut(na, (a in malloc.range(q, snd(H.blocks[q])) by defs(sel(taut(ao2, w1, (int_lt(a, int_add(q, snd(H.blocks[q]))) by arith(w2, hqz)))), malloc.range)))
        qed
        have {rw = rw} := apply(tm.live_facts[I := I, O := O, H := H, q := q2, a := a], hop, hwf, ht, hi, hq2, hn2, ao2, h1, (int_lt(a, int_add(q2, snd(H.blocks[q2]))) by arith(h2, hz2)))
        have m _ _ := expand(rw, malloc.rw_mapped)
        have ml _ := expand(m, x86_64_linux.mapped)
        show := mp(all_elim(agr, {a}), ao2, (int_lt(a, 18446744073709551616) by defs(arith(ml, ao2), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)), nb)
      qed
      have {rwl = rw} := apply(tm.live_facts[I := I, O := O, H := H, q := q2, a := int_sub(int_add(q2, test_malloc.size_of(k)), 1)], hop, hwf, ht, hi, hq2, hn2,
        (int_sub(int_add(q2, test_malloc.size_of(k)), 1) in omega by arith(hq2, s16k)), (int_le(q2, int_sub(int_add(q2, test_malloc.size_of(k)), 1)) by arith(s16k)),
        (int_lt(int_sub(int_add(q2, test_malloc.size_of(k)), 1), int_add(q2, snd(H.blocks[q2]))) by arith(hz2)))
      have ml2 _ _ := expand(rwl, malloc.rw_mapped)
      have mt _ := expand(ml2, x86_64_linux.mapped)
      have hlt: int_lt(int_add(q2, test_malloc.size_of(k)), 18446744073709551616) by defs(arith(mt, hq2, s16k), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
      have pT := apply(tm.pat_keep[V := H.vm, V2 := T.vm, q := q2, k := k], hvH, rewrite(sym(tv), vV), hq2, hlt, hp2, bag)
      have bT: tm.bk(T, q2, k) by taut(hq2, q20, rewrite(sym(tbl), hn2), rewrite(sym(tbl), hz2), pT)
      show := rewrite(sym(ck), bT)
    qed
    have cI: k = i -> tm.bk(T, tm.cell(T.vm, l0, k), k) proof
      assume e
      have pT: test_malloc.has_pat(T.vm, q, i) by defs(rewrite(sym(tv), fpat), test_malloc.has_pat)
      have bT: tm.bk(T, q, i) by taut(hqb, hq0, rewrite(sym(tbl), hqn), rewrite(sym(tbl), hqz), pT)
      show := rewrite(sym(e), rewrite(sym(mp(all_elim(ce, {i}), hi0, hil)), bT))
    qed
    show by taut(mp(all_elim(hK2, {k}), hk2, hkK2), cK, cI)
  qed
  show by taut(tin2, eok2, wok2, (T.fs_base = S0.fs_base by simp(hfs)), kept2, arT, bksT)
qed

// ----------------------------------------------------------------------
//  A block for fill and intact

// a live block q of at least size(k) bytes: usable for block k (reading,
// writing), none of the thread's word
theorem tm.blk_pre(I, O, eo, b, cd, st, H, q, k, w): tm.laws(I, O, eo) -> H in rec_and(abi.World, malloc.Heap.ghost) -> H in I ->
  malloc.world_ok(b, cd, st, H) -> k in omega -> q in bits(64) -> !(q = 0) -> !(H.blocks[q] = none) -> int_le(test_malloc.size_of(k), snd(H.blocks[q])) ->
  test_malloc.blk_usable(H.vm, H.objs, q, k, w) && (all j. j in omega -> int_lt(j, test_malloc.size_of(k)) -> !(int_add(q, j) in malloc.range(H.fs_base, 8)))
proof
  assume hl ht hi hw hk hq hq0 hn hz
  have hfr hop hom hwf hla := hl
  have n1 c2 _ _ _ _ _ _ _ := expand(hw, malloc.world_ok)
  have la := mp(all_elim(expand(hla, malloc.live_apart), {H}), ht, hi)
  let SZ := test_malloc.size_of(k)
  have s16: int_le(16, SZ) by defs(arith(hk), test_malloc.size_of)
  // (a byte of the block: live, mapped read-write, no stack page's, a C byte)
  have byte: all j. j in omega -> int_lt(j, SZ) -> (malloc.rw_mapped(H.vm, int_add(q, j)) && !(snd(H.vm.pages[int_div(int_add(q, j), x86_64_linux.PAGE)]).kind = 2)) &&
      int_add(q, j) in H.objs.c_bytes && !(int_add(q, j) in malloc.range(H.fs_base, 8)) proof
    fix j
    assume hj hjl
    let a := int_add(q, j)
    have ao: a in omega by arith(hq, hj)
    have {lv = lv, rw = rw} := apply(tm.live_facts[I := I, O := O, H := H, q := q, a := a], hop, hwf, ht, hi, hq, hn, ao, (int_le(q, a) by arith(hj)),
      (int_lt(a, int_add(q, snd(H.blocks[q]))) by arith(hjl, hz)))
    have m _ _ := expand(rw, malloc.rw_mapped)
    have ml mn := expand(m, x86_64_linux.mapped)
    have pg: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
    have qs: int_div(a, x86_64_linux.PAGE) in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) by sel(taut((int_div(a, x86_64_linux.PAGE) in omega by arith(ao, pg)), ml))
    have nk := mp(all_elim(n1, {int_div(a, x86_64_linux.PAGE)}), qs, mn)
    have nr nc ncan := mp(all_elim(la, {a}), ao, (a in malloc.live(H) by defs(lv, malloc.live)))
    have cb: a in H.objs.c_bytes := rewrite(sym(c2), (a in set_select(omega, x0. !(x0 in abi.canary(H.fs_base))) by sel(taut(ao, ncan))))
    show by taut(rw, nk, cb, nr)
  qed
  have us: all j. j in omega -> int_lt(j, SZ) -> gimple.usable(H.vm, H.objs, int_add(q, j), 1, w) proof
    fix j
    assume hj hjl
    have rw nk cb _ := mp(all_elim(byte, {j}), hj, hjl)
    have m pr pw := expand(rw, malloc.rw_mapped)
    unfold gimple.usable
    fix x0
    assume h0 h1
    have z: x0 = 0 by arith(h0, h1)
    have z2: int_add(int_add(q, j), 0) = int_add(q, j) by arith()
    show by simp(z, z2, m, pr, pw, nk, cb)
  qed
  // (its last byte mapped: below the task's end)
  have rwl _ _ _ := mp(all_elim(byte, {int_sub(SZ, 1)}), (int_sub(SZ, 1) in omega by arith(s16)), (int_lt(int_sub(SZ, 1), SZ) by arith()))
  have ml2 _ _ := expand(rwl, malloc.rw_mapped)
  have mt _ := expand(ml2, x86_64_linux.mapped)
  have hlt: int_lt(int_add(q, SZ), int_pow(2, 63)) by defs(arith(mt, hq, s16), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
  have bu: test_malloc.blk_usable(H.vm, H.objs, q, k, w) by defs(taut(hq0, hlt, us), test_malloc.blk_usable)
  have nf: all j. j in omega -> int_lt(j, SZ) -> !(int_add(q, j) in malloc.range(H.fs_base, 8)) proof
    fix j
    assume hj hjl
    have _ _ _ r := mp(all_elim(byte, {j}), hj, hjl)
    show r
  qed
  show by taut(bu, nf)
qed

// ----------------------------------------------------------------------
//  main's start and end

// a world with its live objects L, all in the stack's space: as any call
// needs it still
theorem tm.wok_live(b, cd, st, H, L): malloc.world_ok(b, cd, st, H) ->
  (all a. a in omega -> a in L -> int_le(x86_64_linux.stack_floor(H.vm), a) && int_lt(a, H.vm.stack_top)) ->
  malloc.world_ok(b, cd, st, fn_update(H, "objs", fn_update(H.objs, "live", L)))
proof
  assume hw hL
  have n1 c2 th cn bs ld lv os tk := expand(hw, malloc.world_ok)
  have lv2: all x0. x0 in omega -> x0 in fn_update(H, "objs", fn_update(H.objs, "live", L)).objs.live ->
      (int_le(x86_64_linux.stack_floor(H.vm), x0) && int_lt(x0, H.vm.stack_top)) && int_lt(x0, x86_64_linux.TASK_SIZE) proof
    fix a
    assume ao w
    have l1 l2 := mp(all_elim(hL, {a}), ao, (a in L by simp(w)))
    show by taut(l1, l2, (int_lt(a, x86_64_linux.TASK_SIZE) by arith(l2, tk)))
  qed
  show by defs(simp(n1, c2, th, cn, bs, ld, lv2, os, tk), malloc.world_ok)
qed

// (the memory outside the allocator's at S0, no block live: kept at S0)
theorem tm.kept_refl(O, eo, S0): (all p. p in bits(64) -> S0.blocks[p] = none) -> tm.kept(O, eo, S0, S0)
proof
  assume hb
  fix a
  assume ao no ne m0
  have nl: !(a in malloc.live_of(S0.blocks)) proof
    assume w
    have _ ex := (a in omega && (ex q. q in bits(64) && (!(S0.blocks[q] = none) && a in malloc.range(q, snd(S0.blocks[q])))) by taut(apply(mp.live_def[b := S0.blocks, a := a]), w))
    obtain q, hq hqn _ from ex
    show by taut(hqn, mp(all_elim(hb, {q}), hq))
  qed
  show by taut(no, nl, refl({S0.vm.bytes[bits_of_int(64, a)]}), refl({S0.vm.pages[int_div(a, x86_64_linux.PAGE)]}))
qed

// main's start: its array placed by alloc_objs at l[0] (64 bytes, free
// stack bytes, any contents) from S0 -- the allocator's start, no block:
// main's invariant, no block of the test's yet
theorem tm.mi_init(I, O, eo, b, cd, st, S0, V, l): tm.laws(I, O, eo) -> S0 in rec_and(abi.World, malloc.Heap.ghost) ->
  fn_update(S0, "vm", V) in rec_and(abi.World, malloc.Heap.ghost) ->
  fn_update(fn_update(S0, "vm", V), "objs", fn_update(S0.objs, "live", g.live_with(S0.objs.live, l, seq_one(pair(64, 16))))) in rec_and(abi.World, malloc.Heap.ghost) ->
  S0 in I -> malloc.errno_ok(eo, S0) -> malloc.world_ok(b, cd, st, S0) -> (all p. p in bits(64) -> S0.blocks[p] = none) ->
  l in list_type(bits(64)) -> gimple.objs_fit(S0.vm, S0.objs, seq_one(pair(64, 16)), l) -> V in x86_64_linux.Vm -> fn_update(V, "bytes", S0.vm.bytes) = S0.vm ->
  (all x0. x0 in bits(64) -> (all x1. x1 in omega -> int_lt(x1, seq_len(seq_one(pair(64, 16)))) -> !(int_le(l[x1], x0) && int_lt(x0, int_add(l[x1], fst(seq_one(pair(64, 16))[x1]))))) ->
     V.bytes[x0] = S0.vm.bytes[x0]) ->
  tm.mi(I, O, eo, b, cd, st, S0, fn_update(fn_update(S0, "vm", V), "objs", fn_update(S0.objs, "live", g.live_with(S0.objs.live, l, seq_one(pair(64, 16))))), l[0], empty) &&
  l[0] in omega && int_le(int_add(l[0], 64), 18446744073709551616)
proof
  assume hl ht ht1 ht2 hi heo hw hbn hll hfit hv hvb hvf
  let SZ := seq_one(pair(64, 16))
  let L := g.live_with(S0.objs.live, l, SZ)
  let H1 := fn_update(S0, "vm", V)
  let H2 := fn_update(H1, "objs", fn_update(S0.objs, "live", L))
  have hfr hop hom hwf hla := hl
  have n1 _ _ _ _ _ lv _ _ := expand(hw, malloc.world_ok)
  // the array: free stack bytes, in the stack's space, on no page
  have ln _ _ _ := expand(hfit, gimple.objs_fit)
  have _ hall _ hin := expand(hfit, gimple.objs_fit)
  have sz1: fst(SZ[0]) = 64 by simp()
  have szl: seq_len(SZ) = 1 by simp()
  have _ l0nz l0le l0f := mp(all_elim(hall, {0}), simp(), simp(szl))
  have l0b: l[0] in bits(64) := mp(at_type[l := l, t := bits(64), i := 0], hll, simp(), simp(trans(ln, szl)))
  have l0o: l[0] in omega by simp(l0b)
  have l64: int_le(int_add(l[0], 64), 18446744073709551616) by simp(rewrite(sz1, l0le))
  let IA(a) := int_le(l[0], a) && int_lt(a, int_add(l[0], 64))
  have afree: all a. a in omega -> IA(a) -> !x86_64_linux.mapped(S0.vm, int_div(a, x86_64_linux.PAGE)) && !(a in S0.objs.live) proof
    fix a
    assume ao w
    have sf := mp(all_elim(l0f, {a}), ao, rewrite(sym(sz1), w))
    have s1 s2 := expand(sf, abi.stack_free)
    have nm: !x86_64_linux.mapped(S0.vm, int_div(a, x86_64_linux.PAGE)) proof
      assume m
      have ml mn := expand(m, x86_64_linux.mapped)
      have pg: x86_64_linux.PAGE = 4096 by defs(refl({4096}), x86_64_linux.PAGE)
      have qs: int_div(a, x86_64_linux.PAGE) in set_select(omega, x1. int_lt(x1, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))) by sel(taut((int_div(a, x86_64_linux.PAGE) in omega by arith(ao, pg)), ml))
      show by taut(s1, m, mp(all_elim(n1, {int_div(a, x86_64_linux.PAGE)}), qs, mn))
    qed
    show by taut(nm, s2)
  qed
  have aspace: all a. a in omega -> IA(a) -> int_le(x86_64_linux.stack_floor(S0.vm), a) && int_lt(a, S0.vm.stack_top) proof
    fix a
    assume ao w
    have w1 w2 := w
    show := mp(all_elim(hin, {0}, {a}), conj((0 in omega by simp()), ao), conj(conj((int_lt(0, seq_len(SZ)) by simp(szl)), w1),
      (int_lt(a, int_add(l[0], fst(SZ[0]))) by simp(w2, sz1))))
  qed
  have anown: all a. a in omega -> IA(a) -> !(a in O[S0]) proof
    fix a
    assume ao w
    have nm nl := mp(all_elim(afree, {a}), ao, w)
    assume ho
    show by taut(mp(all_elim(mp(all_elim(expand(hom, malloc.owned_mapped), {S0}), ht, hi), {a}), ao, ho), nm, nl)
  qed
  // the array's contents: written -- the allocator's invariant, errno, the
  // world, the memory outside the allocator's kept (no byte of theirs)
  have vf vd := (is_fun(V) && "bytes" in dom(V) by simp(expand(hv, x86_64_linux.Vm)))
  have t1 := fn_update_twice[f := V, k := "bytes", a := S0.vm.bytes, b := V.bytes]
  have t2 := mp(fn_update_same[f := V, k := "bytes"], vf, vd)
  have veq: fn_update(S0.vm, "bytes", V.bytes) = V := trans(rewrite(hvb, t1), t2)
  have heq: fn_update(S0, "vm", fn_update(S0.vm, "bytes", V.bytes)) = H1 := rewrite(veq, refl({fn_update(S0, "vm", fn_update(S0.vm, "bytes", V.bytes))}), {2})
  have hW: all x. x in bits(64) -> V.bytes[x] = S0.vm.bytes[x] ||
      ((x in malloc.live_of(S0.blocks) || !x86_64_linux.mapped(S0.vm, int_div(x, x86_64_linux.PAGE))) && !(x in O[S0])) proof
    fix x
    assume hx
    have c1: IA(x) -> !x86_64_linux.mapped(S0.vm, int_div(x, x86_64_linux.PAGE)) && !(x in O[S0]) proof
      assume w
      have nm _ := mp(all_elim(afree, {x}), (x in omega by arith(hx)), w)
      show by taut(nm, mp(all_elim(anown, {x}), (x in omega by arith(hx)), w))
    qed
    have c2: !IA(x) -> V.bytes[x] = S0.vm.bytes[x] proof
      assume w
      have o: all x1. x1 in omega -> int_lt(x1, seq_len(SZ)) -> !(int_le(l[x1], x) && int_lt(x, int_add(l[x1], fst(SZ[x1])))) proof
        fix x1
        assume h1 h2
        have z: x1 = 0 by arith(h1, rewrite(szl, h2))
        show := rewrite(sym(z), rewrite(sym(sz1), w))
      qed
      show := mp(all_elim(hvf, {x}), hx, o)
    qed
    show by taut(c1, c2)
  qed
  have k0 := apply(tm.kept_refl[O := O, eo := eo, S0 := S0], hbn)
  have {i1 = inv, o1 = own, e1 = eok, w1 = wok, kp1 = kept} := apply(tm.client[I := I, O := O, eo := eo, b := b, cd := cd, st := st, S0 := S0, H := S0, X := V.bytes],
    hfr, hop, hom, hwf, hla, ht, rewrite(sym(heq), ht1), hi, heo, hw, k0, hW)
  have i1b := rewrite(heq, i1)
  have o1b := rewrite(heq, o1)
  have e1b := rewrite(heq, e1)
  have w1b := rewrite(heq, w1)
  have kp1b := rewrite(heq, kp1)
  // the array live: the frame law, the world (its bytes in the stack's space)
  have lL: all a. a in L <-> a in omega && (a in S0.objs.live || (ex x8. x8 in omega && ((int_lt(x8, seq_len(SZ)) && int_le(l[x8], a)) && int_lt(a, int_add(l[x8], fst(SZ[x8])))))) proof
    fix a
    show := set_select_def[s := omega, p := x7. x7 in S0.objs.live || (ex x8. x8 in omega && ((int_lt(x8, seq_len(SZ)) && int_le(l[x8], x7)) && int_lt(x7, int_add(l[x8], fst(SZ[x8]))))), z := a]
  qed
  have inL: all a. a in L -> a in S0.objs.live || IA(a) proof
    fix a
    assume w
    have _ c := (a in omega && (a in S0.objs.live || (ex x8. x8 in omega && ((int_lt(x8, seq_len(SZ)) && int_le(l[x8], a)) && int_lt(a, int_add(l[x8], fst(SZ[x8])))))) by taut(all_elim(lL, {a}), w))
    have c2: (ex x8. x8 in omega && ((int_lt(x8, seq_len(SZ)) && int_le(l[x8], a)) && int_lt(a, int_add(l[x8], fst(SZ[x8]))))) -> IA(a) proof
      assume e
      obtain x8, h0 h1 h2 h3 from e
      have z: x8 = 0 by arith(h0, rewrite(szl, h1))
      show by taut(rewrite(z, h2), rewrite(sz1, rewrite(z, h3)))
    qed
    show by taut(c, c2)
  qed
  have arrL: all a. a in omega -> IA(a) -> a in L proof
    fix a
    assume ao w
    have a1 a2 := w
    show by taut(all_elim(lL, {a}), ao, (ex x8. x8 in omega && ((int_lt(x8, seq_len(SZ)) && int_le(l[x8], a)) && int_lt(a, int_add(l[x8], fst(SZ[x8]))))
      by ex_intro({0}, taut((0 in omega by simp()), (int_lt(0, seq_len(SZ)) by simp(szl)), a1, (int_lt(a, int_add(l[0], fst(SZ[0]))) by simp(a2, sz1))))))
  qed
  have oldL: all a. a in omega -> a in S0.objs.live -> a in L proof
    fix a
    assume ao w
    show by taut(all_elim(lL, {a}), ao, w)
  qed
  have fr2 := mp(all_elim(expand(hfr, malloc.frame), {H1}, {H2}), conj(ht1, ht2), taut(i1b, (H2.blocks = H1.blocks by simp()), (H2.vm.brk = H1.vm.brk by simp()),
    (H2.fs_base = H1.fs_base by simp()), (H2.vm.stack_top = H1.vm.stack_top by simp()), (H2.vm.stack_limit = H1.vm.stack_limit by simp()),
    (all a. a in omega -> a in O[H1] -> H2.vm.bytes[bits_of_int(64, a)] = H1.vm.bytes[bits_of_int(64, a)] && H2.vm.pages[int_div(a, x86_64_linux.PAGE)] = H1.vm.pages[int_div(a, x86_64_linux.PAGE)] by simp()),
    (all a. a in omega -> a in O[H1] && a in H1.objs.live -> a in H2.objs.live by simp(oldL)),
    (all a. a in omega -> a in malloc.live(H1) -> H2.vm.pages[int_div(a, x86_64_linux.PAGE)] = H1.vm.pages[int_div(a, x86_64_linux.PAGE)] by simp())))
  have i2 o2 := fr2
  have vst: V.stack_top = S0.vm.stack_top := rewrite(veq, (fn_update(S0.vm, "bytes", V.bytes).stack_top = S0.vm.stack_top by simp()))
  have vsl: V.stack_limit = S0.vm.stack_limit := rewrite(veq, (fn_update(S0.vm, "bytes", V.bytes).stack_limit = S0.vm.stack_limit by simp()))
  have hsf: x86_64_linux.stack_floor(H1.vm) = x86_64_linux.stack_floor(S0.vm) by defs(simp(vst, vsl), x86_64_linux.stack_floor)
  have _ _ _ _ _ _ lv1 _ _ := expand(w1b, malloc.world_ok)
  have Lsp: all a. a in omega -> a in L -> int_le(x86_64_linux.stack_floor(H1.vm), a) && int_lt(a, H1.vm.stack_top) proof
    fix a
    assume ao w
    have c1: a in S0.objs.live -> int_le(x86_64_linux.stack_floor(H1.vm), a) && int_lt(a, H1.vm.stack_top) proof
      assume l1
      have r1 r2 _ := mp(all_elim(lv1, {a}), ao, (a in H1.objs.live by simp(l1)))
      show by taut(r1, r2)
    qed
    have c2: IA(a) -> int_le(x86_64_linux.stack_floor(H1.vm), a) && int_lt(a, H1.vm.stack_top) proof
      assume ia
      have r1 r2 := mp(all_elim(aspace, {a}), ao, ia)
      show by taut(rewrite(sym(hsf), r1), (int_lt(a, H1.vm.stack_top) by simp(r2, vst)))
    qed
    show by taut(mp(all_elim(inL, {a}), w), c1, c2)
  qed
  have w2 := rewrite((H1.objs = S0.objs by simp()), apply(tm.wok_live[b := b, cd := cd, st := st, H := H1, L := L], w1b, Lsp))
  have e2: malloc.errno_ok(eo, H2) proof
    have g: all a. a in omega -> a in malloc.errno_bytes(eo, H2) -> malloc.rw_mapped(H2.vm, a) proof
      fix a
      assume ao ha
      have eb: malloc.errno_bytes(eo, H2) = malloc.errno_bytes(eo, H1) by defs(simp(), malloc.errno_bytes)
      have r := mp(all_elim(expand(e1b, malloc.errno_ok), {a}), ao, rewrite(eb, ha))
      show by simp(r)
    qed
    show by defs(g, malloc.errno_ok)
  qed
  have k2: tm.kept(O, eo, S0, H2) proof
    fix a
    assume ao no ne m0
    have nh nl bh ph := mp(all_elim(kp1b, {a}), ao, no, ne, m0)
    show by taut(rewrite(sym(o2), nh), (!(a in malloc.live_of(H2.blocks)) by simp(nl)), (H2.vm.bytes[bits_of_int(64, a)] = S0.vm.bytes[bits_of_int(64, a)] by simp(bh)),
      (H2.vm.pages[int_div(a, x86_64_linux.PAGE)] = S0.vm.pages[int_div(a, x86_64_linux.PAGE)] by simp(ph)))
  qed
  have ar2: tm.arr(O, H2, l[0]) proof
    fix a
    assume ao w1 w2
    have lA: a in H2.objs.live by simp(mp(all_elim(arrL, {a}), ao, conj(w1, w2)))
    have nO: !(a in O[H2]) := rewrite(sym(trans(o2, o1b)), mp(all_elim(anown, {a}), ao, conj(w1, w2)))
    show by taut(lA, nO)
  qed
  have bk2: tm.bks(H2, l[0], empty) proof
    fix k
    assume _ _ hk
    show by taut(empty_mem[x := k], hk)
  qed
  show by taut(i2, e2, w2, (H2.fs_base = S0.fs_base by simp()), k2, ar2, bk2, l0o, l64)
qed

// main's end: the objects as at S0 again -- the world as any call needs it,
// the memory outside the allocator's at S0 kept
theorem tm.mi_final(I, O, eo, b, cd, st, S0, H, l0, K): tm.mi(I, O, eo, b, cd, st, S0, H, l0, K) ->
  (all a. a in omega -> a in S0.objs.live -> a in H.objs.live) ->
  malloc.world_ok(b, cd, st, fn_update(H, "objs", fn_update(H.objs, "live", S0.objs.live))) &&
  test_malloc.main_frame(O, eo, S0, fn_update(H, "objs", fn_update(H.objs, "live", S0.objs.live)))
proof
  assume hmi hsub
  have _ _ hw _ hk _ _ := hmi
  have _ _ _ _ _ _ lv _ _ := expand(hw, malloc.world_ok)
  have sp: all a. a in omega -> a in S0.objs.live -> int_le(x86_64_linux.stack_floor(H.vm), a) && int_lt(a, H.vm.stack_top) proof
    fix a
    assume ao w
    have r1 r2 _ := mp(all_elim(lv, {a}), ao, mp(all_elim(hsub, {a}), ao, w))
    show by taut(r1, r2)
  qed
  have w2 := apply(tm.wok_live[b := b, cd := cd, st := st, H := H, L := S0.objs.live], hw, sp)
  have mf: test_malloc.main_frame(O, eo, S0, fn_update(H, "objs", fn_update(H.objs, "live", S0.objs.live))) proof
    have g: all a. a in omega -> (!(a in O[S0]) && !(a in malloc.errno_bytes(eo, S0))) && x86_64_linux.mapped(S0.vm, int_div(a, x86_64_linux.PAGE)) ->
        fn_update(H, "objs", fn_update(H.objs, "live", S0.objs.live)).vm.bytes[bits_of_int(64, a)] = S0.vm.bytes[bits_of_int(64, a)] &&
        fn_update(H, "objs", fn_update(H.objs, "live", S0.objs.live)).vm.pages[int_div(a, x86_64_linux.PAGE)] = S0.vm.pages[int_div(a, x86_64_linux.PAGE)] proof
      fix a
      assume ao h
      have no ne m0 := h
      have _ _ bh ph := mp(all_elim(hk, {a}), ao, no, ne, m0)
      show by simp(bh, ph)
    qed
    show by defs(g, test_malloc.main_frame)
  qed
  show by taut(w2, mf)
qed

// ----------------------------------------------------------------------
//  main's exit when malloc fails: the world, the memory kept

// the world as any call needs it, the memory outside the allocator's at S0
// (but errno) as at S0, the array live
abbrev tm.wk(O, eo, b, cd, st, S0, H, l0) := ((malloc.world_ok(b, cd, st, H) && H.fs_base = S0.fs_base) &&
  (all a. a in omega -> !(a in O[S0]) -> !(a in malloc.errno_bytes(eo, S0)) -> x86_64_linux.mapped(S0.vm, int_div(a, x86_64_linux.PAGE)) ->
     H.vm.bytes[bits_of_int(64, a)] = S0.vm.bytes[bits_of_int(64, a)] && H.vm.pages[int_div(a, x86_64_linux.PAGE)] = S0.vm.pages[int_div(a, x86_64_linux.PAGE)])) &&
  (all a. a in omega -> int_le(l0, a) -> int_lt(a, int_add(l0, 64)) -> a in H.objs.live)

theorem tm.wk_of_mi(I, O, eo, b, cd, st, S0, H, l0, K): tm.mi(I, O, eo, b, cd, st, S0, H, l0, K) -> tm.wk(O, eo, b, cd, st, S0, H, l0)
proof
  assume hmi
  have _ _ hw hfs hk ha _ := hmi
  have g: all a. a in omega -> !(a in O[S0]) -> !(a in malloc.errno_bytes(eo, S0)) -> x86_64_linux.mapped(S0.vm, int_div(a, x86_64_linux.PAGE)) ->
      H.vm.bytes[bits_of_int(64, a)] = S0.vm.bytes[bits_of_int(64, a)] && H.vm.pages[int_div(a, x86_64_linux.PAGE)] = S0.vm.pages[int_div(a, x86_64_linux.PAGE)] proof
    fix a
    assume ao no ne m0
    have _ _ b1 p1 := mp(all_elim(hk, {a}), ao, no, ne, m0)
    show by taut(b1, p1)
  qed
  have l: all a. a in omega -> int_le(l0, a) -> int_lt(a, int_add(l0, 64)) -> a in H.objs.live proof
    fix a
    assume ao h1 h2
    have l1 _ := mp(all_elim(ha, {a}), ao, h1, h2)
    show l1
  qed
  show by taut(hw, hfs, g, l)
qed

// main storing at its array's word i, where wk holds: wk kept
theorem tm.wk_store(O, eo, b, cd, st, S0, H, l0, i, p): tm.wk(O, eo, b, cd, st, S0, H, l0) -> l0 in omega -> int_le(int_add(l0, 64), 18446744073709551616) ->
  i in omega -> int_lt(i, 8) ->
  tm.wk(O, eo, b, cd, st, S0, fn_update(H, "vm", fn_update(H.vm, "bytes", x86_64_linux.store_le(H.vm.bytes, int_add(l0, int_mul(8, i)), 8, p))), l0)
proof
  assume hwk hl0 hl64 hi0 hil
  let A := int_add(l0, int_mul(8, i))
  let X := x86_64_linux.store_le(H.vm.bytes, A, 8, p)
  let T := fn_update(H, "vm", fn_update(H.vm, "bytes", X))
  have hw hfs hk ha := hwk
  have ao: A in omega by arith(hl0, hi0)
  have a8: int_le(int_add(A, 8), 18446744073709551616) by arith(hl64, hil, hi0)
  have out: all x. x in bits(64) -> !(int_le(A, x) && int_lt(x, int_add(A, 8))) -> X[x] = H.vm.bytes[x] proof
    fix x
    assume hx hn
    show := apply(tm.st_at[B := H.vm.bytes, A := A, n := 8, v := p, x := x], hx, ao, simp(), a8, hn)
  qed
  // (the word's bytes: on no mapped page -- not the thread's word, not the code)
  have _ _ th _ _ ld _ _ _ := expand(hw, malloc.world_ok)
  have fsb: H.fs_base in bits(64) by simp(expand(hw, malloc.world_ok, abi.thread_ok))
  have nmA: all x. x in omega -> int_le(A, x) -> int_lt(x, int_add(A, 8)) -> !x86_64_linux.mapped(H.vm, int_div(x, x86_64_linux.PAGE)) proof
    fix x
    assume xo h1 h2
    show := apply(tm.obj_unm[b := b, cd := cd, st := st, H := H, a := x], hw, xo, mp(all_elim(ha, {x}), xo, (int_le(l0, x) by arith(h1, hi0)), (int_lt(x, int_add(l0, 64)) by arith(h2, hil))))
  qed
  have same: all x. x in bits(64) -> x86_64_linux.mapped(H.vm, int_div(x, x86_64_linux.PAGE)) -> X[x] = H.vm.bytes[x] proof
    fix x
    assume hx m
    have nw: !(int_le(A, x) && int_lt(x, int_add(A, 8))) proof
      assume w
      have w1 w2 := w
      show by taut(m, mp(all_elim(nmA, {x}), (x in omega by arith(hx)), w1, w2))
    qed
    show := mp(all_elim(out, {x}), hx, nw)
  qed
  have {fsl = fsl} := apply(mp.top_fsl, fsb, th)
  have r0 _ _ _ := expand(th, abi.thread_ok)
  have lsame: all k. k in omega -> int_lt(k, 8) -> X[bits_add(64, H.fs_base, bits_of_int(64, k))] = H.vm.bytes[bits_add(64, H.fs_base, bits_of_int(64, k))] proof
    fix k
    assume hk2 hkl
    have m0 _ := mp(all_elim(expand(r0, x86_64_linux.readable), {k}), hk2, hkl)
    have ae: bits_add(64, H.fs_base, bits_of_int(64, k)) = int_add(H.fs_base, k) by defs(arith(fsb, hk2, hkl, fsl), bits_add, bits_of_int, pow2)
    show := rewrite(sym(ae), mp(all_elim(same, {int_add(H.fs_base, k)}), (int_add(H.fs_base, k) in bits(64) by arith(fsb, hk2, hkl, fsl)), m0))
  qed
  have hle := mp(all_elim(tr.le_same, {X}, {H.vm.bytes}, {H.fs_base}, {8}), (8 in omega by simp()), lsame)
  have ca _ := expand(ld, abi.loaded)
  have csame: all i2. i2 in omega -> int_lt(i2, seq_len(cd[empty])) -> X[bits_of_int(64, int_add(b[empty], i2))] = H.vm.bytes[bits_of_int(64, int_add(b[empty], i2))] proof
    fix i2
    assume hi2 hil2
    have q1 _ _ _ := mp(all_elim(expand(ca, abi.code_at), {i2}), hi2, hil2)
    have mx: x86_64_linux.mapped(H.vm, int_div(bits_of_int(64, int_add(b[empty], i2)), x86_64_linux.PAGE)) by taut(expand(q1, x86_64_linux.fetchable, x86_64_linux.page_of))
    show := mp(all_elim(same, {bits_of_int(64, int_add(b[empty], i2))}), (bits_of_int(64, int_add(b[empty], i2)) in bits(64) by defs(simp(), bits_of_int, pow2)), mx)
  qed
  have wT := apply(tm.wok_bytes[b := b, cd := cd, st := st, H := H, X := X], hw, hle, csame)
  have kT: all a. a in omega -> !(a in O[S0]) -> !(a in malloc.errno_bytes(eo, S0)) -> x86_64_linux.mapped(S0.vm, int_div(a, x86_64_linux.PAGE)) ->
      T.vm.bytes[bits_of_int(64, a)] = S0.vm.bytes[bits_of_int(64, a)] && T.vm.pages[int_div(a, x86_64_linux.PAGE)] = S0.vm.pages[int_div(a, x86_64_linux.PAGE)] proof
    fix a
    assume ao2 no ne m0
    have b1 p1 := mp(all_elim(hk, {a}), ao2, no, ne, m0)
    have mh := apply(tm.mapped_eq[V := H.vm, V0 := S0.vm, q := int_div(a, x86_64_linux.PAGE)], p1, m0)
    have ml _ := expand(mh, x86_64_linux.mapped)
    have be: bits_of_int(64, a) = a by defs(arith(ao2, ml), bits_of_int, pow2, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
    have s := rewrite(sym(be), mp(all_elim(same, {a}), (a in bits(64) by defs(arith(ao2, ml), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)), mh))
    show by simp(s, b1, p1)
  qed
  have lT: all a. a in omega -> int_le(l0, a) -> int_lt(a, int_add(l0, 64)) -> a in T.objs.live proof
    fix a
    assume ao2 h1 h2
    show by simp(mp(all_elim(ha, {a}), ao2, h1, h2))
  qed
  show by taut(wT, (T.fs_base = S0.fs_base by simp(hfs)), kT, lT)
qed

// main's exit: the objects as at S0 again -- the world as any call needs
// it, the memory outside the allocator's at S0 kept
theorem tm.wk_final(O, eo, b, cd, st, S0, H, l0): tm.wk(O, eo, b, cd, st, S0, H, l0) -> (all a. a in omega -> a in S0.objs.live -> a in H.objs.live) ->
  malloc.world_ok(b, cd, st, fn_update(H, "objs", fn_update(H.objs, "live", S0.objs.live))) &&
  test_malloc.main_frame(O, eo, S0, fn_update(H, "objs", fn_update(H.objs, "live", S0.objs.live)))
proof
  assume hwk hsub
  have hw _ hk _ := hwk
  have _ _ _ _ _ _ lv _ _ := expand(hw, malloc.world_ok)
  have sp: all a. a in omega -> a in S0.objs.live -> int_le(x86_64_linux.stack_floor(H.vm), a) && int_lt(a, H.vm.stack_top) proof
    fix a
    assume ao w
    have r1 r2 _ := mp(all_elim(lv, {a}), ao, mp(all_elim(hsub, {a}), ao, w))
    show by taut(r1, r2)
  qed
  have w2 := apply(tm.wok_live[b := b, cd := cd, st := st, H := H, L := S0.objs.live], hw, sp)
  have mf: test_malloc.main_frame(O, eo, S0, fn_update(H, "objs", fn_update(H.objs, "live", S0.objs.live))) proof
    have g: all a. a in omega -> (!(a in O[S0]) && !(a in malloc.errno_bytes(eo, S0))) && x86_64_linux.mapped(S0.vm, int_div(a, x86_64_linux.PAGE)) ->
        fn_update(H, "objs", fn_update(H.objs, "live", S0.objs.live)).vm.bytes[bits_of_int(64, a)] = S0.vm.bytes[bits_of_int(64, a)] &&
        fn_update(H, "objs", fn_update(H.objs, "live", S0.objs.live)).vm.pages[int_div(a, x86_64_linux.PAGE)] = S0.vm.pages[int_div(a, x86_64_linux.PAGE)] proof
      fix a
      assume ao h
      have no ne m0 := h
      have bh ph := mp(all_elim(hk, {a}), ao, no, ne, m0)
      show by simp(bh, ph)
    qed
    show by defs(g, test_malloc.main_frame)
  qed
  show by taut(w2, mf)
qed

// malloc's 0 at S (an allocator step to U, then errno written: t): wk at t
theorem tm.wk_zero(I, O, eo, b, cd, st, S0, S, t, V, l0, K): app(eo, empty) = 52 -> S in rec_and(abi.World, malloc.Heap.ghost) ->
  tm.mi(I, O, eo, b, cd, st, S0, S, l0, K) -> V in x86_64_linux.Vm -> t.vm in x86_64_linux.Vm ->
  malloc.step_ok(I, O, S, fn_update(S, "vm", V), malloc.errno_bytes(eo, S)) -> malloc.world_ok(b, cd, st, fn_update(S, "vm", V)) ->
  malloc.errno_ok(eo, fn_update(S, "vm", V)) -> t = fn_update(S, "vm", t.vm) -> fn_update(t.vm, "bytes", V.bytes) = V ->
  (all a. a in bits(64) -> (all j. j in omega -> int_lt(j, 4) -> !(a = bits_add(64, bits_add(64, S.fs_base, bits_of_int(64, eo[empty])), bits_of_int(64, j)))) ->
     t.vm.bytes[a] = V.bytes[a]) ->
  tm.wk(O, eo, b, cd, st, S0, t, l0)
proof
  assume he ht hmi hv htv hst hwU heU hte htb hout
  let U := fn_update(S, "vm", V)
  let X := t.vm.bytes
  have _ _ _ hfs hk ha _ := hmi
  // (U: the step's; its memory kept outside the allocator's but errno)
  have xe: all a. a in malloc.errno_bytes(eo, S) -> a in malloc.errno_bytes(eo, S) || a in malloc.live_of(S.blocks) proof
    fix a
    assume w
    show by taut(w)
  qed
  have lU: all a. a in malloc.live_of(U.blocks) -> (a in malloc.live_of(S.blocks) || a in O[S]) || !x86_64_linux.mapped(S.vm, int_div(a, x86_64_linux.PAGE)) proof
    fix a
    assume w
    show by taut((a in malloc.live_of(S.blocks) by simp(w)))
  qed
  have kU := apply(tm.kept_step[I := I, O := O, eo := eo, S0 := S0, H := S, T := U, X := malloc.errno_bytes(eo, S)], hk, hst, hfs, xe, lU)
  // (t: U with the bytes X)
  have tf td := (is_fun(t.vm) && "bytes" in dom(t.vm) by simp(expand(htv, x86_64_linux.Vm)))
  have q1 := fn_update_twice[f := t.vm, k := "bytes", a := V.bytes, b := X]
  have q2 := mp(fn_update_same[f := t.vm, k := "bytes"], tf, td)
  have tvq: fn_update(V, "bytes", X) = t.vm := trans(rewrite(htb, q1), q2)
  have teq: fn_update(U, "vm", fn_update(U.vm, "bytes", X)) = t := trans((fn_update(U, "vm", fn_update(U.vm, "bytes", X)) = fn_update(S, "vm", fn_update(V, "bytes", X)) by simp()),
    trans(rewrite(tvq, refl({fn_update(S, "vm", fn_update(V, "bytes", X))}), {2}), sym(hte)))
  have fsU: U.fs_base = S.fs_base by simp()
  have _ _ thU _ _ ldU _ _ _ := expand(hwU, malloc.world_ok)
  have fsb: U.fs_base in bits(64) by simp(expand(hwU, malloc.world_ok, abi.thread_ok))
  have {fsl = fsl} := apply(mp.top_fsl, fsb, thU)
  // (errno's bytes: fs + 52 + j)
  have eaddr: all j. j in omega -> int_lt(j, 4) -> bits_add(64, bits_add(64, S.fs_base, bits_of_int(64, eo[empty])), bits_of_int(64, j)) = int_add(int_add(U.fs_base, 52), j) proof
    fix j
    assume hj hjl
    show by defs(arith(rewrite(fsU, fsb), rewrite(fsU, fsl), hj, hjl, he, fsU), bits_add, bits_of_int, pow2)
  qed
  have xsame: all x. x in bits(64) -> (all j. j in omega -> int_lt(j, 4) -> !(x = int_add(int_add(U.fs_base, 52), j))) -> X[x] = U.vm.bytes[x] proof
    fix x
    assume hx hn
    have hn2: all j. j in omega -> int_lt(j, 4) -> !(x = bits_add(64, bits_add(64, S.fs_base, bits_of_int(64, eo[empty])), bits_of_int(64, j))) proof
      fix j
      assume hj hjl
      show := rewrite(sym(mp(all_elim(eaddr, {j}), hj, hjl)), mp(all_elim(hn, {j}), hj, hjl))
    qed
    show by simp(mp(all_elim(hout, {x}), hx, hn2))
  qed
  // the world: the thread's word and the code no errno byte
  have r0 _ _ _ := expand(thU, abi.thread_ok)
  have lsame: all k. k in omega -> int_lt(k, 8) -> X[bits_add(64, U.fs_base, bits_of_int(64, k))] = U.vm.bytes[bits_add(64, U.fs_base, bits_of_int(64, k))] proof
    fix k
    assume hk2 hkl
    have ae: bits_add(64, U.fs_base, bits_of_int(64, k)) = int_add(U.fs_base, k) by defs(arith(fsb, hk2, hkl, fsl), bits_add, bits_of_int, pow2)
    have nj: all j. j in omega -> int_lt(j, 4) -> !(int_add(U.fs_base, k) = int_add(int_add(U.fs_base, 52), j)) proof
      fix j
      assume hj hjl
      show by arith(hkl, hj)
    qed
    show := rewrite(sym(ae), mp(all_elim(xsame, {int_add(U.fs_base, k)}), (int_add(U.fs_base, k) in bits(64) by arith(fsb, hk2, hkl, fsl)), nj))
  qed
  have hle := mp(all_elim(tr.le_same, {X}, {U.vm.bytes}, {U.fs_base}, {8}), (8 in omega by simp()), lsame)
  have ca _ := expand(ldU, abi.loaded)
  have csame: all i2. i2 in omega -> int_lt(i2, seq_len(cd[empty])) -> X[bits_of_int(64, int_add(b[empty], i2))] = U.vm.bytes[bits_of_int(64, int_add(b[empty], i2))] proof
    fix i2
    assume hi2 hil2
    let x := bits_of_int(64, int_add(b[empty], i2))
    have _ q2 _ _ := mp(all_elim(expand(ca, abi.code_at), {i2}), hi2, hil2)
    have nj: all j. j in omega -> int_lt(j, 4) -> !(x = int_add(int_add(U.fs_base, 52), j)) proof
      fix j
      assume hj hjl
      assume e
      have eb := apply(mp.top_ebyte[eo := eo, S := U, i := j], fsb, fsl, he, hj, hjl)
      have rw := mp(all_elim(expand(heU, malloc.errno_ok), {int_add(int_add(U.fs_base, 52), j)}), (int_add(int_add(U.fs_base, 52), j) in omega by arith(fsb, hj)), eb)
      show by taut(q2, rewrite(sym(e), (x86_64_linux.can_access(U.vm, int_add(int_add(U.fs_base, 52), j), 1) by defs(simp(expand(rw, malloc.rw_mapped)),
        x86_64_linux.can_access, x86_64_linux.hw_allows, x86_64_linux.page_of))))
    qed
    show := mp(all_elim(xsame, {x}), (x in bits(64) by defs(simp(), bits_of_int, pow2)), nj)
  qed
  have wT := rewrite(teq, apply(tm.wok_bytes[b := b, cd := cd, st := st, H := U, X := X], hwU, hle, csame))
  // the memory outside the allocator's at S0 (but errno's): U's
  have kT: all a. a in omega -> !(a in O[S0]) -> !(a in malloc.errno_bytes(eo, S0)) -> x86_64_linux.mapped(S0.vm, int_div(a, x86_64_linux.PAGE)) ->
      t.vm.bytes[bits_of_int(64, a)] = S0.vm.bytes[bits_of_int(64, a)] && t.vm.pages[int_div(a, x86_64_linux.PAGE)] = S0.vm.pages[int_div(a, x86_64_linux.PAGE)] proof
    fix a
    assume ao no ne m0
    have _ _ b1 p1 := mp(all_elim(kU, {a}), ao, no, ne, m0)
    have ml _ := expand(m0, x86_64_linux.mapped)
    have be: bits_of_int(64, a) = a by defs(arith(ao, ml), bits_of_int, pow2, x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)
    have nj: all j. j in omega -> int_lt(j, 4) -> !(a = int_add(int_add(U.fs_base, 52), j)) proof
      fix j
      assume hj hjl
      assume e
      have f0: S0.fs_base = U.fs_base by simp(hfs)
      have eb := apply(mp.top_ebyte[eo := eo, S := S0, i := j], rewrite(sym(f0), fsb), rewrite(sym(f0), fsl), he, hj, hjl)
      show by taut(ne, rewrite(sym(e), rewrite(f0, eb)))
    qed
    have s := rewrite(sym(be), mp(all_elim(xsame, {a}), (a in bits(64) by defs(arith(ao, ml), x86_64_linux.TASK_SIZE, x86_64_linux.PAGE)), nj))
    have tvb: t.vm.bytes = X by simp()
    have tvp: t.vm.pages = V.pages := rewrite(tvq, (fn_update(V, "bytes", X).pages = V.pages by simp()))
    show by simp(s, b1, p1, tvp, (U.vm = V by simp()))
  qed
  have lT: all a. a in omega -> int_le(l0, a) -> int_lt(a, int_add(l0, 64)) -> a in t.objs.live proof
    fix a
    assume ao h1 h2
    have l1 _ := mp(all_elim(ha, {a}), ao, h1, h2)
    show by simp(rewrite(sym(hte), (fn_update(S, "vm", t.vm).objs = S.objs by simp())), l1)
  qed
  have tfs: t.fs_base = S0.fs_base := rewrite(sym(hte), (fn_update(S, "vm", t.vm).fs_base = S0.fs_base by simp(hfs)))
  show by taut(wT, tfs, kT, lT)
qed
