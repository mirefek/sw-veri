// The witness: an unprivileged exec state of the binary whose run reaches
// main -- the program's runs from exec, and the malloc claim's runs to
// main, are not none.

// ----------------------------------------------------------------------
//  Typing the witness (rules for `types`)

theorem wit.true_bool: true in bool
proof
  show by defs(upair_r[a := false, b := true], bool)
qed
type_rule wit.true_bool

theorem wit.false_bool: false in bool
proof
  show by defs(upair_l[a := false, b := true], bool)
qed
type_rule wit.false_bool

// the pages' values: records of Page
theorem wit.pages_lit: fn_update(fn_update(empty, "prot", fn_update(fn_update(fn_update(empty, "r", true), "w", true), "x", false)), "kind", 2) in x86_64_linux.Page &&
  fn_update(fn_update(empty, "prot", fn_update(fn_update(fn_update(empty, "r", true), "w", true), "x", false)), "kind", 0) in x86_64_linux.Page &&
  fn_update(fn_update(empty, "prot", fn_update(fn_update(fn_update(empty, "r", true), "w", false), "x", false)), "kind", 0) in x86_64_linux.Page &&
  fn_update(fn_update(empty, "prot", fn_update(fn_update(fn_update(empty, "r", true), "w", false), "x", true)), "kind", 0) in x86_64_linux.Page
proof
  have a: fn_update(fn_update(empty, "prot", fn_update(fn_update(fn_update(empty, "r", true), "w", true), "x", false)), "kind", 2) in x86_64_linux.Page by types()
  have b: fn_update(fn_update(empty, "prot", fn_update(fn_update(fn_update(empty, "r", true), "w", true), "x", false)), "kind", 0) in x86_64_linux.Page by types()
  have c: fn_update(fn_update(empty, "prot", fn_update(fn_update(fn_update(empty, "r", true), "w", false), "x", false)), "kind", 0) in x86_64_linux.Page by types()
  have d: fn_update(fn_update(empty, "prot", fn_update(fn_update(fn_update(empty, "r", true), "w", false), "x", true)), "kind", 0) in x86_64_linux.Page by types()
  show by taut(a, b, c, d)
qed

// a function's value at any key: in its codomain (outside its domain:
// empty, there too)
theorem wit.app_fs: all f a b k. f in fn_space(a, b) -> empty in b -> f[k] in b
proof
  fix f a b k
  assume hf he
  have pw _ := unsel(expand(hf, fn_space))
  cases from (k in a || !(k in a) by taut())
  case h := apply(fn_space_app, hf, h)
  case h := rewrite(sym(apply(ui.app_out, pw, h)), he)
qed


theorem wit.some_opt: all x t. x in t -> some(x) in option(t)
proof
  fix x t
  assume h
  have ex: ex y. y in t && some(y) = some(x) by ex_intro({x}, taut(h, refl({some(x)})))
  have i: some(x) in set_image(t, y. some(y)) by taut(set_image_def[s := t, f := y. some(y), y := some(x)], ex)
  show by defs(taut(union2_iff[a := single(none), b := set_image(t, y. some(y)), z := some(x)], i), option)
qed
type_rule wit.some_opt

theorem wit.none_opt: all t. none in option(t)
proof
  fix t
  have i := single_intro[a := none]
  show by defs(taut(union2_iff[a := single(none), b := set_image(t, y. some(y)), z := none], i), option)
qed
type_rule wit.none_opt

theorem wit.ite_in: all c a b t. a in t -> b in t -> ite(c, a, b) in t
proof
  fix c a b t
  assume ha hb
  show := apply(ite_in[c := c], ha, hb)
qed
type_rule wit.ite_in

// a bytes literal's sequence: a function on its length to bytes
theorem wit.seq_fs: all c b. c = bytes_seq(b) -> (all i. i in bytes_len(b) -> bytes_at(b, i) in bits(8)) -> c in fn_space(bytes_len(b), bits(8))
proof
  fix c b
  assume e h
  show := rewrite(sym(e), (bytes_seq(b) in fn_space(bytes_len(b), bits(8)) by defs(apply(fn_build_space[d := bytes_len(b), v := i. bytes_at(b, i), b := bits(8)], h), bytes_seq)))
qed

// the pages in the first universe (replacement: each pair a member; their
// set, Option[Page], is not)
theorem wit.pages_univ: wit.pages in univ(1)
proof
  let D := set_select(omega, q. int_lt(q, 34359738367))
  have u1: wit.PG(true, true, false, 2) in univ(1) by types()
  have u2: wit.PG(true, true, false, 0) in univ(1) by types()
  have u3: wit.PG(true, false, false, 0) in univ(1) by types()
  have u4: wit.PG(true, false, true, 0) in univ(1) by types()
  have u0: none in univ(1) by types()
  have each: all x. x in D -> pair(x, wit.pg_at(x)) in univ(1) proof
    fix x
    assume hx
    have xo _ := unsel(hx)
    have i5 := apply(wit.ite_in[c := x = 1024], u3, u0)
    have i4 := apply(wit.ite_in[c := int_le(1025, x) && int_le(x, 1029)], u4, i5)
    have i3 := apply(wit.ite_in[c := x = 1030], u3, i4)
    have i2 := apply(wit.ite_in[c := int_le(1031, x) && int_le(x, 1032)], u2, i3)
    have i1 := apply(wit.ite_in[c := int_le(34359738335, x) && int_lt(x, 34359738367)], u1, i2)
    have v: wit.pg_at(x) in univ(1) by defs(i1, wit.pg_at)
    have xu: x in univ(1) by types(xo)
    show := apply(pair_univ, xu, v)
  qed
  have du: D in univ(1) by types()
  show by defs(apply(univ_image[u := 1, s := D, f := x. pair(x, wit.pg_at(x))], du, each), wit.pages, fn_build)
qed

// the file's and the initial stack's bytes, at any index
theorem wit.file_byte: all k. musl_malloc.file[k] in bits(8)
proof
  fix k
  have gf := mp(apply(wit.seq_fs, unfold(musl_malloc.file)), eval())
  show := apply(wit.app_fs[k := k], gf, (empty in bits(8) by eval()))
qed
type_rule wit.file_byte

theorem wit.stack_byte: all k. wit.stack[k] in bits(8)
proof
  fix k
  have gs := mp(apply(wit.seq_fs, unfold(wit.stack)), eval())
  show := apply(wit.app_fs[k := k], gs, (empty in bits(8) by eval()))
qed
type_rule wit.stack_byte

theorem wit.m0_typed: wit.m0 in x86_64_linux.Machine
proof
  have e8: empty in bits(8) by eval()
  have gr: fn_build(x86_64_linux.Reg, r. ite(r = 4, 140737488350944, 0)) in fn_space(x86_64_linux.Reg, bits(64)) :=
    apply(fn_build_space[d := x86_64_linux.Reg, v := r. ite(r = 4, 140737488350944, 0), b := bits(64)], eval())
  have gx: fn_build(x86_64_linux.Reg, r. 0) in fn_space(x86_64_linux.Reg, bits(128)) := apply(fn_build_space[d := x86_64_linux.Reg, v := r. 0, b := bits(128)], eval())
  // (the pages: each the stack's, an image's or none)
  let OP := option(x86_64_linux.Page)
  have l1 l2 l3 l4 := wit.pages_lit
  have q1: wit.PG(true, true, false, 2) in OP := apply(wit.some_opt, l1)
  have q2: wit.PG(true, true, false, 0) in OP := apply(wit.some_opt, l2)
  have q3: wit.PG(true, false, false, 0) in OP := apply(wit.some_opt, l3)
  have q4: wit.PG(true, false, true, 0) in OP := apply(wit.some_opt, l4)
  have q0: none in OP := wit.none_opt[t := x86_64_linux.Page]
  have pe: all p. p in set_select(omega, q. int_lt(q, 34359738367)) -> wit.pg_at(p) in OP proof
    fix p
    assume _
    have i5 := apply(wit.ite_in[c := p = 1024], q3, q0)
    have i4 := apply(wit.ite_in[c := int_le(1025, p) && int_le(p, 1029)], q4, i5)
    have i3 := apply(wit.ite_in[c := p = 1030], q3, i4)
    have i2 := apply(wit.ite_in[c := int_le(1031, p) && int_le(p, 1032)], q2, i3)
    have i1 := apply(wit.ite_in[c := int_le(34359738335, p) && int_lt(p, 34359738367)], q1, i2)
    show by defs(i1, wit.pg_at)
  qed
  have dq: int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE) = 34359738367 by eval()
  have gp: wit.pages in fn_space(set_select(omega, q. int_lt(q, int_div(x86_64_linux.TASK_SIZE, x86_64_linux.PAGE))), option(x86_64_linux.Page)) by defs(simp(apply(fn_build_space[d := set_select(omega, q. int_lt(q, 34359738367)), v := p. wit.pg_at(p), b := option(x86_64_linux.Page)], pe), dq), wit.pages)
  // (the bytes: the stack's, the file's, or 0)
  have be: all a. a in bits(64) -> wit.byte_at(a) in bits(8) proof
    fix a
    assume _
    show by defs(types(e8), wit.byte_at)
  qed
  have gb: wit.bytes in fn_space(bits(64), bits(8)) by defs(apply(fn_build_space[d := bits(64), v := a. wit.byte_at(a), b := bits(8)], be), wit.bytes)
  have ni: empty in seq_type(bits(8)) && empty in seq_type(x86_64_linux.IoEvent) by taut(unsel(expand(mp.nil_list[t := bits(8)], list_type)),
    unsel(expand(mp.nil_list[t := x86_64_linux.IoEvent], list_type)))
  show by defs(types(gr, gx, gp, gb, ni, wit.pages_univ), wit.m0, wit.vm, wit.os, wit.flags)
qed

theorem wit.unpriv: claim_malloc.unprivileged(wit.m0.os)
proof
  show by eval()
qed

theorem wit.args_typed: wit.argv in list_type(list_type(bits(8))) && empty in list_type(list_type(bits(8)))
proof
  let S := bytes_seq(bytes"746573745f6d616c6c6f63")
  have sl: S in list_type(bits(8)) := mp(apply(ui.bytes_list[c := S], refl({S})), eval(), eval())
  have each: all x. x in 1 -> S in list_type(bits(8)) proof
    fix x
    assume _
    show := sl
  qed
  have a: wit.argv in list_type(list_type(bits(8))) by defs(apply(build_list[d := 1, v := i. S, t := list_type(bits(8))], eval(), each), wit.argv)
  show by taut(a, mp.nil_list[t := list_type(bits(8))])
qed

// ----------------------------------------------------------------------
//  The witness

// Some exec state's run reaches main (the final machine's typing is not
// shown here: no lemma yet that a step keeps a machine typed)
theorem wit.reach: ex argv envp m0 m. ((argv in list_type(list_type(bits(8))) && envp in list_type(list_type(bits(8)))) && m0 in x86_64_linux.Machine) &&
  ((x86_64_linux.exec_state(musl_malloc.file, argv, envp, m0) && claim_malloc.unprivileged(m0.os)) && runs(claim_malloc.run_until(musl_malloc.main_at), m0, ok(m, empty)))
proof
  obtain m, hr from wit.run
  show by ex_intro({wit.argv}, {empty}, {wit.m0}, {m}, taut(wit.args_typed, wit.m0_typed, wit.exec, wit.unpriv, hr))
qed
