        let PI4(x) := ex i. (i in omega && int_le(i, 8)) && x = pair(W(V3), pair(i, R))
        let M4(x) := int_sub(8, fst(snd(x)))
        have p40: PI4(pair(W(V3), pair(0, R))) by ex_intro({0}, taut((0 in omega by simp()), (int_le(0, 8) by simp()), refl({pair(W(V3), pair(0, R))})))
        have pm4: all x. PI4(x) -> M4(x) in omega proof
