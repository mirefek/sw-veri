          let K5(n) := set_select(omega, k. int_lt(k, 8) && int_le(n, k))
          obtain r5, wl5 kr5 from h5
          let BODY5(x, y) := loop_body(wl5)
          let G5(i, V, y) := (int_lt(i, 8) && (ex V2 g2. ((V2 in x86_64_linux.Vm && g2 in malloc.Heap.ghost) && tm.mi(I, O, eo, b, cd, st, S0, H(V2, g2), l[0], K5(int_add(i, 1)))) &&
              y = ok(pair(W(V2), pair(int_add(i, 1), R)), empty))) ||
            (i = 8 && y = exc(pair(W(V), pair(i, R)), pair("brk", empty))) ||
            (ex Vx v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && y = exc(pair(fn_update(fn_update(W(Vx), "vm", v), "objs", ob), pair(i, R)), pair("raise", OVF)))
        have trip5: all i V g y. i in omega -> int_le(i, 8) -> V in x86_64_linux.Vm -> g in malloc.Heap.ghost ->
            tm.mi(I, O, eo, b, cd, st, S0, H(V, g), l[0], K5(i)) -> BODY5(pair(W(V), pair(i, R)), y) -> G5(i, V, y) proof
          fix i V g y
          assume hi0 hil hv hg hmi hbd
          have wW wu := apply(g.alloc_world[s := w, V := V, l := l, sz := SZ], hw, hu, hv)
          have Ht := apply(rec_and_intro, wW, hg)
          have hiH heH hwH _ _ _ hbk := hmi
          have {fv = vm, ff = fs} := apply(tm.u2f[w := w, h := g, V := V, O := O1], hw, hg)
          have _ _ th _ _ _ _ _ _ := expand(hwH, malloc.world_ok)
          have thW: abi.thread_ok(W(V).vm, W(V).fs_base) by simp(rewrite(ff, rewrite(fv, th)))
          have ths: gc.sound(W(V)) by simp(thW)
          have si: sint(32, i) = i := mp(all_elim(ms.sint_small, {i}), hi0, arith(hil))
          have s7v: sint(32, 7) = 7 := mp(all_elim(ms.sint_small, {7}), simp(), arith())
          have c8: i = 8 -> G5(i, V, y) proof
            assume e
            have cf: int_lt(sint(32, 7), sint(32, i)) by simp(si, s7v, e)
            step eA from hbd with cf
            show by taut(e, eA)
          qed
          have clt: int_lt(i, 8) -> G5(i, V, y) proof
            assume hil8
            have ib: i in bits(32) by arith(hi0, hil8)
            have s7: !int_lt(sint(32, 7), sint(32, i)) by simp(si, s7v, (int_le(i, 7) by arith(hil8)))
            have sxi := apply(ms.sext_small, ib, (int_lt(i, 2147483648) by arith(hil8)))
            let A := int_add(l[0], int_mul(8, i))
            have ab: A in bits(64) by arith(l64, hil8, hi0, l0o)
            have z0: int_add(A, 0) = A by arith()
            have el := apply(g.elem8_det, {W(V)}, {l[0]}, {i}, wu, l0b, hi0, (int_lt(i, 2147483648) by arith(hil8)), (int_lt(A, 18446744073709551616) by arith(l64, hil8, hi0)))
            have els: g.det(gimple.elem(l[0], bits_sext(32, 64, i), 8), W(V), ok(W(V), A)) := rewrite(sym(sxi), el, {1})
            have md := apply(tm.cell_md[b := b, cd := cd, st := st, W := W(V), h := g, l0 := l[0], i := i, wr := false], wW, hg, hwH, l0o, l0z, l64, hi0, hil8, all_elim(arrW, {V}))
            have ld := rewrite(z0, mp(all_elim(g.ld64_det, {W(V)}, {A}, {0}), wu, ab, simp(), md))
            // the block of word i: block i's
            let Q := tm.cell(H(V, g).vm, l[0], i)
            have iK: i in K5(i) by sel(taut(hi0, hil8, (int_le(i, i) by arith())))
            have qb q0 qn qz qp := mp(all_elim(hbk, {i}), hi0, hil8, iK)
            have qv: gimple.bytes_at(W(V).vm, A, 8) = Q by simp(fv)
            have bq: bits_of_int(64, Q) = Q by defs(arith(qb), bits_of_int, pow2)
            have cq: bits_of_int(64, gimple.bytes_at(W(V).vm, A, 8)) = Q := rewrite(sym(qv), bq)
            have hpre: !(Q = 0) -> (union2(W(V), g) in I && malloc.errno_ok(eo, union2(W(V), g))) && !(union2(W(V), g).blocks[Q] = none) proof
              assume _
              show by taut(hiH, heH, qn)
            qed
            step c1 c2 V2 r2b, e2 hv2 hex from hbd with s7, els, ld, cq, tm.free_q using hfs, hfc, wW, wu, ths, hg, hwH, hpre, qb
            obtain g2, hg2 hrunf from hex
            have ww2 := tm.wvv[w := w, V := V, V2 := V2, O := O1]
            have hrunf2 := rewrite(ww2, hrunf)
            have e2b := rewrite(ww2, e2)
            have fo := apply(malloc.free_out[i := I, o := O, e := eo, b := b, c := cd, st := st, p := Q, s := H(V, g), x := ok(H(V2, g2), empty)], hfs, hrunf2, Ht, qb, hwH, hpre)
            have fo2: ex Vp. Vp in x86_64_linux.Vm && ok(H(V2, g2), empty) = ok(fn_update(fn_update(H(V, g), "blocks", malloc.set_block(H(V, g).blocks, Q, none)), "vm", Vp), empty) &&
                malloc.step_ok(I, O, H(V, g), fn_update(fn_update(H(V, g), "blocks", malloc.set_block(H(V, g).blocks, Q, none)), "vm", Vp), malloc.range(Q, snd(H(V, g).blocks[Q]))) &&
                malloc.world_ok(b, cd, st, fn_update(fn_update(H(V, g), "blocks", malloc.set_block(H(V, g).blocks, Q, none)), "vm", Vp)) &&
                malloc.errno_ok(eo, fn_update(fn_update(H(V, g), "blocks", malloc.set_block(H(V, g).blocks, Q, none)), "vm", Vp)) by taut(fo, q0)
            obtain Vp, hvp hxe hst hwT heT from fo2
            have hTe: H(V2, g2) = fn_update(fn_update(H(V, g), "blocks", malloc.set_block(H(V, g).blocks, Q, none)), "vm", Vp) by simp(hxe)
            have ksub2: all k. k in omega -> k in K5(int_add(i, 1)) -> k in K5(i) && !(k = i) proof
              fix k
              assume hk2 hkK
              have _ c1k c2k := unsel(hkK)
              have m: k in K5(i) by sel(taut(hk2, c1k, (int_le(i, k) by arith(c2k))))
              show by taut(m, (!(k = i) by arith(c2k)))
            qed
            have hvH: H(V, g).vm in x86_64_linux.Vm := rewrite(sym(fv), hv)
            have mf := apply(tm.mi_free[I := I, O := O, eo := eo, b := b, cd := cd, st := st, S0 := S0, H := H(V, g), l0 := l[0], K := K5(i), K2 := K5(int_add(i, 1)), j := i, V := Vp],
              hl, he, Ht, hvH, hvp, l0o, l64, hmi, hi0, hil8, iK, ksub2, hst, hwT, heT)
            have mi2: tm.mi(I, O, eo, b, cd, st, S0, H(V2, g2), l[0], K5(int_add(i, 1))) by taut(rewrite(sym(hTe), mf))
            have w2W w2u := apply(g.alloc_world[s := w, V := V2, l := l, sz := SZ], hw, hu, hv2)
            have s2v: sint(32, 1) = 1 := mp(all_elim(ms.sint_small, {1}), simp(), arith())
            have fj: tr.s32_fits(int_add(sint(32, i), sint(32, 1))) by defs(simp(si, s2v, (int_lt(int_add(i, 1), 2147483648) by arith(hil8)), (int_le(0, i) by arith(hi0))), gimple.fits)
            have ad := apply(g.sadd32_det, {W(V2)}, {i}, {1}, w2u, ib, simp(), fj)
            step e3 from e2b with ad
            have j2: bits_add(32, i, 1) = int_add(i, 1) by defs(arith(hil8, hi0), bits_add, pow2)
            have ex4: ex Vn gn. ((Vn in x86_64_linux.Vm && gn in malloc.Heap.ghost) && tm.mi(I, O, eo, b, cd, st, S0, H(Vn, gn), l[0], K5(int_add(i, 1)))) &&
                y = ok(pair(W(Vn), pair(int_add(i, 1), R)), empty) by ex_intro({V2}, {g2}, taut(hv2, hg2, mi2, rewrite(j2, e3)))
            show by taut(hil8, ex4)
          qed
          show by taut(c8, clt, (i = 8 || int_lt(i, 8) by arith(hil)))
        qed
          goal 2
          show by taut()
        qed
        show by taut(t4, cok4, cvf4, cbrk4)
      qed
      show by taut(t3, cok3, cret3, cvf3, cbrk3)
    qed
    show by taut(t2, cok2, cvf2, cbrk2)
  qed
  have cok1: (int_lt(i1, 8) && (ex V2 g2. ((V2 in x86_64_linux.Vm && g2 in malloc.Heap.ghost) && tm.mi(I, O, eo, b, cd, st, S0, H(V2, g2), l[0], K1(int_add(i1, 1)))) &&
      r1 = ok(pair(W(V2), pair(int_add(i1, 1), R)), empty))) -> GM proof
    assume e
    have _ ex2 := e
    obtain V2 g2, _ _ _ he2 from ex2
    show by taut(nk1, (is_ok(r1) by defs(ex_intro({pair(W(V2), pair(int_add(i1, 1), R))}, {empty}, he2), is_ok)))
  qed
  show by taut(t1, cok1, cret, cvf1, cbrk1)
qed
