// main's run (tests/test_malloc.c) by the malloc layer: its callees at a
// call, its loops' invariants

// ----------------------------------------------------------------------
//  fill, intact at a call

// (the registers of a call with a 64-bit word a and a 32-bit one b)
theorem tp.regs_64_32: all regs a b. a in bits(64) -> b in bits(32) ->
  gc.regs_ok(regs, seq_concat(seq_one(gimple.arg(64, a)), seq_one(gimple.arg(32, b)))) ->
  regs in list_type(bits(64)) && seq_len(regs) = 2 && regs[0] = a && bits_of_int(32, regs[1]) = b
proof
  fix regs a b
  assume ha hb h
  let ARGS := seq_concat(seq_one(gimple.arg(64, a)), seq_one(gimple.arg(32, b)))
  have r1 r2 r3 := h
  have l2: seq_len(ARGS) = 2 by simp()
  have z0 := mp(all_elim(r3, {0}), simp(), (int_lt(0, seq_len(ARGS)) by simp(l2)))
  have z1 := mp(all_elim(r3, {1}), simp(), (int_lt(1, seq_len(ARGS)) by simp(l2)))
  have q0 := at({ARGS[0]})
  have q1 := at({ARGS[1]})
  have e0: regs[0] = a by simp(expand(rewrite(q0, z0), gimple.in_reg, gimple.arg), ha)
  have e1: bits_of_int(32, regs[1]) = b by defs(simp(expand(rewrite(q1, z1), gimple.in_reg, gimple.arg), hb), bits_of_int, pow2)
  show by taut(r1, trans(r2, l2), e0, e1)
qed

// (block i's pattern written at b: a memory)
theorem tp.fill_ex(V0, b, i): V0 in x86_64_linux.Vm -> b in bits(64) -> i in omega -> int_lt(int_add(b, test_malloc.size_of(i)), 18446744073709551616) ->
  ex V. V in x86_64_linux.Vm && (((V in x86_64_linux.Vm && fn_update(V, "bytes", V0.bytes) = V0) && test_malloc.has_pat(V, b, i)) &&
    (all x. x in bits(64) -> !(int_le(b, x) && int_lt(x, int_add(b, test_malloc.size_of(i)))) -> V.bytes[x] = V0.bytes[x]))
proof
  assume hv hb hi hl
  let SZ := test_malloc.size_of(i)
  let C(x) := int_le(b, x) && int_lt(x, int_add(b, SZ))
  let Z := fn_build(bits(64), x. ite(C(x), test_malloc.pat_of(i, int_sub(x, b)), V0.bytes[x]))
  have vt: V0.bytes in fn_space(bits(64), bits(8)) by simp(expand(hv, x86_64_linux.Vm))
  have vq: all x. x in bits(64) -> ite(C(x), test_malloc.pat_of(i, int_sub(x, b)), V0.bytes[x]) in bits(8) proof
    fix x
    assume hx
    have c1: C(x) -> ite(C(x), test_malloc.pat_of(i, int_sub(x, b)), V0.bytes[x]) in bits(8) proof
      assume hc
      have h1 _ := hc
      have pb: test_malloc.pat_of(i, int_sub(x, b)) in bits(8) by defs(arith(hi, h1, hx, hb), test_malloc.pat_of)
      show by simp(hc, pb)
    qed
    have c2: !C(x) -> ite(C(x), test_malloc.pat_of(i, int_sub(x, b)), V0.bytes[x]) in bits(8) proof
      assume hc
      show by simp(hc, mp(fn_space_app[a := bits(64), b := bits(8), f := V0.bytes, x := x], vt, hx))
    qed
    show by taut(c1, c2)
  qed
  have zt := mp(fn_build_space[d := bits(64), v := x. ite(C(x), test_malloc.pat_of(i, int_sub(x, b)), V0.bytes[x]), b := bits(8)], vq)
  let V := fn_update(V0, "bytes", Z)
  have bu := apply(fn_space_univ, bits_univ[n := 64], bits_univ[n := 8], zt)
  have vu: V in univ(1) by simp(apply(x86.vm_univ, hv), bu)
  have vV := apply(tr.vm_bytes, {V0}, {Z}, hv, zt, vu)
  have e1: fn_update(V, "bytes", V0.bytes) = V0 by simp(hv, keep(x86_64_linux.Vm))
  have zat: all x. x in bits(64) -> Z[x] = ite(C(x), test_malloc.pat_of(i, int_sub(x, b)), V0.bytes[x]) proof
    fix x
    assume hx
    show := mp(app_fn_build[d := bits(64), v := x. ite(C(x), test_malloc.pat_of(i, int_sub(x, b)), V0.bytes[x]), a := x], hx)
  qed
  have hp: all j. j in omega -> int_lt(j, SZ) -> gimple.bytes_at(V, bits_add(64, b, bits_of_int(64, j)), 1) = test_malloc.pat_of(i, j) proof
    fix j
    assume hj hjl
    let X := bits_add(64, b, bits_of_int(64, j))
    have xe: X = int_add(b, j) by defs(arith(hb, hj, hjl, hl), bits_add, bits_of_int, pow2)
    have xb: X in bits(64) by arith(xe, hb, hj, hjl, hl)
    have b1 := mp(all_elim(ms.bytes1, {V}, {X}), (V.bytes in fn_space(bits(64), bits(8)) by simp(zt)), xb)
    have z1 := mp(all_elim(zat, {X}), xb)
    have cx: C(X) by arith(xe, hj, hjl)
    have d: int_sub(X, b) = j by arith(xe)
    show by simp(b1, z1, cx, d)
  qed
  have hpat: test_malloc.has_pat(V, b, i) by defs(hp, test_malloc.has_pat)
  have out: all x. x in bits(64) -> !C(x) -> V.bytes[x] = V0.bytes[x] proof
    fix x
    assume hx hn
    show by simp(mp(all_elim(zat, {x}), hx), hn)
  qed
  show by ex_intro({V}, taut(vV, e1, hpat, out))
qed

// fill(b, i): block i's pattern written at b, nothing else
theorem tp.fill_q: all t b i regs o2. t in abi.World -> b in bits(64) -> i in bits(32) -> int_lt(i, test_malloc.NBLK) ->
  test_malloc.blk_usable(t.vm, t.objs, b, i, true) -> abi.thread_ok(t.vm, t.fs_base) ->
  (all k. k in omega -> int_lt(k, test_malloc.size_of(i)) -> !(int_add(b, k) in malloc.range(t.fs_base, 8))) ->
  gc.regs_ok(regs, seq_concat(seq_one(gimple.arg(64, b)), seq_one(gimple.arg(32, i)))) -> runs(test_malloc.fill_spec_fun()[regs], t, o2) ->
  abi.ovf_out(t, o2) || (ex V r. (V in x86_64_linux.Vm && tp.finv(t.vm, V, b, i, test_malloc.size_of(i))) && o2 = ok(fn_update(t, "vm", V), r))
proof
  fix t b i regs o2
  assume hw hb hi hil hus hth hap hro h
  let OVF := exc_val("stack_overflow", empty)
  have rl rn r0 r1 := mp(all_elim(tp.regs_64_32, {regs}, {b}, {i}), hb, hi, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have ol: ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, ol, keep(ord_le))
  rsimp only, test_malloc.fill_spec_fun, app_fn_build, ra in h
  have o2l: ord_le(2, seq_len(regs)) by defs(simp(rn), ord_le)
  have bp: bits_of_int(64, regs[0]) = b by defs(simp(r0, hb), bits_of_int, pow2)
  have b0 := apply(g.runs_elim, h)
  have b2: bind_rel(test_malloc.fill_spec(b, i), t, x0 x1. any_rel(x2. x2 in bits(64), x2. any_rel(x3. x3 in bits(64), x3. o2 = ok(x0, pair(x2, x3)))),
      x0 x1. o2 = exc(x0, x1), x0. o2 = diverge(x0)) by simp(b0, o2l, bp, r1, keep(bind_rel, test_malloc.fill_spec))
  obtain o3, hs3 hk3 from expand(b2, bind_rel)
  have vV vfun vdom .. := apply(ms.world_parts, hw)
  have pre: ((int_lt(i, test_malloc.NBLK) && test_malloc.blk_usable(t.vm, t.objs, b, i, true)) && abi.thread_ok(t.vm, t.fs_base)) &&
    (all x2. x2 in omega -> int_lt(x2, test_malloc.size_of(i)) -> !(int_add(b, x2) in malloc.range(t.fs_base, 8))) by taut(hil, hus, hth, hap)
  have ci := apply(ct.contract_inv, expand(hs3, test_malloc.fill_spec), pre, vV)
  let SZ := test_malloc.size_of(i)
  let GOAL := abi.ovf_out(t, o2) || (ex V r. (V in x86_64_linux.Vm && tp.finv(t.vm, V, b, i, SZ)) && o2 = ok(fn_update(t, "vm", V), r))
  have c1: abi.ovf_out(t, o3) -> GOAL proof
    assume hx
    obtain v ob, hv hob ho from hx
    have e2: o2 = exc(fn_update(fn_update(t, "vm", v), "objs", ob), OVF) by simp(rewrite(ho, hk3))
    show by disj({1}, ex_intro({v}, {ob}, taut(hv, hob, e2)))
  qed
  let P(x2) := x2 in x86_64_linux.Vm && ((fn_update(x2, "bytes", t.vm.bytes) = t.vm && test_malloc.has_pat(x2, b, i)) &&
    (all x3. x3 in bits(64) -> !(int_le(b, x3) && int_lt(x3, int_add(b, SZ))) -> x2.bytes[x3] = t.vm.bytes[x3]))
  have c2: (ex x0. letin(t.vm, x1. any_rel(x2. x2 in x86_64_linux.Vm && ((fn_update(fn_update(t, "vm", x2).vm, "bytes", x1.bytes) = x1 &&
      test_malloc.has_pat(fn_update(t, "vm", x2).vm, b, i)) && (all x3. x3 in bits(64) -> !(int_le(b, x3) && int_lt(x3, int_add(b, SZ))) ->
      fn_update(t, "vm", x2).vm.bytes[x3] = x1.bytes[x3])), x2. letin(fn_update(t, "vm", x2), x3. x0 = ok(pair(x3, empty), empty)))) &&
      ((fst(x0) = 0 && o3 = ok(fst(out_state(x0)), empty)) || ((((fst(x0) = 1 && fst(out_value(x0)) = "ret") && o3 = ok(fst(out_state(x0)), snd(out_value(x0)))) ||
        ((fst(x0) = 1 && fst(out_value(x0)) = "raise") && o3 = exc(fst(out_state(x0)), snd(out_value(x0))))) || (fst(x0) = 2 && o3 = diverge(snd(x0)))))) -> GOAL proof
    assume hx
    obtain x0, hB hout from hx
    have ar: any_rel(x2. P(x2), x2. x0 = ok(pair(fn_update(t, "vm", x2), empty), empty)) by simp(expand(hB, letin), keep(any_rel))
    have _ bl _ := expand(hus, test_malloc.blk_usable)
    have bl2: int_lt(int_add(b, SZ), 18446744073709551616) by arith(bl)
    obtain V0, f1 f2 f3 f4 f5 from apply(tp.fill_ex[V0 := t.vm, b := b, i := i], vV, hb, (i in omega by arith(hi)), bl2)
    have ne: ex x2. P(x2) by ex_intro({V0}, taut(f1, f3, f4, f5))
    obtain V, p1 p2 p3 p4 hx0 from apply(g.any_e, ne, ar)
    have ho: o3 = ok(fn_update(t, "vm", V), empty) by simp(rewrite(hx0, hout))
    have k5: any_rel(x5. x5 in bits(64), x5. any_rel(x6. x6 in bits(64), x6. o2 = ok(fn_update(t, "vm", V), pair(x5, x6)))) by simp(rewrite(ho, hk3), keep(any_rel))
    have nb: ex y. y in bits(64) by ex_intro({0}, simp())
    obtain y1, hy1 k6 from apply(g.any_e, nb, k5)
    obtain y2, hy2 k7 from apply(g.any_e, nb, k6)
    have fi: tp.finv(t.vm, V, b, i, SZ) by taut(p1, p2, expand(p3, test_malloc.has_pat), p4)
    show by disj({2}, ex_intro({V}, {pair(y1, y2)}, taut(p1, fi, k7)))
  qed
  show by taut(ci, c1, c2)
qed

// intact(b, i), block i's pattern at b: 1, the world unchanged
theorem tp.intact_q: all t b i regs o2. t in abi.World -> b in bits(64) -> i in bits(32) -> int_lt(i, test_malloc.NBLK) ->
  test_malloc.blk_usable(t.vm, t.objs, b, i, false) -> abi.thread_ok(t.vm, t.fs_base) -> test_malloc.has_pat(t.vm, b, i) ->
  gc.regs_ok(regs, seq_concat(seq_one(gimple.arg(64, b)), seq_one(gimple.arg(32, i)))) -> runs(test_malloc.intact_spec_fun()[regs], t, o2) ->
  abi.ovf_out(t, o2) ||
  (ex r. o2 = ok(fn_update(t, "vm", t.vm), r) && (bits_of_int(32, fst(r)) = bits_of_int(32, 1) && fst(r) in bits(64)))
proof
  fix t b i regs o2
  assume hw hb hi hil hus hth hp hro h2
  have rl rn r0 r1 := mp(all_elim(tp.regs_64_32, {regs}, {b}, {i}), hb, hi, hro)
  have lo: seq_len(regs) in omega by simp(rl)
  have ra: regs in set_select(list_type(bits(64)), x0. ord_le(seq_len(x0), 6)) by simp(rl, (ord_le(seq_len(regs), 6) by defs(arith(rn, lo), ord_le)), keep(ord_le))
  have o2l: ord_le(2, seq_len(regs)) by defs(simp(rn), ord_le)
  have bp: bits_of_int(64, regs[0]) = b by defs(simp(r0, hb), bits_of_int, pow2)
  let IV := bits_of_int(32, 1)
  have pv _ _ _ := apply(ms.world_parts, hw)
  have pc: all o. runs(test_malloc.intact_spec(bits_of_int(64, regs[0]), bits_of_int(32, regs[1])), t, o) -> abi.ovf_out(t, o) || o = ok(t, IV) proof
    fix o
    assume hr
    have ci := apply(ct.contract_inv, expand(rewrite(r1, rewrite(bp, hr)), test_malloc.intact_spec), conj(conj(hil, hus), hth), pv)
    show by simp(ci, hp)
  qed
  have res: all o. runs(gimple.result(32, IV), t, o) -> ex u. u in bits(64) && bits_of_int(32, u) = IV && o = ok(t, u) proof
    fix o
    assume hr
    show := mp(all_elim(g.result32_inv, {t}, {IV}, {o}), simp(), hr)
  qed
  have q := apply(tp.fun_ql[p := x0. test_malloc.intact_spec(bits_of_int(64, x0[0]), bits_of_int(32, x0[1])), w := 32, n := 2, regs := regs, s := t, o2 := o2, v := IV], ra, o2l, hw, pc, res,
    expand(h2, test_malloc.intact_spec_fun))
  have c: (ex r. o2 = ok(fn_update(t, "vm", t.vm), r) && bits_of_int(32, fst(r)) = IV && fst(r) in bits(64)) ->
      (ex r. o2 = ok(fn_update(t, "vm", t.vm), r) && (bits_of_int(32, fst(r)) = IV && fst(r) in bits(64))) proof
    assume e
    obtain r, e1 e2 e3 from e
    show by ex_intro({r}, taut(e1, e2, e3))
  qed
  show by taut(q, c)
qed

// ----------------------------------------------------------------------
//  The world and the ghost blocks joined

// (the ghost part's keys: "blocks" only)
theorem tm.gkeys(h, k): h in malloc.Heap.ghost -> !(k = "blocks") -> all z. z in h -> fst(z) != k
proof
  assume hh hk
  have hd: dom(h) = insert("blocks", empty) by simp(expand(hh, malloc.Heap.ghost))
  have sk := apply(abi.keys_of[f := h, d := insert("blocks", empty)], hd)
  fix z
  assume hz
  show by simp(mp(all_elim(sk, {z}), hz), hk)
qed

// the world's memory, its objects changed: the joined state's
theorem tm.u2v(w, h, V): h in malloc.Heap.ghost -> union2(fn_update(w, "vm", V), h) = fn_update(union2(w, h), "vm", V)
proof
  assume hh
  show := sym(mp(fn_update_union_l[a := w, b := h, k := "vm", v := V], apply(tm.gkeys[h := h, k := "vm"], hh, (!("vm" = "blocks") by simp()))))
qed

theorem tm.u2vo(w, h, V, O): h in malloc.Heap.ghost -> union2(fn_update(fn_update(w, "vm", V), "objs", O), h) = fn_update(fn_update(union2(w, h), "vm", V), "objs", O)
proof
  assume hh
  have e1 := mp(fn_update_union_l[a := fn_update(w, "vm", V), b := h, k := "objs", v := O], apply(tm.gkeys[h := h, k := "objs"], hh, (!("objs" = "blocks") by simp())))
  have e2 := mp(fn_update_union_l[a := w, b := h, k := "vm", v := V], apply(tm.gkeys[h := h, k := "vm"], hh, (!("vm" = "blocks") by simp())))
  show := trans(sym(e1), rewrite(sym(e2), refl({fn_update(union2(fn_update(w, "vm", V), h), "objs", O)}), {2}))
qed

// (the joined state's fields)
theorem tm.u2f(w, h, V, O): w in abi.World -> h in malloc.Heap.ghost ->
  vm: union2(fn_update(fn_update(w, "vm", V), "objs", O), h).vm = V && objs: union2(fn_update(fn_update(w, "vm", V), "objs", O), h).objs = O &&
  fs: union2(fn_update(fn_update(w, "vm", V), "objs", O), h).fs_base = w.fs_base && blocks: union2(fn_update(fn_update(w, "vm", V), "objs", O), h).blocks = h.blocks
proof
  assume hw hh
  have e := apply(tm.u2vo[w := w, h := h, V := V, O := O], hh)
  have sd: dom(w) = abi.WKEYS by simp(expand(hw, abi.World))
  have hd: dom(h) = insert("blocks", empty) by simp(expand(hh, malloc.Heap.ghost))
  have fs0: union2(w, h).fs_base = w.fs_base by simp(sd, hd)
  have bl0: union2(w, h).blocks = h.blocks by simp(sd, hd)
  show by simp(e, fs0, bl0)
qed

// (the memory set after the objects: as set before them)
theorem tm.wvv(w, V, V2, O): fn_update(fn_update(fn_update(w, "vm", V), "objs", O), "vm", V2) = fn_update(fn_update(w, "vm", V2), "objs", O)
proof
  have s := fn_update_swap[f := fn_update(w, "vm", V), k := "objs", a := O, j := "vm", b := V2]
  have e := mp(s, (!("objs" = "vm") by simp()))
  show := trans(e, rewrite(fn_update_twice[f := w, k := "vm", a := V, b := V2], refl({fn_update(fn_update(fn_update(w, "vm", V), "vm", V2), "objs", O)}), {2}))
qed

// (the joined state with the memory V3: the one with V, its memory V3)
theorem tm.u2w(w, h, V, V3, O): h in malloc.Heap.ghost ->
  union2(fn_update(fn_update(w, "vm", V3), "objs", O), h) = fn_update(union2(fn_update(fn_update(w, "vm", V), "objs", O), h), "vm", V3)
proof
  assume hh
  have e1 := apply(tm.u2vo[w := w, h := h, V := V3, O := O], hh)
  have e2 := apply(tm.u2vo[w := w, h := h, V := V, O := O], hh)
  show := trans(e1, sym(rewrite(sym(e2), tm.wvv[w := union2(w, h), V := V, V2 := V3, O := O], {1})))
qed

// (the array's word i: the program may read and write it)
theorem tm.cell_md(b, cd, st, W, h, l0, i, wr): W in abi.World -> h in malloc.Heap.ghost -> malloc.world_ok(b, cd, st, union2(W, h)) ->
  l0 in omega -> !(l0 = 0) -> int_le(int_add(l0, 64), 18446744073709551616) -> i in omega -> int_lt(i, 8) ->
  (all a. a in omega -> int_le(l0, a) -> int_lt(a, int_add(l0, 64)) -> a in W.objs.live) ->
  g.mem_defined(W, int_add(l0, int_mul(8, i)), 0, 8, wr)
proof
  assume hW hh hw hl0 hl0z hl64 hi hil ha
  have sd: dom(W) = abi.WKEYS by simp(expand(hW, abi.World))
  have hd: dom(h) = insert("blocks", empty) by simp(expand(hh, malloc.Heap.ghost))
  have ev: union2(W, h).vm = W.vm by simp(sd, hd)
  have eo: union2(W, h).objs = W.objs by simp(sd, hd)
  let A := int_add(l0, int_mul(8, i))
  have us: gimple.usable(W.vm, W.objs, A, 8, wr) proof
    unfold gimple.usable
    fix x0
    assume h0 h1
    have xo: int_add(A, x0) in omega by arith(hl0, hi, h0)
    have l := mp(all_elim(ha, {int_add(A, x0)}), xo, (int_le(l0, int_add(A, x0)) by arith(hi, h0)), (int_lt(int_add(A, x0), int_add(l0, 64)) by arith(hil, h1)))
    have um := rewrite(ev, apply(tm.obj_unm[b := b, cd := cd, st := st, H := union2(W, h), a := int_add(A, x0)], hw, xo, rewrite(sym(eo), l)))
    show by simp(um, l, (int_lt(int_add(A, x0), int_pow(2, 64)) by arith(hl64, hil, h1)))
  qed
  show by taut((!(A = 0) by arith(hl0, hl0z, hi)), (int_lt(int_add(A, 0), pow2(64)) by defs(arith(hl64, hil), pow2)), (gimple.usable(W.vm, W.objs, int_add(A, 0), 8, wr) by simp(us)))
qed

// (a store at the array's word i: word k, another, as it was)
theorem tm.cell_store(V, l0, i, k, p): l0 in omega -> int_le(int_add(l0, 64), 18446744073709551616) -> i in omega -> int_lt(i, 8) -> k in omega -> int_lt(k, 8) -> !(k = i) ->
  tm.cell(fn_update(V, "bytes", x86_64_linux.store_le(V.bytes, int_add(l0, int_mul(8, i)), 8, p)), l0, k) = tm.cell(V, l0, k)
proof
  assume hl0 hl64 hi hil hk hkl hki
  have ag: all a. a in omega -> int_le(int_add(l0, int_mul(8, k)), a) -> int_lt(a, int_add(int_add(l0, int_mul(8, k)), 8)) ->
      fn_update(V, "bytes", x86_64_linux.store_le(V.bytes, int_add(l0, int_mul(8, i)), 8, p)).bytes[bits_of_int(64, a)] = V.bytes[bits_of_int(64, a)] proof
    fix a
    assume ao h1 h2
    have be: bits_of_int(64, a) = a by defs(arith(ao, h2, hl64, hkl, hk), bits_of_int, pow2)
    have ab: a in bits(64) by arith(ao, h2, hl64, hkl, hk)
    have s := apply(tm.st_at[B := V.bytes, A := int_add(l0, int_mul(8, i)), n := 8, v := p, x := a], ab, (int_add(l0, int_mul(8, i)) in omega by arith(hl0, hi)), simp(),
      (int_le(int_add(int_add(l0, int_mul(8, i)), 8), 18446744073709551616) by arith(hl64, hil, hi)), (!(int_le(int_add(l0, int_mul(8, i)), a) && int_lt(a, int_add(int_add(l0, int_mul(8, i)), 8))) by arith(h1, h2, hki, hk, hi)))
    show by simp(be, s)
  qed
  show := apply(tm.cell_eq[V := V, V2 := fn_update(V, "bytes", x86_64_linux.store_le(V.bytes, int_add(l0, int_mul(8, i)), 8, p)), c := int_add(l0, int_mul(8, k))],
    (int_add(l0, int_mul(8, k)) in omega by arith(hl0, hk)), (int_le(int_add(int_add(l0, int_mul(8, k)), 8), 18446744073709551616) by arith(hl64, hkl, hk)), ag)
qed

// (the objects' live set restored: the world with the memory V only)
theorem tm.restore(w, g, V, L): w in abi.World -> g in malloc.Heap.ghost ->
  fn_update(union2(fn_update(fn_update(w, "vm", V), "objs", fn_update(w.objs, "live", L)), g), "objs", fn_update(fn_update(w.objs, "live", L), "live", w.objs.live)) =
  union2(fn_update(w, "vm", V), g)
proof
  assume hw hg
  have of od := (is_fun(w.objs) && "live" in dom(w.objs) by simp(expand(hw, abi.World), keep(abi.Objs)))
  have o1 := trans(fn_update_twice[f := w.objs, k := "live", a := L, b := w.objs.live], mp(fn_update_same[f := w.objs, k := "live"], of, od))
  have u := mp(fn_update_union_l[a := fn_update(fn_update(w, "vm", V), "objs", fn_update(w.objs, "live", L)), b := g, k := "objs", v := w.objs],
    apply(tm.gkeys[h := g, k := "objs"], hg, (!("objs" = "blocks") by simp())))
  have t2 := fn_update_twice[f := fn_update(w, "vm", V), k := "objs", a := fn_update(w.objs, "live", L), b := w.objs]
  have vo := apply(gc.vm_objs, {w}, {V}, hw)
  let X := fn_update(fn_update(w.objs, "live", L), "live", w.objs.live)
  let Wv := fn_update(fn_update(w, "vm", V), "objs", fn_update(w.objs, "live", L))
  have e1 := rewrite(o1, refl({fn_update(union2(Wv, g), "objs", X)}), {2})
  show := trans(e1, rewrite(vo, rewrite(t2, u)))
qed

// (an overflow's world from W(Vx): from w, its memory and objects any)
theorem tm.ovw(w, Vx, v, O, ob): fn_update(fn_update(fn_update(fn_update(w, "vm", Vx), "objs", O), "vm", v), "objs", ob) = fn_update(fn_update(w, "vm", v), "objs", ob)
proof
  show := rewrite(fn_update_twice[f := fn_update(w, "vm", v), k := "objs", a := O, b := ob],
    rewrite(tm.wvv[w := w, V := Vx, V2 := v, O := O], refl({fn_update(fn_update(fn_update(fn_update(w, "vm", Vx), "objs", O), "vm", v), "objs", ob)}), {2}))
qed

// ----------------------------------------------------------------------
//  main's run

theorem tm.main_run: all I O eo b cd st gsz gm gf gfr gin w h o. tm.laws(I, O, eo) -> app(eo, empty) = 52 -> malloc.free_step(I, O, eo, b, cd, st) ->
  tm.mcall(I, O, eo, b, cd, st, gm) -> tm.fcall(I, O, eo, b, cd, st, gfr) -> tp.calls(gsz, test_malloc.size_spec_fun()) ->
  tp.calls(gf, test_malloc.fill_spec_fun()) -> tp.calls(gin, test_malloc.intact_spec_fun()) ->
  w in abi.World -> h in malloc.Heap.ghost -> union2(w, h) in I -> malloc.errno_ok(eo, union2(w, h)) -> malloc.world_ok(b, cd, st, union2(w, h)) ->
  (all p. p in bits(64) -> union2(w, h).blocks[p] = none) ->
  runs(c_tests_test_malloc.main(gsz, gm, gf, gfr, gin), w, o) ->
  abi.ovf_out(w, o) ||
  (ex V g r L. (((V in x86_64_linux.Vm && g in malloc.Heap.ghost) && (r = 0 || r = 1)) &&
     malloc.world_ok(b, cd, st, union2(fn_update(w, "vm", V), g)) && test_malloc.main_frame(O, eo, union2(w, h), union2(fn_update(w, "vm", V), g))) &&
     o = ok(fn_update(fn_update(w, "vm", V), "objs", fn_update(w.objs, "live", L)), r))
proof
  fix I O eo b cd st gsz gm gf gfr gin w h o
  assume hl he hfs hmc hfc hgs hgf hgi hw hh hi heo hwo hbn hr
  have pu := apply(g.runs_univ, hr)
  have hu: w in univ(1) by simp(pu)
  let S0 := union2(w, h)
  have s0t := apply(rec_and_intro, hw, hh)
  have sd: dom(w) = abi.WKEYS by simp(expand(hw, abi.World))
  have hd: dom(h) = insert("blocks", empty) by simp(expand(hh, malloc.Heap.ghost))
  have ev0: S0.vm = w.vm by simp(sd, hd)
  have eo0: S0.objs = w.objs by simp(sd, hd)
  have ef0: S0.fs_base = w.fs_base by simp(sd, hd)
  step a1 a2 a3 a4 a5 a6 o1 l V0, hk hll hfit hVm hvb hvf from hr with g.alloc_inv using conj(hw, hu)
  let SZ := seq_one(pair(64, 16))
  let L := g.live_with(w.objs.live, l, SZ)
  let O1 := fn_update(w.objs, "live", L)
  let W(V) := fn_update(fn_update(w, "vm", V), "objs", O1)
  let H(V, g0) := union2(W(V), g0)
  let R := pair(a2, pair(a3, pair(a4, pair(a5, a6))))
  let OVF := exc_val("stack_overflow", empty)
  // ---- main's start: the array placed, main's invariant, no block yet
  have w1W w1u := apply(g.alloc_world[s := w, V := V0, l := l, sz := SZ], hw, hu, hVm)
  have wvW wvu := apply(mp.am_world, hw, hu, hVm)
  have ht1: fn_update(S0, "vm", V0) in rec_and(abi.World, malloc.Heap.ghost) := rewrite(apply(tm.u2v[w := w, h := h, V := V0], hh), apply(rec_and_intro, wvW, hh))
  have e02 := apply(tm.u2vo[w := w, h := h, V := V0, O := O1], hh)
  have ht2 := rewrite(sym(eo0), rewrite(e02, apply(rec_and_intro, w1W, hh)))
  have mi0w := apply(tm.mi_init[I := I, O := O, eo := eo, b := b, cd := cd, st := st, S0 := S0, V := V0, l := l], hl, s0t, ht1, ht2, hi, heo, hwo, hbn, hll,
    rewrite(sym(eo0), rewrite(sym(ev0), hfit)), hVm, rewrite(sym(ev0), hvb), rewrite(sym(ev0), hvf))
  have mi0b := rewrite(sym(e02), rewrite(eo0, mi0w))
  have _ _ _ _ _ _ _ l0o l64 := mi0b
  have mi0: tm.mi(I, O, eo, b, cd, st, S0, H(V0, h), l[0], empty) by taut(mi0b)
  have _ hall0 _ _ := expand(hfit, gimple.objs_fit)
  have _ l0z _ _ := mp(all_elim(hall0, {0}), simp(), (int_lt(0, seq_len(SZ)) by simp()))
  have l0b: l[0] in bits(64) by arith(l0o, l64)
  // (the array: O1's live objects)
  have _ _ _ _ _ ha0 _ := mi0
  have {fo0 = objs} := apply(tm.u2f[w := w, h := h, V := V0, O := O1], hw, hh)
  have arrW: all V a. a in omega -> int_le(l[0], a) -> int_lt(a, int_add(l[0], 64)) -> a in W(V).objs.live proof
    fix V a
    assume ao h1 h2
    have l1 _ := mp(all_elim(ha0, {a}), ao, h1, h2)
    show by simp(rewrite(fo0, l1))
  qed
  have nb: test_malloc.NBLK = 8 by defs(refl({8}), test_malloc.NBLK)
  let K1(n) := set_select(omega, k. int_lt(k, n))
  // ---- loop 1: blocks 0 .. i-1 allocated and filled
  obtain r1, wl1 kr1 from hk
  let BODY1(x, y) := loop_body(wl1)
  let G1(i, V, y) := (int_lt(i, 8) && (ex V2 g2. ((V2 in x86_64_linux.Vm && g2 in malloc.Heap.ghost) && tm.mi(I, O, eo, b, cd, st, S0, H(V2, g2), l[0], K1(int_add(i, 1)))) &&
      y = ok(pair(W(V2), pair(int_add(i, 1), R)), empty))) ||
    (ex V2 g2. ((V2 in x86_64_linux.Vm && g2 in malloc.Heap.ghost) && tm.wk(O, eo, b, cd, st, S0, H(V2, g2), l[0])) &&
      y = exc(pair(W(V2), pair(i, pair(1, pair(a3, pair(a4, pair(a5, 1)))))), pair("ret", 1))) ||
    (i = 8 && y = exc(pair(W(V), pair(i, R)), pair("brk", empty))) ||
    (ex Vx v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && y = exc(pair(fn_update(fn_update(W(Vx), "vm", v), "objs", ob), pair(i, R)), pair("raise", OVF)))
  have trip1: all i V g y. i in omega -> int_le(i, 8) -> V in x86_64_linux.Vm -> g in malloc.Heap.ghost ->
      tm.mi(I, O, eo, b, cd, st, S0, H(V, g), l[0], K1(i)) -> BODY1(pair(W(V), pair(i, R)), y) -> G1(i, V, y) proof
    fix i V g y
    assume hi0 hil hv hg hmi hbd
    have wW wu := apply(g.alloc_world[s := w, V := V, l := l, sz := SZ], hw, hu, hv)
    have Ht := apply(rec_and_intro, wW, hg)
    have hiH heH hwH _ _ _ _ := hmi
    have {fv = vm, ff = fs} := apply(tm.u2f[w := w, h := g, V := V, O := O1], hw, hg)
    have _ _ th _ _ _ _ _ _ := expand(hwH, malloc.world_ok)
    have thW: abi.thread_ok(W(V).vm, W(V).fs_base) by simp(rewrite(ff, rewrite(fv, th)))
    have ths: gc.sound(W(V)) by simp(thW)
    have si: sint(32, i) = i := mp(all_elim(ms.sint_small, {i}), hi0, arith(hil))
    have s7v: sint(32, 7) = 7 := mp(all_elim(ms.sint_small, {7}), simp(), arith())
    have c8: i = 8 -> G1(i, V, y) proof
      assume e
      have cf: !int_le(sint(32, i), sint(32, 7)) by simp(si, s7v, e)
      step eA from hbd with cf
      show by taut(e, eA)
    qed
    have clt: int_lt(i, 8) -> G1(i, V, y) proof
      assume hil8
      have ib: i in bits(32) by arith(hi0, hil8)
      have s7: int_le(sint(32, i), sint(32, 7)) by simp(si, s7v, (int_le(i, 7) by arith(hil8)))
      have i8: int_lt(i, test_malloc.NBLK) by simp(hil8, nb)
      step c1 c2 r2 s1, e1 kx1 hr2 from hbd with s7, tp.size_q using hgs, wW, wu, thW, ib, i8
      have sz1 _ := hr2
      have vW vfun vdom _ := apply(ms.world_parts, wW)
      have vw: W(V).vm = V by simp()
      have ww1: fn_update(W(V), "vm", V) = W(V) := rewrite(vw, mp(fn_update_same[f := W(V), k := "vm"], vfun, vdom))
      let SZI := test_malloc.size_of(i)
      have szo: SZI in omega by defs(arith(hi0), test_malloc.size_of)
      have szl: int_le(SZI, 296) by defs(arith(hi0, hil8), test_malloc.size_of)
      have bS: bits_of_int(32, SZI) = SZI by defs(arith(szl, szo), bits_of_int, pow2)
      have sx := apply(ms.sext_small, (SZI in bits(32) by arith(szo, szl)), (int_lt(SZI, 2147483648) by arith(szl)))
      have e1b := rewrite(sx, rewrite(bS, rewrite(sz1, rewrite(ww1, e1))))
      have szb: SZI in bits(64) by arith(szo, szl)
      step m1 m2 V2 r3, e2 kx2 hm from conj(e1b, kx1) with tm.malloc_q using hmc, wW, wu, ths, hg, hiH, heH, hwH, szb
      // (the world W(V2), the ghost blocks g3; the block's word P)
      have sxi := apply(ms.sext_small, ib, (int_lt(i, 2147483648) by arith(hil8)))
      have ww2 := tm.wvv[w := w, V := V, V2 := V2, O := O1]
      have e2b := rewrite(ww2, rewrite(sxi, e2))
      have hv2 hex := hm
      obtain g3, hg3 hrun0 from hex
      have hrun := rewrite(ww2, hrun0)
      let P := fst(r3)
      let A := int_add(l[0], int_mul(8, i))
      have w2W w2u := apply(g.alloc_world[s := w, V := V2, l := l, sz := SZ], hw, hu, hv2)
      have T2t := apply(rec_and_intro, w2W, hg3)
      have {fv2 = vm, fo2 = objs, ff2 = fs, fb2 = blocks} := apply(tm.u2f[w := w, h := g3, V := V2, O := O1], hw, hg3)
      have ab: A in bits(64) by arith(l64, hil8, hi0, l0o)
      have z0: int_add(A, 0) = A by arith()
      have el := apply(g.elem8_det, {W(V2)}, {l[0]}, {i}, w2u, l0b, hi0, (int_lt(i, 2147483648) by arith(hil8)), (int_lt(A, 18446744073709551616) by arith(l64, hil8, hi0)))
      let V3 := fn_update(V2, "bytes", x86_64_linux.store_le(V2.bytes, A, 8, P))
      have v3V: V3 in x86_64_linux.Vm := mp(all_elim(ms.wr_any, {V2}, {A}, {8}, {P}), hv2)
      have w3W w3u := apply(g.alloc_world[s := w, V := V3, l := l, sz := SZ], hw, hu, v3V)
      have ew3: fn_update(W(V2), "vm", fn_update(W(V2).vm, "bytes", x86_64_linux.store_le(W(V2).vm.bytes, A, 8, P))) = W(V3) :=
        trans((fn_update(W(V2), "vm", fn_update(W(V2).vm, "bytes", x86_64_linux.store_le(W(V2).vm.bytes, A, 8, P))) = fn_update(W(V2), "vm", V3) by simp()),
          tm.wvv[w := w, V := V2, V2 := V3, O := O1])
      have e3T: fn_update(H(V2, g3), "vm", V3) = H(V3, g3) := sym(apply(tm.u2w[w := w, h := g3, V := V2, V3 := V3, O := O1], hg3))
      have v2W2 vfun2 vdom2 _ := apply(ms.world_parts, w2W)
      have arr2 := all_elim(arrW, {V2})
      have arr3 := all_elim(arrW, {V3})
      // malloc's 0: the store, then the return of 1
      have cz: P = 0 -> G1(i, V, y) proof
        assume pz
        have rz := rewrite(pz, hrun)
        obtain Vz, z1 z2 z3 z4 z5 z6 z7 from apply(malloc.malloc_zero[i := I, o := O, e := eo, b := b, c := cd, st := st, n := SZI, s := H(V, g), t := H(V2, g3)], rz, Ht, hiH, heH, hwH)
        have wk2 := apply(tm.wk_zero[I := I, O := O, eo := eo, b := b, cd := cd, st := st, S0 := S0, S := H(V, g), t := H(V2, g3), V := Vz, l0 := l[0], K := K1(i)],
          he, Ht, hmi, z1, rewrite(sym(fv2), hv2), z2, z3, z4, z5, z6, z7)
        have hw2 _ _ _ := wk2
        have md := apply(tm.cell_md[b := b, cd := cd, st := st, W := W(V2), h := g3, l0 := l[0], i := i, wr := true], w2W, hg3, hw2, l0o, l0z, l64, hi0, hil8, arr2)
        have sdz := rewrite(z0, mp(all_elim(g.st64_det, {W(V2)}, {A}, {0}, {P}), w2u, ab, simp(), md, v2W2, vfun2, vdom2))
        have wk3 := rewrite(e3T, rewrite(fv2, apply(tm.wk_store[O := O, eo := eo, b := b, cd := cd, st := st, S0 := S0, H := H(V2, g3), l0 := l[0], i := i, p := P], wk2, l0o, l64, hi0, hil8)))
        have hw3 _ _ _ := wk3
        have md3 := apply(tm.cell_md[b := b, cd := cd, st := st, W := W(V3), h := g3, l0 := l[0], i := i, wr := false], w3W, hg3, hw3, l0o, l0z, l64, hi0, hil8, arr3)
        have ld := rewrite(z0, mp(all_elim(g.ld64_det, {W(V3)}, {A}, {0}), w3u, ab, simp(), md3))
        have c00: bits_of_int(64, gimple.bytes_at(V3, A, 8)) = 0 by mem(pz, (A in omega by arith(l0o, hi0)), (int_le(int_add(A, 8), 18446744073709551616) by arith(l64, hil8, hi0)))
        have c0: bits_of_int(64, gimple.bytes_at(W(V3).vm, A, 8)) = 0 := rewrite(sym((W(V3).vm = V3 by simp())), c00)
        have el3 := apply(g.elem8_det, {W(V3)}, {l[0]}, {i}, w3u, l0b, hi0, (int_lt(i, 2147483648) by arith(hil8)), (int_lt(A, 18446744073709551616) by arith(l64, hil8, hi0)))
        step eZ from conj(e2b, kx2) with el, sdz, ew3, el3, ld, c0
        have wq: tm.wk(O, eo, b, cd, st, S0, H(V3, g3), l[0]) by taut(wk3)
        show by disj({2}, ex_intro({V3}, {g3}, taut(v3V, hg3, wq, eZ)))
      qed
      have ck: !(P = 0) -> G1(i, V, y) proof
        assume pn
        have al pb ex := apply(malloc.malloc_blk[i := I, o := O, e := eo, b := b, c := cd, st := st, n := SZI, s := H(V, g), t := H(V2, g3), v := P], hrun, hiH, heH, hwH, pn)
        obtain z Vb, zo zle hfr heq hst hwT heT from ex
        have vb: Vb = V2 by simp(rewrite(heq, fv2))
        have hvH: H(V, g).vm in x86_64_linux.Vm := rewrite(sym(fv), hv)
        have mm := apply(tm.mi_malloc[I := I, O := O, eo := eo, b := b, cd := cd, st := st, S0 := S0, H := H(V, g), l0 := l[0], K := K1(i), p := P, z := z, V := Vb],
          hl, he, Ht, hvH, rewrite(sym(vb), hv2), l0o, l64, hmi, hfr, rewrite(heq, hst), rewrite(heq, hwT), rewrite(heq, heT))
        have miT: tm.mi(I, O, eo, b, cd, st, S0, H(V2, g3), l[0], K1(i)) by taut(rewrite(sym(heq), mm))
        have disT: all k. k in omega -> int_lt(k, 8) -> k in K1(i) -> !(tm.cell(V2, l[0], k) = P) by taut(rewrite(vb, mm))
        // the store of P at word i
        have eqS: fn_update(H(V2, g3), "vm", fn_update(H(V2, g3).vm, "bytes", x86_64_linux.store_le(H(V2, g3).vm.bytes, A, 8, P))) = H(V3, g3) :=
          trans((fn_update(H(V2, g3), "vm", fn_update(H(V2, g3).vm, "bytes", x86_64_linux.store_le(H(V2, g3).vm.bytes, A, 8, P))) = fn_update(H(V2, g3), "vm", V3) by simp(fv2)), e3T)
        have T3t := apply(rec_and_intro, w3W, hg3)
        have nki: all k. k in omega -> k in K1(i) -> !(k = i) proof
          fix k
          assume hk2 hkK
          have _ kl := unsel(hkK)
          show by arith(kl)
        qed
        have ms := apply(tm.mi_store[I := I, O := O, eo := eo, b := b, cd := cd, st := st, S0 := S0, H := H(V2, g3), l0 := l[0], K := K1(i), i := i, p := P],
          hl, T2t, rewrite(sym(eqS), T3t), rewrite(sym(fv2), hv2), l0o, l64, hi0, hil8, pb, miT, nki)
        have mi3: tm.mi(I, O, eo, b, cd, st, S0, H(V3, g3), l[0], K1(i)) by taut(rewrite(eqS, ms))
        have {fv3 = vm, fo3 = objs, ff3 = fs, fb3 = blocks} := apply(tm.u2f[w := w, h := g3, V := V3, O := O1], hw, hg3)
        have hi3 he3 hw3 _ _ _ _ := mi3
        have md := apply(tm.cell_md[b := b, cd := cd, st := st, W := W(V2), h := g3, l0 := l[0], i := i, wr := true], w2W, hg3, (malloc.world_ok(b, cd, st, H(V2, g3)) by taut(miT)),
          l0o, l0z, l64, hi0, hil8, arr2)
        have sdz := rewrite(z0, mp(all_elim(g.st64_det, {W(V2)}, {A}, {0}, {P}), w2u, ab, simp(), md, v2W2, vfun2, vdom2))
        have md3 := apply(tm.cell_md[b := b, cd := cd, st := st, W := W(V3), h := g3, l0 := l[0], i := i, wr := false], w3W, hg3, hw3, l0o, l0z, l64, hi0, hil8, arr3)
        have ld := rewrite(z0, mp(all_elim(g.ld64_det, {W(V3)}, {A}, {0}), w3u, ab, simp(), md3))
        have el3 := apply(g.elem8_det, {W(V3)}, {l[0]}, {i}, w3u, l0b, hi0, (int_lt(i, 2147483648) by arith(hil8)), (int_lt(A, 18446744073709551616) by arith(l64, hil8, hi0)))
        have cv0: bits_of_int(64, gimple.bytes_at(V3, A, 8)) = P by mem(pb, (A in omega by arith(l0o, hi0)), (int_le(int_add(A, 8), 18446744073709551616) by arith(l64, hil8, hi0)))
        have cv: bits_of_int(64, gimple.bytes_at(W(V3).vm, A, 8)) = P := rewrite(sym((W(V3).vm = V3 by simp())), cv0)
        have cn: !(bits_of_int(64, gimple.bytes_at(W(V3).vm, A, 8)) = 0) := rewrite(sym(cv), pn)
        // fill(P, i): the block's pattern
