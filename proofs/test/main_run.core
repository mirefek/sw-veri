        have wv4 := apply(g.loop[b := x y. BODY4(x, y), p := x. PI4(x)], p40, pm4, nx4, wl4)
        obtain x4, hpl4 bb4 nk4 from wv4
        obtain i4, hi4 hil4 hx4 from hpl4
        have t4 := apply(trip4, hi4, hil4, rewrite(hx4, bb4))
        have cok4: (int_lt(i4, 8) && r4 = ok(pair(W(V3), pair(int_add(i4, 1), R)), empty)) -> GM proof
          assume e
          have _ he4 := e
          show by taut(nk4, (is_ok(r4) by defs(ex_intro({pair(W(V3), pair(int_add(i4, 1), R))}, {empty}, he4), is_ok)))
        qed
        have cvf4: (ex Vx v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && r4 = exc(pair(fn_update(fn_update(W(Vx), "vm", v), "objs", ob), pair(i4, R)), pair("raise", OVF))) -> GM proof
          assume e
