          show by simp(hx, (int_sub(8, i) in omega by arith(hil)))
        qed
        have nx4: all x x2. PI4(x) -> BODY4(x, ok(x2, empty)) -> PI4(x2) && int_lt(M4(x2), M4(x)) proof
          fix x x2
          assume hp hbd
