            have bus: test_malloc.blk_usable(W(V3).vm, W(V3).objs, Q, i, false) by simp(rewrite(fo, rewrite(fv, bu)))
            have qpW: test_malloc.has_pat(W(V3).vm, Q, i) by simp()
            step c1 c2 r5 s5, e1 kx1 hr5 from hbd with s7, els, ld, cq, tp.intact_q using hgi, wW, wu, ths, qb, ib, i8, bus, thW, qpW
            have rv _ := hr5
            have n0: !(bits_of_int(32, fst(s5)) = 0) by simp(rv)
            have s1v: sint(32, 1) = 1 := mp(all_elim(ms.sint_small, {1}), simp(), arith())
            have fj: tr.s32_fits(int_add(sint(32, i), sint(32, 1))) by defs(symex(si, s1v, (int_lt(int_add(i, 1), 2147483648) by arith(hil8)), (int_le(0, i) by arith())), gimple.fits)
            have ad := apply(g.sadd32_det, {W(V3)}, {i}, {1}, wu, ib, simp(), fj)
            step e2 from conj(rewrite(ww1, e1), kx1) with n0, ad
