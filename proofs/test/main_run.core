          obtain i5 V5 g5, hi5 hil5 hv5 hg5 hmi5 hx5 from hpl5
          have t5 := apply(trip5, hi5, hil5, hv5, hg5, hmi5, rewrite(hx5, bb5))
          have cok5: (int_lt(i5, 8) && (ex V6 g6. ((V6 in x86_64_linux.Vm && g6 in malloc.Heap.ghost) && tm.mi(I, O, eo, b, cd, st, S0, H(V6, g6), l[0], K5(int_add(i5, 1)))) &&
              r5 = ok(pair(W(V6), pair(int_add(i5, 1), R)), empty))) -> GM proof
            assume e
            have _ ex6 := e
            obtain V6 g6, _ _ _ he6 from ex6
            show by taut(nk5, (is_ok(r5) by defs(ex_intro({pair(W(V6), pair(int_add(i5, 1), R))}, {empty}, he6), is_ok)))
          qed
          have cvf5: (ex Vx v ob. (v in x86_64_linux.Vm && ob in abi.Objs) && r5 = exc(pair(fn_update(fn_update(W(Vx), "vm", v), "objs", ob), pair(i5, R)), pair("raise", OVF))) -> GM proof
            assume e
            obtain Vx v ob, hv hob hr5e from e
            step qq from rewrite(hr5e, kr5)
            show := apply(covf, conj(hv, hob), hr5e, qq)
          qed
          // ---- loop 5 done: main returns 0
          have cbrk5: (i5 = 8 && r5 = exc(pair(W(V5), pair(i5, R)), pair("brk", empty))) -> GM proof
            assume e
            have e8e hr5e := e
            step qq from rewrite(hr5e, kr5)
            have wk5 := apply(tm.wk_of_mi, hmi5)
            show := apply(fin, hv5, hg5, wk5, (0 = 0 || 0 = 1 by simp()), qq)
          qed
          show by taut(t5, cok5, cvf5, cbrk5)
        qed
        show by taut(t4, cok4, cvf4, cbrk4)
      qed
      show by taut(t3, cok3, cret3, cvf3, cbrk3)
    qed
    show by taut(t2, cok2, cvf2, cbrk2)
  qed
  have cok1: (int_lt(i1, 8) && (ex V2 g2. ((V2 in x86_64_linux.Vm && g2 in malloc.Heap.ghost) && tm.mi(I, O, eo, b, cd, st, S0, H(V2, g2), l[0], K1(int_add(i1, 1)))) &&
      r1 = ok(pair(W(V2), pair(int_add(i1, 1), R)), empty))) -> GM proof
    assume e
    have _ ex2 := e
    obtain V2 g2, _ _ _ he2 from ex2
    show by taut(nk1, (is_ok(r1) by defs(ex_intro({pair(W(V2), pair(int_add(i1, 1), R))}, {empty}, he2), is_ok)))
  qed
  show by taut(t1, cok1, cret, cvf1, cbrk1)
qed
