// The normal form of values (docs/overview.md, the rules' standard form):
// the oriented equations the C1 engine's normalizer N applies
// (slc/cli/src/c1/nf.rs), innermost first, each step one instance:
// - a closed literal term is its numeral (by evaluation, no equation);
// - a cast of a word of its width is the word (nf.boi_*);
// - a shift by a constant is a product by 2^k (nf.shl_mul), a value added
//   to itself twice it (nf.add_self);
// - commutative operands in one order, literals last (nf.*_comm, and
//   x86.mul_comm, x86.and_comm, x86i.xor_comm).

theorem nf.add_comm: all n a b. bits_add(n, a, b) = bits_add(n, b, a)
proof
  fix n a b
  have h: int_add(a, b) = int_add(b, a) by arith()
  show by defs(simp(h), bits_add)
qed

theorem nf.or_comm: all n a b. bits_or(n, a, b) = bits_or(n, b, a)
proof
  fix n a b
  have pq: all x. (x in bits(n) && (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(a, i) || bit(b, i)))) <-> (x in bits(n) && (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(b, i) || bit(a, i)))) proof
    fix x
    have d1: (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(a, i) || bit(b, i))) -> (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(b, i) || bit(a, i))) proof
      assume h
      fix i
      assume i1 i2
      have hi := mp(all_elim(h, {i}), i1, i2)
      show by taut(hi)
    qed
    have d2: (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(b, i) || bit(a, i))) -> (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(a, i) || bit(b, i))) proof
      assume h
      fix i
      assume i1 i2
      have hi := mp(all_elim(h, {i}), i1, i2)
      show by taut(hi)
    qed
    show by taut(d1, d2)
  qed
  have e := mp(choose_ext[p := x. x in bits(n) && (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(a, i) || bit(b, i))), q := x. x in bits(n) && (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(b, i) || bit(a, i)))], pq)
  show by defs(e, bits_or, bits_build)
qed

// (a value added to itself: twice it)
theorem nf.add_self: all n x. bits_add(n, x, x) = bits_mul(n, x, 2)
proof
  fix n x
  have h: int_add(x, x) = int_mul(x, 2) by arith()
  show by defs(simp(h), bits_add, bits_mul)
qed

theorem nf.shl_mul:all n a k. bits_shl(n, a, k) = bits_mul(n, a, pow2(k))
proof
  fix n a k
  show by defs(simp(), bits_shl, bits_mul)
qed

// The ring of words modulo 2^n (from mod_add_mod, mod_mul_mod in
// core/bits.core): a sum nested to the left, its terms in N's order (a
// term moved left past a later one), its literals gathered last; a
// product by a literal distributed over a sum, literal factors gathered.

theorem nf.add_assoc: all n a b c. n in omega -> bits_add(n, a, bits_add(n, b, c)) = bits_add(n, bits_add(n, a, b), c)
proof
  fix n a b c
  assume hn
  have p := mp(pow2_pos[k := n], hn)
  have l1 := mp(mod_add_mod[x := int_add(b, c), y := a, m := pow2(n)], p)
  have r1 := mp(mod_add_mod[x := int_add(a, b), y := c, m := pow2(n)], p)
  have c1: int_add(int_mod(int_add(b, c), pow2(n)), a) = int_add(a, int_mod(int_add(b, c), pow2(n))) by arith()
  have c2: int_add(int_add(b, c), a) = int_add(int_add(a, b), c) by arith()
  have l3 := rewrite(c2, rewrite(c1, l1))
  show by defs(trans(l3, sym(r1)), bits_add)
qed

theorem nf.add_swap: all n x b c. n in omega -> bits_add(n, bits_add(n, x, b), c) = bits_add(n, bits_add(n, x, c), b)
proof
  fix n x b c
  assume hn
  have p := mp(pow2_pos[k := n], hn)
  have l := mp(mod_add_mod[x := int_add(x, b), y := c, m := pow2(n)], p)
  have r := mp(mod_add_mod[x := int_add(x, c), y := b, m := pow2(n)], p)
  have e: int_add(int_add(x, b), c) = int_add(int_add(x, c), b) by arith()
  show by defs(trans(rewrite(e, l), sym(r)), bits_add)
qed

theorem nf.add_lits: all n x k1 k2. n in omega -> bits_add(n, bits_add(n, x, k1), k2) = bits_add(n, x, bits_add(n, k1, k2))
proof
  fix n x k1 k2
  assume hn
  have p := mp(pow2_pos[k := n], hn)
  have l := mp(mod_add_mod[x := int_add(x, k1), y := k2, m := pow2(n)], p)
  have r := mp(mod_add_mod[x := int_add(k1, k2), y := x, m := pow2(n)], p)
  have c1: int_add(int_mod(int_add(k1, k2), pow2(n)), x) = int_add(x, int_mod(int_add(k1, k2), pow2(n))) by arith()
  have e: int_add(int_add(x, k1), k2) = int_add(int_add(k1, k2), x) by arith()
  show by defs(trans(rewrite(e, l), sym(rewrite(c1, r))), bits_add)
qed

theorem nf.mul_distr: all n a b c. n in omega -> bits_mul(n, bits_add(n, a, b), c) = bits_add(n, bits_mul(n, a, c), bits_mul(n, b, c))
proof
  fix n a b c
  assume hn
  have p := mp(pow2_pos[k := n], hn)
  have ai: int_add(a, b) in int by arith()
  have l := mp(mod_mul_mod[x := int_add(a, b), c := c, m := pow2(n)], ai, p)
  have r1 := mp(mod_add_mod[x := int_mul(a, c), y := int_mod(int_mul(b, c), pow2(n)), m := pow2(n)], p)
  have r2 := mp(mod_add_mod[x := int_mul(b, c), y := int_mul(a, c), m := pow2(n)], p)
  have c1: int_add(int_mul(a, c), int_mod(int_mul(b, c), pow2(n))) = int_add(int_mod(int_mul(b, c), pow2(n)), int_mul(a, c)) by arith()
  have e: int_mul(int_add(a, b), c) = int_add(int_mul(b, c), int_mul(a, c)) by arith()
  have rr := trans(rewrite(c1, r1), r2)
  show by defs(trans(rewrite(e, l), sym(rr)), bits_add, bits_mul)
qed

theorem nf.mul_mul: all n a c1 c2. n in omega -> bits_mul(n, bits_mul(n, a, c1), c2) = bits_mul(n, a, bits_mul(n, c1, c2))
proof
  fix n a c1 c2
  assume hn
  have p := mp(pow2_pos[k := n], hn)
  have ai: int_mul(a, c1) in int by arith()
  have bi: int_mul(c1, c2) in int by arith()
  have l := mp(mod_mul_mod[x := int_mul(a, c1), c := c2, m := pow2(n)], ai, p)
  have r := mp(mod_mul_mod[x := int_mul(c1, c2), c := a, m := pow2(n)], bi, p)
  have c3: int_mul(int_mod(int_mul(c1, c2), pow2(n)), a) = int_mul(a, int_mod(int_mul(c1, c2), pow2(n))) by arith()
  have e: int_mul(int_mul(a, c1), c2) = int_mul(int_mul(c1, c2), a) by arith()
  show by defs(trans(rewrite(e, l), sym(rewrite(c3, r))), bits_mul)
qed

// GIMPLE's sum of two literals in the address range (a static's field's
// address): the word sum
theorem nf.int_add_bits: all a b. a in omega -> b in omega -> int_lt(int_add(a, b), pow2(64)) -> int_add(a, b) = bits_add(64, a, b)
proof
  fix a b
  assume ha hb hl
  show by defs(arith(ha, hb, hl), bits_add)
qed

// (a word of n bits: its cast to n bits is itself)
theorem nf.boi_in: all n x. n in omega -> x in bits(n) -> bits_of_int(n, x) = x
proof
  fix n x
  assume hn hx
  have p := mp(pow2_pos[k := n], hn)
  show by defs(arith(hx, p), bits_of_int, bits)
qed

// (a word of m bits is one of n >= m)
theorem nf.bits_le: all m n x. m in omega -> n in omega -> int_le(m, n) -> x in bits(m) -> x in bits(n)
proof
  fix m n x
  assume hm hn hle hx
  have p := pow2_le[a := m, b := n]
  have p2 := mp(p, hm, hn, hle)
  show by arith(hx, p2)
qed

// the operations' words (the premise of nf.boi_in, per operation; and,
// or, xor, not, set_slice: core/bits.core's bits_*_in)
theorem nf.mod_in: all n z. n in omega -> int_mod(z, pow2(n)) in bits(n)
proof
  fix n z
  assume hn
  have p := mp(pow2_pos[k := n], hn)
  show by arith(p)
qed

theorem nf.add_in: all n a b. n in omega -> bits_add(n, a, b) in bits(n)
proof
  fix n a b
  assume hn
  show by defs(mp(nf.mod_in[n := n, z := int_add(a, b)], hn), bits_add)
qed

theorem nf.sub_in: all n a b. n in omega -> bits_sub(n, a, b) in bits(n)
proof
  fix n a b
  assume hn
  show by defs(mp(nf.mod_in[n := n, z := int_sub(a, b)], hn), bits_sub)
qed

theorem nf.mul_in: all n a b. n in omega -> bits_mul(n, a, b) in bits(n)
proof
  fix n a b
  assume hn
  show by defs(mp(nf.mod_in[n := n, z := int_mul(a, b)], hn), bits_mul)
qed

theorem nf.neg_in: all n a. n in omega -> bits_neg(n, a) in bits(n)
proof
  fix n a
  assume hn
  show by defs(mp(nf.mod_in[n := n, z := int_neg(a)], hn), bits_neg)
qed

theorem nf.of_int_in: all n z. n in omega -> bits_of_int(n, z) in bits(n)
proof
  fix n z
  assume hn
  show by defs(mp(nf.mod_in[n := n, z := z], hn), bits_of_int)
qed

theorem nf.sext_in: all m n x. n in omega -> bits_sext(m, n, x) in bits(n)
proof
  fix m n x
  assume hn
  show by defs(mp(nf.of_int_in[n := n, z := sint(m, x)], hn), bits_sext)
qed
