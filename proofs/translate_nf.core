// The normal form of values (docs/overview.md, the rules' standard form):
// the oriented equations the C1 engine's normalizer N applies
// (slc/cli/src/c1/nf.rs), innermost first, each step one instance:
// - a closed literal term is its numeral (by evaluation, no equation);
// - a cast of a word of its width is the word (nf.boi_*);
// - a shift by a constant is a product by 2^k (nf.shl_mul), a value added
//   to itself twice it (nf.add_self);
// - commutative operands in one order, literals last (nf.*_comm, and
//   x86.mul_comm, x86.and_comm, x86i.xor_comm).

theorem nf.add_comm: all n a b. bits_add(n, a, b) = bits_add(n, b, a)
proof
  fix n a b
  have h: int_add(a, b) = int_add(b, a) by arith()
  show by defs(simp(h), bits_add)
qed

theorem nf.or_comm: all n a b. bits_or(n, a, b) = bits_or(n, b, a)
proof
  fix n a b
  have pq: all x. (x in bits(n) && (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(a, i) || bit(b, i)))) <-> (x in bits(n) && (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(b, i) || bit(a, i)))) proof
    fix x
    have d1: (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(a, i) || bit(b, i))) -> (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(b, i) || bit(a, i))) proof
      assume h
      fix i
      assume i1 i2
      have hi := mp(all_elim(h, {i}), i1, i2)
      show by taut(hi)
    qed
    have d2: (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(b, i) || bit(a, i))) -> (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(a, i) || bit(b, i))) proof
      assume h
      fix i
      assume i1 i2
      have hi := mp(all_elim(h, {i}), i1, i2)
      show by taut(hi)
    qed
    show by taut(d1, d2)
  qed
  have e := mp(choose_ext[p := x. x in bits(n) && (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(a, i) || bit(b, i))), q := x. x in bits(n) && (all i. i in omega -> int_lt(i, n) -> (bit(x, i) <-> bit(b, i) || bit(a, i)))], pq)
  show by defs(e, bits_or, bits_build)
qed

// (a value added to itself: twice it)
theorem nf.add_self: all n x. bits_add(n, x, x) = bits_mul(n, x, 2)
proof
  fix n x
  have h: int_add(x, x) = int_mul(x, 2) by arith()
  show by defs(simp(h), bits_add, bits_mul)
qed

theorem nf.shl_mul:all n a k. bits_shl(n, a, k) = bits_mul(n, a, pow2(k))
proof
  fix n a k
  show by defs(simp(), bits_shl, bits_mul)
qed

// (a word of n bits: its cast to n bits is itself)
theorem nf.boi_in: all n x. n in omega -> x in bits(n) -> bits_of_int(n, x) = x
proof
  fix n x
  assume hn hx
  have p := mp(pow2_pos[k := n], hn)
  show by defs(arith(hx, p), bits_of_int, bits)
qed

// (a word of m bits is one of n >= m)
theorem nf.bits_le: all m n x. m in omega -> n in omega -> int_le(m, n) -> x in bits(m) -> x in bits(n)
proof
  fix m n x
  assume hm hn hle hx
  have p := pow2_le[a := m, b := n]
  have p2 := mp(p, hm, hn, hle)
  show by arith(hx, p2)
qed

// the operations' words (the premise of nf.boi_in, per operation; and,
// or, xor, not, set_slice: core/bits.core's bits_*_in)
theorem nf.mod_in: all n z. n in omega -> int_mod(z, pow2(n)) in bits(n)
proof
  fix n z
  assume hn
  have p := mp(pow2_pos[k := n], hn)
  show by arith(p)
qed

theorem nf.add_in: all n a b. n in omega -> bits_add(n, a, b) in bits(n)
proof
  fix n a b
  assume hn
  show by defs(mp(nf.mod_in[n := n, z := int_add(a, b)], hn), bits_add)
qed

theorem nf.sub_in: all n a b. n in omega -> bits_sub(n, a, b) in bits(n)
proof
  fix n a b
  assume hn
  show by defs(mp(nf.mod_in[n := n, z := int_sub(a, b)], hn), bits_sub)
qed

theorem nf.mul_in: all n a b. n in omega -> bits_mul(n, a, b) in bits(n)
proof
  fix n a b
  assume hn
  show by defs(mp(nf.mod_in[n := n, z := int_mul(a, b)], hn), bits_mul)
qed

theorem nf.neg_in: all n a. n in omega -> bits_neg(n, a) in bits(n)
proof
  fix n a
  assume hn
  show by defs(mp(nf.mod_in[n := n, z := int_neg(a)], hn), bits_neg)
qed

theorem nf.of_int_in: all n z. n in omega -> bits_of_int(n, z) in bits(n)
proof
  fix n z
  assume hn
  show by defs(mp(nf.mod_in[n := n, z := z], hn), bits_of_int)
qed

theorem nf.sext_in: all m n x. n in omega -> bits_sext(m, n, x) in bits(n)
proof
  fix m n x
  assume hn
  show by defs(mp(nf.of_int_in[n := n, z := sint(m, x)], hn), bits_sext)
qed
