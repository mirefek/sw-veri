theorem gst.imul_16: tr.imul_by(16)
proof
  have g: all y. y in bits(32) -> bits_add(32, int_mul(sint(32, y), sint(32, 16)), 0) = bits_mul(32, y, 16) proof
    fix y
    assume hy: y in bits(32)
    have c1: int_lt(y, 2147483648) -> bits_add(32, int_mul(sint(32, y), 16), 0) = bits_mul(32, y, 16) proof
      assume hl: int_lt(y, 2147483648)
      show by defs(simp(hy, hl), bits_add, bits_mul, sint)
    qed
    have c2: !int_lt(y, 2147483648) -> bits_add(32, int_mul(sint(32, y), 16), 0) = bits_mul(32, y, 16) proof
      assume hl: !int_lt(y, 2147483648)
      have e: int_mod(int_mul(int_sub(y, 4294967296), 16), 4294967296) = int_mod(int_mul(y, 16), 4294967296) by arith(hy)
      show by defs(simp(hy, hl, e), bits_add, bits_mul, sint)
    qed
    have e: bits_add(32, int_mul(sint(32, y), 16), 0) = bits_mul(32, y, 16) by taut(c1, c2)
    show by simp(e)
  qed
  show by defs(g, tr.imul_by)
qed

theorem gst.narrow8_31: tr.narrow8(31)
proof
  have g: all u. u in bits(8) -> bits_and(32, u, 31) = bits_and(8, u, 31) proof
    fix u
    assume h: u in bits(8)
    show by simp(h)
  qed
  show by defs(g, tr.narrow8)
qed

theorem gst.field16_6_6_63: tr.field16(6, 6, 63)
proof
  have g: all x. x in bits(16) -> bits_and(32, bits_slice(bits_set_slice(64, bits_of_int(16, x), 15, 0, bits_shr(16, bits_slice(bits_of_int(16, x), 15, 0), 6)), 31, 0), 63) = bits_of_int(6, int_mod(int_div(x, int_pow(2, 6)), int_pow(2, 6))) proof
    fix x
    assume hx: x in bits(16)
    have d: int_div(x, 64) in bits(10) by arith(hx)
    have d16: int_div(x, 64) in bits(16) by arith(hx)
    show by defs(simp(hx, d, d16), bits_shr, bits_of_int, pow2)
  qed
  show by defs(g, tr.field16)
qed

